{
  "mcpServers": {
    "sounio": {
      "command": "/workspace/sounio/.venv/bin/python3",
      "args": [
        "-m",
        "sounio_mcp.server",
        "--transport",
        "stdio"
      ],
      "env": {
        "PYTHONPATH": "/workspace/sounio/tools/mcp"
      }
    },
    "sounio-coord": {
      "command": "/workspace/sounio/.venv/bin/python3",
      "args": [
        "/workspace/sounio/scripts/mcp/sounio_coord_mcp.py"
      ],
      "env": {
        "SOUNIO_REPO_ROOT": "/workspace/sounio"
      }
    },
    "context7": {
      "command": "/workspace/.home/openvscode-server/.local/node-v20.20.2-linux-x64/bin/npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=8192"
      }
    },
    "scite": {
      "type": "http",
      "url": "https://api.scite.ai/mcp"
    }
  }
}
