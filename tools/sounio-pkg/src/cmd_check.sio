// sounio-pkg/src/cmd_check.sio — check command
//
// Prints a bash script that type-checks all .sio files in src/.
// Prints a bash script to stdout; the bash wrapper pipes through: bash

pub fn main() with IO {
    println("#!/usr/bin/env bash")
    println("SOUC=\"${SOUC:-./artifacts/omega/souc-bin/souc-linux-x86_64-jit}\"")
    println("export SOUNIO_STDLIB_PATH=\"${SOUNIO_STDLIB_PATH:-$(pwd)/stdlib}\"")
    println("if [ ! -f sounio.toml ]; then")
    println("  echo 'error: sounio.toml not found — are you inside a sounio package?' >&2")
    println("  exit 1")
    println("fi")
    println("ok=0")
    println("fail=0")
    println("shopt -s nullglob")
    println("for f in src/*.sio; do")
    println("  printf '  check %-36s' \"$f\"")
    println("  if \"$SOUC\" check \"$f\" > /dev/null 2>&1; then")
    println("    echo 'OK'")
    println("    ((ok++))")
    println("  else")
    println("    echo 'FAIL'")
    println("    \"$SOUC\" check \"$f\" 2>&1 | sed 's/^/    /'")
    println("    ((fail++))")
    println("  fi")
    println("done")
    println("echo \"\"")
    println("echo \"Check: $ok OK, $fail failed\"")
    println("[ \"$fail\" -eq 0 ]")
}
