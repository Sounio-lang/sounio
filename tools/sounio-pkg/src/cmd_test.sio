// sounio-pkg/src/cmd_test.sio — test runner command
//
// Prints a bash script to stdout that runs test files.
// The bash wrapper pipes this through:
//   PKG_FILTER="<pattern>" bash
// where PKG_FILTER is optional — when set, only files matching the pattern run.

pub fn main() with IO {
    println("#!/usr/bin/env bash")
    println("SOUC=\"${SOUC:-./bin/souc}\"")
    println("export SOUNIO_STDLIB_PATH=\"${SOUNIO_STDLIB_PATH:-$(pwd)/stdlib}\"")
    println("FILTER=\"${PKG_FILTER:-}\"")
    println("if [ ! -f sounio.toml ]; then")
    println("  echo 'error: sounio.toml not found — are you inside a sounio package?' >&2")
    println("  exit 1")
    println("fi")
    println("pass=0")
    println("fail=0")
    println("skipped=0")
    println("shopt -s nullglob")
    println("files=(tests/*.sio)")
    println("if [ ${#files[@]} -eq 0 ]; then")
    println("  echo 'No test files found in tests/'")
    println("  exit 0")
    println("fi")
    println("for f in \"${files[@]}\"; do")
    println("  if [ -n \"$FILTER\" ] && [[ \"$f\" != *\"$FILTER\"* ]]; then")
    println("    ((skipped++))")
    println("    continue")
    println("  fi")
    println("  printf '  %-40s' \"$f\"")
    println("  if \"$SOUC\" run \"$f\" > /dev/null 2>&1; then")
    println("    echo 'PASS'")
    println("    ((pass++))")
    println("  else")
    println("    echo 'FAIL'")
    println("    ((fail++))")
    println("  fi")
    println("done")
    println("echo \"\"")
    println("echo \"Results: $pass passed, $fail failed, $skipped skipped\"")
    println("[ \"$fail\" -eq 0 ]")
}
