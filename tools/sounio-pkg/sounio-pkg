#!/usr/bin/env bash
# sounio-pkg — Sounio package manager
#
# Architecture: This bash wrapper dispatches to per-command .sio files.
# Each command file either:
#   (a) prints output directly (version, help), or
#   (b) prints a bash script to stdout, which this wrapper pipes through bash.
#
# This approach works around the JIT constraint that extern "C" FFI calls
# are not available for env/filesystem access in Sounio source.

set -e

SOUC="${SOUC:-}"
SPKG_DIR="$(cd "$(dirname "$0")" && pwd)"
SRC_DIR="$SPKG_DIR/src"

# Auto-detect souc binary relative to the repo root (sounio-pkg/ lives one level down)
if [ -z "$SOUC" ]; then
    REPO_ROOT="$(cd "$SPKG_DIR/.." && pwd)"
    SOUC="$REPO_ROOT/artifacts/omega/souc-bin/souc-linux-x86_64-jit"
fi

export SOUC
export SOUNIO_STDLIB_PATH="${SOUNIO_STDLIB_PATH:-$(cd "$SPKG_DIR/.." && pwd)/stdlib}"

cmd="${1:-help}"
arg1="${2:-}"

case "$cmd" in
    version)
        exec "$SOUC" run "$SRC_DIR/cmd_version.sio"
        ;;
    help|--help|-h)
        exec "$SOUC" run "$SRC_DIR/cmd_help.sio"
        ;;
    new)
        if [ -z "$arg1" ]; then
            echo "error: 'new' requires a package name" >&2
            echo "Usage: sounio-pkg new <name>" >&2
            exit 1
        fi
        PKG_NAME="$arg1" "$SOUC" run "$SRC_DIR/cmd_new.sio" | PKG_NAME="$arg1" bash
        ;;
    build)
        "$SOUC" run "$SRC_DIR/cmd_build.sio" | bash
        ;;
    test)
        PKG_FILTER="$arg1" "$SOUC" run "$SRC_DIR/cmd_test.sio" | PKG_FILTER="$arg1" bash
        ;;
    check)
        "$SOUC" run "$SRC_DIR/cmd_check.sio" | bash
        ;;
    *)
        echo "error: unknown command '$cmd'" >&2
        echo "" >&2
        "$SOUC" run "$SRC_DIR/cmd_help.sio" >&2
        exit 1
        ;;
esac
