#!/usr/bin/env bash
# sounio-pkg — Sounio package manager
#
# Architecture: This bash wrapper dispatches to per-command .sio files.
# Each command file either:
#   (a) prints output directly (version, help), or
#   (b) prints a bash script to stdout, which this wrapper pipes through bash.
#
# This approach keeps shell-facing env/filesystem access in bash while the
# Sounio command implementations stay in `.sio` source.

set -e

SOUC="${SOUC:-}"
SPKG_DIR="$(cd "$(dirname "$0")" && pwd)"
SRC_DIR="$SPKG_DIR/src"
REPO_ROOT="$(cd "$SPKG_DIR/../.." && pwd)"

# Auto-detect souc binary relative to the repo root.
if [ -z "$SOUC" ]; then
    SOUC="$REPO_ROOT/bin/souc"
fi

export SOUC
export SOUNIO_STDLIB_PATH="${SOUNIO_STDLIB_PATH:-$REPO_ROOT/stdlib}"

run_cmd_sio() {
    src="$1"
    out="$(mktemp -d /tmp/sounio-pkg-cmd.XXXXXX)"
    trap 'rm -rf "$out"' EXIT
    "$SOUC" "$src" "$out/cmd" >/dev/null
    "$out/cmd"
}

cmd="${1:-help}"
arg1="${2:-}"

case "$cmd" in
    version)
        run_cmd_sio "$SRC_DIR/cmd_version.sio"
        ;;
    help|--help|-h)
        run_cmd_sio "$SRC_DIR/cmd_help.sio"
        ;;
    new)
        if [ -z "$arg1" ]; then
            echo "error: 'new' requires a package name" >&2
            echo "Usage: sounio-pkg new <name>" >&2
            exit 1
        fi
        PKG_NAME="$arg1" run_cmd_sio "$SRC_DIR/cmd_new.sio" | PKG_NAME="$arg1" bash
        ;;
    build)
        run_cmd_sio "$SRC_DIR/cmd_build.sio" | bash
        ;;
    test)
        PKG_FILTER="$arg1" run_cmd_sio "$SRC_DIR/cmd_test.sio" | PKG_FILTER="$arg1" bash
        ;;
    check)
        run_cmd_sio "$SRC_DIR/cmd_check.sio" | bash
        ;;
    *)
        echo "error: unknown command '$cmd'" >&2
        echo "" >&2
        run_cmd_sio "$SRC_DIR/cmd_help.sio" >&2
        exit 1
        ;;
esac
