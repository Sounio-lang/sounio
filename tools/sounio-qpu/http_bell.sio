// Four exchanges on one TCP connection. The requests are written
// before any response is read, so the stand-in sees them back to back
// and the client has to split coalesced frames. A second connect would
// hang: the stand-in accepts once.
//   sounio-qpu listen 8781
// The listener is not a quantum processor.

use http::post::{
    http_open,
    http_close,
    http_send_get,
    http_send_shots,
    http_recv,
    HttpConn,
    HttpReply,
}

use quantum::qasm_tape::{
    tape_bell,
    tape_qir,
    tape_check,
    CountVerdict,
}

fn show_health(r: HttpReply) -> i32 with IO, Mut, Div, Panic {
    print("health\nstatus ")
    print_int(r.status)
    print("\nlength ")
    print_int(r.content_length)
    print("\nbytes ")
    print_int(str_len(r.body))
    print("\n")
    print(r.body)
    if r.status != 200 { return 1 }
    if r.content_length != 3 { return 1 }
    if str_len(r.body) != 3 { return 1 }
    if str_eq(r.body, "ok\n") { return 0 }
    1
}

fn show_shots(shots: i64, r: HttpReply) -> i32 with IO, Mut, Div, Panic {
    print("shots ")
    print_int(shots)
    print("\nstatus ")
    print_int(r.status)
    print("\nlength ")
    print_int(r.content_length)
    print("\nbytes ")
    print_int(str_len(r.body))
    print("\n")
    if r.status != 200 { return 1 }
    if r.content_length != shots * 3 { return 1 }
    if str_len(r.body) != shots * 3 { return 1 }
    let v: CountVerdict = tape_check(tape_bell(), r.body)
    print("accept ")
    print_int(v.accept)
    print("\nforbidden ")
    print_int(v.forbidden)
    print("\n")
    if v.accept == 1 {
        if v.forbidden == 0 { return 0 }
    }
    1
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let qir = tape_qir(tape_bell())
    let conn: HttpConn = http_open(127, 0, 0, 1, 8781)
    print("fd ")
    print_int(conn.fd)
    print("\n")
    if conn.fd < 0 { return 1 }
    let sent = http_send_get(conn, 127, 0, 0, 1, "/health", 0) + http_send_shots(conn, 127, 0, 0, 1, 4, qir, 0) + http_send_shots(conn, 127, 0, 0, 1, 1600, qir, 0) + http_send_shots(conn, 127, 0, 0, 1, 22000, qir, 1)
    let health = http_recv(conn)
    let small = http_recv(conn)
    let wide = http_recv(conn)
    let big = http_recv(conn)
    http_close(conn)
    let h = show_health(health)
    let a = show_shots(4, small)
    let b = show_shots(1600, wide)
    let c = show_shots(22000, big)
    if sent != 0 { return 1 }
    if h != 0 { return 1 }
    if a != 0 { return 1 }
    if b != 0 { return 1 }
    if c != 0 { return 1 }
    0
}
