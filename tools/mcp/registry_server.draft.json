{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.sounio-lang/sounio-mcp-server",
  "title": "Sounio Compiler",
  "description": "Check, compile, run, and test Sounio programs locally.",
  "repository": {
    "url": "https://github.com/sounio-lang/sounio",
    "source": "github",
    "subfolder": "tools/mcp"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "sounio-mcp-server",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tools": [
        "sounio_compile",
        "sounio_check",
        "sounio_run",
        "sounio_test"
      ],
      "resources": [
        "sounio://stdlib/{module}",
        "sounio://errors/{error_code}"
      ],
      "localOnly": true
    }
  }
}
