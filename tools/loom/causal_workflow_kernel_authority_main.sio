//! Packed executable adapter for LOOM action 9037.

fn causal_workflow_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn causal_workflow_decision(decision: i64) -> string {
    if decision == 580 { return "DENY580" }
    if decision == 581 { return "DENY581" }
    if decision == 582 { return "DENY582" }
    if decision == 583 { return "DENY583" }
    if decision == 584 { return "DENY584" }
    if decision == 585 { return "DENY585" }
    if decision == 586 { return "DENY586" }
    if decision == 587 { return "DENY587" }
    if decision == 588 { return "DENY588" }
    if decision == 589 { return "DENY589" }
    "DENY424"
}

fn causal_workflow_fields() with IO {
    println("LOOM_CAUSAL_WORKFLOW_KERNEL_FIELDS_V1")
    println("LOOM_CAUSAL_WORKFLOW/1")
    println("COMPILE>RUN_EXACT>ATTEST")
    println("tests/verify-ir/call_b.sio")
    println("899d05ffe60528a6b71871e24fa0d1bc105cd033b7ae2c5a0a6d2bb808cdcad9")
    println("81c4929823460a807762abd4a878ca9adbd053313e7ac6662fa489456269a4a3")
    println("eff2ac0ef28b34d6cc4f008cfb08a30ba18a0874c8654c06a3c62ec2f48a249c")
    println("exit_code=0")
    println("stdout_sha256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    println("stderr_sha256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    println("run_ticket_is_bearer=false")
    println("run_ticket_is_execution_authority=false")
    println("launch_authority=action-9030")
    println("exactly_once_scope=live-HostGuardian-generation")
    println("guardian_host_or_store_loss=fail-closed")
}

fn main() -> i64 with IO, Mut, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = causal_workflow_decimal_field(raw, 0)
    if ok_schema == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed = loom_causal_workflow_selftest()
        if failed == 0 {
            println("SOUNIO_CAUSAL_WORKFLOW_SELFTEST PASS cases=12")
            return 0
        }
        println("SOUNIO_CAUSAL_WORKFLOW_SELFTEST FAIL")
        return 70
    }
    let (ok_word0, word0, p1) = causal_workflow_decimal_field(raw, p0)
    let (ok_word1, word1, p2) = causal_workflow_decimal_field(raw, p1)
    if ok_schema != 1 || schema != 9037 || ok_word0 != 1 || ok_word1 != 1 ||
        word0 < 0 || word0 >= 4611686018427387904 ||
        word1 < 0 || word1 >= 4503599627370496 ||
        str_char_at(raw, p2) > 0 {
        println("SOUNIO_CAUSAL_WORKFLOW DENY424 reason=malformed-frame semantic_authority=Sounio action=9037")
        return 42
    }
    let decision = judge_loom_causal_workflow_v1_words(word0, word1)
    if decision == 1 {
        let transition = (word0 >> 20) & 15
        if transition == 11 {
            println("SOUNIO_CAUSAL_WORKFLOW RECOVER semantic_authority=Sounio action=9037")
        } else {
            println("SOUNIO_CAUSAL_WORKFLOW ADVANCE semantic_authority=Sounio action=9037")
        }
        causal_workflow_fields()
        return 0
    }
    println("SOUNIO_CAUSAL_WORKFLOW " + causal_workflow_decision(decision) +
        " semantic_authority=Sounio action=9037")
    42
}
