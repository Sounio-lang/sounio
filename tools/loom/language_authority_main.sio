//! Executable adapter for Loom language-authority frame 9020.

fn language_authority_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn language_authority_digest_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) with Mut, Div, Panic {
    let (ok0, limb0, p0) = language_authority_decimal_field(raw, start)
    let (ok1, limb1, p1) = language_authority_decimal_field(raw, p0)
    let (ok2, limb2, p2) = language_authority_decimal_field(raw, p1)
    let (ok3, limb3, p3) = language_authority_decimal_field(raw, p2)
    let (ok4, limb4, p4) = language_authority_decimal_field(raw, p3)
    let (ok5, limb5, p5) = language_authority_decimal_field(raw, p4)
    let (ok6, limb6, p6) = language_authority_decimal_field(raw, p5)
    let (ok7, limb7, p7) = language_authority_decimal_field(raw, p6)
    let valid = ok0 == 1 && ok1 == 1 && ok2 == 1 && ok3 == 1 &&
        ok4 == 1 && ok5 == 1 && ok6 == 1 && ok7 == 1 &&
        limb0 <= 4294967295 && limb1 <= 4294967295 &&
        limb2 <= 4294967295 && limb3 <= 4294967295 &&
        limb4 <= 4294967295 && limb5 <= 4294967295 &&
        limb6 <= 4294967295 && limb7 <= 4294967295
    (if valid { 1 } else { 0 }, limb0, limb1, limb2, limb3,
        limb4, limb5, limb6, limb7, p7)
}

fn language_authority_reason(decision: i64) -> string {
    if decision == 0 { return "allow" }
    if decision == 101 { return "policy-missing" }
    if decision == 102 { return "policy-timeout" }
    if decision == 103 { return "policy-error" }
    if decision == 110 { return "forbidden-language" }
    if decision == 111 { return "role-mismatch" }
    if decision == 112 { return "wrong-stage" }
    if decision == 113 { return "semantic-authority-required" }
    if decision == 114 { return "expected-result-authority-required" }
    if decision == 115 { return "sounio-source-hash-missing" }
    if decision == 116 { return "semantics-hash-missing" }
    if decision == 117 { return "parent-semantics-hash-mismatch" }
    if decision == 118 { return "receipt-incomplete" }
    if decision == 119 { return "review-promoted-to-authority" }
    if decision == 120 { return "waiver-invalid" }
    if decision == 121 { return "native-guardian-contract" }
    if decision == 122 { return "parity-receipt-missing" }
    if decision == 123 { return "action-forbidden-for-role" }
    "malformed-frame"
}

fn language_authority_code(decision: i64) -> string {
    if decision == 0 { return "0" }
    if decision == 101 { return "101" }
    if decision == 102 { return "102" }
    if decision == 103 { return "103" }
    if decision == 110 { return "110" }
    if decision == 111 { return "111" }
    if decision == 112 { return "112" }
    if decision == 113 { return "113" }
    if decision == 114 { return "114" }
    if decision == 115 { return "115" }
    if decision == 116 { return "116" }
    if decision == 117 { return "117" }
    if decision == 118 { return "118" }
    if decision == 119 { return "119" }
    if decision == 120 { return "120" }
    if decision == 121 { return "121" }
    if decision == 122 { return "122" }
    if decision == 123 { return "123" }
    "124"
}

fn language_authority_stage_name(stage: i64) -> string {
    if stage == 1 { return "GARDEN" }
    if stage == 2 { return "SOUNIO_EXECUTABLE" }
    if stage == 3 { return "SEMANTICS_FROZEN" }
    if stage == 4 { return "PARITY_OPEN" }
    if stage == 5 { return "CLAIM_READY" }
    "INVALID"
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = language_authority_decimal_field(raw, 0)
    if ok_schema == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed_case = loom_language_authority_selftest()
        if failed_case == 0 {
            println("SOUNIO_LANGUAGE_AUTHORITY_SELFTEST PASS cases=33")
            return 0
        }
        println("SOUNIO_LANGUAGE_AUTHORITY_SELFTEST FAIL")
        return 70
    }

    let (ok_stage, stage, p1) = language_authority_decimal_field(raw, p0)
    let (ok_action, action, p2) = language_authority_decimal_field(raw, p1)
    let (ok_language, language, p3) = language_authority_decimal_field(raw, p2)
    let (ok_role, role, p4) = language_authority_decimal_field(raw, p3)
    let (ok_policy, policy, p5) = language_authority_decimal_field(raw, p4)
    let (ok_semantic, semantic_write, p6) = language_authority_decimal_field(raw, p5)
    let (ok_expected, expected_write, p7) = language_authority_decimal_field(raw, p6)
    let (ok_parity, parity_valid, p8) = language_authority_decimal_field(raw, p7)
    let (ok_review, review_promoted, p9) = language_authority_decimal_field(raw, p8)
    let (ok_exception, exception_requested, p10) = language_authority_decimal_field(raw, p9)
    let (ok_founder, waiver_founder, p11) = language_authority_decimal_field(raw, p10)
    let (ok_scope, waiver_scope, p12) = language_authority_decimal_field(raw, p11)
    let (ok_purpose, waiver_purpose, p13) = language_authority_decimal_field(raw, p12)
    let (ok_unexpired, waiver_unexpired, p14) = language_authority_decimal_field(raw, p13)
    let (ok_guardian_transitional, guardian_transitional, p15) = language_authority_decimal_field(raw, p14)
    let (ok_guardian_declarative, guardian_declarative, p16) = language_authority_decimal_field(raw, p15)
    let (ok_guardian_fixture, guardian_fixture, p17) = language_authority_decimal_field(raw, p16)
    let (ok_source, s0, s1, s2, s3, s4, s5, s6, s7, p18) =
        language_authority_digest_field(raw, p17)
    let (ok_semantics, m0, m1, m2, m3, m4, m5, m6, m7, p19) =
        language_authority_digest_field(raw, p18)
    let (ok_parent, a0, a1, a2, a3, a4, a5, a6, a7, p20) =
        language_authority_digest_field(raw, p19)
    let (ok_toolchain, t0, t1, t2, t3, t4, t5, t6, t7, p21) =
        language_authority_digest_field(raw, p20)
    let (ok_hardware, h0, h1, h2, h3, h4, h5, h6, h7, p22) =
        language_authority_digest_field(raw, p21)
    let (ok_command, c0, c1, c2, c3, c4, c5, c6, c7, p23) =
        language_authority_digest_field(raw, p22)
    let (ok_result, r0, r1, r2, r3, r4, r5, r6, r7, p24) =
        language_authority_digest_field(raw, p23)
    let (ok_waiver, w0, w1, w2, w3, w4, w5, w6, w7, end_offset) =
        language_authority_digest_field(raw, p24)
    let parsed = ok_schema == 1 && ok_stage == 1 && ok_action == 1 &&
        ok_language == 1 && ok_role == 1 && ok_policy == 1 &&
        ok_semantic == 1 && ok_expected == 1 && ok_parity == 1 &&
        ok_review == 1 && ok_exception == 1 && ok_founder == 1 &&
        ok_scope == 1 && ok_purpose == 1 && ok_unexpired == 1 &&
        ok_guardian_transitional == 1 && ok_guardian_declarative == 1 &&
        ok_guardian_fixture == 1 && ok_source == 1 && ok_semantics == 1 &&
        ok_parent == 1 && ok_toolchain == 1 && ok_hardware == 1 &&
        ok_command == 1 && ok_result == 1 && ok_waiver == 1 &&
        str_char_at(raw, end_offset) <= 0
    if !parsed || schema != 9020 {
        println("SOUNIO_LANGUAGE_AUTHORITY_DENY code=124 reason=malformed-frame stage=0 next_stage=0")
        return 124
    }

    let decision = loom_language_authority_decide(
        stage,
        action,
        language,
        role,
        policy,
        semantic_write,
        expected_write,
        parity_valid,
        review_promoted,
        exception_requested,
        waiver_founder,
        waiver_scope,
        waiver_purpose,
        waiver_unexpired,
        guardian_transitional,
        guardian_declarative,
        guardian_fixture,
        admit_language_authority_digest256(s0, s1, s2, s3, s4, s5, s6, s7),
        admit_language_authority_digest256(m0, m1, m2, m3, m4, m5, m6, m7),
        admit_language_authority_digest256(a0, a1, a2, a3, a4, a5, a6, a7),
        admit_language_authority_digest256(t0, t1, t2, t3, t4, t5, t6, t7),
        admit_language_authority_digest256(h0, h1, h2, h3, h4, h5, h6, h7),
        admit_language_authority_digest256(c0, c1, c2, c3, c4, c5, c6, c7),
        admit_language_authority_digest256(r0, r1, r2, r3, r4, r5, r6, r7),
        admit_language_authority_digest256(w0, w1, w2, w3, w4, w5, w6, w7),
    )
    let next_stage = loom_language_authority_next_stage(stage, action, decision)
    if decision == 0 {
        println("SOUNIO_LANGUAGE_AUTHORITY_ALLOW code=0 reason=allow next_stage=" +
            language_authority_stage_name(next_stage))
        return 0
    }
    println("SOUNIO_LANGUAGE_AUTHORITY_DENY code=" +
        language_authority_code(decision) + " reason=" +
        language_authority_reason(decision) + " next_stage=" +
        language_authority_stage_name(next_stage))
    decision
}
