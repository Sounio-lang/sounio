//! Executable adapter for Loom custody-transfer frame 9040.

fn custody_transfer_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn custody_transfer_decision_name(decision: i64) -> string {
    if decision == 1 { return "QUIESCE_SOURCE" }
    if decision == 2 { return "START_TARGET" }
    if decision == 3 { return "COMMIT_TARGET" }
    if decision == 4 { return "COMPLETE" }
    if decision == 5 { return "START_SOURCE_ROLLBACK" }
    if decision == 6 { return "ABORT_TARGET" }
    if decision == 7 { return "WAIT" }
    if decision == 8 { return "ABORT_TRANSFER" }
    if decision == 9 { return "ROLLED_BACK" }
    if decision == 10 { return "ABORT_SOURCE" }
    if decision == 11 { return "RECOVER_TARGET" }
    if decision == 101 { return "DENY_POLICY" }
    if decision == 102 { return "DENY_OBSERVATION" }
    if decision == 103 { return "DENY_CATALOG_CONFLICT" }
    if decision == 104 { return "DENY_CATALOG_MISSING" }
    if decision == 105 { return "DENY_ROLLBACK_UNAVAILABLE" }
    if decision == 106 { return "DENY_TARGET_UNSEALED" }
    if decision == 107 { return "DENY_RESUME_UNBOUND" }
    if decision == 108 { return "DENY_SOURCE_IDENTITY" }
    if decision == 109 { return "DENY_TARGET_PROOF_CONFLICT" }
    if decision == 110 { return "DENY_SOURCE_QUIESCENCE" }
    if decision == 114 { return "DENY_CATALOG_PHASE" }
    if decision == 118 { return "DENY_PHASE" }
    "DENY_MALFORMED"
}

fn custody_transfer_code(decision: i64) -> string {
    if decision == 1 { return "1" }
    if decision == 2 { return "2" }
    if decision == 3 { return "3" }
    if decision == 4 { return "4" }
    if decision == 5 { return "5" }
    if decision == 6 { return "6" }
    if decision == 7 { return "7" }
    if decision == 8 { return "8" }
    if decision == 9 { return "9" }
    if decision == 10 { return "10" }
    if decision == 11 { return "11" }
    if decision == 101 { return "101" }
    if decision == 102 { return "102" }
    if decision == 103 { return "103" }
    if decision == 104 { return "104" }
    if decision == 105 { return "105" }
    if decision == 106 { return "106" }
    if decision == 107 { return "107" }
    if decision == 108 { return "108" }
    if decision == 109 { return "109" }
    if decision == 110 { return "110" }
    if decision == 114 { return "114" }
    if decision == 118 { return "118" }
    "119"
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = custody_transfer_decimal_field(raw, 0)
    if ok_schema == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed_case = loom_custody_transfer_selftest()
        if failed_case == 0 {
            println("SOUNIO_CUSTODY_TRANSFER_SELFTEST PASS cases=30")
            return 0
        }
        println("SOUNIO_CUSTODY_TRANSFER_SELFTEST FAIL case=" +
            custody_transfer_code(failed_case))
        return 70
    }

    let (ok_phase, phase, p1) = custody_transfer_decimal_field(raw, p0)
    let (ok_policy, policy_state, p2) = custody_transfer_decimal_field(raw, p1)
    let (ok_source_catalog, source_catalog_agentd, p3) = custody_transfer_decimal_field(raw, p2)
    let (ok_loom_catalog, catalog_committed_loom, p4) = custody_transfer_decimal_field(raw, p3)
    let (ok_staged, target_staged, p5) = custody_transfer_decimal_field(raw, p4)
    let (ok_sealed, target_descriptor_sealed, p6) = custody_transfer_decimal_field(raw, p5)
    let (ok_bound, resume_identity_bound, p7) = custody_transfer_decimal_field(raw, p6)
    let (ok_source_active, source_active, p8) = custody_transfer_decimal_field(raw, p7)
    let (ok_source_identity, source_identity_verified, p9) = custody_transfer_decimal_field(raw, p8)
    let (ok_source_quiesced, source_quiesced, p10) = custody_transfer_decimal_field(raw, p9)
    let (ok_target_active, target_active, p11) = custody_transfer_decimal_field(raw, p10)
    let (ok_target_presence, target_presence_verified, p12) = custody_transfer_decimal_field(raw, p11)
    let (ok_target_endpoint, target_endpoint_verified, p13) = custody_transfer_decimal_field(raw, p12)
    let (ok_target_session, target_session_verified, p14) = custody_transfer_decimal_field(raw, p13)
    let (ok_rollback, rollback_available, p15) = custody_transfer_decimal_field(raw, p14)
    let (ok_deadline, deadline_expired, p16) = custody_transfer_decimal_field(raw, p15)
    let (ok_authority, observation_authority_verified, p17) = custody_transfer_decimal_field(raw, p16)
    let (ok_fresh, sample_fresh, end_offset) = custody_transfer_decimal_field(raw, p17)
    let parsed = ok_schema == 1 && ok_phase == 1 && ok_policy == 1 &&
        ok_source_catalog == 1 && ok_loom_catalog == 1 && ok_staged == 1 &&
        ok_sealed == 1 && ok_bound == 1 && ok_source_active == 1 &&
        ok_source_identity == 1 && ok_source_quiesced == 1 &&
        ok_target_active == 1 && ok_target_presence == 1 &&
        ok_target_endpoint == 1 && ok_target_session == 1 &&
        ok_rollback == 1 && ok_deadline == 1 && ok_authority == 1 &&
        ok_fresh == 1 && str_char_at(raw, end_offset) <= 0
    if !parsed || schema != 9040 {
        println("SOUNIO_CUSTODY_TRANSFER decision=DENY_MALFORMED code=119 authority=Sounio")
        return 119
    }

    let decision = loom_custody_transfer_decide(
        phase,
        policy_state,
        source_catalog_agentd,
        catalog_committed_loom,
        target_staged,
        target_descriptor_sealed,
        resume_identity_bound,
        source_active,
        source_identity_verified,
        source_quiesced,
        target_active,
        target_presence_verified,
        target_endpoint_verified,
        target_session_verified,
        rollback_available,
        deadline_expired,
        observation_authority_verified,
        sample_fresh,
    )
    println("SOUNIO_CUSTODY_TRANSFER decision=" +
        custody_transfer_decision_name(decision) + " code=" +
        custody_transfer_code(decision) + " authority=Sounio")
    if decision >= 101 { return decision }
    0
}
