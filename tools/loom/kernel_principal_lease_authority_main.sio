//! Executable adapter for LOOM kernel-principal lease authority frame 9027.

fn kernel_principal_lease_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn kernel_principal_lease_digest_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) with Mut, Div, Panic {
    let (ok0, limb0, p0) = kernel_principal_lease_decimal_field(raw, start)
    let (ok1, limb1, p1) = kernel_principal_lease_decimal_field(raw, p0)
    let (ok2, limb2, p2) = kernel_principal_lease_decimal_field(raw, p1)
    let (ok3, limb3, p3) = kernel_principal_lease_decimal_field(raw, p2)
    let (ok4, limb4, p4) = kernel_principal_lease_decimal_field(raw, p3)
    let (ok5, limb5, p5) = kernel_principal_lease_decimal_field(raw, p4)
    let (ok6, limb6, p6) = kernel_principal_lease_decimal_field(raw, p5)
    let (ok7, limb7, p7) = kernel_principal_lease_decimal_field(raw, p6)
    let valid = ok0 == 1 && ok1 == 1 && ok2 == 1 && ok3 == 1 &&
        ok4 == 1 && ok5 == 1 && ok6 == 1 && ok7 == 1 &&
        limb0 <= 4294967295 && limb1 <= 4294967295 &&
        limb2 <= 4294967295 && limb3 <= 4294967295 &&
        limb4 <= 4294967295 && limb5 <= 4294967295 &&
        limb6 <= 4294967295 && limb7 <= 4294967295
    (if valid { 1 } else { 0 }, limb0, limb1, limb2, limb3,
        limb4, limb5, limb6, limb7, p7)
}

fn kernel_principal_lease_reason(decision: i64) -> string {
    if decision == 0 { return "allow" }
    if decision == 405 { return "wrong-stage-or-parent" }
    if decision == 463 { return "host-broker-boundary-incomplete" }
    if decision == 464 { return "allocator-lease-incomplete" }
    if decision == 465 { return "lifecycle-transition-invalid" }
    if decision == 466 { return "principal-certificate-incomplete" }
    if decision == 467 { return "privilege-drop-incomplete" }
    if decision == 468 { return "crash-recovery-incomplete" }
    if decision == 469 { return "affirmative-extinction-incomplete" }
    if decision == 470 { return "sabotage-incomplete" }
    if decision == 471 { return "provenance-incomplete" }
    "malformed-frame"
}

fn kernel_principal_lease_code(decision: i64) -> string {
    if decision == 0 { return "0" }
    if decision == 405 { return "405" }
    if decision == 463 { return "463" }
    if decision == 464 { return "464" }
    if decision == 465 { return "465" }
    if decision == 466 { return "466" }
    if decision == 467 { return "467" }
    if decision == 468 { return "468" }
    if decision == 469 { return "469" }
    if decision == 470 { return "470" }
    if decision == 471 { return "471" }
    "424"
}

fn kernel_principal_lease_case(case_index: i64) -> string {
    if case_index == 1 { return "1" }
    if case_index == 2 { return "2" }
    if case_index == 3 { return "3" }
    if case_index == 4 { return "4" }
    if case_index == 5 { return "5" }
    if case_index == 6 { return "6" }
    if case_index == 7 { return "7" }
    if case_index == 8 { return "8" }
    if case_index == 9 { return "9" }
    if case_index == 10 { return "10" }
    if case_index == 11 { return "11" }
    if case_index == 12 { return "12" }
    if case_index == 13 { return "13" }
    if case_index == 14 { return "14" }
    if case_index == 15 { return "15" }
    if case_index == 16 { return "16" }
    if case_index == 17 { return "17" }
    if case_index == 18 { return "18" }
    "unknown"
}

fn kernel_principal_lease_stage_name(stage: i64) -> string {
    if stage == 1 { return "GARDEN" }
    if stage == 2 { return "SOUNIO_EXECUTABLE" }
    if stage == 3 { return "SEMANTICS_FROZEN" }
    if stage == 4 { return "PARITY_OPEN" }
    if stage == 5 { return "MATERIAL_COVERAGE" }
    if stage == 6 { return "ATTACHMENT_OPEN" }
    if stage == 7 { return "CLAIM_READY" }
    "INVALID"
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = kernel_principal_lease_decimal_field(raw, 0)
    if ok_schema == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed_case = loom_kernel_principal_lease_authority_selftest()
        if failed_case == 0 {
            println("SOUNIO_KERNEL_PRINCIPAL_LEASE_SELFTEST PASS cases=18")
            return 0
        }
        println("SOUNIO_KERNEL_PRINCIPAL_LEASE_SELFTEST FAIL case=" +
            kernel_principal_lease_case(failed_case))
        return 70
    }

    let (ok_stage, stage, p1) = kernel_principal_lease_decimal_field(raw, p0)
    let (ok_parent, parent_9026_frozen, p2) = kernel_principal_lease_decimal_field(raw, p1)

    let (ok_host_owned, host_owned, p3) = kernel_principal_lease_decimal_field(raw, p2)
    let (ok_supervised, service_manager_supervised, p4) = kernel_principal_lease_decimal_field(raw, p3)
    let (ok_root_socket, root_owned_socket, p5) = kernel_principal_lease_decimal_field(raw, p4)
    let (ok_user_denied, user_invocation_denied, p6) = kernel_principal_lease_decimal_field(raw, p5)
    let (ok_policy_only, policy_only, p7) = kernel_principal_lease_decimal_field(raw, p6)
    let (ok_frozen_policy, frozen_policy_bound, p8) = kernel_principal_lease_decimal_field(raw, p7)

    let (ok_lock, single_writer_lock, p9) = kernel_principal_lease_decimal_field(raw, p8)
    let (ok_journal, durable_journal, p10) = kernel_principal_lease_decimal_field(raw, p9)
    let (ok_epoch_flag, monotonic_epoch, p11) = kernel_principal_lease_decimal_field(raw, p10)
    let (ok_disjoint, ranges_disjoint, p12) = kernel_principal_lease_decimal_field(raw, p11)
    let (ok_broker_ids, broker_selected_ids, p13) = kernel_principal_lease_decimal_field(raw, p12)
    let (ok_unique_gen, unique_generation, p14) = kernel_principal_lease_decimal_field(raw, p13)
    let (ok_previous_epoch, previous_epoch, p15) = kernel_principal_lease_decimal_field(raw, p14)
    let (ok_current_epoch, current_epoch, p16) = kernel_principal_lease_decimal_field(raw, p15)
    let (ok_previous_generation, previous_generation, p17) = kernel_principal_lease_decimal_field(raw, p16)
    let (ok_current_generation, current_generation, p18) = kernel_principal_lease_decimal_field(raw, p17)

    let (ok_operation, operation, p19) = kernel_principal_lease_decimal_field(raw, p18)
    let (ok_start_state, start_state, p20) = kernel_principal_lease_decimal_field(raw, p19)
    let (ok_end_state, end_state, p21) = kernel_principal_lease_decimal_field(raw, p20)
    let (ok_free_reserved, free_to_reserved, p22) = kernel_principal_lease_decimal_field(raw, p21)
    let (ok_reserved_mapped, reserved_to_mapped, p23) = kernel_principal_lease_decimal_field(raw, p22)
    let (ok_mapped_launched, mapped_to_launched, p24) = kernel_principal_lease_decimal_field(raw, p23)
    let (ok_launched_draining, launched_to_draining, p25) = kernel_principal_lease_decimal_field(raw, p24)
    let (ok_draining_quarantined, draining_to_quarantined, p26) = kernel_principal_lease_decimal_field(raw, p25)
    let (ok_quarantined_free, quarantined_to_free, p27) = kernel_principal_lease_decimal_field(raw, p26)

    let (ok_parent_allow, parent_9026_allow, p28) = kernel_principal_lease_decimal_field(raw, p27)
    let (ok_maps, exact_maps_ready, p29) = kernel_principal_lease_decimal_field(raw, p28)
    let (ok_cgroup, cgroup_ready, p30) = kernel_principal_lease_decimal_field(raw, p29)
    let (ok_namespaces, namespaces_ready, p31) = kernel_principal_lease_decimal_field(raw, p30)
    let (ok_pidfd, pidfd_ready, p32) = kernel_principal_lease_decimal_field(raw, p31)
    let (ok_pre_exec, pre_exec_gate, p33) = kernel_principal_lease_decimal_field(raw, p32)

    let (ok_drop, irreversible_drop, p34) = kernel_principal_lease_decimal_field(raw, p33)
    let (ok_nnp, no_new_privileges, p35) = kernel_principal_lease_decimal_field(raw, p34)
    let (ok_no_regain, privilege_regain_denied, p36) = kernel_principal_lease_decimal_field(raw, p35)
    let (ok_no_setuid, lane_setuid_absent, p37) = kernel_principal_lease_decimal_field(raw, p36)
    let (ok_caps, capabilities_empty, p38) = kernel_principal_lease_decimal_field(raw, p37)
    let (ok_fds, broker_descriptors_closed, p39) = kernel_principal_lease_decimal_field(raw, p38)

    let (ok_crash_closed, broker_crash_fail_closed, p40) = kernel_principal_lease_decimal_field(raw, p39)
    let (ok_orphans, orphan_scan_complete, p41) = kernel_principal_lease_decimal_field(raw, p40)
    let (ok_fenced, generation_fenced, p42) = kernel_principal_lease_decimal_field(raw, p41)
    let (ok_revoked, grants_revoked, p43) = kernel_principal_lease_decimal_field(raw, p42)
    let (ok_incomplete, incomplete_outcomes_materialized, p44) = kernel_principal_lease_decimal_field(raw, p43)
    let (ok_forced_quarantine, forced_quarantine, p45) = kernel_principal_lease_decimal_field(raw, p44)

    let (ok_reuse, reuse_mode, p46) = kernel_principal_lease_decimal_field(raw, p45)
    let (ok_never_used, never_used_receipt, p47) = kernel_principal_lease_decimal_field(raw, p46)
    let (ok_process_extinct, process_extinct, p48) = kernel_principal_lease_decimal_field(raw, p47)
    let (ok_namespace_extinct, namespace_extinct, p49) = kernel_principal_lease_decimal_field(raw, p48)
    let (ok_authority_extinct, authority_extinct, p50) = kernel_principal_lease_decimal_field(raw, p49)
    let (ok_quarantine, quarantine_receipt, p51) = kernel_principal_lease_decimal_field(raw, p50)
    let (ok_extinction_receipt, extinction_receipt_bound, p52) = kernel_principal_lease_decimal_field(raw, p51)

    let (ok_sabotage, sabotage_count, p53) = kernel_principal_lease_decimal_field(raw, p52)
    let (ok_sabotage_required, sabotage_required, p54) = kernel_principal_lease_decimal_field(raw, p53)
    let (ok_receipt, receipt_bound, p55) = kernel_principal_lease_decimal_field(raw, p54)

    let (ok_parent_hash, a0, a1, a2, a3, a4, a5, a6, a7, p56) =
        kernel_principal_lease_digest_field(raw, p55)
    let (ok_journal_hash, b0, b1, b2, b3, b4, b5, b6, b7, p57) =
        kernel_principal_lease_digest_field(raw, p56)
    let (ok_allocation_hash, c0, c1, c2, c3, c4, c5, c6, c7, p58) =
        kernel_principal_lease_digest_field(raw, p57)
    let (ok_lifecycle_hash, d0, d1, d2, d3, d4, d5, d6, d7, p59) =
        kernel_principal_lease_digest_field(raw, p58)
    let (ok_extinction_hash, e0, e1, e2, e3, e4, e5, e6, e7, p60) =
        kernel_principal_lease_digest_field(raw, p59)
    let (ok_source_hash, f0, f1, f2, f3, f4, f5, f6, f7, p61) =
        kernel_principal_lease_digest_field(raw, p60)
    let (ok_semantics_hash, g0, g1, g2, g3, g4, g5, g6, g7, p62) =
        kernel_principal_lease_digest_field(raw, p61)
    let (ok_toolchain_hash, h0, h1, h2, h3, h4, h5, h6, h7, p63) =
        kernel_principal_lease_digest_field(raw, p62)
    let (ok_hardware_hash, i0, i1, i2, i3, i4, i5, i6, i7, p64) =
        kernel_principal_lease_digest_field(raw, p63)
    let (ok_command_hash, j0, j1, j2, j3, j4, j5, j6, j7, p65) =
        kernel_principal_lease_digest_field(raw, p64)
    let (ok_result_hash, r0, r1, r2, r3, r4, r5, r6, r7, end_offset) =
        kernel_principal_lease_digest_field(raw, p65)

    let parsed = ok_schema == 1 && ok_stage == 1 && ok_parent == 1 &&
        ok_host_owned == 1 && ok_supervised == 1 && ok_root_socket == 1 &&
        ok_user_denied == 1 && ok_policy_only == 1 && ok_frozen_policy == 1 &&
        ok_lock == 1 && ok_journal == 1 && ok_epoch_flag == 1 &&
        ok_disjoint == 1 && ok_broker_ids == 1 && ok_unique_gen == 1 &&
        ok_previous_epoch == 1 && ok_current_epoch == 1 &&
        ok_previous_generation == 1 && ok_current_generation == 1 &&
        ok_operation == 1 && ok_start_state == 1 && ok_end_state == 1 &&
        ok_free_reserved == 1 && ok_reserved_mapped == 1 &&
        ok_mapped_launched == 1 && ok_launched_draining == 1 &&
        ok_draining_quarantined == 1 && ok_quarantined_free == 1 &&
        ok_parent_allow == 1 && ok_maps == 1 && ok_cgroup == 1 &&
        ok_namespaces == 1 && ok_pidfd == 1 && ok_pre_exec == 1 &&
        ok_drop == 1 && ok_nnp == 1 && ok_no_regain == 1 &&
        ok_no_setuid == 1 && ok_caps == 1 && ok_fds == 1 &&
        ok_crash_closed == 1 && ok_orphans == 1 && ok_fenced == 1 &&
        ok_revoked == 1 && ok_incomplete == 1 && ok_forced_quarantine == 1 &&
        ok_reuse == 1 && ok_never_used == 1 && ok_process_extinct == 1 &&
        ok_namespace_extinct == 1 && ok_authority_extinct == 1 &&
        ok_quarantine == 1 && ok_extinction_receipt == 1 &&
        ok_sabotage == 1 && ok_sabotage_required == 1 && ok_receipt == 1 &&
        ok_parent_hash == 1 && ok_journal_hash == 1 && ok_allocation_hash == 1 &&
        ok_lifecycle_hash == 1 && ok_extinction_hash == 1 && ok_source_hash == 1 &&
        ok_semantics_hash == 1 && ok_toolchain_hash == 1 && ok_hardware_hash == 1 &&
        ok_command_hash == 1 && ok_result_hash == 1 &&
        str_char_at(raw, end_offset) <= 0
    if !parsed {
        println("SOUNIO_KERNEL_PRINCIPAL_LEASE_DENY code=424 reason=malformed-frame stage=INVALID")
        return 424
    }
    if schema != 9027 {
        println("SOUNIO_KERNEL_PRINCIPAL_LEASE_DENY code=405 reason=wrong-stage-or-parent stage=" +
            kernel_principal_lease_stage_name(stage))
        return 405
    }

    let broker = admit_loom_kernel_principal_lease_broker(
        host_owned, service_manager_supervised, root_owned_socket,
        user_invocation_denied, policy_only, frozen_policy_bound,
    )
    let allocator = admit_loom_kernel_principal_lease_allocator(
        single_writer_lock, durable_journal, monotonic_epoch, ranges_disjoint,
        broker_selected_ids, unique_generation, previous_epoch, current_epoch,
        previous_generation, current_generation,
    )
    let lifecycle = admit_loom_kernel_principal_lease_lifecycle(
        operation, start_state, end_state, free_to_reserved, reserved_to_mapped,
        mapped_to_launched, launched_to_draining, draining_to_quarantined,
        quarantined_to_free,
    )
    let launch = admit_loom_kernel_principal_lease_launch(
        parent_9026_allow, exact_maps_ready, cgroup_ready, namespaces_ready,
        pidfd_ready, pre_exec_gate,
    )
    let privilege = admit_loom_kernel_principal_lease_privilege(
        irreversible_drop, no_new_privileges, privilege_regain_denied,
        lane_setuid_absent, capabilities_empty, broker_descriptors_closed,
    )
    let recovery = admit_loom_kernel_principal_lease_recovery(
        broker_crash_fail_closed, orphan_scan_complete, generation_fenced,
        grants_revoked, incomplete_outcomes_materialized, forced_quarantine,
    )
    let extinction = admit_loom_kernel_principal_lease_extinction(
        reuse_mode, never_used_receipt, process_extinct, namespace_extinct,
        authority_extinct, quarantine_receipt, extinction_receipt_bound,
    )
    let evidence = admit_loom_kernel_principal_lease_evidence(
        sabotage_count, sabotage_required, receipt_bound,
    )
    let bindings = admit_loom_kernel_principal_lease_bindings(
        admit_loom_kernel_principal_lease_digest256(a0, a1, a2, a3, a4, a5, a6, a7),
        admit_loom_kernel_principal_lease_digest256(b0, b1, b2, b3, b4, b5, b6, b7),
        admit_loom_kernel_principal_lease_digest256(c0, c1, c2, c3, c4, c5, c6, c7),
        admit_loom_kernel_principal_lease_digest256(d0, d1, d2, d3, d4, d5, d6, d7),
        admit_loom_kernel_principal_lease_digest256(e0, e1, e2, e3, e4, e5, e6, e7),
        admit_loom_kernel_principal_lease_digest256(f0, f1, f2, f3, f4, f5, f6, f7),
        admit_loom_kernel_principal_lease_digest256(g0, g1, g2, g3, g4, g5, g6, g7),
        admit_loom_kernel_principal_lease_digest256(h0, h1, h2, h3, h4, h5, h6, h7),
        admit_loom_kernel_principal_lease_digest256(i0, i1, i2, i3, i4, i5, i6, i7),
        admit_loom_kernel_principal_lease_digest256(j0, j1, j2, j3, j4, j5, j6, j7),
        admit_loom_kernel_principal_lease_digest256(r0, r1, r2, r3, r4, r5, r6, r7),
    )
    let decision = loom_kernel_principal_lease_authority_decide(
        stage, parent_9026_frozen, broker, allocator, lifecycle, launch,
        privilege, recovery, extinction, evidence, bindings,
    )
    if decision == 0 {
        println("SOUNIO_KERNEL_PRINCIPAL_LEASE_ALLOW code=0 reason=allow stage=" +
            kernel_principal_lease_stage_name(stage))
        return 0
    }
    println("SOUNIO_KERNEL_PRINCIPAL_LEASE_DENY code=" +
        kernel_principal_lease_code(decision) + " reason=" +
        kernel_principal_lease_reason(decision) + " stage=" +
        kernel_principal_lease_stage_name(stage))
    decision
}
