//! Executable adapter for LOOM kernel PrincipalCapsule authority frame 9028.

fn kernel_principal_capsule_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn kernel_principal_capsule_digest_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) with Mut, Div, Panic {
    let (ok0, limb0, p0) = kernel_principal_capsule_decimal_field(raw, start)
    let (ok1, limb1, p1) = kernel_principal_capsule_decimal_field(raw, p0)
    let (ok2, limb2, p2) = kernel_principal_capsule_decimal_field(raw, p1)
    let (ok3, limb3, p3) = kernel_principal_capsule_decimal_field(raw, p2)
    let (ok4, limb4, p4) = kernel_principal_capsule_decimal_field(raw, p3)
    let (ok5, limb5, p5) = kernel_principal_capsule_decimal_field(raw, p4)
    let (ok6, limb6, p6) = kernel_principal_capsule_decimal_field(raw, p5)
    let (ok7, limb7, p7) = kernel_principal_capsule_decimal_field(raw, p6)
    let valid = ok0 == 1 && ok1 == 1 && ok2 == 1 && ok3 == 1 &&
        ok4 == 1 && ok5 == 1 && ok6 == 1 && ok7 == 1 &&
        limb0 <= 4294967295 && limb1 <= 4294967295 &&
        limb2 <= 4294967295 && limb3 <= 4294967295 &&
        limb4 <= 4294967295 && limb5 <= 4294967295 &&
        limb6 <= 4294967295 && limb7 <= 4294967295
    (if valid { 1 } else { 0 }, limb0, limb1, limb2, limb3,
        limb4, limb5, limb6, limb7, p7)
}

fn kernel_principal_capsule_reason(decision: i64) -> string {
    if decision == 0 { return "allow" }
    if decision == 405 { return "wrong-stage-or-parent" }
    if decision == 472 { return "parent-launch-order-incomplete" }
    if decision == 473 { return "kernel-identity-incomplete" }
    if decision == 474 { return "isolation-vector-incomplete" }
    if decision == 475 { return "privilege-posture-incomplete" }
    if decision == 476 { return "pidfd-custody-incomplete" }
    if decision == 477 { return "grant-fence-incomplete" }
    if decision == 478 { return "recovery-lineage-incomplete" }
    if decision == 479 { return "provenance-incomplete" }
    if decision == 480 { return "sabotage-incomplete" }
    "malformed-frame"
}

fn kernel_principal_capsule_code(decision: i64) -> string {
    if decision == 0 { return "0" }
    if decision == 405 { return "405" }
    if decision == 472 { return "472" }
    if decision == 473 { return "473" }
    if decision == 474 { return "474" }
    if decision == 475 { return "475" }
    if decision == 476 { return "476" }
    if decision == 477 { return "477" }
    if decision == 478 { return "478" }
    if decision == 479 { return "479" }
    if decision == 480 { return "480" }
    "424"
}

fn kernel_principal_capsule_case(case_index: i64) -> string {
    if case_index == 1 { return "1" }
    if case_index == 2 { return "2" }
    if case_index == 3 { return "3" }
    if case_index == 4 { return "4" }
    if case_index == 5 { return "5" }
    if case_index == 6 { return "6" }
    if case_index == 7 { return "7" }
    if case_index == 8 { return "8" }
    if case_index == 9 { return "9" }
    if case_index == 10 { return "10" }
    if case_index == 11 { return "11" }
    if case_index == 12 { return "12" }
    if case_index == 13 { return "13" }
    if case_index == 14 { return "14" }
    if case_index == 15 { return "15" }
    if case_index == 16 { return "16" }
    if case_index == 17 { return "17" }
    if case_index == 18 { return "18" }
    if case_index == 19 { return "19" }
    "unknown"
}

fn kernel_principal_capsule_stage_name(stage: i64) -> string {
    if stage == 1 { return "GARDEN" }
    if stage == 2 { return "SOUNIO_EXECUTABLE" }
    if stage == 3 { return "SEMANTICS_FROZEN" }
    if stage == 4 { return "PARITY_OPEN" }
    if stage == 5 { return "MATERIAL_COVERAGE" }
    if stage == 6 { return "ATTACHMENT_OPEN" }
    if stage == 7 { return "CLAIM_READY" }
    "INVALID"
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = kernel_principal_capsule_decimal_field(raw, 0)
    if ok_schema == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed_case = loom_kernel_principal_capsule_authority_selftest()
        if failed_case == 0 {
            println("SOUNIO_KERNEL_PRINCIPAL_CAPSULE_SELFTEST PASS cases=19")
            return 0
        }
        println("SOUNIO_KERNEL_PRINCIPAL_CAPSULE_SELFTEST FAIL case=" +
            kernel_principal_capsule_case(failed_case))
        return 70
    }

    let (ok_stage, stage, p1) = kernel_principal_capsule_decimal_field(raw, p0)
    let (ok_preregistered, preregistered, p2) = kernel_principal_capsule_decimal_field(raw, p1)

    let (ok_operation, operation, p3) = kernel_principal_capsule_decimal_field(raw, p2)
    let (ok_parent_9026, parent_9026_allow, p4) = kernel_principal_capsule_decimal_field(raw, p3)
    let (ok_parent_9027, parent_9027_allow, p5) = kernel_principal_capsule_decimal_field(raw, p4)
    let (ok_start_state, lease_start_state, p6) = kernel_principal_capsule_decimal_field(raw, p5)
    let (ok_target_state, lease_target_state, p7) = kernel_principal_capsule_decimal_field(raw, p6)
    let (ok_barrier, preexec_barrier_closed, p8) = kernel_principal_capsule_decimal_field(raw, p7)
    let (ok_uncommitted, journal_transition_uncommitted, p9) = kernel_principal_capsule_decimal_field(raw, p8)

    let (ok_host_pid, host_pid, p10) = kernel_principal_capsule_decimal_field(raw, p9)
    let (ok_start_time, start_time, p11) = kernel_principal_capsule_decimal_field(raw, p10)
    let (ok_pidfd_identity, pidfd_identity, p12) = kernel_principal_capsule_decimal_field(raw, p11)
    let (ok_broker_epoch, broker_epoch, p13) = kernel_principal_capsule_decimal_field(raw, p12)
    let (ok_lease_generation, lease_generation, p14) = kernel_principal_capsule_decimal_field(raw, p13)
    let (ok_custody_generation, custody_generation, p15) = kernel_principal_capsule_decimal_field(raw, p14)
    let (ok_pidfd_peer, pidfd_peer_matches, p16) = kernel_principal_capsule_decimal_field(raw, p15)
    let (ok_start_match, start_time_matches, p17) = kernel_principal_capsule_decimal_field(raw, p16)
    let (ok_vector, vector_complete, p18) = kernel_principal_capsule_decimal_field(raw, p17)

    let (ok_ns, namespaces_distinct, p19) = kernel_principal_capsule_decimal_field(raw, p18)
    let (ok_maps, maps_exact, p20) = kernel_principal_capsule_decimal_field(raw, p19)
    let (ok_disjoint, maps_disjoint, p21) = kernel_principal_capsule_decimal_field(raw, p20)
    let (ok_cgroup, cgroup_exact, p22) = kernel_principal_capsule_decimal_field(raw, p21)
    let (ok_resources, resources_enforced, p23) = kernel_principal_capsule_decimal_field(raw, p22)
    let (ok_descendants, descendants_contained, p24) = kernel_principal_capsule_decimal_field(raw, p23)
    let (ok_no_escape, cgroup_escape_denied, p25) = kernel_principal_capsule_decimal_field(raw, p24)

    let (ok_ids, ids_exact, p26) = kernel_principal_capsule_decimal_field(raw, p25)
    let (ok_groups, supplementary_groups_empty, p27) = kernel_principal_capsule_decimal_field(raw, p26)
    let (ok_caps, capabilities_empty, p28) = kernel_principal_capsule_decimal_field(raw, p27)
    let (ok_nnp, no_new_privileges, p29) = kernel_principal_capsule_decimal_field(raw, p28)
    let (ok_seccomp, seccomp_installed, p30) = kernel_principal_capsule_decimal_field(raw, p29)
    let (ok_nondumpable, nondumpable, p31) = kernel_principal_capsule_decimal_field(raw, p30)
    let (ok_setid, setid_path_absent, p32) = kernel_principal_capsule_decimal_field(raw, p31)
    let (ok_broker_fds, broker_descriptors_absent, p33) = kernel_principal_capsule_decimal_field(raw, p32)

    let (ok_broker_pidfd, broker_holds_pidfd, p34) = kernel_principal_capsule_decimal_field(raw, p33)
    let (ok_cloexec, pidfd_cloexec, p35) = kernel_principal_capsule_decimal_field(raw, p34)
    let (ok_lane_pidfd, lane_holds_pidfd, p36) = kernel_principal_capsule_decimal_field(raw, p35)
    let (ok_resident_pidfd, resident_holds_pidfd, p37) = kernel_principal_capsule_decimal_field(raw, p36)
    let (ok_raw_pid, raw_pid_authority_exported, p38) = kernel_principal_capsule_decimal_field(raw, p37)
    let (ok_raw_pidfd, raw_pidfd_authority_exported, p39) = kernel_principal_capsule_decimal_field(raw, p38)
    let (ok_lookup, broker_lookup_required, p40) = kernel_principal_capsule_decimal_field(raw, p39)

    let (ok_non_authorizing, capsule_non_authorizing, p41) = kernel_principal_capsule_decimal_field(raw, p40)
    let (ok_grant_bound, execgrant_bound, p42) = kernel_principal_capsule_decimal_field(raw, p41)
    let (ok_single_use, single_use, p43) = kernel_principal_capsule_decimal_field(raw, p42)
    let (ok_unconsumed, unconsumed, p44) = kernel_principal_capsule_decimal_field(raw, p43)
    let (ok_peer, peer_bound, p45) = kernel_principal_capsule_decimal_field(raw, p44)
    let (ok_ancestry, ancestry_bound, p46) = kernel_principal_capsule_decimal_field(raw, p45)
    let (ok_effect, effect_bound, p47) = kernel_principal_capsule_decimal_field(raw, p46)
    let (ok_command, command_bound, p48) = kernel_principal_capsule_decimal_field(raw, p47)
    let (ok_review, review_only_enforced, p49) = kernel_principal_capsule_decimal_field(raw, p48)

    let (ok_recovery_mode, recovery_mode, p50) = kernel_principal_capsule_decimal_field(raw, p49)
    let (ok_previous_epoch, previous_broker_epoch, p51) = kernel_principal_capsule_decimal_field(raw, p50)
    let (ok_current_epoch, current_broker_epoch, p52) = kernel_principal_capsule_decimal_field(raw, p51)
    let (ok_previous_custody, previous_custody_generation, p53) = kernel_principal_capsule_decimal_field(raw, p52)
    let (ok_current_custody, current_custody_generation, p54) = kernel_principal_capsule_decimal_field(raw, p53)
    let (ok_lineage, lineage_equal, p55) = kernel_principal_capsule_decimal_field(raw, p54)
    let (ok_revoked, prior_grants_revoked, p56) = kernel_principal_capsule_decimal_field(raw, p55)
    let (ok_extinct, old_custody_extinct, p57) = kernel_principal_capsule_decimal_field(raw, p56)
    let (ok_quarantine, remains_quarantined, p58) = kernel_principal_capsule_decimal_field(raw, p57)
    let (ok_release_denied, barrier_release_denied, p59) = kernel_principal_capsule_decimal_field(raw, p58)

    let (ok_sabotage, sabotage_count, p60) = kernel_principal_capsule_decimal_field(raw, p59)
    let (ok_sabotage_required, sabotage_required, p61) = kernel_principal_capsule_decimal_field(raw, p60)
    let (ok_receipt, receipt_bound, p62) = kernel_principal_capsule_decimal_field(raw, p61)

    let (ok_parent_9026_hash, a0, a1, a2, a3, a4, a5, a6, a7, p63) =
        kernel_principal_capsule_digest_field(raw, p62)
    let (ok_parent_9027_hash, b0, b1, b2, b3, b4, b5, b6, b7, p64) =
        kernel_principal_capsule_digest_field(raw, p63)
    let (ok_launch_hash, c0, c1, c2, c3, c4, c5, c6, c7, p65) =
        kernel_principal_capsule_digest_field(raw, p64)
    let (ok_custody_hash, d0, d1, d2, d3, d4, d5, d6, d7, p66) =
        kernel_principal_capsule_digest_field(raw, p65)
    let (ok_grant_hash, e0, e1, e2, e3, e4, e5, e6, e7, p67) =
        kernel_principal_capsule_digest_field(raw, p66)
    let (ok_recovery_hash, f0, f1, f2, f3, f4, f5, f6, f7, p68) =
        kernel_principal_capsule_digest_field(raw, p67)
    let (ok_capsule_hash, g0, g1, g2, g3, g4, g5, g6, g7, p69) =
        kernel_principal_capsule_digest_field(raw, p68)
    let (ok_source_hash, h0, h1, h2, h3, h4, h5, h6, h7, p70) =
        kernel_principal_capsule_digest_field(raw, p69)
    let (ok_semantics_hash, i0, i1, i2, i3, i4, i5, i6, i7, p71) =
        kernel_principal_capsule_digest_field(raw, p70)
    let (ok_toolchain_hash, j0, j1, j2, j3, j4, j5, j6, j7, p72) =
        kernel_principal_capsule_digest_field(raw, p71)
    let (ok_hardware_hash, k0, k1, k2, k3, k4, k5, k6, k7, p73) =
        kernel_principal_capsule_digest_field(raw, p72)
    let (ok_command_hash, l0, l1, l2, l3, l4, l5, l6, l7, p74) =
        kernel_principal_capsule_digest_field(raw, p73)
    let (ok_result_hash, m0, m1, m2, m3, m4, m5, m6, m7, end_offset) =
        kernel_principal_capsule_digest_field(raw, p74)

    let parsed = ok_schema == 1 && ok_stage == 1 && ok_preregistered == 1 &&
        ok_operation == 1 && ok_parent_9026 == 1 && ok_parent_9027 == 1 &&
        ok_start_state == 1 && ok_target_state == 1 && ok_barrier == 1 &&
        ok_uncommitted == 1 && ok_host_pid == 1 && ok_start_time == 1 &&
        ok_pidfd_identity == 1 && ok_broker_epoch == 1 &&
        ok_lease_generation == 1 && ok_custody_generation == 1 &&
        ok_pidfd_peer == 1 && ok_start_match == 1 && ok_vector == 1 &&
        ok_ns == 1 && ok_maps == 1 && ok_disjoint == 1 && ok_cgroup == 1 &&
        ok_resources == 1 && ok_descendants == 1 && ok_no_escape == 1 &&
        ok_ids == 1 && ok_groups == 1 && ok_caps == 1 && ok_nnp == 1 &&
        ok_seccomp == 1 && ok_nondumpable == 1 && ok_setid == 1 &&
        ok_broker_fds == 1 && ok_broker_pidfd == 1 && ok_cloexec == 1 &&
        ok_lane_pidfd == 1 && ok_resident_pidfd == 1 && ok_raw_pid == 1 &&
        ok_raw_pidfd == 1 && ok_lookup == 1 && ok_non_authorizing == 1 &&
        ok_grant_bound == 1 && ok_single_use == 1 && ok_unconsumed == 1 &&
        ok_peer == 1 && ok_ancestry == 1 && ok_effect == 1 && ok_command == 1 &&
        ok_review == 1 && ok_recovery_mode == 1 && ok_previous_epoch == 1 &&
        ok_current_epoch == 1 && ok_previous_custody == 1 &&
        ok_current_custody == 1 && ok_lineage == 1 && ok_revoked == 1 &&
        ok_extinct == 1 && ok_quarantine == 1 && ok_release_denied == 1 &&
        ok_sabotage == 1 && ok_sabotage_required == 1 && ok_receipt == 1 &&
        ok_parent_9026_hash == 1 && ok_parent_9027_hash == 1 &&
        ok_launch_hash == 1 && ok_custody_hash == 1 && ok_grant_hash == 1 &&
        ok_recovery_hash == 1 && ok_capsule_hash == 1 && ok_source_hash == 1 &&
        ok_semantics_hash == 1 && ok_toolchain_hash == 1 &&
        ok_hardware_hash == 1 && ok_command_hash == 1 && ok_result_hash == 1 &&
        str_char_at(raw, end_offset) <= 0
    if !parsed {
        println("SOUNIO_KERNEL_PRINCIPAL_CAPSULE_DENY code=424 reason=malformed-frame stage=INVALID")
        return 424
    }
    if schema != 9028 {
        println("SOUNIO_KERNEL_PRINCIPAL_CAPSULE_DENY code=405 reason=wrong-stage-or-parent stage=" +
            kernel_principal_capsule_stage_name(stage))
        return 405
    }

    let order = admit_loom_kernel_principal_capsule_order(
        operation, parent_9026_allow, parent_9027_allow, lease_start_state,
        lease_target_state, preexec_barrier_closed, journal_transition_uncommitted,
    )
    let identity = admit_loom_kernel_principal_capsule_identity(
        host_pid, start_time, pidfd_identity, broker_epoch, lease_generation,
        custody_generation, pidfd_peer_matches, start_time_matches, vector_complete,
    )
    let isolation = admit_loom_kernel_principal_capsule_isolation(
        namespaces_distinct, maps_exact, maps_disjoint, cgroup_exact,
        resources_enforced, descendants_contained, cgroup_escape_denied,
    )
    let privilege = admit_loom_kernel_principal_capsule_privilege(
        ids_exact, supplementary_groups_empty, capabilities_empty,
        no_new_privileges, seccomp_installed, nondumpable, setid_path_absent,
        broker_descriptors_absent,
    )
    let custody = admit_loom_kernel_principal_capsule_custody(
        broker_holds_pidfd, pidfd_cloexec, lane_holds_pidfd,
        resident_holds_pidfd, raw_pid_authority_exported,
        raw_pidfd_authority_exported, broker_lookup_required,
    )
    let grant = admit_loom_kernel_principal_capsule_grant(
        capsule_non_authorizing, execgrant_bound, single_use, unconsumed,
        peer_bound, ancestry_bound, effect_bound, command_bound,
        review_only_enforced,
    )
    let recovery = admit_loom_kernel_principal_capsule_recovery(
        recovery_mode, previous_broker_epoch, current_broker_epoch,
        previous_custody_generation, current_custody_generation, lineage_equal,
        prior_grants_revoked, old_custody_extinct, remains_quarantined,
        barrier_release_denied,
    )
    let evidence = admit_loom_kernel_principal_capsule_evidence(
        sabotage_count, sabotage_required, receipt_bound,
    )
    let bindings = admit_loom_kernel_principal_capsule_bindings(
        admit_loom_kernel_principal_capsule_digest256(a0, a1, a2, a3, a4, a5, a6, a7),
        admit_loom_kernel_principal_capsule_digest256(b0, b1, b2, b3, b4, b5, b6, b7),
        admit_loom_kernel_principal_capsule_digest256(c0, c1, c2, c3, c4, c5, c6, c7),
        admit_loom_kernel_principal_capsule_digest256(d0, d1, d2, d3, d4, d5, d6, d7),
        admit_loom_kernel_principal_capsule_digest256(e0, e1, e2, e3, e4, e5, e6, e7),
        admit_loom_kernel_principal_capsule_digest256(f0, f1, f2, f3, f4, f5, f6, f7),
        admit_loom_kernel_principal_capsule_digest256(g0, g1, g2, g3, g4, g5, g6, g7),
        admit_loom_kernel_principal_capsule_digest256(h0, h1, h2, h3, h4, h5, h6, h7),
        admit_loom_kernel_principal_capsule_digest256(i0, i1, i2, i3, i4, i5, i6, i7),
        admit_loom_kernel_principal_capsule_digest256(j0, j1, j2, j3, j4, j5, j6, j7),
        admit_loom_kernel_principal_capsule_digest256(k0, k1, k2, k3, k4, k5, k6, k7),
        admit_loom_kernel_principal_capsule_digest256(l0, l1, l2, l3, l4, l5, l6, l7),
        admit_loom_kernel_principal_capsule_digest256(m0, m1, m2, m3, m4, m5, m6, m7),
    )
    let decision = loom_kernel_principal_capsule_authority_decide(
        stage, preregistered, order, identity, isolation, privilege, custody,
        grant, recovery, evidence, bindings,
    )
    if decision == 0 {
        println("SOUNIO_KERNEL_PRINCIPAL_CAPSULE_ALLOW code=0 reason=allow stage=" +
            kernel_principal_capsule_stage_name(stage))
        return 0
    }
    println("SOUNIO_KERNEL_PRINCIPAL_CAPSULE_DENY code=" +
        kernel_principal_capsule_code(decision) + " reason=" +
        kernel_principal_capsule_reason(decision) + " stage=" +
        kernel_principal_capsule_stage_name(stage))
    decision
}
