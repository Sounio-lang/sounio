//! Native Sounio policy adapter for Loom durable-obligation frame 9007.

fn obligation_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 4096 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        value = value * 10 + (code - 48)
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn obligation_digest_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) with Mut, Div, Panic {
    let (ok0, limb0, p0) = obligation_decimal_field(raw, start)
    let (ok1, limb1, p1) = obligation_decimal_field(raw, p0)
    let (ok2, limb2, p2) = obligation_decimal_field(raw, p1)
    let (ok3, limb3, p3) = obligation_decimal_field(raw, p2)
    let (ok4, limb4, p4) = obligation_decimal_field(raw, p3)
    let (ok5, limb5, p5) = obligation_decimal_field(raw, p4)
    let (ok6, limb6, p6) = obligation_decimal_field(raw, p5)
    let (ok7, limb7, p7) = obligation_decimal_field(raw, p6)
    let valid = ok0 == 1 && ok1 == 1 && ok2 == 1 && ok3 == 1 &&
        ok4 == 1 && ok5 == 1 && ok6 == 1 && ok7 == 1 &&
        limb0 <= 4294967295 && limb1 <= 4294967295 &&
        limb2 <= 4294967295 && limb3 <= 4294967295 &&
        limb4 <= 4294967295 && limb5 <= 4294967295 &&
        limb6 <= 4294967295 && limb7 <= 4294967295
    (if valid { 1 } else { 0 }, limb0, limb1, limb2, limb3,
        limb4, limb5, limb6, limb7, p7)
}

fn obligation_transition_name(kind: i64) -> string {
    if kind == 1 { return "open" }
    if kind == 2 { return "consume" }
    if kind == 3 { return "claim" }
    if kind == 4 { return "renew" }
    if kind == 5 { return "interrupt" }
    if kind == 6 { return "recover" }
    if kind == 7 { return "complete" }
    "unknown"
}

fn obligation_state_name(state: i64) -> string {
    if state == 1 { return "1" }
    if state == 2 { return "2" }
    if state == 3 { return "3" }
    if state == 4 { return "4" }
    if state == 5 { return "5" }
    if state == 6 { return "6" }
    "unknown"
}

fn main() -> i64 with IO, Mut, Div, LoomObligationHostTrust, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = obligation_decimal_field(raw, 0)
    let (ok_kind, kind, p1) = obligation_decimal_field(raw, p0)
    let (ok_previous, previous, p2) = obligation_decimal_field(raw, p1)
    let (ok_next, next, p3) = obligation_decimal_field(raw, p2)
    let (ok_obligation, obligation, p4) = obligation_decimal_field(raw, p3)
    let (ok_actor, actor, p5) = obligation_decimal_field(raw, p4)
    let (ok_generation, generation, p6) = obligation_decimal_field(raw, p5)
    let (ok_claim, claim, p7) = obligation_decimal_field(raw, p6)
    let (ok_deadline, deadline, p8) = obligation_decimal_field(raw, p7)
    let (ok_message, m0, m1, m2, m3, m4, m5, m6, m7, p9) =
        obligation_digest_field(raw, p8)
    let (ok_outcome, o0, o1, o2, o3, o4, o5, o6, o7, p10) =
        obligation_digest_field(raw, p9)
    let (ok_evidence, e0, e1, e2, e3, e4, e5, e6, e7, end_offset) =
        obligation_digest_field(raw, p10)
    let parsed = ok_schema == 1 && ok_kind == 1 && ok_previous == 1 &&
        ok_next == 1 && ok_obligation == 1 && ok_actor == 1 &&
        ok_generation == 1 && ok_claim == 1 && ok_deadline == 1 &&
        ok_message == 1 && ok_outcome == 1 && ok_evidence == 1 &&
        str_char_at(raw, end_offset) <= 0
    if !parsed || schema != 9007 || obligation <= 0 {
        println("SOUNIO_OBLIGATION_REFUSE reason=malformed-frame")
        return 64
    }
    let message = admit_obligation_digest256(m0, m1, m2, m3, m4, m5, m6, m7)
    let outcome = admit_obligation_digest256(o0, o1, o2, o3, o4, o5, o6, o7)
    let evidence = admit_obligation_digest256(e0, e1, e2, e3, e4, e5, e6, e7)
    if host_obligation_transition_accepts(
        kind, previous, next, obligation, actor, generation, claim, deadline,
        message, outcome, evidence,
    ) {
        println("SOUNIO_OBLIGATION_ACCEPT schema=loom-native-obligation-v1 transition=" +
            obligation_transition_name(kind) + " state=" + obligation_state_name(next))
        return 0
    }
    println("SOUNIO_OBLIGATION_REFUSE reason=transition-policy")
    42
}
