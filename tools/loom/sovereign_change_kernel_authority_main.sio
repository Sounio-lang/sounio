//! Packed executable adapter for LOOM action 9043.

fn change_decimal_field(raw: string, start: i64) -> (i64, i64, i64) with Mut, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn change_decision(decision: i64) -> string {
    if decision == 1 { return "CHANGE_PREPARED" }
    if decision == 2 { return "CHANGE_CONSUMED" }
    if decision == 3 { return "COMMIT_ADMIT" }
    if decision == 4 { return "CI_ADMIT" }
    if decision == 5 { return "PRODUCTION_GATE_READY" }
    if decision == 613 { return "DENY613" }
    if decision == 614 { return "DENY614" }
    if decision == 615 { return "DENY615" }
    if decision == 616 { return "DENY616" }
    if decision == 617 { return "DENY617" }
    if decision == 618 { return "DENY618" }
    if decision == 619 { return "DENY619" }
    if decision == 620 { return "DENY620" }
    if decision == 621 { return "DENY621" }
    if decision == 622 { return "DENY622" }
    if decision == 623 { return "DENY623" }
    if decision == 624 { return "DENY624" }
    if decision == 625 { return "DENY625" }
    if decision == 626 { return "DENY626" }
    if decision == 627 { return "DENY627" }
    if decision == 628 { return "DENY628" }
    "DENY424"
}

fn change_fields() with IO {
    println("LOOM_SOVEREIGN_CHANGE_KERNEL_FIELDS_V1")
    println("parent=action-9042-frozen+production-active")
    println("intent=event+patch+worktree+HEAD+index+file-set")
    println("grant=kernel-memory+non-bearer+single-use+atomic-consume")
    println("peer=SO_PEERCRED+pidfd+start-tick+harness-ancestry+executable+operation")
    println("commit=tree+parent+message+index+consumed-change")
    println("ci=receipt-consumer+no-policy-reinterpretation")
}

fn main() -> i64 with IO, Mut, Panic {
    let raw = read_line()
    let (o0, schema, p0) = change_decimal_field(raw, 0)
    if o0 == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed = loom_sovereign_change_kernel_selftest()
        if failed == 0 {
            println("SOUNIO_SOVEREIGN_CHANGE_KERNEL_SELFTEST PASS cases=21")
            return 0
        }
        println("SOUNIO_SOVEREIGN_CHANGE_KERNEL_SELFTEST FAIL")
        return 70
    }
    let (o1, mode, p1) = change_decimal_field(raw, p0)
    let (o2, stage, p2) = change_decimal_field(raw, p1)
    let (o3, word, p3) = change_decimal_field(raw, p2)
    let (o4, sabotage_count, p4) = change_decimal_field(raw, p3)
    let (o5, sabotage_required, p5) = change_decimal_field(raw, p4)
    if o0 != 1 || schema != 9043 || o1 != 1 || o2 != 1 || o3 != 1 ||
        o4 != 1 || o5 != 1 || mode < 1 || mode > 5 || stage < 0 ||
        word < 0 || word >= 4611686018427387904 ||
        sabotage_count < 0 || sabotage_required < 0 ||
        str_char_at(raw, p5) > 0 {
        println("SOUNIO_SOVEREIGN_CHANGE_KERNEL DENY424 reason=malformed-frame semantic_authority=Sounio action=9043")
        return 42
    }
    let decision = judge_loom_sovereign_change_kernel_words(
        mode, stage, word, sabotage_count, sabotage_required,
    )
    println("SOUNIO_SOVEREIGN_CHANGE_KERNEL " + change_decision(decision) +
        " semantic_authority=Sounio action=9043")
    if decision >= 1 && decision <= 5 {
        change_fields()
        return 0
    }
    42
}
