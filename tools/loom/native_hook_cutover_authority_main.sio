//! Packed executable adapter for LOOM action 9045.

fn hook_decimal_field(raw: string, start: i64) -> (i64, i64, i64) with Mut, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn hook_decision(decision: i64) -> string {
    if decision == 1 { return "HOOK_EVENT_ADMIT" }
    if decision == 2 { return "PROVIDER_CANARY_ADMIT" }
    if decision == 3 { return "CLAIM_READY" }
    if decision == 651 { return "DENY651" }
    if decision == 652 { return "DENY652" }
    if decision == 653 { return "DENY653" }
    if decision == 654 { return "DENY654" }
    if decision == 655 { return "DENY655" }
    if decision == 656 { return "DENY656" }
    if decision == 657 { return "DENY657" }
    if decision == 658 { return "DENY658" }
    if decision == 659 { return "DENY659" }
    if decision == 660 { return "DENY660" }
    if decision == 661 { return "DENY661" }
    "DENY424"
}

fn main() -> i64 with IO, Mut, Panic {
    let raw = read_line()
    let (o0, schema, p0) = hook_decimal_field(raw, 0)
    if o0 == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed = loom_native_hook_cutover_selftest()
        if failed == 0 {
            println("SOUNIO_NATIVE_HOOK_CUTOVER_SELFTEST PASS cases=12")
            return 0
        }
        println("SOUNIO_NATIVE_HOOK_CUTOVER_SELFTEST FAIL")
        return 70
    }
    let (o1, mode, p1) = hook_decimal_field(raw, p0)
    let (o2, stage, p2) = hook_decimal_field(raw, p1)
    let (o3, provider, p3) = hook_decimal_field(raw, p2)
    let (o4, dialect, p4) = hook_decimal_field(raw, p3)
    let (o5, event, p5) = hook_decimal_field(raw, p4)
    let (o6, word, p6) = hook_decimal_field(raw, p5)
    let (o7, canary_mask, p7) = hook_decimal_field(raw, p6)
    let (o8, semantic_hash0, p8) = hook_decimal_field(raw, p7)
    let (o9, semantic_hash1, p9) = hook_decimal_field(raw, p8)
    let (o10, ocaml_hash, p10) = hook_decimal_field(raw, p9)
    let (o11, config_hash, p11) = hook_decimal_field(raw, p10)
    let (o12, sabotage_count, p12) = hook_decimal_field(raw, p11)
    let (o13, sabotage_required, p13) = hook_decimal_field(raw, p12)
    if o0 != 1 || schema != 9045 || o1 != 1 || o2 != 1 || o3 != 1 ||
        o4 != 1 || o5 != 1 || o6 != 1 || o7 != 1 || o8 != 1 ||
        o9 != 1 || o10 != 1 || o11 != 1 || o12 != 1 || o13 != 1 ||
        mode < 1 || mode > 3 || stage < 0 || provider < 0 || dialect < 0 ||
        event < 0 || word < 0 || canary_mask < 0 || sabotage_count < 0 ||
        sabotage_required < 0 || str_char_at(raw, p13) > 0 {
        println("SOUNIO_NATIVE_HOOK_CUTOVER DENY424 reason=malformed-frame semantic_authority=Sounio action=9045")
        return 42
    }
    let decision = judge_loom_native_hook_cutover_words(
        mode, stage, provider, dialect, event, word, canary_mask,
        semantic_hash0, semantic_hash1, ocaml_hash, config_hash,
        sabotage_count, sabotage_required,
    )
    println("SOUNIO_NATIVE_HOOK_CUTOVER " + hook_decision(decision) +
        " semantic_authority=Sounio action=9045")
    if decision >= 1 && decision <= 3 { return 0 }
    42
}
