//! Packed executable adapter for LOOM action 9036.

fn exec_result_record_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn exec_result_record_decision(decision: i64) -> string {
    if decision == 1 { return "ISSUE" }
    if decision == 570 { return "DENY570" }
    if decision == 571 { return "DENY571" }
    if decision == 572 { return "DENY572" }
    if decision == 573 { return "DENY573" }
    if decision == 574 { return "DENY574" }
    if decision == 575 { return "DENY575" }
    if decision == 576 { return "DENY576" }
    if decision == 577 { return "DENY577" }
    "DENY424"
}

fn exec_result_record_fields() with IO {
    println("LOOM_EXEC_RESULT_RECORD_FIELDS_V1")
    println("LOOM_EXEC_RESULT_RECORD/1")
    println("sounio-check")
    println("31089d39690c8e008dd7ea9bfecefd7e51e4257cd96e091f7fb492c240ed342c")
    println("d6e513e785a170a7ce8cd8f07a66e5325736ffdf21cf8f366d82c4f5ef4f15cf")
    println("13164c31635609daa3ac8e993be03ee293f48f95fa1552b91f245e4d02a81915")
    println("LOOM_EXEC_RESULT_RECORD/1|operation=sounio-check|event_sha256|command_template_sha256|generation_sha256|source_sha256|compiler_sha256|argv_sha256|artifact_sha256|artifact_bytes|stdout_sha256|stderr_sha256|diagnostics_sha256|sandbox_profile_sha256|principal_sha256|descriptor_binding_sha256|grant_receipt_sha256|exit_code")
    println("loom-result-v2:{event_sha256}:{generation_sha256}:{record_sha256}")
    println("record_hash=sha256(canonical_fields)")
    println("handle_is_bearer=false")
    println("handle_is_execution_authority=false")
    println("artifact_executed=false")
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = exec_result_record_decimal_field(raw, 0)
    if ok_schema == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed = loom_exec_result_record_selftest()
        if failed == 0 {
            println("SOUNIO_EXEC_RESULT_RECORD_SELFTEST PASS cases=9")
            return 0
        }
        println("SOUNIO_EXEC_RESULT_RECORD_SELFTEST FAIL")
        return 70
    }
    let (ok_word0, word0, p1) = exec_result_record_decimal_field(raw, p0)
    let (ok_word1, word1, p2) = exec_result_record_decimal_field(raw, p1)
    if ok_schema != 1 || schema != 9036 || ok_word0 != 1 || ok_word1 != 1 ||
        word0 < 0 || word0 >= 1073741824 ||
        word1 < 0 || word1 >= 131072 || str_char_at(raw, p2) > 0 {
        println("SOUNIO_EXEC_RESULT_RECORD DENY424 reason=malformed-frame semantic_authority=Sounio action=9036")
        return 42
    }
    let decision = judge_loom_exec_result_record_v1_words(word0, word1)
    let label = exec_result_record_decision(decision)
    if decision == 1 {
        println("SOUNIO_EXEC_RESULT_RECORD ISSUE semantic_authority=Sounio action=9036")
        exec_result_record_fields()
        return 0
    }
    println("SOUNIO_EXEC_RESULT_RECORD " + label +
        " semantic_authority=Sounio action=9036")
    42
}
