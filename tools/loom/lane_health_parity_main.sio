//! Exhaustive measurement adapter for the frozen truthful lane-health rule.

fn lane_health_parity_i64_to_string(n: i64) -> string with Mut, Panic, Div {
    var buf: [i8; 24] = [0; 24]
    if n == 0 {
        buf[0] = 48 as i8
        return str_from_bytes(buf, 1)
    }
    var val: i64 = n
    var digits: [i8; 20] = [0; 20]
    var count: i64 = 0
    while val > 0 && count < 20 {
        let digit = val % 10
        digits[count as usize] = (48 + digit) as i8
        val = val / 10
        count = count + 1
    }
    var pos: i64 = 0
    var index: i64 = count - 1
    while index >= 0 {
        buf[pos as usize] = digits[index as usize]
        pos = pos + 1
        index = index - 1
    }
    str_from_bytes(buf, pos)
}

fn lane_health_parity_hex_digit(value: i64) -> i8 {
    if value < 10 { return (48 + value) as i8 }
    (87 + value) as i8
}

fn lane_health_parity_digest_hex(digest: SHA256Digest) -> string with Mut, Panic, Div {
    var output: [i8; 65] = [0; 65]
    var index: i64 = 0
    while index < 32 {
        let value = digest.bytes[index as i32] as i64
        output[(index * 2) as usize] = lane_health_parity_hex_digit((value >> 4) & 15)
        output[(index * 2 + 1) as usize] = lane_health_parity_hex_digit(value & 15)
        index = index + 1
    }
    str_from_bytes(output, 64)
}

fn lane_health_parity_bit(mask: i64, divisor: i64) -> i64 with Div {
    (mask / divisor) % 2
}

fn main() -> i64 with IO, Mut, Panic, Div {
    let flags_domain: i64 = 2097152
    let total_domain: i64 = 8388608
    var digest_state = sha256_init()
    var chunk: [u8; 256] = [0; 256]
    var chunk_len: i32 = 0
    var counts: [i64; 10] = [0; 10]
    var policy: i64 = 0
    while policy < 4 {
        var mask: i64 = 0
        while mask < flags_domain {
            var decision: i64 = 9
            if policy == 1 {
                decision = loom_lane_health_decide(
                    policy,
                    lane_health_parity_bit(mask, 1),
                    lane_health_parity_bit(mask, 2),
                    lane_health_parity_bit(mask, 4),
                    lane_health_parity_bit(mask, 8),
                    lane_health_parity_bit(mask, 16),
                    lane_health_parity_bit(mask, 32),
                    lane_health_parity_bit(mask, 64),
                    lane_health_parity_bit(mask, 128),
                    lane_health_parity_bit(mask, 256),
                    lane_health_parity_bit(mask, 512),
                    lane_health_parity_bit(mask, 1024),
                    lane_health_parity_bit(mask, 2048),
                    lane_health_parity_bit(mask, 4096),
                    lane_health_parity_bit(mask, 8192),
                    lane_health_parity_bit(mask, 16384),
                    lane_health_parity_bit(mask, 32768),
                    lane_health_parity_bit(mask, 65536),
                    lane_health_parity_bit(mask, 131072),
                    lane_health_parity_bit(mask, 262144),
                    lane_health_parity_bit(mask, 524288),
                    lane_health_parity_bit(mask, 1048576),
                )
            }
            counts[decision as usize] = counts[decision as usize] + 1
            chunk[chunk_len] = decision as u8
            chunk_len = chunk_len + 1
            if chunk_len == 256 {
                digest_state = sha256_update(digest_state, chunk, chunk_len)
                chunk_len = 0
            }
            mask = mask + 1
        }
        policy = policy + 1
    }
    if chunk_len > 0 {
        digest_state = sha256_update(digest_state, chunk, chunk_len)
    }
    let digest = sha256_finalize(digest_state)
    println(
        "SOUNIO_LANE_HEALTH_PARITY domain=" + lane_health_parity_i64_to_string(total_domain) +
        " digest_sha256=" + lane_health_parity_digest_hex(digest) +
        " counts=working:" + lane_health_parity_i64_to_string(counts[1]) +
        ",idle:" + lane_health_parity_i64_to_string(counts[2]) +
        ",blocked:" + lane_health_parity_i64_to_string(counts[3]) +
        ",disconnected:" + lane_health_parity_i64_to_string(counts[4]) +
        ",unresponsive:" + lane_health_parity_i64_to_string(counts[5]) +
        ",orphaned:" + lane_health_parity_i64_to_string(counts[6]) +
        ",dead:" + lane_health_parity_i64_to_string(counts[7]) +
        ",conflicted:" + lane_health_parity_i64_to_string(counts[8]) +
        ",unknown:" + lane_health_parity_i64_to_string(counts[9]) +
        " parent_semantics_sha256=5eb48f9cb214f6018569fb24e1e419b3e800dccde2e6e8d775246f4c05e4c93f"
    )
    0
}
