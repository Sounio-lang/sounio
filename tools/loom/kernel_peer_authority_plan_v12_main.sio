    println("RECEIVER_PROPERTY index=7 name=BACKEND_TOOLCHAIN_COMMAND_HARDWARE_RECEIPTED required=true")

    println("PRINCIPAL_VERTEX name=TREATMENT kuid_relation=SAME receiver_mediator=ACTIVE caller_surface=OPEN expected=ALL_REFUSED proof_role=DECISIVE")
