//! Sounio semantic authority for the V12 receiver-side kernel peer matrix.

fn kernel_peer_v12_emit_operation(
    index: string,
    family: string,
    syscall: string,
    completion_witness: string,
) with IO {
    println("OPERATION index=" + index + " family=" + family +
        " syscall=" + syscall + " completion_witness=" +
        completion_witness + " caller_surface=REQUIRED_OPEN")
}

fn kernel_peer_v12_emit_vertex(
    vertex: string,
    index: string,
    expected: string,
    rule: string,
    target_witness: string,
    proof_role: string,
) with IO {
    println("VERTEX vertex=" + vertex + " operation=" + index +
        " expected=" + expected + " rule=" + rule +
        " target_witness=" + target_witness + " proof_role=" + proof_role +
        " invariant_sha256=REQUIRED delta_sha256=REQUIRED attempt_sha256=REQUIRED target_sha256=REQUIRED extinction_sha256=REQUIRED")
}

fn kernel_peer_v12_emit_treatment(index: string) with IO {
    kernel_peer_v12_emit_vertex(
        "TREATMENT", index, "REFUSED_BEFORE_EFFECT",
        "RECEIVER_KERNEL_MEDIATOR", "TARGET_STATE_UNCHANGED", "DECISIVE",
    )
}

fn kernel_peer_v12_emit_open(
    index: string,
    witness: string,
) with IO {
    kernel_peer_v12_emit_vertex(
        "MEDIATOR_REMOVED", index, "EFFECT_COMPLETED", "NONE", witness,
        "DECISIVE",
    )
}

fn kernel_peer_v12_emit_distinct(index: string) with IO {
    kernel_peer_v12_emit_vertex(
        "DISTINCT_KUID_CONTROL", index, "REFUSED_BEFORE_EFFECT",
        "KERNEL_CREDENTIAL_CHECK", "TARGET_STATE_UNCHANGED", "CONTROL_ONLY",
    )
}

fn kernel_peer_v12_emit_caller_seccomp(index: string) with IO {
    kernel_peer_v12_emit_vertex(
        "CALLER_SECCOMP_CONTROL", index, "EXPERIMENT_UNAVAILABLE",
        "CALLER_ATTACK_SYSCALL_FILTERED", "NO_TARGET_ATTEMPT", "INVALID_PROOF",
    )
}

fn kernel_peer_v12_emit_dumpable(
    index: string,
    expected: string,
    witness: string,
) with IO {
    kernel_peer_v12_emit_vertex(
        "DUMPABLE_ONLY_CONTROL", index, expected, "DUMPABLE_ONLY", witness,
        "CONTROL_ONLY",
    )
}

fn kernel_peer_v12_emit_operation_cube(
    index: string,
    completion_witness: string,
    dumpable_expected: string,
    dumpable_witness: string,
) with IO {
    kernel_peer_v12_emit_treatment(index)
    kernel_peer_v12_emit_open(index, completion_witness)
    kernel_peer_v12_emit_distinct(index)
    kernel_peer_v12_emit_caller_seccomp(index)
    kernel_peer_v12_emit_dumpable(index, dumpable_expected, dumpable_witness)
}

fn main() -> i64 with IO, Mut, Div, Panic {
    println("LOOM_KERNEL_PEER_AUTHORITY_PLAN_V12 producer=Sounio role=SEMANTIC_POLICY_PLAN semantic_authority=Sounio action=9025 schema=12 principal_vertices=5 operations=10 observations=50 decisive_pairs=10 receiver_properties=7 action_cases=3")
    println("PARENTS garden_commit=3828ecca8655d97c17c40ae53525614f83293ba5 garden_sha256=f426b8b1c0b6dd0233345225ff56bce2c65fb95d8e227076fdb5611c9808bec2 v11_judgment_manifest_sha256=f227cca70aa30351517403e13f60143c683bb86d445320661d68c08317c81b89 v11_judgment_evidence_sha256=4aa5704fe529ee93c88992a630976395b49a28ed13189af9d7a07aeb7ecc4c64 action_9025_manifest_sha256=c1f0cf93f8427acdf794246a11c3551e265a09be12a3cd000bad25b707e8ca91")
    println("PEER_TRUTH same_kuid_required=true real_uid_equal=true effective_uid_equal=true saved_uid_equal=true filesystem_uid_equal=true attacker_syscalls_open=true receiver_side_required=true distinct_kuid_is_not_same_uid_proof=true caller_seccomp_is_not_receiver_proof=true pid_secrecy_is_not_isolation=true")
    println("PRINCIPAL_EPOCH fields=host_boot_id+generation+target_pidfd_identity+target_start_tick+target_kernel_uid+attacker_pidfd_identity+attacker_start_tick+attacker_kernel_uid+target_cgroup_identity+attacker_cgroup_identity+target_executable_sha256+attacker_executable_sha256+mediator_backend+mediator_policy_sha256")
    println("HASH_BINDING fields=invariant_sha256+delta_sha256+attempt_sha256+target_sha256+extinction_sha256 causal_pair=TREATMENT+MEDIATOR_REMOVED only_delta=mediator_presence+policy_hash")
    println("OBSERVATION_TYPES values=REFUSED_BEFORE_EFFECT+CROSSED_NAMED_RULE+EFFECT_COMPLETED+EXPERIMENT_UNAVAILABLE crossed_counts_as_coverage=false unavailable_counts_as_isolation=false syscall_error_alone_is_refusal=false syscall_success_alone_is_completion=false")

    println("RECEIVER_PROPERTY index=1 name=CALLER_AND_TARGET_KERNEL_IDENTITIES_VISIBLE required=true")
    println("RECEIVER_PROPERTY index=2 name=POLICY_IMMUTABLE_FOR_EPOCH required=true")
    println("RECEIVER_PROPERTY index=3 name=UNPRIVILEGED_PEER_CANNOT_DETACH_REPLACE_RELABEL required=true")
    println("RECEIVER_PROPERTY index=4 name=REFUSAL_BEFORE_TARGET_EFFECT required=true")
    println("RECEIVER_PROPERTY index=5 name=GUARDIAN_OR_POLICY_LOSS_FAILS_CLOSED required=true")
