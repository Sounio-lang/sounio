    kernel_peer_v12_emit_operation_cube("7", "PROC_MEM_CANARY_READ", "REFUSED_BEFORE_EFFECT", "TARGET_STATE_UNCHANGED")
    kernel_peer_v12_emit_operation_cube("8", "TARGET_FD_DUPLICATED", "REFUSED_BEFORE_EFFECT", "TARGET_STATE_UNCHANGED")
    kernel_peer_v12_emit_operation_cube("9", "LIMIT_CHANGED_RESTORED", "REFUSED_BEFORE_EFFECT", "TARGET_STATE_UNCHANGED")
