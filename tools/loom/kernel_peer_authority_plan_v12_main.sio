    kernel_peer_v12_emit_operation("5", "TRACING", "ptrace_ATTACH", "PTRACE_ATTACH_DETACH")
    kernel_peer_v12_emit_operation("6", "CROSS_PROCESS_MEMORY", "process_vm_readv", "CANARY_BYTES_READ")
