    println("BOUNDARY garden_v12=true sounio_executable_v12=false semantics_frozen_v12=false backend_discovery=false material_peer_matrix=false same_uid_peer_isolation=false action_9025_decision=DENY451 material_coverage=false complete_effects=false material_execution=false production_activation=false launch_open=false recycle_open=false exec_attached=false commit_attached=false ci_attached=false parity_open=false claim_ready=false")
