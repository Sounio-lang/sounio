    println("PRINCIPAL_VERTEX name=DISTINCT_KUID_CONTROL kuid_relation=DISTINCT receiver_mediator=ABSENT caller_surface=OPEN expected=CREDENTIAL_REFUSAL proof_role=CONTROL_ONLY")
    println("PRINCIPAL_VERTEX name=CALLER_SECCOMP_CONTROL kuid_relation=SAME receiver_mediator=ABSENT caller_surface=FILTERED expected=UNAVAILABLE proof_role=INVALID_PROOF")
    println("PRINCIPAL_VERTEX name=DUMPABLE_ONLY_CONTROL kuid_relation=SAME receiver_mediator=ABSENT caller_surface=OPEN expected=PARTIAL_ONLY proof_role=CONTROL_ONLY")

    kernel_peer_v12_emit_operation("1", "ASYNCHRONOUS_TERMINATION", "kill_SIGTERM", "TARGET_TERMINATED")
    kernel_peer_v12_emit_operation("2", "THREAD_DIRECTED_TERMINATION", "tgkill_SIGTERM", "TARGET_THREAD_TERMINATED")
    kernel_peer_v12_emit_operation("3", "QUEUED_SIGNAL", "rt_sigqueueinfo", "SIGNAL_PAYLOAD_OBSERVED")
