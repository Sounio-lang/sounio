//! Native Sounio adapter for Loom Witness Epoch Handoff frame 9015.

fn epoch_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 32768 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn epoch_digest_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) with Mut, Div, Panic {
    let (ok0, limb0, p0) = epoch_decimal_field(raw, start)
    let (ok1, limb1, p1) = epoch_decimal_field(raw, p0)
    let (ok2, limb2, p2) = epoch_decimal_field(raw, p1)
    let (ok3, limb3, p3) = epoch_decimal_field(raw, p2)
    let (ok4, limb4, p4) = epoch_decimal_field(raw, p3)
    let (ok5, limb5, p5) = epoch_decimal_field(raw, p4)
    let (ok6, limb6, p6) = epoch_decimal_field(raw, p5)
    let (ok7, limb7, p7) = epoch_decimal_field(raw, p6)
    let valid = ok0 == 1 && ok1 == 1 && ok2 == 1 && ok3 == 1 &&
        ok4 == 1 && ok5 == 1 && ok6 == 1 && ok7 == 1 &&
        limb0 <= 4294967295 && limb1 <= 4294967295 &&
        limb2 <= 4294967295 && limb3 <= 4294967295 &&
        limb4 <= 4294967295 && limb5 <= 4294967295 &&
        limb6 <= 4294967295 && limb7 <= 4294967295
    (if valid { 1 } else { 0 }, limb0, limb1, limb2, limb3,
        limb4, limb5, limb6, limb7, p7)
}

fn main() -> i64 with IO, Mut, Div, LoomWitnessEpochHandoffHostTrust, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = epoch_decimal_field(raw, 0)
    let (ok_old_verified, old_verified, p1) = epoch_decimal_field(raw, p0)
    let (ok_new_verified, new_verified, p2) = epoch_decimal_field(raw, p1)
    let (ok_from, from_epoch, p3) = epoch_decimal_field(raw, p2)
    let (ok_to, to_epoch, p4) = epoch_decimal_field(raw, p3)
    let (ok_old_q, old_q, p5) = epoch_decimal_field(raw, p4)
    let (ok_new_q, new_q, p6) = epoch_decimal_field(raw, p5)
    let (ok_old_n, old_n, p7) = epoch_decimal_field(raw, p6)
    let (ok_new_n, new_n, p8) = epoch_decimal_field(raw, p7)
    let (ok_old_domain, old_domain, p9) = epoch_decimal_field(raw, p8)
    let (ok_new_domain, new_domain, p10) = epoch_decimal_field(raw, p9)
    let (ok_old_seq, old_seq, p11) = epoch_decimal_field(raw, p10)
    let (ok_new_seq, new_seq, p12) = epoch_decimal_field(raw, p11)
    let (ok_old_count, old_count, p13) = epoch_decimal_field(raw, p12)
    let (ok_new_count, new_count, p14) = epoch_decimal_field(raw, p13)
    let (ok_old_membership, a0, a1, a2, a3, a4, a5, a6, a7, p15) =
        epoch_digest_field(raw, p14)
    let (ok_new_membership, b0, b1, b2, b3, b4, b5, b6, b7, p16) =
        epoch_digest_field(raw, p15)
    let (ok_old_root, c0, c1, c2, c3, c4, c5, c6, c7, p17) =
        epoch_digest_field(raw, p16)
    let (ok_new_root, d0, d1, d2, d3, d4, d5, d6, d7, p18) =
        epoch_digest_field(raw, p17)
    let (ok_old_head, e0, e1, e2, e3, e4, e5, e6, e7, p19) =
        epoch_digest_field(raw, p18)
    let (ok_new_head, f0, f1, f2, f3, f4, f5, f6, f7, p20) =
        epoch_digest_field(raw, p19)
    let (ok_old_certificate, g0, g1, g2, g3, g4, g5, g6, g7, p21) =
        epoch_digest_field(raw, p20)
    let (ok_new_certificate, h0, h1, h2, h3, h4, h5, h6, h7, p22) =
        epoch_digest_field(raw, p21)
    let (ok_previous, i0, i1, i2, i3, i4, i5, i6, i7, end_offset) =
        epoch_digest_field(raw, p22)
    let parsed = ok_schema == 1 && ok_old_verified == 1 &&
        ok_new_verified == 1 && ok_from == 1 && ok_to == 1 &&
        ok_old_q == 1 && ok_new_q == 1 && ok_old_n == 1 && ok_new_n == 1 &&
        ok_old_domain == 1 && ok_new_domain == 1 && ok_old_seq == 1 &&
        ok_new_seq == 1 && ok_old_count == 1 && ok_new_count == 1 &&
        ok_old_membership == 1 && ok_new_membership == 1 &&
        ok_old_root == 1 && ok_new_root == 1 && ok_old_head == 1 &&
        ok_new_head == 1 && ok_old_certificate == 1 &&
        ok_new_certificate == 1 && ok_previous == 1 &&
        str_char_at(raw, end_offset) <= 0
    if !parsed || schema != 9015 {
        println("SOUNIO_WITNESS_EPOCH_HANDOFF_REFUSE reason=malformed-frame")
        return 64
    }
    let old_membership = admit_witness_epoch_digest256(a0, a1, a2, a3, a4, a5, a6, a7)
    let new_membership = admit_witness_epoch_digest256(b0, b1, b2, b3, b4, b5, b6, b7)
    let old_root = admit_witness_epoch_digest256(c0, c1, c2, c3, c4, c5, c6, c7)
    let new_root = admit_witness_epoch_digest256(d0, d1, d2, d3, d4, d5, d6, d7)
    let old_head = admit_witness_epoch_digest256(e0, e1, e2, e3, e4, e5, e6, e7)
    let new_head = admit_witness_epoch_digest256(f0, f1, f2, f3, f4, f5, f6, f7)
    let old_certificate = admit_witness_epoch_digest256(g0, g1, g2, g3, g4, g5, g6, g7)
    let new_certificate = admit_witness_epoch_digest256(h0, h1, h2, h3, h4, h5, h6, h7)
    let previous = admit_witness_epoch_digest256(i0, i1, i2, i3, i4, i5, i6, i7)
    if host_witness_epoch_handoff_frame_accepts(
        old_verified, new_verified, from_epoch, to_epoch,
        old_q, new_q, old_n, new_n,
        old_domain, new_domain, old_seq, new_seq,
        old_count, new_count,
        old_membership, new_membership, old_root, new_root,
        old_head, new_head, old_certificate, new_certificate, previous,
    ) {
        println("SOUNIO_WITNESS_EPOCH_HANDOFF_ACCEPT schema=loom-native-witness-epoch-handoff-v0 transition=joint-quorum state=prepared")
        return 0
    }
    println("SOUNIO_WITNESS_EPOCH_HANDOFF_REFUSE reason=handoff-policy")
    42
}
