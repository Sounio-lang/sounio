//! Resident dispatcher for frozen Loom actions 9023 and 9024.
//!
//! The build renames both frozen single-shot entrypoints mechanically. A route
//! line selects the adapter, which then reads its own frame without copying it.

var LOOM_RESIDENT_LINE_BUFFER: [i8; 65536] = [0; 65536]

fn resident_membrane_read_line() -> string with IO, Mut {
    var length: i64 = 0
    var byte = read_byte()
    if byte < 0 {
        LOOM_RESIDENT_LINE_BUFFER[0] = 48
        LOOM_RESIDENT_LINE_BUFFER[1] = 0
        return str_from_bytes(LOOM_RESIDENT_LINE_BUFFER, 1)
    }
    while byte >= 0 && byte != 10 && length < 65535 {
        LOOM_RESIDENT_LINE_BUFFER[length as usize] = byte as i8
        length = length + 1
        byte = read_byte()
    }
    if length >= 65535 && byte != 10 {
        while byte >= 0 && byte != 10 {
            byte = read_byte()
        }
        LOOM_RESIDENT_LINE_BUFFER[0] = 120
        LOOM_RESIDENT_LINE_BUFFER[1] = 0
        return str_from_bytes(LOOM_RESIDENT_LINE_BUFFER, 1)
    }
    LOOM_RESIDENT_LINE_BUFFER[length as usize] = 0
    str_from_bytes(LOOM_RESIDENT_LINE_BUFFER, length)
}

fn resident_membrane_malformed() with IO {
    println("SOUNIO_RESIDENT_PROCESS_DENY code=424 reason=malformed-frame stage=INVALID")
}

fn main() -> i64 with IO, Mut, Div, Panic {
    while true {
        let route = resident_membrane_read_line()
        let route_code = str_char_at(route, 0)
        if route_code == 48 {
            return 0
        } else if route_code == 49 {
            let ignored_decision = resident_authority_decide_one()
        } else if route_code == 50 {
            let ignored_decision = subprocess_membrane_decide_one()
        } else {
            resident_membrane_malformed()
        }
    }
    0
}
