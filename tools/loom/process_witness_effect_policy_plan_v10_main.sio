    println("SYSCALL nr=1 name=write seccomp_args=fd1_or_fd2 object=bounded_receipt_streams effect_family=4")
    println("SYSCALL nr=60 name=exit seccomp_args=any_status object=terminal_wait_status effect_family=2")
    println("SYSCALL nr=322 name=execveat seccomp_args=fd3_and_AT_EMPTY_PATH cell_args=empty_path+frozen_argv+empty_env fd_cloexec=true object=preopened_hashed_Sounio_payload effect_family=1")
    println("SECCOMP architecture=AUDIT_ARCH_X86_64 architecture_mismatch=KILL_PROCESS default_action=ERRNO_EP1 allowlist_kind=positive argument_constraints=required blacklist_fallback=false")

    effect_plan_v10_emit_family("1", "executable_transition", "3",
        "fd3_cloexec_plus_constrained_execveat", "fd3_retained_at_READY", "DENY447")
    effect_plan_v10_emit_family("2", "process_topology", "2",
        "seccomp_no_clone3_plus_pidfd_cgroup", "clone3", "DENY447")
    effect_plan_v10_emit_family("3", "filesystem_path", "2",
