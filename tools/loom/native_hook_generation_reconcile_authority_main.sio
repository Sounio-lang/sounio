//! Packed executable adapter for LOOM action 9047.

fn reconcile_decimal_field(raw: string, start: i64) -> (i64, i64, i64) with Mut, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn reconcile_decision(decision: i64) -> string {
    if decision == 1 { return "KEEP" }
    if decision == 2 { return "QUARANTINE_ELIGIBLE" }
    if decision == 3 { return "QUARANTINE_READY" }
    if decision == 682 { return "DENY682" }
    if decision == 683 { return "DENY683" }
    if decision == 684 { return "DENY684" }
    if decision == 685 { return "DENY685" }
    if decision == 686 { return "DENY686" }
    if decision == 687 { return "DENY687" }
    if decision == 688 { return "DENY688" }
    if decision == 689 { return "DENY689" }
    if decision == 690 { return "DENY690" }
    "DENY424"
}

fn main() -> i64 with IO, Mut, Panic {
    let raw = read_line()
    let (o0, schema, p0) = reconcile_decimal_field(raw, 0)
    if o0 == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed = loom_native_hook_generation_reconcile_selftest()
        if failed == 0 {
            println("SOUNIO_NATIVE_HOOK_GENERATION_RECONCILE_SELFTEST PASS cases=13")
            return 0
        }
        println("SOUNIO_NATIVE_HOOK_GENERATION_RECONCILE_SELFTEST FAIL")
        return 70
    }
    let (o1, mode, p1) = reconcile_decimal_field(raw, p0)
    let (o2, stage, p2) = reconcile_decimal_field(raw, p1)
    let (o3, word, p3) = reconcile_decimal_field(raw, p2)
    let (o4, related_total, p4) = reconcile_decimal_field(raw, p3)
    let (o5, related_bound, p5) = reconcile_decimal_field(raw, p4)
    let (o6, absence_reason, p6) = reconcile_decimal_field(raw, p5)
    let (o7, record_hash0, p7) = reconcile_decimal_field(raw, p6)
    let (o8, record_hash1, p8) = reconcile_decimal_field(raw, p7)
    let (o9, kernel_hash, p9) = reconcile_decimal_field(raw, p8)
    let (o10, transaction_hash, p10) = reconcile_decimal_field(raw, p9)
    let (o11, sabotage_count, p11) = reconcile_decimal_field(raw, p10)
    let (o12, sabotage_required, p12) = reconcile_decimal_field(raw, p11)
    if o0 != 1 || schema != 9047 || o1 != 1 || o2 != 1 || o3 != 1 ||
        o4 != 1 || o5 != 1 || o6 != 1 || o7 != 1 || o8 != 1 ||
        o9 != 1 || o10 != 1 || o11 != 1 || o12 != 1 ||
        mode < 1 || mode > 2 || stage < 0 || word < 0 ||
        related_total < 0 || related_bound < 0 || absence_reason < 0 ||
        sabotage_count < 0 || sabotage_required < 0 ||
        str_char_at(raw, p12) > 0 {
        println("SOUNIO_NATIVE_HOOK_GENERATION_RECONCILE DENY424 reason=malformed-frame semantic_authority=Sounio action=9047")
        return 42
    }
    let decision = judge_loom_native_hook_generation_reconcile_words(
        mode, stage, word, related_total, related_bound, absence_reason,
        record_hash0, record_hash1, kernel_hash, transaction_hash,
        sabotage_count, sabotage_required,
    )
    println("SOUNIO_NATIVE_HOOK_GENERATION_RECONCILE " +
        reconcile_decision(decision) +
        " semantic_authority=Sounio action=9047")
    if decision == 1 || decision == 2 || decision == 3 { return 0 }
    42
}
