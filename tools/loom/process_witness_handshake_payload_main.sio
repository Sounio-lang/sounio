//! Sounio-produced two-phase payload for same-pid ProcessWitness observation.
//!
//! READY creates a bounded observation window after execveat. CLOSE is a
//! descriptor-custodied lifecycle signal, not semantic authority.

fn process_witness_close_frame_ok() -> i64 with IO {
    let c0 = read_byte()
    let c1 = read_byte()
    let c2 = read_byte()
    let c3 = read_byte()
    let c4 = read_byte()
    let c5 = read_byte()
    let c6 = read_byte()
    if c0 == 67 && c1 == 76 && c2 == 79 && c3 == 83 && c4 == 69 &&
       c5 == 10 && c6 < 0 {
        return 1
    }
    0
}

fn main() -> i64 with IO, Mut, Div, Panic {
    println("LOOM_PROCESS_WITNESS_HANDSHAKE_V1 producer=Sounio role=SEMANTIC_PAYLOAD action=9030 phase=READY")
    if process_witness_close_frame_ok() == 1 {
        println("LOOM_PROCESS_WITNESS_HANDSHAKE_V1 producer=Sounio role=SEMANTIC_PAYLOAD action=9030 phase=DONE outcome=CALIBRATION_OK")
        return 0
    }
    println("LOOM_PROCESS_WITNESS_HANDSHAKE_V1 producer=Sounio role=SEMANTIC_PAYLOAD action=9030 phase=CLOSE reason=frame-mismatch")
    70
}
