//! Executable adapter for LOOM effect-closure authority frame 9025.

fn effect_closure_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn effect_closure_digest_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) with Mut, Div, Panic {
    let (ok0, limb0, p0) = effect_closure_decimal_field(raw, start)
    let (ok1, limb1, p1) = effect_closure_decimal_field(raw, p0)
    let (ok2, limb2, p2) = effect_closure_decimal_field(raw, p1)
    let (ok3, limb3, p3) = effect_closure_decimal_field(raw, p2)
    let (ok4, limb4, p4) = effect_closure_decimal_field(raw, p3)
    let (ok5, limb5, p5) = effect_closure_decimal_field(raw, p4)
    let (ok6, limb6, p6) = effect_closure_decimal_field(raw, p5)
    let (ok7, limb7, p7) = effect_closure_decimal_field(raw, p6)
    let valid = ok0 == 1 && ok1 == 1 && ok2 == 1 && ok3 == 1 &&
        ok4 == 1 && ok5 == 1 && ok6 == 1 && ok7 == 1 &&
        limb0 <= 4294967295 && limb1 <= 4294967295 &&
        limb2 <= 4294967295 && limb3 <= 4294967295 &&
        limb4 <= 4294967295 && limb5 <= 4294967295 &&
        limb6 <= 4294967295 && limb7 <= 4294967295
    (if valid { 1 } else { 0 }, limb0, limb1, limb2, limb3,
        limb4, limb5, limb6, limb7, p7)
}

fn effect_closure_reason(decision: i64) -> string {
    if decision == 0 { return "allow" }
    if decision == 405 { return "wrong-stage" }
    if decision == 446 { return "parent-chain-invalid" }
    if decision == 447 { return "material-coverage-incomplete" }
    if decision == 448 { return "sabotage-incomplete" }
    if decision == 449 { return "revocation-or-race-unsafe" }
    if decision == 450 { return "provenance-incomplete" }
    if decision == 451 { return "same-uid-peer-isolation-absent" }
    if decision == 452 { return "unknown-effect-not-kernel-denied" }
    if decision == 453 { return "architecture-unsupported" }
    "malformed-frame"
}

fn effect_closure_code(decision: i64) -> string {
    if decision == 0 { return "0" }
    if decision == 405 { return "405" }
    if decision == 446 { return "446" }
    if decision == 447 { return "447" }
    if decision == 448 { return "448" }
    if decision == 449 { return "449" }
    if decision == 450 { return "450" }
    if decision == 451 { return "451" }
    if decision == 452 { return "452" }
    if decision == 453 { return "453" }
    "424"
}

fn effect_closure_case(case_index: i64) -> string {
    if case_index == 1 { return "1" }
    if case_index == 2 { return "2" }
    if case_index == 3 { return "3" }
    if case_index == 4 { return "4" }
    if case_index == 5 { return "5" }
    if case_index == 6 { return "6" }
    if case_index == 7 { return "7" }
    if case_index == 8 { return "8" }
    if case_index == 9 { return "9" }
    if case_index == 10 { return "10" }
    if case_index == 11 { return "11" }
    if case_index == 12 { return "12" }
    if case_index == 13 { return "13" }
    if case_index == 14 { return "14" }
    if case_index == 15 { return "15" }
    if case_index == 16 { return "16" }
    if case_index == 17 { return "17" }
    if case_index == 18 { return "18" }
    if case_index == 19 { return "19" }
    "unknown"
}

fn effect_closure_stage_name(stage: i64) -> string {
    if stage == 1 { return "GARDEN" }
    if stage == 2 { return "SOUNIO_EXECUTABLE" }
    if stage == 3 { return "SEMANTICS_FROZEN" }
    if stage == 4 { return "PARITY_OPEN" }
    if stage == 5 { return "MATERIAL_COVERAGE" }
    if stage == 6 { return "ATTACHMENT_OPEN" }
    if stage == 7 { return "CLAIM_READY" }
    "INVALID"
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = effect_closure_decimal_field(raw, 0)
    if ok_schema == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed_case = loom_effect_closure_authority_selftest()
        if failed_case == 0 {
            println("SOUNIO_EFFECT_CLOSURE_SELFTEST PASS cases=19")
            return 0
        }
        println("SOUNIO_EFFECT_CLOSURE_SELFTEST FAIL case=" +
            effect_closure_case(failed_case))
        return 70
    }

    let (ok_stage, stage, p1) = effect_closure_decimal_field(raw, p0)
    let (ok_parent_9023, parent_9023_frozen, p2) = effect_closure_decimal_field(raw, p1)
    let (ok_parent_9024, parent_9024_frozen, p3) = effect_closure_decimal_field(raw, p2)
    let (ok_resident, resident_runtime_bound, p4) = effect_closure_decimal_field(raw, p3)
    let (ok_architecture, architecture_supported, p5) = effect_closure_decimal_field(raw, p4)
    let (ok_fail_closed, fail_closed, p6) = effect_closure_decimal_field(raw, p5)
    let (ok_revokes, supervisor_loss_revokes, p7) = effect_closure_decimal_field(raw, p6)
    let (ok_same_uid, same_uid_peer_isolation, p8) = effect_closure_decimal_field(raw, p7)
    let (ok_path_race, path_race_closed, p9) = effect_closure_decimal_field(raw, p8)
    let (ok_coverage_count, coverage_family_count, p10) = effect_closure_decimal_field(raw, p9)
    let (ok_sabotage_count, sabotage_family_count, p11) = effect_closure_decimal_field(raw, p10)
    let (ok_receipt, receipt_bound, p12) = effect_closure_decimal_field(raw, p11)

    let (ok_executable, executable_mode, p13) = effect_closure_decimal_field(raw, p12)
    let (ok_process, process_mode, p14) = effect_closure_decimal_field(raw, p13)
    let (ok_path, path_mode, p15) = effect_closure_decimal_field(raw, p14)
    let (ok_descriptor, descriptor_mode, p16) = effect_closure_decimal_field(raw, p15)
    let (ok_mapped, mapped_storage_mode, p17) = effect_closure_decimal_field(raw, p16)
    let (ok_async, async_io_mode, p18) = effect_closure_decimal_field(raw, p17)
    let (ok_network, network_mode, p19) = effect_closure_decimal_field(raw, p18)
    let (ok_unix_socket, unix_socket_mode, p20) = effect_closure_decimal_field(raw, p19)
    let (ok_ipc, ipc_mode, p21) = effect_closure_decimal_field(raw, p20)
    let (ok_device, device_mode, p22) = effect_closure_decimal_field(raw, p21)
    let (ok_procfs, procfs_mode, p23) = effect_closure_decimal_field(raw, p22)
    let (ok_unknown, unknown_mode, p24) = effect_closure_decimal_field(raw, p23)

    let (ok_parent_9023_hash, a0, a1, a2, a3, a4, a5, a6, a7, p25) =
        effect_closure_digest_field(raw, p24)
    let (ok_parent_9024_hash, b0, b1, b2, b3, b4, b5, b6, b7, p26) =
        effect_closure_digest_field(raw, p25)
    let (ok_resident_hash, r0, r1, r2, r3, r4, r5, r6, r7, p27) =
        effect_closure_digest_field(raw, p26)
    let (ok_source_hash, s0, s1, s2, s3, s4, s5, s6, s7, p28) =
        effect_closure_digest_field(raw, p27)
    let (ok_semantics_hash, m0, m1, m2, m3, m4, m5, m6, m7, p29) =
        effect_closure_digest_field(raw, p28)
    let (ok_coverage_hash, c0, c1, c2, c3, c4, c5, c6, c7, p30) =
        effect_closure_digest_field(raw, p29)
    let (ok_sabotage_hash, x0, x1, x2, x3, x4, x5, x6, x7, p31) =
        effect_closure_digest_field(raw, p30)
    let (ok_toolchain_hash, t0, t1, t2, t3, t4, t5, t6, t7, p32) =
        effect_closure_digest_field(raw, p31)
    let (ok_hardware_hash, h0, h1, h2, h3, h4, h5, h6, h7, p33) =
        effect_closure_digest_field(raw, p32)
    let (ok_command_hash, q0, q1, q2, q3, q4, q5, q6, q7, p34) =
        effect_closure_digest_field(raw, p33)
    let (ok_result_hash, o0, o1, o2, o3, o4, o5, o6, o7, end_offset) =
        effect_closure_digest_field(raw, p34)

    let parsed = ok_schema == 1 && ok_stage == 1 && ok_parent_9023 == 1 &&
        ok_parent_9024 == 1 && ok_resident == 1 && ok_architecture == 1 &&
        ok_fail_closed == 1 && ok_revokes == 1 && ok_same_uid == 1 &&
        ok_path_race == 1 && ok_coverage_count == 1 &&
        ok_sabotage_count == 1 && ok_receipt == 1 && ok_executable == 1 &&
        ok_process == 1 && ok_path == 1 && ok_descriptor == 1 &&
        ok_mapped == 1 && ok_async == 1 && ok_network == 1 &&
        ok_unix_socket == 1 && ok_ipc == 1 && ok_device == 1 &&
        ok_procfs == 1 && ok_unknown == 1 && ok_parent_9023_hash == 1 &&
        ok_parent_9024_hash == 1 && ok_resident_hash == 1 &&
        ok_source_hash == 1 && ok_semantics_hash == 1 &&
        ok_coverage_hash == 1 && ok_sabotage_hash == 1 &&
        ok_toolchain_hash == 1 && ok_hardware_hash == 1 &&
        ok_command_hash == 1 && ok_result_hash == 1 &&
        str_char_at(raw, end_offset) <= 0
    if !parsed || schema != 9025 {
        println("SOUNIO_EFFECT_CLOSURE_DENY code=424 reason=malformed-frame stage=INVALID")
        return 424
    }

    let facts = admit_loom_effect_closure_facts(
        stage, parent_9023_frozen, parent_9024_frozen,
        resident_runtime_bound, architecture_supported, fail_closed,
        supervisor_loss_revokes, same_uid_peer_isolation, path_race_closed,
        coverage_family_count, sabotage_family_count, receipt_bound,
    )
    let coverage = admit_loom_effect_closure_coverage(
        executable_mode, process_mode, path_mode, descriptor_mode,
        mapped_storage_mode, async_io_mode, network_mode, unix_socket_mode,
        ipc_mode, device_mode, procfs_mode, unknown_mode,
    )
    let bindings = admit_loom_effect_closure_bindings(
        admit_loom_effect_closure_digest256(a0, a1, a2, a3, a4, a5, a6, a7),
        admit_loom_effect_closure_digest256(b0, b1, b2, b3, b4, b5, b6, b7),
        admit_loom_effect_closure_digest256(r0, r1, r2, r3, r4, r5, r6, r7),
        admit_loom_effect_closure_digest256(s0, s1, s2, s3, s4, s5, s6, s7),
        admit_loom_effect_closure_digest256(m0, m1, m2, m3, m4, m5, m6, m7),
        admit_loom_effect_closure_digest256(c0, c1, c2, c3, c4, c5, c6, c7),
        admit_loom_effect_closure_digest256(x0, x1, x2, x3, x4, x5, x6, x7),
        admit_loom_effect_closure_digest256(t0, t1, t2, t3, t4, t5, t6, t7),
        admit_loom_effect_closure_digest256(h0, h1, h2, h3, h4, h5, h6, h7),
        admit_loom_effect_closure_digest256(q0, q1, q2, q3, q4, q5, q6, q7),
        admit_loom_effect_closure_digest256(o0, o1, o2, o3, o4, o5, o6, o7),
    )
    let decision = loom_effect_closure_authority_decide(facts, coverage, bindings)
    if decision == 0 {
        println("SOUNIO_EFFECT_CLOSURE_ALLOW code=0 reason=allow stage=" +
            effect_closure_stage_name(stage))
        return 0
    }
    println("SOUNIO_EFFECT_CLOSURE_DENY code=" +
        effect_closure_code(decision) + " reason=" +
        effect_closure_reason(decision) + " stage=" +
        effect_closure_stage_name(stage))
    decision
}
