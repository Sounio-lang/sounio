//! Packed executable adapter for LOOM action 9046.

fn drain_decimal_field(raw: string, start: i64) -> (i64, i64, i64) with Mut, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn drain_decision(decision: i64) -> string {
    if decision == 1 { return "DRAINING" }
    if decision == 2 { return "CUTOVER_READY" }
    if decision == 671 { return "DENY671" }
    if decision == 672 { return "DENY672" }
    if decision == 673 { return "DENY673" }
    if decision == 674 { return "DENY674" }
    if decision == 675 { return "DENY675" }
    if decision == 676 { return "DENY676" }
    if decision == 677 { return "DENY677" }
    if decision == 678 { return "DENY678" }
    if decision == 679 { return "DENY679" }
    if decision == 680 { return "DENY680" }
    if decision == 681 { return "DENY681" }
    "DENY424"
}

fn main() -> i64 with IO, Mut, Panic {
    let raw = read_line()
    let (o0, schema, p0) = drain_decimal_field(raw, 0)
    if o0 == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed = loom_native_hook_generation_drain_selftest()
        if failed == 0 {
            println("SOUNIO_NATIVE_HOOK_GENERATION_DRAIN_SELFTEST PASS cases=12")
            return 0
        }
        println("SOUNIO_NATIVE_HOOK_GENERATION_DRAIN_SELFTEST FAIL")
        return 70
    }
    let (o1, mode, p1) = drain_decimal_field(raw, p0)
    let (o2, stage, p2) = drain_decimal_field(raw, p1)
    let (o3, word, p3) = drain_decimal_field(raw, p2)
    let (o4, total, p4) = drain_decimal_field(raw, p3)
    let (o5, classified, p5) = drain_decimal_field(raw, p4)
    let (o6, native, p6) = drain_decimal_field(raw, p5)
    let (o7, legacy, p7) = drain_decimal_field(raw, p6)
    let (o8, unknown, p8) = drain_decimal_field(raw, p7)
    let (o9, unresponsive, p9) = drain_decimal_field(raw, p8)
    let (o10, canary_mask, p10) = drain_decimal_field(raw, p9)
    let (o11, inventory_hash0, p11) = drain_decimal_field(raw, p10)
    let (o12, inventory_hash1, p12) = drain_decimal_field(raw, p11)
    let (o13, old_runtime_hash, p13) = drain_decimal_field(raw, p12)
    let (o14, candidate_runtime_hash, p14) = drain_decimal_field(raw, p13)
    let (o15, config_pair_hash, p15) = drain_decimal_field(raw, p14)
    let (o16, sabotage_count, p16) = drain_decimal_field(raw, p15)
    let (o17, sabotage_required, p17) = drain_decimal_field(raw, p16)
    if o0 != 1 || schema != 9046 || o1 != 1 || o2 != 1 || o3 != 1 ||
        o4 != 1 || o5 != 1 || o6 != 1 || o7 != 1 || o8 != 1 ||
        o9 != 1 || o10 != 1 || o11 != 1 || o12 != 1 || o13 != 1 ||
        o14 != 1 || o15 != 1 || o16 != 1 || o17 != 1 ||
        mode < 1 || mode > 2 || stage < 0 || word < 0 || total < 0 ||
        classified < 0 || native < 0 || legacy < 0 || unknown < 0 ||
        unresponsive < 0 || canary_mask < 0 || sabotage_count < 0 ||
        sabotage_required < 0 || str_char_at(raw, p17) > 0 {
        println("SOUNIO_NATIVE_HOOK_GENERATION_DRAIN DENY424 reason=malformed-frame semantic_authority=Sounio action=9046")
        return 42
    }
    let decision = judge_loom_native_hook_generation_drain_words(
        mode, stage, word, total, classified, native, legacy, unknown,
        unresponsive, canary_mask, inventory_hash0, inventory_hash1,
        old_runtime_hash, candidate_runtime_hash, config_pair_hash,
        sabotage_count, sabotage_required,
    )
    println("SOUNIO_NATIVE_HOOK_GENERATION_DRAIN " + drain_decision(decision) +
        " semantic_authority=Sounio action=9046")
    if decision == 1 || decision == 2 { return 0 }
    42
}
