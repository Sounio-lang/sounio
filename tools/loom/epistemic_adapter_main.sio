//! Native Sounio policy adapter for Loom epistemic-machine frame 9008.

fn epistemic_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 8192 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        value = value * 10 + (code - 48)
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn epistemic_digest_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) with Mut, Div, Panic {
    let (ok0, limb0, p0) = epistemic_decimal_field(raw, start)
    let (ok1, limb1, p1) = epistemic_decimal_field(raw, p0)
    let (ok2, limb2, p2) = epistemic_decimal_field(raw, p1)
    let (ok3, limb3, p3) = epistemic_decimal_field(raw, p2)
    let (ok4, limb4, p4) = epistemic_decimal_field(raw, p3)
    let (ok5, limb5, p5) = epistemic_decimal_field(raw, p4)
    let (ok6, limb6, p6) = epistemic_decimal_field(raw, p5)
    let (ok7, limb7, p7) = epistemic_decimal_field(raw, p6)
    let valid = ok0 == 1 && ok1 == 1 && ok2 == 1 && ok3 == 1 &&
        ok4 == 1 && ok5 == 1 && ok6 == 1 && ok7 == 1 &&
        limb0 <= 4294967295 && limb1 <= 4294967295 &&
        limb2 <= 4294967295 && limb3 <= 4294967295 &&
        limb4 <= 4294967295 && limb5 <= 4294967295 &&
        limb6 <= 4294967295 && limb7 <= 4294967295
    (if valid { 1 } else { 0 }, limb0, limb1, limb2, limb3,
        limb4, limb5, limb6, limb7, p7)
}

fn epistemic_transition_name(kind: i64) -> string {
    if kind == 1 { return "create" }
    if kind == 2 { return "observe" }
    if kind == 3 { return "claim" }
    if kind == 4 { return "challenge" }
    if kind == 5 { return "capability-acquire" }
    if kind == 6 { return "capability-release" }
    if kind == 7 { return "fork" }
    "unknown"
}

fn main() -> i64 with IO, Mut, Div, LoomEpistemicHostTrust, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = epistemic_decimal_field(raw, 0)
    let (ok_kind, kind, p1) = epistemic_decimal_field(raw, p0)
    let (ok_previous, previous, p2) = epistemic_decimal_field(raw, p1)
    let (ok_next, next, p3) = epistemic_decimal_field(raw, p2)
    let (ok_world, world, p4) = epistemic_decimal_field(raw, p3)
    let (ok_parent, parent, p5) = epistemic_decimal_field(raw, p4)
    let (ok_subject, subject, p6) = epistemic_decimal_field(raw, p5)
    let (ok_related, related, p7) = epistemic_decimal_field(raw, p6)
    let (ok_owner, owner, p8) = epistemic_decimal_field(raw, p7)
    let (ok_generation, generation, p9) = epistemic_decimal_field(raw, p8)
    let (ok_value, v0, v1, v2, v3, v4, v5, v6, v7, p10) =
        epistemic_digest_field(raw, p9)
    let (ok_error, e0, e1, e2, e3, e4, e5, e6, e7, p11) =
        epistemic_digest_field(raw, p10)
    let (ok_uncertainty, u0, u1, u2, u3, u4, u5, u6, u7, p12) =
        epistemic_digest_field(raw, p11)
    let (ok_confidence, c0, c1, c2, c3, c4, c5, c6, c7, p13) =
        epistemic_digest_field(raw, p12)
    let (ok_provenance, p_0, p_1, p_2, p_3, p_4, p_5, p_6, p_7, p14) =
        epistemic_digest_field(raw, p13)
    let (ok_evidence, d0, d1, d2, d3, d4, d5, d6, d7, p15) =
        epistemic_digest_field(raw, p14)
    let (ok_falsifier, f0, f1, f2, f3, f4, f5, f6, f7, end_offset) =
        epistemic_digest_field(raw, p15)
    let parsed = ok_schema == 1 && ok_kind == 1 && ok_previous == 1 &&
        ok_next == 1 && ok_world == 1 && ok_parent == 1 &&
        ok_subject == 1 && ok_related == 1 && ok_owner == 1 &&
        ok_generation == 1 && ok_value == 1 && ok_error == 1 &&
        ok_uncertainty == 1 && ok_confidence == 1 &&
        ok_provenance == 1 && ok_evidence == 1 && ok_falsifier == 1 &&
        str_char_at(raw, end_offset) <= 0
    if !parsed || schema != 9008 || world <= 0 {
        println("SOUNIO_EPISTEMIC_REFUSE reason=malformed-frame")
        return 64
    }
    let value = admit_epistemic_digest256(v0, v1, v2, v3, v4, v5, v6, v7)
    let error = admit_epistemic_digest256(e0, e1, e2, e3, e4, e5, e6, e7)
    let uncertainty = admit_epistemic_digest256(u0, u1, u2, u3, u4, u5, u6, u7)
    let confidence = admit_epistemic_digest256(c0, c1, c2, c3, c4, c5, c6, c7)
    let provenance = admit_epistemic_digest256(
        p_0, p_1, p_2, p_3, p_4, p_5, p_6, p_7,
    )
    let evidence = admit_epistemic_digest256(d0, d1, d2, d3, d4, d5, d6, d7)
    let falsifier = admit_epistemic_digest256(f0, f1, f2, f3, f4, f5, f6, f7)
    if host_epistemic_transition_accepts(
        kind, previous, next, world, parent, subject, related, owner,
        generation, value, error, uncertainty, confidence, provenance,
        evidence, falsifier,
    ) {
        println("SOUNIO_EPISTEMIC_ACCEPT schema=loom-native-epistemic-v0 transition=" +
            epistemic_transition_name(kind) + " state=" +
            (if next == 1 { "active" } else { "absent" }))
        return 0
    }
    println("SOUNIO_EPISTEMIC_REFUSE reason=transition-policy")
    42
}
