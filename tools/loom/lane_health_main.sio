//! Executable adapter for Loom truthful lane-health frame 9030.

fn lane_health_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn lane_health_state_name(decision: i64) -> string {
    if decision == 1 { return "WORKING" }
    if decision == 2 { return "IDLE" }
    if decision == 3 { return "BLOCKED" }
    if decision == 4 { return "DISCONNECTED" }
    if decision == 5 { return "UNRESPONSIVE" }
    if decision == 6 { return "ORPHANED" }
    if decision == 7 { return "DEAD" }
    if decision == 8 { return "CONFLICTED" }
    "UNKNOWN"
}

fn lane_health_state_code(decision: i64) -> string {
    if decision == 1 { return "1" }
    if decision == 2 { return "2" }
    if decision == 3 { return "3" }
    if decision == 4 { return "4" }
    if decision == 5 { return "5" }
    if decision == 6 { return "6" }
    if decision == 7 { return "7" }
    if decision == 8 { return "8" }
    "9"
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = lane_health_decimal_field(raw, 0)
    if ok_schema == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed_case = loom_lane_health_selftest()
        if failed_case == 0 {
            println("SOUNIO_LANE_HEALTH_SELFTEST PASS cases=28")
            return 0
        }
        println("SOUNIO_LANE_HEALTH_SELFTEST FAIL case=" +
            lane_health_state_code(failed_case))
        return 70
    }

    let (ok_policy, policy_state, p1) = lane_health_decimal_field(raw, p0)
    let (ok_expected, expected_lane, p2) = lane_health_decimal_field(raw, p1)
    let (ok_claim, claim_active, p3) = lane_health_decimal_field(raw, p2)
    let (ok_residue, record_residue, p4) = lane_health_decimal_field(raw, p3)
    let (ok_pane, pane_or_harness_exists, p5) = lane_health_decimal_field(raw, p4)
    let (ok_process, process_verified, p6) = lane_health_decimal_field(raw, p5)
    let (ok_unresponsive, process_unresponsive, p7) = lane_health_decimal_field(raw, p6)
    let (ok_process_absent, process_absent, p8) = lane_health_decimal_field(raw, p7)
    let (ok_endpoint, endpoint_verified, p9) = lane_health_decimal_field(raw, p8)
    let (ok_endpoint_absent, endpoint_absent, p10) = lane_health_decimal_field(raw, p9)
    let (ok_endpoint_stale, endpoint_stale, p11) = lane_health_decimal_field(raw, p10)
    let (ok_custody, custody_active, p12) = lane_health_decimal_field(raw, p11)
    let (ok_recoverable, custody_recoverable, p13) = lane_health_decimal_field(raw, p12)
    let (ok_obligation, obligation_active, p14) = lane_health_decimal_field(raw, p13)
    let (ok_blocker, blocker_active, p15) = lane_health_decimal_field(raw, p14)
    let (ok_census, obligation_census_complete, p16) = lane_health_decimal_field(raw, p15)
    let (ok_progress, progress_observed, p17) = lane_health_decimal_field(raw, p16)
    let (ok_progress_window, progress_window_complete, p18) = lane_health_decimal_field(raw, p17)
    let (ok_liveness_window, liveness_window_complete, p19) = lane_health_decimal_field(raw, p18)
    let (ok_ready, ready_observed, p20) = lane_health_decimal_field(raw, p19)
    let (ok_authority, observation_authority_verified, p21) = lane_health_decimal_field(raw, p20)
    let (ok_fresh, sample_fresh, end_offset) = lane_health_decimal_field(raw, p21)
    let parsed = ok_schema == 1 && ok_policy == 1 && ok_expected == 1 &&
        ok_claim == 1 && ok_residue == 1 && ok_pane == 1 &&
        ok_process == 1 && ok_unresponsive == 1 && ok_process_absent == 1 &&
        ok_endpoint == 1 && ok_endpoint_absent == 1 &&
        ok_endpoint_stale == 1 && ok_custody == 1 && ok_recoverable == 1 &&
        ok_obligation == 1 && ok_blocker == 1 &&
        ok_census == 1 && ok_progress == 1 && ok_progress_window == 1 &&
        ok_liveness_window == 1 && ok_ready == 1 && ok_authority == 1 &&
        ok_fresh == 1 && str_char_at(raw, end_offset) <= 0
    if !parsed || schema != 9030 {
        println("SOUNIO_LANE_HEALTH state=UNKNOWN code=9 authority=Sounio reason=malformed-frame")
        return 99
    }

    let decision = loom_lane_health_decide(
        policy_state,
        expected_lane,
        claim_active,
        record_residue,
        pane_or_harness_exists,
        process_verified,
        process_unresponsive,
        process_absent,
        endpoint_verified,
        endpoint_absent,
        endpoint_stale,
        custody_active,
        custody_recoverable,
        obligation_active,
        blocker_active,
        obligation_census_complete,
        progress_observed,
        progress_window_complete,
        liveness_window_complete,
        ready_observed,
        observation_authority_verified,
        sample_fresh,
    )
    println("SOUNIO_LANE_HEALTH state=" + lane_health_state_name(decision) +
        " code=" + lane_health_state_code(decision) + " authority=Sounio")
    0
}
