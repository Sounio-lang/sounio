//! Packed executable adapter for the exact V1 LOOM action-9034 fixture.

fn exec_intent_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn exec_intent_decision(decision: i64) -> string {
    if decision == 1 { return "PROJECT" }
    if decision == 405 { return "DENY405" }
    if decision == 550 { return "DENY550" }
    if decision == 551 { return "DENY551" }
    if decision == 552 { return "DENY552" }
    if decision == 553 { return "DENY553" }
    if decision == 554 { return "DENY554" }
    if decision == 555 { return "DENY555" }
    if decision == 556 { return "DENY556" }
    if decision == 557 { return "DENY557" }
    "DENY424"
}

fn exec_intent_fields() with IO {
    println("LOOM_EXEC_INTENT_ENVELOPE_FIELDS_V1")
    println("LOOM_EXEC_INTENT/1")
    println("113b0f7d2a1f7adc5b68a92ef37be3689accfe4bbb00cb4e8c15fc3ab7b70013")
    println("07ffb41877176a60b04949dd78c91313954dd759593f20677a1b2fcfeea31a60")
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = exec_intent_decimal_field(raw, 0)
    if ok_schema == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed = loom_exec_intent_envelope_selftest()
        if failed == 0 {
            println("SOUNIO_EXEC_INTENT_ENVELOPE_SELFTEST PASS cases=12")
            return 0
        }
        println("SOUNIO_EXEC_INTENT_ENVELOPE_SELFTEST FAIL")
        return 70
    }
    let (ok_word0, word0, p1) = exec_intent_decimal_field(raw, p0)
    let (ok_word1, word1, p2) = exec_intent_decimal_field(raw, p1)
    if ok_schema != 1 || schema != 9034 || ok_word0 != 1 || ok_word1 != 1 ||
        word0 < 0 || word0 >= 4194304 ||
        word1 < 0 || word1 >= 67108864 || str_char_at(raw, p2) > 0 {
        println("SOUNIO_EXEC_INTENT_ENVELOPE DENY424 reason=malformed-frame semantic_authority=Sounio action=9034")
        return 42
    }
    let decision = judge_loom_exec_intent_envelope_v1_words(word0, word1)
    let label = exec_intent_decision(decision)
    if decision == 1 {
        println("SOUNIO_EXEC_INTENT_ENVELOPE PROJECT semantic_authority=Sounio action=9034")
        exec_intent_fields()
        return 0
    }
    println("SOUNIO_EXEC_INTENT_ENVELOPE " + label +
        " semantic_authority=Sounio action=9034")
    42
}
