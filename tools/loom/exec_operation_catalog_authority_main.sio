//! Packed executable adapter for LOOM action 9035.

fn exec_catalog_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn exec_catalog_decision(decision: i64) -> string {
    if decision == 1 { return "PROJECT" }
    if decision == 405 { return "DENY405" }
    if decision == 560 { return "DENY560" }
    if decision == 561 { return "DENY561" }
    if decision == 562 { return "DENY562" }
    if decision == 563 { return "DENY563" }
    if decision == 564 { return "DENY564" }
    if decision == 565 { return "DENY565" }
    if decision == 566 { return "DENY566" }
    if decision == 567 { return "DENY567" }
    "DENY424"
}

fn exec_catalog_fields(operation: i64) with IO {
    println("LOOM_EXEC_OPERATION_CATALOG_FIELDS_V1")
    println("LOOM_EXEC_CATALOG/1")
    println("31089d39690c8e008dd7ea9bfecefd7e51e4257cd96e091f7fb492c240ed342c")
    if operation == 1 {
        println("calibration")
        println("113b0f7d2a1f7adc5b68a92ef37be3689accfe4bbb00cb4e8c15fc3ab7b70013")
        println("07ffb41877176a60b04949dd78c91313954dd759593f20677a1b2fcfeea31a60")
        println("83fe8c2a7d8336d01ddd4ce99ea6fad20fe864801eca5709121b211ba301f59e")
        println("fbffd03d07566a53456791c643b432e7023ce02b7cd7d505d201008661a97127")
        println("22a16bdb05ce1baaf4912207cfe00d51919fc1f46f9445d744d6c4c0409b3d26")
        return
    }
    println("sounio-check")
    println("6017e4c6e745560696f78836f9cc07ec71a9106f13ad1bfdb16d7e342f0840a9")
    println("3b195a8030465bb96245039053fb529ecb39ed330ded747fd5d71188fe4ca0d9")
    println("b3ba2f057185897309ce59af2e82f9c9b7e79ffd45bf9f293fc147b715cd1d40")
    println("d6e513e785a170a7ce8cd8f07a66e5325736ffdf21cf8f366d82c4f5ef4f15cf")
    println("c48942637666983322889dd5ff586c04cb53ef2e86aecf777a19b0582968497f")
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = exec_catalog_decimal_field(raw, 0)
    if ok_schema == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed = loom_exec_operation_catalog_selftest()
        if failed == 0 {
            println("SOUNIO_EXEC_OPERATION_CATALOG_SELFTEST PASS cases=11")
            return 0
        }
        println("SOUNIO_EXEC_OPERATION_CATALOG_SELFTEST FAIL")
        return 70
    }
    let (ok_word0, word0, p1) = exec_catalog_decimal_field(raw, p0)
    let (ok_word1, word1, p2) = exec_catalog_decimal_field(raw, p1)
    if ok_schema != 1 || schema != 9035 || ok_word0 != 1 || ok_word1 != 1 ||
        word0 < 0 || word0 >= 536870912 ||
        word1 < 0 || word1 >= 65536 || str_char_at(raw, p2) > 0 {
        println("SOUNIO_EXEC_OPERATION_CATALOG DENY424 reason=malformed-frame semantic_authority=Sounio action=9035")
        return 42
    }
    let decision = judge_loom_exec_operation_catalog_v1_words(word0, word1)
    let label = exec_catalog_decision(decision)
    if decision == 1 {
        let operation = (word0 >> 3) & 3
        println("SOUNIO_EXEC_OPERATION_CATALOG PROJECT semantic_authority=Sounio action=9035")
        exec_catalog_fields(operation)
        return 0
    }
    println("SOUNIO_EXEC_OPERATION_CATALOG " + label +
        " semantic_authority=Sounio action=9035")
    42
}
