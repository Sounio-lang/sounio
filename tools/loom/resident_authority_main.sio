//! Executable adapter for Loom resident-authority frame 9024.

fn resident_authority_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn resident_authority_digest_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) with Mut, Div, Panic {
    let (ok0, limb0, p0) = resident_authority_decimal_field(raw, start)
    let (ok1, limb1, p1) = resident_authority_decimal_field(raw, p0)
    let (ok2, limb2, p2) = resident_authority_decimal_field(raw, p1)
    let (ok3, limb3, p3) = resident_authority_decimal_field(raw, p2)
    let (ok4, limb4, p4) = resident_authority_decimal_field(raw, p3)
    let (ok5, limb5, p5) = resident_authority_decimal_field(raw, p4)
    let (ok6, limb6, p6) = resident_authority_decimal_field(raw, p5)
    let (ok7, limb7, p7) = resident_authority_decimal_field(raw, p6)
    let valid = ok0 == 1 && ok1 == 1 && ok2 == 1 && ok3 == 1 &&
        ok4 == 1 && ok5 == 1 && ok6 == 1 && ok7 == 1 &&
        limb0 <= 4294967295 && limb1 <= 4294967295 &&
        limb2 <= 4294967295 && limb3 <= 4294967295 &&
        limb4 <= 4294967295 && limb5 <= 4294967295 &&
        limb6 <= 4294967295 && limb7 <= 4294967295
    (if valid { 1 } else { 0 }, limb0, limb1, limb2, limb3,
        limb4, limb5, limb6, limb7, p7)
}

fn resident_authority_reason(decision: i64) -> string {
    if decision == 0 { return "allow" }
    if decision == 405 { return "wrong-stage" }
    if decision == 440 { return "parent-not-frozen" }
    if decision == 441 { return "generation-invalid" }
    if decision == 442 { return "sequence-invalid" }
    if decision == 443 { return "binding-incomplete" }
    if decision == 444 { return "transport-unhealthy" }
    if decision == 445 { return "generation-poisoned" }
    "malformed-frame"
}

fn resident_authority_code(decision: i64) -> string {
    if decision == 0 { return "0" }
    if decision == 405 { return "405" }
    if decision == 440 { return "440" }
    if decision == 441 { return "441" }
    if decision == 442 { return "442" }
    if decision == 443 { return "443" }
    if decision == 444 { return "444" }
    if decision == 445 { return "445" }
    "424"
}

fn resident_authority_case(case_index: i64) -> string {
    if case_index == 1 { return "1" }
    if case_index == 2 { return "2" }
    if case_index == 3 { return "3" }
    if case_index == 4 { return "4" }
    if case_index == 5 { return "5" }
    if case_index == 6 { return "6" }
    if case_index == 7 { return "7" }
    if case_index == 8 { return "8" }
    if case_index == 9 { return "9" }
    if case_index == 10 { return "10" }
    if case_index == 11 { return "11" }
    if case_index == 12 { return "12" }
    if case_index == 13 { return "13" }
    if case_index == 14 { return "14" }
    if case_index == 15 { return "15" }
    if case_index == 16 { return "16" }
    if case_index == 17 { return "17" }
    if case_index == 18 { return "18" }
    "unknown"
}

fn resident_authority_stage_name(stage: i64) -> string {
    if stage == 1 { return "GARDEN" }
    if stage == 2 { return "SOUNIO_EXECUTABLE" }
    if stage == 3 { return "SEMANTICS_FROZEN" }
    if stage == 4 { return "PARITY_OPEN" }
    if stage == 5 { return "CLAIM_READY" }
    "INVALID"
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = resident_authority_decimal_field(raw, 0)
    if ok_schema == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed_case = loom_resident_authority_selftest()
        if failed_case == 0 {
            println("SOUNIO_RESIDENT_AUTHORITY_SELFTEST PASS cases=18")
            return 0
        }
        println("SOUNIO_RESIDENT_AUTHORITY_SELFTEST FAIL case=" +
            resident_authority_case(failed_case))
        return 70
    }

    let (ok_stage, stage, p1) = resident_authority_decimal_field(raw, p0)
    let (ok_event, event_kind, p2) = resident_authority_decimal_field(raw, p1)
    let (ok_parent, parent_frozen, p3) = resident_authority_decimal_field(raw, p2)
    let (ok_generation, generation_bound, p4) = resident_authority_decimal_field(raw, p3)
    let (ok_sequence, sequence, p5) = resident_authority_decimal_field(raw, p4)
    let (ok_previous, previous_sequence, p6) = resident_authority_decimal_field(raw, p5)
    let (ok_request, request_present, p7) = resident_authority_decimal_field(raw, p6)
    let (ok_response, response_present, p8) = resident_authority_decimal_field(raw, p7)
    let (ok_correlation, correlation_valid, p9) = resident_authority_decimal_field(raw, p8)
    let (ok_deadline, deadline_bound, p10) = resident_authority_decimal_field(raw, p9)
    let (ok_healthy, resident_healthy, p11) = resident_authority_decimal_field(raw, p10)
    let (ok_poisoned, generation_poisoned, p12) = resident_authority_decimal_field(raw, p11)

    let (ok_parent_hash, a0, a1, a2, a3, a4, a5, a6, a7, p13) =
        resident_authority_digest_field(raw, p12)
    let (ok_generation_hash, g0, g1, g2, g3, g4, g5, g6, g7, p14) =
        resident_authority_digest_field(raw, p13)
    let (ok_request_hash, q0, q1, q2, q3, q4, q5, q6, q7, p15) =
        resident_authority_digest_field(raw, p14)
    let (ok_result_hash, r0, r1, r2, r3, r4, r5, r6, r7, p16) =
        resident_authority_digest_field(raw, p15)
    let (ok_deadline_hash, d0, d1, d2, d3, d4, d5, d6, d7, end_offset) =
        resident_authority_digest_field(raw, p16)

    let parsed = ok_schema == 1 && ok_stage == 1 && ok_event == 1 &&
        ok_parent == 1 && ok_generation == 1 && ok_sequence == 1 &&
        ok_previous == 1 && ok_request == 1 && ok_response == 1 &&
        ok_correlation == 1 && ok_deadline == 1 && ok_healthy == 1 &&
        ok_poisoned == 1 && ok_parent_hash == 1 && ok_generation_hash == 1 &&
        ok_request_hash == 1 && ok_result_hash == 1 &&
        ok_deadline_hash == 1 && str_char_at(raw, end_offset) <= 0
    if !parsed || schema != 9024 {
        println("SOUNIO_RESIDENT_AUTHORITY_DENY code=424 reason=malformed-frame stage=INVALID")
        return 424
    }

    let facts = admit_loom_resident_facts(
        stage, event_kind, parent_frozen, generation_bound, sequence,
        previous_sequence, request_present, response_present,
        correlation_valid, deadline_bound, resident_healthy,
        generation_poisoned,
    )
    let bindings = admit_loom_resident_bindings(
        admit_loom_resident_digest256(a0, a1, a2, a3, a4, a5, a6, a7),
        admit_loom_resident_digest256(g0, g1, g2, g3, g4, g5, g6, g7),
        admit_loom_resident_digest256(q0, q1, q2, q3, q4, q5, q6, q7),
        admit_loom_resident_digest256(r0, r1, r2, r3, r4, r5, r6, r7),
        admit_loom_resident_digest256(d0, d1, d2, d3, d4, d5, d6, d7),
    )
    let decision = loom_resident_authority_decide(facts, bindings)
    if decision == 0 {
        println("SOUNIO_RESIDENT_AUTHORITY_ALLOW code=0 reason=allow stage=" +
            resident_authority_stage_name(stage))
        return 0
    }
    println("SOUNIO_RESIDENT_AUTHORITY_DENY code=" +
        resident_authority_code(decision) + " reason=" +
        resident_authority_reason(decision) + " stage=" +
        resident_authority_stage_name(stage))
    decision
}
