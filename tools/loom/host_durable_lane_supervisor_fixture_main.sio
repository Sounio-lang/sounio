//! Executable Sounio adapter for host-durable lane supervisor action 9032.

fn durable_lane_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn durable_lane_decision(decision: i64) -> string {
    if decision == 1 { return "SAME_PHYSICAL_REATTACH" }
    if decision == 2 { return "LINEAGE_RESURRECTION" }
    if decision == 405 { return "DENY405" }
    if decision == 522 { return "DENY522" }
    if decision == 523 { return "DENY523" }
    if decision == 524 { return "DENY524" }
    if decision == 525 { return "DENY525" }
    if decision == 526 { return "DENY526" }
    if decision == 527 { return "DENY527" }
    if decision == 528 { return "DENY528" }
    if decision == 529 { return "DENY529" }
    if decision == 530 { return "DENY530" }
    if decision == 531 { return "DENY531" }
    "DENY424"
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = durable_lane_decimal_field(raw, 0)
    if ok_schema == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed = loom_host_durable_lane_selftest()
        if failed == 0 {
            println("SOUNIO_HOST_DURABLE_LANE_SELFTEST PASS cases=10")
            return 0
        }
        println("SOUNIO_HOST_DURABLE_LANE_SELFTEST FAIL")
        return 70
    }
    let (o1, stage, p1) = durable_lane_decimal_field(raw, p0)
    let (o2, preregistered, p2) = durable_lane_decimal_field(raw, p1)
    let (o3, producer_sounio, p3) = durable_lane_decimal_field(raw, p2)
    let (o4, expected_result_sounio, p4) = durable_lane_decimal_field(raw, p3)
    let (o5, python_absent, p5) = durable_lane_decimal_field(raw, p4)
    let (o6, rust_absent, p6) = durable_lane_decimal_field(raw, p5)
    let (o7, transport_replaced, p7) = durable_lane_decimal_field(raw, p6)
    let (o8, predecessor_transport_extinct, p8) = durable_lane_decimal_field(raw, p7)
    let (o9, state_root_bound, p9) = durable_lane_decimal_field(raw, p8)
    let (o10, state_root_equal, p10) = durable_lane_decimal_field(raw, p9)
    let (o11, guardian_live, p11) = durable_lane_decimal_field(raw, p10)
    let (o12, guardian_pid_equal, p12) = durable_lane_decimal_field(raw, p11)
    let (o13, guardian_start_equal, p13) = durable_lane_decimal_field(raw, p12)
    let (o14, guardian_instance_equal, p14) = durable_lane_decimal_field(raw, p13)
    let (o15, harness_live, p15) = durable_lane_decimal_field(raw, p14)
    let (o16, harness_pid_equal, p16) = durable_lane_decimal_field(raw, p15)
    let (o17, harness_start_equal, p17) = durable_lane_decimal_field(raw, p16)
    let (o18, command_equal, p18) = durable_lane_decimal_field(raw, p17)
    let (o19, boot_id_equal, p19) = durable_lane_decimal_field(raw, p18)
    let (o20, output_prefix_preserved, p20) = durable_lane_decimal_field(raw, p19)
    let (o21, semantic_journal_verified, p21) = durable_lane_decimal_field(raw, p20)
    let (o22, guardian_journal_verified, p22) = durable_lane_decimal_field(raw, p21)
    let (o23, kernel_recovered, p23) = durable_lane_decimal_field(raw, p22)
    let (o24, new_generation, p24) = durable_lane_decimal_field(raw, p23)
    let (o25, predecessor_receipt_verified, p25) = durable_lane_decimal_field(raw, p24)
    let (o26, lineage_verified, p26) = durable_lane_decimal_field(raw, p25)
    let (o27, predecessor_heads_bound, p27) = durable_lane_decimal_field(raw, p26)
    let (o28, no_same_pty_claim_after_loss, p28) = durable_lane_decimal_field(raw, p27)
    let (o29, material_observation_joined, p29) = durable_lane_decimal_field(raw, p28)
    let (o30, sabotage_count, p30) = durable_lane_decimal_field(raw, p29)
    let (o31, sabotage_required, p31) = durable_lane_decimal_field(raw, p30)
    let valid = ok_schema == 1 && schema == 9032 &&
        o1 == 1 && o2 == 1 && o3 == 1 && o4 == 1 && o5 == 1 &&
        o6 == 1 && o7 == 1 && o8 == 1 && o9 == 1 && o10 == 1 &&
        o11 == 1 && o12 == 1 && o13 == 1 && o14 == 1 && o15 == 1 &&
        o16 == 1 && o17 == 1 && o18 == 1 && o19 == 1 && o20 == 1 &&
        o21 == 1 && o22 == 1 && o23 == 1 && o24 == 1 && o25 == 1 &&
        o26 == 1 && o27 == 1 && o28 == 1 && o29 == 1 && o30 == 1 &&
        o31 == 1 && str_char_at(raw, p31) <= 0
    if !valid {
        println("SOUNIO_HOST_DURABLE_LANE DENY424 reason=malformed-frame")
        return 42
    }
    let observation = loom_host_durable_lane_observation(
        stage, preregistered, producer_sounio, expected_result_sounio,
        python_absent, rust_absent, transport_replaced,
        predecessor_transport_extinct, state_root_bound, state_root_equal,
        guardian_live, guardian_pid_equal, guardian_start_equal,
        guardian_instance_equal, harness_live, harness_pid_equal,
        harness_start_equal, command_equal, boot_id_equal,
        output_prefix_preserved, semantic_journal_verified,
        guardian_journal_verified, kernel_recovered, new_generation,
        predecessor_receipt_verified, lineage_verified,
        predecessor_heads_bound, no_same_pty_claim_after_loss,
        material_observation_joined, sabotage_count, sabotage_required,
    )
    let decision = judge_loom_host_durable_lane(observation)
    println("SOUNIO_HOST_DURABLE_LANE " + durable_lane_decision(decision) +
        " semantic_authority=Sounio action=9032")
    if decision == 1 || decision == 2 { 0 } else { 42 }
}
