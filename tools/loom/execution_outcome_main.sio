//! Executable adapter for Loom execution-outcome frame 9022.

fn execution_outcome_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn execution_outcome_digest_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) with Mut, Div, Panic {
    let (ok0, limb0, p0) = execution_outcome_decimal_field(raw, start)
    let (ok1, limb1, p1) = execution_outcome_decimal_field(raw, p0)
    let (ok2, limb2, p2) = execution_outcome_decimal_field(raw, p1)
    let (ok3, limb3, p3) = execution_outcome_decimal_field(raw, p2)
    let (ok4, limb4, p4) = execution_outcome_decimal_field(raw, p3)
    let (ok5, limb5, p5) = execution_outcome_decimal_field(raw, p4)
    let (ok6, limb6, p6) = execution_outcome_decimal_field(raw, p5)
    let (ok7, limb7, p7) = execution_outcome_decimal_field(raw, p6)
    let valid = ok0 == 1 && ok1 == 1 && ok2 == 1 && ok3 == 1 &&
        ok4 == 1 && ok5 == 1 && ok6 == 1 && ok7 == 1 &&
        limb0 <= 4294967295 && limb1 <= 4294967295 &&
        limb2 <= 4294967295 && limb3 <= 4294967295 &&
        limb4 <= 4294967295 && limb5 <= 4294967295 &&
        limb6 <= 4294967295 && limb7 <= 4294967295
    (if valid { 1 } else { 0 }, limb0, limb1, limb2, limb3,
        limb4, limb5, limb6, limb7, p7)
}

fn execution_outcome_reason(decision: i64) -> string {
    if decision == 0 { return "allow" }
    if decision == 301 { return "policy-missing" }
    if decision == 302 { return "policy-timeout" }
    if decision == 303 { return "policy-error" }
    if decision == 305 { return "wrong-stage" }
    if decision == 306 { return "outcome-incomplete" }
    if decision == 307 { return "exit-signal-invalid" }
    if decision == 309 { return "receipt-missing" }
    if decision == 310 { return "issue-decision-missing" }
    if decision == 311 { return "consume-decision-missing" }
    if decision == 312 { return "kernel-generation-mismatch" }
    if decision == 313 { return "broker-identity-mismatch" }
    if decision == 314 { return "binding-hash-incomplete" }
    if decision == 315 { return "parent-semantics-hash-mismatch" }
    if decision == 316 { return "result-digest-missing" }
    "malformed-frame"
}

fn execution_outcome_code(decision: i64) -> string {
    if decision == 0 { return "0" }
    if decision == 301 { return "301" }
    if decision == 302 { return "302" }
    if decision == 303 { return "303" }
    if decision == 305 { return "305" }
    if decision == 306 { return "306" }
    if decision == 307 { return "307" }
    if decision == 309 { return "309" }
    if decision == 310 { return "310" }
    if decision == 311 { return "311" }
    if decision == 312 { return "312" }
    if decision == 313 { return "313" }
    if decision == 314 { return "314" }
    if decision == 315 { return "315" }
    if decision == 316 { return "316" }
    "304"
}

fn execution_outcome_stage_name(stage: i64) -> string {
    if stage == 1 { return "GARDEN" }
    if stage == 2 { return "SOUNIO_EXECUTABLE" }
    if stage == 3 { return "SEMANTICS_FROZEN" }
    if stage == 4 { return "PARITY_OPEN" }
    if stage == 5 { return "CLAIM_READY" }
    "INVALID"
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = execution_outcome_decimal_field(raw, 0)
    if ok_schema == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed_case = loom_execution_outcome_selftest()
        if failed_case == 0 {
            println("SOUNIO_EXECUTION_OUTCOME_SELFTEST PASS cases=28")
            return 0
        }
        println("SOUNIO_EXECUTION_OUTCOME_SELFTEST FAIL case=" +
            execution_outcome_code(failed_case))
        return 70
    }

    let (ok_stage, stage, p1) = execution_outcome_decimal_field(raw, p0)
    let (ok_policy, policy, p2) = execution_outcome_decimal_field(raw, p1)
    let (ok_kind, kind, p3) = execution_outcome_decimal_field(raw, p2)
    let (ok_exit, exit_code, p4) = execution_outcome_decimal_field(raw, p3)
    let (ok_signal, signal, p5) = execution_outcome_decimal_field(raw, p4)
    let (ok_elapsed, elapsed_us, p6) = execution_outcome_decimal_field(raw, p5)
    let (ok_receipt, receipt, p7) = execution_outcome_decimal_field(raw, p6)
    let (ok_issue, issue, p8) = execution_outcome_decimal_field(raw, p7)
    let (ok_consume, consume, p9) = execution_outcome_decimal_field(raw, p8)
    let (ok_generation_match, generation_match, p10) =
        execution_outcome_decimal_field(raw, p9)
    let (ok_same_broker, same_broker, p11) =
        execution_outcome_decimal_field(raw, p10)

    let (ok_source, s0, s1, s2, s3, s4, s5, s6, s7, p12) =
        execution_outcome_digest_field(raw, p11)
    let (ok_semantics, m0, m1, m2, m3, m4, m5, m6, m7, p13) =
        execution_outcome_digest_field(raw, p12)
    let (ok_parent, a0, a1, a2, a3, a4, a5, a6, a7, p14) =
        execution_outcome_digest_field(raw, p13)
    let (ok_toolchain, t0, t1, t2, t3, t4, t5, t6, t7, p15) =
        execution_outcome_digest_field(raw, p14)
    let (ok_hardware, h0, h1, h2, h3, h4, h5, h6, h7, p16) =
        execution_outcome_digest_field(raw, p15)
    let (ok_command, c0, c1, c2, c3, c4, c5, c6, c7, p17) =
        execution_outcome_digest_field(raw, p16)
    let (ok_environment, e0, e1, e2, e3, e4, e5, e6, e7, p18) =
        execution_outcome_digest_field(raw, p17)
    let (ok_executable, x0, x1, x2, x3, x4, x5, x6, x7, p19) =
        execution_outcome_digest_field(raw, p18)
    let (ok_grant, g0, g1, g2, g3, g4, g5, g6, g7, p20) =
        execution_outcome_digest_field(raw, p19)
    let (ok_generation, k0, k1, k2, k3, k4, k5, k6, k7, p21) =
        execution_outcome_digest_field(raw, p20)
    let (ok_issue_decision, i0, i1, i2, i3, i4, i5, i6, i7, p22) =
        execution_outcome_digest_field(raw, p21)
    let (ok_consume_decision, d0, d1, d2, d3, d4, d5, d6, d7, p23) =
        execution_outcome_digest_field(raw, p22)
    let (ok_result, r0, r1, r2, r3, r4, r5, r6, r7, end_offset) =
        execution_outcome_digest_field(raw, p23)

    let parsed = ok_schema == 1 && ok_stage == 1 && ok_policy == 1 &&
        ok_kind == 1 && ok_exit == 1 && ok_signal == 1 && ok_elapsed == 1 &&
        ok_receipt == 1 && ok_issue == 1 && ok_consume == 1 &&
        ok_generation_match == 1 && ok_same_broker == 1 && ok_source == 1 &&
        ok_semantics == 1 && ok_parent == 1 && ok_toolchain == 1 &&
        ok_hardware == 1 && ok_command == 1 && ok_environment == 1 &&
        ok_executable == 1 && ok_grant == 1 && ok_generation == 1 &&
        ok_issue_decision == 1 && ok_consume_decision == 1 &&
        ok_result == 1 && str_char_at(raw, end_offset) <= 0
    if !parsed || schema != 9022 {
        println("SOUNIO_EXECUTION_OUTCOME_DENY code=304 reason=malformed-frame stage=INVALID")
        return 304
    }

    let decision = loom_execution_outcome_decide(
        stage,
        policy,
        kind,
        exit_code,
        signal,
        elapsed_us,
        receipt,
        issue,
        consume,
        generation_match,
        same_broker,
        admit_execution_outcome_digest256(s0, s1, s2, s3, s4, s5, s6, s7),
        admit_execution_outcome_digest256(m0, m1, m2, m3, m4, m5, m6, m7),
        admit_execution_outcome_digest256(a0, a1, a2, a3, a4, a5, a6, a7),
        admit_execution_outcome_digest256(t0, t1, t2, t3, t4, t5, t6, t7),
        admit_execution_outcome_digest256(h0, h1, h2, h3, h4, h5, h6, h7),
        admit_execution_outcome_digest256(c0, c1, c2, c3, c4, c5, c6, c7),
        admit_execution_outcome_digest256(e0, e1, e2, e3, e4, e5, e6, e7),
        admit_execution_outcome_digest256(x0, x1, x2, x3, x4, x5, x6, x7),
        admit_execution_outcome_digest256(g0, g1, g2, g3, g4, g5, g6, g7),
        admit_execution_outcome_digest256(k0, k1, k2, k3, k4, k5, k6, k7),
        admit_execution_outcome_digest256(i0, i1, i2, i3, i4, i5, i6, i7),
        admit_execution_outcome_digest256(d0, d1, d2, d3, d4, d5, d6, d7),
        admit_execution_outcome_digest256(r0, r1, r2, r3, r4, r5, r6, r7),
    )
    if decision == 0 {
        println("SOUNIO_EXECUTION_OUTCOME_ALLOW code=0 reason=allow stage=" +
            execution_outcome_stage_name(stage))
        return 0
    }
    println("SOUNIO_EXECUTION_OUTCOME_DENY code=" +
        execution_outcome_code(decision) + " reason=" +
        execution_outcome_reason(decision) + " stage=" +
        execution_outcome_stage_name(stage))
    decision
}
