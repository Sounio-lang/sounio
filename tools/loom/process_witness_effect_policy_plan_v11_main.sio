    effect_plan_v11_emit_mechanisms("6", "1", "SECCOMP_IO_URING_SETUP")
    effect_plan_v11_emit_mechanisms("7", "2", "PRIVATE_NETWORK+SECCOMP_INET_SOCKET")
    effect_plan_v11_emit_mechanisms("8", "2", "UNIX_ENDPOINT_ABSENCE+SECCOMP_UNIX_SOCKET")
    effect_plan_v11_emit_mechanisms("9", "1", "SECCOMP_MEMFD_CREATE")
    effect_plan_v11_emit_mechanisms("10", "2", "LOCK_PERSONALITY+SECCOMP_PERSONALITY")
    effect_plan_v11_emit_mechanisms("11", "2", "CAPSULE_EMPTY_BIND+SECCOMP_PROC_OPEN")
    effect_plan_v11_emit_mechanisms("12", "1", "POSITIVE_DEFAULT_DENY")

    effect_plan_v11_emit_probe("1", "repeat_exact_exec", "2", "4")
    effect_plan_v11_emit_vertex("1", "repeat_exact_exec", "11", "REFUSED_BEFORE_EFFECT", "FD3_CLOEXEC", "EBADF", "NONE")
    effect_plan_v11_emit_vertex("1", "repeat_exact_exec", "10", "REFUSED_BEFORE_EFFECT", "FD3_CLOEXEC", "EBADF", "NONE")
    effect_plan_v11_emit_vertex("1", "repeat_exact_exec", "01", "EFFECT_COMPLETED", "NONE", "EXEC_COMPLETED", "SECOND_EXEC_MARKER")
    effect_plan_v11_emit_vertex("1", "repeat_exact_exec", "00", "EFFECT_COMPLETED", "NONE", "EXEC_COMPLETED", "SECOND_EXEC_MARKER")
