//! Native Sounio policy adapter for Loom attention frame 9009.

fn attention_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 8192 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        value = value * 10 + (code - 48)
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn attention_digest_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) with Mut, Div, Panic {
    let (ok0, limb0, p0) = attention_decimal_field(raw, start)
    let (ok1, limb1, p1) = attention_decimal_field(raw, p0)
    let (ok2, limb2, p2) = attention_decimal_field(raw, p1)
    let (ok3, limb3, p3) = attention_decimal_field(raw, p2)
    let (ok4, limb4, p4) = attention_decimal_field(raw, p3)
    let (ok5, limb5, p5) = attention_decimal_field(raw, p4)
    let (ok6, limb6, p6) = attention_decimal_field(raw, p5)
    let (ok7, limb7, p7) = attention_decimal_field(raw, p6)
    let valid = ok0 == 1 && ok1 == 1 && ok2 == 1 && ok3 == 1 &&
        ok4 == 1 && ok5 == 1 && ok6 == 1 && ok7 == 1 &&
        limb0 <= 4294967295 && limb1 <= 4294967295 &&
        limb2 <= 4294967295 && limb3 <= 4294967295 &&
        limb4 <= 4294967295 && limb5 <= 4294967295 &&
        limb6 <= 4294967295 && limb7 <= 4294967295
    (if valid { 1 } else { 0 }, limb0, limb1, limb2, limb3,
        limb4, limb5, limb6, limb7, p7)
}

fn attention_policy_name(policy: i64) -> string {
    if policy == 1 { return "information-first" }
    if policy == 2 { return "falsification-first" }
    if policy == 3 { return "counterfactual-first" }
    "none"
}

fn main() -> i64 with IO, Mut, Div, LoomAttentionHostTrust, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = attention_decimal_field(raw, 0)
    let (ok_kind, kind, p1) = attention_decimal_field(raw, p0)
    let (ok_policy, policy, p2) = attention_decimal_field(raw, p1)
    let (ok_budget, budget, p3) = attention_decimal_field(raw, p2)
    let (ok_plan, plan, p4) = attention_decimal_field(raw, p3)
    let (ok_selected, selected, p5) = attention_decimal_field(raw, p4)
    let (ok_rival, rival, p6) = attention_decimal_field(raw, p5)
    let (ok_owner, owner, p7) = attention_decimal_field(raw, p6)
    let (ok_generation, generation, p8) = attention_decimal_field(raw, p7)
    let (ok_si, selected_information, p9) = attention_decimal_field(raw, p8)
    let (ok_sf, selected_falsification, p10) = attention_decimal_field(raw, p9)
    let (ok_sd, selected_divergence, p11) = attention_decimal_field(raw, p10)
    let (ok_sc, selected_cost, p12) = attention_decimal_field(raw, p11)
    let (ok_sr, selected_risk, p13) = attention_decimal_field(raw, p12)
    let (ok_ri, rival_information, p14) = attention_decimal_field(raw, p13)
    let (ok_rf, rival_falsification, p15) = attention_decimal_field(raw, p14)
    let (ok_rd, rival_divergence, p16) = attention_decimal_field(raw, p15)
    let (ok_rc, rival_cost, p17) = attention_decimal_field(raw, p16)
    let (ok_rr, rival_risk, p18) = attention_decimal_field(raw, p17)
    let (ok_evidence, e0, e1, e2, e3, e4, e5, e6, e7, p19) =
        attention_digest_field(raw, p18)
    let (ok_falsifier, f0, f1, f2, f3, f4, f5, f6, f7, p20) =
        attention_digest_field(raw, p19)
    let (ok_candidates, c0, c1, c2, c3, c4, c5, c6, c7, p21) =
        attention_digest_field(raw, p20)
    let (ok_outcome, o0, o1, o2, o3, o4, o5, o6, o7, end_offset) =
        attention_digest_field(raw, p21)
    let parsed = ok_schema == 1 && ok_kind == 1 && ok_policy == 1 &&
        ok_budget == 1 && ok_plan == 1 && ok_selected == 1 &&
        ok_rival == 1 && ok_owner == 1 && ok_generation == 1 &&
        ok_si == 1 && ok_sf == 1 && ok_sd == 1 && ok_sc == 1 &&
        ok_sr == 1 && ok_ri == 1 && ok_rf == 1 && ok_rd == 1 &&
        ok_rc == 1 && ok_rr == 1 && ok_evidence == 1 &&
        ok_falsifier == 1 && ok_candidates == 1 && ok_outcome == 1 &&
        str_char_at(raw, end_offset) <= 0
    if !parsed || schema != 9009 {
        println("SOUNIO_ATTENTION_REFUSE reason=malformed-frame")
        return 64
    }
    let evidence = admit_attention_digest256(e0, e1, e2, e3, e4, e5, e6, e7)
    let falsifier = admit_attention_digest256(f0, f1, f2, f3, f4, f5, f6, f7)
    let candidates = admit_attention_digest256(c0, c1, c2, c3, c4, c5, c6, c7)
    let outcome = admit_attention_digest256(o0, o1, o2, o3, o4, o5, o6, o7)
    if host_attention_frame_accepts(
        kind, policy, budget, plan, selected, rival, owner, generation,
        selected_information, selected_falsification, selected_divergence,
        selected_cost, selected_risk,
        rival_information, rival_falsification, rival_divergence,
        rival_cost, rival_risk, evidence, falsifier, candidates, outcome,
    ) {
        if kind == 1 {
            println("SOUNIO_ATTENTION_ACCEPT schema=loom-native-attention-v0 transition=compile policy=" +
                attention_policy_name(policy))
        } else {
            println("SOUNIO_ATTENTION_ACCEPT schema=loom-native-attention-v0 transition=complete state=completed")
        }
        return 0
    }
    println("SOUNIO_ATTENTION_REFUSE reason=decision-policy")
    42
}
