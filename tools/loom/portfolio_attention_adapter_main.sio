//! Native Sounio policy adapter for Loom Pareto portfolio frame 9010.

fn portfolio_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 16384 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn portfolio_digest_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) with Mut, Div, Panic {
    let (ok0, limb0, p0) = portfolio_decimal_field(raw, start)
    let (ok1, limb1, p1) = portfolio_decimal_field(raw, p0)
    let (ok2, limb2, p2) = portfolio_decimal_field(raw, p1)
    let (ok3, limb3, p3) = portfolio_decimal_field(raw, p2)
    let (ok4, limb4, p4) = portfolio_decimal_field(raw, p3)
    let (ok5, limb5, p5) = portfolio_decimal_field(raw, p4)
    let (ok6, limb6, p6) = portfolio_decimal_field(raw, p5)
    let (ok7, limb7, p7) = portfolio_decimal_field(raw, p6)
    let valid = ok0 == 1 && ok1 == 1 && ok2 == 1 && ok3 == 1 &&
        ok4 == 1 && ok5 == 1 && ok6 == 1 && ok7 == 1 &&
        limb0 <= 4294967295 && limb1 <= 4294967295 &&
        limb2 <= 4294967295 && limb3 <= 4294967295 &&
        limb4 <= 4294967295 && limb5 <= 4294967295 &&
        limb6 <= 4294967295 && limb7 <= 4294967295
    (if valid { 1 } else { 0 }, limb0, limb1, limb2, limb3,
        limb4, limb5, limb6, limb7, p7)
}

fn portfolio_policy_name(policy: i64) -> string {
    if policy == 1 { return "information-first" }
    if policy == 2 { return "falsification-first" }
    if policy == 3 { return "counterfactual-first" }
    "none"
}

fn main() -> i64 with IO, Mut, Div, LoomPortfolioHostTrust, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = portfolio_decimal_field(raw, 0)
    let (ok_kind, kind, p1) = portfolio_decimal_field(raw, p0)
    let (ok_policy, policy, p2) = portfolio_decimal_field(raw, p1)
    let (ok_tb, token_budget, p3) = portfolio_decimal_field(raw, p2)
    let (ok_wb, wall_budget, p4) = portfolio_decimal_field(raw, p3)
    let (ok_gb, gpu_budget, p5) = portfolio_decimal_field(raw, p4)
    let (ok_qb, quota_budget, p6) = portfolio_decimal_field(raw, p5)
    let (ok_portfolio, portfolio, p7) = portfolio_decimal_field(raw, p6)
    let (ok_selected, selected, p8) = portfolio_decimal_field(raw, p7)
    let (ok_rival, rival, p9) = portfolio_decimal_field(raw, p8)
    let (ok_owner, owner, p10) = portfolio_decimal_field(raw, p9)
    let (ok_generation, generation, p11) = portfolio_decimal_field(raw, p10)
    let (ok_si, si, p12) = portfolio_decimal_field(raw, p11)
    let (ok_sf, sf, p13) = portfolio_decimal_field(raw, p12)
    let (ok_sd, sd, p14) = portfolio_decimal_field(raw, p13)
    let (ok_sr, sr, p15) = portfolio_decimal_field(raw, p14)
    let (ok_st, st, p16) = portfolio_decimal_field(raw, p15)
    let (ok_sw, sw, p17) = portfolio_decimal_field(raw, p16)
    let (ok_sg, sg, p18) = portfolio_decimal_field(raw, p17)
    let (ok_sq, sq, p19) = portfolio_decimal_field(raw, p18)
    let (ok_ri, ri, p20) = portfolio_decimal_field(raw, p19)
    let (ok_rf, rf, p21) = portfolio_decimal_field(raw, p20)
    let (ok_rd, rd, p22) = portfolio_decimal_field(raw, p21)
    let (ok_rr, rr, p23) = portfolio_decimal_field(raw, p22)
    let (ok_rt, rt, p24) = portfolio_decimal_field(raw, p23)
    let (ok_rw, rw, p25) = portfolio_decimal_field(raw, p24)
    let (ok_rg, rg, p26) = portfolio_decimal_field(raw, p25)
    let (ok_rq, rq, p27) = portfolio_decimal_field(raw, p26)
    let (ok_candidates, c0, c1, c2, c3, c4, c5, c6, c7, p28) =
        portfolio_digest_field(raw, p27)
    let (ok_frontier, f0, f1, f2, f3, f4, f5, f6, f7, p29) =
        portfolio_digest_field(raw, p28)
    let (ok_selected_set, s0, s1, s2, s3, s4, s5, s6, s7, p30) =
        portfolio_digest_field(raw, p29)
    let (ok_evidence, e0, e1, e2, e3, e4, e5, e6, e7, p31) =
        portfolio_digest_field(raw, p30)
    let (ok_falsifier, x0, x1, x2, x3, x4, x5, x6, x7, p32) =
        portfolio_digest_field(raw, p31)
    let (ok_outcome, o0, o1, o2, o3, o4, o5, o6, o7, end_offset) =
        portfolio_digest_field(raw, p32)
    let parsed = ok_schema == 1 && ok_kind == 1 && ok_policy == 1 &&
        ok_tb == 1 && ok_wb == 1 && ok_gb == 1 && ok_qb == 1 &&
        ok_portfolio == 1 && ok_selected == 1 && ok_rival == 1 &&
        ok_owner == 1 && ok_generation == 1 && ok_si == 1 && ok_sf == 1 &&
        ok_sd == 1 && ok_sr == 1 && ok_st == 1 && ok_sw == 1 &&
        ok_sg == 1 && ok_sq == 1 && ok_ri == 1 && ok_rf == 1 &&
        ok_rd == 1 && ok_rr == 1 && ok_rt == 1 && ok_rw == 1 &&
        ok_rg == 1 && ok_rq == 1 && ok_candidates == 1 &&
        ok_frontier == 1 && ok_selected_set == 1 && ok_evidence == 1 &&
        ok_falsifier == 1 && ok_outcome == 1 &&
        str_char_at(raw, end_offset) <= 0
    if !parsed || schema != 9010 {
        println("SOUNIO_PORTFOLIO_REFUSE reason=malformed-frame")
        return 64
    }
    let candidates = admit_portfolio_digest256(c0, c1, c2, c3, c4, c5, c6, c7)
    let frontier = admit_portfolio_digest256(f0, f1, f2, f3, f4, f5, f6, f7)
    let selected_set = admit_portfolio_digest256(s0, s1, s2, s3, s4, s5, s6, s7)
    let evidence = admit_portfolio_digest256(e0, e1, e2, e3, e4, e5, e6, e7)
    let falsifier = admit_portfolio_digest256(x0, x1, x2, x3, x4, x5, x6, x7)
    let outcome = admit_portfolio_digest256(o0, o1, o2, o3, o4, o5, o6, o7)
    if host_portfolio_frame_accepts(
        kind, policy, token_budget, wall_budget, gpu_budget, quota_budget,
        portfolio, selected, rival, owner, generation,
        si, sf, sd, sr, st, sw, sg, sq,
        ri, rf, rd, rr, rt, rw, rg, rq,
        candidates, frontier, selected_set, evidence, falsifier, outcome,
    ) {
        if kind == 1 {
            println("SOUNIO_PORTFOLIO_ACCEPT schema=loom-native-portfolio-v0 transition=compile policy=" +
                portfolio_policy_name(policy))
        } else {
            println("SOUNIO_PORTFOLIO_ACCEPT schema=loom-native-portfolio-v0 transition=complete state=completed")
        }
        return 0
    }
    println("SOUNIO_PORTFOLIO_REFUSE reason=decision-policy")
    42
}
