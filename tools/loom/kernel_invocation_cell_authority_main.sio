    let (ok_membrane_hash, e0, e1, e2, e3, e4, e5, e6, e7, p77) =
        kernel_invocation_cell_digest_field(raw, p76)
    let (ok_command_hash, f0, f1, f2, f3, f4, f5, f6, f7, p78) =
        kernel_invocation_cell_digest_field(raw, p77)
    let (ok_worktree_hash, g0, g1, g2, g3, g4, g5, g6, g7, p79) =
        kernel_invocation_cell_digest_field(raw, p78)
    let (ok_scope_hash, h0, h1, h2, h3, h4, h5, h6, h7, p80) =
