            admit_loom_kernel_invocation_cell_digest256(c0, c1, c2, c3, c4, c5, c6, c7),
            admit_loom_kernel_invocation_cell_digest256(d0, d1, d2, d3, d4, d5, d6, d7),
            admit_loom_kernel_invocation_cell_digest256(e0, e1, e2, e3, e4, e5, e6, e7),
            admit_loom_kernel_invocation_cell_digest256(f0, f1, f2, f3, f4, f5, f6, f7),
            admit_loom_kernel_invocation_cell_digest256(g0, g1, g2, g3, g4, g5, g6, g7),
            admit_loom_kernel_invocation_cell_digest256(h0, h1, h2, h3, h4, h5, h6, h7),
            admit_loom_kernel_invocation_cell_digest256(i0, i1, i2, i3, i4, i5, i6, i7),
            admit_loom_kernel_invocation_cell_digest256(j0, j1, j2, j3, j4, j5, j6, j7),
            admit_loom_kernel_invocation_cell_digest256(k0, k1, k2, k3, k4, k5, k6, k7),
            admit_loom_kernel_invocation_cell_digest256(l0, l1, l2, l3, l4, l5, l6, l7),
        ),
    )
    if decision == 0 {
        println("SOUNIO_KERNEL_INVOCATION_CELL_ALLOW code=0 reason=allow stage=" +
