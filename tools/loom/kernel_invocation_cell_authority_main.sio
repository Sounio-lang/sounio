        return 0
    }
    println("SOUNIO_KERNEL_INVOCATION_CELL_DENY code=" +
        kernel_invocation_cell_code(decision) + " reason=" +
        kernel_invocation_cell_reason(decision) + " stage=" +
        kernel_invocation_cell_stage_name(stage))
    decision
}
