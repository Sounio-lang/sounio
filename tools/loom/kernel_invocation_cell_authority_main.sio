    let (ok_sabotage_required, sabotage_required, p72) = kernel_invocation_cell_decimal_field(raw, p71)

    let (ok_parent_9028_hash, a0, a1, a2, a3, a4, a5, a6, a7, p73) =
        kernel_invocation_cell_digest_field(raw, p72)
    let (ok_parent_9025_hash, b0, b1, b2, b3, b4, b5, b6, b7, p74) =
        kernel_invocation_cell_digest_field(raw, p73)
    let (ok_parent_9023_hash, c0, c1, c2, c3, c4, c5, c6, c7, p75) =
        kernel_invocation_cell_digest_field(raw, p74)
