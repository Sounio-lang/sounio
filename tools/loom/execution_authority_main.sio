//! Executable adapter for Loom execution-authority frame 9021.

fn execution_authority_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn execution_authority_digest_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) with Mut, Div, Panic {
    let (ok0, limb0, p0) = execution_authority_decimal_field(raw, start)
    let (ok1, limb1, p1) = execution_authority_decimal_field(raw, p0)
    let (ok2, limb2, p2) = execution_authority_decimal_field(raw, p1)
    let (ok3, limb3, p3) = execution_authority_decimal_field(raw, p2)
    let (ok4, limb4, p4) = execution_authority_decimal_field(raw, p3)
    let (ok5, limb5, p5) = execution_authority_decimal_field(raw, p4)
    let (ok6, limb6, p6) = execution_authority_decimal_field(raw, p5)
    let (ok7, limb7, p7) = execution_authority_decimal_field(raw, p6)
    let valid = ok0 == 1 && ok1 == 1 && ok2 == 1 && ok3 == 1 &&
        ok4 == 1 && ok5 == 1 && ok6 == 1 && ok7 == 1 &&
        limb0 <= 4294967295 && limb1 <= 4294967295 &&
        limb2 <= 4294967295 && limb3 <= 4294967295 &&
        limb4 <= 4294967295 && limb5 <= 4294967295 &&
        limb6 <= 4294967295 && limb7 <= 4294967295
    (if valid { 1 } else { 0 }, limb0, limb1, limb2, limb3,
        limb4, limb5, limb6, limb7, p7)
}

fn execution_authority_reason(decision: i64) -> string {
    if decision == 0 { return "allow" }
    if decision == 201 { return "policy-missing" }
    if decision == 202 { return "policy-timeout" }
    if decision == 203 { return "policy-error" }
    if decision == 210 { return "forbidden-language" }
    if decision == 211 { return "language-purpose-mismatch" }
    if decision == 212 { return "wrong-stage" }
    if decision == 213 { return "semantic-authority-required" }
    if decision == 214 { return "expected-result-authority-required" }
    if decision == 217 { return "parent-semantics-hash-mismatch" }
    if decision == 218 { return "receipt-incomplete" }
    if decision == 219 { return "review-promoted-to-authority" }
    if decision == 220 { return "waiver-invalid" }
    if decision == 222 { return "parity-closed" }
    if decision == 223 { return "parity-purpose-required" }
    if decision == 225 { return "preexec-incomplete" }
    if decision == 226 { return "dynamic-execution-unclassified" }
    if decision == 227 { return "execution-closure-unattested" }
    if decision == 228 { return "language-unclassified" }
    if decision == 229 { return "receipt-chain-missing" }
    if decision == 230 { return "surface-forbidden-for-role" }
    "malformed-frame"
}

fn execution_authority_code(decision: i64) -> string {
    if decision == 0 { return "0" }
    if decision == 201 { return "201" }
    if decision == 202 { return "202" }
    if decision == 203 { return "203" }
    if decision == 210 { return "210" }
    if decision == 211 { return "211" }
    if decision == 212 { return "212" }
    if decision == 213 { return "213" }
    if decision == 214 { return "214" }
    if decision == 217 { return "217" }
    if decision == 218 { return "218" }
    if decision == 219 { return "219" }
    if decision == 220 { return "220" }
    if decision == 222 { return "222" }
    if decision == 223 { return "223" }
    if decision == 225 { return "225" }
    if decision == 226 { return "226" }
    if decision == 227 { return "227" }
    if decision == 228 { return "228" }
    if decision == 229 { return "229" }
    if decision == 230 { return "230" }
    "224"
}

fn execution_authority_stage_name(stage: i64) -> string {
    if stage == 1 { return "GARDEN" }
    if stage == 2 { return "SOUNIO_EXECUTABLE" }
    if stage == 3 { return "SEMANTICS_FROZEN" }
    if stage == 4 { return "PARITY_OPEN" }
    if stage == 5 { return "CLAIM_READY" }
    "INVALID"
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = execution_authority_decimal_field(raw, 0)
    if ok_schema == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed_case = loom_execution_authority_selftest()
        if failed_case == 0 {
            println("SOUNIO_EXECUTION_AUTHORITY_SELFTEST PASS cases=32")
            return 0
        }
        println("SOUNIO_EXECUTION_AUTHORITY_SELFTEST FAIL case=" +
            execution_authority_code(failed_case))
        return 70
    }

    let (ok_stage, stage, p1) = execution_authority_decimal_field(raw, p0)
    let (ok_surface, surface, p2) = execution_authority_decimal_field(raw, p1)
    let (ok_class, execution_class, p3) = execution_authority_decimal_field(raw, p2)
    let (ok_language, language, p4) = execution_authority_decimal_field(raw, p3)
    let (ok_purpose, purpose, p5) = execution_authority_decimal_field(raw, p4)
    let (ok_policy, policy, p6) = execution_authority_decimal_field(raw, p5)
    let (ok_preexec, preexec, p7) = execution_authority_decimal_field(raw, p6)
    let (ok_closure, closure, p8) = execution_authority_decimal_field(raw, p7)
    let (ok_semantic, semantic_write, p9) = execution_authority_decimal_field(raw, p8)
    let (ok_expected, expected_write, p10) = execution_authority_decimal_field(raw, p9)
    let (ok_review, review_promoted, p11) = execution_authority_decimal_field(raw, p10)
    let (ok_parity, parity_open, p12) = execution_authority_decimal_field(raw, p11)
    let (ok_chain, receipt_chain, p13) = execution_authority_decimal_field(raw, p12)
    let (ok_exception, exception_requested, p14) = execution_authority_decimal_field(raw, p13)
    let (ok_founder, waiver_founder, p15) = execution_authority_decimal_field(raw, p14)
    let (ok_scope, waiver_scope, p16) = execution_authority_decimal_field(raw, p15)
    let (ok_waiver_purpose, waiver_purpose, p17) = execution_authority_decimal_field(raw, p16)
    let (ok_unexpired, waiver_unexpired, p18) = execution_authority_decimal_field(raw, p17)
    let (ok_source, s0, s1, s2, s3, s4, s5, s6, s7, p19) =
        execution_authority_digest_field(raw, p18)
    let (ok_semantics, m0, m1, m2, m3, m4, m5, m6, m7, p20) =
        execution_authority_digest_field(raw, p19)
    let (ok_parent, a0, a1, a2, a3, a4, a5, a6, a7, p21) =
        execution_authority_digest_field(raw, p20)
    let (ok_toolchain, t0, t1, t2, t3, t4, t5, t6, t7, p22) =
        execution_authority_digest_field(raw, p21)
    let (ok_hardware, h0, h1, h2, h3, h4, h5, h6, h7, p23) =
        execution_authority_digest_field(raw, p22)
    let (ok_command, c0, c1, c2, c3, c4, c5, c6, c7, p24) =
        execution_authority_digest_field(raw, p23)
    let (ok_result, r0, r1, r2, r3, r4, r5, r6, r7, p25) =
        execution_authority_digest_field(raw, p24)
    let (ok_waiver, w0, w1, w2, w3, w4, w5, w6, w7, end_offset) =
        execution_authority_digest_field(raw, p25)
    let parsed = ok_schema == 1 && ok_stage == 1 && ok_surface == 1 &&
        ok_class == 1 && ok_language == 1 && ok_purpose == 1 &&
        ok_policy == 1 && ok_preexec == 1 && ok_closure == 1 &&
        ok_semantic == 1 && ok_expected == 1 && ok_review == 1 &&
        ok_parity == 1 && ok_chain == 1 && ok_exception == 1 &&
        ok_founder == 1 && ok_scope == 1 && ok_waiver_purpose == 1 &&
        ok_unexpired == 1 && ok_source == 1 && ok_semantics == 1 &&
        ok_parent == 1 && ok_toolchain == 1 && ok_hardware == 1 &&
        ok_command == 1 && ok_result == 1 && ok_waiver == 1 &&
        str_char_at(raw, end_offset) <= 0
    if !parsed || schema != 9021 {
        println("SOUNIO_EXECUTION_AUTHORITY_DENY code=224 reason=malformed-frame stage=INVALID")
        return 224
    }

    let decision = loom_execution_authority_decide(
        stage,
        surface,
        execution_class,
        language,
        purpose,
        policy,
        preexec,
        closure,
        semantic_write,
        expected_write,
        review_promoted,
        parity_open,
        receipt_chain,
        exception_requested,
        waiver_founder,
        waiver_scope,
        waiver_purpose,
        waiver_unexpired,
        admit_execution_authority_digest256(s0, s1, s2, s3, s4, s5, s6, s7),
        admit_execution_authority_digest256(m0, m1, m2, m3, m4, m5, m6, m7),
        admit_execution_authority_digest256(a0, a1, a2, a3, a4, a5, a6, a7),
        admit_execution_authority_digest256(t0, t1, t2, t3, t4, t5, t6, t7),
        admit_execution_authority_digest256(h0, h1, h2, h3, h4, h5, h6, h7),
        admit_execution_authority_digest256(c0, c1, c2, c3, c4, c5, c6, c7),
        admit_execution_authority_digest256(r0, r1, r2, r3, r4, r5, r6, r7),
        admit_execution_authority_digest256(w0, w1, w2, w3, w4, w5, w6, w7),
    )
    if decision == 0 {
        println("SOUNIO_EXECUTION_AUTHORITY_ALLOW code=0 reason=allow stage=" +
            execution_authority_stage_name(stage))
        return 0
    }
    println("SOUNIO_EXECUTION_AUTHORITY_DENY code=" +
        execution_authority_code(decision) + " reason=" +
        execution_authority_reason(decision) + " stage=" +
        execution_authority_stage_name(stage))
    decision
}
