//! Packed executable adapter for the exact V1 LOOM action-9033 fixture.

fn exec_result_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn exec_result_decision(decision: i64) -> string {
    if decision == 1 { return "PUBLISH" }
    if decision == 2 { return "RESOLVE" }
    if decision == 405 { return "DENY405" }
    if decision == 532 { return "DENY532" }
    if decision == 533 { return "DENY533" }
    if decision == 534 { return "DENY534" }
    if decision == 535 { return "DENY535" }
    if decision == 536 { return "DENY536" }
    if decision == 537 { return "DENY537" }
    if decision == 538 { return "DENY538" }
    if decision == 539 { return "DENY539" }
    if decision == 540 { return "DENY540" }
    "DENY424"
}

fn exec_result_handle_fields() with IO {
    println("LOOM_EXEC_RESULT_HANDLE_FIELDS_V1")
    println("113b0f7d2a1f7adc5b68a92ef37be3689accfe4bbb00cb4e8c15fc3ab7b70013")
    println("1")
    println("5805e6579b6420ba0dd693d385715943955d0e69e657f44e94e23d20a20d27d1")
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = exec_result_decimal_field(raw, 0)
    if ok_schema == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed = loom_exec_result_handle_selftest()
        if failed == 0 {
            println("SOUNIO_EXEC_RESULT_HANDLE_SELFTEST PASS cases=16")
            return 0
        }
        println("SOUNIO_EXEC_RESULT_HANDLE_SELFTEST FAIL")
        return 70
    }
    let (ok_word0, word0, p1) = exec_result_decimal_field(raw, p0)
    let (ok_word1, word1, p2) = exec_result_decimal_field(raw, p1)
    let (ok_word2, word2, p3) = exec_result_decimal_field(raw, p2)
    if ok_schema != 1 || schema != 9033 ||
        ok_word0 != 1 || ok_word1 != 1 || ok_word2 != 1 ||
        word0 < 0 || word0 >= 536870912 ||
        word1 < 0 || word1 >= 33554432 ||
        word2 < 0 || word2 >= 256 || str_char_at(raw, p3) > 0 {
        println("SOUNIO_EXEC_RESULT_HANDLE DENY424 reason=malformed-frame semantic_authority=Sounio action=9033")
        return 42
    }
    let decision = judge_loom_exec_result_handle_v1_words(word0, word1, word2)
    let label = exec_result_decision(decision)
    if decision == 1 {
        println("SOUNIO_EXEC_RESULT_HANDLE PUBLISH semantic_authority=Sounio action=9033")
        exec_result_handle_fields()
        return 0
    }
    if decision == 2 {
        println("SOUNIO_EXEC_RESULT_HANDLE RESOLVE semantic_authority=Sounio action=9033")
        exec_result_handle_fields()
        return 0
    }
    println("SOUNIO_EXEC_RESULT_HANDLE " + label +
        " semantic_authority=Sounio action=9033")
    42
}
