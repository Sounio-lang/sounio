//! Native Sounio adapter for Loom Witness Mesh frame 9013.

fn witness_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 32768 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn witness_digest_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) with Mut, Div, Panic {
    let (ok0, limb0, p0) = witness_decimal_field(raw, start)
    let (ok1, limb1, p1) = witness_decimal_field(raw, p0)
    let (ok2, limb2, p2) = witness_decimal_field(raw, p1)
    let (ok3, limb3, p3) = witness_decimal_field(raw, p2)
    let (ok4, limb4, p4) = witness_decimal_field(raw, p3)
    let (ok5, limb5, p5) = witness_decimal_field(raw, p4)
    let (ok6, limb6, p6) = witness_decimal_field(raw, p5)
    let (ok7, limb7, p7) = witness_decimal_field(raw, p6)
    let valid = ok0 == 1 && ok1 == 1 && ok2 == 1 && ok3 == 1 &&
        ok4 == 1 && ok5 == 1 && ok6 == 1 && ok7 == 1 &&
        limb0 <= 4294967295 && limb1 <= 4294967295 &&
        limb2 <= 4294967295 && limb3 <= 4294967295 &&
        limb4 <= 4294967295 && limb5 <= 4294967295 &&
        limb6 <= 4294967295 && limb7 <= 4294967295
    (if valid { 1 } else { 0 }, limb0, limb1, limb2, limb3,
        limb4, limb5, limb6, limb7, p7)
}

fn main() -> i64 with IO, Mut, Div, LoomWitnessMeshHostTrust, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = witness_decimal_field(raw, 0)
    let (ok_quorum, required_quorum, p1) = witness_decimal_field(raw, p0)
    let (ok_s1, signature1, p2) = witness_decimal_field(raw, p1)
    let (ok_s2, signature2, p3) = witness_decimal_field(raw, p2)
    let (ok_s3, signature3, p4) = witness_decimal_field(raw, p3)
    let (ok_m1, member1, p5) = witness_decimal_field(raw, p4)
    let (ok_m2, member2, p6) = witness_decimal_field(raw, p5)
    let (ok_m3, member3, p7) = witness_decimal_field(raw, p6)
    let (ok_rm1, receipt_member1, p8) = witness_decimal_field(raw, p7)
    let (ok_rm2, receipt_member2, p9) = witness_decimal_field(raw, p8)
    let (ok_rm3, receipt_member3, p10) = witness_decimal_field(raw, p9)
    let (ok_domain, expected_domain, p11) = witness_decimal_field(raw, p10)
    let (ok_rd1, receipt_domain1, p12) = witness_decimal_field(raw, p11)
    let (ok_rd2, receipt_domain2, p13) = witness_decimal_field(raw, p12)
    let (ok_rd3, receipt_domain3, p14) = witness_decimal_field(raw, p13)
    let (ok_prev_seq, previous_anchor_sequence, p15) = witness_decimal_field(raw, p14)
    let (ok_seq, anchor_sequence, p16) = witness_decimal_field(raw, p15)
    let (ok_rs1, receipt_anchor_sequence1, p17) = witness_decimal_field(raw, p16)
    let (ok_rs2, receipt_anchor_sequence2, p18) = witness_decimal_field(raw, p17)
    let (ok_rs3, receipt_anchor_sequence3, p19) = witness_decimal_field(raw, p18)
    let (ok_prev_count, previous_event_count, p20) = witness_decimal_field(raw, p19)
    let (ok_count, event_count, p21) = witness_decimal_field(raw, p20)
    let (ok_rc1, receipt_event_count1, p22) = witness_decimal_field(raw, p21)
    let (ok_rc2, receipt_event_count2, p23) = witness_decimal_field(raw, p22)
    let (ok_rc3, receipt_event_count3, p24) = witness_decimal_field(raw, p23)
    let (ok_membership, a0, a1, a2, a3, a4, a5, a6, a7, p25) =
        witness_digest_field(raw, p24)
    let (ok_membership1, b0, b1, b2, b3, b4, b5, b6, b7, p26) =
        witness_digest_field(raw, p25)
    let (ok_membership2, c0, c1, c2, c3, c4, c5, c6, c7, p27) =
        witness_digest_field(raw, p26)
    let (ok_membership3, d0, d1, d2, d3, d4, d5, d6, d7, p28) =
        witness_digest_field(raw, p27)
    let (ok_head, h0, h1, h2, h3, h4, h5, h6, h7, p29) =
        witness_digest_field(raw, p28)
    let (ok_head1, i0, i1, i2, i3, i4, i5, i6, i7, p30) =
        witness_digest_field(raw, p29)
    let (ok_head2, j0, j1, j2, j3, j4, j5, j6, j7, p31) =
        witness_digest_field(raw, p30)
    let (ok_head3, k0, k1, k2, k3, k4, k5, k6, k7, end_offset) =
        witness_digest_field(raw, p31)
    let parsed = ok_schema == 1 && ok_quorum == 1 && ok_s1 == 1 &&
        ok_s2 == 1 && ok_s3 == 1 && ok_m1 == 1 && ok_m2 == 1 &&
        ok_m3 == 1 && ok_rm1 == 1 && ok_rm2 == 1 && ok_rm3 == 1 &&
        ok_domain == 1 && ok_rd1 == 1 && ok_rd2 == 1 && ok_rd3 == 1 &&
        ok_prev_seq == 1 && ok_seq == 1 && ok_rs1 == 1 && ok_rs2 == 1 &&
        ok_rs3 == 1 && ok_prev_count == 1 && ok_count == 1 &&
        ok_rc1 == 1 && ok_rc2 == 1 && ok_rc3 == 1 &&
        ok_membership == 1 && ok_membership1 == 1 && ok_membership2 == 1 &&
        ok_membership3 == 1 && ok_head == 1 && ok_head1 == 1 &&
        ok_head2 == 1 && ok_head3 == 1 && str_char_at(raw, end_offset) <= 0
    if !parsed || schema != 9013 {
        println("SOUNIO_WITNESS_MESH_REFUSE reason=malformed-frame")
        return 64
    }
    let membership = admit_witness_mesh_digest256(a0, a1, a2, a3, a4, a5, a6, a7)
    let membership1 = admit_witness_mesh_digest256(b0, b1, b2, b3, b4, b5, b6, b7)
    let membership2 = admit_witness_mesh_digest256(c0, c1, c2, c3, c4, c5, c6, c7)
    let membership3 = admit_witness_mesh_digest256(d0, d1, d2, d3, d4, d5, d6, d7)
    let head = admit_witness_mesh_digest256(h0, h1, h2, h3, h4, h5, h6, h7)
    let head1 = admit_witness_mesh_digest256(i0, i1, i2, i3, i4, i5, i6, i7)
    let head2 = admit_witness_mesh_digest256(j0, j1, j2, j3, j4, j5, j6, j7)
    let head3 = admit_witness_mesh_digest256(k0, k1, k2, k3, k4, k5, k6, k7)
    if host_witness_mesh_frame_accepts(
        required_quorum, signature1, signature2, signature3,
        member1, member2, member3,
        receipt_member1, receipt_member2, receipt_member3,
        expected_domain, receipt_domain1, receipt_domain2, receipt_domain3,
        previous_anchor_sequence, anchor_sequence,
        receipt_anchor_sequence1, receipt_anchor_sequence2,
        receipt_anchor_sequence3,
        previous_event_count, event_count,
        receipt_event_count1, receipt_event_count2, receipt_event_count3,
        membership, membership1, membership2, membership3,
        head, head1, head2, head3,
    ) {
        println("SOUNIO_WITNESS_MESH_ACCEPT schema=loom-native-witness-mesh-v0 transition=anchor state=quorum-verified")
        return 0
    }
    println("SOUNIO_WITNESS_MESH_REFUSE reason=checkpoint-policy")
    42
}
