fn main() -> i64 with IO, Mut, Div, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = kernel_peer_material_v13_decimal_field(raw, 0)
    if ok_schema == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        kernel_peer_material_v13_emit_fixtures()
        return 0
    }

    let (ok_stage, stage, p1) = kernel_peer_material_v13_decimal_field(raw, p0)
    let (ok_role, producer_role, p2) = kernel_peer_material_v13_decimal_field(raw, p1)
    let (ok_semantic, producer_semantic_decision, p3) = kernel_peer_material_v13_decimal_field(raw, p2)
    let (ok_observations, observations, p4) = kernel_peer_material_v13_decimal_field(raw, p3)
    let (ok_pairs, decisive_pairs, p5) = kernel_peer_material_v13_decimal_field(raw, p4)
    let (ok_controls, controls, p6) = kernel_peer_material_v13_decimal_field(raw, p5)
    let (ok_refused, refused, p7) = kernel_peer_material_v13_decimal_field(raw, p6)
    let (ok_completed, completed, p8) = kernel_peer_material_v13_decimal_field(raw, p7)
    let (ok_unavailable, unavailable, p9) = kernel_peer_material_v13_decimal_field(raw, p8)
    let (ok_crossed, crossed, p10) = kernel_peer_material_v13_decimal_field(raw, p9)
    let (ok_sabotage, sabotage_twins, p11) = kernel_peer_material_v13_decimal_field(raw, p10)
    let (ok_v12, v12_falsified, p12) = kernel_peer_material_v13_decimal_field(raw, p11)
    let (ok_kuid, same_kuid_pair, p13) = kernel_peer_material_v13_decimal_field(raw, p12)
    let (ok_open, attacker_syscalls_open, p14) = kernel_peer_material_v13_decimal_field(raw, p13)
    let (ok_mediator, receiver_mediator_active, p15) = kernel_peer_material_v13_decimal_field(raw, p14)
    let (ok_extinct, all_epoch_objects_extinct, p16) = kernel_peer_material_v13_decimal_field(raw, p15)
    let (ok_rule, peer_rule_witness, p17) = kernel_peer_material_v13_decimal_field(raw, p16)

    let (ok_semantics, a0, a1, a2, a3, a4, a5, a6, a7, p18) =
        kernel_peer_material_v13_digest_field(raw, p17)
    let (ok_material, b0, b1, b2, b3, b4, b5, b6, b7, p19) =
        kernel_peer_material_v13_digest_field(raw, p18)
    let (ok_pairs_digest, c0, c1, c2, c3, c4, c5, c6, c7, p20) =
        kernel_peer_material_v13_digest_field(raw, p19)
    let (ok_controls_digest, d0, d1, d2, d3, d4, d5, d6, d7, p21) =
        kernel_peer_material_v13_digest_field(raw, p20)
    let (ok_sabotage_digest, e0, e1, e2, e3, e4, e5, e6, e7, p22) =
        kernel_peer_material_v13_digest_field(raw, p21)
    let (ok_host, f0, f1, f2, f3, f4, f5, f6, f7, end_offset) =
        kernel_peer_material_v13_digest_field(raw, p22)

    let parsed = ok_schema == 1 && ok_stage == 1 && ok_role == 1 &&
        ok_semantic == 1 && ok_observations == 1 && ok_pairs == 1 &&
        ok_controls == 1 && ok_refused == 1 && ok_completed == 1 &&
        ok_unavailable == 1 && ok_crossed == 1 && ok_sabotage == 1 &&
        ok_v12 == 1 && ok_kuid == 1 && ok_open == 1 && ok_mediator == 1 &&
        ok_extinct == 1 && ok_rule == 1 && ok_semantics == 1 &&
        ok_material == 1 && ok_pairs_digest == 1 && ok_controls_digest == 1 &&
        ok_sabotage_digest == 1 && ok_host == 1 &&
        str_char_at(raw, end_offset) <= 0
    if !parsed || schema != 1325 {
        println("SOUNIO_PEER_MATERIAL_RECEIPT_DENY code=424 reason=malformed-frame stage=INVALID")
        return 424
    }

    var decision: i64 = 0
    if stage != 6 { decision = 405 }
    if decision == 0 && (producer_role != 2 || producer_semantic_decision != 0) { decision = 459 }
    if decision == 0 && (observations != 50 || decisive_pairs != 10 || controls != 30 || refused != 25 || completed != 15 || unavailable != 10 || crossed != 0 || sabotage_twins != 5 || v12_falsified != 1) { decision = 447 }
    if decision == 0 && (!kernel_peer_material_v13_digest_matches(a0, a1, a2, a3, a4, a5, a6, a7, 3008724357, 216062995, 3372284123, 2970366968, 615261673, 147540552, 3710843155, 644977858) || !kernel_peer_material_v13_digest_matches(b0, b1, b2, b3, b4, b5, b6, b7, 2147352383, 2647951187, 1345229137, 2702704074, 3370799433, 4014437034, 3931477030, 2622796545) || !kernel_peer_material_v13_digest_matches(c0, c1, c2, c3, c4, c5, c6, c7, 3285982463, 3945327090, 327195748, 865121791, 2787365186, 1802465836, 2836245721, 178093724) || !kernel_peer_material_v13_digest_matches(d0, d1, d2, d3, d4, d5, d6, d7, 2466882251, 3042385857, 3429098066, 3045960595, 3926295847, 1625969658, 3394928196, 2614981272) || !kernel_peer_material_v13_digest_matches(e0, e1, e2, e3, e4, e5, e6, e7, 2681053558, 3807227593, 1063071830, 2515283938, 2248878964, 3404892383, 3386482820, 1913294830) || !kernel_peer_material_v13_digest_matches(f0, f1, f2, f3, f4, f5, f6, f7, 2087182567, 1948543970, 443075994, 2384543871, 684384441, 83109956, 749434450, 3018145396)) { decision = 450 }
    if decision == 0 && (same_kuid_pair != 1 || attacker_syscalls_open != 1 || receiver_mediator_active != 1 || all_epoch_objects_extinct != 1 || peer_rule_witness != 1) { decision = 451 }

    if decision != 0 {
        println("SOUNIO_PEER_MATERIAL_RECEIPT_DENY code=" +
            kernel_peer_material_v13_code(decision) + " reason=" +
            kernel_peer_material_v13_reason(decision) + " stage=" +
            kernel_peer_material_v13_stage(stage))
        return decision
    }

    println("SOUNIO_PEER_MATERIAL_RECEIPT_ALLOW code=0 reason=peer-material-certificate-accepted stage=MATERIAL_CONTROL_MATRIX same_uid_peer_isolation=true controls_executed=true material_peer_matrix=true material_coverage=true complete_effects=true material_execution=true action_9025_judged=false")
    println("ACTION_9025_FRAME same_uid_peer_isolation=1 frame=" +
        kernel_peer_material_v13_action_9025_frame())
    0
}
