fn kernel_peer_material_v13_receipt_prefix(
    producer_role: string,
    semantic_decision: string,
    observations: string,
    unavailable: string,
    crossed: string,
    same_kuid: string,
    syscalls_open: string,
    mediator_active: string,
    all_extinct: string,
    peer_rule_witness: string,
) -> string {
    "1325 6 " + producer_role + " " + semantic_decision + " " +
        observations + " 10 30 25 15 " + unavailable + " " + crossed +
        " 5 1 " + same_kuid + " " + syscalls_open + " " +
        mediator_active + " " + all_extinct + " " + peer_rule_witness + " "
}

fn kernel_peer_material_v13_receipt_suffix(
    semantic0: string,
    material0: string,
    pair0: string,
    control0: string,
    sabotage0: string,
    host0: string,
) -> string {
    let semantic_tail = "216062995 3372284123 2970366968 615261673 147540552 3710843155 644977858"
    let material_tail = "2647951187 1345229137 2702704074 3370799433 4014437034 3931477030 2622796545"
    let pair_tail = "3945327090 327195748 865121791 2787365186 1802465836 2836245721 178093724"
    let control_tail = "3042385857 3429098066 3045960595 3926295847 1625969658 3394928196 2614981272"
    let sabotage_tail = "3807227593 1063071830 2515283938 2248878964 3404892383 3386482820 1913294830"
    let host_tail = "1948543970 443075994 2384543871 684384441 83109956 749434450 3018145396"
    semantic0 + " " + semantic_tail + " " +
        material0 + " " + material_tail + " " +
        pair0 + " " + pair_tail + " " +
        control0 + " " + control_tail + " " +
        sabotage0 + " " + sabotage_tail + " " +
        host0 + " " + host_tail
}

fn kernel_peer_material_v13_emit_fixtures() with IO {
    let prefix = kernel_peer_material_v13_receipt_prefix(
        "2", "0", "50", "10", "0", "1", "1", "1", "1", "1")
    let suffix = kernel_peer_material_v13_receipt_suffix(
        "3008724357", "2147352383", "3285982463", "2466882251",
        "2681053558", "2087182567")
    println("LOOM_KERNEL_PEER_MATERIAL_JUDGMENT_V13 producer=Sounio role=SEMANTIC_AUTHORITY semantic_authority=Sounio action=9025 semantic_manifest_sha256=b3557d850ce0dc13c900f8dbb10c33f824ac25e908cb4a48dd2ef913267194c2 material_manifest_sha256=7ffdff3f9dd48753502e9151a117fdcac8ea5149ef4772aaea5594269c54b301 cases=14")
    println("CASE label=accepted EXPECT code=0 FRAME " + prefix + suffix)
    println("CASE label=missing_observation EXPECT code=447 FRAME " +
        kernel_peer_material_v13_receipt_prefix("2", "0", "49", "10", "0", "1", "1", "1", "1", "1") + suffix)
    println("CASE label=unavailable_drift EXPECT code=447 FRAME " +
        kernel_peer_material_v13_receipt_prefix("2", "0", "50", "9", "0", "1", "1", "1", "1", "1") + suffix)
    println("CASE label=crossed_rule EXPECT code=447 FRAME " +
        kernel_peer_material_v13_receipt_prefix("2", "0", "50", "10", "1", "1", "1", "1", "1", "1") + suffix)
    println("CASE label=authority_laundering EXPECT code=459 FRAME " +
        kernel_peer_material_v13_receipt_prefix("3", "1", "50", "10", "0", "1", "1", "1", "1", "1") + suffix)
    println("CASE label=python_oracle EXPECT code=459 FRAME " +
        kernel_peer_material_v13_receipt_prefix("9", "0", "50", "10", "0", "1", "1", "1", "1", "1") + suffix)
    println("CASE label=semantic_substitution EXPECT code=450 FRAME " + prefix +
        kernel_peer_material_v13_receipt_suffix("3008724358", "2147352383", "3285982463", "2466882251", "2681053558", "2087182567"))
    println("CASE label=material_substitution EXPECT code=450 FRAME " + prefix +
        kernel_peer_material_v13_receipt_suffix("3008724357", "2147352384", "3285982463", "2466882251", "2681053558", "2087182567"))
    println("CASE label=pair_substitution EXPECT code=450 FRAME " + prefix +
        kernel_peer_material_v13_receipt_suffix("3008724357", "2147352383", "3285982464", "2466882251", "2681053558", "2087182567"))
    println("CASE label=control_substitution EXPECT code=450 FRAME " + prefix +
        kernel_peer_material_v13_receipt_suffix("3008724357", "2147352383", "3285982463", "2466882252", "2681053558", "2087182567"))
    println("CASE label=sabotage_substitution EXPECT code=450 FRAME " + prefix +
        kernel_peer_material_v13_receipt_suffix("3008724357", "2147352383", "3285982463", "2466882251", "2681053559", "2087182567"))
    println("CASE label=host_result_substitution EXPECT code=450 FRAME " + prefix +
        kernel_peer_material_v13_receipt_suffix("3008724357", "2147352383", "3285982463", "2466882251", "2681053558", "2087182568"))
    println("CASE label=receiver_missing EXPECT code=451 FRAME " +
        kernel_peer_material_v13_receipt_prefix("2", "0", "50", "10", "0", "1", "1", "0", "1", "1") + suffix)
    println("CASE label=peer_rule_sabotaged EXPECT code=451 FRAME " +
        kernel_peer_material_v13_receipt_prefix("2", "0", "50", "10", "0", "1", "1", "1", "1", "0") + suffix)
    println("EXPECTED_ACTION_9025 decision=ALLOW reason=allow same_uid_peer_isolation=true material_coverage=true complete_effects=true material_execution=true production_activation=false launch_open=false recycle_open=false exec_attached=false commit_attached=false ci_attached=false claim_ready=false")
