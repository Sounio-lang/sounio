//! Sounio authority transition from the frozen V13 peer matrix to action 9025.

fn kernel_peer_material_v13_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn kernel_peer_material_v13_digest_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) with Mut, Div, Panic {
    let (ok0, limb0, p0) = kernel_peer_material_v13_decimal_field(raw, start)
    let (ok1, limb1, p1) = kernel_peer_material_v13_decimal_field(raw, p0)
    let (ok2, limb2, p2) = kernel_peer_material_v13_decimal_field(raw, p1)
    let (ok3, limb3, p3) = kernel_peer_material_v13_decimal_field(raw, p2)
    let (ok4, limb4, p4) = kernel_peer_material_v13_decimal_field(raw, p3)
    let (ok5, limb5, p5) = kernel_peer_material_v13_decimal_field(raw, p4)
    let (ok6, limb6, p6) = kernel_peer_material_v13_decimal_field(raw, p5)
    let (ok7, limb7, p7) = kernel_peer_material_v13_decimal_field(raw, p6)
    let valid = ok0 == 1 && ok1 == 1 && ok2 == 1 && ok3 == 1 &&
        ok4 == 1 && ok5 == 1 && ok6 == 1 && ok7 == 1 &&
        limb0 <= 4294967295 && limb1 <= 4294967295 &&
        limb2 <= 4294967295 && limb3 <= 4294967295 &&
        limb4 <= 4294967295 && limb5 <= 4294967295 &&
        limb6 <= 4294967295 && limb7 <= 4294967295
    (if valid { 1 } else { 0 }, limb0, limb1, limb2, limb3,
        limb4, limb5, limb6, limb7, p7)
}

fn kernel_peer_material_v13_digest_matches(
    a0: i64, a1: i64, a2: i64, a3: i64,
    a4: i64, a5: i64, a6: i64, a7: i64,
    e0: i64, e1: i64, e2: i64, e3: i64,
    e4: i64, e5: i64, e6: i64, e7: i64,
) -> bool {
    a0 == e0 && a1 == e1 && a2 == e2 && a3 == e3 &&
        a4 == e4 && a5 == e5 && a6 == e6 && a7 == e7
}

fn kernel_peer_material_v13_reason(decision: i64) -> string {
    if decision == 0 { return "peer-material-certificate-accepted" }
    if decision == 405 { return "wrong-stage" }
    if decision == 447 { return "material-coverage-incomplete" }
    if decision == 450 { return "provenance-incomplete" }
    if decision == 451 { return "same-uid-peer-isolation-unproven" }
    if decision == 459 { return "material-authority-laundering" }
    "malformed-frame"
}

fn kernel_peer_material_v13_code(decision: i64) -> string {
    if decision == 0 { return "0" }
    if decision == 405 { return "405" }
    if decision == 447 { return "447" }
    if decision == 450 { return "450" }
    if decision == 451 { return "451" }
    if decision == 459 { return "459" }
    "424"
}

fn kernel_peer_material_v13_stage(stage: i64) -> string {
    if stage == 6 { return "MATERIAL_CONTROL_MATRIX" }
    "INVALID"
}

