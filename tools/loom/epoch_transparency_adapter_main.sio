//! Native Sounio adapter for Loom epoch transparency frame 9016.

fn transparency_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn transparency_digest_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64)
    with Mut, Div, Panic {
    let (ok0, limb0, p0) = transparency_decimal_field(raw, start)
    let (ok1, limb1, p1) = transparency_decimal_field(raw, p0)
    let (ok2, limb2, p2) = transparency_decimal_field(raw, p1)
    let (ok3, limb3, p3) = transparency_decimal_field(raw, p2)
    let (ok4, limb4, p4) = transparency_decimal_field(raw, p3)
    let (ok5, limb5, p5) = transparency_decimal_field(raw, p4)
    let (ok6, limb6, p6) = transparency_decimal_field(raw, p5)
    let (ok7, limb7, p7) = transparency_decimal_field(raw, p6)
    let valid = ok0 == 1 && ok1 == 1 && ok2 == 1 && ok3 == 1 &&
        ok4 == 1 && ok5 == 1 && ok6 == 1 && ok7 == 1 &&
        limb0 <= 4294967295 && limb1 <= 4294967295 &&
        limb2 <= 4294967295 && limb3 <= 4294967295 &&
        limb4 <= 4294967295 && limb5 <= 4294967295 &&
        limb6 <= 4294967295 && limb7 <= 4294967295
    (if valid { 1 } else { 0 }, limb0, limb1, limb2, limb3,
        limb4, limb5, limb6, limb7, p7)
}

fn main() -> i64 with IO, Mut, Div, LoomWitnessEpochTransparencyHostTrust, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = transparency_decimal_field(raw, 0)
    let (ok_handoff, handoff_verified, p1) = transparency_decimal_field(raw, p0)
    let (ok_reachable, log_reachable, p2) = transparency_decimal_field(raw, p1)
    let (ok_operator_sig, operator_sig, p3) = transparency_decimal_field(raw, p2)
    let (ok_inclusion, inclusion, p4) = transparency_decimal_field(raw, p3)
    let (ok_consistency, consistency, p5) = transparency_decimal_field(raw, p4)
    let (ok_recomputed, recomputed, p6) = transparency_decimal_field(raw, p5)
    let (ok_order, order_verified, p7) = transparency_decimal_field(raw, p6)
    let (ok_latest, latest_verified, p8) = transparency_decimal_field(raw, p7)
    let (ok_quorum, quorum_verified, p9) = transparency_decimal_field(raw, p8)
    let (ok_required, required_quorum, p10) = transparency_decimal_field(raw, p9)
    let (ok_members, member_count, p11) = transparency_decimal_field(raw, p10)
    let (ok_from, from_epoch, p12) = transparency_decimal_field(raw, p11)
    let (ok_to, to_epoch, p13) = transparency_decimal_field(raw, p12)
    let (ok_previous_size, previous_size, p14) = transparency_decimal_field(raw, p13)
    let (ok_current_size, current_size, p15) = transparency_decimal_field(raw, p14)
    let (ok_active_index, active_index, p16) = transparency_decimal_field(raw, p15)
    let (ok_anchor, anchor_sequence, p17) = transparency_decimal_field(raw, p16)
    let (ok_journal_count, journal_count, p18) = transparency_decimal_field(raw, p17)
    let (ok_operator_token, operator_token, p19) = transparency_decimal_field(raw, p18)
    let (ok_local_token, local_token, p20) = transparency_decimal_field(raw, p19)
    let (ok_member1, member1, p21) = transparency_decimal_field(raw, p20)
    let (ok_member2, member2, p22) = transparency_decimal_field(raw, p21)
    let (ok_member3, member3, p23) = transparency_decimal_field(raw, p22)
    let (ok_member4, member4, p24) = transparency_decimal_field(raw, p23)
    let (ok_handoff_digest, a0, a1, a2, a3, a4, a5, a6, a7, p25) =
        transparency_digest_field(raw, p24)
    let (ok_leaf_handoff, b0, b1, b2, b3, b4, b5, b6, b7, p26) =
        transparency_digest_field(raw, p25)
    let (ok_previous_handoff, c0, c1, c2, c3, c4, c5, c6, c7, p27) =
        transparency_digest_field(raw, p26)
    let (ok_leaf_previous, d0, d1, d2, d3, d4, d5, d6, d7, p28) =
        transparency_digest_field(raw, p27)
    let (ok_previous_root, e0, e1, e2, e3, e4, e5, e6, e7, p29) =
        transparency_digest_field(raw, p28)
    let (ok_recomputed_previous, f0, f1, f2, f3, f4, f5, f6, f7, p30) =
        transparency_digest_field(raw, p29)
    let (ok_current_root, g0, g1, g2, g3, g4, g5, g6, g7, p31) =
        transparency_digest_field(raw, p30)
    let (ok_recomputed_current, h0, h1, h2, h3, h4, h5, h6, h7, p32) =
        transparency_digest_field(raw, p31)
    let (ok_journal_head, i0, i1, i2, i3, i4, i5, i6, i7, p33) =
        transparency_digest_field(raw, p32)
    let (ok_certificate, j0, j1, j2, j3, j4, j5, j6, j7, p34) =
        transparency_digest_field(raw, p33)
    let (ok_membership, k0, k1, k2, k3, k4, k5, k6, k7, p35) =
        transparency_digest_field(raw, p34)
    let (ok_operator_key, l0, l1, l2, l3, l4, l5, l6, l7, end_offset) =
        transparency_digest_field(raw, p35)
    let parsed = ok_schema == 1 && ok_handoff == 1 && ok_reachable == 1 &&
        ok_operator_sig == 1 && ok_inclusion == 1 && ok_consistency == 1 &&
        ok_recomputed == 1 && ok_order == 1 && ok_latest == 1 &&
        ok_quorum == 1 && ok_required == 1 && ok_members == 1 &&
        ok_from == 1 && ok_to == 1 && ok_previous_size == 1 &&
        ok_current_size == 1 && ok_active_index == 1 && ok_anchor == 1 &&
        ok_journal_count == 1 && ok_operator_token == 1 &&
        ok_local_token == 1 && ok_member1 == 1 && ok_member2 == 1 &&
        ok_member3 == 1 && ok_member4 == 1 && ok_handoff_digest == 1 &&
        ok_leaf_handoff == 1 && ok_previous_handoff == 1 &&
        ok_leaf_previous == 1 && ok_previous_root == 1 &&
        ok_recomputed_previous == 1 && ok_current_root == 1 &&
        ok_recomputed_current == 1 && ok_journal_head == 1 &&
        ok_certificate == 1 && ok_membership == 1 && ok_operator_key == 1 &&
        str_char_at(raw, end_offset) <= 0
    if !parsed || schema != 9016 {
        println("SOUNIO_WITNESS_EPOCH_TRANSPARENCY_REFUSE reason=malformed-frame")
        return 64
    }
    let handoff_digest = admit_epoch_transparency_digest256(a0, a1, a2, a3, a4, a5, a6, a7)
    let leaf_handoff = admit_epoch_transparency_digest256(b0, b1, b2, b3, b4, b5, b6, b7)
    let previous_handoff = admit_epoch_transparency_digest256(c0, c1, c2, c3, c4, c5, c6, c7)
    let leaf_previous = admit_epoch_transparency_digest256(d0, d1, d2, d3, d4, d5, d6, d7)
    let previous_root = admit_epoch_transparency_digest256(e0, e1, e2, e3, e4, e5, e6, e7)
    let recomputed_previous = admit_epoch_transparency_digest256(f0, f1, f2, f3, f4, f5, f6, f7)
    let current_root = admit_epoch_transparency_digest256(g0, g1, g2, g3, g4, g5, g6, g7)
    let recomputed_current = admit_epoch_transparency_digest256(h0, h1, h2, h3, h4, h5, h6, h7)
    let journal_head = admit_epoch_transparency_digest256(i0, i1, i2, i3, i4, i5, i6, i7)
    let certificate = admit_epoch_transparency_digest256(j0, j1, j2, j3, j4, j5, j6, j7)
    let membership = admit_epoch_transparency_digest256(k0, k1, k2, k3, k4, k5, k6, k7)
    let operator_key = admit_epoch_transparency_digest256(l0, l1, l2, l3, l4, l5, l6, l7)
    if host_epoch_transparency_frame_accepts(
        handoff_verified, log_reachable, operator_sig,
        inclusion, consistency, recomputed, order_verified, latest_verified,
        quorum_verified, required_quorum, member_count,
        from_epoch, to_epoch, previous_size, current_size, active_index,
        anchor_sequence, journal_count, operator_token, local_token,
        member1, member2, member3, member4,
        handoff_digest, leaf_handoff, previous_handoff, leaf_previous,
        previous_root, recomputed_previous, current_root, recomputed_current,
        journal_head, certificate, membership, operator_key,
    ) {
        println("SOUNIO_WITNESS_EPOCH_TRANSPARENCY_ACCEPT schema=loom-native-witness-epoch-transparency-v0 rollback_bound=latest-quorum-witnessed-epoch state=verified")
        return 0
    }
    println("SOUNIO_WITNESS_EPOCH_TRANSPARENCY_REFUSE reason=transparency-policy")
    42
}
