//! Executable adapter for LOOM routing-authority action 9032.

fn routing_decimal_field(raw: string, start: i64) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) { return (0, 0, offset) }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn routing_code(value: i64) -> string {
    if value == 0 { return "0" }
    if value == 601 { return "601" }
    if value == 602 { return "602" }
    if value == 603 { return "603" }
    if value == 604 { return "604" }
    if value == 605 { return "605" }
    if value == 606 { return "606" }
    if value == 607 { return "607" }
    if value == 608 { return "608" }
    if value == 609 { return "609" }
    if value == 610 { return "610" }
    if value == 611 { return "611" }
    if value == 612 { return "612" }
    if value == 613 { return "613" }
    if value == 614 { return "614" }
    if value == 615 { return "615" }
    if value == 616 { return "616" }
    if value == 617 { return "617" }
    if value == 618 { return "618" }
    if value == 619 { return "619" }
    if value == 620 { return "620" }
    if value == 621 { return "621" }
    if value == 622 { return "622" }
    "623"
}

fn routing_reason(value: i64) -> string {
    if value == 601 { return "policy-missing" }
    if value == 602 { return "policy-timeout" }
    if value == 603 { return "policy-error" }
    if value == 604 { return "wrong-stage-or-operation" }
    if value == 605 { return "malformed-frame" }
    if value == 606 { return "authority-binding-missing" }
    if value == 607 { return "ownership-block" }
    if value == 608 { return "quota-unknown" }
    if value == 609 { return "quota-estimate-forbidden" }
    if value == 610 { return "pool-degraded" }
    if value == 611 { return "quota-exhausted" }
    if value == 612 { return "pool-auth-required" }
    if value == 613 { return "adapter-broken" }
    if value == 614 { return "adapter-missing" }
    if value == 615 { return "adapter-auth-required" }
    if value == 616 { return "model-unavailable" }
    if value == 617 { return "language-role-forbidden" }
    if value == 618 { return "predecessor-chain-open" }
    if value == 619 { return "plan-decision-invalid" }
    if value == 620 { return "provider-plan-unbound" }
    if value == 621 { return "execution-grant-missing" }
    if value == 622 { return "receipt-destination-unbound" }
    if value == 623 { return "review-promoted" }
    "allow"
}

var ROUTING_AUTHORITY_LINE_BUFFER: [i8; 4096] = [0; 4096]

fn routing_authority_read_full_line() -> string with IO, Mut {
    var length: i64 = 0
    var byte = read_byte()
    while byte >= 0 && byte != 10 && length < 4095 {
        ROUTING_AUTHORITY_LINE_BUFFER[length as usize] = byte as i8
        length = length + 1
        byte = read_byte()
    }
    ROUTING_AUTHORITY_LINE_BUFFER[length as usize] = 0
    str_from_bytes(ROUTING_AUTHORITY_LINE_BUFFER, length)
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let raw = routing_authority_read_full_line()
    let (o0, schema, p0) = routing_decimal_field(raw, 0)
    if o0 == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed = loom_routing_authority_selftest()
        if failed == 0 {
            println("SOUNIO_ROUTING_AUTHORITY_SELFTEST PASS cases=29")
            return 0
        }
        println("SOUNIO_ROUTING_AUTHORITY_SELFTEST FAIL case=" + routing_code(failed))
        return 70
    }
    let (o1, stage, p1) = routing_decimal_field(raw, p0)
    let (o2, operation, p2) = routing_decimal_field(raw, p1)
    let (o3, policy, p3) = routing_decimal_field(raw, p2)
    let (o4, config_frozen, p4) = routing_decimal_field(raw, p3)
    let (o5, config_bound, p5) = routing_decimal_field(raw, p4)
    let (o6, task_bound, p6) = routing_decimal_field(raw, p5)
    let (o7, candidate_bound, p7) = routing_decimal_field(raw, p6)
    let (o8, observation_authority, p8) = routing_decimal_field(raw, p7)
    let (o9, sample_fresh, p9) = routing_decimal_field(raw, p8)
    let (o10, candidate_index, p10) = routing_decimal_field(raw, p9)
    let (o11, predecessor_chain_bound, p11) = routing_decimal_field(raw, p10)
    let (o12, predecessor_denials_complete, p12) = routing_decimal_field(raw, p11)
    let (o13, ownership_state, p13) = routing_decimal_field(raw, p12)
    let (o14, quota_state, p14) = routing_decimal_field(raw, p13)
    let (o15, allow_estimated, p15) = routing_decimal_field(raw, p14)
    let (o16, pool_health, p16) = routing_decimal_field(raw, p15)
    let (o17, adapter_health, p17) = routing_decimal_field(raw, p16)
    let (o18, model_available, p18) = routing_decimal_field(raw, p17)
    let (o19, operational_language, p19) = routing_decimal_field(raw, p18)
    let (o20, operational_role, p20) = routing_decimal_field(raw, p19)
    let (o21, provider_language, p21) = routing_decimal_field(raw, p20)
    let (o22, provider_role, p22) = routing_decimal_field(raw, p21)
    let (o23, review_promoted, p23) = routing_decimal_field(raw, p22)
    let (o24, plan_bound, p24) = routing_decimal_field(raw, p23)
    let (o25, plan_fresh, p25) = routing_decimal_field(raw, p24)
    let (o26, plan_match, p26) = routing_decimal_field(raw, p25)
    let (o27, provider_plan_bound, p27) = routing_decimal_field(raw, p26)
    let (o28, exec_grant, p28) = routing_decimal_field(raw, p27)
    let (o29, receipt_bound, end_offset) = routing_decimal_field(raw, p28)
    let parsed = o0==1 && o1==1 && o2==1 && o3==1 && o4==1 && o5==1 &&
        o6==1 && o7==1 && o8==1 && o9==1 && o10==1 && o11==1 &&
        o12==1 && o13==1 && o14==1 && o15==1 && o16==1 && o17==1 &&
        o18==1 && o19==1 && o20==1 && o21==1 && o22==1 && o23==1 &&
        o24==1 && o25==1 && o26==1 && o27==1 && o28==1 && o29==1 &&
        str_char_at(raw, end_offset) <= 0
    if !parsed || schema != 9032 {
        println("SOUNIO_ROUTING_AUTHORITY_DENY code=605 reason=malformed-frame authority=Sounio")
        return 93
    }
    let decision = loom_routing_authority_decide(
        stage, operation, policy, config_frozen, config_bound, task_bound,
        candidate_bound, observation_authority, sample_fresh, candidate_index,
        predecessor_chain_bound, predecessor_denials_complete, ownership_state,
        quota_state, allow_estimated, pool_health, adapter_health,
        model_available, operational_language, operational_role,
        provider_language, provider_role, review_promoted, plan_bound,
        plan_fresh, plan_match, provider_plan_bound, exec_grant, receipt_bound,
    )
    if decision == 0 {
        println("SOUNIO_ROUTING_AUTHORITY_ALLOW code=0 reason=allow authority=Sounio candidate=" + routing_code(candidate_index))
        return 0
    }
    println("SOUNIO_ROUTING_AUTHORITY_DENY code=" + routing_code(decision) +
        " reason=" + routing_reason(decision) + " authority=Sounio")
    0
}
