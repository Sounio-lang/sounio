# Install as /etc/sounio/loom-principal-broker.conf, owned root:root, mode 0600.
LOOM_PRINCIPAL_MANIFEST=/usr/lib/sounio/loom/kernel_principal_lease_authority.freeze.v1
LOOM_PRINCIPAL_AUTHORITY=/usr/libexec/sounio/sounio-loom-kernel-principal-lease-authority-runtime
LOOM_PRINCIPAL_CAPSULE_MANIFEST=/usr/lib/sounio/loom/kernel_principal_capsule_authority.freeze.v1
LOOM_PRINCIPAL_CAPSULE_AUTHORITY=/usr/libexec/sounio/sounio-loom-kernel-principal-capsule-authority-runtime
LOOM_PRINCIPAL_INVOCATION_MANIFEST=/usr/lib/sounio/loom/kernel_invocation_cell_authority.freeze.v1
LOOM_PRINCIPAL_INVOCATION_AUTHORITY=/usr/libexec/sounio/sounio-loom-kernel-invocation-cell-authority-runtime
LOOM_PRINCIPAL_EXEC_GRANT_MANIFEST=/usr/lib/sounio/loom/kernel_exec_grant_cell_authority.freeze.v1
LOOM_PRINCIPAL_RESIDENT_MANIFEST=/usr/lib/sounio/loom/resident_membrane.runtime.v4
LOOM_PRINCIPAL_RESIDENT_RUNTIME=/usr/libexec/sounio/sounio-loom-resident-membrane-runtime-v4
LOOM_PRINCIPAL_JOURNAL=/var/lib/sounio/loom-principal-broker/leases.v1
