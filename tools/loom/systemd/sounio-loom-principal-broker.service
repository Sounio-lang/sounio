[Unit]
Description=Sounio LOOM host kernel-principal broker
Documentation=file:/usr/share/doc/sounio/loom/HOST_KERNEL_PRINCIPAL_BROKER_BOOTSTRAP_V1.md
Requires=sounio-loom-principal-broker.socket
After=local-fs.target sounio-loom-principal-broker.socket

[Service]
Type=simple
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/sounio/loom-principal-broker.conf
ExecStart=/usr/libexec/sounio/loom-kernel-principal-broker --serve --manifest ${LOOM_PRINCIPAL_MANIFEST} --authority ${LOOM_PRINCIPAL_AUTHORITY} --journal ${LOOM_PRINCIPAL_JOURNAL} --socket-path /run/sounio/loom-principal-broker.sock
Restart=on-failure
RestartSec=2s
KillMode=mixed
TimeoutStopSec=15s
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_SYS_ADMIN CAP_KILL CAP_CHOWN CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_SETUID CAP_SETGID CAP_SYS_ADMIN CAP_KILL CAP_CHOWN CAP_DAC_OVERRIDE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=no
Delegate=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
StateDirectory=sounio/loom-principal-broker
StateDirectoryMode=0700
ReadWritePaths=/var/lib/sounio/loom-principal-broker /run/sounio

[Install]
WantedBy=multi-user.target
