//! Packed executable adapter for LOOM action 9044.

fn material_decimal_field(raw: string, start: i64) -> (i64, i64, i64) with Mut, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn material_decision(decision: i64) -> string {
    if decision == 1 { return "MATERIAL_PREPARED" }
    if decision == 2 { return "MATERIAL_CONSUMED" }
    if decision == 3 { return "COMMIT_ADMIT" }
    if decision == 4 { return "CI_ADMIT" }
    if decision == 5 { return "CLAIM_READY" }
    if decision == 631 { return "DENY631" }
    if decision == 632 { return "DENY632" }
    if decision == 633 { return "DENY633" }
    if decision == 634 { return "DENY634" }
    if decision == 635 { return "DENY635" }
    if decision == 636 { return "DENY636" }
    if decision == 637 { return "DENY637" }
    if decision == 638 { return "DENY638" }
    if decision == 639 { return "DENY639" }
    if decision == 640 { return "DENY640" }
    if decision == 641 { return "DENY641" }
    "DENY424"
}

fn main() -> i64 with IO, Mut, Panic {
    let raw = read_line()
    let (o0, schema, p0) = material_decimal_field(raw, 0)
    if o0 == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed = loom_sovereign_material_change_selftest()
        if failed == 0 {
            println("SOUNIO_SOVEREIGN_MATERIAL_CHANGE_SELFTEST PASS cases=8")
            return 0
        }
        println("SOUNIO_SOVEREIGN_MATERIAL_CHANGE_SELFTEST FAIL")
        return 70
    }
    let (o1, mode, p1) = material_decimal_field(raw, p0)
    let (o2, stage, p2) = material_decimal_field(raw, p1)
    let (o3, word, p3) = material_decimal_field(raw, p2)
    let (o4, descriptor0, p4) = material_decimal_field(raw, p3)
    let (o5, descriptor1, p5) = material_decimal_field(raw, p4)
    let (o6, descriptor2, p6) = material_decimal_field(raw, p5)
    let (o7, descriptor3, p7) = material_decimal_field(raw, p6)
    let (o8, sabotage_count, p8) = material_decimal_field(raw, p7)
    let (o9, sabotage_required, p9) = material_decimal_field(raw, p8)
    if o0 != 1 || schema != 9044 || o1 != 1 || o2 != 1 || o3 != 1 ||
        o4 != 1 || o5 != 1 || o6 != 1 || o7 != 1 || o8 != 1 || o9 != 1 ||
        mode < 1 || mode > 5 || stage < 0 || word < 0 ||
        sabotage_count < 0 || sabotage_required < 0 || str_char_at(raw, p9) > 0 {
        println("SOUNIO_SOVEREIGN_MATERIAL_CHANGE DENY424 reason=malformed-frame semantic_authority=Sounio action=9044")
        return 42
    }
    let decision = judge_loom_sovereign_material_change_words(
        mode, stage, word, descriptor0, descriptor1, descriptor2, descriptor3,
        sabotage_count, sabotage_required,
    )
    println("SOUNIO_SOVEREIGN_MATERIAL_CHANGE " + material_decision(decision) +
        " semantic_authority=Sounio action=9044")
    if decision >= 1 && decision <= 5 { return 0 }
    42
}
