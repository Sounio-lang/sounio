//! Native Sounio adapter for Loom outcome-authority frame 9012.

fn authority_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 32768 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn authority_digest_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) with Mut, Div, Panic {
    let (ok0, limb0, p0) = authority_decimal_field(raw, start)
    let (ok1, limb1, p1) = authority_decimal_field(raw, p0)
    let (ok2, limb2, p2) = authority_decimal_field(raw, p1)
    let (ok3, limb3, p3) = authority_decimal_field(raw, p2)
    let (ok4, limb4, p4) = authority_decimal_field(raw, p3)
    let (ok5, limb5, p5) = authority_decimal_field(raw, p4)
    let (ok6, limb6, p6) = authority_decimal_field(raw, p5)
    let (ok7, limb7, p7) = authority_decimal_field(raw, p6)
    let valid = ok0 == 1 && ok1 == 1 && ok2 == 1 && ok3 == 1 &&
        ok4 == 1 && ok5 == 1 && ok6 == 1 && ok7 == 1 &&
        limb0 <= 4294967295 && limb1 <= 4294967295 &&
        limb2 <= 4294967295 && limb3 <= 4294967295 &&
        limb4 <= 4294967295 && limb5 <= 4294967295 &&
        limb6 <= 4294967295 && limb7 <= 4294967295
    (if valid { 1 } else { 0 }, limb0, limb1, limb2, limb3,
        limb4, limb5, limb6, limb7, p7)
}

fn main() -> i64 with IO, Mut, Div, LoomOutcomeAuthorityHostTrust, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = authority_decimal_field(raw, 0)
    let (ok_ms, measurement_signature_verified, p1) = authority_decimal_field(raw, p0)
    let (ok_cs, classification_signature_verified, p2) = authority_decimal_field(raw, p1)
    let (ok_policy, policy_token, p3) = authority_decimal_field(raw, p2)
    let (ok_selected, selected_policy_token, p4) = authority_decimal_field(raw, p3)
    let (ok_action, current_action_token, p5) = authority_decimal_field(raw, p4)
    let (ok_path, current_path_token, p6) = authority_decimal_field(raw, p5)
    let (ok_outcome, outcome_token, p7) = authority_decimal_field(raw, p6)
    let (ok_owner, owner_token, p8) = authority_decimal_field(raw, p7)
    let (ok_generation, generation_token, p9) = authority_decimal_field(raw, p8)
    let (ok_head, journal_head_token, p10) = authority_decimal_field(raw, p9)
    let (ok_mp, measurement_principal_token, p11) = authority_decimal_field(raw, p10)
    let (ok_cp, classifier_principal_token, p12) = authority_decimal_field(raw, p11)
    let (ok_mk, measurement_key_token, p13) = authority_decimal_field(raw, p12)
    let (ok_ck, classifier_key_token, p14) = authority_decimal_field(raw, p13)
    let (ok_m_policy, measurement_policy_token, p15) = authority_decimal_field(raw, p14)
    let (ok_m_selected, measurement_selected_policy_token, p16) = authority_decimal_field(raw, p15)
    let (ok_m_action, measurement_action_token, p17) = authority_decimal_field(raw, p16)
    let (ok_m_path, measurement_path_token, p18) = authority_decimal_field(raw, p17)
    let (ok_m_generation, measurement_generation_token, p19) = authority_decimal_field(raw, p18)
    let (ok_m_head, measurement_journal_head_token, p20) = authority_decimal_field(raw, p19)
    let (ok_m_nonce, measurement_nonce_token, p21) = authority_decimal_field(raw, p20)
    let (ok_c_policy, classification_policy_token, p22) = authority_decimal_field(raw, p21)
    let (ok_c_selected, classification_selected_policy_token, p23) = authority_decimal_field(raw, p22)
    let (ok_c_action, classification_action_token, p24) = authority_decimal_field(raw, p23)
    let (ok_c_path, classification_path_token, p25) = authority_decimal_field(raw, p24)
    let (ok_c_outcome, classification_outcome_token, p26) = authority_decimal_field(raw, p25)
    let (ok_c_generation, classification_generation_token, p27) = authority_decimal_field(raw, p26)
    let (ok_c_head, classification_journal_head_token, p28) = authority_decimal_field(raw, p27)
    let (ok_c_nonce, classification_nonce_token, p29) = authority_decimal_field(raw, p28)
    let (ok_measurement, m0, m1, m2, m3, m4, m5, m6, m7, p30) =
        authority_digest_field(raw, p29)
    let (ok_measurement_receipt, r0, r1, r2, r3, r4, r5, r6, r7, p31) =
        authority_digest_field(raw, p30)
    let (ok_classifier_subject, u0, u1, u2, u3, u4, u5, u6, u7, p32) =
        authority_digest_field(raw, p31)
    let (ok_spec, s0, s1, s2, s3, s4, s5, s6, s7, p33) =
        authority_digest_field(raw, p32)
    let (ok_claimed_spec, t0, t1, t2, t3, t4, t5, t6, t7, p34) =
        authority_digest_field(raw, p33)
    let (ok_partition, a0, a1, a2, a3, a4, a5, a6, a7, p35) =
        authority_digest_field(raw, p34)
    let (ok_claimed_partition, b0, b1, b2, b3, b4, b5, b6, b7, p36) =
        authority_digest_field(raw, p35)
    let (ok_classification, c0, c1, c2, c3, c4, c5, c6, c7, end_offset) =
        authority_digest_field(raw, p36)
    let parsed = ok_schema == 1 && ok_ms == 1 && ok_cs == 1 &&
        ok_policy == 1 && ok_selected == 1 && ok_action == 1 &&
        ok_path == 1 && ok_outcome == 1 && ok_owner == 1 &&
        ok_generation == 1 && ok_head == 1 && ok_mp == 1 && ok_cp == 1 && ok_mk == 1 &&
        ok_ck == 1 && ok_m_policy == 1 && ok_m_selected == 1 &&
        ok_m_action == 1 && ok_m_path == 1 && ok_m_generation == 1 && ok_m_head == 1 &&
        ok_m_nonce == 1 && ok_c_policy == 1 && ok_c_selected == 1 &&
        ok_c_action == 1 && ok_c_path == 1 && ok_c_outcome == 1 &&
        ok_c_generation == 1 && ok_c_head == 1 && ok_c_nonce == 1 && ok_measurement == 1 &&
        ok_measurement_receipt == 1 && ok_classifier_subject == 1 &&
        ok_spec == 1 && ok_claimed_spec == 1 && ok_partition == 1 &&
        ok_claimed_partition == 1 && ok_classification == 1 &&
        str_char_at(raw, end_offset) <= 0
    if !parsed || schema != 9012 {
        println("SOUNIO_OUTCOME_AUTHORITY_REFUSE reason=malformed-frame")
        return 64
    }
    let measurement = admit_outcome_authority_digest256(m0, m1, m2, m3, m4, m5, m6, m7)
    let measurement_receipt = admit_outcome_authority_digest256(r0, r1, r2, r3, r4, r5, r6, r7)
    let classifier_subject = admit_outcome_authority_digest256(u0, u1, u2, u3, u4, u5, u6, u7)
    let spec = admit_outcome_authority_digest256(s0, s1, s2, s3, s4, s5, s6, s7)
    let claimed_spec = admit_outcome_authority_digest256(t0, t1, t2, t3, t4, t5, t6, t7)
    let partition = admit_outcome_authority_digest256(a0, a1, a2, a3, a4, a5, a6, a7)
    let claimed_partition = admit_outcome_authority_digest256(b0, b1, b2, b3, b4, b5, b6, b7)
    let classification = admit_outcome_authority_digest256(c0, c1, c2, c3, c4, c5, c6, c7)
    if host_outcome_authority_frame_accepts(
        measurement_signature_verified, classification_signature_verified,
        policy_token, selected_policy_token, current_action_token,
        current_path_token, outcome_token, owner_token, generation_token,
        journal_head_token,
        measurement_principal_token, classifier_principal_token,
        measurement_key_token, classifier_key_token,
        measurement_policy_token, measurement_selected_policy_token,
        measurement_action_token, measurement_path_token,
        measurement_generation_token, measurement_journal_head_token,
        measurement_nonce_token,
        classification_policy_token, classification_selected_policy_token,
        classification_action_token, classification_path_token,
        classification_outcome_token, classification_generation_token,
        classification_journal_head_token,
        classification_nonce_token, measurement, measurement_receipt,
        classifier_subject, spec, claimed_spec, partition,
        claimed_partition, classification,
    ) {
        println("SOUNIO_OUTCOME_AUTHORITY_ACCEPT schema=loom-native-outcome-authority-v0 transition=consume state=verified")
        return 0
    }
    println("SOUNIO_OUTCOME_AUTHORITY_REFUSE reason=evidence-policy")
    42
}
