    println("LOOM_PROCESS_WITNESS_EFFECT_POLICY_PLAN_V3 producer=Sounio role=SEMANTIC_POLICY_PLAN semantic_authority=Sounio action=9025 schema=3 object_boundary=IMMUTABLE_ROOT_MOUNT_NAMESPACE families=12 treatments=12 sabotages=12 allowed_syscalls=4")
