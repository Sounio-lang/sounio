//! Executable adapter for LOOM kernel-principal authority frame 9026.

fn kernel_principal_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn kernel_principal_digest_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) with Mut, Div, Panic {
    let (ok0, limb0, p0) = kernel_principal_decimal_field(raw, start)
    let (ok1, limb1, p1) = kernel_principal_decimal_field(raw, p0)
    let (ok2, limb2, p2) = kernel_principal_decimal_field(raw, p1)
    let (ok3, limb3, p3) = kernel_principal_decimal_field(raw, p2)
    let (ok4, limb4, p4) = kernel_principal_decimal_field(raw, p3)
    let (ok5, limb5, p5) = kernel_principal_decimal_field(raw, p4)
    let (ok6, limb6, p6) = kernel_principal_decimal_field(raw, p5)
    let (ok7, limb7, p7) = kernel_principal_decimal_field(raw, p6)
    let valid = ok0 == 1 && ok1 == 1 && ok2 == 1 && ok3 == 1 &&
        ok4 == 1 && ok5 == 1 && ok6 == 1 && ok7 == 1 &&
        limb0 <= 4294967295 && limb1 <= 4294967295 &&
        limb2 <= 4294967295 && limb3 <= 4294967295 &&
        limb4 <= 4294967295 && limb5 <= 4294967295 &&
        limb6 <= 4294967295 && limb7 <= 4294967295
    (if valid { 1 } else { 0 }, limb0, limb1, limb2, limb3,
        limb4, limb5, limb6, limb7, p7)
}

fn kernel_principal_reason(decision: i64) -> string {
    if decision == 0 { return "allow" }
    if decision == 405 { return "wrong-stage-or-parent" }
    if decision == 454 { return "kernel-substrate-incomplete" }
    if decision == 455 { return "subordinate-allocation-incomplete" }
    if decision == 456 { return "namespace-mapping-invalid" }
    if decision == 457 { return "kernel-principals-not-distinct" }
    if decision == 458 { return "peer-binding-incomplete" }
    if decision == 459 { return "process-isolation-incomplete" }
    if decision == 460 { return "grant-custody-incomplete" }
    if decision == 461 { return "sabotage-incomplete" }
    if decision == 462 { return "provenance-incomplete" }
    "malformed-frame"
}

fn kernel_principal_code(decision: i64) -> string {
    if decision == 0 { return "0" }
    if decision == 405 { return "405" }
    if decision == 454 { return "454" }
    if decision == 455 { return "455" }
    if decision == 456 { return "456" }
    if decision == 457 { return "457" }
    if decision == 458 { return "458" }
    if decision == 459 { return "459" }
    if decision == 460 { return "460" }
    if decision == 461 { return "461" }
    if decision == 462 { return "462" }
    "424"
}

fn kernel_principal_case(case_index: i64) -> string {
    if case_index == 1 { return "1" }
    if case_index == 2 { return "2" }
    if case_index == 3 { return "3" }
    if case_index == 4 { return "4" }
    if case_index == 5 { return "5" }
    if case_index == 6 { return "6" }
    if case_index == 7 { return "7" }
    if case_index == 8 { return "8" }
    if case_index == 9 { return "9" }
    if case_index == 10 { return "10" }
    if case_index == 11 { return "11" }
    if case_index == 12 { return "12" }
    if case_index == 13 { return "13" }
    if case_index == 14 { return "14" }
    if case_index == 15 { return "15" }
    if case_index == 16 { return "16" }
    if case_index == 17 { return "17" }
    "unknown"
}

fn kernel_principal_stage_name(stage: i64) -> string {
    if stage == 1 { return "GARDEN" }
    if stage == 2 { return "SOUNIO_EXECUTABLE" }
    if stage == 3 { return "SEMANTICS_FROZEN" }
    if stage == 4 { return "PARITY_OPEN" }
    if stage == 5 { return "MATERIAL_COVERAGE" }
    if stage == 6 { return "ATTACHMENT_OPEN" }
    if stage == 7 { return "CLAIM_READY" }
    "INVALID"
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = kernel_principal_decimal_field(raw, 0)
    if ok_schema == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed_case = loom_kernel_principal_authority_selftest()
        if failed_case == 0 {
            println("SOUNIO_KERNEL_PRINCIPAL_SELFTEST PASS cases=17")
            return 0
        }
        println("SOUNIO_KERNEL_PRINCIPAL_SELFTEST FAIL case=" +
            kernel_principal_case(failed_case))
        return 70
    }

    let (ok_stage, stage, p1) = kernel_principal_decimal_field(raw, p0)
    let (ok_parent, parent_9025_frozen, p2) = kernel_principal_decimal_field(raw, p1)
    let (ok_linux, linux, p3) = kernel_principal_decimal_field(raw, p2)
    let (ok_x86, x86_64, p4) = kernel_principal_decimal_field(raw, p3)
    let (ok_userns, user_namespace, p5) = kernel_principal_decimal_field(raw, p4)
    let (ok_pidns, pid_namespace, p6) = kernel_principal_decimal_field(raw, p5)
    let (ok_mountns, mount_namespace, p7) = kernel_principal_decimal_field(raw, p6)
    let (ok_cgroupv2, cgroup_v2, p8) = kernel_principal_decimal_field(raw, p7)
    let (ok_allocation, allocation_ready, p9) = kernel_principal_decimal_field(raw, p8)
    let (ok_uid_map, uid_map_exact, p10) = kernel_principal_decimal_field(raw, p9)
    let (ok_gid_map, gid_map_exact, p11) = kernel_principal_decimal_field(raw, p10)
    let (ok_setgroups, setgroups_denied_first, p12) = kernel_principal_decimal_field(raw, p11)
    let (ok_disjoint, ranges_disjoint, p13) = kernel_principal_decimal_field(raw, p12)
    let (ok_outer_uid, outer_uid, p14) = kernel_principal_decimal_field(raw, p13)
    let (ok_principal_uid, principal_uid, p15) = kernel_principal_decimal_field(raw, p14)
    let (ok_sibling_uid, sibling_uid, p16) = kernel_principal_decimal_field(raw, p15)
    let (ok_outer_gid, outer_gid, p17) = kernel_principal_decimal_field(raw, p16)
    let (ok_principal_gid, principal_gid, p18) = kernel_principal_decimal_field(raw, p17)
    let (ok_sibling_gid, sibling_gid, p19) = kernel_principal_decimal_field(raw, p18)
    let (ok_peercred, so_peercred_bound, p20) = kernel_principal_decimal_field(raw, p19)
    let (ok_pidfd, pidfd_bound, p21) = kernel_principal_decimal_field(raw, p20)
    let (ok_start_tick, start_tick_bound, p22) = kernel_principal_decimal_field(raw, p21)
    let (ok_boot, boot_identity_bound, p23) = kernel_principal_decimal_field(raw, p22)
    let (ok_executable, executable_bound, p24) = kernel_principal_decimal_field(raw, p23)
    let (ok_ancestry, ancestry_bound, p25) = kernel_principal_decimal_field(raw, p24)
    let (ok_worktree, worktree_bound, p26) = kernel_principal_decimal_field(raw, p25)
    let (ok_cgroup, cgroup_bound, p27) = kernel_principal_decimal_field(raw, p26)
    let (ok_dumpable, non_dumpable, p28) = kernel_principal_decimal_field(raw, p27)
    let (ok_nnp, no_new_privileges, p29) = kernel_principal_decimal_field(raw, p28)
    let (ok_cap_ptrace, cap_sys_ptrace_absent, p30) = kernel_principal_decimal_field(raw, p29)
    let (ok_ptrace, ptrace_denied, p31) = kernel_principal_decimal_field(raw, p30)
    let (ok_proc_mem, proc_mem_denied, p32) = kernel_principal_decimal_field(raw, p31)
    let (ok_signal, cross_principal_signal_denied, p33) = kernel_principal_decimal_field(raw, p32)
    let (ok_memory, memory_only, p34) = kernel_principal_decimal_field(raw, p33)
    let (ok_atomic, atomic_transition, p35) = kernel_principal_decimal_field(raw, p34)
    let (ok_one_shot, one_shot, p36) = kernel_principal_decimal_field(raw, p35)
    let (ok_nonburning, unauthorized_refusal_nonburning, p37) = kernel_principal_decimal_field(raw, p36)
    let (ok_revokes, crash_revokes, p38) = kernel_principal_decimal_field(raw, p37)
    let (ok_sabotage, sabotage_count, p39) = kernel_principal_decimal_field(raw, p38)
    let (ok_sabotage_required, sabotage_required, p40) = kernel_principal_decimal_field(raw, p39)
    let (ok_receipt, receipt_bound, p41) = kernel_principal_decimal_field(raw, p40)

    let (ok_parent_hash, a0, a1, a2, a3, a4, a5, a6, a7, p42) =
        kernel_principal_digest_field(raw, p41)
    let (ok_allocation_hash, b0, b1, b2, b3, b4, b5, b6, b7, p43) =
        kernel_principal_digest_field(raw, p42)
    let (ok_uid_map_hash, c0, c1, c2, c3, c4, c5, c6, c7, p44) =
        kernel_principal_digest_field(raw, p43)
    let (ok_gid_map_hash, d0, d1, d2, d3, d4, d5, d6, d7, p45) =
        kernel_principal_digest_field(raw, p44)
    let (ok_peer_hash, e0, e1, e2, e3, e4, e5, e6, e7, p46) =
        kernel_principal_digest_field(raw, p45)
    let (ok_attack_hash, f0, f1, f2, f3, f4, f5, f6, f7, p47) =
        kernel_principal_digest_field(raw, p46)
    let (ok_source_hash, g0, g1, g2, g3, g4, g5, g6, g7, p48) =
        kernel_principal_digest_field(raw, p47)
    let (ok_semantics_hash, h0, h1, h2, h3, h4, h5, h6, h7, p49) =
        kernel_principal_digest_field(raw, p48)
    let (ok_toolchain_hash, i0, i1, i2, i3, i4, i5, i6, i7, p50) =
        kernel_principal_digest_field(raw, p49)
    let (ok_hardware_hash, j0, j1, j2, j3, j4, j5, j6, j7, p51) =
        kernel_principal_digest_field(raw, p50)
    let (ok_command_hash, k0, k1, k2, k3, k4, k5, k6, k7, p52) =
        kernel_principal_digest_field(raw, p51)
    let (ok_result_hash, r0, r1, r2, r3, r4, r5, r6, r7, end_offset) =
        kernel_principal_digest_field(raw, p52)

    let parsed = ok_schema == 1 && ok_stage == 1 && ok_parent == 1 &&
        ok_linux == 1 && ok_x86 == 1 && ok_userns == 1 && ok_pidns == 1 &&
        ok_mountns == 1 && ok_cgroupv2 == 1 && ok_allocation == 1 &&
        ok_uid_map == 1 && ok_gid_map == 1 && ok_setgroups == 1 &&
        ok_disjoint == 1 && ok_outer_uid == 1 && ok_principal_uid == 1 &&
        ok_sibling_uid == 1 && ok_outer_gid == 1 && ok_principal_gid == 1 &&
        ok_sibling_gid == 1 && ok_peercred == 1 && ok_pidfd == 1 &&
        ok_start_tick == 1 && ok_boot == 1 && ok_executable == 1 &&
        ok_ancestry == 1 && ok_worktree == 1 && ok_cgroup == 1 &&
        ok_dumpable == 1 && ok_nnp == 1 && ok_cap_ptrace == 1 &&
        ok_ptrace == 1 && ok_proc_mem == 1 && ok_signal == 1 &&
        ok_memory == 1 && ok_atomic == 1 && ok_one_shot == 1 &&
        ok_nonburning == 1 && ok_revokes == 1 && ok_sabotage == 1 &&
        ok_sabotage_required == 1 && ok_receipt == 1 && ok_parent_hash == 1 &&
        ok_allocation_hash == 1 && ok_uid_map_hash == 1 && ok_gid_map_hash == 1 &&
        ok_peer_hash == 1 && ok_attack_hash == 1 && ok_source_hash == 1 &&
        ok_semantics_hash == 1 && ok_toolchain_hash == 1 &&
        ok_hardware_hash == 1 && ok_command_hash == 1 && ok_result_hash == 1 &&
        str_char_at(raw, end_offset) <= 0
    if !parsed {
        println("SOUNIO_KERNEL_PRINCIPAL_DENY code=424 reason=malformed-frame stage=INVALID")
        return 424
    }
    if schema != 9026 {
        println("SOUNIO_KERNEL_PRINCIPAL_DENY code=405 reason=wrong-stage-or-parent stage=" +
            kernel_principal_stage_name(stage))
        return 405
    }

    let substrate = admit_loom_kernel_principal_substrate(
        linux, x86_64, user_namespace, pid_namespace, mount_namespace, cgroup_v2,
    )
    let mapping = admit_loom_kernel_principal_mapping(
        allocation_ready, uid_map_exact, gid_map_exact,
        setgroups_denied_first, ranges_disjoint, outer_uid, principal_uid,
        sibling_uid, outer_gid, principal_gid, sibling_gid,
    )
    let peer = admit_loom_kernel_principal_peer(
        so_peercred_bound, pidfd_bound, start_tick_bound, boot_identity_bound,
        executable_bound, ancestry_bound, worktree_bound, cgroup_bound,
    )
    let isolation = admit_loom_kernel_principal_isolation(
        non_dumpable, no_new_privileges, cap_sys_ptrace_absent, ptrace_denied,
        proc_mem_denied, cross_principal_signal_denied,
    )
    let grant = admit_loom_kernel_principal_grant(
        memory_only, atomic_transition, one_shot,
        unauthorized_refusal_nonburning, crash_revokes, sabotage_count,
        sabotage_required, receipt_bound,
    )
    let bindings = admit_loom_kernel_principal_bindings(
        admit_loom_kernel_principal_digest256(a0, a1, a2, a3, a4, a5, a6, a7),
        admit_loom_kernel_principal_digest256(b0, b1, b2, b3, b4, b5, b6, b7),
        admit_loom_kernel_principal_digest256(c0, c1, c2, c3, c4, c5, c6, c7),
        admit_loom_kernel_principal_digest256(d0, d1, d2, d3, d4, d5, d6, d7),
        admit_loom_kernel_principal_digest256(e0, e1, e2, e3, e4, e5, e6, e7),
        admit_loom_kernel_principal_digest256(f0, f1, f2, f3, f4, f5, f6, f7),
        admit_loom_kernel_principal_digest256(g0, g1, g2, g3, g4, g5, g6, g7),
        admit_loom_kernel_principal_digest256(h0, h1, h2, h3, h4, h5, h6, h7),
        admit_loom_kernel_principal_digest256(i0, i1, i2, i3, i4, i5, i6, i7),
        admit_loom_kernel_principal_digest256(j0, j1, j2, j3, j4, j5, j6, j7),
        admit_loom_kernel_principal_digest256(k0, k1, k2, k3, k4, k5, k6, k7),
        admit_loom_kernel_principal_digest256(r0, r1, r2, r3, r4, r5, r6, r7),
    )
    let decision = loom_kernel_principal_authority_decide(
        stage, parent_9025_frozen, substrate, mapping, peer, isolation, grant,
        bindings,
    )
    if decision == 0 {
        println("SOUNIO_KERNEL_PRINCIPAL_ALLOW code=0 reason=allow stage=" +
            kernel_principal_stage_name(stage))
        return 0
    }
    println("SOUNIO_KERNEL_PRINCIPAL_DENY code=" +
        kernel_principal_code(decision) + " reason=" +
        kernel_principal_reason(decision) + " stage=" +
        kernel_principal_stage_name(stage))
    decision
}
