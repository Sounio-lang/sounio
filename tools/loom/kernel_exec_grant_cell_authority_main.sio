            admit_loom_kernel_exec_grant_cell_digest256(f0, f1, f2, f3, f4, f5, f6, f7),
            admit_loom_kernel_exec_grant_cell_digest256(g0, g1, g2, g3, g4, g5, g6, g7),
            admit_loom_kernel_exec_grant_cell_digest256(h0, h1, h2, h3, h4, h5, h6, h7),
            admit_loom_kernel_exec_grant_cell_digest256(i0, i1, i2, i3, i4, i5, i6, i7),
        ),
    )
    if decision == 0 {
        println("SOUNIO_KERNEL_EXEC_GRANT_CELL_ALLOW code=0 reason=allow stage=" +
            kernel_exec_grant_cell_stage_name(stage))
        return 0
    }
    println("SOUNIO_KERNEL_EXEC_GRANT_CELL_DENY code=" +
        kernel_exec_grant_cell_code(decision) + " reason=" +
        kernel_exec_grant_cell_reason(decision) + " stage=" +
        kernel_exec_grant_cell_stage_name(stage))
    decision
}
