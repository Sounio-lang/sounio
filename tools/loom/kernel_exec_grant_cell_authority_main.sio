//! Executable adapter for LOOM kernel ExecGrantCell authority frame 9030.

fn kernel_exec_grant_cell_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn kernel_exec_grant_cell_digest_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) with Mut, Div, Panic {
    let (ok0, limb0, p0) = kernel_exec_grant_cell_decimal_field(raw, start)
    let (ok1, limb1, p1) = kernel_exec_grant_cell_decimal_field(raw, p0)
    let (ok2, limb2, p2) = kernel_exec_grant_cell_decimal_field(raw, p1)
    let (ok3, limb3, p3) = kernel_exec_grant_cell_decimal_field(raw, p2)
    let (ok4, limb4, p4) = kernel_exec_grant_cell_decimal_field(raw, p3)
    let (ok5, limb5, p5) = kernel_exec_grant_cell_decimal_field(raw, p4)
    let (ok6, limb6, p6) = kernel_exec_grant_cell_decimal_field(raw, p5)
    let (ok7, limb7, p7) = kernel_exec_grant_cell_decimal_field(raw, p6)
    let valid = ok0 == 1 && ok1 == 1 && ok2 == 1 && ok3 == 1 &&
        ok4 == 1 && ok5 == 1 && ok6 == 1 && ok7 == 1 &&
        limb0 <= 4294967295 && limb1 <= 4294967295 &&
        limb2 <= 4294967295 && limb3 <= 4294967295 &&
        limb4 <= 4294967295 && limb5 <= 4294967295 &&
        limb6 <= 4294967295 && limb7 <= 4294967295
    (if valid { 1 } else { 0 }, limb0, limb1, limb2, limb3,
        limb4, limb5, limb6, limb7, p7)
}

fn kernel_exec_grant_cell_reason(decision: i64) -> string {
    if decision == 0 { return "allow" }
    if decision == 405 { return "wrong-stage-or-parent-freeze" }
    if decision == 491 { return "parent-authority-chain-incomplete" }
    if decision == 492 { return "grant-identity-incomplete" }
    if decision == 493 { return "kernel-peer-binding-incomplete" }
    if decision == 494 { return "prewrite-shape-incomplete" }
    if decision == 495 { return "nonbearer-consumption-incomplete" }
    if decision == 496 { return "crash-revocation-incomplete" }
    if decision == 497 { return "affirmative-extinction-incomplete" }
    if decision == 498 { return "outcome-closure-incomplete" }
    if decision == 499 { return "authority-laundering" }
    if decision == 500 { return "provenance-incomplete" }
    if decision == 501 { return "sabotage-incomplete" }
    "malformed-frame"
}

fn kernel_exec_grant_cell_code(decision: i64) -> string {
    if decision == 0 { return "0" }
    if decision == 405 { return "405" }
    if decision == 491 { return "491" }
    if decision == 492 { return "492" }
    if decision == 493 { return "493" }
    if decision == 494 { return "494" }
    if decision == 495 { return "495" }
    if decision == 496 { return "496" }
    if decision == 497 { return "497" }
    if decision == 498 { return "498" }
    if decision == 499 { return "499" }
    if decision == 500 { return "500" }
    if decision == 501 { return "501" }
    "424"
}

fn kernel_exec_grant_cell_case(case_index: i64) -> string {
    if case_index == 1 { return "1" }
    if case_index == 2 { return "2" }
    if case_index == 3 { return "3" }
    if case_index == 4 { return "4" }
    if case_index == 5 { return "5" }
    if case_index == 6 { return "6" }
    if case_index == 7 { return "7" }
    if case_index == 8 { return "8" }
    if case_index == 9 { return "9" }
    if case_index == 10 { return "10" }
    if case_index == 11 { return "11" }
    if case_index == 12 { return "12" }
    if case_index == 13 { return "13" }
    if case_index == 14 { return "14" }
    if case_index == 15 { return "15" }
    if case_index == 16 { return "16" }
    if case_index == 17 { return "17" }
    if case_index == 18 { return "18" }
    if case_index == 19 { return "19" }
    "unknown"
}

fn kernel_exec_grant_cell_stage_name(stage: i64) -> string {
    if stage == 1 { return "GARDEN" }
    if stage == 2 { return "SOUNIO_EXECUTABLE" }
    if stage == 3 { return "SEMANTICS_FROZEN" }
    if stage == 4 { return "PARITY_OPEN" }
    if stage == 5 { return "MATERIAL_COVERAGE" }
    if stage == 6 { return "ATTACHMENT_OPEN" }
    if stage == 7 { return "CLAIM_READY" }
    "INVALID"
}

