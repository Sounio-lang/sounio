//! Packed executable adapter for LOOM action 9048.

fn pin_decimal(raw: string, start: i64) -> (i64, i64, i64) with Mut, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 { return (if seen { 1 } else { 0 }, value, offset + 1) }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) { return (0, 0, offset) }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn pin_decision(value: i64) -> string {
    if value == 1 { return "SEALED_CAPABILITY" }
    if value == 2 { return "SEALED_LEGACY" }
    if value == 3 { return "CONTINUE" }
    if value == 4 { return "FORWARD" }
    if value == 5 { return "BIRTH_PINNED" }
    if value == 6 { return "CUTOVER_READY" }
    if value == 691 { return "DENY691" }
    if value == 692 { return "DENY692" }
    if value == 693 { return "DENY693" }
    if value == 694 { return "DENY694" }
    if value == 695 { return "DENY695" }
    if value == 696 { return "DENY696" }
    if value == 697 { return "DENY697" }
    if value == 698 { return "DENY698" }
    if value == 699 { return "DENY699" }
    if value == 700 { return "DENY700" }
    "DENY424"
}

fn main() -> i64 with IO, Mut, Panic {
    let raw = read_line()
    let (o0, schema, p0) = pin_decimal(raw, 0)
    if o0 == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        if loom_generation_pinned_cutover_selftest() == 0 {
            println("SOUNIO_GENERATION_PINNED_CUTOVER_SELFTEST PASS cases=16")
            return 0
        }
        println("SOUNIO_GENERATION_PINNED_CUTOVER_SELFTEST FAIL")
        return 70
    }
    let (o1, mode, p1) = pin_decimal(raw, p0)
    let (o2, stage, p2) = pin_decimal(raw, p1)
    let (o3, word, p3) = pin_decimal(raw, p2)
    let (o4, ih0, p4) = pin_decimal(raw, p3)
    let (o5, ih1, p5) = pin_decimal(raw, p4)
    let (o6, rh0, p6) = pin_decimal(raw, p5)
    let (o7, rh1, p7) = pin_decimal(raw, p6)
    let (o8, tx, p8) = pin_decimal(raw, p7)
    let (o9, sabotage, p9) = pin_decimal(raw, p8)
    let (o10, required, p10) = pin_decimal(raw, p9)
    if o0 != 1 || schema != 9048 || o1 != 1 || o2 != 1 || o3 != 1 ||
        o4 != 1 || o5 != 1 || o6 != 1 || o7 != 1 || o8 != 1 ||
        o9 != 1 || o10 != 1 || mode < 1 || mode > 6 || stage < 0 ||
        word < 0 || sabotage < 0 || required < 0 || str_char_at(raw, p10) > 0 {
        println("SOUNIO_GENERATION_PINNED_CUTOVER DENY424 reason=malformed-frame semantic_authority=Sounio action=9048")
        return 42
    }
    let decision = judge_loom_generation_pinned_cutover_words(
        mode, stage, word, ih0, ih1, rh0, rh1, tx, sabotage, required,
    )
    println("SOUNIO_GENERATION_PINNED_CUTOVER " + pin_decision(decision) +
        " semantic_authority=Sounio action=9048")
    if decision >= 1 && decision <= 6 { return 0 }
    42
}
