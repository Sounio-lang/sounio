//! Packed executable adapter for LOOM action 9042.

fn sovereign_decimal_field(raw: string, start: i64) -> (i64, i64, i64) with Mut, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn sovereign_decision(decision: i64) -> string {
    if decision == 1 { return "EXEC_ADMIT" }
    if decision == 2 { return "GUARDIAN_REVOKE" }
    if decision == 3 { return "PRODUCTION_GATE_READY" }
    if decision == 602 { return "DENY602" }
    if decision == 603 { return "DENY603" }
    if decision == 604 { return "DENY604" }
    if decision == 605 { return "DENY605" }
    if decision == 606 { return "DENY606" }
    if decision == 607 { return "DENY607" }
    if decision == 608 { return "DENY608" }
    if decision == 609 { return "DENY609" }
    if decision == 610 { return "DENY610" }
    if decision == 611 { return "DENY611" }
    if decision == 612 { return "DENY612" }
    "DENY424"
}

fn sovereign_fields() with IO {
    println("LOOM_SOVEREIGN_EXECUTION_KERNEL_FIELDS_V1")
    println("parents=actions-9025+9030+9031")
    println("grant=resident-memory+non-bearer+single-use+atomic-consume")
    println("peer=SO_PEERCRED+pidfd+start-tick+harness-ancestry+executable+operation")
    println("release_authority=HostGuardian-only")
    println("interfaces=GUI+TUI+CLI+Pod+tmux:zero-release-authority")
    println("transport_loss=material-witness-continues")
    println("guardian_loss=fail-closed-revocation")
    println("production_requires=same_uid_peer_isolation:true")
}

fn main() -> i64 with IO, Mut, Panic {
    let raw = read_line()
    let (o0, schema, p0) = sovereign_decimal_field(raw, 0)
    if o0 == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed = loom_sovereign_execution_kernel_selftest()
        if failed == 0 {
            println("SOUNIO_SOVEREIGN_EXECUTION_KERNEL_SELFTEST PASS cases=14")
            return 0
        }
        println("SOUNIO_SOVEREIGN_EXECUTION_KERNEL_SELFTEST FAIL")
        return 70
    }
    let (o1, mode, p1) = sovereign_decimal_field(raw, p0)
    let (o2, stage, p2) = sovereign_decimal_field(raw, p1)
    let (o3, word, p3) = sovereign_decimal_field(raw, p2)
    let (o4, sabotage_count, p4) = sovereign_decimal_field(raw, p3)
    let (o5, sabotage_required, p5) = sovereign_decimal_field(raw, p4)
    if o0 != 1 || schema != 9042 || o1 != 1 || o2 != 1 || o3 != 1 ||
        o4 != 1 || o5 != 1 || mode < 1 || mode > 3 || stage < 0 ||
        word < 0 || word >= 562949953421312 ||
        sabotage_count < 0 || sabotage_required < 0 ||
        str_char_at(raw, p5) > 0 {
        println("SOUNIO_SOVEREIGN_EXECUTION_KERNEL DENY424 reason=malformed-frame semantic_authority=Sounio action=9042")
        return 42
    }
    let decision = judge_loom_sovereign_execution_kernel_words(
        mode, stage, word, sabotage_count, sabotage_required,
    )
    println("SOUNIO_SOVEREIGN_EXECUTION_KERNEL " + sovereign_decision(decision) +
        " semantic_authority=Sounio action=9042")
    if decision == 1 || decision == 2 || decision == 3 {
        sovereign_fields()
        return 0
    }
    42
}
