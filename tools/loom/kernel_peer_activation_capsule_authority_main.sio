//! Executable adapter and Sounio-produced fixture bundle for LOOM action 9031.

fn kernel_peer_activation_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn kernel_peer_activation_digest_field(
    raw: string, start: i64,
) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) with Mut, Div, Panic {
    let (ok0, v0, p0) = kernel_peer_activation_decimal_field(raw, start)
    let (ok1, v1, p1) = kernel_peer_activation_decimal_field(raw, p0)
    let (ok2, v2, p2) = kernel_peer_activation_decimal_field(raw, p1)
    let (ok3, v3, p3) = kernel_peer_activation_decimal_field(raw, p2)
    let (ok4, v4, p4) = kernel_peer_activation_decimal_field(raw, p3)
    let (ok5, v5, p5) = kernel_peer_activation_decimal_field(raw, p4)
    let (ok6, v6, p6) = kernel_peer_activation_decimal_field(raw, p5)
    let (ok7, v7, p7) = kernel_peer_activation_decimal_field(raw, p6)
    (ok0 * ok1 * ok2 * ok3 * ok4 * ok5 * ok6 * ok7,
        v0, v1, v2, v3, v4, v5, v6, v7, p7)
}

fn kernel_peer_activation_reason(decision: i64) -> string {
    if decision == 0 { return "allow" }
    if decision == 405 { return "wrong-stage-or-parent-freeze" }
    if decision == 502 { return "parent-decision-chain-incomplete" }
    if decision == 503 { return "kernel-anchor-incomplete" }
    if decision == 504 { return "principal-anchor-incomplete" }
    if decision == 505 { return "prewrite-lifecycle-incomplete" }
    if decision == 506 { return "nonbearer-custody-incomplete" }
    if decision == 507 { return "affirmative-absence-incomplete" }
    if decision == 508 { return "authority-laundering" }
    if decision == 509 { return "provenance-incomplete" }
    if decision == 510 { return "sabotage-incomplete" }
    "malformed-frame"
}

fn kernel_peer_activation_code(decision: i64) -> string {
    if decision == 0 { return "0" }
    if decision == 405 { return "405" }
    if decision == 502 { return "502" }
    if decision == 503 { return "503" }
    if decision == 504 { return "504" }
    if decision == 505 { return "505" }
    if decision == 506 { return "506" }
    if decision == 507 { return "507" }
    if decision == 508 { return "508" }
    if decision == 509 { return "509" }
    if decision == 510 { return "510" }
    "424"
}

fn kernel_peer_activation_stage(stage: i64) -> string {
    if stage == 1 { return "GARDEN" }
    if stage == 2 { return "SOUNIO_EXECUTABLE" }
    if stage == 3 { return "SEMANTICS_FROZEN" }
    if stage == 4 { return "PARITY_OPEN" }
    if stage == 5 { return "MATERIAL_COVERAGE" }
    if stage == 6 { return "ATTACHMENT_OPEN" }
    if stage == 7 { return "CLAIM_READY" }
    "INVALID"
}

