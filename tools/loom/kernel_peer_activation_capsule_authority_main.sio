            admit_loom_kernel_peer_activation_digest256(e0, e1, e2, e3, e4, e5, e6, e7),
            admit_loom_kernel_peer_activation_digest256(f0, f1, f2, f3, f4, f5, f6, f7),
            admit_loom_kernel_peer_activation_digest256(g0, g1, g2, g3, g4, g5, g6, g7),
        ),
    )
    let prefix = if decision == 0 {
        "SOUNIO_KERNEL_PEER_ACTIVATION_CAPSULE_ALLOW"
    } else {
        "SOUNIO_KERNEL_PEER_ACTIVATION_CAPSULE_DENY"
    }
    println(prefix + " code=" + kernel_peer_activation_code(decision) +
        " reason=" + kernel_peer_activation_reason(decision) +
        " stage=" + kernel_peer_activation_stage(stage))
    decision
}
