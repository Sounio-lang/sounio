//! Executable adapter for Loom subprocess-membrane frame 9023.

fn subprocess_membrane_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn subprocess_membrane_digest_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) with Mut, Div, Panic {
    let (ok0, limb0, p0) = subprocess_membrane_decimal_field(raw, start)
    let (ok1, limb1, p1) = subprocess_membrane_decimal_field(raw, p0)
    let (ok2, limb2, p2) = subprocess_membrane_decimal_field(raw, p1)
    let (ok3, limb3, p3) = subprocess_membrane_decimal_field(raw, p2)
    let (ok4, limb4, p4) = subprocess_membrane_decimal_field(raw, p3)
    let (ok5, limb5, p5) = subprocess_membrane_decimal_field(raw, p4)
    let (ok6, limb6, p6) = subprocess_membrane_decimal_field(raw, p5)
    let (ok7, limb7, p7) = subprocess_membrane_decimal_field(raw, p6)
    let valid = ok0 == 1 && ok1 == 1 && ok2 == 1 && ok3 == 1 &&
        ok4 == 1 && ok5 == 1 && ok6 == 1 && ok7 == 1 &&
        limb0 <= 4294967295 && limb1 <= 4294967295 &&
        limb2 <= 4294967295 && limb3 <= 4294967295 &&
        limb4 <= 4294967295 && limb5 <= 4294967295 &&
        limb6 <= 4294967295 && limb7 <= 4294967295
    (if valid { 1 } else { 0 }, limb0, limb1, limb2, limb3,
        limb4, limb5, limb6, limb7, p7)
}

fn subprocess_membrane_reason(decision: i64) -> string {
    if decision == 0 { return "allow" }
    if decision == 401 { return "policy-missing" }
    if decision == 402 { return "policy-timeout" }
    if decision == 403 { return "policy-error" }
    if decision == 405 { return "wrong-stage" }
    if decision == 406 { return "membrane-missing" }
    if decision == 407 { return "root-binding-missing" }
    if decision == 408 { return "ancestry-binding-missing" }
    if decision == 409 { return "generation-binding-missing" }
    if decision == 410 { return "prohibited-language" }
    if decision == 411 { return "external-llm-role-violation" }
    if decision == 413 { return "semantic-write-not-sounio" }
    if decision == 414 { return "expected-result-write-not-sounio" }
    if decision == 415 { return "effect-unsupported" }
    if decision == 416 { return "coverage-unattested" }
    if decision == 417 { return "parent-semantics-hash-mismatch" }
    if decision == 418 { return "binding-hash-incomplete" }
    if decision == 419 { return "review-promoted" }
    if decision == 420 { return "waiver-invalid" }
    if decision == 421 { return "deadline-missing" }
    if decision == 422 { return "write-scope-missing" }
    if decision == 423 { return "tree-not-quiescent" }
    if decision == 425 { return "pre-effect-incomplete" }
    if decision == 426 { return "outcome-incomplete" }
    if decision == 427 { return "receipt-chain-invalid" }
    if decision == 428 { return "termination-incomplete" }
    if decision == 429 { return "actor-unclassified" }
    if decision == 430 { return "purpose-invalid" }
    if decision == 431 { return "parity-closed" }
    if decision == 432 { return "surface-effect-mismatch" }
    "malformed-frame"
}

fn subprocess_membrane_code(decision: i64) -> string {
    if decision == 0 { return "0" }
    if decision == 401 { return "401" }
    if decision == 402 { return "402" }
    if decision == 403 { return "403" }
    if decision == 405 { return "405" }
    if decision == 406 { return "406" }
    if decision == 407 { return "407" }
    if decision == 408 { return "408" }
    if decision == 409 { return "409" }
    if decision == 410 { return "410" }
    if decision == 411 { return "411" }
    if decision == 413 { return "413" }
    if decision == 414 { return "414" }
    if decision == 415 { return "415" }
    if decision == 416 { return "416" }
    if decision == 417 { return "417" }
    if decision == 418 { return "418" }
    if decision == 419 { return "419" }
    if decision == 420 { return "420" }
    if decision == 421 { return "421" }
    if decision == 422 { return "422" }
    if decision == 423 { return "423" }
    if decision == 425 { return "425" }
    if decision == 426 { return "426" }
    if decision == 427 { return "427" }
    if decision == 428 { return "428" }
    if decision == 429 { return "429" }
    if decision == 430 { return "430" }
    if decision == 431 { return "431" }
    if decision == 432 { return "432" }
    "424"
}

fn subprocess_membrane_stage_name(stage: i64) -> string {
    if stage == 1 { return "GARDEN" }
    if stage == 2 { return "SOUNIO_EXECUTABLE" }
    if stage == 3 { return "SEMANTICS_FROZEN" }
    if stage == 4 { return "PARITY_OPEN" }
    if stage == 5 { return "CLAIM_READY" }
    "INVALID"
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = subprocess_membrane_decimal_field(raw, 0)
    if ok_schema == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed_case = loom_subprocess_membrane_selftest()
        if failed_case == 0 {
            println("SOUNIO_SUBPROCESS_MEMBRANE_SELFTEST PASS cases=43")
            return 0
        }
        println("SOUNIO_SUBPROCESS_MEMBRANE_SELFTEST FAIL case=" +
            subprocess_membrane_code(failed_case))
        return 70
    }

    let (ok_stage, stage, p1) = subprocess_membrane_decimal_field(raw, p0)
    let (ok_surface, surface, p2) = subprocess_membrane_decimal_field(raw, p1)
    let (ok_effect, effect, p3) = subprocess_membrane_decimal_field(raw, p2)
    let (ok_language, language, p4) = subprocess_membrane_decimal_field(raw, p3)
    let (ok_purpose, purpose, p5) = subprocess_membrane_decimal_field(raw, p4)
    let (ok_policy, policy, p6) = subprocess_membrane_decimal_field(raw, p5)
    let (ok_membrane, membrane, p7) = subprocess_membrane_decimal_field(raw, p6)
    let (ok_root, root, p8) = subprocess_membrane_decimal_field(raw, p7)
    let (ok_ancestry, ancestry, p9) = subprocess_membrane_decimal_field(raw, p8)
    let (ok_generation, generation, p10) = subprocess_membrane_decimal_field(raw, p9)
    let (ok_pre_effect, pre_effect, p11) = subprocess_membrane_decimal_field(raw, p10)
    let (ok_scope, scope, p12) = subprocess_membrane_decimal_field(raw, p11)
    let (ok_deadline, deadline, p13) = subprocess_membrane_decimal_field(raw, p12)
    let (ok_quiescent, quiescent, p14) = subprocess_membrane_decimal_field(raw, p13)
    let (ok_outcome, outcome, p15) = subprocess_membrane_decimal_field(raw, p14)
    let (ok_chain, chain, p16) = subprocess_membrane_decimal_field(raw, p15)
    let (ok_supported, supported, p17) = subprocess_membrane_decimal_field(raw, p16)
    let (ok_coverage, coverage, p18) = subprocess_membrane_decimal_field(raw, p17)
    let (ok_termination, termination, p19) = subprocess_membrane_decimal_field(raw, p18)
    let (ok_semantic_write, semantic_write, p20) = subprocess_membrane_decimal_field(raw, p19)
    let (ok_expected_write, expected_write, p21) = subprocess_membrane_decimal_field(raw, p20)
    let (ok_review, review, p22) = subprocess_membrane_decimal_field(raw, p21)
    let (ok_parity, parity, p23) = subprocess_membrane_decimal_field(raw, p22)
    let (ok_exception, exception_requested, p24) = subprocess_membrane_decimal_field(raw, p23)
    let (ok_waiver_founder, waiver_founder, p25) = subprocess_membrane_decimal_field(raw, p24)
    let (ok_waiver_scope, waiver_scope, p26) = subprocess_membrane_decimal_field(raw, p25)
    let (ok_waiver_purpose, waiver_purpose, p27) = subprocess_membrane_decimal_field(raw, p26)
    let (ok_waiver_unexpired, waiver_unexpired, p28) = subprocess_membrane_decimal_field(raw, p27)

    let (ok_source, s0, s1, s2, s3, s4, s5, s6, s7, p29) =
        subprocess_membrane_digest_field(raw, p28)
    let (ok_semantics, m0, m1, m2, m3, m4, m5, m6, m7, p30) =
        subprocess_membrane_digest_field(raw, p29)
    let (ok_parent, a0, a1, a2, a3, a4, a5, a6, a7, p31) =
        subprocess_membrane_digest_field(raw, p30)
    let (ok_toolchain, t0, t1, t2, t3, t4, t5, t6, t7, p32) =
        subprocess_membrane_digest_field(raw, p31)
    let (ok_hardware, h0, h1, h2, h3, h4, h5, h6, h7, p33) =
        subprocess_membrane_digest_field(raw, p32)
    let (ok_command, c0, c1, c2, c3, c4, c5, c6, c7, p34) =
        subprocess_membrane_digest_field(raw, p33)
    let (ok_event, e0, e1, e2, e3, e4, e5, e6, e7, p35) =
        subprocess_membrane_digest_field(raw, p34)
    let (ok_actor, r0, r1, r2, r3, r4, r5, r6, r7, p36) =
        subprocess_membrane_digest_field(raw, p35)
    let (ok_target, x0, x1, x2, x3, x4, x5, x6, x7, p37) =
        subprocess_membrane_digest_field(raw, p36)
    let (ok_claim, q0, q1, q2, q3, q4, q5, q6, q7, p38) =
        subprocess_membrane_digest_field(raw, p37)
    let (ok_deadline_hash, d0, d1, d2, d3, d4, d5, d6, d7, p39) =
        subprocess_membrane_digest_field(raw, p38)
    let (ok_outcome_hash, o0, o1, o2, o3, o4, o5, o6, o7, p40) =
        subprocess_membrane_digest_field(raw, p39)
    let (ok_waiver_hash, w0, w1, w2, w3, w4, w5, w6, w7, end_offset) =
        subprocess_membrane_digest_field(raw, p40)

    let parsed = ok_schema == 1 && ok_stage == 1 && ok_surface == 1 &&
        ok_effect == 1 && ok_language == 1 && ok_purpose == 1 &&
        ok_policy == 1 && ok_membrane == 1 && ok_root == 1 &&
        ok_ancestry == 1 && ok_generation == 1 && ok_pre_effect == 1 &&
        ok_scope == 1 && ok_deadline == 1 && ok_quiescent == 1 &&
        ok_outcome == 1 && ok_chain == 1 && ok_supported == 1 &&
        ok_coverage == 1 && ok_termination == 1 && ok_semantic_write == 1 &&
        ok_expected_write == 1 && ok_review == 1 && ok_parity == 1 &&
        ok_exception == 1 && ok_waiver_founder == 1 && ok_waiver_scope == 1 &&
        ok_waiver_purpose == 1 && ok_waiver_unexpired == 1 && ok_source == 1 &&
        ok_semantics == 1 && ok_parent == 1 && ok_toolchain == 1 &&
        ok_hardware == 1 && ok_command == 1 && ok_event == 1 && ok_actor == 1 &&
        ok_target == 1 && ok_claim == 1 && ok_deadline_hash == 1 &&
        ok_outcome_hash == 1 && ok_waiver_hash == 1 &&
        str_char_at(raw, end_offset) <= 0
    if !parsed || schema != 9023 {
        println("SOUNIO_SUBPROCESS_MEMBRANE_DENY code=424 reason=malformed-frame stage=INVALID")
        return 424
    }

    let facts = admit_subprocess_membrane_facts(
        stage, surface, effect, language, purpose, policy, membrane, root,
        ancestry, generation, pre_effect, scope, deadline, quiescent, outcome,
        chain, supported, coverage, termination, semantic_write, expected_write,
        review, parity, exception_requested, waiver_founder, waiver_scope,
        waiver_purpose, waiver_unexpired,
    )
    let bindings = admit_subprocess_membrane_bindings(
        admit_subprocess_membrane_digest256(s0, s1, s2, s3, s4, s5, s6, s7),
        admit_subprocess_membrane_digest256(m0, m1, m2, m3, m4, m5, m6, m7),
        admit_subprocess_membrane_digest256(a0, a1, a2, a3, a4, a5, a6, a7),
        admit_subprocess_membrane_digest256(t0, t1, t2, t3, t4, t5, t6, t7),
        admit_subprocess_membrane_digest256(h0, h1, h2, h3, h4, h5, h6, h7),
        admit_subprocess_membrane_digest256(c0, c1, c2, c3, c4, c5, c6, c7),
        admit_subprocess_membrane_digest256(e0, e1, e2, e3, e4, e5, e6, e7),
        admit_subprocess_membrane_digest256(r0, r1, r2, r3, r4, r5, r6, r7),
        admit_subprocess_membrane_digest256(x0, x1, x2, x3, x4, x5, x6, x7),
        admit_subprocess_membrane_digest256(q0, q1, q2, q3, q4, q5, q6, q7),
        admit_subprocess_membrane_digest256(d0, d1, d2, d3, d4, d5, d6, d7),
        admit_subprocess_membrane_digest256(o0, o1, o2, o3, o4, o5, o6, o7),
        admit_subprocess_membrane_digest256(w0, w1, w2, w3, w4, w5, w6, w7),
    )
    let decision = loom_subprocess_membrane_decide(facts, bindings)
    if decision == 0 {
        println("SOUNIO_SUBPROCESS_MEMBRANE_ALLOW code=0 reason=allow stage=" +
            subprocess_membrane_stage_name(stage))
        return 0
    }
    println("SOUNIO_SUBPROCESS_MEMBRANE_DENY code=" +
        subprocess_membrane_code(decision) + " reason=" +
        subprocess_membrane_reason(decision) + " stage=" +
        subprocess_membrane_stage_name(stage))
    decision
}
