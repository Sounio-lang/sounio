//! Packed executable adapter for LOOM action 9049.

fn epoch_decimal(raw: string, start: i64) -> (i64, i64, i64) with Mut, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 { return (if seen { 1 } else { 0 }, value, offset + 1) }
        if code < 48 || code > 57 { return (0, 0, offset) }
        value = value * 10 + (code - 48)
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn epoch_decision(value: i64) -> string {
    if value == 1 { return "ADVANCE" }
    if value == 2 { return "VALID" }
    if value == 711 { return "DENY711" }
    if value == 712 { return "DENY712" }
    if value == 713 { return "DENY713" }
    if value == 714 { return "DENY714" }
    if value == 715 { return "DENY715" }
    if value == 716 { return "DENY716" }
    if value == 717 { return "DENY717" }
    if value == 718 { return "DENY718" }
    if value == 719 { return "DENY719" }
    if value == 720 { return "DENY720" }
    if value == 721 { return "DENY721" }
    "DENY424"
}

var ACTIVATION_EPOCH_LINE_BUFFER: [i8; 4096] = [0; 4096]

fn activation_epoch_read_full_line() -> string with IO, Mut {
    var length: i64 = 0
    var byte = read_byte()
    while byte >= 0 && byte != 10 && length < 4095 {
        ACTIVATION_EPOCH_LINE_BUFFER[length as usize] = byte as i8
        length = length + 1
        byte = read_byte()
    }
    ACTIVATION_EPOCH_LINE_BUFFER[length as usize] = 0
    str_from_bytes(ACTIVATION_EPOCH_LINE_BUFFER, length)
}

fn main() -> i64 with IO, Mut, Panic {
    let raw = activation_epoch_read_full_line()
    let (o0, schema, p0) = epoch_decimal(raw, 0)
    if o0 == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        if loom_activation_epoch_selftest() == 0 {
            println("SOUNIO_ACTIVATION_EPOCH_SELFTEST PASS cases=13")
            return 0
        }
        println("SOUNIO_ACTIVATION_EPOCH_SELFTEST FAIL")
        return 70
    }
    let (o1, mode, p1) = epoch_decimal(raw, p0)
    let (o2, stage, p2) = epoch_decimal(raw, p1)
    let (o3, word, p3) = epoch_decimal(raw, p2)
    let (o4, predecessor, p4) = epoch_decimal(raw, p3)
    let (o5, next_runtime, p5) = epoch_decimal(raw, p4)
    let (o6, pins, p6) = epoch_decimal(raw, p5)
    let (o7, tx, p7) = epoch_decimal(raw, p6)
    let (o8, epoch, p8) = epoch_decimal(raw, p7)
    let (o9, previous_epoch, p9) = epoch_decimal(raw, p8)
    if o0 != 1 || schema != 9049 || o1 != 1 || o2 != 1 || o3 != 1 ||
       o4 != 1 || o5 != 1 || o6 != 1 || o7 != 1 || o8 != 1 || o9 != 1 ||
       mode < 1 || mode > 2 || word < 0 || str_char_at(raw, p9) > 0 {
        println("SOUNIO_ACTIVATION_EPOCH DENY424 reason=malformed-frame semantic_authority=Sounio action=9049")
        return 42
    }
    let decision = judge_loom_activation_epoch_words(
        mode, stage, word, predecessor, next_runtime, pins, tx, epoch, previous_epoch,
    )
    println("SOUNIO_ACTIVATION_EPOCH " + epoch_decision(decision) +
        " semantic_authority=Sounio action=9049")
    if decision == 1 || decision == 2 { return 0 }
    42
}
