//! Executable Sounio adapter for host boot reconciliation action 9041.

fn host_boot_decimal_field(raw: string, start: i64) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn host_boot_decision(decision: i64) -> string {
    if decision == 1 { return "NOOP_ACTIVE" }
    if decision == 2 { return "RECOVER_SAME_PHYSICAL" }
    if decision == 3 { return "HOLD_LINEAGE_REQUIRED" }
    if decision == 4 { return "HOLD_DISABLED" }
    if decision == 5 { return "HOLD_UNENROLLED" }
    if decision == 541 { return "DENY541" }
    if decision == 542 { return "DENY542" }
    if decision == 543 { return "DENY543" }
    if decision == 544 { return "DENY544" }
    if decision == 545 { return "DENY545" }
    if decision == 546 { return "DENY546" }
    if decision == 547 { return "DENY547" }
    if decision == 548 { return "DENY548" }
    if decision == 549 { return "DENY549" }
    "DENY540"
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = host_boot_decimal_field(raw, 0)
    if ok_schema == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        let failed = loom_host_boot_reconciler_selftest()
        if failed == 0 {
            println("SOUNIO_HOST_BOOT_RECONCILER_SELFTEST PASS cases=14")
            return 0
        }
        println("SOUNIO_HOST_BOOT_RECONCILER_SELFTEST FAIL")
        return 70
    }
    let (o1, stage, p1) = host_boot_decimal_field(raw, p0)
    let (o2, preregistered, p2) = host_boot_decimal_field(raw, p1)
    let (o3, producer_sounio, p3) = host_boot_decimal_field(raw, p2)
    let (o4, expected_result_sounio, p4) = host_boot_decimal_field(raw, p3)
    let (o5, python_absent, p5) = host_boot_decimal_field(raw, p4)
    let (o6, rust_absent, p6) = host_boot_decimal_field(raw, p5)
    let (o7, policy_present, p7) = host_boot_decimal_field(raw, p6)
    let (o8, semantics_hash_bound, p8) = host_boot_decimal_field(raw, p7)
    let (o9, runtime_hash_bound, p9) = host_boot_decimal_field(raw, p8)
    let (o10, desired_catalog_bound, p10) = host_boot_decimal_field(raw, p9)
    let (o11, service_enabled, p11) = host_boot_decimal_field(raw, p10)
    let (o12, current_boot_observed, p12) = host_boot_decimal_field(raw, p11)
    let (o13, state_root_bound, p13) = host_boot_decimal_field(raw, p12)
    let (o14, lane_enrolled, p14) = host_boot_decimal_field(raw, p13)
    let (o15, kernel_live, p15) = host_boot_decimal_field(raw, p14)
    let (o16, guardian_live, p16) = host_boot_decimal_field(raw, p15)
    let (o17, guardian_pid_verified, p17) = host_boot_decimal_field(raw, p16)
    let (o18, guardian_start_verified, p18) = host_boot_decimal_field(raw, p17)
    let (o19, guardian_instance_verified, p19) = host_boot_decimal_field(raw, p18)
    let (o20, harness_live, p20) = host_boot_decimal_field(raw, p19)
    let (o21, harness_pid_verified, p21) = host_boot_decimal_field(raw, p20)
    let (o22, harness_start_verified, p22) = host_boot_decimal_field(raw, p21)
    let (o23, command_bound, p23) = host_boot_decimal_field(raw, p22)
    let (o24, boot_equal, p24) = host_boot_decimal_field(raw, p23)
    let (o25, journals_verified, p25) = host_boot_decimal_field(raw, p24)
    let (o26, output_prefix_preserved, p26) = host_boot_decimal_field(raw, p25)
    let (o27, no_same_pty_claim, p27) = host_boot_decimal_field(raw, p26)
    let (o28, material_observation_joined, p28) = host_boot_decimal_field(raw, p27)
    let (o29, sabotage_count, p29) = host_boot_decimal_field(raw, p28)
    let (o30, sabotage_required, p30) = host_boot_decimal_field(raw, p29)
    let valid = ok_schema == 1 && schema == 9041 &&
        o1 == 1 && o2 == 1 && o3 == 1 && o4 == 1 && o5 == 1 &&
        o6 == 1 && o7 == 1 && o8 == 1 && o9 == 1 && o10 == 1 &&
        o11 == 1 && o12 == 1 && o13 == 1 && o14 == 1 && o15 == 1 &&
        o16 == 1 && o17 == 1 && o18 == 1 && o19 == 1 && o20 == 1 &&
        o21 == 1 && o22 == 1 && o23 == 1 && o24 == 1 && o25 == 1 &&
        o26 == 1 && o27 == 1 && o28 == 1 && o29 == 1 && o30 == 1 &&
        str_char_at(raw, p30) <= 0
    if !valid {
        println("SOUNIO_HOST_BOOT_RECONCILER DENY540 reason=malformed-frame")
        return 42
    }
    let observation = loom_host_boot_observation(
        stage, preregistered, producer_sounio, expected_result_sounio,
        python_absent, rust_absent, policy_present, semantics_hash_bound,
        runtime_hash_bound, desired_catalog_bound, service_enabled,
        current_boot_observed, state_root_bound, lane_enrolled, kernel_live,
        guardian_live, guardian_pid_verified, guardian_start_verified,
        guardian_instance_verified, harness_live, harness_pid_verified,
        harness_start_verified, command_bound, boot_equal, journals_verified,
        output_prefix_preserved, no_same_pty_claim,
        material_observation_joined, sabotage_count, sabotage_required,
    )
    let decision = judge_loom_host_boot(observation)
    println("SOUNIO_HOST_BOOT_RECONCILER " + host_boot_decision(decision) +
        " semantic_authority=Sounio action=9041")
    if decision >= 1 && decision <= 5 { 0 } else { 42 }
}
