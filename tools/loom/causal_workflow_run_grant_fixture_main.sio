fn run_grant_parent_bindings() -> string {
    "1636926980 3205986131 3323207532 3505413428 706242987 2411760920 1929815169 3727939342 " +
    "3497534264 556131944 3943529214 1565657389 3821375173 3204015455 2733765994 2625951936 " +
    "4125506095 3601417934 2711931735 20635855 2708941890 3284947684 758124027 2068177262"
