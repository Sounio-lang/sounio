//! Resident dispatcher for frozen Loom actions 9023, 9024, 9025, 9029, 9030,
//! and 9031.
//!
//! The build renames the six frozen single-shot entrypoints mechanically. A
//! route line selects one adapter, which reads its frame without copying it.

var LOOM_RESIDENT_V5_LINE_BUFFER: [i8; 65536] = [0; 65536]

fn resident_membrane_v5_read_line() -> string with IO, Mut {
    var length: i64 = 0
    var byte = read_byte()
    if byte < 0 {
        LOOM_RESIDENT_V5_LINE_BUFFER[0] = 48
        LOOM_RESIDENT_V5_LINE_BUFFER[1] = 0
        return str_from_bytes(LOOM_RESIDENT_V5_LINE_BUFFER, 1)
    }
    while byte >= 0 && byte != 10 && length < 65535 {
        LOOM_RESIDENT_V5_LINE_BUFFER[length as usize] = byte as i8
        length = length + 1
        byte = read_byte()
    }
    if length >= 65535 && byte != 10 {
        while byte >= 0 && byte != 10 {
            byte = read_byte()
        }
        LOOM_RESIDENT_V5_LINE_BUFFER[0] = 120
        LOOM_RESIDENT_V5_LINE_BUFFER[1] = 0
        return str_from_bytes(LOOM_RESIDENT_V5_LINE_BUFFER, 1)
    }
    LOOM_RESIDENT_V5_LINE_BUFFER[length as usize] = 0
    str_from_bytes(LOOM_RESIDENT_V5_LINE_BUFFER, length)
}

fn resident_membrane_v5_malformed() with IO {
    println("SOUNIO_RESIDENT_PROCESS_DENY code=424 reason=malformed-route stage=INVALID")
}

fn main() -> i64 with IO, Mut, Div, Panic {
    while true {
        let route = resident_membrane_v5_read_line()
        let route_code = str_char_at(route, 0)
        if route_code == 48 {
            return 0
        } else if route_code == 49 {
            let ignored_decision = resident_authority_v5_decide_one()
        } else if route_code == 50 {
            let ignored_decision = subprocess_membrane_v5_decide_one()
        } else if route_code == 51 {
            let ignored_decision = effect_closure_v5_decide_one()
        } else if route_code == 52 {
            let ignored_decision = kernel_invocation_cell_v5_decide_one()
        } else if route_code == 53 {
            let ignored_decision = kernel_exec_grant_cell_v5_decide_one()
        } else if route_code == 54 {
            let ignored_decision = kernel_peer_activation_capsule_v5_decide_one()
        } else {
            resident_membrane_v5_malformed()
        }
    }
    0
}
