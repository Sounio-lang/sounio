//! Packed executable adapter for the action-9037 mid-EXEC subordinate contract.

fn mid_exec_decimal_field(raw: string, start: i64) -> (i64, i64, i64) with Mut, Panic {
    var offset = start
    var value: i64 = 0
    var seen: bool = false
    while offset < 65536 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn mid_exec_decision(decision: i64) -> string {
    if decision == 590 { return "DENY590" }
    if decision == 591 { return "DENY591" }
    if decision == 592 { return "DENY592" }
    if decision == 593 { return "DENY593" }
    if decision == 594 { return "DENY594" }
    if decision == 595 { return "DENY595" }
    if decision == 596 { return "DENY596" }
    if decision == 597 { return "DENY597" }
    if decision == 598 { return "DENY598" }
    if decision == 599 { return "DENY599" }
    if decision == 600 { return "DENY600" }
    if decision == 601 { return "DENY601" }
    "DENY424"
}

fn mid_exec_fields(stage: i64) with IO {
    println("LOOM_CAUSAL_WORKFLOW_MID_EXEC_FIELDS_V1")
    println("action=9037")
    println("subordinate_contract=mid-exec-v1")
    if stage == 1 {
        println("decision_stage=RELEASE_ADMISSION")
        println("completion_observed=0")
        println("result_count=0")
        println("attestation_count=0")
    } else {
        println("decision_stage=CLAIM_CONTINUITY")
        println("completion_observed=1")
        println("result_count=1")
        println("attestation_count=1")
    }
    println("exec_started_witness=HostGuardian-generation+unit-InvocationID+material-PID+start-tick+cgroup+run-grant-generation")
    println("barrier_nonce=digest-bound-and-equal")
    println("successor_observation=identical-witness-only")
    println("transport_loss=observed")
    println("compile_count=1")
    println("ticket_count=1")
    println("launch_count=1")
    println("duplicate_launch=refused")
    println("replacement_pid=refused")
    println("replacement_start_tick=refused")
    println("replacement_invocation_id=refused")
    println("unbound_successor=refused")
    println("semantic_authority=Sounio")
    println("material_execution=false")
    println("pod_loss_measured=false")
    println("production_activation=false")
    println("parity_open=false")
    println("claim_ready=false")
}

fn main() -> i64 with IO, Mut, Panic {
    let raw = read_line()
    let (ok_schema, schema, p0) = mid_exec_decimal_field(raw, 0)
    if ok_schema == 1 && schema == 0 && str_char_at(raw, p0) <= 0 {
        if loom_causal_workflow_mid_exec_selftest() == 0 {
            println("SOUNIO_CAUSAL_WORKFLOW_MID_EXEC_SELFTEST PASS cases=11 action=9037 subordinate_contract=mid-exec-v1")
            return 0
        }
        println("SOUNIO_CAUSAL_WORKFLOW_MID_EXEC_SELFTEST FAIL")
        return 70
    }
    let (ok_stage, stage, p1) = mid_exec_decimal_field(raw, p0)
    let (ok_word0, word0, p2) = mid_exec_decimal_field(raw, p1)
    let (ok_word1, word1, p3) = mid_exec_decimal_field(raw, p2)
    if ok_schema != 1 || schema != 9037 || ok_stage != 1 ||
        (stage != 1 && stage != 2) || ok_word0 != 1 || ok_word1 != 1 ||
        word0 < 0 || word1 < 0 || str_char_at(raw, p3) > 0 {
        println("SOUNIO_CAUSAL_WORKFLOW_MID_EXEC DENY424 reason=malformed-frame semantic_authority=Sounio action=9037 subordinate_contract=mid-exec-v1")
        return 42
    }
    let decision = if stage == 1 {
        judge_loom_causal_workflow_mid_exec_release_v1_words(word0, word1)
    } else {
        judge_loom_causal_workflow_mid_exec_claim_v1_words(word0, word1)
    }
    if decision == 1 {
        if stage == 1 {
            println("SOUNIO_CAUSAL_WORKFLOW_MID_EXEC RELEASE semantic_authority=Sounio action=9037 subordinate_contract=mid-exec-v1")
        } else {
            println("SOUNIO_CAUSAL_WORKFLOW_MID_EXEC CONTINUITY semantic_authority=Sounio action=9037 subordinate_contract=mid-exec-v1")
        }
        mid_exec_fields(stage)
        return 0
    }
    println("SOUNIO_CAUSAL_WORKFLOW_MID_EXEC " + mid_exec_decision(decision) +
        " semantic_authority=Sounio action=9037 subordinate_contract=mid-exec-v1")
    42
}
