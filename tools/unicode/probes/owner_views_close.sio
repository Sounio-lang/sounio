// Pending safety-negative: valid owner-view construction must pass first.
// Closing the original owner before reading the carried view must be rejected.
use core::result::{Result}
use collections::byte_buffer::{byte_buffer_new,byte_buffer_close}
use collections::byte_view::{byte_view_new,byte_view_len}
fn main() with IO,Alloc {
 let owner=byte_buffer_new(0)
 match byte_view_new(&owner,0,0) {
  Result::Ok(view)=>{
   byte_buffer_close(owner)
   println(byte_view_len(&view))
  },
  Result::Err(code)=>{byte_buffer_close(owner);println(code)},
 }
}
