// Closing the actual Utf8Text owner before using its carried view is invalid.
// The source ByteBuffer is a separate owner and closes after the match.
use core::result::{Result}
use collections::byte_buffer::{byte_buffer_new,byte_buffer_close}
use text::utf8::{utf8_text_from_bytes,utf8_text_close}
use text::utf8_view::{utf8_view_new,utf8_view_byte_len}
fn main() with IO,Alloc,Mut,Div,Panic {
 let source=byte_buffer_new(0)
 let text=utf8_text_from_bytes(&source,0)
 match utf8_view_new(&text,0,0) {
  Result::Ok(view)=>{
   utf8_text_close(text)
   println(utf8_view_byte_len(&view))
  },
  Result::Err(code)=>{utf8_text_close(text);println(code)},
 }
 byte_buffer_close(source)
}
