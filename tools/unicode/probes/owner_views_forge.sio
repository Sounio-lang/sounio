// Only the defining module may construct a checked ByteView's private fields.
// Invalid interval data must not bypass byte_view_new through a public type.
use collections::byte_buffer::{ByteBuffer,byte_buffer_new,byte_buffer_close}
use collections::byte_view::{ByteView,byte_view_len}
fn forge(owner:&ByteBuffer) with IO {
 let view=ByteView {owner:owner,start:1,size:1}
 println(byte_view_len(&view))
}
fn main() with IO,Alloc {
 let owner=byte_buffer_new(0)
 forge(&owner)
 byte_buffer_close(owner)
}
