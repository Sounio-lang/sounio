//@ run-pass
//@ expect-stdout: LOCALE_RESOLUTION_PROTO_OK
use text::locale_collation::{UnicodeLocaleCollator,unicode_locale_options,unicode_locale_collator,unicode_locale_collator_status,unicode_locale_resolved_locale_len,unicode_locale_resolved_locale_byte_at,unicode_locale_resolved_type_len,unicode_locale_resolved_type_byte_at}
use text::utf8::{Utf8Text,utf8_text_from_string,utf8_text_byte_len,utf8_text_byte_at,utf8_text_close}
fn expect(c:&UnicodeLocaleCollator,locale:&Utf8Text,kind:&Utf8Text) with Panic {
 assert(unicode_locale_collator_status(c)==0)
 assert(unicode_locale_resolved_locale_len(c)==utf8_text_byte_len(locale))
 assert(unicode_locale_resolved_type_len(c)==utf8_text_byte_len(kind))
 var i:i64=0
 while i<utf8_text_byte_len(locale) {let got=unicode_locale_resolved_locale_byte_at(c,i);assert(got.status==0);assert(got.value==utf8_text_byte_at(locale,i).value);i=i+1}
 i=0
 while i<utf8_text_byte_len(kind) {let got=unicode_locale_resolved_type_byte_at(c,i);assert(got.status==0);assert(got.value==utf8_text_byte_at(kind,i).value);i=i+1}
 assert(unicode_locale_resolved_locale_byte_at(c,0-1).status==4)
 assert(unicode_locale_resolved_type_byte_at(c,utf8_text_byte_len(kind)).status==4)
}
fn case(name:string,kind:string,want_name:string,want_kind:string) with Alloc,Mut,Div,Panic {
 let input=utf8_text_from_string(name,512)
 let ty=utf8_text_from_string(kind,512)
 let expected_name=utf8_text_from_string(want_name,512)
 let expected_type=utf8_text_from_string(want_kind,512)
 let options=unicode_locale_options()
 let c=unicode_locale_collator(&input,&ty,&options,8192)
 expect(&c,&expected_name,&expected_type)
 utf8_text_close(input);utf8_text_close(ty);utf8_text_close(expected_name);utf8_text_close(expected_type)
}
fn main() with IO,Alloc,Mut,Div,Panic {
 case("da","phonebook","da","standard")
 case("zh","","zh","pinyin")
 case("zh","standard","root","standard")
 case("zh","PHONEBK","zh","pinyin")
 case("zh-Hant","phonebk","zh","stroke")
 case("da","searchjl","da","search")
 case("el","search","root","search")
 case("el","searchjl","root","search")
 case("ko","searchjl","ko","searchjl")
 case("yue","","zh","stroke")
 case("yue-CN","","zh","pinyin")
 case("","","root","standard")
 let input=utf8_text_from_string("ja",32)
 let ty=utf8_text_from_string("private-kana",32)
 let options=unicode_locale_options()
 assert(unicode_locale_collator_status(&unicode_locale_collator(&input,&ty,&options,8192))==1)
 assert(unicode_locale_collator_status(&unicode_locale_collator(&input,&ty,&options,0))==2)
 utf8_text_close(input);utf8_text_close(ty)
 println("LOCALE_RESOLUTION_PROTO_OK")
}
