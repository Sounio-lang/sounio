//@ run-pass
//@ expect-stdout: CORE_GENERIC_OPTION_RESULT_OK
use core::option::{Option,int_some,int_option_unwrap}
use core::result::{Result,int_ok,int_result_unwrap}
use collections::byte_buffer::{ByteBuffer,byte_buffer_new,byte_buffer_push,byte_buffer_len,byte_buffer_get,byte_buffer_close}
fn option_integer(value:Option<i64>)->i64 {
 match value {
  Option::Some(x)=>{x},
  Option::None=>{0-1},
 }
}
fn option_float(value:Option<f64>)->f64 {
 match value {
  Option::Some(x)=>{x},
  Option::None=>{0.0},
 }
}
fn result_integer(value:Result<i64,i64>)->i64 {
 match value {
  Result::Ok(x)=>{x},
  Result::Err(code)=>{0-code},
 }
}
fn consume_owner(value:Option<Result<ByteBuffer,i64>>)->i64 with Alloc,Panic {
 match value {
  Option::Some(result)=>{
   match result {
    Result::Ok(bytes)=>{
     assert(byte_buffer_len(&bytes)==3)
     assert(byte_buffer_get(&bytes,0).value==65)
     assert(byte_buffer_get(&bytes,1).value==0)
     assert(byte_buffer_get(&bytes,2).value==255)
     byte_buffer_close(bytes)
     1
    },
    Result::Err(code)=>{0-code},
   }
  },
  Option::None=>{0},
 }
}

fn owner_bytes()->ByteBuffer with Alloc,Mut,Div,Panic {
 var bytes=byte_buffer_new(16)
 assert(byte_buffer_push(&!bytes,65)==0)
 assert(byte_buffer_push(&!bytes,0)==0)
 assert(byte_buffer_push(&!bytes,255)==0)
 bytes
}
fn consume_error(value:Result<i64,ByteBuffer>)->i64 with Alloc,Panic {
 match value {
  Result::Ok(number)=>{number},
  Result::Err(bytes)=>{
   assert(byte_buffer_len(&bytes)==3)
   assert(byte_buffer_get(&bytes,1).value==0)
   byte_buffer_close(bytes)
   1
  },
 }
}
fn consume_unit_result(value:Result<(),ByteBuffer>)->i64 with Alloc {
 match value {
  Result::Ok(unit)=>{0},
  Result::Err(bytes)=>{byte_buffer_close(bytes);1},
 }
}

fn main() with IO,Alloc,Mut,Div,Panic {
 let concrete_option=int_some(7)
 assert(int_option_unwrap(&concrete_option)==7)
 let concrete_result=int_ok(11)
 assert(int_result_unwrap(&concrete_result)==11)
 let first:Option<i64> =Option::Some(42)
 let second:Option<f64> =Option::Some(0.5)
 let absent:Option<i64> =Option::None
 assert(option_integer(first)==42)
 assert(option_float(second)==0.5)
 assert(option_integer(absent)==0-1)
 let good:Result<i64,i64> =Result::Ok(19)
 let bad:Result<i64,i64> =Result::Err(23)
 assert(result_integer(good)==19)
 assert(result_integer(bad)==0-23)
 let bytes=owner_bytes()
 let nested:Option<Result<ByteBuffer,i64>> =Option::Some(Result::Ok(bytes))
 assert(consume_owner(nested)==1)
 let error_owner:Result<i64,ByteBuffer> = Result::Err(owner_bytes())
 assert(consume_error(error_owner)==1)
 let unit_owner:Result<(),ByteBuffer> = Result::Ok(())
 assert(consume_unit_result(unit_owner)==0)
 // Copy instantiations stay reusable after linear instantiations exist.
 assert(option_integer(first)==42)
 assert(option_float(second)==0.5)
 assert(result_integer(good)==19)
 println("CORE_GENERIC_OPTION_RESULT_OK")
}

