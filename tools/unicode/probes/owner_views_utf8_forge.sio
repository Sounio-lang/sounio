// Reject forged private UTF-8 span fields, which could bypass scalar boundaries.
use text::utf8::{Utf8Text,utf8_text_new,utf8_text_close}
use text::utf8_view::{Utf8View,utf8_view_byte_len}
fn forge(owner:&Utf8Text) with IO {
 let view=Utf8View {owner:owner,start:1,size:1}
 println(utf8_view_byte_len(&view))
}
fn main() with IO,Alloc {
 let owner=utf8_text_new(0)
 forge(&owner)
 utf8_text_close(owner)
}
