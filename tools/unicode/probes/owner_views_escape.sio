// Reject an owner-bound Result escaping the block that owns its ByteBuffer.
// E091 is required; a linear-cleanup diagnostic alone is not this lifetime proof.
use core::result::{Result}
use collections::byte_buffer::{byte_buffer_new}
use collections::byte_view::{ByteView,byte_view_new,byte_view_len}
fn main() with IO,Alloc {
 let escaped:Result<ByteView,i64> = {
  let owner=byte_buffer_new(0)
  byte_view_new(&owner,0,0)
 }
 match escaped {
  Result::Ok(view)=>{println(byte_view_len(&view))},
  Result::Err(code)=>{println(code)},
 }
}
