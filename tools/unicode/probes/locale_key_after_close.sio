//@ compile-fail
//@ error-pattern: E039
use text::utf8::{utf8_text_from_string,utf8_text_close}
use text::locale_collation::{unicode_locale_options,unicode_locale_collator,unicode_locale_collation_key,unicode_locale_key_close,unicode_locale_key_len}
fn main() with IO,Alloc,Mut,Div,Panic {
 let input=utf8_text_from_string("a",128)
 let name=utf8_text_from_string("root",128)
 let kind=utf8_text_from_string("standard",128)
 let options=unicode_locale_options()
 let c=unicode_locale_collator(&name,&kind,&options,8192)
 let key=unicode_locale_collation_key(&c,&input,65536,65536)
 unicode_locale_key_close(key)
 println(unicode_locale_key_len(&key))
 utf8_text_close(input);utf8_text_close(name);utf8_text_close(kind)
}

