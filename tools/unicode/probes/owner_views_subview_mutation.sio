// Reject mutation through the original owner while only a carried subview
// remains used. This checks provenance forwarding after the parent's last use.
use core::result::{Result}
use collections::byte_buffer::{byte_buffer_new,byte_buffer_push,byte_buffer_close}
use collections::byte_view::{byte_view_new,byte_view_slice,byte_view_len}
fn main() with IO,Alloc,Mut,Div,Panic {
 var owner=byte_buffer_new(8)
 match byte_view_new(&owner,0,0) {
  Result::Ok(view)=>{
   match byte_view_slice(&view,0,0) {
    Result::Ok(part)=>{
     assert(byte_buffer_push(&!owner,65)==0)
     println(byte_view_len(&part))
    },
    Result::Err(code)=>{println(code)},
   }
  },
  Result::Err(code)=>{println(code)},
 }
 byte_buffer_close(owner)
}
