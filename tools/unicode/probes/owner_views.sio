//@ run-pass
//@ expect-stdout: OWNER_VIEWS_OK
use core::result::{Result}
use collections::byte_buffer::{ByteBuffer,byte_buffer_new,byte_buffer_push,byte_buffer_len,byte_buffer_close}
use collections::byte_view::{byte_view_new,byte_view_len,byte_view_get,byte_view_slice}
use text::utf8::{Utf8Text,utf8_text_from_bytes,utf8_text_status,utf8_text_close}
use text::utf8_view::{utf8_view_new,utf8_view_byte_len,utf8_view_byte_at,utf8_view_next,utf8_view_scalar_len,utf8_view_slice}
fn check_bytes(owner:&ByteBuffer) with Panic {
 match byte_view_new(owner,0,byte_buffer_len(owner)) {
  Result::Ok(view)=>{
   assert(byte_view_len(&view)==8)
   assert(byte_view_get(&view,1).value==0)
   assert(byte_view_get(&view,8).status==4)
   match byte_view_slice(&view,2,4) {
    Result::Ok(part)=>{assert(byte_view_len(&part)==2);assert(byte_view_get(&part,0).value==195);assert(byte_view_get(&part,1).value==169)},
    Result::Err(code)=>{assert(code==0)},
   }
   match byte_view_slice(&view,8,8) {Result::Ok(empty)=>{assert(byte_view_len(&empty)==0)},Result::Err(code)=>{assert(code==0)}}
   match byte_view_slice(&view,0-1,2) {Result::Ok(invalid)=>{assert(false)},Result::Err(code)=>{assert(code==4)}}
  },
  Result::Err(code)=>{assert(code==0)},
 }
}
fn check_text(owner:&Utf8Text) with Panic {
 match utf8_view_new(owner,0,8) {
  Result::Ok(view)=>{
   assert(utf8_view_byte_len(&view)==8)
   assert(utf8_view_scalar_len(&view)==4)
   assert(utf8_view_byte_at(&view,1).value==0)
   assert(utf8_view_next(&view,0).codepoint==65)
   assert(utf8_view_next(&view,1).codepoint==0)
   assert(utf8_view_next(&view,2).codepoint==233)
   assert(utf8_view_next(&view,4).codepoint==128512)
   assert(utf8_view_next(&view,8).status==4)
   match utf8_view_slice(&view,2,8) {Result::Ok(part)=>{assert(utf8_view_scalar_len(&part)==2);assert(utf8_view_next(&part,0).next==2);assert(utf8_view_next(&part,2).next==6)},Result::Err(code)=>{assert(code==0)}}
   match utf8_view_slice(&view,2,3) {Result::Ok(invalid)=>{assert(false)},Result::Err(code)=>{assert(code==5)}}
   match utf8_view_slice(&view,3,4) {Result::Ok(invalid)=>{assert(false)},Result::Err(code)=>{assert(code==5)}}
  },
  Result::Err(code)=>{assert(code==0)},
 }
}
fn main() with IO,Alloc,Mut,Div,Panic {
 var source=byte_buffer_new(8)
 assert(byte_buffer_push(&!source,65)==0)
 assert(byte_buffer_push(&!source,0)==0)
 assert(byte_buffer_push(&!source,195)==0)
 assert(byte_buffer_push(&!source,169)==0)
 assert(byte_buffer_push(&!source,240)==0)
 assert(byte_buffer_push(&!source,159)==0)
 assert(byte_buffer_push(&!source,152)==0)
 assert(byte_buffer_push(&!source,128)==0)
 check_bytes(&source)
 let text=utf8_text_from_bytes(&source,8)
 assert(utf8_text_status(&text)==0)
 check_text(&text)
 utf8_text_close(text)
 byte_buffer_close(source)
 println("OWNER_VIEWS_OK")
}
