//@ run-pass
//@ requires: madaros
//@ expect-stdout: UTF8_SOURCE_STRING_OK
use text::utf8::{utf8_text_from_string,utf8_text_status,utf8_text_byte_len,utf8_text_scalar_len,utf8_text_byte_at,utf8_text_close}
fn main() with Alloc,Mut,Div,Panic,IO {
 let text=utf8_text_from_string("é😀",6)
 assert(utf8_text_status(&text)==0)
 assert(utf8_text_byte_len(&text)==6)
 assert(utf8_text_scalar_len(&text)==2)
 assert(utf8_text_byte_at(&text,0).value==195)
 assert(utf8_text_byte_at(&text,1).value==169)
 assert(utf8_text_byte_at(&text,2).value==240)
 assert(utf8_text_byte_at(&text,3).value==159)
 assert(utf8_text_byte_at(&text,4).value==152)
 assert(utf8_text_byte_at(&text,5).value==128)
 utf8_text_close(text)
 let nul=utf8_text_from_string("a\0b",3)
 assert(utf8_text_status(&nul)==0)
 assert(utf8_text_byte_len(&nul)==3)
 assert(utf8_text_scalar_len(&nul)==3)
 assert(utf8_text_byte_at(&nul,1).value==0)
 assert(utf8_text_byte_at(&nul,2).value==98)
 utf8_text_close(nul)
 let malformed=utf8_text_from_string("\xC0\x80",2)
 assert(utf8_text_status(&malformed)==5)
 assert(utf8_text_byte_len(&malformed)==0)
 utf8_text_close(malformed)
 print("UTF8_SOURCE_STRING_OK\n")
}
