{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.dev/schemas/diagnostic.v1.json",
  "title": "Sounio diagnostic record (v1)",
  "description": "Canonical wire format for diagnostics produced by `souc check --json`, the in-process compiler library API, and consumed by the LSP server (CC-1) and the MCP server (CC-2). Stable across both surfaces; CC-1 owns this file.",
  "type": "object",
  "required": ["schema", "uri", "diagnostics"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "sounio.diagnostic.v1",
      "description": "Schema discriminator. Bump on breaking changes."
    },
    "uri": {
      "type": "string",
      "description": "file:// URI of the source unit. Percent-decoded path must point at an existing .sio file (no validation on read; consumers decide)."
    },
    "version": {
      "type": ["integer", "null"],
      "description": "Document version when the diagnostics were produced. Matches the LSP textDocument.version. Null for one-shot CLI invocations."
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/Diagnostic" }
    },
    "epistemic": {
      "type": ["object", "null"],
      "description": "Aggregate epistemic confidence tier counters for the file (PLATINUM/GOLD/SILVER/BRONZE/KNIGHTIAN). Present for full checks, null for inspect/symbols.",
      "additionalProperties": false,
      "properties": {
        "platinum": { "type": "integer", "minimum": 0 },
        "gold":     { "type": "integer", "minimum": 0 },
        "silver":   { "type": "integer", "minimum": 0 },
        "bronze":   { "type": "integer", "minimum": 0 },
        "knightian": { "type": "integer", "minimum": 0 },
        "gate":     { "type": "integer", "minimum": 0, "maximum": 1000 },
        "mean":     { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    }
  },
  "$defs": {
    "Position": {
      "type": "object",
      "required": ["line", "character"],
      "additionalProperties": false,
      "properties": {
        "line":      { "type": "integer", "minimum": 0, "description": "Zero-based line number (LSP convention)." },
        "character": { "type": "integer", "minimum": 0, "description": "Zero-based UTF-16 code-unit offset within the line (LSP convention)." }
      }
    },
    "Range": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "$ref": "#/$defs/Position" },
        "end":   { "$ref": "#/$defs/Position" }
      }
    },
    "Diagnostic": {
      "type": "object",
      "required": ["severity", "code", "message", "range", "source"],
      "additionalProperties": false,
      "properties": {
        "severity": {
          "type": "integer",
          "enum": [1, 2, 3, 4],
          "description": "1=Error, 2=Warning, 3=Information, 4=Hint. Matches LSP DiagnosticSeverity."
        },
        "code": {
          "type": "string",
          "pattern": "^[EWIH][0-9]{3,5}$",
          "description": "Stable diagnostic code. Prefix indicates severity class: E=error, W=warning, I=info, H=hint. Numeric part is monotonic per class."
        },
        "message": { "type": "string", "maxLength": 4096 },
        "range":   { "$ref": "#/$defs/Range" },
        "source":  {
          "type": "string",
          "enum": ["sounio:lex", "sounio:parse", "sounio:resolve", "sounio:type", "sounio:effect", "sounio:epistemic", "sounio:lower", "sounio:codegen", "sounio:lint"],
          "description": "Compiler phase that produced the diagnostic."
        },
        "tags": {
          "type": "array",
          "items": { "type": "integer", "enum": [1, 2] },
          "description": "LSP DiagnosticTag values: 1=Unnecessary, 2=Deprecated."
        },
        "related": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["uri", "range", "message"],
            "additionalProperties": false,
            "properties": {
              "uri":     { "type": "string" },
              "range":   { "$ref": "#/$defs/Range" },
              "message": { "type": "string", "maxLength": 1024 }
            }
          }
        },
        "confidence": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 1000,
          "description": "Epistemic confidence (0-1000) attached by the type-checker. Null for diagnostics that predate the epistemic gate (lex/parse)."
        }
      }
    }
  }
}
