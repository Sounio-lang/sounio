//@ run-pass
use ir::ir::*
use hlir::ir::*
use hlir::native_bridge::*

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let semantic = ir_xor_convolution_s_virtual(7, 11, 13)
    if semantic.op != IrOpcode::IrXorConvolutionS
        || semantic.dst != 7 || semantic.src1 != 11 || semantic.src2 != 13
        || semantic.imm_i64 != 4
        || semantic.label_id != 0
        || (semantic.imm_flags & 255) != IR_XOR_TWIST_CAYLEY_DICKSON_SIGN
        || ((semantic.imm_flags >> 8) & 255) != IR_XOR_CANDIDATE_AUTO {
        print("PIREUS_SEDENION_OPERATOR_IR_FAIL semantic_ir\n")
        return 1
    }

    let ptr3 = ir_xor_convolution_s_virtual_ptr3(17, 19, 21)
    if ptr3.op != IrOpcode::IrXorConvolutionS
        || ptr3.dst != 17 || ptr3.src1 != 19 || ptr3.src2 != 21
        || ptr3.label_id != 1
        || ((ptr3.imm_flags >> 8) & 255) != IR_XOR_CANDIDATE_AUTO {
        print("PIREUS_SEDENION_OPERATOR_IR_FAIL ptr3_abi\n")
        return 1
    }

    var args: [i64; 64] = [HLIR_INVALID_VALUE; 64]
    args[0] = 21
    args[1] = 22
    args[2] = 23
    let h = hlir_instr_xor_convolution_call_direct(
        24, hlir_empty_name(), args, 3, hlir_type_void(),
        hlir_cayley_dickson_xor_convolution(4), HLIR_XOR_CANDIDATE_AUTO)
    let bridged = hlir_xor_convolution_to_native_ir(h, hlir_xor_native_layout_xeon())
    if !bridged.accepted || bridged.instr.op != IrOpcode::IrXorConvolutionS {
        print("PIREUS_SEDENION_OPERATOR_IR_FAIL hlir_bridge\n")
        return 1
    }
    print("schema=pireus-sedenion-operator-ir-v1\n")
    print("producer_language=Sounio\n")
    print("source_operator=mul algebra=Sedenion bits=4 twist=CayleyDicksonSign\n")
    print("semantic_ir=IrXorConvolutionS candidate=auto generic_abi=0 ptr3_abi=1\n")
    print("PIREUS_SEDENION_OPERATOR_IR_PASS\n")
    0
}
