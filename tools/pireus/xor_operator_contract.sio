// First executable Pireus operator-generation contract.
pub enum XorTwist {
    CayleyDicksonSign,
}

pub enum XorLowering {
    WarpShuffle,
    GlobalLoad,
}

pub struct XorConvolution {
    pub bits: i64,
    pub twist: XorTwist,
}

pub struct XorCandidateSet {
    pub contract: XorConvolution,
    pub first: XorLowering,
    pub second: XorLowering,
    pub count: i64,
}

pub fn pireus_xor4_cd_foundry() -> XorCandidateSet {
    XorCandidateSet {
        contract: XorConvolution { bits: 4, twist: XorTwist::CayleyDicksonSign },
        first: XorLowering::WarpShuffle,
        second: XorLowering::GlobalLoad,
        count: 2,
    }
}

fn main() -> i32 with IO {
    let candidates = pireus_xor4_cd_foundry()
    if candidates.contract.bits == 4 && candidates.count == 2 {
        print("PIREUS_XOR_OPERATOR_CONTRACT_PASS\n")
        return 0
    }
    print("PIREUS_XOR_OPERATOR_CONTRACT_FAIL\n")
    1
}
