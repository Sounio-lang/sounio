// Sounio semantic authority for every basis pair in the bits=4
// Cayley-Dickson sign-twisted XOR product.
fn cd_sign(a: i64, b: i64, bits: i64) -> i64 {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cd_sign(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cd_sign(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cd_sign(a_lo, 0, bits - 1) }
        return 0 - cd_sign(a_lo, b_lo, bits - 1)
    }
    if b_lo == 0 { return 0 - cd_sign(0, a_lo, bits - 1) }
    cd_sign(b_lo, a_lo, bits - 1)
}

fn basis_lane_value(a: i64, b: i64, d: i64) -> i64 {
    var sum: i64 = 0
    var i: i64 = 0
    while i < 16 {
        let ai = if i == a { 1 } else { 0 }
        let j = i ^ d
        let bj = if j == b { 1 } else { 0 }
        sum = sum + cd_sign(i, j, 4) * ai * bj
        i = i + 1
    }
    sum
}

fn main() -> i32 with IO {
    var failures: i64 = 0
    var pair_count: i64 = 0
    var negative_count: i64 = 0
    var checksum: i64 = 0
    var a: i64 = 0
    while a < 16 {
        var b: i64 = 0
        while b < 16 {
            let expected_lane = a ^ b
            let expected_sign = cd_sign(a, b, 4)
            var nonzero_lanes: i64 = 0
            var d: i64 = 0
            while d < 16 {
                let got = basis_lane_value(a, b, d)
                if got != 0 { nonzero_lanes = nonzero_lanes + 1 }
                if d == expected_lane {
                    if got != expected_sign { failures = failures + 1 }
                } else if got != 0 {
                    failures = failures + 1
                }
                d = d + 1
            }
            if nonzero_lanes != 1 { failures = failures + 1 }
            if expected_sign < 0 { negative_count = negative_count + 1 }
            checksum = checksum + (a * 16 + b + 1) * expected_sign * (expected_lane + 1)
            pair_count = pair_count + 1
            b = b + 1
        }
        a = a + 1
    }

    print("schema=pireus-xor-basis4-semantics-v1\n")
    print("producer_language=Sounio\n")
    print("producer_role=SEMANTIC_AUTHORITY\n")
    print("bits=4\n")
    print("twist=CayleyDicksonSign\n")
    print("basis_pairs="); print_int(pair_count); print("\n")
    print("negative_pairs="); print_int(negative_count); print("\n")
    print("signed_lane_checksum="); print_int(checksum); print("\n")
    print("failures="); print_int(failures); print("\n")
    if failures == 0 && pair_count == 256 {
        print("PIREUS_XOR_BASIS4_AUTHORITY_PASS\n")
        return 0
    }
    print("PIREUS_XOR_BASIS4_AUTHORITY_FAIL\n")
    1
}
