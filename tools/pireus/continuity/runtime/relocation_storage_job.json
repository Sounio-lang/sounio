{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "pireus-pg-storage-canary-20260907",
    "namespace": "beagle"
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 600,
    "template": {
      "spec": {
        "restartPolicy": "Never",
        "automountServiceAccountToken": false,
        "nodeSelector": {
          "kubernetes.io/hostname": "r770-proxmox"
        },
        "tolerations": [
          {
            "key": "sounio.dev/pool",
            "operator": "Equal",
            "value": "gpu-batch",
            "effect": "NoSchedule"
          },
          {
            "key": "sounio.dev/compute",
            "operator": "Equal",
            "value": "heavy",
            "effect": "NoSchedule"
          }
        ],
        "containers": [
          {
            "name": "probe",
            "image": "paradedb/paradedb@sha256:ea4e8267016c929924a15df03eaf2ad9bb2cda9d194169e03eca232303898cc7",
            "command": [
              "/bin/bash",
              "-ec"
            ],
            "args": [
              "set -e\nmkdir /qualification/pireus-storage-canary-20260907\ncd /qualification/pireus-storage-canary-20260907\ndate -u +%FT%TZ\ndd if=/dev/urandom of=integrity.bin bs=1M count=1024 conv=fsync\nsha256sum integrity.bin > integrity.sha256\nsync\nsha256sum -c integrity.sha256\npg_test_fsync -s 2 -f fsync.test\ndate -u +%FT%TZ\n"
            ],
            "volumeMounts": [
              {
                "name": "qualification",
                "mountPath": "/qualification"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "250m",
                "memory": "128Mi"
              },
              "limits": {
                "cpu": "1",
                "memory": "1Gi"
              }
            }
          }
        ],
        "volumes": [
          {
            "name": "qualification",
            "persistentVolumeClaim": {
              "claimName": "pireus-pg-relocation-data"
            }
          }
        ]
      }
    }
  }
}
