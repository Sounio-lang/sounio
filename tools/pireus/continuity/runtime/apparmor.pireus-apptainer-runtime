# PIREUS Slurm runtime, non-setuid Apptainer 1.5.3.
# Based on the official Apptainer Ubuntu package profile.
# Scope only the pinned runtime starter; retain the host-wide userns restriction.
abi <abi/4.0>,
include <tunables/global>
profile pireus-apptainer-runtime /scratch/pireus/runtime/apptainer-1.5.3/usr/libexec/apptainer/bin/starter flags=(unconfined) {
  userns,
}
