// Sounio produces reference inputs and outputs; adapters only move their bits.
// 256 basis pairs, 32 dense finite vectors, and 32 numerical edge vectors.
use algebra::cayley_dickson::cd_sigma
fn edge(i: i64) -> f64 with Div {
    if i == 0 { return 0.0 }
    if i == 1 { return bits_to_f64(1 << 63) }
    if i == 2 { return 1.0 }
    if i == 3 { return -1.0 }
    if i == 4 { return 1.0e-300 }
    if i == 5 { return -1.0e-300 }
    if i == 6 { return 1.0e300 }
    if i == 7 { return -1.0e300 }
    if i == 8 { return 1.0e-160 }
    if i == 9 { return -1.0e-160 }
    if i == 10 { return bits_to_f64(4503599627370496) }
    if i == 11 { return bits_to_f64(1) }
    if i == 12 { return bits_to_f64(9218868437227405311) }
    if i == 13 { return bits_to_f64(9218868437227405312) }
    if i == 14 { return bits_to_f64(-4503599627370496) }
    bits_to_f64(9221120237041090561)
}
fn main() -> i32 with IO, Mut, Panic, Div {
    var v: i64 = 0
    while v < 320 {
        var a: [f64; 16] = [0.0; 16]
        var b: [f64; 16] = [0.0; 16]
        var i: i64 = 0
        while i < 16 {
            if v < 256 {
                if i == v / 16 { a[i as usize] = 1.0 }
                if i == v % 16 { b[i as usize] = 1.0 }
            } else if v < 288 {
                a[i as usize] = ((v * 17 + i * 29) % 97 - 48) as f64 / 13.0
                b[i as usize] = ((v * 31 + i * 7) % 89 - 44) as f64 / 11.0
            } else if v < 304 {
                a[i as usize] = edge(v - 288)
                b[i as usize] = if i % 2 == 0 { 2.0 } else { -2.0 }
            } else {
                if i == v % 16 { a[i as usize] = edge(v - 304) }
                b[i as usize] = if i % 2 == 0 { 1.0e-160 } else { 1.0e160 }
            }
            i = i + 1
        }
        var out: [f64; 16] = [0.0; 16]
        var k: i64 = 0
        while k < 16 {
            var sum = 0.0
            var j: i64 = 0
            while j < 16 {
                let product = a[(k ^ j) as usize] * b[j as usize]
                let signed_product = product * (cd_sigma((k ^ j) as i32, j as i32, 4) as f64)
                sum = sum + signed_product
                j = j + 1
            }
            out[k as usize] = sum
            k = k + 1
        }
        print("{\"index\":"); print_int(v); print(",\"a_bits\":[")
        i = 0
        while i < 16 { if i > 0 { print(",") }; print_int(f64_to_bits(a[i as usize])); i = i + 1 }
        print("],\"b_bits\":[")
        i = 0
        while i < 16 { if i > 0 { print(",") }; print_int(f64_to_bits(b[i as usize])); i = i + 1 }
        print("],\"output_bits\":[")
        i = 0
        while i < 16 { if i > 0 { print(",") }; print_int(f64_to_bits(out[i as usize])); i = i + 1 }
        print("]}\n")
        v = v + 1
    }
    0
}
