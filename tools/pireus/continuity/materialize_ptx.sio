// Sounio-owned material probe for admitted Pireus plans.
// One block of 16 threads computes one Sedenion (two with pack=1). Grid x is vector count.
// The arithmetic sequence matches the canonical ascending-j GPU experiment:
// product=a[i]*b[j]; signed=product*sigma(i,j); sum=sum+signed.
// Explicit .rn instructions preserve separate multiply and addition.
use algebra::cayley_dickson::cd_sigma

fn address_index(layout: i64, coefficient: string) with IO {
    if layout == 0 {
        print("    mad.lo.u32 %r7, %r1, 16, "); print(coefficient); print(";\n")
    } else {
        print("    mad.lo.u32 %r7, "); print(coefficient); print(", %r2, %r1;\n")
    }
}

// Bilinear phase computation i^T B j mod 2 over F2^4
fn ptx_bilinear(code: i64, x: i64, y: i64) -> i64 with Mut {
    var s: i64 = 0
    var i: i64 = 0
    while i < 4 {
        if ((x >> i) & 1) == 1 {
            var j: i64 = 0
            while j < 4 {
                if ((y >> j) & 1) == 1 { s = s ^ ((code >> (i * 4 + j)) & 1) }
                j = j + 1
            }
        }
        i = i + 1
    }
    s
}

// Structure coefficient with bilinear phase twist
fn ptx_sigma_phase(code: i64, a: i64, b: i64) -> i64 with Mut, Panic, Div {
    let base = cd_sigma(a as i32, b as i32, 4) as i64
    if ptx_bilinear(code, a, b) == 1 { return 0 - base }
    base
}

// sm_121 keeps the original header bytes. sm_86 and sm_75 change that line only.
fn emit_ptx_header(sm: i64) with IO {
    if sm == 121 {
        print(".version 9.0\n.target sm_121\n.address_size 64\n")
        return
    }
    if sm == 86 {
        print(".version 9.0\n.target sm_86\n.address_size 64\n")
        return
    }
    if sm == 75 {
        print(".version 9.0\n.target sm_75\n.address_size 64\n")
        return
    }
    print("UNSUPPORTED_SM\n")
}

// The per-lane sign table: pireus_signs (sign_mode=0) or pireus_lane_signs (sign_mode=1).
fn emit_sign_table(phase: i64, sign_mode: i64) with IO, Mut, Panic, Div {
    if sign_mode == 1 {
        // Entry k holds bit j set when sigma(k^j, j) < 0: one word per output lane,
        // read once. Each term then adds or subtracts the product; a + (-p) and
        // a - p are the same IEEE operation, so the bits match the sign multiply.
        print("// PIREUS material probe: f64 mul, per-lane fixed add/sub; ascending j; no FMA.\n")
        print(".const .align 4 .u32 pireus_lane_signs[16] = {")
        var k: i64 = 0
        while k < 16 {
            var mask: i64 = 0
            var j: i64 = 0
            while j < 16 {
                if ptx_sigma_phase(phase, (k ^ j) as i64, j as i64) < 0 { mask = mask | (1 << j) }
                j = j + 1
            }
            if k > 0 { print(",") }
            print_int(mask)
            k = k + 1
        }
    } else {
        print("// PIREUS material probe: f64 mul, sign mul, add; ascending j; no FMA.\n")
        print(".const .align 4 .u32 pireus_signs[16] = {")
        var j: i64 = 0
        while j < 16 {
            var mask: i64 = 0
            var k: i64 = 0
            while k < 16 {
                if ptx_sigma_phase(phase, (k ^ j) as i64, j as i64) < 0 { mask = mask | (1 << k) }
                k = k + 1
            }
            if j > 0 { print(",") }
            print_int(mask)
            j = j + 1
        }
    }
}

fn emit_lowering_body(sm: i64, stride: i64, offset: i64, load: i64, layout: i64, unroll: i64, phase: i64, sign_mode: i64, pack: i64, vector_load: i64) with IO, Mut, Panic, Div {
    if load == 2 {
        emit_staged_body(sm, stride, offset, layout, unroll, phase, sign_mode, pack, vector_load)
        return
    }
    if pack == 1 {
        emit_packed_body(sm, stride, offset, load, layout, unroll, phase, sign_mode)
        return
    }
    emit_ptx_header(sm)
    emit_sign_table(phase, sign_mode)
    print("};\n.visible .entry pireus_candidate(.param .u64 pa, .param .u64 pb, .param .u64 pc)\n.maxntid 16,1,1\n{\n")
    print("    .reg .b32 %r<32>;\n    .reg .b64 %rd<16>;\n    .reg .f64 %fd<8>;\n    .reg .pred %p<4>;\n")
    print("    ld.param.u64 %rd0, [pa];\n    ld.param.u64 %rd1, [pb];\n    ld.param.u64 %rd2, [pc];\n")
    print("    mov.u32 %r0, %tid.x;\n    mov.u32 %r1, %ctaid.x;\n    mov.u32 %r2, %nctaid.x;\n")
    print("    setp.gt.u32 %p0, %r2, 16777216;\n    @%p0 bra DONE;\n")
    print("    mad.lo.u32 %r3, %r0, "); print_int(stride); print(", "); print_int(offset); print(";\n    and.b32 %r3, %r3, 15;\n")
    var inverse: i64 = 1
    while (inverse * stride) % 16 != 1 { inverse = inverse + 2 }
    if load == 1 {
        address_index(layout, "%r3")
        print("    mul.wide.u32 %rd3, %r7, 8;\n    add.u64 %rd3, %rd1, %rd3;\n    ld.global.f64 %fd2, [%rd3];\n")
        print("    mov.b64 {%r11,%r12}, %fd2;\n")
    }
    if sign_mode == 1 {
        print("    mov.u64 %rd4, pireus_lane_signs;\n    mul.wide.u32 %rd5, %r3, 4;\n    add.u64 %rd4, %rd4, %rd5;\n    ld.const.u32 %r14, [%rd4];\n")
    }
    print("    mov.f64 %fd0, 0d0000000000000000;\n    mov.u32 %r4, 0;\nLOOP:\n")
    var u: i64 = 0
    while u < unroll {
        print("    add.u32 %r5, %r4, "); print_int(u); print(";\n    xor.b32 %r6, %r3, %r5;\n")
        address_index(layout, "%r6")
        print("    mul.wide.u32 %rd3, %r7, 8;\n    add.u64 %rd3, %rd0, %rd3;\n    ld.global.f64 %fd1, [%rd3];\n")
        if load == 0 {
            address_index(layout, "%r5")
            print("    mul.wide.u32 %rd3, %r7, 8;\n    add.u64 %rd3, %rd1, %rd3;\n    ld.global.f64 %fd2, [%rd3];\n")
        } else {
            print("    sub.u32 %r8, %r5, "); print_int(offset); print(";\n")
            print("    mul.lo.u32 %r8, %r8, "); print_int(inverse); print(";\n    and.b32 %r8, %r8, 15;\n")
            print("    shfl.sync.idx.b32 %r9, %r11, %r8, 15, 65535;\n    shfl.sync.idx.b32 %r10, %r12, %r8, 15, 65535;\n")
            print("    mov.b64 %fd2, {%r9,%r10};\n")
        }
        print("    mul.rn.f64 %fd3, %fd1, %fd2;\n")
        if sign_mode == 1 {
            // unroll is 16 here, so the loop runs once with %r4 = 0 and j = u.
            print("    and.b32 %r13, %r14, "); print_int(1 << u); print(";\n    setp.ne.u32 %p1, %r13, 0;\n")
            print("    @%p1 sub.rn.f64 %fd0, %fd0, %fd3;\n    @!%p1 add.rn.f64 %fd0, %fd0, %fd3;\n")
        } else {
            print("    mov.u64 %rd4, pireus_signs;\n    mul.wide.u32 %rd5, %r5, 4;\n    add.u64 %rd4, %rd4, %rd5;\n    ld.const.u32 %r13, [%rd4];\n")
            print("    shr.u32 %r13, %r13, %r3;\n    and.b32 %r13, %r13, 1;\n    setp.ne.u32 %p1, %r13, 0;\n")
            print("    selp.f64 %fd4, 0dBFF0000000000000, 0d3FF0000000000000, %p1;\n")
            print("    mul.rn.f64 %fd3, %fd3, %fd4;\n    add.rn.f64 %fd0, %fd0, %fd3;\n")
        }
        u = u + 1
    }
    if unroll < 16 {
        print("    add.u32 %r4, %r4, "); print_int(unroll); print(";\n    setp.lt.u32 %p2, %r4, 16;\n    @%p2 bra LOOP;\n")
    }
    address_index(layout, "%r3")
    print("    mul.wide.u32 %rd3, %r7, 8;\n    add.u64 %rd3, %rd2, %rd3;\n    st.global.f64 [%rd3], %fd0;\nDONE:\n    ret;\n}\n")
}

// Vector B of a packed block: same as address_index, vector register %r15, result %r17.
fn address_index_b(layout: i64, coefficient: string) with IO {
    if layout == 0 {
        print("    mad.lo.u32 %r17, %r15, 16, "); print(coefficient); print(";\n")
    } else {
        print("    mad.lo.u32 %r17, "); print(coefficient); print(", %r2, %r15;\n")
    }
}

// pack=1. The launch stays grid = vector count, block = 16 (gpu_probe.py is frozen),
// so block c computes vectors 2c (A, %r1) and min(2c+1, n-1) (B, %r15) and blocks
// with 2c >= n leave at once. Every lane k runs both vectors' terms interleaved in
// ascending j; each vector keeps its own accumulator and the same operation order
// as the unpacked kernel, and the sign for (k, j) is shared because it depends on
// neither vector. An odd tail computes the last vector twice and stores equal bits.
fn emit_packed_body(sm: i64, stride: i64, offset: i64, load: i64, layout: i64, unroll: i64, phase: i64, sign_mode: i64) with IO, Mut, Panic, Div {
    emit_ptx_header(sm)
    emit_sign_table(phase, sign_mode)
    print("};\n// pack=1: two vectors per 16-lane block, interleaved, separate accumulators.\n")
    print(".visible .entry pireus_candidate(.param .u64 pa, .param .u64 pb, .param .u64 pc)\n.maxntid 16,1,1\n{\n")
    print("    .reg .b32 %r<32>;\n    .reg .b64 %rd<16>;\n    .reg .f64 %fd<16>;\n    .reg .pred %p<4>;\n")
    print("    ld.param.u64 %rd0, [pa];\n    ld.param.u64 %rd1, [pb];\n    ld.param.u64 %rd2, [pc];\n")
    print("    mov.u32 %r0, %tid.x;\n    mov.u32 %r1, %ctaid.x;\n    mov.u32 %r2, %nctaid.x;\n")
    print("    setp.gt.u32 %p0, %r2, 16777216;\n    @%p0 bra DONE;\n")
    print("    shl.b32 %r1, %r1, 1;\n    setp.ge.u32 %p3, %r1, %r2;\n    @%p3 bra DONE;\n")
    print("    add.u32 %r15, %r1, 1;\n    sub.u32 %r16, %r2, 1;\n    min.u32 %r15, %r15, %r16;\n")
    print("    mad.lo.u32 %r3, %r0, "); print_int(stride); print(", "); print_int(offset); print(";\n    and.b32 %r3, %r3, 15;\n")
    var inverse: i64 = 1
    while (inverse * stride) % 16 != 1 { inverse = inverse + 2 }
    if load == 1 {
        address_index(layout, "%r3")
        print("    mul.wide.u32 %rd3, %r7, 8;\n    add.u64 %rd3, %rd1, %rd3;\n    ld.global.f64 %fd2, [%rd3];\n")
        print("    mov.b64 {%r11,%r12}, %fd2;\n")
        address_index_b(layout, "%r3")
        print("    mul.wide.u32 %rd6, %r17, 8;\n    add.u64 %rd6, %rd1, %rd6;\n    ld.global.f64 %fd7, [%rd6];\n")
        print("    mov.b64 {%r18,%r19}, %fd7;\n")
    }
    if sign_mode == 1 {
        print("    mov.u64 %rd4, pireus_lane_signs;\n    mul.wide.u32 %rd5, %r3, 4;\n    add.u64 %rd4, %rd4, %rd5;\n    ld.const.u32 %r14, [%rd4];\n")
    }
    print("    mov.f64 %fd0, 0d0000000000000000;\n    mov.f64 %fd5, 0d0000000000000000;\n    mov.u32 %r4, 0;\nLOOP:\n")
    var u: i64 = 0
    while u < unroll {
        print("    add.u32 %r5, %r4, "); print_int(u); print(";\n    xor.b32 %r6, %r3, %r5;\n")
        address_index(layout, "%r6")
        print("    mul.wide.u32 %rd3, %r7, 8;\n    add.u64 %rd3, %rd0, %rd3;\n    ld.global.f64 %fd1, [%rd3];\n")
        address_index_b(layout, "%r6")
        print("    mul.wide.u32 %rd6, %r17, 8;\n    add.u64 %rd6, %rd0, %rd6;\n    ld.global.f64 %fd6, [%rd6];\n")
        if load == 0 {
            address_index(layout, "%r5")
            print("    mul.wide.u32 %rd3, %r7, 8;\n    add.u64 %rd3, %rd1, %rd3;\n    ld.global.f64 %fd2, [%rd3];\n")
            address_index_b(layout, "%r5")
            print("    mul.wide.u32 %rd6, %r17, 8;\n    add.u64 %rd6, %rd1, %rd6;\n    ld.global.f64 %fd7, [%rd6];\n")
        } else {
            print("    sub.u32 %r8, %r5, "); print_int(offset); print(";\n")
            print("    mul.lo.u32 %r8, %r8, "); print_int(inverse); print(";\n    and.b32 %r8, %r8, 15;\n")
            print("    shfl.sync.idx.b32 %r9, %r11, %r8, 15, 65535;\n    shfl.sync.idx.b32 %r10, %r12, %r8, 15, 65535;\n")
            print("    mov.b64 %fd2, {%r9,%r10};\n")
            print("    shfl.sync.idx.b32 %r20, %r18, %r8, 15, 65535;\n    shfl.sync.idx.b32 %r21, %r19, %r8, 15, 65535;\n")
            print("    mov.b64 %fd7, {%r20,%r21};\n")
        }
        print("    mul.rn.f64 %fd3, %fd1, %fd2;\n    mul.rn.f64 %fd8, %fd6, %fd7;\n")
        if sign_mode == 1 {
            print("    and.b32 %r13, %r14, "); print_int(1 << u); print(";\n    setp.ne.u32 %p1, %r13, 0;\n")
            print("    @%p1 sub.rn.f64 %fd0, %fd0, %fd3;\n    @!%p1 add.rn.f64 %fd0, %fd0, %fd3;\n")
            print("    @%p1 sub.rn.f64 %fd5, %fd5, %fd8;\n    @!%p1 add.rn.f64 %fd5, %fd5, %fd8;\n")
        } else {
            print("    mov.u64 %rd4, pireus_signs;\n    mul.wide.u32 %rd5, %r5, 4;\n    add.u64 %rd4, %rd4, %rd5;\n    ld.const.u32 %r13, [%rd4];\n")
            print("    shr.u32 %r13, %r13, %r3;\n    and.b32 %r13, %r13, 1;\n    setp.ne.u32 %p1, %r13, 0;\n")
            print("    selp.f64 %fd4, 0dBFF0000000000000, 0d3FF0000000000000, %p1;\n")
            print("    mul.rn.f64 %fd3, %fd3, %fd4;\n    add.rn.f64 %fd0, %fd0, %fd3;\n")
            print("    mul.rn.f64 %fd8, %fd8, %fd4;\n    add.rn.f64 %fd5, %fd5, %fd8;\n")
        }
        u = u + 1
    }
    if unroll < 16 {
        print("    add.u32 %r4, %r4, "); print_int(unroll); print(";\n    setp.lt.u32 %p2, %r4, 16;\n    @%p2 bra LOOP;\n")
    }
    address_index(layout, "%r3")
    print("    mul.wide.u32 %rd3, %r7, 8;\n    add.u64 %rd3, %rd2, %rd3;\n    st.global.f64 [%rd3], %fd0;\n")
    address_index_b(layout, "%r3")
    print("    mul.wide.u32 %rd6, %r17, 8;\n    add.u64 %rd6, %rd2, %rd6;\n    st.global.f64 [%rd6], %fd5;\nDONE:\n    ret;\n}\n")
}

// Per-term sign for both accumulators (B only when packed); shared by every body.
fn emit_signed_accumulate(u: i64, sign_mode: i64, pack: i64) with IO {
    if sign_mode == 1 {
        print("    and.b32 %r13, %r14, "); print_int(1 << u); print(";\n    setp.ne.u32 %p1, %r13, 0;\n")
        print("    @%p1 sub.rn.f64 %fd0, %fd0, %fd3;\n    @!%p1 add.rn.f64 %fd0, %fd0, %fd3;\n")
        if pack == 1 {
            print("    @%p1 sub.rn.f64 %fd5, %fd5, %fd8;\n    @!%p1 add.rn.f64 %fd5, %fd5, %fd8;\n")
        }
    } else {
        print("    mov.u64 %rd4, pireus_signs;\n    mul.wide.u32 %rd5, %r5, 4;\n    add.u64 %rd4, %rd4, %rd5;\n    ld.const.u32 %r13, [%rd4];\n")
        print("    shr.u32 %r13, %r13, %r3;\n    and.b32 %r13, %r13, 1;\n    setp.ne.u32 %p1, %r13, 0;\n")
        print("    selp.f64 %fd4, 0dBFF0000000000000, 0d3FF0000000000000, %p1;\n")
        print("    mul.rn.f64 %fd3, %fd3, %fd4;\n    add.rn.f64 %fd0, %fd0, %fd3;\n")
        if pack == 1 {
            print("    mul.rn.f64 %fd8, %fd8, %fd4;\n    add.rn.f64 %fd5, %fd5, %fd8;\n")
        }
    }
}

// load=2. Lane k loads coefficient k of a and b (of both vectors when packed) once,
// stores them to shared memory, and bar.sync 0 publishes them to the block; every
// term then reads a[k^j] and b[j] from shared memory. Only where the operands come
// from changes: the multiply, sign and add sequence per vector is the unpacked one.
// vector_load=1 (SoA, pack=1): coefficient k of vectors 2c and 2c+1 is adjacent, so
// one ld.global.v2.f64 reads both. It needs a 16-byte aligned pair, which holds when
// the vector count n is even; an odd n takes the scalar staging path instead. Early
// exits happen before bar.sync and are uniform per block.
fn emit_staged_body(sm: i64, stride: i64, offset: i64, layout: i64, unroll: i64, phase: i64, sign_mode: i64, pack: i64, vector_load: i64) with IO, Mut, Panic, Div {
    emit_ptx_header(sm)
    emit_sign_table(phase, sign_mode)
    print("};\n// load=2: a and b staged in shared memory, then bar.sync.")
    if pack == 1 { print(" pack=1: two vectors per 16-lane block.") }
    if vector_load == 1 { print(" vector_load=1: ld.global.v2.f64 when n is even.") }
    print("\n")
    if pack == 1 {
        print(".shared .align 16 .f64 pireus_sa[32];\n.shared .align 16 .f64 pireus_sb[32];\n")
    } else {
        print(".shared .align 16 .f64 pireus_sa[16];\n.shared .align 16 .f64 pireus_sb[16];\n")
    }
    print(".visible .entry pireus_candidate(.param .u64 pa, .param .u64 pb, .param .u64 pc)\n.maxntid 16,1,1\n{\n")
    print("    .reg .b32 %r<32>;\n    .reg .b64 %rd<16>;\n    .reg .f64 %fd<16>;\n    .reg .pred %p<4>;\n")
    print("    ld.param.u64 %rd0, [pa];\n    ld.param.u64 %rd1, [pb];\n    ld.param.u64 %rd2, [pc];\n")
    print("    mov.u32 %r0, %tid.x;\n    mov.u32 %r1, %ctaid.x;\n    mov.u32 %r2, %nctaid.x;\n")
    print("    setp.gt.u32 %p0, %r2, 16777216;\n    @%p0 bra DONE;\n")
    if pack == 1 {
        print("    shl.b32 %r1, %r1, 1;\n    setp.ge.u32 %p3, %r1, %r2;\n    @%p3 bra DONE;\n")
        print("    add.u32 %r15, %r1, 1;\n    sub.u32 %r16, %r2, 1;\n    min.u32 %r15, %r15, %r16;\n")
    }
    print("    mad.lo.u32 %r3, %r0, "); print_int(stride); print(", "); print_int(offset); print(";\n    and.b32 %r3, %r3, 15;\n")
    if vector_load == 1 {
        print("    and.b32 %r22, %r2, 1;\n    setp.ne.u32 %p2, %r22, 0;\n    @%p2 bra SCALAR;\n")
        address_index(layout, "%r3")
        print("    mul.wide.u32 %rd3, %r7, 8;\n    add.u64 %rd6, %rd0, %rd3;\n    ld.global.v2.f64 {%fd1,%fd6}, [%rd6];\n")
        print("    add.u64 %rd7, %rd1, %rd3;\n    ld.global.v2.f64 {%fd2,%fd7}, [%rd7];\n    bra STAGED;\nSCALAR:\n")
    }
    address_index(layout, "%r3")
    print("    mul.wide.u32 %rd3, %r7, 8;\n    add.u64 %rd6, %rd0, %rd3;\n    ld.global.f64 %fd1, [%rd6];\n")
    print("    add.u64 %rd7, %rd1, %rd3;\n    ld.global.f64 %fd2, [%rd7];\n")
    if pack == 1 {
        address_index_b(layout, "%r3")
        print("    mul.wide.u32 %rd3, %r17, 8;\n    add.u64 %rd6, %rd0, %rd3;\n    ld.global.f64 %fd6, [%rd6];\n")
        print("    add.u64 %rd7, %rd1, %rd3;\n    ld.global.f64 %fd7, [%rd7];\n")
    }
    if vector_load == 1 { print("STAGED:\n") }
    print("    mov.u64 %rd8, pireus_sa;\n    mov.u64 %rd9, pireus_sb;\n    mul.wide.u32 %rd10, %r3, 8;\n")
    print("    add.u64 %rd11, %rd8, %rd10;\n    st.shared.f64 [%rd11], %fd1;\n    add.u64 %rd12, %rd9, %rd10;\n    st.shared.f64 [%rd12], %fd2;\n")
    if pack == 1 {
        print("    add.u64 %rd11, %rd11, 128;\n    st.shared.f64 [%rd11], %fd6;\n    add.u64 %rd12, %rd12, 128;\n    st.shared.f64 [%rd12], %fd7;\n")
    }
    print("    bar.sync 0;\n")
    if sign_mode == 1 {
        print("    mov.u64 %rd4, pireus_lane_signs;\n    mul.wide.u32 %rd5, %r3, 4;\n    add.u64 %rd4, %rd4, %rd5;\n    ld.const.u32 %r14, [%rd4];\n")
    }
    print("    mov.f64 %fd0, 0d0000000000000000;\n")
    if pack == 1 { print("    mov.f64 %fd5, 0d0000000000000000;\n") }
    print("    mov.u32 %r4, 0;\nLOOP:\n")
    var u: i64 = 0
    while u < unroll {
        print("    add.u32 %r5, %r4, "); print_int(u); print(";\n    xor.b32 %r6, %r3, %r5;\n")
        print("    mul.wide.u32 %rd10, %r6, 8;\n    add.u64 %rd11, %rd8, %rd10;\n    ld.shared.f64 %fd1, [%rd11];\n")
        print("    mul.wide.u32 %rd10, %r5, 8;\n    add.u64 %rd12, %rd9, %rd10;\n    ld.shared.f64 %fd2, [%rd12];\n")
        if pack == 1 {
            print("    add.u64 %rd11, %rd11, 128;\n    ld.shared.f64 %fd6, [%rd11];\n    add.u64 %rd12, %rd12, 128;\n    ld.shared.f64 %fd7, [%rd12];\n")
        }
        print("    mul.rn.f64 %fd3, %fd1, %fd2;\n")
        if pack == 1 { print("    mul.rn.f64 %fd8, %fd6, %fd7;\n") }
        emit_signed_accumulate(u, sign_mode, pack)
        u = u + 1
    }
    if unroll < 16 {
        print("    add.u32 %r4, %r4, "); print_int(unroll); print(";\n    setp.lt.u32 %p2, %r4, 16;\n    @%p2 bra LOOP;\n")
    }
    address_index(layout, "%r3")
    print("    mul.wide.u32 %rd3, %r7, 8;\n    add.u64 %rd3, %rd2, %rd3;\n    st.global.f64 [%rd3], %fd0;\n")
    if pack == 1 {
        address_index_b(layout, "%r3")
        print("    mul.wide.u32 %rd6, %r17, 8;\n    add.u64 %rd6, %rd2, %rd6;\n    st.global.f64 [%rd6], %fd5;\n")
    }
    print("DONE:\n    ret;\n}\n")
}

pub fn emit_lowering_ptx(stride: i64, offset: i64, load: i64, layout: i64, unroll: i64, phase: i64, sign_mode: i64, pack: i64, vector_load: i64) with IO, Mut, Panic, Div {
    emit_lowering_body(121, stride, offset, load, layout, unroll, phase, sign_mode, pack, vector_load)
}

pub fn emit_lowering_ptx_sm(sm: i64, stride: i64, offset: i64, load: i64, layout: i64, unroll: i64, phase: i64, sign_mode: i64, pack: i64, vector_load: i64) with IO, Mut, Panic, Div {
    if sm != 121 && sm != 86 && sm != 75 {
        print("UNSUPPORTED_SM\n")
        return
    }
    emit_lowering_body(sm, stride, offset, load, layout, unroll, phase, sign_mode, pack, vector_load)
}
