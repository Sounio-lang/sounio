// External proposals are data. This executable owns admission and reconstruction.
// Protocol v1 is a bounded JSON object: ASCII keys, nonnegative integer values,
// and one lowercase SHA256 context string. Unknown/duplicate keys are refused.
use algebra::cayley_dickson::cd_sigma
use materialize_ptx::{emit_lowering_ptx, emit_lowering_ptx_sm, emit_lowering_ptx_wide}
use crypto::sha256::{sha256_init, sha256_update, sha256_finalize, SHA256Digest}

struct Document {
    values: [i64; 21],
    seen: i64,
    context: [i64; 64],
    valid: bool,
}
fn key_name(i: i64) -> string {
    if i == 0 { return "schema" }
    if i == 1 { return "target" }
    if i == 2 { return "dimension" }
    if i == 3 { return "precision" }
    if i == 4 { return "order" }
    if i == 5 { return "fma" }
    if i == 6 { return "capabilities" }
    if i == 7 { return "lane_width" }
    if i == 8 { return "facts_state" }
    if i == 9 { return "kind" }
    if i == 10 { return "lane_stride" }
    if i == 11 { return "lane_offset" }
    if i == 12 { return "load" }
    if i == 13 { return "layout" }
    if i == 14 { return "unroll" }
    if i == 15 { return "context" }
    // kind=2 only. The bilinear phase code naming the proposed operator.
    if i == 16 { return "phase" }
    // Optional, both kinds. 0 (or absent) = sign table, 1 = per-lane fixed add/sub.
    if i == 17 { return "sign_mode" }
    // Optional, both kinds. 0 (or absent) = one vector per block, 1 = two vectors per block.
    if i == 18 { return "pack" }
    // Optional, both kinds. 1 = ld.global.v2.f64 staging (load=2, SoA, pack=1 only).
    if i == 19 { return "vector_load" }
    // Optional, both kinds. 0, 16 (or absent) = gpu_probe.py's 16-thread block;
    // 32, 64, 128 = the r740-only wide launch (r740_wide_launch.py), never a Spark path.
    if i == 20 { return "block_threads" }
    "UNKNOWN"
}
fn whitespace(c: i64) -> bool { c == 32 || c == 9 || c == 10 || c == 13 }
fn skip(s: string, p: i64, n: i64) -> i64 with Mut {
    var x = p
    while x < n && whitespace(str_char_at(s, x)) { x = x + 1 }
    x
}
fn parse(s: string, n: i64) -> Document with Mut, Panic, Div {
    var d = Document { values: [0; 21], seen: 0, context: [0; 64], valid: false }
    if n <= 0 || n > 4096 || str_len(s) != n { return d }
    var p = skip(s, 0, n)
    if p >= n || str_char_at(s, p) != 123 { return d }
    p = p + 1
    var count: i64 = 0
    while count < 21 {
        p = skip(s, p, n)
        if p >= n || str_char_at(s, p) != 34 { return d }
        p = p + 1
        let start = p
        while p < n && str_char_at(s, p) != 34 {
            let c = str_char_at(s, p)
            if !((c >= 97 && c <= 122) || c == 95) { return d }
            p = p + 1
        }
        if p >= n { return d }
        var key: i64 = -1
        var k: i64 = 0
        while k < 21 {
            let name = key_name(k)
            if str_len(name) == p - start {
                var same = true
                var j: i64 = 0
                while j < p - start {
                    if str_char_at(name, j) != str_char_at(s, start + j) { same = false }
                    j = j + 1
                }
                if same { key = k }
            }
            k = k + 1
        }
        if key < 0 { return d }
        if (d.seen & (1 << key)) != 0 { return d }
        d.seen = d.seen | (1 << key)
        p = skip(s, p + 1, n)
        if p >= n || str_char_at(s, p) != 58 { return d }
        p = skip(s, p + 1, n)
        if p >= n { return d }
        if key == 15 {
            if str_char_at(s, p) != 34 { return d }
            p = p + 1
            var j: i64 = 0
            while j < 64 {
                if p >= n { return d }
                let c = str_char_at(s, p)
                if !((c >= 48 && c <= 57) || (c >= 97 && c <= 102)) { return d }
                d.context[j as usize] = c
                p = p + 1
                j = j + 1
            }
            if p >= n || str_char_at(s, p) != 34 { return d }
            p = p + 1
        } else {
            let first = p
            var value: i64 = 0
            while p < n && str_char_at(s, p) >= 48 && str_char_at(s, p) <= 57 {
                if p - first >= 9 { return d }
                value = value * 10 + str_char_at(s, p) - 48
                p = p + 1
            }
            if first == p { return d }
            if p - first > 1 && str_char_at(s, first) == 48 { return d }
            d.values[key as usize] = value
        }
        count = count + 1
        p = skip(s, p, n)
        if p >= n { return d }
        if str_char_at(s, p) == 125 {
            if skip(s, p + 1, n) != n { return d }
            d.valid = true
            return d
        }
        if str_char_at(s, p) != 44 { return d }
        p = p + 1
    }
    d
}
fn hash_text(s: string, n: i64) -> SHA256Digest with Mut, Panic, Div {
    var state = sha256_init()
    var p: i64 = 0
    while p < n {
        var chunk: [u8; 256] = [0; 256]
        var count: i64 = 0
        while p < n && count < 256 {
            chunk[count as usize] = str_char_at(s, p) as u8
            count = count + 1
            p = p + 1
        }
        state = sha256_update(state, chunk, count as i32)
    }
    sha256_finalize(state)
}
fn hex_char(n: i64) -> i64 { if n < 10 { 48 + n } else { 87 + n } }
fn hash_matches(d: SHA256Digest, proposal: &Document) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < 32 {
        let b = d.bytes[i as usize] as i64
        if proposal.context[(i * 2) as usize] != hex_char(b / 16) { return false }
        if proposal.context[(i * 2 + 1) as usize] != hex_char(b % 16) { return false }
        i = i + 1
    }
    true
}
fn print_digest(d: SHA256Digest) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < 32 {
        let b = d.bytes[i as usize] as i64
        print_char(hex_char(b / 16) as i32)
        print_char(hex_char(b % 16) as i32)
        i = i + 1
    }
}
// The bilinear phase i^T B j over F2^4, B given by the 16-bit phase code.
// Bit (i*4 + j) of the code is the coefficient B[i][j].
fn bilinear(code: i64, x: i64, y: i64) -> i64 with Mut {
    var s: i64 = 0
    var i: i64 = 0
    while i < 4 {
        if ((x >> i) & 1) == 1 {
            var j: i64 = 0
            while j < 4 {
                if ((y >> j) & 1) == 1 { s = s ^ ((code >> (i * 4 + j)) & 1) }
                j = j + 1
            }
        }
        i = i + 1
    }
    s
}
// Structure coefficient of the operator the proposal names.
// Phase code 0 returns cd_sigma unchanged, so kind=1 is unaffected.
fn sigma_phase(code: i64, a: i64, b: i64) -> i64 with Mut, Panic, Div {
    let base = cd_sigma(a as i32, b as i32, 4) as i64
    if bilinear(code, a, b) == 1 { return 0 - base }
    base
}
// "ptx" is the historical sm_121 mode. ptx-sm86 and ptx-sm75 select a header
// after the same admission checks. They do not admit a new target identity.
fn mode_sm(mode: string) -> i64 with Mut, Panic {
    let n = str_len(mode)
    if n == 3 && str_char_at(mode, 0) == 112 && str_char_at(mode, 1) == 116 && str_char_at(mode, 2) == 120 { return 121 }
    if n == 8 && str_char_at(mode, 0) == 112 && str_char_at(mode, 1) == 116 && str_char_at(mode, 2) == 120 && str_char_at(mode, 3) == 45 && str_char_at(mode, 4) == 115 && str_char_at(mode, 5) == 109 && str_char_at(mode, 6) == 56 && str_char_at(mode, 7) == 54 { return 86 }
    if n == 8 && str_char_at(mode, 0) == 112 && str_char_at(mode, 1) == 116 && str_char_at(mode, 2) == 120 && str_char_at(mode, 3) == 45 && str_char_at(mode, 4) == 115 && str_char_at(mode, 5) == 109 && str_char_at(mode, 6) == 55 && str_char_at(mode, 7) == 53 { return 75 }
    0
}
fn refuse(reason: string) -> i32 with IO {
    print("{\"schema\":1,\"authority\":\"Sounio\",\"decision\":\"REFUSE\",\"reason\":\"")
    print(reason); print("\"}\n")
    1
}
fn main() -> i32 with IO, Mut, Panic, Div {
    if arg_count() != 2 && arg_count() != 3 { return refuse("ARGUMENTS") }
    var materialize = false
    var sm: i64 = 121
    if arg_count() == 3 {
        sm = mode_sm(get_arg(2))
        if sm == 0 { return refuse("MODE") }
        materialize = true
    }
    let cp = get_arg(0)
    let pp = get_arg(1)
    let cn = file_size(cp)
    let pn = file_size(pp)
    if cn <= 0 || cn > 4096 || pn <= 0 || pn > 4096 { return refuse("SIZE") }
    let cs = read_file(cp)
    let ps = read_file(pp)
    let c = parse(cs, cn)
    let p = parse(ps, pn)
    if !c.valid || c.seen != 511 { return refuse("CONTEXT_FORMAT") }
    // Proposal fields 0..5 and 9..15; context-only fields cannot be overridden.
    // 65087 = fields 0..5 and 9..15 (kind=1). 130623 adds field 16 (kind=2).
    // Fields 6,7,8 stay context-only under both masks.
    if !p.valid { return refuse("PROPOSAL_FORMAT") }
    // Bits 17 (131072) sign_mode, 18 (262144) pack, 19 (524288) vector_load and
    // 20 (1048576) block_threads are optional keys; absent means 0 and keeps the frozen bytes.
    let core = p.seen & (0 - 1 - 131072 - 262144 - 524288 - 1048576)
    if core != 65087 && core != 130623 { return refuse("PROPOSAL_FORMAT") }
    if !hash_matches(hash_text(cs, cn), &p) { return refuse("SNAPSHOT") }
    if c.values[0] != 1 || p.values[0] != 1 { return refuse("SCHEMA") }
    if c.values[1] != 701202 || p.values[1] != c.values[1] { return refuse("TARGET") }
    if c.values[2] != 16 || p.values[2] != 16 { return refuse("DIMENSION") }
    if c.values[3] != 64 || p.values[3] != 64 { return refuse("PRECISION") }
    // order=1 means output k, ascending right operand j, left i=k XOR j.
    if c.values[4] != 1 || p.values[4] != 1 { return refuse("ORDER") }
    if c.values[5] != 0 || p.values[5] != 0 { return refuse("FMA") }
    if c.values[8] != 1 { return refuse("UNKNOWN_OR_CONTRADICTORY_FACTS") }
    if c.values[6] < 0 || c.values[6] > 63 || c.values[7] != 32 { return refuse("CAPABILITY") }
    let kind = p.values[9]
    if kind != 1 && kind != 2 { return refuse("KIND") }
    // The phase key is present exactly when kind is 2, and never otherwise.
    if kind == 1 && core != 65087 { return refuse("KIND_MASK") }
    if kind == 2 && core != 130623 { return refuse("KIND_MASK") }
    let phase = p.values[16]
    if kind == 2 && (phase < 0 || phase > 65535) { return refuse("PHASE_RANGE") }
    let stride = p.values[10]
    let offset = p.values[11]
    let load = p.values[12]
    let layout = p.values[13]
    let unroll = p.values[14]
    if stride < 1 || stride > 15 || stride % 2 != 1 || offset > 15 { return refuse("LANE_MAP") }
    // load 0 direct, 1 shuffle, 2 staged through shared memory then bar.sync.
    if load > 2 || layout > 1 { return refuse("GRAMMAR") }
    if unroll != 1 && unroll != 2 && unroll != 4 && unroll != 8 && unroll != 16 { return refuse("UNROLL") }
    // sign_mode=1 needs j known at compile time, so only the fully unrolled loop admits it.
    let sign_mode = p.values[17]
    if sign_mode > 1 { return refuse("SIGN_MODE") }
    if sign_mode == 1 && unroll != 16 { return refuse("SIGN_MODE_UNROLL") }
    // pack=1: each 16-thread block computes vectors 2c and 2c+1 (the launch is fixed
    // at 16 threads by gpu_probe.py, so the pair shares the lanes, not a wider block).
    let pack = p.values[18]
    if pack > 1 { return refuse("PACK") }
    // vector_load=1 loads coefficient k of vectors 2c and 2c+1 with one
    // ld.global.v2.f64: adjacent only in SoA, and both needed only under pack.
    let vector_load = p.values[19]
    if vector_load > 1 { return refuse("VECTOR_LOAD") }
    if vector_load == 1 && load != 2 { return refuse("VECTOR_LOAD_LOAD") }
    if vector_load == 1 && layout != 1 { return refuse("VECTOR_LOAD_LAYOUT") }
    if vector_load == 1 && pack != 1 { return refuse("VECTOR_LOAD_PACK") }
    // block_threads: 0 or 16 is the historical 16-thread block and changes nothing.
    // 32, 64 and 128 put threads/16 vectors in one block (32 is the full-warp pack) and
    // exist only for the r740 launch, so the sm_121 Spark mode refuses them, and the
    // 16-lane pack and its v2 load are refused there (the wide block replaces them).
    let block_threads = p.values[20]
    var wide: i64 = 0
    if block_threads == 32 { wide = 1 }
    if block_threads == 64 { wide = 2 }
    if block_threads == 128 { wide = 3 }
    if wide == 0 && block_threads != 0 && block_threads != 16 { return refuse("BLOCK_THREADS") }
    if wide > 0 && pack != 0 { return refuse("BLOCK_THREADS_PACK") }
    if wide > 0 && materialize && sm == 121 { return refuse("BLOCK_THREADS_TARGET") }
    var required: i64 = 39
    if load == 1 { required = required | 16 }
    if (c.values[6] & required) != required { return refuse("CAPABILITY") }
    var lanes: [i64; 16] = [0; 16]
    var lane: i64 = 0
    while lane < 16 {
        let k = (lane * stride + offset) % 16
        lanes[k as usize] = lanes[k as usize] + 1
        lane = lane + 1
    }
    var i: i64 = 0
    while i < 16 {
        if lanes[i as usize] != 1 { return refuse("LANE_COVERAGE") }
        i = i + 1
    }
    // Reconstruct every coefficient in labeled basis order (a,b,k).
    // Algebraic tensor parity alone does not establish floating-point parity.
    // Canonical tensor encoding cd16-abk-offset1-v1: a,b,k ascending, one
    // byte per coefficient; -1 maps to 0, 0 to 1, +1 to 2. This is injective
    // on the admitted coefficient set. No tensor/hash is accepted from the LLM.
    // kind=1 keeps the Cayley-Dickson constant; kind=2 twists it by the phase.
    var twist: i64 = 0
    if kind == 2 { twist = phase }
    var state = sha256_init()
    var a: i64 = 0
    var failures: i64 = 0
    while a < 16 {
        var block: [u8; 256] = [0; 256]
        var b: i64 = 0
        while b < 16 {
            var k: i64 = 0
            while k < 16 {
                var reconstructed: i64 = 0
                lane = 0
                while lane < 16 {
                    let output = (lane * stride + offset) % 16
                    if output == k && (output ^ b) == a {
                        reconstructed = reconstructed + sigma_phase(twist, a, b)
                    }
                    lane = lane + 1
                }
                var expected: i64 = 0
                if (a ^ b) == k { expected = sigma_phase(twist, a, b) }
                if reconstructed != expected { failures = failures + 1 }
                block[(b * 16 + k) as usize] = (reconstructed + 1) as u8
                k = k + 1
            }
            b = b + 1
        }
        state = sha256_update(state, block, 256)
        a = a + 1
    }
    if failures != 0 { return refuse("TENSOR") }
    if materialize {
        // emit_lowering_ptx modulates the signs with the phase twist.
        // For kind=1 twist is 0 (pure Cayley-Dickson); for kind=2 twist is the operator phase.
        if wide > 0 { emit_lowering_ptx_wide(sm, block_threads, stride, offset, load, layout, unroll, twist, sign_mode) }
        else {
            if sm == 121 { emit_lowering_ptx(stride, offset, load, layout, unroll, twist, sign_mode, pack, vector_load) }
            else { emit_lowering_ptx_sm(sm, stride, offset, load, layout, unroll, twist, sign_mode, pack, vector_load) }
        }
        return 0
    }
    // sign_mode=0, pack=0 and load<2 keep every historical plan_id; each extension adds
    // its own bit, and load=2 takes bit 18 instead of entering the load digit.
    var load_digit: i64 = load
    var staged: i64 = 0
    if load == 2 {
        load_digit = 0
        staged = 1
    }
    let plan_id = (((stride * 16 + offset) * 2 + load_digit) * 2 + layout) * 32 + unroll + sign_mode * 65536 + pack * 131072 + staged * 262144 + vector_load * 524288 + wide * 1048576
    if kind == 2 {
        print("{\"schema\":1,\"authority\":\"Sounio\",\"decision\":\"ADMIT\",\"kind\":\"operator\",\"phase_code\":")
        print_int(phase)
        print(",\"plan_id\":")
        print_int(plan_id)
        if sign_mode == 1 { print(",\"sign_mode\":1") }
        if pack == 1 { print(",\"pack\":1") }
        if load == 2 { print(",\"load\":2") }
        if vector_load == 1 { print(",\"vector_load\":1") }
        if wide > 0 { print(",\"block_threads\":"); print_int(block_threads) }
        print(",\"tensor_components\":4096,\"tensor_encoding\":\"cd16-abk-offset1-v1\",\"tensor_sha256\":\"")
        print_digest(sha256_finalize(state))
        print("\",\"context_sha256\":\""); print_digest(hash_text(cs, cn))
        print("\",\"proposal_sha256\":\""); print_digest(hash_text(ps, pn))
        // This engine establishes well-definedness only. Novelty needs the
        // GL(4,2) atlas and is decided by eisa_h.pireus_operator_atlas.v1.
        print("\",\"novelty\":\"NOT_CLASSIFIED\"")
        print(",\"classifier\":\"eisa_h.pireus_operator_atlas.v1\"")
        print(",\"fp_parity\":\"UNMEASURED\",\"claim_ready\":false,\"formal_v13_v14\":\"OPEN\"}\n")
        return 0
    }
    print("{\"schema\":1,\"authority\":\"Sounio\",\"decision\":\"ADMIT\",\"kind\":\"lowering\",\"plan_id\":")
    print_int(plan_id)
    if sign_mode == 1 { print(",\"sign_mode\":1") }
    if pack == 1 { print(",\"pack\":1") }
    if load == 2 { print(",\"load\":2") }
    if vector_load == 1 { print(",\"vector_load\":1") }
    if wide > 0 { print(",\"block_threads\":"); print_int(block_threads) }
    print(",\"tensor_components\":4096,\"tensor_encoding\":\"cd16-abk-offset1-v1\",\"tensor_sha256\":\"")
    print_digest(sha256_finalize(state))
    print("\",\"context_sha256\":\""); print_digest(hash_text(cs, cn))
    print("\",\"proposal_sha256\":\""); print_digest(hash_text(ps, pn))
    print("\",\"fp_parity\":\"UNMEASURED\",\"claim_ready\":false,\"formal_v13_v14\":\"OPEN\"}\n")
    0
}
