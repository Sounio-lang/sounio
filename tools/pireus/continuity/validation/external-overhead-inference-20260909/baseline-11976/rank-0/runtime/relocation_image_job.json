{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "pireus-pg-image-qualification-20260907",
    "namespace": "beagle"
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 900,
    "template": {
      "spec": {
        "restartPolicy": "Never",
        "automountServiceAccountToken": false,
        "nodeSelector": {
          "kubernetes.io/hostname": "r770-proxmox"
        },
        "containers": [
          {
            "name": "inspect",
            "image": "paradedb/paradedb@sha256:ea4e8267016c929924a15df03eaf2ad9bb2cda9d194169e03eca232303898cc7",
            "command": [
              "/bin/bash",
              "-ec"
            ],
            "args": [
              "postgres --version\nfor ext in pg_search pg_cron pg_ivm vector postgis postgis_topology fuzzystrmatch postgis_tiger_geocoder pg_stat_statements; do\n  printf '%s ' \"$ext\"\n  sed -n '/^default_version/p' \"/usr/share/postgresql/16/extension/$ext.control\"\ndone"
            ],
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "128Mi"
              },
              "limits": {
                "cpu": "1",
                "memory": "512Mi"
              }
            }
          }
        ],
        "tolerations": [
          {
            "key": "sounio.dev/pool",
            "operator": "Equal",
            "value": "gpu-batch",
            "effect": "NoSchedule"
          },
          {
            "key": "sounio.dev/compute",
            "operator": "Equal",
            "value": "heavy",
            "effect": "NoSchedule"
          }
        ]
      }
    }
  }
}
