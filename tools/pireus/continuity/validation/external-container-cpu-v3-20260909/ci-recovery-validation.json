{
  "schema": "pireus-ci-recovery-controls-v1",
  "controls": [
    {
      "name": "accepted exact-source attempt 2 invokes original driver once",
      "pass": true,
      "driver_invocations": 1,
      "hardware_executed": false
    },
    {
      "name": "existing hardware attempt refuses before querying CI",
      "pass": true,
      "driver_invocations": 0,
      "hardware_executed": false
    },
    {
      "name": "changed source refuses",
      "pass": true,
      "driver_invocations": 0,
      "hardware_executed": false
    },
    {
      "name": "changed CI attempt refuses",
      "pass": true,
      "driver_invocations": 0,
      "hardware_executed": false
    },
    {
      "name": "failed CI stops without invoking driver",
      "pass": true,
      "driver_invocations": 0,
      "hardware_executed": false
    },
    {
      "name": "changed original driver refuses",
      "pass": true,
      "driver_invocations": 0,
      "hardware_executed": false
    }
  ],
  "archived_failure_hashes_pass": true,
  "hardware_qualified": false
}
