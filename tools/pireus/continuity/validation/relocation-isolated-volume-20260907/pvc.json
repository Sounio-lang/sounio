{
  "apiVersion": "v1",
  "kind": "PersistentVolumeClaim",
  "metadata": {
    "name": "pireus-pg-relocation-ssd-data",
    "namespace": "beagle"
  },
  "spec": {
    "accessModes": [
      "ReadWriteOnce"
    ],
    "storageClassName": "ceph-rbd-pireus-pg-ssd",
    "resources": {
      "requests": {
        "storage": "64Gi"
      }
    }
  }
}