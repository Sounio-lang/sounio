[
  "srun",
  "--partition=all",
  "--nodelist=dl380-dl380-proxmox",
  "--nodes=1",
  "--ntasks=1",
  "--cpus-per-task=1",
  "--mem=512M",
  "--time=00:01:00",
  "--job-name=pireus-cpu-route-check",
  "python3",
  "-c",
  "import os,socket,json,pathlib;print(json.dumps(dict(schema='pireus-cpu-route-witness-v1',job=os.environ['SLURM_JOB_ID'],hostname=socket.gethostname(),boot_id=pathlib.Path('/proc/sys/kernel/random/boot_id').read_text().strip(),compiler_executed=False)),flush=True)"
]
