fn pal_hash_equal(left: &[i64; 8], right: &[i64; 8]) -> bool
with Mut, Panic {
    var i: i64 = 0
    while i < 8 {
        if left[i as usize] != right[i as usize] { return false }
        i = i + 1
    }
    true
}

fn pal_digest_add_i64(state: SHA256State, value: i64) -> SHA256State
with Mut, Panic, Div {
    var bytes: [u8; 8] = [0; 8]
    var i: i64 = 0
    while i < 8 {
        bytes[i as usize] = ((value >> ((7 - i) * 8)) & 255) as u8
        i = i + 1
    }
    sha256_update(state, bytes, 8)
}

fn pal_digest_add_bool(state: SHA256State, value: bool) -> SHA256State
with Mut, Panic, Div {
    pal_digest_add_i64(state, if value { 1 } else { 0 })
}

fn pal_digest_add_string(state: SHA256State, value: string) -> SHA256State
with Mut, Panic, Div {
    let size = str_len(value)
    var next = pal_digest_add_i64(state, size)
    var pos: i64 = 0
    while pos < size {
        var window: [u8; 256] = [0; 256]
        var count = size - pos
        if count > 256 { count = 256 }
        var i: i64 = 0
        while i < count {
            var byte = str_char_at(value, pos + i) as i64
            if byte < 0 { byte = byte + 256 }
            window[i as usize] = byte as u8
            i = i + 1
        }
        next = sha256_update(next, window, count as i32)
        pos = pos + count
    }
    next
}

fn pal_digest_add_words(
    state: SHA256State, words: &[i64; 8],
) -> SHA256State with Mut, Panic, Div {
    var next = state
    var i: i64 = 0
    while i < 8 {
        next = pal_digest_add_i64(next, words[i as usize])
        i = i + 1
    }
    next
}

fn pal_digest_finish(state: SHA256State) -> PireusAppleCpuLatencyDigest
with Mut, Panic, Div {
    let finalized = sha256_finalize(state)
    var words: [i64; 8] = [0; 8]
    var i: i64 = 0
    while i < 8 {
        var word: i64 = 0
        var j: i64 = 0
        while j < 4 {
            word = word * 256 + sha256_digest_byte(finalized, i * 4 + j)
            j = j + 1
        }
        words[i as usize] = word
        i = i + 1
    }
    PireusAppleCpuLatencyDigest { words: words }
}

fn pal_file_hash(path: string) -> PireusAppleCpuLatencyDigest
with IO, Mut, Panic, Div, Alloc {
    let size = file_size(path)
    if size <= 0 || size >= 1048576 {
        return PireusAppleCpuLatencyDigest { words: [0; 8] }
    }
    let raw = read_file(path)
    var state = sha256_init()
    var pos: i64 = 0
    while pos < size {
        var window: [u8; 256] = [0; 256]
        var count = size - pos
        if count > 256 { count = 256 }
        var i: i64 = 0
        while i < count {
            var byte = raw[(pos + i) as usize] as i64
            if byte < 0 { byte = byte + 256 }
            window[i as usize] = byte as u8
            i = i + 1
        }
        state = sha256_update(state, window, count as i32)
        pos = pos + count
    }
    pal_digest_finish(state)
}

fn pal_expected_parent_hash(index: i64) -> [i64; 8] {
    if index == 0 { return [0xb574d735, 0x2019576d, 0xceceab32, 0x675834ae, 0xdb24961d, 0xcd76f976, 0x46a5cbed, 0x4277aa7f] }
    if index == 1 { return [0x7ea2815c, 0x112b8547, 0x6fc6ac4d, 0x8bb9388e, 0xe0320628, 0x22c69054, 0x85c2084e, 0xe416d6bc] }
    if index == 2 { return [0x0a899be7, 0xcd25375c, 0x8c444b9e, 0x1f0a71dd, 0x102ca895, 0x8072a429, 0x0073ae21, 0xc926a199] }
    if index == 3 { return [0xb7577c78, 0x2a82431e, 0xb5431213, 0x7a52c181, 0x1f14316d, 0x5e5a5fb9, 0xe7aa9581, 0xf1c304ca] }
    if index == 4 { return [0x06f21108, 0xddc89c8c, 0x468097b7, 0xcefec6a7, 0x66bda065, 0x918fd579, 0x7be19487, 0x8371577b] }
    if index == 5 { return [0xb98d799f, 0xec6452f9, 0xafaecc7e, 0x418578cc, 0x0ca72a1d, 0x3e7c0a1f, 0x84d474e0, 0xaa2730ec] }
    if index == 6 { return [0xbbbd7bc9, 0xc99e1de4, 0x6a5317d9, 0x9a7893ad, 0xebfdf7fb, 0x46454cbd, 0x7002b309, 0x8281b6ee] }
    if index == 7 { return [0x352ad87a, 0x4d05ef32, 0x333acb2f, 0x31a48f49, 0xe7d520ab, 0x99c3e99a, 0x8b4a3e6b, 0xf3f55aa4] }
    if index == 8 { return [0x08a6e0d4, 0xb2e5a0bb, 0x4e981cfc, 0xc8df5192, 0xd9b9b77f, 0x53eb3862, 0xc86f29d9, 0x409e425b] }
    [0; 8]
}

fn pal_parent_path(
    paths: &PireusAppleCpuLatencyParentPaths, index: i64,
) -> string {
    if index == 0 { return paths.garden }
    if index == 1 { return paths.target_cost_source }
    if index == 2 { return paths.target_cost_semantics }
    if index == 3 { return paths.target_cost_receipt }
    if index == 4 { return paths.target_cost_evidence }
    if index == 5 { return paths.material_source }
    if index == 6 { return paths.material_semantics }
    if index == 7 { return paths.material_receipt }
    paths.material_evidence
}

fn pal_parent_match_mask(paths: &PireusAppleCpuLatencyParentPaths) -> i64
with IO, Mut, Panic, Div, Alloc {
    var mask: i64 = 0
    var i: i64 = 0
    while i < PIREUS_APPLE_CPU_LATENCY_PARENT_FILE_COUNT {
        let actual = pal_file_hash(pal_parent_path(paths, i))
        let expected = pal_expected_parent_hash(i)
        if pal_hash_equal(&actual.words, &expected) {
            mask = mask | (1 << i)
        }
        i = i + 1
    }
    mask
}

pub fn pireus_apple_cpu_latency_parent_file_matches(
    mask: i64, index: i64,
) -> bool {
    index >= 0 && index < PIREUS_APPLE_CPU_LATENCY_PARENT_FILE_COUNT &&
        (mask & (1 << index)) != 0
}

fn pal_all_parents_match(mask: i64) -> bool {
    mask == (1 << PIREUS_APPLE_CPU_LATENCY_PARENT_FILE_COUNT) - 1
}

fn pal_parent_manifest_digest(
    paths: &PireusAppleCpuLatencyParentPaths,
) -> PireusAppleCpuLatencyDigest with IO, Mut, Panic, Div, Alloc {
    var state = sha256_init()
    state = pal_digest_add_string(
        state, "pireus.apple-cpu-dependency-latency.parent-manifest.v0")
    var i: i64 = 0
    while i < PIREUS_APPLE_CPU_LATENCY_PARENT_FILE_COUNT {
        let actual = pal_file_hash(pal_parent_path(paths, i))
        state = pal_digest_add_i64(state, i)
        state = pal_digest_add_words(state, &actual.words)
        i = i + 1
    }
    pal_digest_finish(state)
}

fn pal_cost_parent_paths(
    paths: &PireusAppleCpuLatencyParentPaths,
) -> PireusCostParentPaths {
    PireusCostParentPaths {
        garden: paths.cost_parent_garden,
        admission_source: paths.cost_parent_admission_source,
        admission_semantics: paths.cost_parent_admission_semantics,
        admission_receipt: paths.cost_parent_admission_receipt,
        admission_evidence: paths.cost_parent_admission_evidence,
        engine_source: paths.cost_parent_engine_source,
        engine_semantics: paths.cost_parent_engine_semantics,
        engine_receipt: paths.cost_parent_engine_receipt,
        operation_source: paths.cost_parent_operation_source,
        operation_semantics: paths.cost_parent_operation_semantics,
        operation_receipt: paths.cost_parent_operation_receipt,
    }
}

fn pal_material_parent_paths(
    paths: &PireusAppleCpuLatencyParentPaths,
) -> PireusMaterialEngineParentPaths {
    PireusMaterialEngineParentPaths {
        garden: paths.material_parent_garden,
        engine_source: paths.cost_parent_engine_source,
        engine_semantics: paths.cost_parent_engine_semantics,
        engine_receipt: paths.cost_parent_engine_receipt,
        cost_source: paths.target_cost_source,
        cost_semantics: paths.target_cost_semantics,
        cost_receipt: paths.target_cost_receipt,
        cost_evidence: paths.target_cost_evidence,
        apple_receipt: paths.material_parent_apple_receipt,
        apple_evidence: paths.material_parent_apple_evidence,
        dgx_receipt: paths.material_parent_dgx_receipt,
        dgx_evidence: paths.material_parent_dgx_evidence,
    }
}

fn pal_request_equal(
    left: &PireusCostRequest, right: &PireusCostRequest,
) -> bool {
    left.request_id == right.request_id &&
        left.target_id == right.target_id &&
        left.machine_id == right.machine_id &&
        left.engine_id == right.engine_id &&
        left.engine_is_blueprint == right.engine_is_blueprint &&
        left.engine_observed == right.engine_observed &&
        left.subject_kind == right.subject_kind &&
        left.subject_node == right.subject_node &&
        left.quantity == right.quantity && left.unit == right.unit &&
        left.scope == right.scope && left.statistic == right.statistic &&
        left.requested_sample_count == right.requested_sample_count &&
        left.requested_warmup_count == right.requested_warmup_count &&
        left.required_environment_mask == right.required_environment_mask &&
        left.bound_environment_mask == right.bound_environment_mask &&
        left.evidence_role == right.evidence_role &&
        left.producer_language == right.producer_language &&
        left.producer_role == right.producer_role &&
        left.value_present == right.value_present &&
        left.estimate_numerator == right.estimate_numerator &&
        left.estimate_denominator == right.estimate_denominator &&
        left.lower_numerator == right.lower_numerator &&
        left.lower_denominator == right.lower_denominator &&
        left.upper_numerator == right.upper_numerator &&
        left.upper_denominator == right.upper_denominator &&
        left.subject_covered == right.subject_covered &&
        left.admitted == right.admitted
}

pub fn pireus_apple_request_template_exact(
    template: &PireusRequestTemplateRef,
    candidate: &PireusCostRequest,
    frozen: &PireusCostRequest,
    target_cost_parent_live: bool,
) -> bool {
    target_cost_parent_live &&
        template.request_index == PIREUS_APPLE_CPU_LATENCY_REQUEST_INDEX &&
        template.request_id == PIREUS_APPLE_CPU_LATENCY_REQUEST_ID &&
        frozen.request_id == template.request_id &&
        pireus_cost_request_valid(frozen) &&
        pal_request_equal(candidate, frozen)
}

fn pal_binding(candidate: &PireusMaterialEngineCandidate)
    -> PireusMaterialEngineBinding {
    PireusMaterialEngineBinding {
        template_request_id: PIREUS_APPLE_CPU_LATENCY_REQUEST_ID,
        target_id: candidate.target_id,
        machine_id: candidate.machine_id,
        engine_id: candidate.engine_id,
        engine_kind: candidate.engine_kind,
        isa_id: candidate.isa_id,
        receipt_id: candidate.receipt_id,
        evidence_id: candidate.evidence_id,
        hardware_id: candidate.hardware_id,
        material_subject_id: PIREUS_MATERIAL_SUBJECT_XOR_SELECTOR,
        material_operation_id: candidate.material_operation_id,
        eligibility_id: PIREUS_ELIGIBILITY_APPLE_LATENCY,
        state_tag: PIREUS_REQUEST_STAGE_MATERIAL_IDENTITY_BOUND,
        execution_authorization_id: 0,
        measurement_feasibility: PIREUS_MEASUREMENT_FEASIBILITY_UNKNOWN,
        producer_language: PIREUS_COST_LANGUAGE_SOUNIO,
        producer_role: PIREUS_COST_ROLE_SEMANTIC_AUTHORITY,
    }
}

pub fn pireus_apple_measurement_interface_ready(
    candidate: &PireusMaterialEngineCandidate,
) -> bool {
    candidate.interface_id != 0
}

pub fn pireus_apple_material_instance_exact(
    binding: &PireusMaterialEngineBinding,
    candidate: &PireusMaterialEngineCandidate,
    material_parent_mask: i64,
    material_parent_live: bool,
) -> bool {
    material_parent_live &&
        pireus_material_engine_candidate_valid(candidate, material_parent_mask) &&
        binding.template_request_id == PIREUS_APPLE_CPU_LATENCY_REQUEST_ID &&
        binding.target_id == candidate.target_id &&
        binding.machine_id == candidate.machine_id &&
        binding.engine_id == candidate.engine_id &&
        binding.engine_kind == candidate.engine_kind &&
        binding.isa_id == candidate.isa_id &&
        binding.receipt_id == candidate.receipt_id &&
        binding.evidence_id == candidate.evidence_id &&
        binding.hardware_id == candidate.hardware_id &&
        binding.material_subject_id == PIREUS_MATERIAL_SUBJECT_XOR_SELECTOR &&
        binding.material_operation_id == candidate.material_operation_id &&
        binding.eligibility_id == PIREUS_ELIGIBILITY_APPLE_LATENCY &&
        binding.state_tag == PIREUS_REQUEST_STAGE_MATERIAL_IDENTITY_BOUND &&
        binding.execution_authorization_id == 0 &&
        binding.measurement_feasibility ==
            PIREUS_MEASUREMENT_FEASIBILITY_UNKNOWN &&
        binding.producer_language == PIREUS_COST_LANGUAGE_SOUNIO &&
        binding.producer_role == PIREUS_COST_ROLE_SEMANTIC_AUTHORITY &&
        !pireus_apple_measurement_interface_ready(candidate)
}

pub fn pireus_apple_request_target_matches_instance(
    request: &PireusCostRequest,
    binding: &PireusMaterialEngineBinding,
    candidate: &PireusMaterialEngineCandidate,
) -> bool {
    request.target_id == binding.target_id &&
        binding.target_id == candidate.target_id &&
        request.target_id == PIREUS_TARGET_APPLE_SILICON
}

pub fn pireus_apple_request_subject_matches_receipt(
    request: &PireusCostRequest,
    binding: &PireusMaterialEngineBinding,
    candidate: &PireusMaterialEngineCandidate,
) -> bool {
    request.subject_kind == PIREUS_COST_SUBJECT_LOWERING_NODE &&
        request.subject_node == 0 &&
        binding.material_subject_id == PIREUS_MATERIAL_SUBJECT_XOR_SELECTOR &&
        binding.material_operation_id == candidate.material_operation_id &&
        binding.receipt_id == candidate.receipt_id &&
        binding.evidence_id == candidate.evidence_id &&
        candidate.selector_covered && !candidate.whole_operation_covered
}

pub fn pireus_apple_request_quantity_is_eligible(
    request: &PireusCostRequest,
    binding: &PireusMaterialEngineBinding,
    candidate: &PireusMaterialEngineCandidate,
    material_parent_mask: i64,
) -> bool {
    request.quantity == PIREUS_COST_DEPENDENCY_LATENCY &&
        binding.eligibility_id == PIREUS_ELIGIBILITY_APPLE_LATENCY &&
        pireus_material_engine_request_eligible(
            candidate, material_parent_mask, request.quantity)
}

pub fn pireus_apple_stage_allows_identity_binding(
    stage: &PireusRequestStage,
) -> bool {
    stage.from_tag == PIREUS_REQUEST_STAGE_TEMPLATE &&
        stage.to_tag == PIREUS_REQUEST_STAGE_MATERIAL_IDENTITY_BOUND
}

fn pal_state_has_execution(tag: i64) -> bool {
    tag == PIREUS_REQUEST_STAGE_EXECUTION_AUTHORIZED ||
        tag == PIREUS_REQUEST_STAGE_OBSERVED ||
        tag == PIREUS_REQUEST_STAGE_SUMMARY_ELIGIBLE ||
        tag == PIREUS_REQUEST_STAGE_COMPARISON_ELIGIBLE
}

fn pal_state_has_observation(tag: i64) -> bool {
    tag == PIREUS_REQUEST_STAGE_OBSERVED ||
        tag == PIREUS_REQUEST_STAGE_SUMMARY_ELIGIBLE ||
        tag == PIREUS_REQUEST_STAGE_COMPARISON_ELIGIBLE
}

fn pal_state_has_summary(tag: i64) -> bool {
    tag == PIREUS_REQUEST_STAGE_SUMMARY_ELIGIBLE ||
        tag == PIREUS_REQUEST_STAGE_COMPARISON_ELIGIBLE
}

fn pal_state_has_comparison(tag: i64) -> bool {
    tag == PIREUS_REQUEST_STAGE_COMPARISON_ELIGIBLE
}

pub fn pireus_apple_execution_authorized(
    binding: &PireusMaterialEngineBinding,
) -> bool {
    pal_state_has_execution(binding.state_tag) &&
        binding.execution_authorization_id != 0
}

pub fn pireus_apple_material_cost_observed(
    request: &PireusCostRequest,
    binding: &PireusMaterialEngineBinding,
) -> bool {
    pireus_apple_execution_authorized(binding) &&
        pal_state_has_observation(binding.state_tag) && request.value_present
}

fn pal_derived_summary_present(
    request: &PireusCostRequest,
    binding: &PireusMaterialEngineBinding,
) -> bool {
    pireus_apple_material_cost_observed(request, binding) &&
        pal_state_has_summary(binding.state_tag)
}

fn pal_comparison_present(
    request: &PireusCostRequest,
    binding: &PireusMaterialEngineBinding,
) -> bool {
    pal_derived_summary_present(request, binding) &&
        pal_state_has_comparison(binding.state_tag)
}

fn pal_speedup_present(
    request: &PireusCostRequest,
    binding: &PireusMaterialEngineBinding,
) -> bool {
    pal_comparison_present(request, binding) && false
}

fn pal_ranking_present(
    request: &PireusCostRequest,
    binding: &PireusMaterialEngineBinding,
) -> bool {
    pal_comparison_present(request, binding) && false
}

fn pal_parity_open(
    request: &PireusCostRequest,
    binding: &PireusMaterialEngineBinding,
) -> bool {
    pal_comparison_present(request, binding) && false
}

fn pal_claim_ready(
    request: &PireusCostRequest,
    binding: &PireusMaterialEngineBinding,
) -> bool {
    pal_parity_open(request, binding) && false
}

pub fn pireus_apple_transport_can_prove_identity_binding(
    locator_reachable: bool, key_available: bool,
) -> bool {
    locator_reachable && key_available && false
}

pub fn pireus_apple_unresolved_identity_can_bind(
    identity_request_id: i64, machine_id: i64, engine_id: i64,
) -> bool {
    identity_request_id == 0 &&
    machine_id == PIREUS_MACHINE_APPLE_MAC17_7 &&
    engine_id == PIREUS_ENGINE_CPU_APPLE_M5_MAX
}

pub fn pireus_apple_prelaunch_role_allowed(
    language: i64, role: i64,
    semantics_frozen: bool, execution_authorized: bool,
) -> bool {
    if language == PIREUS_COST_LANGUAGE_PYTHON ||
        language == PIREUS_COST_LANGUAGE_RUST {
        return false
    }
    if role == PIREUS_COST_ROLE_SEMANTIC_AUTHORITY {
        return language == PIREUS_COST_LANGUAGE_SOUNIO
    }
    if role == PIREUS_COST_ROLE_MATERIAL_PARITY {
        return language == PIREUS_COST_LANGUAGE_CPP &&
            semantics_frozen && execution_authorized
    }
    if role == PIREUS_COST_ROLE_REVIEW_ONLY {
        return false
    }
    if role == PIREUS_APPLE_CPU_LATENCY_ROLE_ORACLE ||
        role == PIREUS_APPLE_CPU_LATENCY_ROLE_GUARDIAN {
        return language == PIREUS_COST_LANGUAGE_SOUNIO
    }
    false
}

pub fn pireus_apple_material_identity_binding_valid(
    direct_parent_mask: i64,
    template: &PireusRequestTemplateRef,
    request: &PireusCostRequest,
    frozen_request: &PireusCostRequest,
    binding: &PireusMaterialEngineBinding,
    candidate: &PireusMaterialEngineCandidate,
    material_parent_mask: i64,
    target_cost_parent_live: bool,
    material_parent_live: bool,
    stage: &PireusRequestStage,
) -> bool {
    pal_all_parents_match(direct_parent_mask) &&
        pireus_apple_request_template_exact(
            template, request, frozen_request, target_cost_parent_live) &&
        pireus_apple_material_instance_exact(
            binding, candidate, material_parent_mask, material_parent_live) &&
        pireus_apple_request_target_matches_instance(
            request, binding, candidate) &&
        pireus_apple_request_subject_matches_receipt(
            request, binding, candidate) &&
        pireus_apple_request_quantity_is_eligible(
            request, binding, candidate, material_parent_mask) &&
        pireus_apple_stage_allows_identity_binding(stage) &&
        binding.state_tag == stage.to_tag &&
        pireus_apple_prelaunch_role_allowed(
            binding.producer_language, binding.producer_role, false, false)
}

fn pal_query_class(store: &TripleStore, class_id: i64) -> SparqlResult
with Mut, Epistemic {
    var query = sparql_new()
    sparql_select(&query, 0)
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_RDF_TYPE),
        queryterm_iri(class_id)))
    sparql_execute(store, &query)
}

fn pal_query_relation(
    store: &TripleStore, subject: i64, predicate: i64,
) -> SparqlResult with Mut, Epistemic {
    var query = sparql_new()
    sparql_select(&query, 0)
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_iri(subject), queryterm_iri(predicate),
        queryterm_variable(0)))
    sparql_execute(store, &query)
}

fn pal_ontology_add(
    store: &TripleStore, state: SHA256State,
    subject: i64, predicate: i64, object: i64,
) -> SHA256State with Mut, Panic, Div {
    triple_store_add(store, triple_iri(subject, predicate, object))
    var next = pal_digest_add_i64(state, subject)
    next = pal_digest_add_i64(next, predicate)
    pal_digest_add_i64(next, object)
}

fn pal_ontology_projection(
    request: &PireusCostRequest,
    binding: &PireusMaterialEngineBinding,
    output: &![i64; 9],
) -> bool
with Mut, Panic, Div, Epistemic {
    var store = triple_store_new()
    var state = sha256_init()
    state = pal_digest_add_string(
        state, "pireus.apple-cpu-dependency-latency.ontology.v0")

    state = pal_ontology_add(&store, state,
        PIREUS_CLASS_REQUEST_TEMPLATE_REF, PIREUS_RDF_TYPE,
        PIREUS_CLASS_ONTOLOGY_CLASS)
    state = pal_ontology_add(&store, state,
        PIREUS_CLASS_MATERIAL_ENGINE_BINDING, PIREUS_RDF_TYPE,
        PIREUS_CLASS_ONTOLOGY_CLASS)
    state = pal_ontology_add(&store, state,
        PIREUS_CLASS_REQUEST_STAGE, PIREUS_RDF_TYPE,
        PIREUS_CLASS_ONTOLOGY_CLASS)
    state = pal_ontology_add(&store, state,
        PIREUS_CLASS_MEASUREMENT_FEASIBILITY, PIREUS_RDF_TYPE,
        PIREUS_CLASS_ONTOLOGY_CLASS)

    state = pal_ontology_add(&store, state,
        PIREUS_APPLE_CPU_LATENCY_TEMPLATE_IRI, PIREUS_RDF_TYPE,
        PIREUS_CLASS_REQUEST_TEMPLATE_REF)
    state = pal_ontology_add(&store, state,
        PIREUS_APPLE_CPU_LATENCY_TEMPLATE_IRI,
        PIREUS_TEMPLATE_HAS_TARGET, request.target_id)
    state = pal_ontology_add(&store, state,
        PIREUS_APPLE_CPU_LATENCY_TEMPLATE_IRI,
        PIREUS_TEMPLATE_HAS_SUBJECT, request.subject_kind)
    state = pal_ontology_add(&store, state,
        PIREUS_APPLE_CPU_LATENCY_TEMPLATE_IRI,
        PIREUS_TEMPLATE_HAS_QUANTITY, request.quantity)
    state = pal_ontology_add(&store, state,
        PIREUS_APPLE_CPU_LATENCY_TEMPLATE_IRI,
        PIREUS_TEMPLATE_HAS_UNIT, request.unit)
    state = pal_ontology_add(&store, state,
        PIREUS_APPLE_CPU_LATENCY_TEMPLATE_IRI,
        PIREUS_TEMPLATE_HAS_SCOPE, request.scope)
    state = pal_ontology_add(&store, state,
        PIREUS_APPLE_CPU_LATENCY_TEMPLATE_IRI,
        PIREUS_TEMPLATE_HAS_STATISTIC, request.statistic)

    state = pal_ontology_add(&store, state,
        PIREUS_APPLE_CPU_LATENCY_BINDING_IRI, PIREUS_RDF_TYPE,
        PIREUS_CLASS_MATERIAL_ENGINE_BINDING)
    state = pal_ontology_add(&store, state,
        PIREUS_APPLE_CPU_LATENCY_BINDING_IRI,
        PIREUS_BINDING_HAS_TEMPLATE, PIREUS_APPLE_CPU_LATENCY_TEMPLATE_IRI)
    state = pal_ontology_add(&store, state,
        PIREUS_APPLE_CPU_LATENCY_BINDING_IRI,
        PIREUS_BINDING_HAS_TARGET, binding.target_id)
    state = pal_ontology_add(&store, state,
        PIREUS_APPLE_CPU_LATENCY_BINDING_IRI,
        PIREUS_BINDING_HAS_MACHINE, binding.machine_id)
    state = pal_ontology_add(&store, state,
        PIREUS_APPLE_CPU_LATENCY_BINDING_IRI,
        PIREUS_BINDING_HAS_ENGINE, binding.engine_id)
    state = pal_ontology_add(&store, state,
        PIREUS_APPLE_CPU_LATENCY_BINDING_IRI,
        PIREUS_BINDING_HAS_ENGINE_KIND, binding.engine_kind)
    state = pal_ontology_add(&store, state,
        PIREUS_APPLE_CPU_LATENCY_BINDING_IRI,
        PIREUS_BINDING_HAS_ISA, binding.isa_id)
    state = pal_ontology_add(&store, state,
        PIREUS_APPLE_CPU_LATENCY_BINDING_IRI,
        PIREUS_BINDING_HAS_RECEIPT, binding.receipt_id)
    state = pal_ontology_add(&store, state,
        PIREUS_APPLE_CPU_LATENCY_BINDING_IRI,
        PIREUS_BINDING_HAS_EVIDENCE, binding.evidence_id)
    state = pal_ontology_add(&store, state,
        PIREUS_APPLE_CPU_LATENCY_BINDING_IRI,
        PIREUS_BINDING_HAS_HARDWARE, binding.hardware_id)
    state = pal_ontology_add(&store, state,
        PIREUS_APPLE_CPU_LATENCY_BINDING_IRI,
        PIREUS_BINDING_HAS_MATERIAL_SUBJECT, binding.material_subject_id)
    state = pal_ontology_add(&store, state,
        PIREUS_APPLE_CPU_LATENCY_BINDING_IRI,
        PIREUS_BINDING_HAS_MATERIAL_OPERATION, binding.material_operation_id)
    state = pal_ontology_add(&store, state,
        PIREUS_APPLE_CPU_LATENCY_BINDING_IRI,
        PIREUS_BINDING_HAS_ELIGIBILITY, binding.eligibility_id)
    state = pal_ontology_add(&store, state,
        PIREUS_APPLE_CPU_LATENCY_BINDING_IRI,
        PIREUS_BINDING_HAS_STATE, binding.state_tag)
    state = pal_ontology_add(&store, state,
        PIREUS_APPLE_CPU_LATENCY_BINDING_IRI,
        PIREUS_BINDING_HAS_FEASIBILITY, binding.measurement_feasibility)

    let templates = pal_query_class(&store, PIREUS_CLASS_REQUEST_TEMPLATE_REF)
    let bindings = pal_query_class(&store, PIREUS_CLASS_MATERIAL_ENGINE_BINDING)
    let machines = pal_query_relation(&store,
        PIREUS_APPLE_CPU_LATENCY_BINDING_IRI, PIREUS_BINDING_HAS_MACHINE)
    let engines = pal_query_relation(&store,
        PIREUS_APPLE_CPU_LATENCY_BINDING_IRI, PIREUS_BINDING_HAS_ENGINE)
    let receipts = pal_query_relation(&store,
        PIREUS_APPLE_CPU_LATENCY_BINDING_IRI, PIREUS_BINDING_HAS_RECEIPT)
    let evidence = pal_query_relation(&store,
        PIREUS_APPLE_CPU_LATENCY_BINDING_IRI, PIREUS_BINDING_HAS_EVIDENCE)
    let eligibility = pal_query_relation(&store,
        PIREUS_APPLE_CPU_LATENCY_BINDING_IRI, PIREUS_BINDING_HAS_ELIGIBILITY)
    let stages = pal_query_relation(&store,
        PIREUS_APPLE_CPU_LATENCY_BINDING_IRI, PIREUS_BINDING_HAS_STATE)
    let feasibility = pal_query_relation(&store,
        PIREUS_APPLE_CPU_LATENCY_BINDING_IRI,
        PIREUS_BINDING_HAS_FEASIBILITY)

    let binding_valid = sparql_result_count(&templates) == 1 &&
        sparql_result_count(&bindings) == 1 &&
        sparql_result_count(&machines) == 1 &&
        sparql_result_count(&engines) == 1 &&
        sparql_result_count(&receipts) == 1 &&
        sparql_result_count(&evidence) == 1 &&
        sparql_result_count(&eligibility) == 1 &&
        sparql_result_count(&stages) == 1 &&
        sparql_result_count(&feasibility) == 1
    let triple_count = triple_store_count(&store)
    let digest = pal_digest_finish(state)
    output[0] = triple_count
    var i: i64 = 0
    while i < 8 {
        output[(i + 1) as usize] = digest.words[i as usize]
        i = i + 1
    }
    binding_valid
}

fn pal_try_composition(
    direct_parent_mask: i64,
    template: &PireusRequestTemplateRef,
    request: &PireusCostRequest,
    frozen_request: &PireusCostRequest,
    binding: &PireusMaterialEngineBinding,
    candidate: &PireusMaterialEngineCandidate,
    material_parent_mask: i64,
    target_cost_parent_live: bool,
    material_parent_live: bool,
    stage: &PireusRequestStage,
) -> bool {
    pireus_apple_material_identity_binding_valid(
        direct_parent_mask, template, request, frozen_request,
        binding, candidate, material_parent_mask,
        target_cost_parent_live, material_parent_live, stage)
}

fn pal_copy_request(request: &PireusCostRequest) -> PireusCostRequest {
    PireusCostRequest {
        request_id: request.request_id,
        target_id: request.target_id,
        machine_id: request.machine_id,
        engine_id: request.engine_id,
        engine_is_blueprint: request.engine_is_blueprint,
        engine_observed: request.engine_observed,
        subject_kind: request.subject_kind,
        subject_node: request.subject_node,
        quantity: request.quantity,
        unit: request.unit,
        scope: request.scope,
        statistic: request.statistic,
        requested_sample_count: request.requested_sample_count,
        requested_warmup_count: request.requested_warmup_count,
        required_environment_mask: request.required_environment_mask,
        bound_environment_mask: request.bound_environment_mask,
        evidence_role: request.evidence_role,
        producer_language: request.producer_language,
        producer_role: request.producer_role,
        value_present: request.value_present,
        estimate_numerator: request.estimate_numerator,
        estimate_denominator: request.estimate_denominator,
        lower_numerator: request.lower_numerator,
        lower_denominator: request.lower_denominator,
        upper_numerator: request.upper_numerator,
        upper_denominator: request.upper_denominator,
        subject_covered: request.subject_covered,
        admitted: request.admitted,
    }
}

fn pal_copy_binding(
    binding: &PireusMaterialEngineBinding,
) -> PireusMaterialEngineBinding {
    PireusMaterialEngineBinding {
        template_request_id: binding.template_request_id,
        target_id: binding.target_id,
        machine_id: binding.machine_id,
        engine_id: binding.engine_id,
        engine_kind: binding.engine_kind,
        isa_id: binding.isa_id,
        receipt_id: binding.receipt_id,
        evidence_id: binding.evidence_id,
        hardware_id: binding.hardware_id,
        material_subject_id: binding.material_subject_id,
        material_operation_id: binding.material_operation_id,
        eligibility_id: binding.eligibility_id,
        state_tag: binding.state_tag,
        execution_authorization_id: binding.execution_authorization_id,
        measurement_feasibility: binding.measurement_feasibility,
        producer_language: binding.producer_language,
        producer_role: binding.producer_role,
    }
}

fn pal_copy_candidate(
    candidate: &PireusMaterialEngineCandidate,
) -> PireusMaterialEngineCandidate {
    PireusMaterialEngineCandidate {
        target_id: candidate.target_id,
        locator_id: candidate.locator_id,
        machine_id: candidate.machine_id,
        engine_id: candidate.engine_id,
        engine_kind: candidate.engine_kind,
        isa_id: candidate.isa_id,
        interface_id: candidate.interface_id,
        receipt_id: candidate.receipt_id,
        evidence_id: candidate.evidence_id,
        hardware_id: candidate.hardware_id,
        material_operation_id: candidate.material_operation_id,
        producer_language: candidate.producer_language,
        producer_role: candidate.producer_role,
        semantic_authority_language: candidate.semantic_authority_language,
        parity_receipt_valid: candidate.parity_receipt_valid,
        material_execution_observed: candidate.material_execution_observed,
        blueprint_only: candidate.blueprint_only,
        selector_covered: candidate.selector_covered,
        whole_operation_covered: candidate.whole_operation_covered,
        cost_value_present: candidate.cost_value_present,
        comparison_promoted: candidate.comparison_promoted,
        review_promoted: candidate.review_promoted,
        parity_open: candidate.parity_open,
        claim_ready: candidate.claim_ready,
    }
}

fn pal_copy_stage(stage: &PireusRequestStage) -> PireusRequestStage {
    PireusRequestStage { from_tag: stage.from_tag, to_tag: stage.to_tag }
}

fn pal_exercise_negatives(
    direct_parent_mask: i64,
    template: &PireusRequestTemplateRef,
    request: &PireusCostRequest,
    binding: &PireusMaterialEngineBinding,
    candidate: &PireusMaterialEngineCandidate,
    material_parent_mask: i64,
    target_cost_parent_live: bool,
    material_parent_live: bool,
    stage: &PireusRequestStage,
) -> PireusAppleCpuLatencyNegatives with Mut, Panic {
    let baseline_valid = pal_try_composition(
        direct_parent_mask, template, request, request,
        binding, candidate, material_parent_mask,
        target_cost_parent_live, material_parent_live, stage)
    var request_id = pal_copy_request(request)
    request_id.request_id = request.request_id + 1
    var target = pal_copy_request(request)
    target.target_id = PIREUS_TARGET_DGX_SPARK
    var subject_kind = pal_copy_request(request)
    subject_kind.subject_kind = PIREUS_COST_SUBJECT_COMPLETE_OPERATION
    var subject_node = pal_copy_request(request)
    subject_node.subject_node = request.subject_node + 1
    var quantity = pal_copy_request(request)
    quantity.quantity = PIREUS_COST_RECIPROCAL_THROUGHPUT
    var unit = pal_copy_request(request)
    unit.unit = PIREUS_COST_UNIT_NANOSECOND
    var scope = pal_copy_request(request)
    scope.scope = PIREUS_COST_SCOPE_COMPLETE_OPERATION
    var statistic = pal_copy_request(request)
    statistic.statistic = PIREUS_COST_STAT_MEAN
    var sample = pal_copy_request(request)
    sample.requested_sample_count = request.requested_sample_count + 1
    var warmup = pal_copy_request(request)
    warmup.requested_warmup_count = request.requested_warmup_count + 1
    var required_environment = pal_copy_request(request)
    required_environment.required_environment_mask =
        request.required_environment_mask - 1
    var bound_environment = pal_copy_request(request)
    bound_environment.bound_environment_mask = PIREUS_COST_ENV_COMPLETE
    var value = pal_copy_request(request)
    value.value_present = true
    var interval = pal_copy_request(request)
    interval.lower_numerator = request.lower_numerator + 1
    interval.lower_denominator = request.lower_denominator + 1
    var observed_engine = pal_copy_request(request)
    observed_engine.engine_observed = true

    var dgx_candidate = pireus_material_engine_dgx_24_candidate()
    var xeon_candidate = pal_copy_candidate(candidate)
    xeon_candidate.target_id = PIREUS_TARGET_DARWIN_XEON
    xeon_candidate.machine_id = PIREUS_MACHINE_T560
    xeon_candidate.engine_id = PIREUS_ENGINE_CPU_T560
    var gpu_candidate = pal_copy_candidate(candidate)
    gpu_candidate.engine_kind = PIREUS_ENGINE_KIND_GPU
    var metal_candidate = pal_copy_candidate(candidate)
    metal_candidate.interface_id = PIREUS_INTERFACE_METAL
    var blueprint_candidate = pal_copy_candidate(candidate)
    blueprint_candidate.engine_id = PIREUS_BLUEPRINT_APPLE_CPU
    blueprint_candidate.blueprint_only = true
    blueprint_candidate.material_execution_observed = false

    var machine = pal_copy_binding(binding)
    machine.machine_id = PIREUS_MUTATION_MACHINE_DGX_SIBLING
    var receipt = pal_copy_binding(binding)
    receipt.receipt_id = binding.receipt_id + 1
    var evidence = pal_copy_binding(binding)
    evidence.evidence_id = binding.evidence_id + 1
    var engine = pal_copy_binding(binding)
    engine.engine_id = PIREUS_BLUEPRINT_DGX_GPU
    var feasibility = pal_copy_binding(binding)
    feasibility.measurement_feasibility =
        PIREUS_MEASUREMENT_FEASIBILITY_ADMITTED
    var authorization = pal_copy_binding(binding)
    authorization.execution_authorization_id = 1
    var cpp_authority = pal_copy_binding(binding)
    cpp_authority.producer_language = PIREUS_COST_LANGUAGE_CPP
    var external_authority = pal_copy_binding(binding)
    external_authority.producer_language = PIREUS_COST_LANGUAGE_EXTERNAL_LLM

    var premature_stage = pal_copy_stage(stage)
    premature_stage.to_tag = PIREUS_REQUEST_STAGE_EXECUTION_AUTHORIZED
    var premature_binding = pal_copy_binding(binding)
    premature_binding.state_tag = PIREUS_REQUEST_STAGE_EXECUTION_AUTHORIZED

    var parent_drift = true
    var parent_index: i64 = 0
    while parent_index < PIREUS_APPLE_CPU_LATENCY_PARENT_FILE_COUNT {
        let clear_one = 0 - 1 - (1 << parent_index)
        if pal_try_composition(
            direct_parent_mask & clear_one, template, request, request,
            binding, candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, stage) {
            parent_drift = false
        }
        parent_index = parent_index + 1
    }
    let request_id_drift = !pal_try_composition(
        direct_parent_mask, template, &request_id, request,
        binding, candidate, material_parent_mask,
        target_cost_parent_live, material_parent_live, stage)
    let target_drift = !pal_try_composition(
        direct_parent_mask, template, &target, request,
        binding, candidate, material_parent_mask,
        target_cost_parent_live, material_parent_live, stage)
    let subject_drift =
        !pal_try_composition(
            direct_parent_mask, template, &subject_kind, request,
            binding, candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, stage) &&
        !pal_try_composition(
            direct_parent_mask, template, &subject_node, request,
            binding, candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, stage)
    let quantity_drift = !pal_try_composition(
        direct_parent_mask, template, &quantity, request,
        binding, candidate, material_parent_mask,
        target_cost_parent_live, material_parent_live, stage)
    let unit_drift = !pal_try_composition(
        direct_parent_mask, template, &unit, request,
        binding, candidate, material_parent_mask,
        target_cost_parent_live, material_parent_live, stage)
    let scope_drift = !pal_try_composition(
        direct_parent_mask, template, &scope, request,
        binding, candidate, material_parent_mask,
        target_cost_parent_live, material_parent_live, stage)
    let sampling_drift =
        !pal_try_composition(
            direct_parent_mask, template, &statistic, request,
            binding, candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, stage) &&
        !pal_try_composition(
            direct_parent_mask, template, &sample, request,
            binding, candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, stage) &&
        !pal_try_composition(
            direct_parent_mask, template, &warmup, request,
            binding, candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, stage)
    let environment_drift =
        !pal_try_composition(
            direct_parent_mask, template, &required_environment, request,
            binding, candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, stage) &&
        !pal_try_composition(
            direct_parent_mask, template, &bound_environment, request,
            binding, candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, stage)
    let value_or_derived =
        !pal_try_composition(
            direct_parent_mask, template, &value, request,
            binding, candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, stage) &&
        !pal_try_composition(
            direct_parent_mask, template, &interval, request,
            binding, candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, stage) &&
        !pireus_apple_material_cost_observed(request, binding) &&
        !pal_derived_summary_present(request, binding) &&
        !pal_comparison_present(request, binding) &&
        !pal_speedup_present(request, binding) &&
        !pal_ranking_present(request, binding)
    let foreign_composition =
        !pal_try_composition(
            direct_parent_mask, template, request, request,
            binding, &dgx_candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, stage) &&
        !pal_try_composition(
            direct_parent_mask, template, request, request,
            binding, &xeon_candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, stage) &&
        !pal_try_composition(
            direct_parent_mask, template, request, request,
            binding, &gpu_candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, stage) &&
        !pal_try_composition(
            direct_parent_mask, template, request, request,
            binding, &metal_candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, stage) &&
        !pal_try_composition(
            direct_parent_mask, template, request, request,
            binding, &blueprint_candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, stage)
    let coordinate_drift =
        !pal_try_composition(
            direct_parent_mask, template, request, request,
            &machine, candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, stage) &&
        !pal_try_composition(
            direct_parent_mask, template, request, request,
            &receipt, candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, stage) &&
        !pal_try_composition(
            direct_parent_mask, template, request, request,
            &evidence, candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, stage)
    let unresolved =
        pireus_apple_unresolved_identity_can_bind(
            0, candidate.machine_id, candidate.engine_id) &&
        PIREUS_IDENTITY_REQUEST_DGX_48 != 0 &&
        !pireus_apple_unresolved_identity_can_bind(
            PIREUS_IDENTITY_REQUEST_DGX_48,
            candidate.machine_id, candidate.engine_id)
    let transport = !pireus_apple_transport_can_prove_identity_binding(
        true, true)
    let cpp = !pal_try_composition(
        direct_parent_mask, template, request, request,
        &cpp_authority, candidate, material_parent_mask,
        target_cost_parent_live, material_parent_live, stage) &&
        !pireus_apple_prelaunch_role_allowed(
            PIREUS_COST_LANGUAGE_CPP,
            PIREUS_COST_ROLE_SEMANTIC_AUTHORITY, false, false)
    let external = !pal_try_composition(
        direct_parent_mask, template, request, request,
        &external_authority, candidate, material_parent_mask,
        target_cost_parent_live, material_parent_live, stage) &&
        !pireus_apple_prelaunch_role_allowed(
            PIREUS_COST_LANGUAGE_EXTERNAL_LLM,
            PIREUS_COST_ROLE_SEMANTIC_AUTHORITY, false, false) &&
        !pireus_apple_prelaunch_role_allowed(
            PIREUS_COST_LANGUAGE_EXTERNAL_LLM,
            PIREUS_COST_ROLE_REVIEW_ONLY, false, false)
    let forbidden =
        !pireus_apple_prelaunch_role_allowed(
            PIREUS_COST_LANGUAGE_PYTHON,
            PIREUS_COST_ROLE_SEMANTIC_AUTHORITY, false, false) &&
        !pireus_apple_prelaunch_role_allowed(
            PIREUS_COST_LANGUAGE_PYTHON,
            PIREUS_APPLE_CPU_LATENCY_ROLE_ORACLE, false, false) &&
        !pireus_apple_prelaunch_role_allowed(
            PIREUS_COST_LANGUAGE_PYTHON,
            PIREUS_APPLE_CPU_LATENCY_ROLE_GUARDIAN, false, false) &&
        !pireus_apple_prelaunch_role_allowed(
            PIREUS_COST_LANGUAGE_RUST,
            PIREUS_COST_ROLE_SEMANTIC_AUTHORITY, false, false) &&
        !pireus_apple_prelaunch_role_allowed(
            PIREUS_COST_LANGUAGE_RUST,
            PIREUS_APPLE_CPU_LATENCY_ROLE_ORACLE, false, false) &&
        !pireus_apple_prelaunch_role_allowed(
            PIREUS_COST_LANGUAGE_RUST,
            PIREUS_APPLE_CPU_LATENCY_ROLE_GUARDIAN, false, false)
    let interface_inference =
        !pireus_apple_measurement_interface_ready(candidate) &&
        !pal_try_composition(
            direct_parent_mask, template, request, request,
            binding, &metal_candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, stage) &&
        !pal_try_composition(
            direct_parent_mask, template, request, request,
            &feasibility, candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, stage) &&
        !pal_try_composition(
            direct_parent_mask, template, request, request,
            &authorization, candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, stage)
    let observed_laundering =
        !request.engine_observed &&
        !pal_try_composition(
            direct_parent_mask, template, &observed_engine, request,
            binding, candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, stage) &&
        !pireus_apple_material_cost_observed(&observed_engine, binding)
    let premature =
        !pal_try_composition(
            direct_parent_mask, template, request, request,
            &premature_binding, candidate, material_parent_mask,
            target_cost_parent_live, material_parent_live, &premature_stage) &&
        !pireus_apple_execution_authorized(binding) &&
        !pal_comparison_present(request, binding)

    var pair_machine_receipt_binding = pal_copy_binding(binding)
    pair_machine_receipt_binding.machine_id = PIREUS_MUTATION_MACHINE_DGX_SIBLING
    pair_machine_receipt_binding.receipt_id = binding.receipt_id + 1
    var pair_engine_evidence_binding = pal_copy_binding(binding)
    pair_engine_evidence_binding.engine_id = PIREUS_BLUEPRINT_DGX_GPU
    pair_engine_evidence_binding.evidence_id = binding.evidence_id + 1
    var pair_target_engine_request = pal_copy_request(request)
    pair_target_engine_request.target_id = PIREUS_TARGET_DGX_SPARK
    var pair_target_engine_binding = pal_copy_binding(binding)
    pair_target_engine_binding.engine_id = PIREUS_BLUEPRINT_DGX_GPU
    var pair_subject_request = pal_copy_request(request)
    pair_subject_request.subject_kind = PIREUS_COST_SUBJECT_COMPLETE_OPERATION
    var pair_subject_binding = pal_copy_binding(binding)
    pair_subject_binding.eligibility_id = pair_subject_binding.eligibility_id + 1
    var pair_unit_request = pal_copy_request(request)
    pair_unit_request.unit = PIREUS_COST_UNIT_NANOSECOND
    var pair_unit_binding = pal_copy_binding(binding)
    pair_unit_binding.measurement_feasibility =
        PIREUS_MEASUREMENT_FEASIBILITY_ADMITTED
    var pair_value_environment = pal_copy_request(request)
    pair_value_environment.value_present = true
    pair_value_environment.bound_environment_mask = PIREUS_COST_ENV_COMPLETE
    var pair_summary_request = pal_copy_request(request)
    pair_summary_request.value_present = true
    var pair_summary_binding = pal_copy_binding(binding)
    pair_summary_binding.state_tag = PIREUS_REQUEST_STAGE_SUMMARY_ELIGIBLE
    var pair_summary_stage = pal_copy_stage(stage)
    pair_summary_stage.to_tag = PIREUS_REQUEST_STAGE_SUMMARY_ELIGIBLE
    var pair_execution_binding = pal_copy_binding(binding)
    pair_execution_binding.state_tag = PIREUS_REQUEST_STAGE_EXECUTION_AUTHORIZED
    pair_execution_binding.execution_authorization_id = 1
    var pair_execution_stage = pal_copy_stage(stage)
    pair_execution_stage.to_tag = PIREUS_REQUEST_STAGE_EXECUTION_AUTHORIZED

    let pair_machine_receipt = !pal_try_composition(
        direct_parent_mask, template, request, request,
        &pair_machine_receipt_binding, candidate, material_parent_mask,
        target_cost_parent_live, material_parent_live, stage)
    let pair_engine_evidence = !pal_try_composition(
        direct_parent_mask, template, request, request,
        &pair_engine_evidence_binding, candidate, material_parent_mask,
        target_cost_parent_live, material_parent_live, stage)
    let pair_target_engine = !pal_try_composition(
        direct_parent_mask, template, &pair_target_engine_request, request,
        &pair_target_engine_binding, candidate, material_parent_mask,
        target_cost_parent_live, material_parent_live, stage)
    let pair_subject_eligibility = !pal_try_composition(
        direct_parent_mask, template, &pair_subject_request, request,
        &pair_subject_binding, candidate, material_parent_mask,
        target_cost_parent_live, material_parent_live, stage)
    let pair_unit_feasibility = !pal_try_composition(
        direct_parent_mask, template, &pair_unit_request, request,
        &pair_unit_binding, candidate, material_parent_mask,
        target_cost_parent_live, material_parent_live, stage)
    let pair_value_bound_environment = !pal_try_composition(
        direct_parent_mask, template, &pair_value_environment, request,
        binding, candidate, material_parent_mask,
        target_cost_parent_live, material_parent_live, stage)
    let pair_summary_observation = !pal_try_composition(
        direct_parent_mask, template, &pair_summary_request, request,
        &pair_summary_binding, candidate, material_parent_mask,
        target_cost_parent_live, material_parent_live, &pair_summary_stage)
    let pair_stage_execution_authorization = !pal_try_composition(
        direct_parent_mask, template, request, request,
        &pair_execution_binding, candidate, material_parent_mask,
        target_cost_parent_live, material_parent_live, &pair_execution_stage)

    let values: [bool; 28] = [
        baseline_valid && parent_drift,
        baseline_valid && request_id_drift,
        baseline_valid && target_drift,
        baseline_valid && subject_drift,
        baseline_valid && quantity_drift,
        baseline_valid && unit_drift,
        baseline_valid && scope_drift,
        baseline_valid && sampling_drift,
        baseline_valid && environment_drift,
        baseline_valid && value_or_derived,
        baseline_valid && foreign_composition,
        baseline_valid && coordinate_drift,
        baseline_valid && unresolved,
        baseline_valid && transport,
        baseline_valid && cpp,
        baseline_valid && external,
        baseline_valid && forbidden,
        baseline_valid && interface_inference,
        baseline_valid && observed_laundering,
        baseline_valid && premature,
        baseline_valid && pair_machine_receipt,
        baseline_valid && pair_engine_evidence,
        baseline_valid && pair_target_engine,
        baseline_valid && pair_subject_eligibility,
        baseline_valid && pair_unit_feasibility,
        baseline_valid && pair_value_bound_environment,
        baseline_valid && pair_summary_observation,
        baseline_valid && pair_stage_execution_authorization,
    ]
    var passed: i64 = 0
    var i: i64 = 0
    while i < 28 {
        if values[i as usize] { passed = passed + 1 }
        i = i + 1
    }
    PireusAppleCpuLatencyNegatives {
        missing_garden_or_parent_drift: parent_drift,
        request_id_drift: request_id_drift,
        target_drift: target_drift,
        subject_drift: subject_drift,
        quantity_drift: quantity_drift,
        unit_drift: unit_drift,
        scope_drift: scope_drift,
        sampling_contract_drift: sampling_drift,
        environment_contract_drift: environment_drift,
        value_or_derived_artifact_inserted: value_or_derived,
        foreign_target_or_engine_composition: foreign_composition,
        material_coordinate_drift: coordinate_drift,
        unresolved_dgx_48_identity: unresolved,
        transport_inference: transport,
        cpp_semantic_authority: cpp,
        external_review_authority: external,
        forbidden_python_or_rust: forbidden,
        interface_feasibility_or_authorization_inference: interface_inference,
        engine_observed_laundering: observed_laundering,
        premature_stage: premature,
        pair_machine_receipt: pair_machine_receipt,
        pair_engine_evidence: pair_engine_evidence,
        pair_target_engine: pair_target_engine,
        pair_subject_eligibility: pair_subject_eligibility,
        pair_unit_feasibility: pair_unit_feasibility,
        pair_value_bound_environment: pair_value_bound_environment,
        pair_summary_observation: pair_summary_observation,
        pair_stage_execution_authorization: pair_stage_execution_authorization,
        passed: passed,
        total: 28,
    }
}

fn pal_digest_request(
    state: SHA256State, request: &PireusCostRequest,
) -> SHA256State with Mut, Panic, Div {
    var next = pal_digest_add_i64(state, request.request_id)
    next = pal_digest_add_i64(next, request.target_id)
    next = pal_digest_add_i64(next, request.machine_id)
    next = pal_digest_add_i64(next, request.engine_id)
    next = pal_digest_add_bool(next, request.engine_is_blueprint)
    next = pal_digest_add_bool(next, request.engine_observed)
    next = pal_digest_add_i64(next, request.subject_kind)
    next = pal_digest_add_i64(next, request.subject_node)
    next = pal_digest_add_i64(next, request.quantity)
    next = pal_digest_add_i64(next, request.unit)
    next = pal_digest_add_i64(next, request.scope)
    next = pal_digest_add_i64(next, request.statistic)
    next = pal_digest_add_i64(next, request.requested_sample_count)
    next = pal_digest_add_i64(next, request.requested_warmup_count)
    next = pal_digest_add_i64(next, request.required_environment_mask)
    next = pal_digest_add_i64(next, request.bound_environment_mask)
    next = pal_digest_add_i64(next, request.evidence_role)
    next = pal_digest_add_i64(next, request.producer_language)
    next = pal_digest_add_i64(next, request.producer_role)
    next = pal_digest_add_bool(next, request.value_present)
    next = pal_digest_add_i64(next, request.estimate_numerator)
    next = pal_digest_add_i64(next, request.estimate_denominator)
    next = pal_digest_add_i64(next, request.lower_numerator)
    next = pal_digest_add_i64(next, request.lower_denominator)
    next = pal_digest_add_i64(next, request.upper_numerator)
    next = pal_digest_add_i64(next, request.upper_denominator)
    next = pal_digest_add_bool(next, request.subject_covered)
    pal_digest_add_bool(next, request.admitted)
}

fn pal_digest_binding(
    state: SHA256State, binding: &PireusMaterialEngineBinding,
) -> SHA256State with Mut, Panic, Div {
    var next = pal_digest_add_i64(state, binding.template_request_id)
    next = pal_digest_add_i64(next, binding.target_id)
    next = pal_digest_add_i64(next, binding.machine_id)
    next = pal_digest_add_i64(next, binding.engine_id)
    next = pal_digest_add_i64(next, binding.engine_kind)
    next = pal_digest_add_i64(next, binding.isa_id)
    next = pal_digest_add_i64(next, binding.receipt_id)
    next = pal_digest_add_i64(next, binding.evidence_id)
    next = pal_digest_add_i64(next, binding.hardware_id)
    next = pal_digest_add_i64(next, binding.material_subject_id)
    next = pal_digest_add_i64(next, binding.material_operation_id)
    next = pal_digest_add_i64(next, binding.eligibility_id)
    next = pal_digest_add_i64(next, binding.state_tag)
    next = pal_digest_add_i64(next, binding.execution_authorization_id)
    next = pal_digest_add_i64(next, binding.measurement_feasibility)
    next = pal_digest_add_i64(next, binding.producer_language)
    pal_digest_add_i64(next, binding.producer_role)
}

fn pal_digest_negatives(
    state: SHA256State, negatives: &PireusAppleCpuLatencyNegatives,
) -> SHA256State with Mut, Panic, Div {
    let values: [bool; 28] = [
        negatives.missing_garden_or_parent_drift,
        negatives.request_id_drift, negatives.target_drift,
        negatives.subject_drift, negatives.quantity_drift,
        negatives.unit_drift, negatives.scope_drift,
        negatives.sampling_contract_drift,
        negatives.environment_contract_drift,
        negatives.value_or_derived_artifact_inserted,
        negatives.foreign_target_or_engine_composition,
        negatives.material_coordinate_drift,
        negatives.unresolved_dgx_48_identity,
        negatives.transport_inference,
        negatives.cpp_semantic_authority,
        negatives.external_review_authority,
        negatives.forbidden_python_or_rust,
        negatives.interface_feasibility_or_authorization_inference,
        negatives.engine_observed_laundering,
        negatives.premature_stage,
        negatives.pair_machine_receipt,
        negatives.pair_engine_evidence,
        negatives.pair_target_engine,
        negatives.pair_subject_eligibility,
        negatives.pair_unit_feasibility,
        negatives.pair_value_bound_environment,
        negatives.pair_summary_observation,
        negatives.pair_stage_execution_authorization,
    ]
    var next = state
    var i: i64 = 0
    while i < 28 {
        next = pal_digest_add_bool(next, values[i as usize])
        i = i + 1
    }
    next = pal_digest_add_i64(next, negatives.passed)
    pal_digest_add_i64(next, negatives.total)
}

fn pal_result_digest(
    parent_mask: i64,
    parent_manifest_digest: &PireusAppleCpuLatencyDigest,
    ontology_digest: &PireusAppleCpuLatencyDigest,
    cost: &PireusTargetCostObservationResult,
    material: &PireusMaterialEngineAdmissionResult,
    template: &PireusRequestTemplateRef,
    request: &PireusCostRequest,
    binding: &PireusMaterialEngineBinding,
    stage: &PireusRequestStage,
    boundaries: &[bool; 20],
    ontology_triple_count: i64,
    negatives: &PireusAppleCpuLatencyNegatives,
) -> PireusAppleCpuLatencyDigest with Mut, Panic, Div {
    var state = sha256_init()
    state = pal_digest_add_string(
        state, "SOUNIO-PIREUS-APPLE-CPU-DEPENDENCY-LATENCY-REQUEST")
    state = pal_digest_add_string(
        state, "pireus.apple-cpu-dependency-latency-request.v0")
    state = pal_digest_add_i64(state, parent_mask)
    state = pal_digest_add_words(state, &parent_manifest_digest.words)
    state = pal_digest_add_words(state, &cost.result_digest.words)
    state = pal_digest_add_words(state, &material.result_digest.words)
    state = pal_digest_add_i64(state, template.request_index)
    state = pal_digest_add_i64(state, template.request_id)
    state = pal_digest_request(state, request)
    state = pal_digest_binding(state, binding)
    state = pal_digest_add_i64(state, stage.from_tag)
    state = pal_digest_add_i64(state, stage.to_tag)
    var i: i64 = 0
    while i < 20 {
        state = pal_digest_add_bool(state, boundaries[i as usize])
        i = i + 1
    }
    state = pal_digest_add_i64(state, ontology_triple_count)
    state = pal_digest_add_words(state, &ontology_digest.words)
    state = pal_digest_negatives(state, negatives)
    pal_digest_finish(state)
}

pub fn pireus_apple_cpu_dependency_latency_request_evaluate(
    pdf_path: string,
    xed_path: string,
    material_files: &PireusXorMaterialFilePaths,
    parent_paths: &PireusAppleCpuLatencyParentPaths,
) -> PireusAppleCpuLatencyRequestResult
with IO, Mut, Panic, Div, Alloc, Epistemic {
    let parent_mask = pal_parent_match_mask(parent_paths)
    var parent_count: i64 = 0
    var i: i64 = 0
    while i < PIREUS_APPLE_CPU_LATENCY_PARENT_FILE_COUNT {
        if pireus_apple_cpu_latency_parent_file_matches(parent_mask, i) {
            parent_count = parent_count + 1
        }
        i = i + 1
    }
    let parent_files_valid = pal_all_parents_match(parent_mask)
    let manifest_digest = pal_parent_manifest_digest(parent_paths)

    let cost_paths = pal_cost_parent_paths(parent_paths)
    let cost = pireus_target_cost_observation_evaluate(
        pdf_path, xed_path, material_files, &cost_paths)
    let target_cost_parent_live =
        pireus_target_cost_observation_matches_frozen_semantics(&cost)

    let material_paths = pal_material_parent_paths(parent_paths)
    let material = pireus_material_engine_admission_evaluate(&material_paths)
    let material_parent_live =
        pireus_material_engine_admission_matches_frozen_semantics(&material)

    let request = pireus_cost_ledger_request(
        &cost.ledger, PIREUS_APPLE_CPU_LATENCY_REQUEST_INDEX)
    let template = PireusRequestTemplateRef {
        request_index: PIREUS_APPLE_CPU_LATENCY_REQUEST_INDEX,
        request_id: request.request_id,
    }
    let candidate = pireus_material_engine_apple_candidate()
    let binding = pal_binding(&candidate)
    let stage = PireusRequestStage {
        from_tag: PIREUS_REQUEST_STAGE_TEMPLATE,
        to_tag: PIREUS_REQUEST_STAGE_MATERIAL_IDENTITY_BOUND,
    }

    let request_valid = pireus_apple_request_template_exact(
        &template, &request, &request, target_cost_parent_live)
    let material_valid = pireus_apple_material_instance_exact(
        &binding, &candidate, material.parent_file_match_mask,
        material_parent_live)
    let target_matches = pireus_apple_request_target_matches_instance(
        &request, &binding, &candidate)
    let subject_matches = pireus_apple_request_subject_matches_receipt(
        &request, &binding, &candidate)
    let quantity_eligible = pireus_apple_request_quantity_is_eligible(
        &request, &binding, &candidate, material.parent_file_match_mask)
    let stage_valid = pireus_apple_stage_allows_identity_binding(&stage) &&
        binding.state_tag == stage.to_tag
    let binding_valid = pireus_apple_material_identity_binding_valid(
        parent_mask, &template, &request, &request, &binding, &candidate,
        material.parent_file_match_mask,
        target_cost_parent_live, material_parent_live, &stage)

    let interface_ready = pireus_apple_measurement_interface_ready(&candidate)
    let execution_authorized = pireus_apple_execution_authorized(&binding)
    let environment_bound = request.required_environment_mask != 0 &&
        (request.bound_environment_mask & request.required_environment_mask) ==
            request.required_environment_mask
    let value_present = request.value_present
    let observation_present = pireus_apple_material_cost_observed(
        &request, &binding)
    let summary_present = pal_derived_summary_present(&request, &binding)
    let comparison_present = pal_comparison_present(&request, &binding)
    let speedup_present = pal_speedup_present(&request, &binding)
    let ranking_present = pal_ranking_present(&request, &binding)
    let parity_open = pal_parity_open(&request, &binding)
    let claim_ready = pal_claim_ready(&request, &binding)

    var ontology_output: [i64; 9] = [0; 9]
    let ontology_projection_valid = pal_ontology_projection(
        &request, &binding, &!ontology_output)
    let ontology_triple_count = ontology_output[0]
    var ontology_words: [i64; 8] = [0; 8]
    i = 0
    while i < 8 {
        ontology_words[i as usize] = ontology_output[(i + 1) as usize]
        i = i + 1
    }
    let ontology_digest = PireusAppleCpuLatencyDigest {
        words: ontology_words,
    }
    let ontology_binding_valid = ontology_projection_valid && binding_valid
    let negatives = pal_exercise_negatives(
        parent_mask, &template, &request, &binding, &candidate,
        material.parent_file_match_mask,
        target_cost_parent_live, material_parent_live, &stage)

    var error = PIREUS_APPLE_CPU_LATENCY_OK
    if !parent_files_valid || !target_cost_parent_live || !material_parent_live {
        error = PIREUS_APPLE_CPU_LATENCY_ERR_PARENT
    } else if !request_valid {
        error = PIREUS_APPLE_CPU_LATENCY_ERR_REQUEST
    } else if !material_valid || !target_matches || !subject_matches ||
        !quantity_eligible {
        error = PIREUS_APPLE_CPU_LATENCY_ERR_MATERIAL
    } else if !stage_valid {
        error = PIREUS_APPLE_CPU_LATENCY_ERR_STAGE
    } else if !binding_valid || interface_ready || execution_authorized ||
        environment_bound || value_present || observation_present ||
        summary_present || comparison_present || speedup_present ||
        ranking_present || parity_open || claim_ready ||
        negatives.passed != negatives.total {
        error = PIREUS_APPLE_CPU_LATENCY_ERR_AUTHORITY
    } else if !ontology_binding_valid {
        error = PIREUS_APPLE_CPU_LATENCY_ERR_ONTOLOGY
    }
    let failures = if error == PIREUS_APPLE_CPU_LATENCY_OK { 0 } else { 1 }
    let boundaries: [bool; 20] = [
        parent_files_valid, target_cost_parent_live, material_parent_live,
        request_valid, material_valid, target_matches, subject_matches,
        quantity_eligible, binding_valid, interface_ready,
        execution_authorized, environment_bound, value_present,
        observation_present, summary_present, comparison_present,
        speedup_present, ranking_present, parity_open, claim_ready,
    ]
    let digest = pal_result_digest(
        parent_mask, &manifest_digest, &ontology_digest,
        &cost, &material, &template, &request, &binding, &stage,
        &boundaries, ontology_triple_count, &negatives)

    PireusAppleCpuLatencyRequestResult {
        valid: error == PIREUS_APPLE_CPU_LATENCY_OK && failures == 0,
        error: error,
        parent_file_match_mask: parent_mask,
        parent_file_match_count: parent_count,
        parent_files_valid: parent_files_valid,
        target_cost_parent_live: target_cost_parent_live,
        material_engine_parent_live: material_parent_live,
        template: template,
        request: request,
        binding: binding,
        stage: stage,
        request_template_valid: request_valid,
        material_instance_valid: material_valid,
        target_matches_instance: target_matches,
        subject_matches_receipt: subject_matches,
        quantity_eligible: quantity_eligible,
        engine_identity_materially_admitted: binding_valid,
        measurement_interface_ready: interface_ready,
        execution_authorized: execution_authorized,
        environment_bound: environment_bound,
        value_present: value_present,
        material_observation_present: observation_present,
        derived_summary_present: summary_present,
        comparison_present: comparison_present,
        speedup_present: speedup_present,
        ranking_present: ranking_present,
        parity_open: parity_open,
        claim_ready: claim_ready,
        ontology_triple_count: ontology_triple_count,
        ontology_binding_valid: ontology_binding_valid,
        parent_manifest_digest: manifest_digest,
        ontology_digest: ontology_digest,
        result_digest: digest,
        negatives: negatives,
        failures: failures,
    }
}

/// Exact predicate written only after the first post-Garden Sounio stream.
pub fn pireus_apple_cpu_dependency_latency_request_matches_frozen_semantics(
    result: &PireusAppleCpuLatencyRequestResult,
) -> bool with Mut, Panic {
    if !result.valid || result.error != PIREUS_APPLE_CPU_LATENCY_OK ||
        result.failures != 0 || !result.parent_files_valid ||
        result.parent_file_match_count != 9 ||
        !result.target_cost_parent_live ||
        !result.material_engine_parent_live {
        return false
    }
    var i: i64 = 0
    while i < PIREUS_APPLE_CPU_LATENCY_PARENT_FILE_COUNT {
        if !pireus_apple_cpu_latency_parent_file_matches(
            result.parent_file_match_mask, i) {
            return false
        }
        i = i + 1
    }
    if result.template.request_index !=
            PIREUS_APPLE_CPU_LATENCY_REQUEST_INDEX ||
        result.template.request_id != PIREUS_APPLE_CPU_LATENCY_REQUEST_ID ||
        result.request.request_id != PIREUS_APPLE_CPU_LATENCY_REQUEST_ID ||
        result.request.target_id != PIREUS_TARGET_APPLE_SILICON ||
        result.request.machine_id != 0 ||
        result.request.engine_id != PIREUS_BLUEPRINT_APPLE_CPU ||
        !result.request.engine_is_blueprint ||
        result.request.engine_observed ||
        result.request.subject_kind != PIREUS_COST_SUBJECT_LOWERING_NODE ||
        result.request.subject_node != 0 ||
        result.request.quantity != PIREUS_COST_DEPENDENCY_LATENCY ||
        result.request.unit != PIREUS_COST_UNIT_CYCLE ||
        result.request.scope != PIREUS_COST_SCOPE_DEPENDENCY_CHAIN ||
        result.request.statistic != PIREUS_COST_STAT_MEDIAN ||
        result.request.requested_sample_count != 1001 ||
        result.request.requested_warmup_count != 128 ||
        result.request.required_environment_mask != PIREUS_COST_ENV_COMPLETE ||
        result.request.bound_environment_mask != 0 ||
        result.request.evidence_role != PIREUS_COST_EVIDENCE_REQUEST ||
        result.request.producer_language != PIREUS_COST_LANGUAGE_SOUNIO ||
        result.request.producer_role !=
            PIREUS_COST_ROLE_SEMANTIC_AUTHORITY ||
        result.request.value_present ||
        result.request.estimate_numerator != 0 ||
        result.request.estimate_denominator != 0 ||
        result.request.lower_numerator != 0 ||
        result.request.lower_denominator != 0 ||
        result.request.upper_numerator != 0 ||
        result.request.upper_denominator != 0 ||
        !result.request.subject_covered || !result.request.admitted ||
        !pireus_cost_request_valid(&result.request) {
        return false
    }
    if result.binding.template_request_id !=
            PIREUS_APPLE_CPU_LATENCY_REQUEST_ID ||
        result.binding.target_id != PIREUS_TARGET_APPLE_SILICON ||
        result.binding.machine_id != PIREUS_MACHINE_APPLE_MAC17_7 ||
        result.binding.engine_id != PIREUS_ENGINE_CPU_APPLE_M5_MAX ||
        result.binding.engine_kind != PIREUS_ENGINE_KIND_CPU ||
        result.binding.isa_id != PIREUS_ENGINE_ISA_AARCH64 ||
        result.binding.receipt_id != PIREUS_RECEIPT_APPLE_A64_TBL ||
        result.binding.evidence_id != PIREUS_EVIDENCE_APPLE_A64_TBL ||
        result.binding.hardware_id != PIREUS_HARDWARE_APPLE_MAC17_7 ||
        result.binding.material_subject_id !=
            PIREUS_MATERIAL_SUBJECT_XOR_SELECTOR ||
        result.binding.material_operation_id !=
            PIREUS_MATERIAL_OPERATION_APPLE_A64_TBL ||
        result.binding.eligibility_id != PIREUS_ELIGIBILITY_APPLE_LATENCY ||
        result.binding.state_tag !=
            PIREUS_REQUEST_STAGE_MATERIAL_IDENTITY_BOUND ||
        result.binding.execution_authorization_id != 0 ||
        result.binding.measurement_feasibility !=
            PIREUS_MEASUREMENT_FEASIBILITY_UNKNOWN ||
        result.binding.producer_language != PIREUS_COST_LANGUAGE_SOUNIO ||
        result.binding.producer_role !=
            PIREUS_COST_ROLE_SEMANTIC_AUTHORITY ||
        result.stage.from_tag != PIREUS_REQUEST_STAGE_TEMPLATE ||
        result.stage.to_tag !=
            PIREUS_REQUEST_STAGE_MATERIAL_IDENTITY_BOUND {
        return false
    }
    if !result.request_template_valid || !result.material_instance_valid ||
        !result.target_matches_instance || !result.subject_matches_receipt ||
        !result.quantity_eligible ||
        !result.engine_identity_materially_admitted ||
        result.measurement_interface_ready || result.execution_authorized ||
        result.environment_bound || result.value_present ||
        result.material_observation_present ||
        result.derived_summary_present || result.comparison_present ||
        result.speedup_present || result.ranking_present ||
        result.parity_open || result.claim_ready ||
        result.ontology_triple_count != 26 ||
        !result.ontology_binding_valid {
        return false
    }
    if result.negatives.passed != 28 || result.negatives.total != 28 ||
        !result.negatives.missing_garden_or_parent_drift ||
        !result.negatives.request_id_drift ||
        !result.negatives.target_drift ||
        !result.negatives.subject_drift ||
        !result.negatives.quantity_drift ||
        !result.negatives.unit_drift ||
        !result.negatives.scope_drift ||
        !result.negatives.sampling_contract_drift ||
        !result.negatives.environment_contract_drift ||
        !result.negatives.value_or_derived_artifact_inserted ||
        !result.negatives.foreign_target_or_engine_composition ||
        !result.negatives.material_coordinate_drift ||
        !result.negatives.unresolved_dgx_48_identity ||
        !result.negatives.transport_inference ||
        !result.negatives.cpp_semantic_authority ||
        !result.negatives.external_review_authority ||
        !result.negatives.forbidden_python_or_rust ||
        !result.negatives.interface_feasibility_or_authorization_inference ||
        !result.negatives.engine_observed_laundering ||
        !result.negatives.premature_stage ||
        !result.negatives.pair_machine_receipt ||
        !result.negatives.pair_engine_evidence ||
        !result.negatives.pair_target_engine ||
        !result.negatives.pair_subject_eligibility ||
        !result.negatives.pair_unit_feasibility ||
        !result.negatives.pair_value_bound_environment ||
        !result.negatives.pair_summary_observation ||
        !result.negatives.pair_stage_execution_authorization {
        return false
    }
    let expected_manifest: [i64; 8] = [
        2484893681, 3053564117, 3251292557, 837524480,
        2326288797, 2545336006, 1298056031, 153129504,
    ]
    let expected_ontology: [i64; 8] = [
        3934472735, 2831266448, 3468731955, 3829704731,
        2302707619, 4052771782, 1038330726, 1883965869,
    ]
    let expected_result: [i64; 8] = [
        4077763757, 3866677980, 1417460964, 3007782540,
        1995848965, 1363182042, 817142050, 850659687,
    ]
    pal_hash_equal(&result.parent_manifest_digest.words, &expected_manifest) &&
        pal_hash_equal(&result.ontology_digest.words, &expected_ontology) &&
        pal_hash_equal(&result.result_digest.words, &expected_result)
}
