use ontology::query::{SolutionRow, Binding, solution_row_new, binding_iri}
fn by_ref(row: &SolutionRow) -> i64 with Epistemic { row.bindings[0].variable_id }
fn by_value(row: SolutionRow) -> i64 with Epistemic { row.bindings[0].variable_id }
fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    var flat: Seq<Binding> = seq_new()
    flat.push(binding_iri(7, 701200))
    print("flat.id="); print_int(flat[0].variable_id); print("\n")
    print("flat.iri="); print_int(flat[0].iri_value); print("\n")
    var row = solution_row_new()
    row.bindings.push(binding_iri(7, 701200))
    print("row.id="); print_int(row.bindings[0].variable_id); print("\n")
    print("row.iri="); print_int(row.bindings[0].iri_value); print("\n")
    print("ref.id="); print_int(by_ref(&row)); print("\n")
    print("value.id="); print_int(by_value(row)); print("\n")
    if flat[0].variable_id != 7 { return 1 }
    if row.bindings[0].variable_id != 7 { return 2 }
    if by_ref(&row) != 7 { return 3 }
    0
}
