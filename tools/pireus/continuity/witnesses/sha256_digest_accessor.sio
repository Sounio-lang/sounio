// Current execution control for the restored imported dependency.
use crypto::sha256::{sha256_hash, sha256_digest_byte}

fn main() -> i32 with Mut, Panic, Div, IO {
    var input: [u8; 256] = [0; 256]
    input[0] = 97 as u8
    input[1] = 98 as u8
    input[2] = 99 as u8
    let digest = sha256_hash(input, 3)
    let expected: [i64; 32] = [
        186, 120, 22, 191, 143, 1, 207, 234,
        65, 65, 64, 222, 93, 174, 34, 35,
        176, 3, 97, 163, 150, 23, 122, 156,
        180, 16, 255, 97, 242, 0, 21, 173
    ]
    var i: i32 = 0
    while i < 32 {
        if sha256_digest_byte(&digest, i) != expected[i] { return 1 }
        i = i + 1
    }
    if sha256_digest_byte(&digest, -1) != -1 { return 2 }
    if sha256_digest_byte(&digest, 32) != -1 { return 3 }
    print("SHA256_DIGEST_ACCESSOR_PASS\n")
    0
}
