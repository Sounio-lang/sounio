use ontology::query::{solution_row_new, solution_row_add, solution_row_get, solution_row_has, binding_iri}
fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    var direct = solution_row_new()
    direct.bindings.push(binding_iri(7, 701200))
    print("direct.count="); print_int(direct.bindings.len().unwrap("n")); print("\n")
    print("direct.has="); print_int(if solution_row_has(&direct, 7) { 1 } else { 0 }); print("\n")
    print("direct.get="); print_int(solution_row_get(&direct, 7)); print("\n")
    var indirect = solution_row_new()
    solution_row_add(&indirect, binding_iri(7, 701200))
    print("indirect.count="); print_int(indirect.bindings.len().unwrap("n")); print("\n")
    print("indirect.has="); print_int(if solution_row_has(&indirect, 7) { 1 } else { 0 }); print("\n")
    print("indirect.get="); print_int(solution_row_get(&indirect, 7)); print("\n")
    if solution_row_get(&direct, 7) != 701200 { return 1 }
    if solution_row_get(&indirect, 7) != 701200 { return 2 }
    0
}
