// Pireus target-capability ontology and candidate synthesizer.
// Semantic authority stays in xor_basis4_semantic_authority.sio; this program
// derives target candidates and their promotion class from explicit facts.
pub enum PireusTarget {
    DgxSparkSm121,
    XeonAvx512,
    AppleSiliconMetal,
}

pub struct TargetCapabilities {
    pub target: PireusTarget,
    pub native_f64: bool,
    pub lane_width: i64,
    pub indexed_permute: bool,
    pub lane_shuffle: bool,
    pub global_load: bool,
}

fn dgx_sm121() -> TargetCapabilities {
    TargetCapabilities {
        target: PireusTarget::DgxSparkSm121,
        native_f64: true,
        lane_width: 32,
        indexed_permute: false,
        lane_shuffle: true,
        global_load: true,
    }
}

fn xeon_avx512() -> TargetCapabilities {
    TargetCapabilities {
        target: PireusTarget::XeonAvx512,
        native_f64: true,
        lane_width: 8,
        indexed_permute: true,
        lane_shuffle: false,
        global_load: true,
    }
}

fn apple_metal() -> TargetCapabilities {
    TargetCapabilities {
        target: PireusTarget::AppleSiliconMetal,
        native_f64: false,
        lane_width: 32,
        indexed_permute: true,
        lane_shuffle: true,
        global_load: true,
    }
}

fn emit_dgx(c: TargetCapabilities) -> i64 with IO {
    var count: i64 = 0
    print("target=dgx-sm121 native_f64=1 lane_width=32\n")
    if c.native_f64 && c.lane_shuffle && c.lane_width >= 16 {
        print("candidate=dgx-sm121/warp-shuffle equivalence=EXACT promotable=1\n")
        count = count + 1
    }
    if c.native_f64 && c.global_load {
        print("candidate=dgx-sm121/global-load equivalence=EXACT promotable=1\n")
        count = count + 1
    }
    count
}

fn emit_xeon(c: TargetCapabilities) -> i64 with IO {
    var count: i64 = 0
    print("target=xeon-avx512 native_f64=1 lane_width=8\n")
    if c.native_f64 && c.indexed_permute && c.lane_width == 8 {
        print("candidate=xeon-avx512/two-zmm-indexed-permute equivalence=EXACT promotable=1\n")
        count = count + 1
    }
    if c.native_f64 && c.global_load {
        print("candidate=xeon-avx512/scalar-reference equivalence=EXACT promotable=1\n")
        count = count + 1
    }
    count
}

fn emit_apple(c: TargetCapabilities) -> i64 with IO {
    var count: i64 = 0
    print("target=apple-silicon-metal native_f64=0 lane_width=32\n")
    if !c.native_f64 && c.global_load {
        print("candidate=apple-silicon-metal/f32-checked equivalence=APPROXIMATE promotable=0\n")
        print("candidate=apple-silicon-metal/float2-compensated equivalence=APPROXIMATE promotable=0\n")
        count = count + 2
    }
    print("decision=apple-silicon-metal/EXACT DENY reason=no-portable-native-f64\n")
    count
}

fn main() -> i32 with IO {
    print("schema=pireus-cross-arch-candidates-v1\n")
    print("producer_language=Sounio\n")
    print("producer_role=TARGET_CANDIDATE_SYNTHESIZER\n")
    print("operator=XorConvolution bits=4 twist=CayleyDicksonSign\n")
    let dgx_count = emit_dgx(dgx_sm121())
    let xeon_count = emit_xeon(xeon_avx512())
    let apple_count = emit_apple(apple_metal())
    let total = dgx_count + xeon_count + apple_count
    print("candidate_count="); print_int(total); print("\n")
    if dgx_count == 2 && xeon_count == 2 && apple_count == 2 && total == 6 {
        print("PIREUS_CROSS_ARCH_SYNTHESIZER_PASS\n")
        return 0
    }
    print("PIREUS_CROSS_ARCH_SYNTHESIZER_FAIL\n")
    1
}
