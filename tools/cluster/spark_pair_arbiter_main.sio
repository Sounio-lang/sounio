//! Native Sounio adapter for Spark Pair Arbiter frame 9024.

fn pair_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen = false
    while offset < 4096 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn pair_decimal_arg(index: i64) -> (i64, i64) with Mut, Div, Panic, IO {
    let raw = get_arg(index)
    let (ok, value, end_offset) = pair_decimal_field(raw, 0)
    if ok == 1 && str_char_at(raw, end_offset) <= 0 {
        return (1, value)
    }
    (0, 0)
}

fn pair_mask_bit(mask: i64, power: i64) -> i64 with Div {
    (mask / power) % 2
}

fn pair_state_name(state: i64) -> string {
    if state == 0 { return "UNINITIALIZED" }
    if state == 1 { return "SLURM_OWNED" }
    if state == 2 { return "DRAINING_SLURM" }
    if state == 3 { return "SLURM_QUIESCENT" }
    if state == 4 { return "DETACHING_SLURMD" }
    if state == 5 { return "K8S_RESERVING" }
    if state == 6 { return "K8S_OWNED" }
    if state == 7 { return "K8S_RELEASING" }
    if state == 8 { return "VERIFYING_GPU_CLEAN" }
    if state == 9 { return "SLURM_RESTORING" }
    if state == 10 { return "RECOVERY_REQUIRED" }
    "UNKNOWN"
}

fn pair_action_name(action: i64) -> string {
    if action == 1 { return "BOOTSTRAP_SLURM" }
    if action == 2 { return "BEGIN_ACQUIRE" }
    if action == 3 { return "CONFIRM_DRAIN" }
    if action == 4 { return "BEGIN_DETACH" }
    if action == 5 { return "BEGIN_RESERVE" }
    if action == 6 { return "CONFIRM_RESERVATIONS" }
    if action == 7 { return "HEARTBEAT" }
    if action == 8 { return "BEGIN_RELEASE" }
    if action == 9 { return "CONFIRM_GPU_CLEAN" }
    if action == 10 { return "BEGIN_RESTORE" }
    if action == 11 { return "ENTER_RECOVERY" }
    if action == 12 { return "CONFIRM_RESTORE" }
    if action == 13 { return "RECOVER_TO_SLURM" }
    if action == 14 { return "STATUS" }
    if action == 15 { return "RECOVERY_CLEAR_K8S" }
    if action == 16 { return "RECOVERY_PROBE_CLEAN" }
    if action == 17 { return "RECOVERY_DELETE_RESERVATIONS" }
    if action == 18 { return "RECOVERY_RESTORE_SLURMD" }
    if action == 19 { return "RECOVERY_RESUME_SLURM" }
    if action == 20 { return "RECOVERY_DETACH_SLURMD" }
    if action == 21 { return "RECOVERY_CREATE_RESERVATIONS" }
    if action == 22 { return "RECOVERY_DRAIN_SLURM" }
    if action == 23 { return "BOOTSTRAP_DRAIN_SLURM" }
    if action == 24 { return "BOOTSTRAP_INSTALL_FENCE" }
    if action == 25 { return "BOOTSTRAP_INSTALL_SLURMD" }
    if action == 26 { return "BOOTSTRAP_RESUME_SLURM" }
    if action == 27 { return "BOOTSTRAP_TAKEOVER" }
    if action == 28 { return "BOOTSTRAP_INITIALIZE" }
    "UNKNOWN"
}

fn pair_reason_name(reason: i64) -> string {
    if reason == 0 { return "ALLOW" }
    if reason == 101 { return "POLICY_MISSING" }
    if reason == 102 { return "POLICY_ERROR" }
    if reason == 103 { return "TIMEOUT" }
    if reason == 104 { return "MALFORMED_FRAME" }
    if reason == 105 { return "WRONG_STATE" }
    if reason == 106 { return "HOLDER_MISMATCH" }
    if reason == 107 { return "EPOCH_MISMATCH" }
    if reason == 108 { return "LEASE_NOT_LIVE" }
    if reason == 109 { return "PAIR_IDENTITY" }
    if reason == 110 { return "NODESET_DRIFT" }
    if reason == 111 { return "GPU_REQUEST_NOT_EXACT" }
    if reason == 112 { return "DEVICE_PLUGIN_NOT_EXCLUSIVE" }
    if reason == 113 { return "SLURM_CONTROL" }
    if reason == 114 { return "PAIR_NOT_DRAINED" }
    if reason == 115 { return "ACTIVE_JOBS" }
    if reason == 116 { return "ACTIVE_ALLOCATIONS" }
    if reason == 117 { return "SLURMD_PAIR" }
    if reason == 118 { return "GPU_CAPACITY" }
    if reason == 119 { return "RESERVATION_PAIR" }
    if reason == 120 { return "NVML_NOT_CLEAN" }
    if reason == 121 { return "WORKLOAD_NOT_ZERO" }
    if reason == 122 { return "HEARTBEAT_STALE" }
    if reason == 123 { return "RESUME_NOT_VERIFIED" }
    if reason == 124 { return "UNSUPPORTED_ACTION" }
    if reason == 125 { return "ADMISSION_NOT_FAIL_CLOSED" }
    if reason == 126 { return "PAIR_TAINT_NOT_EXACT" }
    if reason == 127 { return "UNEXPECTED_GPU_CONSUMER" }
    "UNKNOWN_REASON"
}

fn main() -> i64 with IO, Mut, Div, Panic {
    if arg_count() != 8 {
        println("SOUNIO_SPARK_PAIR_REFUSE schema=sounio-spark-pair-policy-v1 reason=MALFORMED_FRAME code=104")
        return 64
    }
    let (o0, schema) = pair_decimal_arg(0)
    let (o1, action) = pair_decimal_arg(1)
    let (o2, state) = pair_decimal_arg(2)
    let (o3, epoch) = pair_decimal_arg(3)
    let (o4, observed_epoch) = pair_decimal_arg(4)
    let (o5, authority_mask) = pair_decimal_arg(5)
    let (o6, slurm_mask) = pair_decimal_arg(6)
    let (o7, k8s_mask) = pair_decimal_arg(7)
    let parsed = o0 == 1 && o1 == 1 && o2 == 1 && o3 == 1 && o4 == 1 &&
        o5 == 1 && o6 == 1 && o7 == 1
    if !parsed || schema != 9024 || authority_mask > 1023 ||
        slurm_mask > 255 || k8s_mask > 1023 {
        println("SOUNIO_SPARK_PAIR_REFUSE schema=sounio-spark-pair-policy-v1 reason=MALFORMED_FRAME code=104")
        return 64
    }

    let authority = admit_spark_pair_authority_facts(
        pair_mask_bit(authority_mask, 1),
        pair_mask_bit(authority_mask, 2),
        pair_mask_bit(authority_mask, 4),
        pair_mask_bit(authority_mask, 8),
        pair_mask_bit(authority_mask, 16),
        pair_mask_bit(authority_mask, 32),
        pair_mask_bit(authority_mask, 64),
        pair_mask_bit(authority_mask, 128),
        pair_mask_bit(authority_mask, 256),
        pair_mask_bit(authority_mask, 512),
    )
    let slurm = admit_spark_pair_slurm_facts(
        pair_mask_bit(slurm_mask, 1),
        pair_mask_bit(slurm_mask, 2),
        pair_mask_bit(slurm_mask, 4),
        pair_mask_bit(slurm_mask, 8),
        pair_mask_bit(slurm_mask, 16),
        pair_mask_bit(slurm_mask, 32),
        pair_mask_bit(slurm_mask, 64),
        pair_mask_bit(slurm_mask, 128),
    )
    let k8s = admit_spark_pair_k8s_facts(
        pair_mask_bit(k8s_mask, 1),
        pair_mask_bit(k8s_mask, 2),
        pair_mask_bit(k8s_mask, 256),
        pair_mask_bit(k8s_mask, 4),
        pair_mask_bit(k8s_mask, 8),
        pair_mask_bit(k8s_mask, 16),
        pair_mask_bit(k8s_mask, 32),
        pair_mask_bit(k8s_mask, 64),
        pair_mask_bit(k8s_mask, 128),
        pair_mask_bit(k8s_mask, 512),
    )
    let decision = decide_spark_pair_transition(
        action, state, epoch, observed_epoch, authority, slurm, k8s,
    )
    let allowed = spark_pair_decision_allowed(decision)
    let from_state = spark_pair_decision_current_state(decision)
    let next_state = spark_pair_decision_next_state(decision)
    let reason = spark_pair_decision_reason(decision)
    if allowed {
        println("SOUNIO_SPARK_PAIR_ALLOW schema=sounio-spark-pair-policy-v1 action=" +
            pair_action_name(action) + " from=" + pair_state_name(from_state) +
            " to=" + pair_state_name(next_state) + " reason=ALLOW code=0")
        return 0
    }
    println("SOUNIO_SPARK_PAIR_REFUSE schema=sounio-spark-pair-policy-v1 action=" +
        pair_action_name(action) + " state=" + pair_state_name(from_state) +
        " reason=" + pair_reason_name(reason))
    42
}
