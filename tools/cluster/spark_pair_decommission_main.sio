//! Native Sounio adapter for the effect-free Spark pair decommission frame 9026.

fn decommission_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen = false
    while offset < 4096 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn decommission_decimal_arg(index: i64) -> (i64, i64) with Mut, Div, Panic, IO {
    let raw = get_arg(index)
    let (ok, value, end_offset) = decommission_decimal_field(raw, 0)
    if ok == 1 && str_char_at(raw, end_offset) <= 0 { return (1, value) }
    (0, 0)
}

fn decommission_mask_bit(mask: i64, power: i64) -> i64 with Div {
    (mask / power) % 2
}

fn decommission_state_name(state: i64) -> string {
    if state == 1 { return "SLURM_OWNED" }
    if state == 11 { return "DECOMMISSION_DRAINING" }
    if state == 12 { return "DECOMMISSION_FENCED" }
    if state == 13 { return "SCHEDULERS_WITHDRAWN" }
    if state == 14 { return "LEGACY_RESTORING" }
    if state == 15 { return "LEGACY_HOST_OWNED" }
    if state == 16 { return "RECOMMISSION_FENCING" }
    if state == 17 { return "RECOMMISSION_SCHEDULERS_RESTORING" }
    if state == 18 { return "RECOMMISSION_PHASE1_READY" }
    if state == 19 { return "DECOMMISSION_RECOVERY_REQUIRED" }
    "UNKNOWN"
}

fn decommission_custody_name(custody: i64) -> string {
    if custody == 1 { return "FENCED" }
    if custody == 2 { return "SLURM" }
    if custody == 3 { return "K8S" }
    if custody == 4 { return "LEGACY_HOST" }
    "UNKNOWN"
}

fn decommission_action_name(action: i64) -> string {
    if action == 33 { return "STATUS_DECOMMISSION" }
    if action == 34 { return "BEGIN_DECOMMISSION" }
    if action == 35 { return "CONFIRM_DECOMMISSION_FENCED" }
    if action == 36 { return "WITHDRAW_SCHEDULERS" }
    if action == 37 { return "CONFIRM_SCHEDULERS_WITHDRAWN" }
    if action == 38 { return "PREPARE_LEGACY_PAIR" }
    if action == 39 { return "COMMIT_LEGACY_PAIR" }
    if action == 40 { return "RESTORE_LEGACY_SERVICES" }
    if action == 41 { return "RETIRE_ARBITER_SURFACES" }
    if action == 42 { return "BEGIN_RECOMMISSION" }
    if action == 43 { return "CONFIRM_RECOMMISSION_FENCED" }
    if action == 44 { return "RESTORE_PHASE1_SURFACES" }
    if action == 45 { return "CONFIRM_RECOMMISSION_PHASE1" }
    if action == 46 { return "CONFIRM_RECOMMISSION_SLURM" }
    if action == 47 { return "ENTER_DECOMMISSION_RECOVERY" }
    if action == 48 { return "RECOVER_DECOMMISSION_FENCED" }
    if action == 49 { return "CONFIRM_LEGACY_HOST" }
    "UNKNOWN"
}

fn decommission_reason_name(reason: i64) -> string {
    if reason == 0 { return "ALLOW" }
    if reason == 101 { return "POLICY_MISSING" }
    if reason == 102 { return "POLICY_ERROR" }
    if reason == 103 { return "TIMEOUT" }
    if reason == 104 { return "MALFORMED_FRAME" }
    if reason == 106 { return "HOLDER_MISMATCH" }
    if reason == 107 { return "EPOCH_MISMATCH" }
    if reason == 108 { return "LEASE_NOT_LIVE" }
    if reason == 109 { return "PAIR_IDENTITY" }
    if reason == 110 { return "NODESET_DRIFT" }
    if reason == 111 { return "GPU_REQUEST_NOT_EXACT" }
    if reason == 112 { return "DEVICE_PLUGIN_NOT_EXCLUSIVE" }
    if reason == 113 { return "SLURM_CONTROL" }
    if reason == 114 { return "PAIR_NOT_DRAINED" }
    if reason == 115 { return "ACTIVE_JOBS" }
    if reason == 116 { return "ACTIVE_ALLOCATIONS" }
    if reason == 117 { return "SLURMD_PAIR" }
    if reason == 118 { return "GPU_CAPACITY" }
    if reason == 119 { return "RESERVATION_PAIR" }
    if reason == 121 { return "WORKLOAD_NOT_ZERO" }
    if reason == 123 { return "RESUME_NOT_VERIFIED" }
    if reason == 124 { return "UNSUPPORTED_ACTION" }
    if reason == 125 { return "ADMISSION_NOT_FAIL_CLOSED" }
    if reason == 126 { return "PAIR_TAINT_NOT_EXACT" }
    if reason == 127 { return "UNEXPECTED_GPU_CONSUMER" }
    if reason == 128 { return "HOST_FENCE_PAIR" }
    if reason == 129 { return "HOST_BOOT_PAIR" }
    if reason == 130 { return "HOST_EPOCH_RELATION" }
    if reason == 131 { return "HOST_OWNER_RELATION" }
    if reason == 132 { return "HOST_DEADMAN" }
    if reason == 133 { return "HOST_RUNTIME_GATE" }
    if reason == 134 { return "HOST_LEGACY_INVENTORY" }
    if reason == 135 { return "HOST_SERVICES_ACTIVE" }
    if reason == 136 { return "HOST_RESTARTS_ARMED" }
    if reason == 137 { return "HOST_DOCKER_GPU_CLAIM" }
    if reason == 138 { return "HOST_GPU_CONSUMER_SET" }
    if reason == 139 { return "HOST_GPU_CGROUP" }
    if reason == 140 { return "HOST_MEMORY_FLOOR" }
    if reason == 141 { return "HOST_PROTECTED_RESOURCE_DRIFT" }
    if reason == 142 { return "HOST_RECEIPT_PAIR" }
    if reason == 143 { return "HOST_HEARTBEAT_STALE" }
    if reason == 144 { return "HOST_DEVICE_BARRIER_RELATION" }
    if reason == 145 { return "CUSTODY_NOT_EXACT" }
    if reason == 146 { return "CUSTODY_STATE_MISMATCH" }
    if reason == 147 { return "ACTIVE_STEPS" }
    if reason == 148 { return "RESTORE_SNAPSHOT" }
    if reason == 149 { return "SNAPSHOT_NOT_REPLAYABLE" }
    if reason == 150 { return "DEVICE_PLUGIN_PAIR" }
    if reason == 151 { return "K8S_CAPACITY_NOT_ZERO" }
    if reason == 152 { return "LEGACY_PREPARE_PAIR" }
    if reason == 153 { return "LEGACY_COMMIT_PAIR" }
    if reason == 154 { return "LEGACY_SERVICE_IDENTITY" }
    if reason == 155 { return "LEGACY_RESTART_POLICY" }
    if reason == 156 { return "TOMBSTONE_NOT_DURABLE" }
    if reason == 157 { return "ARBITER_RETIREMENT_ORDER" }
    if reason == 158 { return "RECOMMISSION_INTENT_PAIR" }
    if reason == 159 { return "PHASE1_SURFACES" }
    if reason == 160 { return "PHASE1_RECEIPT" }
    if reason == 161 { return "LEGACY_OWNER_RECEIPT" }
    if reason == 162 { return "ARBITER_SURFACES_PRESENT" }
    if reason == 217 { return "DECOMMISSION_STATE" }
    "UNKNOWN_REASON"
}

fn main() -> i64 with IO, Mut, Div, Panic {
    if arg_count() != 11 {
        println("SOUNIO_SPARK_PAIR_DECOMMISSION_PLAN_REFUSE " +
            "schema=sounio-spark-pair-decommission-plan-v1 effect=NONE " +
            "reason=MALFORMED_FRAME code=104")
        return 64
    }
    let (o0, schema) = decommission_decimal_arg(0)
    let (o1, action) = decommission_decimal_arg(1)
    let (o2, state) = decommission_decimal_arg(2)
    let (o3, epoch) = decommission_decimal_arg(3)
    let (o4, observed_epoch) = decommission_decimal_arg(4)
    let (o5, custody) = decommission_decimal_arg(5)
    let (o6, authority_mask) = decommission_decimal_arg(6)
    let (o7, slurm_mask) = decommission_decimal_arg(7)
    let (o8, k8s_mask) = decommission_decimal_arg(8)
    let (o9, host_mask) = decommission_decimal_arg(9)
    let (o10, decommission_mask) = decommission_decimal_arg(10)
    let parsed = o0 == 1 && o1 == 1 && o2 == 1 && o3 == 1 && o4 == 1 &&
        o5 == 1 && o6 == 1 && o7 == 1 && o8 == 1 && o9 == 1 && o10 == 1
    if !parsed || schema != 9026 || authority_mask > 1023 || slurm_mask > 255 ||
        k8s_mask > 1023 || host_mask > 131071 || decommission_mask > 131071 {
        println("SOUNIO_SPARK_PAIR_DECOMMISSION_PLAN_REFUSE " +
            "schema=sounio-spark-pair-decommission-plan-v1 effect=NONE " +
            "reason=MALFORMED_FRAME code=104")
        return 64
    }

    let authority = admit_spark_pair_authority_facts(
        decommission_mask_bit(authority_mask, 1), decommission_mask_bit(authority_mask, 2),
        decommission_mask_bit(authority_mask, 4), decommission_mask_bit(authority_mask, 8),
        decommission_mask_bit(authority_mask, 16), decommission_mask_bit(authority_mask, 32),
        decommission_mask_bit(authority_mask, 64), decommission_mask_bit(authority_mask, 128),
        decommission_mask_bit(authority_mask, 256), decommission_mask_bit(authority_mask, 512),
    )
    let slurm = admit_spark_pair_slurm_facts(
        decommission_mask_bit(slurm_mask, 1), decommission_mask_bit(slurm_mask, 2),
        decommission_mask_bit(slurm_mask, 4), decommission_mask_bit(slurm_mask, 8),
        decommission_mask_bit(slurm_mask, 16), decommission_mask_bit(slurm_mask, 32),
        decommission_mask_bit(slurm_mask, 64), decommission_mask_bit(slurm_mask, 128),
    )
    let k8s = admit_spark_pair_k8s_facts(
        decommission_mask_bit(k8s_mask, 1), decommission_mask_bit(k8s_mask, 2),
        decommission_mask_bit(k8s_mask, 256), decommission_mask_bit(k8s_mask, 4),
        decommission_mask_bit(k8s_mask, 8), decommission_mask_bit(k8s_mask, 16),
        decommission_mask_bit(k8s_mask, 32), decommission_mask_bit(k8s_mask, 64),
        decommission_mask_bit(k8s_mask, 128), decommission_mask_bit(k8s_mask, 512),
    )
    let host = admit_spark_pair_host_facts(
        decommission_mask_bit(host_mask, 1), decommission_mask_bit(host_mask, 2),
        decommission_mask_bit(host_mask, 4), decommission_mask_bit(host_mask, 8),
        decommission_mask_bit(host_mask, 16), decommission_mask_bit(host_mask, 32),
        decommission_mask_bit(host_mask, 64), decommission_mask_bit(host_mask, 128),
        decommission_mask_bit(host_mask, 256), decommission_mask_bit(host_mask, 512),
        decommission_mask_bit(host_mask, 1024), decommission_mask_bit(host_mask, 2048),
        decommission_mask_bit(host_mask, 4096), decommission_mask_bit(host_mask, 8192),
        decommission_mask_bit(host_mask, 16384), decommission_mask_bit(host_mask, 32768),
        decommission_mask_bit(host_mask, 65536),
    )
    let decommission = admit_spark_pair_decommission_facts(
        decommission_mask_bit(decommission_mask, 1), decommission_mask_bit(decommission_mask, 2),
        decommission_mask_bit(decommission_mask, 4), decommission_mask_bit(decommission_mask, 8),
        decommission_mask_bit(decommission_mask, 16), decommission_mask_bit(decommission_mask, 32),
        decommission_mask_bit(decommission_mask, 64), decommission_mask_bit(decommission_mask, 128),
        decommission_mask_bit(decommission_mask, 256), decommission_mask_bit(decommission_mask, 512),
        decommission_mask_bit(decommission_mask, 1024), decommission_mask_bit(decommission_mask, 2048),
        decommission_mask_bit(decommission_mask, 4096), decommission_mask_bit(decommission_mask, 8192),
        decommission_mask_bit(decommission_mask, 16384), decommission_mask_bit(decommission_mask, 32768),
        decommission_mask_bit(decommission_mask, 65536),
    )
    let decision = decide_spark_pair_decommission_plan(
        action, state, epoch, observed_epoch, custody,
        authority, slurm, k8s, host, decommission,
    )
    let allowed = spark_pair_decision_allowed(decision)
    let from_state = spark_pair_decision_current_state(decision)
    let next_state = spark_pair_decision_next_state(decision)
    let reason = spark_pair_decision_reason(decision)
    if allowed {
        println("SOUNIO_SPARK_PAIR_DECOMMISSION_PLAN_ALLOW schema=sounio-spark-pair-decommission-plan-v1 action=" +
            decommission_action_name(action) + " from=" + decommission_state_name(from_state) +
            " to=" + decommission_state_name(next_state) + " custody=" +
            decommission_custody_name(custody) + " effect=NONE reason=ALLOW code=0")
        return 0
    }
    println("SOUNIO_SPARK_PAIR_DECOMMISSION_PLAN_REFUSE schema=sounio-spark-pair-decommission-plan-v1 action=" +
        decommission_action_name(action) + " state=" + decommission_state_name(from_state) +
        " custody=" + decommission_custody_name(custody) + " effect=NONE reason=" +
        decommission_reason_name(reason))
    42
}
