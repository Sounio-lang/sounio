//! Native Sounio adapter for the effect-free Spark pair restore capsule frame 9027.

fn restore_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen = false
    while offset < 4096 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn restore_decimal_arg(index: i64) -> (i64, i64) with Mut, Div, Panic, IO {
    let raw = get_arg(index)
    let (ok, value, end_offset) = restore_decimal_field(raw, 0)
    if ok == 1 && str_char_at(raw, end_offset) <= 0 { return (1, value) }
    (0, 0)
}

fn restore_hex_nibble(code: i64) -> i64 {
    if code >= 48 && code <= 57 { return code - 48 }
    if code >= 97 && code <= 102 { return code - 87 }
    -1
}

fn restore_digest_arg(
    index: i64,
) -> (i64, SparkPairRestoreDigest256) with IO, Mut, Div, Panic {
    let raw = get_arg(index)
    var limb0: i64 = 0
    var limb1: i64 = 0
    var limb2: i64 = 0
    var limb3: i64 = 0
    var limb4: i64 = 0
    var limb5: i64 = 0
    var limb6: i64 = 0
    var limb7: i64 = 0
    var offset: i64 = 0
    while offset < 64 {
        let nibble = restore_hex_nibble(str_char_at(raw, offset))
        if nibble < 0 {
            return (0, admit_spark_pair_restore_digest256(0, 0, 0, 0, 0, 0, 0, 0))
        }
        let group = offset / 8
        if group == 0 { limb0 = limb0 * 16 + nibble }
        if group == 1 { limb1 = limb1 * 16 + nibble }
        if group == 2 { limb2 = limb2 * 16 + nibble }
        if group == 3 { limb3 = limb3 * 16 + nibble }
        if group == 4 { limb4 = limb4 * 16 + nibble }
        if group == 5 { limb5 = limb5 * 16 + nibble }
        if group == 6 { limb6 = limb6 * 16 + nibble }
        if group == 7 { limb7 = limb7 * 16 + nibble }
        offset = offset + 1
    }
    if str_char_at(raw, 64) > 0 {
        return (0, admit_spark_pair_restore_digest256(0, 0, 0, 0, 0, 0, 0, 0))
    }
    (1, admit_spark_pair_restore_digest256(
        limb0, limb1, limb2, limb3, limb4, limb5, limb6, limb7,
    ))
}

fn restore_mask_bit(mask: i64, power: i64) -> i64 with Div {
    (mask / power) % 2
}

fn restore_state_name(state: i64) -> string {
    if state == 20 { return "RESTORE_CAPSULE_EMPTY" }
    if state == 21 { return "TWO_NODE_SNAPSHOT_BOUND" }
    if state == 22 { return "OFFLINE_REPLAY_BOUND" }
    if state == 23 { return "RESTORE_CAPSULE_ADMITTED" }
    "UNKNOWN"
}

fn restore_action_name(action: i64) -> string {
    if action == 50 { return "STATUS_RESTORE_CAPSULE" }
    if action == 51 { return "BIND_TWO_NODE_SNAPSHOT" }
    if action == 52 { return "BIND_OFFLINE_REPLAY" }
    if action == 53 { return "ADMIT_RESTORE_CAPSULE" }
    "UNKNOWN"
}

fn restore_reason_name(reason: i64) -> string {
    if reason == 0 { return "ALLOW" }
    if reason == 301 { return "POLICY_MISSING" }
    if reason == 302 { return "POLICY_ERROR" }
    if reason == 303 { return "TIMEOUT" }
    if reason == 304 { return "MALFORMED_CAPSULE_FRAME" }
    if reason == 305 { return "CAPSULE_STATE" }
    if reason == 306 { return "UNSUPPORTED_CAPSULE_ACTION" }
    if reason == 307 { return "PARENT_9026_FREEZE" }
    if reason == 308 { return "PAIR_IDENTITY" }
    if reason == 309 { return "HASH_FORMAT_OR_DOMAIN" }
    if reason == 310 { return "CANONICAL_SERIALIZATION" }
    if reason == 311 { return "PAIR_MANIFEST_DIGEST" }
    if reason == 312 { return "NODE_DIGEST" }
    if reason == 313 { return "PAIR_MANIFEST_BINDING" }
    if reason == 314 { return "NODE_PAIR" }
    if reason == 315 { return "PREINSTALL_PROVENANCE" }
    if reason == 316 { return "SNAPSHOT_SERVICE_STATE" }
    if reason == 317 { return "SNAPSHOT_CONTAINER_STATE" }
    if reason == 318 { return "SNAPSHOT_SCHEDULER_STATE" }
    if reason == 319 { return "SNAPSHOT_NODE_METADATA" }
    if reason == 320 { return "SNAPSHOT_PROTECTED_PATHS" }
    if reason == 321 { return "SNAPSHOT_PROVENANCE" }
    if reason == 322 { return "SNAPSHOT_CAPTURE_EFFECT" }
    if reason == 323 { return "SNAPSHOT_UNRESOLVED" }
    if reason == 324 { return "PRIOR_RECEIPT" }
    if reason == 325 { return "REPLAY_WITNESS_DIGEST" }
    if reason == 326 { return "REPLAY_CAPSULE_BINDING" }
    if reason == 327 { return "REPLAY_NOT_OFFLINE" }
    if reason == 328 { return "REPLAY_EXTERNAL_AUTHORITY" }
    if reason == 329 { return "REPLAY_HAS_MATERIAL_EFFECT" }
    if reason == 330 { return "REPLAY_NODE_PAIR" }
    if reason == 331 { return "REPLAY_SEMANTIC_MISMATCH" }
    if reason == 332 { return "REPLAY_OUTPUT_DIGEST" }
    if reason == 333 { return "REPLAY_NOT_REPEATABLE" }
    if reason == 334 { return "REPLAY_PROVENANCE" }
    if reason == 335 { return "CAPSULE_NOT_SEALED" }
    "UNKNOWN_REASON"
}

fn restore_reason_code_name(reason: i64) -> string {
    if reason == 0 { return "0" }
    if reason == 301 { return "301" }
    if reason == 302 { return "302" }
    if reason == 303 { return "303" }
    if reason == 304 { return "304" }
    if reason == 305 { return "305" }
    if reason == 306 { return "306" }
    if reason == 307 { return "307" }
    if reason == 308 { return "308" }
    if reason == 309 { return "309" }
    if reason == 310 { return "310" }
    if reason == 311 { return "311" }
    if reason == 312 { return "312" }
    if reason == 313 { return "313" }
    if reason == 314 { return "314" }
    if reason == 315 { return "315" }
    if reason == 316 { return "316" }
    if reason == 317 { return "317" }
    if reason == 318 { return "318" }
    if reason == 319 { return "319" }
    if reason == 320 { return "320" }
    if reason == 321 { return "321" }
    if reason == 322 { return "322" }
    if reason == 323 { return "323" }
    if reason == 324 { return "324" }
    if reason == 325 { return "325" }
    if reason == 326 { return "326" }
    if reason == 327 { return "327" }
    if reason == 328 { return "328" }
    if reason == 329 { return "329" }
    if reason == 330 { return "330" }
    if reason == 331 { return "331" }
    if reason == 332 { return "332" }
    if reason == 333 { return "333" }
    if reason == 334 { return "334" }
    if reason == 335 { return "335" }
    "-1"
}

fn main() -> i64 with IO, Mut, Div, Panic {
    if arg_count() != 12 {
        println("SOUNIO_SPARK_PAIR_RESTORE_CAPSULE_PLAN_REFUSE " +
            "schema=sounio-spark-pair-restore-capsule-plan-v1 effect=NONE " +
            "material_dispatch=false reason=MALFORMED_CAPSULE_FRAME code=304")
        return 64
    }

    let (o0, schema) = restore_decimal_arg(0)
    let (o1, action) = restore_decimal_arg(1)
    let (o2, state) = restore_decimal_arg(2)
    let (o3, snapshot_digest) = restore_digest_arg(3)
    let (o4, node0_digest) = restore_digest_arg(4)
    let (o5, node1_digest) = restore_digest_arg(5)
    let (o6, replay_digest) = restore_digest_arg(6)
    let (o7, parent_9026_digest) = restore_digest_arg(7)
    let (o8, prior_receipt_digest) = restore_digest_arg(8)
    let (o9, authority_mask) = restore_decimal_arg(9)
    let (o10, snapshot_mask) = restore_decimal_arg(10)
    let (o11, replay_mask) = restore_decimal_arg(11)
    let parsed = o0 == 1 && o1 == 1 && o2 == 1 && o3 == 1 && o4 == 1 &&
        o5 == 1 && o6 == 1 && o7 == 1 && o8 == 1 && o9 == 1 &&
        o10 == 1 && o11 == 1
    if !parsed || schema != 9027 || authority_mask > 511 ||
        snapshot_mask > 1048575 || replay_mask > 262143 {
        println("SOUNIO_SPARK_PAIR_RESTORE_CAPSULE_PLAN_REFUSE " +
            "schema=sounio-spark-pair-restore-capsule-plan-v1 effect=NONE " +
            "material_dispatch=false reason=MALFORMED_CAPSULE_FRAME code=304")
        return 64
    }

    let authority = admit_spark_pair_restore_authority_facts(
        restore_mask_bit(authority_mask, 1), restore_mask_bit(authority_mask, 2),
        restore_mask_bit(authority_mask, 4), restore_mask_bit(authority_mask, 8),
        restore_mask_bit(authority_mask, 16), restore_mask_bit(authority_mask, 32),
        restore_mask_bit(authority_mask, 64), restore_mask_bit(authority_mask, 128),
        restore_mask_bit(authority_mask, 256),
    )
    let snapshot = admit_spark_pair_restore_snapshot_facts(
        restore_mask_bit(snapshot_mask, 1), restore_mask_bit(snapshot_mask, 2),
        restore_mask_bit(snapshot_mask, 4), restore_mask_bit(snapshot_mask, 8),
        restore_mask_bit(snapshot_mask, 16), restore_mask_bit(snapshot_mask, 32),
        restore_mask_bit(snapshot_mask, 64), restore_mask_bit(snapshot_mask, 128),
        restore_mask_bit(snapshot_mask, 256), restore_mask_bit(snapshot_mask, 512),
        restore_mask_bit(snapshot_mask, 1024), restore_mask_bit(snapshot_mask, 2048),
        restore_mask_bit(snapshot_mask, 4096), restore_mask_bit(snapshot_mask, 8192),
        restore_mask_bit(snapshot_mask, 16384), restore_mask_bit(snapshot_mask, 32768),
        restore_mask_bit(snapshot_mask, 65536), restore_mask_bit(snapshot_mask, 131072),
        restore_mask_bit(snapshot_mask, 262144), restore_mask_bit(snapshot_mask, 524288),
    )
    let replay = admit_spark_pair_restore_replay_facts(
        restore_mask_bit(replay_mask, 1), restore_mask_bit(replay_mask, 2),
        restore_mask_bit(replay_mask, 4), restore_mask_bit(replay_mask, 8),
        restore_mask_bit(replay_mask, 16), restore_mask_bit(replay_mask, 32),
        restore_mask_bit(replay_mask, 64), restore_mask_bit(replay_mask, 128),
        restore_mask_bit(replay_mask, 256), restore_mask_bit(replay_mask, 512),
        restore_mask_bit(replay_mask, 1024), restore_mask_bit(replay_mask, 2048),
        restore_mask_bit(replay_mask, 4096), restore_mask_bit(replay_mask, 8192),
        restore_mask_bit(replay_mask, 16384), restore_mask_bit(replay_mask, 32768),
        restore_mask_bit(replay_mask, 65536), restore_mask_bit(replay_mask, 131072),
    )
    let decision = decide_spark_pair_restore_capsule_plan(
        action, state, snapshot_digest, node0_digest, node1_digest, replay_digest,
        parent_9026_digest, prior_receipt_digest, authority, snapshot, replay,
    )
    let allowed = spark_pair_restore_decision_allowed(decision)
    let from_state = spark_pair_restore_decision_current_state(decision)
    let next_state = spark_pair_restore_decision_next_state(decision)
    let reason = spark_pair_restore_decision_reason(decision)
    if allowed {
        println("SOUNIO_SPARK_PAIR_RESTORE_CAPSULE_PLAN_ALLOW " +
            "schema=sounio-spark-pair-restore-capsule-plan-v1 action=" +
            restore_action_name(action) + " from=" + restore_state_name(from_state) +
            " to=" + restore_state_name(next_state) + " snapshot_sha256=" + get_arg(3) +
            " node0_sha256=" + get_arg(4) + " node1_sha256=" + get_arg(5) +
            " replay_sha256=" + get_arg(6) + " parent_9026_sha256=" + get_arg(7) +
            " prior_receipt_sha256=" + get_arg(8) +
            " effect=NONE material_dispatch=false reason=ALLOW code=0")
        return 0
    }
    println("SOUNIO_SPARK_PAIR_RESTORE_CAPSULE_PLAN_REFUSE " +
        "schema=sounio-spark-pair-restore-capsule-plan-v1 action=" +
        restore_action_name(action) + " state=" + restore_state_name(from_state) +
        " effect=NONE material_dispatch=false reason=" + restore_reason_name(reason) +
        " code=" + restore_reason_code_name(reason))
    42
}
