fn main() -> i64 with IO, Mut, Div, Panic {
    if arg_count() == 1 {
        if get_arg(0) == "--fixture-node0" {
            return capture_profile_print_fixture_node("spark-3c59")
        }
        if get_arg(0) == "--fixture-node1" {
            return capture_profile_print_fixture_node("spark-8e54")
        }
        if get_arg(0) == "--fixture-pair" {
            return capture_profile_print_fixture_pair()
        }
        if get_arg(0) == "--fixture-node0-restorable" {
            return capture_profile_print_fixture_restorable("spark-3c59")
        }
        if get_arg(0) == "--fixture-node1-restorable" {
            return capture_profile_print_fixture_restorable("spark-8e54")
        }
        if get_arg(0) == "--fixture-node0-observation" {
            return capture_profile_print_fixture_observation("spark-3c59")
        }
        if get_arg(0) == "--fixture-node1-observation" {
            return capture_profile_print_fixture_observation("spark-8e54")
        }
        if get_arg(0) == "--fixture-domain-contract" {
            return capture_profile_print_domain_contract()
        }
    }
    if arg_count() != 9 {
        println("SOUNIO_SPARK_PAIR_READ_ONLY_CAPTURE_PROFILE_REFUSE " +
            "schema=sounio-spark-pair-read-only-capture-profile-v1 " +
            "profile_reason=MALFORMED_PROFILE profile_code=401 " +
            "restorable=false state_transition=false")
        return 64
    }

    let (ok_snapshot, snapshot) = capture_profile_digest_arg(0)
    let (ok_node0, node0) = capture_profile_digest_arg(1)
    let (ok_node1, node1) = capture_profile_digest_arg(2)
    let (ok_history, history) = capture_profile_digest_arg(3)
    let (ok_status, historical_status) = capture_profile_decimal_arg(4)
    let (ok_observation, observation_mask) = capture_profile_decimal_arg(5)
    let (ok_integrity, integrity_mask) = capture_profile_decimal_arg(6)
    let (ok_policy, policy_error) = capture_profile_decimal_arg(7)
    let (ok_timeout, timed_out) = capture_profile_decimal_arg(8)
    if ok_snapshot == 0 || ok_node0 == 0 || ok_node1 == 0 || ok_history == 0 ||
        ok_status == 0 || ok_observation == 0 || ok_integrity == 0 ||
        ok_policy == 0 || ok_timeout == 0 {
        println("SOUNIO_SPARK_PAIR_READ_ONLY_CAPTURE_PROFILE_REFUSE " +
            "schema=sounio-spark-pair-read-only-capture-profile-v1 " +
            "profile_reason=MALFORMED_PROFILE profile_code=401 " +
            "restorable=false state_transition=false")
        return 64
    }

    let decision = decide_spark_pair_read_only_capture_profile(
        snapshot, node0, node1, history, historical_status,
        observation_mask, integrity_mask, policy_error, timed_out,
    )
    let restore_reason = spark_pair_read_only_capture_restore_reason(decision)
    let profile_reason = spark_pair_read_only_capture_profile_reason(decision)
    if spark_pair_read_only_capture_receipt_accepted(decision) {
        println("SOUNIO_SPARK_PAIR_READ_ONLY_CAPTURE_PROFILE_PASS " +
            "schema=sounio-spark-pair-read-only-capture-profile-v1 capsule_frame=9027 " +
            "action=51 state=20 next_state=20 authority_mask=473 snapshot_mask=491455 " +
            "replay_mask=0 role=OBSERVATION_ONLY " +
            "capture_temporality=CURRENT_POSTINSTALL_OBSERVATION " +
            "historical_preinstall_receipt=NOT_PRESENT preinstall_provenance_exact=false " +
            "restorable=false snapshot_binding_receipt=NOT_ISSUED state_transition=false " +
            "producer_effect=READ_ONLY_OBSERVATION scheduler_mutation=NONE " +
            "host_configuration_mutation=NONE frame_9027_invoked=true " +
            "restore_allowed=false reason=" +
            capture_profile_restore_reason_name(restore_reason) + " code=" +
            capture_profile_restore_reason_code_name(restore_reason) +
            " effect=NONE material_dispatch=false")
        return 0
    }
    if profile_reason == 404 {
        println("SOUNIO_SPARK_PAIR_READ_ONLY_CAPTURE_PROFILE_FATAL " +
            "schema=sounio-spark-pair-read-only-capture-profile-v1 profile_reason=" +
            capture_profile_reason_name(profile_reason) + " profile_code=" +
            capture_profile_reason_code_name(profile_reason) +
            " restore_allowed=INVARIANT_VIOLATION restore_code=" +
            capture_profile_restore_reason_code_name(restore_reason) +
            " restorable=false state_transition=false")
        return 70
    }
    if spark_pair_read_only_capture_incomplete(decision) {
        println("SOUNIO_SPARK_PAIR_READ_ONLY_CAPTURE_PROFILE_INCOMPLETE " +
            "schema=sounio-spark-pair-read-only-capture-profile-v1 profile_reason=" +
            capture_profile_reason_name(profile_reason) + " profile_code=" +
            capture_profile_reason_code_name(profile_reason) +
            " restore_reason=" + capture_profile_restore_reason_name(restore_reason) +
            " restore_code=" + capture_profile_restore_reason_code_name(restore_reason) +
            " frame_9027_invoked=" + capture_profile_bool_name(
                spark_pair_read_only_capture_frame_9027_invoked(decision)) +
            " restorable=false snapshot_binding_receipt=NOT_ISSUED state_transition=false")
        return 42
    }
    println("SOUNIO_SPARK_PAIR_READ_ONLY_CAPTURE_PROFILE_REFUSE " +
        "schema=sounio-spark-pair-read-only-capture-profile-v1 profile_reason=" +
        capture_profile_reason_name(profile_reason) + " profile_code=" +
        capture_profile_reason_code_name(profile_reason) +
        " restorable=false snapshot_binding_receipt=NOT_ISSUED state_transition=false")
    42
}
