//! Native Sounio adapter for the strict Read-Only Capture profile of frame 9027.

fn capture_profile_decimal_field(
    raw: string,
    offset: i64,
    value: i64,
    seen: i64,
) -> (i64, i64, i64) with Mut, Panic {
    let code = str_char_at(raw, offset)
    if code <= 0 { return (seen, value, offset) }
    if code < 48 || code > 57 { return (0, 0, offset) }
    if value > 922337203685477580 ||
        (value == 922337203685477580 && code - 48 > 7) {
        return (0, 0, offset)
    }
    capture_profile_decimal_field(raw, offset + 1, value * 10 + (code - 48), 1)
}

fn capture_profile_decimal_arg(index: i64) -> (i64, i64) with Mut, Panic {
    let raw = get_arg(index)
    let (ok, value, end_offset) = capture_profile_decimal_field(raw, 0, 0, 0)
    if ok == 1 && str_char_at(raw, end_offset) <= 0 { return (1, value) }
    (0, 0)
}

fn capture_profile_hex_nibble(code: i64) -> i64 {
    if code >= 48 && code <= 57 { return code - 48 }
    if code >= 97 && code <= 102 { return code - 87 }
    -1
}

fn capture_profile_digest_arg(
    index: i64,
) -> (i64, SparkPairRestoreDigest256) with Mut, Panic {
    let raw = get_arg(index)
    var offset = 0
    var limbs: [i64; 8] = [0; 8]
    while offset < 64 {
        let nibble = capture_profile_hex_nibble(str_char_at(raw, offset))
        if nibble < 0 {
            return (0, admit_spark_pair_restore_digest256(0, 0, 0, 0, 0, 0, 0, 0))
        }
        let limb = offset / 8
        limbs[limb] = limbs[limb] * 16 + nibble
        offset = offset + 1
    }
    if str_char_at(raw, 64) > 0 {
        return (0, admit_spark_pair_restore_digest256(0, 0, 0, 0, 0, 0, 0, 0))
    }
    (1, admit_spark_pair_restore_digest256(
        limbs[0], limbs[1], limbs[2], limbs[3],
        limbs[4], limbs[5], limbs[6], limbs[7],
    ))
}

fn capture_profile_restore_reason_name(reason: i64) -> string {
    if reason == 0 { return "ALLOW" }
    if reason == 302 { return "POLICY_ERROR" }
    if reason == 303 { return "TIMEOUT" }
    if reason == 309 { return "HASH_FORMAT_OR_DOMAIN" }
    if reason == 311 { return "PAIR_MANIFEST_DIGEST" }
    if reason == 312 { return "NODE_DIGEST" }
    if reason == 313 { return "PAIR_MANIFEST_BINDING" }
    if reason == 314 { return "NODE_PAIR" }
    if reason == 315 { return "PREINSTALL_PROVENANCE" }
    if reason == 316 { return "SNAPSHOT_SERVICE_STATE" }
    if reason == 317 { return "SNAPSHOT_CONTAINER_STATE" }
    if reason == 318 { return "SNAPSHOT_SCHEDULER_STATE" }
    if reason == 319 { return "SNAPSHOT_NODE_METADATA" }
    if reason == 320 { return "SNAPSHOT_PROTECTED_PATHS" }
    if reason == 321 { return "SNAPSHOT_PROVENANCE" }
    if reason == 322 { return "SNAPSHOT_CAPTURE_EFFECT" }
    if reason == 323 { return "SNAPSHOT_UNRESOLVED" }
    "RESTORE_REFUSAL"
}

fn capture_profile_reason_name(reason: i64) -> string {
    if reason == 0 { return "OBSERVATION_ONLY_ACCEPTED" }
    if reason == 401 { return "MALFORMED_PROFILE" }
    if reason == 402 { return "HISTORICAL_RECEIPT_CONTRADICTION" }
    if reason == 403 { return "HISTORICAL_VALIDATION_NOT_IMPLEMENTED" }
    if reason == 404 { return "FRAME_9027_INVARIANT_VIOLATION" }
    if reason == 405 { return "CAPTURE_INCOMPLETE" }
    "PROFILE_REFUSAL"
}

fn capture_profile_restore_reason_code_name(reason: i64) -> string {
    if reason == 0 { return "0" }
    if reason == 302 { return "302" }
    if reason == 303 { return "303" }
    if reason == 309 { return "309" }
    if reason == 311 { return "311" }
    if reason == 312 { return "312" }
    if reason == 313 { return "313" }
    if reason == 314 { return "314" }
    if reason == 315 { return "315" }
    if reason == 316 { return "316" }
    if reason == 317 { return "317" }
    if reason == 318 { return "318" }
    if reason == 319 { return "319" }
    if reason == 320 { return "320" }
    if reason == 321 { return "321" }
    if reason == 322 { return "322" }
    if reason == 323 { return "323" }
    "UNKNOWN"
}

fn capture_profile_reason_code_name(reason: i64) -> string {
    if reason == 0 { return "0" }
    if reason == 401 { return "401" }
    if reason == 402 { return "402" }
    if reason == 403 { return "403" }
    if reason == 404 { return "404" }
    if reason == 405 { return "405" }
    "UNKNOWN"
}

fn capture_profile_bool_name(value: bool) -> string {
    if value { return "true" }
    "false"
}

