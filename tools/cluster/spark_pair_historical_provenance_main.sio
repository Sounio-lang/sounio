fn main() -> i64 with IO, Mut, Div, Panic {
    if arg_count() != 15 {
        println("SOUNIO_SPARK_PAIR_HISTORICAL_PROVENANCE_PLAN_REFUSE " +
            "schema=sounio-spark-pair-historical-provenance-plan-v1 effect=NONE " +
            "material_dispatch=false reason=MALFORMED_HISTORICAL_FRAME code=336")
        return 64
    }

    let (o0, schema) = historical_decimal_arg(0)
    let (o1, action) = historical_decimal_arg(1)
    let (o2, state) = historical_decimal_arg(2)
    let (o3, source_class) = historical_decimal_arg(3)
    let (o4, source_digest) = historical_digest_arg(4)
    let (o5, node0_digest) = historical_digest_arg(5)
    let (o6, node1_digest) = historical_digest_arg(6)
    let (o7, pair_digest) = historical_digest_arg(7)
    let (o8, install_anchor_digest) = historical_digest_arg(8)
    let (o9, parent_9027_digest) = historical_digest_arg(9)
    let (o10, prior_receipt_digest) = historical_digest_arg(10)
    let (o11, authority_mask) = historical_decimal_arg(11)
    let (o12, ordering_mask) = historical_decimal_arg(12)
    let (o13, custody_mask) = historical_decimal_arg(13)
    let (o14, completeness_mask) = historical_decimal_arg(14)
    let parsed = o0 == 1 && o1 == 1 && o2 == 1 && o3 == 1 && o4 == 1 &&
        o5 == 1 && o6 == 1 && o7 == 1 && o8 == 1 && o9 == 1 && o10 == 1 &&
        o11 == 1 && o12 == 1 && o13 == 1 && o14 == 1
    if !parsed || schema != 9028 || authority_mask > 4095 || ordering_mask > 255 ||
        custody_mask > 255 || completeness_mask > 524287 {
        println("SOUNIO_SPARK_PAIR_HISTORICAL_PROVENANCE_PLAN_REFUSE " +
            "schema=sounio-spark-pair-historical-provenance-plan-v1 effect=NONE " +
            "material_dispatch=false reason=MALFORMED_HISTORICAL_FRAME code=336")
        return 64
    }

    let authority = admit_spark_pair_historical_authority_facts(
        historical_mask_bit(authority_mask, 1), historical_mask_bit(authority_mask, 2),
        historical_mask_bit(authority_mask, 4), historical_mask_bit(authority_mask, 8),
        historical_mask_bit(authority_mask, 16), historical_mask_bit(authority_mask, 32),
        historical_mask_bit(authority_mask, 64), historical_mask_bit(authority_mask, 128),
        historical_mask_bit(authority_mask, 256),
        historical_mask_bit(authority_mask, 512), historical_mask_bit(authority_mask, 1024),
        historical_mask_bit(authority_mask, 2048),
    )
    let ordering = admit_spark_pair_historical_ordering_facts(
        historical_mask_bit(ordering_mask, 1), historical_mask_bit(ordering_mask, 2),
        historical_mask_bit(ordering_mask, 4), historical_mask_bit(ordering_mask, 8),
        historical_mask_bit(ordering_mask, 16), historical_mask_bit(ordering_mask, 32),
        historical_mask_bit(ordering_mask, 64), historical_mask_bit(ordering_mask, 128),
    )
    let custody = admit_spark_pair_historical_custody_facts(
        historical_mask_bit(custody_mask, 1), historical_mask_bit(custody_mask, 2),
        historical_mask_bit(custody_mask, 4), historical_mask_bit(custody_mask, 8),
        historical_mask_bit(custody_mask, 16), historical_mask_bit(custody_mask, 32),
        historical_mask_bit(custody_mask, 64), historical_mask_bit(custody_mask, 128),
    )
    let completeness = admit_spark_pair_historical_completeness_facts(
        historical_mask_bit(completeness_mask, 1),
        historical_mask_bit(completeness_mask, 2),
        historical_mask_bit(completeness_mask, 4),
        historical_mask_bit(completeness_mask, 8),
        historical_mask_bit(completeness_mask, 16),
        historical_mask_bit(completeness_mask, 32),
        historical_mask_bit(completeness_mask, 64),
        historical_mask_bit(completeness_mask, 128),
        historical_mask_bit(completeness_mask, 256),
        historical_mask_bit(completeness_mask, 512),
        historical_mask_bit(completeness_mask, 1024),
        historical_mask_bit(completeness_mask, 2048),
        historical_mask_bit(completeness_mask, 4096),
        historical_mask_bit(completeness_mask, 8192),
        historical_mask_bit(completeness_mask, 16384),
        historical_mask_bit(completeness_mask, 32768),
        historical_mask_bit(completeness_mask, 65536),
        historical_mask_bit(completeness_mask, 131072),
        historical_mask_bit(completeness_mask, 262144),
    )
    let decision = decide_spark_pair_historical_provenance_plan(
        action, state, source_class, source_digest, node0_digest, node1_digest,
        pair_digest, install_anchor_digest, parent_9027_digest, prior_receipt_digest,
        authority, ordering, custody, completeness,
    )
    let allowed = spark_pair_historical_decision_allowed(decision)
    let from_state = spark_pair_historical_decision_current_state(decision)
    let next_state = spark_pair_historical_decision_next_state(decision)
    let reason = spark_pair_historical_decision_reason(decision)
    if allowed {
        println("SOUNIO_SPARK_PAIR_HISTORICAL_PROVENANCE_PLAN_ALLOW " +
            "schema=sounio-spark-pair-historical-provenance-plan-v1 action=" +
            historical_action_name(action) + " from=" + historical_state_name(from_state) +
            " to=" + historical_state_name(next_state) + " source_class=" +
            historical_source_class_name(source_class) + " source_sha256=" + get_arg(4) +
            " node0_sha256=" + get_arg(5) + " node1_sha256=" + get_arg(6) +
            " pair_sha256=" + get_arg(7) + " install_anchor_sha256=" + get_arg(8) +
            " parent_9027_sha256=" + get_arg(9) + " prior_receipt_sha256=" + get_arg(10) +
            " effect=NONE material_dispatch=false reason=ALLOW code=0")
        return 0
    }
    println("SOUNIO_SPARK_PAIR_HISTORICAL_PROVENANCE_PLAN_REFUSE " +
        "schema=sounio-spark-pair-historical-provenance-plan-v1 action=" +
        historical_action_name(action) + " state=" + historical_state_name(from_state) +
        " source_class=" + historical_source_class_name(source_class) +
        " effect=NONE material_dispatch=false reason=" + historical_reason_name(reason) +
        " code=" + historical_reason_code_name(reason))
    42
}
