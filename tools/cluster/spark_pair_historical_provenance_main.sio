//! Native Sounio adapter for effect-free Spark pair historical provenance frame 9028.

fn historical_decimal_field(
    raw: string,
    start: i64,
) -> (i64, i64, i64) with Mut, Div, Panic {
    var offset = start
    var value: i64 = 0
    var seen = false
    while offset < 4096 {
        let code = str_char_at(raw, offset)
        if code <= 0 { return (if seen { 1 } else { 0 }, value, offset) }
        if code == 32 {
            if !seen { return (0, 0, offset) }
            return (1, value, offset + 1)
        }
        if code < 48 || code > 57 { return (0, 0, offset) }
        let digit = code - 48
        if value > 922337203685477580 ||
            (value == 922337203685477580 && digit > 7) {
            return (0, 0, offset)
        }
        value = value * 10 + digit
        seen = true
        offset = offset + 1
    }
    (0, 0, offset)
}

fn historical_decimal_arg(index: i64) -> (i64, i64) with Mut, Div, Panic, IO {
    let raw = get_arg(index)
    let (ok, value, end_offset) = historical_decimal_field(raw, 0)
    if ok == 1 && str_char_at(raw, end_offset) <= 0 { return (1, value) }
    (0, 0)
}

fn historical_hex_nibble(code: i64) -> i64 {
    if code >= 48 && code <= 57 { return code - 48 }
    if code >= 97 && code <= 102 { return code - 87 }
    -1
}

fn historical_digest_arg(
    index: i64,
) -> (i64, SparkPairHistoricalDigest256) with IO, Mut, Div, Panic {
    let raw = get_arg(index)
    var limb0: i64 = 0
    var limb1: i64 = 0
    var limb2: i64 = 0
    var limb3: i64 = 0
    var limb4: i64 = 0
    var limb5: i64 = 0
    var limb6: i64 = 0
    var limb7: i64 = 0
    var offset: i64 = 0
    while offset < 64 {
        let nibble = historical_hex_nibble(str_char_at(raw, offset))
        if nibble < 0 {
            return (0, admit_spark_pair_historical_digest256(0, 0, 0, 0, 0, 0, 0, 0))
        }
        let group = offset / 8
        if group == 0 { limb0 = limb0 * 16 + nibble }
        if group == 1 { limb1 = limb1 * 16 + nibble }
        if group == 2 { limb2 = limb2 * 16 + nibble }
        if group == 3 { limb3 = limb3 * 16 + nibble }
        if group == 4 { limb4 = limb4 * 16 + nibble }
        if group == 5 { limb5 = limb5 * 16 + nibble }
        if group == 6 { limb6 = limb6 * 16 + nibble }
        if group == 7 { limb7 = limb7 * 16 + nibble }
        offset = offset + 1
    }
    if str_char_at(raw, 64) > 0 {
        return (0, admit_spark_pair_historical_digest256(0, 0, 0, 0, 0, 0, 0, 0))
    }
    (1, admit_spark_pair_historical_digest256(
        limb0, limb1, limb2, limb3, limb4, limb5, limb6, limb7,
    ))
}

fn historical_mask_bit(mask: i64, power: i64) -> i64 with Div {
    (mask / power) % 2
}

fn historical_state_name(state: i64) -> string {
    if state == 30 { return "HISTORICAL_SOURCE_EMPTY" }
    if state == 31 { return "HISTORICAL_CANDIDATE_BOUND" }
    if state == 32 { return "HISTORICAL_PROVENANCE_ADMITTED" }
    "UNKNOWN"
}

fn historical_action_name(action: i64) -> string {
    if action == 54 { return "STATUS_HISTORICAL_SOURCE" }
    if action == 55 { return "BIND_HISTORICAL_CANDIDATE" }
    if action == 56 { return "ADMIT_HISTORICAL_PROVENANCE" }
    "UNKNOWN"
}

fn historical_source_class_name(source_class: i64) -> string {
    if source_class == 0 { return "NONE" }
    if source_class == 1 { return "FROZEN_SOUNIO_PREINSTALL_RECEIPT" }
    if source_class == 2 { return "IMMUTABLE_TWO_NODE_MACHINE_SNAPSHOT" }
    if source_class == 3 { return "CANONICAL_PREINSTALL_EXPORT_BUNDLE" }
    if source_class == 4 { return "COMPOSITE_PREINSTALL_CLOSURE" }
    if source_class == 5 { return "PARTIAL_PREINSTALL_BACKUP" }
    if source_class == 6 { return "CURRENT_OR_POSTINSTALL_CAPTURE" }
    if source_class == 7 { return "MUTABLE_OR_CLOCK_ONLY_EXPORT" }
    if source_class == 8 { return "REVIEW_ONLY_SOURCE" }
    "UNKNOWN"
}

fn historical_reason_name(reason: i64) -> string {
    if reason == 0 { return "ALLOW" }
    if reason == 336 { return "MALFORMED_HISTORICAL_FRAME" }
    if reason == 337 { return "HISTORICAL_STATE" }
    if reason == 338 { return "UNSUPPORTED_HISTORICAL_ACTION" }
    if reason == 339 { return "POLICY_MISSING" }
    if reason == 340 { return "POLICY_ERROR" }
    if reason == 341 { return "TIMEOUT" }
    if reason == 342 { return "PARENT_9027_FREEZE" }
    if reason == 343 { return "HISTORICAL_SOURCE_NOT_PRESENT" }
    if reason == 344 { return "HISTORICAL_SOURCE_CLASS" }
    if reason == 345 { return "SOURCE_DIGEST_OR_DOMAIN" }
    if reason == 346 { return "NODE_SOURCE_DIGEST" }
    if reason == 347 { return "PAIR_SOURCE_BINDING" }
    if reason == 348 { return "PAIR_IDENTITY" }
    if reason == 349 { return "FIRST_INSTALL_ANCHOR" }
    if reason == 350 { return "PREINSTALL_ORDER_NOT_PROVEN" }
    if reason == 351 { return "CLOCK_ONLY_ORDERING" }
    if reason == 352 { return "MUTABLE_HISTORICAL_SOURCE" }
    if reason == 353 { return "RETROSPECTIVE_RECONSTRUCTION" }
    if reason == 354 { return "POSTINSTALL_SOURCE" }
    if reason == 355 { return "SOURCE_CUSTODY_INCOMPLETE" }
    if reason == 356 { return "SOURCE_CUSTODY_CONFLICT" }
    if reason == 357 { return "PARTIAL_PREINSTALL_BACKUP" }
    if reason == 358 { return "HISTORICAL_NODE_PAIR" }
    if reason == 359 { return "HISTORICAL_SERVICE_STATE" }
    if reason == 360 { return "HISTORICAL_CONTAINER_STATE" }
    if reason == 361 { return "HISTORICAL_SCHEDULER_STATE" }
    if reason == 362 { return "HISTORICAL_NODE_METADATA" }
    if reason == 363 { return "HISTORICAL_PROTECTED_PATHS" }
    if reason == 364 { return "PRODUCER_AUTHORITY_ROLE" }
    if reason == 365 { return "HISTORICAL_ARTIFACT_AVAILABILITY" }
    if reason == 366 { return "EPHEMERAL_RESTORE_TARGET" }
    if reason == 367 { return "HISTORICAL_UNKNOWN_FIELDS" }
    if reason == 368 { return "HISTORICAL_SOURCE_CONFLICT" }
    if reason == 369 { return "HISTORICAL_COVERAGE_CLOSURE" }
    if reason == 370 { return "PRIOR_HISTORICAL_RECEIPT" }
    if reason == 371 { return "CANONICAL_SERIALIZATION" }
    if reason == 372 { return "TOOLCHAIN_HARDWARE_COMMANDS" }
    "UNKNOWN_REASON"
}

