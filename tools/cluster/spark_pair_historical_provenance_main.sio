    if reason == 0 { return "0" }
    if reason == 336 { return "336" }
    if reason == 337 { return "337" }
    if reason == 338 { return "338" }
    if reason == 339 { return "339" }
    if reason == 340 { return "340" }
    if reason == 341 { return "341" }
    if reason == 342 { return "342" }
    if reason == 343 { return "343" }
    if reason == 344 { return "344" }
    if reason == 345 { return "345" }
    if reason == 346 { return "346" }
    if reason == 347 { return "347" }
    if reason == 348 { return "348" }
    if reason == 349 { return "349" }
    if reason == 350 { return "350" }
    if reason == 351 { return "351" }
    if reason == 352 { return "352" }
    if reason == 353 { return "353" }
