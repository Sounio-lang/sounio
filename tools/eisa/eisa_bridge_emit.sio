module tools::eisa::eisa_bridge_emit

use eisa::backend::*
use eisa::format::*
use eisa::bridge_x86::*
use str::lib::*

fn nl() -> Str with Mut, Div, Panic {
    var b: [i8; 256] = [0; 256]
    b[0] = 10 as i8
    str_from_bytes_buf(&b, 1)
}

fn add_line(dst: &Str, txt: string, n: &Str) -> Str with Mut, Div, Panic {
    let line = str_from_literal(txt)
    let t = str_cat(dst, &line)
    str_cat(&t, n)
}

fn golden_mul_src() -> Str with Mut, Div, Panic {
    let n = nl()
    var s = str_new()
    s = add_line(&s, "epistemic fn golden_mul() {", &n)
    s = add_line(&s, "let a = 0.5", &n)
    s = add_line(&s, "let b = 7.25", &n)
    s = add_line(&s, "let c = a * b", &n)
    s = add_line(&s, "gate c", &n)
    s = add_line(&s, "store [dose] <- c", &n)
    s = add_line(&s, "}", &n)
    s
}

fn golden_add_src() -> Str with Mut, Div, Panic {
    let n = nl()
    var s = str_new()
    s = add_line(&s, "epistemic fn golden_add() {", &n)
    s = add_line(&s, "let a = 0.5", &n)
    s = add_line(&s, "let b = 7.25", &n)
    s = add_line(&s, "let c = a + b", &n)
    s = add_line(&s, "gate c", &n)
    s = add_line(&s, "store [dose] <- c", &n)
    s = add_line(&s, "}", &n)
    s
}

fn golden_sqrt_src() -> Str with Mut, Div, Panic {
    let n = nl()
    var s = str_new()
    s = add_line(&s, "epistemic fn golden_sqrt() {", &n)
    s = add_line(&s, "let a = 2.0", &n)
    s = add_line(&s, "let b = sqrt(a)", &n)
    s = add_line(&s, "gate b", &n)
    s = add_line(&s, "}", &n)
    s
}

fn golden_poison_src() -> Str with Mut, Div, Panic {
    let n = nl()
    var s = str_new()
    s = add_line(&s, "epistemic fn golden_poison() {", &n)
    s = add_line(&s, "let a = 1.0", &n)
    s = add_line(&s, "let b = 0.0", &n)
    s = add_line(&s, "let c = a / b", &n)
    s = add_line(&s, "let d = c + a", &n)
    s = add_line(&s, "gate d", &n)
    s = add_line(&s, "}", &n)
    s
}

// E5 showcase kernel: reduced-quartic catastrophic cancellation, same source
// as examples/eisa_cancellation_kernel.sio and tools/eisa/eisa_evm_run.sio.
fn e5_cancellation_src() -> Str with Mut, Div, Panic {
    let n = nl()
    var s = str_new()
    s = add_line(&s, "epistemic fn k() {", &n)
    s = add_line(&s, "let a = 1.000001", &n)
    s = add_line(&s, "let b = a * a", &n)
    s = add_line(&s, "let c = b * a", &n)
    s = add_line(&s, "let d = b * b", &n)
    s = add_line(&s, "let e = 6.0 * b", &n)
    s = add_line(&s, "let f = d + e", &n)
    s = add_line(&s, "let g = f + 1.0", &n)
    s = add_line(&s, "let h = 4.0 * c", &n)
    s = add_line(&s, "let i = 4.0 * a", &n)
    s = add_line(&s, "let j = h + i", &n)
    s = add_line(&s, "gate j", &n)
    s = add_line(&s, "let k = g - j", &n)
    s = add_line(&s, "store [r] <- k", &n)
    s = add_line(&s, "gate k", &n)
    s = add_line(&s, "}", &n)
    s
}

fn emit_img(img: EisaxImage, out_path: string, buf: &![i8; 65536]) -> bool with IO, Mut, Div, Panic {
    let meta = bridge_translate(img, buf)
    bridge_write_elf(out_path, buf, meta)
}

fn emit_one(src: Str, out_path: string, buf: &![i8; 65536]) -> bool with IO, Mut, Div, Panic {
    let br = eisa_compile(src)
    if br.status != 0 { return false }
    let img = eisax_encode(br.build)
    emit_img(img, out_path, buf)
}

fn v1_loop_img() -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 24)
    b.consts[0] = 0.0
    b.consts[1] = 3.0
    b.n_const = 2
    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.ops[1] = op_econst()
    b.dsts[1] = 2
    b.as_[1] = 1
    b.ops[2] = op_ebrz()
    b.as_[2] = 0
    b.bs_[2] = 4
    b.ops[3] = op_ehalt()
    b.ops[4] = op_egate()
    b.dsts[4] = 2
    b.ops[5] = op_ehalt()
    b.n_code = 6
    eisax_encode(b)
}

fn v1_if_both_img() -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 40)
    b.consts[0] = 0.0 - 1.0
    b.consts[1] = 1.0
    b.consts[2] = 0.0
    b.n_const = 3
    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.ops[1] = op_econst()
    b.dsts[1] = 1
    b.as_[1] = 1
    b.ops[2] = op_econst()
    b.dsts[2] = 2
    b.as_[2] = 2
    b.ops[3] = op_ebrn()
    b.as_[3] = 0
    b.bs_[3] = 5
    b.ops[4] = op_ebr()
    b.as_[4] = 6
    b.ops[5] = op_emov()
    b.dsts[5] = 2
    b.as_[5] = 1
    b.ops[6] = op_egate()
    b.dsts[6] = 2
    b.ops[7] = op_econst()
    b.dsts[7] = 0
    b.as_[7] = 1
    b.ops[8] = op_ebrn()
    b.as_[8] = 0
    b.bs_[8] = 10
    b.ops[9] = op_egate()
    b.dsts[9] = 0
    b.ops[10] = op_ehalt()
    b.n_code = 11
    eisax_encode(b)
}

fn v1_i6_img() -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 32)
    b.consts[0] = 1.0
    b.consts[1] = 0.0
    b.consts[2] = 5.0
    b.n_const = 3
    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.ops[1] = op_econst()
    b.dsts[1] = 1
    b.as_[1] = 1
    b.ops[2] = op_ediv()
    b.dsts[2] = 2
    b.as_[2] = 0
    b.bs_[2] = 1
    b.ops[3] = op_ebrz()
    b.as_[3] = 2
    b.bs_[3] = 6
    b.ops[4] = op_econst()
    b.dsts[4] = 3
    b.as_[4] = 2
    b.ops[5] = op_egate()
    b.dsts[5] = 3
    b.ops[6] = op_ehalt()
    b.n_code = 7
    eisax_encode(b)
}

fn v1_fuel_img() -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 5)
    b.consts[0] = 1.0
    b.n_const = 1
    b.ops[0] = op_econst()
    b.dsts[0] = 5
    b.as_[0] = 0
    b.ops[1] = op_ebr()
    b.as_[1] = 1
    b.n_code = 2
    eisax_encode(b)
}

fn v1_highreg_img() -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 12)
    b.consts[0] = 7.25
    b.n_const = 1
    b.ops[0] = op_econst()
    b.dsts[0] = 20
    b.as_[0] = 0
    b.ops[1] = op_egate()
    b.dsts[1] = 20
    b.ops[2] = op_ehalt()
    b.n_code = 3
    eisax_encode(b)
}

// Flip the mul program's first constant 0.5 -> 0.6 and re-encode so the
// image hash and validation still pass. Used to demonstrate tamper-sensitivity.
fn tampered_mul_img() -> EisaxImage with Mut, Div, Panic {
    let br = eisa_compile(golden_mul_src())
    var b = br.build
    b.consts[0 as usize] = 0.6
    eisax_encode(b)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var buf: [i8; 65536] = [0; 65536]
    var fails = 0
    println("emit: golden-mul")
    if !emit_one(golden_mul_src(), "artifacts/eisa/golden-mul.eisax.elf", &!buf) { fails = fails + 1 }
    println("emit: golden-add")
    if !emit_one(golden_add_src(), "artifacts/eisa/golden-add.eisax.elf", &!buf) { fails = fails + 1 }
    println("emit: golden-sqrt")
    if !emit_one(golden_sqrt_src(), "artifacts/eisa/golden-sqrt.eisax.elf", &!buf) { fails = fails + 1 }
    println("emit: golden-poison")
    if !emit_one(golden_poison_src(), "artifacts/eisa/golden-poison.eisax.elf", &!buf) { fails = fails + 1 }
    println("emit: golden-mul-tampered")
    if !emit_img(tampered_mul_img(), "artifacts/eisa/golden-mul-tampered.eisax.elf", &!buf) { fails = fails + 1 }
    println("emit: e5-cancellation")
    if !emit_one(e5_cancellation_src(), "artifacts/eisa/e5-cancellation.eisax.elf", &!buf) { fails = fails + 1 }
    println("emit: v1-loop")
    if !emit_img(v1_loop_img(), "artifacts/eisa/v1-loop.eisax.elf", &!buf) { fails = fails + 1 }
    println("emit: v1-if-both")
    if !emit_img(v1_if_both_img(), "artifacts/eisa/v1-if-both.eisax.elf", &!buf) { fails = fails + 1 }
    println("emit: v1-i6")
    if !emit_img(v1_i6_img(), "artifacts/eisa/v1-i6.eisax.elf", &!buf) { fails = fails + 1 }
    println("emit: v1-fuel")
    if !emit_img(v1_fuel_img(), "artifacts/eisa/v1-fuel.eisax.elf", &!buf) { fails = fails + 1 }
    println("emit: v1-highreg")
    if !emit_img(v1_highreg_img(), "artifacts/eisa/v1-highreg.eisax.elf", &!buf) { fails = fails + 1 }
    assert(fails == 0)
    0
}
