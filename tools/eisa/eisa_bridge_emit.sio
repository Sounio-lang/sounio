module tools::eisa::eisa_bridge_emit

use eisa::backend::*
use eisa::format::*
use eisa::bridge_x86::*
use str::lib::*

fn nl() -> Str with Mut, Div, Panic {
    var b: [i8; 256] = [0; 256]
    b[0] = 10 as i8
    str_from_bytes_buf(&b, 1)
}

fn add_line(dst: &Str, txt: string, n: &Str) -> Str with Mut, Div, Panic {
    let line = str_from_literal(txt)
    let t = str_cat(dst, &line)
    str_cat(&t, n)
}

fn golden_mul_src() -> Str with Mut, Div, Panic {
    let n = nl()
    var s = str_new()
    s = add_line(&s, "epistemic fn golden_mul() {", &n)
    s = add_line(&s, "let a = 0.5", &n)
    s = add_line(&s, "let b = 7.25", &n)
    s = add_line(&s, "let c = a * b", &n)
    s = add_line(&s, "gate c", &n)
    s = add_line(&s, "store [dose] <- c", &n)
    s = add_line(&s, "}", &n)
    s
}

fn golden_add_src() -> Str with Mut, Div, Panic {
    let n = nl()
    var s = str_new()
    s = add_line(&s, "epistemic fn golden_add() {", &n)
    s = add_line(&s, "let a = 0.5", &n)
    s = add_line(&s, "let b = 7.25", &n)
    s = add_line(&s, "let c = a + b", &n)
    s = add_line(&s, "gate c", &n)
    s = add_line(&s, "store [dose] <- c", &n)
    s = add_line(&s, "}", &n)
    s
}

fn golden_sqrt_src() -> Str with Mut, Div, Panic {
    let n = nl()
    var s = str_new()
    s = add_line(&s, "epistemic fn golden_sqrt() {", &n)
    s = add_line(&s, "let a = 2.0", &n)
    s = add_line(&s, "let b = sqrt(a)", &n)
    s = add_line(&s, "gate b", &n)
    s = add_line(&s, "}", &n)
    s
}

fn golden_poison_src() -> Str with Mut, Div, Panic {
    let n = nl()
    var s = str_new()
    s = add_line(&s, "epistemic fn golden_poison() {", &n)
    s = add_line(&s, "let a = 1.0", &n)
    s = add_line(&s, "let b = 0.0", &n)
    s = add_line(&s, "let c = a / b", &n)
    s = add_line(&s, "let d = c + a", &n)
    s = add_line(&s, "gate d", &n)
    s = add_line(&s, "}", &n)
    s
}

fn emit_img(img: EisaxImage, out_path: string, buf: &![i8; 65536]) -> bool with IO, Mut, Div, Panic {
    let meta = bridge_translate(img, buf)
    bridge_write_elf(out_path, buf, meta)
}

fn emit_one(src: Str, out_path: string, buf: &![i8; 65536]) -> bool with IO, Mut, Div, Panic {
    let br = eisa_compile(src)
    if br.status != 0 { return false }
    let img = eisax_encode(br.build)
    emit_img(img, out_path, buf)
}

// Flip the mul program's first constant 0.5 -> 0.6 and re-encode so the
// image hash and validation still pass. Used to demonstrate tamper-sensitivity.
fn tampered_mul_img() -> EisaxImage with Mut, Div, Panic {
    let br = eisa_compile(golden_mul_src())
    var b = br.build
    b.consts[0 as usize] = 0.6
    eisax_encode(b)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var buf: [i8; 65536] = [0; 65536]
    var fails = 0
    println("emit: golden-mul")
    if !emit_one(golden_mul_src(), "artifacts/eisa/golden-mul.eisax.elf", &!buf) { fails = fails + 1 }
    println("emit: golden-add")
    if !emit_one(golden_add_src(), "artifacts/eisa/golden-add.eisax.elf", &!buf) { fails = fails + 1 }
    println("emit: golden-sqrt")
    if !emit_one(golden_sqrt_src(), "artifacts/eisa/golden-sqrt.eisax.elf", &!buf) { fails = fails + 1 }
    println("emit: golden-poison")
    if !emit_one(golden_poison_src(), "artifacts/eisa/golden-poison.eisax.elf", &!buf) { fails = fails + 1 }
    println("emit: golden-mul-tampered")
    if !emit_img(tampered_mul_img(), "artifacts/eisa/golden-mul-tampered.eisax.elf", &!buf) { fails = fails + 1 }
    assert(fails == 0)
    0
}
