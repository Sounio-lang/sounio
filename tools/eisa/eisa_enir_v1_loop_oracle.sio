module tools::eisa::eisa_enir_v1_loop_oracle

// Source-fresh EISA v1 oracle for E2C fuel and loop-carried state.

use eisa::backend::*
use eisa::format::*
use eisa::evm::*
use str::lib::*

fn nl() -> Str with Mut, Div, Panic {
    var b: [i8; 256] = [0; 256]
    b[0] = 10 as i8
    str_from_bytes_buf(&b, 1)
}

fn add_line(dst: &Str, txt: string, n: &Str) -> Str with Mut, Div, Panic {
    let line = str_from_literal(txt)
    let t = str_cat(dst, &line)
    str_cat(&t, n)
}

fn print_nat(n: i64) with IO, Mut, Div, Panic {
    if n == 0 { print("0"); return }
    var digits: [i64; 20] = [0; 20]
    var value = n
    var count: i64 = 0
    while value > 0 {
        digits[count as usize] = value - (value / 10) * 10
        value = value / 10
        count = count + 1
    }
    var i = count - 1
    while i >= 0 {
        var byte: [i8; 1] = [0; 1]
        byte[0] = (48 + digits[i as usize]) as i8
        print(str_from_bytes(byte, 1))
        i = i - 1
    }
}

fn print_reg_parts(machine: &EvmMachine, reg: i64) with IO, Mut, Div, Panic {
    let bits = f64_to_bits(machine.reg_val[reg as usize])
    print("|last_sign=")
    print_nat((bits >> 63) & 1)
    print("|last_exp=")
    print_nat((bits >> 52) & 2047)
    print("|last_mant=")
    print_nat(bits & 4503599627370495)
}

fn v1_fuel_src() -> Str with Mut, Div, Panic {
    let n = nl()
    var s = str_new()
    s = add_line(&s, "epistemic fn v1_fuel() {", &n)
    s = add_line(&s, "fuel 5", &n)
    s = add_line(&s, "let one=1", &n)
    s = add_line(&s, "while one != 0.0 {", &n)
    s = add_line(&s, "}", &n)
    s = add_line(&s, "}", &n)
    s
}

fn v1e_fixedpoint_src() -> Str with Mut, Div, Panic {
    let n = nl()
    var s = str_new()
    s = add_line(&s, "epistemic fn v1e_fixedpoint() {", &n)
    s = add_line(&s, "fuel 100", &n)
    s = add_line(&s, "let x=2", &n)
    s = add_line(&s, "let f=4", &n)
    s = add_line(&s, "let c=2", &n)
    s = add_line(&s, "while c != 0.0 {", &n)
    s = add_line(&s, "let r=f/x", &n)
    s = add_line(&s, "let s=x+r", &n)
    s = add_line(&s, "let n=s/2", &n)
    s = add_line(&s, "set c=n-x", &n)
    s = add_line(&s, "set x=n", &n)
    s = add_line(&s, "}", &n)
    s = add_line(&s, "gate x", &n)
    s = add_line(&s, "}", &n)
    s
}

fn v1_fuel_high_src() -> Str with Mut, Div, Panic {
    let n = nl()
    var s = str_new()
    s = add_line(&s, "epistemic fn v1_fuel_high() {", &n)
    s = add_line(&s, "fuel 25", &n)
    s = add_line(&s, "let a=0", &n)
    s = add_line(&s, "let b=0", &n)
    s = add_line(&s, "let c=0", &n)
    s = add_line(&s, "let d=0", &n)
    s = add_line(&s, "let e=0", &n)
    s = add_line(&s, "let f=0", &n)
    s = add_line(&s, "let g=0", &n)
    s = add_line(&s, "let h=0", &n)
    s = add_line(&s, "let i=0", &n)
    s = add_line(&s, "let j=0", &n)
    s = add_line(&s, "let k=0", &n)
    s = add_line(&s, "let l=0", &n)
    s = add_line(&s, "let m=0", &n)
    s = add_line(&s, "let n=0", &n)
    s = add_line(&s, "let o=0", &n)
    s = add_line(&s, "let p=0", &n)
    s = add_line(&s, "let q=0", &n)
    s = add_line(&s, "let r=0", &n)
    s = add_line(&s, "let s=0", &n)
    s = add_line(&s, "let t=0", &n)
    s = add_line(&s, "let u=1", &n)
    s = add_line(&s, "while u != 0.0 {", &n)
    s = add_line(&s, "}", &n)
    s = add_line(&s, "}", &n)
    s
}

fn run_case(name: string, source: Str) -> i64 with IO, Mut, Div, Panic {
    print("e2c-case-begin|name=")
    print(name)
    print("|source_len=")
    print_nat(source.len)
    println("")
    let compiled = eisa_compile_v1(source)
    if compiled.status != 0 {
        print("e2c-case-compile-error|name=")
        print(name)
        print("|status=")
        if compiled.status < 0 { print("-"); print_nat(0 - compiled.status) } else { print_nat(compiled.status) }
        println("")
        return 1
    }
    let image = eisax_encode(compiled.build)
    var machine = evm_load(image)
    let rc = evm_run(&!machine)
    print("e2c-case-end|name=")
    print(name)
    print("|rc=")
    print_nat(rc)
    print("|gates=")
    print_nat(machine.gate_count)
    print("|fuel_initial=")
    print_nat(machine.initial_fuel)
    print("|fuel_left=")
    print_nat(machine.fuel_left)
    print("|stop_kind=")
    print_nat(machine.stop_kind)
    print("|last_reg=")
    print_nat(machine.last_written_reg)
    print("|branch_poisoned=")
    print_nat(machine.br_poisoned)
    print("|frail_branches=")
    print_nat(machine.frail_branches)
    print_reg_parts(&machine, machine.last_written_reg)
    println("")
    if rc != 0 || machine.error != 0 { 1 } else { 0 }
}

fn main() with IO, Mut, Div, Panic {
    var failures: i64 = 0
    failures = failures + run_case("v1_fuel", v1_fuel_src())
    failures = failures + run_case("v1e_fixedpoint", v1e_fixedpoint_src())
    failures = failures + run_case("v1_fuel_high", v1_fuel_high_src())
    if failures != 0 { panic("E2C source-fresh EISA v1 oracle failed") }
    println("E2C_EISA_V1_LOOP_ORACLE_PASS")
}
