epistemic fn v2_equal_else() {
fuel 60
let cond=1
let scalar_then=2
let scalar_else=3
let a_then=10
let a_else=10
let b_then=100
let b_else=99
if_zero cond == 0.0 {
store [a] <- a_then
store [b] <- b_then
yield scalar_then
} else {
store [a] <- a_else
store [b] <- b_else
yield scalar_else
}
join selected
let va=load [a]
let vb=load [b]
let scaled=va*10
let partial=selected+scaled
let result=partial+vb
gate result
}
