module tools::eisa::eisa_evm_run

use eisa::backend::*
use eisa::format::*
use eisa::evm::*
use str::lib::*

fn nl() -> Str with Mut, Div, Panic {
    var b: [i8; 256] = [0; 256]
    b[0] = 10 as i8
    str_from_bytes_buf(&b, 1)
}

fn add_line(dst: &Str, txt: string, n: &Str) -> Str with Mut, Div, Panic {
    let line = str_from_literal(txt)
    let t = str_cat(dst, &line)
    str_cat(&t, n)
}

fn golden_mul_src() -> Str with Mut, Div, Panic {
    let n = nl()
    var s = str_new()
    s = add_line(&s, "epistemic fn golden_mul() {", &n)
    s = add_line(&s, "let a = 0.5", &n)
    s = add_line(&s, "let b = 7.25", &n)
    s = add_line(&s, "let c = a * b", &n)
    s = add_line(&s, "gate c", &n)
    s = add_line(&s, "store [dose] <- c", &n)
    s = add_line(&s, "}", &n)
    s
}

fn golden_add_src() -> Str with Mut, Div, Panic {
    let n = nl()
    var s = str_new()
    s = add_line(&s, "epistemic fn golden_add() {", &n)
    s = add_line(&s, "let a = 0.5", &n)
    s = add_line(&s, "let b = 7.25", &n)
    s = add_line(&s, "let c = a + b", &n)
    s = add_line(&s, "gate c", &n)
    s = add_line(&s, "store [dose] <- c", &n)
    s = add_line(&s, "}", &n)
    s
}

fn golden_sqrt_src() -> Str with Mut, Div, Panic {
    let n = nl()
    var s = str_new()
    s = add_line(&s, "epistemic fn golden_sqrt() {", &n)
    s = add_line(&s, "let a = 2.0", &n)
    s = add_line(&s, "let b = sqrt(a)", &n)
    s = add_line(&s, "gate b", &n)
    s = add_line(&s, "}", &n)
    s
}

fn golden_poison_src() -> Str with Mut, Div, Panic {
    let n = nl()
    var s = str_new()
    s = add_line(&s, "epistemic fn golden_poison() {", &n)
    s = add_line(&s, "let a = 1.0", &n)
    s = add_line(&s, "let b = 0.0", &n)
    s = add_line(&s, "let c = a / b", &n)
    s = add_line(&s, "let d = c + a", &n)
    s = add_line(&s, "gate d", &n)
    s = add_line(&s, "}", &n)
    s
}

// E5 showcase kernel: reduced-quartic catastrophic cancellation, same source
// as examples/eisa_cancellation_kernel.sio (gate j = pre-cancel O(1) operand,
// gate k = collapsed result whose roundoff lane carries the true ~2^-80).
fn e5_cancellation_src() -> Str with Mut, Div, Panic {
    let n = nl()
    var s = str_new()
    s = add_line(&s, "epistemic fn k() {", &n)
    s = add_line(&s, "let a = 1.000001", &n)
    s = add_line(&s, "let b = a * a", &n)
    s = add_line(&s, "let c = b * a", &n)
    s = add_line(&s, "let d = b * b", &n)
    s = add_line(&s, "let e = 6.0 * b", &n)
    s = add_line(&s, "let f = d + e", &n)
    s = add_line(&s, "let g = f + 1.0", &n)
    s = add_line(&s, "let h = 4.0 * c", &n)
    s = add_line(&s, "let i = 4.0 * a", &n)
    s = add_line(&s, "let j = h + i", &n)
    s = add_line(&s, "gate j", &n)
    s = add_line(&s, "let k = g - j", &n)
    s = add_line(&s, "store [r] <- k", &n)
    s = add_line(&s, "gate k", &n)
    s = add_line(&s, "}", &n)
    s
}

fn run_one(src: Str) -> i64 with IO, Mut, Div, Panic {
    let br = eisa_compile(src)
    if br.status != 0 { return 1 }
    let img = eisax_encode(br.build)
    var m = evm_load(img)
    evm_run(&!m)
}

fn run_img(img: EisaxImage) -> i64 with IO, Mut, Div, Panic {
    var m = evm_load(img)
    evm_run(&!m)
}

fn v1_loop_img() -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 24)
    b.consts[0] = 0.0
    b.consts[1] = 3.0
    b.n_const = 2
    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.ops[1] = op_econst()
    b.dsts[1] = 2
    b.as_[1] = 1
    b.ops[2] = op_ebrz()
    b.as_[2] = 0
    b.bs_[2] = 4
    b.ops[3] = op_ehalt()
    b.ops[4] = op_egate()
    b.dsts[4] = 2
    b.ops[5] = op_ehalt()
    b.n_code = 6
    eisax_encode(b)
}

