    b.ops[4] = op_emov()
    b.dsts[4] = 4
    b.as_[4] = 3
    b.ops[5] = op_egate()
    b.dsts[5] = 3
    b.ops[6] = op_egate()
    b.dsts[6] = 4
    b.ops[7] = op_ehalt()
    b.n_code = 8
    eisax_encode(b)
}

// W4 v2 loop lane: mirrors v1_loop_img with version 2 — ebrz-driven skip on
