// W4 micro-step 1: smallest v2 (qd128) program — econst + gate, no qd math.
// Byte-oracle for the v2-const-gate conformance lane.
fn v2_const_gate_img() -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v2())
    b = eisax_build_set_fuel(b, 12)
    b.consts[0] = 7.25
    b.n_const = 1
    b.ops[0] = op_econst()
    b.dsts[0] = 3
    b.as_[0] = 0
    b.ops[1] = op_egate()
    b.dsts[1] = 3
    b.ops[2] = op_ehalt()
    b.n_code = 3
    eisax_encode(b)
}

