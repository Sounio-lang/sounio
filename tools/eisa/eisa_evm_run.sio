// Reduced-quartic catastrophic cancellation (mirrors e5_cancellation_src).
// a=1.000001; b=a*a; c=b*a; d=b*b; e=6*b; f=d+e; g=f+1; h=4*c; i=4*a;
// j=h+i; gate j; k=g-j; store [r]<-k; gate k; halt.
fn e5_cancellation_img() -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_fuel(b, 64)
    b.consts[0] = 1.000001
    b.consts[1] = 6.0
    b.consts[2] = 1.0
    b.consts[3] = 4.0
    b.n_const = 4
    // constants into registers
    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.ops[1] = op_econst()
    b.dsts[1] = 1
    b.as_[1] = 1
    b.ops[2] = op_econst()
    b.dsts[2] = 2
    b.as_[2] = 2
    b.ops[3] = op_econst()
    b.dsts[3] = 3
    b.as_[3] = 3
    // b = a*a
    b.ops[4] = op_emul()
    b.dsts[4] = 4
    b.as_[4] = 0
    b.bs_[4] = 0
    // c = b*a
    b.ops[5] = op_emul()
    b.dsts[5] = 5
    b.as_[5] = 4
    b.bs_[5] = 0
    // d = b*b
    b.ops[6] = op_emul()
    b.dsts[6] = 6
    b.as_[6] = 4
    b.bs_[6] = 4
    // e = 6*b
    b.ops[7] = op_emul()
    b.dsts[7] = 7
    b.as_[7] = 1
    b.bs_[7] = 4
    // f = d+e
    b.ops[8] = op_eadd()
    b.dsts[8] = 8
    b.as_[8] = 6
    b.bs_[8] = 7
    // g = f+1
    b.ops[9] = op_eadd()
    b.dsts[9] = 9
    b.as_[9] = 8
    b.bs_[9] = 2
    // h = 4*c
    b.ops[10] = op_emul()
    b.dsts[10] = 10
    b.as_[10] = 3
    b.bs_[10] = 5
    // i = 4*a
    b.ops[11] = op_emul()
    b.dsts[11] = 11
    b.as_[11] = 3
    b.bs_[11] = 0
    // j = h+i
    b.ops[12] = op_eadd()
    b.dsts[12] = 12
    b.as_[12] = 10
    b.bs_[12] = 11
    // gate j
    b.ops[13] = op_egate()
    b.dsts[13] = 12
    // k = g-j
    b.ops[14] = op_esub()
    b.dsts[14] = 13
    b.as_[14] = 9
    b.bs_[14] = 12
    // store [r] <- k
    b.ops[15] = op_estore()
    b.dsts[15] = 13
    b.as_[15] = 0
    // gate k
    b.ops[16] = op_egate()
    b.dsts[16] = 13
    b.n_code = 17
    eisax_encode(b)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var fails = 0
    if run_img(golden_mul_img()) != 0 { fails = fails + 1 }
    if run_img(golden_add_img()) != 0 { fails = fails + 1 }
    if run_img(golden_sqrt_img()) != 0 { fails = fails + 1 }
    if run_img(golden_poison_img()) != 0 { fails = fails + 1 }
    if run_img(e5_cancellation_img()) != 0 { fails = fails + 1 }
    if run_img(v1_loop_img()) != 0 { fails = fails + 1 }
    if run_img(v1_if_both_img()) != 0 { fails = fails + 1 }
    if run_img(v1_i6_img()) != 0 { fails = fails + 1 }
    if run_img(v1_fuel_img()) != 0 { fails = fails + 1 }
    if run_img(v1_highreg_img()) != 0 { fails = fails + 1 }
    if run_img(v1e_fixedpoint_img()) != 0 { fails = fails + 1 }
    if run_img(v1e_frail_img()) != 0 { fails = fails + 1 }
    if run_img(v1e_emov_negzero_img()) != 0 { fails = fails + 1 }
    if run_img(v1_arith_high_img()) != 0 { fails = fails + 1 }
    if run_img(v1_fuel_high_img()) != 0 { fails = fails + 1 }
    if run_img(v1_branch_high_img()) != 0 { fails = fails + 1 }
    if run_img(v2_const_gate_img()) != 0 { fails = fails + 1 }
    if run_img(v2_add_img()) != 0 { fails = fails + 1 }
    if run_img(v2_sub_img()) != 0 { fails = fails + 1 }
    if run_img(v2_mul_img()) != 0 { fails = fails + 1 }
    if run_img(v2_div_img()) != 0 { fails = fails + 1 }
    if run_img(v2_sqrt_img()) != 0 { fails = fails + 1 }
    if run_img(v2_rump_qd_img()) != 0 { fails = fails + 1 }
    if run_img(v1_rump_dd_img()) != 0 { fails = fails + 1 }
    if run_img(v2_fuel_img()) != 0 { fails = fails + 1 }
    if run_img(v2_mem_img()) != 0 { fails = fails + 1 }
    if run_img(v2_emov_img()) != 0 { fails = fails + 1 }
    if run_img(v2_loop_img()) != 0 { fails = fails + 1 }
    if run_img(v2_frail_img()) != 0 { fails = fails + 1 }
    if run_img(v2_mem_poison_img()) != 0 { fails = fails + 1 }
    assert(fails == 0)
    0
}
