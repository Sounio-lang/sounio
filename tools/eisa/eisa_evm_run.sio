// Rump 1988 byte-oracle (mirrors wv2_build_wh_rump). version=2 reconstructs
// -54767/66192 on the qd128 err lane; version=1 is the dd64 failure lane.
fn rump_build(ver: i64) -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, ver)
    b = eisax_build_set_fuel(b, 64)
    b.consts[0] = 77617.0
    b.consts[1] = 33096.0
    b.consts[2] = 333.75
    b.consts[3] = 11.0
    b.consts[4] = 121.0
    b.consts[5] = 2.0
    b.consts[6] = 5.5
    b.n_const = 7
    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.ops[1] = op_econst()
    b.dsts[1] = 1
    b.as_[1] = 1
    b.ops[2] = op_emul()
    b.dsts[2] = 2
    b.as_[2] = 1
    b.bs_[2] = 1
    b.ops[3] = op_emul()
    b.dsts[3] = 3
    b.as_[3] = 2
    b.bs_[3] = 2
    b.ops[4] = op_emul()
    b.dsts[4] = 4
    b.as_[4] = 3
    b.bs_[4] = 2
    b.ops[5] = op_emul()
    b.dsts[5] = 5
    b.as_[5] = 3
    b.bs_[5] = 3
    b.ops[6] = op_emul()
    b.dsts[6] = 6
    b.as_[6] = 0
    b.bs_[6] = 0
    b.ops[7] = op_econst()
    b.dsts[7] = 7
    b.as_[7] = 2
    b.ops[8] = op_emul()
    b.dsts[8] = 8
    b.as_[8] = 4
    b.bs_[8] = 7
    b.ops[9] = op_econst()
    b.dsts[9] = 7
    b.as_[9] = 3
    b.ops[10] = op_emul()
    b.dsts[10] = 9
    b.as_[10] = 6
    b.bs_[10] = 2
    b.ops[11] = op_emul()
    b.dsts[11] = 9
    b.as_[11] = 9
    b.bs_[11] = 7
    b.ops[12] = op_esub()
    b.dsts[12] = 9
    b.as_[12] = 9
    b.bs_[12] = 4
    b.ops[13] = op_econst()
    b.dsts[13] = 7
    b.as_[13] = 4
    b.ops[14] = op_emul()
    b.dsts[14] = 10
    b.as_[14] = 3
    b.bs_[14] = 7
    b.ops[15] = op_esub()
    b.dsts[15] = 9
    b.as_[15] = 9
    b.bs_[15] = 10
    b.ops[16] = op_econst()
    b.dsts[16] = 10
    b.as_[16] = 5
    b.ops[17] = op_esub()
    b.dsts[17] = 9
    b.as_[17] = 9
    b.bs_[17] = 10
    b.ops[18] = op_emul()
    b.dsts[18] = 9
    b.as_[18] = 6
    b.bs_[18] = 9
    b.ops[19] = op_econst()
    b.dsts[19] = 7
    b.as_[19] = 6
    b.ops[20] = op_emul()
    b.dsts[20] = 11
    b.as_[20] = 5
    b.bs_[20] = 7
    b.ops[21] = op_emul()
    b.dsts[21] = 12
    b.as_[21] = 1
    b.bs_[21] = 10
    b.ops[22] = op_ediv()
    b.dsts[22] = 12
    b.as_[22] = 0
    b.bs_[22] = 12
    b.ops[23] = op_eadd()
    b.dsts[23] = 13
    b.as_[23] = 8
    b.bs_[23] = 9
    b.ops[24] = op_eadd()
    b.dsts[24] = 13
    b.as_[24] = 13
    b.bs_[24] = 11
    b.ops[25] = op_eadd()
    b.dsts[25] = 14
    b.as_[25] = 13
    b.bs_[25] = 12
    b.ops[26] = op_egate()
    b.dsts[26] = 13
    b.ops[27] = op_egate()
    b.dsts[27] = 12
    b.ops[28] = op_egate()
    b.dsts[28] = 14
    b.ops[29] = op_ehalt()
    b.n_code = 30
    eisax_encode(b)
}

fn v2_rump_qd_img() -> EisaxImage with Mut, Panic, Div {
    rump_build(eisax_version_v2())
}

fn v1_rump_dd_img() -> EisaxImage with Mut, Panic, Div {
    rump_build(eisax_version_v1())
}

