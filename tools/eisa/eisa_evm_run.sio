    b.ops[1] = op_ebr()
    b.as_[1] = 1
    b.n_code = 2
    eisax_encode(b)
}

// W4 v2 mem lane: minimal estore+eload roundtrip on the qd128 mem lane.
// econst r3; estore [slot0] <- r3; eload r4 <- [slot0]; gate r4; ehalt.
fn v2_mem_img() -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v2())
    b = eisax_build_set_fuel(b, 12)
    b.consts[0] = 7.25
    b.n_const = 1
    b.ops[0] = op_econst()
    b.dsts[0] = 3
    b.as_[0] = 0
    b.ops[1] = op_estore()
    b.dsts[1] = 3
    b.as_[1] = 0
    b.ops[2] = op_eload()
    b.dsts[2] = 4
    b.as_[2] = 0
    b.ops[3] = op_egate()
    b.dsts[3] = 4
    b.ops[4] = op_ehalt()
    b.n_code = 5
    eisax_encode(b)
}

// W4 v2 adversarial poison roundtrip: poison a register (1/0), then push it
// through estore -> eload -> emov and gate. Exercises the poison-on-bad-operand
// path of all three memory ops (the one non-trivial reachable non-canonical
// state; the poison=0 + non-finite-component state is unreachable because every
// write normalises). Receipt must be byte-identical to the Metron VM.
fn v2_mem_poison_img() -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v2())
    b = eisax_build_set_fuel(b, 20)
    b.consts[0] = 1.0
    b.consts[1] = 0.0
    b.n_const = 2
    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.ops[1] = op_econst()
    b.dsts[1] = 1
    b.as_[1] = 1
    b.ops[2] = op_ediv()
    b.dsts[2] = 2
    b.as_[2] = 0
    b.bs_[2] = 1
    b.ops[3] = op_estore()
    b.dsts[3] = 2
    b.as_[3] = 0
    b.ops[4] = op_eload()
    b.dsts[4] = 3
    b.as_[4] = 0
    b.ops[5] = op_emov()
    b.dsts[5] = 4
    b.as_[5] = 3
    b.ops[6] = op_egate()
    b.dsts[6] = 4
    b.ops[7] = op_ehalt()
    b.n_code = 8
    eisax_encode(b)
}

