    b.as_[1] = 1
    b.ops[2] = op_econst()
    b.dsts[2] = 22
    b.as_[2] = 2
    b.ops[3] = op_eadd()
    b.dsts[3] = 30
    b.as_[3] = 20
    b.bs_[3] = 21
    b.ops[4] = op_esub()
