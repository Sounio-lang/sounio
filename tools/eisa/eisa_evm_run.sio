// Hand-built v0 images that reproduce the surface golden_* / e5 programs.
// Toolchain-portable (no eisa_compile string parsing); receipts stay v=1.
fn golden_mul_img() -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_fuel(b, 12)
    b.consts[0] = 0.5
    b.consts[1] = 7.25
    b.n_const = 2
    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.ops[1] = op_econst()
    b.dsts[1] = 1
    b.as_[1] = 1
    b.ops[2] = op_emul()
    b.dsts[2] = 2
    b.as_[2] = 0
    b.bs_[2] = 1
    b.ops[3] = op_egate()
    b.dsts[3] = 2
    b.ops[4] = op_estore()
    b.dsts[4] = 2
    b.as_[4] = 0
    b.n_code = 5
    eisax_encode(b)
}

