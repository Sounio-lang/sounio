    b.ops[1] = op_econst()
    b.dsts[1] = 1
    b.as_[1] = 1
    b.ops[2] = op_econst()
    b.dsts[2] = 2
    b.as_[2] = 0
    b.ops[3] = op_ediv()
    b.dsts[3] = 3
    b.as_[3] = 1
    b.bs_[3] = 0
    b.ops[4] = op_eadd()
    b.dsts[4] = 4
    b.as_[4] = 0
    b.bs_[4] = 3
    b.ops[5] = op_ediv()
    b.dsts[5] = 5
    b.as_[5] = 4
    b.bs_[5] = 2
    b.ops[6] = op_esub()
    b.dsts[6] = 6
    b.as_[6] = 5
    b.bs_[6] = 0
    b.ops[7] = op_emov()
    b.dsts[7] = 0
    b.as_[7] = 5
    b.ops[8] = op_ebrz()
    b.as_[8] = 6
    b.bs_[8] = 10
    b.ops[9] = op_ebr()
    b.as_[9] = 3
    b.ops[10] = op_egate()
    b.dsts[10] = 0
