    s = add_line(&s, "let n=0", &n)
    s = add_line(&s, "let p=9999999999999999", &n)
    s = add_line(&s, "let q=1", &n)
    s = add_line(&s, "let r=p+q", &n)
    s = add_line(&s, "let s=r-p", &n)
    s = add_line(&s, "let t=0-1", &n)
    s = add_line(&s, "while s != 0.0 {", &n)
    s = add_line(&s, "}", &n)
    s = add_line(&s, "if t < 0.0 {", &n)
    s = add_line(&s, "}", &n)
    s = add_line(&s, "gate s", &n)
    s = add_line(&s, "gate t", &n)
    s = add_line(&s, "}", &n)
    s
}

fn run_case(name: string, source: Str, probe0: i64, probe1: i64) -> i64 with IO, Mut, Div, Panic {
    print("e2b-case-begin|name=")
    print(name)
    print("|source_len=")
    print_nat(source.len)
    println("")
    let compiled = eisa_compile_v1(source)
    if compiled.status != 0 {
        print("e2b-case-compile-error|name=")
        print(name)
        print("|status=")
        if compiled.status < 0 { print("-"); print_nat(0 - compiled.status) } else { print_nat(compiled.status) }
        println("")
        return 1
    }
    let image = eisax_encode(compiled.build)
    var machine = evm_load(image)
    let rc = evm_run(&!machine)
    print("e2b-case-end|name=")
    print(name)
    print("|rc=")
    print_nat(rc)
    print("|gates=")
    print_nat(machine.gate_count)
    print("|branch_poisoned=")
    print_nat(machine.br_poisoned)
    print("|frail_branches=")
    print_nat(machine.frail_branches)
    print_probe(&machine, probe0, "probe0")
    print_probe(&machine, probe1, "probe1")
    println("")
    if rc != 0 || machine.error != 0 { 1 } else { 0 }
}

fn main() with IO, Mut, Div, Panic {
    var failures: i64 = 0
    failures = failures + run_case("v1_loop", v1_loop_src(), 1, -1)
    failures = failures + run_case("v1_if_both", v1_if_both_src(), 2, -1)
    failures = failures + run_case("v1_i6", v1_i6_src(), 3, -1)
    failures = failures + run_case("v1_highreg", v1_highreg_src(), 20, -1)
    failures = failures + run_case("v1e_frail", v1e_frail_src(), 3, -1)
    failures = failures + run_case("v1e_emov_negzero", v1e_emov_negzero_src(), 3, 4)
    failures = failures + run_case("v1_arith_high", v1_arith_high_src(), 23, -1)
    failures = failures + run_case("v1_branch_high", v1_branch_high_src(), 17, 18)
    if failures != 0 { panic("E2B source-fresh EISA v1 oracle failed") }
    println("E2B_EISA_V1_ORACLE_PASS")
}
