fn v1_branch_high_src() -> Str with Mut, Div, Panic {
    let n = nl()
    var s = str_new()
    s = add_line(&s, "epistemic fn v1_branch_high() {", &n)
    s = add_line(&s, "let a=0", &n)
    s = add_line(&s, "let b=0", &n)
    s = add_line(&s, "let c=0", &n)
    s = add_line(&s, "let d=0", &n)
