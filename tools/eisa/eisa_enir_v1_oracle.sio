fn v1e_frail_src() -> Str with Mut, Div, Panic {
    let n = nl()
    var s = str_new()
    s = add_line(&s, "epistemic fn v1e_frail() {", &n)
    s = add_line(&s, "let big=10000000000000000.0", &n)
    s = add_line(&s, "let one=1.0", &n)
    s = add_line(&s, "let sum=big+one", &n)
    s = add_line(&s, "let delta=sum-big", &n)
    s = add_line(&s, "while delta != 0.0 {", &n)
    s = add_line(&s, "}", &n)
    s = add_line(&s, "gate delta", &n)
    s = add_line(&s, "}", &n)
    s
}

