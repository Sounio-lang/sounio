module tools::eisa::eisa_enir_v1_oracle

// Source-fresh EISA v1 oracle for the E2B finite-CFG corpus slice.

use eisa::backend::*
use eisa::format::*
use eisa::evm::*
use str::lib::*

fn nl() -> Str with Mut, Div, Panic {
    var b: [i8; 256] = [0; 256]
    b[0] = 10 as i8
    str_from_bytes_buf(&b, 1)
}

fn add_line(dst: &Str, txt: string, n: &Str) -> Str with Mut, Div, Panic {
    let line = str_from_literal(txt)
    let t = str_cat(dst, &line)
    str_cat(&t, n)
}

fn print_nat(n: i64) with IO, Mut, Div, Panic {
    if n == 0 { print("0"); return }
    var digits: [i64; 20] = [0; 20]
    var value = n
    var count: i64 = 0
    while value > 0 {
        digits[count as usize] = value - (value / 10) * 10
        value = value / 10
        count = count + 1
    }
    var i = count - 1
    while i >= 0 {
        let ch: i8 = (48 + digits[i as usize]) as i8
        var byte: [i8; 1] = [0; 1]
        byte[0] = ch
        print(str_from_bytes(byte, 1))
        i = i - 1
    }
}

fn print_probe(machine: &EvmMachine, reg: i64, label: string) with IO, Mut, Div, Panic {
    let bits = if reg >= 0 { f64_to_bits(machine.reg_val[reg as usize]) } else { 0 }
    print("|")
    print(label)
    print("_reg=")
    if reg < 0 { print("none") } else { print_nat(reg) }
    print("|")
    print(label)
    print("_sign=")
    print_nat((bits >> 63) & 1)
    print("|")
    print(label)
    print("_exp=")
    print_nat((bits >> 52) & 2047)
    print("|")
    print(label)
    print("_mant=")
    print_nat(bits & 4503599627370495)
}

fn v1_loop_src() -> Str with Mut, Div, Panic {
    let n = nl()
    var s = str_new()
    s = add_line(&s, "epistemic fn v1_loop() {", &n)
    s = add_line(&s, "let zero=0.0", &n)
    s = add_line(&s, "let three=3.0", &n)
    s = add_line(&s, "while zero != 0.0 {", &n)
    s = add_line(&s, "}", &n)
    s = add_line(&s, "gate three", &n)
    s = add_line(&s, "}", &n)
    s
}

fn v1_if_both_src() -> Str with Mut, Div, Panic {
    let n = nl()
    var s = str_new()
    s = add_line(&s, "epistemic fn v1_if_both() {", &n)
    s = add_line(&s, "let neg=0-1.0", &n)
    s = add_line(&s, "let one=1.0", &n)
    s = add_line(&s, "if neg < 0.0 {", &n)
    s = add_line(&s, "}", &n)
    s = add_line(&s, "gate one", &n)
    s = add_line(&s, "if one < 0.0 {", &n)
    s = add_line(&s, "}", &n)
    s = add_line(&s, "gate one", &n)
    s = add_line(&s, "}", &n)
    s
}

