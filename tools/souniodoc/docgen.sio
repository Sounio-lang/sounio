fn main() with IO, Panic, Mut, Div {
    let args_count = argc()
    if args_count < 2 {
        println("Usage: souc run tools/souniodoc/docgen.sio -- <stdlib-dir> [output.md]")
        println("  Scans stdlib/**/*.sio for pub fn signatures and /// doc comments.")
        println("  Generates a markdown API reference grouped by module.")
        return
    }

    let stdlib_dir = argv(1)
    let out_path = if args_count >= 3 { argv(2) } else { "docs/stdlib/STDLIB_API_REFERENCE.md" }

    println("souniodoc: scanning " + stdlib_dir + " -> " + out_path)

    let total_fn = 0
    let total_modules = 0

    let modules = collect_modules(stdlib_dir)
    let n = array_len(modules)

    let out = file_open_write(out_path)
    write_header(out)

    var i = 0
    while i < n {
        let mod = modules[i]
        let fn_count = emit_module(out, mod)
        if fn_count > 0 {
            total_fn = total_fn + fn_count
            total_modules = total_modules + 1
        }
        i = i + 1
    }

    write_summary(out, total_modules, total_fn)
    file_close(out)

    println("souniodoc: wrote " + int_to_str(total_fn) + " pub fn across " + int_to_str(total_modules) + " modules -> " + out_path)
}

struct Module {
    name: string,
    display: string,
    files: string,
    file_count: i32,
}

struct ModuleInfo {
    name: string,
    display: string,
    path: string,
}

fn write_header(out: i64) with IO {
    file_write_line(out, "<!-- AUTO-GENERATED by tools/souniodoc/docgen.sio — do not edit manually -->")
    file_write_line(out, "")
    file_write_line(out, "# Sounio Standard Library API Reference")
    file_write_line(out, "")
    file_write_line(out, "This reference lists all public functions (`pub fn`) in the Sounio standard library,")
    file_write_line(out, "organized by module. Generated from source on the date shown below.")
    file_write_line(out, "")
    file_write_line(out, "**Generated**: AUTO_DATE")
    file_write_line(out, "**Source**: `stdlib/**/*.sio`")
    file_write_line(out, "**Generator**: `tools/souniodoc/docgen.sio` (self-hosted)")
    file_write_line(out, "")
    file_write_line(out, "---")
    file_write_line(out, "")
}

fn write_summary(out: i64, modules: i32, fns: i32) with IO {
    file_write_line(out, "")
    file_write_line(out, "## Summary")
    file_write_line(out, "")
    file_write_line(out, "- **" + int_to_str(modules) + "** modules with public APIs")
    file_write_line(out, "- **" + int_to_str(fns) + "** total public functions")
    file_write_line(out, "- Generated from `stdlib/` source files by `tools/souniodoc/docgen.sio`")
    file_write_line(out, "")
    file_write_line(out, "---")
    file_write_line(out, "")
    file_write_line(out, "## Regeneration")
    file_write_line(out, "")
    file_write_line(out, "```bash")
    file_write_line(out, "SOUC=./bin/souc")
    file_write_line(out, "$SOUC run tools/souniodoc/docgen.sio -- stdlib/ docs/stdlib/STDLIB_API_REFERENCE.md")
    file_write_line(out, "```")
}

fn emit_module(out: i64, mod: Module) -> i32 with IO, Panic, Mut, Div {
    let count = mod.file_count
    if count == 0 { return 0 }

    file_write_line(out, "## " + mod.display + " (`stdlib/" + mod.name + "/`)")
    file_write_line(out, "")
    file_write_line(out, "**" + int_to_str(count) + " source files**")
    file_write_line(out, "")

    let fn_count = 0

    var i = 0
    while i < count {
        let file_path = get_file(mod.files, i)
        let fns_in_file = extract_pub_fns(out, file_path, mod.name)
        fn_count = fn_count + fns_in_file
        i = i + 1
    }

    if fn_count > 0 {
        file_write_line(out, "")
    }
    file_write_line(out, "---")
    file_write_line(out, "")

    return fn_count
}

fn extract_pub_fns(out: i64, file_path: string, module_name: string) -> i32 with IO, Panic, Mut, Div {
    let content = file_read(file_path)
    let lines = split_lines(content)
    let n = array_len(lines)

    var count = 0
    var doc_buf = ""
    var i = 0

    while i < n {
        let line = lines[i]
        let trimmed = trim(line)

        if starts_with(trimmed, "/// ") {
            doc_buf = doc_buf + trim(trimmed) + "\n"
        } else if starts_with(trimmed, "///") && str_len(trimmed) == 3 {
            doc_buf = doc_buf + "\n"
        } else if starts_with(trimmed, "pub fn ") {
            let sig = extract_fn_sig(trimmed)
            let rel_path = "stdlib/" + module_name + "/" + basename(file_path)
            file_write_line(out, "- `" + sig + "` — *" + rel_path + "*")

            if str_len(doc_buf) > 0 {
                file_write_line(out, "  > " + doc_buf)
                doc_buf = ""
            }
            count = count + 1
        } else if starts_with(trimmed, "pub struct ") || starts_with(trimmed, "pub enum ") || starts_with(trimmed, "pub type ") {
            if str_len(doc_buf) > 0 {
                let name = extract_type_name(trimmed)
                let rel_path = "stdlib/" + module_name + "/" + basename(file_path)
                file_write_line(out, "- **" + name + "** — *" + rel_path + "*")
                file_write_line(out, "  > " + doc_buf)
                doc_buf = ""
                count = count + 1
            }
        } else if str_len(trimmed) > 0 && !starts_with(trimmed, "//") {
            doc_buf = ""
        }

        i = i + 1
    }

    return count
}

fn extract_fn_sig(line: string) -> string with Panic {
    let brace = str_find(line, "{")
    if brace >= 0 {
        return trim(str_slice(line, 0, brace))
    }
    return trim(line)
}

fn extract_type_name(line: string) -> string with Panic {
    let after_kw = 0
    if starts_with(line, "pub struct ") {
        after_kw = 11
    } else if starts_with(line, "pub enum ") {
        after_kw = 9
    } else if starts_with(line, "pub type ") {
        after_kw = 9
    }
    let rest = trim(str_slice(line, after_kw, str_len(line)))
    let sp = str_find(rest, " ")
    let br = str_find(rest, "{")
    let lt = str_find(rest, "<")
    let end = str_len(rest)
    if sp >= 0 && sp < end { end = sp }
    if br >= 0 && br < end { end = br }
    if lt >= 0 && lt < end { end = lt }
    return trim(str_slice(rest, 0, end))
}
