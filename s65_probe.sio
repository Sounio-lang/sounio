module main

use pbpk::rapamycin_assay_gum::{
    ag_cv_lcms, ag_cv_immuno,
    ag_std_margin_pk_n7, ag_std_margin_pk_n14, ag_std_margin_pk_n28,
    ag_std_margin_lcms_n7, ag_std_margin_lcms_n14, ag_std_margin_lcms_n28,
    ag_std_margin_immuno_n7, ag_std_margin_immuno_n14, ag_std_margin_immuno_n28,
    ag_std_u_pk_n7, ag_std_u_pk_n14, ag_std_u_pk_n28,
    ag_std_u_lcms_n7, ag_std_u_lcms_n14, ag_std_u_lcms_n28,
    ag_std_u_immuno_n7, ag_std_u_immuno_n14, ag_std_u_immuno_n28,
    ag_std_u_total_lcms_n7, ag_std_u_total_lcms_n14, ag_std_u_total_lcms_n28,
    ag_std_u_total_immuno_n7, ag_std_u_total_immuno_n14, ag_std_u_total_immuno_n28,
    ag_std_ncrit_pk_only, ag_std_nlast_pk_only, ag_std_span_pk_only,
    ag_std_ncrit_lcms, ag_std_nlast_lcms, ag_std_span_lcms,
    ag_std_ncrit_immuno, ag_std_nlast_immuno, ag_std_span_immuno,
    ag_span_loss_lcms, ag_span_loss_immuno
}

fn pi(n: i64) with Mut, Div, Panic, IO {
    if n == 0 { print("0") }
    else {
        var digits = [0, 0, 0, 0, 0, 0, 0, 0]
        var num = n; var count = 0
        while num > 0 { digits[count] = num - (num / 10) * 10; num = num / 10; count = count + 1 }
        var idx = count - 1
        while idx >= 0 {
            if digits[idx] == 0 { print("0") } else if digits[idx] == 1 { print("1") }
            else if digits[idx] == 2 { print("2") } else if digits[idx] == 3 { print("3") }
            else if digits[idx] == 4 { print("4") } else if digits[idx] == 5 { print("5") }
            else if digits[idx] == 6 { print("6") } else if digits[idx] == 7 { print("7") }
            else if digits[idx] == 8 { print("8") } else { print("9") };
            idx = idx - 1
        }
    }
}

fn main() with Mut, Div, Panic, IO {
    print("=== Assay CVs ===\n")
    print("CV_lcms:   "); print_f64(ag_cv_lcms());   print("\n")
    print("CV_immuno: "); print_f64(ag_cv_immuno()); print("\n")

    print("\n=== PK-only margins (std stratum) ===\n")
    print("N=7:  "); print_f64(ag_std_margin_pk_n7());  print("\n")
    print("N=14: "); print_f64(ag_std_margin_pk_n14()); print("\n")
    print("N=28: "); print_f64(ag_std_margin_pk_n28()); print("\n")

    print("\n=== HPLC-MS/MS margins ===\n")
    print("N=7:  "); print_f64(ag_std_margin_lcms_n7());  print("\n")
    print("N=14: "); print_f64(ag_std_margin_lcms_n14()); print("\n")
    print("N=28: "); print_f64(ag_std_margin_lcms_n28()); print("\n")

    print("\n=== Immunoassay margins ===\n")
    print("N=7:  "); print_f64(ag_std_margin_immuno_n7());  print("\n")
    print("N=14: "); print_f64(ag_std_margin_immuno_n14()); print("\n")
    print("N=28: "); print_f64(ag_std_margin_immuno_n28()); print("\n")

    print("\n=== Uncertainty components (mg/L) ===\n")
    print("u_pk    N=7:  "); print_f64(ag_std_u_pk_n7());    print("\n")
    print("u_lcms  N=7:  "); print_f64(ag_std_u_lcms_n7());  print("\n")
    print("u_immuno N=7: "); print_f64(ag_std_u_immuno_n7()); print("\n")
    print("u_tot_lcms N=7:   "); print_f64(ag_std_u_total_lcms_n7());   print("\n")
    print("u_tot_immuno N=7: "); print_f64(ag_std_u_total_immuno_n7()); print("\n")
    print("u_pk    N=14: "); print_f64(ag_std_u_pk_n14());    print("\n")
    print("u_lcms  N=14: "); print_f64(ag_std_u_lcms_n14());  print("\n")
    print("u_immuno N=14:"); print_f64(ag_std_u_immuno_n14()); print("\n")
    print("u_tot_lcms N=14:  "); print_f64(ag_std_u_total_lcms_n14());   print("\n")
    print("u_tot_immuno N=14:"); print_f64(ag_std_u_total_immuno_n14()); print("\n")
    print("u_pk    N=28: "); print_f64(ag_std_u_pk_n28());    print("\n")
    print("u_immuno N=28:"); print_f64(ag_std_u_immuno_n28()); print("\n")
    print("u_tot_immuno N=28:"); print_f64(ag_std_u_total_immuno_n28()); print("\n")

    print("\n=== Cert windows ===\n")
    print("PK-only:    ncrit="); pi(ag_std_ncrit_pk_only()); print(" nlast="); pi(ag_std_nlast_pk_only()); print(" span="); pi(ag_std_span_pk_only()); print("\n")
    print("LCMS:       ncrit="); pi(ag_std_ncrit_lcms());    print(" nlast="); pi(ag_std_nlast_lcms());    print(" span="); pi(ag_std_span_lcms());    print("\n")
    print("Immunoassay: ncrit="); pi(ag_std_ncrit_immuno()); print(" nlast="); pi(ag_std_nlast_immuno()); print(" span="); pi(ag_std_span_immuno()); print("\n")

    print("\n=== Span losses from PK-only ===\n")
    print("LCMS span loss:   "); pi(ag_span_loss_lcms());   print("\n")
    print("Immuno span loss: "); pi(ag_span_loss_immuno()); print("\n")
}
