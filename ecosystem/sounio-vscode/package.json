{
  "name": "sounio-vscode",
  "displayName": "Sounio",
  "description": "Language support for Sounio (.sio) — L0 systems + epistemic computing language with effect system, linear types, units of measure, and uncertainty tracking",
  "version": "0.2.0",
  "publisher": "sounio-lang",
  "license": "MIT",
  "icon": "images/sounio-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sounio-lang/sounio"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "sounio",
    "sio",
    "epistemic",
    "scientific computing",
    "effect system",
    "linear types",
    "units of measure",
    "uncertainty"
  ],
  "activationEvents": [
    "onLanguage:sounio"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sounio",
        "aliases": [
          "Sounio",
          "sounio"
        ],
        "extensions": [
          ".sio"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sounio",
        "scopeName": "source.sounio",
        "path": "./syntaxes/sounio.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "sounio",
        "path": "./snippets/sounio.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Sounio",
      "properties": {
        "sounio.soucPath": {
          "type": "string",
          "default": "",
          "description": "Path to the souc binary. If empty, searches PATH and common locations."
        },
        "sounio.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run souc check on file save to report diagnostics."
        },
        "sounio.stdlibPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Sounio stdlib directory (sets SOUNIO_STDLIB_PATH)."
        },
        "sounio.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable LSP client (souc lsp --stdio). Falls back to souc check if unavailable."
        },
        "sounio.rustismDetector.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time detection of Rust-isms in Sounio code."
        },
        "sounio.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inlay hints."
        },
        "sounio.inlayHints.typeHints": {
          "type": "boolean",
          "default": true,
          "description": "Show type hints for let bindings."
        },
        "sounio.inlayHints.confidenceHints": {
          "type": "boolean",
          "default": true,
          "description": "Show confidence hints for epistemic values."
        },
        "sounio.epistemic.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable epistemic mode with confidence badges."
        },
        "sounio.epistemic.confidenceThreshold": {
          "type": "number",
          "default": 0.8,
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence threshold for highlighting."
        },
        "sounio.epistemic.showBadges": {
          "type": "boolean",
          "default": true,
          "description": "Show confidence badges inline."
        },
        "sounio.epistemic.showProvenance": {
          "type": "boolean",
          "default": false,
          "description": "Show provenance info in hover tooltips."
        }
      }
    },
    "commands": [
      {
        "command": "sounio.runFile",
        "title": "Sounio: Run Current File",
        "icon": "$(play)"
      },
      {
        "command": "sounio.checkFile",
        "title": "Sounio: Check Current File",
        "icon": "$(check)"
      },
      {
        "command": "sounio.showAst",
        "title": "Sounio: Show AST",
        "icon": "$(symbol-class)"
      },
      {
        "command": "sounio.showHir",
        "title": "Sounio: Show HIR",
        "icon": "$(symbol-class)"
      },
      {
        "command": "sounio.showHlir",
        "title": "Sounio: Show HLIR",
        "icon": "$(symbol-class)"
      },
      {
        "command": "sounio.toggleEpistemic",
        "title": "Sounio: Toggle Epistemic Mode",
        "icon": "$(telescope)"
      },
      {
        "command": "sounio.showConfidence",
        "title": "Sounio: Show Confidence Info",
        "icon": "$(percentage)"
      },
      {
        "command": "sounio.showProvenance",
        "title": "Sounio: Show Provenance Chain",
        "icon": "$(git-branch)"
      },
      {
        "command": "sounio.showUncertainty",
        "title": "Sounio: Show Uncertainty Info",
        "icon": "$(graph)"
      },
      {
        "command": "sounio.startRepl",
        "title": "Sounio: Start REPL",
        "icon": "$(terminal)"
      },
      {
        "command": "sounio.restartServer",
        "title": "Sounio: Restart Language Server",
        "icon": "$(debug-restart)"
      },
      {
        "command": "sounio.detectRustisms",
        "title": "Sounio: Detect Rust-isms",
        "icon": "$(warning)"
      },
      {
        "command": "sounio.addImport",
        "title": "Sounio: Add Import...",
        "icon": "$(add)"
      }
    ],
    "keybindings": [
      {
        "command": "sounio.runFile",
        "key": "f5",
        "when": "editorLangId == sounio"
      },
      {
        "command": "sounio.checkFile",
        "key": "ctrl+shift+b",
        "when": "editorLangId == sounio"
      },
      {
        "command": "sounio.showConfidence",
        "key": "ctrl+shift+c",
        "when": "editorLangId == sounio"
      },
      {
        "command": "sounio.toggleEpistemic",
        "key": "ctrl+shift+e",
        "when": "editorLangId == sounio"
      },
      {
        "command": "sounio.showUncertainty",
        "key": "ctrl+shift+u",
        "when": "editorLangId == sounio"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "sounio.showConfidence",
          "when": "editorLangId == sounio",
          "group": "sounio@1"
        },
        {
          "command": "sounio.showProvenance",
          "when": "editorLangId == sounio",
          "group": "sounio@2"
        },
        {
          "command": "sounio.showUncertainty",
          "when": "editorLangId == sounio",
          "group": "sounio@3"
        }
      ]
    },
    "semanticTokenTypes": [
      {
        "id": "effect",
        "description": "Effect type (IO, Mut, etc.)"
      },
      {
        "id": "unit",
        "description": "Unit of measure (kg, mL, etc.)"
      },
      {
        "id": "refinement",
        "description": "Refinement type predicate"
      },
      {
        "id": "confidence",
        "description": "Confidence level annotation"
      },
      {
        "id": "provenance",
        "description": "Provenance marker"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "mutable",
        "description": "Mutable binding"
      },
      {
        "id": "linear",
        "description": "Linear type"
      },
      {
        "id": "affine",
        "description": "Affine type"
      },
      {
        "id": "highConfidence",
        "description": "High confidence (>=95%)"
      },
      {
        "id": "lowConfidence",
        "description": "Low confidence (<60%)"
      },
      {
        "id": "uncertain",
        "description": "Uncertain value"
      },
      {
        "id": "ontologyBacked",
        "description": "Ontology-backed value"
      }
    ],
    "colors": [
      {
        "id": "sounio.confidenceHigh",
        "description": "High confidence color",
        "defaults": {
          "dark": "#4CAF50",
          "light": "#2E7D32"
        }
      },
      {
        "id": "sounio.confidenceMedium",
        "description": "Medium confidence color",
        "defaults": {
          "dark": "#FFC107",
          "light": "#F57F17"
        }
      },
      {
        "id": "sounio.confidenceLow",
        "description": "Low confidence color",
        "defaults": {
          "dark": "#F44336",
          "light": "#C62828"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "undici": "^8.5.0",
    "vscode-languageclient": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^3.9.2",
    "cheerio": "^1.2.0",
    "typescript": "^5.9.3"
  }
}
