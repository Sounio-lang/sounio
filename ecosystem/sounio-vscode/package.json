{
  "name": "sounio-vscode",
  "displayName": "Sounio",
  "description": "Language support for Sounio (.sio) — L0 systems + epistemic computing language",
  "version": "0.1.0",
  "publisher": "sounio-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sounio-lang/sounio-vscode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "sounio",
    "sio",
    "epistemic",
    "systems",
    "scientific"
  ],
  "activationEvents": [
    "onLanguage:sounio"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sounio",
        "aliases": [
          "Sounio",
          "sounio"
        ],
        "extensions": [
          ".sio"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sounio",
        "scopeName": "source.sounio",
        "path": "./syntaxes/sounio.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "sounio",
        "path": "./snippets/sounio.json"
      }
    ],
    "configuration": {
      "title": "Sounio",
      "properties": {
        "sounio.soucPath": {
          "type": "string",
          "default": "",
          "description": "Path to the souc binary. If empty, searches PATH and common locations."
        },
        "sounio.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run souc check on file save to report diagnostics."
        },
        "sounio.stdlibPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Sounio stdlib directory (sets SOUNIO_STDLIB_PATH)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}
