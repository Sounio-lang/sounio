{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sounio",
  "scopeName": "source.sounio",
  "fileTypes": ["sio"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords-control" },
    { "include": "#keywords-epistemic" },
    { "include": "#storage-types" },
    { "include": "#constants" },
    { "include": "#effects" },
    { "include": "#operators" },
    { "include": "#type-names" },
    { "include": "#unit-annotations" },
    { "include": "#function-definitions" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.sounio",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.sounio",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.sounio",
          "match": "\\\\[nrt\\\\\"'0]"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.sounio",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.sounio",
          "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.binary.sounio",
          "match": "\\b0b[01][01_]*\\b"
        },
        {
          "name": "constant.numeric.integer.sounio",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control.sounio",
          "match": "\\b(fn|let|var|if|else|for|while|loop|match|return|break|continue|in|with|import|module|type|struct|enum|linear|affine|trait|effect|impl|use|pub|as|is|on|ref|dyn|box|step|self|Self|move|copy|drop|chan|send|recv|dual|const|where|async|await|spawn|infer|prior|super|crate|handle|handler|perform|observe|resume|sample|belief|session|require|extern|static|export|kernel|unsafe)\\b"
        }
      ]
    },
    "keywords-epistemic": {
      "patterns": [
        {
          "name": "keyword.other.epistemic.sounio",
          "match": "\\b(Knowledge|Proof|Lemma|Axiom|Valid|Model|Robust|Policy|Evidence|Computed|Deferred|Measured|Aleatoric|uncertain|posterior|Validated|Confidence|Likelihood|DiffPrivate|DPBudget|Strategy|Objective|CausalEffect|Intervention|RecoursePlan|TransitionPlan|Counterfactual|DeferralPolicy|DecisionPolicy|RecoursePolicy|AlternativeSet|MonitoringPolicy|PotentialOutcome|TransitionPolicy|AcquisitionPlan|AcquisitionPolicy|AlternativePolicy|AlternativeOption|ObservedTransition|RollbackCertificate|TransitionPlan|Derived|Contest|Admissible|ValidUntil|ValidWhile|audit|level|scope|close|route|entropy|strategy|objective|confidence|likelihood|validation|policy|models|session)\\b"
        }
      ]
    },
    "storage-types": {
      "patterns": [
        {
          "name": "storage.type.sounio",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|char|str|String|Vec|unit)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.sounio",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "effects": {
      "patterns": [
        {
          "name": "keyword.other.effect.sounio",
          "match": "\\b(IO|Alloc|Panic|Mut|Div|Net|Pure|GPU|Async|Log|File|Socket|Rand|Time|Env|FFI)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.sounio",
          "match": "(&!|\\+\\+|->|=>|\\|>|<-|\\.\\.\\.|\\.\\.=|\\.\\.|::|<<|>>|==|!=|<=|>=|&&|\\|\\||\\+\\-)"
        },
        {
          "name": "keyword.operator.assignment.sounio",
          "match": "(\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=)"
        },
        {
          "name": "keyword.operator.sounio",
          "match": "[+\\-*/%=<>!&|^~?]"
        }
      ]
    },
    "type-names": {
      "patterns": [
        {
          "name": "entity.name.type.sounio",
          "match": "\\b([A-Z][a-zA-Z0-9_]*)\\b"
        }
      ]
    },
    "unit-annotations": {
      "patterns": [
        {
          "name": "variable.annotation.unit.sounio",
          "match": "(?<=:\\s{0,10})\\b(kg|mg|g|lb|oz|m|km|cm|mm|nm|s|ms|us|ns|Hz|kHz|MHz|mol|mmol|L|mL|Pa|bar|K|°C|°F|N|J|W|V|A|Ω|rad|sr|Bq|Gy|Sv)\\b"
        }
      ]
    },
    "function-definitions": {
      "patterns": [
        {
          "name": "entity.name.function.sounio",
          "match": "(?<=\\bfn\\s)([a-z_][a-zA-Z0-9_]*)"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.sounio",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
