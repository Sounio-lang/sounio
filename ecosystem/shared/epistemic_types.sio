// Shared Epistemic Types for Triple Sounio Ecosystem
// Used by: sounio-py, sounio-jupyter, drug-discovery

// ============================================================================
// 1. CORE EPISTEMIC TYPES
// ============================================================================

// Fundamental epistemic type
struct Knowledge[T] {
    value: T,
    ε: f64,                     // Confidence (0.0 = no confidence, 1.0 = certain)
    prov: string,               // Provenance string
    metadata: KnowledgeMetadata,
}

struct KnowledgeMetadata {
    timestamp: i64,             // Unix timestamp in milliseconds
    source: string,             // Data source identifier
    validation: ValidationInfo, // How this was validated
    units: string,              // Physical units (e.g., "mg/L", "mmHg")
    tags: [string],             // Categorization tags
}

struct ValidationInfo {
    method: string,             // "manual", "automated", "peer_reviewed"
    confidence: f64,            // Confidence in validation
    validator: string,          // Who/what validated this
    timestamp: i64,
}

// ============================================================================
// 2. SCIENTIFIC DATA TYPES (for drug discovery)
// ============================================================================

// Clinical measurement with uncertainty
struct ClinicalMeasurement {
    parameter: string,          // e.g., "systolic_bp", "heart_rate", "temperature"
    value: Knowledge[f64],
    timestamp: i64,
    instrument: string,         // Measurement device
    patient_id: string,
    visit: string,              // e.g., "baseline", "week_4", "followup"
}

// Molecular structure with uncertainty
struct Molecule {
    id: string,
    smiles: string,             // SMILES representation
    properties: MolecularProperties,
    uncertainty: MolecularUncertainty,
}

struct MolecularProperties {
    molecular_weight: Knowledge[f64],
    logp: Knowledge[f64],       // Lipophilicity
    pka: Knowledge[f64],        // Acid dissociation constant
    solubility: Knowledge[f64],
    bioavailability: Knowledge[f64],
}

struct MolecularUncertainty {
    calculation_method: string,
    confidence: f64,
    validation_status: string,
}

// Patient data for clinical trials
struct PatientData {
    id: string,
    demographics: Demographics,
    measurements: [ClinicalMeasurement],
    medical_history: MedicalHistory,
    inclusion_criteria: [string],
    exclusion_criteria: [string],
}

struct Demographics {
    age: Knowledge[i64],
    sex: string,
    weight: Knowledge[f64],     // kg
    height: Knowledge[f64],     // cm
    ethnicity: string,
}

struct MedicalHistory {
    conditions: [MedicalCondition],
    medications: [Medication],
    allergies: [Allergy],
}

// ============================================================================
// 3. PIPELINE DATA TYPES (for drug discovery pipeline)
// ============================================================================

// Virtual screening result
struct ScreeningResult {
    molecule: Molecule,
    score: Knowledge[f64],      // Docking score or similarity score
    target: string,             // Protein target
    confidence: f64,
    rationale: string,
}

// PK/PD modeling result
struct PKPDProfile {
    molecule: Molecule,
    parameters: PKParameters,
    pd_effects: PDEffects,
    confidence: f64,
}

struct PKParameters {
    bioavailability: Knowledge[f64],    // F
    volume_distribution: Knowledge[f64], // Vd
    clearance: Knowledge[f64],          // CL
    half_life: Knowledge[f64],          // t½
    auc: Knowledge[f64],                // Area under curve
}

struct PDEffects {
    efficacy: Knowledge[f64],           // EC50
    toxicity: Knowledge[f64],           // TD50
    therapeutic_index: Knowledge[f64],  // TI = TD50/EC50
}

// Clinical trial simulation result
struct TrialResult {
    treatment_arm: TreatmentArm,
    control_arm: ControlArm,
    outcomes: TrialOutcomes,
    statistical_significance: StatisticalSignificance,
}

struct TreatmentArm {
    patients: [PatientData],
    treatment: Treatment,
    compliance: Knowledge[f64],
}

struct ControlArm {
    patients: [PatientData],
    control: Control,
}

struct TrialOutcomes {
    primary_endpoint: Knowledge[f64],
    secondary_endpoints: [Knowledge[f64]],
    adverse_events: [AdverseEvent],
    dropout_rate: Knowledge[f64],
}

// Final decision with uncertainty
struct PipelineDecision {
    recommendation: string,              // "approve", "reject", "further_study"
    confidence: f64,
    rationale: string,
    supporting_evidence: [Evidence],
    risks: [Risk],
    benefits: [Benefit],
}

// ============================================================================
// 4. CONVERSION FUNCTIONS (for Python/Jupyter integration)
// ============================================================================

// Convert to Python dictionary (for sounio-py)
fn knowledge_to_python_dict[T](k: Knowledge[T]) -> PythonDict {
    // This would be implemented via FFI
    // Returns a Python dictionary with value, epsilon, provenance
    PythonDict {
        "value": k.value,
        "epsilon": k.ε,
        "provenance": k.prov,
        "metadata": metadata_to_dict(k.metadata),
        "_type": "Knowledge",
        "_sounio_type": type_name(T),
    }
}

fn python_dict_to_knowledge[T](dict: PythonDict) -> Knowledge[T] {
    // Convert Python dictionary back to Knowledge
    Knowledge {
        value: dict.get("value") as T,
        ε: dict.get("epsilon") as f64,
        prov: dict.get("provenance") as string,
        metadata: dict_to_metadata(dict.get("metadata")),
    }
}

// Convert for Jupyter display (for sounio-jupyter)
fn knowledge_to_jupyter_display[T](k: Knowledge[T]) -> JupyterDisplay {
    JupyterDisplay {
        mime_types: {
            "text/plain": format_plain(k),
            "text/html": format_html(k),
            "application/json": format_json(k),
        },
        metadata: {
            "confidence": k.ε,
            "provenance": k.prov,
            "timestamp": k.metadata.timestamp,
        },
    }
}

// Formatting functions
fn format_plain[T](k: Knowledge[T]) -> string {
    let value_str = str(k.value)
    let epsilon_str = str_with_precision(k.ε, 3)
    
    if k.ε >= 0.95 {
        value_str  // High confidence, show just value
    } else if k.ε >= 0.8 {
        value_str + " ± " + epsilon_str
    } else {
        value_str + " (ε=" + epsilon_str + ")"
    }
}

fn format_html[T](k: Knowledge[T]) -> string {
    let value_str = str(k.value)
    let epsilon_str = str_with_precision(k.ε, 3)
    let confidence_percent = (k.ε * 100.0) as i64
    
    // Color code by confidence
    let color = if k.ε >= 0.9 then "#2ecc71"      // Green
               else if k.ε >= 0.7 then "#f39c12"  // Orange
               else "#e74c3c"                     // Red
    
    """
    <div class="epistemic-value" style="border-left: 4px solid """ + color + """; padding-left: 10px;">
        <strong>""" + value_str + """</strong>
        <div style="font-size: 0.9em; color: #666;">
            Confidence: <span style="color: """ + color + """>""" + str(confidence_percent) + """%</span><br>
            Provenance: """ + k.prov + """
        </div>
    </div>
    """
}

// ============================================================================
// 5. UTILITY FUNCTIONS
// ============================================================================

// Calculate overall confidence from multiple Knowledge values
fn aggregate_confidence(values: [Knowledge[T]]) -> f64 {
    // Geometric mean of confidences
    var product = 1.0
    for v in values {
        product = product * v.ε
    }
    pow(product, 1.0 / (array_len(values) as f64))
}

// Check if confidence meets threshold
fn meets_confidence_threshold(value: Knowledge[T], threshold: f64) -> bool {
    value.ε >= threshold
}

// Propagate provenance through operation
fn propagate_provenance(
    result_value: T,
    result_epsilon: f64,
    operation: string,
    inputs: [Knowledge[T]]
) -> string {
    var provenance = operation + "["
    
    for (i, input) in enumerate(inputs) {
        if i > 0 {
            provenance = provenance + ", "
        }
        // Include source from input provenance
        let source = extract_source(input.prov)
        provenance = provenance + source
    }
    
    provenance = provenance + "]"
    provenance
}

// Extract source from provenance string
fn extract_source(provenance: string) -> string {
    // Simple extraction - in real implementation would parse properly
    if str_contains(provenance, "[") {
        let parts = str_split(provenance, "[")
        parts[0]
    } else {
        provenance
    }
}

// ============================================================================
// 6. TYPE ALIASES FOR COMMON USE CASES
// ============================================================================

// Common aliases for drug discovery
type DrugConcentration = Knowledge[f64]  // mg/L
type Time = Knowledge[f64]               // hours
type Dose = Knowledge[f64]               // mg
type Probability = Knowledge[f64]        // 0.0-1.0

type EfficacyScore = Knowledge[f64]      // Higher is better
type ToxicityScore = Knowledge[f64]      // Lower is better
type TherapeuticIndex = Knowledge[f64]   // Ratio TD50/EC50

// Clinical measurements
type BloodPressure = Knowledge[f64]      // mmHg
type HeartRate = Knowledge[f64]          // bpm
type Temperature = Knowledge[f64]        // °C
type LabValue = Knowledge[f64]           // Various units

// ============================================================================
// 7. SERIALIZATION FOR CROSS-PROJECT COMMUNICATION
// ============================================================================

// JSON serialization (for HTTP APIs, file storage)
fn knowledge_to_json[T](k: Knowledge[T]) -> string {
    // Convert to JSON string
    "{\"value\": " + json_value(k.value) + 
    ", \"epsilon\": " + str(k.ε) + 
    ", \"provenance\": \"" + escape_json(k.prov) + "\"" +
    ", \"metadata\": " + metadata_to_json(k.metadata) + "}"
}

fn json_to_knowledge[T](json: string) -> Knowledge[T] {
    // Parse JSON string
    // Implementation would use JSON parser
    // ...
}

// Binary serialization (for performance)
fn knowledge_to_bytes[T](k: Knowledge[T]) -> [u8] {
