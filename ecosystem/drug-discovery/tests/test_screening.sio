//@ run-pass
// Test: Lipinski screening logic

fn t_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn print_f64_3(v: f64) -> i64 with IO, Panic, Div {
    if v < 0.0 {
        print("-")
        let neg_v = 0.0 - v
        let ip = neg_v as i64
        let frac = ((neg_v - (ip as f64)) * 1000.0) as i64
        print_int(ip)
        print(".")
        if frac < 100 { print("0") }
        if frac < 10 { print("0") }
        print_int(frac)
        return 0
    }
    let ip = v as i64
    let frac = ((v - (ip as f64)) * 1000.0) as i64
    print_int(ip)
    print(".")
    if frac < 100 { print("0") }
    if frac < 10 { print("0") }
    print_int(frac)
    return 0
}

struct TK {
    value: f64,
    epsilon: f64,
    prov_id: i64
}

fn check_mw(mw: TK) -> f64 with Div, Panic {
    let threshold = 500.0
    let diff = threshold - mw.value
    let unc = (1.0 - mw.epsilon) * mw.value * 0.1
    if unc < 0.001 {
        if mw.value < threshold { return 1.0 }
        return 0.0
    }
    if diff > unc { return 1.0 }
    if diff < (0.0 - unc) { return 0.0 }
    return ((diff + unc) / (2.0 * unc)) * mw.epsilon
}

fn main() -> i64 with IO, Div, Panic, Mut {
    // Test 1: MW well below 500
    let mw1 = TK { value: 180.0, epsilon: 0.99, prov_id: 0 }
    let r1 = check_mw(mw1)
    if r1 < 0.99 {
        println("FAIL: MW 180 should pass")
        return 1
    }
    print("PASS: MW 180 -> conf=")
    let _ = print_f64_3(r1)
    println("")

    // Test 2: MW well above 500
    let mw2 = TK { value: 600.0, epsilon: 0.99, prov_id: 0 }
    let r2 = check_mw(mw2)
    if r2 > 0.01 {
        println("FAIL: MW 600 should fail")
        return 1
    }
    print("PASS: MW 600 -> conf=")
    let _ = print_f64_3(r2)
    println("")

    // Test 3: MW borderline 498 with low confidence
    let mw3 = TK { value: 498.0, epsilon: 0.80, prov_id: 0 }
    let r3 = check_mw(mw3)
    if r3 < 0.1 {
        println("FAIL: MW 498 (eps=0.80) too low confidence")
        return 1
    }
    if r3 > 0.99 {
        println("FAIL: MW 498 (eps=0.80) too high confidence")
        return 1
    }
    print("PASS: MW 498 borderline -> conf=")
    let _ = print_f64_3(r3)
    println("")

    // Test 4: HBD/HBA checks
    var hbd_pass = 0
    if 3 <= 5 { hbd_pass = 1 }
    if hbd_pass != 1 {
        println("FAIL: HBD 3 should pass")
        return 1
    }
    println("PASS: HBD 3 <= 5")

    var hba_pass = 0
    if 12 <= 10 { hba_pass = 1 }
    if hba_pass != 0 {
        println("FAIL: HBA 12 should fail")
        return 1
    }
    println("PASS: HBA 12 > 10 rejected")

    println("All screening tests passed")
    return 0
}
