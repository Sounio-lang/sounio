module main

use pbpk::rapamycin_inh_trajectory::{
    iht_margin_n1,  iht_margin_n3,  iht_margin_n5,
    iht_margin_n7,  iht_margin_n14, iht_margin_n21,
    iht_margin_n28, iht_margin_n42, iht_margin_n56,
    iht_margin_n84, iht_margin_n120,
    iht_n_crit,     iht_n_last_cert, iht_n_peak,
    iht_margin_peak, iht_ncrit_lead,
    iht_cert_span,  iht_peak_lag,
    iht_margin_gain_n7_to_n56
}

fn pi(n: i64) with Mut, Div, Panic, IO {
    if n == 0 { print("0") }
    else {
        var digits = [0, 0, 0, 0, 0, 0, 0, 0]
        var num = n; var count = 0
        while num > 0 { digits[count] = num - (num / 10) * 10; num = num / 10; count = count + 1 }
        var idx = count - 1
        while idx >= 0 {
            if digits[idx] == 0 { print("0") } else if digits[idx] == 1 { print("1") }
            else if digits[idx] == 2 { print("2") } else if digits[idx] == 3 { print("3") }
            else if digits[idx] == 4 { print("4") } else if digits[idx] == 5 { print("5") }
            else if digits[idx] == 6 { print("6") } else if digits[idx] == 7 { print("7") }
            else if digits[idx] == 8 { print("8") } else { print("9") };
            idx = idx - 1
        }
    }
}

fn main() with Mut, Div, Panic, IO {
    print("=== Inhibitor stratum D=1.5mg trajectory ===\n")
    print("N=1:   "); print_f64(iht_margin_n1());   print("\n")
    print("N=3:   "); print_f64(iht_margin_n3());   print("\n")
    print("N=5:   "); print_f64(iht_margin_n5());   print("\n")
    print("N=7:   "); print_f64(iht_margin_n7());   print("\n")
    print("N=14:  "); print_f64(iht_margin_n14());  print("\n")
    print("N=21:  "); print_f64(iht_margin_n21());  print("\n")
    print("N=28:  "); print_f64(iht_margin_n28());  print("\n")
    print("N=42:  "); print_f64(iht_margin_n42());  print("\n")
    print("N=56:  "); print_f64(iht_margin_n56());  print("\n")
    print("N=84:  "); print_f64(iht_margin_n84());  print("\n")
    print("N=120: "); print_f64(iht_margin_n120()); print("\n")

    print("\n=== Scanners ===\n")
    print("n_crit:      "); pi(iht_n_crit());      print("\n")
    print("n_last_cert: "); pi(iht_n_last_cert()); print("\n")
    print("n_peak:      "); pi(iht_n_peak());      print("\n")
    print("margin_peak: "); print_f64(iht_margin_peak()); print("\n")

    print("\n=== Derived metrics ===\n")
    print("ncrit_lead:          "); pi(iht_ncrit_lead());                   print("\n")
    print("cert_span:           "); pi(iht_cert_span());                    print("\n")
    print("peak_lag:            "); pi(iht_peak_lag());                     print("\n")
    print("margin_gain_n7_n56:  "); print_f64(iht_margin_gain_n7_to_n56()); print("\n")
}
