struct Inner { vals: [i64; 4], n: i64 }
struct Outer { inner: Inner, top: i64 }
fn poke(o: *mut Outer) with Mut, Panic, Div {
    o.top = 9              // auto-deref one-level
    o.inner.n = 3          // auto-deref TWO-level scalar (c.field.field form)
    o.inner.vals[0] = 7    // auto-deref TWO-level array
}
fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let p = heap_alloc(64) as *mut Outer
    p.inner = Inner { vals: [0;4], n: 0 }
    p.top = 0
    poke(p)
    print("top=") print_int(p.top) print(" n=") print_int(p.inner.n) print(" v0=") print_int(p.inner.vals[0]) print("\n")
    0
}
