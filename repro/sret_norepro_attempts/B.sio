struct Node { v: i64 }
struct S { name: [i64; 128], p: Option<Box<Node>>, n: i64 }
struct Tbl { entries: [S; 8], count: i64 }
impl Tbl { fn get(self, idx: i64) -> S { self.entries[idx] } }
fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    var t = Tbl { entries: [S { name: [0;128], p: None, n: 0 }; 8], count: 0 }
    t.entries[0] = S { name: [0;128], p: Some(Box::new(Node { v: 77 })), n: 5 }
    let s = t.get(0)
    match s.p { Some(b) => { print("r=") print_int((*b).v) } None => { print("r=None(BUG)") } }
    print("\n") 0
}
