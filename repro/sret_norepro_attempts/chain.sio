struct TypeEntry2 { ty: i64, hash: i64 }
struct ParamInfo { pty: TypeEntry2, pname: i64 }
struct ParamList { head: ParamInfo, tail: Option<Box<ParamList>> }
struct Sig { name: [i64; 128], params: Option<Box<ParamList>>, param_count: i64 }
struct SigTbl { entries: [Sig; 8], count: i64 }
struct Ck { sigs: SigTbl, top: i64 }

impl SigTbl { fn get(self, idx: i64) -> Sig { self.entries[idx] } }

fn plist_get(opt: Option<Box<ParamList>>, idx: i64) -> ParamInfo with Panic, Div, Alloc {
    match opt {
        None => ParamInfo { pty: TypeEntry2 { ty: -1, hash: 0 }, pname: 0 }
        Some(list) => {
            if idx == 0 { (*list).head } else { plist_get((*list).tail, idx - 1) }
        }
    }
}

fn check_args(c: *mut Ck, params: Option<Box<ParamList>>, pc: i64) -> i64 with Mut, Panic, Div, Alloc {
    let pi = plist_get(params, 0)
    pi.pty.ty               // read the TypeEntry's first field (the crashing read)
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let c = heap_alloc(40000) as *mut Ck
    (*c).sigs = SigTbl { entries: [Sig { name: [0;128], params: None, param_count: 0 }; 8], count: 0 }
    let pl = ParamList { head: ParamInfo { pty: TypeEntry2 { ty: 99, hash: 7 }, pname: 3 }, tail: None }
    (*c).sigs.entries[0] = Sig { name: [0;128], params: Some(Box::new(pl)), param_count: 1 }
    (*c).sigs.count = 1
    let sig = (*c).sigs.get(0)
    let r = check_args(c, sig.params, sig.param_count)
    print("r=") print_int(r) print(" (expect 99)\n") 0
}
