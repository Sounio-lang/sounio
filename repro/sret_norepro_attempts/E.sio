struct Node { v: i64 }
struct S { p: Option<Box<Node>>, n: i64 }
struct Tbl { entries: [S; 8], count: i64 }
impl Tbl { fn getn(self, idx: i64) -> i64 { self.entries[idx].n } }
struct C { tbl: Tbl, top: i64 }
fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let c = heap_alloc(4000) as *mut C
    (*c).tbl = Tbl { entries: [S { p: None, n: 0 }; 8], count: 0 }
    (*c).tbl.entries[0] = S { p: Some(Box::new(Node { v: 77 })), n: 5 }
    print("n=") print_int((*c).tbl.getn(0)) print(" (expect 5)\n") 0
}
