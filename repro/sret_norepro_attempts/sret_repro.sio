struct Node { v: i64 }
struct S { p: Option<Box<Node>>, n: i64 }
struct Tbl { entries: [S; 4], count: i64 }

fn get(t: Tbl, idx: i64) -> S { t.entries[idx] }

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    var t = Tbl { entries: [S { p: None, n: 0 }; 4], count: 0 }
    t.entries[0] = S { p: Some(Box::new(Node { v: 77 })), n: 5 }
    let s = get(t, 0)
    match s.p {
        Some(b) => { print("p=Some v=") print_int((*b).v) }
        None => { print("p=None (BUG)") }
    }
    print(" n=") print_int(s.n) print("\n")
    0
}
