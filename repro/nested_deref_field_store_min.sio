// Minimal reproducer: two-level nested field write through *mut does NOT persist,
// while a one-level field write through the same *mut DOES. Build-independent.
// Compiled by the fall-through-fixed bin/souc (5082bf67e); bug is SEPARATE/still open.
struct Inner { vals: [i64; 4], n: i64 }
struct Outer { inner: Inner, top: i64 }

fn poke(o: *mut Outer) with Mut, Panic, Div {
    (*o).top = 9              // ONE-level write through *mut  (control: persists)
    (*o).inner.n = 3          // TWO-level nested write        (bug: lost)
    (*o).inner.vals[0] = 7    // TWO-level nested array write  (bug: lost)
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let p = heap_alloc(64) as *mut Outer
    (*p).inner = Inner { vals: [0; 4], n: 0 }
    (*p).top = 0
    poke(p)
    print("top=")
    print_int((*p).top)
    print(" n=")
    print_int((*p).inner.n)
    print(" v0=")
    print_int((*p).inner.vals[0])
    print("\n")
    0
}
