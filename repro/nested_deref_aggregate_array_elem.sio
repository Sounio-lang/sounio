struct Sig { a: i64, b: i64 }
struct Tbl { entries: [Sig; 4], count: i64 }
struct Ck { tbl: Tbl, top: i64 }

fn collect(c: *mut Ck) with Mut, Panic, Div {
    (*c).tbl.count = 2                              // nested scalar (= checker's .count)
    (*c).tbl.entries[0] = Sig { a: 11, b: 22 }     // nested AGGREGATE array elem (= checker's entries[i]=sig)
    (*c).tbl.entries[1] = Sig { a: 33, b: 44 }
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let c = heap_alloc(128) as *mut Ck
    (*c).tbl = Tbl { entries: [Sig{a:0,b:0}; 4], count: 0 }
    (*c).top = 7
    collect(c)
    print("count=") print_int((*c).tbl.count)
    print(" e0=") print_int((*c).tbl.entries[0].a) print(",") print_int((*c).tbl.entries[0].b)
    print(" e1=") print_int((*c).tbl.entries[1].a) print(",") print_int((*c).tbl.entries[1].b)
    print(" top=") print_int((*c).top) print("\n")
    0
}
