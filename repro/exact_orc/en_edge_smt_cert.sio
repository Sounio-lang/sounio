use ot::swow_orc::*
use ot::transport_exact::*
use math::rational::*

fn main() -> i64 with IO, Mut, Div, Panic {
    orc_load_csv("data/processed/english_edges_FINAL.csv");
    orc_build_lcc();
    let u = orc_lcc_node(68);
    let v = orc_lcc_node(261);
    let kappa = orc_kappa_edge(u, v);
    let ns = ORC_DEG[u as usize] + 1;
    let nd = ORC_DEG[v as usize] + 1;
    let D = OT_LAST_D;
    modi_duals(ns, nd);
    // 1) dual feasibility: u_i + v_j <= c_ij for ALL i,j
    var feasible: i64 = 1;
    var i: i64 = 0;
    while i < ns {
        var j: i64 = 0;
        while j < nd {
            let ui = Rational { num: DU_N[i as usize], den: DU_D[i as usize] };
            let vj = Rational { num: DV_N[j as usize], den: DV_D[j as usize] };
            let c  = Rational { num: OT_COST[(i*nd+j) as usize], den: 1 };
            if rat_cmp(rat_add(ui, vj), c) > 0 { feasible = 0; }
            j = j + 1;
        }
        i = i + 1;
    }
    if feasible != 1 { return 1; }
    // 2) dual objective = sum (supply_i/D) u_i + sum (demand_j/D) v_j
    var obj = rat_zero();
    i = 0;
    while i < ns {
        let mu = rat_make(OT_SUPPLY[i as usize], D);
        let ui = Rational { num: DU_N[i as usize], den: DU_D[i as usize] };
        obj = rat_add(obj, rat_mul(mu, ui));
        i = i + 1;
    }
    var j: i64 = 0;
    while j < nd {
        let nu = rat_make(OT_DEMAND[j as usize], D);
        let vj = Rational { num: DV_N[j as usize], den: DV_D[j as usize] };
        obj = rat_add(obj, rat_mul(nu, vj));
        j = j + 1;
    }
    // 3) strong duality: dual objective == W1 == 27/20
    if obj.num != 27 { return 2; }
    if obj.den != 20 { return 3; }
    // 4) UNSAT of "exists plan with cost <= 1": obj > 1  =>  W1 > 1 => kappa < 0
    if rat_cmp(obj, rat_one()) <= 0 { return 4; }
    print("EN edge (68,261): dual feasible, dual obj = 27/20 > 1 => UNSAT (kappa<0) CERTIFIED\n");
    return 0;
}
