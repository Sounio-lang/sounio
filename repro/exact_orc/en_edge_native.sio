//! Native exact Ollivier-Ricci for the documented English SWOW edge (68,261).
//! Reads the CSV, builds the LCC graph, BFS hop distances, lazy-walk measure
//! (alpha=1/2), and exact OT — all native. Reproduces W1=27/20, kappa=-7/20.
use ot::swow_orc::*
use ot::transport_exact::*
use math::rational::*

fn pint(x: i64) with IO, Mut, Div, Panic {
    if x == 0 { print_char(48 as u8); return; }
    var n = x;
    if n < 0 { print_char(45 as u8); n = 0 - n; }
    var buf: [i64; 24] = [0; 24];
    var k: i64 = 0;
    while n > 0 { buf[k as usize] = n % 10; n = n / 10; k = k + 1; }
    while k > 0 { k = k - 1; print_char((48 + buf[k as usize]) as u8); }
}

fn pword(fullid: i64) with IO, Mut, Panic {
    let st = ORC_WST[fullid as usize];
    let ln = ORC_WLEN[fullid as usize];
    var i: i64 = 0;
    while i < ln { print_char(ORC_CH[(st + i) as usize] as u8); i = i + 1; }
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let nw = orc_load_csv("data/processed/english_edges_FINAL.csv");
    orc_build_lcc();
    let big = orc_lookup("big", 0, 3);
    let fat = orc_lookup("fat", 0, 3);
    let u = orc_lcc_node(68);
    let v = orc_lcc_node(261);
    let kappa = orc_kappa_edge(u, v);
    print("producer=sounio-native\n");
    print("LCC_N="); pint(ORC_LCC_N); print(" LCC_M="); pint(ORC_LCC_M); print("\n");
    print("node68="); pword(u); print(" node261="); pword(v); print("\n");
    print("adjacent="); if orc_has_edge(u, v) { pint(1); } else { pint(0); } print("\n");
    print("d=1 W1="); pint(ORC_LAST_W1_NUM); print("/"); pint(ORC_LAST_W1_DEN); print("\n");
    print("kappa="); pint(kappa.num); print("/"); pint(kappa.den); print("\n");
    var ok: i64 = 0;
    if ORC_LCC_N == 438 { if ORC_LCC_M == 640 {
      if ORC_LID[big as usize] == 68 { if ORC_LID[fat as usize] == 261 {
        if ORC_LAST_W1_NUM == 27 { if ORC_LAST_W1_DEN == 20 {
          if kappa.num == 0 - 7 { if kappa.den == 20 { ok = 1; } } } } } } } }
    if ok == 1 { print("RESULT=PASS\n"); return 0; }
    print("RESULT=FAIL\n");
    return 1;
}
