//! Native exact ORC mean + bootstrap CI for NL (auto-generated).
use ot::swow_orc::*
use ot::transport_exact::*
use math::rational::*

var RNG: i64 = 88172645463325252

fn next_idx(n: i64) -> i64 with Mut, Div, Panic {
    RNG = RNG * 6364136223846793005 + 1442695040888963407
    var r = RNG
    if r < 0 { r = 0 - r }
    if r < 0 { r = 0 }
    return r % n
}

fn pint(x: i64) with IO, Mut, Div, Panic {
    if x == 0 { print_char(48 as u8); return; }
    var n = x; if n < 0 { print_char(45 as u8); n = 0 - n; }
    var buf: [i64; 24] = [0; 24]; var k: i64 = 0;
    while n > 0 { buf[k as usize] = n % 10; n = n / 10; k = k + 1; }
    while k > 0 { k = k - 1; print_char((48 + buf[k as usize]) as u8); }
}

fn main() -> i64 with IO, Mut, Div, Panic {
    orc_load_csv("data/processed/dutch_edges.csv");
    orc_build_lcc();
    orc_compute_all_kappa();
    let m = ORC_NEDGE;
    // exact per-edge kappa -> f64; mean
    var sum_f: f64 = 0.0;
    var neg: i64 = 0;
    var i: i64 = 0;
    while i < m {
        let kf = (ORC_EK_N[i as usize] as f64) / (ORC_EK_D[i as usize] as f64);
        sum_f = sum_f + kf;
        if ORC_EK_N[i as usize] < 0 { neg = neg + 1; }
        i = i + 1;
    }
    let mean = sum_f / (m as f64);
    // bootstrap B=1000, fixed seed
    var boot: [i64; 1000] = [0; 1000];
    var b: i64 = 0;
    while b < 1000 {
        var s: f64 = 0.0;
        var t: i64 = 0;
        while t < m {
            let idx = next_idx(m);
            s = s + (ORC_EK_N[idx as usize] as f64) / (ORC_EK_D[idx as usize] as f64);
            t = t + 1;
        }
        let mb = s / (m as f64);
        boot[b as usize] = (mb * 1000000000.0) as i64;
        b = b + 1;
    }
    // insertion sort boot[]
    var a: i64 = 1;
    while a < 1000 {
        let key = boot[a as usize];
        var c = a - 1;
        while c >= 0 && boot[c as usize] > key { boot[(c+1) as usize] = boot[c as usize]; c = c - 1; }
        boot[(c+1) as usize] = key;
        a = a + 1;
    }
    let ci_lo = boot[25];
    let ci_hi = boot[974];
    print("LANG=NL LCC_N="); pint(ORC_LCC_N); print(" LCC_M="); pint(ORC_LCC_M);
    print(" E="); pint(m); print(" neg="); pint(neg); print("\n");
    print("kappa_mean_x1e9="); pint((mean * 1000000000.0) as i64); print("\n");
    print("ci95_lo_x1e9="); pint(ci_lo); print(" ci95_hi_x1e9="); pint(ci_hi); print("\n");
    return 0;
}
