struct BigTbl { entries: [i64; 512], count: i64 }
struct Holder { tbl: BigTbl, top: i64 }
fn collect(h: *mut Holder) with Mut, Panic, Div {
    (*h).tbl.count = 5
    (*h).tbl.entries[300] = 77    // variable-ish high index into large inline array field
    h.tbl.entries[511] = 88       // auto-deref form, last elem
}
fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let h = heap_alloc(8192) as *mut Holder
    (*h).tbl = BigTbl { entries: [0; 512], count: 0 }
    (*h).top = 9
    collect(h)
    print("count=") print_int((*h).tbl.count)
    print(" e300=") print_int((*h).tbl.entries[300])
    print(" e511=") print_int((*h).tbl.entries[511])
    print(" top=") print_int((*h).top) print("\n")
    0
}
