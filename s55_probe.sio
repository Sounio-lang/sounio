module main

use pbpk::rapamycin_ind_trajectory::{
    it_margin_n1,  it_margin_n3,  it_margin_n5,
    it_margin_n7,  it_margin_n10, it_margin_n14,
    it_margin_n21, it_margin_n28, it_margin_n42, it_margin_n56,
    it_n_crit,     it_n_last_cert, it_n_peak,
    it_margin_peak, it_ncrit_beyond_n7,
    it_cert_span,  it_peak_lag,
    it_margin_gain_n7_to_n28
}

fn pi(n: i64) with Mut, Div, Panic, IO {
    if n == 0 { print("0") }
    else {
        var digits = [0, 0, 0, 0, 0, 0, 0, 0]
        var num = n; var count = 0
        while num > 0 { digits[count] = num - (num / 10) * 10; num = num / 10; count = count + 1 }
        var idx = count - 1
        while idx >= 0 {
            if digits[idx] == 0 { print("0") } else if digits[idx] == 1 { print("1") }
            else if digits[idx] == 2 { print("2") } else if digits[idx] == 3 { print("3") }
            else if digits[idx] == 4 { print("4") } else if digits[idx] == 5 { print("5") }
            else if digits[idx] == 6 { print("6") } else if digits[idx] == 7 { print("7") }
            else if digits[idx] == 8 { print("8") } else { print("9") };
            idx = idx - 1
        }
    }
}

fn main() with Mut, Div, Panic, IO {
    print("=== Inducer stratum D=34mg trajectory ===\n")
    print("N=1:  "); print_f64(it_margin_n1());  print("\n")
    print("N=3:  "); print_f64(it_margin_n3());  print("\n")
    print("N=5:  "); print_f64(it_margin_n5());  print("\n")
    print("N=7:  "); print_f64(it_margin_n7());  print("\n")
    print("N=10: "); print_f64(it_margin_n10()); print("\n")
    print("N=14: "); print_f64(it_margin_n14()); print("\n")
    print("N=21: "); print_f64(it_margin_n21()); print("\n")
    print("N=28: "); print_f64(it_margin_n28()); print("\n")
    print("N=42: "); print_f64(it_margin_n42()); print("\n")
    print("N=56: "); print_f64(it_margin_n56()); print("\n")

    print("\n=== Scanners ===\n")
    print("n_crit:      "); pi(it_n_crit());      print("\n")
    print("n_last_cert: "); pi(it_n_last_cert()); print("\n")
    print("n_peak:      "); pi(it_n_peak());      print("\n")
    print("margin_peak: "); print_f64(it_margin_peak()); print("\n")

    print("\n=== Derived metrics ===\n")
    print("ncrit_beyond_n7:       "); pi(it_ncrit_beyond_n7());           print("\n")
    print("cert_span:             "); pi(it_cert_span());                 print("\n")
    print("peak_lag:              "); pi(it_peak_lag());                  print("\n")
    print("margin_gain_n7_to_n28: "); print_f64(it_margin_gain_n7_to_n28()); print("\n")
}
