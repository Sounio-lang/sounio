// Sprint 44 probe: steady-state margin profile and safe monitoring gap
// For each stratum at correct dose: N=30/45/60 trough + margin + N_last_cert

module main

use pbpk::rapamycin_assay::{as_trough_mg_l}
use pbpk::rapamycin_expanded_u::{eu_u_c}
use pbpk::rapamycin_clinical::{trough_floor_mg_l, trough_ceil_mg_l}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std,
    ob_ke_var_inh, ob_ke_var_ind
}

fn zf(d: f64, n: i64, ke: f64, f: f64,
      ka_v: f64, fv: f64, ke_v: f64, k12_v: f64, k21_v: f64) -> f64
    with Mut, Div, Panic {
    let c  = as_trough_mg_l(d, n, ke, f)
    let uc = eu_u_c(d, n, ke, f, ka_v, fv, ke_v, k12_v, k21_v)
    (c - trough_floor_mg_l()) / uc
}
fn zc(d: f64, n: i64, ke: f64, f: f64,
      ka_v: f64, fv: f64, ke_v: f64, k12_v: f64, k21_v: f64) -> f64
    with Mut, Div, Panic {
    let c  = as_trough_mg_l(d, n, ke, f)
    let uc = eu_u_c(d, n, ke, f, ka_v, fv, ke_v, k12_v, k21_v)
    (trough_ceil_mg_l() - c) / uc
}
fn mg(d: f64, n: i64, ke: f64, f: f64,
      ka_v: f64, fv: f64, ke_v: f64, k12_v: f64, k21_v: f64) -> f64
    with Mut, Div, Panic {
    let zfv = zf(d,n,ke,f,ka_v,fv,ke_v,k12_v,k21_v)
    let zcv = zc(d,n,ke,f,ka_v,fv,ke_v,k12_v,k21_v)
    if zfv < zcv { zfv } else { zcv }
}
fn find_nlast_cert(d: f64, ke: f64, f: f64,
                   ka_v: f64, fv: f64, ke_v: f64, k12_v: f64, k21_v: f64) -> i64
    with Mut, Div, Panic {
    var n = 1; var last = 0
    while n <= 60 {
        let zfv = zf(d,n,ke,f,ka_v,fv,ke_v,k12_v,k21_v)
        let zcv = zc(d,n,ke,f,ka_v,fv,ke_v,k12_v,k21_v)
        if zfv >= 2.0 && zcv >= 2.0 { last = n }
        n = n + 1
    }
    last
}

fn pi(n: i64) with Mut, Div, Panic, IO {
    if n == 0 { print("0") }
    else {
        var digits = [0, 0, 0, 0, 0, 0, 0, 0]
        var num = n; var count = 0
        while num > 0 { digits[count] = num - (num / 10) * 10; num = num / 10; count = count + 1 }
        var idx = count - 1
        while idx >= 0 {
            if digits[idx] == 0 { print("0") } else if digits[idx] == 1 { print("1") }
            else if digits[idx] == 2 { print("2") } else if digits[idx] == 3 { print("3") }
            else if digits[idx] == 4 { print("4") } else if digits[idx] == 5 { print("5") }
            else if digits[idx] == 6 { print("6") } else if digits[idx] == 7 { print("7") }
            else if digits[idx] == 8 { print("8") } else { print("9") };
            idx = idx - 1
        }
    }
}

fn main() with Mut, Div, Panic, IO {
    let ka  = ob_ka_var_std()
    let fv  = ob_f_var_std()
    let ke  = ob_ke_var_std()
    let k12 = ob_k12_var_std()
    let k21 = ob_k21_var_std()
    let ke_inh = ob_ke_var_inh()
    let ke_ind = ob_ke_var_ind()

    print("=== Steady-state profile at N=30/45/60 ===\n")

    print("std D=5mg N=30: zf="); print_f64(zf(5.0,30,0.01118,0.141,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,30,0.01118,0.141,ka,fv,ke,k12,k21))
    print(" mg="); print_f64(mg(5.0,30,0.01118,0.141,ka,fv,ke,k12,k21)); print("\n")
    print("std D=5mg N=45: zf="); print_f64(zf(5.0,45,0.01118,0.141,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,45,0.01118,0.141,ka,fv,ke,k12,k21))
    print(" mg="); print_f64(mg(5.0,45,0.01118,0.141,ka,fv,ke,k12,k21)); print("\n")
    print("std D=5mg N=60: zf="); print_f64(zf(5.0,60,0.01118,0.141,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,60,0.01118,0.141,ka,fv,ke,k12,k21))
    print(" mg="); print_f64(mg(5.0,60,0.01118,0.141,ka,fv,ke,k12,k21)); print("\n")

    print("slow D=5mg N=30: zf="); print_f64(zf(5.0,30,0.00838,0.188,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,30,0.00838,0.188,ka,fv,ke,k12,k21))
    print(" mg="); print_f64(mg(5.0,30,0.00838,0.188,ka,fv,ke,k12,k21)); print("\n")
    print("slow D=5mg N=45: zf="); print_f64(zf(5.0,45,0.00838,0.188,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,45,0.00838,0.188,ka,fv,ke,k12,k21))
    print(" mg="); print_f64(mg(5.0,45,0.00838,0.188,ka,fv,ke,k12,k21)); print("\n")
    print("slow D=5mg N=60: zf="); print_f64(zf(5.0,60,0.00838,0.188,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,60,0.00838,0.188,ka,fv,ke,k12,k21))
    print(" mg="); print_f64(mg(5.0,60,0.00838,0.188,ka,fv,ke,k12,k21)); print("\n")

    print("fast D=5mg N=30: zf="); print_f64(zf(5.0,30,0.01677,0.094,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,30,0.01677,0.094,ka,fv,ke,k12,k21))
    print(" mg="); print_f64(mg(5.0,30,0.01677,0.094,ka,fv,ke,k12,k21)); print("\n")
    print("fast D=5mg N=45: zf="); print_f64(zf(5.0,45,0.01677,0.094,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,45,0.01677,0.094,ka,fv,ke,k12,k21))
    print(" mg="); print_f64(mg(5.0,45,0.01677,0.094,ka,fv,ke,k12,k21)); print("\n")
    print("fast D=5mg N=60: zf="); print_f64(zf(5.0,60,0.01677,0.094,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,60,0.01677,0.094,ka,fv,ke,k12,k21))
    print(" mg="); print_f64(mg(5.0,60,0.01677,0.094,ka,fv,ke,k12,k21)); print("\n")

    print("inh D=1.5mg N=30: zf="); print_f64(zf(1.5,30,0.002236,0.282,ka,fv,ke_inh,k12,k21))
    print(" zc="); print_f64(zc(1.5,30,0.002236,0.282,ka,fv,ke_inh,k12,k21))
    print(" mg="); print_f64(mg(1.5,30,0.002236,0.282,ka,fv,ke_inh,k12,k21)); print("\n")
    print("inh D=1.5mg N=45: zf="); print_f64(zf(1.5,45,0.002236,0.282,ka,fv,ke_inh,k12,k21))
    print(" zc="); print_f64(zc(1.5,45,0.002236,0.282,ka,fv,ke_inh,k12,k21))
    print(" mg="); print_f64(mg(1.5,45,0.002236,0.282,ka,fv,ke_inh,k12,k21)); print("\n")
    print("inh D=1.5mg N=60: zf="); print_f64(zf(1.5,60,0.002236,0.282,ka,fv,ke_inh,k12,k21))
    print(" zc="); print_f64(zc(1.5,60,0.002236,0.282,ka,fv,ke_inh,k12,k21))
    print(" mg="); print_f64(mg(1.5,60,0.002236,0.282,ka,fv,ke_inh,k12,k21)); print("\n")

    print("ind D=34mg N=30: zf="); print_f64(zf(34.0,30,0.05590,0.047,ka,fv,ke_ind,k12,k21))
    print(" zc="); print_f64(zc(34.0,30,0.05590,0.047,ka,fv,ke_ind,k12,k21))
    print(" mg="); print_f64(mg(34.0,30,0.05590,0.047,ka,fv,ke_ind,k12,k21)); print("\n")
    print("ind D=34mg N=45: zf="); print_f64(zf(34.0,45,0.05590,0.047,ka,fv,ke_ind,k12,k21))
    print(" zc="); print_f64(zc(34.0,45,0.05590,0.047,ka,fv,ke_ind,k12,k21))
    print(" mg="); print_f64(mg(34.0,45,0.05590,0.047,ka,fv,ke_ind,k12,k21)); print("\n")
    print("ind D=34mg N=60: zf="); print_f64(zf(34.0,60,0.05590,0.047,ka,fv,ke_ind,k12,k21))
    print(" zc="); print_f64(zc(34.0,60,0.05590,0.047,ka,fv,ke_ind,k12,k21))
    print(" mg="); print_f64(mg(34.0,60,0.05590,0.047,ka,fv,ke_ind,k12,k21)); print("\n")

    print("\n=== N_last_cert (last certified N in [1,60]) ===\n")
    print("std  N_last_cert="); pi(find_nlast_cert(5.0,0.01118,0.141,ka,fv,ke,k12,k21)); print("\n")
    print("slow N_last_cert="); pi(find_nlast_cert(5.0,0.00838,0.188,ka,fv,ke,k12,k21)); print("\n")
    print("fast N_last_cert="); pi(find_nlast_cert(5.0,0.01677,0.094,ka,fv,ke,k12,k21)); print("\n")
    print("inh  N_last_cert="); pi(find_nlast_cert(1.5,0.002236,0.282,ka,fv,ke_inh,k12,k21)); print("\n")
    print("ind  N_last_cert="); pi(find_nlast_cert(34.0,0.05590,0.047,ka,fv,ke_ind,k12,k21)); print("\n")

    print("\n=== Slow stratum detail N=19-24 (window boundary) ===\n")
    print("slow N=19: zf="); print_f64(zf(5.0,19,0.00838,0.188,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,19,0.00838,0.188,ka,fv,ke,k12,k21)); print("\n")
    print("slow N=20: zf="); print_f64(zf(5.0,20,0.00838,0.188,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,20,0.00838,0.188,ka,fv,ke,k12,k21)); print("\n")
    print("slow N=21: zf="); print_f64(zf(5.0,21,0.00838,0.188,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,21,0.00838,0.188,ka,fv,ke,k12,k21)); print("\n")
    print("slow N=22: zf="); print_f64(zf(5.0,22,0.00838,0.188,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,22,0.00838,0.188,ka,fv,ke,k12,k21)); print("\n")
    print("slow N=23: zf="); print_f64(zf(5.0,23,0.00838,0.188,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,23,0.00838,0.188,ka,fv,ke,k12,k21)); print("\n")
    print("slow N=24: zf="); print_f64(zf(5.0,24,0.00838,0.188,ka,fv,ke,k12,k21))
    print(" zc="); print_f64(zc(5.0,24,0.00838,0.188,ka,fv,ke,k12,k21)); print("\n")

    print("\n=== ind margin growth toward SS ===\n")
    print("ind N=26: mg="); print_f64(mg(34.0,26,0.05590,0.047,ka,fv,ke_ind,k12,k21)); print("\n")
    print("ind N=35: mg="); print_f64(mg(34.0,35,0.05590,0.047,ka,fv,ke_ind,k12,k21)); print("\n")
    print("ind N=45: mg="); print_f64(mg(34.0,45,0.05590,0.047,ka,fv,ke_ind,k12,k21)); print("\n")
    print("ind N=60: mg="); print_f64(mg(34.0,60,0.05590,0.047,ka,fv,ke_ind,k12,k21)); print("\n")

    print("\n=== inh floor growth — verifying floor-binding at SS ===\n")
    print("inh N=28: zf="); print_f64(zf(1.5,28,0.002236,0.282,ka,fv,ke_inh,k12,k21))
    print(" zc="); print_f64(zc(1.5,28,0.002236,0.282,ka,fv,ke_inh,k12,k21)); print("\n")
    print("inh N=45: zf="); print_f64(zf(1.5,45,0.002236,0.282,ka,fv,ke_inh,k12,k21))
    print(" zc="); print_f64(zc(1.5,45,0.002236,0.282,ka,fv,ke_inh,k12,k21)); print("\n")
    print("inh N=60: zf="); print_f64(zf(1.5,60,0.002236,0.282,ka,fv,ke_inh,k12,k21))
    print(" zc="); print_f64(zc(1.5,60,0.002236,0.282,ka,fv,ke_inh,k12,k21)); print("\n")
