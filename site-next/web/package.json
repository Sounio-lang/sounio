{
  "name": "sounio-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "evidence": "node scripts/index-evidence.mjs",
    "corpus": "node ../scripts/measure-corpus.mjs",
    "refusals": "node ../scripts/measure-refusals.mjs",
    "dose": "node ../scripts/measure-dose-scene.mjs",
    "measure": "npm run corpus && npm run refusals && npm run dose",
    "gate": "node scripts/gate-claims.mjs",
    "dev": "npm run evidence && vite",
    "build": "npm run evidence && npm run gate && tsc -b && vite build",
    "preview": "vite preview",
    "check": "npm run evidence && npm run gate && tsc -b --noEmit",
    "build:islands": "vite build --config vite.islands.config.ts",
    "build:hybrid": "npm run build:islands && cd ../swift && swift run sitegen"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
