struct MeasuredGUMI64 { value_i64: i64, confidence_permille: i64 }
struct ImputedModelI64 { value_i64: i64, confidence_permille: i64 }
struct SimulationI64 { value_i64: i64, confidence_permille: i64 }
fn measured_gum(v: i64, c: i64) -> MeasuredGUMI64 { MeasuredGUMI64 { value_i64: v, confidence_permille: c } }
fn imputed_model(v: i64, c: i64) -> ImputedModelI64 { ImputedModelI64 { value_i64: v, confidence_permille: c } }
fn simulation(v: i64, c: i64) -> SimulationI64 { SimulationI64 { value_i64: v, confidence_permille: c } }
fn payload_from_measured(k: MeasuredGUMI64) -> i64 { k.value_i64 }
fn payload_from_imputed(k: ImputedModelI64) -> i64 { k.value_i64 }
fn payload_from_simulation(k: SimulationI64) -> i64 { k.value_i64 }
fn check_confidence(c: i64, min_c: i64) -> bool { c >= min_c }
fn check_cv(value_x100: i64, std_x100: i64, max_cv_percent_x100: i64) -> bool {
    let cv_x100 = (std_x100 * 10000) / value_x100
    cv_x100 <= max_cv_percent_x100
}
fn dose_mg_x100(t: i64, cl: i64, f: i64) -> i64 { (t * cl) / f }
fn main() -> i32 with IO {
    let min_conf = 950
    print("=== PPCR dosing gate demo ===\n")
    print("Scenario 1: measured clearance (980 permille confidence)\n")
    let measured_cl = measured_gum(8000, 980)
    let cl_value = payload_from_measured(measured_cl)
    if check_confidence(measured_cl.confidence_permille, min_conf) {
        print("PASS\n")
        let d_x100 = dose_mg_x100(40000, cl_value, 100)
        print_int(d_x100 / 100)
        print(".")
        print_int(d_x100 % 100)
        print("\n")
    } else {
        print("FAIL\n")
    }
    print("Scenario 2\n")
    let simulated_cl = simulation(7500, 700)
    if check_confidence(simulated_cl.confidence_permille, min_conf) {
        print("PASS\n")
    } else {
        print("FAIL\n")
    }
    print("Scenario 3\n")
    let imputed_cl = imputed_model(7800, 960)
    let imp_value = payload_from_imputed(imputed_cl)
    let conf_ok = check_confidence(imputed_cl.confidence_permille, min_conf)
    let cv_ok = check_cv(imp_value, 2340, 2500)
    if conf_ok && cv_ok {
        print("PASS\n")
    } else {
        print("FAIL\n")
    }
    0
}
