// Compile-time provenance guard demo.
// This file intentionally uses the wrong path wrapper. It must NOT compile,
// because a simulated value cannot be consumed by a measured-only payload
// extractor. The type system rejects it before any dose is computed.

struct MeasuredGUMI64 { value_i64: i64, confidence_permille: i64 }
struct SimulationI64 { value_i64: i64, confidence_permille: i64 }

fn measured_gum(v: i64, c: i64) -> MeasuredGUMI64 {
    MeasuredGUMI64 { value_i64: v, confidence_permille: c }
}
fn simulation(v: i64, c: i64) -> SimulationI64 {
    SimulationI64 { value_i64: v, confidence_permille: c }
}

fn payload_from_measured(k: MeasuredGUMI64) -> i64 { k.value_i64 }

fn main() -> i32 with IO {
    let sim = simulation(7500, 700)
    // WRONG: a SimulationI64 is not a MeasuredGUMI64.
    let value = payload_from_measured(sim)
    print_int(value)
    print_char(10)
    0
}
