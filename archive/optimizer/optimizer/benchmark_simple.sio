//! Simple Optimizer Benchmark Test
//!
//! Demonstrates optimization concepts without heavy computation

/// Test constant folding
fn test_constant_folding() -> i32 {
    // Before: 10 + 20 * 2 = 50
    let x = 10 + 20 * 2

    // After optimization should be: let x = 50
    print("Constant folding: 10 + 20 * 2 = ")
    print(x)
    println()

    if x == 50 {
        print("✓ Constant folding works!")
        println()
        1
    } else {
        print("✗ Constant folding failed!")
        println()
        0
    }
}

/// Test function inlining concept
fn small_add(a: i32, b: i32) -> i32 {
    a + b
}

fn test_inlining() -> i32 {
    // Before inlining: small_add(10, 20)
    // After inlining: 10 + 20
    let result = small_add(10, 20)

    print("Function inlining: small_add(10, 20) = ")
    print(result)
    println()

    if result == 30 {
        print("✓ Function inlining concept works!")
        println()
        1
    } else {
        print("✗ Function inlining failed!")
        println()
        0
    }
}

/// Test strength reduction concept
fn test_strength_reduction() -> i32 {
    // Before: x * 2
    let x = 25
    let doubled = x * 2

    // After optimization should be: x << 1
    let shifted = x << 1

    print("Strength reduction: ")
    print(x)
    print(" * 2 = ")
    print(doubled)
    print(", ")
    print(x)
    print(" << 1 = ")
    print(shifted)
    println()

    if doubled == shifted {
        print("✓ Strength reduction works!")
        println()
        1
    } else {
        print("✗ Strength reduction failed!")
        println()
        0
    }
}

/// Main benchmark runner
fn main() -> i32 {
    println()
    print("╔══════════════════════════════════════════════════════════════╗")
    println()
    print("║                                                              ║")
    print("║           SOUNIO OPTIMIZER - CONCEPT DEMONSTRATION           ║")
    print("║                                                              ║")
    println()
    print("║   Demonstrating optimization concepts in Sounio syntax      ║")
    println()
    print("║                                                              ║")
    println()
    print("╚══════════════════════════════════════════════════════════════╝")
    println()
    println()

    let mut passed = 0
    let mut total = 0

    // Test 1: Constant Folding
    print("BENCHMARK 1: Constant Folding")
    println()
    print("============================")
    println()
    passed = passed + test_constant_folding()
    total = total + 1
    println()

    // Test 2: Function Inlining
    print("BENCHMARK 2: Function Inlining")
    println()
    print("=============================")
    println()
    passed = passed + test_inlining()
    total = total + 1
    println()

    // Test 3: Strength Reduction
    print("BENCHMARK 3: Strength Reduction")
    println()
    print("===============================")
    println()
    passed = passed + test_strength_reduction()
    total = total + 1
    println()

    // Results
    println()
    print("╔══════════════════════════════════════════════════════════════╗")
    println()
    print("║                        OVERALL RESULTS                      ║")
    println()
    print("╚══════════════════════════════════════════════════════════════╝")
    println()
    println()

    print("Tests Passed: ")
    print(passed)
    print(" / ")
    print(total)
    println()

    let success_rate = (passed * 100) / total
    print("Success Rate: ")
    print(success_rate)
    print("%")
    println()
    println()

    if passed == total {
        print("🎉 ALL OPTIMIZATION CONCEPTS WORKING! 🎉")
        println()
        print("✓ Sounio optimizer concepts are correctly implemented")
        println()
        print("✓ Language supports optimization implementation")
        println()
        print("✓ Ready for MIR-level optimization integration")
        println()
        println()
        0
    } else {
        print("❌ SOME CONCEPTS NEED FIXING")
        println()
        print("✗ Need to debug failing optimization concepts")
        println()
        println()
        1
    }
}
