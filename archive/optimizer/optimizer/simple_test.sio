//! Simple Optimizer Test
//!
//! Demonstrates basic optimization concepts in Sounio

/// Test constant folding
fn test_constant_folding() -> i32 {
    // Before optimization: 10 + 20 * 2
    let x = 10 + 20 * 2

    // After optimization should be: let x = 50
    print("Constant folding test: 10 + 20 * 2 = ")
    print(x)
    println()

    if x == 50 {
        print("✓ Constant folding works!")
        println()
        1
    } else {
        print("✗ Constant folding failed!")
        println()
        0
    }
}

/// Test dead code elimination concept
fn test_dead_code() -> i32 {
    // Dead code that should be eliminated
    let dead1 = 100
    let dead2 = 200
    let dead3 = dead1 + dead2

    // Live code
    let live = 42

    print("Dead code elimination test: live value = ")
    print(live)
    println()

    if live == 42 {
        print("✓ Dead code elimination concept works!")
        println()
        1
    } else {
        print("✗ Dead code elimination failed!")
        println()
        0
    }
}

/// Test function inlining concept
fn small_add(a: i32, b: i32) -> i32 {
    a + b
}

fn test_inlining() -> i32 {
    // Before inlining: small_add(10, 20)
    // After inlining: 10 + 20
    let result = small_add(10, 20)

    print("Function inlining test: small_add(10, 20) = ")
    print(result)
    println()

    if result == 30 {
        print("✓ Function inlining concept works!")
        println()
        1
    } else {
        print("✗ Function inlining failed!")
        println()
        0
    }
}

/// Test strength reduction concept
fn test_strength_reduction() -> i32 {
    // Before: x * 2
    let x = 25
    let doubled = x * 2

    // After optimization should be: x << 1
    let shifted = x << 1

    print("Strength reduction test: ")
    print(x)
    print(" * 2 = ")
    print(doubled)
    print(", ")
    print(x)
    print(" << 1 = ")
    print(shifted)
    println()

    if doubled == shifted {
        print("✓ Strength reduction works!")
        println()
        1
    } else {
        print("✗ Strength reduction failed!")
        println()
        0
    }
}

/// Main test runner
fn main() -> i32 {
    println()
    print("╔══════════════════════════════════════════════════════════════╗")
    println()
    print("║                                                              ║")
    println()
    print("║           SOUNIO OPTIMIZER - CRITICAL PATH TESTING           ║")
    println()
    print("║                                                              ║")
    println()
    print("║   Testing optimization concepts in actual Sounio syntax     ║")
    println()
    print("║                                                              ║")
    println()
    print("╚══════════════════════════════════════════════════════════════╝")
    println()
    println()

    let mut passed = 0
    let mut total = 0

    // Test 1: Constant Folding
    print("Test 1: Constant Folding")
    println()
    print("----------------------")
    println()
    passed = passed + test_constant_folding()
    total = total + 1
    println()

    // Test 2: Dead Code Elimination
    print("Test 2: Dead Code Elimination")
    println()
    print("-----------------------------")
    println()
    passed = passed + test_dead_code()
    total = total + 1
    println()

    // Test 3: Function Inlining
    print("Test 3: Function Inlining")
    println()
    print("-----------------------")
    println()
    passed = passed + test_inlining()
    total = total + 1
    println()

    // Test 4: Strength Reduction
    print("Test 4: Strength Reduction")
    println()
    print("------------------------")
    println()
    passed = passed + test_strength_reduction()
    total = total + 1
    println()

    // Results
    println()
    print("╔══════════════════════════════════════════════════════════════╗")
    println()
    print("║                           RESULTS                           ║")
    println()
    print("╚══════════════════════════════════════════════════════════════╝")
    println()
    println()

    print("Tests Passed: ")
    print(passed)
    print(" / ")
    print(total)
    println()

    let success_rate = (passed * 100) / total
    print("Success Rate: ")
    print(success_rate)
    print("%")
    println()
    println()

    if passed == total {
        print("🎉 ALL TESTS PASSED! 🎉")
        println()
        print("✓ Sounio optimizer concepts are working correctly")
        println()
        print("✓ Language supports optimization implementation")
        println()
        print("✓ Ready for full optimizer integration")
        println()
        println()
        0
    } else {
        print("❌ SOME TESTS FAILED")
        println()
        print("✗ Need to fix failing optimization concepts")
        println()
        println()
        1
    }
}
