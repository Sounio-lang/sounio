//! Dead Code Elimination Pass
//!
//! Removes instructions that have no uses
//! This eliminates dead code and unreachable blocks

/// Value identifier
struct ValueId(usize);

/// Block identifier
struct BlockId(usize);

/// MIR Instruction (simplified for DCE)
enum MirInstruction {
    Binary {
        result: ValueId,
        op: BinaryOp,
        left: ValueId,
        right: ValueId,
    },
    Unary {
        result: ValueId,
        op: UnaryOp,
        operand: ValueId,
    },
    Const {
        result: ValueId,
        value: i64,
    },
    Load {
        result: ValueId,
        address: ValueId,
    },
    Store {
        address: ValueId,
        value: ValueId,
    },
    Call {
        result: Option<ValueId>,
        func_name: String,
        args: Vec<ValueId>,
    },
    Phi {
        result: ValueId,
        incoming: Vec<(BlockId, ValueId)>,
    },
}

/// Binary operations
enum BinaryOp {
    Add, Sub, Mul, Div, Rem,
    And, Or, Xor,
    Shl, LShr, AShr,
}

/// Unary operations
enum UnaryOp {
    Neg, Not, BitNot,
}

/// Basic block
struct BasicBlock {
    id: BlockId,
    instructions: Vec<MirInstruction>,
    predecessors: Vec<BlockId>,
    successors: Vec<BlockId>,
}

/// Function
struct Function {
    blocks: Vec<BasicBlock>,
    entry_block: BlockId,
}

/// Get result value from instruction
fn get_result(instr: MirInstruction) -> Option<ValueId> {
    match instr {
        MirInstruction::Binary { result, .. } => Some(result),
        MirInstruction::Unary { result, .. } => Some(result),
        MirInstruction::Const { result, .. } => Some(result),
        MirInstruction::Load { result, .. } => Some(result),
        MirInstruction::Phi { result, .. } => Some(result),
        _ => None,
    }
}

/// Get values used by an instruction
fn get_used_values(instr: MirInstruction) -> Vec<ValueId> {
    match instr {
        MirInstruction::Binary { left, right, .. } => vec![left, right],
        MirInstruction::Unary { operand, .. } => vec![operand],
        MirInstruction::Load { address, .. } => vec![address],
        MirInstruction::Store { address, value } => vec![address, value],
        MirInstruction::Call { args, .. } => args,
        MirInstruction::Phi { incoming, .. } => {
            incoming.iter().map(|(_, v)| *v).collect()
        }
        _ => vec![],
    }
}

/// Build use-def chains for a function
fn build_use_def(func: Function) -> HashMap<ValueId, Vec<ValueId>> {
    let mut uses: HashMap<ValueId, Vec<ValueId>> = HashMap::new()
    
    for block in func.blocks {
        for instr in block.instructions {
            // Track uses
            for used in get_used_values(instr) {
                if !uses.contains_key(&used) {
                    uses.insert(used, Vec::new())
                }
                uses.get_mut(&used).push(get_result(instr).unwrap_or(ValueId(999)))
            }
        }
    }
    
    uses
}

/// Find live values using reverse post-order traversal
fn find_live_values(func: Function) -> HashSet<ValueId> {
    let mut live: HashSet<ValueId> = HashSet::new()
    let mut visited: HashSet<BlockId> = HashSet::new()
    
    // Start from exit blocks (blocks with no successors)
    let exit_blocks: Vec<BlockId> = func.blocks.iter()
        .filter(|b| b.successors.is_empty())
        .map(|b| b.id)
        .collect();
    
    println("Found exit blocks: ")
    print(exit_blocks.len())
    println()
    
    for exit_block in exit_blocks {
        mark_live_values(exit_block, &mut live, &mut visited, func)
    }
    
    live
}

/// Mark values as live recursively
fn mark_live_values(
    block_id: BlockId,
    live: &mut HashSet<ValueId>,
    visited: &mut HashSet<BlockId>,
    func: Function
) {
    if visited.contains(&block_id) {
        return
    }
    visited.insert(block_id)
    
    let block = func.blocks.iter()
        .find(|b| b.id == block_id)
        .expect("Block not found")
    
    // Mark used values as live
    for instr in block.instructions.iter().rev() {
        for used in get_used_values(instr.clone()) {
            live.insert(used)
        }
        
        // If this instruction produces a value that's not live,
        // it's dead (we'll remove it later)
    }
    
    // Recurse to predecessors
    for pred in block.predecessors {
        mark_live_values(pred, live, visited, func)
    }
}

/// Remove dead instructions from a block
fn remove_dead_instructions(
    block: BasicBlock,
    live: HashSet<ValueId>
) -> BasicBlock {
    let mut new_block = block.clone()
    let original_count = new_block.instructions.len()
    
    new_block.instructions.retain(|instr| {
        if let Some(result) = get_result(instr) {
            // Keep if result is live or instruction has side effects
            live.contains(&result) || has_side_effects(&instr)
        } else {
            // Keep instructions without results (stores, etc.)
            true
        }
    })
    
    let removed = original_count - new_block.instructions.len()
    if removed > 0 {
        println("Block ")
        print(block.id.0)
        print(": removed ")
        print(removed)
        println(" dead instructions")
    }
    
    new_block
}

/// Check if instruction has side effects
fn has_side_effects(instr: MirInstruction) -> bool {
    match instr {
        MirInstruction::Store { .. } => true,
        MirInstruction::Call { .. } => true,
        _ => false,
    }
}

/// Find and remove unreachable blocks
fn remove_unreachable_blocks(func: Function) -> Function {
    let mut reachable: HashSet<BlockId> = HashSet::new()
    let mut worklist: Vec<BlockId> = vec![func.entry_block]
    
    // Find all reachable blocks via DFS
    while !worklist.is_empty() {
        let block_id = worklist.pop().unwrap()
        
        if reachable.contains(&block_id) {
            continue
        }
        
        reachable.insert(block_id)
        
        let block = func.blocks.iter()
            .find(|b| b.id == block_id)
            .expect("Block not found")
        
        for succ in block.successors {
            if !reachable.contains(&succ) {
                worklist.push(succ)
            }
        }
    }
    
    // Remove unreachable blocks
    let mut new_func = func.clone()
    let original_count = new_func.blocks.len()
    
    new_func.blocks.retain(|block| {
        let is_reachable = reachable.contains(&block.id)
        if !is_reachable {
            println("Removed unreachable block: ")
            print(block.id.0)
        }
        is_reachable
    })
    
    let removed = original_count - new_func.blocks.len()
    if removed > 0 {
        println("Removed ")
        print(removed)
        println(" unreachable blocks")
    }
    
    new_func
}

/// Dead code elimination pass
fn dead_code_elimination(func: Function) -> Function {
    println("Running Dead Code Elimination")
    println("==============================")
    
    // Step 1: Remove unreachable blocks
    let mut func = remove_unreachable_blocks(func)
    
    // Step 2: Find live values
    let live = find_live_values(func)
    
    println("Found ")
    print(live.len())
    println(" live values")
    println()
    
    // Step 3: Remove dead instructions
    let mut total_removed = 0
    func.blocks = func.blocks.iter()
        .map(|block| {
            let new_block = remove_dead_instructions(block.clone(), live)
            total_removed += block.instructions.len() - new_block.instructions.len()
            new_block
        })
        .collect()
    
    println()
    println("Total dead instructions removed: ")
    print(total_removed)
    println()
    
    func
}

/// Test function with dead code
fn test_dead_code() -> i32 {
    println("Testing Dead Code Elimination")
    println("=================================")
    println()
    
    // Create a function with dead code
    let func = Function {
        blocks: vec![
            BasicBlock {
                id: BlockId(0),
                instructions: vec![
                    MirInstruction::Const {
                        result: ValueId(0),
                        value: 42,
                    },
                    MirInstruction::Const {
                        result: ValueId(1),
                        value: 100, // This is dead - never used
                    },
                    MirInstruction::Const {
                        result: ValueId(2),
                        value: 200, // This is also dead
                    },
                    MirInstruction::Binary {
                        result: ValueId(3),
                        op: BinaryOp::Add,
                        left: ValueId(0),
                        right: ValueId(1), // Dead result
                    },
                    MirInstruction::Binary {
                        result: ValueId(4),
                        op: BinaryOp::Mul,
                        left: ValueId(2),
                        right: ValueId(2), // Dead result
                    },
                    MirInstruction::Binary {
                        result: ValueId(5),
                        op: BinaryOp::Add,
                        left: ValueId(0),
                        right: ValueId(0), // Live result: 42 + 42 = 84
                    },
                ],
                predecessors: vec![],
                successors: vec![BlockId(1)],
            },
            BasicBlock {
                id: BlockId(1),
                instructions: vec![
                    MirInstruction::Const {
                        result: ValueId(10),
                        value: 1,
                    },
                    MirInstruction::Binary {
                        result: ValueId(11),
                        op: BinaryOp::Add,
                        left: ValueId(5),
                        right: ValueId(10), // Live result: 84 + 1 = 85
                    },
                    MirInstruction::Store {
                        address: ValueId(20),
                        value: ValueId(11), // Store is live (side effect)
                    },
                ],
                predecessors: vec![BlockId(0)],
                successors: vec![],
            },
        ],
        entry_block: BlockId(0),
    };
    
    println("Before DCE:")
    println("-----------")
    for block in func.blocks {
        println("Block ")
        print(block.id.0)
        println(": ")
        print(block.instructions.len())
        println(" instructions")
    }
    println()
    
    // Run DCE
    let optimized = dead_code_elimination(func)
    
    println("After DCE:")
    println("----------")
    for block in optimized.blocks {
        println("Block ")
        print(block.id.0)
        println(": ")
        print(block.instructions.len())
        println(" instructions")
    }
    println()
    
    0
}

/// Test with unreachable code
fn test_unreachable_code() -> i32 {
    println("Testing Unreachable Code Removal")
    println("=================================")
    println()
    
    let func = Function {
        blocks: vec![
            BasicBlock {
                id: BlockId(0),
                instructions: vec![
                    MirInstruction::Const {
                        result: ValueId(0),
                        value: 1,
                    },
                ],
                predecessors: vec![],
                successors: vec![BlockId(1), BlockId(2)],
            },
            BasicBlock {
                id: BlockId(1),
                instructions: vec![
                    MirInstruction::Const {
                        result: ValueId(1),
                        value: 2,
                    },
                    MirInstruction::Binary {
                        result: ValueId(2),
                        op: BinaryOp::Add,
                        left: ValueId(0),
                        right: ValueId(1),
                    },
                ],
                predecessors: vec![BlockId(0)],
                successors: vec![],
            },
            BasicBlock {
                id: BlockId(2),
                instructions: vec![
                    MirInstruction::Const {
                        result: ValueId(3),
                        value: 3,
                    },
                    MirInstruction::Binary {
                        result: ValueId(4),
                        op: BinaryOp::Add,
                        left: ValueId(0),
                        right: ValueId(3),
                    },
                ],
                predecessors: vec![BlockId(0)],
                successors: vec![],
            },
        ],
        entry_block: BlockId(0),
    };
    
    println("Before DCE:")
    println("-----------")
    println("Blocks: ")
    print(func.blocks.len())
    println()
    
    // Run DCE (should remove one unreachable block)
    let optimized = dead_code_elimination(func)
    
    println("After DCE:")
    println("----------")
    println("Blocks: ")
    print(optimized.blocks.len())
    println()
    
    0
}

/// Main entry point
fn main() -> i32 {
    println("Sounio Dead Code Elimination")
    println("================================")
    println()
    
    test_dead_code()
    println()
    test_unreachable_code()
    
    println()
    println("All DCE tests complete!")
    
    0
}
