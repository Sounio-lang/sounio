use lexer::mod::{
    sourcefile_trace_enable,
    sourcefile_probe_path_first_byte,
    sourcefile_probe_path_count,
    sourcefile_probe_write_local,
    sourcefile_probe_write_global,
    sourcefile_probe_read_call_only,
    sourcefile_probe_read_return_len,
    sourcefile_probe_read_first_byte,
}

var L2_LOCAL_SCRATCH: [i8; 512] = [0; 512]
var L2_LOCAL_SCRATCH_LEN: i64 = 0

fn local_path_first_byte(path: string) -> i64 with IO, Mut, Panic, Div {
    print("stage=helper_enter\n")
    let first = str_char_at(path, 0)
    L2_LOCAL_SCRATCH[0] = first as i8
    L2_LOCAL_SCRATCH_LEN = 1
    print("stage=path_read_ok\n")
    1
}

fn local_path_count(path: string) -> i64 with IO, Mut, Panic, Div {
    print("stage=helper_enter\n")
    var n = str_len(path)
    if n < 0 { n = 0 }
    var i: i64 = 0
    while i < n {
        let keep = str_char_at(path, i)
        i = i + 1
    }
    L2_LOCAL_SCRATCH_LEN = n
    print("stage=path_read_ok\n")
    1
}

fn local_write_local(path: string) -> i64 with IO, Mut, Panic, Div {
    let keep = path
    print("stage=helper_enter\n")
    var ch: i8 = 65
    ch = ch
    print("stage=buffer_write_ok\n")
    ch as i64
}

fn local_write_global(path: string) -> i64 with IO, Mut, Panic, Div {
    let keep = path
    print("stage=helper_enter\n")
    L2_LOCAL_SCRATCH[0] = 66
    L2_LOCAL_SCRATCH_LEN = 1
    print("stage=buffer_write_ok\n")
    1
}

fn local_read_call_only(path: string) -> i64 with IO, Mut, Panic, Div {
    print("stage=helper_enter\n")
    let raw = read_file(path)
    let keep = raw
    print("stage=read_file_call_ok\n")
    1
}

fn local_read_return_len(path: string) -> i64 with IO, Mut, Panic, Div {
    print("stage=helper_enter\n")
    let raw = read_file(path)
    let keep = raw
    print("stage=read_file_call_ok\n")
    let n = file_size(path)
    print("stage=read_file_ret_ok\n")
    n
}

fn local_read_first_byte(path: string) -> i64 with IO, Mut, Panic, Div {
    print("stage=helper_enter\n")
    let raw = read_file(path)
    print("stage=read_file_call_ok\n")
    L2_LOCAL_SCRATCH[0] = raw[0]
    L2_LOCAL_SCRATCH_LEN = 1
    print("stage=read_file_ret_ok\n")
    1
}

fn run_mode(mode: string, path: string) -> i64 with IO, Mut, Panic, Div {
    let code = str_char_at(mode, 0)
    if code == 65 { return sourcefile_probe_path_first_byte(path) } // A
    if code == 97 { return local_path_first_byte(path) }            // a
    if code == 66 { return sourcefile_probe_path_count(path) }      // B
    if code == 98 { return local_path_count(path) }                 // b
    if code == 67 { return sourcefile_probe_write_local(path) }     // C
    if code == 99 { return local_write_local(path) }                // c
    if code == 68 { return sourcefile_probe_write_global(path) }    // D
    if code == 100 { return local_write_global(path) }              // d
    if code == 69 { return sourcefile_probe_read_call_only(path) }  // E
    if code == 101 { return local_read_call_only(path) }            // e
    if code == 70 { return sourcefile_probe_read_return_len(path) } // F
    if code == 102 { return local_read_return_len(path) }           // f
    if code == 71 { return sourcefile_probe_read_first_byte(path) } // G
    if code == 103 { return local_read_first_byte(path) }           // g
    print("unknown_mode\n")
    0 - 1
}

fn main() -> i64 with IO, Mut, Panic, Div {
    print("stage=startup_ok\n")
    let argc = arg_count()
    if argc < 2 {
        print("usage: l2_sourcefile_entry_probe <mode> <path>\n")
        return 2
    }
    print("stage=args_ok\n")
    let mode = get_arg(0)
    let path = get_arg(1)
    sourcefile_trace_enable()
    let rc = run_mode(mode, path)
    if rc < 0 {
        return 3
    }
    print("stage=finalize_ok\n")
    return 0
}
