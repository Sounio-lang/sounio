use lexer::mod::*

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    var source_path = "scripts/ci/ontology_min_input.sio"
    if argc >= 1 {
        source_path = get_arg(0)
    }

    print("stage=size=")
    print_int(file_size(source_path))
    print("\n")

    print("stage=token_count=")
    print_int(lex_file_token_count(source_path))
    print("\n")
    return 0
}
