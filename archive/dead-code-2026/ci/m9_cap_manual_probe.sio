fn is_digit_local(ch: i64) -> bool {
    ch >= 48 && ch <= 57
}

fn str_eq_local(a: string, b: string) -> bool with Mut, Panic, Div {
    let a_len = str_len(a)
    let b_len = str_len(b)
    if a_len != b_len { return false }
    var i: i64 = 0
    while i < a_len {
        if (str_char_at(a, i) as i64) != (str_char_at(b, i) as i64) {
            return false
        }
        i = i + 1
    }
    true
}

fn parse_decimal_string_local(s: string) -> i64 with Mut, Panic, Div {
    let len = str_len(s)
    if len <= 0 { return -1 }
    var value: i64 = 0
    var i: i64 = 0
    while i < len {
        let ch = str_char_at(s, i) as i64
        if !is_digit_local(ch) { return -1 }
        value = value * 10 + (ch - 48)
        i = i + 1
    }
    value
}

fn main() -> i64 with IO, Mut, Panic, Div {
    let argc = arg_count()
    print("manual_argc=")
    print_int(argc)
    print("\n")
    if argc < 4 { return 1 }

    let flag = get_arg(2)
    print("manual_flag_ok=")
    if str_eq_local(flag, "--src-cap-bytes") {
        print_int(1)
    } else {
        print_int(0)
    }
    print("\n")

    let parsed = parse_decimal_string_local(get_arg(3))
    print("manual_cap=")
    print_int(parsed)
    print("\n")
    0
}
