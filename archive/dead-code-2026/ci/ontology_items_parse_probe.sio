use parser::ast::{ItemList}
use parser::mod::{parse_items_preloaded}
use parser::parser::{parser_last_error_count}
use lexer::mod::*

fn load_items_file_boot4_safe(path: string) -> Option<Box<ItemList>> with IO, Mut, Panic, Div, Alloc {
    lex_file_parse_items(path)
}

fn count_loaded_items(items: Option<Box<ItemList>>) -> i64 with Mut, Panic, Div, Alloc {
    match items {
        Some(list) => 1 + count_loaded_items((*list).tail)
        None => 0
    }
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    var source_path = "scripts/ci/ontology_min_input.sio"
    if argc >= 1 {
        source_path = get_arg(0)
    }

    print("stage=before_load\n")
    let items = load_items_file_boot4_safe(source_path)
    print("stage=after_load\n")

    if parser_last_error_count() > 0 {
        print("stage=parse_error\n")
        return 2
    }

    print("stage=item_count=")
    print_int(count_loaded_items(items))
    print("\n")
    return 0
}
