use check::mod::{
    check_witness_unknown,
    check_witness_mark_load_ok,
    check_witness_mark_parse_ok,
    check_witness_has_load_ok,
    check_witness_has_parse_ok,
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    var imported = check_witness_unknown()
    print("imported_seed=")
    print_int(imported)
    print("\n")

    imported = check_witness_mark_load_ok(imported)
    imported = check_witness_mark_parse_ok(imported)
    print("imported_after_marks=")
    print_int(imported)
    print("\n")

    print("imported_load=")
    if check_witness_has_load_ok(imported) { print("1\n") } else { print("0\n") }
    print("imported_parse=")
    if check_witness_has_parse_ok(imported) { print("1\n") } else { print("0\n") }

    var local = 2
    local = local + 16
    local = local + 32
    print("local_after_marks=")
    print_int(local)
    print("\n")
    print("local_load=")
    print_int((local / 16) % 2)
    print("\n")
    print("local_parse=")
    print_int((local / 32) % 2)
    print("\n")

    0
}
