use lexer::mod::*
use lexer::errors::*

fn lex_probe_error_name(kind: LexErrorKind) -> string {
    if kind == LexErrorKind::UnexpectedChar { return "UnexpectedChar" }
    if kind == LexErrorKind::UnterminatedString { return "UnterminatedString" }
    if kind == LexErrorKind::UnterminatedBlockComment { return "UnterminatedBlockComment" }
    if kind == LexErrorKind::InvalidEscape { return "InvalidEscape" }
    if kind == LexErrorKind::InvalidNumber { return "InvalidNumber" }
    if kind == LexErrorKind::NumberOverflow { return "NumberOverflow" }
    if kind == LexErrorKind::UnterminatedChar { return "UnterminatedChar" }
    if kind == LexErrorKind::EmptyCharLiteral { return "EmptyCharLiteral" }
    "None"
}

fn load_source_bytes(path: string) -> ([i8; 1048576], i64) with IO, Mut, Panic, Div {
    let data = read_file(path)
    let size = file_size(path)
    var buf: [i8; 1048576] = [0; 1048576]
    var i: i64 = 0
    while i < size && i < 1048576 {
        buf[i as usize] = data[i as usize]
        i = i + 1
    }
    (buf, size)
}

fn main() -> i64 with IO, Mut, Panic, Div {
    let path = get_arg(0)
    let pair = load_source_bytes(path)
    let state = lex(pair.0, pair.1, 0)
    print("lex_probe: tokens=")
    print_int(state.token_count)
    print(" errors=")
    print_int(state.error_count)
    print("\n")
    var i: i64 = 0
    while i < state.error_count && i < 8 {
        let err = state.errors[i as usize]
        print("lex_probe: err line=")
        print_int(err.line)
        print(" col=")
        print_int(err.col)
        print(" pos=")
        print_int(err.pos)
        print(" kind=")
        print(lex_probe_error_name(err.kind))
        print(" ch=")
        print_int(err.context_char as i64)
        print("\n")
        i = i + 1
    }
    0
}
