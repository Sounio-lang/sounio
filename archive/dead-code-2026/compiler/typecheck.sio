// ERROR LIST
// ============================================================================

struct ErrorList {
    items: [string; 128],
    len: i64,
}

fn error_list_new() -> ErrorList {
    ErrorList {
        items: ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        len: 0,
    }
}

fn error_list_push(lst: ErrorList, s: string) -> ErrorList {
    var out = lst
    if out.len < 128 {
        out.items[out.len as usize] = s
        out.len = out.len + 1
