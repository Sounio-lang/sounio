}

// Arena child accessor stub: children are i64 indices
fn expr_child(expr: Expr, i: i64) -> Expr {
    expr_default()
}

// ============================================================================
// FIXED-ARRAY MAP: string -> (Type, bool)   [for vars]
// ============================================================================

struct VarEntry {
    key: string,
    ty: Type,
    mutable: bool,
    occupied: bool,
}

struct VarMap {
    items: [VarEntry; 256],
    len: i64,
}

fn empty_var_entry() -> VarEntry {
    VarEntry { key: "", ty: type_error(), mutable: false, occupied: false }
}

fn var_map_new() -> VarMap {
    VarMap {
        items: [empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry(), empty_var_entry()],
        len: 0,
    }
}

fn var_map_contains(m: VarMap, key: string) -> bool {
    var i: i64 = 0
    while i < m.len {
        if m.items[i as usize].occupied {
            if m.items[i as usize].key == key {
                return true
            }
        }
        i = i + 1
    }
    false
}

fn var_map_get_ty(m: VarMap, key: string) -> Type {
    var i: i64 = 0
    while i < m.len {
        if m.items[i as usize].occupied {
            if m.items[i as usize].key == key {
                return m.items[i as usize].ty
            }
        }
        i = i + 1
    }
    type_error()
}

fn var_map_get_mut(m: VarMap, key: string) -> bool {
    var i: i64 = 0
    while i < m.len {
        if m.items[i as usize].occupied {
            if m.items[i as usize].key == key {
                return m.items[i as usize].mutable
            }
        }
        i = i + 1
    }
    false
}

fn var_map_insert(m: VarMap, key: string, ty: Type, mutable: bool) -> VarMap {
    var out = m
    var i: i64 = 0
    while i < out.len {
        if out.items[i as usize].occupied {
            if out.items[i as usize].key == key {
                out.items[i as usize].ty = ty
                out.items[i as usize].mutable = mutable
                return out
            }
        }
        i = i + 1
    }
    if out.len < 256 {
        out.items[out.len as usize] = VarEntry { key: key, ty: ty, mutable: mutable, occupied: true }
        out.len = out.len + 1
    }
    out
}

// ============================================================================
// FIXED-ARRAY MAP: string -> Type   [for type_defs, func_sigs]
// ============================================================================

struct TypeEntry {
    key: string,
    ty: Type,
    occupied: bool,
}

struct TypeMap {
    items: [TypeEntry; 128],
    len: i64,
}

fn empty_type_entry() -> TypeEntry {
    TypeEntry { key: "", ty: type_error(), occupied: false }
}

fn type_map_new() -> TypeMap {
    TypeMap {
        items: [empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry(), empty_type_entry()],
        len: 0,
    }
}

fn type_map_contains(m: TypeMap, key: string) -> bool {
    var i: i64 = 0
    while i < m.len {
        if m.items[i as usize].occupied {
            if m.items[i as usize].key == key {
                return true
            }
        }
        i = i + 1
    }
    false
}

fn type_map_get(m: TypeMap, key: string) -> Type {
    var i: i64 = 0
    while i < m.len {
        if m.items[i as usize].occupied {
            if m.items[i as usize].key == key {
                return m.items[i as usize].ty
            }
        }
        i = i + 1
    }
    type_error()
}

fn type_map_insert(m: TypeMap, key: string, ty: Type) -> TypeMap {
    var out = m
    var i: i64 = 0
    while i < out.len {
        if out.items[i as usize].occupied {
            if out.items[i as usize].key == key {
                out.items[i as usize].ty = ty
                return out
            }
        }
        i = i + 1
    }
    if out.len < 128 {
        out.items[out.len as usize] = TypeEntry { key: key, ty: ty, occupied: true }
        out.len = out.len + 1
    }
    out
}

// ============================================================================
// BUILTIN TYPES
// ============================================================================

fn make_builtin_types() -> TypeMap {
    var m = type_map_new()
    m = type_map_insert(m, "i64", type_int())
    m = type_map_insert(m, "f64", type_float())
    m = type_map_insert(m, "string", type_string_ty())
    m = type_map_insert(m, "bool", type_bool())
    m = type_map_insert(m, "()", type_unit())
    m
}

// ============================================================================
// TYPE INFERENCE CONTEXT
// ============================================================================

struct TypeContext {
    vars: VarMap,
    type_defs: TypeMap,
    func_sigs: TypeMap,
    next_var_id: i64,
    errors: ErrorList,
}

struct TypeResult {
    ty: Type,
    effects: EffectList,
}

// ============================================================================
// CONTEXT OPERATIONS
// ============================================================================

fn context_new() -> TypeContext {
    TypeContext {
        vars: var_map_new(),
        type_defs: make_builtin_types(),
        func_sigs: type_map_new(),
        next_var_id: 0,
        errors: error_list_new(),
    }
}

fn context_child(parent: TypeContext) -> TypeContext {
    TypeContext {
        vars: var_map_new(),
        type_defs: parent.type_defs,
        func_sigs: parent.func_sigs,
        next_var_id: parent.next_var_id,
        errors: parent.errors,
    }
}

fn bind_var(ctx: TypeContext, name: string, ty: Type, mutable: bool) -> TypeContext {
    TypeContext {
        vars: var_map_insert(ctx.vars, name, ty, mutable),
        type_defs: ctx.type_defs,
        func_sigs: ctx.func_sigs,
        next_var_id: ctx.next_var_id,
        errors: ctx.errors,
    }
}

fn bind_func_sig(ctx: TypeContext, name: string, sig: Type) -> TypeContext {
    TypeContext {
        vars: ctx.vars,
        type_defs: ctx.type_defs,
        func_sigs: type_map_insert(ctx.func_sigs, name, sig),
        next_var_id: ctx.next_var_id,
        errors: ctx.errors,
    }
}

fn add_error(ctx: TypeContext, msg: string) -> TypeContext {
    TypeContext {
        vars: ctx.vars,
        type_defs: ctx.type_defs,
        func_sigs: ctx.func_sigs,
        next_var_id: ctx.next_var_id,
        errors: error_list_push(ctx.errors, msg),
    }
}

// ============================================================================
// TYPE INFERENCE — single monolithic function to avoid forward refs
// ============================================================================

fn tc_infer(ctx: TypeContext, expr: Expr) -> (TypeContext, TypeResult) with Mut, Panic, Div {
    match expr.kind {
        ExprKind::IntLit => {
            (ctx, TypeResult { ty: type_int(), effects: effect_list_new() })
        }
        ExprKind::FloatLit => {
            (ctx, TypeResult { ty: type_float(), effects: effect_list_new() })
        }
        ExprKind::StringLit => {
            if ontology_is_supported_prefix(expr.value) && !ontology_curie_literal_valid(expr.value) {
                let next_ctx = add_error(ctx, "Malformed ontology CURIE literal: " + expr.value)
                (next_ctx, TypeResult { ty: type_string_ty(), effects: effect_list_new() })
            } else {
                (ctx, TypeResult { ty: type_string_ty(), effects: effect_list_new() })
            }
        }
        ExprKind::BoolLit => {
            (ctx, TypeResult { ty: type_bool(), effects: effect_list_new() })
        }
        ExprKind::UnitLit => {
            (ctx, TypeResult { ty: type_unit(), effects: effect_list_new() })
        }

        ExprKind::VarRef => {
            if var_map_contains(ctx.vars, expr.value) {
                let ty = var_map_get_ty(ctx.vars, expr.value)
                (ctx, TypeResult { ty: ty, effects: effect_list_new() })
            } else {
                let new_ctx = add_error(ctx, "Unbound variable: " + expr.value)
                (new_ctx, TypeResult { ty: type_error(), effects: effect_list_new() })
            }
        }

        ExprKind::Binary => {
            let left_expr = expr_child(expr, 0)
            let right_expr = expr_child(expr, 1)
            let (ctx1, left_res) = tc_infer(ctx, left_expr)
            let (ctx2, right_res) = tc_infer(ctx1, right_expr)
            let left_ty = left_res.ty
            let right_ty = right_res.ty
            let effects = combine_effects(left_res.effects, right_res.effects)
            let op = expr.value
            if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
                if !is_numeric(left_ty) {
                    let nc = add_error(ctx2, "Left operand must be numeric")
                    return (nc, TypeResult { ty: type_error(), effects: effects })
                }
                if !is_numeric(right_ty) {
                    let nc = add_error(ctx2, "Right operand must be numeric")
                    return (nc, TypeResult { ty: type_error(), effects: effects })
                }
                let result_ty = if left_ty.kind == TypeKind::TFloat || right_ty.kind == TypeKind::TFloat {
                    type_float()
                } else {
                    type_int()
                }
                var final_effects = effects
                if op == "/" || op == "%" {
                    final_effects = effect_list_push(final_effects, effect_div())
                }
                (ctx2, TypeResult { ty: result_ty, effects: final_effects })
            } else if op == "==" || op == "!=" {
                if !types_equal(left_ty, right_ty) {
                    let nc = add_error(ctx2, "Cannot compare different types")
                    return (nc, TypeResult { ty: type_error(), effects: effects })
                }
                if !is_comparable(left_ty) {
                    let nc = add_error(ctx2, "Type is not comparable")
                    return (nc, TypeResult { ty: type_error(), effects: effects })
                }
                (ctx2, TypeResult { ty: type_bool(), effects: effects })
            } else if op == "<" || op == "<=" || op == ">" || op == ">=" {
                if !is_comparable(left_ty) || !is_comparable(right_ty) {
                    let nc = add_error(ctx2, "Type is not ordered")
                    return (nc, TypeResult { ty: type_error(), effects: effects })
                }
                (ctx2, TypeResult { ty: type_bool(), effects: effects })
            } else if op == "&&" || op == "||" {
                if left_ty.kind != TypeKind::TBool {
                    let nc = add_error(ctx2, "Left operand must be bool")
                    return (nc, TypeResult { ty: type_error(), effects: effects })
                }
                if right_ty.kind != TypeKind::TBool {
                    let nc = add_error(ctx2, "Right operand must be bool")
                    return (nc, TypeResult { ty: type_error(), effects: effects })
                }
                (ctx2, TypeResult { ty: type_bool(), effects: effects })
            } else {
                let nc = add_error(ctx2, "Unknown binary operator: " + op)
                (nc, TypeResult { ty: type_error(), effects: effects })
            }
        }

        ExprKind::Unary => {
            let operand_expr = expr_child(expr, 0)
            let (ctx1, operand_res) = tc_infer(ctx, operand_expr)
            let operand_ty = operand_res.ty
            let op = expr.value
            if op == "-" {
                if !is_numeric(operand_ty) {
                    let nc = add_error(ctx1, "Unary minus requires numeric operand")
                    (nc, TypeResult { ty: type_error(), effects: operand_res.effects })
                } else {
                    (ctx1, operand_res)
                }
            } else if op == "!" {
                if operand_ty.kind != TypeKind::TBool {
                    let nc = add_error(ctx1, "Not operator requires bool operand")
                    (nc, TypeResult { ty: type_error(), effects: operand_res.effects })
                } else {
                    (ctx1, operand_res)
                }
            } else {
                let nc = add_error(ctx1, "Unknown unary operator: " + op)
                (nc, TypeResult { ty: type_error(), effects: operand_res.effects })
            }
        }

        ExprKind::Call => {
            let callee_expr = expr_child(expr, 0)
            var arg_types = type_list_new()
            var all_effects = effect_list_new()
            var i: i64 = 1
            var current_ctx = ctx
            while i < expr.children_len {
                let arg_expr = expr_child(expr, i)
                let (ctx1, arg_res) = tc_infer(current_ctx, arg_expr)
                arg_types = type_list_push(arg_types, arg_res.ty)
                all_effects = combine_effects(all_effects, arg_res.effects)
                current_ctx = ctx1
                i = i + 1
            }
            let (ctx2, callee_res) = tc_infer(current_ctx, callee_expr)
            let callee_ty = callee_res.ty
            all_effects = combine_effects(all_effects, callee_res.effects)
            match callee_ty.kind {
                TypeKind::TFunction => {
                    if callee_ty.args_len != arg_types.len {
                        let nc = add_error(ctx2,
                            "Argument count mismatch: expected " +
                            int_to_string(callee_ty.args_len) +
                            ", got " + int_to_string(arg_types.len))
                        return (nc, TypeResult { ty: type_error(), effects: all_effects })
                    }
                    var k: i64 = 0
                    while k < callee_ty.effects_len {
                        all_effects = effect_list_push(all_effects, callee_ty.effects[k as usize])
                        k = k + 1
                    }
                    (ctx2, TypeResult { ty: callee_ty, effects: all_effects })
                }
                _ => {
                    let nc = add_error(ctx2, "Callee is not a function")
                    (nc, TypeResult { ty: type_error(), effects: all_effects })
                }
            }
        }

        ExprKind::FieldAccess => {
            let obj_expr = expr_child(expr, 0)
            let (ctx1, obj_res) = tc_infer(ctx, obj_expr)
            let obj_ty = obj_res.ty
            let field_name = expr.value
            match obj_ty.kind {
                TypeKind::TStruct => {
                    var i: i64 = 0
                    var found_ty = type_error()
                    var found = false
                    while i < obj_ty.fields_len {
                        let field = obj_ty.fields[i as usize]
                        if field.name == field_name {
                            found_ty = make_type(field.kind, field.name)
                            found = true
                        }
                        i = i + 1
                    }
                    if found {
                        (ctx1, TypeResult { ty: found_ty, effects: obj_res.effects })
                    } else {
                        let nc = add_error(ctx1, "Unknown field: " + field_name)
                        (nc, TypeResult { ty: type_error(), effects: obj_res.effects })
                    }
                }
                _ => {
                    let nc = add_error(ctx1, "Cannot access field on non-struct type")
                    (nc, TypeResult { ty: type_error(), effects: obj_res.effects })
                }
            }
        }

        ExprKind::Index => {
            let arr_expr = expr_child(expr, 0)
            let idx_expr = expr_child(expr, 1)
            let (ctx1, arr_res) = tc_infer(ctx, arr_expr)
            let (ctx2, idx_res) = tc_infer(ctx1, idx_expr)
            let arr_ty = arr_res.ty
            let idx_ty = idx_res.ty
            var effects = combine_effects(arr_res.effects, idx_res.effects)
            if idx_ty.kind != TypeKind::TInt {
                let nc = add_error(ctx2, "Array index must be integer")
                return (nc, TypeResult { ty: type_error(), effects: effects })
            }
            if arr_ty.kind == TypeKind::TArray {
                (ctx2, TypeResult { ty: type_error(), effects: effects })
            } else if arr_ty.kind == TypeKind::TString {
                (ctx2, TypeResult { ty: type_string_ty(), effects: effects })
            } else {
                let nc = add_error(ctx2, "Cannot index non-array type")
                (nc, TypeResult { ty: type_error(), effects: effects })
            }
        }

        ExprKind::Assign => {
            let target_expr = expr_child(expr, 0)
            let value_expr = expr_child(expr, 1)
            let (ctx1, target_res) = tc_infer(ctx, target_expr)
            let (ctx2, value_res) = tc_infer(ctx1, value_expr)
            let target_ty = target_res.ty
            let value_ty = value_res.ty
            var effects = combine_effects(target_res.effects, value_res.effects)
            effects = effect_list_push(effects, effect_mut())
            match target_expr.kind {
                ExprKind::VarRef => {
                    if var_map_contains(ctx2.vars, target_expr.value) {
                        let mutable = var_map_get_mut(ctx2.vars, target_expr.value)
                        if !mutable {
                            let nc = add_error(ctx2,
                                "Cannot assign to immutable variable: " + target_expr.value)
                            return (nc, TypeResult { ty: type_error(), effects: effects })
                        }
                    }
                }
                _ => {}
            }
            if !types_equal(target_ty, value_ty) {
                let nc = add_error(ctx2, "Assignment type mismatch")
                return (nc, TypeResult { ty: type_error(), effects: effects })
            }
            (ctx2, TypeResult { ty: type_unit(), effects: effects })
        }

        ExprKind::Let => {
            let name = expr.value
            let init_expr = expr_child(expr, 0)
            let (ctx1, init_res) = tc_infer(ctx, init_expr)
            let var_ty = if expr.type_ann.kind != TypeKind::TUnit {
                if !types_equal(expr.type_ann, init_res.ty) {
                    let nc = add_error(ctx1, "Type annotation doesn't match initializer")
                    return (nc, TypeResult { ty: type_error(), effects: init_res.effects })
                }
                expr.type_ann
            } else {
                init_res.ty
            }
            let new_ctx = bind_var(ctx1, name, var_ty, false)
            (new_ctx, TypeResult { ty: type_unit(), effects: init_res.effects })
        }

        ExprKind::Var => {
            let name = expr.value
            let init_expr = expr_child(expr, 0)
            let (ctx1, init_res) = tc_infer(ctx, init_expr)
            let var_ty = if expr.type_ann.kind != TypeKind::TUnit {
                if !types_equal(expr.type_ann, init_res.ty) {
                    let nc = add_error(ctx1, "Type annotation doesn't match initializer")
                    return (nc, TypeResult { ty: type_error(), effects: init_res.effects })
                }
                expr.type_ann
            } else {
                init_res.ty
            }
            let new_ctx = bind_var(ctx1, name, var_ty, true)
            (new_ctx, TypeResult { ty: type_unit(), effects: init_res.effects })
        }

        ExprKind::If => {
            let cond_expr = expr_child(expr, 0)
            let then_expr = expr_child(expr, 1)
            let else_expr = expr_child(expr, 2)
            let (ctx1, cond_res) = tc_infer(ctx, cond_expr)
            if cond_res.ty.kind != TypeKind::TBool {
                let nc = add_error(ctx1, "If condition must be bool")
                return (nc, TypeResult { ty: type_error(), effects: cond_res.effects })
            }
            let (ctx2, then_res) = tc_infer(ctx1, then_expr)
            let (ctx3, else_res) = tc_infer(ctx2, else_expr)
            var effects = combine_effects(cond_res.effects, then_res.effects)
            effects = combine_effects(effects, else_res.effects)
            if !types_equal(then_res.ty, else_res.ty) {
                let nc = add_error(ctx3, "If branches have incompatible types")
                return (nc, TypeResult { ty: type_error(), effects: effects })
            }
            (ctx3, TypeResult { ty: then_res.ty, effects: effects })
        }

        ExprKind::While => {
            let cond_expr = expr_child(expr, 0)
            let body_expr = expr_child(expr, 1)
            let (ctx1, cond_res) = tc_infer(ctx, cond_expr)
            if cond_res.ty.kind != TypeKind::TBool {
                let nc = add_error(ctx1, "While condition must be bool")
                return (nc, TypeResult { ty: type_error(), effects: cond_res.effects })
            }
            let (ctx2, body_res) = tc_infer(ctx1, body_expr)
            var effects = combine_effects(cond_res.effects, body_res.effects)
            (ctx2, TypeResult { ty: type_unit(), effects: effects })
        }

        ExprKind::For => {
            let var_name = expr.value
            let iterable_expr = expr_child(expr, 0)
            let body_expr = expr_child(expr, 1)
            let (ctx1, iterable_res) = tc_infer(ctx, iterable_expr)
            let iterable_ty = iterable_res.ty
            let elem_ty = if iterable_ty.kind == TypeKind::TArray {
                type_error()
            } else if iterable_ty.kind == TypeKind::TString {
                type_string_ty()
            } else {
                let nc = add_error(ctx1, "Cannot iterate over non-iterable type")
                return (nc, TypeResult { ty: type_error(), effects: iterable_res.effects })
            }
            let loop_ctx = context_child(ctx1)
            let loop_ctx2 = bind_var(loop_ctx, var_name, elem_ty, false)
            let (ctx2, body_res) = tc_infer(loop_ctx2, body_expr)
            var effects = combine_effects(iterable_res.effects, body_res.effects)
            (ctx2, TypeResult { ty: type_unit(), effects: effects })
        }

        ExprKind::Return => {
            if expr.children_len == 0 {
                (ctx, TypeResult { ty: type_unit(), effects: effect_list_new() })
            } else {
                let val_expr = expr_child(expr, 0)
                tc_infer(ctx, val_expr)
            }
        }

        ExprKind::Break => {
            (ctx, TypeResult { ty: type_unit(), effects: effect_list_new() })
        }

        ExprKind::Continue => {
            (ctx, TypeResult { ty: type_unit(), effects: effect_list_new() })
        }

        ExprKind::Block => {
            let block_ctx = context_child(ctx)
            var i: i64 = 0
            var last_result = TypeResult { ty: type_unit(), effects: effect_list_new() }
            var current_ctx = block_ctx
            while i < expr.children_len {
                let stmt = expr_child(expr, i)
                let (new_ctx, res) = tc_infer(current_ctx, stmt)
                current_ctx = new_ctx
                last_result = res
                i = i + 1
            }
            (current_ctx, last_result)
        }

        ExprKind::Fn => {
            let name = expr.value
            var params = expr_list_new()
            var param_types = type_list_new()
            var i: i64 = 0
            while i < expr.children_len - 1 {
                let param = expr_child(expr, i)
                params = expr_list_push(params, param)
                param_types = type_list_push(param_types, param.type_ann)
                i = i + 1
            }
            let func_ty = type_function(params.len, effect_list_new())
            let ctx1 = bind_func_sig(ctx, name, func_ty)
            let func_ctx = context_child(ctx1)
            var j: i64 = 0
            var current_ctx = func_ctx
            while j < params.len {
                let param = expr_list_get(params, j)
                current_ctx = bind_var(current_ctx, param.value, param.type_ann, false)
                j = j + 1
            }
            let body = expr_child(expr, expr.children_len - 1)
            let (ctx2, body_res) = tc_infer(current_ctx, body)
            let final_func_ty = type_function(params.len, body_res.effects)
            let ctx3 = bind_func_sig(ctx2, name, final_func_ty)
            (ctx3, TypeResult { ty: type_unit(), effects: effect_list_new() })
        }

        ExprKind::ArrayLit => {
            if expr.children_len == 0 {
                (ctx, TypeResult { ty: type_array("a"), effects: effect_list_new() })
            } else {
                let first_elem = expr_child(expr, 0)
                let (ctx1, first_res) = tc_infer(ctx, first_elem)
                let elem_ty = first_res.ty
                var effects = first_res.effects
                var i: i64 = 1
                var current_ctx = ctx1
                while i < expr.children_len {
                    let elem = expr_child(expr, i)
                    let (ctx2, elem_res) = tc_infer(current_ctx, elem)
                    if !types_equal(elem_ty, elem_res.ty) {
                        let nc = add_error(ctx2, "Array elements must have same type")
                        return (nc, TypeResult { ty: type_error(), effects: effects })
                    }
                    effects = combine_effects(effects, elem_res.effects)
                    current_ctx = ctx2
                    i = i + 1
                }
                (current_ctx, TypeResult { ty: type_array(elem_ty.name), effects: effects })
            }
        }

        ExprKind::StructLit => {
            let struct_name = expr.value
            if type_map_contains(ctx.type_defs, struct_name) {
                let struct_ty = type_map_get(ctx.type_defs, struct_name)
                if struct_ty.fields_len != expr.children_len {
                    let nc = add_error(ctx, "Field count mismatch in struct literal")
                    return (nc, TypeResult { ty: type_error(), effects: effect_list_new() })
                }
                (ctx, TypeResult { ty: struct_ty, effects: effect_list_new() })
            } else {
                let nc = add_error(ctx, "Unknown struct type: " + struct_name)
                (nc, TypeResult { ty: type_error(), effects: effect_list_new() })
            }
        }

        ExprKind::Match => {
            let scrutinee_expr = expr_child(expr, 0)
            let (ctx1, scrutinee_res) = tc_infer(ctx, scrutinee_expr)
            var effects = scrutinee_res.effects
            var arm_types = type_list_new()
            var current_ctx = ctx1
            var i: i64 = 1
            while i < expr.children_len {
                let arm = expr_child(expr, i)
                let body = expr_child(arm, 1)
                let (ctx2, arm_res) = tc_infer(current_ctx, body)
                arm_types = type_list_push(arm_types, arm_res.ty)
                effects = combine_effects(effects, arm_res.effects)
                current_ctx = ctx2
                i = i + 1
            }
            if arm_types.len > 0 {
                let first_ty = type_list_get(arm_types, 0)
                var j: i64 = 1
                while j < arm_types.len {
                    if !types_equal(first_ty, type_list_get(arm_types, j)) {
                        let nc = add_error(current_ctx, "Match arms have incompatible types")
                        return (nc, TypeResult { ty: type_error(), effects: effects })
                    }
                    j = j + 1
                }
                (current_ctx, TypeResult { ty: first_ty, effects: effects })
            } else {
                (current_ctx, TypeResult { ty: type_unit(), effects: effects })
            }
        }

        _ => {
            let new_ctx = add_error(ctx, "Unsupported expression type")
            (new_ctx, TypeResult { ty: type_error(), effects: effect_list_new() })
        }
    }
}

// ============================================================================
// PUBLIC API
// ============================================================================

fn typecheck(ast: Expr) -> (ErrorList, Type) with Mut, Panic, Div {
    let ctx = context_new()
    let (final_ctx, result) = tc_infer(ctx, ast)
    (final_ctx.errors, result.ty)
}
