// self-hosted::compiler::typecheck
//
// TYPE CHECKER FOR SOUNIO
// No stubs. No fakes. Real implementation.
//
// Hindley-Milner style type inference with effect tracking.
// Vec<T> replaced with fixed-size arrays + length fields.
// All forward references eliminated by inlining infer_* into tc_infer().

use compiler::ontology::mod::{ontology_is_supported_prefix, ontology_curie_literal_valid}

// ============================================================================
// INLINE TYPE DEFINITIONS
// ============================================================================

enum ExprKind {
    IntLit,
    FloatLit,
    StringLit,
    BoolLit,
    UnitLit,
    VarRef,
    Binary,
    Unary,
    Call,
    FieldAccess,
    Index,
    Assign,
    Block,
    If,
    While,
    For,
    Return,
    Break,
    Continue,
    Match,
    MatchArm,
    Let,
    Var,
    Fn,
    StructLit,
    FieldInit,
    ArrayLit,
    TypeAnnotation,
    Error,
}

enum TypeKind {
    TInt,
    TFloat,
    TString,
    TBool,
    TUnit,
    TArray,
    TStruct,
    TEnum,
    TFunction,
    TVar,
    TError,
}

struct FieldDef {
    name: string,
    kind: TypeKind,
}

struct Type {
    kind: TypeKind,
    name: string,
    args: [i64; 16],
    args_len: i64,
    effects: [string; 8],
    effects_len: i64,
    fields: [FieldDef; 32],
    fields_len: i64,
    var_id: i64,
}

struct Span {
    line: i64,
    column: i64,
}

struct Expr {
    kind: ExprKind,
    value: string,
    children: [i64; 64],
    children_len: i64,
    type_ann: Type,
    span: Span,
}

// ============================================================================
// STRING UTILITIES (must precede everything that uses int_to_string)
// ============================================================================

fn char_from_i64(n: i64) -> string with Mut, Panic {
    str_slice("0123456789", n, n + 1)
}

fn int_to_string(n: i64) -> string with Mut, Panic, Div {
    if n == 0 {
        "0"
    } else {
        let negative = n < 0
        var num = if negative { 0 - n } else { n }
        var result = ""
        while num > 0 {
            let digit = num % 10
            let ch = 48 + digit
            result = char_from_i64(ch) + result
            num = num / 10
        }
        if negative { "-" + result } else { result }
    }
}

// ============================================================================
// EFFECT HELPERS
// ============================================================================

fn effect_div() -> string { "Div" }
fn effect_mut() -> string { "Mut" }

// ============================================================================
// EFFECT LIST
// ============================================================================

struct EffectList {
    items: [string; 16],
    len: i64,
}

fn effect_list_new() -> EffectList {
    EffectList {
        items: ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        len: 0,
    }
}

fn effect_list_push(lst: EffectList, s: string) -> EffectList {
    var out = lst
    if out.len < 16 {
        out.items[out.len as usize] = s
        out.len = out.len + 1
    }
    out
}

fn effect_list_get(lst: EffectList, i: i64) -> string {
    lst.items[i as usize]
}

fn combine_effects(a: EffectList, b: EffectList) -> EffectList {
    var out = a
    var i: i64 = 0
    while i < b.len {
        let s = effect_list_get(b, i)
        var found = false
        var j: i64 = 0
        while j < out.len {
            if effect_list_get(out, j) == s {
                found = true
            }
            j = j + 1
        }
        if !found {
            out = effect_list_push(out, s)
        }
        i = i + 1
    }
    out
}

