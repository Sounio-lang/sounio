// Direct ELF emission test — uses direct-mutation finalize_elf64.
// Hardcodes x86-64 machine code for exit(42), wraps in ELF.

use native::encode::*
use native::elf::*

fn main() -> i64 with IO, Mut, Panic, Div {
    var code = code_buffer_new()
    code.bytes[0] = 0xbf as i8
    code.bytes[1] = 42 as i8
    code.bytes[2] = 0x00 as i8
    code.bytes[3] = 0x00 as i8
    code.bytes[4] = 0x00 as i8
    code.bytes[5] = 0xb8 as i8
    code.bytes[6] = 60 as i8
    code.bytes[7] = 0x00 as i8
    code.bytes[8] = 0x00 as i8
    code.bytes[9] = 0x00 as i8
    code.bytes[10] = 0x0f as i8
    code.bytes[11] = 0x05 as i8
    code.len = 12

    var rodata = string_table_new()
    var data = string_table_new()

    var symbols = symbol_data_new()
    symbols.strtab[1] = 109 as i8
    symbols.strtab[2] = 97 as i8
    symbols.strtab[3] = 105 as i8
    symbols.strtab[4] = 110 as i8
    symbols.strtab[5] = 0 as i8
    symbols.strtab_len = 6
    symbols.name_offsets[0] = 1

    var fn_offsets: [i64; 256] = [0; 256]

    print("building ELF...\n")
    let elf = finalize_elf64(code, rodata, data, 0, 4194304, symbols, fn_offsets, 1)
    print("ELF built, len=")
    print_int(elf.len)
    print("\n")

    let ok = write_file("/tmp/test_elf_direct.elf", elf.bytes, elf.len) >= 0
    if !ok {
        print("write error\n")
        return 1
    }
    print("written to /tmp/test_elf_direct.elf\n")
    0
}
