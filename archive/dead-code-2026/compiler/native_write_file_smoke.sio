fn main() -> i64 with IO {
    let text: [i8; 18] = [
        104 as i8, 101 as i8, 108 as i8, 108 as i8, 111 as i8, 32 as i8,
        102 as i8, 114 as i8, 111 as i8, 109 as i8, 32 as i8, 115 as i8,
        111 as i8, 117 as i8, 110 as i8, 105 as i8, 111 as i8, 10 as i8
    ]
    let text_path = "/tmp/sounio_write_file_text.txt"
    let text_written = write_file(text_path, text, 18)
    if text_written < 0 {
        print("FAIL: write_file return\n")
        return 1
    }
    let text_raw = read_file(text_path)
    let text_size = file_size(text_path)
    if text_size != 18 {
        print("FAIL: write_file size\n")
        return 2
    }

    let alias_path = "/tmp/sounio_write_bytes_alias.txt"
    let alias_written = write_bytes(alias_path, text, 18)
    if alias_written < 0 {
        print("FAIL: write_bytes return\n")
        return 3
    }
    let alias_size = file_size(alias_path)
    if alias_size != 18 {
        print("FAIL: write_bytes size\n")
        return 4
    }

    let append_path = "/tmp/sounio_append_file.txt"
    let prefix: [i8; 3] = [97 as i8, 98 as i8, 99 as i8]
    let prefix_written = write_file(append_path, prefix, 3)
    if prefix_written < 0 {
        print("FAIL: append prefix write\n")
        return 5
    }
    let suffix: [i8; 3] = [100 as i8, 101 as i8, 102 as i8]
    let suffix_written = append_file(append_path, suffix, 3)
    if suffix_written < 0 {
        print("FAIL: append_file return\n")
        return 6
    }
    let append_size = file_size(append_path)
    if append_size < 3 {
        print("FAIL: append_file size\n")
        return 7
    }
    let append_raw = read_file(append_path)
    let _ = append_raw
    let _ = text_raw

    print("ALL PASS\n")
    0
}
