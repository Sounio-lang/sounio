// self-hosted::compiler::emit_so_driver
//
// AST-direct .so shared library emission driver.
// Compiles export "C" fn functions to x86-64 machine code and wraps in
// ET_DYN ELF with .dynsym/.dynstr for dynamic symbol export.
//
// Avoids IR lowering entirely (JIT Box mutation bug makes fn_count=0).
// Uses micro-emitter from render_native_compile_driver_lean.sio.
//
// Usage:
//   souc run self-hosted/compiler/emit_so_driver.sio -- <source.sio> [output.so]

use lexer::mod::*
use parser::ast::*
use ir::ir::*
use check::dependent::*
use check::types::*
use check::mod::{check_program, check_program_epistemic_into}
use check::ownership::*
use check::lint::*
use check::layout::*
use io::file_write::*
use interop::contract::*
use native::aarch64::*
use native::encode::*
use native::elf::*
use native::macho::*
use native::reloc::*
use native::frame::*
use native::lower_ir::*
use native::machine_ir::*
use native::gc::*
use native::runtime_context::*
use native::stack_maps::*
use native::target_policy::*
use native::codegen::*
use native::regalloc::*
use native::peephole::*
use parser::mod::{parse_program_preloaded, count_items}
use parser::parser::{parser_last_error_count}

fn char_from_i64(n: i64) -> string with Mut, Panic {
    if n == 0 { "0" }
    else if n == 1 { "1" }
    else if n == 2 { "2" }
    else if n == 3 { "3" }
    else if n == 4 { "4" }
    else if n == 5 { "5" }
    else if n == 6 { "6" }
    else if n == 7 { "7" }
    else if n == 8 { "8" }
    else if n == 9 { "9" }
    else { "?" }
}

fn int_to_string(n: i64) -> string with Mut, Panic, Div {
    if n == 0 { return "0" }
    var val = n
    var negative = false
    if val < 0 { negative = true; val = 0 - val }
    var result = ""
    while val > 0 {
        let digit = val % 10
        result = char_from_i64(digit) + result
        val = val / 10
    }
    if negative { "-" + result } else { result }
}

fn load_source_file(path: string) -> Program with IO, Mut, Div, Panic, Alloc {
    let data = read_file(path)
    let size = file_size(path)
    var buf: [i8; 1048576] = [0; 1048576]
    var i: i64 = 0
    while i < size && i < 1048576 {
        buf[i as usize] = data[i as usize]
        i = i + 1
    }
    let state = lex(buf, size, 0)
    parse_program_preloaded(state.token_count)
}

// ============================================================================
// Micro-emitter (from render_native_compile_driver_lean.sio)
// ============================================================================

fn micro_store_rax(code: CodeBuffer, vreg: i64) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    let disp = 0 - ((vreg + 1) * 8)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0x85)
    c = emit_byte(c, disp & 0xFF)
    c = emit_byte(c, (disp >> 8) & 0xFF)
    c = emit_byte(c, (disp >> 16) & 0xFF)
    c = emit_byte(c, (disp >> 24) & 0xFF)
    c
}

fn micro_load_rax(code: CodeBuffer, vreg: i64) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    let disp = 0 - ((vreg + 1) * 8)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8b); c = emit_byte(c, 0x85)
    c = emit_byte(c, disp & 0xFF)
    c = emit_byte(c, (disp >> 8) & 0xFF)
    c = emit_byte(c, (disp >> 16) & 0xFF)
    c = emit_byte(c, (disp >> 24) & 0xFF)
    c
}

fn so_ast_compile_expr(code: CodeBuffer, expr: &Expr,
    local_names: [Name; 64], local_slots: [i64; 64], local_count: i64,
    fn_names: [Name; 64], fn_count: i64
) -> CodeBuffer with Mut, Panic, Div, IO {
    var c = code
    if expr.kind == ExprKind::ExprIntLit {
        c = emit_byte(c, 0x48); c = emit_byte(c, 0xb8)
        c = emit_byte(c, expr.int_val & 0xFF)
        c = emit_byte(c, (expr.int_val >> 8) & 0xFF)
        c = emit_byte(c, (expr.int_val >> 16) & 0xFF)
        c = emit_byte(c, (expr.int_val >> 24) & 0xFF)
        c = emit_byte(c, (expr.int_val >> 32) & 0xFF)
        c = emit_byte(c, (expr.int_val >> 40) & 0xFF)
        c = emit_byte(c, (expr.int_val >> 48) & 0xFF)
        c = emit_byte(c, (expr.int_val >> 56) & 0xFF)
        c
    } else if expr.kind == ExprKind::ExprIdent {
        var slot: i64 = -1
        var li = local_count - 1
        while li >= 0 {
            if ir_name_eq(local_names[li as usize], expr.name) {
                slot = local_slots[li as usize]
                li = -1
            } else { li = li - 1 }
        }
        if slot >= 0 { c = micro_load_rax(c, slot) }
        else { c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0) }
        c
    } else if expr.kind == ExprKind::ExprBinary {
        // Short-circuit operators must bypass the standard push-left/eval-right sequence
        if expr.bin_op == BinaryOp::OpAnd {
            // && : eval left; if zero, skip right and return 0; else return right
            let sc_al: &Option<Box<Expr>> = &expr.left
            match *sc_al {
                Some(le) => { c = so_ast_compile_expr(c, &(*le), local_names, local_slots, local_count, fn_names, fn_count) }
                _ => {}
            }
            // test rax,rax; jz sc_false (0f 84 disp32)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0)
            let sc_and_jz = c.len
            c = emit_byte(c, 0x0f); c = emit_byte(c, 0x84)
            c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
            let sc_ar: &Option<Box<Expr>> = &expr.right
            match *sc_ar {
                Some(re) => { c = so_ast_compile_expr(c, &(*re), local_names, local_slots, local_count, fn_names, fn_count) }
                _ => {}
            }
            let sc_and_jmp = c.len
            c = emit_byte(c, 0xe9)
            c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
            let sc_and_false = c.len
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
            let sc_and_end = c.len
            let jz_d = sc_and_false - (sc_and_jz + 6)
            c.bytes[(sc_and_jz + 2) as usize] = (jz_d & 0xFF) as i8
            c.bytes[(sc_and_jz + 3) as usize] = ((jz_d >> 8) & 0xFF) as i8
            c.bytes[(sc_and_jz + 4) as usize] = ((jz_d >> 16) & 0xFF) as i8
            c.bytes[(sc_and_jz + 5) as usize] = ((jz_d >> 24) & 0xFF) as i8
            let jmp_d = sc_and_end - (sc_and_jmp + 5)
            c.bytes[(sc_and_jmp + 1) as usize] = (jmp_d & 0xFF) as i8
            c.bytes[(sc_and_jmp + 2) as usize] = ((jmp_d >> 8) & 0xFF) as i8
            c.bytes[(sc_and_jmp + 3) as usize] = ((jmp_d >> 16) & 0xFF) as i8
            c.bytes[(sc_and_jmp + 4) as usize] = ((jmp_d >> 24) & 0xFF) as i8
            return c
        } else if expr.bin_op == BinaryOp::OpOr {
            // || : eval left; if nonzero, return 1; else return right
            let sc_ol: &Option<Box<Expr>> = &expr.left
            match *sc_ol {
                Some(le) => { c = so_ast_compile_expr(c, &(*le), local_names, local_slots, local_count, fn_names, fn_count) }
                _ => {}
            }
            // test rax,rax; jnz sc_true (0f 85 disp32)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0)
            let sc_or_jnz = c.len
            c = emit_byte(c, 0x0f); c = emit_byte(c, 0x85)
            c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
            let sc_or: &Option<Box<Expr>> = &expr.right
            match *sc_or {
                Some(re) => { c = so_ast_compile_expr(c, &(*re), local_names, local_slots, local_count, fn_names, fn_count) }
                _ => {}
            }
            let sc_or_jmp = c.len
            c = emit_byte(c, 0xe9)
            c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
            let sc_or_true = c.len
            c = emit_byte(c, 0x48); c = emit_byte(c, 0xc7); c = emit_byte(c, 0xc0)
            c = emit_byte(c, 1); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
            let sc_or_end = c.len
            let jnz_d = sc_or_true - (sc_or_jnz + 6)
            c.bytes[(sc_or_jnz + 2) as usize] = (jnz_d & 0xFF) as i8
            c.bytes[(sc_or_jnz + 3) as usize] = ((jnz_d >> 8) & 0xFF) as i8
            c.bytes[(sc_or_jnz + 4) as usize] = ((jnz_d >> 16) & 0xFF) as i8
            c.bytes[(sc_or_jnz + 5) as usize] = ((jnz_d >> 24) & 0xFF) as i8
            let or_jmp_d = sc_or_end - (sc_or_jmp + 5)
            c.bytes[(sc_or_jmp + 1) as usize] = (or_jmp_d & 0xFF) as i8
            c.bytes[(sc_or_jmp + 2) as usize] = ((or_jmp_d >> 8) & 0xFF) as i8
            c.bytes[(sc_or_jmp + 3) as usize] = ((or_jmp_d >> 16) & 0xFF) as i8
            c.bytes[(sc_or_jmp + 4) as usize] = ((or_jmp_d >> 24) & 0xFF) as i8
            return c
        }
        // Standard binary ops: left → stack, right → rax, op applies rax op rcx
        let left_ref: &Option<Box<Expr>> = &expr.left
        match *left_ref {
            Some(le) => { c = so_ast_compile_expr(c, &(*le), local_names, local_slots, local_count, fn_names, fn_count) }
            _ => {}
        }
        c = emit_byte(c, 0x50)
        let right_ref: &Option<Box<Expr>> = &expr.right
        match *right_ref {
            Some(re) => { c = so_ast_compile_expr(c, &(*re), local_names, local_slots, local_count, fn_names, fn_count) }
            _ => {}
        }
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc1)
        c = emit_byte(c, 0x58)
        if expr.bin_op == BinaryOp::OpAdd {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x01); c = emit_byte(c, 0xc8)
        } else if expr.bin_op == BinaryOp::OpSub {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x29); c = emit_byte(c, 0xc8)
        } else if expr.bin_op == BinaryOp::OpMul {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xaf); c = emit_byte(c, 0xc1)
        } else if expr.bin_op == BinaryOp::OpDiv {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x99)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xf9)
        } else if expr.bin_op == BinaryOp::OpRem {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x99)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xf9)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xd0)
        } else if expr.bin_op == BinaryOp::OpEq || expr.bin_op == BinaryOp::OpNe ||
                  expr.bin_op == BinaryOp::OpLt || expr.bin_op == BinaryOp::OpLe ||
                  expr.bin_op == BinaryOp::OpGt || expr.bin_op == BinaryOp::OpGe {
            // cmp rax, rcx  (48 39 C8)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
            // setCC al  (0F 9x C0)
            c = emit_byte(c, 0x0f)
            if expr.bin_op == BinaryOp::OpEq { c = emit_byte(c, 0x94) }
            else if expr.bin_op == BinaryOp::OpNe { c = emit_byte(c, 0x95) }
            else if expr.bin_op == BinaryOp::OpLt { c = emit_byte(c, 0x9c) }
            else if expr.bin_op == BinaryOp::OpLe { c = emit_byte(c, 0x9e) }
            else if expr.bin_op == BinaryOp::OpGt { c = emit_byte(c, 0x9f) }
            else { c = emit_byte(c, 0x9d) }  // OpGe
            c = emit_byte(c, 0xc0)
            // movzx rax, al  (48 0F B6 C0)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0)
        } else if expr.bin_op == BinaryOp::OpBitAnd {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x21); c = emit_byte(c, 0xc8)
        } else if expr.bin_op == BinaryOp::OpBitOr {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x09); c = emit_byte(c, 0xc8)
        } else if expr.bin_op == BinaryOp::OpBitXor {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc8)
        } else if expr.bin_op == BinaryOp::OpShl {
            // shl rax, cl  (48 D3 E0) — shift count in cl (low byte of rcx)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0xd3); c = emit_byte(c, 0xe0)
        } else if expr.bin_op == BinaryOp::OpShr {
            // sar rax, cl  (48 D3 F8) — arithmetic shift right
            c = emit_byte(c, 0x48); c = emit_byte(c, 0xd3); c = emit_byte(c, 0xf8)
        }
        c
    } else if expr.kind == ExprKind::ExprReturn {
        let ret_ref: &Option<Box<Expr>> = &expr.left
        match *ret_ref {
            Some(re) => { c = so_ast_compile_expr(c, &(*re), local_names, local_slots, local_count, fn_names, fn_count) }
            _ => { c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0) }
        }
        c = emit_byte(c, 0xc9); c = emit_byte(c, 0xc3)
        c
    } else if expr.kind == ExprKind::ExprCall {
        let callee_opt: &Option<Box<Expr>> = &expr.left
        var callee_name = ir_empty_name()
        match *callee_opt {
            Some(ce) => { callee_name = (*ce).name }
            _ => {}
        }
        var arg_count: i64 = 0
        let args_ref: &Option<Box<ExprList>> = &expr.args
        var current_arg = args_ref
        while true {
            match *current_arg {
                Some(al) => {
                    c = so_ast_compile_expr(c, &(*al).head, local_names, local_slots, local_count, fn_names, fn_count)
                    c = emit_byte(c, 0x50)
                    arg_count = arg_count + 1
                    current_arg = &(*al).tail
                }
                _ => break
            }
        }
        if arg_count >= 4 { c = emit_byte(c, 0x59) }
        if arg_count >= 3 { c = emit_byte(c, 0x5a) }
        if arg_count >= 2 { c = emit_byte(c, 0x5e) }
        if arg_count >= 1 { c = emit_byte(c, 0x5f) }
        // Emit call with placeholder (CAFE marker)
        var fn_slot: i64 = -1
        var fi: i64 = 0
        while fi < fn_count {
            if ir_name_eq(fn_names[fi as usize], callee_name) { fn_slot = fi; fi = fn_count }
            fi = fi + 1
        }
        if fn_slot >= 0 {
            c = emit_byte(c, 0xe8)
            c = emit_byte(c, fn_slot & 0xFF)
            c = emit_byte(c, (fn_slot >> 8) & 0xFF)
            c = emit_byte(c, 0xCA as i64)
            c = emit_byte(c, 0xFE as i64)
        }
        c
    } else if expr.kind == ExprKind::ExprIf {
        let cond_ref: &Option<Box<Expr>> = &expr.left
        match *cond_ref {
            Some(ce) => { c = so_ast_compile_expr(c, &(*ce), local_names, local_slots, local_count, fn_names, fn_count) }
            _ => {}
        }
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0)
        let jz_site = c.len
        c = emit_byte(c, 0x0f); c = emit_byte(c, 0x84)
        c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
        let then_ref: &Option<Box<Block>> = &expr.block
        match *then_ref {
            Some(tb) => { c = so_ast_compile_block(c, &(*tb), local_names, local_slots, local_count, fn_names, fn_count) }
            _ => { c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0) }
        }
        let jmp_site = c.len
        c = emit_byte(c, 0xe9)
        c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
        let else_off = c.len
        let jz_disp = else_off - (jz_site + 6)
        c.bytes[(jz_site + 2) as usize] = (jz_disp & 0xFF) as i8
        c.bytes[(jz_site + 3) as usize] = ((jz_disp >> 8) & 0xFF) as i8
        c.bytes[(jz_site + 4) as usize] = ((jz_disp >> 16) & 0xFF) as i8
        c.bytes[(jz_site + 5) as usize] = ((jz_disp >> 24) & 0xFF) as i8
        let else_expr_ref: &Option<Box<Expr>> = &expr.else_expr
        match *else_expr_ref {
            Some(ee) => { c = so_ast_compile_expr(c, &(*ee), local_names, local_slots, local_count, fn_names, fn_count) }
            _ => { c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0) }
        }
        let end_off = c.len
        let jmp_disp = end_off - (jmp_site + 5)
        c.bytes[(jmp_site + 1) as usize] = (jmp_disp & 0xFF) as i8
        c.bytes[(jmp_site + 2) as usize] = ((jmp_disp >> 8) & 0xFF) as i8
        c.bytes[(jmp_site + 3) as usize] = ((jmp_disp >> 16) & 0xFF) as i8
        c.bytes[(jmp_site + 4) as usize] = ((jmp_disp >> 24) & 0xFF) as i8
        c
    } else if expr.kind == ExprKind::ExprBlock {
        // Block expression: { stmts... }
        let blk_ref: &Option<Box<Block>> = &expr.block
        match *blk_ref {
            Some(blk) => { c = so_ast_compile_block(c, &(*blk), local_names, local_slots, local_count, fn_names, fn_count) }
            _ => { c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0) }
        }
        c
    } else if expr.kind == ExprKind::ExprWhile {
        // while cond { body }
        // loop_top: compile cond → test rax,rax → jz loop_end → compile body → jmp loop_top → loop_end:
        let loop_top = c.len
        let cond_ref_w: &Option<Box<Expr>> = &expr.left
        match *cond_ref_w {
            Some(ce) => { c = so_ast_compile_expr(c, &(*ce), local_names, local_slots, local_count, fn_names, fn_count) }
            _ => {}
        }
        // test rax, rax
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0)
        // jz loop_end (placeholder)
        let jz_site_w = c.len
        c = emit_byte(c, 0x0f); c = emit_byte(c, 0x84)
        c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
        // body
        let body_ref_w: &Option<Box<Block>> = &expr.block
        match *body_ref_w {
            Some(tb) => { c = so_ast_compile_block(c, &(*tb), local_names, local_slots, local_count, fn_names, fn_count) }
            _ => {}
        }
        // jmp loop_top
        let jmp_back = c.len
        c = emit_byte(c, 0xe9)
        let back_disp = loop_top - (jmp_back + 5)
        c = emit_byte(c, (back_disp & 0xFF) as i64)
        c = emit_byte(c, ((back_disp >> 8) & 0xFF) as i64)
        c = emit_byte(c, ((back_disp >> 16) & 0xFF) as i64)
        c = emit_byte(c, ((back_disp >> 24) & 0xFF) as i64)
        // patch jz to here
        let loop_end = c.len
        let jz_disp_w = loop_end - (jz_site_w + 6)
        c.bytes[(jz_site_w + 2) as usize] = (jz_disp_w & 0xFF) as i8
        c.bytes[(jz_site_w + 3) as usize] = ((jz_disp_w >> 8) & 0xFF) as i8
        c.bytes[(jz_site_w + 4) as usize] = ((jz_disp_w >> 16) & 0xFF) as i8
        c.bytes[(jz_site_w + 5) as usize] = ((jz_disp_w >> 24) & 0xFF) as i8
        // while returns 0
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
        c
    } else if expr.kind == ExprKind::ExprUnary {
        // Unary negation: 0 - x
        let operand_ref: &Option<Box<Expr>> = &expr.left
        match *operand_ref {
            Some(oe) => { c = so_ast_compile_expr(c, &(*oe), local_names, local_slots, local_count, fn_names, fn_count) }
            _ => {}
        }
        if expr.un_op == UnaryOp::OpNeg {
            // neg rax  (48 F7 D8)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xd8)
        } else if expr.un_op == UnaryOp::OpNot {
            // test rax, rax → sete al → movzx rax, al  (logical not)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0)
            c = emit_byte(c, 0x0f); c = emit_byte(c, 0x94); c = emit_byte(c, 0xc0)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0)
        }
        c
    } else {
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
        c
    }
}

fn so_ast_compile_block(code: CodeBuffer, blk: &Block,
    local_names: [Name; 64], local_slots: [i64; 64], local_count: i64,
    fn_names: [Name; 64], fn_count: i64
) -> CodeBuffer with Mut, Panic, Div, IO {
    var c = code
    var ln = local_names
    var ls = local_slots
    var lc = local_count
    var next_slot: i64 = 0
    var si: i64 = 0
    while si < lc {
        if ls[si as usize] >= next_slot { next_slot = ls[si as usize] + 1 }
        si = si + 1
    }
    let stmts_ref: &Option<Box<StmtList>> = &blk.stmts
    var stmt_cur = stmts_ref
    while true {
        match *stmt_cur {
            Some(sl) => {
                let s: &Stmt = &(*sl).head
                if s.kind == StmtKind::StmtLet || s.kind == StmtKind::StmtVar {
                    let init_ref: &Option<Box<Expr>> = &s.expr
                    match *init_ref {
                        Some(ie) => { c = so_ast_compile_expr(c, &(*ie), ln, ls, lc, fn_names, fn_count) }
                        _ => { c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0) }
                    }
                    let slot = next_slot
                    next_slot = next_slot + 1
                    c = micro_store_rax(c, slot)
                    ln[lc as usize] = s.name
                    ls[lc as usize] = slot
                    lc = lc + 1
                } else if s.kind == StmtKind::StmtExpr {
                    let expr_ref: &Option<Box<Expr>> = &s.expr
                    match *expr_ref {
                        Some(ee) => { c = so_ast_compile_expr(c, &(*ee), ln, ls, lc, fn_names, fn_count) }
                        _ => {}
                    }
                } else if s.kind == StmtKind::StmtAssign {
                    let rhs_ref: &Option<Box<Expr>> = &s.expr
                    match *rhs_ref {
                        Some(re) => { c = so_ast_compile_expr(c, &(*re), ln, ls, lc, fn_names, fn_count) }
                        _ => {}
                    }
                    let tgt_ref: &Option<Box<Expr>> = &s.target
                    match *tgt_ref {
                        Some(te) => {
                            if (*te).kind == ExprKind::ExprIdent {
                                var slot: i64 = -1
                                var li = lc - 1
                                while li >= 0 {
                                    if ir_name_eq(ln[li as usize], (*te).name) { slot = ls[li as usize]; li = -1 }
                                    else { li = li - 1 }
                                }
                                if slot >= 0 { c = micro_store_rax(c, slot) }
                            }
                        }
                        _ => {}
                    }
                }
                stmt_cur = &(*sl).tail
            }
            _ => break
        }
    }
    c
}

fn so_ast_compile_fn(code: CodeBuffer, fd: &FnDef,
    fn_names: [Name; 64], fn_count: i64
) -> CodeBuffer with Mut, Panic, Div, IO {
    var c = code
    var local_names: [Name; 64] = [ir_empty_name(); 64]
    var local_slots: [i64; 64] = [0; 64]
    var local_count: i64 = 0
    var next_slot: i64 = 0

    // Prologue: push rbp; mov rbp, rsp; sub rsp, 512
    c = emit_byte(c, 0x55)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xe5)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x81); c = emit_byte(c, 0xec)
    c = emit_byte(c, 0); c = emit_byte(c, 2); c = emit_byte(c, 0); c = emit_byte(c, 0)

    // Spill params: rdi=p0, rsi=p1, rdx=p2, rcx=p3, r8=p4, r9=p5
    var param_ref: &Option<Box<ParamList>> = &fd.params
    var param_idx: i64 = 0
    while true {
        match *param_ref {
            Some(pl) => {
                let p_slot = next_slot
                next_slot = next_slot + 1
                local_names[local_count as usize] = (*pl).head.name
                local_slots[local_count as usize] = p_slot
                local_count = local_count + 1
                if param_idx == 0 { c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xf8) }
                else if param_idx == 1 { c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xf0) }
                else if param_idx == 2 { c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xd0) }
                else if param_idx == 3 { c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc8) }
                c = micro_store_rax(c, p_slot)
                param_idx = param_idx + 1
                param_ref = &(*pl).tail
            }
            _ => break
        }
    }

    // Compile body
    let stmts_ref: &Option<Box<StmtList>> = &fd.body.stmts
    var stmt_cur = stmts_ref
    while true {
        match *stmt_cur {
            Some(sl) => {
                let s: &Stmt = &(*sl).head
                if s.kind == StmtKind::StmtLet || s.kind == StmtKind::StmtVar {
                    let init_ref: &Option<Box<Expr>> = &s.expr
                    match *init_ref {
                        Some(ie) => { c = so_ast_compile_expr(c, &(*ie), local_names, local_slots, local_count, fn_names, fn_count) }
                        _ => { c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0) }
                    }
                    let slot = next_slot
                    next_slot = next_slot + 1
                    c = micro_store_rax(c, slot)
                    local_names[local_count as usize] = s.name
                    local_slots[local_count as usize] = slot
                    local_count = local_count + 1
                } else if s.kind == StmtKind::StmtExpr {
                    let expr_ref: &Option<Box<Expr>> = &s.expr
                    match *expr_ref {
                        Some(ee) => { c = so_ast_compile_expr(c, &(*ee), local_names, local_slots, local_count, fn_names, fn_count) }
                        _ => {}
                    }
                } else if s.kind == StmtKind::StmtAssign {
                    let rhs_ref: &Option<Box<Expr>> = &s.expr
                    match *rhs_ref {
                        Some(re) => { c = so_ast_compile_expr(c, &(*re), local_names, local_slots, local_count, fn_names, fn_count) }
                        _ => {}
                    }
                    let tgt_ref: &Option<Box<Expr>> = &s.target
                    match *tgt_ref {
                        Some(te) => {
                            if (*te).kind == ExprKind::ExprIdent {
                                var slot: i64 = -1
                                var li = local_count - 1
                                while li >= 0 {
                                    if ir_name_eq(local_names[li as usize], (*te).name) { slot = local_slots[li as usize]; li = -1 }
                                    else { li = li - 1 }
                                }
                                if slot >= 0 { c = micro_store_rax(c, slot) }
                            }
                        }
                        _ => {}
                    }
                }
                stmt_cur = &(*sl).tail
            }
            _ => break
        }
    }

    // Epilogue: leave; ret
    c = emit_byte(c, 0xc9)
    c = emit_byte(c, 0xc3)
    c
}

// ============================================================================
// Inline ELF .so writer helpers
// ============================================================================

fn so_put_u8(out: [i8; 65536], off: i64, val: i64) -> [i8; 65536] with Mut, Panic {
    var o = out
    o[off as usize] = (val & 0xFF) as i8
    o
}

fn so_put_u16(out: [i8; 65536], off: i64, val: i64) -> [i8; 65536] with Mut, Panic {
    var o = out
    o[off as usize] = (val & 0xFF) as i8
    o[(off + 1) as usize] = ((val >> 8) & 0xFF) as i8
    o
}

fn so_put_u32(out: [i8; 65536], off: i64, val: i64) -> [i8; 65536] with Mut, Panic {
    var o = out
    o[off as usize] = (val & 0xFF) as i8
    o[(off + 1) as usize] = ((val >> 8) & 0xFF) as i8
    o[(off + 2) as usize] = ((val >> 16) & 0xFF) as i8
    o[(off + 3) as usize] = ((val >> 24) & 0xFF) as i8
    o
}

fn so_put_u64(out: [i8; 65536], off: i64, val: i64) -> [i8; 65536] with Mut, Panic {
    var o = out
    o[off as usize] = (val & 0xFF) as i8
    o[(off + 1) as usize] = ((val >> 8) & 0xFF) as i8
    o[(off + 2) as usize] = ((val >> 16) & 0xFF) as i8
    o[(off + 3) as usize] = ((val >> 24) & 0xFF) as i8
    o[(off + 4) as usize] = ((val >> 32) & 0xFF) as i8
    o[(off + 5) as usize] = ((val >> 40) & 0xFF) as i8
    o[(off + 6) as usize] = ((val >> 48) & 0xFF) as i8
    o[(off + 7) as usize] = ((val >> 56) & 0xFF) as i8
    o
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    if argc < 1 {
        print("Usage: emit_so_driver.sio <source.sio> [output.so]\n")
        return 1
    }
    let source_path = get_arg(0)
    var output_path = "output.so"
    if argc >= 2 { output_path = get_arg(1) }

    print("emit-so: source=")
    print(source_path)
    print(" output=")
    print(output_path)
    print("\n")

    // Parse
    let prog = load_source_file(source_path)
    if parser_last_error_count() > 0 {
        print("emit-so: parse error\n")
        return 1
    }

    // Collect function names + identify exports (is_pub)
    var fn_names: [Name; 64] = [ir_empty_name(); 64]
    var fn_is_export: [bool; 64] = [false; 64]
    var fn_count: i64 = 0

    let items_ref: &Option<Box<ItemList>> = &prog.items
    var item_cur = items_ref
    while true {
        match *item_cur {
            Some(il) => {
                let itm: &Item = &(*il).head
                if itm.kind == ItemKind::ItemFn {
                    fn_names[fn_count as usize] = itm.name
                    fn_is_export[fn_count as usize] = itm.is_pub
                    fn_count = fn_count + 1
                }
                item_cur = &(*il).tail
            }
            _ => break
        }
    }
    print("emit-so: fn_count=")
    print_int(fn_count)
    print("\n")

    // Compile each function to x86-64
    var code = code_buffer_new()
    var fn_offsets: [i64; 64] = [0; 64]

    item_cur = items_ref
    var fn_idx: i64 = 0
    while true {
        match *item_cur {
            Some(il) => {
                let itm: &Item = &(*il).head
                if itm.kind == ItemKind::ItemFn {
                    let fdef_ref: &Option<Box<FnDef>> = &itm.fn_def
                    match *fdef_ref {
                        Some(fd) => {
                            fn_offsets[fn_idx as usize] = code.len
                            code = so_ast_compile_fn(code, &(*fd), fn_names, fn_count)
                            let ns = str_from_bytes(itm.name.buf, itm.name.len)
                            print("emit-so: fn=")
                            print(ns)
                            if itm.is_pub { print(" [EXPORT]") }
                            print(" off=")
                            print_int(fn_offsets[fn_idx as usize])
                            print(" sz=")
                            print_int(code.len - fn_offsets[fn_idx as usize])
                            print("\n")
                        }
                        _ => { fn_offsets[fn_idx as usize] = code.len }
                    }
                    fn_idx = fn_idx + 1
                }
                item_cur = &(*il).tail
            }
            _ => break
        }
    }

    // Patch call placeholders (CAFE markers)
    var pi: i64 = 0
    while pi < code.len - 4 {
        if code.bytes[pi as usize] == (0xe8 as i8) &&
           code.bytes[(pi + 3) as usize] == (0xCA as i8) &&
           code.bytes[(pi + 4) as usize] == (0xFE as i8) {
            let lo_byte = code.bytes[(pi + 1) as usize] as i64
            let hi_byte = code.bytes[(pi + 2) as usize] as i64
            let target_idx = (lo_byte & 0xFF) + ((hi_byte & 0xFF) << 8)
            if target_idx >= 0 && target_idx < fn_count {
                let target_off = fn_offsets[target_idx as usize]
                let disp = target_off - (pi + 5)
                code.bytes[(pi + 1) as usize] = (disp & 0xFF) as i8
                code.bytes[(pi + 2) as usize] = ((disp >> 8) & 0xFF) as i8
                code.bytes[(pi + 3) as usize] = ((disp >> 16) & 0xFF) as i8
                code.bytes[(pi + 4) as usize] = ((disp >> 24) & 0xFF) as i8
            }
        }
        pi = pi + 1
    }

    let text_size = code.len
    print("emit-so: text_size=")
    print_int(text_size)
    print("\n")

    // ====================================================================
    // Build ET_DYN ELF with .text + .dynsym + .dynstr + .hash + .dynamic
    // Layout: ELF hdr (64) + 2 phdrs (112) = 176 bytes header
    //         text @ 4096, then metadata sections
    // ====================================================================

    let text_off: i64 = 4096

    // Build .dynstr: \0 + name1\0 + name2\0 + ...
    var dynstr: [i8; 2048] = [0; 2048]
    var dynstr_len: i64 = 1  // leading \0
    var export_count: i64 = 0
    var export_fn_ids: [i64; 64] = [0; 64]
    var export_str_offsets: [i64; 64] = [0; 64]
    var efi: i64 = 0
    while efi < fn_count {
        if fn_is_export[efi as usize] {
            export_str_offsets[export_count as usize] = dynstr_len
            export_fn_ids[export_count as usize] = efi
            var ci: i64 = 0
            while ci < fn_names[efi as usize].len && dynstr_len < 2040 {
                dynstr[dynstr_len as usize] = fn_names[efi as usize].buf[ci as usize]
                dynstr_len = dynstr_len + 1
                ci = ci + 1
            }
            dynstr[dynstr_len as usize] = 0
            dynstr_len = dynstr_len + 1
            export_count = export_count + 1
        }
        efi = efi + 1
    }
    print("emit-so: export_count=")
    print_int(export_count)
    print("\n")

    // Layout computation
    let dynsym_off = text_off + text_size
    let dynsym_entsize: i64 = 24
    let dynsym_count = export_count + 1  // NULL entry + exports
    let dynsym_size = dynsym_count * dynsym_entsize

    let dynstr_off = dynsym_off + dynsym_size
    // Align dynstr_len to 8
    let dynstr_size = ((dynstr_len + 7) / 8) * 8

    let hash_off = dynstr_off + dynstr_size
    // SysV hash: nbucket=1, nchain=dynsym_count, 1 bucket, dynsym_count chains
    let hash_size = (2 + 1 + dynsym_count) * 4

    let re_end = hash_off + hash_size

    // .dynamic MUST be on a separate page with RW permissions
    let dynamic_off: i64 = 8192  // 0x2000, page-aligned
    // DT_HASH, DT_STRTAB, DT_SYMTAB, DT_STRSZ, DT_SYMENT, DT_NULL = 6 entries
    let dynamic_size: i64 = 6 * 16

    let shstrtab_off = dynamic_off + dynamic_size
    // .shstrtab content: \0 .text\0 .dynsym\0 .dynstr\0 .hash\0 .dynamic\0 .shstrtab\0
    // offsets:            0  1       7         15        23      29         38
    let shstrtab_size: i64 = 48

    let shdrs_off = ((shstrtab_off + shstrtab_size + 7) / 8) * 8
    let shdr_count: i64 = 7  // NULL + .text + .dynsym + .dynstr + .hash + .dynamic + .shstrtab
    let shdrs_size = shdr_count * 64
    let total_size = shdrs_off + shdrs_size

    // Build output buffer
    var out: [i8; 65536] = [0; 65536]

    // ELF header (64 bytes)
    out[0 as usize] = 0x7f as i8; out[1 as usize] = 69 as i8; out[2 as usize] = 76 as i8; out[3 as usize] = 70 as i8
    out[4 as usize] = 2 as i8  // EI_CLASS: 64-bit
    out[5 as usize] = 1 as i8  // EI_DATA: little-endian
    out[6 as usize] = 1 as i8  // EI_VERSION
    out = so_put_u16(out, 16, 3)  // e_type: ET_DYN
    out = so_put_u16(out, 18, 0x3e)  // e_machine: x86-64
    out = so_put_u32(out, 20, 1)  // e_version
    out = so_put_u64(out, 24, 0)  // e_entry (none for .so)
    out = so_put_u64(out, 32, 64)  // e_phoff
    out = so_put_u64(out, 40, shdrs_off)  // e_shoff
    out = so_put_u32(out, 44, 0)  // e_flags
    out = so_put_u16(out, 52, 64)  // e_ehsize
    out = so_put_u16(out, 54, 56)  // e_phentsize
    out = so_put_u16(out, 56, 3)  // e_phnum (PT_LOAD RE + PT_LOAD RW + PT_DYNAMIC)
    out = so_put_u16(out, 58, 64)  // e_shentsize
    out = so_put_u16(out, 60, shdr_count)  // e_shnum
    out = so_put_u16(out, 62, 6)  // e_shstrndx (index of .shstrtab)

    // Program headers (2 × 56 bytes at offset 64)
    // PHDR 0: PT_LOAD (RE) — .text + .dynsym + .dynstr + .hash (read-only)
    let ph0 = 64
    out = so_put_u32(out, ph0, 1)  // p_type: PT_LOAD
    out = so_put_u32(out, ph0 + 4, 5)  // p_flags: PF_R | PF_X
    out = so_put_u64(out, ph0 + 8, 0)  // p_offset
    out = so_put_u64(out, ph0 + 16, 0)  // p_vaddr
    out = so_put_u64(out, ph0 + 24, 0)  // p_paddr
    out = so_put_u64(out, ph0 + 32, re_end)  // p_filesz
    out = so_put_u64(out, ph0 + 40, re_end)  // p_memsz
    out = so_put_u64(out, ph0 + 48, 4096)  // p_align

    // PHDR 1: PT_LOAD (RW) — .dynamic on its own page
    let ph1 = 64 + 56
    out = so_put_u32(out, ph1, 1)  // p_type: PT_LOAD
    out = so_put_u32(out, ph1 + 4, 6)  // p_flags: PF_R | PF_W
    out = so_put_u64(out, ph1 + 8, dynamic_off)  // p_offset
    out = so_put_u64(out, ph1 + 16, dynamic_off)  // p_vaddr
    out = so_put_u64(out, ph1 + 24, dynamic_off)  // p_paddr
    out = so_put_u64(out, ph1 + 32, dynamic_size)  // p_filesz
    out = so_put_u64(out, ph1 + 40, dynamic_size)  // p_memsz
    out = so_put_u64(out, ph1 + 48, 4096)  // p_align

    // PHDR 2: PT_DYNAMIC
    let ph2 = 64 + 56 * 2
    out = so_put_u32(out, ph2, 2)  // p_type: PT_DYNAMIC
    out = so_put_u32(out, ph2 + 4, 6)  // p_flags: PF_R | PF_W
    out = so_put_u64(out, ph2 + 8, dynamic_off)  // p_offset
    out = so_put_u64(out, ph2 + 16, dynamic_off)  // p_vaddr
    out = so_put_u64(out, ph2 + 24, dynamic_off)  // p_paddr
    out = so_put_u64(out, ph2 + 32, dynamic_size)  // p_filesz
    out = so_put_u64(out, ph2 + 40, dynamic_size)  // p_memsz
    out = so_put_u64(out, ph2 + 48, 8)  // p_align

    // .text section (copy code bytes)
    var ti: i64 = 0
    while ti < text_size && (text_off + ti) < 65536 {
        out[(text_off + ti) as usize] = code.bytes[ti as usize]
        ti = ti + 1
    }

    // .dynsym section
    // Entry 0: NULL symbol (24 zero bytes — already zero)
    // Entries 1..N: exported functions
    var ei: i64 = 0
    while ei < export_count {
        let sym_off = dynsym_off + (ei + 1) * dynsym_entsize
        out = so_put_u32(out, sym_off, export_str_offsets[ei as usize])  // st_name
        let st_info = (1 * 16) + 2  // STB_GLOBAL << 4 | STT_FUNC
        out = so_put_u8(out, sym_off + 4, st_info)  // st_info
        out = so_put_u8(out, sym_off + 5, 0)  // st_other: STV_DEFAULT
        out = so_put_u16(out, sym_off + 6, 1)  // st_shndx: .text section index
        let fn_id = export_fn_ids[ei as usize]
        out = so_put_u64(out, sym_off + 8, text_off + fn_offsets[fn_id as usize])  // st_value
        let fn_size = if fn_id + 1 < fn_count {
            fn_offsets[(fn_id + 1) as usize] - fn_offsets[fn_id as usize]
        } else {
            text_size - fn_offsets[fn_id as usize]
        }
        out = so_put_u64(out, sym_off + 16, fn_size)  // st_size
        ei = ei + 1
    }

    // .dynstr section (copy dynstr bytes)
    var di: i64 = 0
    while di < dynstr_len {
        out[(dynstr_off + di) as usize] = dynstr[di as usize]
        di = di + 1
    }

    // .hash section (SysV hash, degenerate nbucket=1)
    out = so_put_u32(out, hash_off, 1)  // nbucket
    out = so_put_u32(out, hash_off + 4, dynsym_count)  // nchain
    out = so_put_u32(out, hash_off + 8, 1)  // bucket[0] = 1 (first non-NULL sym)
    // chain[0] = STN_UNDEF (0), chain[1..N] = next in bucket
    var hi: i64 = 0
    while hi < dynsym_count {
        let chain_val = if hi == 0 { 0 }
                        else if hi + 1 < dynsym_count { hi + 1 }
                        else { 0 }
        out = so_put_u32(out, hash_off + 12 + hi * 4, chain_val)
        hi = hi + 1
    }

    // .dynamic section (6 entries × 16 bytes)
    // DT_HASH
    out = so_put_u64(out, dynamic_off, 4)  // DT_HASH
    out = so_put_u64(out, dynamic_off + 8, hash_off)
    // DT_STRTAB
    out = so_put_u64(out, dynamic_off + 16, 5)  // DT_STRTAB
    out = so_put_u64(out, dynamic_off + 24, dynstr_off)
    // DT_SYMTAB
    out = so_put_u64(out, dynamic_off + 32, 6)  // DT_SYMTAB
    out = so_put_u64(out, dynamic_off + 40, dynsym_off)
    // DT_STRSZ
    out = so_put_u64(out, dynamic_off + 48, 10)  // DT_STRSZ
    out = so_put_u64(out, dynamic_off + 56, dynstr_len)
    // DT_SYMENT
    out = so_put_u64(out, dynamic_off + 64, 11)  // DT_SYMENT
    out = so_put_u64(out, dynamic_off + 72, dynsym_entsize)
    // DT_NULL
    out = so_put_u64(out, dynamic_off + 80, 0)  // DT_NULL
    out = so_put_u64(out, dynamic_off + 88, 0)

    // .shstrtab section
    // \0.text\0.dynsym\0.dynstr\0.hash\0.dynamic\0.shstrtab\0
    var sn: i64 = shstrtab_off
    out[sn as usize] = 0; sn = sn + 1
    // .text (offset 1)
    out[sn as usize] = 46; sn = sn + 1  // '.'
    out[sn as usize] = 116; sn = sn + 1  // 't'
    out[sn as usize] = 101; sn = sn + 1  // 'e'
    out[sn as usize] = 120; sn = sn + 1  // 'x'
    out[sn as usize] = 116; sn = sn + 1  // 't'
    out[sn as usize] = 0; sn = sn + 1
    // .dynsym (offset 7)
    out[sn as usize] = 46; sn = sn + 1; out[sn as usize] = 100; sn = sn + 1
    out[sn as usize] = 121; sn = sn + 1; out[sn as usize] = 110; sn = sn + 1
    out[sn as usize] = 115; sn = sn + 1; out[sn as usize] = 121; sn = sn + 1
    out[sn as usize] = 109; sn = sn + 1; out[sn as usize] = 0; sn = sn + 1
    // .dynstr (offset 15)
    out[sn as usize] = 46; sn = sn + 1; out[sn as usize] = 100; sn = sn + 1
    out[sn as usize] = 121; sn = sn + 1; out[sn as usize] = 110; sn = sn + 1
    out[sn as usize] = 115; sn = sn + 1; out[sn as usize] = 116; sn = sn + 1
    out[sn as usize] = 114; sn = sn + 1; out[sn as usize] = 0; sn = sn + 1
    // .hash (offset 23)
    out[sn as usize] = 46; sn = sn + 1; out[sn as usize] = 104; sn = sn + 1
    out[sn as usize] = 97; sn = sn + 1; out[sn as usize] = 115; sn = sn + 1
    out[sn as usize] = 104; sn = sn + 1; out[sn as usize] = 0; sn = sn + 1
    // .dynamic (offset 29)
    out[sn as usize] = 46; sn = sn + 1; out[sn as usize] = 100; sn = sn + 1
    out[sn as usize] = 121; sn = sn + 1; out[sn as usize] = 110; sn = sn + 1
    out[sn as usize] = 97; sn = sn + 1; out[sn as usize] = 109; sn = sn + 1
    out[sn as usize] = 105; sn = sn + 1; out[sn as usize] = 99; sn = sn + 1
    out[sn as usize] = 0; sn = sn + 1
    // .shstrtab (offset 38)
    out[sn as usize] = 46; sn = sn + 1; out[sn as usize] = 115; sn = sn + 1
    out[sn as usize] = 104; sn = sn + 1; out[sn as usize] = 115; sn = sn + 1
    out[sn as usize] = 116; sn = sn + 1; out[sn as usize] = 114; sn = sn + 1
    out[sn as usize] = 116; sn = sn + 1; out[sn as usize] = 97; sn = sn + 1
    out[sn as usize] = 98; sn = sn + 1; out[sn as usize] = 0; sn = sn + 1

    // Section headers (7 × 64 bytes)
    // SHdr 0: NULL (64 zero bytes — already zero)
    // SHdr 1: .text
    var sh = shdrs_off + 64
    out = so_put_u32(out, sh, 1)  // sh_name
    out = so_put_u32(out, sh + 4, 1)  // sh_type: SHT_PROGBITS
    out = so_put_u64(out, sh + 8, 6)  // sh_flags: SHF_ALLOC | SHF_EXECINSTR
    out = so_put_u64(out, sh + 16, text_off)  // sh_addr
    out = so_put_u64(out, sh + 24, text_off)  // sh_offset
    out = so_put_u64(out, sh + 32, text_size)  // sh_size
    out = so_put_u64(out, sh + 56, 16)  // sh_addralign

    // SHdr 2: .dynsym
    sh = shdrs_off + 64 * 2
    out = so_put_u32(out, sh, 7)  // sh_name
    out = so_put_u32(out, sh + 4, 11)  // sh_type: SHT_DYNSYM
    out = so_put_u64(out, sh + 8, 2)  // sh_flags: SHF_ALLOC
    out = so_put_u64(out, sh + 16, dynsym_off)  // sh_addr
    out = so_put_u64(out, sh + 24, dynsym_off)  // sh_offset
    out = so_put_u64(out, sh + 32, dynsym_size)  // sh_size
    out = so_put_u32(out, sh + 40, 3)  // sh_link: .dynstr
    out = so_put_u32(out, sh + 44, 1)  // sh_info: first non-local sym
    out = so_put_u64(out, sh + 56, dynsym_entsize)  // sh_entsize

    // SHdr 3: .dynstr
    sh = shdrs_off + 64 * 3
    out = so_put_u32(out, sh, 15)  // sh_name
    out = so_put_u32(out, sh + 4, 3)  // sh_type: SHT_STRTAB
    out = so_put_u64(out, sh + 8, 2)  // sh_flags: SHF_ALLOC
    out = so_put_u64(out, sh + 16, dynstr_off)  // sh_addr
    out = so_put_u64(out, sh + 24, dynstr_off)  // sh_offset
    out = so_put_u64(out, sh + 32, dynstr_len)  // sh_size

    // SHdr 4: .hash
    sh = shdrs_off + 64 * 4
    out = so_put_u32(out, sh, 23)  // sh_name
    out = so_put_u32(out, sh + 4, 5)  // sh_type: SHT_HASH
    out = so_put_u64(out, sh + 8, 2)  // sh_flags: SHF_ALLOC
    out = so_put_u64(out, sh + 16, hash_off)  // sh_addr
    out = so_put_u64(out, sh + 24, hash_off)  // sh_offset
    out = so_put_u64(out, sh + 32, hash_size)  // sh_size
    out = so_put_u32(out, sh + 40, 2)  // sh_link: .dynsym
    out = so_put_u64(out, sh + 56, 4)  // sh_entsize

    // SHdr 5: .dynamic
    sh = shdrs_off + 64 * 5
    out = so_put_u32(out, sh, 29)  // sh_name
    out = so_put_u32(out, sh + 4, 6)  // sh_type: SHT_DYNAMIC
    out = so_put_u64(out, sh + 8, 3)  // sh_flags: SHF_ALLOC | SHF_WRITE
    out = so_put_u64(out, sh + 16, dynamic_off)  // sh_addr
    out = so_put_u64(out, sh + 24, dynamic_off)  // sh_offset
    out = so_put_u64(out, sh + 32, dynamic_size)  // sh_size
    out = so_put_u32(out, sh + 40, 3)  // sh_link: .dynstr
    out = so_put_u64(out, sh + 56, 16)  // sh_entsize

    // SHdr 6: .shstrtab
    sh = shdrs_off + 64 * 6
    out = so_put_u32(out, sh, 38)  // sh_name
    out = so_put_u32(out, sh + 4, 3)  // sh_type: SHT_STRTAB
    out = so_put_u64(out, sh + 24, shstrtab_off)  // sh_offset
    out = so_put_u64(out, sh + 32, shstrtab_size)  // sh_size

    // Write to file
    let elf = Elf64Binary { bytes: out, len: total_size }
    let ok = io_write_elf_to_file(output_path, elf)
    if ok {
        print("emit-so: written to ")
        print(output_path)
        print(" (")
        print(int_to_string(total_size))
        print(" bytes)\n")
        return 0
    }
    print("emit-so: write failed\n")
    return 1
}
