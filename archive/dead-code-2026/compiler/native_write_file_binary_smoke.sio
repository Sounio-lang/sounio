fn main() -> i64 with IO {
    let path = "/tmp/sounio_write_file_binary.bin"
    let blob: [i8; 24] = [0 as i8; 24]
    let written = write_file(path, blob, 24)
    if written < 0 {
        print("FAIL: write_file return\n")
        return 1
    }

    let raw = read_file(path)
    let a = read_f64(raw, 0)
    let b = read_f64(raw, 1)
    let c = read_f64(raw, 2)

    if a != 0.0 {
        print("FAIL: read_f64 a\n")
        return 2
    }
    if b != 0.0 {
        print("FAIL: read_f64 b\n")
        return 3
    }
    if c != 0.0 {
        print("FAIL: read_f64 c\n")
        return 4
    }

    print("ALL PASS\n")
    0
}
