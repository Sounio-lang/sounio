// self-hosted::compiler::module_native_driver_smoke
//
// Import-contract smoke for the modular native driver facade.

use module_native_driver::{compile_multimodule_llvm, compile_multimodule_native}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    if false {
        return compile_multimodule_native(
            "examples/hello.sio",
            "/tmp/sounio-module-native-driver-smoke.bin",
            "x86_64-linux",
            "auto",
            true,
            "",
            "",
            false
        )
    }

    let rc = compile_multimodule_llvm("examples/hello.sio", "/tmp/sounio-module-native-driver-smoke.ll", false)
    if rc == 1 {
        0
    } else {
        1
    }
}
