// Test: direct var mutation vs &! mutation

struct SmallBox {
    value: i64,
    count: i64,
}

fn small_inc(b: &! SmallBox) -> () with Mut {
    (*b).value = (*b).value + 1
    (*b).count = (*b).count + 10
}

fn main() -> i64 with IO, Mut, Panic, Div {
    // Test 1: direct var mutation (no &!)
    var s = SmallBox { value: 0, count: 0 }
    s.value = s.value + 1
    s.count = s.count + 10
    print("direct: value=")
    print_int(s.value)
    print(" count=")
    print_int(s.count)
    print("\n")

    // Test 2: &! mutation
    var s2 = SmallBox { value: 0, count: 0 }
    small_inc(&! s2)
    print("ref: value=")
    print_int(s2.value)
    print(" count=")
    print_int(s2.count)
    print("\n")

    0
}
