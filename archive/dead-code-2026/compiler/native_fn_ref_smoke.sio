fn add_one(x: i64) -> i64 { x + 1 }
fn square(x: f64) -> f64 { x * x }

fn apply_i64(f: fn(i64) -> i64, x: i64) -> i64 {
    f(x)
}

fn apply_f64(f: fn(f64) -> f64, x: f64) -> f64 {
    f(x)
}

fn fill_rhs(t: f64, y: &[f64; 64], out: &![f64; 64]) with Mut {
    out[0] = t + y[0]
}

fn apply_rhs(
    f: fn(f64, &[f64; 64], &![f64; 64]) with Mut,
    t: f64,
    y: &[f64; 64],
    out: &![f64; 64]
) with Mut {
    f(t, y, out)
}

fn main() -> i64 with IO, Mut {
    let r1 = apply_i64(add_one, 41)
    if r1 != 42 {
        print("FAIL: fn(i64) -> i64\n")
        return 1
    }

    let r2 = apply_f64(square, 3.0)
    if r2 != 9.0 {
        print("FAIL: fn(f64) -> f64\n")
        return 2
    }

    var y: [f64; 64] = [0.0; 64]
    y[0] = 2.0
    var out: [f64; 64] = [0.0; 64]
    apply_rhs(fill_rhs, 1.5, &y, &!out)
    if out[0] != 3.5 {
        print("FAIL: fn(f64, &[f64; 64], &![f64; 64]) with Mut\n")
        return 3
    }

    print("ALL PASS\n")
    0
}
