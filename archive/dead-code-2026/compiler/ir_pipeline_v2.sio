// self-hosted::compiler::ir_pipeline_v2
//
// IR lowering verification driver. Demonstrates that the flat-owned pre-population
// approach (via lower_prepopulate.sio) correctly assigns fn_ids 0, 1, 2, ...
// to each function — fixing the JIT &! bug where fn_count writes were lost.
//
// If the bug is present: all functions map to fn_id=0, so only functions[0] has
// instructions; functions[1..] are empty.
// If the fix works: all functions have instr_count > 0 at their correct indices.
//
// Usage:
//   souc run self-hosted/compiler/ir_pipeline_v2.sio -- <source.sio>

use lexer::mod::*
use parser::ast::*
use ir::ir::*
use check::dependent::*
use check::types::*
use check::mod::{check_program, check_program_epistemic_into}
use check::ownership::*
use check::lint::*
use check::layout::*
use io::file_write::*
use interop::contract::*
use native::aarch64::*
use native::encode::*
use native::elf::*
use native::elf_bulk::*
use native::macho::*
use native::reloc::*
use native::frame::*
use native::lower_ir::*
use native::machine_ir::*
use native::gc::*
use native::runtime_context::*
use native::stack_maps::*
use native::target_policy::*
use wasm::core::*
use wasm::encode::*
use wasm::lower::*
use native::codegen::*
use parser::mod::{parse_program_preloaded, count_items}
use parser::parser::{parser_last_error_count}
use ir::opt_strategy::{ir_opt_apply_strategy, ir_opt_find_return_vreg, ir_opt_max_label, ir_opt_max_vreg}
use ir::lower::{ir_patch_validated_calls, lower_program_to_ir, lower_program_to_ir_with_epistemic, lower_program_to_ir_probe_summary_ref, lower_program_to_ir_probe_summary_box_ref, lower_program_to_ir_summary_box_probe_with_epistemic_ref, lower_program_function_body_from_summary_with_epistemic_ref, lower_program_to_ir_summary_flat_with_epistemic_ref, lower_program_function_body_from_summary_flat_with_epistemic_ref, lower_program_to_ir_summary_flat_owned_with_epistemic_ref, lowerer_new_from_program_summary_flat, Lowerer}
use ir::lower::{lower_program_to_ir_with_epistemic_ref, lower_program_to_ir_ordered_with_epistemic_boxed_trace_ref}
use ir::lower::{lower_program_function_body_from_program_with_epistemic_ref}
use ir::const_prop::{cp_check_load_imm, cp_empty_instrs, cp_make_test_func, cp_optimize_function}
use ir::dce::{dce_check_nop, dce_empty_instrs, dce_make_test_func, dce_optimize_function}
use ir::profile::*
use ir::inline::*
use ir::layout::*
use ir::opt_cleanup::*
use ir::egraph::*
use ir::loop_opt::*
use ir::tailcall::*
use native::regalloc::*
use native::peephole::*

// Required by codegen flat-namespace dependency chain.
fn char_from_i64(n: i64) -> string with Mut, Panic {
    if n == 0 { "0" }
    else if n == 1 { "1" }
    else if n == 2 { "2" }
    else if n == 3 { "3" }
    else if n == 4 { "4" }
    else if n == 5 { "5" }
    else if n == 6 { "6" }
    else if n == 7 { "7" }
    else if n == 8 { "8" }
    else if n == 9 { "9" }
    else { "?" }
}

fn pow10_idx(idx: i64) -> i64 {
    if idx == 0 { 1000000000000000000 }
    else if idx == 1 { 100000000000000000 }
    else if idx == 2 { 10000000000000000 }
    else if idx == 3 { 1000000000000000 }
    else if idx == 4 { 100000000000000 }
    else if idx == 5 { 10000000000000 }
    else if idx == 6 { 1000000000000 }
    else if idx == 7 { 100000000000 }
    else if idx == 8 { 10000000000 }
    else if idx == 9 { 1000000000 }
    else if idx == 10 { 100000000 }
    else if idx == 11 { 10000000 }
    else if idx == 12 { 1000000 }
    else if idx == 13 { 100000 }
    else if idx == 14 { 10000 }
    else if idx == 15 { 1000 }
    else if idx == 16 { 100 }
    else if idx == 17 { 10 }
    else { 1 }
}

fn digit_for_power(rem: i64, power: i64) -> i64 {
    if rem <= (0 - (9 * power)) { 9 }
    else if rem <= (0 - (8 * power)) { 8 }
    else if rem <= (0 - (7 * power)) { 7 }
    else if rem <= (0 - (6 * power)) { 6 }
    else if rem <= (0 - (5 * power)) { 5 }
    else if rem <= (0 - (4 * power)) { 4 }
    else if rem <= (0 - (3 * power)) { 3 }
    else if rem <= (0 - (2 * power)) { 2 }
    else if rem <= (0 - power) { 1 }
    else { 0 }
}

fn i64_to_digits_no_div(rem: i64, idx: i64, started: bool) -> string with Mut, Panic {
    if idx >= 19 { return "" }
    let power = pow10_idx(idx)
    let digit = digit_for_power(rem, power)
    let rem_next = rem + (digit * power)
    let emit = started || digit > 0 || idx == 18
    let head = if emit { char_from_i64(digit) } else { "" }
    head + i64_to_digits_no_div(rem_next, idx + 1, emit)
}

fn int_to_string(n: i64) -> string with Mut, Panic, Div {
    if n == 0 { return "0" }
    let negative = n < 0
    let rem = if negative { n } else { 0 - n }
    let digits = i64_to_digits_no_div(rem, 0, false)
    if negative { "-" + digits } else { digits }
}

fn load_source_file(path: string) -> Program with IO, Mut, Div, Panic, Alloc {
    let data = read_file(path)
    let size = file_size(path)
    var buf: [i8; 1048576] = [0; 1048576]
    var i: i64 = 0
    while i < size && i < 1048576 {
        buf[i as usize] = data[i as usize]
        i = i + 1
    }
    let state = lex(buf, size, 0)
    parse_program_preloaded(state.token_count)
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    if argc < 1 {
        print("ir_v2: usage: ir_pipeline_v2.sio <source.sio>\n")
        return 1
    }
    let source_path = get_arg(0)

    print("ir_v2: source=")
    print(source_path)
    print("\n")

    // Phase 0: Parse
    let prog = load_source_file(source_path)
    if parser_last_error_count() > 0 {
        print("ir_v2: parse_error\n")
        return 1
    }
    print("ir_v2: parse_ok\n")

    let epistemic = ir_empty_epistemic_section()

    // Phase 1: Flat-owned summary — correct fn_count, no Box mutation bugs.
    let summary_result = lower_program_to_ir_summary_flat_owned_with_epistemic_ref(&prog, epistemic)
    if summary_result.had_error {
        print("ir_v2: summary_error\n")
        return 2
    }
    let fn_count = summary_result.summary.module.fn_count
    if fn_count <= 0 {
        print("ir_v2: empty_module\n")
        return 2
    }
    print("ir_v2: summary_ok fn_count=")
    print_int(fn_count)
    print("\n")

    // Phase 2: Create pre-populated Lowerer from flat summary.
    // This gives the Lowerer a Box<IrModule> with fn_count and function
    // names already set — so find_or_add_fn_id takes the FIND path (no broken writes).
    var lo = lowerer_new_from_program_summary_flat(&summary_result.summary, epistemic)

    // Phase 3: Lower all function bodies using the pre-populated Lowerer.
    lo = lo.lower_program_bodies_ref(&prog.items)

    if lo.had_error {
        print("ir_v2: lower_error count=")
        print_int(lo.error_count)
        print("\n")
        return 3
    }
    print("ir_v2: lower_ok\n")

    // Phase 4: Verify — each function at index i should have instr_count > 0.
    // If the fn_count bug was present, only functions[0] would have instructions.
    var all_ok = true
    var i: i64 = 0
    while i < fn_count {
        let func = lo.module.functions[i as usize]
        let name = func.name
        print("ir_v2: fn=")
        print(str_from_bytes(name.buf, name.len))
        print(" id=")
        print_int(i)
        print(" instrs=")
        print_int(func.instr_count)
        print(" regs=")
        print_int(func.reg_count)
        print(" params=")
        print_int(func.param_count)
        if func.instr_count > 0 {
            print(" ok\n")
        } else {
            print(" EMPTY\n")
            all_ok = false
        }
        i = i + 1
    }

    if all_ok {
        print("ir_v2: all_fn_ids_distinct=true\n")
        print("ir_v2: ok\n")
        0
    } else {
        print("ir_v2: all_fn_ids_distinct=false (fn_count bug still present)\n")
        1
    }
}
