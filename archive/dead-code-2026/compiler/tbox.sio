// compiler::tbox — Transfer Box for safe cross-function parameter passing.
//
// TBox avoids boot4's fragile register-based string/struct parameter ABI
// by writing data into globally-visible buffers before calling.
// RBox (return box) is handled via the items-path approach: returning
// Option<Box<ItemList>> (1 slot) instead of Program (132+ slots).

module compiler::tbox

var TBOX_LOAD_PATH_BUF: [i8; 512] = [0; 512]
var TBOX_LOAD_PATH_LEN: i64 = 0

pub fn tbox_load_write_path(path: string) -> i64 with Mut, Panic, Div {
    var len = str_len(path)
    if len < 0 { len = 0 }
    if len > 512 { len = 512 }
    var i: i64 = 0
    while i < len {
        TBOX_LOAD_PATH_BUF[i as usize] = str_char_at(path, i) as i8
        i = i + 1
    }
    TBOX_LOAD_PATH_LEN = len
    len
}

pub fn tbox_load_read_path() -> string with Mut, Panic, Div {
    str_from_bytes(TBOX_LOAD_PATH_BUF, TBOX_LOAD_PATH_LEN)
}
