use ir::ir::*

fn set_reg_only(out: &! IrFunction) with Mut {
    (*out).reg_count = 6
    (*out).instr_count = 2
}

fn set_first_instr(out: &! IrFunction) with Mut {
    (*out).instrs[0] = ir_load_imm(1, 42)
}

fn main() -> i64 with IO, Mut, Panic {
    var f = ir_empty_function()
    set_reg_only(&! f)
    print("after_reg reg_count=")
    print_int(f.reg_count)
    print(" instr_count=")
    print_int(f.instr_count)
    print("\n")

    set_first_instr(&! f)
    print("after_instr op=")
    if f.instrs[0].op == IrOpcode::IrLoadImm { print("loadimm") } else { print("other") }
    print(" imm=")
    print_int(f.instrs[0].imm_i64)
    print("\n")
    0
}
