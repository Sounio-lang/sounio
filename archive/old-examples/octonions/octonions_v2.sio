struct Octonion {
    a: f32,
    b: f32,
    c: f32,
    d: f32,
    e: f32,
    f: f32,
    g: f32,
    h: }

fn oct(a: f32, b: f32, c: f32, d: f32, e: f32, f: f32, g: f32, h: f32) -> Octonion {
    return Octonion { a: a, b: b, c: c, d: d, e: e, f: f, g: g, h: h }
}

fn oct_norm_sq(o: Octonion) -> f32 {
    return o.a*o.a + o.b*o.b + o.c*o.c + o.d*o.d + o.e*o.e + o.f*o.f + o.g*o.g + o.h*o.h
}

fn oct_real(o: Octonion) -> f32 {
    return o.a
}

fn main() {
    print("===========================================")
    print("Octonion Basic Operations Test Suite")
    print("===========================================")
    print("")

    print("Test 1: Construction")
    let o1 = oct(3.0f32, 4.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32)
    print("Created octonion")
    print("")

    print("Test 2: Norm Squared")
    let nsq = oct_norm_sq(o1)
    print("norm_sq of (3,4,0,...) = 25")
    if nsq > 24.9f32 && nsq < 25.1f32 {
        print("✓ PASS")
    }
    print("")

    print("Test 3: Real Part")
    let r = oct_real(o1)
    print("real part of (3,4,0,...) = 3")
    if r > 2.9f32 && r < 3.1f32 {
        print("✓ PASS")
    }
    print("")

    print("===========================================")
    print("Tests Complete")
    print("===========================================")
}
