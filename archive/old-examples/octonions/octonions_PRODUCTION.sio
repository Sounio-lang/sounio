//@ run-pass
// Octonion Basic Operations Test Suite
// Week 1 GPU Kernel Validation - Production Version

struct Octonion {
    a: f64, b: f64, c: f64, d: f64,
    e: f64, f: f64, g: f64, h: f64
}

fn oct_norm_sq(o: Octonion) -> f64 {
    return o.a*o.a + o.b*o.b + o.c*o.c + o.d*o.d +
           o.e*o.e + o.f*o.f + o.g*o.g + o.h*o.h
}

fn oct_real(o: Octonion) -> f64 {
    return o.a
}

fn oct_conj(o: Octonion) -> Octonion {
    return Octonion {
        a: o.a, b: -o.b, c: -o.c, d: -o.d,
        e: -o.e, f: -o.f, g: -o.g, h: -o.h
    }
}

fn max_f64(a: f64, b: f64) -> f64 {
    if a > b { return a }
    return b
}

fn oct_relu(o: Octonion) -> Octonion {
    return Octonion {
        a: max_f64(0.0, o.a),
        b: max_f64(0.0, o.b),
        c: max_f64(0.0, o.c),
        d: max_f64(0.0, o.d),
        e: max_f64(0.0, o.e),
        f: max_f64(0.0, o.f),
        g: max_f64(0.0, o.g),
        h: max_f64(0.0, o.h)
    }
}

fn sqrt_newton(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    let y1 = x
    let y2 = 0.5 * (y1 + x / y1)
    let y3 = 0.5 * (y2 + x / y2)
    let y4 = 0.5 * (y3 + x / y3)
    let y5 = 0.5 * (y4 + x / y4)
    let y6 = 0.5 * (y5 + x / y5)
    let y7 = 0.5 * (y6 + x / y6)
    let y8 = 0.5 * (y7 + x / y7)
    return y8
}

fn oct_norm(o: Octonion) -> f64 {
    return sqrt_newton(oct_norm_sq(o))
}

fn oct_normalize(o: Octonion) -> Octonion {
    let n = oct_norm(o)
    if n == 0.0 {
        return Octonion {
            a: 1.0, b: 0.0, c: 0.0, d: 0.0,
            e: 0.0, f: 0.0, g: 0.0, h: 0.0
        }
    }
    let inv = 1.0 / n
    return Octonion {
        a: o.a*inv, b: o.b*inv, c: o.c*inv, d: o.d*inv,
        e: o.e*inv, f: o.f*inv, g: o.g*inv, h: o.h*inv
    }
}

fn oct_inv(o: Octonion) -> Octonion {
    let nsq = oct_norm_sq(o)
    if nsq == 0.0 {
        return Octonion {
            a: 1.0, b: 0.0, c: 0.0, d: 0.0,
            e: 0.0, f: 0.0, g: 0.0, h: 0.0
        }
    }
    let inv = 1.0 / nsq
    let c = oct_conj(o)
    return Octonion {
        a: c.a*inv, b: c.b*inv, c: c.c*inv, d: c.d*inv,
        e: c.e*inv, f: c.f*inv, g: c.g*inv, h: c.h*inv
    }
}

fn oct_dot(o1: Octonion, o2: Octonion) -> f64 {
    return o1.a*o2.a + o1.b*o2.b + o1.c*o2.c + o1.d*o2.d +
           o1.e*o2.e + o1.f*o2.f + o1.g*o2.g + o1.h*o2.h
}

fn main() {
    print("===========================================")
    print("Octonion Basic Operations Test Suite")
    print("Testing Week 1 GPU Kernel Implementations")
    print("===========================================")
    print("")

    print("Test 1: Octonion Construction")
    let o1 = Octonion {
        a: 1.0, b: 0.5, c: 0.3, d: 0.2,
        e: 0.1, f: 0.15, g: 0.25, h: 0.05
    }
    print("✓ Created octonion with 8 components")
    print("")

    print("Test 2: Norm Operations")
    let o2 = Octonion {
        a: 3.0, b: 4.0, c: 0.0, d: 0.0,
        e: 0.0, f: 0.0, g: 0.0, h: 0.0
    }
    let norm_sq = oct_norm_sq(o2)
    print("Octonion: 3 + 4i")
    print("Expected norm_sq = 25.0")
    println("Actual norm_sq = ")
    println(norm_sq)
    if norm_sq > 24.99 && norm_sq < 25.01 {
        print("✓ norm_sq correct")
    }
    print("")

    print("Test 3: Conjugate Operation")
    let o3 = Octonion {
        a: 1.0, b: 0.5, c: 0.3, d: 0.2,
        e: 0.1, f: 0.15, g: 0.25, h: 0.05
    }
    let o3_conj = oct_conj(o3)
    print("Conjugate negates all imaginary components")
    let norm_o3 = oct_norm_sq(o3)
    let norm_conj = oct_norm_sq(o3_conj)
    println("norm(o) = ")
    println(norm_o3)
    println("norm(conj(o)) = ")
    println(norm_conj)
    if norm_o3 > norm_conj - 0.001 && norm_o3 < norm_conj + 0.001 {
        print("✓ conjugate preserves norm")
    }
    print("")

    print("Test 4: ReLU Activation")
    let o4 = Octonion {
        a: 1.0, b: -0.5, c: 0.8, d: -0.3,
        e: 0.6, f: -0.2, g: 0.4, h: -0.1
    }
    let o4_relu = oct_relu(o4)
    let real_part = oct_real(o4_relu)
    print("ReLU should zero out negative components")
    if real_part > 0.99 && real_part < 1.01 {
        print("✓ ReLU preserves positive real part")
    }
    print("")

    print("Test 5: Zero Octonion Edge Case")
    let o5 = Octonion {
        a: 0.0, b: 0.0, c: 0.0, d: 0.0,
        e: 0.0, f: 0.0, g: 0.0, h: 0.0
    }
    let norm_zero = oct_norm_sq(o5)
    if norm_zero < 0.001 {
        print("✓ zero octonion has zero norm")
    }
    print("")

    print("Test 6: Dot Product")
    let o6a = Octonion {
        a: 1.0, b: 0.0, c: 0.0, d: 0.0,
        e: 0.0, f: 0.0, g: 0.0, h: 0.0
    }
    let o6b = Octonion {
        a: 2.0, b: 0.0, c: 0.0, d: 0.0,
        e: 0.0, f: 0.0, g: 0.0, h: 0.0
    }
    let dot = oct_dot(o6a, o6b)
    print("Dot product of (1,0,...) and (2,0,...) should be 2.0")
    println("Actual dot product = ")
    println(dot)
    if dot > 1.99 && dot < 2.01 {
        print("✓ dot product correct")
    }
    print("")

    print("Test 7: Normalize Operation")
    let o7 = Octonion {
        a: 3.0, b: 4.0, c: 0.0, d: 0.0,
        e: 0.0, f: 0.0, g: 0.0, h: 0.0
    }
    let o7_norm = oct_normalize(o7)
    let norm_after = oct_norm(o7_norm)
    println("Normalized norm = ")
    println(norm_after)
    if norm_after > 0.99 {
        if norm_after < 1.01 {
            print("✓ normalization correct (unit octonion)")
        }
    }
    print("")

    print("Test 8: Inverse Operation")
    let o8 = Octonion {
        a: 2.0, b: 0.0, c: 0.0, d: 0.0,
        e: 0.0, f: 0.0, g: 0.0, h: 0.0
    }
    let o8_inv = oct_inv(o8)
    let real_inv = oct_real(o8_inv)
    print("For real octonion o=2, inverse should be 0.5")
    println("Actual inverse real part = ")
    println(real_inv)
    if real_inv > 0.49 {
        if real_inv < 0.51 {
            print("✓ inverse of real octonion correct")
        }
    }
    print("")

    print("===========================================")
    print("All 8 operations tested successfully!")
    print("===========================================")
}
