//@ run-pass
// Octonion Basic Operations - Functional implementation for JIT
// All mathematical operations for octonion algebra

struct Octonion {
    a: f32,
    b: f32,
    c: f32,
    d: f32,
    e: f32,
    f: f32,
    g: f32,
    h: f32
}

// Newton-Raphson sqrt - fully functional
fn sqrt_approx(x: f32, guess: f32, iterations: i32) -> f32 {
    if iterations == 0 {
        guess
    } else {
        let next_guess = 0.5f32 * (guess + x / guess)
        sqrt_approx(x, next_guess, iterations - 1)
    }
}

fn sqrt_f32(x: f32) -> f32 {
    if x <= 0.0f32 {
        0.0f32
    } else {
        sqrt_approx(x, x, 5)
    }
}

fn oct(a: f32, b: f32, c: f32, d: f32, e: f32, f: f32, g: f32, h: f32) -> Octonion {
    Octonion { a: a, b: b, c: c, d: d, e: e, f: f, g: g, h: h }
}

fn oct_norm_sq(o: Octonion) -> f32 {
    o.a*o.a + o.b*o.b + o.c*o.c + o.d*o.d +
    o.e*o.e + o.f*o.f + o.g*o.g + o.h*o.h
}

fn oct_norm(o: Octonion) -> f32 {
    sqrt_f32(oct_norm_sq(o))
}

fn oct_normalize(o: Octonion) -> Octonion {
    let n = oct_norm(o)
    if n == 0.0f32 {
        oct(1.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32)
    } else {
        let inv = 1.0f32 / n
        Octonion {
            a: o.a*inv, b: o.b*inv, c: o.c*inv, d: o.d*inv,
            e: o.e*inv, f: o.f*inv, g: o.g*inv, h: o.h*inv
        }
    }
}

fn oct_conj(o: Octonion) -> Octonion {
    Octonion {
        a: o.a, b: -o.b, c: -o.c, d: -o.d,
        e: -o.e, f: -o.f, g: -o.g, h: -o.h
    }
}

fn oct_relu(o: Octonion) -> Octonion {
    Octonion {
        a: if o.a > 0.0f32 { o.a } else { 0.0f32 },
        b: if o.b > 0.0f32 { o.b } else { 0.0f32 },
        c: if o.c > 0.0f32 { o.c } else { 0.0f32 },
        d: if o.d > 0.0f32 { o.d } else { 0.0f32 },
        e: if o.e > 0.0f32 { o.e } else { 0.0f32 },
        f: if o.f > 0.0f32 { o.f } else { 0.0f32 },
        g: if o.g > 0.0f32 { o.g } else { 0.0f32 },
        h: if o.h > 0.0f32 { o.h } else { 0.0f32 }
    }
}

fn oct_real(o: Octonion) -> f32 { o.a }

fn oct_inv(o: Octonion) -> Octonion {
    let nsq = oct_norm_sq(o)
    if nsq == 0.0f32 {
        oct(1.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32)
    } else {
        let inv = 1.0f32 / nsq
        let c = oct_conj(o)
        Octonion {
            a: c.a*inv, b: c.b*inv, c: c.c*inv, d: c.d*inv,
            e: c.e*inv, f: c.f*inv, g: c.g*inv, h: c.h*inv
        }
    }
}

fn oct_dot(o1: Octonion, o2: Octonion) -> f32 {
    o1.a*o2.a + o1.b*o2.b + o1.c*o2.c + o1.d*o2.d +
    o1.e*o2.e + o1.f*o2.f + o1.g*o2.g + o1.h*o2.h
}

fn main() {
    print("===========================================")
    print("Octonion Basic Operations Test Suite")
    print("Testing Week 1 GPU Kernel Implementations")
    print("===========================================")
    print("")

    print("Test 1: Octonion Construction")
    let o1 = oct(1.0f32, 0.5f32, 0.3f32, 0.2f32, 0.1f32, 0.15f32, 0.25f32, 0.05f32)
    print("Created octonion with 8 components")
    print("")

    print("Test 2: Norm Operations")
    let o2 = oct(3.0f32, 4.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32)
    let nsq = oct_norm_sq(o2)
    let n = oct_norm(o2)
    print("Octonion: 3 + 4i")
    print("Expected norm_sq = 25.0")
    print("Expected norm = 5.0")
    if nsq > 24.99f32 && nsq < 25.01f32 {
        print("✓ norm_sq correct")
    }
    if n > 4.99f32 && n < 5.01f32 {
        print("✓ norm correct")
    }
    print("")

    print("Test 3: Normalize Operation")
    let o3 = oct_normalize(o2)
    let n3 = oct_norm(o3)
    print("Normalized octonion should have norm = 1.0")
    if n3 > 0.99f32 && n3 < 1.01f32 {
        print("✓ normalization correct")
    }
    print("")

    print("Test 4: Conjugate Operation")
    let o4c = oct_conj(o1)
    let n4a = oct_norm(o1)
    let n4b = oct_norm(o4c)
    print("Conjugate negates all imaginary components")
    if n4a > n4b - 0.01f32 && n4a < n4b + 0.01f32 {
        print("✓ conjugate preserves norm")
    }
    print("")

    print("Test 5: ReLU Activation")
    let o5 = oct(1.0f32, -0.5f32, 0.8f32, -0.3f32, 0.6f32, -0.2f32, 0.4f32, -0.1f32)
    let o5r = oct_relu(o5)
    let r5 = oct_real(o5r)
    print("ReLU should zero out negative components")
    if r5 > 0.99f32 && r5 < 1.01f32 {
        print("✓ ReLU preserves positive real part")
    }
    print("")

    print("Test 6: Zero Octonion Edge Case")
    let o6 = oct(0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32)
    let n6 = oct_norm(o6)
    if n6 < 0.01f32 {
        print("✓ zero octonion has zero norm")
    }
    let o6n = oct_normalize(o6)
    let r6 = oct_real(o6n)
    if r6 > 0.99f32 && r6 < 1.01f32 {
        print("✓ normalizing zero returns identity")
    }
    print("")

    print("Test 7: Inverse Operation")
    let o7 = oct(2.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32)
    let o7i = oct_inv(o7)
    let r7 = oct_real(o7i)
    print("For real octonion o=2, inverse should be 0.5")
    if r7 > 0.49f32 && r7 < 0.51f32 {
        print("✓ inverse of real octonion correct")
    }
    print("")

    print("Test 8: Dot Product")
    let o8a = oct(1.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32)
    let o8b = oct(2.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32)
    let d8 = oct_dot(o8a, o8b)
    print("Dot product of (1,0,...) and (2,0,...) should be 2.0")
    if d8 > 1.99f32 && d8 < 2.01f32 {
        print("✓ dot product correct")
    }
    print("")

    print("===========================================")
    print("All basic operations tested")
    print("===========================================")
}
