    threshold_kind: i64,
    bool_threshold: bool,
    name_threshold: Name,
}

fn ir_empty_policy_requirement_info() -> IrPolicyRequirementInfo {
    IrPolicyRequirementInfo {
        metric_id: -1,
        metric_name: ir_empty_name(),
        op: CompareOp::CmpEq,
        threshold: 0.0,
        threshold_kind: 0,
        bool_threshold: false,
        name_threshold: ir_empty_name(),
    }
}

