        clifford_q: -1,
        unit_id: -1,
        refinement_id: -1,
        epistemic_meta_id: layout_id,
        robustness_level_id: -1,
        robustness_scope_id: -1,
    }
}

// TyMatrixShaped: Matrix<T, m, n>
//   inner = elem_ty, array_size = n (cols), algebra_kind = m (rows),
//   fn_sig_id = storage_kind, knowledge_epsilon = cond_milli, epistemic_meta_id = symmetry_tag
fn ty_matrix_shaped(elem_ty: TypeEntry, m: i64, n: i64, storage_kind: i64, cond_milli: f64, symmetry_tag: i64) -> TypeEntry with Alloc {
    TypeEntry {
        kind: TypeKind::TyMatrixShaped,
        name: Name { buf: [0; 128], len: 0 },
        inner: Some(Box::new(elem_ty)),
        array_size: n,
        fn_sig_id: storage_kind,
        tuple_elems: None,
        knowledge_epsilon: cond_milli,
        algebra_kind: m,
        clifford_p: -1,
        clifford_q: -1,
        unit_id: -1,
        refinement_id: -1,
        epistemic_meta_id: symmetry_tag,
        robustness_level_id: -1,
        robustness_scope_id: -1,
    }
}

// TyBroadcastable: Broadcastable<T, m, n>
