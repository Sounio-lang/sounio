fn kb_test_observe_transition_records_metadata_and_ir() -> bool with Mut, Panic, Div, Alloc, IO {
    let option_name = kb_name_from_str("opt")
    let transition_policy_name = kb_name_from_str("tp")
    let protocol_name = kb_name_from_str("proto")
    let monitoring_name = kb_name_from_str("mp")
    let commit_name = kb_name_from_str("commit_alternative")
    let observe_name = kb_name_from_str("observe_transition")
    var checker = checker_new()
    checker = kb_seed_transition_policy(checker, transition_policy_name, CompareOp::CmpLe, 0.05, 2)
    checker = kb_seed_alternative_option(checker, option_name, 45, 0.04)
    let transition_ty = checker.env.lookup(transition_policy_name)
    let option_ty = checker.env.lookup(option_name)
    checker = kb_seed_transition_protocol(checker, protocol_name, option_ty.epistemic_meta_id, transition_ty.epistemic_meta_id, 45)
    checker = kb_seed_monitoring_policy(checker, monitoring_name, -1, CompareOp::CmpLe, 0.0)
    let plan_expr = kb_call_expr3(commit_name, kb_int_expr(50), kb_ident_expr(option_name), kb_ident_expr(protocol_name))
    let pair = checker.check_expr(kb_call_expr3(observe_name, kb_int_expr(50), plan_expr, kb_ident_expr(monitoring_name)))
    let checked = pair.0
    let ty = pair.1
    if checked.error_count > 0
        || ty.kind != TypeKind::TyObservedTransition
        || checked.observed_transitions.count != 1 {
        return false
    }
    var ep = ir_empty_epistemic_section()
    checker_to_ir_epistemic_into(&checked, &!ep)
    let ok = ep.monitoring_policy_count == 1 &&
        ep.transition_plan_count == 1 &&
        ep.observed_transition_count == 1 &&
        ep.observed_transitions[0].monitoring_policy_id == 0
    ok
}

fn kb_test_rollback_transition_records_metadata_and_ir() -> bool with Mut, Panic, Div, Alloc, IO {
    let option_name = kb_name_from_str("opt")
