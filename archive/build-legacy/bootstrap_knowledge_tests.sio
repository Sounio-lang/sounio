    checker = kb_seed_monitoring_policy(checker, monitoring_name, TRANSITION_METRIC_MECHANISTIC_DIVERGENCE, CompareOp::CmpLe, 0.05)
    let plan_expr = kb_call_expr3(commit_name, kb_int_expr(50), kb_ident_expr(option_name), kb_ident_expr(protocol_name))
    let pair = checker.check_expr(kb_call_expr3(rollback_name, kb_int_expr(50), plan_expr, kb_ident_expr(monitoring_name)))
