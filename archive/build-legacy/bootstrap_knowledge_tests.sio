fn tk_is_keyword(kind: TokenKind) -> bool {
    match kind {
        TokenKind::Module => true,
        TokenKind::Import => true,
        TokenKind::Use => true,
        TokenKind::Export => true,
        TokenKind::Fn => true,
        TokenKind::Let => true,
        TokenKind::Var => true,
        TokenKind::Mut => true,
        TokenKind::Const => true,
        TokenKind::Type => true,
        TokenKind::Struct => true,
        TokenKind::Enum => true,
        TokenKind::Trait => true,
        TokenKind::Impl => true,
        TokenKind::If => true,
        TokenKind::Else => true,
        TokenKind::Match => true,
        TokenKind::For => true,
        TokenKind::While => true,
        TokenKind::Loop => true,
        TokenKind::Break => true,
        TokenKind::Continue => true,
        TokenKind::Return => true,
        TokenKind::In => true,
        TokenKind::As => true,
        TokenKind::Where => true,
        TokenKind::Pub => true,
        TokenKind::SelfLower => true,
        TokenKind::SelfUpper => true,
        TokenKind::True => true,
        TokenKind::False => true,
        TokenKind::Is => true,
        TokenKind::Unsafe => true,
        TokenKind::Extern => true,
        TokenKind::Static => true,
        TokenKind::Unit => true,
        TokenKind::Effect => true,
        TokenKind::Handler => true,
        TokenKind::Handle => true,
        TokenKind::With => true,
        TokenKind::Perform => true,
        TokenKind::Resume => true,
        TokenKind::Linear => true,
        TokenKind::Affine => true,
        TokenKind::Move => true,
        TokenKind::Copy => true,
        TokenKind::Drop => true,
        TokenKind::Ref => true,
        TokenKind::Dyn => true,
        TokenKind::Box => true,
        TokenKind::Async => true,
        TokenKind::Await => true,
        TokenKind::Spawn => true,
        TokenKind::Kernel => true,
        TokenKind::Uncertain => true,
        TokenKind::Belief => true,
        TokenKind::Evidence => true,
        TokenKind::Confidence => true,
        TokenKind::Prior => true,
        TokenKind::Posterior => true,
        TokenKind::Likelihood => true,
        TokenKind::Entropy => true,
        TokenKind::Observe => true,
        TokenKind::Sample => true,
        TokenKind::Infer => true,
        TokenKind::Knowledge => true,
        TokenKind::Policy => true,
        TokenKind::PolicyLower => true,
        TokenKind::Require => true,
        TokenKind::Contest => true,
        TokenKind::Robust => true,
        TokenKind::ContestLower => true,
        TokenKind::On => true,
        TokenKind::Intervention => true,
        TokenKind::Valid => true,
        TokenKind::ValidUntil => true,
        TokenKind::ValidWhile => true,
        TokenKind::Derived => true,
        TokenKind::Computed => true,
        TokenKind::Measured => true,
        TokenKind::Super => true,
        TokenKind::Crate => true,
        TokenKind::Model => true,
        TokenKind::AcquisitionPolicy => true,
        TokenKind::AcquisitionPlan => true,
        TokenKind::RecoursePolicy => true,
        TokenKind::RecoursePlan => true,
        TokenKind::TransitionPolicy => true,
        TokenKind::TransitionPlan => true,
        TokenKind::MonitoringPolicy => true,
        TokenKind::ObservedTransition => true,
        TokenKind::RollbackCertificate => true,
        TokenKind::AlternativePolicy => true,
        TokenKind::AlternativeSet => true,
        TokenKind::AlternativeOption => true,
        TokenKind::DecisionPolicy => true,
        TokenKind::DeferralPolicy => true,
        TokenKind::AcquisitionPolicyLower => true,
        TokenKind::RecoursePolicyLower => true,
        TokenKind::TransitionPolicyLower => true,
        TokenKind::TransitionProtocolLower => true,
        TokenKind::MonitoringPolicyLower => true,
        TokenKind::AlternativePolicyLower => true,
        TokenKind::AlternativeFrontierLower => true,
        TokenKind::DecisionPolicyLower => true,
        TokenKind::DeferralPolicyLower => true,
        TokenKind::ModelsLower => true,
        TokenKind::ValidationLower => true,
        TokenKind::AuditLower => true,
        TokenKind::Objective => true,
        TokenKind::Strategy => true,
        TokenKind::Step => true,
        TokenKind::Level => true,
        TokenKind::Scope => true,
        TokenKind::Deferred => true,
        TokenKind::Route => true,
        TokenKind::RollbackRoute => true,
        TokenKind::Admissible => true,
        TokenKind::DiffPrivate => true,
        TokenKind::DPBudget => true,
        TokenKind::CausalEffect => true,
        TokenKind::Aleatoric => true,
        TokenKind::PotentialOutcome => true,
        TokenKind::Proof => true,
        TokenKind::Lemma => true,
        TokenKind::Axiom => true,
        _ => tk_is_causal_keyword(kind),
    }
}

fn tk_is_causal_keyword(kind: TokenKind) -> bool {
    match kind {
        TokenKind::Counterfactual => true,
        TokenKind::Validated => true,
        TokenKind::Session => true,
        TokenKind::Chan => true,
        TokenKind::Send => true,
        TokenKind::Recv => true,
        TokenKind::Close => true,
        TokenKind::Dual => true,
        TokenKind::MaxSteps => true,
        _ => false,
    }
}

fn tk_is_literal(kind: TokenKind) -> bool {
    match kind {
        TokenKind::IntLit => true,
        TokenKind::FloatLit => true,
        TokenKind::StringLit => true,
        TokenKind::CharLit => true,
        TokenKind::BoolLit => true,
        TokenKind::HexLit => true,
        TokenKind::BinLit => true,
        TokenKind::OctLit => true,
        _ => false,
    }
}

fn tk_is_operator(kind: TokenKind) -> bool {
    match kind {
        TokenKind::Plus => true,
        TokenKind::Minus => true,
        TokenKind::Star => true,
        TokenKind::Slash => true,
        TokenKind::Percent => true,
        TokenKind::Eq => true,
        TokenKind::Lt => true,
        TokenKind::Gt => true,
        TokenKind::Bang => true,
        TokenKind::Amp => true,
        TokenKind::Pipe => true,
        TokenKind::Caret => true,
        TokenKind::Tilde => true,
        TokenKind::Question => true,
        TokenKind::EqEq => true,
        TokenKind::BangEq => true,
        TokenKind::LtEq => true,
        TokenKind::GtEq => true,
        TokenKind::AmpAmp => true,
        TokenKind::PipePipe => true,
        TokenKind::Shl => true,
        TokenKind::Shr => true,
        TokenKind::PlusEq => true,
        TokenKind::MinusEq => true,
        TokenKind::StarEq => true,
        TokenKind::SlashEq => true,
        TokenKind::Arrow => true,
        TokenKind::FatArrow => true,
        TokenKind::DotDot => true,
        TokenKind::DotDotEq => true,
        TokenKind::ColonColon => true,
        TokenKind::AmpBang => true,
        TokenKind::PlusPlus => true,
        TokenKind::PipeEq => true,
        TokenKind::ShlEq => true,
        TokenKind::ShrEq => true,
        TokenKind::PercentEq => true,
        TokenKind::CaretEq => true,
        TokenKind::AmpEq => true,
        TokenKind::LeftArrow => true,
        TokenKind::DotDotDot => true,
        TokenKind::PlusMinus => true,
        _ => false,
    }
}

fn tk_is_delimiter(kind: TokenKind) -> bool {
    match kind {
        TokenKind::LParen => true,
        TokenKind::RParen => true,
        TokenKind::LBrace => true,
        TokenKind::RBrace => true,
        TokenKind::LBracket => true,
        TokenKind::RBracket => true,
        _ => false,
    }
}

fn tk_is_punctuation(kind: TokenKind) -> bool {
    match kind {
        TokenKind::Semi => true,
        TokenKind::Colon => true,
        TokenKind::Comma => true,
        TokenKind::Dot => true,
        TokenKind::At => true,
        TokenKind::Hash => true,
        TokenKind::Underscore => true,
        _ => false,
    }
}

fn tk_is_doc_comment(kind: TokenKind) -> bool {
    match kind {
        TokenKind::DocOuter => true,
        TokenKind::DocInner => true,
        TokenKind::DocBlockOuter => true,
        TokenKind::DocBlockInner => true,
        _ => false,
    }
}

// Pratt parser precedence (for future use)
fn tk_precedence(kind: TokenKind) -> i64 {
    match kind {
        // Assignment operators are NOT expression operators.
        // They are handled by parse_expr_or_assign_stmt in the statement parser.
        // Logical OR = 2
        TokenKind::PipePipe => 2,
        // Logical AND = 3
        TokenKind::AmpAmp => 3,
        // Equality = 4
        TokenKind::EqEq => 4,
        TokenKind::BangEq => 4,
        // Comparison = 5
        TokenKind::Lt => 5,
        TokenKind::Gt => 5,
        TokenKind::LtEq => 5,
        TokenKind::GtEq => 5,
        // Bitwise OR = 6
        TokenKind::Pipe => 6,
        // Bitwise XOR = 7
        TokenKind::Caret => 7,
        // Bitwise AND = 8
        TokenKind::Amp => 8,
        // Shift = 9
        TokenKind::Shl => 9,
        TokenKind::Shr => 9,
        // Range = 10
        TokenKind::DotDot => 10,
        TokenKind::DotDotEq => 10,
        // Additive = 11
        TokenKind::Plus => 11,
        TokenKind::Minus => 11,
        TokenKind::PlusPlus => 11,
        // Multiplicative = 12
        TokenKind::Star => 12,
        TokenKind::Slash => 12,
        TokenKind::Percent => 12,
        // Cast = 13
        TokenKind::As => 13,
        // Unary = 13
        TokenKind::Bang => 13,
        TokenKind::Tilde => 13,
        // Call/Index = 14
        TokenKind::LParen => 14,
        TokenKind::LBracket => 14,
        TokenKind::Dot => 14,
        TokenKind::AuditLower => 14,
        // Assignment — MUST be 0 so Pratt loop breaks before consuming `=`.
        // Root cause of H4.3 binary-patch: compiled bytecode had prec=1 for Eq,
        // causing Pratt parser to swallow `=` as infix OpAdd.
        // Explicit arms as defensive documentation (default also returns 0).
        TokenKind::Eq => 0,
        TokenKind::PlusEq => 0,
        TokenKind::MinusEq => 0,
        TokenKind::StarEq => 0,
        TokenKind::SlashEq => 0,
        TokenKind::PercentEq => 0,
        _ => 0,
    }
}

// SOURCE: self-hosted/bootstrap_knowledge_shims.sio

// Narrow bootstrap shims for the knowledge boundary runner.
//
// The focused bootstrap bundle inspects lexer output directly from LexerState,
// so it does not need the parser global token side-channel.

fn parser_set_token_at(idx: i64, tok: Token) with Mut, Panic {
}

fn copy_string_list_to_name(seg: StringList) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: seg.head_len }
    var i: i64 = 0
    while i < seg.head_len && i < 128 {
        n.buf[i] = seg.head_buf[i]
        i = i + 1
    }
    n
}

fn copy_string_list_tail_to_name(seg: StringList) -> Name with Mut, Panic, Div, Alloc {
    match seg.tail {
        Some(rest) => copy_string_list_tail_to_name(*rest)
        None => copy_string_list_to_name(seg)
    }
}

// SOURCE: self-hosted/lexer/span.sio

// self-hosted::lexer::span — Source location tracking
//
// Span represents a byte-offset range in source code.
// Used for error messages and diagnostics.
// Impl block provides constructors and utility methods.


struct Span {
    file_id: i32,
    start: i64,
    end: i64,
}

impl Span {
    fn new(file_id: i32, start: i64, end: i64) -> Span {
        Span { file_id: file_id, start: start, end: end }
    }

    fn dummy() -> Span {
        Span { file_id: 0, start: 0, end: 0 }
    }

    fn len(self) -> i64 {
        self.end - self.start
    }

    fn contains(self, pos: i64) -> bool {
        pos >= self.start && pos < self.end
    }

    fn merge(self, other: Span) -> Span with Mut {
        var start = self.start
        if other.start < start {
            start = other.start
        }
        var end = self.end
        if other.end > end {
            end = other.end
        }
        Span { file_id: self.file_id, start: start, end: end }
    }
}

// SOURCE: self-hosted/lexer/cursor.sio

// self-hosted::lexer::cursor — Character-level source code iteration
//
// Cursor tracks position, line, and column through source bytes.
// All character comparisons use ASCII i8 values.
// Impl block provides navigation methods; character classification
// remains as free functions.

// ============================================================================
// CURSOR STATE
// ============================================================================

// Keep source storage out of Cursor values so advance/peek operations do not
// copy a 1MB array on each call.
var CURSOR_SOURCE: [i8; 1048576] = [0; 1048576]
var CURSOR_SOURCE_LEN: i64 = 0

fn cursor_set_source(source: [i8; 1048576], len: i64) with Mut, Panic, Div {
    var n = len
    if n < 0 { n = 0 }
    if n > 1048576 { n = 1048576 }

    var i: i64 = 0
    while i < n {
        CURSOR_SOURCE[i as usize] = source[i as usize]
        i = i + 1
    }
    CURSOR_SOURCE_LEN = n
}

fn cursor_source_byte(idx: i64) -> i8 with Panic {
    if idx >= 0 && idx < CURSOR_SOURCE_LEN {
        CURSOR_SOURCE[idx as usize]
    } else {
        0 as i8
    }
}

struct Cursor {
    source_len: i64,
    pos: i64,
    line: i64,
    col: i64,
    current: i8,
}

struct BumpResult {
    cursor: Cursor,
    text: [i8; 256],
    text_len: i64,
}

// ============================================================================
// CHARACTER CLASSIFICATION
// ============================================================================

fn is_whitespace(c: i8) -> bool {
    c == 32 as i8 || c == 9 as i8 || c == 13 as i8  // space, tab, CR (not LF)
}

fn is_whitespace_or_newline(c: i8) -> bool {
    c == 32 as i8 || c == 9 as i8 || c == 13 as i8 || c == 10 as i8
}

fn is_digit(c: i8) -> bool {
    c >= 48 as i8 && c <= 57 as i8  // '0'-'9'
}

fn is_hex_digit(c: i8) -> bool {
    is_digit(c) || (c >= 97 as i8 && c <= 102 as i8) || (c >= 65 as i8 && c <= 70 as i8)  // 0-9, a-f, A-F
}

fn is_bin_digit(c: i8) -> bool {
    c == 48 as i8 || c == 49 as i8  // '0' or '1'
}

fn is_oct_digit(c: i8) -> bool {
    c >= 48 as i8 && c <= 55 as i8  // '0'-'7'
}

fn is_alpha(c: i8) -> bool {
    (c >= 65 as i8 && c <= 90 as i8) || (c >= 97 as i8 && c <= 122 as i8)  // A-Z, a-z
}

fn is_ident_start(c: i8) -> bool {
    is_alpha(c) || c == 95 as i8  // letters or '_'
}

fn is_ident_continue(c: i8) -> bool {
    is_alpha(c) || is_digit(c) || c == 95 as i8  // letters, digits, or '_'
}

fn is_operator_start(c: i8) -> bool {
    c == 43 as i8 || c == 45 as i8 || c == 42 as i8 || c == 47 as i8 || c == 37 as i8 ||  // + - * / %
    c == 61 as i8 || c == 60 as i8 || c == 62 as i8 || c == 33 as i8 || c == 38 as i8 ||  // = < > ! &
    c == 124 as i8 || c == 94 as i8 || c == 126 as i8 || c == 63 as i8               // | ^ ~ ?
}

fn is_delimiter(c: i8) -> bool {
    c == 40 as i8 || c == 41 as i8 || c == 123 as i8 || c == 125 as i8 ||  // ( ) { }
    c == 91 as i8 || c == 93 as i8                                // [ ]
}

fn is_punctuation(c: i8) -> bool {
    c == 59 as i8 || c == 58 as i8 || c == 44 as i8 || c == 46 as i8 ||  // ; : , .
    c == 64 as i8 || c == 35 as i8                             // @ #
}

// ============================================================================
// CURSOR METHODS
// ============================================================================

impl Cursor {
    fn new() -> Cursor {
        Cursor {
            source_len: 0,
            pos: 0,
            line: 1,
            col: 1,
            current: 0 as i8,
        }
    }

    fn init(source: [i8; 1048576], len: i64) -> Cursor with Mut, Panic {
        var c = Cursor::new()
        cursor_set_source(source, len)
        c.source_len = CURSOR_SOURCE_LEN
        if c.source_len > 0 {
            c.current = CURSOR_SOURCE[0]
        }
        c
    }

    fn is_eof(self) -> bool {
        self.pos >= self.source_len
    }

    fn peek(self) -> i8 with Panic {
        if self.pos + 1 < self.source_len {
            CURSOR_SOURCE[(self.pos + 1) as usize]
        } else {
            0 as i8
        }
    }

    fn peek_n(self, n: i64) -> i8 with Panic {
        if self.pos + n < self.source_len {
            CURSOR_SOURCE[(self.pos + n) as usize]
        } else {
            0 as i8
        }
    }

    fn advance(self) -> Cursor with Mut, Panic {
        var nc = self
        if nc.pos < nc.source_len {
            if nc.current == 10 as i8 {  // '\n'
                nc.line = nc.line + 1
                nc.col = 1
            } else {
                nc.col = nc.col + 1
            }
            nc.pos = nc.pos + 1
            if nc.pos < nc.source_len {
                nc.current = CURSOR_SOURCE[nc.pos as usize]
            } else {
                nc.current = 0 as i8
            }
        }
        nc
    }

    fn advance_n(self, n: i64) -> Cursor with Mut, Div, Panic {
        var cur = self
        var i: i64 = 0
        while i < n {
            cur = cur.advance()
            i = i + 1
        }
        cur
    }

    fn bump_while_ident(self) -> BumpResult with Mut, Div, Panic {
        var cur = self
        var text: [i8; 256] = [0; 256]
        var idx: i64 = 0
        while !cur.is_eof() && is_ident_continue(cur.current) && idx < 256 {
            text[idx as usize] = cur.current
            idx = idx + 1
            cur = cur.advance()
        }
        BumpResult { cursor: cur, text: text, text_len: idx }
    }

    fn bump_while_digit(self) -> Cursor with Mut, Div, Panic {
        var cur = self
        while !cur.is_eof() && is_digit(cur.current) {
            cur = cur.advance()
        }
        cur
    }

    fn bump_while_hex(self) -> Cursor with Mut, Div, Panic {
        var cur = self
        while !cur.is_eof() && is_hex_digit(cur.current) {
            cur = cur.advance()
        }
        cur
    }
}

// SOURCE: self-hosted/lexer/errors.sio

// self-hosted::lexer::errors — Lexer diagnostic errors
//
// LexErrorKind is a proper enum replacing i32 constants.
// Each error carries position info and optional context character.

enum LexErrorKind {
    None,
    UnexpectedChar,
    UnterminatedString,
    UnterminatedBlockComment,
    InvalidEscape,
    InvalidNumber,
    NumberOverflow,
    UnterminatedChar,
    EmptyCharLiteral,
}

struct LexError {
    kind: LexErrorKind,
    pos: i64,
    line: i64,
    col: i64,
    // Context character (for unexpected char / invalid escape)
    context_char: i8,
}

impl LexError {
    fn new(kind: LexErrorKind, pos: i64, line: i64, col: i64) -> LexError {
        LexError {
            kind: kind,
            pos: pos,
            line: line,
            col: col,
            context_char: 0,
        }
    }

    fn with_char(kind: LexErrorKind, pos: i64, line: i64, col: i64, ch: i8) -> LexError {
        LexError {
            kind: kind,
            pos: pos,
            line: line,
            col: col,
            context_char: ch,
        }
    }
}

// SOURCE: self-hosted/lexer/tables.sio

// self-hosted::lexer::tables — Keyword lookup and operator scanning
//
// keyword_lookup: byte-by-byte comparison grouped by length, returns TokenKind
// scan_operator: longest-match (3-char > 2-char > 1-char)
// scan_delimiter: single-char delimiters and punctuation
// ScanResult carries cursor state and token info with impl block.

// ============================================================================
// KEYWORD LOOKUP
// ============================================================================
// Returns TokenKind::Ident if no keyword match.
// All comparisons use ASCII i8 values.

fn keyword_lookup(text: [i8; 256], len: i64) -> TokenKind with Panic {
    // Length 2: fn, if, in, as, is
    if len == 2 {
        if text[0] == 102 as i8 && text[1] == 110 as i8 { return TokenKind::Fn }          // "fn"
        if text[0] == 105 as i8 && text[1] == 102 as i8 { return TokenKind::If }          // "if"
        if text[0] == 105 as i8 && text[1] == 110 as i8 { return TokenKind::In }          // "in"
        if text[0] == 111 as i8 && text[1] == 110 as i8 { return TokenKind::On }          // "on"
        if text[0] == 97 as i8 && text[1] == 115 as i8 { return TokenKind::As }           // "as"
        if text[0] == 105 as i8 && text[1] == 115 as i8 { return TokenKind::Is }          // "is"
    }

    // Length 3: let, var, mut, for, pub, use, ref, dyn, box
    if len == 3 {
        if text[0] == 108 as i8 && text[1] == 101 as i8 && text[2] == 116 as i8 { return TokenKind::Let }   // "let"
        if text[0] == 118 as i8 && text[1] == 97 as i8 && text[2] == 114 as i8 { return TokenKind::Var }    // "var"
        if text[0] == 109 as i8 && text[1] == 117 as i8 && text[2] == 116 as i8 { return TokenKind::Mut }   // "mut"
        if text[0] == 102 as i8 && text[1] == 111 as i8 && text[2] == 114 as i8 { return TokenKind::For }   // "for"
        if text[0] == 112 as i8 && text[1] == 117 as i8 && text[2] == 98 as i8 { return TokenKind::Pub }    // "pub"
        if text[0] == 117 as i8 && text[1] == 115 as i8 && text[2] == 101 as i8 { return TokenKind::Use }   // "use"
        if text[0] == 114 as i8 && text[1] == 101 as i8 && text[2] == 102 as i8 { return TokenKind::Ref }   // "ref"
        if text[0] == 100 as i8 && text[1] == 121 as i8 && text[2] == 110 as i8 { return TokenKind::Dyn }   // "dyn"
        if text[0] == 98 as i8 && text[1] == 111 as i8 && text[2] == 120 as i8 { return TokenKind::Box }    // "box"
    }

    // Length 4: type, enum, impl, else, loop, self, Self, with, true, move, copy, drop, unit, chan, send, recv, dual
    if len == 4 {
        if text[0] == 115 as i8 && text[1] == 116 as i8 && text[2] == 101 as i8 && text[3] == 112 as i8 { return TokenKind::Step }          // "step"
        if text[0] == 117 as i8 && text[1] == 110 as i8 && text[2] == 105 as i8 && text[3] == 116 as i8 { return TokenKind::Unit }         // "unit"
        if text[0] == 116 as i8 && text[1] == 121 as i8 && text[2] == 112 as i8 && text[3] == 101 as i8 { return TokenKind::Type }        // "type"
        if text[0] == 101 as i8 && text[1] == 110 as i8 && text[2] == 117 as i8 && text[3] == 109 as i8 { return TokenKind::Enum }        // "enum"
        if text[0] == 105 as i8 && text[1] == 109 as i8 && text[2] == 112 as i8 && text[3] == 108 as i8 { return TokenKind::Impl }        // "impl"
        if text[0] == 101 as i8 && text[1] == 108 as i8 && text[2] == 115 as i8 && text[3] == 101 as i8 { return TokenKind::Else }        // "else"
        if text[0] == 108 as i8 && text[1] == 111 as i8 && text[2] == 111 as i8 && text[3] == 112 as i8 { return TokenKind::Loop }        // "loop"
        if text[0] == 115 as i8 && text[1] == 101 as i8 && text[2] == 108 as i8 && text[3] == 102 as i8 { return TokenKind::SelfLower }   // "self"
        if text[0] == 83 as i8 && text[1] == 101 as i8 && text[2] == 108 as i8 && text[3] == 102 as i8 { return TokenKind::SelfUpper }    // "Self"
        if text[0] == 119 as i8 && text[1] == 105 as i8 && text[2] == 116 as i8 && text[3] == 104 as i8 { return TokenKind::With }        // "with"
        if text[0] == 116 as i8 && text[1] == 114 as i8 && text[2] == 117 as i8 && text[3] == 101 as i8 { return TokenKind::True }        // "true"
        if text[0] == 109 as i8 && text[1] == 111 as i8 && text[2] == 118 as i8 && text[3] == 101 as i8 { return TokenKind::Move }        // "move"
        if text[0] == 99 as i8 && text[1] == 111 as i8 && text[2] == 112 as i8 && text[3] == 121 as i8 { return TokenKind::Copy }         // "copy"
        if text[0] == 100 as i8 && text[1] == 114 as i8 && text[2] == 111 as i8 && text[3] == 112 as i8 { return TokenKind::Drop }        // "drop"
