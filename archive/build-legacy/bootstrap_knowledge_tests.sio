fn ir_empty_function() -> IrFunction {
    IrFunction {
        name: ir_empty_name(),
        instrs: [ir_nop(); 128],
        instr_count: 0,
        reg_count: 0,
        label_count: 0,
        param_count: 0,
        param_regs: [IR_INVALID_REG; 64],
        compile_strategy: IR_STRATEGY_STANDARD,
        prof_counter_id: -1,
    }
}

fn ir_empty_module() -> IrModule {
    IrModule {
        functions: [ir_empty_function(); 1024],
        fn_count: 0,
        string_table: [ir_empty_name(); 4096],
        string_count: 0,
        epistemic: ir_empty_epistemic_section(),
        prof_counters: [ir_empty_prof_counter_info(); 64],
        prof_counter_count: 0,
        export_names: [ir_empty_name(); 64],
        export_count: 0,
    }
}

fn ir_call_extern(dst: i64, symbol: Name, args: Option<Box<IrRegList>>, arg_count: i64) -> IrInstr {
    var instr = ir_instr_new(IrOpcode::IrCallExtern)
    instr.dst = dst
    instr.name = symbol
    instr.call_args = args
    instr.arg_count = arg_count
    instr
}

// Sprint 228: Load a function reference as a first-class i64 value.
fn ir_load_fn_ref(dst: i64, fn_id: i64) -> IrInstr {
    var instr = ir_instr_new(IrOpcode::IrLoadFnRef)
    instr.dst = dst
    instr.fn_id = fn_id
    instr
}

// Sprint 228: Indirect call — fn_id comes from register src1.
fn ir_call_indirect(dst: i64, fn_ref_reg: i64, args: Option<Box<IrRegList>>, arg_count: i64) -> IrInstr {
    var instr = ir_instr_new(IrOpcode::IrCallIndirect)
    instr.dst = dst
    instr.src1 = fn_ref_reg
    instr.call_args = args
    instr.arg_count = arg_count
    instr
}

fn ir_module_add_export(module: IrModule, name: Name) -> IrModule with Mut, Panic {
    var m = module
    if m.export_count < 64 {
        m.export_names[m.export_count as usize] = name
        m.export_count = m.export_count + 1
    }
    m
}

// SOURCE: self-hosted/check/mod.sio

// Type Checker — entry point
//
// Runs the two-pass type checking algorithm on a Program AST:
//   Pass 1: collect struct/enum/fn definitions into tables
//   Pass 2: check function bodies for type consistency
//
// Returns a CheckResult with the error count.



struct CheckResult {
    error_count: i64,
    had_error: bool,
}

struct CheckArtifactsResult {
    error_count: i64,
    had_error: bool,
    checker: Checker,
}

struct CheckEpistemicResult {
    error_count: i64,
    had_error: bool,
    epistemic: IrEpistemicSection,
}

struct CheckBoxedEpistemicResult {
    error_count: i64,
    had_error: bool,
    epistemic: Box<IrEpistemicSection>,
}

fn check_policy_requirements_to_ir(
    opt: Option<Box<PolicyRequirementInfoList>>,
    out: [IrPolicyRequirementInfo; 8],
    idx: i64
) -> [IrPolicyRequirementInfo; 8] with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            var next = out
            if idx < 8 {
                next[idx as usize] = IrPolicyRequirementInfo {
                    metric_id: (*list).head.metric_id,
                    metric_name: (*list).head.metric_name,
                    op: (*list).head.op,
                    threshold: (*list).head.threshold,
                    threshold_kind: (*list).head.threshold_kind,
                    bool_threshold: (*list).head.bool_threshold,
                    name_threshold: (*list).head.name_threshold,
                }
            }
            check_policy_requirements_to_ir((*list).tail, next, idx + 1)
        }
        None => out
    }
}

fn checker_to_ir_epistemic_into(checker: &Checker, ep: &! IrEpistemicSection) with Mut, Panic, Div, Alloc {
    checker_export_ir_epistemic_into_local(checker, ep)
}

fn checker_to_ir_epistemic(checker: Checker) -> IrEpistemicSection with Mut, Panic, Div, Alloc {
    var ep = ir_empty_epistemic_section()
    checker_export_ir_epistemic_into_local(&checker, &!ep)
    ep
}

fn check_result_to_ir_epistemic(result: &CheckArtifactsResult) -> IrEpistemicSection with Mut, Panic, Div, Alloc {
    checker_to_ir_epistemic(result.checker)
}

fn check_program_ok(prog: Program) -> bool with Mut, Panic, Div, Alloc, IO {
    let result = check_program(prog)
    !result.had_error
}

fn check_program_epistemic_into(prog: Program, out: &! IrEpistemicSection) -> bool with Mut, Panic, Div, Alloc, IO {
    let artifacts = check_program_with_artifacts(prog)
    if artifacts.had_error {
        return false
    }
    checker_export_ir_epistemic_into_local(&artifacts.checker, out)
    true
}

fn check_program(prog: Program) -> CheckResult with Mut, Panic, Div, Alloc, IO {
    let artifacts = check_program_with_artifacts(prog)
    CheckResult {
        error_count: artifacts.error_count,
        had_error: artifacts.had_error,
    }
}

fn check_program_with_artifacts(prog: Program) -> CheckArtifactsResult with Mut, Panic, Div, Alloc, IO {
    var checker = checker_new()
    checker = checker.collect_items(prog.items)
    checker = checker.check_items(prog.items)
    CheckArtifactsResult {
        error_count: checker.error_count,
        had_error: checker.had_error,
        checker: checker,
    }
}

fn check_program_epistemic(prog: Program) -> CheckEpistemicResult with Mut, Panic, Div, Alloc, IO {
    let artifacts = check_program_with_artifacts(prog)
    let error_count = artifacts.error_count
    let had_error = artifacts.had_error
    let epistemic = if had_error {
        ir_empty_epistemic_section()
    } else {
        check_result_to_ir_epistemic(&artifacts)
    }
    CheckEpistemicResult {
        error_count: error_count,
        had_error: had_error,
        epistemic: epistemic,
    }
}

fn check_program_boxed_ir_epistemic(prog: Program) -> CheckBoxedEpistemicResult with Mut, Panic, Div, Alloc, IO {
    let artifacts = check_program_with_artifacts(prog)
    let error_count = artifacts.error_count
    let had_error = artifacts.had_error
    let epistemic = if had_error {
        ir_empty_epistemic_section()
    } else {
        check_result_to_ir_epistemic(&artifacts)
    }
    CheckBoxedEpistemicResult {
        error_count: error_count,
        had_error: had_error,
        epistemic: Box::new(epistemic),
    }
}

// SOURCE: self-hosted/test_knowledge_bootstrap.sio

// Focused bootstrap-safe epistemic tests.
//
// This suite intentionally avoids the parser-construction helpers used by the
// broader knowledge tests so it can run inside a small flat bootstrap bundle.

fn kb_make_name(a: i8, b: i8, c: i8, count: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: count }
    n.buf[0] = a
    if count > 1 { n.buf[1] = b }
    if count > 2 { n.buf[2] = c }
    n
}

fn kb_make_name2(a: i8, b: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 2 }
    n.buf[0] = a
    n.buf[1] = b
    n
}

fn kb_make_name4(a: i8, b: i8, c: i8, d: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 4 }
    n.buf[0] = a
    n.buf[1] = b
    n.buf[2] = c
    n.buf[3] = d
    n
}

fn kb_make_name12(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8, h: i8, i: i8, j: i8, k: i8, l: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 12 }
    n.buf[0] = a
    n.buf[1] = b
    n.buf[2] = c
    n.buf[3] = d
    n.buf[4] = e
    n.buf[5] = f
    n.buf[6] = g
    n.buf[7] = h
    n.buf[8] = i
    n.buf[9] = j
    n.buf[10] = k
    n.buf[11] = l
    n
}

fn kb_make_name17(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8, h: i8, i: i8, j: i8, k: i8, l: i8, m: i8, n0: i8, o: i8, p: i8, q: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 17 }
    n.buf[0] = a
    n.buf[1] = b
    n.buf[2] = c
    n.buf[3] = d
    n.buf[4] = e
    n.buf[5] = f
    n.buf[6] = g
    n.buf[7] = h
    n.buf[8] = i
    n.buf[9] = j
    n.buf[10] = k
    n.buf[11] = l
    n.buf[12] = m
    n.buf[13] = n0
    n.buf[14] = o
    n.buf[15] = p
    n.buf[16] = q
    n
}

fn kb_name_from_str(s: string) -> Name with Mut, Panic, Div {
    let len = str_len(s)
    var n = Name { buf: [0; 128], len: len }
    var i: i64 = 0
    while i < len && i < 128 {
        n.buf[i as usize] = str_char_at(s, i) as i8
        i = i + 1
    }
    n
}

fn kb_empty_path() -> AstPath {
    AstPath {
        segments: StringList { head_buf: [0; 128], head_len: 0, tail: None },
        seg_count: 0,
    }
}

fn kb_single_path3(a: i8, b: i8, c: i8) -> AstPath with Mut, Panic, Div {
    var buf: [i8; 128] = [0; 128]
    buf[0] = a
    buf[1] = b
    buf[2] = c
    AstPath {
        segments: StringList { head_buf: buf, head_len: 3, tail: None },
        seg_count: 1,
    }
}

