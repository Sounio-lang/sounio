fn kb_test_commit_alternative_records_transition_plan_and_ir() -> bool with Mut, Panic, Div, Alloc, IO {
    let option_name = kb_name_from_str("opt")
    let policy_name = kb_name_from_str("tp")
    let protocol_name = kb_name_from_str("proto")
    let commit_name = kb_name_from_str("commit_alternative")
    var checker = checker_new()
    checker = kb_seed_transition_policy(checker, policy_name, CompareOp::CmpLe, 0.05, 2)
    checker = kb_seed_alternative_option(checker, option_name, 45, 0.04)
    let policy_ty = checker.env.lookup(policy_name)
    let option_ty = checker.env.lookup(option_name)
    checker = kb_seed_transition_protocol(checker, protocol_name, option_ty.epistemic_meta_id, policy_ty.epistemic_meta_id, 45)
    let pair = checker.check_expr(kb_call_expr3(commit_name, kb_int_expr(50), kb_ident_expr(option_name), kb_ident_expr(protocol_name)))
    let checked = pair.0
    let ty = pair.1
    if checked.error_count > 0
        || ty.kind != TypeKind::TyTransitionPlan
        || checked.transition_plans.count != 1 {
        return false
    }
    let plan = checked.transition_plans.get(0)
    var ep = ir_empty_epistemic_section()
    checker_to_ir_epistemic_into(&checked, &!ep)
    let ok = plan.transition_policy_id == policy_ty.epistemic_meta_id &&
        plan.transition_protocol_id == 0 &&
        plan.alternative_option_id == option_ty.epistemic_meta_id &&
        plan.step_count == 2 &&
        ty.epistemic_meta_id == 0 &&
        ep.transition_policy_count == 1 &&
        ep.transition_protocol_count == 1 &&
        ep.transition_step_count == 2 &&
        ep.transition_plan_count == 1
    ok
}

