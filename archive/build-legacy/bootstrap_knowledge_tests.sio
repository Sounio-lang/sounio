        entries: [empty_alternative_frontier_info(); 32],
        count: 0,
    }
}

impl AlternativeFrontierTable {
    fn add(self, info: AlternativeFrontierInfo) -> (AlternativeFrontierTable, i64) with Mut, Panic, Div {
        var tbl = self
        let idx = tbl.count
        if tbl.count < 32 {
            tbl.entries[tbl.count] = info
            tbl.count = tbl.count + 1
        }
        (tbl, idx)
    }

    fn find(self, name: Name) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.count {
            if name_eq(self.entries[i].name, name) {
                return i
            }
            i = i + 1
        }
        -1
    }

    fn get(self, idx: i64) -> AlternativeFrontierInfo with Panic, Div {
        self.entries[idx]
    }
}

