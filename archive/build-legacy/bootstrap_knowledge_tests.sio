// ============================================================================
// Struct layout tracking (Phase 3.2)
// ============================================================================

// A single struct field: name + sequential index
struct StructFieldEntry {
    name: Name,
    index: i64,
}

// Layout for one struct type: name + ordered fields
struct StructLayoutEntry {
    type_name: Name,
    fields: [StructFieldEntry; 64],
    field_count: i64,
}

// Table of all known struct layouts (populated during lowering)
struct StructLayoutTable {
    entries: [StructLayoutEntry; 256],
    count: i64,
}

fn empty_struct_field_entry() -> StructFieldEntry {
    StructFieldEntry { name: ir_empty_name(), index: 0 }
}

fn empty_struct_layout_entry() -> StructLayoutEntry {
    StructLayoutEntry {
        type_name: ir_empty_name(),
        fields: [empty_struct_field_entry(); 64],
        field_count: 0,
    }
}

fn empty_struct_layout_table() -> StructLayoutTable {
    StructLayoutTable {
        entries: [empty_struct_layout_entry(); 256],
        count: 0,
    }
}

// ============================================================================
// Enum discriminant tracking (Phase 3.1)
// ============================================================================

// Maps enum variant path "EnumName::Variant" to its discriminant value
struct EnumVariantEntry {
    enum_name: Name,
    variant_name: Name,
    discriminant: i64,
}

struct EnumVariantTable {
    entries: [EnumVariantEntry; 1024],
    count: i64,
}

fn empty_enum_variant_entry() -> EnumVariantEntry {
    EnumVariantEntry {
        enum_name: ir_empty_name(),
        variant_name: ir_empty_name(),
        discriminant: 0,
    }
}

fn empty_enum_variant_table() -> EnumVariantTable {
    EnumVariantTable {
        entries: [empty_enum_variant_entry(); 1024],
        count: 0,
    }
}

// Mangle a method name: "TypeName" + "_" + "method_name"
fn ir_mangle_method_name(type_name: Name, method_name: Name) -> Name with Mut, Panic, Div {
    var result = Name { buf: [0; 128], len: 0 }
    // Copy type_name
    var i: i64 = 0
    while i < type_name.len && result.len < 127 {
        result.buf[result.len] = type_name.buf[i]
        result.len = result.len + 1
        i = i + 1
    }
    // Add underscore separator
    if result.len < 127 {
        result.buf[result.len] = 95  // '_'
        result.len = result.len + 1
    }
    // Copy method_name
    var j: i64 = 0
    while j < method_name.len && result.len < 128 {
        result.buf[result.len] = method_name.buf[j]
        result.len = result.len + 1
        j = j + 1
    }
    result
}

fn ir_empty_name() -> Name {
    Name { buf: [0; 128], len: 0 }
}

fn ir_empty_prof_counter_info() -> IrProfCounterInfo {
    IrProfCounterInfo { fn_id: -1, fn_name: ir_empty_name(), counter_id: -1 }
}

fn ir_name_eq(a: Name, b: Name) -> bool with Mut, Panic, Div {
    if a.len != b.len {
        return false
    }
    var i: i64 = 0
    while i < a.len {
        if a.buf[i] != b.buf[i] {
            return false
        }
        i = i + 1
    }
    true
}

fn ir_name_from_bytes(a: i8, b: i8, c: i8, d: i8, len: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: len }
    if len > 0 { n.buf[0] = a }
    if len > 1 { n.buf[1] = b }
    if len > 2 { n.buf[2] = c }
    if len > 3 { n.buf[3] = d }
    n
}

fn make_name(s: string) -> Name with Mut, Panic, Div {
    let len = str_len(s)
    var n = Name { buf: [0; 128], len: len }
    var i: i64 = 0
    while i < len && i < 128 {
        n.buf[i as usize] = str_char_at(s, i) as i8
        i = i + 1
    }
    n
}

fn ir_name_from_string_list(sl: StringList) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: sl.head_len }
    var i: i64 = 0
    while i < sl.head_len && i < 128 {
        n.buf[i] = sl.head_buf[i]
        i = i + 1
    }
    n
}

fn ir_path_first_name(p: AstPath) -> Name with Mut, Panic, Div {
    if p.seg_count <= 0 {
        ir_empty_name()
    } else {
        ir_name_from_string_list(p.segments)
    }
}

// Get the last segment of a path (e.g., "Variant" from "Enum::Variant")
fn ir_path_last_name(p: AstPath) -> Name with Mut, Panic, Div, Alloc {
    if p.seg_count <= 0 {
        ir_empty_name()
    } else if p.seg_count == 1 {
        ir_name_from_string_list(p.segments)
    } else {
        ir_string_list_last(p.segments)
    }
}

fn ir_string_list_last(sl: StringList) -> Name with Mut, Panic, Div, Alloc {
    match sl.tail {
        Some(rest) => ir_string_list_last(*rest),
        _ => ir_name_from_string_list(sl),
    }
}

// Check if a name is "Some" (for Option matching)
fn ir_name_is_some(n: Name) -> bool {
    n.len == 4 && n.buf[0] == 83 as i8 && n.buf[1] == 111 as i8 && n.buf[2] == 109 as i8 && n.buf[3] == 101 as i8
}

// Check if a name is "Box" (for Box::new lowering)
fn ir_name_is_box(n: Name) -> bool {
    n.len == 3 && n.buf[0] == 66 as i8 && n.buf[1] == 111 as i8 && n.buf[2] == 120 as i8
}

// Check if a name is "None" (for Option matching)
fn ir_name_is_none(n: Name) -> bool {
    n.len == 4 && n.buf[0] == 78 as i8 && n.buf[1] == 111 as i8 && n.buf[2] == 110 as i8 && n.buf[3] == 101 as i8
}

fn ir_empty_reg_list() -> Option<Box<IrRegList>> {
    None
}

fn ir_reg_list_single(reg: i64) -> IrRegList {
    IrRegList { head: reg, tail: None }
}

fn ir_reg_list_append(list: IrRegList, reg: i64) -> IrRegList with Alloc {
    match list.tail {
        Some(rest) => IrRegList {
            head: list.head,
            tail: Some(Box::new(ir_reg_list_append(*rest, reg))),
        }
        _ => IrRegList {
            head: list.head,
            tail: Some(Box::new(IrRegList { head: reg, tail: None })),
        }
    }
}

fn ir_reg_list_count(opt: Option<Box<IrRegList>>) -> i64 with Alloc {
    match opt {
        Some(list) => 1 + ir_reg_list_count((*list).tail),
        _ => 0,
    }
}

fn ir_empty_env() -> Option<Box<IrEnvList>> {
    None
}

fn ir_env_push(env: Option<Box<IrEnvList>>, b: IrEnvBinding) -> Option<Box<IrEnvList>> with Alloc {
    Some(Box::new(IrEnvList {
        head: b,
        tail: env,
    }))
}

fn ir_env_lookup(env: Option<Box<IrEnvList>>, name: Name, depth: i64) -> i64 with Mut, Panic, Div, Alloc {
    var current = env
    while true {
        match current {
            Some(list) => {
                let b = (*list).head
                if b.depth <= depth && ir_name_eq(b.name, name) {
                    return b.reg
                }
                current = (*list).tail
            }
            _ => break
        }
    }
    IR_INVALID_REG
}

fn ir_instr_new(op: IrOpcode) -> IrInstr {
    IrInstr {
        op: op,
        dst: IR_INVALID_REG,
        src1: IR_INVALID_REG,
        src2: IR_INVALID_REG,
        imm_i64: 0,
        imm_f64: 0.0,
        label_id: IR_INVALID_LABEL,
        fn_id: IR_INVALID_FN,
        field_idx: -1,
        imm_flags: 0,
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        name: ir_empty_name(),
        call_args: ir_empty_reg_list(),
        arg_count: 0,
    }
}

fn ir_nop() -> IrInstr {
    ir_instr_new(IrOpcode::IrNop)
