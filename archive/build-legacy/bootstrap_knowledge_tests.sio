    TypeRobust,
    TypeIntervention,
    TypeCounterfactual,
    TypeValidated,
    TypeAdmissible,
    TypeDeferred,
    TypeRefinement,
    TypeChan,
    TypeSession,
    // Sprint 27: Annotation syntax
    TypeDiffPrivate,
    TypeDPBudget,
    TypeCausalEffect,
    TypeAleatoric,
    TypePotentialOutcome,
    TypeProof,
