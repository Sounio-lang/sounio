        c.had_error = true
        print("error[E092]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": duplicate or unknown audit field\n")
        print("   |\n   = section ")
        print_name_value(section_name)
        if field_name.len > 0 {
            print(", field ")
            print_name_value(field_name)
        }
        print("\n   = help: keep only the supported audit fields once per section\n")
        c
    }



    fn report_mismatch(self, span: Span, code: i64, expected: TypeEntry, got: TypeEntry) -> Checker with Mut, IO, Panic, Div, Alloc {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E")
        if code < 100 { print("0") }
        if code < 10 { print("0") }
        print_int(code)
        print("]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": ")
        if got.kind == TypeKind::TyContest && expected.kind != TypeKind::TyContest {
            print("cannot implicitly coerce contested evidence into this type")
        } else {
            print_error_message(code)
        }
        print("\n   |\n   = expected ")
        print_type_name(expected)
        print("\n   = found ")
        print_type_name(got)
        print("\n")
        // Print help and note for this error code
        print_error_help(code)
        print_error_note(code)
        c
    }



    fn report_effect_error(self, span: Span, missing: [i64; 8], missing_count: i64) -> Checker with Mut, IO, Panic, Div {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E035]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": effect not declared in function signature (missing: ")
        var i: i64 = 0
        while i < missing_count {
            if i > 0 { print(", ") }
            print_effect_name(missing[i as usize])
            i = i + 1
        }
        print(")\n")
        c
    }

    fn check_callee_effects(self, span: Span, callee_effects: [i64; 8], callee_effect_count: i64) -> Checker with Mut, IO, Panic, Div {
        if callee_effect_count == 0 {
            return self
        }
        if effects_subset(callee_effects, callee_effect_count, self.current_effects, self.current_effect_count) {
            return self
        }
        let missing_pair = find_missing_effects(callee_effects, callee_effect_count, self.current_effects, self.current_effect_count)
        self.report_effect_error(span, missing_pair.0, missing_pair.1)
    }

    // --------------------------------------------------------
    // Security hardening: depth and complexity tracking
    // --------------------------------------------------------

    fn check_type_depth(self, span: Span) -> (Checker, bool) with Mut, Panic, Div {
        var c = self
        if c.type_depth >= MAX_TYPE_DEPTH {
            c = c.report_error_at(span, 60, c.type_depth, MAX_TYPE_DEPTH, 0)
            return (c, false)
        }
        c.type_depth = c.type_depth + 1
        (c, true)
    }

    fn exit_type_depth(self) -> Checker with Mut {
        var c = self
        if c.type_depth > 0 {
            c.type_depth = c.type_depth - 1
        }
        c
    }

    fn check_expr_depth(self, span: Span) -> (Checker, bool) with Mut, Panic, Div {
        var c = self
        if c.expr_depth >= MAX_EXPR_DEPTH {
            c = c.report_error_at(span, 61, c.expr_depth, MAX_EXPR_DEPTH, 0)
            return (c, false)
        }
        c.expr_depth = c.expr_depth + 1
        (c, true)
    }

    fn exit_expr_depth(self) -> Checker with Mut {
        var c = self
        if c.expr_depth > 0 {
            c.expr_depth = c.expr_depth - 1
        }
        c
    }

    fn check_loop_depth(self, span: Span) -> (Checker, bool) with Mut, Panic, Div {
        var c = self
        if c.loop_depth >= MAX_LOOP_DEPTH {
            c = c.report_error_at(span, 62, c.loop_depth, MAX_LOOP_DEPTH, 0)
            return (c, false)
        }
        (c, true)
    }

    fn check_complexity(self, cost: i64, span: Span) -> (Checker, bool) with Mut, Panic, Div {
        var c = self
        if c.complexity_budget + cost > MAX_TYPE_COMPLEXITY {
            c = c.report_error_at(span, 64, c.complexity_budget, MAX_TYPE_COMPLEXITY, 0)
            return (c, false)
        }
        c.complexity_budget = c.complexity_budget + cost
        (c, true)
    }

    fn push_const_scope(self) -> Checker with Mut, Div, Panic {
        var c = self
        if c.const_int_scope_depth < MAX_SCOPE_DEPTH {
            c.const_int_scope_marks[c.const_int_scope_depth as usize] = c.const_int_count
            c.const_int_scope_depth = c.const_int_scope_depth + 1
        }
        c
    }

    fn pop_const_scope(self) -> Checker with Mut, Div, Panic {
        var c = self
        if c.const_int_scope_depth > 0 {
            c.const_int_scope_depth = c.const_int_scope_depth - 1
            let mark = c.const_int_scope_marks[c.const_int_scope_depth as usize]
            if mark >= 0 && mark <= c.const_int_count {
                c.const_int_count = mark
            }
        }
        c
    }

    fn const_int_bind_raw(self, name: Name, known: i64, value: i64) -> Checker with Mut, Div, Panic {
        var c = self
        var idx = c.const_int_count
        if idx >= MAX_CONST_INT_BINDINGS {
            idx = MAX_CONST_INT_BINDINGS - 1
        } else {
            c.const_int_count = c.const_int_count + 1
        }
        c.const_int_names[idx as usize] = name
        c.const_int_known[idx as usize] = known
        c.const_int_values[idx as usize] = value
        c
    }

    fn const_int_bind_unknown(self, name: Name) -> Checker with Mut {
        self.const_int_bind_raw(name, 0, 0)
    }

    fn const_int_bind_value(self, name: Name, value: i64) -> Checker with Mut {
        self.const_int_bind_raw(name, 1, value)
    }

    fn const_int_lookup(self, name: Name) -> (bool, i64) with Mut, Panic, Div {
        var i = self.const_int_count - 1
        while i >= 0 {
            if name_eq(self.const_int_names[i as usize], name) {
                if self.const_int_known[i as usize] == 1 {
                    return (true, self.const_int_values[i as usize])
                }
                return (false, 0)
            }
            i = i - 1
        }
        (false, 0)
    }
}

fn print_error_message(code: i64) with IO, Mut, Panic, Div {
    // Basic types (1-10)
    if code == 1 { print("this binding expects a different type") }
    else if code == 2 { print("cannot assign this value to the target") }
    else if code == 3 { print("cannot modify an immutable binding") }
    else if code == 4 { print("these types cannot be combined with this operator") }
    else if code == 5 { print("this unary operation is not defined for the type") }
    else if code == 6 { print("conditions must be of type `bool`") }
    else if code == 7 { print("branches have incompatible types") }
    else if code == 8 { print("return value does not match function's declared return type") }
    else if code == 9 { print("argument type does not match parameter") }
    else if code == 10 { print("wrong number of arguments in this call") }
    // Member access (11-16)
    else if code == 11 { print("no method named for this type") }
    else if code == 12 { print("this type has no field named") }
    else if code == 13 { print("indexing requires an array type") }
    else if code == 14 { print("array indices must be integers") }
    else if code == 15 { print("unknown struct type") }
    else if code == 16 { print("field initializer has wrong type") }
    // Callables/control flow (17-21)
    else if code == 17 { print("this expression cannot be called") }
    else if code == 18 { print("match arms have incompatible types") }
    else if code == 19 { print("method calls are not supported for this type") }
    else if code == 20 { print("array elements must all have the same type") }
    else if code == 21 { print("compound assignment requires compatible types") }
    // Epistemic (22)
    else if code == 22 { print("epsilon bound must be between 0.0 and 1.0") }
    // Hypercomplex (30-34)
    else if code == 30 { print("cannot combine values from different hypercomplex algebras") }
    else if code == 31 { print("division requires the `Div` effect") }
    else if code == 32 { print("this algebra does not support division") }
    else if code == 33 { print("Clifford algebras have different signatures") }
    else if code == 34 { print("cannot narrow hypercomplex algebra") }
    // Effects (35)
    else if code == 35 { print("function uses effects not declared in its signature") }
    // Epistemic propagation (36)
    else if code == 36 { print("confidence bound is not tight enough") }
    // Borrow checker (37-40)
    else if code == 37 { print("cannot borrow sharedly while exclusive borrow is active") }
    else if code == 38 { print("cannot borrow exclusively while other borrows are active") }
    else if code == 39 { print("linear value has already been used") }
    else if code == 40 { print("linear value must be used") }
    // Units/refinement (41-43)
    else if code == 41 { print("units are incompatible in this operation") }
    else if code == 42 { print("value does not satisfy the refinement predicate") }
    else if code == 43 { print("incompatible unit dimensions in conversion") }
    // Phase A additions (44-51)
    else if code == 44 { print("`break` can only be used inside a loop") }
    else if code == 45 { print("`continue` can only be used inside a loop") }
    else if code == 46 { print("struct literal has wrong number of fields") }
    else if code == 47 { print("tuple index is out of bounds") }
    else if code == 48 { print("bitwise operations require integer types") }
    else if code == 49 { print("shift operations require integer types") }
    else if code == 50 { print("modulo requires integer types") }
    else if code == 51 { print("logical operations require boolean types") }
    // Phase B.3 additions (52-54)
    else if code == 52 { print("cannot prove refinement requirement at this call site") }
    else if code == 53 { print("closure may use undeclared effects") }
    else if code == 54 { print("invalid Knowledge metadata constraint") }
    else if code == 60 { print("type nesting exceeds maximum depth") }
    else if code == 61 { print("expression nesting exceeds maximum depth") }
    else if code == 62 { print("loop nesting exceeds maximum depth") }
    else if code == 64 { print("type complexity budget exceeded") }
    // Causal identifiability (67-68)
    else if code == 67 { print("causal query is non-identifiable: no valid adjustment set blocks all backdoor paths") }
    else if code == 68 { print("causal graph has unblocked backdoor path between cause and effect") }
    // Range / constant (55-57)
    else if code == 55 { print("range endpoints must be integer types") }
    else if code == 56 { print("division by zero detected at compile time") }
    else if code == 57 { print("modulo by zero detected at compile time") }
    else if code == 58 { print("prove_robust(...) requires Contest<T> and Policy<T> with the same inner type") }
    else if code == 59 { print("contest expressions require an explicit Contest<T> annotation") }
    else if code == 63 { print("epistemic wrapper metadata is malformed or unsupported in this compiler slice") }
    else if code == 79 { print("contest witness builtin requires Contest<T, Family, Policy>") }
    else if code == 80 { print("contest metadata is incomplete for witness projection") }
    else if code == 81 { print("requested contest metric is unavailable") }
    else if code == 82 { print("mechanistic report is unavailable for this contest") }
    else if code == 83 { print("counterexample witness is unavailable for this contest") }
    else if code == 84 { print("posterior weight witness is unavailable for this contest") }
    else if code == 85 { print("audit definition requires full Contest<T, Family, Policy>") }
    else if code == 86 { print("audit attachment requires Contest<T, Family, Policy>") }
    else if code == 87 { print("audit target does not match the attached contest") }
    else if code == 88 { print("posterior weights do not match the declared model family") }
    else if code == 89 { print("posterior weights are not normalized") }
    else if code == 90 { print("mechanistic section is incomplete") }
    else if code == 91 { print("counterexample section is incomplete") }
    else if code == 92 { print("duplicate or unknown audit field") }
    else if code == 93 { print("admit_action(...) requires a declared decision_policy item") }
    else if code == 94 { print("decision policy target does not match the admitted action type") }
    else if code == 95 { print("admit_action(...) requires a proof-carrying Robust<T> value") }
    else if code == 96 { print("decision admissibility obligation failed") }
    else if code == 97 { print("defer_action(...) requires a declared deferral_policy item") }
    else if code == 98 { print("deferral policy target does not match the deferred action type") }
    else if code == 99 { print("defer_action(...) requires Contest<T, Family, Policy> or proof-carrying Robust<T> evidence") }
    else if code == 100 { print("deferral policy obligation failed") }
    else if code == 101 { print("deferral_reason(...) requires Deferred<T>") }
    else if code == 102 { print("plan_acquisition(...) requires Deferred<T>") }
    else if code == 103 { print("plan_recourse(...) requires Deferred<T>") }
    else if code == 104 { print("acquisition policy target does not match the deferred subject type") }
    else if code == 105 { print("recourse policy target does not match the deferred subject type") }
    else if code == 106 { print("acquisition policy requires unavailable contest or audit data") }
    else if code == 107 { print("recourse policy requires unavailable contest or audit data") }
    else if code == 108 { print("acquisition_reason(...) requires AcquisitionPlan<T>") }
    else if code == 109 { print("recourse_reason(...) requires RecoursePlan<T>") }
    else if code == 110 { print("deferral_reason(...) requires a recorded deferral certificate") }
    else if code == 111 { print("plan_acquisition(...) requires a declared acquisition_policy item") }
    else if code == 112 { print("plan_recourse(...) requires a declared recourse_policy item") }
    else if code == 113 { print("propose_alternatives(...) requires Deferred<T> or RecoursePlan<T>") }
    else if code == 114 { print("alternative frontier target does not match the supplied evidence type") }
    else if code == 115 { print("alternative frontier candidate references an incompatible or missing recourse_policy") }
    else if code == 116 { print("alternative frontier candidate metrics are incomplete") }
    else if code == 117 { print("alternative frontier candidate value does not match the frontier subject type") }
    else if code == 118 { print("alternative frontier contains a dominated or duplicate candidate") }
    else if code == 119 { print("alternative policy target or objective metadata is invalid for this frontier") }
    else if code == 120 { print("alternative_option(...) requires AlternativeSet<T> and a literal in-range index") }
    else if code == 121 { print("alternative_reason(...) requires AlternativeOption<T>") }
    else if code == 122 { print("alternative frontier requires unavailable deferred, audit, or contest metadata") }
    else if code == 123 { print("commit_alternative(...) requires AlternativeOption<T>") }
    else if code == 124 { print("transition protocol target does not match the supplied alternative type") }
    else if code == 125 { print("transition policy target does not match the supplied alternative type") }
    else if code == 126 { print("final transition step does not equal the selected alternative value") }
    else if code == 127 { print("transition step value does not match the underlying subject type") }
    else if code == 128 { print("transition protocol exceeds the declared max_steps bound") }
    else if code == 129 { print("transition requirement references unavailable evidence") }
    else if code == 130 { print("transition_reason(...) requires TransitionPlan<T>") }
    else if code == 131 { print("observe_transition(...) requires TransitionPlan<T>") }
    else if code == 132 { print("monitoring policy target does not match the supplied transition subject type") }
    else if code == 133 { print("rollback_transition(...) requires TransitionPlan<T>") }
    else if code == 134 { print("rollback_transition(...) requires a violated or unavailable monitoring guard") }
    else if code == 135 { print("monitoring policy requires unavailable transition evidence") }
    else if code == 136 { print("monitoring policy obligation failed") }
    // Sprint 29: Do-calculus type checking errors (138-141)
    else if code == 138 { print("front-door criterion failed: no mediator set intercepts all directed paths from cause to effect") }
    else if code == 139 { print("do-calculus Rule 1 violated: observation is not d-separated from outcome given intervention") }
    else if code == 140 { print("do-calculus Rule 2 violated: action cannot be replaced by observation in this graph") }
    else if code == 141 { print("do-calculus Rule 3 violated: action cannot be deleted from this graph") }
    // GPU kernel constraints (70-72)
    else if code == 70 { print("kernel function cannot have IO, Mut, or Alloc effect") }
    else if code == 71 { print("kernel function parameter type is not GPU-compatible") }
    else if code == 72 { print("kernel function must return unit type") }
    else { print("unknown error") }
}

// Print help text for error codes (actionable fix suggestions)
fn print_error_help(code: i64) with IO, Mut, Panic, Div {
    // Basic types (1-10) - top 10 most common errors
    if code == 1 {
        print("   |\n   = help: the variable declaration and assigned value have incompatible types\n")
    }
    else if code == 2 {
        print("   |\n   = help: ensure the value type matches the target type for this assignment\n")
    }
    else if code == 3 {
        print("   |\n   = help: declare the variable with `var` instead of `let` to allow mutation\n")
    }
    else if code == 4 {
        print("   |\n   = help: use explicit type conversion with `as` if the types are compatible\n")
    }
    else if code == 5 {
        print("   |\n   = help: check that the operator is valid for this type (e.g., `-x` for numbers, `!x` for bools)\n")
    }
    else if code == 6 {
        print("   |\n   = help: use a comparison operator (e.g., `==`, `!=`, `<`, `>`) to produce a boolean\n")
    }
    else if code == 7 {
        print("   |\n   = help: ensure both branches return the same type, or use explicit conversion\n")
    }
    else if code == 8 {
        print("   |\n   = help: change the return value type to match the function's declared return type\n")
    }
    else if code == 9 {
        print("   |\n   = help: check the function signature and provide an argument of the correct type\n")
    }
    else if code == 10 {
        print("   |\n   = help: check the function signature for the correct number of arguments\n")
    }
    // Member access (11-16)
    else if code == 11 {
        print("   |\n   = help: check the method name and ensure it is defined for this type\n")
    }
    else if code == 12 {
        print("   |\n   = help: check the field name in the type definition\n")
    }
    else if code == 13 {
        print("   |\n   = help: use square brackets `[]` only on array types\n")
    }
    else if code == 14 {
        print("   |\n   = help: use an integer type (i8, i32, i64, u8, u32, u64) for array indices\n")
    }
    else if code == 15 {
        print("   |\n   = help: ensure the struct is defined or imported in this module\n")
    }
    else if code == 16 {
        print("   |\n   = help: ensure the field initializer matches the declared field type\n")
    }
    // Callables/control flow (17-21)
    else if code == 17 {
        print("   |\n   = help: only functions and methods can be called with parentheses\n")
    }
    else if code == 18 {
        print("   |\n   = help: all match arms must return the same type\n")
    }
    else if code == 19 {
        print("   |\n   = help: method calls using `.` syntax are only supported on structs and built-in types\n")
    }
    else if code == 20 {
        print("   |\n   = help: arrays require all elements to have the same type; consider using a tuple for mixed types\n")
    }
    else if code == 21 {
        print("   |\n   = help: compound assignments like `+=` require the operands to be compatible\n")
    }
    // Epistemic (22)
    else if code == 22 {
        print("   |\n   = help: epsilon must be a value between 0.0 (certain) and 1.0 (unknown)\n")
    }
    // Hypercomplex (30-34)
    else if code == 30 {
        print("   |\n   = help: values from different hypercomplex algebras cannot be combined directly\n")
    }
    else if code == 31 {
        print("   |\n   = help: add `with Div` to the function signature to enable division\n")
    }
    else if code == 32 {
        print("   |\n   = help: octonions, sedenions, and clifford algebras do not support division\n")
    }
    else if code == 33 {
        print("   |\n   = help: clifford algebras must have the same (p,q) signature to be combined\n")
    }
    else if code == 34 {
        print("   |\n   = help: hypercomplex algebras cannot be narrowed to a lower-dimensional algebra\n")
    }
    // Effects (35)
    else if code == 35 {
        print("   |\n   = help: add the missing effect to the function's `with` clause\n")
    }
    // Epistemic propagation (36)
    else if code == 36 {
        print("   |\n   = help: tighten the epsilon bound or use a more precise measurement\n")
    }
    // Borrow checker (37-40)
    else if code == 37 {
        print("   |\n   = help: shared borrows (`&x`) cannot coexist with exclusive borrows (`&!x`)\n")
    }
    else if code == 38 {
        print("   |\n   = help: drop other borrows before acquiring an exclusive borrow (`&!x`)\n")
    }
    else if code == 39 {
        print("   |\n   = help: linear values can only be used once; clone the value if needed\n")
    }
    else if code == 40 {
        print("   |\n   = help: consume the linear value by using it in a function call or assignment\n")
    }
    // Units/refinement (41-43)
    else if code == 41 {
        print("   |\n   = help: convert units before combining values in arithmetic operations\n")
    }
    else if code == 42 {
        print("   |\n   = help: the value violates the refinement type constraint\n")
    }
    else if code == 43 {
        print("   |\n   = help: unit conversions require compatible dimensions (e.g., meters to kilometers)\n")
    }
    // Phase A additions (44-51)
    else if code == 44 {
        print("   |\n   = help: move `break` inside a `while` or `loop` block\n")
    }
    else if code == 45 {
        print("   |\n   = help: move `continue` inside a `while` or `loop` block\n")
    }
    else if code == 46 {
        print("   |\n   = help: provide values for all fields declared in the struct definition\n")
    }
    else if code == 47 {
        print("   |\n   = help: tuple indices must be within the tuple's element count\n")
    }
    else if code == 48 {
        print("   |\n   = help: bitwise operators (`&`, `|`, `^`) require integer operands\n")
    }
    else if code == 49 {
        print("   |\n   = help: shift operators (`<<`, `>>`) require integer operands\n")
    }
    else if code == 50 {
        print("   |\n   = help: modulo operator (`%`) requires integer operands\n")
    }
    else if code == 51 {
        print("   |\n   = help: logical operators (`&&`, `||`) require boolean operands\n")
    }
    // Phase B.3 additions (52-54)
    else if code == 52 {
        print("   |\n   = help: provide a value that satisfies the refinement predicate\n")
    }
    else if code == 53 {
        print("   |\n   = help: add the required effect to the closure's signature\n")
    }
    else if code == 54 {
        print("   |\n   = help: check the Knowledge metadata for valid constraint syntax\n")
    }
    else if code == 55 {
        print("   |\n   = help: range endpoints must be integers (i32 or i64)\n")
    }
    else if code == 56 {
        print("   |\n   = help: dividing by zero is undefined; check the denominator\n")
    }
    else if code == 57 {
        print("   |\n   = help: modulo by zero is undefined; check the divisor\n")
    }
    else if code == 58 {
        print("   |\n   = help: call prove_robust(contest_expr, policy_expr) with Contest<T> and Policy<T> over the same T\n")
    }
    else if code == 59 {
        print("   |\n   = help: bind the expression with an explicit type such as `let c: Contest<T> = contest [...] on data`\n")
    }
    else if code == 63 {
        print("   |\n   = help: use Model<I, O>, Contest<T, Family, Policy>, Robust<T, Level, Scope>, or the legacy single-argument migration forms with the correct arity\n")
    }
    else if code == 79 {
        print("   |\n   = help: pass a Contest<T, Family, Policy> value instead of a plain datum or downstream proof token\n")
    }
    else if code == 80 {
        print("   |\n   = help: ensure the contest was realized through an explicit Contest<T, Family, Policy> annotation before calling witness builtins\n")
    }
    else if code == 81 {
        print("   |\n   = help: attach or compute the missing contest metric before projecting it\n")
    }
    else if code == 82 {
        print("   |\n   = help: attach a mechanistic report before calling disagreement(contest_value) or mechanistic_divergence(contest_value)\n")
    }
    else if code == 83 {
        print("   |\n   = help: attach a counterexample record before calling counterexample(contest_value)\n")
    }
    else if code == 84 {
        print("   |\n   = help: attach posterior weights before calling posterior_weights(contest_value)\n")
    }
    else if code == 85 {
        print("   |\n   = help: declare the audit target as Contest<T, Family, Policy> with an explicit named models family and policy\n")
    }
    else if code == 86 {
        print("   |\n   = help: attach named audits only to full Contest<T, Family, Policy> values\n")
    }
    else if code == 87 {
        print("   |\n   = help: keep the audit target triple identical to the attached contest's inner type, family, and policy\n")
    }
    else if code == 88 {
        print("   |\n   = help: cover the declared model family exactly once in posterior_weights { ... }\n")
    }
    else if code == 89 {
        print("   |\n   = help: keep all posterior weights non-negative and normalized to 1.0 within the audit block\n")
    }
    else if code == 90 {
        print("   |\n   = help: mechanistic { ... } must provide aggregate_divergence plus all five component distances\n")
    }
    else if code == 91 {
        print("   |\n   = help: counterexample { ... } must provide model_name, subgroup_name, metric_name, observed_value, threshold_value, and summary\n")
    }
    else if code == 92 {
        print("   |\n   = help: remove duplicate audit fields and keep section/field names within the supported audit schema\n")
    }
    else if code == 93 {
        print("   |\n   = help: declare `decision_policy Name for T { ... }` and call admit_action(value, robust_value, Name)\n")
    }
    else if code == 94 {
        print("   |\n   = help: keep the admitted value, Robust<T>, and decision_policy target on the same T\n")
    }
    else if code == 95 {
        print("   |\n   = help: use the result of prove_robust(contest_value, PolicyName) directly instead of a bare Robust<T, Level, Scope> annotation\n")
    }
    else if code == 96 {
        print("   |\n   = help: satisfy the decision policy obligations or strengthen the robust proof metadata before admitting action\n")
    }
    // Causal identifiability (67-68)
    else if code == 67 {
        print("   |\n   = help: ensure the causal DAG has observed confounders that block all backdoor paths from cause to effect, or use an instrumental variable\n")
    }
    else if code == 68 {
        print("   |\n   = help: condition on an observed set Z that blocks all non-causal paths from cause to effect\n")
    }
    // GPU kernel constraints (70-72)
    else if code == 70 {
        print("   |\n   = help: kernel functions can only use GPU, Panic, and Div effects\n")
    }
    else if code == 71 {
        print("   |\n   = help: kernel parameters must be scalar types (i32, i64, f32, f64) or references to scalar arrays\n")
    }
    else if code == 72 {
        print("   |\n   = help: kernel functions execute on GPU and cannot return values; use &![T] output parameters instead\n")
    }
    // Sprint 29: Do-calculus type checking (138-141)
    else if code == 138 {
        print("   |\n   = help: ensure a mediating variable exists on all directed paths, with no confounding bypasses\n")
    }
    else if code == 139 {
        print("   |\n   = help: the observation variable has a non-causal path to the outcome; consider adjusting the conditioning set\n")
    }
    else if code == 140 {
        print("   |\n   = help: the intervention do(Z) cannot be reduced to observation Z in this causal graph\n")
    }
    else if code == 141 {
        print("   |\n   = help: the intervention do(Z) has an effect on the outcome that cannot be eliminated\n")
    }
    else {
        // No help available for unknown errors
    }
}

// Print note text for error codes (additional context)
fn print_error_note(code: i64) with IO, Mut, Panic, Div {
    // Basic types (1-10)
    if code == 1 {
        print("   = note: Sounio requires explicit type conversions—use `as` to convert between compatible types\n")
    }
    else if code == 2 {
        print("   = note: assignment requires type compatibility; consider using an explicit cast or conversion\n")
    }
    else if code == 3 {
        print("   = note: `let` bindings are immutable by default; use `var` for mutable variables\n")
    }
    else if code == 4 {
        print("   = note: binary operators require operands of compatible types\n")
    }
    else if code == 5 {
        print("   = note: unary operators are type-specific (e.g., `-` for numbers, `!` for bools, `&`/`&!` for borrows)\n")
    }
    else if code == 6 {
        print("   = note: condition expressions must evaluate to a boolean value\n")
    }
    else if code == 7 {
        print("   = note: the type of an if-expression is determined by its branches\n")
    }
    else if code == 8 {
        print("   = note: the return type is declared in the function signature\n")
    }
    else if code == 9 {
        print("   = note: function arguments are checked against the declared parameter types\n")
    }
    else if code == 10 {
        print("   = note: argument count must match the function's parameter list\n")
    }
    // Member access (11-16)
    else if code == 11 {
        print("   = note: methods are resolved based on the type of the receiver\n")
    }
    else if code == 12 {
        print("   = note: field names must match the struct definition exactly\n")
    }
    else if code == 13 {
        print("   = note: arrays are indexed with square brackets using integer indices\n")
    }
    else if code == 14 {
        print("   = note: array indexing requires an integer type\n")
    }
    else if code == 15 {
        print("   = note: struct types must be defined before use\n")
    }
    else if code == 16 {
        print("   = note: struct field initializers must match the field's declared type\n")
    }
    // Callables/control flow (17-21)
    else if code == 17 {
        print("   = note: call expressions require a function or callable value\n")
    }
    else if code == 18 {
        print("   = note: match expressions require all arms to have the same type\n")
    }
    else if code == 19 {
        print("   = note: method call syntax (`.method()`) is only valid for certain types\n")
    }
    else if code == 20 {
        print("   = note: arrays are homogeneous—all elements must have the same type\n")
    }
    else if code == 21 {
        print("   = note: compound assignment operators require type compatibility\n")
    }
    // Epistemic (22)
    else if code == 22 {
        print("   = note: epsilon bounds represent confidence levels (0.0 = certain, 1.0 = unknown)\n")
    }
    // Hypercomplex (30-34)
    else if code == 30 {
        print("   = note: hypercomplex algebras (Real, Complex, Quaternion, etc.) are distinct type families\n")
    }
    else if code == 31 {
        print("   = note: division is an effect that must be declared in the function signature\n")
    }
    else if code == 32 {
        print("   = note: division is only supported for Real, Complex, and Quaternion algebras\n")
    }
    else if code == 33 {
        print("   = note: clifford algebra signatures (p,q) define the algebra's properties\n")
    }
    else if code == 34 {
        print("   = note: narrowing would lose information about the hypercomplex structure\n")
    }
    // Effects (35)
    else if code == 35 {
        print("   = note: effects must be explicitly declared in function signatures\n")
    }
    // Epistemic propagation (36)
    else if code == 36 {
        print("   = note: epistemic values carry confidence bounds that must be preserved\n")
    }
    // Borrow checker (37-40)
    else if code == 37 {
        print("   = note: shared borrows (`&T`) allow multiple readers; exclusive borrows (`&!T`) allow one writer\n")
    }
    else if code == 38 {
        print("   = note: exclusive borrows require exclusive access to the value\n")
    }
    else if code == 39 {
        print("   = note: linear types enforce single-use semantics for resources\n")
    }
    else if code == 40 {
        print("   = note: linear types must be consumed exactly once\n")
    }
    // Units/refinement (41-43)
    else if code == 41 {
        print("   = note: unit dimensions must match for addition and subtraction\n")
    }
    else if code == 42 {
        print("   = note: refinement types constrain values to satisfy predicates\n")
    }
    else if code == 43 {
        print("   = note: unit conversions preserve dimensionality (e.g., length to length)\n")
    }
    // Phase A additions (44-51)
    else if code == 44 {
        print("   = note: `break` terminates the nearest enclosing loop\n")
    }
    else if code == 45 {
        print("   = note: `continue` skips to the next iteration of the nearest enclosing loop\n")
    }
    else if code == 46 {
        print("   = note: struct literals must initialize all declared fields\n")
    }
    else if code == 47 {
        print("   = note: tuple indices are 0-based and must be within bounds\n")
    }
    else if code == 48 {
        print("   = note: bitwise operations work on integer representations\n")
    }
    else if code == 49 {
        print("   = note: shift operations move bits left or right in the integer representation\n")
    }
    else if code == 50 {
        print("   = note: modulo returns the remainder of integer division\n")
    }
    else if code == 51 {
        print("   = note: logical operations combine boolean values\n")
    }
    // Phase B.3 additions (52-54)
    else if code == 52 {
        print("   = note: refinement types are checked at call boundaries\n")
    }
    else if code == 53 {
        print("   = note: closures inherit effect requirements from their body\n")
    }
    else if code == 54 {
        print("   = note: Knowledge metadata constrains epistemic values\n")
    }
    else if code == 55 {
        print("   = note: range expressions require integer endpoints for iteration\n")
    }
    else if code == 56 {
        print("   = note: integer division by zero causes undefined behavior\n")
    }
    else if code == 57 {
        print("   = note: integer modulo by zero causes undefined behavior\n")
    }
    else if code == 58 {
        print("   = note: unresolved model disagreement remains obstructive until fenced by an explicit robustness proof\n")
    }
    else if code == 59 {
        print("   = note: Contest expressions do not infer a plain result type because that would erase unresolved disagreement\n")
    }
    else if code == 63 {
        print("   = note: the self-hosted compiler now tracks selected Contest/Robust metadata, but malformed wrapper arity and unknown level/scope tags still fail closed\n")
    }
    else if code == 79 {
        print("   = note: witness builtins observe disagreement without collapsing Contest<T, ...> into a plain value\n")
    }
    else if code == 80 {
        print("   = note: shorthand Contest<T> remains parser-compatible, but witness projections require realized contest metadata\n")
    }
    else if code == 81 {
        print("   = note: scalar witness projections are proof-time reads from contest diagnostics, not runtime estimators\n")
    }
    else if code == 82 {
        print("   = note: mechanistic disagreement is distinct from predictive spread and must be attached explicitly\n")
    }
    else if code == 83 {
        print("   = note: counterexample witnesses are explicit failure records, not synthesized examples\n")
    }
    else if code == 84 {
        print("   = note: posterior weights remain explicit contest metadata and are never inferred by silent averaging\n")
    }
    else if code == 85 {
        print("   = note: named audit attachments are only well-typed for full contested values, not shorthand wrappers\n")
    }
    else if code == 86 {
        print("   = note: audit attachment is zero-cost at runtime but strict at the type boundary\n")
    }
    else if code == 87 {
        print("   = note: audits are evidence records for a specific contested claim, not reusable across different families or policies\n")
    }
    else if code == 88 {
        print("   = note: posterior weights must preserve the declared model set instead of laundering disagreement through partial weight maps\n")
    }
    else if code == 89 {
        print("   = note: posterior weights are audit data and must already sum to one before robustness is considered\n")
    }
    else if code == 90 {
        print("   = note: mechanistic disagreement is not reducible to predictive spread, so partial mechanistic blocks are rejected\n")
    }
    else if code == 91 {
        print("   = note: counterexample witnesses remain concrete single-record failure artifacts in this milestone\n")
    }
    else if code == 92 {
        print("   = note: audit parsing preserves unknown or duplicate fields so the checker can fail closed semantically\n")
    }
    else if code == 93 {
        print("   = note: decision admissibility is explicit and auditable; bare type annotations do not carry admission policy evidence\n")
    }
    else if code == 94 {
        print("   = note: robust inference and admissible action are intentionally separated in this milestone\n")
    }
    else if code == 95 {
        print("   = note: action admission consumes an auditable robustness proof record instead of trusting wrapper syntax alone\n")
    }
    else if code == 96 {
        print("   = note: action remains fenced until the decision policy is satisfied by explicit proof-time evidence\n")
    }
    else if code == 97 {
        print("   = note: deferral routing is explicit and auditable; bare wrapper shapes do not imply abstention\n")
    }
    else if code == 98 {
        print("   = note: deferral policies are tied to a specific T so escalation cannot be laundered across subjects\n")
    }
    else if code == 99 {
        print("   = note: deferral consumes contested or robust evidence explicitly; plain values cannot self-abstain\n")
    }
    else if code == 100 {
        print("   = note: deferral policies are proof obligations, not a soft fallback when admission fails\n")
    }
    else if code == 101 {
        print("   = note: deferral reasons are witness values over explicit deferral certificates only\n")
    }
    else if code == 102 {
        print("   = note: acquisition planning is a post-deferral certificate, not a direct escape from contested evidence\n")
    }
    else if code == 103 {
        print("   = note: recourse planning is a post-deferral certificate, not a direct escape from contested evidence\n")
    }
    else if code == 104 {
        print("   = note: acquisition plans stay tied to a specific T so follow-up evidence gathering cannot drift across subjects\n")
    }
    else if code == 105 {
        print("   = note: recourse plans stay tied to a specific T so next-step routing cannot be laundered across subjects\n")
    }
    else if code == 106 {
        print("   = note: acquisition policies read the deferred evidence snapshot and fail closed when audit data are missing\n")
    }
    else if code == 107 {
        print("   = note: recourse policies read the deferred evidence snapshot and fail closed when audit data are missing\n")
    }
    else if code == 108 {
        print("   = note: acquisition reasons are witness values over explicit acquisition plans only\n")
    }
    else if code == 109 {
        print("   = note: recourse reasons are witness values over explicit recourse plans only\n")
    }
    else if code == 110 {
        print("   = note: deferred values must carry a recorded certificate so downstream routing stays auditable\n")
    }
    else if code == 111 {
        print("   = note: acquisition remains explicit and auditable; the policy item names the intended evidence-gathering route\n")
    }
    else if code == 112 {
        print("   = note: recourse remains explicit and auditable; the policy item names the intended post-deferral route\n")
    }
    else if code == 113 {
        print("   = note: set-valued alternatives are fenced behind Deferred<T> or RecoursePlan<T>; raw contested evidence cannot jump ahead\n")
    }
    else if code == 114 {
        print("   = note: an alternative frontier is certified for one evidence shape only: Deferred<T> or RecoursePlan<T>\n")
    }
    else if code == 115 {
        print("   = note: Deferred<T> frontiers stay tied to explicit recourse policies so multi-strategy alternatives remain auditable\n")
    }
    else if code == 116 {
        print("   = note: Pareto frontiers fail closed when a candidate omits any objective metric\n")
    }
    else if code == 117 {
        print("   = note: each alternative candidate must still inhabit the same underlying T\n")
    }
    else if code == 118 {
        print("   = note: the compiler preserves only explicit non-dominated alternatives; it does not silently prune or rank them\n")
    }
    else if code == 119 {
        print("   = note: frontier policy objectives and target T must line up exactly before alternatives can be certified\n")
    }
    else if code == 120 {
        print("   = note: alternative_option(...) is intentionally literal-indexed in v1 so the chosen option stays compile-time auditable\n")
    }
    else if code == 121 {
        print("   = note: alternative reasons are witness values over certified AlternativeOption<T> choices only\n")
    }
    else if code == 122 {
        print("   = note: alternative frontiers consume deferred audit metadata explicitly and fail closed when that evidence is missing\n")
    }
    else {
        // No note available for unknown errors
    }
}

// ============================================================
// Borrow checking helpers
// ============================================================

fn call_expr_is_builtin_prove_robust(opt: Option<Box<Expr>>) -> bool with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(expr) => {
            if (*expr).kind != ExprKind::ExprIdent {
                return false
            }
            name_matches_str12((*expr).name, 112, 114, 111, 118, 101, 95, 114, 111, 98, 117, 115, 116)
        }
        None => false
    }
}

