            strategy_name: info.strategy_name,
            route_name: info.route_name,
            inner_ty: info.inner_ty,
            metric_known: info.metric_known,
            metric_values: info.metric_values,
        }
        i = i + 1
    }

    ep.recourse_reason_witness_count = checker.recourse_reason_witnesses.count
    if ep.recourse_reason_witness_count > IR_MAX_EPI_RECOURSE_REASON_WITNESSES {
        ep.recourse_reason_witness_count = IR_MAX_EPI_RECOURSE_REASON_WITNESSES
    }
    i = 0
    while i < ep.recourse_reason_witness_count {
        let info = checker.recourse_reason_witnesses.get(i)
        ep.recourse_reason_witnesses[i as usize] = IrRecourseReasonWitnessInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            recourse_plan_id: info.recourse_plan_id,
        }
        i = i + 1
    }

    ep.transition_policy_count = checker.transition_policies.count
    if ep.transition_policy_count > IR_MAX_EPI_TRANSITION_POLICIES {
        ep.transition_policy_count = IR_MAX_EPI_TRANSITION_POLICIES
    }
    i = 0
    while i < ep.transition_policy_count {
        let info = checker.transition_policies.get(i)
        ep.transition_policies[i as usize] = IrTransitionPolicyInfo {
            id: i,
            name: info.name,
            target_ty: info.target_ty,
            route_name: info.route_name,
            requirements: check_policy_requirements_to_ir(info.requirements, [ir_empty_policy_requirement_info(); 8], 0),
            requirement_count: info.requirement_count,
            max_steps: info.max_steps,
            rollback_route_name: info.rollback_route_name,
        }
        i = i + 1
    }

    ep.transition_protocol_count = checker.transition_protocols.count
    if ep.transition_protocol_count > IR_MAX_EPI_TRANSITION_PROTOCOLS {
        ep.transition_protocol_count = IR_MAX_EPI_TRANSITION_PROTOCOLS
    }
    i = 0
    while i < ep.transition_protocol_count {
        let info = checker.transition_protocols.get(i)
        let step_start: i64 = if info.step_count > 0 { info.step_ids[0] } else { -1 }
        ep.transition_protocols[i as usize] = IrTransitionProtocolInfo {
            id: i,
            name: info.name,
            target_ty: info.target_ty,
            transition_policy_id: info.transition_policy_id,
            step_start: step_start,
            step_count: info.step_count,
        }
        i = i + 1
    }

    ep.transition_step_count = checker.transition_steps.count
    if ep.transition_step_count > IR_MAX_EPI_TRANSITION_STEPS {
        ep.transition_step_count = IR_MAX_EPI_TRANSITION_STEPS
    }
    i = 0
    while i < ep.transition_step_count {
        let info = checker.transition_steps.get(i)
        ep.transition_steps[i as usize] = IrTransitionStepInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            protocol_id: info.protocol_id,
            name: info.name,
            value_repr: info.value_repr,
            requirements: check_policy_requirements_to_ir(info.requirements, [ir_empty_policy_requirement_info(); 8], 0),
            requirement_count: info.requirement_count,
        }
        i = i + 1
    }

    ep.transition_plan_count = checker.transition_plans.count
    if ep.transition_plan_count > IR_MAX_EPI_TRANSITION_PLANS {
        ep.transition_plan_count = IR_MAX_EPI_TRANSITION_PLANS
    }
    i = 0
    while i < ep.transition_plan_count {
        let info = checker.transition_plans.get(i)
        ep.transition_plans[i as usize] = IrTransitionPlanInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            transition_policy_id: info.transition_policy_id,
            transition_protocol_id: info.transition_protocol_id,
            alternative_option_id: info.alternative_option_id,
            audit_id: info.audit_id,
            contest_id: info.contest_id,
            route_name: info.route_name,
            rollback_route_name: info.rollback_route_name,
            step_count: info.step_count,
            final_value_repr: info.final_value_repr,
            inner_ty: info.inner_ty,
            metric_known: info.metric_known,
            metric_values: info.metric_values,
        }
        i = i + 1
    }

    ep.transition_reason_witness_count = checker.transition_reason_witnesses.count
    if ep.transition_reason_witness_count > IR_MAX_EPI_TRANSITION_REASON_WITNESSES {
        ep.transition_reason_witness_count = IR_MAX_EPI_TRANSITION_REASON_WITNESSES
    }
    i = 0
    while i < ep.transition_reason_witness_count {
        let info = checker.transition_reason_witnesses.get(i)
        ep.transition_reason_witnesses[i as usize] = IrTransitionReasonWitnessInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            transition_plan_id: info.transition_plan_id,
        }
        i = i + 1
    }

    ep.monitoring_policy_count = checker.monitoring_policies.count
    if ep.monitoring_policy_count > IR_MAX_EPI_MONITORING_POLICIES {
        ep.monitoring_policy_count = IR_MAX_EPI_MONITORING_POLICIES
    }
    i = 0
    while i < ep.monitoring_policy_count {
        let info = checker.monitoring_policies.get(i)
        ep.monitoring_policies[i as usize] = IrMonitoringPolicyInfo {
            id: i,
            name: info.name,
            target_ty: info.target_ty,
            route_name: info.route_name,
            requirements: check_policy_requirements_to_ir(info.requirements, [ir_empty_policy_requirement_info(); 8], 0),
            requirement_count: info.requirement_count,
            rollback_route_name: info.rollback_route_name,
        }
        i = i + 1
    }

    ep.observed_transition_count = checker.observed_transitions.count
    if ep.observed_transition_count > IR_MAX_EPI_OBSERVED_TRANSITIONS {
        ep.observed_transition_count = IR_MAX_EPI_OBSERVED_TRANSITIONS
    }
    i = 0
    while i < ep.observed_transition_count {
        let info = checker.observed_transitions.get(i)
        ep.observed_transitions[i as usize] = IrObservedTransitionInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            transition_plan_id: info.transition_plan_id,
            monitoring_policy_id: info.monitoring_policy_id,
            audit_id: info.audit_id,
            contest_id: info.contest_id,
            route_name: info.route_name,
            rollback_route_name: info.rollback_route_name,
            inner_ty: info.inner_ty,
            metric_known: info.metric_known,
            metric_values: info.metric_values,
        }
        i = i + 1
    }

    ep.rollback_certificate_count = checker.rollback_certificates.count
    if ep.rollback_certificate_count > IR_MAX_EPI_ROLLBACK_CERTIFICATES {
        ep.rollback_certificate_count = IR_MAX_EPI_ROLLBACK_CERTIFICATES
    }
    i = 0
    while i < ep.rollback_certificate_count {
        let info = checker.rollback_certificates.get(i)
        ep.rollback_certificates[i as usize] = IrRollbackCertificateInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            transition_plan_id: info.transition_plan_id,
            monitoring_policy_id: info.monitoring_policy_id,
            audit_id: info.audit_id,
            contest_id: info.contest_id,
            route_name: info.route_name,
            rollback_route_name: info.rollback_route_name,
            reason_code: info.reason_code,
            inner_ty: info.inner_ty,
            metric_known: info.metric_known,
            metric_values: info.metric_values,
        }
        i = i + 1
    }

    ep.alternative_policy_count = checker.alternative_policies.count
    if ep.alternative_policy_count > IR_MAX_EPI_ALTERNATIVE_POLICIES {
        ep.alternative_policy_count = IR_MAX_EPI_ALTERNATIVE_POLICIES
    }
    i = 0
    while i < ep.alternative_policy_count {
        let info = checker.alternative_policies.get(i)
        var objective_names: [Name; 8] = [ir_empty_name(); 8]
        var j: i64 = 0
        while j < info.objective_count && j < 8 {
            objective_names[j as usize] = ir_alternative_metric_name(info.objective_metric_ids[j as usize])
            j = j + 1
        }
        ep.alternative_policies[i as usize] = IrAlternativePolicyInfo {
            id: i,
            name: info.name,
            target_ty: info.target_ty,
            frontier_kind: info.frontier_name,
            objective_names: objective_names,
            objective_directions: info.objective_directions,
            objective_count: info.objective_count,
            max_options: info.max_options,
        }
        i = i + 1
    }

    ep.alternative_frontier_count = checker.alternative_frontiers.count
    if ep.alternative_frontier_count > IR_MAX_EPI_ALTERNATIVE_FRONTIERS {
        ep.alternative_frontier_count = IR_MAX_EPI_ALTERNATIVE_FRONTIERS
    }
    i = 0
    while i < ep.alternative_frontier_count {
        let info = checker.alternative_frontiers.get(i)
        let candidate_start: i64 = if info.candidate_count > 0 { info.candidate_ids[0] } else { -1 }
        ep.alternative_frontiers[i as usize] = IrAlternativeFrontierInfo {
            id: i,
            name: info.name,
            target_kind: info.target_kind,
            target_ty: info.target_ty,
            alternative_policy_id: info.policy_id,
            audit_id: -1,
            contest_id: -1,
            source_policy_id: -1,
            source_plan_id: -1,
            candidate_start: candidate_start,
            candidate_count: info.candidate_count,
        }
        i = i + 1
    }

    ep.alternative_candidate_count = checker.alternative_candidates.count
    if ep.alternative_candidate_count > IR_MAX_EPI_ALTERNATIVE_CANDIDATES {
        ep.alternative_candidate_count = IR_MAX_EPI_ALTERNATIVE_CANDIDATES
    }
    i = 0
    while i < ep.alternative_candidate_count {
        let info = checker.alternative_candidates.get(i)
        ep.alternative_candidates[i as usize] = IrAlternativeCandidateInfo {
            id: i,
            frontier_id: info.frontier_id,
            name: info.name,
            value_repr: info.value_repr,
            source_kind: info.source_kind,
            source_policy_id: info.source_policy_id,
            source_plan_id: info.source_plan_id,
            strategy_name: info.strategy_name,
            route_name: info.route_name,
            audit_id: info.audit_id,
            contest_id: info.contest_id,
            intervention_cost: info.metric_values[ALTERNATIVE_METRIC_INTERVENTION_COST as usize],
            residual_tail_risk: info.metric_values[ALTERNATIVE_METRIC_RESIDUAL_TAIL_RISK as usize],
            mechanistic_divergence: info.metric_values[ALTERNATIVE_METRIC_MECHANISTIC_DIVERGENCE as usize],
            admissibility_margin: info.metric_values[ALTERNATIVE_METRIC_ADMISSIBILITY_MARGIN as usize],
            dominance_rank: info.dominance_rank,
        }
        i = i + 1
    }

    ep.alternative_set_count = checker.alternative_sets.count
    if ep.alternative_set_count > IR_MAX_EPI_ALTERNATIVE_SETS {
        ep.alternative_set_count = IR_MAX_EPI_ALTERNATIVE_SETS
    }
    i = 0
    while i < ep.alternative_set_count {
        let info = checker.alternative_sets.get(i)
        let candidate_start: i64 = if info.candidate_count > 0 { info.candidate_ids[0] } else { -1 }
        ep.alternative_sets[i as usize] = IrAlternativeSetInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            frontier_id: info.frontier_id,
            audit_id: info.audit_id,
            contest_id: info.contest_id,
            inner_ty: info.inner_ty,
            candidate_start: candidate_start,
            candidate_count: info.candidate_count,
        }
        i = i + 1
    }

    ep.alternative_reason_witness_count = checker.alternative_reason_witnesses.count
    if ep.alternative_reason_witness_count > IR_MAX_EPI_ALTERNATIVE_REASON_WITNESSES {
        ep.alternative_reason_witness_count = IR_MAX_EPI_ALTERNATIVE_REASON_WITNESSES
    }
    i = 0
    while i < ep.alternative_reason_witness_count {
        let info = checker.alternative_reason_witnesses.get(i)
        ep.alternative_reason_witnesses[i as usize] = IrAlternativeReasonWitnessInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            alternative_set_id: -1,
            candidate_id: info.candidate_id,
        }
        i = i + 1
    }

    ep.validated_manifest_count = checker.validated_manifests.count
    if ep.validated_manifest_count > IR_MAX_EPI_VALIDATED_MANIFESTS {
        ep.validated_manifest_count = IR_MAX_EPI_VALIDATED_MANIFESTS
    }
    i = 0
    while i < ep.validated_manifest_count {
        let info = checker.validated_manifests.get(i)
        ep.validated_manifests[i as usize] = IrValidatedManifestInfo {
            id: i,
            span_start: info.span_start,
            span_end: info.span_end,
            audit_id: info.audit_id,
            robust_proof_id: info.robust_proof_id,
            validation_id: info.validation_id,
            inner_ty: info.inner_ty,
        }
        i = i + 1
    }
}

// ============================================================
// Error reporting
// ============================================================

// ============================================================
// Type pretty-printing for diagnostics
// ============================================================

fn print_type_name(ty: TypeEntry) with IO, Mut, Panic, Div, Alloc {
    match ty.kind {
        TyI8 => print("i8")
        TyI32 => print("i32")
        TyI64 => print("i64")
        TyU8 => print("u8")
        TyU32 => print("u32")
        TyU64 => print("u64")
        TyF32 => print("f32")
        TyF64 => print("f64")
        TyBool => print("bool")
        TyUnit => print("()")
        TyString => print("string")
        TyChar => print("char")
        TyNamed => {
            var i: i64 = 0
            while i < ty.name.len {
                print_char(ty.name.buf[i] as i64)
                i = i + 1
            }
        }
        TyArray => {
            print("[")
            match ty.inner {
                Some(elem) => print_type_name(*elem)
                None => print("?")
            }
            if ty.array_size >= 0 {
                print("; ")
                print_int(ty.array_size)
            }
            print("]")
        }
        TyRef => {
            print("&")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
        }
        TyRefMut => {
            print("&!")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
        }
        TyTuple => {
            print("(")
            print_tuple_type_elems(ty.tuple_elems)
            print(")")
        }
        TyFn => {
            print("fn#")
            print_int(ty.fn_sig_id)
        }
        TyKnowledge => {
            print("Knowledge<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            if ty.knowledge_epsilon >= 0.0 {
                // Print epsilon as integer percentage for diagnostics
                // (no float printing in Poseidon VM)
                print(", eps=")
                print_milli_ratio(ty.knowledge_epsilon)
            }
            print(">")
        }
        TyModel => {
            print("Model<")
            print_type_name(type_entry_list_get(ty.tuple_elems, 0))
            print(", ")
            print_type_name(type_entry_list_get(ty.tuple_elems, 1))
            print(">")
        }
        TyModelFamily => {
            print("ModelFamily<")
            print_type_name(type_entry_list_get(ty.tuple_elems, 0))
            print(", ")
            print_type_name(type_entry_list_get(ty.tuple_elems, 1))
            print(">")
        }
        TyPolicy => {
            print("Policy<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyAcquisitionPolicy => {
            print("AcquisitionPolicy<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyAcquisitionPlan => {
            print("AcquisitionPlan<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyRecoursePolicy => {
            print("RecoursePolicy<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyRecoursePlan => {
            print("RecoursePlan<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyAlternativePolicy => {
            print("AlternativePolicy<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyAlternativeSet => {
            print("AlternativeSet<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyAlternativeOption => {
            print("AlternativeOption<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyTransitionPolicy => {
            print("TransitionPolicy<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyTransitionPlan => {
            print("TransitionPlan<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyDecisionPolicy => {
            print("DecisionPolicy<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyDeferralPolicy => {
            print("DeferralPolicy<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyContest => {
            print("Contest<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyRobust => {
            print("Robust<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            if ty.robustness_level_id >= 0 || ty.robustness_scope_id >= 0 {
                print(", level=")
                print_int(ty.robustness_level_id)
                print(", scope=")
                print_int(ty.robustness_scope_id)
            }
            print(">")
        }
        TyIntervention => {
            print("Intervention<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyCounterfactual => {
            print("Counterfactual<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyValidated => {
            print("Validated<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyAdmissible => {
            print("Admissible<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyDeferred => {
            print("Deferred<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyValidation => {
            print("Validation<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyHyper => {
            print("Hyper<")
            if ty.algebra_kind == 0 { print("Real") }
            else if ty.algebra_kind == 1 { print("Complex") }
            else if ty.algebra_kind == 2 { print("Quaternion") }
            else if ty.algebra_kind == 3 { print("Octonion") }
            else if ty.algebra_kind == 4 { print("Sedenion") }
            else if ty.algebra_kind == 5 {
                print("Clifford(")
                print_int(ty.clifford_p)
                print(",")
                print_int(ty.clifford_q)
                print(")")
            }
            else { print("?") }
            print(", ")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TySession => {
            let step_label = if ty.array_size == 0 { "send" } else if ty.array_size == 1 { "recv" } else { "close" }
            print("Session(")
            print(step_label)
            print(")")
        }
        TyChan => {
            print("chan ")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
        }
        TySessionEnd => print("SessionEnd")
        TySingleton => {
            print("Singleton<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", ")
            print_name_value(ty.name)
            print(">")
        }
        TyScopedEffect => {
            print("ScopedEffect<")
            print_name_value(ty.name)
            print(", ε=")
            print_milli_ratio(ty.knowledge_epsilon)
            print(">")
        }
        TyCondIndep => {
            print("IndepKnowledge<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", a=")
            print_int(ty.array_size)
            print(", b=")
            print_int(ty.fn_sig_id)
            if ty.epistemic_meta_id >= 0 {
                print(" | cond=")
                print_int(ty.epistemic_meta_id)
            }
            print(">")
        }
        TyPotentialOutcome => {
            print("PotentialOutcome<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", ctrl=")
            print_int(ty.epistemic_meta_id)
            print(", treat=")
            print_int(ty.robustness_level_id)
            print(">")
        }
        TyATE => {
            print("ATE<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(">")
        }
        TyDiffPrivate => {
            print("DiffPrivate<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", e=")
            print_milli_ratio(ty.knowledge_epsilon)
            print(">")
        }
        TyDPBudget => {
            print("DPBudget<total=")
            print_milli_ratio(ty.knowledge_epsilon)
            print(", spent=")
            print_milli_ratio_i64(ty.array_size)
            print(">")
        }
        TyTransportable => {
            print("Transport<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", src=")
            print_int(ty.epistemic_meta_id)
            print(", tgt=")
            print_int(ty.robustness_level_id)
            print(">")
        }
        TySelectionDiagram => {
            print("SelectionDiagram<s_nodes=")
            print_int(ty.array_size)
            print(">")
        }
        TyFairPrediction => {
            print("FairPrediction<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", criterion=")
            print_int(ty.array_size)
            print(", slack=")
            print_milli_ratio(ty.knowledge_epsilon)
            print(">")
        }
        TyFairnessGap => {
            print("FairnessGap<criterion=")
            print_int(ty.array_size)
            print(", gap=")
            print_milli_ratio(ty.knowledge_epsilon)
            print(">")
        }
        TyDistribution => {
            print("Distribution<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", kind=")
            print_int(ty.array_size)
            print(">")
        }
        TySample => {
            print("Sample<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", dist=")
            print_int(ty.array_size)
            print(", w=")
            print_milli_ratio(ty.knowledge_epsilon)
            print(">")
        }
        TyConditionalDist => {
            print("Conditional<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", updates=")
            print_int(ty.robustness_level_id)
            print(">")
        }
        TyEntropic => {
            print("Entropic<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", H<=")
            print_milli_ratio(ty.knowledge_epsilon)
            print("mnats>")
        }
        TyMutualInfo => {
            print("MutualInfo<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", Y=")
            print_int(ty.fn_sig_id)
            print(", I<=")
            print_milli_ratio(ty.knowledge_epsilon)
            print("mnats>")
        }
        TyKLBounded => {
            print("KLBounded<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", delta<=")
            print_milli_ratio(ty.knowledge_epsilon)
            print("mnats>")
        }
        TyVecShaped => {
            print("Vec<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", n=")
            print_int(ty.array_size)
            print(">")
        }
        TyMatrixShaped => {
            print("Matrix<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", m=")
            print_int(ty.algebra_kind)
            print(", n=")
            print_int(ty.array_size)
            print(">")
        }
        TyBroadcastable => {
            print("Broadcastable<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", target=")
            print_int(ty.algebra_kind)
            print("x")
            print_int(ty.array_size)
            print(">")
        }
        TyELBO => {
            print("ELBO<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", KL<=")
            print_milli_ratio(ty.knowledge_epsilon)
            print("mnats, iters=")
            print_int(ty.epistemic_meta_id)
            print(">")
        }
        TyVariationalFamily => {
            print("VarFamily<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", kind=")
            print_int(ty.array_size)
            print(", params=")
            print_int(ty.fn_sig_id)
            print(">")
        }
        TyDifferentiable => {
            print("Differentiable<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", C^")
            print_int(ty.array_size)
            print(">")
        }
        TyGradient => {
            print("Gradient<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", n=")
            print_int(ty.array_size)
            print(", m=")
            print_int(ty.algebra_kind)
            print(">")
        }
        TyJacobian => {
            print("Jacobian<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", n=")
            print_int(ty.array_size)
            print(", m=")
            print_int(ty.algebra_kind)
            print(">")
        }
        TyMarkovChain => {
            print("Markov<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", states=")
            print_int(ty.array_size)
            print(", kind=")
            print_int(ty.epistemic_meta_id)
            print(">")
        }
        TySDE => {
            print("SDE<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", dim=")
            print_int(ty.array_size)
            print(", kind=")
            print_int(ty.epistemic_meta_id)
            print(">")
        }
        TyMartingale => {
            print("Martingale<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", horizon=")
            print_int(ty.array_size)
            print(">")
        }
        TyStationaryDist => {
            print("StationaryDist<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", process=")
            print_int(ty.array_size)
            print(">")
        }
        TyBigO => {
            print("BigO<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", O(n^")
            print_int(ty.array_size)
            print(")>")
        }
        TyAmortized => {
            print("Amortized<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", O(n^")
            print_int(ty.array_size)
            print(")/op>")
        }
        TyProof => {
            print("Proof<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", kind=")
            print_int(ty.array_size)
            print(">")
        }
        TyLemma => {
            print("Lemma<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", id=")
            print_int(ty.array_size)
            print(", deps=")
            print_int(ty.epistemic_meta_id)
            print(">")
        }
        TyAxiom => {
            print("Axiom<")
            match ty.inner {
                Some(inner) => print_type_name(*inner)
                None => print("?")
            }
            print(", id=")
            print_int(ty.array_size)
            print(", class=")
            print_int(ty.epistemic_meta_id)
            print(">")
        }
        TyNever => print("!")
        TyError => print("<error>")
        TyUnknown => print("<unknown>")
    }
}

fn print_tuple_type_elems(opt: Option<Box<TypeEntryList>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        None => {}
        Some(list) => {
            print_type_name((*list).head)
            match (*list).tail {
                Some(_) => {
                    print(", ")
                    print_tuple_type_elems((*list).tail)
                }
                None => {}
            }
        }
    }
}

fn print_name_value(n: Name) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < n.len {
        print_char(n.buf[i] as i64)
        i = i + 1
    }
}

fn print_compare_op_value(op: CompareOp) with IO {
    match op {
        CmpLt => print("<")
        CmpLe => print("<=")
        CmpEq => print("==")
        CmpGe => print(">=")
        CmpGt => print(">")
    }
}

fn print_milli_ratio(value: f64) with IO {
    let milli = (value * 1000.0) as i64
    print_int(milli)
    print("/1000")
}

fn print_milli_ratio_i64(value: i64) with IO {
    print_int(value)
    print("/1000")
}

fn print_contest_metric_name(metric_id: i64) with IO {
    if metric_id == CONTEST_METRIC_SIGN_CONSENSUS { print("sign_consensus") }
    else if metric_id == CONTEST_METRIC_RELATIVE_BAND { print("relative_band") }
    else if metric_id == CONTEST_METRIC_MAX_TAIL_RISK { print("max_tail_risk") }
    else if metric_id == CONTEST_METRIC_MECHANISTIC_DIVERGENCE { print("mechanistic_divergence") }
    else if metric_id == CONTEST_METRIC_IDENTIFIABILITY_FLOOR { print("identifiability_floor") }
    else if metric_id == CONTEST_METRIC_COUNTEREXAMPLE_PRESENT { print("counterexample_present") }
    else if metric_id == CONTEST_METRIC_DEFERRED_REASON { print("deferred_reason") }
    else { print("unknown_metric") }
}

fn print_transition_metric_name(metric_id: i64) with IO {
    if metric_id == CONTEST_METRIC_SIGN_CONSENSUS
        || metric_id == CONTEST_METRIC_RELATIVE_BAND
        || metric_id == CONTEST_METRIC_MAX_TAIL_RISK
        || metric_id == CONTEST_METRIC_IDENTIFIABILITY_FLOOR
        || metric_id == CONTEST_METRIC_COUNTEREXAMPLE_PRESENT
        || metric_id == CONTEST_METRIC_DEFERRED_REASON {
        print_contest_metric_name(metric_id)
    } else if metric_id == TRANSITION_METRIC_INTERVENTION_COST {
        print("intervention_cost")
    } else if metric_id == TRANSITION_METRIC_RESIDUAL_TAIL_RISK {
        print("residual_tail_risk")
    } else if metric_id == TRANSITION_METRIC_MECHANISTIC_DIVERGENCE {
        print("mechanistic_divergence")
    } else if metric_id == TRANSITION_METRIC_ADMISSIBILITY_MARGIN {
        print("admissibility_margin")
    } else {
        print("unknown_metric")
    }
}

fn policy_metric_id_from_name(name: Name) -> i64 with Panic, Div {
    if name.len == 14
        && name.buf[0] == 115 as i8 && name.buf[1] == 105 as i8 && name.buf[2] == 103 as i8
        && name.buf[3] == 110 as i8 && name.buf[4] == 95 as i8 && name.buf[5] == 99 as i8
        && name.buf[6] == 111 as i8 && name.buf[7] == 110 as i8 && name.buf[8] == 115 as i8
        && name.buf[9] == 101 as i8 && name.buf[10] == 110 as i8 && name.buf[11] == 115 as i8
        && name.buf[12] == 117 as i8 && name.buf[13] == 115 as i8 {
        return CONTEST_METRIC_SIGN_CONSENSUS
    }
    if name.len == 13
        && name.buf[0] == 114 as i8 && name.buf[1] == 101 as i8 && name.buf[2] == 108 as i8
        && name.buf[3] == 97 as i8 && name.buf[4] == 116 as i8 && name.buf[5] == 105 as i8
        && name.buf[6] == 118 as i8 && name.buf[7] == 101 as i8 && name.buf[8] == 95 as i8
        && name.buf[9] == 98 as i8 && name.buf[10] == 97 as i8 && name.buf[11] == 110 as i8
        && name.buf[12] == 100 as i8 {
        return CONTEST_METRIC_RELATIVE_BAND
    }
    if name.len == 13
        && name.buf[0] == 109 as i8 && name.buf[1] == 97 as i8 && name.buf[2] == 120 as i8
        && name.buf[3] == 95 as i8 && name.buf[4] == 116 as i8 && name.buf[5] == 97 as i8
        && name.buf[6] == 105 as i8 && name.buf[7] == 108 as i8 && name.buf[8] == 95 as i8
        && name.buf[9] == 114 as i8 && name.buf[10] == 105 as i8 && name.buf[11] == 115 as i8
        && name.buf[12] == 107 as i8 {
        return CONTEST_METRIC_MAX_TAIL_RISK
    }
    if name.len == 22
        && name.buf[0] == 109 as i8 && name.buf[1] == 101 as i8 && name.buf[2] == 99 as i8
        && name.buf[3] == 104 as i8 && name.buf[4] == 97 as i8 && name.buf[5] == 110 as i8
        && name.buf[6] == 105 as i8 && name.buf[7] == 115 as i8 && name.buf[8] == 116 as i8
        && name.buf[9] == 105 as i8 && name.buf[10] == 99 as i8 && name.buf[11] == 95 as i8
        && name.buf[12] == 100 as i8 && name.buf[13] == 105 as i8 && name.buf[14] == 118 as i8
        && name.buf[15] == 101 as i8 && name.buf[16] == 114 as i8 && name.buf[17] == 103 as i8
        && name.buf[18] == 101 as i8 && name.buf[19] == 110 as i8 && name.buf[20] == 99 as i8
        && name.buf[21] == 101 as i8 {
        return CONTEST_METRIC_MECHANISTIC_DIVERGENCE
    }
    if name_matches_str21(name,
        105, 100, 101, 110, 116, 105, 102, 105, 97, 98, 105, 108, 105, 116, 121, 95, 102, 108, 111, 111, 114) {
        return CONTEST_METRIC_IDENTIFIABILITY_FLOOR
    }
    if name_matches_str22(name,
        99, 111, 117, 110, 116, 101, 114, 101, 120, 97, 109, 112, 108, 101, 95, 112, 114, 101, 115, 101, 110, 116) {
        return CONTEST_METRIC_COUNTEREXAMPLE_PRESENT
    }
    if name_matches_str15(name,
        100, 101, 102, 101, 114, 114, 101, 100, 95, 114, 101, 97, 115, 111, 110) {
        return CONTEST_METRIC_DEFERRED_REASON
    }
    -1
}

fn transition_policy_metric_id_from_name(name: Name) -> i64 with Panic, Div {
    if name_matches_str17(name,
        105, 110, 116, 101, 114, 118, 101, 110, 116, 105, 111, 110, 95, 99, 111, 115, 116) {
        return TRANSITION_METRIC_INTERVENTION_COST
    }
    if name_matches_str18(name,
        114, 101, 115, 105, 100, 117, 97, 108, 95, 116, 97, 105, 108, 95, 114, 105, 115, 107) {
        return TRANSITION_METRIC_RESIDUAL_TAIL_RISK
    }
    if name_matches_str22(name,
        109, 101, 99, 104, 97, 110, 105, 115, 116, 105, 99, 95, 100, 105, 118, 101, 114, 103, 101, 110, 99, 101) {
        return TRANSITION_METRIC_MECHANISTIC_DIVERGENCE
    }
    if name_matches_str20(name,
        97, 100, 109, 105, 115, 115, 105, 98, 105, 108, 105, 116, 121, 95, 109, 97, 114, 103, 105, 110) {
        return TRANSITION_METRIC_ADMISSIBILITY_MARGIN
    }
    policy_metric_id_from_name(name)
}

fn alternative_metric_id_from_name(name: Name) -> i64 with Panic, Div {
    if name_matches_str17(name,
        105, 110, 116, 101, 114, 118, 101, 110, 116, 105, 111, 110, 95, 99, 111, 115, 116) {
        return ALTERNATIVE_METRIC_INTERVENTION_COST
    }
    if name_matches_str18(name,
        114, 101, 115, 105, 100, 117, 97, 108, 95, 116, 97, 105, 108, 95, 114, 105, 115, 107) {
        return ALTERNATIVE_METRIC_RESIDUAL_TAIL_RISK
    }
    if name_matches_str22(name,
        109, 101, 99, 104, 97, 110, 105, 115, 116, 105, 99, 95, 100, 105, 118, 101, 114, 103, 101, 110, 99, 101) {
        return ALTERNATIVE_METRIC_MECHANISTIC_DIVERGENCE
    }
    if name_matches_str20(name,
        97, 100, 109, 105, 115, 115, 105, 98, 105, 108, 105, 116, 121, 95, 109, 97, 114, 103, 105, 110) {
        return ALTERNATIVE_METRIC_ADMISSIBILITY_MARGIN
    }
    -1
}

fn policy_requirement_holds(value: f64, op: CompareOp, threshold: f64) -> bool {
    if op == CompareOp::CmpLt { return value < threshold }
    if op == CompareOp::CmpLe { return value <= threshold }
    if op == CompareOp::CmpEq { return value == threshold }
    if op == CompareOp::CmpGe { return value >= threshold }
    value > threshold
}

fn print_policy_requirement_value(req: PolicyRequirementInfo) with IO, Mut, Panic, Div {
    if req.threshold_kind == POLICY_THRESHOLD_BOOL {
        if req.bool_threshold { print("true") } else { print("false") }
        return
    }
    if req.threshold_kind == POLICY_THRESHOLD_NAME && req.name_threshold.len > 0 {
        print_name_value(req.name_threshold)
        return
    }
    print_milli_ratio(req.threshold)
}

fn deferral_reason_code_from_name_value(name: Name) -> i64 with Panic, Div {
    if name_matches_str22(name,
        83, 116, 114, 117, 99, 116, 117, 114, 97, 108, 68, 105, 115, 97, 103, 114, 101, 101, 109, 101, 110, 116) {
        return DEFERRAL_REASON_STRUCTURAL_DISAGREEMENT
    }
    if name_matches_str19(name,
        77, 101, 99, 104, 97, 110, 105, 115, 116, 105, 99, 67, 111, 110, 102, 108, 105, 99, 116) {
        return DEFERRAL_REASON_MECHANISTIC_CONFLICT
    }
    if name_matches_str20(name,
        67, 111, 117, 110, 116, 101, 114, 101, 120, 97, 109, 112, 108, 101, 72, 97, 122, 97, 114, 100) {
        return DEFERRAL_REASON_COUNTEREXAMPLE_HAZARD
    }
    if name_matches_str8(name, 84, 97, 105, 108, 82, 105, 115, 107) {
        return DEFERRAL_REASON_TAIL_RISK
    }
    if name_matches_str18(name,
        73, 100, 101, 110, 116, 105, 102, 105, 97, 98, 105, 108, 105, 116, 121, 71, 97, 112) {
        return DEFERRAL_REASON_IDENTIFIABILITY_GAP
    }
    if name_matches_str12(name, 84, 114, 97, 110, 115, 112, 111, 114, 116, 71, 97, 112) {
        return DEFERRAL_REASON_TRANSPORT_GAP
    }
    if name_matches_str16(name,
        80, 111, 108, 105, 99, 121, 73, 110, 99, 111, 109, 112, 108, 101, 116, 101) {
        return DEFERRAL_REASON_POLICY_INCOMPLETE
    }
    -1
}

fn print_contest_model_family(info: ContestInfo) with IO, Mut, Panic, Div {
    print("[")
    var i: i64 = 0
    while i < info.model_count && i < 16 {
        if i > 0 { print(", ") }
        print_name_value(info.model_names[i as usize])
        i = i + 1
    }
    print("]")
}

// ============================================================
// Error reporting with diagnostics
// ============================================================

impl Checker {
    fn report_error(self) -> Checker with Mut {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        c
    }

    fn report_error_at(self, span: Span, code: i64, msg_a: i64, msg_b: i64, msg_c: i64) -> Checker with Mut, IO, Panic, Div {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E")
        if code < 100 { print("0") }
        if code < 10 { print("0") }
        print_int(code)
        print("]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": ")
        print_error_message(code)
        print("\n")
        // Print help and note if available
        print_error_help(code)
        print_error_note(code)
        c
    }

    fn report_unknown_policy_metric(self, span: Span, metric_name: Name) -> Checker with Mut, IO, Panic, Div {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E065]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": unknown contest diagnostic in policy declaration\n")
        print("   |\n   = metric ")
        print_name_value(metric_name)
        print(" is not supported by the current Contest robustness MVP\n")
        print("   = help: use one of sign_consensus, relative_band, max_tail_risk, mechanistic_divergence, identifiability_floor\n")
        c
    }

    fn report_policy_requires_named_definition(self, span: Span) -> Checker with Mut, IO, Panic, Div {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E066]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": prove_robust(...) requires a declared policy item\n")
        print("   |\n   = help: declare a named policy such as `policy DoseRobustnessPolicy for Dose { ... }`\n")
        print("   = note: plain Policy<T> annotations do not carry auditable robustness obligations\n")
        c
    }

    fn report_missing_contest_diagnostic(self, span: Span, policy_name: Name, req: PolicyRequirementInfo, contest_id: i64) -> Checker with Mut, IO, Panic, Div {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E072]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": cannot prove robustness because required contest diagnostics are unavailable\n")
        print("   |\n   = policy ")
        print_name_value(policy_name)
        print(" requires ")
        print_contest_metric_name(req.metric_id)
        print(" ")
        print_compare_op_value(req.op)
        print(" ")
        print_milli_ratio(req.threshold)
        print("\n")
        if contest_id >= 0 && contest_id < self.contests.count {
            let contest_info = self.contests.get(contest_id)
            if contest_info.model_count > 0 {
                print("   = model family ")
                print_contest_model_family(contest_info)
                print("\n")
            }
        }
        print("   = help: attach explicit contest diagnostics before calling prove_robust, or use an empty policy block for a vacuous fence\n")
        print("   = note: the current parser/checker slice preserves disagreement structure but does not infer diagnostic metrics from raw contest terms\n")
        c
    }

    fn report_failed_policy_requirement(self, span: Span, policy_name: Name, req: PolicyRequirementInfo, observed: f64, contest_id: i64) -> Checker with Mut, IO, Panic, Div {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E073]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": robustness policy obligation failed\n")
        print("   |\n   = policy ")
        print_name_value(policy_name)
        print(" requires ")
        print_contest_metric_name(req.metric_id)
        print(" ")
        print_compare_op_value(req.op)
        print(" ")
        print_milli_ratio(req.threshold)
        print("\n   = observed ")
        print_contest_metric_name(req.metric_id)
        print(" = ")
        print_milli_ratio(observed)
        print("\n")
        if contest_id >= 0 && contest_id < self.contests.count {
            let contest_info = self.contests.get(contest_id)
            if contest_info.model_count > 0 {
                print("   = model family ")
                print_contest_model_family(contest_info)
                print("\n")
            }
        }
        print("   = help: narrow the admissible model family with explicit justification, or strengthen the policy diagnostics before promotion\n")
        c
    }

    fn report_missing_model_family_metadata(self, span: Span) -> Checker with Mut, IO, Panic, Div {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E069]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": Contest<T, Family, Policy> requires a declared models family\n")
        print("   |\n   = help: declare `models Name = [M1, M2, ...]` and reference that family in Contest<...>\n")
        print("   = note: shorthand Contest<T> remains parser-compatible, but it cannot discharge robustness obligations\n")
        c
    }

    fn report_model_family_mismatch(self, span: Span, family: ModelFamilyInfo, contest_info: ContestInfo) -> Checker with Mut, IO, Panic, Div {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E070]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": contest model list does not match the declared family\n")
        print("   |\n   = declared family ")
        print_name_value(family.name)
        print(" = [")
        var i: i64 = 0
        while i < family.model_count && i < 16 {
            if i > 0 { print(", ") }
            print_name_value(family.model_names[i as usize])
            i = i + 1
        }
        print("]\n   = found contest [")
        i = 0
        while i < contest_info.model_count && i < 16 {
            if i > 0 { print(", ") }
            print_name_value(contest_info.model_names[i as usize])
            i = i + 1
        }
        print("]\n")
        print("   = help: keep the inline contest list identical to the named family in both membership and order\n")
        c
    }

    fn report_model_type_incompatibility(self, span: Span, model_name: Name, got: TypeEntry) -> Checker with Mut, IO, Panic, Div, Alloc {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E071]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": model family members must be declared as Model<I, O>\n")
        print("   |\n   = member ")
        print_name_value(model_name)
        print(" has type ")
        print_type_name(got)
        print("\n   = help: declare the model alias as `type ")
        print_name_value(model_name)
        print(" = Model<Input, Output>` before using it in a models family\n")
        c
    }

    fn report_model_family_member_mismatch(
        self,
        span: Span,
        model_name: Name,
        expected_input: TypeEntry,
        expected_output: TypeEntry,
        got_input: TypeEntry,
        got_output: TypeEntry
    ) -> Checker with Mut, IO, Panic, Div, Alloc {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E071]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": model family members must share the same Model<I, O> signature\n")
        print("   |\n   = member ")
        print_name_value(model_name)
        print(" has Model<")
        print_type_name(got_input)
        print(", ")
        print_type_name(got_output)
        print(">\n   = expected Model<")
        print_type_name(expected_input)
        print(", ")
        print_type_name(expected_output)
        print(">\n")
        c
    }

    fn report_missing_validation_policy(self, span: Span) -> Checker with Mut, IO, Panic, Div {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E074]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
            print_int(span.start)
            print("..")
            print_int(span.end)
        }
        print(": validate_manifest(...) requires an explicit validation item\n")
        print("   |\n   = help: declare `validation Name for T {}` and call validate_manifest(robust_value, Name)\n")
        print("   = note: Robust<T> does not silently become Validated<T>\n")
        c
    }

    fn report_validation_target_mismatch(self, span: Span, expected: TypeEntry, got: TypeEntry) -> Checker with Mut, IO, Panic, Div, Alloc {
        var c = self
        c.error_count = c.error_count + 1
        c.had_error = true
        print("error[E075]")
        if span.start > 0 || span.end > 0 {
            print(" at ")
