fn kb_relative_band_name() -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 13 }
    n.buf[0] = 114   // r
    n.buf[1] = 101   // e
    n.buf[2] = 108   // l
    n.buf[3] = 97    // a
    n.buf[4] = 116   // t
    n.buf[5] = 105   // i
    n.buf[6] = 118   // v
    n.buf[7] = 101   // e
    n.buf[8] = 95    // _
    n.buf[9] = 98    // b
    n.buf[10] = 97   // a
    n.buf[11] = 110  // n
    n.buf[12] = 100  // d
    n
}

fn kb_seed_empty_policy(checker: Checker, name: Name) -> Checker with Mut, Panic, Div, Alloc {
    var c = checker
    let info = PolicyInfo {
        name: name,
        target_ty: ty_i64(),
        level_name: kb_make_name(0, 0, 0, 0),
        scope_name: kb_make_name(0, 0, 0, 0),
        level_id: ROBUST_LEVEL_STABLE,
        scope_id: ROBUST_SCOPE_IN_DISTRIBUTION,
        requirements: None,
        requirement_count: 0,
    }
    let add_result = c.policies.add(info)
    c.policies = add_result.0
    c.env = c.env.bind(name, ty_policy(ty_i64(), add_result.1), false)
    c
}

fn kb_seed_relative_band_policy(checker: Checker, name: Name, op: CompareOp, threshold: f64) -> Checker with Mut, Panic, Div, Alloc {
    var c = checker
    let req = PolicyRequirementInfo {
        metric_id: CONTEST_METRIC_RELATIVE_BAND,
        metric_name: kb_relative_band_name(),
        op: op,
        threshold: threshold,
    }
    let info = PolicyInfo {
        name: name,
        target_ty: ty_i64(),
        level_name: kb_make_name(0, 0, 0, 0),
        scope_name: kb_make_name(0, 0, 0, 0),
        level_id: ROBUST_LEVEL_STABLE,
        scope_id: ROBUST_SCOPE_IN_DISTRIBUTION,
        requirements: Some(Box::new(PolicyRequirementInfoList { head: req, tail: None })),
        requirement_count: 1,
    }
    let add_result = c.policies.add(info)
    c.policies = add_result.0
    c.env = c.env.bind(name, ty_policy(ty_i64(), add_result.1), false)
    c
}

fn kb_seed_relative_band_decision_policy(checker: Checker, name: Name, op: CompareOp, threshold: f64) -> Checker with Mut, Panic, Div, Alloc {
    var c = checker
    let req = PolicyRequirementInfo {
        metric_id: CONTEST_METRIC_RELATIVE_BAND,
        metric_name: kb_relative_band_name(),
        op: op,
        threshold: threshold,
    }
    let info = DecisionPolicyInfo {
        name: name,
        target_ty: ty_i64(),
        requirements: Some(Box::new(PolicyRequirementInfoList { head: req, tail: None })),
