{
  "name": "sounio-dev",
  "build": {
    "dockerfile": "../Dockerfile.dev",
    "context": "..",
    "args": {
      "USERNAME": "vscode",
      "USER_UID": "1000",
      "USER_GID": "1000"
    }
  },
  "workspaceFolder": "/workspace",
  "remoteUser": "vscode",
  "containerEnv": {
    "SOUNIO_STDLIB_PATH": "/workspace/stdlib",
    "SOUC_BIN": "/workspace/bin/souc"
  },
  "mounts": [
    "source=sounio-cargo,target=/home/vscode/.cargo,type=volume",
    "source=sounio-rustup,target=/home/vscode/.rustup,type=volume"
  ],
  "postCreateCommand": "bash scripts/bootstrap_workspace.sh",
  "postStartCommand": "bash scripts/doctor_workspace.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "ms-vscode.cpptools",
        "tamasfe.even-better-toml",
        "ms-python.python",
        "mkhl.shfmt"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.watcherExclude": {
          "**/artifacts/**": true,
          "**/target/**": true
        }
      }
    }
  }
}
