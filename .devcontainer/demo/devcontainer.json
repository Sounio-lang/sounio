{
  "name": "sounio-demo",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  "containerEnv": {
    "SOUNIO_STDLIB_PATH": "${containerWorkspaceFolder}/stdlib"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:HOME}/.elan/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash scripts/demo_env_setup.sh",
  "customizations": {
    "codespaces": { "openFiles": ["TOUR.md"] },
    "vscode": {
      "settings": { "terminal.integrated.defaultProfile.linux": "bash" }
    }
  }
}
