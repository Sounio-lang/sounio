struct T { a: [u8; 4], b: [u8; 4] }
fn z() -> T { T { a: [0; 4], b: [0; 4] } }
fn main() with IO {
    var arr: [T; 2] = [ z(), z() ]
    var c: i32 = 0
    var ba: [u8; 4] = [0; 4]
    ba[0] = 0x11
    var bb: [u8; 4] = [0; 4]
    bb[0] = 0x22
    arr[c as usize].a = ba
    arr[c as usize].b = bb
    println(arr[0].a[0] as i64)
    println(arr[0].b[0] as i64)
}
