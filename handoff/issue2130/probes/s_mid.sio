struct T { a: [u8; 20], s: i32, b: [u8; 512] }
fn z() -> T { T { a: [0; 20], s: 0, b: [0; 512] } }
fn main() with IO {
    var arr: [T; 2] = [ z(), z() ]
    var ba: [u8; 20] = [0; 20]
    ba[0] = 0x55
    var bb: [u8; 512] = [0; 512]
    bb[0] = 0xAA
    arr[0].a = ba

    arr[0].b = bb
    println(arr[0].a[0] as i64)
    println(arr[0].b[0] as i64)
}
