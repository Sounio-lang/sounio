struct ExtL { oid: [u8; 20], oid_len: i32, critical: bool, value: [u8; 512], value_len: i32 }
fn zero_ext() -> ExtL { ExtL { oid: [0; 20], oid_len: 0, critical: false, value: [0; 512], value_len: 0 } }
fn main() with IO {
    var extensions: [ExtL; 8] = [ zero_ext(), zero_ext(), zero_ext(), zero_ext(), zero_ext(), zero_ext(), zero_ext(), zero_ext() ]
    var oid_buf: [u8; 20] = [0; 20]
    oid_buf[0] = 0x55
    oid_buf[1] = 0x1D
    var val_buf: [u8; 512] = [0; 512]
    val_buf[0] = 0xAA
    val_buf[1] = 0xBB
    println(oid_buf[0] as i64)
    println(oid_buf[1] as i64)
    println(extensions[0].oid_len as i64)
}
