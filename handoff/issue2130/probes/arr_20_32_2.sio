struct T { a: [u8; 20], b: [u8; 32] }
fn zt() -> T { T { a: [0; 20], b: [0; 32] } }
fn main() with IO {
    var arr: [T; 2] = [zt(), zt(), ]
    var ba: [u8; 20] = [0; 20]
    ba[0] = 0x55
    var bb: [u8; 32] = [0; 32]
    bb[0] = 0xAA
    arr[0].a = ba
    arr[0].b = bb
    println(arr[0].a[0] as i64)
    println(arr[0].b[0] as i64)
}
