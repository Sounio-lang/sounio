// As três structs reais de stdlib/x509/cert.sio que carregam um campo `value`,
// copiadas verbatim, exercitadas pelo padrão que bloqueava a Task 6:
// escrita campo-a-campo direto no elemento do array.
// Sai 0 se todos os campos leem os próprios bytes; senão o número do caso.

pub struct RdnEntry { oid: [u8; 20], oid_len: i32, value_tag: i32, value: [u8; 128], value_len: i32 }
pub struct X509Name { entries: [RdnEntry; 16], count: i32 }
pub struct GeneralName { tag: i32, value: [u8; 253], value_len: i32, oid: [u8; 20], oid_len: i32, directory_name: X509Name }
pub struct ExtensionEntry { oid: [u8; 20], oid_len: i32, critical: bool, value: [u8; 512], value_len: i32 }

fn zero_rdn() -> RdnEntry { RdnEntry { oid: [0; 20], oid_len: 0, value_tag: 0, value: [0; 128], value_len: 0 } }
fn zero_name() -> X509Name { X509Name { entries: [zero_rdn(); 16], count: 0 } }
fn zero_gn() -> GeneralName { GeneralName { tag: 0, value: [0; 253], value_len: 0, oid: [0; 20], oid_len: 0, directory_name: zero_name() } }
fn zero_ext() -> ExtensionEntry { ExtensionEntry { oid: [0; 20], oid_len: 0, critical: false, value: [0; 512], value_len: 0 } }

fn main() -> i64 with IO, Mut, Panic, Div {
    var oid_buf: [u8; 20] = [0; 20]
    oid_buf[0] = 0x55
    oid_buf[1] = 0x1D

    // --- ExtensionEntry: x509_parse_extensions ---
    var exts: [ExtensionEntry; 32] = [zero_ext(); 32]
    var ev: [u8; 512] = [0; 512]
    ev[0] = 0xAA
    ev[511] = 0xCC
    var i: i64 = 0
    exts[i as usize].oid = oid_buf
    exts[i as usize].oid_len = 2
    exts[i as usize].critical = true
    exts[i as usize].value = ev
    exts[i as usize].value_len = 512
    if exts[0].oid[0] as i64 != 85 { return 1 }
    if exts[0].oid[1] as i64 != 29 { return 1 }
    if exts[0].value[0] as i64 != 170 { return 1 }
    if exts[0].value[511] as i64 != 204 { return 1 }
    if exts[0].oid_len as i64 != 2 { return 1 }
    if exts[0].value_len as i64 != 512 { return 1 }

    // --- GeneralName: x509_parse_general_names. Aqui `value` colidia com `tag`. ---
    var gns: [GeneralName; 32] = [zero_gn(); 32]
    var gv: [u8; 253] = [0; 253]
    gv[0] = 0xBB
    gv[252] = 0xDD
    gns[i as usize].tag = 2
    gns[i as usize].value = gv
    gns[i as usize].value_len = 253
    gns[i as usize].oid = oid_buf
    gns[i as usize].oid_len = 2
    if gns[0].tag as i64 != 2 { return 2 }
    if gns[0].value[0] as i64 != 187 { return 2 }
    if gns[0].value[252] as i64 != 221 { return 2 }
    if gns[0].oid[0] as i64 != 85 { return 2 }
    if gns[0].value_len as i64 != 253 { return 2 }

    // --- RdnEntry: x509_parse_name (Task 5, já entregue) ---
    var rdns: [RdnEntry; 16] = [zero_rdn(); 16]
    var rv: [u8; 128] = [0; 128]
    rv[0] = 0xEE
    rdns[i as usize].oid = oid_buf
    rdns[i as usize].oid_len = 2
    rdns[i as usize].value_tag = 12
    rdns[i as usize].value = rv
    rdns[i as usize].value_len = 1
    if rdns[0].oid[0] as i64 != 85 { return 3 }
    if rdns[0].value[0] as i64 != 238 { return 3 }
    if rdns[0].value_tag as i64 != 12 { return 3 }
    if rdns[0].value_len as i64 != 1 { return 3 }

    return 0
}
