struct T { oid: [u8; 20], value: [u8; 512] }
fn z() -> T { T { oid: [0; 20], value: [0; 512] } }
fn main() with IO {
    var arr: [T; 8] = [ z(), z(), z(), z(), z(), z(), z(), z() ]
    var ba: [u8; 20] = [0; 20]
    ba[0] = 0x55
    ba[1] = 0x1D
    var bb: [u8; 512] = [0; 512]
    bb[0] = 0xAA
    bb[1] = 0xBB
    bb[511] = 0xCC
    arr[0].oid = ba
    arr[0].value = bb
    println(arr[0].oid[0] as i64)
    println(arr[0].value[0] as i64)
    println(arr[0].value[1] as i64)
    println(arr[0].oid[1] as i64)
    println(arr[0].value[511] as i64)
}
