// Isola qual campo do GeneralName ainda erra. Cada checagem tem seu código.
pub struct RdnEntry { oid: [u8; 20], oid_len: i32, value_tag: i32, value: [u8; 128], value_len: i32 }
pub struct X509Name { entries: [RdnEntry; 16], count: i32 }
pub struct GeneralName { tag: i32, value: [u8; 253], value_len: i32, oid: [u8; 20], oid_len: i32, directory_name: X509Name }
// mesma struct SEM o aninhado, para separar "nome" de "agregado aninhado"
pub struct GnFlat { tag: i32, value: [u8; 253], value_len: i32, oid: [u8; 20], oid_len: i32 }

fn zero_rdn() -> RdnEntry { RdnEntry { oid: [0; 20], oid_len: 0, value_tag: 0, value: [0; 128], value_len: 0 } }
fn zero_name() -> X509Name { X509Name { entries: [zero_rdn(); 16], count: 0 } }
fn zero_gn() -> GeneralName { GeneralName { tag: 0, value: [0; 253], value_len: 0, oid: [0; 20], oid_len: 0, directory_name: zero_name() } }
fn zero_flat() -> GnFlat { GnFlat { tag: 0, value: [0; 253], value_len: 0, oid: [0; 20], oid_len: 0 } }

fn main() -> i64 with IO, Mut, Panic, Div {
    var oid_buf: [u8; 20] = [0; 20]
    oid_buf[0] = 0x55
    var gv: [u8; 253] = [0; 253]
    gv[0] = 0xBB
    gv[252] = 0xDD
    var i: i64 = 0

    var gns: [GeneralName; 32] = [zero_gn(); 32]
    gns[i as usize].tag = 2
    gns[i as usize].value = gv
    gns[i as usize].value_len = 253
    gns[i as usize].oid = oid_buf
    gns[i as usize].oid_len = 2
    print("gn  tag="); print_int(gns[0].tag as i64)
    print(" v0=");     print_int(gns[0].value[0] as i64)
    print(" v252=");   print_int(gns[0].value[252] as i64)
    print(" oid0=");   print_int(gns[0].oid[0] as i64)
    print(" vlen=");   print_int(gns[0].value_len as i64)
    print(" oidlen="); print_int(gns[0].oid_len as i64)
    println("")

    var fl: [GnFlat; 32] = [zero_flat(); 32]
    fl[i as usize].tag = 2
    fl[i as usize].value = gv
    fl[i as usize].value_len = 253
    fl[i as usize].oid = oid_buf
    fl[i as usize].oid_len = 2
    print("flat tag="); print_int(fl[0].tag as i64)
    print(" v0=");      print_int(fl[0].value[0] as i64)
    print(" v252=");    print_int(fl[0].value[252] as i64)
    print(" oid0=");    print_int(fl[0].oid[0] as i64)
    print(" vlen=");    print_int(fl[0].value_len as i64)
    print(" oidlen=");  print_int(fl[0].oid_len as i64)
    println("")
    println("esperado nos dois: tag=2 v0=187 v252=221 oid0=85 vlen=253 oidlen=2")
    return 0
}
