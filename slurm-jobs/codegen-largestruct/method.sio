//@ run-pass
// Mirror intern_string EXACTLY: method `fn bump(self) -> (Holder,i64)` with
// `var lo = self; (*lo.inner).counter = v` and tuple return.
struct Small { tag: i64, counter: i64 }
struct Holder { inner: Box<Small> }

impl Holder {
    fn bump(self) -> (Holder, i64) with Mut, Panic {
        var lo = self
        (*lo.inner).counter = 42
        let r = (*lo.inner).counter
        (lo, r)
    }
}

fn main() with Mut, Panic, Alloc {
    let h = Holder { inner: Box::new(Small { tag: 1, counter: 0 }) }
    let pair = h.bump()
    print_int(pair.1)              // expect 42 (the in-method read)
    print_int((*pair.0.inner).counter)  // expect 42 (mutation survived the return)
}
