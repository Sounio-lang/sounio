//@ run-pass
// Discriminator: does (*lo.boxfield).f=v miscompile depend on whether the HOLDER
// is small (register-passed) vs large (hidden-pointer / SRET-passed)?
struct Small { tag: i64, counter: i64 }

// Small holder (16B, register-passed) — my original repro
struct HolderS { inner: Box<Small> }
// Large holder (>16B + big array, hidden-pointer-passed like Lowerer)
struct HolderL { pad: [i64; 64], inner: Box<Small>, tail: i64 }

fn mk_s() -> HolderS with Alloc { HolderS { inner: Box::new(Small { tag: 1, counter: 0 }) } }
fn mk_l() -> HolderL with Alloc { HolderL { pad: [0; 64], inner: Box::new(Small { tag: 1, counter: 0 }), tail: 9 } }

fn store_s(h: HolderS) -> i64 with Mut, Panic {
    var lo = h
    (*lo.inner).counter = 42
    (*lo.inner).counter
}
fn store_l(h: HolderL) -> i64 with Mut, Panic {
    var lo = h
    (*lo.inner).counter = 42
    (*lo.inner).counter
}
fn main() with Mut, Panic, Alloc {
    print_int(store_s(mk_s()))   // small holder
    print_int(store_l(mk_l()))   // large holder  (Lowerer-like)
}
