//@ run-pass
// c634b38f repro v2 — struct sized to ~210KB like NativeCompiler.
// Scalar fields tag/tail straddle ~26k i64 of inline arrays.

struct HugeStruct {
    tag: i64,
    a: [i64; 4096],
    b: [i64; 4096],
    c: [i64; 4096],
    d: [i64; 4096],
    e: [i64; 2048],
    pad0: [i64; 512],
    pad1: [i64; 512],
    pad2: [i64; 512],
    tail: i64,
}

fn make_huge(t: i64, tl: i64) -> HugeStruct with Mut, Panic {
    var h = HugeStruct {
        tag: t, a: [0; 4096], b: [0; 4096], c: [0; 4096], d: [0; 4096],
        e: [0; 2048], pad0: [0; 512], pad1: [0; 512], pad2: [0; 512], tail: tl
    }
    h.a[0] = 100
    h.d[4095] = 200
    return h
}

fn read_tag(h: HugeStruct) -> i64 { h.tag }
fn read_tail(h: HugeStruct) -> i64 { h.tail }
fn read_a0(h: HugeStruct) -> i64 with Panic { h.a[0] }
fn read_d_last(h: HugeStruct) -> i64 with Panic { h.d[4095] }

fn main() with Mut, Panic {
    let h = make_huge(11, 99)
    print_int(read_tag(h))       // expect 11
    print_int(read_tail(h))      // expect 99
    print_int(read_a0(h))        // expect 100
    print_int(read_d_last(h))    // expect 200
}
