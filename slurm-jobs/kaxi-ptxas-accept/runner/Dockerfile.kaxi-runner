# Self-hosted GitHub Actions runner image for the K-AXI PTX acceptance gate.
# Adds the tools the gate needs on top of a standalone runner base:
#   - kubectl        (exec into the slurm-pilot login pod)
#   - build-essential (gcc -ldl -lm to build scripts/gpu/kaxi_ptx_runner.c)
#   - git/curl/tar    (checkout, pinned-souc download, payload staging)
#
# Build & push:
#   docker build -f slurm-jobs/kaxi-ptxas-accept/runner/Dockerfile.kaxi-runner \
#     -t <your-registry>/kaxi-ci-runner:1 .
#   docker push <your-registry>/kaxi-ci-runner:1
#
# Then reference that tag in runner/kaxi-ci-runner.yaml.
FROM myoung34/github-runner:latest

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        tar \
        gzip \
    && curl -fsSLo /usr/local/bin/kubectl \
        "https://dl.k8s.io/release/$(curl -fsSL https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" \
    && chmod +x /usr/local/bin/kubectl \
    && kubectl version --client \
    && rm -rf /var/lib/apt/lists/*
