// Standalone GPU kernel-lowering test
// Tests the new IR-driven PTX generation

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    print("=== GPU Kernel-Lowering Test ===\n\n")

    // Build vec_add kernel IR
    print("1. Building vec_add kernel IR...\n")
    let ir = gpu_build_vec_add_ir()
    print("   ✓ IR built (")
    print_int(ir.op_count)
    print(" operations)\n\n")

    // Lower to PTX
    print("2. Lowering IR → PTX...\n")
    let ptx = gpu_lower_to_ptx(ir)
    print("   ✓ PTX generated (")
    print_int(ptx.len)
    print(" bytes)\n\n")

    // Convert to string
    print("3. PTX output:\n")
    print("----------------------------------------\n")
    let s = ptx_to_string(ptx)
    print(s)
    print("----------------------------------------\n\n")

    // Validation
    print("4. Validation:\n")
    var passed: i64 = 0
    var total: i64 = 0

    total = total + 1
    if starts_with(s, ".version") {
        print("   ✓ Has .version header\n")
        passed = passed + 1
    } else {
        print("   ✗ Missing .version header\n")
    }

    total = total + 1
    if ptx_str_contains(s, ".entry vec_add") {
        print("   ✓ Has .entry vec_add\n")
        passed = passed + 1
    } else {
        print("   ✗ Missing .entry vec_add\n")
    }

    total = total + 1
    if ptx_str_contains(s, "%tid.x") {
        print("   ✓ Has %tid.x\n")
        passed = passed + 1
    } else {
        print("   ✗ Missing %tid.x\n")
    }

    total = total + 1
    if ptx_str_contains(s, "ld.global") {
        print("   ✓ Has ld.global\n")
        passed = passed + 1
    } else {
        print("   ✗ Missing ld.global\n")
    }

    total = total + 1
    if ptx_str_contains(s, "st.global") {
        print("   ✓ Has st.global\n")
        passed = passed + 1
    } else {
        print("   ✗ Missing st.global\n")
    }

    print("\nResult: ")
    print_int(passed)
    print("/")
    print_int(total)
    print(" checks passed\n")

    if passed == total {
        print("\n✅ GPU kernel-lowering PASSED!\n")
        0
    } else {
        print("\n❌ GPU kernel-lowering FAILED!\n")
        1
    }
}
