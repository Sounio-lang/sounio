module main

use pbpk::rapamycin_expected_margin::{
    em_inh_contribution_n7,  em_slow_contribution_n7,  em_std_contribution_n7,
    em_fast_contribution_n7, em_ind_contribution_n7,
    em_inh_contribution_n14, em_slow_contribution_n14, em_std_contribution_n14,
    em_fast_contribution_n14,em_ind_contribution_n14,
    em_inh_contribution_n28, em_slow_contribution_n28, em_std_contribution_n28,
    em_fast_contribution_n28,em_ind_contribution_n28,
    em_expected_margin_n7, em_expected_margin_n14, em_expected_margin_n28,
    em_gain_n7_to_n14, em_gain_n14_to_n28, em_gain_n7_to_n28
}

fn main() with Mut, Div, Panic, IO {
    print("=== Per-stratum weighted contributions ===\n")
    print("N=7  inh:  "); print_f64(em_inh_contribution_n7());  print("\n")
    print("N=7  slow: "); print_f64(em_slow_contribution_n7()); print("\n")
    print("N=7  std:  "); print_f64(em_std_contribution_n7());  print("\n")
    print("N=7  fast: "); print_f64(em_fast_contribution_n7()); print("\n")
    print("N=7  ind:  "); print_f64(em_ind_contribution_n7());  print("\n")
    print("\n")
    print("N=14 inh:  "); print_f64(em_inh_contribution_n14());  print("\n")
    print("N=14 slow: "); print_f64(em_slow_contribution_n14()); print("\n")
    print("N=14 std:  "); print_f64(em_std_contribution_n14());  print("\n")
    print("N=14 fast: "); print_f64(em_fast_contribution_n14()); print("\n")
    print("N=14 ind:  "); print_f64(em_ind_contribution_n14());  print("\n")
    print("\n")
    print("N=28 inh:  "); print_f64(em_inh_contribution_n28());  print("\n")
    print("N=28 slow: "); print_f64(em_slow_contribution_n28()); print("\n")
    print("N=28 std:  "); print_f64(em_std_contribution_n28());  print("\n")
    print("N=28 fast: "); print_f64(em_fast_contribution_n28()); print("\n")
    print("N=28 ind:  "); print_f64(em_ind_contribution_n28());  print("\n")
    print("\n")
    print("=== Population-weighted expected margin ===\n")
    print("E[margin_7]:  "); print_f64(em_expected_margin_n7());  print("\n")
    print("E[margin_14]: "); print_f64(em_expected_margin_n14()); print("\n")
    print("E[margin_28]: "); print_f64(em_expected_margin_n28()); print("\n")
    print("\n")
    print("=== Convergence ===\n")
    print("gain N7→14:  "); print_f64(em_gain_n7_to_n14());  print("\n")
    print("gain N14→28: "); print_f64(em_gain_n14_to_n28()); print("\n")
    print("gain N7→28:  "); print_f64(em_gain_n7_to_n28());  print("\n")
}
