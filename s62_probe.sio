module main

use pbpk::rapamycin_uc_budget::{
    ucb_uc_ke_n7, ucb_uc_ke_n14, ucb_uc_ke_n28,
    ucb_uc_f_n7,  ucb_uc_f_n14,  ucb_uc_f_n28,
    ucb_uc_ka_n7, ucb_uc_k12_n7, ucb_uc_k21_n7,
    ucb_frac_ke_n7,  ucb_frac_ke_n14,  ucb_frac_ke_n28,
    ucb_frac_f_n7,   ucb_frac_f_n14,   ucb_frac_f_n28,
    ucb_frac_ka_n7,  ucb_frac_k12_n7,  ucb_frac_k21_n7,
    ucb_frac_ka_n28, ucb_frac_k12_n28, ucb_frac_k21_n28,
    ucb_sum_fracs_n7, ucb_sum_fracs_n28,
    ucb_ke_dominance_gain
}

fn main() with Mut, Div, Panic, IO {
    print("=== Absolute u_c contributions (mg/L) ===\n")
    print("ke  N=7:  "); print_f64(ucb_uc_ke_n7());  print("\n")
    print("ke  N=14: "); print_f64(ucb_uc_ke_n14()); print("\n")
    print("ke  N=28: "); print_f64(ucb_uc_ke_n28()); print("\n")
    print("F   N=7:  "); print_f64(ucb_uc_f_n7());   print("\n")
    print("F   N=14: "); print_f64(ucb_uc_f_n14());  print("\n")
    print("F   N=28: "); print_f64(ucb_uc_f_n28());  print("\n")
    print("ka  N=7:  "); print_f64(ucb_uc_ka_n7());  print("\n")
    print("k12 N=7:  "); print_f64(ucb_uc_k12_n7()); print("\n")
    print("k21 N=7:  "); print_f64(ucb_uc_k21_n7()); print("\n")
    print("\n")
    print("=== Fractional contributions at N=7 ===\n")
    print("ke:  "); print_f64(ucb_frac_ke_n7());  print("\n")
    print("F:   "); print_f64(ucb_frac_f_n7());   print("\n")
    print("ka:  "); print_f64(ucb_frac_ka_n7());  print("\n")
    print("k12: "); print_f64(ucb_frac_k12_n7()); print("\n")
    print("k21: "); print_f64(ucb_frac_k21_n7()); print("\n")
    print("sum: "); print_f64(ucb_sum_fracs_n7()); print("\n")
    print("\n")
    print("=== Fractional contributions at N=14 ===\n")
    print("ke:  "); print_f64(ucb_frac_ke_n14());  print("\n")
    print("F:   "); print_f64(ucb_frac_f_n14());   print("\n")
    print("\n")
    print("=== Fractional contributions at N=28 ===\n")
    print("ke:  "); print_f64(ucb_frac_ke_n28());  print("\n")
    print("F:   "); print_f64(ucb_frac_f_n28());   print("\n")
    print("ka:  "); print_f64(ucb_frac_ka_n28());  print("\n")
    print("k12: "); print_f64(ucb_frac_k12_n28()); print("\n")
    print("k21: "); print_f64(ucb_frac_k21_n28()); print("\n")
    print("sum: "); print_f64(ucb_sum_fracs_n28()); print("\n")
    print("\n")
    print("ke dominance gain N7→N28: "); print_f64(ucb_ke_dominance_gain()); print("\n")
}
