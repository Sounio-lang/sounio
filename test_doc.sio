//! Test module for documentation generation
//!
//! This module demonstrates the documentation system.

/// Add two numbers together
///
/// # Parameters
///
/// - `a`: First number
/// - `b`: Second number
///
/// # Returns
///
/// The sum of a and b
///
/// # Examples
///
/// ```sio
/// let result = add(5, 3)
/// // result = 8
/// ```
pub fn add(a: i32, b: i32) -> i32 {
    a + b
}

/// Multiply two numbers
///
/// # Parameters
///
/// - `x`: First number
/// - `y`: Second number
///
/// # Returns
///
/// The product of x and y
pub fn multiply(x: i32, y: i32) -> i32 {
    x * y
}

/// A simple point structure
///
/// Represents a 2D point with x and y coordinates.
pub struct Point {
    x: f64,
    y: f64,
}
