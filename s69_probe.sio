module main

use pbpk::rapamycin_tdm_update::{
    tu_cv_lcms, tu_cv_immuno,
    tu_c_n7, tu_c_n14, tu_c_n28,
    tu_u_pk_n7, tu_u_pk_n14, tu_u_pk_n28,
    tu_u_lcms_n7, tu_u_lcms_n14, tu_u_lcms_n28,
    tu_u_immuno_n7, tu_u_immuno_n14, tu_u_immuno_n28,
    tu_u_post_lcms_n7, tu_u_post_lcms_n14, tu_u_post_lcms_n28,
    tu_u_post_immuno_n7, tu_u_post_immuno_n14, tu_u_post_immuno_n28,
    tu_gain_lcms_n7, tu_gain_lcms_n14, tu_gain_lcms_n28,
    tu_gain_immuno_n7, tu_gain_immuno_n14, tu_gain_immuno_n28,
    tu_margin_prior_n7, tu_margin_prior_n14, tu_margin_prior_n28,
    tu_margin_post_lcms_n7, tu_margin_post_lcms_n14, tu_margin_post_lcms_n28,
    tu_margin_post_immuno_n7, tu_margin_post_immuno_n14, tu_margin_post_immuno_n28,
    tu_margin_gain_lcms_n7, tu_margin_gain_lcms_n14, tu_margin_gain_lcms_n28,
    tu_margin_gain_immuno_n7, tu_margin_gain_immuno_n14, tu_margin_gain_immuno_n28,
    tu_lcms_immuno_gain_ratio_n7, tu_lcms_immuno_gain_ratio_n14
}

fn main() with Mut, Div, Panic, IO {
    print("=== Trough concentrations ===\n")
    print("C(N=7):  "); print_f64(tu_c_n7());  print("\n")
    print("C(N=14): "); print_f64(tu_c_n14()); print("\n")
    print("C(N=28): "); print_f64(tu_c_n28()); print("\n")

    print("\n=== Prior u_pk ===\n")
    print("u_pk(N=7):  "); print_f64(tu_u_pk_n7());  print("\n")
    print("u_pk(N=14): "); print_f64(tu_u_pk_n14()); print("\n")
    print("u_pk(N=28): "); print_f64(tu_u_pk_n28()); print("\n")

    print("\n=== Assay uncertainties ===\n")
    print("u_lcms(N=7):    "); print_f64(tu_u_lcms_n7());    print("\n")
    print("u_lcms(N=14):   "); print_f64(tu_u_lcms_n14());   print("\n")
    print("u_lcms(N=28):   "); print_f64(tu_u_lcms_n28());   print("\n")
    print("u_immuno(N=7):  "); print_f64(tu_u_immuno_n7());  print("\n")
    print("u_immuno(N=14): "); print_f64(tu_u_immuno_n14()); print("\n")
    print("u_immuno(N=28): "); print_f64(tu_u_immuno_n28()); print("\n")

    print("\n=== Posterior u after single measurement ===\n")
    print("u_post_lcms(N=7):    "); print_f64(tu_u_post_lcms_n7());    print("\n")
    print("u_post_lcms(N=14):   "); print_f64(tu_u_post_lcms_n14());   print("\n")
    print("u_post_lcms(N=28):   "); print_f64(tu_u_post_lcms_n28());   print("\n")
    print("u_post_immuno(N=7):  "); print_f64(tu_u_post_immuno_n7());  print("\n")
    print("u_post_immuno(N=14): "); print_f64(tu_u_post_immuno_n14()); print("\n")
    print("u_post_immuno(N=28): "); print_f64(tu_u_post_immuno_n28()); print("\n")

    print("\n=== Precision gain factors (u_prior / u_post) ===\n")
    print("gain_lcms(N=7):    "); print_f64(tu_gain_lcms_n7());    print("\n")
    print("gain_lcms(N=14):   "); print_f64(tu_gain_lcms_n14());   print("\n")
    print("gain_lcms(N=28):   "); print_f64(tu_gain_lcms_n28());   print("\n")
    print("gain_immuno(N=7):  "); print_f64(tu_gain_immuno_n7());  print("\n")
    print("gain_immuno(N=14): "); print_f64(tu_gain_immuno_n14()); print("\n")
    print("gain_immuno(N=28): "); print_f64(tu_gain_immuno_n28()); print("\n")
    print("LCMS/immuno ratio(N=7):  "); print_f64(tu_lcms_immuno_gain_ratio_n7());  print("\n")
    print("LCMS/immuno ratio(N=14): "); print_f64(tu_lcms_immuno_gain_ratio_n14()); print("\n")

    print("\n=== Prior margins ===\n")
    print("prior(N=7):  "); print_f64(tu_margin_prior_n7());  print("\n")
    print("prior(N=14): "); print_f64(tu_margin_prior_n14()); print("\n")
    print("prior(N=28): "); print_f64(tu_margin_prior_n28()); print("\n")

    print("\n=== Posterior margins after LCMS ===\n")
    print("post_lcms(N=7):  "); print_f64(tu_margin_post_lcms_n7());  print("\n")
    print("post_lcms(N=14): "); print_f64(tu_margin_post_lcms_n14()); print("\n")
    print("post_lcms(N=28): "); print_f64(tu_margin_post_lcms_n28()); print("\n")

    print("\n=== Posterior margins after immunoassay ===\n")
    print("post_immuno(N=7):  "); print_f64(tu_margin_post_immuno_n7());  print("\n")
    print("post_immuno(N=14): "); print_f64(tu_margin_post_immuno_n14()); print("\n")
    print("post_immuno(N=28): "); print_f64(tu_margin_post_immuno_n28()); print("\n")

    print("\n=== Margin gains (posterior - prior) ===\n")
    print("gain_lcms(N=7):    "); print_f64(tu_margin_gain_lcms_n7());    print("\n")
    print("gain_lcms(N=14):   "); print_f64(tu_margin_gain_lcms_n14());   print("\n")
    print("gain_lcms(N=28):   "); print_f64(tu_margin_gain_lcms_n28());   print("\n")
    print("gain_immuno(N=7):  "); print_f64(tu_margin_gain_immuno_n7());  print("\n")
    print("gain_immuno(N=14): "); print_f64(tu_margin_gain_immuno_n14()); print("\n")
    print("gain_immuno(N=28): "); print_f64(tu_margin_gain_immuno_n28()); print("\n")
}
