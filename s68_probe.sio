module main

use pbpk::rapamycin_ka_sensitivity::{
    ks_ka_var_l0, ks_ka_var_l1, ks_ka_var_l2, ks_ka_var_l3,
    ks_margin_l0_n1, ks_margin_l0_n7, ks_margin_l0_n14, ks_margin_l0_n28,
    ks_margin_l1_n1, ks_margin_l1_n7, ks_margin_l1_n14, ks_margin_l1_n28,
    ks_margin_l2_n1, ks_margin_l2_n7, ks_margin_l2_n28,
    ks_margin_l3_n1, ks_margin_l3_n7, ks_margin_l3_n14, ks_margin_l3_n28,
    ks_uc_l0_n7, ks_uc_l1_n7, ks_uc_l2_n7, ks_uc_l3_n7,
    ks_ncrit_l0, ks_ncrit_l1, ks_ncrit_l2, ks_ncrit_l3,
    ks_nlast_l0, ks_nlast_l1, ks_nlast_l2, ks_nlast_l3,
    ks_span_l0, ks_span_l1, ks_span_l2, ks_span_l3,
    ks_advance_l0_to_l1, ks_advance_l1_to_l2, ks_advance_l2_to_l3, ks_total_advance,
    ks_span_gain_l0_to_l1, ks_span_gain_l0_to_l3,
    ks_uc_ratio_l1_l0, ks_uc_ratio_l3_l0
}

fn pi(n: i64) with Mut, Div, Panic, IO {
    if n == 0 { print("0") }
    else {
        var digits = [0, 0, 0, 0, 0, 0, 0, 0]
        var num = n; var count = 0
        while num > 0 { digits[count] = num - (num / 10) * 10; num = num / 10; count = count + 1 }
        var idx = count - 1
        while idx >= 0 {
            if digits[idx] == 0 { print("0") } else if digits[idx] == 1 { print("1") }
            else if digits[idx] == 2 { print("2") } else if digits[idx] == 3 { print("3") }
            else if digits[idx] == 4 { print("4") } else if digits[idx] == 5 { print("5") }
            else if digits[idx] == 6 { print("6") } else if digits[idx] == 7 { print("7") }
            else if digits[idx] == 8 { print("8") } else { print("9") };
            idx = idx - 1
        }
    }
}

fn main() with Mut, Div, Panic, IO {
    print("=== ka_var levels ===\n")
    print("L0 (baseline): "); print_f64(ks_ka_var_l0()); print("\n")
    print("L1 (half):     "); print_f64(ks_ka_var_l1()); print("\n")
    print("L2 (quarter):  "); print_f64(ks_ka_var_l2()); print("\n")
    print("L3 (zero):     "); print_f64(ks_ka_var_l3()); print("\n")

    print("\n=== u_c at N=7 ===\n")
    print("L0: "); print_f64(ks_uc_l0_n7()); print("\n")
    print("L1: "); print_f64(ks_uc_l1_n7()); print("\n")
    print("L2: "); print_f64(ks_uc_l2_n7()); print("\n")
    print("L3: "); print_f64(ks_uc_l3_n7()); print("\n")
    print("ratio L1/L0: "); print_f64(ks_uc_ratio_l1_l0()); print("\n")
    print("ratio L3/L0: "); print_f64(ks_uc_ratio_l3_l0()); print("\n")

    print("\n=== Margins at N=7 ===\n")
    print("L0: "); print_f64(ks_margin_l0_n7()); print("\n")
    print("L1: "); print_f64(ks_margin_l1_n7()); print("\n")
    print("L2: "); print_f64(ks_margin_l2_n7()); print("\n")
    print("L3: "); print_f64(ks_margin_l3_n7()); print("\n")

    print("\n=== Margins at N=1 ===\n")
    print("L0: "); print_f64(ks_margin_l0_n1()); print("\n")
    print("L1: "); print_f64(ks_margin_l1_n1()); print("\n")
    print("L2: "); print_f64(ks_margin_l2_n1()); print("\n")
    print("L3: "); print_f64(ks_margin_l3_n1()); print("\n")

    print("\n=== Margins at N=14 ===\n")
    print("L0: "); print_f64(ks_margin_l0_n14()); print("\n")
    print("L1: "); print_f64(ks_margin_l1_n14()); print("\n")
    print("L3: "); print_f64(ks_margin_l3_n14()); print("\n")

    print("\n=== Certification windows ===\n")
    print("L0: ncrit="); pi(ks_ncrit_l0()); print(" nlast="); pi(ks_nlast_l0()); print(" span="); pi(ks_span_l0()); print("\n")
    print("L1: ncrit="); pi(ks_ncrit_l1()); print(" nlast="); pi(ks_nlast_l1()); print(" span="); pi(ks_span_l1()); print("\n")
    print("L2: ncrit="); pi(ks_ncrit_l2()); print(" nlast="); pi(ks_nlast_l2()); print(" span="); pi(ks_span_l2()); print("\n")
    print("L3: ncrit="); pi(ks_ncrit_l3()); print(" nlast="); pi(ks_nlast_l3()); print(" span="); pi(ks_span_l3()); print("\n")

    print("\n=== Marginal advances ===\n")
    print("L0→L1: "); pi(ks_advance_l0_to_l1()); print(" days\n")
    print("L1→L2: "); pi(ks_advance_l1_to_l2()); print(" days\n")
    print("L2→L3: "); pi(ks_advance_l2_to_l3()); print(" days\n")
    print("total: "); pi(ks_total_advance()); print(" days\n")
    print("span gain L0→L1: "); pi(ks_span_gain_l0_to_l1()); print("\n")
    print("span gain L0→L3: "); pi(ks_span_gain_l0_to_l3()); print("\n")
}
