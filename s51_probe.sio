module main

use pbpk::rapamycin_fast_dose_adjust::{
    fda_margin_n7_d50,  fda_margin_n7_d55,  fda_margin_n7_d60,
    fda_margin_n7_d65,  fda_margin_n7_d70,  fda_margin_n7_d75,
    fda_margin_n7_d80,  fda_margin_n7_d85,  fda_margin_n7_d90,
    fda_margin_n7_d95,  fda_margin_n7_d100,
    fda_margin_n28_d50, fda_margin_n28_d70,
    fda_margin_n28_d90, fda_margin_n28_d100,
    fda_d_cert_n7_min, fda_d_cert_n28_max,
    fda_d_optimal_n7,  fda_dose_gap_steps
}

fn pi(n: i64) with Mut, Div, Panic, IO {
    if n == 0 { print("0") }
    else {
        var digits = [0, 0, 0, 0, 0, 0, 0, 0]
        var num = n; var count = 0
        while num > 0 { digits[count] = num - (num / 10) * 10; num = num / 10; count = count + 1 }
        var idx = count - 1
        while idx >= 0 {
            if digits[idx] == 0 { print("0") } else if digits[idx] == 1 { print("1") }
            else if digits[idx] == 2 { print("2") } else if digits[idx] == 3 { print("3") }
            else if digits[idx] == 4 { print("4") } else if digits[idx] == 5 { print("5") }
            else if digits[idx] == 6 { print("6") } else if digits[idx] == 7 { print("7") }
            else if digits[idx] == 8 { print("8") } else { print("9") };
            idx = idx - 1
        }
    }
}

fn main() with Mut, Div, Panic, IO {
    print("=== Fast stratum N=7 margin scan ===\n")
    print("D=5.0:  "); print_f64(fda_margin_n7_d50());  print("\n")
    print("D=5.5:  "); print_f64(fda_margin_n7_d55());  print("\n")
    print("D=6.0:  "); print_f64(fda_margin_n7_d60());  print("\n")
    print("D=6.5:  "); print_f64(fda_margin_n7_d65());  print("\n")
    print("D=7.0:  "); print_f64(fda_margin_n7_d70());  print("\n")
    print("D=7.5:  "); print_f64(fda_margin_n7_d75());  print("\n")
    print("D=8.0:  "); print_f64(fda_margin_n7_d80());  print("\n")
    print("D=8.5:  "); print_f64(fda_margin_n7_d85());  print("\n")
    print("D=9.0:  "); print_f64(fda_margin_n7_d90());  print("\n")
    print("D=9.5:  "); print_f64(fda_margin_n7_d95());  print("\n")
    print("D=10.0: "); print_f64(fda_margin_n7_d100()); print("\n")

    print("\n=== Fast stratum N=28 margin at key doses ===\n")
    print("D=5.0:  "); print_f64(fda_margin_n28_d50());  print("\n")
    print("D=7.0:  "); print_f64(fda_margin_n28_d70());  print("\n")
    print("D=9.0:  "); print_f64(fda_margin_n28_d90());  print("\n")
    print("D=10.0: "); print_f64(fda_margin_n28_d100()); print("\n")

    print("\n=== Scanner results ===\n")
    print("d_cert_n7_min:  "); print_f64(fda_d_cert_n7_min());  print("\n")
    print("d_cert_n28_max: "); print_f64(fda_d_cert_n28_max()); print("\n")
    print("d_optimal_n7:   "); print_f64(fda_d_optimal_n7());   print("\n")
    print("dose_gap_steps: "); pi(fda_dose_gap_steps()); print("\n")
}
