{
  "schema": "sounio.research.hypercomplex.taxonomy.v1",
  "wave": "hypercomplex-algebra-wave1",
  "baseline_branch": "compiler-institutional-finalization",
  "baseline_commit": "5f6b8e5502004b1b017b53ac662aa3efa75c20dd",
  "classes": {
    "research-only": {
      "description": "Evidence-bearing research or exploratory material that must not silently become a support claim or a broad optimizer/runtime contract.",
      "allowed": [
        "inventory",
        "paper linkage",
        "historical documentation",
        "offline generators",
        "narrow exploratory fixtures"
      ],
      "disallowed": [
        "required CI promotion",
        "public support inflation",
        "unchecked rewrite generalization"
      ]
    },
    "prototype-safe": {
      "description": "Bounded, testable work that can be explored without altering current public support semantics or weakening baseline authority gates.",
      "allowed": [
        "internal manifests",
        "compile-proof fixtures",
        "narrow parser/typechecker hooks",
        "gated diagnostics",
        "advisory validation"
      ],
      "disallowed": [
        "broad support claims",
        "unguarded semantic rewrites",
        "baseline dependency promotion"
      ]
    },
    "production-deferred": {
      "description": "Surfaces that may exist or be desirable, but need stronger contracts, governance, and validation before any production maturity claim.",
      "allowed": [
        "explicit deferral",
        "hazard documentation",
        "contract planning"
      ],
      "disallowed": [
        "ship-level promises",
        "ABI guarantees without dedicated validation",
        "required-check coupling without governance"
      ]
    }
  },
  "touchpoint_categories": [
    "parser-syntax-surface",
    "type-system",
    "operator-semantics",
    "parenthesization-semantics",
    "symbolic-normalization",
    "ir-lowering",
    "ir-annotations",
    "optimizer-algebraic-identities",
    "runtime-layout-abi",
    "test-architecture",
    "docs-governance"
  ],
  "surface_states": [
    "active",
    "historical",
    "contradictory",
    "absent"
  ],
  "validation_rules": {
    "all_inventory_entries_must_have_classification": true,
    "all_inventory_entries_must_have_category": true,
    "all_inventory_entries_must_reference_existing_paths_unless_absent": true,
    "all_inventory_entries_must_reference_known_hazards": true,
    "all_hazards_must_reference_existing_inventory_ids": true
  }
}
