//@ run-pass
struct Counter {
    val: i64,
}

impl Counter {
    fn new() -> Counter {
        Counter { val: 42 }
    }
    fn get_val(self: &Counter) -> i64 {
        self.val
    }
}

fn main() -> i64 with IO {
    var c = Counter::new()
    let v = c.get_val()
    print("Value: ")
    print_int(v)
    print("\n")
    0
}
