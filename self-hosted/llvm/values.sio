// self-hosted::llvm::values — Non-linear wrapper for LLVMValueRef
//
// LlvmValue is NOT linear — LLVM values are interned/owned by the module.
// Free to copy and pass around. Cleaned up when the parent module is disposed.

pub struct LlvmValue {
    ptr: i64,
}

// Sentinel for "no value" / uninitialized
fn llvm_value_null() -> LlvmValue {
    LlvmValue { ptr: 0 }
}

fn llvm_value_is_null(val: LlvmValue) -> bool {
    val.ptr == 0
}

// ============================================================================
// Integer constants
// ============================================================================

fn llvm_const_int(int_type: LlvmType, n: i64, sign_extend: i32) -> LlvmValue with IO {
    let val = LLVMConstInt(int_type.ptr, n, sign_extend)
    LlvmValue { ptr: val }
}

fn llvm_const_real(real_type: LlvmType, n: f64) -> LlvmValue with IO {
    let val = LLVMConstReal(real_type.ptr, n)
    LlvmValue { ptr: val }
}

fn llvm_const_null(ty: LlvmType) -> LlvmValue with IO {
    let val = LLVMConstNull(ty.ptr)
    LlvmValue { ptr: val }
}

fn llvm_get_undef(ty: LlvmType) -> LlvmValue with IO {
    let val = LLVMGetUndef(ty.ptr)
    LlvmValue { ptr: val }
}

fn llvm_const_pointer_null(ty: LlvmType) -> LlvmValue with IO {
    let val = LLVMConstPointerNull(ty.ptr)
    LlvmValue { ptr: val }
}

// ============================================================================
// Aggregate constants
// ============================================================================

fn llvm_const_array(elem_type: LlvmType, values: *const i64, length: i64) -> LlvmValue with IO {
    let val = LLVMConstArray2(elem_type.ptr, values, length)
    LlvmValue { ptr: val }
}

// ============================================================================
// Value queries
// ============================================================================

fn llvm_type_of(val: LlvmValue) -> LlvmType with IO {
    let ty = LLVMTypeOf(val.ptr)
    LlvmType { ptr: ty }
}

fn llvm_set_value_name(val: LlvmValue, name: *const i8, name_len: i64) -> () with IO {
    LLVMSetValueName2(val.ptr, name, name_len)
}

// ============================================================================
// Function-related value operations
// ============================================================================

fn llvm_get_param(func: LlvmValue, index: i32) -> LlvmValue with IO {
    let val = LLVMGetParam(func.ptr, index)
    LlvmValue { ptr: val }
}

fn llvm_count_params(func: LlvmValue) -> i32 with IO {
    LLVMCountParams(func.ptr)
}

fn llvm_set_linkage(global: LlvmValue, linkage: i32) -> () with IO {
    LLVMSetLinkage(global.ptr, linkage)
}

fn llvm_set_function_call_conv(func: LlvmValue, cc: i32) -> () with IO {
    LLVMSetFunctionCallConv(func.ptr, cc)
}

fn llvm_get_function_call_conv(func: LlvmValue) -> i32 with IO {
    LLVMGetFunctionCallConv(func.ptr)
}

// ============================================================================
// Value array helper (for building argument lists, phi incoming, etc.)
// ============================================================================

struct LlvmValueArray {
    data: [i64; 256],
    len: i64,
}

fn llvm_value_array_new() -> LlvmValueArray {
    LlvmValueArray { data: [0; 256], len: 0 }
}

fn llvm_value_array_push(arr: LlvmValueArray, val: LlvmValue) -> LlvmValueArray with Mut, Panic {
    var out = arr
    if out.len < 256 {
        out.data[out.len as usize] = val.ptr
        out.len = out.len + 1
    }
    out
}

fn llvm_value_array_len(arr: LlvmValueArray) -> i64 {
    arr.len
}

// ============================================================================
// Global variable operations
// ============================================================================

fn llvm_set_initializer(global: LlvmValue, const_val: LlvmValue) -> () with IO {
    LLVMSetInitializer(global.ptr, const_val.ptr)
}

fn llvm_set_global_constant(global: LlvmValue, is_constant: i32) -> () with IO {
    LLVMSetGlobalConstant(global.ptr, is_constant)
}

fn llvm_set_unnamed_address(global: LlvmValue, unnamed_addr: i32) -> () with IO {
    LLVMSetUnnamedAddress(global.ptr, unnamed_addr)
}
