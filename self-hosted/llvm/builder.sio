fn llvm_build_br(b: LlvmBuilder, dest: LlvmBlock) -> (LlvmBuilder, LlvmValue) with IO {
    let raw = b.ptr
    let val = LLVMBuildBr(raw, dest.ptr)
    (LlvmBuilder { ptr: raw }, LlvmValue { ptr: val })
}

