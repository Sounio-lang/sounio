    let raw = b.ptr
    let val = LLVMBuildCondBr(raw, cond.ptr, then_block.ptr, else_block.ptr)
    (LlvmBuilder { ptr: raw }, LlvmValue { ptr: val })
}

fn llvm_build_switch(b: LlvmBuilder, val: LlvmValue, default_block: LlvmBlock, num_cases: i32) -> (LlvmBuilder, LlvmValue) with IO {
    let raw = b.ptr
    let sw = LLVMBuildSwitch(raw, val.ptr, default_block.ptr, num_cases)
    (LlvmBuilder { ptr: raw }, LlvmValue { ptr: sw })
}

