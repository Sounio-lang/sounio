// ============================================================================
// Debug location
// ============================================================================

fn llvm_builder_set_debug_location(b: LlvmBuilder, loc: i64) -> LlvmBuilder with IO {
    let raw = b.ptr
    LLVMSetCurrentDebugLocation2(raw, loc)
    LlvmBuilder { ptr: raw }
}
