fn llvm_build_insert_value(b: LlvmBuilder, agg: LlvmValue, val: LlvmValue, index: i32, name: *const i8) -> (LlvmBuilder, LlvmValue) with IO {
    let raw = b.ptr
    let result = LLVMBuildInsertValue(raw, agg.ptr, val.ptr, index, name)
    (LlvmBuilder { ptr: raw }, LlvmValue { ptr: result })
}

