// self-hosted::llvm::builder — Safe wrapper for LLVMBuilderRef
//
// LlvmBuilder is a linear struct — must be disposed exactly once.
// Provides all instruction-building methods from the LLVM-C API.
// Each method consumes the builder and returns it alongside the result.

// ============================================================================
// LlvmBlock — non-linear wrapper for LLVMBasicBlockRef
// ============================================================================

pub struct LlvmBlock {
    ptr: i64,
}

fn llvm_block_null() -> LlvmBlock {
    LlvmBlock { ptr: 0 }
}

fn llvm_block_is_null(bb: LlvmBlock) -> bool {
    bb.ptr == 0
}

fn llvm_block_parent(bb: LlvmBlock) -> LlvmValue with IO {
    let func = LLVMGetBasicBlockParent(bb.ptr)
    LlvmValue { ptr: func }
}

fn llvm_block_next(bb: LlvmBlock) -> LlvmBlock with IO {
    let next = LLVMGetNextBasicBlock(bb.ptr)
    LlvmBlock { ptr: next }
}

// ============================================================================
// LlvmBuilder — linear wrapper around LLVMBuilderRef
// ============================================================================

linear struct LlvmBuilder {
    ptr: i64,
}

fn llvm_builder_create(ctx: LlvmContext) -> (LlvmContext, LlvmBuilder) with IO {
    let raw_ctx = ctx.ptr
    let b = LLVMCreateBuilderInContext(raw_ctx)
    (LlvmContext { ptr: raw_ctx }, LlvmBuilder { ptr: b })
}

fn llvm_builder_dispose(b: LlvmBuilder) -> () with IO {
    let raw = b.ptr
    LLVMDisposeBuilder(raw)
}

fn llvm_builder_raw(b: LlvmBuilder) -> (i64, LlvmBuilder) {
    let raw = b.ptr
    (raw, LlvmBuilder { ptr: raw })
}

// ============================================================================
// Positioning
// ============================================================================

fn llvm_builder_position_at_end(b: LlvmBuilder, block: LlvmBlock) -> LlvmBuilder with IO {
    let raw = b.ptr
    LLVMPositionBuilderAtEnd(raw, block.ptr)
    LlvmBuilder { ptr: raw }
}

fn llvm_builder_get_insert_block(b: LlvmBuilder) -> (LlvmBuilder, LlvmBlock) with IO {
    let raw = b.ptr
    let bb = LLVMGetInsertBlock(raw)
    (LlvmBuilder { ptr: raw }, LlvmBlock { ptr: bb })
}

// ============================================================================
// Arithmetic instructions
// ============================================================================

fn llvm_build_add(b: LlvmBuilder, lhs: LlvmValue, rhs: LlvmValue, name: *const i8) -> (LlvmBuilder, LlvmValue) with IO {
    let raw = b.ptr
    let val = LLVMBuildAdd(raw, lhs.ptr, rhs.ptr, name)
    (LlvmBuilder { ptr: raw }, LlvmValue { ptr: val })
}

