// ============================================================================
// PHI node
// ============================================================================

fn llvm_build_phi(b: LlvmBuilder, ty: LlvmType, name: *const i8) -> (LlvmBuilder, LlvmValue) with IO {
    let raw = b.ptr
    let phi = LLVMBuildPhi(raw, ty.ptr, name)
    (LlvmBuilder { ptr: raw }, LlvmValue { ptr: phi })
}

// Add incoming values/blocks to a phi node (non-linear — just mutates the phi).
fn llvm_add_incoming(phi: LlvmValue, values: *const i64, blocks: *const i64, count: i32) -> () with IO {
    LLVMAddIncoming(phi.ptr, values, blocks, count)
}

// Add a case to a switch instruction.
fn llvm_add_case(switch_instr: LlvmValue, on_val: LlvmValue, dest: LlvmBlock) -> () with IO {
    LLVMAddCase(switch_instr.ptr, on_val.ptr, dest.ptr)
}

// ============================================================================
// Call instruction
// ============================================================================

fn llvm_build_call(b: LlvmBuilder, func_type: LlvmType, func: LlvmValue, args: *const i64, num_args: i32, name: *const i8) -> (LlvmBuilder, LlvmValue) with IO {
    let raw = b.ptr
    let val = LLVMBuildCall2(raw, func_type.ptr, func.ptr, args, num_args, name)
    (LlvmBuilder { ptr: raw }, LlvmValue { ptr: val })
}

