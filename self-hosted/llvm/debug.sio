// self-hosted::llvm::debug — Safe wrapper for LLVM Debug Info (DWARF) builder
//
// LlvmDIBuilder is a linear struct — must be finalized and then disposed.
// Used to emit DWARF debug information for source-level debugging.

// ============================================================================
// LlvmDIBuilder — linear wrapper around LLVMDIBuilderRef
// ============================================================================

linear struct LlvmDIBuilder {
    ptr: i64,
}

fn llvm_di_builder_dispose(di: LlvmDIBuilder) -> () with IO {
    let raw = di.ptr
    LLVMDisposeDIBuilder(raw)
}

fn llvm_di_builder_finalize(di: LlvmDIBuilder) -> LlvmDIBuilder with IO {
    let raw = di.ptr
    LLVMDIBuilderFinalize(raw)
    LlvmDIBuilder { ptr: raw }
}

// ============================================================================
// Compile unit
// ============================================================================

fn llvm_di_create_compile_unit(
    di: LlvmDIBuilder,
    lang: i32,
    file_ref: i64,
    producer: *const i8,
    producer_len: i64,
    is_optimized: i32,
    runtime_ver: i32
) -> (LlvmDIBuilder, i64) with IO {
    let raw = di.ptr
    // Empty strings for flags, split_name, sysroot, sdk
    let empty: *const i8 = 0 as *const i8
    let cu = LLVMDIBuilderCreateCompileUnit(
        raw,
        lang,
        file_ref,
        producer,
        producer_len,
        is_optimized,
        empty, 0,       // flags
        runtime_ver,
        empty, 0,       // split_name
        LLVM_DWARF_EMISSION_FULL,
        0,              // dwo_id
        0,              // split_debug_inlining
        0,              // debug_info_for_profiling
        empty, 0,       // sysroot
        empty, 0        // sdk
    )
    (LlvmDIBuilder { ptr: raw }, cu)
}

// ============================================================================
// File
// ============================================================================

fn llvm_di_create_file(
    di: LlvmDIBuilder,
    filename: *const i8,
    filename_len: i64,
    directory: *const i8,
    directory_len: i64
) -> (LlvmDIBuilder, i64) with IO {
    let raw = di.ptr
    let file = LLVMDIBuilderCreateFile(raw, filename, filename_len, directory, directory_len)
    (LlvmDIBuilder { ptr: raw }, file)
}

// ============================================================================
// Function (subprogram)
// ============================================================================

fn llvm_di_create_function(
    di: LlvmDIBuilder,
    scope: i64,
    name: *const i8,
    name_len: i64,
    linkage_name: *const i8,
    linkage_name_len: i64,
    file: i64,
    line_no: i32,
    ty: i64,
    is_local: i32,
    is_definition: i32,
    scope_line: i32
) -> (LlvmDIBuilder, i64) with IO {
    let raw = di.ptr
    let sp = LLVMDIBuilderCreateFunction(
        raw, scope, name, name_len,
        linkage_name, linkage_name_len,
        file, line_no, ty,
        is_local, is_definition, scope_line,
        0,    // flags
        0     // is_optimized
    )
    (LlvmDIBuilder { ptr: raw }, sp)
}

// ============================================================================
// Lexical block
// ============================================================================

fn llvm_di_create_lexical_block(
    di: LlvmDIBuilder,
    scope: i64,
    file: i64,
    line: i32,
    column: i32
) -> (LlvmDIBuilder, i64) with IO {
    let raw = di.ptr
    let block = LLVMDIBuilderCreateLexicalBlock(raw, scope, file, line, column)
    (LlvmDIBuilder { ptr: raw }, block)
}

// ============================================================================
// Attach debug info to functions
// ============================================================================

fn llvm_set_subprogram(func: LlvmValue, sp: i64) -> () with IO {
    LLVMSetSubprogram(func.ptr, sp)
}
