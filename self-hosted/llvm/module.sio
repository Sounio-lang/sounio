// self-hosted::llvm::module — Safe wrapper for LLVMModuleRef
//
// LlvmModule is a linear struct — must be disposed exactly once.
// All state-threading: each op consumes the module and returns it.

linear struct LlvmModule {
    ptr: i64,
}

fn llvm_module_create(ctx: LlvmContext, name: *const i8) -> (LlvmContext, LlvmModule) with IO {
    let raw_ctx = ctx.ptr
    let m = LLVMModuleCreateWithNameInContext(name, raw_ctx)
    (LlvmContext { ptr: raw_ctx }, LlvmModule { ptr: m })
}

fn llvm_module_dispose(m: LlvmModule) -> () with IO {
    let raw = m.ptr
    LLVMDisposeModule(raw)
}

fn llvm_module_raw(m: LlvmModule) -> (i64, LlvmModule) {
    let raw = m.ptr
    (raw, LlvmModule { ptr: raw })
}

// ============================================================================
// Module configuration
// ============================================================================

fn llvm_module_set_target(m: LlvmModule, triple: *const i8) -> LlvmModule with IO {
    let raw = m.ptr
    LLVMSetTarget(raw, triple)
    LlvmModule { ptr: raw }
}

fn llvm_module_set_data_layout(m: LlvmModule, layout: *const i8) -> LlvmModule with IO {
    let raw = m.ptr
    LLVMSetDataLayout(raw, layout)
    LlvmModule { ptr: raw }
}

fn llvm_module_set_identifier(m: LlvmModule, ident: *const i8, len: i64) -> LlvmModule with IO {
    let raw = m.ptr
    LLVMSetModuleIdentifier(raw, ident, len)
    LlvmModule { ptr: raw }
}

// ============================================================================
// Function management
// ============================================================================

fn llvm_module_add_function(m: LlvmModule, name: *const i8, func_type: LlvmType) -> (LlvmModule, LlvmValue) with IO {
    let raw = m.ptr
    let func = LLVMAddFunction(raw, name, func_type.ptr)
    (LlvmModule { ptr: raw }, LlvmValue { ptr: func })
}

fn llvm_module_get_named_function(m: LlvmModule, name: *const i8) -> (LlvmModule, LlvmValue) with IO {
    let raw = m.ptr
    let func = LLVMGetNamedFunction(raw, name)
    (LlvmModule { ptr: raw }, LlvmValue { ptr: func })
}

// ============================================================================
// Global variable management
// ============================================================================

fn llvm_module_add_global(m: LlvmModule, ty: LlvmType, name: *const i8) -> (LlvmModule, LlvmValue) with IO {
    let raw = m.ptr
    let g = LLVMAddGlobal(raw, ty.ptr, name)
    (LlvmModule { ptr: raw }, LlvmValue { ptr: g })
}

fn llvm_module_get_named_global(m: LlvmModule, name: *const i8) -> (LlvmModule, LlvmValue) with IO {
    let raw = m.ptr
    let g = LLVMGetNamedGlobal(raw, name)
    (LlvmModule { ptr: raw }, LlvmValue { ptr: g })
}

// ============================================================================
// Verification and printing
// ============================================================================

// Verify the module. Returns 0 on success, non-zero on failure.
// error_msg receives an allocated string if verification fails.
fn llvm_module_verify(m: LlvmModule, error_msg: *const *const i8) -> (LlvmModule, i32) with IO {
    let raw = m.ptr
    let result = LLVMVerifyModule(raw, LLVM_RETURN_STATUS_ACTION, error_msg)
    (LlvmModule { ptr: raw }, result)
}

// Print the module to an LLVM-allocated string (caller must LLVMDisposeMessage).
fn llvm_module_print_to_string(m: LlvmModule) -> (LlvmModule, *const i8) with IO {
    let raw = m.ptr
    let s = LLVMPrintModuleToString(raw)
    (LlvmModule { ptr: raw }, s)
}

// ============================================================================
// Bitcode
// ============================================================================

fn llvm_module_write_bitcode(m: LlvmModule, path: *const i8) -> (LlvmModule, i32) with IO {
    let raw = m.ptr
    let result = LLVMWriteBitcodeToFile(raw, path)
    (LlvmModule { ptr: raw }, result)
}

// ============================================================================
// Code emission (requires target machine)
// ============================================================================

fn llvm_module_emit_to_file(m: LlvmModule, tm: LlvmTargetMachine, filename: *const i8, file_type: i32, error_msg: *const *const i8) -> (LlvmModule, LlvmTargetMachine, i32) with IO {
    let raw_m = m.ptr
    let raw_tm = tm.ptr
    let result = LLVMTargetMachineEmitToFile(raw_tm, raw_m, filename, file_type, error_msg)
    (LlvmModule { ptr: raw_m }, LlvmTargetMachine { ptr: raw_tm }, result)
}

// ============================================================================
// Pass runner
// ============================================================================

fn llvm_module_run_passes(m: LlvmModule, passes: *const i8, tm: LlvmTargetMachine, opts: i64) -> (LlvmModule, LlvmTargetMachine, i64) with IO {
    let raw_m = m.ptr
    let raw_tm = tm.ptr
    let result = LLVMRunPasses(raw_m, passes, raw_tm, opts)
    (LlvmModule { ptr: raw_m }, LlvmTargetMachine { ptr: raw_tm }, result)
}

// ============================================================================
// Debug info builder creation
// ============================================================================

fn llvm_module_create_di_builder(m: LlvmModule) -> (LlvmModule, LlvmDIBuilder) with IO {
    let raw = m.ptr
    let di = LLVMCreateDIBuilder(raw)
    (LlvmModule { ptr: raw }, LlvmDIBuilder { ptr: di })
}
