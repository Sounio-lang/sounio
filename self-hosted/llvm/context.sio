fn llvm_ptr_type(ctx: LlvmContext, address_space: i32) -> (LlvmContext, LlvmType) with IO {
    let raw = ctx.ptr
    let ty = LLVMPointerTypeInContext(raw, address_space)
    (LlvmContext { ptr: raw }, LlvmType { ptr: ty })
}

// ============================================================================
// Composite type factories
// ============================================================================

// Create an anonymous packed or unpacked struct type.
// elem_types is a pointer to an array of LlvmType raw pointers.
fn llvm_struct_type(ctx: LlvmContext, elem_types: *const i64, count: i32, packed: i32) -> (LlvmContext, LlvmType) with IO {
    let raw = ctx.ptr
    let ty = LLVMStructTypeInContext(raw, elem_types, count, packed)
    (LlvmContext { ptr: raw }, LlvmType { ptr: ty })
}

// Create a named (identified) struct type. Body can be set later.
fn llvm_struct_create_named(ctx: LlvmContext, name: *const i8) -> (LlvmContext, LlvmType) with IO {
    let raw = ctx.ptr
    let ty = LLVMStructCreateNamed(raw, name)
    (LlvmContext { ptr: raw }, LlvmType { ptr: ty })
}

// ============================================================================
// Basic block factory
// ============================================================================

fn llvm_append_basic_block(ctx: LlvmContext, func: LlvmValue, name: *const i8) -> (LlvmContext, LlvmBlock) with IO {
    let raw = ctx.ptr
    let func_ptr = func.ptr
    let bb = LLVMAppendBasicBlockInContext(raw, func_ptr, name)
    (LlvmContext { ptr: raw }, LlvmBlock { ptr: bb })
}

// ============================================================================
// Constant factories (require context)
// ============================================================================

fn llvm_const_string(ctx: LlvmContext, str_ptr: *const i8, length: i32, no_null: i32) -> (LlvmContext, LlvmValue) with IO {
    let raw = ctx.ptr
    let val = LLVMConstStringInContext(raw, str_ptr, length, no_null)
    (LlvmContext { ptr: raw }, LlvmValue { ptr: val })
}

fn llvm_const_struct(ctx: LlvmContext, values: *const i64, count: i32, packed: i32) -> (LlvmContext, LlvmValue) with IO {
    let raw = ctx.ptr
    let val = LLVMConstStructInContext(raw, values, count, packed)
    (LlvmContext { ptr: raw }, LlvmValue { ptr: val })
}

// ============================================================================
// Debug location factory
// ============================================================================

fn llvm_debug_location(ctx: LlvmContext, line: i32, column: i32, scope: i64, inlined_at: i64) -> (LlvmContext, i64) with IO {
    let raw = ctx.ptr
    let loc = LLVMDIBuilderCreateDebugLocation(raw, line, column, scope, inlined_at)
    (LlvmContext { ptr: raw }, loc)
}
