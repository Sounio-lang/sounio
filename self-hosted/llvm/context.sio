    let raw = ctx.ptr
    let ty = LLVMInt32TypeInContext(raw)
    (LlvmContext { ptr: raw }, LlvmType { ptr: ty })
}

fn llvm_int64_type(ctx: LlvmContext) -> (LlvmContext, LlvmType) with IO {
    let raw = ctx.ptr
    let ty = LLVMInt64TypeInContext(raw)
    (LlvmContext { ptr: raw }, LlvmType { ptr: ty })
}

fn llvm_int128_type(ctx: LlvmContext) -> (LlvmContext, LlvmType) with IO {
    let raw = ctx.ptr
