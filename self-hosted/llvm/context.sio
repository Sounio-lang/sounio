fn llvm_double_type(ctx: LlvmContext) -> (LlvmContext, LlvmType) with IO {
    let raw = ctx.ptr
    let ty = LLVMDoubleTypeInContext(raw)
    (LlvmContext { ptr: raw }, LlvmType { ptr: ty })
