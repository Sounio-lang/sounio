// self-hosted::llvm::context — Safe wrapper for LLVMContextRef
//
// LlvmContext is a linear struct that owns an LLVM context.
// Must be disposed exactly once via llvm_context_dispose().
// All LLVM objects (modules, builders, types) are created within a context.
//
// The state-threading pattern is used throughout: each operation consumes
// the context and returns it alongside the result, preserving linear ownership.

// ============================================================================
// LlvmContext — linear wrapper around LLVMContextRef (opaque i64)
// ============================================================================

linear struct LlvmContext {
    ptr: i64,
}

fn llvm_context_create() -> LlvmContext with IO {
    let raw = LLVMContextCreate()
    LlvmContext { ptr: raw }
}

fn llvm_context_dispose(ctx: LlvmContext) -> () with IO {
    let raw = ctx.ptr
    LLVMContextDispose(raw)
}

// Extract the raw pointer for use in FFI calls.
// Returns (raw_ptr, rebuilt_context) — caller must use both.
fn llvm_context_raw(ctx: LlvmContext) -> (i64, LlvmContext) {
    let raw = ctx.ptr
    (raw, LlvmContext { ptr: raw })
}

// ============================================================================
// Type factories — create LLVM types within this context
// ============================================================================

fn llvm_void_type(ctx: LlvmContext) -> (LlvmContext, LlvmType) with IO {
    let raw = ctx.ptr
    let ty = LLVMVoidTypeInContext(raw)
    (LlvmContext { ptr: raw }, LlvmType { ptr: ty })
}

fn llvm_int1_type(ctx: LlvmContext) -> (LlvmContext, LlvmType) with IO {
    let raw = ctx.ptr
    let ty = LLVMInt1TypeInContext(raw)
    (LlvmContext { ptr: raw }, LlvmType { ptr: ty })
}

fn llvm_int8_type(ctx: LlvmContext) -> (LlvmContext, LlvmType) with IO {
    let raw = ctx.ptr
    let ty = LLVMInt8TypeInContext(raw)
    (LlvmContext { ptr: raw }, LlvmType { ptr: ty })
}

