// ============================================================================

extern "C" {
    fn LLVMBuildBr(b: i64, dest: i64) -> i64;
    fn LLVMBuildCondBr(b: i64, cond: i64, then_block: i64, else_block: i64) -> i64;
    fn LLVMBuildSwitch(b: i64, val: i64, default_block: i64, num_cases: i32) -> i64;
    fn LLVMAddCase(switch_instr: i64, on_val: i64, dest: i64) -> ();
    fn LLVMBuildRet(b: i64, val: i64) -> i64;
    fn LLVMBuildRetVoid(b: i64) -> i64;
    fn LLVMBuildUnreachable(b: i64) -> i64;
}

// ============================================================================
// Instructions: PHI, Call, Cast, Select — llvm-c/Core.h
// ============================================================================

extern "C" {
    // PHI
    fn LLVMBuildPhi(b: i64, ty: i64, name: *const i8) -> i64;
    fn LLVMAddIncoming(phi: i64, incoming_values: *const i64, incoming_blocks: *const i64, count: i32) -> ();

    // Call
    fn LLVMBuildCall2(b: i64, func_type: i64, func: i64, args: *const i64, num_args: i32, name: *const i8) -> i64;

    // Aggregate
    fn LLVMBuildExtractValue(b: i64, agg: i64, index: i32, name: *const i8) -> i64;
    fn LLVMBuildInsertValue(b: i64, agg: i64, val: i64, index: i32, name: *const i8) -> i64;

    // Cast
    fn LLVMBuildBitCast(b: i64, val: i64, dest_ty: i64, name: *const i8) -> i64;
    fn LLVMBuildIntCast2(b: i64, val: i64, dest_ty: i64, is_signed: i32, name: *const i8) -> i64;
    fn LLVMBuildFPToSI(b: i64, val: i64, dest_ty: i64, name: *const i8) -> i64;
    fn LLVMBuildFPToUI(b: i64, val: i64, dest_ty: i64, name: *const i8) -> i64;
    fn LLVMBuildSIToFP(b: i64, val: i64, dest_ty: i64, name: *const i8) -> i64;
    fn LLVMBuildUIToFP(b: i64, val: i64, dest_ty: i64, name: *const i8) -> i64;
    fn LLVMBuildTrunc(b: i64, val: i64, dest_ty: i64, name: *const i8) -> i64;
    fn LLVMBuildZExt(b: i64, val: i64, dest_ty: i64, name: *const i8) -> i64;
    fn LLVMBuildSExt(b: i64, val: i64, dest_ty: i64, name: *const i8) -> i64;
    fn LLVMBuildFPCast(b: i64, val: i64, dest_ty: i64, name: *const i8) -> i64;
    fn LLVMBuildPtrToInt(b: i64, val: i64, dest_ty: i64, name: *const i8) -> i64;
    fn LLVMBuildIntToPtr(b: i64, val: i64, dest_ty: i64, name: *const i8) -> i64;

    // Unary
    fn LLVMBuildNeg(b: i64, val: i64, name: *const i8) -> i64;
    fn LLVMBuildFNeg(b: i64, val: i64, name: *const i8) -> i64;
    fn LLVMBuildNot(b: i64, val: i64, name: *const i8) -> i64;

    // Select
    fn LLVMBuildSelect(b: i64, cond: i64, then_val: i64, else_val: i64, name: *const i8) -> i64;
}

