    fn LLVMBuildMul(b: i64, lhs: i64, rhs: i64, name: *const i8) -> i64;
    fn LLVMBuildNSWMul(b: i64, lhs: i64, rhs: i64, name: *const i8) -> i64;
    fn LLVMBuildUDiv(b: i64, lhs: i64, rhs: i64, name: *const i8) -> i64;
    fn LLVMBuildSDiv(b: i64, lhs: i64, rhs: i64, name: *const i8) -> i64;
    fn LLVMBuildURem(b: i64, lhs: i64, rhs: i64, name: *const i8) -> i64;
    fn LLVMBuildSRem(b: i64, lhs: i64, rhs: i64, name: *const i8) -> i64;
    fn LLVMBuildFAdd(b: i64, lhs: i64, rhs: i64, name: *const i8) -> i64;
    fn LLVMBuildFSub(b: i64, lhs: i64, rhs: i64, name: *const i8) -> i64;
    fn LLVMBuildFMul(b: i64, lhs: i64, rhs: i64, name: *const i8) -> i64;
    fn LLVMBuildFDiv(b: i64, lhs: i64, rhs: i64, name: *const i8) -> i64;
    fn LLVMBuildFRem(b: i64, lhs: i64, rhs: i64, name: *const i8) -> i64;
}

