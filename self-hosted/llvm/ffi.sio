// self-hosted::llvm::ffi — Raw LLVM-C API bindings
//
// Direct extern "C" declarations for the LLVM C API.
// These mirror the LLVM-C headers (Core.h, TargetMachine.h, etc.)
// and are consumed by the safe wrapper layer in context.sio, module.sio, etc.
//
// All LLVM references (LLVMContextRef, LLVMModuleRef, etc.) are opaque pointers
// represented as i64 in Sounio. The safe wrapper layer provides linear struct
// types for RAII lifecycle management.
//
// Requires linking against LLVM libraries (-lLLVM-15 or equivalent).

// ============================================================================
// LLVM Enums (integer constants matching llvm-c/Core.h)
// ============================================================================

// LLVMIntPredicate
let LLVM_INT_EQ: i32  = 32
let LLVM_INT_NE: i32  = 33
let LLVM_INT_UGT: i32 = 34
let LLVM_INT_UGE: i32 = 35
let LLVM_INT_ULT: i32 = 36
let LLVM_INT_ULE: i32 = 37
let LLVM_INT_SGT: i32 = 38
let LLVM_INT_SGE: i32 = 39
let LLVM_INT_SLT: i32 = 40
let LLVM_INT_SLE: i32 = 41

// LLVMRealPredicate
let LLVM_REAL_OEQ: i32 = 1
let LLVM_REAL_OGT: i32 = 2
let LLVM_REAL_OGE: i32 = 3
let LLVM_REAL_OLT: i32 = 4
let LLVM_REAL_OLE: i32 = 5
let LLVM_REAL_ONE: i32 = 6
let LLVM_REAL_UNO: i32 = 8
let LLVM_REAL_UEQ: i32 = 9
let LLVM_REAL_UNE: i32 = 14

// LLVMCodeGenOptLevel
let LLVM_CODEGEN_OPT_NONE: i32       = 0
let LLVM_CODEGEN_OPT_LESS: i32       = 1
let LLVM_CODEGEN_OPT_DEFAULT: i32    = 2
let LLVM_CODEGEN_OPT_AGGRESSIVE: i32 = 3

// LLVMRelocMode
let LLVM_RELOC_DEFAULT: i32        = 0
let LLVM_RELOC_STATIC: i32         = 1
let LLVM_RELOC_PIC: i32            = 2
let LLVM_RELOC_DYNAMIC_NO_PIC: i32 = 3
let LLVM_RELOC_ROPI: i32           = 4
let LLVM_RELOC_RWPI: i32           = 5
let LLVM_RELOC_ROPI_RWPI: i32      = 6

// LLVMCodeModel
let LLVM_CODE_MODEL_DEFAULT: i32 = 0
let LLVM_CODE_MODEL_JIT: i32     = 1
let LLVM_CODE_MODEL_TINY: i32    = 2
let LLVM_CODE_MODEL_SMALL: i32   = 3
let LLVM_CODE_MODEL_KERNEL: i32  = 4
let LLVM_CODE_MODEL_MEDIUM: i32  = 5
let LLVM_CODE_MODEL_LARGE: i32   = 6

// LLVMCodeGenFileType
let LLVM_ASSEMBLY_FILE: i32   = 0
let LLVM_OBJECT_FILE: i32     = 1

// LLVMLinkage
let LLVM_EXTERNAL_LINKAGE: i32  = 0
let LLVM_INTERNAL_LINKAGE: i32  = 8
let LLVM_PRIVATE_LINKAGE: i32   = 9

// LLVMCallConv
let LLVM_C_CALL_CONV: i32       = 0
let LLVM_FAST_CALL_CONV: i32    = 8
let LLVM_COLD_CALL_CONV: i32    = 9

// LLVMUnnamedAddr
let LLVM_NO_UNNAMED_ADDR: i32    = 0
let LLVM_LOCAL_UNNAMED_ADDR: i32  = 1
let LLVM_GLOBAL_UNNAMED_ADDR: i32 = 2

// LLVMVerifierFailureAction
let LLVM_ABORT_PROCESS_ACTION: i32  = 0
let LLVM_PRINT_MESSAGE_ACTION: i32  = 1
let LLVM_RETURN_STATUS_ACTION: i32  = 2

// DWARF source language
let LLVM_DWARF_SOURCE_LANGUAGE_C: i32 = 0
let LLVM_DWARF_SOURCE_LANGUAGE_C99: i32 = 12

// DWARF emission kind
let LLVM_DWARF_EMISSION_FULL: i32 = 1

// ============================================================================
// Context, Module, Builder — llvm-c/Core.h
// ============================================================================

extern "C" {
    // Context
    fn LLVMContextCreate() -> i64;
    fn LLVMContextDispose(ctx: i64) -> ();

    // Module
    fn LLVMModuleCreateWithNameInContext(name: *const i8, ctx: i64) -> i64;
    fn LLVMDisposeModule(m: i64) -> ();
    fn LLVMSetTarget(m: i64, triple: *const i8) -> ();
    fn LLVMSetDataLayout(m: i64, layout: *const i8) -> ();
    fn LLVMPrintModuleToString(m: i64) -> *const i8;
    fn LLVMSetModuleIdentifier(m: i64, ident: *const i8, len: i64) -> ();

    // Builder
    fn LLVMCreateBuilderInContext(ctx: i64) -> i64;
    fn LLVMDisposeBuilder(b: i64) -> ();
    fn LLVMPositionBuilderAtEnd(b: i64, block: i64) -> ();
    fn LLVMGetInsertBlock(b: i64) -> i64;
}

// ============================================================================
// Types — llvm-c/Core.h
// ============================================================================

extern "C" {
    // Primitive types
    fn LLVMVoidTypeInContext(ctx: i64) -> i64;
    fn LLVMInt1TypeInContext(ctx: i64) -> i64;
    fn LLVMInt8TypeInContext(ctx: i64) -> i64;
    fn LLVMInt16TypeInContext(ctx: i64) -> i64;
    fn LLVMInt32TypeInContext(ctx: i64) -> i64;
    fn LLVMInt64TypeInContext(ctx: i64) -> i64;
    fn LLVMInt128TypeInContext(ctx: i64) -> i64;
    fn LLVMFloatTypeInContext(ctx: i64) -> i64;
    fn LLVMDoubleTypeInContext(ctx: i64) -> i64;

    // Pointer type (LLVM 15+ opaque pointers)
    fn LLVMPointerTypeInContext(ctx: i64, address_space: i32) -> i64;

    // Composite types
    fn LLVMStructTypeInContext(ctx: i64, elem_types: *const i64, elem_count: i32, packed: i32) -> i64;
    fn LLVMStructCreateNamed(ctx: i64, name: *const i8) -> i64;
    fn LLVMStructSetBody(struct_type: i64, elem_types: *const i64, elem_count: i32, packed: i32) -> ();
    fn LLVMArrayType2(elem_type: i64, length: i64) -> i64;
    fn LLVMVectorType(elem_type: i64, count: i32) -> i64;
    fn LLVMFunctionType(return_type: i64, param_types: *const i64, param_count: i32, is_var_arg: i32) -> i64;

    // Type queries
    fn LLVMGetTypeKind(ty: i64) -> i32;
    fn LLVMTypeIsSized(ty: i64) -> i32;
}

// ============================================================================
// Constants & Values — llvm-c/Core.h
// ============================================================================

extern "C" {
    // Integer constants
    fn LLVMConstInt(int_type: i64, n: i64, sign_extend: i32) -> i64;
    fn LLVMConstReal(real_type: i64, n: f64) -> i64;
    fn LLVMConstNull(ty: i64) -> i64;
    fn LLVMGetUndef(ty: i64) -> i64;
    fn LLVMConstPointerNull(ty: i64) -> i64;

    // Aggregate constants
    fn LLVMConstArray2(elem_type: i64, const_values: *const i64, length: i64) -> i64;
    fn LLVMConstStructInContext(ctx: i64, const_values: *const i64, count: i32, packed: i32) -> i64;
    fn LLVMConstStringInContext(ctx: i64, str_ptr: *const i8, length: i32, dont_null_terminate: i32) -> i64;

    // Value queries
    fn LLVMTypeOf(val: i64) -> i64;
    fn LLVMSetValueName2(val: i64, name: *const i8, name_len: i64) -> ();
    fn LLVMGetValueName2(val: i64, length: *const i64) -> *const i8;
}

