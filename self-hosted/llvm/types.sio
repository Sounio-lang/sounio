// self-hosted::llvm::types — Non-linear wrapper for LLVMTypeRef
//
// LlvmType is NOT linear because LLVM types are interned within a context.
// They don't need cleanup — their lifetime is tied to the owning LLVMContext.
// This makes LlvmType cheap to copy and pass around freely.

pub struct LlvmType {
    ptr: i64,
}

// Sentinel for "no type" / uninitialized
fn llvm_type_null() -> LlvmType {
    LlvmType { ptr: 0 }
}

fn llvm_type_is_null(ty: LlvmType) -> bool {
    ty.ptr == 0
}

// ============================================================================
// Context-free type constructors (composite types built from existing types)
// ============================================================================

fn llvm_array_type(elem_type: LlvmType, length: i64) -> LlvmType with IO {
    let ty = LLVMArrayType2(elem_type.ptr, length)
    LlvmType { ptr: ty }
}

fn llvm_vector_type(elem_type: LlvmType, count: i32) -> LlvmType with IO {
    let ty = LLVMVectorType(elem_type.ptr, count)
    LlvmType { ptr: ty }
}

fn llvm_function_type(return_type: LlvmType, param_types: *const i64, param_count: i32, is_var_arg: i32) -> LlvmType with IO {
    let ty = LLVMFunctionType(return_type.ptr, param_types, param_count, is_var_arg)
    LlvmType { ptr: ty }
}

// Set the body of a named struct type (created via llvm_struct_create_named).
fn llvm_struct_set_body(struct_type: LlvmType, elem_types: *const i64, count: i32, packed: i32) -> () with IO {
    LLVMStructSetBody(struct_type.ptr, elem_types, count, packed)
}

// ============================================================================
// Type queries
// ============================================================================

fn llvm_get_type_kind(ty: LlvmType) -> i32 with IO {
    LLVMGetTypeKind(ty.ptr)
}

fn llvm_type_is_sized(ty: LlvmType) -> bool with IO {
    LLVMTypeIsSized(ty.ptr) != 0
}

// ============================================================================
// Common type-building helpers
//
// These helpers construct frequently-used LLVM types without needing
// the context passed through (they compose from existing LlvmType values).
// ============================================================================

// Build a struct type from an array of raw type pointers.
// Convenience for building param lists, struct layouts, etc.
struct LlvmTypeArray {
    data: [i64; 64],
    len: i64,
}

fn llvm_type_array_new() -> LlvmTypeArray {
    LlvmTypeArray { data: [0; 64], len: 0 }
}

fn llvm_type_array_push(arr: LlvmTypeArray, ty: LlvmType) -> LlvmTypeArray with Mut, Panic {
    var out = arr
    if out.len < 64 {
        out.data[out.len as usize] = ty.ptr
        out.len = out.len + 1
    }
    out
}

fn llvm_type_array_len(arr: LlvmTypeArray) -> i64 {
    arr.len
}
