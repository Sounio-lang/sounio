// T33: scalar witness builtins fail closed when the requested metric is unavailable
fn kn_test_contest_witness_rejects_missing_metric() -> bool with Mut, Panic, Div, Alloc, IO {
    let contest_name = kn_make_name(99, 0, 0, 1)
    let policy_name = kn_make_name(112, 0, 0, 1)
