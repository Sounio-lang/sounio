// T29: disagreement(contest) returns a named witness struct and exports witness-side metadata to IR
fn kn_test_contest_witness_disagreement_exports_ir() -> bool with Mut, Panic, Div, Alloc, IO {
    let contest_name = kn_make_name(99, 0, 0, 1)
    let policy_name = kn_make_name(112, 0, 0, 1)
