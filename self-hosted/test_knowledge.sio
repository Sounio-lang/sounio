    let policy_ty = checker.env.lookup(policy_name)
    checker = kn_seed_contest_for_policy(checker, contest_name, policy_ty.epistemic_meta_id)
    let pair = checker.check_expr(kn_call_expr1(witness_name, kn_ident_expr(contest_name)))
    pair.0.error_count > 0 && pair.1.kind == TypeKind::TyError
}

