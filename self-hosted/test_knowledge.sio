    let contest_ty = checker.env.lookup(contest_name)
    let pair = checker.check_expr(kn_call_expr1(witness_name, kn_ident_expr(contest_name)))
    let checked = pair.0
    let ty = pair.1
    if checked.error_count > 0 || ty.kind != TypeKind::TyNamed || !name_eq(ty.name, kn_name_from_str("ContestDisagreement")) {
        return false
    }
    var ep = ir_empty_epistemic_section()
    checker_to_ir_epistemic_into(&checked, &!ep)
