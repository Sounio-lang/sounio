fn kn_seed_named_model_family(checker: Checker, name: Name) -> Checker with Mut, Panic, Div, Alloc {
    var c = checker
    var family = empty_model_family_info()
    family.name = name
    family.model_names[0] = kn_make_name2(77, 49)
    family.model_names[1] = kn_make_name2(77, 50)
    family.model_count = 2
    family.input_ty = ty_i64()
    family.output_ty = ty_i64()
    let family_add = c.model_families.add(family)
    c.model_families = family_add.0
    c.env = c.env.bind(name, ty_model_family(ty_i64(), ty_i64(), family_add.1), false)
    c
}

fn kn_seed_contest_for_policy(checker: Checker, name: Name, policy_id: i64) -> Checker with Mut, Panic, Div, Alloc {
    let family_name = kn_make_name(70, 0, 0, 1)
    var c = kn_seed_named_model_family(checker, family_name)
    let family_ty = c.env.lookup(family_name)
    var info = empty_contest_info()
    info.model_names[0] = kn_make_name2(77, 49)  // M1
    info.model_names[1] = kn_make_name2(77, 50)  // M2
    info.model_count = 2
    info.family_id = family_ty.epistemic_meta_id
    info.policy_id = policy_id
    let add_result = c.contests.add(info)
    c.contests = add_result.0
    c.env = c.env.bind(name, ty_contest(ty_i64(), add_result.1), false)
    c
}

fn kn_seed_contest_with_relative_band(checker: Checker, name: Name, policy_id: i64, value: f64) -> Checker with Mut, Panic, Div, Alloc {
    var c = kn_seed_contest_for_policy(checker, name, policy_id)
    let contest_ty = c.env.lookup(name)
    if contest_ty.epistemic_meta_id >= 0 && contest_ty.epistemic_meta_id < c.contests.count {
        var info = c.contests.get(contest_ty.epistemic_meta_id)
        info = contest_info_set_metric(info, CONTEST_METRIC_RELATIVE_BAND, value)
        c.contests.entries[contest_ty.epistemic_meta_id as usize] = info
    }
    c
}

fn kn_seed_contest_with_core_metrics(checker: Checker, name: Name, policy_id: i64) -> Checker with Mut, Panic, Div, Alloc {
    var c = kn_seed_contest_for_policy(checker, name, policy_id)
    let contest_ty = c.env.lookup(name)
    if contest_ty.epistemic_meta_id >= 0 && contest_ty.epistemic_meta_id < c.contests.count {
        var info = c.contests.get(contest_ty.epistemic_meta_id)
        info = contest_info_set_metric(info, CONTEST_METRIC_SIGN_CONSENSUS, 1.0)
        info = contest_info_set_metric(info, CONTEST_METRIC_RELATIVE_BAND, 0.10)
        info = contest_info_set_metric(info, CONTEST_METRIC_MAX_TAIL_RISK, 0.02)
        info = contest_info_set_metric(info, CONTEST_METRIC_MECHANISTIC_DIVERGENCE, 0.12)
        info = contest_info_set_metric(info, CONTEST_METRIC_IDENTIFIABILITY_FLOOR, 0.85)
        c.contests.entries[contest_ty.epistemic_meta_id as usize] = info
    }
    c
}

fn kn_attach_mechanistic_report(checker: Checker, contest_name: Name) -> Checker with Mut, Panic, Div, Alloc {
    var c = checker
    let contest_ty = c.env.lookup(contest_name)
    if contest_ty.epistemic_meta_id < 0 || contest_ty.epistemic_meta_id >= c.contests.count {
        return c
    }
    let report = MechanisticReportInfo {
        latent_state_divergence: 0.11,
        causal_decomposition_divergence: 0.12,
        intervention_response_divergence: 0.13,
        parameter_role_divergence: 0.14,
        structural_explanation_distance: 0.15,
        aggregate_divergence: 0.12,
    }
    let add_result = c.mechanistic_reports.add(report)
    c.mechanistic_reports = add_result.0
    var info = c.contests.get(contest_ty.epistemic_meta_id)
    info.mechanistic_report_id = add_result.1
    c.contests.entries[contest_ty.epistemic_meta_id as usize] = info
    c
}

fn kn_attach_counterexample(checker: Checker, contest_name: Name) -> Checker with Mut, Panic, Div, Alloc {
    var c = checker
    let contest_ty = c.env.lookup(contest_name)
    if contest_ty.epistemic_meta_id < 0 || contest_ty.epistemic_meta_id >= c.contests.count {
        return c
    }
    let info = CounterexampleInfo {
        model_name: kn_make_name2(77, 50),
        subgroup_name: kn_name_from_str("renal_impaired"),
        metric_name: kn_name_from_str("tail_risk"),
        observed_value: 0.09,
        threshold_value: 0.05,
        summary: kn_name_from_str("toxic_exposure"),
    }
    let add_result = c.counterexamples.add(info)
    c.counterexamples = add_result.0
    var contest_info = c.contests.get(contest_ty.epistemic_meta_id)
    contest_info.counterexample_id = add_result.1
    c.contests.entries[contest_ty.epistemic_meta_id as usize] = contest_info
    c
}

fn kn_attach_posterior_weights(checker: Checker, contest_name: Name) -> Checker with Mut, Panic, Div, Alloc {
    var c = checker
    let contest_ty = c.env.lookup(contest_name)
    if contest_ty.epistemic_meta_id < 0 || contest_ty.epistemic_meta_id >= c.contests.count {
        return c
    }
    var info = empty_posterior_weights_info()
    info.model_names[0] = kn_make_name2(77, 49)
    info.model_names[1] = kn_make_name2(77, 50)
    info.weights[0] = 0.60
    info.weights[1] = 0.40
    info.count = 2
    let add_result = c.posterior_weights.add(info)
    c.posterior_weights = add_result.0
    var contest_info = c.contests.get(contest_ty.epistemic_meta_id)
    contest_info.posterior_weights_id = add_result.1
    c.contests.entries[contest_ty.epistemic_meta_id as usize] = contest_info
    c
}

fn kn_seed_contest_with_full_witnesses(checker: Checker, name: Name, policy_id: i64) -> Checker with Mut, Panic, Div, Alloc {
    var c = kn_seed_contest_with_core_metrics(checker, name, policy_id)
    c = kn_attach_mechanistic_report(c, name)
    c = kn_attach_counterexample(c, name)
    c = kn_attach_posterior_weights(c, name)
    c
}

fn kn_seed_validation_policy(checker: Checker, name: Name) -> Checker with Mut, Panic, Div, Alloc {
    var c = checker
    let info = ValidationPolicyInfo { name: name, target_ty: ty_i64() }
    let add_result = c.validations.add(info)
    c.validations = add_result.0
    c.env = c.env.bind(name, ty_validation(ty_i64(), add_result.1), false)
    c
}

fn kn_first_item_is_policy_with_requirements(prog: Program, expected_count: i64) -> bool with Mut, Panic, Div, Alloc {
    match prog.items {
        Some(list) => {
            if (*list).head.kind != ItemKind::ItemPolicy { return false }
            match (*list).head.policy_def {
                Some(pd) => kn_policy_requirement_count((*pd).requirements) == expected_count
                None => false
            }
        }
        None => false
    }
}

fn kn_int_expr(val: i64) -> Expr with Mut, Panic, Div {
    Expr {
        kind: ExprKind::ExprIntLit,
        span: Span::dummy(),
        int_val: val,
        float_val: 0.0,
        name: kn_make_name(0, 0, 0, 0),
        path: kn_empty_path(),
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        left: None,
        right: None,
        block: None,
        else_expr: None,
        args: None,
        arms: None,
        fields: None,
        cast_type: None,
        handler_block: None,
    }
}

fn kn_ident_expr(name: Name) -> Expr {
