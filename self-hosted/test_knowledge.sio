// Epistemic Knowledge type tests
//
// Tests covering lexer, parser, and checker integration for
// Knowledge[T, epsilon, validity, provenance] types.
//
// Entry point: run_knowledge_tests()

// ============================================================================
// AST HELPERS (kn_ prefix to avoid collisions)
// Must precede callers (Sounio forward-ref constraint).
// ============================================================================

fn kn_make_name(a: i8, b: i8, c: i8, count: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: count }
    n.buf[0] = a
    if count > 1 { n.buf[1] = b }
    if count > 2 { n.buf[2] = c }
    n
}

fn kn_make_name4(a: i8, b: i8, c: i8, d: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 4 }
    n.buf[0] = a
    n.buf[1] = b
    n.buf[2] = c
    n.buf[3] = d
    n
}

fn kn_make_name2(a: i8, b: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 2 }
    n.buf[0] = a
    n.buf[1] = b
    n
}

fn kn_make_name12(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8, h: i8, i: i8, j: i8, k: i8, l: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 12 }
    n.buf[0] = a
    n.buf[1] = b
    n.buf[2] = c
    n.buf[3] = d
    n.buf[4] = e
    n.buf[5] = f
    n.buf[6] = g
    n.buf[7] = h
    n.buf[8] = i
    n.buf[9] = j
    n.buf[10] = k
    n.buf[11] = l
    n
}

fn kn_make_name17(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8, h: i8, i: i8, j: i8, k: i8, l: i8, m: i8, n0: i8, o: i8, p: i8, q: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 17 }
    n.buf[0] = a
    n.buf[1] = b
    n.buf[2] = c
    n.buf[3] = d
    n.buf[4] = e
    n.buf[5] = f
    n.buf[6] = g
    n.buf[7] = h
    n.buf[8] = i
    n.buf[9] = j
    n.buf[10] = k
    n.buf[11] = l
    n.buf[12] = m
    n.buf[13] = n0
    n.buf[14] = o
    n.buf[15] = p
    n.buf[16] = q
    n
}

fn kn_name_from_str(s: string) -> Name with Mut, Panic, Div {
    let len = str_len(s)
    var n = Name { buf: [0; 128], len: len }
    var i: i64 = 0
    while i < len && i < 128 {
        n.buf[i as usize] = str_char_at(s, i) as i8
        i = i + 1
    }
    n
}

fn kn_relative_band_name() -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 13 }
    n.buf[0] = 114   // r
    n.buf[1] = 101   // e
    n.buf[2] = 108   // l
    n.buf[3] = 97    // a
    n.buf[4] = 116   // t
    n.buf[5] = 105   // i
    n.buf[6] = 118   // v
    n.buf[7] = 101   // e
    n.buf[8] = 95    // _
    n.buf[9] = 98    // b
    n.buf[10] = 97   // a
    n.buf[11] = 110  // n
    n.buf[12] = 100  // d
    n
}

fn kn_empty_path() -> AstPath {
    AstPath {
        segments: StringList { head_buf: [0; 128], head_len: 0, tail: None },
        seg_count: 0,
    }
}

fn kn_single_path3(a: i8, b: i8, c: i8) -> AstPath with Mut, Panic, Div {
    var buf: [i8; 128] = [0; 128]
    buf[0] = a
    buf[1] = b
    buf[2] = c
    AstPath {
        segments: StringList { head_buf: buf, head_len: 3, tail: None },
        seg_count: 1,
    }
}

fn kn_named_type3(a: i8, b: i8, c: i8) -> TypeExpr with Mut, Panic, Div {
    TypeExpr {
        kind: TypeExprKind::TypeNamed,
        span: Span::dummy(),
        path: kn_single_path3(a, b, c),
        type_args: None,
        inner: None,
        array_size: None,
        effects: None,
        knowledge_info: None,
        refinement_info: None,
    }
}

fn kn_policy_requirement_relative_band(op: CompareOp, threshold: f64) -> PolicyRequirement {
    PolicyRequirement {
        metric_name: kn_relative_band_name(),
        op: op,
        threshold: threshold,
        span: Span::dummy(),
    }
}

fn kn_policy_item(name: Name, requirements: Option<Box<PolicyRequirementList>>) -> Item with Alloc, Mut, Panic, Div {
    let pdef = PolicyDef {
        name: name,
        target_type: kn_named_type3(105, 54, 52),
        requirements: requirements,
        span: Span::dummy(),
    }
    Item {
        kind: ItemKind::ItemPolicy,
        span: Span::dummy(),
        is_pub: false,
        name: name,
        fn_def: None,
        struct_def: None,
        enum_def: None,
        impl_def: None,
        type_alias_ty: None,
        policy_def: Some(Box::new(pdef)),
        use_path: kn_empty_path(),
        use_glob: false,
        use_items: None,
    }
}

fn kn_empty_policy_source() -> [i8; 256] with Mut, Panic, Div {
    var input: [i8; 256] = [0; 256]
    input[0] = 112   // p
    input[1] = 111   // o
    input[2] = 108   // l
    input[3] = 105   // i
    input[4] = 99    // c
    input[5] = 121   // y
    input[6] = 32    // space
    input[7] = 80    // P
    input[8] = 32    // space
    input[9] = 102   // f
    input[10] = 111  // o
    input[11] = 114  // r
    input[12] = 32   // space
    input[13] = 105  // i
    input[14] = 54   // 6
    input[15] = 52   // 4
    input[16] = 32   // space
    input[17] = 123  // {
    input[18] = 125  // }
    input
}

fn kn_parse_program_from_ascii(input: [i8; 256], len: i64) -> Program with Mut, IO, Panic, Div, Alloc {
    var source: [i8; 1048576] = [0; 1048576]
    var i: i64 = 0
    while i < len {
        source[i as usize] = input[i as usize]
        i = i + 1
    }
    let state = lex(source, len, 0)
    parse_program(state.tokens, state.token_count)
}

fn kn_policy_requirement_count(opt: Option<Box<PolicyRequirementList>>) -> i64 with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => 1 + kn_policy_requirement_count((*list).tail)
        None => 0
    }
}

fn kn_seed_empty_policy(checker: Checker, name: Name) -> Checker with Mut, Panic, Div, Alloc {
    var c = checker
    let info = PolicyInfo {
        name: name,
        target_ty: ty_i64(),
        level_name: kn_make_name(0, 0, 0, 0),
        scope_name: kn_make_name(0, 0, 0, 0),
        level_id: ROBUST_LEVEL_STABLE,
        scope_id: ROBUST_SCOPE_IN_DISTRIBUTION,
        requirements: None,
        requirement_count: 0,
    }
    let add_result = c.policies.add(info)
    c.policies = add_result.0
    c.env = c.env.bind(name, ty_policy(ty_i64(), add_result.1), false)
    c
}

fn kn_seed_relative_band_policy(checker: Checker, name: Name, op: CompareOp, threshold: f64) -> Checker with Mut, Panic, Div, Alloc {
    var c = checker
    let req = PolicyRequirementInfo {
        metric_id: CONTEST_METRIC_RELATIVE_BAND,
        metric_name: kn_relative_band_name(),
        op: op,
        threshold: threshold,
    }
    let info = PolicyInfo {
        name: name,
        target_ty: ty_i64(),
        level_name: kn_make_name(0, 0, 0, 0),
        scope_name: kn_make_name(0, 0, 0, 0),
        level_id: ROBUST_LEVEL_STABLE,
        scope_id: ROBUST_SCOPE_IN_DISTRIBUTION,
        requirements: Some(Box::new(PolicyRequirementInfoList { head: req, tail: None })),
        requirement_count: 1,
    }
    let add_result = c.policies.add(info)
    c.policies = add_result.0
    c.env = c.env.bind(name, ty_policy(ty_i64(), add_result.1), false)
    c
}

