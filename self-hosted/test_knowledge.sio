// T19: Robust<T> does not implicitly coerce to Validated<T>
fn kn_test_robust_not_validated() -> bool with Mut, Panic, Div, Alloc, IO {
    let contest_name = kn_make_name(99, 0, 0, 1)  // "c"
    let policy_name = kn_make_name(112, 0, 0, 1)  // "p"
    let validated_name = kn_make_name(118, 0, 0, 1)  // "v"
    let prove_name = kn_make_name12(112, 114, 111, 118, 101, 95, 114, 111, 98, 117, 115, 116)  // "prove_robust"
    var checker = checker_new()
    checker = kn_seed_empty_policy(checker, policy_name)
    let policy_ty = checker.env.lookup(policy_name)
    checker = kn_seed_contest_for_policy(checker, contest_name, policy_ty.epistemic_meta_id)
    let stmt = Stmt {
        kind: StmtKind::StmtLet,
        span: Span::dummy(),
        name: validated_name,
        ty: Some(Box::new(kn_validated_type_expr(kn_named_type3(105, 54, 52)))),
        expr: Some(Box::new(kn_call_expr2(prove_name, kn_ident_expr(contest_name), kn_ident_expr(policy_name)))),
        target: None,
        assign_op: AssignOp::AssignEq,
    }
    let pair = checker.check_let_stmt(stmt)
    pair.0.error_count > 0
}

// T20: Parse policy item syntax into ItemPolicy
fn kn_test_parse_policy_item() -> bool with Mut, Panic, Div, Alloc, IO {
    let input = kn_empty_policy_source()
    let prog = kn_parse_program_from_ascii(input, 19)
    kn_first_item_is_policy_with_requirements(prog, 0)
}

// T21: Collect policy items into named Policy<T> bindings
fn kn_test_collect_policy_item_binds_named_policy() -> bool with Mut, Panic, Div, Alloc, IO {
    let input = kn_empty_policy_source()
    let prog = kn_parse_program_from_ascii(input, 19)
    var checker = checker_new()
    checker = checker.collect_items(prog.items)
    let policy_ty = checker.env.lookup(kn_make_name(80, 0, 0, 1))
    checker.error_count == 0 &&
    checker.policies.count == 1 &&
    policy_ty.kind == TypeKind::TyPolicy &&
    knowledge_inner(policy_ty).kind == TypeKind::TyI64 &&
    policy_ty.epistemic_meta_id == 0
}

// T22: prove_robust fails closed when policy obligations need missing diagnostics
