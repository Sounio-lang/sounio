            epsilon: None,
            validity: None,
            provenance: None,
        })),
        refinement_info: None,
    }
    let pair = checker_new().lower_type_expr(te)
    let checked = pair.0
    let ty = pair.1
    checked.error_count == 0 &&
    ty.kind == TypeKind::TyKnowledge &&
    knowledge_inner(ty).kind == TypeKind::TyI64 &&
    ty.knowledge_epsilon < 0.0
}

