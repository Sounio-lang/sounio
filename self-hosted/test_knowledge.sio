    ep.posterior_weights_count == 1 &&
    ep.counterexample_count == 1 &&
    ep.contest_witness_count == 1 &&
    ep.contest_witnesses[0].contest_id == contest_ty.epistemic_meta_id &&
    ep.contest_witnesses[0].witness_kind == 5
}

