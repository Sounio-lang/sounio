fn kn_test_admit_action_records_decision_certificate() -> bool with Mut, Panic, Div, Alloc, IO {
    let contest_name = kn_make_name(99, 0, 0, 1)
    let policy_name = kn_make_name(112, 0, 0, 1)
    let decision_name = kn_make_name2(100, 112)
    let prove_name = kn_make_name12(112, 114, 111, 118, 101, 95, 114, 111, 98, 117, 115, 116)
    let admit_name = kn_name_from_str("admit_action")
    var checker = checker_new()
    checker = kn_seed_relative_band_policy(checker, policy_name, CompareOp::CmpLe, 0.15)
    checker = kn_seed_relative_band_decision_policy(checker, decision_name, CompareOp::CmpLe, 0.15)
    let policy_ty = checker.env.lookup(policy_name)
    let decision_ty = checker.env.lookup(decision_name)
    checker = kn_seed_contest_with_relative_band(checker, contest_name, policy_ty.epistemic_meta_id, 0.10)
    let robust_expr = kn_call_expr2(prove_name, kn_ident_expr(contest_name), kn_ident_expr(policy_name))
    let admit_expr = kn_call_expr3(admit_name, kn_int_expr(1), robust_expr, kn_ident_expr(decision_name))
    let pair = checker.check_expr(admit_expr)
    let checked = pair.0
    let ty = pair.1
    if checked.error_count > 0 || ty.kind != TypeKind::TyAdmissible || checked.robust_proofs.count != 1 || checked.decision_certificates.count != 1 {
        return false
    }
    let cert = checked.decision_certificates.get(0)
    cert.robust_proof_id == 0 &&
    cert.decision_policy_id == decision_ty.epistemic_meta_id &&
    cert.inner_ty.kind == TypeKind::TyI64 &&
    cert.metric_known[CONTEST_METRIC_RELATIVE_BAND as usize] == 1 &&
    cert.metric_values[CONTEST_METRIC_RELATIVE_BAND as usize] == 0.10 &&
    ty.epistemic_meta_id == 0
}

fn kn_test_check_result_to_ir_exports_decision_artifacts() -> bool with Mut, Panic, Div, Alloc, IO {
    let contest_name = kn_make_name(99, 0, 0, 1)
    let policy_name = kn_make_name(112, 0, 0, 1)
    let decision_name = kn_make_name2(100, 112)
    let prove_name = kn_make_name12(112, 114, 111, 118, 101, 95, 114, 111, 98, 117, 115, 116)
    let admit_name = kn_name_from_str("admit_action")
    var checker = checker_new()
    checker = kn_seed_relative_band_policy(checker, policy_name, CompareOp::CmpLe, 0.15)
    checker = kn_seed_relative_band_decision_policy(checker, decision_name, CompareOp::CmpLe, 0.15)
    let policy_ty = checker.env.lookup(policy_name)
    checker = kn_seed_contest_with_relative_band(checker, contest_name, policy_ty.epistemic_meta_id, 0.10)
    let robust_expr = kn_call_expr2(prove_name, kn_ident_expr(contest_name), kn_ident_expr(policy_name))
    let admit_expr = kn_call_expr3(admit_name, kn_int_expr(1), robust_expr, kn_ident_expr(decision_name))
    let pair = checker.check_expr(admit_expr)
    let checked = pair.0
    if checked.error_count > 0 {
        return false
    }
    var ep = ir_empty_epistemic_section()
    checker_to_ir_epistemic_into(&checked, &!ep)
    ep.policy_count == 1 &&
    ep.decision_policy_count == 1 &&
    ep.contest_count == 1 &&
    ep.robust_proof_count == 1 &&
    ep.decision_certificate_count == 1 &&
    ep.robust_proofs[0].contest_id == 0 &&
    ep.decision_certificates[0].robust_proof_id == 0 &&
    ep.decision_certificates[0].decision_policy_id == 0
}

fn kn_test_robust_not_admissible() -> bool with Mut, Panic, Div, Alloc, IO {
    let contest_name = kn_make_name(99, 0, 0, 1)
    let policy_name = kn_make_name(112, 0, 0, 1)
    let admitted_name = kn_make_name(97, 0, 0, 1)
    let prove_name = kn_make_name12(112, 114, 111, 118, 101, 95, 114, 111, 98, 117, 115, 116)
    var checker = checker_new()
    checker = kn_seed_relative_band_policy(checker, policy_name, CompareOp::CmpLe, 0.15)
    let policy_ty = checker.env.lookup(policy_name)
    checker = kn_seed_contest_with_relative_band(checker, contest_name, policy_ty.epistemic_meta_id, 0.10)
    let stmt = Stmt {
        kind: StmtKind::StmtLet,
        span: Span::dummy(),
        name: admitted_name,
        ty: Some(Box::new(kn_admissible_type_expr(kn_named_type3(105, 54, 52)))),
        expr: Some(Box::new(kn_call_expr2(prove_name, kn_ident_expr(contest_name), kn_ident_expr(policy_name)))),
        target: None,
        assign_op: AssignOp::AssignEq,
    }
    let pair = checker.check_let_stmt(stmt)
    pair.0.error_count > 0
}

fn kn_test_defer_action_records_deferred_certificate() -> bool with Mut, Panic, Div, Alloc, IO {
    let contest_name = kn_make_name(99, 0, 0, 1)
    let policy_name = kn_make_name(112, 0, 0, 1)
    let deferral_name = kn_make_name2(100, 102)
    let defer_name = kn_name_from_str("defer_action")
    var checker = checker_new()
    checker = kn_seed_empty_policy(checker, policy_name)
    checker = kn_seed_relative_band_deferral_policy(checker, deferral_name, CompareOp::CmpGe, 0.20)
    let policy_ty = checker.env.lookup(policy_name)
    let deferral_ty = checker.env.lookup(deferral_name)
    checker = kn_seed_contest_with_relative_band(checker, contest_name, policy_ty.epistemic_meta_id, 0.25)
    let expr = kn_call_expr3(defer_name, kn_int_expr(1), kn_ident_expr(contest_name), kn_ident_expr(deferral_name))
    let pair = checker.check_expr(expr)
    let checked = pair.0
    let ty = pair.1
    if checked.error_count > 0 || ty.kind != TypeKind::TyDeferred || checked.deferred_certificates.count != 1 {
        return false
    }
    let cert = checked.deferred_certificates.get(0)
    cert.deferral_policy_id == deferral_ty.epistemic_meta_id &&
    cert.evidence_kind == DEFERRAL_EVIDENCE_CONTEST &&
    cert.contest_id == 0 &&
    cert.robust_proof_id == -1 &&
    cert.reason_code == DEFERRAL_REASON_STRUCTURAL_DISAGREEMENT &&
    ty.epistemic_meta_id == 0
}

fn kn_test_deferral_reason_records_witness_and_ir() -> bool with Mut, Panic, Div, Alloc, IO {
    let contest_name = kn_make_name(99, 0, 0, 1)
    let policy_name = kn_make_name(112, 0, 0, 1)
    let deferral_name = kn_name_from_str("df")
    let prove_name = kn_make_name12(112, 114, 111, 118, 101, 95, 114, 111, 98, 117, 115, 116)
    let defer_name = kn_name_from_str("defer_action")
    let reason_name = kn_name_from_str("deferral_reason")
    var checker = checker_new()
    checker = kn_seed_relative_band_policy(checker, policy_name, CompareOp::CmpLe, 0.15)
    checker = kn_seed_relative_band_deferral_policy(checker, deferral_name, CompareOp::CmpLe, 0.15)
    let policy_ty = checker.env.lookup(policy_name)
    let deferral_ty = checker.env.lookup(deferral_name)
    checker = kn_seed_contest_with_relative_band(checker, contest_name, policy_ty.epistemic_meta_id, 0.10)
    let robust_expr = kn_call_expr2(prove_name, kn_ident_expr(contest_name), kn_ident_expr(policy_name))
    let defer_expr = kn_call_expr3(defer_name, kn_int_expr(1), robust_expr, kn_ident_expr(deferral_name))
    let pair = checker.check_expr(kn_call_expr1(reason_name, defer_expr))
    let checked = pair.0
    let ty = pair.1
    if checked.error_count > 0
        || ty.kind != TypeKind::TyNamed
        || !name_eq(ty.name, kn_name_from_str("DeferralReason"))
        || checked.deferred_certificates.count != 1
        || checked.deferred_reason_witnesses.count != 1 {
        return false
    }
    let cert = checked.deferred_certificates.get(0)
    var ep = ir_empty_epistemic_section()
    checker_to_ir_epistemic_into(&checked, &!ep)
    cert.deferral_policy_id == deferral_ty.epistemic_meta_id &&
    cert.evidence_kind == DEFERRAL_EVIDENCE_ROBUST &&
    cert.robust_proof_id == 0 &&
    ep.deferral_policy_count == 1 &&
    ep.deferred_certificate_count == 1 &&
    ep.deferred_reason_witness_count == 1 &&
    ep.deferred_certificates[0].deferral_policy_id == 0
}

