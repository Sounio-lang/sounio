// T24: prove_robust materializes a proof-carrying record for later audit lowering
fn kn_test_prove_robust_records_proof() -> bool with Mut, Panic, Div, Alloc, IO {
    let contest_name = kn_make_name(99, 0, 0, 1)
    let policy_name = kn_make_name(112, 0, 0, 1)
    let prove_name = kn_make_name12(112, 114, 111, 118, 101, 95, 114, 111, 98, 117, 115, 116)
    var checker = checker_new()
    checker = kn_seed_relative_band_policy(checker, policy_name, CompareOp::CmpLe, 0.15)
    let policy_ty = checker.env.lookup(policy_name)
    checker = kn_seed_contest_with_relative_band(checker, contest_name, policy_ty.epistemic_meta_id, 0.10)
    let contest_ty = checker.env.lookup(contest_name)
    let expr = kn_call_expr2(prove_name, kn_ident_expr(contest_name), kn_ident_expr(policy_name))
    let pair = checker.check_expr(expr)
    let checked = pair.0
    let ty = pair.1
    if checked.error_count > 0 || ty.kind != TypeKind::TyRobust || checked.robust_proofs.count != 1 {
        return false
    }
    let proof_info = checked.robust_proofs.get(0)
    proof_info.contest_id == contest_ty.epistemic_meta_id &&
    proof_info.policy_id == policy_ty.epistemic_meta_id &&
    proof_info.level_id == ROBUST_LEVEL_STABLE &&
    proof_info.scope_id == ROBUST_SCOPE_IN_DISTRIBUTION &&
    proof_info.metric_known[CONTEST_METRIC_RELATIVE_BAND as usize] == 1 &&
    proof_info.metric_values[CONTEST_METRIC_RELATIVE_BAND as usize] == 0.10 &&
    ty.epistemic_meta_id == 0
}

// T25: validate_manifest materializes a validation manifest linked to a robust proof
fn kn_test_validate_manifest_records_manifest() -> bool with Mut, Panic, Div, Alloc, IO {
    let contest_name = kn_make_name(99, 0, 0, 1)
    let policy_name = kn_make_name(112, 0, 0, 1)
    let validation_name = kn_make_name(118, 0, 0, 1)
    let prove_name = kn_make_name12(112, 114, 111, 118, 101, 95, 114, 111, 98, 117, 115, 116)
    let validate_name = kn_make_name17(118, 97, 108, 105, 100, 97, 116, 101, 95, 109, 97, 110, 105, 102, 101, 115, 116)
    var checker = checker_new()
    checker = kn_seed_relative_band_policy(checker, policy_name, CompareOp::CmpLe, 0.15)
    let policy_ty = checker.env.lookup(policy_name)
    checker = kn_seed_contest_with_relative_band(checker, contest_name, policy_ty.epistemic_meta_id, 0.10)
    checker = kn_seed_validation_policy(checker, validation_name)
    let validation_ty = checker.env.lookup(validation_name)
    let robust_expr = kn_call_expr2(prove_name, kn_ident_expr(contest_name), kn_ident_expr(policy_name))
    let validate_expr = kn_call_expr2(validate_name, robust_expr, kn_ident_expr(validation_name))
    let pair = checker.check_expr(validate_expr)
    let checked = pair.0
    let ty = pair.1
    if checked.error_count > 0 || ty.kind != TypeKind::TyValidated || checked.validated_manifests.count != 1 || checked.robust_proofs.count != 1 {
        return false
    }
    let manifest_info = checked.validated_manifests.get(0)
    manifest_info.robust_proof_id == 0 &&
    manifest_info.validation_id == validation_ty.epistemic_meta_id &&
    manifest_info.inner_ty.kind == TypeKind::TyI64 &&
    ty.epistemic_meta_id == 0
}

// T26: checker-side proof/validation records are exported into the IR epistemic section
fn kn_test_check_result_to_ir_epistemic() -> bool with Mut, Panic, Div, Alloc, IO {
    let contest_name = kn_make_name(99, 0, 0, 1)
    let policy_name = kn_make_name(112, 0, 0, 1)
    let validation_name = kn_make_name(118, 0, 0, 1)
    let prove_name = kn_make_name12(112, 114, 111, 118, 101, 95, 114, 111, 98, 117, 115, 116)
    let validate_name = kn_make_name17(118, 97, 108, 105, 100, 97, 116, 101, 95, 109, 97, 110, 105, 102, 101, 115, 116)
    var checker = checker_new()
    checker = kn_seed_relative_band_policy(checker, policy_name, CompareOp::CmpLe, 0.15)
    let policy_ty = checker.env.lookup(policy_name)
    checker = kn_seed_contest_with_relative_band(checker, contest_name, policy_ty.epistemic_meta_id, 0.10)
    checker = kn_seed_validation_policy(checker, validation_name)
    let robust_expr = kn_call_expr2(prove_name, kn_ident_expr(contest_name), kn_ident_expr(policy_name))
    let validate_expr = kn_call_expr2(validate_name, robust_expr, kn_ident_expr(validation_name))
    let pair = checker.check_expr(validate_expr)
    let checked = pair.0
    if checked.error_count > 0 {
        return false
    }
    var ep = ir_empty_epistemic_section()
    checker_to_ir_epistemic_into(&checked, &!ep)
    ep.policy_count == 1 &&
    ep.contest_count == 1 &&
    ep.robust_proof_count == 1 &&
    ep.validated_manifest_count == 1 &&
    ep.contests[0].policy_id == 0 &&
    ep.robust_proofs[0].contest_id == 0 &&
    ep.validated_manifests[0].robust_proof_id == 0 &&
    ep.validated_manifests[0].validation_id == 0
}

// T27: full-arity Contest<T, Family, Policy> annotations realize a single contest entry
fn kn_test_full_arity_contest_realizes_single_entry() -> bool with Mut, Panic, Div, Alloc, IO {
    let family_name = kn_make_name(70, 97, 109, 3)  // "Fam"
    let policy_name = kn_make_name(80, 111, 108, 3)  // "Pol"
    let data_name = kn_make_name(100, 97, 116, 3)  // "dat"
    let contest_name = kn_make_name(99, 111, 110, 3)  // "con"
    var checker = checker_new()
    checker = kn_seed_relative_band_policy(checker, policy_name, CompareOp::CmpLe, 0.15)
    checker = kn_seed_named_model_family(checker, family_name)
    checker.env = checker.env.bind(data_name, ty_i64(), false)
    let stmt = Stmt {
        kind: StmtKind::StmtLet,
        span: Span::dummy(),
        name: contest_name,
        ty: Some(Box::new(kn_contest_type_expr3(
            kn_named_type3(105, 54, 52),
            kn_named_type3(70, 97, 109),
            kn_named_type3(80, 111, 108),
        ))),
        expr: Some(Box::new(kn_contest_expr(data_name))),
        target: None,
        assign_op: AssignOp::AssignEq,
    }
    let pair = checker.check_let_stmt(stmt)
    let checked = pair.0
    let ty = checked.env.lookup(contest_name)
    let family_ty = checked.env.lookup(family_name)
    let policy_ty = checked.env.lookup(policy_name)
    checked.error_count == 0 &&
    ty.kind == TypeKind::TyContest &&
    checked.contests.count == 1 &&
    ty.epistemic_meta_id == 0 &&
    checked.contests.get(0).family_id == family_ty.epistemic_meta_id &&
    checked.contests.get(0).policy_id == policy_ty.epistemic_meta_id
}

