// self-hosted::test_parse_real — Parse real .sio source files from disk
//
// Tests P01-P12: Read actual self-hosted source files via read_file/file_size,
// lex + parse them, verify item counts and absence of crashes.
// P09-P12 exercise :: qualified paths and `as` casts (previously caused infinite loops).
//
// Entry point: run_parse_real_tests()

// ============================================================================
// SHARED HELPER: lex + parse from buffer
// ============================================================================

struct RealParseResult {
    token_count: i64,
    item_count: i64,
    lex_error_count: i64,
}

fn real_parse_buf(buf: [i8; 1048576], size: i64) -> RealParseResult with Mut, Div, Panic, Alloc, IO {
    let state = lex(buf, size, 0)
    let prog = parse_program(state.tokens, state.token_count)
    let ic = count_items(prog)
    RealParseResult {
        token_count: state.token_count,
        item_count: ic,
        lex_error_count: state.error_count,
    }
}

// ============================================================================
// TESTS
// ============================================================================

// P01: self-hosted/lexer/span.sio — Smallest file. Parses without crash. Item count > 0.
fn test_P01_parse_span() -> bool with IO, Mut, Div, Panic, Alloc {
    let data = read_file("self-hosted/lexer/span.sio")
    let size = file_size("self-hosted/lexer/span.sio")
    var buf: [i8; 1048576] = [0; 1048576]
    var i: i64 = 0
    while i < size && i < 1048576 {
        buf[i as usize] = data[i as usize]
        i = i + 1
    }
    let r = real_parse_buf(buf, size)
    r.item_count > 0 && r.lex_error_count == 0
}

