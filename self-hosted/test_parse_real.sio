// ============================================================================
// ENTRY POINT
// ============================================================================

fn run_parse_real_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    let total: i64 = 12

    print("=== Parse Real Files Tests ===\n")

    if test_P01_parse_span() { passed = passed + 1; print("  P01 OK: span.sio\n") } else { print("  FAIL: P01 span.sio\n") }
    if test_P02_parse_errors() { passed = passed + 1; print("  P02 OK: errors.sio\n") } else { print("  FAIL: P02 errors.sio\n") }
    if test_P03_parse_env() { passed = passed + 1; print("  P03 OK: env.sio\n") } else { print("  FAIL: P03 env.sio\n") }
    if test_P04_parse_symbol() { passed = passed + 1; print("  P04 OK: symbol.sio\n") } else { print("  FAIL: P04 symbol.sio\n") }
    if test_P05_parse_scope() { passed = passed + 1; print("  P05 OK: scope.sio\n") } else { print("  FAIL: P05 scope.sio\n") }
    if test_P06_parse_check_mod() { passed = passed + 1; print("  P06 OK: check/mod.sio\n") } else { print("  FAIL: P06 check/mod.sio\n") }
    if test_P07_parse_emit_mod() { passed = passed + 1; print("  P07 OK: emit/mod.sio\n") } else { print("  FAIL: P07 emit/mod.sio\n") }
    if test_P08_parse_resolve_mod() { passed = passed + 1; print("  P08 OK: resolve/mod.sio\n") } else { print("  FAIL: P08 resolve/mod.sio\n") }
    if test_P09_parse_stmts() { passed = passed + 1; print("  P09 OK: parser/stmts.sio\n") } else { print("  FAIL: P09 parser/stmts.sio\n") }
    if test_P10_parse_numparse() { passed = passed + 1; print("  P10 OK: lexer/numparse.sio\n") } else { print("  FAIL: P10 lexer/numparse.sio\n") }
    if test_P11_parse_check_types() { passed = passed + 1; print("  P11 OK: check/types.sio\n") } else { print("  FAIL: P11 check/types.sio\n") }
    if test_P12_parse_check_defs() { passed = passed + 1; print("  P12 OK: check/defs.sio\n") } else { print("  FAIL: P12 check/defs.sio\n") }

    print("\nParse real tests: ")
    print_int(passed)
    print("/")
    print_int(total)
    print(" passed\n")

    if passed == total { 0 } else { 1 }
}
