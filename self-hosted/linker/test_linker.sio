// self-hosted::linker::test_linker — IR Module Linker Tests
//
// Tests the linking of multiple IrModule instances into a single module.

// ============================================================================
// Test Helpers
// ============================================================================

fn build_module_add() -> IrModule with Alloc, Mut, Panic, Div {
    // Module A: fn add(a: i64, b: i64) -> i64 { return a + b }
    var module = ir_empty_module()
    module.fn_count = 1

    var func = ir_empty_function()
    func.name = ir_name_from_bytes(97, 100, 100, 0, 3)  // "add"
    func.param_count = 2
    func.param_regs[0] = 0  // a is vreg 0
    func.param_regs[1] = 1  // b is vreg 1
    func.reg_count = 3
    func.instr_count = 3

    // v2 = v0 + v1
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_binop(2, 0, BinaryOp::OpAdd, 1))

    // return v2
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_return(2))

    // Extra nop for padding
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_nop())

    ir_fn_set(&! module, 0, func)
    module
}

fn build_module_main() -> IrModule with Mut, Panic, Div, Alloc {
    // Module B: fn main() -> i64 { return add(10, 32) }  // Returns 42
    var module = ir_empty_module()
    module.fn_count = 1

    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)  // "main"
    func.param_count = 0
    func.reg_count = 3
    func.instr_count = 4

    // v0 = 10
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, 10))

    // v1 = 32
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_load_imm(1, 32))

    // v2 = call add(v0, v1)
    // Build argument list
    let arg0 = ir_reg_list_single(0)
    let args = ir_reg_list_append(arg0, 1)

    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_call(
        2,                              // dst = v2
        -1,                             // fn_id = unresolved (will be patched by linker)
        ir_name_from_bytes(97, 100, 100, 0, 3),  // name = "add"
        Some(Box::new(args)),           // call_args
        2                               // arg_count
    ))

    // return v2
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_return(2))

    ir_fn_set(&! module, 0, func)
    module
}

// ============================================================================
// Tests
// ============================================================================

// T01: Link two modules, verify merged function count
fn test_link_two_modules() -> i64 with Mut, Panic, Div, Alloc {
    let module_a = build_module_add()
    let module_b = build_module_main()

    var modules: [IrModule; 64] = [ir_empty_module(); 64]
    modules[0] = module_a
    modules[1] = module_b

    let result = link_modules(modules, 2)

    if !result.ok { return 1 }
    if result.module.fn_count != 2 { return 2 }

    // Verify function names
    if !ir_name_eq(ir_fn_get(&result.module, 0).name, ir_name_from_bytes(97, 100, 100, 0, 3)) {
        return 3  // First function should be "add"
    }
    if !ir_name_eq(ir_fn_get(&result.module, 1).name, ir_name_from_bytes(109, 97, 105, 110, 4)) {
        return 4  // Second function should be "main"
    }

    0
}

// T02: Verify call instruction is patched with correct fn_id
fn test_call_patching() -> i64 with Mut, Panic, Div, Alloc {
    let module_a = build_module_add()
    let module_b = build_module_main()

    var modules: [IrModule; 64] = [ir_empty_module(); 64]
    modules[0] = module_a
    modules[1] = module_b

    let result = link_modules(modules, 2)

    if !result.ok { return 1 }

    // Check the call instruction in main (function 1, instruction 2)
    let main_func = ir_fn_get(&result.module, 1)
    let call_instr = ir_arena_load(ir_region_slot_r(main_func.region, (2)))

    if call_instr.op != IrOpcode::IrCall { return 2 }

    // fn_id should now be 0 (index of "add" function)
    if call_instr.fn_id != 0 { return 3 }

    0
}

// T03: Link empty modules (error case)
fn test_link_empty() -> i64 with Mut, Panic, Div, Alloc {
    var modules: [IrModule; 64] = [ir_empty_module(); 64]
    let result = link_modules(modules, 0)

    if result.ok { return 1 }  // Should fail
    if result.error_count != 1 { return 2 }

    0
}

// T04: Link three modules with transitive calls
fn test_link_three_modules() -> i64 with Mut, Panic, Div, Alloc {
    // Module A: fn double(x: i64) -> i64 { x + x }
    var module_a = ir_empty_module()
    module_a.fn_count = 1
    var func_a = ir_empty_function()
    func_a.name = ir_name_from_bytes(100, 111, 117, 98, 6)  // "double"
    func_a.param_count = 1
    func_a.param_regs[0] = 0
    func_a.reg_count = 2
    func_a.instr_count = 2
    ir_arena_store(ir_region_slot_w(func_a.region, (0)), ir_binop(1, 0, BinaryOp::OpAdd, 0)) // v1 = v0 + v0
    ir_arena_store(ir_region_slot_w(func_a.region, (1)), ir_return(1))
    ir_fn_set(&! module_a, 0, func_a)

    // Module B: fn quad(x: i64) -> i64 { double(double(x)) }
    var module_b = ir_empty_module()
    module_b.fn_count = 1
    var func_b = ir_empty_function()
    func_b.name = ir_name_from_bytes(113, 117, 97, 100, 4)  // "quad"
    func_b.param_count = 1
    func_b.param_regs[0] = 0
    func_b.reg_count = 3
    func_b.instr_count = 3

    // v1 = call double(v0)
    let args1 = ir_reg_list_single(0)
    ir_arena_store(ir_region_slot_w(func_b.region, (0)), ir_call(
        1, -1,
        ir_name_from_bytes(100, 111, 117, 98, 6),
        Some(Box::new(args1)),
        1
    ))

    // v2 = call double(v1)
    let args2 = ir_reg_list_single(1)
    ir_arena_store(ir_region_slot_w(func_b.region, (1)), ir_call(
        2, -1,
        ir_name_from_bytes(100, 111, 117, 98, 6),
        Some(Box::new(args2)),
        1
    ))

    // return v2
    ir_arena_store(ir_region_slot_w(func_b.region, (2)), ir_return(2))
    ir_fn_set(&! module_b, 0, func_b)

    // Module C: fn main() -> i64 { quad(10) }  // Returns 40
    var module_c = ir_empty_module()
    module_c.fn_count = 1
    var func_c = ir_empty_function()
    func_c.name = ir_name_from_bytes(109, 97, 105, 110, 4)  // "main"
    func_c.param_count = 0
    func_c.reg_count = 2
    func_c.instr_count = 3

    // v0 = 10
    ir_arena_store(ir_region_slot_w(func_c.region, (0)), ir_load_imm(0, 10))

    // v1 = call quad(v0)
    let args3 = ir_reg_list_single(0)
    ir_arena_store(ir_region_slot_w(func_c.region, (1)), ir_call(
        1, -1,
        ir_name_from_bytes(113, 117, 97, 100, 4),
        Some(Box::new(args3)),
        1
    ))

    // return v1
    ir_arena_store(ir_region_slot_w(func_c.region, (2)), ir_return(1))
    ir_fn_set(&! module_c, 0, func_c)

    // Link all three
    var modules: [IrModule; 64] = [ir_empty_module(); 64]
    modules[0] = module_a
    modules[1] = module_b
    modules[2] = module_c

    let result = link_modules(modules, 3)

    if !result.ok { return 1 }
    if result.module.fn_count != 3 { return 2 }

    // Verify all calls are patched correctly
    // quad's first call to double should reference fn 0
    if IR_A_FN_ID[(ir_region_slot_r(ir_fn_get(&result.module, 1).region, (0))) as usize] != 0 { return 3 }
    // quad's second call to double should also reference fn 0
    if IR_A_FN_ID[(ir_region_slot_r(ir_fn_get(&result.module, 1).region, (1))) as usize] != 0 { return 4 }
    // main's call to quad should reference fn 1
    if IR_A_FN_ID[(ir_region_slot_r(ir_fn_get(&result.module, 2).region, (1))) as usize] != 1 { return 5 }

    0
}

// ============================================================================
// Main Test Runner
// ============================================================================

fn test_linker_main() -> i64 with Mut, Panic, Div, Alloc {
    var failed: i64 = 0

    if test_link_two_modules() != 0 { failed = failed + 1 }
    if test_call_patching() != 0 { failed = failed + 1 }
    if test_link_empty() != 0 { failed = failed + 1 }
    if test_link_three_modules() != 0 { failed = failed + 1 }

    if failed == 0 { 0 } else { 1 }
}
