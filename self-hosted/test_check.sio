// Statement helpers

fn tc_let_stmt(name: Name, init: Expr) -> Stmt with Alloc {
    Stmt {
        kind: StmtKind::StmtLet,
        span: Span::dummy(),
        name: name,
        ty: None,
        expr: Some(Box::new(init)),
        target: None,
        assign_op: AssignOp::AssignEq,
    }
}

fn tc_let_typed_stmt(name: Name, ty: TypeExpr, init: Expr) -> Stmt with Alloc {
    Stmt {
        kind: StmtKind::StmtLet,
        span: Span::dummy(),
        name: name,
        ty: Some(Box::new(ty)),
        expr: Some(Box::new(init)),
        target: None,
        assign_op: AssignOp::AssignEq,
    }
}

fn tc_var_stmt(name: Name, init: Expr) -> Stmt with Alloc {
    Stmt {
        kind: StmtKind::StmtVar,
        span: Span::dummy(),
        name: name,
        ty: None,
        expr: Some(Box::new(init)),
        target: None,
        assign_op: AssignOp::AssignEq,
    }
}

fn tc_expr_stmt(e: Expr) -> Stmt with Mut, Panic, Div, Alloc {
    Stmt {
        kind: StmtKind::StmtExpr,
        span: Span::dummy(),
        name: tc_make_name(0, 0, 0, 0),
        ty: None,
        expr: Some(Box::new(e)),
        target: None,
        assign_op: AssignOp::AssignEq,
    }
}

fn tc_assign_stmt(target: Expr, val: Expr) -> Stmt with Mut, Panic, Div, Alloc {
    Stmt {
        kind: StmtKind::StmtAssign,
        span: Span::dummy(),
        name: tc_make_name(0, 0, 0, 0),
        ty: None,
        expr: Some(Box::new(val)),
        target: Some(Box::new(target)),
        assign_op: AssignOp::AssignEq,
    }
}

// Block helpers

fn tc_block1(s1: Stmt) -> Block with Alloc {
    Block {
        stmts: Some(Box::new(StmtList { head: s1, tail: None })),
        span: Span::dummy(),
    }
}

fn tc_block2(s1: Stmt, s2: Stmt) -> Block with Alloc {
    Block {
        stmts: Some(Box::new(StmtList {
            head: s1,
            tail: Some(Box::new(StmtList { head: s2, tail: None })),
        })),
        span: Span::dummy(),
    }
}

fn tc_block3(s1: Stmt, s2: Stmt, s3: Stmt) -> Block with Alloc {
    Block {
        stmts: Some(Box::new(StmtList {
            head: s1,
            tail: Some(Box::new(StmtList {
                head: s2,
                tail: Some(Box::new(StmtList { head: s3, tail: None })),
            })),
        })),
        span: Span::dummy(),
    }
}

// Item helpers
// ASCII: 'i'=105, '6'=54, '4'=52, 'f'=102, 'b'=98, 'o'=111, 'l'=108

fn tc_i64_type() -> TypeExpr with Mut, Panic, Div {
    tc_named_type(105, 54, 52, 3)
}

fn tc_f64_type() -> TypeExpr with Mut, Panic, Div {
    tc_named_type(102, 54, 52, 3)
}

fn tc_bool_type() -> TypeExpr with Mut, Panic, Div {
    tc_named_type4(98, 111, 111, 108)
}

fn tc_fn_item(name: Name, params: Option<Box<ParamList>>, ret_ty: Option<Box<TypeExpr>>, body: Block) -> Item with Alloc {
    let fd = FnDef {
        name: name,
        params: params,
        return_type: ret_ty,
        effects: None,
        body: body,
        span: Span::dummy(),
        is_kernel: false,
        is_extern: false,
    }
    Item {
        kind: ItemKind::ItemFn,
        span: Span::dummy(),
        is_pub: false,
        name: name,
        fn_def: Some(Box::new(fd)),
        struct_def: None,
        enum_def: None,
        impl_def: None,
        type_alias_ty: None,
        policy_def: None,
        deferral_policy_def: None,
        use_path: tc_empty_path(),
        use_glob: false,
        use_items: None,
    }
}

fn tc_struct_item(name: Name, fields: Option<Box<FieldDefList>>) -> Item with Alloc {
    let sd = StructDef {
        name: name,
        type_params: None,
        fields: fields,
        is_linear: false,
        is_affine: false,
        span: Span::dummy(),
    }
    Item {
        kind: ItemKind::ItemStruct,
        span: Span::dummy(),
        is_pub: false,
        name: name,
        fn_def: None,
        struct_def: Some(Box::new(sd)),
        enum_def: None,
        impl_def: None,
        type_alias_ty: None,
        policy_def: None,
        deferral_policy_def: None,
        use_path: tc_empty_path(),
        use_glob: false,
        use_items: None,
    }
}

fn tc_impl_item(target_type: TypeExpr, methods: Option<Box<ItemList>>) -> Item with Mut, Panic, Div, Alloc {
    let id = ImplDef {
        target_type: target_type,
        methods: methods,
        span: Span::dummy(),
    }
    Item {
        kind: ItemKind::ItemImpl,
        span: Span::dummy(),
        is_pub: false,
        name: tc_make_name(0, 0, 0, 0),
        fn_def: None,
        struct_def: None,
        enum_def: None,
        impl_def: Some(Box::new(id)),
        type_alias_ty: None,
        policy_def: None,
        deferral_policy_def: None,
        use_path: tc_empty_path(),
        use_glob: false,
        use_items: None,
    }
}

fn tc_program(items: Option<Box<ItemList>>) -> Program {
    Program { module_path: tc_empty_path(), items: items }
}

fn tc_single_item(item: Item) -> Program with Alloc {
    Program { module_path: tc_empty_path(), items: Some(Box::new(ItemList { head: item, tail: None })) }
}

fn tc_two_items(a: Item, b: Item) -> Program with Alloc {
    Program {
        module_path: tc_empty_path(),
        items: Some(Box::new(ItemList {
            head: a,
            tail: Some(Box::new(ItemList { head: b, tail: None })),
        })),
    }
}

fn tc_three_items(a: Item, b: Item, c: Item) -> Program with Alloc {
    Program {
        module_path: tc_empty_path(),
        items: Some(Box::new(ItemList {
            head: a,
            tail: Some(Box::new(ItemList {
                head: b,
                tail: Some(Box::new(ItemList { head: c, tail: None })),
            })),
        })),
    }
}

fn tc_param(name: Name, ty: TypeExpr) -> Param {
    Param { name: name, ty: ty, is_self: false, is_self_mut: false, span: Span::dummy() }
}

fn tc_self_param() -> Param with Mut, Panic, Div {
    Param {
        name: tc_make_name4(115, 101, 108, 102),
        ty: TypeExpr {
            kind: TypeExprKind::TypeSelfUpper,
            span: Span::dummy(),
            path: tc_empty_path(),
            type_args: None,
            inner: None,
            array_size: None,
            effects: None,
            knowledge_info: None,
            refinement_info: None,
        },
        is_self: true,
        is_self_mut: false,
        span: Span::dummy(),
    }
}

