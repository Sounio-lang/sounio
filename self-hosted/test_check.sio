    let elems = Some(Box::new(ExprList {
        head: tc_int_expr(1),
        tail: Some(Box::new(ExprList {
            head: tc_int_expr(2),
            tail: Some(Box::new(ExprList {
                head: tc_int_expr(3),
                tail: None,
            })),
        })),
    }))
    let s1 = tc_let_stmt(name_a, tc_array_lit_expr(elems))
    let idx = tc_index_expr(tc_ident_expr(97, 0, 0, 1), tc_int_expr(0))
