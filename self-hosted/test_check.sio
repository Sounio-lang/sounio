// Helper for i8 type annotation
fn tc_i8_type() -> TypeExpr with Mut, Panic, Div {
    // "i8" = [105, 56]
    var buf: [i8; 128] = [0; 128]
    buf[0] = 105
    buf[1] = 56
    TypeExpr {
        kind: TypeExprKind::TypeNamed,
        span: Span::dummy(),
        path: AstPath {
            segments: StringList { head_buf: buf, head_len: 2, tail: None },
            seg_count: 1,
        },
        type_args: None,
        inner: None,
        array_size: None,
        effects: None,
        knowledge_info: None,
        refinement_info: None,
    }
}

fn tc_i32_type() -> TypeExpr with Mut, Panic, Div {
    // "i32" = [105, 51, 50]
    tc_named_type(105, 51, 50, 3)
}

fn tc_f32_type() -> TypeExpr with Mut, Panic, Div {
    // "f32" = [102, 51, 50]
    tc_named_type(102, 51, 50, 3)
}

fn tc_unary_expr(op: UnaryOp, operand: Expr) -> Expr with Mut, Panic, Div, Alloc {
    Expr {
        kind: ExprKind::ExprUnary,
        span: Span::dummy(),
        int_val: 0,
        float_val: 0.0,
        name: tc_make_name(0, 0, 0, 0),
        path: tc_empty_path(),
        bin_op: BinaryOp::OpAdd,
        un_op: op,
        left: Some(Box::new(operand)),
        right: None,
        block: None,
        else_expr: None,
        args: None,
        arms: None,
        fields: None,
        cast_type: None,
        handler_block: None,
    }
}

fn tc_var_typed_stmt(name: Name, ty: TypeExpr, init: Expr) -> Stmt with Alloc {
    Stmt {
        kind: StmtKind::StmtVar,
        span: Span::dummy(),
        name: name,
        ty: Some(Box::new(ty)),
        expr: Some(Box::new(init)),
        target: None,
        assign_op: AssignOp::AssignEq,
    }
}

fn tc_compound_assign_stmt(target: Expr, op: AssignOp, val: Expr) -> Stmt with Mut, Panic, Div, Alloc {
    Stmt {
        kind: StmtKind::StmtAssign,
        span: Span::dummy(),
        name: tc_make_name(0, 0, 0, 0),
        ty: None,
        expr: Some(Box::new(val)),
        target: Some(Box::new(target)),
        assign_op: op,
    }
}

// T21: let x: i8 = 42 — i8 type recognition
fn tc_test_21() -> bool with Mut, Panic, Div, Alloc, IO {
    let name_x = tc_make_name(120, 0, 0, 1)
    let body = tc_block1(tc_let_typed_stmt(name_x, tc_i8_type(), tc_int_expr(42)))
    let item = tc_fn_item(tc_make_name4(109, 97, 105, 110), None, None, body)
    let result = check_program(tc_single_item(item))
    // i8 != i64, so this should error (int literal infers to i64)
    result.error_count > 0
}

