    // fn main() { let x = if true { 1 } else { 2 } }
    let then_blk = tc_block1(tc_expr_stmt(tc_int_expr(1)))
    let else_blk = tc_block1(tc_expr_stmt(tc_int_expr(2)))
    let else_body = tc_block_expr(else_blk)
    let if_expr = tc_if_else_expr(tc_bool_expr(true), then_blk, else_body)
    let body = tc_block1(tc_let_stmt(tc_make_name(120, 0, 0, 1), if_expr))
    let item = tc_fn_item(tc_make_name4(109, 97, 105, 110), None, None, body)
    let result = check_program(tc_single_item(item))
    result.error_count == 0
}

