// T19: Forward fn ref — two-pass enables it
fn tc_test_19() -> bool with Mut, Panic, Div, Alloc, IO {
    // fn caller() { callee(1) }
    // fn callee(x: i64) { }
    let name_caller = tc_make_name(99, 108, 114, 3)
    let name_callee = tc_make_name(99, 108, 101, 3)
    let call = tc_call_expr(
        tc_ident_expr(99, 108, 101, 3),
        Some(Box::new(ExprList { head: tc_int_expr(1), tail: None }))
    )
    let caller_body = tc_block1(tc_expr_stmt(call))
    let caller_item = tc_fn_item(name_caller, None, None, caller_body)

    let param = tc_param(tc_make_name(120, 0, 0, 1), tc_i64_type())
    let callee_item = tc_fn_item(name_callee, Some(Box::new(ParamList { head: param, tail: None })), None, tc_empty_block())

    let result = check_program(tc_two_items(caller_item, callee_item))
    result.error_count == 0
}

// T20: Method call — impl method resolution
fn tc_test_20() -> bool with Mut, Panic, Div, Alloc, IO {
    // struct Pt { x: i64 }
    // impl Pt { fn get_x(self) -> i64 { self.x } }
    // fn main() { let p = Pt { x: 5 }; p.get_x() }
    let name_pt = tc_make_name(80, 116, 0, 2)
    let name_x = tc_make_name(120, 0, 0, 1)
    // 'g'=103 'e'=101 't'=116
    let name_get_x = tc_make_name5(103, 101, 116, 95, 120)

    // struct Pt { x: i64 }
    let f1 = FieldDef { name: name_x, ty: tc_i64_type(), span: Span::dummy() }
    let struct_item = tc_struct_item(name_pt, Some(Box::new(FieldDefList { head: f1, tail: None })))

    // impl Pt { fn get_x(self) -> i64 { self.x } }
    // 's'=115 'e'=101 'l'=108 'f'=102
    let self_param = tc_self_param()
    let self_access = tc_field_access_expr(tc_ident_expr(115, 101, 108, 4), name_x)
    let method_body = tc_block1(tc_expr_stmt(self_access))
    let method_item = tc_fn_item(name_get_x, Some(Box::new(ParamList { head: self_param, tail: None })), Some(Box::new(tc_i64_type())), method_body)
    let impl_item = tc_impl_item(tc_named_type(80, 116, 0, 2), Some(Box::new(ItemList { head: method_item, tail: None })))

    // fn main() { let p = Pt { x: 5 }; p.get_x() }
    let sfi = StructFieldInit { name: name_x, value: tc_int_expr(5) }
    let lit = tc_struct_lit_expr(tc_single_path(80, 116, 0, 2), Some(Box::new(StructFieldList { head: sfi, tail: None })))
    let s1 = tc_let_stmt(tc_make_name(112, 0, 0, 1), lit)
    let mcall = tc_method_call_expr(tc_ident_expr(112, 0, 0, 1), name_get_x, None)
    let s2 = tc_expr_stmt(mcall)
    let main_body = tc_block2(s1, s2)
    let main_item = tc_fn_item(tc_make_name4(109, 97, 105, 110), None, None, main_body)

    let result = check_program(tc_three_items(struct_item, impl_item, main_item))
    result.error_count == 0
}

