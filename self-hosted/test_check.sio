// T11: Struct literal — struct field types
fn tc_test_11() -> bool with Mut, Panic, Div, Alloc, IO {
    // struct Pt { x: i64, y: i64 }
    // fn main() { Pt { x: 1, y: 2 } }
    // 'P'=80 't'=116
    let name_pt = tc_make_name(80, 116, 0, 2)
    let name_x = tc_make_name(120, 0, 0, 1)
    let name_y = tc_make_name(121, 0, 0, 1)
    let f1 = FieldDef { name: name_x, ty: tc_i64_type(), span: Span::dummy() }
    let f2 = FieldDef { name: name_y, ty: tc_i64_type(), span: Span::dummy() }
    let fields = Some(Box::new(FieldDefList { head: f1, tail: Some(Box::new(FieldDefList { head: f2, tail: None })) }))
    let struct_item = tc_struct_item(name_pt, fields)

    let sfi1 = StructFieldInit { name: name_x, value: tc_int_expr(1) }
    let sfi2 = StructFieldInit { name: name_y, value: tc_int_expr(2) }
    let sfl = Some(Box::new(StructFieldList { head: sfi1, tail: Some(Box::new(StructFieldList { head: sfi2, tail: None })) }))
    let lit = tc_struct_lit_expr(tc_single_path(80, 116, 0, 2), sfl)
    let main_body = tc_block1(tc_expr_stmt(lit))
    let main_item = tc_fn_item(tc_make_name4(109, 97, 105, 110), None, None, main_body)

    let result = check_program(tc_two_items(struct_item, main_item))
    result.error_count == 0
}

// T12: Field access — field type lookup
fn tc_test_12() -> bool with Mut, Panic, Div, Alloc, IO {
    // struct Pt { x: i64 }
    // fn main() { let p = Pt { x: 5 }; let v: i64 = p.x }
    let name_pt = tc_make_name(80, 116, 0, 2)
    let name_x = tc_make_name(120, 0, 0, 1)
    let name_p = tc_make_name(112, 0, 0, 1)
    let name_v = tc_make_name(118, 0, 0, 1)
    let f1 = FieldDef { name: name_x, ty: tc_i64_type(), span: Span::dummy() }
    let fields = Some(Box::new(FieldDefList { head: f1, tail: None }))
    let struct_item = tc_struct_item(name_pt, fields)

    let sfi = StructFieldInit { name: name_x, value: tc_int_expr(5) }
    let lit = tc_struct_lit_expr(tc_single_path(80, 116, 0, 2), Some(Box::new(StructFieldList { head: sfi, tail: None })))
    let s1 = tc_let_stmt(name_p, lit)
    let access = tc_field_access_expr(tc_ident_expr(112, 0, 0, 1), name_x)
    let s2 = tc_let_typed_stmt(name_v, tc_i64_type(), access)
    let main_body = tc_block2(s1, s2)
    let main_item = tc_fn_item(tc_make_name4(109, 97, 105, 110), None, None, main_body)

    let result = check_program(tc_two_items(struct_item, main_item))
    result.error_count == 0
}

// T13: If-else — both branches same type
