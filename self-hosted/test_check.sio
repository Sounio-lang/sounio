fn tc_empty_block() -> Block {
    Block { stmts: None, span: Span::dummy() }
}

fn tc_int_expr(val: i64) -> Expr with Mut, Panic, Div {
    Expr {
        kind: ExprKind::ExprIntLit,
        span: Span::dummy(),
        int_val: val,
        float_val: 0.0,
        name: tc_make_name(0, 0, 0, 0),
        path: tc_empty_path(),
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        left: None,
        right: None,
        block: None,
        else_expr: None,
        args: None,
        arms: None,
        fields: None,
        cast_type: None,
        handler_block: None,
    }
}

