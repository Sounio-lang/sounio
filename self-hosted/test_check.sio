// Type checker integration tests
//
// Constructs AST programs and runs check_program() to verify
// type consistency checking. Entry point: run_check_tests()

// ============================================================================
// AST CONSTRUCTION HELPERS (tc_ prefix)
// ============================================================================

fn tc_make_name(a: i8, b: i8, c: i8, count: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: count }
    n.buf[0] = a
    if count > 1 { n.buf[1] = b }
    if count > 2 { n.buf[2] = c }
    n
}

fn tc_make_name4(a: i8, b: i8, c: i8, d: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 4 }
    n.buf[0] = a
    n.buf[1] = b
    n.buf[2] = c
    n.buf[3] = d
    n
}

fn tc_make_name5(a: i8, b: i8, c: i8, d: i8, e: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 5 }
    n.buf[0] = a
    n.buf[1] = b
    n.buf[2] = c
    n.buf[3] = d
    n.buf[4] = e
    n
}

fn tc_make_name9(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8, h: i8, i: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 9 }
    n.buf[0] = a
    n.buf[1] = b
    n.buf[2] = c
    n.buf[3] = d
    n.buf[4] = e
    n.buf[5] = f
    n.buf[6] = g
    n.buf[7] = h
    n.buf[8] = i
    n
}

fn tc_empty_path() -> AstPath {
    AstPath {
        segments: StringList { head_buf: [0; 128], head_len: 0, tail: None },
        seg_count: 0,
    }
}

fn tc_single_path(a: i8, b: i8, c: i8, count: i64) -> AstPath with Mut, Panic, Div {
    var buf: [i8; 128] = [0; 128]
    buf[0] = a
    if count > 1 { buf[1] = b }
    if count > 2 { buf[2] = c }
    AstPath {
        segments: StringList { head_buf: buf, head_len: count, tail: None },
        seg_count: 1,
    }
}

fn tc_single_path4(a: i8, b: i8, c: i8, d: i8) -> AstPath with Mut, Panic, Div {
    var buf: [i8; 128] = [0; 128]
    buf[0] = a
    buf[1] = b
    buf[2] = c
    buf[3] = d
    AstPath {
        segments: StringList { head_buf: buf, head_len: 4, tail: None },
        seg_count: 1,
    }
}

fn tc_named_type(a: i8, b: i8, c: i8, count: i64) -> TypeExpr with Mut, Panic, Div {
    TypeExpr {
        kind: TypeExprKind::TypeNamed,
        span: Span::dummy(),
        path: tc_single_path(a, b, c, count),
        type_args: None,
        inner: None,
        array_size: None,
        effects: None,
        knowledge_info: None,
        refinement_info: None,
    }
}

fn tc_named_type4(a: i8, b: i8, c: i8, d: i8) -> TypeExpr with Mut, Panic, Div {
    TypeExpr {
        kind: TypeExprKind::TypeNamed,
        span: Span::dummy(),
        path: tc_single_path4(a, b, c, d),
        type_args: None,
        inner: None,
        array_size: None,
        effects: None,
        knowledge_info: None,
        refinement_info: None,
    }
}

fn tc_array_type(elem_ty: TypeExpr, size: i64) -> TypeExpr with Mut, Panic, Div, Alloc {
    TypeExpr {
        kind: TypeExprKind::TypeArray,
        span: Span::dummy(),
        path: tc_empty_path(),
        type_args: None,
        inner: Some(Box::new(elem_ty)),
        array_size: Some(Box::new(tc_int_expr(size))),
        effects: None,
        knowledge_info: None,
        refinement_info: None,
    }
}

fn tc_slice_inner_type(elem_ty: TypeExpr) -> TypeExpr with Mut, Panic, Div, Alloc {
    TypeExpr {
        kind: TypeExprKind::TypeArray,
