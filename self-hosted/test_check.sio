// T31: fn foo(a: i64, b: i64) { }; foo(1) — arity error
fn tc_test_31() -> bool with Mut, Panic, Div, Alloc, IO {
    let name_foo = tc_make_name(102, 111, 111, 3)
    let p1 = tc_param(tc_make_name(97, 0, 0, 1), tc_i64_type())
    let p2 = tc_param(tc_make_name(98, 0, 0, 1), tc_i64_type())
    let params = Some(Box::new(ParamList { head: p1, tail: Some(Box::new(ParamList { head: p2, tail: None })) }))
    let foo_item = tc_fn_item(name_foo, params, None, tc_empty_block())
    let call = tc_call_expr(
        tc_ident_expr(102, 111, 111, 3),
        Some(Box::new(ExprList { head: tc_int_expr(1), tail: None }))
    )
    let main_body = tc_block1(tc_expr_stmt(call))
    let main_item = tc_fn_item(tc_make_name4(109, 97, 105, 110), None, None, main_body)
    let result = check_program(tc_two_items(foo_item, main_item))
    result.error_count > 0
}

// T32: Nested block scoping — inner var doesn't leak
fn tc_test_32() -> bool with Mut, Panic, Div, Alloc, IO {
    // fn main() { { let y = 1 }; let z: i64 = y } — y undefined, z gets error type
    let name_y = tc_make_name(121, 0, 0, 1)
    let name_z = tc_make_name(122, 0, 0, 1)
    let inner_block = tc_block1(tc_let_stmt(name_y, tc_int_expr(1)))
    let s1 = tc_expr_stmt(tc_block_expr(inner_block))
    // y is not visible here — lookup returns ty_error
    let s2 = tc_let_typed_stmt(name_z, tc_i64_type(), tc_ident_expr(121, 0, 0, 1))
    let body = tc_block2(s1, s2)
    let item = tc_fn_item(tc_make_name4(109, 97, 105, 110), None, None, body)
    let result = check_program(tc_single_item(item))
    // ty_error is compatible with anything, so no error generated
    // This tests that scoping works even if not all undefined vars cause errors
    result.error_count == 0
}

// T33: &[T] param + slice_len(&array) coercion
fn tc_test_33() -> bool with Mut, Panic, Div, Alloc, IO {
    let name_len9 = tc_make_name9(115, 108, 105, 99, 101, 95, 108, 101, 110)
    let name_a = tc_make_name(97, 0, 0, 1)
    let name_s = tc_make_name(115, 0, 0, 1)
    let take_param = tc_param(name_s, tc_slice_type(tc_i64_type()))
    let take_body = tc_block1(tc_expr_stmt(
        tc_call_expr(
            tc_ident_name_expr(name_len9),
            Some(Box::new(ExprList { head: tc_ident_expr(115, 0, 0, 1), tail: None }))
        )
    ))
    let take_item = tc_fn_item(tc_make_name4(116, 97, 107, 101), Some(Box::new(ParamList { head: take_param, tail: None })), Some(Box::new(tc_i64_type())), take_body)

    let elems = Some(Box::new(ExprList {
        head: tc_int_expr(1),
        tail: Some(Box::new(ExprList {
            head: tc_int_expr(2),
            tail: Some(Box::new(ExprList {
                head: tc_int_expr(3),
                tail: None,
            })),
        })),
    }))
    let call = tc_call_expr(
        tc_ident_expr(116, 97, 107, 4),
        Some(Box::new(ExprList {
            head: tc_unary_expr(UnaryOp::OpRef, tc_ident_expr(97, 0, 0, 1)),
            tail: None,
        }))
    )
    let main_body = tc_block2(
        tc_let_stmt(name_a, tc_array_lit_expr(elems)),
        tc_expr_stmt(call)
    )
    let main_item = tc_fn_item(tc_make_name4(109, 97, 105, 110), None, None, main_body)

    let result = check_program(tc_two_items(take_item, main_item))
    result.error_count == 0
}

// T34: &![T] param + slice indexing/assignment
fn tc_test_34() -> bool with Mut, Panic, Div, Alloc, IO {
    let name_a = tc_make_name(97, 0, 0, 1)
    let name_s = tc_make_name(115, 0, 0, 1)
    let name_swap = tc_make_name4(115, 119, 97, 112)
    let touch_param = tc_param(name_s, tc_slice_mut_type(tc_i64_type()))
    let assign = tc_assign_stmt(
        tc_index_expr(tc_ident_expr(115, 0, 0, 1), tc_int_expr(0)),
        tc_index_expr(tc_ident_expr(115, 0, 0, 1), tc_int_expr(1))
    )
    let touch_item = tc_fn_item(
        name_swap,
        Some(Box::new(ParamList { head: touch_param, tail: None })),
        None,
        tc_block1(assign)
    )

    let elems = Some(Box::new(ExprList {
        head: tc_int_expr(4),
        tail: Some(Box::new(ExprList {
            head: tc_int_expr(7),
            tail: None,
        })),
    }))
    let main_call = tc_call_expr(
        tc_ident_name_expr(name_swap),
        Some(Box::new(ExprList {
            head: tc_unary_expr(UnaryOp::OpRefMut, tc_ident_expr(97, 0, 0, 1)),
            tail: None,
        }))
    )
    let main_body = tc_block2(
        tc_var_stmt(name_a, tc_array_lit_expr(elems)),
        tc_expr_stmt(main_call)
    )
    let main_item = tc_fn_item(tc_make_name4(109, 97, 105, 110), None, None, main_body)

    let result = check_program(tc_two_items(touch_item, main_item))
    result.error_count == 0
}

// T35: subslice from fixed array and existing slice
fn tc_test_35() -> bool with Mut, Panic, Div, Alloc, IO {
    let name_a = tc_make_name(97, 0, 0, 1)
    let name_s = tc_make_name(115, 0, 0, 1)
    let name_w = tc_make_name(119, 0, 0, 1)
    let slice_param = tc_param(name_s, tc_slice_type(tc_i64_type()))
    let win_init = tc_unary_expr(
        UnaryOp::OpRef,
        tc_index_expr(
            tc_ident_expr(115, 0, 0, 1),
            tc_range_expr(tc_int_expr(0), tc_int_expr(1))
        )
    )
    let inner_body = tc_block2(
        tc_let_stmt(name_w, win_init),
        tc_expr_stmt(tc_method_call_expr(tc_ident_expr(119, 0, 0, 1), tc_make_name(108, 101, 110, 3), None))
    )
    let use_item = tc_fn_item(tc_make_name(117, 115, 101, 3), Some(Box::new(ParamList { head: slice_param, tail: None })), Some(Box::new(tc_i64_type())), inner_body)

    let elems = Some(Box::new(ExprList {
        head: tc_int_expr(9),
        tail: Some(Box::new(ExprList {
            head: tc_int_expr(8),
            tail: Some(Box::new(ExprList {
                head: tc_int_expr(7),
                tail: None,
            })),
        })),
    }))
    let outer_slice = tc_unary_expr(
        UnaryOp::OpRef,
        tc_index_expr(
            tc_ident_expr(97, 0, 0, 1),
            tc_range_expr(tc_int_expr(0), tc_int_expr(2))
        )
    )
    let main_call = tc_call_expr(
        tc_ident_expr(117, 115, 101, 3),
        Some(Box::new(ExprList { head: outer_slice, tail: None }))
    )
    let main_body = tc_block2(
        tc_let_stmt(name_a, tc_array_lit_expr(elems)),
        tc_expr_stmt(main_call)
    )
    let main_item = tc_fn_item(tc_make_name4(109, 97, 105, 110), None, None, main_body)

    let result = check_program(tc_two_items(use_item, main_item))
    result.error_count == 0
}

// T36: slice borrows track the root array name
fn tc_test_36() -> bool with Mut, Panic, Div, Alloc, IO {
    let name_a = tc_make_name(97, 0, 0, 1)
    let name_s = tc_make_name(115, 0, 0, 1)
    let name_t = tc_make_name(116, 0, 0, 1)
    let elems = Some(Box::new(ExprList {
        head: tc_int_expr(1),
        tail: Some(Box::new(ExprList {
            head: tc_int_expr(2),
            tail: Some(Box::new(ExprList {
                head: tc_int_expr(3),
                tail: None,
            })),
        })),
    }))
    let first_slice = tc_unary_expr(
        UnaryOp::OpRefMut,
        tc_index_expr(
            tc_ident_expr(97, 0, 0, 1),
            tc_range_expr(tc_int_expr(0), tc_int_expr(2))
        )
    )
    let second_slice = tc_unary_expr(
        UnaryOp::OpRef,
        tc_index_expr(
            tc_ident_expr(97, 0, 0, 1),
            tc_range_expr(tc_int_expr(1), tc_int_expr(3))
        )
    )
    let body = tc_block3(
        tc_var_stmt(name_a, tc_array_lit_expr(elems)),
        tc_let_stmt(name_s, first_slice),
        tc_let_stmt(name_t, second_slice)
    )
    let item = tc_fn_item(tc_make_name4(109, 97, 105, 110), None, None, body)
    let result = check_program(tc_single_item(item))
    result.error_count > 0
}

// ============================================================================
// ENTRY POINT
// ============================================================================

fn run_check_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    let total: i64 = 36

    print("=== Type Checker Tests ===\n")

    if tc_test_01() { passed = passed + 1; print("  T01 OK: empty program\n") } else { print("  FAIL: T01 empty program\n") }
    if tc_test_02() { passed = passed + 1; print("  T02 OK: let x = 42\n") } else { print("  FAIL: T02 let x = 42\n") }
    if tc_test_03() { passed = passed + 1; print("  T03 OK: let x: i64 = 42\n") } else { print("  FAIL: T03 let x: i64 = 42\n") }
    if tc_test_04() { passed = passed + 1; print("  T04 OK: let x: f64 = 42 -> error\n") } else { print("  FAIL: T04 let x: f64 = 42 -> error\n") }
    if tc_test_05() { passed = passed + 1; print("  T05 OK: bool + variable use\n") } else { print("  FAIL: T05 bool + variable use\n") }
    if tc_test_06() { passed = passed + 1; print("  T06 OK: binary arithmetic\n") } else { print("  FAIL: T06 binary arithmetic\n") }
    if tc_test_07() { passed = passed + 1; print("  T07 OK: param + return\n") } else { print("  FAIL: T07 param + return\n") }
    if tc_test_08() { passed = passed + 1; print("  T08 OK: return mismatch -> error\n") } else { print("  FAIL: T08 return mismatch -> error\n") }
    if tc_test_09() { passed = passed + 1; print("  T09 OK: call arity + types\n") } else { print("  FAIL: T09 call arity + types\n") }
    if tc_test_10() { passed = passed + 1; print("  T10 OK: arg mismatch -> error\n") } else { print("  FAIL: T10 arg mismatch -> error\n") }
    if tc_test_11() { passed = passed + 1; print("  T11 OK: struct literal\n") } else { print("  FAIL: T11 struct literal\n") }
    if tc_test_12() { passed = passed + 1; print("  T12 OK: field access\n") } else { print("  FAIL: T12 field access\n") }
    if tc_test_13() { passed = passed + 1; print("  T13 OK: if-else branches\n") } else { print("  FAIL: T13 if-else branches\n") }
    if tc_test_14() { passed = passed + 1; print("  T14 OK: if cond not bool -> error\n") } else { print("  FAIL: T14 if cond not bool -> error\n") }
    if tc_test_15() { passed = passed + 1; print("  T15 OK: mutable assign\n") } else { print("  FAIL: T15 mutable assign\n") }
    if tc_test_16() { passed = passed + 1; print("  T16 OK: immutable assign -> error\n") } else { print("  FAIL: T16 immutable assign -> error\n") }
    if tc_test_17() { passed = passed + 1; print("  T17 OK: array + index\n") } else { print("  FAIL: T17 array + index\n") }
    if tc_test_18() { passed = passed + 1; print("  T18 OK: while returns unit\n") } else { print("  FAIL: T18 while returns unit\n") }
    if tc_test_19() { passed = passed + 1; print("  T19 OK: forward fn ref\n") } else { print("  FAIL: T19 forward fn ref\n") }
    if tc_test_20() { passed = passed + 1; print("  T20 OK: method call\n") } else { print("  FAIL: T20 method call\n") }
    if tc_test_21() { passed = passed + 1; print("  T21 OK: i8 type mismatch\n") } else { print("  FAIL: T21 i8 type mismatch\n") }
    if tc_test_22() { passed = passed + 1; print("  T22 OK: i32 type mismatch\n") } else { print("  FAIL: T22 i32 type mismatch\n") }
    if tc_test_23() { passed = passed + 1; print("  T23 OK: f32 type mismatch\n") } else { print("  FAIL: T23 f32 type mismatch\n") }
    if tc_test_24() { passed = passed + 1; print("  T24 OK: compound assign +=\n") } else { print("  FAIL: T24 compound assign +=\n") }
    if tc_test_25() { passed = passed + 1; print("  T25 OK: compound += mismatch\n") } else { print("  FAIL: T25 compound += mismatch\n") }
    if tc_test_26() { passed = passed + 1; print("  T26 OK: unary neg int\n") } else { print("  FAIL: T26 unary neg int\n") }
    if tc_test_27() { passed = passed + 1; print("  T27 OK: unary not bool\n") } else { print("  FAIL: T27 unary not bool\n") }
    if tc_test_28() { passed = passed + 1; print("  T28 OK: unary not int -> error\n") } else { print("  FAIL: T28 unary not int -> error\n") }
    if tc_test_29() { passed = passed + 1; print("  T29 OK: string comparison\n") } else { print("  FAIL: T29 string comparison\n") }
    if tc_test_30() { passed = passed + 1; print("  T30 OK: string + int -> error\n") } else { print("  FAIL: T30 string + int -> error\n") }
    if tc_test_31() { passed = passed + 1; print("  T31 OK: arity mismatch\n") } else { print("  FAIL: T31 arity mismatch\n") }
    if tc_test_32() { passed = passed + 1; print("  T32 OK: nested block scoping\n") } else { print("  FAIL: T32 nested block scoping\n") }
    if tc_test_33() { passed = passed + 1; print("  T33 OK: slice_len + shared slice coercion\n") } else { print("  FAIL: T33 slice_len + shared slice coercion\n") }
    if tc_test_34() { passed = passed + 1; print("  T34 OK: mutable slice index assign\n") } else { print("  FAIL: T34 mutable slice index assign\n") }
    if tc_test_35() { passed = passed + 1; print("  T35 OK: subslice from array and slice\n") } else { print("  FAIL: T35 subslice from array and slice\n") }
    if tc_test_36() { passed = passed + 1; print("  T36 OK: subslice borrow root tracking\n") } else { print("  FAIL: T36 subslice borrow root tracking\n") }

    print("\nCheck tests: ")
    print_int(passed)
    print("/")
    print_int(total)
    print(" passed\n")

    if passed == total { 0 } else { 1 }
}
