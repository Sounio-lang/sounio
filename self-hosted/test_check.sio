// T01: Empty program — 0 errors
fn tc_test_01() -> bool with Mut, Panic, Div, Alloc, IO {
    let result = check_program(tc_program(None))
    result.error_count == 0 && !result.had_error
}

// T02: let x = 42 — i64 inference
