// T26: Unary negation on int — OK
fn tc_test_26() -> bool with Mut, Panic, Div, Alloc, IO {
    let neg = tc_unary_expr(UnaryOp::OpNeg, tc_int_expr(42))
    let body = tc_block1(tc_let_stmt(tc_make_name(120, 0, 0, 1), neg))
    let item = tc_fn_item(tc_make_name4(109, 97, 105, 110), None, None, body)
    let result = check_program(tc_single_item(item))
    result.error_count == 0
}

// T27: Unary NOT on bool — OK
