// Narrow bootstrap shims for the knowledge boundary runner.
//
// The focused bootstrap bundle exercises keyword lookup and checker semantics,
// not the full sourcefile parser side channel.

struct LexerState {
    token_count: i64,
}

struct OwnContext {
    count: i64,
}

struct TraitRegistry {
    count: i64,
}

struct TraitDef {
    name: i64,
}

struct ImplRegistry {
    count: i64,
}

fn read_byte() -> i64 with IO {
    0 - 1
}

fn lex(source: [i8; 1048576], source_len: i64, file_id: i64) -> LexerState with Mut, Div, Panic {
    LexerState { token_count: 0 }
}

fn parser_set_token_at(idx: i64, tok: Token) with Mut, Panic {
}

fn parser_set_token_flat(idx: i64, kind: i64, start: i64, end: i64, line: i64, col: i64, int_value: i64) with Mut, Panic {
}

fn own_context_new() -> OwnContext {
    OwnContext { count: 0 }
}

fn trait_registry_new() -> TraitRegistry {
    TraitRegistry { count: 0 }
}

fn trait_def_new(name: i64) -> TraitDef {
    TraitDef { name: name }
}

fn trait_register(reg: TraitRegistry, def: TraitDef) -> TraitRegistry with Mut, Panic, Div {
    TraitRegistry { count: reg.count + 1 }
}

fn impl_registry_new() -> ImplRegistry {
    ImplRegistry { count: 0 }
}

fn impl_register_builtins(reg: ImplRegistry) -> ImplRegistry {
    reg
}

fn copy_string_list_to_name(seg: StringList) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 384], len: seg.head_len }
    var i: i64 = 0
    while i < seg.head_len && i < 384 {
        n.buf[i] = seg.head_buf[i]
        i = i + 1
    }
    n
}

fn copy_string_list_tail_to_name(seg: StringList) -> Name with Mut, Panic, Div, Alloc {
    match seg.tail {
        Some(rest) => copy_string_list_tail_to_name(*rest)
        None => copy_string_list_to_name(seg)
    }
}
