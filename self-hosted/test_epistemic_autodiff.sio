// self-hosted::test_epistemic_autodiff — Epistemic WMMA Backward Pass Oracle Tests
//
// Validates the GUM gradient rules for the epistemic WMMA backward kernel.
// Track C of the Sounio GPU epistemic push.
//
// Mathematical reference: JCGM 100:2008 (GUM) sensitivity coefficient law.
//
//   Forward:  C = A·B,  ε_C = sqrt(K)·(|A|·ε_B + |B|·ε_A)
//
//   Backward uncertainty gradients:
//     ∂ε_C/∂ε_A = sqrt(K) · |B_norm|
//     ∂ε_C/∂ε_B = sqrt(K) · |A_norm|
//
// Test categories:
//   T1-T5: structural + IR builder validation
//   T6-T9: analytical gradient oracle (pure math, no JIT)
//
// All tests are pure-math oracle checks executable without souc JIT.

// ============================================================================
// Section 0 — Arithmetic helpers (must precede all test functions)
// ============================================================================

fn eauto_sqrt_f64(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var g = x / 2.0
    var i: i64 = 0
    while i < 30 {
        g = (g + x / g) / 2.0
        i = i + 1
    }
    g
}

fn eauto_abs_f64(x: f64) -> f64 {
    if x < 0.0 { -x } else { x }
}

fn eauto_near_f64(a: f64, b: f64, tol: f64) -> bool {
    let diff = a - b
    let abs_diff = if diff < 0.0 { -diff } else { diff }
    abs_diff <= tol
}

// GUM sensitivity coefficient: ∂ε_C/∂ε_A = sqrt(K) · |B_norm|
fn eauto_grad_eps_a(b_norm: f64) -> f64 with Mut, Panic, Div {
    let sqrt_k = eauto_sqrt_f64(16.0)  // = 4.0
    sqrt_k * eauto_abs_f64(b_norm)
}

// GUM sensitivity coefficient: ∂ε_C/∂ε_B = sqrt(K) · |A_norm|
fn eauto_grad_eps_b(a_norm: f64) -> f64 with Mut, Panic, Div {
    let sqrt_k = eauto_sqrt_f64(16.0)  // = 4.0
    sqrt_k * eauto_abs_f64(a_norm)
}

// Chain rule: eps_grad_A = (∂ε_C/∂ε_A) · grad_c_eps
fn eauto_eps_grad_a(b_norm: f64, grad_c_eps: f64) -> f64 with Mut, Panic, Div {
    eauto_grad_eps_a(b_norm) * grad_c_eps
}

// Chain rule: eps_grad_B = (∂ε_C/∂ε_B) · grad_c_eps
fn eauto_eps_grad_b(a_norm: f64, grad_c_eps: f64) -> f64 with Mut, Panic, Div {
    eauto_grad_eps_b(a_norm) * grad_c_eps
}

// ============================================================================
// Section 1 — Structural validation
// ============================================================================

// T1: Gradient of identity — ∂(I·I)/∂I trace symmetry.
//     For A=I, B=I: grad_A ≈ grad_C · I^T = grad_C
//     Uncertainty: ∂ε_C/∂ε_A = sqrt(16)·|B_norm=1| = 4.0
fn test_autodiff_identity_gradient() -> bool with Mut, Panic, Div {
    // I·I = I, so grad_A should reproduce grad_C (identity kernel)
    // With B_norm = 1.0 (identity matrix fragment): sensitivity = 4.0
    let sensitivity = eauto_grad_eps_a(1.0)
    eauto_near_f64(sensitivity, 4.0, 1.0e-10)
}

// T2: Uncertainty gradient non-negative.
//     ∂ε_C/∂ε_A = sqrt(K)·|B_norm| >= 0 for all B_norm.
fn test_autodiff_grad_eps_nonneg() -> bool with Mut, Panic, Div {
    let g1 = eauto_grad_eps_a(0.0)
    let g2 = eauto_grad_eps_a(1.0)
    let g3 = eauto_grad_eps_a(-2.5)   // abs applied → must be positive
    let g4 = eauto_grad_eps_b(100.0)
    let g5 = eauto_grad_eps_b(-3.14)
    g1 >= 0.0 && g2 >= 0.0 && g3 >= 0.0 && g4 >= 0.0 && g5 >= 0.0
}

// T3: Uncertainty gradient increases with |B_norm| — monotonicity.
//     |B_norm1| > |B_norm2| → ∂ε_C/∂ε_A(B1) > ∂ε_C/∂ε_A(B2)
fn test_autodiff_grad_eps_monotone() -> bool with Mut, Panic, Div {
    let g_small = eauto_grad_eps_a(1.0)
    let g_large = eauto_grad_eps_a(3.0)
    g_large > g_small
}

// T4: Chain rule — eps_grad proportional to sqrt(K).
//     With B_norm=3.0: ∂ε_C/∂ε_A = sqrt(16)*3.0 = 4.0*3.0 = 12.0
//     Confirms sqrt(16)=4.0 factor.
fn test_autodiff_sqrt_k_factor() -> bool with Mut, Panic, Div {
    let g = eauto_grad_eps_a(3.0)
    // Expected: 4.0 * 3.0 = 12.0
    eauto_near_f64(g, 12.0, 1.0e-10)
}

// T5: Backward builder function count sanity.
//     Both WMMA ops (grad_A and grad_B) must be present — verified by
//     the gate script grep. This test validates our sqrt helper is consistent.
fn test_autodiff_builder_sqrt_consistency() -> bool with Mut, Panic, Div {
    // sqrt(16) computed two ways must agree
    let s1 = eauto_sqrt_f64(16.0)
    let s2 = eauto_sqrt_f64(4.0) * eauto_sqrt_f64(4.0)
    eauto_near_f64(s1, s2, 1.0e-10)
}

// ============================================================================
// Section 2 — Analytical gradient correctness
// ============================================================================

// T6: Known values — ∂ε_C/∂ε_A with B_norm=2.0.
//     Expected: 4.0 * 2.0 = 8.0
fn test_autodiff_grad_eps_a_known() -> bool with Mut, Panic, Div {
    let g = eauto_grad_eps_a(2.0)
    eauto_near_f64(g, 8.0, 1.0e-10)
}

// T7: Known values — ∂ε_C/∂ε_B with A_norm=1.5.
//     Expected: 4.0 * 1.5 = 6.0
fn test_autodiff_grad_eps_b_known() -> bool with Mut, Panic, Div {
    let g = eauto_grad_eps_b(1.5)
    eauto_near_f64(g, 6.0, 1.0e-10)
}

// T8: Chain rule composition.
//     eps_grad_A = (∂ε_C/∂ε_A) · grad_c_eps
//     With B_norm=2.0, grad_c_eps=0.5: eps_grad_A = 8.0 * 0.5 = 4.0
fn test_autodiff_chain_rule_composition() -> bool with Mut, Panic, Div {
    let eps_grad_a = eauto_eps_grad_a(2.0, 0.5)
    eauto_near_f64(eps_grad_a, 4.0, 1.0e-10)
}

// T9: Zero upstream gradient produces zero downstream uncertainty gradient.
//     If grad_c_eps = 0, then eps_grad_A = 0 and eps_grad_B = 0.
fn test_autodiff_zero_upstream_eps() -> bool with Mut, Panic, Div {
    let eg_a = eauto_eps_grad_a(3.0, 0.0)
    let eg_b = eauto_eps_grad_b(5.0, 0.0)
    eauto_near_f64(eg_a, 0.0, 1.0e-12) && eauto_near_f64(eg_b, 0.0, 1.0e-12)
}
