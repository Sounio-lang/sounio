// ============================================================
// Test 33: Leaked fn IDs collection
// ============================================================

fn effc_test_leaked_fn_ids() -> i64 with IO, Mut, Panic, Div {
    var c = eff_checker_new()

    // fn 10: safe (IO declared and inferred)
    let n1 = effc_make_name(97, 0, 0, 0, 1)
    var d1 = eff_decl_new(10, n1.0, n1.1, eff_set_singleton(EFF_IO()))
    d1.inferred = eff_set_singleton(EFF_IO())
    c = eff_checker_add_decl(c, d1)

    // fn 20: leaky (MUT inferred but not declared)
    let n2 = effc_make_name(98, 0, 0, 0, 1)
    var d2 = eff_decl_new(20, n2.0, n2.1, eff_set_empty())
    d2.inferred = eff_set_singleton(EFF_MUT())
    c = eff_checker_add_decl(c, d2)

    // fn 30: leaky (PANIC inferred but not declared)
    let n3 = effc_make_name(99, 0, 0, 0, 1)
    var d3 = eff_decl_new(30, n3.0, n3.1, eff_set_empty())
    d3.inferred = eff_set_singleton(EFF_PANIC())
    c = eff_checker_add_decl(c, d3)

    let result = eff_checker_leaked_fn_ids(c)
    let ids = result.0
    let count = result.1
    let ok1 = count == 2
    // The leaked IDs should be 20 and 30 (order depends on iteration)
    let ok2 = (ids[0] == 20 && ids[1] == 30) || (ids[0] == 30 && ids[1] == 20)
    effc_assert_true(ok1 && ok2, 33)
}

