    let b_inf = eff_checker_get_inferred(c, 2)
    let ok1 = eff_set_count(a_inf) == 1 && eff_set_has(a_inf, EFF_IO())
    let ok2 = eff_set_count(b_inf) == 1 && eff_set_has(b_inf, EFF_MUT())
    effc_assert_true(ok1 && ok2, 38)
}

