// ============================================================
// Test 29: Diamond call graph inference
// ============================================================
//
//   A -> B -> D
//   A -> C -> D
//   D has IO inferred. Both B and C (and A) should inherit IO.

fn effc_test_diamond_inference() -> i64 with IO, Mut, Panic, Div {
    var c = eff_checker_new()

    let d_name = effc_make_name(68, 0, 0, 0, 1)
    var d_decl = eff_decl_new(4, d_name.0, d_name.1, eff_set_singleton(EFF_IO()))
    d_decl.inferred = eff_set_singleton(EFF_IO())
    c = eff_checker_add_decl(c, d_decl)

    let c_name = effc_make_name(67, 0, 0, 0, 1)
    let c_decl_val = eff_decl_new(3, c_name.0, c_name.1, eff_set_singleton(EFF_IO()))
    c = eff_checker_add_decl(c, c_decl_val)

    let b_name = effc_make_name(66, 0, 0, 0, 1)
    let b_decl = eff_decl_new(2, b_name.0, b_name.1, eff_set_singleton(EFF_IO()))
    c = eff_checker_add_decl(c, b_decl)

    let a_name = effc_make_name(65, 0, 0, 0, 1)
    let a_decl = eff_decl_new(1, a_name.0, a_name.1, eff_set_singleton(EFF_IO()))
    c = eff_checker_add_decl(c, a_decl)

    c = eff_checker_add_call(c, 1, 2)  // A -> B
    c = eff_checker_add_call(c, 1, 3)  // A -> C
    c = eff_checker_add_call(c, 2, 4)  // B -> D
    c = eff_checker_add_call(c, 3, 4)  // C -> D

    c = eff_checker_infer(c)

    let a_inf = eff_checker_get_inferred(c, 1)
    let b_inf = eff_checker_get_inferred(c, 2)
    let c_inf = eff_checker_get_inferred(c, 3)
    let ok1 = eff_set_has(a_inf, EFF_IO())
    let ok2 = eff_set_has(b_inf, EFF_IO())
    let ok3 = eff_set_has(c_inf, EFF_IO())
    effc_assert_true(ok1 && ok2 && ok3, 29)
}

// ============================================================
// Test 30: Multiple effects through call chain
// ============================================================
//
//   foo has IO, bar has MUT, baz calls both -> should have IO+MUT

fn effc_test_multi_effect_chain() -> i64 with IO, Mut, Panic, Div {
    var c = eff_checker_new()

    let foo_name = effc_make_name(102, 111, 111, 0, 3)
    var foo_decl = eff_decl_new(1, foo_name.0, foo_name.1, eff_set_singleton(EFF_IO()))
    foo_decl.inferred = eff_set_singleton(EFF_IO())
    c = eff_checker_add_decl(c, foo_decl)

    let bar_name = effc_make_name(98, 97, 114, 0, 3)
    var bar_decl = eff_decl_new(2, bar_name.0, bar_name.1, eff_set_singleton(EFF_MUT()))
    bar_decl.inferred = eff_set_singleton(EFF_MUT())
    c = eff_checker_add_decl(c, bar_decl)

    // baz calls both foo and bar, declared IO+MUT
    let baz_name = effc_make_name(98, 97, 122, 0, 3)
    var baz_declared = eff_set_empty()
    baz_declared = eff_set_add(baz_declared, EFF_IO())
    baz_declared = eff_set_add(baz_declared, EFF_MUT())
    let baz_decl = eff_decl_new(3, baz_name.0, baz_name.1, baz_declared)
    c = eff_checker_add_decl(c, baz_decl)

    c = eff_checker_add_call(c, 3, 1)  // baz -> foo
    c = eff_checker_add_call(c, 3, 2)  // baz -> bar

    c = eff_checker_infer(c)

    let baz_inf = eff_checker_get_inferred(c, 3)
    let ok1 = eff_set_has(baz_inf, EFF_IO())
    let ok2 = eff_set_has(baz_inf, EFF_MUT())
    let ok3 = eff_set_count(baz_inf) == 2
    effc_assert_true(ok1 && ok2 && ok3, 30)
}

