// ============================================================
// Test 43: Cycle in call graph converges
// ============================================================
//
//   A -> B -> A (mutual recursion)
//   A has IO inferred, B has MUT inferred.
//   After fixed point, both should have IO+MUT.

fn effc_test_cycle_convergence() -> i64 with IO, Mut, Panic, Div {
    var c = eff_checker_new()

    let a_name = effc_make_name(65, 0, 0, 0, 1)
    var a_decl = eff_decl_new(1, a_name.0, a_name.1, eff_set_io_mut_panic_div())
    a_decl.inferred = eff_set_singleton(EFF_IO())
    c = eff_checker_add_decl(c, a_decl)

    let b_name = effc_make_name(66, 0, 0, 0, 1)
    var b_decl = eff_decl_new(2, b_name.0, b_name.1, eff_set_io_mut_panic_div())
    b_decl.inferred = eff_set_singleton(EFF_MUT())
    c = eff_checker_add_decl(c, b_decl)

    c = eff_checker_add_call(c, 1, 2)  // A -> B
    c = eff_checker_add_call(c, 2, 1)  // B -> A

    c = eff_checker_infer(c)

    let a_inf = eff_checker_get_inferred(c, 1)
    let b_inf = eff_checker_get_inferred(c, 2)
    let ok1 = eff_set_has(a_inf, EFF_IO()) && eff_set_has(a_inf, EFF_MUT())
    let ok2 = eff_set_has(b_inf, EFF_IO()) && eff_set_has(b_inf, EFF_MUT())
    effc_assert_true(ok1 && ok2, 43)
}

