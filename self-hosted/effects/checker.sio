    effc_assert_true(ok1 && ok2 && ok3, 45)
}

// ============================================================
// Test 46: All 8 primary effects can be represented simultaneously
// ============================================================

fn effc_test_all_primary_effects() -> i64 with IO, Mut, Panic, Div {
    var s = eff_set_empty()
    s = eff_set_add(s, EFF_IO())
    s = eff_set_add(s, EFF_MUT())
    s = eff_set_add(s, EFF_ALLOC())
    s = eff_set_add(s, EFF_PANIC())
    s = eff_set_add(s, EFF_ASYNC())
    s = eff_set_add(s, EFF_GPU())
    s = eff_set_add(s, EFF_PROB())
    s = eff_set_add(s, EFF_DIV())

    let ok1 = eff_set_count(s) == 8
    let ok2 = eff_set_has(s, EFF_IO()) && eff_set_has(s, EFF_MUT())
    let ok3 = eff_set_has(s, EFF_ALLOC()) && eff_set_has(s, EFF_PANIC())
    let ok4 = eff_set_has(s, EFF_ASYNC()) && eff_set_has(s, EFF_GPU())
    let ok5 = eff_set_has(s, EFF_PROB()) && eff_set_has(s, EFF_DIV())
    effc_assert_true(ok1 && ok2 && ok3 && ok4 && ok5, 46)
}

