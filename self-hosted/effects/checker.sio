    let ok3 = eff_set_has(s, EFF_PANIC())
    let ok4 = eff_set_has(s, EFF_GPU())
    let ok5 = !eff_set_has(s, EFF_MUT())
    effc_assert_true(ok1 && ok2 && ok3 && ok4 && ok5, 26)
}

// ============================================================
