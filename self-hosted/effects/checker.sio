// ============================================================
// Test 49: Inference iterations count
// ============================================================

fn effc_test_infer_iterations() -> i64 with IO, Mut, Panic, Div {
    var c = eff_checker_new()

    // Pure leaf — no propagation needed
    let n1 = effc_make_name(97, 0, 0, 0, 1)
    let d1 = eff_decl_new(1, n1.0, n1.1, eff_set_empty())
    c = eff_checker_add_decl(c, d1)

    let iters = eff_checker_infer_iterations(c)
    // With no edges, should converge in 1 iteration
    effc_assert_true(iters == 1, 49)
}

// ============================================================
// Test 50: Declared effect count across checker
// ============================================================

fn effc_test_declared_effect_count() -> i64 with IO, Mut, Panic, Div {
    var c = eff_checker_new()

    let n1 = effc_make_name(97, 0, 0, 0, 1)
    let d1 = eff_decl_new(1, n1.0, n1.1, eff_set_singleton(EFF_IO()))
    c = eff_checker_add_decl(c, d1)

    let n2 = effc_make_name(98, 0, 0, 0, 1)
    var declared2 = eff_set_empty()
    declared2 = eff_set_add(declared2, EFF_IO())
    declared2 = eff_set_add(declared2, EFF_MUT())
    declared2 = eff_set_add(declared2, EFF_DIV())
    let d2 = eff_decl_new(2, n2.0, n2.1, declared2)
    c = eff_checker_add_decl(c, d2)

    let total_declared = eff_checker_declared_effect_count(c)
    effc_assert_true(total_declared == 3, 50)  // IO, MUT, DIV
}

// ============================================================
// Test runner
// ============================================================

fn effect_checker_run_tests() -> i64 with IO, Mut, Panic, Div {
    print("=== Effect checker tests ===\n")
    var fails: i64 = 0

    // EffBitSet basics (tests 1-13)
    fails = fails + effc_test_empty_set()
    fails = fails + effc_test_add_single()
    fails = fails + effc_test_add_multiple()
    fails = fails + effc_test_idempotent_add()
    fails = fails + effc_test_union_disjoint()
    fails = fails + effc_test_union_overlap()
    fails = fails + effc_test_subset_proper()
    fails = fails + effc_test_subset_equal()
    fails = fails + effc_test_subset_empty()
    fails = fails + effc_test_intersection()
    fails = fails + effc_test_difference()
    fails = fails + effc_test_singleton()
    fails = fails + effc_test_equality()

    // Name formatting (test 14)
    fails = fails + effc_test_format_names()

    // Checker basics (tests 15-19)
    fails = fails + effc_test_checker_new()
    fails = fails + effc_test_add_find_decl()
    fails = fails + effc_test_find_missing_decl()
    fails = fails + effc_test_add_call()
    fails = fails + effc_test_duplicate_call()

    // Inference (tests 20-21, 29-30)
    fails = fails + effc_test_simple_inference()
    fails = fails + effc_test_transitive_inference()

    // Verification (tests 22-24)
    fails = fails + effc_test_verify_valid()
    fails = fails + effc_test_verify_missing()
    fails = fails + effc_test_find_leaks()

    // Aggregate queries (tests 25, 34-36)
    fails = fails + effc_test_pure_fn_count()
    fails = fails + effc_test_from_ids()
    fails = fails + effc_test_decl_missing()
    fails = fails + effc_test_decl_unnecessary()

    // Complex inference (tests 29-30)
    fails = fails + effc_test_diamond_inference()
    fails = fails + effc_test_multi_effect_chain()

    // Safety checks (tests 31-33)
    fails = fails + effc_test_all_safe_valid()
    fails = fails + effc_test_all_safe_leaky()
    fails = fails + effc_test_leaked_fn_ids()

    // More coverage (tests 34-50)
    fails = fails + effc_test_effect_count()
    fails = fails + effc_test_truly_pure_count()
    fails = fails + effc_test_fn_is_safe()
    fails = fails + effc_test_common_sets()
    fails = fails + effc_test_infer_no_calls()
    fails = fails + effc_test_verify_multi_error()
    fails = fails + effc_test_decl_is_valid()
    fails = fails + effc_test_edge_count()
    fails = fails + effc_test_decl_count_accessor()
    fails = fails + effc_test_cycle_convergence()
    fails = fails + effc_test_name_eq()
    fails = fails + effc_test_set_inferred()
    fails = fails + effc_test_all_primary_effects()
    fails = fails + effc_test_extended_effects()
    fails = fails + effc_test_get_declared()
    fails = fails + effc_test_infer_iterations()
    fails = fails + effc_test_declared_effect_count()

    print("Total failures: ")
    print_int(fails)
    print("\n")
    fails
}
