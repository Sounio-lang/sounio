    let c = efh_get_clause(ctx, 0)
    c.effect_id == 5 && c.op_index == 3 && c.handler_fn_id == 777 &&
    c.captures_cont && efh_resume_strategy_eq(c.resume_strategy, EfhResumeStrategy::ResumeMulti)
}
