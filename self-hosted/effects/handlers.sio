    let hid = efh_register_handler(ctx, 5, 100, EfhResumeStrategy::ResumeOnce)
    efh_install_handler(ctx, hid)

    efh_perform_effect(ctx, 5, 3, 77)

    let op = efh_get_op(ctx, 0)
    efh_op_kind_eq(op.kind, EfhOpKind::OpPerform) && op.effect_id == 5 &&
    op.op_index == 3 && op.arg == 77
}
fn test_efh_perform_logs_op() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_perform_logs_op(&! ctx), 26)
