    let hid = efh_register_handler(ctx, 1, 100, EfhResumeStrategy::ResumeOnce)
    efh_install_handler(ctx, hid)

    let before = efh_cont_total(ctx)
    efh_perform_effect(ctx, 1, 0, 42)
    let after = efh_cont_total(ctx)

    after == before + 1
}
fn test_efh_perform_creates_cont() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_perform_creates_cont(&! ctx), 25)
