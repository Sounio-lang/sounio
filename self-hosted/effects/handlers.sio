    let hid = efh_register_handler(ctx, 1, 100, EfhResumeStrategy::ResumeOnce)
    efh_install_handler(ctx, hid)

    efh_perform_effect(ctx, 1, 0, 0)

    let state = efh_handler_state(ctx, hid)
    efh_handler_state_eq(state, EfhHandlerState::HandlerSuspended)
}
fn test_efh_perform_suspends_handler() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_perform_suspends_handler(&! ctx), 27)
