// Test 36: Continuation PC and register count
fn efh_test_cont_pc_regs(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    var regs: [i64; 64] = [0; 64]
    regs[0] = 10
    regs[1] = 20
    regs[2] = 30
    let cid = efh_capture_continuation(ctx, &regs, 3, 1024)

    let pc = efh_cont_pc(ctx, cid)
    let rc = efh_cont_reg_count(ctx, cid)
    let r0 = efh_cont_get_reg(ctx, cid, 0)
    let r1 = efh_cont_get_reg(ctx, cid, 1)
    let r2 = efh_cont_get_reg(ctx, cid, 2)

    pc == 1024 && rc == 3 && r0 == 10 && r1 == 20 && r2 == 30
}
fn test_efh_cont_pc_regs() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_cont_pc_regs(&! ctx), 36)
