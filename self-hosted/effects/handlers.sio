    efh_abort(ctx, cid)
    let ok = efh_resume(ctx, cid, 0)
    !ok  // should fail
}
fn test_efh_resume_abandoned() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_resume_abandoned(&! ctx), 34)
