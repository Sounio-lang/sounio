// Test 11: Push and pop frames
fn efh_test_push_pop_frame(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    let ok1 = efh_stack_depth(ctx) == 0

    let pushed = efh_push_frame(ctx)
    let ok2 = pushed && efh_stack_depth(ctx) == 1

    let popped = efh_pop_frame(ctx)
    let ok3 = popped && efh_stack_depth(ctx) == 0

    ok1 && ok2 && ok3
}
fn test_efh_push_pop_frame() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_push_pop_frame(&! ctx), 11)
}

// Test 12: Nested frames
fn efh_test_nested_frames(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    efh_push_frame(ctx)
    efh_push_frame(ctx)
    efh_push_frame(ctx)
    let ok1 = efh_stack_depth(ctx) == 3

    efh_pop_frame(ctx)
    let ok2 = efh_stack_depth(ctx) == 2

    efh_pop_frame(ctx)
    efh_pop_frame(ctx)
    let ok3 = efh_stack_depth(ctx) == 0

    ok1 && ok2 && ok3
}
fn test_efh_nested_frames() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_nested_frames(&! ctx), 12)
}

// Test 13: Pop on empty stack fails
fn efh_test_pop_empty_stack(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    let ok = !efh_pop_frame(ctx)
    ok && efh_error_count(ctx) > 0
}
fn test_efh_pop_empty_stack() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_pop_empty_stack(&! ctx), 13)
}

// Test 14: Add handler to frame
fn efh_test_frame_add_handler(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    let hid = efh_register_handler(ctx, 1, 100, EfhResumeStrategy::ResumeOnce)
    efh_push_frame(ctx)
    let added = efh_frame_add_handler(ctx, hid)
    let count = efh_current_frame_handler_count(ctx)
    added && count == 1
}
fn test_efh_frame_add_handler() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_frame_add_handler(&! ctx), 14)
}

// Test 15: Install handler (push frame + add)
fn efh_test_install_handler(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    let hid = efh_register_handler(ctx, 1, 100, EfhResumeStrategy::ResumeOnce)
    let ok = efh_install_handler(ctx, hid)
    ok && efh_stack_depth(ctx) == 1 && ctx.current_handler == hid
}
fn test_efh_install_handler() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_install_handler(&! ctx), 15)
}

// Test 16: Uninstall handler
fn efh_test_uninstall_handler(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    let hid = efh_register_handler(ctx, 1, 100, EfhResumeStrategy::ResumeOnce)
    efh_install_handler(ctx, hid)
    let ok = efh_uninstall_handler(ctx)

    // Handler should now be completed
    let state = efh_handler_state(ctx, hid)
    ok && efh_stack_depth(ctx) == 0 && efh_handler_state_eq(state, EfhHandlerState::HandlerCompleted)
}
fn test_efh_uninstall_handler() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_uninstall_handler(&! ctx), 16)
}

// Test 17: Install non-existent handler fails
fn efh_test_install_nonexistent(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    let ok = !efh_install_handler(ctx, 9999)
    ok && efh_stack_depth(ctx) == 0
}
fn test_efh_install_nonexistent() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_install_nonexistent(&! ctx), 17)
}

// Test 18: Multi-handler install
fn efh_test_install_multi(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    let h1 = efh_register_handler(ctx, 1, 100, EfhResumeStrategy::ResumeOnce)
    let h2 = efh_register_handler(ctx, 2, 200, EfhResumeStrategy::ResumeMulti)

    var ids: [i64; 16] = [0; 16]
    ids[0] = h1
    ids[1] = h2

    let ok = efh_install_multi(ctx, &ids, 2)
    ok && efh_stack_depth(ctx) == 1 && efh_current_frame_handler_count(ctx) == 2
}
fn test_efh_install_multi() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_install_multi(&! ctx), 18)
}

