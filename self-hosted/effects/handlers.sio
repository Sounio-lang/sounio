// Test 31: Resume changes continuation state
fn efh_test_resume_state(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    var regs: [i64; 64] = [0; 64]
    let cid = efh_capture_continuation(ctx, &regs, 1, 0)

    let ok = efh_resume(ctx, cid, 42)
    let state = efh_cont_state(ctx, cid)

    ok && efh_cont_state_eq(state, EfhContState::ContRunning)
}
fn test_efh_resume_state() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_resume_state(&! ctx), 31)
}

// Test 32: Resume places value in register 0
fn efh_test_resume_value(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    var regs: [i64; 64] = [0; 64]
    regs[0] = 99
    let cid = efh_capture_continuation(ctx, &regs, 1, 0)

    efh_resume(ctx, cid, 555)

    let val = efh_cont_get_reg(ctx, cid, 0)
    val == 555
}
fn test_efh_resume_value() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_resume_value(&! ctx), 32)
}

// Test 33: Abort continuation
