// Test 37: Continuation handler depth
fn efh_test_cont_handler_depth(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    efh_push_frame(ctx)
    efh_push_frame(ctx)

    var regs: [i64; 64] = [0; 64]
    let cid = efh_capture_continuation(ctx, &regs, 0, 0)

    let depth = efh_cont_handler_depth(ctx, cid)
    depth == 2  // captured at stack depth 2
}
fn test_efh_cont_handler_depth() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_cont_handler_depth(&! ctx), 37)
}

// Test 38: Resume count tracks invocations
fn efh_test_resume_count(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    var regs: [i64; 64] = [0; 64]
    let cid = efh_capture_continuation(ctx, &regs, 0, 0)

    let ok1 = efh_cont_resume_count(ctx, cid) == 0

    efh_resume(ctx, cid, 0)
    let ok2 = efh_cont_resume_count(ctx, cid) == 1

    // Suspend so we can resume again
    efh_suspend_continuation(ctx, cid)
    efh_resume(ctx, cid, 0)
    let ok3 = efh_cont_resume_count(ctx, cid) == 2

    ok1 && ok2 && ok3
}
fn test_efh_resume_count() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_resume_count(&! ctx), 38)
}

