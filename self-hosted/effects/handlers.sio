    efh_add_clause(ctx, 1, 0, 100, true, EfhResumeStrategy::ResumeOnce)
    efh_add_clause(ctx, 1, 0, 200, false, EfhResumeStrategy::ResumeMulti)  // override

    let first = efh_match_clause(ctx, 1, 0)
    let last = efh_match_clause_last(ctx, 1, 0)

    first == 0 && last == 1  // first returns 0, last returns 1
}
