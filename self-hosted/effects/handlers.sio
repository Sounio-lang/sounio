// Test 28: Multiple performs create multiple continuations
fn efh_test_multiple_performs(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    // Register two handlers for different effects
    let h1 = efh_register_handler(ctx, 1, 100, EfhResumeStrategy::ResumeOnce)
    let h2 = efh_register_handler(ctx, 2, 200, EfhResumeStrategy::ResumeOnce)

    // Install both in separate frames
    efh_install_handler(ctx, h1)
    efh_install_handler(ctx, h2)

    efh_perform_effect(ctx, 2, 0, 10)

    // Re-activate h2 so we can find h1
    efh_set_handler_state(ctx, h2, EfhHandlerState::HandlerActive)
    efh_perform_effect(ctx, 1, 0, 20)

    efh_cont_total(ctx) == 2
}
fn test_efh_multiple_performs() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_multiple_performs(&! ctx), 28)
}

