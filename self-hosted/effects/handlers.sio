// Test 35: Cannot resume done continuation
fn efh_test_resume_done(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    var regs: [i64; 64] = [0; 64]
    let cid = efh_capture_continuation(ctx, &regs, 0, 0)

    efh_resume(ctx, cid, 0)
    efh_complete_continuation(ctx, cid)

    let ok = efh_resume(ctx, cid, 0)
    !ok  // should fail (ContDone is not resumable)
}
fn test_efh_resume_done() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_resume_done(&! ctx), 35)
