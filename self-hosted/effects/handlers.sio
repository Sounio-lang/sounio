// Test 40: Match clause by effect and op
fn efh_test_match_clause(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    efh_add_clause(ctx, 1, 0, 100, true, EfhResumeStrategy::ResumeOnce)
    efh_add_clause(ctx, 2, 1, 200, false, EfhResumeStrategy::ResumeNever)

    let m1 = efh_match_clause(ctx, 1, 0)
    let m2 = efh_match_clause(ctx, 2, 1)
    let m3 = efh_match_clause(ctx, 3, 0)  // no match

    m1 == 0 && m2 == 1 && m3 == (0 - 1)
}
fn test_efh_match_clause() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_match_clause(&! ctx), 40)
