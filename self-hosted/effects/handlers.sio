    efh_add_clause(ctx, 1, 1, 101, true, EfhResumeStrategy::ResumeOnce)
    efh_add_clause(ctx, 1, 2, 102, false, EfhResumeStrategy::ResumeNever)

    let count = efh_clause_count_for_effect(ctx, 1)
    count == 3
}
