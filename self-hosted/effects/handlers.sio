// Test 29: Capture continuation directly
fn efh_test_capture_cont(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    var regs: [i64; 64] = [0; 64]
    regs[0] = 100
    regs[1] = 200
    let cid = efh_capture_continuation(ctx, &regs, 2, 42)
    cid > 0 && efh_cont_total(ctx) == 1
}
fn test_efh_capture_cont() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_capture_cont(&! ctx), 29)
}

// Test 30: Continuation state after capture
fn efh_test_cont_initial_state(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    var regs: [i64; 64] = [0; 64]
    let cid = efh_capture_continuation(ctx, &regs, 0, 0)
    let state = efh_cont_state(ctx, cid)
    efh_cont_state_eq(state, EfhContState::ContReady)
}
fn test_efh_cont_initial_state() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_cont_initial_state(&! ctx), 30)
