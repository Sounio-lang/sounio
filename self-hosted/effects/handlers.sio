// ============================================================================
// TEST CATEGORY 8: Integration (tests 60-65)
// ============================================================================

// Test 60: Full perform-dispatch-resume pipeline
fn efh_test_full_pipeline(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    // Register handler for effect 1
    let hid = efh_register_handler(ctx, 1, 100, EfhResumeStrategy::ResumeOnce)
    efh_install_handler(ctx, hid)

    // Add a clause for (effect=1, op=0)
    efh_add_clause(ctx, 1, 0, 100, true, EfhResumeStrategy::ResumeOnce)

    // Perform the effect
    let result = efh_perform_effect(ctx, 1, 0, 42)
    let ok1 = efh_dispatch_result_eq(result, EfhDispatchResult::DispatchHandled)

    // A continuation was captured
    let ok2 = efh_cont_total(ctx) == 1
    let cid = ctx.continuations[0].id

    // Resume the continuation with a result
    let ok3 = efh_resume(ctx, cid, 99)
    let ok4 = efh_cont_get_reg(ctx, cid, 0) == 99

    // Complete the continuation
    efh_complete_continuation(ctx, cid)
    let state = efh_cont_state(ctx, cid)
    let ok5 = efh_cont_state_eq(state, EfhContState::ContDone)

    ok1 && ok2 && ok3 && ok4 && ok5
}
fn test_efh_full_pipeline() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_full_pipeline(&! ctx), 60)
}

// Test 61: Nested handlers — inner shadows outer
fn efh_test_nested_handlers(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    let h_outer = efh_register_handler(ctx, 1, 100, EfhResumeStrategy::ResumeOnce)
    let h_inner = efh_register_handler(ctx, 1, 200, EfhResumeStrategy::ResumeMulti)

    efh_install_handler(ctx, h_outer)
    efh_install_handler(ctx, h_inner)

    // Inner handler should be found first
    let found = efh_find_handler(ctx, 1)
    let ok1 = found == h_inner

    // Perform effect — captured by inner handler
    let result = efh_perform_effect(ctx, 1, 0, 0)
    let ok2 = efh_dispatch_result_eq(result, EfhDispatchResult::DispatchHandled)

    // Uninstall inner — outer should now be visible
    // First re-activate inner so uninstall works properly
    efh_set_handler_state(ctx, h_inner, EfhHandlerState::HandlerActive)
    efh_uninstall_handler(ctx)

    let found2 = efh_find_handler(ctx, 1)
    let ok3 = found2 == h_outer

    ok1 && ok2 && ok3
}
fn test_efh_nested_handlers() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_nested_handlers(&! ctx), 61)
}

// Test 62: Perform and immediate resume (tail-resumptive fast path)
fn efh_test_perform_and_resume(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    let hid = efh_register_handler(ctx, 1, 100, EfhResumeStrategy::ResumeTail)
    efh_install_handler(ctx, hid)

    let ok = efh_perform_and_resume(ctx, 1, 0, 42, 100)
    ok && efh_cont_total(ctx) == 1
}
fn test_efh_perform_and_resume() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_perform_and_resume(&! ctx), 62)
}

// Test 63: Shift/Reset delimited control
fn efh_test_shift_reset(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    // Install a reset delimiter
    let ok1 = efh_reset(ctx)

    // Shift captures a continuation
    let cid = efh_shift(ctx, 42)
    let ok2 = cid > 0

    // The continuation should be in Ready state
    let state = efh_cont_state(ctx, cid)
    let ok3 = efh_cont_state_eq(state, EfhContState::ContReady)

    // Shift logged an OpShift
    let shift_count = efh_op_count_by_kind(ctx, EfhOpKind::OpShift)
    let ok4 = shift_count == 1

    ok1 && ok2 && ok3 && ok4
}
fn test_efh_shift_reset() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_shift_reset(&! ctx), 63)
}

// Test 64: Compile handler clause
fn efh_test_compile_clause(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    // Clause with continuation capture and ResumeOnce
    let c1 = efh_add_clause(ctx, 1, 0, 100, true, EfhResumeStrategy::ResumeOnce)
    let instr1 = efh_compile_handler_clause(ctx, c1)
    // base(2) + capture(3) + resume_once(2) = 7
    let ok1 = instr1 == 7

    // Clause without continuation capture and ResumeNever
    let c2 = efh_add_clause(ctx, 2, 0, 200, false, EfhResumeStrategy::ResumeNever)
    let instr2 = efh_compile_handler_clause(ctx, c2)
    // base(2) + no_capture(0) + resume_never(1) = 3
    let ok2 = instr2 == 3

    // Clause with continuation capture and ResumeMulti
    let c3 = efh_add_clause(ctx, 3, 0, 300, true, EfhResumeStrategy::ResumeMulti)
    let instr3 = efh_compile_handler_clause(ctx, c3)
    // base(2) + capture(3) + resume_multi(4) = 9
    let ok3 = instr3 == 9

    // Clause with ResumeTail, no capture
    let c4 = efh_add_clause(ctx, 4, 0, 400, false, EfhResumeStrategy::ResumeTail)
    let instr4 = efh_compile_handler_clause(ctx, c4)
    // base(2) + no_capture(0) + resume_tail(1) = 3
    let ok4 = instr4 == 3

    ok1 && ok2 && ok3 && ok4
}
fn test_efh_compile_clause() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_compile_clause(&! ctx), 64)
}

// Test 65: Full integration — multiple effects, handlers, clauses, CPS
fn efh_test_full_integration(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    // Register handlers for IO (effect 1) and Mut (effect 2)
    let h_io = efh_register_handler(ctx, 1, 100, EfhResumeStrategy::ResumeOnce)
    let h_mut = efh_register_handler(ctx, 2, 200, EfhResumeStrategy::ResumeTail)

    // Install both in one frame
    var ids: [i64; 16] = [0; 16]
    ids[0] = h_io
    ids[1] = h_mut
    let ok1 = efh_install_multi(ctx, &ids, 2)

    // Add clauses
    efh_add_clause(ctx, 1, 0, 100, true, EfhResumeStrategy::ResumeOnce)   // IO.print
    efh_add_clause(ctx, 1, 1, 101, true, EfhResumeStrategy::ResumeOnce)   // IO.read
    efh_add_clause(ctx, 2, 0, 200, false, EfhResumeStrategy::ResumeTail)  // Mut.set

    // Register CPS transform for a function
    let cps_ok = efh_cps_transform_function(ctx, 50, 3)
    let ok2 = efh_transform_result_eq(cps_ok, EfhTransformResult::TransformOk)

    // Perform IO effect
    let d1 = efh_perform_effect(ctx, 1, 0, 42)
    let ok3 = efh_dispatch_result_eq(d1, EfhDispatchResult::DispatchHandled)

    // Reactivate IO handler so Mut handler is still findable
    efh_set_handler_state(ctx, h_io, EfhHandlerState::HandlerActive)

    // Perform Mut effect
    let d2 = efh_perform_effect(ctx, 2, 0, 77)
    let ok4 = efh_dispatch_result_eq(d2, EfhDispatchResult::DispatchHandled)

    // Save a stack segment for the IO continuation
    let seg = efh_save_stack_segment(ctx, 0, 32)
    let ok5 = seg >= 0

    // Associate segment with first continuation
    let first_cid = ctx.continuations[0].id
    efh_cont_set_segment(ctx, first_cid, seg)

    // Resume the IO continuation
    let ok6 = efh_resume(ctx, first_cid, 99)
    efh_complete_continuation(ctx, first_cid)

    // Verify final state
    let ok7 = efh_cont_total(ctx) == 2
    let ok8 = efh_op_count(ctx) > 0
    let ok9 = efh_cps_is_transformed(ctx, 50)

    // Compile a clause to verify compilation works
    let instrs = efh_compile_handler_clause(ctx, 0)
    let ok10 = instrs > 0

    ok1 && ok2 && ok3 && ok4 && ok5 && ok6 && ok7 && ok8 && ok9 && ok10
}
fn test_efh_full_integration() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_full_integration(&! ctx), 65)
}

