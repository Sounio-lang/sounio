    r = test_efh_shift_reset()
    if r == 0 { passed = passed + 1 } else { failed = failed + 1 }

    r = test_efh_compile_clause()
    if r == 0 { passed = passed + 1 } else { failed = failed + 1 }

    r = test_efh_full_integration()
    if r == 0 { passed = passed + 1 } else { failed = failed + 1 }

    // Summary
    print("Passed: ")
    print_int(passed)
    print(" / 65\n")
    print("Failed: ")
    print_int(failed)
    print("\n")

    if failed > 0 {
        return 0 - failed
    }
    passed
}
