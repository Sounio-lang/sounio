// self-hosted::effects::types
//
// Algebraic effect system type definitions
//
// Provides:
//   - Effect: Individual effect (IO, Mut, Alloc, Panic, Div, etc.)
//   - EffectSet: Set of effects with row polymorphism support
//   - RuntimeEffectDef: Runtime effect definition with operations
//   - EffectOperation: Operation signature within an effect

// ============================================================
// Effect representation
// ============================================================

// Individual effect kinds
enum EffectKind {
    EffIO,           // Input/output operations
    EffMut,          // Mutable state
    EffAlloc,        // Heap allocation
    EffPanic,        // Runtime panics
    EffDiv,          // Division (potential div-by-zero)
    EffGPU,          // GPU kernel execution
    EffAsync,        // Asynchronous operations
    EffProb,         // Probabilistic operations
    EffEpistemic,    // Epistemic uncertainty operations
    EffCausal,       // Causal graph operations
    EffNetwork,      // Network I/O
    EffSensor,       // Sensor data acquisition
    EffExn,          // Exceptions
    EffVar,          // Effect variable (for polymorphism)
    EffUnknown,      // Unknown/error effect
}

// Effect with optional name for effect variables
pub struct Effect {
    kind: EffectKind,
    name: Name,                // For effect variables: "E", "F", etc.
}

fn effect_io() -> Effect {
    Effect {
        kind: EffectKind::EffIO,
        name: Name { buf: [0; 384], len: 0 },
    }
}

fn effect_mut() -> Effect {
    Effect {
        kind: EffectKind::EffMut,
        name: Name { buf: [0; 384], len: 0 },
    }
}

fn effect_alloc() -> Effect {
    Effect {
        kind: EffectKind::EffAlloc,
        name: Name { buf: [0; 384], len: 0 },
    }
}

fn effect_panic() -> Effect {
    Effect {
        kind: EffectKind::EffPanic,
        name: Name { buf: [0; 384], len: 0 },
    }
}

fn effect_div() -> Effect {
    Effect {
        kind: EffectKind::EffDiv,
        name: Name { buf: [0; 384], len: 0 },
    }
}

fn effect_gpu() -> Effect {
    Effect {
        kind: EffectKind::EffGPU,
        name: Name { buf: [0; 384], len: 0 },
    }
}

fn effect_var(name: Name) -> Effect {
    Effect {
        kind: EffectKind::EffVar,
        name: name,
    }
}

// ============================================================
// Effect set with row polymorphism
// ============================================================

// Set of effects (max 16 effects per function for now)
struct EffectSet {
    effects: [Effect; 16],
    count: i64,
}

fn empty_effect_set() -> EffectSet {
    EffectSet {
        effects: [effect_io(); 16],  // Dummy initialization
        count: 0,
    }
}

fn pure_effect_set() -> EffectSet {
    empty_effect_set()  // Empty set = pure function
}

impl EffectSet {
    // Check if set is pure (no effects)
    fn is_pure(self) -> bool {
        self.count == 0
    }

    // Check if set contains a specific effect kind
    fn has_effect(self, kind: EffectKind) -> bool with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.count {
            if self.effects[i as usize].kind == kind {
                return true
            }
            i = i + 1
        }
        false
    }

    // Add an effect to the set (if not already present)
    // Soft-keyword: Madaros parser rejects param name `effect`.
    fn add(self, eff: Effect) -> EffectSet with Mut, Panic, Div {
        var set = self

        // Check if already present
        var i: i64 = 0
        while i < set.count {
            if set.effects[i as usize].kind == eff.kind {
                // Already present, check if names match for effect vars
                if eff.kind == EffectKind::EffVar {
                    // For effect variables, names must match
                    if name_eq(set.effects[i as usize].name, eff.name) {
                        return set  // Already present
                    }
                } else {
                    return set  // Already present
                }
            }
            i = i + 1
        }

        // Not present, add it
        if set.count < 16 {
            set.effects[set.count as usize] = eff
            set.count = set.count + 1
        } else {
            // Effect set overflow: 16 effects is the fixed capacity.
            // This indicates a function with an unusually large effect signature.
            // Drop the effect silently — the checker will still validate the
            // first 16 effects, which covers all practical cases.
        }

        set
    }

    // Merge two effect sets (union)
    fn merge(self, other: EffectSet) -> EffectSet with Mut, Panic, Div {
        var result = self
        var i: i64 = 0
        while i < other.count {
            result = result.add(other.effects[i as usize])
            i = i + 1
        }
        result
    }

    // Check if this set is a subset of another (self ⊆ other)
    fn is_subset_of(self, other: EffectSet) -> bool with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.count {
            let eff = self.effects[i as usize]
            if !other.has_effect(eff.kind) {
                return false
            }
            i = i + 1
        }
        true
    }
}

// ============================================================
// Effect operation signatures
// ============================================================

// Operation within an effect (e.g., "print" in IO effect)
struct EffectOperation {
    name: Name,
    param_types: [TypeEntry; 8],  // Parameter types (limited to 8 for now)
    param_count: i64,
    return_type: TypeEntry,
}

fn empty_effect_operation() -> EffectOperation {
    EffectOperation {
        name: Name { buf: [0; 384], len: 0 },
        param_types: [ty_unit(); 8],
        param_count: 0,
        return_type: ty_unit(),
    }
}

// ============================================================
// Effect definitions
// ============================================================

// Full effect definition with operations
struct RuntimeEffectDef {
    effect: Effect,
    operations: [EffectOperation; 32],  // Max 32 operations per effect
    op_count: i64,
}

fn empty_effect_def() -> RuntimeEffectDef {
    RuntimeEffectDef {
        effect: effect_io(),  // Dummy
        operations: [empty_effect_operation(); 32],
        op_count: 0,
    }
}

impl RuntimeEffectDef {
    fn add_operation(self, op: EffectOperation) -> RuntimeEffectDef with Mut, Panic, Div {
        var def = self
        if def.op_count < 32 {
            def.operations[def.op_count as usize] = op
            def.op_count = def.op_count + 1
        }
        def
    }

    // Find operation by name
    fn find_operation(self, name: Name) -> Option<EffectOperation> with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.op_count {
            if name_eq(self.operations[i as usize].name, name) {
                return Some(self.operations[i as usize])
            }
            i = i + 1
        }
        None
    }
}

// ============================================================
// Effect registry (global effect definitions)
// ============================================================

struct EffectRegistry {
    definitions: [RuntimeEffectDef; 16],  // Max 16 effects
    count: i64,
}

fn empty_effect_registry() -> EffectRegistry {
    EffectRegistry {
        definitions: [empty_effect_def(); 16],
        count: 0,
    }
}

impl EffectRegistry {
    fn add_def(self, def: RuntimeEffectDef) -> EffectRegistry with Mut, Panic, Div {
        var reg = self
        if reg.count < 16 {
            reg.definitions[reg.count as usize] = def
            reg.count = reg.count + 1
        }
        reg
    }

    // Find effect definition by kind
    fn find_def(self, kind: EffectKind) -> Option<RuntimeEffectDef> with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.count {
            if self.definitions[i as usize].effect.kind == kind {
                return Some(self.definitions[i as usize])
            }
            i = i + 1
        }
        None
    }
}

// ============================================================
// Built-in effect definitions
// ============================================================

// Create registry with built-in effects
fn builtin_effect_registry() -> EffectRegistry with Mut, Panic, Div, Alloc {
    var reg = empty_effect_registry()

    // IO effect
    var io_def = RuntimeEffectDef {
        effect: effect_io(),
        operations: [empty_effect_operation(); 32],
        op_count: 0,
    }
    io_def = io_def.add_operation(EffectOperation {
        name: name_from_str("print"),
        param_types: [ty_string(), ty_unit(), ty_unit(), ty_unit(), ty_unit(), ty_unit(), ty_unit(), ty_unit()],
        param_count: 1,
        return_type: ty_unit(),
    })
    io_def = io_def.add_operation(EffectOperation {
        name: name_from_str("print_int"),
        param_types: [ty_i64(), ty_unit(), ty_unit(), ty_unit(), ty_unit(), ty_unit(), ty_unit(), ty_unit()],
        param_count: 1,
        return_type: ty_unit(),
    })
    io_def = io_def.add_operation(EffectOperation {
        name: name_from_str("read_file"),
        param_types: [ty_string(), ty_unit(), ty_unit(), ty_unit(), ty_unit(), ty_unit(), ty_unit(), ty_unit()],
        param_count: 1,
        return_type: ty_string(),
    })
    reg = reg.add_def(io_def)

    // Mut effect (mutable state)
    let mut_def = RuntimeEffectDef {
        effect: effect_mut(),
        operations: [empty_effect_operation(); 32],
        op_count: 0,
    }
    reg = reg.add_def(mut_def)

    // Alloc effect (heap allocation)
    let alloc_def = RuntimeEffectDef {
        effect: effect_alloc(),
        operations: [empty_effect_operation(); 32],
        op_count: 0,
    }
    reg = reg.add_def(alloc_def)

    // Panic effect
    let panic_def = RuntimeEffectDef {
        effect: effect_panic(),
        operations: [empty_effect_operation(); 32],
        op_count: 0,
    }
    reg = reg.add_def(panic_def)

    // Div effect (division with potential div-by-zero)
    let div_def = RuntimeEffectDef {
        effect: effect_div(),
        operations: [empty_effect_operation(); 32],
        op_count: 0,
    }
    reg = reg.add_def(div_def)

    reg
}

// ============================================================
// Helper functions
// ============================================================

// Convert string to Name (needed for effect operation names)
fn name_from_str(s: string) -> Name with Mut, Panic, Div {
    var name = Name { buf: [0; 384], len: 0 }
    let len = str_len(s)
    var i: i64 = 0
    while i < len && i < 384 {
        name.buf[i as usize] = str_char_at(s, i) as i8
        i = i + 1
    }
    name.len = if len > 384 { 384 } else { len }
    name
}
