fn print_help() with IO {
    println("Usage: souc [options] <input.sio>")
    println("")
    println("Options:")
    println("  -o, --output <file>    Output file (default: a.out)")
    println("  -t, --target <target>  Target: native, wasm, llvm (default: native)")
    println("  -O, --optimize         Enable optimizations")
    println("  --cache-dir <dir>      Persistent thin-link cache directory")
    println("  --cache-mode <mode>    Cache mode: off|read|write|rw (default: off)")
    println("  --cache-stats          Print thin-link cache hit/miss counters")
    println("  -v, --verbose          Verbose output")
    println("  --emit-ast             Print AST to stdout")
    println("  --emit-tokens          Print tokens to stdout")
    println("  --emit-manifest        Print epistemic audit manifest JSON to stdout")
    println("  --gpu-target <name>    GPU target profile (cuda-smXX, rocm-gfxXXX)")
    println("  --gpu-binary-format    fatbin|cubin|hsaco|multi")
    println("  --gpu-strict-parity    Require strict CUDA/ROCm parity checks")
    println("  --gpu-fuse-epistemic   Epistemic provenance-guided kernel fusion")
    println("  --gpu-speculative      Uncertainty-threshold speculative skip guards")
    println("  --gpu-dag-schedule     Provenance-aware DAG topo-sort + stream coloring")
    println("  --debug-witnesses      Enable debug-mode witness enforcement (Sprint 28)")
    println("  check <source.sio>     Run multimodule parse/resolve/typecheck preflight")
    println("  build <source.sio> -o <file>  Compile source to native output")
    println("  run <source.sio>       Compile source through the public run lane")
    println("  --check <source.sio>   Run multimodule parse/resolve/typecheck preflight")
    println("  --ir-dump <source.sio> Print IR byte/function/string summary")
    println("  --ir-roundtrip <source.sio>  Serialize + deserialize + reserialize IR")
    println("  --science-boundary-closure <source.sio>  Emit the raw AST module-closure report")
    println("  --native-compile <source.sio>  Compile to native output (use -o/--output to choose path)")
    println("  --emit-obj <source.sio>  Emit relocatable .o object file (use -o to choose path)")
    println("  --emit-so <source.sio>   Emit ET_DYN shared library .so (use -o to choose path)")
    println("  pkg init [--science]              Create a new sounio.toml package manifest")
    println("  pkg build [path]                  Validate and package the project")
    println("  pkg audit [path]                  Detailed epistemic quality report")
    println("  pkg publish [--dry-run]           Report publication prerequisites (disabled)")
    println("  pkg info <name>                   Show package epistemic metadata")
    println("  pkg self-test                     Run SPM internal tests")
    println("  install <name>[@<version>]        Install a package (shorthand)")
    println("  search <query>                    Search package metadata")
    println("  ontology resolve <CURIE>          Resolve ontology CURIE from the local biomedical slice")
    println("  ontology search <text>            Search ontology labels/synonyms in the local biomedical slice")
    println("  ontology ancestors <CURIE>        Show ancestor chain for the ontology term")
    println("  ontology is-subclass <child> <parent>  Check subclass relationship in the ontology slice")
    println("  ontology map <source-curie> --to <ontology>  Map a term across ontologies with confidence")
    println("  --ontology-resolve <CURIE>        Flag alias for ontology resolve")
    println("  --ontology-search <text>          Flag alias for ontology search")
    println("  --ontology-ancestors <CURIE>      Flag alias for ontology ancestors")
    println("  --ontology-is-subclass <child> <parent>  Flag alias for ontology is-subclass")
    println("  --ontology-map <source-curie> --to <ontology>  Flag alias for ontology map")
    println("  --native-v2-preview-smoke  Run dedicated native-v2 scalar/call/control/fail-closed smoke")
    println("  --native-v2-gc-retry-smoke Run dedicated native-v2 alloc-retry smoke")
    println("  --rebracket-authority-smoke Run exact bitwise rebracketing authority smoke")
    println("  --serve                Start IPC server (binary protocol on stdin/stdout)")
    println("  --kernel-compile <source.sio>  Compile with structured JSON response (kernel contract)")
    println("  --version-json         Print runtime version info as JSON to stdout")
    println("  --self-test            Run compiler main self-tests")
    println("  --bench-int-to-string [n]   Benchmark int_to_string loop (default n=1000000)")
    println("  --probe-char-from-i64 <n>   Probe char_from_i64 for manual regression checks")
    println("  --probe-arg-list-get <i>    Probe arg_list_get with fixed 3-item list")
    println("  --probe-compile-capture <source.sio>  Probe compile error capture path")
    println("  --probe-cc <source.sio>  Short alias for probe-compile-capture")
    println("  --probe-frontend <source.sio>  Probe parse/resolve/typecheck path")
    println("  --probe-epistemic-check <source.sio>  Probe epistemic parse/resolve/typecheck without manifest JSON")
    println("  --probe-frontend-strategy <source.sio>  Probe parsed frontend strategy assignment on the fast IR lane")
    println("  --probe-load-ir <source.sio>  Probe parse/resolve/typecheck/IR lowering path")
    println("  --probe-load-ir-trace <source.sio>  Probe traced IR lowering path with stage counters")
    println("  --probe-native-streaming <source.sio>  Probe summary/body/native-v2 status for the single-module streaming path")
    println("  --probe-ir-callsite <source.sio> <caller_fn> <callee_fn>  Probe lowered callsite hidden-arg behavior")
    println("  --probe-ir-opt-strategy <source.sio>  Probe ir_opt_apply_strategy() on instrumented IR fns")
    println("  --probe-wasm-dispatch <source.sio> [out.wasm]  Probe wasm dispatch marker path")
    println("  --show-profile <file>  Inspect .sprof profile and show promotion decisions")
    println("  --use-profile <file>   Apply .sprof profile for strategy promotion")
    println("  --verify-claims        Execute claim gates after type-check, before codegen (self-falsifying compiler)")
    println("  -h, --help             Print this help message")
    println("")
    println("Examples:")
    println("  souc hello.sio")
    println("  souc hello.sio -o hello")
    println("  souc hello.sio -t wasm -o hello.wasm")
}

fn parse_options(args: ArgList) -> CompilerOptions with IO, Mut, Panic, Div {
    var input_file = ""
    var output_file = "a.out"
    var target = "native"
    var optimize = false
    var cache_dir = ""
    var cache_mode = "off"
    var cache_stats = false
    var verbose = false
    var emit_ast = false
    var emit_tokens = false
    var emit_manifest = false
    var gpu_target = ""
    var gpu_binary_format = ""
    var gpu_strict_parity = false
    var debug_witnesses = false
    var use_profile = false
    var use_profile_path = ""
    var verify_claims = false

    var i: i64 = 0
    while i < args.len {
        let arg = arg_list_get(args, i)

        if arg == "-o" || arg == "--output" {
            i = i + 1
            if i < args.len {
                output_file = arg_list_get(args, i)
            }
        }
        else if arg == "-t" || arg == "--target" {
            i = i + 1
            if i < args.len {
                target = arg_list_get(args, i)
            }
        }
        else if arg == "-O" || arg == "--optimize" {
            optimize = true
        }
        else if arg == "--cache-dir" {
            i = i + 1
            if i < args.len {
                cache_dir = arg_list_get(args, i)
            }
        }
        else if arg == "--cache-mode" {
            i = i + 1
            if i < args.len {
                cache_mode = arg_list_get(args, i)
            }
        }
        else if arg == "--cache-stats" {
            cache_stats = true
        }
        else if arg == "-v" || arg == "--verbose" {
            verbose = true
        }
        else if arg == "--emit-ast" {
            emit_ast = true
        }
        else if arg == "--emit-tokens" {
            emit_tokens = true
        }
        else if arg == "--emit-manifest" {
            emit_manifest = true
        }
        else if arg == "--gpu-target" {
            i = i + 1
            if i < args.len {
                gpu_target = arg_list_get(args, i)
            }
        }
        else if arg == "--gpu-binary-format" {
            i = i + 1
            if i < args.len {
                gpu_binary_format = arg_list_get(args, i)
            }
        }
        else if arg == "--gpu-strict-parity" {
            gpu_strict_parity = true
        }
        else if arg == "--gpu-fuse-epistemic" {
            gpu_binary_format = "epistemic-fused"
        }
        else if arg == "--gpu-speculative" {
            gpu_binary_format = "speculative"
        }
        else if arg == "--gpu-dag-schedule" {
            gpu_binary_format = "dag-scheduled"
        }
        else if arg == "--debug-witnesses" {
            debug_witnesses = true
        }
        else if arg == "--use-profile" {
            i = i + 1
            if i < args.len {
                use_profile_path = arg_list_get(args, i)
                use_profile = true
            }
        }
        else if arg == "--verify-claims" {
            verify_claims = true
        }
        else if arg == "-h" || arg == "--help" {
            print_help()
            exit_process(0)
        }
        else if str_char_at(arg, 0) != 45 {
            input_file = arg
        }

        i = i + 1
    }

    if input_file == "" {
        println("Error: No input file specified")
        print_help()
        exit_process(1)
    }

    CompilerOptions {
        input_file: input_file,
        output_file: output_file,
        target: target,
        optimize: optimize,
        cache_dir: cache_dir,
        cache_mode: cache_mode,
        cache_stats: cache_stats,
        verbose: verbose,
        emit_ast: emit_ast,
        emit_tokens: emit_tokens,
        emit_manifest: emit_manifest,
        gpu_target: gpu_target,
        gpu_binary_format: gpu_binary_format,
        gpu_strict_parity: gpu_strict_parity,
        debug_witnesses: debug_witnesses,
        use_profile: use_profile,
        use_profile_path: use_profile_path,
        verify_claims: verify_claims,
    }
}

fn compiler_manifest_empty_name() -> Name {
    Name { buf: [0; 128], len: 0 }
}

fn compiler_manifest_print_name(name: Name) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < name.len {
        print_char(name.buf[i] as i64)
        i = i + 1
    }
}

fn compiler_manifest_print_name_json(name: Name) with IO, Mut, Panic, Div {
    print("\"")
    compiler_manifest_print_name(name)
    print("\"")
}

fn compiler_manifest_print_string_json(s: string) with IO {
    print("\"")
    print(s)
    print("\"")
}

fn compiler_manifest_print_f64_json(value: f64) with IO, Div, Panic {
    let abs_value = if value < 0.0 { 0.0 - value } else { value }
    let scaled = (abs_value * 1000.0) as i64
    let whole = scaled / 1000
    let frac = scaled - whole * 1000
    if value < 0.0 {
        print("-")
    }
    print_int(whole)
    print(".")
    if frac < 100 { print("0") }
    if frac < 10 { print("0") }
    print_int(frac)
}

fn compiler_manifest_type_list_get(opt: Option<Box<TypeEntryList>>, idx: i64) -> TypeEntry with Panic, Div, Alloc {
    match opt {
        None => empty_type_entry(),
        Some(list) => {
            if idx <= 0 { (*list).head } else { compiler_manifest_type_list_get((*list).tail, idx - 1) }
        }
    }
}

fn compiler_manifest_print_type_name(ty: TypeEntry) with IO, Mut, Panic, Div, Alloc {
    if ty.kind == TypeKind::TyI8 { print("i8"); return }
    if ty.kind == TypeKind::TyI32 { print("i32"); return }
    if ty.kind == TypeKind::TyI64 { print("i64"); return }
    if ty.kind == TypeKind::TyU8 { print("u8"); return }
    if ty.kind == TypeKind::TyU32 { print("u32"); return }
    if ty.kind == TypeKind::TyU64 { print("u64"); return }
    if ty.kind == TypeKind::TyF32 { print("f32"); return }
    if ty.kind == TypeKind::TyF64 { print("f64"); return }
    if ty.kind == TypeKind::TyBool { print("bool"); return }
    if ty.kind == TypeKind::TyUnit { print("()"); return }
    if ty.kind == TypeKind::TyString { print("string"); return }
    if ty.kind == TypeKind::TyChar { print("char"); return }
    if ty.kind == TypeKind::TyNamed { compiler_manifest_print_name(ty.name); return }
    if ty.kind == TypeKind::TyModel {
        print("Model<")
        compiler_manifest_print_type_name(compiler_manifest_type_list_get(ty.tuple_elems, 0))
        print(", ")
        compiler_manifest_print_type_name(compiler_manifest_type_list_get(ty.tuple_elems, 1))
        print(">")
        return
    }
    if ty.kind == TypeKind::TyModelFamily {
        print("ModelFamily<")
        compiler_manifest_print_type_name(compiler_manifest_type_list_get(ty.tuple_elems, 0))
        print(", ")
        compiler_manifest_print_type_name(compiler_manifest_type_list_get(ty.tuple_elems, 1))
        print(">")
        return
    }
    if ty.kind == TypeKind::TyKnowledge
        || ty.kind == TypeKind::TyPolicy
        || ty.kind == TypeKind::TyDecisionPolicy
        || ty.kind == TypeKind::TyDeferralPolicy
        || ty.kind == TypeKind::TyAcquisitionPolicy
        || ty.kind == TypeKind::TyAcquisitionPlan
        || ty.kind == TypeKind::TyRecoursePolicy
        || ty.kind == TypeKind::TyRecoursePlan
        || ty.kind == TypeKind::TyTransitionPolicy
        || ty.kind == TypeKind::TyTransitionPlan
        || ty.kind == TypeKind::TyAlternativePolicy
        || ty.kind == TypeKind::TyAlternativeSet
        || ty.kind == TypeKind::TyAlternativeOption
        || ty.kind == TypeKind::TyContest
        || ty.kind == TypeKind::TyRobust
        || ty.kind == TypeKind::TyIntervention
        || ty.kind == TypeKind::TyCounterfactual
        || ty.kind == TypeKind::TyValidated
        || ty.kind == TypeKind::TyAdmissible
        || ty.kind == TypeKind::TyDeferred
        || ty.kind == TypeKind::TyValidation {
        if ty.kind == TypeKind::TyKnowledge { print("Knowledge<") }
        else if ty.kind == TypeKind::TyPolicy { print("Policy<") }
        else if ty.kind == TypeKind::TyDecisionPolicy { print("DecisionPolicy<") }
        else if ty.kind == TypeKind::TyDeferralPolicy { print("DeferralPolicy<") }
        else if ty.kind == TypeKind::TyAcquisitionPolicy { print("AcquisitionPolicy<") }
        else if ty.kind == TypeKind::TyAcquisitionPlan { print("AcquisitionPlan<") }
        else if ty.kind == TypeKind::TyRecoursePolicy { print("RecoursePolicy<") }
        else if ty.kind == TypeKind::TyRecoursePlan { print("RecoursePlan<") }
        else if ty.kind == TypeKind::TyTransitionPolicy { print("TransitionPolicy<") }
        else if ty.kind == TypeKind::TyTransitionPlan { print("TransitionPlan<") }
        else if ty.kind == TypeKind::TyAlternativePolicy { print("AlternativePolicy<") }
        else if ty.kind == TypeKind::TyAlternativeSet { print("AlternativeSet<") }
        else if ty.kind == TypeKind::TyAlternativeOption { print("AlternativeOption<") }
        else if ty.kind == TypeKind::TyContest { print("Contest<") }
        else if ty.kind == TypeKind::TyRobust { print("Robust<") }
        else if ty.kind == TypeKind::TyIntervention { print("Intervention<") }
        else if ty.kind == TypeKind::TyCounterfactual { print("Counterfactual<") }
        else if ty.kind == TypeKind::TyValidated { print("Validated<") }
        else if ty.kind == TypeKind::TyAdmissible { print("Admissible<") }
        else if ty.kind == TypeKind::TyDeferred { print("Deferred<") }
        else { print("Validation<") }
        match ty.inner {
            Some(inner) => compiler_manifest_print_type_name(*inner)
            None => print("?")
        }
        print(">")
        return
    }
    print("<unknown>")
}

fn compiler_manifest_metric_name(metric_id: i64) -> string {
    if metric_id == 0 { "sign_consensus" }
    else if metric_id == 1 { "relative_band" }
    else if metric_id == 2 { "max_tail_risk" }
    else if metric_id == 3 { "mechanistic_divergence" }
    else if metric_id == 4 { "identifiability_floor" }
    else if metric_id == 5 { "counterexample_present" }
    else if metric_id == 6 { "deferred_reason" }
    else { "unknown_metric" }
}

fn compiler_manifest_policy_name(ep: &IrEpistemicSection, id: i64) -> Name with Panic, Div {
    if id >= 0 && id < (*ep).policy_count { (*ep).policies[id].name } else { compiler_manifest_empty_name() }
