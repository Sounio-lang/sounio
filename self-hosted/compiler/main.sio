// T164: Comparison chain fold: r0=5; r1=3; r2=(r0 > r1) → r2=IrLoadImm(1).
fn compiler_main_test_cmp_chain_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 5)
    instrs[1] = ir_load_imm(1, 3)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpGt, 1)
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    result.instrs[2].op == IrOpcode::IrLoadImm && result.instrs[2].imm_i64 == 1
}

// T165: Block E + DCE chain: r2=(5==5) folds to IrLoadImm(1); r0,r1 become dead → IrNop.
fn compiler_main_test_block_e_dce_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 5)
    instrs[1] = ir_load_imm(1, 5)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpEq, 1)
    instrs[3] = ir_return(2)
    let func   = cp_make_test_func(instrs, 4)
    let result = opt_cleanup_function(func)
    // After const_fold: instrs[2] → IrLoadImm(2, 1) (5==5 → 1); r0,r1 become dead.
    result.instrs[2].op == IrOpcode::IrLoadImm && result.instrs[2].imm_i64 == 1
}

// ============================================================================
// Sprint 75: Conditional branch folding Block F self-tests (T169–T174)
// ============================================================================

// T169: IrBranchTrue with const-1 condition → IrJump (branch always taken).
fn compiler_main_test_branch_true_const_taken() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 1)
    instrs[1] = ir_branch_true(0, 7)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrJump && result.instrs[1].label_id == 7
}

// T170: IrBranchTrue with const-0 condition → IrNop (branch never taken).
fn compiler_main_test_branch_true_const_not_taken() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 0)
    instrs[1] = ir_branch_true(0, 7)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrNop
}

// T171: IrBranchFalse with const-0 condition → IrJump (condition false → branch taken).
fn compiler_main_test_branch_false_const_taken() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 0)
    instrs[1] = ir_branch_false(0, 11)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrJump && result.instrs[1].label_id == 11
}

// T172: IrBranchFalse with const-1 condition → IrNop (condition true → branch not taken).
fn compiler_main_test_branch_false_const_not_taken() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 1)
    instrs[1] = ir_branch_false(0, 11)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrNop
}

// T173: IrBranchTrue with non-constant condition → left unchanged (no fold).
fn compiler_main_test_branch_no_fold_nonconstant() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(1, 0, BinaryOp::OpAdd, 2)   // r1 = r0 + r2 (non-const)
    instrs[1] = ir_branch_true(1, 7)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrBranchTrue
}

// T174: Block E → Block F chain: x==x folds to 1 (Block E), then BranchTrue(1) → IrJump (Block F).
fn compiler_main_test_branch_fold_chain_e_f() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 3)                      // r0 = 3
    instrs[1] = ir_binop(1, 0, BinaryOp::OpEq, 0)     // r1 = (r0 == r0) → Block E: IrLoadImm(1,1)
    instrs[2] = ir_branch_true(1, 9)                    // BranchTrue(r1,9) → Block F: IrJump(9)
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    result.instrs[2].op == IrOpcode::IrJump && result.instrs[2].label_id == 9
}

// ============================================================================
// Sprint 76: Shift identity/annihilator folding Block G self-tests (T175–T180)
// ============================================================================

// T175: x << 0 → IrCopy(x) — shift-by-zero identity (OpShl, right-const=0).
fn compiler_main_test_shl_by_zero() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 0)                          // r1 = 0 (shift amount)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpShl, 1)        // r2 = r0 << r1 (r0 unknown, r1=0)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrCopy && result.instrs[1].src1 == 0
}

// T176: x >> 0 → IrCopy(x) — shift-by-zero identity (OpShr, right-const=0).
