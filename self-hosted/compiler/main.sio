    if compiler_main_test_ch_no_fold_diff_base() {
        passed = passed + 1
        println("  T701 OK: Sprint 172 Block CH: (r0*3)-r1 no fold")
    } else { println("  FAIL: T701") }
    if compiler_main_test_ch_no_fold_rr_sub() {
