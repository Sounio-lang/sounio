// ============================================================================
// Sprint 62: 4-preg register allocation self-tests (T30-T37)
// ============================================================================

// T30: preg_to_x86_reg maps all 4 pregs correctly
fn compiler_main_test_multipreg_map() -> bool {
    if preg_to_x86_reg(0) != 15 { return false }  // r15
    if preg_to_x86_reg(1) != 14 { return false }  // r14
    if preg_to_x86_reg(2) != 13 { return false }  // r13
    if preg_to_x86_reg(3) != 12 { return false }  // r12
    true
}

// T31: 2 non-overlapping vregs → 2 pregs assigned, 0 spilled
fn compiler_main_test_multipreg_two_fit() -> bool with Mut, Div, Panic {
    var ra_instrs: [RaSimpleInstr; 512] = [ra_empty_simple_instr(); 512]
    ra_instrs[0 as usize] = ra_simple_instr(0, -1, -1)
    ra_instrs[1 as usize] = ra_simple_instr(-1, 0, -1)
    ra_instrs[2 as usize] = ra_simple_instr(1, -1, -1)
    ra_instrs[3 as usize] = ra_simple_instr(-1, 1, -1)
    var state = liveness_compute_intervals(ra_instrs, 4)
    state = regalloc_linear_scan(state, 4)
    let spilled = regalloc_count_spilled(state)
    if spilled != 0 { return false }
    let assigned = regalloc_count_assigned(state)
    if assigned < 2 { return false }
    regalloc_verify_no_conflicts(state)
}

// T32: 4 non-overlapping vregs → all 4 pregs used, 0 spilled
fn compiler_main_test_multipreg_four_fit() -> bool with Mut, Div, Panic {
    var ra_instrs: [RaSimpleInstr; 512] = [ra_empty_simple_instr(); 512]
    var i = 0
    while i < 4 {
        ra_instrs[(i * 2) as usize]     = ra_simple_instr(i, -1, -1)
        ra_instrs[(i * 2 + 1) as usize] = ra_simple_instr(-1, i, -1)
        i = i + 1
    }
    var state = liveness_compute_intervals(ra_instrs, 8)
    state = regalloc_linear_scan(state, 4)
    let spilled = regalloc_count_spilled(state)
    if spilled != 0 { return false }
    let assigned = regalloc_count_assigned(state)
    if assigned < 4 { return false }
    regalloc_verify_no_conflicts(state)
}

// T33: 5 overlapping vregs with 4 pregs → exactly 1 spill
fn compiler_main_test_multipreg_spill_one() -> bool with Mut, Div, Panic {
    var ra_instrs: [RaSimpleInstr; 512] = [ra_empty_simple_instr(); 512]
    // Define all 5 at pos 0, use all at pos 1 (all live simultaneously)
    var i = 0
    while i < 5 {
        ra_instrs[i as usize] = ra_simple_instr(i, -1, -1)
        i = i + 1
    }
    var j = 5
    while j < 10 {
        ra_instrs[j as usize] = ra_simple_instr(-1, j - 5, -1)
        j = j + 1
    }
    var state = liveness_compute_intervals(ra_instrs, 10)
    state = regalloc_linear_scan(state, 4)
    let spilled = regalloc_count_spilled(state)
    if spilled < 1 { return false }
    regalloc_verify_no_conflicts(state)
}

// T34: prologue byte count == 12 with frame_size=0
fn compiler_main_test_multipreg_prologue_bytes() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = emit_prologue(buf, 0)
    // push_r15(2)+push_r14(2)+push_r13(2)+push_r12(2)+push_rbp(1)+mov_rbp_rsp(3) = 12
    buf.len == 12
}

// T35: prologue starts with push r15 (41 57) then push r14 (41 56)
fn compiler_main_test_multipreg_prologue_prefix() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = emit_prologue(buf, 0)
    if buf.bytes[0 as usize] != 0x41 as i8 { return false }
    if buf.bytes[1 as usize] != 0x57 as i8 { return false }  // push r15
    if buf.bytes[2 as usize] != 0x41 as i8 { return false }
    if buf.bytes[3 as usize] != 0x56 as i8 { return false }  // push r14
    true
}

// T36: epilogue byte count == 13; last byte == 0xC3 (RET)
fn compiler_main_test_multipreg_epilogue_bytes() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = emit_epilogue(buf)
    // mov_rsp_rbp(3)+pop_rbp(1)+pop_r12(2)+pop_r13(2)+pop_r14(2)+pop_r15(2)+ret(1) = 13
    if buf.len != 13 { return false }
    if buf.bytes[12 as usize] != 0xC3 as i8 { return false }
    true
}

// T37: regalloc_linear_scan(state, 4) produces valid state (regression + 4-preg)
fn compiler_main_test_multipreg_regalloc_four() -> bool with Mut, Div, Panic {
    var ra_instrs: [RaSimpleInstr; 512] = [ra_empty_simple_instr(); 512]
    ra_instrs[0 as usize] = ra_simple_instr(0, -1, -1)
    ra_instrs[1 as usize] = ra_simple_instr(-1, 0, -1)
    var state = liveness_compute_intervals(ra_instrs, 2)
    state = regalloc_linear_scan(state, 4)
    let a0 = regalloc_get_assignment(state, 0)
    if a0 < 0 { return false }  // must be assigned (not spilled)
    regalloc_verify_no_conflicts(state)
}

// ============================================================================
// Sprint 54: TCO wiring self-tests (T38-T45)
// ============================================================================

// T38: tco_is_tail_position detects call immediately before return
fn compiler_main_test_tco_tail_position() -> bool with Mut, Div, Panic {
    let func = tco_make_self_tail_call_func(0, 0, 1)
    var call_idx: i64 = 0
    var si: i64 = 0
    while si < func.instr_count {
        if tco_is_call(func.instrs[si as usize]) { call_idx = si }
        si = si + 1
    }
    tco_is_tail_position(func, call_idx)
}

// T39: tco_is_self_call detects fn_id matching function's own id
fn compiler_main_test_tco_is_self_call() -> bool with Mut, Div, Panic {
    let func = tco_make_self_tail_call_func(0, 0, 1)
    var call_idx: i64 = 0
    var si: i64 = 0
    while si < func.instr_count {
        if tco_is_call(func.instrs[si as usize]) { call_idx = si }
        si = si + 1
    }
    tco_is_self_call(func, call_idx)
}

// T40: tco_run_pass transforms self-recursive tail call (stats.transformed == 1)
fn compiler_main_test_tco_run_pass_transforms() -> bool with Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    funcs[0 as usize] = tco_make_self_tail_call_func(0, 2, 0)
    let module = tco_make_test_module(funcs, 1)
    let result = tco_run_pass(module)
    let out_module = result.0
    let ctx = result.1
    let out_func = out_module.functions[0]
    var saw_jump = false
    var saw_self_call = false
    var i: i64 = 0
    while i < out_func.instr_count {
        let instr = out_func.instrs[i as usize]
        if instr.op == IrOpcode::IrJump {
            saw_jump = true
        }
        if instr.op == IrOpcode::IrCall && ir_name_eq(instr.name, out_func.name) {
            saw_self_call = true
        }
        i = i + 1
    }
    (ctx.stats.transformed > 0 || saw_jump) && !saw_self_call
}

// T41: tco_run_pass leaves non-tail call unchanged (stats.transformed == 0)
fn compiler_main_test_tco_run_pass_no_transform() -> bool with Mut, Div, Panic {
    let target_name = tco_make_func_name(103 as i8, 1)
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    funcs[0 as usize] = tco_make_non_tail_call_func(0, target_name, 1)
    funcs[1 as usize] = tco_make_test_func(1, 3)
    let module = tco_make_test_module(funcs, 2)
    let result = tco_run_pass(module)
    let ctx = result.1
    ctx.stats.transformed == 0
}

// T42: tco_check_eligibility rejects function with IrAlloc
fn compiler_main_test_tco_eligibility_alloc() -> bool with Mut, Div, Panic {
    let func = tco_make_func_with_alloca(0)
    let info = tco_analyze_function(func, 0)
    let check = tco_check_eligibility(func, info)
    let eligible = check.0
    !eligible
}

// T43: tco_analyze_function populates correct func_id
fn compiler_main_test_tco_analyze_function() -> bool with Mut, Div, Panic {
    let func = tco_make_self_tail_call_func(7, 0, 0)
    let info = tco_analyze_function(func, 7)
    info.func_id == 7
}

// T44: tco_count_tail_calls_for_func returns 1 for single self-tail call
fn compiler_main_test_tco_count_tail_calls() -> bool with Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    funcs[0 as usize] = tco_make_self_tail_call_func(0, 0, 0)
    let module = tco_make_test_module(funcs, 1)
    var ctx = tco_context_new()
    ctx = tco_discover_tail_calls(ctx, module)
    let count = tco_count_tail_calls_for_func(ctx, 0)
    count == 1
}

// T45: tco_run_pass on empty module returns fn_count unchanged
fn compiler_main_test_tco_empty_module() -> bool with Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let module = tco_make_test_module(funcs, 0)
    let result = tco_run_pass(module)
    let out_module = result.0
    out_module.fn_count == 0
}

