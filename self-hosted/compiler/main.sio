fn compiler_manifest_hash_string(s: string) -> i64 with Mut, Panic, Div {
    var hash: i64 = 5381
    let modp: i64 = 2147483647
    var i: i64 = 0
    while i < str_len(s) {
        let ch = str_char_at(s, i) as i64
        hash = ((hash * 131) + ch) % modp
        i = i + 1
    }
    hash
}

fn compiler_manifest_merkle_mix(a: i64, b: i64, c: i64, salt: i64) -> i64 {
    let modp: i64 = 2147483647
    (((a % modp) * 31) + ((b % modp) * 131) + ((c % modp) * 17) + salt) % modp
}

fn compiler_emit_manifest_json(path: string, ep: &IrEpistemicSection) with IO, Mut, Panic, Div, Alloc {
    let source_hash = compiler_manifest_hash_string(path)
    let version_hash = compiler_manifest_hash_string("0.80.0-selfhost")
    let merkle_root = compiler_manifest_merkle_mix(source_hash, version_hash, 0, 97)
    var i: i64 = 0

    print("{\n")
    print("  \"schema\": \"sounio.manifest.v2\",\n")
    print("  \"version\": \"0.80.0-selfhost\",\n")
    print("  \"path\": ")
    compiler_manifest_print_string_json(path)
    print(",\n")
    print("  \"source_hash\": ")
    print_int(source_hash)
    print(",\n")
    print("  \"merkle_root\": ")
    print_int(merkle_root)
    print(",\n")
    print("  \"epistemic\": {\n")

    compiler_manifest_print_model_families(ep)
    compiler_manifest_print_policies(ep)
    compiler_manifest_print_decision_policies(ep)

    compiler_manifest_print_deferral_policies(ep)
    compiler_manifest_print_acquisition_policies(ep)

    compiler_manifest_print_recourse_policies(ep)
    compiler_manifest_print_transition_policies(ep)

    print("    \"alternative_policies\": [\n")
    i = 0
    while i < (*ep).alternative_policy_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int((*ep).alternative_policies[i].id)
        print(", \"name\": ")
        compiler_manifest_print_name_json((*ep).alternative_policies[i].name)
        print(", \"target_type\": \"")
        compiler_manifest_print_type_name((*ep).alternative_policies[i].target_ty)
        print("\", \"frontier_kind\": ")
        compiler_manifest_print_name_json((*ep).alternative_policies[i].frontier_kind)
        print(", \"max_options\": ")
        print_int((*ep).alternative_policies[i].max_options)
        print(", \"objectives\": [")
        var ao: i64 = 0
        while ao < (*ep).alternative_policies[i].objective_count && ao < 8 {
            if ao > 0 { print(", ") }
            print("{\"name\": ")
            compiler_manifest_print_name_json((*ep).alternative_policies[i].objective_names[ao])
            print(", \"direction\": ")
            if (*ep).alternative_policies[i].objective_directions[ao] == 1 {
                compiler_manifest_print_string_json("maximize")
            } else {
                compiler_manifest_print_string_json("minimize")
            }
            print("}")
            ao = ao + 1
        }
        print("]}")
        i = i + 1
    }
    print("\n    ],\n")

    print("    \"validations\": [\n")
    i = 0
    while i < (*ep).validation_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
