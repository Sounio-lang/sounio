fn compiler_manifest_print_acquisition_policies(ep: &IrEpistemicSection) with IO, Mut, Panic, Div, Alloc {
    print("    \"acquisition_policies\": [\n")
    var i: i64 = 0
    while i < (*ep).acquisition_policy_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
