// ============================================================================
// STRING UTILITIES
// ============================================================================

fn pow10_idx(idx: i64) -> i64 {
    if idx == 0 { 1000000000000000000 }
    else if idx == 1 { 100000000000000000 }
    else if idx == 2 { 10000000000000000 }
    else if idx == 3 { 1000000000000000 }
    else if idx == 4 { 100000000000000 }
    else if idx == 5 { 10000000000000 }
    else if idx == 6 { 1000000000000 }
    else if idx == 7 { 100000000000 }
    else if idx == 8 { 10000000000 }
    else if idx == 9 { 1000000000 }
    else if idx == 10 { 100000000 }
    else if idx == 11 { 10000000 }
    else if idx == 12 { 1000000 }
    else if idx == 13 { 100000 }
    else if idx == 14 { 10000 }
    else if idx == 15 { 1000 }
    else if idx == 16 { 100 }
    else if idx == 17 { 10 }
    else { 1 }
}

fn digit_for_power(rem: i64, power: i64) -> i64 {
    if rem <= (0 - (9 * power)) { 9 }
    else if rem <= (0 - (8 * power)) { 8 }
    else if rem <= (0 - (7 * power)) { 7 }
    else if rem <= (0 - (6 * power)) { 6 }
    else if rem <= (0 - (5 * power)) { 5 }
    else if rem <= (0 - (4 * power)) { 4 }
    else if rem <= (0 - (3 * power)) { 3 }
    else if rem <= (0 - (2 * power)) { 2 }
    else if rem <= (0 - power) { 1 }
    else { 0 }
}

fn i64_to_digits_no_div(rem: i64, idx: i64, started: bool) -> string with Mut, Panic {
    if idx >= 19 {
        return ""
    }

    let power = pow10_idx(idx)
    let digit = digit_for_power(rem, power)
    let rem_next = rem + (digit * power)
    let emit = started || digit > 0 || idx == 18
    let head = if emit { char_from_i64(digit) } else { "" }
    head + i64_to_digits_no_div(rem_next, idx + 1, emit)
}

fn i64_to_string_no_div(n: i64) -> string with Mut, Panic {
    if n == 0 {
        return "0"
    }
    let negative = n < 0
    let rem = if negative { n } else { 0 - n }
    let digits = i64_to_digits_no_div(rem, 0, false)
    if negative { "-" + digits } else { digits }
}

fn char_from_i64_error(n: i64) -> string with Mut, Panic {
    "char_from_i64: digit must be 0-9, got " + i64_to_string_no_div(n)
}

fn parse_decimal_digit(ch: string) -> i64 {
    if str_eq(ch, "0") { 0 }
    else if str_eq(ch, "1") { 1 }
    else if str_eq(ch, "2") { 2 }
    else if str_eq(ch, "3") { 3 }
    else if str_eq(ch, "4") { 4 }
    else if str_eq(ch, "5") { 5 }
    else if str_eq(ch, "6") { 6 }
    else if str_eq(ch, "7") { 7 }
    else if str_eq(ch, "8") { 8 }
    else if str_eq(ch, "9") { 9 }
    else { -1 }
}

fn parse_nonnegative_i64(raw: string) -> i64 with Mut, Div {
    let len = str_len(raw)
    if len <= 0 {
        return -1
    }

    var i: i64 = 0
    var value: i64 = 0
    while i < len {
        let ch = str_slice(raw, i, i + 1)
        let d = parse_decimal_digit(ch)
        if d < 0 {
            return -1
        }
        value = value * 10 + d
        i = i + 1
    }
    value
}

fn parse_i64_decimal(raw: string) -> (bool, i64) with Mut, Div {
    let len = str_len(raw)
    if len <= 0 {
        return (false, 0)
    }

    if str_char_at(raw, 0) == 45 {
        if len == 1 {
            return (false, 0)
        }
        let tail = str_slice(raw, 1, len)
        let mag = parse_nonnegative_i64(tail)
        if mag < 0 {
            return (false, 0)
        }
        (true, 0 - mag)
    } else {
        let val = parse_nonnegative_i64(raw)
        if val < 0 {
            (false, 0)
        } else {
            (true, val)
        }
    }
}

fn run_int_to_string_bench(iterations: i64) -> i64 with Mut, Panic, Div {
    let i64_max = 9223372036854775807
    let i64_min = (0 - i64_max) - 1
    var checksum: i64 = 0
    var i: i64 = 0
    while i < iterations {
        var sample = (i * 1000003) - 500001
        if (i % 11) == 0 {
            sample = 0 - sample
        }
        if (i % 7919) == 0 {
            sample = i64_min
        }
        let rendered = int_to_string(sample)
        checksum = checksum + str_len(rendered)
        i = i + 1
    }
    checksum
}

fn run_int_to_string_bench_from_args(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div {
    var iterations: i64 = 1000000
    if flag_index + 1 < args.len {
        let parsed = parse_nonnegative_i64(arg_list_get(args, flag_index + 1))
        if parsed >= 0 {
            iterations = parsed
        }
    }
    let checksum = run_int_to_string_bench(iterations)
    println("bench_int_to_string iterations=" + int_to_string(iterations) +
            " checksum=" + int_to_string(checksum))
}

