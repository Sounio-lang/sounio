    (IR_A_OP[(ir_region_slot_r(opt.region, (2))) as usize] as IrOpcode) != IrOpcode::IrBinOp
        || (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (2))) as usize] as BinaryOp) != BinaryOp::OpAdd
        || IR_A_SRC1[(ir_region_slot_r(opt.region, (2))) as usize] != 2
        || IR_A_SRC2[(ir_region_slot_r(opt.region, (2))) as usize] != 2
}

