struct CompilerOptions {
    input_file: string,
    output_file: string,
    target: string,
    optimize: bool,
    cache_dir: string,
    cache_mode: string,
    cache_stats: bool,
    verbose: bool,
    emit_ast: bool,
    emit_tokens: bool,
    emit_manifest: bool,
    gpu_target: string,
    gpu_binary_format: string,
    gpu_strict_parity: bool,
    // Sprint 28: Debug-mode witness enforcement
    debug_witnesses: bool,
    // Sprint 47: .sprof profile-guided strategy promotion
    use_profile: bool,
    use_profile_path: string,
}

struct CompileResult {
    success: bool,
    errors: CompileErrors,
    output: string,
}

struct CompilerIrLoadResult {
    ok: bool,
    errors: CompileErrors,
    module: IrModule,
}

struct CompilerManifestLoadResult {
    ok: bool,
    errors: CompileErrors,
    epistemic: IrEpistemicSection,
}

fn compiler_ir_load_result_error(errors: CompileErrors) -> CompilerIrLoadResult {
    CompilerIrLoadResult {
        ok: false,
        errors: errors,
        module: ir_empty_module(),
    }
}

fn compiler_ir_load_result_ok(module: IrModule) -> CompilerIrLoadResult {
    CompilerIrLoadResult {
        ok: true,
        errors: compile_errors_new(),
        module: module,
    }
}

fn compiler_manifest_load_result_error(errors: CompileErrors) -> CompilerManifestLoadResult {
    CompilerManifestLoadResult {
        ok: false,
        errors: errors,
        epistemic: ir_empty_epistemic_section(),
    }
}

fn compiler_manifest_load_result_ok(epistemic: IrEpistemicSection) -> CompilerManifestLoadResult {
    CompilerManifestLoadResult {
        ok: true,
        errors: compile_errors_new(),
        epistemic: epistemic,
    }
}

fn get_args() -> ArgList with IO, Mut, Panic, Div {
    var args = ArgList {
        items: ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        len: 0,
    }
    let argc = arg_count()
    var i: i64 = 0
    while i < argc && i < 64 {
        args.items[i as usize] = get_arg(i)
        i = i + 1
    }
    args.len = i
    args
}

fn exit_process(code: i64) {
}

fn compiler_mode_output_path(args: ArgList, fallback: string) -> string with Mut, Panic, Div {
    var i: i64 = 0
    while i < args.len {
        let arg = arg_list_get(args, i)
        if arg == "-o" || arg == "--output" {
            if i + 1 < args.len {
                return arg_list_get(args, i + 1)
            }
            return fallback
        }
        i = i + 1
    }
    return fallback
}

fn compiler_mode_source_arg(args: ArgList, flag_index: i64, mode_name: string) -> string with Mut, Panic, Div {
    var i: i64 = flag_index + 1
    while i < args.len {
        let arg = arg_list_get(args, i)
        if arg == "-o" || arg == "--output" {
            i = i + 2
        } else if str_len(arg) > 0 && str_char_at(arg, 0) != 45 {
            return arg
        } else {
            i = i + 1
        }
    }
    panic(mode_name + ": missing source file argument")
    return ""
}

fn compiler_mode_has_flag(args: ArgList, needle: string) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < args.len {
        if arg_list_get(args, i) == needle {
            return true
        }
        i = i + 1
    }
    false
}

fn compiler_mode_option_string(args: ArgList, short_flag: string, long_flag: string, fallback: string) -> string with Mut, Panic, Div {
    var i: i64 = 0
    while i < args.len {
        let arg = arg_list_get(args, i)
        if arg == short_flag || arg == long_flag {
            if i + 1 < args.len {
                return arg_list_get(args, i + 1)
            }
            return fallback
        }
        i = i + 1
    }
    fallback
}

fn compiler_check_ok_message() -> string {
    return "check: OK"
}

fn compiler_ir_dump_summary(bytes: i64, functions: i64, strings: i64) -> string with Mut, Panic, Div {
    return "ir-dump: SOIR v2 binary, " + int_to_string(bytes) +
        " bytes, " + int_to_string(functions) +
        " functions, " + int_to_string(strings) + " strings"
}

fn compiler_ir_roundtrip_summary(bytes: i64, functions: i64) -> string with Mut, Panic, Div {
    return "ir-roundtrip: OK bytes=" + int_to_string(bytes) +
        " functions=" + int_to_string(functions)
}

fn compiler_native_compile_summary(output_path: string) -> string with Mut {
    return "Native compilation successful: output=" + output_path
}

fn compiler_print_errors(errs: CompileErrors) with IO, Mut, Div {
    var i: i64 = 0
    while i < errs.len {
        println(compile_errors_get(errs, i))
        i = i + 1
    }
}

fn compiler_print_ir_preflight_failure(reason: string) with IO, Mut, Panic, Div {
    var errs = compile_errors_new()
    if str_len(reason) > 0 {
        errs = compile_push_ir_failure(errs, reason)
    }
    let parse_errors = parser_last_error_count()
    if parse_errors > 0 {
        errs = compile_errors_push(errs, "error: parser reported " + int_to_string(parse_errors) + " syntax errors")
    }
    if errs.len == 0 {
        errs = compile_errors_push(errs, "error: IR preflight failed")
    }
    compiler_print_errors(errs)
}

fn compiler_preflight_source_input(path: string) -> bool with IO, Mut, Panic, Div {
    if file_size(path) <= 0 {
        println(compile_format_error_at(path, 0, 0, "could not read input file"))
        return false
    }

    let incomplete_assign = compile_scan_incomplete_assignment(path)
    if incomplete_assign.0 {
        println(compile_format_error_at(path, incomplete_assign.1, incomplete_assign.2, "syntax appears incomplete after assignment"))
        return false
    }

    true
}

fn compiler_is_render_fixture(path: string) -> bool with Mut, Panic, Div {
    starts_with(path, "examples/render/")
}

fn compiler_try_single_module_check(path: string) -> i64 with IO, Mut, Panic, Div, Alloc {
    let program = load_module_file(path)
    let parse_errors = parser_last_error_count()
    if parse_errors > 0 {
        println("error: parser reported " + int_to_string(parse_errors) + " syntax errors")
        return 0 - 1
    }

    let imports = extract_imports_from_ast(program)
    if imports.count > 0 {
        return 0
    }

    let resolve_result = resolve_program(program)
    if resolve_result.had_error {
        println("error: module resolution failed")
        return 0 - 1
    }

    let check_result = check_program(program)
    if check_result.had_error {
        println("error: type checking failed")
        return 0 - 1
    }

    1
}

fn compiler_count_params(opt: Option<Box<ParamList>>) -> i64 {
    var count: i64 = 0
    var cur = opt
    var done = false
    while !done {
        match cur {
            Some(list) => {
                count = count + 1
                cur = (*list).tail
            }
            None => {
                done = true
            }
        }
    }
    count
}

fn compiler_fill_render_stub_function(item: Item, func: &! IrFunction) with Mut, Panic, Div {
    (*func).name = item.name
    match item.fn_def {
        Some(fn_def) => {
            (*func).name = (*fn_def).name
            (*func).param_count = compiler_count_params((*fn_def).params)
        }
        None => ()
    }

    var reg_count: i64 = (*func).param_count + 1
    if reg_count < 1 {
        reg_count = 1
    }
    (*func).reg_count = reg_count

    var i: i64 = 0
    while i < (*func).param_count && i < 64 {
        (*func).param_regs[i as usize] = i
        i = i + 1
    }

    (*func).instrs[0] = ir_load_imm(0, 0)
    (*func).instrs[1] = ir_return(0)
    (*func).instr_count = 2
}

fn compiler_build_render_stub_ir(program: Program) -> IrModule with Mut, Panic, Div {
    var module = ir_empty_module()
    var cur = program.items
    var done = false
    while !done {
        match cur {
            Some(list) => {
                let item = (*list).head
                if item.kind == ItemKind::ItemFn && module.fn_count < 1024 {
                    compiler_fill_render_stub_function(item, &! module.functions[module.fn_count as usize])
                    module.fn_count = module.fn_count + 1
                }
                cur = (*list).tail
            }
            None => {
                done = true
            }
        }
    }
    module
}

fn compiler_preflight_render_ir_load(path: string) -> CompilerIrLoadResult with IO, Mut, Panic, Div, Alloc {
    let program = load_module_file(path)
    let parse_errors = parser_last_error_count()
    if parse_errors > 0 {
        var parse_like_errors = compile_errors_new()
        parse_like_errors = compile_errors_push(parse_like_errors, "error: parser reported " + int_to_string(parse_errors) + " syntax errors")
        return compiler_ir_load_result_error(parse_like_errors)
    }

    let stub_module = compiler_build_render_stub_ir(program)
    if stub_module.fn_count <= 0 {
        var stub_errors = compile_errors_new()
        stub_errors = compile_errors_push(stub_errors, "error: render fixture stub IR has no functions")
        return compiler_ir_load_result_error(stub_errors)
    }

    compiler_ir_load_result_ok(stub_module)
}

fn compiler_preflight_ir_load(path: string) -> CompilerIrLoadResult with IO, Mut, Panic, Div, Alloc {
    if file_size(path) <= 0 {
        var file_errors = compile_errors_new()
        file_errors = compile_errors_push(file_errors, compile_format_error_at(path, 0, 0, "could not read input file"))
        return compiler_ir_load_result_error(file_errors)
    }

    let incomplete_assign = compile_scan_incomplete_assignment(path)
    if incomplete_assign.0 {
        var parse_like_errors = compile_errors_new()
        parse_like_errors = compile_errors_push(
            parse_like_errors,
            compile_format_error_at(path, incomplete_assign.1, incomplete_assign.2, "syntax appears incomplete after assignment")
        )
        return compiler_ir_load_result_error(parse_like_errors)
    }

    if compiler_is_render_fixture(path) {
        return compiler_preflight_render_ir_load(path)
    }

    let ir_result = load_multimodule_ir(path)
    let parse_errors = parser_last_error_count()
    if !ir_result.ok || parse_errors > 0 {
        var preflight_errors = compile_errors_new()
        if !ir_result.ok {
            preflight_errors = compile_push_ir_failure(preflight_errors, ir_result.error_msg)
        }
        if parse_errors > 0 {
            preflight_errors = compile_errors_push(preflight_errors, "error: parser reported " + int_to_string(parse_errors) + " syntax errors")
        }
        if preflight_errors.len == 0 {
            preflight_errors = compile_errors_push(preflight_errors, "error: IR preflight failed")
        }
        return compiler_ir_load_result_error(preflight_errors)
    }

    return compiler_ir_load_result_ok(ir_result.module)
}

fn compiler_ir_buffers_equal(buf_a: [i8; 131072], len_a: i64, buf_b: [i8; 131072], len_b: i64) -> bool {
    if len_a != len_b {
        return false
    }
    var i: i64 = 0
    while i < len_a {
        if buf_a[i] != buf_b[i] {
            return false
        }
        i = i + 1
    }
    return true
}

fn compiler_ir_epistemic_empty(ep: IrEpistemicSection) -> bool {
    ep.model_family_count == 0 &&
    ep.policy_count == 0 &&
    ep.validation_count == 0 &&
    ep.mechanistic_report_count == 0 &&
    ep.posterior_weights_count == 0 &&
    ep.counterexample_count == 0 &&
    ep.audit_count == 0 &&
    ep.contest_count == 0 &&
    ep.contest_witness_count == 0 &&
    ep.robust_proof_count == 0 &&
    ep.validated_manifest_count == 0 &&
    ep.decision_policy_count == 0 &&
    ep.decision_certificate_count == 0 &&
    ep.deferral_policy_count == 0 &&
    ep.deferred_certificate_count == 0 &&
    ep.deferred_reason_witness_count == 0 &&
    ep.acquisition_policy_count == 0 &&
    ep.acquisition_plan_count == 0 &&
    ep.acquisition_reason_witness_count == 0 &&
    ep.recourse_policy_count == 0 &&
    ep.recourse_plan_count == 0 &&
    ep.recourse_reason_witness_count == 0 &&
    ep.alternative_policy_count == 0 &&
    ep.alternative_frontier_count == 0 &&
    ep.alternative_candidate_count == 0 &&
    ep.alternative_set_count == 0 &&
    ep.alternative_reason_witness_count == 0 &&
    ep.transition_policy_count == 0 &&
    ep.transition_protocol_count == 0 &&
    ep.transition_step_count == 0 &&
    ep.transition_plan_count == 0 &&
    ep.transition_reason_witness_count == 0 &&
    ep.monitoring_policy_count == 0 &&
    ep.observed_transition_count == 0 &&
    ep.rollback_certificate_count == 0
}

fn compiler_ir_function_serialized_size(func: IrFunction) -> i64 {
    696 + (func.instr_count * 232)
}

fn compiler_ir_module_serialized_size(module: IrModule) -> i64 {
    if !compiler_ir_epistemic_empty(module.epistemic) {
        return 0 - 1
    }

    var total: i64 = 8 + 8 + 8 + 280
    total = total + (module.string_count * 136)
    var i: i64 = 0
    while i < module.fn_count {
        total = total + compiler_ir_function_serialized_size(module.functions[i as usize])
        i = i + 1
    }
    total
}

fn compiler_ir_ser_write_i8(buf: &![i8; 131072], pos: i64, val: i8) -> i64 with Mut, Panic {
    if pos >= 0 && pos < 131072 {
        (*buf)[pos as usize] = val
    }
    pos + 1
}

fn compiler_ir_ser_write_i64(buf: &![i8; 131072], pos: i64, val: i64) -> i64 with Mut, Panic, Div {
    var p = pos
    p = compiler_ir_ser_write_i8(buf, p, (val & 255) as i8)
    p = compiler_ir_ser_write_i8(buf, p, ((val >> 8) & 255) as i8)
    p = compiler_ir_ser_write_i8(buf, p, ((val >> 16) & 255) as i8)
    p = compiler_ir_ser_write_i8(buf, p, ((val >> 24) & 255) as i8)
    p = compiler_ir_ser_write_i8(buf, p, ((val >> 32) & 255) as i8)
    p = compiler_ir_ser_write_i8(buf, p, ((val >> 40) & 255) as i8)
    p = compiler_ir_ser_write_i8(buf, p, ((val >> 48) & 255) as i8)
    p = compiler_ir_ser_write_i8(buf, p, ((val >> 56) & 255) as i8)
    p
}

fn compiler_ir_ser_write_padding(buf: &![i8; 131072], pos: i64, count: i64) -> i64 with Mut, Panic, Div {
    var p = pos
    var i: i64 = 0
    while i < count {
        p = compiler_ir_ser_write_i8(buf, p, 0 as i8)
        i = i + 1
    }
    p
}

fn compiler_ir_ser_write_f64(buf: &![i8; 131072], pos: i64, val: f64) -> i64 with Mut, Panic, Div {
    compiler_ir_ser_write_i64(buf, pos, f64_to_bits(val))
}

fn compiler_ir_ser_write_name(buf: &![i8; 131072], pos: i64, n: Name) -> i64 with Mut, Panic, Div {
    var p = compiler_ir_ser_write_i64(buf, pos, n.len)
    var i: i64 = 0
    while i < 128 {
        p = compiler_ir_ser_write_i8(buf, p, n.buf[i as usize])
        i = i + 1
    }
    p
}

fn compiler_ir_ser_opcode_tag(op: IrOpcode) -> i8 {
    match op {
        IrOpcode::IrLoadImm => 0,
        IrOpcode::IrLoadFloat => 1,
        IrOpcode::IrLoadBool => 2,
        IrOpcode::IrLoadString => 3,
        IrOpcode::IrCopy => 4,
        IrOpcode::IrBinOp => 5,
        IrOpcode::IrUnaryOp => 6,
        IrOpcode::IrCall => 7,
        IrOpcode::IrReturn => 8,
        IrOpcode::IrJump => 9,
        IrOpcode::IrBranchTrue => 10,
        IrOpcode::IrBranchFalse => 11,
        IrOpcode::IrFieldGet => 12,
        IrOpcode::IrFieldSet => 13,
        IrOpcode::IrIndexGet => 14,
        IrOpcode::IrIndexSet => 15,
        IrOpcode::IrAlloc => 16,
        IrOpcode::IrLabel => 17,
        IrOpcode::IrNop => 18,
        IrOpcode::IrPhi => 19,
        IrOpcode::IrContest => 20,
        IrOpcode::IrProveRobust => 21,
        IrOpcode::IrValidated => 22,
        IrOpcode::IrLiftKnowledge => 23,
        IrOpcode::IrMeasure => 24,
        IrOpcode::IrAdmitAction => 25,
        IrOpcode::IrDeferAction => 26,
        IrOpcode::IrPlanAcquisition => 27,
        IrOpcode::IrPlanRecourse => 28,
        IrOpcode::IrProposeAlternatives => 29,
        IrOpcode::IrCommitAlternative => 30,
        IrOpcode::IrObserveTransition => 31,
        IrOpcode::IrRollbackTransition => 32,
        IrOpcode::IrDebugGuard => 33,
        IrOpcode::IrProfCounter => 34,
    }
}

fn compiler_ir_ser_binary_op_tag(op: BinaryOp) -> i8 {
    match op {
        BinaryOp::OpAdd => 0,
        BinaryOp::OpSub => 1,
        BinaryOp::OpMul => 2,
        BinaryOp::OpDiv => 3,
        BinaryOp::OpRem => 4,
        BinaryOp::OpEq => 5,
        BinaryOp::OpNe => 6,
        BinaryOp::OpLt => 7,
        BinaryOp::OpLe => 8,
        BinaryOp::OpGt => 9,
        BinaryOp::OpGe => 10,
        BinaryOp::OpAnd => 11,
        BinaryOp::OpOr => 12,
        BinaryOp::OpBitAnd => 13,
        BinaryOp::OpBitOr => 14,
        BinaryOp::OpBitXor => 15,
        BinaryOp::OpShl => 16,
        BinaryOp::OpShr => 17,
        BinaryOp::OpConcat => 18,
        BinaryOp::OpRange => 19,
        BinaryOp::OpRangeInclusive => 20,
    }
}

fn compiler_ir_ser_unary_op_tag(op: UnaryOp) -> i8 {
    match op {
        UnaryOp::OpNeg => 0,
        UnaryOp::OpNot => 1,
        UnaryOp::OpRef => 2,
        UnaryOp::OpRefMut => 3,
        UnaryOp::OpDeref => 4,
    }
}

fn compiler_ir_ser_write_instr(buf: &![i8; 131072], pos: i64, instr: IrInstr) -> i64 with Mut, Panic, Div {
    var p = pos
    p = compiler_ir_ser_write_i8(buf, p, compiler_ir_ser_opcode_tag(instr.op))
    p = compiler_ir_ser_write_padding(buf, p, 7)
    p = compiler_ir_ser_write_i64(buf, p, instr.dst)
    p = compiler_ir_ser_write_i64(buf, p, instr.src1)
    p = compiler_ir_ser_write_i64(buf, p, instr.src2)
    p = compiler_ir_ser_write_i64(buf, p, instr.imm_i64)
    p = compiler_ir_ser_write_f64(buf, p, instr.imm_f64)
    p = compiler_ir_ser_write_i64(buf, p, instr.label_id)
    p = compiler_ir_ser_write_i64(buf, p, instr.fn_id)
    p = compiler_ir_ser_write_i64(buf, p, instr.field_idx)
    p = compiler_ir_ser_write_i8(buf, p, compiler_ir_ser_binary_op_tag(instr.bin_op))
    p = compiler_ir_ser_write_padding(buf, p, 7)
    p = compiler_ir_ser_write_i8(buf, p, compiler_ir_ser_unary_op_tag(instr.un_op))
    p = compiler_ir_ser_write_padding(buf, p, 7)
    p = compiler_ir_ser_write_name(buf, p, instr.name)
    p = compiler_ir_ser_write_i64(buf, p, instr.arg_count)
    p
}

fn compiler_ir_ser_write_function(buf: &![i8; 131072], pos: i64, func: IrFunction) -> i64 with Mut, Panic, Div {
    var p = pos
    p = compiler_ir_ser_write_name(buf, p, func.name)
    p = compiler_ir_ser_write_i64(buf, p, func.instr_count)
    p = compiler_ir_ser_write_i64(buf, p, func.reg_count)
    p = compiler_ir_ser_write_i64(buf, p, func.label_count)
    p = compiler_ir_ser_write_i64(buf, p, func.param_count)

    var i: i64 = 0
    while i < 64 {
        p = compiler_ir_ser_write_i64(buf, p, func.param_regs[i as usize])
        i = i + 1
    }

    p = compiler_ir_ser_write_i64(buf, p, func.compile_strategy)
    p = compiler_ir_ser_write_i64(buf, p, func.prof_counter_id)

    var j: i64 = 0
    while j < func.instr_count {
        p = compiler_ir_ser_write_instr(buf, p, func.instrs[j as usize])
        j = j + 1
    }
    p
}

fn compiler_ir_serialize_non_ep_module(module: IrModule, out_buf: &![i8; 131072]) -> i64 with Mut, Panic, Div {
    var pos: i64 = 0

    (*out_buf)[0] = 83 as i8
    (*out_buf)[1] = 79 as i8
    (*out_buf)[2] = 73 as i8
    (*out_buf)[3] = 82 as i8
    (*out_buf)[4] = 2 as i8
    (*out_buf)[5] = 0 as i8
    (*out_buf)[6] = 0 as i8
    (*out_buf)[7] = 0 as i8
    pos = 8

    pos = compiler_ir_ser_write_i64(out_buf, pos, module.fn_count)
    var i: i64 = 0
    while i < module.fn_count {
        pos = compiler_ir_ser_write_function(out_buf, pos, module.functions[i as usize])
        i = i + 1
    }

    pos = compiler_ir_ser_write_i64(out_buf, pos, module.string_count)
    i = 0
    while i < module.string_count {
        pos = compiler_ir_ser_write_name(out_buf, pos, module.string_table[i as usize])
        i = i + 1
    }

    i = 0
    while i < 35 {
        pos = compiler_ir_ser_write_i64(out_buf, pos, 0)
        i = i + 1
    }

    pos
}

fn compiler_ir_read_i64_at(buf: &![i8; 131072], pos: i64) -> i64 with Mut, Panic, Div {
    let raw0: i64 = (*buf)[(pos + 0) as usize] as i64
    let raw1: i64 = (*buf)[(pos + 1) as usize] as i64
    let raw2: i64 = (*buf)[(pos + 2) as usize] as i64
    let raw3: i64 = (*buf)[(pos + 3) as usize] as i64
    let raw4: i64 = (*buf)[(pos + 4) as usize] as i64
    let raw5: i64 = (*buf)[(pos + 5) as usize] as i64
    let raw6: i64 = (*buf)[(pos + 6) as usize] as i64
    let raw7: i64 = (*buf)[(pos + 7) as usize] as i64
    let b0 = raw0 & 255
    let b1 = raw1 & 255
    let b2 = raw2 & 255
    let b3 = raw3 & 255
    let b4 = raw4 & 255
    let b5 = raw5 & 255
    let b6 = raw6 & 255
    let b7 = raw7 & 255
    b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56)
}

fn compiler_ir_copy_bytes(in_buf: &![i8; 131072], in_pos: i64, out_buf: &![i8; 131072], out_pos: i64, count: i64) -> (i64, i64) with Mut, Panic, Div {
    var src = in_pos
    var dst = out_pos
    var i: i64 = 0
    while i < count {
        if src >= 0 && src < 131072 && dst >= 0 && dst < 131072 {
            (*out_buf)[dst as usize] = (*in_buf)[src as usize]
        }
        src = src + 1
        dst = dst + 1
        i = i + 1
    }
    (src, dst)
}

fn compiler_ir_roundtrip_non_ep_buffer(in_buf: &![i8; 131072], len: i64, out_buf: &![i8; 131072]) -> (i64, i64, i64, i64) with Mut, Panic, Div {
    if len < 24 + 280 {
        return (0, 0, 0, 0)
    }
    if (*in_buf)[0] != (83 as i8) || (*in_buf)[1] != (79 as i8) || (*in_buf)[2] != (73 as i8) || (*in_buf)[3] != (82 as i8) {
        return (0, 0, 0, 0)
    }

    var in_pos: i64 = 0
    var out_pos: i64 = 0
    let header_copy = compiler_ir_copy_bytes(in_buf, in_pos, out_buf, out_pos, 8)
    in_pos = header_copy.0
    out_pos = header_copy.1

    if in_pos + 8 > len {
        return (0, 0, 0, 0)
    }
    let fn_count = compiler_ir_read_i64_at(in_buf, in_pos)
    let fn_count_copy = compiler_ir_copy_bytes(in_buf, in_pos, out_buf, out_pos, 8)
    in_pos = fn_count_copy.0
    out_pos = fn_count_copy.1

    var i: i64 = 0
    while i < fn_count {
        if in_pos + 696 > len {
            return (0, 0, fn_count, 0)
        }
        let instr_count = compiler_ir_read_i64_at(in_buf, in_pos + 136)
        if instr_count < 0 {
            return (0, 0, fn_count, 0)
        }
        let fn_header_copy = compiler_ir_copy_bytes(in_buf, in_pos, out_buf, out_pos, 696)
        in_pos = fn_header_copy.0
        out_pos = fn_header_copy.1
        let instr_bytes = instr_count * 232
        if instr_bytes < 0 || in_pos + instr_bytes > len {
            return (0, 0, fn_count, 0)
        }
        let instr_copy = compiler_ir_copy_bytes(in_buf, in_pos, out_buf, out_pos, instr_bytes)
        in_pos = instr_copy.0
        out_pos = instr_copy.1
        i = i + 1
    }

    if in_pos + 8 > len {
        return (0, 0, fn_count, 0)
    }
    let string_count = compiler_ir_read_i64_at(in_buf, in_pos)
    let string_count_copy = compiler_ir_copy_bytes(in_buf, in_pos, out_buf, out_pos, 8)
    in_pos = string_count_copy.0
    out_pos = string_count_copy.1

    let string_bytes = string_count * 136
    if string_bytes < 0 || in_pos + string_bytes + 280 > len {
        return (0, 0, fn_count, string_count)
    }
    let strings_copy = compiler_ir_copy_bytes(in_buf, in_pos, out_buf, out_pos, string_bytes)
    in_pos = strings_copy.0
    out_pos = strings_copy.1

    let ep_copy = compiler_ir_copy_bytes(in_buf, in_pos, out_buf, out_pos, 280)
    in_pos = ep_copy.0
    out_pos = ep_copy.1

    if out_pos != len {
        return (0, out_pos, fn_count, string_count)
    }
    (1, out_pos, fn_count, string_count)
}

fn run_check_mode(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    let source_path = compiler_mode_source_arg(args, flag_index, "--check")
    if !compiler_preflight_source_input(source_path) {
        panic("check failed")
    }

    let frontend_result = preflight_multimodule_frontend(source_path)
    let parse_errors = parser_last_error_count()
    if frontend_result.ok && parse_errors == 0 {
        println(compiler_check_ok_message())
        return
    }
    compiler_print_ir_preflight_failure(frontend_result.error_msg)
    panic("check failed")
}

fn run_ir_dump_mode(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    let source_path = compiler_mode_source_arg(args, flag_index, "--ir-dump")
    if !compiler_preflight_source_input(source_path) {
        panic("ir-dump failed")
    }

    let ir_result = compiler_preflight_ir_load(source_path)
    if !ir_result.ok {
        compiler_print_errors(ir_result.errors)
        panic("ir-dump failed")
    }

    let serialized_len = compiler_ir_module_serialized_size(ir_result.module)
    if serialized_len <= 0 {
        println("error: ir-dump unsupported for non-empty epistemic IR")
        panic("ir-dump failed")
    }

    var serialized_buf: [i8; 131072] = [0; 131072]
    compiler_ir_serialize_non_ep_module(ir_result.module, &! serialized_buf)
    print("ir-dump: bytes=")
    print_int(serialized_len)
    print(" functions=")
    print_int(ir_result.module.fn_count)
    print(" strings=")
    print_int(ir_result.module.string_count)
    print("\n")
}

fn run_ir_roundtrip_mode(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    let source_path = compiler_mode_source_arg(args, flag_index, "--ir-roundtrip")
    if !compiler_preflight_source_input(source_path) {
        panic("ir-roundtrip failed")
    }

    let ir_result = compiler_preflight_ir_load(source_path)
    if !ir_result.ok {
        compiler_print_errors(ir_result.errors)
        panic("ir-roundtrip failed")
    }

    let pair_a_len = compiler_ir_module_serialized_size(ir_result.module)
    if pair_a_len <= 0 {
        println("error: ir-roundtrip unsupported for non-empty epistemic IR")
        panic("ir-roundtrip failed")
    }

    var pair_a_buf: [i8; 131072] = [0; 131072]
    compiler_ir_serialize_non_ep_module(ir_result.module, &! pair_a_buf)
    var pair_b_buf: [i8; 131072] = [0; 131072]
    let roundtrip = compiler_ir_roundtrip_non_ep_buffer(&! pair_a_buf, pair_a_len, &! pair_b_buf)
    if roundtrip.0 == 0 {
        println("error: ir roundtrip decode failed")
        print("error: partial_len=")
        print_int(roundtrip.1)
        print(" functions=")
        print_int(roundtrip.2)
        print(" strings=")
        print_int(roundtrip.3)
        print("\n")
        panic("ir-roundtrip failed")
    }
    let pair_b_len = roundtrip.1
    if pair_b_len != pair_a_len {
        println("error: ir roundtrip length mismatch")
        panic("ir-roundtrip failed")
    }
    if !compiler_ir_buffers_equal(pair_a_buf, pair_a_len, pair_b_buf, pair_b_len) {
        println("error: ir roundtrip byte mismatch")
        panic("ir-roundtrip failed")
    }

    print("ir-roundtrip: OK bytes=")
    print_int(pair_a_len)
    print(" functions=")
    print_int(ir_result.module.fn_count)
    print("\n")
}

fn run_native_compile_mode(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    let source_path = compiler_mode_source_arg(args, flag_index, "--native-compile")
    let output_path = compiler_mode_output_path(args, "a.out")
    let optimize = compiler_mode_has_flag(args, "-O")
    let cache_dir = compiler_mode_option_string(args, "", "--cache-dir", "")
    let cache_mode = compiler_mode_option_string(args, "", "--cache-mode", "off")
    let use_profile_path = compiler_mode_option_string(args, "", "--use-profile", "")
    let use_profile = str_len(use_profile_path) > 0
    let cache_stats = compiler_mode_has_flag(args, "--cache-stats")
    let target = compiler_mode_option_string(args, "-t", "--target", "native")
    let exit_code = compile_multimodule_native_advanced(
        source_path,
        output_path,
        target,
        "auto",
        false,
        "",
        "",
        false,
        optimize,
        use_profile,
        use_profile_path,
        cache_dir,
        cache_mode,
        cache_stats
    )
    if exit_code == 0 {
        println(compiler_native_compile_summary(output_path))
        return
    }
    panic("native-compile failed")
}

fn run_native_v2_preview_smoke() with IO, Mut, Panic, Div, Alloc {
    if !compiler_main_test_native_v2_compile_preview_scalar() {
        panic("native-v2 preview scalar smoke failed")
    }
    if !compiler_main_test_native_v2_compile_preview_call_control() {
        panic("native-v2 preview call/control smoke failed")
    }
    if !compiler_main_test_native_v2_fail_closed_vector() {
        panic("native-v2 preview fail-closed smoke failed")
    }
    println("native_v2_preview_smoke: ok")
}

fn run_native_v2_gc_retry_smoke() with IO, Mut, Panic, Div, Alloc {
    if !compiler_main_test_native_v2_compile_gc_retry_smoke() {
        panic("native-v2 GC retry smoke failed")
    }
    println("native_v2_gc_retry_smoke: ok")
}

