}

// ============================================================================
// Sprint 89: float legalization pipeline tests (T342-T343)
// ============================================================================

// T342: native_v2_lower_function_to_machine handles IrLoadFloat without crash.
fn compiler_main_test_float_lower_to_machine() -> bool with Mut, Div, Panic, Alloc {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_float(0, 1.5)
    instrs[1] = ir_return(0)
    let func = cp_make_test_func(instrs, 2)
    let lowered = native_v2_lower_function_to_machine(func)
    lowered.supported && lowered.blocks[0].instr_count == 2
}

// T343: native_v2_legalize_function handles PSEUDO_LOAD_FLOAT → LOAD_FLOAT_RIP + marks is_float_slot.
fn compiler_main_test_float_legalize() -> bool with Mut, Div, Panic, Alloc {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_float(0, 1.5)
    instrs[1] = ir_return(0)
    let func = cp_make_test_func(instrs, 2)
    let lowered = native_v2_lower_function_to_machine(func)
    if !lowered.supported { return false }
    let legal = native_v2_legalize_function(lowered)
    legal.supported && legal.is_float_slot[0 as usize] == 1
}

// Sprint 108 Block AE: And-mask truncation folding tests (T352-T357).
// (x & C1) & C2 → x & (C1 & C2).  SOTA: LLVM InstCombineAndOrXor.cpp.

// T352: (r0 & 0xFF00) & 0x0F00 → r0 & 0x0F00.
fn compiler_main_test_and_mask_basic() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 65280)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitAnd, 1)
    instrs[2] = ir_load_imm(3, 3840)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpBitAnd, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 0
        && IR_A_IMM_I64[(ir_region_slot_r(result.region, (2))) as usize] == 3840
}

// T353: Three-deep: ((r0 & 0xFFFF) & 0xFF00) & 0x0F00 → r0 & 0x0F00.
fn compiler_main_test_and_mask_three_deep() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 65535)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitAnd, 1)
    instrs[2] = ir_load_imm(3, 65280)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpBitAnd, 3)
    instrs[4] = ir_load_imm(5, 3840)
    instrs[5] = ir_binop(6, 4, BinaryOp::OpBitAnd, 5)
    let func   = cp_make_test_func(instrs, 6)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (5))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && IR_A_SRC1[(ir_region_slot_r(result.region, (5))) as usize] == 0
        && IR_A_IMM_I64[(ir_region_slot_r(result.region, (4))) as usize] == 3840
}

// T354: Disjoint masks (r0 & 0xF0) & 0x0F → merged const = 0.
fn compiler_main_test_and_mask_to_zero() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 240)
