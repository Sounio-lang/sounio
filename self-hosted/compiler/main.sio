        && IR_A_SRC1[(ir_region_slot_r(opt.region, (2))) as usize] == 0 && IR_A_SRC2[(ir_region_slot_r(opt.region, (2))) as usize] == 1
}

// Sprint 136: Block AX — Additive inverse via negation tracking (T494-T499)
// a + neg(a) → 0 — group theory: a + (-a) = 0
// SOTA: LLVM InstCombineAddSub.cpp; distinct from Block A (x-x→0)

// T494: a + neg(a) → 0  [basic additive inverse]
fn compiler_main_test_add_neg_inverse() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_unaryop(2, UnaryOp::OpNeg, 0)        // r2 = neg(a)
    instrs[1] = ir_binop(3, 0, BinaryOp::OpAdd, 2)      // r3 = a + neg(a) → 0
    instrs[2] = ir_return(3)
    let func = cp_make_test_func(instrs, 3)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(opt.region, (1))) as usize] == 0
}

// T495: neg(a) + a → 0  [commutative]
fn compiler_main_test_neg_add_inverse() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_unaryop(2, UnaryOp::OpNeg, 0)        // r2 = neg(a)
    instrs[1] = ir_binop(3, 2, BinaryOp::OpAdd, 0)      // r3 = neg(a) + a → 0
    instrs[2] = ir_return(3)
    let func = cp_make_test_func(instrs, 3)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(opt.region, (1))) as usize] == 0
}

// T496: a + neg(b) — different operands, should NOT fold to 0
fn compiler_main_test_add_neg_different() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_unaryop(2, UnaryOp::OpNeg, 1)        // r2 = neg(b)  (b ≠ a)
    instrs[1] = ir_binop(3, 0, BinaryOp::OpAdd, 2)      // r3 = a + neg(b) — not zero
    instrs[2] = ir_return(3)
    let func = cp_make_test_func(instrs, 3)
    let opt = opt_cleanup_function(func)
    // Block AG may rewrite a+neg(b)→a-b, but NOT to 0
    IR_A_IMM_I64[(ir_region_slot_r(opt.region, (1))) as usize] != 0 || (IR_A_OP[(ir_region_slot_r(opt.region, (1))) as usize] as IrOpcode) != IrOpcode::IrLoadImm
}

// T497: a + neg(a) + b — downstream use of the zero result
fn compiler_main_test_add_neg_inverse_used() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_unaryop(2, UnaryOp::OpNeg, 0)        // r2 = neg(a)
    instrs[1] = ir_binop(3, 0, BinaryOp::OpAdd, 2)      // r3 = a + neg(a) → 0
    instrs[2] = ir_binop(4, 3, BinaryOp::OpAdd, 1)      // r4 = 0 + b
    instrs[3] = ir_return(4)
    let func = cp_make_test_func(instrs, 4)
    let opt = opt_cleanup_function(func)
    // r3 should be IrLoadImm(0); r4 = 0 + b might be further folded by identity fold
    (IR_A_OP[(ir_region_slot_r(opt.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(opt.region, (1))) as usize] == 0
}

// T498: neg(neg(a)) + neg(a) — double-neg collapses first, then additive inverse
fn compiler_main_test_double_neg_then_add_neg() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_unaryop(2, UnaryOp::OpNeg, 0)        // r2 = neg(a)
    instrs[1] = ir_unaryop(3, UnaryOp::OpNeg, 2)        // r3 = neg(neg(a)) → copy(a) by Block M
    instrs[2] = ir_binop(4, 3, BinaryOp::OpAdd, 2)      // r4 = a + neg(a) → 0 (after copy prop)
    instrs[3] = ir_return(4)
    let func = cp_make_test_func(instrs, 4)
    let opt = opt_cleanup_function(func)
    // r3 = IrCopy(r0) by Block M (double neg). Then r4 = r3 + r2.
    // For AX to fire, copy propagation would need to resolve r3→r0.
    // Single-pass: AX sees r3 (not r0) + r2 (neg(r0)). neg_src[r2]=r0, but s1=r3≠r0.
    // So AX does NOT fire unless copy prop runs first. Check r3 is copy(r0) instead.
    (IR_A_OP[(ir_region_slot_r(opt.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(opt.region, (1))) as usize] == 0
}

// T499: a * neg(a) — mul, not add — should NOT fold to 0
fn compiler_main_test_mul_neg_no_zero() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_unaryop(2, UnaryOp::OpNeg, 0)        // r2 = neg(a)
    instrs[1] = ir_binop(3, 0, BinaryOp::OpMul, 2)      // r3 = a * neg(a) — NOT zero
    instrs[2] = ir_return(3)
    let func = cp_make_test_func(instrs, 3)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp && (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (1))) as usize] as BinaryOp) == BinaryOp::OpMul
}


// Sprint 139: Block BA — Sub-add inverse cancellation (T500-T505)

// T500: (a - b) + b → a  [basic: s1 is sub, s2 cancels subtracted]
fn compiler_main_test_sub_add_cancel_basic() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpSub, 1)   // r2 = r0 - r1
    instrs[1] = ir_binop(3, 2, BinaryOp::OpAdd, 1)   // r3 = r2 + r1 → r0
    instrs[2] = ir_return(3)
    let func = cp_make_test_func(instrs, 3)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(opt.region, (1))) as usize] == 0
}

// T501: b + (a - b) → a  [commutative: s2 is sub, s1 cancels]
fn compiler_main_test_sub_add_cancel_commutative() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpSub, 1)   // r2 = r0 - r1
    instrs[1] = ir_binop(3, 1, BinaryOp::OpAdd, 2)   // r3 = r1 + r2 → r0
    instrs[2] = ir_return(3)
    let func = cp_make_test_func(instrs, 3)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(opt.region, (1))) as usize] == 0
}

// T502: a - (a - b) → b  [nested sub: outer sub cancels inner lhs]
fn compiler_main_test_sub_sub_cancel() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpSub, 1)   // r2 = r0 - r1
    instrs[1] = ir_binop(3, 0, BinaryOp::OpSub, 2)   // r3 = r0 - r2 → r1
    instrs[2] = ir_return(3)
    let func = cp_make_test_func(instrs, 3)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(opt.region, (1))) as usize] == 1
}

// T503: (a - b) + c — different operand, no fold
fn compiler_main_test_sub_add_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(3, 0, BinaryOp::OpSub, 1)   // r3 = r0 - r1
    instrs[1] = ir_binop(4, 3, BinaryOp::OpAdd, 2)   // r4 = r3 + r2 [r2 ≠ r1, no fold]
    instrs[2] = ir_return(4)
    let func = cp_make_test_func(instrs, 3)
    let opt = opt_cleanup_function(func)
    // Must NOT fold — still r3 + r2
    (IR_A_OP[(ir_region_slot_r(opt.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (1))) as usize] == 3 && IR_A_SRC2[(ir_region_slot_r(opt.region, (1))) as usize] == 2
}

// T504: b - (a - b) — outer lhs ≠ inner lhs (b≠a), no fold
fn compiler_main_test_sub_sub_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpSub, 1)   // r2 = r0 - r1
    instrs[1] = ir_binop(3, 1, BinaryOp::OpSub, 2)   // r3 = r1 - r2 [r1≠r0, no fold]
    instrs[2] = ir_return(3)
    let func = cp_make_test_func(instrs, 3)
    let opt = opt_cleanup_function(func)
    // Must NOT fold — r1 is not sub_lhs[r2]=r0
    (IR_A_OP[(ir_region_slot_r(opt.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (1))) as usize] == 1 && IR_A_SRC2[(ir_region_slot_r(opt.region, (1))) as usize] == 2
}

// T505: (a - b) + b result used in downstream add
fn compiler_main_test_sub_add_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpSub, 1)   // r2 = r0 - r1
    instrs[1] = ir_binop(3, 2, BinaryOp::OpAdd, 1)   // r3 = r2 + r1 → IrCopy(r0)
    instrs[2] = ir_binop(4, 3, BinaryOp::OpAdd, 2)   // r4 = r3 + r2
    instrs[3] = ir_return(4)
    let func = cp_make_test_func(instrs, 4)
    let opt = opt_cleanup_function(func)
    // instrs[1] folds to IrCopy(r0); instrs[2] now r0 + r2
    (IR_A_OP[(ir_region_slot_r(opt.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(opt.region, (1))) as usize] == 0
}

// Sprint 140: Block BB — Constant mask merge (T506-T511)
// (x & C1) | (x & C2) → IrCopy(x & C1) when C2 ⊆ C1
// SOTA: LLVM InstCombineAndOrXor.cpp; Boolean algebra distributive axiom

// T506: (x & 0xFF) | (x & 0x0F) → IrCopy(x & 0xFF)  [0x0F ⊆ 0xFF]
fn compiler_main_test_mask_merge_subset() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    // r0 = x (implicit param)
    instrs[0] = ir_load_imm(2, 255)                       // r2 = 0xFF
    instrs[1] = ir_binop(3, 0, BinaryOp::OpBitAnd, 2)    // r3 = x & 0xFF
    instrs[2] = ir_load_imm(4, 15)                        // r4 = 0x0F
    instrs[3] = ir_binop(5, 0, BinaryOp::OpBitAnd, 4)    // r5 = x & 0x0F
    instrs[4] = ir_binop(6, 3, BinaryOp::OpBitOr, 5)     // r6 = (x&0xFF) | (x&0x0F) → copy(r3)
    instrs[5] = ir_return(6)
    let func = cp_make_test_func(instrs, 6)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (4))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(opt.region, (4))) as usize] == 3
}

// T507: (x & 0x0F) | (x & 0xFF) → IrCopy(x & 0xFF)  [C1 ⊆ C2, choose s2]
fn compiler_main_test_mask_merge_subset_rev() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(2, 15)                        // r2 = 0x0F
    instrs[1] = ir_binop(3, 0, BinaryOp::OpBitAnd, 2)    // r3 = x & 0x0F
    instrs[2] = ir_load_imm(4, 255)                       // r4 = 0xFF
    instrs[3] = ir_binop(5, 0, BinaryOp::OpBitAnd, 4)    // r5 = x & 0xFF
    instrs[4] = ir_binop(6, 3, BinaryOp::OpBitOr, 5)     // r6 = (x&0x0F) | (x&0xFF) → copy(r5)
    instrs[5] = ir_return(6)
    let func = cp_make_test_func(instrs, 6)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (4))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(opt.region, (4))) as usize] == 5
}

// T508: (x & 0xFF) | (x & 0xFF) → IrCopy(x & 0xFF)  [identical masks]
fn compiler_main_test_mask_merge_identical() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(2, 255)
    instrs[1] = ir_binop(3, 0, BinaryOp::OpBitAnd, 2)    // r3 = x & 0xFF
    instrs[2] = ir_load_imm(4, 255)
    instrs[3] = ir_binop(5, 0, BinaryOp::OpBitAnd, 4)    // r5 = x & 0xFF
    instrs[4] = ir_binop(6, 3, BinaryOp::OpBitOr, 5)     // r6 = same | same → copy(r3)
    instrs[5] = ir_return(6)
    let func = cp_make_test_func(instrs, 6)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (4))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(opt.region, (4))) as usize] == 3
}

// T509: (x & 0xF0) | (x & 0x0F) — non-overlapping masks, no subset → no fold
fn compiler_main_test_mask_merge_no_subset() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(2, 240)                       // r2 = 0xF0
    instrs[1] = ir_binop(3, 0, BinaryOp::OpBitAnd, 2)    // r3 = x & 0xF0
    instrs[2] = ir_load_imm(4, 15)                        // r4 = 0x0F
    instrs[3] = ir_binop(5, 0, BinaryOp::OpBitAnd, 4)    // r5 = x & 0x0F
    instrs[4] = ir_binop(6, 3, BinaryOp::OpBitOr, 5)     // r6 = (x&0xF0) | (x&0x0F) — no subset
    instrs[5] = ir_return(6)
    let func = cp_make_test_func(instrs, 6)
    let opt = opt_cleanup_function(func)
    // Should remain as OR — neither mask is a subset of the other
    (IR_A_OP[(ir_region_slot_r(opt.region, (4))) as usize] as IrOpcode) == IrOpcode::IrBinOp && (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (4))) as usize] as BinaryOp) == BinaryOp::OpBitOr
}

// T510: (x & C1) | (y & C2) — different base vars, no fold
fn compiler_main_test_mask_merge_diff_base() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(2, 255)
    instrs[1] = ir_binop(3, 0, BinaryOp::OpBitAnd, 2)    // r3 = x & 0xFF
    instrs[2] = ir_load_imm(4, 15)
    instrs[3] = ir_binop(5, 1, BinaryOp::OpBitAnd, 4)    // r5 = y & 0x0F  (different base r1≠r0)
    instrs[4] = ir_binop(6, 3, BinaryOp::OpBitOr, 5)     // r6 = (x&0xFF) | (y&0x0F) — no fold
    instrs[5] = ir_return(6)
    let func = cp_make_test_func(instrs, 6)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (4))) as usize] as IrOpcode) == IrOpcode::IrBinOp && (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (4))) as usize] as BinaryOp) == BinaryOp::OpBitOr
}

// T511: (x & 0xFF) | (x & 0x07) result used downstream
fn compiler_main_test_mask_merge_used() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(2, 255)
    instrs[1] = ir_binop(3, 0, BinaryOp::OpBitAnd, 2)    // r3 = x & 0xFF
    instrs[2] = ir_load_imm(4, 7)
    instrs[3] = ir_binop(5, 0, BinaryOp::OpBitAnd, 4)    // r5 = x & 0x07
    instrs[4] = ir_binop(6, 3, BinaryOp::OpBitOr, 5)     // r6 → copy(r3)
    instrs[5] = ir_binop(7, 6, BinaryOp::OpAdd, 1)       // r7 = result + y
    instrs[6] = ir_return(7)
    let func = cp_make_test_func(instrs, 7)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (4))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(opt.region, (4))) as usize] == 3
}


// Sprint 141: Block BC — Negation subtraction simplification (T512-T517)

// T512: neg(a) - neg(b) → b - a  [basic]
fn compiler_main_test_neg_sub_neg_basic() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_unaryop(2, UnaryOp::OpNeg, 0)    // r2 = neg(r0)
    instrs[1] = ir_unaryop(3, UnaryOp::OpNeg, 1)    // r3 = neg(r1)
    instrs[2] = ir_binop(4, 2, BinaryOp::OpSub, 3)  // r4 = r2 - r3 -> r1 - r0
    instrs[3] = ir_return(4)
    let func = cp_make_test_func(instrs, 4)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (2))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (2))) as usize] as BinaryOp) == BinaryOp::OpSub
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (2))) as usize] == 1 && IR_A_SRC2[(ir_region_slot_r(opt.region, (2))) as usize] == 0
}

// T513: neg(b) - neg(a) → a - b  [swapped operands]
fn compiler_main_test_neg_sub_neg_swapped() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_unaryop(2, UnaryOp::OpNeg, 1)    // r2 = neg(r1)
    instrs[1] = ir_unaryop(3, UnaryOp::OpNeg, 0)    // r3 = neg(r0)
    instrs[2] = ir_binop(4, 2, BinaryOp::OpSub, 3)  // r4 = r2 - r3 -> r0 - r1
    instrs[3] = ir_return(4)
    let func = cp_make_test_func(instrs, 4)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (2))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (2))) as usize] as BinaryOp) == BinaryOp::OpSub
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (2))) as usize] == 0 && IR_A_SRC2[(ir_region_slot_r(opt.region, (2))) as usize] == 1
}

// T514: neg(a) - neg(a) → 0  [same operand chains with Block A: a-a→0]
fn compiler_main_test_neg_sub_neg_same() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_unaryop(2, UnaryOp::OpNeg, 0)    // r2 = neg(r0)
    instrs[1] = ir_unaryop(3, UnaryOp::OpNeg, 0)    // r3 = neg(r0)
    instrs[2] = ir_binop(4, 2, BinaryOp::OpSub, 3)  // r4 = r2 - r3 -> r0 - r0 -> 0
    instrs[3] = ir_return(4)
    let func = cp_make_test_func(instrs, 4)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (2))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(opt.region, (2))) as usize] == 0
}

// T515: neg(a) - b — only s1 negated, no Block BC fold
fn compiler_main_test_neg_sub_pos_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_unaryop(2, UnaryOp::OpNeg, 0)    // r2 = neg(r0)
    instrs[1] = ir_binop(3, 2, BinaryOp::OpSub, 1)  // r3 = r2 - r1 [s2 not neg]
    instrs[2] = ir_return(3)
    let func = cp_make_test_func(instrs, 3)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp && IR_A_SRC1[(ir_region_slot_r(opt.region, (1))) as usize] == 2
}

// T516: a - neg(b) -> Block AG fires: a + b; Block BC must NOT fire
fn compiler_main_test_pos_sub_neg_no_bc() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_unaryop(2, UnaryOp::OpNeg, 1)    // r2 = neg(r1)
    instrs[1] = ir_binop(3, 0, BinaryOp::OpSub, 2)  // r3 = r0 - neg(r1) -> Block AG: r0 + r1
    instrs[2] = ir_return(3)
    let func = cp_make_test_func(instrs, 3)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (1))) as usize] as BinaryOp) == BinaryOp::OpAdd
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (1))) as usize] == 0 && IR_A_SRC2[(ir_region_slot_r(opt.region, (1))) as usize] == 1
}

// T517: neg(a) * neg(b) -> Block AW fires: a * b; Block BC does not apply
fn compiler_main_test_neg_mul_neg_aw() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_unaryop(2, UnaryOp::OpNeg, 0)    // r2 = neg(r0)
    instrs[1] = ir_unaryop(3, UnaryOp::OpNeg, 1)    // r3 = neg(r1)
    instrs[2] = ir_binop(4, 2, BinaryOp::OpMul, 3)  // r4 = r2 * r3 -> Block AW: r0 * r1
    instrs[3] = ir_return(4)
    let func = cp_make_test_func(instrs, 4)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (2))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (2))) as usize] as BinaryOp) == BinaryOp::OpMul
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (2))) as usize] == 0 && IR_A_SRC2[(ir_region_slot_r(opt.region, (2))) as usize] == 1
}

fn compiler_main_test_const_offset_diff_add_add() -> bool with Mut, Div, Panic {
    // (x+3)-(x+1) → 2: both add-const with same base
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
    instrs[0 as usize] = ir_load_imm(0, 42)       // r0 = 42 (x)
    instrs[1 as usize] = ir_load_imm(1, 3)         // r1 = 3 (C1)
    instrs[2 as usize] = ir_binop(2, 0, BinaryOp::OpAdd, 1)  // r2 = x+3
    instrs[3 as usize] = ir_load_imm(3, 1)         // r3 = 1 (C2)
    instrs[4 as usize] = ir_binop(4, 0, BinaryOp::OpAdd, 3)  // r4 = x+1
    instrs[5 as usize] = ir_binop(5, 2, BinaryOp::OpSub, 4)  // r5 = (x+3)-(x+1)
    let func = cp_make_test_func(instrs, 6)
    let result = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (5))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (5))) as usize] == 2
}

fn compiler_main_test_const_offset_diff_sub_sub() -> bool with Mut, Div, Panic {
    // (x-3)-(x-1) → -2: both sub-const with same base
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
    instrs[0 as usize] = ir_load_imm(0, 42)
    instrs[1 as usize] = ir_load_imm(1, 3)
    instrs[2 as usize] = ir_binop(2, 0, BinaryOp::OpSub, 1)  // r2 = x-3
    instrs[3 as usize] = ir_load_imm(3, 1)
    instrs[4 as usize] = ir_binop(4, 0, BinaryOp::OpSub, 3)  // r4 = x-1
    instrs[5 as usize] = ir_binop(5, 2, BinaryOp::OpSub, 4)  // r5 = (x-3)-(x-1)
    let func = cp_make_test_func(instrs, 6)
    let result = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (5))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (5))) as usize] == -2
}

fn compiler_main_test_const_offset_diff_add_sub() -> bool with Mut, Div, Panic {
    // (x+3)-(x-1) → 4: add minus sub-const, same base
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
    instrs[0 as usize] = ir_load_imm(0, 42)
    instrs[1 as usize] = ir_load_imm(1, 3)
    instrs[2 as usize] = ir_binop(2, 0, BinaryOp::OpAdd, 1)  // r2 = x+3
    instrs[3 as usize] = ir_load_imm(3, 1)
    instrs[4 as usize] = ir_binop(4, 0, BinaryOp::OpSub, 3)  // r4 = x-1
    instrs[5 as usize] = ir_binop(5, 2, BinaryOp::OpSub, 4)  // r5 = (x+3)-(x-1)
    let func = cp_make_test_func(instrs, 6)
    let result = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (5))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (5))) as usize] == 4
}

fn compiler_main_test_const_offset_diff_sub_add() -> bool with Mut, Div, Panic {
    // (x-3)-(x+1) → -4: sub minus add-const, same base
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
    instrs[0 as usize] = ir_load_imm(0, 42)
    instrs[1 as usize] = ir_load_imm(1, 3)
    instrs[2 as usize] = ir_binop(2, 0, BinaryOp::OpSub, 1)  // r2 = x-3
    instrs[3 as usize] = ir_load_imm(3, 1)
    instrs[4 as usize] = ir_binop(4, 0, BinaryOp::OpAdd, 3)  // r4 = x+1
    instrs[5 as usize] = ir_binop(5, 2, BinaryOp::OpSub, 4)  // r5 = (x-3)-(x+1)
    let func = cp_make_test_func(instrs, 6)
    let result = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (5))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (5))) as usize] == -4
}

fn compiler_main_test_const_offset_diff_no_fold_diff_base() -> bool with Mut, Div, Panic {
    // (x+3)-(y+1) → no fold (different bases)
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
    instrs[0 as usize] = ir_load_imm(0, 42)        // r0 = x
    instrs[1 as usize] = ir_load_imm(1, 99)        // r1 = y (different)
    instrs[2 as usize] = ir_load_imm(2, 3)
    instrs[3 as usize] = ir_binop(3, 0, BinaryOp::OpAdd, 2)  // r3 = x+3
    instrs[4 as usize] = ir_load_imm(4, 1)
    instrs[5 as usize] = ir_binop(5, 1, BinaryOp::OpAdd, 4)  // r5 = y+1
    instrs[6 as usize] = ir_binop(6, 3, BinaryOp::OpSub, 5)  // r6 = (x+3)-(y+1)
    let func = cp_make_test_func(instrs, 7)
    let result = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (6))) as usize] as IrOpcode) == IrOpcode::IrBinOp
}

fn compiler_main_test_const_offset_diff_no_fold_plain_sub() -> bool with Mut, Div, Panic {
    // a - b → no fold (neither is tracked as const-offset)
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
    instrs[0 as usize] = ir_load_imm(0, 10)
    instrs[1 as usize] = ir_load_imm(1, 7)
    instrs[2 as usize] = ir_binop(2, 0, BinaryOp::OpMul, 1)  // r2 = 10*7 (not const-offset)
    instrs[3 as usize] = ir_load_imm(3, 5)
    instrs[4 as usize] = ir_binop(4, 0, BinaryOp::OpMul, 3)  // r4 = 10*5
    instrs[5 as usize] = ir_binop(5, 2, BinaryOp::OpSub, 4)  // r5 = not const-offset sub
    let func = cp_make_test_func(instrs, 6)
    let result = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (5))) as usize] as IrOpcode) != IrOpcode::IrLoadImm || IR_A_IMM_I64[(ir_region_slot_r(result.region, (5))) as usize] != 0
}

fn compiler_main_test_twos_comp_neg_basic() -> bool with Mut, Div, Panic {
    // ~x + 1 → neg(x): two's complement negation identity
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
    instrs[0 as usize] = ir_load_imm(0, 5)          // r0 = 5 (x)
    instrs[1 as usize] = ir_load_imm(1, -1)          // r1 = -1
    instrs[2 as usize] = ir_binop(2, 0, BinaryOp::OpBitXor, 1)  // r2 = ~x (x^(-1))
    instrs[3 as usize] = ir_load_imm(3, 1)           // r3 = 1
    instrs[4 as usize] = ir_binop(4, 2, BinaryOp::OpAdd, 3)      // r4 = ~x + 1
    let func = cp_make_test_func(instrs, 5)
    let result = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (4))) as usize] as IrOpcode) == IrOpcode::IrUnaryOp && (IR_A_UN_OP[(ir_region_slot_r(result.region, (4))) as usize] as UnaryOp) == UnaryOp::OpNeg
}

fn compiler_main_test_twos_comp_neg_commutative() -> bool with Mut, Div, Panic {
    // 1 + ~x → neg(x): commutative form
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
    instrs[0 as usize] = ir_load_imm(0, 7)
    instrs[1 as usize] = ir_load_imm(1, -1)
    instrs[2 as usize] = ir_binop(2, 0, BinaryOp::OpBitXor, 1)  // r2 = ~x
    instrs[3 as usize] = ir_load_imm(3, 1)
    instrs[4 as usize] = ir_binop(4, 3, BinaryOp::OpAdd, 2)      // r4 = 1 + ~x
    let func = cp_make_test_func(instrs, 5)
    let result = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (4))) as usize] as IrOpcode) == IrOpcode::IrUnaryOp && (IR_A_UN_OP[(ir_region_slot_r(result.region, (4))) as usize] as UnaryOp) == UnaryOp::OpNeg
}

fn compiler_main_test_twos_comp_neg_src_correct() -> bool with Mut, Div, Panic {
    // ~x + 1 → neg(x): verify src1 points to x (not ~x)
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
    instrs[0 as usize] = ir_load_imm(0, 9)           // r0 = x
    instrs[1 as usize] = ir_load_imm(1, -1)
    instrs[2 as usize] = ir_binop(2, 0, BinaryOp::OpBitXor, 1)  // r2 = ~x
    instrs[3 as usize] = ir_load_imm(3, 1)
    instrs[4 as usize] = ir_binop(4, 2, BinaryOp::OpAdd, 3)      // r4 = ~x + 1
    let func = cp_make_test_func(instrs, 5)
    let result = opt_cleanup_function(func)
    // Result must be neg with src pointing to r0 (x), not r2 (~x)
    (IR_A_OP[(ir_region_slot_r(result.region, (4))) as usize] as IrOpcode) == IrOpcode::IrUnaryOp
        && IR_A_SRC1[(ir_region_slot_r(result.region, (4))) as usize] == 0
}

fn compiler_main_test_twos_comp_neg_no_fold_wrong_const() -> bool with Mut, Div, Panic {
    // ~x + 2 → no fold (constant is 2, not 1)
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
    instrs[0 as usize] = ir_load_imm(0, 5)
    instrs[1 as usize] = ir_load_imm(1, -1)
    instrs[2 as usize] = ir_binop(2, 0, BinaryOp::OpBitXor, 1)  // r2 = ~x
    instrs[3 as usize] = ir_load_imm(3, 2)           // r3 = 2 (not 1)
    instrs[4 as usize] = ir_binop(4, 2, BinaryOp::OpAdd, 3)      // r4 = ~x + 2
    let func = cp_make_test_func(instrs, 5)
    let result = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (4))) as usize] as IrOpcode) != IrOpcode::IrUnaryOp
}

fn compiler_main_test_twos_comp_neg_no_fold_sub() -> bool with Mut, Div, Panic {
    // ~x - 1 → no fold (OpSub, not OpAdd)
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
    instrs[0 as usize] = ir_load_imm(0, 5)
    instrs[1 as usize] = ir_load_imm(1, -1)
