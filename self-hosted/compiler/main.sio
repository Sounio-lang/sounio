fn compiler_manifest_print_deferral_policies(ep: &IrEpistemicSection) with IO, Mut, Panic, Div, Alloc {
    print("    \"deferral_policies\": [\n")
    var i: i64 = 0
    while i < (*ep).deferral_policy_count {
