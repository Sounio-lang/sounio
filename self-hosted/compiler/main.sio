}

// T164: Comparison chain fold: r0=5; r1=3; r2=(r0 > r1) → r2=IrLoadImm(1).
fn compiler_main_test_cmp_chain_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 5)
    instrs[1] = ir_load_imm(1, 3)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpGt, 1)
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (2))) as usize] == 1
}

// T165: Block E + DCE chain: r2=(5==5) folds to IrLoadImm(1); r0,r1 become dead → IrNop.
fn compiler_main_test_block_e_dce_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 5)
    instrs[1] = ir_load_imm(1, 5)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpEq, 1)
    instrs[3] = ir_return(2)
    let func   = cp_make_test_func(instrs, 4)
    let result = opt_cleanup_function(func)
    var f165: bool = false
    var j165: i64 = 0
    while j165 < result.instr_count {
        if (IR_A_OP[(ir_region_slot_r(result.region, (j165))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (j165))) as usize] == 1 { f165 = true }
        j165 = j165 + 1
    }
    f165
}

// Sprint 75: Conditional branch folding Block F self-tests (T169–T174)
// ============================================================================

// T169: IrBranchTrue with const-1 condition → IrJump (branch always taken).
fn compiler_main_test_branch_true_const_taken() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 1)
    instrs[1] = ir_branch_true(0, 7)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrJump && IR_A_LABEL_ID[(ir_region_slot_r(result.region, (1))) as usize] == 7
}

// T170: IrBranchTrue with const-0 condition → IrNop (branch never taken).
fn compiler_main_test_branch_true_const_not_taken() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 0)
    instrs[1] = ir_branch_true(0, 7)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrNop
}

// T171: IrBranchFalse with const-0 condition → IrJump (condition false → branch taken).
fn compiler_main_test_branch_false_const_taken() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 0)
    instrs[1] = ir_branch_false(0, 11)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrJump && IR_A_LABEL_ID[(ir_region_slot_r(result.region, (1))) as usize] == 11
}

// T172: IrBranchFalse with const-1 condition → IrNop (condition true → branch not taken).
fn compiler_main_test_branch_false_const_not_taken() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 1)
    instrs[1] = ir_branch_false(0, 11)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrNop
}

// T173: IrBranchTrue with non-constant condition → left unchanged (no fold).
fn compiler_main_test_branch_no_fold_nonconstant() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(1, 0, BinaryOp::OpAdd, 2)   // r1 = r0 + r2 (non-const)
    instrs[1] = ir_branch_true(1, 7)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBranchTrue
}

// T174: Block E → Block F chain: x==x folds to 1 (Block E), then BranchTrue(1) → IrJump (Block F).
fn compiler_main_test_branch_fold_chain_e_f() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 3)                      // r0 = 3
    instrs[1] = ir_binop(1, 0, BinaryOp::OpEq, 0)     // r1 = (r0 == r0) → Block E: IrLoadImm(1,1)
    instrs[2] = ir_branch_true(1, 9)                    // BranchTrue(r1,9) → Block F: IrJump(9)
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrJump && IR_A_LABEL_ID[(ir_region_slot_r(result.region, (2))) as usize] == 9
}

// ============================================================================
// Sprint 76: Shift identity/annihilator folding Block G self-tests (T175–T180)
// ============================================================================

// T175: x << 0 → IrCopy(x) — shift-by-zero identity (OpShl, right-const=0).
fn compiler_main_test_shl_by_zero() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 0)                          // r1 = 0 (shift amount)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpShl, 1)        // r2 = r0 << r1 (r0 unknown, r1=0)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 0
}

// T176: x >> 0 → IrCopy(x) — shift-by-zero identity (OpShr, right-const=0).
fn compiler_main_test_shr_by_zero() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 0)                          // r1 = 0 (shift amount)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpShr, 1)        // r2 = r0 >> r1 (r0 unknown, r1=0)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 0
}

// T177: 0 << n → IrLoadImm(0) — zero-shift annihilator (OpShl, left-const=0).
fn compiler_main_test_zero_shl_n() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 0)                          // r0 = 0 (value to shift)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpShl, 1)        // r2 = r0 << r1 (r0=0, r1 unknown)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (1))) as usize] == 0
}

// T178: 0 >> n → IrLoadImm(0) — zero-shift annihilator (OpShr, left-const=0).
fn compiler_main_test_zero_shr_n() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 0)                          // r0 = 0 (value to shift)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpShr, 1)        // r2 = r0 >> r1 (r0=0, r1 unknown)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (1))) as usize] == 0
}

// T179: r1 << r2 (both unknown) → stays IrBinOp (no fold).
fn compiler_main_test_shift_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpShl, 1)        // r2 = r0 << r1 (both unknown)
    let func   = cp_make_test_func(instrs, 1)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrBinOp
}

// T180: Block E → Block G chain: (5 < 3) → IrLoadImm(0) (Block E), then 0 << r4 → IrLoadImm(0) (Block G).
fn compiler_main_test_shift_chain_e_g() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 5)
    instrs[1] = ir_load_imm(1, 3)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpLt, 1)         // r2 = (5 < 3) → Block E: IrLoadImm(0)
    instrs[3] = ir_binop(3, 2, BinaryOp::OpShl, 4)        // r3 = r2 << r4 → Block G: IrLoadImm(0)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (3))) as usize] == 0
}

// ============================================================================
// Sprint 77: Commutative CSE canonicalization Block H self-tests (T181–T186)
// ============================================================================

// T181: r0+r1 then r1+r0 → IrCopy (OpAdd commutative CSE hit after Block H).
fn compiler_main_test_cse_commut_add() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)   // r2 = r0 + r1 (stored as (ADD,0,1))
    instrs[1] = ir_binop(3, 1, BinaryOp::OpAdd, 0)   // r3 = r1 + r0 (canonical: (ADD,0,1)) → hit
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_cse(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 2
}

// T182: r3*r5 then r5*r3 → IrCopy (OpMul commutative CSE hit).
fn compiler_main_test_cse_commut_mul() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 3, BinaryOp::OpMul, 5)   // r2 = r3 * r5 (stored as (MUL,3,5))
    instrs[1] = ir_binop(4, 5, BinaryOp::OpMul, 3)   // r4 = r5 * r3 (canonical: (MUL,3,5)) → hit
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_cse(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 2
}

// T183: r0|r1 then r1|r0 → IrCopy (OpOr commutative CSE hit).
fn compiler_main_test_cse_commut_or() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpOr, 1)    // r2 = r0 | r1
    instrs[1] = ir_binop(3, 1, BinaryOp::OpOr, 0)    // r3 = r1 | r0 → hit
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_cse(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 2
}

// T184: r0-r1 then r1-r0 → NOT IrCopy (OpSub is non-commutative, no CSE hit).
fn compiler_main_test_cse_noncommut_sub() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpSub, 1)   // r2 = r0 - r1
    instrs[1] = ir_binop(3, 1, BinaryOp::OpSub, 0)   // r3 = r1 - r0 (different op, no hit)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_cse(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp
}

// T185: r0+r1 twice in same order → IrCopy (existing exact-match CSE still works, regression).
fn compiler_main_test_cse_same_order_regress() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)   // r2 = r0 + r1
    instrs[1] = ir_binop(3, 0, BinaryOp::OpAdd, 1)   // r3 = r0 + r1 (same order) → hit
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_cse(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 2
}

// T186: r2&r4 then r4&r2 → IrCopy (OpAnd commutative CSE hit).
fn compiler_main_test_cse_commut_and() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(3, 2, BinaryOp::OpAnd, 4)   // r3 = r2 & r4 (stored as (AND,2,4))
    instrs[1] = ir_binop(5, 4, BinaryOp::OpAnd, 2)   // r5 = r4 & r2 (canonical: (AND,2,4)) → hit
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_cse(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 3
}

