// ============================================================================
// Sprint 62: 4-preg register allocation self-tests (T30-T37)
// ============================================================================

// T30: preg_to_x86_reg maps all 4 pregs correctly

// T31: 2 non-overlapping vregs → 2 pregs assigned, 0 spilled

// T32: 4 non-overlapping vregs → all 4 pregs used, 0 spilled

// T33: 5 overlapping vregs with 4 pregs → exactly 1 spill

// T34: prologue byte count == 12 with frame_size=0

// T35: prologue starts with push r15 (41 57) then push r14 (41 56)

// T36: epilogue byte count == 13; last byte == 0xC3 (RET)

// T37: regalloc_linear_scan(state, 4) produces valid state (regression + 4-preg)

// ============================================================================
// Sprint 54: TCO wiring self-tests (T38-T45)
// ============================================================================

// T38: tco_is_tail_position detects call immediately before return

// T39: tco_is_self_call detects fn_id matching function's own id

// T40: tco_run_pass transforms self-recursive tail call (stats.transformed == 1)

// T41: tco_run_pass leaves non-tail call unchanged (stats.transformed == 0)

// T42: tco_check_eligibility rejects function with IrAlloc

// T43: tco_analyze_function populates correct func_id

// T44: tco_count_tail_calls_for_func returns 1 for single self-tail call

// T45: tco_run_pass on empty module returns fn_count unchanged

// ============================================================================
// Sprint 63: Adaptive stack slot encoding self-tests (T49-T56)
// ============================================================================

// T49: ir_slot_fits_disp8 returns true for offset -8 (vreg 0)

// T50: ir_slot_fits_disp8 returns true for offset -128 (vreg 15, boundary)

// T51: ir_slot_fits_disp8 returns false for offset -136 (vreg 16, beyond disp8)

// T52: emit_load_rbp_disp8_rax emits 4 bytes: 0x48 0x8B 0x45 0xF8 (disp=-8)

// T53: emit_store_rax_rbp_disp8 emits 4 bytes: 0x48 0x89 0x45 0xF0 (disp=-16)

// T54: emit_load_rbp_disp32_rax still emits 7 bytes (regression)

// T55: emit_store_rax_rbp_disp32 still emits 7 bytes (regression)

// T56: ir_slot_fits_disp8 agrees with ir_slot_offset for vreg boundary (15 fits, 16 doesn't)

// T57: native v2 runtime context layout is language-visible and deopt-ready

// T58: native v2 x86 policy exposes reserved + allocatable pools explicitly

// T59: native v2 aarch64 policy is present for the full reserved/allocatable contract

// T60: native v2 machine module reports tiering + deopt substrate

// T61: native v2 contract writer emits a JSON artifact

// ============================================================================
// Sprint 64: Compact frame sizing self-tests (T62-T69)
// ============================================================================

// T62: nc_min_frame_size returns 0 for empty function (reg_count=0)

// T63: nc_min_frame_size returns 0 when all vregs preg-allocated

// T64: nc_min_frame_size returns 16 for 1 spilled vreg at index 0 (align16(8)=16)

// T65: nc_min_frame_size returns 32 when highest stack vreg is index 3

// T66: nc_min_frame_size returns 16 when middle vreg is spilled, higher is preg-alloc

// T67: nc_min_frame_size returns 0 for 4 preg-alloc vregs (all 4 callee-saved registers used)

// T68: nc_min_frame_size returns 48 for spilled vreg at index 4 (align16(40)=48)

// T69: nc_min_frame_size handles param vreg (preg=-2 RA_UNASSIGNED) as needing stack slot

// T70: used allocatable preg mask tracks only r12-r15 assignments

// T71: odd allocatable-save counts add an 8-byte alignment pad before calls

// T72: native v2 x86 contract publishes an explicit allocation order

// T73: lowering preg mapping is driven by the shared x86 allocation order

fn compiler_main_make_native_v2_scalar_module(ret_value: i64) -> IrModule with Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.instrs[0] = ir_load_imm(0, ret_value)
    func.instrs[1] = ir_return(0)
    func.instr_count = 2
    func.reg_count = 1
    module.functions[0] = func
    module.fn_count = 1
    module
}

fn compiler_main_make_native_v2_call_module() -> IrModule with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    var helper = ir_empty_function()
    helper.name = ir_name_from_bytes(104, 101, 108, 112, 4)
    helper.param_count = 1
    helper.param_regs[0] = 0
    helper.reg_count = 3
    helper.instrs[0] = ir_load_imm(1, 2)
    helper.instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    helper.instrs[2] = ir_return(2)
    helper.instr_count = 3
    module.functions[0] = helper

    var main_fn = ir_empty_function()
    main_fn.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    main_fn.reg_count = 2
    main_fn.instrs[0] = ir_load_imm(0, 3)
    main_fn.instrs[1] = ir_call(1, 0, helper.name, Some(Box::new(ir_reg_list_single(0))), 1)
    main_fn.instrs[2] = ir_return(1)
    main_fn.instr_count = 3
    module.functions[1] = main_fn

    module.fn_count = 2
    module
}

// Build a Name from up to 10 explicit bytes (enough for "str_len"/"str_char_at"/
// string literals used by the string-builtin witnesses). Bytes beyond `len` are
// ignored. Uses ir_empty_name() then sets buf entries directly (ir_name_from_bytes
// only carries 4 bytes, too short for "str_len").
fn native_v2_name_bytes10(len: i64, b0: i64, b1: i64, b2: i64, b3: i64, b4: i64, b5: i64, b6: i64, b7: i64, b8: i64, b9: i64) -> Name with Mut, Panic, Div {
    var n = ir_empty_name()
    n.len = len
    if len > 0 { n.buf[0] = b0 as i8 }
    if len > 1 { n.buf[1] = b1 as i8 }
    if len > 2 { n.buf[2] = b2 as i8 }
    if len > 3 { n.buf[3] = b3 as i8 }
    if len > 4 { n.buf[4] = b4 as i8 }
    if len > 5 { n.buf[5] = b5 as i8 }
    if len > 6 { n.buf[6] = b6 as i8 }
    if len > 7 { n.buf[7] = b7 as i8 }
    if len > 8 { n.buf[8] = b8 as i8 }
    if len > 9 { n.buf[9] = b9 as i8 }
    n
}

// "str_len" name (7 bytes): s t r _ l e n
fn native_v2_name_str_len() -> Name with Mut, Panic, Div {
    native_v2_name_bytes10(7, 115, 116, 114, 95, 108, 101, 110, 0, 0, 0)
}

// "str_char_at" name (11 bytes) — exceeds the 10-byte helper, so build directly.
fn native_v2_name_str_char_at() -> Name with Mut, Panic, Div {
    var n = ir_empty_name()
    n.len = 11
    n.buf[0]  = 115 as i8  // s
    n.buf[1]  = 116 as i8  // t
    n.buf[2]  = 114 as i8  // r
    n.buf[3]  = 95 as i8   // _
    n.buf[4]  = 99 as i8   // c
    n.buf[5]  = 104 as i8  // h
    n.buf[6]  = 97 as i8   // a
    n.buf[7]  = 114 as i8  // r
    n.buf[8]  = 95 as i8   // _
    n.buf[9]  = 97 as i8   // a
    n.buf[10] = 116 as i8  // t
    n
}

// String-builtin witness: str_len("hello") = 5.
//   fn str_len(s) -> <builtin>             (functions[0], emitted by builtin dispatch)
//   fn main() -> { s = "hello"; return str_len(s) }   (functions[1])
// This is the exact shape that previously SIGSEGV'd the native-v2 emitter:
// an IrLoadString (rodata) PLUS a string-builtin call in the same module.
fn compiler_main_make_native_v2_str_len_module() -> IrModule with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    var str_len_fn = ir_empty_function()
    str_len_fn.name = native_v2_name_str_len()
    str_len_fn.param_count = 1
    str_len_fn.param_regs[0] = 0
    str_len_fn.reg_count = 2
    str_len_fn.instr_count = 0
    module.functions[0] = str_len_fn

    let str_len_name = native_v2_name_str_len()
    // "hello" = 104 101 108 108 111 (5 bytes)
    let hello = native_v2_name_bytes10(5, 104, 101, 108, 108, 111, 0, 0, 0, 0, 0)

    var main_fn = ir_empty_function()
    main_fn.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    main_fn.param_count = 0
    main_fn.reg_count = 3
    main_fn.instrs[0] = ir_load_string(0, 0, hello)
    main_fn.instrs[1] = ir_call(1, 0, str_len_name, Some(Box::new(ir_reg_list_single(0))), 1)
    main_fn.instrs[2] = ir_return(1)
    main_fn.instr_count = 3
    module.functions[1] = main_fn

    module.fn_count = 2
    module
}

// String-builtin witness: str_char_at("hello", 1) = 'e' = 101.
//   fn str_char_at(s, i) -> <builtin>      (functions[0])
//   fn main() -> { s = "hello"; return str_char_at(s, 1) }   (functions[1])
fn compiler_main_make_native_v2_str_char_at_module() -> IrModule with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    var sca_fn = ir_empty_function()
    sca_fn.name = native_v2_name_str_char_at()
    sca_fn.param_count = 2
    sca_fn.param_regs[0] = 0
    sca_fn.param_regs[1] = 1
    sca_fn.reg_count = 3
    sca_fn.instr_count = 0
    module.functions[0] = sca_fn

    let sca_name = native_v2_name_str_char_at()
    let hello = native_v2_name_bytes10(5, 104, 101, 108, 108, 111, 0, 0, 0, 0, 0)

    var main_fn = ir_empty_function()
    main_fn.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    main_fn.param_count = 0
    main_fn.reg_count = 4
    main_fn.instrs[0] = ir_load_string(0, 0, hello)
    main_fn.instrs[1] = ir_load_imm(1, 1)
    main_fn.instrs[2] = ir_call(2, 0, sca_name, Some(Box::new(ir_reg_list_append(ir_reg_list_single(0), 1))), 2)
    main_fn.instrs[3] = ir_return(2)
    main_fn.instr_count = 4
    module.functions[1] = main_fn

    module.fn_count = 2
    module
}

// Fn-pointer witness: main() takes the ADDRESS of helper, then calls THROUGH it.
//   fn helper(x) -> x * 2          (functions[0])
//   fn main() -> { p = &helper; return p(55) }  = 55 * 2 = 110   (functions[1])
// Proves IrLoadFnRef (lea rax,[rip+disp32] + reloc kind 4) + IrCallIndirect (call rax)
// IR->ELF->exit. The distinct 110 cannot be produced by the direct-call path.
// "str_eq" name (6 bytes): s t r _ e q
fn native_v2_name_str_eq() -> Name with Mut, Panic, Div {
    native_v2_name_bytes10(6, 115, 116, 114, 95, 101, 113, 0, 0, 0, 0)
}

// String-builtin TWO-string-arg witness: str_eq("ab","ab") = 1.
//   fn str_eq(a, b) -> <builtin>           (functions[0])
//   fn main() -> { a = "ab"; b = "ab"; return str_eq(a, b) }   (functions[1])
// This is the historically-reported emit crasher: a 2-string-arg builtin call PLUS
// two IrLoadString rodata entries. Used to root-cause the emit SIGSEGV.
fn compiler_main_make_native_v2_str_eq_module() -> IrModule with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    var streq_fn = ir_empty_function()
    streq_fn.name = native_v2_name_str_eq()
    streq_fn.param_count = 2
    streq_fn.param_regs[0] = 0
    streq_fn.param_regs[1] = 1
    streq_fn.reg_count = 3
    streq_fn.instr_count = 0
    module.functions[0] = streq_fn

    let streq_name = native_v2_name_str_eq()
    // "ab" = 97 98 (2 bytes)
    let s_ab = native_v2_name_bytes10(2, 97, 98, 0, 0, 0, 0, 0, 0, 0, 0)

    var streq_main = ir_empty_function()
    streq_main.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    streq_main.param_count = 0
    streq_main.reg_count = 4
    streq_main.instrs[0] = ir_load_string(0, 0, s_ab)
    streq_main.instrs[1] = ir_load_string(1, 1, s_ab)
    streq_main.instrs[2] = ir_call(2, 0, streq_name, Some(Box::new(ir_reg_list_append(ir_reg_list_single(0), 1))), 2)
    streq_main.instrs[3] = ir_return(2)
    streq_main.instr_count = 4
    module.functions[1] = streq_main

    module.fn_count = 2
    module
}

// "str_concat" name (10 bytes): s t r _ c o n c a t
fn native_v2_name_str_concat() -> Name with Mut, Panic, Div {
    native_v2_name_bytes10(10, 115, 116, 114, 95, 99, 111, 110, 99, 97, 116)
}

// str_concat + str_len witness: str_len("ab"+"cde") = 5.
//   fn str_concat(a, b) -> <builtin>  (functions[0], id 10, heap alloc)
//   fn str_len(s) -> <builtin>        (functions[1], id 6)
//   fn main() -> { c = str_concat("ab","cde"); return str_len(c) }   (functions[2])
fn compiler_main_make_native_v2_strconcat_len_module() -> IrModule with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    var concat_fn = ir_empty_function()
    concat_fn.name = native_v2_name_str_concat()
    concat_fn.param_count = 2
    concat_fn.param_regs[0] = 0
    concat_fn.param_regs[1] = 1
    concat_fn.reg_count = 3
    concat_fn.instr_count = 0
    module.functions[0] = concat_fn

    var len_fn = ir_empty_function()
    len_fn.name = native_v2_name_str_len()
    len_fn.param_count = 1
    len_fn.param_regs[0] = 0
    len_fn.reg_count = 2
    len_fn.instr_count = 0
    module.functions[1] = len_fn

    let concat_name = native_v2_name_str_concat()
    let len_name = native_v2_name_str_len()
    let s_ab = native_v2_name_bytes10(2, 97, 98, 0, 0, 0, 0, 0, 0, 0, 0)      // "ab"
    let s_cde = native_v2_name_bytes10(3, 99, 100, 101, 0, 0, 0, 0, 0, 0, 0)  // "cde"

    var main_fn = ir_empty_function()
    main_fn.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    main_fn.param_count = 0
    main_fn.reg_count = 5
    main_fn.instrs[0] = ir_load_string(0, 0, s_ab)
    main_fn.instrs[1] = ir_load_string(1, 1, s_cde)
    main_fn.instrs[2] = ir_call(2, 0, concat_name, Some(Box::new(ir_reg_list_append(ir_reg_list_single(0), 1))), 2)
    main_fn.instrs[3] = ir_call(3, 1, len_name, Some(Box::new(ir_reg_list_single(2))), 1)
    main_fn.instrs[4] = ir_return(3)
    main_fn.instr_count = 5
    module.functions[2] = main_fn

    module.fn_count = 3
    module
}

// str_concat + str_char_at witness: str_char_at("ab"+"cde", 3) = 'd' = 100.
