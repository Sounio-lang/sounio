    let opt = opt_cleanup_function(func)
    // Block A: x-x→0
    (IR_A_OP[(ir_region_slot_r(opt.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLoadImm
        && IR_A_IMM_I64[(ir_region_slot_r(opt.region, (1))) as usize] == 0
}

fn compiler_main_test_ep_no_fold_not_swap() -> bool with Mut, Div, Panic {
