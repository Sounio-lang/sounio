}

// T480: negative — ~a & (c | b) does NOT fold (c ≠ a)
fn compiler_main_test_not_dist_neg() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    // r0=a, r1=b, r4=c (implicit non-constant params, c≠a)
    instrs[0] = ir_load_imm(6, -1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitXor, 6)   // r2 = ~a (r0=a)
    instrs[2] = ir_binop(3, 4, BinaryOp::OpBitOr, 1)    // r3 = c | b  (r4=c ≠ r0=a)
    instrs[3] = ir_binop(5, 2, BinaryOp::OpBitAnd, 3)   // r5 = ~a & (c|b) — no fold
    instrs[4] = ir_return(5)
    let func = cp_make_test_func(instrs, 5)
    let opt = opt_cleanup_function(func)
    // Should remain as AND — no simplification
    (IR_A_OP[(ir_region_slot_r(opt.region, (3))) as usize] as IrOpcode) == IrOpcode::IrBinOp && (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (3))) as usize] as BinaryOp) == BinaryOp::OpBitAnd
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (3))) as usize] == 2 && IR_A_SRC2[(ir_region_slot_r(opt.region, (3))) as usize] == 3
}

// T481: ~a & (b | a) → ~a & b  [inner OR operand order reversed]
fn compiler_main_test_not_dist_inner_commutative() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
