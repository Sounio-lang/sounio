    if compiler_main_test_dg_not_xor_unwrap_comm() {
        passed = passed + 1
        println("  T850 OK: Sprint 197 Block DG: r1^~(r0^r1) -> ~r0 commutative")
    } else { println("  FAIL: T850") }
    if compiler_main_test_dg_no_fold_diff_base() {
        passed = passed + 1
        println("  T851 OK: Sprint 197 Block DG: ~(r0^r1)^r2 no fold diff base")
    } else { println("  FAIL: T851") }
    if compiler_main_test_dg_no_fold_not_xor_rr() {
        passed = passed + 1
        println("  T852 OK: Sprint 197 Block DG: ~r1^r1 -> -1 via DE not DG")
