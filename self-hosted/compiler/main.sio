    instrs[1 as usize] = ir_binop(5, 2, BinaryOp::OpSub, 3)
    instrs[2 as usize] = ir_binop(6, 4, BinaryOp::OpAdd, 5)
    let func = cp_make_test_func(instrs, 3)
    let opt = opt_cleanup_function(func)
