// Sprint 109 Block AF: Shift-mask folding tests (T358-T363).
// (x << N) >> N → x & ((1 << (64-N)) - 1).  Opposite dir shifts become AND masks.

// T358: (x << 8) >> 8 → x & 0x00FFFFFFFFFFFFFF
fn compiler_main_test_shift_mask_shr_after_shl() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 8)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpShl, 1)
    instrs[2] = ir_load_imm(3, 8)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpShr, 3)
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    // After fold: should become AND with mask
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrBinOp && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 0
}

// T359: (x >> 8) << 8 → x & 0xFFFFFFFFFFFFFF00
fn compiler_main_test_shift_mask_shl_after_shr() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 8)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpShr, 1)
    instrs[2] = ir_load_imm(3, 8)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpShl, 3)
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrBinOp && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 0
}

// T360: single-bit shift-mask: (x << 63) >> 63 → x & 1
fn compiler_main_test_shift_mask_single_bit() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 63)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpShl, 1)
    instrs[2] = ir_load_imm(3, 63)
