}

// T118: E-graph op-name hash function returns distinct expected values.
fn compiler_main_test_egraph_op_name_hash() -> bool {
    eg_op_name_hash(EG_OP_ADD) == 300 && eg_op_name_hash(EG_OP_MUL) == 500 && eg_op_name_hash(EG_OP_NEG) == 700
}

// T119: E-graph cost model constants satisfy CONST == VAR < OP.
fn compiler_main_test_egraph_cost_model() -> bool {
    EG_COST_CONST == 1 && EG_COST_VAR == 1 && EG_COST_OP == 2 && EG_COST_CONST < EG_COST_OP
}

// T120: Pattern variable sentinels are distinct negative values.
fn compiler_main_test_egraph_pat_vars() -> bool {
    EG_PAT_VAR_A == 0 - 1 && EG_PAT_VAR_B == 0 - 2 && EG_PAT_VAR_C == 0 - 3 && EG_PAT_VAR_D == 0 - 4
}

// T121: eg_rule_add_commute produces an ADD→ADD rule with 2 children.
fn compiler_main_test_egraph_add_commute_rule() -> bool {
