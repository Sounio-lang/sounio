        && (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (2))) as usize] as BinaryOp) == BinaryOp::OpBitAnd
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (2))) as usize] == 0
        && IR_A_SRC2[(ir_region_slot_r(opt.region, (2))) as usize] == 1
}

fn compiler_main_test_et_or_xor_sub_and_inner_comm() -> bool with Mut, Div, Panic {
    // (x|y)-(y^x) → x&y (inner XOR commutative)
