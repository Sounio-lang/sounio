    (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (3))) as usize] as BinaryOp) == BinaryOp::OpBitAnd
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (3))) as usize] == 0
}

