    instrs[4 as usize] = ir_binop(4, 2, BinaryOp::OpBitOr, 3)
    let func = cp_make_test_func(instrs, 5)
    let result = opt_cleanup_function(func)
    // No BV fold: result keeps x^5 as src1 (r2), not x (r0)
    IR_A_SRC1[(ir_region_slot_r(result.region, (4))) as usize] != 0
}

