        && (IR_A_BIN_OP[(ir_region_slot_r(result.region, (2))) as usize] as BinaryOp) == BinaryOp::OpBitAnd
}

// Sprint 115 Block AL: Subtract reversal through negation (T394-T399).
// SOTA: LLVM InstCombineAddSub.cpp; Cooper & Torczon §8.4.

// T394: neg(a - b) → b - a.
fn compiler_main_test_neg_sub_reversal() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpSub, 1)
    instrs[1] = ir_unaryop(3, UnaryOp::OpNeg, 2)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(result.region, (1))) as usize] as BinaryOp) == BinaryOp::OpSub
        && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 1
        && IR_A_SRC2[(ir_region_slot_r(result.region, (1))) as usize] == 0
}

// T395: 0 - (a - b) → b - a.
fn compiler_main_test_zero_minus_sub_reversal() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpSub, 1)
    instrs[1] = ir_load_imm(3, 0)
    instrs[2] = ir_binop(4, 3, BinaryOp::OpSub, 2)
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(result.region, (2))) as usize] as BinaryOp) == BinaryOp::OpSub
        && IR_A_SRC1[(ir_region_slot_r(result.region, (2))) as usize] == 1
        && IR_A_SRC2[(ir_region_slot_r(result.region, (2))) as usize] == 0
}

// T396: neg(a + b) → no fold (only reverses subtraction, not addition).
fn compiler_main_test_neg_add_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs[1] = ir_unaryop(3, UnaryOp::OpNeg, 2)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrUnaryOp
        && (IR_A_UN_OP[(ir_region_slot_r(result.region, (1))) as usize] as UnaryOp) == UnaryOp::OpNeg
}

// T397: neg(neg(a - b)) — double-neg fires on instrs[2], Block AL fires on instrs[1].
fn compiler_main_test_neg_neg_sub_double() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpSub, 1)
    instrs[1] = ir_unaryop(3, UnaryOp::OpNeg, 2)
    instrs[2] = ir_unaryop(4, UnaryOp::OpNeg, 3)
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    // instrs[1]: neg(a-b) → b-a (Block AL)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 1
}

// T398: 0 - x where x is NOT a sub → no reversal fold.
fn compiler_main_test_zero_minus_non_sub() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs[1] = ir_load_imm(3, 0)
    instrs[2] = ir_binop(4, 3, BinaryOp::OpSub, 2)
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(result.region, (2))) as usize] as BinaryOp) == BinaryOp::OpSub
        && IR_A_SRC1[(ir_region_slot_r(result.region, (2))) as usize] == 3
}

// T399: neg(a - b) where (a-b) is also used → original preserved.
fn compiler_main_test_neg_sub_result_used() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpSub, 1)
    instrs[1] = ir_unaryop(3, UnaryOp::OpNeg, 2)
    instrs[2] = ir_binop(4, 2, BinaryOp::OpAdd, 3)
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && IR_A_SRC1[(ir_region_slot_r(result.region, (0))) as usize] == 0
        && (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 1
        && IR_A_SRC2[(ir_region_slot_r(result.region, (1))) as usize] == 0
}


// ============================================================================
// Sprint 115/116/118 — sqrt builtin, Knowledge layout, print_f64 tests
// ============================================================================

// T400: name_is_sqrt recognizes "sqrt" and rejects non-matches
fn compiler_main_test_name_is_sqrt() -> bool with Mut, Panic, Div {
    var n = empty_name()
    n.buf[0] = 115 as i8   // 's'
    n.buf[1] = 113 as i8   // 'q'
    n.buf[2] = 114 as i8   // 'r'
    n.buf[3] = 116 as i8   // 't'
    n.len = 4
    let ok1 = name_is_sqrt(n)
    var n2 = empty_name()
    n2.buf[0] = 115 as i8
    n2.buf[1] = 113 as i8
    n2.buf[2] = 114 as i8
    n2.len = 3
    let ok2 = name_is_sqrt(n2) == false
    var n3 = empty_name()
    n3.buf[0] = 109 as i8
    n3.buf[1] = 97 as i8
    n3.buf[2] = 105 as i8
    n3.buf[3] = 110 as i8
    n3.len = 4
    let ok3 = name_is_sqrt(n3) == false
    ok1 && ok2 && ok3
}

// T401: emit_sqrtsd_xmm0_xmm0 emits F2 0F 51 C0 (4 bytes)
fn compiler_main_test_sqrtsd_encoding() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = emit_sqrtsd_xmm0_xmm0(buf)
    buf.len == 4
        && buf.bytes[0] == (0xF2 as i8)
        && buf.bytes[1] == (0x0F as i8)
        && buf.bytes[2] == (0x51 as i8)
        && buf.bytes[3] == (0xC0 as i8)
}

// T402: name_is_print_f64 recognizes "print_f64" and rejects non-matches
fn compiler_main_test_name_is_print_f64() -> bool with Mut, Panic, Div {
    var n1 = empty_name()
    n1.len = 9
    n1.buf[0] = 112 as i8   // 'p'
    n1.buf[1] = 114 as i8   // 'r'
    n1.buf[2] = 105 as i8   // 'i'
    n1.buf[3] = 110 as i8   // 'n'
    n1.buf[4] = 116 as i8   // 't'
    n1.buf[5] = 95 as i8    // '_'
    n1.buf[6] = 102 as i8   // 'f'
    n1.buf[7] = 54 as i8    // '6'
    n1.buf[8] = 52 as i8    // '4'
    if !name_is_print_f64(n1) { return false }
    var n2 = empty_name()
    n2.len = 9
    n2.buf[0] = 112 as i8
    n2.buf[1] = 114 as i8
    n2.buf[2] = 105 as i8
    n2.buf[3] = 110 as i8
    n2.buf[4] = 116 as i8
    n2.buf[5] = 95 as i8
    n2.buf[6] = 105 as i8   // 'i'
    n2.buf[7] = 110 as i8   // 'n'
    n2.buf[8] = 116 as i8   // 't'
    if name_is_print_f64(n2) { return false }
    true
}

// T403: emit_builtin_print_f64 produces substantial code
fn compiler_main_test_emit_print_f64_produces_code() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    let before_len = nc.code.len
    nc = emit_builtin_print_f64(nc)
    let after_len = nc.code.len
    (after_len - before_len) > 50
}

// T404: Knowledge<f64> layout registration -- 5 NAMES over 4 SLOTS (#1499).
// fields[3] `epsilon` ALIASES `confidence` on index 2; fields[4] `provenance`
// takes its own index 3. Both names must be present or the lookup falls
// through -- reads to the legacy buf[0] % 64 hash, struct-literal writes to the
// positional default -- and lands on an unrelated slot.
fn compiler_main_test_knowledge_layout_registered() -> bool with Mut, Panic, Div {
    let table = ir_register_knowledge_layout(empty_struct_layout_table())
    if table.count != 1 { return false }
    let entry = table.entries[0]
    if !ir_name_eq(entry.type_name, make_name("Knowledge")) { return false }
    if entry.field_count != 5 { return false }
    if !ir_name_eq(ir_name_at(entry.fields[0].name_id), make_name("value")) { return false }
    if entry.fields[0].index != 0 { return false }
    if !ir_name_eq(ir_name_at(entry.fields[1].name_id), make_name("variance")) { return false }
    if entry.fields[1].index != 1 { return false }
    if !ir_name_eq(ir_name_at(entry.fields[2].name_id), make_name("confidence")) { return false }
    if entry.fields[2].index != 2 { return false }
    // `epsilon` names the SAME slot as `confidence`, so it must carry index 2 --
    // a distinct index here would be a fourth field, not an alias.
    if !ir_name_eq(ir_name_at(entry.fields[3].name_id), make_name("epsilon")) { return false }
    if entry.fields[3].index != 2 { return false }
    // `provenance` is the one entry that is NOT an alias: its own slot, so that a
    // struct literal naming it stops overwriting whichever field sits at its
    // positional index.
    if !ir_name_eq(ir_name_at(entry.fields[4].name_id), make_name("provenance")) { return false }
    if entry.fields[4].index != 3 { return false }
    true
}

// T405: Knowledge field index lookup resolves value=0, variance=1, confidence=2
fn compiler_main_test_knowledge_field_idx_lookup() -> bool with Mut, Panic, Div {
    let table = ir_register_knowledge_layout(empty_struct_layout_table())
    // Scan for "value" field
    var found_value: i64 = -1
    var si: i64 = 0
    while si < table.count {
        var fi: i64 = 0
        while fi < table.entries[si].field_count {
            if ir_name_eq(ir_name_at(table.entries[si].fields[fi].name_id), make_name("value")) {
                found_value = table.entries[si].fields[fi].index
            }
            fi = fi + 1
        }
        si = si + 1
    }
    if found_value != 0 { return false }
    // Scan for "variance"
    var found_var: i64 = -1
    si = 0
    while si < table.count {
        var fi2: i64 = 0
        while fi2 < table.entries[si].field_count {
            if ir_name_eq(ir_name_at(table.entries[si].fields[fi2].name_id), make_name("variance")) {
                found_var = table.entries[si].fields[fi2].index
            }
            fi2 = fi2 + 1
        }
        si = si + 1
    }
    if found_var != 1 { return false }
    // Scan for "confidence"
    var found_conf: i64 = -1
    si = 0
    while si < table.count {
        var fi3: i64 = 0
        while fi3 < table.entries[si].field_count {
            if ir_name_eq(ir_name_at(table.entries[si].fields[fi3].name_id), make_name("confidence")) {
                found_conf = table.entries[si].fields[fi3].index
            }
            fi3 = fi3 + 1
        }
        si = si + 1
    }
    if found_conf != 2 { return false }
    true
}


// Sprint 116 Block AM: OR superset mask elimination (T406-T411).
// SOTA: LLVM InstCombineAndOrXor.cpp.

// T406: (x | 0xFF) | 0x0F → IrCopy (0x0F subset of 0xFF).
fn compiler_main_test_or_superset_copy() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 255)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitOr, 1)
    instrs[2] = ir_load_imm(3, 15)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpBitOr, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 2
}

// T407: (x | 0xFFFF) | 0xFF → IrCopy (0xFF subset of 0xFFFF).
fn compiler_main_test_or_superset_wide() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
