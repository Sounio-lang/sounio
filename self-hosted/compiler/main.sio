    } else { println("  FAIL: T839") }
    if compiler_main_test_de_no_fold_and_op() {
        passed = passed + 1
        println("  T840 OK: Sprint 195 Block DE: r0&~r0 no fold by DE")
    } else { println("  FAIL: T840") }
    if compiler_main_test_de_no_fold_or_op() {
        passed = passed + 1
        println("  T841 OK: Sprint 195 Block DE: r0|~r0 no fold by DE")
    } else { println("  FAIL: T841") }

    // Sprint 196 Block DF: OR self-complement (T842-T847)
    if compiler_main_test_df_or_self_comp_basic() {
        passed = passed + 1
        println("  T842 OK: Sprint 196 Block DF: r0|~r0 -> -1")
    } else { println("  FAIL: T842") }
    if compiler_main_test_df_or_self_comp_comm() {
        passed = passed + 1
        println("  T843 OK: Sprint 196 Block DF: ~r0|r0 -> -1 comm")
    } else { println("  FAIL: T843") }
    if compiler_main_test_df_or_self_comp_chain() {
        passed = passed + 1
        println("  T844 OK: Sprint 196 Block DF: r0|~r0 yields -1 const")
    } else { println("  FAIL: T844") }
    if compiler_main_test_df_no_fold_diff_regs() {
        passed = passed + 1
        println("  T845 OK: Sprint 196 Block DF: r1|~r0 no fold diff regs")
    } else { println("  FAIL: T845") }
    if compiler_main_test_df_no_fold_xor_op() {
        passed = passed + 1
        println("  T846 OK: Sprint 196 Block DF: XOR handled by DE not DF")
    } else { println("  FAIL: T846") }
    if compiler_main_test_df_no_fold_and_op() {
        passed = passed + 1
        println("  T847 OK: Sprint 196 Block DF: r0&~r0 not handled by DF")
    } else { println("  FAIL: T847") }

    // Sprint 197 Block DG: NOT-XOR-operand unwrapping (T848-T853)
    if compiler_main_test_dg_not_xor_unwrap_basic() {
        passed = passed + 1
        println("  T848 OK: Sprint 197 Block DG: ~(r0^r1)^r1 -> ~r0")
    } else { println("  FAIL: T848") }
    if compiler_main_test_dg_not_xor_unwrap_lhs() {
        passed = passed + 1
        println("  T849 OK: Sprint 197 Block DG: ~(r0^r1)^r0 -> ~r1")
