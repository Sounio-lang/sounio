    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 3)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_mul3_sr(func)
    ocp_is_binop((IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode)) && (IR_A_BIN_OP[(ir_region_slot_r(result.region, (0))) as usize] as BinaryOp) == BinaryOp::OpAdd
}

// T325: 3 * x → two ADDs (left-constant)
fn compiler_main_test_mul3_left_const() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 3)
    instrs[1] = ir_binop(2, 1, BinaryOp::OpMul, 0)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_mul3_sr(func)
    ocp_is_binop((IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode)) && (IR_A_BIN_OP[(ir_region_slot_r(result.region, (0))) as usize] as BinaryOp) == BinaryOp::OpAdd
}

// T326: x * 4 → NOT folded by mul3
fn compiler_main_test_mul3_skip_pow2() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 4)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_mul3_sr(func)
    ocp_is_load_imm((IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode))
}

// T327: x * 5 → NOT folded (only handle 3)
fn compiler_main_test_mul3_skip_5() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 5)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_mul3_sr(func)
    ocp_is_load_imm((IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode))
}

// T328: Both-const → const_fold takes priority
fn compiler_main_test_mul3_both_const_skip() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 3)
    instrs[1] = ir_load_imm(1, 7)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    let func = cp_make_test_func(instrs, 3)
    let folded = ocp_const_fold(func)
    let result = ocp_mul3_sr(folded)
    ocp_is_load_imm((IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode)) && IR_A_IMM_I64[(ir_region_slot_r(result.region, (2))) as usize] == 21
}

// T329: ADD sequence structure verification
fn compiler_main_test_mul3_add_sequence() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 3)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_mul3_sr(func)
    let i0 = ir_arena_load(ir_region_slot_r(result.region, (0)))
    let i1 = ir_arena_load(ir_region_slot_r(result.region, (1)))
    ocp_is_binop(i0.op) && i0.bin_op == BinaryOp::OpAdd && i0.dst == 1 && i0.src1 == 0 && i0.src2 == 0
        && ocp_is_binop(i1.op) && i1.bin_op == BinaryOp::OpAdd && i1.dst == 2 && i1.src1 == 1 && i1.src2 == 0
}

