fn compiler_main_test_df_or_self_comp_chain() -> bool with Mut, Div, Panic {
    // r2 = ~r0; r3 = r0|r2 → -1; r4 = r3+1 folds to 0 via const prop
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
