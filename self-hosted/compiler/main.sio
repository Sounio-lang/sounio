    (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (4))) as usize] as BinaryOp) == BinaryOp::OpSub
}
fn compiler_main_test_ct_no_fold_add_op() -> bool with Mut, Div, Panic {
    // r0*5 + r0*3 → CS fires (add), not CT (sub)
