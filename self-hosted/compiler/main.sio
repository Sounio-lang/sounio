}

// T361: same-direction shifts do NOT fold (x << 4) << 4 stays as-is
fn compiler_main_test_shift_mask_same_dir_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 4)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpShl, 1)
    instrs[2] = ir_load_imm(3, 4)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpShl, 3)
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    // Same direction: should NOT become AND
    IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 2
}

// T362: unequal amounts: (x << 4) >> 8 — amounts differ, no simple fold
fn compiler_main_test_shift_mask_unequal_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 4)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpShl, 1)
