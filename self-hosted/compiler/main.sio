        passed = passed + 1
        println("  T949 OK: Sprint 213 Block DW: (r0&r1)|~r0 no fold OR outer")
    } else { println("  FAIL: T949") }

    // Sprint 214 Block DX: OR complement saturation (T950-T955)
    if compiler_main_test_dx_or_comp_sat_lhs() {
        passed = passed + 1
        println("  T950 OK: Sprint 214 Block DX: (r0|r1)|~r0 -> -1")
    } else { println("  FAIL: T950") }
