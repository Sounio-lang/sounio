    ir_arena_store(ir_region_slot_w(main_fn.region, (3)), ir_call(3, 1, len_name, Some(Box::new(ir_reg_list_single(2))), 1))
    ir_arena_store(ir_region_slot_w(main_fn.region, (4)), ir_return(3))
