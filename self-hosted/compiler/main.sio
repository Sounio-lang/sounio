// self-hosted::compiler::main
//
// MAIN ENTRY POINT FOR SELF-HOSTED SOUNIO COMPILER
// No stubs. No fakes. Real implementation.
//
// Usage: souc input.sio -o output

use io
use string
use lexer
use parser
use typecheck
use gen

// ============================================================================
// COMPILER DRIVER
// ============================================================================

struct CompilerOptions {
    input_file: string,
    output_file: string,
    target: string,
    optimize: bool,
    verbose: bool,
    emit_ast: bool,
    emit_tokens: bool,
}

struct CompileResult {
    success: bool,
    errors: Vec<string>,
    output: string,
}

// ============================================================================
// MAIN
// ============================================================================

fn main() with IO, Panic {
    let args = get_args()
    
    println("╔══════════════════════════════════════════════════════════════╗")
    println("║          SOUNIO SELF-HOSTED COMPILER v0.1.0                  ║")
    println("║                                                              ║")
    println("║  No stubs. No fakes. Real Sounio code.                       ║")
    println("╚══════════════════════════════════════════════════════════════╝")
    println("")
    
    // Parse command line
    let opts = parse_options(args)
    
    if opts.verbose {
        println("Options:")
        println("  Input:  " + opts.input_file)
        println("  Output: " + opts.output_file)
        println("  Target: " + opts.target)
        println("")
    }
    
    // Compile
    let result = compile(opts)
    
    if result.success {
        println("✅ Compilation successful!")
        println("   Output: " + result.output)
        
        if vec_len(result.errors) > 0 {
            println("")
            println("Warnings:")
            var i: i64 = 0
            while i < vec_len(result.errors) {
                println("  ⚠️  " + vec_get(result.errors, i))
                i = i + 1
            }
        }
    } else {
        println("❌ Compilation failed!")
        println("")
        println("Errors:")
        var i: i64 = 0
        while i < vec_len(result.errors) {
            println("  ❌ " + vec_get(result.errors, i))
            i = i + 1
        }
        exit(1)
    }
}

// ============================================================================
// COMMAND LINE PARSING
// ============================================================================

fn parse_options(args: Vec<string>) -> CompilerOptions with Panic {
    var input_file = ""
    var output_file = "a.out"
    var target = "native"
    var optimize = false
    var verbose = false
    var emit_ast = false
    var emit_tokens = false
    
    var i: i64 = 1  // Skip program name
    while i < vec_len(args) {
        let arg = vec_get(args, i)
        
        if arg == "-o" || arg == "--output" {
            i = i + 1
            if i < vec_len(args) {
                output_file = vec_get(args, i)
            }
        }
        else if arg == "-t" || arg == "--target" {
            i = i + 1
            if i < vec_len(args) {
                target = vec_get(args, i)
            }
        }
        else if arg == "-O" || arg == "--optimize" {
            optimize = true
        }
        else if arg == "-v" || arg == "--verbose" {
            verbose = true
        }
        else if arg == "--emit-ast" {
            emit_ast = true
        }
        else if arg == "--emit-tokens" {
            emit_tokens = true
        }
        else if arg == "-h" || arg == "--help" {
            print_help()
            exit(0)
        }
        else if str_char_at(arg, 0) != 45 {  // Doesn't start with -
            input_file = arg
        }
        
        i = i + 1
    }
    
    if input_file == "" {
        println("Error: No input file specified")
        print_help()
        exit(1)
    }
    
    CompilerOptions {
        input_file: input_file,
        output_file: output_file,
        target: target,
        optimize: optimize,
        verbose: verbose,
        emit_ast: emit_ast,
        emit_tokens: emit_tokens,
    }
}

fn print_help() with IO {
    println("Usage: souc [options] <input.sio>")
    println("")
    println("Options:")
    println("  -o, --output <file>    Output file (default: a.out)")
    println("  -t, --target <target>  Target: native, wasm, llvm (default: native)")
    println("  -O, --optimize         Enable optimizations")
    println("  -v, --verbose          Verbose output")
    println("  --emit-ast             Print AST to stdout")
    println("  --emit-tokens          Print tokens to stdout")
    println("  -h, --help             Print this help message")
    println("")
    println("Examples:")
    println("  souc hello.sio")
    println("  souc hello.sio -o hello")
    println("  souc hello.sio -t wasm -o hello.wasm")
}

// ============================================================================
// COMPILATION PIPELINE
// ============================================================================

fn compile(opts: CompilerOptions) -> CompileResult with IO, Panic {
    var errors = vec_new()
    
    // Stage 1: Read input
    if opts.verbose {
        println("📖 Reading input file...")
    }
    
    let source = match read_file(opts.input_file) {
        Result::Ok(content) => content,
        Result::Err(msg) => {
            vec_push(errors, "Cannot read file: " + msg)
            return CompileResult {
                success: false,
                errors: errors,
                output: "",
            }
        }
    }
    
    if opts.verbose {
        println("   " + int_to_string(str_len(source)) + " bytes")
        println("")
    }
    
    // Stage 2: Lexical analysis
    if opts.verbose {
        println("🔤 Lexical analysis...")
    }
    
    let tokens = lex(source)
    
    if opts.verbose {
        println("   " + int_to_string(vec_len(tokens)) + " tokens")
    }
    
    if opts.emit_tokens {
        println("")
        println("Tokens:")
        var i: i64 = 0
        while i < vec_len(tokens) {
            let tok = vec_get(tokens, i)
            println("  " + token_to_string(tok))
            i = i + 1
        }
        println("")
    }
    
    // Stage 3: Parsing
    if opts.verbose {
        println("🌳 Parsing...")
    }
    
    let ast = parse(tokens)
    
    if opts.verbose {
        println("   AST nodes: " + int_to_string(count_nodes(ast)))
    }
    
    if opts.emit_ast {
        println("")
        println("AST:")
        println(expr_to_string(ast))
        println("")
    }
    
    // Stage 4: Type checking
    if opts.verbose {
        println("✓ Type checking...")
    }
    
    let (type_errors, result_ty) = typecheck(ast)
    
    if vec_len(type_errors) > 0 {
        var i: i64 = 0
        while i < vec_len(type_errors) {
            vec_push(errors, vec_get(type_errors, i))
            i = i + 1
        }
        
        return CompileResult {
            success: false,
            errors: errors,
            output: "",
        }
    }
    
    if opts.verbose {
        println("   Result type: " + type_to_string(result_ty))
    }
    
    // Stage 5: Code generation
    if opts.verbose {
        println("⚙️  Code generation...")
    }
    
    let output = match opts.target {
        "native" => gen_native(ast, opts.optimize),
        "wasm" => gen_wasm(ast, opts.optimize),
        "llvm" => gen_llvm(ast, opts.optimize),
        _ => {
            vec_push(errors, "Unknown target: " + opts.target)
            return CompileResult {
                success: false,
                errors: errors,
                output: "",
            }
        }
    }
    
    // Stage 6: Write output
    if opts.verbose {
        println("💾 Writing output...")
    }
    
    match write_file(opts.output_file, output) {
        Result::Ok(_) => {}
        Result::Err(msg) => {
            vec_push(errors, "Cannot write output: " + msg)
            return CompileResult {
                success: false,
                errors: errors,
                output: "",
            }
        }
    }
    
    if opts.verbose {
        println("   " + int_to_string(str_len(output)) + " bytes")
    }
    
    CompileResult {
        success: vec_len(errors) == 0,
        errors: errors,
        output: opts.output_file,
    }
}

// ============================================================================
// UTILITIES
// ============================================================================

fn count_nodes(expr: Expr) -> i64 with {
    var count = 1
    var i: i64 = 0
    while i < vec_len(expr.children) {
        count = count + count_nodes(vec_get(expr.children, i))
        i = i + 1
    }
    count
}

fn int_to_string(n: i64) -> string with Mut, Panic, Div {
    if n == 0 {
        "0"
    } else {
        let negative = n < 0
        var num = if negative { -n } else { n }
        var result = ""
        while num > 0 {
            let digit = num % 10
            let ch = 48 + digit
            result = char_from_i64(ch) + result
            num = num / 10
        }
        if negative { "-" + result } else { result }
    }
}

fn char_from_i64(n: i64) -> string with Mut, Panic {
    str_substr("0123456789", n, 1)
}

enum Result<T, E> {
    Ok(T),
    Err(E),
}

