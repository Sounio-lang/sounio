    let result = ocp_const_fold(func)
    if (IR_A_BIN_OP[(ir_region_slot_r(result.region, (1))) as usize] as BinaryOp) != BinaryOp::OpShl { return false }
    if IR_A_IMM_I64[(ir_region_slot_r(result.region, (0))) as usize] != 1 { return false }
