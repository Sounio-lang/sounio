    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (2))) as usize] == 0
}

// Sprint 84 Block L: Associative constant-chain folding self-tests (T220–T225)

// T220: (r0+3)+5 → r0+8 via Block L add-chain fold.
fn compiler_main_test_assoc_add_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 3)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpAdd, 1)   // r2 = r0 + 3
    instrs[2] = ir_load_imm(3, 5)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpAdd, 3)   // r4 = r2 + 5 → r0 + 8
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    // r3 (const reg) should be patched to 8; r4's src1 should be r0 (reg 0)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 0
        && IR_A_IMM_I64[(ir_region_slot_r(result.region, (2))) as usize] == 8
}

// T221: (r0*2)*4 → r0*8 via Block L mul-chain fold.
fn compiler_main_test_assoc_mul_chain() -> bool with IO, Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 2)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)   // r2 = r0 * 2
    instrs[2] = ir_load_imm(3, 4)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpMul, 3)   // r4 = r2 * 4 → r0 * 8
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    let ok = (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 0
        && IR_A_IMM_I64[(ir_region_slot_r(result.region, (2))) as usize] == 8
    if !ok {
        println("DBG T221:")
        print("  i0 op="); if (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrLoadImm { print("loadimm") } else { print("other") }; print(" imm="); print_int(IR_A_IMM_I64[(ir_region_slot_r(result.region, (0))) as usize]); print("\n")
        print("  i1 op="); if (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp { print("binop") } else if (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy { print("copy") } else if (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLoadImm { print("loadimm") } else { print("other") }; print(" dst="); print_int(IR_A_DST[(ir_region_slot_r(result.region, (1))) as usize]); print(" src1="); print_int(IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize]); print(" src2="); print_int(IR_A_SRC2[(ir_region_slot_r(result.region, (1))) as usize]); print(" bin="); if (IR_A_BIN_OP[(ir_region_slot_r(result.region, (1))) as usize] as BinaryOp) == BinaryOp::OpMul { print("mul") } else if (IR_A_BIN_OP[(ir_region_slot_r(result.region, (1))) as usize] as BinaryOp) == BinaryOp::OpShl { print("shl") } else if (IR_A_BIN_OP[(ir_region_slot_r(result.region, (1))) as usize] as BinaryOp) == BinaryOp::OpAdd { print("add") } else { print("other") }; print("\n")
        print("  i2 op="); if (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrLoadImm { print("loadimm") } else { print("other") }; print(" imm="); print_int(IR_A_IMM_I64[(ir_region_slot_r(result.region, (2))) as usize]); print("\n")
        print("  i3 op="); if (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrBinOp { print("binop") } else if (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrCopy { print("copy") } else if (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrLoadImm { print("loadimm") } else { print("other") }; print(" dst="); print_int(IR_A_DST[(ir_region_slot_r(result.region, (3))) as usize]); print(" src1="); print_int(IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize]); print(" src2="); print_int(IR_A_SRC2[(ir_region_slot_r(result.region, (3))) as usize]); print(" bin="); if (IR_A_BIN_OP[(ir_region_slot_r(result.region, (3))) as usize] as BinaryOp) == BinaryOp::OpMul { print("mul") } else if (IR_A_BIN_OP[(ir_region_slot_r(result.region, (3))) as usize] as BinaryOp) == BinaryOp::OpShl { print("shl") } else if (IR_A_BIN_OP[(ir_region_slot_r(result.region, (3))) as usize] as BinaryOp) == BinaryOp::OpAdd { print("add") } else { print("other") }; print("\n")
    }
    ok
}

// T222: (r0 & 0xFF) & 0x0F → r0 & 0x0F via Block L bitand-chain fold.
fn compiler_main_test_assoc_bitand_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 255)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitAnd, 1)  // r2 = r0 & 0xFF
    instrs[2] = ir_load_imm(3, 15)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpBitAnd, 3)  // r4 = r2 & 0x0F → r0 & 0x0F
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 0
        && IR_A_IMM_I64[(ir_region_slot_r(result.region, (2))) as usize] == 15
}

// T223: (r0 | 0x80) | 0x40 → r0 | 0xC0 via Block L bitor-chain fold.
fn compiler_main_test_assoc_bitor_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 128)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitOr, 1)   // r2 = r0 | 0x80
    instrs[2] = ir_load_imm(3, 64)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpBitOr, 3)   // r4 = r2 | 0x40 → r0 | 0xC0
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 0
        && IR_A_IMM_I64[(ir_region_slot_r(result.region, (2))) as usize] == 192
}

// T224: (r0 ^ 5) ^ 3 → r0 ^ 6 via Block L bitxor-chain fold (5^3=6).
fn compiler_main_test_assoc_bitxor_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 5)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitXor, 1)  // r2 = r0 ^ 5
    instrs[2] = ir_load_imm(3, 3)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpBitXor, 3)  // r4 = r2 ^ 3 → r0 ^ 6
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 0
        && IR_A_IMM_I64[(ir_region_slot_r(result.region, (2))) as usize] == 6
}

// T225: (r0-3)-5 → no Block L fold (OpSub not in assoc set).
fn compiler_main_test_assoc_non_assoc_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 3)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpSub, 1)     // r2 = r0 - 3
    instrs[2] = ir_load_imm(3, 5)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpSub, 3)     // r4 = r2 - 5 (no fold)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    // r4 should still be r2-5 (unchanged: src1=r2, not patched to r0)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrBinOp && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 2
}

// Sprint 86 Block M: Negation arithmetic self-tests (T230–T235)

// T230: x * (-1) → IrBinOp(Sub, r_zero, x) — mul by -1 becomes 0-x.
fn compiler_main_test_neg_mul_minus_one() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, -1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp && (IR_A_BIN_OP[(ir_region_slot_r(result.region, (1))) as usize] as BinaryOp) == BinaryOp::OpSub
}

// T231: x / (-1) → IrBinOp(Sub, r_zero, x) — div by -1 becomes 0-x.
fn compiler_main_test_neg_div_minus_one() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, -1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpDiv, 1)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp && (IR_A_BIN_OP[(ir_region_slot_r(result.region, (1))) as usize] as BinaryOp) == BinaryOp::OpSub
}

// T232: x % (-1) → IrLoadImm(0) — remainder by -1 is always 0.
fn compiler_main_test_neg_rem_minus_one() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, -1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpRem, 1)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (1))) as usize] == 0
}

// T233: neg(neg(x)) → IrCopy(x) — double negation eliminated.
fn compiler_main_test_neg_double_neg() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_unaryop(1, UnaryOp::OpNeg, 0)
    instrs[1] = ir_unaryop(2, UnaryOp::OpNeg, 1)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 0
}

// T234: neg(x) single — no double-neg fold, stays as IrUnaryOp(Neg).
fn compiler_main_test_neg_single_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_unaryop(1, UnaryOp::OpNeg, 0)
    let func   = cp_make_test_func(instrs, 1)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrUnaryOp && (IR_A_UN_OP[(ir_region_slot_r(result.region, (0))) as usize] as UnaryOp) == UnaryOp::OpNeg
}

// T235: (-1) * x → IrBinOp(Sub, r_zero, x) — commutative flip (s1 is const -1).
fn compiler_main_test_neg_commut_mul_minus_one() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, -1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp && (IR_A_BIN_OP[(ir_region_slot_r(result.region, (1))) as usize] as BinaryOp) == BinaryOp::OpSub
}

// ============================================================================
// Sprint 87 Block N — IrLoadImm deduplication tests (T236-T241)
// ============================================================================

// T236: two IrLoadImm with same value → second becomes IrCopy of first.
fn compiler_main_test_dedup_same_value() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 7)
    instrs[1] = ir_load_imm(1, 7)
    let func   = cp_make_test_func(instrs, 2)
    let result = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 0
}

// T237: two IrLoadImm with different values → no dedup.
fn compiler_main_test_dedup_diff_values() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 7)
    instrs[1] = ir_load_imm(1, 8)
    let func   = cp_make_test_func(instrs, 2)
    let result = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (1))) as usize] == 8
}

// T238: dedup + downstream const-fold: r0=7, r1=7 (dedup→IrCopy), r2=r0+r1 → IrLoadImm(14).
fn compiler_main_test_dedup_then_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 7)
    instrs[1] = ir_load_imm(1, 7)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    let func   = cp_make_test_func(instrs, 3)
    let result = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (2))) as usize] == 14
}

// T239: three occurrences of same constant → second and third both IrCopy of first.
fn compiler_main_test_dedup_triple() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 42)
    instrs[1] = ir_load_imm(1, 42)
    instrs[2] = ir_load_imm(2, 42)
    let func   = cp_make_test_func(instrs, 3)
    let result = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy && (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrCopy
}

// T240: dedup preserves first occurrence; r0 stays IrLoadImm.
fn compiler_main_test_dedup_first_kept() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 99)
    instrs[1] = ir_load_imm(1, 99)
    let func   = cp_make_test_func(instrs, 2)
    let result = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (0))) as usize] == 99
}

// T241: different constants interleaved → no cross-dedup.
fn compiler_main_test_dedup_no_cross() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 3)
    instrs[1] = ir_load_imm(1, 5)
    instrs[2] = ir_load_imm(2, 3)
    let func   = cp_make_test_func(instrs, 3)
    let result = opt_cleanup_function(func)
    // r1 stays IrLoadImm(5); r2 becomes IrCopy(0) because 3==3
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrCopy
}

// ============================================================================
// Sprint 87: float IR opcode + native-v2 whitelist tests (T242–T245)
// ============================================================================

// T242: ir_load_float sets op=IrLoadFloat and stores bits correctly.
fn compiler_main_test_ir_load_float_opcode() -> bool with Mut, Div, Panic {
    let instr = ir_load_float(3, 1.5)
    instr.op == IrOpcode::IrLoadFloat && instr.dst == 3
}

// T243: ir_int_to_float sets op=IrIntToFloat with correct dst/src1.
fn compiler_main_test_ir_int_to_float_opcode() -> bool with Mut, Div, Panic {
    let instr = ir_int_to_float(5, 2)
    instr.op == IrOpcode::IrIntToFloat && instr.dst == 5 && instr.src1 == 2
}

// T244: ir_float_to_int sets op=IrFloatToInt with correct dst/src1.
fn compiler_main_test_ir_float_to_int_opcode() -> bool with Mut, Div, Panic {
    let instr = ir_float_to_int(7, 4)
    instr.op == IrOpcode::IrFloatToInt && instr.dst == 7 && instr.src1 == 4
}

// T245: native-v2 whitelist accepts all three new float opcodes.
fn compiler_main_test_native_v2_float_whitelist() -> bool with Mut, Div, Panic {
    native_v2_supported_ir_opcode(IrOpcode::IrLoadFloat) &&
    native_v2_supported_ir_opcode(IrOpcode::IrIntToFloat) &&
    native_v2_supported_ir_opcode(IrOpcode::IrFloatToInt)
}

// ============================================================================
// Sprint 88 Block O — mul-div cancellation tests (T246-T251)
// ============================================================================

// T246: r1=x*4; r2=r1/4 → r2=IrCopy(x).
fn compiler_main_test_muldiv_cancel_basic() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 4)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    instrs[2] = ir_load_imm(3, 4)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpDiv, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 0
}

// T247: r1=x*4; r2=r1/5 → no fold (4 ≠ 5).
fn compiler_main_test_muldiv_no_cancel_diff() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 4)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    instrs[2] = ir_load_imm(3, 5)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpDiv, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrBinOp
}

// T248: r1=x*0 skipped (C=0 guard — zero mul not tracked).
fn compiler_main_test_muldiv_no_cancel_zero() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 0)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    instrs[2] = ir_load_imm(3, 0)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpDiv, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    // r2=x*0 folds to IrLoadImm(0); r4=0/0 not a muldiv cancel (C=0 guard)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLoadImm
}

// T249: r1=4*x (commutative) → r2=r1/4 → r2=IrCopy(x).
fn compiler_main_test_muldiv_cancel_commut() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 4)
    instrs[1] = ir_binop(2, 1, BinaryOp::OpMul, 0)
    instrs[2] = ir_load_imm(3, 4)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpDiv, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 0
}

// T250: r1=x+4 (add, not mul) → r2=r1/4 — no fold.
fn compiler_main_test_muldiv_no_cancel_non_mul() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 4)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs[2] = ir_load_imm(3, 4)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpDiv, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrBinOp
}

// T251: r1=x*7; r2=r1/7; r3=r2+0 — r2=IrCopy(x), r3=IrCopy via identity.
fn compiler_main_test_muldiv_cancel_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 7)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    instrs[2] = ir_load_imm(3, 7)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpDiv, 3)
    instrs[4] = ir_load_imm(5, 0)
    instrs[5] = ir_binop(6, 4, BinaryOp::OpAdd, 5)
    let func   = cp_make_test_func(instrs, 6)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrCopy && (IR_A_OP[(ir_region_slot_r(result.region, (5))) as usize] as IrOpcode) == IrOpcode::IrCopy
}

// Sprint 89 Block P — add-sub/sub-add cancellation tests (T252-T257)
// (x + C) - C → IrCopy(x)  ;  (x - C) + C → IrCopy(x).
// SOTA: LLVM InstCombineAddSub.cpp; Muchnick §12.2.

// T252: r1 = x + 10; r2 = r1 - 10  →  r2 = IrCopy(x).
fn compiler_main_test_addsub_cancel_add_first() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 10)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs[2] = ir_load_imm(3, 10)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpSub, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 0
}

// T253: r1 = x - 7; r2 = r1 + 7  →  r2 = IrCopy(x).
fn compiler_main_test_addsub_cancel_sub_first() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 7)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpSub, 1)
    instrs[2] = ir_load_imm(3, 7)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpAdd, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 0
}

// T254: Commutative — r1 = 5 + x; r2 = r1 - 5  →  r2 = IrCopy(x).
fn compiler_main_test_addsub_cancel_commut() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 5)
    instrs[1] = ir_binop(2, 1, BinaryOp::OpAdd, 0)
    instrs[2] = ir_load_imm(3, 5)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpSub, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 0
}

// T255: Mismatched constants — r1 = x + 3; r2 = r1 - 5  →  no fold.
fn compiler_main_test_addsub_no_cancel_mismatch() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 3)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs[2] = ir_load_imm(3, 5)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpSub, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrBinOp
}

// T256: Negative constant — r1 = x + (-4); r2 = r1 - (-4)  →  r2 = IrCopy(x).
fn compiler_main_test_addsub_cancel_neg_const() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, -4)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs[2] = ir_load_imm(3, -4)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpSub, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 0
}

// T257: Chain — r1 = x + 10; r2 = r1 - 10; r3 = r2 + 1 — r2=IrCopy(x), r3=BinOp(x, 1).
fn compiler_main_test_addsub_cancel_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 10)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs[2] = ir_load_imm(3, 10)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpSub, 3)
    instrs[4] = ir_load_imm(5, 1)
    instrs[5] = ir_binop(6, 4, BinaryOp::OpAdd, 5)
    let func   = cp_make_test_func(instrs, 6)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrCopy && (IR_A_OP[(ir_region_slot_r(result.region, (5))) as usize] as IrOpcode) == IrOpcode::IrBinOp
}

// Sprint 93 Block Q — copy propagation tests (T258-T263)

// T258: r1 = IrCopy(r0); r2 = IrBinOp(r1, +, 5) → r2 = IrBinOp(r0, +, 5).
fn compiler_main_test_copy_prop_basic() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_copy(1, 0)
    instrs[1] = ir_load_imm(2, 5)
    instrs[2] = ir_binop(3, 1, BinaryOp::OpAdd, 2)
    let func = cp_make_test_func(instrs, 3)
    let folded = ocp_const_fold(func)
    let result = ocp_copy_prop(folded)
    // src1 of the BinOp should be rewritten from r1 → r0.
    IR_A_SRC1[(ir_region_slot_r(result.region, (2))) as usize] == 0
}

// T259: Chain collapse — r1 = IrCopy(r0); r2 = IrCopy(r1) → r2 maps to r0.
fn compiler_main_test_copy_prop_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_copy(1, 0)
    instrs[1] = ir_copy(2, 1)
    instrs[2] = ir_load_imm(3, 10)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpAdd, 3)
    let func = cp_make_test_func(instrs, 4)
    let folded = ocp_const_fold(func)
    let result = ocp_copy_prop(folded)
    // r2's copy chain collapses: r2→r1→r0, so BinOp src1 = r0.
    IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 0 && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 0
}

// T260: Non-copy overwrite clears mapping — r1=IrCopy(r0); r1=IrLoadImm(42); use r1 → stays r1.
fn compiler_main_test_copy_prop_overwrite() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_copy(1, 0)
    instrs[1] = ir_load_imm(1, 42)
    instrs[2] = ir_load_imm(2, 5)
    instrs[3] = ir_binop(3, 1, BinaryOp::OpAdd, 2)
    let func = cp_make_test_func(instrs, 4)
    let folded = ocp_const_fold(func)
    let result = ocp_copy_prop(folded)
    // After overwrite, r1 is no longer a copy of r0. BinOp stays as-is (or const-folded).
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrLoadImm || IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 1
}

// T261: Both src1 and src2 rewritten — r1=IrCopy(r0); r3=IrCopy(r2); r4=r1+r3 → r4=r0+r2.
fn compiler_main_test_copy_prop_both_srcs() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_copy(1, 0)
    instrs[1] = ir_copy(3, 2)
    instrs[2] = ir_binop(4, 1, BinaryOp::OpAdd, 3)
    let func = cp_make_test_func(instrs, 3)
    let folded = ocp_const_fold(func)
    let result = ocp_copy_prop(folded)
    IR_A_SRC1[(ir_region_slot_r(result.region, (2))) as usize] == 0 && IR_A_SRC2[(ir_region_slot_r(result.region, (2))) as usize] == 2
}

// T262: Self-copy (IrCopy(r0, r0)) — should NOT create circular mapping.
fn compiler_main_test_copy_prop_self_copy() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_copy(0, 0)
    instrs[1] = ir_load_imm(1, 7)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    let func = cp_make_test_func(instrs, 3)
    let folded = ocp_const_fold(func)
    let result = ocp_copy_prop(folded)
    // r0=IrCopy(r0) → copy_target[0]=0, which should still work: BinOp src1 stays r0.
    IR_A_SRC1[(ir_region_slot_r(result.region, (2))) as usize] == 0
}

// T263: Copy + const_fold integration — r1=IrLoadImm(3); r2=IrCopy(r1); r3=r2+5 → r3=IrLoadImm(8).
fn compiler_main_test_copy_prop_const_integration() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 3)
    instrs[1] = ir_copy(2, 1)
    instrs[2] = ir_load_imm(3, 5)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpAdd, 3)
    let func = cp_make_test_func(instrs, 4)
    // const_fold already handles copy-through-constant (Sprint 69), so r4=3+5=8.
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (3))) as usize] == 8
}

// Sprint 94 Block R — dead store elimination tests (T264-T269)

// T264: r1=IrLoadImm(10); r1=IrLoadImm(20); use r1 → first store is dead.
fn compiler_main_test_dse_basic() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 10)
    instrs[1] = ir_load_imm(1, 20)
    instrs[2] = ir_binop(2, 1, BinaryOp::OpAdd, 0)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_dse(func)
    // First IrLoadImm(1,10) should be NOP'd.
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrNop && (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLoadImm
}

// T265: r1=IrLoadImm(10); use r1; r1=IrLoadImm(20) → first store is live (read in between).
fn compiler_main_test_dse_live_store() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 10)
    instrs[1] = ir_binop(2, 1, BinaryOp::OpAdd, 0)
    instrs[2] = ir_load_imm(1, 20)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_dse(func)
    // First store is live (r1 read at [1]), should NOT be NOP'd.
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (0))) as usize] == 10
}

// T266: r1=IrLoadImm(5); label; r1=IrLoadImm(7) → label clears tracking, no DSE.
fn compiler_main_test_dse_label_barrier() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 5)
    instrs[1] = ir_label(0)
    instrs[2] = ir_load_imm(1, 7)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_dse(func)
    // Label is a barrier — first store survives.
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (0))) as usize] == 5
}

// T267: Multiple dead stores — r1=10; r1=20; r1=30 → only last survives.
fn compiler_main_test_dse_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 10)
    instrs[1] = ir_load_imm(1, 20)
    instrs[2] = ir_load_imm(1, 30)
    instrs[3] = ir_binop(2, 1, BinaryOp::OpAdd, 0)
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_dse(func)
    // First two stores are dead.
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrNop && (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrNop && (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrLoadImm
}

// T268: Different registers — r1=10; r2=20; use r1 → r1 is live, r2 is not affected.
fn compiler_main_test_dse_different_regs() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 10)
    instrs[1] = ir_load_imm(2, 20)
    instrs[2] = ir_binop(3, 1, BinaryOp::OpAdd, 2)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_dse(func)
    // Both are read — no dead stores.
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLoadImm
}

// T269: DSE + copy_prop integration — r1=IrCopy(r0); r1=IrLoadImm(42) → copy is dead after DSE.
fn compiler_main_test_dse_copy_integration() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_copy(1, 0)
    instrs[1] = ir_load_imm(1, 42)
    instrs[2] = ir_binop(2, 1, BinaryOp::OpAdd, 0)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_dse(func)
    // IrCopy to r1 is dead (overwritten without read).
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrNop && (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLoadImm
}

// Sprint 95 Block S — division/remainder identity folding tests (T270-T275)

// T270: x / x → IrLoadImm(dst, 1)  (same-register division).
fn compiler_main_test_div_self() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 42)
    instrs[1] = ir_binop(1, 0, BinaryOp::OpDiv, 0)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (1))) as usize] == 1
}

// T271: x % x → IrLoadImm(dst, 0)  (same-register remainder).
fn compiler_main_test_rem_self() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 42)
    instrs[1] = ir_binop(1, 0, BinaryOp::OpRem, 0)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (1))) as usize] == 0
}

// T272: 0 / x → IrLoadImm(dst, 0)  (zero dividend).
fn compiler_main_test_zero_div() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 0)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpDiv, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (1))) as usize] == 0
}

// T273: 0 % x → IrLoadImm(dst, 0)  (zero dividend mod).
fn compiler_main_test_zero_rem() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 0)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpRem, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (1))) as usize] == 0
}

// T274: x / 1 remains IrCopy (pre-existing, regression check).
fn compiler_main_test_div_one_regr() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpDiv, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 0
}

// T275: x/x chain — (x/x) + (x%x) → 1 + 0 → IrLoadImm(1).
fn compiler_main_test_div_rem_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 7)
    instrs[1] = ir_binop(1, 0, BinaryOp::OpDiv, 0)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpRem, 0)
    instrs[3] = ir_binop(3, 1, BinaryOp::OpAdd, 2)
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (3))) as usize] == 1
}

// Sprint 96 Block T — shift-chain combining tests (T276-T281)

// T276: (x << 2) << 3 → x << 5.
fn compiler_main_test_shift_chain_shl() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 2)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpShl, 1)     // r2 = r0 << 2
    instrs[2] = ir_load_imm(3, 3)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpShl, 3)     // r4 = r2 << 3 → r0 << 5
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    // r4 should now be (r0 << 5), and the constant should be combined to 5.
    IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 0 && IR_A_IMM_I64[(ir_region_slot_r(result.region, (2))) as usize] == 5
}

// T277: (x >> 1) >> 4 → x >> 5.
fn compiler_main_test_shift_chain_shr() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpShr, 1)     // r2 = r0 >> 1
    instrs[2] = ir_load_imm(3, 4)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpShr, 3)     // r4 = r2 >> 4 → r0 >> 5
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 0 && IR_A_IMM_I64[(ir_region_slot_r(result.region, (2))) as usize] == 5
}

// T278: Mixed directions — (x << 2) >> 3 — NO fold (different shift directions).
fn compiler_main_test_shift_chain_mixed_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 2)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpShl, 1)     // r2 = r0 << 2
    instrs[2] = ir_load_imm(3, 3)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpShr, 3)     // r4 = r2 >> 3 — no fold
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    // Should NOT fold — src1 stays r2, const stays 3.
    IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 2 && IR_A_IMM_I64[(ir_region_slot_r(result.region, (2))) as usize] == 3
}

// T279: Triple chain — (x << 1) << 2) << 3 → x << 6.
fn compiler_main_test_shift_chain_triple() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpShl, 1)     // r2 = r0 << 1
    instrs[2] = ir_load_imm(3, 2)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpShl, 3)     // r4 = r2 << 2 → r0 << 3
    instrs[4] = ir_load_imm(5, 3)
    instrs[5] = ir_binop(6, 4, BinaryOp::OpShl, 5)     // r6 = r4 << 3 → r0 << 6
    let func = cp_make_test_func(instrs, 6)
    let result = ocp_const_fold(func)
    IR_A_SRC1[(ir_region_slot_r(result.region, (5))) as usize] == 0 && IR_A_IMM_I64[(ir_region_slot_r(result.region, (4))) as usize] == 6
}

// T280: Shift with non-const amount — (x << r) << 3 — no chain (r not const).
fn compiler_main_test_shift_chain_nonconst() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpShl, 1)     // r2 = r0 << r1 (r1 not const)
    instrs[1] = ir_load_imm(3, 3)
    instrs[2] = ir_binop(4, 2, BinaryOp::OpShl, 3)     // r4 = r2 << 3
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    // First shift has non-const amount → no tracking → no chain fold.
    IR_A_SRC1[(ir_region_slot_r(result.region, (2))) as usize] == 2
}

// T281: SR + shift chain — x*4 → x<<2, then (x<<2)<<1 → x<<3.
fn compiler_main_test_shift_chain_sr_integration() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 4)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)     // r2 = r0 * 4 → SR: r0 << 2
    instrs[2] = ir_load_imm(3, 1)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpShl, 3)     // r4 = r2 << 1 → chain: r0 << 3
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    // SR converts r2=r0*4 → r2=r0<<2, then shift-chain: r4 = r0 << 3.
    IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 0 && IR_A_IMM_I64[(ir_region_slot_r(result.region, (2))) as usize] == 3
}

// Sprint 97 Block U — redundant jump elimination tests (T282-T287)

// T282: IrJump(L0) followed by IrLabel(L0) → NOP.
fn compiler_main_test_redundant_jump_basic() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 42)
    instrs[1] = ir_jump(0)
    instrs[2] = ir_label(0)
    instrs[3] = ir_binop(1, 0, BinaryOp::OpAdd, 0)
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_redundant_jump(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrNop
}

// T283: IrJump(L1) followed by IrLabel(L0) — different labels, NO fold.
fn compiler_main_test_redundant_jump_different_labels() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_jump(1)
    instrs[1] = ir_label(0)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_redundant_jump(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrJump
}

// T284: IrBranchTrue(cond, L0) followed by IrLabel(L0) → NOP.
fn compiler_main_test_redundant_branch_true() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 1)
    instrs[1] = ir_branch_true(0, 0)
    instrs[2] = ir_label(0)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_redundant_jump(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrNop
}

// T285: IrBranchFalse(cond, L0) followed by IrLabel(L0) → NOP.
fn compiler_main_test_redundant_branch_false() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 0)
    instrs[1] = ir_branch_false(0, 0)
    instrs[2] = ir_label(0)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_redundant_jump(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrNop
}

// T286: Non-jump before label — IrLoadImm; IrLabel(L0) — no fold.
fn compiler_main_test_redundant_jump_non_jump() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 5)
    instrs[1] = ir_label(0)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_redundant_jump(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrLoadImm
}

// T287: Multiple redundant jumps in sequence.
fn compiler_main_test_redundant_jump_multi() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_jump(0)
    instrs[1] = ir_label(0)
    instrs[2] = ir_jump(1)
    instrs[3] = ir_label(1)
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_redundant_jump(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrNop && (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrNop
}

// Sprint 98 Block V — unreachable code elimination tests (T288-T293)

// T288: IrJump(L0); IrLoadImm(r1,5); IrLabel(L0) → IrLoadImm becomes NOP.
fn compiler_main_test_dead_after_jump_basic() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 42)
    instrs[1] = ir_jump(0)
    instrs[2] = ir_load_imm(1, 5)        // unreachable
    instrs[3] = ir_label(0)
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_dead_after_jump(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrNop
}

// T289: IrReturn(r0); IrLoadImm(r1,7); IrLabel(L0) → IrLoadImm becomes NOP.
fn compiler_main_test_dead_after_return() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_return(0)
    instrs[1] = ir_load_imm(1, 7)        // unreachable
    instrs[2] = ir_label(0)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_dead_after_jump(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrNop
}

// T290: IrJump(L0); IrLabel(L0) → nothing between, no change needed.
fn compiler_main_test_dead_after_jump_adjacent() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_jump(0)
    instrs[1] = ir_label(0)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_dead_after_jump(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrJump && (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLabel
}

// T291: IrBranchTrue(cond,L0); IrLoadImm; IrLabel(L0) → IrLoadImm survives
// (conditional branch is NOT unconditional — fall-through path is live).
fn compiler_main_test_dead_after_branch_not_dead() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_branch_true(0, 0)
    instrs[1] = ir_load_imm(1, 99)       // reachable via fall-through
    instrs[2] = ir_label(0)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_dead_after_jump(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLoadImm
}

// T292: IrReturn; IrLoadImm; IrBinOp; IrLabel(L0) → both dead instrs NOP'd.
fn compiler_main_test_dead_after_return_multi() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_return(0)
    instrs[1] = ir_load_imm(1, 10)       // unreachable
    instrs[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)  // unreachable
    instrs[3] = ir_label(0)
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_dead_after_jump(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrNop && (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrNop
}

// T293: IrJump(L0); IrLoadImm(dead); IrLabel(L1); IrBinOp(live); IrLabel(L0)
// → IrLoadImm NOP'd, IrBinOp survives (L1 resets dead state).
fn compiler_main_test_dead_after_jump_label_resets() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_jump(0)
    instrs[1] = ir_load_imm(1, 5)        // unreachable
    instrs[2] = ir_label(1)              // resets dead
    instrs[3] = ir_binop(2, 0, BinaryOp::OpAdd, 1)  // reachable
    instrs[4] = ir_label(0)
    let func = cp_make_test_func(instrs, 5)
    let result = ocp_dead_after_jump(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrNop && (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrBinOp
}

// Sprint 99 Block W — unreachable label elimination tests (T294-T299)

// T294: Label(L0) with no jumps targeting it → NOP'd.
fn compiler_main_test_dead_label_basic() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 42)
    instrs[1] = ir_label(0)             // no jump targets L0
    instrs[2] = ir_binop(1, 0, BinaryOp::OpAdd, 0)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_dead_label(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrNop
}

// T295: Label(L0) with IrJump(L0) targeting it → survives.
fn compiler_main_test_dead_label_referenced() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_jump(0)
    instrs[1] = ir_label(0)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_dead_label(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLabel
}

// T296: Label(L0) with IrBranchTrue targeting it → survives.
fn compiler_main_test_dead_label_branch_ref() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 1)
    instrs[1] = ir_branch_true(0, 0)
    instrs[2] = ir_label(0)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_dead_label(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrLabel
}

// T297: Multiple labels — L0 referenced, L1 unreferenced → only L1 NOP'd.
fn compiler_main_test_dead_label_mixed() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_jump(0)
    instrs[1] = ir_label(0)             // referenced → survives
    instrs[2] = ir_label(1)             // unreferenced → NOP'd
    instrs[3] = ir_binop(1, 0, BinaryOp::OpAdd, 0)
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_dead_label(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLabel && (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrNop
}

// T298: Dead label + dead_after_jump integration.
// IrJump(L0); IrLoadImm(dead); IrLabel(L1, unreferenced); IrBinOp; IrLabel(L0)
// → dead_label NOP's L1, then dead_after_jump can NOP IrLoadImm+IrBinOp.
fn compiler_main_test_dead_label_integration() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_jump(0)
    instrs[1] = ir_load_imm(1, 5)       // dead after jump
    instrs[2] = ir_label(1)             // unreferenced
    instrs[3] = ir_binop(2, 0, BinaryOp::OpAdd, 1)  // was reachable via L1, now dead
    instrs[4] = ir_label(0)
    let func = cp_make_test_func(instrs, 5)
    // First eliminate dead labels, then dead-after-jump.
    let pass1 = ocp_dead_label(func)
    let pass2 = ocp_dead_after_jump(pass1)
    // L1 NOP'd, then everything between IrJump and IrLabel(L0) is dead.
    (IR_A_OP[(ir_region_slot_r(pass2.region, (1))) as usize] as IrOpcode) == IrOpcode::IrNop && (IR_A_OP[(ir_region_slot_r(pass2.region, (2))) as usize] as IrOpcode) == IrOpcode::IrNop && (IR_A_OP[(ir_region_slot_r(pass2.region, (3))) as usize] as IrOpcode) == IrOpcode::IrNop
}

// T299: No labels at all — pass is a no-op.
fn compiler_main_test_dead_label_no_labels() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 1)
    instrs[1] = ir_load_imm(1, 2)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_dead_label(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLoadImm
}

// Sprint 100 Block X — NOP compaction tests (T300-T305)

// T300: [IrLoadImm, IrNop, IrBinOp] → compacts to [IrLoadImm, IrBinOp], count=2.
fn compiler_main_test_compact_basic() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 5)
    instrs[1] = ir_nop()
    instrs[2] = ir_binop(1, 0, BinaryOp::OpAdd, 0)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_compact_nops(func)
    result.instr_count == 2 && (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp
}

// T301: All NOPs → count=0.
fn compiler_main_test_compact_all_nops() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_nop()
    instrs[1] = ir_nop()
    instrs[2] = ir_nop()
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_compact_nops(func)
    result.instr_count == 0
}

// T302: No NOPs → count unchanged.
fn compiler_main_test_compact_no_nops() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 1)
    instrs[1] = ir_load_imm(1, 2)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_compact_nops(func)
    result.instr_count == 3
}

// T303: Interspersed NOPs — preserves instruction order.
fn compiler_main_test_compact_interspersed() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_nop()
    instrs[1] = ir_load_imm(0, 10)
    instrs[2] = ir_nop()
    instrs[3] = ir_nop()
    instrs[4] = ir_load_imm(1, 20)
    instrs[5] = ir_nop()
    let func = cp_make_test_func(instrs, 6)
    let result = ocp_compact_nops(func)
    result.instr_count == 2 && IR_A_IMM_I64[(ir_region_slot_r(result.region, (0))) as usize] == 10 && IR_A_IMM_I64[(ir_region_slot_r(result.region, (1))) as usize] == 20
}

// T304: Labels survive compaction — label_id is symbolic.
fn compiler_main_test_compact_labels() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_jump(0)
    instrs[1] = ir_nop()
    instrs[2] = ir_nop()
    instrs[3] = ir_label(0)
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_compact_nops(func)
    result.instr_count == 2 && (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrJump && (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLabel
}

// T305: Full pipeline integration — opt_cleanup_function compacts NOPs at the end.
fn compiler_main_test_compact_pipeline() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 3)
    instrs[1] = ir_load_imm(1, 3)       // duplicate imm → dedup_imm NOP's one
    instrs[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    let func = cp_make_test_func(instrs, 3)
    let result = opt_cleanup_function(func)
    // After full pipeline, NOPs from dedup+const_fold+DCE are compacted.
    result.instr_count < 3
}

// ============================================================================
// Sprint 101: macOS cross-platform support self-tests (T306-T311)
// ============================================================================

// T306: x86_64-macos target parses correctly.
fn compiler_main_test_target_parse_x86_64_macos() -> bool with IO, Mut, Panic, Div {
    let spec = native_resolve_target("x86_64-macos", "auto", true)
    spec.arch_id == ARCH_X86_64() && spec.os_id == OS_MACOS()
        && spec.source_id == TARGET_SOURCE_EXPLICIT()
}

// T307: x86_64-macos target policy: emitter_ready=true, same register counts as x86_64-linux.
fn compiler_main_test_target_policy_x86_64_macos() -> bool {
    let p = native_target_policy_x86_64_macos()
    p.emitter_ready && p.allocatable_count == 4 && p.reserved_count == 3
        && p.scratch_count == 5 && p.arg_count == 6 && p.ret_count == 1
}

// T308: x86_64-macos register names match x86_64-linux (System V ABI).
fn compiler_main_test_target_policy_x86_64_macos_regs() -> bool with IO, Mut, Panic, Div {
    let spec = native_resolve_target("x86_64-macos", "auto", true)
    let summary = native_v2_target_policy_summary(spec)
    if !summary.emitter_ready { return false }
    if !str_eq(native_v2_target_policy_group_name(spec, NATIVE_V2_POLICY_GROUP_RESERVED(), 0), "rsp") { return false }
    if !str_eq(native_v2_target_policy_group_name(spec, NATIVE_V2_POLICY_GROUP_ALLOCATABLE(), 0), "r12") { return false }
    if !str_eq(native_v2_target_policy_group_name(spec, NATIVE_V2_POLICY_GROUP_ARGS(), 0), "rdi") { return false }
    if !str_eq(native_v2_target_policy_group_name(spec, NATIVE_V2_POLICY_GROUP_RETURNS(), 0), "rax") { return false }
    true
}

// T309: aarch64-macos target parses correctly (regression).
fn compiler_main_test_target_parse_aarch64_macos() -> bool with IO, Mut, Panic, Div {
    let spec = native_resolve_target("aarch64-macos", "auto", true)
    spec.arch_id == ARCH_AARCH64() && spec.os_id == OS_MACOS()
        && spec.source_id == TARGET_SOURCE_EXPLICIT()
}

// T310: macOS syscall constants are correct.
fn compiler_main_test_macos_syscall_constants() -> bool {
    MACOS_SYS_EXIT() == 33554433 && MACOS_SYS_WRITE() == 33554436
        && MACOS_SYS_MMAP() == 33554629
}

// T311: native_target_policy_for dispatches x86_64+macos correctly.
fn compiler_main_test_target_policy_for_x86_macos() -> bool {
    let p = native_target_policy_for(native_policy_arch_x86_64(), native_policy_os_macos())
    p.emitter_ready && p.arch_id == native_policy_arch_x86_64() && p.os_id == native_policy_os_macos()
}

// ============================================================================
// Sprint 106 Block AD — Jump-to-return folding tests (T306-T311)
// ============================================================================

// T306: IrJump(L0) where IrLabel(L0)+IrReturn(r0) → IrReturn(r0)
fn compiler_main_test_jump_to_return_basic() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 42)
    instrs[1] = ir_jump(0)
    instrs[2] = ir_load_imm(1, 99)
    instrs[3] = ir_label(0)
    instrs[4] = ir_return(0)
    let func = cp_make_test_func(instrs, 5)
    let result = ocp_jump_to_return(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrReturn && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 0
}

// T307: IrLabel(L0) NOT followed by IrReturn → no fold
fn compiler_main_test_jump_to_return_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 42)
    instrs[1] = ir_jump(0)
    instrs[2] = ir_label(0)
    instrs[3] = ir_binop(1, 0, BinaryOp::OpAdd, 0)
    instrs[4] = ir_return(1)
    let func = cp_make_test_func(instrs, 5)
    let result = ocp_jump_to_return(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrJump
}

// T308: Conditional branch NOT folded
fn compiler_main_test_jump_to_return_cond_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 1)
    instrs[1] = ir_branch_true(0, 0)
    instrs[2] = ir_load_imm(1, 99)
    instrs[3] = ir_label(0)
    instrs[4] = ir_return(0)
    let func = cp_make_test_func(instrs, 5)
    let result = ocp_jump_to_return(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBranchTrue
}

// T309: Multiple jumps to same return label → all folded
fn compiler_main_test_jump_to_return_multi() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 10)
    instrs[1] = ir_jump(0)
    instrs[2] = ir_load_imm(1, 20)
    instrs[3] = ir_jump(0)
    instrs[4] = ir_label(0)
    instrs[5] = ir_return(0)
    let func = cp_make_test_func(instrs, 6)
    let result = ocp_jump_to_return(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrReturn && (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrReturn
}

// T310: Missing label → no fold
fn compiler_main_test_jump_to_return_missing_label() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 42)
    instrs[1] = ir_jump(5)
    instrs[2] = ir_label(0)
    instrs[3] = ir_return(0)
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_jump_to_return(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrJump
}

// T311: Label+return at end of function
fn compiler_main_test_jump_to_return_end_of_func() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 7)
    instrs[1] = ir_jump(0)
    instrs[2] = ir_label(0)
    instrs[3] = ir_return(0)
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_jump_to_return(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrReturn && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 0
}

