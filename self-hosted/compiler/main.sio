// --probe-machine-ir <file.sio>: load IR, build Machine IR, print stats.
fn run_probe_machine_ir(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 1 >= args.len {
        panic("probe_machine_ir: missing source file argument")
    }
    let source_path = arg_list_get(args, flag_index + 1)
    println("probe_machine_ir: begin")
    print("probe_machine_ir: source=")
    print(source_path)
    print("\n")
    let ir_result = load_multimodule_ir_probe_summary(source_path)
    let parse_errors = parser_last_error_count()
    if ir_result.ok && parse_errors == 0 {
        let mir = native_v2_build_machine_module(&(*ir_result.module), true)
        print("[machine-ir] fn_count=")
        print_int(mir.fn_count)
        print(" ir_instrs=")
        print_int(mir.total_ir_instr_count)
        print(" machine_instrs=")
        print_int(mir.total_machine_instr_count)
        let sup_label = if mir.supported { "true" } else { "false" }
        print(" supported=")
        print(sup_label)
        print("\n")
        return
    }
    println("probe_machine_ir: fail")
    panic("probe_machine_ir failed")
}

// --probe-native-streaming <file.sio>: inspect the single-module native streaming path.
fn run_probe_native_streaming(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 1 >= args.len {
        panic("probe_native_streaming: missing source file argument")
    }
    let source_path = arg_list_get(args, flag_index + 1)
    let program = load_module_file(source_path)
    let parse_errors = parser_last_error_count()
    if parse_errors > 0 {
        print("probe_native_streaming: parser_errors=")
        print_int(parse_errors)
        print("\n")
        panic("probe_native_streaming parse failed")
    }

    let imports = extract_imports_from_ast(program)
    print("probe_native_streaming: imports=")
    print_int(imports.count)
    print("\n")
    if imports.count > 0 {
        print("probe_native_streaming: fallback_imports\n")
        return
    }

    var epistemic = ir_empty_epistemic_section()
    let skip_checker = starts_with(source_path, "examples/render/") && imports.count == 0
    if skip_checker {
        print("probe_native_streaming: typecheck_skipped\n")
    } else {
        print("probe_native_streaming: typecheck_begin\n")
        if !check_program_epistemic_into(program, &! epistemic) {
            panic("probe_native_streaming type check failed")
        }
        print("probe_native_streaming: typecheck_ok\n")
    }

    print("probe_native_streaming: summary_begin\n")
    let summary_result = lower_program_to_ir_summary_flat_owned_with_epistemic_ref(&program, epistemic)
    if summary_result.had_error {
        panic("probe_native_streaming summary failed")
    }
    print("probe_native_streaming: summary_ok\n")

    let summary_module = &summary_result.summary.module
    let summary_fn_count = (*summary_module).fn_count
    print("probe_native_streaming: fn_count=")
    print_int(summary_fn_count)
    print("\n")

    var fi: i64 = 0
    while fi < summary_fn_count {
        let fn_name = (*summary_module).functions[fi as usize].name
        print("probe_native_streaming: body_begin fn=")
        compiler_manifest_print_name(fn_name)
        print("\n")
        let body_result = lower_program_function_body_from_summary_flat_with_epistemic_ref(
            &program,
            &summary_result.summary,
            epistemic,
            fn_name
        )
        if body_result.had_error {
            print("probe_native_streaming: body_error fn=")
            compiler_manifest_print_name(fn_name)
            print("\n")
            panic("probe_native_streaming body lowering failed")
        }
        print("probe_native_streaming: body_ir_ok fn=")
        compiler_manifest_print_name(fn_name)
        print(" instrs=")
        print_int(body_result.func.instr_count)
        print(" regs=")
        print_int(body_result.func.reg_count)
        print("\n")
        let lowered = native_v2_lower_function_to_machine(body_result.func)
        print("probe_native_streaming: machine_lower_ok fn=")
        compiler_manifest_print_name(fn_name)
        print(" supported=")
        if lowered.supported { print("true") } else { print("false") }
        if !lowered.supported {
            print(" unsupported=")
            print(lowered.unsupported_detail)
        }
        print("\n")
        let legal = native_v2_legalize_function(lowered)
        print("probe_native_streaming: legalize_ok fn=")
        compiler_manifest_print_name(fn_name)
        print("\n")
        print("probe_native_streaming: body_ok fn=")
        compiler_manifest_print_name(fn_name)
        print("\n")
        print("  fn=")
        compiler_manifest_print_name(fn_name)
        print(" instrs=")
        print_int(body_result.func.instr_count)
        print(" regs=")
        print_int(body_result.func.reg_count)
        print(" temps=")
        print_int(legal.temp_count)
        print(" legal_instrs=")
        print_int(legal.legal_instr_count)
        print("\n")
        fi = fi + 1
    }

    let stream_pair = compile_multimodule_native_maybe_streaming_for_target(source_path, "native", "auto", false)
    print("probe_native_streaming: streaming_used=")
    if stream_pair.0 { print("true") } else { print("false") }
    print(" ok=")
    if stream_pair.1.ok { print("true") } else { print("false") }
    print(" err=")
    print(stream_pair.1.error_msg)
    print(" len=")
    print_int(stream_pair.1.len)
    print("\n")
}

