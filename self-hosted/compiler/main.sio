}

// T474: negative — (a ^ b) ^ c does NOT fold (c ≠ a, c ≠ b)
// r4 = c is a separate non-constant param
fn compiler_main_test_xor_self_inverse_neg() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpBitXor, 1)  // r2 = a ^ b
    instrs[1] = ir_binop(3, 2, BinaryOp::OpBitXor, 4)  // r3 = (a^b) ^ c — no fold (r4 ≠ r0, r4 ≠ r1)
    instrs[2] = ir_return(3)
    let func = cp_make_test_func(instrs, 3)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp && (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (1))) as usize] as BinaryOp) == BinaryOp::OpBitXor
}

// T475: triple XOR chain: ((a^b)^b)^a — first fold yields copy(a)
fn compiler_main_test_xor_self_inverse_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpBitXor, 1)  // r2 = a ^ b
    instrs[1] = ir_binop(3, 2, BinaryOp::OpBitXor, 1)  // r3 = (a^b)^b → copy(a)=r0
    instrs[2] = ir_binop(5, 3, BinaryOp::OpBitXor, 0)  // r5 = r3 ^ a
    instrs[3] = ir_return(5)
    let func = cp_make_test_func(instrs, 4)
    let opt = opt_cleanup_function(func)
    // After XOR self-inverse: r3=copy(r0), then r5=r3^r0
    // At minimum, r3 must be folded to copy(r0)
    (IR_A_OP[(ir_region_slot_r(opt.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(opt.region, (1))) as usize] == 0
}

// Sprint 132: Block AT — NOT-distributive simplification (T476-T481)
// ~a & (a | b) → ~a & b via complement + distribution axioms
// SOTA: LLVM InstCombineAndOrXor.cpp SimplifyDemandedBits

// T476: ~a & (a | b) → ~a & b  [basic NOT-distributive AND]
// NOT is represented as x ^ (-1) in IR (is_bnot tracking)
fn compiler_main_test_not_dist_and_basic() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    // r0 = a, r1 = b (implicit non-constant params)
    instrs[0] = ir_load_imm(6, -1)                       // r6 = -1 (all-ones)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitXor, 6)   // r2 = a ^ (-1) = ~a
    instrs[2] = ir_binop(3, 0, BinaryOp::OpBitOr, 1)    // r3 = a | b
    instrs[3] = ir_binop(4, 2, BinaryOp::OpBitAnd, 3)   // r4 = ~a & (a|b) → ~a & b
    instrs[4] = ir_return(4)
    let func = cp_make_test_func(instrs, 5)
    let opt = opt_cleanup_function(func)
    // Should become: r4 = ~a & b (AND with r2 and r1)
    (IR_A_OP[(ir_region_slot_r(opt.region, (3))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (3))) as usize] as BinaryOp) == BinaryOp::OpBitAnd
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (3))) as usize] == 2 && IR_A_SRC2[(ir_region_slot_r(opt.region, (3))) as usize] == 1
}

// T477: (a | b) & ~a → ~a & b  [commutative]
fn compiler_main_test_not_dist_and_commutative() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(6, -1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitXor, 6)   // r2 = ~a
    instrs[2] = ir_binop(3, 0, BinaryOp::OpBitOr, 1)    // r3 = a | b
    instrs[3] = ir_binop(4, 3, BinaryOp::OpBitAnd, 2)   // r4 = (a|b) & ~a → ~a & b
    instrs[4] = ir_return(4)
    let func = cp_make_test_func(instrs, 5)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (3))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (3))) as usize] as BinaryOp) == BinaryOp::OpBitAnd
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (3))) as usize] == 2 && IR_A_SRC2[(ir_region_slot_r(opt.region, (3))) as usize] == 1
}

