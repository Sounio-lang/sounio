fn compiler_manifest_deferral_evidence_name(kind: i64) -> string {
    if kind == 0 { "contest" } else if kind == 1 { "robust" } else { "unknown" }
}

fn compiler_manifest_deferral_reason_name(code: i64) -> string {
    if code == 0 { "StructuralDisagreement" }
    else if code == 1 { "MechanisticConflict" }
    else if code == 2 { "CounterexampleHazard" }
    else if code == 3 { "TailRisk" }
    else if code == 4 { "IdentifiabilityGap" }
    else if code == 5 { "TransportGap" }
    else { "PolicyIncomplete" }
}

fn compiler_manifest_alternative_source_kind_name(kind: i64) -> string {
    if kind == 0 { "DeferredRoute" }
    else if kind == 1 { "RecoursePlan" }
    else { "UnknownSource" }
}

fn compiler_manifest_compare_op_name(op: CompareOp) -> string {
    if op == CompareOp::CmpEq { "==" }
    else if op == CompareOp::CmpLt { "<" }
    else if op == CompareOp::CmpLe { "<=" }
    else if op == CompareOp::CmpGt { ">" }
    else if op == CompareOp::CmpGe { ">=" }
    else { "==" }
}

fn compiler_manifest_threshold_kind_name(kind: i64) -> string {
    if kind == 1 { "bool" }
    else if kind == 2 { "name" }
    else { "f64" }
}

fn compiler_manifest_print_name_array(names: [Name; 16], count: i64) with IO, Mut, Panic, Div {
    print("[")
    var i: i64 = 0
    while i < count && i < 16 {
        if i > 0 { print(", ") }
        compiler_manifest_print_name_json(names[i])
        i = i + 1
    }
    print("]")
}

fn compiler_manifest_print_metric_snapshot(metric_known: [i64; 8], metric_values: [f64; 8]) with IO, Mut, Panic, Div {
    print("{")
    var emitted: i64 = 0
    if metric_known[0] == 1 {
        compiler_manifest_print_string_json(compiler_manifest_metric_name(0))
        print(": ")
        compiler_manifest_print_f64_json(metric_values[0])
        emitted = 1
    }
    if metric_known[1] == 1 {
        if emitted > 0 { print(", ") }
        compiler_manifest_print_string_json(compiler_manifest_metric_name(1))
        print(": ")
        compiler_manifest_print_f64_json(metric_values[1])
        emitted = emitted + 1
    }
    if metric_known[2] == 1 {
        if emitted > 0 { print(", ") }
        compiler_manifest_print_string_json(compiler_manifest_metric_name(2))
        print(": ")
        compiler_manifest_print_f64_json(metric_values[2])
        emitted = emitted + 1
    }
    if metric_known[3] == 1 {
        if emitted > 0 { print(", ") }
        compiler_manifest_print_string_json(compiler_manifest_metric_name(3))
        print(": ")
        compiler_manifest_print_f64_json(metric_values[3])
        emitted = emitted + 1
    }
    if metric_known[4] == 1 {
        if emitted > 0 { print(", ") }
        compiler_manifest_print_string_json(compiler_manifest_metric_name(4))
        print(": ")
        compiler_manifest_print_f64_json(metric_values[4])
        emitted = emitted + 1
    }
    if metric_known[5] == 1 {
        if emitted > 0 { print(", ") }
        compiler_manifest_print_string_json(compiler_manifest_metric_name(5))
        print(": ")
        compiler_manifest_print_f64_json(metric_values[5])
        emitted = emitted + 1
    }
    if metric_known[6] == 1 {
        if emitted > 0 { print(", ") }
        compiler_manifest_print_string_json(compiler_manifest_metric_name(6))
        print(": ")
        compiler_manifest_print_f64_json(metric_values[6])
    }
    print("}")
}

fn compiler_manifest_print_policy_requirement_json(req: IrPolicyRequirementInfo) with IO, Mut, Panic, Div {
    print("{\"metric\": ")
    compiler_manifest_print_name_json(req.metric_name)
    print(", \"operator\": ")
    compiler_manifest_print_string_json(compiler_manifest_compare_op_name(req.op))
    print(", \"threshold_kind\": ")
    compiler_manifest_print_string_json(compiler_manifest_threshold_kind_name(req.threshold_kind))
    print(", \"threshold\": ")
    if req.threshold_kind == 1 {
        if req.bool_threshold { print("true") } else { print("false") }
    } else if req.threshold_kind == 2 {
        compiler_manifest_print_name_json(req.name_threshold)
    } else {
        compiler_manifest_print_f64_json(req.threshold)
    }
    print("}")
}

fn compiler_manifest_print_recourse_policies(ep: &IrEpistemicSection) with IO, Mut, Panic, Div, Alloc {
    print("    \"recourse_policies\": [\n")
    let recourse_policy_count: i64 = (*ep).recourse_policy_count
    var i: i64 = 0
    while i < recourse_policy_count {
        if i > 0 { print(",\n") }
        let recourse_policy_id: i64 = (*ep).recourse_policies[i].id
        print("      {\"id\": ")
        print_int(recourse_policy_id)
        print(", \"name\": ")
        compiler_manifest_print_name_json(compiler_manifest_recourse_policy_name(ep, recourse_policy_id))
        print(", \"target_type\": \"")
        compiler_manifest_print_type_name((*ep).recourse_policies[i].target_ty)
        print("\", \"strategy_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_recourse_strategy_name(ep, recourse_policy_id))
        print(", \"route_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_recourse_route_name(ep, recourse_policy_id))
        print(", \"requirements\": [")
        var rk: i64 = 0
        while rk < (*ep).recourse_policies[i].requirement_count && rk < 8 {
            if rk > 0 { print(", ") }
            compiler_manifest_print_policy_requirement_json((*ep).recourse_policies[i].requirements[rk])
            rk = rk + 1
        }
        print("]}")
        i = i + 1
    }
    print("\n    ],\n")
}

