    r.lhs_op == EG_OP_ADD && r.rhs_op == EG_OP_ADD && r.lhs_child_count == 2 && r.rhs_child_count == 2
}

// T122: eg_rule_mul_commute produces a MUL→MUL rule.
fn compiler_main_test_egraph_mul_commute_rule() -> bool {
    let r = eg_rule_mul_commute()
    r.lhs_op == EG_OP_MUL && r.rhs_op == EG_OP_MUL && r.lhs_child_count == 2
}

// T123: eg_hash_node produces distinct hashes for distinct opcodes.
fn compiler_main_test_egraph_hash_distinct() -> bool with Div, Panic {
    let no_ch: [i64; 4] = [EG_INVALID, EG_INVALID, EG_INVALID, EG_INVALID]
    let h_add = eg_hash_node(EG_OP_ADD, no_ch, 0)
    let h_mul = eg_hash_node(EG_OP_MUL, no_ch, 0)
    h_add != h_mul && h_add >= 0 && h_mul >= 0
}

