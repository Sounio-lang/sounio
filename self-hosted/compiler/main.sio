// Fn-pointer witness: main() takes the ADDRESS of helper, then calls THROUGH it.
fn compiler_main_make_native_v2_fnptr_module() -> IrModule with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    var helper = ir_empty_function()
    ir_function_alloc_region(&! helper)
    helper.name = ir_name_from_bytes(104, 101, 108, 112, 4)
    helper.param_count = 1
    helper.param_regs[0] = 0
    helper.reg_count = 3
    ir_arena_store(ir_region_slot_w(helper.region, (0)), ir_load_imm(1, 2))
    ir_arena_store(ir_region_slot_w(helper.region, (1)), ir_binop(2, 0, BinaryOp::OpMul, 1))
    ir_arena_store(ir_region_slot_w(helper.region, (2)), ir_return(2))
    helper.instr_count = 3
    ir_fn_set(&! module, 0, helper)

    var main_fn = ir_empty_function()
    ir_function_alloc_region(&! main_fn)
    main_fn.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    main_fn.reg_count = 3
    ir_arena_store(ir_region_slot_w(main_fn.region, (0)), ir_load_fn_ref(0, 0))
    ir_arena_store(ir_region_slot_w(main_fn.region, (1)), ir_load_imm(1, 55))
    ir_arena_store(ir_region_slot_w(main_fn.region, (2)), ir_call_indirect(2, 0, Some(Box::new(ir_reg_list_single(1))), 1))
    ir_arena_store(ir_region_slot_w(main_fn.region, (3)), ir_return(2))
    main_fn.instr_count = 4
    ir_fn_set(&! module, 1, main_fn)

    module.fn_count = 2
    module
}

// Sprint widening: 3-function module modeling tests/run-pass/basic_math.sio
// fn add(a, b) -> a + b  (2 params)
// fn mul(a, b) -> a * b  (2 params)
// fn main() -> { x = add(10, 32); y = mul(x, 2); return y }  (chained calls)
fn compiler_main_make_native_v2_multi_call_module() -> IrModule with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    // fn add(a, b) -> a + b
    let add_name = ir_name_from_bytes(97, 100, 100, 0, 3)
    var add_fn = ir_empty_function()
    ir_function_alloc_region(&! add_fn)
    add_fn.name = add_name
    add_fn.param_count = 2
    add_fn.param_regs[0] = 0
    add_fn.param_regs[1] = 1
    add_fn.reg_count = 3
    ir_arena_store(ir_region_slot_w(add_fn.region, (0)), ir_binop(2, 0, BinaryOp::OpAdd, 1))
    ir_arena_store(ir_region_slot_w(add_fn.region, (1)), ir_return(2))
    add_fn.instr_count = 2
    ir_fn_set(&! module, 0, add_fn)

    // fn mul(a, b) -> a * b
    let mul_name = ir_name_from_bytes(109, 117, 108, 0, 3)
    var mul_fn = ir_empty_function()
    ir_function_alloc_region(&! mul_fn)
    mul_fn.name = mul_name
    mul_fn.param_count = 2
    mul_fn.param_regs[0] = 0
    mul_fn.param_regs[1] = 1
    mul_fn.reg_count = 3
    ir_arena_store(ir_region_slot_w(mul_fn.region, (0)), ir_binop(2, 0, BinaryOp::OpMul, 1))
    ir_arena_store(ir_region_slot_w(mul_fn.region, (1)), ir_return(2))
    mul_fn.instr_count = 2
    ir_fn_set(&! module, 1, mul_fn)

    // fn main() -> { x = add(10, 32); y = mul(x, 2); return y }
    let main_name = ir_name_from_bytes(109, 97, 105, 110, 4)
    var main_fn = ir_empty_function()
    ir_function_alloc_region(&! main_fn)
    main_fn.name = main_name
    main_fn.param_count = 0
    main_fn.reg_count = 5
    ir_arena_store(ir_region_slot_w(main_fn.region, (0)), ir_load_imm(0, 10))
    ir_arena_store(ir_region_slot_w(main_fn.region, (1)), ir_load_imm(1, 32))
    ir_arena_store(ir_region_slot_w(main_fn.region, (2)), ir_call(2, 0, add_name, Some(Box::new(ir_reg_list_append(ir_reg_list_single(0), 1))), 2))
    ir_arena_store(ir_region_slot_w(main_fn.region, (3)), ir_load_imm(3, 2))
    ir_arena_store(ir_region_slot_w(main_fn.region, (4)), ir_call(4, 1, mul_name, Some(Box::new(ir_reg_list_append(ir_reg_list_single(2), 3))), 2))
    ir_arena_store(ir_region_slot_w(main_fn.region, (5)), ir_return(4))
    main_fn.instr_count = 6
    ir_fn_set(&! module, 2, main_fn)

    module.fn_count = 3
    module
}

fn compiler_main_make_native_v2_control_module() -> IrModule with Alloc, Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    ir_function_alloc_region(&! func)
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.reg_count = 3
    func.label_count = 1
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, 1))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_branch_true(0, 0))
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_load_imm(1, 0))
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_return(1))
    ir_arena_store(ir_region_slot_w(func.region, (4)), ir_label(0))
    ir_arena_store(ir_region_slot_w(func.region, (5)), ir_load_imm(2, 1))
    ir_arena_store(ir_region_slot_w(func.region, (6)), ir_return(2))
    func.instr_count = 7
    ir_fn_set(&! module, 0, func)
    module.fn_count = 1
    module
}

// f64-comparison witness builder. Returns the RAW i64 0/1 result of `lhs OP rhs`
// so the process exit code IS the boolean: exit 1 = true, exit 0 = false. This
// makes a NaN case verifiable by exit code (e.g. NaN < x must exit 0, NaN != x
// must exit 1). When lhs_is_nan != 0 the lhs operand is produced at RUNTIME via
// 0.0/0.0 (a genuine f64 NaN with the float flag set), so the comparison path
// sees a real NaN, not a folded literal.
//   reg layout: r0=lhs, r1=rhs, r2=cmp result (i64 0/1)
//   NaN form:   r0=0.0, r1=0.0, r2=0.0/0.0(NaN), r3=rhs, r4=NaN OP rhs
fn compiler_main_make_native_v2_f64cmp_module(op: BinaryOp, lhs_is_nan: i64, lhs: f64, rhs: f64) -> IrModule with Alloc, Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    ir_function_alloc_region(&! func)
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    if lhs_is_nan != 0 {
        func.reg_count = 6
        ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_float(0, 0.0))
        ir_arena_store(ir_region_slot_w(func.region, (1)), ir_load_float(1, 0.0))
        ir_arena_store(ir_region_slot_w(func.region, (2)), ir_binop(2, 0, BinaryOp::OpDiv, 1))  // r2 = 0.0/0.0 = NaN
        ir_arena_store(ir_region_slot_w(func.region, (3)), ir_load_float(3, rhs))
        ir_arena_store(ir_region_slot_w(func.region, (4)), ir_binop(4, 2, op, 3))               // r4 = NaN OP rhs (i64 0/1)
        ir_arena_store(ir_region_slot_w(func.region, (5)), ir_return(4))
        func.instr_count = 6
    } else {
        func.reg_count = 3
        ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_float(0, lhs))
        ir_arena_store(ir_region_slot_w(func.region, (1)), ir_load_float(1, rhs))
        ir_arena_store(ir_region_slot_w(func.region, (2)), ir_binop(2, 0, op, 1))               // r2 = lhs OP rhs (i64 0/1)
        ir_arena_store(ir_region_slot_w(func.region, (3)), ir_return(2))
        func.instr_count = 4
    }
    ir_fn_set(&! module, 0, func)
    module.fn_count = 1
    module
}

// f64-comparison witness driver: --native-v2-emit-f64cmp <case> <out_path>.
// <case> selects op + operands; the emitted ELF's exit code is the raw 0/1 result.
// Cases pair an ordered-true (exit 1), ordered-false (exit 0), and a NaN case
// whose IEEE-correct result the gate asserts (unordered ops Lt/LtEq/Gt/GtEq/EqEq -> 0; Neq -> 1).
fn run_native_v2_emit_f64cmp(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 2 >= args.len {
        panic("native-v2-emit-f64cmp: usage --native-v2-emit-f64cmp <case> <out_path>")
    }
    let case = arg_list_get(args, flag_index + 1)
    let out_path = arg_list_get(args, flag_index + 2)
    let spec = native_resolve_target("x86_64-linux", "auto", true)

    var module = ir_empty_module()
    // Ordered cases use 2.0 and 1.0 so both directions are exercised per op.
    if case == "lt-true"       { module = compiler_main_make_native_v2_f64cmp_module(BinaryOp::OpLt, 0, 1.0, 2.0) }
    else if case == "lt-false" { module = compiler_main_make_native_v2_f64cmp_module(BinaryOp::OpLt, 0, 2.0, 1.0) }
    else if case == "lt-nan"   { module = compiler_main_make_native_v2_f64cmp_module(BinaryOp::OpLt, 1, 0.0, 1.0) }
    else if case == "le-true"  { module = compiler_main_make_native_v2_f64cmp_module(BinaryOp::OpLe, 0, 2.0, 2.0) }
    else if case == "le-false" { module = compiler_main_make_native_v2_f64cmp_module(BinaryOp::OpLe, 0, 2.0, 1.0) }
    else if case == "le-nan"   { module = compiler_main_make_native_v2_f64cmp_module(BinaryOp::OpLe, 1, 0.0, 1.0) }
    else if case == "gt-true"  { module = compiler_main_make_native_v2_f64cmp_module(BinaryOp::OpGt, 0, 2.0, 1.0) }
    else if case == "gt-false" { module = compiler_main_make_native_v2_f64cmp_module(BinaryOp::OpGt, 0, 1.0, 2.0) }
    else if case == "gt-nan"   { module = compiler_main_make_native_v2_f64cmp_module(BinaryOp::OpGt, 1, 0.0, 1.0) }
    else if case == "ge-true"  { module = compiler_main_make_native_v2_f64cmp_module(BinaryOp::OpGe, 0, 2.0, 2.0) }
    else if case == "ge-false" { module = compiler_main_make_native_v2_f64cmp_module(BinaryOp::OpGe, 0, 1.0, 2.0) }
    else if case == "ge-nan"   { module = compiler_main_make_native_v2_f64cmp_module(BinaryOp::OpGe, 1, 0.0, 1.0) }
    else if case == "eq-true"  { module = compiler_main_make_native_v2_f64cmp_module(BinaryOp::OpEq, 0, 2.0, 2.0) }
    else if case == "eq-false" { module = compiler_main_make_native_v2_f64cmp_module(BinaryOp::OpEq, 0, 2.0, 1.0) }
    else if case == "eq-nan"   { module = compiler_main_make_native_v2_f64cmp_module(BinaryOp::OpEq, 1, 0.0, 1.0) }
    else if case == "ne-true"  { module = compiler_main_make_native_v2_f64cmp_module(BinaryOp::OpNe, 0, 2.0, 1.0) }
    else if case == "ne-false" { module = compiler_main_make_native_v2_f64cmp_module(BinaryOp::OpNe, 0, 2.0, 2.0) }
    else if case == "ne-nan"   { module = compiler_main_make_native_v2_f64cmp_module(BinaryOp::OpNe, 1, 0.0, 1.0) }
    else { panic("native-v2-emit-f64cmp: unknown case") }

    let rc = compile_native_v2_preview_to_file(&module, spec, out_path)
    if rc != 0 {
        print("native_v2_emit_exit_code: FAIL to_file label=f64cmp rc=")
        print_int(rc as i64)
        print("\n")
        return
    }
    print("native_v2_emit_exit_code: emitted label=f64cmp case=")
    print(case)
    print(" path=")
    print(out_path)
    print("\n")
}

// Arithmetic witness: main() -> { (100 - 16) / 2 } = 84 / 2 = 42. Exercises OpSub + OpDiv
// in one module (OpAdd/OpMul are already covered by call/multicall).
fn compiler_main_make_native_v2_arith_module() -> IrModule with Alloc, Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    ir_function_alloc_region(&! func)
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.reg_count = 5
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, 100))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_load_imm(1, 16))
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_binop(2, 0, BinaryOp::OpSub, 1))
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_load_imm(3, 2))
    ir_arena_store(ir_region_slot_w(func.region, (4)), ir_binop(4, 2, BinaryOp::OpDiv, 3))
    ir_arena_store(ir_region_slot_w(func.region, (5)), ir_return(4))
    func.instr_count = 6
    ir_fn_set(&! module, 0, func)
    module.fn_count = 1
    module
}

// 5-arg call witness: add5(a,b,c,d,e)->a+b+c+d+e; main()->add5(1,2,4,8,16)=31.
// Exercises rdi/rsi/rdx/rcx/r8 (SysV arg regs 0..4).
fn compiler_main_make_native_v2_call5_module() -> IrModule with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    // fn add5(a, b, c, d, e) -> a+b+c+d+e
    let add5_name = ir_name_from_bytes(97, 100, 100, 53, 4)
    var add5_fn = ir_empty_function()
    ir_function_alloc_region(&! add5_fn)
    add5_fn.name = add5_name
    add5_fn.param_count = 5
    add5_fn.param_regs[0] = 0
    add5_fn.param_regs[1] = 1
    add5_fn.param_regs[2] = 2
    add5_fn.param_regs[3] = 3
    add5_fn.param_regs[4] = 4
    add5_fn.reg_count = 9
    // r5 = r0+r1; r6 = r5+r2; r7 = r6+r3; r8 = r7+r4; return r8
    ir_arena_store(ir_region_slot_w(add5_fn.region, (0)), ir_binop(5, 0, BinaryOp::OpAdd, 1))
    ir_arena_store(ir_region_slot_w(add5_fn.region, (1)), ir_binop(6, 5, BinaryOp::OpAdd, 2))
    ir_arena_store(ir_region_slot_w(add5_fn.region, (2)), ir_binop(7, 6, BinaryOp::OpAdd, 3))
    ir_arena_store(ir_region_slot_w(add5_fn.region, (3)), ir_binop(8, 7, BinaryOp::OpAdd, 4))
    ir_arena_store(ir_region_slot_w(add5_fn.region, (4)), ir_return(8))
    add5_fn.instr_count = 5
    ir_fn_set(&! module, 0, add5_fn)

    // fn main() -> add5(1, 2, 4, 8, 16)
    let main_name = ir_name_from_bytes(109, 97, 105, 110, 4)
    var main_fn = ir_empty_function()
    ir_function_alloc_region(&! main_fn)
    main_fn.name = main_name
    main_fn.param_count = 0
    main_fn.reg_count = 6
    ir_arena_store(ir_region_slot_w(main_fn.region, (0)), ir_load_imm(0, 1))
    ir_arena_store(ir_region_slot_w(main_fn.region, (1)), ir_load_imm(1, 2))
    ir_arena_store(ir_region_slot_w(main_fn.region, (2)), ir_load_imm(2, 4))
    ir_arena_store(ir_region_slot_w(main_fn.region, (3)), ir_load_imm(3, 8))
    ir_arena_store(ir_region_slot_w(main_fn.region, (4)), ir_load_imm(4, 16))
    let args5 = Some(Box::new(ir_reg_list_append(ir_reg_list_append(ir_reg_list_append(ir_reg_list_append(ir_reg_list_single(0), 1), 2), 3), 4)))
    ir_arena_store(ir_region_slot_w(main_fn.region, (5)), ir_call(5, 0, add5_name, args5, 5))
    ir_arena_store(ir_region_slot_w(main_fn.region, (6)), ir_return(5))
    main_fn.instr_count = 7
    ir_fn_set(&! module, 1, main_fn)

    module.fn_count = 2
    module
}

// 6-arg call witness: add6(a,b,c,d,e,f)->a+b+c+d+e+f; main()->add6(1,2,4,8,16,32)=63.
// Exercises rdi/rsi/rdx/rcx/r8/r9 (SysV arg regs 0..5).
fn compiler_main_make_native_v2_call6_module() -> IrModule with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    // fn add6(a, b, c, d, e, f) -> a+b+c+d+e+f
    let add6_name = ir_name_from_bytes(97, 100, 100, 54, 4)
    var add6_fn = ir_empty_function()
    ir_function_alloc_region(&! add6_fn)
    add6_fn.name = add6_name
    add6_fn.param_count = 6
    add6_fn.param_regs[0] = 0
    add6_fn.param_regs[1] = 1
    add6_fn.param_regs[2] = 2
    add6_fn.param_regs[3] = 3
    add6_fn.param_regs[4] = 4
    add6_fn.param_regs[5] = 5
    add6_fn.reg_count = 11
    // r6=r0+r1; r7=r6+r2; r8=r7+r3; r9=r8+r4; r10=r9+r5; return r10
    ir_arena_store(ir_region_slot_w(add6_fn.region, (0)), ir_binop(6, 0, BinaryOp::OpAdd, 1))
    ir_arena_store(ir_region_slot_w(add6_fn.region, (1)), ir_binop(7, 6, BinaryOp::OpAdd, 2))
    ir_arena_store(ir_region_slot_w(add6_fn.region, (2)), ir_binop(8, 7, BinaryOp::OpAdd, 3))
    ir_arena_store(ir_region_slot_w(add6_fn.region, (3)), ir_binop(9, 8, BinaryOp::OpAdd, 4))
    ir_arena_store(ir_region_slot_w(add6_fn.region, (4)), ir_binop(10, 9, BinaryOp::OpAdd, 5))
    ir_arena_store(ir_region_slot_w(add6_fn.region, (5)), ir_return(10))
    add6_fn.instr_count = 6
    ir_fn_set(&! module, 0, add6_fn)

    // fn main() -> add6(1, 2, 4, 8, 16, 32)
    let main_name = ir_name_from_bytes(109, 97, 105, 110, 4)
    var main_fn = ir_empty_function()
    ir_function_alloc_region(&! main_fn)
    main_fn.name = main_name
    main_fn.param_count = 0
    main_fn.reg_count = 7
    ir_arena_store(ir_region_slot_w(main_fn.region, (0)), ir_load_imm(0, 1))
    ir_arena_store(ir_region_slot_w(main_fn.region, (1)), ir_load_imm(1, 2))
    ir_arena_store(ir_region_slot_w(main_fn.region, (2)), ir_load_imm(2, 4))
    ir_arena_store(ir_region_slot_w(main_fn.region, (3)), ir_load_imm(3, 8))
    ir_arena_store(ir_region_slot_w(main_fn.region, (4)), ir_load_imm(4, 16))
    ir_arena_store(ir_region_slot_w(main_fn.region, (5)), ir_load_imm(5, 32))
    let args6 = Some(Box::new(ir_reg_list_append(ir_reg_list_append(ir_reg_list_append(ir_reg_list_append(ir_reg_list_append(ir_reg_list_single(0), 1), 2), 3), 4), 5)))
    ir_arena_store(ir_region_slot_w(main_fn.region, (6)), ir_call(6, 0, add6_name, args6, 6))
    ir_arena_store(ir_region_slot_w(main_fn.region, (7)), ir_return(6))
    main_fn.instr_count = 8
    ir_fn_set(&! module, 1, main_fn)

    module.fn_count = 2
    module
}

// Control fall-through witness: cond = 0, so branch_true is NOT taken; execution falls
// through to `return 7`. The symmetric companion to control_module (which proves the
// branch-TAKEN path) — together they prove branch_true both jumps and does-not-jump.
fn compiler_main_make_native_v2_control_fallthrough_module() -> IrModule with Alloc, Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    ir_function_alloc_region(&! func)
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.reg_count = 3
    func.label_count = 1
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, 0))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_branch_true(0, 0))
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_load_imm(1, 7))
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_return(1))
    ir_arena_store(ir_region_slot_w(func.region, (4)), ir_label(0))
    ir_arena_store(ir_region_slot_w(func.region, (5)), ir_load_imm(2, 99))
    ir_arena_store(ir_region_slot_w(func.region, (6)), ir_return(2))
    func.instr_count = 7
    ir_fn_set(&! module, 0, func)
    module.fn_count = 1
    module
}

fn compiler_main_make_native_v2_unsupported_vector_module() -> IrModule with Alloc, Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    ir_function_alloc_region(&! func)
    var instr = ir_instr_new(IrOpcode::IrVecAddF64)
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    instr.dst = 0
    instr.src1 = 1
    instr.src2 = 2
    instr.imm_i64 = 2
    ir_arena_store(ir_region_slot_w(func.region, (0)), instr)
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_return(0))
    func.instr_count = 2
    func.reg_count = 3
    ir_fn_set(&! module, 0, func)
    module.fn_count = 1
    module
}

fn compiler_main_make_native_v2_huge_alloc_module() -> IrModule with Alloc, Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    ir_function_alloc_region(&! func)
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.reg_count = 2
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_alloc(0, 536870920))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_load_imm(1, 0))
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_return(1))
    func.instr_count = 3
    ir_fn_set(&! module, 0, func)
    module.fn_count = 1
    module
}

fn compiler_main_make_native_v2_alloc_field_module() -> IrModule with Alloc, Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    ir_function_alloc_region(&! func)
    let field_name = ir_name_from_bytes(118, 97, 108, 0, 3)
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.reg_count = 4
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_alloc(0, 0))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_load_imm(1, 7))
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_field_set(0, 0, 1, field_name))
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_field_get(2, 0, 0, field_name))
    ir_arena_store(ir_region_slot_w(func.region, (4)), ir_return(2))
    func.instr_count = 5
    ir_fn_set(&! module, 0, func)
    module.fn_count = 1
    module
}

fn compiler_main_fill_native_v2_sret_make_fn(make_fn: &! IrFunction) with Mut, Panic, Div {
    (*make_fn).name = ir_name_from_bytes(109, 97, 107, 101, 4)  // "make"
    (*make_fn).is_sret = 1
    (*make_fn).sret_dest_reg = 0    // hidden destination handle from rdi
    (*make_fn).param_count = 1
    (*make_fn).param_regs[0] = 1    // v (explicit) shifts to rsi
    (*make_fn).reg_count = 6
    ir_arena_store(ir_region_slot_w((*make_fn).region, (0)), ir_field_set(0, 0, 1, ir_name_from_bytes(102, 48, 0, 0, 2)))
    ir_arena_store(ir_region_slot_w((*make_fn).region, (1)), ir_load_imm(2, 2))
    ir_arena_store(ir_region_slot_w((*make_fn).region, (2)), ir_binop(3, 1, BinaryOp::OpMul, 2))
    ir_arena_store(ir_region_slot_w((*make_fn).region, (3)), ir_field_set(0, 1, 3, ir_name_from_bytes(102, 49, 0, 0, 2)))
    ir_arena_store(ir_region_slot_w((*make_fn).region, (4)), ir_load_imm(4, 1))
    ir_arena_store(ir_region_slot_w((*make_fn).region, (5)), ir_binop(5, 1, BinaryOp::OpAdd, 4))
    ir_arena_store(ir_region_slot_w((*make_fn).region, (6)), ir_field_set(0, 2, 5, ir_name_from_bytes(102, 50, 0, 0, 2)))
    ir_arena_store(ir_region_slot_w((*make_fn).region, (7)), ir_return_sret(0))
    (*make_fn).instr_count = 8
}

fn compiler_main_fill_native_v2_sret_main_fn(main_fn: &! IrFunction) with Mut, Panic, Div {
    (*main_fn).name = ir_name_from_bytes(109, 97, 105, 110, 4)  // "main"
    (*main_fn).reg_count = 4
    ir_arena_store(ir_region_slot_w((*main_fn).region, (0)), ir_alloc(0, 64))       // dest: 64B payload (8 i64 slots) >16B
    ir_arena_store(ir_region_slot_w((*main_fn).region, (1)), ir_load_imm(1, 7))     // v = 7
    ir_arena_store(ir_region_slot_w((*main_fn).region, (2)), ir_call_sret(2, 0, ir_name_from_bytes(109, 97, 107, 101, 4), 1, 1, 1))
    ir_arena_store(ir_region_slot_w((*main_fn).region, (3)), ir_field_get(3, 2, 1, ir_name_from_bytes(102, 49, 0, 0, 2))) // b.f1
    ir_arena_store(ir_region_slot_w((*main_fn).region, (4)), ir_return(3))
    (*main_fn).instr_count = 5
}

fn compiler_main_fill_native_v2_sret_plain_main_fn(main_fn: &! IrFunction) with Mut, Panic, Div, Alloc {
    (*main_fn).name = ir_name_from_bytes(109, 97, 105, 110, 4)
    (*main_fn).reg_count = 4
    ir_arena_store(ir_region_slot_w((*main_fn).region, (0)), ir_alloc(0, 64))
    ir_arena_store(ir_region_slot_w((*main_fn).region, (1)), ir_load_imm(1, 7))
    ir_arena_store(ir_region_slot_w((*main_fn).region, (2)), ir_call(2, 1, ir_name_from_bytes(109, 97, 107, 101, 4), Some(Box::new(ir_reg_list_single(0))), 1))
    ir_arena_store(ir_region_slot_w((*main_fn).region, (3)), ir_field_get(3, 0, 1, ir_name_from_bytes(102, 49, 0, 0, 2))) // dest.f1
    ir_arena_store(ir_region_slot_w((*main_fn).region, (4)), ir_return(3))
    (*main_fn).instr_count = 5
}

// Real SysV >16-byte by-value struct return (sret) witness.
//   struct Big { f0: i64, f1: i64, f2: i64 }   (3 fields = 24B > 16B)
//   fn make(v) -> Big { Big { f0: v, f1: v*2, f2: v+1 } }   (sret callee)
//   fn main() -> { let b = make(7); return b.f1 }            = 7*2 = 14
//
// The discriminator vs a plain handle-passthrough call: the destination handle is
// HIDDEN and ABI-injected in rdi, so the one explicit param `v` shifts to rsi. If the
// callee wrongly read `v` from rdi it would get the dest handle id, not 7, and f1 would
// not be 14. Reading f1 (= v*2 = 14, distinct/non-coincidental) therefore proves BOTH
// write-through-the-rdi-destination AND the SysV param shift. The struct is genuinely
// >16B (3 i64 fields), matching the by-value >16B sret framing.
fn compiler_main_make_native_v2_sret_module() -> IrModule with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    // fn make(v) -> Big  (is_sret: hidden dest in rdi -> vreg0; explicit v shifts to rsi -> vreg1)
    // The destination is not a declared param: it is ABI-injected and spilled by
    // the sret prologue into sret_dest_reg.
    // Called via a plain IrCall this very fn would read v from rdi (the dest handle) and
    // mis-fill the struct; only the sret convention puts v in rsi -> f1 = 14. That gap is
    // the discriminator (see compiler_main_make_native_v2_sret_plaincall_module below).
    var main_slot = ir_fn_get(&module, 0)
    main_slot.name.len = 4
    main_slot.name.buf[0] = 109 as i8
    main_slot.name.buf[1] = 97 as i8
    main_slot.name.buf[2] = 105 as i8
    main_slot.name.buf[3] = 110 as i8
    main_slot.reg_count = 4
    let main_region = main_slot.region
    IR_A_OP[(ir_region_slot_w(main_region, (0))) as usize] = IrOpcode::IrAlloc
    IR_A_DST[(ir_region_slot_w(main_region, (0))) as usize] = 0
    IR_A_IMM_I64[(ir_region_slot_w(main_region, (0))) as usize] = 64
    IR_A_OP[(ir_region_slot_w(main_region, (1))) as usize] = IrOpcode::IrLoadImm
    IR_A_DST[(ir_region_slot_w(main_region, (1))) as usize] = 1
    IR_A_IMM_I64[(ir_region_slot_w(main_region, (1))) as usize] = 7
    IR_A_OP[(ir_region_slot_w(main_region, (2))) as usize] = IrOpcode::IrCallSret
    IR_A_DST[(ir_region_slot_w(main_region, (2))) as usize] = 2
    IR_A_SRC1[(ir_region_slot_w(main_region, (2))) as usize] = 0
    IR_A_FN_ID[(ir_region_slot_w(main_region, (2))) as usize] = 1
    IR_A_FIELD_IDX[(ir_region_slot_w(main_region, (2))) as usize] = 1
    IR_A_ARG_COUNT[(ir_region_slot_w(main_region, (2))) as usize] = 1
    IR_A_OP[(ir_region_slot_w(main_region, (3))) as usize] = IrOpcode::IrFieldGet
    IR_A_DST[(ir_region_slot_w(main_region, (3))) as usize] = 3
    IR_A_SRC1[(ir_region_slot_w(main_region, (3))) as usize] = 2
    IR_A_FIELD_IDX[(ir_region_slot_w(main_region, (3))) as usize] = 1
    IR_A_OP[(ir_region_slot_w(main_region, (4))) as usize] = IrOpcode::IrReturn
    IR_A_SRC1[(ir_region_slot_w(main_region, (4))) as usize] = 3
    main_slot.instr_count = 5
    ir_fn_set(&! module, 0, main_slot)

    var make_slot = ir_fn_get(&module, 1)
    make_slot.name.len = 4
    make_slot.name.buf[0] = 109 as i8
    make_slot.name.buf[1] = 97 as i8
    make_slot.name.buf[2] = 107 as i8
    make_slot.name.buf[3] = 101 as i8
    make_slot.is_sret = 1
    make_slot.sret_dest_reg = 0
    make_slot.param_count = 1
    make_slot.param_regs[0] = 1
    make_slot.reg_count = 6
    let make_region = make_slot.region
    IR_A_OP[(ir_region_slot_w(make_region, (0))) as usize] = IrOpcode::IrFieldSet
    IR_A_SRC1[(ir_region_slot_w(make_region, (0))) as usize] = 0
    IR_A_SRC2[(ir_region_slot_w(make_region, (0))) as usize] = 1
    IR_A_FIELD_IDX[(ir_region_slot_w(make_region, (0))) as usize] = 0
    IR_A_OP[(ir_region_slot_w(make_region, (1))) as usize] = IrOpcode::IrLoadImm
    IR_A_DST[(ir_region_slot_w(make_region, (1))) as usize] = 2
    IR_A_IMM_I64[(ir_region_slot_w(make_region, (1))) as usize] = 2
    IR_A_OP[(ir_region_slot_w(make_region, (2))) as usize] = IrOpcode::IrBinOp
