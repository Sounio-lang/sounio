// T446: name_is_sin recognizes "sin", rejects "cos"
fn compiler_main_test_name_is_sin() -> bool with Mut, Div, Panic {
    var n_sin = empty_name()
    n_sin.buf[0] = 115 as i8   // 's'
    n_sin.buf[1] = 105 as i8   // 'i'
    n_sin.buf[2] = 110 as i8   // 'n'
    n_sin.len = 3
    var n_cos = empty_name()
    n_cos.buf[0] = 99 as i8    // 'c'
    n_cos.buf[1] = 111 as i8   // 'o'
    n_cos.buf[2] = 115 as i8   // 's'
    n_cos.len = 3
    name_is_sin(n_sin) && !name_is_sin(n_cos)
}

// T447: name_is_cos recognizes "cos", rejects "sin"
fn compiler_main_test_name_is_cos() -> bool with Mut, Div, Panic {
    var n_sin = empty_name()
    n_sin.buf[0] = 115 as i8   // 's'
    n_sin.buf[1] = 105 as i8   // 'i'
    n_sin.buf[2] = 110 as i8   // 'n'
    n_sin.len = 3
    var n_cos = empty_name()
    n_cos.buf[0] = 99 as i8    // 'c'
    n_cos.buf[1] = 111 as i8   // 'o'
    n_cos.buf[2] = 115 as i8   // 's'
    n_cos.len = 3
    name_is_cos(n_cos) && !name_is_cos(n_sin)
}

// T448: emit_builtin_sin produces >50 bytes of code
fn compiler_main_test_emit_sin_produces_code() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    let before_len = nc.code.len
    nc = emit_builtin_sin(nc)
    let after_len = nc.code.len
    (after_len - before_len) > 50
}

// T449: emit_builtin_cos produces >50 bytes of code
fn compiler_main_test_emit_cos_produces_code() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    let before_len = nc.code.len
    nc = emit_builtin_cos(nc)
    let after_len = nc.code.len
    (after_len - before_len) > 50
}

// T450: CVTSD2SI encoding is 5 bytes (F2 48 0F 2D C0)
fn compiler_main_test_cvtsd2si_encoding() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    let before = buf.len
    buf = emit_cvtsd2si_rax_xmm0(buf)
    let after = buf.len
    (after - before) == 5
}

// T451: CVTSI2SD encoding is 5 bytes (F2 48 0F 2A C0)
fn compiler_main_test_cvtsi2sd_encoding() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    let before = buf.len
    buf = emit_cvtsi2sd_xmm0_rax(buf)
    let after = buf.len
    (after - before) == 5
}

