fn run_probe_compile_capture(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 1 >= args.len {
        panic("probe_compile_capture: missing source file argument")
    }
    let source_path = arg_list_get(args, flag_index + 1)
    var errors = compile_errors_new()
    if file_size(source_path) <= 0 {
        errors = compile_errors_push(errors, compile_format_error_at(source_path, 0, 0, "could not read input file"))
    } else {
        let incomplete_assign = compile_scan_incomplete_assignment(source_path)
        if incomplete_assign.0 {
            errors = compile_errors_push(
                errors,
                compile_format_error_at(source_path, incomplete_assign.1, incomplete_assign.2, "syntax appears incomplete after assignment")
            )
        }
    }

    if errors.len == 0 {
        println("probe_compile_capture: success")
    } else {
        println("probe_compile_capture: fail")
        var i: i64 = 0
        while i < errors.len {
            println(compile_errors_get(errors, i))
            i = i + 1
        }
    }
}

fn run_probe_load_ir(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 1 >= args.len {
        panic("probe_load_ir: missing source file argument")
    }
    let source_path = arg_list_get(args, flag_index + 1)
    println("probe_load_ir: begin")
    print("probe_load_ir: source=")
    print(source_path)
    print("\n")
    let ir_result = load_multimodule_ir_probe_summary(source_path)
    let parse_errors = parser_last_error_count()
    if ir_result.ok && parse_errors == 0 {
        println("probe_load_ir: ok")
        print("probe_load_ir: functions=")
        print_int(ir_result.module.fn_count)
        print("\n")
        var fi: i64 = 0
        while fi < ir_result.module.fn_count {
            print("probe_load_ir: fn=")
            compiler_manifest_print_name(ir_result.module.functions[fi as usize].name)
            print(" strategy=")
            print(ir_strategy_name(ir_result.module.functions[fi as usize].compile_strategy))
            print("\n")
            fi = fi + 1
        }
        return
    }
    println("probe_load_ir: fail")
    if !ir_result.ok && str_len(ir_result.error_msg) > 0 {
        print("probe_load_ir: error=")
        print(ir_result.error_msg)
        print("\n")
    }
    if parse_errors > 0 {
        println("probe_load_ir: parser_errors=" + int_to_string(parse_errors))
    }
    panic("probe_load_ir failed")
}

fn probe_frontend_strategy_print_name_local(name: Name) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < name.len {
        print_char(name.buf[i] as i64)
        i = i + 1
    }
}

fn probe_frontend_strategy_has_effect_local(effects: Option<Box<EffectList>>, target: string) -> bool with Mut, Panic, Div {
    match effects {
        Some(node) => {
            let list = *node
            let eff = list.head
            var matches = true
            let tlen = str_len(target)
            if eff.name_len != tlen {
                matches = false
            } else {
                var i: i64 = 0
                while i < tlen {
                    if eff.name_buf[i as usize] != (str_char_at(target, i) as i8) {
                        matches = false
                    }
                    i = i + 1
                }
            }
            if matches { true } else { probe_frontend_strategy_has_effect_local(list.tail, target) }
        }
        None => false,
    }
}

fn probe_frontend_strategy_from_signature_local(
    return_type: Option<Box<TypeExpr>>,
    effects: Option<Box<EffectList>>
) -> i64 with Mut, Panic, Div {
    if probe_frontend_strategy_has_effect_local(effects, "GPU") {
        return IR_STRATEGY_GPU_KERNEL
    }
    if probe_frontend_strategy_has_effect_local(effects, "Prob") {
        return IR_STRATEGY_PROBABILISTIC
    }
    match return_type {
        Some(node) => {
            let ty = *node
            if ty.kind == TypeExprKind::TypeValidated {
                IR_STRATEGY_AGGRESSIVE
            } else if ty.kind == TypeExprKind::TypeKnowledge {
                IR_STRATEGY_PRECISION_PRESERVING
            } else if ty.kind == TypeExprKind::TypeContest || ty.kind == TypeExprKind::TypeRobust {
                IR_STRATEGY_INSTRUMENTED
            } else {
                IR_STRATEGY_STANDARD
            }
        }
        None => IR_STRATEGY_STANDARD,
    }
}

fn probe_frontend_strategy_param_count_local(params: Option<Box<ParamList>>) -> i64 with Alloc {
    match params {
        Some(node) => {
            let list = *node
            1 + probe_frontend_strategy_param_count_local(list.tail)
        }
        None => 0,
    }
}

fn probe_frontend_strategy_count_fn_items_local(items: Option<Box<ItemList>>) -> i64 with Alloc {
    match items {
        Some(list) => {
            let rest = probe_frontend_strategy_count_fn_items_local((*list).tail)
            if (*list).head.kind == ItemKind::ItemFn { 1 + rest } else { rest }
        }
        None => 0,
    }
}

fn probe_frontend_strategy_print_items_local(items: Option<Box<ItemList>>) with IO, Mut, Panic, Div, Alloc {
    match items {
        Some(list) => {
            let item = (*list).head
            if item.kind == ItemKind::ItemFn {
                match item.fn_def {
                    Some(node) => {
                        let fn_def = *node
                        let strategy = probe_frontend_strategy_from_signature_local(fn_def.return_type, fn_def.effects)
                        let user_param_count = probe_frontend_strategy_param_count_local(fn_def.params)
                        let validated_param = strategy == IR_STRATEGY_INSTRUMENTED
                        let final_param_count = if validated_param { user_param_count + 1 } else { user_param_count }
                        print("probe_frontend_strategy: fn=")
                        probe_frontend_strategy_print_name_local(item.name)
                        print(" strategy=")
                        print(ir_strategy_name(strategy))
                        print(" validated_param=")
                        if validated_param { print("true") } else { print("false") }
                        print(" param_count=")
                        print_int(final_param_count)
                        print("\n")
                    }
                    None => {}
                }
            }
            probe_frontend_strategy_print_items_local((*list).tail)
        }
        None => {}
    }
}

fn run_probe_frontend_strategy(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 1 >= args.len {
        panic("probe_frontend_strategy: missing source file argument")
    }
    let source_path = arg_list_get(args, flag_index + 1)
    println("probe_frontend_strategy: begin")
    print("probe_frontend_strategy: source=")
    print(source_path)
    print("\n")
    let frontend_result = preflight_multimodule_frontend(source_path)
    let parse_errors = parser_last_error_count()
    if frontend_result.ok && parse_errors == 0 {
        let main_prog = load_module_file(source_path)
        println("probe_frontend_strategy: ok")
        print("probe_frontend_strategy: functions=")
        print_int(probe_frontend_strategy_count_fn_items_local(main_prog.items))
        print("\n")
        probe_frontend_strategy_print_items_local(main_prog.items)
        return
    }
    println("probe_frontend_strategy: fail")
    if str_len(frontend_result.error_msg) > 0 {
        print("probe_frontend_strategy: error=")
        print(frontend_result.error_msg)
        print("\n")
    }
    if parse_errors > 0 {
        println("probe_frontend_strategy: parser_errors=" + int_to_string(parse_errors))
    }
    panic("probe_frontend_strategy failed")
}

