    } else {
        println("  FAIL: T98 ocp_const_fold reduces x / 2 → x >> 1 (OpShr, constant patched to 1)")
    }

    if compiler_main_test_ocp_sr_div_by_4() {
        println("  T99 OK: ocp_const_fold reduces x / 4 → x >> 2 (OpShr, constant patched to 2)")
