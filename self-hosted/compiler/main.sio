// Sret witness: --native-v2-emit-sret <out_path>. make(7) writes a >16B Big through the
// ABI-injected rdi destination; main reads b.f1 = 7*2 = 14 -> exit 14. Proves the real
// SysV sret path (hidden dest in rdi + explicit param shifted to rsi) in the CORE emitter.
fn run_native_v2_emit_sret(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 1 >= args.len {
        panic("native-v2-emit-sret: usage --native-v2-emit-sret <out_path>")
    }
    let out_path = arg_list_get(args, flag_index + 1)
    let rc = compile_native_v2_sret_witness_to_file(out_path, false)
    if rc != 0 {
        print("native_v2_emit_exit_code: FAIL to_file label=sret rc=")
        print_int(rc as i64)
        print("\n")
        return
    }
    print("native_v2_emit_exit_code: emitted label=sret path=")
    print(out_path)
    print("\n")
}

