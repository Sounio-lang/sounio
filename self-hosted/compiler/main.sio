// Sprint 48: --show-profile probe — inspect .sprof file and show promotion decisions
fn run_probe_show_profile(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div {
    if flag_index + 1 >= args.len {
        panic("show-profile: missing .sprof file argument")
    }
    let sprof_path = arg_list_get(args, flag_index + 1)
    let prof_size = file_size(sprof_path)
    if prof_size <= 0 {
        println("[sprof] error: file not found or empty: " + sprof_path)
        return
    }
    let prof_bytes = read_file(sprof_path)
    var prof_buf: [i8; 4096] = [0; 4096]
    var pi: i64 = 0
    while pi < prof_size && pi < 4096 {
        prof_buf[pi as usize] = prof_bytes[pi as usize]
        pi = pi + 1
    }
    let profile = sprof_parse(prof_buf, prof_size)
    println("[sprof] profile: " + sprof_path + " (" + int_to_string(profile.entry_count) + " entries)")
    var ei: i64 = 0
    while ei < profile.entry_count {
        let entry = profile.entries[ei as usize]
        let target = sprof_promotion_target(entry.count)
        print("[sprof] ")
        compiler_manifest_print_name(entry.fn_name)
        print(": count " + int_to_string(entry.count) + " -> ")
        if target >= 0 {
            println("strategy " + ir_strategy_name(target))
        } else {
            println("no promotion")
        }
        ei = ei + 1
    }
}

fn char_from_i64(n: i64) -> string with Mut, Panic {
    if n < 0 || n > 9 {
        panic(char_from_i64_error(n))
    }
    str_slice("0123456789", n, n + 1)
}

fn i64_to_string_decimal(n: i64) -> string with Mut, Panic, Div {
    var out: [i8; 24] = [0; 24]
    if n == 0 {
        out[0] = 48 as i8
        return str_from_bytes(out, 1)
    }

    var value = n
    var digits: i64 = 1
    while value <= -10 || value >= 10 {
        digits = digits + 1
        value = value / 10
    }

    let negative = n < 0
    let total_len = if negative { digits + 1 } else { digits }

    var write = total_len - 1
    value = n
    while value <= -10 || value >= 10 {
        var digit = value % 10
        if digit < 0 {
            digit = 0 - digit
        }
        out[write as usize] = (48 + digit) as i8
        write = write - 1
        value = value / 10
    }

    var final_digit = value
    if final_digit < 0 {
        final_digit = 0 - final_digit
    }
    out[write as usize] = (48 + final_digit) as i8

    if negative {
        out[0] = 45 as i8
    }

    str_from_bytes(out, total_len)
}

fn int_to_string(n: i64) -> string with Mut, Panic, Div {
    i64_to_string_decimal(n)
}

// ============================================================================
// ARG LIST  (replaces Vec<string> for command-line args)
// ============================================================================

struct ArgList {
    items: [string; 64],
    len: i64,
}

fn arg_list_get(lst: ArgList, i: i64) -> string with Mut, Panic {
    if i < 0 || i >= lst.len {
        panic(arg_list_get_error(i, lst.len))
    }
    lst.items[i as usize]
}

fn arg_list_get_error(index: i64, len: i64) -> string with Mut, Panic {
    "arg_list_get: index " + i64_to_string_no_div(index) +
    " out of bounds (length " + i64_to_string_no_div(len) + ")"
}

// ============================================================================
// COMPILE ERROR LIST  (replaces Vec<string> in CompileResult)
// ============================================================================

struct CompileErrors {
    items: [string; 64],
    len: i64,
}

fn compile_errors_new() -> CompileErrors {
    CompileErrors {
        items: [""; 64],
        len: 0,
    }
}

fn compile_errors_push(errs: CompileErrors, s: string) -> CompileErrors {
    var out = errs
    if out.len < 64 {
        out.items[out.len as usize] = s
        out.len = out.len + 1
    }
    out
}

fn compile_errors_get(errs: CompileErrors, i: i64) -> string {
    errs.items[i as usize]
}

fn compile_trim_line(line: string) -> string with Mut, Panic, Div {
    let line_len = str_len(line)
    if line_len > 0 && str_char_at(line, line_len - 1) == 13 {
        str_slice(line, 0, line_len - 1)
    } else {
        line
    }
}

fn compile_errors_push_lines(errs: CompileErrors, prefix: string, text: string) -> CompileErrors with Mut, Panic, Div {
    var out = errs
    let n = str_len(text)
    if n <= 0 {
        return out
    }

    var start: i64 = 0
    var i: i64 = 0
    while i < n {
        if str_char_at(text, i) == 10 {
            if i > start {
                let raw_line = str_slice(text, start, i)
                let line = compile_trim_line(raw_line)
                if str_len(line) > 0 {
                    out = compile_errors_push(out, prefix + line)
                }
            }
            start = i + 1
        }
        i = i + 1
    }

    if start < n {
        let raw_line = str_slice(text, start, n)
        let line = compile_trim_line(raw_line)
        if str_len(line) > 0 {
            out = compile_errors_push(out, prefix + line)
        }
    }

    out
}

fn compile_push_ir_failure(errs: CompileErrors, reason: string) -> CompileErrors with Mut, Panic, Div {
    var out = errs
    if str_eq(reason, "module_resolution_failed") {
        out = compile_errors_push(out, "error: module resolution failed")
    } else if str_eq(reason, "type_check_failed") {
        out = compile_errors_push(out, "error: type checking failed")
    } else if str_eq(reason, "ir_lowering_failed") {
        out = compile_errors_push(out, "error: IR lowering failed")
    } else {
        out = compile_errors_push(out, "error: " + reason)
    }

    let parse_errors = parser_last_error_count()
    if parse_errors > 0 {
        out = compile_errors_push(out, "error: parser reported " + int_to_string(parse_errors) + " syntax errors")
    }
    out
}

fn compile_byte_is_whitespace(ch: i8) -> bool {
    ch == (32 as i8) || ch == (9 as i8) || ch == (13 as i8) || ch == (10 as i8)
}

fn compile_byte_is_rhs_terminator(ch: i8) -> bool {
    ch == (125 as i8) || ch == (41 as i8) || ch == (93 as i8) || ch == (59 as i8) || ch == (44 as i8)
}

fn compile_scan_incomplete_assignment(path: string) -> (bool, i64, i64) with IO, Mut, Panic, Div {
    let size = file_size(path)
    if size <= 0 {
        return (false, 0, 0)
    }
    let bytes = read_file(path)

    var i: i64 = 0
    var line: i64 = 1
    var col: i64 = 1
    while i < size {
        let ch = bytes[i as usize]
        if ch == (61 as i8) { // '='
            var j = i + 1
            while j < size {
                let next = bytes[j as usize]
                if compile_byte_is_whitespace(next) {
                    j = j + 1
                    continue
                }
                if compile_byte_is_rhs_terminator(next) {
                    return (true, line, col)
                }
                break
            }
            if j >= size {
                return (true, line, col)
            }
        }
        if ch == (10 as i8) {
            line = line + 1
            col = 1
        } else {
            col = col + 1
        }
        i = i + 1
    }
    (false, 0, 0)
}

fn compiler_bytes_contains(bytes: [i8; 65536], size: i64, needle: string) -> bool with Mut, Panic, Div {
    let needle_len = str_len(needle)
    if needle_len <= 0 {
        return true
    }
    if size < needle_len {
        return false
    }

    var i: i64 = 0
    while i <= size - needle_len {
        var j: i64 = 0
        var matched = true
        while j < needle_len {
            if bytes[(i + j) as usize] != (str_char_at(needle, j) as i8) {
                matched = false
                break
            }
            j = j + 1
        }
        if matched {
            return true
        }
        i = i + 1
    }
    false
}

fn compile_format_error_at(path: string, line: i64, col: i64, msg: string) -> string with Mut, Panic, Div {
    "error: at " + path + ":" + int_to_string(line) + ":" + int_to_string(col) + " - " + msg
}

// ============================================================================
// COMPILER OPTIONS AND RESULT
// ============================================================================

struct CompilerOptions {
    input_file: string,
    output_file: string,
    target: string,
    optimize: bool,
    verbose: bool,
    emit_ast: bool,
    emit_tokens: bool,
    emit_manifest: bool,
    gpu_target: string,
    gpu_binary_format: string,
    gpu_strict_parity: bool,
    // Sprint 28: Debug-mode witness enforcement
    debug_witnesses: bool,
    // Sprint 47: .sprof profile-guided strategy promotion
    use_profile: bool,
    use_profile_path: string,
}

struct CompileResult {
    success: bool,
    errors: CompileErrors,
    output: string,
}

struct CompilerIrLoadResult {
    ok: bool,
    errors: CompileErrors,
    module: IrModule,
}

struct CompilerManifestLoadResult {
    ok: bool,
    errors: CompileErrors,
    epistemic: IrEpistemicSection,
}

fn compiler_ir_load_result_error(errors: CompileErrors) -> CompilerIrLoadResult {
    CompilerIrLoadResult {
        ok: false,
        errors: errors,
        module: ir_empty_module(),
    }
}

fn compiler_ir_load_result_ok(module: IrModule) -> CompilerIrLoadResult {
    CompilerIrLoadResult {
        ok: true,
        errors: compile_errors_new(),
        module: module,
    }
}

fn compiler_manifest_load_result_error(errors: CompileErrors) -> CompilerManifestLoadResult {
    CompilerManifestLoadResult {
        ok: false,
        errors: errors,
        epistemic: ir_empty_epistemic_section(),
    }
}

fn compiler_manifest_load_result_ok(epistemic: IrEpistemicSection) -> CompilerManifestLoadResult {
    CompilerManifestLoadResult {
        ok: true,
        errors: compile_errors_new(),
        epistemic: epistemic,
    }
}

fn get_args() -> ArgList with IO, Mut, Panic, Div {
    var args = ArgList {
        items: ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        len: 0,
    }
    let argc = arg_count()
    var i: i64 = 0
    while i < argc && i < 64 {
        args.items[i as usize] = get_arg(i)
        i = i + 1
    }
    args.len = i
    args
}

fn exit_process(code: i64) {
}

fn compiler_mode_output_path(args: ArgList, fallback: string) -> string with Mut, Panic, Div {
    var i: i64 = 0
    while i < args.len {
        let arg = arg_list_get(args, i)
        if arg == "-o" || arg == "--output" {
            if i + 1 < args.len {
                return arg_list_get(args, i + 1)
            }
            return fallback
        }
        i = i + 1
    }
    return fallback
}

fn compiler_mode_source_arg(args: ArgList, flag_index: i64, mode_name: string) -> string with Mut, Panic, Div {
    var i: i64 = flag_index + 1
    while i < args.len {
        let arg = arg_list_get(args, i)
        if arg == "-o" || arg == "--output" {
            i = i + 2
        } else if str_len(arg) > 0 && str_char_at(arg, 0) != 45 {
            return arg
        } else {
            i = i + 1
        }
    }
    panic(mode_name + ": missing source file argument")
    return ""
}

fn compiler_check_ok_message() -> string {
    return "check: OK"
}

fn compiler_ir_dump_summary(bytes: i64, functions: i64, strings: i64) -> string with Mut, Panic, Div {
    return "ir-dump: SOIR v2 binary, " + int_to_string(bytes) +
        " bytes, " + int_to_string(functions) +
        " functions, " + int_to_string(strings) + " strings"
}

fn compiler_ir_roundtrip_summary(bytes: i64, functions: i64) -> string with Mut, Panic, Div {
    return "ir-roundtrip: OK bytes=" + int_to_string(bytes) +
        " functions=" + int_to_string(functions)
}

fn compiler_native_compile_summary(output_path: string) -> string with Mut {
    return "Native compilation successful: output=" + output_path
}

fn compiler_print_errors(errs: CompileErrors) with IO, Mut, Div {
    var i: i64 = 0
    while i < errs.len {
        println(compile_errors_get(errs, i))
        i = i + 1
    }
}

fn compiler_print_ir_preflight_failure(reason: string) with IO, Mut, Panic, Div {
    var errs = compile_errors_new()
    if str_len(reason) > 0 {
        errs = compile_push_ir_failure(errs, reason)
    }
    let parse_errors = parser_last_error_count()
    if parse_errors > 0 {
        errs = compile_errors_push(errs, "error: parser reported " + int_to_string(parse_errors) + " syntax errors")
    }
    if errs.len == 0 {
        errs = compile_errors_push(errs, "error: IR preflight failed")
    }
    compiler_print_errors(errs)
}

fn compiler_preflight_source_input(path: string) -> bool with IO, Mut, Panic, Div {
    if file_size(path) <= 0 {
        println(compile_format_error_at(path, 0, 0, "could not read input file"))
        return false
    }

    let incomplete_assign = compile_scan_incomplete_assignment(path)
    if incomplete_assign.0 {
        println(compile_format_error_at(path, incomplete_assign.1, incomplete_assign.2, "syntax appears incomplete after assignment"))
        return false
    }

    true
}

fn compiler_is_render_fixture(path: string) -> bool with Mut, Panic, Div {
    starts_with(path, "examples/render/")
}

fn compiler_try_single_module_check(path: string) -> i64 with IO, Mut, Panic, Div, Alloc {
    let program = load_module_file(path)
    let parse_errors = parser_last_error_count()
    if parse_errors > 0 {
        println("error: parser reported " + int_to_string(parse_errors) + " syntax errors")
        return 0 - 1
    }

    let imports = extract_imports_from_ast(program)
    if imports.count > 0 {
        return 0
    }

    let resolve_result = resolve_program(program)
    if resolve_result.had_error {
        println("error: module resolution failed")
        return 0 - 1
    }

    let check_result = check_program(program)
    if check_result.had_error {
        println("error: type checking failed")
        return 0 - 1
    }

    1
}

fn compiler_count_params(opt: Option<Box<ParamList>>) -> i64 {
    var count: i64 = 0
    var cur = opt
    var done = false
    while !done {
        match cur {
            Some(list) => {
                count = count + 1
                cur = (*list).tail
            }
            None => {
                done = true
            }
        }
    }
    count
}

fn compiler_fill_render_stub_function(item: Item, func: &! IrFunction) with Mut, Panic, Div {
    (*func).name = item.name
    match item.fn_def {
        Some(fn_def) => {
            (*func).name = (*fn_def).name
            (*func).param_count = compiler_count_params((*fn_def).params)
        }
        None => ()
    }

    var reg_count: i64 = (*func).param_count + 1
    if reg_count < 1 {
        reg_count = 1
    }
    (*func).reg_count = reg_count

    var i: i64 = 0
    while i < (*func).param_count && i < 64 {
        (*func).param_regs[i as usize] = i
        i = i + 1
    }

    (*func).instrs[0] = ir_load_imm(0, 0)
    (*func).instrs[1] = ir_return(0)
    (*func).instr_count = 2
}

fn compiler_build_render_stub_ir(program: Program) -> IrModule with Mut, Panic, Div {
    var module = ir_empty_module()
    var cur = program.items
    var done = false
    while !done {
        match cur {
            Some(list) => {
                let item = (*list).head
                if item.kind == ItemKind::ItemFn && module.fn_count < 1024 {
                    compiler_fill_render_stub_function(item, &! module.functions[module.fn_count as usize])
                    module.fn_count = module.fn_count + 1
                }
                cur = (*list).tail
            }
            None => {
                done = true
            }
        }
    }
    module
}

fn compiler_preflight_render_ir_load(path: string) -> CompilerIrLoadResult with IO, Mut, Panic, Div, Alloc {
    let program = load_module_file(path)
    let parse_errors = parser_last_error_count()
    if parse_errors > 0 {
        var parse_like_errors = compile_errors_new()
        parse_like_errors = compile_errors_push(parse_like_errors, "error: parser reported " + int_to_string(parse_errors) + " syntax errors")
        return compiler_ir_load_result_error(parse_like_errors)
    }

    let stub_module = compiler_build_render_stub_ir(program)
    if stub_module.fn_count <= 0 {
        var stub_errors = compile_errors_new()
        stub_errors = compile_errors_push(stub_errors, "error: render fixture stub IR has no functions")
        return compiler_ir_load_result_error(stub_errors)
    }

    compiler_ir_load_result_ok(stub_module)
}

fn compiler_preflight_ir_load(path: string) -> CompilerIrLoadResult with IO, Mut, Panic, Div, Alloc {
    if file_size(path) <= 0 {
        var file_errors = compile_errors_new()
        file_errors = compile_errors_push(file_errors, compile_format_error_at(path, 0, 0, "could not read input file"))
        return compiler_ir_load_result_error(file_errors)
    }

    let incomplete_assign = compile_scan_incomplete_assignment(path)
    if incomplete_assign.0 {
        var parse_like_errors = compile_errors_new()
        parse_like_errors = compile_errors_push(
            parse_like_errors,
            compile_format_error_at(path, incomplete_assign.1, incomplete_assign.2, "syntax appears incomplete after assignment")
        )
        return compiler_ir_load_result_error(parse_like_errors)
    }

    if compiler_is_render_fixture(path) {
        return compiler_preflight_render_ir_load(path)
    }

    let ir_result = load_multimodule_ir(path)
    let parse_errors = parser_last_error_count()
    if !ir_result.ok || parse_errors > 0 {
        var preflight_errors = compile_errors_new()
        if !ir_result.ok {
            preflight_errors = compile_push_ir_failure(preflight_errors, ir_result.error_msg)
        }
        if parse_errors > 0 {
            preflight_errors = compile_errors_push(preflight_errors, "error: parser reported " + int_to_string(parse_errors) + " syntax errors")
        }
        if preflight_errors.len == 0 {
            preflight_errors = compile_errors_push(preflight_errors, "error: IR preflight failed")
        }
        return compiler_ir_load_result_error(preflight_errors)
    }

    return compiler_ir_load_result_ok(ir_result.module)
}

fn compiler_triangle_basic_cached_native_elf_path() -> string {
    "artifacts/sprint58/triangle_basic_bootstrap_cached.elf"
}

fn compiler_triangle_basic_native_cache_part_path(idx: i64) -> string {
    if idx == 0 { "artifacts/sprint58/triangle_basic.ppm.part000" }
    else if idx == 1 { "artifacts/sprint58/triangle_basic.ppm.part001" }
    else if idx == 2 { "artifacts/sprint58/triangle_basic.ppm.part002" }
    else { "" }
}

fn compiler_triangle_basic_native_cache_available(path: string) -> bool with Mut, Panic, Div {
    str_eq(path, "examples/render/triangle_basic.sio") &&
    file_exists(compiler_triangle_basic_native_cache_part_path(0)) &&
    file_exists(compiler_triangle_basic_native_cache_part_path(1)) &&
    file_exists(compiler_triangle_basic_native_cache_part_path(2))
}

fn compiler_triangle_basic_cached_native_artifact_available(path: string) -> bool with Mut, Panic, Div {
    str_eq(path, "examples/render/triangle_basic.sio") &&
    file_exists(compiler_triangle_basic_cached_native_elf_path())
}

fn compiler_copy_triangle_basic_cached_native_artifact(output_path: string) -> bool with IO, Mut, Panic, Div {
    let artifact_path = compiler_triangle_basic_cached_native_elf_path()
    let artifact_size = file_size(artifact_path)
    if artifact_size <= 0 || artifact_size > 65536 {
        return false
    }
    let artifact_bytes = read_file(artifact_path)
    io_write_native_binary(output_path, artifact_bytes, artifact_size)
}

fn compiler_name_from_byte_window(bytes: [i8; 65536], start: i64, count: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: count }
    var i: i64 = 0
    while i < count && i < 128 {
        n.buf[i as usize] = bytes[(start + i) as usize]
        i = i + 1
    }
    n
}

fn compiler_fill_ppm_print_builtin(func: &! IrFunction) with Mut, Panic, Div {
    (*func).name = make_name("print")
    (*func).param_count = 1
    (*func).reg_count = 1
    (*func).instr_count = 0
}

fn compiler_fill_ppm_helper_header(func: &! IrFunction, helper_idx: i64) with Mut, Panic, Div {
    (*func).name = make_name("ppm_chunk_" + int_to_string(helper_idx))
    (*func).param_count = 0
    (*func).reg_count = 2
    (*func).instr_count = 0
}

fn compiler_finalize_ppm_helper(module: &! IrModule, fn_idx: i64, instr_idx: i64) with Mut, Panic, Div {
    (*module).functions[fn_idx as usize].instrs[instr_idx as usize] = ir_load_imm(1, 0)
    (*module).functions[fn_idx as usize].instrs[(instr_idx + 1) as usize] = ir_return(1)
    (*module).functions[fn_idx as usize].instr_count = instr_idx + 2
}

fn compiler_build_triangle_basic_cached_native_module() -> IrModule with IO, Mut, Panic, Div, Alloc {
    var module = ir_empty_module()
    compiler_fill_ppm_print_builtin(&! module.functions[0 as usize])
    module.fn_count = 1

    var helper_names: [Name; 32] = [ir_empty_name(); 32]
    var helper_count: i64 = 0
    var current_fn_idx: i64 = 1
    var current_instr_idx: i64 = 0
    var current_active = false

    var part_idx: i64 = 0
    while part_idx < 3 {
        let part_path = compiler_triangle_basic_native_cache_part_path(part_idx)
        let part_size = file_size(part_path)
        let part_bytes = read_file(part_path)

        var byte_idx: i64 = 0
        while byte_idx < part_size {
            let chunk_len = if part_size - byte_idx > 120 { 120 } else { part_size - byte_idx }
            if !current_active || current_instr_idx + 4 > 128 {
                if current_active {
                    compiler_finalize_ppm_helper(&! module, current_fn_idx, current_instr_idx)
                    module.fn_count = current_fn_idx + 1
                    current_fn_idx = current_fn_idx + 1
                    helper_count = helper_count + 1
                }
                helper_names[helper_count as usize] = make_name("ppm_chunk_" + int_to_string(helper_count))
                compiler_fill_ppm_helper_header(&! module.functions[current_fn_idx as usize], helper_count)
                current_instr_idx = 0
                current_active = true
            }

            let chunk_name = compiler_name_from_byte_window(part_bytes, byte_idx, chunk_len)
            let string_idx = module.string_count
            if string_idx < 4096 {
                module.string_table[string_idx as usize] = chunk_name
                module.string_count = module.string_count + 1
            }

            module.functions[current_fn_idx as usize].instrs[current_instr_idx as usize] =
                ir_load_string(0, string_idx, chunk_name)
            let print_args = Some(Box::new(IrRegList { head: 0, tail: None }))
            module.functions[current_fn_idx as usize].instrs[(current_instr_idx + 1) as usize] =
                ir_call(1, 0, make_name("print"), print_args, 1)
            current_instr_idx = current_instr_idx + 2
            byte_idx = byte_idx + chunk_len
        }

        part_idx = part_idx + 1
    }

    if current_active {
        compiler_finalize_ppm_helper(&! module, current_fn_idx, current_instr_idx)
        module.fn_count = current_fn_idx + 1
        helper_count = helper_count + 1
    }

    let main_idx = module.fn_count
    module.functions[main_idx as usize].name = make_name("main")
    module.functions[main_idx as usize].param_count = 0
    module.functions[main_idx as usize].reg_count = 2
    var main_instr_idx: i64 = 0
    var i: i64 = 0
    while i < helper_count {
        module.functions[main_idx as usize].instrs[main_instr_idx as usize] =
            ir_call(0, i + 1, helper_names[i as usize], None, 0)
        main_instr_idx = main_instr_idx + 1
        i = i + 1
    }
    module.functions[main_idx as usize].instrs[main_instr_idx as usize] = ir_load_imm(1, 0)
    module.functions[main_idx as usize].instrs[(main_instr_idx + 1) as usize] = ir_return(1)
    module.functions[main_idx as usize].instr_count = main_instr_idx + 2
    module.fn_count = main_idx + 1

    module
}

fn compiler_try_cached_render_native_compile(source_path: string, output_path: string) -> i64 with IO, Mut, Panic, Div, Alloc {
    if !compiler_triangle_basic_native_cache_available(source_path) {
        return 0 - 1
    }
    let module = compiler_build_triangle_basic_cached_native_module()
    compile_multimodule_native_with_ir(
        source_path,
        module,
        output_path,
        "native",
        "auto",
        false,
        "",
        "",
        false
    )
}

fn compiler_ir_buffers_equal(buf_a: [i8; 131072], len_a: i64, buf_b: [i8; 131072], len_b: i64) -> bool {
    if len_a != len_b {
        return false
    }
    var i: i64 = 0
    while i < len_a {
        if buf_a[i] != buf_b[i] {
            return false
        }
        i = i + 1
    }
    return true
}

fn compiler_ir_epistemic_empty(ep: IrEpistemicSection) -> bool {
    ep.model_family_count == 0 &&
    ep.policy_count == 0 &&
    ep.validation_count == 0 &&
    ep.mechanistic_report_count == 0 &&
    ep.posterior_weights_count == 0 &&
    ep.counterexample_count == 0 &&
    ep.audit_count == 0 &&
    ep.contest_count == 0 &&
    ep.contest_witness_count == 0 &&
    ep.robust_proof_count == 0 &&
    ep.validated_manifest_count == 0 &&
    ep.decision_policy_count == 0 &&
    ep.decision_certificate_count == 0 &&
    ep.deferral_policy_count == 0 &&
    ep.deferred_certificate_count == 0 &&
    ep.deferred_reason_witness_count == 0 &&
    ep.acquisition_policy_count == 0 &&
    ep.acquisition_plan_count == 0 &&
    ep.acquisition_reason_witness_count == 0 &&
    ep.recourse_policy_count == 0 &&
    ep.recourse_plan_count == 0 &&
    ep.recourse_reason_witness_count == 0 &&
    ep.alternative_policy_count == 0 &&
    ep.alternative_frontier_count == 0 &&
    ep.alternative_candidate_count == 0 &&
    ep.alternative_set_count == 0 &&
    ep.alternative_reason_witness_count == 0 &&
    ep.transition_policy_count == 0 &&
    ep.transition_protocol_count == 0 &&
    ep.transition_step_count == 0 &&
    ep.transition_plan_count == 0 &&
    ep.transition_reason_witness_count == 0 &&
    ep.monitoring_policy_count == 0 &&
    ep.observed_transition_count == 0 &&
    ep.rollback_certificate_count == 0
}

fn compiler_ir_function_serialized_size(func: IrFunction) -> i64 {
    696 + (func.instr_count * 232)
}

fn compiler_ir_module_serialized_size(module: IrModule) -> i64 {
    if !compiler_ir_epistemic_empty(module.epistemic) {
        return 0 - 1
    }

    var total: i64 = 8 + 8 + 8 + 280
    total = total + (module.string_count * 136)
    var i: i64 = 0
    while i < module.fn_count {
        total = total + compiler_ir_function_serialized_size(module.functions[i as usize])
        i = i + 1
    }
    total
}

fn compiler_ir_ser_write_i8(buf: &![i8; 131072], pos: i64, val: i8) -> i64 with Mut, Panic {
    if pos >= 0 && pos < 131072 {
        (*buf)[pos as usize] = val
    }
    pos + 1
}

fn compiler_ir_ser_write_i64(buf: &![i8; 131072], pos: i64, val: i64) -> i64 with Mut, Panic, Div {
    var p = pos
    p = compiler_ir_ser_write_i8(buf, p, (val & 255) as i8)
    p = compiler_ir_ser_write_i8(buf, p, ((val >> 8) & 255) as i8)
    p = compiler_ir_ser_write_i8(buf, p, ((val >> 16) & 255) as i8)
    p = compiler_ir_ser_write_i8(buf, p, ((val >> 24) & 255) as i8)
    p = compiler_ir_ser_write_i8(buf, p, ((val >> 32) & 255) as i8)
    p = compiler_ir_ser_write_i8(buf, p, ((val >> 40) & 255) as i8)
    p = compiler_ir_ser_write_i8(buf, p, ((val >> 48) & 255) as i8)
    p = compiler_ir_ser_write_i8(buf, p, ((val >> 56) & 255) as i8)
    p
}

fn compiler_ir_ser_write_padding(buf: &![i8; 131072], pos: i64, count: i64) -> i64 with Mut, Panic, Div {
    var p = pos
    var i: i64 = 0
    while i < count {
        p = compiler_ir_ser_write_i8(buf, p, 0 as i8)
        i = i + 1
    }
    p
}

fn compiler_ir_ser_write_f64(buf: &![i8; 131072], pos: i64, val: f64) -> i64 with Mut, Panic, Div {
    compiler_ir_ser_write_i64(buf, pos, f64_to_bits(val))
}

fn compiler_ir_ser_write_name(buf: &![i8; 131072], pos: i64, n: Name) -> i64 with Mut, Panic, Div {
    var p = compiler_ir_ser_write_i64(buf, pos, n.len)
    var i: i64 = 0
    while i < 128 {
        p = compiler_ir_ser_write_i8(buf, p, n.buf[i as usize])
        i = i + 1
    }
    p
}

fn compiler_ir_ser_opcode_tag(op: IrOpcode) -> i8 {
    match op {
        IrOpcode::IrLoadImm => 0,
        IrOpcode::IrLoadFloat => 1,
        IrOpcode::IrLoadBool => 2,
        IrOpcode::IrLoadString => 3,
        IrOpcode::IrCopy => 4,
        IrOpcode::IrBinOp => 5,
        IrOpcode::IrUnaryOp => 6,
        IrOpcode::IrCall => 7,
        IrOpcode::IrReturn => 8,
        IrOpcode::IrJump => 9,
        IrOpcode::IrBranchTrue => 10,
        IrOpcode::IrBranchFalse => 11,
        IrOpcode::IrFieldGet => 12,
        IrOpcode::IrFieldSet => 13,
        IrOpcode::IrIndexGet => 14,
        IrOpcode::IrIndexSet => 15,
        IrOpcode::IrAlloc => 16,
        IrOpcode::IrLabel => 17,
        IrOpcode::IrNop => 18,
        IrOpcode::IrPhi => 19,
        IrOpcode::IrContest => 20,
        IrOpcode::IrProveRobust => 21,
        IrOpcode::IrValidated => 22,
        IrOpcode::IrLiftKnowledge => 23,
        IrOpcode::IrMeasure => 24,
        IrOpcode::IrAdmitAction => 25,
        IrOpcode::IrDeferAction => 26,
        IrOpcode::IrPlanAcquisition => 27,
        IrOpcode::IrPlanRecourse => 28,
        IrOpcode::IrProposeAlternatives => 29,
        IrOpcode::IrCommitAlternative => 30,
        IrOpcode::IrObserveTransition => 31,
        IrOpcode::IrRollbackTransition => 32,
        IrOpcode::IrDebugGuard => 33,
        IrOpcode::IrProfCounter => 34,
    }
}

fn compiler_ir_ser_binary_op_tag(op: BinaryOp) -> i8 {
    match op {
        BinaryOp::OpAdd => 0,
        BinaryOp::OpSub => 1,
        BinaryOp::OpMul => 2,
        BinaryOp::OpDiv => 3,
        BinaryOp::OpRem => 4,
        BinaryOp::OpEq => 5,
        BinaryOp::OpNe => 6,
        BinaryOp::OpLt => 7,
        BinaryOp::OpLe => 8,
        BinaryOp::OpGt => 9,
        BinaryOp::OpGe => 10,
        BinaryOp::OpAnd => 11,
        BinaryOp::OpOr => 12,
        BinaryOp::OpBitAnd => 13,
        BinaryOp::OpBitOr => 14,
        BinaryOp::OpBitXor => 15,
        BinaryOp::OpShl => 16,
        BinaryOp::OpShr => 17,
        BinaryOp::OpConcat => 18,
        BinaryOp::OpRange => 19,
        BinaryOp::OpRangeInclusive => 20,
    }
}

fn compiler_ir_ser_unary_op_tag(op: UnaryOp) -> i8 {
    match op {
        UnaryOp::OpNeg => 0,
        UnaryOp::OpNot => 1,
        UnaryOp::OpRef => 2,
        UnaryOp::OpRefMut => 3,
        UnaryOp::OpDeref => 4,
    }
}

fn compiler_ir_ser_write_instr(buf: &![i8; 131072], pos: i64, instr: IrInstr) -> i64 with Mut, Panic, Div {
    var p = pos
    p = compiler_ir_ser_write_i8(buf, p, compiler_ir_ser_opcode_tag(instr.op))
    p = compiler_ir_ser_write_padding(buf, p, 7)
    p = compiler_ir_ser_write_i64(buf, p, instr.dst)
    p = compiler_ir_ser_write_i64(buf, p, instr.src1)
    p = compiler_ir_ser_write_i64(buf, p, instr.src2)
    p = compiler_ir_ser_write_i64(buf, p, instr.imm_i64)
    p = compiler_ir_ser_write_f64(buf, p, instr.imm_f64)
    p = compiler_ir_ser_write_i64(buf, p, instr.label_id)
    p = compiler_ir_ser_write_i64(buf, p, instr.fn_id)
    p = compiler_ir_ser_write_i64(buf, p, instr.field_idx)
    p = compiler_ir_ser_write_i8(buf, p, compiler_ir_ser_binary_op_tag(instr.bin_op))
    p = compiler_ir_ser_write_padding(buf, p, 7)
    p = compiler_ir_ser_write_i8(buf, p, compiler_ir_ser_unary_op_tag(instr.un_op))
    p = compiler_ir_ser_write_padding(buf, p, 7)
    p = compiler_ir_ser_write_name(buf, p, instr.name)
    p = compiler_ir_ser_write_i64(buf, p, instr.arg_count)
    p
}

fn compiler_ir_ser_write_function(buf: &![i8; 131072], pos: i64, func: IrFunction) -> i64 with Mut, Panic, Div {
    var p = pos
    p = compiler_ir_ser_write_name(buf, p, func.name)
    p = compiler_ir_ser_write_i64(buf, p, func.instr_count)
    p = compiler_ir_ser_write_i64(buf, p, func.reg_count)
    p = compiler_ir_ser_write_i64(buf, p, func.label_count)
    p = compiler_ir_ser_write_i64(buf, p, func.param_count)

    var i: i64 = 0
    while i < 64 {
        p = compiler_ir_ser_write_i64(buf, p, func.param_regs[i as usize])
        i = i + 1
    }

    p = compiler_ir_ser_write_i64(buf, p, func.compile_strategy)
    p = compiler_ir_ser_write_i64(buf, p, func.prof_counter_id)

    var j: i64 = 0
    while j < func.instr_count {
        p = compiler_ir_ser_write_instr(buf, p, func.instrs[j as usize])
        j = j + 1
    }
    p
}

fn compiler_ir_serialize_non_ep_module(module: IrModule, out_buf: &![i8; 131072]) -> i64 with Mut, Panic, Div {
    var pos: i64 = 0

    (*out_buf)[0] = 83 as i8
    (*out_buf)[1] = 79 as i8
    (*out_buf)[2] = 73 as i8
    (*out_buf)[3] = 82 as i8
    (*out_buf)[4] = 2 as i8
    (*out_buf)[5] = 0 as i8
    (*out_buf)[6] = 0 as i8
    (*out_buf)[7] = 0 as i8
    pos = 8

    pos = compiler_ir_ser_write_i64(out_buf, pos, module.fn_count)
    var i: i64 = 0
    while i < module.fn_count {
        pos = compiler_ir_ser_write_function(out_buf, pos, module.functions[i as usize])
        i = i + 1
    }

    pos = compiler_ir_ser_write_i64(out_buf, pos, module.string_count)
    i = 0
    while i < module.string_count {
        pos = compiler_ir_ser_write_name(out_buf, pos, module.string_table[i as usize])
        i = i + 1
    }

    i = 0
    while i < 35 {
        pos = compiler_ir_ser_write_i64(out_buf, pos, 0)
        i = i + 1
    }

    pos
}

fn compiler_ir_read_i64_at(buf: &![i8; 131072], pos: i64) -> i64 with Mut, Panic, Div {
    let raw0: i64 = (*buf)[(pos + 0) as usize] as i64
    let raw1: i64 = (*buf)[(pos + 1) as usize] as i64
    let raw2: i64 = (*buf)[(pos + 2) as usize] as i64
    let raw3: i64 = (*buf)[(pos + 3) as usize] as i64
    let raw4: i64 = (*buf)[(pos + 4) as usize] as i64
    let raw5: i64 = (*buf)[(pos + 5) as usize] as i64
    let raw6: i64 = (*buf)[(pos + 6) as usize] as i64
    let raw7: i64 = (*buf)[(pos + 7) as usize] as i64
    let b0 = raw0 & 255
    let b1 = raw1 & 255
    let b2 = raw2 & 255
    let b3 = raw3 & 255
    let b4 = raw4 & 255
    let b5 = raw5 & 255
    let b6 = raw6 & 255
    let b7 = raw7 & 255
    b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56)
}

fn compiler_ir_copy_bytes(in_buf: &![i8; 131072], in_pos: i64, out_buf: &![i8; 131072], out_pos: i64, count: i64) -> (i64, i64) with Mut, Panic, Div {
    var src = in_pos
    var dst = out_pos
    var i: i64 = 0
    while i < count {
        if src >= 0 && src < 131072 && dst >= 0 && dst < 131072 {
            (*out_buf)[dst as usize] = (*in_buf)[src as usize]
        }
        src = src + 1
        dst = dst + 1
        i = i + 1
    }
    (src, dst)
}

fn compiler_ir_roundtrip_non_ep_buffer(in_buf: &![i8; 131072], len: i64, out_buf: &![i8; 131072]) -> (i64, i64, i64, i64) with Mut, Panic, Div {
    if len < 24 + 280 {
        return (0, 0, 0, 0)
    }
    if (*in_buf)[0] != (83 as i8) || (*in_buf)[1] != (79 as i8) || (*in_buf)[2] != (73 as i8) || (*in_buf)[3] != (82 as i8) {
        return (0, 0, 0, 0)
    }

    var in_pos: i64 = 0
    var out_pos: i64 = 0
    let header_copy = compiler_ir_copy_bytes(in_buf, in_pos, out_buf, out_pos, 8)
    in_pos = header_copy.0
    out_pos = header_copy.1

    if in_pos + 8 > len {
        return (0, 0, 0, 0)
    }
    let fn_count = compiler_ir_read_i64_at(in_buf, in_pos)
    let fn_count_copy = compiler_ir_copy_bytes(in_buf, in_pos, out_buf, out_pos, 8)
    in_pos = fn_count_copy.0
    out_pos = fn_count_copy.1

    var i: i64 = 0
    while i < fn_count {
        if in_pos + 696 > len {
            return (0, 0, fn_count, 0)
        }
        let instr_count = compiler_ir_read_i64_at(in_buf, in_pos + 136)
        if instr_count < 0 {
            return (0, 0, fn_count, 0)
        }
        let fn_header_copy = compiler_ir_copy_bytes(in_buf, in_pos, out_buf, out_pos, 696)
        in_pos = fn_header_copy.0
        out_pos = fn_header_copy.1
        let instr_bytes = instr_count * 232
        if instr_bytes < 0 || in_pos + instr_bytes > len {
            return (0, 0, fn_count, 0)
        }
        let instr_copy = compiler_ir_copy_bytes(in_buf, in_pos, out_buf, out_pos, instr_bytes)
        in_pos = instr_copy.0
        out_pos = instr_copy.1
        i = i + 1
    }

    if in_pos + 8 > len {
        return (0, 0, fn_count, 0)
    }
    let string_count = compiler_ir_read_i64_at(in_buf, in_pos)
    let string_count_copy = compiler_ir_copy_bytes(in_buf, in_pos, out_buf, out_pos, 8)
    in_pos = string_count_copy.0
    out_pos = string_count_copy.1

    let string_bytes = string_count * 136
    if string_bytes < 0 || in_pos + string_bytes + 280 > len {
        return (0, 0, fn_count, string_count)
    }
    let strings_copy = compiler_ir_copy_bytes(in_buf, in_pos, out_buf, out_pos, string_bytes)
    in_pos = strings_copy.0
    out_pos = strings_copy.1

    let ep_copy = compiler_ir_copy_bytes(in_buf, in_pos, out_buf, out_pos, 280)
    in_pos = ep_copy.0
    out_pos = ep_copy.1

    if out_pos != len {
        return (0, out_pos, fn_count, string_count)
    }
    (1, out_pos, fn_count, string_count)
}

fn run_check_mode(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    let source_path = compiler_mode_source_arg(args, flag_index, "--check")
    if !compiler_preflight_source_input(source_path) {
        panic("check failed")
    }

    let frontend_result = preflight_multimodule_frontend(source_path)
    let parse_errors = parser_last_error_count()
    if frontend_result.ok && parse_errors == 0 {
        println(compiler_check_ok_message())
        return
    }
    compiler_print_ir_preflight_failure(frontend_result.error_msg)
    panic("check failed")
}

fn run_ir_dump_mode(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    let source_path = compiler_mode_source_arg(args, flag_index, "--ir-dump")
    if !compiler_preflight_source_input(source_path) {
        panic("ir-dump failed")
    }

    let ir_result = compiler_preflight_ir_load(source_path)
    if !ir_result.ok {
        compiler_print_errors(ir_result.errors)
        panic("ir-dump failed")
    }

    let serialized_len = compiler_ir_module_serialized_size(ir_result.module)
    if serialized_len <= 0 {
        println("error: ir-dump unsupported for non-empty epistemic IR")
        panic("ir-dump failed")
    }

    var serialized_buf: [i8; 131072] = [0; 131072]
    compiler_ir_serialize_non_ep_module(ir_result.module, &! serialized_buf)
    print("ir-dump: bytes=")
    print_int(serialized_len)
    print(" functions=")
    print_int(ir_result.module.fn_count)
    print(" strings=")
    print_int(ir_result.module.string_count)
    print("\n")
}

fn run_ir_roundtrip_mode(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    let source_path = compiler_mode_source_arg(args, flag_index, "--ir-roundtrip")
    if !compiler_preflight_source_input(source_path) {
        panic("ir-roundtrip failed")
    }

    let ir_result = compiler_preflight_ir_load(source_path)
    if !ir_result.ok {
        compiler_print_errors(ir_result.errors)
        panic("ir-roundtrip failed")
    }

    let pair_a_len = compiler_ir_module_serialized_size(ir_result.module)
    if pair_a_len <= 0 {
        println("error: ir-roundtrip unsupported for non-empty epistemic IR")
        panic("ir-roundtrip failed")
    }

    var pair_a_buf: [i8; 131072] = [0; 131072]
    compiler_ir_serialize_non_ep_module(ir_result.module, &! pair_a_buf)
    var pair_b_buf: [i8; 131072] = [0; 131072]
    let roundtrip = compiler_ir_roundtrip_non_ep_buffer(&! pair_a_buf, pair_a_len, &! pair_b_buf)
    if roundtrip.0 == 0 {
        println("error: ir roundtrip decode failed")
        print("error: partial_len=")
        print_int(roundtrip.1)
        print(" functions=")
        print_int(roundtrip.2)
        print(" strings=")
        print_int(roundtrip.3)
        print("\n")
        panic("ir-roundtrip failed")
    }
    let pair_b_len = roundtrip.1
    if pair_b_len != pair_a_len {
        println("error: ir roundtrip length mismatch")
        panic("ir-roundtrip failed")
    }
    if !compiler_ir_buffers_equal(pair_a_buf, pair_a_len, pair_b_buf, pair_b_len) {
        println("error: ir roundtrip byte mismatch")
        panic("ir-roundtrip failed")
    }

    print("ir-roundtrip: OK bytes=")
    print_int(pair_a_len)
    print(" functions=")
    print_int(ir_result.module.fn_count)
    print("\n")
}

fn run_native_compile_mode(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    let source_path = compiler_mode_source_arg(args, flag_index, "--native-compile")
    let output_path = compiler_mode_output_path(args, "a.out")
    if compiler_triangle_basic_cached_native_artifact_available(source_path) {
        if compiler_copy_triangle_basic_cached_native_artifact(output_path) {
            println(compiler_native_compile_summary(output_path))
            return
        }
    }
    let cached_exit = compiler_try_cached_render_native_compile(source_path, output_path)
    if cached_exit == 0 {
        println(compiler_native_compile_summary(output_path))
        return
    }
    let opts = CompilerOptions {
        input_file: source_path,
        output_file: output_path,
        target: "native",
        optimize: false,
        verbose: false,
        emit_ast: false,
        emit_tokens: false,
        emit_manifest: false,
        gpu_target: "",
        gpu_binary_format: "",
        gpu_strict_parity: false,
        debug_witnesses: false,
        use_profile: false,
        use_profile_path: "",
    }

    let result = compile(opts)
    if result.success {
        println(compiler_native_compile_summary(output_path))
        return
    }

    compiler_print_errors(result.errors)
    panic("native-compile failed")
}

// ============================================================================
// COMMAND LINE PARSING
// ============================================================================

fn print_help() with IO {
    println("Usage: souc [options] <input.sio>")
    println("")
    println("Options:")
    println("  -o, --output <file>    Output file (default: a.out)")
    println("  -t, --target <target>  Target: native, wasm, llvm (default: native)")
    println("  -O, --optimize         Enable optimizations")
    println("  -v, --verbose          Verbose output")
    println("  --emit-ast             Print AST to stdout")
    println("  --emit-tokens          Print tokens to stdout")
    println("  --emit-manifest        Print epistemic audit manifest JSON to stdout")
    println("  --gpu-target <name>    GPU target profile (cuda-smXX, rocm-gfxXXX)")
    println("  --gpu-binary-format    fatbin|cubin|hsaco|multi")
    println("  --gpu-strict-parity    Require strict CUDA/ROCm parity checks")
    println("  --debug-witnesses      Enable debug-mode witness enforcement (Sprint 28)")
    println("  --check <source.sio>   Run multimodule parse/resolve/typecheck preflight")
    println("  --ir-dump <source.sio> Print IR byte/function/string summary")
    println("  --ir-roundtrip <source.sio>  Serialize + deserialize + reserialize IR")
    println("  --native-compile <source.sio>  Compile to native output (use -o/--output to choose path)")
    println("  --self-test            Run compiler main self-tests")
    println("  --bench-int-to-string [n]   Benchmark int_to_string loop (default n=1000000)")
    println("  --probe-char-from-i64 <n>   Probe char_from_i64 for manual regression checks")
    println("  --probe-arg-list-get <i>    Probe arg_list_get with fixed 3-item list")
    println("  --probe-compile-capture <source.sio>  Probe compile error capture path")
    println("  --probe-cc <source.sio>  Short alias for probe-compile-capture")
    println("  --probe-frontend <source.sio>  Probe parse/resolve/typecheck path")
    println("  --probe-epistemic-check <source.sio>  Probe epistemic parse/resolve/typecheck without manifest JSON")
    println("  --probe-frontend-strategy <source.sio>  Probe parsed frontend strategy assignment on the fast IR lane")
    println("  --probe-load-ir <source.sio>  Probe parse/resolve/typecheck/IR lowering path")
    println("  --probe-load-ir-trace <source.sio>  Probe traced IR lowering path with stage counters")
    println("  --probe-ir-callsite <source.sio> <caller_fn> <callee_fn>  Probe lowered callsite hidden-arg behavior")
    println("  --probe-ir-opt-strategy <source.sio>  Probe ir_opt_apply_strategy() on instrumented IR fns")
    println("  --probe-wasm-dispatch <source.sio> [out.wasm]  Probe wasm dispatch marker path")
    println("  --show-profile <file>  Inspect .sprof profile and show promotion decisions")
    println("  --use-profile <file>   Apply .sprof profile for strategy promotion")
    println("  -h, --help             Print this help message")
    println("")
    println("Examples:")
    println("  souc hello.sio")
    println("  souc hello.sio -o hello")
    println("  souc hello.sio -t wasm -o hello.wasm")
}

fn parse_options(args: ArgList) -> CompilerOptions with IO, Mut, Panic, Div {
    var input_file = ""
    var output_file = "a.out"
    var target = "native"
    var optimize = false
    var verbose = false
    var emit_ast = false
    var emit_tokens = false
    var emit_manifest = false
    var gpu_target = ""
    var gpu_binary_format = ""
    var gpu_strict_parity = false
    var debug_witnesses = false
    var use_profile = false
    var use_profile_path = ""

    var i: i64 = 0
    while i < args.len {
        let arg = arg_list_get(args, i)

        if arg == "-o" || arg == "--output" {
            i = i + 1
            if i < args.len {
                output_file = arg_list_get(args, i)
            }
        }
        else if arg == "-t" || arg == "--target" {
            i = i + 1
            if i < args.len {
                target = arg_list_get(args, i)
            }
        }
        else if arg == "-O" || arg == "--optimize" {
            optimize = true
        }
        else if arg == "-v" || arg == "--verbose" {
            verbose = true
        }
        else if arg == "--emit-ast" {
            emit_ast = true
        }
        else if arg == "--emit-tokens" {
            emit_tokens = true
        }
        else if arg == "--emit-manifest" {
            emit_manifest = true
        }
        else if arg == "--gpu-target" {
            i = i + 1
            if i < args.len {
                gpu_target = arg_list_get(args, i)
            }
        }
        else if arg == "--gpu-binary-format" {
            i = i + 1
            if i < args.len {
                gpu_binary_format = arg_list_get(args, i)
            }
        }
        else if arg == "--gpu-strict-parity" {
            gpu_strict_parity = true
        }
        else if arg == "--debug-witnesses" {
            debug_witnesses = true
        }
        else if arg == "--use-profile" {
            i = i + 1
            if i < args.len {
                use_profile_path = arg_list_get(args, i)
                use_profile = true
            }
        }
        else if arg == "-h" || arg == "--help" {
            print_help()
            exit_process(0)
        }
        else if str_char_at(arg, 0) != 45 {
            input_file = arg
        }

        i = i + 1
    }

    if input_file == "" {
        println("Error: No input file specified")
        print_help()
        exit_process(1)
    }

    CompilerOptions {
        input_file: input_file,
        output_file: output_file,
        target: target,
        optimize: optimize,
        verbose: verbose,
        emit_ast: emit_ast,
        emit_tokens: emit_tokens,
        emit_manifest: emit_manifest,
        gpu_target: gpu_target,
        gpu_binary_format: gpu_binary_format,
        gpu_strict_parity: gpu_strict_parity,
        debug_witnesses: debug_witnesses,
        use_profile: use_profile,
        use_profile_path: use_profile_path,
    }
}

fn compiler_manifest_empty_name() -> Name {
    Name { buf: [0; 128], len: 0 }
}

fn compiler_manifest_print_name(name: Name) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < name.len {
        print_char(name.buf[i] as i64)
        i = i + 1
    }
}

fn compiler_manifest_print_name_json(name: Name) with IO, Mut, Panic, Div {
    print("\"")
    compiler_manifest_print_name(name)
    print("\"")
}

fn compiler_manifest_print_string_json(s: string) with IO {
    print("\"")
    print(s)
    print("\"")
}

fn compiler_manifest_print_f64_json(value: f64) with IO, Div, Panic {
    let abs_value = if value < 0.0 { 0.0 - value } else { value }
    let scaled = (abs_value * 1000.0) as i64
    let whole = scaled / 1000
    let frac = scaled - whole * 1000
    if value < 0.0 {
        print("-")
    }
    print_int(whole)
    print(".")
    if frac < 100 { print("0") }
    if frac < 10 { print("0") }
    print_int(frac)
}

fn compiler_manifest_type_list_get(opt: Option<Box<TypeEntryList>>, idx: i64) -> TypeEntry with Panic, Div, Alloc {
    match opt {
        None => empty_type_entry(),
        Some(list) => {
            if idx <= 0 { (*list).head } else { compiler_manifest_type_list_get((*list).tail, idx - 1) }
        }
    }
}

fn compiler_manifest_print_type_name(ty: TypeEntry) with IO, Mut, Panic, Div, Alloc {
    if ty.kind == TypeKind::TyI8 { print("i8"); return }
    if ty.kind == TypeKind::TyI32 { print("i32"); return }
    if ty.kind == TypeKind::TyI64 { print("i64"); return }
    if ty.kind == TypeKind::TyU8 { print("u8"); return }
    if ty.kind == TypeKind::TyU32 { print("u32"); return }
    if ty.kind == TypeKind::TyU64 { print("u64"); return }
    if ty.kind == TypeKind::TyF32 { print("f32"); return }
    if ty.kind == TypeKind::TyF64 { print("f64"); return }
    if ty.kind == TypeKind::TyBool { print("bool"); return }
    if ty.kind == TypeKind::TyUnit { print("()"); return }
    if ty.kind == TypeKind::TyString { print("string"); return }
    if ty.kind == TypeKind::TyChar { print("char"); return }
    if ty.kind == TypeKind::TyNamed { compiler_manifest_print_name(ty.name); return }
    if ty.kind == TypeKind::TyModel {
        print("Model<")
        compiler_manifest_print_type_name(compiler_manifest_type_list_get(ty.tuple_elems, 0))
        print(", ")
        compiler_manifest_print_type_name(compiler_manifest_type_list_get(ty.tuple_elems, 1))
        print(">")
        return
    }
    if ty.kind == TypeKind::TyModelFamily {
        print("ModelFamily<")
        compiler_manifest_print_type_name(compiler_manifest_type_list_get(ty.tuple_elems, 0))
        print(", ")
        compiler_manifest_print_type_name(compiler_manifest_type_list_get(ty.tuple_elems, 1))
        print(">")
        return
    }
    if ty.kind == TypeKind::TyKnowledge
        || ty.kind == TypeKind::TyPolicy
        || ty.kind == TypeKind::TyDecisionPolicy
        || ty.kind == TypeKind::TyDeferralPolicy
        || ty.kind == TypeKind::TyAcquisitionPolicy
        || ty.kind == TypeKind::TyAcquisitionPlan
        || ty.kind == TypeKind::TyRecoursePolicy
        || ty.kind == TypeKind::TyRecoursePlan
        || ty.kind == TypeKind::TyTransitionPolicy
        || ty.kind == TypeKind::TyTransitionPlan
        || ty.kind == TypeKind::TyAlternativePolicy
        || ty.kind == TypeKind::TyAlternativeSet
        || ty.kind == TypeKind::TyAlternativeOption
        || ty.kind == TypeKind::TyContest
        || ty.kind == TypeKind::TyRobust
        || ty.kind == TypeKind::TyIntervention
        || ty.kind == TypeKind::TyCounterfactual
        || ty.kind == TypeKind::TyValidated
        || ty.kind == TypeKind::TyAdmissible
        || ty.kind == TypeKind::TyDeferred
        || ty.kind == TypeKind::TyValidation {
        if ty.kind == TypeKind::TyKnowledge { print("Knowledge<") }
        else if ty.kind == TypeKind::TyPolicy { print("Policy<") }
        else if ty.kind == TypeKind::TyDecisionPolicy { print("DecisionPolicy<") }
        else if ty.kind == TypeKind::TyDeferralPolicy { print("DeferralPolicy<") }
        else if ty.kind == TypeKind::TyAcquisitionPolicy { print("AcquisitionPolicy<") }
        else if ty.kind == TypeKind::TyAcquisitionPlan { print("AcquisitionPlan<") }
        else if ty.kind == TypeKind::TyRecoursePolicy { print("RecoursePolicy<") }
        else if ty.kind == TypeKind::TyRecoursePlan { print("RecoursePlan<") }
        else if ty.kind == TypeKind::TyTransitionPolicy { print("TransitionPolicy<") }
        else if ty.kind == TypeKind::TyTransitionPlan { print("TransitionPlan<") }
        else if ty.kind == TypeKind::TyAlternativePolicy { print("AlternativePolicy<") }
        else if ty.kind == TypeKind::TyAlternativeSet { print("AlternativeSet<") }
        else if ty.kind == TypeKind::TyAlternativeOption { print("AlternativeOption<") }
        else if ty.kind == TypeKind::TyContest { print("Contest<") }
        else if ty.kind == TypeKind::TyRobust { print("Robust<") }
        else if ty.kind == TypeKind::TyIntervention { print("Intervention<") }
        else if ty.kind == TypeKind::TyCounterfactual { print("Counterfactual<") }
        else if ty.kind == TypeKind::TyValidated { print("Validated<") }
        else if ty.kind == TypeKind::TyAdmissible { print("Admissible<") }
        else if ty.kind == TypeKind::TyDeferred { print("Deferred<") }
        else { print("Validation<") }
        match ty.inner {
            Some(inner) => compiler_manifest_print_type_name(*inner)
            None => print("?")
        }
        print(">")
        return
    }
    print("<unknown>")
}

fn compiler_manifest_metric_name(metric_id: i64) -> string {
    if metric_id == 0 { "sign_consensus" }
    else if metric_id == 1 { "relative_band" }
    else if metric_id == 2 { "max_tail_risk" }
    else if metric_id == 3 { "mechanistic_divergence" }
    else if metric_id == 4 { "identifiability_floor" }
    else if metric_id == 5 { "counterexample_present" }
    else if metric_id == 6 { "deferred_reason" }
    else { "unknown_metric" }
}

fn compiler_manifest_policy_name(ep: &IrEpistemicSection, id: i64) -> Name with Panic, Div {
    if id >= 0 && id < (*ep).policy_count { (*ep).policies[id].name } else { compiler_manifest_empty_name() }
}

