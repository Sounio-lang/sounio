}

// T126: E-graph capacity constants are at expected magnitudes.
fn compiler_main_test_egraph_capacity_constants() -> bool {
    EG_MAX_NODES == 16384 && EG_MAX_CLASSES == 8192 && EG_MAX_RULES == 256 && EG_MAX_ITERATIONS == 30
}

// T127: ocp_binop_to_eg_op maps OpAdd → EG_OP_ADD and OpMul → EG_OP_MUL.
fn compiler_main_test_ocp_binop_to_eg_op_add() -> bool {
