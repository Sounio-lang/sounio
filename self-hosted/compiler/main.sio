// T49: ir_slot_fits_disp8 returns true for offset -8 (vreg 0)
fn compiler_main_test_disp8_fits_vreg0() -> bool {
    ir_slot_fits_disp8(-8)
}

// T50: ir_slot_fits_disp8 returns true for offset -128 (vreg 15, boundary)
fn compiler_main_test_disp8_fits_boundary() -> bool {
    ir_slot_fits_disp8(-128)
}

// T51: ir_slot_fits_disp8 returns false for offset -136 (vreg 16, beyond disp8)
fn compiler_main_test_disp8_no_fit_vreg16() -> bool {
    !ir_slot_fits_disp8(-136)
}

// T52: emit_load_rbp_disp8_rax emits 4 bytes: 0x48 0x8B 0x45 0xF8 (disp=-8)
fn compiler_main_test_disp8_load_bytes() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = emit_load_rbp_disp8_rax(buf, -8)
    if buf.len != 4 { return false }
    if buf.bytes[0 as usize] != 0x48 as i8 { return false }
    if buf.bytes[1 as usize] != 0x8b as i8 { return false }
    if buf.bytes[2 as usize] != 0x45 as i8 { return false }
    if buf.bytes[3 as usize] != 0xf8 as i8 { return false }  // low8(-8) = 0xF8
    true
}

// T53: emit_store_rax_rbp_disp8 emits 4 bytes: 0x48 0x89 0x45 0xF0 (disp=-16)
fn compiler_main_test_disp8_store_bytes() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = emit_store_rax_rbp_disp8(buf, -16)
    if buf.len != 4 { return false }
    if buf.bytes[0 as usize] != 0x48 as i8 { return false }
    if buf.bytes[1 as usize] != 0x89 as i8 { return false }
    if buf.bytes[2 as usize] != 0x45 as i8 { return false }
    if buf.bytes[3 as usize] != 0xf0 as i8 { return false }  // low8(-16) = 0xF0
    true
}

// T54: emit_load_rbp_disp32_rax still emits 7 bytes (regression)
fn compiler_main_test_disp32_load_len() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = emit_load_rbp_disp32_rax(buf, -8)
    buf.len == 7
}

// T55: emit_store_rax_rbp_disp32 still emits 7 bytes (regression)
fn compiler_main_test_disp32_store_len() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = emit_store_rax_rbp_disp32(buf, -8)
    buf.len == 7
}

// T56: ir_slot_fits_disp8 agrees with ir_slot_offset for vreg boundary (15 fits, 16 doesn't)
fn compiler_main_test_disp8_slot_boundary() -> bool {
    if !ir_slot_fits_disp8(ir_slot_offset(15)) { return false }
    if ir_slot_fits_disp8(ir_slot_offset(16)) { return false }
    true
}

// T57: native v2 runtime context layout is language-visible and deopt-ready
fn compiler_main_test_native_v2_runtime_context_contract() -> bool with Mut, Panic, Div {
    let layout = native_v2_runtime_context_layout()
    if !layout.language_visible { return false }
    if !layout.tracing_gc { return false }
    if !layout.precise_stack_maps { return false }
    if !layout.safepoints { return false }
    if !layout.deopt_enabled { return false }
    if !layout.osr_enabled { return false }
    if native_v2_runtime_context_group_count() != 7 { return false }
    if !str_eq(native_v2_runtime_context_group_name(0), "gc_heap") { return false }
    if !str_eq(native_v2_runtime_context_group_name(6), "provenance") { return false }
    native_v2_runtime_context_total_fields(layout) >= 21
}

// T58: native v2 x86 policy exposes reserved + allocatable pools explicitly
fn compiler_main_test_native_v2_target_policy_x86() -> bool with IO, Mut, Panic, Div {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let summary = native_v2_target_policy_summary(spec)
    if !native_v2_target_contract_supported(spec) { return false }
    if summary.reserved_count != 3 { return false }
    if summary.allocatable_count != 4 { return false }
    if summary.scratch_count != 5 { return false }
    if !summary.emitter_ready { return false }
    if !str_eq(native_v2_target_policy_group_name(spec, NATIVE_V2_POLICY_GROUP_RESERVED(), 2), "rbx") { return false }
    if !str_eq(native_v2_target_policy_group_name(spec, NATIVE_V2_POLICY_GROUP_ALLOCATABLE(), 0), "r12") { return false }
    if !str_eq(native_v2_target_policy_group_name(spec, NATIVE_V2_POLICY_GROUP_RETURNS(), 0), "rax") { return false }
    true
}

// T59: native v2 aarch64 policy is present for the full reserved/allocatable contract
fn compiler_main_test_native_v2_target_policy_aarch64() -> bool with IO, Mut, Panic, Div {
    let spec = native_resolve_target("aarch64-macos", "auto", true)
    let summary = native_v2_target_policy_summary(spec)
    if !native_v2_target_contract_supported(spec) { return false }
    if summary.reserved_count != 4 { return false }
    if summary.allocatable_count != 10 { return false }
    if summary.arg_count != 8 { return false }
    if summary.emitter_ready { return false }
    if !str_eq(native_v2_target_policy_group_name(spec, NATIVE_V2_POLICY_GROUP_RESERVED(), 3), "x18") { return false }
    if !str_eq(native_v2_target_policy_group_name(spec, NATIVE_V2_POLICY_GROUP_ALLOCATABLE(), 0), "x19") { return false }
    if !str_eq(native_v2_target_policy_group_name(spec, NATIVE_V2_POLICY_GROUP_ALLOCATABLE(), 9), "x28") { return false }
    if !str_eq(native_v2_target_policy_group_name(spec, NATIVE_V2_POLICY_GROUP_ARGS(), 0), "x0") { return false }
    true
}

// T60: native v2 machine module reports tiering + deopt substrate
fn compiler_main_test_native_v2_machine_shadow_module() -> bool with IO, Mut, Panic, Div {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let module = compiler_main_make_native_v2_scalar_module(7)
    let machine = native_v2_shadow_machine_module(&module, spec)
    if machine.fn_count != 1 { return false }
    if machine.ir_instr_count != 2 { return false }
    if machine.machine_instr_count <= machine.ir_instr_count { return false }
    if !machine.active { return false }
    if machine.target_count != 1 { return false }
    if !str_eq(machine.coverage, "scalar_core") { return false }
    if !machine.fail_closed { return false }
    if machine.legacy_fallback { return false }
    if machine.optimized_tier_count != 2 { return false }
    if !machine.has_runtime_context { return false }
    if !machine.supports_stack_maps { return false }
    if !machine.supports_deopt { return false }
    if !machine.supports_osr { return false }
    machine.target_arch_id == ARCH_X86_64()
}

// T61: native v2 contract writer emits a JSON artifact
fn compiler_main_test_native_v2_shadow_contract_write() -> bool with IO, Mut, Panic, Div {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let path = "artifacts/omega/native_backend_v2_contract.selftest.json"
    let module = compiler_main_make_native_v2_scalar_module(11)
    if !native_v2_write_contract(path, &module, spec, true, ERR_OK(), "selftest") { return false }
    let size = file_size(path)
    if size <= 0 { return false }
    let data = read_file(path)
    data[0 as usize] == (123 as i8)
}

// ============================================================================
// Sprint 64: Compact frame sizing self-tests (T62-T69)
// ============================================================================

// T62: nc_min_frame_size returns 0 for empty function (reg_count=0)
fn compiler_main_test_frame_trim_empty() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    var func = ir_empty_function()
    func.reg_count = 0
    nc_min_frame_size(nc, func) == 0
}

// T63: nc_min_frame_size returns 0 when all vregs preg-allocated
fn compiler_main_test_frame_trim_all_preg() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    nc.vreg_to_preg[0 as usize] = 15   // r15
    nc.vreg_to_preg[1 as usize] = 14   // r14
    var func = ir_empty_function()
    func.reg_count = 2
    nc_min_frame_size(nc, func) == 0
}

// T64: nc_min_frame_size returns 16 for 1 spilled vreg at index 0 (align16(8)=16)
fn compiler_main_test_frame_trim_one_spill() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    nc.vreg_to_preg[0 as usize] = -1   // RA_SPILLED
    var func = ir_empty_function()
    func.reg_count = 1
    nc_min_frame_size(nc, func) == 16
}

// T65: nc_min_frame_size returns 32 when highest stack vreg is index 3
fn compiler_main_test_frame_trim_vreg3_stack() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    nc.vreg_to_preg[0 as usize] = 15   // preg-alloc
    nc.vreg_to_preg[1 as usize] = 14   // preg-alloc
    nc.vreg_to_preg[2 as usize] = 13   // preg-alloc
    nc.vreg_to_preg[3 as usize] = -1   // RA_SPILLED (highest stack vreg)
    var func = ir_empty_function()
    func.reg_count = 4
    nc_min_frame_size(nc, func) == 32
}

// T66: nc_min_frame_size returns 16 when middle vreg is spilled, higher is preg-alloc
fn compiler_main_test_frame_trim_middle_spill() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    nc.vreg_to_preg[0 as usize] = 15   // preg-alloc
    nc.vreg_to_preg[1 as usize] = -1   // RA_SPILLED
    nc.vreg_to_preg[2 as usize] = 14   // preg-alloc (higher index, no slot needed)
    var func = ir_empty_function()
    func.reg_count = 3
    nc_min_frame_size(nc, func) == 16
}

// T67: nc_min_frame_size returns 0 for 4 preg-alloc vregs (all 4 callee-saved registers used)
fn compiler_main_test_frame_trim_four_preg() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    nc.vreg_to_preg[0 as usize] = 15   // r15
    nc.vreg_to_preg[1 as usize] = 14   // r14
    nc.vreg_to_preg[2 as usize] = 13   // r13
    nc.vreg_to_preg[3 as usize] = 12   // r12
    var func = ir_empty_function()
    func.reg_count = 4
    nc_min_frame_size(nc, func) == 0
}

// T68: nc_min_frame_size returns 48 for spilled vreg at index 4 (align16(40)=48)
fn compiler_main_test_frame_trim_vreg4_spill() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    nc.vreg_to_preg[0 as usize] = 15
    nc.vreg_to_preg[1 as usize] = 14
    nc.vreg_to_preg[2 as usize] = 13
    nc.vreg_to_preg[3 as usize] = 12
    nc.vreg_to_preg[4 as usize] = -1   // RA_SPILLED
    var func = ir_empty_function()
    func.reg_count = 5
    nc_min_frame_size(nc, func) == 48
}

// T69: nc_min_frame_size handles param vreg (preg=-2 RA_UNASSIGNED) as needing stack slot
fn compiler_main_test_frame_trim_param_vreg() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    nc.vreg_to_preg[0 as usize] = -2   // RA_UNASSIGNED (param)
    nc.vreg_to_preg[1 as usize] = 15   // preg-alloc
    var func = ir_empty_function()
    func.reg_count = 2
    nc_min_frame_size(nc, func) == 16
}

// T70: used allocatable preg mask tracks only r12-r15 assignments
fn compiler_main_test_used_allocatable_preg_mask() -> bool {
    var nc = compiler_new()
    nc.vreg_to_preg[0 as usize] = 15
    nc.vreg_to_preg[1 as usize] = 12
    nc.vreg_to_preg[2 as usize] = -1
    nc.vreg_to_preg[3 as usize] = 0
    nc_used_allocatable_preg_mask(nc, 4) == (X86_ALLOCATABLE_R12_MASK() | X86_ALLOCATABLE_R15_MASK())
}

// T71: odd allocatable-save counts add an 8-byte alignment pad before calls
fn compiler_main_test_frame_align_for_saved_pregs() -> bool with Mut, Panic {
    if x86_align_frame_size_for_calls(0, X86_ALLOCATABLE_R15_MASK()) != 8 { return false }
    if x86_align_frame_size_for_calls(16, X86_ALLOCATABLE_R15_MASK() | X86_ALLOCATABLE_R14_MASK()) != 16 { return false }
    true
}

// T72: native v2 x86 contract publishes an explicit allocation order
fn compiler_main_test_native_v2_x86_allocation_order_contract() -> bool with IO, Mut, Panic, Div {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    if native_v2_target_policy_group_count(spec, NATIVE_V2_POLICY_GROUP_ALLOCATION_ORDER()) != 4 { return false }
    if !str_eq(native_v2_target_policy_group_name(spec, NATIVE_V2_POLICY_GROUP_ALLOCATION_ORDER(), 0), "r15") { return false }
    if !str_eq(native_v2_target_policy_group_name(spec, NATIVE_V2_POLICY_GROUP_ALLOCATION_ORDER(), 3), "r12") { return false }
    true
}

// T73: lowering preg mapping is driven by the shared x86 allocation order
fn compiler_main_test_x86_allocation_order_drives_lowering() -> bool {
    if preg_to_x86_reg(0) != native_target_policy_x86_allocation_order_reg_id(0) { return false }
    if preg_to_x86_reg(1) != native_target_policy_x86_allocation_order_reg_id(1) { return false }
    if preg_to_x86_reg(3) != native_target_policy_x86_allocation_order_reg_id(3) { return false }
    true
}

fn compiler_main_make_native_v2_scalar_module(ret_value: i64) -> IrModule {
    var module = ir_empty_module()
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.instrs[0] = ir_load_imm(0, ret_value)
    func.instrs[1] = ir_return(0)
    func.instr_count = 2
    func.reg_count = 1
    module.functions[0] = func
    module.fn_count = 1
    module
}

fn compiler_main_make_native_v2_call_module() -> IrModule with Mut, Panic, Alloc {
    var module = ir_empty_module()

    var helper = ir_empty_function()
    helper.name = ir_name_from_bytes(104, 101, 108, 112, 4)
    helper.param_count = 1
    helper.param_regs[0] = 0
    helper.reg_count = 3
    helper.instrs[0] = ir_load_imm(1, 2)
    helper.instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    helper.instrs[2] = ir_return(2)
    helper.instr_count = 3
    module.functions[0] = helper

    var main_fn = ir_empty_function()
    main_fn.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    main_fn.reg_count = 2
    main_fn.instrs[0] = ir_load_imm(0, 3)
    main_fn.instrs[1] = ir_call(1, 0, helper.name, Some(Box::new(ir_reg_list_single(0))), 1)
    main_fn.instrs[2] = ir_return(1)
    main_fn.instr_count = 3
    module.functions[1] = main_fn

    module.fn_count = 2
    module
}

fn compiler_main_make_native_v2_control_module() -> IrModule {
    var module = ir_empty_module()
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.reg_count = 3
    func.label_count = 1
    func.instrs[0] = ir_load_imm(0, 1)
    func.instrs[1] = ir_branch_true(0, 0)
    func.instrs[2] = ir_load_imm(1, 0)
    func.instrs[3] = ir_return(1)
    func.instrs[4] = ir_label(0)
    func.instrs[5] = ir_load_imm(2, 1)
    func.instrs[6] = ir_return(2)
    func.instr_count = 7
    module.functions[0] = func
    module.fn_count = 1
    module
}

fn compiler_main_make_native_v2_unsupported_vector_module() -> IrModule {
    var module = ir_empty_module()
    var func = ir_empty_function()
    var instr = ir_instr_new(IrOpcode::IrVecAddF64)
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    instr.dst = 0
    instr.src1 = 1
    instr.src2 = 2
    instr.imm_i64 = 2
    func.instrs[0] = instr
    func.instrs[1] = ir_return(0)
    func.instr_count = 2
    func.reg_count = 3
    module.functions[0] = func
    module.fn_count = 1
    module
}

fn compiler_main_test_native_v2_machine_module_scalar_core() -> bool with Mut, Panic, Div, Alloc {
    let built = native_v2_build_machine_module(&compiler_main_make_native_v2_scalar_module(13), true)
    if !built.supported { return false }
    if !built.active { return false }
    if !str_eq(built.coverage, "scalar_core") { return false }
    if built.fn_count != 1 { return false }
    if built.target_count != 1 { return false }
    if built.total_machine_instr_count <= 0 { return false }
    if built.functions[0].blocks[0].instr_count <= 0 { return false }
    native_v2_machine_function_is_legal(built.functions[0])
}

fn compiler_main_test_native_v2_machine_function_legal() -> bool with Mut, Panic, Div, Alloc {
    let built = native_v2_build_machine_module(&compiler_main_make_native_v2_call_module(), true)
    if !built.supported { return false }
    if built.total_machine_instr_count <= built.total_ir_instr_count { return false }
    native_v2_machine_function_is_legal(built.functions[0]) && native_v2_machine_function_is_legal(built.functions[1])
}

fn compiler_main_test_native_v2_machine_regalloc_uses_shared_order() -> bool with Mut, Panic, Div, Alloc {
    var func = machine_function_new()
    func = machine_function_add_instr(func, native_v2_make_mov_imm(0, 5))
    func = machine_function_add_instr(func, native_v2_make_mov_imm(1, 8))
    func = machine_function_add_instr(func, native_v2_make_binop(0, 1, BinaryOp::OpAdd))
    func = machine_function_add_instr(func, native_v2_make_ret(0))

    let pair = native_v2_machine_ra_instrs(func)
    var state = liveness_compute_intervals(pair.0, pair.1)
    state = regalloc_linear_scan(state, native_target_policy_x86_allocation_order_count())

    var saw_slot0 = false
    var saw_slot1 = false
    var i: i64 = 0
    while i < state.count {
        let interval = state.intervals[i as usize]
        if interval.assigned_preg == 0 {
            saw_slot0 = true
        } else if interval.assigned_preg == 1 {
            saw_slot1 = true
        }
        i = i + 1
    }
    saw_slot0 && saw_slot1
}

fn compiler_main_test_native_v2_frame_uses_allocated_callee_saved_only() -> bool with Mut, Panic, Div {
    let preg_mask = X86_ALLOCATABLE_R15_MASK() | X86_ALLOCATABLE_R13_MASK()
    let prologue = emit_prologue_with_preg_mask(code_buffer_new(), 0, preg_mask)
    let epilogue = emit_epilogue_with_preg_mask(code_buffer_new(), preg_mask)
    if prologue.len != 8 { return false }
    if prologue.bytes[0 as usize] != (0x41 as i8) || prologue.bytes[1 as usize] != (0x57 as i8) { return false }
    if prologue.bytes[2 as usize] != (0x41 as i8) || prologue.bytes[3 as usize] != (0x55 as i8) { return false }
    if epilogue.len != 9 { return false }
    if epilogue.bytes[4 as usize] != (0x41 as i8) || epilogue.bytes[5 as usize] != (0x5D as i8) { return false }
    if epilogue.bytes[6 as usize] != (0x41 as i8) || epilogue.bytes[7 as usize] != (0x5F as i8) { return false }
    true
}

fn compiler_main_test_native_v2_compile_preview_scalar() -> bool with IO, Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let result = compile_native_v2_preview(&compiler_main_make_native_v2_scalar_module(13), spec)
    if !result.ok || result.format_id != FORMAT_ELF64() || result.len <= 64 { return false }
    io_write_native_binary("artifacts/omega/native_backend_v2_scalar_smoke.selftest.bin", result.bytes, result.len)
}

fn compiler_main_test_native_v2_compile_preview_call_control() -> bool with Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let call_result = compile_native_v2_preview(&compiler_main_make_native_v2_call_module(), spec)
    if !call_result.ok || call_result.len <= 64 { return false }
    let control_result = compile_native_v2_preview(&compiler_main_make_native_v2_control_module(), spec)
    control_result.ok && control_result.len > 64
}

fn compiler_main_test_native_v2_fail_closed_vector() -> bool with Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let result = compile_native_v2_preview(&compiler_main_make_native_v2_unsupported_vector_module(), spec)
    if result.ok { return false }
    if result.error_code != ERR_BACKEND_NOT_IMPLEMENTED() { return false }
    str_eq(result.error_msg, "native_v2_unsupported_opcode:vec_add_f64")
}

fn compiler_main_test_native_v2_contract_machine_ir_fields() -> bool with IO, Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let path = "artifacts/omega/native_backend_v2_contract.selftest.json"
    let module = compiler_main_make_native_v2_scalar_module(21)
    if !native_v2_write_contract(path, &module, spec, true, ERR_OK(), "selftest") { return false }
    let size = file_size(path)
    if size <= 0 { return false }
    let data = read_file(path)
    if data[0 as usize] != (123 as i8) { return false }
    if !compiler_bytes_contains(data, size, "\"active\":true") { return false }
    if !compiler_bytes_contains(data, size, "\"coverage\":\"scalar_core\"") { return false }
    if !compiler_bytes_contains(data, size, "\"fail_closed\":true") { return false }
    compiler_bytes_contains(data, size, "\"legacy_fallback\":false")
}

// ============================================================================
// Sprint 65: Peephole optimizer wiring (T74-T80)
// ============================================================================

// T74: self-move elimination — ph_opt_single removes mov rX, rX
fn compiler_main_test_ph_self_move_eliminated() -> bool {
    let mov_self = ph_instr_new(PH_MOV(), 5, 5, 0)
    let result = ph_opt_single(mov_self)
    result.opcode == PH_NOP()
}

// T75: identity-add elimination — ph_opt_single removes add rX, 0
fn compiler_main_test_ph_identity_add_eliminated() -> bool {
    let add_zero = ph_instr_imm(PH_ADD(), 3, 0)
    let result = ph_opt_single(add_zero)
    result.opcode == PH_NOP()
}

// T76: identity-sub elimination — ph_opt_single removes sub rX, 0
fn compiler_main_test_ph_identity_sub_eliminated() -> bool {
    let sub_zero = ph_instr_imm(PH_SUB(), 2, 0)
    let result = ph_opt_single(sub_zero)
    result.opcode == PH_NOP()
}

// T77: push/pop pair collapse — ph_opt_pair eliminates push rX; pop rX
fn compiler_main_test_ph_push_pop_pair_collapsed() -> bool {
    let push12 = ph_instr_new(PH_PUSH(), 12, PH_NO_REG(), 0)
    let pop12  = ph_instr_new(PH_POP(),  12, PH_NO_REG(), 0)
    let result = ph_opt_pair(push12, pop12)
    if result.optimized != 2 { return false }
    if result.instrs[0].opcode != PH_NOP() { return false }
    if result.instrs[1].opcode != PH_NOP() { return false }
    true
}

// T78: redundant cmp-after-xor removed — ph_opt_pair drops cmp rX,0 when flags already set
fn compiler_main_test_ph_xor_cmp_redundant_removed() -> bool {
    let xor_rax  = ph_instr_new(PH_XOR(), 0, 0, 0)
    let cmp_zero = ph_instr_imm(PH_CMP(), 0, 0)
    let result = ph_opt_pair(xor_rax, cmp_zero)
    if result.optimized != 1 { return false }
    if result.instrs[1].opcode != PH_NOP() { return false }
    true
}

// T79: ph_run_on_func has no false positives — distinct-dst IrLoadImm pair survives unchanged
fn compiler_main_test_ph_run_on_func_no_false_positives() -> bool {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 5)
    instrs[1] = ir_load_imm(1, 7)
    let func = cp_make_test_func(instrs, 2)
    let result = ph_run_on_func(func)
    if result.instrs[0].op != IrOpcode::IrLoadImm { return false }
    if result.instrs[1].op != IrOpcode::IrLoadImm { return false }
    true
}

// T80: ph_run_on_func eliminates IrCopy self-copies (IrCopy(r,r) → IrNop)
fn compiler_main_test_ph_run_on_func_eliminates_self_copies() -> bool {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_copy(5, 5)
    instrs[1] = ir_copy(7, 7)
    instrs[2] = ir_copy(9, 9)
    let func = cp_make_test_func(instrs, 3)
    let result = ph_run_on_func(func)
    if result.instrs[0].op != IrOpcode::IrNop { return false }
    if result.instrs[1].op != IrOpcode::IrNop { return false }
    if result.instrs[2].op != IrOpcode::IrNop { return false }
    true
}

// ============================================================================
// Sprint 67: Partial-constant identity/annihilation folding (T86-T92)
// ============================================================================

// T86: x * 1 → IrCopy(dst, x) — identity mul, constant on right
fn compiler_main_test_ocp_mul_identity_right() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrCopy && result.instrs[1].dst == 2 && result.instrs[1].src1 == 0
}

