    if compiler_main_test_dg_no_fold_and_outer() {
        passed = passed + 1
        println("  T853 OK: Sprint 197 Block DG: ~(r0^r1)&r1 no fold AND outer")
    } else { println("  FAIL: T853") }

    // Sprint 198 Block DH: AND-NOT-OR annihilation (T854-T859)
    if compiler_main_test_dh_and_not_or_basic() {
        passed = passed + 1
        println("  T854 OK: Sprint 198 Block DH: r0&~(r0|r1) -> 0")
    } else { println("  FAIL: T854") }
    if compiler_main_test_dh_and_not_or_rhs() {
        passed = passed + 1
        println("  T855 OK: Sprint 198 Block DH: r1&~(r0|r1) -> 0")
    } else { println("  FAIL: T855") }
    if compiler_main_test_dh_and_not_or_comm() {
        passed = passed + 1
        println("  T856 OK: Sprint 198 Block DH: ~(r0|r1)&r0 -> 0 comm")
    } else { println("  FAIL: T856") }
