        && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 0
}

// ============================================================================
// Sprint 132: Epistemic pipeline integration tests (T464-T469)
// Verify: IrAlloc + IrFieldSet (measure) → IrFieldGet → GUM arithmetic chain
// ============================================================================

// T464: measure() IR pattern — IrAlloc(0) + 3×IrFieldSet constructs Knowledge struct
fn compiler_main_test_measure_ir_pattern() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    // measure(10.5, 0.1): alloc struct, set value/variance/confidence
    instrs[0] = ir_load_float(0, 10.5)                              // value
    instrs[1] = ir_load_float(1, 0.1)                               // uncertainty
    instrs[2] = ir_alloc(2, 0)                                      // Knowledge struct
    instrs[3] = ir_field_set(2, 0, 0, make_name("value"))           // .value = 10.5
    instrs[4] = ir_binop(3, 1, BinaryOp::OpMul, 1)                  // variance = 0.1²
    instrs[5] = ir_field_set(2, 1, 3, make_name("variance"))        // .variance = 0.01
    instrs[6] = ir_load_float(4, 1.0)                               // confidence
    instrs[7] = ir_field_set(2, 2, 4, make_name("confidence"))      // .confidence = 1.0
    instrs[8] = ir_return(2)
    let func = cp_make_test_func(instrs, 9)
    // Verify structure: alloc at [2], field_set at [3], [5], [7]
    (IR_A_OP[(ir_region_slot_r(func.region, (2))) as usize] as IrOpcode) == IrOpcode::IrAlloc
        && (IR_A_OP[(ir_region_slot_r(func.region, (3))) as usize] as IrOpcode) == IrOpcode::IrFieldSet && IR_A_FIELD_IDX[(ir_region_slot_r(func.region, (3))) as usize] == 0
        && (IR_A_OP[(ir_region_slot_r(func.region, (5))) as usize] as IrOpcode) == IrOpcode::IrFieldSet && IR_A_FIELD_IDX[(ir_region_slot_r(func.region, (5))) as usize] == 1
        && (IR_A_OP[(ir_region_slot_r(func.region, (7))) as usize] as IrOpcode) == IrOpcode::IrFieldSet && IR_A_FIELD_IDX[(ir_region_slot_r(func.region, (7))) as usize] == 2
}

// T465: IrFieldGet extracts value/variance from Knowledge struct (field_idx 0, 1)
fn compiler_main_test_knowledge_field_get() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    // Assume r0 = Knowledge struct ptr
    instrs[0] = ir_field_get(1, 0, 0, make_name("value"))           // r1 = k.value
    instrs[1] = ir_field_get(2, 0, 1, make_name("variance"))        // r2 = k.variance
    instrs[2] = ir_field_get(3, 0, 2, make_name("confidence"))      // r3 = k.confidence
    instrs[3] = ir_return(1)
    let func = cp_make_test_func(instrs, 4)
    (IR_A_OP[(ir_region_slot_r(func.region, (0))) as usize] as IrOpcode) == IrOpcode::IrFieldGet && IR_A_FIELD_IDX[(ir_region_slot_r(func.region, (0))) as usize] == 0
        && (IR_A_OP[(ir_region_slot_r(func.region, (1))) as usize] as IrOpcode) == IrOpcode::IrFieldGet && IR_A_FIELD_IDX[(ir_region_slot_r(func.region, (1))) as usize] == 1
        && (IR_A_OP[(ir_region_slot_r(func.region, (2))) as usize] as IrOpcode) == IrOpcode::IrFieldGet && IR_A_FIELD_IDX[(ir_region_slot_r(func.region, (2))) as usize] == 2
}

// T466: GUM add full chain — extract fields, add values/variances, construct result
fn compiler_main_test_gum_add_full_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    // r0 = a (Knowledge ptr), r1 = b (Knowledge ptr)
    instrs[0] = ir_field_get(2, 0, 0, make_name("value"))           // r2 = a.value
    instrs[1] = ir_field_get(3, 1, 0, make_name("value"))           // r3 = b.value
    instrs[2] = ir_binop(4, 2, BinaryOp::OpAdd, 3)                  // r4 = sum_val
    instrs[3] = ir_field_get(5, 0, 1, make_name("variance"))        // r5 = a.variance
    instrs[4] = ir_field_get(6, 1, 1, make_name("variance"))        // r6 = b.variance
    instrs[5] = ir_binop(7, 5, BinaryOp::OpAdd, 6)                  // r7 = sum_var
    instrs[6] = ir_alloc(8, 0)                                      // r8 = result struct
    instrs[7] = ir_field_set(8, 0, 4, make_name("value"))           // .value = sum_val
    instrs[8] = ir_field_set(8, 1, 7, make_name("variance"))        // .variance = sum_var
    instrs[9] = ir_return(8)
    let func = cp_make_test_func(instrs, 10)
    // Verify chain: get→get→add→get→get→add→alloc→set→set→return
    (IR_A_OP[(ir_region_slot_r(func.region, (2))) as usize] as IrOpcode) == IrOpcode::IrBinOp && (IR_A_BIN_OP[(ir_region_slot_r(func.region, (2))) as usize] as BinaryOp) == BinaryOp::OpAdd
        && (IR_A_OP[(ir_region_slot_r(func.region, (5))) as usize] as IrOpcode) == IrOpcode::IrBinOp && (IR_A_BIN_OP[(ir_region_slot_r(func.region, (5))) as usize] as BinaryOp) == BinaryOp::OpAdd
        && (IR_A_OP[(ir_region_slot_r(func.region, (6))) as usize] as IrOpcode) == IrOpcode::IrAlloc
        && IR_A_FIELD_IDX[(ir_region_slot_r(func.region, (7))) as usize] == 0 && IR_A_FIELD_IDX[(ir_region_slot_r(func.region, (8))) as usize] == 1
}

// T467: GUM mul variance formula — a.val² * b.var + b.val² * a.var (delta method)
fn compiler_main_test_gum_mul_full_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_field_get(2, 0, 0, make_name("value"))           // r2 = a.val
    instrs[1] = ir_field_get(3, 1, 0, make_name("value"))           // r3 = b.val
    instrs[2] = ir_field_get(4, 0, 1, make_name("variance"))        // r4 = a.var
    instrs[3] = ir_field_get(5, 1, 1, make_name("variance"))        // r5 = b.var
    instrs[4] = ir_binop(6, 2, BinaryOp::OpMul, 2)                  // r6 = a.val²
    instrs[5] = ir_binop(7, 6, BinaryOp::OpMul, 5)                  // r7 = a.val² * b.var
    instrs[6] = ir_binop(8, 3, BinaryOp::OpMul, 3)                  // r8 = b.val²
    instrs[7] = ir_binop(9, 8, BinaryOp::OpMul, 4)                  // r9 = b.val² * a.var
    instrs[8] = ir_binop(10, 7, BinaryOp::OpAdd, 9)                 // r10 = total var
    instrs[9] = ir_return(10)
    let func = cp_make_test_func(instrs, 10)
    // Verify: 4 field_get, 5 binop (mul,mul,mul,mul,add)
    (IR_A_BIN_OP[(ir_region_slot_r(func.region, (4))) as usize] as BinaryOp) == BinaryOp::OpMul && IR_A_SRC1[(ir_region_slot_r(func.region, (4))) as usize] == 2 && IR_A_SRC2[(ir_region_slot_r(func.region, (4))) as usize] == 2
        && (IR_A_BIN_OP[(ir_region_slot_r(func.region, (8))) as usize] as BinaryOp) == BinaryOp::OpAdd && IR_A_SRC1[(ir_region_slot_r(func.region, (8))) as usize] == 7 && IR_A_SRC2[(ir_region_slot_r(func.region, (8))) as usize] == 9
}

// T468: Knowledge layout name count = 5 (value, variance, confidence, epsilon,
// provenance) over 4 slots -- `epsilon` aliases `confidence` on index 2 (#1499).
fn compiler_main_test_knowledge_layout_fields_3() -> bool with Mut, Panic, Div {
    let table = ir_register_knowledge_layout(empty_struct_layout_table())
    table.count == 1 && table.entries[0 as usize].field_count == 5
}

// T469: GUM sub full chain — field_get + OpAdd (not OpSub) + alloc + field_set
fn compiler_main_test_gum_sub_full_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    // r0 = a, r1 = b
    instrs[0] = ir_field_get(2, 0, 0, make_name("value"))           // r2 = a.value
    instrs[1] = ir_field_get(3, 1, 0, make_name("value"))           // r3 = b.value
    instrs[2] = ir_binop(4, 2, BinaryOp::OpSub, 3)                  // r4 = diff_val
    instrs[3] = ir_field_get(5, 0, 1, make_name("variance"))        // r5 = a.variance
    instrs[4] = ir_field_get(6, 1, 1, make_name("variance"))        // r6 = b.variance
    instrs[5] = ir_binop(7, 5, BinaryOp::OpAdd, 6)                  // r7 = sum_var (ADD not SUB!)
    instrs[6] = ir_alloc(8, 0)                                      // result struct
    instrs[7] = ir_field_set(8, 0, 4, make_name("value"))
    instrs[8] = ir_field_set(8, 1, 7, make_name("variance"))
    instrs[9] = ir_return(8)
    let func = cp_make_test_func(instrs, 10)
    // Key: value uses OpSub, variance uses OpAdd
    (IR_A_BIN_OP[(ir_region_slot_r(func.region, (2))) as usize] as BinaryOp) == BinaryOp::OpSub
        && (IR_A_BIN_OP[(ir_region_slot_r(func.region, (5))) as usize] as BinaryOp) == BinaryOp::OpAdd
        && (IR_A_OP[(ir_region_slot_r(func.region, (6))) as usize] as IrOpcode) == IrOpcode::IrAlloc
}

// Sprint 131: Block AS — XOR self-inverse cancellation (T470-T475)
// (a ^ b) ^ b → a  via GF(2) self-inverse; LLVM InstCombineAndOrXor.cpp

// T470: (a ^ b) ^ b → a  [basic XOR self-inverse]
fn compiler_main_test_xor_self_inverse_basic() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    // r0, r1 are implicit params (non-constant)
    instrs[0] = ir_binop(2, 0, BinaryOp::OpBitXor, 1)  // r2 = a ^ b
    instrs[1] = ir_binop(3, 2, BinaryOp::OpBitXor, 1)  // r3 = (a^b) ^ b → a
    instrs[2] = ir_return(3)
    let func = cp_make_test_func(instrs, 3)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(opt.region, (1))) as usize] == 0
}

