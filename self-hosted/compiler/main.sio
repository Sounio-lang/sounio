fn run_version_json_mode() with IO, Mut, Panic, Div {
    let path = "/tmp/sounio_version.json"
    let ok = io_write_version_json(path)
    if ok {
        let data = read_file(path)
        let size = file_size(path)
        var buf: [i8; 65536] = [0; 65536]
        var i: i64 = 0
        while i < size && i < 65536 {
            buf[i as usize] = data[i as usize]
            i = i + 1
        }
        print(str_from_bytes(buf, size))
    }
}

fn run_kernel_compile_mode(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    let source_path = compiler_mode_source_arg(args, flag_index, "--kernel-compile")
    let response_path = source_path + ".response.json"
    let opts = parse_options(args)
    let result = compile(opts)
    if result.success {
        let resp = kernel_response_ok("", 0, 0, SOUNIO_ABI_VERSION)
        let ok = io_write_kernel_response_json(response_path, resp)
        if !ok {
            println("kernel-compile: FAILED to write response: " + response_path)
        }
        println("kernel-compile: ok (response: " + response_path + ")")
    } else {
        let resp = kernel_response_error(1, "compilation failed")
        let ok = io_write_kernel_response_json(response_path, resp)
        if !ok {
            println("kernel-compile: FAILED to write response: " + response_path)
        }
        println("kernel-compile: compile failed (response: " + response_path + ")")
    }
}

// ============================================================================
// GPU HOST GLUE EMITTER
// ============================================================================
//
// Generate a host-side Sounio wrapper module that calls the GPU launch function
// for the emitted PTX/Metal/SPIR-V kernel file. Writes a _host.sio file that
// imports the appropriate launch module and provides a gpu_run_kernel() entry.

fn gpu_emit_host_glue(
    output_path: string,
    kernel_name: string,
    gpu_target: string
) -> bool with IO, Mut, Panic, Div, Alloc {
    // Construct the host glue file path: output_path + "_host.sio"
    let host_path = output_path ++ "_host.sio"

    // Build the host glue source as a PtxBuf (reusing the text buffer)
    var glue = ptx_buf_new()
    glue = ptx_push_str(glue, "// Generated host glue for GPU kernel\n")
    glue = ptx_push_str(glue, "// Usage: import this module to launch the kernel on GPU\n")
    glue = ptx_push_str(glue, "//\n")
    glue = ptx_push_str(glue, "// Target: ")
    glue = ptx_push_str(glue, gpu_target)
    glue = ptx_push_str(glue, "\n")
    glue = ptx_push_str(glue, "// Kernel file: ")
    glue = ptx_push_str(glue, output_path)
    glue = ptx_push_str(glue, "\n\n")

    // Import the appropriate launch module
    let is_metal_target = str_len(gpu_target) >= 5
        && str_char_at(gpu_target, 0) == str_char_at("metal", 0)
        && str_char_at(gpu_target, 1) == str_char_at("metal", 1)
        && str_char_at(gpu_target, 2) == str_char_at("metal", 2)
        && str_char_at(gpu_target, 3) == str_char_at("metal", 3)
        && str_char_at(gpu_target, 4) == str_char_at("metal", 4)

    if is_metal_target {
        glue = ptx_push_str(glue, "use gpu::runtime::metal::*\n")
        glue = ptx_push_str(glue, "use gpu::runtime::launch::{gpu_launch_msl_vecadd, GpuLaunchResult}\n\n")
        glue = ptx_push_str(glue, "// Launch the Metal kernel with the specified buffer sizes.\n")
        glue = ptx_push_str(glue, "// Loads MSL source from the output file at runtime.\n")
        glue = ptx_push_str(glue, "fn gpu_run_kernel(n: i64, host_a: *const f32, host_b: *const f32, host_c: *const f32) -> GpuLaunchResult with IO, Mut, Panic, Div, Alloc {\n")
        glue = ptx_push_str(glue, "    // Load MSL source and launch\n")
        glue = ptx_push_str(glue, "    // TODO: load_file_bytes(\"")
        glue = ptx_push_str(glue, output_path)
        glue = ptx_push_str(glue, "\") -> gpu_launch_msl_vecadd\n")
        glue = ptx_push_str(glue, "    gpu_launch_result_err(99)\n")
        glue = ptx_push_str(glue, "}\n")
    } else {
        glue = ptx_push_str(glue, "use gpu::runtime::cuda::*\n")
        glue = ptx_push_str(glue, "use gpu::runtime::launch::{gpu_launch_ptx_vecadd, GpuLaunchResult}\n\n")
        glue = ptx_push_str(glue, "// Launch the CUDA PTX kernel with the specified buffer sizes.\n")
        glue = ptx_push_str(glue, "// Loads PTX source from the output file at runtime.\n")
        glue = ptx_push_str(glue, "fn gpu_run_kernel(n: i64, host_a: *const f32, host_b: *const f32, host_c: *const f32) -> GpuLaunchResult with IO, Mut, Panic, Div, Alloc {\n")
        glue = ptx_push_str(glue, "    // Load PTX file and launch\n")
        glue = ptx_push_str(glue, "    // TODO: load_file_bytes(\"")
        glue = ptx_push_str(glue, output_path)
        glue = ptx_push_str(glue, "\") -> gpu_launch_ptx_vecadd\n")
        glue = ptx_push_str(glue, "    gpu_launch_result_err(99)\n")
        glue = ptx_push_str(glue, "}\n")
    }

    // Write host glue to file
    let ok = io_write_bytes_to_file(host_path, glue.data, glue.len)
    if ok {
        print("GPU: host glue written to ")
        print(host_path)
        print("\n")
    }
    ok
}


fn compiler_hlir_name_matches_ast_name(hn: HlirName, an: Name) -> bool with Mut, Panic, Div {
    if hn.len != an.len {
        return false
    }
    var i: i64 = 0
    while i < hn.len {
        if hn.buf[i as usize] != an.buf[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

fn compiler_mark_hlir_kernel_name(module: HlirModule, name: Name) -> HlirModule with Mut, Panic, Div {
    var out = module
    var i: i64 = 0
    while i < out.fn_count {
        if compiler_hlir_name_matches_ast_name(out.functions[i as usize].name, name) {
            var f = out.functions[i as usize]
            f.is_kernel = true
            out.functions[i as usize] = f
        }
        i = i + 1
    }
    out
}

fn compiler_mark_hlir_kernels_from_items(module: HlirModule, items: Option<Box<ItemList>>) -> HlirModule with Mut, Panic, Div {
    match items {
        Some(list) => {
            var out = module
            let item = (*list).head
            if item.kind == ItemKind::ItemFn {
                match item.fn_def {
                    Some(fd) => {
                        if (*fd).is_kernel {
                            out = compiler_mark_hlir_kernel_name(out, (*fd).name)
                        }
                    }
                    None => {}
                }
            }
            compiler_mark_hlir_kernels_from_items(out, (*list).tail)
        }
        None => module,
    }
}


// ============================================================================
// GPU COMPILE PIPELINE
// ============================================================================
//
// When --gpu-target is set, bypass native ELF emission and run:
//   load_module_file → hlir_lower_module → hlir_kernels_to_{ptx,metal,spirv}
//
// Target string dispatch:
//   "cuda-*"   → PTX (ptx_codegen_kernel_ampere / tuned / epistemic)
//   "metal-*"  → MSL (gpu_lower_to_metal)
//   "spirv-*"  → SPIR-V (hlir_kernels_to_ptx as placeholder; full SPIR-V pending)
//   "rocm-*"   → PTX (ROCm uses HIP-compatible PTX)
//
// Output is written to output_path as text (.ptx/.metal) or binary (.spv).
// If output_path is empty, output is printed to stdout.

fn run_gpu_compile_pipeline(
    input_path: string,
    output_path: string,
    gpu_target: string,
    gpu_binary_format: string
) -> i32 with IO, Mut, Div, Panic, Alloc {
    print("GPU dispatch: input=")
    print(input_path)
    print(" target=")
    print(gpu_target)
    print("\n")

    // Load and parse
    let main_prog = load_module_file(input_path)

    // Resolve + type-check via the INPLACE module frontend (the same path the
    // working `--check` verb uses). The by-value resolve_program/check_program
    // crash bin/souc on large-struct value movement (~760KB Resolver threaded
    // through SRET self-by-value calls; triggered by the ExprIf arm). The
    // inplace frontend does its own resolution + typecheck and returns a
    // verdict (0 = OK). Downstream hlir_lower_module consumes only main_prog
    // (the AST), so dropping the by-value results is behavior-preserving.
    let frontend_verdict = module_frontend_check_items_with_source_context(main_prog.items, input_path)
    if frontend_verdict != 0 {
        print("GPU: frontend errors: ")
        print_int(frontend_verdict)
        print("\n")
        return 1
    }

    // module_frontend_check_items_with_source_context consumes the item list on
    // the self-hosted value path. Reload before HLIR lowering so kernel fn
    // declarations remain visible to the GPU extraction pass.
    let lower_prog = load_module_file(input_path)
    var hlir_module = hlir_lower_module(lower_prog)
    let kernel_mark_prog = load_module_file(input_path)
    hlir_module = compiler_mark_hlir_kernels_from_items(hlir_module, kernel_mark_prog.items)

    // Count GPU-annotated kernels
    let kcount = hlir_extract_kernel_count(hlir_module)
    print("GPU: ")
    print_int(kcount)
    print(" kernel(s) found\n")

    // Determine output format from target prefix
    // "metal-*"          → MSL
    // "spirv-*"/"vulkan-"→ SPIR-V binary
    // "all"              → PTX + Metal + SPIR-V (three output files)
    // default            → PTX

    // --gpu-target all: emit all three backends
    if str_eq(gpu_target, "all") {
        // PTX
        let ptx_all = hlir_kernels_to_ptx(hlir_module)
        let ptx_path = if str_len(output_path) > 0 { output_path ++ ".ptx" } else { "out.ptx" }
        let ptx_ok = io_write_bytes_to_file(ptx_path, ptx_all.data, ptx_all.len)
        if ptx_ok { print("GPU: PTX written to ") } else { print("GPU: WARN PTX write failed: ") }
        print(ptx_path)
        print("\n")

        // Metal MSL — print to stdout (no file write available for MetalBuf)
        let metal_all = hlir_kernels_to_metal(hlir_module)
        metal_buf_print(metal_all)

        // SPIR-V binary
        let spv_artifact_all = hlir_kernels_to_spirv_artifact(hlir_module)
        let spv_path = if str_len(output_path) > 0 { output_path ++ ".spv" } else { "out.spv" }
        let spv_ok = io_write_bytes_to_file(spv_path, spv_artifact_all.data, spv_artifact_all.len)
        if spv_ok { print("GPU: SPIR-V written to ") } else { print("GPU: WARN SPIR-V write failed: ") }
        print(spv_path)
        print("\n")

        // K-AXI epistemic assembly
        let kaxi_all = hlir_kernels_to_kaxi(hlir_module)
        let kaxi_path = if str_len(output_path) > 0 { output_path ++ ".kaxi" } else { "out.kaxi" }
        let kaxi_ok = io_write_kaxi_binary(kaxi_path, kaxi_all.data, kaxi_all.len)
        if kaxi_ok { print("GPU: K-AXI written to ") } else { print("GPU: WARN K-AXI write failed: ") }
        print(kaxi_path)
        print("\n")

        return 0
    }

    // Metal/MSL
    if str_len(gpu_target) >= 5 && str_char_at(gpu_target, 0) == str_char_at("metal", 0)
                                 && str_char_at(gpu_target, 1) == str_char_at("metal", 1)
                                 && str_char_at(gpu_target, 2) == str_char_at("metal", 2)
                                 && str_char_at(gpu_target, 3) == str_char_at("metal", 3)
                                 && str_char_at(gpu_target, 4) == str_char_at("metal", 4) {
        let metal = hlir_kernels_to_metal(hlir_module)
        metal_buf_print(metal)
        print("GPU: Metal MSL emitted\n")
        return 0
    }

    // K-AXI epistemic assembly
    if str_len(gpu_target) >= 4 && str_char_at(gpu_target, 0) == str_char_at("kaxi", 0)
                                && str_char_at(gpu_target, 1) == str_char_at("kaxi", 1)
                                && str_char_at(gpu_target, 2) == str_char_at("kaxi", 2)
                                && str_char_at(gpu_target, 3) == str_char_at("kaxi", 3) {
        let kaxi = hlir_kernels_to_kaxi(hlir_module)
        if str_len(output_path) > 0 {
            let kaxi_ok = io_write_kaxi_binary(output_path, kaxi.data, kaxi.len)
            if kaxi_ok {
                print("GPU: K-AXI written to ")
                print(output_path)
                print(" (")
                print_int(kaxi.len)
                print(" bytes)\n")
            } else {
                print("GPU: failed to write K-AXI to ")
                print(output_path)
                print("\n")
                return 1
            }
        } else {
            print(kaxi_asm_to_string(kaxi))
        }
        return 0
    }

    // SPIR-V / Vulkan — epistemic variant (spirv-epistemic, vulkan-epistemic)
    let is_epistemic_spirv = str_eq(gpu_target, "spirv-epistemic") || str_eq(gpu_target, "vulkan-epistemic")
    if is_epistemic_spirv {
        let espv_artifact = hlir_kernels_to_epistemic_spirv_artifact(hlir_module)
        if str_len(output_path) > 0 {
            let espv_ok = io_write_bytes_to_file(output_path, espv_artifact.data, espv_artifact.len)
            if !espv_ok {
                print("GPU: failed to write epistemic SPIR-V to ")
                print(output_path)
                print("\n")
                return 1
            }
            print("GPU: epistemic SPIR-V written to ")
            print(output_path)
            print(" (")
            print_int(espv_artifact.len)
            print(" bytes)\n")
            if str_eq(gpu_binary_format, "host-glue") {
                let _glue_ok = gpu_emit_host_glue(output_path, "kernel", gpu_target)
            }
        } else {
            print("GPU: epistemic SPIR-V ")
            print_int(espv_artifact.word_count)
            print(" words emitted\n")
        }
        return 0
    }

    // SPIR-V / Vulkan
    let is_spirv = str_len(gpu_target) >= 5
                   && str_char_at(gpu_target, 0) == str_char_at("spirv", 0)
                   && str_char_at(gpu_target, 1) == str_char_at("spirv", 1)
                   && str_char_at(gpu_target, 2) == str_char_at("spirv", 2)
                   && str_char_at(gpu_target, 3) == str_char_at("spirv", 3)
                   && str_char_at(gpu_target, 4) == str_char_at("spirv", 4)
    let is_vulkan = str_len(gpu_target) >= 6
                    && str_char_at(gpu_target, 0) == str_char_at("vulkan", 0)
                    && str_char_at(gpu_target, 1) == str_char_at("vulkan", 1)
                    && str_char_at(gpu_target, 2) == str_char_at("vulkan", 2)
                    && str_char_at(gpu_target, 3) == str_char_at("vulkan", 3)
                    && str_char_at(gpu_target, 4) == str_char_at("vulkan", 4)
                    && str_char_at(gpu_target, 5) == str_char_at("vulkan", 5)
    if is_spirv || is_vulkan {
        let spv_artifact = hlir_kernels_to_spirv_artifact(hlir_module)
        if str_len(output_path) > 0 {
            let spv_write_ok = io_write_bytes_to_file(output_path, spv_artifact.data, spv_artifact.len)
            if !spv_write_ok {
                print("GPU: failed to write SPIR-V to ")
                print(output_path)
                print("\n")
                return 1
            }
            print("GPU: SPIR-V written to ")
            print(output_path)
            print(" (")
            print_int(spv_artifact.len)
            print(" bytes)\n")
            // Optionally generate host glue module
            if str_eq(gpu_binary_format, "host-glue") {
                let _glue_ok = gpu_emit_host_glue(output_path, "kernel", gpu_target)
            }
        } else {
            // Print word count to stdout (binary data not printable directly)
            print("GPU: SPIR-V ")
            print_int(spv_artifact.word_count)
            print(" words emitted\n")
        }
        return 0
    }

    // CUDA Tile IR — tensor-native execution model (Blackwell/Rubin+)
    // Routes through hlir_kernels_to_cuda_tile -> gpu_lower_to_cuda_tile.
    if str_eq(gpu_target, "cuda-tile") {
        let tile_buf = hlir_kernels_to_cuda_tile(hlir_module)
        if str_len(output_path) > 0 {
            let tile_ok = io_write_bytes_to_file(output_path, tile_buf.data, tile_buf.len)
            if !tile_ok {
                print("GPU: failed to write Tile IR to ")
                print(output_path)
                print("\n")
                return 1
            }
            print("GPU: CUDA Tile IR written to ")
            print(output_path)
            print(" (")
            print_int(tile_buf.len)
            print(" bytes)\n")
        } else {
            tile_buf_print(tile_buf)
        }
        return 0
    }

    // PTX via K-AXI (Kretikos native GPU spine) — source -> HLIR -> K-AXI -> PTX.
    // Epistemic-mode aware: --gpu-binary-format epistemic|f32-gum|f32 selects the
    // transpiler mode (the GUM 4-buffer C1/C2/V1/V2 layout flows through for mode 5).
    if str_eq(gpu_target, "ptx-kaxi") {
        let kaxi = hlir_kernels_to_kaxi(hlir_module)
        let mode_id = if str_eq(gpu_binary_format, "epistemic") { 1 }
                      else if str_eq(gpu_binary_format, "f32-gum") { 5 }
                      else if str_eq(gpu_binary_format, "f32") { 2 }
                      else { 0 }
        let kaxi_ptx = kaxi_transpile_to_ptx_unified(kaxi, mode_id)
        var kpb = ptx_buf_new()
        kpb = ptx_push_str(kpb, kaxi_ptx)
        if str_len(output_path) > 0 {
            let kw_ok = io_write_bytes_to_file(output_path, kpb.data, kpb.len)
            if !kw_ok {
                print("GPU: failed to write K-AXI PTX to ")
                print(output_path)
                print("\n")
                return 1
            }
            print("GPU: K-AXI PTX written to ")
            print(output_path)
            print(" (")
            print_int(kpb.len)
            print(" bytes, mode=")
            print_int(mode_id)
            print(")\n")
        } else {
            ptx_buf_print(kpb)
        }
        return 0
    }

    // PTX (CUDA / ROCm) — default path
    // Select variant based on binary_format or epistemic annotation
    let use_epistemic = str_eq(gpu_binary_format, "epistemic")
    let use_tuned    = str_eq(gpu_binary_format, "tuned")
    let use_fused    = str_eq(gpu_binary_format, "fused")
    let use_ep_fused = str_eq(gpu_binary_format, "epistemic-fused")
    let use_spec     = str_eq(gpu_binary_format, "speculative")
    let use_dag      = str_eq(gpu_binary_format, "dag-scheduled")

    var ptx: PtxBuf = if use_epistemic {
        hlir_kernels_to_epistemic_ptx(hlir_module)
    } else if use_tuned {
        hlir_kernels_to_tuned_ptx(hlir_module)
    } else if use_fused {
        hlir_kernels_to_fused_ptx(hlir_module)
    } else if use_ep_fused {
        hlir_kernels_to_epistemic_fused_ptx(hlir_module)
    } else if use_spec {
        hlir_kernels_to_speculative_ptx(hlir_module)
    } else if use_dag {
        hlir_kernels_to_dag_scheduled_ptx(hlir_module)
    } else {
        hlir_kernels_to_ptx(hlir_module)
    }

    if str_len(output_path) > 0 {
        // Write PTX text to output file — PtxBuf.data is [i8; 65536], matches io_write_bytes_to_file
        let write_ok = io_write_bytes_to_file(output_path, ptx.data, ptx.len)
        if !write_ok {
            print("GPU: failed to write PTX to ")
            print(output_path)
            print("\n")
            return 1
        }
        print("GPU: PTX written to ")
        print(output_path)
        print(" (")
        print_int(ptx.len)
        print(" bytes)\n")
        // Optionally generate host glue module
        if str_eq(gpu_binary_format, "host-glue") {
            let _glue_ok = gpu_emit_host_glue(output_path, "kernel", gpu_target)
        }
        // Auto-emit DAG host glue (multi-stream launch wrapper)
        if use_dag {
            let _dag_ok = gpu_emit_dag_host_glue(ptx, output_path)
            if _dag_ok {
                print("GPU: DAG host glue written to ")
                print(output_path)
                print("_dag_host.sio\n")
            }
        }
        // Auto-emit speculative host glue (epsilon-threshold guard wrapper)
        if use_spec {
            let _spec_ok = gpu_emit_spec_host_glue(ptx, output_path)
            if _spec_ok {
                print("GPU: Speculative host glue written to ")
                print(output_path)
                print("_spec_host.sio\n")
            }
        }
    } else {
        // Print to stdout
        ptx_buf_print(ptx)
    }

    0
}

// ============================================================================
// MAIN
// ============================================================================


// ---------------------------------------------------------------------------
// DUAL-USE. These stayed when the suite moved to main_tests.sio: the
// --native-v2-preview-smoke and --native-v2-gc-retry-smoke CLI modes call them
// directly, so they are production smoke tests that happen to be written as
// test functions. They are also still in the suite, which is the right place
// for the assertion -- this copy is what the CLI modes need.
// ---------------------------------------------------------------------------

fn compiler_main_test_native_v2_compile_gc_retry_smoke() -> bool with IO, Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let module = compiler_main_make_native_v2_gc_retry_module()
    let result = compile_native_v2_preview(&module, spec)
    if !result.ok || result.format_id != FORMAT_ELF64() || result.len <= 64 { return false }
    write_file("artifacts/omega/native_backend_v2_gc_retry_smoke.selftest.bin", result.bytes, result.len) == 0
}

fn compiler_main_test_native_v2_compile_multi_call() -> bool with IO, Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let ir_module = compiler_main_make_native_v2_multi_call_module()
    let result = compile_native_v2_preview(&ir_module, spec)
    if !result.ok || result.len <= 64 { return false }
    // Verify the module has 3 functions compiled
    let machine_module = native_v2_build_machine_module(&ir_module, true)
    if !machine_module.supported { return false }
    if machine_module.fn_count != 3 { return false }
    // All 3 functions must be legal
    native_v2_machine_function_is_legal(machine_module.functions[0])
        && native_v2_machine_function_is_legal(machine_module.functions[1])
        && native_v2_machine_function_is_legal(machine_module.functions[2])
}

fn compiler_main_test_native_v2_compile_preview_call_control() -> bool with IO, Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let call_module = compiler_main_make_native_v2_call_module()
    let call_result = compile_native_v2_preview(&call_module, spec)
    if !call_result.ok || call_result.len <= 64 { return false }
    let control_module = compiler_main_make_native_v2_control_module()
    let control_result = compile_native_v2_preview(&control_module, spec)
    control_result.ok && control_result.len > 64
}

fn compiler_main_test_native_v2_compile_preview_scalar() -> bool with IO, Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let module = compiler_main_make_native_v2_scalar_module(13)
    let result = compile_native_v2_preview(&module, spec)
    if !result.ok || result.len <= 64 { return false }
    let path = "artifacts/omega/native_backend_v2_scalar_smoke.selftest.bin"
    write_file(path, result.bytes, result.len) == 0
}

fn compiler_main_test_native_v2_fail_closed_vector() -> bool with IO, Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let module = compiler_main_make_native_v2_unsupported_vector_module()
    let result = compile_native_v2_preview(&module, spec)
    if result.ok { return false }
    if result.error_code != ERR_BACKEND_NOT_IMPLEMENTED() { return false }
    str_eq(result.error_msg, "native_v2_unsupported_opcode:vec_add_f64")
}

fn compiler_main_make_native_v2_gc_retry_module() -> IrModule with Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.reg_count = 2
    func.instrs[0] = ir_load_imm(0, 0)
    func.instrs[1] = ir_load_imm(1, 0)
    func.instrs[2] = ir_alloc(0, 536674000)
    func.instrs[3] = ir_load_imm(0, 0)
    func.instrs[4] = ir_load_imm(1, 0)
    func.instrs[5] = ir_alloc(0, 128)
    func.instrs[6] = ir_load_imm(1, 23)
    func.instrs[7] = ir_return(1)
    func.instr_count = 8
    module.functions[0] = func
    module.fn_count = 1
    module
}

fn compiler_main_make_native_v2_unsupported_vector_module() -> IrModule with Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    var instr = ir_instr_new(IrOpcode::IrVecAddF64)
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    instr.dst = 0
    instr.src1 = 1
    instr.src2 = 2
    instr.imm_i64 = 2
    func.instrs[0] = instr
    func.instrs[1] = ir_return(0)
    func.instr_count = 2
    func.reg_count = 3
    module.functions[0] = func
    module.fn_count = 1
    module
}

fn main() with IO, Mut, Panic, Div, Alloc {
    let args = get_args()

    // Check for --serve BEFORE printing banner (stdout is binary protocol)
    if compiler_mode_has_flag(args, "--serve") {
        ipc_serve()
        return
    }
    if compiler_mode_has_flag(args, "--version-json") {
        run_version_json_mode()
        return
    }
    println("Madaros v0.80.0 -- the Sounio self-hosted compiler")
    println("the bare highland that does not negotiate with ill-formed code -- Sfakia, Crete")
    println("Horizon 3: self-hosted primary compiler.")
    println("")
    if compiler_mode_has_flag(args, "--version") {
        return
    }

    var arg_idx: i64 = 0
    while arg_idx < args.len {
        let mode = arg_list_get(args, arg_idx)
        if mode == "pkg" {
            run_pkg_dispatch(args, arg_idx)
            return
        } else if mode == "install" {
            run_pkg_install_shorthand(args, arg_idx)
            return
        } else if mode == "search" {
            run_pkg_search_shorthand(args, arg_idx)
            return
        } else if mode == "ontology" {
            run_ontology_cli(args, arg_idx)
            return
        } else if mode == "check" || mode == "--check" {
            run_check_mode(args, arg_idx)
            return
        } else if mode == "emit-lean-obligations" || mode == "--emit-lean-obligations" {
            run_emit_lean_obligations(args, arg_idx)
            return
        } else if mode == "build" {
            run_native_v2_compile_mode(args, arg_idx)
            return
        } else if mode == "run" {
            run_native_v2_compile_mode(args, arg_idx)
            return
        } else if mode == "--ir-dump" {
            run_ir_dump_mode(args, arg_idx)
            return
        } else if mode == "--ir-roundtrip" {
            run_ir_roundtrip_mode(args, arg_idx)
            return
        } else if mode == "--science-boundary-closure" {
            run_science_boundary_closure_report(args, arg_idx)
            return
        } else if mode == "--native-compile" {
            run_native_compile_mode(args, arg_idx)
            return
        } else if mode == "--emit-obj" {
            run_emit_obj_mode(args, arg_idx)
            return
        } else if mode == "--emit-so" {
            run_emit_so_mode(args, arg_idx)
            return
        } else if mode == "--ontology-resolve" {
            run_ontology_resolve_mode(args, arg_idx)
            return
        } else if mode == "--ontology-search" {
            run_ontology_search_mode(args, arg_idx)
            return
        } else if mode == "--ontology-ancestors" {
            run_ontology_ancestors_mode(args, arg_idx)
            return
        } else if mode == "--ontology-is-subclass" {
            run_ontology_is_subclass_mode(args, arg_idx)
            return
        } else if mode == "--ontology-map" {
            run_ontology_map_mode(args, arg_idx)
            return
        } else if mode == "--serve" {
            ipc_serve()
            return
        } else if mode == "--self-test" {
            // The suite moved to self-hosted/compiler/main_tests.sio, which is
            // its own program. Kept as an arm so the flag names where it went
            // rather than falling through to "unknown mode".
            println("--self-test moved: build and run self-hosted/compiler/main_tests.sio")
            return
        } else if mode == "--native-v2-preview-smoke" {
            run_native_v2_preview_smoke()
            return
        } else if mode == "--native-v2-gc-retry-smoke" {
            run_native_v2_gc_retry_smoke()
            return
        } else if mode == "--rebracket-authority-smoke" {
            run_exact_bitwise_rebracket_authority_smoke()
            return
        } else if mode == "--native-v2-emit13" {
            run_native_v2_emit13()
            return
        } else if mode == "--native-v2-emit-wide-add4" {
            run_native_v2_emit_wide(args, arg_idx, 0)
            return
        } else if mode == "--native-v2-emit-wide-sub" {
            run_native_v2_emit_wide(args, arg_idx, 1)
            return
        } else if mode == "--native-v2-emit-wide-mul" {
            run_native_v2_emit_wide(args, arg_idx, 2)
            return
        } else if mode == "--native-v2-emit-wide-shr" {
            run_native_v2_emit_wide(args, arg_idx, 3)
            return
        } else if mode == "--native-v2-emit-wide-div" {
            run_native_v2_emit_wide(args, arg_idx, 4)
            return
        } else if mode == "--native-v2-emit-wide-mod" {
            run_native_v2_emit_wide(args, arg_idx, 5)
            return
        } else if mode == "--native-v2-emit-wide-cmp" {
            run_native_v2_emit_wide(args, arg_idx, 6)
            return
        } else if mode == "--native-v2-emit-wide-shr-unaligned" {
            run_native_v2_emit_wide(args, arg_idx, 7)
            return
        } else if mode == "--native-v2-emit-wide-divfull" {
            run_native_v2_emit_wide(args, arg_idx, 8)
            return
        } else if mode == "--native-v2-emit-wide-modfull" {
            run_native_v2_emit_wide(args, arg_idx, 9)
            return
        } else if mode == "--native-v2-compile" {
            run_native_v2_compile_mode(args, arg_idx)
            return
        } else if mode == "--native-v2-emit-scalar" {
            run_native_v2_emit_scalar(args, arg_idx)
            return
        } else if mode == "--native-v2-emit-call" {
            run_native_v2_emit_call(args, arg_idx)
            return
        } else if mode == "--native-v2-emit-fnptr" {
            run_native_v2_emit_fnptr(args, arg_idx)
            return
        } else if mode == "--native-v2-emit-multicall" {
            run_native_v2_emit_multicall(args, arg_idx)
            return
        } else if mode == "--native-v2-emit-control" {
            run_native_v2_emit_control(args, arg_idx)
            return
        } else if mode == "--native-v2-emit-arith" {
            run_native_v2_emit_arith(args, arg_idx)
            return
        } else if mode == "--native-v2-emit-f64cmp" {
            run_native_v2_emit_f64cmp(args, arg_idx)
            return
        } else if mode == "--native-v2-emit-control-ft" {
            run_native_v2_emit_control_ft(args, arg_idx)
            return
        } else if mode == "--native-v2-emit-sret" {
            run_native_v2_emit_sret(args, arg_idx)
            return
        } else if mode == "--native-v2-emit-sret-plaincall" {
            run_native_v2_emit_sret_plaincall(args, arg_idx)
            return
        } else if mode == "--native-v2-emit-call5" {
            run_native_v2_emit_call5(args, arg_idx)
            return
        } else if mode == "--native-v2-emit-call6" {
            run_native_v2_emit_call6(args, arg_idx)
            return
        } else if mode == "--native-v2-emit-strlen" {
            run_native_v2_emit_strlen(args, arg_idx)
            return
        } else if mode == "--native-v2-emit-strcharat" {
            run_native_v2_emit_strcharat(args, arg_idx)
            return
        } else if mode == "--native-v2-emit-streq" {
            run_native_v2_emit_streq(args, arg_idx)
            return
        } else if mode == "--native-v2-emit-strlen2" {
            run_native_v2_emit_strlen2(args, arg_idx)
            return
        } else if mode == "--native-v2-emit-streq1" {
            run_native_v2_emit_streq1(args, arg_idx)
            return
        } else if mode == "--native-v2-emit-streqnocall" {
            run_native_v2_emit_streqnocall(args, arg_idx)
            return
        } else if mode == "--native-v2-emit-strconcatlen" {
            run_native_v2_emit_strconcatlen(args, arg_idx)
            return
        } else if mode == "--native-v2-emit-strconcatcharat" {
            run_native_v2_emit_strconcatcharat(args, arg_idx)
            return
        } else if mode == "--bench-int-to-string" {
            run_int_to_string_bench_from_args(args, arg_idx)
            return
        } else if mode == "--probe-char-from-i64" {
            run_probe_char_from_i64(args, arg_idx)
            return
        } else if mode == "--probe-arg-list-get" {
            run_probe_arg_list_get(args, arg_idx)
            return
        } else if mode == "--probe-compile-capture" || mode == "--probe-cc" || starts_with(mode, "--probe-c") {
            run_probe_compile_capture(args, arg_idx)
            return
        } else if mode == "--probe-frontend-strategy" || starts_with(mode, "--probe-front-strat") {
            run_probe_frontend_strategy(args, arg_idx)
            return
        } else if mode == "--probe-frontend" || starts_with(mode, "--probe-front") {
            run_probe_frontend(args, arg_idx)
            return
        } else if mode == "--probe-epistemic-check" || starts_with(mode, "--probe-epi") {
            run_probe_epistemic_check(args, arg_idx)
            return
        } else if mode == "--probe-load-ir-trace" || starts_with(mode, "--probe-load-ir-t") {
            run_probe_load_ir_trace(args, arg_idx)
            return
        } else if mode == "--probe-monolithic-public-lower-call" || mode == "--probe-monolithic-global-f64" {
            run_probe_monolithic_public_lower_call(args, arg_idx)
            return
        } else if mode == "--probe-native-streaming" || starts_with(mode, "--probe-native-stream") {
            run_probe_native_streaming(args, arg_idx)
            return
        } else if mode == "--probe-load-ir" || starts_with(mode, "--probe-load") {
            run_probe_load_ir(args, arg_idx)
            return
        } else if mode == "--probe-ir-callsite" || starts_with(mode, "--probe-ir-call") {
            run_probe_ir_callsite(args, arg_idx)
            return
        } else if mode == "--probe-ir-opt-strategy-boxed" {
            run_probe_ir_opt_strategy_boxed(args, arg_idx)
            return
        } else if mode == "--probe-ir-opt-strategy" || starts_with(mode, "--probe-ir-opt") {
            run_probe_ir_opt_strategy(args, arg_idx)
            return
        } else if mode == "--probe-wasm-dispatch" || starts_with(mode, "--probe-wasm") {
            run_probe_wasm_dispatch(args, arg_idx)
            return
        } else if mode == "--show-profile" || starts_with(mode, "--show-prof") {
            run_probe_show_profile(args, arg_idx)
            return
        } else if mode == "--probe-machine-ir" || starts_with(mode, "--probe-mir") {
            run_probe_machine_ir(args, arg_idx)
            return
        } else if starts_with(mode, "--probe") {
            run_probe_compile_capture(args, arg_idx)
            return
        }
        arg_idx = arg_idx + 1
    }

    let opts = parse_options(args)

    // Self-falsifying compiler rung: execute claim gates after type-check,
    // before any codegen lane below runs.
    if opts.verify_claims {
        let claim_fail_count = claim_executor_verify(opts.input_file)
        if claim_fail_count != 0 {
            panic("verify-claims: compilation aborted by self-falsifying claim gates")
        }
    }

    // GPU dispatch: when --gpu-target is set, bypass native ELF and emit GPU code
    if str_len(opts.gpu_target) > 0 {
        let gpu_exit = run_gpu_compile_pipeline(
            opts.input_file,
            opts.output_file,
            opts.gpu_target,
            opts.gpu_binary_format
        )
        if gpu_exit != 0 {
            exit_process(gpu_exit)
        }
        return
    }

    if opts.verbose {
        println("Options:")
        println("  Input:  " + opts.input_file)
        println("  Output: " + opts.output_file)
        println("  Target: " + opts.target)
        println("  GPU Target: " + opts.gpu_target)
        println("  GPU Binary Format: " + opts.gpu_binary_format)
        let strict_label = if opts.gpu_strict_parity { "true" } else { "false" }
        println("  GPU Strict Parity: " + strict_label)
        println("")
    }

    if compiler_try_default_native_v2_single(opts) {
        return
    }

    let result = compile(opts)

    if result.success {
        println("Compilation successful!")
        println("   Output: " + result.output)

        if result.errors.len > 0 {
            println("")
            println("Warnings:")
            var i: i64 = 0
            while i < result.errors.len {
                println("  " + compile_errors_get(result.errors, i))
                i = i + 1
            }
        }
    } else {
        println("Compilation failed!")
        println("")
        println("Errors:")
        var i: i64 = 0
        while i < result.errors.len {
            println("  " + compile_errors_get(result.errors, i))
            i = i + 1
        }
        panic("compile failed")
    }
}
