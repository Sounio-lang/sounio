fn compiler_main_test_ge_observed_reassoc_chain() -> bool with Mut, Div, Panic {
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
    instrs[0 as usize] = ir_load_float(0, 1.0)
    instrs[1 as usize] = ir_load_float(1, 0.000000003)
    instrs[2 as usize] = ir_alloc(2, 0)
    instrs[3 as usize] = ir_field_set(2, 0, 0, make_name("value"))
    instrs[4 as usize] = ir_binop(3, 1, BinaryOp::OpMul, 1)
    instrs[5 as usize] = ir_field_set(2, 1, 3, make_name("variance"))
    instrs[6 as usize] = ir_load_float(4, 1.0)
    instrs[7 as usize] = ir_field_set(2, 2, 4, make_name("confidence"))
    instrs[8 as usize] = ir_field_get(5, 2, 54, make_name("value"))

    instrs[9 as usize] = ir_load_float(6, 2.0)
    instrs[10 as usize] = ir_load_float(7, 0.000000003)
    instrs[11 as usize] = ir_alloc(8, 0)
    instrs[12 as usize] = ir_field_set(8, 0, 6, make_name("value"))
    instrs[13 as usize] = ir_binop(9, 7, BinaryOp::OpMul, 7)
    instrs[14 as usize] = ir_field_set(8, 1, 9, make_name("variance"))
    instrs[15 as usize] = ir_load_float(10, 1.0)
    instrs[16 as usize] = ir_field_set(8, 2, 10, make_name("confidence"))
    instrs[17 as usize] = ir_field_get(11, 8, 54, make_name("value"))

    instrs[18 as usize] = ir_load_float(12, 3.0)
    instrs[19 as usize] = ir_load_float(13, 0.000000005)
    instrs[20 as usize] = ir_alloc(14, 0)
    instrs[21 as usize] = ir_field_set(14, 0, 12, make_name("value"))
    instrs[22 as usize] = ir_binop(15, 13, BinaryOp::OpMul, 13)
    instrs[23 as usize] = ir_field_set(14, 1, 15, make_name("variance"))
    instrs[24 as usize] = ir_load_float(16, 1.0)
    instrs[25 as usize] = ir_field_set(14, 2, 16, make_name("confidence"))
    instrs[26 as usize] = ir_field_get(17, 14, 54, make_name("value"))

    instrs[27 as usize] = ir_binop(18, 5, BinaryOp::OpAdd, 11)
    instrs[28 as usize] = ir_binop(19, 18, BinaryOp::OpAdd, 17)
    instrs[29 as usize] = ir_return(19)

    var func = cp_make_test_func(instrs, 30)
    func.compile_strategy = IR_STRATEGY_PRECISION_PRESERVING
    let opt = ocp_egraph_epistemic_pass(func)
    opt.instr_count == 31
        && (IR_A_OP[(ir_region_slot_r(opt.region, (28))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && IR_A_DST[(ir_region_slot_r(opt.region, (28))) as usize] == 40
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (28))) as usize] == 11
        && IR_A_SRC2[(ir_region_slot_r(opt.region, (28))) as usize] == 17
        && (IR_A_OP[(ir_region_slot_r(opt.region, (29))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && IR_A_DST[(ir_region_slot_r(opt.region, (29))) as usize] == 19
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (29))) as usize] == 5
        && IR_A_SRC2[(ir_region_slot_r(opt.region, (29))) as usize] == 40
}

// Sprint 246 Block FD: XOR decomposition fold — (~x&y)^(x&~y) → x^y (T1142-T1147)
fn compiler_main_test_fd_xor_decomp_basic() -> bool with Mut, Div, Panic {
    // r2=~r0, r3=r2&r1, r4=~r1, r5=r0&r4, r6=r3^r5 → r6 becomes IrBinOp(r0,XOR,r1)
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
    instrs[0 as usize] = ir_unaryop(2, UnaryOp::OpNot, 0)
    instrs[1 as usize] = ir_binop(3, 2, BinaryOp::OpBitAnd, 1)
    instrs[2 as usize] = ir_unaryop(4, UnaryOp::OpNot, 1)
    instrs[3 as usize] = ir_binop(5, 0, BinaryOp::OpBitAnd, 4)
    instrs[4 as usize] = ir_binop(6, 3, BinaryOp::OpBitXor, 5)
    let func = cp_make_test_func(instrs, 5)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (4))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (4))) as usize] as BinaryOp) == BinaryOp::OpBitXor
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (4))) as usize] == 0
        && IR_A_SRC2[(ir_region_slot_r(opt.region, (4))) as usize] == 1
}

fn compiler_main_test_fd_xor_decomp_comm() -> bool with Mut, Div, Panic {
    // r2=~r1, r3=r0&r2, r4=~r0, r5=r4&r1, r6=r3^r5 (commuted: (x&~y)^(~x&y)) → x^y
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
    instrs[0 as usize] = ir_unaryop(2, UnaryOp::OpNot, 1)
    instrs[1 as usize] = ir_binop(3, 0, BinaryOp::OpBitAnd, 2)
    instrs[2 as usize] = ir_unaryop(4, UnaryOp::OpNot, 0)
    instrs[3 as usize] = ir_binop(5, 4, BinaryOp::OpBitAnd, 1)
    instrs[4 as usize] = ir_binop(6, 3, BinaryOp::OpBitXor, 5)
    let func = cp_make_test_func(instrs, 5)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (4))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (4))) as usize] as BinaryOp) == BinaryOp::OpBitXor
}

fn compiler_main_test_fd_xor_decomp_inner_comm() -> bool with Mut, Div, Panic {
    // r2=~r0, r3=r1&r2 (inner: y&~x), r4=~r1, r5=r0&r4, r6=r3^r5 → x^y
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
    instrs[0 as usize] = ir_unaryop(2, UnaryOp::OpNot, 0)
    instrs[1 as usize] = ir_binop(3, 1, BinaryOp::OpBitAnd, 2)
    instrs[2 as usize] = ir_unaryop(4, UnaryOp::OpNot, 1)
    instrs[3 as usize] = ir_binop(5, 0, BinaryOp::OpBitAnd, 4)
    instrs[4 as usize] = ir_binop(6, 3, BinaryOp::OpBitXor, 5)
    let func = cp_make_test_func(instrs, 5)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (4))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (4))) as usize] as BinaryOp) == BinaryOp::OpBitXor
}

