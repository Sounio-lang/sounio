        && (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (3))) as usize] as BinaryOp) == BinaryOp::OpBitOr
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (3))) as usize] == 2 && IR_A_SRC2[(ir_region_slot_r(opt.region, (3))) as usize] == 1
}

// T479: (a & b) | ~a → ~a | b  [commutative OR]
fn compiler_main_test_not_dist_or_commutative() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(6, -1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitXor, 6)   // r2 = ~a
