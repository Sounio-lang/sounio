// T452: x & ~x → 0 (s2 = NOT(s1)).
fn compiler_main_test_and_complement_zero() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, -1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitXor, 1)
    instrs[2] = ir_binop(3, 0, BinaryOp::OpBitAnd, 2)
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrLoadImm
        && IR_A_IMM_I64[(ir_region_slot_r(result.region, (2))) as usize] == 0
}

// T453: ~x & x → 0 (commutative, s1 = NOT(s2)).
fn compiler_main_test_and_complement_comm_zero() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, -1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitXor, 1)
    instrs[2] = ir_binop(3, 2, BinaryOp::OpBitAnd, 0)
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrLoadImm
        && IR_A_IMM_I64[(ir_region_slot_r(result.region, (2))) as usize] == 0
}

