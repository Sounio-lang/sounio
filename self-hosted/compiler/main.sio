// T117: E-graph opcode constants are correctly defined.
fn compiler_main_test_egraph_op_constants() -> bool {
    EG_OP_CONST == 1 && EG_OP_VAR == 2 && EG_OP_ADD == 3 && EG_OP_SUB == 4 && EG_OP_MUL == 5
}

// T118: E-graph op-name hash function returns distinct expected values.
fn compiler_main_test_egraph_op_name_hash() -> bool {
    eg_op_name_hash(EG_OP_ADD) == 300 && eg_op_name_hash(EG_OP_MUL) == 500 && eg_op_name_hash(EG_OP_NEG) == 700
}

// T119: E-graph cost model constants satisfy CONST == VAR < OP.
fn compiler_main_test_egraph_cost_model() -> bool {
    EG_COST_CONST == 1 && EG_COST_VAR == 1 && EG_COST_OP == 2 && EG_COST_CONST < EG_COST_OP
}

// T120: Pattern variable sentinels are distinct negative values.
fn compiler_main_test_egraph_pat_vars() -> bool {
    EG_PAT_VAR_A == 0 - 1 && EG_PAT_VAR_B == 0 - 2 && EG_PAT_VAR_C == 0 - 3 && EG_PAT_VAR_D == 0 - 4
}

// T121: eg_rule_add_commute produces an ADD→ADD rule with 2 children.
fn compiler_main_test_egraph_add_commute_rule() -> bool {
    let r = eg_rule_add_commute()
    r.lhs_op == EG_OP_ADD && r.rhs_op == EG_OP_ADD && r.lhs_child_count == 2 && r.rhs_child_count == 2
}

// T122: eg_rule_mul_commute produces a MUL→MUL rule.
fn compiler_main_test_egraph_mul_commute_rule() -> bool {
    let r = eg_rule_mul_commute()
    r.lhs_op == EG_OP_MUL && r.rhs_op == EG_OP_MUL && r.lhs_child_count == 2
}

// T123: eg_hash_node produces distinct hashes for distinct opcodes.
fn compiler_main_test_egraph_hash_distinct() -> bool with Mut, Div, Panic {
    let no_ch: [i64; 4] = [EG_INVALID, EG_INVALID, EG_INVALID, EG_INVALID]
    let h_add = eg_hash_node(EG_OP_ADD, no_ch, 0)
    let h_mul = eg_hash_node(EG_OP_MUL, no_ch, 0)
    h_add != h_mul && h_add >= 0 && h_mul >= 0
}

// T124: EgUnionFind basic find-self after make_set.
fn compiler_main_test_egraph_uf_find_self() -> bool with Mut, Div, Panic {
    test_eg_uf_find_self()
}

// T125: EgUnionFind union merges two classes into one equivalence class.
fn compiler_main_test_egraph_uf_union() -> bool with Mut, Div, Panic {
    test_eg_uf_union_basic()
}

// T126: E-graph capacity constants are at expected magnitudes.
fn compiler_main_test_egraph_capacity_constants() -> bool {
    EG_MAX_NODES == 16384 && EG_MAX_CLASSES == 8192 && EG_MAX_RULES == 256 && EG_MAX_ITERATIONS == 30
}

// T127: ocp_binop_to_eg_op maps OpAdd → EG_OP_ADD and OpMul → EG_OP_MUL.
fn compiler_main_test_ocp_binop_to_eg_op_add() -> bool {
    ocp_binop_to_eg_op(BinaryOp::OpAdd) == EG_OP_ADD
}

// T128: ocp_binop_to_eg_op maps OpMul → EG_OP_MUL and OpSub → EG_OP_SUB.
fn compiler_main_test_ocp_binop_to_eg_op_mul_sub() -> bool {
    ocp_binop_to_eg_op(BinaryOp::OpMul) == EG_OP_MUL && ocp_binop_to_eg_op(BinaryOp::OpSub) == EG_OP_SUB
}

// T129: x86-64 Linux target policy: emitter_ready=true, 4 allocatable regs.
fn compiler_main_test_mir_target_policy_x86() -> bool {
    let p = native_target_policy_x86_64_linux()
    p.emitter_ready && p.allocatable_count == 4 && p.reserved_count == 3
}

// T130: AArch64 macOS target policy: emitter_ready=true, 10 allocatable regs.
fn compiler_main_test_mir_target_policy_aarch64() -> bool {
    let p = native_target_policy_aarch64_macos()
    p.emitter_ready && p.allocatable_count == 10 && p.reserved_count == 4
}

// ============================================================================
// Sprint 73: CSE + EgSmall self-tests (T131–T145)
// ============================================================================

// T131: CSE identifies duplicate IrBinOp and rewrites second to IrCopy.
fn compiler_main_test_cse_basic() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)   // r2 = r0 + r1
    instrs[1] = ir_binop(3, 0, BinaryOp::OpAdd, 1)   // r3 = r0 + r1  (dup)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_cse(func)
    // Second binop should become IrCopy(3, 2)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_DST[(ir_region_slot_r(result.region, (1))) as usize]  == 3
        && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 2
}

// T132: CSE does not fire when src2 differs between two adds.
fn compiler_main_test_cse_no_false_positive() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)   // r2 = r0 + r1
    instrs[1] = ir_binop(3, 0, BinaryOp::OpAdd, 2)   // r3 = r0 + r2 (different src2)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_cse(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp          // still a binop — no CSE
}

// T133: CSE does not fire when opcodes differ (OpAdd vs OpMul).
fn compiler_main_test_cse_op_distinct() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)   // r2 = r0 + r1
    instrs[1] = ir_binop(3, 0, BinaryOp::OpMul, 1)   // r3 = r0 * r1
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_cse(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp           // different op: no CSE
}

// T134: CSE on three identical binops: second and third become copies of first.
fn compiler_main_test_cse_triple() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)   // r2 = r0 + r1
    instrs[1] = ir_binop(3, 0, BinaryOp::OpAdd, 1)   // r3 = r0 + r1 (dup)
    instrs[2] = ir_binop(4, 0, BinaryOp::OpAdd, 1)   // r4 = r0 + r1 (dup)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_cse(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 2
        && (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrCopy && IR_A_SRC1[(ir_region_slot_r(result.region, (2))) as usize] == 2
}

// T135: CSE does not CSE unmapped ops (OpBitAnd → EG_OP_CONST sentinel guard).
fn compiler_main_test_cse_unmapped_op() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpBitAnd, 1)  // r2 = r0 & r1
    instrs[1] = ir_binop(3, 0, BinaryOp::OpBitAnd, 1)  // r3 = r0 & r1 (same, but AND is unmapped)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_cse(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp             // AND not CSE'd
}

// T136: eg_small_init returns a zeroed-out context.
fn compiler_main_test_eg_small_init() -> bool {
    let ctx = eg_small_init()
    ctx.node_count == 0 && ctx.uf_size == 0
}

fn compiler_eg_small_add_const(ctx: EgSmallContext, value: i64) -> (EgSmallContext, i64) with Mut, Div, Panic {
    var next = ctx
    let id = eg_small_add_const(&! next, value)
    (next, id)
}

fn compiler_eg_small_add_var(ctx: EgSmallContext, var_id: i64) -> (EgSmallContext, i64) with Mut, Div, Panic {
    var next = ctx
    let id = eg_small_add_var(&! next, var_id)
    (next, id)
}

fn compiler_eg_small_add_binop(ctx: EgSmallContext, op: i64, lhs: i64, rhs: i64) -> (EgSmallContext, i64) with Mut, Div, Panic {
    var next = ctx
    let id = eg_small_add_binop(&! next, op, lhs, rhs)
    (next, id)
}

fn compiler_eg_small_find(ctx: EgSmallContext, id: i64) -> (EgSmallContext, i64) with Mut, Div, Panic {
    var next = ctx
    let root = eg_small_find(&! next, id)
    (next, root)
}

fn compiler_eg_small_union(ctx: EgSmallContext, id0: i64, id1: i64) -> EgSmallContext with Mut, Div, Panic {
    var next = ctx
    let _ = eg_small_union(&! next, id0, id1)
    next
}

fn compiler_eg_small_saturate(ctx: EgSmallContext) -> EgSmallContext with Mut, Div, Panic {
    var next = ctx
    let _ = eg_small_saturate(&! next)
    next
}

fn compiler_eg_small_extract(ctx: EgSmallContext, root: i64) -> (EgSmallContext, EgNode) with Mut, Div, Panic {
    var next = ctx
    let extracted = eg_small_extract(&! next, root)
    (next, extracted)
}

// T137: eg_small_add_const adds one node; returns class_id 0.
fn compiler_main_test_eg_small_add_node() -> bool with Mut, Div, Panic {
    let pair = compiler_eg_small_add_const(eg_small_init(), 42)
    pair.0.node_count == 1 && pair.1 == 0
}

// T138: Adding the same constant node twice returns the same class_id (dedup).
fn compiler_main_test_eg_small_dedup() -> bool with Mut, Div, Panic {
    let pair1 = compiler_eg_small_add_const(eg_small_init(), 99)
    let pair2 = compiler_eg_small_add_const(pair1.0, 99)
    pair1.1 == pair2.1 && pair2.0.node_count == 1
}

// T139: eg_small_find returns self for a freshly allocated class.
fn compiler_main_test_eg_small_find_self() -> bool with Mut, Div, Panic {
    let pair1 = compiler_eg_small_add_const(eg_small_init(), 0)
    let pair2 = compiler_eg_small_find(pair1.0, pair1.1)
    pair2.1 == pair1.1
}

// T140: eg_small_union merges two classes; find gives same canonical for both.
fn compiler_main_test_eg_small_union() -> bool with Mut, Div, Panic {
    let pair0 = compiler_eg_small_add_const(eg_small_init(), 10)
    let pair1 = compiler_eg_small_add_const(pair0.0, 20)
    let ctx2 = compiler_eg_small_union(pair1.0, pair0.1, pair1.1)
    let pair2 = compiler_eg_small_find(ctx2, pair0.1)
    let pair3 = compiler_eg_small_find(pair2.0, pair1.1)
    pair2.1 == pair3.1
}

// T141: eg_small_saturate on add(x, 0): extraction gives EG_OP_VAR.
fn compiler_main_test_eg_small_sat_add_identity() -> bool with Mut, Div, Panic {
    let pair0 = compiler_eg_small_add_const(eg_small_init(), 0)
    let pair1 = compiler_eg_small_add_var(pair0.0, 1)
    let pair2 = compiler_eg_small_add_binop(pair1.0, EG_OP_ADD, pair1.1, pair0.1)
    let ctx3 = compiler_eg_small_saturate(pair2.0)
    let pair3 = compiler_eg_small_extract(ctx3, pair2.1)
    pair3.1.op == EG_OP_VAR
}

// T142: eg_small_saturate on mul(x, 1): extraction gives EG_OP_VAR.
fn compiler_main_test_eg_small_sat_mul_identity() -> bool with Mut, Div, Panic {
    let pair0 = compiler_eg_small_add_const(eg_small_init(), 1)
    let pair1 = compiler_eg_small_add_var(pair0.0, 2)
    let pair2 = compiler_eg_small_add_binop(pair1.0, EG_OP_MUL, pair1.1, pair0.1)
    let ctx3 = compiler_eg_small_saturate(pair2.0)
    let pair3 = compiler_eg_small_extract(ctx3, pair2.1)
    pair3.1.op == EG_OP_VAR
}

// T143: eg_small_saturate on sub(x, x): extraction gives EG_OP_CONST with value 0.
fn compiler_main_test_eg_small_sat_sub_self() -> bool with Mut, Div, Panic {
    let pair0 = compiler_eg_small_add_var(eg_small_init(), 3)
    let pair1 = compiler_eg_small_add_binop(pair0.0, EG_OP_SUB, pair0.1, pair0.1)
    let ctx2 = compiler_eg_small_saturate(pair1.0)
    let pair2 = compiler_eg_small_extract(ctx2, pair1.1)
    pair2.1.op == EG_OP_CONST && pair2.1.value == 0
}

// Build the FADD chain (a+b)+c over `ctx` (by &! — no by-value struct return,
// mirroring the proven test_eg_fano_*_inner pattern) and return the float-saturation
// merge count. Distinct var ids 1,2,3 keep the leaves apart.
fn compiler_eg_satf_fadd_chain_merges(ctx: &! EgSmallContext) -> i64 with Mut, Div, Panic {
    let a  = eg_small_add_var(ctx, 1)
    let b  = eg_small_add_var(ctx, 2)
    let c  = eg_small_add_var(ctx, 3)
    let ab = eg_small_add_binop(ctx, EG_OP_FADD, a, b)     // a+b
    let _o = eg_small_add_binop(ctx, EG_OP_FADD, ab, c)    // (a+b)+c
    eg_small_saturate_float(ctx)
}

// T143b (Feature A-1): a default EgSmallContext is INEXACT, so float associativity
// is FORBIDDEN — eg_small_saturate_float must perform zero reassociation merges on
// the f64 chain (a+b)+c. This is the realizable substitute for the prompt's "f64
// vs Rational" discrimination: f64-FADD-blocked vs integer-ADD-identity-allowed.
fn compiler_main_test_eg_small_satf_blocks_inexact_default() -> bool with Mut, Div, Panic {
    var ctx = eg_small_init()
    return compiler_eg_satf_fadd_chain_merges(&! ctx) == 0
}

// T143c (Feature A-1): when the producing context explicitly opts in to inexact
// reassociation (the GUM-guided precision-preserving pass), float associativity
// fires again — at least one merge on the same chain. Proves the gate does NOT
// regress the Sprint 225 epistemic pass.
fn compiler_main_test_eg_small_satf_allows_optin() -> bool with Mut, Div, Panic {
    var ctx = eg_small_init()
    ctx.allow_inexact_reassoc = true
    return compiler_eg_satf_fadd_chain_merges(&! ctx) > 0
}

// T143d (Feature A-layer-2): even with the inexact-reassoc opt-in enabled, a CHAOTIC
// context refuses all float reassociation — the chaos gate (e^{λt} amplification)
// dominates the precision-preserving opt-in. 0 merges on the same chain.
// T143e-h — the Q certificate (basis support) behind fano_selective, mirrored here from
// egraph.sio's T86-T90 so they run LIVE (egraph.sio standalone cannot be lowered yet).
// The context is configured the way opt_cleanup configures it (octonion registry entry,
// fano_selective), then opted in to inexact reassociation as the epistemic pass does.
fn compiler_eg_q_octonion_ctx(ctx: &! EgSmallContext) with Mut, Div, Panic {
    var func = ir_empty_function()
    func.hyper_algebra_kind = 3
    var algebras = ir_empty_algebra_table()
    var octonion = ir_empty_algebra_info()
    octonion.is_valid = true
    octonion.algebra_tag = 3
    octonion.reassoc_strategy = 2
    algebras.entries[0] = octonion
    algebras.count = 1
    ocp_configure_small_context(ctx, func, algebras)
    ctx.allow_inexact_reassoc = true
}

// T143e: scalar f64 leaves (the epistemic feed) certify {e_0} — a real product chain
// reassociates under fano_selective regardless of register ids (9, 18, 36 would have made
// the old register-id-as-basis gate decide arbitrarily).
fn compiler_main_test_eg_q_scalar_leaves_reassociate() -> bool with Mut, Div, Panic {
    var ctx = eg_small_init()
    compiler_eg_q_octonion_ctx(&! ctx)
    let a     = eg_small_add_var_with_unc(&! ctx, 9, 0)
    let b     = eg_small_add_var_with_unc(&! ctx, 18, 0)
    let c     = eg_small_add_var_with_unc(&! ctx, 36, 0)
    let inner = eg_small_add_binop(&! ctx, EG_OP_FMUL, a, b)
    let _out  = eg_small_add_binop(&! ctx, EG_OP_FMUL, inner, c)
    eg_small_saturate_float(&! ctx) > 0
}

// T143f: leaves with no certificate are refused under fano_selective (ids 1,2,3 would be
// a Fano line if ids were basis indices — they are not). Fail-closed.
fn compiler_main_test_eg_q_unknown_leaves_block() -> bool with Mut, Div, Panic {
    var ctx = eg_small_init()
    compiler_eg_q_octonion_ctx(&! ctx)
    let a     = eg_small_add_var(&! ctx, 1)
    let b     = eg_small_add_var(&! ctx, 2)
    let c     = eg_small_add_var(&! ctx, 3)
    let inner = eg_small_add_binop(&! ctx, EG_OP_FMUL, a, b)
    let _out  = eg_small_add_binop(&! ctx, EG_OP_FMUL, inner, c)
    eg_small_saturate_float(&! ctx) == 0
}

// T143g: a sum widens the support and the gate quantifies over all of it:
// (e1+e2)*e2 then *e4 — (1,2,4) does not associate, so no merge.
fn compiler_main_test_eg_q_union_support_blocks() -> bool with Mut, Div, Panic {
    var ctx = eg_small_init()
    compiler_eg_q_octonion_ctx(&! ctx)
    let e1    = eg_small_add_basis_var(&! ctx, 1, 1)
    let e2    = eg_small_add_basis_var(&! ctx, 2, 2)
    let e4    = eg_small_add_basis_var(&! ctx, 4, 4)
    let a     = eg_small_add_binop(&! ctx, EG_OP_FADD, e1, e2)
    let inner = eg_small_add_binop(&! ctx, EG_OP_FMUL, a, e2)
    let _out  = eg_small_add_binop(&! ctx, EG_OP_FMUL, inner, e4)
    eg_small_saturate_float(&! ctx) == 0
}

// T143h: the mask algebra and the site predicate over certificates.
fn compiler_main_test_eg_q_mask_algebra() -> bool with Mut, Div, Panic {
    let p12   = eg_q_prod(1 << 1, 1 << 2) == (1 << 3)
    let p124  = eg_q_prod((1 << 1) | (1 << 2), 1 << 4) == ((1 << 5) | (1 << 6))
    let topl  = eg_q_prod(0 - 1, 1) < 0
    let real3 = eg_q_triple_associative(3, 1, 1, 1)
    let fano  = eg_q_triple_associative(3, 1 << 1, 1 << 2, 1 << 3)
    let nfano = !eg_q_triple_associative(3, 1 << 1, 1 << 2, 1 << 4)
    let unk   = !eg_q_triple_associative(3, 1 << 1, 0 - 1, 1 << 3)
    p12 && p124 && topl && real3 && fano && nfano && unk
}

fn compiler_main_test_eg_small_satf_chaotic_blocks() -> bool with Mut, Div, Panic {
    var ctx = eg_small_init()
    ctx.allow_inexact_reassoc = true
    ctx.chaotic = true
    return compiler_eg_satf_fadd_chain_merges(&! ctx) == 0
}

// T144: ocp_egraph_mini_pass skips when instr_count > 4 (returns func unchanged).
fn compiler_main_test_ocp_mini_pass_skip() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs[1] = ir_binop(3, 2, BinaryOp::OpMul, 0)
    instrs[2] = ir_binop(4, 3, BinaryOp::OpSub, 1)
    instrs[3] = ir_binop(5, 4, BinaryOp::OpDiv, 0)
    instrs[4] = ir_binop(6, 5, BinaryOp::OpAdd, 2)
    let func   = cp_make_test_func(instrs, 5)   // instr_count=5 > 4
    let result = ocp_egraph_mini_pass(func)
    // Guard fires: result identical to input (first binop still a binop)
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrBinOp && result.instr_count == 5
}

// T145: ocp_cse + DCE combined: 4-instr function with one duplicate.
//       After opt_cleanup, the duplicate binop is CSE'd → IrCopy → DCE'd.
fn compiler_main_test_ocp_cse_and_dce() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)   // r2 = r0 + r1
    instrs[1] = ir_binop(3, 0, BinaryOp::OpAdd, 1)   // r3 = r0 + r1 (dup → CSE → copy)
    instrs[2] = ir_return(3)                           // use r3
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_cse(func)
    // After CSE: instrs[1] is IrCopy(3, 2); r2 is now used by copy
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy
}

