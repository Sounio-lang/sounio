}

// T149: Both-constant OpLt: 7 < 3 → IrLoadImm(dst, 0)
fn compiler_main_test_cmp_lt_const_false() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 7)
    instrs[1] = ir_load_imm(1, 3)
