// ============================================================================
// STRING UTILITIES
// ============================================================================

fn pow10_idx(idx: i64) -> i64 {
    if idx == 0 { 1000000000000000000 }
    else if idx == 1 { 100000000000000000 }
    else if idx == 2 { 10000000000000000 }
    else if idx == 3 { 1000000000000000 }
    else if idx == 4 { 100000000000000 }
    else if idx == 5 { 10000000000000 }
    else if idx == 6 { 1000000000000 }
    else if idx == 7 { 100000000000 }
    else if idx == 8 { 10000000000 }
    else if idx == 9 { 1000000000 }
    else if idx == 10 { 100000000 }
    else if idx == 11 { 10000000 }
    else if idx == 12 { 1000000 }
    else if idx == 13 { 100000 }
    else if idx == 14 { 10000 }
    else if idx == 15 { 1000 }
    else if idx == 16 { 100 }
    else if idx == 17 { 10 }
    else { 1 }
}

fn digit_for_power(rem: i64, power: i64) -> i64 {
    if rem <= (0 - (9 * power)) { 9 }
    else if rem <= (0 - (8 * power)) { 8 }
    else if rem <= (0 - (7 * power)) { 7 }
    else if rem <= (0 - (6 * power)) { 6 }
    else if rem <= (0 - (5 * power)) { 5 }
    else if rem <= (0 - (4 * power)) { 4 }
    else if rem <= (0 - (3 * power)) { 3 }
    else if rem <= (0 - (2 * power)) { 2 }
    else if rem <= (0 - power) { 1 }
    else { 0 }
}

fn i64_to_digits_no_div(rem: i64, idx: i64, started: bool) -> string with Mut, Panic {
    if idx >= 19 {
        return ""
    }

    let power = pow10_idx(idx)
    let digit = digit_for_power(rem, power)
    let rem_next = rem + (digit * power)
    let emit = started || digit > 0 || idx == 18
    let head = if emit { char_from_i64(digit) } else { "" }
    head + i64_to_digits_no_div(rem_next, idx + 1, emit)
}

fn i64_to_string_no_div(n: i64) -> string with Mut, Panic {
    if n == 0 {
        return "0"
    }
    let negative = n < 0
    let rem = if negative { n } else { 0 - n }
    let digits = i64_to_digits_no_div(rem, 0, false)
    if negative { "-" + digits } else { digits }
}

fn char_from_i64_error(n: i64) -> string with Mut, Panic {
    "char_from_i64: digit must be 0-9, got " + i64_to_string_no_div(n)
}

fn parse_decimal_digit(ch: string) -> i64 {
    if str_eq(ch, "0") { 0 }
    else if str_eq(ch, "1") { 1 }
    else if str_eq(ch, "2") { 2 }
    else if str_eq(ch, "3") { 3 }
    else if str_eq(ch, "4") { 4 }
    else if str_eq(ch, "5") { 5 }
    else if str_eq(ch, "6") { 6 }
    else if str_eq(ch, "7") { 7 }
    else if str_eq(ch, "8") { 8 }
    else if str_eq(ch, "9") { 9 }
    else { -1 }
}

fn parse_nonnegative_i64(raw: string) -> i64 with Mut, Div {
    let len = str_len(raw)
    if len <= 0 {
        return -1
    }

    var i: i64 = 0
    var value: i64 = 0
    while i < len {
        let ch = str_slice(raw, i, i + 1)
        let d = parse_decimal_digit(ch)
        if d < 0 {
            return -1
        }
        value = value * 10 + d
        i = i + 1
    }
    value
}

fn parse_i64_decimal(raw: string) -> (bool, i64) with Mut, Div {
    let len = str_len(raw)
    if len <= 0 {
        return (false, 0)
    }

    if str_char_at(raw, 0) == 45 {
        if len == 1 {
            return (false, 0)
        }
        let tail = str_slice(raw, 1, len)
        let mag = parse_nonnegative_i64(tail)
        if mag < 0 {
            return (false, 0)
        }
        (true, 0 - mag)
    } else {
        let val = parse_nonnegative_i64(raw)
        if val < 0 {
            (false, 0)
        } else {
            (true, val)
        }
    }
}

fn run_int_to_string_bench(iterations: i64) -> i64 with Mut, Panic, Div {
    let i64_max = 9223372036854775807
    let i64_min = (0 - i64_max) - 1
    var checksum: i64 = 0
    var i: i64 = 0
    while i < iterations {
        var sample = (i * 1000003) - 500001
        if (i % 11) == 0 {
            sample = 0 - sample
        }
        if (i % 7919) == 0 {
            sample = i64_min
        }
        let rendered = int_to_string(sample)
        checksum = checksum + str_len(rendered)
        i = i + 1
    }
    checksum
}

// ============================================================================
// ARG LIST  (replaces Vec<string> for command-line args)
// ============================================================================

pub struct ArgList {
    items: [string; 64],
    len: i64,
}

fn arg_list_get(lst: ArgList, i: i64) -> string with Mut, Panic {
    if i < 0 || i >= lst.len {
        panic(arg_list_get_error(i, lst.len))
    }
    lst.items[i as usize]
}

fn arg_list_get_error(index: i64, len: i64) -> string with Mut, Panic {
    "arg_list_get: index " + i64_to_string_no_div(index) +
    " out of bounds (length " + i64_to_string_no_div(len) + ")"
}

fn run_int_to_string_bench_from_args(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div {
    var iterations: i64 = 1000000
    if flag_index + 1 < args.len {
        let parsed = parse_nonnegative_i64(arg_list_get(args, flag_index + 1))
        if parsed >= 0 {
            iterations = parsed
        }
    }
    let checksum = run_int_to_string_bench(iterations)
    println("bench_int_to_string iterations=" + int_to_string(iterations) +
            " checksum=" + int_to_string(checksum))
}

fn run_probe_char_from_i64(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div {
    if flag_index + 1 >= args.len {
        panic("probe_char_from_i64: missing integer argument")
    }
    let parsed = parse_i64_decimal(arg_list_get(args, flag_index + 1))
    if !parsed.0 {
        panic("probe_char_from_i64: invalid integer '" + arg_list_get(args, flag_index + 1) + "'")
    }
    print(char_from_i64(parsed.1))
}

fn run_probe_arg_list_get(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div {
    if flag_index + 1 >= args.len {
        panic("probe_arg_list_get: missing index argument")
    }
    let parsed = parse_i64_decimal(arg_list_get(args, flag_index + 1))
    if !parsed.0 {
        panic("probe_arg_list_get: invalid integer '" + arg_list_get(args, flag_index + 1) + "'")
    }
    let probe = ArgList {
        items: ["alpha", "beta", "gamma", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        len: 3,
    }
    print(arg_list_get(probe, parsed.1))
}

fn run_probe_compile_capture(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 1 >= args.len {
        panic("probe_compile_capture: missing source file argument")
    }
    let source_path = arg_list_get(args, flag_index + 1)
    var errors = compile_errors_new()
    if !file_exists(source_path) {
        errors = compile_errors_push(errors, compile_format_error_at(source_path, 0, 0, "could not read input file"))
    } else {
        let incomplete_assign = compile_scan_incomplete_assignment(source_path)
        if incomplete_assign.0 >= 0 {
            errors = compile_errors_push(
                errors,
                compile_format_error_at(source_path, incomplete_assign.0, incomplete_assign.1, "syntax appears incomplete after assignment")
            )
        }
    }

    if errors.len == 0 {
        println("probe_compile_capture: success")
    } else {
        println("probe_compile_capture: fail")
        var i: i64 = 0
        while i < errors.len {
            println(compile_errors_get(errors, i))
            i = i + 1
        }
    }
}

fn run_probe_load_ir(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 1 >= args.len {
        panic("probe_load_ir: missing source file argument")
    }
    let source_path = arg_list_get(args, flag_index + 1)
    println("probe_load_ir: begin")
    print("probe_load_ir: source=")
    print(source_path)
    print("\n")
    var trace = empty_load_multimodule_ir_trace()
    let fn_count = load_multimodule_ir_fn_count_traced(source_path, &! trace)
    let parse_errors = parser_last_error_count()
    if fn_count > 0 && parse_errors == 0 {
        println("probe_load_ir: ok")
        print("probe_load_ir: functions=")
        print_int(fn_count)
        print("\n")
        return
    }
    println("probe_load_ir: fail")
    if fn_count <= 0 {
        print("probe_load_ir: error=ir_load_failed\n")
    }
    if parse_errors > 0 {
        println("probe_load_ir: parser_errors=" + int_to_string(parse_errors))
    }
    panic("probe_load_ir failed")
}

// Internal regression witness for the public single-module lowering entrypoint.
fn run_probe_monolithic_public_lower_call(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 1 >= args.len {
        panic("probe_monolithic_public_lower_call: missing source file argument")
    }
    let source_path = arg_list_get(args, flag_index + 1)
    let program = load_module_file(source_path)
    if parser_last_error_count() > 0 {
        panic("probe_monolithic_public_lower_call: parse failed")
    }

    var epistemic = ir_empty_epistemic_section()
    if !check_program_epistemic_into(program, &! epistemic) {
        panic("probe_monolithic_public_lower_call: check failed")
    }

    lower_monolithic_public_probe_trace_set(true)
    println("probe_monolithic_public_lower_call: lower_begin")
    let lowered = lower_program_to_ir(program)
    println("probe_monolithic_public_lower_call: lower_done")
    lower_monolithic_public_probe_trace_set(false)
    let module = lowered.module

    var bss_globals: i64 = 0
    var main_fn: i64 = -1
    var fi: i64 = 0
    while fi < module.fn_count {
        let func = module.functions[fi as usize]
        if func.compile_strategy == IR_STRATEGY_BSS_GLOBAL {
            bss_globals = bss_globals + 1
        }
        if ir_name_eq(func.name, make_name("main")) {
            main_fn = fi
        }
        fi = fi + 1
    }

    var f64_adds: i64 = 0
    var i64_adds: i64 = 0
    if main_fn >= 0 {
        let func = module.functions[main_fn as usize]
        var ii: i64 = 0
        while ii < func.instr_count {
            let instr = func.instrs[ii as usize]
            if instr.op == IrOpcode::IrBinOp && instr.bin_op == BinaryOp::OpAdd {
                if instr.imm_flags == 6 {
                    f64_adds = f64_adds + 1
                } else if instr.imm_flags == 0 {
                    i64_adds = i64_adds + 1
                }
            }
            ii = ii + 1
        }
    }

    print("monolithic_public_lower_call: bss_globals=")
    print_int(bss_globals)
    print(" bss_bytes=")
    print_int(module.bss_total_size)
    print(" f64_adds=")
    print_int(f64_adds)
    print(" i64_adds=")
    print_int(i64_adds)
    print("\n")

    if lowered.had_error {
        panic("probe_monolithic_public_lower_call: lower reported errors")
    }
    println("MONOLITHIC_PUBLIC_LOWER_CALL PASS")
}

fn probe_frontend_strategy_print_name_local(name: Name) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < name.len {
        print_char(name.buf[i] as i64)
        i = i + 1
    }
}

fn probe_frontend_strategy_has_effect_local(effects: Option<Box<EffectList>>, target: string) -> bool with Mut, Panic, Div {
    match effects {
        Some(node) => {
            let list = *node
            let eff = list.head
            var matches = true
            let tlen = str_len(target)
            if eff.name_len != tlen {
                matches = false
            } else {
                var i: i64 = 0
                while i < tlen {
                    if eff.name_buf[i as usize] != (str_char_at(target, i) as i8) {
                        matches = false
                    }
                    i = i + 1
                }
            }
            if matches { true } else { probe_frontend_strategy_has_effect_local(list.tail, target) }
        }
        None => false,
    }
}

fn probe_frontend_strategy_from_signature_local(
    return_type: Option<Box<TypeExpr>>,
    effects: Option<Box<EffectList>>
) -> i64 with Mut, Panic, Div {
    if probe_frontend_strategy_has_effect_local(effects, "GPU") {
        return IR_STRATEGY_GPU_KERNEL
    }
    if probe_frontend_strategy_has_effect_local(effects, "Prob") {
        return IR_STRATEGY_PROBABILISTIC
    }
    match return_type {
        Some(node) => {
            let ty = *node
            if ty.kind == TypeExprKind::TypeValidated {
                IR_STRATEGY_AGGRESSIVE
            } else if ty.kind == TypeExprKind::TypeKnowledge {
                IR_STRATEGY_PRECISION_PRESERVING
            } else if ty.kind == TypeExprKind::TypeContest || ty.kind == TypeExprKind::TypeRobust {
                IR_STRATEGY_INSTRUMENTED
            } else {
                IR_STRATEGY_STANDARD
            }
        }
        None => IR_STRATEGY_STANDARD,
    }
}

fn probe_frontend_strategy_param_count_local(params: Option<Box<ParamList>>) -> i64 with Alloc {
    match params {
        Some(node) => {
            let list = *node
            1 + probe_frontend_strategy_param_count_local(list.tail)
        }
        None => 0,
    }
}

fn probe_frontend_strategy_count_fn_items_local(items: Option<Box<ItemList>>) -> i64 with Alloc {
    match items {
        Some(list) => {
            let rest = probe_frontend_strategy_count_fn_items_local((*list).tail)
            if (*list).head.kind == ItemKind::ItemFn { 1 + rest } else { rest }
        }
        None => 0,
    }
}

fn probe_frontend_strategy_print_items_local(items: Option<Box<ItemList>>) with IO, Mut, Panic, Div, Alloc {
    match items {
        Some(list) => {
            let item = (*list).head
            if item.kind == ItemKind::ItemFn {
                match item.fn_def {
                    Some(node) => {
                        let fn_def = *node
                        let strategy = probe_frontend_strategy_from_signature_local(fn_def.return_type, fn_def.effects)
                        let user_param_count = probe_frontend_strategy_param_count_local(fn_def.params)
                        let validated_param = strategy == IR_STRATEGY_INSTRUMENTED
                        let final_param_count = if validated_param { user_param_count + 1 } else { user_param_count }
                        print("probe_frontend_strategy: fn=")
                        probe_frontend_strategy_print_name_local(item.name)
                        print(" strategy=")
                        print(ir_strategy_name(strategy))
                        print(" validated_param=")
                        if validated_param { print("true") } else { print("false") }
                        print(" param_count=")
                        print_int(final_param_count)
                        print("\n")
                    }
                    None => {}
                }
            }
            probe_frontend_strategy_print_items_local((*list).tail)
        }
        None => {}
    }
}

fn run_probe_frontend_strategy(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 1 >= args.len {
        panic("probe_frontend_strategy: missing source file argument")
    }
    let source_path = arg_list_get(args, flag_index + 1)
    println("probe_frontend_strategy: begin")
    print("probe_frontend_strategy: source=")
    print(source_path)
    print("\n")
    let frontend_result = preflight_multimodule_frontend(source_path)
    let parse_errors = parser_last_error_count()
    if frontend_result.ok && parse_errors == 0 {
        let main_prog = load_module_file(source_path)
        println("probe_frontend_strategy: ok")
        print("probe_frontend_strategy: functions=")
        print_int(probe_frontend_strategy_count_fn_items_local(main_prog.items))
        print("\n")
        probe_frontend_strategy_print_items_local(main_prog.items)
        return
    }
    println("probe_frontend_strategy: fail")
    if str_len(frontend_result.error_msg) > 0 {
        print("probe_frontend_strategy: error=")
        print(frontend_result.error_msg)
        print("\n")
    }
    if parse_errors > 0 {
        println("probe_frontend_strategy: parser_errors=" + int_to_string(parse_errors))
    }
    panic("probe_frontend_strategy failed")
}

fn run_probe_load_ir_trace(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 1 >= args.len {
        panic("probe_load_ir_trace: missing source file argument")
    }
    let source_path = arg_list_get(args, flag_index + 1)
    println("probe_load_ir_trace: begin")
    print("probe_load_ir_trace: source=")
    print(source_path)
    print("\n")
    var trace = empty_load_multimodule_ir_trace()
    let fn_count = load_multimodule_ir_fn_count_traced(source_path, &! trace)
    let ir_ok = fn_count > 0
    let parse_errors = parser_last_error_count()
    print("probe_load_ir_trace: stage=")
    print(trace.last_stage)
    print(" modules=")
    print_int(trace.loaded_modules)
    print(" lowered=")
    print_int(trace.lowered_modules)
    print(" body_lowered=")
    print_int(trace.body_lowered_modules)
    print(" patched_calls=")
    print_int(trace.patched_calls)
    print(" fallback_insertions=")
    print_int(trace.fallback_insertions)
    print("\n")
    print("probe_load_ir_trace: resolved=")
    print_int(trace.resolved_modules)
    print(" typechecked=")
    print_int(trace.typechecked_modules)
    print(" merged=")
    print_int(trace.merged_modules)
    print(" patched_functions=")
    print_int(trace.patched_functions)
    print(" last_module_index=")
    print_int(trace.last_module_index)
    print("\n")
    if ir_ok && parse_errors == 0 {
        println("probe_load_ir_trace: ok")
        return
    }
    println("probe_load_ir_trace: fail")
    if !ir_ok {
        print("probe_load_ir_trace: error=ir_load_failed\n")
    }
    if parse_errors > 0 {
        println("probe_load_ir_trace: parser_errors=" + int_to_string(parse_errors))
    }
    panic("probe_load_ir_trace failed")
}

fn run_probe_ir_callsite(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 3 >= args.len {
        panic("probe_ir_callsite: expected <source.sio> <caller_fn> <callee_fn>")
    }
    let source_path = arg_list_get(args, flag_index + 1)
    let caller_name_str = arg_list_get(args, flag_index + 2)
    let callee_name_str = arg_list_get(args, flag_index + 3)
    run_frontend_callsite_probe(source_path, caller_name_str, callee_name_str)
}

fn run_probe_ir_opt_strategy(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 1 >= args.len {
        panic("probe_ir_opt_strategy: missing source file argument")
    }
    let source_path = arg_list_get(args, flag_index + 1)
    println("probe_ir_opt_strategy: begin")
    print("probe_ir_opt_strategy: source=")
    print(source_path)
    print("\n")
    let ir_result = load_multimodule_ir(source_path)
    let parse_errors = parser_last_error_count()
    if ir_result.ok && parse_errors == 0 {
        println("probe_ir_opt_strategy: ok")
        print("probe_ir_opt_strategy: functions=")
        print_int((*ir_result.module).fn_count)
        print("\n")
        var fi: i64 = 0
        while fi < (*ir_result.module).fn_count {
            let func = (*ir_result.module).functions[fi as usize]
            print("probe_ir_opt_strategy: fn=")
            compiler_manifest_print_name(func.name)
            print(" strategy=")
            print(ir_strategy_name(func.compile_strategy))
            if func.compile_strategy == IR_STRATEGY_INSTRUMENTED {
                let transformed = ir_opt_apply_strategy(func)
                let dispatch_label = ir_opt_max_label(func) + 1
                let instr_label = dispatch_label + 1
                let merge_label = dispatch_label + 2
                print(" transformed_instrs=")
                print_int(func.instr_count)
                print("->")
                print_int(transformed.instr_count)
                print(" labels=")
                print_int(func.label_count)
                print("->")
                print_int(transformed.label_count)
                print(" merge_result_vreg=")
                print_int(ir_opt_find_return_vreg(func))
                print(" dispatch_label=")
                print_int(dispatch_label)
                print(" instr_label=")
                print_int(instr_label)
                print(" merge_label=")
                print_int(merge_label)
            }
            print("\n")
            fi = fi + 1
        }
        return
    }
    println("probe_ir_opt_strategy: fail")
    if !ir_result.ok && str_len(ir_result.error_msg) > 0 {
        print("probe_ir_opt_strategy: error=")
        print(ir_result.error_msg)
        print("\n")
    }
    if parse_errors > 0 {
        println("probe_ir_opt_strategy: parser_errors=" + int_to_string(parse_errors))
    }
    panic("probe_ir_opt_strategy failed")
}

// A/B witness for the wide MultiModuleIrResult return boundary. Keep the
// legacy probe above intact while the boxed front-half path proves causality.
fn run_probe_ir_opt_strategy_boxed(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 1 >= args.len {
        panic("probe_ir_opt_strategy_boxed: missing source file argument")
    }
    let source_path = arg_list_get(args, flag_index + 1)
    println("probe_ir_opt_strategy_boxed: begin")
    print("probe_ir_opt_strategy_boxed: source=")
    print(source_path)
    print("\n")
    var trace = empty_load_multimodule_ir_trace()
    let lower_result = bridge_lower_single_module_box(source_path, &! trace)
    let parse_errors = parser_last_error_count()
    if lower_result.ok && parse_errors == 0 {
        match lower_result.module {
            Some(module_box) => {
                println("probe_ir_opt_strategy_boxed: ok")
                print("probe_ir_opt_strategy_boxed: functions=")
                print_int((*module_box).fn_count)
                print("\n")
                var fi: i64 = 0
                while fi < (*module_box).fn_count {
                    let func = (*module_box).functions[fi as usize]
                    print("probe_ir_opt_strategy_boxed: fn=")
                    compiler_manifest_print_name(func.name)
                    print(" strategy=")
                    print(ir_strategy_name(func.compile_strategy))
                    if func.compile_strategy == IR_STRATEGY_INSTRUMENTED {
                        let transformed = ir_opt_apply_strategy(func)
                        let dispatch_label = ir_opt_max_label(func) + 1
                        let instr_label = dispatch_label + 1
                        let merge_label = dispatch_label + 2
                        print(" transformed_instrs=")
                        print_int(func.instr_count)
                        print("->")
                        print_int(transformed.instr_count)
                        print(" labels=")
                        print_int(func.label_count)
                        print("->")
                        print_int(transformed.label_count)
                        print(" merge_result_vreg=")
                        print_int(ir_opt_find_return_vreg(func))
                        print(" dispatch_label=")
                        print_int(dispatch_label)
                        print(" instr_label=")
                        print_int(instr_label)
                        print(" merge_label=")
                        print_int(merge_label)
                    }
                    var ii: i64 = 0
                    while ii < func.instr_count {
                        let instr = func.instrs[ii as usize]
                        if instr.op == IrOpcode::IrContest {
                            print(" ir_contest_index=")
                            print_int(ii)
                            print(" ir_contest_label_id=")
                            print_int(instr.label_id)
                            print(" ir_contest_model_count=")
                            print_int(instr.imm_i64)
                        }
                        ii = ii + 1
                    }
                    print("\n")
                    fi = fi + 1
                }
                return
            }
            None => {
                panic("probe_ir_opt_strategy_boxed: missing boxed module")
            }
        }
    }
    println("probe_ir_opt_strategy_boxed: fail")
    if str_len(lower_result.error_msg) > 0 {
        print("probe_ir_opt_strategy_boxed: error=")
        print(lower_result.error_msg)
        print("\n")
    }
    if parse_errors > 0 {
        println("probe_ir_opt_strategy_boxed: parser_errors=" + int_to_string(parse_errors))
    }
    panic("probe_ir_opt_strategy_boxed failed")
}

