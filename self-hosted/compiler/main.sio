// Sprint 127 Block AO: Absorption laws (T428-T433).
// SOTA: Huntington 1904 absorption axiom; LLVM InstCombineAndOrXor.cpp.

// T428: a | (a & C) → IrCopy(a) [constant-operand absorption].
fn compiler_main_test_absorption_or_and_const() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 42)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitAnd, 1)   // r2 = r0 & 42
    instrs[2] = ir_binop(3, 0, BinaryOp::OpBitOr, 2)    // r3 = r0 | r2
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (2))) as usize] == 0
}

// T429: (a & C) | a → IrCopy(a) [commutative absorption].
fn compiler_main_test_absorption_and_const_or_a() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 42)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitAnd, 1)   // r2 = r0 & 42
    instrs[2] = ir_binop(3, 2, BinaryOp::OpBitOr, 0)    // r3 = r2 | r0
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (2))) as usize] == 0
}

// T430: a & (a | C) → IrCopy(a) [dual absorption].
fn compiler_main_test_absorption_and_or_const() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 42)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitOr, 1)    // r2 = r0 | 42
    instrs[2] = ir_binop(3, 0, BinaryOp::OpBitAnd, 2)   // r3 = r0 & r2
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (2))) as usize] == 0
}

// T431: a | (a & b) → IrCopy(a) [register-register absorption].
fn compiler_main_test_absorption_or_and_rr() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpBitAnd, 1)   // r2 = r0 & r1
    instrs[1] = ir_binop(3, 0, BinaryOp::OpBitOr, 2)    // r3 = r0 | r2
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 0
}

// T432: a & (a | b) → IrCopy(a) [register-register dual absorption].
fn compiler_main_test_absorption_and_or_rr() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpBitOr, 1)    // r2 = r0 | r1
    instrs[1] = ir_binop(3, 0, BinaryOp::OpBitAnd, 2)   // r3 = r0 & r2
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 0
}

// T433: a | (c & b) → no fold [different base, negative test].
fn compiler_main_test_absorption_different_base_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(3, 1, BinaryOp::OpBitAnd, 2)   // r3 = r1 & r2
    instrs[1] = ir_binop(4, 0, BinaryOp::OpBitOr, 3)    // r4 = r0 | r3  (r0 != r1 and r0 != r2)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(result.region, (1))) as usize] as BinaryOp) == BinaryOp::OpBitOr
}

// Sprint 128 Block AP: Idempotent subsumption (T434-T439).
// SOTA: Boolean algebra idempotent law; Hacker's Delight §2-1.

// T434: (a | b) | a → IrCopy(a | b).
fn compiler_main_test_subsumption_or_or_lhs() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpBitOr, 1)    // r2 = r0 | r1
    instrs[1] = ir_binop(3, 2, BinaryOp::OpBitOr, 0)    // r3 = r2 | r0
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 2
}

// T435: (a | b) | b → IrCopy(a | b).
fn compiler_main_test_subsumption_or_or_rhs() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpBitOr, 1)    // r2 = r0 | r1
    instrs[1] = ir_binop(3, 2, BinaryOp::OpBitOr, 1)    // r3 = r2 | r1
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 2
}

// T436: (a & b) & a → IrCopy(a & b).
fn compiler_main_test_subsumption_and_and_lhs() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpBitAnd, 1)   // r2 = r0 & r1
    instrs[1] = ir_binop(3, 2, BinaryOp::OpBitAnd, 0)   // r3 = r2 & r0
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 2
}

// T437: (a & b) & b → IrCopy(a & b).
fn compiler_main_test_subsumption_and_and_rhs() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpBitAnd, 1)   // r2 = r0 & r1
    instrs[1] = ir_binop(3, 2, BinaryOp::OpBitAnd, 1)   // r3 = r2 & r1
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 2
}

// T438: a | (a | b) → IrCopy(a | b) [commutative subsumption].
fn compiler_main_test_subsumption_a_or_ab() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpBitOr, 1)    // r2 = r0 | r1
    instrs[1] = ir_binop(3, 0, BinaryOp::OpBitOr, 2)    // r3 = r0 | r2
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 2
}

// T439: (a | b) | c → no fold [c not in {a, b}, negative test].
fn compiler_main_test_subsumption_different_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(3, 0, BinaryOp::OpBitOr, 1)    // r3 = r0 | r1
    instrs[1] = ir_binop(4, 3, BinaryOp::OpBitOr, 2)    // r4 = r3 | r2  (r2 != r0 and r2 != r1)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(result.region, (1))) as usize] as BinaryOp) == BinaryOp::OpBitOr
}

// Sprint 129 Block AQ: Register-register inverse cancellation (T440-T445).
// SOTA: LLVM InstCombine algebraic identity; group-theoretic inverse.

// T440: (a + b) - b → IrCopy(a) [additive inverse].
fn compiler_main_test_rr_add_sub_rhs() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)      // r2 = r0 + r1
    instrs[1] = ir_binop(3, 2, BinaryOp::OpSub, 1)      // r3 = r2 - r1
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 0
}

// T441: (a + b) - a → IrCopy(b) [commutative additive inverse].
fn compiler_main_test_rr_add_sub_lhs() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)      // r2 = r0 + r1
    instrs[1] = ir_binop(3, 2, BinaryOp::OpSub, 0)      // r3 = r2 - r0
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 1
}

// T442: (a * b) / b → IrCopy(a) [multiplicative inverse].
fn compiler_main_test_rr_mul_div_rhs() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpMul, 1)      // r2 = r0 * r1
    instrs[1] = ir_binop(3, 2, BinaryOp::OpDiv, 1)      // r3 = r2 / r1
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 0
}

// T443: (a * b) / a → IrCopy(b) [commutative multiplicative inverse].
fn compiler_main_test_rr_mul_div_lhs() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpMul, 1)      // r2 = r0 * r1
    instrs[1] = ir_binop(3, 2, BinaryOp::OpDiv, 0)      // r3 = r2 / r0
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize] == 1
}

// T444: (a + b) - c → no fold [c ≠ a and c ≠ b, negative test].
fn compiler_main_test_rr_add_sub_different_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(3, 0, BinaryOp::OpAdd, 1)      // r3 = r0 + r1
    instrs[1] = ir_binop(4, 3, BinaryOp::OpSub, 2)      // r4 = r3 - r2  (r2 != r0, r2 != r1)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(result.region, (1))) as usize] as BinaryOp) == BinaryOp::OpSub
}

// T445: (a + b) + b → no fold [wrong operation, addition not subtraction].
fn compiler_main_test_rr_add_add_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)      // r2 = r0 + r1
    instrs[1] = ir_binop(3, 2, BinaryOp::OpAdd, 1)      // r3 = r2 + r1  (add, not sub)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(result.region, (1))) as usize] as BinaryOp) == BinaryOp::OpAdd
}

// ============================================================================
// Sprint 121: sin/cos minimax builtins (T446-T451)
