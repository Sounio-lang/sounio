fn compiler_main_test_xor_or_no_fold_const_mismatch() -> bool with Mut, Div, Panic {
    // (x^5) | 3 → no fold: OR constant (3) differs from XOR constant (5)
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
