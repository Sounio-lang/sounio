        println("  FAIL: T115 same-register sub round-trip")
    }

    if compiler_main_test_alg_comm_sr_via_copy_prop() {
        println("  T116 OK: copy-prop + left-constant SR: r0=4; r1=copy(r0); r1 * x → x << 2")
        passed = passed + 1
