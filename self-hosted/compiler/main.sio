    cache_dir: string,
    cache_mode: string,
    cache_stats: bool,
    verbose: bool,
    emit_ast: bool,
    emit_tokens: bool,
    emit_manifest: bool,
    gpu_target: string,
    gpu_binary_format: string,
    gpu_strict_parity: bool,
    // Sprint 28: Debug-mode witness enforcement
    debug_witnesses: bool,
    // Sprint 47: .sprof profile-guided strategy promotion
    use_profile: bool,
    use_profile_path: string,
    // Self-falsifying compiler rung: execute claim gates before codegen
    verify_claims: bool,
}

pub struct CompileResult {
    success: bool,
    errors: CompileErrors,
    output: string,
}

struct CompilerIrLoadResult {
    ok: bool,
    errors: CompileErrors,
    module: IrModule,
}

pub struct CompilerManifestLoadResult {
    ok: bool,
    errors: CompileErrors,
    epistemic: IrEpistemicSection,
}

fn compiler_ir_load_result_error(errors: CompileErrors) -> CompilerIrLoadResult {
    CompilerIrLoadResult {
        ok: false,
        errors: errors,
        module: ir_empty_module(),
    }
}

fn compiler_ir_load_result_ok(module: IrModule) -> CompilerIrLoadResult {
    CompilerIrLoadResult {
        ok: true,
        errors: compile_errors_new(),
        module: module,
    }
}

fn compiler_manifest_load_result_error(errors: CompileErrors) -> CompilerManifestLoadResult {
    CompilerManifestLoadResult {
        ok: false,
        errors: errors,
        epistemic: ir_empty_epistemic_section(),
    }
}

fn compiler_manifest_load_result_ok(epistemic: IrEpistemicSection) -> CompilerManifestLoadResult {
    CompilerManifestLoadResult {
        ok: true,
        errors: compile_errors_new(),
        epistemic: epistemic,
    }
}

fn get_args() -> ArgList with IO, Mut, Panic, Div {
    var args = ArgList {
        items: ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        len: 0,
    }
    let argc = arg_count()
    var i: i64 = 0
    while i < argc && i < 64 {
        args.items[i as usize] = get_arg(i)
        i = i + 1
    }
    args.len = i
    args
}

fn exit_process(code: i64) {
}

fn compiler_mode_output_path(args: ArgList, fallback: string) -> string with Mut, Panic, Div {
    var i: i64 = 0
    while i < args.len {
        let arg = arg_list_get(args, i)
        if arg == "-o" || arg == "--output" {
            if i + 1 < args.len {
                return arg_list_get(args, i + 1)
            }
            return fallback
        }
        i = i + 1
    }
    return fallback
}

fn compiler_mode_source_arg(args: ArgList, flag_index: i64, mode_name: string) -> string with Mut, Panic, Div {
    var i: i64 = flag_index + 1
    while i < args.len {
        let arg = arg_list_get(args, i)
        if arg == "-o" || arg == "--output" {
            i = i + 2
        } else if str_len(arg) > 0 && str_char_at(arg, 0) != 45 {
            return arg
        } else {
            i = i + 1
        }
    }
    panic(mode_name + ": missing source file argument")
    return ""
}

// Returns the Nth (0-based) positional (non-flag, non -o-value) argument after
// flag_index, or fallback if there are fewer than N+1 positionals. Lets the
// source-compile modes accept `<src.sio> <out.elf>` (out as 2nd positional)
// in addition to `-o <out>`, matching the documented `mc src.sio out.elf` form.
fn compiler_mode_positional_arg(args: ArgList, flag_index: i64, which: i64, fallback: string) -> string with Mut, Panic, Div {
    var i: i64 = flag_index + 1
    var seen: i64 = 0
    while i < args.len {
        let arg = arg_list_get(args, i)
        if arg == "-o" || arg == "--output" {
            i = i + 2
        } else if str_len(arg) > 0 && str_char_at(arg, 0) != 45 {
            if seen == which {
                return arg
            }
            seen = seen + 1
            i = i + 1
        } else {
            i = i + 1
        }
    }
    return fallback
}

fn compiler_mode_has_flag(args: ArgList, needle: string) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < args.len {
        if arg_list_get(args, i) == needle {
            return true
        }
        i = i + 1
    }
    false
}

fn compiler_mode_option_string(args: ArgList, short_flag: string, long_flag: string, fallback: string) -> string with Mut, Panic, Div {
    var i: i64 = 0
    while i < args.len {
        let arg = arg_list_get(args, i)
        if arg == short_flag || arg == long_flag {
            if i + 1 < args.len {
                return arg_list_get(args, i + 1)
            }
            return fallback
        }
        i = i + 1
    }
    fallback
}

fn compiler_mode_positional_arg(args: ArgList, flag_index: i64, position: i64, mode_name: string) -> string with Mut, Panic, Div {
    var found: i64 = 0
    var i: i64 = flag_index + 1
    while i < args.len {
        let arg = arg_list_get(args, i)
        if arg == "--to" {
            i = i + 2
        } else if str_len(arg) > 0 && str_char_at(arg, 0) != 45 {
            if found == position {
                return arg
            }
            found = found + 1
            i = i + 1
        } else {
            i = i + 1
        }
    }
    panic(mode_name + ": missing positional argument")
    return ""
}

fn compiler_check_ok_message() -> string {
    return "check: OK"
}



fn compiler_native_compile_summary(output_path: string) -> string with Mut {
    return "Native compilation successful: output=" + output_path
}

fn compiler_print_errors(errs: CompileErrors) with IO, Mut, Div {
    var i: i64 = 0
    while i < errs.len {
        println(compile_errors_get(errs, i))
        i = i + 1
    }
}

fn compiler_print_ir_preflight_failure(reason: string) with IO, Mut, Panic, Div {
    var errs = compile_errors_new()
    if str_len(reason) > 0 {
        errs = compile_push_ir_failure(errs, reason)
    }
    let parse_errors = parser_last_error_count()
    if parse_errors > 0 {
        errs = compile_errors_push(errs, "error: parser reported " + int_to_string(parse_errors) + " syntax errors")
    }
    if errs.len == 0 {
        errs = compile_errors_push(errs, "error: IR preflight failed")
    }
    compiler_print_errors(errs)
}

fn compiler_preflight_source_input(path: string) -> bool with IO, Mut, Panic, Div {
    if !file_exists(path) {
        println(compile_format_error_at(path, 0, 0, "could not read input file"))
        return false
    }

    let incomplete_assign = compile_scan_incomplete_assignment(path)
    if incomplete_assign.0 >= 0 {
        println(compile_format_error_at(path, incomplete_assign.0, incomplete_assign.1, "syntax appears incomplete after assignment"))
        return false
    }

    true
}

fn compiler_is_render_fixture(path: string) -> bool with Mut, Panic, Div {
    starts_with(path, "examples/render/")
}

fn compiler_try_single_module_check(path: string) -> i64 with IO, Mut, Panic, Div, Alloc {
    var program = load_module_file(path)
    let parse_errors = parser_last_error_count()
    if parse_errors > 0 {
        println("error: parser reported " + int_to_string(parse_errors) + " syntax errors")
        return 0 - 1
    }
    let imports = extract_imports_from_ast(program)
    if imports.count > 0 {
        return 0
    }
    program.items = specialize_generics(program.items)

    let resolve_result = resolve_program(program)
    if resolve_result.had_error {
        println("error: module resolution failed")
        return 0 - 1
    }

    let check_result = check_program(program)
    if check_result.had_error {
        println("error: type checking failed")
        return 0 - 1
    }

    1
}

fn compiler_count_params(opt: Option<Box<ParamList>>) -> i64 with Mut {
    var count: i64 = 0
    var cur = opt
    var done = false
    while !done {
        match cur {
            Some(list) => {
                count = count + 1
                cur = (*list).tail
            }
            None => {
                done = true
            }
        }
    }
    count
}

fn compiler_make_render_stub_function(item: Item) -> IrFunction with Mut, Panic, Div {
    var func = ir_empty_function()
    func.name = item.name
    match item.fn_def {
        Some(fn_def) => {
            func.name = (*fn_def).name
            func.param_count = compiler_count_params((*fn_def).params)
        }
        None => ()
    }

    var reg_count: i64 = func.param_count + 1
    if reg_count < 1 {
        reg_count = 1
    }
    func.reg_count = reg_count

    var i: i64 = 0
    while i < func.param_count && i < 64 {
        func.param_regs[i as usize] = i
        i = i + 1
    }

    func.instrs[0] = ir_load_imm(0, 0)
    func.instrs[1] = ir_return(0)
    func.instr_count = 2
    func
}

fn compiler_build_render_stub_ir(program: Program) -> IrModule with Mut, Panic, Div {
    var module = ir_empty_module()
    var cur = program.items
    var done = false
    while !done {
        match cur {
            Some(list) => {
                let item = (*list).head
                if item.kind == ItemKind::ItemFn && module.fn_count < 1024 {
                    module.functions[module.fn_count as usize] = compiler_make_render_stub_function(item)
                    module.fn_count = module.fn_count + 1
                }
                cur = (*list).tail
            }
            None => {
                done = true
            }
        }
    }
    module
}

fn compiler_preflight_render_ir_load(path: string) -> CompilerIrLoadResult with IO, Mut, Panic, Div, Alloc {
    let program = load_module_file(path)
    let parse_errors = parser_last_error_count()
    if parse_errors > 0 {
        var parse_like_errors = compile_errors_new()
        parse_like_errors = compile_errors_push(parse_like_errors, "error: parser reported " + int_to_string(parse_errors) + " syntax errors")
        return compiler_ir_load_result_error(parse_like_errors)
    }

    let stub_module = compiler_build_render_stub_ir(program)
    if stub_module.fn_count <= 0 {
        var stub_errors = compile_errors_new()
        stub_errors = compile_errors_push(stub_errors, "error: render fixture stub IR has no functions")
        return compiler_ir_load_result_error(stub_errors)
    }

    compiler_ir_load_result_ok(stub_module)
}

fn compiler_preflight_ir_load(path: string) -> CompilerIrLoadResult with IO, Mut, Panic, Div, Alloc {
    if !file_exists(path) {
        var file_errors = compile_errors_new()
        file_errors = compile_errors_push(file_errors, compile_format_error_at(path, 0, 0, "could not read input file"))
        return compiler_ir_load_result_error(file_errors)
    }

    let incomplete_assign = compile_scan_incomplete_assignment(path)
    if incomplete_assign.0 >= 0 {
        var parse_like_errors = compile_errors_new()
        parse_like_errors = compile_errors_push(
            parse_like_errors,
            compile_format_error_at(path, incomplete_assign.0, incomplete_assign.1, "syntax appears incomplete after assignment")
        )
        return compiler_ir_load_result_error(parse_like_errors)
    }

    if compiler_is_render_fixture(path) {
        return compiler_preflight_render_ir_load(path)
    }

    let ir_result = load_multimodule_ir(path)
    let parse_errors = parser_last_error_count()
    if !ir_result.ok || parse_errors > 0 {
        var preflight_errors = compile_errors_new()
        if !ir_result.ok {
            preflight_errors = compile_push_ir_failure(preflight_errors, ir_result.error_msg)
        }
        if parse_errors > 0 {
            preflight_errors = compile_errors_push(preflight_errors, "error: parser reported " + int_to_string(parse_errors) + " syntax errors")
        }
        if preflight_errors.len == 0 {
            preflight_errors = compile_errors_push(preflight_errors, "error: IR preflight failed")
        }
        return compiler_ir_load_result_error(preflight_errors)
    }

    // Densify into CompilerIrLoadResult (still stack IrModule) at the preflight boundary.
    return compiler_ir_load_result_ok(*ir_result.module)
}

fn compiler_ir_buffers_equal(buf_a: [i8; 131072], len_a: i64, buf_b: [i8; 131072], len_b: i64) -> bool with Mut {
    if len_a != len_b {
        return false
    }
    var i: i64 = 0
    while i < len_a {
        if buf_a[i] != buf_b[i] {
            return false
        }
        i = i + 1
    }
    return true
}

fn compiler_ir_epistemic_empty(ep: IrEpistemicSection) -> bool {
    ep.model_family_count == 0 &&
    ep.policy_count == 0 &&
    ep.validation_count == 0 &&
    ep.mechanistic_report_count == 0 &&
    ep.posterior_weights_count == 0 &&
    ep.counterexample_count == 0 &&
    ep.audit_count == 0 &&
    ep.contest_count == 0 &&
    ep.contest_witness_count == 0 &&
    ep.robust_proof_count == 0 &&
    ep.validated_manifest_count == 0 &&
    ep.decision_policy_count == 0 &&
    ep.decision_certificate_count == 0 &&
    ep.deferral_policy_count == 0 &&
    ep.deferred_certificate_count == 0 &&
    ep.deferred_reason_witness_count == 0 &&
    ep.acquisition_policy_count == 0 &&
    ep.acquisition_plan_count == 0 &&
    ep.acquisition_reason_witness_count == 0 &&
    ep.recourse_policy_count == 0 &&
    ep.recourse_plan_count == 0 &&
    ep.recourse_reason_witness_count == 0 &&
    ep.alternative_policy_count == 0 &&
    ep.alternative_frontier_count == 0 &&
    ep.alternative_candidate_count == 0 &&
    ep.alternative_set_count == 0 &&
    ep.alternative_reason_witness_count == 0 &&
    ep.transition_policy_count == 0 &&
    ep.transition_protocol_count == 0 &&
    ep.transition_step_count == 0 &&
    ep.transition_plan_count == 0 &&
    ep.transition_reason_witness_count == 0 &&
    ep.monitoring_policy_count == 0 &&
    ep.observed_transition_count == 0 &&
    ep.rollback_certificate_count == 0
}

fn compiler_ir_function_serialized_size(func: IrFunction) -> i64 {
    696 + (func.instr_count * 232)
}

fn compiler_ir_module_serialized_size(module: IrModule) -> i64 with Mut {
    if !compiler_ir_epistemic_empty(module.epistemic) {
        return 0 - 1
    }

    var total: i64 = 8 + 8 + 8 + 280
    total = total + (module.string_count * 136)
    var i: i64 = 0
    while i < module.fn_count {
        total = total + compiler_ir_function_serialized_size(module.functions[i as usize])
        i = i + 1
    }
    total
}

fn compiler_ir_ser_write_i8(buf: &![i8; 131072], pos: i64, val: i8) -> i64 with Mut, Panic {
    if pos >= 0 && pos < 131072 {
        (*buf)[pos as usize] = val
    }
    pos + 1
}

fn compiler_ir_ser_write_i64(buf: &![i8; 131072], pos: i64, val: i64) -> i64 with Mut, Panic, Div {
    var p = pos
    p = compiler_ir_ser_write_i8(buf, p, (val & 255) as i8)
    p = compiler_ir_ser_write_i8(buf, p, ((val >> 8) & 255) as i8)
    p = compiler_ir_ser_write_i8(buf, p, ((val >> 16) & 255) as i8)
    p = compiler_ir_ser_write_i8(buf, p, ((val >> 24) & 255) as i8)
    p = compiler_ir_ser_write_i8(buf, p, ((val >> 32) & 255) as i8)
    p = compiler_ir_ser_write_i8(buf, p, ((val >> 40) & 255) as i8)
    p = compiler_ir_ser_write_i8(buf, p, ((val >> 48) & 255) as i8)
    p = compiler_ir_ser_write_i8(buf, p, ((val >> 56) & 255) as i8)
    p
}

fn compiler_ir_ser_write_padding(buf: &![i8; 131072], pos: i64, count: i64) -> i64 with Mut, Panic, Div {
    var p = pos
    var i: i64 = 0
    while i < count {
        p = compiler_ir_ser_write_i8(buf, p, 0 as i8)
        i = i + 1
    }
    p
}

fn compiler_ir_ser_write_f64(buf: &![i8; 131072], pos: i64, val: f64) -> i64 with Mut, Panic, Div {
    compiler_ir_ser_write_i64(buf, pos, f64_to_bits(val))
}

fn compiler_ir_ser_write_name(buf: &![i8; 131072], pos: i64, n: Name) -> i64 with Mut, Panic, Div {
    var p = compiler_ir_ser_write_i64(buf, pos, n.len)
    var i: i64 = 0
    while i < 128 {
        p = compiler_ir_ser_write_i8(buf, p, n.buf[i as usize])
        i = i + 1
    }
    p
}

fn compiler_ir_ser_opcode_tag(op: IrOpcode) -> i64 {
    match op {
        IrOpcode::IrLoadImm => 0,
        IrOpcode::IrLoadFloat => 1,
        IrOpcode::IrLoadBool => 2,
        IrOpcode::IrLoadString => 3,
        IrOpcode::IrCopy => 4,
        IrOpcode::IrBinOp => 5,
        IrOpcode::IrUnaryOp => 6,
        IrOpcode::IrCall => 7,
        IrOpcode::IrReturn => 8,
        IrOpcode::IrJump => 9,
        IrOpcode::IrBranchTrue => 10,
        IrOpcode::IrBranchFalse => 11,
        IrOpcode::IrFieldGet => 12,
        IrOpcode::IrFieldSet => 13,
        IrOpcode::IrIndexGet => 14,
        IrOpcode::IrIndexSet => 15,
        IrOpcode::IrAlloc => 16,
        IrOpcode::IrLabel => 17,
        IrOpcode::IrNop => 18,
        IrOpcode::IrPhi => 19,
        IrOpcode::IrContest => 20,
        IrOpcode::IrProveRobust => 21,
        IrOpcode::IrValidated => 22,
        IrOpcode::IrLiftKnowledge => 23,
        IrOpcode::IrMeasure => 24,
        IrOpcode::IrAdmitAction => 25,
        IrOpcode::IrDeferAction => 26,
        IrOpcode::IrPlanAcquisition => 27,
        IrOpcode::IrPlanRecourse => 28,
        IrOpcode::IrProposeAlternatives => 29,
        IrOpcode::IrCommitAlternative => 30,
        IrOpcode::IrObserveTransition => 31,
        IrOpcode::IrRollbackTransition => 32,
        IrOpcode::IrDebugGuard => 33,
        IrOpcode::IrProfCounter => 34,
        IrOpcode::IrHandleBegin => 35,
        IrOpcode::IrHandleEnd => 36,
        IrOpcode::IrCallSret => 37,
        IrOpcode::IrReturnSret => 38,
        _ => -1,
    }
}

fn compiler_ir_ser_binary_op_tag(op: BinaryOp) -> i64 {
    match op {
        BinaryOp::OpAdd => 0,
        BinaryOp::OpSub => 1,
        BinaryOp::OpMul => 2,
        BinaryOp::OpDiv => 3,
        BinaryOp::OpRem => 4,
        BinaryOp::OpEq => 5,
        BinaryOp::OpNe => 6,
        BinaryOp::OpLt => 7,
        BinaryOp::OpLe => 8,
        BinaryOp::OpGt => 9,
        BinaryOp::OpGe => 10,
        BinaryOp::OpAnd => 11,
        BinaryOp::OpOr => 12,
        BinaryOp::OpBitAnd => 13,
        BinaryOp::OpBitOr => 14,
        BinaryOp::OpBitXor => 15,
        BinaryOp::OpShl => 16,
        BinaryOp::OpShr => 17,
        BinaryOp::OpConcat => 18,
        BinaryOp::OpRange => 19,
        BinaryOp::OpRangeInclusive => 20,
    }
}

fn compiler_ir_ser_unary_op_tag(op: UnaryOp) -> i64 {
    match op {
        UnaryOp::OpNeg => 0,
        UnaryOp::OpNot => 1,
        UnaryOp::OpRef => 2,
        UnaryOp::OpRefMut => 3,
        UnaryOp::OpDeref => 4,
    }
}

fn compiler_ir_ser_write_instr(buf: &![i8; 131072], pos: i64, instr: IrInstr) -> i64 with Mut, Panic, Div {
    var p = pos
    p = compiler_ir_ser_write_i8(buf, p, compiler_ir_ser_opcode_tag(instr.op) as i8)
    p = compiler_ir_ser_write_padding(buf, p, 7)
    p = compiler_ir_ser_write_i64(buf, p, instr.dst)
    p = compiler_ir_ser_write_i64(buf, p, instr.src1)
    p = compiler_ir_ser_write_i64(buf, p, instr.src2)
    p = compiler_ir_ser_write_i64(buf, p, instr.imm_i64)
    p = compiler_ir_ser_write_f64(buf, p, instr.imm_f64)
    p = compiler_ir_ser_write_i64(buf, p, instr.label_id)
    p = compiler_ir_ser_write_i64(buf, p, instr.fn_id)
    p = compiler_ir_ser_write_i64(buf, p, instr.field_idx)
    p = compiler_ir_ser_write_i8(buf, p, compiler_ir_ser_binary_op_tag(instr.bin_op) as i8)
    p = compiler_ir_ser_write_padding(buf, p, 7)
    p = compiler_ir_ser_write_i8(buf, p, compiler_ir_ser_unary_op_tag(instr.un_op) as i8)
    p = compiler_ir_ser_write_padding(buf, p, 7)
    p = compiler_ir_ser_write_name(buf, p, ir_name_at(instr.name_id))
    p = compiler_ir_ser_write_i64(buf, p, instr.arg_count)
    p
}

fn compiler_ir_ser_write_function(buf: &![i8; 131072], pos: i64, func: IrFunction) -> i64 with Mut, Panic, Div {
    var p = pos
    p = compiler_ir_ser_write_name(buf, p, func.name)
    p = compiler_ir_ser_write_i64(buf, p, func.instr_count)
    p = compiler_ir_ser_write_i64(buf, p, func.reg_count)
    p = compiler_ir_ser_write_i64(buf, p, func.label_count)
    p = compiler_ir_ser_write_i64(buf, p, func.param_count)

    var i: i64 = 0
    while i < 64 {
        p = compiler_ir_ser_write_i64(buf, p, func.param_regs[i as usize])
        i = i + 1
    }

    p = compiler_ir_ser_write_i64(buf, p, func.compile_strategy)
    p = compiler_ir_ser_write_i64(buf, p, func.prof_counter_id)

    var j: i64 = 0
    while j < func.instr_count {
        p = compiler_ir_ser_write_instr(buf, p, func.instrs[j as usize])
        j = j + 1
    }
    p
}

fn compiler_ir_serialize_non_ep_module(module: IrModule, out_buf: &![i8; 131072]) -> i64 with Mut, Panic, Div {
    var pos: i64 = 0

    (*out_buf)[0] = 83 as i8
    (*out_buf)[1] = 79 as i8
    (*out_buf)[2] = 73 as i8
    (*out_buf)[3] = 82 as i8
    (*out_buf)[4] = 2 as i8
    (*out_buf)[5] = 0 as i8
    (*out_buf)[6] = 0 as i8
    (*out_buf)[7] = 0 as i8
    pos = 8

    pos = compiler_ir_ser_write_i64(out_buf, pos, module.fn_count)
    var i: i64 = 0
    while i < module.fn_count {
        pos = compiler_ir_ser_write_function(out_buf, pos, module.functions[i as usize])
        i = i + 1
    }

    pos = compiler_ir_ser_write_i64(out_buf, pos, module.string_count)
    i = 0
    while i < module.string_count {
        pos = compiler_ir_ser_write_name(out_buf, pos, module.string_table[i as usize])
        i = i + 1
    }

    i = 0
    while i < 35 {
        pos = compiler_ir_ser_write_i64(out_buf, pos, 0)
        i = i + 1
    }

    pos
}

fn compiler_ir_read_i64_at(buf: &![i8; 131072], pos: i64) -> i64 with Mut, Panic, Div {
    let raw0: i64 = (*buf)[(pos + 0) as usize] as i64
    let raw1: i64 = (*buf)[(pos + 1) as usize] as i64
    let raw2: i64 = (*buf)[(pos + 2) as usize] as i64
    let raw3: i64 = (*buf)[(pos + 3) as usize] as i64
    let raw4: i64 = (*buf)[(pos + 4) as usize] as i64
    let raw5: i64 = (*buf)[(pos + 5) as usize] as i64
    let raw6: i64 = (*buf)[(pos + 6) as usize] as i64
    let raw7: i64 = (*buf)[(pos + 7) as usize] as i64
    let b0 = raw0 & 255
    let b1 = raw1 & 255
    let b2 = raw2 & 255
    let b3 = raw3 & 255
    let b4 = raw4 & 255
    let b5 = raw5 & 255
    let b6 = raw6 & 255
    let b7 = raw7 & 255
    b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56)
}

struct CompilerIrCopyProgress {
    src_pos: i64,
    dst_pos: i64,
}

fn compiler_ir_copy_progress(src_pos: i64, dst_pos: i64) -> CompilerIrCopyProgress {
    CompilerIrCopyProgress { src_pos: src_pos, dst_pos: dst_pos }
}

pub struct CompilerIrRoundtripResult {
    ok: bool,
    out_len: i64,
    fn_count: i64,
    string_count: i64,
}

fn compiler_ir_roundtrip_result(ok: bool, out_len: i64, fn_count: i64, string_count: i64) -> CompilerIrRoundtripResult {
    CompilerIrRoundtripResult { ok: ok, out_len: out_len, fn_count: fn_count, string_count: string_count }
}

fn compiler_ir_copy_bytes(in_buf: &![i8; 131072], in_pos: i64, out_buf: &![i8; 131072], out_pos: i64, count: i64) -> CompilerIrCopyProgress with Mut, Panic, Div {
    var src = in_pos
    var dst = out_pos
    var i: i64 = 0
    while i < count {
        if src >= 0 && src < 131072 && dst >= 0 && dst < 131072 {
            let byte = (*in_buf)[src as usize]
            (*out_buf)[dst as usize] = byte
        }
        src = src + 1
        dst = dst + 1
        i = i + 1
    }
    compiler_ir_copy_progress(src, dst)
}

fn compiler_ir_roundtrip_non_ep_buffer(in_buf: &![i8; 131072], len: i64, out_buf: &![i8; 131072]) -> CompilerIrRoundtripResult with Mut, Panic, Div {
    if len < 24 + 280 {
        return compiler_ir_roundtrip_result(false, 0, 0, 0)
    }
    if (*in_buf)[0] != (83 as i8) || (*in_buf)[1] != (79 as i8) || (*in_buf)[2] != (73 as i8) || (*in_buf)[3] != (82 as i8) {
        return compiler_ir_roundtrip_result(false, 0, 0, 0)
    }

    var in_pos: i64 = 0
    var out_pos: i64 = 0
    let header_copy = compiler_ir_copy_bytes(in_buf, in_pos, out_buf, out_pos, 8)
    in_pos = header_copy.src_pos
    out_pos = header_copy.dst_pos

    if in_pos + 8 > len {
        return compiler_ir_roundtrip_result(false, 0, 0, 0)
    }
    let fn_count = compiler_ir_read_i64_at(in_buf, in_pos)
    let fn_count_copy = compiler_ir_copy_bytes(in_buf, in_pos, out_buf, out_pos, 8)
    in_pos = fn_count_copy.src_pos
    out_pos = fn_count_copy.dst_pos

    var i: i64 = 0
    while i < fn_count {
        if in_pos + 696 > len {
            return compiler_ir_roundtrip_result(false, 0, fn_count, 0)
        }
        let instr_count = compiler_ir_read_i64_at(in_buf, in_pos + 136)
        if instr_count < 0 {
            return compiler_ir_roundtrip_result(false, 0, fn_count, 0)
        }
        let fn_header_copy = compiler_ir_copy_bytes(in_buf, in_pos, out_buf, out_pos, 696)
        in_pos = fn_header_copy.src_pos
        out_pos = fn_header_copy.dst_pos
        let instr_bytes = instr_count * 232
        if instr_bytes < 0 || in_pos + instr_bytes > len {
            return compiler_ir_roundtrip_result(false, 0, fn_count, 0)
        }
        let instr_copy = compiler_ir_copy_bytes(in_buf, in_pos, out_buf, out_pos, instr_bytes)
        in_pos = instr_copy.src_pos
        out_pos = instr_copy.dst_pos
        i = i + 1
    }

    if in_pos + 8 > len {
        return compiler_ir_roundtrip_result(false, 0, fn_count, 0)
    }
    let string_count = compiler_ir_read_i64_at(in_buf, in_pos)
    let string_count_copy = compiler_ir_copy_bytes(in_buf, in_pos, out_buf, out_pos, 8)
    in_pos = string_count_copy.src_pos
    out_pos = string_count_copy.dst_pos

    let string_bytes = string_count * 136
    if string_bytes < 0 || in_pos + string_bytes + 280 > len {
        return compiler_ir_roundtrip_result(false, 0, fn_count, string_count)
    }
    let strings_copy = compiler_ir_copy_bytes(in_buf, in_pos, out_buf, out_pos, string_bytes)
    in_pos = strings_copy.src_pos
    out_pos = strings_copy.dst_pos

    let ep_copy = compiler_ir_copy_bytes(in_buf, in_pos, out_buf, out_pos, 280)
    in_pos = ep_copy.src_pos
    out_pos = ep_copy.dst_pos

    if out_pos != len {
        return compiler_ir_roundtrip_result(false, out_pos, fn_count, string_count)
    }
    compiler_ir_roundtrip_result(true, out_pos, fn_count, string_count)
}

// ── Equivalence Theory: auto-emit Lean obligations from a compile ────────────
// `madaros emit-lean-obligations <src.sio> <out.lean>` reads the program, lexically
// scans it for Equivalence Theory feature usage, and writes the corresponding Lean 4
// obligations. They are decidable (`by decide`), Mathlib-free, and reference the
// discharged proofs in formal/EquivalenceTheory.lean. The scan is lexical (whole-token
// presence of the group names / `Invariant` / `Chaotic`) — documented, not full-checker.

// Append a string to a fixed buffer (by-value, mirrors io_trace_append_string).
fn lobl_append(buf: [i8; 65536], pos: i64, s: string) -> ([i8; 65536], i64) with Mut, Panic, Div {
    var out = buf
    var p = pos
    var i: i64 = 0
    let n = str_len(s)
    while i < n && p < 65536 {
        out[p as usize] = str_char_at(s, i) as i8
        p = p + 1
        i = i + 1
    }
    (out, p)
}

fn run_emit_lean_obligations(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 2 >= args.len {
        print("usage: emit-lean-obligations <src.sio> <out.lean>\n")
        return
    }
    let src = arg_list_get(args, flag_index + 1)
    let out = arg_list_get(args, flag_index + 2)
    if !file_exists(src) {
        print("emit-lean-obligations: cannot read ")
        print(src)
        print("\n")
        return
    }
    // Run the checker with per-call-site obligation recording enabled, so each Invariant
    // comparison's concrete groups + frame relation and each Chaotic function are captured
    // precisely (not lexically). The checker hooks live in check::effects / check.sio.
    equiv_begin_recording()
    let prog = load_module_file(src)
    let _verdict = module_frontend_check_items_with_source_context(prog.items, src)
    equiv_end_recording()

    let body = equiv_emit_body(src)

    var buf: [i8; 65536] = [0; 65536]
    let appended = lobl_append(buf, 0, body)
    let okw = io_write_bytes_to_file(out, appended.0, appended.1)
    if okw {
        print("emit-lean-obligations: wrote ")
        print(out)
        print("\n")
    } else {
        print("emit-lean-obligations: failed to write ")
        print(out)
        print("\n")
    }
}

fn compiler_visibility_preflight(source_path: string) -> bool with IO, Mut, Panic, Div, Alloc {
    var closure = ModuleClosure {
        paths: [""; 256],
        edge_callers: [""; 512],
        edge_dependencies: [""; 512],
        unresolved_callers: [""; 256],
        unresolved_imports: [""; 256],
        node_count: 0,
        edge_count: 0,
        unresolved_count: 0,
        saturated: false,
        parse_failed: false,
        parse_failed_path: "",
    }
    if !module_frontend_collect_ast_closure_into(source_path, &!closure) {
        // Report the field that EXPLAINS the failure, not only the three that
        // happen to look healthy.
        //
        // A dependency parse failure short-circuits the closure walk, so
        // unresolved_count stays 0 and saturated stays false — the exact values a
        // healthy-but-small closure has. Printing only those three said "something
        // is wrong somewhere" and sent readers looking at import resolution, which
        // was fine. The cause is parse_failed, and it names a file.
        if closure.parse_failed {
            print("run_check_mode: module failed to parse: ")
            print(closure.parse_failed_path)
            print("\n")
            print("  note: the closure walk stops at the first parse failure, so the")
            print(" node/unresolved/saturated counts below describe only what was reached\n")
        }
        print("run_check_mode: AST closure incomplete nodes=")
        print_int(closure.node_count)
        print(" unresolved=")
        print_int(closure.unresolved_count)
        print(" saturated=")
        if closure.saturated { print("true") } else { print("false") }
        print(" parse_failed=")
        if closure.parse_failed { print("true") } else { print("false") }
        print("\n")
        return false
    }

    var programs: [Program; 256] = [Program { module_path: empty_path(), items: None }; 256]
    var load_index: i64 = 0
    while load_index < closure.node_count {
        parser_reset_last_errors()
        programs[load_index] = load_module_file(closure.paths[load_index])
        if parser_last_error_count() > 0 {
            print("run_check_mode: AST reload failed for ")
            println(closure.paths[load_index])
            return false
        }
        load_index = load_index + 1
    }

    if closure.node_count == 1 && closure.edge_count == 0 {
        programs[0].items = specialize_generics(programs[0].items)
        let single_verdict = module_frontend_check_items_with_source_context(
            programs[0].items,
            source_path
        )
        return single_verdict == 0
    }

    print("run_check_mode: about to check ")
    print_int(closure.node_count)
    print(" modules\n")
    // WP-A3 specialized multi-module typecheck (same design as
    // module_frontend_specialized_typecheck on the IR-merge/compile path):
    // merge all modules' items, monomorphize turbofish instantiations, then
    // check the specialized list. Without this pass, generic template bodies
    // that construct `S {..}` / call trait methods on a type parameter F
    // emit spurious E008 (`expected S / found S__F`) and E011 (no method on
    // F) — blocking `cd_exact_generic_i64` and related ExactRing engines.
    // Fall back to the plain multi-module checker when no generic was
    // actually instantiated so ordinary multi-module code stays identical.
    var merged: Option<Box<ItemList>> = None
    var mi: i64 = closure.node_count - 1
    while mi >= 0 {
        merged = spec_append_item_lists(programs[mi as usize].items, merged)
        mi = mi - 1
    }
    let specialized = specialize_generics(merged)
    var verdict: i64 = 0
    if spec_last_instantiated() {
        if str_eq(read_env("SOUNIO_MM_SPEC_TRACE"), "1") {
            print("run_check_mode: specialized-typecheck over merged ")
            print_int(closure.node_count)
            print(" modules\n")
        }
        verdict = check_items_verdict_boot4(specialized)
    } else {
        verdict = check_modules_verdict_boot4_with_visibility(
            &!programs,
            closure.node_count,
            true
        )
    }
    print("run_check_mode: verdict=")
    print_int(verdict)
    print("\n")
    // A non-zero verdict is a TYPE error across the merged modules, not a
    // visibility or parse problem. The caller turns `false` into
    // "error: visibility preflight failed", which names the stage that ran rather
    // than the thing that went wrong — a program whose only fault is a bad type
    // gets told its visibility failed. Say so here, where the distinction is known.
    if verdict != 0 {
        print("run_check_mode: type checking failed across ")
        print_int(closure.node_count)
        print(" module(s); the diagnostics above name the offending declarations\n")
    }
    verdict == 0
}

fn run_science_boundary_closure_report(
    args: ArgList,
    flag_index: i64
) with IO, Mut, Panic, Div, Alloc {
    let source_path = compiler_mode_source_arg(args, flag_index, "--science-boundary-closure")
    var closure = ModuleClosure {
        paths: [""; 256],
        edge_callers: [""; 512],
        edge_dependencies: [""; 512],
        unresolved_callers: [""; 256],
        unresolved_imports: [""; 256],
        node_count: 0,
        edge_count: 0,
        unresolved_count: 0,
        saturated: false,
        parse_failed: false,
        parse_failed_path: "",
    }
    let complete = module_frontend_collect_ast_closure_into(source_path, &!closure)
    println("SOUNIO_BOUNDARY_CLOSURE_V1")
    if complete { println("status\tcomplete") } else { println("status\tincomplete") }
    print("capacity\t256\n")
    print("saturated\t")
    if closure.saturated { println("true") } else { println("false") }
    print("parse_failed\t")
    if closure.parse_failed { println("true") } else { println("false") }
    // Which module. The walker has known this since it stopped
    // (module_frontend.sio:2421,2435 set parse_failed_path) and the report threw
    // it away, so a consumer learned THAT the closure broke and had to bisect to
    // find WHERE. That is how a compiler that could not parse
    // self-hosted/resolve/scope.sio stayed unattributed.
    if closure.parse_failed {
        print("failed_path\t")
        println(closure.parse_failed_path)
    }
    var i: i64 = 0
    while i < closure.node_count {
        print("node\t")
        println(closure.paths[i])
        i = i + 1
    }
    i = 0
    while i < closure.edge_count {
        print("edge\t")
        print(closure.edge_callers[i])
        print("\t")
        println(closure.edge_dependencies[i])
        i = i + 1
    }
    i = 0
    while i < closure.unresolved_count {
        print("unresolved\t")
        print(closure.unresolved_callers[i])
        print("\t")
        println(closure.unresolved_imports[i])
        i = i + 1
    }
}

fn run_check_mode(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    let source_path = compiler_mode_source_arg(args, flag_index, "--check")
    if !compiler_preflight_source_input(source_path) {
        panic("check failed")
    }
    if compiler_visibility_preflight(source_path) {
        // Self-falsifying compiler rung: check mode has no codegen, so claim
        // gates run here in place of it when --verify-claims is passed.
        if compiler_mode_has_flag(args, "--verify-claims") {
            let claim_fail_count = claim_executor_verify(source_path)
            if claim_fail_count != 0 {
                panic("check failed: verify-claims gate failure")
            }
        }
        println(compiler_check_ok_message())
        return
    }
    panic("check failed")
}

fn run_ir_dump_mode(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    let source_path = compiler_mode_source_arg(args, flag_index, "--ir-dump")
    if !compiler_preflight_source_input(source_path) {
        panic("ir-dump failed")
    }

    let ir_result = compiler_preflight_ir_load(source_path)
    if !ir_result.ok {
        compiler_print_errors(ir_result.errors)
        panic("ir-dump failed")
    }

    let serialized_len = compiler_ir_module_serialized_size(ir_result.module)
    if serialized_len <= 0 {
        println("error: ir-dump unsupported for non-empty epistemic IR")
        panic("ir-dump failed")
    }

    var serialized_buf: [i8; 131072] = [0; 131072]
    compiler_ir_serialize_non_ep_module(ir_result.module, &! serialized_buf)
    print("ir-dump: bytes=")
    print_int(serialized_len)
    print(" functions=")
    print_int(ir_result.module.fn_count)
    print(" strings=")
    print_int(ir_result.module.string_count)
    print("\n")
}

fn run_ir_roundtrip_mode(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    let source_path = compiler_mode_source_arg(args, flag_index, "--ir-roundtrip")
    if !compiler_preflight_source_input(source_path) {
        panic("ir-roundtrip failed")
    }

    let ir_result = compiler_preflight_ir_load(source_path)
    if !ir_result.ok {
        compiler_print_errors(ir_result.errors)
        panic("ir-roundtrip failed")
    }

    let pair_a_len = compiler_ir_module_serialized_size(ir_result.module)
    if pair_a_len <= 0 {
        println("error: ir-roundtrip unsupported for non-empty epistemic IR")
        panic("ir-roundtrip failed")
    }

    var pair_a_buf: [i8; 131072] = [0; 131072]
    compiler_ir_serialize_non_ep_module(ir_result.module, &! pair_a_buf)
    var pair_b_buf: [i8; 131072] = [0; 131072]
    let roundtrip = compiler_ir_roundtrip_non_ep_buffer(&! pair_a_buf, pair_a_len, &! pair_b_buf)
    if !roundtrip.ok {
        println("error: ir roundtrip decode failed")
        print("error: partial_len=")
        print_int(roundtrip.out_len)
        print(" functions=")
        print_int(roundtrip.fn_count)
        print(" strings=")
        print_int(roundtrip.string_count)
        print("\n")
        panic("ir-roundtrip failed")
    }
    let pair_b_len = roundtrip.out_len
    if pair_b_len != pair_a_len {
        println("error: ir roundtrip length mismatch")
        panic("ir-roundtrip failed")
    }
    if !compiler_ir_buffers_equal(pair_a_buf, pair_a_len, pair_b_buf, pair_b_len) {
        println("error: ir roundtrip byte mismatch")
        panic("ir-roundtrip failed")
    }

    print("ir-roundtrip: OK bytes=")
    print_int(pair_a_len)
    print(" functions=")
    print_int(ir_result.module.fn_count)
    print("\n")
}

fn run_native_compile_mode(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    let source_path = compiler_mode_source_arg(args, flag_index, "--native-compile")
    let output_path = compiler_mode_output_path(args, "a.out")
    if !compiler_preflight_source_input(source_path) {
        exit_process(1)
    }
    let frontend_preflight = preflight_multimodule_frontend(source_path)
    let preflight_parse_errors = parser_last_error_count()
    if !frontend_preflight.ok || preflight_parse_errors > 0 {
        compiler_print_ir_preflight_failure(frontend_preflight.error_msg)
        exit_process(1)
    }
    let optimize = compiler_mode_has_flag(args, "-O")
    let cache_dir = compiler_mode_option_string(args, "", "--cache-dir", "")
    let cache_mode = compiler_mode_option_string(args, "", "--cache-mode", "off")
    let use_profile_path = compiler_mode_option_string(args, "", "--use-profile", "")
    let use_profile = str_len(use_profile_path) > 0
    let cache_stats = compiler_mode_has_flag(args, "--cache-stats")
    let target = compiler_mode_option_string(args, "-t", "--target", "native")
    let exit_code = compile_multimodule_native_advanced(
        source_path,
        output_path,
        target,
        "auto",
        false,
        "",
        "",
        false,
        optimize,
        use_profile,
        use_profile_path,
        cache_dir,
        cache_mode,
        cache_stats
    )
    if exit_code == 0 {
        println(compiler_native_compile_summary(output_path))
        return
    }
    panic("native-compile failed")
}

fn run_emit_obj_mode(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    let source_path = compiler_mode_source_arg(args, flag_index, "--emit-obj")
    let output_path = compiler_mode_output_path(args, "output.o")
    let ir_result = load_multimodule_ir(source_path)
    if !ir_result.ok {
        panic("emit-obj: frontend failed")
    }
    let obj = compile_to_obj(&(*ir_result.module))
    let ok = io_write_elf_to_file(output_path, obj)
    if ok {
        println("emit-obj: " + output_path + " (" + int_to_string(obj.len) + " bytes)")
        return
    }
    panic("emit-obj: write failed")
}

fn run_emit_so_mode(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    let source_path = compiler_mode_source_arg(args, flag_index, "--emit-so")
    let output_path = compiler_mode_output_path(args, "output.so")
    let ir_result = load_multimodule_ir(source_path)
    if !ir_result.ok { panic("emit-so: frontend failed") }
    let so = compile_to_shared(&(*ir_result.module))
    let ok = io_write_elf_to_file(output_path, so)
    if ok { println("emit-so: " + output_path + " (" + int_to_string(so.len) + " bytes)"); return }
    panic("emit-so: write failed")
}

fn run_ontology_resolve_mode(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    let curie = compiler_mode_positional_arg(args, flag_index, 0, "--ontology-resolve")
    let term = ontology_resolve_curie(curie)
    ontology_print_term(term)
}

fn run_ontology_search_mode(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    let query = compiler_mode_positional_arg(args, flag_index, 0, "--ontology-search")
    let results = ontology_search_text(query)
    ontology_print_search_results(results)
}

fn run_ontology_ancestors_mode(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    let curie = compiler_mode_positional_arg(args, flag_index, 0, "--ontology-ancestors")
    let results = ontology_ancestor_terms(curie)
    ontology_print_search_results(results)
}

fn run_ontology_is_subclass_mode(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    let child = compiler_mode_positional_arg(args, flag_index, 0, "--ontology-is-subclass")
    let parent = compiler_mode_positional_arg(args, flag_index, 1, "--ontology-is-subclass")
    if ontology_is_subclass_of(child, parent) {
        println("true")
    } else {
        println("false")
    }
}

fn run_ontology_map_mode(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    let source_curie = compiler_mode_positional_arg(args, flag_index, 0, "--ontology-map")
    let target_ontology = compiler_mode_option_string(args, "", "--to", "")
    if str_len(target_ontology) <= 0 {
        panic("--ontology-map: missing --to <ontology>")
    }
    let mappings = ontology_map_to(source_curie, target_ontology)
    ontology_print_mappings(mappings)
}

// ============================================================================
// PKG COMMAND DISPATCHER
// ============================================================================

fn run_pkg_dispatch(args: ArgList, command_index: i64) with IO, Mut, Panic, Div, Alloc {
    if command_index + 1 >= args.len {
        println("souc pkg: missing subcommand")
        println("  subcommands: init | build | audit | install | publish | info | self-test")
        return
    }

    let subcommand = arg_list_get(args, command_index + 1)
    var extra_arg = ""
    if command_index + 2 < args.len {
        extra_arg = arg_list_get(args, command_index + 2)
    }
    var second_arg = ""
    if command_index + 3 < args.len {
        second_arg = arg_list_get(args, command_index + 3)
    }

    if subcommand == "init" {
        let science = extra_arg == "--science"
        pkg_run_init(science)
        return
    }
    if subcommand == "build" {
        let path = if str_len(extra_arg) > 0 { extra_arg } else { "sounio.toml" }
        pkg_run_build(path)
        return
    }
    if subcommand == "audit" {
        let path = if str_len(extra_arg) > 0 { extra_arg } else { "sounio.toml" }
        pkg_run_audit(path)
        return
    }
    if subcommand == "install" {
        pkg_run_install(extra_arg, second_arg)
        return
    }
    if subcommand == "publish" {
        let dry = extra_arg == "--dry-run"
        pkg_run_publish(dry)
        return
    }
    if subcommand == "info" {
        pkg_run_info(extra_arg)
        return
    }
    if subcommand == "self-test" {
        pkg_run_self_test()
        return
    }
    if subcommand == "help" || subcommand == "--help" || subcommand == "-h" {
        pkg_print_help()
        return
    }
    println("souc pkg: unknown subcommand: " + subcommand)
    println("  subcommands: init | build | audit | install | publish | info | self-test")
}

fn run_pkg_install_shorthand(args: ArgList, command_index: i64) with IO, Mut, Panic, Div, Alloc {
    var name = ""
    var version = ""
    if command_index + 1 < args.len {
        name = arg_list_get(args, command_index + 1)
    }
    if command_index + 2 < args.len {
        version = arg_list_get(args, command_index + 2)
    }
    if str_len(name) == 0 {
        println("souc install: missing package name")
        println("  usage: souc install <name>[@<version>]")
        return
    }
    pkg_run_install(name, version)
}

fn run_pkg_search_shorthand(args: ArgList, command_index: i64) with IO, Mut, Panic, Div, Alloc {
    var query = ""
    var min_score = ""
    if command_index + 1 < args.len {
        query = arg_list_get(args, command_index + 1)
    }
    if command_index + 2 < args.len {
        let flag = arg_list_get(args, command_index + 2)
        if flag == "--min-score" && command_index + 3 < args.len {
            println("warning[W-SRB-LEGACY-001]: --min-score is ignored; scalar scores have no resolution authority")
        }
    }
    pkg_run_search(query, min_score)
}

