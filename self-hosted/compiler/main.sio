fn run_probe_ir_opt_strategy(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 1 >= args.len {
        panic("probe_ir_opt_strategy: missing source file argument")
    }
    let source_path = arg_list_get(args, flag_index + 1)
    println("probe_ir_opt_strategy: begin")
    print("probe_ir_opt_strategy: source=")
    print(source_path)
    print("\n")
    let ir_result = load_multimodule_ir(source_path)
    let parse_errors = parser_last_error_count()
    if ir_result.ok && parse_errors == 0 {
        println("probe_ir_opt_strategy: ok")
        print("probe_ir_opt_strategy: functions=")
        print_int(ir_result.module.fn_count)
        print("\n")
        var fi: i64 = 0
        while fi < ir_result.module.fn_count {
            let func = ir_result.module.functions[fi as usize]
            print("probe_ir_opt_strategy: fn=")
            compiler_manifest_print_name(func.name)
            print(" strategy=")
            print(ir_strategy_name(func.compile_strategy))
            if func.compile_strategy == IR_STRATEGY_INSTRUMENTED {
                let transformed = ir_opt_apply_strategy(func)
                let dispatch_label = ir_opt_max_label(func) + 1
                let instr_label = dispatch_label + 1
                let merge_label = dispatch_label + 2
                print(" transformed_instrs=")
                print_int(func.instr_count)
                print("->")
                print_int(transformed.instr_count)
                print(" labels=")
                print_int(func.label_count)
                print("->")
                print_int(transformed.label_count)
                print(" merge_result_vreg=")
                print_int(ir_opt_find_return_vreg(func))
                print(" dispatch_label=")
                print_int(dispatch_label)
                print(" instr_label=")
                print_int(instr_label)
                print(" merge_label=")
                print_int(merge_label)
            }
            print("\n")
            fi = fi + 1
        }
        return
    }
    println("probe_ir_opt_strategy: fail")
    if !ir_result.ok && str_len(ir_result.error_msg) > 0 {
        print("probe_ir_opt_strategy: error=")
        print(ir_result.error_msg)
        print("\n")
    }
    if parse_errors > 0 {
        println("probe_ir_opt_strategy: parser_errors=" + int_to_string(parse_errors))
    }
    panic("probe_ir_opt_strategy failed")
}

