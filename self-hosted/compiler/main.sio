    result.instrs[1].op == IrOpcode::IrCopy && result.instrs[1].dst == 2 && result.instrs[1].src1 == 0
}

// T92: opt_cleanup_function round-trip removes the folded arithmetic op.
fn compiler_main_test_ocp_partial_fold_dce_round_trip() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    instrs[2] = ir_copy(3, 2)
    let func = cp_make_test_func(instrs, 3)
    let result = opt_cleanup_function(func)
    result.instrs[1].op != IrOpcode::IrBinOp
}

// T93: LICM hoists pure invariant instructions into the unique preheader.
fn compiler_main_make_licm_hoist_test_func() -> IrFunction with Mut, Panic, Div {
    var func = ir_empty_function()
    var instrs: [IrInstr; 128] = [ir_nop(); 128]
    instrs[0] = ir_load_imm(0, 1)
    instrs[1] = ir_jump(0)
    instrs[2] = ir_label(0)
    instrs[3] = ir_load_imm(1, 3)
    instrs[4] = ir_binop(2, 4, BinaryOp::OpAdd, 1)
    instrs[5] = ir_branch_true(0, 1)
    instrs[6] = ir_label(2)
    instrs[7] = ir_return(2)
    instrs[8] = ir_label(1)
    instrs[9] = ir_jump(0)
    func.name = make_name("licm_hoist")
    func.instrs = instrs
    func.instr_count = 10
    func.reg_count = 5
    func.label_count = 3
    func.param_count = 1
    func.param_regs[0] = 4
    func
}

// T94: LICM leaves side-effecting calls in place.
fn compiler_main_make_licm_call_test_func() -> IrFunction with Mut, Panic, Div {
    var func = ir_empty_function()
    var instrs: [IrInstr; 128] = [ir_nop(); 128]
    instrs[0] = ir_load_imm(0, 1)
    instrs[1] = ir_jump(0)
    instrs[2] = ir_label(0)
    instrs[3] = ir_call(1, 0, make_name("side_effect"), ir_empty_reg_list(), 0)
    instrs[4] = ir_branch_true(0, 1)
    instrs[5] = ir_label(2)
    instrs[6] = ir_return(1)
    instrs[7] = ir_label(1)
    instrs[8] = ir_jump(0)
    func.name = make_name("licm_call")
    func.instrs = instrs
    func.instr_count = 9
    func.reg_count = 2
    func.label_count = 3
    func
}

fn compiler_main_test_lopt_licm_hoists_invariant() -> bool with Mut, Div, Panic {
    let result = lopt_optimize_function(compiler_main_make_licm_hoist_test_func())
    result.changed && result.invariants_hoisted == 2
}

fn compiler_main_test_lopt_licm_skips_calls() -> bool with Mut, Div, Panic {
    let original = compiler_main_make_licm_call_test_func()
    let result = lopt_optimize_function(original)
    if result.changed { return false }
    if result.invariants_hoisted != 0 { return false }
    if result.func.instr_count != original.instr_count { return false }
    if result.func.instrs[3].op != IrOpcode::IrCall { return false }
    if result.func.instrs[4].op != IrOpcode::IrBranchTrue { return false }
    true
}

// ============================================================================
// Sprint 68: Strength reduction for power-of-2 mul/div/rem (T95-T102)
// ============================================================================

// T95: x * 2 → IrBinOp(OpShl, x, r) where r's IrLoadImm is patched to 1
fn compiler_main_test_ocp_sr_mul_by_2() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 2)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    if result.instrs[1].bin_op != BinaryOp::OpShl { return false }
    if result.instrs[0].imm_i64 != 1 { return false }
    true
}

// T96: x * 4 → IrBinOp(OpShl, x, r) where r's IrLoadImm is patched to 2
fn compiler_main_test_ocp_sr_mul_by_4() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 4)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    if result.instrs[1].bin_op != BinaryOp::OpShl { return false }
    if result.instrs[0].imm_i64 != 2 { return false }
    true
}

// T97: x * 8 → IrBinOp(OpShl, x, r) where r's IrLoadImm is patched to 3
fn compiler_main_test_ocp_sr_mul_by_8() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 8)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    if result.instrs[1].bin_op != BinaryOp::OpShl { return false }
    if result.instrs[0].imm_i64 != 3 { return false }
    true
}

// T98: x / 2 → IrBinOp(OpShr, x, r) where r's IrLoadImm is patched to 1
fn compiler_main_test_ocp_sr_div_by_2() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 2)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpDiv, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    if result.instrs[1].bin_op != BinaryOp::OpShr { return false }
    if result.instrs[0].imm_i64 != 1 { return false }
    true
}

// T99: x / 4 → IrBinOp(OpShr, x, r) where r's IrLoadImm is patched to 2
fn compiler_main_test_ocp_sr_div_by_4() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 4)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpDiv, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    if result.instrs[1].bin_op != BinaryOp::OpShr { return false }
    if result.instrs[0].imm_i64 != 2 { return false }
    true
}

// T100: x % 4 → IrBinOp(OpBitAnd, x, r) where r's IrLoadImm is patched to 3
fn compiler_main_test_ocp_sr_rem_by_4() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 4)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpRem, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    if result.instrs[1].bin_op != BinaryOp::OpBitAnd { return false }
    if result.instrs[0].imm_i64 != 3 { return false }
    true
}

// T101: x * 3 remains OpMul — 3 is not a power of 2
fn compiler_main_test_ocp_sr_non_pow2_unchanged() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 3)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].bin_op == BinaryOp::OpMul
}

// T102: opt_cleanup_function round-trip removes the original arithmetic op.
fn compiler_main_test_ocp_sr_round_trip() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 4)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    instrs[2] = ir_copy(3, 2)
    let func = cp_make_test_func(instrs, 3)
    let result = opt_cleanup_function(func)
    result.instrs[1].op != IrOpcode::IrBinOp
}

// ============================================================================
// Sprint 69: Constant propagation through IrCopy (T103-T108)
// ============================================================================

// T103: copy prop enables full-constant fold: r0=5; r1=IrCopy(r0); r2=r1+r3(=3) → r2=8
fn compiler_main_test_ocp_cp_enables_full_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 5)
    instrs[1] = ir_copy(1, 0)
    instrs[2] = ir_load_imm(2, 3)
    instrs[3] = ir_binop(3, 1, BinaryOp::OpAdd, 2)
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    result.instrs[3].op == IrOpcode::IrLoadImm && result.instrs[3].imm_i64 == 8
}

// T104: copy prop enables strength reduction: r0=4; r1=IrCopy(r0); r2=x*r1 → r2=x<<2
fn compiler_main_test_ocp_cp_enables_strength_reduction() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 4)
    instrs[1] = ir_copy(2, 1)
    instrs[2] = ir_binop(3, 0, BinaryOp::OpMul, 2)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    result.instrs[2].bin_op == BinaryOp::OpShl
}

// T105: transitive copy chain: r0=6; r1=IrCopy(r0); r2=IrCopy(r1) → r2 is also constant=6
fn compiler_main_test_ocp_cp_transitive_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 6)
    instrs[1] = ir_copy(1, 0)
    instrs[2] = ir_copy(2, 1)
    instrs[3] = ir_load_imm(3, 6)
    instrs[4] = ir_binop(4, 2, BinaryOp::OpAdd, 3)
    let func = cp_make_test_func(instrs, 5)
    let result = ocp_const_fold(func)
    result.instrs[4].op == IrOpcode::IrLoadImm && result.instrs[4].imm_i64 == 12
}

// T106: copy prop enables identity fold: r0=1; r1=IrCopy(r0); r2=x*r1 → r2=IrCopy(x)
fn compiler_main_test_ocp_cp_enables_identity_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 1)
    instrs[1] = ir_copy(2, 1)
    instrs[2] = ir_binop(3, 0, BinaryOp::OpMul, 2)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    result.instrs[2].op == IrOpcode::IrCopy && result.instrs[2].src1 == 0
}

// T107: non-const source not propagated: r1=IrCopy(r_param) → r1 stays non-constant
fn compiler_main_test_ocp_cp_non_const_not_propagated() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_copy(1, 0)
    instrs[1] = ir_load_imm(2, 3)
    instrs[2] = ir_binop(3, 1, BinaryOp::OpAdd, 2)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    result.instrs[2].op == IrOpcode::IrBinOp
}

// T108: round-trip: copy prop + full fold + DCE removes dead loads
fn compiler_main_test_ocp_cp_round_trip_dce() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 7)
    instrs[1] = ir_copy(1, 0)
    instrs[2] = ir_load_imm(2, 3)
    instrs[3] = ir_binop(3, 1, BinaryOp::OpAdd, 2)
    instrs[4] = ir_copy(4, 3)
    let func = cp_make_test_func(instrs, 5)
    let result = opt_cleanup_function(func)
    if result.instrs[3].op != IrOpcode::IrLoadImm { return false }
    if result.instrs[3].imm_i64 != 10 { return false }
    true
}

