    instrs[2] = ir_binop(5, 3, BinaryOp::OpBitXor, 4)   // r5 = r3 ^ r4 → r1 ^ r2
    instrs[3] = ir_return(5)
    let func = cp_make_test_func(instrs, 4)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (2))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (2))) as usize] as BinaryOp) == BinaryOp::OpBitXor
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (2))) as usize] == 1 && IR_A_SRC2[(ir_region_slot_r(opt.region, (2))) as usize] == 2
}

