    instrs[1 as usize] = ir_binop(2, 0, BinaryOp::OpBitXor, 1)  // r2 = x ^ 5
    instrs[2 as usize] = ir_load_imm(3, -6)                     // r3 = ~5 = -6
    instrs[3 as usize] = ir_binop(4, 2, BinaryOp::OpBitAnd, 3)  // r4 = (x^5) & ~5
