}

// T208: r0=7, r1=-r0, r2=-r1 → r2 const 7 (double negation chain via const-prop).
fn compiler_main_test_unary_double_neg_chain() -> bool with IO, Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 7)
    instrs[1] = ir_unaryop(1, UnaryOp::OpNeg, 0)
    instrs[2] = ir_unaryop(2, UnaryOp::OpNeg, 1)
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    let ok = (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (2))) as usize] == 7
    if !ok {
        println("DBG T208:")
        print("  i0 op="); if (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrLoadImm { print("loadimm") } else if (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrUnaryOp { print("unary") } else if (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrCopy { print("copy") } else { print("other") }; print(" src1="); print_int(IR_A_SRC1[(ir_region_slot_r(result.region, (0))) as usize]); print(" imm="); print_int(IR_A_IMM_I64[(ir_region_slot_r(result.region, (0))) as usize]); print("\n")
        print("  i1 op="); if (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLoadImm { print("loadimm") } else if (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrUnaryOp { print("unary") } else if (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrCopy { print("copy") } else { print("other") }; print(" src1="); print_int(IR_A_SRC1[(ir_region_slot_r(result.region, (1))) as usize]); print(" imm="); print_int(IR_A_IMM_I64[(ir_region_slot_r(result.region, (1))) as usize]); print(" un="); if (IR_A_UN_OP[(ir_region_slot_r(result.region, (1))) as usize] as UnaryOp) == UnaryOp::OpNeg { print("neg") } else if (IR_A_UN_OP[(ir_region_slot_r(result.region, (1))) as usize] as UnaryOp) == UnaryOp::OpNot { print("not") } else { print("other") }; print("\n")
        print("  i2 op="); if (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrLoadImm { print("loadimm") } else if (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrUnaryOp { print("unary") } else if (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrCopy { print("copy") } else { print("other") }; print(" src1="); print_int(IR_A_SRC1[(ir_region_slot_r(result.region, (2))) as usize]); print(" imm="); print_int(IR_A_IMM_I64[(ir_region_slot_r(result.region, (2))) as usize]); print(" un="); if (IR_A_UN_OP[(ir_region_slot_r(result.region, (2))) as usize] as UnaryOp) == UnaryOp::OpNeg { print("neg") } else if (IR_A_UN_OP[(ir_region_slot_r(result.region, (2))) as usize] as UnaryOp) == UnaryOp::OpNot { print("not") } else { print("other") }; print("\n")
    }
    ok
}

// T209: OpNeg on non-const source → no fold (stays IrUnaryOp).
fn compiler_main_test_unary_neg_nonconst() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    // r0 is a parameter (not loaded by IrLoadImm), so unknown
    instrs[0] = ir_unaryop(1, UnaryOp::OpNeg, 0)
    let func   = cp_make_test_func(instrs, 1)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrUnaryOp
}

