fn run_exact_bitwise_rebracket_authority_smoke() with IO, Mut, Panic, Div {
    let receipt = ocp_exact_bitwise_rebracket_authority_probe()
    let pipeline = ocp_exact_bitwise_rebracket_pipeline_probe()
    println("[rebracket-compiler] PROBE: cases=" + int_to_string(receipt.case_count) +
        " application_mask=" + int_to_string(receipt.application_mask) +
        " refusal_mask=" + int_to_string(receipt.refusal_mask) +
        " unchanged_mask=" + int_to_string(receipt.unchanged_refusal_mask) +
        " boundary_mask=" + int_to_string(receipt.boundary_claim_mask) +
        " pipeline_functions=" + int_to_string(pipeline.function_count) +
        " pipeline_transactions=" + int_to_string(pipeline.exact_bitwise_transaction_count) +
        " pipeline_authorizations=" + int_to_string(pipeline.exact_bitwise_authorization_count) +
        " pipeline_applications=" + int_to_string(pipeline.exact_bitwise_application_count) +
        " pipeline_refusals=" + int_to_string(pipeline.exact_bitwise_refusal_count) +
        " pipeline_same_region_applications=" + int_to_string(pipeline.exact_bitwise_same_region_application_count) +
        " pipeline_cross_block_applications=" + int_to_string(pipeline.exact_bitwise_cross_block_application_count) +
        " pipeline_refusal_reason_mask=" + int_to_string(pipeline.exact_bitwise_refusal_reason_mask) +
        " pipeline_transaction_ontology_parameter_links=" + int_to_string(pipeline.exact_bitwise_transaction_ontology_parameter_link_count) +
        " pipeline_application_ontology_parameter_links=" + int_to_string(pipeline.exact_bitwise_application_ontology_parameter_link_count) +
        " pipeline_last_ontology_class_hash=" + int_to_string(pipeline.last_transaction_ontology_class_hash) +
        " pipeline_operator_mask=" + int_to_string(pipeline.exact_bitwise_operator_mask) +
        " pipeline_last_function=" + int_to_string(pipeline.last_application_function_index) +
        " pipeline_last_const=" + int_to_string(pipeline.last_combined_const_value))
    if receipt.case_count != 21 {
        panic("rebracket authority smoke case count failed")
    }
    if receipt.application_mask != 7 {
        panic("rebracket authority smoke application mask failed")
    }
    if receipt.refusal_mask != 65535 {
        panic("rebracket authority smoke refusal mask failed")
    }
    if receipt.unchanged_refusal_mask != 65535 {
        panic("rebracket authority smoke unchanged-refusal mask failed")
    }
    if receipt.boundary_claim_mask != 49 {
        panic("rebracket authority smoke boundary mask failed")
    }
    if pipeline.function_count != 1 ||
        pipeline.exact_bitwise_transaction_count != 1 ||
        pipeline.exact_bitwise_authorization_count != 1 ||
        pipeline.exact_bitwise_application_count != 1 ||
        pipeline.exact_bitwise_refusal_count != 0 ||
        pipeline.exact_bitwise_same_region_application_count != 0 ||
        pipeline.exact_bitwise_cross_block_application_count != 1 ||
        pipeline.exact_bitwise_refusal_reason_mask != 0 ||
        pipeline.exact_bitwise_transaction_ontology_parameter_link_count != 0 ||
        pipeline.exact_bitwise_application_ontology_parameter_link_count != 0 ||
        pipeline.last_transaction_ontology_class_hash != 0 ||
        pipeline.exact_bitwise_operator_mask != 1 ||
        pipeline.last_application_function_index != 0 ||
        pipeline.last_combined_const_value != 15 {
        panic("rebracket authority cleanup pipeline failed")
    }
    println("[rebracket-compiler] PASS: cases=21 applications=5 unchanged_refusals=16 pipeline=1 replay=0 calls=0 packed=0 cross_block=1 nondom=0 backedge=0 duplicate=0 missing=0 base_kill=0 phi=0 control_elsewhere=1 float_ir=0 runtime_d7=0 float_gum=0 global=0")
}

// E2E codegen-correctness gate: emit a full executable for `main() { return N }`
// via the to-file path (which builds the entry trampoline). Running the emitted ELF
// must exit with code N — proving end-to-end codegen correctness (semantics, not
// just structural validity). The compiler only EMITS; the external gate script
// (scripts/ci/native_v2_e2e_exit_code_gate.sh) runs the ELF and checks the exit code.
// This fn writes the ELF and prints a machine-parseable status line for the gate.
fn run_native_v2_emit_exit_code(ret_value: i64, out_path: string) with IO, Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let module = compiler_main_make_native_v2_scalar_module(ret_value)
    let rc = compile_native_v2_preview_to_file(&module, spec, out_path)
    if rc != 0 {
        print("native_v2_emit_exit_code: FAIL to_file rc=")
        print_int(rc as i64)
        print("\n")
        return
    }
    print("native_v2_emit_exit_code: emitted ret_value=")
    print_int(ret_value)
    print(" path=")
    print(out_path)
    print("\n")
}

fn run_native_v2_emit13() with IO, Mut, Panic, Div, Alloc {
    run_native_v2_emit_exit_code(13, "artifacts/omega/emit13.elf")
}

fn ir_return_sret(src: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrReturnSret)
    IrInstr {
        op: base.op,
        dst: base.dst,
        src1: src,
        src2: base.src2,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: base.label_id,
        fn_id: base.fn_id,
        field_idx: base.field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name_id: base.name_id,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

fn ir_call_sret(dst: i64, dest_reg: i64, fn_name: Name, fn_id: i64, arg0: i64, explicit_arg_count: i64) -> IrInstr with Div, Mut, Panic {
    let base = ir_instr_new(IrOpcode::IrCallSret)
    IrInstr {
        op: base.op,
        dst: dst,
        src1: dest_reg,
        src2: base.src2,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: base.label_id,
        fn_id: fn_id,
        field_idx: arg0,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name_id: ir_intern_name(fn_name),
        call_args: base.call_args,
        arg_count: explicit_arg_count,
    }
}

// --- Zig-style wide-int witnesses (hand-built IR -> ELF, exercise nc_wide_*_into).
// Each returns the HIGH limb so the exit code DISTINGUISHES real N-limb from fake-i64.
fn compiler_main_make_native_v2_wide_add4_module() -> IrModule with Mut, Panic, Div {
    // i256 (4 limbs): (-1,-1,-1,0) + (1,0,0,0) -> carry cascades 0->1->2->3; hi limb = 1.
    var module = ir_empty_module()
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.instrs[0] = ir_load_imm(0, 0 - 1)
    func.instrs[1] = ir_load_imm(1, 0 - 1)
    func.instrs[2] = ir_load_imm(2, 0 - 1)
    func.instrs[3] = ir_load_imm(3, 0)
    func.instrs[4] = ir_load_imm(4, 1)
    func.instrs[5] = ir_load_imm(5, 0)
    func.instrs[6] = ir_load_imm(6, 0)
    func.instrs[7] = ir_load_imm(7, 0)
    func.instrs[8] = ir_wide_add(8, 0, 4, 4)
    func.instrs[9] = ir_return(11)
    func.instr_count = 10
    func.reg_count = 12
    module.functions[0] = func
    module.fn_count = 1
    module
}
fn compiler_main_make_native_v2_wide_sub_module() -> IrModule with Mut, Panic, Div {
    // i128: (hi=2,lo=0) - (hi=0,lo=1) -> borrow: hi = 2-0-1 = 1. Fake-i64 would give 2.
    var module = ir_empty_module()
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.instrs[0] = ir_load_imm(0, 0)
    func.instrs[1] = ir_load_imm(1, 2)
    func.instrs[2] = ir_load_imm(2, 1)
    func.instrs[3] = ir_load_imm(3, 0)
    func.instrs[4] = ir_wide_sub(4, 0, 2, 2)
    func.instrs[5] = ir_return(5)
    func.instr_count = 6
    func.reg_count = 6
    module.functions[0] = func
    module.fn_count = 1
    module
}
fn compiler_main_make_native_v2_wide_mul_module() -> IrModule with Mut, Panic, Div {
    // i128: 2^32 * 2^32 = 2^64 -> lo=0, hi=1. Fake-i64 (single mul) would give 0.
    // dst base=4 (limbs 4,5); scratch at 6,7 -> reg_count must be 8.
    var module = ir_empty_module()
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.instrs[0] = ir_load_imm(0, 4294967296)
    func.instrs[1] = ir_load_imm(1, 0)
    func.instrs[2] = ir_load_imm(2, 4294967296)
    func.instrs[3] = ir_load_imm(3, 0)
    func.instrs[4] = ir_wide_mul(4, 0, 2, 2)
    func.instrs[5] = ir_return(5)
    func.instr_count = 6
    func.reg_count = 8
    module.functions[0] = func
    module.fn_count = 1
    module
}
// Observation gate: ((2^32 * 2^32) >> 64) as i64 == 1. Proves a *source-shaped*
// wide computation whose RESULT is observable in an i64 exit code (unlike add/sub/mul,
// whose low limb is identical to i64 and so undetectable). a*a = 2^64 -> limbs lo=0,hi=1;
// >>64 (1 limb) moves the hi limb into limb 0; returning limb 0 yields 1 (a broken/no-op
// shift would return the un-shifted low limb = 0).
fn compiler_main_make_native_v2_wide_shr_module() -> IrModule with Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.instrs[0] = ir_load_imm(0, 4294967296)   // a.lo = 2^32
    func.instrs[1] = ir_load_imm(1, 0)            // a.hi = 0
    func.instrs[2] = ir_load_imm(2, 4294967296)   // a.lo (2nd operand) = 2^32
    func.instrs[3] = ir_load_imm(3, 0)            // a.hi = 0
    func.instrs[4] = ir_wide_mul(4, 0, 2, 2)      // product -> limbs 4,5 ; scratch 6,7
    func.instrs[5] = ir_wide_shr_limb(8, 4, 2, 1) // (product >> 64) -> limbs 8,9 ; limb0(8)=hi(5)=1
    func.instrs[6] = ir_return(8)                 // return low limb of shifted (= 1)
    func.instr_count = 7
    func.reg_count = 10
    module.functions[0] = func
    module.fn_count = 1
    module
}
// (15 * 2^64) / 3 = 5 * 2^64 -> hi limb 5. Single-limb divisor (3). Proves N-limb
// division source-independently; return the high limb so the exit code observes it.
fn compiler_main_make_native_v2_wide_div_module() -> IrModule with Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.instrs[0] = ir_load_imm(0, 0)            // dividend lo = 0
    func.instrs[1] = ir_load_imm(1, 15)           // dividend hi = 15  (=> 15*2^64)
    func.instrs[2] = ir_load_imm(2, 3)            // divisor lo = 3
    func.instrs[3] = ir_load_imm(3, 0)            // divisor hi = 0 (single-limb)
    func.instrs[4] = ir_wide_div(4, 0, 2, 2)      // quotient -> limbs 4,5 = [0,5]
    func.instrs[5] = ir_return(5)                 // return hi limb = 5
    func.instr_count = 6
    func.reg_count = 6
    module.functions[0] = func
    module.fn_count = 1
    module
}
// (2^64 + 1) % 7 = 3. Single-limb divisor 7. A low-limb-only impl would give 1 % 7 = 1.
fn compiler_main_make_native_v2_wide_mod_module() -> IrModule with Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.instrs[0] = ir_load_imm(0, 1)            // dividend lo = 1
    func.instrs[1] = ir_load_imm(1, 1)            // dividend hi = 1  (=> 2^64 + 1)
    func.instrs[2] = ir_load_imm(2, 7)            // divisor lo = 7
    func.instrs[3] = ir_load_imm(3, 0)            // divisor hi = 0 (single-limb)
    func.instrs[4] = ir_wide_mod(4, 0, 2, 2)      // remainder -> limbs 4,5 = [3,0]
    func.instrs[5] = ir_return(4)                 // return low limb = 3
    func.instr_count = 6
    func.reg_count = 6
    module.functions[0] = func
    module.fn_count = 1
    module
}
// FULL N/N division by a MULTI-LIMB divisor (Increment D). N = 5*2^64+105, D = 2^64+1.
// 5*D = 5*2^64+5, so N = 5*D + 100 -> quotient 5, remainder 100. Returns the quotient low
// limb = 5. The divisor's HIGH limb (1) is nonzero, so the single-limb schoolbook can't be
// used; a low-limb-only impl dividing by D's limb0 (=1) would return lo(N)=105 (≠5).
fn compiler_main_make_native_v2_wide_divfull_module() -> IrModule with Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.instrs[0] = ir_load_imm(0, 105)          // N lo = 105
    func.instrs[1] = ir_load_imm(1, 5)            // N hi = 5     (=> 5*2^64 + 105)
    func.instrs[2] = ir_load_imm(2, 1)            // D lo = 1
    func.instrs[3] = ir_load_imm(3, 1)            // D hi = 1     (=> 2^64 + 1, multi-limb)
    func.instrs[4] = ir_wide_div_full(4, 0, 2, 2) // Q -> 4,5 ; R scratch 6,7 ; diff 8,9
    func.instrs[5] = ir_return(4)                 // quotient low limb = 5
    func.instr_count = 6
    func.reg_count = 10
    module.functions[0] = func
    module.fn_count = 1
    module
}
// FULL N/N remainder by a MULTI-LIMB divisor. N = 7*2^64+200, D = 2^64+1. 7*D = 7*2^64+7,
// N = 7*D + 193 -> remainder 193. Returns the remainder low limb = 193. A low-limb-only impl
// (% D's limb0 = 1) would return 0.
fn compiler_main_make_native_v2_wide_modfull_module() -> IrModule with Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.instrs[0] = ir_load_imm(0, 200)          // N lo = 200
    func.instrs[1] = ir_load_imm(1, 7)            // N hi = 7     (=> 7*2^64 + 200)
    func.instrs[2] = ir_load_imm(2, 1)            // D lo = 1
    func.instrs[3] = ir_load_imm(3, 1)            // D hi = 1     (=> 2^64 + 1, multi-limb)
    func.instrs[4] = ir_wide_mod_full(4, 0, 2, 2) // R -> 4,5 ; Q scratch 6,7 ; diff 8,9
    func.instrs[5] = ir_return(4)                 // remainder low limb = 193
    func.instr_count = 6
    func.reg_count = 10
    module.functions[0] = func
    module.fn_count = 1
    module
}
// 2^64 < 2^65 -> 1. a=[0,1] (2^64), b=[0,2] (2^65); the HIGH limb (1<2) decides. A
// low-limb-only impl (0<0) would give 0. cmp_op=2 (Lt).
fn compiler_main_make_native_v2_wide_cmp_module() -> IrModule with Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.instrs[0] = ir_load_imm(0, 0)            // a lo = 0
    func.instrs[1] = ir_load_imm(1, 1)            // a hi = 1  (=> 2^64)
    func.instrs[2] = ir_load_imm(2, 0)            // b lo = 0
    func.instrs[3] = ir_load_imm(3, 2)            // b hi = 2  (=> 2^65)
    func.instrs[4] = ir_wide_cmp(4, 0, 2, 2, 2)   // a < b -> reg4 = 1
    func.instrs[5] = ir_return(4)
    func.instr_count = 6
    func.reg_count = 6
    module.functions[0] = func
    module.fn_count = 1
    module
}
// Non-limb-aligned funnel shift: 2^100 >> 96 = 2^4 = 16. src limbs lo=0, hi=2^36; shift
// 96 = 64+32 (q=1, r=32). A limb-aligned-only impl (>>64) would give 2^36; low-limb -> 0.
fn compiler_main_make_native_v2_wide_shr_unaligned_module() -> IrModule with Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.instrs[0] = ir_load_imm(0, 0)               // src lo = 0
    func.instrs[1] = ir_load_imm(1, 68719476736)     // src hi = 2^36  (value = 2^100)
    func.instrs[2] = ir_wide_shr(2, 0, 2, 96)        // (>>96) -> limbs 2,3 ; limb0 = 16
    func.instrs[3] = ir_return(2)                     // return low limb = 16
    func.instr_count = 4
    func.reg_count = 4
    module.functions[0] = func
    module.fn_count = 1
    module
}
fn run_native_v2_emit_wide(args: ArgList, flag_index: i64, kind: i64) with IO, Mut, Panic, Div, Alloc {
    let out_path = compiler_mode_source_arg(args, flag_index, "--native-v2-emit-wide")
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    if kind == 0 {
        let m = compiler_main_make_native_v2_wide_add4_module()
        let rc = compile_native_v2_preview_to_file(&m, spec, out_path)
        print("wide-add4 rc="); print_int(rc as i64); print(" path="); print(out_path); print("\n")
    } else if kind == 1 {
        let m = compiler_main_make_native_v2_wide_sub_module()
        let rc = compile_native_v2_preview_to_file(&m, spec, out_path)
        print("wide-sub rc="); print_int(rc as i64); print(" path="); print(out_path); print("\n")
    } else if kind == 2 {
        let m = compiler_main_make_native_v2_wide_mul_module()
        let rc = compile_native_v2_preview_to_file(&m, spec, out_path)
        print("wide-mul rc="); print_int(rc as i64); print(" path="); print(out_path); print("\n")
    } else if kind == 3 {
        let m = compiler_main_make_native_v2_wide_shr_module()
        let rc = compile_native_v2_preview_to_file(&m, spec, out_path)
        print("wide-shr rc="); print_int(rc as i64); print(" path="); print(out_path); print("\n")
    } else if kind == 4 {
        let m = compiler_main_make_native_v2_wide_div_module()
        let rc = compile_native_v2_preview_to_file(&m, spec, out_path)
        print("wide-div rc="); print_int(rc as i64); print(" path="); print(out_path); print("\n")
    } else if kind == 5 {
        let m = compiler_main_make_native_v2_wide_mod_module()
        let rc = compile_native_v2_preview_to_file(&m, spec, out_path)
        print("wide-mod rc="); print_int(rc as i64); print(" path="); print(out_path); print("\n")
    } else if kind == 6 {
        let m = compiler_main_make_native_v2_wide_cmp_module()
        let rc = compile_native_v2_preview_to_file(&m, spec, out_path)
        print("wide-cmp rc="); print_int(rc as i64); print(" path="); print(out_path); print("\n")
    } else if kind == 7 {
        let m = compiler_main_make_native_v2_wide_shr_unaligned_module()
        let rc = compile_native_v2_preview_to_file(&m, spec, out_path)
        print("wide-shr-unaligned rc="); print_int(rc as i64); print(" path="); print(out_path); print("\n")
    } else if kind == 8 {
        let m = compiler_main_make_native_v2_wide_divfull_module()
        let rc = compile_native_v2_preview_to_file(&m, spec, out_path)
        print("wide-divfull rc="); print_int(rc as i64); print(" path="); print(out_path); print("\n")
    } else if kind == 9 {
        let m = compiler_main_make_native_v2_wide_modfull_module()
        let rc = compile_native_v2_preview_to_file(&m, spec, out_path)
        print("wide-modfull rc="); print_int(rc as i64); print(" path="); print(out_path); print("\n")
    } else {
        let m = compiler_main_make_native_v2_wide_mul_module()
        let rc = compile_native_v2_preview_to_file(&m, spec, out_path)
        print("wide-mul rc="); print_int(rc as i64); print(" path="); print(out_path); print("\n")
    }
}

// Bridge: real .sio SOURCE -> front-half (parse/check/lower) -> IrModule ->
// native-v2 backend -> runnable x86-64 ELF. Composes compiler_preflight_ir_load
// (the --ir-dump front-half, source -> IrModule) with
// compile_native_v2_preview_to_file (the native-v2 IR -> ELF back-half). This is
// the first real source -> native-v2 path; the --native-v2-emit* witnesses only
// emit hardcoded IR.
// Crash-surviving marker buffer (write_file is a syscall; print is buffered and
// lost on SIGSEGV). Content is irrelevant — file existence is the signal. Uses a
// zero-fill init ([0;N] is the codegen-safe array-fill form).
var NV2_MARKER_BUF: [i8; 4] = [0; 4]
var NV2_RUN_ARGV: [i64; 32] = [0; 32]
var NV2_RUN_ENVP: [i64; 1] = [0; 1]

fn native_v2_wait_exit_code(status: i64) -> i64 {
    if (status & 127) == 0 {
        return (status >> 8) & 255
    }
    128 + (status & 127)
}

fn native_v2_run_elf_and_exit(path: string, args: ArgList, flag_index: i64) with IO, Mut, Panic, Div {
    syscall6(90, path, 493, 0, 0, 0, 0)
    NV2_RUN_ARGV[0] = path as i64
    var argv_len: i64 = 1
    var passthrough: bool = false
    var i: i64 = flag_index + 1
    while i < args.len && argv_len < 31 {
        let arg = arg_list_get(args, i)
        if passthrough {
            NV2_RUN_ARGV[argv_len as usize] = arg as i64
            argv_len = argv_len + 1
        } else if arg == "--" {
            passthrough = true
        }
        i = i + 1
    }
    NV2_RUN_ARGV[argv_len as usize] = 0
    NV2_RUN_ENVP[0] = 0

    let pid = syscall6(57, 0, 0, 0, 0, 0, 0)
    if pid < 0 {
        print("native_v2_compile: run fork failed\n")
        syscall6(60, 127, 0, 0, 0, 0, 0)
        return
    }
    if pid == 0 {
        syscall6(59, path as i64, &! NV2_RUN_ARGV, &! NV2_RUN_ENVP, 0, 0, 0)
        syscall6(60, 127, 0, 0, 0, 0, 0)
        return
    }

    var status: i64 = 0
    syscall6(61, pid, &! status, 0, 0, 0, 0)
    syscall6(60, native_v2_wait_exit_code(status), 0, 0, 0, 0, 0)
}

// Bridge: real .sio SOURCE -> multimodule front-half -> IrModule -> native-v2 -> ELF.
// Keep this on load_multimodule_ir_traced, the same front-half exercised by
// --probe-load-ir-trace. The older boxed single-module bridge is fragile in
// native-built Madaros before the first crash marker on trivial programs.
fn run_native_v2_compile_mode(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    let execute_after_compile = arg_list_get(args, flag_index) == "run"
    let source_path = compiler_mode_source_arg(args, flag_index, "--native-v2-compile")
    // Output path resolution: `-o <out>` wins; otherwise honor a second
    // positional argument (`mc --native-v2-compile src.sio out.elf`); else a.out.
    // Previously the second positional was silently ignored and every compile
    // wrote a.out — the root of the "writes no file at the requested path" report.
    let out_positional = compiler_mode_positional_arg(args, flag_index, 1, "a.out")
    let out_path = compiler_mode_output_path(args, out_positional)
    if !compiler_preflight_source_input(source_path) {
        panic("native-v2-compile failed: source not readable")
    }
    if !compiler_visibility_preflight(source_path) {
        panic("native-v2-compile failed: visibility preflight")
    }
    // Self-falsifying compiler rung: after type-check (preflights above),
    // before codegen — execute claim gates when --verify-claims is passed.
    if compiler_mode_has_flag(args, "--verify-claims") {
        let claim_fail_count = claim_executor_verify(source_path)
        if claim_fail_count != 0 {
            panic("native-v2-compile aborted: verify-claims gate failure")
        }
    }
    // The boxed compile-to-file route is SRET-safe for both imported and
    // single-module programs. MultiModuleIrResult.module is now Box<IrModule>
    // (no densify at the legacy load API); prefer this file route for large IR.
    let optimize = compiler_mode_has_flag(args, "-O") || compiler_mode_has_flag(args, "--optimize")
    let rc = module_frontend_compile_imported_to_file(source_path, out_path, optimize)
    if rc != 0 {
        print("native_v2_compile: front-half/backend failed rc=")
        print_int(rc as i64)
        print("\n")
        panic("native-v2-compile failed")
    }
    print("native_v2_compile: emitted path=")
    print(out_path)
    print("\n")
    if execute_after_compile {
        native_v2_run_elf_and_exit(out_path, args, flag_index)
    }
}

fn compiler_try_default_native_v2_single(opts: CompilerOptions) -> bool with IO, Mut, Panic, Div, Alloc {
    if opts.emit_manifest || opts.emit_ast || opts.emit_tokens {
        return false
    }
    if str_len(opts.gpu_target) > 0 {
        return false
    }
    if str_eq(opts.target, "llvm") || str_eq(opts.target, "wasm") {
        return false
    }
    if !compiler_preflight_source_input(opts.input_file) {
        return false
    }

    let incomplete_assign = compile_scan_incomplete_assignment(opts.input_file)
    if incomplete_assign.0 >= 0 {
        return false
    }

    let early_frontend_preflight = preflight_multimodule_frontend(opts.input_file)
    let early_preflight_parse_errors = parser_last_error_count()
    if !early_frontend_preflight.ok || early_preflight_parse_errors > 0 {
        return false
    }

    let main_prog = load_module_file(opts.input_file)
    let main_imports = extract_imports_from_ast(main_prog)
    if main_imports.count > 0 {
        return false
    }

    let requested_target_spec = native_resolve_target(opts.target, "auto", false)
    if requested_target_spec.arch_id != ARCH_X86_64() || requested_target_spec.os_id != OS_LINUX() {
        return false
    }

    let bridge_exit = module_frontend_compile_imported_to_file(opts.input_file, opts.output_file, opts.optimize)
    if bridge_exit != 0 {
        print("Compilation failed!\n\nErrors:\n  error: native-v2 bridge compilation failed\n")
        panic("compile failed")
    }
    print("Written to ")
    print(opts.output_file)
    print("\n")
    println("Compilation successful!")
    println("   Output: " + opts.output_file)
    true
}

// Parameterized scalar witness: --native-v2-emit-scalar <N> <out_path>.
// Reuses the scalar IR builder; the gate runs the ELF and asserts exit == N (mod 256).
// SCOPE: hardens the IR->ELF exit-code proof; source-level/front-half stays blocked on G1.
fn run_native_v2_emit_scalar(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 2 >= args.len {
        panic("native-v2-emit-scalar: usage --native-v2-emit-scalar <N> <out_path>")
    }
    let parsed = parse_i64_decimal(arg_list_get(args, flag_index + 1))
    let out_path = arg_list_get(args, flag_index + 2)
    run_native_v2_emit_exit_code(parsed.1, out_path)
}

