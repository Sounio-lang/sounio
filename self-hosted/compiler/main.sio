// T485: (b^a)^(c^a)→b^c  [rhs-rhs match: common factor a]
fn compiler_main_test_xor_cancel_rhs_rhs() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(3, 1, BinaryOp::OpBitXor, 0)   // r3 = r1 ^ r0
    instrs[1] = ir_binop(4, 2, BinaryOp::OpBitXor, 0)   // r4 = r2 ^ r0
    instrs[2] = ir_binop(5, 3, BinaryOp::OpBitXor, 4)   // r5 = r3 ^ r4 → r1 ^ r2
    instrs[3] = ir_return(5)
