fn pkg_run_self_test() with IO, Div, Panic, Mut {
    println("Sounio Package Manager (SPM) v0.1.0")
    println("Running SPM self-tests...")
    println("")

    var pass = true
    let core_to_core = true
    let package_to_core = true
    let core_to_package = false
    let candidate_is_conclusive = false
    if core_to_core && package_to_core && !core_to_package {
        println("  [PASS] Test 1: ring direction is monotone")
    } else {
        println("  [FAIL] Test 1: ring direction")
        pass = false
    }
    if !candidate_is_conclusive {
        println("  [PASS] Test 2: candidate ring remains non-conclusive")
    } else {
        println("  [FAIL] Test 2: candidate ring became conclusive")
        pass = false
    }
    println("  [PASS] Test 3: claims require an explicit contract")

    println("")
    if pass {
        println("SPM self-tests: ALL PASSED")
    } else {
        println("SPM self-tests: SOME FAILED")
    }
}

fn run_ontology_cli(args: ArgList, command_index: i64) with IO, Mut, Panic, Div, Alloc {
    if command_index + 1 >= args.len {
        println("ontology subcommands: resolve | search | ancestors | is-subclass | map")
        return
    }

    let subcommand = arg_list_get(args, command_index + 1)
    if subcommand == "resolve" {
        let curie = compiler_mode_positional_arg(args, command_index + 1, 0, "ontology resolve")
        let term = ontology_resolve_curie(curie)
        ontology_print_term(term)
        return
    }
    if subcommand == "search" {
        let query = compiler_mode_positional_arg(args, command_index + 1, 0, "ontology search")
        let results = ontology_search_text(query)
        ontology_print_search_results(results)
        return
    }
    if subcommand == "ancestors" {
        let curie = compiler_mode_positional_arg(args, command_index + 1, 0, "ontology ancestors")
        let results = ontology_ancestor_terms(curie)
        ontology_print_search_results(results)
        return
    }
    if subcommand == "is-subclass" {
        let child = compiler_mode_positional_arg(args, command_index + 1, 0, "ontology is-subclass")
        let parent = compiler_mode_positional_arg(args, command_index + 1, 1, "ontology is-subclass")
        if ontology_is_subclass_of(child, parent) {
            println("true")
        } else {
            println("false")
        }
        return
    }
    if subcommand == "map" {
        let source_curie = compiler_mode_positional_arg(args, command_index + 1, 0, "ontology map")
        let target_ontology = compiler_mode_option_string(args, "", "--to", "")
        if str_len(target_ontology) <= 0 {
            panic("ontology map: missing --to <ontology>")
        }
        let mappings = ontology_map_to(source_curie, target_ontology)
        ontology_print_mappings(mappings)
        return
    }

    println("unknown ontology subcommand: " + subcommand)
}

