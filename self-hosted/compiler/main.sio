fn compile_emit_manifest_json_from_source(path: string) -> CompileResult with IO, Mut, Panic, Div, Alloc {
    var merged_epistemic = ir_empty_epistemic_section()
    let frontend_result = load_multimodule_epistemic_into(path, &!merged_epistemic)
    if !frontend_result.ok {
        var check_errors = compile_errors_new()
        check_errors = compile_push_ir_failure(check_errors, frontend_result.error_msg)
        return CompileResult { success: false, errors: check_errors, output: "" }
    }

    compiler_emit_manifest_json(path, &merged_epistemic)
    CompileResult {
        success: true,
        errors: compile_errors_new(),
        output: "stdout",
    }
}

// ============================================================================
// COMPILATION PIPELINE
// ============================================================================

fn compile(opts: CompilerOptions) -> CompileResult with IO, Mut, Panic, Div, Alloc {
    if file_size(opts.input_file) <= 0 {
        var file_errors = compile_errors_new()
        file_errors = compile_errors_push(file_errors, compile_format_error_at(opts.input_file, 0, 0, "could not read input file"))
        return CompileResult {
            success: false,
            errors: file_errors,
            output: "",
        }
    }

    let incomplete_assign = compile_scan_incomplete_assignment(opts.input_file)
    if incomplete_assign.0 {
        var parse_like_errors = compile_errors_new()
        parse_like_errors = compile_errors_push(
            parse_like_errors,
            compile_format_error_at(opts.input_file, incomplete_assign.1, incomplete_assign.2, "syntax appears incomplete after assignment")
        )
        return CompileResult {
            success: false,
            errors: parse_like_errors,
            output: "",
        }
    }

    if opts.emit_manifest {
        return compile_emit_manifest_json_from_source(opts.input_file)
    }

    // Preflight load catches parse/module-resolution failures early and avoids
    // driving native compilation on obviously invalid inputs.
    let ir_result = load_multimodule_ir(opts.input_file)
    let preflight_parse_errors = parser_last_error_count()
    if !ir_result.ok || preflight_parse_errors > 0 {
        var preflight_errors = compile_errors_new()
        if !ir_result.ok {
            preflight_errors = compile_push_ir_failure(preflight_errors, ir_result.error_msg)
        }
        if preflight_parse_errors > 0 {
            preflight_errors = compile_errors_push(preflight_errors, "error: parser reported " + int_to_string(preflight_parse_errors) + " syntax errors")
        }
        if preflight_errors.len == 0 {
            preflight_errors = compile_errors_push(preflight_errors, "error: compilation preflight failed")
        }
        return CompileResult {
            success: false,
            errors: preflight_errors,
            output: "",
        }
    }

    let exit_code = compile_multimodule_native_with_ir(
        opts.input_file,
        ir_result.module,
        opts.output_file,
        opts.target,
        "auto",
        false,
        opts.gpu_target,
        opts.gpu_binary_format,
        opts.gpu_strict_parity
    )

    if exit_code == 0 {
        return CompileResult {
            success: true,
            errors: compile_errors_new(),
            output: opts.output_file,
        }
    }

    // Diagnostic replay path: preserve compile_multimodule_native behavior while
    // collecting structured messages for callers.
    var errors = compile_errors_new()
    if !ir_result.ok {
        errors = compile_push_ir_failure(errors, ir_result.error_msg)
    } else {
        let target_spec = native_resolve_target(opts.target, "auto", false)
        let native_result = compile_native(&ir_result.module, target_spec)
        if !native_result.ok {
            errors = compile_errors_push_lines(errors, "error: ", native_result.error_msg)
        }
    }

    let parse_errors = parser_last_error_count()
    if parse_errors > 0 {
        errors = compile_errors_push(errors, "error: parser reported " + int_to_string(parse_errors) + " syntax errors")
    }
    if errors.len == 0 {
        errors = compile_errors_push(errors, "error: compilation failed (no structured diagnostics captured)")
    }

    CompileResult {
        success: false,
        errors: errors,
        output: "",
    }
}

fn compiler_main_test_char_from_i64_valid() -> bool with Mut, Panic, Div {
    char_from_i64(0) == "0" &&
    char_from_i64(5) == "5" &&
    char_from_i64(9) == "9"
}

fn compiler_main_test_char_from_i64_error_messages() -> bool with Mut, Panic, Div {
    char_from_i64_error(-1) == "char_from_i64: digit must be 0-9, got -1" &&
    char_from_i64_error(10) == "char_from_i64: digit must be 0-9, got 10"
}

fn compiler_main_test_arg_list_get_valid() -> bool with Mut, Panic, Div {
    let args = ArgList {
        items: ["alpha", "beta", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        len: 2,
    }
    arg_list_get(args, 0) == "alpha" && arg_list_get(args, 1) == "beta"
}

fn compiler_main_test_arg_list_get_error_messages() -> bool with Mut, Panic, Div {
    arg_list_get_error(-1, 3) == "arg_list_get: index -1 out of bounds (length 3)" &&
    arg_list_get_error(3, 3) == "arg_list_get: index 3 out of bounds (length 3)" &&
    arg_list_get_error(4, 3) == "arg_list_get: index 4 out of bounds (length 3)"
}

fn compiler_main_test_int_to_string() -> bool with Mut, Panic, Div {
    let i64_max = 9223372036854775807
    let i64_min = (0 - i64_max) - 1
    int_to_string(0) == "0" &&
    int_to_string(7) == "7" &&
    int_to_string(42) == "42" &&
    int_to_string(-42) == "-42" &&
    int_to_string(i64_max) == "9223372036854775807" &&
    int_to_string(i64_min) == "-9223372036854775808"
}

fn run_compiler_main_self_tests() -> i32 with IO, Mut, Panic, Div {
    var passed: i64 = 0
    let total: i64 = 5

    println("=== compiler/main.sio self-tests ===")

    if compiler_main_test_char_from_i64_valid() {
        println("  T01 OK: char_from_i64 valid digits")
        passed = passed + 1
    } else {
        println("  FAIL: T01 char_from_i64 valid digits")
    }

    if compiler_main_test_char_from_i64_error_messages() {
        println("  T02 OK: char_from_i64 error format")
        passed = passed + 1
    } else {
        println("  FAIL: T02 char_from_i64 error format")
    }

    if compiler_main_test_arg_list_get_valid() {
        println("  T03 OK: arg_list_get in-bounds")
        passed = passed + 1
    } else {
        println("  FAIL: T03 arg_list_get in-bounds")
    }

    if compiler_main_test_arg_list_get_error_messages() {
        println("  T04 OK: arg_list_get error format")
        passed = passed + 1
    } else {
        println("  FAIL: T04 arg_list_get error format")
    }

    if compiler_main_test_int_to_string() {
        println("  T05 OK: int_to_string edge cases")
        passed = passed + 1
    } else {
        println("  FAIL: T05 int_to_string edge cases")
    }

    println("")
    println("compiler/main tests: " + int_to_string(passed) + "/" + int_to_string(total) + " passed")
    if passed == total { 0 } else { 1 }
}

// ============================================================================
// MAIN
// ============================================================================

fn main() with IO, Mut, Panic, Div, Alloc {
    let args = get_args()

    println("SOUNIO SELF-HOSTED COMPILER v0.80.0")
    println("Horizon 3: self-hosted primary compiler.")
    println("")

    var arg_idx: i64 = 0
    while arg_idx < args.len {
        let mode = arg_list_get(args, arg_idx)
        if mode == "--self-test" {
            let self_test_code = run_compiler_main_self_tests()
            if self_test_code != 0 {
                panic("compiler/main self-tests failed")
            }
            return
        } else if mode == "--bench-int-to-string" {
            run_int_to_string_bench_from_args(args, arg_idx)
            return
        } else if mode == "--probe-char-from-i64" {
            run_probe_char_from_i64(args, arg_idx)
            return
        } else if mode == "--probe-arg-list-get" {
            run_probe_arg_list_get(args, arg_idx)
            return
        } else if mode == "--probe-compile-capture" || mode == "--probe-cc" || starts_with(mode, "--probe-c") {
            run_probe_compile_capture(args, arg_idx)
            return
        } else if mode == "--probe-frontend" || starts_with(mode, "--probe-front") {
            run_probe_frontend(args, arg_idx)
            return
        } else if mode == "--probe-epistemic-check" || starts_with(mode, "--probe-epi") {
            run_probe_epistemic_check(args, arg_idx)
            return
        } else if mode == "--probe-load-ir" || starts_with(mode, "--probe-load") {
            run_probe_load_ir(args, arg_idx)
            return
        } else if mode == "--probe-wasm-dispatch" || starts_with(mode, "--probe-wasm") {
            run_probe_wasm_dispatch(args, arg_idx)
            return
        } else if starts_with(mode, "--probe") {
            run_probe_compile_capture(args, arg_idx)
            return
        }
        arg_idx = arg_idx + 1
    }

    let opts = parse_options(args)

    if opts.verbose {
        println("Options:")
        println("  Input:  " + opts.input_file)
        println("  Output: " + opts.output_file)
        println("  Target: " + opts.target)
        println("  GPU Target: " + opts.gpu_target)
        println("  GPU Binary Format: " + opts.gpu_binary_format)
        let strict_label = if opts.gpu_strict_parity { "true" } else { "false" }
        println("  GPU Strict Parity: " + strict_label)
        println("")
    }

    let result = compile(opts)

    if result.success {
        println("Compilation successful!")
        println("   Output: " + result.output)

        if result.errors.len > 0 {
            println("")
            println("Warnings:")
            var i: i64 = 0
            while i < result.errors.len {
                println("  " + compile_errors_get(result.errors, i))
                i = i + 1
            }
        }
    } else {
        println("Compilation failed!")
        println("")
        println("Errors:")
        var i: i64 = 0
        while i < result.errors.len {
            println("  " + compile_errors_get(result.errors, i))
            i = i + 1
        }
        exit_process(1)
    }
}
