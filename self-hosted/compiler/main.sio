// ============================================================================
// Sprint 117 — GUM arithmetic for Knowledge<f64> (T412-T417)
// JCGM 100:2008 (GUM) SS5.1.2-5.1.3: uncertainty propagation
// ============================================================================

// T412: knowledge_add IR — value = a.value + b.value via IrFieldGet + IrBinOp(OpAdd)
fn compiler_main_test_gum_add_value() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_float(0, 3.0)
    instrs[1] = ir_alloc(1, 0)
    instrs[2] = ir_field_set(1, 0, 0, make_name("value"))
    instrs[3] = ir_load_float(2, 5.0)
    instrs[4] = ir_alloc(3, 0)
    instrs[5] = ir_field_set(3, 0, 2, make_name("value"))
    instrs[6] = ir_field_get(4, 1, 0, make_name("value"))
    instrs[7] = ir_field_get(5, 3, 0, make_name("value"))
    instrs[8] = ir_binop(6, 4, BinaryOp::OpAdd, 5)
    instrs[9] = ir_return(6)
    let func = cp_make_test_func(instrs, 10)
    (IR_A_OP[(ir_region_slot_r(func.region, (8))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(func.region, (8))) as usize] as BinaryOp) == BinaryOp::OpAdd
        && IR_A_SRC1[(ir_region_slot_r(func.region, (8))) as usize] == 4
        && IR_A_SRC2[(ir_region_slot_r(func.region, (8))) as usize] == 5
}

// T413: knowledge_add variance = a.variance + b.variance (GUM SS5.1.2)
fn compiler_main_test_gum_add_variance() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_float(0, 0.25)
    instrs[1] = ir_load_float(1, 0.16)
    instrs[2] = ir_alloc(2, 0)
    instrs[3] = ir_field_set(2, 1, 0, make_name("variance"))
    instrs[4] = ir_alloc(3, 0)
    instrs[5] = ir_field_set(3, 1, 1, make_name("variance"))
    instrs[6] = ir_field_get(4, 2, 1, make_name("variance"))
    instrs[7] = ir_field_get(5, 3, 1, make_name("variance"))
    instrs[8] = ir_binop(6, 4, BinaryOp::OpAdd, 5)
    instrs[9] = ir_return(6)
    let func = cp_make_test_func(instrs, 10)
    (IR_A_BIN_OP[(ir_region_slot_r(func.region, (8))) as usize] as BinaryOp) == BinaryOp::OpAdd
}

// T414: knowledge_sub variance also uses OpAdd (partials squared cancel sign)
fn compiler_main_test_gum_sub_variance_uses_add() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_float(0, 0.09)
    instrs[1] = ir_load_float(1, 0.04)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs[3] = ir_return(2)
    let func = cp_make_test_func(instrs, 4)
    (IR_A_BIN_OP[(ir_region_slot_r(func.region, (2))) as usize] as BinaryOp) == BinaryOp::OpAdd
}

// T415: knowledge_mul variance = a.val^2 * b.var + b.val^2 * a.var (GUM SS5.1.3)
fn compiler_main_test_gum_mul_variance_formula() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_float(0, 2.0)
    instrs[1] = ir_load_float(1, 0.25)
    instrs[2] = ir_load_float(2, 3.0)
    instrs[3] = ir_load_float(3, 0.16)
    instrs[4] = ir_binop(4, 0, BinaryOp::OpMul, 0)
    instrs[5] = ir_binop(5, 4, BinaryOp::OpMul, 3)
    instrs[6] = ir_binop(6, 2, BinaryOp::OpMul, 2)
    instrs[7] = ir_binop(7, 6, BinaryOp::OpMul, 1)
    instrs[8] = ir_binop(8, 5, BinaryOp::OpAdd, 7)
    instrs[9] = ir_return(8)
    let func = cp_make_test_func(instrs, 10)
    (IR_A_BIN_OP[(ir_region_slot_r(func.region, (4))) as usize] as BinaryOp) == BinaryOp::OpMul && IR_A_SRC1[(ir_region_slot_r(func.region, (4))) as usize] == 0 && IR_A_SRC2[(ir_region_slot_r(func.region, (4))) as usize] == 0
        && (IR_A_BIN_OP[(ir_region_slot_r(func.region, (5))) as usize] as BinaryOp) == BinaryOp::OpMul && IR_A_SRC1[(ir_region_slot_r(func.region, (5))) as usize] == 4
        && (IR_A_BIN_OP[(ir_region_slot_r(func.region, (8))) as usize] as BinaryOp) == BinaryOp::OpAdd && IR_A_SRC1[(ir_region_slot_r(func.region, (8))) as usize] == 5 && IR_A_SRC2[(ir_region_slot_r(func.region, (8))) as usize] == 7
}

// T416: knowledge_div value = a.value / b.value (OpDiv)
fn compiler_main_test_gum_div_value() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_float(0, 10.0)
    instrs[1] = ir_load_float(1, 2.0)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpDiv, 1)
    instrs[3] = ir_return(2)
    let func = cp_make_test_func(instrs, 4)
    (IR_A_BIN_OP[(ir_region_slot_r(func.region, (2))) as usize] as BinaryOp) == BinaryOp::OpDiv && IR_A_SRC1[(ir_region_slot_r(func.region, (2))) as usize] == 0 && IR_A_SRC2[(ir_region_slot_r(func.region, (2))) as usize] == 1
}

// T417: confidence = min(a.conf, b.conf) via comparison + branch
fn compiler_main_test_gum_confidence_min() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_float(0, 0.95)
    instrs[1] = ir_load_float(1, 0.90)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpLt, 1)
    instrs[3] = ir_branch_true(2, 0)
    instrs[4] = ir_copy(3, 1)
    instrs[5] = ir_jump(1)
    instrs[6] = ir_label(0)
    instrs[7] = ir_copy(3, 0)
    instrs[8] = ir_label(1)
    instrs[9] = ir_return(3)
    let func = cp_make_test_func(instrs, 10)
    (IR_A_BIN_OP[(ir_region_slot_r(func.region, (2))) as usize] as BinaryOp) == BinaryOp::OpLt && (IR_A_OP[(ir_region_slot_r(func.region, (3))) as usize] as IrOpcode) == IrOpcode::IrBranchTrue
}


// ============================================================================
// Sprint 119 — exp/log native builtin self-tests (T418-T421)
// ============================================================================

// T418: name_is_exp recognizes "exp", rejects "log"
fn compiler_main_test_name_is_exp() -> bool with Mut, Div, Panic {
    var n_exp = empty_name()
    n_exp.buf[0] = 101 as i8
    n_exp.buf[1] = 120 as i8
    n_exp.buf[2] = 112 as i8
    n_exp.len = 3
    var n_log = empty_name()
    n_log.buf[0] = 108 as i8
    n_log.buf[1] = 111 as i8
    n_log.buf[2] = 103 as i8
    n_log.len = 3
    name_is_exp(n_exp) && !name_is_exp(n_log)
}

// T419: name_is_log recognizes "log", rejects "exp"
fn compiler_main_test_name_is_log() -> bool with Mut, Div, Panic {
    var n_exp = empty_name()
    n_exp.buf[0] = 101 as i8
    n_exp.buf[1] = 120 as i8
    n_exp.buf[2] = 112 as i8
    n_exp.len = 3
    var n_log = empty_name()
    n_log.buf[0] = 108 as i8
    n_log.buf[1] = 111 as i8
    n_log.buf[2] = 103 as i8
    n_log.len = 3
    name_is_log(n_log) && !name_is_log(n_exp)
}

// T420: emit_builtin_exp produces >50 bytes of code
fn compiler_main_test_emit_exp_produces_code() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    let before_len = nc.code.len
    nc = emit_builtin_exp(nc)
    let after_len = nc.code.len
    (after_len - before_len) > 50
}

// T421: emit_builtin_log produces >50 bytes of code
fn compiler_main_test_emit_log_produces_code() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    let before_len = nc.code.len
    nc = emit_builtin_log(nc)
    let after_len = nc.code.len
    (after_len - before_len) > 50
}

