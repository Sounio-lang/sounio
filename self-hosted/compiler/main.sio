    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (2))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (2))) as usize] as BinaryOp) == BinaryOp::OpSub
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (2))) as usize] == 4
        && IR_A_SRC2[(ir_region_slot_r(opt.region, (2))) as usize] == 1
}

fn compiler_main_test_dn_sub_sub_self() -> bool with Mut, Div, Panic {
    // (r0-r1)-(r0-r1) → z=y, so z-y=0
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
