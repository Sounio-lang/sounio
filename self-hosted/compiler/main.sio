        && (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (4))) as usize] as BinaryOp) == BinaryOp::OpBitOr
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (4))) as usize] == 0
}

