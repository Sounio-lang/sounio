// Sprint 189 Block CY: AND complement addition (T800-T805)
fn compiler_main_test_cy_and_comp_add_basic() -> bool with Mut, Div, Panic {
    // (r0&5)+(r0&~5) → r0; ~5=-6
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
    instrs[0 as usize] = ir_load_imm(1, 5)
