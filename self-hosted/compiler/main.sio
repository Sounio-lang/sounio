        && (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (2))) as usize] as BinaryOp) == BinaryOp::OpDiv
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (2))) as usize] == 0 && IR_A_SRC2[(ir_region_slot_r(opt.region, (2))) as usize] == 1
}

