}

// T486: (a^b)^(c^d) — no common factor, no fold
fn compiler_main_test_xor_cancel_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(4, 0, BinaryOp::OpBitXor, 1)   // r4 = r0 ^ r1
    instrs[1] = ir_binop(5, 2, BinaryOp::OpBitXor, 3)   // r5 = r2 ^ r3
    instrs[2] = ir_binop(6, 4, BinaryOp::OpBitXor, 5)   // r6 = r4 ^ r5 [no common factor]
    instrs[3] = ir_return(6)
    let func = cp_make_test_func(instrs, 4)
    let opt = opt_cleanup_function(func)
    // Must NOT fold — still r4 ^ r5
    (IR_A_OP[(ir_region_slot_r(opt.region, (2))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (2))) as usize] == 4 && IR_A_SRC2[(ir_region_slot_r(opt.region, (2))) as usize] == 5
}

// T487: const source prevents XOR tracking — (r0^42)^(r0^r1) does NOT fold via Block AU
fn compiler_main_test_xor_cancel_const_no_track() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(3, 42)                       // r3 = 42
    instrs[1] = ir_binop(4, 0, BinaryOp::OpBitXor, 3)   // r4 = r0 ^ 42 (not tracked: r3 is const)
    instrs[2] = ir_binop(5, 0, BinaryOp::OpBitXor, 1)   // r5 = r0 ^ r1 (tracked)
    instrs[3] = ir_binop(6, 4, BinaryOp::OpBitXor, 5)   // r6 = r4 ^ r5 [no AU fold: r4 not tracked]
    instrs[4] = ir_return(6)
    let func = cp_make_test_func(instrs, 5)
    let opt = opt_cleanup_function(func)
    // Block AU should not fire — r4 not in as_xor_rr_valid
    IR_A_SRC1[(ir_region_slot_r(opt.region, (3))) as usize] == 4 && IR_A_SRC2[(ir_region_slot_r(opt.region, (3))) as usize] == 5
}

// Sprint 135: Block AW — Negation propagation through multiplication (T488-T493)
// neg(a) * neg(b) → a * b — ring theory: (-a)(-b) = ab
// neg(a) / neg(b) → a / b — field theory extension
// SOTA: LLVM InstCombineMulDivRem.cpp

// T488: neg(a) * neg(b) → a * b  [double-neg mul elimination]
fn compiler_main_test_neg_neg_mul() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    // r0=a, r1=b (implicit params)
    instrs[0] = ir_unaryop(2, UnaryOp::OpNeg, 0)        // r2 = neg(a)
    instrs[1] = ir_unaryop(3, UnaryOp::OpNeg, 1)        // r3 = neg(b)
    instrs[2] = ir_binop(4, 2, BinaryOp::OpMul, 3)      // r4 = neg(a) * neg(b) → a * b
    instrs[3] = ir_return(4)
    let func = cp_make_test_func(instrs, 4)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (2))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (2))) as usize] as BinaryOp) == BinaryOp::OpMul
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (2))) as usize] == 0 && IR_A_SRC2[(ir_region_slot_r(opt.region, (2))) as usize] == 1
}

