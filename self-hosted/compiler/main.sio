fn run_probe_epistemic_check(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 1 >= args.len {
        panic("probe_epistemic_check: missing source file argument")
    }
    let source_path = arg_list_get(args, flag_index + 1)
    println("probe_epistemic_check: begin")
    print("probe_epistemic_check: source=")
    print(source_path)
    print("\n")

    var merged_epistemic = ir_empty_epistemic_section()
    let frontend_result = load_multimodule_epistemic_into(source_path, &!merged_epistemic)
    if frontend_result.ok {
        print("probe_epistemic_check: ok")
        print(" contests=")
        print_int(merged_epistemic.contest_count)
        print(" robust=")
        print_int(merged_epistemic.robust_proof_count)
        print(" deferred=")
        print_int(merged_epistemic.deferred_certificate_count)
        print(" acquisition=")
        print_int(merged_epistemic.acquisition_plan_count)
        print(" recourse=")
        print_int(merged_epistemic.recourse_plan_count)
        print(" transition=")
        print_int(merged_epistemic.transition_plan_count)
        print(" observed=")
        print_int(merged_epistemic.observed_transition_count)
        print(" rollback=")
        print_int(merged_epistemic.rollback_certificate_count)
        print("\n")
        return
    }

    println("probe_epistemic_check: fail")
    if str_len(frontend_result.error_msg) > 0 {
        print("probe_epistemic_check: error=")
        print(frontend_result.error_msg)
        print("\n")
    }
    panic("probe_epistemic_check failed")
}

fn log_wasm_dispatch(source_path: string, output_path: string) with IO {
    print("WASM dispatch: source=")
    print(source_path)
    print(" output=")
    print(output_path)
    print("\n")
}

fn run_probe_wasm_dispatch(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div {
    if flag_index + 1 >= args.len {
        panic("probe_wasm_dispatch: missing source file argument")
    }
    let source_path = arg_list_get(args, flag_index + 1)
    var output_path = "artifacts/sprint2/wasm_dispatch/probe.wasm"
    if flag_index + 2 < args.len {
        output_path = arg_list_get(args, flag_index + 2)
    }
    println("probe_wasm_dispatch: begin")
    log_wasm_dispatch(source_path, output_path)
    println("probe_wasm_dispatch: ok")
}

// Sprint 48: --show-profile probe — inspect .sprof file and show promotion decisions
fn run_probe_show_profile(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div {
    if flag_index + 1 >= args.len {
        panic("show-profile: missing .sprof file argument")
    }
    let sprof_path = arg_list_get(args, flag_index + 1)
    let prof_size = file_size(sprof_path)
    if prof_size <= 0 {
        println("[sprof] error: file not found or empty: " + sprof_path)
        return
    }
    let prof_bytes = read_file(sprof_path)
    var prof_buf: [i8; 4096] = [0; 4096]
    var pi: i64 = 0
    while pi < prof_size && pi < 4096 {
        prof_buf[pi as usize] = prof_bytes[pi as usize]
        pi = pi + 1
    }
    let profile = sprof_parse(prof_buf, prof_size)
    println("[sprof] profile: " + sprof_path + " (" + int_to_string(profile.entry_count) + " entries)")
    var ei: i64 = 0
    while ei < profile.entry_count {
        let entry = profile.entries[ei as usize]
        let target = sprof_promotion_target(entry.count)
        print("[sprof] ")
        compiler_manifest_print_name(entry.fn_name)
        print(": count " + int_to_string(entry.count) + " -> ")
        if target >= 0 {
            println("strategy " + ir_strategy_name(target))
        } else {
            println("no promotion")
        }
        ei = ei + 1
    }
}

fn char_from_i64(n: i64) -> string with Mut, Panic {
    if n < 0 || n > 9 {
        panic(char_from_i64_error(n))
    }
    str_slice("0123456789", n, n + 1)
}

fn i64_to_string_decimal(n: i64) -> string with Mut, Panic, Div {
    var out: [i8; 24] = [0; 24]
    if n == 0 {
        out[0] = 48 as i8
        return str_from_bytes(out, 1)
    }

    var value = n
    var digits: i64 = 1
    while value <= -10 || value >= 10 {
        digits = digits + 1
        value = value / 10
    }

    let negative = n < 0
    let total_len = if negative { digits + 1 } else { digits }

    var write = total_len - 1
    value = n
    while value <= -10 || value >= 10 {
        var digit = value % 10
        if digit < 0 {
            digit = 0 - digit
        }
        out[write as usize] = (48 + digit) as i8
        write = write - 1
        value = value / 10
    }

    var final_digit = value
    if final_digit < 0 {
        final_digit = 0 - final_digit
    }
    out[write as usize] = (48 + final_digit) as i8

    if negative {
        out[0] = 45 as i8
    }

    str_from_bytes(out, total_len)
}

fn int_to_string(n: i64) -> string with Mut, Panic, Div {
    i64_to_string_decimal(n)
}

// ============================================================================
// ARG LIST  (replaces Vec<string> for command-line args)
// ============================================================================

struct ArgList {
    items: [string; 64],
    len: i64,
}

fn arg_list_get(lst: ArgList, i: i64) -> string with Mut, Panic {
    if i < 0 || i >= lst.len {
        panic(arg_list_get_error(i, lst.len))
    }
    lst.items[i as usize]
}

fn arg_list_get_error(index: i64, len: i64) -> string with Mut, Panic {
    "arg_list_get: index " + i64_to_string_no_div(index) +
    " out of bounds (length " + i64_to_string_no_div(len) + ")"
}

// ============================================================================
// COMPILE ERROR LIST  (replaces Vec<string> in CompileResult)
// ============================================================================

struct CompileErrors {
    items: [string; 64],
    len: i64,
}

fn compile_errors_new() -> CompileErrors {
    CompileErrors {
        items: [""; 64],
        len: 0,
    }
}

fn compile_errors_push(errs: CompileErrors, s: string) -> CompileErrors {
    var out = errs
    if out.len < 64 {
        out.items[out.len as usize] = s
        out.len = out.len + 1
    }
    out
}

fn compile_errors_get(errs: CompileErrors, i: i64) -> string {
    errs.items[i as usize]
}

fn compile_trim_line(line: string) -> string with Mut, Panic, Div {
    let line_len = str_len(line)
    if line_len > 0 && str_char_at(line, line_len - 1) == 13 {
        str_slice(line, 0, line_len - 1)
    } else {
        line
    }
}

fn compile_errors_push_lines(errs: CompileErrors, prefix: string, text: string) -> CompileErrors with Mut, Panic, Div {
    var out = errs
    let n = str_len(text)
    if n <= 0 {
        return out
    }

    var start: i64 = 0
    var i: i64 = 0
    while i < n {
        if str_char_at(text, i) == 10 {
            if i > start {
                let raw_line = str_slice(text, start, i)
                let line = compile_trim_line(raw_line)
                if str_len(line) > 0 {
                    out = compile_errors_push(out, prefix + line)
                }
            }
            start = i + 1
        }
        i = i + 1
    }

    if start < n {
        let raw_line = str_slice(text, start, n)
        let line = compile_trim_line(raw_line)
        if str_len(line) > 0 {
            out = compile_errors_push(out, prefix + line)
        }
    }

    out
}

fn compile_push_ir_failure(errs: CompileErrors, reason: string) -> CompileErrors with Mut, Panic, Div {
    var out = errs
    if str_eq(reason, "module_resolution_failed") {
        out = compile_errors_push(out, "error: module resolution failed")
    } else if str_eq(reason, "type_check_failed") {
        out = compile_errors_push(out, "error: type checking failed")
    } else if str_eq(reason, "ir_lowering_failed") {
        out = compile_errors_push(out, "error: IR lowering failed")
    } else {
        out = compile_errors_push(out, "error: " + reason)
    }

    let parse_errors = parser_last_error_count()
    if parse_errors > 0 {
        out = compile_errors_push(out, "error: parser reported " + int_to_string(parse_errors) + " syntax errors")
    }
    out
}

fn compile_byte_is_whitespace(ch: i8) -> bool {
    ch == (32 as i8) || ch == (9 as i8) || ch == (13 as i8) || ch == (10 as i8)
}

fn compile_byte_is_rhs_terminator(ch: i8) -> bool {
    ch == (125 as i8) || ch == (41 as i8) || ch == (93 as i8) || ch == (59 as i8) || ch == (44 as i8)
}

fn compile_scan_incomplete_assignment(path: string) -> (bool, i64, i64) with IO, Mut, Panic, Div {
    let size = file_size(path)
    if size <= 0 {
        return (false, 0, 0)
    }
    let bytes = read_file(path)

    var i: i64 = 0
    var line: i64 = 1
    var col: i64 = 1
    while i < size {
        let ch = bytes[i as usize]
        if ch == (61 as i8) { // '='
            var j = i + 1
            while j < size {
                let next = bytes[j as usize]
                if compile_byte_is_whitespace(next) {
                    j = j + 1
                    continue
                }
                if compile_byte_is_rhs_terminator(next) {
                    return (true, line, col)
                }
                break
            }
            if j >= size {
                return (true, line, col)
            }
        }
        if ch == (10 as i8) {
            line = line + 1
            col = 1
        } else {
            col = col + 1
        }
        i = i + 1
    }
    (false, 0, 0)
}

fn compiler_bytes_contains(bytes: [i8; 65536], size: i64, needle: string) -> bool with Mut, Panic, Div {
    let needle_len = str_len(needle)
    if needle_len <= 0 {
        return true
    }
    if size < needle_len {
        return false
    }

    var i: i64 = 0
    while i <= size - needle_len {
        var j: i64 = 0
        var matched = true
        while j < needle_len {
            if bytes[(i + j) as usize] != (str_char_at(needle, j) as i8) {
                matched = false
                break
            }
            j = j + 1
        }
        if matched {
            return true
        }
        i = i + 1
    }
    false
}

fn compiler_bytes_contains_seq_i64(bytes: [i8; 65536], size: i64, seq: [i64; 32], seq_len: i64) -> bool with Mut, Panic, Div {
    if seq_len <= 0 {
        return true
    }
    if size < seq_len {
        return false
    }

    var i: i64 = 0
    while i <= size - seq_len {
        var j: i64 = 0
        var matched = true
        while j < seq_len {
            if bytes[(i + j) as usize] != (seq[j as usize] as i8) {
                matched = false
                break
            }
            j = j + 1
        }
        if matched {
            return true
        }
        i = i + 1
    }
    false
}

fn compile_format_error_at(path: string, line: i64, col: i64, msg: string) -> string with Mut, Panic, Div {
    "error: at " + path + ":" + int_to_string(line) + ":" + int_to_string(col) + " - " + msg
}

