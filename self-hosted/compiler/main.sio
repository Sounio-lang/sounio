// Sprint 166 Block CB: Add/sub-const inverse (T662-T667)
fn compiler_main_test_cb_add_sub_inverse_basic() -> bool with Mut, Div, Panic {
    // (r0+5)-5 → r0: bt_add then sub same const
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
