        passed = passed + 1
        println("  T925 OK: Sprint 209 Block DS: ~(r0|r1) no fold plain OR")
    } else { println("  FAIL: T925") }
    passed
}

// Self-test dispatcher part 9/10: split out of run_compiler_main_self_tests
// because the monolithic body lowered to 33829 IR instructions, past IR_MAX_INSTRS.
// Each part stays far under the IR cap and under the DCE/const-prop 8192 caps,
// so every analysis pass remains complete on every part (no refusal, no truncation).
fn compiler_main_self_tests_part_09(passed_in: i64) -> i64 with IO, Mut, Panic, Div, Alloc {
    var passed = passed_in

    // Sprint 210 Block DT: OR-AND complement absorption (T926-T931)
    if compiler_main_test_dt_or_and_comp_basic() {
        passed = passed + 1
        println("  T926 OK: Sprint 210 Block DT: r0|(r1&~r0) -> r0|r1")
    } else { println("  FAIL: T926") }
    if compiler_main_test_dt_or_and_comp_comm_and() {
        passed = passed + 1
        println("  T927 OK: Sprint 210 Block DT: r0|(~r0&r1) -> r0|r1 AND comm")
    } else { println("  FAIL: T927") }
    if compiler_main_test_dt_or_and_comp_comm_or() {
        passed = passed + 1
        println("  T928 OK: Sprint 210 Block DT: (r1&~r0)|r0 -> r0|r1 OR comm")
    } else { println("  FAIL: T928") }
    if compiler_main_test_dt_no_fold_diff_var() {
        passed = passed + 1
        println("  T929 OK: Sprint 210 Block DT: r0|(r1&~r2) no fold diff var")
    } else { println("  FAIL: T929") }
    if compiler_main_test_dt_no_fold_no_not() {
        passed = passed + 1
        println("  T930 OK: Sprint 210 Block DT: r0|(r1&r2) no fold no NOT")
    } else { println("  FAIL: T930") }
    if compiler_main_test_dt_no_fold_and_outer() {
        passed = passed + 1
        println("  T931 OK: Sprint 210 Block DT: r0&(r1&~r0) no fold AND outer")
    } else { println("  FAIL: T931") }

    // Sprint 211 Block DU: XOR-AND to OR (T932-T937)
    if compiler_main_test_du_xor_and_or_basic() {
        passed = passed + 1
        println("  T932 OK: Sprint 211 Block DU: (r0^r1)|(r0&r1) -> r0|r1")
    } else { println("  FAIL: T932") }
    if compiler_main_test_du_xor_and_or_comm_inner() {
        passed = passed + 1
        println("  T933 OK: Sprint 211 Block DU: (r1^r0)|(r0&r1) -> r1|r0 inner comm")
    } else { println("  FAIL: T933") }
    if compiler_main_test_du_xor_and_or_comm_outer() {
        passed = passed + 1
        println("  T934 OK: Sprint 211 Block DU: (r0&r1)|(r0^r1) -> r0|r1 outer comm")
    } else { println("  FAIL: T934") }
    if compiler_main_test_du_no_fold_diff_vars() {
        passed = passed + 1
        println("  T935 OK: Sprint 211 Block DU: (r0^r1)|(r0&r2) no fold diff vars")
    } else { println("  FAIL: T935") }
    if compiler_main_test_du_no_fold_xor_and_and() {
        passed = passed + 1
        println("  T936 OK: Sprint 211 Block DU: (r0^r1)&(r0&r1) no fold AND outer")
    } else { println("  FAIL: T936") }
    if compiler_main_test_du_no_fold_xor_or() {
        passed = passed + 1
        println("  T937 OK: Sprint 211 Block DU: (r0^r1)|(r0|r1) no fold inner OR")
    } else { println("  FAIL: T937") }

    // Sprint 212 Block DV: XOR-AND-OR simplify (T938-T943)
    if compiler_main_test_dv_xor_and_or_basic() {
        passed = passed + 1
        println("  T938 OK: Sprint 212 Block DV: (r0^r1)&(r0|r1) -> IrCopy(xor)")
    } else { println("  FAIL: T938") }
    if compiler_main_test_dv_xor_and_or_comm_outer() {
        passed = passed + 1
        println("  T939 OK: Sprint 212 Block DV: (r0|r1)&(r0^r1) -> IrCopy(xor) comm")
    } else { println("  FAIL: T939") }
    if compiler_main_test_dv_xor_and_or_comm_inner() {
