    instrs[3] = ir_binop(6, 1, BinaryOp::OpBitXor, 5)
    instrs[4] = ir_binop(7, 3, BinaryOp::OpBitXor, 6)
    let func   = cp_make_test_func(instrs, 5)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (4))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(result.region, (4))) as usize] as BinaryOp) == BinaryOp::OpBitXor
        && IR_A_SRC1[(ir_region_slot_r(result.region, (4))) as usize] == 0
        && IR_A_SRC2[(ir_region_slot_r(result.region, (4))) as usize] == 1
}

