    let func = cp_make_test_func(instrs, 4)
    let opt = opt_cleanup_function(func)
    // EI should not fire (s2 is OR not AND)
    // Result could be -1 (if DI/DX fires) — just verify no IrCopy of register 3 from EI
    (IR_A_OP[(ir_region_slot_r(opt.region, (3))) as usize] as IrOpcode) != IrOpcode::IrCopy
        || IR_A_SRC1[(ir_region_slot_r(opt.region, (3))) as usize] != 3
}

