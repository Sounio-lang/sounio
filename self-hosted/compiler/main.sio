// Sprint 112 Block AI: Bitwise NOT via XOR(-1) — double-NOT elimination (T376-T381).
// SOTA: LLVM InstCombineAndOrXor.cpp; Hacker's Delight §2-2.

// T376: NOT(NOT(x)) → IrCopy(x).
fn compiler_main_test_double_bnot() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, -1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitXor, 1)
    instrs[2] = ir_load_imm(3, -1)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpBitXor, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 0
}

// T377: NOT(NOT(x)) with (-1) on left → IrCopy(x).
fn compiler_main_test_double_bnot_commutative() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, -1)
    instrs[1] = ir_binop(2, 1, BinaryOp::OpBitXor, 0)
    instrs[2] = ir_load_imm(3, -1)
    instrs[3] = ir_binop(4, 3, BinaryOp::OpBitXor, 2)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 0
}

// T378: Single NOT tracked but not folded.
fn compiler_main_test_single_bnot_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, -1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitXor, 1)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(result.region, (1))) as usize] as BinaryOp) == BinaryOp::OpBitXor
}

// T379: XOR with non-(-1) constant → no NOT tracking.
fn compiler_main_test_xor_not_neg1_no_track() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 42)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitXor, 1)
    instrs[2] = ir_load_imm(3, 42)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpBitXor, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    // Block L (assoc XOR): x ^ 42 ^ 42 → x ^ 0 → x ^ 0 (identity caught later)
    // But NOT tracking should NOT fire — this is not double-NOT.
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) != IrOpcode::IrCopy || IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] != 0
}

// T380: AND with NOT → no fold (just tracking).
fn compiler_main_test_bnot_with_and() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, -1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitXor, 1)
    instrs[2] = ir_binop(3, 2, BinaryOp::OpBitAnd, 4)
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(result.region, (2))) as usize] as BinaryOp) == BinaryOp::OpBitAnd
}

// T381: Triple NOT → single NOT (first two cancel).
fn compiler_main_test_triple_bnot() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, -1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitXor, 1)
    instrs[2] = ir_load_imm(3, -1)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpBitXor, 3)
    instrs[4] = ir_load_imm(5, -1)
    instrs[5] = ir_binop(6, 4, BinaryOp::OpBitXor, 5)
    let func   = cp_make_test_func(instrs, 6)
    let result = ocp_const_fold(func)
    // First double-NOT: instrs[3] → IrCopy(r0)
    // Third NOT: r6 = r4 ^ (-1). r4 = IrCopy(r0), so via copy prop
    // r6 = r0 ^ (-1) — still a NOT (not eliminated). Check instrs[3] is copy.
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 0
}


// Sprint 113 Block AJ: Boolean comparison with 1 (T382-T387).
// SOTA: LLVM InstCombineCompares.cpp.

// T382: bool == 1 → IrCopy(bool).
fn compiler_main_test_bool_eq_one() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(1, 2, BinaryOp::OpLt, 3)
    instrs[1] = ir_load_imm(4, 1)
    instrs[2] = ir_binop(5, 1, BinaryOp::OpEq, 4)
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (2))) as usize] == 1
}

// T383: 1 == bool → IrCopy(bool) (commutative).
fn compiler_main_test_one_eq_bool() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(1, 2, BinaryOp::OpGe, 3)
    instrs[1] = ir_load_imm(4, 1)
    instrs[2] = ir_binop(5, 4, BinaryOp::OpEq, 1)
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (2))) as usize] == 1
}

// T384: bool != 1 → (bool == 0).
fn compiler_main_test_bool_ne_one() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(1, 2, BinaryOp::OpEq, 3)
    instrs[1] = ir_load_imm(4, 1)
    instrs[2] = ir_binop(5, 1, BinaryOp::OpNe, 4)
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    (IR_A_BIN_OP[(ir_region_slot_r(result.region, (2))) as usize] as BinaryOp) == BinaryOp::OpEq
        && IR_A_IMM_I64[(ir_region_slot_r(result.region, (1))) as usize] == 0
}

// T385: Non-bool == 1 → no fold (src1 is not a cmp result).
fn compiler_main_test_non_bool_eq_one_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(1, 2, BinaryOp::OpAdd, 3)
    instrs[1] = ir_load_imm(4, 1)
    instrs[2] = ir_binop(5, 1, BinaryOp::OpEq, 4)
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(result.region, (2))) as usize] as BinaryOp) == BinaryOp::OpEq
}

// T386: bool == 2 → no fold (not 0 or 1 constant).
fn compiler_main_test_bool_eq_two_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(1, 2, BinaryOp::OpLt, 3)
    instrs[1] = ir_load_imm(4, 2)
    instrs[2] = ir_binop(5, 1, BinaryOp::OpEq, 4)
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(result.region, (2))) as usize] as BinaryOp) == BinaryOp::OpEq
}

// T387: Chain: (x < y) == 1 → IrCopy(r1), then r1 != 0 → IrCopy(r1) (Block Y).
fn compiler_main_test_bool_eq_one_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(1, 2, BinaryOp::OpLt, 3)
    instrs[1] = ir_load_imm(4, 1)
    instrs[2] = ir_binop(5, 1, BinaryOp::OpEq, 4)
    instrs[3] = ir_load_imm(6, 0)
    instrs[4] = ir_binop(7, 5, BinaryOp::OpNe, 6)
    let func   = cp_make_test_func(instrs, 5)
    let result = ocp_const_fold(func)
    // instrs[2] → IrCopy(r5, r1), then instrs[4] → r7 = r5 != 0
    // Block Y fires on instrs[4] since r5 is cmp result? Actually r5 = IrCopy(r1).
    // Depends on whether copy-through preserves is_cmp_result. It doesn't.
    // So instrs[4] stays as OpNe. Just check instrs[2] folded.
    (IR_A_OP[(ir_region_slot_r(result.region, (2))) as usize] as IrOpcode) == IrOpcode::IrCopy
}


// Sprint 114 Block AK: Redundant AND elimination — superset mask (T388-T393).
// SOTA: LLVM InstCombineAndOrXor.cpp; known-bits analysis.

// T388: (x & 0xFF) & 0xFFFF → IrCopy (0xFF is subset of 0xFFFF).
fn compiler_main_test_and_superset_copy() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 255)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitAnd, 1)
    instrs[2] = ir_load_imm(3, 65535)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpBitAnd, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 2
}

// T389: (x & 0xF) & 0xFF → IrCopy (0xF subset of 0xFF).
fn compiler_main_test_and_superset_nibble() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 15)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitAnd, 1)
    instrs[2] = ir_load_imm(3, 255)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpBitAnd, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 2
}

// T390: (x & 0xFF) & 0x0F → NOT superset (0xFF has bits outside 0x0F) → Block AE fold.
fn compiler_main_test_and_not_superset() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 255)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitAnd, 1)
    instrs[2] = ir_load_imm(3, 15)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpBitAnd, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    // Not a superset: 0xFF & 0x0F = 0x0F != 0xFF. Block AE fires instead.
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(result.region, (3))) as usize] as BinaryOp) == BinaryOp::OpBitAnd
}

// T391: (x & 0xFF) & 0xFF → same mask = superset → IrCopy.
fn compiler_main_test_and_same_mask_copy() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 255)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitAnd, 1)
    instrs[2] = ir_load_imm(3, 255)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpBitAnd, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 2
}

// T392: Commutative — const on left: 0xFFFF & (x & 0xFF) → IrCopy.
fn compiler_main_test_and_superset_commutative() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 255)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitAnd, 1)
    instrs[2] = ir_load_imm(3, 65535)
    instrs[3] = ir_binop(4, 3, BinaryOp::OpBitAnd, 2)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (3))) as usize] as IrOpcode) == IrOpcode::IrCopy
        && IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 2
}

// T393: No AND tracking on src → no fold.
fn compiler_main_test_and_no_track_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(1, 2, BinaryOp::OpAdd, 3)
