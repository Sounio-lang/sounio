    // Unequal: should NOT fold to AND
    IR_A_SRC1[(ir_region_slot_r(result.region, (3))) as usize] == 2
}

// T363: shift-mask chains with Block AE: ((x << 8) >> 8) & 0xFF → x & 0xFF
fn compiler_main_test_shift_mask_chain_with_and() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 8)
