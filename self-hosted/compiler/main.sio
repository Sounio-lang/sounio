            if ao > 0 { print(", ") }
            print("{\"name\": ")
            compiler_manifest_print_name_json((*ep).alternative_policies[i].objective_names[ao])
            print(", \"direction\": ")
            if (*ep).alternative_policies[i].objective_directions[ao] == 1 {
                compiler_manifest_print_string_json("maximize")
            } else {
                compiler_manifest_print_string_json("minimize")
            }
            print("}")
            ao = ao + 1
        }
