    instrs[3 as usize] = ir_load_imm(3, 5)
    instrs[4 as usize] = ir_binop(4, 3, BinaryOp::OpBitOr, 2)   // r4 = 5|(x^5)
    let func = cp_make_test_func(instrs, 5)
    let result = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (4))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(result.region, (4))) as usize] as BinaryOp) == BinaryOp::OpBitOr
        && IR_A_SRC1[(ir_region_slot_r(result.region, (4))) as usize] == 0
}

