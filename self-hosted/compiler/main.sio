fn compiler_load_manifest_epistemic(path: string) -> CompilerManifestLoadResult with IO, Mut, Panic, Div, Alloc {
    var merged_epistemic = ir_empty_epistemic_section()
    let frontend_result = load_multimodule_epistemic_into(path, &!merged_epistemic)
    if !frontend_result.ok {
        var check_errors = compile_errors_new()
        check_errors = compile_push_ir_failure(check_errors, frontend_result.error_msg)
        return compiler_manifest_load_result_error(check_errors)
    }
    compiler_manifest_load_result_ok(merged_epistemic)
}

fn compile_emit_manifest_json_from_source(path: string) -> CompileResult with IO, Mut, Panic, Div, Alloc {
    let manifest_result = compiler_load_manifest_epistemic(path)
    if !manifest_result.ok {
        return CompileResult { success: false, errors: manifest_result.errors, output: "" }
    }

    compiler_emit_manifest_json(path, &manifest_result.epistemic)
    CompileResult {
        success: true,
        errors: compile_errors_new(),
        output: "stdout",
    }
}

// ============================================================================
// COMPILATION PIPELINE
// ============================================================================

fn compile(opts: CompilerOptions) -> CompileResult with IO, Mut, Panic, Div, Alloc {
    if file_size(opts.input_file) <= 0 {
        var file_errors = compile_errors_new()
        file_errors = compile_errors_push(file_errors, compile_format_error_at(opts.input_file, 0, 0, "could not read input file"))
        return CompileResult {
            success: false,
            errors: file_errors,
            output: "",
        }
    }

    let incomplete_assign = compile_scan_incomplete_assignment(opts.input_file)
    if incomplete_assign.0 {
        var parse_like_errors = compile_errors_new()
        parse_like_errors = compile_errors_push(
            parse_like_errors,
            compile_format_error_at(opts.input_file, incomplete_assign.1, incomplete_assign.2, "syntax appears incomplete after assignment")
        )
        return CompileResult {
            success: false,
            errors: parse_like_errors,
            output: "",
        }
    }

    if opts.emit_manifest {
        return compile_emit_manifest_json_from_source(opts.input_file)
    }

    // Preflight load catches parse/module-resolution failures early and avoids
    // driving native compilation on obviously invalid inputs.
    var ir_result = load_multimodule_ir(opts.input_file)
    let preflight_parse_errors = parser_last_error_count()
    if !ir_result.ok || preflight_parse_errors > 0 {
        var preflight_errors = compile_errors_new()
        if !ir_result.ok {
            preflight_errors = compile_push_ir_failure(preflight_errors, ir_result.error_msg)
        }
        if preflight_parse_errors > 0 {
            preflight_errors = compile_errors_push(preflight_errors, "error: parser reported " + int_to_string(preflight_parse_errors) + " syntax errors")
        }
        if preflight_errors.len == 0 {
            preflight_errors = compile_errors_push(preflight_errors, "error: compilation preflight failed")
        }
        return CompileResult {
            success: false,
            errors: preflight_errors,
            output: "",
        }
    }

    // Sprint 50: hoist profile for layout pass
    var has_valid_profile = false
    var loaded_profile = sprof_empty_profile()

    // Sprint 47: apply .sprof profile-guided strategy promotion
    if opts.use_profile {
        let prof_size = file_size(opts.use_profile_path)
        if prof_size > 0 {
            let prof_bytes = read_file(opts.use_profile_path)
            var prof_buf: [i8; 4096] = [0; 4096]
            var pi: i64 = 0
            while pi < prof_size && pi < 4096 {
                prof_buf[pi as usize] = prof_bytes[pi as usize]
                pi = pi + 1
            }
            let profile = sprof_parse(prof_buf, prof_size)
            sprof_apply_promotion(&!ir_result.module, &profile)

            // Sprint 48: log promotion decisions
            var li: i64 = 0
            while li < ir_result.module.fn_count {
                let lcount = sprof_lookup(&profile, &ir_result.module.functions[li as usize].name)
                let ltarget = sprof_promotion_target(lcount)
                if ltarget >= 0 {
                    print("[sprof] ")
                    compiler_manifest_print_name(ir_result.module.functions[li as usize].name)
                    println(": count " + int_to_string(lcount) + " -> strategy " + ir_strategy_name(ltarget))
                }
                li = li + 1
            }

            loaded_profile = profile
            has_valid_profile = true
        }
    }

    // Sprint 49: Apply inlining pass when -O is set
    if opts.optimize {
        let pre_inline_count = ir_result.module.fn_count
        ir_result.module = inl_run_pass(ir_result.module)
        println("[inline] pass complete: " + int_to_string(pre_inline_count) + " functions processed")
    }

    // Sprint 50: Profile-guided function layout
    if has_valid_profile {
        let layout_result = layout_sort_by_profile(ir_result.module, &loaded_profile)
        ir_result.module = layout_result.module
        if layout_result.reordered {
            println("[layout] reordered " + int_to_string(ir_result.module.fn_count) + " functions (" + int_to_string(layout_result.hot_count) + " hot, " + int_to_string(layout_result.cold_count) + " cold)")
        }
    }

    // Sprint 51: const_fold + DCE cleanup after inlining
    if opts.optimize {
        let pre_opt_count = ir_result.module.fn_count
        ir_result.module = opt_cleanup_module(ir_result.module)
        println("[opt] const_prop + dce applied to " + int_to_string(pre_opt_count) + " functions")
        let loop_result = lopt_optimize_module(ir_result.module)
        ir_result.module = loop_result.module
        if loop_result.functions_changed > 0 {
            println("[loop] hoisted " + int_to_string(loop_result.invariants_hoisted) +
                    " invariants across " + int_to_string(loop_result.functions_changed) + " functions")
        }
        ir_result.module = opt_cleanup_module(ir_result.module)
    }

    // Sprint 54: Tail call optimization
    if opts.optimize {
        let tco_result = tco_run_pass(ir_result.module)
        ir_result.module = tco_result.0
        let tco_ctx = tco_result.1
        if tco_ctx.stats.transformed > 0 {
            println("[tco] " + int_to_string(tco_ctx.stats.transformed) + " tail call(s) converted to loops")
        }
    }

    let exit_code = compile_multimodule_native_with_ir(
        opts.input_file,
        ir_result.module,
        opts.output_file,
        opts.target,
        "auto",
        false,
        opts.gpu_target,
        opts.gpu_binary_format,
        opts.gpu_strict_parity
    )

    if exit_code == 0 {
        return CompileResult {
            success: true,
            errors: compile_errors_new(),
            output: opts.output_file,
        }
    }

    // Diagnostic replay path: preserve compile_multimodule_native behavior while
    // collecting structured messages for callers.
    var errors = compile_errors_new()
    if !ir_result.ok {
        errors = compile_push_ir_failure(errors, ir_result.error_msg)
    } else {
        let target_spec = native_resolve_target(opts.target, "auto", false)
        let native_result = compile_native(&ir_result.module, target_spec)
        if !native_result.ok {
            errors = compile_errors_push_lines(errors, "error: ", native_result.error_msg)
        }
    }

    let parse_errors = parser_last_error_count()
    if parse_errors > 0 {
        errors = compile_errors_push(errors, "error: parser reported " + int_to_string(parse_errors) + " syntax errors")
    }
    if errors.len == 0 {
        errors = compile_errors_push(errors, "error: compilation failed (no structured diagnostics captured)")
    }

    CompileResult {
        success: false,
        errors: errors,
        output: "",
    }
}

fn compiler_main_test_char_from_i64_valid() -> bool with Mut, Panic, Div {
    char_from_i64(0) == "0" &&
    char_from_i64(5) == "5" &&
    char_from_i64(9) == "9"
}

fn compiler_main_test_char_from_i64_error_messages() -> bool with Mut, Panic, Div {
    char_from_i64_error(-1) == "char_from_i64: digit must be 0-9, got -1" &&
    char_from_i64_error(10) == "char_from_i64: digit must be 0-9, got 10"
}

fn compiler_main_test_arg_list_get_valid() -> bool with Mut, Panic, Div {
    let args = ArgList {
        items: ["alpha", "beta", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        len: 2,
    }
    arg_list_get(args, 0) == "alpha" && arg_list_get(args, 1) == "beta"
}

fn compiler_main_test_arg_list_get_error_messages() -> bool with Mut, Panic, Div {
    arg_list_get_error(-1, 3) == "arg_list_get: index -1 out of bounds (length 3)" &&
    arg_list_get_error(3, 3) == "arg_list_get: index 3 out of bounds (length 3)" &&
    arg_list_get_error(4, 3) == "arg_list_get: index 4 out of bounds (length 3)"
}

fn compiler_main_test_int_to_string() -> bool with Mut, Panic, Div {
    let i64_max = 9223372036854775807
    let i64_min = (0 - i64_max) - 1
    int_to_string(0) == "0" &&
    int_to_string(7) == "7" &&
    int_to_string(42) == "42" &&
    int_to_string(-42) == "-42" &&
    int_to_string(i64_max) == "9223372036854775807" &&
    int_to_string(i64_min) == "-9223372036854775808"
}

fn compiler_main_native_byte_u8(b: i8) -> i64 {
    let x = b as i64
    if x < 0 { x + 256 } else { x }
}

fn compiler_main_native_code_eq(a: CodeBuffer, b: CodeBuffer) -> bool {
    if a.len != b.len { return false }
    var i: i64 = 0
    while i < a.len {
        if compiler_main_native_byte_u8(a.bytes[i as usize]) != compiler_main_native_byte_u8(b.bytes[i as usize]) {
            return false
        }
        i = i + 1
    }
    true
}

fn compiler_main_native_find_pattern4(
    buf: CodeBuffer, b0: i64, b1: i64, b2: i64, b3: i64
) -> i64 {
    if buf.len < 4 { return -1 }
    var i: i64 = 0
    while i <= buf.len - 4 {
        if compiler_main_native_byte_u8(buf.bytes[i as usize]) == b0 &&
           compiler_main_native_byte_u8(buf.bytes[(i + 1) as usize]) == b1 &&
           compiler_main_native_byte_u8(buf.bytes[(i + 2) as usize]) == b2 &&
           compiler_main_native_byte_u8(buf.bytes[(i + 3) as usize]) == b3 {
            return i
        }
        i = i + 1
    }
    -1
}

fn compiler_main_find_fn(m: IrModule, name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < m.fn_count {
        if ir_name_eq(m.functions[i].name, name) {
            return i
        }
        i = i + 1
    }
    -1
}

fn compiler_main_find_call_idx(f: IrFunction, callee_name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < f.instr_count {
        if f.instrs[i].op == IrOpcode::IrCall &&
           ir_name_eq(f.instrs[i].name, callee_name) {
            return i
        }
        i = i + 1
    }
    -1
}

fn compiler_main_has_load_imm_dst_value(f: IrFunction, dst: i64, value: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < f.instr_count {
        if f.instrs[i].op == IrOpcode::IrLoadImm &&
           f.instrs[i].dst == dst &&
           f.instrs[i].imm_i64 == value {
            return true
        }
        i = i + 1
    }
    false
}

fn compiler_main_test_strategy_float_strict_modes_match() -> bool with Mut, Panic, Div {
    let instr = ir_binop(2, 0, BinaryOp::OpAdd, 1)

    var standard = compiler_new()
    standard.current_strategy = IR_STRATEGY_STANDARD
    standard.is_float_reg[0] = 1
    standard.is_float_reg[1] = 1
    standard = lower_ir_binop(standard, instr)

    var precision = compiler_new()
    precision.current_strategy = IR_STRATEGY_PRECISION_PRESERVING
    precision.is_float_reg[0] = 1
    precision.is_float_reg[1] = 1
    precision = lower_ir_binop(precision, instr)

    let standard_lhs = compiler_main_native_find_pattern4(standard.code, 0x48, 0x8B, 0x45, 0xF8)
    let standard_rhs = compiler_main_native_find_pattern4(standard.code, 0x48, 0x8B, 0x45, 0xF0)
    let precision_lhs = compiler_main_native_find_pattern4(precision.code, 0x48, 0x8B, 0x45, 0xF8)
    let precision_rhs = compiler_main_native_find_pattern4(precision.code, 0x48, 0x8B, 0x45, 0xF0)
    let addsd_standard = compiler_main_native_find_pattern4(standard.code, 0xF2, 0x0F, 0x58, 0xC1)
    let addsd_precision = compiler_main_native_find_pattern4(precision.code, 0xF2, 0x0F, 0x58, 0xC1)

    standard.is_float_reg[2] == 1 &&
    precision.is_float_reg[2] == 1 &&
    compiler_main_native_code_eq(standard.code, precision.code) &&
    standard_lhs >= 0 &&
    standard_rhs >= 0 &&
    precision_lhs >= 0 &&
    precision_rhs >= 0 &&
    standard_lhs < standard_rhs &&
    precision_lhs < precision_rhs &&
    addsd_standard >= 0 &&
    addsd_precision >= 0
}

fn compiler_main_test_strategy_float_aggressive_diverges() -> bool with Mut, Panic, Div {
    let instr = ir_binop(2, 0, BinaryOp::OpAdd, 1)

    var standard = compiler_new()
    standard.current_strategy = IR_STRATEGY_STANDARD
    standard.is_float_reg[0] = 1
    standard.is_float_reg[1] = 1
    standard = lower_ir_binop(standard, instr)

    var aggressive = compiler_new()
    aggressive.current_strategy = IR_STRATEGY_AGGRESSIVE
    aggressive.is_float_reg[0] = 1
    aggressive.is_float_reg[1] = 1
    aggressive = lower_ir_binop(aggressive, instr)

    let standard_lhs = compiler_main_native_find_pattern4(standard.code, 0x48, 0x8B, 0x45, 0xF8)
    let standard_rhs = compiler_main_native_find_pattern4(standard.code, 0x48, 0x8B, 0x45, 0xF0)
    let aggressive_src2_first = compiler_main_native_find_pattern4(aggressive.code, 0x48, 0x8B, 0x45, 0xF0)
    let aggressive_src1_second = compiler_main_native_find_pattern4(aggressive.code, 0x48, 0x8B, 0x45, 0xF8)
    let addsd_standard = compiler_main_native_find_pattern4(standard.code, 0xF2, 0x0F, 0x58, 0xC1)
    let addsd_aggressive = compiler_main_native_find_pattern4(aggressive.code, 0xF2, 0x0F, 0x58, 0xC1)

    standard.is_float_reg[2] == 1 &&
    aggressive.is_float_reg[2] == 1 &&
    !compiler_main_native_code_eq(standard.code, aggressive.code) &&
    standard_lhs >= 0 &&
    standard_rhs >= 0 &&
    aggressive_src2_first >= 0 &&
    aggressive_src1_second >= 0 &&
    standard_lhs < standard_rhs &&
    aggressive_src2_first < aggressive_src1_second &&
    addsd_standard >= 0 &&
    addsd_aggressive >= 0
}

fn compiler_main_one_arg(reg: i64) -> Option<Box<IrRegList>> with Alloc {
    Some(Box::new(IrRegList { head: reg, tail: None }))
}

fn compiler_main_test_validated_chain_forwarding() -> bool with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()
    module.fn_count = 2

    var outer_fn = ir_empty_function()
    outer_fn.name = make_name("outer_contested")
    outer_fn.compile_strategy = IR_STRATEGY_INSTRUMENTED
    outer_fn.param_count = 2
    outer_fn.param_regs[0] = 0
    outer_fn.param_regs[1] = 1
    outer_fn.reg_count = 3
    outer_fn.instr_count = 2
    outer_fn.instrs[0] = ir_call(2, 1, make_name("inner_contested"), compiler_main_one_arg(1), 1)
    outer_fn.instrs[1] = ir_return(2)

    var inner_fn = ir_empty_function()
    inner_fn.name = make_name("inner_contested")
    inner_fn.compile_strategy = IR_STRATEGY_INSTRUMENTED
    inner_fn.param_count = 2
    inner_fn.param_regs[0] = 0
    inner_fn.param_regs[1] = 1
    inner_fn.reg_count = 2
    inner_fn.instr_count = 1
    inner_fn.instrs[0] = ir_return(1)

    module.functions[0] = outer_fn
    module.functions[1] = inner_fn
    ir_patch_validated_calls(&! module)

    let patched_outer = module.functions[0]
    let call = patched_outer.instrs[0]
    call.op == IrOpcode::IrCall &&
    call.fn_id == 1 &&
    call.arg_count == 2 &&
    call.src1 == patched_outer.param_regs[0] &&
    call.src2 == patched_outer.param_regs[1]
}

fn compiler_main_test_validated_chain_top_level_fallback() -> bool with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()
    module.fn_count = 2

    var main_fn = ir_empty_function()
    main_fn.name = make_name("main")
    main_fn.compile_strategy = IR_STRATEGY_STANDARD
    main_fn.reg_count = 2
    main_fn.instr_count = 3
    main_fn.instrs[0] = ir_load_imm(0, 5)
    main_fn.instrs[1] = ir_call(1, 1, make_name("outer_contested"), compiler_main_one_arg(0), 1)
    main_fn.instrs[2] = ir_return(1)

    var outer_fn = ir_empty_function()
    outer_fn.name = make_name("outer_contested")
    outer_fn.compile_strategy = IR_STRATEGY_INSTRUMENTED
    outer_fn.param_count = 2
    outer_fn.param_regs[0] = 0
    outer_fn.param_regs[1] = 1
    outer_fn.reg_count = 2
    outer_fn.instr_count = 1
    outer_fn.instrs[0] = ir_return(1)

    module.functions[0] = main_fn
    module.functions[1] = outer_fn
    ir_patch_validated_calls(&! module)

    let patched_main = module.functions[0]
    let call = patched_main.instrs[2]
    patched_main.instr_count == 4 &&
    patched_main.reg_count == 3 &&
    patched_main.instrs[0].op == IrOpcode::IrLoadImm &&
    patched_main.instrs[0].imm_i64 == 1 &&
    call.op == IrOpcode::IrCall &&
    call.fn_id == 1 &&
    call.arg_count == 2 &&
    call.src1 == patched_main.instrs[0].dst &&
    call.src2 == 0
}

fn compiler_main_test_ir_opt_dispatch_and_merge() -> bool with Mut, Panic, Div {
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.param_count = 1
    func.param_regs[0] = 0
    func.reg_count = 4
    func.label_count = 3
    func.compile_strategy = IR_STRATEGY_INSTRUMENTED
    func.instr_count = 8
    func.instrs[0] = ir_branch_false(0, 1)
    func.instrs[1] = ir_load_imm(1, 11)
    func.instrs[2] = ir_copy(3, 1)
    func.instrs[3] = ir_jump(2)
    func.instrs[4] = ir_label(1)
    func.instrs[5] = ir_load_imm(2, 22)
    func.instrs[6] = ir_copy(3, 2)
    func.instrs[7] = ir_return(3)

    let transformed = ir_opt_apply_strategy(func)
    let dispatch_label = ir_opt_max_label(func) + 1
    let instr_label = dispatch_label + 1
    let merge_label = dispatch_label + 2

    transformed.instr_count == 24 &&
    transformed.label_count == 6 &&
    transformed.instrs[0].op == IrOpcode::IrLabel &&
    transformed.instrs[0].label_id == dispatch_label &&
    transformed.instrs[1].op == IrOpcode::IrBranchTrue &&
    transformed.instrs[1].src1 == 0 &&
    transformed.instrs[1].label_id == 0 &&
    transformed.instrs[2].op == IrOpcode::IrJump &&
    transformed.instrs[2].label_id == instr_label &&
    transformed.instrs[22].op == IrOpcode::IrLabel &&
    transformed.instrs[22].label_id == merge_label &&
    transformed.instrs[23].op == IrOpcode::IrReturn &&
    transformed.instrs[23].src1 == 3
}

fn compiler_main_test_ir_opt_branch_targets_remapped() -> bool with Mut, Panic, Div {
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(98, 114, 97, 110, 4)
    func.param_count = 1
    func.param_regs[0] = 0
    func.reg_count = 4
    func.label_count = 3
    func.compile_strategy = IR_STRATEGY_INSTRUMENTED
    func.instr_count = 8
    func.instrs[0] = ir_branch_false(0, 1)
    func.instrs[1] = ir_load_imm(1, 11)
    func.instrs[2] = ir_copy(3, 1)
    func.instrs[3] = ir_jump(2)
    func.instrs[4] = ir_label(1)
    func.instrs[5] = ir_load_imm(2, 22)
    func.instrs[6] = ir_copy(3, 2)
    func.instrs[7] = ir_return(3)

    let transformed = ir_opt_apply_strategy(func)
    let label_offset = ir_opt_max_label(func) + 1

    var saw_remapped_branch = false
    var saw_remapped_jump = false
    var saw_remapped_label = false
    var i: i64 = 0
    while i < transformed.instr_count {
        let instr = transformed.instrs[i as usize]
        if instr.op == IrOpcode::IrBranchFalse && instr.label_id == 1 + label_offset {
            saw_remapped_branch = true
        }
        if instr.op == IrOpcode::IrJump && instr.label_id == 2 + label_offset {
            saw_remapped_jump = true
        }
        if instr.op == IrOpcode::IrLabel && instr.label_id == 1 + label_offset {
            saw_remapped_label = true
        }
        i = i + 1
    }

    saw_remapped_branch && saw_remapped_jump && saw_remapped_label
}

fn compiler_main_test_ir_opt_expands_local_reg_range() -> bool with Mut, Panic, Div {
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(97, 100, 100, 50, 4)
    func.param_count = 2
    func.param_regs[0] = 0
    func.param_regs[1] = 1
    func.reg_count = 3
    func.compile_strategy = IR_STRATEGY_INSTRUMENTED
    func.instr_count = 2
    func.instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    func.instrs[1] = ir_return(2)

    let transformed = ir_opt_apply_strategy(func)
    var total_binops: i64 = 0
    var saw_expanded_dst = false
    var i: i64 = 0
    while i < transformed.instr_count {
        let instr = transformed.instrs[i as usize]
        if instr.op == IrOpcode::IrBinOp && instr.bin_op == BinaryOp::OpAdd {
            total_binops = total_binops + 1
            if instr.dst >= func.reg_count {
                saw_expanded_dst = true
            }
        }
        i = i + 1
    }

    transformed.reg_count > func.reg_count && total_binops == 2 && saw_expanded_dst
}

// Sprint 44: verify IrProfCounter is injected in the instrumented path
fn compiler_main_test_prof_counter_in_instrumented_path() -> bool with Mut, Panic, Div {
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(112, 114, 111, 102, 4)
    func.param_count = 1
    func.param_regs[0] = 0
    func.reg_count = 2
    func.compile_strategy = IR_STRATEGY_INSTRUMENTED
    func.prof_counter_id = 7
    func.instr_count = 2
    func.instrs[0] = ir_load_imm(1, 42)
    func.instrs[1] = ir_return(1)

    let transformed = ir_opt_apply_strategy(func)
    let label_offset = ir_opt_max_label(func) + 1
    let instr_label = label_offset + 1

    var saw_prof_counter = false
    var after_instr_label = false
    var saw_instr_label = false
    var i: i64 = 0
    while i < transformed.instr_count {
        let instr = transformed.instrs[i as usize]
        if instr.op == IrOpcode::IrLabel && instr.label_id == instr_label {
            saw_instr_label = true
        }
        if instr.op == IrOpcode::IrProfCounter {
            saw_prof_counter = true
            if saw_instr_label {
                after_instr_label = true
            }
        }
        i = i + 1
    }
    saw_prof_counter && after_instr_label
}

// Sprint 44: verify NO IrProfCounter appears in the fast path region
fn compiler_main_test_prof_counter_absent_from_fast_path() -> bool with Mut, Panic, Div {
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(102, 97, 115, 116, 4)
    func.param_count = 1
    func.param_regs[0] = 0
    func.reg_count = 2
    func.compile_strategy = IR_STRATEGY_INSTRUMENTED
    func.prof_counter_id = 3
    func.instr_count = 2
    func.instrs[0] = ir_load_imm(1, 99)
    func.instrs[1] = ir_return(1)

    let transformed = ir_opt_apply_strategy(func)
    let label_offset = ir_opt_max_label(func) + 1
    let instr_label = label_offset + 1

    // Fast path is between the dispatch jump (index 2) and the instr_label
    var in_fast_path = false
    var counter_in_fast_path = false
    var i: i64 = 0
    while i < transformed.instr_count {
        let instr = transformed.instrs[i as usize]
        if i == 3 { in_fast_path = true }
        if instr.op == IrOpcode::IrLabel && instr.label_id == instr_label {
            in_fast_path = false
        }
        if in_fast_path && instr.op == IrOpcode::IrProfCounter {
            counter_in_fast_path = true
        }
        i = i + 1
    }
    !counter_in_fast_path
}

// Sprint 45: verify INC encoding (48 FF 05) emitted for IrProfCounter
fn compiler_main_test_prof_counter_inc_encoding() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    let instr = ir_prof_counter(3)
    nc = lower_instr(nc, instr)
    // INC QWORD PTR [RIP+disp32]: 48 FF 05 <4 bytes disp32> = 7 bytes total
    if nc.code.len != 7 { return false }
    if nc.code.bytes[0] != 0x48 as i8 { return false }
    if nc.code.bytes[1] != 0xFF as i8 { return false }
    if nc.code.bytes[2] != 0x05 as i8 { return false }
    true
}

// Sprint 45: verify .data relocation recorded with kind_code=3
fn compiler_main_test_prof_counter_reloc_recorded() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    let instr = ir_prof_counter(3)
    nc = lower_instr(nc, instr)
    if nc.relocs.count != 1 { return false }
    let reloc = nc.relocs.entries[0]
    // kind_code must be 3 (.data RIP-relative)
    if reloc.kind.kind_code != 3 { return false }
    // target_index must account for the RuntimeContext global slot in .data.
    if reloc.target.target_index != runtime_context_global_slot_size() + (3 * 8) { return false }
    true
}

// Sprint 46: verify __prof_dump function is emitted when prof_counter_count > 0
fn compiler_main_test_prof_dump_emitted() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    // Simulate: 1 prof counter with fn_name "test" at .rodata offset 0
    nc.prof_counter_count = 1
    nc.prof_counter_names[0] = 0
    // Create minimal module with 1 prof counter entry
    var module = ir_empty_module()
    module.prof_counter_count = 1
    var pc_info = ir_empty_prof_counter_info()
    pc_info.fn_id = 0
    pc_info.counter_id = 0
    module.prof_counters[0] = pc_info
    // Emit the dump function
    let before_len = nc.code.len
    nc = emit_prof_dump_function(nc, &module)
    // Verify: code was emitted (prologue + at least one syscall + epilogue)
    if nc.code.len <= before_len { return false }
    // Verify: function ends with ret (0xC3)
    if nc.code.bytes[(nc.code.len - 1) as usize] != 0xC3 as i8 { return false }
    true
}

// Sprint 46: verify __prof_dump writes to stderr (fd=2) and records relocations
fn compiler_main_test_prof_dump_writes_stderr() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    nc.prof_counter_count = 1
    nc.prof_counter_names[0] = 0
    var module = ir_empty_module()
    module.prof_counter_count = 1
    var pc_info = ir_empty_prof_counter_info()
    pc_info.fn_id = 0
    pc_info.counter_id = 0
    module.prof_counters[0] = pc_info
    nc = emit_prof_dump_function(nc, &module)
    // Verify: relocations recorded (at least 1 .rodata name + 1 .data counter)
    if nc.relocs.count < 2 { return false }
    // Check that we have both kind_code=2 (rodata) and kind_code=3 (data) relocs
    var has_rodata = false
    var has_data = false
    var ri: i64 = 0
    while ri < nc.relocs.count {
        let r = nc.relocs.entries[ri as usize]
        if r.kind.kind_code == 2 { has_rodata = true }
        if r.kind.kind_code == 3 { has_data = true }
        ri = ri + 1
    }
    if !has_rodata { return false }
    if !has_data { return false }
    true
}

// Sprint 47: verify sprof_parse correctly parses a .sprof text buffer
fn compiler_main_test_sprof_parse() -> bool with Mut, Panic, Div {
    // Construct a buffer with "[sprof]\ntest_fn 42\n"
    var buf: [i8; 4096] = [0; 4096]
    // [sprof]\n = 91 115 112 114 111 102 93 10
    buf[0] = 91 as i8     // '['
    buf[1] = 115 as i8    // 's'
    buf[2] = 112 as i8    // 'p'
    buf[3] = 114 as i8    // 'r'
    buf[4] = 111 as i8    // 'o'
    buf[5] = 102 as i8    // 'f'
    buf[6] = 93 as i8     // ']'
    buf[7] = 10 as i8     // '\n'
    // test_fn 42\n = 116 101 115 116 95 102 110 32 52 50 10
    buf[8] = 116 as i8    // 't'
    buf[9] = 101 as i8    // 'e'
    buf[10] = 115 as i8   // 's'
    buf[11] = 116 as i8   // 't'
    buf[12] = 95 as i8    // '_'
    buf[13] = 102 as i8   // 'f'
    buf[14] = 110 as i8   // 'n'
    buf[15] = 32 as i8    // ' '
    buf[16] = 52 as i8    // '4'
    buf[17] = 50 as i8    // '2'
    buf[18] = 10 as i8    // '\n'
    let profile = sprof_parse(buf, 19)
    // Verify: 1 entry parsed
    if profile.entry_count != 1 { return false }
    // Verify: name is "test_fn" (7 chars)
    if profile.entries[0].fn_name.len != 7 { return false }
    // Verify: count is 42
    if profile.entries[0].count != 42 { return false }
    true
}

// Sprint 47: verify .sprof lookup and aggressive promotion on a hot function
fn compiler_main_test_sprof_promotion() -> bool with Mut, Panic, Div {
    var profile = sprof_empty_profile()
    var entry = sprof_empty_entry()

    var hot_name = empty_name()
    hot_name.buf[0] = 104 as i8
    hot_name.buf[1] = 111 as i8
    hot_name.buf[2] = 116 as i8
    hot_name.len = 3

    entry.fn_name = hot_name
    entry.count = 1500
    profile.entries[0] = entry
    profile.entry_count = 1

    let count = sprof_lookup(&profile, &hot_name)
    if count != 1500 { return false }

    var miss = empty_name()
    miss.buf[0] = 120 as i8   // 'x'
    miss.len = 1
    let miss_count = sprof_lookup(&profile, &miss)
    if miss_count != -1 { return false }

    var module = ir_empty_module()
    var hot_fn = ir_empty_function()
    hot_fn.name = hot_name
    hot_fn.compile_strategy = IR_STRATEGY_STANDARD
    module.functions[0] = hot_fn
    module.fn_count = 1

    sprof_apply_promotion(&! module, &profile)
    if module.functions[0].compile_strategy != IR_STRATEGY_AGGRESSIVE { return false }

    true
}

// Sprint 48: verify sprof_promotion_target thresholds
fn compiler_main_test_sprof_promotion_target_thresholds() -> bool {
    // Hot: 1500 → AGGRESSIVE (1)
    if sprof_promotion_target(1500) != IR_STRATEGY_AGGRESSIVE { return false }
    // Warm: 500 → PRECISION_PRESERVING (2)
    if sprof_promotion_target(500) != IR_STRATEGY_PRECISION_PRESERVING { return false }
    // Cold: 50 → -1 (no promotion)
    if sprof_promotion_target(50) != -1 { return false }
    // Boundary: 1000 → PRECISION (not AGGRESSIVE)
    if sprof_promotion_target(1000) != IR_STRATEGY_PRECISION_PRESERVING { return false }
    // Boundary: 100 → -1 (not PRECISION)
    if sprof_promotion_target(100) != -1 { return false }
    // Zero → -1
    if sprof_promotion_target(0) != -1 { return false }
    true
}

// Sprint 48: verify sprof_promotion_target returns -1 for negative/low counts
fn compiler_main_test_sprof_promotion_target_no_change() -> bool {
    if sprof_promotion_target(-1) != -1 { return false }
    if sprof_promotion_target(1) != -1 { return false }
    true
}

// Sprint 49: verify strategy-aware benefit boost in inline cost model
fn compiler_main_test_inline_strategy_boost() -> bool with Mut, Div, Panic {
    // Build a small leaf callee function
    var callee = ir_empty_function()
    var callee_name = empty_name()
    callee_name.buf[0] = 102 as i8  // 'f'
    callee_name.len = 1
    callee.name = callee_name
    callee.instr_count = 5
    callee.compile_strategy = 0  // STANDARD

    // Analyze with STANDARD strategy
    let info_std = inl_analyze_function(callee, 0)
    if info_std.compile_strategy != 0 { return false }

    // Analyze with AGGRESSIVE strategy
    callee.compile_strategy = 1
    let info_agg = inl_analyze_function(callee, 0)
    if info_agg.compile_strategy != 1 { return false }

    // Build context with the STANDARD callee
    var ctx_std = inl_context_new()
    ctx_std.func_infos[0] = info_std
    ctx_std.func_info_count = 1

    // Add a call site targeting callee 0
    var site = InlCallSite { caller_id: 1, callee_id: 0, call_instr_idx: 0, arg_count: 0, benefit_score: 0 }
    ctx_std.call_sites[0] = site
    ctx_std.call_site_count = 1

    let score_std = inl_compute_benefit(ctx_std, 0)

    // Build context with the AGGRESSIVE callee
    var ctx_agg = inl_context_new()
    ctx_agg.func_infos[0] = info_agg
    ctx_agg.func_info_count = 1
    ctx_agg.call_sites[0] = site
    ctx_agg.call_site_count = 1

    let score_agg = inl_compute_benefit(ctx_agg, 0)

    // AGGRESSIVE callee should have higher benefit
    if score_agg <= score_std { return false }
    // Difference should be exactly INL_STRATEGY_AGGRESSIVE_BONUS (80)
    if score_agg - score_std != 80 { return false }

    true
}

// Sprint 49: verify inl_run_pass returns valid module
fn compiler_main_test_inline_pass_returns_module() -> bool with Mut, Div, Panic {
    var module = ir_empty_module()

    // Add a small callee function
    var callee = ir_empty_function()
    var callee_name = empty_name()
    callee_name.buf[0] = 103 as i8  // 'g'
    callee_name.len = 1
    callee.name = callee_name
    callee.instrs[0] = ir_return(0)
    callee.instr_count = 1
    callee.reg_count = 1
    module.functions[0] = callee

    // Add a caller function
    var caller = ir_empty_function()
    var caller_name = empty_name()
    caller_name.buf[0] = 109 as i8  // 'm'
    caller_name.len = 1
    caller.name = caller_name
    caller.instrs[0] = ir_return(0)
    caller.instr_count = 1
    caller.reg_count = 1
    module.functions[1] = caller

    module.fn_count = 2

    let result = inl_run_pass(module)
    if result.fn_count != 2 { return false }

    true
}

// Sprint 50: verify layout_sort_by_profile reorders hot functions first
fn compiler_main_test_layout_sort_hot_first() -> bool with Mut, Div, Panic {
    var module = ir_empty_module()

    // Function 0: "alpha" (count=10, cold)
    var f0 = ir_empty_function()
    var n0 = empty_name()
    n0.buf[0] = 97 as i8   // 'a'
    n0.buf[1] = 108 as i8  // 'l'
    n0.buf[2] = 112 as i8  // 'p'
    n0.buf[3] = 104 as i8  // 'h'
    n0.buf[4] = 97 as i8   // 'a'
    n0.len = 5
    f0.name = n0
    f0.instrs[0] = ir_return(0)
    f0.instr_count = 1
    f0.reg_count = 1
    module.functions[0] = f0

    // Function 1: "beta" (count=5000, hot)
    var f1 = ir_empty_function()
    var n1 = empty_name()
    n1.buf[0] = 98 as i8   // 'b'
    n1.buf[1] = 101 as i8  // 'e'
    n1.buf[2] = 116 as i8  // 't'
    n1.buf[3] = 97 as i8   // 'a'
    n1.len = 4
    f1.name = n1
    f1.instrs[0] = ir_return(0)
    f1.instr_count = 1
    f1.reg_count = 1
    module.functions[1] = f1

    // Function 2: "gamma" (count=500, warm)
    var f2 = ir_empty_function()
    var n2 = empty_name()
    n2.buf[0] = 103 as i8  // 'g'
    n2.buf[1] = 97 as i8   // 'a'
    n2.buf[2] = 109 as i8  // 'm'
    n2.buf[3] = 109 as i8  // 'm'
    n2.buf[4] = 97 as i8   // 'a'
    n2.len = 5
    f2.name = n2
    f2.instrs[0] = ir_return(0)
    f2.instr_count = 1
    f2.reg_count = 1
    module.functions[2] = f2

    module.fn_count = 3

    // Build profile: alpha=10, beta=5000, gamma=500
    var profile = sprof_empty_profile()
    var e0 = sprof_empty_entry()
    e0.fn_name = n0
    e0.count = 10
    profile.entries[0] = e0
    var e1 = sprof_empty_entry()
    e1.fn_name = n1
    e1.count = 5000
    profile.entries[1] = e1
    var e2 = sprof_empty_entry()
    e2.fn_name = n2
    e2.count = 500
    profile.entries[2] = e2
    profile.entry_count = 3

    let result = layout_sort_by_profile(module, &profile)

    // Must be reordered
    if !result.reordered { return false }

    // Order should be: beta (5000), gamma (500), alpha (10) — descending
    if !ir_name_eq(result.module.functions[0].name, n1) { return false }
    if !ir_name_eq(result.module.functions[1].name, n2) { return false }
    if !ir_name_eq(result.module.functions[2].name, n0) { return false }

    // All 3 have positive counts → all hot
    if result.hot_count != 3 { return false }

    true
}

// Sprint 50: verify layout with empty profile preserves order
fn compiler_main_test_layout_sort_no_profile() -> bool with Mut, Div, Panic {
    var module = ir_empty_module()

    // Function 0: "xx"
    var f0 = ir_empty_function()
    var n0 = empty_name()
    n0.buf[0] = 120 as i8  // 'x'
    n0.buf[1] = 120 as i8  // 'x'
    n0.len = 2
    f0.name = n0
    f0.instrs[0] = ir_return(0)
    f0.instr_count = 1
    f0.reg_count = 1
    module.functions[0] = f0

    // Function 1: "yy"
    var f1 = ir_empty_function()
    var n1 = empty_name()
    n1.buf[0] = 121 as i8  // 'y'
    n1.buf[1] = 121 as i8  // 'y'
    n1.len = 2
    f1.name = n1
    f1.instrs[0] = ir_return(0)
    f1.instr_count = 1
    f1.reg_count = 1
    module.functions[1] = f1

    module.fn_count = 2

    // Empty profile — no counts for either function
    let profile = sprof_empty_profile()

    let result = layout_sort_by_profile(module, &profile)

    // Should NOT be reordered (both have count -1, stable sort preserves order)
    if result.reordered { return false }

    // Names should be unchanged
    if !ir_name_eq(result.module.functions[0].name, n0) { return false }
    if !ir_name_eq(result.module.functions[1].name, n1) { return false }

    true
}

// Sprint 51: verify the cleanup const-fold step folds a constant binop
fn compiler_main_test_cp_folds_constant() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 3)                      // r0 = 3
    instrs[1] = ir_load_imm(1, 4)                      // r1 = 4
    instrs[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)    // r2 = r0 + r1 = 7
    instrs[3] = ir_return(2)
    var func = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    cp_check_load_imm(&result, 2, 7)
}

// Sprint 51: verify DCE removes a dead instruction
fn compiler_main_test_dce_removes_dead() -> bool with Mut, Div, Panic {
    var instrs = dce_empty_instrs()
    instrs[0] = ir_load_imm(0, 42)   // r0 = 42 (used by return)
    instrs[1] = ir_load_imm(1, 99)   // r1 = 99 (dead, never used)
    instrs[2] = ir_return(0)
    var func = dce_make_test_func(instrs, 3)
    let result = dce_optimize_function(func)
    dce_check_nop(&result, 1)
}

// Sprint 52: verify regalloc assigns a preg when register pressure is low (1 vreg, 1 preg)
fn compiler_main_test_regalloc_assigns_preg() -> bool with Mut, Div, Panic {
    // Build: r0 = 3, r1 = r0 + 4, return r1
    var ra_instrs: [RaSimpleInstr; 512] = [ra_empty_simple_instr(); 512]
    ra_instrs[0 as usize] = ra_simple_instr(0, -1, -1)   // r0 = imm (def r0)
    ra_instrs[1 as usize] = ra_simple_instr(1, 0, -1)    // r1 = r0 + imm (def r1, use r0)
    ra_instrs[2 as usize] = ra_simple_instr(-1, 1, -1)   // return r1 (use r1)
    var state = liveness_compute_intervals(ra_instrs, 3)
    state = regalloc_linear_scan(state, 1)
    // r0 and r1 don't overlap fully — at least one should get preg 0
    let a0 = regalloc_get_assignment(state, 0)
    let a1 = regalloc_get_assignment(state, 1)
    // At least one should be assigned (not spilled)
    if a0 < 0 && a1 < 0 { return false }
    // The allocator should not report any conflicts
    regalloc_verify_no_conflicts(state)
}

// Sprint 52: verify regalloc spills when pressure exceeds available registers
fn compiler_main_test_regalloc_spills_under_pressure() -> bool with Mut, Div, Panic {
    // Build: 6 live intervals all overlapping (start 0, end 10), only 1 preg
    var ra_instrs: [RaSimpleInstr; 512] = [ra_empty_simple_instr(); 512]
    var i = 0
    while i < 6 {
        ra_instrs[i as usize] = ra_simple_instr(i, -1, -1)
        i = i + 1
    }
    // Add uses so intervals extend to pos 10
    var j = 6
    while j < 12 {
        let vreg = j - 6
        ra_instrs[j as usize] = ra_simple_instr(-1, vreg, -1)
        j = j + 1
    }
    var state = liveness_compute_intervals(ra_instrs, 12)
    state = regalloc_linear_scan(state, 1)
    // With 6 overlapping vregs and 1 preg, at least 5 must be spilled
    let spilled = regalloc_count_spilled(state)
    if spilled < 5 { return false }
    // vreg_spill_slots should be valid for spilled vregs
    var v = 0
    while v < 6 {
        if regalloc_is_spilled(state, v) {
            let slot = regalloc_get_spill_slot(state, v)
            if slot < 0 { return false }
        }
        v = v + 1
    }
    true
}

