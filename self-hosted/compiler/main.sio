}

// Self-test dispatcher part 8/10: split out of run_compiler_main_self_tests
// because the monolithic body lowered to 33829 IR instructions, past IR_MAX_INSTRS.
// Each part stays far under the IR cap and under the DCE/const-prop 8192 caps,
// so every analysis pass remains complete on every part (no refusal, no truncation).
fn compiler_main_self_tests_part_08(passed_in: i64) -> i64 with IO, Mut, Panic, Div, Alloc {
    var passed = passed_in
    if compiler_main_test_cz_no_fold_rr_and() {
        passed = passed + 1
        println("  T810 OK: Sprint 190 Block CZ: r0^(r0&r1) no fold rr-and")
    } else { println("  FAIL: T810") }
    if compiler_main_test_cz_no_fold_or() {
        passed = passed + 1
        println("  T811 OK: Sprint 190 Block CZ: r0|(r0&7) no fold by CZ")
    } else { println("  FAIL: T811") }

    // Sprint 191 Block DA: OR-AND XOR identity (T812-T817)
    if compiler_main_test_da_or_and_xor_basic() {
        passed = passed + 1
        println("  T812 OK: Sprint 191 Block DA: (r0|r1)^(r0&r1) -> r0^r1")
    } else { println("  FAIL: T812") }
    if compiler_main_test_da_or_and_xor_comm() {
        passed = passed + 1
        println("  T813 OK: Sprint 191 Block DA: (r0&r1)^(r0|r1) -> r0^r1 commutative")
    } else { println("  FAIL: T813") }
    if compiler_main_test_da_or_and_xor_swapped() {
        passed = passed + 1
        println("  T814 OK: Sprint 191 Block DA: (r1|r0)^(r0&r1) -> swapped operands")
    } else { println("  FAIL: T814") }
    if compiler_main_test_da_no_fold_diff_ops() {
        passed = passed + 1
        println("  T815 OK: Sprint 191 Block DA: (r0|r1)^(r0|r1) not DA fold")
    } else { println("  FAIL: T815") }
    if compiler_main_test_da_no_fold_diff_base_or() {
        passed = passed + 1
        println("  T816 OK: Sprint 191 Block DA: (r0|r2)^(r0&r1) no fold diff base")
    } else { println("  FAIL: T816") }
    if compiler_main_test_da_no_fold_and_outer() {
        passed = passed + 1
        println("  T817 OK: Sprint 191 Block DA: (r0|r1)&(r0&r1) no fold by DA")
    } else { println("  FAIL: T817") }

    // Sprint 192 Block DB: XOR-AND to OR (T818-T823)
    if compiler_main_test_db_xor_and_or_basic() {
        passed = passed + 1
        println("  T818 OK: Sprint 192 Block DB: (r0^r1)|(r0&r1) -> r0|r1")
    } else { println("  FAIL: T818") }
    if compiler_main_test_db_xor_and_or_comm() {
        passed = passed + 1
        println("  T819 OK: Sprint 192 Block DB: (r0&r1)|(r0^r1) -> r0|r1 commutative")
    } else { println("  FAIL: T819") }
    if compiler_main_test_db_xor_and_or_val() {
        passed = passed + 1
        println("  T820 OK: Sprint 192 Block DB: (r0^r1)|(r0&r1) val check")
    } else { println("  FAIL: T820") }
    if compiler_main_test_db_no_fold_diff_base_xor() {
        passed = passed + 1
        println("  T821 OK: Sprint 192 Block DB: (r0^r2)|(r0&r1) no fold diff base")
    } else { println("  FAIL: T821") }
    if compiler_main_test_db_no_fold_rr_or() {
        passed = passed + 1
        println("  T822 OK: Sprint 192 Block DB: (r0|r1)|(r0&r1) no fold rr-or")
    } else { println("  FAIL: T822") }
    if compiler_main_test_db_no_fold_xor_outer() {
        passed = passed + 1
        println("  T823 OK: Sprint 192 Block DB: (r0^r1)^(r0&r1) no fold xor outer")
    } else { println("  FAIL: T823") }

    // Sprint 193 Block DC: AND-XOR to OR (T824-T829)
    if compiler_main_test_dc_and_xor_or_basic() {
        passed = passed + 1
        println("  T824 OK: Sprint 193 Block DC: (r0&r1)|(r0^r1) -> r0|r1")
    } else { println("  FAIL: T824") }
    if compiler_main_test_dc_and_xor_or_comm() {
        passed = passed + 1
        println("  T825 OK: Sprint 193 Block DC: (r0^r1)|(r0&r1) -> r0|r1 commutative")
    } else { println("  FAIL: T825") }
    if compiler_main_test_dc_and_xor_or_swapped() {
        passed = passed + 1
        println("  T826 OK: Sprint 193 Block DC: (r1&r0)|(r0^r1) -> r1|r0")
    } else { println("  FAIL: T826") }
    if compiler_main_test_dc_no_fold_diff_base() {
        passed = passed + 1
        println("  T827 OK: Sprint 193 Block DC: (r0&r2)|(r0^r1) no fold")
    } else { println("  FAIL: T827") }
    if compiler_main_test_dc_no_fold_xor_outer() {
        passed = passed + 1
        println("  T828 OK: Sprint 193 Block DC: (r0&r1)^(r0^r1) no fold XOR outer")
    } else { println("  FAIL: T828") }
    if compiler_main_test_dc_no_fold_and_outer() {
        passed = passed + 1
        println("  T829 OK: Sprint 193 Block DC: (r0&r1)&(r0^r1) no fold AND outer")
    } else { println("  FAIL: T829") }

    // Sprint 194 Block DD: OR-NOT-AND to XOR (T830-T835)
    if compiler_main_test_dd_or_not_and_xor_basic() {
        passed = passed + 1
        println("  T830 OK: Sprint 194 Block DD: (r0|r1)&~(r0&r1) -> r0^r1")
    } else { println("  FAIL: T830") }
    if compiler_main_test_dd_or_not_and_xor_comm() {
        passed = passed + 1
        println("  T831 OK: Sprint 194 Block DD: ~(r0&r1)&(r0|r1) -> r0^r1 comm")
    } else { println("  FAIL: T831") }
    if compiler_main_test_dd_or_not_and_xor_val() {
        passed = passed + 1
        println("  T832 OK: Sprint 194 Block DD: val check (6|3)&~(6&3)=6^3")
    } else { println("  FAIL: T832") }
    if compiler_main_test_dd_no_fold_diff_base_or() {
        passed = passed + 1
        println("  T833 OK: Sprint 194 Block DD: (r0|r2)&~(r0&r1) no fold diff base")
    } else { println("  FAIL: T833") }
    if compiler_main_test_dd_no_fold_not_not_and() {
        passed = passed + 1
        println("  T834 OK: Sprint 194 Block DD: (r0|r1)&~(r0|r1) no fold not-AND")
    } else { println("  FAIL: T834") }
    if compiler_main_test_dd_no_fold_or_outer() {
        passed = passed + 1
        println("  T835 OK: Sprint 194 Block DD: (r0|r1)|~(r0&r1) no fold OR outer")
    } else { println("  FAIL: T835") }

    // Sprint 195 Block DE: XOR self-complement (T836-T841)
    if compiler_main_test_de_xor_self_comp_basic() {
        passed = passed + 1
        println("  T836 OK: Sprint 195 Block DE: r0^~r0 -> -1")
