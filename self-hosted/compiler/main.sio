// ============================================================================
// Sprint 73: CSE + EgSmall self-tests (T131–T145)
// ============================================================================

// T131: CSE identifies duplicate IrBinOp and rewrites second to IrCopy.
fn compiler_main_test_cse_basic() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)   // r2 = r0 + r1
    instrs[1] = ir_binop(3, 0, BinaryOp::OpAdd, 1)   // r3 = r0 + r1  (dup)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_cse(func)
    // Second binop should become IrCopy(3, 2)
    result.instrs[1].op == IrOpcode::IrCopy
        && result.instrs[1].dst  == 3
        && result.instrs[1].src1 == 2
}

// T132: CSE does not fire when src2 differs between two adds.
fn compiler_main_test_cse_no_false_positive() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)   // r2 = r0 + r1
    instrs[1] = ir_binop(3, 0, BinaryOp::OpAdd, 2)   // r3 = r0 + r2 (different src2)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_cse(func)
    result.instrs[1].op == IrOpcode::IrBinOp          // still a binop — no CSE
}

// T133: CSE does not fire when opcodes differ (OpAdd vs OpMul).
fn compiler_main_test_cse_op_distinct() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)   // r2 = r0 + r1
    instrs[1] = ir_binop(3, 0, BinaryOp::OpMul, 1)   // r3 = r0 * r1
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_cse(func)
    result.instrs[1].op == IrOpcode::IrBinOp           // different op: no CSE
}

// T134: CSE on three identical binops: second and third become copies of first.
fn compiler_main_test_cse_triple() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)   // r2 = r0 + r1
    instrs[1] = ir_binop(3, 0, BinaryOp::OpAdd, 1)   // r3 = r0 + r1 (dup)
    instrs[2] = ir_binop(4, 0, BinaryOp::OpAdd, 1)   // r4 = r0 + r1 (dup)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_cse(func)
    result.instrs[1].op == IrOpcode::IrCopy && result.instrs[1].src1 == 2
        && result.instrs[2].op == IrOpcode::IrCopy && result.instrs[2].src1 == 2
}

// T135: CSE does not CSE unmapped ops (OpBitAnd → EG_OP_CONST sentinel guard).
fn compiler_main_test_cse_unmapped_op() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpBitAnd, 1)  // r2 = r0 & r1
    instrs[1] = ir_binop(3, 0, BinaryOp::OpBitAnd, 1)  // r3 = r0 & r1 (same, but AND is unmapped)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_cse(func)
    result.instrs[1].op == IrOpcode::IrBinOp             // AND not CSE'd
}

// T136: eg_small_init returns a zeroed-out context.
fn compiler_main_test_eg_small_init() -> bool {
    let ctx = eg_small_init()
    ctx.node_count == 0 && ctx.uf_size == 0
}

fn compiler_eg_small_add_const(ctx: EgSmallContext, value: i64) -> (EgSmallContext, i64) with Mut, Div, Panic {
    var next = ctx
    let id = eg_small_add_const(&! next, value)
    (next, id)
}

fn compiler_eg_small_add_var(ctx: EgSmallContext, var_id: i64) -> (EgSmallContext, i64) with Mut, Div, Panic {
    var next = ctx
    let id = eg_small_add_var(&! next, var_id)
    (next, id)
}

fn compiler_eg_small_add_binop(ctx: EgSmallContext, op: i64, lhs: i64, rhs: i64) -> (EgSmallContext, i64) with Mut, Div, Panic {
    var next = ctx
    let id = eg_small_add_binop(&! next, op, lhs, rhs)
    (next, id)
}

fn compiler_eg_small_find(ctx: EgSmallContext, id: i64) -> (EgSmallContext, i64) with Mut, Div, Panic {
    var next = ctx
    let root = eg_small_find(&! next, id)
    (next, root)
}

fn compiler_eg_small_union(ctx: EgSmallContext, id0: i64, id1: i64) -> EgSmallContext with Mut, Div, Panic {
    var next = ctx
    let _ = eg_small_union(&! next, id0, id1)
    next
}

fn compiler_eg_small_saturate(ctx: EgSmallContext) -> EgSmallContext with Mut, Div, Panic {
    var next = ctx
    let _ = eg_small_saturate(&! next)
    next
}

fn compiler_eg_small_extract(ctx: EgSmallContext, root: i64) -> (EgSmallContext, EgNode) with Mut, Div, Panic {
    var next = ctx
    let extracted = eg_small_extract(&! next, root)
    (next, extracted)
}

// T137: eg_small_add_const adds one node; returns class_id 0.
fn compiler_main_test_eg_small_add_node() -> bool with Mut, Div, Panic {
    let pair = compiler_eg_small_add_const(eg_small_init(), 42)
    pair.0.node_count == 1 && pair.1 == 0
}

// T138: Adding the same constant node twice returns the same class_id (dedup).
fn compiler_main_test_eg_small_dedup() -> bool with Mut, Div, Panic {
    let pair1 = compiler_eg_small_add_const(eg_small_init(), 99)
    let pair2 = compiler_eg_small_add_const(pair1.0, 99)
    pair1.1 == pair2.1 && pair2.0.node_count == 1
}

// T139: eg_small_find returns self for a freshly allocated class.
fn compiler_main_test_eg_small_find_self() -> bool with Mut, Div, Panic {
    let pair1 = compiler_eg_small_add_const(eg_small_init(), 0)
    let pair2 = compiler_eg_small_find(pair1.0, pair1.1)
    pair2.1 == pair1.1
}

// T140: eg_small_union merges two classes; find gives same canonical for both.
fn compiler_main_test_eg_small_union() -> bool with Mut, Div, Panic {
    let pair0 = compiler_eg_small_add_const(eg_small_init(), 10)
    let pair1 = compiler_eg_small_add_const(pair0.0, 20)
    let ctx2 = compiler_eg_small_union(pair1.0, pair0.1, pair1.1)
    let pair2 = compiler_eg_small_find(ctx2, pair0.1)
    let pair3 = compiler_eg_small_find(pair2.0, pair1.1)
    pair2.1 == pair3.1
}

// T141: eg_small_saturate on add(x, 0): extraction gives EG_OP_VAR.
fn compiler_main_test_eg_small_sat_add_identity() -> bool with Mut, Div, Panic {
    let pair0 = compiler_eg_small_add_const(eg_small_init(), 0)
    let pair1 = compiler_eg_small_add_var(pair0.0, 1)
    let pair2 = compiler_eg_small_add_binop(pair1.0, EG_OP_ADD, pair1.1, pair0.1)
    let ctx3 = compiler_eg_small_saturate(pair2.0)
    let pair3 = compiler_eg_small_extract(ctx3, pair2.1)
    pair3.1.op == EG_OP_VAR
}

// T142: eg_small_saturate on mul(x, 1): extraction gives EG_OP_VAR.
fn compiler_main_test_eg_small_sat_mul_identity() -> bool with Mut, Div, Panic {
    let pair0 = compiler_eg_small_add_const(eg_small_init(), 1)
    let pair1 = compiler_eg_small_add_var(pair0.0, 2)
    let pair2 = compiler_eg_small_add_binop(pair1.0, EG_OP_MUL, pair1.1, pair0.1)
    let ctx3 = compiler_eg_small_saturate(pair2.0)
    let pair3 = compiler_eg_small_extract(ctx3, pair2.1)
    pair3.1.op == EG_OP_VAR
}

// T143: eg_small_saturate on sub(x, x): extraction gives EG_OP_CONST with value 0.
fn compiler_main_test_eg_small_sat_sub_self() -> bool with Mut, Div, Panic {
    let pair0 = compiler_eg_small_add_var(eg_small_init(), 3)
    let pair1 = compiler_eg_small_add_binop(pair0.0, EG_OP_SUB, pair0.1, pair0.1)
    let ctx2 = compiler_eg_small_saturate(pair1.0)
    let pair2 = compiler_eg_small_extract(ctx2, pair1.1)
    pair2.1.op == EG_OP_CONST && pair2.1.value == 0
}

// T144: ocp_egraph_mini_pass skips when instr_count > 4 (returns func unchanged).
fn compiler_main_test_ocp_mini_pass_skip() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs[1] = ir_binop(3, 2, BinaryOp::OpMul, 0)
    instrs[2] = ir_binop(4, 3, BinaryOp::OpSub, 1)
    instrs[3] = ir_binop(5, 4, BinaryOp::OpDiv, 0)
    instrs[4] = ir_binop(6, 5, BinaryOp::OpAdd, 2)
    let func   = cp_make_test_func(instrs, 5)   // instr_count=5 > 4
    let result = ocp_egraph_mini_pass(func)
    // Guard fires: result identical to input (first binop still a binop)
    result.instrs[0].op == IrOpcode::IrBinOp && result.instr_count == 5
}

// T145: ocp_cse + DCE combined: 4-instr function with one duplicate.
//       After opt_cleanup, the duplicate binop is CSE'd → IrCopy → DCE'd.
fn compiler_main_test_ocp_cse_and_dce() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)   // r2 = r0 + r1
    instrs[1] = ir_binop(3, 0, BinaryOp::OpAdd, 1)   // r3 = r0 + r1 (dup → CSE → copy)
    instrs[2] = ir_return(3)                           // use r3
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_cse(func)
    // After CSE: instrs[1] is IrCopy(3, 2); r2 is now used by copy
    result.instrs[1].op == IrOpcode::IrCopy
}

