// Sprint 48: --show-profile probe — inspect .sprof file and show promotion decisions
fn run_probe_show_profile(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div {
    if flag_index + 1 >= args.len {
        panic("show-profile: missing .sprof file argument")
    }
    let sprof_path = arg_list_get(args, flag_index + 1)
    let prof_size = file_size(sprof_path)
    if prof_size <= 0 {
        println("[sprof] error: file not found or empty: " + sprof_path)
        return
    }
    let prof_bytes = read_file(sprof_path)
    var prof_buf: [i8; 4096] = [0; 4096]
    var pi: i64 = 0
    while pi < prof_size && pi < 4096 {
        prof_buf[pi as usize] = prof_bytes[pi as usize]
        pi = pi + 1
    }
    let profile = sprof_parse(prof_buf, prof_size)
    println("[sprof] profile: " + sprof_path + " (" + int_to_string(profile.entry_count) + " entries)")
    var ei: i64 = 0
    while ei < profile.entry_count {
        let entry = profile.entries[ei as usize]
        let target = sprof_promotion_target(entry.count)
        print("[sprof] ")
        compiler_manifest_print_name(entry.fn_name)
        print(": count " + int_to_string(entry.count) + " -> ")
        if target >= 0 {
            println("strategy " + ir_strategy_name(target))
        } else {
            println("no promotion")
        }
        ei = ei + 1
    }
}

fn char_from_i64(n: i64) -> string with Mut, Panic {
    if n < 0 || n > 9 {
        panic(char_from_i64_error(n))
    }
    str_slice("0123456789", n, n + 1)
}

fn i64_to_string_decimal(n: i64) -> string with Mut, Panic, Div {
    if n == -9223372036854775807 - 1 { return "-9223372036854775808" }
    if n == 9223372036854775807 { return "9223372036854775807" }
    var out: [i8; 24] = [0; 24]
    if n == 0 {
        out[0] = 48 as i8
        return str_from_bytes(out, 1)
    }

    var value = n
    var digits: i64 = 1
    while value <= -10 || value >= 10 {
        digits = digits + 1
        value = value / 10
    }

    let negative = n < 0
    let total_len = if negative { digits + 1 } else { digits }

    var write = total_len - 1
    value = n
    while value <= -10 || value >= 10 {
        var digit = value % 10
        if digit < 0 {
            digit = 0 - digit
        }
        out[write as usize] = (48 + digit) as i8
        write = write - 1
        value = value / 10
    }

    var final_digit = value
    if final_digit < 0 {
        final_digit = 0 - final_digit
    }
    out[write as usize] = (48 + final_digit) as i8

    if negative {
        out[0] = 45 as i8
    }

    str_from_bytes(out, total_len)
}

pub(crate) fn int_to_string(n: i64) -> string with Mut, Panic, Div {
    i64_to_string_decimal(n)
}

// ============================================================================
// COMPILE ERROR LIST  (replaces Vec<string> in CompileResult)
// ============================================================================

struct CompileErrors {
    items: [string; 64],
    len: i64,
}

fn compile_errors_new() -> CompileErrors {
    CompileErrors {
        items: [""; 64],
        len: 0,
    }
}

fn compile_errors_push(errs: CompileErrors, s: string) -> CompileErrors with Mut {
    var out = errs
    if out.len < 64 {
        out.items[out.len as usize] = s
        out.len = out.len + 1
    }
    out
}

fn compile_errors_get(errs: CompileErrors, i: i64) -> string {
    errs.items[i as usize]
}

fn compile_trim_line(line: string) -> string with Mut, Panic, Div {
    let line_len = str_len(line)
    if line_len > 0 && str_char_at(line, line_len - 1) == 13 {
        str_slice(line, 0, line_len - 1)
    } else {
        line
    }
}

fn compile_errors_push_lines(errs: CompileErrors, prefix: string, text: string) -> CompileErrors with Mut, Panic, Div {
    var out = errs
    let n = str_len(text)
    if n <= 0 {
        return out
    }

    var start: i64 = 0
    var i: i64 = 0
    while i < n {
        if str_char_at(text, i) == 10 {
            if i > start {
                let raw_line = str_slice(text, start, i)
                let line = compile_trim_line(raw_line)
                if str_len(line) > 0 {
                    out = compile_errors_push(out, prefix + line)
                }
            }
            start = i + 1
        }
        i = i + 1
    }

    if start < n {
        let raw_line = str_slice(text, start, n)
        let line = compile_trim_line(raw_line)
        if str_len(line) > 0 {
            out = compile_errors_push(out, prefix + line)
        }
    }

    out
}

fn compile_push_ir_failure(errs: CompileErrors, reason: string) -> CompileErrors with Mut, Panic, Div {
    var out = errs
    if str_eq(reason, "module_resolution_failed") {
        out = compile_errors_push(out, "error: module resolution failed")
    } else if str_eq(reason, "type_check_failed") {
        out = compile_errors_push(out, "error: type checking failed")
    } else if str_eq(reason, "ir_lowering_failed") {
        out = compile_errors_push(out, "error: IR lowering failed")
    } else {
        out = compile_errors_push(out, "error: " + reason)
    }

    let parse_errors = parser_last_error_count()
    if parse_errors > 0 {
        out = compile_errors_push(out, "error: parser reported " + int_to_string(parse_errors) + " syntax errors")
    }
    out
}

fn compile_byte_is_whitespace(ch: i8) -> bool {
    ch == (32 as i8) || ch == (9 as i8) || ch == (13 as i8) || ch == (10 as i8)
}

fn compile_byte_is_rhs_terminator(ch: i8) -> bool {
    ch == (125 as i8) || ch == (41 as i8) || ch == (93 as i8) || ch == (59 as i8) || ch == (44 as i8)
}

fn compile_scan_incomplete_assignment(path: string) -> (i64, i64) with IO, Mut, Panic, Div {
    let size = file_size(path)
    if size <= 0 {
        return (-1, 0)
    }
    let bytes = read_file(path)

    var i: i64 = 0
    var line: i64 = 1
    var col: i64 = 1
    while i < size {
        let ch = bytes[i as usize]
        // Comments and literals are skipped, because this scan is over RAW BYTES and an '=' inside
        // one is not an assignment. Without this it rejected any file whose last non-whitespace
        // byte is '=' — which the `// ====...` banner at end of file makes common: 5 versioned
        // .sio files, among them self-hosted/hlir/lower.sio, a module compiler/main.sio imports.
        // The module then contributed nothing to the symbol table and its exports surfaced as
        // E137 "use of undeclared variable" at every call site, blamed on the caller.
        if ch == (47 as i8) && i + 1 < size && bytes[(i + 1) as usize] == (47 as i8) {
            while i < size && bytes[i as usize] != (10 as i8) {
                i = i + 1
                col = col + 1
            }
            continue
        }
        if ch == (47 as i8) && i + 1 < size && bytes[(i + 1) as usize] == (42 as i8) {
            i = i + 2
            col = col + 2
            var closed = false
            while i < size && !closed {
                if bytes[i as usize] == (42 as i8) && i + 1 < size && bytes[(i + 1) as usize] == (47 as i8) {
                    i = i + 2
                    col = col + 2
                    closed = true
                } else {
                    if bytes[i as usize] == (10 as i8) {
                        line = line + 1
                        col = 1
                    } else {
                        col = col + 1
                    }
                    i = i + 1
                }
            }
            continue
        }
        if ch == (34 as i8) {
            i = i + 1
            col = col + 1
            var done = false
            while i < size && !done {
                let q = bytes[i as usize]
                if q == (92 as i8) {
                    i = i + 2
                    col = col + 2
                } else {
                    if q == (34 as i8) {
                        done = true
                    }
                    if q == (10 as i8) {
                        line = line + 1
                        col = 1
                    } else {
                        col = col + 1
                    }
                    i = i + 1
                }
            }
            continue
        }
        // A quote is a char literal ONLY in the shapes 'x' and '\x'. An apostrophe also opens a
        // LIFETIME in this language (`&'static str`, `most_uncertain<'a>` — both live in stdlib),
        // and skipping from there to the next apostrophe would swallow real code.
        if ch == (39 as i8) {
            var char_lit_len: i64 = 0
            if i + 2 < size && bytes[(i + 1) as usize] != (92 as i8) && bytes[(i + 2) as usize] == (39 as i8) {
                char_lit_len = 3
            }
            if i + 3 < size && bytes[(i + 1) as usize] == (92 as i8) && bytes[(i + 3) as usize] == (39 as i8) {
                char_lit_len = 4
            }
            if char_lit_len > 0 {
                i = i + char_lit_len
                col = col + char_lit_len
                continue
            }
        }
        if ch == (61 as i8) { // '='
            var j = i + 1
            while j < size {
                let next = bytes[j as usize]
                if compile_byte_is_whitespace(next) {
                    j = j + 1
                    continue
                }
                if compile_byte_is_rhs_terminator(next) {
                    return (line, col)
                }
                break
            }
            if j >= size {
                return (line, col)
            }
        }
        if ch == (10 as i8) {
            line = line + 1
            col = 1
        } else {
            col = col + 1
        }
        i = i + 1
    }
    (-1, 0)
}



fn compile_format_error_at(path: string, line: i64, col: i64, msg: string) -> string with Mut, Panic, Div {
    "error: at " + path + ":" + int_to_string(line) + ":" + int_to_string(col) + " - " + msg
}

