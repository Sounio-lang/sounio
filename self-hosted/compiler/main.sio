    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (3))) as usize] as IrOpcode) == IrOpcode::IrUnaryOp
        && (IR_A_UN_OP[(ir_region_slot_r(opt.region, (3))) as usize] as UnaryOp) == UnaryOp::OpNot
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (3))) as usize] == 0
}
