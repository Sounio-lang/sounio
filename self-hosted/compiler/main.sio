fn run_native_v2_emit_streqnocall(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 1 >= args.len { panic("usage <out_path>") }
    let out_path = arg_list_get(args, flag_index + 1)
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let module = compiler_main_make_native_v2_streqnocall_module()
    let rc = compile_native_v2_preview_to_file(&module, spec, out_path)
    if rc != 0 { print("native_v2_emit_exit_code: FAIL label=streqnocall rc="); print_int(rc as i64); print("\n"); return }
    print("native_v2_emit_exit_code: emitted label=streqnocall path="); print(out_path); print("\n")
}

fn run_native_v2_emit_streq1(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 1 >= args.len { panic("usage --native-v2-emit-streq1 <out_path>") }
    let out_path = arg_list_get(args, flag_index + 1)
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let module = compiler_main_make_native_v2_streq1_module()
    let rc = compile_native_v2_preview_to_file(&module, spec, out_path)
    if rc != 0 { print("native_v2_emit_exit_code: FAIL label=streq1 rc="); print_int(rc as i64); print("\n"); return }
    print("native_v2_emit_exit_code: emitted label=streq1 path="); print(out_path); print("\n")
}

// 5-arg call witness: --native-v2-emit-call5 <out_path>. add5(1,2,4,8,16)=31 -> exit 31.
// Proves args 0..4 (rdi/rsi/rdx/rcx/r8) are marshalled correctly.
fn run_native_v2_emit_call5(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 1 >= args.len {
        panic("native-v2-emit-call5: usage --native-v2-emit-call5 <out_path>")
    }
    let out_path = arg_list_get(args, flag_index + 1)
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let module = compiler_main_make_native_v2_call5_module()
    let rc = compile_native_v2_preview_to_file(&module, spec, out_path)
    if rc != 0 {
        print("native_v2_emit_exit_code: FAIL to_file label=call5 rc=")
        print_int(rc as i64)
        print("\n")
        return
    }
    print("native_v2_emit_exit_code: emitted label=call5 path=")
    print(out_path)
    print("\n")
}

// 6-arg call witness: --native-v2-emit-call6 <out_path>. add6(1,2,4,8,16,32)=63 -> exit 63.
// Proves args 0..5 (rdi/rsi/rdx/rcx/r8/r9) are marshalled correctly.
fn run_native_v2_emit_call6(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 1 >= args.len {
        panic("native-v2-emit-call6: usage --native-v2-emit-call6 <out_path>")
    }
    let out_path = arg_list_get(args, flag_index + 1)
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let module = compiler_main_make_native_v2_call6_module()
    let rc = compile_native_v2_preview_to_file(&module, spec, out_path)
    if rc != 0 {
        print("native_v2_emit_exit_code: FAIL to_file label=call6 rc=")
        print_int(rc as i64)
        print("\n")
        return
    }
    print("native_v2_emit_exit_code: emitted label=call6 path=")
    print(out_path)
    print("\n")
}

// Control fall-through witness: --native-v2-emit-control-ft <out_path>. cond=0 -> exit 7.
// Proves branch_true does NOT jump when the condition is false (branch-not-taken path).
fn run_native_v2_emit_control_ft(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 1 >= args.len {
        panic("native-v2-emit-control-ft: usage --native-v2-emit-control-ft <out_path>")
    }
    let out_path = arg_list_get(args, flag_index + 1)
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let module = compiler_main_make_native_v2_control_fallthrough_module()
    let rc = compile_native_v2_preview_to_file(&module, spec, out_path)
    if rc != 0 {
        print("native_v2_emit_exit_code: FAIL to_file label=control-ft rc=")
        print_int(rc as i64)
        print("\n")
        return
    }
    print("native_v2_emit_exit_code: emitted label=control-ft path=")
    print(out_path)
    print("\n")
}

