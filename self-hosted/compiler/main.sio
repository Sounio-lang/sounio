    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 0)                          // r1 = 0 (shift amount)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpShr, 1)        // r2 = r0 >> r1 (r0 unknown, r1=0)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrCopy && result.instrs[1].src1 == 0
}

// T177: 0 << n → IrLoadImm(0) — zero-shift annihilator (OpShl, left-const=0).
fn compiler_main_test_zero_shl_n() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 0)                          // r0 = 0 (value to shift)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpShl, 1)        // r2 = r0 << r1 (r0=0, r1 unknown)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrLoadImm && result.instrs[1].imm_i64 == 0
}

// T178: 0 >> n → IrLoadImm(0) — zero-shift annihilator (OpShr, left-const=0).
fn compiler_main_test_zero_shr_n() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 0)                          // r0 = 0 (value to shift)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpShr, 1)        // r2 = r0 >> r1 (r0=0, r1 unknown)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrLoadImm && result.instrs[1].imm_i64 == 0
}

// T179: r1 << r2 (both unknown) → stays IrBinOp (no fold).
fn compiler_main_test_shift_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpShl, 1)        // r2 = r0 << r1 (both unknown)
    let func   = cp_make_test_func(instrs, 1)
    let result = ocp_const_fold(func)
    result.instrs[0].op == IrOpcode::IrBinOp
}

// T180: Block E → Block G chain: (5 < 3) → IrLoadImm(0) (Block E), then 0 << r4 → IrLoadImm(0) (Block G).
fn compiler_main_test_shift_chain_e_g() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 5)
    instrs[1] = ir_load_imm(1, 3)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpLt, 1)         // r2 = (5 < 3) → Block E: IrLoadImm(0)
    instrs[3] = ir_binop(3, 2, BinaryOp::OpShl, 4)        // r3 = r2 << r4 → Block G: IrLoadImm(0)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    result.instrs[3].op == IrOpcode::IrLoadImm && result.instrs[3].imm_i64 == 0
}

// ============================================================================
// Sprint 77: Commutative CSE canonicalization Block H self-tests (T181–T186)
// ============================================================================

// T181: r0+r1 then r1+r0 → IrCopy (OpAdd commutative CSE hit after Block H).
fn compiler_main_test_cse_commut_add() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)   // r2 = r0 + r1 (stored as (ADD,0,1))
    instrs[1] = ir_binop(3, 1, BinaryOp::OpAdd, 0)   // r3 = r1 + r0 (canonical: (ADD,0,1)) → hit
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_cse(func)
    result.instrs[1].op == IrOpcode::IrCopy && result.instrs[1].src1 == 2
}

// T182: r3*r5 then r5*r3 → IrCopy (OpMul commutative CSE hit).
fn compiler_main_test_cse_commut_mul() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 3, BinaryOp::OpMul, 5)   // r2 = r3 * r5 (stored as (MUL,3,5))
    instrs[1] = ir_binop(4, 5, BinaryOp::OpMul, 3)   // r4 = r5 * r3 (canonical: (MUL,3,5)) → hit
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_cse(func)
    result.instrs[1].op == IrOpcode::IrCopy && result.instrs[1].src1 == 2
}

// T183: r0|r1 then r1|r0 → IrCopy (OpOr commutative CSE hit).
fn compiler_main_test_cse_commut_or() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpOr, 1)    // r2 = r0 | r1
    instrs[1] = ir_binop(3, 1, BinaryOp::OpOr, 0)    // r3 = r1 | r0 → hit
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_cse(func)
    result.instrs[1].op == IrOpcode::IrCopy && result.instrs[1].src1 == 2
}

// T184: r0-r1 then r1-r0 → NOT IrCopy (OpSub is non-commutative, no CSE hit).
fn compiler_main_test_cse_noncommut_sub() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpSub, 1)   // r2 = r0 - r1
    instrs[1] = ir_binop(3, 1, BinaryOp::OpSub, 0)   // r3 = r1 - r0 (different op, no hit)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_cse(func)
    result.instrs[1].op == IrOpcode::IrBinOp
}

// T185: r0+r1 twice in same order → IrCopy (existing exact-match CSE still works, regression).
fn compiler_main_test_cse_same_order_regress() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)   // r2 = r0 + r1
    instrs[1] = ir_binop(3, 0, BinaryOp::OpAdd, 1)   // r3 = r0 + r1 (same order) → hit
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_cse(func)
    result.instrs[1].op == IrOpcode::IrCopy && result.instrs[1].src1 == 2
}

// T186: r2&r4 then r4&r2 → IrCopy (OpAnd commutative CSE hit).
fn compiler_main_test_cse_commut_and() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(3, 2, BinaryOp::OpAnd, 4)   // r3 = r2 & r4 (stored as (AND,2,4))
    instrs[1] = ir_binop(5, 4, BinaryOp::OpAnd, 2)   // r5 = r4 & r2 (canonical: (AND,2,4)) → hit
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_cse(func)
    result.instrs[1].op == IrOpcode::IrCopy && result.instrs[1].src1 == 3
}

