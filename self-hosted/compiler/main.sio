fn compiler_manifest_hash_string(s: string) -> i64 with Mut, Panic, Div {
    var hash: i64 = 5381
    let modp: i64 = 2147483647
    var i: i64 = 0
    while i < str_len(s) {
        let ch = str_char_at(s, i) as i64
        hash = ((hash * 131) + ch) % modp
        i = i + 1
    }
    hash
}

fn compiler_manifest_merkle_mix(a: i64, b: i64, c: i64, salt: i64) -> i64 {
    let modp: i64 = 2147483647
    (((a % modp) * 31) + ((b % modp) * 131) + ((c % modp) * 17) + salt) % modp
}

fn compiler_emit_manifest_json(path: string, ep: &IrEpistemicSection) with IO, Mut, Panic, Div, Alloc {
    let source_hash = compiler_manifest_hash_string(path)
    let version_hash = compiler_manifest_hash_string("0.80.0-selfhost")
    let merkle_root = compiler_manifest_merkle_mix(source_hash, version_hash, 0, 97)
    var i: i64 = 0

    print("{\n")
    print("  \"schema\": \"sounio.manifest.v2\",\n")
    print("  \"version\": \"0.80.0-selfhost\",\n")
    print("  \"path\": ")
    compiler_manifest_print_string_json(path)
    print(",\n")
    print("  \"source_hash\": ")
    print_int(source_hash)
    print(",\n")
    print("  \"merkle_root\": ")
    print_int(merkle_root)
    print(",\n")
    print("  \"epistemic\": {\n")

    compiler_manifest_print_model_families(ep)
    compiler_manifest_print_policies(ep)
    compiler_manifest_print_decision_policies(ep)

    compiler_manifest_print_deferral_policies(ep)
    compiler_manifest_print_acquisition_policies(ep)

    compiler_manifest_print_recourse_policies(ep)
    compiler_manifest_print_transition_policies(ep)

    print("    \"alternative_policies\": [\n")
    i = 0
    while i < (*ep).alternative_policy_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int((*ep).alternative_policies[i].id)
        print(", \"name\": ")
        compiler_manifest_print_name_json((*ep).alternative_policies[i].name)
        print(", \"target_type\": \"")
        compiler_manifest_print_type_name((*ep).alternative_policies[i].target_ty)
        print("\", \"frontier_kind\": ")
        compiler_manifest_print_name_json((*ep).alternative_policies[i].frontier_kind)
        print(", \"max_options\": ")
        print_int((*ep).alternative_policies[i].max_options)
        print(", \"objectives\": [")
        var ao: i64 = 0
        while ao < (*ep).alternative_policies[i].objective_count && ao < 8 {
            if ao > 0 { print(", ") }
            print("{\"name\": ")
            compiler_manifest_print_name_json((*ep).alternative_policies[i].objective_names[ao])
            print(", \"direction\": ")
            if (*ep).alternative_policies[i].objective_directions[ao] == 1 {
                compiler_manifest_print_string_json("maximize")
            } else {
                compiler_manifest_print_string_json("minimize")
            }
            print("}")
            ao = ao + 1
        }
        print("]}")
        i = i + 1
    }
    print("\n    ],\n")

    print("    \"validations\": [\n")
    i = 0
    while i < (*ep).validation_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int((*ep).validations[i].id)
        print(", \"name\": ")
        compiler_manifest_print_name_json((*ep).validations[i].name)
        print(", \"target_type\": \"")
        compiler_manifest_print_type_name((*ep).validations[i].target_ty)
        print("\"}")
        i = i + 1
    }
    print("\n    ],\n")

    print("    \"mechanistic_reports\": [\n")
    i = 0
    while i < (*ep).mechanistic_report_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int((*ep).mechanistic_reports[i].id)
        print(", \"latent_state_divergence\": ")
        compiler_manifest_print_f64_json((*ep).mechanistic_reports[i].latent_state_divergence)
        print(", \"causal_decomposition_divergence\": ")
        compiler_manifest_print_f64_json((*ep).mechanistic_reports[i].causal_decomposition_divergence)
        print(", \"intervention_response_divergence\": ")
        compiler_manifest_print_f64_json((*ep).mechanistic_reports[i].intervention_response_divergence)
        print(", \"parameter_role_divergence\": ")
        compiler_manifest_print_f64_json((*ep).mechanistic_reports[i].parameter_role_divergence)
        print(", \"structural_explanation_distance\": ")
        compiler_manifest_print_f64_json((*ep).mechanistic_reports[i].structural_explanation_distance)
        print(", \"aggregate_divergence\": ")
        compiler_manifest_print_f64_json((*ep).mechanistic_reports[i].aggregate_divergence)
        print("}")
        i = i + 1
    }
    print("\n    ],\n")

    print("    \"posterior_weights\": [\n")
    i = 0
    while i < (*ep).posterior_weights_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int((*ep).posterior_weights[i].id)
        print(", \"count\": ")
        print_int((*ep).posterior_weights[i].count)
        print(", \"model_names\": ")
        compiler_manifest_print_name_array((*ep).posterior_weights[i].model_names, (*ep).posterior_weights[i].count)
        print(", \"weights\": [")
        var w: i64 = 0
        while w < (*ep).posterior_weights[i].count && w < 16 {
            if w > 0 { print(", ") }
            compiler_manifest_print_f64_json((*ep).posterior_weights[i].weights[w])
            w = w + 1
        }
        print("]}")
        i = i + 1
    }
    print("\n    ],\n")

    print("    \"counterexamples\": [\n")
    i = 0
    while i < (*ep).counterexample_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int((*ep).counterexamples[i].id)
        print(", \"model_name\": ")
        compiler_manifest_print_name_json((*ep).counterexamples[i].model_name)
        print(", \"subgroup_name\": ")
        compiler_manifest_print_name_json((*ep).counterexamples[i].subgroup_name)
        print(", \"metric_name\": ")
        compiler_manifest_print_name_json((*ep).counterexamples[i].metric_name)
        print(", \"observed_value\": ")
        compiler_manifest_print_f64_json((*ep).counterexamples[i].observed_value)
        print(", \"threshold_value\": ")
        compiler_manifest_print_f64_json((*ep).counterexamples[i].threshold_value)
        print(", \"summary\": ")
        compiler_manifest_print_name_json((*ep).counterexamples[i].summary)
        print("}")
        i = i + 1
    }
    print("\n    ],\n")

    print("    \"audits\": [\n")
    i = 0
    while i < (*ep).audit_count {
