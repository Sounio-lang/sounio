        print(", \"name\": ")
        compiler_manifest_print_name_json((*ep).monitoring_policies[i].name)
        print(", \"target_type\": \"")
        compiler_manifest_print_type_name((*ep).monitoring_policies[i].target_ty)
        print("\", \"route_name\": ")
        compiler_manifest_print_name_json((*ep).monitoring_policies[i].route_name)
        print(", \"rollback_route_name\": ")
        compiler_manifest_print_name_json((*ep).monitoring_policies[i].rollback_route_name)
        print(", \"requirements\": [")
        var mrk: i64 = 0
        while mrk < (*ep).monitoring_policies[i].requirement_count && mrk < 8 {
            if mrk > 0 { print(", ") }
            let metric_name = (*ep).monitoring_policies[i].requirements[mrk].metric_name
            let op = (*ep).monitoring_policies[i].requirements[mrk].op
            let threshold = (*ep).monitoring_policies[i].requirements[mrk].threshold
            let threshold_kind = (*ep).monitoring_policies[i].requirements[mrk].threshold_kind
            let bool_threshold = (*ep).monitoring_policies[i].requirements[mrk].bool_threshold
            let name_threshold = (*ep).monitoring_policies[i].requirements[mrk].name_threshold
            compiler_manifest_print_policy_requirement_json(metric_name, op, threshold, threshold_kind, bool_threshold, name_threshold)
            mrk = mrk + 1
        }
        print("]}")
        i = i + 1
    }
    print("\n    ],\n")

    print("    \"observed_transitions\": [\n")
    i = 0
    while i < (*ep).observed_transition_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int((*ep).observed_transitions[i].id)
        print(", \"transition_plan_id\": ")
        print_int((*ep).observed_transitions[i].transition_plan_id)
        print(", \"monitoring_policy_id\": ")
        print_int((*ep).observed_transitions[i].monitoring_policy_id)
        print(", \"monitoring_policy_name\": ")
        if (*ep).observed_transitions[i].monitoring_policy_id >= 0 && (*ep).observed_transitions[i].monitoring_policy_id < (*ep).monitoring_policy_count {
            compiler_manifest_print_name_json((*ep).monitoring_policies[(*ep).observed_transitions[i].monitoring_policy_id].name)
        } else {
            compiler_manifest_print_name_json(compiler_manifest_empty_name())
        }
        print(", \"route_name\": ")
        compiler_manifest_print_name_json((*ep).observed_transitions[i].route_name)
        print(", \"rollback_route_name\": ")
        compiler_manifest_print_name_json((*ep).observed_transitions[i].rollback_route_name)
        print(", \"audit_id\": ")
        print_int((*ep).observed_transitions[i].audit_id)
        print(", \"audit_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_audit_name(ep, (*ep).observed_transitions[i].audit_id))
        print(", \"contest_id\": ")
        print_int((*ep).observed_transitions[i].contest_id)
        print(", \"inner_type\": \"")
        compiler_manifest_print_type_name((*ep).observed_transitions[i].inner_ty)
        print("\", \"metric_snapshot\": ")
        compiler_manifest_print_metric_snapshot((*ep).observed_transitions[i].metric_known, (*ep).observed_transitions[i].metric_values)
        print("}")
        i = i + 1
    }
    print("\n    ],\n")

    print("    \"rollback_certificates\": [\n")
    i = 0
    while i < (*ep).rollback_certificate_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int((*ep).rollback_certificates[i].id)
        print(", \"transition_plan_id\": ")
        print_int((*ep).rollback_certificates[i].transition_plan_id)
        print(", \"monitoring_policy_id\": ")
        print_int((*ep).rollback_certificates[i].monitoring_policy_id)
        print(", \"monitoring_policy_name\": ")
        if (*ep).rollback_certificates[i].monitoring_policy_id >= 0 && (*ep).rollback_certificates[i].monitoring_policy_id < (*ep).monitoring_policy_count {
            compiler_manifest_print_name_json((*ep).monitoring_policies[(*ep).rollback_certificates[i].monitoring_policy_id].name)
        } else {
            compiler_manifest_print_name_json(compiler_manifest_empty_name())
        }
        print(", \"route_name\": ")
        compiler_manifest_print_name_json((*ep).rollback_certificates[i].route_name)
        print(", \"rollback_route_name\": ")
        compiler_manifest_print_name_json((*ep).rollback_certificates[i].rollback_route_name)
        print(", \"reason_code\": ")
        print_int((*ep).rollback_certificates[i].reason_code)
        print(", \"audit_id\": ")
        print_int((*ep).rollback_certificates[i].audit_id)
        print(", \"audit_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_audit_name(ep, (*ep).rollback_certificates[i].audit_id))
        print(", \"contest_id\": ")
        print_int((*ep).rollback_certificates[i].contest_id)
        print(", \"inner_type\": \"")
        compiler_manifest_print_type_name((*ep).rollback_certificates[i].inner_ty)
        print("\", \"metric_snapshot\": ")
        compiler_manifest_print_metric_snapshot((*ep).rollback_certificates[i].metric_known, (*ep).rollback_certificates[i].metric_values)
        print("}")
        i = i + 1
    }
    print("\n    ],\n")

    print("    \"alternative_frontiers\": [\n")
    i = 0
    while i < (*ep).alternative_frontier_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int((*ep).alternative_frontiers[i].id)
        print(", \"name\": ")
        compiler_manifest_print_name_json((*ep).alternative_frontiers[i].name)
        print(", \"target_kind\": ")
        if (*ep).alternative_frontiers[i].target_kind == 1 {
            compiler_manifest_print_string_json("RecoursePlan")
        } else {
            compiler_manifest_print_string_json("Deferred")
        }
        print(", \"target_type\": \"")
        compiler_manifest_print_type_name((*ep).alternative_frontiers[i].target_ty)
        print("\", \"policy_id\": ")
        print_int((*ep).alternative_frontiers[i].alternative_policy_id)
        print(", \"policy_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_alternative_policy_name(ep, (*ep).alternative_frontiers[i].alternative_policy_id))
        print(", \"audit_id\": ")
        print_int((*ep).alternative_frontiers[i].audit_id)
        print(", \"audit_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_audit_name(ep, (*ep).alternative_frontiers[i].audit_id))
        print(", \"contest_id\": ")
        print_int((*ep).alternative_frontiers[i].contest_id)
        print(", \"source_policy_id\": ")
        print_int((*ep).alternative_frontiers[i].source_policy_id)
        print(", \"source_policy_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_recourse_policy_name(ep, (*ep).alternative_frontiers[i].source_policy_id))
        print(", \"source_plan_id\": ")
        print_int((*ep).alternative_frontiers[i].source_plan_id)
        print(", \"candidate_start\": ")
        print_int((*ep).alternative_frontiers[i].candidate_start)
        print(", \"candidate_count\": ")
        print_int((*ep).alternative_frontiers[i].candidate_count)
        print("}")
        i = i + 1
    }
    print("\n    ],\n")

    print("    \"alternative_sets\": [\n")
    i = 0
    while i < (*ep).alternative_set_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int((*ep).alternative_sets[i].id)
        print(", \"frontier_id\": ")
        print_int((*ep).alternative_sets[i].frontier_id)
        print(", \"frontier_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_alternative_frontier_name(ep, (*ep).alternative_sets[i].frontier_id))
        print(", \"audit_id\": ")
        print_int((*ep).alternative_sets[i].audit_id)
        print(", \"audit_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_audit_name(ep, (*ep).alternative_sets[i].audit_id))
        print(", \"contest_id\": ")
        print_int((*ep).alternative_sets[i].contest_id)
        print(", \"inner_type\": \"")
        compiler_manifest_print_type_name((*ep).alternative_sets[i].inner_ty)
        print("\", \"candidate_start\": ")
        print_int((*ep).alternative_sets[i].candidate_start)
        print(", \"candidate_count\": ")
        print_int((*ep).alternative_sets[i].candidate_count)
        print("}")
        i = i + 1
    }
    print("\n    ],\n")

    print("    \"alternative_candidates\": [\n")
    i = 0
    while i < (*ep).alternative_candidate_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int((*ep).alternative_candidates[i].id)
        print(", \"frontier_id\": ")
        print_int((*ep).alternative_candidates[i].frontier_id)
        print(", \"frontier_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_alternative_frontier_name(ep, (*ep).alternative_candidates[i].frontier_id))
        print(", \"candidate_name\": ")
        compiler_manifest_print_name_json((*ep).alternative_candidates[i].name)
        print(", \"value_repr\": ")
        compiler_manifest_print_name_json((*ep).alternative_candidates[i].value_repr)
        print(", \"source_kind\": ")
        compiler_manifest_print_string_json(compiler_manifest_alternative_source_kind_name((*ep).alternative_candidates[i].source_kind))
        print(", \"source_policy_id\": ")
        print_int((*ep).alternative_candidates[i].source_policy_id)
        print(", \"source_policy_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_recourse_policy_name(ep, (*ep).alternative_candidates[i].source_policy_id))
        print(", \"source_plan_id\": ")
        print_int((*ep).alternative_candidates[i].source_plan_id)
        print(", \"strategy_name\": ")
        compiler_manifest_print_name_json((*ep).alternative_candidates[i].strategy_name)
        print(", \"route_name\": ")
        compiler_manifest_print_name_json((*ep).alternative_candidates[i].route_name)
        print(", \"audit_id\": ")
        print_int((*ep).alternative_candidates[i].audit_id)
        print(", \"audit_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_audit_name(ep, (*ep).alternative_candidates[i].audit_id))
        print(", \"contest_id\": ")
        print_int((*ep).alternative_candidates[i].contest_id)
        print(", \"metric_snapshot\": {")
        print("\"intervention_cost\": ")
        compiler_manifest_print_f64_json((*ep).alternative_candidates[i].intervention_cost)
        print(", \"residual_tail_risk\": ")
        compiler_manifest_print_f64_json((*ep).alternative_candidates[i].residual_tail_risk)
        print(", \"mechanistic_divergence\": ")
        compiler_manifest_print_f64_json((*ep).alternative_candidates[i].mechanistic_divergence)
        print(", \"admissibility_margin\": ")
        compiler_manifest_print_f64_json((*ep).alternative_candidates[i].admissibility_margin)
        print("}")
        print(", \"dominance_rank\": ")
        print_int((*ep).alternative_candidates[i].dominance_rank)
        print("}")
        i = i + 1
    }
    print("\n    ]\n")

    print("  }\n")
    print("}\n")
}

fn compiler_load_manifest_epistemic(path: string) -> CompilerManifestLoadResult with IO, Mut, Panic, Div, Alloc {
    var merged_epistemic = ir_empty_epistemic_section()
    let frontend_result = load_multimodule_epistemic_into(path, &!merged_epistemic)
    if !frontend_result.ok {
        var check_errors = compile_errors_new()
        check_errors = compile_push_ir_failure(check_errors, frontend_result.error_msg)
        return compiler_manifest_load_result_error(check_errors)
    }
    compiler_manifest_load_result_ok(merged_epistemic)
}

fn compile_emit_manifest_json_from_source(path: string) -> CompileResult with IO, Mut, Panic, Div, Alloc {
    let manifest_result = compiler_load_manifest_epistemic(path)
    if !manifest_result.ok {
        return CompileResult { success: false, errors: manifest_result.errors, output: "" }
    }

    compiler_emit_manifest_json(path, &manifest_result.epistemic)
    CompileResult {
        success: true,
        errors: compile_errors_new(),
        output: "stdout",
    }
}

// ============================================================================
// COMPILATION PIPELINE
// ============================================================================

fn compile(opts: CompilerOptions) -> CompileResult with IO, Mut, Panic, Div, Alloc {
    if !file_exists(opts.input_file) {
        var file_errors = compile_errors_new()
        file_errors = compile_errors_push(file_errors, compile_format_error_at(opts.input_file, 0, 0, "could not read input file"))
        return CompileResult {
            success: false,
            errors: file_errors,
            output: "",
        }
    }

    let incomplete_assign = compile_scan_incomplete_assignment(opts.input_file)
    if incomplete_assign.0 >= 0 {
        var parse_like_errors = compile_errors_new()
        parse_like_errors = compile_errors_push(
            parse_like_errors,
            compile_format_error_at(opts.input_file, incomplete_assign.0, incomplete_assign.1, "syntax appears incomplete after assignment")
        )
        return CompileResult {
            success: false,
            errors: parse_like_errors,
            output: "",
        }
    }

    if !compiler_visibility_preflight(opts.input_file) {
        // The name is historical and MISLEADING: this preflight runs the whole multi-module
        // typecheck (E012/E137/... included), not just the E176 visibility rules, and it also
        // fails when a module in the closure did not PARSE. The diagnostics printed above this
        // line (module_closure:/run_check_mode:/error[Exxx]) carry the real cause. The string
        // below is kept verbatim because gate scripts grep for it.
        println("note: preflight covers module-closure parsing AND the full multi-module typecheck; see the diagnostics above for the actual cause")
        var visibility_errors = compile_errors_new()
        // The preflight covers three distinct failures — a module that will not
        // parse, an AST closure that could not be completed, and a type error
        // across the merged modules — and this one message described only the
        // stage. run_check_mode prints which of the three it was just above; say
        // that here too, so the final line a user sees is not misleading on its own.
        visibility_errors = compile_errors_push(visibility_errors, "error: preflight failed (parse, module closure, or type check — see run_check_mode output above)")
        return CompileResult {
            success: false,
            errors: visibility_errors,
            output: "",
        }
    }

    if opts.emit_manifest {
        return compile_emit_manifest_json_from_source(opts.input_file)
    }

    if str_eq(opts.target, "llvm") {
        let llvm_exit = compile_multimodule_llvm(opts.input_file, opts.output_file, opts.optimize)
        if llvm_exit == 0 {
            return CompileResult {
                success: true,
                errors: compile_errors_new(),
                output: opts.output_file,
            }
        }

        var llvm_errors = compile_errors_new()
        llvm_errors = compile_errors_push(llvm_errors, "error: multimodule llvm compilation failed")
        return CompileResult {
            success: false,
            errors: llvm_errors,
            output: "",
        }
    }

    let early_frontend_preflight = preflight_multimodule_frontend(opts.input_file)
    let early_preflight_parse_errors = parser_last_error_count()
    if !early_frontend_preflight.ok || early_preflight_parse_errors > 0 {
        compiler_print_ir_preflight_failure(early_frontend_preflight.error_msg)
        var early_type_errors = compile_errors_new()
        early_type_errors = compile_errors_push(early_type_errors, "error: type checking preflight failed")
        return CompileResult {
            success: false,
            errors: early_type_errors,
            output: "",
        }
    }

    let main_prog = load_module_file(opts.input_file)
    let main_imports = extract_imports_from_ast(main_prog)
    let requested_target_spec = native_resolve_target(opts.target, "auto", false)
    if main_imports.count > 0 &&
       requested_target_spec.arch_id == ARCH_X86_64() &&
       requested_target_spec.os_id == OS_LINUX() &&
       !str_eq(opts.target, "wasm") {
        let thin_exit = compile_multimodule_native_advanced(
            opts.input_file,
            opts.output_file,
            opts.target,
            "auto",
            false,
            opts.gpu_target,
            opts.gpu_binary_format,
            opts.gpu_strict_parity,
            opts.optimize,
            opts.use_profile,
            opts.use_profile_path,
            opts.cache_dir,
            opts.cache_mode,
            opts.cache_stats
        )
        if thin_exit == 0 {
            return CompileResult {
                success: true,
                errors: compile_errors_new(),
                output: opts.output_file,
            }
        }

        var thin_errors = compile_errors_new()
        thin_errors = compile_errors_push(thin_errors, "error: multimodule native thin-link compilation failed")
        return CompileResult {
            success: false,
            errors: thin_errors,
            output: "",
        }
    }

    // Preflight load catches parse/module-resolution failures early and avoids
    // driving native compilation on obviously invalid inputs.
    var ir_result = load_multimodule_ir(opts.input_file)
    let preflight_parse_errors = parser_last_error_count()
    if !ir_result.ok || preflight_parse_errors > 0 {
        var preflight_errors = compile_errors_new()
        if !ir_result.ok {
            preflight_errors = compile_push_ir_failure(preflight_errors, ir_result.error_msg)
        }
        if preflight_parse_errors > 0 {
            preflight_errors = compile_errors_push(preflight_errors, "error: parser reported " + int_to_string(preflight_parse_errors) + " syntax errors")
        }
        if preflight_errors.len == 0 {
            preflight_errors = compile_errors_push(preflight_errors, "error: compilation preflight failed")
        }
        return CompileResult {
            success: false,
            errors: preflight_errors,
            output: "",
        }
    }

    // Sprint 50: hoist profile for layout pass
    var has_valid_profile = false
    var loaded_profile = sprof_empty_profile()

    // Sprint 47: apply .sprof profile-guided strategy promotion
    if opts.use_profile {
        let prof_size = file_size(opts.use_profile_path)
        if prof_size > 0 {
            let prof_bytes = read_file(opts.use_profile_path)
            var prof_buf: [i8; 4096] = [0; 4096]
            var pi: i64 = 0
            while pi < prof_size && pi < 4096 {
                prof_buf[pi as usize] = prof_bytes[pi as usize]
                pi = pi + 1
            }
            let profile = sprof_parse(prof_buf, prof_size)
            sprof_apply_promotion(&! (*ir_result.module), &profile)

            // Sprint 48: log promotion decisions
            var li: i64 = 0
            while li < (*ir_result.module).fn_count {
                // #1678: same hoist as sprof_apply_promotion. This loop is the
                // RECEIPT for the decisions applied above, so leaving it on the
                // in-place reference would have made it report a different set of
                // promotions than the ones performed. A log that lies is worse
                // than no log.
                var lf = ir_fn_get(&(*ir_result.module), li as usize)
                let lcount = sprof_lookup(&profile, &lf.name)
                let ltarget = sprof_promotion_target(lcount)
                if ltarget >= 0 {
                    print("[sprof] ")
                    compiler_manifest_print_name(lf.name)
                    println(": count " + int_to_string(lcount) + " -> strategy " + ir_strategy_name(ltarget))
                }
                li = li + 1
            }

            loaded_profile = profile
            has_valid_profile = true
        }
    }

    // Sprint 49: Apply inlining pass when -O is set
    // By-value opt passes densify temporarily; re-box to keep MultiModuleIrResult boxed.
    if opts.optimize {
        let pre_inline_count = (*ir_result.module).fn_count
        ir_result.module = Box::new(inl_run_pass(*ir_result.module))
        println("[inline] pass complete: " + int_to_string(pre_inline_count) + " functions processed")
    }

    // Sprint 50: Profile-guided function layout
    if has_valid_profile {
        let layout_result = layout_sort_by_profile(*ir_result.module, &loaded_profile)
        ir_result.module = Box::new(layout_result.module)
        if layout_result.reordered {
            println("[layout] reordered " + int_to_string((*ir_result.module).fn_count) + " functions (" + int_to_string(layout_result.hot_count) + " hot, " + int_to_string(layout_result.cold_count) + " cold)")
        }
    }

    // Sprint 51: const_fold + DCE cleanup after inlining
    if opts.optimize {
        let pre_opt_count = (*ir_result.module).fn_count
        ir_result.module = Box::new(opt_cleanup_module(*ir_result.module))
        println("[opt] const_prop + dce applied to " + int_to_string(pre_opt_count) + " functions")
        let loop_result = lopt_optimize_module(*ir_result.module)
        ir_result.module = Box::new(loop_result.module)
        if loop_result.functions_changed > 0 {
            println("[loop] hoisted " + int_to_string(loop_result.invariants_hoisted) +
                    " invariants across " + int_to_string(loop_result.functions_changed) + " functions")
        }
        ir_result.module = Box::new(opt_cleanup_module(*ir_result.module))
    }

    // Sprint 54: Tail call optimization
    if opts.optimize {
        let tco_result = tco_run_pass(*ir_result.module)
        ir_result.module = Box::new(tco_result.0)
        let tco_ctx = tco_result.1
        if tco_ctx.stats.transformed > 0 {
            println("[tco] " + int_to_string(tco_ctx.stats.transformed) + " tail call(s) converted to loops")
        }
    }

    // compile_multimodule_native_with_ir still takes IrModule by value.
    let exit_code = compile_multimodule_native_with_ir(
        opts.input_file,
        *ir_result.module,
        opts.output_file,
        opts.target,
        "auto",
        false,
        opts.gpu_target,
        opts.gpu_binary_format,
        opts.gpu_strict_parity
    )

    if exit_code == 0 {
        return CompileResult {
            success: true,
            errors: compile_errors_new(),
            output: opts.output_file,
        }
    }

    // Diagnostic replay path: preserve compile_multimodule_native behavior while
    // collecting structured messages for callers.
    var errors = compile_errors_new()
    if !ir_result.ok {
        errors = compile_push_ir_failure(errors, ir_result.error_msg)
    } else {
        let target_spec = native_resolve_target(opts.target, "auto", false)
        let native_result = compile_native(&(*ir_result.module), target_spec)
        if !native_result.ok {
            errors = compile_errors_push_lines(errors, "error: ", native_result.error_msg)
        }
    }

    let parse_errors = parser_last_error_count()
    if parse_errors > 0 {
        errors = compile_errors_push(errors, "error: parser reported " + int_to_string(parse_errors) + " syntax errors")
    }
    if errors.len == 0 {
        errors = compile_errors_push(errors, "error: compilation failed (no structured diagnostics captured)")
    }

    CompileResult {
        success: false,
        errors: errors,
        output: "",
    }
}

fn compiler_main_test_char_from_i64_valid() -> bool with Mut, Panic, Div {
    char_from_i64(0) == "0" &&
    char_from_i64(5) == "5" &&
    char_from_i64(9) == "9"
}

fn compiler_main_test_char_from_i64_error_messages() -> bool with Mut, Panic, Div {
    char_from_i64_error(-1) == "char_from_i64: digit must be 0-9, got -1" &&
    char_from_i64_error(10) == "char_from_i64: digit must be 0-9, got 10"
}

fn compiler_main_test_arg_list_get_valid() -> bool with Mut, Panic, Div {
    let args = ArgList {
        items: ["alpha", "beta", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        len: 2,
    }
    arg_list_get(args, 0) == "alpha" && arg_list_get(args, 1) == "beta"
}

fn compiler_main_test_arg_list_get_error_messages() -> bool with Mut, Panic, Div {
    arg_list_get_error(-1, 3) == "arg_list_get: index -1 out of bounds (length 3)" &&
    arg_list_get_error(3, 3) == "arg_list_get: index 3 out of bounds (length 3)" &&
    arg_list_get_error(4, 3) == "arg_list_get: index 4 out of bounds (length 3)"
}

fn compiler_main_test_int_to_string() -> bool with Mut, Panic, Div {
    // Use i64_to_string_no_div (heap-safe via string concatenation) in the JIT.
    // i64_to_string_decimal uses str_from_bytes on a stack array which becomes
    // invalid after return — safe in native ELF binaries but not in the JIT.
    let s0 = i64_to_string_no_div(0)
    let s1 = i64_to_string_no_div(42)
    let s2 = i64_to_string_no_div(-42)
    let s3 = i64_to_string_no_div(1000000)
    let s4 = i64_to_string_no_div(-1000000)
    str_eq(s0, "0") &&
    str_eq(s1, "42") &&
    str_eq(s2, "-42") &&
    str_eq(s3, "1000000") &&
    str_eq(s4, "-1000000")
}

fn compiler_main_native_byte_u8(b: i8) -> i64 {
    let x = b as i64
    if x < 0 { x + 256 } else { x }
}

fn compiler_main_native_code_eq(a: CodeBuffer, b: CodeBuffer) -> bool with Mut {
    if a.len != b.len { return false }
    var i: i64 = 0
    while i < a.len {
        if compiler_main_native_byte_u8(a.bytes[i as usize]) != compiler_main_native_byte_u8(b.bytes[i as usize]) {
            return false
        }
        i = i + 1
    }
    true
}

fn compiler_main_native_find_pattern4(
    buf: CodeBuffer, b0: i64, b1: i64, b2: i64, b3: i64
) -> i64 with Mut {
    if buf.len < 4 { return -1 }
    var i: i64 = 0
    while i <= buf.len - 4 {
        if compiler_main_native_byte_u8(buf.bytes[i as usize]) == b0 &&
           compiler_main_native_byte_u8(buf.bytes[(i + 1) as usize]) == b1 &&
           compiler_main_native_byte_u8(buf.bytes[(i + 2) as usize]) == b2 &&
           compiler_main_native_byte_u8(buf.bytes[(i + 3) as usize]) == b3 {
            return i
        }
        i = i + 1
    }
    -1
}

fn compiler_main_find_fn(m: IrModule, name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < m.fn_count {
        if ir_name_eq(ir_fn_get(&m, i).name, name) {
            return i
        }
        i = i + 1
    }
    -1
}

fn compiler_main_find_call_idx(f: IrFunction, callee_name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < f.instr_count {
        if (IR_A_OP[(ir_region_slot_r(f.region, (i))) as usize] as IrOpcode) == IrOpcode::IrCall &&
           ir_name_eq(ir_arena_name(ir_region_slot_r(f.region, (i))), callee_name) {
            return i
        }
        i = i + 1
    }
    -1
}

fn compiler_main_has_load_imm_dst_value(f: IrFunction, dst: i64, value: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < f.instr_count {
        if (IR_A_OP[(ir_region_slot_r(f.region, (i))) as usize] as IrOpcode) == IrOpcode::IrLoadImm &&
           IR_A_DST[(ir_region_slot_r(f.region, (i))) as usize] == dst &&
           IR_A_IMM_I64[(ir_region_slot_r(f.region, (i))) as usize] == value {
            return true
        }
        i = i + 1
    }
    false
}

fn compiler_main_test_strategy_float_strict_modes_match() -> bool with Mut, Panic, Div {
    // Both standard and precision-preserving block float reassociation; only aggressive allows it.
    // This captures the key invariant (identical codegen for standard/precision f64 add) without
    // stack-allocating NativeCompiler instances — which at ~400 KB each overflow the JIT stack.
    let std_no_reassoc  = !ir_native_strategy_allows_float_reassoc(IR_STRATEGY_STANDARD)
    let prec_no_reassoc = !ir_native_strategy_allows_float_reassoc(IR_STRATEGY_PRECISION_PRESERVING)
    let agg_yes_reassoc =  ir_native_strategy_allows_float_reassoc(IR_STRATEGY_AGGRESSIVE)
    // Precision-preserving additionally activates strict FP mode; standard does not.
    let prec_strict     =  ir_native_strategy_requires_strict_fp(IR_STRATEGY_PRECISION_PRESERVING)
    let std_not_strict  = !ir_native_strategy_requires_strict_fp(IR_STRATEGY_STANDARD)
    std_no_reassoc && prec_no_reassoc && agg_yes_reassoc && prec_strict && std_not_strict
}

fn compiler_main_test_strategy_float_aggressive_diverges() -> bool with Mut, Panic, Div {
    // Aggressive strategy allows float reassociation and operand commutativity;
    // standard and precision do not. Test via pure predicate calls — avoids
    // stack-allocating NativeCompiler instances (~400 KB each) which overflow the JIT stack.
    let std_no_reassoc  = !ir_native_strategy_allows_float_reassoc(IR_STRATEGY_STANDARD)
    let agg_yes_reassoc =  ir_native_strategy_allows_float_reassoc(IR_STRATEGY_AGGRESSIVE)
    // Aggressive commutes OpAdd (ab = ba for floats in aggressive mode); standard does not.
    let agg_commutes_add = ir_native_strategy_can_commute_float_binop(IR_STRATEGY_AGGRESSIVE, BinaryOp::OpAdd)
    let std_no_commute   = !ir_native_strategy_can_commute_float_binop(IR_STRATEGY_STANDARD, BinaryOp::OpAdd)
    // OpSub is never commutative regardless of strategy.
    let agg_no_commute_sub = !ir_native_strategy_can_commute_float_binop(IR_STRATEGY_AGGRESSIVE, BinaryOp::OpSub)
    std_no_reassoc && agg_yes_reassoc && agg_commutes_add && std_no_commute && agg_no_commute_sub
}

fn compiler_main_one_arg(reg: i64) -> Option<Box<IrRegList>> with Alloc {
    Some(Box::new(IrRegList { head: reg, tail: None }))
}

fn compiler_main_test_validated_chain_forwarding() -> bool with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()
    module.fn_count = 2

    var outer_fn = ir_empty_function()
    // #1649: ir_empty_function() hands back ir_region_invalid(), so every
    // ir_region_slot_w below would latch and land in QUARANTINE -- and two
    // functions in one test share those slots, so they silently overwrite
    // each other. Allocate a real region, as the lowerer does per function.
    ir_function_alloc_region(&! outer_fn)
    outer_fn.name = make_name("outer_contested")
    outer_fn.compile_strategy = IR_STRATEGY_INSTRUMENTED
    outer_fn.param_count = 2
    outer_fn.param_regs[0] = 0
    outer_fn.param_regs[1] = 1
    outer_fn.reg_count = 3
    outer_fn.instr_count = 2
    ir_arena_store(ir_region_slot_w(outer_fn.region, (0)), ir_call(2, 1, make_name("inner_contested"), compiler_main_one_arg(1), 1))
    ir_arena_store(ir_region_slot_w(outer_fn.region, (1)), ir_return(2))

    var inner_fn = ir_empty_function()
    ir_function_alloc_region(&! inner_fn)
    inner_fn.name = make_name("inner_contested")
    inner_fn.compile_strategy = IR_STRATEGY_INSTRUMENTED
    inner_fn.param_count = 2
    inner_fn.param_regs[0] = 0
    inner_fn.param_regs[1] = 1
    inner_fn.reg_count = 2
    inner_fn.instr_count = 1
    ir_arena_store(ir_region_slot_w(inner_fn.region, (0)), ir_return(1))

    ir_fn_set(&! module, 0, outer_fn)
    ir_fn_set(&! module, 1, inner_fn)
    ir_patch_validated_calls(&! module)

    let patched_outer = ir_fn_get(&module, 0)
    let call = ir_arena_load(ir_region_slot_r(patched_outer.region, (0)))
    // #1649 EXPERIMENT: identical predicate, bound to a local instead of being
    // the tail expression. No print, no IO. If this alone makes T10 pass, the
    // multi-line `&&` chain in tail position is miscompiled.
    let ok = call.op == IrOpcode::IrCall &&
        call.fn_id == 1 &&
        call.arg_count == 2 &&
        call.src1 == patched_outer.param_regs[0] &&
        call.src2 == patched_outer.param_regs[1]
    ok
}

fn compiler_main_test_validated_chain_top_level_fallback() -> bool with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()
    module.fn_count = 2

    var main_fn = ir_empty_function()
    // #1649: ir_empty_function() hands back ir_region_invalid(), so every
    // ir_region_slot_w below would latch and land in QUARANTINE -- and two
    // functions in one test share those slots, so they silently overwrite
    // each other. Allocate a real region, as the lowerer does per function.
    ir_function_alloc_region(&! main_fn)
    main_fn.name = make_name("main")
    main_fn.compile_strategy = IR_STRATEGY_STANDARD
    main_fn.reg_count = 2
    main_fn.instr_count = 3
    ir_arena_store(ir_region_slot_w(main_fn.region, (0)), ir_load_imm(0, 5))
    ir_arena_store(ir_region_slot_w(main_fn.region, (1)), ir_call(1, 1, make_name("outer_contested"), compiler_main_one_arg(0), 1))
    ir_arena_store(ir_region_slot_w(main_fn.region, (2)), ir_return(1))

    var outer_fn = ir_empty_function()
    ir_function_alloc_region(&! outer_fn)
    outer_fn.name = make_name("outer_contested")
    outer_fn.compile_strategy = IR_STRATEGY_INSTRUMENTED
    outer_fn.param_count = 2
    outer_fn.param_regs[0] = 0
    outer_fn.param_regs[1] = 1
    outer_fn.reg_count = 2
    outer_fn.instr_count = 1
    ir_arena_store(ir_region_slot_w(outer_fn.region, (0)), ir_return(1))

    ir_fn_set(&! module, 0, main_fn)
    ir_fn_set(&! module, 1, outer_fn)
    ir_patch_validated_calls(&! module)

    let patched_main = ir_fn_get(&module, 0)
    let call = ir_arena_load(ir_region_slot_r(patched_main.region, (2)))
    patched_main.instr_count == 4 &&
    patched_main.reg_count == 3 &&
    (IR_A_OP[(ir_region_slot_r(patched_main.region, (0))) as usize] as IrOpcode) == IrOpcode::IrLoadImm &&
    IR_A_IMM_I64[(ir_region_slot_r(patched_main.region, (0))) as usize] == 1 &&
    call.op == IrOpcode::IrCall &&
    call.fn_id == 1 &&
    call.arg_count == 2 &&
    call.src1 == IR_A_DST[(ir_region_slot_r(patched_main.region, (0))) as usize] &&
    call.src2 == 0
}

fn compiler_main_test_ir_opt_dispatch_and_merge() -> bool with Mut, Panic, Div {
    var func = ir_empty_function()
    // #1649: ir_empty_function() hands back ir_region_invalid(), so every
    // ir_region_slot_w below would latch and land in QUARANTINE -- and two
    // functions in one test share those slots, so they silently overwrite
    // each other. Allocate a real region, as the lowerer does per function.
    ir_function_alloc_region(&! func)
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.param_count = 1
    func.param_regs[0] = 0
    func.reg_count = 4
    func.label_count = 3
    func.compile_strategy = IR_STRATEGY_INSTRUMENTED
    func.instr_count = 8
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_branch_false(0, 1))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_load_imm(1, 11))
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_copy(3, 1))
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_jump(2))
    ir_arena_store(ir_region_slot_w(func.region, (4)), ir_label(1))
    ir_arena_store(ir_region_slot_w(func.region, (5)), ir_load_imm(2, 22))
    ir_arena_store(ir_region_slot_w(func.region, (6)), ir_copy(3, 2))
    ir_arena_store(ir_region_slot_w(func.region, (7)), ir_return(3))

    let transformed = ir_opt_apply_strategy(func)
    let dispatch_label = ir_opt_max_label(func) + 1
    let instr_label = dispatch_label + 1
    let merge_label = dispatch_label + 2

    transformed.instr_count == 24 &&
    transformed.label_count == 6 &&
    (IR_A_OP[(ir_region_slot_r(transformed.region, (0))) as usize] as IrOpcode) == IrOpcode::IrLabel &&
    IR_A_LABEL_ID[(ir_region_slot_r(transformed.region, (0))) as usize] == dispatch_label &&
    (IR_A_OP[(ir_region_slot_r(transformed.region, (1))) as usize] as IrOpcode) == IrOpcode::IrBranchTrue &&
    IR_A_SRC1[(ir_region_slot_r(transformed.region, (1))) as usize] == 0 &&
    IR_A_LABEL_ID[(ir_region_slot_r(transformed.region, (1))) as usize] == 0 &&
    (IR_A_OP[(ir_region_slot_r(transformed.region, (2))) as usize] as IrOpcode) == IrOpcode::IrJump &&
    IR_A_LABEL_ID[(ir_region_slot_r(transformed.region, (2))) as usize] == instr_label &&
    (IR_A_OP[(ir_region_slot_r(transformed.region, (22))) as usize] as IrOpcode) == IrOpcode::IrLabel &&
    IR_A_LABEL_ID[(ir_region_slot_r(transformed.region, (22))) as usize] == merge_label &&
    (IR_A_OP[(ir_region_slot_r(transformed.region, (23))) as usize] as IrOpcode) == IrOpcode::IrReturn &&
    IR_A_SRC1[(ir_region_slot_r(transformed.region, (23))) as usize] == 3
}

fn compiler_main_test_ir_opt_branch_targets_remapped() -> bool with Mut, Panic, Div {
    var func = ir_empty_function()
    // #1649: ir_empty_function() hands back ir_region_invalid(), so every
    // ir_region_slot_w below would latch and land in QUARANTINE -- and two
    // functions in one test share those slots, so they silently overwrite
    // each other. Allocate a real region, as the lowerer does per function.
    ir_function_alloc_region(&! func)
    func.name = ir_name_from_bytes(98, 114, 97, 110, 4)
    func.param_count = 1
    func.param_regs[0] = 0
    func.reg_count = 4
    func.label_count = 3
    func.compile_strategy = IR_STRATEGY_INSTRUMENTED
    func.instr_count = 8
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_branch_false(0, 1))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_load_imm(1, 11))
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_copy(3, 1))
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_jump(2))
    ir_arena_store(ir_region_slot_w(func.region, (4)), ir_label(1))
    ir_arena_store(ir_region_slot_w(func.region, (5)), ir_load_imm(2, 22))
    ir_arena_store(ir_region_slot_w(func.region, (6)), ir_copy(3, 2))
    ir_arena_store(ir_region_slot_w(func.region, (7)), ir_return(3))

    let transformed = ir_opt_apply_strategy(func)
    let label_offset = ir_opt_max_label(func) + 1

    var saw_remapped_branch = false
    var saw_remapped_jump = false
    var saw_remapped_label = false
    var i: i64 = 0
    while i < transformed.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(transformed.region, (i)))
        if instr.op == IrOpcode::IrBranchFalse && instr.label_id == 1 + label_offset {
            saw_remapped_branch = true
        }
        if instr.op == IrOpcode::IrJump && instr.label_id == 2 + label_offset {
            saw_remapped_jump = true
        }
        if instr.op == IrOpcode::IrLabel && instr.label_id == 1 + label_offset {
            saw_remapped_label = true
        }
        i = i + 1
    }

    saw_remapped_branch && saw_remapped_jump && saw_remapped_label
}

fn compiler_main_test_ir_opt_expands_local_reg_range() -> bool with Mut, Panic, Div {
    var func = ir_empty_function()
    // #1649: ir_empty_function() hands back ir_region_invalid(), so every
    // ir_region_slot_w below would latch and land in QUARANTINE -- and two
    // functions in one test share those slots, so they silently overwrite
    // each other. Allocate a real region, as the lowerer does per function.
    ir_function_alloc_region(&! func)
    func.name = ir_name_from_bytes(97, 100, 100, 50, 4)
    func.param_count = 2
    func.param_regs[0] = 0
    func.param_regs[1] = 1
    func.reg_count = 3
    func.compile_strategy = IR_STRATEGY_INSTRUMENTED
    func.instr_count = 2
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_binop(2, 0, BinaryOp::OpAdd, 1))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_return(2))

    let transformed = ir_opt_apply_strategy(func)
    if !(transformed.reg_count > func.reg_count) {
        return false
    }
    if !(transformed.instr_count > func.instr_count) {
        return false
    }
    true
}

// Sprint 44: verify IrProfCounter is injected in the instrumented path
fn compiler_main_test_prof_counter_in_instrumented_path() -> bool with Mut, Panic, Div {
    var func = ir_empty_function()
    // #1649: ir_empty_function() hands back ir_region_invalid(), so every
    // ir_region_slot_w below would latch and land in QUARANTINE -- and two
    // functions in one test share those slots, so they silently overwrite
    // each other. Allocate a real region, as the lowerer does per function.
    ir_function_alloc_region(&! func)
    func.name = ir_name_from_bytes(112, 114, 111, 102, 4)
    func.param_count = 1
    func.param_regs[0] = 0
    func.reg_count = 2
    func.compile_strategy = IR_STRATEGY_INSTRUMENTED
    func.prof_counter_id = 7
    func.instr_count = 2
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(1, 42))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_return(1))

    let transformed = ir_opt_apply_strategy(func)
    let label_offset = ir_opt_max_label(func) + 1
    let instr_label = label_offset + 1

    var saw_prof_counter = false
    var after_instr_label = false
    var saw_instr_label = false
    var i: i64 = 0
    while i < transformed.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(transformed.region, (i)))
        if instr.op == IrOpcode::IrLabel && instr.label_id == instr_label {
            saw_instr_label = true
        }
        if instr.op == IrOpcode::IrProfCounter {
            saw_prof_counter = true
            if saw_instr_label {
                after_instr_label = true
            }
        }
        i = i + 1
    }
    saw_prof_counter && after_instr_label
}

// Sprint 44: verify NO IrProfCounter appears in the fast path region
fn compiler_main_test_prof_counter_absent_from_fast_path() -> bool with Mut, Panic, Div {
    var func = ir_empty_function()
    // #1649: ir_empty_function() hands back ir_region_invalid(), so every
    // ir_region_slot_w below would latch and land in QUARANTINE -- and two
    // functions in one test share those slots, so they silently overwrite
    // each other. Allocate a real region, as the lowerer does per function.
    ir_function_alloc_region(&! func)
    func.name = ir_name_from_bytes(102, 97, 115, 116, 4)
    func.param_count = 1
    func.param_regs[0] = 0
    func.reg_count = 2
    func.compile_strategy = IR_STRATEGY_INSTRUMENTED
    func.prof_counter_id = 3
    func.instr_count = 2
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(1, 99))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_return(1))

    let transformed = ir_opt_apply_strategy(func)
    let label_offset = ir_opt_max_label(func) + 1
    let instr_label = label_offset + 1

    // Fast path is between the dispatch jump (index 2) and the instr_label
    var in_fast_path = false
    var counter_in_fast_path = false
    var i: i64 = 0
    while i < transformed.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(transformed.region, (i)))
        if i == 3 { in_fast_path = true }
        if instr.op == IrOpcode::IrLabel && instr.label_id == instr_label {
            in_fast_path = false
        }
        if in_fast_path && instr.op == IrOpcode::IrProfCounter {
            counter_in_fast_path = true
        }
        i = i + 1
    }
    !counter_in_fast_path
}

// Sprint 45: verify INC encoding (48 FF 05) emitted for IrProfCounter
fn compiler_main_test_prof_counter_inc_encoding() -> bool with Mut, Panic, Div, Alloc {
    var nc = compiler_new()
    let instr = ir_prof_counter(3)
    lower_instr(&!nc, instr)
    // INC QWORD PTR [RIP+disp32]: 48 FF 05 <4 bytes disp32> = 7 bytes total
    if nc.code.len != 7 { return false }
    if NC_BIG_CODE[0] != 0x48 as i8 { return false }
    if NC_BIG_CODE[1] != 0xFF as i8 { return false }
    if NC_BIG_CODE[2] != 0x05 as i8 { return false }
    true
}

// Sprint 45: verify .data relocation recorded with kind_code=3
fn compiler_main_test_prof_counter_reloc_recorded() -> bool with Mut, Panic, Div, Alloc {
    var nc = compiler_new()
    let instr = ir_prof_counter(3)
    lower_instr(&!nc, instr)
    if nc.relocs.count != 1 { return false }
    let reloc = nc.relocs.entries[0]
    // kind_code must be 3 (.data RIP-relative)
    if reloc.kind.kind_code != 3 { return false }
    // target_index must account for the RuntimeContext global slot in .data.
    if reloc.target.target_index != runtime_context_global_slot_size() + (3 * 8) { return false }
    true
}

// Sprint 46: verify __prof_dump function is emitted when prof_counter_count > 0
fn compiler_main_test_prof_dump_emitted() -> bool with Alloc, Mut, Panic, Div {
    var nc = compiler_new()
    // Simulate: 1 prof counter with fn_name "test" at .rodata offset 0
    nc.prof_counter_count = 1
    nc.prof_counter_names[0] = 0
    // Create minimal module with 1 prof counter entry
    var module = ir_empty_module()
    module.prof_counter_count = 1
    var pc_info = ir_empty_prof_counter_info()
    pc_info.fn_id = 0
    pc_info.counter_id = 0
    module.prof_counters[0] = pc_info
    // Emit the dump function
    let before_len = nc.code.len
    nc = emit_prof_dump_function(nc, &module)
    // Verify: code was emitted (prologue + at least one syscall + epilogue)
    if nc.code.len <= before_len { return false }
    // Verify: function ends with ret (0xC3)
    if NC_BIG_CODE[(nc.code.len - 1) as usize] != 0xC3 as i8 { return false }
    true
}

// Sprint 46: verify __prof_dump writes to stderr (fd=2) and records relocations
fn compiler_main_test_prof_dump_writes_stderr() -> bool with Alloc, Mut, Panic, Div {
    var nc = compiler_new()
    nc.prof_counter_count = 1
    nc.prof_counter_names[0] = 0
    var module = ir_empty_module()
    module.prof_counter_count = 1
    var pc_info = ir_empty_prof_counter_info()
    pc_info.fn_id = 0
    pc_info.counter_id = 0
    module.prof_counters[0] = pc_info
    nc = emit_prof_dump_function(nc, &module)
    // Verify: relocations recorded (at least 1 .rodata name + 1 .data counter)
    if nc.relocs.count < 2 { return false }
    // Check that we have both kind_code=2 (rodata) and kind_code=3 (data) relocs
    var has_rodata = false
    var has_data = false
    var ri: i64 = 0
    while ri < nc.relocs.count {
        let r = nc.relocs.entries[ri as usize]
        if r.kind.kind_code == 2 { has_rodata = true }
        if r.kind.kind_code == 3 { has_data = true }
        ri = ri + 1
    }
    if !has_rodata { return false }
    if !has_data { return false }
    true
}

// Sprint 47: verify sprof_parse correctly parses a .sprof text buffer
fn compiler_main_test_sprof_parse() -> bool with Mut, Panic, Div {
    // Construct a buffer with "[sprof]\ntest_fn 42\n"
    var buf: [i8; 4096] = [0; 4096]
    // [sprof]\n = 91 115 112 114 111 102 93 10
    buf[0] = 91 as i8     // '['
    buf[1] = 115 as i8    // 's'
    buf[2] = 112 as i8    // 'p'
    buf[3] = 114 as i8    // 'r'
    buf[4] = 111 as i8    // 'o'
    buf[5] = 102 as i8    // 'f'
    buf[6] = 93 as i8     // ']'
    buf[7] = 10 as i8     // '\n'
    // test_fn 42\n = 116 101 115 116 95 102 110 32 52 50 10
    buf[8] = 116 as i8    // 't'
    buf[9] = 101 as i8    // 'e'
    buf[10] = 115 as i8   // 's'
    buf[11] = 116 as i8   // 't'
    buf[12] = 95 as i8    // '_'
    buf[13] = 102 as i8   // 'f'
    buf[14] = 110 as i8   // 'n'
    buf[15] = 32 as i8    // ' '
    buf[16] = 52 as i8    // '4'
    buf[17] = 50 as i8    // '2'
    buf[18] = 10 as i8    // '\n'
    let profile = sprof_parse(buf, 19)
    // Verify: 1 entry parsed
    if profile.entry_count != 1 { return false }
    // Verify: name is "test_fn" (7 chars)
    if profile.entries[0].fn_name.len != 7 { return false }
    // Verify: count is 42
    if profile.entries[0].count != 42 { return false }
    true
}

// Sprint 47: verify .sprof lookup and aggressive promotion on a hot function
fn compiler_main_test_sprof_promotion() -> bool with Alloc, Mut, Panic, Div {
    var profile = sprof_empty_profile()
    var entry = sprof_empty_entry()

    var hot_name = empty_name()
    hot_name.buf[0] = 104 as i8
    hot_name.buf[1] = 111 as i8
    hot_name.buf[2] = 116 as i8
    hot_name.len = 3

    entry.fn_name = hot_name
    entry.count = 1500
    profile.entries[0] = entry
    profile.entry_count = 1

    let count = sprof_lookup(&profile, &hot_name)
    if count != 1500 { return false }

    var miss = empty_name()
    miss.buf[0] = 120 as i8   // 'x'
    miss.len = 1
    let miss_count = sprof_lookup(&profile, &miss)
    if miss_count != -1 { return false }

    var module = ir_empty_module()
    var hot_fn = ir_empty_function()
    hot_fn.name = hot_name
    hot_fn.compile_strategy = IR_STRATEGY_STANDARD
    ir_fn_set(&! module, 0, hot_fn)
    module.fn_count = 1

    sprof_apply_promotion(&! module, &profile)
    if ir_fn_get(&module, 0).compile_strategy != IR_STRATEGY_AGGRESSIVE { return false }

    true
}

// Sprint 48: verify sprof_promotion_target thresholds
fn compiler_main_test_sprof_promotion_target_thresholds() -> bool {
    // Hot: 1500 → AGGRESSIVE (1)
    if sprof_promotion_target(1500) != IR_STRATEGY_AGGRESSIVE { return false }
    // Warm: 500 → PRECISION_PRESERVING (2)
    if sprof_promotion_target(500) != IR_STRATEGY_PRECISION_PRESERVING { return false }
    // Cold: 50 → -1 (no promotion)
    if sprof_promotion_target(50) != -1 { return false }
    // Boundary: 1000 → PRECISION (not AGGRESSIVE)
    if sprof_promotion_target(1000) != IR_STRATEGY_PRECISION_PRESERVING { return false }
    // Boundary: 100 → -1 (not PRECISION)
    if sprof_promotion_target(100) != -1 { return false }
    // Zero → -1
    if sprof_promotion_target(0) != -1 { return false }
    true
}

// Sprint 48: verify sprof_promotion_target returns -1 for negative/low counts
fn compiler_main_test_sprof_promotion_target_no_change() -> bool {
    if sprof_promotion_target(-1) != -1 { return false }
    if sprof_promotion_target(1) != -1 { return false }
    true
}

// Sprint 49: verify strategy-aware benefit boost in inline cost model
fn compiler_main_test_inline_strategy_boost() -> bool with Mut, Div, Panic {
    // Build a small leaf callee function
    var callee = ir_empty_function()
    var callee_name = empty_name()
    callee_name.buf[0] = 102 as i8  // 'f'
    callee_name.len = 1
    callee.name = callee_name
    callee.instr_count = 5
    callee.compile_strategy = 0  // STANDARD

    // Analyze with STANDARD strategy
    let info_std = inl_analyze_function(callee, 0)
    if info_std.compile_strategy != 0 { return false }

    // Analyze with AGGRESSIVE strategy
    callee.compile_strategy = 1
    let info_agg = inl_analyze_function(callee, 0)
    if info_agg.compile_strategy != 1 { return false }

    // Build context with the STANDARD callee
    var ctx_std = inl_context_new()
    ctx_std.func_infos[0] = info_std
    ctx_std.func_info_count = 1

    // Add a call site targeting callee 0
    var site = InlCallSite { caller_id: 1, callee_id: 0, call_instr_idx: 0, arg_count: 0, benefit_score: 0 }
    ctx_std.call_sites[0] = site
    ctx_std.call_site_count = 1

    let score_std = inl_compute_benefit(ctx_std, 0)

    // Build context with the AGGRESSIVE callee
    var ctx_agg = inl_context_new()
    ctx_agg.func_infos[0] = info_agg
    ctx_agg.func_info_count = 1
    ctx_agg.call_sites[0] = site
    ctx_agg.call_site_count = 1

    let score_agg = inl_compute_benefit(ctx_agg, 0)

    // AGGRESSIVE callee should have higher benefit
    if score_agg <= score_std { return false }
    // Difference should be exactly INL_STRATEGY_AGGRESSIVE_BONUS (80)
    if score_agg - score_std != 80 { return false }

    true
}

// Sprint 49: verify inl_run_pass returns valid module
fn compiler_main_test_inline_pass_returns_module() -> bool with Alloc, Mut, Div, Panic {
    var module = ir_empty_module()

    // Add a small callee function
    var callee = ir_empty_function()
    // #1649: ir_empty_function() hands back ir_region_invalid(), so every
    // ir_region_slot_w below would latch and land in QUARANTINE -- and two
    // functions in one test share those slots, so they silently overwrite
    // each other. Allocate a real region, as the lowerer does per function.
    ir_function_alloc_region(&! callee)
    var callee_name = empty_name()
    callee_name.buf[0] = 103 as i8  // 'g'
    callee_name.len = 1
    callee.name = callee_name
    ir_arena_store(ir_region_slot_w(callee.region, (0)), ir_return(0))
    callee.instr_count = 1
    callee.reg_count = 1
    ir_fn_set(&! module, 0, callee)

    // Add a caller function
    var caller = ir_empty_function()
    ir_function_alloc_region(&! caller)
    var caller_name = empty_name()
    caller_name.buf[0] = 109 as i8  // 'm'
    caller_name.len = 1
    caller.name = caller_name
    ir_arena_store(ir_region_slot_w(caller.region, (0)), ir_return(0))
    caller.instr_count = 1
    caller.reg_count = 1
    ir_fn_set(&! module, 1, caller)

    module.fn_count = 2

    let result = inl_run_pass(module)
    if result.fn_count != 2 { return false }

    true
}

// Sprint 50: verify layout_sort_by_profile reorders hot functions first
fn compiler_main_test_layout_sort_hot_first() -> bool with Alloc, Mut, Div, Panic {
    var module = ir_empty_module()

    // Function 0: "alpha" (count=10, cold)
    var f0 = ir_empty_function()
    // #1649: ir_empty_function() hands back ir_region_invalid(), so every
    // ir_region_slot_w below would latch and land in QUARANTINE -- and two
    // functions in one test share those slots, so they silently overwrite
    // each other. Allocate a real region, as the lowerer does per function.
    ir_function_alloc_region(&! f0)
    var n0 = empty_name()
    n0.buf[0] = 97 as i8   // 'a'
    n0.buf[1] = 108 as i8  // 'l'
    n0.buf[2] = 112 as i8  // 'p'
    n0.buf[3] = 104 as i8  // 'h'
    n0.buf[4] = 97 as i8   // 'a'
    n0.len = 5
    f0.name = n0
    ir_arena_store(ir_region_slot_w(f0.region, (0)), ir_return(0))
    f0.instr_count = 1
    f0.reg_count = 1
    ir_fn_set(&! module, 0, f0)

    // Function 1: "beta" (count=5000, hot)
    var f1 = ir_empty_function()
    ir_function_alloc_region(&! f1)
    var n1 = empty_name()
    n1.buf[0] = 98 as i8   // 'b'
    n1.buf[1] = 101 as i8  // 'e'
    n1.buf[2] = 116 as i8  // 't'
    n1.buf[3] = 97 as i8   // 'a'
    n1.len = 4
    f1.name = n1
    ir_arena_store(ir_region_slot_w(f1.region, (0)), ir_return(0))
    f1.instr_count = 1
    f1.reg_count = 1
    ir_fn_set(&! module, 1, f1)

    // Function 2: "gamma" (count=500, warm)
    var f2 = ir_empty_function()
    ir_function_alloc_region(&! f2)
    var n2 = empty_name()
    n2.buf[0] = 103 as i8  // 'g'
    n2.buf[1] = 97 as i8   // 'a'
    n2.buf[2] = 109 as i8  // 'm'
    n2.buf[3] = 109 as i8  // 'm'
    n2.buf[4] = 97 as i8   // 'a'
    n2.len = 5
    f2.name = n2
    ir_arena_store(ir_region_slot_w(f2.region, (0)), ir_return(0))
    f2.instr_count = 1
    f2.reg_count = 1
    ir_fn_set(&! module, 2, f2)

    module.fn_count = 3

    // Build profile: alpha=10, beta=5000, gamma=500
    var profile = sprof_empty_profile()
    var e0 = sprof_empty_entry()
    e0.fn_name = n0
    e0.count = 10
    profile.entries[0] = e0
    var e1 = sprof_empty_entry()
    e1.fn_name = n1
    e1.count = 5000
    profile.entries[1] = e1
    var e2 = sprof_empty_entry()
    e2.fn_name = n2
    e2.count = 500
    profile.entries[2] = e2
    profile.entry_count = 3

    let result = layout_sort_by_profile(module, &profile)

    // Must be reordered
    if !result.reordered { return false }

    // Order should be: beta (5000), gamma (500), alpha (10) — descending
    if !ir_name_eq(ir_fn_get(&result.module, 0).name, n1) { return false }
    if !ir_name_eq(ir_fn_get(&result.module, 1).name, n2) { return false }
    if !ir_name_eq(ir_fn_get(&result.module, 2).name, n0) { return false }

    // All 3 have positive counts → all hot
    if result.hot_count != 3 { return false }

    true
}

// Sprint 50: verify layout with empty profile preserves order
fn compiler_main_test_layout_sort_no_profile() -> bool with Alloc, Mut, Div, Panic {
    var module = ir_empty_module()

    // Function 0: "xx"
    var f0 = ir_empty_function()
    // #1649: ir_empty_function() hands back ir_region_invalid(), so every
    // ir_region_slot_w below would latch and land in QUARANTINE -- and two
    // functions in one test share those slots, so they silently overwrite
    // each other. Allocate a real region, as the lowerer does per function.
    ir_function_alloc_region(&! f0)
    var n0 = empty_name()
    n0.buf[0] = 120 as i8  // 'x'
    n0.buf[1] = 120 as i8  // 'x'
    n0.len = 2
    f0.name = n0
    ir_arena_store(ir_region_slot_w(f0.region, (0)), ir_return(0))
    f0.instr_count = 1
    f0.reg_count = 1
    ir_fn_set(&! module, 0, f0)

    // Function 1: "yy"
    var f1 = ir_empty_function()
    ir_function_alloc_region(&! f1)
    var n1 = empty_name()
    n1.buf[0] = 121 as i8  // 'y'
    n1.buf[1] = 121 as i8  // 'y'
    n1.len = 2
    f1.name = n1
    ir_arena_store(ir_region_slot_w(f1.region, (0)), ir_return(0))
    f1.instr_count = 1
    f1.reg_count = 1
    ir_fn_set(&! module, 1, f1)

    module.fn_count = 2

    // Empty profile — no counts for either function
    let profile = sprof_empty_profile()

    let result = layout_sort_by_profile(module, &profile)

    // Should NOT be reordered (both have count -1, stable sort preserves order)
    if result.reordered { return false }

    // Names should be unchanged
    if !ir_name_eq(ir_fn_get(&result.module, 0).name, n0) { return false }
    if !ir_name_eq(ir_fn_get(&result.module, 1).name, n1) { return false }

    true
}

// Sprint 51: verify the cleanup const-fold step folds a constant binop
fn compiler_main_test_cp_folds_constant() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 3)                      // r0 = 3
    instrs[1] = ir_load_imm(1, 4)                      // r1 = 4
    instrs[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)    // r2 = r0 + r1 = 7
    instrs[3] = ir_return(2)
    var func = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    cp_check_load_imm(&result, 2, 7)
}

// Sprint 51: verify DCE removes a dead instruction
fn compiler_main_test_dce_removes_dead() -> bool with Mut, Div, Panic {
    var instrs = dce_empty_instrs()
    instrs[0] = ir_load_imm(0, 42)   // r0 = 42 (used by return)
    instrs[1] = ir_load_imm(1, 99)   // r1 = 99 (dead, never used)
    instrs[2] = ir_return(0)
    var func = dce_make_test_func(instrs, 3)
    let result = dce_optimize_function(func)
    dce_check_nop(&result, 1)
}

// Sprint 52: verify regalloc assigns a preg when register pressure is low (1 vreg, 1 preg)
fn compiler_main_test_regalloc_assigns_preg() -> bool with Mut, Div, Panic {
    // Build: r0 = 3, r1 = r0 + 4, return r1
    var ra_instrs: [RaSimpleInstr; 4096] = [ra_empty_simple_instr(); 4096]
    ra_instrs[0 as usize] = ra_simple_instr(0, -1, -1)   // r0 = imm (def r0)
    ra_instrs[1 as usize] = ra_simple_instr(1, 0, -1)    // r1 = r0 + imm (def r1, use r0)
    ra_instrs[2 as usize] = ra_simple_instr(-1, 1, -1)   // return r1 (use r1)
    var state = liveness_compute_intervals(ra_instrs, 3)
    state = regalloc_linear_scan(state, 1)
    // r0 and r1 don't overlap fully — at least one should get preg 0
    let a0 = regalloc_get_assignment(state, 0)
    let a1 = regalloc_get_assignment(state, 1)
    // At least one should be assigned (not spilled)
    if a0 < 0 && a1 < 0 { return false }
    // The allocator should not report any conflicts
    regalloc_verify_no_conflicts(state)
}

// Sprint 52: verify regalloc spills when pressure exceeds available registers
fn compiler_main_test_regalloc_spills_under_pressure() -> bool with Mut, Div, Panic {
    // Build: 6 live intervals all overlapping (start 0, end 10), only 1 preg
    var ra_instrs: [RaSimpleInstr; 4096] = [ra_empty_simple_instr(); 4096]
    var i = 0
    while i < 6 {
        ra_instrs[i as usize] = ra_simple_instr(i, -1, -1)
        i = i + 1
    }
    // Add uses so intervals extend to pos 10
    var j = 6
    while j < 12 {
        let vreg = j - 6
        ra_instrs[j as usize] = ra_simple_instr(-1, vreg, -1)
        j = j + 1
    }
    var state = liveness_compute_intervals(ra_instrs, 12)
    state = regalloc_linear_scan(state, 1)
    // With 6 overlapping vregs and 1 preg, at least 5 must be spilled
    let spilled = regalloc_count_spilled(state)
    if spilled < 5 { return false }
    // vreg_spill_slots should be valid for spilled vregs
    var v = 0
    while v < 6 {
        if regalloc_is_spilled(state, v) {
            let slot = regalloc_get_spill_slot(state, v)
            if slot < 0 { return false }
        }
        v = v + 1
    }
    true
}

