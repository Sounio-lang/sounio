    let opt = opt_cleanup_function(func)
    (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (4))) as usize] as BinaryOp) == BinaryOp::OpMul
}
fn compiler_main_test_ct_no_fold_plain_sub() -> bool with Mut, Div, Panic {
