    instrs[2] = ir_binop(3, 0, BinaryOp::OpAdd, 2)
    instrs[3] = ir_return(3)
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_sink_loads(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (0))) as usize] == 5
}

// T313: Next uses the dst → no swap
fn compiler_main_test_sink_loads_no_swap_adjacent_use() -> bool with Mut, Div, Panic {
