// Self-test dispatcher part 10/10: split out of run_compiler_main_self_tests
// because the monolithic body lowered to 33829 IR instructions, past IR_MAX_INSTRS.
// Each part stays far under the IR cap and under the DCE/const-prop 8192 caps,
// so every analysis pass remains complete on every part (no refusal, no truncation).
fn compiler_main_self_tests_part_10(passed_in: i64) -> i64 with IO, Mut, Panic, Div, Alloc {
    var passed = passed_in
    if compiler_main_test_es_no_fold_sub_outer() {
        passed = passed + 1
        println("  T1080 OK: Sprint 235 Block ES: (r0&r1)-(r0^r1) no fold sub outer")
    } else { println("  FAIL: T1080") }
    if compiler_main_test_es_no_fold_or_inner() {
        passed = passed + 1
        println("  T1081 OK: Sprint 235 Block ES: (r0|r1)+(r0^r1) no ES fold or inner")
    } else { println("  FAIL: T1081") }

    // Sprint 234 Block ER: Complement-AND add to OR (T1070-T1075)
    if compiler_main_test_er_comp_and_add_or_basic() {
        passed = passed + 1
        println("  T1070 OK: Sprint 234 Block ER: r0+(~r0&r1) -> r0|r1")
    } else { println("  FAIL: T1070") }
    if compiler_main_test_er_comp_and_add_or_comm_add() {
        passed = passed + 1
        println("  T1071 OK: Sprint 234 Block ER: (~r0&r1)+r0 -> r0|r1 comm add")
    } else { println("  FAIL: T1071") }
    if compiler_main_test_er_comp_and_add_or_inner_comm() {
        passed = passed + 1
        println("  T1072 OK: Sprint 234 Block ER: r0+(r1&~r0) -> r0|r1 inner comm")
    } else { println("  FAIL: T1072") }
