        } else {
            compiler_manifest_print_name_json(compiler_manifest_empty_name())
        }
        print(", \"route_name\": ")
        compiler_manifest_print_name_json((*ep).observed_transitions[i].route_name)
        print(", \"rollback_route_name\": ")
        compiler_manifest_print_name_json((*ep).observed_transitions[i].rollback_route_name)
