    instrs[3] = ir_binop(4, 2, BinaryOp::OpBitAnd, 3)   // r4 = ~a & (b|a) → ~a & b
    instrs[4] = ir_return(4)
    let func = cp_make_test_func(instrs, 5)
    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (3))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(opt.region, (3))) as usize] as BinaryOp) == BinaryOp::OpBitAnd
        && IR_A_SRC1[(ir_region_slot_r(opt.region, (3))) as usize] == 2 && IR_A_SRC2[(ir_region_slot_r(opt.region, (3))) as usize] == 1
}


// Sprint 133: Block AU — XOR operand cancellation (T482-T487)

// T482: (a^b)^(a^c)→b^c  [lhs-lhs match: common factor a]
