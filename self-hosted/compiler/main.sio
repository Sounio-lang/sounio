        print("\", \"policy_id\": ")
        print_int((*ep).alternative_frontiers[i].alternative_policy_id)
        print(", \"policy_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_alternative_policy_name(ep, (*ep).alternative_frontiers[i].alternative_policy_id))
        print(", \"audit_id\": ")
        print_int((*ep).alternative_frontiers[i].audit_id)
        print(", \"audit_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_audit_name(ep, (*ep).alternative_frontiers[i].audit_id))
        print(", \"contest_id\": ")
        print_int((*ep).alternative_frontiers[i].contest_id)
        print(", \"source_policy_id\": ")
        print_int((*ep).alternative_frontiers[i].source_policy_id)
        print(", \"source_policy_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_recourse_policy_name(ep, (*ep).alternative_frontiers[i].source_policy_id))
        print(", \"source_plan_id\": ")
        print_int((*ep).alternative_frontiers[i].source_plan_id)
        print(", \"candidate_start\": ")
        print_int((*ep).alternative_frontiers[i].candidate_start)
        print(", \"candidate_count\": ")
        print_int((*ep).alternative_frontiers[i].candidate_count)
        print("}")
        i = i + 1
    }
    print("\n    ],\n")

    print("    \"alternative_sets\": [\n")
    i = 0
    while i < (*ep).alternative_set_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int((*ep).alternative_sets[i].id)
        print(", \"frontier_id\": ")
        print_int((*ep).alternative_sets[i].frontier_id)
        print(", \"frontier_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_alternative_frontier_name(ep, (*ep).alternative_sets[i].frontier_id))
        print(", \"audit_id\": ")
        print_int((*ep).alternative_sets[i].audit_id)
        print(", \"audit_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_audit_name(ep, (*ep).alternative_sets[i].audit_id))
        print(", \"contest_id\": ")
        print_int((*ep).alternative_sets[i].contest_id)
        print(", \"inner_type\": \"")
        compiler_manifest_print_type_name((*ep).alternative_sets[i].inner_ty)
        print("\", \"candidate_start\": ")
        print_int((*ep).alternative_sets[i].candidate_start)
        print(", \"candidate_count\": ")
        print_int((*ep).alternative_sets[i].candidate_count)
        print("}")
        i = i + 1
    }
    print("\n    ],\n")

    print("    \"alternative_candidates\": [\n")
    i = 0
    while i < (*ep).alternative_candidate_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int((*ep).alternative_candidates[i].id)
        print(", \"frontier_id\": ")
        print_int((*ep).alternative_candidates[i].frontier_id)
        print(", \"frontier_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_alternative_frontier_name(ep, (*ep).alternative_candidates[i].frontier_id))
        print(", \"candidate_name\": ")
        compiler_manifest_print_name_json((*ep).alternative_candidates[i].name)
        print(", \"value_repr\": ")
        compiler_manifest_print_name_json((*ep).alternative_candidates[i].value_repr)
        print(", \"source_kind\": ")
        compiler_manifest_print_string_json(compiler_manifest_alternative_source_kind_name((*ep).alternative_candidates[i].source_kind))
        print(", \"source_policy_id\": ")
        print_int((*ep).alternative_candidates[i].source_policy_id)
        print(", \"source_policy_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_recourse_policy_name(ep, (*ep).alternative_candidates[i].source_policy_id))
        print(", \"source_plan_id\": ")
        print_int((*ep).alternative_candidates[i].source_plan_id)
        print(", \"strategy_name\": ")
        compiler_manifest_print_name_json((*ep).alternative_candidates[i].strategy_name)
        print(", \"route_name\": ")
        compiler_manifest_print_name_json((*ep).alternative_candidates[i].route_name)
        print(", \"audit_id\": ")
        print_int((*ep).alternative_candidates[i].audit_id)
        print(", \"audit_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_audit_name(ep, (*ep).alternative_candidates[i].audit_id))
        print(", \"contest_id\": ")
        print_int((*ep).alternative_candidates[i].contest_id)
        print(", \"metric_snapshot\": {")
        print("\"intervention_cost\": ")
        compiler_manifest_print_f64_json((*ep).alternative_candidates[i].intervention_cost)
        print(", \"residual_tail_risk\": ")
        compiler_manifest_print_f64_json((*ep).alternative_candidates[i].residual_tail_risk)
        print(", \"mechanistic_divergence\": ")
        compiler_manifest_print_f64_json((*ep).alternative_candidates[i].mechanistic_divergence)
        print(", \"admissibility_margin\": ")
        compiler_manifest_print_f64_json((*ep).alternative_candidates[i].admissibility_margin)
        print("}")
        print(", \"dominance_rank\": ")
        print_int((*ep).alternative_candidates[i].dominance_rank)
        print("}")
        i = i + 1
    }
    print("\n    ]\n")

    print("  }\n")
    print("}\n")
}

fn compiler_load_manifest_epistemic(path: string) -> CompilerManifestLoadResult with IO, Mut, Panic, Div, Alloc {
    var merged_epistemic = ir_empty_epistemic_section()
    let frontend_result = load_multimodule_epistemic_into(path, &!merged_epistemic)
    if !frontend_result.ok {
        var check_errors = compile_errors_new()
        check_errors = compile_push_ir_failure(check_errors, frontend_result.error_msg)
        return compiler_manifest_load_result_error(check_errors)
    }
    compiler_manifest_load_result_ok(merged_epistemic)
}

fn compile_emit_manifest_json_from_source(path: string) -> CompileResult with IO, Mut, Panic, Div, Alloc {
    let manifest_result = compiler_load_manifest_epistemic(path)
    if !manifest_result.ok {
        return CompileResult { success: false, errors: manifest_result.errors, output: "" }
    }

    compiler_emit_manifest_json(path, &manifest_result.epistemic)
    CompileResult {
        success: true,
        errors: compile_errors_new(),
        output: "stdout",
    }
}

// ============================================================================
// COMPILATION PIPELINE
// ============================================================================

fn compile(opts: CompilerOptions) -> CompileResult with IO, Mut, Panic, Div, Alloc {
    if !file_exists(opts.input_file) {
        var file_errors = compile_errors_new()
        file_errors = compile_errors_push(file_errors, compile_format_error_at(opts.input_file, 0, 0, "could not read input file"))
        return CompileResult {
            success: false,
            errors: file_errors,
            output: "",
        }
    }

    let incomplete_assign = compile_scan_incomplete_assignment(opts.input_file)
    if incomplete_assign.0 >= 0 {
        var parse_like_errors = compile_errors_new()
        parse_like_errors = compile_errors_push(
            parse_like_errors,
            compile_format_error_at(opts.input_file, incomplete_assign.0, incomplete_assign.1, "syntax appears incomplete after assignment")
        )
        return CompileResult {
            success: false,
            errors: parse_like_errors,
            output: "",
        }
    }

    if !compiler_visibility_preflight(opts.input_file) {
        var visibility_errors = compile_errors_new()
        // The preflight covers three distinct failures — a module that will not
        // parse, an AST closure that could not be completed, and a type error
        // across the merged modules — and this one message described only the
        // stage. run_check_mode prints which of the three it was just above; say
        // that here too, so the final line a user sees is not misleading on its own.
        visibility_errors = compile_errors_push(visibility_errors, "error: preflight failed (parse, module closure, or type check — see run_check_mode output above)")
        return CompileResult {
            success: false,
            errors: visibility_errors,
            output: "",
        }
    }

    if opts.emit_manifest {
        return compile_emit_manifest_json_from_source(opts.input_file)
    }

    if str_eq(opts.target, "llvm") {
        let llvm_exit = compile_multimodule_llvm(opts.input_file, opts.output_file, opts.optimize)
        if llvm_exit == 0 {
            return CompileResult {
                success: true,
                errors: compile_errors_new(),
                output: opts.output_file,
            }
        }

        var llvm_errors = compile_errors_new()
        llvm_errors = compile_errors_push(llvm_errors, "error: multimodule llvm compilation failed")
        return CompileResult {
            success: false,
            errors: llvm_errors,
            output: "",
        }
    }

    let early_frontend_preflight = preflight_multimodule_frontend(opts.input_file)
    let early_preflight_parse_errors = parser_last_error_count()
    if !early_frontend_preflight.ok || early_preflight_parse_errors > 0 {
        compiler_print_ir_preflight_failure(early_frontend_preflight.error_msg)
        var early_type_errors = compile_errors_new()
        early_type_errors = compile_errors_push(early_type_errors, "error: type checking preflight failed")
        return CompileResult {
            success: false,
            errors: early_type_errors,
            output: "",
        }
    }

    let main_prog = load_module_file(opts.input_file)
    let main_imports = extract_imports_from_ast(main_prog)
    let requested_target_spec = native_resolve_target(opts.target, "auto", false)
    if main_imports.count > 0 &&
       requested_target_spec.arch_id == ARCH_X86_64() &&
       requested_target_spec.os_id == OS_LINUX() &&
       !str_eq(opts.target, "wasm") {
        let thin_exit = compile_multimodule_native_advanced(
            opts.input_file,
            opts.output_file,
            opts.target,
            "auto",
            false,
            opts.gpu_target,
            opts.gpu_binary_format,
            opts.gpu_strict_parity,
            opts.optimize,
            opts.use_profile,
            opts.use_profile_path,
            opts.cache_dir,
            opts.cache_mode,
            opts.cache_stats
        )
        if thin_exit == 0 {
            return CompileResult {
                success: true,
                errors: compile_errors_new(),
                output: opts.output_file,
            }
        }

        var thin_errors = compile_errors_new()
        thin_errors = compile_errors_push(thin_errors, "error: multimodule native thin-link compilation failed")
        return CompileResult {
            success: false,
            errors: thin_errors,
            output: "",
        }
    }

    // Preflight load catches parse/module-resolution failures early and avoids
    // driving native compilation on obviously invalid inputs.
    var ir_result = load_multimodule_ir(opts.input_file)
    let preflight_parse_errors = parser_last_error_count()
    if !ir_result.ok || preflight_parse_errors > 0 {
        var preflight_errors = compile_errors_new()
        if !ir_result.ok {
            preflight_errors = compile_push_ir_failure(preflight_errors, ir_result.error_msg)
        }
        if preflight_parse_errors > 0 {
            preflight_errors = compile_errors_push(preflight_errors, "error: parser reported " + int_to_string(preflight_parse_errors) + " syntax errors")
        }
        if preflight_errors.len == 0 {
            preflight_errors = compile_errors_push(preflight_errors, "error: compilation preflight failed")
        }
        return CompileResult {
            success: false,
            errors: preflight_errors,
            output: "",
        }
    }

    // Sprint 50: hoist profile for layout pass
    var has_valid_profile = false
    var loaded_profile = sprof_empty_profile()

    // Sprint 47: apply .sprof profile-guided strategy promotion
    if opts.use_profile {
        let prof_size = file_size(opts.use_profile_path)
        if prof_size > 0 {
            let prof_bytes = read_file(opts.use_profile_path)
            var prof_buf: [i8; 4096] = [0; 4096]
            var pi: i64 = 0
            while pi < prof_size && pi < 4096 {
                prof_buf[pi as usize] = prof_bytes[pi as usize]
                pi = pi + 1
            }
            let profile = sprof_parse(prof_buf, prof_size)
            sprof_apply_promotion(&! (*ir_result.module), &profile)

            // Sprint 48: log promotion decisions
            var li: i64 = 0
            while li < (*ir_result.module).fn_count {
                let lcount = sprof_lookup(&profile, &(*ir_result.module).functions[li as usize].name)
                let ltarget = sprof_promotion_target(lcount)
                if ltarget >= 0 {
                    print("[sprof] ")
                    compiler_manifest_print_name((*ir_result.module).functions[li as usize].name)
                    println(": count " + int_to_string(lcount) + " -> strategy " + ir_strategy_name(ltarget))
                }
                li = li + 1
            }

            loaded_profile = profile
            has_valid_profile = true
        }
    }

    // Sprint 49: Apply inlining pass when -O is set
    // By-value opt passes densify temporarily; re-box to keep MultiModuleIrResult boxed.
    if opts.optimize {
        let pre_inline_count = (*ir_result.module).fn_count
        ir_result.module = Box::new(inl_run_pass(*ir_result.module))
        println("[inline] pass complete: " + int_to_string(pre_inline_count) + " functions processed")
    }

    // Sprint 50: Profile-guided function layout
    if has_valid_profile {
        let layout_result = layout_sort_by_profile(*ir_result.module, &loaded_profile)
        ir_result.module = Box::new(layout_result.module)
        if layout_result.reordered {
            println("[layout] reordered " + int_to_string((*ir_result.module).fn_count) + " functions (" + int_to_string(layout_result.hot_count) + " hot, " + int_to_string(layout_result.cold_count) + " cold)")
        }
    }

    // Sprint 51: const_fold + DCE cleanup after inlining
    if opts.optimize {
        let pre_opt_count = (*ir_result.module).fn_count
        ir_result.module = Box::new(opt_cleanup_module(*ir_result.module))
        println("[opt] const_prop + dce applied to " + int_to_string(pre_opt_count) + " functions")
        let loop_result = lopt_optimize_module(*ir_result.module)
        ir_result.module = Box::new(loop_result.module)
        if loop_result.functions_changed > 0 {
            println("[loop] hoisted " + int_to_string(loop_result.invariants_hoisted) +
                    " invariants across " + int_to_string(loop_result.functions_changed) + " functions")
        }
        ir_result.module = Box::new(opt_cleanup_module(*ir_result.module))
    }

    // Sprint 54: Tail call optimization
    if opts.optimize {
        let tco_result = tco_run_pass(*ir_result.module)
        ir_result.module = Box::new(tco_result.0)
        let tco_ctx = tco_result.1
        if tco_ctx.stats.transformed > 0 {
            println("[tco] " + int_to_string(tco_ctx.stats.transformed) + " tail call(s) converted to loops")
        }
    }

    // compile_multimodule_native_with_ir still takes IrModule by value.
    let exit_code = compile_multimodule_native_with_ir(
        opts.input_file,
        *ir_result.module,
        opts.output_file,
        opts.target,
        "auto",
        false,
        opts.gpu_target,
        opts.gpu_binary_format,
        opts.gpu_strict_parity
    )

    if exit_code == 0 {
        return CompileResult {
            success: true,
            errors: compile_errors_new(),
            output: opts.output_file,
        }
    }

    // Diagnostic replay path: preserve compile_multimodule_native behavior while
    // collecting structured messages for callers.
    var errors = compile_errors_new()
    if !ir_result.ok {
        errors = compile_push_ir_failure(errors, ir_result.error_msg)
    } else {
        let target_spec = native_resolve_target(opts.target, "auto", false)
        let native_result = compile_native(&(*ir_result.module), target_spec)
        if !native_result.ok {
            errors = compile_errors_push_lines(errors, "error: ", native_result.error_msg)
        }
    }

    let parse_errors = parser_last_error_count()
    if parse_errors > 0 {
        errors = compile_errors_push(errors, "error: parser reported " + int_to_string(parse_errors) + " syntax errors")
    }
    if errors.len == 0 {
        errors = compile_errors_push(errors, "error: compilation failed (no structured diagnostics captured)")
    }

    CompileResult {
        success: false,
        errors: errors,
        output: "",
    }
}






fn compiler_main_native_byte_u8(b: i8) -> i64 {
    let x = b as i64
    if x < 0 { x + 256 } else { x }
}

fn compiler_main_native_code_eq(a: CodeBuffer, b: CodeBuffer) -> bool with Mut {
    if a.len != b.len { return false }
    var i: i64 = 0
    while i < a.len {
        if compiler_main_native_byte_u8(a.bytes[i as usize]) != compiler_main_native_byte_u8(b.bytes[i as usize]) {
            return false
        }
        i = i + 1
    }
    true
}

fn compiler_main_native_find_pattern4(
    buf: CodeBuffer, b0: i64, b1: i64, b2: i64, b3: i64
) -> i64 with Mut {
    if buf.len < 4 { return -1 }
    var i: i64 = 0
    while i <= buf.len - 4 {
        if compiler_main_native_byte_u8(buf.bytes[i as usize]) == b0 &&
           compiler_main_native_byte_u8(buf.bytes[(i + 1) as usize]) == b1 &&
           compiler_main_native_byte_u8(buf.bytes[(i + 2) as usize]) == b2 &&
           compiler_main_native_byte_u8(buf.bytes[(i + 3) as usize]) == b3 {
            return i
        }
        i = i + 1
    }
    -1
}

fn compiler_main_find_fn(m: IrModule, name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < m.fn_count {
        if ir_name_eq(m.functions[i].name, name) {
            return i
        }
        i = i + 1
    }
    -1
}

fn compiler_main_find_call_idx(f: IrFunction, callee_name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < f.instr_count {
        if f.instrs[i].op == IrOpcode::IrCall &&
           ir_name_eq(ir_name_at(f.instrs[i].name_id), callee_name) {
            return i
        }
        i = i + 1
    }
    -1
}

fn compiler_main_has_load_imm_dst_value(f: IrFunction, dst: i64, value: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < f.instr_count {
        if f.instrs[i].op == IrOpcode::IrLoadImm &&
           f.instrs[i].dst == dst &&
           f.instrs[i].imm_i64 == value {
            return true
        }
        i = i + 1
    }
    false
}









