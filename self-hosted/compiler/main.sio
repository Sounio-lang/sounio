fn pkg_print_help() with IO {
    println("Sounio Package Manager (SPM) v0.1.0")
    println("")
    println("Usage: souc pkg <subcommand> [options]")
    println("")
    println("Subcommands:")
    println("  init [--science]      Create a new sounio.toml")
    println("  build [path]          Validate and package the project")
    println("  audit [path]          Science-boundary guidance")
    println("  install <name[@ver]>  Install a package")
    println("  publish [--dry-run]   Report local publication prerequisites (disabled)")
    println("  info <name>           Show package metadata")
    println("  self-test             Run SPM internal tests")
    println("")
    println("Shorthand commands:")
    println("  souc install <name>[@<version>]")
    println("  souc search <query>")
    println("")
    println("Scientific authority is declared by ring, claim contract, and receipt.")
}

fn pkg_run_init(science: bool) with IO {
    println("Sounio Package Manager (SPM) v0.1.0")
    println("")
    if science {
        println("Creating sounio.toml (science boundary template)...")
        println("")
        println("[package]")
        println("name = \"my-science-pkg\"")
        println("version = \"0.1.0\"")
        println("edition = \"2026\"")
        println("authors = [\"Your Name\"]")
        println("license = \"Apache-2.0\"")
        println("description = \"A scientific Sounio package\"")
        println("")
        println("[science]")
        println("schema = \"sounio.science-manifest.v1\"")
        println("ring = \"scientific-package-candidate\"")
        println("evidence-status = \"implemented\"")
        println("context-of-use = \"declare the bounded research use here\"")
        println("visibility = \"public\"")
        println("allowed-claim-classes = [\"compile\", \"runtime\"]")
        println("evidence-refs = [\"gate:package-boundary-receipt\"]")
        println("next-gate = \"package-boundary-receipt\"")
        println("review-state = \"draft\"")
        println("")
        println("[dependencies]")
        println("epistemic-core = \"0.7\"")
        println("")
        println("[lib]")
        println("name = \"my_science_pkg\"")
        println("path = \"src/lib.sio\"")
        println("")
        println("[[example]]")
        println("name = \"basic_usage\"")
        println("path = \"examples/basic.sio\"")
        println("maturity = \"implemented\"")
        println("context-of-use = \"declare the bounded research use here\"")
        println("evidence-refs = [\"source:examples/basic.sio\"]")
        println("")
        println("[[test]]")
        println("name = \"science_e2e\"")
        println("path = \"tests/test_science_e2e.sio\"")
    } else {
        println("Creating sounio.toml (basic template)...")
        println("")
        println("[package]")
        println("name = \"my-sounio-pkg\"")
        println("version = \"0.1.0\"")
        println("edition = \"2026\"")
        println("authors = [\"Your Name\"]")
        println("license = \"Apache-2.0\"")
        println("description = \"A Sounio package\"")
        println("")
        println("[dependencies]")
        println("")
        println("[lib]")
        println("path = \"src/lib.sio\"")
        println("")
        println("Tip: use --science for an explicit scientific boundary template.")
    }
    println("")
    println("Next steps:")
    println("  1. Edit sounio.toml")
    println("  2. Implement src/lib.sio")
    println("  3. souc pkg build")
    println("  4. souc pkg audit")
}

