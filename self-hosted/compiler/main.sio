        println("  FAIL: T116 copy-prop + left-constant SR interop")
    }

    if compiler_main_test_egraph_op_constants() {
        println("  T117 OK: egraph op constants: CONST=1 VAR=2 ADD=3 SUB=4 MUL=5")
