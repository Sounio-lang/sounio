    let opt = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(opt.region, (2))) as usize] as IrOpcode) == IrOpcode::IrLoadImm
        && IR_A_IMM_I64[(ir_region_slot_r(opt.region, (2))) as usize] == 0
}

fn compiler_main_test_dn_sub_sub_reverse() -> bool with Mut, Div, Panic {
