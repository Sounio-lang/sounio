    instrs[0] = ir_load_imm(1, 5)
    instrs[1] = ir_label(0)
    instrs[2] = ir_return(1)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_sink_loads(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLabel
}

// T315: Next uses dst as src1 → no swap
fn compiler_main_test_sink_loads_no_swap_src1() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 5)
    instrs[1] = ir_binop(2, 1, BinaryOp::OpAdd, 0)
    instrs[2] = ir_return(2)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_sink_loads(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrLoadImm
}

// T316: Sinks past independent binop
fn compiler_main_test_sink_loads_swap_past_binop() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(3, 99)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs[2] = ir_binop(4, 2, BinaryOp::OpMul, 3)
    instrs[3] = ir_return(4)
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_sink_loads(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrBinOp && (IR_A_OP[(ir_region_slot_r(result.region, (1))) as usize] as IrOpcode) == IrOpcode::IrLoadImm
}

// T317: No IrLoadImm → no-op
fn compiler_main_test_sink_loads_noop() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs[1] = ir_return(2)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_sink_loads(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrBinOp
}

