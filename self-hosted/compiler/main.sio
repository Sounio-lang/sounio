// ============================================================================
// Sprint 62: 4-preg register allocation self-tests (T30-T37)
// ============================================================================

// T30: preg_to_x86_reg maps all 4 pregs correctly
fn compiler_main_test_multipreg_map() -> bool {
    if preg_to_x86_reg(0) != 15 { return false }  // r15
    if preg_to_x86_reg(1) != 14 { return false }  // r14
    if preg_to_x86_reg(2) != 13 { return false }  // r13
    if preg_to_x86_reg(3) != 12 { return false }  // r12
    true
}

// T31: 2 non-overlapping vregs → 2 pregs assigned, 0 spilled
fn compiler_main_test_multipreg_two_fit() -> bool with Mut, Div, Panic {
    var ra_instrs: [RaSimpleInstr; 4096] = [ra_empty_simple_instr(); 4096]
    ra_instrs[0 as usize] = ra_simple_instr(0, -1, -1)
    ra_instrs[1 as usize] = ra_simple_instr(-1, 0, -1)
    ra_instrs[2 as usize] = ra_simple_instr(1, -1, -1)
    ra_instrs[3 as usize] = ra_simple_instr(-1, 1, -1)
    var state = liveness_compute_intervals(ra_instrs, 4)
    state = regalloc_linear_scan(state, 4)
    let spilled = regalloc_count_spilled(state)
    if spilled != 0 { return false }
    let assigned = regalloc_count_assigned(state)
    if assigned < 2 { return false }
    regalloc_verify_no_conflicts(state)
}

// T32: 4 non-overlapping vregs → all 4 pregs used, 0 spilled
fn compiler_main_test_multipreg_four_fit() -> bool with Mut, Div, Panic {
    var ra_instrs: [RaSimpleInstr; 4096] = [ra_empty_simple_instr(); 4096]
    var i = 0
    while i < 4 {
        ra_instrs[(i * 2) as usize]     = ra_simple_instr(i, -1, -1)
        ra_instrs[(i * 2 + 1) as usize] = ra_simple_instr(-1, i, -1)
        i = i + 1
    }
    var state = liveness_compute_intervals(ra_instrs, 8)
    state = regalloc_linear_scan(state, 4)
    let spilled = regalloc_count_spilled(state)
    if spilled != 0 { return false }
    let assigned = regalloc_count_assigned(state)
    if assigned < 4 { return false }
    regalloc_verify_no_conflicts(state)
}

// T33: 5 overlapping vregs with 4 pregs → exactly 1 spill
fn compiler_main_test_multipreg_spill_one() -> bool with Mut, Div, Panic {
    var ra_instrs: [RaSimpleInstr; 4096] = [ra_empty_simple_instr(); 4096]
    // Define all 5 at pos 0, use all at pos 1 (all live simultaneously)
    var i = 0
    while i < 5 {
        ra_instrs[i as usize] = ra_simple_instr(i, -1, -1)
        i = i + 1
    }
    var j = 5
    while j < 10 {
        ra_instrs[j as usize] = ra_simple_instr(-1, j - 5, -1)
        j = j + 1
    }
    var state = liveness_compute_intervals(ra_instrs, 10)
    state = regalloc_linear_scan(state, 4)
    let spilled = regalloc_count_spilled(state)
    if spilled < 1 { return false }
    regalloc_verify_no_conflicts(state)
}

// T34: prologue byte count == 12 with frame_size=0
fn compiler_main_test_multipreg_prologue_bytes() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = emit_prologue(buf, 0)
    // push_r15(2)+push_r14(2)+push_r13(2)+push_r12(2)+push_rbp(1)+mov_rbp_rsp(3) = 12
    buf.len == 12
}

// T35: prologue starts with push r15 (41 57) then push r14 (41 56)
fn compiler_main_test_multipreg_prologue_prefix() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = emit_prologue(buf, 0)
    if buf.bytes[0 as usize] != 0x41 as i8 { return false }
    if buf.bytes[1 as usize] != 0x57 as i8 { return false }  // push r15
    if buf.bytes[2 as usize] != 0x41 as i8 { return false }
    if buf.bytes[3 as usize] != 0x56 as i8 { return false }  // push r14
    true
}

// T36: epilogue byte count == 13; last byte == 0xC3 (RET)
fn compiler_main_test_multipreg_epilogue_bytes() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = emit_epilogue(buf)
    // mov_rsp_rbp(3)+pop_rbp(1)+pop_r12(2)+pop_r13(2)+pop_r14(2)+pop_r15(2)+ret(1) = 13
    if buf.len != 13 { return false }
    if buf.bytes[12 as usize] != 0xC3 as i8 { return false }
    true
}

// T37: regalloc_linear_scan(state, 4) produces valid state (regression + 4-preg)
fn compiler_main_test_multipreg_regalloc_four() -> bool with Mut, Div, Panic {
    var ra_instrs: [RaSimpleInstr; 4096] = [ra_empty_simple_instr(); 4096]
    ra_instrs[0 as usize] = ra_simple_instr(0, -1, -1)
    ra_instrs[1 as usize] = ra_simple_instr(-1, 0, -1)
    var state = liveness_compute_intervals(ra_instrs, 2)
    state = regalloc_linear_scan(state, 4)
    let a0 = regalloc_get_assignment(state, 0)
    if a0 < 0 { return false }  // must be assigned (not spilled)
    regalloc_verify_no_conflicts(state)
}

// ============================================================================
// Sprint 54: TCO wiring self-tests (T38-T45)
// ============================================================================

// T38: tco_is_tail_position detects call immediately before return
fn compiler_main_test_tco_tail_position() -> bool with Mut, Div, Panic {
    let func = tco_make_self_tail_call_func(0, 0, 1)
    var call_idx: i64 = 0
    var si: i64 = 0
    while si < func.instr_count {
        if tco_is_call(ir_arena_load(ir_region_slot_r(func.region, (si)))) { call_idx = si }
        si = si + 1
    }
    tco_is_tail_position(func, call_idx)
}

// T39: tco_is_self_call detects fn_id matching function's own id
fn compiler_main_test_tco_is_self_call() -> bool with Mut, Div, Panic {
    let func = tco_make_self_tail_call_func(0, 0, 1)
    var call_idx: i64 = 0
    var si: i64 = 0
    while si < func.instr_count {
        if tco_is_call(ir_arena_load(ir_region_slot_r(func.region, (si)))) { call_idx = si }
        si = si + 1
    }
    tco_is_self_call(func, call_idx)
}

// T40: tco_run_pass transforms self-recursive tail call (stats.transformed == 1)
fn compiler_main_test_tco_run_pass_transforms() -> bool with Alloc, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    funcs[0 as usize] = tco_make_self_tail_call_func(0, 2, 0)
    let module = tco_make_test_module(funcs, 1)
    let result = tco_run_pass(module)
    let out_module = result.0
    let ctx = result.1
    let out_func = ir_fn_get(&out_module, 0)
    var saw_jump = false
    var saw_self_call = false
    var i: i64 = 0
    while i < out_func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(out_func.region, (i)))
        if instr.op == IrOpcode::IrJump {
            saw_jump = true
        }
        if instr.op == IrOpcode::IrCall && ir_name_eq(ir_name_at(instr.name_id), out_func.name) {
            saw_self_call = true
        }
        i = i + 1
    }
    (ctx.stats.transformed > 0 || saw_jump) && !saw_self_call
}

// T41: tco_run_pass leaves non-tail call unchanged (stats.transformed == 0)
fn compiler_main_test_tco_run_pass_no_transform() -> bool with Alloc, Mut, Div, Panic {
    let target_name = tco_make_func_name(103 as i8, 1)
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    funcs[0 as usize] = tco_make_non_tail_call_func(0, target_name, 1)
    funcs[1 as usize] = tco_make_test_func(1, 3)
    let module = tco_make_test_module(funcs, 2)
    let result = tco_run_pass(module)
    let ctx = result.1
    ctx.stats.transformed == 0
}

// T42: tco_check_eligibility rejects function with IrAlloc
fn compiler_main_test_tco_eligibility_alloc() -> bool with Mut, Div, Panic {
    let func = tco_make_func_with_alloca(0)
    let info = tco_analyze_function(func, 0)
    let check = tco_check_eligibility(func, info)
    let eligible = check.0
    !eligible
}

// T43: tco_analyze_function populates correct func_id
fn compiler_main_test_tco_analyze_function() -> bool with Mut, Div, Panic {
    let func = tco_make_self_tail_call_func(7, 0, 0)
    let info = tco_analyze_function(func, 7)
    info.func_id == 7
}

// T44: tco_count_tail_calls_for_func returns 1 for single self-tail call
fn compiler_main_test_tco_count_tail_calls() -> bool with Alloc, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    funcs[0 as usize] = tco_make_self_tail_call_func(0, 0, 0)
    let module = tco_make_test_module(funcs, 1)
    var ctx = tco_context_new()
    ctx = tco_discover_tail_calls(ctx, module)
    let count = tco_count_tail_calls_for_func(ctx, 0)
    count == 1
}

// T45: tco_run_pass on empty module returns fn_count unchanged
fn compiler_main_test_tco_empty_module() -> bool with Alloc, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let module = tco_make_test_module(funcs, 0)
    let result = tco_run_pass(module)
    let out_module = result.0
    out_module.fn_count == 0
}

// ============================================================================
// Sprint 63: Adaptive stack slot encoding self-tests (T49-T56)
// ============================================================================

// T49: ir_slot_fits_disp8 returns true for offset -8 (vreg 0)
fn compiler_main_test_disp8_fits_vreg0() -> bool {
    ir_slot_fits_disp8(-8)
}

// T50: ir_slot_fits_disp8 returns true for offset -128 (vreg 15, boundary)
fn compiler_main_test_disp8_fits_boundary() -> bool {
    ir_slot_fits_disp8(-128)
}

// T51: ir_slot_fits_disp8 returns false for offset -136 (vreg 16, beyond disp8)
fn compiler_main_test_disp8_no_fit_vreg16() -> bool {
    !ir_slot_fits_disp8(-136)
}

// T52: emit_load_rbp_disp8_rax emits 4 bytes: 0x48 0x8B 0x45 0xF8 (disp=-8)
fn compiler_main_test_disp8_load_bytes() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = emit_load_rbp_disp8_rax(buf, -8)
    if buf.len != 4 { return false }
    if buf.bytes[0 as usize] != 0x48 as i8 { return false }
    if buf.bytes[1 as usize] != 0x8b as i8 { return false }
    if buf.bytes[2 as usize] != 0x45 as i8 { return false }
    if buf.bytes[3 as usize] != 0xf8 as i8 { return false }  // low8(-8) = 0xF8
    true
}

// T53: emit_store_rax_rbp_disp8 emits 4 bytes: 0x48 0x89 0x45 0xF0 (disp=-16)
fn compiler_main_test_disp8_store_bytes() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = emit_store_rax_rbp_disp8(buf, -16)
    if buf.len != 4 { return false }
    if buf.bytes[0 as usize] != 0x48 as i8 { return false }
    if buf.bytes[1 as usize] != 0x89 as i8 { return false }
    if buf.bytes[2 as usize] != 0x45 as i8 { return false }
    if buf.bytes[3 as usize] != 0xf0 as i8 { return false }  // low8(-16) = 0xF0
    true
}

// T54: emit_load_rbp_disp32_rax still emits 7 bytes (regression)
fn compiler_main_test_disp32_load_len() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = emit_load_rbp_disp32_rax(buf, -8)
    buf.len == 7
}

// T55: emit_store_rax_rbp_disp32 still emits 7 bytes (regression)
fn compiler_main_test_disp32_store_len() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = emit_store_rax_rbp_disp32(buf, -8)
    buf.len == 7
}

// T56: ir_slot_fits_disp8 agrees with ir_slot_offset for vreg boundary (15 fits, 16 doesn't)
fn compiler_main_test_disp8_slot_boundary() -> bool {
    if !ir_slot_fits_disp8(ir_slot_offset(15)) { return false }
    if ir_slot_fits_disp8(ir_slot_offset(16)) { return false }
    true
}

// T57: native v2 runtime context layout is language-visible and deopt-ready
// precise_stack_maps is honestly false here (scripts/ci/precise_stack_maps_honesty_gate.sh):
// the current stack-map recorder marks every live temp as a GC root
// (root_temp_counts == temp_count) rather than deriving roots from regalloc
// liveness, so this contract asserts the honest value instead of the prior
// unconditional true.
fn compiler_main_test_native_v2_runtime_context_contract() -> bool with Mut, Panic, Div {
    let layout = native_v2_runtime_context_layout()
    if !layout.language_visible { return false }
    if !layout.tracing_gc { return false }
    if layout.precise_stack_maps { return false }
    if !layout.safepoints { return false }
    if !layout.deopt_enabled { return false }
    if !layout.osr_enabled { return false }
    if native_v2_runtime_context_group_count() != 7 { return false }
    if !str_eq(native_v2_runtime_context_group_name(0), "gc_heap") { return false }
    if !str_eq(native_v2_runtime_context_group_name(6), "provenance") { return false }
    native_v2_runtime_context_total_fields(layout) >= 21
}

// T58: native v2 x86 policy exposes reserved + allocatable pools explicitly
fn compiler_main_test_native_v2_target_policy_x86() -> bool with IO, Mut, Panic, Div {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let summary = native_v2_target_policy_summary(spec)
    if !native_v2_target_contract_supported(spec) { return false }
    if summary.reserved_count != 3 { return false }
    if summary.allocatable_count != 4 { return false }
    if summary.scratch_count != 5 { return false }
    if !summary.emitter_ready { return false }
    if !str_eq(native_v2_target_policy_group_name(spec, NATIVE_V2_POLICY_GROUP_RESERVED(), 2), "rbx") { return false }
    if !str_eq(native_v2_target_policy_group_name(spec, NATIVE_V2_POLICY_GROUP_ALLOCATABLE(), 0), "r12") { return false }
    if !str_eq(native_v2_target_policy_group_name(spec, NATIVE_V2_POLICY_GROUP_RETURNS(), 0), "rax") { return false }
    true
}

// T59: native v2 aarch64 policy is present for the full reserved/allocatable contract
fn compiler_main_test_native_v2_target_policy_aarch64() -> bool with IO, Mut, Panic, Div {
    let mac_spec = native_resolve_target("aarch64-macos", "auto", true)
    let linux_spec = native_resolve_target("aarch64-linux", "auto", true)
    let mac_summary = native_v2_target_policy_summary(mac_spec)
    let linux_summary = native_v2_target_policy_summary(linux_spec)
    if !native_v2_target_contract_supported(mac_spec) { return false }
    if !native_v2_target_contract_supported(linux_spec) { return false }
    if mac_summary.reserved_count != 4 || linux_summary.reserved_count != 4 { return false }
    if mac_summary.allocatable_count != 10 || linux_summary.allocatable_count != 10 { return false }
    if mac_summary.arg_count != 8 || linux_summary.arg_count != 8 { return false }
    if !mac_summary.emitter_ready || !linux_summary.emitter_ready { return false }
    if !str_eq(native_v2_target_policy_group_name(mac_spec, NATIVE_V2_POLICY_GROUP_RESERVED(), 3), "x18") { return false }
    if !str_eq(native_v2_target_policy_group_name(linux_spec, NATIVE_V2_POLICY_GROUP_RESERVED(), 3), "x18") { return false }
    if !str_eq(native_v2_target_policy_group_name(mac_spec, NATIVE_V2_POLICY_GROUP_ALLOCATABLE(), 0), "x19") { return false }
    if !str_eq(native_v2_target_policy_group_name(linux_spec, NATIVE_V2_POLICY_GROUP_ALLOCATABLE(), 0), "x19") { return false }
    if !str_eq(native_v2_target_policy_group_name(mac_spec, NATIVE_V2_POLICY_GROUP_ALLOCATABLE(), 9), "x28") { return false }
    if !str_eq(native_v2_target_policy_group_name(linux_spec, NATIVE_V2_POLICY_GROUP_ALLOCATABLE(), 9), "x28") { return false }
    if !str_eq(native_v2_target_policy_group_name(mac_spec, NATIVE_V2_POLICY_GROUP_ARGS(), 0), "x0") { return false }
    if !str_eq(native_v2_target_policy_group_name(linux_spec, NATIVE_V2_POLICY_GROUP_ARGS(), 0), "x0") { return false }
    true
}

// T60: native v2 machine module reports tiering + deopt substrate
fn compiler_main_test_native_v2_machine_shadow_module() -> bool with IO, Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let module = compiler_main_make_native_v2_scalar_module(7)
    let machine = native_v2_shadow_machine_module(&module, spec)
    if machine.fn_count != 1 { return false }
    if machine.ir_instr_count != 2 { return false }
    if machine.machine_instr_count <= machine.ir_instr_count { return false }
    if !machine.active { return false }
    if machine.target_count != 1 { return false }
    if !str_eq(machine.coverage, "scalar_core") { return false }
    if !machine.fail_closed { return false }
    if machine.legacy_fallback { return false }
    if machine.optimized_tier_count != 2 { return false }
    if !machine.has_runtime_context { return false }
    if !machine.supports_stack_maps { return false }
    if !machine.supports_deopt { return false }
    if !machine.supports_osr { return false }
    machine.target_arch_id == ARCH_X86_64()
}

// T61: native v2 contract writer emits a JSON artifact
fn compiler_main_test_native_v2_shadow_contract_write() -> bool with IO, Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let path = "artifacts/omega/native_backend_v2_contract.selftest.json"
    let module = compiler_main_make_native_v2_scalar_module(11)
    if !native_v2_write_contract(path, &module, spec, true, ERR_OK(), "selftest") { return false }
    let size = file_size(path)
    if size <= 0 { return false }
    let data = read_file(path)
    data[0 as usize] == (123 as i8)
}

// ============================================================================
// Sprint 64: Compact frame sizing self-tests (T62-T69)
// ============================================================================

// T62: nc_min_frame_size returns 0 for empty function (reg_count=0)
fn compiler_main_test_frame_trim_empty() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    var func = ir_empty_function()
    func.reg_count = 0
    nc_min_frame_size(nc, func) == 0
}

// T63: nc_min_frame_size returns 0 when all vregs preg-allocated
fn compiler_main_test_frame_trim_all_preg() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    nc.vreg_to_preg[0 as usize] = 15   // r15
    nc.vreg_to_preg[1 as usize] = 14   // r14
    var func = ir_empty_function()
    func.reg_count = 2
    nc_min_frame_size(nc, func) == 0
}

// T64: nc_min_frame_size returns 16 for 1 spilled vreg at index 0 (align16(8)=16)
fn compiler_main_test_frame_trim_one_spill() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    nc.vreg_to_preg[0 as usize] = -1   // RA_SPILLED
    var func = ir_empty_function()
    func.reg_count = 1
    nc_min_frame_size(nc, func) == 16
}

// T65: nc_min_frame_size returns 32 when highest stack vreg is index 3
fn compiler_main_test_frame_trim_vreg3_stack() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    nc.vreg_to_preg[0 as usize] = 15   // preg-alloc
    nc.vreg_to_preg[1 as usize] = 14   // preg-alloc
    nc.vreg_to_preg[2 as usize] = 13   // preg-alloc
    nc.vreg_to_preg[3 as usize] = -1   // RA_SPILLED (highest stack vreg)
    var func = ir_empty_function()
    func.reg_count = 4
    nc_min_frame_size(nc, func) == 32
}

// T66: nc_min_frame_size returns 16 when middle vreg is spilled, higher is preg-alloc
fn compiler_main_test_frame_trim_middle_spill() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    nc.vreg_to_preg[0 as usize] = 15   // preg-alloc
    nc.vreg_to_preg[1 as usize] = -1   // RA_SPILLED
    nc.vreg_to_preg[2 as usize] = 14   // preg-alloc (higher index, no slot needed)
    var func = ir_empty_function()
    func.reg_count = 3
    nc_min_frame_size(nc, func) == 16
}

// T67: nc_min_frame_size returns 0 for 4 preg-alloc vregs (all 4 callee-saved registers used)
fn compiler_main_test_frame_trim_four_preg() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    nc.vreg_to_preg[0 as usize] = 15   // r15
    nc.vreg_to_preg[1 as usize] = 14   // r14
    nc.vreg_to_preg[2 as usize] = 13   // r13
    nc.vreg_to_preg[3 as usize] = 12   // r12
    var func = ir_empty_function()
    func.reg_count = 4
    nc_min_frame_size(nc, func) == 0
}

// T68: nc_min_frame_size returns 48 for spilled vreg at index 4 (align16(40)=48)
fn compiler_main_test_frame_trim_vreg4_spill() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    nc.vreg_to_preg[0 as usize] = 15
    nc.vreg_to_preg[1 as usize] = 14
    nc.vreg_to_preg[2 as usize] = 13
    nc.vreg_to_preg[3 as usize] = 12
    nc.vreg_to_preg[4 as usize] = -1   // RA_SPILLED
    var func = ir_empty_function()
    func.reg_count = 5
    nc_min_frame_size(nc, func) == 48
}

// T69: nc_min_frame_size handles param vreg (preg=-2 RA_UNASSIGNED) as needing stack slot
fn compiler_main_test_frame_trim_param_vreg() -> bool with Mut, Panic, Div {
    var nc = compiler_new()
    nc.vreg_to_preg[0 as usize] = -2   // RA_UNASSIGNED (param)
    nc.vreg_to_preg[1 as usize] = 15   // preg-alloc
    var func = ir_empty_function()
    func.reg_count = 2
    nc_min_frame_size(nc, func) == 16
}

// T70: used allocatable preg mask tracks only r12-r15 assignments
fn compiler_main_test_used_allocatable_preg_mask() -> bool with Mut {
    var nc = compiler_new()
    nc.vreg_to_preg[0 as usize] = 15
    nc.vreg_to_preg[1 as usize] = 12
    nc.vreg_to_preg[2 as usize] = -1
    nc.vreg_to_preg[3 as usize] = 0
    nc_used_allocatable_preg_mask(nc, 4) == (X86_ALLOCATABLE_R12_MASK() | X86_ALLOCATABLE_R15_MASK())
}

// T71: odd allocatable-save counts add an 8-byte alignment pad before calls
fn compiler_main_test_frame_align_for_saved_pregs() -> bool with Mut, Panic {
    if x86_align_frame_size_for_calls(0, X86_ALLOCATABLE_R15_MASK()) != 8 { return false }
    if x86_align_frame_size_for_calls(16, X86_ALLOCATABLE_R15_MASK() | X86_ALLOCATABLE_R14_MASK()) != 16 { return false }
    true
}

// T72: native v2 x86 contract publishes an explicit allocation order
fn compiler_main_test_native_v2_x86_allocation_order_contract() -> bool with IO, Mut, Panic, Div {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    if native_v2_target_policy_group_count(spec, NATIVE_V2_POLICY_GROUP_ALLOCATION_ORDER()) != 4 { return false }
    if !str_eq(native_v2_target_policy_group_name(spec, NATIVE_V2_POLICY_GROUP_ALLOCATION_ORDER(), 0), "r15") { return false }
    if !str_eq(native_v2_target_policy_group_name(spec, NATIVE_V2_POLICY_GROUP_ALLOCATION_ORDER(), 3), "r12") { return false }
    true
}

// T73: lowering preg mapping is driven by the shared x86 allocation order
fn compiler_main_test_x86_allocation_order_drives_lowering() -> bool {
    if preg_to_x86_reg(0) != native_target_policy_x86_allocation_order_reg_id(0) { return false }
    if preg_to_x86_reg(1) != native_target_policy_x86_allocation_order_reg_id(1) { return false }
    if preg_to_x86_reg(3) != native_target_policy_x86_allocation_order_reg_id(3) { return false }
    true
}

fn compiler_main_make_native_v2_scalar_module(ret_value: i64) -> IrModule with Alloc, Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    ir_function_alloc_region(&! func)
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, ret_value))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_return(0))
    func.instr_count = 2
    func.reg_count = 1
    ir_fn_set(&! module, 0, func)
    module.fn_count = 1
    module
}

fn compiler_main_make_native_v2_call_module() -> IrModule with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    var helper = ir_empty_function()
    ir_function_alloc_region(&! helper)
    helper.name = ir_name_from_bytes(104, 101, 108, 112, 4)
    helper.param_count = 1
    helper.param_regs[0] = 0
    helper.reg_count = 3
    ir_arena_store(ir_region_slot_w(helper.region, (0)), ir_load_imm(1, 2))
    ir_arena_store(ir_region_slot_w(helper.region, (1)), ir_binop(2, 0, BinaryOp::OpMul, 1))
    ir_arena_store(ir_region_slot_w(helper.region, (2)), ir_return(2))
    helper.instr_count = 3
    ir_fn_set(&! module, 0, helper)

    var main_fn = ir_empty_function()
    ir_function_alloc_region(&! main_fn)
    main_fn.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    main_fn.reg_count = 2
    ir_arena_store(ir_region_slot_w(main_fn.region, (0)), ir_load_imm(0, 3))
    ir_arena_store(ir_region_slot_w(main_fn.region, (1)), ir_call(1, 0, helper.name, Some(Box::new(ir_reg_list_single(0))), 1))
    ir_arena_store(ir_region_slot_w(main_fn.region, (2)), ir_return(1))
    main_fn.instr_count = 3
    ir_fn_set(&! module, 1, main_fn)

    module.fn_count = 2
    module
}

// Build a Name from up to 10 explicit bytes (enough for "str_len"/"str_char_at"/
// string literals used by the string-builtin witnesses). Bytes beyond `len` are
// ignored. Uses ir_empty_name() then sets buf entries directly (ir_name_from_bytes
// only carries 4 bytes, too short for "str_len").
fn native_v2_name_bytes10(len: i64, b0: i64, b1: i64, b2: i64, b3: i64, b4: i64, b5: i64, b6: i64, b7: i64, b8: i64, b9: i64) -> Name with Mut, Panic, Div {
    var n = ir_empty_name()
    n.len = len
    if len > 0 { n.buf[0] = b0 as i8 }
    if len > 1 { n.buf[1] = b1 as i8 }
    if len > 2 { n.buf[2] = b2 as i8 }
    if len > 3 { n.buf[3] = b3 as i8 }
    if len > 4 { n.buf[4] = b4 as i8 }
    if len > 5 { n.buf[5] = b5 as i8 }
    if len > 6 { n.buf[6] = b6 as i8 }
    if len > 7 { n.buf[7] = b7 as i8 }
    if len > 8 { n.buf[8] = b8 as i8 }
    if len > 9 { n.buf[9] = b9 as i8 }
    n
}

// "str_len" name (7 bytes): s t r _ l e n
fn native_v2_name_str_len() -> Name with Mut, Panic, Div {
    native_v2_name_bytes10(7, 115, 116, 114, 95, 108, 101, 110, 0, 0, 0)
}

// "str_char_at" name (11 bytes) — exceeds the 10-byte helper, so build directly.
fn native_v2_name_str_char_at() -> Name with Mut, Panic, Div {
    var n = ir_empty_name()
    n.len = 11
    n.buf[0]  = 115 as i8  // s
    n.buf[1]  = 116 as i8  // t
    n.buf[2]  = 114 as i8  // r
    n.buf[3]  = 95 as i8   // _
    n.buf[4]  = 99 as i8   // c
    n.buf[5]  = 104 as i8  // h
    n.buf[6]  = 97 as i8   // a
    n.buf[7]  = 114 as i8  // r
    n.buf[8]  = 95 as i8   // _
    n.buf[9]  = 97 as i8   // a
    n.buf[10] = 116 as i8  // t
    n
}

// String-builtin witness: str_len("hello") = 5.
//   fn str_len(s) -> <builtin>             (functions[0], emitted by builtin dispatch)
//   fn main() -> { s = "hello"; return str_len(s) }   (functions[1])
// This is the exact shape that previously SIGSEGV'd the native-v2 emitter:
// an IrLoadString (rodata) PLUS a string-builtin call in the same module.
fn compiler_main_make_native_v2_str_len_module() -> IrModule with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    var str_len_fn = ir_empty_function()
    ir_function_alloc_region(&! str_len_fn)
    str_len_fn.name = native_v2_name_str_len()
    str_len_fn.param_count = 1
    str_len_fn.param_regs[0] = 0
    str_len_fn.reg_count = 2
    str_len_fn.instr_count = 0
    ir_fn_set(&! module, 0, str_len_fn)

    let str_len_name = native_v2_name_str_len()
    // "hello" = 104 101 108 108 111 (5 bytes)
    let hello = native_v2_name_bytes10(5, 104, 101, 108, 108, 111, 0, 0, 0, 0, 0)

    var main_fn = ir_empty_function()
    ir_function_alloc_region(&! main_fn)
    main_fn.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    main_fn.param_count = 0
    main_fn.reg_count = 3
    ir_arena_store(ir_region_slot_w(main_fn.region, (0)), ir_load_string(0, 0, hello))
    ir_arena_store(ir_region_slot_w(main_fn.region, (1)), ir_call(1, 0, str_len_name, Some(Box::new(ir_reg_list_single(0))), 1))
    ir_arena_store(ir_region_slot_w(main_fn.region, (2)), ir_return(1))
    main_fn.instr_count = 3
    ir_fn_set(&! module, 1, main_fn)

    module.fn_count = 2
    module
}

// String-builtin witness: str_char_at("hello", 1) = 'e' = 101.
