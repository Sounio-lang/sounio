// T208: r0=7, r1=-r0, r2=-r1 → r2 const 7 (double negation chain via const-prop).
fn compiler_main_test_unary_double_neg_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 7)
    instrs[1] = ir_unaryop(1, UnaryOp::OpNeg, 0)
    instrs[2] = ir_unaryop(2, UnaryOp::OpNeg, 1)
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    let ok = result.instrs[2].op == IrOpcode::IrLoadImm && result.instrs[2].imm_i64 == 7
    if !ok {
        println("DBG T208:")
        print("  i0 op="); if result.instrs[0].op == IrOpcode::IrLoadImm { print("loadimm") } else if result.instrs[0].op == IrOpcode::IrUnaryOp { print("unary") } else if result.instrs[0].op == IrOpcode::IrCopy { print("copy") } else { print("other") }; print(" src1="); print_int(result.instrs[0].src1); print(" imm="); print_int(result.instrs[0].imm_i64); print("\n")
        print("  i1 op="); if result.instrs[1].op == IrOpcode::IrLoadImm { print("loadimm") } else if result.instrs[1].op == IrOpcode::IrUnaryOp { print("unary") } else if result.instrs[1].op == IrOpcode::IrCopy { print("copy") } else { print("other") }; print(" src1="); print_int(result.instrs[1].src1); print(" imm="); print_int(result.instrs[1].imm_i64); print(" un="); if result.instrs[1].un_op == UnaryOp::OpNeg { print("neg") } else if result.instrs[1].un_op == UnaryOp::OpNot { print("not") } else { print("other") }; print("\n")
        print("  i2 op="); if result.instrs[2].op == IrOpcode::IrLoadImm { print("loadimm") } else if result.instrs[2].op == IrOpcode::IrUnaryOp { print("unary") } else if result.instrs[2].op == IrOpcode::IrCopy { print("copy") } else { print("other") }; print(" src1="); print_int(result.instrs[2].src1); print(" imm="); print_int(result.instrs[2].imm_i64); print(" un="); if result.instrs[2].un_op == UnaryOp::OpNeg { print("neg") } else if result.instrs[2].un_op == UnaryOp::OpNot { print("not") } else { print("other") }; print("\n")
    }
    ok
}

// T209: OpNeg on non-const source → no fold (stays IrUnaryOp).
fn compiler_main_test_unary_neg_nonconst() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    // r0 is a parameter (not loaded by IrLoadImm), so unknown
    instrs[0] = ir_unaryop(1, UnaryOp::OpNeg, 0)
    let func   = cp_make_test_func(instrs, 1)
    let result = ocp_const_fold(func)
    result.instrs[0].op == IrOpcode::IrUnaryOp
}

// Sprint 83 Block K: IrLoadBool constant tracking self-tests (T214–T219)

// T214: IrLoadBool(true) + BranchTrue(bool_reg, L) → IrJump(L) via Block F chain.
fn compiler_main_test_loadbool_true_branch_true() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_bool(0, true)
    instrs[1] = ir_branch_true(0, 42)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrJump && result.instrs[1].label_id == 42
}

// T215: IrLoadBool(false) + BranchTrue(bool_reg, L) → IrNop (not taken).
fn compiler_main_test_loadbool_false_branch_true() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_bool(0, false)
    instrs[1] = ir_branch_true(0, 42)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrNop
}

// T216: IrLoadBool(false) + BranchFalse(bool_reg, L) → IrJump(L) (false==0 → taken).
fn compiler_main_test_loadbool_false_branch_false() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_bool(0, false)
    instrs[1] = ir_branch_false(0, 99)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrJump && result.instrs[1].label_id == 99
}

// T217: IrLoadBool(true) + BranchFalse(bool_reg, L) → IrNop (true!=0 → not taken).
fn compiler_main_test_loadbool_true_branch_false() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_bool(0, true)
    instrs[1] = ir_branch_false(0, 99)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrNop
}

// T218: IrLoadBool(true) + IrBinOp(Add, bool_reg, imm_3) → IrLoadImm(4).
fn compiler_main_test_loadbool_binop_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_bool(0, true)
    instrs[1] = ir_load_imm(1, 3)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    result.instrs[2].op == IrOpcode::IrLoadImm && result.instrs[2].imm_i64 == 4
}

// T219: IrLoadBool(false) + IrBinOp(Mul, imm_7, bool_reg) → IrLoadImm(0).
fn compiler_main_test_loadbool_mul_annihilate() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 7)
    instrs[1] = ir_load_bool(1, false)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    let func   = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    result.instrs[2].op == IrOpcode::IrLoadImm && result.instrs[2].imm_i64 == 0
}

// Sprint 84 Block L: Associative constant-chain folding self-tests (T220–T225)

// T220: (r0+3)+5 → r0+8 via Block L add-chain fold.
fn compiler_main_test_assoc_add_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 3)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpAdd, 1)   // r2 = r0 + 3
    instrs[2] = ir_load_imm(3, 5)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpAdd, 3)   // r4 = r2 + 5 → r0 + 8
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    // r3 (const reg) should be patched to 8; r4's src1 should be r0 (reg 0)
    result.instrs[3].op == IrOpcode::IrBinOp
        && result.instrs[3].src1 == 0
        && result.instrs[2].imm_i64 == 8
}

// T221: (r0*2)*4 → r0*8 via Block L mul-chain fold.
fn compiler_main_test_assoc_mul_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 2)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)   // r2 = r0 * 2
    instrs[2] = ir_load_imm(3, 4)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpMul, 3)   // r4 = r2 * 4 → r0 * 8
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    let ok = result.instrs[3].op == IrOpcode::IrBinOp
        && result.instrs[3].src1 == 0
        && result.instrs[2].imm_i64 == 8
    if !ok {
        println("DBG T221:")
        print("  i0 op="); if result.instrs[0].op == IrOpcode::IrLoadImm { print("loadimm") } else { print("other") }; print(" imm="); print_int(result.instrs[0].imm_i64); print("\n")
        print("  i1 op="); if result.instrs[1].op == IrOpcode::IrBinOp { print("binop") } else if result.instrs[1].op == IrOpcode::IrCopy { print("copy") } else if result.instrs[1].op == IrOpcode::IrLoadImm { print("loadimm") } else { print("other") }; print(" dst="); print_int(result.instrs[1].dst); print(" src1="); print_int(result.instrs[1].src1); print(" src2="); print_int(result.instrs[1].src2); print(" bin="); if result.instrs[1].bin_op == BinaryOp::OpMul { print("mul") } else if result.instrs[1].bin_op == BinaryOp::OpShl { print("shl") } else if result.instrs[1].bin_op == BinaryOp::OpAdd { print("add") } else { print("other") }; print("\n")
        print("  i2 op="); if result.instrs[2].op == IrOpcode::IrLoadImm { print("loadimm") } else { print("other") }; print(" imm="); print_int(result.instrs[2].imm_i64); print("\n")
        print("  i3 op="); if result.instrs[3].op == IrOpcode::IrBinOp { print("binop") } else if result.instrs[3].op == IrOpcode::IrCopy { print("copy") } else if result.instrs[3].op == IrOpcode::IrLoadImm { print("loadimm") } else { print("other") }; print(" dst="); print_int(result.instrs[3].dst); print(" src1="); print_int(result.instrs[3].src1); print(" src2="); print_int(result.instrs[3].src2); print(" bin="); if result.instrs[3].bin_op == BinaryOp::OpMul { print("mul") } else if result.instrs[3].bin_op == BinaryOp::OpShl { print("shl") } else if result.instrs[3].bin_op == BinaryOp::OpAdd { print("add") } else { print("other") }; print("\n")
    }
    ok
}

// T222: (r0 & 0xFF) & 0x0F → r0 & 0x0F via Block L bitand-chain fold.
fn compiler_main_test_assoc_bitand_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 255)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitAnd, 1)  // r2 = r0 & 0xFF
    instrs[2] = ir_load_imm(3, 15)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpBitAnd, 3)  // r4 = r2 & 0x0F → r0 & 0x0F
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    result.instrs[3].op == IrOpcode::IrBinOp
        && result.instrs[3].src1 == 0
        && result.instrs[2].imm_i64 == 15
}

// T223: (r0 | 0x80) | 0x40 → r0 | 0xC0 via Block L bitor-chain fold.
fn compiler_main_test_assoc_bitor_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 128)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitOr, 1)   // r2 = r0 | 0x80
    instrs[2] = ir_load_imm(3, 64)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpBitOr, 3)   // r4 = r2 | 0x40 → r0 | 0xC0
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    result.instrs[3].op == IrOpcode::IrBinOp
        && result.instrs[3].src1 == 0
        && result.instrs[2].imm_i64 == 192
}

// T224: (r0 ^ 5) ^ 3 → r0 ^ 6 via Block L bitxor-chain fold (5^3=6).
fn compiler_main_test_assoc_bitxor_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 5)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpBitXor, 1)  // r2 = r0 ^ 5
    instrs[2] = ir_load_imm(3, 3)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpBitXor, 3)  // r4 = r2 ^ 3 → r0 ^ 6
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    result.instrs[3].op == IrOpcode::IrBinOp
        && result.instrs[3].src1 == 0
        && result.instrs[2].imm_i64 == 6
}

// T225: (r0-3)-5 → no Block L fold (OpSub not in assoc set).
fn compiler_main_test_assoc_non_assoc_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 3)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpSub, 1)     // r2 = r0 - 3
    instrs[2] = ir_load_imm(3, 5)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpSub, 3)     // r4 = r2 - 5 (no fold)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    // r4 should still be r2-5 (unchanged: src1=r2, not patched to r0)
    result.instrs[3].op == IrOpcode::IrBinOp && result.instrs[3].src1 == 2
}

// Sprint 86 Block M: Negation arithmetic self-tests (T230–T235)

// T230: x * (-1) → IrBinOp(Sub, r_zero, x) — mul by -1 becomes 0-x.
fn compiler_main_test_neg_mul_minus_one() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, -1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrBinOp && result.instrs[1].bin_op == BinaryOp::OpSub
}

// T231: x / (-1) → IrBinOp(Sub, r_zero, x) — div by -1 becomes 0-x.
fn compiler_main_test_neg_div_minus_one() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, -1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpDiv, 1)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrBinOp && result.instrs[1].bin_op == BinaryOp::OpSub
}

// T232: x % (-1) → IrLoadImm(0) — remainder by -1 is always 0.
fn compiler_main_test_neg_rem_minus_one() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, -1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpRem, 1)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrLoadImm && result.instrs[1].imm_i64 == 0
}

// T233: neg(neg(x)) → IrCopy(x) — double negation eliminated.
fn compiler_main_test_neg_double_neg() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_unaryop(1, UnaryOp::OpNeg, 0)
    instrs[1] = ir_unaryop(2, UnaryOp::OpNeg, 1)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrCopy && result.instrs[1].src1 == 0
}

// T234: neg(x) single — no double-neg fold, stays as IrUnaryOp(Neg).
fn compiler_main_test_neg_single_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_unaryop(1, UnaryOp::OpNeg, 0)
    let func   = cp_make_test_func(instrs, 1)
    let result = ocp_const_fold(func)
    result.instrs[0].op == IrOpcode::IrUnaryOp && result.instrs[0].un_op == UnaryOp::OpNeg
}

// T235: (-1) * x → IrBinOp(Sub, r_zero, x) — commutative flip (s1 is const -1).
fn compiler_main_test_neg_commut_mul_minus_one() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, -1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    let func   = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrBinOp && result.instrs[1].bin_op == BinaryOp::OpSub
}

// ============================================================================
// Sprint 87 Block N — IrLoadImm deduplication tests (T236-T241)
// ============================================================================

// T236: two IrLoadImm with same value → second becomes IrCopy of first.
fn compiler_main_test_dedup_same_value() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 7)
    instrs[1] = ir_load_imm(1, 7)
    let func   = cp_make_test_func(instrs, 2)
    let result = opt_cleanup_function(func)
    result.instrs[1].op == IrOpcode::IrCopy && result.instrs[1].src1 == 0
}

// T237: two IrLoadImm with different values → no dedup.
fn compiler_main_test_dedup_diff_values() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 7)
    instrs[1] = ir_load_imm(1, 8)
    let func   = cp_make_test_func(instrs, 2)
    let result = opt_cleanup_function(func)
    result.instrs[1].op == IrOpcode::IrLoadImm && result.instrs[1].imm_i64 == 8
}

// T238: dedup + downstream const-fold: r0=7, r1=7 (dedup→IrCopy), r2=r0+r1 → IrLoadImm(14).
fn compiler_main_test_dedup_then_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 7)
    instrs[1] = ir_load_imm(1, 7)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    let func   = cp_make_test_func(instrs, 3)
    let result = opt_cleanup_function(func)
    result.instrs[2].op == IrOpcode::IrLoadImm && result.instrs[2].imm_i64 == 14
}

// T239: three occurrences of same constant → second and third both IrCopy of first.
fn compiler_main_test_dedup_triple() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 42)
    instrs[1] = ir_load_imm(1, 42)
    instrs[2] = ir_load_imm(2, 42)
    let func   = cp_make_test_func(instrs, 3)
    let result = opt_cleanup_function(func)
    result.instrs[1].op == IrOpcode::IrCopy && result.instrs[2].op == IrOpcode::IrCopy
}

// T240: dedup preserves first occurrence; r0 stays IrLoadImm.
fn compiler_main_test_dedup_first_kept() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 99)
    instrs[1] = ir_load_imm(1, 99)
    let func   = cp_make_test_func(instrs, 2)
    let result = opt_cleanup_function(func)
    result.instrs[0].op == IrOpcode::IrLoadImm && result.instrs[0].imm_i64 == 99
}

// T241: different constants interleaved → no cross-dedup.
fn compiler_main_test_dedup_no_cross() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 3)
    instrs[1] = ir_load_imm(1, 5)
    instrs[2] = ir_load_imm(2, 3)
    let func   = cp_make_test_func(instrs, 3)
    let result = opt_cleanup_function(func)
    // r1 stays IrLoadImm(5); r2 becomes IrCopy(0) because 3==3
    result.instrs[1].op == IrOpcode::IrLoadImm && result.instrs[2].op == IrOpcode::IrCopy
}

// ============================================================================
// Sprint 87: float IR opcode + native-v2 whitelist tests (T242–T245)
// ============================================================================

// T242: ir_load_float sets op=IrLoadFloat and stores bits correctly.
fn compiler_main_test_ir_load_float_opcode() -> bool with Mut, Div, Panic {
    let instr = ir_load_float(3, 1.5)
    instr.op == IrOpcode::IrLoadFloat && instr.dst == 3
}

// T243: ir_int_to_float sets op=IrIntToFloat with correct dst/src1.
fn compiler_main_test_ir_int_to_float_opcode() -> bool with Mut, Div, Panic {
    let instr = ir_int_to_float(5, 2)
    instr.op == IrOpcode::IrIntToFloat && instr.dst == 5 && instr.src1 == 2
}

// T244: ir_float_to_int sets op=IrFloatToInt with correct dst/src1.
fn compiler_main_test_ir_float_to_int_opcode() -> bool with Mut, Div, Panic {
    let instr = ir_float_to_int(7, 4)
    instr.op == IrOpcode::IrFloatToInt && instr.dst == 7 && instr.src1 == 4
}

// T245: native-v2 whitelist accepts all three new float opcodes.
fn compiler_main_test_native_v2_float_whitelist() -> bool with Mut, Div, Panic {
    native_v2_supported_ir_opcode(IrOpcode::IrLoadFloat) &&
    native_v2_supported_ir_opcode(IrOpcode::IrIntToFloat) &&
    native_v2_supported_ir_opcode(IrOpcode::IrFloatToInt)
}

// ============================================================================
// Sprint 88 Block O — mul-div cancellation tests (T246-T251)
// ============================================================================

// T246: r1=x*4; r2=r1/4 → r2=IrCopy(x).
fn compiler_main_test_muldiv_cancel_basic() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 4)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    instrs[2] = ir_load_imm(3, 4)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpDiv, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    result.instrs[3].op == IrOpcode::IrCopy && result.instrs[3].src1 == 0
}

// T247: r1=x*4; r2=r1/5 → no fold (4 ≠ 5).
fn compiler_main_test_muldiv_no_cancel_diff() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 4)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    instrs[2] = ir_load_imm(3, 5)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpDiv, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    result.instrs[3].op == IrOpcode::IrBinOp
}

// T248: r1=x*0 skipped (C=0 guard — zero mul not tracked).
fn compiler_main_test_muldiv_no_cancel_zero() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 0)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    instrs[2] = ir_load_imm(3, 0)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpDiv, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    // r2=x*0 folds to IrLoadImm(0); r4=0/0 not a muldiv cancel (C=0 guard)
    result.instrs[1].op == IrOpcode::IrLoadImm
}

// T249: r1=4*x (commutative) → r2=r1/4 → r2=IrCopy(x).
fn compiler_main_test_muldiv_cancel_commut() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 4)
    instrs[1] = ir_binop(2, 1, BinaryOp::OpMul, 0)
    instrs[2] = ir_load_imm(3, 4)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpDiv, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    result.instrs[3].op == IrOpcode::IrCopy && result.instrs[3].src1 == 0
}

// T250: r1=x+4 (add, not mul) → r2=r1/4 — no fold.
fn compiler_main_test_muldiv_no_cancel_non_mul() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 4)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs[2] = ir_load_imm(3, 4)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpDiv, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    result.instrs[3].op == IrOpcode::IrBinOp
}

// T251: r1=x*7; r2=r1/7; r3=r2+0 — r2=IrCopy(x), r3=IrCopy via identity.
fn compiler_main_test_muldiv_cancel_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 7)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    instrs[2] = ir_load_imm(3, 7)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpDiv, 3)
    instrs[4] = ir_load_imm(5, 0)
    instrs[5] = ir_binop(6, 4, BinaryOp::OpAdd, 5)
    let func   = cp_make_test_func(instrs, 6)
    let result = ocp_const_fold(func)
    result.instrs[3].op == IrOpcode::IrCopy && result.instrs[5].op == IrOpcode::IrCopy
}

// Sprint 89 Block P — add-sub/sub-add cancellation tests (T252-T257)
// (x + C) - C → IrCopy(x)  ;  (x - C) + C → IrCopy(x).
// SOTA: LLVM InstCombineAddSub.cpp; Muchnick §12.2.

// T252: r1 = x + 10; r2 = r1 - 10  →  r2 = IrCopy(x).
fn compiler_main_test_addsub_cancel_add_first() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 10)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs[2] = ir_load_imm(3, 10)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpSub, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    result.instrs[3].op == IrOpcode::IrCopy && result.instrs[3].src1 == 0
}

// T253: r1 = x - 7; r2 = r1 + 7  →  r2 = IrCopy(x).
fn compiler_main_test_addsub_cancel_sub_first() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 7)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpSub, 1)
    instrs[2] = ir_load_imm(3, 7)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpAdd, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    result.instrs[3].op == IrOpcode::IrCopy && result.instrs[3].src1 == 0
}

// T254: Commutative — r1 = 5 + x; r2 = r1 - 5  →  r2 = IrCopy(x).
fn compiler_main_test_addsub_cancel_commut() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 5)
    instrs[1] = ir_binop(2, 1, BinaryOp::OpAdd, 0)
    instrs[2] = ir_load_imm(3, 5)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpSub, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    result.instrs[3].op == IrOpcode::IrCopy && result.instrs[3].src1 == 0
}

// T255: Mismatched constants — r1 = x + 3; r2 = r1 - 5  →  no fold.
fn compiler_main_test_addsub_no_cancel_mismatch() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 3)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs[2] = ir_load_imm(3, 5)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpSub, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    result.instrs[3].op == IrOpcode::IrBinOp
}

// T256: Negative constant — r1 = x + (-4); r2 = r1 - (-4)  →  r2 = IrCopy(x).
fn compiler_main_test_addsub_cancel_neg_const() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, -4)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs[2] = ir_load_imm(3, -4)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpSub, 3)
    let func   = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    result.instrs[3].op == IrOpcode::IrCopy && result.instrs[3].src1 == 0
}

// T257: Chain — r1 = x + 10; r2 = r1 - 10; r3 = r2 + 1 — r2=IrCopy(x), r3=BinOp(x, 1).
fn compiler_main_test_addsub_cancel_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 10)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs[2] = ir_load_imm(3, 10)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpSub, 3)
    instrs[4] = ir_load_imm(5, 1)
    instrs[5] = ir_binop(6, 4, BinaryOp::OpAdd, 5)
    let func   = cp_make_test_func(instrs, 6)
    let result = ocp_const_fold(func)
    result.instrs[3].op == IrOpcode::IrCopy && result.instrs[5].op == IrOpcode::IrBinOp
}

// Sprint 93 Block Q — copy propagation tests (T258-T263)

// T258: r1 = IrCopy(r0); r2 = IrBinOp(r1, +, 5) → r2 = IrBinOp(r0, +, 5).
fn compiler_main_test_copy_prop_basic() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_copy(1, 0)
    instrs[1] = ir_load_imm(2, 5)
    instrs[2] = ir_binop(3, 1, BinaryOp::OpAdd, 2)
    let func = cp_make_test_func(instrs, 3)
    let folded = ocp_const_fold(func)
    let result = ocp_copy_prop(folded)
    // src1 of the BinOp should be rewritten from r1 → r0.
    result.instrs[2].src1 == 0
}

// T259: Chain collapse — r1 = IrCopy(r0); r2 = IrCopy(r1) → r2 maps to r0.
fn compiler_main_test_copy_prop_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_copy(1, 0)
    instrs[1] = ir_copy(2, 1)
    instrs[2] = ir_load_imm(3, 10)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpAdd, 3)
    let func = cp_make_test_func(instrs, 4)
    let folded = ocp_const_fold(func)
    let result = ocp_copy_prop(folded)
    // r2's copy chain collapses: r2→r1→r0, so BinOp src1 = r0.
    result.instrs[1].src1 == 0 && result.instrs[3].src1 == 0
}

// T260: Non-copy overwrite clears mapping — r1=IrCopy(r0); r1=IrLoadImm(42); use r1 → stays r1.
fn compiler_main_test_copy_prop_overwrite() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_copy(1, 0)
    instrs[1] = ir_load_imm(1, 42)
    instrs[2] = ir_load_imm(2, 5)
    instrs[3] = ir_binop(3, 1, BinaryOp::OpAdd, 2)
    let func = cp_make_test_func(instrs, 4)
    let folded = ocp_const_fold(func)
    let result = ocp_copy_prop(folded)
    // After overwrite, r1 is no longer a copy of r0. BinOp stays as-is (or const-folded).
    result.instrs[3].op == IrOpcode::IrLoadImm || result.instrs[3].src1 == 1
}

// T261: Both src1 and src2 rewritten — r1=IrCopy(r0); r3=IrCopy(r2); r4=r1+r3 → r4=r0+r2.
fn compiler_main_test_copy_prop_both_srcs() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_copy(1, 0)
    instrs[1] = ir_copy(3, 2)
    instrs[2] = ir_binop(4, 1, BinaryOp::OpAdd, 3)
    let func = cp_make_test_func(instrs, 3)
    let folded = ocp_const_fold(func)
    let result = ocp_copy_prop(folded)
    result.instrs[2].src1 == 0 && result.instrs[2].src2 == 2
}

// T262: Self-copy (IrCopy(r0, r0)) — should NOT create circular mapping.
fn compiler_main_test_copy_prop_self_copy() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_copy(0, 0)
    instrs[1] = ir_load_imm(1, 7)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    let func = cp_make_test_func(instrs, 3)
    let folded = ocp_const_fold(func)
    let result = ocp_copy_prop(folded)
    // r0=IrCopy(r0) → copy_target[0]=0, which should still work: BinOp src1 stays r0.
    result.instrs[2].src1 == 0
}

// T263: Copy + const_fold integration — r1=IrLoadImm(3); r2=IrCopy(r1); r3=r2+5 → r3=IrLoadImm(8).
fn compiler_main_test_copy_prop_const_integration() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 3)
    instrs[1] = ir_copy(2, 1)
    instrs[2] = ir_load_imm(3, 5)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpAdd, 3)
    let func = cp_make_test_func(instrs, 4)
    // const_fold already handles copy-through-constant (Sprint 69), so r4=3+5=8.
    let result = ocp_const_fold(func)
    result.instrs[3].op == IrOpcode::IrLoadImm && result.instrs[3].imm_i64 == 8
}

// Sprint 94 Block R — dead store elimination tests (T264-T269)

// T264: r1=IrLoadImm(10); r1=IrLoadImm(20); use r1 → first store is dead.
fn compiler_main_test_dse_basic() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 10)
    instrs[1] = ir_load_imm(1, 20)
    instrs[2] = ir_binop(2, 1, BinaryOp::OpAdd, 0)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_dse(func)
    // First IrLoadImm(1,10) should be NOP'd.
    result.instrs[0].op == IrOpcode::IrNop && result.instrs[1].op == IrOpcode::IrLoadImm
}

// T265: r1=IrLoadImm(10); use r1; r1=IrLoadImm(20) → first store is live (read in between).
fn compiler_main_test_dse_live_store() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 10)
    instrs[1] = ir_binop(2, 1, BinaryOp::OpAdd, 0)
    instrs[2] = ir_load_imm(1, 20)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_dse(func)
    // First store is live (r1 read at [1]), should NOT be NOP'd.
    result.instrs[0].op == IrOpcode::IrLoadImm && result.instrs[0].imm_i64 == 10
}

// T266: r1=IrLoadImm(5); label; r1=IrLoadImm(7) → label clears tracking, no DSE.
fn compiler_main_test_dse_label_barrier() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 5)
    instrs[1] = ir_label(0)
    instrs[2] = ir_load_imm(1, 7)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_dse(func)
    // Label is a barrier — first store survives.
    result.instrs[0].op == IrOpcode::IrLoadImm && result.instrs[0].imm_i64 == 5
}

// T267: Multiple dead stores — r1=10; r1=20; r1=30 → only last survives.
fn compiler_main_test_dse_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 10)
    instrs[1] = ir_load_imm(1, 20)
    instrs[2] = ir_load_imm(1, 30)
    instrs[3] = ir_binop(2, 1, BinaryOp::OpAdd, 0)
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_dse(func)
    // First two stores are dead.
    result.instrs[0].op == IrOpcode::IrNop && result.instrs[1].op == IrOpcode::IrNop && result.instrs[2].op == IrOpcode::IrLoadImm
}

// T268: Different registers — r1=10; r2=20; use r1 → r1 is live, r2 is not affected.
fn compiler_main_test_dse_different_regs() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 10)
    instrs[1] = ir_load_imm(2, 20)
    instrs[2] = ir_binop(3, 1, BinaryOp::OpAdd, 2)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_dse(func)
    // Both are read — no dead stores.
    result.instrs[0].op == IrOpcode::IrLoadImm && result.instrs[1].op == IrOpcode::IrLoadImm
}

// T269: DSE + copy_prop integration — r1=IrCopy(r0); r1=IrLoadImm(42) → copy is dead after DSE.
fn compiler_main_test_dse_copy_integration() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_copy(1, 0)
    instrs[1] = ir_load_imm(1, 42)
    instrs[2] = ir_binop(2, 1, BinaryOp::OpAdd, 0)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_dse(func)
    // IrCopy to r1 is dead (overwritten without read).
    result.instrs[0].op == IrOpcode::IrNop && result.instrs[1].op == IrOpcode::IrLoadImm
}

// Sprint 95 Block S — division/remainder identity folding tests (T270-T275)

// T270: x / x → IrLoadImm(dst, 1)  (same-register division).
fn compiler_main_test_div_self() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 42)
    instrs[1] = ir_binop(1, 0, BinaryOp::OpDiv, 0)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrLoadImm && result.instrs[1].imm_i64 == 1
}

// T271: x % x → IrLoadImm(dst, 0)  (same-register remainder).
fn compiler_main_test_rem_self() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 42)
    instrs[1] = ir_binop(1, 0, BinaryOp::OpRem, 0)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrLoadImm && result.instrs[1].imm_i64 == 0
}

// T272: 0 / x → IrLoadImm(dst, 0)  (zero dividend).
fn compiler_main_test_zero_div() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 0)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpDiv, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrLoadImm && result.instrs[1].imm_i64 == 0
}

// T273: 0 % x → IrLoadImm(dst, 0)  (zero dividend mod).
fn compiler_main_test_zero_rem() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 0)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpRem, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrLoadImm && result.instrs[1].imm_i64 == 0
}

// T274: x / 1 remains IrCopy (pre-existing, regression check).
fn compiler_main_test_div_one_regr() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpDiv, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrCopy && result.instrs[1].src1 == 0
}

// T275: x/x chain — (x/x) + (x%x) → 1 + 0 → IrLoadImm(1).
fn compiler_main_test_div_rem_chain() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 7)
    instrs[1] = ir_binop(1, 0, BinaryOp::OpDiv, 0)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpRem, 0)
    instrs[3] = ir_binop(3, 1, BinaryOp::OpAdd, 2)
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    result.instrs[3].op == IrOpcode::IrLoadImm && result.instrs[3].imm_i64 == 1
}

// Sprint 96 Block T — shift-chain combining tests (T276-T281)

// T276: (x << 2) << 3 → x << 5.
fn compiler_main_test_shift_chain_shl() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 2)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpShl, 1)     // r2 = r0 << 2
    instrs[2] = ir_load_imm(3, 3)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpShl, 3)     // r4 = r2 << 3 → r0 << 5
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    // r4 should now be (r0 << 5), and the constant should be combined to 5.
    result.instrs[3].src1 == 0 && result.instrs[2].imm_i64 == 5
}

// T277: (x >> 1) >> 4 → x >> 5.
fn compiler_main_test_shift_chain_shr() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpShr, 1)     // r2 = r0 >> 1
    instrs[2] = ir_load_imm(3, 4)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpShr, 3)     // r4 = r2 >> 4 → r0 >> 5
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    result.instrs[3].src1 == 0 && result.instrs[2].imm_i64 == 5
}

// T278: Mixed directions — (x << 2) >> 3 — NO fold (different shift directions).
fn compiler_main_test_shift_chain_mixed_no_fold() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 2)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpShl, 1)     // r2 = r0 << 2
    instrs[2] = ir_load_imm(3, 3)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpShr, 3)     // r4 = r2 >> 3 — no fold
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    // Should NOT fold — src1 stays r2, const stays 3.
    result.instrs[3].src1 == 2 && result.instrs[2].imm_i64 == 3
}

// T279: Triple chain — (x << 1) << 2) << 3 → x << 6.
fn compiler_main_test_shift_chain_triple() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpShl, 1)     // r2 = r0 << 1
    instrs[2] = ir_load_imm(3, 2)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpShl, 3)     // r4 = r2 << 2 → r0 << 3
    instrs[4] = ir_load_imm(5, 3)
    instrs[5] = ir_binop(6, 4, BinaryOp::OpShl, 5)     // r6 = r4 << 3 → r0 << 6
    let func = cp_make_test_func(instrs, 6)
    let result = ocp_const_fold(func)
    result.instrs[5].src1 == 0 && result.instrs[4].imm_i64 == 6
}

// T280: Shift with non-const amount — (x << r) << 3 — no chain (r not const).
fn compiler_main_test_shift_chain_nonconst() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpShl, 1)     // r2 = r0 << r1 (r1 not const)
    instrs[1] = ir_load_imm(3, 3)
    instrs[2] = ir_binop(4, 2, BinaryOp::OpShl, 3)     // r4 = r2 << 3
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_const_fold(func)
    // First shift has non-const amount → no tracking → no chain fold.
    result.instrs[2].src1 == 2
}

// T281: SR + shift chain — x*4 → x<<2, then (x<<2)<<1 → x<<3.
fn compiler_main_test_shift_chain_sr_integration() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 4)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)     // r2 = r0 * 4 → SR: r0 << 2
    instrs[2] = ir_load_imm(3, 1)
    instrs[3] = ir_binop(4, 2, BinaryOp::OpShl, 3)     // r4 = r2 << 1 → chain: r0 << 3
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_const_fold(func)
    // SR converts r2=r0*4 → r2=r0<<2, then shift-chain: r4 = r0 << 3.
    result.instrs[3].src1 == 0 && result.instrs[2].imm_i64 == 3
}

// Sprint 97 Block U — redundant jump elimination tests (T282-T287)

// T282: IrJump(L0) followed by IrLabel(L0) → NOP.
fn compiler_main_test_redundant_jump_basic() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 42)
    instrs[1] = ir_jump(0)
    instrs[2] = ir_label(0)
    instrs[3] = ir_binop(1, 0, BinaryOp::OpAdd, 0)
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_redundant_jump(func)
    result.instrs[1].op == IrOpcode::IrNop
}

// T283: IrJump(L1) followed by IrLabel(L0) — different labels, NO fold.
fn compiler_main_test_redundant_jump_different_labels() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_jump(1)
    instrs[1] = ir_label(0)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_redundant_jump(func)
    result.instrs[0].op == IrOpcode::IrJump
}

// T284: IrBranchTrue(cond, L0) followed by IrLabel(L0) → NOP.
fn compiler_main_test_redundant_branch_true() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 1)
    instrs[1] = ir_branch_true(0, 0)
    instrs[2] = ir_label(0)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_redundant_jump(func)
    result.instrs[1].op == IrOpcode::IrNop
}

// T285: IrBranchFalse(cond, L0) followed by IrLabel(L0) → NOP.
fn compiler_main_test_redundant_branch_false() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 0)
    instrs[1] = ir_branch_false(0, 0)
    instrs[2] = ir_label(0)
    let func = cp_make_test_func(instrs, 3)
    let result = ocp_redundant_jump(func)
    result.instrs[1].op == IrOpcode::IrNop
}

// T286: Non-jump before label — IrLoadImm; IrLabel(L0) — no fold.
fn compiler_main_test_redundant_jump_non_jump() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 5)
    instrs[1] = ir_label(0)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_redundant_jump(func)
    result.instrs[0].op == IrOpcode::IrLoadImm
}

// T287: Multiple redundant jumps in sequence.
fn compiler_main_test_redundant_jump_multi() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_jump(0)
    instrs[1] = ir_label(0)
    instrs[2] = ir_jump(1)
    instrs[3] = ir_label(1)
    let func = cp_make_test_func(instrs, 4)
    let result = ocp_redundant_jump(func)
    result.instrs[0].op == IrOpcode::IrNop && result.instrs[2].op == IrOpcode::IrNop
}

