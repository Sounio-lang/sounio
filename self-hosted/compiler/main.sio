    instrs[4 as usize] = ir_load_imm(4, 2)
    instrs[5 as usize] = ir_binop(5, 1, BinaryOp::OpSub, 4)   // r5 = y-2
    instrs[6 as usize] = ir_binop(6, 3, BinaryOp::OpSub, 5)   // r6 = (x+3)-(y-2)
    let func = cp_make_test_func(instrs, 7)
    let result = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (6))) as usize] as IrOpcode) != IrOpcode::IrLoadImm
}

fn compiler_main_test_bu_chain_fold() -> bool with Mut, Div, Panic {
    // Chain: (x-1)-1 = x-2 via Block BS; then (x+3)-(x-2) → 5 via Block BU
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
    instrs[0 as usize] = ir_load_imm(0, 42)   // r0 = x
    instrs[1 as usize] = ir_load_imm(1, 1)
    instrs[2 as usize] = ir_binop(2, 0, BinaryOp::OpSub, 1)   // r2 = x-1
    instrs[3 as usize] = ir_load_imm(3, 1)
    instrs[4 as usize] = ir_binop(4, 2, BinaryOp::OpSub, 3)   // r4 = (x-1)-1 = x-2 [Block BS]
    instrs[5 as usize] = ir_load_imm(5, 3)
    instrs[6 as usize] = ir_binop(6, 0, BinaryOp::OpAdd, 5)   // r6 = x+3 (bt_add)
    instrs[7 as usize] = ir_binop(7, 6, BinaryOp::OpSub, 4)   // r7 = (x+3)-(x-2) → 5 [Block BU]
    let func = cp_make_test_func(instrs, 8)
    let result = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (7))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (7))) as usize] == 5
}

fn compiler_main_test_xor_or_merge_basic() -> bool with Mut, Div, Panic {
    // (x^5) | 5 → x|5: XOR-OR merge; src1 should be x (not x^5)
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
    instrs[0 as usize] = ir_load_imm(0, 42)         // r0 = x
    instrs[1 as usize] = ir_load_imm(1, 5)
    instrs[2 as usize] = ir_binop(2, 0, BinaryOp::OpBitXor, 1)  // r2 = x^5
    instrs[3 as usize] = ir_load_imm(3, 5)
    instrs[4 as usize] = ir_binop(4, 2, BinaryOp::OpBitOr, 3)   // r4 = (x^5)|5
    let func = cp_make_test_func(instrs, 5)
    let result = opt_cleanup_function(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (4))) as usize] as IrOpcode) == IrOpcode::IrBinOp
        && (IR_A_BIN_OP[(ir_region_slot_r(result.region, (4))) as usize] as BinaryOp) == BinaryOp::OpBitOr
        && IR_A_SRC1[(ir_region_slot_r(result.region, (4))) as usize] == 0
}

fn compiler_main_test_xor_or_merge_commutative() -> bool with Mut, Div, Panic {
    // 5 | (x^5) → x|5: commutative outer OR
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
    instrs[0 as usize] = ir_load_imm(0, 42)
    instrs[1 as usize] = ir_load_imm(1, 5)
