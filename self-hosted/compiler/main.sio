        println("  FAIL: T271 Sprint 95 Block S: x%x")
    }

    if compiler_main_test_zero_div() {
        println("  T272 OK: Sprint 95 Block S: 0/x → IrLoadImm(0)")
        passed = passed + 1
    } else {
        println("  FAIL: T272 Sprint 95 Block S: zero dividend div")
    }

    if compiler_main_test_zero_rem() {
        println("  T273 OK: Sprint 95 Block S: 0%x → IrLoadImm(0)")
        passed = passed + 1
    } else {
        println("  FAIL: T273 Sprint 95 Block S: zero dividend rem")
    }

    if compiler_main_test_div_one_regr() {
        println("  T274 OK: Sprint 95 Block S: x/1 → IrCopy(x) (regression)")
        passed = passed + 1
    } else {
        println("  FAIL: T274 Sprint 95 Block S: div-by-1 regression")
    }

    if compiler_main_test_div_rem_chain() {
        println("  T275 OK: Sprint 95 Block S: (x/x)+(x%x) → 1+0 → IrLoadImm(1)")
        passed = passed + 1
    } else {
        println("  FAIL: T275 Sprint 95 Block S: div/rem chain fold")
    }

    // Sprint 96 Block T — Shift-Chain Combining (T276-T281)
    if compiler_main_test_shift_chain_shl() {
        println("  T276 OK: Sprint 96 Block T: (x<<2)<<3 → x<<5")
        passed = passed + 1
    } else {
        println("  FAIL: T276 Sprint 96 Block T: shl chain")
    }

    if compiler_main_test_shift_chain_shr() {
        println("  T277 OK: Sprint 96 Block T: (x>>1)>>4 → x>>5")
        passed = passed + 1
    } else {
        println("  FAIL: T277 Sprint 96 Block T: shr chain")
    }

    if compiler_main_test_shift_chain_mixed_no_fold() {
        println("  T278 OK: Sprint 96 Block T: (x<<2)>>3 — no fold (mixed dirs)")
        passed = passed + 1
    } else {
        println("  FAIL: T278 Sprint 96 Block T: mixed no fold")
    }

    if compiler_main_test_shift_chain_triple() {
        println("  T279 OK: Sprint 96 Block T: (x<<1)<<2)<<3 → x<<6 (triple)")
        passed = passed + 1
    } else {
        println("  FAIL: T279 Sprint 96 Block T: triple chain")
    }

    if compiler_main_test_shift_chain_nonconst() {
        println("  T280 OK: Sprint 96 Block T: (x<<r)<<3 — no fold (non-const)")
        passed = passed + 1
    } else {
        println("  FAIL: T280 Sprint 96 Block T: nonconst no fold")
    }

    if compiler_main_test_shift_chain_sr_integration() {
        println("  T281 OK: Sprint 96 Block T: x*4→x<<2, then (x<<2)<<1 → x<<3")
        passed = passed + 1
    } else {
        println("  FAIL: T281 Sprint 96 Block T: SR+shift chain integration")
    }

    // Sprint 97 Block U — Redundant Jump Elimination (T282-T287)
    if compiler_main_test_redundant_jump_basic() {
        println("  T282 OK: Sprint 97 Block U: IrJump(L) + IrLabel(L) → NOP")
        passed = passed + 1
    } else {
        println("  FAIL: T282 Sprint 97 Block U: basic redundant jump")
    }

    if compiler_main_test_redundant_jump_different_labels() {
        println("  T283 OK: Sprint 97 Block U: different labels — no fold")
        passed = passed + 1
    } else {
        println("  FAIL: T283 Sprint 97 Block U: different labels")
    }

    if compiler_main_test_redundant_branch_true() {
        println("  T284 OK: Sprint 97 Block U: BranchTrue(L) + Label(L) → NOP")
        passed = passed + 1
    } else {
        println("  FAIL: T284 Sprint 97 Block U: redundant branch_true")
    }

    if compiler_main_test_redundant_branch_false() {
        println("  T285 OK: Sprint 97 Block U: BranchFalse(L) + Label(L) → NOP")
        passed = passed + 1
    } else {
        println("  FAIL: T285 Sprint 97 Block U: redundant branch_false")
    }

    if compiler_main_test_redundant_jump_non_jump() {
        println("  T286 OK: Sprint 97 Block U: non-jump before label — no fold")
        passed = passed + 1
    } else {
        println("  FAIL: T286 Sprint 97 Block U: non-jump no fold")
    }

    if compiler_main_test_redundant_jump_multi() {
        println("  T287 OK: Sprint 97 Block U: multiple redundant jumps")
        passed = passed + 1
    } else {
        println("  FAIL: T287 Sprint 97 Block U: multi redundant")
    }

    println("")
    println("compiler/main tests: " + int_to_string(passed) + "/" + int_to_string(total) + " passed")
    if passed == total { 0 } else { 1 }
}

// ============================================================================
// MAIN
// ============================================================================

fn main() with IO, Mut, Panic, Div, Alloc {
    let args = get_args()

    println("SOUNIO SELF-HOSTED COMPILER v0.80.0")
    println("Horizon 3: self-hosted primary compiler.")
    println("")

    var arg_idx: i64 = 0
    while arg_idx < args.len {
        let mode = arg_list_get(args, arg_idx)
        if mode == "--check" {
            run_check_mode(args, arg_idx)
            return
        } else if mode == "--ir-dump" {
            run_ir_dump_mode(args, arg_idx)
            return
        } else if mode == "--ir-roundtrip" {
            run_ir_roundtrip_mode(args, arg_idx)
            return
        } else if mode == "--native-compile" {
            run_native_compile_mode(args, arg_idx)
            return
        } else if mode == "--self-test" {
            let self_test_code = run_compiler_main_self_tests()
            if self_test_code != 0 {
                panic("compiler/main self-tests failed")
            }
            return
        } else if mode == "--native-v2-preview-smoke" {
            run_native_v2_preview_smoke()
            return
        } else if mode == "--native-v2-gc-retry-smoke" {
            run_native_v2_gc_retry_smoke()
            return
        } else if mode == "--bench-int-to-string" {
            run_int_to_string_bench_from_args(args, arg_idx)
            return
        } else if mode == "--probe-char-from-i64" {
            run_probe_char_from_i64(args, arg_idx)
            return
        } else if mode == "--probe-arg-list-get" {
            run_probe_arg_list_get(args, arg_idx)
            return
        } else if mode == "--probe-compile-capture" || mode == "--probe-cc" || starts_with(mode, "--probe-c") {
            run_probe_compile_capture(args, arg_idx)
            return
        } else if mode == "--probe-frontend-strategy" || starts_with(mode, "--probe-front-strat") {
            run_probe_frontend_strategy(args, arg_idx)
            return
        } else if mode == "--probe-frontend" || starts_with(mode, "--probe-front") {
            run_probe_frontend(args, arg_idx)
            return
        } else if mode == "--probe-epistemic-check" || starts_with(mode, "--probe-epi") {
            run_probe_epistemic_check(args, arg_idx)
            return
        } else if mode == "--probe-load-ir-trace" || starts_with(mode, "--probe-load-ir-t") {
            run_probe_load_ir_trace(args, arg_idx)
            return
        } else if mode == "--probe-native-streaming" || starts_with(mode, "--probe-native-stream") {
            run_probe_native_streaming(args, arg_idx)
            return
        } else if mode == "--probe-load-ir" || starts_with(mode, "--probe-load") {
            run_probe_load_ir(args, arg_idx)
            return
        } else if mode == "--probe-ir-callsite" || starts_with(mode, "--probe-ir-call") {
            run_probe_ir_callsite(args, arg_idx)
            return
        } else if mode == "--probe-ir-opt-strategy" || starts_with(mode, "--probe-ir-opt") {
            run_probe_ir_opt_strategy(args, arg_idx)
            return
        } else if mode == "--probe-wasm-dispatch" || starts_with(mode, "--probe-wasm") {
            run_probe_wasm_dispatch(args, arg_idx)
            return
        } else if mode == "--show-profile" || starts_with(mode, "--show-prof") {
            run_probe_show_profile(args, arg_idx)
            return
        } else if mode == "--probe-machine-ir" || starts_with(mode, "--probe-mir") {
            run_probe_machine_ir(args, arg_idx)
            return
        } else if starts_with(mode, "--probe") {
            run_probe_compile_capture(args, arg_idx)
            return
        }
        arg_idx = arg_idx + 1
    }

    let opts = parse_options(args)

    if opts.verbose {
        println("Options:")
        println("  Input:  " + opts.input_file)
        println("  Output: " + opts.output_file)
        println("  Target: " + opts.target)
        println("  GPU Target: " + opts.gpu_target)
        println("  GPU Binary Format: " + opts.gpu_binary_format)
        let strict_label = if opts.gpu_strict_parity { "true" } else { "false" }
        println("  GPU Strict Parity: " + strict_label)
        println("")
    }

    let result = compile(opts)

    if result.success {
        println("Compilation successful!")
        println("   Output: " + result.output)

        if result.errors.len > 0 {
            println("")
            println("Warnings:")
            var i: i64 = 0
            while i < result.errors.len {
                println("  " + compile_errors_get(result.errors, i))
                i = i + 1
            }
        }
    } else {
        println("Compilation failed!")
        println("")
        println("Errors:")
        var i: i64 = 0
        while i < result.errors.len {
            println("  " + compile_errors_get(result.errors, i))
            i = i + 1
        }
        exit_process(1)
    }
}
