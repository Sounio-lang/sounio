    instrs[1 as usize] = ir_load_imm(3, 2)
    instrs[2 as usize] = ir_binop(4, 0, BinaryOp::OpShl, 3)      // r0<<2
    instrs[3 as usize] = ir_binop(5, 2, BinaryOp::OpAdd, 4)
