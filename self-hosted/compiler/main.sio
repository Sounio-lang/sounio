    let size = file_size(path)
    if size <= 0 { return false }
    let data = read_file(path)
    if data[0 as usize] != (123 as i8) { return false }
    if !compiler_bytes_contains(data, size, "\"active\":true") { return false }
    if !compiler_bytes_contains(data, size, "\"coverage\":\"scalar_core\"") { return false }
    if !compiler_bytes_contains(data, size, "\"fail_closed\":true") { return false }
    if !compiler_bytes_contains(data, size, "\"legacy_fallback\":false") { return false }
    if !compiler_bytes_contains(data, size, "\"stack_map_records\":1") { return false }
    if !compiler_bytes_contains(data, size, "\"safepoint_count\":1") { return false }
    if !compiler_bytes_contains(data, size, "\"runtime_metadata_embedded\":true") { return false }
    if !compiler_bytes_contains(data, size, "\"gc_state_embedded\":true") { return false }
    if !compiler_bytes_contains(data, size, "\"gc_slow_path_active\":true") { return false }
    if !compiler_bytes_contains(data, size, "\"stack_maps_runtime_active\":true") { return false }
    if !compiler_bytes_contains(data, size, "\"root_map_schema\":\"v2\"") { return false }
    if !compiler_bytes_contains(data, size, "\"root_map_fields_embedded\":true") { return false }
    if !compiler_bytes_contains(data, size, "\"coarse_root_kind_tags\":true") { return false }
    if !compiler_bytes_contains(data, size, "\"deopt_ids_embedded\":true") { return false }
    if !compiler_bytes_contains(data, size, "\"osr_eligibility_embedded\":true") { return false }
    if !compiler_bytes_contains(data, size, "\"managed_handles\":true") { return false }
    if !compiler_bytes_contains(data, size, "\"descriptor_tables\":true") { return false }
    if !compiler_bytes_contains(data, size, "\"handle_indirection\":true") { return false }
    if !compiler_bytes_contains(data, size, "\"descriptor_tables_embedded\":true") { return false }
    if !compiler_bytes_contains(data, size, "\"gc_mark_compact_model\":true") { return false }
    if !compiler_bytes_contains(data, size, "\"gc_precise_descriptor_scanning\":true") { return false }
    if !compiler_bytes_contains(data, size, "\"gc_handle_relocation_model\":true") { return false }
    if !compiler_bytes_contains(data, size, "\"ffi_pinning_model\":true") { return false }
    if !compiler_bytes_contains(data, size, "\"gc_runtime_retry_active\":true") { return false }
    if !compiler_bytes_contains(data, size, "\"gc_current_frame_root_scan\":true") { return false }
    true
}

fn compiler_main_test_native_v2_runtime_metadata_published() -> bool with Mut, Panic, Div, Alloc {
    let pair = compile_module_v2(compiler_new(), &compiler_main_make_native_v2_call_module())
    let nc = pair.0
    if !str_eq(pair.1, "") { return false }
    if nc.stack_map_record_count <= 0 { return false }
    if nc.safepoint_count != nc.stack_map_record_count { return false }
    if nc.deopt_point_count != nc.stack_map_record_count { return false }
    if nc.stack_map_data_offset < runtime_context_global_slot_size() { return false }
    if nc.deopt_state_data_offset <= nc.stack_map_data_offset { return false }
    true
}

fn compiler_main_test_native_v2_runtime_metadata_shape() -> bool with Mut, Panic, Div, Alloc {
    let pair = compile_module_v2(compiler_new(), &compiler_main_make_native_v2_call_module())
    let nc = pair.0
    if !str_eq(pair.1, "") { return false }
    if nc.stack_map_record_count < 3 { return false }
    if nc.stack_map_fn_indices[0 as usize] != 0 { return false }
    if nc.stack_map_kinds[0 as usize] != NATIVE_V2_SAFEPOINT_RET() { return false }
    if nc.stack_map_code_offsets[0 as usize] < 0 { return false }
    var saw_call = false
    var i: i64 = 0
    while i < nc.stack_map_record_count {
        if nc.stack_map_kinds[i as usize] == NATIVE_V2_SAFEPOINT_CALL() {
            saw_call = true
        }
        i = i + 1
    }
    saw_call
}

fn compiler_main_test_native_v2_stack_map_decoder() -> bool with Mut, Panic, Div, Alloc {
    let pair = compile_module_v2(compiler_new(), &compiler_main_make_native_v2_call_module())
    let nc = pair.0
    if !str_eq(pair.1, "") { return false }
    let blob = native_v2_stack_map_blob_decode(nc.data, nc.stack_map_data_offset)
    if !blob.valid { return false }
    if blob.version != native_v2_stack_map_version() { return false }
    if blob.record_count != nc.stack_map_record_count { return false }
    if blob.safepoint_count != nc.safepoint_count { return false }
    if blob.deopt_point_count != nc.deopt_point_count { return false }
    if blob.records[0].kind != NATIVE_V2_SAFEPOINT_RET() { return false }
    var saw_call = false
    var i: i64 = 0
    while i < blob.record_count {
        if blob.records[i as usize].kind == NATIVE_V2_SAFEPOINT_CALL() {
            saw_call = true
        }
        i = i + 1
    }
    saw_call
}

fn compiler_main_test_native_v2_root_map_metadata_shape() -> bool with Mut, Panic, Div, Alloc {
    let pair = compile_module_v2(compiler_new(), &compiler_main_make_native_v2_call_module())
    let nc = pair.0
    if !str_eq(pair.1, "") { return false }
    if nc.stack_map_record_count < 3 { return false }
    if nc.stack_map_root_temp_counts[0 as usize] != nc.stack_map_temp_counts[0 as usize] { return false }
    if nc.stack_map_root_spill_counts[0 as usize] != nc.stack_map_spill_counts[0 as usize] { return false }
    if nc.stack_map_callee_saved_root_masks[0 as usize] != 0 { return false }
    if nc.stack_map_root_kind_masks[0 as usize] != native_v2_stack_map_root_kind_mixed() { return false }
    if nc.stack_map_deopt_ids[0 as usize] != 0 { return false }
    if nc.stack_map_tier_ids[0 as usize] != native_v2_stack_map_tier_baseline() { return false }
    if nc.stack_map_osr_eligibility[0 as usize] != native_v2_stack_map_osr_ineligible() { return false }
    var saw_call = false
    var i: i64 = 0
    while i < nc.stack_map_record_count {
        if nc.stack_map_root_temp_counts[i as usize] != nc.stack_map_temp_counts[i as usize] { return false }
        if nc.stack_map_root_spill_counts[i as usize] != nc.stack_map_spill_counts[i as usize] { return false }
        if nc.stack_map_deopt_ids[i as usize] != i { return false }
        if nc.stack_map_tier_ids[i as usize] != native_v2_stack_map_tier_baseline() { return false }
        if nc.stack_map_root_kind_masks[i as usize] != native_v2_stack_map_root_kind_mixed() { return false }
        if nc.stack_map_kinds[i as usize] == NATIVE_V2_SAFEPOINT_CALL() {
            saw_call = true
            if nc.stack_map_osr_eligibility[i as usize] != native_v2_stack_map_osr_eligible() { return false }
        } else {
            if nc.stack_map_osr_eligibility[i as usize] != native_v2_stack_map_osr_ineligible() { return false }
        }
        i = i + 1
    }
    saw_call
}

fn compiler_main_test_native_v2_stack_map_decoder_root_fields() -> bool with Mut, Panic, Div, Alloc {
    let pair = compile_module_v2(compiler_new(), &compiler_main_make_native_v2_call_module())
    let nc = pair.0
    if !str_eq(pair.1, "") { return false }
    let blob = native_v2_stack_map_blob_decode(nc.data, nc.stack_map_data_offset)
    if !blob.valid { return false }
    if blob.version != native_v2_stack_map_version() { return false }
    if blob.record_count != nc.stack_map_record_count { return false }
    if blob.records[0].root_temp_count != nc.stack_map_root_temp_counts[0 as usize] { return false }
    if blob.records[0].root_spill_count != nc.stack_map_root_spill_counts[0 as usize] { return false }
    if blob.records[0].callee_saved_root_mask != nc.stack_map_callee_saved_root_masks[0 as usize] { return false }
    if blob.records[0].root_kind_mask != native_v2_stack_map_root_kind_mixed() { return false }
    var saw_call = false
    var i: i64 = 0
    while i < blob.record_count {
        if blob.records[i as usize].deopt_id != i { return false }
        if blob.records[i as usize].tier_id != native_v2_stack_map_tier_baseline() { return false }
        if blob.records[i as usize].root_kind_mask != native_v2_stack_map_root_kind_mixed() { return false }
        if blob.records[i as usize].kind == NATIVE_V2_SAFEPOINT_CALL() {
            saw_call = true
            if blob.records[i as usize].osr_eligible != native_v2_stack_map_osr_eligible() { return false }
        } else {
            if blob.records[i as usize].osr_eligible != native_v2_stack_map_osr_ineligible() { return false }
        }
        i = i + 1
    }
    saw_call
}

fn compiler_main_test_native_v2_gc_state_blob() -> bool with Mut, Panic, Div, Alloc {
    let pair = compile_module_v2(compiler_new(), &compiler_main_make_native_v2_call_module())
    let nc = pair.0
    if !str_eq(pair.1, "") { return false }
    if nc.gc_state_data_offset <= nc.deopt_state_data_offset { return false }
    let state = native_v2_gc_state_decode(nc.data, nc.gc_state_data_offset)
    if !state.valid { return false }
    if state.flags != native_v2_gc_flag_ready() + native_v2_gc_flag_managed_handles() { return false }
    if state.collection_requests != 0 { return false }
    if state.stack_maps_offset != nc.stack_map_data_offset { return false }
    if state.deopt_state_offset != nc.deopt_state_data_offset { return false }
    if state.handle_capacity != native_v2_handle_table_capacity_default() { return false }
    if state.descriptor_table_offset != nc.descriptor_data_offset { return false }
    if state.descriptor_count != nc.descriptor_count { return false }
    if state.last_reason != native_v2_gc_reason_none() { return false }
    true
}

fn compiler_main_test_native_v2_alloc_slow_path_trap() -> bool with Mut, Panic, Div, Alloc {
    let pair = compile_module_v2(compiler_new(), &compiler_main_make_native_v2_huge_alloc_module())
    let nc = pair.0
    if !str_eq(pair.1, "") { return false }
    var seq: [i64; 32] = [0; 32]
    seq[0] = 0x48
    seq[1] = 0xC7
    seq[2] = 0xC0
    seq[3] = 0x3C
    seq[4] = 0x00
    seq[5] = 0x00
    seq[6] = 0x00
    seq[7] = 0x48
    seq[8] = 0xC7
    seq[9] = 0xC7
    seq[10] = 0xB5
    seq[11] = 0x00
    seq[12] = 0x00
    seq[13] = 0x00
    seq[14] = 0x0F
    seq[15] = 0x05
    compiler_bytes_contains_seq_i64(nc.code.bytes, nc.code.len, seq, 16)
}

fn compiler_main_test_native_v2_runtime_context_handles() -> bool {
    if runtime_context_field_handle_table_base() != 24 { return false }
    if runtime_context_field_descriptor_table() != 48 { return false }
    if runtime_context_field_gc_state() != 120 { return false }
    if runtime_context_field_collector_epoch() != 168 { return false }
    runtime_context_size() == 192
}

fn compiler_main_test_native_v2_descriptor_table_blob() -> bool with Mut, Panic, Div, Alloc {
    let pair = compile_module_v2(compiler_new(), &compiler_main_make_native_v2_alloc_field_module())
    let nc = pair.0
    if !str_eq(pair.1, "") { return false }
    if nc.descriptor_data_offset < runtime_context_global_slot_size() { return false }
    if nc.descriptor_count != 5 { return false }
    let table = native_v2_descriptor_table_decode(nc.data, nc.descriptor_data_offset)
    if !table.valid { return false }
    if table.count != nc.descriptor_count { return false }
    if table.entries[0].id != 0 { return false }
    if table.entries[0].kind != native_v2_descriptor_kind_struct() { return false }
    if table.entries[0].payload_bytes != 512 { return false }
    if table.entries[3].id != 8 { return false }
    if table.entries[3].kind != native_v2_descriptor_kind_box() { return false }
    table.entries[4].id == 255 && table.entries[4].kind == native_v2_descriptor_kind_opaque()
}

fn compiler_main_test_native_v2_alloc_uses_descriptor_handles() -> bool with Mut, Panic, Div, Alloc {
    let built = native_v2_build_machine_module(&compiler_main_make_native_v2_alloc_field_module(), true)
    if !built.supported { return false }
    let func = built.functions[0]
    var saw_alloc = false
    var saw_field_get = false
    var i: i64 = 0
    while i < func.blocks[0].instr_count {
        let instr = func.blocks[0].instrs[i as usize]
        if instr.opcode == MIR_OP_ALLOC {
            saw_alloc = true
            if instr.aux.kind != MIR_OPERAND_IMM64 { return false }
            if instr.aux.value != 0 { return false }
        }
        if instr.opcode == MIR_OP_FIELD_LOAD {
            saw_field_get = true
        }
        i = i + 1
    }
    saw_alloc && saw_field_get
}

fn compiler_main_test_native_v2_compile_gc_retry_smoke() -> bool with IO, Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let result = compile_native_v2_preview(&compiler_main_make_native_v2_gc_retry_module(), spec)
    if !result.ok || result.format_id != FORMAT_ELF64() || result.len <= 64 { return false }
    io_write_native_binary_large("artifacts/omega/native_backend_v2_gc_retry_smoke.selftest.bin", result.bytes, result.len)
}

fn compiler_main_make_native_v2_gc_model() -> NativeV2GcModel with Mut, Panic, Div {
    var model = native_v2_gc_model_empty()
    model.heap_base = 4096
    model = native_v2_gc_model_add_descriptor(model, 1, native_v2_descriptor_kind_struct(), 16, 2, 1)
    model = native_v2_gc_model_add_descriptor(model, 255, native_v2_descriptor_kind_opaque(), 16, 2, 0)
    model
}

fn compiler_main_test_native_v2_gc_precise_descriptor_scanning() -> bool with Mut, Panic, Div, Alloc {
    var model = compiler_main_make_native_v2_gc_model()
    model = native_v2_gc_model_define_handle(model, 1, 4096, 32, 1, 0)
    model = native_v2_gc_model_define_handle(model, 2, 4128, 32, 255, 0)
    model = native_v2_gc_model_define_handle(model, 3, 4160, 32, 255, 0)
    model = native_v2_gc_model_set_slot(model, 1, 0, 2)
    model = native_v2_gc_model_set_slot(model, 1, 1, 3)
    model = native_v2_gc_model_add_root(model, 1)
    let collected = native_v2_gc_model_collect(model)
    if !collected.handles[1 as usize].in_use { return false }
    if !collected.handles[2 as usize].in_use { return false }
    if collected.handles[3 as usize].in_use { return false }
    if collected.live_count != 2 { return false }
    collected.freed_count == 1
}

fn compiler_main_test_native_v2_gc_compacts_live_handles() -> bool with Mut, Panic, Div, Alloc {
    var model = compiler_main_make_native_v2_gc_model()
    model.heap_base = 8192
    model = native_v2_gc_model_define_handle(model, 1, 8192, 32, 255, 0)
    model = native_v2_gc_model_define_handle(model, 2, 8224, 32, 255, 0)
    model = native_v2_gc_model_define_handle(model, 3, 8256, 32, 255, 0)
    model = native_v2_gc_model_add_root(model, 1)
    model = native_v2_gc_model_add_root(model, 3)
    let collected = native_v2_gc_model_collect(model)
    if collected.handles[1 as usize].object_base != 8192 { return false }
    if collected.handles[2 as usize].in_use { return false }
    if collected.handles[3 as usize].object_base != 8224 { return false }
    if collected.moved_count != 1 { return false }
    collected.state.last_heap_cursor == 8256
}

fn compiler_main_test_native_v2_gc_pins_block_relocation() -> bool with Mut, Panic, Div, Alloc {
    var model = compiler_main_make_native_v2_gc_model()
    model.heap_base = 1000
    model = native_v2_gc_model_define_handle(model, 1, 1000, 32, 255, 0)
    model = native_v2_gc_model_define_handle(model, 2, 1100, 32, 255, 1)
    model = native_v2_gc_model_define_handle(model, 3, 1200, 32, 255, 0)
    model = native_v2_gc_model_add_root(model, 1)
    model = native_v2_gc_model_add_root(model, 3)
    let collected = native_v2_gc_model_collect(model)
    if !collected.handles[2 as usize].in_use { return false }
    if collected.handles[2 as usize].object_base != 1100 { return false }
    if (collected.handles[2 as usize].flags & native_v2_gc_handle_flag_pinned()) == 0 { return false }
    if collected.handles[3 as usize].object_base != 1132 { return false }
    collected.pinned_live_count == 1
}

fn compiler_main_test_native_v2_gc_state_updates_after_collection() -> bool with Mut, Panic, Div, Alloc {
    var model = compiler_main_make_native_v2_gc_model()
    model.heap_base = 2048
    model = native_v2_gc_model_define_handle(model, 1, 2048, 24, 255, 0)
    model = native_v2_gc_model_define_handle(model, 2, 2072, 24, 255, 0)
    model = native_v2_gc_model_add_root(model, 1)
    let collected = native_v2_gc_model_collect(model)
    if collected.state.collection_requests != 1 { return false }
    if collected.state.collections_completed != 1 { return false }
    if collected.state.collector_epoch != 1 { return false }
    if collected.state.compaction_count != 1 { return false }
    if collected.state.last_reason != native_v2_gc_reason_heap_limit() { return false }
    if collected.state.handle_count != collected.live_count { return false }
    if collected.state.descriptor_count != collected.descriptor_table.count { return false }
    if collected.state.handle_capacity != NATIVE_V2_GC_MODEL_MAX_HANDLES { return false }
    if collected.state.flags != native_v2_gc_flag_ready() + native_v2_gc_flag_managed_handles() { return false }
    collected.live_count == native_v2_gc_model_active_handle_count(collected)
}

// ============================================================================
// Sprint 65: Peephole optimizer wiring (T74-T80)
// ============================================================================

// T74: self-move elimination — ph_opt_single removes mov rX, rX
fn compiler_main_test_ph_self_move_eliminated() -> bool {
    let mov_self = ph_instr_new(PH_MOV(), 5, 5, 0)
    let result = ph_opt_single(mov_self)
    result.opcode == PH_NOP()
}

// T75: identity-add elimination — ph_opt_single removes add rX, 0
fn compiler_main_test_ph_identity_add_eliminated() -> bool {
    let add_zero = ph_instr_imm(PH_ADD(), 3, 0)
    let result = ph_opt_single(add_zero)
    result.opcode == PH_NOP()
}

// T76: identity-sub elimination — ph_opt_single removes sub rX, 0
fn compiler_main_test_ph_identity_sub_eliminated() -> bool {
    let sub_zero = ph_instr_imm(PH_SUB(), 2, 0)
    let result = ph_opt_single(sub_zero)
    result.opcode == PH_NOP()
}

// T77: push/pop pair collapse — ph_opt_pair eliminates push rX; pop rX
fn compiler_main_test_ph_push_pop_pair_collapsed() -> bool {
    let push12 = ph_instr_new(PH_PUSH(), 12, PH_NO_REG(), 0)
    let pop12  = ph_instr_new(PH_POP(),  12, PH_NO_REG(), 0)
    let result = ph_opt_pair(push12, pop12)
    if result.optimized != 2 { return false }
    if result.instrs[0].opcode != PH_NOP() { return false }
    if result.instrs[1].opcode != PH_NOP() { return false }
    true
}

// T78: redundant cmp-after-xor removed — ph_opt_pair drops cmp rX,0 when flags already set
fn compiler_main_test_ph_xor_cmp_redundant_removed() -> bool {
    let xor_rax  = ph_instr_new(PH_XOR(), 0, 0, 0)
    let cmp_zero = ph_instr_imm(PH_CMP(), 0, 0)
    let result = ph_opt_pair(xor_rax, cmp_zero)
    if result.optimized != 1 { return false }
    if result.instrs[1].opcode != PH_NOP() { return false }
    true
}

// T79: ph_run_on_func has no false positives — distinct-dst IrLoadImm pair survives unchanged
fn compiler_main_test_ph_run_on_func_no_false_positives() -> bool {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 5)
    instrs[1] = ir_load_imm(1, 7)
    let func = cp_make_test_func(instrs, 2)
    let result = ph_run_on_func(func)
    if result.instrs[0].op != IrOpcode::IrLoadImm { return false }
    if result.instrs[1].op != IrOpcode::IrLoadImm { return false }
    true
}

// T80: ph_run_on_func eliminates IrCopy self-copies (IrCopy(r,r) → IrNop)
fn compiler_main_test_ph_run_on_func_eliminates_self_copies() -> bool {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_copy(5, 5)
    instrs[1] = ir_copy(7, 7)
    instrs[2] = ir_copy(9, 9)
    let func = cp_make_test_func(instrs, 3)
    let result = ph_run_on_func(func)
    if result.instrs[0].op != IrOpcode::IrNop { return false }
    if result.instrs[1].op != IrOpcode::IrNop { return false }
    if result.instrs[2].op != IrOpcode::IrNop { return false }
    true
}

// ============================================================================
// Sprint 67: Partial-constant identity/annihilation folding (T86-T92)
// ============================================================================

// T86: x * 1 → IrCopy(dst, x) — identity mul, constant on right
fn compiler_main_test_ocp_mul_identity_right() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrCopy && result.instrs[1].dst == 2 && result.instrs[1].src1 == 0
}

// T87: x * 0 → IrLoadImm(dst, 0) — annihilator mul, constant on right
fn compiler_main_test_ocp_mul_annihilator_right() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 0)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrLoadImm && result.instrs[1].dst == 2 && result.instrs[1].imm_i64 == 0
}

// T88: 1 * x → IrCopy(dst, x) — identity mul, constant on left
fn compiler_main_test_ocp_mul_identity_left() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 3)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrCopy && result.instrs[1].dst == 2 && result.instrs[1].src1 == 3
}

// T89: x + 0 → IrCopy(dst, x) — add identity, constant on right
fn compiler_main_test_ocp_add_identity_right() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 0)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrCopy && result.instrs[1].dst == 2 && result.instrs[1].src1 == 0
}

// T90: x - 0 → IrCopy(dst, x) — sub identity
fn compiler_main_test_ocp_sub_identity() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 0)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpSub, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrCopy && result.instrs[1].dst == 2 && result.instrs[1].src1 == 0
}

// T91: x / 1 → IrCopy(dst, x) — div identity
fn compiler_main_test_ocp_div_identity() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpDiv, 1)
    let func = cp_make_test_func(instrs, 2)
    let result = ocp_const_fold(func)
    result.instrs[1].op == IrOpcode::IrCopy && result.instrs[1].dst == 2 && result.instrs[1].src1 == 0
}

// T92: opt_cleanup_function round-trip removes the folded arithmetic op.
fn compiler_main_test_ocp_partial_fold_dce_round_trip() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(1, 1)
    instrs[1] = ir_binop(2, 0, BinaryOp::OpMul, 1)
    instrs[2] = ir_copy(3, 2)
    let func = cp_make_test_func(instrs, 3)
    let result = opt_cleanup_function(func)
    result.instrs[1].op != IrOpcode::IrBinOp
}

// T93: LICM hoists pure invariant instructions into the unique preheader.
fn compiler_main_make_licm_hoist_test_func() -> IrFunction with Mut, Panic, Div {
    var func = ir_empty_function()
    var instrs: [IrInstr; 128] = [ir_nop(); 128]
    instrs[0] = ir_load_imm(0, 1)
    instrs[1] = ir_jump(0)
    instrs[2] = ir_label(0)
    instrs[3] = ir_load_imm(1, 3)
    instrs[4] = ir_binop(2, 4, BinaryOp::OpAdd, 1)
    instrs[5] = ir_branch_true(0, 1)
    instrs[6] = ir_label(2)
    instrs[7] = ir_return(2)
    instrs[8] = ir_label(1)
    instrs[9] = ir_jump(0)
    func.name = make_name("licm_hoist")
    func.instrs = instrs
    func.instr_count = 10
    func.reg_count = 5
    func.label_count = 3
    func.param_count = 1
    func.param_regs[0] = 4
    func
}

// T94: LICM leaves side-effecting calls in place.
fn compiler_main_make_licm_call_test_func() -> IrFunction with Mut, Panic, Div {
    var func = ir_empty_function()
    var instrs: [IrInstr; 128] = [ir_nop(); 128]
    instrs[0] = ir_load_imm(0, 1)
    instrs[1] = ir_jump(0)
    instrs[2] = ir_label(0)
    instrs[3] = ir_call(1, 0, make_name("side_effect"), ir_empty_reg_list(), 0)
    instrs[4] = ir_branch_true(0, 1)
    instrs[5] = ir_label(2)
    instrs[6] = ir_return(1)
    instrs[7] = ir_label(1)
    instrs[8] = ir_jump(0)
    func.name = make_name("licm_call")
    func.instrs = instrs
    func.instr_count = 9
    func.reg_count = 2
    func.label_count = 3
    func
}

fn compiler_main_test_lopt_licm_hoists_invariant() -> bool with Mut, Div, Panic {
    let result = lopt_optimize_function(compiler_main_make_licm_hoist_test_func())
    result.changed && result.invariants_hoisted == 2
}

fn compiler_main_test_lopt_licm_skips_calls() -> bool with Mut, Div, Panic {
    let original = compiler_main_make_licm_call_test_func()
    let result = lopt_optimize_function(original)
    if result.changed { return false }
    if result.invariants_hoisted != 0 { return false }
    if result.func.instr_count != original.instr_count { return false }
    if result.func.instrs[3].op != IrOpcode::IrCall { return false }
    if result.func.instrs[4].op != IrOpcode::IrBranchTrue { return false }
    true
}

