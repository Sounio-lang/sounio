fn compiler_main_test_cli_summary_messages() -> bool with Mut, Panic, Div {
    compiler_check_ok_message() == "check: OK" &&
    compiler_ir_dump_summary(128, 7, 2) == "ir-dump: SOIR v2 binary, 128 bytes, 7 functions, 2 strings" &&
