    if compiler_main_test_dx_or_comp_sat_comm() {
        passed = passed + 1
        println("  T952 OK: Sprint 214 Block DX: ~r0|(r0|r1) -> -1 comm")
    } else { println("  FAIL: T952") }
    if compiler_main_test_dx_no_fold_diff_var() {
        passed = passed + 1
        println("  T953 OK: Sprint 214 Block DX: (r0|r1)|~r2 no fold diff var")
    } else { println("  FAIL: T953") }
    if compiler_main_test_dx_no_fold_no_not() {
        passed = passed + 1
