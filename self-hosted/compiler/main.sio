}

// --probe-machine-ir <file.sio>: load IR, build Machine IR, print stats.
fn run_probe_machine_ir(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 1 >= args.len {
        panic("probe_machine_ir: missing source file argument")
    }
    let source_path = arg_list_get(args, flag_index + 1)
    println("probe_machine_ir: begin")
    print("probe_machine_ir: source=")
    print(source_path)
    print("\n")
    let ir_result = load_multimodule_ir_probe_summary(source_path)
    let parse_errors = parser_last_error_count()
    if ir_result.ok && parse_errors == 0 {
        let mir = native_v2_build_machine_module(&(*ir_result.module), true)
        print("[machine-ir] fn_count=")
        print_int(mir.fn_count)
        print(" ir_instrs=")
        print_int(mir.total_ir_instr_count)
        print(" machine_instrs=")
        print_int(mir.total_machine_instr_count)
        let sup_label = if mir.supported { "true" } else { "false" }
        print(" supported=")
        print(sup_label)
        print("\n")
        return
    }
    println("probe_machine_ir: fail")
    panic("probe_machine_ir failed")
}

// --probe-native-streaming <file.sio>: inspect the single-module native streaming path.
fn run_probe_native_streaming(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
    if flag_index + 1 >= args.len {
        panic("probe_native_streaming: missing source file argument")
    }
    let source_path = arg_list_get(args, flag_index + 1)
    let program = load_module_file(source_path)
    let parse_errors = parser_last_error_count()
    if parse_errors > 0 {
        print("probe_native_streaming: parser_errors=")
        print_int(parse_errors)
        print("\n")
        panic("probe_native_streaming parse failed")
    }

    let imports = extract_imports_from_ast(program)
    print("probe_native_streaming: imports=")
    print_int(imports.count)
    print("\n")
    if imports.count > 0 {
        print("probe_native_streaming: fallback_imports\n")
        return
    }

    var epistemic = ir_empty_epistemic_section()
    let skip_checker = starts_with(source_path, "examples/render/") && imports.count == 0
    if skip_checker {
        print("probe_native_streaming: typecheck_skipped\n")
    } else {
        print("probe_native_streaming: typecheck_begin\n")
        if !check_program_epistemic_into(program, &! epistemic) {
            panic("probe_native_streaming type check failed")
        }
        print("probe_native_streaming: typecheck_ok\n")
    }

    print("probe_native_streaming: summary_begin\n")
    let summary_result = lower_program_to_ir_summary_flat_owned_with_epistemic_ref(&program, epistemic)
    if summary_result.had_error {
        panic("probe_native_streaming summary failed")
    }
    print("probe_native_streaming: summary_ok\n")

    let summary_module = &summary_result.summary.module
    let summary_fn_count = (*summary_module).fn_count
    print("probe_native_streaming: fn_count=")
    print_int(summary_fn_count)
    print("\n")

    var fi: i64 = 0
    while fi < summary_fn_count {
        let fn_name = ir_fn_get(&(*summary_module), fi as usize).name
        print("probe_native_streaming: body_begin fn=")
        compiler_manifest_print_name(fn_name)
        print("\n")
        let body_result = lower_program_function_body_from_summary_flat_with_epistemic_ref(
            &program,
            &summary_result.summary,
            epistemic,
            fn_name
        )
        if body_result.had_error {
            print("probe_native_streaming: body_error fn=")
            compiler_manifest_print_name(fn_name)
            print("\n")
            panic("probe_native_streaming body lowering failed")
        }
        print("probe_native_streaming: body_ir_ok fn=")
        compiler_manifest_print_name(fn_name)
        print(" instrs=")
        print_int(body_result.func.instr_count)
        print(" regs=")
        print_int(body_result.func.reg_count)
        print("\n")
        let lowered = native_v2_lower_function_to_machine(body_result.func)
        print("probe_native_streaming: machine_lower_ok fn=")
        compiler_manifest_print_name(fn_name)
        print(" supported=")
        if lowered.supported { print("true") } else { print("false") }
        if !lowered.supported {
            print(" unsupported=")
            print(lowered.unsupported_detail)
        }
        print("\n")
        let legal = native_v2_legalize_function(lowered)
        print("probe_native_streaming: legalize_ok fn=")
        compiler_manifest_print_name(fn_name)
        print("\n")
        print("probe_native_streaming: body_ok fn=")
        compiler_manifest_print_name(fn_name)
        print("\n")
        print("  fn=")
        compiler_manifest_print_name(fn_name)
        print(" instrs=")
        print_int(body_result.func.instr_count)
        print(" regs=")
        print_int(body_result.func.reg_count)
        print(" temps=")
        print_int(legal.temp_count)
        print(" legal_instrs=")
        print_int(legal.legal_instr_count)
        print("\n")
        fi = fi + 1
    }

    let stream_pair = compile_multimodule_native_maybe_streaming_for_target(source_path, "native", "auto", false)
    print("probe_native_streaming: streaming_used=")
    if stream_pair.0 { print("true") } else { print("false") }
    print(" ok=")
    if stream_pair.1.ok { print("true") } else { print("false") }
    print(" err=")
    print(stream_pair.1.error_msg)
    print(" len=")
    print_int(stream_pair.1.len)
    print("\n")
}

// ============================================================================
// Sprint 74: Mul-annihilation + activation expansion self-tests (T157–T165)
// ============================================================================

// T157: eg_small_saturate on mul(x, 0): extraction gives EG_OP_CONST with value 0.
fn compiler_main_test_eg_small_sat_mul_annihil_rhs() -> bool with Mut, Div, Panic {
    let pair0 = compiler_eg_small_add_const(eg_small_init(), 0)         // const 0
    let pair1 = compiler_eg_small_add_var(pair0.0, 5)                    // var x (reg 5)
    let pair2 = compiler_eg_small_add_binop(pair1.0, EG_OP_MUL, pair1.1, pair0.1)  // mul(x, 0)
    let ctx3  = compiler_eg_small_saturate(pair2.0)
    let pair3 = compiler_eg_small_extract(ctx3, pair2.1)
    pair3.1.op == EG_OP_CONST && pair3.1.value == 0
}

// T158: eg_small_saturate on mul(0, x): extraction gives EG_OP_CONST with value 0.
fn compiler_main_test_eg_small_sat_mul_annihil_lhs() -> bool with Mut, Div, Panic {
    let pair0 = compiler_eg_small_add_const(eg_small_init(), 0)         // const 0
    let pair1 = compiler_eg_small_add_var(pair0.0, 7)                    // var x (reg 7)
    let pair2 = compiler_eg_small_add_binop(pair1.0, EG_OP_MUL, pair0.1, pair1.1)  // mul(0, x)
    let ctx3  = compiler_eg_small_saturate(pair2.0)
    let pair3 = compiler_eg_small_extract(ctx3, pair2.1)
    pair3.1.op == EG_OP_CONST && pair3.1.value == 0
}

// T159: ocp_egraph_mini_pass fires on 7-instr func (new ≤8 guard) — sub(r3,r3) simplifies.
// With old >4 guard this was skipped; with new >8 guard the pass activates.
fn compiler_main_test_ocp_mini_pass_7_instrs() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 10)
    instrs[1] = ir_load_imm(1, 20)
    instrs[2] = ir_load_imm(2, 30)
    instrs[3] = ir_load_imm(3, 40)
    instrs[4] = ir_load_imm(4, 50)
    instrs[5] = ir_load_imm(5, 60)
    instrs[6] = ir_binop(6, 3, BinaryOp::OpSub, 3)   // r6 = r3 - r3 → sub-self → 0
    let func   = cp_make_test_func(instrs, 7)
    let result = ocp_egraph_mini_pass(func)
    // Mini pass fires: sub(r3, r3) → IrLoadImm(r6, 0)
    (IR_A_OP[(ir_region_slot_r(result.region, (6))) as usize] as IrOpcode) == IrOpcode::IrLoadImm && IR_A_IMM_I64[(ir_region_slot_r(result.region, (6))) as usize] == 0
}

// T160: ocp_egraph_mini_pass skips 9-instr func (instr_count=9 > 8).
fn compiler_main_test_ocp_mini_pass_9_instrs() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    instrs[1] = ir_binop(3, 2, BinaryOp::OpMul, 0)
    instrs[2] = ir_binop(4, 3, BinaryOp::OpSub, 1)
    instrs[3] = ir_binop(5, 4, BinaryOp::OpDiv, 0)
    instrs[4] = ir_binop(6, 5, BinaryOp::OpAdd, 2)
    instrs[5] = ir_binop(7, 6, BinaryOp::OpMul, 1)
    instrs[6] = ir_binop(8, 7, BinaryOp::OpSub, 0)
    instrs[7] = ir_binop(9, 8, BinaryOp::OpDiv, 1)
    instrs[8] = ir_binop(10, 9, BinaryOp::OpAdd, 0)
    let func   = cp_make_test_func(instrs, 9)   // instr_count=9 > 8, guard skips
    let result = ocp_egraph_mini_pass(func)
    (IR_A_OP[(ir_region_slot_r(result.region, (0))) as usize] as IrOpcode) == IrOpcode::IrBinOp && result.instr_count == 9
}

// T1000: Hyper-tagged mini e-graph contexts inherit registry reassociation metadata.
fn compiler_main_test_ocp_context_uses_algebra_registry() -> bool with Mut, Div, Panic {
    var func = ir_empty_function()
    func.hyper_algebra_kind = 3

    var algebras = ir_empty_algebra_table()
    var octonion = ir_empty_algebra_info()
    octonion.is_valid = true
    octonion.algebra_tag = 3
    octonion.reassoc_strategy = 2
    algebras.entries[0] = octonion
    algebras.count = 1

    var ctx = eg_small_init()
    ocp_configure_small_context(&! ctx, func, algebras)
    ctx.algebra_kind == 3 && ctx.reassoc_strategy == 2 && ctx.cd_bits == 3
}

fn compiler_main_test_ocp_context_hyper_expr_audit_tag() -> bool with Mut, Div, Panic, Alloc {
    let registry_mask = ir_forbidden_law_mask(3, 2)
    let fallback_mask = ir_forbidden_law_mask(4, 1)
    let registry_expr = check_hyper_expr_law_profile_probe(3, 2, registry_mask, true)
    let fallback_expr = check_hyper_expr_law_profile_probe(4, 1, fallback_mask, false)

    let registry_tag = check_hyper_expr_law_profile_audit_tag(registry_expr)
    let fallback_tag = check_hyper_expr_law_profile_audit_tag(fallback_expr)

    if registry_tag <= 0 { return false }
    if fallback_tag <= 0 { return false }
    if registry_tag == fallback_tag { return false }
    if (registry_tag & 255) != 1 { return false }
    if (fallback_tag & 255) != 0 { return false }
    if (registry_tag >> 8) & 255 != 2 { return false }
    if (fallback_tag >> 8) & 255 != 1 { return false }
    if (registry_tag >> 16) & 255 != registry_expr.op_kind { return false }
    if (fallback_tag >> 16) & 255 != fallback_expr.op_kind { return false }
    if (registry_tag >> 24) & 255 != 3 { return false }
    if (fallback_tag >> 24) & 255 != 4 { return false }
    true
}

// T1200: ir_algebra_info_for_tag returns correct algebraic law properties for each CD tower level.
fn compiler_main_test_algebra_type_properties() -> bool with Mut, Div, Panic {
    let complex   = ir_algebra_info_for_tag(1)
    let quaternion = ir_algebra_info_for_tag(2)
    let octonion   = ir_algebra_info_for_tag(3)
    let sedenion   = ir_algebra_info_for_tag(4)
    // Complex: commutative, associative, alternative
    if !complex.mul_commutative   { return false }
    if !complex.mul_associative   { return false }
    if !complex.mul_alternative   { return false }
    // Quaternion: non-commutative, associative, alternative
    if quaternion.mul_commutative { return false }
    if !quaternion.mul_associative { return false }
    if !quaternion.mul_alternative { return false }
    // Octonion: non-commutative, non-associative, alternative
    if octonion.mul_commutative  { return false }
    if octonion.mul_associative  { return false }
    if !octonion.mul_alternative { return false }
    // Sedenion: non-commutative, non-associative, non-alternative
    if sedenion.mul_commutative  { return false }
    if sedenion.mul_associative  { return false }
    if sedenion.mul_alternative  { return false }
    true
}

// T1201: reassoc_strategy fields encode algebra law enforcement decisions for the CD tower.
// Quaternion: strategy 0 (free — associative).
// Octonion:   strategy 2 (fano_selective — alternative, only Fano-triple-respecting rewrites).
// Sedenion:   strategy 1 (blocked — non-alternative, no reassociation allowed).
// The critical distinction: only octonion gets strategy 2 (fano_selective), gating the 168-theorem path.
fn compiler_main_test_algebra_law_enforcement() -> bool with Mut, Div, Panic {
    let quaternion = ir_algebra_info_for_tag(2)
    let octonion   = ir_algebra_info_for_tag(3)
    let sedenion   = ir_algebra_info_for_tag(4)
    // Quaternion: associative and alternative, strategy 0 (free reassociation)
    let quat_assoc   = quaternion.mul_associative && quaternion.mul_alternative
    let quat_free    = quaternion.reassoc_strategy == 0
    // Octonion: non-associative but alternative → fano_selective (strategy 2)
    let oct_nonassoc = !octonion.mul_associative && octonion.mul_alternative
    let oct_fano     = octonion.reassoc_strategy == 2
    // Sedenion: non-associative AND non-alternative → blocked (strategy 1)
    let sed_blocked  = !sedenion.mul_associative && !sedenion.mul_alternative
    let sed_reassoc  = sedenion.reassoc_strategy == 1
    quat_assoc && quat_free && oct_nonassoc && oct_fano && sed_blocked && sed_reassoc
}

// T161: Both-constant OpLe: 3 <= 3 → IrLoadImm(dst, 1).
fn compiler_main_test_cmp_le_const_true() -> bool with Mut, Div, Panic {
    var instrs = cp_empty_instrs()
    instrs[0] = ir_load_imm(0, 3)
    instrs[1] = ir_load_imm(1, 3)
    instrs[2] = ir_binop(2, 0, BinaryOp::OpLe, 1)
    let func   = cp_make_test_func(instrs, 3)
