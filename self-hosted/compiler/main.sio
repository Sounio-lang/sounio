}

fn compiler_main_test_double_not_const_fold_wins() -> bool with Mut, Div, Panic {
    // When src is a const, const-fold applies: ~(~5) → ~(-6) → 5 (IrLoadImm)
    var instrs: [IrInstr; 1024] = cp_empty_instrs()
