    i = 0
    while i < (*ep).transition_plan_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int((*ep).transition_plans[i].id)
        print(", \"policy_id\": ")
        print_int((*ep).transition_plans[i].transition_policy_id)
        print(", \"policy_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_transition_policy_name(ep, (*ep).transition_plans[i].transition_policy_id))
        print(", \"protocol_id\": ")
        print_int((*ep).transition_plans[i].transition_protocol_id)
        print(", \"protocol_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_transition_protocol_name(ep, (*ep).transition_plans[i].transition_protocol_id))
        print(", \"route_name\": ")
        compiler_manifest_print_name_json((*ep).transition_plans[i].route_name)
        print(", \"rollback_route_name\": ")
        compiler_manifest_print_name_json((*ep).transition_plans[i].rollback_route_name)
        print(", \"alternative_option_id\": ")
        print_int((*ep).transition_plans[i].alternative_option_id)
        print(", \"contest_id\": ")
        print_int((*ep).transition_plans[i].contest_id)
        print(", \"audit_id\": ")
        print_int((*ep).transition_plans[i].audit_id)
        print(", \"audit_name\": ")
        compiler_manifest_print_name_json(compiler_manifest_audit_name(ep, (*ep).transition_plans[i].audit_id))
        print(", \"step_count\": ")
        print_int((*ep).transition_plans[i].step_count)
        print(", \"final_value_repr\": ")
        compiler_manifest_print_name_json((*ep).transition_plans[i].final_value_repr)
        print(", \"final_type\": \"")
        compiler_manifest_print_type_name((*ep).transition_plans[i].inner_ty)
        print("\", \"metric_snapshot\": ")
        compiler_manifest_print_metric_snapshot((*ep).transition_plans[i].metric_known, (*ep).transition_plans[i].metric_values)
        print("}")
        i = i + 1
    }
    print("\n    ],\n")

    print("    \"monitoring_policies\": [\n")
    i = 0
    while i < (*ep).monitoring_policy_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int((*ep).monitoring_policies[i].id)
        print(", \"name\": ")
        compiler_manifest_print_name_json((*ep).monitoring_policies[i].name)
        print(", \"target_type\": \"")
        compiler_manifest_print_type_name((*ep).monitoring_policies[i].target_ty)
        print("\", \"route_name\": ")
        compiler_manifest_print_name_json((*ep).monitoring_policies[i].route_name)
        print(", \"rollback_route_name\": ")
        compiler_manifest_print_name_json((*ep).monitoring_policies[i].rollback_route_name)
        print(", \"requirements\": [")
        var mrk: i64 = 0
        while mrk < (*ep).monitoring_policies[i].requirement_count && mrk < 8 {
            if mrk > 0 { print(", ") }
            compiler_manifest_print_policy_requirement_json((*ep).monitoring_policies[i].requirements[mrk])
            mrk = mrk + 1
        }
        print("]}")
        i = i + 1
    }
    print("\n    ],\n")

    print("    \"observed_transitions\": [\n")
    i = 0
    while i < (*ep).observed_transition_count {
        if i > 0 { print(",\n") }
        print("      {\"id\": ")
        print_int((*ep).observed_transitions[i].id)
