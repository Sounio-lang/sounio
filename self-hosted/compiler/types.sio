// self-hosted::compiler::types
//
// TYPE SYSTEM FOR SOUNIO COMPILER
// No stubs. No fakes. Real implementation.
//
// Defines the type representation and type operations.

use io
use string

// ============================================================================
// TYPE REPRESENTATION
// ============================================================================

enum TypeKind {
    // Primitives
    TInt,
    TFloat,
    TString,
    TBool,
    TUnit,
    
    // Composite
    TTuple,
    TArray,
    TStruct,
    TEnum,
    TFunction,
    
    // Type variables for polymorphism
    TVar,
    
    // Reference types
    TRef,
    
    // Generic
    TGeneric,
    
    // Error
    TError,
}

struct Type {
    kind: TypeKind,
    name: string,           // For named types
    args: Vec<Type>,        // Type arguments
    fields: Vec<Field>,     // For structs
    variants: Vec<Variant>, // For enums
    ret: Type,              // For functions
    effects: Vec<string>,   // Effect types
}

struct Field {
    name: string,
    ty: Type,
}

struct Variant {
    name: string,
    data: Type,  // Unit for simple variants
}

struct TypeVar {
    id: i64,
    name: string,
}

// ============================================================================
// PRIMITIVE TYPES
// ============================================================================

fn type_int() -> Type {
    Type {
        kind: TypeKind::TInt,
        name: "i64",
        args: vec_new(),
        fields: vec_new(),
        variants: vec_new(),
        ret: type_error(),
        effects: vec_new(),
    }
}

fn type_float() -> Type {
    Type {
        kind: TypeKind::TFloat,
        name: "f64",
        args: vec_new(),
        fields: vec_new(),
        variants: vec_new(),
        ret: type_error(),
        effects: vec_new(),
    }
}

fn type_string() -> Type {
    Type {
        kind: TypeKind::TString,
        name: "string",
        args: vec_new(),
        fields: vec_new(),
        variants: vec_new(),
        ret: type_error(),
        effects: vec_new(),
    }
}

fn type_bool() -> Type {
    Type {
        kind: TypeKind::TBool,
        name: "bool",
        args: vec_new(),
        fields: vec_new(),
        variants: vec_new(),
        ret: type_error(),
        effects: vec_new(),
    }
}

fn type_unit() -> Type {
    Type {
        kind: TypeKind::TUnit,
        name: "()",
        args: vec_new(),
        fields: vec_new(),
        variants: vec_new(),
        ret: type_error(),
        effects: vec_new(),
    }
}

fn type_error() -> Type {
    Type {
        kind: TypeKind::TError,
        name: "<error>",
        args: vec_new(),
        fields: vec_new(),
        variants: vec_new(),
        ret: type_error(),
        effects: vec_new(),
    }
}

// ============================================================================
// COMPOSITE TYPE CONSTRUCTORS
// ============================================================================

fn type_array(elem: Type) -> Type {
    Type {
        kind: TypeKind::TArray,
        name: "",
        args: vec_new(),
        fields: vec_new(),
        variants: vec_new(),
        ret: type_error(),
        effects: vec_new(),
    }
}

fn type_tuple(elements: Vec<Type>) -> Type {
    Type {
        kind: TypeKind::TTuple,
        name: "",
        args: elements,
        fields: vec_new(),
        variants: vec_new(),
        ret: type_error(),
        effects: vec_new(),
    }
}

fn type_function(params: Vec<Type>, ret: Type, effects: Vec<string>) -> Type {
    Type {
        kind: TypeKind::TFunction,
        name: "",
        args: params,
        fields: vec_new(),
        variants: vec_new(),
        ret: ret,
        effects: effects,
    }
}

fn type_var(id: i64, name: string) -> Type {
    Type {
        kind: TypeKind::TVar,
        name: name,
        args: vec_new(),
        fields: vec_new(),
        variants: vec_new(),
        ret: type_error(),
        effects: vec_new(),
    }
}

// ============================================================================
// TYPE OPERATIONS
// ============================================================================

fn types_equal(t1: Type, t2: Type) -> bool with {
    if t1.kind != t2.kind {
        false
    } else {
        match t1.kind {
            TypeKind::TInt => true,
            TypeKind::TFloat => true,
            TypeKind::TString => true,
            TypeKind::TBool => true,
            TypeKind::TUnit => true,
            TypeKind::TError => true,
            TypeKind::TVar => t1.name == t2.name,
            TypeKind::TArray => {
                if vec_len(t1.args) == 1 && vec_len(t2.args) == 1 {
                    types_equal(vec_get(t1.args, 0), vec_get(t2.args, 0))
                } else {
                    false
                }
            }
            TypeKind::TTuple => {
                if vec_len(t1.args) == vec_len(t2.args) {
                    var equal = true
                    var i: i64 = 0
                    while i < vec_len(t1.args) {
                        if !types_equal(vec_get(t1.args, i), vec_get(t2.args, i)) {
                            equal = false
                            break
                        }
                        i = i + 1
                    }
                    equal
                } else {
                    false
                }
            }
            TypeKind::TFunction => {
                // Check params
                if vec_len(t1.args) != vec_len(t2.args) {
                    false
                } else {
                    var params_equal = true
                    var i: i64 = 0
                    while i < vec_len(t1.args) {
                        if !types_equal(vec_get(t1.args, i), vec_get(t2.args, i)) {
                            params_equal = false
                            break
                        }
                        i = i + 1
                    }
                    
                    // Check return type
                    let ret_equal = types_equal(t1.ret, t2.ret)
                    
                    params_equal && ret_equal
                }
            }
            _ => t1.name == t2.name,
        }
    }
}

fn is_primitive(t: Type) -> bool with {
    t.kind == TypeKind::TInt ||
    t.kind == TypeKind::TFloat ||
    t.kind == TypeKind::TString ||
    t.kind == TypeKind::TBool ||
    t.kind == TypeKind::TUnit
}

fn is_numeric(t: Type) -> bool with {
    t.kind == TypeKind::TInt || t.kind == TypeKind::TFloat
}

fn is_integer(t: Type) -> bool with {
    t.kind == TypeKind::TInt
}

fn is_comparable(t: Type) -> bool with {
    is_primitive(t)
}

// ============================================================================
// TYPE STRING REPRESENTATION
// ============================================================================

fn type_to_string(t: Type) -> string with Mut, Panic {
    match t.kind {
        TypeKind::TInt => "i64",
        TypeKind::TFloat => "f64",
        TypeKind::TString => "string",
        TypeKind::TBool => "bool",
        TypeKind::TUnit => "()",
        TypeKind::TError => "<error>",
        TypeKind::TVar => "'" + t.name,
        TypeKind::TArray => {
            let elem = vec_get(t.args, 0)
            "[" + type_to_string(elem) + "]"
        }
        TypeKind::TTuple => {
            var result = "("
            var i: i64 = 0
            while i < vec_len(t.args) {
                if i > 0 { result = result + ", " }
                result = result + type_to_string(vec_get(t.args, i))
                i = i + 1
            }
            result + ")"
        }
        TypeKind::TFunction => {
            var result = "fn("
            var i: i64 = 0
            while i < vec_len(t.args) {
                if i > 0 { result = result + ", " }
                result = result + type_to_string(vec_get(t.args, i))
                i = i + 1
            }
            result = result + ")"
            
            if t.ret.kind != TypeKind::TUnit {
                result = result + " -> " + type_to_string(t.ret)
            }
            
            if vec_len(t.effects) > 0 {
                result = result + " with "
                var j: i64 = 0
                while j < vec_len(t.effects) {
                    if j > 0 { result = result + ", " }
                    result = result + vec_get(t.effects, j)
                    j = j + 1
                }
            }
            
            result
        }
        TypeKind::TStruct => t.name,
        TypeKind::TEnum => t.name,
        TypeKind::TGeneric => {
            var result = t.name + "["
            var i: i64 = 0
            while i < vec_len(t.args) {
                if i > 0 { result = result + ", " }
                result = result + type_to_string(vec_get(t.args, i))
                i = i + 1
            }
            result + "]"
        }
        _ => t.name,
    }
}

// ============================================================================
// BUILTIN TYPES
// ============================================================================

struct TypeEnv {
    types: Map<string, Type>,
    parent: Option<TypeEnv>,
}

fn make_builtin_types() -> Map<string, Type> with {
    var types = map_new()
    
    // Primitive types
    map_insert(types, "i64", type_int())
    map_insert(types, "f64", type_float())
    map_insert(types, "string", type_string())
    map_insert(types, "bool", type_bool())
    map_insert(types, "()", type_unit())
    
    // Generic types
    map_insert(types, "Vec", type_generic_vec())
    map_insert(types, "Option", type_generic_option())
    map_insert(types, "Result", type_generic_result())
    
    types
}

fn type_generic_vec() -> Type {
    Type {
        kind: TypeKind::TGeneric,
        name: "Vec",
        args: vec_new(),
        fields: vec_new(),
        variants: vec_new(),
        ret: type_error(),
        effects: vec_new(),
    }
}

fn type_generic_option() -> Type {
    var some = Variant {
        name: "Some",
        data: type_var(0, "T"),
    }
    var none = Variant {
        name: "None",
        data: type_unit(),
    }
    
    var variants = vec_new()
    vec_push(variants, some)
    vec_push(variants, none)
    
    Type {
        kind: TypeKind::TGeneric,
        name: "Option",
        args: vec_new(),
        fields: vec_new(),
        variants: variants,
        ret: type_error(),
        effects: vec_new(),
    }
}

fn type_generic_result() -> Type {
    var ok = Variant {
        name: "Ok",
        data: type_var(0, "T"),
    }
    var err = Variant {
        name: "Err",
        data: type_var(1, "E"),
    }
    
    var variants = vec_new()
    vec_push(variants, ok)
    vec_push(variants, err)
    
    Type {
        kind: TypeKind::TGeneric,
        name: "Result",
        args: vec_new(),
        fields: vec_new(),
        variants: variants,
        ret: type_error(),
        effects: vec_new(),
    }
}

// ============================================================================
// EFFECT TYPES
// ============================================================================

fn effect_io() -> string with { "IO" }
fn effect_mut() -> string with { "Mut" }
fn effect_panic() -> string with { "Panic" }
fn effect_div() -> string with { "Div" }
fn effect_alloc() -> string with { "Alloc" }

fn has_effect(t: Type, effect: string) -> bool with {
    var i: i64 = 0
    while i < vec_len(t.effects) {
        if vec_get(t.effects, i) == effect {
            return true
        }
        i = i + 1
    }
    false
}

fn combine_effects(e1: Vec<string>, e2: Vec<string>) -> Vec<string> with {
    var result = vec_new()
    
    // Add all from e1
    var i: i64 = 0
    while i < vec_len(e1) {
        vec_push(result, vec_get(e1, i))
        i = i + 1
    }
    
    // Add unique from e2
    var j: i64 = 0
    while j < vec_len(e2) {
        let e = vec_get(e2, j)
        if !vec_contains(result, e) {
            vec_push(result, e)
        }
        j = j + 1
    }
    
    result
}

// Helper
fn vec_contains(v: Vec<string>, item: string) -> bool with {
    var i: i64 = 0
    while i < vec_len(v) {
        if vec_get(v, i) == item {
            return true
        }
        i = i + 1
    }
    false
}
