// Madaros v2 S1 receipt contract fingerprints.
//
// This module is deliberately small: S1 is source/module-graph receipt
// infrastructure, not type checking, HLIR, ABI, or optimization.

pub fn madaros_v2_s1_schema_family() -> i64 {
    2101
}

pub fn madaros_v2_s1_schema_version() -> i64 {
    1
}

pub fn madaros_v2_s1_ast_boundary_kind() -> i64 {
    11
}

pub fn madaros_v2_s1_mix(a: i64, b: i64) -> i64 with Mod {
    ((a * 1000003) + b) % 1000000007
}

pub fn madaros_v2_s1_contract_fingerprint() -> i64 with Mod {
    var fp = madaros_v2_s1_schema_family()
    fp = madaros_v2_s1_mix(fp, madaros_v2_s1_schema_version())
    fp = madaros_v2_s1_mix(fp, madaros_v2_s1_ast_boundary_kind())
    fp = madaros_v2_s1_mix(fp, 128)
    fp
}

pub fn madaros_v2_s1_contract_accepts_l1(
    observed_modules: i64,
    unresolved_imports: i64,
    compiler_check_rc: i64
) -> bool {
    observed_modules > 0 && unresolved_imports >= 0 && compiler_check_rc == 0
}
