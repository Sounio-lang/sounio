use check::check::{
    Checker,
    checker_error_count_scalar,
    checker_init_in_place
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    print("k2_check_import_accessor_probe=start\n")
    print("k2_check_import_accessor_probe=alloc_enter\n")
    let checker = heap_alloc(262144) as *mut Checker
    print("k2_check_import_accessor_probe=alloc_ok\n")
    checker_init_in_place(checker)
    print("k2_check_import_accessor_probe=init_ok\n")
    let errors = checker_error_count_scalar(checker)
    print("k2_check_import_accessor_probe=ok errors=")
    print_int(errors)
    print("\n")
    return 0
}
