use lexer::mod::{lex_file_parse_items}
use parser::parser::{parser_last_error_count}
use check::knowledge_context::{knowledge_context_validate_items}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    var path = "tests/frontend/knowledge_static_unit_constraint_positive.sio"
    if argc >= 1 {
        path = get_arg(0)
    }

    let items = lex_file_parse_items(path)
    if parser_last_error_count() > 0 {
        print("parse_errors=")
        print_int(parser_last_error_count())
        print("\n")
        return 2
    }

    let ordinary = knowledge_context_validate_items(items)
    print("knowledge_unit_ordinary_verdict=")
    print_int(ordinary)
    print("\n")

    let semantic = knowledge_context_validate_items(items)
    print("knowledge_unit_semantic_verdict=")
    print_int(semantic)
    print("\n")
    return 0
}
