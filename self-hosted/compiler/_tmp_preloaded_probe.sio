use parser::ast::*
use lexer::mod::*
use io::file_write::*
use parser::mod::{parse_program_preloaded}
use parser::parser::{parser_last_error_count}

fn f(path: string) -> i64 with IO, Mut, Panic, Div, Alloc {
    let state = io_read_source_file(path)
    let _prog = parse_program_preloaded(state.token_count)
    parser_last_error_count()
}

fn main() with IO, Mut, Panic, Div, Alloc {
    print_int(f("/tmp/sprint1_bad_input.sio"))
    print("\n")
}
