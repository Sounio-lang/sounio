// self-hosted::compiler::ontology_bundle_directive
//
// Source-level scanner for `//@ ontology-bundle: "..."` before lexing drops
// comments. This is the first compiler-side rung toward a native bundle loader:
// it only finds directive payloads in source bytes; bundle ingestion and
// ontology side-table population remain separate future work.

pub struct OntologyBundleDirectiveScanResult {
    found: bool,
    count: i64,
    path: string,
    malformed: bool,
}

pub struct OntologyBundleDirectiveLoadPlan {
    found: bool,
    count: i64,
    path: string,
    malformed: bool,
    bundle_exists: bool,
    bundle_size: i64,
    dont_magic_valid: bool,
    dont_version: i64,
    dont_payload_size: i64,
    dont_payload_size_matches: bool,
    payload_has_ontology: bool,
    payload_has_terms: bool,
    payload_has_disjoints: bool,
    payload_term_count: i64,
    payload_disjoint_count: i64,
    payload_ontology: string,
    first_term_present: bool,
    first_term_curie: string,
    first_term_numeric_id: i64,
    first_parent_edge_present: bool,
    first_parent_child_curie: string,
    first_parent_parent_curie: string,
    first_parent_child_numeric_id: i64,
    first_parent_parent_numeric_id: i64,
    first_disjoint_pair_present: bool,
    first_disjoint_left_curie: string,
    first_disjoint_right_curie: string,
    first_disjoint_left_numeric_id: i64,
    first_disjoint_right_numeric_id: i64,
    mini_table_valid: bool,
    mini_class_count: i64,
    mini_class0: i64,
    mini_class1: i64,
    mini_class2: i64,
    mini_class3: i64,
    mini_parent_edge_count: i64,
    mini_parent_child0: i64,
    mini_parent_parent0: i64,
    mini_parent_child1: i64,
    mini_parent_parent1: i64,
    mini_parent_child2: i64,
    mini_parent_parent2: i64,
    mini_parent_child3: i64,
    mini_parent_parent3: i64,
    mini_disjoint_pair_count: i64,
    mini_disjoint_left0: i64,
    mini_disjoint_right0: i64,
    mini_table_truncated: bool,
    kernel_stage_valid: bool,
    kernel_slot_count: i64,
    kernel_slot0: i64,
    kernel_slot1: i64,
    kernel_slot2: i64,
    kernel_slot3: i64,
    kernel_slot4: i64,
    kernel_slot5: i64,
    kernel_subclass_axiom_count: i64,
    kernel_subclass_subject0: i64,
    kernel_subclass_object0: i64,
    kernel_subclass_subject1: i64,
    kernel_subclass_object1: i64,
    kernel_subclass_subject2: i64,
    kernel_subclass_object2: i64,
    kernel_subclass_subject3: i64,
    kernel_subclass_object3: i64,
    kernel_disjoint_axiom_count: i64,
    kernel_disjoint_subject0: i64,
    kernel_disjoint_object0: i64,
    kernel_materialized_valid: bool,
    kernel_materialized_reflexive_count: i64,
    kernel_materialized_subclass_fact_count: i64,
    kernel_materialized_disjoint_fact_count: i64,
    payload_shape_valid: bool,
}

var ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA: [i8; 1048576] = [0; 1048576]

pub fn ontology_bundle_directive_empty_scan_result() -> OntologyBundleDirectiveScanResult {
    OntologyBundleDirectiveScanResult {
        found: false,
        count: 0,
        path: "",
        malformed: false,
    }
}

pub fn ontology_bundle_directive_empty_load_plan() -> OntologyBundleDirectiveLoadPlan {
    OntologyBundleDirectiveLoadPlan {
        found: false,
        count: 0,
        path: "",
        malformed: false,
        bundle_exists: false,
        bundle_size: 0,
        dont_magic_valid: false,
        dont_version: 0,
        dont_payload_size: 0,
        dont_payload_size_matches: false,
        payload_has_ontology: false,
        payload_has_terms: false,
        payload_has_disjoints: false,
        payload_term_count: 0,
        payload_disjoint_count: 0,
        payload_ontology: "",
        first_term_present: false,
        first_term_curie: "",
        first_term_numeric_id: 0 - 1,
        first_parent_edge_present: false,
        first_parent_child_curie: "",
        first_parent_parent_curie: "",
        first_parent_child_numeric_id: 0 - 1,
        first_parent_parent_numeric_id: 0 - 1,
        first_disjoint_pair_present: false,
        first_disjoint_left_curie: "",
        first_disjoint_right_curie: "",
        first_disjoint_left_numeric_id: 0 - 1,
        first_disjoint_right_numeric_id: 0 - 1,
        mini_table_valid: false,
        mini_class_count: 0,
        mini_class0: 0 - 1,
        mini_class1: 0 - 1,
        mini_class2: 0 - 1,
        mini_class3: 0 - 1,
        mini_parent_edge_count: 0,
        mini_parent_child0: 0 - 1,
        mini_parent_parent0: 0 - 1,
        mini_parent_child1: 0 - 1,
        mini_parent_parent1: 0 - 1,
        mini_parent_child2: 0 - 1,
        mini_parent_parent2: 0 - 1,
        mini_parent_child3: 0 - 1,
        mini_parent_parent3: 0 - 1,
        mini_disjoint_pair_count: 0,
        mini_disjoint_left0: 0 - 1,
        mini_disjoint_right0: 0 - 1,
        mini_table_truncated: false,
        kernel_stage_valid: false,
        kernel_slot_count: 0,
        kernel_slot0: 0 - 1,
        kernel_slot1: 0 - 1,
        kernel_slot2: 0 - 1,
        kernel_slot3: 0 - 1,
        kernel_slot4: 0 - 1,
        kernel_slot5: 0 - 1,
        kernel_subclass_axiom_count: 0,
        kernel_subclass_subject0: 0 - 1,
        kernel_subclass_object0: 0 - 1,
        kernel_subclass_subject1: 0 - 1,
        kernel_subclass_object1: 0 - 1,
        kernel_subclass_subject2: 0 - 1,
        kernel_subclass_object2: 0 - 1,
        kernel_subclass_subject3: 0 - 1,
        kernel_subclass_object3: 0 - 1,
        kernel_disjoint_axiom_count: 0,
        kernel_disjoint_subject0: 0 - 1,
        kernel_disjoint_object0: 0 - 1,
        kernel_materialized_valid: false,
        kernel_materialized_reflexive_count: 0,
        kernel_materialized_subclass_fact_count: 0,
        kernel_materialized_disjoint_fact_count: 0,
        payload_shape_valid: false,
    }
}

fn ontology_bundle_directive_byte_u8(b: i8) -> i64 {
    let v = b as i64
    if v < 0 {
        return v + 256
    }
    v
}

fn ontology_bundle_directive_read_le_u32_at(pos: i64) -> i64 {
    let b0 = ontology_bundle_directive_byte_u8(ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[pos as usize])
    let b1 = ontology_bundle_directive_byte_u8(ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[(pos + 1) as usize])
    let b2 = ontology_bundle_directive_byte_u8(ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[(pos + 2) as usize])
    let b3 = ontology_bundle_directive_byte_u8(ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[(pos + 3) as usize])
    b0 + (b1 * 256) + (b2 * 65536) + (b3 * 16777216)
}

fn ontology_bundle_directive_loaded_find_pattern_from(start: i64, size: i64, pattern: string) -> i64 with Mut, Panic, Div {
    let plen = str_len(pattern)
    if plen <= 0 {
        return start
    }
    var i = start
    while i + plen <= size {
        if ontology_bundle_directive_loaded_matches_at(i, size, pattern) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn ontology_bundle_directive_loaded_find_pattern_between(start: i64, end: i64, pattern: string) -> i64 with Mut, Panic, Div {
    let plen = str_len(pattern)
    if plen <= 0 {
        return start
    }
    var i = start
    while i + plen <= end {
        if ontology_bundle_directive_loaded_matches_at(i, end, pattern) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn ontology_bundle_directive_loaded_read_int_after(pattern: string, payload_start: i64, size: i64) -> i64 with Mut, Panic, Div {
    let pos = ontology_bundle_directive_loaded_find_pattern_from(payload_start, size, pattern)
    if pos < 0 {
        return 0 - 1
    }
    var i = pos + str_len(pattern)
    var value: i64 = 0
    var saw_digit = false
    while i < size {
        let ch = ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[i as usize]
        if ch >= (48 as i8) && ch <= (57 as i8) {
            value = (value * 10) + ((ch as i64) - 48)
            saw_digit = true
            i = i + 1
        } else {
            if saw_digit {
                return value
            }
            return 0 - 1
        }
    }
    if saw_digit {
        return value
    }
    0 - 1
}

fn ontology_bundle_directive_loaded_string_after(pattern: string, payload_start: i64, size: i64) -> string with Mut, Panic, Div {
    let pos = ontology_bundle_directive_loaded_find_pattern_from(payload_start, size, pattern)
    if pos < 0 {
        return ""
    }
    var i = pos + str_len(pattern)
    var value = ""
    while i < size && ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[i as usize] != (34 as i8) {
        value = str_concat(value, ontology_bundle_directive_byte_to_str(ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[i as usize]))
        i = i + 1
    }
    value
}

fn ontology_bundle_directive_loaded_string_after_between(pattern: string, start: i64, end: i64) -> string with Mut, Panic, Div {
    let pos = ontology_bundle_directive_loaded_find_pattern_between(start, end, pattern)
    if pos < 0 {
        return ""
    }
    var i = pos + str_len(pattern)
    var value = ""
    while i < end && ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[i as usize] != (34 as i8) {
        value = str_concat(value, ontology_bundle_directive_byte_to_str(ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[i as usize]))
        i = i + 1
    }
    value
}

fn ontology_bundle_directive_loaded_quoted_string_at(start: i64, end: i64) -> string with Mut, Panic, Div {
    if start >= end || ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[start as usize] != (34 as i8) {
        return ""
    }
    var i = start + 1
    var value = ""
    while i < end && ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[i as usize] != (34 as i8) {
        value = str_concat(value, ontology_bundle_directive_byte_to_str(ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[i as usize]))
        i = i + 1
    }
    value
}

fn ontology_bundle_directive_curie_numeric_tail(curie: string) -> i64 with Mut, Panic, Div {
    let n = str_len(curie)
    var colon: i64 = 0 - 1
    var i: i64 = 0
    while i < n {
        if str_char_at(curie, i) == 58 {
            colon = i
        }
        i = i + 1
    }
    if colon < 0 || colon + 1 >= n {
        return 0 - 1
    }
    var value: i64 = 0
    i = colon + 1
    while i < n {
        let ch = str_char_at(curie, i)
        if ch < 48 || ch > 57 {
            return 0 - 1
        }
        value = (value * 10) + (ch - 48)
        i = i + 1
    }
    value
}

fn ontology_bundle_directive_curie_cache_id(curie: string, size: i64) -> i64 with Mut, Panic, Div {
    let numeric = ontology_bundle_directive_curie_numeric_tail(curie)
    if numeric >= 0 {
        return numeric
    }
    let payload_start: i64 = 12
    let curie_pattern = "\"curie\":\""
    var search = payload_start
    var idx: i64 = 0
    while search < size {
        let curie_pos = ontology_bundle_directive_loaded_find_pattern_from(search, size, curie_pattern)
        if curie_pos < 0 {
            return 0 - 1
        }
        let candidate = ontology_bundle_directive_loaded_string_after_between(curie_pattern, curie_pos, size)
        if candidate == curie {
            return 900000000 + idx
        }
        idx = idx + 1
        search = curie_pos + str_len(curie_pattern) + 1
    }
    0 - 1
}

fn ontology_bundle_directive_extract_first_parent_edge(size: i64, plan: OntologyBundleDirectiveLoadPlan) -> OntologyBundleDirectiveLoadPlan with Mut, Panic, Div {
    var p = plan
    let payload_start: i64 = 12
    let curie_pattern = "\"curie\":\""
    let next_term_pattern = "},{\"curie\":\""
    let parents_pattern = "\"parents\":["
    var search = payload_start
    while search < size {
        let curie_pos = ontology_bundle_directive_loaded_find_pattern_from(search, size, curie_pattern)
        if curie_pos < 0 {
            return p
        }
        var term_end = ontology_bundle_directive_loaded_find_pattern_from(curie_pos + str_len(curie_pattern), size, next_term_pattern)
        if term_end < 0 {
            term_end = size
        }
        let child = ontology_bundle_directive_loaded_string_after_between(curie_pattern, curie_pos, term_end)
        let parents_pos = ontology_bundle_directive_loaded_find_pattern_between(curie_pos, term_end, parents_pattern)
        if parents_pos >= 0 {
            var parent_start = parents_pos + str_len(parents_pattern)
            while parent_start < term_end &&
                  ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[parent_start as usize] != (34 as i8) &&
                  ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[parent_start as usize] != (93 as i8) {
                parent_start = parent_start + 1
            }
            let parent = ontology_bundle_directive_loaded_quoted_string_at(parent_start, term_end)
            if str_len(child) > 0 && str_len(parent) > 0 {
                p.first_parent_edge_present = true
                p.first_parent_child_curie = child
                p.first_parent_parent_curie = parent
                p.first_parent_child_numeric_id = ontology_bundle_directive_curie_numeric_tail(child)
                p.first_parent_parent_numeric_id = ontology_bundle_directive_curie_numeric_tail(parent)
                return p
            }
        }
        search = term_end + 1
    }
    p
}

fn ontology_bundle_directive_set_mini_class(plan: OntologyBundleDirectiveLoadPlan, index: i64, value: i64) -> OntologyBundleDirectiveLoadPlan {
    var p = plan
    if index == 0 { p.mini_class0 = value }
    if index == 1 { p.mini_class1 = value }
    if index == 2 { p.mini_class2 = value }
    if index == 3 { p.mini_class3 = value }
    p
}

fn ontology_bundle_directive_set_mini_parent_edge(plan: OntologyBundleDirectiveLoadPlan, index: i64, child: i64, parent: i64) -> OntologyBundleDirectiveLoadPlan {
    var p = plan
    if index == 0 {
        p.mini_parent_child0 = child
        p.mini_parent_parent0 = parent
    }
    if index == 1 {
        p.mini_parent_child1 = child
        p.mini_parent_parent1 = parent
    }
    if index == 2 {
        p.mini_parent_child2 = child
        p.mini_parent_parent2 = parent
    }
    if index == 3 {
        p.mini_parent_child3 = child
        p.mini_parent_parent3 = parent
    }
    p
}

pub fn ontology_bundle_directive_mini_class_at(plan: OntologyBundleDirectiveLoadPlan, index: i64) -> i64 {
    if index == 0 { return plan.mini_class0 }
    if index == 1 { return plan.mini_class1 }
    if index == 2 { return plan.mini_class2 }
    if index == 3 { return plan.mini_class3 }
    0 - 1
}

pub fn ontology_bundle_directive_mini_parent_child_at(plan: OntologyBundleDirectiveLoadPlan, index: i64) -> i64 {
    if index == 0 { return plan.mini_parent_child0 }
    if index == 1 { return plan.mini_parent_child1 }
    if index == 2 { return plan.mini_parent_child2 }
    if index == 3 { return plan.mini_parent_child3 }
    0 - 1
}

pub fn ontology_bundle_directive_mini_parent_parent_at(plan: OntologyBundleDirectiveLoadPlan, index: i64) -> i64 {
    if index == 0 { return plan.mini_parent_parent0 }
    if index == 1 { return plan.mini_parent_parent1 }
    if index == 2 { return plan.mini_parent_parent2 }
    if index == 3 { return plan.mini_parent_parent3 }
    0 - 1
}

pub fn ontology_bundle_directive_mini_contains_class(plan: OntologyBundleDirectiveLoadPlan, class_id: i64) -> bool {
    if !plan.mini_table_valid {
        return false
    }
    var i: i64 = 0
    while i < 4 && i < plan.mini_class_count {
        if ontology_bundle_directive_mini_class_at(plan, i) == class_id {
            return true
        }
        i = i + 1
    }
    false
}

pub fn ontology_bundle_directive_mini_direct_subclass_of(plan: OntologyBundleDirectiveLoadPlan, child_id: i64, parent_id: i64) -> bool {
    if !plan.mini_table_valid {
        return false
    }
    var i: i64 = 0
    while i < 4 && i < plan.mini_parent_edge_count {
        if ontology_bundle_directive_mini_parent_child_at(plan, i) == child_id &&
           ontology_bundle_directive_mini_parent_parent_at(plan, i) == parent_id {
            return true
        }
        i = i + 1
    }
    false
}

pub fn ontology_bundle_directive_mini_subclass_chain_has(plan: OntologyBundleDirectiveLoadPlan, child_id: i64, parent_id: i64) -> bool {
    if !plan.mini_table_valid {
        return false
    }
    if child_id == parent_id {
        return ontology_bundle_directive_mini_contains_class(plan, child_id)
    }
    var current = child_id
    var depth: i64 = 0
    while depth < 4 {
        if ontology_bundle_directive_mini_direct_subclass_of(plan, current, parent_id) {
            return true
        }
        var next_parent: i64 = 0 - 1
        var i: i64 = 0
        while i < 4 && i < plan.mini_parent_edge_count && next_parent < 0 {
            if ontology_bundle_directive_mini_parent_child_at(plan, i) == current {
                next_parent = ontology_bundle_directive_mini_parent_parent_at(plan, i)
            }
            i = i + 1
        }
        if next_parent < 0 {
            return false
        }
        current = next_parent
        depth = depth + 1
    }
    false
}

pub fn ontology_bundle_directive_mini_are_disjoint(plan: OntologyBundleDirectiveLoadPlan, left_id: i64, right_id: i64) -> bool {
    if !plan.mini_table_valid || plan.mini_disjoint_pair_count <= 0 {
        return false
    }
    (plan.mini_disjoint_left0 == left_id && plan.mini_disjoint_right0 == right_id) ||
    (plan.mini_disjoint_left0 == right_id && plan.mini_disjoint_right0 == left_id)
}

pub fn ontology_bundle_directive_kernel_slot_at(plan: OntologyBundleDirectiveLoadPlan, index: i64) -> i64 {
    if index == 0 { return plan.kernel_slot0 }
    if index == 1 { return plan.kernel_slot1 }
    if index == 2 { return plan.kernel_slot2 }
    if index == 3 { return plan.kernel_slot3 }
    if index == 4 { return plan.kernel_slot4 }
    if index == 5 { return plan.kernel_slot5 }
    0 - 1
}

fn ontology_bundle_directive_set_kernel_slot(plan: OntologyBundleDirectiveLoadPlan, index: i64, value: i64) -> OntologyBundleDirectiveLoadPlan {
    var p = plan
    if index == 0 { p.kernel_slot0 = value }
    if index == 1 { p.kernel_slot1 = value }
    if index == 2 { p.kernel_slot2 = value }
    if index == 3 { p.kernel_slot3 = value }
    if index == 4 { p.kernel_slot4 = value }
    if index == 5 { p.kernel_slot5 = value }
    p
}

pub fn ontology_bundle_directive_kernel_find_slot(plan: OntologyBundleDirectiveLoadPlan, class_id: i64) -> i64 {
    if !plan.kernel_stage_valid && plan.kernel_slot_count <= 0 {
        return 0 - 1
    }
    var i: i64 = 0
    while i < 6 && i < plan.kernel_slot_count {
        if ontology_bundle_directive_kernel_slot_at(plan, i) == class_id {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn ontology_bundle_directive_kernel_add_slot(plan: OntologyBundleDirectiveLoadPlan, class_id: i64) -> OntologyBundleDirectiveLoadPlan {
    var p = plan
    if class_id < 0 {
        return p
    }
    if ontology_bundle_directive_kernel_find_slot(p, class_id) >= 0 {
        return p
    }
    if p.kernel_slot_count < 6 {
        p = ontology_bundle_directive_set_kernel_slot(p, p.kernel_slot_count, class_id)
        p.kernel_slot_count = p.kernel_slot_count + 1
    }
    p
}

pub fn ontology_bundle_directive_kernel_subclass_subject_at(plan: OntologyBundleDirectiveLoadPlan, index: i64) -> i64 {
    if index == 0 { return plan.kernel_subclass_subject0 }
    if index == 1 { return plan.kernel_subclass_subject1 }
    if index == 2 { return plan.kernel_subclass_subject2 }
    if index == 3 { return plan.kernel_subclass_subject3 }
    0 - 1
}

pub fn ontology_bundle_directive_kernel_subclass_object_at(plan: OntologyBundleDirectiveLoadPlan, index: i64) -> i64 {
    if index == 0 { return plan.kernel_subclass_object0 }
    if index == 1 { return plan.kernel_subclass_object1 }
    if index == 2 { return plan.kernel_subclass_object2 }
    if index == 3 { return plan.kernel_subclass_object3 }
    0 - 1
}

fn ontology_bundle_directive_set_kernel_subclass_axiom(plan: OntologyBundleDirectiveLoadPlan, index: i64, subject: i64, object: i64) -> OntologyBundleDirectiveLoadPlan {
    var p = plan
    if index == 0 {
        p.kernel_subclass_subject0 = subject
        p.kernel_subclass_object0 = object
    }
    if index == 1 {
        p.kernel_subclass_subject1 = subject
        p.kernel_subclass_object1 = object
    }
    if index == 2 {
        p.kernel_subclass_subject2 = subject
        p.kernel_subclass_object2 = object
    }
    if index == 3 {
        p.kernel_subclass_subject3 = subject
        p.kernel_subclass_object3 = object
    }
    p
}

fn ontology_bundle_directive_kernel_stage_parent_edge(plan: OntologyBundleDirectiveLoadPlan, child_id: i64, parent_id: i64) -> OntologyBundleDirectiveLoadPlan {
    var p = plan
    let child_slot = ontology_bundle_directive_kernel_find_slot(p, child_id)
    let parent_slot = ontology_bundle_directive_kernel_find_slot(p, parent_id)
    if child_slot >= 0 && parent_slot >= 0 && p.kernel_subclass_axiom_count < 4 {
        p = ontology_bundle_directive_set_kernel_subclass_axiom(p, p.kernel_subclass_axiom_count, child_slot, parent_slot)
        p.kernel_subclass_axiom_count = p.kernel_subclass_axiom_count + 1
    }
    p
}

pub fn ontology_bundle_directive_kernel_direct_subclass_of(plan: OntologyBundleDirectiveLoadPlan, child_id: i64, parent_id: i64) -> bool {
    if !plan.kernel_stage_valid {
        return false
    }
    let child_slot = ontology_bundle_directive_kernel_find_slot(plan, child_id)
    let parent_slot = ontology_bundle_directive_kernel_find_slot(plan, parent_id)
    if child_slot < 0 || parent_slot < 0 {
        return false
    }
    var i: i64 = 0
    while i < 4 && i < plan.kernel_subclass_axiom_count {
        if ontology_bundle_directive_kernel_subclass_subject_at(plan, i) == child_slot &&
           ontology_bundle_directive_kernel_subclass_object_at(plan, i) == parent_slot {
            return true
        }
        i = i + 1
    }
    false
}

pub fn ontology_bundle_directive_kernel_subclass_chain_has(plan: OntologyBundleDirectiveLoadPlan, child_id: i64, parent_id: i64) -> bool {
    if !plan.kernel_stage_valid {
        return false
    }
    if child_id == parent_id {
        return ontology_bundle_directive_kernel_find_slot(plan, child_id) >= 0
    }
    var current = child_id
    var depth: i64 = 0
    while depth < 6 {
        if ontology_bundle_directive_kernel_direct_subclass_of(plan, current, parent_id) {
            return true
        }
        var next_parent: i64 = 0 - 1
        var i: i64 = 0
        while i < 4 && i < plan.kernel_subclass_axiom_count && next_parent < 0 {
            let subject_slot = ontology_bundle_directive_kernel_subclass_subject_at(plan, i)
            let object_slot = ontology_bundle_directive_kernel_subclass_object_at(plan, i)
            if ontology_bundle_directive_kernel_slot_at(plan, subject_slot) == current {
                next_parent = ontology_bundle_directive_kernel_slot_at(plan, object_slot)
            }
            i = i + 1
        }
        if next_parent < 0 {
            return false
        }
        current = next_parent
        depth = depth + 1
    }
    false
}

pub fn ontology_bundle_directive_kernel_are_disjoint(plan: OntologyBundleDirectiveLoadPlan, left_id: i64, right_id: i64) -> bool {
    if !plan.kernel_stage_valid || plan.kernel_disjoint_axiom_count <= 0 {
        return false
    }
    let left_slot = ontology_bundle_directive_kernel_find_slot(plan, left_id)
    let right_slot = ontology_bundle_directive_kernel_find_slot(plan, right_id)
    if left_slot < 0 || right_slot < 0 {
        return false
    }
    (plan.kernel_disjoint_subject0 == left_slot && plan.kernel_disjoint_object0 == right_slot) ||
    (plan.kernel_disjoint_subject0 == right_slot && plan.kernel_disjoint_object0 == left_slot)
}

pub fn ontology_bundle_directive_kernel_materialized_subclass_slot(plan: OntologyBundleDirectiveLoadPlan, sub_slot: i64, super_slot: i64) -> bool {
    if !plan.kernel_materialized_valid {
        return false
    }
    if sub_slot < 0 || super_slot < 0 || sub_slot >= plan.kernel_slot_count || super_slot >= plan.kernel_slot_count {
        return false
    }
    if sub_slot == super_slot {
        return true
    }
    var current = sub_slot
    var depth: i64 = 0
    while depth < 6 {
        var next_slot: i64 = 0 - 1
        var i: i64 = 0
        while i < 4 && i < plan.kernel_subclass_axiom_count && next_slot < 0 {
            if ontology_bundle_directive_kernel_subclass_subject_at(plan, i) == current {
                let object_slot = ontology_bundle_directive_kernel_subclass_object_at(plan, i)
                if object_slot == super_slot {
                    return true
                }
                next_slot = object_slot
            }
            i = i + 1
        }
        if next_slot < 0 {
            return false
        }
        current = next_slot
        depth = depth + 1
    }
    false
}

pub fn ontology_bundle_directive_kernel_materialized_subclass_of(plan: OntologyBundleDirectiveLoadPlan, child_id: i64, parent_id: i64) -> bool {
    let child_slot = ontology_bundle_directive_kernel_find_slot(plan, child_id)
    let parent_slot = ontology_bundle_directive_kernel_find_slot(plan, parent_id)
    ontology_bundle_directive_kernel_materialized_subclass_slot(plan, child_slot, parent_slot)
}

pub fn ontology_bundle_directive_kernel_materialized_disjoint_slot(plan: OntologyBundleDirectiveLoadPlan, left_slot: i64, right_slot: i64) -> bool {
    if !plan.kernel_materialized_valid || plan.kernel_disjoint_axiom_count <= 0 {
        return false
    }
    if left_slot < 0 || right_slot < 0 || left_slot >= plan.kernel_slot_count || right_slot >= plan.kernel_slot_count {
        return false
    }
    (plan.kernel_disjoint_subject0 == left_slot && plan.kernel_disjoint_object0 == right_slot) ||
    (plan.kernel_disjoint_subject0 == right_slot && plan.kernel_disjoint_object0 == left_slot)
}

pub fn ontology_bundle_directive_kernel_materialized_are_disjoint(plan: OntologyBundleDirectiveLoadPlan, left_id: i64, right_id: i64) -> bool {
    let left_slot = ontology_bundle_directive_kernel_find_slot(plan, left_id)
    let right_slot = ontology_bundle_directive_kernel_find_slot(plan, right_id)
    ontology_bundle_directive_kernel_materialized_disjoint_slot(plan, left_slot, right_slot)
}

fn ontology_bundle_directive_kernel_materialized_subclass_fact_count(plan: OntologyBundleDirectiveLoadPlan) -> i64 {
    var count: i64 = 0
    var sub: i64 = 0
    while sub < 6 && sub < plan.kernel_slot_count {
        var sup: i64 = 0
        while sup < 6 && sup < plan.kernel_slot_count {
            if ontology_bundle_directive_kernel_materialized_subclass_slot(plan, sub, sup) {
                count = count + 1
            }
            sup = sup + 1
        }
        sub = sub + 1
    }
    count
}

fn ontology_bundle_directive_kernel_materialized_disjoint_fact_count(plan: OntologyBundleDirectiveLoadPlan) -> i64 {
    var count: i64 = 0
    var left: i64 = 0
    while left < 6 && left < plan.kernel_slot_count {
        var right: i64 = 0
        while right < 6 && right < plan.kernel_slot_count {
            if ontology_bundle_directive_kernel_materialized_disjoint_slot(plan, left, right) {
                count = count + 1
            }
            right = right + 1
        }
        left = left + 1
    }
    count
}

fn ontology_bundle_directive_materialize_kernel_rows(plan: OntologyBundleDirectiveLoadPlan) -> OntologyBundleDirectiveLoadPlan {
    var p = plan
    if !p.kernel_stage_valid {
        return p
    }
    p.kernel_materialized_valid = true
    p.kernel_materialized_reflexive_count = p.kernel_slot_count
    p.kernel_materialized_subclass_fact_count = ontology_bundle_directive_kernel_materialized_subclass_fact_count(p)
    p.kernel_materialized_disjoint_fact_count = ontology_bundle_directive_kernel_materialized_disjoint_fact_count(p)
    p
}

fn ontology_bundle_directive_digit_to_string(n: i64) -> string {
    if n == 0 { return "0" }
    if n == 1 { return "1" }
    if n == 2 { return "2" }
    if n == 3 { return "3" }
    if n == 4 { return "4" }
    if n == 5 { return "5" }
    if n == 6 { return "6" }
    if n == 7 { return "7" }
    if n == 8 { return "8" }
    if n == 9 { return "9" }
    "?"
}

fn ontology_bundle_directive_i64_to_string(n: i64) -> string with Mut, Panic, Div {
    if n == 0 {
        return "0"
    }
    if n < 0 {
        return str_concat("-", ontology_bundle_directive_i64_to_string(0 - n))
    }
    var value = n
    var out = ""
    while value > 0 {
        let digit = value - ((value / 10) * 10)
        out = ontology_bundle_directive_digit_to_string(digit) ++ out
        value = value / 10
    }
    out
}

fn ontology_bundle_directive_cache_bool(value: bool) -> string {
    if value { "1" } else { "0" }
}

fn ontology_bundle_directive_cache_i64(value: i64) -> string with Mut, Panic, Div {
    ontology_bundle_directive_i64_to_string(value)
}

fn ontology_bundle_directive_append_cache_line(cache: string, key: string, value: string) -> string {
    cache ++ key ++ "=" ++ value ++ "\n"
}

fn ontology_bundle_directive_render_kernel_slots(plan: OntologyBundleDirectiveLoadPlan) -> string with Mut, Panic, Div {
    var out = ""
    var i: i64 = 0
    while i < 6 && i < plan.kernel_slot_count {
        if i > 0 {
            out = out ++ ","
        }
        out = out ++ ontology_bundle_directive_cache_i64(ontology_bundle_directive_kernel_slot_at(plan, i))
        i = i + 1
    }
    out
}

fn ontology_bundle_directive_render_kernel_subclass_axioms(plan: OntologyBundleDirectiveLoadPlan) -> string with Mut, Panic, Div {
    var out = ""
    var i: i64 = 0
    while i < 4 && i < plan.kernel_subclass_axiom_count {
        if i > 0 {
            out = out ++ ","
        }
        out = out ++ ontology_bundle_directive_cache_i64(ontology_bundle_directive_kernel_subclass_subject_at(plan, i))
        out = out ++ ">"
        out = out ++ ontology_bundle_directive_cache_i64(ontology_bundle_directive_kernel_subclass_object_at(plan, i))
        i = i + 1
    }
    out
}

fn ontology_bundle_directive_render_kernel_disjoint_axioms(plan: OntologyBundleDirectiveLoadPlan) -> string with Mut, Panic, Div {
    if plan.kernel_disjoint_axiom_count <= 0 {
        return ""
    }
    ontology_bundle_directive_cache_i64(plan.kernel_disjoint_subject0) ++ "<>" ++ ontology_bundle_directive_cache_i64(plan.kernel_disjoint_object0)
}

pub fn ontology_bundle_directive_render_native_side_table_cache(plan: OntologyBundleDirectiveLoadPlan) -> string with Mut, Panic, Div {
    var out = "// Sounio native ontology side-table .ontocache v1\n"
    out = ontology_bundle_directive_append_cache_line(out, "format", "bounded-kernel-facts")
    out = ontology_bundle_directive_append_cache_line(out, "source_bundle", plan.path)
    out = ontology_bundle_directive_append_cache_line(out, "ontology", plan.payload_ontology)
    out = ontology_bundle_directive_append_cache_line(out, "dont_version", ontology_bundle_directive_cache_i64(plan.dont_version))
    out = ontology_bundle_directive_append_cache_line(out, "dont_payload_size", ontology_bundle_directive_cache_i64(plan.dont_payload_size))
    out = ontology_bundle_directive_append_cache_line(out, "payload_term_count", ontology_bundle_directive_cache_i64(plan.payload_term_count))
    out = ontology_bundle_directive_append_cache_line(out, "payload_disjoint_count", ontology_bundle_directive_cache_i64(plan.payload_disjoint_count))
    out = ontology_bundle_directive_append_cache_line(out, "mini_table_truncated", ontology_bundle_directive_cache_bool(plan.mini_table_truncated))
    out = ontology_bundle_directive_append_cache_line(out, "kernel_stage_valid", ontology_bundle_directive_cache_bool(plan.kernel_stage_valid))
    out = ontology_bundle_directive_append_cache_line(out, "kernel_slot_count", ontology_bundle_directive_cache_i64(plan.kernel_slot_count))
    out = ontology_bundle_directive_append_cache_line(out, "kernel_slots", ontology_bundle_directive_render_kernel_slots(plan))
    out = ontology_bundle_directive_append_cache_line(out, "kernel_subclass_axiom_count", ontology_bundle_directive_cache_i64(plan.kernel_subclass_axiom_count))
    out = ontology_bundle_directive_append_cache_line(out, "kernel_subclass_axioms", ontology_bundle_directive_render_kernel_subclass_axioms(plan))
    out = ontology_bundle_directive_append_cache_line(out, "kernel_disjoint_axiom_count", ontology_bundle_directive_cache_i64(plan.kernel_disjoint_axiom_count))
    out = ontology_bundle_directive_append_cache_line(out, "kernel_disjoint_axioms", ontology_bundle_directive_render_kernel_disjoint_axioms(plan))
    out = ontology_bundle_directive_append_cache_line(out, "kernel_materialized_valid", ontology_bundle_directive_cache_bool(plan.kernel_materialized_valid))
    out = ontology_bundle_directive_append_cache_line(out, "kernel_materialized_reflexive_count", ontology_bundle_directive_cache_i64(plan.kernel_materialized_reflexive_count))
    out = ontology_bundle_directive_append_cache_line(out, "kernel_materialized_subclass_fact_count", ontology_bundle_directive_cache_i64(plan.kernel_materialized_subclass_fact_count))
    out = ontology_bundle_directive_append_cache_line(out, "kernel_materialized_disjoint_fact_count", ontology_bundle_directive_cache_i64(plan.kernel_materialized_disjoint_fact_count))
    ontology_bundle_directive_append_cache_line(out, "authority", "compiler-side-bounded-side-table-cache-not-live-checker-kernel")
}

pub fn ontology_bundle_directive_write_native_side_table_cache(plan: OntologyBundleDirectiveLoadPlan, cache_path: string) -> bool with IO, Mut, Panic, Div {
    if !plan.kernel_materialized_valid {
        return false
    }
    let text = ontology_bundle_directive_render_native_side_table_cache(plan)
    var bytes: [i8; 8192] = [0; 8192]
    let n = str_len(text)
    if n <= 0 || n > 8192 {
        return false
    }
    var i: i64 = 0
    while i < n {
        bytes[i as usize] = str_char_at(text, i) as i8
        i = i + 1
    }
    write_file(cache_path, bytes, n) >= 0
}

fn ontology_bundle_directive_loaded_line_value_after(pattern: string, start: i64, size: i64) -> string with Mut, Panic, Div {
    let pos = ontology_bundle_directive_loaded_find_pattern_from(start, size, pattern)
    if pos < 0 {
        return ""
    }
    var i = pos + str_len(pattern)
    var value = ""
    while i < size && ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[i as usize] != (10 as i8) {
        value = value ++ ontology_bundle_directive_byte_to_str(ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[i as usize])
        i = i + 1
    }
    value
}

fn ontology_bundle_directive_loaded_bool_after(pattern: string, start: i64, size: i64) -> bool with Mut, Panic, Div {
    let pos = ontology_bundle_directive_loaded_find_pattern_from(start, size, pattern)
    if pos < 0 {
        return false
    }
    let value_pos = pos + str_len(pattern)
    value_pos < size && ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[value_pos as usize] == (49 as i8)
}

fn ontology_bundle_directive_cache_skip_to_next_int(pos: i64, end: i64) -> i64 {
    var i = pos
    while i < end {
        let ch = ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[i as usize]
        if ch >= (48 as i8) && ch <= (57 as i8) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn ontology_bundle_directive_cache_read_int_at(pos: i64, end: i64) -> (i64, i64) {
    var i = pos
    var value: i64 = 0
    var saw_digit = false
    while i < end {
        let ch = ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[i as usize]
        if ch >= (48 as i8) && ch <= (57 as i8) {
            value = (value * 10) + ((ch as i64) - 48)
            saw_digit = true
            i = i + 1
        } else {
            if saw_digit {
                return (value, i)
            }
            return (0 - 1, i)
        }
    }
    if saw_digit {
        return (value, i)
    }
    (0 - 1, i)
}

fn ontology_bundle_directive_hydrate_cache_slots(size: i64, plan: OntologyBundleDirectiveLoadPlan) -> OntologyBundleDirectiveLoadPlan with Mut, Panic, Div {
    var p = plan
    let pos = ontology_bundle_directive_loaded_find_pattern_from(0, size, "kernel_slots=")
    if pos < 0 {
        return p
    }
    let end = ontology_bundle_directive_loaded_line_end(pos, size)
    var cursor = pos + str_len("kernel_slots=")
    var idx: i64 = 0
    while idx < 6 && cursor < end {
        cursor = ontology_bundle_directive_cache_skip_to_next_int(cursor, end)
        if cursor < 0 {
            return p
        }
        let pair = ontology_bundle_directive_cache_read_int_at(cursor, end)
        if pair.0 < 0 {
            return p
        }
        p = ontology_bundle_directive_set_kernel_slot(p, idx, pair.0)
        idx = idx + 1
        cursor = pair.1 + 1
    }
    p.kernel_slot_count = idx
    p
}

fn ontology_bundle_directive_hydrate_cache_subclass_axioms(size: i64, plan: OntologyBundleDirectiveLoadPlan) -> OntologyBundleDirectiveLoadPlan with Mut, Panic, Div {
    var p = plan
    let pos = ontology_bundle_directive_loaded_find_pattern_from(0, size, "kernel_subclass_axioms=")
    if pos < 0 {
        return p
    }
    let end = ontology_bundle_directive_loaded_line_end(pos, size)
    var cursor = pos + str_len("kernel_subclass_axioms=")
    var idx: i64 = 0
    while idx < 4 && cursor < end {
        cursor = ontology_bundle_directive_cache_skip_to_next_int(cursor, end)
        if cursor < 0 {
            return p
        }
        let subject_pair = ontology_bundle_directive_cache_read_int_at(cursor, end)
        if subject_pair.0 < 0 {
            return p
        }
        cursor = ontology_bundle_directive_cache_skip_to_next_int(subject_pair.1, end)
        if cursor < 0 {
            return p
        }
        let object_pair = ontology_bundle_directive_cache_read_int_at(cursor, end)
        if object_pair.0 < 0 {
            return p
        }
        p = ontology_bundle_directive_set_kernel_subclass_axiom(p, idx, subject_pair.0, object_pair.0)
        idx = idx + 1
        cursor = object_pair.1 + 1
    }
    p.kernel_subclass_axiom_count = idx
    p
}

fn ontology_bundle_directive_hydrate_cache_disjoint_axioms(size: i64, plan: OntologyBundleDirectiveLoadPlan) -> OntologyBundleDirectiveLoadPlan with Mut, Panic, Div {
    var p = plan
    let declared_count = ontology_bundle_directive_loaded_read_int_after("kernel_disjoint_axiom_count=", 0, size)
    if declared_count <= 0 {
        p.kernel_disjoint_axiom_count = 0
        return p
    }
    let pos = ontology_bundle_directive_loaded_find_pattern_from(0, size, "kernel_disjoint_axioms=")
    if pos < 0 {
        return p
    }
    let end = ontology_bundle_directive_loaded_line_end(pos, size)
    var cursor = pos + str_len("kernel_disjoint_axioms=")
    cursor = ontology_bundle_directive_cache_skip_to_next_int(cursor, end)
    if cursor < 0 {
        return p
    }
    let subject_pair = ontology_bundle_directive_cache_read_int_at(cursor, end)
    if subject_pair.0 < 0 {
        return p
    }
    cursor = ontology_bundle_directive_cache_skip_to_next_int(subject_pair.1, end)
    if cursor < 0 {
        return p
    }
    let object_pair = ontology_bundle_directive_cache_read_int_at(cursor, end)
    if object_pair.0 < 0 {
        return p
    }
    p.kernel_disjoint_subject0 = subject_pair.0
    p.kernel_disjoint_object0 = object_pair.0
    p.kernel_disjoint_axiom_count = 1
    p
}

pub fn ontology_bundle_directive_import_native_side_table_cache(cache_path: string) -> OntologyBundleDirectiveLoadPlan with IO, Mut, Panic, Div {
    var p = ontology_bundle_directive_empty_load_plan()
    let size = ontology_bundle_directive_load_file(cache_path)
    if size <= 0 {
        return p
    }
    let header_ok = ontology_bundle_directive_loaded_matches_at(0, size, "// Sounio native ontology side-table .ontocache v1")
    let format_ok = ontology_bundle_directive_loaded_line_value_after("format=", 0, size) == "bounded-kernel-facts"
    let authority_ok = ontology_bundle_directive_loaded_line_value_after("authority=", 0, size) == "compiler-side-bounded-side-table-cache-not-live-checker-kernel"
    if !header_ok || !format_ok || !authority_ok {
        return p
    }
    p.found = true
    p.count = 1
    p.path = ontology_bundle_directive_loaded_line_value_after("source_bundle=", 0, size)
    p.payload_ontology = ontology_bundle_directive_loaded_line_value_after("ontology=", 0, size)
    p.dont_version = ontology_bundle_directive_loaded_read_int_after("dont_version=", 0, size)
    p.dont_payload_size = ontology_bundle_directive_loaded_read_int_after("dont_payload_size=", 0, size)
    p.payload_term_count = ontology_bundle_directive_loaded_read_int_after("payload_term_count=", 0, size)
    p.payload_disjoint_count = ontology_bundle_directive_loaded_read_int_after("payload_disjoint_count=", 0, size)
    p.mini_table_truncated = ontology_bundle_directive_loaded_bool_after("mini_table_truncated=", 0, size)
    p.kernel_stage_valid = ontology_bundle_directive_loaded_bool_after("kernel_stage_valid=", 0, size)
    p = ontology_bundle_directive_hydrate_cache_slots(size, p)
    p = ontology_bundle_directive_hydrate_cache_subclass_axioms(size, p)
    p = ontology_bundle_directive_hydrate_cache_disjoint_axioms(size, p)
    p.kernel_stage_valid =
        p.kernel_stage_valid &&
        p.kernel_slot_count > 0 &&
        p.kernel_subclass_axiom_count > 0 &&
        (p.payload_disjoint_count == 0 || p.kernel_disjoint_axiom_count > 0)
    p.payload_shape_valid = p.kernel_stage_valid && str_len(p.payload_ontology) > 0
    p = ontology_bundle_directive_materialize_kernel_rows(p)
    p
}

fn ontology_bundle_directive_stage_kernel_rows(plan: OntologyBundleDirectiveLoadPlan) -> OntologyBundleDirectiveLoadPlan {
    var p = plan
    if !p.mini_table_valid {
        return p
    }
    p = ontology_bundle_directive_kernel_add_slot(p, p.mini_class0)
    p = ontology_bundle_directive_kernel_add_slot(p, p.mini_class1)
    p = ontology_bundle_directive_kernel_add_slot(p, p.mini_class2)
    p = ontology_bundle_directive_kernel_add_slot(p, p.mini_class3)
    if p.first_disjoint_pair_present {
        p = ontology_bundle_directive_kernel_add_slot(p, p.first_disjoint_left_numeric_id)
        p = ontology_bundle_directive_kernel_add_slot(p, p.first_disjoint_right_numeric_id)
    }
    p = ontology_bundle_directive_kernel_stage_parent_edge(p, p.mini_parent_child0, p.mini_parent_parent0)
    p = ontology_bundle_directive_kernel_stage_parent_edge(p, p.mini_parent_child1, p.mini_parent_parent1)
    p = ontology_bundle_directive_kernel_stage_parent_edge(p, p.mini_parent_child2, p.mini_parent_parent2)
    p = ontology_bundle_directive_kernel_stage_parent_edge(p, p.mini_parent_child3, p.mini_parent_parent3)
    if p.kernel_subclass_axiom_count <= 0 {
        p = ontology_bundle_directive_kernel_add_slot(p, p.mini_parent_child0)
        p = ontology_bundle_directive_kernel_add_slot(p, p.mini_parent_parent0)
        p = ontology_bundle_directive_kernel_add_slot(p, p.mini_parent_child1)
        p = ontology_bundle_directive_kernel_add_slot(p, p.mini_parent_parent1)
        p = ontology_bundle_directive_kernel_add_slot(p, p.mini_parent_child2)
        p = ontology_bundle_directive_kernel_add_slot(p, p.mini_parent_parent2)
        p = ontology_bundle_directive_kernel_add_slot(p, p.mini_parent_child3)
        p = ontology_bundle_directive_kernel_add_slot(p, p.mini_parent_parent3)
        p = ontology_bundle_directive_kernel_stage_parent_edge(p, p.mini_parent_child0, p.mini_parent_parent0)
        p = ontology_bundle_directive_kernel_stage_parent_edge(p, p.mini_parent_child1, p.mini_parent_parent1)
        p = ontology_bundle_directive_kernel_stage_parent_edge(p, p.mini_parent_child2, p.mini_parent_parent2)
        p = ontology_bundle_directive_kernel_stage_parent_edge(p, p.mini_parent_child3, p.mini_parent_parent3)
    }
    if p.first_disjoint_pair_present {
        let left_slot = ontology_bundle_directive_kernel_find_slot(p, p.first_disjoint_left_numeric_id)
        let right_slot = ontology_bundle_directive_kernel_find_slot(p, p.first_disjoint_right_numeric_id)
        if left_slot >= 0 && right_slot >= 0 {
            p.kernel_disjoint_subject0 = left_slot
            p.kernel_disjoint_object0 = right_slot
            p.kernel_disjoint_axiom_count = 1
        }
    }
    p.kernel_stage_valid =
        p.kernel_slot_count > 0 &&
        p.kernel_subclass_axiom_count > 0 &&
        (p.payload_disjoint_count == 0 || p.kernel_disjoint_axiom_count > 0)
    p = ontology_bundle_directive_materialize_kernel_rows(p)
    p
}

fn ontology_bundle_directive_collect_terms(size: i64, plan: OntologyBundleDirectiveLoadPlan) -> OntologyBundleDirectiveLoadPlan with Mut, Panic, Div {
    var p = plan
    let payload_start: i64 = 12
    let curie_pattern = "\"curie\":\""
    var search = payload_start
    while search < size {
        let curie_pos = ontology_bundle_directive_loaded_find_pattern_from(search, size, curie_pattern)
        if curie_pos < 0 {
            return p
        }
        let curie = ontology_bundle_directive_loaded_string_after_between(curie_pattern, curie_pos, size)
        let id = ontology_bundle_directive_curie_cache_id(curie, size)
        if id >= 0 {
            if p.mini_class_count < 4 {
                p = ontology_bundle_directive_set_mini_class(p, p.mini_class_count, id)
            } else {
                p.mini_table_truncated = true
            }
            p.mini_class_count = p.mini_class_count + 1
        }
        search = curie_pos + str_len(curie_pattern) + 1
    }
    p
}

fn ontology_bundle_directive_collect_parent_edges(size: i64, plan: OntologyBundleDirectiveLoadPlan) -> OntologyBundleDirectiveLoadPlan with Mut, Panic, Div {
    var p = plan
    let payload_start: i64 = 12
    let curie_pattern = "\"curie\":\""
    let next_term_pattern = "},{\"curie\":\""
    let parents_pattern = "\"parents\":["
    var search = payload_start
    while search < size {
        let curie_pos = ontology_bundle_directive_loaded_find_pattern_from(search, size, curie_pattern)
        if curie_pos < 0 {
            return p
        }
        var term_end = ontology_bundle_directive_loaded_find_pattern_from(curie_pos + str_len(curie_pattern), size, next_term_pattern)
        if term_end < 0 {
            term_end = size
        }
        let child = ontology_bundle_directive_loaded_string_after_between(curie_pattern, curie_pos, term_end)
        let parents_pos = ontology_bundle_directive_loaded_find_pattern_between(curie_pos, term_end, parents_pattern)
        if parents_pos >= 0 {
            var parent_start = parents_pos + str_len(parents_pattern)
            while parent_start < term_end &&
                  ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[parent_start as usize] != (34 as i8) &&
                  ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[parent_start as usize] != (93 as i8) {
                parent_start = parent_start + 1
            }
            let parent = ontology_bundle_directive_loaded_quoted_string_at(parent_start, term_end)
            let child_id = ontology_bundle_directive_curie_cache_id(child, size)
            let parent_id = ontology_bundle_directive_curie_cache_id(parent, size)
            if child_id >= 0 && parent_id >= 0 {
                if p.mini_parent_edge_count < 4 {
                    p = ontology_bundle_directive_set_mini_parent_edge(p, p.mini_parent_edge_count, child_id, parent_id)
                } else {
                    p.mini_table_truncated = true
                }
                p.mini_parent_edge_count = p.mini_parent_edge_count + 1
            }
        }
        search = term_end + 1
    }
    p
}

fn ontology_bundle_directive_extract_first_disjoint_pair(size: i64, plan: OntologyBundleDirectiveLoadPlan) -> OntologyBundleDirectiveLoadPlan with Mut, Panic, Div {
    var p = plan
    let payload_start: i64 = 12
    let disjoint_pattern = "\"disjoints\":[[\""
    let pair_pos = ontology_bundle_directive_loaded_find_pattern_from(payload_start, size, disjoint_pattern)
    if pair_pos < 0 {
        return p
    }

    let left = ontology_bundle_directive_loaded_string_after(disjoint_pattern, payload_start, size)
    var right_start = pair_pos + str_len(disjoint_pattern)
    while right_start < size && ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[right_start as usize] != (34 as i8) {
        right_start = right_start + 1
    }
    if right_start >= size {
        return p
    }
    right_start = right_start + 1
    while right_start < size && ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[right_start as usize] != (34 as i8) {
        right_start = right_start + 1
    }
    let right = ontology_bundle_directive_loaded_quoted_string_at(right_start, size)
    if str_len(left) > 0 && str_len(right) > 0 {
        p.first_disjoint_pair_present = true
        p.first_disjoint_left_curie = left
        p.first_disjoint_right_curie = right
        p.first_disjoint_left_numeric_id = ontology_bundle_directive_curie_numeric_tail(left)
        p.first_disjoint_right_numeric_id = ontology_bundle_directive_curie_numeric_tail(right)
    }
    p
}

fn ontology_bundle_directive_collect_disjoint_pairs(size: i64, plan: OntologyBundleDirectiveLoadPlan) -> OntologyBundleDirectiveLoadPlan with Mut, Panic, Div {
    var p = plan
    let payload_start: i64 = 12
    let disjoint_pattern = "\"disjoints\":[[\""
    let pair_pos = ontology_bundle_directive_loaded_find_pattern_from(payload_start, size, disjoint_pattern)
    if pair_pos < 0 {
        return p
    }

    let left = ontology_bundle_directive_loaded_string_after(disjoint_pattern, payload_start, size)
    var right_start = pair_pos + str_len(disjoint_pattern)
    while right_start < size && ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[right_start as usize] != (34 as i8) {
        right_start = right_start + 1
    }
    if right_start >= size {
        return p
    }
    right_start = right_start + 1
    while right_start < size && ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[right_start as usize] != (34 as i8) {
        right_start = right_start + 1
    }
    let right = ontology_bundle_directive_loaded_quoted_string_at(right_start, size)
    let left_id = ontology_bundle_directive_curie_cache_id(left, size)
    let right_id = ontology_bundle_directive_curie_cache_id(right, size)
    if left_id >= 0 && right_id >= 0 {
        p.mini_disjoint_pair_count = 1
        p.mini_disjoint_left0 = left_id
        p.mini_disjoint_right0 = right_id
    }
    p
}

fn ontology_bundle_directive_classify_payload(size: i64, plan: OntologyBundleDirectiveLoadPlan) -> OntologyBundleDirectiveLoadPlan with Mut, Panic, Div {
    var p = plan
    let payload_start: i64 = 12
    p.payload_has_ontology = ontology_bundle_directive_loaded_find_pattern_from(payload_start, size, "\"ontology\":\"") >= 0
    p.payload_has_terms = ontology_bundle_directive_loaded_find_pattern_from(payload_start, size, "\"terms\":[") >= 0
    p.payload_has_disjoints = ontology_bundle_directive_loaded_find_pattern_from(payload_start, size, "\"disjoints\":[") >= 0
    p.payload_term_count = ontology_bundle_directive_loaded_read_int_after("\"term_count\":", payload_start, size)
    p.payload_disjoint_count = ontology_bundle_directive_loaded_read_int_after("\"disjoint_count\":", payload_start, size)
    p.payload_ontology = ontology_bundle_directive_loaded_string_after("\"ontology\":\"", payload_start, size)
    p.first_term_curie = ontology_bundle_directive_loaded_string_after("\"curie\":\"", payload_start, size)
    p.first_term_present = str_len(p.first_term_curie) > 0
    p.first_term_numeric_id = ontology_bundle_directive_curie_numeric_tail(p.first_term_curie)
    p = ontology_bundle_directive_extract_first_parent_edge(size, p)
    p = ontology_bundle_directive_extract_first_disjoint_pair(size, p)
    p.payload_shape_valid =
        p.dont_magic_valid &&
        p.dont_version == 1 &&
        p.dont_payload_size_matches &&
        p.payload_has_ontology &&
        p.payload_has_terms &&
        p.payload_has_disjoints &&
        p.payload_term_count > 0 &&
        p.payload_disjoint_count >= 0 &&
        str_len(p.payload_ontology) > 0 &&
        p.first_term_present &&
        p.first_parent_edge_present &&
        (p.payload_disjoint_count == 0 || p.first_disjoint_pair_present)
    if p.payload_shape_valid {
        p = ontology_bundle_directive_collect_terms(size, p)
        p = ontology_bundle_directive_collect_parent_edges(size, p)
        p = ontology_bundle_directive_collect_disjoint_pairs(size, p)
        p.mini_table_valid =
            p.mini_class_count > 0 &&
            p.mini_parent_edge_count > 0 &&
            (p.payload_disjoint_count == 0 || p.mini_disjoint_pair_count > 0)
        p = ontology_bundle_directive_stage_kernel_rows(p)
    }
    p
}

fn ontology_bundle_directive_validate_dont_envelope(path: string, plan: OntologyBundleDirectiveLoadPlan) -> OntologyBundleDirectiveLoadPlan with IO, Mut, Panic, Div {
    var p = plan
    let size = ontology_bundle_directive_load_file(path)
    p.bundle_size = size
    p.bundle_exists = size > 0
    if size < 12 {
        return p
    }

    p.dont_magic_valid =
        ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[0] == (68 as i8) &&
        ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[1] == (79 as i8) &&
        ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[2] == (78 as i8) &&
        ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[3] == (84 as i8)
    p.dont_version = ontology_bundle_directive_read_le_u32_at(4)
    p.dont_payload_size = ontology_bundle_directive_read_le_u32_at(8)
    p.dont_payload_size_matches = p.dont_payload_size > 0 && p.dont_payload_size + 12 == size
    ontology_bundle_directive_classify_payload(size, p)
}

fn ontology_bundle_directive_load_file(path: string) -> i64 with IO, Mut, Panic, Div {
    let size = file_size(path)
    if size <= 0 {
        return 0
    }
    let n = if size > 1048576 { 1048576 } else { size }
    let raw = read_file(path)
    var i: i64 = 0
    while i < n {
        ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[i as usize] = raw[i as usize]
        i = i + 1
    }
    n
}

fn ontology_bundle_directive_loaded_matches_at(pos: i64, size: i64, pattern: string) -> bool with Mut, Panic, Div {
    let plen = str_len(pattern)
    if pos < 0 || pos + plen > size {
        return false
    }
    var i: i64 = 0
    while i < plen {
        if ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[(pos + i) as usize] != (str_char_at(pattern, i) as i8) {
            return false
        }
        i = i + 1
    }
    true
}

fn ontology_bundle_directive_loaded_line_end(pos: i64, size: i64) -> i64 {
    var i = pos
    while i < size {
        if ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[i as usize] == (10 as i8) {
            return i
        }
        i = i + 1
    }
    size
}

fn ontology_bundle_directive_byte_to_str(c: i8) -> string {
    let v = c as i64
    if v >= 97 && v <= 122 {
        return str_slice("abcdefghijklmnopqrstuvwxyz", v - 97, v - 96)
    }
    if v >= 65 && v <= 90 {
        return str_slice("ABCDEFGHIJKLMNOPQRSTUVWXYZ", v - 65, v - 64)
    }
    if v >= 48 && v <= 57 {
        return str_slice("0123456789", v - 48, v - 47)
    }
    if v == 95 { return "_" }
    if v == 47 { return "/" }
    if v == 46 { return "." }
    if v == 45 { return "-" }
    if v == 58 { return ":" }
    ""
}

fn ontology_bundle_directive_extract_quoted_path(start: i64, line_end: i64, result: OntologyBundleDirectiveScanResult) -> OntologyBundleDirectiveScanResult with Mut, Panic, Div {
    var r = result
    var i = start
    while i < line_end && ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[i as usize] != (34 as i8) {
        i = i + 1
    }
    if i >= line_end {
        r.malformed = true
        return r
    }
    i = i + 1
    var path = ""
    while i < line_end && ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[i as usize] != (34 as i8) {
        path = str_concat(path, ontology_bundle_directive_byte_to_str(ONTOLOGY_BUNDLE_DIRECTIVE_FILE_DATA[i as usize]))
        i = i + 1
    }
    if i >= line_end {
        r.malformed = true
        return r
    }
    r.found = true
    r.count = r.count + 1
    if str_len(r.path) == 0 {
        r.path = path
    }
    r
}

pub fn ontology_bundle_directive_scan_loaded(size: i64) -> OntologyBundleDirectiveScanResult with Mut, Panic, Div {
    var result = ontology_bundle_directive_empty_scan_result()
    let pattern = "//@ ontology-bundle:"
    let plen = str_len(pattern)
    var i: i64 = 0
    while i + plen <= size {
        if ontology_bundle_directive_loaded_matches_at(i, size, pattern) {
            let line_end = ontology_bundle_directive_loaded_line_end(i, size)
            result = ontology_bundle_directive_extract_quoted_path(i + plen, line_end, result)
            i = line_end
        }
        i = i + 1
    }
    result
}

pub fn ontology_bundle_directive_scan_native_cache_loaded(size: i64) -> OntologyBundleDirectiveScanResult with Mut, Panic, Div {
    var result = ontology_bundle_directive_empty_scan_result()
    let pattern = "//@ ontology-side-table-cache:"
    let plen = str_len(pattern)
    var i: i64 = 0
    while i + plen <= size {
        if ontology_bundle_directive_loaded_matches_at(i, size, pattern) {
            let line_end = ontology_bundle_directive_loaded_line_end(i, size)
            result = ontology_bundle_directive_extract_quoted_path(i + plen, line_end, result)
            i = line_end
        }
        i = i + 1
    }
    result
}

pub fn ontology_bundle_directive_scan_file(path: string) -> OntologyBundleDirectiveScanResult with IO, Mut, Panic, Div {
    let size = ontology_bundle_directive_load_file(path)
    if size <= 0 {
        return ontology_bundle_directive_empty_scan_result()
    }
    ontology_bundle_directive_scan_loaded(size)
}

pub fn ontology_bundle_directive_scan_native_cache_file(path: string) -> OntologyBundleDirectiveScanResult with IO, Mut, Panic, Div {
    let size = ontology_bundle_directive_load_file(path)
    if size <= 0 {
        return ontology_bundle_directive_empty_scan_result()
    }
    ontology_bundle_directive_scan_native_cache_loaded(size)
}

pub fn ontology_bundle_directive_build_load_plan(source_path: string) -> OntologyBundleDirectiveLoadPlan with IO, Mut, Panic, Div {
    let scan = ontology_bundle_directive_scan_file(source_path)
    var plan = ontology_bundle_directive_empty_load_plan()
    plan.found = scan.found
    plan.count = scan.count
    plan.path = scan.path
    plan.malformed = scan.malformed

    if scan.found && !scan.malformed && str_len(scan.path) > 0 {
        plan = ontology_bundle_directive_validate_dont_envelope(scan.path, plan)
    }

    plan
}

pub fn ontology_bundle_directive_build_load_plan_from_native_cache_directive(source_path: string) -> OntologyBundleDirectiveLoadPlan with IO, Mut, Panic, Div {
    let scan = ontology_bundle_directive_scan_native_cache_file(source_path)
    var plan = ontology_bundle_directive_empty_load_plan()
    plan.found = scan.found
    plan.count = scan.count
    plan.path = scan.path
    plan.malformed = scan.malformed

    if scan.found && !scan.malformed && str_len(scan.path) > 0 {
        plan = ontology_bundle_directive_import_native_side_table_cache(scan.path)
        plan.found = true
        plan.count = scan.count
        plan.malformed = false
    }

    plan
}

pub fn ontology_bundle_directive_cache_verdict_ok() -> i64 { 0 }
pub fn ontology_bundle_directive_cache_verdict_no_directive() -> i64 { 1 }
pub fn ontology_bundle_directive_cache_verdict_invalid_cache() -> i64 { 2 }
pub fn ontology_bundle_directive_cache_verdict_reject_subclass() -> i64 { 152 }

pub fn ontology_bundle_directive_cache_subclass_verdict(source_path: string, child_id: i64, parent_id: i64) -> i64 with IO, Mut, Panic, Div {
    let plan = ontology_bundle_directive_build_load_plan_from_native_cache_directive(source_path)
    if !plan.found || plan.count <= 0 {
        return ontology_bundle_directive_cache_verdict_no_directive()
    }
    if !plan.kernel_materialized_valid {
        return ontology_bundle_directive_cache_verdict_invalid_cache()
    }
    if ontology_bundle_directive_kernel_materialized_subclass_of(plan, child_id, parent_id) {
        return ontology_bundle_directive_cache_verdict_ok()
    }
    ontology_bundle_directive_cache_verdict_reject_subclass()
}

pub fn ontology_bundle_directive_cache_disjoint_verdict(source_path: string, left_id: i64, right_id: i64) -> i64 with IO, Mut, Panic, Div {
    let plan = ontology_bundle_directive_build_load_plan_from_native_cache_directive(source_path)
    if !plan.found || plan.count <= 0 {
        return ontology_bundle_directive_cache_verdict_no_directive()
    }
    if !plan.kernel_materialized_valid {
        return ontology_bundle_directive_cache_verdict_invalid_cache()
    }
    if ontology_bundle_directive_kernel_materialized_are_disjoint(plan, left_id, right_id) {
        return ontology_bundle_directive_cache_verdict_ok()
    }
    ontology_bundle_directive_cache_verdict_reject_subclass()
}
