use check::numeric_format::*
use check::types::*
use check::compat::*

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let d128 = binary_format_binary128_descriptor()
    if d128.format_id != numeric_format_binary128_id() { return 9 }
    if d128.storage_bits != 128 { return 10 }
    if d128.exponent_bits != 15 { return 11 }
    if d128.precision_bits != 113 { return 12 }
    if d128.trailing_significand_bits != 112 { return 13 }

    let d256 = binary_format_binary256_descriptor()
    if d256.format_id != numeric_format_binary256_id() { return 14 }
    if d256.storage_bits != 256 { return 15 }
    if d256.exponent_bits != 19 { return 16 }
    if d256.precision_bits != 237 { return 17 }
    if d256.trailing_significand_bits != 236 { return 18 }

    let invalid = invalid_binary_format_descriptor()
    if invalid.format_id != 0 || invalid.storage_bits != 0 { return 19 }

    let identity_probe = f128_f256_internal_identity_probe_code()
    if identity_probe != 0 { return identity_probe }
    let compatibility_probe = f128_f256_compatibility_probe_code()
    if compatibility_probe != 0 { return compatibility_probe }
    println("PASS f128_f256_format_descriptor_probe")
    0
}
