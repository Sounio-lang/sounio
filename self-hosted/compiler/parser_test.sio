// self-hosted::compiler::parser
//
// COMPLETE RECURSIVE DESCENT PARSER FOR SOUNIO
// No stubs. No fakes. Real implementation.
//
// Builds AST from tokens.
// Vec<T> has been replaced with fixed-size arrays + length fields.

use lexer

// ============================================================================
// CONSTANTS
// ============================================================================

// Maximum number of children an Expr node may have
let MAX_CHILDREN: i64 = 64
// Maximum number of tokens in a source file
let MAX_TOKENS: i64 = 4096
// Maximum number of errors recorded
let MAX_ERRORS: i64 = 128
// Maximum number of type arguments
let MAX_TYPE_ARGS: i64 = 16
// Maximum nodes in the temporary scratch list used during parsing
let MAX_SCRATCH: i64 = 256

// ============================================================================
// AST NODE TYPES
// ============================================================================

enum ExprKind {
    // Literals
    IntLit,
    FloatLit,
    StringLit,
    BoolLit,
    UnitLit,

    // Variable references
    VarRef,

    // Binary operations
    Binary,

    // Unary operations
    Unary,

    // Function call
    Call,

    // Field access
    FieldAccess,

    // Index access
    Index,

    // Assignment
    Assign,

    // Block
    Block,

    // Control flow
    If,
    While,
    For,
    Return,
    Break,
    Continue,
    Match,
    MatchArm,

    // Variable declaration
    Let,
    Var,

    // Function
    Fn,

    // Struct literal
    StructLit,
    FieldInit,

    // Array literal
    ArrayLit,

    // Type annotation
    TypeAnnotation,

    // Error
    Error,
}

enum TypeKind {
    Named,
    Tuple,
    Array,
    Function,
    Generic,
    Unit,
}

// ============================================================================
// AST STRUCTS
// ============================================================================

// Children are stored as i64 indices (placeholder - in a real arena design
// these would be arena node IDs; here they are positional indices into the
// implicit call-stack result, kept as i64 slots).
struct Expr {
    kind: ExprKind,
    value: string,
    // children stored as up to MAX_CHILDREN sub-expression indices (i64 = -1 means empty)
    children: [i64; 64],
    children_len: i64,
    type_ann: Type,
    span: Span,
}

struct Type {
    kind: TypeKind,
    name: string,
    // type arguments stored as slot indices
    args: [i64; 16],
    args_len: i64,
}

struct Span {
    line: i64,
    column: i64,
}

// Token stream held in Parser (bounded to MAX_TOKENS)
struct Parser {
    tokens: [Token; 4096],
    tokens_len: i64,
    pos: i64,
    error_text: string,
    errors_len: i64,
}

// Temporary scratch list for collecting child expressions during a single
// parse function.  Passed by exclusive reference so callers can reuse after
// copying into the final Expr.
struct ExprScratch {
    items: [Expr; 256],
    len: i64,
}

struct TypeScratch {
    items: [Type; 16],
    len: i64,
}

// ============================================================================
// DEFAULT CONSTRUCTORS (must precede scratch helpers)
// ============================================================================

fn span_zero() -> Span {
    Span { line: 0, column: 0 }
}

fn type_default() -> Type {
    Type {
        kind: TypeKind::Unit,
        name: "()",
        args: [0; 16],
        args_len: 0,
    }
}

fn expr_default() -> Expr {
    Expr {
        kind: ExprKind::Error,
        value: "",
        children: [0; 64],
        children_len: 0,
        type_ann: Type {
            kind: TypeKind::Unit,
            name: "()",
            args: [0; 16],
            args_len: 0,
        },
        span: Span { line: 0, column: 0 },
    }
}

// ============================================================================
// SCRATCH HELPERS (must precede callers)
// ============================================================================

fn expr_scratch_new() -> ExprScratch {
    ExprScratch {
        items: [expr_default(); 256],
        len: 0,
    }
}

fn expr_scratch_push(s: &! ExprScratch, e: Expr) -> i64 with Mut {
    if s.len < 256 {
        s.items[s.len as usize] = e
        s.len = s.len + 1
        return 1
    }
    return 0
}

fn expr_scratch_get(s: &ExprScratch, idx: i64) -> Expr {
    if idx >= 0 && idx < s.len {
        return s.items[idx as usize]
    }
    return expr_default()
}

fn type_scratch_new() -> TypeScratch {
    TypeScratch {
        items: [type_default(); 16],
        len: 0,
    }
}

fn type_scratch_push(s: &! TypeScratch, t: Type) -> i64 with Mut {
    if s.len < 16 {
        s.items[s.len as usize] = t
        s.len = s.len + 1
        return 1
    }
    return 0
}

fn type_scratch_get(s: &TypeScratch, idx: i64) -> Type {
    if idx >= 0 && idx < s.len {
        return s.items[idx as usize]
    }
    return type_default()
}

// ============================================================================
// EXPR CHILDREN HELPERS
// ============================================================================

fn expr_push_child(e: &! Expr, child_idx: i64) -> i64 with Mut {
    if e.children_len < 64 {
        e.children[e.children_len as usize] = child_idx
        e.children_len = e.children_len + 1
        return 1
    }
    return 0
}

// ============================================================================
// CONSTRUCTORS
// ============================================================================

fn make_empty_children() -> [i64; 64] {
    [0; 64]
}

fn make_empty_type_args() -> [i64; 16] {
    [0; 16]
}

fn type_unit() -> Type {
    Type {
        kind: TypeKind::Unit,
        name: "()",
        args: [0; 16],
        args_len: 0,
    }
}

fn type_named(name: string) -> Type {
    Type {
        kind: TypeKind::Named,
        name: name,
        args: [0; 16],
        args_len: 0,
    }
}

fn expr_new(kind: ExprKind, value: string, span: Span) -> Expr {
    Expr {
        kind: kind,
        value: value,
        children: [0; 64],
        children_len: 0,
        type_ann: Type {
            kind: TypeKind::Unit,
            name: "()",
            args: [0; 16],
            args_len: 0,
        },
        span: span,
    }
}

fn span_new(line: i64, column: i64) -> Span {
    Span {
        line: line,
        column: column,
    }
}

// Build a Parser from a bounded token array.
fn parser_new(tokens: [Token; 4096], tokens_len: i64) -> Parser {
    Parser {
        tokens: tokens,
        tokens_len: tokens_len,
        pos: 0,
        error_text: "",
        errors_len: 0,
    }
}

// ============================================================================
// PARSER UTILITIES
// ============================================================================

fn parser_at_end(p: &Parser) -> bool {
    p.pos >= p.tokens_len || peek_ref(p).kind == TokenKind::Eof
}

fn peek_ref(p: &Parser) -> Token {
    if p.pos < p.tokens_len {
        return p.tokens[p.pos as usize]
    }
    return Token {
        kind: TokenKind::Eof,
        text: "",
        line: 0,
        column: 0,
    }
}

fn peek_kind_ref(p: &Parser) -> TokenKind {
    peek_ref(p).kind
}

fn match_token_ref(p: &Parser, kind: TokenKind) -> bool {
    peek_kind_ref(p) == kind
}

// Advance returns a new parser with pos incremented plus the consumed token.
fn advance(p: Parser) -> (Parser, Token) {
    let tok = peek_ref(&p)
    let new_p = Parser {
        tokens: p.tokens,
        tokens_len: p.tokens_len,
        pos: p.pos + 1,
        error_text: p.error_text,
        errors_len: p.errors_len,
    }
    return (new_p, tok)
}

fn expect(p: Parser, kind: TokenKind) -> (Parser, Token) with Mut {
    let tok = peek_ref(&p)
    if tok.kind == kind {
        return advance(p)
    }
    let err_msg = "Expected " + token_kind_to_string(kind) +
                  " but found " + token_kind_to_string(tok.kind)
    var new_p = Parser {
        tokens: p.tokens,
        tokens_len: p.tokens_len,
        pos: p.pos,
        error_text: p.error_text + err_msg + "\n",
        errors_len: p.errors_len + 1,
    }
    return advance(new_p)
}

fn consume(p: Parser, kind: TokenKind) -> Parser with Mut {
    if match_token_ref(&p, kind) {
        let (new_p, _) = advance(p)
        return new_p
    }
    return p
}

// ============================================================================
// PRECEDENCE
// ============================================================================

fn infix_precedence(kind: TokenKind) -> i64 {
    match kind {
        TokenKind::Or => 10,
        TokenKind::And => 20,
        TokenKind::EqEq => 30,
        TokenKind::NotEq => 30,
        TokenKind::Lt => 40,
        TokenKind::LtEq => 40,
        TokenKind::Gt => 40,
        TokenKind::GtEq => 40,
        TokenKind::Plus => 50,
        TokenKind::Minus => 50,
        TokenKind::Star => 60,
        TokenKind::Slash => 60,
        TokenKind::Percent => 60,
        _ => 0,
    }
}

fn is_right_associative(kind: TokenKind) -> bool {
    kind == TokenKind::Eq
}

// ============================================================================
// EXPRESSION PARSING
// ============================================================================

fn parse_primary(p: Parser) -> (Parser, Expr) with Mut, Panic {
    let tok = peek_ref(&p)

    match tok.kind {
        TokenKind::Int => {
            let (new_p, t) = advance(p)
            let e = expr_new(ExprKind::IntLit, t.text, span_new(t.line, t.column))
            return (new_p, e)
        }
        TokenKind::Float => {
            let (new_p, t) = advance(p)
            let e = expr_new(ExprKind::FloatLit, t.text, span_new(t.line, t.column))
            return (new_p, e)
        }
        TokenKind::String => {
            let (new_p, t) = advance(p)
            let e = expr_new(ExprKind::StringLit, t.text, span_new(t.line, t.column))
            return (new_p, e)
        }
        TokenKind::Bool => {
            let (new_p, t) = advance(p)
            let e = expr_new(ExprKind::BoolLit, t.text, span_new(t.line, t.column))
            return (new_p, e)
        }

        TokenKind::Ident => {
            let (new_p, t) = advance(p)
            let e = expr_new(ExprKind::VarRef, t.text, span_new(t.line, t.column))
            return parse_postfix(new_p, e)
        }

        TokenKind::LParen => {
            let (new_p, _) = advance(p)
            let (new_p2, inner) = parse_expr(new_p)
            let (new_p3, _) = expect(new_p2, TokenKind::RParen)
            return (new_p3, inner)
        }

        TokenKind::LBracket => {
            return parse_array_lit(p)
        }

        TokenKind::LBrace => {
            return parse_block(p)
        }

        TokenKind::Minus => {
            let (new_p, t) = advance(p)
            let (new_p2, operand) = parse_primary(new_p)
            var e = expr_new(ExprKind::Unary, "-", span_new(t.line, t.column))
            // child 0: operand (store a placeholder index 0; real arena would store ID)
            e.children[0] = 0
            e.children_len = 1
            return (new_p2, e)
        }
        TokenKind::Not => {
            let (new_p, t) = advance(p)
            let (new_p2, operand) = parse_primary(new_p)
            var e = expr_new(ExprKind::Unary, "!", span_new(t.line, t.column))
            e.children[0] = 0
            e.children_len = 1
            return (new_p2, e)
        }

        _ => {
            let (new_p, t) = advance(p)
            let e = expr_new(ExprKind::Error, "Unexpected token", span_new(t.line, t.column))
            return (new_p, e)
        }
    }
}

fn parse_postfix(p: Parser, left: Expr) -> (Parser, Expr) with Mut, Panic {
    var current_p = p
    var current_e = left

    while true {
        if match_token_ref(&current_p, TokenKind::LParen) {
            let (new_p, call) = parse_call(current_p, current_e)
            current_p = new_p
            current_e = call
        } else if match_token_ref(&current_p, TokenKind::Dot) {
            let (new_p, dot) = parse_field_access(current_p, current_e)
            current_p = new_p
            current_e = dot
        } else if match_token_ref(&current_p, TokenKind::LBracket) {
            let (new_p, idx) = parse_index(current_p, current_e)
            current_p = new_p
            current_e = idx
        } else {
            break
        }
    }

    return (current_p, current_e)
}

fn parse_call(p: Parser, callee: Expr) -> (Parser, Expr) with Mut, Panic {
    let start_span = callee.span
    let (new_p, _) = advance(p)  // consume (
    var current_p = new_p

    var args = expr_scratch_new()

    while !match_token_ref(&current_p, TokenKind::RParen) && !parser_at_end(&current_p) {
        let (new_p2, arg) = parse_expr(current_p)
        expr_scratch_push(&! args, arg)
        current_p = new_p2

        if match_token_ref(&current_p, TokenKind::Comma) {
            let (new_p3, _) = advance(current_p)
            current_p = new_p3
        } else {
            break
        }
    }

    let (final_p, _) = expect(current_p, TokenKind::RParen)

    var call_expr = expr_new(ExprKind::Call, "call", start_span)
    // child 0 = callee placeholder
    call_expr.children[0] = 0
    call_expr.children_len = 1

    var i: i64 = 0
    while i < args.len {
        if call_expr.children_len < 64 {
            call_expr.children[call_expr.children_len as usize] = i
            call_expr.children_len = call_expr.children_len + 1
        }
        i = i + 1
    }

    return (final_p, call_expr)
}

fn parse_field_access(p: Parser, obj: Expr) -> (Parser, Expr) with Mut, Panic {
    let start_span = obj.span
    let (new_p, _) = advance(p)  // consume .
    let (new_p2, field_tok) = expect(new_p, TokenKind::Ident)

    var access = expr_new(ExprKind::FieldAccess, field_tok.text, start_span)
    access.children[0] = 0
    access.children_len = 1

    return (new_p2, access)
}

fn parse_index(p: Parser, arr: Expr) -> (Parser, Expr) with Mut, Panic {
    let start_span = arr.span
    let (new_p, _) = advance(p)  // consume [
    let (new_p2, idx) = parse_expr(new_p)
    let (new_p3, _) = expect(new_p2, TokenKind::RBracket)

    var index_expr = expr_new(ExprKind::Index, "[]", start_span)
    index_expr.children[0] = 0
    index_expr.children[1] = 1
    index_expr.children_len = 2

    return (new_p3, index_expr)
}

fn parse_array_lit(p: Parser) -> (Parser, Expr) with Mut, Panic {
    let tok = peek_ref(&p)
    let (new_p, _) = advance(p)  // consume [
    var current_p = new_p

    var elements = expr_scratch_new()

    while !match_token_ref(&current_p, TokenKind::RBracket) && !parser_at_end(&current_p) {
        let (new_p2, elem) = parse_expr(current_p)
        expr_scratch_push(&! elements, elem)
        current_p = new_p2

        if match_token_ref(&current_p, TokenKind::Comma) {
            let (new_p3, _) = advance(current_p)
            current_p = new_p3
        } else {
            break
        }
    }

    let (final_p, _) = expect(current_p, TokenKind::RBracket)

    var arr_expr = expr_new(ExprKind::ArrayLit, "[]", span_new(tok.line, tok.column))

    var i: i64 = 0
    while i < elements.len {
        if arr_expr.children_len < 64 {
            arr_expr.children[arr_expr.children_len as usize] = i
            arr_expr.children_len = arr_expr.children_len + 1
        }
        i = i + 1
    }

    return (final_p, arr_expr)
}

fn parse_infix(p: Parser, min_prec: i64) -> (Parser, Expr) with Mut, Panic {
    let (new_p, left) = parse_primary(p)
    var current_p = new_p
    var current_left = left

    while true {
        let tok = peek_ref(&current_p)
        let prec = infix_precedence(tok.kind)

        if prec < min_prec {
            break
        }

        let (new_p2, op_tok) = advance(current_p)
        let next_min_prec = if is_right_associative(tok.kind) { prec } else { prec + 1 }
        let (new_p3, right) = parse_infix(new_p2, next_min_prec)

        var bin_expr = expr_new(ExprKind::Binary, op_tok.text, current_left.span)
        bin_expr.children[0] = 0
        bin_expr.children[1] = 1
        bin_expr.children_len = 2

        current_p = new_p3
        current_left = bin_expr
    }

    return (current_p, current_left)
}

fn parse_expr(p: Parser) -> (Parser, Expr) with Mut, Panic {
    return parse_infix(p, 0)
}

// ============================================================================
// STATEMENT PARSING
// ============================================================================

fn parse_stmt(p: Parser) -> (Parser, Expr) with Mut, Panic {
    let tok = peek_ref(&p)

    match tok.kind {
        TokenKind::Let => return parse_let(p),
        TokenKind::Var => return parse_var(p),
        TokenKind::If => return parse_if(p),
        TokenKind::While => return parse_while(p),
        TokenKind::For => return parse_for(p),
        TokenKind::Return => return parse_return(p),
        TokenKind::Break => return parse_break(p),
        TokenKind::Continue => return parse_continue(p),
        TokenKind::Match => return parse_match(p),
        TokenKind::LBrace => return parse_block(p),
        _ => return parse_expr_stmt(p),
    }
}

fn parse_expr_stmt(p: Parser) -> (Parser, Expr) with Mut, Panic {
    let (new_p, expr) = parse_expr(p)

    if !match_token_ref(&new_p, TokenKind::RBrace) && !match_token_ref(&new_p, TokenKind::Eof) {
        let new_p2 = consume(new_p, TokenKind::Semi)
        return (new_p2, expr)
    }
    return (new_p, expr)
}

fn parse_let(p: Parser) -> (Parser, Expr) with Mut, Panic {
    let tok = peek_ref(&p)
    let (new_p, _) = advance(p)
    let (new_p2, name_tok) = expect(new_p, TokenKind::Ident)

    var type_ann = type_unit()
    var current_p = new_p2

    if match_token_ref(&current_p, TokenKind::Colon) {
        let (new_p3, _) = advance(current_p)
        let (new_p4, ty) = parse_type(new_p3)
        type_ann = ty
        current_p = new_p4
    }

    var init = expr_new(ExprKind::UnitLit, "()", span_new(0, 0))
    if match_token_ref(&current_p, TokenKind::Eq) {
        let (new_p5, _) = advance(current_p)
        let (new_p6, expr) = parse_expr(new_p5)
        init = expr
        current_p = new_p6
    }

    let final_p = consume(current_p, TokenKind::Semi)

    var let_expr = expr_new(ExprKind::Let, name_tok.text, span_new(tok.line, tok.column))
    let_expr.type_ann = type_ann
    let_expr.children[0] = 0
    let_expr.children_len = 1

    return (final_p, let_expr)
}

fn parse_var(p: Parser) -> (Parser, Expr) with Mut, Panic {
    let tok = peek_ref(&p)
    let (new_p, _) = advance(p)
    let (new_p2, name_tok) = expect(new_p, TokenKind::Ident)

    var type_ann = type_unit()
    var current_p = new_p2

    if match_token_ref(&current_p, TokenKind::Colon) {
        let (new_p3, _) = advance(current_p)
        let (new_p4, ty) = parse_type(new_p3)
        type_ann = ty
        current_p = new_p4
    }

    var init = expr_new(ExprKind::UnitLit, "()", span_new(0, 0))
    if match_token_ref(&current_p, TokenKind::Eq) {
        let (new_p5, _) = advance(current_p)
        let (new_p6, expr) = parse_expr(new_p5)
        init = expr
        current_p = new_p6
    }

    let final_p = consume(current_p, TokenKind::Semi)

    var var_expr = expr_new(ExprKind::Var, name_tok.text, span_new(tok.line, tok.column))
    var_expr.type_ann = type_ann
    var_expr.children[0] = 0
    var_expr.children_len = 1

    return (final_p, var_expr)
}

fn parse_if(p: Parser) -> (Parser, Expr) with Mut, Panic {
    let tok = peek_ref(&p)
    let (new_p, _) = advance(p)
    let (new_p2, cond) = parse_expr(new_p)
    let (new_p3, then_branch) = parse_block(new_p2)

    var current_p = new_p3
    var else_branch = expr_new(ExprKind::UnitLit, "()", span_new(0, 0))

    if match_token_ref(&current_p, TokenKind::Else) {
        let (new_p4, _) = advance(current_p)

        if match_token_ref(&new_p4, TokenKind::If) {
            let (new_p5, elif) = parse_if(new_p4)
            else_branch = elif
            current_p = new_p5
        } else {
            let (new_p5, else_block) = parse_block(new_p4)
            else_branch = else_block
            current_p = new_p5
        }
    }

    var if_expr = expr_new(ExprKind::If, "if", span_new(tok.line, tok.column))
    if_expr.children[0] = 0
    if_expr.children[1] = 1
    if_expr.children[2] = 2
    if_expr.children_len = 3

    return (current_p, if_expr)
}

fn parse_while(p: Parser) -> (Parser, Expr) with Mut, Panic {
