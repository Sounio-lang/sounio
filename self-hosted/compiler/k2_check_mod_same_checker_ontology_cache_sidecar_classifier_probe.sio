use check::mod::{
    check_ontology_side_table_cache_same_checker_sidecar_disjoint_verdict_probe,
    check_ontology_side_table_cache_same_checker_sidecar_subclass_verdict_probe,
}
use lexer::mod::{lex_file_parse_items}
use parser::parser::{parser_last_error_count}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    print("k2_check_mod_same_checker_ontology_cache_sidecar_classifier_probe=start\n")
    let argc = arg_count()
    if argc < 1 {
        print("usage: k2_check_mod_same_checker_ontology_cache_sidecar_classifier_probe <cache-consumer-source>\n")
        return 2
    }

    let source_path = get_arg(0)
    print("k2_check_mod_same_checker_ontology_cache_sidecar_classifier_probe=parse_enter\n")
    let items = lex_file_parse_items(source_path)
    print("k2_check_mod_same_checker_ontology_cache_sidecar_classifier_probe=parse_ok\n")
    if parser_last_error_count() > 0 {
        print("k2_check_mod_same_checker_ontology_cache_sidecar_classifier_probe=parse_error\n")
        return 2
    }

    print("k2_check_mod_same_checker_ontology_cache_sidecar_classifier_probe=sourcecheck_enter\n")
    let snomed_positive = check_ontology_side_table_cache_same_checker_sidecar_subclass_verdict_probe(items, source_path, 73211009, 138875005)
    print("k2_check_mod_same_checker_ontology_cache_sidecar_classifier_probe=snomed_positive=")
    print_int(snomed_positive)
    print("\n")

    let snomed_reverse = check_ontology_side_table_cache_same_checker_sidecar_subclass_verdict_probe(items, source_path, 138875005, 73211009)
    print("k2_check_mod_same_checker_ontology_cache_sidecar_classifier_probe=snomed_reverse=")
    print_int(snomed_reverse)
    print("\n")

    let part_positive = check_ontology_side_table_cache_same_checker_sidecar_subclass_verdict_probe(items, source_path, 4, 2)
    print("k2_check_mod_same_checker_ontology_cache_sidecar_classifier_probe=part_positive=")
    print_int(part_positive)
    print("\n")

    let part_reverse = check_ontology_side_table_cache_same_checker_sidecar_subclass_verdict_probe(items, source_path, 2, 4)
    print("k2_check_mod_same_checker_ontology_cache_sidecar_classifier_probe=part_reverse=")
    print_int(part_reverse)
    print("\n")

    let part_disjoint = check_ontology_side_table_cache_same_checker_sidecar_disjoint_verdict_probe(items, source_path, 3, 12)
    print("k2_check_mod_same_checker_ontology_cache_sidecar_classifier_probe=part_disjoint=")
    print_int(part_disjoint)
    print("\n")

    let part_disjoint_reverse = check_ontology_side_table_cache_same_checker_sidecar_disjoint_verdict_probe(items, source_path, 12, 3)
    print("k2_check_mod_same_checker_ontology_cache_sidecar_classifier_probe=part_disjoint_reverse=")
    print_int(part_disjoint_reverse)
    print("\n")

    if (snomed_positive == 0 && snomed_reverse == 152 && part_positive == 152 && part_reverse == 152 && part_disjoint == 152 && part_disjoint_reverse == 152) ||
       (snomed_positive == 152 && snomed_reverse == 152 && part_positive == 0 && part_reverse == 152 && part_disjoint == 0 && part_disjoint_reverse == 0) {
        print("k2_check_mod_same_checker_ontology_cache_sidecar_classifier_probe=ok\n")
        return 0
    }

    print("k2_check_mod_same_checker_ontology_cache_sidecar_classifier_probe=rejected\n")
    1
}
