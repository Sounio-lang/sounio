// Helpers required by codegen dependency chain (flat-namespace resolution).
fn char_from_i64(n: i64) -> string with Mut, Panic {
    if n == 0 { "0" }
    else if n == 1 { "1" }
    else if n == 2 { "2" }
    else if n == 3 { "3" }
    else if n == 4 { "4" }
    else if n == 5 { "5" }
    else if n == 6 { "6" }
    else if n == 7 { "7" }
    else if n == 8 { "8" }
    else if n == 9 { "9" }
    else { "?" }
}

fn int_to_string(n: i64) -> string with Mut, Panic, Div {
    if n == 0 { return "0" }
    let negative = n < 0
    let rem = if negative { n } else { 0 - n }
    var result = ""
    var r = rem
    if r == 0 { return "0" }
    while r < 0 {
        let digit = 0 - (r - ((r / 10) * 10))
        r = r / 10
        result = char_from_i64(digit) + result
    }
    if negative { "-" + result } else { result }
}

// Inlined from module_loader.sio to avoid importing 3900 lines.
fn load_source_file(path: string) -> Program with IO, Mut, Div, Panic, Alloc {
    let data = read_file(path)
    let size = file_size(path)
    var buf: [i8; 1048576] = [0; 1048576]
    var i: i64 = 0
    while i < size && i < 1048576 {
        buf[i as usize] = data[i as usize]
        i = i + 1
    }
    let state = lex(buf, size, 0)
    parse_program_preloaded(state.token_count)
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    if argc < 1 {
        print("wide_native_compile: usage: wide_native_compile_driver.sio <source.sio> [-o <output>]\n")
        print("wide_native_compile: usage: wide_native_compile_driver.sio <source.sio> <output>\n")
        return 1
    }
    let source_path = get_arg(0)

    // Parse output path: supports both "-o <output>" and positional "<output>"
    var output_path = "a.out"
    if argc >= 3 {
        let flag = get_arg(1)
        if flag == "-o" {
            output_path = get_arg(2)
        }
    }
    if argc == 2 {
        let arg1 = get_arg(1)
        if arg1 != "-o" {
            output_path = arg1
        }
    }

    print("wide_native_compile: source=")
    print(source_path)
    print(" output=")
    print(output_path)
    print("\n")

    // Phase 0: Parse
    let prog = load_source_file(source_path)
    if parser_last_error_count() > 0 {
        print("wide_native_compile: parse_error\n")
        return 1
    }
    print("wide_native_compile: parse_ok\n")

    // Phase 1: Flat IR summary (signatures only, no body lowering yet)
    let epistemic = ir_empty_epistemic_section()
    let summary_result = lower_program_to_ir_summary_flat_owned_with_epistemic_ref(&prog, epistemic)
    if summary_result.had_error {
        print("wide_native_compile: summary_lower_error\n")
        return 2
    }

    let fn_count = summary_result.summary.module.fn_count
    print("wide_native_compile: fn_count=")
    print_int(fn_count)
    print("\n")

    if fn_count <= 0 {
        print("wide_native_compile: empty_module\n")
        return 2
    }

    if fn_count > 1024 {
        print("wide_native_compile: too_many_functions (max=1024)\n")
        return 2
    }

    // Phase 2: Streaming call graph extraction (pass 1 - one body at a time).
    // Each body is lowered, scanned for IrCall edges, then discarded.
    // Peak memory: 1 IrFunction (~24KB) instead of all fn_count (~24MB).
    let main_idx = reach_find_main(&summary_result.summary.module)
    var graph = scg_new(fn_count)
    var fi: i64 = 0
    while fi < fn_count {
        let fn_name = ir_fn_get(&summary_result.summary.module, fi as usize).name
        let body_result = lower_program_function_body_from_summary_flat_with_epistemic_ref(
            &prog, &summary_result.summary, epistemic, fn_name
        )
        if body_result.func.instr_count > 0 {
            graph = scg_scan_function(graph, body_result.func, fi)
        }
        // body_result.func dropped here - not stored
        fi = fi + 1
    }
    print("wide_native_compile: graph_edges=")
    print_int(graph.edge_count)
    print("\n")

    // Phase 3: BFS reachability from main()
    let mark = scg_mark_reachable(&graph, main_idx)
    let remap = reach_build_remap(mark, fn_count)
    let reachable_count = scg_count_reachable(mark, fn_count)
    let eliminated_count = fn_count - reachable_count
    print("wide_native_compile: reachable=")
    print_int(reachable_count)
    print(" eliminated=")
    print_int(eliminated_count)
    print("\n")

    // Phase 4: Lower only reachable function bodies (pass 2).
    // Builds a compacted IrModule containing only reachable functions.
    var thin_module = summary_result.summary.module
    var thin_idx: i64 = 0
    var fi2: i64 = 0
    while fi2 < fn_count {
        if mark[fi2 as usize] {
            let fn_name2 = ir_fn_get(&summary_result.summary.module, fi2 as usize).name
            let body_result2 = lower_program_function_body_from_summary_flat_with_epistemic_ref(
                &prog, &summary_result.summary, epistemic, fn_name2
            )
            if body_result2.func.instr_count > 0 {
                ir_fn_set(&! thin_module, thin_idx as usize, body_result2.func)
            }
            thin_idx = thin_idx + 1
        }
        fi2 = fi2 + 1
    }
    thin_module.fn_count = thin_idx
    reach_patch_calls(&!thin_module, &remap)
    print("wide_native_compile: thin_fn_count=")
    print_int(thin_module.fn_count)
    print("\n")

    // Phase 5: Wide batch compile + ELF emission
    print("wide_native_compile: compiling (batch_size=200)\n")
    let result = wide_compile_and_emit(&thin_module, output_path)

    if !result.ok {
        print("wide_native_compile: compile_error\n")
        return 3
    }

    print("wide_native_compile: ok fn_count=")
    print_int(result.fn_count)
    print(" code_size=")
    print_int(result.code_size)
    print(" reloc_count=")
    print_int(result.reloc_count)
    print(" output=")
    print(output_path)
    print("\n")
    0
}
