// self-hosted::compiler::wide_native_compile_driver
//
// Wide native compile driver for modules with >256 functions (up to 1024).
// Uses the wide compilation driver which batches functions in groups of 200
// through the standard NativeCompiler.
//
// Pipeline: parse -> typecheck (optional) -> IR lower -> wide batch compile -> ELF -> write
//
// Usage:
//   souc run self-hosted/compiler/wide_native_compile_driver.sio -- <source.sio> [-o <output>]
//   souc run self-hosted/compiler/wide_native_compile_driver.sio -- <source.sio> <output>
//
// Sprint 127: CLI entry point for wide compilation driver.

use lexer::mod::*
use parser::ast::*
use ir::ir::*
use check::dependent::*
use check::types::*
use check::mod::{check_program, check_program_epistemic_into}
use check::ownership::*
use check::lint::*
use check::layout::*
use io::file_write::*
use interop::contract::*
use native::aarch64::*
use native::encode::*
use native::elf::*
use native::elf_bulk::*
use native::macho::*
use native::reloc::*
use native::frame::*
use native::lower_ir::*
use native::machine_ir::*
use native::gc::*
use native::runtime_context::*
use native::stack_maps::*
use native::target_policy::*
use wasm::core::*
use wasm::encode::*
use wasm::lower::*
use native::codegen::*
use native::wide::*
use native::wide_driver::*
use parser::mod::{parse_program_preloaded, count_items}
use parser::parser::{parser_last_error_count}
use ir::opt_strategy::{ir_opt_apply_strategy, ir_opt_find_return_vreg, ir_opt_max_label, ir_opt_max_vreg}
use ir::lower::{ir_patch_validated_calls, lower_program_to_ir, lower_program_to_ir_with_epistemic, lower_program_to_ir_probe_summary_ref, lower_program_to_ir_probe_summary_box_ref, lower_program_to_ir_summary_box_probe_with_epistemic_ref, lower_program_function_body_from_summary_with_epistemic_ref, lower_program_to_ir_summary_flat_with_epistemic_ref, lower_program_function_body_from_summary_flat_with_epistemic_ref, lower_program_to_ir_summary_flat_owned_with_epistemic_ref}
use ir::lower::{lower_program_to_ir_with_epistemic_ref, lower_program_to_ir_ordered_with_epistemic_boxed_trace_ref}
use ir::const_prop::{cp_check_load_imm, cp_empty_instrs, cp_make_test_func, cp_optimize_function}
use ir::dce::{dce_check_nop, dce_empty_instrs, dce_make_test_func, dce_optimize_function}
use ir::profile::*
