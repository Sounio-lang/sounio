// self-hosted::compiler::module_parse
//
// Parse/import-only module helpers split out from module_loader.sio.
// Keep this surface intentionally small so lightweight probes do not pull the
// native backend, wasm lowering, optimizer stack, or thin-link cache machinery.

use parser::ast::{AstPath, empty_path, ImportItemList, ItemKind, ItemList, Program, StringList}
use lexer::mod::{lex_file_parse_items}

pub struct ImportList {
    pub paths: [AstPath; 256],
    pub count: i64,
    pub overflow: bool,
}

pub fn extract_imports_from_ast(prog: Program) -> ImportList with Mut, Panic, Div, Alloc {
    extract_imports_from_ast_ref(&prog)
}

pub fn extract_imports_from_ast_ref(prog: &Program) -> ImportList with Mut, Panic, Div, Alloc {
    var imports = ImportList {
        paths: [empty_path(); 256],
        count: 0,
        overflow: false,
    }

    match (*prog).items {
        None => imports
        Some(items) => {
            extract_imports_walk_ref_into(&(*items), &! imports)
            imports
        }
    }
}

fn extract_imports_walk_into(list: ItemList, out: &! ImportList) with Mut, Panic, Div, Alloc {
    extract_imports_walk_ref_into(&list, out)
}

fn extract_imports_walk_ref_into(list: &ItemList, out: &! ImportList) with Mut, Panic, Div, Alloc {
    if (*list).head.kind == ItemKind::ItemUse {
        if (*out).count < 256 {
            let import_index = (*out).count
            if mp_copy_ast_path_into(
                &(*list).head.use_path,
                &!(*out).paths[import_index],
            ) {
                (*out).count = import_index + 1
            } else {
                (*out).overflow = true
            }
        } else {
            (*out).overflow = true
        }
    }
    match (*list).tail {
        None => {}
        Some(next) => extract_imports_walk_ref_into(&(*next), out)
    }
}

fn mp_stat_byte(buf: [i8; 256], idx: i64) -> i64 {
    let v = buf[idx as usize] as i64
    if v < 0 { v + 256 } else { v }
}

fn mp_stat_mode(buf: [i8; 256]) -> i64 {
    mp_stat_byte(buf, 24) +
    (mp_stat_byte(buf, 25) * 256) +
    (mp_stat_byte(buf, 26) * 65536) +
    (mp_stat_byte(buf, 27) * 16777216)
}

pub fn file_exists(path: string) -> bool with IO {
    // Use the target-aware file_size builtin instead of raw x86-64 Linux syscalls
    // (openat=257/fstat=5/close=3). Those numbers are invalid on arm64-macOS and
    // SIGSYS'd every module load. file_size returns -1 when the file is absent or
    // unreadable, so >= 0 means it exists (and is at least stat-able).
    file_size(path) >= 0
}

fn mp_empty_program() -> Program {
    Program {
        module_path: empty_path(),
        items: None,
    }
}

fn file_path_to_module_path(path: string) -> AstPath with Mut, Panic, Div {
    var seg_buf: [i8; 128] = [0; 128]
    var seg_len: i64 = 0
    var segs = StringList { head_buf: [0; 128], head_len: 0, tail: None }
    var path_len = str_len(path)
    var i: i64 = 0
    var last_slash: i64 = 0 - 1
    var dot_pos: i64 = path_len
    while i < path_len {
        let ch = str_char_at(path, i)
        if ch == 47 {
            last_slash = i
        }
        if ch == 46 {
            dot_pos = i
        }
        i = i + 1
    }
    var start = last_slash + 1
    var end = dot_pos
    if end <= start {
        end = path_len
    }
    seg_len = 0
    i = start
    while i < end && seg_len < 128 {
        seg_buf[seg_len] = str_char_at(path, i) as i8
        seg_len = seg_len + 1
        i = i + 1
    }
    segs.head_buf = seg_buf
    segs.head_len = seg_len
    AstPath { segments: segs, seg_count: 1 }
}

fn mp_clear_ast_path(out: &!AstPath) with Mut {
    var i: i64 = 0
    while i < 128 {
        (*out).segments.head_buf[i as usize] = 0
        i = i + 1
    }
    (*out).segments.head_len = 0
    (*out).segments.tail = None
    (*out).seg_count = 0
}

fn file_path_to_module_path_into(path: string, out: &!AstPath) with Mut, Panic, Div {
    mp_clear_ast_path(out)
    let path_len = str_len(path)
    var i: i64 = 0
    var last_slash: i64 = 0 - 1
    var dot_pos: i64 = path_len
    while i < path_len {
        let ch = str_char_at(path, i)
        if ch == 47 {
            last_slash = i
        }
        if ch == 46 {
            dot_pos = i
        }
        i = i + 1
    }
    let start = last_slash + 1
    var end = dot_pos
    if end <= start {
        end = path_len
    }
    var seg_len: i64 = 0
    i = start
    while i < end && seg_len < 128 {
        (*out).segments.head_buf[seg_len as usize] = str_char_at(path, i) as i8
        seg_len = seg_len + 1
        i = i + 1
    }
    (*out).segments.head_len = seg_len
    if seg_len > 0 {
        (*out).seg_count = 1
    }
}

fn mp_copy_string_list_into(
    source: &StringList,
    out: &!StringList,
    remaining: i64,
) -> bool with Mut, Alloc {
    if remaining <= 0 || (*source).head_len <= 0 || (*source).head_len > 128 {
        return false
    }
    var i: i64 = 0
    while i < 128 {
        (*out).head_buf[i as usize] = (*source).head_buf[i as usize]
        i = i + 1
    }
    (*out).head_len = (*source).head_len
    match (*source).tail {
        None => {
            (*out).tail = None
            remaining == 1
        }
        Some(next) => {
            if remaining <= 1 {
                return false
            }
            var copied_tail = Box::new(StringList {
                head_buf: [0; 128],
                head_len: 0,
                tail: None,
            })
            if !mp_copy_string_list_into(&(*next), &!(*copied_tail), remaining - 1) {
                return false
            }
            (*out).tail = Some(copied_tail)
            true
        }
    }
}

fn mp_copy_ast_path_into(source: &AstPath, out: &!AstPath) -> bool with Mut, Alloc {
    let count = (*source).seg_count
    if count <= 0 || count > 256 {
        return false
    }
    mp_clear_ast_path(out)
    if !mp_copy_string_list_into(&(*source).segments, &!(*out).segments, count) {
        mp_clear_ast_path(out)
        return false
    }
    (*out).seg_count = count
    true
}

// parse_module_item stores declarations on its ItemUnit placeholder; real unit
// declarations keep use_path empty.
fn declared_module_path(items: Option<Box<ItemList>>) -> AstPath with Mut, Panic, Div, Alloc {
    match items {
        None => empty_path()
        Some(list) => {
            let item = (*list).head
            if item.kind == ItemKind::ItemUnit && item.use_path.seg_count > 0 {
                item.use_path
            } else {
                declared_module_path((*list).tail)
            }
        }
    }
}

fn declared_module_path_into_bounded(
    items: &Option<Box<ItemList>>,
    out: &!AstPath,
    remaining: i64,
) -> i64 with Mut, Alloc {
    match *items {
        None => 0
        Some(list) => {
            if remaining <= 0 {
                return 0 - 1
            }
            if (*list).head.kind == ItemKind::ItemUnit && (*list).head.use_path.seg_count > 0 {
                if mp_copy_ast_path_into(&(*list).head.use_path, out) { 1 } else { 0 - 1 }
            } else {
                declared_module_path_into_bounded(&(*list).tail, out, remaining - 1)
            }
        }
    }
}

pub fn load_module_file(path: string) -> Program with IO, Mut, Div, Panic, Alloc {
    if !file_exists(path) {
        return mp_empty_program()
    }
    let items = lex_file_parse_items(path)
    var module_path = file_path_to_module_path(path)
    let declared_path = declared_module_path(items)
    if declared_path.seg_count > 0 {
        module_path = declared_path
    }
    Program {
        module_path: module_path,
        items: items,
    }
}

// Populate caller-provided stable storage. Callers that publish this Program in
// an aggregate array must pin the storage first; current aggregate arrays hold
// pointers, so the address of an array slot is not the Program's address.
pub fn load_module_file_into(path: string, out: &!Program) -> bool with IO, Mut, Div, Panic, Alloc {
    if !file_exists(path) {
        mp_clear_ast_path(&!(*out).module_path)
        (*out).items = None
        return false
    }
    let items = lex_file_parse_items(path)
    file_path_to_module_path_into(path, &!(*out).module_path)
    let declared_status = declared_module_path_into_bounded(
        &items,
        &!(*out).module_path,
        4096,
    )
    if declared_status < 0 {
        mp_clear_ast_path(&!(*out).module_path)
        (*out).items = items
        return false
    }
    (*out).items = items
    true
}
