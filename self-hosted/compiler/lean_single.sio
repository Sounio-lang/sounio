    if k == 32 {
        EP = EP + 1
        compile_primary_a64()
        compile_postfix_tail_a64()
        em32(0xF100001F)  // cmp x0, #0
        em32(0x9A9F17E0)  // cset x0, eq
        EXPR_IS_F64 = 0
        return
    }
    // String literal
    if k == 5 {
        let ss = TS[EP as usize] + 1
        let se = TE[EP as usize] - 1
        var slen: i64 = 0
        var zi: i64 = 0
        while zi < 256 { SQW[zi as usize] = 0; zi = zi + 1 }
        var si: i64 = ss
        while si < se {
            let ch = sb(si)
            var byte: i64 = ch
            if ch == 92 && si + 1 < se {
                let c2 = sb(si + 1)
                if c2 == 120 && si + 3 < se {
                    let h1 = sb(si + 2)
                    let h2 = sb(si + 3)
                    var v1: i64 = 0 - 1
                    if h1 >= 48 && h1 <= 57 { v1 = h1 - 48 }
                    else if h1 >= 97 && h1 <= 102 { v1 = h1 - 87 }
                    else if h1 >= 65 && h1 <= 70 { v1 = h1 - 55 }
                    var v2: i64 = 0 - 1
                    if h2 >= 48 && h2 <= 57 { v2 = h2 - 48 }
                    else if h2 >= 97 && h2 <= 102 { v2 = h2 - 87 }
                    else if h2 >= 65 && h2 <= 70 { v2 = h2 - 55 }
                    if v1 >= 0 && v2 >= 0 {
