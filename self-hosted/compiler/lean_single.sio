                if TK[EP as usize] == 52 { EP = EP + 1 }
                var vb_arm_has_block_a64: i64 = 0
                if TK[EP as usize] == 8 { vb_arm_has_block_a64 = 1; EP = EP + 1 }
                LAST_STMT_HAS_VALUE = 0
                if vb_arm_has_block_a64 == 1 {
                    while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt_a64() }
                    if TK[EP as usize] == 9 { EP = EP + 1 }
                } else { compile_stmt_a64() }
                // β⁹ GTT week-7 (a64): OR var-binding arm's tail EXPR_CH_SET into union.
                match_arms_ch_union_a = match_arms_ch_union_a | EXPR_CH_SET
                match_arms = match_arms + 1
                if vb_has_guard_a64 == 0 { if match_arms < 1000000 { match_arms = 1000000 } }
                if LAST_STMT_HAS_VALUE == 1 {
                    if match_have_ty == 0 { match_have_ty = 1; match_ty = LAST_STMT_TY; match_hash = LAST_STMT_TY_HASH }
                    else if ty_eq(match_ty, match_hash, LAST_STMT_TY, LAST_STMT_TY_HASH) == false { tc_error(EP - 1, "match arm type does not match other arms") }
                } else { match_all_value = 0 }
                if vb_has_guard_a64 == 1 {
                    match_ends[arm_count as usize] = CL; em32(0x14000000)
                    arm_count = arm_count + 1
                    patch_branch_a64(vb_guard_skip_a64, CL)
                }
            }
            if is_or_pattern_a64 == 0 && disc >= 0 {
                if arm_is_tagged == 1 {
                    emit_load_var_a64(match_slot); em32(0xF9400000); emit_push_a64()
                    emit_imm64_a64(disc); emit_pop_x1_a64()
                    em32(0xEB00003F)
                    let skip_off = CL; em32(0x54000001)
                    if has_binding == 1 {
                        emit_load_var_a64(match_slot)
                        em32(0xF9400400)
                        let bslot = var_add(bind_ns, bind_ne)
                        if bslot >= 0 {
                            emit_store_var_a64(bslot)
                            // Propagate inner type from Option/Result scrutinee to the
                            // bound variable (mirror of x86 :~24328). Without this the
                            // payload binding reads as untyped (ty=0), so `*binding`
                            // derefs to 0 and `(*binding).field` blind-scans to the wrong
                            // struct → spurious E001 type-mismatch at call sites.
                            if VAR_COUNT > 0 {
                                let bvi = VAR_COUNT - 1
                                if type_is_option_inline(match_scrut_ty_a, match_scrut_hash_a) && option_hash_is(match_scrut_hash_a) {
                                    VAR_TY[bvi as usize] = option_hash_inner_ty(match_scrut_hash_a)
                                    VAR_TY_HASH[bvi as usize] = option_hash_inner_hash(match_scrut_hash_a)
                                }
                                // β⁹ GTT week-7 follow-up (a64): tagged inner bind inherits
                                // scrutinee topology (mirror of x86 :~24336).
                                VAR_CH_SET[bvi as usize] = match_scrut_ch_set_a
                            }
                        }
                    }
                    if TK[EP as usize] == 52 { EP = EP + 1 }
                    var arm_has_block: i64 = 0
                    if TK[EP as usize] == 8 { arm_has_block = 1; EP = EP + 1 }
                    LAST_STMT_HAS_VALUE = 0
                    if arm_has_block == 1 {
                        while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt_a64() }
                        if TK[EP as usize] == 9 { EP = EP + 1 }
                    } else {
                        compile_stmt_a64()
                    }
                    // β⁹ GTT week-7 (a64): OR tagged-variant arm's tail EXPR_CH_SET into union.
                    match_arms_ch_union_a = match_arms_ch_union_a | EXPR_CH_SET
                    match_arms = match_arms + 1
                    if LAST_STMT_HAS_VALUE == 1 {
                        if match_have_ty == 0 {
                            match_have_ty = 1
                            match_ty = LAST_STMT_TY
                            match_hash = LAST_STMT_TY_HASH
                        } else if ty_eq(match_ty, match_hash, LAST_STMT_TY, LAST_STMT_TY_HASH) == false {
                            tc_error(EP - 1, "match arm type does not match other arms")
                        }
                    } else {
                        match_all_value = 0
                    }
                    match_ends[arm_count as usize] = CL; em32(0x14000000)
                    arm_count = arm_count + 1
                    patch_branch_a64(skip_off, CL)
                } else {
                    emit_load_var_a64(match_slot); emit_push_a64()
                    emit_imm64_a64(disc); emit_pop_x1_a64()
                    em32(0xEB00003F)
                    let skip_off = CL; em32(0x54000001)
                    if TK[EP as usize] == 52 { EP = EP + 1 }
                    var arm_has_block2: i64 = 0
                    if TK[EP as usize] == 8 { arm_has_block2 = 1; EP = EP + 1 }
                    LAST_STMT_HAS_VALUE = 0
                    if arm_has_block2 == 1 {
                        while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt_a64() }
                        if TK[EP as usize] == 9 { EP = EP + 1 }
                    } else {
                        compile_stmt_a64()
                    }
                    // β⁹ GTT week-7 (a64): OR plain-enum arm's tail EXPR_CH_SET into union.
                    match_arms_ch_union_a = match_arms_ch_union_a | EXPR_CH_SET
                    match_arms = match_arms + 1
                    if LAST_STMT_HAS_VALUE == 1 {
                        if match_have_ty == 0 {
                            match_have_ty = 1
                            match_ty = LAST_STMT_TY
                            match_hash = LAST_STMT_TY_HASH
                        } else if ty_eq(match_ty, match_hash, LAST_STMT_TY, LAST_STMT_TY_HASH) == false {
                            tc_error(EP - 1, "match arm type does not match other arms")
                        }
                    } else {
                        match_all_value = 0
                    }
                    match_ends[arm_count as usize] = CL; em32(0x14000000)
                    arm_count = arm_count + 1
                    patch_branch_a64(skip_off, CL)
                }
            }
            if is_or_pattern_a64 == 0 && is_wildcard == 1 {
                if match_arms < 1000000 { match_arms = 1000000 }
                if TK[EP as usize] == 52 { EP = EP + 1 }
                var arm_has_block3: i64 = 0
                if TK[EP as usize] == 8 { arm_has_block3 = 1; EP = EP + 1 }
                LAST_STMT_HAS_VALUE = 0
                if arm_has_block3 == 1 {
                    while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt_a64() }
                    if TK[EP as usize] == 9 { EP = EP + 1 }
                } else {
                    compile_stmt_a64()
                }
                // β⁹ GTT week-7 (a64): OR wildcard arm's tail EXPR_CH_SET into union.
                match_arms_ch_union_a = match_arms_ch_union_a | EXPR_CH_SET
                match_arms = match_arms + 1
                if LAST_STMT_HAS_VALUE == 1 {
                    if match_have_ty == 0 {
                        match_have_ty = 1
                        match_ty = LAST_STMT_TY
                        match_hash = LAST_STMT_TY_HASH
                    } else if ty_eq(match_ty, match_hash, LAST_STMT_TY, LAST_STMT_TY_HASH) == false {
                        tc_error(EP - 1, "match arm type does not match other arms")
                    }
                } else {
                    match_all_value = 0
                }
            }
            if TK[EP as usize] == 28 { EP = EP + 1 }
        }
        if TK[EP as usize] == 9 { EP = EP + 1 }
        var ai: i64 = 0
        while ai < arm_count { patch_branch_a64(match_ends[ai as usize], CL); ai = ai + 1 }
        // FALL-THROUGH FIX (a64 mirror of x86 em(0x90) at match merge): a non-returning arm
        // falling through to this merge after a `ret`-ending arm must not let the implicit-return
        // guard skip the epilogue; emit a nop so the last word != ret.
        em32(0xD503201F)  // nop
        if match_scrut_ty_a == 7 && match_arms < 1000000 && match_arms < en_variant_count(match_scrut_hash_a) {
            tc_error_hard(EP - 1, "match must be exhaustive")
            LAST_STMT_HAS_VALUE = 0
            LAST_STMT_TY = 0
            LAST_STMT_TY_HASH = 0
            return
        }
        if match_arms > 0 && match_all_value == 1 && match_have_ty == 1 {
            LAST_STMT_HAS_VALUE = 1
            LAST_STMT_TY = match_ty
            LAST_STMT_TY_HASH = match_hash
            EXPR_TY = match_ty
            EXPR_TY_HASH = match_hash
            if match_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
            // β⁹ GTT week-7 stage 2 (a64): final topology = scrutinee ∪ union-of-arms.
            EXPR_CH_SET = match_scrut_ch_set_a | match_arms_ch_union_a
        }
        return
    }
    // Expression statement
    compile_or_a64()
    LAST_STMT_HAS_VALUE = 1
    LAST_STMT_TY = EXPR_TY
    LAST_STMT_TY_HASH = EXPR_TY_HASH
}

// ─── ARM64 top-level compiler ───
fn compile_all_arm64() -> i64 with IO, Mut, Panic, Div {
    // Run all frontend passes via compile_all (which also emits x86_64 code, discarded)
    let r = compile_all()
    if r != 0 { return r }
    // Reset code buffer and patches for ARM64 re-emission
    CL = 0
    PATCH_COUNT = 0
    A64_FRAME_PATCH_COUNT = 0
    print("arm64: re-emitting pass 2\n")
    // ARM64 Pass 2: compile each function
    var p: i64 = 0
    var fn_idx: i64 = 0
    while fn_idx < FN_COUNT {
        p = FN_NAME_TOK[fn_idx as usize]
        let body_open = FN_BODY_OPEN[fn_idx as usize]
        let body_close = FN_BODY_CLOSE[fn_idx as usize]
        if body_open < 0 { fn_idx = fn_idx + 1; continue }
        if p <= 0 || p >= TC || body_open == 0 || body_close <= body_open || body_close > TC {
            print("error[E217]: invalid function body span for fn#")
            print_int(fn_idx)
            print(" ")
            print_fn_name(fn_idx)
            print("\n")
            return 1
        }
        FN_OFF[fn_idx as usize] = CL
        CURRENT_FN = fn_idx
        CURRENT_RET_TY = FN_RET_TY[fn_idx as usize]
        CURRENT_RET_HASH = FN_RET_HASH[fn_idx as usize]
        VAR_COUNT = 0; NEXT_SLOT = 1; BREAK_COUNT = 0; LAST_STMT_HAS_VALUE = 0
        // β⁴/β⁶/β⁷: reset shadow state for new function scope (a64)
        EXPR_VSHADOW = -1; EXPR_SSHADOW = -1; EXPR_SSHADOW_1 = -1; EXPR_SSHADOW_2 = -1; EXPR_SSHADOW_3 = -1; EXPR_SSHADOW_4 = -1; EXPR_SSHADOW_5 = -1; EXPR_SSHADOW_6 = -1; EXPR_SSHADOW_7 = -1; MEAS_CALL_IDX = 0; MEAS_KNOW_IDX = 0; KM_CACHE_COUNT = 0
        CHANNEL_INPUT_VAR_SLOT[0] = 0 - 1; CHANNEL_INPUT_VAR_SLOT[1] = 0 - 1; CHANNEL_INPUT_VAR_SLOT[2] = 0 - 1; CHANNEL_INPUT_VAR_SLOT[3] = 0 - 1
        CHANNEL_INPUT_VAR_SLOT[4] = 0 - 1; CHANNEL_INPUT_VAR_SLOT[5] = 0 - 1; CHANNEL_INPUT_VAR_SLOT[6] = 0 - 1; CHANNEL_INPUT_VAR_SLOT[7] = 0 - 1
        EXPR_HSHADOW_00 = -1; EXPR_HSHADOW_01 = -1; EXPR_HSHADOW_02 = -1; EXPR_HSHADOW_03 = -1; EXPR_HSHADOW_11 = -1; EXPR_HSHADOW_12 = -1; EXPR_HSHADOW_13 = -1; EXPR_HSHADOW_22 = -1; EXPR_HSHADOW_23 = -1; EXPR_HSHADOW_33 = -1
    EXPR_HSHADOW_04 = -1; EXPR_HSHADOW_05 = -1; EXPR_HSHADOW_06 = -1; EXPR_HSHADOW_07 = -1
    EXPR_HSHADOW_14 = -1; EXPR_HSHADOW_15 = -1; EXPR_HSHADOW_16 = -1; EXPR_HSHADOW_17 = -1
    EXPR_HSHADOW_24 = -1; EXPR_HSHADOW_25 = -1; EXPR_HSHADOW_26 = -1; EXPR_HSHADOW_27 = -1
    EXPR_HSHADOW_34 = -1; EXPR_HSHADOW_35 = -1; EXPR_HSHADOW_36 = -1; EXPR_HSHADOW_37 = -1
    EXPR_HSHADOW_44 = -1; EXPR_HSHADOW_45 = -1; EXPR_HSHADOW_46 = -1; EXPR_HSHADOW_47 = -1
    EXPR_HSHADOW_55 = -1; EXPR_HSHADOW_56 = -1; EXPR_HSHADOW_57 = -1
    EXPR_HSHADOW_66 = -1; EXPR_HSHADOW_67 = -1
    EXPR_HSHADOW_77 = -1
        p = p + 1
        if TK[p as usize] == 6 { p = p + 1 }
        while true {
            let param_tk = TK[p as usize]
            if param_tk == 7 { break }
            if param_tk == 0 { break }
            if param_tk == 3 || param_tk == 79 {
                let pns = TS[p as usize]; let pne = TE[p as usize]
                var pslot: i64 = -1
                if VAR_COUNT >= local_cap() {
                    note_limit_error(1)
                    LAST_LOCAL_BSS_SPILL = 0
                    LAST_LOCAL_BSS_ADDR = 0
                } else {
                    pslot = NEXT_SLOT
                    let idx = VAR_COUNT
                    VAR_NS[idx as usize] = pns
                    VAR_NE[idx as usize] = pne
                    VAR_SLOT[idx as usize] = pslot
                    VAR_LEN_SLOT[idx as usize] = 0
                    VAR_ALEN[idx as usize] = 0
                    VAR_ESIZ[idx as usize] = 8
                    VAR_IS_F64[idx as usize] = 0
                    VAR_IS_CLOSURE[idx as usize] = 0
                    VAR_MUT[idx as usize] = 0
                    VAR_UNIT[idx as usize] = 0
                    VAR_LINEAR[idx as usize] = 0
                    VAR_AFFINE[idx as usize] = 0
                    VAR_MOVED[idx as usize] = 0
                    VAR_BORROW_COUNT[idx as usize] = 0
                    VAR_BORROW_EXCL[idx as usize] = 0
                    VAR_USED[idx as usize] = 0
                    VAR_TY[idx as usize] = 0
                    VAR_TY_HASH[idx as usize] = 0
                    VAR_COUNT = VAR_COUNT + 1
                    NEXT_SLOT = NEXT_SLOT + 1
                    LAST_LOCAL_BSS_SPILL = 0
                    LAST_LOCAL_BSS_ADDR = 0
                }
                p = p + 1
                if TK[p as usize] == 43 {
                    p = p + 1
                    scan_type(p)
                    if pslot >= 0 {
                        VAR_TY[(VAR_COUNT - 1) as usize] = SCAN_TY
                        VAR_TY_HASH[(VAR_COUNT - 1) as usize] = SCAN_TY_HASH
                        if SCAN_TY == 2 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 1 }
                        // fn-type (SCAN_TY==9) parameters arrive as tagged fn-refs (bit 0 set);
                        // mark them closure so the call site untags via the tbnz dispatch (Path A)
                        // instead of blr'ing the tagged address verbatim (Path B → misaligned PC
                        // → SIGBUS). Mirrors the x86 param scan.
                        if SCAN_TY == 9 { VAR_IS_CLOSURE[(VAR_COUNT - 1) as usize] = 1 }
                        if type_is_slice_ref(SCAN_TY, SCAN_TY_HASH) {
                            let len_slot = VAR_SLOT[(VAR_COUNT - 1) as usize]
                            let ptr_slot = NEXT_SLOT
                            NEXT_SLOT = NEXT_SLOT + 1
                            VAR_SLOT[(VAR_COUNT - 1) as usize] = ptr_slot
                            VAR_LEN_SLOT[(VAR_COUNT - 1) as usize] = len_slot
                            VAR_ESIZ[(VAR_COUNT - 1) as usize] = arr_hash_esiz(ref_hash_inner_hash(SCAN_TY_HASH))
                        } else if SCAN_TY == 8 {
                            VAR_ALEN[(VAR_COUNT - 1) as usize] = SCAN_TY_ALEN
                            VAR_ESIZ[(VAR_COUNT - 1) as usize] = SCAN_TY_ESIZ
                        }
                    }
                    p = SCAN_TY_NEXT
                } else if pslot >= 0 && src_match(pns, pne - pns, "self") && FN_RECV_HASH[fn_idx as usize] != 0 {
                    // Bare `self` receiver (no `:` annotation): infer its type from
                    // the enclosing impl's receiver hash (mirror of the x86 pass-0
                    // param scan, compile_all :~28695). Without this `self` stayed
                    // VAR_TY=0, so `var c = self` propagated ty=0 and `c.field`
                    // fell into the field-access blind scan -> wrong struct/hash ->
                    // spurious E001 (the check.sio `c.ontologies` residual, #740).
                    let self_hash = FN_RECV_HASH[fn_idx as usize]
                    let self_prim_ty = prim_name_hash_ty(self_hash)
                    if self_prim_ty >= 0 {
                        VAR_TY[(VAR_COUNT - 1) as usize] = self_prim_ty
                        VAR_TY_HASH[(VAR_COUNT - 1) as usize] = 0
                        if self_prim_ty == 2 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 1 }
                    } else {
                        VAR_TY[(VAR_COUNT - 1) as usize] = 6
                        VAR_TY_HASH[(VAR_COUNT - 1) as usize] = self_hash
                    }
                }
            } else {
                p = p + 1  // skip keyword or other non-ident token used as param name
            }
            if TK[p as usize] == 28 { p = p + 1 }
        }
        if TK[p as usize] == 7 { p = p + 1 }
        if TK[p as usize] == 10 {
            p = p + 1
            scan_type(p)
            p = SCAN_TY_NEXT
        }
        // Gen 17 D2: skip Epistemic(N) in with clause
        if TK[p as usize] == 38 {
            p = p + 1
            while TK[p as usize] == 3 || TK[p as usize] == 28 {
                if TK[p as usize] == 3 { p = p + 1; if TK[p as usize] == 6 { p = p + 1; while TK[p as usize] != 7 && TK[p as usize] != 0 { p = p + 1 }; if TK[p as usize] == 7 { p = p + 1 } } }
                else { p = p + 1 }
            }
        }
        p = body_open + 1
        CURRENT_BODY_CLOSE = body_close
        let a64_frame_patch_start = A64_FRAME_PATCH_COUNT
        // ARM64 prologue
        em32(0xA9BF7BFD)  // stp x29, x30, [sp, #-16]!
        em32(0x910003FD)  // mov x29, sp
        emit_imm64_reg_a64_patchable(9)
        em32(0xCB2963FF)  // sub sp, sp, x9
        // Spill params using low-level ABI slot order.
        var param_vi_a: i64 = 0
        var abi_arg_idx_a: i64 = 0
        while param_vi_a < VAR_COUNT {
            emit_store_incoming_arg_a64(abi_arg_idx_a, VAR_SLOT[param_vi_a as usize])
            abi_arg_idx_a = abi_arg_idx_a + 1
            if type_is_slice_ref(VAR_TY[param_vi_a as usize], VAR_TY_HASH[param_vi_a as usize]) {
                emit_store_incoming_arg_a64(abi_arg_idx_a, VAR_LEN_SLOT[param_vi_a as usize])
                abi_arg_idx_a = abi_arg_idx_a + 1
            }
            param_vi_a = param_vi_a + 1
        }
        // β⁵ a64: load argument variance values from global BSS array into
        // parameter VAR_VSHADOW slots so callee body sees caller variances.
        param_vi_a = 0
        while param_vi_a < VAR_COUNT && param_vi_a < 16 {
            if VAR_IS_F64[param_vi_a as usize] == 1 {
                let pvs_a = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
                emit_image_addr_a64(GL_BSS_BASE + B5_ARG_VSHADOW_BSS_OFF + param_vi_a * 8)
                em32(0xF9400000)  // ldr x0, [x0]
                emit_store_var_a64(pvs_a)
                VAR_VSHADOW[param_vi_a as usize] = pvs_a
            }
            param_vi_a = param_vi_a + 1
        }
        // β⁹ GTT week-4: seed VAR_PARAM_USED for parameters (a64 mirror of
        // x86 seeding).  The a64 call-site tightening is still deferred —
        // this mirror only keeps load/let propagation accurate.
        var pu_seed_a: i64 = 0
        while pu_seed_a < VAR_COUNT {
            if pu_seed_a < 16 {
                VAR_PARAM_USED[pu_seed_a as usize] = 1 << pu_seed_a
            } else {
                VAR_PARAM_USED[pu_seed_a as usize] = 0
            }
            pu_seed_a = pu_seed_a + 1
        }
        EXPR_PARAM_USED = 0
        // Emit non-zero global initializers once, at main's entry.
        let main_ntk_a = FN_NAME_TOK[fn_idx as usize]
        let main_ns_a = TS[main_ntk_a as usize]
        let main_ne_a = TE[main_ntk_a as usize]
        if src_match(main_ns_a, main_ne_a - main_ns_a, "main") {
            let save_ep_a = EP
            let save_expr_ty_a = EXPR_TY
            let save_expr_ty_hash_a = EXPR_TY_HASH
            let save_expr_is_f64_a = EXPR_IS_F64
            emit_global_inits_a64()
            EP = save_ep_a
            EXPR_TY = save_expr_ty_a
            EXPR_TY_HASH = save_expr_ty_hash_a
            EXPR_IS_F64 = save_expr_is_f64_a
        }
        // Compile body
        EP = p
        var depth: i64 = 1
        while EP < TC && EP < CURRENT_BODY_CLOSE && depth > 0 {
            if TK[EP as usize] == 9 { depth = depth - 1; if depth == 0 { EP = EP + 1; continue } else { EP = EP + 1; continue } }
            compile_stmt_a64()
        }
        p = body_close + 1
        CURRENT_BODY_CLOSE = 0
        // β⁹ GTT week-4: capture body-tail EXPR_PARAM_USED into FN_USED_PARAMS
        // so callers in x86 (and future a64 callers) can tighten channel
        // unions to only the params this function's return actually depends on.
        // Bit 62 = FN_USED_ANALYZED (4611686018427387904).
        FN_USED_PARAMS[fn_idx as usize] = EXPR_PARAM_USED | 4611686018427387904
        // Linear check
        var lci: i64 = 0
        while lci < VAR_COUNT {
            if VAR_LINEAR[lci as usize] == 1 {
                if VAR_USED[lci as usize] == 0 {
                    tc_linear_violation(FN_NAME_TOK[fn_idx as usize], "linear value not consumed")
                }
                if VAR_USED[lci as usize] > 1 {
                    tc_linear_violation(FN_NAME_TOK[fn_idx as usize], "linear value used more than once")
                }
            }
            lci = lci + 1
        }
        // Implicit return
        var needs_epilogue: i64 = 1
        if CL >= 4 { if rd32_at(CL - 4) == 0xD65F03C0 { needs_epilogue = 0 } }
        if needs_epilogue == 1 {
            // Unit return type (5 = no explicit return): always emit mov x0, 0
            if CURRENT_RET_TY == 5 {
                em32(0xD2800000)
            } else if LAST_STMT_HAS_VALUE == 0 {
                em32(0xD2800000)
            } else {
                if ty_eq(CURRENT_RET_TY, CURRENT_RET_HASH, LAST_STMT_TY, LAST_STMT_TY_HASH) == false {
                    if (ty_is_numeric(CURRENT_RET_TY) && ty_is_numeric(LAST_STMT_TY)) == false {
                        if (CURRENT_RET_TY != 0 || CURRENT_RET_HASH != 0) && (LAST_STMT_TY != 0 || LAST_STMT_TY_HASH != 0) {
                            if type_has_knowledge(CURRENT_RET_TY, CURRENT_RET_HASH) || type_has_knowledge(LAST_STMT_TY, LAST_STMT_TY_HASH) {
                                tc_epistemic_boundary(EP)
                            } else {
                                print("warning: tail type mismatch at line ")
                                print_int(TL[(EP - 1) as usize])
                                print("\n")
                            }
                        }
                    }
                }
                if CURRENT_SRET_SLOT > 0 || type_is_aggregate(CURRENT_RET_TY, CURRENT_RET_HASH) || type_is_aggregate(LAST_STMT_TY, LAST_STMT_TY_HASH) {
                    stabilize_return_agg_a64(LAST_STMT_TY, LAST_STMT_TY_HASH)
                }
            }
            // Restore sp from the frame pointer so any transient expression-stack
            // imbalance cannot make the epilogue pop x29/x30 from the wrong address.
            em32(0x910003BF)  // mov sp, x29
            em32(0xA8C17BFD)
            em32(0xD65F03C0)
        }
        let frame_sz = (NEXT_SLOT * 8 + 15) & 0xFFFFFFF0
        FN_FRAME_SIZE[fn_idx as usize] = frame_sz
        if frame_sz > max_frame_bytes() { tc_stack_frame_too_large(frame_sz) }
        var a64_fpi: i64 = a64_frame_patch_start
        while a64_fpi < A64_FRAME_PATCH_COUNT {
            patch_imm64_reg_a64(A64_FRAME_PATCH_OFF[a64_fpi as usize], A64_FRAME_PATCH_RD[a64_fpi as usize], frame_sz)
            a64_fpi = a64_fpi + 1
        }
        fn_idx = fn_idx + 1
    }
    // Patch BL instructions
    var pi: i64 = 0
    while pi < PATCH_COUNT {
        let off = PATCH_OFF[pi as usize]
        let fi = PATCH_FN[pi as usize]
        if fi >= 0 && fi < FN_COUNT && off >= 0 && off + 3 < CL {
            let target = FN_OFF[fi as usize]
            if target == -1 {
                print("error[E220]: unresolved function body for call target fn#")
                print_int(fi)
                print(" ")
                print_fn_name(fi)
                print(" at line ")
                print_int(TL[FN_NAME_TOK[fi as usize] as usize])
                print("\n")
                return 1
            }
            if PATCH_KIND[pi as usize] == 1 {
                patch_adr_a64(off, target, 0)
            } else if PATCH_KIND[pi as usize] == 2 {
                let rel = (target - off) / 4
                em32_at(off, 0x14000000 | (rel & 0x3FFFFFF))
            } else {
                let rel = (target - off) / 4
                em32_at(off, 0x94000000 | (rel & 0x3FFFFFF))
            }
        }
        pi = pi + 1
    }
    // Find main. NOTE: the arm64 pass-2 re-emission repoints FN_NS/FN_NE (the
    // name byte-spans) as scratch, so they are unreliable at this point — reading
    // them yields garbage spans (observed FN_NS[11]=117..5641). FN_NAME_TOK (the
    // name TOKEN index) survives pass 2 intact, so locate main via its token span.
    var main_fn: i64 = -1
    var mi: i64 = 0
    while mi < FN_COUNT {
        let t = FN_NAME_TOK[mi as usize]
        if main_fn < 0 && t > 0 && TE[t as usize] - TS[t as usize] == 4 && sb(TS[t as usize]) == 109 && sb(TS[t as usize]+1) == 97 && sb(TS[t as usize]+2) == 105 && sb(TS[t as usize]+3) == 110 { main_fn = mi }
        mi = mi + 1
    }
    if main_fn < 0 { print("error[E221]: no main\n"); return 1 }
    // Trampoline
    TRAMP_OFF = CL
    if TARGET_OS == 2 {
        let argc_addr = GL_BSS_BASE - 16
        let argv_addr = GL_BSS_BASE - 8
        // LC_MAIN entry arrives with argc in x0 and argv in x1.
        // Skip argv[0] so the self-hosted CLI sees <source> at argv[0].
        em32(0xD1000409)  // sub x9, x0, #1
        emit_image_addr_reg_a64(10, argc_addr)
        em32(0xF9000149)  // str x9, [x10]
        em32(0x91002029)  // add x9, x1, #8
        emit_image_addr_reg_a64(10, argv_addr)
        em32(0xF9000149)  // str x9, [x10]
        let mrel = (FN_OFF[main_fn as usize] - CL) / 4
        em32(0x94000000 | (mrel & 0x3FFFFFF))
        emit_imm64_reg_a64(16, 1)
        em32(0xD4001001)
    } else {
        let argc_addr = 0x10000000
        let argv_addr = 0x10000000 + 8
        em32(0xF94003E9)
        em32(0xD1000529)
        emit_imm64_reg_a64(10, argc_addr)
        em32(0xF9000149)
        em32(0x91000000 | (16 << 10) | (31 << 5) | 9)
        emit_imm64_reg_a64(10, argv_addr)
        em32(0xF9000149)
        let mrel = (FN_OFF[main_fn as usize] - CL) / 4
        em32(0x94000000 | (mrel & 0x3FFFFFF))
        em32(0xD2800000 | ((93 & 0xFFFF) << 5) | 8)
        em32(0xD4000001)
    }
    // --debug-fn-map: emit a function->code-offset map for the arm64 target so a
    // gdb symbol file can be built for the (otherwise stripped) arm64 binary.
    // FN_OFF is the byte offset into the emitted __text; add the text vaddr to get
    // the runtime address. Mirrors the x86 fnmap dump (gated on the same flag).
    if CLI_DEBUG_FN_MAP != 0 {
        var amap_i: i64 = 0
        while amap_i < FN_COUNT {
            print("fnmap fn="); print_int(amap_i)
            print(" off="); print_int(FN_OFF[amap_i as usize])
            print(" name="); print_fn_name(amap_i)
            print("\n")
            amap_i = amap_i + 1
        }
    }
    print("arm64_compile: fns="); print_int(FN_COUNT); print(" code="); print_int(CL)
    print(" main=fn"); print_int(main_fn); print(" patches="); print_int(PATCH_COUNT); print("\n")
    0
}

// ─── ARM64 ELF writer ───
fn write_elf_arm64(output: string) -> i64 with IO, Mut, Panic, Div {
    let text_base = 0x400000
    let text_off = 4096
    let bss_base = 0x10000000         // 256MB: always above code
    let entry = text_base + text_off + TRAMP_OFF
    var i: i64 = 0
    while i < 4096 { ELF[i as usize] = 0; i = i + 1 }
    let tsz = text_off + CL
    // ELF header
    elf_w8(0, 0x7f); elf_w8(1, 69); elf_w8(2, 76); elf_w8(3, 70)
    elf_w8(4, 2); elf_w8(5, 1); elf_w8(6, 1)
    elf_w16(16, 2); elf_w16(18, 0xB7); elf_w32(20, 1)
    elf_w64(24, entry); elf_w64(32, 64)
    elf_w16(52, 64); elf_w16(54, 56); elf_w16(56, 2); elf_w16(58, 64)
    let ph0 = 64
    elf_w32(ph0, 1); elf_w32(ph0+4, 5)   // PT_LOAD, R+X
    elf_w64(ph0+8, 0); elf_w64(ph0+16, text_base); elf_w64(ph0+24, text_base)
    elf_w64(ph0+32, tsz); elf_w64(ph0+40, tsz); elf_w64(ph0+48, 4096)
    let ph1 = 120
    elf_w32(ph1, 1); elf_w32(ph1+4, 6)   // PT_LOAD, R+W
    elf_w64(ph1+8, 0); elf_w64(ph1+16, bss_base); elf_w64(ph1+24, bss_base)
    elf_w64(ph1+32, 0); elf_w64(ph1+40, GL_BSS_SIZE); elf_w64(ph1+48, 4096)
    i = 0
    while i < CL { ELF[(text_off + i) as usize] = CD[i as usize]; i = i + 1 }
    let ok = write_file(output, ELF, tsz)
    print("elf_arm64: "); print(output); print(" "); print_int(tsz); print(" bytes (bss="); print_int(GL_BSS_SIZE); print(")\n")
    return 0
}

// ─── ARM64 Mach-O writer ───
fn write_macho_arm64(output: string) -> i64 with IO, Mut, Panic, Div {
    let vm_base: i64 = 4294967296
    let page_size: i64 = 16384
    let text_vm = vm_base
    let data_vm = vm_base + 16777216
    let macos_build_ver: i64 = 720896   // 11.0.0
    let hdr_size = 32
    let lc_pagezero_size = 72
    let lc_text_size = 72 + 80
    let lc_data_size = 72 + 80
    let lc_linkedit_size = 72
    let lc_fixups_size = 16
    let lc_exports_trie_size = 16
    let lc_symtab_size = 24
    let lc_dysymtab_size = 80
    let lc_dylinker_size = 32
    let lc_uuid_size = 24
    let lc_build_version_size = 24
    let lc_main_size = 24
    let lc_dylib_size = 56
    let ncmds = 13
    let sizeofcmds = lc_pagezero_size + lc_text_size + lc_data_size + lc_linkedit_size + lc_fixups_size + lc_exports_trie_size + lc_symtab_size + lc_dysymtab_size + lc_dylinker_size + lc_uuid_size + lc_build_version_size + lc_main_size + lc_dylib_size
    let text_file_off = ((hdr_size + sizeofcmds + page_size - 1) / page_size) * page_size
    let text_file_size = ((CL + page_size - 1) / page_size) * page_size
    let text_seg_filesize = text_file_off + text_file_size
    let data_seg_vmsize = ((GL_BSS_SIZE + page_size - 1) / page_size) * page_size
    let linkedit_fixups_size = 52
    let linkedit_exports_size = 48
    let linkedit_fileoff = text_seg_filesize
    let linkedit_filesize = linkedit_fixups_size + linkedit_exports_size
    let total_file_size = text_seg_filesize + linkedit_filesize
    let text_seg_vmsize = text_seg_filesize
    let linkedit_vm = data_vm + data_seg_vmsize
    let linkedit_symtab_off = linkedit_fileoff + linkedit_filesize
    let linkedit_stroff = linkedit_symtab_off
    print("macho_arm64: code="); print_int(CL); print(" text_off="); print_int(text_file_off); print("\n")
    var i: i64 = 0
    while i < 1048576 { ELF[i as usize] = 0; i = i + 1 }
    // Header
    elf_w32(0, 0xFEEDFACF); elf_w32(4, 0x0100000C); elf_w32(8, 0)
    elf_w32(12, 2); elf_w32(16, ncmds); elf_w32(20, sizeofcmds); elf_w32(24, 0x00200085)
    // __PAGEZERO
    var off = hdr_size
    elf_w32(off, 25); elf_w32(off+4, lc_pagezero_size)
    elf_w8(off+8, 95); elf_w8(off+9, 95); elf_w8(off+10, 80); elf_w8(off+11, 65); elf_w8(off+12, 71); elf_w8(off+13, 69); elf_w8(off+14, 90); elf_w8(off+15, 69); elf_w8(off+16, 82); elf_w8(off+17, 79)
    elf_w64(off+24, 0); elf_w64(off+32, vm_base)
    // __TEXT
    off = hdr_size + lc_pagezero_size
    elf_w32(off, 25); elf_w32(off+4, lc_text_size)
    elf_w8(off+8, 95); elf_w8(off+9, 95); elf_w8(off+10, 84); elf_w8(off+11, 69); elf_w8(off+12, 88); elf_w8(off+13, 84)
    elf_w64(off+24, text_vm); elf_w64(off+32, text_seg_vmsize)
    elf_w64(off+40, 0); elf_w64(off+48, text_seg_filesize)
    elf_w32(off+56, 5); elf_w32(off+60, 5); elf_w32(off+64, 1)
    let sec = off + 72
    elf_w8(sec, 95); elf_w8(sec+1, 95); elf_w8(sec+2, 116); elf_w8(sec+3, 101); elf_w8(sec+4, 120); elf_w8(sec+5, 116)
    elf_w8(sec+16, 95); elf_w8(sec+17, 95); elf_w8(sec+18, 84); elf_w8(sec+19, 69); elf_w8(sec+20, 88); elf_w8(sec+21, 84)
    elf_w64(sec+32, text_vm + text_file_off); elf_w64(sec+40, CL)
    elf_w32(sec+48, text_file_off); elf_w32(sec+52, 4); elf_w32(sec+64, 0x80000400)
    // __DATA
    off = hdr_size + lc_pagezero_size + lc_text_size
    elf_w32(off, 25); elf_w32(off+4, lc_data_size)
    elf_w8(off+8, 95); elf_w8(off+9, 95); elf_w8(off+10, 68); elf_w8(off+11, 65); elf_w8(off+12, 84); elf_w8(off+13, 65)
    elf_w64(off+24, data_vm); elf_w64(off+32, data_seg_vmsize)
    elf_w64(off+40, text_seg_filesize); elf_w64(off+48, 0)
    elf_w32(off+56, 3); elf_w32(off+60, 3); elf_w32(off+64, 1)
    let bsec = off + 72
    elf_w8(bsec, 95); elf_w8(bsec+1, 95); elf_w8(bsec+2, 98); elf_w8(bsec+3, 115); elf_w8(bsec+4, 115)
    elf_w8(bsec+16, 95); elf_w8(bsec+17, 95); elf_w8(bsec+18, 68); elf_w8(bsec+19, 65); elf_w8(bsec+20, 84); elf_w8(bsec+21, 65)
    elf_w64(bsec+32, data_vm); elf_w64(bsec+40, GL_BSS_SIZE)
    elf_w32(bsec+48, 0); elf_w32(bsec+52, 4); elf_w32(bsec+64, 1)
    // __LINKEDIT
    off = hdr_size + lc_pagezero_size + lc_text_size + lc_data_size
    elf_w32(off, 25); elf_w32(off+4, lc_linkedit_size)
    elf_w8(off+8, 95); elf_w8(off+9, 95); elf_w8(off+10, 76); elf_w8(off+11, 73); elf_w8(off+12, 78); elf_w8(off+13, 75); elf_w8(off+14, 69); elf_w8(off+15, 68); elf_w8(off+16, 73); elf_w8(off+17, 84)
    elf_w64(off+24, linkedit_vm); elf_w64(off+32, page_size)
    elf_w64(off+40, linkedit_fileoff); elf_w64(off+48, linkedit_filesize)
    elf_w32(off+56, 1); elf_w32(off+60, 1)
    // LC_DYLD_CHAINED_FIXUPS
    off = hdr_size + lc_pagezero_size + lc_text_size + lc_data_size + lc_linkedit_size
    elf_w32(off, 0x80000034); elf_w32(off+4, lc_fixups_size)
    elf_w32(off+8, linkedit_fileoff); elf_w32(off+12, linkedit_fixups_size)
    // LC_DYLD_EXPORTS_TRIE
    off = hdr_size + lc_pagezero_size + lc_text_size + lc_data_size + lc_linkedit_size + lc_fixups_size
    elf_w32(off, 0x80000033); elf_w32(off+4, lc_exports_trie_size)
    elf_w32(off+8, linkedit_fileoff + linkedit_fixups_size); elf_w32(off+12, linkedit_exports_size)
    // LC_SYMTAB
    off = hdr_size + lc_pagezero_size + lc_text_size + lc_data_size + lc_linkedit_size + lc_fixups_size + lc_exports_trie_size
    elf_w32(off, 2); elf_w32(off+4, lc_symtab_size)
    elf_w32(off+8, linkedit_symtab_off); elf_w32(off+12, 0); elf_w32(off+16, linkedit_stroff); elf_w32(off+20, 0)
    // LC_DYSYMTAB
    off = hdr_size + lc_pagezero_size + lc_text_size + lc_data_size + lc_linkedit_size + lc_fixups_size + lc_exports_trie_size + lc_symtab_size
    elf_w32(off, 11); elf_w32(off+4, lc_dysymtab_size)
    // LC_LOAD_DYLINKER
    off = hdr_size + lc_pagezero_size + lc_text_size + lc_data_size + lc_linkedit_size + lc_fixups_size + lc_exports_trie_size + lc_symtab_size + lc_dysymtab_size
    elf_w32(off, 14); elf_w32(off+4, lc_dylinker_size); elf_w32(off+8, 12)
    elf_w8(off+12, 47); elf_w8(off+13, 117); elf_w8(off+14, 115); elf_w8(off+15, 114)
    elf_w8(off+16, 47); elf_w8(off+17, 108); elf_w8(off+18, 105); elf_w8(off+19, 98)
    elf_w8(off+20, 47); elf_w8(off+21, 100); elf_w8(off+22, 121); elf_w8(off+23, 108); elf_w8(off+24, 100); elf_w8(off+25, 0)
    // LC_UUID
    off = hdr_size + lc_pagezero_size + lc_text_size + lc_data_size + lc_linkedit_size + lc_fixups_size + lc_exports_trie_size + lc_symtab_size + lc_dysymtab_size + lc_dylinker_size
    elf_w32(off, 27); elf_w32(off+4, lc_uuid_size)
    elf_w8(off+8, 83); elf_w8(off+9, 79); elf_w8(off+10, 85); elf_w8(off+11, 78)
    elf_w8(off+12, 73); elf_w8(off+13, 79); elf_w8(off+14, 65); elf_w8(off+15, 2)
    elf_w8(off+16, CL & 255); elf_w8(off+17, (CL >> 8) & 255); elf_w8(off+18, (CL >> 16) & 255); elf_w8(off+19, (CL >> 24) & 255)
    elf_w8(off+20, GL_BSS_SIZE & 255); elf_w8(off+21, (GL_BSS_SIZE >> 8) & 255); elf_w8(off+22, (GL_BSS_SIZE >> 16) & 255); elf_w8(off+23, (GL_BSS_SIZE >> 24) & 255)
    // LC_BUILD_VERSION
    off = hdr_size + lc_pagezero_size + lc_text_size + lc_data_size + lc_linkedit_size + lc_fixups_size + lc_exports_trie_size + lc_symtab_size + lc_dysymtab_size + lc_dylinker_size + lc_uuid_size
    elf_w32(off, 50); elf_w32(off+4, lc_build_version_size)
    elf_w32(off+8, 1); elf_w32(off+12, macos_build_ver); elf_w32(off+16, macos_build_ver); elf_w32(off+20, 0)
    // LC_MAIN
    off = hdr_size + lc_pagezero_size + lc_text_size + lc_data_size + lc_linkedit_size + lc_fixups_size + lc_exports_trie_size + lc_symtab_size + lc_dysymtab_size + lc_dylinker_size + lc_uuid_size + lc_build_version_size
    elf_w32(off, 0x80000028); elf_w32(off+4, lc_main_size)
    elf_w64(off+8, text_file_off + TRAMP_OFF); elf_w64(off+16, 0)
    // LC_LOAD_DYLIB
    off = hdr_size + lc_pagezero_size + lc_text_size + lc_data_size + lc_linkedit_size + lc_fixups_size + lc_exports_trie_size + lc_symtab_size + lc_dysymtab_size + lc_dylinker_size + lc_uuid_size + lc_build_version_size + lc_main_size
    elf_w32(off, 12); elf_w32(off+4, lc_dylib_size)
    elf_w32(off+8, 24); elf_w32(off+12, 2); elf_w32(off+16, 88866816); elf_w32(off+20, 65536)
    elf_w8(off+24, 47); elf_w8(off+25, 117); elf_w8(off+26, 115); elf_w8(off+27, 114)
    elf_w8(off+28, 47); elf_w8(off+29, 108); elf_w8(off+30, 105); elf_w8(off+31, 98)
    elf_w8(off+32, 47); elf_w8(off+33, 108); elf_w8(off+34, 105); elf_w8(off+35, 98)
    elf_w8(off+36, 83); elf_w8(off+37, 121); elf_w8(off+38, 115); elf_w8(off+39, 116)
    elf_w8(off+40, 101); elf_w8(off+41, 109); elf_w8(off+42, 46); elf_w8(off+43, 66)
    elf_w8(off+44, 46); elf_w8(off+45, 100); elf_w8(off+46, 121); elf_w8(off+47, 108)
    elf_w8(off+48, 105); elf_w8(off+49, 98); elf_w8(off+50, 0)
    // __LINKEDIT payload: empty chained fixups for 4 segments
    elf_w32(linkedit_fileoff, 0)
    elf_w32(linkedit_fileoff + 4, 32)
    elf_w32(linkedit_fileoff + 8, 52)
    elf_w32(linkedit_fileoff + 12, 52)
    elf_w32(linkedit_fileoff + 16, 0)
    elf_w32(linkedit_fileoff + 20, 1)
    elf_w32(linkedit_fileoff + 24, 0)
    elf_w32(linkedit_fileoff + 28, 0)
    elf_w32(linkedit_fileoff + 32, 4)
    elf_w32(linkedit_fileoff + 36, 0)
    elf_w32(linkedit_fileoff + 40, 0)
    elf_w32(linkedit_fileoff + 44, 0)
    elf_w32(linkedit_fileoff + 48, 0)
    // __LINKEDIT payload: minimal export trie
    let exports_off = linkedit_fileoff + linkedit_fixups_size
    elf_w8(exports_off + 0, 0)
    elf_w8(exports_off + 1, 1)
    elf_w8(exports_off + 2, 95)
    elf_w8(exports_off + 3, 0)
    elf_w8(exports_off + 4, 18)
    elf_w8(exports_off + 5, 0)
    elf_w8(exports_off + 6, 0)
    elf_w8(exports_off + 7, 0)
    elf_w8(exports_off + 8, 0)
    elf_w8(exports_off + 9, 2)
    elf_w8(exports_off + 10, 0)
    elf_w8(exports_off + 11, 0)
    elf_w8(exports_off + 12, 0)
    elf_w8(exports_off + 13, 3)
    elf_w8(exports_off + 14, 0)
    elf_w8(exports_off + 15, 168)
    elf_w8(exports_off + 16, 6)
    elf_w8(exports_off + 17, 0)
    elf_w8(exports_off + 18, 0)
    elf_w8(exports_off + 19, 2)
    elf_w8(exports_off + 20, 95)
    elf_w8(exports_off + 21, 109)
    elf_w8(exports_off + 22, 104)
    elf_w8(exports_off + 23, 95)
    elf_w8(exports_off + 24, 101)
    elf_w8(exports_off + 25, 120)
    elf_w8(exports_off + 26, 101)
    elf_w8(exports_off + 27, 99)
    elf_w8(exports_off + 28, 117)
    elf_w8(exports_off + 29, 116)
    elf_w8(exports_off + 30, 101)
    elf_w8(exports_off + 31, 95)
    elf_w8(exports_off + 32, 104)
    elf_w8(exports_off + 33, 101)
    elf_w8(exports_off + 34, 97)
    elf_w8(exports_off + 35, 100)
    elf_w8(exports_off + 36, 101)
    elf_w8(exports_off + 37, 114)
    elf_w8(exports_off + 38, 0)
    elf_w8(exports_off + 39, 9)
    elf_w8(exports_off + 40, 109)
    elf_w8(exports_off + 41, 97)
    elf_w8(exports_off + 42, 105)
    elf_w8(exports_off + 43, 110)
    elf_w8(exports_off + 44, 0)
    elf_w8(exports_off + 45, 13)
    elf_w8(exports_off + 46, 0)
    elf_w8(exports_off + 47, 0)
    // Copy code
    i = 0
    while i < CL { ELF[(text_file_off + i) as usize] = CD[i as usize]; i = i + 1 }
    let ok = write_file(output, ELF, total_file_size)
    print("macho_arm64: "); print(output); print(" "); print_int(total_file_size); print(" bytes\n")
    return 0
}

// ─── Import resolver ───
// Hash IMP_PATH[0..len] for dedup
fn imp_path_hash(len: i64) -> i64 with Panic, Mut {
    var h: i64 = len * 1000003
    var i: i64 = 0
    while i < len {
        let c = IMP_PATH[i as usize] as i64 & 0xFF
        h = h + c * (i + 1) * 31
        i = i + 1
    }
    return h
}

fn imp_path_loaded(len: i64) -> i64 with Panic, Mut {
    let ph = imp_path_hash(len)
    var di: i64 = 0
    while di < IMP_COUNT {
        if IMP_LOADED[di as usize] == ph && IMP_LOADED_LENS[di as usize] == len {
            let off = IMP_LOADED_OFFS[di as usize]
            var match_ok: i64 = 1
            var mi: i64 = 0
            while mi < len {
                if IMP_LOADED_PATHS[(off + mi) as usize] != IMP_PATH[mi as usize] { match_ok = 0 }
                mi = mi + 1
            }
            if match_ok == 1 { return 1 }
        }
        di = di + 1
    }
    0
}

fn print_imp_path() with IO, Mut, Panic {
    var i: i64 = 0
    while i < 4096 && IMP_PATH[i as usize] != 0 {
        print_char(IMP_PATH[i as usize] as i64)
        i = i + 1
    }
}

fn imp_append_lit_to_path(pos: i64, lit: string) -> i64 with Mut, Panic, Div {
    var p = pos
    let n = str_len(lit)
    var i: i64 = 0
    while i < n && p < 4095 {
        IMP_PATH[p as usize] = str_char_at(lit, i) as i8
        p = p + 1
        i = i + 1
    }
    p
}

fn imp_raw_stem_len(raw_len: i64) -> i64 with Panic {
    if raw_len > 4 &&
       IMP_RAW_PATH[(raw_len - 4) as usize] == 46 &&
       IMP_RAW_PATH[(raw_len - 3) as usize] == 115 &&
       IMP_RAW_PATH[(raw_len - 2) as usize] == 105 &&
       IMP_RAW_PATH[(raw_len - 1) as usize] == 111 {
        return raw_len - 4
    }
    raw_len
}

fn imp_build_package_path_from_raw(raw_len: i64) -> i64 with Mut, Panic, Div {
    let stem_len = imp_raw_stem_len(raw_len)
    if stem_len <= 0 {
        IMP_PATH[0 as usize] = 0
        return 0
    }

    var root_end: i64 = 0
    while root_end < stem_len && IMP_RAW_PATH[root_end as usize] != 47 {
        root_end = root_end + 1
    }

    var p: i64 = 0
    p = imp_append_lit_to_path(p, "packages/")

    var i: i64 = 0
    while i < root_end && p < 4095 {
        var c = IMP_RAW_PATH[i as usize]
        if c == 95 { c = 45 } // import_name -> package-name
        IMP_PATH[p as usize] = c
        p = p + 1
        i = i + 1
    }

    p = imp_append_lit_to_path(p, "/src")
    if root_end < stem_len {
        IMP_PATH[p as usize] = 47
        p = p + 1
        i = root_end + 1
        while i < stem_len && p < 4095 {
            IMP_PATH[p as usize] = IMP_RAW_PATH[i as usize]
            p = p + 1
            i = i + 1
        }
        p = imp_append_lit_to_path(p, ".sio")
    } else {
        p = imp_append_lit_to_path(p, "/lib.sio")
    }

    IMP_PATH[p as usize] = 0
    p
}

fn set_base_dir_from_src_path(ps: i64, pe: i64) with Mut, Panic {
    var last_slash: i64 = -1
    var i: i64 = ps
    while i < pe {
        if sb(i) == 47 { last_slash = i }
        i = i + 1
    }
    BASE_DIR_LEN = 0
    if last_slash < 0 {
        BASE_DIR[0 as usize] = 46
        BASE_DIR_LEN = 1
    } else {
        i = ps
        while i < last_slash && BASE_DIR_LEN < 511 {
            BASE_DIR[BASE_DIR_LEN as usize] = sb(i) as i8
            BASE_DIR_LEN = BASE_DIR_LEN + 1
            i = i + 1
        }
    }
    BASE_DIR[BASE_DIR_LEN as usize] = 0
}

fn append_src_lit(s: string) with Mut, Panic, Div {
    let n = str_len(s)
    var i: i64 = 0
    while i < n && SRC_LEN < 2097151 {
        SRC[SRC_LEN as usize] = str_char_at(s, i) as i8
        SRC_LEN = SRC_LEN + 1
        i = i + 1
    }
}

fn append_native_prelude() with Mut, Panic, Div {
    append_src_lit("\n")
    append_src_lit("fn __native_abs_i64(x: i64) -> i64 {\n")
    append_src_lit("    if x < 0 { return 0 - x }\n")
    append_src_lit("    x\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_abs_f64(x: f64) -> f64 {\n")
    append_src_lit("    if x < 0.0 { return 0.0 - x }\n")
    append_src_lit("    x\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_floor_f64(x: f64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    let i = x as i64\n")
    append_src_lit("    let f = i as f64\n")
    append_src_lit("    if x < 0.0 && f != x { return f - 1.0 }\n")
    append_src_lit("    f\n")
    append_src_lit("}\n\n")

    // Range-reduced Newton: scale x into [1, 4) so Newton starts well-conditioned.
    // For x < 1, multiply by 4^k until v ∈ [1, 4); sqrt(x) = sqrt(v) / 2^k.
    // Without this, Newton from y₀ = x with x ~ 10⁻¹⁵ halves each step and
    // needs ≫ 20 iterations to reach the true sqrt — returning ~10⁻⁶ instead
    // of ~10⁻⁸. Range reduction is bit-deterministic.
    append_src_lit("fn __native_sqrt_f64(x: f64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    if x <= 0.0 { return 0.0 }\n")
    append_src_lit("    var v: f64 = x\n")
    append_src_lit("    var s: f64 = 1.0\n")
    append_src_lit("    while v < 1.0 {\n")
    append_src_lit("        v = v * 4.0\n")
    append_src_lit("        s = s * 2.0\n")
    append_src_lit("    }\n")
    append_src_lit("    var y: f64 = v\n")
    append_src_lit("    var i: i64 = 0\n")
    append_src_lit("    while i < 20 {\n")
    append_src_lit("        y = 0.5 * (y + v / y)\n")
    append_src_lit("        i = i + 1\n")
    append_src_lit("    }\n")
    append_src_lit("    y / s\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_ln_f64(x: f64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    if x <= 0.0 { return 0.0 - 1.0e30 }\n")
    append_src_lit("    if x == 1.0 { return 0.0 }\n")
    append_src_lit("    var m = x\n")
    append_src_lit("    var e_val: i64 = 0\n")
    append_src_lit("    while m >= 2.0 { m = m / 2.0; e_val = e_val + 1 }\n")
    append_src_lit("    while m < 0.5 { m = m * 2.0; e_val = e_val - 1 }\n")
    append_src_lit("    let t = (m - 1.0) / (m + 1.0)\n")
    append_src_lit("    let t2 = t * t\n")
    append_src_lit("    var sum = t\n")
    append_src_lit("    var term = t\n")
    append_src_lit("    var k: i64 = 1\n")
    append_src_lit("    while k < 15 {\n")
    append_src_lit("        term = term * t2\n")
    append_src_lit("        sum = sum + term / ((2 * k + 1) as f64)\n")
    append_src_lit("        k = k + 1\n")
    append_src_lit("    }\n")
    append_src_lit("    2.0 * sum + (e_val as f64) * 0.6931471805599453\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_exp_f64(x: f64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    if x > 500.0 { return 1.0e200 }\n")
    append_src_lit("    if x < 0.0 - 500.0 { return 0.0 }\n")
    append_src_lit("    let ln2 = 0.6931471805599453\n")
    append_src_lit("    let kf = __native_floor_f64(x / ln2)\n")
    append_src_lit("    let r = x - kf * ln2\n")
    append_src_lit("    var sum = 1.0\n")
    append_src_lit("    var term = 1.0\n")
    append_src_lit("    var n: i64 = 1\n")
    append_src_lit("    while n <= 12 {\n")
    append_src_lit("        term = term * r / (n as f64)\n")
    append_src_lit("        sum = sum + term\n")
    append_src_lit("        n = n + 1\n")
    append_src_lit("    }\n")
    append_src_lit("    let k = kf as i64\n")
    append_src_lit("    var out = sum\n")
    append_src_lit("    if k >= 0 {\n")
    append_src_lit("        n = 0\n")
    append_src_lit("        while n < k { out = out * 2.0; n = n + 1 }\n")
    append_src_lit("    } else {\n")
    append_src_lit("        n = 0\n")
    append_src_lit("        while n < 0 - k { out = out / 2.0; n = n + 1 }\n")
    append_src_lit("    }\n")
    append_src_lit("    out\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_cos_kernel(u: f64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    let u2 = u * u\n")
    append_src_lit("    let u4 = u2 * u2\n")
    append_src_lit("    let u6 = u4 * u2\n")
    append_src_lit("    let u8 = u6 * u2\n")
    append_src_lit("    let u10 = u8 * u2\n")
    append_src_lit("    let u12 = u10 * u2\n")
    append_src_lit("    1.0 - u2/2.0 + u4/24.0 - u6/720.0 + u8/40320.0 - u10/3628800.0 + u12/479001600.0\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_sin_kernel(u: f64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    let u2 = u * u\n")
    append_src_lit("    let u3 = u * u2\n")
    append_src_lit("    let u5 = u3 * u2\n")
    append_src_lit("    let u7 = u5 * u2\n")
    append_src_lit("    let u9 = u7 * u2\n")
    append_src_lit("    let u11 = u9 * u2\n")
    append_src_lit("    let u13 = u11 * u2\n")
    append_src_lit("    u - u3/6.0 + u5/120.0 - u7/5040.0 + u9/362880.0 - u11/39916800.0 + u13/6227020800.0\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_sin_f64(x: f64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    let pi = 3.14159265358979323846\n")
    append_src_lit("    let two_pi = 6.28318530717958647692\n")
    append_src_lit("    let half_pi = 1.57079632679489661923\n")
    append_src_lit("    let qtr_pi = 0.78539816339744830962\n")
    append_src_lit("    var t = x\n")
    append_src_lit("    var sign: f64 = 1.0\n")
    append_src_lit("    while t > pi { t = t - two_pi }\n")
    append_src_lit("    while t < 0.0 - pi { t = t + two_pi }\n")
    append_src_lit("    if t < 0.0 { t = 0.0 - t; sign = 0.0 - 1.0 }\n")
    append_src_lit("    if t > half_pi { t = pi - t }\n")
    append_src_lit("    if t > qtr_pi {\n")
    append_src_lit("        return sign * __native_cos_kernel(half_pi - t)\n")
    append_src_lit("    }\n")
    append_src_lit("    sign * __native_sin_kernel(t)\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_cos_f64(x: f64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    let pi = 3.14159265358979323846\n")
    append_src_lit("    let two_pi = 6.28318530717958647692\n")
    append_src_lit("    let half_pi = 1.57079632679489661923\n")
    append_src_lit("    let qtr_pi = 0.78539816339744830962\n")
    append_src_lit("    var t = x\n")
    append_src_lit("    var negate: f64 = 1.0\n")
    append_src_lit("    while t > pi { t = t - two_pi }\n")
    append_src_lit("    while t < 0.0 - pi { t = t + two_pi }\n")
    append_src_lit("    if t < 0.0 { t = 0.0 - t }\n")
    append_src_lit("    if t > half_pi { t = pi - t; negate = 0.0 - 1.0 }\n")
    append_src_lit("    if t > qtr_pi {\n")
    append_src_lit("        return negate * __native_sin_kernel(half_pi - t)\n")
    append_src_lit("    }\n")
    append_src_lit("    negate * __native_cos_kernel(t)\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_atan_f64(x: f64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    let pi4 = 0.78539816339744830962\n")
    append_src_lit("    let pi2 = 1.57079632679489661923\n")
    append_src_lit("    var t = x\n")
    append_src_lit("    var sign: f64 = 1.0\n")
    append_src_lit("    if t < 0.0 { t = 0.0 - t; sign = 0.0 - 1.0 }\n")
    append_src_lit("    var base: f64 = 0.0\n")
    // `base > 0` was used as the proxy for \"the reciprocal branch fired\", and it
    // is not one: the second reduction also raises base, to pi4. So atan(0.5) --
    // one reduction, no reciprocal -- took the minus branch and returned
    // 1.10715, which is atan(2). The endpoints hid it: atan(1) and atan(2) are
    // right either way, and asin/acos are built on atan, so asin(0.5) returned
    // acos(0.5) and vice versa. Track the branch explicitly.
    append_src_lit("    var recip: bool = false\n")
    append_src_lit("    if t > 1.0 { t = 1.0 / t; base = pi2; recip = true }\n")
    append_src_lit("    if t > 0.4142135623730951 {\n")
    append_src_lit("        t = (t - 1.0) / (t + 1.0)\n")
    append_src_lit("        if recip { base = base - pi4 } else { base = pi4 }\n")
    append_src_lit("    }\n")
    append_src_lit("    let t2 = t * t\n")
    append_src_lit("    let t3 = t * t2\n")
    append_src_lit("    let t5 = t3 * t2\n")
    append_src_lit("    let t7 = t5 * t2\n")
    append_src_lit("    let t9 = t7 * t2\n")
    append_src_lit("    let t11 = t9 * t2\n")
    append_src_lit("    let t13 = t11 * t2\n")
    append_src_lit("    let a = t - t3 / 3.0 + t5 / 5.0 - t7 / 7.0 + t9 / 9.0 - t11 / 11.0 + t13 / 13.0\n")
    // atan(x) = pi/2 - atan(1/x) subtracts; atan(t) = pi/4 + atan((t-1)/(t+1))
    // adds. Which one applies is decided by `recip`, never by base's sign.
    append_src_lit("    if recip { return sign * (base - a) }\n")
    append_src_lit("    sign * (base + a)\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_atan2_f64(y: f64, x: f64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    let pi = 3.14159265358979323846\n")
    append_src_lit("    let half_pi = 1.57079632679489661923\n")
    append_src_lit("    if x > 0.0 { return __native_atan_f64(y / x) }\n")
    append_src_lit("    if x < 0.0 {\n")
    append_src_lit("        if y >= 0.0 { return __native_atan_f64(y / x) + pi }\n")
    append_src_lit("        return __native_atan_f64(y / x) - pi\n")
    append_src_lit("    }\n")
    append_src_lit("    if y > 0.0 { return half_pi }\n")
    append_src_lit("    if y < 0.0 { return 0.0 - half_pi }\n")
    append_src_lit("    0.0\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_tanh_f64(x: f64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    if x > 20.0 { return 1.0 }\n")
    append_src_lit("    if x < 0.0 - 20.0 { return 0.0 - 1.0 }\n")
    append_src_lit("    let e2x = __native_exp_f64(2.0 * x)\n")
    append_src_lit("    (e2x - 1.0) / (e2x + 1.0)\n")
    append_src_lit("}\n\n")
    append_src_lit("fn __native_tan_f64(x: f64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    __native_sin_f64(x) / __native_cos_f64(x)\n")
    append_src_lit("}\n\n")
    append_src_lit("fn __native_asin_f64(x: f64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    let x2 = x * x\n")
    append_src_lit("    __native_atan_f64(x / __native_sqrt_f64(1.0 - x2))\n")
    append_src_lit("}\n\n")
    append_src_lit("fn __native_acos_f64(x: f64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    let half_pi = 1.57079632679489661923\n")
    append_src_lit("    half_pi - __native_asin_f64(x)\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_print_u64_no_nl(v: i64) with IO, Mut, Panic, Div {\n")
    append_src_lit("    if v == 0 { print_char(48); return }\n")
    append_src_lit("    var div: i64 = 1\n")
    append_src_lit("    while div <= v / 10 { div = div * 10 }\n")
    append_src_lit("    var n = v\n")
    append_src_lit("    while div > 0 {\n")
    append_src_lit("        let digit = n / div\n")
    append_src_lit("        print_char(48 + digit)\n")
    append_src_lit("        n = n % div\n")
    append_src_lit("        div = div / 10\n")
    append_src_lit("    }\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_print_fixed_digits(v: i64, width: i64) with IO, Mut, Panic, Div {\n")
    append_src_lit("    if width <= 0 { return }\n")
    append_src_lit("    var div: i64 = 1\n")
    append_src_lit("    var i: i64 = 1\n")
    append_src_lit("    while i < width {\n")
    append_src_lit("        div = div * 10\n")
    append_src_lit("        i = i + 1\n")
    append_src_lit("    }\n")
    append_src_lit("    var n = v\n")
    append_src_lit("    while div > 0 {\n")
    append_src_lit("        let digit = n / div\n")
    append_src_lit("        print_char(48 + digit)\n")
    append_src_lit("        n = n % div\n")
    append_src_lit("        div = div / 10\n")
    append_src_lit("    }\n")
    append_src_lit("}\n\n")

    // Range-aware f64 printer: switches to scientific notation when the
    // value is too large for the i64 mantissa cast (≥ 1e15) or too small
    // for the requested fixed-decimal precision (rounds to all zeros).
    // Without these guards, very large values saturate via cvttsd2si to
    // the i64-MIN bit pattern (printing "9223372036854775808" for any
    // 1e24-scale input) and very small values silently print as
    // "0.000000".
    append_src_lit("fn __native_print_f64_n(x: f64, decimals: i64) with IO, Mut, Panic, Div {\n")
    append_src_lit("    if x != x { print(\"nan\"); return }\n")
    append_src_lit("    var d = decimals\n")
    append_src_lit("    if d < 0 { d = 0 }\n")
    append_src_lit("    if d > 12 { d = 12 }\n")
    append_src_lit("    var y = x\n")
    append_src_lit("    if y < 0.0 {\n")
    append_src_lit("        print_char(45)\n")
    append_src_lit("        y = 0.0 - y\n")
    append_src_lit("    }\n")
    append_src_lit("    var scale_i: i64 = 0\n")
    append_src_lit("    var scale_int: i64 = 1\n")
    append_src_lit("    while scale_i < d {\n")
    append_src_lit("        scale_int = scale_int * 10\n")
    append_src_lit("        scale_i = scale_i + 1\n")
    append_src_lit("    }\n")
    append_src_lit("    let scale = scale_int as f64\n")
    // OVERFLOW guard: |y| ≥ 1e15 → scientific. The threshold is below the
    // i64 saturation point (~9.2e18) and above the f64-exact integer bound
    // (2^53 ≈ 9e15) where the fixed-decimal path starts losing precision.
    append_src_lit("    if y >= 1000000000000000.0 {\n")
    append_src_lit("        var exp_e: i64 = 0\n")
    append_src_lit("        while y >= 10.0 {\n")
    append_src_lit("            y = y / 10.0\n")
    append_src_lit("            exp_e = exp_e + 1\n")
    append_src_lit("        }\n")
    append_src_lit("        let whole_e = y as i64\n")
    append_src_lit("        __native_print_u64_no_nl(whole_e)\n")
    append_src_lit("        if d > 0 {\n")
    append_src_lit("            print_char(46)\n")
    append_src_lit("            var fe = ((y - (whole_e as f64)) * scale + 0.5) as i64\n")
    append_src_lit("            if fe >= scale_int { fe = scale_int - 1 }\n")
    append_src_lit("            __native_print_fixed_digits(fe, d)\n")
    append_src_lit("        }\n")
    append_src_lit("        print_char(101)\n")
    append_src_lit("        __native_print_u64_no_nl(exp_e)\n")
    append_src_lit("        return\n")
    append_src_lit("    }\n")
    // UNDERFLOW guard: 0 < y < 0.5 / scale_int → fixed path rounds to all
    // zeros. Switch to scientific so callers can see the magnitude.
    append_src_lit("    let tiny_thresh = 0.5 / scale\n")
    append_src_lit("    if y > 0.0 && y < tiny_thresh {\n")
    append_src_lit("        var exp_e: i64 = 0\n")
    append_src_lit("        while y < 1.0 {\n")
    append_src_lit("            y = y * 10.0\n")
    append_src_lit("            exp_e = exp_e + 1\n")
    append_src_lit("        }\n")
    append_src_lit("        let whole_e = y as i64\n")
    append_src_lit("        __native_print_u64_no_nl(whole_e)\n")
    append_src_lit("        if d > 0 {\n")
    append_src_lit("            print_char(46)\n")
    append_src_lit("            var fe = ((y - (whole_e as f64)) * scale + 0.5) as i64\n")
    append_src_lit("            if fe >= scale_int { fe = scale_int - 1 }\n")
    append_src_lit("            __native_print_fixed_digits(fe, d)\n")
    append_src_lit("        }\n")
    append_src_lit("        print_char(101)\n")
    append_src_lit("        print_char(45)\n")
    append_src_lit("        __native_print_u64_no_nl(exp_e)\n")
    append_src_lit("        return\n")
    append_src_lit("    }\n")
    // FIXED-DECIMAL path for in-range values.
    append_src_lit("    let whole_f = __native_floor_f64(y)\n")
    append_src_lit("    var whole = whole_f as i64\n")
    append_src_lit("    var frac = ((y - whole_f) * scale + 0.5) as i64\n")
    append_src_lit("    if frac >= scale_int {\n")
    append_src_lit("        whole = whole + 1\n")
    append_src_lit("        frac = 0\n")
    append_src_lit("    }\n")
    append_src_lit("    __native_print_u64_no_nl(whole)\n")
    append_src_lit("    if d > 0 {\n")
    append_src_lit("        print_char(46)\n")
    append_src_lit("        __native_print_fixed_digits(frac, d)\n")
    append_src_lit("    }\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_parse_i64(buf: string, offset: i64, len: i64) -> i64 with Mut, Div, Panic {\n")
    append_src_lit("    if len <= 0 { return 0 }\n")
    append_src_lit("    var i: i64 = 0\n")
    append_src_lit("    var sign: i64 = 1\n")
    append_src_lit("    var value: i64 = 0\n")
    append_src_lit("    if str_char_at(buf, offset) == 45 { sign = 0 - 1; i = 1 }\n")
    append_src_lit("    while i < len {\n")
    append_src_lit("        let c = str_char_at(buf, offset + i)\n")
    append_src_lit("        if c < 48 || c > 57 { break }\n")
    append_src_lit("        value = value * 10 + (c - 48)\n")
    append_src_lit("        i = i + 1\n")
    append_src_lit("    }\n")
    append_src_lit("    if sign < 0 { return 0 - value }\n")
    append_src_lit("    value\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_parse_f64(buf: string, offset: i64, len: i64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    if len <= 0 { return 0.0 }\n")
    append_src_lit("    var i: i64 = 0\n")
    append_src_lit("    var sign = 1.0\n")
    append_src_lit("    if str_char_at(buf, offset) == 45 { sign = 0.0 - 1.0; i = 1 }\n")
    append_src_lit("    var int_part = 0.0\n")
    append_src_lit("    while i < len {\n")
    append_src_lit("        let c = str_char_at(buf, offset + i)\n")
    append_src_lit("        if c < 48 || c > 57 { break }\n")
    append_src_lit("        int_part = int_part * 10.0 + ((c - 48) as f64)\n")
    append_src_lit("        i = i + 1\n")
    append_src_lit("    }\n")
    append_src_lit("    var frac = 0.0\n")
    append_src_lit("    var denom = 10.0\n")
    append_src_lit("    if i < len && str_char_at(buf, offset + i) == 46 {\n")
    append_src_lit("        i = i + 1\n")
    append_src_lit("        while i < len {\n")
    append_src_lit("            let c = str_char_at(buf, offset + i)\n")
    append_src_lit("            if c < 48 || c > 57 { break }\n")
    append_src_lit("            frac = frac + ((c - 48) as f64) / denom\n")
    append_src_lit("            denom = denom * 10.0\n")
    append_src_lit("            i = i + 1\n")
    append_src_lit("        }\n")
    append_src_lit("    }\n")
    append_src_lit("    var value = int_part + frac\n")
    append_src_lit("    if i < len {\n")
    append_src_lit("        let ec = str_char_at(buf, offset + i)\n")
    append_src_lit("        if ec == 101 || ec == 69 {\n")
    append_src_lit("            i = i + 1\n")
    append_src_lit("            var exp_sign: i64 = 1\n")
    append_src_lit("            if i < len {\n")
    append_src_lit("                let sc = str_char_at(buf, offset + i)\n")
    append_src_lit("                if sc == 45 { exp_sign = 0 - 1; i = i + 1 }\n")
    append_src_lit("                else if sc == 43 { i = i + 1 }\n")
    append_src_lit("            }\n")
    append_src_lit("            var exp_value: i64 = 0\n")
    append_src_lit("            while i < len {\n")
    append_src_lit("                let c = str_char_at(buf, offset + i)\n")
    append_src_lit("                if c < 48 || c > 57 { break }\n")
    append_src_lit("                exp_value = exp_value * 10 + (c - 48)\n")
    append_src_lit("                i = i + 1\n")
    append_src_lit("            }\n")
    append_src_lit("            if exp_sign < 0 { exp_value = 0 - exp_value }\n")
    append_src_lit("            var scale_i: i64 = 0\n")
    append_src_lit("            if exp_value >= 0 {\n")
    append_src_lit("                while scale_i < exp_value {\n")
    append_src_lit("                    value = value * 10.0\n")
    append_src_lit("                    scale_i = scale_i + 1\n")
    append_src_lit("                }\n")
    append_src_lit("            } else {\n")
    append_src_lit("                while scale_i < 0 - exp_value {\n")
    append_src_lit("                    value = value / 10.0\n")
    append_src_lit("                    scale_i = scale_i + 1\n")
    append_src_lit("                }\n")
    append_src_lit("            }\n")
    append_src_lit("        }\n")
    append_src_lit("    }\n")
    append_src_lit("    value * sign\n")
    append_src_lit("}\n")
}

// Resolve and load use statements from SRC[0..SRC_LEN]
fn resolve_imports() with IO, Mut, Panic, Div {
    var pos: i64 = 0
    while pos < SRC_LEN {
        if sb(pos) == 1 {
            var marker_s: i64 = pos + 1
            var marker_e: i64 = marker_s
            while marker_e < SRC_LEN && sb(marker_e) != 2 { marker_e = marker_e + 1 }
            if marker_e < SRC_LEN {
                set_base_dir_from_src_path(marker_s, marker_e)
                pos = marker_e + 1
                continue
            }
        }
        // Check for "use " at line start (117=u, 115=s, 101=e, 32=space)
        if pos + 4 < SRC_LEN && sb(pos) == 117 && sb(pos+1) == 115 && sb(pos+2) == 101 && sb(pos+3) == 32 {
            pos = pos + 4  // skip "use "
            // Extract module path until newline, semicolon, or ::*
            var path_start: i64 = pos
            var path_end: i64 = pos
            // Bug C: a glob (`::*`) or braced (`::{...}`) import unambiguously
            // marks where the file path ends. A bare named import
            // (`use pkg::mod::symbol`) has no such marker — `symbol` is
            // syntactically indistinguishable from another path segment here.
            // Track that ambiguity so the fallback below (after the naive
            // whole-path read fails) can retry with the last segment treated
            // as an imported symbol name rather than part of the file path.
            var is_named_import: i64 = 1
            while pos < SRC_LEN && sb(pos) != 10 && sb(pos) != 59 && sb(pos) != 13 {
                if sb(pos) == 58 && pos + 1 < SRC_LEN && sb(pos+1) == 58 {
                    if pos + 2 < SRC_LEN && sb(pos+2) == 42 {
                        path_end = pos
                        pos = pos + 3  // skip ::*
                        is_named_import = 0
                        break
                    }
                    if pos + 2 < SRC_LEN && sb(pos+2) == 123 {
                        path_end = pos
                        // Skip ::{...} until }
                        while pos < SRC_LEN && sb(pos) != 125 && sb(pos) != 10 { pos = pos + 1 }
                        if pos < SRC_LEN && sb(pos) == 125 { pos = pos + 1 }
                        is_named_import = 0
                        break
                    }
                }
                // `use pkg::mod as alias` — " as " unambiguously ends the module
                // path (no path segment is ever spelled with embedded spaces in
                // this codebase; census: zero `use X :: Y` / `use X:: Y` spaced
                // occurrences). The path-building loop below used to silently
                // DROP every space instead of treating it as a terminator, so
                // this built the garbled path `pkg/modasalias.sio` (issue #632).
                // The alias name itself needs no separate table: the module's
                // symbols are still resolved by bare name once the file loads
                // correctly, and a single-`::` call through the alias falls
                // through to that bare lookup (see the call-site companion fix).
                if sb(pos) == 32 && pos + 3 < SRC_LEN && sb(pos+1) == 97 && sb(pos+2) == 115 && sb(pos+3) == 32 {
                    path_end = pos
                    // Unambiguous: `as alias` always names the whole preceding
                    // path as a module/file, never "the last segment is really
                    // an exported symbol" (that ambiguity, is_named_import's
                    // reason for existing, only applies to a bare trailing
                    // segment with no `as` at all). Disable the Bug C
                    // segment-stripping fallback so a genuine load failure here
                    // reports its real path instead of a further-stripped one.
                    is_named_import = 0
                    break
                }
                pos = pos + 1
                path_end = pos
            }
            // Build filesystem path: convert :: to /
            var fp_len: i64 = 0
            // Check prefix: stdlib:: or self-hosted::
            var pi: i64 = path_start
            while pi < path_end {
                let c = sb(pi)
                if c == 58 && pi + 1 < path_end && sb(pi+1) == 58 {
                    IMP_PATH[fp_len as usize] = 47  // /
                    fp_len = fp_len + 1
                    pi = pi + 2
                } else if c == 42 || c == 123 || c == 125 || c == 32 {
                    pi = pi + 1  // skip wildcards, braces, spaces
                } else {
                    IMP_PATH[fp_len as usize] = c as i8
                    fp_len = fp_len + 1
                    pi = pi + 1
                }
            }
            // Append .sio if not already present
            if fp_len > 4 && IMP_PATH[(fp_len-4) as usize] == 46 && IMP_PATH[(fp_len-3) as usize] == 115 {
                // already has .sio — skip
            } else {
                IMP_PATH[fp_len as usize] = 46; fp_len = fp_len + 1   // .
                IMP_PATH[fp_len as usize] = 115; fp_len = fp_len + 1  // s
                IMP_PATH[fp_len as usize] = 105; fp_len = fp_len + 1  // i
                IMP_PATH[fp_len as usize] = 111; fp_len = fp_len + 1  // o
            }
            let raw_len = fp_len
            var raw_i: i64 = 0
            while raw_i < raw_len {
                IMP_RAW_PATH[raw_i as usize] = IMP_PATH[raw_i as usize]
                raw_i = raw_i + 1
            }
            IMP_RAW_PATH[raw_len as usize] = 0
            var raw_has_slash: i64 = 0
            raw_i = 0
            while raw_i < raw_len {
                if IMP_RAW_PATH[raw_i as usize] == 47 { raw_has_slash = 1 }
                raw_i = raw_i + 1
            }
            var needs_base_dir: i64 = 1
            if fp_len > 0 && IMP_PATH[0 as usize] as i64 == 47 { needs_base_dir = 0 }
            if fp_len >= 7 {
                if IMP_PATH[0 as usize] as i64 == 115 && IMP_PATH[1 as usize] as i64 == 116 && IMP_PATH[2 as usize] as i64 == 100 && IMP_PATH[3 as usize] as i64 == 108 && IMP_PATH[4 as usize] as i64 == 105 && IMP_PATH[5 as usize] as i64 == 98 && IMP_PATH[6 as usize] as i64 == 47 {
                    needs_base_dir = 0
                }
            }
            if fp_len >= 12 {
                if IMP_PATH[0 as usize] as i64 == 115 && IMP_PATH[1 as usize] as i64 == 101 && IMP_PATH[2 as usize] as i64 == 108 && IMP_PATH[3 as usize] as i64 == 102 && IMP_PATH[4 as usize] as i64 == 45 && IMP_PATH[5 as usize] as i64 == 104 && IMP_PATH[6 as usize] as i64 == 111 && IMP_PATH[7 as usize] as i64 == 115 && IMP_PATH[8 as usize] as i64 == 116 && IMP_PATH[9 as usize] as i64 == 101 && IMP_PATH[10 as usize] as i64 == 100 && IMP_PATH[11 as usize] as i64 == 47 {
                    needs_base_dir = 0
                }
            }
            if needs_base_dir == 1 && BASE_DIR_LEN > 0 {
                var sj: i64 = fp_len - 1
                while sj >= 0 {
                    IMP_PATH[(BASE_DIR_LEN + 1 + sj) as usize] = IMP_PATH[sj as usize]
                    sj = sj - 1
                }
                var bj: i64 = 0
                while bj < BASE_DIR_LEN {
                    IMP_PATH[bj as usize] = BASE_DIR[bj as usize]
                    bj = bj + 1
                }
                IMP_PATH[BASE_DIR_LEN as usize] = 47
                fp_len = BASE_DIR_LEN + 1 + fp_len
            }
            IMP_PATH[fp_len as usize] = 0  // null terminate
            var early_loaded: i64 = imp_path_loaded(fp_len)
            if early_loaded == 0 && needs_base_dir == 1 {
                IMP_PATH[0 as usize] = 115
                IMP_PATH[1 as usize] = 101
                IMP_PATH[2 as usize] = 108
                IMP_PATH[3 as usize] = 102
                IMP_PATH[4 as usize] = 45
                IMP_PATH[5 as usize] = 104
                IMP_PATH[6 as usize] = 111
                IMP_PATH[7 as usize] = 115
                IMP_PATH[8 as usize] = 116
                IMP_PATH[9 as usize] = 101
                IMP_PATH[10 as usize] = 100
                IMP_PATH[11 as usize] = 47
                raw_i = 0
                while raw_i < raw_len {
                    IMP_PATH[(12 + raw_i) as usize] = IMP_RAW_PATH[raw_i as usize]
                    raw_i = raw_i + 1
                }
                fp_len = 12 + raw_len
                IMP_PATH[fp_len as usize] = 0
                early_loaded = imp_path_loaded(fp_len)
            }
            if early_loaded == 0 {
                fp_len = raw_len
                raw_i = 0
                while raw_i < raw_len {
                    IMP_PATH[raw_i as usize] = IMP_RAW_PATH[raw_i as usize]
                    raw_i = raw_i + 1
                }
                if needs_base_dir == 1 && BASE_DIR_LEN > 0 {
                    var restore_j: i64 = fp_len - 1
                    while restore_j >= 0 {
                        IMP_PATH[(BASE_DIR_LEN + 1 + restore_j) as usize] = IMP_PATH[restore_j as usize]
                        restore_j = restore_j - 1
                    }
                    var restore_b: i64 = 0
                    while restore_b < BASE_DIR_LEN {
                        IMP_PATH[restore_b as usize] = BASE_DIR[restore_b as usize]
                        restore_b = restore_b + 1
                    }
                    IMP_PATH[BASE_DIR_LEN as usize] = 47
                    fp_len = BASE_DIR_LEN + 1 + fp_len
                }
                IMP_PATH[fp_len as usize] = 0
            }
            var raw = ""
            var copy_len: i64 = 1
            var fsz: i64 = 1
            if early_loaded != 0 {
                copy_len = 1
                fsz = 1
            }
            if early_loaded == 0 {
                raw = read_file(IMP_PATH)
                copy_len = str_len(raw)
                fsz = file_size(IMP_PATH)
            }
            // mod.sio fallback for BASE_DIR path
            if early_loaded == 0 && copy_len <= 0 && raw_has_slash == 0 {
                var mfp: i64 = fp_len - 4
                var mi: i64 = 0
                while mi < mfp {
                    MOD_PATH[mi as usize] = IMP_PATH[mi as usize]
                    mi = mi + 1
                }
                MOD_PATH[mfp as usize] = 47
                MOD_PATH[(mfp+1) as usize] = 109
                MOD_PATH[(mfp+2) as usize] = 111
                MOD_PATH[(mfp+3) as usize] = 100
                MOD_PATH[(mfp+4) as usize] = 46
                MOD_PATH[(mfp+5) as usize] = 115
                MOD_PATH[(mfp+6) as usize] = 105
                MOD_PATH[(mfp+7) as usize] = 111
                mfp = mfp + 8
                MOD_PATH[mfp as usize] = 0
                raw = read_file(MOD_PATH)
                copy_len = str_len(raw)
                fsz = file_size(MOD_PATH)
                if copy_len > 0 {
                    mi = 0
                    while mi < mfp {
                        IMP_PATH[mi as usize] = MOD_PATH[mi as usize]
                        mi = mi + 1
                    }
                    fp_len = mfp
                    IMP_PATH[fp_len as usize] = 0
                }
            }
            if copy_len <= 0 && needs_base_dir == 1 {
                // Try stdlib/ prefix first
                IMP_PATH[0 as usize] = 115
                IMP_PATH[1 as usize] = 116
                IMP_PATH[2 as usize] = 100
                IMP_PATH[3 as usize] = 108
                IMP_PATH[4 as usize] = 105
                IMP_PATH[5 as usize] = 98
                IMP_PATH[6 as usize] = 47
                raw_i = 0
                while raw_i < raw_len {
                    IMP_PATH[(7 + raw_i) as usize] = IMP_RAW_PATH[raw_i as usize]
                    raw_i = raw_i + 1
                }
                fp_len = 7 + raw_len
                IMP_PATH[fp_len as usize] = 0
                raw = read_file(IMP_PATH)
                copy_len = str_len(raw)
                fsz = file_size(IMP_PATH)
                // mod.sio fallback for stdlib path
                if copy_len <= 0 {
                    var mfp: i64 = fp_len - 4
                    var mi: i64 = 0
                    while mi < mfp {
                        MOD_PATH[mi as usize] = IMP_PATH[mi as usize]
                        mi = mi + 1
                    }
                    MOD_PATH[mfp as usize] = 47
                    MOD_PATH[(mfp+1) as usize] = 109
                    MOD_PATH[(mfp+2) as usize] = 111
                    MOD_PATH[(mfp+3) as usize] = 100
                    MOD_PATH[(mfp+4) as usize] = 46
                    MOD_PATH[(mfp+5) as usize] = 115
                    MOD_PATH[(mfp+6) as usize] = 105
                    MOD_PATH[(mfp+7) as usize] = 111
                    mfp = mfp + 8
                    MOD_PATH[mfp as usize] = 0
                    raw = read_file(MOD_PATH)
                    copy_len = str_len(raw)
                    fsz = file_size(MOD_PATH)
                    if copy_len > 0 {
                        mi = 0
                        while mi < mfp {
                            IMP_PATH[mi as usize] = MOD_PATH[mi as usize]
                            mi = mi + 1
                        }
                        fp_len = mfp
                        IMP_PATH[fp_len as usize] = 0
                    }
                }
                // lib.sio fallback for stdlib/<module>.sio directory roots
                if copy_len <= 0 {
                    var lfp: i64 = fp_len - 4
                    var li: i64 = 0
                    while li < lfp {
                        MOD_PATH[li as usize] = IMP_PATH[li as usize]
                        li = li + 1
                    }
                    MOD_PATH[lfp as usize] = 47
                    MOD_PATH[(lfp+1) as usize] = 108
                    MOD_PATH[(lfp+2) as usize] = 105
                    MOD_PATH[(lfp+3) as usize] = 98
                    MOD_PATH[(lfp+4) as usize] = 46
                    MOD_PATH[(lfp+5) as usize] = 115
                    MOD_PATH[(lfp+6) as usize] = 105
                    MOD_PATH[(lfp+7) as usize] = 111
                    lfp = lfp + 8
                    MOD_PATH[lfp as usize] = 0
                    raw = read_file(MOD_PATH)
                    copy_len = str_len(raw)
                    fsz = file_size(MOD_PATH)
                    if copy_len > 0 {
                        li = 0
                        while li < lfp {
                            IMP_PATH[li as usize] = MOD_PATH[li as usize]
                            li = li + 1
                        }
                        fp_len = lfp
                        IMP_PATH[fp_len as usize] = 0
                    }
                }
                if copy_len <= 0 {
                    fp_len = raw_len
                    raw_i = 0
                    while raw_i < raw_len {
                        IMP_PATH[raw_i as usize] = IMP_RAW_PATH[raw_i as usize]
                        raw_i = raw_i + 1
                    }
                    IMP_PATH[fp_len as usize] = 0
                    raw = read_file(IMP_PATH)
                    copy_len = str_len(raw)
                    fsz = file_size(IMP_PATH)
                    // mod.sio fallback for raw path
                    if copy_len <= 0 {
                        var mfp: i64 = fp_len - 4
                        var mi: i64 = 0
                        while mi < mfp {
                            MOD_PATH[mi as usize] = IMP_PATH[mi as usize]
                            mi = mi + 1
                        }
                        MOD_PATH[mfp as usize] = 47
                        MOD_PATH[(mfp+1) as usize] = 109
                        MOD_PATH[(mfp+2) as usize] = 111
                        MOD_PATH[(mfp+3) as usize] = 100
                        MOD_PATH[(mfp+4) as usize] = 46
                        MOD_PATH[(mfp+5) as usize] = 115
                        MOD_PATH[(mfp+6) as usize] = 105
                        MOD_PATH[(mfp+7) as usize] = 111
                        mfp = mfp + 8
                        MOD_PATH[mfp as usize] = 0
                        raw = read_file(MOD_PATH)
                        copy_len = str_len(raw)
                        fsz = file_size(MOD_PATH)
                        if copy_len > 0 {
                            mi = 0
                            while mi < mfp {
                                IMP_PATH[mi as usize] = MOD_PATH[mi as usize]
                                mi = mi + 1
                            }
                            fp_len = mfp
                            IMP_PATH[fp_len as usize] = 0
                        }
                    }
                }
                if copy_len <= 0 {
                    fp_len = imp_build_package_path_from_raw(raw_len)
                    raw = read_file(IMP_PATH)
                    copy_len = str_len(raw)
                    fsz = file_size(IMP_PATH)
                    // mod.sio fallback for packages/<pkg>/src/<module>.sio
                    if copy_len <= 0 {
                        var mfp: i64 = fp_len - 4
                        var mi: i64 = 0
                        while mi < mfp {
                            MOD_PATH[mi as usize] = IMP_PATH[mi as usize]
                            mi = mi + 1
                        }
                        MOD_PATH[mfp as usize] = 47
                        MOD_PATH[(mfp+1) as usize] = 109
                        MOD_PATH[(mfp+2) as usize] = 111
                        MOD_PATH[(mfp+3) as usize] = 100
                        MOD_PATH[(mfp+4) as usize] = 46
                        MOD_PATH[(mfp+5) as usize] = 115
                        MOD_PATH[(mfp+6) as usize] = 105
                        MOD_PATH[(mfp+7) as usize] = 111
                        mfp = mfp + 8
                        MOD_PATH[mfp as usize] = 0
                        raw = read_file(MOD_PATH)
                        copy_len = str_len(raw)
                        fsz = file_size(MOD_PATH)
                        if copy_len > 0 {
                            mi = 0
                            while mi < mfp {
                                IMP_PATH[mi as usize] = MOD_PATH[mi as usize]
                                mi = mi + 1
                            }
                            fp_len = mfp
                            IMP_PATH[fp_len as usize] = 0
                        }
                    }
                }
                if copy_len <= 0 {
                    IMP_PATH[0 as usize] = 115
                    IMP_PATH[1 as usize] = 101
                    IMP_PATH[2 as usize] = 108
                    IMP_PATH[3 as usize] = 102
                    IMP_PATH[4 as usize] = 45
                    IMP_PATH[5 as usize] = 104
                    IMP_PATH[6 as usize] = 111
                    IMP_PATH[7 as usize] = 115
                    IMP_PATH[8 as usize] = 116
                    IMP_PATH[9 as usize] = 101
                    IMP_PATH[10 as usize] = 100
                    IMP_PATH[11 as usize] = 47
                    raw_i = 0
                    while raw_i < raw_len {
                        IMP_PATH[(12 + raw_i) as usize] = IMP_RAW_PATH[raw_i as usize]
                        raw_i = raw_i + 1
                    }
                    fp_len = 12 + raw_len
                    IMP_PATH[fp_len as usize] = 0
                    raw = read_file(IMP_PATH)
                    copy_len = str_len(raw)
                    fsz = file_size(IMP_PATH)
                    // mod.sio fallback for self-hosted path
                    if copy_len <= 0 {
                        var mfp: i64 = fp_len - 4
                        var mi: i64 = 0
                        while mi < mfp {
                            MOD_PATH[mi as usize] = IMP_PATH[mi as usize]
                            mi = mi + 1
                        }
                        MOD_PATH[mfp as usize] = 47
                        MOD_PATH[(mfp+1) as usize] = 109
                        MOD_PATH[(mfp+2) as usize] = 111
                        MOD_PATH[(mfp+3) as usize] = 100
                        MOD_PATH[(mfp+4) as usize] = 46
                        MOD_PATH[(mfp+5) as usize] = 115
                        MOD_PATH[(mfp+6) as usize] = 105
                        MOD_PATH[(mfp+7) as usize] = 111
                        mfp = mfp + 8
                        MOD_PATH[mfp as usize] = 0
                        raw = read_file(MOD_PATH)
                        copy_len = str_len(raw)
                        fsz = file_size(MOD_PATH)
                        if copy_len > 0 {
                            mi = 0
                            while mi < mfp {
                                IMP_PATH[mi as usize] = MOD_PATH[mi as usize]
                                mi = mi + 1
                            }
                            fp_len = mfp
                            IMP_PATH[fp_len as usize] = 0
                        }
                    }
                }
            }
            // Bug C fallback: every attempt above treated the whole `use`
            // path as a file path. For a bare named import with no glob/brace
            // marker, the last segment may instead be the specific symbol
            // being imported (e.g. `use pkg::mod::item` means "load
            // pkg/mod.sio, bring `item` into scope", not "load
            // pkg/mod/item.sio") — retry once with that last `/`-segment
            // dropped, across the same path roots the primary attempts used.
            if copy_len <= 0 && is_named_import == 1 {
                var bc_strip: i64 = raw_len - 4  // drop ".sio"
                var bc_slash: i64 = -1
                var bc_si: i64 = bc_strip - 1
                while bc_si >= 0 {
                    if IMP_RAW_PATH[bc_si as usize] == 47 { bc_slash = bc_si; bc_si = -1 } else { bc_si = bc_si - 1 }
                }
                if bc_slash > 0 {
                    var bc_len: i64 = bc_slash
                    IMP_RAW_PATH[bc_len as usize] = 46; bc_len = bc_len + 1   // .
                    IMP_RAW_PATH[bc_len as usize] = 115; bc_len = bc_len + 1  // s
                    IMP_RAW_PATH[bc_len as usize] = 105; bc_len = bc_len + 1  // i
                    IMP_RAW_PATH[bc_len as usize] = 111; bc_len = bc_len + 1  // o
                    IMP_RAW_PATH[bc_len as usize] = 0
                    if needs_base_dir == 1 && BASE_DIR_LEN > 0 {
                        var bc_bj: i64 = 0
                        while bc_bj < BASE_DIR_LEN { IMP_PATH[bc_bj as usize] = BASE_DIR[bc_bj as usize]; bc_bj = bc_bj + 1 }
                        IMP_PATH[BASE_DIR_LEN as usize] = 47
                        var bc_rj: i64 = 0
                        while bc_rj < bc_len { IMP_PATH[(BASE_DIR_LEN + 1 + bc_rj) as usize] = IMP_RAW_PATH[bc_rj as usize]; bc_rj = bc_rj + 1 }
                        fp_len = BASE_DIR_LEN + 1 + bc_len
                        IMP_PATH[fp_len as usize] = 0
                        raw = read_file(IMP_PATH)
                        copy_len = str_len(raw)
                        fsz = file_size(IMP_PATH)
                    }
                    if copy_len <= 0 {
                        IMP_PATH[0 as usize] = 115; IMP_PATH[1 as usize] = 116; IMP_PATH[2 as usize] = 100
                        IMP_PATH[3 as usize] = 108; IMP_PATH[4 as usize] = 105; IMP_PATH[5 as usize] = 98
                        IMP_PATH[6 as usize] = 47
                        var bc_rj2: i64 = 0
                        while bc_rj2 < bc_len { IMP_PATH[(7 + bc_rj2) as usize] = IMP_RAW_PATH[bc_rj2 as usize]; bc_rj2 = bc_rj2 + 1 }
                        fp_len = 7 + bc_len
                        IMP_PATH[fp_len as usize] = 0
                        raw = read_file(IMP_PATH)
                        copy_len = str_len(raw)
                        fsz = file_size(IMP_PATH)
                    }
                    if copy_len <= 0 {
                        IMP_PATH[0 as usize] = 115; IMP_PATH[1 as usize] = 101; IMP_PATH[2 as usize] = 108
                        IMP_PATH[3 as usize] = 102; IMP_PATH[4 as usize] = 45; IMP_PATH[5 as usize] = 104
                        IMP_PATH[6 as usize] = 111; IMP_PATH[7 as usize] = 115; IMP_PATH[8 as usize] = 116
                        IMP_PATH[9 as usize] = 101; IMP_PATH[10 as usize] = 100; IMP_PATH[11 as usize] = 47
                        var bc_rj3: i64 = 0
                        while bc_rj3 < bc_len { IMP_PATH[(12 + bc_rj3) as usize] = IMP_RAW_PATH[bc_rj3 as usize]; bc_rj3 = bc_rj3 + 1 }
                        fp_len = 12 + bc_len
                        IMP_PATH[fp_len as usize] = 0
                        raw = read_file(IMP_PATH)
                        copy_len = str_len(raw)
                        fsz = file_size(IMP_PATH)
                    }
                    if copy_len <= 0 {
                        var bc_rj4: i64 = 0
                        while bc_rj4 < bc_len { IMP_PATH[bc_rj4 as usize] = IMP_RAW_PATH[bc_rj4 as usize]; bc_rj4 = bc_rj4 + 1 }
                        fp_len = bc_len
                        IMP_PATH[fp_len as usize] = 0
                        raw = read_file(IMP_PATH)
                        copy_len = str_len(raw)
                        fsz = file_size(IMP_PATH)
                    }
                }
            }
            if copy_len <= 0 {
                IMPORT_RESOLUTION_FAILED = 1
                print("error[E224]: unreadable import: ")
                print_imp_path()
                print("\n")
            } else {
                if fsz <= 0 || fsz >= 16777216 {
                    print("warning: import size invalid; using read count for ")
                    print_imp_path()
                    print("\n")
                }
                // Dedup check — string comparison (hash pre-filter + full path match)
                let ph = imp_path_hash(fp_len)
                var already: i64 = 0
                var di: i64 = 0
                while di < IMP_COUNT {
                    if IMP_LOADED[di as usize] == ph && IMP_LOADED_LENS[di as usize] == fp_len {
                        let off = IMP_LOADED_OFFS[di as usize]
                        var match_ok: i64 = 1
                        var mi: i64 = 0
                        while mi < fp_len {
                            if IMP_LOADED_PATHS[(off + mi) as usize] != IMP_PATH[mi as usize] { match_ok = 0 }
                            mi = mi + 1
                        }
                        if match_ok == 1 { already = 1 }
                    }
                    di = di + 1
                }
                if already == 0 {
                    if IMP_COUNT >= 1024 {
                        IMPORT_RESOLUTION_FAILED = 1
                        print("error[E225]: import dedup table full: ")
                        print_imp_path()
                        print("\n")
                    } else if IMP_PATHS_USED + fp_len > 262144 {
                        IMPORT_RESOLUTION_FAILED = 1
                        print("error[E226]: import path table full: ")
                        print_imp_path()
                        print("\n")
                    } else if copy_len >= 16777216 || SRC_LEN + fp_len + copy_len + 3 >= 16777216 {
                        IMPORT_RESOLUTION_FAILED = 1
                        print("error[E227]: import too large for SRC buffer: ")
                        print_imp_path()
                        print(" (")
                        print_int(copy_len)
                        print(" bytes)\n")
                    } else {
                        let prev_src_len = SRC_LEN
                        SRC[SRC_LEN as usize] = 10
                        SRC_LEN = SRC_LEN + 1
                        SRC[SRC_LEN as usize] = 1
                        SRC_LEN = SRC_LEN + 1
                        var pi2: i64 = 0
                        while pi2 < fp_len {
                            SRC[(SRC_LEN + pi2) as usize] = IMP_PATH[pi2 as usize]
                            pi2 = pi2 + 1
                        }
                        SRC_LEN = SRC_LEN + fp_len
                        SRC[SRC_LEN as usize] = 2
                        SRC_LEN = SRC_LEN + 1
                        var ci: i64 = 0
                        while ci < copy_len && SRC_LEN + ci < 16777216 {
                            SRC[(SRC_LEN + ci) as usize] = raw[ci as usize]
                            ci = ci + 1
                        }
                        if ci != copy_len {
                            SRC_LEN = prev_src_len
                            IMPORT_RESOLUTION_FAILED = 1
                            print("error[E228]: import copy truncated: ")
                            print_imp_path()
                            print("\n")
                        } else {
                            SRC_LEN = SRC_LEN + copy_len
                            IMP_LOADED[IMP_COUNT as usize] = ph
                            IMP_LOADED_OFFS[IMP_COUNT as usize] = IMP_PATHS_USED
                            IMP_LOADED_LENS[IMP_COUNT as usize] = fp_len
                            var ri: i64 = 0
                            while ri < fp_len {
                                IMP_LOADED_PATHS[(IMP_PATHS_USED + ri) as usize] = IMP_PATH[ri as usize]
                                ri = ri + 1
                            }
                            IMP_PATHS_USED = IMP_PATHS_USED + fp_len
                            IMP_COUNT = IMP_COUNT + 1
                            print("import: ")
                            print_imp_path()
                            print(" ")
                            print_int(copy_len)
                            print(" bytes\n")
                        }
                    }
                }
            }
        }
        // Advance to next line
        while pos < SRC_LEN && sb(pos) != 10 { pos = pos + 1 }
        if pos < SRC_LEN { pos = pos + 1 }
    }
}

// Track extern function count for diagnostics
var EXTERN_FN_COUNT: i64 = 0

// ─── Extern "C" stub registry ───
// Populated by strip_extern_blocks; stubs are appended to SRC afterward.
// Each entry stores: name bytes, arity, return type code (1=i64, 2=f64, 4=bool, 5=unit).
// Names are copied into EXTERN_STUB_NAME_BUF to survive SRC compaction.
var EXTERN_STUB_NAME_BUF: [i8; 4096] = [0; 4096]   // packed name bytes
var EXTERN_STUB_NAME_OFF: [i64; 128] = [0; 128]     // byte offset of each name in buf
var EXTERN_STUB_NAME_LEN: [i64; 128] = [0; 128]     // length of each name
var EXTERN_STUB_ARITY:    [i64; 128] = [0; 128]     // param count
var EXTERN_STUB_RET:      [i64; 128] = [0; 128]     // 1=i64/int, 2=f64, 4=bool, 5=unit
var EXTERN_STUB_COUNT:    i64 = 0
var EXTERN_STUB_BUF_OFF:  i64 = 0                   // next free offset in name buf

// Parse a type keyword starting at position p in SRC; return type code.
// Returns 1 for integer types, 2 for f64/f32, 4 for bool, 5 for unit/void, 0 for unknown.
fn extern_parse_ret_ty(p: i64) -> i64 with Panic, Mut, Div {
    // Skip whitespace
    var i: i64 = p
    while i < SRC_LEN && (sb(i) == 32 || sb(i) == 9) { i = i + 1 }
    // i64, i32, i16, i8, u64, u32, u16, u8, usize, isize
    if i + 2 < SRC_LEN && sb(i) == 105 && sb(i + 1) == 54 && sb(i + 2) == 52 { return 1 }  // i64
    if i + 2 < SRC_LEN && sb(i) == 105 && sb(i + 1) == 51 && sb(i + 2) == 50 { return 1 }  // i32
    if i + 2 < SRC_LEN && sb(i) == 105 && sb(i + 1) == 49 && sb(i + 2) == 54 { return 1 }  // i16
    if i + 1 < SRC_LEN && sb(i) == 105 && sb(i + 1) == 56 { return 1 }                      // i8
    if i + 2 < SRC_LEN && sb(i) == 117 && sb(i + 1) == 54 && sb(i + 2) == 52 { return 1 }  // u64
    if i + 2 < SRC_LEN && sb(i) == 117 && sb(i + 1) == 51 && sb(i + 2) == 50 { return 1 }  // u32
    if i + 4 < SRC_LEN && sb(i) == 117 && sb(i + 1) == 115 && sb(i + 2) == 105 && sb(i + 3) == 122 && sb(i + 4) == 101 { return 1 }  // usize
    if i + 2 < SRC_LEN && sb(i) == 102 && sb(i + 1) == 54 && sb(i + 2) == 52 { return 2 }  // f64
    if i + 2 < SRC_LEN && sb(i) == 102 && sb(i + 1) == 51 && sb(i + 2) == 50 { return 2 }  // f32
    if i + 3 < SRC_LEN && sb(i) == 98 && sb(i + 1) == 111 && sb(i + 2) == 111 && sb(i + 3) == 108 { return 4 }  // bool
    if i + 3 < SRC_LEN && sb(i) == 118 && sb(i + 1) == 111 && sb(i + 2) == 105 && sb(i + 3) == 100 { return 5 }  // void
    return 1  // default: treat as integer
}

// Match extern stub name against a literal string (byte-by-byte comparison).
fn extern_stub_name_eq(idx: i64, lit: string) -> i64 with Panic, Mut {
    let noff = EXTERN_STUB_NAME_OFF[idx as usize]
    let nlen = EXTERN_STUB_NAME_LEN[idx as usize]
    let llen = str_len(lit)
    if nlen != llen { return 0 }
    var k: i64 = 0
    while k < nlen {
        let nb = EXTERN_STUB_NAME_BUF[(noff + k) as usize] as i64 & 0xFF
        let lb = str_char_at(lit, k)
        if nb != lb { return 0 }
        k = k + 1
    }
    return 1
}

// Keep math intrinsics available for names declared through `extern "C"`.
// Those declarations are replaced with Sounio stubs before function discovery;
// imported Sounio functions are deliberately not matched here.
fn extern_stub_matches_src(ns: i64, ne: i64) -> i64 with Panic, Mut {
    let name_len = ne - ns
    var idx: i64 = 0
    while idx < EXTERN_STUB_COUNT {
        let stub_len = EXTERN_STUB_NAME_LEN[idx as usize]
        if stub_len == name_len {
            let stub_off = EXTERN_STUB_NAME_OFF[idx as usize]
            var k: i64 = 0
            var matches: i64 = 1
            while k < name_len {
                let stub_byte = EXTERN_STUB_NAME_BUF[(stub_off + k) as usize] as i64 & 0xFF
                if sb(ns + k) != stub_byte { matches = 0 }
                k = k + 1
            }
            if matches == 1 { return 1 }
        }
        idx = idx + 1
    }
    return 0
}

// Append extern stub name to SRC (for generating stub function text).
fn append_extern_stub_name(idx: i64) with Mut, Panic {
    let noff = EXTERN_STUB_NAME_OFF[idx as usize]
    let nlen = EXTERN_STUB_NAME_LEN[idx as usize]
    var k: i64 = 0
    while k < nlen && SRC_LEN < 8388607 {
        SRC[SRC_LEN as usize] = EXTERN_STUB_NAME_BUF[(noff + k) as usize]
        SRC_LEN = SRC_LEN + 1
        k = k + 1
    }
}

// Generate Sounio stub source code for all registered extern "C" functions.
// Called from append_native_prelude after strip_extern_blocks.
// Each stub wraps the extern fn using the correct mechanism:
//   - Known zero-arg integer syscalls: emit via syscall6(NR, 0,0,0,0,0,0)
//   - Known math f64 functions: delegate to __native_*_f64
//   - Others: emit a panic stub
// The XMM0-vs-RAX fix is implicit here: our stubs return in RAX (Sounio convention).
// For integer syscalls, syscall6 returns in RAX directly (correct).
// For f64 math, __native_*_f64 returns f64 bits in RAX (correct).
// Any future real C-ABI call would need: if ret==f64 then movq rax,xmm0 after call.
fn append_extern_c_stubs() with Mut, Panic, Div {
    var si: i64 = 0
    while si < EXTERN_STUB_COUNT {
        let ret = EXTERN_STUB_RET[si as usize]
        let arity = EXTERN_STUB_ARITY[si as usize]
        append_src_lit("\n")
        // ── Zero-argument integer-returning syscalls ──
        // getpid → Linux x86-64 syscall 39
        if extern_stub_name_eq(si, "getpid") == 1 {
            append_src_lit("fn getpid() -> i64 with IO { syscall6(39, 0, 0, 0, 0, 0, 0) }\n")
            si = si + 1
            continue
        }
        // getppid → syscall 110
        if extern_stub_name_eq(si, "getppid") == 1 {
            append_src_lit("fn getppid() -> i64 with IO { syscall6(110, 0, 0, 0, 0, 0, 0) }\n")
            si = si + 1
            continue
        }
        // gettid → syscall 186
        if extern_stub_name_eq(si, "gettid") == 1 {
            append_src_lit("fn gettid() -> i64 with IO { syscall6(186, 0, 0, 0, 0, 0, 0) }\n")
            si = si + 1
            continue
        }
        // getuid → syscall 102
        if extern_stub_name_eq(si, "getuid") == 1 {
            append_src_lit("fn getuid() -> i64 with IO { syscall6(102, 0, 0, 0, 0, 0, 0) }\n")
            si = si + 1
            continue
        }
        // getgid → syscall 104
        if extern_stub_name_eq(si, "getgid") == 1 {
            append_src_lit("fn getgid() -> i64 with IO { syscall6(104, 0, 0, 0, 0, 0, 0) }\n")
            si = si + 1
            continue
        }
        // geteuid → syscall 107
        if extern_stub_name_eq(si, "geteuid") == 1 {
            append_src_lit("fn geteuid() -> i64 with IO { syscall6(107, 0, 0, 0, 0, 0, 0) }\n")
            si = si + 1
            continue
        }
        // getegid → syscall 108
        if extern_stub_name_eq(si, "getegid") == 1 {
            append_src_lit("fn getegid() -> i64 with IO { syscall6(108, 0, 0, 0, 0, 0, 0) }\n")
            si = si + 1
            continue
        }
        // ── f64-returning math functions — delegate to native impls ──
        // The critical register-convention fix: real C-ABI f64 returns land in XMM0.
        // Our native implementations keep f64 as bit-patterns in RAX (Sounio convention).
        // Using __native_* stubs means no XMM0 read is needed — RAX is already correct.
        // (Any direct C-ABI call must emit `movq rax, xmm0` after the call for f64.)
        if extern_stub_name_eq(si, "sqrt") == 1 {
            append_src_lit("fn sqrt(x: f64) -> f64 with Mut, Div, Panic { __native_sqrt_f64(x) }\n")
            si = si + 1
            continue
        }
        if extern_stub_name_eq(si, "sin") == 1 {
            append_src_lit("fn sin(x: f64) -> f64 with Mut, Div, Panic { __native_sin_f64(x) }\n")
            si = si + 1
            continue
        }
        if extern_stub_name_eq(si, "cos") == 1 {
            append_src_lit("fn cos(x: f64) -> f64 with Mut, Div, Panic { __native_cos_f64(x) }\n")
            si = si + 1
            continue
        }
        if extern_stub_name_eq(si, "exp") == 1 {
            append_src_lit("fn exp(x: f64) -> f64 with Mut, Div, Panic { __native_exp_f64(x) }\n")
            si = si + 1
            continue
        }
        if extern_stub_name_eq(si, "log") == 1 {
            append_src_lit("fn log(x: f64) -> f64 with Mut, Div, Panic { __native_ln_f64(x) }\n")
            si = si + 1
            continue
        }
        if extern_stub_name_eq(si, "ln") == 1 {
            append_src_lit("fn ln(x: f64) -> f64 with Mut, Div, Panic { __native_ln_f64(x) }\n")
            si = si + 1
            continue
        }
        if extern_stub_name_eq(si, "fabs") == 1 || extern_stub_name_eq(si, "abs") == 1 {
            if ret == 2 {
                append_src_lit("fn ")
                append_extern_stub_name(si)
                append_src_lit("(x: f64) -> f64 with Mut, Div, Panic { __native_abs_f64(x) }\n")
            } else {
                append_src_lit("fn ")
                append_extern_stub_name(si)
                append_src_lit("(x: i64) -> i64 { __native_abs_i64(x) }\n")
            }
            si = si + 1
            continue
        }
        if extern_stub_name_eq(si, "tanh") == 1 {
            append_src_lit("fn tanh(x: f64) -> f64 with Mut, Div, Panic { __native_tanh_f64(x) }\n")
            si = si + 1
            continue
        }
        if extern_stub_name_eq(si, "atan2") == 1 {
            append_src_lit("fn atan2(y: f64, x: f64) -> f64 with Mut, Div, Panic { __native_atan2_f64(y, x) }\n")
            si = si + 1
            continue
        }
        if extern_stub_name_eq(si, "atan") == 1 {
            append_src_lit("fn atan(x: f64) -> f64 with Mut, Div, Panic { __native_atan_f64(x) }\n")
            si = si + 1
            continue
        }
        if extern_stub_name_eq(si, "tan") == 1 {
            append_src_lit("fn tan(x: f64) -> f64 with Mut, Div, Panic { __native_tan_f64(x) }\n")
            si = si + 1
            continue
        }
        if extern_stub_name_eq(si, "asin") == 1 {
            append_src_lit("fn asin(x: f64) -> f64 with Mut, Div, Panic { __native_asin_f64(x) }\n")
            si = si + 1
            continue
        }
        if extern_stub_name_eq(si, "acos") == 1 {
            append_src_lit("fn acos(x: f64) -> f64 with Mut, Div, Panic { __native_acos_f64(x) }\n")
            si = si + 1
            continue
        }
        if extern_stub_name_eq(si, "pow") == 1 {
            // pow(x, y) = exp(y * ln(x)) — approximation using native functions
            append_src_lit("fn pow(x: f64, y: f64) -> f64 with Mut, Div, Panic { __native_exp_f64(y * __native_ln_f64(x)) }\n")
            si = si + 1
            continue
        }
        // ── system(cmd) — real fork+execve("/bin/sh","-c",cmd)+wait4.
        // Same syscall pattern as self-hosted/lsp/server.sio's run_souc_check
        // (fork=57, execve=59, wait4=61, exit=60), which is the only other
        // proven-working fork/exec call site in this tree. Fixes the
        // no-op documented in docs/audit/EXTERN_C_FFI_SILENT_NOOP_DISPATCH_2026-08-13.md:
        // previously `system` fell through to the generic single-arg
        // fallback, which declares its parameter as bare `i64` — a type
        // mismatch against any real caller's `cmd: &[i8;N]`, so every
        // caller failed to type-check (not a silent no-op under
        // lean_single specifically; the no-op was Madaros's separate,
        // undocumented gap, still open per that dispatch's Track A).
        // Callers must declare `extern "C" { fn system(cmd: &[i8;1024]) -> i32 }`
        // (this exact size) to match this stub's parameter type — Sounio
        // has no size-generic array params, so the size is fixed, matching
        // the convention already used by self-hosted/compiler/pkg/registry_client.sio.
        // envp carries a minimal fixed PATH (not the real caller's
        // environment, which isn't otherwise available to this stub) so
        // `sh -c "somecmd"` can still resolve `somecmd` via PATH lookup.
        if extern_stub_name_eq(si, "system") == 1 {
            append_src_lit("fn system(cmd: &[i8; 1024]) -> i64 with IO, Mut, Panic {\n")
            append_src_lit("    var argv: [i64; 4] = [0; 4]\n")
            append_src_lit("    var envp: [i64; 2] = [0; 2]\n")
            append_src_lit("    argv[0] = \"/bin/sh\" as i64\n")
            append_src_lit("    argv[1] = \"-c\" as i64\n")
            append_src_lit("    argv[2] = cmd as i64\n")
            append_src_lit("    argv[3] = 0\n")
            append_src_lit("    envp[0] = \"PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\" as i64\n")
            append_src_lit("    envp[1] = 0\n")
            append_src_lit("    let pid = syscall6(57, 0, 0, 0, 0, 0, 0)\n")
            append_src_lit("    if pid < 0 { return 0 - 1 }\n")
            append_src_lit("    if pid == 0 {\n")
            append_src_lit("        syscall6(59, \"/bin/sh\" as i64, &!argv, &!envp, 0, 0, 0)\n")
            append_src_lit("        syscall6(60, 127, 0, 0, 0, 0, 0)\n")
            append_src_lit("    }\n")
            append_src_lit("    var status: [i64; 1] = [0; 1]\n")
            append_src_lit("    syscall6(61, pid, &!status, 0, 0, 0, 0)\n")
            append_src_lit("    status[0]\n")
            append_src_lit("}\n")
            si = si + 1
            continue
        }
        // ── malloc/free — map to heap_alloc/heap_free ──
        if extern_stub_name_eq(si, "malloc") == 1 {
            append_src_lit("fn malloc(size: i64) -> i64 with IO, Alloc { heap_alloc(size) as i64 }\n")
            si = si + 1
            continue
        }
        if extern_stub_name_eq(si, "free") == 1 {
            append_src_lit("fn free(ptr: i64) with IO, Alloc { heap_free(ptr as i64) }\n")
            si = si + 1
            continue
        }
        // ── Fallback: generate panic stub ──
        // For unknown extern "C" functions, emit a stub that panics.
        // This preserves the type signature in the FN table so callers type-check,
        // but fails at runtime with a clear message rather than silently returning garbage.
        append_src_lit("fn ")
        append_extern_stub_name(si)
        if ret == 2 {
            // f64 return
            if arity == 0 { append_src_lit("() -> f64 with Panic { panic(\"unresolved extern fn\"); 0.0 }\n") }
            else if arity == 1 { append_src_lit("(a: f64) -> f64 with Panic { panic(\"unresolved extern fn\"); 0.0 }\n") }
            else { append_src_lit("(a: f64, b: f64) -> f64 with Panic { panic(\"unresolved extern fn\"); 0.0 }\n") }
        } else if ret == 5 {
            // void/unit return
            if arity == 0 { append_src_lit("() with Panic { panic(\"unresolved extern fn\") }\n") }
            else if arity == 1 { append_src_lit("(a: i64) with Panic { panic(\"unresolved extern fn\") }\n") }
            else { append_src_lit("(a: i64, b: i64) with Panic { panic(\"unresolved extern fn\") }\n") }
        } else {
            // integer/bool return
            if arity == 0 { append_src_lit("() -> i64 with Panic { panic(\"unresolved extern fn\"); 0 }\n") }
            else if arity == 1 { append_src_lit("(a: i64) -> i64 with Panic { panic(\"unresolved extern fn\"); 0 }\n") }
            else { append_src_lit("(a: i64, b: i64) -> i64 with Panic { panic(\"unresolved extern fn\"); 0 }\n") }
        }
        si = si + 1
    }
}

fn strip_extern_blocks() with IO, Mut, Panic, Div {
    EXTERN_STUB_COUNT = 0
    EXTERN_STUB_BUF_OFF = 0
    // Phase 1: Count extern fn declarations and collect signatures for stub generation.
    // We parse each extern "C" { fn NAME(ARGS) -> RET; ... } block.
    var scan: i64 = 0
    while scan < SRC_LEN {
        if scan + 9 < SRC_LEN && sb(scan) == 101 && sb(scan + 1) == 120 && sb(scan + 2) == 116 && sb(scan + 3) == 101 && sb(scan + 4) == 114 && sb(scan + 5) == 110 && sb(scan + 6) == 32 && sb(scan + 7) == 34 && sb(scan + 8) == 67 && sb(scan + 9) == 34 {
            // Find opening { of block
            var es: i64 = scan
            while es < SRC_LEN && sb(es) != 123 { es = es + 1 }
            if es < SRC_LEN {
                var ed: i64 = 1
                es = es + 1
                while es < SRC_LEN && ed > 0 {
                    // Look for 'fn' keyword: bytes 102('f'), 110('n'), then space/newline
                    if sb(es) == 102 && es + 1 < SRC_LEN && sb(es + 1) == 110 && es + 2 < SRC_LEN && (sb(es + 2) == 32 || sb(es + 2) == 9 || sb(es + 2) == 10) {
                        EXTERN_FN_COUNT = EXTERN_FN_COUNT + 1
                        // Skip 'fn' and whitespace to reach function name
                        var np: i64 = es + 2
                        while np < SRC_LEN && (sb(np) == 32 || sb(np) == 9) { np = np + 1 }
                        // Collect function name (alphanumeric + underscore)
                        let name_start = np
                        while np < SRC_LEN && (
                            (sb(np) >= 97 && sb(np) <= 122) ||  // a-z
                            (sb(np) >= 65 && sb(np) <= 90) ||   // A-Z
                            (sb(np) >= 48 && sb(np) <= 57) ||   // 0-9
                            sb(np) == 95                          // _
                        ) { np = np + 1 }
                        let name_len = np - name_start
                        // Find opening paren and count parameters
                        while np < SRC_LEN && sb(np) != 40 && sb(np) != 10 { np = np + 1 }
                        var argc: i64 = 0
                        if np < SRC_LEN && sb(np) == 40 {
                            np = np + 1  // skip (
                            // Count params: if first non-ws is ), arity=0; else count commas+1
                            var pp: i64 = np
                            while pp < SRC_LEN && (sb(pp) == 32 || sb(pp) == 9) { pp = pp + 1 }
                            if pp < SRC_LEN && sb(pp) != 41 {
                                argc = 1
                                var pdepth: i64 = 1
                                while pp < SRC_LEN && pdepth > 0 {
                                    if sb(pp) == 40 { pdepth = pdepth + 1 }
                                    if sb(pp) == 41 { pdepth = pdepth - 1; if pdepth == 0 { break } }
                                    if sb(pp) == 44 && pdepth == 1 { argc = argc + 1 }
                                    pp = pp + 1
                                }
                                np = pp + 1  // skip )
                            } else {
                                np = pp + 1  // skip )
                            }
                        }
                        // Parse return type: look for -> after )
                        var ret_ty: i64 = 5  // default: unit
                        while np < SRC_LEN && sb(np) != 10 && sb(np) != 59 && !(sb(np) == 125 && ed <= 1) {
                            // Look for -> (bytes 45, 62)
                            if sb(np) == 45 && np + 1 < SRC_LEN && sb(np + 1) == 62 {
                                np = np + 2
                                ret_ty = extern_parse_ret_ty(np)
                                break
                            }
                            np = np + 1
                        }
                        // Store in extern stub registry (if not full)
                        if EXTERN_STUB_COUNT < 127 && name_len > 0 && EXTERN_STUB_BUF_OFF + name_len < 4095 {
                            let si = EXTERN_STUB_COUNT
                            EXTERN_STUB_NAME_OFF[si as usize] = EXTERN_STUB_BUF_OFF
                            EXTERN_STUB_NAME_LEN[si as usize] = name_len
                            var ki: i64 = 0
                            while ki < name_len {
                                EXTERN_STUB_NAME_BUF[(EXTERN_STUB_BUF_OFF + ki) as usize] = SRC[(name_start + ki) as usize]
                                ki = ki + 1
                            }
                            EXTERN_STUB_BUF_OFF = EXTERN_STUB_BUF_OFF + name_len
                            EXTERN_STUB_ARITY[si as usize] = argc
                            EXTERN_STUB_RET[si as usize] = ret_ty
                            EXTERN_STUB_COUNT = EXTERN_STUB_COUNT + 1
                        }
                    }
                    if sb(es) == 123 { ed = ed + 1 }
                    if sb(es) == 125 { ed = ed - 1 }
                    es = es + 1
                }
            }
        }
        scan = scan + 1
    }

    // Phase 2: Strip extern blocks (preserve newlines for line tracking)
    var r: i64 = 0
    var w: i64 = 0
    while r < SRC_LEN {
        if r + 9 < SRC_LEN && sb(r) == 101 && sb(r + 1) == 120 && sb(r + 2) == 116 && sb(r + 3) == 101 && sb(r + 4) == 114 && sb(r + 5) == 110 && sb(r + 6) == 32 && sb(r + 7) == 34 && sb(r + 8) == 67 && sb(r + 9) == 34 {
            // Guard: skip if 'extern' appears inside a line comment (// on same line before it)
            var in_comment: i64 = 0
            var ck: i64 = r - 1
            while ck >= 0 && sb(ck) != 10 {
                if sb(ck) == 47 && ck + 1 < SRC_LEN && sb(ck + 1) == 47 { in_comment = 1 }
                ck = ck - 1
            }
            if in_comment == 1 {
                SRC[w as usize] = SRC[r as usize]; w = w + 1; r = r + 1
                continue
            }
            // Real block: scan forward to { on same line (stop at newline)
            var r2: i64 = r + 10
            while r2 < SRC_LEN && sb(r2) != 123 && sb(r2) != 10 { r2 = r2 + 1 }
            if r2 >= SRC_LEN || sb(r2) != 123 {
                // No { found before newline — not a real extern block, copy normally
                SRC[w as usize] = SRC[r as usize]; w = w + 1; r = r + 1
                continue
            }
            while r < SRC_LEN && sb(r) != 123 {
                if sb(r) == 10 {
                    SRC[w as usize] = 10
                    w = w + 1
                }
                r = r + 1
            }
            if r < SRC_LEN && sb(r) == 123 {
                var depth: i64 = 1
                r = r + 1
                while r < SRC_LEN && depth > 0 {
                    if sb(r) == 123 { depth = depth + 1 }
                    if sb(r) == 125 { depth = depth - 1 }
                    if sb(r) == 10 {
                        SRC[w as usize] = 10
                        w = w + 1
                    }
                    r = r + 1
                }
                continue
            }
        }
        SRC[w as usize] = SRC[r as usize]
        w = w + 1
        r = r + 1
    }
    SRC_LEN = w
    // Phase 3: Append Sounio stubs for each parsed extern "C" function.
    // Stubs are appended to SRC here; append_native_prelude appends __native_* helpers after us.
    // We call append_extern_c_stubs() which generates the correct stub for each extern fn.
    append_extern_c_stubs()
}

fn main() -> i64 with IO, Mut, Panic, Div {
    let argc = arg_count()
    if argc < 2 {
        print("Usage: mini_native <source.sio> <output> [--show-ast] [--show-types] [--r15-monitor] [--target x86_64-windows]\n")
        return 1
    }
    let src = get_arg(0)
    let out = get_arg(1)
    let src_len = str_len(src)
    BASE_DIR_LEN = 0
    var src_i: i64 = 0
    var last_slash: i64 = -1
    while src_i < src_len {
        if str_char_at(src, src_i) == 47 { last_slash = src_i }
        src_i = src_i + 1
    }
    if last_slash < 0 {
        BASE_DIR[0 as usize] = 46
        BASE_DIR_LEN = 1
    } else {
        src_i = 0
        while src_i < last_slash && src_i < 511 {
            BASE_DIR[src_i as usize] = str_char_at(src, src_i) as i8
            src_i = src_i + 1
        }
        BASE_DIR_LEN = src_i
    }
    BASE_DIR[BASE_DIR_LEN as usize] = 0

    CLI_SHOW_AST = 0
    CLI_SHOW_TYPES = 0
    CLI_DEBUG_FN_MAP = 0
    CLI_R15_MONITOR = 0
    CLI_DUMP_CONF_JSON = 0
    CLI_EMIT_ECONF = 0
    CLI_LOAD_ECONF = 0
    CLI_EMIT_PROOFS = 0
    PROOF_BUF_LEN = 0
    ECONF_RAW_LEN = 0
    ECONF_APPLIED = 0
    var arg_i: i64 = 2
    while arg_i < argc {
        let flag = get_arg(arg_i)
        if cli_arg_eq(flag, "--show-ast") {
            CLI_SHOW_AST = 1
        } else {
        if cli_arg_eq(flag, "--debug-fn-map") {
            CLI_DEBUG_FN_MAP = 1
        } else {
        if cli_arg_eq(flag, "--r15-monitor") {
            CLI_R15_MONITOR = 1
        } else {
        if cli_arg_eq(flag, "--dump-conf-json") {
            CLI_DUMP_CONF_JSON = 1
        } else {
        if cli_arg_eq(flag, "--emit-econf") {
            CLI_EMIT_ECONF = 1
        } else {
        if cli_arg_eq(flag, "--emit-proof-obligations") {
            CLI_EMIT_PROOFS = 1
        } else {
        if cli_arg_eq(flag, "--load-econf") && arg_i + 1 < argc {
            // Read the .econf file immediately and cache raw bytes
            CLI_LOAD_ECONF = 1
            let ep = get_arg(arg_i + 1)
            let eraw = read_file(ep)
            let esz = file_size(ep)
            var ei: i64 = 0
            while ei < esz && ei < 65536 {
                ECONF_RAW[ei as usize] = str_char_at(eraw, ei)
                ei = ei + 1
            }
            ECONF_RAW_LEN = esz
            arg_i = arg_i + 1
        } else {
        if cli_arg_eq(flag, "--show-types") {
                CLI_SHOW_TYPES = 1
            } else {
                if cli_arg_eq(flag, "--target") && arg_i + 1 < argc {
                    let targ = get_arg(arg_i + 1)
                    if cli_arg_eq(targ, "x86_64-windows") {
                        TARGET_OS = 3
                        TARGET_ARCH = 0
                    } else {
                        if cli_arg_eq(targ, "x86_64-macos") {
                            TARGET_OS = 2
                            TARGET_ARCH = 0
                        } else {
                            if cli_arg_eq(targ, "aarch64-macos") {
                                TARGET_OS = 2
                                TARGET_ARCH = 1
                            } else {
                                if cli_arg_eq(targ, "aarch64-linux") {
                                    TARGET_OS = 0
                                    TARGET_ARCH = 1
                                }
                            }
                        }
                    }
                    arg_i = arg_i + 1
                }
            }
        } } } } } } }
        arg_i = arg_i + 1
    }

    let raw = read_file(src)
    let sz = file_size(src)
    var i: i64 = 0
    while i < sz && i < 16777216 { SRC[i as usize] = str_char_at(raw, i) as i8; i = i + 1 }
    SRC_LEN = if sz < 16777216 { sz } else { 16777216 }
    MAIN_SRC_END = sz
    print("source: "); print(src); print(" "); print_int(sz); print(" bytes\n")
    resolve_imports()
    if IMPORT_RESOLUTION_FAILED != 0 { return 1 }
    strip_extern_blocks()
    append_native_prelude()
    print("total source: "); print_int(SRC_LEN); print(" bytes\n")
    if precheck_knightian_conflict() != 0 { return 1 }
    if precheck_temporal_window_conflict() != 0 { return 1 }
    lex_all()
    if LEX_ERROR_LINE != 0 {
        print("lex error line ")
        print_int(LEX_ERROR_LINE)
        print(": ")
        if LEX_ERROR_KIND == 2 {
            print("invalid escape sequence\n")
        } else {
            print("Unexpected character\n")
        }
        return 1
    }
    print("tokens: "); print_int(TC); print("\n")
    var cr: i64 = 0
    if TARGET_ARCH == 1 {
        cr = compile_all_arm64()
    } else {
        cr = compile_all()
    }
    if cr != 0 { return cr }
    if TARGET_ARCH == 1 {
        if TARGET_OS == 2 {
            write_macho_arm64(out)
        } else {
            write_elf_arm64(out)
        }
    } else if TARGET_OS == 3 {
        write_pe(out)
    } else if TARGET_OS == 2 {
        write_macho_x86(out)
    } else {
        write_elf(out)
    }
    return 0
}
