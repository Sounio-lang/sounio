            if bl == 10 && bh == 10138972 { EP = EP + 1; compile_or(); em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xc0); em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 1; EXPR_TY = 2; return }
            // User function call
            let fi = ident_fi
            let call_vslot = var_find(ns, ne)
            var call_sig: i64 = 0
            var call_is_closure: i64 = 0
            if call_vslot >= 0 && var_find_ty(ns, ne) == 9 {
                call_sig = var_find_ty_hash(ns, ne)
                call_is_closure = var_find_is_closure(ns, ne)
            }
            let call_tok = EP - 1
            EP = EP + 1
            var argc: i64 = 0
            var abi_argc: i64 = 0
            var call_min_conf: i64 = 1000
            while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
                compile_or()
                if EXPR_CONFIDENCE < call_min_conf { call_min_conf = EXPR_CONFIDENCE }
                if fi >= 0 {
                    scan_fn_param_type(fi, argc)
                } else if call_sig > 0 {
                    scan_fnsig_param_type(call_sig, argc)
                } else {
                    SCAN_TY = 0
                    SCAN_TY_HASH = 0
                }
                if (SCAN_TY != 0 || SCAN_TY_HASH != 0) && call_arg_type_compatible(SCAN_TY, SCAN_TY_HASH, EXPR_TY, EXPR_TY_HASH) == false {
                    if type_has_knowledge(SCAN_TY, SCAN_TY_HASH) || type_has_knowledge(EXPR_TY, EXPR_TY_HASH) {
                        tc_epistemic_boundary(call_tok)
                    } else {
                        let ont_r = try_tc_ontology_call_error(call_tok, SCAN_TY_HASH, EXPR_TY_HASH)
                        if ont_r == 0 { tc_linear_violation(call_tok, "error[E001]: Type mismatch in call argument — declared type does not match") }
                    }
                }
                // Observation boundary: passing Unobserved<T> to non-Unobserved parameter
                if ty_is_unobserved(EXPR_TY) && !ty_is_unobserved(SCAN_TY) && SCAN_TY != 0 && (FN_EFFECTS[CURRENT_FN as usize] & 64) == 0 {
                    tc_observe_boundary(call_tok, "cannot pass Unobserved<T> to non-Unobserved parameter")
                }
                // Mark struct variable as moved when passed by value to a function
                // Only linear/affine structs are moved; non-linear structs are implicitly copied
                if EXPR_TY == 6 && LAST_EXPR_VAR_IDX >= 0 {
                    if VAR_LINEAR[LAST_EXPR_VAR_IDX as usize] == 1 || VAR_AFFINE[LAST_EXPR_VAR_IDX as usize] == 1 {
                        if VAR_BORROW_COUNT[LAST_EXPR_VAR_IDX as usize] > 0 {
                            tc_linear_violation(call_tok, "cannot move while borrowed")
                        }
                        VAR_MOVED[LAST_EXPR_VAR_IDX as usize] = 1
                    }
                }
                if (fi >= 0 || (call_sig > 0 && call_is_closure == 0)) && type_is_slice_ref(SCAN_TY, SCAN_TY_HASH) {
                    emit_push_expr_as_slice_arg_x86(call_tok)
                    abi_argc = abi_argc + 2
                } else {
                    materialize_aggregate_expr_x86()
                    em(0x50)
                    // GUM: copy argument variance to transfer area
                    emit_variance_to_xfer_x86(argc, EXPR_VAR_SLOT)
                    abi_argc = abi_argc + 1
                }
                argc = argc + 1
                if TK[EP as usize] == 28 { EP = EP + 1 }
            }
            if TK[EP as usize] == 7 { EP = EP + 1 }
            if fi >= 0 {
                if FN_ARITY[fi as usize] != argc { tc_wrong_arity(call_tok, FN_ARITY[fi as usize], argc) }
                let callee_eff = FN_EFFECTS[fi as usize] & 1023  // mask out visibility bits
                let caller_eff = FN_EFFECTS[CURRENT_FN as usize] & 1023
                if effect_mask_is_subset(callee_eff, caller_eff) == false {
                    tc_effect_call_violation(call_tok, callee_eff, caller_eff)
                }
                // Epistemic confidence gate: reject if arguments below callee's minconf
                if FN_EPIST_MINCONF[fi as usize] > 0 && call_min_conf < FN_EPIST_MINCONF[fi as usize] {
                    print("error[E180]: confidence gate violation — argument confidence ")
                    print_int(call_min_conf)
                    print("/1000 below required ")
                    print_int(FN_EPIST_MINCONF[fi as usize])
                    print("/1000 at line ")
                    print_int(TL[call_tok as usize])
                    print("\n")
                    TYPECHECK_FAILED = 1
                }
                // Visibility check: imported non-pub function called from main module
                let callee_is_import = (FN_EFFECTS[fi as usize] & 2048) != 0
                let callee_is_pub = (FN_EFFECTS[fi as usize] & 1024) != 0
                let caller_is_main = (FN_EFFECTS[CURRENT_FN as usize] & 2048) == 0
                if callee_is_import && !callee_is_pub && caller_is_main {
                    tc_error(call_tok, "cannot call non-pub function from imported module")
                }
                if FN_IS_KERNEL[fi as usize] != 0 {
                    emit_kernel_dispatch_x86(fi, abi_argc)
                } else if FN_IS_ASYNC[fi as usize] != 0 {
                    if ret_agg_nslots(FN_RET_TY[fi as usize], FN_RET_HASH[fi as usize]) > 0 {
                        tc_error(call_tok, "async aggregate results not yet supported")
                        emit_drop_call_args_x86(abi_argc)
                        em(0x31); em(0xc0)
                    } else {
                        emit_async_direct_fn_call_x86(fi, abi_argc)
                    }
                } else {
                    // Epistemic gate: emit marker for uncertain calls
                    if EXPR_GATE[call_tok as usize] == 1 {
                        // Guarded call — emit 2-byte NOP (66 90) as epistemic marker
                        em(0x66); em(0x90)
                        EPIST_GATES_GUARDED = EPIST_GATES_GUARDED + 1
                    } else {
                        EPIST_GATES_DIRECT = EPIST_GATES_DIRECT + 1
                    }
                    emit_direct_fn_call_x86(fi, abi_argc)
                }
                if FN_IS_ASYNC[fi as usize] != 0 {
                    EXPR_TY = 13
                    EXPR_TY_HASH = task_hash_make(FN_RET_TY[fi as usize], FN_RET_HASH[fi as usize])
                    EXPR_IS_F64 = 0
                } else {
                    EXPR_TY = FN_RET_TY[fi as usize]
                    EXPR_TY_HASH = FN_RET_HASH[fi as usize]
                    if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                }
                EXPR_VAR_SLOT = -2  // return variance is in BSS_SCRATCH
                EXPR_CONFIDENCE = call_min_conf  // confidence can only degrade
            } else {
                if call_vslot >= 0 {
                    if call_sig > 0 && FNSIG_ARITY[call_sig as usize] != argc { tc_wrong_arity(call_tok, FNSIG_ARITY[call_sig as usize], argc) }
                    if call_is_closure == 1 {
                        emit_setup_closure_call_args_x86(argc)
                        emit_prepare_stack_call_args_x86(argc, 5)
                        emit_load_var(call_vslot)
                        em(0x48); em(0x89); em(0xc7)
                        em(0x48); em(0x8b); em(0x00)
                        em(0xff); em(0xd0)
                        emit_drop_call_args_x86(argc + call_extra_stack_args_x86(argc, 5))
                    } else {
                        emit_indirect_fn_call_x86(call_vslot, abi_argc, FNSIG_RET_TY[call_sig as usize], FNSIG_RET_HASH[call_sig as usize])
                    }
                    if call_sig > 0 {
                        EXPR_TY = FNSIG_RET_TY[call_sig as usize]
                        EXPR_TY_HASH = FNSIG_RET_HASH[call_sig as usize]
                    } else {
                        EXPR_TY = 0
                        EXPR_TY_HASH = 0
                    }
                    if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                } else {
                    tc_undefined_var(call_tok)
                    emit_drop_call_args_x86(abi_argc + call_extra_stack_args_x86(abi_argc, 6))
                    em(0x31); em(0xc0)
                    EXPR_IS_F64 = 0
                    EXPR_TY = 0
                    EXPR_TY_HASH = 0
                }
            }
            return
        }
        if TK[EP as usize] == 8 && src_match(ns, ne - ns, "Knowledge") {
            compile_knowledge_literal_x86()
            return
        }
        // Struct literal: StructName { field: val, ... }
        if TK[EP as usize] == 8 {
            let sh = gl_name_hash(ns, ne)
            let si = st_find(sh)
            if si >= 0 {
                EP = EP + 1  // skip {
                let total_slots = st_total_size(si) / 8
                let base_slot = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + total_slots
                // Parse field: value pairs
                while TK[EP as usize] != 9 && TK[EP as usize] != 0 {
                    if TK[EP as usize] == 3 {
                        let field_tok = EP
                        let fns = TS[EP as usize]
                        let fne = TE[EP as usize]
                        let fh = gl_name_hash(fns, fne)
                        EP = EP + 1  // skip field name
                        if TK[EP as usize] == 43 { EP = EP + 1 }  // skip :
                        let foff = st_field_offset(si, fh)
                        let fty = st_field_ty(si, fh)
                        let fhash = st_field_hash(si, fh)
                        if foff >= 0 {
                            let dst_start = base_slot + total_slots - 1 - foff / 8
                            if fty == 8 && TK[EP as usize] == 41 && array_init_is_repeat(EP) {
                                EP = EP + 1
                                compile_or()
                                if ty_eq(arr_hash_elem_ty(fhash), 0, EXPR_TY, EXPR_TY_HASH) == false {
                                    tc_error(field_tok, "array repeat element type does not match field type")
                                }
                                if TK[EP as usize] == 27 { EP = EP + 1 }
                                let rep_count = TV[EP as usize]
                                EP = EP + 1
                                if TK[EP as usize] == 42 { EP = EP + 1 }
                                if rep_count != arr_hash_alen(fhash) {
                                    tc_error(field_tok, "array repeat length does not match field type")
                                }
                                fill_repeat_struct_array_slots_x86(dst_start, fhash)
                            } else {
                                compile_or()
                                if fty != 0 && ty_eq(fty, fhash, EXPR_TY, EXPR_TY_HASH) == false {
                                    tc_error(field_tok, "field initializer type does not match struct field")
                                }
                                copy_agg_into_struct_slots_x86(dst_start, fty, fhash)
                            }
                        } else {
                            tc_error(field_tok, "unknown field in struct literal")
                            compile_or()  // advance EP past the value to avoid infinite loop
                        }
                    } else {
                        // Non-identifier token in struct literal body — skip to prevent infinite loop
                        EP = EP + 1
                    }
                    if TK[EP as usize] == 28 { EP = EP + 1 }  // skip comma
                }
                if TK[EP as usize] == 9 { EP = EP + 1 }  // skip }
                // lea rax, [rbp - (base_slot+total_slots-1)*8] — pointer to struct data (lowest addr)
                em(0x48); em(0x8d); em(0x85)
                em32(0 - (base_slot + total_slots - 1) * 8)
                EXPR_IS_F64 = 0
                // Convert Knowledge struct literal to epistemic Knowledge type
                if sh == knowledge_struct_hash() {
                    EXPR_TY = 0
                    EXPR_TY_HASH = knowledge_hash_make(ST_FTY[(si * 128) as usize], ST_FHASH[(si * 128) as usize], -2)
                } else {
                    EXPR_TY = 6
                    EXPR_TY_HASH = sh
                }
                // Track if this struct is linear/affine
                LAST_EXPR_IS_LINEAR = ST_LINEAR[si as usize]
                LAST_EXPR_IS_AFFINE = ST_AFFINE[si as usize]
                return
            }
        }
        // Array subscript: IDENT[expr]
        if TK[EP as usize] == 41 {
            EP = EP + 1  // skip [
            compile_or()  // index in rax
            if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }  // skip 'as usize'
            if TK[EP as usize] == 42 { EP = EP + 1 }  // skip ]
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                let base = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                let esz = GL[(gi * 4 + 2) as usize]
                var elem_ty = arr_hash_elem_ty(GL_TY_HASH[gi as usize])
                if elem_ty == 0 { elem_ty = 1 }
                if esz == 8 {
                    // mov rcx, rax; mov rax, base; mov rax, [rax + rcx*8]
                    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (index)
                    em(0x48); em(0xb8); em64(base)  // mov rax, base
                    em(0x48); em(0x8b); em(0x04); em(0xc8)  // mov rax, [rax + rcx*8]
                    EXPR_TY = elem_ty
                    EXPR_TY_HASH = 0
                    if elem_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                } else {
                    // i8 array: movsx rax, byte [rax + rcx]
                    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax
                    em(0x48); em(0xb8); em64(base)  // mov rax, base
                    em(0x48); em(0x0f); em(0xbe); em(0x04); em(0x08)  // movsx rax, byte [rax + rcx]
                    EXPR_TY = 1
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 0
                }
            } else {
                // Local pointer subscript: ptr[idx] → load ptr from stack, add index
                let slot = var_find(ns, ne)
                if slot >= 0 {
                    let lalen = var_find_alen(ns, ne)
                    let lesiz = var_find_esiz(ns, ne)
                    let lvi = var_find_idx(ns, ne)
                    var elem_ty = 1
                    var is_arr_ty = 0
                    var is_slice_ty = 0
                    if lvi >= 0 {
                        elem_ty = arr_hash_elem_ty(VAR_TY_HASH[lvi as usize])
                        if elem_ty == 0 { elem_ty = 1 }
                        if VAR_TY[lvi as usize] == 8 { is_arr_ty = 1 }
                        // &! [T; N] reference param: VAR_TY==10, inner type is array (ty==8)
                        if VAR_TY[lvi as usize] == 10 {
                            if ref_hash_inner_ty(VAR_TY_HASH[lvi as usize]) == 8 {
                                is_arr_ty = 1
                                if type_is_slice_ref(VAR_TY[lvi as usize], VAR_TY_HASH[lvi as usize]) { is_slice_ty = 1 }
                                if arr_hash_elem_ty(ref_hash_inner_hash(VAR_TY_HASH[lvi as usize])) != 0 {
                                    elem_ty = arr_hash_elem_ty(ref_hash_inner_hash(VAR_TY_HASH[lvi as usize]))
                                }
                            }
                        }
                    }
                    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (index)
                    if is_slice_ty == 1 {
                        emit_load_var(VAR_LEN_SLOT[lvi as usize])
                        em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
                        em(0x0f); em(0x82); let slice_ok_local = CL; em32(0)
                        emit_assert_fail()
                        let slice_ok_local_target = CL
                        patch32(slice_ok_local, slice_ok_local_target)
                    }
                    emit_load_var(slot)  // load ptr into rax
                    if is_arr_ty == 1 && lesiz == 8 {
                        em(0x48); em(0x8b); em(0x04); em(0xc8)  // mov rax, [rax + rcx*8]
                        EXPR_TY = elem_ty
                        EXPR_TY_HASH = 0
                        if elem_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                    } else if is_arr_ty == 1 && lesiz == 1 {
                        em(0x48); em(0x0f); em(0xbe); em(0x04); em(0x08)  // movsx rax, byte [rax + rcx]
                        EXPR_TY = 1
                        EXPR_TY_HASH = 0
                        EXPR_IS_F64 = 0
                    } else {
                        // Non-array local pointer (e.g. read_file result): byte access
                        em(0x48); em(0x0f); em(0xbe); em(0x04); em(0x08)  // movsx rax, byte [rax + rcx]
                        EXPR_TY = 1
                        EXPR_TY_HASH = 0
                        EXPR_IS_F64 = 0
                    }
                } else {
                    tc_undefined_var(name_tok)
                    em(0x31); em(0xc0)
                    EXPR_TY = 0
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 0
                }
            }
            return
        }
        // Variable load (local first, then global)
        let slot = var_find(ns, ne)
        if slot >= 0 {
            let vi = var_find_idx(ns, ne)
            if vi >= 0 && type_is_slice_ref(VAR_TY[vi as usize], VAR_TY_HASH[vi as usize]) {
                emit_lea_var(slot)
            } else {
                emit_load_var(slot)
            }
            EXPR_VAR_SLOT = slot
            // β² fix: restore expression hash from variable's stored derivation
            if slot >= 0 && slot < 1024 {
                EXPR_VARIANCE_HASH = VAR_VARIANCE_HASH[slot as usize]
            } else {
                EXPR_VARIANCE_HASH = 0
            }
            if vi >= 0 { EXPR_CONFIDENCE = VAR_CONFIDENCE[vi as usize] }
            EXPR_IS_F64 = var_find_is_f64(ns, ne)
            if vi >= 0 {
                EXPR_TY = VAR_TY[vi as usize]
                EXPR_TY_HASH = VAR_TY_HASH[vi as usize]
                if VAR_ALEN[vi as usize] > 0 { LAST_ALEN = VAR_ALEN[vi as usize] }
                if VAR_IS_CLOSURE[vi as usize] == 1 { LAST_EXPR_IS_CLOSURE = 1 }
            }
            // Use-after-move check: only for linear/affine struct variables
            if vi >= 0 && VAR_MOVED[vi as usize] == 1 && (VAR_LINEAR[vi as usize] == 1 || VAR_AFFINE[vi as usize] == 1) {
                if VAR_LINEAR[vi as usize] == 1 {
                    tc_linear_violation(EP - 1, "linear value used after move")
                } else {
                    tc_linear_violation(EP - 1, "use of moved value")
                }
            }
            // Track struct variable index for move marking at call site
            if vi >= 0 && VAR_TY[vi as usize] == 6 { LAST_EXPR_VAR_IDX = vi }
            // Track unit for dimension checking at + and -
            if vi >= 0 { EXPR_UNIT = VAR_UNIT[vi as usize] } else { EXPR_UNIT = 0 }
            var_mark_used(ns, ne)
            // Linear variable consumed inside a loop — would be consumed multiple times
            if vi >= 0 && VAR_LINEAR[vi as usize] == 1 && LOOP_DEPTH > 0 {
                tc_linear_violation(EP - 1, "linear value consumed in loop body")
            }
            // Affine variable used more than once
            if vi >= 0 && VAR_AFFINE[vi as usize] == 1 && VAR_USED[vi as usize] > 1 {
                tc_linear_violation(EP - 1, "affine value used more than once")
            }
        }
        else {
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                em(0x48); em(0xb8); em64(GL_BSS_BASE + GL[(gi * 4 + 1) as usize])  // mov rax, addr
                if GL[(gi * 4 + 3) as usize] == 0 {
                    em(0x48); em(0x8b); em(0x00)  // scalar: mov rax, [rax] (dereference)
                }
                EXPR_TY = GL_TY[gi as usize]
                EXPR_TY_HASH = GL_TY_HASH[gi as usize]
                // array: rax = address (no dereference — used as pointer)
            } else {
                // Named function reference: materialize a tiny direct-ABI wrapper.
                let fri = fn_find(TS[(EP - 1) as usize], TE[(EP - 1) as usize])
                if fri >= 0 {
                    em(0xe9)
                    em32(6)  // skip over `call rel32; ret`
                    em(0xe8)
                    if FN_OFF[fri as usize] >= 0 {
                        em32(FN_OFF[fri as usize] - (CL + 4))
                    } else {
                        PATCH_OFF[PATCH_COUNT as usize] = CL
                        PATCH_FN[PATCH_COUNT as usize] = fri
                        PATCH_KIND[PATCH_COUNT as usize] = 0
                        PATCH_COUNT = PATCH_COUNT + 1
                        em32(0)
                    }
                    em(0xc3)
                    em(0x48); em(0x8d); em(0x05)
                    em32(-13)  // lea back to wrapper start
                    EXPR_TY = 9
                    EXPR_TY_HASH = FN_SIG[fri as usize]
                    LAST_EXPR_IS_CLOSURE = 0
                } else {
                    if const_find_val(ns, ne) != 0 {
                        if CONST_FOUND_VAL == 0 { em(0x31); em(0xc0) }
                        else { em(0x48); em(0xb8); em64(CONST_FOUND_VAL) }
                        EXPR_TY = 1; EXPR_TY_HASH = 0; EXPR_IS_F64 = 0
                        return
                    }
                    // True undefined variable: not local, not global, not fn, not const
                    print("error[E200] at line ")
                    print_int(TL[name_tok as usize])
                    print(": undefined variable\n")
                    TYPECHECK_FAILED = 1
                    em(0x31); em(0xc0)
                    EXPR_TY = 0
                    EXPR_TY_HASH = 0
                }
            }
            EXPR_IS_F64 = 0
        }
        return
    }
    EP = EP + 1
    em(0x31); em(0xc0)
    EXPR_IS_F64 = 0
}

// Postfix: `as` type casts, `.field` access
fn compile_postfix() with IO, Mut, Panic, Div {
    compile_primary()
    compile_postfix_tail()
}

fn compile_postfix_tail() with IO, Mut, Panic, Div {
    var more: i64 = 1
    while more == 1 {
        if TK[EP as usize] == 37 {
            EP = EP + 1  // skip 'as'
            let tp = EP
            let src_ty = EXPR_TY
            let src_hash = EXPR_TY_HASH
            let src_is_f64 = EXPR_IS_F64
            let tns = TS[EP as usize]
            let tne = TE[EP as usize]
            scan_type(tp)
            var cast_ty = SCAN_TY
            var cast_hash = SCAN_TY_HASH
            if cast_ty == 0 && name_is_lower(tns, tne) {
                cast_ty = 2
                cast_hash = gl_name_hash(tns, tne)
            }
            // E171: cannot cast Knowledge<T> to its inner type via `as`
            if knowledge_hash_is(src_hash) && !knowledge_hash_is(cast_hash) {
                tc_epistemic_cast_blocked(tp)
            }
            if src_ty == 2 && cast_ty == 2 && src_hash != 0 && cast_hash != 0 && src_hash != cast_hash {
                tc_error(tp, "incompatible unit dimensions")
            }
            if cast_ty == 1 && src_is_f64 == 1 {
                em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc0)
                em(0xf2); em(0x48); em(0x0f); em(0x2c); em(0xc0)
            }
            if cast_ty == 2 && src_is_f64 == 0 {
                em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xc0)
                em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
            }
            if cast_ty == 1 && tne - tns == 2 && sb(tns) == 105 && sb(tns+1) == 56 {
                em(0x48); em(0x0f); em(0xbe); em(0xc0)  // as i8: movsx rax, al
            }
            // integer/unit as string: no conversion emitted; leave EXPR_TY as-is so
            // print/println dispatch to emit_print_int rather than emit_print_cstr
            if cast_ty == 3 && src_is_f64 == 0 { EP = SCAN_TY_NEXT; continue }
            EXPR_TY = cast_ty
            EXPR_TY_HASH = cast_hash
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
            EP = SCAN_TY_NEXT
            continue
        }
        if TK[EP as usize] == 41 {
            let base_ty = EXPR_TY
            let base_hash = EXPR_TY_HASH
            emit_push()
            EP = EP + 1
            compile_or()
            if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
            if TK[EP as usize] == 42 { EP = EP + 1 }
            em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (index)
            em(0x59)  // pop rcx (base pointer)
            if base_ty == 8 {
                let esiz = arr_hash_esiz(base_hash)
                var elem_ty = arr_hash_elem_ty(base_hash)
                if elem_ty == 0 { elem_ty = 1 }
                LAST_ALEN = arr_hash_alen(base_hash)
                if esiz == 8 {
                    em(0x48); em(0x8b); em(0x04); em(0xd1)  // mov rax, [rcx + rdx*8]
                    EXPR_TY = elem_ty
                    EXPR_TY_HASH = 0
                    if elem_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                } else {
                    em(0x48); em(0x0f); em(0xbe); em(0x04); em(0x11)  // movsx rax, byte [rcx + rdx]
                    EXPR_TY = 1
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 0
                }
            } else if type_is_slice_ref(base_ty, base_hash) {
                let inner_hash = ref_hash_inner_hash(base_hash)
                let esiz = arr_hash_esiz(inner_hash)
                var elem_ty = arr_hash_elem_ty(inner_hash)
                if elem_ty == 0 { elem_ty = 1 }
                em(0x48); em(0x8b); em(0x41); em(8)  // mov rax, [rcx + 8] (len)
                em(0x48); em(0x39); em(0xc2)         // cmp rdx, rax
                em(0x0f); em(0x82); let slice_ok = CL; em32(0)
                emit_assert_fail()
                let slice_ok_target = CL
                patch32(slice_ok, slice_ok_target)
                em(0x48); em(0x8b); em(0x01)         // mov rax, [rcx] (data ptr)
                if esiz == 8 {
                    em(0x48); em(0x8b); em(0x04); em(0xd0)  // mov rax, [rax + rdx*8]
                    EXPR_TY = elem_ty
                    EXPR_TY_HASH = 0
                    if elem_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                } else {
                    em(0x48); em(0x0f); em(0xbe); em(0x04); em(0x10)  // movsx rax, byte [rax + rdx]
                    EXPR_TY = 1
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 0
                }
            } else {
                em(0x48); em(0x0f); em(0xbe); em(0x04); em(0x11)  // movsx rax, byte [rcx + rdx]
                EXPR_TY = 1
                EXPR_TY_HASH = 0
                EXPR_IS_F64 = 0
            }
            continue
        }
        if TK[EP as usize] == 50 {
            EP = EP + 1  // skip '.'
            let method_tok = EP
            let fns = TS[EP as usize]
            let fne = TE[EP as usize]
            let fh = gl_name_hash(fns, fne)
            if src_match(fns, fne - fns, "await") {
                EP = EP + 1
                if (FN_EFFECTS[CURRENT_FN as usize] & 32) == 0 { tc_effect_violation(method_tok, 32, FN_EFFECTS[CURRENT_FN as usize]) }
                if EXPR_TY == 13 && task_hash_is(EXPR_TY_HASH) {
                    let inner_ty = task_hash_inner_ty(EXPR_TY_HASH)
                    let inner_hash = task_hash_inner_hash(EXPR_TY_HASH)
                    emit_task_await_x86()
                    if type_is_aggregate(inner_ty, inner_hash) {
                        tc_error(method_tok, "await for aggregate task results not yet supported")
                        EXPR_TY = 0
                        EXPR_TY_HASH = 0
                        EXPR_IS_F64 = 0
                    } else {
                        EXPR_TY = inner_ty
                        EXPR_TY_HASH = inner_hash
                        if inner_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                    }
                    continue
                }
                tc_error(method_tok, "await requires TaskHandle value")
                continue
            }
            // Built-in .len() only applies to arrays and slice refs. Structs that
            // define their own len() method must go through normal method lookup.
            if src_match(fns, fne - fns, "len") && TK[(EP + 1) as usize] == 6 && TK[(EP + 2) as usize] == 7 &&
               (EXPR_TY == 8 || type_is_slice_ref(EXPR_TY, EXPR_TY_HASH)) {
                EP = EP + 1  // skip 'len'
                EP = EP + 1  // skip (
                EP = EP + 1  // skip )
                if type_is_slice_ref(EXPR_TY, EXPR_TY_HASH) {
                    em(0x48); em(0x8b); em(0x40); em(8)  // mov rax, [rax + 8]
                } else {
                    // Emit: mov rax, LAST_ALEN (compile-time constant)
                    em(0x48)
                    em(0xb8)
                    em64(LAST_ALEN)
                }
                EXPR_TY = 1
                EXPR_TY_HASH = 0
                EXPR_IS_F64 = 0
                continue
            }
            // Built-in .unwrap(reason) — extract .value field (offset 0) from struct
            if src_match(fns, fne - fns, "unwrap") && TK[(EP + 1) as usize] == 6 {
                // E170: unwrap on Knowledge<T> requires `with Epistemic`
                if knowledge_hash_is(EXPR_TY_HASH) && (FN_EFFECTS[CURRENT_FN as usize] & 512) == 0 {
                    tc_epistemic_value_access(method_tok)
                }
                EP = EP + 1  // skip 'unwrap'
                EP = EP + 1  // skip (
                // Skip all arguments until )
                var uw_depth: i64 = 1
                while uw_depth > 0 && EP < TC {
                    if TK[EP as usize] == 6 { uw_depth = uw_depth + 1 }
                    if TK[EP as usize] == 7 { uw_depth = uw_depth - 1 }
                    if uw_depth > 0 { EP = EP + 1 }
                }
                if TK[EP as usize] == 7 { EP = EP + 1 }  // skip )
                // rax = struct pointer. Load first field (.value at offset 0)
                em(0x48)
                em(0x8b)
                em(0x00)  // mov rax, [rax]
                // Try to determine type from struct
                if knowledge_hash_is(EXPR_TY_HASH) {
                    let inner_hash = knowledge_hash_inner_hash(EXPR_TY_HASH)
                    EXPR_TY = knowledge_hash_inner_ty(EXPR_TY_HASH)
                    EXPR_TY_HASH = inner_hash
                    if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                } else if EXPR_TY == 6 {
                    let uw_si = st_find(EXPR_TY_HASH)
                    if uw_si >= 0 {
                        // Get type of first field (value)
                        EXPR_TY = ST_FTY[(uw_si * 128) as usize]
                        EXPR_TY_HASH = ST_FHASH[(uw_si * 128) as usize]
                        if EXPR_TY == 2 { EXPR_IS_F64 = 1 }
                    }
                }
                continue
            }
            // Math intrinsic methods: val.sqrt(), val.exp(), val.ln(), val.sin(), val.cos(), val.tanh(), val.abs(), val.floor()
            if TK[(EP + 1) as usize] == 6 && TK[(EP + 2) as usize] == 7 {
                var is_math_mm: i64 = 0
                var math_mm_fi: i64 = -1
                if src_match(fns, fne - fns, "sqrt") { is_math_mm = 1; math_mm_fi = fn_find_lit("__native_sqrt_f64") }
                if src_match(fns, fne - fns, "exp") { is_math_mm = 1; math_mm_fi = fn_find_lit("__native_exp_f64") }
                if src_match(fns, fne - fns, "ln") || src_match(fns, fne - fns, "log") { is_math_mm = 1; math_mm_fi = fn_find_lit("__native_ln_f64") }
                if src_match(fns, fne - fns, "sin") { is_math_mm = 1; math_mm_fi = fn_find_lit("__native_sin_f64") }
                if src_match(fns, fne - fns, "cos") { is_math_mm = 1; math_mm_fi = fn_find_lit("__native_cos_f64") }
                if src_match(fns, fne - fns, "tanh") { is_math_mm = 1; math_mm_fi = fn_find_lit("__native_tanh_f64") }
                if src_match(fns, fne - fns, "abs") { is_math_mm = 1; math_mm_fi = fn_find_lit("__native_abs_f64") }
                if src_match(fns, fne - fns, "floor") { is_math_mm = 1; math_mm_fi = fn_find_lit("__native_floor_f64") }
                if is_math_mm == 1 {
                    EP = EP + 1  // skip method name
                    EP = EP + 1  // skip (
                    EP = EP + 1  // skip )
                    if math_mm_fi >= 0 {
                        emit_push()
                        emit_direct_fn_call_x86(math_mm_fi, 1)
                    } else {
                        tc_error(method_tok, "missing native math helper")
                        em(0x31); em(0xc0)
                        EXPR_IS_F64 = 0
                        EXPR_TY = 0
                        EXPR_TY_HASH = 0
                    }
                    EXPR_IS_F64 = 1
                    EXPR_TY = 2
                    EXPR_TY_HASH = 0
                    continue
                }
            }
            // Method call: obj.method(args) → method(obj, args)
            if TK[(EP + 1) as usize] == 6 {
                var recv_h = EXPR_TY_HASH
                if EXPR_TY == 10 {
                    recv_h = ref_hash_inner_hash(EXPR_TY_HASH)
                }
                let mfi = fn_find_method(fns, fne, recv_h)
                if mfi >= 0 {
                    EP = EP + 1  // skip method name
                    EP = EP + 1  // skip (
                    // Check if method expects a borrowed receiver
                    scan_fnsig_param_type(FN_SIG[mfi as usize], 0)
                    let method_expects_borrow = (SCAN_TY == 10)
                    // Struct expressions already lower to aggregate pointers on x86,
                    // so auto-borrow for method receivers can pass rax through directly.
                    if method_expects_borrow && EXPR_TY == 6 {
                        // no-op: rax already holds the aggregate address
                    } else if method_expects_borrow && EXPR_TY == 10 {
                        // Receiver is already a borrow, pass as-is
                        // rax already contains the pointer
                    } else {
                        // Pass by value - materialize if aggregate
                        materialize_aggregate_expr_x86()
                    }
                    em(0x50)  // push self
                    var margc: i64 = 1
                    while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
                        compile_or()
                        materialize_aggregate_expr_x86()
                        em(0x50)
                        margc = margc + 1
                        if TK[EP as usize] == 28 { EP = EP + 1 }
                    }
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                    if FN_ARITY[mfi as usize] != margc { tc_wrong_arity(method_tok, FN_ARITY[mfi as usize], margc) }
                    emit_direct_fn_call_x86(mfi, margc)
                    EXPR_TY = FN_RET_TY[mfi as usize]
                    EXPR_TY_HASH = FN_RET_HASH[mfi as usize]
                    if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                    continue
                }
            }
            // Field access: rax = struct pointer, load field
            let base_ty = EXPR_TY
            let base_hash = EXPR_TY_HASH
            var base_data_ty = base_ty
            var base_data_hash = base_hash
            if base_ty == 10 {
                base_data_ty = ref_hash_inner_ty(base_hash)
                base_data_hash = ref_hash_inner_hash(base_hash)
            }
            EP = EP + 1
            var found: i64 = 0
            EXPR_TY = 0
            EXPR_TY_HASH = 0
            if knowledge_hash_is(base_data_hash) {
                if src_match(fns, fne - fns, "value") {
                    // E170: accessing .value on Knowledge<T> requires `with Epistemic`
                    if (FN_EFFECTS[CURRENT_FN as usize] & 512) == 0 {
                        tc_epistemic_value_access(method_tok)
                    }
                    // GUM seed: extract variance from Knowledge struct → BSS_SCRATCH
                    let val_src_slot = EXPR_VAR_SLOT
                    if val_src_slot >= 0 && val_src_slot < 1024 {
                        if KNOWLEDGE_CHANNEL_FOR_SLOT[val_src_slot as usize] == 0 {
                            KNOWLEDGE_CHANNEL_FOR_SLOT[val_src_slot as usize] = NEXT_BUDGET_PARAM + 1
                            NEXT_BUDGET_PARAM = NEXT_BUDGET_PARAM + 1
                        }
                        emit_seed_variance_from_knowledge_to_channel_x86(KNOWLEDGE_CHANNEL_FOR_SLOT[val_src_slot as usize] - 1)
                    } else {
                        emit_seed_variance_from_knowledge_x86()
                        NEXT_BUDGET_PARAM = NEXT_BUDGET_PARAM + 1
                    }
                    em(0x48); em(0x8b); em(0x00)
                    EXPR_TY = knowledge_hash_inner_ty(base_data_hash)
                    EXPR_TY_HASH = knowledge_hash_inner_hash(base_data_hash)
                    if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                    EXPR_SCRATCH_SOURCE_SLOT = val_src_slot  // β fix Part B
                    if val_src_slot >= 0 { EXPR_VARIANCE_HASH = val_src_slot * 2 + 1 } else { EXPR_VARIANCE_HASH = 0 }
                    EXPR_VAR_SLOT = -2  // variance in scratch
                    // Confidence from Knowledge hash eps_scaled (or inherit from variable)
                    let val_eps = knowledge_hash_eps(base_data_hash)
                    if val_eps >= 0 {
                        EXPR_CONFIDENCE = 1000 - val_eps / 1000
                        if EXPR_CONFIDENCE < 0 { EXPR_CONFIDENCE = 0 }
                    }
                    // else: keep EXPR_CONFIDENCE from variable load (VAR_CONFIDENCE)
                } else if src_match(fns, fne - fns, "variance") {
                    em(0x48); em(0x8b); em(0x40); em(8)
                    EXPR_TY = 2
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 1
                } else if src_match(fns, fne - fns, "uncertainty") {
                    em(0x48); em(0x8b); em(0x40); em(8)
                    emit_sqrt_builtin_x86()
                    EXPR_TY = 2
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 1
                } else if src_match(fns, fne - fns, "confidence") {
                    em(0x48); em(0x8b); em(0x40); em(16)
                    EXPR_TY = 2
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 1
                } else {
                    tc_error(method_tok, "unknown field access")
                    em(0x31); em(0xc0)
                    EXPR_IS_F64 = 0
                }
                found = 1
            }
            if base_data_ty == 6 {
                let bsi = st_find(base_data_hash)
                if bsi >= 0 {
                    let off = st_field_offset(bsi, fh)
                    if off >= 0 {
                        EXPR_TY = st_field_ty(bsi, fh)
                        EXPR_TY_HASH = st_field_hash(bsi, fh)
                        if EXPR_TY == 8 || EXPR_TY == 6 || knowledge_hash_is(EXPR_TY_HASH) {
                            if off != 0 { em(0x48); em(0x8d); em(0x80); em32(off) }
                        } else {
                            if off == 0 {
                                em(0x48); em(0x8b); em(0x00)
                            } else {
                                em(0x48); em(0x8b); em(0x80); em32(off)
                            }
                        }
                        if EXPR_TY == 8 { LAST_ALEN = arr_hash_alen(EXPR_TY_HASH) }
                    } else {
                        tc_error(method_tok, "unknown field access")
                        em(0x31); em(0xc0)
                    }
                    found = 1
                }
            }
            var si: i64 = 0
            while si < ST_COUNT && found == 0 {
                let off = st_field_offset(si, fh)
                if off >= 0 {
                    EXPR_TY = st_field_ty(si, fh)
                    EXPR_TY_HASH = st_field_hash(si, fh)
                    if EXPR_TY == 8 || EXPR_TY == 6 || knowledge_hash_is(EXPR_TY_HASH) {
                        if off != 0 { em(0x48); em(0x8d); em(0x80); em32(off) }
                    } else {
                        if off == 0 {
                            em(0x48); em(0x8b); em(0x00)
                        } else {
                            em(0x48); em(0x8b); em(0x80); em32(off)
                        }
                    }
                    if EXPR_TY == 8 { LAST_ALEN = arr_hash_alen(EXPR_TY_HASH) }
                    found = 1
                }
                si = si + 1
            }
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
            continue
        }
        more = 0
    }
}

fn compile_multiplicative() with IO, Mut, Panic, Div {
    compile_postfix()
    var lhs_end_line: i64 = TL[(EP - 1) as usize]
    while TK[EP as usize] == 19 || TK[EP as usize] == 20 || TK[EP as usize] == 29 {
        if EXPR_TY == 11 && TK[EP as usize] == 19 && TL[EP as usize] > lhs_end_line { return }
        let op_tok = EP
        let op = TK[EP as usize]
        EP = EP + 1
        let left_f64 = EXPR_IS_F64
        let left_ty = EXPR_TY
        let left_hash = EXPR_TY_HASH
        var mul_left_var_slot = EXPR_VAR_SLOT
        let mul_left_scratch_src = EXPR_SCRATCH_SOURCE_SLOT  // β fix Part B
        let mul_left_hash = EXPR_VARIANCE_HASH  // β² fix
        let mul_left_conf = EXPR_CONFIDENCE
        // β⁴: materialize left-scratch to a real slot so right's compile
        // doesn't overwrite it.
        if mul_left_var_slot == 0 - 2 {
            let mul_left_tmp = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_copy_scratch_to_var_variance_x86(mul_left_tmp)
            mul_left_var_slot = mul_left_tmp
        }
        emit_push()
        compile_postfix()
        let right_ty = EXPR_TY
        let right_hash = EXPR_TY_HASH
        let mul_right_var_slot = EXPR_VAR_SLOT
        let mul_right_scratch_src = EXPR_SCRATCH_SOURCE_SLOT  // β fix Part B
        let mul_right_hash = EXPR_VARIANCE_HASH  // β² fix
        if EXPR_CONFIDENCE > mul_left_conf { EXPR_CONFIDENCE = mul_left_conf }
        let left_has_knowledge = knowledge_hash_is(left_hash)
        let right_has_knowledge = knowledge_hash_is(right_hash)
        if op == 17 && left_ty == 3 && right_ty == 3 {
            BUILTIN_SLOT_B = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var(BUILTIN_SLOT_B)
            BUILTIN_SLOT_A = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            em(0x59)
            em(0x48); em(0x89); em(0xc8)  // mov rax, rcx
            emit_store_var(BUILTIN_SLOT_A)
            emit_str_concat_slots_x86(BUILTIN_SLOT_A, BUILTIN_SLOT_B)
            EXPR_IS_F64 = 0
            EXPR_TY = 3
            EXPR_TY_HASH = 0
            continue
        }
        if left_has_knowledge || right_has_knowledge {
            var left_inner_ty = left_ty
            var left_inner_hash = left_hash
            if left_has_knowledge {
                left_inner_ty = knowledge_hash_inner_ty(left_hash)
                left_inner_hash = knowledge_hash_inner_hash(left_hash)
            }
            var right_inner_ty = right_ty
            var right_inner_hash = right_hash
            if right_has_knowledge {
                right_inner_ty = knowledge_hash_inner_ty(right_hash)
                right_inner_hash = knowledge_hash_inner_hash(right_hash)
            }
            if op == 29 {
                tc_error(op_tok, "modulo requires integer operands")
            } else {
                if left_inner_ty != 0 && right_inner_ty != 0 {
                    if ty_is_numeric(left_inner_ty) == false || ty_is_numeric(right_inner_ty) == false || ty_eq(left_inner_ty, left_inner_hash, right_inner_ty, right_inner_hash) == false {
                        tc_error(op_tok, "Knowledge arithmetic requires matching numeric operands")
                    }
                }
            }
            compile_knowledge_muldiv_x86(op_tok, op, left_ty, left_hash, right_ty, right_hash)
            continue
        }
        if left_ty != 0 && right_ty != 0 {
            if op == 29 {
                if left_ty != 1 || right_ty != 1 { tc_error(op_tok, "modulo requires integer operands") }
            } else {
                if ty_is_numeric(left_ty) == false || ty_is_numeric(right_ty) == false || left_ty != right_ty {
                    tc_error(op_tok, "arithmetic operands must have matching numeric types")
                }
            }
        }
        em(0x59)  // pop rcx (lhs)
        if left_f64 == 1 {
            // f64: movq xmm0, rcx; movq xmm1, rax; SSE2 op; movq rax, xmm0
            em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1)  // movq xmm0, rcx
            em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)  // movq xmm1, rax
            if op == 19 { em(0xf2); em(0x0f); em(0x59); em(0xc1) }  // mulsd xmm0, xmm1
            if op == 20 { em(0xf2); em(0x0f); em(0x5e); em(0xc1) }  // divsd xmm0, xmm1
            if op == 29 {
                // modulo: no f64 path, fall back to integer
                em(0x48); em(0x87); em(0xc1); em(0x48); em(0x99); em(0x48); em(0xf7); em(0xf9); em(0x48); em(0x89); em(0xd0)
            }
            em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)  // movq rax, xmm0
            EXPR_IS_F64 = 1
            EXPR_TY = 2
        } else {
            em(0x48); em(0x87); em(0xc1)  // xchg rax, rcx — rax=lhs, rcx=rhs
            if op == 19 { em(0x48); em(0x0f); em(0xaf); em(0xc1) }  // imul rax, rcx
            if op == 20 { em(0x48); em(0x99); em(0x48); em(0xf7); em(0xf9) }  // cqo; idiv rcx
            if op == 29 { em(0x48); em(0x99); em(0x48); em(0xf7); em(0xf9); em(0x48); em(0x89); em(0xd0) }  // cqo; idiv rcx; mov rax, rdx
            EXPR_TY = 1
        }
        EXPR_TY_HASH = 0
        // Epistemic gate counting
        if EXPR_GATE[op_tok as usize] == 1 {
            emit_gate_guarded_inc_x86()
            EPIST_GATES_GUARDED = EPIST_GATES_GUARDED + 1
        } else {
            EPIST_GATES_DIRECT = EPIST_GATES_DIRECT + 1
        }
        // β⁴ forward-mode AD: chain rule via gate emit. Same-variant dispatch
        // retired — sensitivity arithmetic handles correlations naturally.
        if left_f64 == 1 && op != 29 && (mul_left_var_slot != -1 || mul_right_var_slot != -1 || EXPR_GATE[op_tok as usize] == 1) {
            emit_gate_variance_muldiv_x86(mul_left_var_slot, mul_right_var_slot, op)
            EXPR_VAR_SLOT = -2
            EXPR_SCRATCH_SOURCE_SLOT = 0 - 1
            EXPR_VARIANCE_HASH = 0
        }
        lhs_end_line = TL[(EP - 1) as usize]
    }
}

fn compile_additive() with IO, Mut, Panic, Div {
    compile_multiplicative()
    while TK[EP as usize] == 17 || TK[EP as usize] == 18 || TK[EP as usize] == 74 {
        let op_tok = EP
        let op = TK[EP as usize]
        EP = EP + 1
        // Array/string concatenation: ++ operator
        if op == 74 {
            let left_ty_pp = EXPR_TY
            let left_alen_pp = LAST_ALEN
            emit_push()  // save left array pointer (RAX) onto stack
            compile_multiplicative()  // right operand in RAX, LAST_ALEN updated
            let right_alen_pp = LAST_ALEN
            let total_len_pp = left_alen_pp + right_alen_pp
            if left_ty_pp == 3 {
                // String concatenation: ++ behaves like + for strings
                BUILTIN_SLOT_B = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var(BUILTIN_SLOT_B)  // save right str ptr
                BUILTIN_SLOT_A = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
                em(0x59); em(0x48); em(0x89); em(0xc8)  // pop rcx; mov rax, rcx (restore left)
                emit_store_var(BUILTIN_SLOT_A)  // save left str ptr
                emit_str_concat_slots_x86(BUILTIN_SLOT_A, BUILTIN_SLOT_B)
                EXPR_IS_F64 = 0; EXPR_TY = 3; EXPR_TY_HASH = 0
            } else if left_ty_pp == 8 && total_len_pp > 0 {
                // Array concatenation using rep movsq.
                // Array layout: pointer points to arr[0] = lowest address.
                // For N-element array starting at data_slot:
                //   arr[i] at rbp - (data_slot + N - 1 - i)*8
                //   pointer = rbp - (data_slot + N - 1)*8
                // Allocate: rhs_save slot, then total_len_pp data slots.
                let rhs_save = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var(rhs_save)   // save right array pointer
                let data_base = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + total_len_pp
                // Pointer to result[0] = rbp - (data_base + total_len_pp - 1)*8
                let res_disp = 0 - (data_base + total_len_pp - 1) * 8
                em(0x59)                              // pop rcx — left array pointer
                em(0x48); em(0x89); em(0xce)          // mov rsi, rcx (source = left[0])
                em(0x48); em(0x8d); em(0xbd); em32(res_disp)  // lea rdi, result[0]
                em(0xb9); em32(left_alen_pp)          // mov ecx, left_alen
                em(0xf3); em(0x48); em(0xa5)          // rep movsq (copies left to result[0..left_alen-1])
                // rdi now points to result[left_alen] = start of right section
                emit_load_var(rhs_save)               // rax = right array pointer
                em(0x48); em(0x89); em(0xc6)          // mov rsi, rax
                em(0xb9); em32(right_alen_pp)         // mov ecx, right_alen
                em(0xf3); em(0x48); em(0xa5)          // rep movsq (copies right to result[left_alen..])
                // Leave result pointer in RAX
                em(0x48); em(0x8d); em(0x85); em32(res_disp)  // lea rax, result[0]
                EXPR_TY = 8; LAST_ALEN = total_len_pp
                EXPR_TY_HASH = arr_ty_hash(total_len_pp, arr_hash_esiz(EXPR_TY_HASH), arr_hash_elem_ty(EXPR_TY_HASH))
            } else {
                em(0x59)  // pop and discard — unsupported type
            }
            continue
        }
        let left_f64 = EXPR_IS_F64
        let left_ty = EXPR_TY
        let left_hash = EXPR_TY_HASH
        let left_unit = EXPR_UNIT
        var left_var_slot = EXPR_VAR_SLOT
        let left_scratch_src = EXPR_SCRATCH_SOURCE_SLOT  // β fix Part B
        let left_vhash = EXPR_VARIANCE_HASH  // β² fix
        let left_conf = EXPR_CONFIDENCE
        // β⁴: materialize left-scratch to a real slot so right's compile
        // doesn't overwrite it.
        if left_var_slot == 0 - 2 {
            let left_tmp = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_copy_scratch_to_var_variance_x86(left_tmp)
            left_var_slot = left_tmp
        }
        emit_push()
        compile_multiplicative()
        let right_ty = EXPR_TY
        let right_hash = EXPR_TY_HASH
        let right_var_slot = EXPR_VAR_SLOT
        let right_scratch_src = EXPR_SCRATCH_SOURCE_SLOT  // β fix Part B
        let right_vhash = EXPR_VARIANCE_HASH  // β² fix
        if EXPR_CONFIDENCE > left_conf { EXPR_CONFIDENCE = left_conf }
        // Unit dimension mismatch check: both operands have units and they differ
        if left_unit != 0 && EXPR_UNIT != 0 && left_unit != EXPR_UNIT {
            tc_linear_violation(op_tok, "unit dimension mismatch")
        }
        if left_unit != 0 { EXPR_UNIT = left_unit }
        let left_has_knowledge = knowledge_hash_is(left_hash)
        let right_has_knowledge = knowledge_hash_is(right_hash)
        if op == 17 && left_ty == 3 && right_ty == 3 {
            BUILTIN_SLOT_B = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var(BUILTIN_SLOT_B)
            BUILTIN_SLOT_A = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            em(0x59)
            em(0x48); em(0x89); em(0xc8)  // mov rax, rcx
            emit_store_var(BUILTIN_SLOT_A)
            emit_str_concat_slots_x86(BUILTIN_SLOT_A, BUILTIN_SLOT_B)
            EXPR_IS_F64 = 0
            EXPR_TY = 3
            EXPR_TY_HASH = 0
        } else {
            if left_has_knowledge || right_has_knowledge {
                var left_inner_ty = left_ty
                var left_inner_hash = left_hash
                if left_has_knowledge {
                    left_inner_ty = knowledge_hash_inner_ty(left_hash)
                    left_inner_hash = knowledge_hash_inner_hash(left_hash)
                }
                var right_inner_ty = right_ty
                var right_inner_hash = right_hash
                if right_has_knowledge {
                    right_inner_ty = knowledge_hash_inner_ty(right_hash)
                    right_inner_hash = knowledge_hash_inner_hash(right_hash)
                }
                if left_inner_ty != 0 && right_inner_ty != 0 {
                    if ty_is_numeric(left_inner_ty) == false || ty_is_numeric(right_inner_ty) == false || ty_eq(left_inner_ty, left_inner_hash, right_inner_ty, right_inner_hash) == false {
                        tc_error(op_tok, "Knowledge arithmetic requires matching numeric operands")
                    }
                }
                compile_knowledge_addsub_x86(op_tok, op, left_ty, left_hash, right_ty, right_hash)
            } else {
                if left_ty != 0 && right_ty != 0 {
                    if ty_is_numeric(left_ty) == false || ty_is_numeric(right_ty) == false {
                        tc_error(op_tok, "arithmetic operands must have matching numeric types")
                    }
                    if ty_eq(left_ty, left_hash, right_ty, right_hash) == false {
                        if left_ty == 2 && right_ty == 2 { tc_error(op_tok, "unit mismatch") }
                        tc_error(op_tok, "arithmetic operands must have matching numeric types")
                    }
                }
                em(0x59)  // pop rcx (lhs)
                if left_f64 == 1 {
                    // f64: movq xmm0, rcx; movq xmm1, rax; SSE2 op; movq rax, xmm0
                    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1)  // movq xmm0, rcx
                    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)  // movq xmm1, rax
                    if op == 17 { em(0xf2); em(0x0f); em(0x58); em(0xc1) }  // addsd xmm0, xmm1
                    if op == 18 { em(0xf2); em(0x0f); em(0x5c); em(0xc1) }  // subsd xmm0, xmm1
                    em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)  // movq rax, xmm0
                    EXPR_IS_F64 = 1
                    EXPR_TY = 2
                } else {
                    if op == 17 { em(0x48); em(0x01); em(0xc8) }  // add rax, rcx (commutative: rcx+rax = ok)
                    if op == 18 { em(0x48); em(0x87); em(0xc1); em(0x48); em(0x29); em(0xc8) }  // xchg; sub rax, rcx
                    EXPR_TY = 1
                }
                if left_ty == 2 { EXPR_TY_HASH = left_hash } else { EXPR_TY_HASH = 0 }
                // Epistemic gate counting
                if EXPR_GATE[op_tok as usize] == 1 {
                    emit_gate_guarded_inc_x86()
                    EPIST_GATES_GUARDED = EPIST_GATES_GUARDED + 1
                } else {
                    EPIST_GATES_DIRECT = EPIST_GATES_DIRECT + 1
                }
                // β⁴ forward-mode AD variance propagation: sensitivity is sign-aware
                // so gate emit with op-dispatch gives correct answer for all cases
                // including correlated subtraction. β²'s same-variant special cases
                // are no longer needed — chain rule handles them naturally.
                if left_var_slot != -1 || right_var_slot != -1 || EXPR_GATE[op_tok as usize] == 1 {
                    emit_gate_variance_addsub_x86(left_var_slot, right_var_slot, op)
                    EXPR_VAR_SLOT = -2
                    EXPR_SCRATCH_SOURCE_SLOT = 0 - 1
                    EXPR_VARIANCE_HASH = 0  // β² hashes retired under β⁴
                }
            }
        }
    }
}

fn emit_kernel_cpu_direct_call_x86(fi: i64, abi_argc: i64) with Mut {
    emit_setup_direct_call_args_x86(abi_argc)
    emit_prepare_stack_call_args_x86(abi_argc, 6)
    em(0xe8)
    PATCH_OFF[PATCH_COUNT as usize] = CL
    PATCH_FN[PATCH_COUNT as usize] = fi
    PATCH_KIND[PATCH_COUNT as usize] = 0
    PATCH_COUNT = PATCH_COUNT + 1
    em32(0)
    emit_drop_call_args_x86(abi_argc + call_extra_stack_args_x86(abi_argc, 6))
}

fn gpu_param_kind_is_slice(kind: i64) -> bool {
    return kind == gpu_param_kind_slice_in_f64() || kind == gpu_param_kind_slice_out_f64()
}

fn gpu_param_role_needs_copy_in(role: i64) -> bool {
    return role == gpu_param_role_input() || role == gpu_param_role_inout()
}

fn gpu_param_role_needs_copy_out(role: i64) -> bool {
    return role == gpu_param_role_output() || role == gpu_param_role_inout()
}

fn emit_kernel_dispatch_vec_slice_f64_x86(fi: i64, abi_argc: i64) with Mut, Panic, Div {
    let kind1 = FN_PTX_PARAM_KINDS[(fi * 8 + 1) as usize]
    let kind2 = FN_PTX_PARAM_KINDS[(fi * 8 + 2) as usize]
    let kind3 = FN_PTX_PARAM_KINDS[(fi * 8 + 3) as usize]
    let role1 = FN_PTX_PARAM_ROLES[(fi * 8 + 1) as usize]
    let role2 = FN_PTX_PARAM_ROLES[(fi * 8 + 2) as usize]
    let role3 = FN_PTX_PARAM_ROLES[(fi * 8 + 3) as usize]

    NEEDS_GPU_RUNTIME_DYNLINK = 1
    emit_try_gpu_runtime_init_x86()
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84)
    let cpu_fallback = CL
    em32(0)

    let n_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let arg1_ptr_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let arg1_len_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let arg1_bytes_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let arg1_dptr_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let arg2_ptr_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let arg2_len_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let arg2_bytes_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let arg2_dptr_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let arg3_ptr_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let arg3_len_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let arg3_bytes_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let arg3_dptr_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let module_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let func_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let grid_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let param0_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let param1_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let param2_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let param3_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let paddr0_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let paddr1_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let paddr2_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let paddr3_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1

    emit_load_call_arg_to_rax_x86(abi_argc, 0); emit_store_var(n_slot)
    var abi_idx: i64 = 1
    if gpu_param_kind_is_slice(kind1) {
        emit_load_call_arg_to_rax_x86(abi_argc, abi_idx); emit_store_var(arg1_ptr_slot)
        emit_load_call_arg_to_rax_x86(abi_argc, abi_idx + 1); emit_store_var(arg1_len_slot)
        emit_load_var(arg1_len_slot)
        em(0x48); em(0xc1); em(0xe0); em(3)
        emit_store_var(arg1_bytes_slot)
        abi_idx = abi_idx + 2
    } else if kind1 != 0 {
        emit_load_call_arg_to_rax_x86(abi_argc, abi_idx); emit_store_var(param1_slot)
        abi_idx = abi_idx + 1
    }
    if gpu_param_kind_is_slice(kind2) {
        emit_load_call_arg_to_rax_x86(abi_argc, abi_idx); emit_store_var(arg2_ptr_slot)
        emit_load_call_arg_to_rax_x86(abi_argc, abi_idx + 1); emit_store_var(arg2_len_slot)
        emit_load_var(arg2_len_slot)
        em(0x48); em(0xc1); em(0xe0); em(3)
        emit_store_var(arg2_bytes_slot)
        abi_idx = abi_idx + 2
    } else if kind2 != 0 {
        emit_load_call_arg_to_rax_x86(abi_argc, abi_idx); emit_store_var(param2_slot)
        abi_idx = abi_idx + 1
    }
    if gpu_param_kind_is_slice(kind3) {
        emit_load_call_arg_to_rax_x86(abi_argc, abi_idx); emit_store_var(arg3_ptr_slot)
        emit_load_call_arg_to_rax_x86(abi_argc, abi_idx + 1); emit_store_var(arg3_len_slot)
        emit_load_var(arg3_len_slot)
        em(0x48); em(0xc1); em(0xe0); em(3)
        emit_store_var(arg3_bytes_slot)
    } else if kind3 != 0 {
        emit_load_call_arg_to_rax_x86(abi_argc, abi_idx); emit_store_var(param3_slot)
    }

    emit_load_var(n_slot)
    em(0x48); em(0x05); em32(255)
    em(0x48); em(0xc1); em(0xe8); em(8)
    emit_store_var(grid_slot)

    emit_lea_var(module_slot); em(0x50)
    emit_inline_cstr_from_ptx_x86(FN_PTX_OFF[fi as usize], FN_PTX_LEN[fi as usize]); em(0x50)
    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMODULELOADDATA_PTR_BSS_OFF, 2)
    em(0x85); em(0xc0); em(0x0f); em(0x85); let gpu_fail = CL; em32(0)

    emit_lea_var(func_slot); em(0x50)
    emit_load_var(module_slot); em(0x50)
    let name_tok = FN_NAME_TOK[fi as usize]
    emit_inline_cstr_from_src_x86(TS[name_tok as usize], TE[name_tok as usize]); em(0x50)
    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMODULEGETFUNCTION_PTR_BSS_OFF, 3)
    em(0x85); em(0xc0); em(0x0f); em(0x85); let gpu_fail_b = CL; em32(0)

    var gpu_fail_c: i64 = -1
    if gpu_param_kind_is_slice(kind1) {
        emit_lea_var(arg1_dptr_slot); em(0x50)
        emit_load_var(arg1_bytes_slot); em(0x50)
        emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMEMALLOC_PTR_BSS_OFF, 2)
        em(0x85); em(0xc0); em(0x0f); em(0x85); gpu_fail_c = CL; em32(0)
    }
    var gpu_fail_d: i64 = -1
    if gpu_param_kind_is_slice(kind2) {
        emit_lea_var(arg2_dptr_slot); em(0x50)
        emit_load_var(arg2_bytes_slot); em(0x50)
        emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMEMALLOC_PTR_BSS_OFF, 2)
        em(0x85); em(0xc0); em(0x0f); em(0x85); gpu_fail_d = CL; em32(0)
    }
    var gpu_fail_e: i64 = -1
    if gpu_param_kind_is_slice(kind3) {
        emit_lea_var(arg3_dptr_slot); em(0x50)
        emit_load_var(arg3_bytes_slot); em(0x50)
        emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMEMALLOC_PTR_BSS_OFF, 2)
        em(0x85); em(0xc0); em(0x0f); em(0x85); gpu_fail_e = CL; em32(0)
    }

    var gpu_fail_f: i64 = -1
    if gpu_param_kind_is_slice(kind1) && gpu_param_role_needs_copy_in(role1) {
        emit_load_var(arg1_dptr_slot); em(0x50)
        emit_load_var(arg1_ptr_slot); em(0x50)
        emit_load_var(arg1_bytes_slot); em(0x50)
        emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMEMCPYHTOD_PTR_BSS_OFF, 3)
        em(0x85); em(0xc0); em(0x0f); em(0x85); gpu_fail_f = CL; em32(0)
    }
    var gpu_fail_g: i64 = -1
    if gpu_param_kind_is_slice(kind2) && gpu_param_role_needs_copy_in(role2) {
        emit_load_var(arg2_dptr_slot); em(0x50)
        emit_load_var(arg2_ptr_slot); em(0x50)
        emit_load_var(arg2_bytes_slot); em(0x50)
        emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMEMCPYHTOD_PTR_BSS_OFF, 3)
        em(0x85); em(0xc0); em(0x0f); em(0x85); gpu_fail_g = CL; em32(0)
    }
    var gpu_fail_h: i64 = -1
    if gpu_param_kind_is_slice(kind3) && gpu_param_role_needs_copy_in(role3) {
        emit_load_var(arg3_dptr_slot); em(0x50)
        emit_load_var(arg3_ptr_slot); em(0x50)
        emit_load_var(arg3_bytes_slot); em(0x50)
        emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMEMCPYHTOD_PTR_BSS_OFF, 3)
        em(0x85); em(0xc0); em(0x0f); em(0x85); gpu_fail_h = CL; em32(0)
    }

    emit_load_var(n_slot); emit_store_var(param0_slot)
    if gpu_param_kind_is_slice(kind1) { emit_load_var(arg1_dptr_slot); emit_store_var(param1_slot) }
    if gpu_param_kind_is_slice(kind2) { emit_load_var(arg2_dptr_slot); emit_store_var(param2_slot) }
    if gpu_param_kind_is_slice(kind3) { emit_load_var(arg3_dptr_slot); emit_store_var(param3_slot) }
    emit_lea_var(param0_slot); emit_store_var(paddr0_slot)
    emit_lea_var(param1_slot); emit_store_var(paddr1_slot)
    emit_lea_var(param2_slot); emit_store_var(paddr2_slot)
    emit_lea_var(param3_slot); emit_store_var(paddr3_slot)

    emit_load_var(func_slot); em(0x50)
    emit_load_var(grid_slot); em(0x50)
    emit_imm64(1); em(0x50)
    emit_imm64(1); em(0x50)
    emit_imm64(256); em(0x50)
    emit_imm64(1); em(0x50)
    emit_imm64(1); em(0x50)
    emit_imm64(0); em(0x50)
    emit_imm64(0); em(0x50)
    emit_lea_var(paddr0_slot); em(0x50)
    emit_imm64(0); em(0x50)
    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CULAUNCHKERNEL_PTR_BSS_OFF, 11)
    em(0x85); em(0xc0); em(0x0f); em(0x85); let gpu_fail_i = CL; em32(0)

    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUCTXSYNC_PTR_BSS_OFF, 0)
    em(0x85); em(0xc0); em(0x0f); em(0x85); let gpu_fail_j = CL; em32(0)

    var gpu_fail_k: i64 = -1
    if gpu_param_kind_is_slice(kind1) && gpu_param_role_needs_copy_out(role1) {
        emit_load_var(arg1_ptr_slot); em(0x50)
        emit_load_var(arg1_dptr_slot); em(0x50)
        emit_load_var(arg1_bytes_slot); em(0x50)
        emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMEMCPYDTOH_PTR_BSS_OFF, 3)
        em(0x85); em(0xc0); em(0x0f); em(0x85); gpu_fail_k = CL; em32(0)
    }
    var gpu_fail_l: i64 = -1
    if gpu_param_kind_is_slice(kind2) && gpu_param_role_needs_copy_out(role2) {
        emit_load_var(arg2_ptr_slot); em(0x50)
        emit_load_var(arg2_dptr_slot); em(0x50)
        emit_load_var(arg2_bytes_slot); em(0x50)
        emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMEMCPYDTOH_PTR_BSS_OFF, 3)
        em(0x85); em(0xc0); em(0x0f); em(0x85); gpu_fail_l = CL; em32(0)
    }
    var gpu_fail_m: i64 = -1
    if gpu_param_kind_is_slice(kind3) && gpu_param_role_needs_copy_out(role3) {
        emit_load_var(arg3_ptr_slot); em(0x50)
        emit_load_var(arg3_dptr_slot); em(0x50)
        emit_load_var(arg3_bytes_slot); em(0x50)
        emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMEMCPYDTOH_PTR_BSS_OFF, 3)
        em(0x85); em(0xc0); em(0x0f); em(0x85); gpu_fail_m = CL; em32(0)
    }

    if gpu_param_kind_is_slice(kind1) {
        emit_load_var(arg1_dptr_slot); em(0x50)
        emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMEMFREE_PTR_BSS_OFF, 1)
    }
    if gpu_param_kind_is_slice(kind2) {
        emit_load_var(arg2_dptr_slot); em(0x50)
        emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMEMFREE_PTR_BSS_OFF, 1)
    }
    if gpu_param_kind_is_slice(kind3) {
        emit_load_var(arg3_dptr_slot); em(0x50)
        emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMEMFREE_PTR_BSS_OFF, 1)
    }
    emit_drop_call_args_x86(abi_argc)
    em(0x31); em(0xc0)
    em(0xe9)
    let done = CL
    em32(0)

    patch32(gpu_fail, CL)
    patch32(gpu_fail_b, CL)
    if gpu_fail_c >= 0 { patch32(gpu_fail_c, CL) }
    if gpu_fail_d >= 0 { patch32(gpu_fail_d, CL) }
    if gpu_fail_e >= 0 { patch32(gpu_fail_e, CL) }
    if gpu_fail_f >= 0 { patch32(gpu_fail_f, CL) }
    if gpu_fail_g >= 0 { patch32(gpu_fail_g, CL) }
    if gpu_fail_h >= 0 { patch32(gpu_fail_h, CL) }
    patch32(gpu_fail_i, CL)
    patch32(gpu_fail_j, CL)
    if gpu_fail_k >= 0 { patch32(gpu_fail_k, CL) }
    if gpu_fail_l >= 0 { patch32(gpu_fail_l, CL) }
    if gpu_fail_m >= 0 { patch32(gpu_fail_m, CL) }
    emit_mark_gpu_unavailable_x86("GPU unavailable: CUDA kernel launch failed\n")
    patch32(cpu_fallback, CL)
    emit_kernel_cpu_direct_call_x86(fi, abi_argc)
    patch32(done, CL)
}

fn emit_kernel_dispatch_x86(fi: i64, abi_argc: i64) with Mut, Panic, Div {
    if fi < 0 || fi >= FN_COUNT {
        emit_drop_call_args_x86(abi_argc)
        em(0x31); em(0xc0)
        return
    }
    if CLI_GPU_RUNTIME_ENABLED == 0 {
        // Headless-safe default: runtime execution uses the CPU lowering path.
        // PTX generation remains validated by `build --backend gpu` and the GPU gate.
        emit_kernel_cpu_direct_call_x86(fi, abi_argc)
        return
    }
    let ptx_kind = FN_PTX_KIND[fi as usize]
    if TARGET_OS != 0 || TARGET_ARCH != 0 || FN_PTX_SUPPORTED[fi as usize] == 0 {
        emit_kernel_cpu_direct_call_x86(fi, abi_argc)
        return
    }
    if ptx_kind == gpu_kernel_ptx_kind_vec_binary_f64() ||
       ptx_kind == gpu_kernel_ptx_kind_vec_inplace_binary_f64() ||
       ptx_kind == gpu_kernel_ptx_kind_vec_scale_f64() ||
       ptx_kind == gpu_kernel_ptx_kind_vec_inplace_scale_f64() ||
       ptx_kind == gpu_kernel_ptx_kind_vec_unary_f64() {
        emit_kernel_dispatch_vec_slice_f64_x86(fi, abi_argc)
        return
    }
    emit_kernel_cpu_direct_call_x86(fi, abi_argc)
}

fn compile_gpu_launch_stmt_x86() with IO, Mut, Panic, Div {
    let perform_tok = EP
    EP = EP + 4  // skip perform GPU . launch
    let launch_tok = EP
    if TK[EP as usize] != 6 {
        tc_error(perform_tok, "GPU.launch requires launch(...)")
        return
    }
    EP = EP + 1  // skip (

    var fi: i64 = -1
    var launch_argc: i64 = 0
    if TK[EP as usize] != 7 && TK[EP as usize] != 0 {
        launch_argc = 1
        if TK[EP as usize] == 3 {
            fi = fn_find(TS[EP as usize], TE[EP as usize])
            if fi < 0 {
                tc_undefined_var(EP)
            } else if FN_IS_KERNEL[fi as usize] == 0 {
                tc_error(EP, "GPU.launch requires kernel fn")
                fi = -1
            }
            EP = EP + 1
        } else {
            tc_error(perform_tok, "GPU.launch requires kernel function name")
            EP = skip_call_arg_expr(EP)
        }
        while TK[EP as usize] == 28 {
            EP = EP + 1
            launch_argc = launch_argc + 1
            EP = skip_call_arg_expr(EP)
        }
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }
    else { tc_error(perform_tok, "GPU.launch missing closing )") }
    if launch_argc != 3 { tc_wrong_arity(launch_tok, 3, launch_argc) }

    if TK[EP as usize] != 6 {
        tc_error(perform_tok, "GPU.launch requires kernel argument list")
        return
    }
    EP = EP + 1  // skip (

    let call_tok = launch_tok
    var argc: i64 = 0
    var abi_argc: i64 = 0
    if fi >= 0 {
        while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
            compile_or()
            scan_fn_param_type(fi, argc)
            if (SCAN_TY != 0 || SCAN_TY_HASH != 0) && call_arg_type_compatible(SCAN_TY, SCAN_TY_HASH, EXPR_TY, EXPR_TY_HASH) == false {
                if type_has_knowledge(SCAN_TY, SCAN_TY_HASH) || type_has_knowledge(EXPR_TY, EXPR_TY_HASH) {
                    tc_epistemic_boundary(call_tok)
                } else {
                    let ont_r = try_tc_ontology_call_error(call_tok, SCAN_TY_HASH, EXPR_TY_HASH)
                    if ont_r == 0 { tc_linear_violation(call_tok, "error[E001]: Type mismatch in call argument — declared type does not match") }
                }
            }
            if type_is_slice_ref(SCAN_TY, SCAN_TY_HASH) {
                emit_push_expr_as_slice_arg_x86(call_tok)
                abi_argc = abi_argc + 2
            } else {
                materialize_aggregate_expr_x86()
                em(0x50)
                abi_argc = abi_argc + 1
            }
            argc = argc + 1
            if TK[EP as usize] == 28 { EP = EP + 1 }
        }
    } else {
        while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
            EP = skip_call_arg_expr(EP)
            argc = argc + 1
            if TK[EP as usize] == 28 { EP = EP + 1 }
        }
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }
    else { tc_error(perform_tok, "GPU.launch missing kernel argument )") }

    if fi >= 0 {
        if FN_ARITY[fi as usize] != argc { tc_wrong_arity(call_tok, FN_ARITY[fi as usize], argc) }
        let callee_eff = FN_EFFECTS[fi as usize]
        let caller_eff = FN_EFFECTS[CURRENT_FN as usize]
        if effect_mask_is_subset(callee_eff, caller_eff) == false {
            tc_effect_call_violation(call_tok, callee_eff, caller_eff)
        }
        emit_kernel_dispatch_x86(fi, abi_argc)
    }
    EXPR_IS_F64 = 0
    EXPR_TY = 5
    EXPR_TY_HASH = 0
}

fn compile_gpu_sync_stmt_x86() with IO, Mut, Panic, Div {
    let sync_tok = EP
    EP = EP + 4  // skip perform GPU . sync
    if TK[EP as usize] != 6 {
        tc_error(sync_tok, "GPU.sync requires sync()")
        return
    }
    EP = EP + 1  // skip (
    var argc: i64 = 0
    while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
        EP = skip_call_arg_expr(EP)
        argc = argc + 1
        if TK[EP as usize] == 28 { EP = EP + 1 }
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }
    else { tc_error(sync_tok, "GPU.sync missing closing )") }
    if argc != 0 { tc_wrong_arity(sync_tok, 0, argc) }
    if TARGET_OS == 0 && TARGET_ARCH == 0 && NEEDS_GPU_RUNTIME_DYNLINK != 0 {
        emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + GPU_RT_STATE_BSS_OFF)
        em(0x48); em(0x83); em(0xf8); em(1)
        em(0x0f); em(0x85)
        let skip_sync = CL
        em32(0)
        emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUCTXSYNC_PTR_BSS_OFF, 0)
        patch32(skip_sync, CL)
    }
    EXPR_IS_F64 = 0
    EXPR_TY = 5
    EXPR_TY_HASH = 0
}

// Shift: << (40), >> (39)
fn compile_shift() with IO, Mut, Panic, Div {
    compile_additive()
    while TK[EP as usize] == 39 || TK[EP as usize] == 40 {
        let op_tok = EP
        let op = TK[EP as usize]
        EP = EP + 1
        let left_ty = EXPR_TY
        emit_push()
        compile_additive()
        let right_ty = EXPR_TY
        if left_ty != 0 && left_ty != 1 { tc_error(op_tok, "shift requires integer operands") }
        if right_ty != 0 && right_ty != 1 { tc_error(op_tok, "shift requires integer operands") }
        // rax=rhs (shift amount), stack=lhs
        em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (shift amount in cl)
        em(0x58)  // pop rax (lhs)
        if op == 40 { em(0x48); em(0xd3); em(0xe0) }  // shl rax, cl
        if op == 39 { em(0x48); em(0xd3); em(0xf8) }  // sar rax, cl
        EXPR_TY = 1
        EXPR_TY_HASH = 0
    }
}

// Bitwise AND: & (44)
fn compile_bitand() with IO, Mut, Panic, Div {
    compile_shift()
    while TK[EP as usize] == 44 {
        let op_tok = EP
        let left_ty = EXPR_TY
        EP = EP + 1; emit_push(); compile_shift()
        if left_ty != 0 && left_ty != 1 { tc_error(op_tok, "bitwise and requires integer operands") }
        if EXPR_TY != 0 && EXPR_TY != 1 { tc_error(op_tok, "bitwise and requires integer operands") }
        em(0x59); em(0x48); em(0x21); em(0xc8)  // pop rcx; and rax, rcx
        EXPR_TY = 1
        EXPR_TY_HASH = 0
    }
}

// Bitwise XOR: ^ (56)
fn compile_bitxor() with IO, Mut, Panic, Div {
    compile_bitand()
    while TK[EP as usize] == 56 {
        let op_tok = EP
        let left_ty = EXPR_TY
        EP = EP + 1; emit_push(); compile_bitand()
        if left_ty != 0 && left_ty != 1 { tc_error(op_tok, "bitwise xor requires integer operands") }
        if EXPR_TY != 0 && EXPR_TY != 1 { tc_error(op_tok, "bitwise xor requires integer operands") }
        em(0x59); em(0x48); em(0x31); em(0xc8)  // pop rcx; xor rax, rcx
        EXPR_TY = 1
        EXPR_TY_HASH = 0
    }
}

// Bitwise OR: | (45)
fn compile_bitor() with IO, Mut, Panic, Div {
    compile_bitxor()
    while TK[EP as usize] == 45 {
        let op_tok = EP
        let left_ty = EXPR_TY
        EP = EP + 1; emit_push(); compile_bitxor()
        if left_ty != 0 && left_ty != 1 { tc_error(op_tok, "bitwise or requires integer operands") }
        if EXPR_TY != 0 && EXPR_TY != 1 { tc_error(op_tok, "bitwise or requires integer operands") }
        em(0x59); em(0x48); em(0x09); em(0xc8)  // pop rcx; or rax, rcx
        EXPR_TY = 1
        EXPR_TY_HASH = 0
    }
}

fn compile_comparison() with IO, Mut, Panic, Div {
    compile_bitor()
    let op = TK[EP as usize]
    if op == 21 || op == 22 || op == 23 || op == 24 || op == 25 || op == 26 {
        let op_tok = EP
        let left_raw_f64 = EXPR_IS_F64
        let left_raw_ty = EXPR_TY
        let left_raw_hash = EXPR_TY_HASH
        EP = EP + 1
        emit_push()
        compile_bitor()
        let right_raw_ty = EXPR_TY
        let right_raw_hash = EXPR_TY_HASH
        comparison_require_observe(op_tok, left_raw_ty, right_raw_ty)
        let left_ty = comparison_visible_ty(left_raw_ty, left_raw_hash)
        let left_hash = comparison_visible_hash(left_raw_ty, left_raw_hash)
        let right_ty = comparison_visible_ty(right_raw_ty, right_raw_hash)
        let right_hash = comparison_visible_hash(right_raw_ty, right_raw_hash)
        if left_ty == 3 && right_ty == 3 {
            if op != 21 && op != 22 {
                tc_error(op_tok, "ordered comparison requires matching numeric operands")
            }
            em(0x59)  // pop rcx (lhs)
            emit_str_eq_regs_x86()
            if op == 22 {
                em(0x48); em(0x83); em(0xf0); em(1)  // xor rax, 1
            }
            EXPR_IS_F64 = 0
            EXPR_TY = 4
            EXPR_TY_HASH = 0
            return
        }
        let left_f64 = if left_raw_f64 == 1 || left_ty == 2 { 1 } else { 0 }
        if op == 21 || op == 22 {
            if ty_eq(left_ty, left_hash, right_ty, right_hash) == false {
                // Allow: same numeric kind, or either side is unresolved (type 0)
                if left_ty != 0 && right_ty != 0 {
                    if (left_ty == 2 && right_ty == 2) == false {
                        if (left_ty == 1 && right_ty == 1) == false {
                            tc_error(op_tok, "comparison operands must have the same type")
                        }
                    }
                }
            }
        } else {
            if left_ty != 0 && right_ty != 0 {
                if ty_is_numeric(left_ty) == false || ty_is_numeric(right_ty) == false || ty_eq(left_ty, left_hash, right_ty, right_hash) == false {
                    tc_error(op_tok, "ordered comparison requires matching numeric operands")
                }
            }
        }
        em(0x59)  // pop rcx (lhs)
        if left_f64 == 1 {
            // f64: movq xmm0, rcx (lhs); movq xmm1, rax (rhs); ucomisd xmm0, xmm1
            em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1)  // movq xmm0, rcx
            em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)  // movq xmm1, rax
            em(0x66); em(0x0f); em(0x2e); em(0xc1)            // ucomisd xmm0, xmm1
            // Use unsigned conditional sets for FP comparison
            if op == 21 { em(0x0f); em(0x94); em(0xc0) }  // sete al (==)
            if op == 22 { em(0x0f); em(0x95); em(0xc0) }  // setne al (!=)
            if op == 23 { em(0x0f); em(0x92); em(0xc0) }  // setb al (<)
            if op == 24 { em(0x0f); em(0x97); em(0xc0) }  // seta al (>)
            if op == 25 { em(0x0f); em(0x96); em(0xc0) }  // setbe al (<=)
            if op == 26 { em(0x0f); em(0x93); em(0xc0) }  // setae al (>=)
        } else {
            em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
            if op == 21 { em(0x0f); em(0x94); em(0xc0) }  // sete al
            if op == 22 { em(0x0f); em(0x95); em(0xc0) }  // setne al
            if op == 23 { em(0x0f); em(0x9c); em(0xc0) }  // setl al
            if op == 24 { em(0x0f); em(0x9f); em(0xc0) }  // setg al
            if op == 25 { em(0x0f); em(0x9e); em(0xc0) }  // setle al
            if op == 26 { em(0x0f); em(0x9d); em(0xc0) }  // setge al
        }
        em(0x48); em(0x0f); em(0xb6); em(0xc0)  // movzx rax, al
        EXPR_IS_F64 = 0
        EXPR_TY = 4
        EXPR_TY_HASH = 0
    }
}

// Logical AND: && (30) — short-circuit
fn compile_and() with IO, Mut, Panic, Div {
    compile_comparison()
    while TK[EP as usize] == 30 {
        let op_tok = EP
        let left_ty = EXPR_TY
        EP = EP + 1
        if left_ty != 0 && left_ty != 4 { tc_error(op_tok, "logical and requires bool operands") }
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x0f); em(0x84)             // je short_false (rel32)
        let patch = CL; em32(0)
        compile_comparison()
        if EXPR_TY != 0 && EXPR_TY != 4 { tc_error(op_tok, "logical and requires bool operands") }
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x0f); em(0x95); em(0xc0)  // setne al
        em(0x48); em(0x0f); em(0xb6); em(0xc0)  // movzx rax, al
        em(0xe9); let end_patch = CL; em32(0)  // jmp end
        // short_false: rax already 0
        let here = CL
        CD[patch as usize] = ((here - patch - 4) & 0xFF) as i8
        CD[(patch+1) as usize] = (((here - patch - 4) >> 8) & 0xFF) as i8
        CD[(patch+2) as usize] = (((here - patch - 4) >> 16) & 0xFF) as i8
        CD[(patch+3) as usize] = (((here - patch - 4) >> 24) & 0xFF) as i8
        em(0x31); em(0xc0)  // xor eax, eax
        let end = CL
        CD[end_patch as usize] = ((end - end_patch - 4) & 0xFF) as i8
        CD[(end_patch+1) as usize] = (((end - end_patch - 4) >> 8) & 0xFF) as i8
        CD[(end_patch+2) as usize] = (((end - end_patch - 4) >> 16) & 0xFF) as i8
        CD[(end_patch+3) as usize] = (((end - end_patch - 4) >> 24) & 0xFF) as i8
        EXPR_TY = 4
        EXPR_TY_HASH = 0
    }
}

// Logical OR: || (31) — short-circuit
fn compile_or() with IO, Mut, Panic, Div {
    compile_and()
    while TK[EP as usize] == 31 {
        let op_tok = EP
        let left_ty = EXPR_TY
        EP = EP + 1
        if left_ty != 0 && left_ty != 4 { tc_error(op_tok, "logical or requires bool operands") }
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x0f); em(0x85)             // jne short_true (rel32)
        let patch = CL; em32(0)
        compile_and()
        if EXPR_TY != 0 && EXPR_TY != 4 { tc_error(op_tok, "logical or requires bool operands") }
        em(0xe9); let end_patch = CL; em32(0)  // jmp end
        // short_true: result = 1
        let here = CL
        CD[patch as usize] = ((here - patch - 4) & 0xFF) as i8
        CD[(patch+1) as usize] = (((here - patch - 4) >> 8) & 0xFF) as i8
        CD[(patch+2) as usize] = (((here - patch - 4) >> 16) & 0xFF) as i8
        CD[(patch+3) as usize] = (((here - patch - 4) >> 24) & 0xFF) as i8
        em(0x48); em(0xb8); em64(1)
        let end = CL
        CD[end_patch as usize] = ((end - end_patch - 4) & 0xFF) as i8
        CD[(end_patch+1) as usize] = (((end - end_patch - 4) >> 8) & 0xFF) as i8
        CD[(end_patch+2) as usize] = (((end - end_patch - 4) >> 16) & 0xFF) as i8
        CD[(end_patch+3) as usize] = (((end - end_patch - 4) >> 24) & 0xFF) as i8
        EXPR_TY = 4
        EXPR_TY_HASH = 0
    }
}

// ─── Patch helper ───
fn patch32(off: i64, target: i64) with Mut, Panic {
    let rel = target - off - 4
    CD[off as usize] = (rel & 0xFF) as i8
    CD[(off+1) as usize] = ((rel >> 8) & 0xFF) as i8
    CD[(off+2) as usize] = ((rel >> 16) & 0xFF) as i8
    CD[(off+3) as usize] = ((rel >> 24) & 0xFF) as i8
}

var TUP_PAT_NEXT: i64 = 0
var TUP_RHS_NEXT: i64 = 0

fn tuple_pair_split(p0: i64) -> i64 with Panic, Mut {
    var p = p0 + 1
    var paren_depth: i64 = 0
    var brace_depth: i64 = 0
    var bracket_depth: i64 = 0
    var split: i64 = -1
    while p < TC && TK[p as usize] != 0 {
        let tk = TK[p as usize]
        if tk == 6 { paren_depth = paren_depth + 1 }
        if tk == 8 { brace_depth = brace_depth + 1 }
        if tk == 41 { bracket_depth = bracket_depth + 1 }
        if tk == 7 {
            if paren_depth == 0 && brace_depth == 0 && bracket_depth == 0 { break }
            if paren_depth > 0 { paren_depth = paren_depth - 1 }
        }
        if tk == 9 {
            if brace_depth > 0 { brace_depth = brace_depth - 1 }
        }
        if tk == 42 {
            if bracket_depth > 0 { bracket_depth = bracket_depth - 1 }
        }
        if tk == 28 && paren_depth == 0 && brace_depth == 0 && bracket_depth == 0 {
            if split >= 0 { return -2 }
            split = p
        }
        p = p + 1
    }
    if TK[p as usize] != 7 { return -1 }
    return split
}

fn tuple_pair_close(p0: i64) -> i64 with Panic, Mut {
    var p = p0 + 1
    var paren_depth: i64 = 0
    var brace_depth: i64 = 0
    var bracket_depth: i64 = 0
    while p < TC && TK[p as usize] != 0 {
        let tk = TK[p as usize]
        if tk == 6 { paren_depth = paren_depth + 1 }
        if tk == 8 { brace_depth = brace_depth + 1 }
        if tk == 41 { bracket_depth = bracket_depth + 1 }
        if tk == 7 {
            if paren_depth == 0 && brace_depth == 0 && bracket_depth == 0 { return p }
            if paren_depth > 0 { paren_depth = paren_depth - 1 }
        }
        if tk == 9 {
            if brace_depth > 0 { brace_depth = brace_depth - 1 }
        }
        if tk == 42 {
            if bracket_depth > 0 { bracket_depth = bracket_depth - 1 }
        }
        p = p + 1
    }
    return p
}

fn tuple_bind_leaf_x86(ns: i64, ne: i64) with Mut, Panic, Div {
    bind_local_from_rax_x86(ns, ne, EXPR_TY, EXPR_TY_HASH)
    if VAR_COUNT <= 0 { return }
    let vix = VAR_COUNT - 1
    VAR_IS_CLOSURE[vix as usize] = LAST_EXPR_IS_CLOSURE
    VAR_LINEAR[vix as usize] = LAST_EXPR_IS_LINEAR
    VAR_AFFINE[vix as usize] = LAST_EXPR_IS_AFFINE
}

fn tuple_bind_leaf_a64(ns: i64, ne: i64) with Mut, Panic, Div {
    let slot = var_add(ns, ne)
    if slot < 0 { return }
    let vix = VAR_COUNT - 1
    emit_store_var_a64(slot)
    VAR_IS_F64[vix as usize] = EXPR_IS_F64
    VAR_TY[vix as usize] = EXPR_TY
    VAR_TY_HASH[vix as usize] = EXPR_TY_HASH
    if VAR_TY[vix as usize] == 8 {
        VAR_ALEN[vix as usize] = arr_hash_alen(VAR_TY_HASH[vix as usize])
        VAR_ESIZ[vix as usize] = arr_hash_esiz(VAR_TY_HASH[vix as usize])
    }
    VAR_IS_CLOSURE[vix as usize] = LAST_EXPR_IS_CLOSURE
    VAR_LINEAR[vix as usize] = LAST_EXPR_IS_LINEAR
    VAR_AFFINE[vix as usize] = LAST_EXPR_IS_AFFINE
}

fn emit_load_tuple_elem_x86(src_slot: i64, off_slots: i64, elem_ty: i64, elem_hash: i64) with Mut, Panic, Div {
    emit_load_var(src_slot)
    if off_slots != 0 {
        em(0x48); em(0x8d); em(0x80); em32(off_slots * 8)
    }
    if elem_ty == 8 || elem_ty == 12 || type_is_struct_like(elem_ty, elem_hash) {
        EXPR_IS_F64 = 0
    } else if elem_ty == 2 {
        em(0xf2); em(0x0f); em(0x10); em(0x00)
        em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
        EXPR_IS_F64 = 1
    } else {
        em(0x48); em(0x8b); em(0x00)
        EXPR_IS_F64 = 0
    }
    EXPR_TY = elem_ty
    EXPR_TY_HASH = elem_hash
    LAST_EXPR_IS_CLOSURE = 0
    LAST_EXPR_IS_LINEAR = 0
    LAST_EXPR_IS_AFFINE = 0
    if elem_ty == 6 {
        let si = st_find(elem_hash)
        if si >= 0 {
            LAST_EXPR_IS_LINEAR = ST_LINEAR[si as usize]
            LAST_EXPR_IS_AFFINE = ST_AFFINE[si as usize]
        }
    }
}

fn tuple_bind_runtime_pair_x86(pp0: i64, src_slot: i64, pair_hash: i64, base_off_slots: i64) with IO, Mut, Panic, Div {
    let split = tuple_pair_split(pp0)
    let close = tuple_pair_close(pp0)
    if TK[pp0 as usize] != 6 || split < 0 || TK[close as usize] != 7 {
        tc_error(pp0, "tuple destructure shape mismatch")
        return
    }

    let a_ty = tuple2_first_ty(pair_hash)
    let a_hash = tuple2_first_hash(pair_hash)
    let a_slots = ty_slot_count(a_ty, a_hash)
    let b_ty = tuple2_second_ty(pair_hash)
    let b_hash = tuple2_second_hash(pair_hash)
    let b_slots = ty_slot_count(b_ty, b_hash)

    if TK[(pp0 + 1) as usize] == 6 {
        if a_ty != 12 || tuple2_is(a_hash) == false {
            tc_error(pp0 + 1, "tuple destructure shape mismatch")
        } else {
            tuple_bind_runtime_pair_x86(pp0 + 1, src_slot, a_hash, base_off_slots + b_slots)
        }
    } else {
        let ans = TS[(pp0 + 1) as usize]
        let ane = TE[(pp0 + 1) as usize]
        if !(ane - ans == 1 && sb(ans) == 95) {
            emit_load_tuple_elem_x86(src_slot, base_off_slots + b_slots, a_ty, a_hash)
            tuple_bind_leaf_x86(ans, ane)
        }
    }

    if TK[(split + 1) as usize] == 6 {
        if b_ty != 12 || tuple2_is(b_hash) == false {
            tc_error(split + 1, "tuple destructure shape mismatch")
        } else {
            tuple_bind_runtime_pair_x86(split + 1, src_slot, b_hash, base_off_slots)
        }
    } else {
        let bns = TS[(split + 1) as usize]
        let bne = TE[(split + 1) as usize]
        if !(bne - bns == 1 && sb(bns) == 95) {
            emit_load_tuple_elem_x86(src_slot, base_off_slots, b_ty, b_hash)
            tuple_bind_leaf_x86(bns, bne)
        }
    }
}

fn tuple_skip_value_x86() with IO, Mut, Panic, Div {
    if TK[EP as usize] == 6 {
        EP = EP + 1
        while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
            tuple_skip_value_x86()
            if TK[EP as usize] == 28 { EP = EP + 1 }
        }
        if TK[EP as usize] == 7 { EP = EP + 1 }
        EXPR_TY = 0
        EXPR_TY_HASH = 0
        EXPR_IS_F64 = 0
        return
    }
    compile_or()
}

fn tuple_skip_value_a64() with IO, Mut, Panic, Div {
    if TK[EP as usize] == 6 {
        EP = EP + 1
        while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
            tuple_skip_value_a64()
            if TK[EP as usize] == 28 { EP = EP + 1 }
        }
        if TK[EP as usize] == 7 { EP = EP + 1 }
        EXPR_TY = 0
        EXPR_TY_HASH = 0
        EXPR_IS_F64 = 0
        return
    }
    compile_or_a64()
}

fn tuple_bind_pattern_x86(pp0: i64, rp0: i64) with IO, Mut, Panic, Div {
    var pp = pp0
    var rp = rp0
    if TK[pp as usize] != 6 || TK[rp as usize] != 6 {
        tc_error(pp0, "tuple destructure shape mismatch")
        TUP_PAT_NEXT = pp
        TUP_RHS_NEXT = rp
        return
    }
    pp = pp + 1
    rp = rp + 1
    while TK[pp as usize] != 7 && TK[pp as usize] != 0 {
        if TK[pp as usize] == 6 {
            if TK[rp as usize] != 6 {
                tc_error(pp, "tuple destructure shape mismatch")
                EP = rp
                tuple_skip_value_x86()
                rp = EP
                while TK[pp as usize] != 7 && TK[pp as usize] != 0 { pp = pp + 1 }
            } else {
                tuple_bind_pattern_x86(pp, rp)
                pp = TUP_PAT_NEXT
                rp = TUP_RHS_NEXT
            }
        } else {
            let pns = TS[pp as usize]
            let pne = TE[pp as usize]
            var is_wild: i64 = 0
            if pne - pns == 1 && sb(pns) == 95 { is_wild = 1 }
            pp = pp + 1
            EP = rp
            if is_wild == 1 {
                tuple_skip_value_x86()
                rp = EP
            } else {
                if TK[rp as usize] == 6 {
                    tc_error(pp - 1, "tuple destructure shape mismatch")
                    tuple_skip_value_x86()
                    rp = EP
                } else {
                    compile_or()
                    rp = EP
                    tuple_bind_leaf_x86(pns, pne)
                }
            }
        }
        if TK[pp as usize] == 28 { pp = pp + 1 }
        if TK[rp as usize] == 28 { rp = rp + 1 }
    }
    if TK[pp as usize] != 7 || TK[rp as usize] != 7 {
        // Count pattern elements: stop at matching closing ')'.
        var pc: i64 = 0; var qp = pp0 + 1; var dpth: i64 = 0; var pc_done: i64 = 0
        while TK[qp as usize] != 0 && pc_done == 0 {
            if TK[qp as usize] == 6 { dpth = dpth + 1 }
            if TK[qp as usize] == 7 && dpth == 0 { pc = pc + 1; pc_done = 1 }
            if TK[qp as usize] == 7 && dpth > 0 { dpth = dpth - 1 }
            if TK[qp as usize] == 28 && dpth == 0 { pc = pc + 1 }
            qp = qp + 1
        }
        var rc: i64 = 0; var qr = rp0 + 1; dpth = 0; var rc_done: i64 = 0
        while TK[qr as usize] != 0 && rc_done == 0 {
            if TK[qr as usize] == 6 { dpth = dpth + 1 }
            if TK[qr as usize] == 7 && dpth == 0 { rc = rc + 1; rc_done = 1 }
            if TK[qr as usize] == 7 && dpth > 0 { dpth = dpth - 1 }
            if TK[qr as usize] == 28 && dpth == 0 { rc = rc + 1 }
            qr = qr + 1
        }
        print("error: tuple destructure arity mismatch: has ")
        print_int(pc)
        print(" elements but type has ")
        print_int(rc)
        print(" at line ")
        print_int(TL[pp0 as usize])
        print("\n")
        TYPECHECK_FAILED = 1
    }
    if TK[pp as usize] == 7 { pp = pp + 1 }
    if TK[rp as usize] == 7 { rp = rp + 1 }
    TUP_PAT_NEXT = pp
    TUP_RHS_NEXT = rp
}

fn tuple_bind_pattern_a64(pp0: i64, rp0: i64) with IO, Mut, Panic, Div {
    var pp = pp0
    var rp = rp0
    if TK[pp as usize] != 6 || TK[rp as usize] != 6 {
        tc_error(pp0, "tuple destructure shape mismatch")
        TUP_PAT_NEXT = pp
        TUP_RHS_NEXT = rp
        return
    }
    pp = pp + 1
    rp = rp + 1
    while TK[pp as usize] != 7 && TK[pp as usize] != 0 {
        if TK[pp as usize] == 6 {
            if TK[rp as usize] != 6 {
                tc_error(pp, "tuple destructure shape mismatch")
                EP = rp
                tuple_skip_value_a64()
                rp = EP
                while TK[pp as usize] != 7 && TK[pp as usize] != 0 { pp = pp + 1 }
            } else {
                tuple_bind_pattern_a64(pp, rp)
                pp = TUP_PAT_NEXT
                rp = TUP_RHS_NEXT
            }
        } else {
            let pns = TS[pp as usize]
            let pne = TE[pp as usize]
            var is_wild: i64 = 0
            if pne - pns == 1 && sb(pns) == 95 { is_wild = 1 }
            pp = pp + 1
            EP = rp
            if is_wild == 1 {
                tuple_skip_value_a64()
                rp = EP
            } else {
                if TK[rp as usize] == 6 {
                    tc_error(pp - 1, "tuple destructure shape mismatch")
                    tuple_skip_value_a64()
                    rp = EP
                } else {
                    compile_or_a64()
                    rp = EP
                    tuple_bind_leaf_a64(pns, pne)
                }
            }
        }
        if TK[pp as usize] == 28 { pp = pp + 1 }
        if TK[rp as usize] == 28 { rp = rp + 1 }
    }
    if TK[pp as usize] != 7 || TK[rp as usize] != 7 { tc_error(pp0, "tuple destructure arity mismatch") }
    if TK[pp as usize] == 7 { pp = pp + 1 }
    if TK[rp as usize] == 7 { rp = rp + 1 }
    TUP_PAT_NEXT = pp
    TUP_RHS_NEXT = rp
}

fn resolve_field_struct_index(ns: i64, ne: i64, fh: i64) -> i64 with Panic, Div, Mut {
    let vi = var_find_idx(ns, ne)
    if vi >= 0 && VAR_TY[vi as usize] == 6 {
        let si = st_find(VAR_TY_HASH[vi as usize])
        if si >= 0 { return si }
    } else if vi >= 0 && VAR_TY[vi as usize] == 10 && ref_hash_inner_ty(VAR_TY_HASH[vi as usize]) == 6 {
        let si = st_find(ref_hash_inner_hash(VAR_TY_HASH[vi as usize]))
        if si >= 0 { return si }
    }
    let gi = gl_find(ns, ne)
    if gi >= 0 && GL_TY[gi as usize] == 6 {
        let si = st_find(GL_TY_HASH[gi as usize])
        if si >= 0 { return si }
    } else if gi >= 0 && GL_TY[gi as usize] == 10 && ref_hash_inner_ty(GL_TY_HASH[gi as usize]) == 6 {
        let si = st_find(ref_hash_inner_hash(GL_TY_HASH[gi as usize]))
        if si >= 0 { return si }
    }
    var sj: i64 = 0
    while sj < ST_COUNT {
        if st_field_offset(sj, fh) >= 0 { return sj }
        sj = sj + 1
    }
    return -1
}

fn compile_field_array_store_x86() with IO, Mut, Panic, Div {
    let name_tok = EP
    let ns = TS[EP as usize]
    let ne = TE[EP as usize]
    let field_tok = EP + 2
    let fns = TS[(EP + 2) as usize]
    let fne = TE[(EP + 2) as usize]
    let fh = gl_name_hash(fns, fne)
    EP = EP + 4
    compile_or()
    if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
    if TK[EP as usize] == 42 { EP = EP + 1 }
    if TK[EP as usize] == 16 { EP = EP + 1 }
    em(0x50)
    compile_or()
    let rhs_ty = EXPR_TY
    let rhs_ty_hash = EXPR_TY_HASH
    let si = resolve_field_struct_index(ns, ne, fh)
    if si < 0 {
        tc_error(field_tok, "unknown field access")
        em(0x59)
        return
    }
    let foff = st_field_offset(si, fh)
    let fty = st_field_ty(si, fh)
    let fhash = st_field_hash(si, fh)
    if fty != 8 {
        tc_error(field_tok, "indexed field store requires array field")
        em(0x59)
        return
    }
    if ty_eq(arr_hash_elem_ty(fhash), 0, rhs_ty, rhs_ty_hash) == false {
        tc_error(EP - 1, "assignment type mismatch")
    }
    em(0x48); em(0x89); em(0xc2)
    em(0x59)
    let slot = var_find(ns, ne)
    if slot >= 0 { emit_load_var(slot) }
    else {
        let gi = gl_find(ns, ne)
        if gi >= 0 {
            let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
            em(0x48); em(0xb8); em64(addr)
        } else {
            tc_undefined_var(name_tok)
            em(0x31); em(0xc0)
        }
    }
    if foff != 0 { em(0x48); em(0x8d); em(0x80); em32(foff) }
    if arr_hash_esiz(fhash) == 8 {
        em(0x48); em(0x89); em(0x14); em(0xc8)
    } else {
        em(0x88); em(0x14); em(0x08)
    }
}

fn compile_field_array_store_a64() with IO, Mut, Panic, Div {
    let name_tok = EP
    let ns = TS[EP as usize]; let ne = TE[EP as usize]
    let field_tok = EP + 2
    let fns = TS[(EP + 2) as usize]; let fne = TE[(EP + 2) as usize]
    let fh = gl_name_hash(fns, fne)
    EP = EP + 4
    compile_or_a64()
    if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
    if TK[EP as usize] == 42 { EP = EP + 1 }
    if TK[EP as usize] == 16 { EP = EP + 1 }
    emit_push_a64()
    compile_or_a64()
    let rhs_ty = EXPR_TY
    let rhs_ty_hash = EXPR_TY_HASH
    let si = resolve_field_struct_index(ns, ne, fh)
    if si < 0 {
        tc_error(field_tok, "unknown field access")
        emit_pop_x1_a64()
        return
    }
    let foff = st_field_offset(si, fh)
    let fty = st_field_ty(si, fh)
    let fhash = st_field_hash(si, fh)
    if fty != 8 {
        tc_error(field_tok, "indexed field store requires array field")
        emit_pop_x1_a64()
        return
    }
    if ty_eq(arr_hash_elem_ty(fhash), 0, rhs_ty, rhs_ty_hash) == false {
        tc_error(EP - 1, "assignment type mismatch")
    }
    em32(0xAA0003EA)
    emit_pop_x1_a64()
    let slot = var_find(ns, ne)
    if slot >= 0 { emit_load_var_a64(slot) }
    else {
        let gi = gl_find(ns, ne)
        if gi >= 0 { emit_imm64_a64(GL_BSS_BASE + GL[(gi * 4 + 1) as usize]) }
        else { tc_undefined_var(name_tok); em32(0xD2800000) }
    }
    if foff != 0 {
        emit_imm64_reg_a64(11, foff)
        em32(0x8B0B0000)
    }
    if arr_hash_esiz(fhash) == 8 { em32(0xF821780A) }
    else { em32(0x3821680A) }
}

// ─── Statement compiler ───
fn compile_stmt() with IO, Mut, Panic, Div {
    let k = TK[EP as usize]
    LAST_STMT_HAS_VALUE = 0

    // Skip semicolons
    if k == 27 { EP = EP + 1; return }

    // Skip trait declarations (abstract — no codegen)
    if k == 75 {
        EP = EP + 1  // skip 'trait'
        if TK[EP as usize] == 3 { EP = EP + 1 }  // skip name
        if TK[EP as usize] == 8 {
            EP = EP + 1
            var td: i64 = 1
            while EP < TC && td > 0 {
                if TK[EP as usize] == 8 { td = td + 1 }
                if TK[EP as usize] == 9 { td = td - 1 }
                EP = EP + 1
            }
        }
        return
    }

    // Skip impl header (methods are compiled as normal functions)
    if k == 76 {
        EP = EP + 1  // skip 'impl'
        if TK[EP as usize] == 3 { EP = EP + 1 }  // skip name
        // Skip 'for Type' if present
        if TK[EP as usize] == 3 && src_match(TS[EP as usize], TE[EP as usize] - TS[EP as usize], "for") {
            EP = EP + 1  // skip 'for'
            if TK[EP as usize] == 3 { EP = EP + 1 }  // skip type name
        }
        // Skip generic <T> if present
        if TK[EP as usize] == 23 {
            while TK[EP as usize] != 24 && TK[EP as usize] != 0 { EP = EP + 1 }
            if TK[EP as usize] == 24 { EP = EP + 1 }
        }
        // Don't skip the block — let the normal fn compilation handle the methods
        return
    }

    // Study block: skip header tokens (study, hypothesis blocks), compile fn defs
    if k == 71 {
        EP = EP + 1  // skip 'study'
        // Skip tokens until opening brace
        while TK[EP as usize] != 8 && TK[EP as usize] != 0 { EP = EP + 1 }
        // Don't skip the block — let normal fn compilation handle methods inside
        return
    }

    // Skip hypothesis/outcome sub-blocks inside study (these are metadata, not code)
    if k == 3 && (src_match(TS[EP as usize], TE[EP as usize] - TS[EP as usize], "hypothesis") || src_match(TS[EP as usize], TE[EP as usize] - TS[EP as usize], "outcome")) {
        EP = EP + 1  // skip keyword
        // Skip to and past the block { ... }
        while TK[EP as usize] != 8 && TK[EP as usize] != 9 && TK[EP as usize] != 0 { EP = EP + 1 }
        if TK[EP as usize] == 8 {
            EP = EP + 1
            var hd: i64 = 1
            while EP < TC && hd > 0 {
                if TK[EP as usize] == 8 { hd = hd + 1 }
                if TK[EP as usize] == 9 { hd = hd - 1 }
                EP = EP + 1
            }
        }
        return
    }

    // let x = expr / var x = expr (with optional : type)
    if k == 11 || k == 12 {
        EP = EP + 1
        // Strike 2: Reject 'let mut' Rust syntax
        if k == 11 && TK[EP as usize] == 3 {
            let ns = TS[EP as usize]
            let ne = TE[EP as usize]
            if src_match(ns, ne - ns, "mut") {
                tc_rust_let_mut(EP)
            }
        }
        if TK[EP as usize] == 6 {
            let pat_start = EP
            var pat_p = EP
            var pat_depth: i64 = 0
            while pat_p < TC {
                if TK[pat_p as usize] == 6 { pat_depth = pat_depth + 1 }
                if TK[pat_p as usize] == 7 {
                    pat_depth = pat_depth - 1
                    pat_p = pat_p + 1
                    if pat_depth == 0 { break }
                    continue
                }
                pat_p = pat_p + 1
            }
            EP = pat_p
            if TK[EP as usize] == 16 { EP = EP + 1 }
            let rhs_start = EP
            let rhs_split = tuple_pair_split(rhs_start)
            if TK[rhs_start as usize] == 6 && rhs_split >= 0 {
                tuple_bind_pattern_x86(pat_start, rhs_start)
                EP = TUP_RHS_NEXT
                return
            }
            compile_or()
            if EXPR_TY == 12 && tuple2_is(EXPR_TY_HASH) {
                let src_slot = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var(src_slot)
                tuple_bind_runtime_pair_x86(pat_start, src_slot, EXPR_TY_HASH, 0)
                return
            }
            tc_error(rhs_start, "tuple destructuring requires tuple value")
            return
        }
        let ns = TS[EP as usize]
        let ne = TE[EP as usize]
        EP = EP + 1
        // Check for : type annotation
        var is_arr: i64 = 0
        var arr_len: i64 = 0
        var arr_esiz: i64 = 8
        var decl_is_f64: i64 = -1
        var decl_ty: i64 = 0
        var decl_ty_hash: i64 = 0
        let decl_is_mut = k == 12
        if TK[EP as usize] == 43 {
            EP = EP + 1  // skip :
            let ann_ns = TS[EP as usize]
            let ann_ne = TE[EP as usize]
            // Array type: [T; N] — detect and extract element type + length
            if TK[EP as usize] == 41 {
                EP = EP + 1  // skip [
                // Element type
                let etns = TS[EP as usize]
                let etne = TE[EP as usize]
                let arr_elem_ty = type_name_kind(etns, etne)
                if src_match(etns, etne - etns, "i8") { arr_esiz = 1 }
                EP = EP + 1  // skip element type
                if TK[EP as usize] == 27 { EP = EP + 1 }  // skip ;
                arr_len = TV[EP as usize]
                EP = EP + 1  // skip N
                if TK[EP as usize] == 42 { EP = EP + 1 }  // skip ]
                is_arr = 1
                decl_ty = 8
                decl_ty_hash = arr_ty_hash(arr_len, arr_esiz, arr_elem_ty)
                decl_is_f64 = 0
            } else {
                scan_type(EP)
                decl_ty = SCAN_TY
                decl_ty_hash = SCAN_TY_HASH
                if knowledge_hash_invalid(decl_ty_hash) {
                    if 1 == 1 {
                        print("DEBUG decl ty=")
                        print_int(decl_ty)
                        print(" hash=")
                        print_int(decl_ty_hash)
                        print(" eps=")
                        print_int(knowledge_hash_eps(decl_ty_hash))
                        print("\n")
                    }
                    tc_epistemic_boundary(EP)
                    decl_ty = 0
                    decl_ty_hash = 0
                }
                if decl_ty == 0 && name_is_lower(ann_ns, ann_ne) {
                    decl_ty = 2
                    decl_ty_hash = gl_name_hash(ann_ns, ann_ne)
                }
                if decl_ty == 2 { decl_is_f64 = 1 }
                else { decl_is_f64 = 0 }
                EP = SCAN_TY_NEXT
            }
        }
        // Skip = sign
        if TK[EP as usize] == 16 { EP = EP + 1 }
        if is_arr == 1 && arr_len > 0 && TK[EP as usize] == 41 && array_init_is_repeat(EP) {
            // Local array: allocate slots, skip initializer [0; N], store lea
            // Skip [0; N] or [val; N] initializer
            EP = EP + 1  // skip [
            while TK[EP as usize] != 42 && TK[EP as usize] != 0 { EP = EP + 1 }
            if TK[EP as usize] == 42 { EP = EP + 1 }  // skip ]
            let nslots = arr_len
            if arr_esiz == 1 { nslots = (arr_len + 7) / 8 }
            let ptr_slot = var_add_arr(ns, ne, nslots, arr_esiz, arr_hash_elem_ty(decl_ty_hash))
            if ptr_slot < 0 { return }
            let arr_vi = VAR_COUNT - 1
            VAR_TY[arr_vi as usize] = 8
            VAR_TY_HASH[arr_vi as usize] = decl_ty_hash
            // Zero-init the array slots using rep stosq (compact: 3 instrs vs N*2 instrs)
            // Array slots: base..base+nslots-1, lowest addr = rbp-(base+nslots-1)*8
            // rep stosq: store rax to [rdi], rdi += 8, rcx--; repeats rcx times (DF=0 → ascending)
            let base = ptr_slot - nslots
            if LAST_LOCAL_BSS_SPILL != 0 {
                em(0x48); em(0xbf); em64(LAST_LOCAL_BSS_ADDR)
            } else {
                em(0x48); em(0x8d); em(0xbd)  // lea rdi, [rbp + disp32]  (lowest array addr)
                em32(0 - (base + nslots - 1) * 8)
            }
            em(0x48); em(0x31); em(0xc0)  // xor rax, rax
            em(0xb9); em32(nslots)         // mov ecx, nslots (zero-extends to rcx)
            em(0xf3); em(0x48); em(0xab)  // rep stosq
            // Store lea (pointer to array start) in ptr_slot
            // Array slots are base..base+nslots-1, addresses [rbp-base*8]..[rbp-(base+nslots-1)*8]
            // Pointer must point to lowest address so arr[i] = [ptr + i*8] addresses upward
            if LAST_LOCAL_BSS_SPILL != 0 {
                em(0x48); em(0xb8); em64(LAST_LOCAL_BSS_ADDR)
            } else {
                em(0x48); em(0x8d); em(0x85)  // lea rax, [rbp + disp32]
                em32(0 - (base + nslots - 1) * 8)
            }
            emit_store_var(ptr_slot)
        } else {
            compile_or()
            if (decl_ty != 0 || decl_ty_hash != 0) && ty_eq(decl_ty, decl_ty_hash, EXPR_TY, EXPR_TY_HASH) == false {
                if type_has_knowledge(decl_ty, decl_ty_hash) || type_has_knowledge(EXPR_TY, EXPR_TY_HASH) {
                    tc_epistemic_boundary(EP)
                } else {
                    tc_error(EP - 1, "initializer type does not match declaration")
                }
            }
            // Observation boundary: Unobserved<T> assigned to non-Unobserved binding
            if ty_is_unobserved(EXPR_TY) && !ty_is_unobserved(decl_ty) && (FN_EFFECTS[CURRENT_FN as usize] & 64) == 0 {
                tc_observe_boundary(EP - 1, "cannot assign Unobserved<T> to non-Unobserved binding")
            }
            if type_is_slice_ref(decl_ty, decl_ty_hash) || (decl_ty == 0 && type_is_slice_ref(EXPR_TY, EXPR_TY_HASH)) {
                var bind_hash = EXPR_TY_HASH
                if decl_ty != 0 || decl_ty_hash != 0 { bind_hash = decl_ty_hash }
                let before_vc = VAR_COUNT
                bind_slice_local_from_rax_x86(ns, ne, bind_hash)
                if VAR_COUNT > before_vc {
                    let svix = VAR_COUNT - 1
                    VAR_IS_CLOSURE[svix as usize] = 0
                    VAR_MUT[svix as usize] = decl_is_mut
                    VAR_LINEAR[svix as usize] = 0
                }
            } else if (decl_ty == 8) || (decl_ty == 0 && EXPR_TY == 8) {
                var bind_hash = EXPR_TY_HASH
                if decl_ty == 8 { bind_hash = decl_ty_hash }
                let before_vc = VAR_COUNT
                bind_array_local_from_rax_x86(ns, ne, bind_hash)
                if VAR_COUNT > before_vc {
                    let avix = VAR_COUNT - 1
                    VAR_IS_CLOSURE[avix as usize] = 0
                    VAR_MUT[avix as usize] = decl_is_mut
                    VAR_LINEAR[avix as usize] = 0
                }
            } else if type_is_struct_like(decl_ty, decl_ty_hash) || (decl_ty == 0 && type_is_struct_like(EXPR_TY, EXPR_TY_HASH)) {
                var bind_hash = EXPR_TY_HASH
                if decl_ty != 0 || decl_ty_hash != 0 { bind_hash = decl_ty_hash }
                let before_vc = VAR_COUNT
                bind_struct_local_from_rax_x86(ns, ne, bind_hash)
                if VAR_COUNT > before_vc {
                    let svix = VAR_COUNT - 1
                    VAR_IS_CLOSURE[svix as usize] = 0
                    VAR_MUT[svix as usize] = decl_is_mut
                    VAR_CONFIDENCE[svix as usize] = EXPR_CONFIDENCE
                }
            } else if (decl_ty == 12 && tuple2_is(decl_ty_hash)) || (decl_ty == 0 && EXPR_TY == 12 && tuple2_is(EXPR_TY_HASH)) {
                var bind_hash = EXPR_TY_HASH
                if decl_ty == 12 && tuple2_is(decl_ty_hash) { bind_hash = decl_ty_hash }
                let before_vc = VAR_COUNT
                bind_tuple_local_from_rax_x86(ns, ne, bind_hash)
                if VAR_COUNT > before_vc {
                    let tvix = VAR_COUNT - 1
                    VAR_IS_CLOSURE[tvix as usize] = 0
                    VAR_MUT[tvix as usize] = decl_is_mut
                }
            } else {
                let slot = var_add(ns, ne)
                if slot < 0 { return }
                let vix = VAR_COUNT - 1
                // Refinement predicate: compile-time check for constant literals.
                if SCAN_HAS_PRED == 1 && LAST_IS_LITERAL == 1 && SCAN_PRED_IS_F64 == 0 {
                    let cv = LAST_LITERAL_VAL; let bv = SCAN_PRED_BOUND; var violated: i64 = 0
                    if SCAN_PRED_OP == 26 && cv < bv { violated = 1 }  // >= : violated if cv < bv
                    if SCAN_PRED_OP == 24 && cv <= bv { violated = 1 } // >  : violated if cv <= bv
                    if SCAN_PRED_OP == 25 && cv > bv { violated = 1 }  // <= : violated if cv > bv
                    if SCAN_PRED_OP == 23 && cv >= bv { violated = 1 } // <  : violated if cv >= bv
                    if SCAN_PRED_OP == 21 && cv != bv { violated = 1 } // == : violated if cv != bv
                    if SCAN_PRED_OP == 22 && cv == bv { violated = 1 } // != : violated if cv == bv
                    if violated == 1 {
                        print("error: refinement type violation — value ")
                        print_int(cv)
                        print(" does not satisfy predicate at line ")
                        print_int(TL[(EP - 1) as usize])
                        print("\n")
                        TYPECHECK_FAILED = 1
                        SCAN_HAS_PRED = 0
                    }
                }
                // Refinement predicate runtime assertion (integer bounds only)
                // RAX holds the value before store — emit bound check + ud2 trap.
                // Uses CMP which does NOT modify RAX, so emit_store_var below is correct.
                if SCAN_HAS_PRED == 1 && SCAN_PRED_IS_F64 == 0 {
                    em(0x48); em(0x81); em(0xf8); em32(SCAN_PRED_BOUND)  // cmp rax, imm32
                    if SCAN_PRED_OP == 26 { em(0x0f); em(0x8d) }  // JGE (>=)
                    if SCAN_PRED_OP == 24 { em(0x0f); em(0x8f) }  // JG  (>)
                    if SCAN_PRED_OP == 25 { em(0x0f); em(0x8e) }  // JLE (<=)
                    if SCAN_PRED_OP == 23 { em(0x0f); em(0x8c) }  // JL  (<)
                    if SCAN_PRED_OP == 21 { em(0x0f); em(0x84) }  // JE  (==)
                    if SCAN_PRED_OP == 22 { em(0x0f); em(0x85) }  // JNE (!=)
                    let pred_ok_off = CL; em32(0)
                    em(0x0f); em(0x0b)  // ud2: refinement predicate violated (trap)
                    patch32(pred_ok_off, CL)
                    SCAN_HAS_PRED = 0
                }
                if SCAN_HAS_PRED == 1 && SCAN_PRED_IS_F64 == 1 {
                    // f64 refinement: movq xmm0, rax; load bound into xmm1; ucomisd; Jcc ok; ud2
                    // CMP does not clobber rax — ucomisd/movq xmm0,rax also does NOT modify rax.
                    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc0)  // movq xmm0, rax
                    em(0x48); em(0xb9); em64(SCAN_PRED_BOUND)         // mov rcx, imm64 (bound bits)
                    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc9)  // movq xmm1, rcx
                    em(0x66); em(0x0f); em(0x2e); em(0xc1)            // ucomisd xmm0, xmm1
                    if SCAN_PRED_OP == 26 { em(0x0f); em(0x83) }  // JAE (>=)
                    if SCAN_PRED_OP == 24 { em(0x0f); em(0x87) }  // JA  (>)
                    if SCAN_PRED_OP == 25 { em(0x0f); em(0x86) }  // JBE (<=)
                    if SCAN_PRED_OP == 23 { em(0x0f); em(0x82) }  // JB  (<)
                    if SCAN_PRED_OP == 21 { em(0x0f); em(0x84) }  // JE  (==)
                    if SCAN_PRED_OP == 22 { em(0x0f); em(0x85) }  // JNE (!=)
                    let pred_ok_f_off = CL; em32(0)
                    em(0x0f); em(0x0b)  // ud2: refinement predicate violated (trap)
                    patch32(pred_ok_f_off, CL)
                    SCAN_HAS_PRED = 0
                }
                emit_store_var(slot)
                // GUM variance: copy scratch → var slot if RHS produced variance
                if EXPR_VAR_SLOT == -2 || EXPR_VAR_SLOT >= 0 {
                    emit_copy_scratch_to_var_variance_x86(slot)
                }
                // β² fix: persist expression hash so subsequent loads of this
                // variable can detect same-derivation subtraction/addition.
                if slot >= 0 && slot < 1024 {
                    VAR_VARIANCE_HASH[slot as usize] = EXPR_VARIANCE_HASH
                }
                // Confidence gate: store compile-time confidence for this variable
                VAR_CONFIDENCE[vix as usize] = EXPR_CONFIDENCE
                // Set f64 flag: explicit type annotation takes priority, else infer from RHS
                if decl_is_f64 == 1 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 1 }
                else if decl_is_f64 == 0 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 0 }
                else { VAR_IS_F64[(VAR_COUNT - 1) as usize] = EXPR_IS_F64 }
                if decl_ty != 0 || decl_ty_hash != 0 {
                    VAR_TY[vix as usize] = decl_ty
                    VAR_TY_HASH[vix as usize] = decl_ty_hash
                } else {
                    VAR_TY[vix as usize] = EXPR_TY
                    VAR_TY_HASH[vix as usize] = EXPR_TY_HASH
                }
                if VAR_TY[vix as usize] == 8 {
                    VAR_ALEN[vix as usize] = arr_hash_alen(VAR_TY_HASH[vix as usize])
                    VAR_ESIZ[vix as usize] = arr_hash_esiz(VAR_TY_HASH[vix as usize])
                }
                // Set closure flag if RHS was a closure expression
                VAR_IS_CLOSURE[(VAR_COUNT - 1) as usize] = LAST_EXPR_IS_CLOSURE
                VAR_MUT[(VAR_COUNT - 1) as usize] = decl_is_mut
                // Set linear/affine flag if RHS was a linear/affine struct literal
                VAR_LINEAR[(VAR_COUNT - 1) as usize] = LAST_EXPR_IS_LINEAR
                VAR_AFFINE[(VAR_COUNT - 1) as usize] = LAST_EXPR_IS_AFFINE
                // Set unit hash for unit-typed variables (e.g. let mass: mg = 5.0)
                // decl_ty == 2 and decl_ty_hash == hash("mg") for unit annotations
                if decl_ty == 2 && decl_ty_hash != 0 {
                    VAR_UNIT[(VAR_COUNT - 1) as usize] = decl_ty_hash
                }
            }
        }
        return
    }

    // x.field[idx] = expr
    if stmt_is_field_array_store(EP) {
        if current_fn_allows_mutation() == false {
            tc_effect_violation(EP, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        compile_field_array_store_x86()
        return
    }

    // x.field = expr (struct field write)
    if k == 3 && TK[(EP + 1) as usize] == 50 && TK[(EP + 3) as usize] == 16 {
        let name_tok = EP
        if current_fn_allows_mutation() == false {
            tc_effect_violation(name_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[EP as usize]
        let ne = TE[EP as usize]
        let field_tok = EP + 2
        EP = EP + 2  // skip name and .
        let fns = TS[EP as usize]
        let fne = TE[EP as usize]
        let fh = gl_name_hash(fns, fne)
        EP = EP + 1  // skip field name
        if TK[EP as usize] == 16 { EP = EP + 1 }  // skip =
        compile_or()  // value in rax
        let rhs_ty = EXPR_TY
        let rhs_ty_hash = EXPR_TY_HASH
        let si = resolve_field_struct_index(ns, ne, fh)
        if si < 0 {
            tc_error(field_tok, "unknown field access")
            return
        }
        let off = st_field_offset(si, fh)
        let fty = st_field_ty(si, fh)
        let fhash = st_field_hash(si, fh)
        if fty != 0 && ty_eq(fty, fhash, rhs_ty, rhs_ty_hash) == false {
            tc_error(EP - 1, "assignment type mismatch")
        }
        // Observation boundary: storing Unobserved<T> into non-Unobserved field
        if ty_is_unobserved(rhs_ty) && !ty_is_unobserved(fty) && (FN_EFFECTS[CURRENT_FN as usize] & 64) == 0 {
            tc_observe_boundary(field_tok, "cannot store Unobserved<T> into non-Unobserved field")
        }
        em(0x50)  // push value/src ptr
        let slot = var_find(ns, ne)
        if slot >= 0 { emit_load_var(slot) }
        else {
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                em(0x48); em(0xb8); em64(addr)
            } else {
                tc_undefined_var(name_tok)
                em(0x31); em(0xc0)
            }
        }
        if off != 0 { em(0x48); em(0x8d); em(0x80); em32(off) }
        em(0x5a)  // pop rdx (value/src ptr)
        if fty == 8 || fty == 6 || knowledge_hash_is(fhash) {
            emit_copy_agg_to_ptr_x86(fty, fhash)
        } else {
            em(0x48); em(0x89); em(0x10)  // mov [rax], rdx
        }
        return
    }

    // x = expr (local or global scalar assignment)
    if k == 3 && TK[(EP + 1) as usize] == 16 {
        let name_tok = EP
        if current_fn_allows_mutation() == false {
            tc_effect_violation(name_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[EP as usize]
        let ne = TE[EP as usize]
        EP = EP + 2
        compile_or()
        let rhs_ty = EXPR_TY
        let rhs_ty_hash = EXPR_TY_HASH
        let slot = var_find(ns, ne)
        if slot >= 0 {
            let ty_vi = var_find_idx(ns, ne)
            if ty_vi >= 0 {
                if ty_eq(VAR_TY[ty_vi as usize], VAR_TY_HASH[ty_vi as usize], rhs_ty, rhs_ty_hash) == false {
                    tc_error(EP - 1, "assignment type mismatch")
                }
                // Linear reassignment: old value must be consumed before overwrite
                if VAR_LINEAR[ty_vi as usize] == 1 {
                    if VAR_USED[ty_vi as usize] == 0 {
                        tc_linear_violation(name_tok, "linear value not consumed")
                    }
                    VAR_USED[ty_vi as usize] = 0
                }
            }
            if ty_vi >= 0 && VAR_TY[ty_vi as usize] == 8 {
                copy_array_into_local_slot_x86(slot, VAR_TY_HASH[ty_vi as usize])
            } else if ty_vi >= 0 && type_is_struct_like(VAR_TY[ty_vi as usize], VAR_TY_HASH[ty_vi as usize]) {
                copy_struct_into_local_slot_x86(slot, VAR_TY_HASH[ty_vi as usize])
            } else if ty_vi >= 0 && VAR_TY[ty_vi as usize] == 12 && tuple2_is(VAR_TY_HASH[ty_vi as usize]) {
                copy_tuple_into_local_slot_x86(slot, VAR_TY_HASH[ty_vi as usize])
            } else {
                emit_store_var(slot)
                // GUM variance: copy scratch → var slot on reassignment
                if EXPR_VAR_SLOT == -2 || EXPR_VAR_SLOT >= 0 {
                    emit_copy_scratch_to_var_variance_x86(slot)
                }
            }
            // Update closure flag on reassignment
            var vi: i64 = VAR_COUNT - 1
            while vi >= 0 {
                if name_eq(VAR_NS[vi as usize], VAR_NE[vi as usize], ns, ne) {
                    VAR_IS_CLOSURE[vi as usize] = LAST_EXPR_IS_CLOSURE
                    vi = -1  // break
                }
                vi = vi - 1
            }
        }
        else {
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                if ty_eq(GL_TY[gi as usize], GL_TY_HASH[gi as usize], rhs_ty, rhs_ty_hash) == false {
                    tc_error(EP - 1, "assignment type mismatch")
                }
                let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                // mov rcx, rax; mov rax, addr; mov [rax], rcx
                em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (value)
                em(0x48); em(0xb8); em64(addr)  // mov rax, addr
                em(0x48); em(0x89); em(0x08)    // mov [rax], rcx
            } else {
                tc_undefined_var(name_tok)
            }
        }
        return
    }
    // ARRAY[idx] = expr (global array write)
    if stmt_is_array_store(EP) {
        let name_tok = EP
        if current_fn_allows_mutation() == false {
            tc_effect_violation(name_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[EP as usize]
        let ne = TE[EP as usize]
        EP = EP + 2  // skip name and [
        compile_or()  // index in rax
        if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }  // skip 'as usize'
        if TK[EP as usize] == 42 { EP = EP + 1 }  // skip ]
        if TK[EP as usize] == 16 { EP = EP + 1 }  // skip =
        em(0x50)  // push index
        compile_or()  // value in rax
        let gi = gl_find(ns, ne)
        if gi >= 0 {
            let base = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
            let esz = GL[(gi * 4 + 2) as usize]
            // rax = value, stack = index
            em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (value)
            em(0x59)  // pop rcx (index)
            em(0x48); em(0xb8); em64(base)  // mov rax, base
            if esz == 8 {
                em(0x48); em(0x89); em(0x14); em(0xc8)  // mov [rax + rcx*8], rdx
            } else {
                em(0x88); em(0x14); em(0x08)  // mov [rax + rcx], dl (byte store)
            }
        } else {
            // Local array store: ptr[idx] = val
            let lslot = var_find(ns, ne)
            if lslot >= 0 {
                let llalen = var_find_alen(ns, ne)
                let lesiz = var_find_esiz(ns, ne)
                let lvi = var_find_idx(ns, ne)
                var is_arr_ty = 0
                var is_slice_ty = 0
                if lvi >= 0 && VAR_TY[lvi as usize] == 8 { is_arr_ty = 1 }
                if lvi >= 0 && VAR_TY[lvi as usize] == 10 {
                    if ref_hash_inner_ty(VAR_TY_HASH[lvi as usize]) == 8 {
                        is_arr_ty = 1
                        if type_is_slice_ref(VAR_TY[lvi as usize], VAR_TY_HASH[lvi as usize]) { is_slice_ty = 1 }
                    }
                }
                em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (value)
                em(0x59)  // pop rcx (index)
                if is_slice_ty == 1 {
                    emit_load_var(VAR_LEN_SLOT[lvi as usize])
                    em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
                    em(0x0f); em(0x82); let slice_store_ok = CL; em32(0)
                    emit_assert_fail()
                    patch32(slice_store_ok, CL)
                }
                emit_load_var(lslot)  // load base ptr into rax
                if is_arr_ty == 1 && lesiz == 8 {
                    em(0x48); em(0x89); em(0x14); em(0xc8)  // mov [rax + rcx*8], rdx
                } else if is_arr_ty == 1 && lesiz == 1 {
                    em(0x88); em(0x14); em(0x08)  // mov [rax + rcx], dl
                } else {
                    // Non-array local pointer: byte store
                    em(0x88); em(0x14); em(0x08)  // mov [rax + rcx], dl
                }
            } else {
                tc_undefined_var(name_tok)
                em(0x59)  // discard pushed index
            }
        }
        return
    }

    // (*ARRAY_PTR)[idx] = expr
    if stmt_is_deref_array_store(EP) {
        let name_tok = EP + 2
        if current_fn_allows_mutation() == false {
            tc_effect_violation(name_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[(EP + 2) as usize]
        let ne = TE[(EP + 2) as usize]
        EP = EP + 5  // skip ( * name ) [
        compile_or()  // index in rax
        if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }  // skip 'as usize'
        if TK[EP as usize] == 42 { EP = EP + 1 }  // skip ]
        if TK[EP as usize] == 16 { EP = EP + 1 }  // skip =
        em(0x50)  // push index
        compile_or()  // value in rax
        let lslot = var_find(ns, ne)
        if lslot >= 0 {
            let lesiz = var_find_esiz(ns, ne)
            em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (value)
            em(0x59)  // pop rcx (index)
            emit_load_var(lslot)  // load array base ptr into rax
            if lesiz == 8 {
                em(0x48); em(0x89); em(0x14); em(0xc8)  // mov [rax + rcx*8], rdx
            } else {
                em(0x88); em(0x14); em(0x08)  // mov [rax + rcx], dl
            }
        } else {
            tc_undefined_var(name_tok)
            em(0x59)  // discard pushed index
        }
        return
    }
    // *PTR = expr
    if stmt_is_deref_store(EP) {
        let name_tok = EP + 1
        if current_fn_allows_mutation() == false {
            tc_effect_violation(name_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[(EP + 1) as usize]
        let ne = TE[(EP + 1) as usize]
        EP = EP + 2
        if TK[EP as usize] == 16 { EP = EP + 1 }
        compile_or()
        let rhs_ty = EXPR_TY
        let rhs_ty_hash = EXPR_TY_HASH
        let lslot = var_find(ns, ne)
        if lslot >= 0 {
            let lvi = var_find_idx(ns, ne)
            if lvi >= 0 && VAR_TY[lvi as usize] == 11 {
                let inner_ty = ptr_hash_inner_ty(VAR_TY_HASH[lvi as usize])
                let inner_hash = ptr_hash_inner_hash(VAR_TY_HASH[lvi as usize])
                if ty_eq(inner_ty, inner_hash, rhs_ty, rhs_ty_hash) == false {
                    tc_error(EP - 1, "assignment type mismatch")
                }
                if inner_ty == 8 || type_is_struct_like(inner_ty, inner_hash) {
                    tc_error(name_tok, "dereference assignment supports scalar pointer targets only")
                } else {
                    em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (value)
                    emit_load_var(lslot)
                    em(0x48); em(0x89); em(0x10)  // mov [rax], rdx
                }
            } else {
                tc_error(name_tok, "dereference assignment requires raw pointer binding")
            }
        } else {
            tc_undefined_var(name_tok)
        }
        return
    }
    // (*PTR).field = expr
    if stmt_is_deref_field_store(EP) {
        let name_tok = EP + 2
        let field_tok = EP + 5
        if current_fn_allows_mutation() == false {
            tc_effect_violation(field_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[name_tok as usize]
        let ne = TE[name_tok as usize]
        let fh = gl_name_hash(TS[field_tok as usize], TE[field_tok as usize])
        EP = EP + 7
        compile_or()
        let rhs_ty = EXPR_TY
        let rhs_ty_hash = EXPR_TY_HASH
        let lslot = var_find(ns, ne)
        if lslot >= 0 {
            let lvi = var_find_idx(ns, ne)
            if lvi >= 0 && VAR_TY[lvi as usize] == 11 {
                let inner_ty = ptr_hash_inner_ty(VAR_TY_HASH[lvi as usize])
                let inner_hash = ptr_hash_inner_hash(VAR_TY_HASH[lvi as usize])
                if inner_ty != 6 {
                    tc_error(field_tok, "field access through raw pointer requires struct pointee")
                } else {
                    let si = st_find(inner_hash)
                    if si < 0 {
                        tc_error(field_tok, "unknown field access")
                    } else {
                        let foff = st_field_offset(si, fh)
                        let fty = st_field_ty(si, fh)
                        let fhash = st_field_hash(si, fh)
                        if foff < 0 {
                            tc_error(field_tok, "unknown field access")
                        } else if ty_eq(fty, fhash, rhs_ty, rhs_ty_hash) == false {
                            tc_error(EP - 1, "assignment type mismatch")
                        } else if fty == 8 || type_is_struct_like(fty, fhash) {
                            tc_error(field_tok, "raw pointer field store supports scalar fields only")
                        } else {
                            em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (value)
                            emit_load_var(lslot)
                            if foff != 0 { em(0x48); em(0x8d); em(0x80); em32(foff) }
                            em(0x48); em(0x89); em(0x10)  // mov [rax], rdx
                        }
                    }
                }
            } else {
                tc_error(field_tok, "field access through raw pointer requires raw pointer binding")
            }
        } else {
            tc_undefined_var(name_tok)
        }
        return
    }

    // return expr
    if k == 2 {
        EP = EP + 1
        if TK[EP as usize] != 9 {
            compile_or()
        }
        else {
            em(0x31); em(0xc0)
            EXPR_TY = 5
            EXPR_TY_HASH = 0
        }
        if ty_eq(CURRENT_RET_TY, CURRENT_RET_HASH, EXPR_TY, EXPR_TY_HASH) == false {
            // Allow numeric coercions (i32→i64, unit→f64, etc.)
            if (ty_is_numeric(CURRENT_RET_TY) && ty_is_numeric(EXPR_TY)) == false {
                if (CURRENT_RET_TY != 0 || CURRENT_RET_HASH != 0) && (EXPR_TY != 0 || EXPR_TY_HASH != 0) {
                    if type_has_knowledge(CURRENT_RET_TY, CURRENT_RET_HASH) || type_has_knowledge(EXPR_TY, EXPR_TY_HASH) {
                        tc_epistemic_boundary(EP)
                    } else {
                        tc_error(EP - 1, "return type does not match function signature")
                    }
                }
            }
        }
        // Observation boundary: returning Unobserved<T> from non-Observe function
        if ty_is_unobserved(EXPR_TY) && !ty_is_unobserved(CURRENT_RET_TY) && (FN_EFFECTS[CURRENT_FN as usize] & 64) == 0 {
            tc_observe_boundary(EP - 1, "cannot return Unobserved<T> as non-Unobserved type")
        }
        if type_is_aggregate(CURRENT_RET_TY, CURRENT_RET_HASH) || type_is_aggregate(EXPR_TY, EXPR_TY_HASH) {
            stabilize_return_agg_x86(EXPR_TY, EXPR_TY_HASH)
        }
        // Linear type check at early return: any unconsumed linear var is an error
        var lce: i64 = 0
        while lce < VAR_COUNT {
            if VAR_LINEAR[lce as usize] == 1 && VAR_USED[lce as usize] == 0 {
                tc_linear_violation(EP - 1, "linear value not consumed")
            }
            lce = lce + 1
        }
        // GUM: copy return expression's variance to BSS_SCRATCH for caller
        if EXPR_VAR_SLOT >= 0 {
            emit_var_variance_to_scratch_x86(EXPR_VAR_SLOT)
        }
        em(0x48); em(0x81); em(0xc4); record_frame_patch(); em32(0)
        em(0x5d); em(0xc3)
        return
    }

    // continue (33)
    if k == 33 {
        EP = EP + 1
        if LOOP_DEPTH > 0 {
            em(0xe9)
            let rel = LOOP_TOP[(LOOP_DEPTH - 1) as usize] - (CL + 4)
            em32(rel)
        }
        return
    }

    // break (34) — emit jmp rel32 placeholder, patched when while loop ends
    if k == 34 {
        EP = EP + 1
        em(0xe9)  // jmp rel32
        BREAK_PATCH[BREAK_COUNT as usize] = CL
        BREAK_COUNT = BREAK_COUNT + 1
        em32(0)  // placeholder — patched by while handler
        return
    }

    if stmt_is_gpu_launch_perform(EP) {
        compile_gpu_launch_stmt_x86()
        return
    }

    if stmt_is_gpu_sync_perform(EP) {
        compile_gpu_sync_stmt_x86()
        return
    }

    // if expr { stmts } else if ... / else { stmts }
    if k == 13 {
        let if_tok = EP
        EP = EP + 1
        compile_or()
        if EXPR_TY != 0 && EXPR_TY != 4 { tc_error(EP - 1, "if condition must be bool") }
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x0f); em(0x84)
        let je_off = CL; em32(0)
        LAST_STMT_HAS_VALUE = 0
        LAST_STMT_TY = 0
        LAST_STMT_TY_HASH = 0
        // Snapshot VAR_USED + VAR_MOVED for linear branch tracking
        var lsnap: i64 = 0
        while lsnap < VAR_COUNT {
            CL_SAVE_USED[lsnap as usize] = VAR_USED[lsnap as usize]
            CL_SAVE_MUT[lsnap as usize] = VAR_MOVED[lsnap as usize]
            lsnap = lsnap + 1
        }
        if TK[EP as usize] == 8 { EP = EP + 1 }
        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
        let then_has_value = LAST_STMT_HAS_VALUE
        let then_ty = LAST_STMT_TY
        let then_hash = LAST_STMT_TY_HASH
        let then_conf = EXPR_CONFIDENCE
        if TK[EP as usize] == 9 { EP = EP + 1 }
        LAST_STMT_HAS_VALUE = 0
        LAST_STMT_TY = 0
        LAST_STMT_TY_HASH = 0
        if TK[EP as usize] == 14 {
            EP = EP + 1
            em(0xe9)
            let jmp_off = CL; em32(0)
            patch32(je_off, CL)
            // Save then-branch state, restore pre-branch snapshot for else
            var lthen: i64 = 0
            while lthen < VAR_COUNT {
                let then_used = VAR_USED[lthen as usize]
                let then_moved = VAR_MOVED[lthen as usize]
                VAR_USED[lthen as usize] = CL_SAVE_USED[lthen as usize]
                VAR_MOVED[lthen as usize] = CL_SAVE_MUT[lthen as usize]
                CL_SAVE_USED[lthen as usize] = then_used
                CL_SAVE_MUT[lthen as usize] = then_moved
                lthen = lthen + 1
            }
            // else if: recurse into compile_stmt which handles 'if'
            if TK[EP as usize] == 13 {
                compile_stmt()
            } else {
                LAST_STMT_HAS_VALUE = 0
                LAST_STMT_TY = 0
                LAST_STMT_TY_HASH = 0
                if TK[EP as usize] == 8 { EP = EP + 1 }
                while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
                if TK[EP as usize] == 9 { EP = EP + 1 }
            }
            // Linear branch asymmetry check: compare then vs else VAR_USED
            var lchk: i64 = 0
            while lchk < VAR_COUNT {
                if VAR_LINEAR[lchk as usize] == 1 {
                    let then_u = CL_SAVE_USED[lchk as usize]
                    let else_u = VAR_USED[lchk as usize]
                    if then_u > 0 && else_u == 0 {
                        tc_linear_violation(if_tok, "linear value consumed in then-branch but not else-branch")
                    }
                    if then_u == 0 && else_u > 0 {
                        tc_linear_violation(if_tok, "linear value consumed in else-branch but not then-branch")
                    }
                    // Merge: take the max so the function-end check sees "consumed"
                    if then_u > else_u { VAR_USED[lchk as usize] = then_u }
                }
                // Merge VAR_MOVED: only for linear/affine structs
                if VAR_LINEAR[lchk as usize] == 1 || VAR_AFFINE[lchk as usize] == 1 {
                    if CL_SAVE_MUT[lchk as usize] == 1 || VAR_MOVED[lchk as usize] == 1 {
                        VAR_MOVED[lchk as usize] = 1
                    }
                }
                lchk = lchk + 1
            }
            let else_has_value = LAST_STMT_HAS_VALUE
            let else_ty = LAST_STMT_TY
            let else_hash = LAST_STMT_TY_HASH
            let else_conf = EXPR_CONFIDENCE
            patch32(jmp_off, CL)
            if then_has_value == 1 && else_has_value == 1 && then_ty != 5 && else_ty != 5 {
                if ty_eq(then_ty, then_hash, else_ty, else_hash) == false {
                    tc_error(EP - 1, "if arm type does not match else arm")
                }
                LAST_STMT_HAS_VALUE = 1
                LAST_STMT_TY = then_ty
                LAST_STMT_TY_HASH = then_hash
                EXPR_TY = then_ty
                EXPR_TY_HASH = then_hash
                if then_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                // Epistemic: if-else result confidence = min(then, else)
                if then_conf < else_conf { EXPR_CONFIDENCE = then_conf }
                else { EXPR_CONFIDENCE = else_conf }
            } else {
                LAST_STMT_HAS_VALUE = 0
                LAST_STMT_TY = 0
                LAST_STMT_TY_HASH = 0
            }
        } else {
            // No else branch: if any linear var consumed in then-branch, error
            var lne: i64 = 0
            while lne < VAR_COUNT {
                if VAR_LINEAR[lne as usize] == 1 {
                    if VAR_USED[lne as usize] > 0 && CL_SAVE_USED[lne as usize] == 0 {
                        tc_linear_violation(if_tok, "linear value consumed in if-branch with no else — not consumed on all paths")
                    }
                }
                lne = lne + 1
            }
            patch32(je_off, CL)
            LAST_STMT_HAS_VALUE = 0
            LAST_STMT_TY = 0
            LAST_STMT_TY_HASH = 0
        }
        return
    }

    // while expr { stmts }
    if k == 15 {
        EP = EP + 1
        let loop_top = CL
        LOOP_TOP[LOOP_DEPTH as usize] = loop_top
        LOOP_DEPTH = LOOP_DEPTH + 1
        let saved_bc = BREAK_COUNT
        compile_or()
        if EXPR_TY != 0 && EXPR_TY != 4 { tc_error(EP - 1, "while condition must be bool") }
        em(0x48); em(0x85); em(0xc0)
        em(0x0f); em(0x84)
        let je_off = CL; em32(0)
        if TK[EP as usize] == 8 { EP = EP + 1 }
        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
        if TK[EP as usize] == 9 { EP = EP + 1 }
        em(0xe9)
        em32(loop_top - (CL + 4))
        patch32(je_off, CL)
        // Patch all break jumps from this loop to point here
        var bi: i64 = saved_bc
        while bi < BREAK_COUNT { patch32(BREAK_PATCH[bi as usize], CL); bi = bi + 1 }
        BREAK_COUNT = saved_bc
        LOOP_DEPTH = LOOP_DEPTH - 1
        // Epistemic: loop iteration amplifies uncertainty — degrade confidence by 5%
        EXPR_CONFIDENCE = EXPR_CONFIDENCE * 950 / 1000
        return
    }

    // for IDENT in range(START, END) { body }
    // for IDENT in START..END { body }
    // for IDENT in START..=END { body }   (inclusive)
    // Desugars to: var IDENT = START; while IDENT < END { body; IDENT = IDENT + 1 }
    if k == 54 {
        EP = EP + 1  // skip 'for'
        let vns = TS[EP as usize]
        let vne = TE[EP as usize]
        EP = EP + 1  // skip loop var name
        EP = EP + 1  // skip 'in'
        // Save slot base: both branches allocate iter at saved_next, end at saved_next+1
        let saved_next = NEXT_SLOT
        // Detect form: identifier followed by ( means range(START, END)
        if TK[EP as usize] == 3 && TK[(EP + 1) as usize] == 6 && src_match(TS[EP as usize], TE[EP as usize] - TS[EP as usize], "range") {
            // range(START, END) form
            EP = EP + 1  // skip 'range'
            EP = EP + 1  // skip (
            compile_or()  // START in rax
            if EXPR_TY != 0 && EXPR_TY != 1 { tc_error(EP - 1, "for range start must be integer") }
            let iter_slot_a = var_add(vns, vne)
            if iter_slot_a < 0 { return }
            VAR_TY[(VAR_COUNT - 1) as usize] = 1
            VAR_TY_HASH[(VAR_COUNT - 1) as usize] = 0
            emit_store_var(iter_slot_a)
            if TK[EP as usize] == 28 { EP = EP + 1 }  // skip comma
            compile_or()  // END in rax
            if EXPR_TY != 0 && EXPR_TY != 1 { tc_error(EP - 1, "for range end must be integer") }
            let end_slot_a = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var(end_slot_a)
            if TK[EP as usize] == 7 { EP = EP + 1 }  // skip )
        } else {
            // START..END or START..=END form
            compile_or()  // START in rax
            if EXPR_TY != 0 && EXPR_TY != 1 { tc_error(EP - 1, "for range start must be integer") }
            let iter_slot_r = var_add(vns, vne)
            if iter_slot_r < 0 { return }
            VAR_TY[(VAR_COUNT - 1) as usize] = 1
            VAR_TY_HASH[(VAR_COUNT - 1) as usize] = 0
            emit_store_var(iter_slot_r)
            var is_inclusive: i64 = 0
            if TK[EP as usize] == 64 { is_inclusive = 1 }
            if TK[EP as usize] == 63 || TK[EP as usize] == 64 { EP = EP + 1 }
            compile_or()  // END in rax
            if EXPR_TY != 0 && EXPR_TY != 1 { tc_error(EP - 1, "for range end must be integer") }
            if is_inclusive != 0 {
                em(0x48); em(0x83); em(0xc0); em(1)  // add rax, 1
            }
            let end_slot_r = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var(end_slot_r)
        }
        // Both branches allocate: iter at saved_next, end at saved_next+1
        let iter_slot = saved_next
        let end_slot = saved_next + 1
        // For-loop structure: jmp cond; incr: iter++; cond: cmp; jge end; body; jmp incr; end:
        // This ensures 'continue' jumps to incr (not cond), so iter always increments.
        em(0xe9)
        let jmp_cond_off = CL; em32(0)  // jmp cond (patched below)
        // incr: — continue target
        let incr_addr = CL
        LOOP_TOP[LOOP_DEPTH as usize] = incr_addr
        LOOP_DEPTH = LOOP_DEPTH + 1
        let saved_bc = BREAK_COUNT
        emit_load_var(iter_slot)
        em(0x48); em(0x83); em(0xc0); em(1)  // add rax, 1
        emit_store_var(iter_slot)
        // cond:
        let cond_addr = CL
        patch32(jmp_cond_off, cond_addr)
        emit_load_var(iter_slot)
        em(0x50)  // push iter
        emit_load_var(end_slot)
        em(0x59)  // pop rcx (iter)
        em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
        em(0x0f); em(0x9c); em(0xc0)  // setl al
        em(0x48); em(0x0f); em(0xb6); em(0xc0)  // movzx rax, al
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x0f); em(0x84)
        let je_off = CL; em32(0)  // jz end
        if TK[EP as usize] == 8 { EP = EP + 1 }  // skip {
        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
        if TK[EP as usize] == 9 { EP = EP + 1 }  // skip }
        // jmp incr
        em(0xe9)
        em32(incr_addr - (CL + 4))
        // end:
        patch32(je_off, CL)
        var bi: i64 = saved_bc
        while bi < BREAK_COUNT { patch32(BREAK_PATCH[bi as usize], CL); bi = bi + 1 }
        BREAK_COUNT = saved_bc
        LOOP_DEPTH = LOOP_DEPTH - 1
        // Epistemic: loop iteration amplifies uncertainty — degrade confidence by 5%
        EXPR_CONFIDENCE = EXPR_CONFIDENCE * 950 / 1000
        return
    }

    // match expr { pattern => body, ... }
    // 48 = match keyword
    if k == 48 {
        EP = EP + 1
        compile_or()  // scrutinee in rax
        MATCH_SCRUT_TY = EXPR_TY
        MATCH_SCRUT_HASH = EXPR_TY_HASH
        // Store scrutinee in a local var (not stack — return inside arm would break stack)
        let match_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        emit_store_var(match_slot)
        if TK[EP as usize] == 8 { EP = EP + 1 }  // skip {
        var arm_count: i64 = 0
        var match_ty: i64 = 0
        var match_hash: i64 = 0
        var match_have_ty: i64 = 0
        var match_all_value: i64 = 1
        var match_arms: i64 = 0
        var match_min_conf: i64 = 1000
        while TK[EP as usize] != 9 && TK[EP as usize] != 0 {
            var is_wildcard: i64 = 0
            var disc: i64 = -1
            var arm_is_tagged: i64 = 0
            var bind_ns: i64 = 0
            var bind_ne: i64 = 0
            var has_binding: i64 = 0
            let arm_tk = TK[EP as usize]
            // Some(v) pattern — tag=1, bind inner value
            if arm_tk == 57 {
                EP = EP + 1
                disc = 1
                arm_is_tagged = 1
                if TK[EP as usize] == 6 {
                    EP = EP + 1
                    bind_ns = TS[EP as usize]
                    bind_ne = TE[EP as usize]
                    has_binding = 1
                    EP = EP + 1
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                }
            }
            // None pattern — tag=0
            if arm_tk == 58 {
                EP = EP + 1
                disc = 0
                arm_is_tagged = 1
            }
            // Ok(v) pattern — tag=0, bind payload
            if arm_tk == 59 {
                EP = EP + 1
                disc = 0
                arm_is_tagged = 1
                if TK[EP as usize] == 6 {
                    EP = EP + 1
                    bind_ns = TS[EP as usize]
                    bind_ne = TE[EP as usize]
                    has_binding = 1
                    EP = EP + 1
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                }
            }
            // Err(e) pattern — tag=1, bind payload
            if arm_tk == 60 {
                EP = EP + 1
                disc = 1
                arm_is_tagged = 1
                if TK[EP as usize] == 6 {
                    EP = EP + 1
                    bind_ns = TS[EP as usize]
                    bind_ne = TE[EP as usize]
                    has_binding = 1
                    EP = EP + 1
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                }
            }
            if arm_tk == 3 {
                let pns = TS[EP as usize]
                let pne = TE[EP as usize]
                if pne - pns == 1 && sb(pns) == 95 {
                    is_wildcard = 1; EP = EP + 1
                } else if TK[(EP + 1) as usize] == 51 {
                    let eh = gl_name_hash(pns, pne)
                    EP = EP + 2
                    let vh = gl_name_hash(TS[EP as usize], TE[EP as usize])
                    EP = EP + 1
                    disc = en_variant_value(eh, vh)
                } else { EP = EP + 1 }
            }
            if arm_tk == 4 {
                disc = TV[EP as usize]; EP = EP + 1
            }
            if arm_tk != 57 && arm_tk != 58 && arm_tk != 59 && arm_tk != 60 && arm_tk != 3 && arm_tk != 4 { EP = EP + 1 }
            if disc >= 0 {
                if arm_is_tagged == 1 {
                    // Tagged union match: load tag from [scrutinee + 0]
                    emit_load_var(match_slot)
                    em(0x48); em(0x8b); em(0x00)  // mov rax, [rax] (tag)
                    em(0x50)  // push tag
                    em(0x48); em(0xb8); em64(disc)
                    em(0x59)  // pop rcx (tag)
                    em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
                    em(0x0f); em(0x85); let skip_patch = CL; em32(0)  // jne skip
                    // Bind inner value if pattern has binding
                    if has_binding == 1 {
                        emit_load_var(match_slot)
                        em(0x48); em(0x8b); em(0x40); em(0x08)  // mov rax, [rax + 8] (value)
                        let bslot = var_add(bind_ns, bind_ne)
                        if bslot >= 0 { emit_store_var(bslot) }
                    }
                    if TK[EP as usize] == 52 { EP = EP + 1 }  // skip =>
                    var arm_has_block: i64 = 0
                    if TK[EP as usize] == 8 { arm_has_block = 1; EP = EP + 1 }
                    LAST_STMT_HAS_VALUE = 0
                    if arm_has_block == 1 {
                        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
                        if TK[EP as usize] == 9 { EP = EP + 1 }
                    } else {
                        compile_stmt()
                    }
                    match_arms = match_arms + 1
                    if EXPR_CONFIDENCE < match_min_conf { match_min_conf = EXPR_CONFIDENCE }
                    if LAST_STMT_HAS_VALUE == 1 {
                        if match_have_ty == 0 {
                            match_have_ty = 1
                            match_ty = LAST_STMT_TY
                            match_hash = LAST_STMT_TY_HASH
                        } else if ty_eq(match_ty, match_hash, LAST_STMT_TY, LAST_STMT_TY_HASH) == false {
                            tc_error(EP - 1, "match arm type does not match other arms")
                        }
                    } else {
                        match_all_value = 0
                    }
                    em(0xe9); MATCH_ENDS[arm_count as usize] = CL; em32(0)
                    arm_count = arm_count + 1
                    patch32(skip_patch, CL)
                } else {
                    // Plain enum/integer match: compare scrutinee directly
                    emit_load_var(match_slot)
                    em(0x50)
                    em(0x48); em(0xb8); em64(disc)
                    em(0x59)
                    em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
                    em(0x0f); em(0x85); let skip_patch = CL; em32(0)  // jne skip
                    if TK[EP as usize] == 52 { EP = EP + 1 }  // skip =>
                    var arm_has_block2: i64 = 0
                    if TK[EP as usize] == 8 { arm_has_block2 = 1; EP = EP + 1 }
                    LAST_STMT_HAS_VALUE = 0
                    if arm_has_block2 == 1 {
                        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
                        if TK[EP as usize] == 9 { EP = EP + 1 }
                    } else {
                        compile_stmt()
                    }
                    match_arms = match_arms + 1
                    if EXPR_CONFIDENCE < match_min_conf { match_min_conf = EXPR_CONFIDENCE }
                    if LAST_STMT_HAS_VALUE == 1 {
                        if match_have_ty == 0 {
                            match_have_ty = 1
                            match_ty = LAST_STMT_TY
                            match_hash = LAST_STMT_TY_HASH
                        } else if ty_eq(match_ty, match_hash, LAST_STMT_TY, LAST_STMT_TY_HASH) == false {
                            tc_error(EP - 1, "match arm type does not match other arms")
                        }
                    } else {
                        match_all_value = 0
                    }
                    em(0xe9); MATCH_ENDS[arm_count as usize] = CL; em32(0)
                    arm_count = arm_count + 1
                    patch32(skip_patch, CL)
                }
            }
            if is_wildcard == 1 {
                if match_arms < 1000000 { match_arms = 1000000 }
                if TK[EP as usize] == 52 { EP = EP + 1 }
                var arm_has_block3: i64 = 0
                if TK[EP as usize] == 8 { arm_has_block3 = 1; EP = EP + 1 }
                LAST_STMT_HAS_VALUE = 0
                if arm_has_block3 == 1 {
                    while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
                    if TK[EP as usize] == 9 { EP = EP + 1 }
                } else {
                    compile_stmt()
                }
                match_arms = match_arms + 1
                if EXPR_CONFIDENCE < match_min_conf { match_min_conf = EXPR_CONFIDENCE }
                if LAST_STMT_HAS_VALUE == 1 {
                    if match_have_ty == 0 {
                        match_have_ty = 1
                        match_ty = LAST_STMT_TY
                        match_hash = LAST_STMT_TY_HASH
                    } else if ty_eq(match_ty, match_hash, LAST_STMT_TY, LAST_STMT_TY_HASH) == false {
                        tc_error(EP - 1, "match arm type does not match other arms")
                    }
                } else {
                    match_all_value = 0
                }
            }
            if TK[EP as usize] == 28 { EP = EP + 1 }
        }
        if TK[EP as usize] == 9 { EP = EP + 1 }
        var ai: i64 = 0
        while ai < arm_count { patch32(MATCH_ENDS[ai as usize], CL); ai = ai + 1 }
        if MATCH_SCRUT_TY == 7 && match_arms < 1000000 && match_arms < en_variant_count(MATCH_SCRUT_HASH) {
            tc_error(EP - 1, "match must be exhaustive")
            LAST_STMT_HAS_VALUE = 0
            LAST_STMT_TY = 0
            LAST_STMT_TY_HASH = 0
            return
        }
        if match_arms > 0 && match_all_value == 1 && match_have_ty == 1 {
            LAST_STMT_HAS_VALUE = 1
            LAST_STMT_TY = match_ty
            LAST_STMT_TY_HASH = match_hash
            EXPR_TY = match_ty
            EXPR_TY_HASH = match_hash
            if match_ty == 2 { EXPR_IS_F64 = 1 }
            else { EXPR_IS_F64 = 0 }
            // Epistemic: match result confidence = min across all arms
            EXPR_CONFIDENCE = match_min_conf
        }
        return
    }

    // Expression statement
    compile_or()
    LAST_STMT_HAS_VALUE = 1
    LAST_STMT_TY = EXPR_TY
    LAST_STMT_TY_HASH = EXPR_TY_HASH
}

// ─── Epistemic Type System: Core Functions ───
// GUM-quantified type inference — the compiler is Patient Zero.

fn ety_clamp(c: i64) -> i64 {
    if c < 0 { return 0 }
    if c > 1000 { return 1000 }
    return c
}

fn ety_isqrt(n: i64) -> i64 with Div {
    // Integer square root (Newton-Raphson) for GUM quadrature
    if n <= 0 { return 0 }
    if n == 1 { return 1 }
    var x: i64 = n / 2 + 1
    var prev: i64 = x + 1
    while x < prev {
        prev = x
        x = (x + n / x) / 2
    }
    return prev
}

fn ety_alloc(kind: i64, conf: i64, unc: i64) -> i64 with Mut {
    // Allocate a new type in the epistemic pool
    let id = ETY_COUNT
    if id >= 16384 { return 0 }
    ETY_KIND[id as usize] = kind
    ETY_CONF[id as usize] = ety_clamp(conf)
    ETY_UNC[id as usize] = ety_clamp(unc)
    ETY_HASH[id as usize] = 0
    ETY_COUNT = ETY_COUNT + 1
    return id
}

fn ety_mk_i64() -> i64 with Mut { return ety_alloc(1, 1000, 0) }
fn ety_mk_f64() -> i64 with Mut { return ety_alloc(2, 1000, 0) }
fn ety_mk_bool() -> i64 with Mut { return ety_alloc(3, 1000, 0) }
fn ety_mk_string() -> i64 with Mut { return ety_alloc(4, 1000, 0) }
fn ety_mk_void() -> i64 with Mut { return ety_alloc(5, 1000, 0) }
fn ety_mk_unknown() -> i64 with Mut { return ety_alloc(0, 0, 1000) }

fn ety_conf(id: i64) -> i64 {
    if id < 0 || id >= ETY_COUNT { return 0 }
    return ETY_CONF[id as usize]
}

fn ety_kind(id: i64) -> i64 {
    if id < 0 || id >= ETY_COUNT { return 0 }
    return ETY_KIND[id as usize]
}

// GUM confidence propagation: product rule (uncertainty compounds)
fn ety_conf_product(c_a: i64, c_b: i64) -> i64 {
    return ety_clamp((c_a * c_b) / 1000)
}

// GUM uncertainty combination: RSS (root sum of squares)
fn ety_unc_combine(u_a: i64, u_b: i64) -> i64 with Div {
    return ety_clamp(ety_isqrt(u_a * u_a + u_b * u_b))
}

// Epistemic scope operations
fn escope_push() with Mut {
    ESCOPE_LEVEL = ESCOPE_LEVEL + 1
}

fn escope_pop() with Mut {
    // Remove all entries at current level
    while ESCOPE_COUNT > 0 && ESCOPE_DEPTH[(ESCOPE_COUNT - 1) as usize] == ESCOPE_LEVEL {
        ESCOPE_COUNT = ESCOPE_COUNT - 1
    }
    ESCOPE_LEVEL = ESCOPE_LEVEL - 1
}

fn escope_add(name_hash: i64, ty_id: i64, conf: i64) with Mut {
    if ESCOPE_COUNT >= 2048 { return }
    ESCOPE_HASH[ESCOPE_COUNT as usize] = name_hash
    ESCOPE_TY[ESCOPE_COUNT as usize] = ty_id
    ESCOPE_CONF[ESCOPE_COUNT as usize] = conf
    ESCOPE_DEPTH[ESCOPE_COUNT as usize] = ESCOPE_LEVEL
    ESCOPE_COUNT = ESCOPE_COUNT + 1
}

fn escope_find(name_hash: i64) -> i64 with Mut {
    // Returns index, or -1 if not found. Searches backward (innermost scope first).
    var i: i64 = ESCOPE_COUNT - 1
    while i >= 0 {
        if ESCOPE_HASH[i as usize] == name_hash { return i }
        i = i - 1
    }
    return -1
}

// ─── Gen 1: Epistemic Inference with GUM Propagation ───
// Literals: confidence 1000 (axiomatic).
// Variables: look up in epistemic scope → inherit confidence.
// Binary ops: GUM product (confidence compounds serially).
// Function calls: GUM product of arg confidences × callee effect confidence.
// Unification: GUM weighted average (parallel measurements).
// No codegen changes yet — EXPR_GATE computed but not consumed.

// Bridge: lean_single type_name_kind → epistemic type IDs
// type_name_kind: 1=int, 2=float, 3=string, 4=bool, 5=unit, 6=struct, 7=enum
// epistemic:      0=unknown, 1=i64, 2=f64, 3=bool, 4=string, 5=void
fn ety_from_tnk(tnk: i64) -> i64 {
    if tnk == 1 { return 1 }
    if tnk == 2 { return 2 }
    if tnk == 3 { return 4 }
    if tnk == 4 { return 3 }
    if tnk == 5 { return 5 }
    return 0
}

// GUM-correct unification (Grok's weighted average + DeepSeek's dispatch)
var EUNIFY_CONF: i64 = 0
fn ety_unify(ty_a: i64, conf_a: i64, ty_b: i64, conf_b: i64) -> i64 with Mut, Div {
    // Unknown adopts the other type
    if ety_kind(ty_a) == 0 { EUNIFY_CONF = 0; return ty_b }
    if ety_kind(ty_b) == 0 { EUNIFY_CONF = 0; return ty_a }
    // Types match: confidence-squared weighted average
    if ety_kind(ty_a) == ety_kind(ty_b) {
        var num: i64 = (conf_a * conf_a) + (conf_b * conf_b)
        var den: i64 = conf_a + conf_b + 1
        EUNIFY_CONF = ety_clamp(num / den)
        return ty_a
    }
    // Numeric promotion i64 → f64
    if (ety_kind(ty_a) == 1 && ety_kind(ty_b) == 2) || (ety_kind(ty_a) == 2 && ety_kind(ty_b) == 1) {
        var num: i64 = (conf_a * conf_a) + (conf_b * conf_b)
        var den: i64 = conf_a + conf_b + 1
        EUNIFY_CONF = ety_clamp(num / den)
        return 2
    }
    // Type conflict: confidence crashes, return higher-confidence type
    EUNIFY_CONF = 0
    if conf_a > conf_b { return ty_a }
    return ty_b
}

// Effect bitset parsing from function signatures
fn ety_parse_effect_name(ns: i64, ne: i64) -> i64 with Panic, Mut {
    let l = ne - ns
    if src_match(ns, l, "IO") { return 1 }
    if src_match(ns, l, "Mut") { return 2 }
    if src_match(ns, l, "Panic") { return 4 }
    if src_match(ns, l, "Div") { return 8 }
    if src_match(ns, l, "Alloc") { return 16 }
    if src_match(ns, l, "Async") { return 32 }
    if src_match(ns, l, "Observe") { return 64 }
    return 0
}

fn epistemic_infer_pass() with IO, Mut, Panic, Div {
    // Pre-allocate canonical types (IDs 0-5)
    ETY_COUNT = 0
    ESCOPE_COUNT = 0
    ESCOPE_LEVEL = 0
    GATE_THRESHOLD = 950
    let ty_unknown = ety_mk_unknown()  // 0
    let ty_i64 = ety_mk_i64()          // 1
    let ty_f64 = ety_mk_f64()          // 2
    let ty_bool = ety_mk_bool()        // 3
    let ty_string = ety_mk_string()    // 4
    let ty_void = ety_mk_void()        // 5
    EPIST_TOTAL_EXPR = 0
    EPIST_HIGH_CONF = 0
    EPIST_LOW_CONF = 0

    // Phase A: Collect effect declarations for all registered functions
    var fi: i64 = 0
    while fi < FN_COUNT {
        FN_DECL_EFF[fi as usize] = 0
        FN_USED_EFF[fi as usize] = 0
        FN_EFF_CONF[fi as usize] = 1000
        // Scan from fn name token forward to find 'with' clause
        let fn_tok = FN_NAME_TOK[fi as usize]
        if fn_tok > 0 {
            var q: i64 = fn_tok
            while q < TC && TK[q as usize] != 8 && TK[q as usize] != 0 {
                if TK[q as usize] == 38 {
                    // 'with' keyword found — parse effects
                    q = q + 1
                    while q < TC && TK[q as usize] == 3 {
                        let eff = ety_parse_effect_name(TS[q as usize], TE[q as usize])
                        FN_DECL_EFF[fi as usize] = FN_DECL_EFF[fi as usize] | eff
                        q = q + 1
                        if q < TC && TK[q as usize] == 28 { q = q + 1 }
                    }
                    break
                }
                q = q + 1
            }
        }
        fi = fi + 1
    }

    // Phase B: Walk all tokens, assign epistemic types
    // Gen 1: literals + variables (via scope) + binary op GUM propagation
    var p: i64 = 0
    var depth: i64 = 0
    while p < TC {
        let tk = TK[p as usize]

        // Track brace depth for scope
        if tk == 8 { escope_push(); depth = depth + 1; p = p + 1; continue }
        if tk == 9 { escope_pop(); depth = depth - 1; p = p + 1; continue }

        // Identifiers in declaration/structural positions — mark confident
        if tk == 3 && p > 0 {
            let prev = TK[(p - 1) as usize]
            // After fn, struct, enum, pub, linear, affine: declaration name
            if prev == 1 || prev == 46 || prev == 47 || prev == 49 || prev == 62 || prev == 73 {
                EXPR_ETY[p as usize] = ty_void
                EXPR_CONF[p as usize] = 1000
                EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
                if prev != 1 { p = p + 1; continue }
            }
            // After '.' — field access
            if prev == 50 {
                EXPR_ETY[p as usize] = ty_void
                EXPR_CONF[p as usize] = 1000
                EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
                p = p + 1
                continue
            }
            // After 'let' or 'var': variable declaration name
            if prev == 11 || prev == 12 {
                EXPR_ETY[p as usize] = ty_void
                EXPR_CONF[p as usize] = 1000
                EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
                p = p + 1
                continue
            }
            // After ':' or '->' — type position
            if prev == 43 || prev == 10 {
                EXPR_ETY[p as usize] = ty_void
                EXPR_CONF[p as usize] = 1000
                EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
                p = p + 1
                continue
            }
            // After ',' in a type/param context — also type position
            // (handles multi-param: fn f(a: i64, b: i64) — 'b' follows ',')
            // After another ident that was just a type name — chain types
            // After 'with' — effect names (IO, Mut, Panic, etc.)
            if prev == 38 {
                EXPR_ETY[p as usize] = ty_void
                EXPR_CONF[p as usize] = 1000
                EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
                p = p + 1
                continue
            }
            // After '<' — generic type parameters
            if prev == 23 {
                EXPR_ETY[p as usize] = ty_void
                EXPR_CONF[p as usize] = 1000
                EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
                p = p + 1
                continue
            }
            // After '[' — array element type (e.g., [i8; N])
            if prev == 41 {
                EXPR_ETY[p as usize] = ty_void
                EXPR_CONF[p as usize] = 1000
                EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
                p = p + 1
                continue
            }
            // After ']' — post array type
            if prev == 42 {
                EXPR_ETY[p as usize] = ty_void
                EXPR_CONF[p as usize] = 1000
                EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
                p = p + 1
                continue
            }
        }

        // Function declaration: bind parameters into epistemic scope
        // fn NAME ( param1: type1, param2: type2 ) -> ret { body }
        if tk == 1 && p + 1 < TC && TK[(p + 1) as usize] == 3 {
            // Mark fn name as confident
            EXPR_ETY[(p + 1) as usize] = ty_void
            EXPR_CONF[(p + 1) as usize] = 1000
            // Skip 'fn' and name
            var fp: i64 = p + 2
            // Skip generic params <T> if present
            if fp < TC && TK[fp as usize] == 23 {
                while fp < TC && TK[fp as usize] != 24 { fp = fp + 1 }
                if fp < TC { fp = fp + 1 }
            }
            // Expect '('
            if fp < TC && TK[fp as usize] == 6 {
                fp = fp + 1
                // Parse parameter list: name : type , name : type , ...
                while fp < TC && TK[fp as usize] != 7 && TK[fp as usize] != 0 {
                    // Expect parameter name (identifier)
                    if TK[fp as usize] == 3 {
                        let pns = TS[fp as usize]
                        let pne = TE[fp as usize]
                        let pnh = gl_name_hash(pns, pne)
                        fp = fp + 1
                        var param_ty: i64 = ty_unknown
                        var param_conf: i64 = 0
                        // Expect ':'
                        if fp < TC && TK[fp as usize] == 43 {
                            fp = fp + 1
                            // Parse type — handle &, &!, [T; N], etc.
                            // Skip reference markers
                            if fp < TC && TK[fp as usize] == 44 { fp = fp + 1 }
                            if fp < TC && TK[fp as usize] == 32 { fp = fp + 1 }
                            if fp < TC && TK[fp as usize] == 3 {
                                let ptns = TS[fp as usize]
                                let ptne = TE[fp as usize]
                                if src_match(ptns, ptne - ptns, "i64") { param_ty = ty_i64; param_conf = 1000 }
                                if src_match(ptns, ptne - ptns, "i32") { param_ty = ty_i64; param_conf = 1000 }
                                if src_match(ptns, ptne - ptns, "i8") { param_ty = ty_i64; param_conf = 1000 }
                                if src_match(ptns, ptne - ptns, "u64") { param_ty = ty_i64; param_conf = 1000 }
                                if src_match(ptns, ptne - ptns, "usize") { param_ty = ty_i64; param_conf = 1000 }
                                if src_match(ptns, ptne - ptns, "f64") { param_ty = ty_f64; param_conf = 1000 }
                                if src_match(ptns, ptne - ptns, "f32") { param_ty = ty_f64; param_conf = 1000 }
                                if src_match(ptns, ptne - ptns, "bool") { param_ty = ty_bool; param_conf = 1000 }
                                if src_match(ptns, ptne - ptns, "string") { param_ty = ty_string; param_conf = 1000 }
                                fp = fp + 1
                            } else if fp < TC && TK[fp as usize] == 41 {
                                // Array type [T; N] — skip to ]
                                while fp < TC && TK[fp as usize] != 42 { fp = fp + 1 }
                                if fp < TC { fp = fp + 1 }
                                param_ty = ty_i64
                                param_conf = 1000
                            }
                        }
                        escope_add(pnh, param_ty, param_conf)
                        // Skip comma
                        if fp < TC && TK[fp as usize] == 28 { fp = fp + 1 }
                        continue
                    }
                    fp = fp + 1
                }
            }
            // Don't advance p — let the normal walk continue through fn tokens
            p = p + 1
            continue
        }

        // Keywords that are structural (not expressions): mark confident
        // return, continue, break, while, if, else, for, match, pub, linear
        if tk == 2 || tk == 33 || tk == 34 || tk == 15 || tk == 13 || tk == 14 || tk == 54 || tk == 48 || tk == 49 || tk == 62 || tk == 46 || tk == 47 || tk == 38 || tk == 70 || tk == 71 || tk == 72 || tk == 61 || tk == 75 || tk == 76 {
            EXPR_ETY[p as usize] = ty_void
            EXPR_CONF[p as usize] = 1000
            EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
            EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
            p = p + 1
            continue
        }

        // Delimiters and punctuation: confident (structural, not epistemic)
        // ( ) , ; . :: => ..  ..=  ~
        if tk == 6 || tk == 7 || tk == 28 || tk == 27 || tk == 50 || tk == 51 || tk == 52 || tk == 63 || tk == 64 || tk == 55 || tk == 16 {
            EXPR_ETY[p as usize] = ty_void
            EXPR_CONF[p as usize] = 1000
            EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
            EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
            p = p + 1
            continue
        }

        // Some/None/Ok/Err — enum constructors, always confident
        if tk == 57 || tk == 58 || tk == 59 || tk == 60 {
            EXPR_ETY[p as usize] = ty_i64
            EXPR_CONF[p as usize] = 1000
            EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
            EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
            p = p + 1
            continue
        }

        // Integer literal → i64, confidence 1000
        if tk == 4 {
            EXPR_ETY[p as usize] = ty_i64
            EXPR_CONF[p as usize] = 1000
            EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
            EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
            p = p + 1
            continue
        }

        // Float literal → f64, confidence 1000
        if tk == 53 {
            EXPR_ETY[p as usize] = ty_f64
            EXPR_CONF[p as usize] = 1000
            EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
            EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
            p = p + 1
            continue
        }

        // String literal → string, confidence 1000
        if tk == 5 {
            EXPR_ETY[p as usize] = ty_string
            EXPR_CONF[p as usize] = 1000
            EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
            EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
            p = p + 1
            continue
        }

        // true/false → bool, confidence 1000
        if tk == 35 || tk == 36 {
            EXPR_ETY[p as usize] = ty_bool
            EXPR_CONF[p as usize] = 1000
            EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
            EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
            p = p + 1
            continue
        }

        // let/var binding: register variable with RHS confidence propagation
        if tk == 11 || tk == 12 {
            // let/var NAME [: TYPE] = EXPR
            if p + 1 < TC && TK[(p + 1) as usize] == 3 {
                let name_ns = TS[(p + 1) as usize]
                let name_ne = TE[(p + 1) as usize]
                let nh = gl_name_hash(name_ns, name_ne)
                var bind_ty: i64 = ty_unknown
                var bind_conf: i64 = 0
                // Check for type annotation: NAME : TYPE
                var anno_end: i64 = p + 2
                if p + 2 < TC && TK[(p + 2) as usize] == 43 {
                    // Has type annotation → confidence from annotation
                    if p + 3 < TC && TK[(p + 3) as usize] == 3 {
                        let tns = TS[(p + 3) as usize]
                        let tne = TE[(p + 3) as usize]
                        if src_match(tns, tne - tns, "i64") { bind_ty = ty_i64; bind_conf = 1000 }
                        if src_match(tns, tne - tns, "f64") { bind_ty = ty_f64; bind_conf = 1000 }
                        if src_match(tns, tne - tns, "bool") { bind_ty = ty_bool; bind_conf = 1000 }
                        if src_match(tns, tne - tns, "string") { bind_ty = ty_string; bind_conf = 1000 }
                    }
                    // Skip past type annotation to find '='
                    anno_end = p + 3
                    // Skip array types [T; N] and compound types
                    while anno_end < TC && TK[anno_end as usize] != 16 && TK[anno_end as usize] != 8 && TK[anno_end as usize] != 0 {
                        anno_end = anno_end + 1
                    }
                }
                // Scan forward to find '=' and RHS expression
                var eq_pos: i64 = anno_end
                if eq_pos < p + 2 { eq_pos = p + 2 }
                while eq_pos < TC && TK[eq_pos as usize] != 16 && TK[eq_pos as usize] != 8 && TK[eq_pos as usize] != 0 {
                    eq_pos = eq_pos + 1
                }
                if eq_pos < TC && TK[eq_pos as usize] == 16 {
                    // Found '=' — look at RHS token for confidence
                    let rhs = eq_pos + 1
                    if rhs < TC {
                        let rhs_tk = TK[rhs as usize]
                        var rhs_conf: i64 = 0
                        var rhs_ty: i64 = ty_unknown
                        // Literal RHS
                        if rhs_tk == 4 { rhs_ty = ty_i64; rhs_conf = 1000 }
                        if rhs_tk == 53 { rhs_ty = ty_f64; rhs_conf = 1000 }
                        if rhs_tk == 5 { rhs_ty = ty_string; rhs_conf = 1000 }
                        if rhs_tk == 35 || rhs_tk == 36 { rhs_ty = ty_bool; rhs_conf = 1000 }
                        // Negated literal: -42 or -1.0
                        if rhs_tk == 18 && rhs + 1 < TC {
                            let nlk = TK[(rhs + 1) as usize]
                            if nlk == 4 { rhs_ty = ty_i64; rhs_conf = 1000 }
                            else if nlk == 53 { rhs_ty = ty_f64; rhs_conf = 1000 }
                        }
                        // Struct literal RHS: StructName { ... }
                        if rhs_tk == 3 && rhs + 1 < TC && TK[(rhs + 1) as usize] == 8 {
                            let slh = gl_name_hash(TS[rhs as usize], TE[rhs as usize])
                            if st_find(slh) >= 0 { rhs_ty = ty_void; rhs_conf = 1000 }
                        }
                        // Function call RHS: ident( — already inferred by left-to-right walk?
                        // No — we haven't visited RHS yet. But if RHS is a function call,
                        // we can look up the function's return type directly.
                        if rhs_tk == 3 && rhs + 1 < TC && TK[(rhs + 1) as usize] == 6 {
                            // RHS is a function call — look up return type
                            let rns = TS[rhs as usize]
                            let rne = TE[rhs as usize]
                            var rfj: i64 = 0
                            while rfj < FN_COUNT {
                                if name_eq(FN_NS[rfj as usize], FN_NE[rfj as usize], rns, rne) {
                                    rhs_ty = ety_from_tnk(FN_RET_TY[rfj as usize])
                                    rhs_conf = FN_EFF_CONF[rfj as usize]
                                    if rhs_ty == 0 { rhs_conf = 0 }
                                    break
                                }
                                rfj = rfj + 1
                            }
                        }
                        // Array index RHS: arr[idx] — look up array in globals/scope
                        if rhs_tk == 3 && rhs + 1 < TC && TK[(rhs + 1) as usize] == 41 {
                            let arh = gl_name_hash(TS[rhs as usize], TE[rhs as usize])
                            let agi = gl_find(TS[rhs as usize], TE[rhs as usize])
                            if agi >= 0 {
                                rhs_ty = ty_i64
                                rhs_conf = 1000
                            } else {
                                let avri = escope_find(arh)
                                if avri >= 0 { rhs_ty = ESCOPE_TY[avri as usize]; rhs_conf = ESCOPE_CONF[avri as usize] }
                            }
                        }
                        // Variable RHS: look up in scope
                        if rhs_tk == 3 && (rhs + 1 >= TC || (TK[(rhs + 1) as usize] != 6 && TK[(rhs + 1) as usize] != 41 && TK[(rhs + 1) as usize] != 8)) {
                            let vrh = gl_name_hash(TS[rhs as usize], TE[rhs as usize])
                            let vri = escope_find(vrh)
                            if vri >= 0 {
                                rhs_ty = ESCOPE_TY[vri as usize]
                                rhs_conf = ESCOPE_CONF[vri as usize]
                            } else {
                                // Not in local scope — check if it's a known global
                                let gvi = gl_find(TS[rhs as usize], TE[rhs as usize])
                                if gvi >= 0 { rhs_ty = ty_i64; rhs_conf = 1000 }
                            }
                        }
                        // GUM: if we have both annotation AND RHS, unify
                        if bind_conf > 0 && rhs_conf > 0 {
                            let ut = ety_unify(bind_ty, bind_conf, rhs_ty, rhs_conf)
                            bind_ty = ut
                            bind_conf = EUNIFY_CONF
                        } else if rhs_conf > 0 {
                            // No annotation but RHS is known → inherit
                            bind_ty = rhs_ty
                            bind_conf = rhs_conf
                        }
                        // If annotation gives type but RHS is unknown, keep annotation
                    }
                }
                escope_add(nh, bind_ty, bind_conf)
            }
            p = p + 1
            continue
        }

        // Identifier → variable lookup OR function call
        if tk == 3 {
            let ins = TS[p as usize]
            let ine = TE[p as usize]
            let ih = gl_name_hash(ins, ine)

            // Identifier immediately before ':' — struct field name or parameter name.
            // Always confident (syntactic position, not an expression).
            if p + 1 < TC && TK[(p + 1) as usize] == 43 {
                EXPR_ETY[p as usize] = ty_void
                EXPR_CONF[p as usize] = 1000
                EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
                p = p + 1
                continue
            }

            // Detect function call: ident followed by '('
            if p + 1 < TC && TK[(p + 1) as usize] == 6 {
                // Function call — look up in FN_* tables
                var call_fi: i64 = -1
                var fj: i64 = 0
                while fj < FN_COUNT {
                    if name_eq(FN_NS[fj as usize], FN_NE[fj as usize], ins, ine) {
                        call_fi = fj
                        break
                    }
                    fj = fj + 1
                }
                if call_fi >= 0 {
                    // Known function — return type from FN_RET_TY
                    let ret_ety = ety_from_tnk(FN_RET_TY[call_fi as usize])
                    // Scan args inside parens to accumulate GUM confidence
                    var arg_conf: i64 = 1000
                    var q: i64 = p + 2
                    var paren_depth: i64 = 1
                    while q < TC && paren_depth > 0 {
                        if TK[q as usize] == 6 { paren_depth = paren_depth + 1 }
                        if TK[q as usize] == 7 { paren_depth = paren_depth - 1; if paren_depth == 0 { break } }
                        let qtk = TK[q as usize]
                        // Skip commas and delimiters
                        if qtk == 28 || qtk == 27 { q = q + 1; continue }
                        // Literal args: confidence 1000
                        if qtk == 4 || qtk == 53 || qtk == 5 || qtk == 35 || qtk == 36 {
                            arg_conf = ety_conf_product(arg_conf, 1000)
                        } else if qtk == 3 {
                            // Identifier arg — check if it's a nested call
                            if q + 1 < TC && TK[(q + 1) as usize] == 6 {
                                // Nested function call: look up callee return type
                                let nns = TS[q as usize]
                                let nne = TE[q as usize]
                                var nfj: i64 = 0
                                var nested_conf: i64 = 0
                                while nfj < FN_COUNT {
                                    if name_eq(FN_NS[nfj as usize], FN_NE[nfj as usize], nns, nne) {
                                        let nret = ety_from_tnk(FN_RET_TY[nfj as usize])
                                        if nret != 0 {
                                            nested_conf = FN_EFF_CONF[nfj as usize]
                                        }
                                        break
                                    }
                                    nfj = nfj + 1
                                }
                                arg_conf = ety_conf_product(arg_conf, nested_conf)
                                // Skip past the nested call's parens
                                q = q + 2
                                var nd: i64 = 1
                                while q < TC && nd > 0 {
                                    if TK[q as usize] == 6 { nd = nd + 1 }
                                    if TK[q as usize] == 7 { nd = nd - 1 }
                                    if nd > 0 { q = q + 1 }
                                }
                                if q < TC && TK[q as usize] == 7 { q = q + 1 }
                                continue
                            }
                            // Plain identifier arg: look up scope
                            let aqh = gl_name_hash(TS[q as usize], TE[q as usize])
                            let asi = escope_find(aqh)
                            if asi >= 0 {
                                arg_conf = ety_conf_product(arg_conf, ESCOPE_CONF[asi as usize])
                            } else {
                                // Check if it's a known global var (by hash)
                                let gqh = gl_name_hash(TS[q as usize], TE[q as usize])
                                let gqi = gl_find(TS[q as usize], TE[q as usize])
                                if gqi >= 0 {
                                    // Known global — typed, confidence 1000
                                    arg_conf = ety_conf_product(arg_conf, 1000)
                                } else {
                                    arg_conf = 0
                                }
                            }
                        }
                        q = q + 1
                    }
                    // Final call confidence = args × effect confidence
                    var call_conf: i64 = ety_conf_product(arg_conf, FN_EFF_CONF[call_fi as usize])
                    if ret_ety == 0 { call_conf = 0 }
                    EXPR_ETY[p as usize] = ret_ety
                    EXPR_CONF[p as usize] = call_conf
                } else {
                    // Unknown function
                    EXPR_ETY[p as usize] = ty_unknown
                    EXPR_CONF[p as usize] = 0
                }
                EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
                if EXPR_CONF[p as usize] >= GATE_THRESHOLD {
                    EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
                } else {
                    EPIST_LOW_CONF = EPIST_LOW_CONF + 1
                }
                p = p + 1
                continue
            }

            // Not a call — variable lookup in epistemic scope
            let si = escope_find(ih)
            if si >= 0 {
                EXPR_ETY[p as usize] = ESCOPE_TY[si as usize]
                EXPR_CONF[p as usize] = ESCOPE_CONF[si as usize]
            } else {
                EXPR_ETY[p as usize] = ty_unknown
                EXPR_CONF[p as usize] = 0
            }
            EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
            if EXPR_CONF[p as usize] >= GATE_THRESHOLD {
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
            } else {
                EPIST_LOW_CONF = EPIST_LOW_CONF + 1
            }
            p = p + 1
            continue
        }

        // 'as' cast: propagate source confidence AND skip type target
        if tk == 37 {
            if p > 0 {
                EXPR_ETY[p as usize] = EXPR_ETY[(p - 1) as usize]
                EXPR_CONF[p as usize] = EXPR_CONF[(p - 1) as usize]
            } else {
                EXPR_ETY[p as usize] = ty_unknown
                EXPR_CONF[p as usize] = 0
            }
            EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
            if EXPR_CONF[p as usize] >= GATE_THRESHOLD {
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
            } else {
                EPIST_LOW_CONF = EPIST_LOW_CONF + 1
            }
            // Skip the type target (usize, i8, i64, etc.) — it's a type name, not a variable
            if p + 1 < TC && TK[(p + 1) as usize] == 3 {
                EXPR_ETY[(p + 1) as usize] = EXPR_ETY[p as usize]
                EXPR_CONF[(p + 1) as usize] = EXPR_CONF[p as usize]
                p = p + 2  // skip both 'as' and the type name
                continue
            }
            p = p + 1
            continue
        }

        // Type annotation positions: ':' followed by type name — mark as confident
        // These are declarations, not expressions
        if tk == 43 {
            // ':' — the next token(s) are a type, mark them
            if p + 1 < TC && TK[(p + 1) as usize] == 3 {
                EXPR_ETY[(p + 1) as usize] = ty_void
                EXPR_CONF[(p + 1) as usize] = 1000
            }
            p = p + 1
            continue
        }

        // Return type: '->' followed by type name
        if tk == 10 {
            if p + 1 < TC && TK[(p + 1) as usize] == 3 {
                EXPR_ETY[(p + 1) as usize] = ty_void
                EXPR_CONF[(p + 1) as usize] = 1000
            }
            p = p + 1
            continue
        }

        // Array index brackets: propagate confidence through indexing
        // '[' after an identifier/expression = array access
        if tk == 41 {
            // '[' — the base expression is at p-1 (already visited)
            if p > 0 {
                EXPR_ETY[p as usize] = EXPR_ETY[(p - 1) as usize]
                EXPR_CONF[p as usize] = EXPR_CONF[(p - 1) as usize]
            }
            p = p + 1
            continue
        }
        // ']' closing bracket: inherit confidence from matching '['
        if tk == 42 {
            if p > 0 {
                EXPR_ETY[p as usize] = EXPR_ETY[(p - 1) as usize]
                EXPR_CONF[p as usize] = EXPR_CONF[(p - 1) as usize]
            }
            p = p + 1
            continue
        }

        // Binary operators: GUM product propagation
        // +, -, *, /, ==, !=, <, >, <=, >=
        if tk == 17 || tk == 18 || tk == 19 || tk == 20 || tk == 21 || tk == 22 || tk == 23 || tk == 24 || tk == 25 || tk == 26 {
            // Look at left (p-1) and right (p+1) tokens for confidence
            var left_conf: i64 = 0
            var right_conf: i64 = 0
            var left_ty: i64 = ty_unknown
            var right_ty: i64 = ty_unknown
            if p > 0 {
                left_conf = EXPR_CONF[(p - 1) as usize]
                left_ty = EXPR_ETY[(p - 1) as usize]
            }
            if p + 1 < TC {
                // Right side not yet inferred — peek at token kind
                let rtk = TK[(p + 1) as usize]
                if rtk == 4 { right_ty = ty_i64; right_conf = 1000 }
                else if rtk == 53 { right_ty = ty_f64; right_conf = 1000 }
                else if rtk == 5 { right_ty = ty_string; right_conf = 1000 }
                else if rtk == 35 || rtk == 36 { right_ty = ty_bool; right_conf = 1000 }
                else if rtk == 3 {
                    // Look up right identifier
                    let rh = gl_name_hash(TS[(p + 1) as usize], TE[(p + 1) as usize])
                    let rsi = escope_find(rh)
                    if rsi >= 0 {
                        right_ty = ESCOPE_TY[rsi as usize]
                        right_conf = ESCOPE_CONF[rsi as usize]
                    }
                }
            }
            // GUM product: confidence of a OP b = product of confidences
            var op_conf: i64 = ety_conf_product(left_conf, right_conf)
            // For comparison ops, result is bool
            if tk == 21 || tk == 22 || tk == 23 || tk == 24 || tk == 25 || tk == 26 {
                EXPR_ETY[p as usize] = ty_bool
            } else {
                // Arithmetic: unify operand types
                let unified = ety_unify(left_ty, left_conf, right_ty, right_conf)
                op_conf = ety_conf_product(op_conf, EUNIFY_CONF)
                EXPR_ETY[p as usize] = unified
            }
            EXPR_CONF[p as usize] = op_conf
            EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
            if op_conf >= GATE_THRESHOLD {
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
            } else {
                EPIST_LOW_CONF = EPIST_LOW_CONF + 1
            }
            p = p + 1
            continue
        }

        // All other tokens: not expressions
        EXPR_ETY[p as usize] = ty_void
        EXPR_CONF[p as usize] = 0
        p = p + 1
    }

    // Phase C: Compute confidence gates
    p = 0
    while p < TC {
        if EXPR_CONF[p as usize] >= GATE_THRESHOLD {
            EXPR_GATE[p as usize] = 0
        } else {
            EXPR_GATE[p as usize] = 1
        }
        p = p + 1
    }

    // Diagnostic: count uncertain tokens by kind
    var unc_idents: i64 = 0
    var unc_ops: i64 = 0
    var unc_other: i64 = 0
    p = 0
    while p < TC {
        if EXPR_CONF[p as usize] < GATE_THRESHOLD && EXPR_CONF[p as usize] >= 0 {
            let utk = TK[p as usize]
            if utk == 3 { unc_idents = unc_idents + 1 }
            else if utk >= 17 && utk <= 26 { unc_ops = unc_ops + 1 }
            else { unc_other = unc_other + 1 }
        }
        p = p + 1
    }

    // Phase D: Iterative refinement — loop until fixed point
    // Each pass re-evaluates uncertain idents using populated scope/globals/fns.
    // Also: upgrade uncertain operators whose operands became confident.
    var total_refined: i64 = 0
    var refine_pass: i64 = 0
    var refine_changed: i64 = 1
    while refine_changed > 0 && refine_pass < 5 {
        refine_changed = 0
        p = 0
        while p < TC {
            if EXPR_CONF[p as usize] < GATE_THRESHOLD {
                let rtk = TK[p as usize]
                if rtk == 3 {
                    // Uncertain ident — try resolving
                    let rns = TS[p as usize]
                    let rne = TE[p as usize]
                    let rh = gl_name_hash(rns, rne)
                    let rsi = escope_find(rh)
                    if rsi >= 0 && ESCOPE_CONF[rsi as usize] >= GATE_THRESHOLD {
                        EXPR_ETY[p as usize] = ESCOPE_TY[rsi as usize]
                        EXPR_CONF[p as usize] = ESCOPE_CONF[rsi as usize]
                        refine_changed = refine_changed + 1
                    } else {
                        let rgi = gl_find(rns, rne)
                        if rgi >= 0 {
                            EXPR_ETY[p as usize] = ty_i64
                            EXPR_CONF[p as usize] = 1000
                            refine_changed = refine_changed + 1
                        } else {
                            var rfj: i64 = 0
                            while rfj < FN_COUNT {
                                if name_eq(FN_NS[rfj as usize], FN_NE[rfj as usize], rns, rne) {
                                    EXPR_ETY[p as usize] = ety_from_tnk(FN_RET_TY[rfj as usize])
                                    EXPR_CONF[p as usize] = 1000
                                    refine_changed = refine_changed + 1
                                    break
                                }
                                rfj = rfj + 1
                            }
                            // Try struct name table
                            if EXPR_CONF[p as usize] < GATE_THRESHOLD {
                                if st_find(rh) >= 0 || en_find(rh) >= 0 {
                                    EXPR_ETY[p as usize] = ty_void
                                    EXPR_CONF[p as usize] = 1000
                                    refine_changed = refine_changed + 1
                                }
                            }
                        }
                    }
                } else if rtk >= 17 && rtk <= 26 {
                    // Uncertain operator — check if both operands are now confident
                    if p > 0 && p + 1 < TC {
                        let lc = EXPR_CONF[(p - 1) as usize]
                        let rc = EXPR_CONF[(p + 1) as usize]
                        if lc >= GATE_THRESHOLD && rc >= GATE_THRESHOLD {
                            EXPR_CONF[p as usize] = ety_conf_product(lc, rc)
                            if EXPR_CONF[p as usize] >= GATE_THRESHOLD {
                                refine_changed = refine_changed + 1
                            }
                        }
                    }
                }
            }
            p = p + 1
        }
        // Re-evaluate uncertain let/var ESCOPE entries using now-confident RHS EXPR_CONF.
        // This breaks the cascade: if variable X was bound to a struct/fn-call whose
        // EXPR_CONF is now >= threshold, upgrade X's ESCOPE entry so uses of X resolve.
        var lp: i64 = 0
        while lp < TC {
            if TK[lp as usize] == 11 || TK[lp as usize] == 12 {
                if lp + 1 < TC && TK[(lp + 1) as usize] == 3 {
                    let lnh = gl_name_hash(TS[(lp + 1) as usize], TE[(lp + 1) as usize])
                    let lsi = escope_find(lnh)
                    if lsi >= 0 && ESCOPE_CONF[lsi as usize] < GATE_THRESHOLD {
                        // Find '='
                        var leq: i64 = lp + 2
                        while leq < TC && TK[leq as usize] != 16 && TK[leq as usize] != 8 && TK[leq as usize] != 0 {
                            leq = leq + 1
                        }
                        if leq < TC && TK[leq as usize] == 16 {
                            let lrhs = leq + 1
                            if lrhs < TC && EXPR_CONF[lrhs as usize] >= GATE_THRESHOLD {
                                ESCOPE_CONF[lsi as usize] = EXPR_CONF[lrhs as usize]
                                ESCOPE_TY[lsi as usize] = EXPR_ETY[lrhs as usize]
                                refine_changed = refine_changed + 1
                            }
                        }
                    }
                }
            }
            lp = lp + 1
        }
        total_refined = total_refined + refine_changed
        refine_pass = refine_pass + 1
    }
    // Recount after refinement — only count tokens that are expressions
    EPIST_TOTAL_EXPR = 0
    EPIST_HIGH_CONF = 0
    EPIST_LOW_CONF = 0
    p = 0
    while p < TC {
        let ctk = TK[p as usize]
        // Count as expression: literals, idents, operators, booleans, Some/None/Ok/Err
        var is_expr: i64 = 0
        if ctk == 3 || ctk == 4 || ctk == 5 || ctk == 53 { is_expr = 1 }
        if ctk == 35 || ctk == 36 { is_expr = 1 }
        if ctk >= 17 && ctk <= 26 { is_expr = 1 }
        if ctk == 37 { is_expr = 1 }
        if ctk == 57 || ctk == 58 || ctk == 59 || ctk == 60 { is_expr = 1 }
        if is_expr == 1 {
            EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
            if EXPR_CONF[p as usize] >= GATE_THRESHOLD {
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
            } else {
                EPIST_LOW_CONF = EPIST_LOW_CONF + 1
            }
        }
        p = p + 1
    }
    // Recompute gates after refinement
    p = 0
    while p < TC {
        if EXPR_CONF[p as usize] >= GATE_THRESHOLD {
            EXPR_GATE[p as usize] = 0
        } else {
            EXPR_GATE[p as usize] = 1
        }
        p = p + 1
    }
    if total_refined > 0 {
        print("refined: ")
        print_int(total_refined)
        print(" in ")
        print_int(refine_pass)
        print(" passes\n")
    }

    // Diagnostic: categorize uncertain identifiers by prev token
    var unc_after_dot: i64 = 0
    var unc_after_decl: i64 = 0
    var unc_after_let: i64 = 0
    var unc_after_colon: i64 = 0
    var unc_other: i64 = 0
    p = 0
    while p < TC {
        if TK[p as usize] == 3 && EXPR_CONF[p as usize] < GATE_THRESHOLD {
            var prev_tk: i64 = 0
            if p > 0 { prev_tk = TK[(p - 1) as usize] }
            if prev_tk == 50 { unc_after_dot = unc_after_dot + 1 }
            else if prev_tk == 1 || prev_tk == 46 || prev_tk == 47 || prev_tk == 49 || prev_tk == 62 { unc_after_decl = unc_after_decl + 1 }
            else if prev_tk == 11 || prev_tk == 12 { unc_after_let = unc_after_let + 1 }
            else if prev_tk == 43 || prev_tk == 10 { unc_after_colon = unc_after_colon + 1 }
            else { unc_other = unc_other + 1; if unc_other <= 15 { print("  prev="); print_int(prev_tk); print(" L"); print_int(TL[p as usize]); print("\n") } }
        }
        p = p + 1
    }
    print("unc_detail: dot=")
    print_int(unc_after_dot)
    print(" decl=")
    print_int(unc_after_decl)
    print(" let=")
    print_int(unc_after_let)
    print(" colon=")
    print_int(unc_after_colon)
    print(" other=")
    print_int(unc_other)
    print("\n")

    // Report epistemic state
    print("epistemic: ")
    print_int(EPIST_TOTAL_EXPR)
    print(" expr, ")
    print_int(EPIST_HIGH_CONF)
    print(" certain (")
    if EPIST_TOTAL_EXPR > 0 {
        print_int((EPIST_HIGH_CONF * 100) / EPIST_TOTAL_EXPR)
    } else {
        print_int(0)
    }
    print("%), ")
    print_int(EPIST_LOW_CONF)
    print(" uncertain [ident=")
    print_int(unc_idents)
    print(" ops=")
    print_int(unc_ops)
    print(" other=")
    print_int(unc_other)
    print("], types=")
    print_int(ETY_COUNT)
    print(", gate=")
    print_int(GATE_THRESHOLD)
    print("/1000\n")
}

// ─── Top-level compiler ───
// ─── Monomorphization pass ───
// Scans for generic fn/struct declarations, finds instantiation sites,
// generates specialized token copies. Separate function to limit stack usage.
fn mono_pass() with IO, Mut, Panic, Div {
    GEN_FN_COUNT = 0
    GEN_ST_COUNT = 0
    MONO_COUNT = 0
    // Pass 0c: scan generic function and struct declarations
    var p: i64 = 0
    while p < TC {
        // fn NAME < TPARAM , TPARAM > (
        if TK[p as usize] == 1 && p + 4 < TC && TK[(p + 2) as usize] == 23 {
            // Find closing >
            var tf_depth: i64 = 1
            var tf_p: i64 = p + 3
            while tf_depth > 0 && tf_p < TC {
                if TK[tf_p as usize] == 23 { tf_depth = tf_depth + 1 }
                if TK[tf_p as usize] == 24 { tf_depth = tf_depth - 1 }
                if tf_depth > 0 { tf_p = tf_p + 1 }
            }
            if tf_depth == 0 && tf_p + 1 < TC && TK[(tf_p + 1) as usize] == 6 {
                let gi = GEN_FN_COUNT
                GEN_FN_NS[gi as usize] = TS[(p + 1) as usize]
                GEN_FN_NE[gi as usize] = TE[(p + 1) as usize]
                // Store first type parameter (for now, partial multi-arg support)
                GEN_FN_TP_S[gi as usize] = TS[(p + 3) as usize]
                GEN_FN_TP_E[gi as usize] = TE[(p + 3) as usize]
                GEN_FN_BDY_S[gi as usize] = p
                var q: i64 = tf_p + 1
                while q < TC && TK[q as usize] != 8 { q = q + 1 }
                var bd: i64 = 1
                q = q + 1
                while q < TC && bd > 0 { if TK[q as usize] == 8 { bd = bd + 1 }; if TK[q as usize] == 9 { bd = bd - 1 }; q = q + 1 }
                GEN_FN_BDY_E[gi as usize] = q
                GEN_FN_COUNT = GEN_FN_COUNT + 1
                p = q
                continue
            }
        }
        // struct NAME < TPARAM > {
        if TK[p as usize] == 46 && p + 4 < TC && TK[(p + 2) as usize] == 23 && TK[(p + 4) as usize] == 24 {
            let gi = GEN_ST_COUNT
            GEN_ST_NS[gi as usize] = TS[(p + 1) as usize]
            GEN_ST_NE[gi as usize] = TE[(p + 1) as usize]
            GEN_ST_TP_S[gi as usize] = TS[(p + 3) as usize]
            GEN_ST_TP_E[gi as usize] = TE[(p + 3) as usize]
            GEN_ST_BDY_S[gi as usize] = p
            var q: i64 = p + 5
            while q < TC && TK[q as usize] != 9 { q = q + 1 }
            q = q + 1
            GEN_ST_BDY_E[gi as usize] = q
            GEN_ST_COUNT = GEN_ST_COUNT + 1
            p = q
            continue
        }
        // pub/linear struct generics
        if (TK[p as usize] == 49 || TK[p as usize] == 62) && p + 5 < TC && TK[(p + 1) as usize] == 46 && TK[(p + 3) as usize] == 23 && TK[(p + 5) as usize] == 24 {
            let gi = GEN_ST_COUNT
            GEN_ST_NS[gi as usize] = TS[(p + 2) as usize]
            GEN_ST_NE[gi as usize] = TE[(p + 2) as usize]
            GEN_ST_TP_S[gi as usize] = TS[(p + 4) as usize]
            GEN_ST_TP_E[gi as usize] = TE[(p + 4) as usize]
            GEN_ST_BDY_S[gi as usize] = p
            var q: i64 = p + 6
            while q < TC && TK[q as usize] != 9 { q = q + 1 }
            q = q + 1
            GEN_ST_BDY_E[gi as usize] = q
            GEN_ST_COUNT = GEN_ST_COUNT + 1
            p = q
            continue
        }
        p = p + 1
    }
    if GEN_FN_COUNT > 0 || GEN_ST_COUNT > 0 {
        print("generics: fns="); print_int(GEN_FN_COUNT); print(" structs="); print_int(GEN_ST_COUNT); print("\n")
    }
    if GEN_FN_COUNT == 0 && GEN_ST_COUNT == 0 { return }
    // Pass 0d: find instantiation sites
    p = 0
    var in_gen: i64 = 0
    var ig: i64 = 0
    var d_gi: i64 = 0
    var d_cns: i64 = 0
    var d_cne: i64 = 0
    var d_tys: i64 = 0
    var d_tye: i64 = 0
    var d_mi: i64 = 0
    var d_ms: i64 = 0
    while p < TC {
        in_gen = 0
        ig = 0
        while ig < GEN_FN_COUNT { if p >= GEN_FN_BDY_S[ig as usize] && p < GEN_FN_BDY_E[ig as usize] { in_gen = 1 }; ig = ig + 1 }
        ig = 0
        while ig < GEN_ST_COUNT { if p >= GEN_ST_BDY_S[ig as usize] && p < GEN_ST_BDY_E[ig as usize] { in_gen = 1 }; ig = ig + 1 }
        if in_gen == 1 { p = p + 1; continue }
        if TK[p as usize] == 3 && p + 3 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 3) as usize] == 24 {
            d_cns = TS[p as usize]
            d_cne = TE[p as usize]
            d_tys = TS[(p + 2) as usize]
            d_tye = TE[(p + 2) as usize]
            d_gi = 0
            while d_gi < GEN_FN_COUNT {
                if name_eq(d_cns, d_cne, GEN_FN_NS[d_gi as usize], GEN_FN_NE[d_gi as usize]) {
                    if mono_find_inst(d_gi, 0, d_tys, d_tye) < 0 {
                        d_mi = MONO_COUNT
                        MONO_GEN[d_mi as usize] = d_gi
                        MONO_TY_S[d_mi as usize] = d_tys
                        MONO_TY_E[d_mi as usize] = d_tye
                        MONO_IS_ST[d_mi as usize] = 0
                        d_ms = mono_mangle(GEN_FN_NS[d_gi as usize], GEN_FN_NE[d_gi as usize], d_tys, d_tye)
                        MAN_BUF_S[d_mi as usize] = d_ms
                        MAN_BUF_E[d_mi as usize] = SRC_LEN
                        MONO_COUNT = MONO_COUNT + 1
                    }
                    d_gi = GEN_FN_COUNT
                }
                d_gi = d_gi + 1
            }
            d_gi = 0
            while d_gi < GEN_ST_COUNT {
                if name_eq(d_cns, d_cne, GEN_ST_NS[d_gi as usize], GEN_ST_NE[d_gi as usize]) {
                    if mono_find_inst(d_gi, 1, d_tys, d_tye) < 0 {
                        d_mi = MONO_COUNT
                        MONO_GEN[d_mi as usize] = d_gi
                        MONO_TY_S[d_mi as usize] = d_tys
                        MONO_TY_E[d_mi as usize] = d_tye
                        MONO_IS_ST[d_mi as usize] = 1
                        d_ms = mono_mangle(GEN_ST_NS[d_gi as usize], GEN_ST_NE[d_gi as usize], d_tys, d_tye)
                        MAN_BUF_S[d_mi as usize] = d_ms
                        MAN_BUF_E[d_mi as usize] = SRC_LEN
                        MONO_COUNT = MONO_COUNT + 1
                    }
                    d_gi = GEN_ST_COUNT
                }
                d_gi = d_gi + 1
            }
        }
        // Turbofish: IDENT :: < TYPE , TYPE > (  — multi-arg generics
        if TK[p as usize] == 3 && p + 4 < TC && TK[(p + 1) as usize] == 51 && TK[(p + 2) as usize] == 23 {
            // Find closing >
            var tf_depth: i64 = 1
            var tf_p: i64 = p + 3
            while tf_depth > 0 && tf_p < TC {
                if TK[tf_p as usize] == 23 { tf_depth = tf_depth + 1 }
                if TK[tf_p as usize] == 24 { tf_depth = tf_depth - 1 }
                if tf_depth > 0 { tf_p = tf_p + 1 }
            }
            if tf_depth == 0 {
                d_cns = TS[p as usize]
                d_cne = TE[p as usize]
                d_tys = TS[(p + 3) as usize]
                d_tye = TE[(tf_p - 1) as usize]
                d_gi = 0
                while d_gi < GEN_FN_COUNT {
                    if name_eq(d_cns, d_cne, GEN_FN_NS[d_gi as usize], GEN_FN_NE[d_gi as usize]) {
                        if mono_find_inst(d_gi, 0, d_tys, d_tye) < 0 {
                            d_mi = MONO_COUNT
                            MONO_GEN[d_mi as usize] = d_gi
                            MONO_TY_S[d_mi as usize] = d_tys
                            MONO_TY_E[d_mi as usize] = d_tye
                            MONO_IS_ST[d_mi as usize] = 0
                            d_ms = mono_mangle(GEN_FN_NS[d_gi as usize], GEN_FN_NE[d_gi as usize], d_tys, d_tye)
                            MAN_BUF_S[d_mi as usize] = d_ms
                            MAN_BUF_E[d_mi as usize] = SRC_LEN
                            MONO_COUNT = MONO_COUNT + 1
                        }
                        d_gi = GEN_FN_COUNT
                    }
                    d_gi = d_gi + 1
                }
            }
        }
        p = p + 1
    }
    // Generate specialized token copies
    var m_i: i64 = 0
    var m_gi: i64 = 0
    var m_is_st: i64 = 0
    var m_tys: i64 = 0
    var m_tye: i64 = 0
    var m_mns: i64 = 0
    var m_mne: i64 = 0
    var m_bs: i64 = 0
    var m_be: i64 = 0
    var m_tps: i64 = 0
    var m_tpe: i64 = 0
    var m_gns: i64 = 0
    var m_gne: i64 = 0
    var m_ti: i64 = 0
    var m_skip: i64 = 0
    var m_tk: i64 = 0
    var m_tts: i64 = 0
    var m_tte: i64 = 0
    while m_i < MONO_COUNT {
        m_gi = MONO_GEN[m_i as usize]
        m_is_st = MONO_IS_ST[m_i as usize]
        m_tys = MONO_TY_S[m_i as usize]
        m_tye = MONO_TY_E[m_i as usize]
        m_mns = MAN_BUF_S[m_i as usize]
        m_mne = MAN_BUF_E[m_i as usize]
        m_bs = 0
        m_be = 0
        m_tps = 0
        m_tpe = 0
        m_gns = 0
        m_gne = 0
        if m_is_st == 0 {
            m_bs = GEN_FN_BDY_S[m_gi as usize]
            m_be = GEN_FN_BDY_E[m_gi as usize]
            m_tps = GEN_FN_TP_S[m_gi as usize]
            m_tpe = GEN_FN_TP_E[m_gi as usize]
            m_gns = GEN_FN_NS[m_gi as usize]
            m_gne = GEN_FN_NE[m_gi as usize]
        } else {
            m_bs = GEN_ST_BDY_S[m_gi as usize]
            m_be = GEN_ST_BDY_E[m_gi as usize]
            m_tps = GEN_ST_TP_S[m_gi as usize]
            m_tpe = GEN_ST_TP_E[m_gi as usize]
            m_gns = GEN_ST_NS[m_gi as usize]
            m_gne = GEN_ST_NE[m_gi as usize]
        }
        m_ti = m_bs
        m_skip = 0
        while m_ti < m_be && TC < 131000 {
            m_tk = TK[m_ti as usize]
            m_tts = TS[m_ti as usize]
            m_tte = TE[m_ti as usize]
            if m_skip == 0 && m_tk == 23 && m_ti > m_bs && name_eq(TS[(m_ti - 1) as usize], TE[(m_ti - 1) as usize], m_gns, m_gne) {
                m_ti = m_ti + 3
                m_skip = 1
                continue
            }
            if m_tk == 3 && name_eq(m_tts, m_tte, m_gns, m_gne) {
                TK[TC as usize] = 3
                TS[TC as usize] = m_mns
                TE[TC as usize] = m_mne
                TV[TC as usize] = 0
                TL[TC as usize] = TL[m_ti as usize]
                TC = TC + 1
                m_ti = m_ti + 1
                continue
            }
            if m_tk == 3 && name_eq(m_tts, m_tte, m_tps, m_tpe) {
                TK[TC as usize] = 3
                TS[TC as usize] = m_tys
                TE[TC as usize] = m_tye
                TV[TC as usize] = 0
                TL[TC as usize] = TL[m_ti as usize]
                TC = TC + 1
                m_ti = m_ti + 1
                continue
            }
            TK[TC as usize] = m_tk
            TS[TC as usize] = m_tts
            TE[TC as usize] = m_tte
            TV[TC as usize] = TV[m_ti as usize]
            TF[TC as usize] = TF[m_ti as usize]
            TD[TC as usize] = TD[m_ti as usize]
            TL[TC as usize] = TL[m_ti as usize]
            TC = TC + 1
            m_ti = m_ti + 1
        }
        m_i = m_i + 1
    }
    // Re-add EOF token and re-scan monomorphized structs
    if MONO_COUNT > 0 {
        TK[TC as usize] = 0
        TC = TC + 1
        print("mono: "); print_int(MONO_COUNT); print(" specializations, tokens="); print_int(TC); print("\n")
        // Re-scan for monomorphized struct declarations
        p = 0
        while p < TC {
            if TK[p as usize] == 46 || TK[p as usize] == 49 || TK[p as usize] == 62 {
                if TK[p as usize] == 49 || TK[p as usize] == 62 { p = p + 1 }
                if TK[p as usize] == 46 {
                    p = p + 1
                    let rsn_ns = TS[p as usize]
                    let rsn_ne = TE[p as usize]
                    let rsh = gl_name_hash(rsn_ns, rsn_ne)
                    if st_find(rsh) < 0 {
                        let rsi = ST_COUNT
                        let rbase = rsi * 130
                        ST[rbase as usize] = rsh
                        p = p + 1
                        if TK[p as usize] == 23 { p = p + 1; while TK[p as usize] != 9 && TK[p as usize] != 0 { p = p + 1 }; if TK[p as usize] == 9 { p = p + 1 }; ST[(rbase + 1) as usize] = 0; ST_COUNT = ST_COUNT + 1; continue }
                        if TK[p as usize] == 8 { p = p + 1 }
                        var rfc: i64 = 0
                        while TK[p as usize] != 9 && TK[p as usize] != 0 {
                            if TK[p as usize] == 3 {
                                let rfh = gl_name_hash(TS[p as usize], TE[p as usize])
                                let rffi = rfc
                                ST[(rbase + 2 + rfc) as usize] = rfh
                                p = p + 1
                                if TK[p as usize] == 43 {
                                    p = p + 1
                                    scan_type(p)
                                    ST_FTY[(rsi * 128 + rffi) as usize] = SCAN_TY
                                    ST_FHASH[(rsi * 128 + rffi) as usize] = SCAN_TY_HASH
                                    p = SCAN_TY_NEXT
                                } else {
                                    ST_FTY[(rsi * 128 + rffi) as usize] = 0
                                    ST_FHASH[(rsi * 128 + rffi) as usize] = 0
                                }
                                rfc = rfc + 1
                                if TK[p as usize] == 28 { p = p + 1 }
                                continue
                            }
                            p = p + 1
                        }
                        ST[(rbase + 1) as usize] = rfc
                        ST_COUNT = ST_COUNT + 1
                    }
                    if TK[p as usize] == 9 { p = p + 1 }
                    continue
                }
            }
            p = p + 1
        }
    }
}

fn resolve_forward_struct_types() with Mut, Panic, Div {
    var fix_si: i64 = 0
    while fix_si < ST_COUNT {
        var fix_fi: i64 = 0
        while fix_fi < ST[(fix_si * 130 + 1) as usize] {
            if ST_FTY[(fix_si * 128 + fix_fi) as usize] == 0 {
                var fix_fh: i64 = ST_FHASH[(fix_si * 128 + fix_fi) as usize]
                if fix_fh != 0 {
                    if st_find(fix_fh) >= 0 {
                        ST_FTY[(fix_si * 128 + fix_fi) as usize] = 6
                    } else {
                        if en_find(fix_fh) >= 0 {
                            ST_FTY[(fix_si * 128 + fix_fi) as usize] = 7
                        }
                    }
                }
            }
            fix_fi = fix_fi + 1
        }
        fix_si = fix_si + 1
    }
}

fn compile_all() -> i64 with IO, Mut, Panic, Div {
    CL = 0
    FN_COUNT = 0
    PATCH_COUNT = 0
    FNSIG_COUNT = 1
    GL_COUNT = 0
    GL_BSS_SIZE = 0
    RET_AGG_BSS_OFF = 0
    GPU_EMU_THREAD_ID_BSS_OFF = 0
    // Note: do NOT reset TYPECHECK_FAILED here — lexer-phase errors must persist
    LIMIT_ERROR_KIND = 0
    var p: i64 = 0

    // Pass 0a: register structs, constants, and skip algebra/study declarations
    ST_COUNT = 0
    scan_all_consts()
    var pass0a_depth: i64 = 0
    while p < TC {
        // Track brace depth to only process top-level declarations
        if TK[p as usize] == 8 { pass0a_depth = pass0a_depth + 1; p = p + 1; continue }
        if TK[p as usize] == 9 {
            if pass0a_depth > 0 { pass0a_depth = pass0a_depth - 1 }
            p = p + 1
            continue
        }
        // Algebra declarations: algebra Name over Base { ... }
        // If block contains 'basis: e0, e1, ...' → register Name as a struct type.
        if pass0a_depth == 0 && TK[p as usize] == 70 {
            p = p + 1  // skip 'algebra'
            let alg_ns = TS[p as usize]
            let alg_ne = TE[p as usize]
            let alg_hash = gl_name_hash(alg_ns, alg_ne)
            p = p + 1  // skip Name
            if p < TC && TK[p as usize] == 3 { p = p + 1 }  // skip 'over'
            var alg_base_ty: i64 = 1  // default i64
            if p < TC && TK[p as usize] == 3 {
                let bns2 = TS[p as usize]
                let bne2 = TE[p as usize]
                if src_match(bns2, bne2 - bns2, "f64") || src_match(bns2, bne2 - bns2, "f32") { alg_base_ty = 2 }
                p = p + 1
            }
            // Skip to opening brace
            while p < TC && TK[p as usize] != 8 && TK[p as usize] != 0 { p = p + 1 }
            if p < TC && TK[p as usize] == 8 { p = p + 1 }  // skip {
            // First pass: scan block for 'basis:' and count field idents
            var alg_basis_p: i64 = 0
            var alg_fc: i64 = 0
            var ap: i64 = p
            while ap < TC && TK[ap as usize] != 9 && TK[ap as usize] != 0 {
                if TK[ap as usize] == 3 {
                    let bkns = TS[ap as usize]
                    let bkne = TE[ap as usize]
                    if src_match(bkns, bkne - bkns, "basis") {
                        ap = ap + 1
                        if ap < TC && TK[ap as usize] == 43 { ap = ap + 1 }  // skip ':'
                        alg_basis_p = ap
                        while ap < TC && TK[ap as usize] != 9 && TK[ap as usize] != 0 {
                            if TK[ap as usize] == 3 && ap + 1 < TC && TK[(ap + 1) as usize] == 43 { break }
                            if TK[ap as usize] == 3 { alg_fc = alg_fc + 1 }
                            ap = ap + 1
                        }
                        continue
                    }
                }
                ap = ap + 1
            }
            // Second pass: scan for add:/mul:/reassociate: property declarations
            var al_props: i64 = 1  // bit 0 = is_algebra
            al_props = al_props | 8   // default: mul commutative
            al_props = al_props | 16  // default: mul associative
            ap = p
            while ap < TC && TK[ap as usize] != 9 && TK[ap as usize] != 0 {
                if TK[ap as usize] == 3 {
                    let pkns = TS[ap as usize]
                    let pkne = TE[ap as usize]
                    if src_match(pkns, pkne - pkns, "add") && ap + 1 < TC && TK[(ap + 1) as usize] == 43 {
                        ap = ap + 2
                        while ap < TC && TK[ap as usize] != 27 && TK[ap as usize] != 9 && TK[ap as usize] != 0 {
                            if TK[ap as usize] == 3 {
                                if src_match(TS[ap as usize], TE[ap as usize] - TS[ap as usize], "commutative") { al_props = al_props | 2 }
                                if src_match(TS[ap as usize], TE[ap as usize] - TS[ap as usize], "associative") { al_props = al_props | 4 }
                            }
                            ap = ap + 1
                        }
                        if ap < TC && TK[ap as usize] == 27 { ap = ap + 1 }
                        continue
                    }
                    if src_match(pkns, pkne - pkns, "mul") && ap + 1 < TC && TK[(ap + 1) as usize] == 43 {
                        ap = ap + 2
                        // Clear defaults — explicit mul: overrides
                        al_props = al_props & ~8   // clear mul_comm
                        al_props = al_props & ~16  // clear mul_assoc
                        while ap < TC && TK[ap as usize] != 27 && TK[ap as usize] != 9 && TK[ap as usize] != 0 {
                            if TK[ap as usize] == 3 {
                                if src_match(TS[ap as usize], TE[ap as usize] - TS[ap as usize], "commutative") { al_props = al_props | 8 }
                                if src_match(TS[ap as usize], TE[ap as usize] - TS[ap as usize], "non_commutative") { al_props = al_props & ~8 }
                                if src_match(TS[ap as usize], TE[ap as usize] - TS[ap as usize], "associative") { al_props = al_props | 16 }
                                if src_match(TS[ap as usize], TE[ap as usize] - TS[ap as usize], "alternative") { al_props = al_props | 32; al_props = al_props & ~16 }
                            }
                            ap = ap + 1
                        }
                        if ap < TC && TK[ap as usize] == 27 { ap = ap + 1 }
                        continue
                    }
                    if src_match(pkns, pkne - pkns, "reassociate") && ap + 1 < TC && TK[(ap + 1) as usize] == 43 {
                        ap = ap + 2
                        while ap < TC && TK[ap as usize] != 27 && TK[ap as usize] != 9 && TK[ap as usize] != 0 {
                            if TK[ap as usize] == 3 {
                                if src_match(TS[ap as usize], TE[ap as usize] - TS[ap as usize], "full") { al_props = (al_props & ~192) | 64 }
                                if src_match(TS[ap as usize], TE[ap as usize] - TS[ap as usize], "fano_selective") { al_props = (al_props & ~192) | 128 }
                            }
                            ap = ap + 1
                        }
                        if ap < TC && TK[ap as usize] == 27 { ap = ap + 1 }
                        continue
                    }
                }
                ap = ap + 1
            }
            // Register as struct if basis was declared
            if alg_fc > 0 && ST_COUNT < 200 {
                let asi = ST_COUNT
                let abase = asi * 130
                ST[abase as usize] = alg_hash
                ST[(abase + 1) as usize] = alg_fc
                var fp: i64 = alg_basis_p
                var fi: i64 = 0
                while fi < alg_fc && fp < TC && TK[fp as usize] != 9 {
                    if TK[fp as usize] == 3 && fp + 1 < TC && TK[(fp + 1) as usize] == 43 { break }
                    if TK[fp as usize] == 3 {
                        ST[(abase + 2 + fi) as usize] = gl_name_hash(TS[fp as usize], TE[fp as usize])
                        ST_FTY[(asi * 128 + fi) as usize] = alg_base_ty
                        ST_FHASH[(asi * 128 + fi) as usize] = 0
                        fi = fi + 1
                    }
                    fp = fp + 1
                }
                ST_LINEAR[asi as usize] = 0
                ST_AFFINE[asi as usize] = 0
                AL_PROPS[asi as usize] = al_props
                ST_COUNT = ST_COUNT + 1
            }
            // Skip to end of algebra block
            while p < TC && TK[p as usize] != 9 && TK[p as usize] != 0 { p = p + 1 }
            if p < TC && TK[p as usize] == 9 { p = p + 1 }
            continue
        }
        // Study block: validate hypothesis presence + set CURRENT_STUDY_EFFECT
        // Functions inside study blocks get implicit Hypothesis effect (bit 256).
        if pass0a_depth == 0 && (TK[p as usize] == 71 || (TK[p as usize] == 3 && src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "study"))) {
            let study_tok = p
            // Pre-scan: walk ahead to check for hypothesis without consuming p
            var sp: i64 = p + 1
            var saw_hypo: i64 = 0
            while sp < TC && TK[sp as usize] != 8 && TK[sp as usize] != 0 { sp = sp + 1 }
            if sp < TC && TK[sp as usize] == 8 {
                var sd: i64 = 1
                sp = sp + 1
                while sp < TC && sd > 0 {
                    if TK[sp as usize] == 3 && src_match(TS[sp as usize], TE[sp as usize] - TS[sp as usize], "hypothesis") {
                        saw_hypo = 1
                        STUDY_HYPO_COUNT = STUDY_HYPO_COUNT + 1
                    }
                    if TK[sp as usize] == 8 { sd = sd + 1 }
                    if TK[sp as usize] == 9 { sd = sd - 1 }
                    sp = sp + 1
                }
            }
            if saw_hypo == 0 {
                TYPECHECK_FAILED = 1
                print("error: study block requires at least one hypothesis at line ")
                print_int(TL[study_tok as usize])
                print("\n")
            }
            // Set flag and let normal scanning handle the block contents
            CURRENT_STUDY_EFFECT = 256
            p = p + 1  // skip 'study' keyword
            while p < TC && TK[p as usize] != 8 && TK[p as usize] != 0 { p = p + 1 }
            continue
        }
        // Reset study context when closing a top-level study block
        if CURRENT_STUDY_EFFECT != 0 && TK[p as usize] == 9 && pass0a_depth == 1 {
            CURRENT_STUDY_EFFECT = 0
        }
        // Skip + validate ontology declarations — top-level only
        if pass0a_depth == 0 && TK[p as usize] == 72 {
            p = skip_ontology_decl(p)
            continue
        }
        // Trait declaration: trait Name { fn method(self, ...) -> T; ... }
        // Skip the block — trait methods are abstract (no codegen).
        // Register trait name hash with is_trait flag for later impl validation.
        if pass0a_depth == 0 && TK[p as usize] == 75 {
            p = p + 1  // skip 'trait'
            if p < TC && TK[p as usize] == 3 {
                let trait_ns = TS[p as usize]
                let trait_ne = TE[p as usize]
                let trait_hash = gl_name_hash(trait_ns, trait_ne)
                p = p + 1  // skip trait name
                // Register trait as a struct-like entry (for name resolution)
                if ST_COUNT < 200 {
                    let tsi = ST_COUNT
                    let tbase = tsi * 130
                    ST[tbase as usize] = trait_hash
                    ST[(tbase + 1) as usize] = 0  // no fields
                    ST_LINEAR[tsi as usize] = 0
                    ST_AFFINE[tsi as usize] = 0
                    // Mark as trait via AL_PROPS bit 8
                    AL_PROPS[tsi as usize] = AL_PROPS[tsi as usize] | 256
                    ST_COUNT = ST_COUNT + 1
                }
            }
            // Skip to end of trait block
            if p < TC && TK[p as usize] == 8 { p = p + 1 }
            var trait_depth: i64 = 1
            while p < TC && trait_depth > 0 {
                if TK[p as usize] == 8 { trait_depth = trait_depth + 1 }
                if TK[p as usize] == 9 { trait_depth = trait_depth - 1 }
                p = p + 1
            }
            continue
        }
        // Impl block: impl [TraitName for] TypeName { fn method(self: TypeName, ...) -> T { ... } }
        // Set CURRENT_IMPL_RECV_HASH so fn definitions inside get the receiver hash.
        // DON'T skip the block — let the normal function scanner handle the fn defs.
        if pass0a_depth == 0 && TK[p as usize] == 76 {
            p = p + 1  // skip 'impl'
            // Read first identifier — could be TraitName or TypeName
            if p < TC && TK[p as usize] == 3 {
                let impl_ns1 = TS[p as usize]
                let impl_ne1 = TE[p as usize]
                let impl_hash1 = gl_name_hash(impl_ns1, impl_ne1)
                p = p + 1
                var impl_type_hash: i64 = impl_hash1
                // Check for "for" keyword — if present, this is `impl Trait for Type`
                if p < TC && TK[p as usize] == 3 && src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "for") {
                    p = p + 1  // skip 'for'
                    if p < TC && TK[p as usize] == 3 {
                        impl_type_hash = gl_name_hash(TS[p as usize], TE[p as usize])
                        p = p + 1  // skip type name
                    }
                }
                // Skip generic params <T> if present
                if p < TC && TK[p as usize] == 23 {
                    while p < TC && TK[p as usize] != 24 && TK[p as usize] != 0 { p = p + 1 }
                    if p < TC && TK[p as usize] == 24 { p = p + 1 }
                }
                CURRENT_IMPL_RECV_HASH = impl_type_hash
            }
            // Don't skip the block — fall through to let fn scanner handle methods.
            // The { will increment pass0a_depth, } will decrement it.
            // We need to reset CURRENT_IMPL_RECV_HASH when the block ends.
            continue
        }
        // Reset impl context when closing a top-level block
        if CURRENT_IMPL_RECV_HASH != 0 && TK[p as usize] == 9 && pass0a_depth == 1 {
            CURRENT_IMPL_RECV_HASH = 0
        }
        if pass0a_depth == 0 && (TK[p as usize] == 46 || TK[p as usize] == 49 || TK[p as usize] == 62 || TK[p as usize] == 73) {
            // struct or pub/linear/affine keyword — skip prefix, track linear/affine
            var is_linear_decl: i64 = 0
            var is_affine_decl: i64 = 0
            if TK[p as usize] == 62 { is_linear_decl = 1 }
            if TK[p as usize] == 73 { is_affine_decl = 1 }
            if TK[p as usize] == 49 || TK[p as usize] == 62 || TK[p as usize] == 73 { p = p + 1 }
            if TK[p as usize] == 46 {
                p = p + 1  // skip 'struct'
                let sn_ns = TS[p as usize]
                let sn_ne = TE[p as usize]
                p = p + 1  // skip name
                // Generic templates still need field layouts for inferred struct literals.
                if TK[p as usize] == 23 {
                    while TK[p as usize] != 24 && TK[p as usize] != 0 { p = p + 1 }
                    if TK[p as usize] == 24 { p = p + 1 }
                }
                let sh = gl_name_hash(sn_ns, sn_ne)
                let si = ST_COUNT
                let base = si * 130
                ST[base as usize] = sh
                if TK[p as usize] == 8 { p = p + 1 }  // skip {
                var fc: i64 = 0
                while TK[p as usize] != 9 && TK[p as usize] != 0 {
                    if TK[p as usize] == 3 {
                        let fh = gl_name_hash(TS[p as usize], TE[p as usize])
                        let ffi = fc
                        ST[(base + 2 + fc) as usize] = fh
                        p = p + 1
                        // Skip : type
                        if TK[p as usize] == 43 {
                            p = p + 1
                            scan_type(p)
                            ST_FTY[(si * 128 + ffi) as usize] = SCAN_TY
                            ST_FHASH[(si * 128 + ffi) as usize] = SCAN_TY_HASH
                            p = SCAN_TY_NEXT
                        } else {
                            ST_FTY[(si * 128 + ffi) as usize] = 0
                            ST_FHASH[(si * 128 + ffi) as usize] = 0
                        }
                        fc = fc + 1
                        // Skip comma
                        if TK[p as usize] == 28 { p = p + 1 }
                        continue
                    }
                    p = p + 1
                }
                ST[(base + 1) as usize] = fc
                // Propagate: if any field is a linear struct, this struct is implicitly linear
                var ffi3: i64 = 0
                while ffi3 < fc {
                    if ST_FTY[(si * 128 + ffi3) as usize] == 6 {
                        let fsi3 = st_find(ST_FHASH[(si * 128 + ffi3) as usize])
                        if fsi3 >= 0 && ST_LINEAR[fsi3 as usize] == 1 { is_linear_decl = 1 }
                    }
                    ffi3 = ffi3 + 1
                }
                ST_LINEAR[si as usize] = is_linear_decl
                ST_AFFINE[si as usize] = is_affine_decl
                ST_COUNT = ST_COUNT + 1
                if TK[p as usize] == 9 { p = p + 1 }
                continue
            }
        }
        p = p + 1
    }
    resolve_forward_struct_types()
    // Also scan enums in the same pass
    p = 0
    EN_COUNT = 0
    while p < TC {
        if TK[p as usize] == 47 {
            p = p + 1  // skip 'enum'
            let en_ns = TS[p as usize]
            let en_ne = TE[p as usize]
            let eh = gl_name_hash(en_ns, en_ne)
            let ei = EN_COUNT
            let base = ei * 256
            EN[base as usize] = eh
            p = p + 1  // skip name
            if TK[p as usize] == 8 { p = p + 1 }  // skip {
            var vc: i64 = 0
            var inner_depth: i64 = 0
            while p < TC && (TK[p as usize] != 9 || inner_depth > 0) {
                if TK[p as usize] == 8 {
                    inner_depth = inner_depth + 1
                    p = p + 1
                    continue
                }
                if TK[p as usize] == 9 {
                    inner_depth = inner_depth - 1
                    p = p + 1
                    continue
                }
                if inner_depth == 0 && TK[p as usize] == 3 {
                    let vh = gl_name_hash(TS[p as usize], TE[p as usize])
                    EN[(base + 2 + vc) as usize] = vh
                    vc = vc + 1
                }
                p = p + 1
            }
            EN[(base + 1) as usize] = vc
            EN_COUNT = EN_COUNT + 1
            if TK[p as usize] == 9 { p = p + 1 }
            continue
        }
        p = p + 1
    }
    p = 0

    // Pass 0c+0d: monomorphization (in separate function to limit stack usage)
    mono_pass()
    p = 0
    // Pass 0b: register global variables
    var depth: i64 = 0
    while p < TC {
        let tk = TK[p as usize]
        if tk == 8 { depth = depth + 1; p = p + 1; continue }
        if tk == 9 { depth = depth - 1; p = p + 1; continue }
        if depth > 0 { p = p + 1; continue }
        // Top-level var
        if tk == 12 {
            p = p + 1
            let gns = TS[p as usize]
            let gne = TE[p as usize]
            p = p + 1
            // Expect : type
            if TK[p as usize] == 43 {
                p = p + 1
                let tns = TS[p as usize]
                let tne = TE[p as usize]
                // Check if [TYPE; N] array
                if TK[p as usize] == 41 {
                    // [TYPE; N]
                    p = p + 1
                    let etns = TS[p as usize]
                    let etne = TE[p as usize]
                    let elem_ty = type_name_kind(etns, etne)
                    var esiz: i64 = 8
                    if src_match(etns, etne - etns, "i8") { esiz = 1 }
                    p = p + 1
                    // Skip ;
                    if TK[p as usize] == 27 { p = p + 1 }
                    // Array length
                    let alen = TV[p as usize]
                    p = p + 1
                    // Skip ]
                    if TK[p as usize] == 42 { p = p + 1 }
                    let gix = gl_add(gns, gne, esiz, alen)
                    if gix >= 0 {
                        GL_TY[gix as usize] = 8
                        GL_TY_HASH[gix as usize] = arr_ty_hash(alen, esiz, elem_ty)
                    }
                } else {
                    // Scalar: i64, i32, bool, string
                    scan_type(p)
                    let gix = gl_add(gns, gne, 8, 0)
                    if gix >= 0 {
                        GL_TY[gix as usize] = SCAN_TY
                        GL_TY_HASH[gix as usize] = SCAN_TY_HASH
                    }
                    p = SCAN_TY_NEXT
                }
            }
            // Skip = initializer until next var or fn or EOF
            while p < TC && TK[p as usize] != 12 && TK[p as usize] != 1 && TK[p as usize] != 0 { p = p + 1 }
            continue
        }
        p = p + 1
    }
    p = 0

    ASYNC_RT_INIT_BSS_OFF = bss_alloc_aligned(8)
    ASYNC_RT_INIT_LOCK_BSS_OFF = bss_alloc_aligned(8)
    ASYNC_RT_QUEUE_LOCK_BSS_OFF = bss_alloc_aligned(8)
    ASYNC_RT_QUEUE_HEAD_BSS_OFF = bss_alloc_aligned(8)
    ASYNC_RT_QUEUE_TAIL_BSS_OFF = bss_alloc_aligned(8)
    ASYNC_RT_QUEUE_COUNT_BSS_OFF = bss_alloc_aligned(8)
    ASYNC_RT_WORKER_COUNT_BSS_OFF = bss_alloc_aligned(8)
    ASYNC_RT_MAIN_TID_BSS_OFF = bss_alloc_aligned(8)
    ASYNC_RT_QUEUE_PTRS_BSS_OFF = bss_alloc_aligned(8 * async_rt_queue_cap_x86())
    GPU_EMU_THREAD_ID_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_STATE_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_DIAG_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_LIBCUDA_HANDLE_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_DEVICE_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CTX_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CUINIT_PTR_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CUDEVICEGET_PTR_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CUCTXCREATE_PTR_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CUCTXSYNC_PTR_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CUMODULELOADDATA_PTR_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CUMODULEGETFUNCTION_PTR_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CUMEMALLOC_PTR_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CUMEMFREE_PTR_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CUMEMCPYHTOD_PTR_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CUMEMCPYDTOH_PTR_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CULAUNCHKERNEL_PTR_BSS_OFF = bss_alloc_aligned(8)
    PTX_LEN = 0
    NEEDS_GPU_RUNTIME_DYNLINK = 0

    // BSS layout: [argc(8)] [argv(8)] [globals...] [aggregate return scratch]
    RET_AGG_BSS_OFF = GL_BSS_SIZE
    GL_BSS_SIZE = GL_BSS_SIZE + 1048576  // 1MB scratch for aggregate (struct/array) returns
    // Add 16 to BSS_BASE so globals start at BSS+16, but argc/argv at BSS+0
    if TARGET_OS == 2 {
        GL_BSS_BASE = 0x100008000 + 16    // macOS: __DATA segment at 0x100008000
    } else {
        GL_BSS_BASE = 0x10000000 + 16     // Linux/Windows: BSS at 0x10000000 (256MB, never overlaps code)
    }
    GL_BSS_SIZE = GL_BSS_SIZE + 16
    // Runtime epistemic gate counter (8 bytes in BSS, zero-initialized)
    RT_GUARDED_OPS_BSS_OFF = GL_BSS_SIZE
    GL_BSS_SIZE = GL_BSS_SIZE + 8
    // GUM variance shadow buffer: 1024 slots × 8 bytes × 8 channels = 65536
    BUDGET_CHANNELS = 8  // must re-assign: native BSS zeroes var inits
    RT_VARIANCE_BUF_BSS_OFF = GL_BSS_SIZE
    GL_BSS_SIZE = GL_BSS_SIZE + 8192 * BUDGET_CHANNELS
    // GUM variance scratch cell: 8 bytes × 8 channels = 64
    RT_VARIANCE_SCRATCH_BSS_OFF = GL_BSS_SIZE
    GL_BSS_SIZE = GL_BSS_SIZE + 8 * BUDGET_CHANNELS
    // GUM variance transfer area: 8 slots × 8 bytes × 8 channels = 512
    RT_VARIANCE_XFER_BSS_OFF = GL_BSS_SIZE
    GL_BSS_SIZE = GL_BSS_SIZE + 64 * BUDGET_CHANNELS
    // β⁴ forward-mode AD: per-input variance σ²[ch] storage (8 bytes × 8 channels)
    RT_INPUT_VAR_BSS_OFF = GL_BSS_SIZE
    GL_BSS_SIZE = GL_BSS_SIZE + 8 * BUDGET_CHANNELS
    NEXT_BUDGET_PARAM = 0

    print("globals: "); print_int(GL_COUNT); print(" bss="); print_int(GL_BSS_SIZE); print("\n")

    // Pass 1: register all function names (skip generic templates)
    while p < TC {
        if tok_is_fn_decl_start(p) {
            let name_p = tok_fn_name_index(p)
            FN_IS_KERNEL[FN_COUNT as usize] = 0
            FN_IS_ASYNC[FN_COUNT as usize] = 0
            if token_is_kernel_fn_name_marker(name_p) { FN_IS_KERNEL[FN_COUNT as usize] = 1 }
            if TK[p as usize] == 77 { FN_IS_ASYNC[FN_COUNT as usize] = 1 }
            ptx_reset_fn_meta(FN_COUNT)
            p = name_p
            if p + 2 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 3) as usize] == 24 { p = p + 1; continue }
            FN_NS[FN_COUNT as usize] = TS[p as usize]
            FN_NE[FN_COUNT as usize] = TE[p as usize]
            FN_OFF[FN_COUNT as usize] = -1
            FN_COUNT = FN_COUNT + 1
        }
        p = p + 1
    }

    p = 0
    var sig_fi: i64 = 0
    var sig_study_depth: i64 = 0   // >0 means we're inside a study block
    var sig_impl_hash: i64 = 0     // receiver hash for impl blocks
    while p < TC {
        // Track study block depth for implicit Hypothesis effect
        if TK[p as usize] == 71 || (TK[p as usize] == 3 && src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "study")) {
            // Find opening { of study block
            var sq: i64 = p + 1
            while sq < TC && TK[sq as usize] != 8 && TK[sq as usize] != 0 { sq = sq + 1 }
            if sq < TC && TK[sq as usize] == 8 { sig_study_depth = 1; p = sq + 1; continue }
        }
        if sig_study_depth > 0 {
            if TK[p as usize] == 8 { sig_study_depth = sig_study_depth + 1 }
            if TK[p as usize] == 9 { sig_study_depth = sig_study_depth - 1 }
        }
        // Track impl block for receiver hash
        if TK[p as usize] == 76 {
            var iq: i64 = p + 1
            if iq < TC && TK[iq as usize] == 3 {
                var ih: i64 = gl_name_hash(TS[iq as usize], TE[iq as usize])
                iq = iq + 1
                if iq < TC && TK[iq as usize] == 3 && src_match(TS[iq as usize], TE[iq as usize] - TS[iq as usize], "for") {
                    iq = iq + 1
                    if iq < TC && TK[iq as usize] == 3 { ih = gl_name_hash(TS[iq as usize], TE[iq as usize]) }
                }
                sig_impl_hash = ih
            }
        }
        if tok_is_fn_decl_start(p) {
            // Detect pub visibility (previous token == 49) and import origin
            let name_p = tok_fn_name_index(p)
            let decl_p = p
            let fn_is_pub = decl_p > 0 && TK[(decl_p - 1) as usize] == 49
            let fn_from_import = TS[name_p as usize] >= MAIN_SRC_END && MAIN_SRC_END > 0
            p = name_p
            if p + 2 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 3) as usize] == 24 { p = p + 1; continue }
            FN_NAME_TOK[sig_fi as usize] = p
            FN_SIG[sig_fi as usize] = fnsig_from_decl_name_tok(p)
            FN_NEEDS_SESSION[sig_fi as usize] = 0
            FN_ARITY[sig_fi as usize] = 0
            FN_RET_TY[sig_fi as usize] = 5
            FN_RET_HASH[sig_fi as usize] = 0
            var q: i64 = p + 1
            if TK[q as usize] == 6 { q = q + 1 }
            while TK[q as usize] != 7 && TK[q as usize] != 0 {
                if TK[q as usize] == 3 {
                    let is_first_param = FN_ARITY[sig_fi as usize] == 0
                    FN_ARITY[sig_fi as usize] = FN_ARITY[sig_fi as usize] + 1
                    q = q + 1
                    if TK[q as usize] == 43 {
                        q = q + 1
                        if TK[q as usize] == 3 && src_match(TS[q as usize], TE[q as usize] - TS[q as usize], "chan") {
                            FN_NEEDS_SESSION[sig_fi as usize] = 1
                        }
                        scan_type(q)
                        if is_first_param {
                            if SCAN_TY == 6 {
                                FN_RECV_HASH[sig_fi as usize] = SCAN_TY_HASH
                            } else if SCAN_TY == 10 {
                                let inner_ty = ref_hash_inner_ty(SCAN_TY_HASH)
                                let inner_hash = ref_hash_inner_hash(SCAN_TY_HASH)
                                if inner_ty == 6 {
                                    FN_RECV_HASH[sig_fi as usize] = inner_hash
                                }
                            }
                        }
                        if knowledge_hash_invalid(SCAN_TY_HASH) {
                            if 1 == 1 {
                                print("DEBUG sig ty=")
                                print_int(SCAN_TY)
                                print(" hash=")
                                print_int(SCAN_TY_HASH)
                                print(" eps=")
                                print_int(knowledge_hash_eps(SCAN_TY_HASH))
                                print("\n")
                            }
                            tc_epistemic_boundary(q)
                        }
                        q = SCAN_TY_NEXT
                    }
                } else {
                    q = q + 1
                }
                if TK[q as usize] == 28 { q = q + 1 }
            }
            if TK[q as usize] == 7 { q = q + 1 }
            if TK[q as usize] == 10 {
                q = q + 1
                if TK[q as usize] == 3 && src_match(TS[q as usize], TE[q as usize] - TS[q as usize], "chan") {
                    FN_NEEDS_SESSION[sig_fi as usize] = 1
                }
                scan_type(q)
                if knowledge_hash_invalid(SCAN_TY_HASH) {
                    if 1 == 1 {
                        print("DEBUG ret ty=")
                        print_int(SCAN_TY)
                        print(" hash=")
                        print_int(SCAN_TY_HASH)
                        print(" eps=")
                        print_int(knowledge_hash_eps(SCAN_TY_HASH))
                        print("\n")
                    }
                    tc_epistemic_boundary(q)
                    FN_RET_TY[sig_fi as usize] = 0
                    FN_RET_HASH[sig_fi as usize] = 0
                } else {
                    FN_RET_TY[sig_fi as usize] = SCAN_TY
                    FN_RET_HASH[sig_fi as usize] = SCAN_TY_HASH
                }
                q = SCAN_TY_NEXT
            }
            q = skip_signature_where_clause(q)
            // Impl block: if we're inside an impl, force receiver hash
            if sig_impl_hash != 0 && FN_RECV_HASH[sig_fi as usize] == 0 {
                FN_RECV_HASH[sig_fi as usize] = sig_impl_hash
            }
            // Study block: functions inside get implicit Hypothesis effect (bit 256)
            if sig_study_depth > 0 {
                FN_EFFECTS[sig_fi as usize] = FN_EFFECTS[sig_fi as usize] | 256
            }
            // Visibility tracking: bit 10 = pub, bit 11 = from_import
            if fn_is_pub { FN_EFFECTS[sig_fi as usize] = FN_EFFECTS[sig_fi as usize] | 1024 }
            if fn_from_import { FN_EFFECTS[sig_fi as usize] = FN_EFFECTS[sig_fi as usize] | 2048 }
            var dup_i: i64 = 0
            while dup_i < sig_fi {
                if name_eq(FN_NS[dup_i as usize], FN_NE[dup_i as usize], FN_NS[sig_fi as usize], FN_NE[sig_fi as usize]) {
                    if FN_RECV_HASH[dup_i as usize] == FN_RECV_HASH[sig_fi as usize] {
                        tc_duplicate_fn(FN_NAME_TOK[sig_fi as usize])
                    }
                }
                dup_i = dup_i + 1
            }
            if sig_fi < FN_COUNT { sig_fi = sig_fi + 1 }
        }
        p = p + 1
    }

    // Refine unsized array return signatures from direct top-level `return [ ... ]` literals.
    p = 0
    var ret_fi: i64 = 0
    while p < TC {
        if tok_is_fn_decl_start(p) {
            p = tok_fn_name_index(p)
            if p + 2 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 3) as usize] == 24 { p = p + 1; continue }
            var q: i64 = p + 1
            if TK[q as usize] == 6 { q = q + 1 }
            while q < TC && TK[q as usize] != 8 { q = q + 1 }
            if FN_RET_TY[ret_fi as usize] == 8 && arr_hash_alen(FN_RET_HASH[ret_fi as usize]) == 0 {
                let ret_esiz = arr_hash_esiz(FN_RET_HASH[ret_fi as usize])
                let ret_elem_ty = arr_hash_elem_ty(FN_RET_HASH[ret_fi as usize])
                var bd: i64 = 0
                if TK[q as usize] == 8 { bd = 1; q = q + 1 }
                while q < TC && bd > 0 {
                    if TK[q as usize] == 8 { bd = bd + 1; q = q + 1; continue }
                    if TK[q as usize] == 9 { bd = bd - 1; q = q + 1; continue }
                    if bd == 1 && TK[q as usize] == 2 && TK[(q + 1) as usize] == 41 {
                        let ret_alen = array_lit_count(q + 1)
                        if ret_alen > 0 {
                            FN_RET_HASH[ret_fi as usize] = arr_ty_hash(ret_alen, ret_esiz, ret_elem_ty)
                        }
                        q = TC
                        bd = 0
                        continue
                    }
                    q = q + 1
                }
            }
            if ret_fi < FN_COUNT { ret_fi = ret_fi + 1 }
        }
        p = p + 1
    }

    // Pass 1b: scan effects clauses for each function
    // For each fn at index fi, scan forward from its name token to find 'with' (38)
    // and record effect bitmask: IO=1, Mut=2, Panic=4, Div=8, Alloc=16,
    // Async=32, Observe=64, Audit=128, Hypothesis=256
    p = 0
    var eff_fi: i64 = 0
    while p < TC {
        if tok_is_fn_decl_start(p) {
            p = tok_fn_name_index(p)
            // Skip generic templates
            if p + 2 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 3) as usize] == 24 { p = p + 1; continue }
            // Scan forward to find { (start of body) — effects are between ) -> type with ... {
            var eq: i64 = p + 1
            while eq < TC && TK[eq as usize] != 8 { eq = eq + 1 }
            // Scan only the function's own top-level `with`, not nested effect
            // clauses inside function-typed parameters or return types.
            var ew: i64 = p + 1
            if TK[ew as usize] == 6 {
                var depth: i64 = 1
                ew = ew + 1
                while ew < eq && depth > 0 {
                    if TK[ew as usize] == 6 { depth = depth + 1 }
                    if TK[ew as usize] == 7 { depth = depth - 1 }
                    ew = ew + 1
                }
            }
            if TK[ew as usize] == 10 {
                ew = ew + 1
                scan_type(ew)
                ew = SCAN_TY_NEXT
            }
            ew = skip_signature_where_clause(ew)
            if TK[ew as usize] == 38 {
                ew = ew + 1
                while ew < eq && (TK[ew as usize] == 3 || TK[ew as usize] == 28) {
                    if TK[ew as usize] == 3 {
                        let ens = TS[ew as usize]
                        let ene = TE[ew as usize]
                        var matched_builtin: i64 = 0
                        if src_match(ens, ene - ens, "IO") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 1; matched_builtin = 1 }
                        if src_match(ens, ene - ens, "Mut") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 2; matched_builtin = 1 }
                        if src_match(ens, ene - ens, "Panic") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 4; matched_builtin = 1 }
                        if src_match(ens, ene - ens, "Div") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 8; matched_builtin = 1 }
                        if src_match(ens, ene - ens, "Alloc") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 16; matched_builtin = 1 }
                        if src_match(ens, ene - ens, "Async") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 32; matched_builtin = 1 }
                        if src_match(ens, ene - ens, "Observe") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 64; matched_builtin = 1 }
                        if src_match(ens, ene - ens, "Audit") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 128; matched_builtin = 1 }
                        if src_match(ens, ene - ens, "Hypothesis") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 256; matched_builtin = 1 }
                        if src_match(ens, ene - ens, "Epistemic") {
                            FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 512; matched_builtin = 1
                            // Parse optional Epistemic(minconf: 0.95)
                            if ew + 1 < eq && TK[(ew + 1) as usize] == 6 {
                                var ep: i64 = ew + 2
                                while ep < eq && TK[ep as usize] != 7 {
                                    if TK[ep as usize] == 3 && src_match(TS[ep as usize], TE[ep as usize] - TS[ep as usize], "minconf") {
                                        ep = ep + 1
                                        if TK[ep as usize] == 43 { ep = ep + 1 }
                                        if TK[ep as usize] == 53 {
                                            FN_EPIST_MINCONF[eff_fi as usize] = TV[ep as usize] * 1000 + (TF[ep as usize] * 1000) / TD[ep as usize]
                                        } else if TK[ep as usize] == 4 {
                                            FN_EPIST_MINCONF[eff_fi as usize] = TV[ep as usize] * 1000
                                        }
                                    }
                                    ep = ep + 1
                                }
                                ew = ep
                            }
                        }
                        if matched_builtin == 0 { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 32 }
                    }
                    ew = ew + 1
                }
            }
            // E070/E072: Kernel function validation
            if eff_fi < FN_COUNT && FN_IS_KERNEL[eff_fi as usize] != 0 {
                let kernel_eff = FN_EFFECTS[eff_fi as usize]
                // E070: kernel cannot have IO, Mut, or Alloc effects
                if (kernel_eff & 1) != 0 { tc_kernel_invalid_effect(FN_NAME_TOK[eff_fi as usize], "IO") }
                if (kernel_eff & 2) != 0 { tc_kernel_invalid_effect(FN_NAME_TOK[eff_fi as usize], "Mut") }
                if (kernel_eff & 16) != 0 { tc_kernel_invalid_effect(FN_NAME_TOK[eff_fi as usize], "Alloc") }
                // E072: kernel must return unit type
                if FN_RET_TY[eff_fi as usize] != 5 && FN_RET_TY[eff_fi as usize] != 0 {
                    tc_kernel_nonvoid_return(FN_NAME_TOK[eff_fi as usize])
                }
            }
            if eff_fi < FN_COUNT { eff_fi = eff_fi + 1 }
        }
        p = p + 1
    }
    print("effects: scanned "); print_int(eff_fi); print(" functions\n")
    var evi: i64 = 0
    while evi < FN_COUNT {
        if FN_NEEDS_SESSION[evi as usize] != 0 && (FN_EFFECTS[evi as usize] & 32) == 0 {
            tc_missing_effect(FN_NAME_TOK[evi as usize])
        }
        evi = evi + 1
    }

    // Pass 1c: scan top-level type aliases (token 61)
    p = 0
    var tdepth: i64 = 0
    while p < TC {
        let ttk = TK[p as usize]
        if ttk == 8 { tdepth = tdepth + 1; p = p + 1; continue }
        if ttk == 9 { tdepth = tdepth - 1; p = p + 1; continue }
        if tdepth > 0 { p = p + 1; continue }
        if ttk == 61 {
            // type NAME = ...
            p = p + 1
            if p < TC && TK[p as usize] == 3 {
                let tnh = gl_name_hash(TS[p as usize], TE[p as usize])
                if REF_TYPE_COUNT < 32 {
                    REF_TYPE_HASH[REF_TYPE_COUNT as usize] = tnh
                    REF_TYPE_COUNT = REF_TYPE_COUNT + 1
                }
                p = p + 1
            }
            // Skip = and everything to next top-level declaration
            while p < TC && TK[p as usize] != 1 && TK[p as usize] != 12 && TK[p as usize] != 46 && TK[p as usize] != 47 && TK[p as usize] != 61 && TK[p as usize] != 0 { p = p + 1 }
            continue
        }
        p = p + 1
    }
    if REF_TYPE_COUNT > 0 { print("types: "); print_int(REF_TYPE_COUNT); print(" aliases\n") }
    if CLI_SHOW_AST != 0 { dump_cli_ast_summary() }
    if CLI_SHOW_TYPES != 0 { dump_cli_type_summary() }

    // Pass 1d: Epistemic type inference (Patient Zero)
    epistemic_infer_pass()

    // Pass 2: compile each function
    p = 0
    var fn_idx: i64 = 0
    while p < TC {
        if tok_is_fn_decl_start(p) == false { p = p + 1; continue }
        p = tok_fn_name_index(p)  // skip optional 'async' and 'fn'
        let is_kernel_fn = FN_IS_KERNEL[fn_idx as usize]

        // Skip generic function templates
        if p + 2 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 3) as usize] == 24 {
            while p < TC && TK[p as usize] != 8 { p = p + 1 }
            var gd: i64 = 1
            p = p + 1
            while p < TC && gd > 0 { if TK[p as usize] == 8 { gd = gd + 1 }; if TK[p as usize] == 9 { gd = gd - 1 }; p = p + 1 }
            continue
        }

        // Record code offset + set current function for effects checking
        FN_OFF[fn_idx as usize] = CL
        CURRENT_FN = fn_idx
        CURRENT_RET_TY = FN_RET_TY[fn_idx as usize]
        CURRENT_RET_HASH = FN_RET_HASH[fn_idx as usize]

        // E070: kernel functions cannot declare IO or Mut effects
        if is_kernel_fn != 0 {
            if (FN_EFFECTS[fn_idx as usize] & 1) != 0 {
                print("error[E070]: IO effect not allowed in kernel function at line ")
                print_int(TL[FN_NAME_TOK[fn_idx as usize] as usize])
                print("\n")
                TYPECHECK_FAILED = 1
            }
            if (FN_EFFECTS[fn_idx as usize] & 2) != 0 {
                print("error[E070]: Mut effect not allowed in kernel function at line ")
                print_int(TL[FN_NAME_TOK[fn_idx as usize] as usize])
                print("\n")
                TYPECHECK_FAILED = 1
            }
            // E072: kernel functions must return void
            if CURRENT_RET_TY != 5 && CURRENT_RET_TY != 0 {
                print("error[E072]: kernel function must return void at line ")
                print_int(TL[FN_NAME_TOK[fn_idx as usize] as usize])
                print("\n")
                TYPECHECK_FAILED = 1
            }
        }

        // Reset local vars
        VAR_COUNT = 0
        NEXT_SLOT = 1
        BREAK_COUNT = 0
        LAST_STMT_HAS_VALUE = 0
        LAST_STMT_TY = 0
        LAST_STMT_TY_HASH = 0
        CURRENT_SRET_SLOT = 0
        if ret_agg_nslots(CURRENT_RET_TY, CURRENT_RET_HASH) > 0 {
            CURRENT_SRET_SLOT = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
        }
        FRAME_PATCH_COUNT = 0

        // Register parameters
        p = p + 1  // skip name
        var kernel_extent_slot: i64 = 0
        if TK[p as usize] == 6 { p = p + 1 }
        while TK[p as usize] != 7 && TK[p as usize] != 0 {
            if TK[p as usize] == 3 {
                let pns = TS[p as usize]
                let pne = TE[p as usize]
                if var_find_idx(pns, pne) >= 0 { tc_duplicate_param(p) }
                let pslot = var_add(pns, pne)
                p = p + 1
                // Skip : type annotation (handles &T, &!T, [T; N], simple T)
                if TK[p as usize] == 43 {
                    p = p + 1  // skip :
                    scan_type(p)
                    if pslot >= 0 {
                        VAR_TY[(VAR_COUNT - 1) as usize] = SCAN_TY
                        VAR_TY_HASH[(VAR_COUNT - 1) as usize] = SCAN_TY_HASH
                        if SCAN_TY == 2 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 1 }
                        if type_is_slice_ref(SCAN_TY, SCAN_TY_HASH) {
                            let len_slot = VAR_SLOT[(VAR_COUNT - 1) as usize]
                            let ptr_slot = NEXT_SLOT
                            NEXT_SLOT = NEXT_SLOT + 1
                            VAR_SLOT[(VAR_COUNT - 1) as usize] = ptr_slot
                            VAR_LEN_SLOT[(VAR_COUNT - 1) as usize] = len_slot
                            VAR_ESIZ[(VAR_COUNT - 1) as usize] = arr_hash_esiz(ref_hash_inner_hash(SCAN_TY_HASH))
                        } else if SCAN_TY == 8 {
                            VAR_ALEN[(VAR_COUNT - 1) as usize] = SCAN_TY_ALEN
                            VAR_ESIZ[(VAR_COUNT - 1) as usize] = SCAN_TY_ESIZ
                        }
                        if is_kernel_fn != 0 && kernel_extent_slot == 0 && SCAN_TY == 1 {
                            kernel_extent_slot = VAR_SLOT[(VAR_COUNT - 1) as usize]
                        }
                        // Mark parameter as linear/affine if its type is a linear/affine struct
                        let lin_si = st_find(SCAN_TY_HASH)
                        if lin_si >= 0 && knowledge_hash_is(SCAN_TY_HASH) == false {
                            VAR_LINEAR[(VAR_COUNT - 1) as usize] = ST_LINEAR[lin_si as usize]
                            VAR_AFFINE[(VAR_COUNT - 1) as usize] = ST_AFFINE[lin_si as usize]
                        }
                    }
                    p = SCAN_TY_NEXT
                }
            } else {
                p = p + 1  // skip keyword or other non-ident token used as param name
            }
            if TK[p as usize] == 28 { p = p + 1 }
        }
        if TK[p as usize] == 7 { p = p + 1 }
        // Skip -> type
        if TK[p as usize] == 10 {
            p = p + 1
            scan_type(p)
            p = SCAN_TY_NEXT
        }
        p = skip_signature_where_clause(p)
        // Skip 'with' effects clause (with=38, ident=3, comma=28, paren=6/7 for parameterized effects)
        if TK[p as usize] == 38 {
            p = p + 1
            while TK[p as usize] == 3 || TK[p as usize] == 28 {
                p = p + 1
                if TK[p as usize] == 6 {
                    p = p + 1
                    while TK[p as usize] != 7 && TK[p as usize] != 0 { p = p + 1 }
                    if TK[p as usize] == 7 { p = p + 1 }
                }
            }
        }
        if TK[p as usize] == 8 { p = p + 1 }

        // Emit prologue: push rbp; mov rbp, rsp; sub rsp, 131072
        print_int(fn_idx)
        print(" ")
        em(0x55); em(0x48); em(0x89); em(0xe5)
        em(0x48); em(0x81); em(0xec); record_frame_patch(); em32(0)

        // Store parameters from registers/stack using low-level ABI slot order.
        var param_vi: i64 = 0
        var abi_arg_idx: i64 = 0
        if CURRENT_SRET_SLOT > 0 {
            emit_store_incoming_arg_x86(0, CURRENT_SRET_SLOT)
            abi_arg_idx = 1
        }
        while param_vi < VAR_COUNT {
            emit_store_incoming_arg_x86(abi_arg_idx, VAR_SLOT[param_vi as usize])
            // GUM: copy variance from transfer area to parameter's shadow slot
            emit_xfer_to_var_variance_x86(param_vi, VAR_SLOT[param_vi as usize])
            abi_arg_idx = abi_arg_idx + 1
            if type_is_slice_ref(VAR_TY[param_vi as usize], VAR_TY_HASH[param_vi as usize]) {
                emit_store_incoming_arg_x86(abi_arg_idx, VAR_LEN_SLOT[param_vi as usize])
                abi_arg_idx = abi_arg_idx + 1
            }
            param_vi = param_vi + 1
        }

        // Kernels that reference GPU builtins are executed through a CPU lane loop
        // until the native runtime grows real CUDA dispatch support.
        var kernel_uses_gpu_builtins: i64 = 0
        if is_kernel_fn != 0 { kernel_uses_gpu_builtins = kernel_body_uses_gpu_builtins(p) }
        if is_kernel_fn != 0 { maybe_compile_kernel_ptx(fn_idx, p, kernel_extent_slot) }
        if kernel_uses_gpu_builtins != 0 && kernel_extent_slot > 0 {
            em(0x31); em(0xc0)
            emit_store_gpu_thread_id_x86()
            let kernel_loop_top = CL
            emit_load_gpu_thread_id_x86()
            em(0x50)
            emit_load_var(kernel_extent_slot)
            em(0x59)
            em(0x48); em(0x39); em(0xc1)
            em(0x0f); em(0x9c); em(0xc0)
            em(0x48); em(0x0f); em(0xb6); em(0xc0)
            em(0x48); em(0x85); em(0xc0)
            em(0x0f); em(0x84)
            let kernel_loop_end = CL
            em32(0)
            EP = p
            var kernel_body_depth: i64 = 1
            while EP < TC && kernel_body_depth > 0 {
                if TK[EP as usize] == 9 { kernel_body_depth = kernel_body_depth - 1; if kernel_body_depth == 0 { EP = EP + 1; continue } else { EP = EP + 1; continue } }
                compile_stmt()
            }
            emit_load_gpu_thread_id_x86()
            em(0x48); em(0x83); em(0xc0); em(1)
            emit_store_gpu_thread_id_x86()
            em(0xe9)
            em32(kernel_loop_top - (CL + 4))
            patch32(kernel_loop_end, CL)
            p = EP
        } else {
            // Compile body
            EP = p
            var depth: i64 = 1
            while EP < TC && depth > 0 {
                if TK[EP as usize] == 9 { depth = depth - 1; if depth == 0 { EP = EP + 1; continue } else { EP = EP + 1; continue } }
                compile_stmt()
            }
            p = EP
        }

        // Linear type check: warn if any linear variable was not used exactly once
        var lci: i64 = 0
        while lci < VAR_COUNT {
            if VAR_LINEAR[lci as usize] == 1 {
                if VAR_USED[lci as usize] == 0 {
                    tc_linear_violation(FN_NAME_TOK[fn_idx as usize], "linear value not consumed")
                }
                if VAR_USED[lci as usize] > 1 {
                    tc_linear_violation(FN_NAME_TOK[fn_idx as usize], "linear value used more than once")
                }
            }
            lci = lci + 1
        }

        // Implicit return 0
        if CL > 0 && CD[(CL - 1) as usize] != 0xc3 as i8 {
            // Unit return type (5 = no explicit return): always emit xor eax, eax
            if CURRENT_RET_TY == 5 {
                em(0x31); em(0xc0)
            } else if LAST_STMT_HAS_VALUE == 0 {
                em(0x31); em(0xc0)
            } else if ty_eq(CURRENT_RET_TY, CURRENT_RET_HASH, LAST_STMT_TY, LAST_STMT_TY_HASH) == false {
                if (ty_is_numeric(CURRENT_RET_TY) && ty_is_numeric(LAST_STMT_TY)) == false {
                    if (CURRENT_RET_TY != 0 || CURRENT_RET_HASH != 0) && (LAST_STMT_TY != 0 || LAST_STMT_TY_HASH != 0) {
                        if type_has_knowledge(CURRENT_RET_TY, CURRENT_RET_HASH) || type_has_knowledge(LAST_STMT_TY, LAST_STMT_TY_HASH) {
                            tc_epistemic_boundary(EP)
                        } else {
                            print("warning: tail type mismatch at line ")
                            print_int(TL[(EP - 1) as usize])
                            print("\n")
                        }
                    }
                }
            } else if type_is_aggregate(CURRENT_RET_TY, CURRENT_RET_HASH) || type_is_aggregate(LAST_STMT_TY, LAST_STMT_TY_HASH) {
                stabilize_return_agg_x86(LAST_STMT_TY, LAST_STMT_TY_HASH)
            }
            // Observation boundary: implicit tail return of Unobserved<T> as non-Unobserved
            if ty_is_unobserved(LAST_STMT_TY) && !ty_is_unobserved(CURRENT_RET_TY) && CURRENT_RET_TY != 5 && (FN_EFFECTS[CURRENT_FN as usize] & 64) == 0 {
                tc_observe_boundary(EP - 1, "cannot return Unobserved<T> as non-Unobserved type")
            }
            em(0x48); em(0x81); em(0xc4); record_frame_patch(); em32(0)
            em(0x5d); em(0xc3)
        }
        // Patch sub rsp / add rsp with actual frame size
        let frame_sz = (NEXT_SLOT * 8 + 15) & 0xFFFFFFF0
        FN_FRAME_SIZE[fn_idx as usize] = frame_sz
        if frame_sz > max_frame_bytes() { tc_stack_frame_too_large(frame_sz) }
        var fpi: i64 = 0
        while fpi < FRAME_PATCH_COUNT { em32_at(FRAME_PATCH_OFF[fpi as usize], frame_sz); fpi = fpi + 1 }
        fn_idx = fn_idx + 1
    }

    if TYPECHECK_FAILED != 0 {
        print_limit_error()
        print("typecheck: failed\n")
        return 1
    }

    // Patch function calls
    var pi: i64 = 0
    while pi < PATCH_COUNT {
        let off = PATCH_OFF[pi as usize]
        let fi = PATCH_FN[pi as usize]
        if fi >= 0 && fi < FN_COUNT && off >= 0 && off + 3 < CL {
            let target = FN_OFF[fi as usize]
            if PATCH_KIND[pi as usize] == 3 {
                let abs = async_rt_text_base_x86() + target
                em64_at(off, abs)
            } else {
                let rel = target - (off + 4)
                CD[(off) as usize] = (rel & 0xFF) as i8
                CD[(off + 1) as usize] = ((rel >> 8) & 0xFF) as i8
                CD[(off + 2) as usize] = ((rel >> 16) & 0xFF) as i8
                CD[(off + 3) as usize] = ((rel >> 24) & 0xFF) as i8
            }
        }
        pi = pi + 1
    }

    // Find main
    var main_fn: i64 = -1
    var mi: i64 = 0
    while mi < FN_COUNT {
        let ms = FN_NS[mi as usize]
        let me = FN_NE[mi as usize]
        if main_fn < 0 && me - ms == 4 && sb(ms) == 109 && sb(ms+1) == 97 && sb(ms+2) == 105 && sb(ms+3) == 110 { main_fn = mi }
        mi = mi + 1
    }
    if main_fn < 0 { print("error: no main\n"); return 1 }

    // Trampoline: save argc/argv, call main, exit
    TRAMP_OFF = CL
    let tramp = CL

    if TARGET_OS == 3 {
        // Windows PE trampoline: call main, then ExitProcess(rax) via IAT
        // No argc/argv on Windows MVP (would need GetCommandLineW)
        // sub rsp, 40 — align stack + shadow space
        em(0x48); em(0x83); em(0xEC); em(0x28)
        // call main
        em(0xe8)
        let wrel = FN_OFF[main_fn as usize] - (CL + 4)
        em32(wrel)
        // mov ecx, eax — exit code to RCX (Win64 first param)
        em(0x89); em(0xC1)
        // call [rip+disp32] — ExitProcess via IAT (disp32 patched by write_pe)
        PE_EXIT_CALL_OFF = CL + 2   // remember offset of disp32 for patching
        em(0xFF); em(0x15); em32(0)  // placeholder disp32
        // ud2 (should never reach)
        em(0x0F); em(0x0B)
    } else if TARGET_OS == 2 {
        // macOS x86_64 trampoline
        // macOS entry: same argc/argv layout as Linux
        let argc_addr = 0x100008000  // __DATA segment base
        let argv_addr = 0x100008000 + 8
        em(0x48); em(0x8b); em(0x04); em(0x24)  // mov rax, [rsp] (argc)
        em(0x48); em(0x83); em(0xe8); em(0x01)  // sub rax, 1
        em(0x48); em(0xb9); em64(argc_addr)
        em(0x48); em(0x89); em(0x01)  // mov [rcx], rax
        em(0x48); em(0x8d); em(0x44); em(0x24); em(16)  // lea rax, [rsp+16]
        em(0x48); em(0xb9); em64(argv_addr)
        em(0x48); em(0x89); em(0x01)  // mov [rcx], rax
        // call main
        em(0xe8)
        let mrel = FN_OFF[main_fn as usize] - (CL + 4)
        em32(mrel)
        // macOS exit: syscall 0x2000001
        em(0x89); em(0xc7)                     // mov edi, eax
        em(0x48); em(0xb8); em64(0x2000001)    // mov rax, 0x2000001
        em(0x0f); em(0x05)                     // syscall
    } else {
        // Linux trampoline
        let argc_addr = 0x10000000
        let argv_addr = 0x10000000 + 8
        em(0x48); em(0x8b); em(0x04); em(0x24)  // mov rax, [rsp] (argc)
        em(0x48); em(0x83); em(0xe8); em(0x01)  // sub rax, 1 (skip program name)
        em(0x48); em(0xb9); em64(argc_addr)
        em(0x48); em(0x89); em(0x01)  // mov [rcx], rax (save argc-1)
        em(0x48); em(0x8d); em(0x44); em(0x24); em(16)  // lea rax, [rsp+16] (argv+1)
        em(0x48); em(0xb9); em64(argv_addr)
        em(0x48); em(0x89); em(0x01)  // mov [rcx], rax (save argv ptr)
        // call main
        em(0xe8)
        let rel = FN_OFF[main_fn as usize] - (CL + 4)
        em32(rel)
        // Runtime epistemic gate report: if guarded ops > 0, print count
        em(0x50)  // push rax (save exit code)
        // mov rax, [BSS + RT_GUARDED_OPS_BSS_OFF]
        em(0x48); em(0xb8); em64(GL_BSS_BASE + RT_GUARDED_OPS_BSS_OFF)
        em(0x48); em(0x8b); em(0x00)  // mov rax, [rax]
        // test rax, rax; jz skip_print
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x74); em(0x00)  // jz skip (patch offset later)
        let jz_patch = CL - 1
        // rax = guarded count — print it
        emit_print_int()
        // patch the jz offset
        let skip_off = CL - (jz_patch + 1)
        CD[jz_patch as usize] = (skip_off & 0xFF) as i8
        // Runtime variance scratch report: sum all budget channels, print if non-zero
        // xorpd xmm0, xmm0 — accumulator for total scratch variance
        em(0x66); em(0x0f); em(0x57); em(0xc0)
        var vch: i64 = 0
        while vch < BUDGET_CHANNELS {
            em(0x48); em(0xb8); em64(GL_BSS_BASE + RT_VARIANCE_SCRATCH_BSS_OFF + vch * 8)
            em(0x48); em(0x8b); em(0x00)                      // mov rax, [rax]
            em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)  // movq xmm1, rax
            em(0xf2); em(0x0f); em(0x58); em(0xc1)            // addsd xmm0, xmm1
            vch = vch + 1
        }
        em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)  // movq rax, xmm0
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x74); em(0x00)            // jz skip_var (patch)
        let jz_var_patch = CL - 1
        emit_print_int()
        let skip_var_off = CL - (jz_var_patch + 1)
        CD[jz_var_patch as usize] = (skip_var_off & 0xFF) as i8
        em(0x58)  // pop rax (restore exit code)
        // exit_group(rax): Linux syscall 231, so clone-thread workers do not
        // keep the process alive after main returns.
        em(0x89); em(0xc7)
        em(0xb8); em32(231)
        em(0x0f); em(0x05)
    }

    print("compile: fns="); print_int(FN_COUNT); print(" code="); print_int(CL)
    print(" main=fn"); print_int(main_fn); print(" patches="); print_int(PATCH_COUNT)
    print(" gates[direct="); print_int(EPIST_GATES_DIRECT)
    print(" guarded="); print_int(EPIST_GATES_GUARDED); print("]\n")
    0
}

// ─── ELF byte writer helpers ───
fn elf_w8(off: i64, v: i64) with Mut, Panic { ELF[off as usize] = (v & 0xFF) as i8 }
fn elf_w16(off: i64, v: i64) with Mut, Panic { elf_w8(off, v); elf_w8(off+1, v >> 8) }
fn elf_w32(off: i64, v: i64) with Mut, Panic { elf_w16(off, v); elf_w16(off+2, v >> 16) }
fn elf_w64(off: i64, v: i64) with Mut, Panic { elf_w32(off, v); elf_w32(off+4, v >> 32) }

fn elf_write_cstr(off: i64, s: string) with Mut, Panic, Div {
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        elf_w8(off + i, str_char_at(s, i))
        i = i + 1
    }
    elf_w8(off + n, 0)
}

fn write_elf_gpu_dyn_x86(output: string) -> i64 with IO, Mut, Panic, Div {
    let text_base = gpu_dyn_linux_x86_text_base()
    let text_off = gpu_dyn_linux_x86_text_off()
    let data_off = ((text_off + CL + 4095) / 4096) * 4096
    let data_base = gpu_dyn_linux_x86_data_base()
    let bss_base = 0x10000000
    let entry = text_base + text_off + TRAMP_OFF
    let interp_off: i64 = 344
    let interp_len: i64 = 28

    let dynstr_rel: i64 = 0
    let dynstr_len: i64 = 33
    let dynsym_rel: i64 = 40
    let dynsym_entsize: i64 = 24
    let dynsym_count: i64 = 4
    let dynsym_size: i64 = dynsym_entsize * dynsym_count
    let hash_rel: i64 = 136
    let hash_size: i64 = 28
    let rela_rel: i64 = 168
    let rela_entsize: i64 = 24
    let rela_count: i64 = 3
    let rela_size: i64 = rela_entsize * rela_count
    let dynamic_rel: i64 = 240
    let dynamic_entsize: i64 = 16
    let dynamic_count: i64 = 10
    let dynamic_size: i64 = dynamic_entsize * dynamic_count
    let got_rel = gpu_dyn_linux_x86_got_off()
    let got_size: i64 = 24
    let data_size = got_rel + got_size
    let total_size = data_off + data_size

    var i: i64 = 0
    while i < total_size + 64 {
        ELF[i as usize] = 0
        i = i + 1
    }

    elf_w8(0, 0x7f); elf_w8(1, 69); elf_w8(2, 76); elf_w8(3, 70)
    elf_w8(4, 2); elf_w8(5, 1); elf_w8(6, 1)
    elf_w16(16, 2); elf_w16(18, 0x3e); elf_w32(20, 1)
    elf_w64(24, entry)
    elf_w64(32, 64)
    elf_w16(52, 64); elf_w16(54, 56); elf_w16(56, 5)
    elf_w16(58, 0); elf_w16(60, 0); elf_w16(62, 0)

    let text_filesz = text_off + CL
    let ph0 = 64
    elf_w32(ph0, 1)
    elf_w32(ph0 + 4, 5)
    elf_w64(ph0 + 8, 0)
    elf_w64(ph0 + 16, text_base)
    elf_w64(ph0 + 24, text_base)
    elf_w64(ph0 + 32, text_filesz)
    elf_w64(ph0 + 40, text_filesz)
    elf_w64(ph0 + 48, 4096)

    let ph1 = ph0 + 56
    elf_w32(ph1, 3)
    elf_w32(ph1 + 4, 4)
    elf_w64(ph1 + 8, interp_off)
    elf_w64(ph1 + 16, text_base + interp_off)
    elf_w64(ph1 + 24, text_base + interp_off)
    elf_w64(ph1 + 32, interp_len)
    elf_w64(ph1 + 40, interp_len)
    elf_w64(ph1 + 48, 1)

    let ph2 = ph1 + 56
    elf_w32(ph2, 1)
    elf_w32(ph2 + 4, 6)
    elf_w64(ph2 + 8, data_off)
    elf_w64(ph2 + 16, data_base)
    elf_w64(ph2 + 24, data_base)
    elf_w64(ph2 + 32, data_size)
    elf_w64(ph2 + 40, data_size)
    elf_w64(ph2 + 48, 4096)

    let ph3 = ph2 + 56
    elf_w32(ph3, 2)
    elf_w32(ph3 + 4, 6)
    elf_w64(ph3 + 8, data_off + dynamic_rel)
    elf_w64(ph3 + 16, data_base + dynamic_rel)
    elf_w64(ph3 + 24, data_base + dynamic_rel)
    elf_w64(ph3 + 32, dynamic_size)
    elf_w64(ph3 + 40, dynamic_size)
    elf_w64(ph3 + 48, 8)

    let ph4 = ph3 + 56
    elf_w32(ph4, 1)
    elf_w32(ph4 + 4, 6)
    elf_w64(ph4 + 8, 0)
    elf_w64(ph4 + 16, bss_base)
    elf_w64(ph4 + 24, bss_base)
    elf_w64(ph4 + 32, 0)
    elf_w64(ph4 + 40, GL_BSS_SIZE)
    elf_w64(ph4 + 48, 4096)

    elf_write_cstr(interp_off, "/lib64/ld-linux-x86-64.so.2")

    i = 0
    while i < CL {
        ELF[(text_off + i) as usize] = CD[i as usize]
        i = i + 1
    }

    let dynstr_off = data_off + dynstr_rel
    elf_w8(dynstr_off + 0, 0)
    elf_write_cstr(dynstr_off + 1, "libdl.so.2")
    elf_write_cstr(dynstr_off + 12, "dlopen")
    elf_write_cstr(dynstr_off + 19, "dlsym")
    elf_write_cstr(dynstr_off + 25, "dlclose")

    let dynsym_off = data_off + dynsym_rel
    elf_w32(dynsym_off + 24, 12)
    elf_w8(dynsym_off + 28, 0x12)
    elf_w16(dynsym_off + 30, 0)
    elf_w32(dynsym_off + 48, 19)
    elf_w8(dynsym_off + 52, 0x12)
    elf_w16(dynsym_off + 54, 0)
    elf_w32(dynsym_off + 72, 25)
    elf_w8(dynsym_off + 76, 0x12)
    elf_w16(dynsym_off + 78, 0)

    let hash_off = data_off + hash_rel
    elf_w32(hash_off + 0, 1)
    elf_w32(hash_off + 4, dynsym_count)
    elf_w32(hash_off + 8, 1)
    elf_w32(hash_off + 12, 0)
    elf_w32(hash_off + 16, 2)
    elf_w32(hash_off + 20, 3)
    elf_w32(hash_off + 24, 0)

    let rela_off = data_off + rela_rel
    elf_w64(rela_off + 0, gpu_dyn_linux_x86_got_slot_dlopen())
    elf_w64(rela_off + 8, (1 << 32) | 6)
    elf_w64(rela_off + 16, 0)
    elf_w64(rela_off + 24, gpu_dyn_linux_x86_got_slot_dlsym())
    elf_w64(rela_off + 32, (2 << 32) | 6)
    elf_w64(rela_off + 40, 0)
    elf_w64(rela_off + 48, gpu_dyn_linux_x86_got_slot_dlclose())
    elf_w64(rela_off + 56, (3 << 32) | 6)
    elf_w64(rela_off + 64, 0)

    let dynamic_off = data_off + dynamic_rel
    elf_w64(dynamic_off + 0, 1)
    elf_w64(dynamic_off + 8, 1)
    elf_w64(dynamic_off + 16, 5)
    elf_w64(dynamic_off + 24, data_base + dynstr_rel)
    elf_w64(dynamic_off + 32, 6)
    elf_w64(dynamic_off + 40, data_base + dynsym_rel)
    elf_w64(dynamic_off + 48, 10)
    elf_w64(dynamic_off + 56, dynstr_len)
    elf_w64(dynamic_off + 64, 11)
    elf_w64(dynamic_off + 72, dynsym_entsize)
    elf_w64(dynamic_off + 80, 4)
    elf_w64(dynamic_off + 88, data_base + hash_rel)
    elf_w64(dynamic_off + 96, 7)
    elf_w64(dynamic_off + 104, data_base + rela_rel)
    elf_w64(dynamic_off + 112, 8)
    elf_w64(dynamic_off + 120, rela_size)
    elf_w64(dynamic_off + 128, 9)
    elf_w64(dynamic_off + 136, rela_entsize)
    elf_w64(dynamic_off + 144, 0)
    elf_w64(dynamic_off + 152, 0)

    let ok = write_file(output, ELF, total_size)
    print("elf_dyn: "); print(output); print(" "); print_int(total_size)
    print(" bytes (bss="); print_int(GL_BSS_SIZE); print(")\n")
    return 0
}

// ─── ELF writer (2 LOAD segments: text RX + BSS RW) ───
fn write_elf(output: string) -> i64 with IO, Mut, Panic, Div {
    if TARGET_OS == 0 && TARGET_ARCH == 0 && NEEDS_GPU_RUNTIME_DYNLINK != 0 {
        return write_elf_gpu_dyn_x86(output)
    }
    let text_base = 0x400000
    let text_off = 4096
    let bss_base = 0x10000000        // 256MB: always above code, never overlaps
    let entry = text_base + text_off + TRAMP_OFF
    var i: i64 = 0
    while i < 4096 { ELF[i as usize] = 0; i = i + 1 }

    let tsz = text_off + CL

    // ELF header (64 bytes)
    elf_w8(0, 0x7f); elf_w8(1, 69); elf_w8(2, 76); elf_w8(3, 70)
    elf_w8(4, 2); elf_w8(5, 1); elf_w8(6, 1)
    elf_w16(16, 2); elf_w16(18, 0x3e); elf_w32(20, 1)
    elf_w64(24, entry)
    elf_w64(32, 64)
    elf_w16(52, 64); elf_w16(54, 56); elf_w16(56, 2); elf_w16(58, 64)

    // PT_LOAD #0: text (R+X)
    let ph0 = 64
    elf_w32(ph0, 1)                 // PT_LOAD
    elf_w32(ph0+4, 5)               // p_flags = R+X
    elf_w64(ph0+8, 0)               // p_offset = 0
    elf_w64(ph0+16, text_base)      // p_vaddr
    elf_w64(ph0+24, text_base)      // p_paddr
    elf_w64(ph0+32, tsz)            // p_filesz
    elf_w64(ph0+40, tsz)            // p_memsz (no zero-fill in text)
    elf_w64(ph0+48, 4096)           // p_align

    // PT_LOAD #1: BSS (R+W), no file data
    let ph1 = 120
    elf_w32(ph1, 1)                 // PT_LOAD
    elf_w32(ph1+4, 6)               // p_flags = R+W
    elf_w64(ph1+8, 0)               // p_offset = 0 (filesz=0, kernel zero-fills)
    elf_w64(ph1+16, bss_base)       // p_vaddr = 0x10000000
    elf_w64(ph1+24, bss_base)       // p_paddr
    elf_w64(ph1+32, 0)              // p_filesz = 0 (pure BSS)
    elf_w64(ph1+40, GL_BSS_SIZE)    // p_memsz
    elf_w64(ph1+48, 4096)           // p_align

    // Copy code after header
    i = 0
    while i < CL { ELF[(text_off + i) as usize] = CD[i as usize]; i = i + 1 }

    let ok = write_file(output, ELF, tsz)
    print("elf: "); print(output); print(" "); print_int(tsz)
    print(" bytes (bss="); print_int(GL_BSS_SIZE); print(")\n")
    return 0
}

// ─── PE/COFF writer ───
// Builds a Windows PE32+ executable from compiled code in CD[0..CL].
// Image layout: image_base=0x400000, .text at RVA 0x1000, .idata at next page, .bss at 0x200000.
// This keeps BSS virtual address at 0x600000 = 0x400000 + 0x200000, matching ELF layout.
fn write_pe(output: string) -> i64 with IO, Mut, Panic, Div {
    let image_base = 0x400000
    let sec_align = 0x1000
    let file_align = 0x200
    let text_rva = sec_align                      // 0x1000
    let text_raw_size = ((CL + file_align - 1) / file_align) * file_align
    let idata_rva = text_rva + ((CL + sec_align - 1) / sec_align) * sec_align

    // .idata layout: 1 import descriptor (20) + null (20) + INT(2*8+8=24) + IAT(24) + hints + dll name
    let idt_off: i64 = 0
    let int_off: i64 = 40
    let iat_off: i64 = 64
    let hnt_ep_off: i64 = 88         // "ExitProcess" hint/name entry
    let dll_name_off: i64 = 104      // "kernel32.dll\0"
    let idata_total: i64 = 117       // 104 + 13
    let idata_raw_size = ((idata_total + file_align - 1) / file_align) * file_align

    let bss_rva = 0x200000            // .bss section: RVA so that VA = 0x600000
    let bss_vsize = GL_BSS_SIZE
    if bss_vsize < 4096 { let bss_vsize_min = 4096 }  // minimum 1 page

    // Patch ExitProcess IAT displacement in trampoline code
    // call [rip+disp32]: disp32 = IAT_slot_RVA - (text_RVA + instruction_end_offset)
    if PE_EXIT_CALL_OFF >= 0 {
        let call_end = PE_EXIT_CALL_OFF + 4
        let disp = (idata_rva + iat_off) - (text_rva + call_end)  // IAT slot 0 = ExitProcess
        CD[PE_EXIT_CALL_OFF as usize] = (disp & 0xFF) as i8
        CD[(PE_EXIT_CALL_OFF + 1) as usize] = ((disp >> 8) & 0xFF) as i8
        CD[(PE_EXIT_CALL_OFF + 2) as usize] = ((disp >> 16) & 0xFF) as i8
        CD[(PE_EXIT_CALL_OFF + 3) as usize] = ((disp >> 24) & 0xFF) as i8
    }

    // Headers: DOS(64) + PE sig(4) + COFF(20) + OptHdr(112) + DataDirs(128) + 3 section headers(3*40=120) = 448
    // Round up to file_align = 512
    let num_sections = 3   // .text, .idata, .bss
    let headers_size = 512
    let entry_rva = text_rva + TRAMP_OFF

    // Compute size_of_image: round up to section_alignment
    let bss_end_rva = bss_rva + ((bss_vsize + sec_align - 1) / sec_align) * sec_align
    let size_of_image = bss_end_rva

    print("pe_build: code="); print_int(CL); print(" text_raw="); print_int(text_raw_size); print(" idata_rva="); print_int(idata_rva); print("\n")
    var i: i64 = 0
    while i < 1048576 { ELF[i as usize] = 0; i = i + 1 }

    // DOS header (64 bytes)
    elf_w8(0, 0x4D); elf_w8(1, 0x5A)             // "MZ"
    elf_w32(60, 64)                                // e_lfanew → PE header at offset 64

    // PE signature
    elf_w8(64, 0x50); elf_w8(65, 0x45)            // "PE\0\0"

    // COFF header (20 bytes at offset 68)
    elf_w16(68, 0x8664)                            // Machine = AMD64
    elf_w16(70, num_sections)                      // NumberOfSections
    elf_w16(84, 240)                               // SizeOfOptionalHeader (PE32+ = 112 + data dirs)
    elf_w16(86, 0x22)                              // Characteristics: EXECUTABLE | LARGE_ADDRESS_AWARE

    // Optional header (PE32+) at offset 88
    elf_w16(88, 0x020B)                            // Magic = PE32+
    elf_w32(104, entry_rva)                        // AddressOfEntryPoint
    elf_w64(112, image_base)                       // ImageBase
    elf_w32(120, sec_align)                        // SectionAlignment
    elf_w32(124, file_align)                       // FileAlignment
    elf_w16(128, 6)                                // MajorOperatingSystemVersion
    elf_w16(136, 6)                                // MajorSubsystemVersion
    elf_w32(144, size_of_image)                    // SizeOfImage
    elf_w32(148, headers_size)                     // SizeOfHeaders
    elf_w16(156, 3)                                // Subsystem = WINDOWS_CUI
    elf_w16(158, 0x8160)                           // DllCharacteristics: NX | DYNAMIC_BASE | HIGH_ENTROPY_VA | TERMINAL_SERVER
    elf_w64(160, 0x100000)                         // SizeOfStackReserve = 1MB
    elf_w64(168, 0x1000)                           // SizeOfStackCommit = 4KB
    elf_w64(176, 0x100000)                         // SizeOfHeapReserve = 1MB
    elf_w64(184, 0x1000)                           // SizeOfHeapCommit = 4KB
    elf_w32(196, 16)                               // NumberOfRvaAndSizes

    // Data directories start at offset 200 (after 112 bytes of PE32+ optional header fields)
    // Import directory (index 1, offset 200 + 1*8 = 208)
    elf_w32(208, idata_rva + idt_off)              // VirtualAddress
    elf_w32(212, 40)                               // Size (1 descriptor + null)
    // IAT directory (index 12, offset 200 + 12*8 = 296)
    elf_w32(296, idata_rva + iat_off)              // VirtualAddress
    elf_w32(300, 24)                               // Size (2 entries + null = 24)

    // Section headers start at offset 328 (88 + 240)
    let sh_base = 328

    // .text section header
    elf_w8(sh_base, 0x2E); elf_w8(sh_base+1, 0x74); elf_w8(sh_base+2, 0x65)
    elf_w8(sh_base+3, 0x78); elf_w8(sh_base+4, 0x74)  // ".text"
    elf_w32(sh_base+8, CL)                         // VirtualSize
    elf_w32(sh_base+12, text_rva)                   // VirtualAddress
    elf_w32(sh_base+16, text_raw_size)              // SizeOfRawData
    elf_w32(sh_base+20, headers_size)               // PointerToRawData
    elf_w32(sh_base+36, 0x60000020)                 // Characteristics: CODE | EXECUTE | READ

    // .idata section header
    let sh1 = sh_base + 40
    elf_w8(sh1, 0x2E); elf_w8(sh1+1, 0x69); elf_w8(sh1+2, 0x64)
    elf_w8(sh1+3, 0x61); elf_w8(sh1+4, 0x74); elf_w8(sh1+5, 0x61)  // ".idata"
    elf_w32(sh1+8, idata_total)                     // VirtualSize
    elf_w32(sh1+12, idata_rva)                      // VirtualAddress
    elf_w32(sh1+16, idata_raw_size)                 // SizeOfRawData
    elf_w32(sh1+20, headers_size + text_raw_size)   // PointerToRawData
    elf_w32(sh1+36, 0xC0000040)                     // Characteristics: INITIALIZED_DATA | READ | WRITE

    // .bss section header
    let sh2 = sh_base + 80
    elf_w8(sh2, 0x2E); elf_w8(sh2+1, 0x62); elf_w8(sh2+2, 0x73); elf_w8(sh2+3, 0x73)  // ".bss"
    elf_w32(sh2+8, bss_vsize)                       // VirtualSize
    elf_w32(sh2+12, bss_rva)                        // VirtualAddress
    elf_w32(sh2+16, 0)                              // SizeOfRawData = 0 (uninitialized)
    elf_w32(sh2+20, 0)                              // PointerToRawData = 0
    elf_w32(sh2+36, 0xC0000080)                     // Characteristics: UNINITIALIZED_DATA | READ | WRITE

    // Copy .text section (code)
    i = 0
    while i < CL { ELF[(headers_size + i) as usize] = CD[i as usize]; i = i + 1 }

    // Pad .text to file alignment
    let text_end = headers_size + text_raw_size

    // Write .idata section
    let idata_file_off = text_end

    // Import descriptor for kernel32.dll (20 bytes)
    elf_w32(idata_file_off + 0, idata_rva + int_off)    // OriginalFirstThunk (INT RVA)
    elf_w32(idata_file_off + 12, idata_rva + dll_name_off)  // Name RVA
    elf_w32(idata_file_off + 16, idata_rva + iat_off)   // FirstThunk (IAT RVA)
    // Null terminator descriptor (20 bytes of zeros — already zero)

    // INT: ExitProcess entry + null (offset 40)
    elf_w64(idata_file_off + int_off, idata_rva + hnt_ep_off)  // → hint/name for ExitProcess
    // null terminator at int_off+8 (already zero)

    // IAT: same as INT (offset 64)
    elf_w64(idata_file_off + iat_off, idata_rva + hnt_ep_off)
    // null terminator at iat_off+8 (already zero)

    // Hint/Name entry for ExitProcess (offset 88): hint(2) + "ExitProcess\0"
    elf_w16(idata_file_off + hnt_ep_off, 0)              // hint = 0
    // "ExitProcess" = 69 78 69 74 50 72 6F 63 65 73 73 00
    elf_w8(idata_file_off + hnt_ep_off + 2, 0x45)   // E
    elf_w8(idata_file_off + hnt_ep_off + 3, 0x78)   // x
    elf_w8(idata_file_off + hnt_ep_off + 4, 0x69)   // i
    elf_w8(idata_file_off + hnt_ep_off + 5, 0x74)   // t
    elf_w8(idata_file_off + hnt_ep_off + 6, 0x50)   // P
    elf_w8(idata_file_off + hnt_ep_off + 7, 0x72)   // r
    elf_w8(idata_file_off + hnt_ep_off + 8, 0x6F)   // o
    elf_w8(idata_file_off + hnt_ep_off + 9, 0x63)   // c
    elf_w8(idata_file_off + hnt_ep_off + 10, 0x65)  // e
    elf_w8(idata_file_off + hnt_ep_off + 11, 0x73)  // s
    elf_w8(idata_file_off + hnt_ep_off + 12, 0x73)  // s

    // DLL name: "kernel32.dll\0" (offset 104)
    elf_w8(idata_file_off + dll_name_off + 0, 0x6B)   // k
    elf_w8(idata_file_off + dll_name_off + 1, 0x65)   // e
    elf_w8(idata_file_off + dll_name_off + 2, 0x72)   // r
    elf_w8(idata_file_off + dll_name_off + 3, 0x6E)   // n
    elf_w8(idata_file_off + dll_name_off + 4, 0x65)   // e
    elf_w8(idata_file_off + dll_name_off + 5, 0x6C)   // l
    elf_w8(idata_file_off + dll_name_off + 6, 0x33)   // 3
    elf_w8(idata_file_off + dll_name_off + 7, 0x32)   // 2
    elf_w8(idata_file_off + dll_name_off + 8, 0x2E)   // .
    elf_w8(idata_file_off + dll_name_off + 9, 0x64)   // d
    elf_w8(idata_file_off + dll_name_off + 10, 0x6C)  // l
    elf_w8(idata_file_off + dll_name_off + 11, 0x6C)  // l

    let total_file_size = idata_file_off + idata_raw_size
    let ok = write_file(output, ELF, total_file_size)
    print("pe: "); print(output); print(" "); print_int(total_file_size)
    print(" bytes\n")
    return 0
}

// ─── Mach-O x86_64 writer ───
// Builds a macOS Mach-O 64-bit executable.
// Layout: __PAGEZERO(0..4GB) + __TEXT(4GB.., code) + __DATA(4GB+0x8000, BSS)
fn write_macho_x86(output: string) -> i64 with IO, Mut, Panic, Div {
    let vm_base: i64 = 4294967296       // 0x100000000
    let page_size: i64 = 4096
    let text_vm = vm_base               // __TEXT vmaddr
    let data_vm = vm_base + 0x8000      // __DATA vmaddr (BSS)

    // Mach-O header: 32 bytes
    // Load commands: __PAGEZERO(72) + __TEXT(72+section*80=152) + __DATA(72+section*80=152) + LC_MAIN(24)
    let hdr_size = 32
    let lc_pagezero_size = 72
    let lc_text_size = 72 + 80          // segment + 1 section (__text)
    let lc_data_size = 72 + 80          // segment + 1 section (__bss)
    let lc_main_size = 24
    let ncmds = 4
    let sizeofcmds = lc_pagezero_size + lc_text_size + lc_data_size + lc_main_size

    let text_file_off = ((hdr_size + sizeofcmds + page_size - 1) / page_size) * page_size
    let text_file_size = ((CL + page_size - 1) / page_size) * page_size
    let total_file_size = text_file_off + text_file_size
    let text_seg_vmsize = text_file_off + text_file_size  // covers headers + code

    print("macho_build: code="); print_int(CL); print(" text_off="); print_int(text_file_off); print("\n")

    var i: i64 = 0
    while i < 1048576 { ELF[i as usize] = 0; i = i + 1 }

    // Mach-O header (32 bytes)
    elf_w32(0, 0xFEEDFACF)               // magic (64-bit)
    elf_w32(4, 0x01000007)                // cputype = x86_64
    elf_w32(8, 0x80000003)                // cpusubtype = ALL | LIB64
    elf_w32(12, 2)                        // filetype = MH_EXECUTE
    elf_w32(16, ncmds)                    // ncmds
    elf_w32(20, sizeofcmds)              // sizeofcmds
    elf_w32(24, 0x00200085)               // flags: NOUNDEFS | DYLDLINK | TWOLEVEL | PIE

    // LC_SEGMENT_64 __PAGEZERO (72 bytes at offset 32)
    var off = hdr_size
    elf_w32(off, 25)                      // cmd = LC_SEGMENT_64
    elf_w32(off+4, lc_pagezero_size)      // cmdsize
    // segname "__PAGEZERO" at off+8 (16 bytes)
    elf_w8(off+8, 95); elf_w8(off+9, 95)  // __
    elf_w8(off+10, 80); elf_w8(off+11, 65); elf_w8(off+12, 71); elf_w8(off+13, 69)  // PAGE
    elf_w8(off+14, 90); elf_w8(off+15, 69); elf_w8(off+16, 82); elf_w8(off+17, 79)  // ZERO
    elf_w64(off+24, 0)                    // vmaddr
    elf_w64(off+32, vm_base)              // vmsize = 4GB
    elf_w64(off+40, 0)                    // fileoff
    elf_w64(off+48, 0)                    // filesize
    elf_w32(off+56, 0)                    // maxprot
    elf_w32(off+60, 0)                    // initprot
    elf_w32(off+64, 0)                    // nsects
    elf_w32(off+68, 0)                    // flags

    // LC_SEGMENT_64 __TEXT + __text section (152 bytes)
    off = hdr_size + lc_pagezero_size
    elf_w32(off, 25)                      // cmd = LC_SEGMENT_64
    elf_w32(off+4, lc_text_size)          // cmdsize
    // segname "__TEXT"
    elf_w8(off+8, 95); elf_w8(off+9, 95)
    elf_w8(off+10, 84); elf_w8(off+11, 69); elf_w8(off+12, 88); elf_w8(off+13, 84)
    elf_w64(off+24, text_vm)              // vmaddr
    elf_w64(off+32, text_seg_vmsize)      // vmsize
    elf_w64(off+40, 0)                    // fileoff
    elf_w64(off+48, total_file_size)      // filesize
    elf_w32(off+56, 7)                    // maxprot = rwx
    elf_w32(off+60, 5)                    // initprot = r-x
    elf_w32(off+64, 1)                    // nsects = 1
    elf_w32(off+68, 0)                    // flags

    // __text section header (80 bytes at off+72)
    let sec = off + 72
    // sectname "__text"
    elf_w8(sec, 95); elf_w8(sec+1, 95)
    elf_w8(sec+2, 116); elf_w8(sec+3, 101); elf_w8(sec+4, 120); elf_w8(sec+5, 116)  // text
    // segname "__TEXT"
    elf_w8(sec+16, 95); elf_w8(sec+17, 95)
    elf_w8(sec+18, 84); elf_w8(sec+19, 69); elf_w8(sec+20, 88); elf_w8(sec+21, 84)
    elf_w64(sec+32, text_vm + text_file_off)  // addr
    elf_w64(sec+40, CL)                       // size
    elf_w32(sec+48, text_file_off)            // offset
    elf_w32(sec+52, 0)                        // align (2^0 = 1)
    elf_w32(sec+56, 0)                        // reloff
    elf_w32(sec+60, 0)                        // nreloc
    elf_w32(sec+64, 0x80000400)               // flags: PURE_INSTRUCTIONS | SOME_INSTRUCTIONS

    // LC_SEGMENT_64 __DATA + __bss section (152 bytes)
    off = hdr_size + lc_pagezero_size + lc_text_size
    elf_w32(off, 25)                      // cmd = LC_SEGMENT_64
    elf_w32(off+4, lc_data_size)          // cmdsize
    // segname "__DATA"
    elf_w8(off+8, 95); elf_w8(off+9, 95)
    elf_w8(off+10, 68); elf_w8(off+11, 65); elf_w8(off+12, 84); elf_w8(off+13, 65)
    elf_w64(off+24, data_vm)              // vmaddr
    elf_w64(off+32, ((GL_BSS_SIZE + page_size - 1) / page_size) * page_size)  // vmsize
    elf_w64(off+40, 0)                    // fileoff
    elf_w64(off+48, 0)                    // filesize = 0 (BSS)
    elf_w32(off+56, 7)                    // maxprot = rwx
    elf_w32(off+60, 3)                    // initprot = rw-
    elf_w32(off+64, 1)                    // nsects = 1
    elf_w32(off+68, 0)                    // flags

    // __bss section header (80 bytes at off+72)
    let bsec = off + 72
    elf_w8(bsec, 95); elf_w8(bsec+1, 95)
    elf_w8(bsec+2, 98); elf_w8(bsec+3, 115); elf_w8(bsec+4, 115)  // bss
    elf_w8(bsec+16, 95); elf_w8(bsec+17, 95)
    elf_w8(bsec+18, 68); elf_w8(bsec+19, 65); elf_w8(bsec+20, 84); elf_w8(bsec+21, 65)
    elf_w64(bsec+32, data_vm)                 // addr
    elf_w64(bsec+40, GL_BSS_SIZE)             // size
    elf_w32(bsec+48, 0)                       // offset = 0 (BSS)
    elf_w32(bsec+64, 1)                       // flags: S_ZEROFILL

    // LC_MAIN (24 bytes)
    off = hdr_size + lc_pagezero_size + lc_text_size + lc_data_size
    elf_w32(off, 0x80000028)              // cmd = LC_MAIN
    elf_w32(off+4, lc_main_size)          // cmdsize
    elf_w64(off+8, text_file_off + TRAMP_OFF)  // entryoff (file offset of entry)
    elf_w64(off+16, 0)                    // stacksize (0 = default)

    // Copy code at text_file_off
    i = 0
    while i < CL { ELF[(text_file_off + i) as usize] = CD[i as usize]; i = i + 1 }

    let ok = write_file(output, ELF, total_file_size)
    print("macho: "); print(output); print(" "); print_int(total_file_size)
    print(" bytes\n")
    return 0
}

// ═══ ARM64 (AArch64) Backend ═══

// ─── ARM64 syscall helper ───
fn emit_syscall_a64() with Mut {
    if TARGET_OS == 2 {
        em32(0xD4001001)  // svc #0x80 (macOS)
    } else {
        em32(0xD4000001)  // svc #0 (Linux)
    }
}

// ─── ARM64 print("string") ───
fn emit_print_a64(tok: i64) with Mut, Panic, Div {
    let ss = TS[tok as usize] + 1
    let se = TE[tok as usize] - 1
    var slen: i64 = 0
    var zi: i64 = 0
    while zi < 256 { SQW[zi as usize] = 0; zi = zi + 1 }
    var si: i64 = ss
    while si < se {
        let c = sb(si)
        var byte: i64 = c
        if c == 92 && si + 1 < se {
            let c2 = sb(si + 1)
            if c2 == 110 { byte = 10 }
            else if c2 == 116 { byte = 9 }
            else if c2 == 48 { byte = 0 }
            else { byte = c2 }
            si = si + 2
        } else { si = si + 1 }
        SQW[slen as usize] = byte
        slen = slen + 1
    }
    // Emit: b skip; string_bytes (4-byte padded); skip: adr x1, -(pad_len); ...
    let pad_len = (slen + 3) / 4 * 4
    // b skip: offset = 1 + pad_len/4 instructions
    let b_off = 1 + pad_len / 4
    em32(0x14000000 | (b_off & 0x3FFFFFF))
    let str_start = CL
    // Emit string bytes
    var bi: i64 = 0
    while bi < pad_len {
        if bi < slen { em(SQW[bi as usize] & 0xFF) }
        else { em(0) }
        bi = bi + 1
    }
    // skip: adr x1, -(pad_len) — point back at string data
    let adr_off = 0 - pad_len
    let adr_immlo = adr_off & 3
    let adr_immhi = (adr_off >> 2) & 0x7FFFF
    em32(0x10000000 | ((adr_immlo & 0x3) << 29) | ((adr_immhi & 0x7FFFF) << 5) | 1)
    // mov x0, #1 (stdout fd)
    em32(0xD2800020)  // movz x0, #1
    // mov x2, #slen
    em32(0xD2800000 | ((slen & 0xFFFF) << 5) | 2)  // movz x2, #slen
    // syscall: write
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000004)  // x16 = write syscall (macOS)
    } else {
        em32(0xD2800000 | ((64 & 0xFFFF) << 5) | 8)  // movz x8, #64 (Linux write)
    }
    emit_syscall_a64()
}

fn emit_print_cstr_a64() with Mut {
    // x0 = C string pointer
    em32(0xAA0003E9)  // mov x9, x0
    em32(0xAA0003E1)  // mov x1, x0
    em32(0xD280000A)  // movz x10, #0
    let slp = CL
    em32(0x38606920 | 10)  // ldrb w0, [x9, x10]
    em32(0x34000000 | (3 << 5) | 0)  // cbz w0, done
    em32(0x9100054A)  // add x10, x10, #1
    let brel = (slp - CL) / 4
    em32(0x14000000 | (brel & 0x3FFFFFF))
    em32(0xAA0A03E2)  // mov x2, x10
    em32(0xD2800020)  // movz x0, #1
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000004)
    } else {
        em32(0xD2800000 | ((64 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
}

fn emit_print_nl_a64() with Mut {
    em32(0xD1000000 | (16 << 10) | (31 << 5) | 31)  // sub sp, sp, #16
    em32(0xD280014A)  // movz x10, #10
    em32(0x390003EA)  // strb w10, [sp]
    em32(0xD2800020)  // movz x0, #1
    em32(0x910003E1)  // mov x1, sp
    em32(0xD2800022)  // movz x2, #1
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000004)
    } else {
        em32(0xD2800000 | ((64 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    em32(0x910043FF)  // add sp, sp, #16
}

fn emit_print_char_lit_a64(ch: i64) with Mut {
    em32(0xD1000000 | (16 << 10) | (31 << 5) | 31)  // sub sp, sp, #16
    em32(0xD2800000 | ((ch & 0xFFFF) << 5) | 10)     // movz x10, #ch
    em32(0x390003EA)                                  // strb w10, [sp]
    em32(0xD2800020)                                  // movz x0, #1
    em32(0x910003E1)                                  // mov x1, sp
    em32(0xD2800022)                                  // movz x2, #1
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000004)
    } else {
        em32(0xD2800000 | ((64 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    em32(0x910043FF)  // add sp, sp, #16
}

fn emit_assert_fail_a64() with Mut {
    em32(0xD2800020)  // movz x0, #1
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000001)
    } else {
        em32(0xD2800000 | ((93 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
}

// ─── ARM64 print_int ───
fn emit_print_int_a64() with Mut {
    // x0 = value to print
    // sub sp, sp, #64 for scratch buffer
    em32(0xD1000000 | (64 << 10) | (31 << 5) | 31)  // sub sp, sp, #64
    // store '\n' at sp+63
    em32(0xD2800140 | 10)  // movz x10, #10
    em32(0x39000000 | (63 << 10) | (31 << 5) | 10)  // strb w10, [sp, #63]
    // x9 = sp + 62 (current write position)
    em32(0x91000000 | (62 << 10) | (31 << 5) | 9)   // add x9, sp, #62
    // x11 = 0 (negative flag)
    em32(0xD2800000 | 11)  // movz x11, #0
    // Check if negative: cmp x0, #0; b.ge skip_neg
    em32(0xF100001F)  // cmp x0, #0
    em32(0x5400000A | (2 << 5))  // b.ge +2 instructions (skip neg)
    // neg x0, x0
    em32(0xCB0003E0)
    // x11 = 1
    em32(0xD2800020 | 11)  // movz x11, #1
    // div loop: x10 = 10 divisor
    em32(0xD2800140 | 10)  // movz x10, #10
    let loop_top = CL
    // sdiv x12, x0, x10
    em32(0x9AC00C00 | (10 << 16) | (0 << 5) | 12)   // sdiv x12, x0, x10
    // msub x13, x12, x10, x0  (x13 = x0 - x12*x10 = remainder)
    em32(0x9B000000 | (10 << 16) | (0 << 10) | (12 << 5) | 13)  // msub x13, x12, x10, x0
    // add x13, x13, #48 ('0')
    em32(0x91000000 | (48 << 10) | (13 << 5) | 13)
    // strb w13, [x9, #0]
    em32(0x39000000 | (0 << 10) | (9 << 5) | 13)
    // x9 = x9 - 1
    em32(0xD1000000 | (1 << 10) | (9 << 5) | 9)
    // x0 = x12 (quotient)
    em32(0xAA0C03E0)  // mov x0, x12
    // cbnz x0, loop_top
    let rel = (loop_top - CL) / 4
    em32(0xB5000000 | ((rel & 0x7FFFF) << 5) | 0)
    // If negative, store '-'
    // cbz x11, skip_minus
    em32(0xB4000000 | (3 << 5) | 11)  // cbz x11, +3 instructions
    em32(0xD2800000 | (45 << 5) | 13)  // movz x13, #45 ('-')
    em32(0x39000000 | (0 << 10) | (9 << 5) | 13)  // strb w13, [x9]
    em32(0xD1000000 | (1 << 10) | (9 << 5) | 9)   // x9 = x9 - 1
    // x1 = x9 + 1 (start of string)
    em32(0x91000000 | (1 << 10) | (9 << 5) | 1)    // add x1, x9, #1
    // x2 = sp + 64 - x1 (length)
    em32(0x91000000 | (64 << 10) | (31 << 5) | 2)  // add x2, sp, #64
    em32(0xCB010042)                                  // sub x2, x2, x1
    // write(1, x1, x2)
    em32(0xD2800020)  // movz x0, #1 (fd=stdout)
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000004)
    } else {
        em32(0xD2800000 | ((64 & 0xFFFF) << 5) | 8)  // movz x8, #64 (Linux write)
    }
    emit_syscall_a64()
    // add sp, sp, #64
    em32(0x91000000 | (64 << 10) | (31 << 5) | 31)
}

fn emit_print_u64_no_nl_a64() with Mut {
    em32(0xD1000000 | (64 << 10) | (31 << 5) | 31)  // sub sp, sp, #64
    em32(0x91000000 | (63 << 10) | (31 << 5) | 9)   // add x9, sp, #63
    em32(0xD280014A)                                  // movz x10, #10
    let loop_top = CL
    em32(0x9AC00C00 | (10 << 16) | (0 << 5) | 12)   // sdiv x12, x0, x10
    em32(0x9B000000 | (10 << 16) | (0 << 10) | (12 << 5) | 13)  // msub x13, x12, x10, x0
    em32(0x91000000 | (48 << 10) | (13 << 5) | 13)  // add x13, x13, #48
    em32(0x39000000 | (0 << 10) | (9 << 5) | 13)    // strb w13, [x9]
    em32(0xD1000000 | (1 << 10) | (9 << 5) | 9)     // sub x9, x9, #1
    em32(0xAA0C03E0)                                  // mov x0, x12
    let rel = (loop_top - CL) / 4
    em32(0xB5000000 | ((rel & 0x7FFFF) << 5) | 0)    // cbnz x0, loop
    em32(0x91000000 | (1 << 10) | (9 << 5) | 1)      // add x1, x9, #1
    em32(0x91000000 | (64 << 10) | (31 << 5) | 2)    // add x2, sp, #64
    em32(0xCB010042)                                  // sub x2, x2, x1
    em32(0xD2800020)                                  // movz x0, #1
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000004)
    } else {
        em32(0xD2800000 | ((64 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    em32(0x91000000 | (64 << 10) | (31 << 5) | 31)   // add sp, sp, #64
}

fn emit_print_fixed6_a64() with Mut {
    em32(0xD1000000 | (16 << 10) | (31 << 5) | 31)  // sub sp, sp, #16
    emit_imm64_reg_a64(10, 100000)
    em32(0x9AC00C00 | (10 << 16) | (0 << 5) | 12)
    em32(0x9B000000 | (10 << 16) | (0 << 10) | (12 << 5) | 13)
    em32(0x91000000 | (48 << 10) | (12 << 5) | 12)
    em32(0x39000000 | (0 << 10) | (31 << 5) | 12)
    em32(0xAA0D03E0)
    emit_imm64_reg_a64(10, 10000)
    em32(0x9AC00C00 | (10 << 16) | (0 << 5) | 12)
    em32(0x9B000000 | (10 << 16) | (0 << 10) | (12 << 5) | 13)
    em32(0x91000000 | (48 << 10) | (12 << 5) | 12)
    em32(0x39000000 | (1 << 10) | (31 << 5) | 12)
    em32(0xAA0D03E0)
    emit_imm64_reg_a64(10, 1000)
    em32(0x9AC00C00 | (10 << 16) | (0 << 5) | 12)
    em32(0x9B000000 | (10 << 16) | (0 << 10) | (12 << 5) | 13)
    em32(0x91000000 | (48 << 10) | (12 << 5) | 12)
    em32(0x39000000 | (2 << 10) | (31 << 5) | 12)
    em32(0xAA0D03E0)
    emit_imm64_reg_a64(10, 100)
    em32(0x9AC00C00 | (10 << 16) | (0 << 5) | 12)
    em32(0x9B000000 | (10 << 16) | (0 << 10) | (12 << 5) | 13)
    em32(0x91000000 | (48 << 10) | (12 << 5) | 12)
    em32(0x39000000 | (3 << 10) | (31 << 5) | 12)
    em32(0xAA0D03E0)
    emit_imm64_reg_a64(10, 10)
    em32(0x9AC00C00 | (10 << 16) | (0 << 5) | 12)
    em32(0x9B000000 | (10 << 16) | (0 << 10) | (12 << 5) | 13)
    em32(0x91000000 | (48 << 10) | (12 << 5) | 12)
    em32(0x39000000 | (4 << 10) | (31 << 5) | 12)
    em32(0x91000000 | (48 << 10) | (13 << 5) | 13)
    em32(0x39000000 | (5 << 10) | (31 << 5) | 13)
    em32(0xD2800020)  // movz x0, #1
    em32(0x910003E1)  // mov x1, sp
    em32(0xD28000C2)  // movz x2, #6
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000004)
    } else {
        em32(0xD2800000 | ((64 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    em32(0x910043FF)  // add sp, sp, #16
}

// ─── ARM64 print_f64 ───
fn emit_print_f64_a64() with Mut, Panic {
    em32(0xD1000000 | (32 << 10) | (31 << 5) | 31)  // sub sp, sp, #32
    em32(0xAA0003EF)                                  // mov x15, x0
    emit_imm64_reg_a64(9, 9223372036854775807)
    em32(0x8A090000)                                  // and x0, x0, x9
    let zero_abs_patch = CL
    em32(0xB4000000)                                  // cbz x0, zero
    emit_imm64_reg_a64(10, 52)
    em32(0x9AC02800 | (10 << 16) | (0 << 5) | 9)     // asrv x9, x0, x10
    emit_imm64_reg_a64(10, 2047)
    em32(0xEB00001F | (10 << 16) | (9 << 5))         // cmp x9, x10
    let nan_patch = CL
    em32(0x54000000)                                  // b.eq nan
    let zero_sub_patch = CL
    em32(0xB4000000 | 9)                              // cbz x9, zero
    em32(0xF100001F | (15 << 5))                      // cmp x15, #0
    let sign_done_patch = CL
    em32(0x5400000A)                                  // b.ge sign_done
    emit_print_char_lit_a64(45)
    patch_branch_a64(sign_done_patch, CL)
    em32(0x9E670000)                                  // fmov d0, x0
    em32(0x9E78000D)                                  // fcvtzs x13, d0
    em32(0xAA0D03E0)                                  // mov x0, x13
    em32(0x9E620001)                                  // scvtf d1, x0
    em32(0x1E613800)                                  // fsub d0, d0, d1
    emit_imm64_reg_a64(10, 4696837146684686336)       // 1000000.0
    em32(0x9E670141)                                  // fmov d1, x10
    em32(0x1E610800)                                  // fmul d0, d0, d1
    emit_imm64_reg_a64(10, 4602678819172646912)       // 0.5
    em32(0x9E670141)                                  // fmov d1, x10
    em32(0x1E612800)                                  // fadd d0, d0, d1
    em32(0x9E78000E)                                  // fcvtzs x14, d0
    emit_imm64_reg_a64(10, 1000000)
    em32(0xEB00001F | (10 << 16) | (14 << 5))        // cmp x14, x10
    let frac_ok_patch = CL
    em32(0x5400000B)                                  // b.lt frac_ok
    em32(0xD280000E)                                  // movz x14, #0
    em32(0x91000000 | (1 << 10) | (13 << 5) | 13)    // add x13, x13, #1
    patch_branch_a64(frac_ok_patch, CL)
    em32(0xF90003ED)                                  // str x13, [sp, #0]
    em32(0xF90007EE)                                  // str x14, [sp, #8]
    em32(0xF94003E0)                                  // ldr x0, [sp, #0]
    emit_print_u64_no_nl_a64()
    emit_print_char_lit_a64(46)
    em32(0xF94007E0)                                  // ldr x0, [sp, #8]
    emit_print_fixed6_a64()
    let done_norm_patch = CL
    em32(0x14000000)                                  // b done
    let zero_label = CL
    em32(0xD2800000)                                  // movz x0, #0
    em32(0xF90003E0)                                  // str x0, [sp, #0]
    em32(0xF90007E0)                                  // str x0, [sp, #8]
    em32(0xF94003E0)                                  // ldr x0, [sp, #0]
    emit_print_u64_no_nl_a64()
    emit_print_char_lit_a64(46)
    em32(0xF94007E0)                                  // ldr x0, [sp, #8]
    emit_print_fixed6_a64()
    let done_zero_patch = CL
    em32(0x14000000)                                  // b done
    let nan_label = CL
    emit_print_char_lit_a64(110)
    emit_print_char_lit_a64(97)
    emit_print_char_lit_a64(110)
    let done_label = CL
    em32(0x91000000 | (32 << 10) | (31 << 5) | 31)   // add sp, sp, #32
    patch_branch_a64(zero_abs_patch, zero_label)
    patch_branch_a64(zero_sub_patch, zero_label)
    patch_branch_a64(nan_patch, nan_label)
    patch_branch_a64(done_norm_patch, done_label)
    patch_branch_a64(done_zero_patch, done_label)
}

fn emit_read_i64_a64() with Mut {
    emit_pop_x1_a64()
    em32(0xF8607820)  // ldr x0, [x1, x0, lsl #3]
}

fn emit_read_f64_a64() with Mut {
    emit_pop_x1_a64()
    em32(0xF8607820)  // ldr x0, [x1, x0, lsl #3]
}

// ─── ARM64 read_file ───
fn emit_read_file_a64() with Mut, Panic {
    // x0 = path (C string pointer)
    emit_push_a64()
    if TARGET_OS == 2 {
        // macOS: open(path, O_RDONLY=0)
        em32(0xD2800001)  // movz x1, #0
        emit_imm64_reg_a64(16, 0x2000005)  // x16 = SYS_open
    } else {
        // Linux: openat(AT_FDCWD=-100, path, O_RDONLY=0)
        em32(0xAA0003E1)  // mov x1, x0
        emit_imm64_reg_a64(0, -100)  // x0 = AT_FDCWD
        em32(0xD2800002)  // movz x2, #0
        em32(0xD2800000 | ((56 & 0xFFFF) << 5) | 8)  // movz x8, #56
    }
    emit_syscall_a64()
    // x0 = fd. Push it.
    emit_push_a64()
    // mmap(NULL, 4MB+1, 3, 0x22, -1, 0)
    em32(0xD2800000)  // x0 = NULL
    emit_imm64_reg_a64(1, 0x400001)  // x1 = 4MB+1
    em32(0xD2800060 | 2)  // x2 = 3
    em32(0xD2800000 | ((0x22 & 0xFFFF) << 5) | 3)  // x3 = 0x22
    emit_imm64_reg_a64(4, -1)  // x4 = -1
    em32(0xD2800005)  // x5 = 0
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x20000C5)
    } else {
        em32(0xD2800000 | ((222 & 0xFFFF) << 5) | 8)  // x8 = 222 (mmap)
    }
    emit_syscall_a64()
    // x0 = buf. Push it.
    emit_push_a64()
    // read(fd, buf, 4MB): x0=fd, x1=buf, x2=len
    em32(0xAA0003E1)  // mov x1, x0 (buf)
    em32(0xF9400000 | ((16/8) << 10) | (31 << 5) | 0)  // ldr x0, [sp, #16] (fd)
    emit_imm64_reg_a64(2, 0x400000)  // x2 = 4MB
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000003)
    } else {
        em32(0xD2800000 | ((63 & 0xFFFF) << 5) | 8)  // x8 = 63 (read)
    }
    emit_syscall_a64()
    em32(0xAA0003E2)  // mov x2, x0 (bytes read)
    em32(0xF100005F)  // cmp x2, #0
    let read_ok_patch = CL
    em32(0x5400000A)  // b.ge read_ok
    em32(0xD2800002)  // movz x2, #0
    let read_ok_target = CL
    patch_branch_a64(read_ok_patch, read_ok_target)
    em32(0xF9400000 | ((0/8) << 10) | (31 << 5) | 1)  // ldr x1, [sp, #0] (buf)
    em32(0x8B020021)  // add x1, x1, x2
    em32(0x3900003F)  // strb wzr, [x1]
    // close(fd)
    em32(0xF9400000 | ((16/8) << 10) | (31 << 5) | 0)  // ldr x0, [sp, #16]
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000006)
    } else {
        em32(0xD2800000 | ((57 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    // Return buf
    em32(0xF8410FE0)  // ldr x0, [sp], #16 (pop buf)
    em32(0x91000000 | (16 << 10) | (31 << 5) | 31)  // add sp, sp, #16 (discard fd)
}

// ─── ARM64 write_file ───
fn emit_write_file_a64_flags(linux_flags: i64, macos_flags: i64) with Mut, Panic {
    // On entry: stack=[buf, path] (path pushed first, buf second), x0=len
    em32(0xAA0003E4)  // mov x4, x0 (save len)
    em32(0xF9400000 | ((16/8) << 10) | (31 << 5) | 5)  // ldr x5, [sp, #16] (path)
    em32(0xF9400000 | ((0/8) << 10) | (31 << 5) | 6)   // ldr x6, [sp, #0] (buf)
    em32(0x91000000 | (32 << 10) | (31 << 5) | 31)      // add sp, sp, #32
    // open(path, O_WRONLY|O_CREAT|O_TRUNC, 0644)
    em32(0xAA0503E0)  // mov x0, x5 (path)
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(1, macos_flags)
        em32(0xD2800000 | ((0x1A4 & 0xFFFF) << 5) | 2)
        emit_imm64_reg_a64(16, 0x2000005)
    } else {
        em32(0xAA0003E1)  // mov x1, x0
        emit_imm64_reg_a64(0, -100)
        emit_imm64_reg_a64(2, linux_flags)
        em32(0xD2800000 | ((0x1A4 & 0xFFFF) << 5) | 3)
        em32(0xD2800000 | ((56 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    em32(0xF100001F)  // cmp x0, #0
    let open_ok_patch = CL
    em32(0x5400000A)  // b.ge open_ok
    let open_fail_done = CL
    em32(0x14000000)  // b done
    let open_ok_target = CL
    em32(0xAA0003E7)  // mov x7, x0 (save fd)
    // write(fd, buf, len)
    em32(0xAA0703E0)  // mov x0, x7
    em32(0xAA0603E1)  // mov x1, x6
    em32(0xAA0403E2)  // mov x2, x4
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000004)
    } else {
        em32(0xD2800000 | ((64 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    em32(0xAA0003EA)  // mov x10, x0 (write result)
    // close(fd)
    em32(0xAA0703E0)  // mov x0, x7
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000006)
    } else {
        em32(0xD2800000 | ((57 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    em32(0xAA0A03E0)  // mov x0, x10
    let done_target = CL
    patch_branch_a64(open_ok_patch, open_ok_target)
    patch_branch_a64(open_fail_done, done_target)
}

fn emit_write_file_a64() with Mut, Panic {
    emit_write_file_a64_flags(0x241, 0x601)
}

fn emit_append_file_a64() with Mut, Panic {
    emit_write_file_a64_flags(0x441, 0x209)
}

// ─── ARM64 file_size ───
fn emit_file_size_a64() with Mut {
    // x0 = path
    if TARGET_OS == 2 {
        em32(0xD2800001)
        emit_imm64_reg_a64(16, 0x2000005)
    } else {
        em32(0xAA0003E1)
        emit_imm64_reg_a64(0, -100)
        em32(0xD2800002)
        em32(0xD2800000 | ((56 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    emit_push_a64()  // save fd
    em32(0xD1000000 | (160 << 10) | (31 << 5) | 31)  // sub sp, sp, #160
    em32(0x910003E1)  // mov x1, sp
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000153)
    } else {
        em32(0xD2800000 | ((80 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    em32(0xF9400000 | ((48/8) << 10) | (31 << 5) | 9)  // ldr x9, [sp, #48]
    em32(0x91000000 | (160 << 10) | (31 << 5) | 31)     // add sp, sp, #160
    em32(0xF8410FE0)  // pop fd
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000006)
    } else {
        em32(0xD2800000 | ((57 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    em32(0xAA0903E0)  // mov x0, x9
}

// ─── ARM64 arg_count ───
fn emit_arg_count_a64() with Mut {
    let argc_addr = GL_BSS_BASE - 16
    emit_imm64_a64(argc_addr)
    em32(0xF9400000)  // ldr x0, [x0]
}

// ─── ARM64 get_arg ───
fn emit_get_arg_a64() with Mut {
    let argv_addr = GL_BSS_BASE - 8
    em32(0xAA0003E9)  // mov x9, x0
    emit_imm64_a64(argv_addr)
    em32(0xF9400000)  // ldr x0, [x0]
    em32(0xF8697800)  // ldr x0, [x0, x9, lsl #3]
}

// ─── ARM64 str_len ───
fn emit_str_len_a64() with Mut {
    em32(0xAA0003E9)  // mov x9, x0
    em32(0xD2800000)  // movz x0, #0
    let top = CL
    em32(0x38606920 | 10)  // ldrb w10, [x9, x0]
    em32(0x34000000 | (3 << 5) | 10)  // cbz w10, +3
    em32(0x91000400)  // add x0, x0, #1
    let brel = (top - CL) / 4
    em32(0x14000000 | (brel & 0x3FFFFFF))
}

// ─── ARM64 f64 binary op helper ───
fn emit_f64_binop_a64(opcode: i64) with Mut {
    em32(0x9E670020)  // fmov d0, x1 (LHS)
    em32(0x9E670001)  // fmov d1, x0 (RHS)
    em32(opcode)       // f64 op d0, d0, d1
    em32(0x9E660000)  // fmov x0, d0
}

fn compile_measure_call_a64(call_tok: i64) with IO, Mut, Panic, Div {
    EP = EP + 1
    var value_ty: i64 = 0
    var value_hash: i64 = 0
    var value_tok: i64 = -1
    var unc_ty: i64 = 0
    var unc_tok: i64 = -1
    var conf_ty: i64 = 0
    var value_slot: i64 = -1
    var unc_slot: i64 = -1
    var conf_slot: i64 = -1
    var argc: i64 = 0
    var saw_unc: i64 = 0
    var saw_conf: i64 = 0
    if TK[EP as usize] != 7 && TK[EP as usize] != 0 {
        let arg_start = EP
        compile_or_a64()
        value_ty = EXPR_TY
        value_hash = EXPR_TY_HASH
        value_tok = expr_simple_numeric_tok(arg_start, EP)
        value_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        emit_store_var_a64(value_slot)
        argc = 1
    }
    while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
        if TK[EP as usize] == 28 { EP = EP + 1 }
        if TK[EP as usize] == 7 || TK[EP as usize] == 0 { break }
        var label_kind: i64 = 0
        if TK[EP as usize] == 3 && TK[(EP + 1) as usize] == 43 {
            let lns = TS[EP as usize]
            let lne = TE[EP as usize]
            if src_match(lns, lne - lns, "uncertainty") { label_kind = 1 }
            else if src_match(lns, lne - lns, "confidence") { label_kind = 2 }
            else { tc_error(call_tok, "unknown measure metadata label") }
            EP = EP + 2
        }
        let arg_start = EP
        compile_or_a64()
        let arg_ty = EXPR_TY
        let lit_tok = expr_simple_numeric_tok(arg_start, EP)
        let tmp_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        emit_store_var_a64(tmp_slot)
        argc = argc + 1
        if label_kind == 2 || (label_kind == 0 && saw_unc != 0 && saw_conf == 0) {
            if saw_conf != 0 { tc_error(call_tok, "duplicate measure confidence") }
            conf_slot = tmp_slot
            conf_ty = arg_ty
            saw_conf = 1
        } else {
            if saw_unc != 0 { tc_error(call_tok, "duplicate measure uncertainty") }
            unc_slot = tmp_slot
            unc_ty = arg_ty
            unc_tok = lit_tok
            saw_unc = 1
        }
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }
    if argc <= 0 { tc_wrong_arity(call_tok, 2, 0) }
    let eps_scaled = infer_measure_eps_scaled(value_tok, unc_tok)
    let base_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 3
    if value_slot >= 0 { emit_load_var_a64(value_slot) } else { em32(0xD2800000) }
    emit_store_var_a64(base_slot + 2)
    if unc_slot >= 0 {
        emit_load_var_a64(unc_slot)
        if unc_ty != 2 {
            if ty_is_numeric(unc_ty) {
                em32(0x9E620000)
                em32(0x9E660000)
            } else {
                tc_error(call_tok, "measure uncertainty must be numeric")
                em32(0xD2800000)
            }
        }
        em32(0xAA0003E1)
        emit_f64_binop_a64(0x1E610800)
    } else {
        em32(0xD2800000)
    }
    emit_store_var_a64(base_slot + 1)
    if conf_slot >= 0 {
        emit_load_var_a64(conf_slot)
        if conf_ty != 2 {
            if ty_is_numeric(conf_ty) {
                em32(0x9E620000)
                em32(0x9E660000)
            } else {
                tc_error(call_tok, "measure confidence must be numeric")
                emit_imm64_a64(4607182418800017408)
            }
        }
    } else {
        emit_imm64_a64(4607182418800017408)
    }
    emit_store_var_a64(base_slot)
    emit_lea_var_a64(base_slot + 2)
    EXPR_IS_F64 = 0
    EXPR_TY = 0
    EXPR_TY_HASH = knowledge_hash_make(value_ty, value_hash, eps_scaled)
}

fn emit_heap_alloc_a64() with Mut {
    // x0 = requested size. Allocate size+8 via mmap, write header, return user ptr.
    em32(0x91002000)               // add x0, x0, #8 (total = size + header)
    em32(0xAA0003E9)               // mov x9, x0 (save total size in x9)
    em32(0xAA0003E1)               // mov x1, x0 (mmap size arg)
    em32(0xD2800000)               // movz x0, #0 (addr = NULL)
    em32(0xD2800062)               // movz x2, #3 (PROT_READ|PROT_WRITE)
    em32(0xD2800443)               // movz x3, #0x22 (MAP_PRIVATE|MAP_ANON)
    em32(0x92800004)               // movn x4, #0 (fd = -1)
    em32(0xD2800005)               // movz x5, #0 (offset)
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x20000C5)
    } else {
        em32(0xD2800000 | ((222 & 0xFFFF) << 5) | 8) // movz x8, #222 (SYS_mmap Linux)
    }
    emit_syscall_a64()             // x0 = mmap base
    em32(0xF9000009)               // str x9, [x0] (write header)
    em32(0x91002000)               // add x0, x0, #8 (return user ptr)
}

fn emit_heap_free_a64() with Mut {
    // x0 = user pointer. Read header at [ptr-8], munmap(base, total).
    em32(0xD1002000)               // sub x0, x0, #8 (back to mmap base)
    em32(0xF9400001)               // ldr x1, [x0] (total size)
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000049)
    } else {
        em32(0xD2800000 | ((215 & 0xFFFF) << 5) | 8) // movz x8, #215 (SYS_munmap Linux)
    }
    emit_syscall_a64()
}

fn emit_heap_realloc_a64() with Mut {
    // x10 = old_user_ptr (saved by caller), x0 = new_size.
    // Linux mremap(old_base, old_total, new_total, MREMAP_MAYMOVE)
    em32(0x91002000)               // add x0, x0, #8 (new_total)
    em32(0xAA0003E9)               // mov x9, x0 (save new_total in x9)
    em32(0xD100200A)               // sub x10, x0, ... wait — x10 has old_user_ptr from caller
    // Caller has: push old_ptr, then compile new_size → x0. We pop old_ptr.
    // Actually for ARM64, caller saves old_ptr in x10 before calling this.
    // x10 = old_user_ptr, x0 = new_size (already added 8 above)
    em32(0xD100214A)               // sub x10, x10, #8 (old mmap base)
    em32(0xF940014B)               // ldr x11, [x10] (old_total)
    em32(0xAA0A03E0)               // mov x0, x10 (old base → arg1)
    em32(0xAA0B03E1)               // mov x1, x11 (old_total → arg2)
    em32(0xAA0903E2)               // mov x2, x9 (new_total → arg3)
    em32(0xD2800023)               // movz x3, #1 (MREMAP_MAYMOVE)
    em32(0xD2800000 | ((216 & 0xFFFF) << 5) | 8) // movz x8, #216 (SYS_mremap Linux)
    emit_syscall_a64()             // x0 = new mmap base
    em32(0xF9000009)               // str x9, [x0] (write new header)
    em32(0x91002000)               // add x0, x0, #8 (return user ptr)
}

fn compile_acknowledge_call_a64(call_tok: i64) with IO, Mut, Panic, Div {
    // acknowledge(k: Knowledge<T>, reason: String) -> T  (ARM64)
    // Does NOT require `with Epistemic` — explicit uncertainty acknowledgment
    EP = EP + 1  // skip (
    if TK[EP as usize] == 7 || TK[EP as usize] == 0 {
        tc_arity_error(call_tok, "arity mismatch: acknowledge() requires 2 arguments")
        if TK[EP as usize] == 7 { EP = EP + 1 }
        EXPR_TY = 0
        EXPR_TY_HASH = 0
        EXPR_IS_F64 = 0
        return
    }
    // Compile first arg: the Knowledge<T> value
    compile_or_a64()
    let ack_k_ty_a = EXPR_TY
    let ack_k_hash_a = EXPR_TY_HASH
    // Expect comma + reason arg
    if TK[EP as usize] == 28 {
        EP = EP + 1
    } else {
        tc_arity_error(call_tok, "arity mismatch: acknowledge() requires 2 arguments")
    }
    // Skip reason arg (not compiled — documentation only)
    if TK[EP as usize] != 7 && TK[EP as usize] != 0 {
        EP = skip_call_arg_expr(EP)
    }
    // Check for extra args
    if TK[EP as usize] == 28 {
        tc_error(call_tok, "acknowledge() takes exactly 2 arguments")
        while TK[EP as usize] != 7 && TK[EP as usize] != 0 { EP = EP + 1 }
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }
    // Extract .value at offset 0: ldr x0, [x0]
    em32(0xF9400000)
    // Set result type to inner type
    if knowledge_hash_is(ack_k_hash_a) {
        let ack_inner_hash_a = knowledge_hash_inner_hash(ack_k_hash_a)
        EXPR_TY = knowledge_hash_inner_ty(ack_k_hash_a)
        EXPR_TY_HASH = ack_inner_hash_a
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
    } else if ack_k_ty_a == 6 {
        let ack_si_a = st_find(ack_k_hash_a)
        if ack_si_a >= 0 {
            EXPR_TY = ST_FTY[(ack_si_a * 128) as usize]
            EXPR_TY_HASH = ST_FHASH[(ack_si_a * 128) as usize]
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
        }
    }
}

fn compile_require_confidence_call_a64(call_tok: i64) with IO, Mut, Panic, Div {
    // require_confidence(k: Knowledge<T>, min: f64) -> T  (ARM64)
    // Extracts .value if confidence >= min, panics (exit 1) otherwise
    EP = EP + 1  // skip (
    if TK[EP as usize] == 7 || TK[EP as usize] == 0 {
        tc_arity_error(call_tok, "arity mismatch: require_confidence() requires 2 arguments")
        if TK[EP as usize] == 7 { EP = EP + 1 }
        EXPR_TY = 0
        EXPR_TY_HASH = 0
        EXPR_IS_F64 = 0
        return
    }
    // Compile first arg: Knowledge<T> value → x0 = struct ptr
    compile_or_a64()
    let rc_k_ty_a = EXPR_TY
    let rc_k_hash_a = EXPR_TY_HASH
    let rc_k_slot_a = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var_a64(rc_k_slot_a)
    // Expect comma + threshold
    if TK[EP as usize] == 28 {
        EP = EP + 1
    } else {
        tc_arity_error(call_tok, "arity mismatch: require_confidence() requires 2 arguments")
    }
    // Compile second arg: threshold f64
    compile_or_a64()
    let rc_min_slot_a = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var_a64(rc_min_slot_a)
    // Check for extra args
    if TK[EP as usize] == 28 {
        tc_error(call_tok, "require_confidence() takes exactly 2 arguments")
        while TK[EP as usize] != 7 && TK[EP as usize] != 0 { EP = EP + 1 }
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }
    // Load confidence field: [k_ptr + 16]
    emit_load_var_a64(rc_k_slot_a)
    em32(0xF9400800)   // ldr x0, [x0, #16] — confidence f64 bits
    em32(0xAA0003EA)   // mov x10, x0 (save confidence)
    emit_load_var_a64(rc_min_slot_a)  // x0 = threshold f64 bits
    // Compare: fcmp d0 (confidence), d1 (threshold)
    em32(0x9E670140)   // fmov d0, x10 (confidence)
    em32(0x9E670001)   // fmov d1, x0  (threshold)
    em32(0x1E612000)   // fcmp d0, d1
    // b.ge ok (skip panic if confidence >= threshold)
    em32(0x5400000A)   // b.ge placeholder
    let rc_ok_patch_a = CL - 4
    emit_assert_fail_a64()  // exit(1) — does not return
    patch_branch_a64(rc_ok_patch_a, CL)
    // Extract .value at offset 0
    emit_load_var_a64(rc_k_slot_a)
    em32(0xF9400000)   // ldr x0, [x0] — .value
    // Set result type to inner type
    if knowledge_hash_is(rc_k_hash_a) {
        let rc_inner_hash_a = knowledge_hash_inner_hash(rc_k_hash_a)
        EXPR_TY = knowledge_hash_inner_ty(rc_k_hash_a)
        EXPR_TY_HASH = rc_inner_hash_a
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
    } else if rc_k_ty_a == 6 {
        let rc_si_a = st_find(rc_k_hash_a)
        if rc_si_a >= 0 {
            EXPR_TY = ST_FTY[(rc_si_a * 128) as usize]
            EXPR_TY_HASH = ST_FHASH[(rc_si_a * 128) as usize]
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
        }
    }
}

fn compile_knowledge_literal_a64() with IO, Mut, Panic, Div {
    EP = EP + 1
    let base_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 3
    var value_ty: i64 = 0
    var value_hash: i64 = 0
    var saw_value: i64 = 0
    var saw_var: i64 = 0
    var saw_conf: i64 = 0
    var lit_mode: i64 = 0
    var lit_eps: i64 = -1
    while TK[EP as usize] != 9 && TK[EP as usize] != 0 {
        if TK[EP as usize] == 3 {
            let field_tok = EP
            let fns = TS[EP as usize]
            let fne = TE[EP as usize]
            EP = EP + 1
            if TK[EP as usize] == 43 { EP = EP + 1 }
            let field_start = EP
            compile_or_a64()
            let field_ty = EXPR_TY
            let field_hash = EXPR_TY_HASH
            let lit_tok = expr_simple_numeric_tok(field_start, EP)
            if src_match(fns, fne - fns, "value") {
                emit_store_var_a64(base_slot + 2)
                value_ty = field_ty
                value_hash = field_hash
                saw_value = 1
            } else if src_match(fns, fne - fns, "variance") {
                if field_ty != 2 {
                    if ty_is_numeric(field_ty) {
                        em32(0x9E620000)
                        em32(0x9E660000)
                    } else {
                        tc_error(field_tok, "Knowledge variance must be numeric")
                        em32(0xD2800000)
                    }
                }
                emit_store_var_a64(base_slot + 1)
                saw_var = 1
            } else if src_match(fns, fne - fns, "uncertainty") {
                if field_ty != 2 {
                    if ty_is_numeric(field_ty) {
                        em32(0x9E620000)
                        em32(0x9E660000)
                    } else {
                        tc_error(field_tok, "Knowledge uncertainty must be numeric")
                        em32(0xD2800000)
                    }
                }
                em32(0xAA0003E1)
                emit_f64_binop_a64(0x1E610800)
                emit_store_var_a64(base_slot + 1)
                saw_var = 1
            } else if src_match(fns, fne - fns, "confidence") || src_match(fns, fne - fns, "epsilon") {
                if field_ty != 2 {
                    if ty_is_numeric(field_ty) {
                        em32(0x9E620000)
                        em32(0x9E660000)
                    } else {
                        tc_error(field_tok, "Knowledge epsilon must be numeric")
                        em32(0xD2800000)
                    }
                }
                emit_store_var_a64(base_slot)
                saw_conf = 1
                if lit_tok >= 0 {
                    let scaled = tok_scaled_million(lit_tok)
                    if scaled >= 0 && scaled <= 1000000 {
                        lit_mode = 1
                        lit_eps = scaled
                    }
                }
            } else if src_match(fns, fne - fns, "validity") || src_match(fns, fne - fns, "provenance") {
            } else {
                tc_error(field_tok, "unknown field in Knowledge literal")
            }
        }
        if TK[EP as usize] == 28 { EP = EP + 1 }
    }
    if TK[EP as usize] == 9 { EP = EP + 1 }
    if saw_value == 0 {
        em32(0xD2800000)
        emit_store_var_a64(base_slot + 2)
        value_ty = 0
        value_hash = 0
    }
    if saw_var == 0 {
        em32(0xD2800000)
        emit_store_var_a64(base_slot + 1)
    }
    if saw_conf == 0 {
        emit_imm64_a64(4607182418800017408)
        emit_store_var_a64(base_slot)
    }
    emit_lea_var_a64(base_slot + 2)
    EXPR_IS_F64 = 0
    EXPR_TY = 0
    EXPR_TY_HASH = knowledge_hash_make_mode(value_ty, value_hash, lit_mode, lit_eps)
    LAST_EXPR_IS_LINEAR = 0
}

// ─── ARM64 expression compiler ───
fn compile_primary_a64() with IO, Mut, Panic, Div {
    LAST_EXPR_IS_CLOSURE = 0
    LAST_EXPR_IS_LINEAR = 0
    let k = TK[EP as usize]
    // Integer literal
    if k == 4 {
        let v = TV[EP as usize]
        if v == 0 { em32(0xD2800000) }
        else { emit_imm64_a64(v) }
        EP = EP + 1
        EXPR_IS_F64 = 0
        EXPR_TY = 1
        EXPR_TY_HASH = 0
        return
    }
    // true/false
    if k == 35 { em32(0xD2800020); EP = EP + 1; EXPR_IS_F64 = 0; EXPR_TY = 4; EXPR_TY_HASH = 0; return }
    if k == 36 { em32(0xD2800000); EP = EP + 1; EXPR_IS_F64 = 0; EXPR_TY = 4; EXPR_TY_HASH = 0; return }
    // Float literal
    if k == 53 {
        let fl_int = TV[EP as usize]
        let fl_frac = TF[EP as usize]
        let fl_denom = TD[EP as usize]
        if TX[EP as usize] >= 0 { FL_SCI_SCRATCH = TX[EP as usize]; FL_SCI_NEG = 0 }
        else { FL_SCI_SCRATCH = 0 - TX[EP as usize]; FL_SCI_NEG = 1 }
        EP = EP + 1
        emit_imm64_a64(fl_int)
        em32(0x9E620000)  // scvtf d0, x0
        if fl_frac > 0 {
            emit_imm64_a64(fl_frac)
            em32(0x9E620001)  // scvtf d1, x0
            emit_imm64_a64(fl_denom)
            em32(0x9E620002)  // scvtf d2, x0
            em32(0x1E601800 | (2 << 16) | (1 << 5) | 1)  // fdiv d1, d1, d2
            em32(0x1E612800)  // fadd d0, d0, d1
        }
        // Apply scientific exponent: mul/div d0 by 10.0 FL_SCI_SCRATCH times
        if FL_SCI_SCRATCH != 0 {
            emit_imm64_a64(0x4024000000000000)  // x0 = bits of 10.0
            em32(0x9E670001)  // fmov d1, x0
            if FL_SCI_NEG == 0 {
                while FL_SCI_SCRATCH > 0 {
                    em32(0x1E610800)  // fmul d0, d0, d1
                    FL_SCI_SCRATCH = FL_SCI_SCRATCH - 1
                }
            } else {
                while FL_SCI_SCRATCH > 0 {
                    em32(0x1E611800)  // fdiv d0, d0, d1
                    FL_SCI_SCRATCH = FL_SCI_SCRATCH - 1
                }
            }
        }
        em32(0x9E660000)  // fmov x0, d0
        EXPR_IS_F64 = 1
        EXPR_TY = 2
        EXPR_TY_HASH = 0
        return
    }
    if k == 48 {
        let match_tok = EP
        compile_stmt_a64()
        if LAST_STMT_HAS_VALUE == 0 { tc_error(match_tok, "match expression must yield a value") }
        EXPR_TY = LAST_STMT_TY
        EXPR_TY_HASH = LAST_STMT_TY_HASH
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 }
        else { EXPR_IS_F64 = 0 }
        return
    }
    if k == 13 {
        let if_tok = EP
        compile_stmt_a64()
        if LAST_STMT_HAS_VALUE == 0 { tc_error(if_tok, "if expression must yield a value") }
        EXPR_TY = LAST_STMT_TY
        EXPR_TY_HASH = LAST_STMT_TY_HASH
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 }
        else { EXPR_IS_F64 = 0 }
        return
    }
    if k == 41 {
        if array_init_is_repeat(EP) {
            EP = EP + 1
            compile_or_a64()
            let elem_ty = EXPR_TY
            if TK[EP as usize] == 27 { EP = EP + 1 }
            let rep_count = TV[EP as usize]
            EP = EP + 1
            if TK[EP as usize] == 42 { EP = EP + 1 }
            let arr_hash = arr_ty_hash(rep_count, 8, elem_ty)
            let nslots = arr_storage_slots(arr_hash)
            if nslots > 0 {
                let base = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + nslots
                em32(0xAA0003ED)  // mov x13, x0
                emit_lea_var_a64(base + nslots - 1)
                em32(0xAA0003EB)  // mov x11, x0
                emit_fill_words_x13_x11_a64(nslots)
                emit_lea_var_a64(base + nslots - 1)
            } else {
                em32(0xD2800000)
            }
            EXPR_IS_F64 = 0
            EXPR_TY = 8
            EXPR_TY_HASH = arr_hash
            LAST_ALEN = rep_count
            return
        }
        let arr_count = array_lit_count(EP)
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + arr_count
        EP = EP + 1
        var idx: i64 = 0
        var elem_ty: i64 = 0
        var elem_hash: i64 = 0
        while TK[EP as usize] != 42 && TK[EP as usize] != 0 {
            compile_or_a64()
            if idx == 0 {
                elem_ty = EXPR_TY
                elem_hash = EXPR_TY_HASH
            } else {
                if ty_eq(elem_ty, elem_hash, EXPR_TY, EXPR_TY_HASH) == false {
                    tc_error(EP - 1, "array literal elements must have the same type")
                }
            }
            emit_store_var_a64(base + arr_count - 1 - idx)
            idx = idx + 1
            if TK[EP as usize] == 28 { EP = EP + 1 }
        }
        if TK[EP as usize] == 42 { EP = EP + 1 }
        emit_lea_var_a64(base + arr_count - 1)
        EXPR_IS_F64 = 0
        EXPR_TY = 8
        EXPR_TY_HASH = arr_ty_hash(arr_count, 8, elem_ty)
        LAST_ALEN = arr_count
        return
    }
    // Closure stub
    if k == 45 || k == 31 {
        EP = EP + 1
        if k == 45 {
            while TK[EP as usize] != 45 && TK[EP as usize] != 0 {
                if TK[EP as usize] == 3 {
                    EP = EP + 1
                    if TK[EP as usize] == 43 {
                        EP = EP + 1
                        scan_type(EP)
                        EP = SCAN_TY_NEXT
                    }
                } else {
                    EP = EP + 1
                }
                if TK[EP as usize] == 28 { EP = EP + 1 }
            }
            if TK[EP as usize] == 45 { EP = EP + 1 }
        }
        if TK[EP as usize] == 10 {
            EP = EP + 1
            scan_type(EP)
            EP = SCAN_TY_NEXT
        }
        if TK[EP as usize] == 38 {
            EP = EP + 1
            while TK[EP as usize] == 3 || TK[EP as usize] == 28 { EP = EP + 1 }
        }
        if TK[EP as usize] == 8 {
            EP = EP + 1
            var cd: i64 = 1
            while EP < TC && cd > 0 { if TK[EP as usize] == 8 { cd = cd + 1 }; if TK[EP as usize] == 9 { cd = cd - 1 }; EP = EP + 1 }
        } else { EP = EP + 1 }
        em32(0xD2800000)
        EXPR_IS_F64 = 0
        LAST_EXPR_IS_CLOSURE = 1
        return
    }
    // None
    if k == 58 {
        EP = EP + 1
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 2
        em32(0xD2800000)
        emit_store_var_a64(base)
        emit_store_var_a64(base + 1)
        emit_lea_var_a64(base + 1)
        EXPR_IS_F64 = 0
        return
    }
    // Some(expr)
    if k == 57 {
        EP = EP + 1
        if TK[EP as usize] == 6 { EP = EP + 1 }
        compile_or_a64()
        if TK[EP as usize] == 7 { EP = EP + 1 }
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 2
        emit_store_var_a64(base)
        emit_imm64_a64(1)
        emit_store_var_a64(base + 1)
        emit_lea_var_a64(base + 1)
        EXPR_IS_F64 = 0
        return
    }
    // Ok(expr)
    if k == 59 {
        EP = EP + 1
        if TK[EP as usize] == 6 { EP = EP + 1 }
        compile_or_a64()
        if TK[EP as usize] == 7 { EP = EP + 1 }
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 2
        emit_store_var_a64(base)
        em32(0xD2800000)
        emit_store_var_a64(base + 1)
        emit_lea_var_a64(base + 1)
        EXPR_IS_F64 = 0
        return
    }
    // Err(expr)
    if k == 60 {
        EP = EP + 1
        if TK[EP as usize] == 6 { EP = EP + 1 }
        compile_or_a64()
        if TK[EP as usize] == 7 { EP = EP + 1 }
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 2
        emit_store_var_a64(base)
        emit_imm64_a64(1)
        emit_store_var_a64(base + 1)
        emit_lea_var_a64(base + 1)
        EXPR_IS_F64 = 0
        return
    }
    // Parenthesized
    if k == 6 { EP = EP + 1; compile_or_a64(); if TK[EP as usize] == 7 { EP = EP + 1 }; return }
    // Address-of
    if k == 44 {
        EP = EP + 1
        var want_mut: i64 = 0
        if TK[EP as usize] == 32 {
            want_mut = 1
            EP = EP + 1
        }
        let borrow_tok = EP - 1
        let rns = TS[EP as usize]
        let rne = TE[EP as usize]
        EP = EP + 1
        if TK[EP as usize] == 41 {
            EP = EP + 1
            let start_slot = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            compile_or_a64()
            emit_store_var_a64(start_slot)
            if TK[EP as usize] == 64 { tc_error(borrow_tok, "slice borrows require half-open ranges") }
            if TK[EP as usize] == 63 || TK[EP as usize] == 64 {
                EP = EP + 1
            } else {
                tc_error(borrow_tok, "slice borrow requires a..b range")
            }
            let end_slot = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            compile_or_a64()
            emit_store_var_a64(end_slot)
            if TK[EP as usize] == 42 { EP = EP + 1 }
            else { tc_error(borrow_tok, "slice borrow missing closing ]") }
            let lvi = var_find_idx(rns, rne)
            var base_ptr_slot: i64 = 0
            var base_len_slot: i64 = 0
            var base_len_const: i64 = 0
            var has_const_len: i64 = 0
            var elem_ty: i64 = 1
            var esiz: i64 = 8
            var ok_base: i64 = 0
            var allow_mut: i64 = 0
            if lvi >= 0 {
                let lty = VAR_TY[lvi as usize]
                let lhash = VAR_TY_HASH[lvi as usize]
                base_ptr_slot = VAR_SLOT[lvi as usize]
                if type_is_slice_ref(lty, lhash) {
                    let inner_hash = ref_hash_inner_hash(lhash)
                    base_len_slot = VAR_LEN_SLOT[lvi as usize]
                    esiz = arr_hash_esiz(inner_hash)
                    if arr_hash_elem_ty(inner_hash) != 0 { elem_ty = arr_hash_elem_ty(inner_hash) }
                    ok_base = 1
                    if want_mut == 0 || ref_hash_mut(lhash) != 0 { allow_mut = 1 }
                } else if lty == 8 {
                    base_len_const = VAR_ALEN[lvi as usize]
                    has_const_len = 1
                    esiz = VAR_ESIZ[lvi as usize]
                    if arr_hash_elem_ty(lhash) != 0 { elem_ty = arr_hash_elem_ty(lhash) }
                    ok_base = 1
                    if want_mut == 0 || VAR_MUT[lvi as usize] != 0 { allow_mut = 1 }
                } else if type_is_array_ref(lty, lhash) {
                    let inner_hash = ref_hash_inner_hash(lhash)
                    base_len_const = arr_hash_alen(inner_hash)
                    has_const_len = 1
                    esiz = arr_hash_esiz(inner_hash)
                    if arr_hash_elem_ty(inner_hash) != 0 { elem_ty = arr_hash_elem_ty(inner_hash) }
                    ok_base = 1
                    if want_mut == 0 || ref_hash_mut(lhash) != 0 { allow_mut = 1 }
                }
            } else {
                let gi = gl_find(rns, rne)
                if gi >= 0 && GL_TY[gi as usize] == 8 {
                    base_len_const = GL[(gi * 4 + 3) as usize]
                    has_const_len = 1
                    esiz = GL[(gi * 4 + 2) as usize]
                    if arr_hash_elem_ty(GL_TY_HASH[gi as usize]) != 0 { elem_ty = arr_hash_elem_ty(GL_TY_HASH[gi as usize]) }
                    ok_base = 1
                    allow_mut = 1
                }
            }
            if ok_base == 0 {
                tc_error(borrow_tok, "slice borrow requires array or slice base")
                em32(0xD2800000)
                EXPR_IS_F64 = 0
                EXPR_TY = 10
                EXPR_TY_HASH = ref_hash_make(8, arr_ty_hash(0, 8, 1), want_mut)
                return
            }
            if want_mut != 0 && allow_mut == 0 {
                tc_error(borrow_tok, "Mut borrow requires mutable slice source")
            }
            emit_load_var_a64(start_slot)
            emit_push_a64()
            emit_load_var_a64(end_slot)
            emit_pop_x1_a64()
            em32(0xEB00003F)  // cmp x1, x0
            let slice_range_ok_a = CL
            em32(0x54000009)  // b.ls ok
            emit_assert_fail_a64()
            patch_branch_a64(slice_range_ok_a, CL)
            emit_load_var_a64(end_slot)
            emit_push_a64()
            if has_const_len != 0 { emit_imm64_a64(base_len_const) }
            else { emit_load_var_a64(base_len_slot) }
            emit_pop_x1_a64()
            em32(0xEB00003F)  // cmp x1, x0
            let slice_range_ok_b = CL
            em32(0x54000009)  // b.ls ok
            emit_assert_fail_a64()
            patch_branch_a64(slice_range_ok_b, CL)
            let len_slot = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            let ptr_slot = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            if lvi >= 0 {
                emit_load_var_a64(base_ptr_slot)
            } else {
                let gi = gl_find(rns, rne)
                if gi >= 0 { emit_imm64_a64(GL_BSS_BASE + GL[(gi * 4 + 1) as usize]) }
                else { em32(0xD2800000) }
            }
            em32(0xAA0003EA)  // mov x10, x0
            emit_load_var_a64(start_slot)
            if esiz == 8 {
                em32(0x8B000000)  // add x0, x0, x0
                em32(0x8B000000)  // add x0, x0, x0
                em32(0x8B000000)  // add x0, x0, x0
            }
            em32(0x8B000140)  // add x0, x10, x0
            emit_store_var_a64(ptr_slot)
            emit_load_var_a64(end_slot)
            emit_push_a64()
            emit_load_var_a64(start_slot)
            emit_pop_x1_a64()
            em32(0xCB000020)  // sub x0, x1, x0
            emit_store_var_a64(len_slot)
            emit_lea_var_a64(ptr_slot)
            EXPR_IS_F64 = 0
            EXPR_TY = 10
            EXPR_TY_HASH = ref_hash_make(8, arr_ty_hash(0, esiz, elem_ty), want_mut)
            return
        }
        let slot = var_find(rns, rne)
        if slot >= 0 {
            if want_mut != 0 && var_find_is_mut(rns, rne) == 0 {
                tc_error(borrow_tok, "Mut borrow requires mutable binding")
            }
            let lalen = var_find_alen(rns, rne)
            let lty = var_find_ty(rns, rne)
            if lalen > 0 || lty == 6 || lty == 8 { emit_load_var_a64(slot) }
            else { emit_lea_var_a64(slot) }
        }
        else {
            let gi = gl_find(rns, rne)
            if gi >= 0 { emit_imm64_a64(GL_BSS_BASE + GL[(gi * 4 + 1) as usize]) }
            else { tc_undefined_var(EP - 1); em32(0xD2800000) }
        }
        EXPR_IS_F64 = 0
        EXPR_TY = 10
        if var_find_idx(rns, rne) >= 0 {
            if want_mut != 0 {
                EXPR_TY_HASH = ref_hash_make(VAR_TY[var_find_idx(rns, rne) as usize], VAR_TY_HASH[var_find_idx(rns, rne) as usize], 1)
            } else {
                EXPR_TY_HASH = ref_hash_make(VAR_TY[var_find_idx(rns, rne) as usize], VAR_TY_HASH[var_find_idx(rns, rne) as usize], 0)
            }
        } else {
            let rgi = gl_find(rns, rne)
            if rgi >= 0 {
                if want_mut != 0 { EXPR_TY_HASH = ref_hash_make(GL_TY[rgi as usize], GL_TY_HASH[rgi as usize], 1) }
                else { EXPR_TY_HASH = ref_hash_make(GL_TY[rgi as usize], GL_TY_HASH[rgi as usize], 0) }
            }
            else {
                if want_mut != 0 { EXPR_TY_HASH = ref_hash_make(0, 0, 1) }
                else { EXPR_TY_HASH = ref_hash_make(0, 0, 0) }
            }
        }
        return
    }
    // Dereference *expr
    if k == 19 {
        EP = EP + 1
        compile_primary_a64()
        compile_postfix_tail_a64()
        if EXPR_TY != 0 && EXPR_TY != 10 && EXPR_TY != 11 { tc_error(EP - 1, "dereference requires reference operand") }
        em32(0xF9400000)  // ldr x0, [x0]
        if EXPR_TY == 10 || EXPR_TY == 11 {
            let ref_hash = EXPR_TY_HASH
            EXPR_TY = ptr_hash_inner_ty(ref_hash)
            EXPR_TY_HASH = ptr_hash_inner_hash(ref_hash)
        } else {
            EXPR_TY = 0
            EXPR_TY_HASH = 0
        }
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
        return
    }
    // Unary minus
    if k == 18 {
        EP = EP + 1
        compile_primary_a64()
        compile_postfix_tail_a64()
        if EXPR_IS_F64 == 1 {
            em32(0x9E670000); em32(0x1E614000); em32(0x9E660000)
        } else {
            em32(0xCB0003E0)  // neg x0, x0
        }
        return
    }
    // Unary bitwise NOT ~
    if k == 55 {
        EP = EP + 1
        compile_primary_a64()
        compile_postfix_tail_a64()
        em32(0xAA2003E0)  // mvn x0, x0
        EXPR_IS_F64 = 0
        return
    }
    // Unary not !
    if k == 32 {
        EP = EP + 1
        compile_primary_a64()
        compile_postfix_tail_a64()
        em32(0xF100001F)  // cmp x0, #0
        em32(0x9A9F17E0)  // cset x0, eq
        EXPR_IS_F64 = 0
        return
    }
    // String literal
    if k == 5 {
        let ss = TS[EP as usize] + 1
        let se = TE[EP as usize] - 1
        var slen: i64 = 0
        var zi: i64 = 0
        while zi < 256 { SQW[zi as usize] = 0; zi = zi + 1 }
        var si: i64 = ss
        while si < se {
            let ch = sb(si)
            var byte: i64 = ch
            if ch == 92 && si + 1 < se {
                let c2 = sb(si + 1)
                if c2 == 110 { byte = 10 }
                else if c2 == 116 { byte = 9 }
                else if c2 == 48 { byte = 0 }
                else { byte = c2 }
                si = si + 2
            } else { si = si + 1 }
            SQW[slen as usize] = byte
            slen = slen + 1
        }
        let total_bytes = slen + 1
        let pad_len = (total_bytes + 3) / 4 * 4
        let b_off = 1 + pad_len / 4
        em32(0x14000000 | (b_off & 0x3FFFFFF))
        let str_start = CL
        var bi: i64 = 0
        while bi < pad_len {
            if bi < slen { em(SQW[bi as usize] & 0xFF) }
            else if bi == slen { em(0) }
            else { em(0) }
            bi = bi + 1
        }
        let adr_off = 0 - pad_len
        let adr_immlo = adr_off & 3
        let adr_immhi = (adr_off >> 2) & 0x7FFFF
        em32(0x10000000 | ((adr_immlo & 0x3) << 29) | ((adr_immhi & 0x7FFFF) << 5) | 0)
        EP = EP + 1
        EXPR_IS_F64 = 0
        return
    }
    // Identifier or function call
    if k == 3 {
        var ns: i64 = TS[EP as usize]
        var ne: i64 = TE[EP as usize]
        EP = EP + 1
        let name_tok = EP - 1
        // Box::new(expr)
        if TK[EP as usize] == 51 && src_match(ns, ne - ns, "Box") {
            EP = EP + 1; EP = EP + 1
            if TK[EP as usize] == 6 { EP = EP + 1 }
            compile_or_a64()
            if TK[EP as usize] == 7 { EP = EP + 1 }
            if EXPR_TY == 8 || type_is_struct_like(EXPR_TY, EXPR_TY_HASH) || knowledge_hash_is(EXPR_TY_HASH) {
                em32(0xAA0003EA)  // mov x10, x0 (src ptr)
                em32(0xD2800000)
                emit_imm64_reg_a64(1, box_alloc_bytes(EXPR_TY, EXPR_TY_HASH))
                em32(0xD2800060 | 2)
                em32(0xD2800000 | ((0x22 & 0xFFFF) << 5) | 3)
                emit_imm64_reg_a64(4, -1)
                em32(0xD2800005)
                if TARGET_OS == 2 { emit_imm64_reg_a64(16, 0x20000C5) }
                else { em32(0xD2800000 | ((222 & 0xFFFF) << 5) | 8) }
                emit_syscall_a64()
                emit_copy_agg_to_ptr_a64(EXPR_TY, EXPR_TY_HASH)
            } else {
                emit_push_a64()
                em32(0xD2800000)
