            emit_heap_alloc_a64()
            let heap_slot_a = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var_a64(heap_slot_a)
            emit_load_var_a64(heap_slot_a)
            em32(0xAA0003E9)
            emit_adr_local_a64(cl_start_a, 0)
            em32(0xF9000120)
            var capj_a: i64 = 0
            while capj_a < saved_cap_count_a {
