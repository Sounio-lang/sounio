                    let slen_slot = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + 1
                    emit_load_var_a64(base_ptr_slot)
                    emit_str_len_a64()
                    emit_store_var_a64(slen_slot)
                    base_len_slot = slen_slot
                    esiz = 1
                    elem_ty = 1
                    ok_base = 1
                    if want_mut == 0 { allow_mut = 1 }
