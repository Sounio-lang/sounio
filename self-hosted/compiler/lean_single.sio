                    let g_mi = mono_find_inst(g_gi, 1, g_tys, g_tye)
                    if g_mi >= 0 { ns = MAN_BUF_S[g_mi as usize]; ne = MAN_BUF_E[g_mi as usize]; g_found = 1 }
