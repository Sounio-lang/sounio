    EXPR_HSHADOW_44 = -1; EXPR_HSHADOW_45 = -1; EXPR_HSHADOW_46 = -1; EXPR_HSHADOW_47 = -1
    EXPR_HSHADOW_55 = -1; EXPR_HSHADOW_56 = -1; EXPR_HSHADOW_57 = -1
    EXPR_HSHADOW_66 = -1; EXPR_HSHADOW_67 = -1
    EXPR_HSHADOW_77 = -1
        emit_push()
        compile_multiplicative()
        let right_ty = EXPR_TY
        let right_hash = EXPR_TY_HASH
        let right_unit = EXPR_UNIT
        let right_unit_dim = EXPR_UNIT_DIM
        // β⁹ GTT: capture RHS channel topology before the merge resets EXPR_CH_SET.
        let right_ch_set_a = EXPR_CH_SET
        let right_param_used_a = EXPR_PARAM_USED
        // β⁴: capture RHS shadow slots
        let right_vshadow_a = EXPR_VSHADOW
        let right_sshadow_a = EXPR_SSHADOW
        let right_sshadow_a_1 = EXPR_SSHADOW_1
        let right_sshadow_a_2 = EXPR_SSHADOW_2
        let right_sshadow_a_3 = EXPR_SSHADOW_3
        let right_sshadow_a_4 = EXPR_SSHADOW_4
        let right_sshadow_a_5 = EXPR_SSHADOW_5
        let right_sshadow_a_6 = EXPR_SSHADOW_6
        let right_sshadow_a_7 = EXPR_SSHADOW_7
        let right_ha_00 = EXPR_HSHADOW_00; let right_ha_01 = EXPR_HSHADOW_01
        let right_ha_02 = EXPR_HSHADOW_02; let right_ha_03 = EXPR_HSHADOW_03
        let right_ha_11 = EXPR_HSHADOW_11; let right_ha_12 = EXPR_HSHADOW_12
        let right_ha_13 = EXPR_HSHADOW_13; let right_ha_22 = EXPR_HSHADOW_22
        let right_ha_23 = EXPR_HSHADOW_23; let right_ha_33 = EXPR_HSHADOW_33
        let right_ha_04 = EXPR_HSHADOW_04; let right_ha_05 = EXPR_HSHADOW_05
        let right_ha_06 = EXPR_HSHADOW_06; let right_ha_07 = EXPR_HSHADOW_07
        let right_ha_14 = EXPR_HSHADOW_14; let right_ha_15 = EXPR_HSHADOW_15
        let right_ha_16 = EXPR_HSHADOW_16; let right_ha_17 = EXPR_HSHADOW_17
        let right_ha_24 = EXPR_HSHADOW_24; let right_ha_25 = EXPR_HSHADOW_25
        let right_ha_26 = EXPR_HSHADOW_26; let right_ha_27 = EXPR_HSHADOW_27
        let right_ha_34 = EXPR_HSHADOW_34; let right_ha_35 = EXPR_HSHADOW_35
        let right_ha_36 = EXPR_HSHADOW_36; let right_ha_37 = EXPR_HSHADOW_37
        let right_ha_44 = EXPR_HSHADOW_44; let right_ha_45 = EXPR_HSHADOW_45
        let right_ha_46 = EXPR_HSHADOW_46; let right_ha_47 = EXPR_HSHADOW_47
        let right_ha_55 = EXPR_HSHADOW_55; let right_ha_56 = EXPR_HSHADOW_56
        let right_ha_57 = EXPR_HSHADOW_57
        let right_ha_66 = EXPR_HSHADOW_66; let right_ha_67 = EXPR_HSHADOW_67
        let right_ha_77 = EXPR_HSHADOW_77
        // Gen 19: named units must match exactly for additive arithmetic.
        if left_unit != 0 && right_unit != 0 && left_unit != right_unit {
            tc_linear_violation(op_tok, "unit mismatch")
        }
        // Gen 19: unit dimension mismatch — compare packed dim vectors, not name hashes
        // This allows g + kg (both mass^1) while catching m + kg (length vs mass)
        if left_unit_dim != 0 && right_unit_dim != 0 && left_unit_dim != right_unit_dim {
            tc_linear_violation(op_tok, "unit dimension mismatch")
        }
        // Inherit left unit name and dim for the result
        if left_unit != 0 { EXPR_UNIT = left_unit; EXPR_UNIT_DIM = left_unit_dim }
        let left_has_knowledge = knowledge_hash_is(left_hash)
        let right_has_knowledge = knowledge_hash_is(right_hash)
        if op == 17 && left_ty == 3 && right_ty == 3 {
            BUILTIN_SLOT_B = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var(BUILTIN_SLOT_B)
            BUILTIN_SLOT_A = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            em(0x59)
            em(0x48); em(0x89); em(0xc8)  // mov rax, rcx
            emit_store_var(BUILTIN_SLOT_A)
            emit_str_concat_slots_x86(BUILTIN_SLOT_A, BUILTIN_SLOT_B)
