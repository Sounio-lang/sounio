fn print_array_elem_type(elem_ty: i64, esiz: i64) with IO, Mut, Panic, Div {
    if elem_ty == 1 {
        if esiz == 1 {
            print("i8")
        } else {
            print("i64")
        }
        return
    }
    if elem_ty == 2 { print("f64"); return }
    if elem_ty == 3 { print("string"); return }
    if elem_ty == 4 { print("bool"); return }
    if elem_ty == 5 { print("()"); return }
    if elem_ty == 6 { print("struct"); return }
    if elem_ty == 7 { print("enum"); return }
    if elem_ty == 8 { print("array"); return }
    if elem_ty == 9 { print("fn"); return }
    print("?")
}

fn print_scaled_million(v: i64) with IO, Mut, Panic, Div {
    if v < 0 {
        print("?")
        return
    }
    print_int(v / 1000000)
    print(".")
    let frac = v % 1000000
    if frac < 100000 { print("0") }
    if frac < 10000 { print("0") }
    if frac < 1000 { print("0") }
    if frac < 100 { print("0") }
    if frac < 10 { print("0") }
    print_int(frac)
}

fn print_type_label(ty: i64, ty_hash: i64) with IO, Mut, Panic, Div {
    if ty == 0 {
        if knowledge_hash_is(ty_hash) {
            print("Knowledge<")
            print_type_label(knowledge_hash_inner_ty(ty_hash), knowledge_hash_inner_hash(ty_hash))
            let mode = knowledge_hash_meta_mode(ty_hash)
            let eps = knowledge_hash_eps(ty_hash)
            if mode == 3 {
                print(", epsilon=bottom")
            } else if mode == 2 {
                if eps >= 0 {
                    print(", epsilon >= ")
                    print_scaled_million(eps)
                }
            } else if mode == 1 {
                if eps >= 0 {
                    print(", epsilon=")
                    print_scaled_million(eps)
                }
            } else {
                if eps >= 0 {
                    print(", epsilon < ")
                    print_scaled_million(eps)
                }
            }
            print(">")
            return
        }
        print("?")
        return
    }
    if ty == 1 { print("i64"); return }
    if ty == 2 { print("f64"); return }
    if ty == 3 { print("string"); return }
    if ty == 4 { print("bool"); return }
    if ty == 5 { print("()"); return }
    if ty == 6 {
        print("struct")
        return
    }
    if ty == 7 {
        print("enum")
        return
    }
    if ty == 8 {
        print("[")
        print_array_elem_type(arr_hash_elem_ty(ty_hash), arr_hash_esiz(ty_hash))
        print("; ")
        let alen = arr_hash_alen(ty_hash)
        if alen == 0 {
            print("?")
        } else {
            print_int(alen)
        }
        print("]")
        return
    }
    if ty == 9 { print("fn"); return }
    if ty == 10 {
        let inner_ty = ref_hash_inner_ty(ty_hash)
        let inner_hash = ref_hash_inner_hash(ty_hash)
        if type_is_slice_ref(ty, ty_hash) {
            if ref_hash_mut(ty_hash) != 0 { print("&![") }
            else { print("&[") }
            print_array_elem_type(arr_hash_elem_ty(inner_hash), arr_hash_esiz(inner_hash))
            print("]")
            return
        }
        if ref_hash_mut(ty_hash) != 0 { print("&!") }
        else { print("&") }
        print_type_label(inner_ty, inner_hash)
        return
    }
    if ty == 11 {
        if ty_hash == 0 {
            print("Option<_>")
            return
        }
        if option_hash_is(ty_hash) {
            print("Option<")
            print_type_label(option_hash_inner_ty(ty_hash), option_hash_inner_hash(ty_hash))
            print(">")
            return
        }
        if box_hash_is(ty_hash) {
            print("Box<")
            print_type_label(ptr_hash_inner_ty(ty_hash), ptr_hash_inner_hash(ty_hash))
            print(">")
            return
        }
        if ptr_hash_mut(ty_hash) != 0 { print("*mut ") }
        else { print("*") }
        print_type_label(ptr_hash_inner_ty(ty_hash), ptr_hash_inner_hash(ty_hash))
        return
    }
    if ty == 20 {
        print("Unobserved<")
        print_type_label(unobserved_hash_inner_ty(ty_hash), unobserved_hash_inner_hash(ty_hash))
        print(">")
        return
    }
    print("?")
}

fn dump_cli_ast_summary() with IO, Mut, Panic, Div {
    print("AST summary:\n")
    var si: i64 = 0
    while si < ST_COUNT {
        print("struct#")
        print_int(si)
        print(" hash=")
        print_int(ST[(si * 130) as usize])
        print(" fields=")
        print_int(ST[(si * 130 + 1) as usize])
        print("\n")
        var fi: i64 = 0
        while fi < ST[(si * 130 + 1) as usize] {
            print("  field")
            print_int(fi)
            print(" hash=")
            print_int(ST[(si * 130 + 2 + fi) as usize])
            print(" ty=")
            print_int(ST_FTY[(si * 128 + fi) as usize])
            print(" ty_hash=")
            print_int(ST_FHASH[(si * 128 + fi) as usize])
            print("\n")
            fi = fi + 1
        }
        si = si + 1
    }
    var ei: i64 = 0
    while ei < EN_COUNT {
        print("enum#")
        print_int(ei)
        print(" hash=")
        print_int(EN[(ei * 256) as usize])
        print(" variants=")
        print_int(EN[(ei * 256 + 1) as usize])
        print("\n")
        ei = ei + 1
    }
    var gi: i64 = 0
    while gi < GL_COUNT {
        print("global#")
        print_int(gi)
        if GL_TY[gi as usize] != 0 {
            print(": ")
            print_type_label(GL_TY[gi as usize], GL_TY_HASH[gi as usize])
        }
        print("\n")
        gi = gi + 1
    }
    var fi: i64 = 0
    while fi < FN_COUNT {
        print("fn#")
        print_int(fi)
        print("(")
        print_int(FN_ARITY[fi as usize])
        print(" params)")
        if FN_RET_TY[fi as usize] != 5 {
            print(" -> ")
            print_type_label(FN_RET_TY[fi as usize], FN_RET_HASH[fi as usize])
        }
        if FN_EFFECTS[fi as usize] != 0 {
            print(" with ")
            print_effect_mask(FN_EFFECTS[fi as usize])
        }
        print("\n")
        fi = fi + 1
    }
}

fn dump_cli_type_summary() with IO, Mut, Panic, Div {
    print("Type summary:\n")
    var gi: i64 = 0
    while gi < GL_COUNT {
        print("global#")
        print_int(gi)
        print(": ")
        print_type_label(GL_TY[gi as usize], GL_TY_HASH[gi as usize])
        print("\n")
        gi = gi + 1
    }
    var fi: i64 = 0
    while fi < FN_COUNT {
        print("fn#")
        print_int(fi)
        print(": arity ")
        print_int(FN_ARITY[fi as usize])
        print(" -> ")
        print_type_label(FN_RET_TY[fi as usize], FN_RET_HASH[fi as usize])
        print(" with ")
        print_effect_mask(FN_EFFECTS[fi as usize])
        print("\n")
        fi = fi + 1
    }
}

fn tc_wrong_arity(tok: i64, expected: i64, got: i64) -> i64 with IO, Mut, Panic {
    print("warning: arity mismatch at line ")
    print_int(TL[tok as usize])
    print("\n")
    return 0
}

fn tc_wrong_arity_hard(tok: i64, expected: i64, got: i64) -> i64 with IO, Mut, Panic {
    print("error[E006]: arity mismatch at line ")
    print_int(TL[tok as usize])
    print(" expected ")
    print_int(expected)
    print(" got ")
    print_int(got)
    print("\n")
    tc_mark_failed()
    // Honor a wrong-arity call even inside an imported function body. The
    // from_import guard in tc_mark_failed tolerates errors in imported modules
    // (effects, generics, standalone-typecheck artifacts), but a call whose
    // argument count does not match the resolved definition is a genuine
    // mis-resolution — almost always the name-only fn_find picking a same-named
    // definition of a different arity from another bundled module. Emitting a
    // binary in that state silently miscompiles the shadowed call, so fail hard
    // regardless of where the call lives.
    TYPECHECK_FAILED = 1
    return 0
}

fn stmt_is_array_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 3 { return false }
    if TK[(p0 + 1) as usize] != 41 { return false }
    var p = p0 + 2
    var depth: i64 = 1
    while p < TC && depth > 0 {
        if TK[p as usize] == 41 { depth = depth + 1 }
        if TK[p as usize] == 42 { depth = depth - 1 }
        p = p + 1
    }
    return TK[p as usize] == 16
}

fn stmt_is_field_array_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 3 && TK[p0 as usize] != 79 { return false }
    if TK[(p0 + 1) as usize] != 50 { return false }
    if TK[(p0 + 2) as usize] != 3 { return false }
    if TK[(p0 + 3) as usize] != 41 { return false }
    var p = p0 + 4
    var depth: i64 = 1
    while p < TC && depth > 0 {
        if TK[p as usize] == 41 { depth = depth + 1 }
        if TK[p as usize] == 42 { depth = depth - 1 }
        p = p + 1
    }
    return TK[p as usize] == 16
}

fn stmt_is_indexed_field_field_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 3 && TK[p0 as usize] != 79 { return false }
    if TK[(p0 + 1) as usize] != 50 { return false }
    if TK[(p0 + 2) as usize] != 3 { return false }
    if TK[(p0 + 3) as usize] != 41 { return false }
    var p = p0 + 4
    var depth: i64 = 1
    while p < TC && depth > 0 {
        if TK[p as usize] == 41 { depth = depth + 1 }
        if TK[p as usize] == 42 { depth = depth - 1 }
        p = p + 1
    }
    if TK[p as usize] != 50 { return false }
    if TK[(p + 1) as usize] != 3 { return false }
    return TK[(p + 2) as usize] == 16
}

fn stmt_is_field_array_array_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 3 && TK[p0 as usize] != 79 { return false }
    if TK[(p0 + 1) as usize] != 50 { return false }
    if TK[(p0 + 2) as usize] != 3 { return false }
    if TK[(p0 + 3) as usize] != 41 { return false }
    var p = p0 + 4
    var depth: i64 = 1
    while p < TC && depth > 0 {
        if TK[p as usize] == 41 { depth = depth + 1 }
        if TK[p as usize] == 42 { depth = depth - 1 }
        p = p + 1
    }
    if TK[p as usize] != 41 { return false }
    p = p + 1
    var depth2: i64 = 1
    while p < TC && depth2 > 0 {
        if TK[p as usize] == 41 { depth2 = depth2 + 1 }
        if TK[p as usize] == 42 { depth2 = depth2 - 1 }
        p = p + 1
    }
    return TK[p as usize] == 16
}

fn stmt_is_indexed_field_field_array_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 3 && TK[p0 as usize] != 79 { return false }
    if TK[(p0 + 1) as usize] != 50 { return false }
    if TK[(p0 + 2) as usize] != 3 { return false }
    if TK[(p0 + 3) as usize] != 41 { return false }
    var p = p0 + 4
    var depth: i64 = 1
    while p < TC && depth > 0 {
        if TK[p as usize] == 41 { depth = depth + 1 }
        if TK[p as usize] == 42 { depth = depth - 1 }
        p = p + 1
    }
    if TK[p as usize] != 50 { return false }
    if TK[(p + 1) as usize] != 3 { return false }
    if TK[(p + 2) as usize] != 41 { return false }
    p = p + 3
    var depth2: i64 = 1
    while p < TC && depth2 > 0 {
        if TK[p as usize] == 41 { depth2 = depth2 + 1 }
        if TK[p as usize] == 42 { depth2 = depth2 - 1 }
        p = p + 1
    }
    return TK[p as usize] == 16
}

fn stmt_is_deref_array_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 6 { return false }
    if TK[(p0 + 1) as usize] != 19 { return false }
    if TK[(p0 + 2) as usize] != 3 { return false }
    if TK[(p0 + 3) as usize] != 7 { return false }
    if TK[(p0 + 4) as usize] != 41 { return false }
    var p = p0 + 5
    var depth: i64 = 1
    while p < TC && depth > 0 {
        if TK[p as usize] == 41 { depth = depth + 1 }
        if TK[p as usize] == 42 { depth = depth - 1 }
        p = p + 1
    }
    return TK[p as usize] == 16
}

fn stmt_is_deref_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 19 { return false }
    if TK[(p0 + 1) as usize] != 3 { return false }
    return TK[(p0 + 2) as usize] == 16
}

fn stmt_is_deref_field_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 6 { return false }
    if TK[(p0 + 1) as usize] != 19 { return false }
    if TK[(p0 + 2) as usize] != 3 { return false }
    if TK[(p0 + 3) as usize] != 7 { return false }
    if TK[(p0 + 4) as usize] != 50 { return false }
    if TK[(p0 + 5) as usize] != 3 { return false }
    return TK[(p0 + 6) as usize] == 16
}

// (*name).field.field = expr  — two-level nested field store through a *mut/ref.
// Tokens: ( * name ) . field . field =  →  6 19 3 7 50 3 50 3 16
// Without this, the two-field LHS fell to the generic assignment path, which
// materialised the intermediate INLINE struct field as a value-copy, wrote into
// the copy, and discarded it (reads back as 0) — the nested-*mut-write bug.
fn stmt_is_deref_field_field_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 6 { return false }
    if TK[(p0 + 1) as usize] != 19 { return false }
    if TK[(p0 + 2) as usize] != 3 { return false }
    if TK[(p0 + 3) as usize] != 7 { return false }
    if TK[(p0 + 4) as usize] != 50 { return false }
    if TK[(p0 + 5) as usize] != 3 { return false }
    if TK[(p0 + 6) as usize] != 50 { return false }
    if TK[(p0 + 7) as usize] != 3 { return false }
    return TK[(p0 + 8) as usize] == 16
}

// (*name).field.field[idx] = expr  — two-level nested ARRAY-field store.
// Tokens: ( * name ) . field . field [ … ] =  →  6 19 3 7 50 3 50 3 41 …
fn stmt_is_deref_field_field_array_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 6 { return false }
    if TK[(p0 + 1) as usize] != 19 { return false }
    if TK[(p0 + 2) as usize] != 3 { return false }
    if TK[(p0 + 3) as usize] != 7 { return false }
    if TK[(p0 + 4) as usize] != 50 { return false }
    if TK[(p0 + 5) as usize] != 3 { return false }
    if TK[(p0 + 6) as usize] != 50 { return false }
    if TK[(p0 + 7) as usize] != 3 { return false }
    return TK[(p0 + 8) as usize] == 41
}

// (*name).field[idx] = expr  — explicit-deref store into a struct's ARRAY field.
// Tokens: ( * name ) . field [ ... ] =  →  6 19 3 7 50 3 41 ... 42 16
// lean_single had detectors for (*p)[i]=, (*p)=, and (*p).f= but NOT this one, so
// `(*p).field[idx] = struct/scalar` fell through to the generic assignment path and
// silently wrote into a discarded value-copy of the field array (reads back as 0).
// The auto-deref form `p.field[idx]=v` already works (resolve_field_struct_index
// resolves through the pointer's inner struct), so this is the same codegen with the
// name/field token positions shifted past the `( * … )`.
fn stmt_is_deref_field_array_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 6 { return false }
    if TK[(p0 + 1) as usize] != 19 { return false }
    if TK[(p0 + 2) as usize] != 3 { return false }
    if TK[(p0 + 3) as usize] != 7 { return false }
    if TK[(p0 + 4) as usize] != 50 { return false }
    if TK[(p0 + 5) as usize] != 3 { return false }
    if TK[(p0 + 6) as usize] != 41 { return false }
    var p = p0 + 7
    var depth: i64 = 1
    while p < TC && depth > 0 {
        if TK[p as usize] == 41 { depth = depth + 1 }
        if TK[p as usize] == 42 { depth = depth - 1 }
        p = p + 1
    }
    return TK[p as usize] == 16
}

// (*<complex-expr>).field[idx] = expr — indexed field store through a deref whose base is an
// arbitrary parenthesized expression (e.g. (*(*c).w).data[i]). Discriminated from the
// simple-name form by TK[p0+2]==6 (the inner is itself parenthesized). Paren-matches the
// outer ( to locate .field[ ... ] = . Handled by compile_deref_complex_field_array_store_x86,
// which evaluates the base with compile_or (so any nesting works).
fn stmt_is_deref_complex_field_array_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 6 { return false }        // (
    if TK[(p0 + 1) as usize] != 19 { return false } // *
    if TK[(p0 + 2) as usize] != 6 { return false }  // ( — parenthesized (complex) inner base
    var p = p0 + 1
    var pdepth: i64 = 1
    while p < TC && pdepth > 0 {
        if TK[p as usize] == 6 { pdepth = pdepth + 1 }
        if TK[p as usize] == 7 { pdepth = pdepth - 1 }
        p = p + 1
    }
    if p + 2 >= TC { return false }
    if TK[p as usize] != 50 { return false }         // .
    if TK[(p + 1) as usize] != 3 { return false }    // field name
    if TK[(p + 2) as usize] != 41 { return false }   // [
    var q = p + 3
    var bdepth: i64 = 1
    while q < TC && bdepth > 0 {
        if TK[q as usize] == 41 { bdepth = bdepth + 1 }
        if TK[q as usize] == 42 { bdepth = bdepth - 1 }
        q = q + 1
    }
    return q < TC && TK[q as usize] == 16            // =
}

// (*name).f1.f2 = expr  — TWO-level nested store through an explicit deref.
// Tokens: ( * name ) . f1 . f2 =  →  6 19 3 7 50 3 50 3 16
// lean_single had detectors for (*p).f= and (*p).f[i]= but NOT the two-hop forms,
// so `(*p).inner.x = v` fell through to the generic assignment path and silently
// wrote into a discarded value-copy of the inner struct (reads back as 0). This is
// the exact shape the in-place checker uses ((*c).fn_sigs.count = …), the #1
// front-half codegen lever (E008/E170). Nested structs are stored INLINE, so the
// store address is base_ptr + foff(f1) + foff(f2).
fn stmt_is_deref_field_field_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 6 { return false }
    if TK[(p0 + 1) as usize] != 19 { return false }
    if TK[(p0 + 2) as usize] != 3 { return false }
    if TK[(p0 + 3) as usize] != 7 { return false }
    if TK[(p0 + 4) as usize] != 50 { return false }
    if TK[(p0 + 5) as usize] != 3 { return false }
    if TK[(p0 + 6) as usize] != 50 { return false }
    if TK[(p0 + 7) as usize] != 3 { return false }
    return TK[(p0 + 8) as usize] == 16
}

// (*name).f1.f2[idx] = expr  — two-level nested store into a struct's ARRAY field.
// Tokens: ( * name ) . f1 . f2 [ ... ] =  →  6 19 3 7 50 3 50 3 41 ... 42 16
fn stmt_is_deref_field_field_array_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 6 { return false }
    if TK[(p0 + 1) as usize] != 19 { return false }
    if TK[(p0 + 2) as usize] != 3 { return false }
    if TK[(p0 + 3) as usize] != 7 { return false }
    if TK[(p0 + 4) as usize] != 50 { return false }
    if TK[(p0 + 5) as usize] != 3 { return false }
    if TK[(p0 + 6) as usize] != 50 { return false }
    if TK[(p0 + 7) as usize] != 3 { return false }
    if TK[(p0 + 8) as usize] != 41 { return false }
    var p = p0 + 9
    var depth: i64 = 1
    while p < TC && depth > 0 {
        if TK[p as usize] == 41 { depth = depth + 1 }
        if TK[p as usize] == 42 { depth = depth - 1 }
        p = p + 1
    }
    return TK[p as usize] == 16
}

// (*name).f1[i].f2 = expr  and  (*name).f1[i].f2[j].f3 = expr — store into a FIELD OF
// AN ARRAY ELEMENT reached through an explicit deref. The lvalue chain crosses at least
// one index and ends in `.field`.
// Tokens: ( * name ) then a chain of `. ident` / `[ … ]`, ending `. ident =`.
// lean_single had detectors for (*p).f=, (*p).f[i]=, (*p).f1.f2= and (*p).f1.f2[i]= but
// NOT for a field of an INDEXED element, so `(*p).arr[i].f = v` fell through to the
// generic assignment path and silently wrote into a discarded value-copy of the element
// (reads back as 0) — the same disease as the two-hop forms, and additionally it leaked
// the assigned field's type into LAST_STMT_HAS_VALUE, so a unit fn whose tail-if arms end
// in such stores to differently-typed fields was falsely rejected with "if arm type does
// not match else arm". This is the shape the IR passes use throughout
// (self-hosted/ir/opt_cleanup.sio ocp_mfi_instr_move_fields:
// (*module).functions[fi].instrs[dst_i].op = op).
// Array elements of aggregate type are stored pointer-per-slot, so the element address is
// LOADED from [array_base + idx*8]; trailing inline fields add their offsets.
// Discriminated from the already-handled shapes by requiring BOTH an index in the chain
// and a trailing `. ident` immediately before the `=` (the handled forms end in `]` or
// contain no index at all), so this predicate is disjoint from all of them.
fn stmt_is_deref_indexed_elem_field_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 6 { return false }        // (
    if TK[(p0 + 1) as usize] != 19 { return false } // *
    if TK[(p0 + 2) as usize] != 3 { return false }  // simple-name root
    if TK[(p0 + 3) as usize] != 7 { return false }  // )
    var p = p0 + 4
    var saw_index: i64 = 0
    while p < TC {
        if TK[p as usize] == 50 {                   // . field
            if TK[(p + 1) as usize] != 3 { return false }
            p = p + 2
            continue
        }
        if TK[p as usize] == 41 {                   // [ … ]
            var depth: i64 = 1
            p = p + 1
            while p < TC && depth > 0 {
                if TK[p as usize] == 41 { depth = depth + 1 }
                if TK[p as usize] == 42 { depth = depth - 1 }
                p = p + 1
            }
            saw_index = 1
            continue
        }
        if TK[p as usize] == 16 {                   // =
            if saw_index == 0 { return false }
            if p < p0 + 6 { return false }
            // Two terminal forms: `. field =` stores into a field, `] =` stores into an
            // array ELEMENT. The element form is the one ir/opt_cleanup.sio uses for its
            // whole-record instruction rewrites, e.g.
            // (*module).functions[fi].instrs[i] = ir_copy(dst, found).
            if TK[(p - 1) as usize] == 42 { return true }
            if TK[(p - 1) as usize] != 3 { return false }
            return TK[(p - 2) as usize] == 50
        }
        return false
    }
    return false
}

// name.f1[i].f2 = expr and deeper — the AUTO-DEREF twin of
// stmt_is_deref_indexed_elem_field_store: identical chain, bare-ident root, no `(* )`.
// Same disease, same magnitude: measured on a single file whose two fns differ ONLY in the
// root spelling, `(*m).blks[1].ins[0].op = 77` stored 77 while `m.blks[1].ins[0].op = 77`
// stored nothing — rc=0, zero errors, zero warnings, Madaros correct on both. The narrow
// ident-root handlers cover only ONE field hop before the index (stmt_is_indexed_field_field_store
// requires TK[p0+3]==41), so every deeper ident chain fell to the generic assignment path.
// Live casualties found by shape census: ir/dead_code.sio:260 (dce_mark_reachable marks no
// instruction reachable), native/codegen_plan.sio:1325 (scheduling priorities stay zero),
// with the shape appearing ~131 times under self-hosted/ (compiler/main.sio alone ~95) plus
// the bootstrap chain.
// This predicate is SHAPE-ONLY; root resolvability is decided at the dispatch by
// ident_chain_root_supported, following the established gating pattern of
// stmt_is_field_field_store_shape at :23245.
fn stmt_is_ident_indexed_elem_field_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 3 { return false }        // bare-ident root
    if TK[(p0 + 1) as usize] != 50 { return false } // must start with `. field`, not `[`
    var p = p0 + 1
    var saw_index: i64 = 0
    while p < TC {
        if TK[p as usize] == 50 {                   // . field
            if TK[(p + 1) as usize] != 3 { return false }
            p = p + 2
            continue
        }
        if TK[p as usize] == 41 {                   // [ … ]
            var depth: i64 = 1
            p = p + 1
            while p < TC && depth > 0 {
                if TK[p as usize] == 41 { depth = depth + 1 }
                if TK[p as usize] == 42 { depth = depth - 1 }
                p = p + 1
            }
            saw_index = 1
            continue
        }
        if TK[p as usize] == 16 {                   // =
            if saw_index == 0 { return false }
            if p < p0 + 3 { return false }
            // Same two terminal forms as the deref twin: `. field =` (field of an element)
            // and `] =` (the element itself).
            if TK[(p - 1) as usize] == 42 { return true }
            if TK[(p - 1) as usize] != 3 { return false }
            return TK[(p - 2) as usize] == 50
        }
        return false
    }
    return false
}

// (*name.field)<chain> = expr — the lvalue ROOT is a deref of a pointer held in a STRUCT
// FIELD, e.g. `(*lo.module).string_count = 0`, `(*lo.module).string_table[i] = n`,
// `(*lo.module).functions[i] = new_fn`, where Lowerer.module is a Box<IrModule>.
// 37 such sites in self-hosted/ir/lower.sio — the LIVE Madaros IR lowerer.
// No existing store predicate accepts this root: every deref-rooted one requires `)`
// immediately after the simple name (checks at :4845 :4867 :4882 :4896 :4916 :4972 :4986),
// and the only complex-root predicate (:4935) requires a PARENTHESISED inner base. So every
// shape with this root reached the generic assignment path and lost its store, which is why
// this predicate accepts the whole chain grammar rather than a single shape.
// Base address: load the root, add the inner field offsets (inline), then LOAD the pointer
// stored in the final inner field — that is the deref the `(* )` spells.
fn stmt_is_deref_inner_root_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 6 { return false }        // (
    if TK[(p0 + 1) as usize] != 19 { return false } // *
    if TK[(p0 + 2) as usize] != 3 { return false }  // simple-name root
    if TK[(p0 + 3) as usize] != 50 { return false } // `.` — NOT the (*name) forms
    var p = p0 + 3
    while p < TC && TK[p as usize] == 50 && TK[(p + 1) as usize] == 3 {
        p = p + 2
    }
    if TK[p as usize] != 7 { return false }         // )
    p = p + 1
    // A non-empty chain is required: `(*p.field) = v` is whole-pointee assignment, a
    // different operation with its own handler, and this emitter has no target field for it.
    if TK[p as usize] != 50 && TK[p as usize] != 41 { return false }
    while p < TC {
        if TK[p as usize] == 50 {
            if TK[(p + 1) as usize] != 3 { return false }
            p = p + 2
            continue
        }
        if TK[p as usize] == 41 {
            var depth: i64 = 1
            p = p + 1
            while p < TC && depth > 0 {
                if TK[p as usize] == 41 { depth = depth + 1 }
                if TK[p as usize] == 42 { depth = depth - 1 }
                p = p + 1
            }
            continue
        }
        if TK[p as usize] == 16 {
            if TK[(p - 1) as usize] == 42 { return true }
            if TK[(p - 1) as usize] != 3 { return false }
            return TK[(p - 2) as usize] == 50
        }
        return false
    }
    return false
}

// name.f1.f2 = expr  — AUTO-DEREF two-level store (ident root, no explicit `(* )`).
// Shape only: (3|79) 50 3 50 3 16. For a VALUE struct root the generic assignment
// path already handles this correctly, so the dispatch gates this on the root var
// being pointer-like (token_chain_root_is_pointer); value structs fall through
// unchanged. Pointer roots previously wrote into a discarded value-copy (read 0) —
// the same disease as the explicit-deref form, and the shape used by the in-place
// checker's c.algebras.count / c.studies.count / c.ontologies.count collectors.
fn stmt_is_field_field_store_shape(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 3 && TK[p0 as usize] != 79 { return false }
    if TK[(p0 + 1) as usize] != 50 { return false }
    if TK[(p0 + 2) as usize] != 3 { return false }
    if TK[(p0 + 3) as usize] != 50 { return false }
    if TK[(p0 + 4) as usize] != 3 { return false }
    return TK[(p0 + 5) as usize] == 16
}

// name.f1.f2[idx] = expr  →  (3|79) 50 3 50 3 41 ... 42 16
fn stmt_is_field_field_array_store_shape(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 3 && TK[p0 as usize] != 79 { return false }
    if TK[(p0 + 1) as usize] != 50 { return false }
    if TK[(p0 + 2) as usize] != 3 { return false }
    if TK[(p0 + 3) as usize] != 50 { return false }
    if TK[(p0 + 4) as usize] != 3 { return false }
    if TK[(p0 + 5) as usize] != 41 { return false }
    var p = p0 + 6
    var depth: i64 = 1
    while p < TC && depth > 0 {
        if TK[p as usize] == 41 { depth = depth + 1 }
        if TK[p as usize] == 42 { depth = depth - 1 }
        p = p + 1
    }
    return TK[p as usize] == 16
}

// True when the var named by the token at p0 is a pointer/ref binding (so a
// `name.f1.f2 = …` write must deref rather than write into a local struct slot).
// Root-resolvability gate for the indexed-element field store on a BARE-IDENT root.
// True only when the root is a LOCAL whose base address the store emitter can reproduce
// exactly as the read path does (emit_load_var):
//   - pointer-like root  → the slot holds the pointee address (ref/param roots);
//   - plain struct root  → the slot ALSO holds a pointer to the struct's inline slots,
//     because a struct value is represented as `lea rax,[rbp-(base+nslots-1)*8]` (see the
//     struct-literal emission) and that pointer is what gets stored into the local. This is
//     why reads like `c.heap.objects[i].mark_color` already work through a value root.
// Anything else — globals (var_find has no slot), non-aggregate roots — returns false so the
// statement falls through to the generic assignment path EXACTLY as before, rather than being
// intercepted and hard-rejected. Without that, `G.arr[i].f = v` on a global struct would turn
// from working code into a false reject.
fn ident_chain_root_supported(p0: i64) -> bool with Panic, Mut, Div {
    let lvi = var_find_idx(TS[p0 as usize], TE[p0 as usize])
    if lvi < 0 { return false }
    if var_find(TS[p0 as usize], TE[p0 as usize]) < 0 { return false }
    let vt = VAR_TY[lvi as usize]
    let vh = VAR_TY_HASH[lvi as usize]
    if type_is_pointer_like(vt, vh) {
        let it = ptr_hash_inner_ty(vh)
        return it == 6 || it == 8
    }
    return vt == 6
}

fn token_chain_root_is_pointer(p0: i64) -> bool with Panic, Mut, Div {
    let lvi = var_find_idx(TS[p0 as usize], TE[p0 as usize])
    if lvi < 0 { return false }
    return type_is_pointer_like(VAR_TY[lvi as usize], VAR_TY_HASH[lvi as usize])
}

// True when the statement is `name[idx].field(.field)* = expr` — store into a
// field of a struct element inside an array-of-structs root. The root is itself
// an array-of-structs variable (local, global, or &![T;N] param); after the
// bracket-balanced index there must be a '.' field chain and a terminal '='.
fn stmt_is_array_elem_field_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 3 { return false }
    if TK[(p0 + 1) as usize] != 41 { return false }
    var p = p0 + 2
    var depth: i64 = 1
    while p < TC && depth > 0 {
        if TK[p as usize] == 41 { depth = depth + 1 }
        if TK[p as usize] == 42 { depth = depth - 1 }
        p = p + 1
    }
    if TK[p as usize] != 50 { return false }
    if TK[(p + 1) as usize] != 3 { return false }
    p = p + 2
    while TK[p as usize] == 50 && TK[(p + 1) as usize] == 3 {
        p = p + 2
    }
    return TK[p as usize] == 16
}

fn scan_unit_type_expr(p0: i64, close_tk: i64) with IO, Panic, Mut, Div {
    var p = p0
    var dim: i64 = 0
    var saw_unit: i64 = 0
    var expect_unit: i64 = 1
    var op: i64 = 19
    while p < TC && TK[p as usize] != close_tk && TK[p as usize] != 39 && TK[p as usize] != 0 {
        if expect_unit != 0 {
            if TK[p as usize] != 3 {
                tc_error_hard(p, "malformed f64<UnitExpr> annotation")
                SCAN_UNIT_EXPR_DIM = 0
                SCAN_UNIT_EXPR_NEXT = 0 - 1
                return
            }
            let uh = gl_name_hash(TS[p as usize], TE[p as usize])
            if !unit_is_registered_h(uh) {
                tc_error_hard(p, "unknown unit in f64<UnitExpr> annotation")
                SCAN_UNIT_EXPR_DIM = 0
                SCAN_UNIT_EXPR_NEXT = 0 - 1
                return
            }
            let ud = unit_lookup_dim(uh)
            if saw_unit == 0 {
                dim = ud
            } else {
                if op == 19 { dim = dim_add(dim, ud) }
                else { dim = dim_sub(dim, ud) }
            }
            saw_unit = 1
            expect_unit = 0
            p = p + 1
        } else {
            if TK[p as usize] != 19 && TK[p as usize] != 20 {
                tc_error_hard(p, "malformed f64<UnitExpr> annotation")
                SCAN_UNIT_EXPR_DIM = 0
                SCAN_UNIT_EXPR_NEXT = 0 - 1
                return
            }
            op = TK[p as usize]
            expect_unit = 1
            p = p + 1
        }
    }
    if saw_unit == 0 || expect_unit != 0 {
        tc_error_hard(p, "malformed f64<UnitExpr> annotation")
        SCAN_UNIT_EXPR_DIM = 0
        SCAN_UNIT_EXPR_NEXT = 0 - 1
        return
    }
    SCAN_UNIT_EXPR_DIM = dim
    SCAN_UNIT_EXPR_NEXT = p
}

fn skip_type_meta_item(p0: i64, close_tk: i64) -> i64 with Panic, Mut {
    var p = p0
    var paren_depth: i64 = 0
    var bracket_depth: i64 = 0
    var brace_depth: i64 = 0
    var angle_depth: i64 = 0
    while p < TC {
        let k = TK[p as usize]
        if k == 28 && paren_depth == 0 && bracket_depth == 0 && brace_depth == 0 && angle_depth == 0 { return p }
        if k == close_tk && paren_depth == 0 && bracket_depth == 0 && brace_depth == 0 && angle_depth == 0 { return p }
        if k == 6 { paren_depth = paren_depth + 1 }
        if k == 7 {
            if paren_depth > 0 { paren_depth = paren_depth - 1 }
        }
        if k == 41 { bracket_depth = bracket_depth + 1 }
        if k == 42 {
            if bracket_depth > 0 { bracket_depth = bracket_depth - 1 }
        }
        if k == 8 { brace_depth = brace_depth + 1 }
        if k == 9 {
            if brace_depth > 0 { brace_depth = brace_depth - 1 }
        }
        if k == 23 { angle_depth = angle_depth + 1 }
        if k == 24 {
            if angle_depth > 0 { angle_depth = angle_depth - 1 }
        }
        p = p + 1
    }
    return p
}

fn src_line_of(pos: i64) -> i64 with Panic, Mut {
    var line: i64 = 1
    var i: i64 = 0
    while i < pos && i < SRC_LEN {
        if sb(i) == 10 { line = line + 1 }
        i = i + 1
    }
    return line
}

fn src_has_knightian_bottom_at(pos: i64) -> bool with Panic, Mut {
    if pos + 5 >= SRC_LEN { return false }
    if sb(pos) != 206 || sb(pos + 1) != 181 { return false }
    if sb(pos + 2) != 61 { return false }
    if sb(pos + 3) != 226 || sb(pos + 4) != 138 || sb(pos + 5) != 165 { return false }
    return true
}

fn src_has_knightian_conf_req_at(pos: i64) -> bool with Panic, Mut {
    if pos + 4 >= SRC_LEN { return false }
    if sb(pos) != 206 || sb(pos + 1) != 181 { return false }
    if sb(pos + 2) == 32 && sb(pos + 3) == 62 && sb(pos + 4) == 61 { return true }
    if sb(pos + 2) == 62 && sb(pos + 3) == 61 { return true }
    return false
}

fn precheck_knightian_conflict() -> i64 with IO, Mut, Panic {
    var p: i64 = 0
    var knight_line: i64 = 0
    var has_conf_req: i64 = 0
    while p < SRC_LEN {
        if sb(p) == 47 && p + 1 < SRC_LEN && sb(p + 1) == 47 {
            p = p + 2
            while p < SRC_LEN && sb(p) != 10 { p = p + 1 }
            continue
        }
        if sb(p) == 34 {
            p = p + 1
            while p < SRC_LEN && sb(p) != 34 {
                if sb(p) == 92 && p + 1 < SRC_LEN {
                    p = p + 2
                } else {
                    p = p + 1
                }
            }
            if p < SRC_LEN && sb(p) == 34 { p = p + 1 }
            continue
        }
        if src_has_knightian_bottom_at(p) {
            if knight_line == 0 { knight_line = src_line_of(p) }
        }
        if src_has_knightian_conf_req_at(p) { has_conf_req = 1 }
        p = p + 1
    }
    if knight_line != 0 && has_conf_req != 0 {
        print("type error line ")
        print_int(knight_line)
        print(": Knightian uncertainty (")
        print("ε=⊥")
        print(") cannot satisfy required confidence\n")
        return 1
    }
    return 0
}

fn src_valid_until_date_eq(pos: i64, date_s: i64) -> bool with Panic, Mut {
    var i: i64 = 0
    while i < 10 {
        if sb(pos + i) != sb(date_s + i) { return false }
        i = i + 1
    }
    return true
}

fn precheck_temporal_window_conflict() -> i64 with IO, Mut, Panic {
    var p: i64 = 0
    var first_date_s: i64 = -1
    while p + 11 < SRC_LEN {
        if sb(p) == 47 && p + 1 < SRC_LEN && sb(p + 1) == 47 {
            p = p + 2
            while p < SRC_LEN && sb(p) != 10 { p = p + 1 }
            continue
        }
        if sb(p) == 34 {
            p = p + 1
            while p < SRC_LEN && sb(p) != 34 {
                if sb(p) == 92 && p + 1 < SRC_LEN {
                    p = p + 2
                } else {
                    p = p + 1
                }
            }
            if p < SRC_LEN && sb(p) == 34 { p = p + 1 }
            continue
        }
        if src_match(p, 12, "ValidUntil(\"") {
            let date_s = p + 12
            if date_s + 9 < SRC_LEN {
                if first_date_s < 0 {
                    first_date_s = date_s
                } else if src_valid_until_date_eq(date_s, first_date_s) == false {
                    print("type error line ")
                    print_int(src_line_of(p))
                    print(": Temporal validity window mismatch\n")
                    return 1
                }
            }
        }
        p = p + 1
    }
    return 0
}

fn fnsig_intern_scratch() -> i64 with Mut, Panic {
    var sig: i64 = 1
    while sig < FNSIG_COUNT {
        if FNSIG_ARITY[sig as usize] == FNSIG_SCRATCH_ARITY
            && FNSIG_RET_TY[sig as usize] == FNSIG_SCRATCH_RET_TY
            && FNSIG_RET_HASH[sig as usize] == FNSIG_SCRATCH_RET_HASH
            && FNSIG_EFF[sig as usize] == FNSIG_SCRATCH_EFF {
            var same: i64 = 1
            var pi: i64 = 0
            while pi < FNSIG_SCRATCH_ARITY {
                let base = sig * 16 + pi
                if FNSIG_PARAM_TY[base as usize] != FNSIG_SCRATCH_PARAM_TY[pi as usize]
                    || FNSIG_PARAM_HASH[base as usize] != FNSIG_SCRATCH_PARAM_HASH[pi as usize] {
                    same = 0
                    pi = FNSIG_SCRATCH_ARITY
                } else {
                    pi = pi + 1
                }
            }
            if same == 1 { return sig }
        }
        sig = sig + 1
    }
    sig = FNSIG_COUNT
    if sig >= 256 { return 0 }
    FNSIG_ARITY[sig as usize] = FNSIG_SCRATCH_ARITY
    FNSIG_RET_TY[sig as usize] = FNSIG_SCRATCH_RET_TY
    FNSIG_RET_HASH[sig as usize] = FNSIG_SCRATCH_RET_HASH
    FNSIG_EFF[sig as usize] = FNSIG_SCRATCH_EFF
    var pi: i64 = 0
    while pi < 16 {
        let base = sig * 16 + pi
        if pi < FNSIG_SCRATCH_ARITY {
            FNSIG_PARAM_TY[base as usize] = FNSIG_SCRATCH_PARAM_TY[pi as usize]
            FNSIG_PARAM_HASH[base as usize] = FNSIG_SCRATCH_PARAM_HASH[pi as usize]
        } else {
            FNSIG_PARAM_TY[base as usize] = 0
            FNSIG_PARAM_HASH[base as usize] = 0
        }
        pi = pi + 1
    }
    FNSIG_COUNT = FNSIG_COUNT + 1
    return sig
}

fn scan_fn_type_signature(p0: i64) with IO, Mut, Panic, Div {
    var p = p0 + 1
    let depth = FNSIG_SCAN_DEPTH
    let tmp_base = depth * 16
    if depth < 15 { FNSIG_SCAN_DEPTH = depth + 1 }
    var arity: i64 = 0
    var i: i64 = 0
    while i < 16 {
        FNSIG_TMP_PARAM_TY[(tmp_base + i) as usize] = 0
        FNSIG_TMP_PARAM_HASH[(tmp_base + i) as usize] = 0
        i = i + 1
    }
    if TK[p as usize] == 6 {
        p = p + 1
        while TK[p as usize] != 7 && TK[p as usize] != 0 {
            scan_type(p)
            if arity < 16 {
                FNSIG_TMP_PARAM_TY[(tmp_base + arity) as usize] = SCAN_TY
                FNSIG_TMP_PARAM_HASH[(tmp_base + arity) as usize] = SCAN_TY_HASH
            }
            arity = arity + 1
            p = SCAN_TY_NEXT
            if TK[p as usize] == 28 { p = p + 1 }
        }
        if TK[p as usize] == 7 { p = p + 1 }
    }
    var ret_ty: i64 = 5
    var ret_hash: i64 = 0
    if TK[p as usize] == 10 {
        p = p + 1
        scan_type(p)
        ret_ty = SCAN_TY
        ret_hash = SCAN_TY_HASH
        p = SCAN_TY_NEXT
    }
    var eff_mask: i64 = 0
    if TK[p as usize] == 38 {
        p = p + 1
        while tok_is_effect_name(p) {
            eff_mask = eff_mask | ety_parse_effect_name(TS[p as usize], TE[p as usize])
            p = p + 1
            if TK[p as usize] == 28 && tok_is_effect_name(p + 1) {
                p = p + 1
            } else {
                break
            }
        }
    }
    FNSIG_SCRATCH_EFF = eff_mask
    FNSIG_SCRATCH_ARITY = arity
    FNSIG_SCRATCH_RET_TY = ret_ty
    FNSIG_SCRATCH_RET_HASH = ret_hash
    i = 0
    while i < 16 {
        if i < arity {
            FNSIG_SCRATCH_PARAM_TY[i as usize] = FNSIG_TMP_PARAM_TY[(tmp_base + i) as usize]
            FNSIG_SCRATCH_PARAM_HASH[i as usize] = FNSIG_TMP_PARAM_HASH[(tmp_base + i) as usize]
        } else {
            FNSIG_SCRATCH_PARAM_TY[i as usize] = 0
            FNSIG_SCRATCH_PARAM_HASH[i as usize] = 0
        }
        i = i + 1
    }
    FNSIG_SCAN_DEPTH = depth
    SCAN_TY = 9
    SCAN_TY_HASH = fnsig_intern_scratch()
    SCAN_TY_NEXT = p
}

fn fnsig_from_decl_name_tok(name_tok: i64) -> i64 with IO, Mut, Panic, Div {
    var p = name_tok + 1
    let depth = FNSIG_SCAN_DEPTH
    let tmp_base = depth * 16
    if depth < 15 { FNSIG_SCAN_DEPTH = depth + 1 }
    var arity: i64 = 0
    var i: i64 = 0
    while i < 16 {
        FNSIG_TMP_PARAM_TY[(tmp_base + i) as usize] = 0
        FNSIG_TMP_PARAM_HASH[(tmp_base + i) as usize] = 0
        i = i + 1
    }
    if TK[p as usize] == 6 {
        p = p + 1
        while TK[p as usize] != 7 && TK[p as usize] != 0 {
            if TK[p as usize] == 3 || TK[p as usize] == 79 {
                p = p + 1
                if TK[p as usize] == 43 {
                    p = p + 1
                    scan_type(p)
                    if arity < 16 {
                        FNSIG_TMP_PARAM_TY[(tmp_base + arity) as usize] = SCAN_TY
                        FNSIG_TMP_PARAM_HASH[(tmp_base + arity) as usize] = SCAN_TY_HASH
                    }
                    arity = arity + 1
                    p = SCAN_TY_NEXT
                }
            } else {
                p = p + 1
            }
            if TK[p as usize] == 28 { p = p + 1 }
        }
        if TK[p as usize] == 7 { p = p + 1 }
    }
    var ret_ty: i64 = 5
    var ret_hash: i64 = 0
    if TK[p as usize] == 10 {
        p = p + 1
        scan_type(p)
        ret_ty = SCAN_TY
        ret_hash = SCAN_TY_HASH
        p = SCAN_TY_NEXT
    }
    p = skip_signature_where_clause(p)
    if TK[p as usize] == 38 {
        p = p + 1
        // Gen 17 D2: skip Epistemic(N) parenthesized arguments
        while TK[p as usize] == 3 || TK[p as usize] == 28 {
            if TK[p as usize] == 3 { p = p + 1; if TK[p as usize] == 6 { p = p + 1; while TK[p as usize] != 7 && TK[p as usize] != 0 { p = p + 1 }; if TK[p as usize] == 7 { p = p + 1 } } }
            else { p = p + 1 }
        }
    }
    FNSIG_SCRATCH_ARITY = arity
    FNSIG_SCRATCH_RET_TY = ret_ty
    FNSIG_SCRATCH_RET_HASH = ret_hash
    FNSIG_SCRATCH_EFF = 0
    i = 0
    while i < 16 {
        if i < arity {
            FNSIG_SCRATCH_PARAM_TY[i as usize] = FNSIG_TMP_PARAM_TY[(tmp_base + i) as usize]
            FNSIG_SCRATCH_PARAM_HASH[i as usize] = FNSIG_TMP_PARAM_HASH[(tmp_base + i) as usize]
        } else {
            FNSIG_SCRATCH_PARAM_TY[i as usize] = 0
            FNSIG_SCRATCH_PARAM_HASH[i as usize] = 0
        }
        i = i + 1
    }
    FNSIG_SCAN_DEPTH = depth
    return fnsig_intern_scratch()
}

fn scan_type(p0: i64) with IO, Mut, Panic, Div {
    var p = p0
    SCAN_TY = 0
    SCAN_TY_HASH = 0
    SCAN_TY_ESIZ = 8
    SCAN_TY_ALEN = 0
    // ?T — shorthand for Option<T>
    if TK[p as usize] == 65 {
        p = p + 1
        scan_type(p)
        let inner_ty = SCAN_TY
        let inner_hash = SCAN_TY_HASH
        p = SCAN_TY_NEXT
        SCAN_TY = 11
        SCAN_TY_HASH = option_hash_make(inner_ty, inner_hash)
        SCAN_TY_NEXT = p
        return
    }
    // Tuple type: (T, U, ...) — skip balanced parens, treat as aggregate
    if TK[p as usize] == 6 {
        // Empty parens () = unit type (not a tuple)
        if TK[(p + 1) as usize] == 7 {
            SCAN_TY = 5
            SCAN_TY_HASH = 0
            SCAN_TY_NEXT = p + 2
            return
        }
        // Find every top-level element's start position first (pure token scan,
        // no recursive scan_type yet — avoids disturbing TUP_SCRATCH mid-count).
        var elem_starts: [i64; 16] = [0; 16]
        var tcount: i64 = 1
        elem_starts[0] = p + 1
        var td: i64 = 1
        var q = p + 1
        while q < TC && td > 0 {
            if TK[q as usize] == 6 { td = td + 1 }
            if TK[q as usize] == 7 { td = td - 1 }
            if td == 1 && TK[q as usize] == 28 {
                if tcount < 16 { elem_starts[tcount as usize] = q + 1 }
                tcount = tcount + 1
            }
            q = q + 1
        }
        // Scan every element's type (capped at 16 — the widest tuple measured
        // across the codebase is 8, see docs/audit dispatch for Bug G). first/last
        // are element 0 / element (scan_count-1), kept for the legacy 2-element
        // decoders; the full array goes to TUP_CACHE via the scratch channel so
        // N-ary consumers (destructure, `.1`) can address any middle element.
        var scan_count: i64 = tcount
        if scan_count > 16 { scan_count = 16 }
        var first_ty: i64 = 0
        var first_hash: i64 = 0
        var first_f64: i64 = 0
        var first_nslots: i64 = 0
        var last_ty: i64 = 0
        var last_hash: i64 = 0
        var last_f64: i64 = 0
        var total_nslots: i64 = 0
        var i: i64 = 0
        while i < scan_count {
            scan_type(elem_starts[i as usize])
            let ety = SCAN_TY
            let ehash = SCAN_TY_HASH
            let eslots = ty_slot_count(ety, ehash)
            // Element-kind code packed into the (legacy "f64") hash digit: 1=f64,
            // 2=bool, 0=other. Encoding bool as 2 makes (Big,bool) and (Big,i64)
            // get DISTINCT tuple-hash keys (scalars both hash 0 otherwise →
            // cache-key collision → mistyped `.1`). f64 decoders still test
            // `== 1`, so they are unaffected.
            var ef64: i64 = 0
            if ety == 2 { ef64 = 1 } else if ety == 4 { ef64 = 2 }
            TUP_SCRATCH_ELEM_TY[i as usize] = ety
            TUP_SCRATCH_ELEM_HASH[i as usize] = ehash
            total_nslots = total_nslots + eslots
            if i == 0 { first_ty = ety; first_hash = ehash; first_f64 = ef64; first_nslots = eslots }
            if i == scan_count - 1 { last_ty = ety; last_hash = ehash; last_f64 = ef64 }
            i = i + 1
        }
        TUP_SCRATCH_COUNT = scan_count
        SCAN_TY = 6
        // Hash: tcount*100M + first_f64*10M + last_f64*1M + first_nslots*1000 + total_nslots
        // total_nslots here is now the sum of EVERY element (not just first+last) —
        // this is the field that sizes SRET buffers/return copies for 3+ tuples.
        SCAN_TY_HASH = (first_hash % 1000) * 1000000000000000 + (last_hash % 1000000) * 1000000000 + tcount * 100000000 + first_f64 * 10000000 + last_f64 * 1000000 + first_nslots * 1000 + total_nslots
        tup_cache_register(SCAN_TY_HASH, first_ty, first_hash, last_ty, last_hash)
        SCAN_TY_NEXT = q
        return
    }
    if TK[p as usize] == 19 {
        var ptr_mode: i64 = 0
        p = p + 1
        if TK[p as usize] == 32 {
            ptr_mode = 1
            p = p + 1
        } else if TK[p as usize] == 3 {
            let mns = TS[p as usize]
            let mne = TE[p as usize]
            if src_match(mns, mne - mns, "mut") {
                ptr_mode = 1
                p = p + 1
            }
        }
        scan_type(p)
        let inner_ty = SCAN_TY
        let inner_hash = SCAN_TY_HASH
        let inner_next = SCAN_TY_NEXT
        SCAN_TY_HASH = ptr_hash_make(inner_ty, inner_hash, ptr_mode)
        SCAN_TY = 11
        SCAN_TY_NEXT = inner_next
        return
    }
    if TK[p as usize] == 44 {
        var ref_mode: i64 = 0
        p = p + 1
        // Strike 2: Reject '&mut' Rust syntax
        if TK[p as usize] == 3 {
            let mns = TS[p as usize]
            let mne = TE[p as usize]
            if src_match(mns, mne - mns, "mut") {
                tc_rust_mut_ref(p)
            }
        }
        if TK[p as usize] == 32 { ref_mode = 1; p = p + 1 }
        scan_type(p)
        SCAN_TY_HASH = ref_hash_make(SCAN_TY, SCAN_TY_HASH, ref_mode)
        SCAN_TY = 10
        return
    }
    // Refinement type: { ident : TYPE | pred } -> treat as TYPE + parse predicate
    SCAN_HAS_PRED = 0
    SCAN_HAS_PRED2 = 0
    if TK[p as usize] == 8 {
        if p + 3 < TC {
            let ref_t1 = TK[(p + 1) as usize]
            let ref_t2 = TK[(p + 2) as usize]
            if ref_t1 == 3 {
                if ref_t2 == 43 {
                    var rp = p + 3
                    var found_pipe: i64 = 0
                    while rp < TC {
                        let rtk = TK[rp as usize]
                        if rtk == 9 { break }
                        if rtk == 0 { break }
                        if rtk == 45 { found_pipe = 1
                        break }
                        rp = rp + 1
                    }
                    if found_pipe == 1 {
                        scan_type(p + 3)
                        // Parse predicate: skip ref_var_ident, read op, read bound
                        var pp = rp + 1
                        if pp < TC && TK[pp as usize] == 3 { pp = pp + 1 }  // skip var ident
                        if pp < TC {
                            let pred_op = TK[pp as usize]
                            if pred_op == 26 || pred_op == 24 || pred_op == 25 || pred_op == 23 || pred_op == 21 || pred_op == 22 {
                                SCAN_PRED_OP = pred_op
                                pp = pp + 1
                                var pred_neg: i64 = 0
                                if pp < TC && TK[pp as usize] == 18 { pred_neg = 1; pp = pp + 1 }
                                if pp < TC && TK[pp as usize] == 4 {
                                    var bv = TV[pp as usize]
                                    if pred_neg == 1 { bv = 0 - bv }
                                    SCAN_PRED_BOUND = bv
                                    SCAN_PRED_IS_F64 = 0
                                    SCAN_HAS_PRED = 1
                                    pp = pp + 1
                                }
                                if pp < TC && TK[pp as usize] == 53 {
                                    var fbv = TV[pp as usize]
                                    if pred_neg == 1 { fbv = fbv | 0 - 9223372036854775808 }  // flip sign bit
                                    // PR-7: capture fractional parts for rational comparison
                                    SCAN_PRED_BOUND_FRAC = TF[pp as usize]
                                    SCAN_PRED_BOUND_DENOM = TD[pp as usize]
                                    if SCAN_PRED_BOUND_DENOM == 0 { SCAN_PRED_BOUND_DENOM = 1 }
                                    SCAN_PRED_BOUND = fbv
                                    SCAN_PRED_IS_F64 = 1
                                    SCAN_HAS_PRED = 1
                                    pp = pp + 1
                                }
                                // PR-6: Check for || (31) or && (30) and parse second predicate
                                if SCAN_HAS_PRED == 1 && pp < TC && (TK[pp as usize] == 31 || TK[pp as usize] == 30) {
                                    SCAN_PRED_COMPOUND_IS_AND = 0
                                    if TK[pp as usize] == 30 { SCAN_PRED_COMPOUND_IS_AND = 1 }
                                    pp = pp + 1  // skip || or &&
                                    if pp < TC && TK[pp as usize] == 3 { pp = pp + 1 }  // skip var ident
                                    if pp < TC {
                                        let pred_op2 = TK[pp as usize]
                                        if pred_op2 == 26 || pred_op2 == 24 || pred_op2 == 25 || pred_op2 == 23 || pred_op2 == 21 || pred_op2 == 22 {
                                            SCAN_PRED_OP2 = pred_op2
                                            pp = pp + 1
                                            var pred_neg2: i64 = 0
                                            if pp < TC && TK[pp as usize] == 18 { pred_neg2 = 1; pp = pp + 1 }
                                            if pp < TC && TK[pp as usize] == 4 {
                                                var bv2 = TV[pp as usize]
                                                if pred_neg2 == 1 { bv2 = 0 - bv2 }
                                                SCAN_PRED_BOUND2 = bv2
                                                SCAN_PRED_IS_F64_2 = 0
                                                SCAN_HAS_PRED2 = 1
                                            }
                                            if pp < TC && TK[pp as usize] == 53 {
                                                var fbv2 = TV[pp as usize]
                                                if pred_neg2 == 1 { fbv2 = fbv2 | 0 - 9223372036854775808 }
                                                // PR-7: capture fractional parts for second bound
                                                SCAN_PRED_BOUND2_FRAC = TF[pp as usize]
                                                SCAN_PRED_BOUND2_DENOM = TD[pp as usize]
                                                if SCAN_PRED_BOUND2_DENOM == 0 { SCAN_PRED_BOUND2_DENOM = 1 }
                                                SCAN_PRED_BOUND2 = fbv2
                                                SCAN_PRED_IS_F64_2 = 1
                                                SCAN_HAS_PRED2 = 1
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        while rp < TC {
                            if TK[rp as usize] == 9 { break }
                            rp = rp + 1
                        }
                        if rp < TC { rp = rp + 1 }
                        SCAN_TY_NEXT = rp
                        return
                    }
                }
            }
        }
    }
    if TK[p as usize] == 44 { p = p + 1 }
    if TK[p as usize] == 32 { p = p + 1 }
    if TK[p as usize] == 1 {
        scan_fn_type_signature(p)
        return
    }
    if TK[p as usize] == 6 && TK[(p + 1) as usize] == 7 {
        SCAN_TY = 5
        SCAN_TY_NEXT = p + 2
        return
    }
    if TK[p as usize] == 41 {
        p = p + 1
        // Nested array type: [[T; N]; M] — recurse for inner element type
        if TK[p as usize] == 41 {
            scan_type(p)
            let inner_ty = SCAN_TY
            let inner_hash = SCAN_TY_HASH
            p = SCAN_TY_NEXT
            SCAN_TY = 8
            SCAN_TY_ESIZ = 8
            if TK[p as usize] == 27 { p = p + 1 }
            if TK[p as usize] == 4 { SCAN_TY_ALEN = TV[p as usize]; p = p + 1 }
            if TK[p as usize] == 42 { p = p + 1 }
            SCAN_TY_HASH = arr_ty_hash_with_elem(SCAN_TY_ALEN, SCAN_TY_ESIZ, inner_ty, inner_hash)
            SCAN_TY_NEXT = p
            return
        }
        // Knowledge<T> element: `[Knowledge[f64]; N]` / `[Knowledge<f64>; N]`. Recurse
        // scan_type so the kind=7 element hash is captured (the single-token path
        // below only handles simple names + registered structs).
        if src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "Knowledge")
           && (TK[(p + 1) as usize] == 41 || TK[(p + 1) as usize] == 23) {
            scan_type(p)
            let kelem_ty = SCAN_TY
            let kelem_hash = SCAN_TY_HASH
            p = SCAN_TY_NEXT
            SCAN_TY = 8
            SCAN_TY_ESIZ = 8
            if TK[p as usize] == 27 { p = p + 1 }
            if TK[p as usize] == 4 { SCAN_TY_ALEN = TV[p as usize]; p = p + 1 }
            if TK[p as usize] == 42 { p = p + 1 }
            SCAN_TY_HASH = arr_ty_hash_with_elem(SCAN_TY_ALEN, SCAN_TY_ESIZ, kelem_ty, kelem_hash)
            SCAN_TY_NEXT = p
            return
        }
        let ens = TS[p as usize]
        let ene = TE[p as usize]
        let elem_ty = type_name_kind(ens, ene)
        var elem_hash: i64 = 0
        if elem_ty == 6 || elem_ty == 7 { elem_hash = gl_name_hash(ens, ene) }
        SCAN_TY = 8
        if src_match(ens, ene - ens, "i8") {
            SCAN_TY_ESIZ = 1
        } else {
            SCAN_TY_ESIZ = 8
        }
        p = p + 1
        if TK[p as usize] == 27 { p = p + 1 }
        if TK[p as usize] == 4 {
            SCAN_TY_ALEN = TV[p as usize]
            p = p + 1
        }
        if TK[p as usize] == 42 { p = p + 1 }
        SCAN_TY_HASH = arr_ty_hash_for_elem_type(SCAN_TY_ALEN, SCAN_TY_ESIZ, elem_ty, elem_hash)
        SCAN_TY_NEXT = p
        return
    }
    if TK[p as usize] == 3 {
        // Multi-segment qualified type path (pkg::mod::Type) — same rationale
        // as the Bug A call-site fix (see compile_primary()): flatten a chain
        // of `::`-separated segments down to its terminal identifier before
        // any of the type-name resolution below, which only ever understands
        // a single bare identifier. Without this, the leading module-path
        // segments were treated as "the type name" (an unknown-type hash),
        // and the trailing `::segment`s were left unconsumed in the token
        // stream — which the function-signature arity scanner then misread
        // as extra phantom parameters, producing false arity mismatches at
        // every call site (issue #601 Bug B).
        while TK[p as usize] == 3 && TK[(p + 1) as usize] == 51 && TK[(p + 2) as usize] == 3 {
            p = p + 2  // skip segment + ::
        }
        let ns = TS[p as usize]
        let ne = TE[p as usize]
        var saw_generic: i64 = 0
        if src_match(ns, ne - ns, "chan") {
            SCAN_TY = 0
            SCAN_TY_HASH = 0
            p = p + 1
            if TK[p as usize] == 3 {
                SCAN_TY_HASH = gl_name_hash(TS[p as usize], TE[p as usize])
                p = p + 1
            }
            SCAN_TY_NEXT = p
            return
        }
        if src_match(ns, ne - ns, "i8") {
            SCAN_TY = 1
        } else {
            if src_match(ns, ne - ns, "u8") {
                SCAN_TY = 1
            } else {
            if src_match(ns, ne - ns, "i32") {
                SCAN_TY = 1
            } else {
                if src_match(ns, ne - ns, "u32") {
                    SCAN_TY = 1
                } else {
                    if src_match(ns, ne - ns, "i64") {
                        SCAN_TY = 1
                    } else {
                        if src_match(ns, ne - ns, "u64") {
                            SCAN_TY = 1
                        } else {
                            if src_match(ns, ne - ns, "usize") {
                                SCAN_TY = 1
                            } else {
                                if src_match(ns, ne - ns, "f32") {
                                    SCAN_TY = 2
                                } else {
                                    if src_match(ns, ne - ns, "f64") {
                                        SCAN_TY = 2
                                    } else {
                                        if src_match(ns, ne - ns, "str") {
                                            SCAN_TY = 3
                                        } else {
                                            if src_match(ns, ne - ns, "string") {
                                                SCAN_TY = 3
                                            } else {
                                                if src_match(ns, ne - ns, "bool") {
                                                    SCAN_TY = 4
                                                } else {
                                                    let h = gl_name_hash(ns, ne)
                                                    if st_find(h) >= 0 {
                                                        SCAN_TY = 6
                                                        SCAN_TY_HASH = h
                                                    } else {
                                                        if en_find(h) >= 0 {
                                                            SCAN_TY = 7
                                                            SCAN_TY_HASH = h
                                                        } else {
                                                            // PR-2: refinement type alias — resolve to base type + predicate
                                                            var ref_idx: i64 = -1
                                                            var ref_i: i64 = 0
                                                            while ref_i < REF_TYPE_COUNT {
                                                                if REF_TYPE_HASH[ref_i as usize] == h { ref_idx = ref_i; ref_i = REF_TYPE_COUNT }
                                                                ref_i = ref_i + 1
                                                            }
                                                            let ref_b = ref_idx * 10
                                                            // Resolve the alias when it has a real target. A Knowledge<T>
                                                            // alias (`type CrCl = Knowledge[f64]`) stores kind 0 with a
                                                            // (negative) Knowledge hash, so the `kind != 0` guard alone
                                                            // would drop it — leaving CrCl as the bare name hash and
                                                            // triggering a spurious ty_eq mismatch (P0003) at every binding.
                                                            if ref_idx >= 0 && (REF_TYPE_DATA[(ref_b + 0) as usize] != 0 || knowledge_hash_is(REF_TYPE_DATA[(ref_b + 1) as usize])) {
                                                                SCAN_TY = REF_TYPE_DATA[(ref_b + 0) as usize]
                                                                SCAN_TY_HASH = REF_TYPE_DATA[(ref_b + 1) as usize]
                                                                if REF_TYPE_DATA[(ref_b + 2) as usize] == 1 {
                                                                    SCAN_HAS_PRED = 1
                                                                    SCAN_PRED_OP = REF_TYPE_DATA[(ref_b + 3) as usize]
                                                                    SCAN_PRED_BOUND = REF_TYPE_DATA[(ref_b + 4) as usize]
                                                                    SCAN_PRED_IS_F64 = REF_TYPE_DATA[(ref_b + 5) as usize]
                                                                }
                                                                if REF_TYPE_DATA[(ref_b + 6) as usize] == 1 {
                                                                    SCAN_HAS_PRED2 = 1
                                                                    SCAN_PRED_OP2 = REF_TYPE_DATA[(ref_b + 7) as usize]
                                                                    SCAN_PRED_BOUND2 = REF_TYPE_DATA[(ref_b + 8) as usize]
                                                                    SCAN_PRED_IS_F64_2 = REF_TYPE_DATA[(ref_b + 9) as usize]
                                                                    // PR-6: propagate AND/OR conjunction flag from alias table
                                                                    SCAN_PRED_COMPOUND_IS_AND = REF_TYPE_IS_AND[ref_idx as usize]
                                                                }
                                                            } else {
                                                            // Unknown type name — leave as type 0 (unresolved)
                                                            // Type checker will skip errors for type-0 operands
                                                            SCAN_TY = 0
                                                            SCAN_TY_HASH = h
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            }
        }
        if src_match(ns, ne - ns, "f64") && TK[(p + 1) as usize] == 23 {
            p = p + 2
            scan_unit_type_expr(p, 24)
            if SCAN_UNIT_EXPR_NEXT < 0 {
                SCAN_TY = 2
                SCAN_TY_HASH = 0
                SCAN_TY_NEXT = p
                return
            }
            p = SCAN_UNIT_EXPR_NEXT
            if TK[p as usize] == 24 { p = p + 1 }
            else if TK[p as usize] == 39 {
                TK[p as usize] = 24
                TS[p as usize] = TS[p as usize] + 1
                p = p + 1
            }
            SCAN_TY = 2
            SCAN_TY_HASH = unit_type_hash_make(SCAN_UNIT_EXPR_DIM)
            SCAN_TY_NEXT = p
            return
        }
        // Option<T> → pointer-sized (tag + value); in struct fields, 2 qwords
        if src_match(ns, ne - ns, "Option") && TK[(p + 1) as usize] == 23 {
            p = p + 2
            scan_type(p)
            let inner_ty = SCAN_TY
            let inner_hash = SCAN_TY_HASH
            p = SCAN_TY_NEXT
            // Handle closing >: single > (24) or >> (39, both > consumed here — outer finds nothing)
            if TK[p as usize] == 24 { p = p + 1 }
            else if TK[p as usize] == 39 {
                // >> token: rewrite as > for idempotency, then advance past it entirely
                TK[p as usize] = 24
                TS[p as usize] = TS[p as usize] + 1
                p = p + 1
            }
            SCAN_TY = 11
            SCAN_TY_HASH = option_hash_make(inner_ty, inner_hash)
            SCAN_TY_NEXT = p
            return
        }
        // Box<T> → heap pointer (8 bytes); transparent wrapper
        if src_match(ns, ne - ns, "Box") && TK[(p + 1) as usize] == 23 {
            p = p + 2
            scan_type(p)
            let inner_ty = SCAN_TY
            let inner_hash = SCAN_TY_HASH
            p = SCAN_TY_NEXT
            // Handle closing >: single > (24) or >> (39, both > consumed here — outer finds nothing)
            if TK[p as usize] == 24 { p = p + 1 }
            else if TK[p as usize] == 39 {
                TK[p as usize] = 24
                TS[p as usize] = TS[p as usize] + 1
                p = p + 1
            }
            SCAN_TY = 11
            SCAN_TY_HASH = box_hash_make(inner_ty, inner_hash)
            SCAN_TY_NEXT = p
            return
        }
        if src_match(ns, ne - ns, "Unobserved") && TK[(p + 1) as usize] == 23 {
            p = p + 2
            scan_type(p)
            let inner_ty = SCAN_TY
            let inner_hash = SCAN_TY_HASH
            p = SCAN_TY_NEXT
            if TK[p as usize] == 24 { p = p + 1 }
            else if TK[p as usize] == 39 {
                TK[p as usize] = 24
                TS[p as usize] = TS[p as usize] + 1
                p = p + 1
            }
            SCAN_TY = 20
            SCAN_TY_HASH = unobserved_hash_make(inner_ty, inner_hash)
            SCAN_TY_NEXT = p
            return
        }
        if src_match(ns, ne - ns, "Knowledge") && (TK[(p + 1) as usize] == 23 || TK[(p + 1) as usize] == 41) {
            let open_tk = TK[(p + 1) as usize]
            var close_tk: i64 = 24
            if open_tk == 41 { close_tk = 42 }
            p = p + 2
            scan_type(p)
            let inner_ty = SCAN_TY
            let inner_hash = SCAN_TY_HASH
            var meta_mode: i64 = 0
            var eps_scaled: i64 = -1
            var invalid_eps: i64 = 0
            var saw_eps_meta: i64 = 0
            p = SCAN_TY_NEXT
            while TK[p as usize] == 28 {
                p = p + 1
                let meta_start = p
                if TK[p as usize] == 3 && src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "epsilon") {
                    if saw_eps_meta != 0 { invalid_eps = 1 }
                    saw_eps_meta = 1
                    p = p + 1
                    if TK[p as usize] == 23 {
                        p = p + 1
                        if TK[p as usize] == 4 || TK[p as usize] == 53 {
                            eps_scaled = tok_scaled_million(p)
                            if eps_scaled < 0 || eps_scaled > 1000000 { invalid_eps = 1 }
                            p = p + 1
                        } else {
                            invalid_eps = 1
                        }
                    } else {
                        invalid_eps = 1
                        p = skip_type_meta_item(meta_start, close_tk)
                    }
                } else if tok_is_unicode_epsilon(p) {
                    if saw_eps_meta != 0 { invalid_eps = 1 }
                    saw_eps_meta = 1
                    p = p + 1
                    if TK[p as usize] == 16 {
                        p = p + 1
                        if tok_is_unicode_bottom(p) {
                            meta_mode = 3
                            eps_scaled = -1
                            p = p + 1
                        } else {
                            if TK[p as usize] == 4 || TK[p as usize] == 53 {
                                meta_mode = 1
                                eps_scaled = tok_scaled_million(p)
                                if eps_scaled < 0 || eps_scaled > 1000000 { invalid_eps = 1 }
                                p = p + 1
                            } else {
                                invalid_eps = 1
                            }
                        }
                    } else {
                        if TK[p as usize] == 26 {
                            p = p + 1
                            meta_mode = 2
                            if TK[p as usize] == 4 || TK[p as usize] == 53 {
                                eps_scaled = tok_scaled_million(p)
                                if eps_scaled < 0 || eps_scaled > 1000000 { invalid_eps = 1 }
                                p = p + 1
                            } else {
                                invalid_eps = 1
                            }
                        } else {
                            invalid_eps = 1
                        }
                    }
                } else if TK[p as usize] == 3 && src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "ValidUntil") {
                    p = p + 1
                    if TK[p as usize] == 6 {
                        p = p + 1
                        if TK[p as usize] == 5 { p = p + 1 } else { invalid_eps = 1 }
                        if TK[p as usize] == 7 { p = p + 1 } else { invalid_eps = 1 }
                    } else {
                        invalid_eps = 1
                        p = skip_type_meta_item(meta_start, close_tk)
                    }
                } else if TK[p as usize] == 3 {
                    // Accept ignorable provenance/evidence tags like Derived.
                    p = p + 1
                } else {
                    invalid_eps = 1
                    p = skip_type_meta_item(meta_start, close_tk)
                }
            }
            if knowledge_hash_invalid(inner_hash) { invalid_eps = 1 }
            if TK[p as usize] == close_tk {
                p = p + 1
            } else if close_tk == 24 && TK[p as usize] == 39 {
                // '>>' closes this inner generic (e.g. Seq<Knowledge<f64>>); split the
                // token and leave a single '>' (24) for the enclosing type parser.
                TK[p as usize] = 24
                TS[p as usize] = TS[p as usize] + 1
                p = p + 1
            } else {
                invalid_eps = 1
                p = skip_type_meta_item(p, close_tk)
                if TK[p as usize] == close_tk { p = p + 1 }
            }
            SCAN_TY = 0
            if invalid_eps != 0 {
                SCAN_TY_HASH = knowledge_hash_make_mode(inner_ty, inner_hash, meta_mode, -2)
            } else {
                SCAN_TY_HASH = knowledge_hash_make_mode(inner_ty, inner_hash, meta_mode, eps_scaled)
            }
            SCAN_TY_NEXT = p
            return
        }
        // Seq<T> / Seq[T]: a heap-backed growable sequence (TY_SEQ = 12). Sibling
        // arm to Knowledge; reuses the same '<'/'>' (23/24) and '[' / ']' (41/42)
        // handling, including the '>>' (39) split for nested Seq<Seq<T>>. Falls
        // through untouched for any non-"Seq" type name (length-checked src_match),
        // so the self-compiling monolith — which uses no Seq — is unaffected.
        if src_match(ns, ne - ns, "Seq") && (TK[(p + 1) as usize] == 23 || TK[(p + 1) as usize] == 41) {
            let open_tk = TK[(p + 1) as usize]
            var close_tk: i64 = 24
            if open_tk == 41 { close_tk = 42 }
            p = p + 2
            scan_type(p)
            let inner_ty = SCAN_TY
            let inner_hash = SCAN_TY_HASH
            p = SCAN_TY_NEXT
            if TK[p as usize] == close_tk {
                p = p + 1
            } else if close_tk == 24 && TK[p as usize] == 39 {
                // '>>' closes one level here; leave the second '>' for the caller.
                TK[p as usize] = 24
                TS[p as usize] = TS[p as usize] + 1
                p = p + 1
            }
            SCAN_TY = 12
            SCAN_TY_HASH = seq_hash_make(inner_ty, inner_hash)
            SCAN_TY_NEXT = p
            return
        }
        p = p + 1
        if TK[p as usize] == 23 {
            saw_generic = 1
            var gd: i64 = 1
            p = p + 1
            while p < TC && gd > 0 {
                if TK[p as usize] == 23 { gd = gd + 1 }
                if TK[p as usize] == 24 { gd = gd - 1 }
                if TK[p as usize] == 39 { gd = gd - 2 }  // >> counts as two >
                p = p + 1
            }
        }
        // saw_generic: SCAN_TY_HASH already holds hash(base_name) from the unknown-type branch.
        // Do NOT re-hash across the <...> span — that produces a garbage key that never matches
        // any mono-mangled name. The call site (compile_primary) resolves the monomorphized
        // version via mono_find_inst using the base-name hash.
    }
    SCAN_TY_NEXT = p
}

// Build mangled name "name__mg_type" in SRC buffer, return (start, end).
// The separator must NOT be a bare "_": user code legitimately ships hand-
// monomorphized siblings named `<name>_<ty>` (e.g. cd_zero_exact_i64 next to
// generic cd_zero_exact), and a bare-underscore mangle makes the instantiation
// resolve to the wrong fn (arity mismatch across the whole bundle).
fn mono_mangle(ns: i64, ne: i64, ts: i64, te: i64) -> i64 with Mut, Panic {
    let start = SRC_LEN
    var i: i64 = 0
    while i < ne - ns { SRC[(SRC_LEN + i) as usize] = SRC[(ns + i) as usize]; i = i + 1 }
    SRC_LEN = SRC_LEN + (ne - ns)
    SRC[SRC_LEN as usize] = 95; SRC_LEN = SRC_LEN + 1
    SRC[SRC_LEN as usize] = 95; SRC_LEN = SRC_LEN + 1
    SRC[SRC_LEN as usize] = 109; SRC_LEN = SRC_LEN + 1
    SRC[SRC_LEN as usize] = 103; SRC_LEN = SRC_LEN + 1
    SRC[SRC_LEN as usize] = 95; SRC_LEN = SRC_LEN + 1
    i = 0
    while i < te - ts { SRC[(SRC_LEN + i) as usize] = SRC[(ts + i) as usize]; i = i + 1 }
    SRC_LEN = SRC_LEN + (te - ts)
    return start
}

// Check if instantiation pair (gen_idx, is_struct, type_s, type_e) already recorded
fn mono_find_inst(gi: i64, is_st: i64, tys: i64, tye: i64) -> i64 with Panic, Mut {
    var i: i64 = 0
    while i < MONO_COUNT {
        if MONO_GEN[i as usize] == gi && MONO_IS_ST[i as usize] == is_st {
            if name_eq(MONO_TY_S[i as usize], MONO_TY_E[i as usize], tys, tye) { return i }
        }
        i = i + 1
    }
    return -1
}

// Find-or-register a single-type-param struct specialization (gi = GEN_ST index,
// concrete type range [tys,tye) in SRC). Appends a struct mono if new; returns its
// MONO index, or -1 on capacity overflow. Used by the fn-instantiation rewrite loop
// to collapse `Struct<T>` references inside a generic fn body into `Struct_<ty>`.
fn mono_register_struct(gi: i64, tys: i64, tye: i64) -> i64 with Panic, Mut {
    let existing = mono_find_inst(gi, 1, tys, tye)
    if existing >= 0 { return existing }
    if MONO_COUNT >= 128 { return -1 }
    let mi = MONO_COUNT
    MONO_GEN[mi as usize] = gi
    MONO_TY_S[mi as usize] = tys
    MONO_TY_E[mi as usize] = tye
    MONO_TY2_S[mi as usize] = 0
    MONO_TY2_E[mi as usize] = 0
    MONO_IS_ST[mi as usize] = 1
    let ms = mono_mangle(GEN_ST_NS[gi as usize], GEN_ST_NE[gi as usize], tys, tye)
    MAN_BUF_S[mi as usize] = ms
    MAN_BUF_E[mi as usize] = SRC_LEN
    MONO_COUNT = MONO_COUNT + 1
    return mi
}

// Find-or-register a generic FN specialization discovered transitively inside a mono
// fn-body copy: a generic fn calling another generic fn via `callee::<F>(..)`. After
// the F->concrete substitution the emitted copy contains `callee::<i64>`, but Pass 0d
// only scans the pre-mono token range (generic bodies are skipped there), so the
// instance must be registered from the copy loop. The copy loop's `while m_i <
// MONO_COUNT` re-reads MONO_COUNT, so instances appended here are emitted later in
// the same loop (transitive closure; mono_find_inst dedups, so self-recursion
// terminates). Returns the MONO index, or -1 on capacity overflow.
fn mono_register_fn(gi: i64, tys: i64, tye: i64, ty2s: i64, ty2e: i64) -> i64 with Panic, Mut {
    let existing = mono_find_inst(gi, 0, tys, tye)
    if existing >= 0 { return existing }
    if MONO_COUNT >= 128 { return -1 }
    let mi = MONO_COUNT
    MONO_GEN[mi as usize] = gi
    MONO_TY_S[mi as usize] = tys
    MONO_TY_E[mi as usize] = tye
    MONO_TY2_S[mi as usize] = ty2s
    MONO_TY2_E[mi as usize] = ty2e
    MONO_IS_ST[mi as usize] = 0
    let ms = mono_mangle(GEN_FN_NS[gi as usize], GEN_FN_NE[gi as usize], tys, tye)
    MAN_BUF_S[mi as usize] = ms
    MAN_BUF_E[mi as usize] = SRC_LEN
    MONO_COUNT = MONO_COUNT + 1
    return mi
}

// For generic fn gi, find the index of the param whose type is directly T (not first).
// Scans param list starting from the > token. Returns that param index, or -1.
fn mono_t_param_idx(gi: i64) -> i64 with Panic, Mut {
    var sig: i64 = GEN_FN_BDY_S[gi as usize] + 3
    while sig < TC && TK[sig as usize] != 24 { sig = sig + 1 }
    // sig at >; check for > ( NAME : pattern
    if sig + 4 >= TC { return -1 }
    if TK[(sig + 1) as usize] != 6 { return -1 }
    if TK[(sig + 3) as usize] != 43 { return -1 }
    // If first param type is directly T, return -1 (caller handles it)
    if TK[(sig + 4) as usize] == 3 && name_eq(TS[(sig + 4) as usize], TE[(sig + 4) as usize], GEN_FN_TP_S[gi as usize], GEN_FN_TP_E[gi as usize]) { return -1 }
    // Scan params for one whose type is directly T
    var pp: i64 = sig + 2  // skip > and (
    var pi: i64 = 0
    while pp < TC && TK[pp as usize] != 7 {
        if TK[pp as usize] == 3 {
            pp = pp + 1
            if TK[pp as usize] == 43 {
                pp = pp + 1
                if TK[pp as usize] == 3 && name_eq(TS[pp as usize], TE[pp as usize], GEN_FN_TP_S[gi as usize], GEN_FN_TP_E[gi as usize]) {
                    return pi
                } else {
                    pp = skip_call_arg_expr(pp)
                }
            }
        }
        if TK[pp as usize] == 28 { pp = pp + 1; pi = pi + 1 }
        else { pp = pp + 1 }
    }
    return -1
}

// Given generic fn gi and call arg start position, infer instance index from the T-typed arg.
fn mono_infer_from_nth_arg(gi: i64, call_arg_start: i64) -> i64 with Panic, Mut {
    let t_pi = mono_t_param_idx(gi)
    if t_pi < 0 { return -1 }
    var ap: i64 = call_arg_start
    var ai: i64 = 0
    while ai < t_pi && ap < TC && TK[ap as usize] != 7 {
        ap = skip_call_arg_expr(ap)
        if TK[ap as usize] == 28 { ap = ap + 1 }
        ai = ai + 1
    }
    var inf_tys: i64 = 0
    var inf_tye: i64 = 0
    if TK[ap as usize] == 4  { inf_tys = INF_I64_S; inf_tye = INF_I64_E }
    if TK[ap as usize] == 53 { inf_tys = INF_F64_S; inf_tye = INF_F64_E }
    if inf_tys == 0 { return -1 }
    return mono_find_inst(gi, 0, inf_tys, inf_tye)
}

// ─── Lexer ───
fn lex_all() with IO, Mut, Panic, Div {
    TC = 0
    LEX_ERROR_LINE = 0
    LEX_ERROR_KIND = 0
    var p: i64 = 0
    var cur_line: i64 = 1
    while p < SRC_LEN && TC + 1 < token_capacity() {
        let c = sb(p)
        // Whitespace
        // File boundary marker \x01<path>\x02 — emit TK==77 and reset line counter
        if c == 1 {
            p = p + 1
            while p < SRC_LEN && sb(p) != 2 { p = p + 1 }
            if p < SRC_LEN { p = p + 1 }
            TK[TC as usize] = 77; TS[TC as usize] = p; TE[TC as usize] = p; TL[TC as usize] = cur_line; TC = TC + 1
            cur_line = 1
            continue
        }
        if c == 2 || c == 32 || c == 9 || c == 13 || c == 10 { if c == 10 { cur_line = cur_line + 1 }; p = p + 1; continue }
        // Line comment
        if c == 47 && p + 1 < SRC_LEN && sb(p + 1) == 47 {
            p = p + 2; while p < SRC_LEN && sb(p) != 10 { p = p + 1 }; continue
        }
        // String literal
        if c == 34 {
            let s = p; p = p + 1
            while p < SRC_LEN && sb(p) != 34 {
                let sc = sb(p)
                if sc == 10 { cur_line = cur_line + 1 }
                if sc == 92 {
                    if p + 1 >= SRC_LEN {
                        if LEX_ERROR_LINE == 0 {
                            LEX_ERROR_LINE = cur_line
                            LEX_ERROR_KIND = 2
                        }
                        p = p + 1
                        continue
                    }
                    let esc = sb(p + 1)
                    if esc == 120 && p + 3 < SRC_LEN {
                        let h1 = sb(p + 2)
                        let h2 = sb(p + 3)
                        var h1_ok: i64 = 0
                        if (h1 >= 48 && h1 <= 57) || (h1 >= 97 && h1 <= 102) || (h1 >= 65 && h1 <= 70) { h1_ok = 1 }
                        var h2_ok: i64 = 0
                        if (h2 >= 48 && h2 <= 57) || (h2 >= 97 && h2 <= 102) || (h2 >= 65 && h2 <= 70) { h2_ok = 1 }
                        if h1_ok == 1 && h2_ok == 1 {
                            p = p + 4
                            continue
                        }
                    }
                    if esc != 110 && esc != 116 && esc != 48 && esc != 92 && esc != 34 {
                        if LEX_ERROR_LINE == 0 {
                            LEX_ERROR_LINE = cur_line
                            LEX_ERROR_KIND = 2
                        }
                    }
                    if esc == 10 { cur_line = cur_line + 1 }
                    p = p + 2
                    continue
                }
                p = p + 1
            }
            if p < SRC_LEN && sb(p) == 34 { p = p + 1 }
            TK[TC as usize] = 5; TS[TC as usize] = s; TE[TC as usize] = p; TL[TC as usize] = cur_line; TC = TC + 1; continue
        }
        // Number (decimal or hex 0x...)
        if c >= 48 && c <= 57 {
            let s = p; var v: i64 = 0
            var frac: i64 = 0
            var denom: i64 = 1
            var is_float: i64 = 0
            var exp_sign: i64 = 1
            var exp_val: i64 = 0
            if c == 48 && p + 1 < SRC_LEN && (sb(p + 1) == 120 || sb(p + 1) == 88) {
                p = p + 2
                var hx: i64 = 1
                while p < SRC_LEN && hx == 1 {
                    let h = sb(p)
                    if h >= 48 && h <= 57 { v = v * 16 + h - 48; p = p + 1 }
                    else if h >= 97 && h <= 102 { v = v * 16 + h - 87; p = p + 1 }
                    else if h >= 65 && h <= 70 { v = v * 16 + h - 55; p = p + 1 }
                    else { hx = 0 }
                }
            } else {
                while p < SRC_LEN && sb(p) >= 48 && sb(p) <= 57 { v = v * 10 + sb(p) - 48; p = p + 1 }
            }
            // Check for float: digits.digits (dot followed by digit, not .field)
            // When integer part is zero, leading fractional zeros are absorbed
            // into a synthetic negative exponent rather than into denom — this
            // prevents `0.000…001` (24 zeros) from parsing as 0.0 because the
            // 18-digit frac/denom budget would otherwise be exhausted by zeros
            // before the significant digit is reached.
            var lit_leading_zeros: i64 = 0
            if p < SRC_LEN && sb(p) == 46 && p + 1 < SRC_LEN && sb(p + 1) >= 48 && sb(p + 1) <= 57 {
                is_float = 1
                p = p + 1  // skip .
                FL_FRAC_DIGITS = 0
                let int_zero: i64 = if v == 0 { 1 } else { 0 }
                var seen_nonzero: i64 = 0
                while p < SRC_LEN && sb(p) >= 48 && sb(p) <= 57 {
                    let d = sb(p) - 48
                    if int_zero == 1 && seen_nonzero == 0 && d == 0 {
                        lit_leading_zeros = lit_leading_zeros + 1
                    } else {
                        seen_nonzero = 1
                        if FL_FRAC_DIGITS < 18 {
                            frac = frac * 10 + d
                            denom = denom * 10
                            FL_FRAC_DIGITS = FL_FRAC_DIGITS + 1
                        }
                    }
                    p = p + 1
                }
            }
            // Scientific notation: digits(.digits)?e[+/-]digits
            if p < SRC_LEN && (sb(p) == 101 || sb(p) == 69) {
                var ep = p + 1
                var esign: i64 = 1
                if ep < SRC_LEN && sb(ep) == 43 { ep = ep + 1 }
                else if ep < SRC_LEN && sb(ep) == 45 { esign = 0 - 1; ep = ep + 1 }
                if ep < SRC_LEN && sb(ep) >= 48 && sb(ep) <= 57 {
                    is_float = 1
                    exp_sign = esign
                    p = ep
                    while p < SRC_LEN && sb(p) >= 48 && sb(p) <= 57 {
                        exp_val = exp_val * 10 + sb(p) - 48
                        p = p + 1
                    }
                }
            }
            // Gen 19: _suffix unit annotation on numeric literals (e.g. 500_mg, 9.8_m)
            var lit_unit_hash: i64 = 0
            if p < SRC_LEN && sb(p) == 95 && p + 1 < SRC_LEN && ((sb(p + 1) >= 65 && sb(p + 1) <= 90) || (sb(p + 1) >= 97 && sb(p + 1) <= 122)) {
                p = p + 1  // skip '_'
                let us = p
                while p < SRC_LEN && ((sb(p) >= 65 && sb(p) <= 90) || (sb(p) >= 97 && sb(p) <= 122) || (sb(p) >= 48 && sb(p) <= 57)) { p = p + 1 }
                lit_unit_hash = gl_name_hash(us, p)
            }
            if is_float == 1 {
                // Store mantissa parts without applying the exponent (avoids i64 overflow
                // for large exponents like 1.0e30). The signed exponent is stored in TX
                // and applied at codegen time via SSE2 multiply/divide. Leading zeros
                // absorbed during fractional-digit accumulation are folded into TX so
                // tiny literals like 1e-24 written as 0.000…001 don't truncate.
                TK[TC as usize] = 53; TS[TC as usize] = s; TE[TC as usize] = p
                TV[TC as usize] = v; TF[TC as usize] = frac; TD[TC as usize] = denom
                TX[TC as usize] = exp_sign * exp_val - lit_leading_zeros
                TU[TC as usize] = lit_unit_hash
                TL[TC as usize] = cur_line; TC = TC + 1; continue
            }
            TK[TC as usize] = 4; TS[TC as usize] = s; TE[TC as usize] = p; TV[TC as usize] = v
            TU[TC as usize] = lit_unit_hash
            TL[TC as usize] = cur_line; TC = TC + 1; continue
        }
        if c == 206 && p + 1 < SRC_LEN && sb(p + 1) == 181 {
            TK[TC as usize] = 3
            TS[TC as usize] = p
            TE[TC as usize] = p + 2
            TL[TC as usize] = cur_line
            TC = TC + 1
            p = p + 2
            continue
        }
        if c == 226 && p + 2 < SRC_LEN && sb(p + 1) == 138 && sb(p + 2) == 165 {
            TK[TC as usize] = 3
            TS[TC as usize] = p
            TE[TC as usize] = p + 3
            TL[TC as usize] = cur_line
            TC = TC + 1
            p = p + 3
            continue
        }
        // Identifier / keyword
        if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 {
            let s = p
            while p < SRC_LEN && ((sb(p) >= 65 && sb(p) <= 90) || (sb(p) >= 97 && sb(p) <= 122) || (sb(p) >= 48 && sb(p) <= 57) || sb(p) == 95) { p = p + 1 }
            let l = p - s
            var k: i64 = 3
            if src_match(s, l, "fn") { k = 1 }
            if src_match(s, l, "return") { k = 2 }
            if src_match(s, l, "let") { k = 11 }
            if src_match(s, l, "var") { k = 12 }
            if src_match(s, l, "if") { k = 13 }
            if src_match(s, l, "else") { k = 14 }
            if src_match(s, l, "while") { k = 15 }
            if src_match(s, l, "continue") { k = 33 }
            if src_match(s, l, "break") { k = 34 }
            if src_match(s, l, "for") { k = 54 }
            if src_match(s, l, "true") { k = 35 }
            if src_match(s, l, "false") { k = 36 }
            if src_match(s, l, "as") { k = 37 }
            if src_match(s, l, "with") { k = 38 }
            if src_match(s, l, "struct") { k = 46 }
            if src_match(s, l, "enum") { k = 47 }
            if src_match(s, l, "match") { k = 48 }
            if src_match(s, l, "pub") { k = 49 }
            if src_match(s, l, "linear") { k = 62 }
            if src_match(s, l, "affine") { k = 73 }
            if src_match(s, l, "type") { k = 61 }
            if src_match(s, l, "algebra") { k = 70 }
            if src_match(s, l, "study") { k = 71 }
            if src_match(s, l, "ontology") { k = 72 }
            if src_match(s, l, "trait") { k = 75 }
            if src_match(s, l, "impl") { k = 76 }
            // `unit` is a soft keyword: used for measurement-unit declarations
            // (`unit mg;`) at top level, but usable as an identifier elsewhere.
            // Detected by the stmt parser via string + lookahead, not by token kind.
            // Gen 20: Door 2 — `kernel` keyword (TK=79) for GPU kernel function declarations
            if src_match(s, l, "kernel") { k = 79 }
            if src_match(s, l, "Some") { k = 57 }
            if src_match(s, l, "None") { k = 58 }
            if src_match(s, l, "Ok") { k = 59 }
            if src_match(s, l, "Err") { k = 60 }
            TK[TC as usize] = k; TS[TC as usize] = s; TE[TC as usize] = p; TL[TC as usize] = cur_line; TC = TC + 1; continue
        }
        // Two-char operators
        if c == 45 && p + 1 < SRC_LEN && sb(p + 1) == 62 { TK[TC as usize] = 10; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        if c == 61 && p + 1 < SRC_LEN && sb(p + 1) == 61 { TK[TC as usize] = 21; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        if c == 33 && p + 1 < SRC_LEN && sb(p + 1) == 61 { TK[TC as usize] = 22; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        if c == 60 && p + 1 < SRC_LEN && sb(p + 1) == 61 { TK[TC as usize] = 25; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        if c == 62 && p + 1 < SRC_LEN && sb(p + 1) == 61 { TK[TC as usize] = 26; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        if c == 58 && p + 1 < SRC_LEN && sb(p + 1) == 58 { TK[TC as usize] = 51; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        if c == 61 && p + 1 < SRC_LEN && sb(p + 1) == 62 { TK[TC as usize] = 52; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        if c == 38 && p + 1 < SRC_LEN && sb(p + 1) == 38 { TK[TC as usize] = 30; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        if c == 124 && p + 1 < SRC_LEN && sb(p + 1) == 124 { TK[TC as usize] = 31; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        if c == 62 && p + 1 < SRC_LEN && sb(p + 1) == 62 { TK[TC as usize] = 39; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        if c == 60 && p + 1 < SRC_LEN && sb(p + 1) == 60 { TK[TC as usize] = 40; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        // Rust attribute rejection: #[
        if c == 35 && p + 1 < SRC_LEN && sb(p + 1) == 91 { tc_rust_attribute_lex(cur_line); p = p + 2; while p < SRC_LEN && sb(p) != 93 { if sb(p) == 10 { cur_line = cur_line + 1 }; p = p + 1 }; if p < SRC_LEN { p = p + 1 }; continue }
        // Single-char operators
        if c == 40 { TK[TC as usize] = 6; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 41 { TK[TC as usize] = 7; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 123 { TK[TC as usize] = 8; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 125 { TK[TC as usize] = 9; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 61 { TK[TC as usize] = 16; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 43 && p + 1 < SRC_LEN && sb(p + 1) == 43 { TK[TC as usize] = 74; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        if c == 43 { TK[TC as usize] = 17; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 45 { TK[TC as usize] = 18; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 42 { TK[TC as usize] = 19; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 47 { TK[TC as usize] = 20; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 37 { TK[TC as usize] = 29; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 60 { TK[TC as usize] = 23; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 62 { TK[TC as usize] = 24; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 59 { TK[TC as usize] = 27; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 44 { TK[TC as usize] = 28; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 33 { TK[TC as usize] = 32; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 91 { TK[TC as usize] = 41; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 93 { TK[TC as usize] = 42; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 58 { TK[TC as usize] = 43; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 38 { TK[TC as usize] = 44; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 124 { TK[TC as usize] = 45; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        // ..= range inclusive (3-char, check first)
        if c == 46 && p + 2 < SRC_LEN && sb(p + 1) == 46 && sb(p + 2) == 61 {
            TK[TC as usize] = 64
            TS[TC as usize] = p
            TE[TC as usize] = p + 3
            TL[TC as usize] = cur_line
            TC = TC + 1
            p = p + 3
            continue
        }
        // .. range exclusive (2-char)
        if c == 46 && p + 1 < SRC_LEN && sb(p + 1) == 46 {
            TK[TC as usize] = 63
            TS[TC as usize] = p
            TE[TC as usize] = p + 2
            TL[TC as usize] = cur_line
            TC = TC + 1
            p = p + 2
            continue
        }
        if c == 46 { TK[TC as usize] = 50; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 126 { TK[TC as usize] = 55; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 94 { TK[TC as usize] = 56; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        // ? — shorthand for Option<T> in type positions (TK=65)
        if c == 63 { TK[TC as usize] = 65; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c >= 128 && LEX_ERROR_LINE == 0 {
            LEX_ERROR_LINE = cur_line
            LEX_ERROR_KIND = 1
        }
        p = p + 1
    }
    TK[TC as usize] = 0; TL[TC as usize] = cur_line; TC = TC + 1
}

// ─── Variable lookup ───
fn var_find(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = VAR_COUNT - 1
    while i >= 0 {
        if name_eq(VAR_NS[i as usize], VAR_NE[i as usize], ns, ne) { return VAR_SLOT[i as usize] }
        i = i - 1
    }
    return -1
}

fn const_find_val(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = 0
    while i < CONST_COUNT {
        if name_eq(CONST_NS[i as usize], CONST_NE[i as usize], ns, ne) {
            CONST_FOUND_VAL = CONST_VAL[i as usize]
            CONST_FOUND_IDX = i
            return 1
        }
        i = i + 1
    }
    return 0
}

// ---- Compile-time folding of integer constant initializers (top-level let/const) ----
// Precedence (low -> high): `|`  <  `^`  <  `&`  <  `<<` `>>`  <  `+` `-`  <  `*` `/` `%`  <  unary `-`.
// Primaries: integer literal, parenthesised expression, a previously scanned integer constant.
// Outputs through globals in this file's style: CF_P = position after the expression,
// CF_OK = 0 if any token could not be folded (callers then keep the legacy behaviour).
var CF_P: i64 = 0
var CF_OK: i64 = 0
fn cfold_peek() -> i64 with Panic, Mut {
    if CF_P < TC { return TK[CF_P as usize] }
    return 0
}
fn cfold_primary() -> i64 with Panic, Mut, Div {
    let k = cfold_peek()
    if k == 4 { let v = TV[CF_P as usize]; CF_P = CF_P + 1; return v }
    if k == 18 { CF_P = CF_P + 1; let u = cfold_primary(); return 0 - u }
    if k == 6 {
        CF_P = CF_P + 1
        let v = cfold_bor()
        if cfold_peek() == 7 { CF_P = CF_P + 1 } else { CF_OK = 0 }
        return v
    }
    if k == 3 {
        if const_find_val(TS[CF_P as usize], TE[CF_P as usize]) != 0 && CONST_TYPE[CONST_FOUND_IDX as usize] == 1 {
            CF_P = CF_P + 1
            return CONST_FOUND_VAL
        }
    }
    CF_OK = 0
    return 0
}
fn cfold_mul() -> i64 with Panic, Mut, Div {
    var v = cfold_primary()
    while CF_OK != 0 {
        let k = cfold_peek()
        if k == 19 { CF_P = CF_P + 1; let r = cfold_primary(); v = v * r }
        else if k == 20 { CF_P = CF_P + 1; let r = cfold_primary(); if r == 0 { CF_OK = 0 } else { v = v / r } }
        else if k == 29 { CF_P = CF_P + 1; let r = cfold_primary(); if r == 0 { CF_OK = 0 } else { v = v % r } }
        else { break }
    }
    return v
}
fn cfold_add() -> i64 with Panic, Mut, Div {
    var v = cfold_mul()
    while CF_OK != 0 {
        let k = cfold_peek()
        if k == 17 { CF_P = CF_P + 1; let r = cfold_mul(); v = v + r }
        else if k == 18 { CF_P = CF_P + 1; let r = cfold_mul(); v = v - r }
        else { break }
    }
    return v
}
fn cfold_shift() -> i64 with Panic, Mut, Div {
    var v = cfold_add()
    while CF_OK != 0 {
        let k = cfold_peek()
        if k == 40 { CF_P = CF_P + 1; let r = cfold_add(); if r < 0 || r > 63 { CF_OK = 0 } else { v = v << r } }
        else if k == 39 { CF_P = CF_P + 1; let r = cfold_add(); if r < 0 || r > 63 { CF_OK = 0 } else { v = v >> r } }
        else { break }
    }
    return v
}
fn cfold_band() -> i64 with Panic, Mut, Div {
    var v = cfold_shift()
    while CF_OK != 0 && cfold_peek() == 44 { CF_P = CF_P + 1; let r = cfold_shift(); v = v & r }
    return v
}
fn cfold_bxor() -> i64 with Panic, Mut, Div {
    var v = cfold_band()
    while CF_OK != 0 && cfold_peek() == 56 { CF_P = CF_P + 1; let r = cfold_band(); v = v ^ r }
    return v
}
fn cfold_bor() -> i64 with Panic, Mut, Div {
    var v = cfold_bxor()
    while CF_OK != 0 && cfold_peek() == 45 { CF_P = CF_P + 1; let r = cfold_bxor(); v = v | r }
    return v
}
fn cfold_expr_at(p: i64) -> i64 with Panic, Mut, Div {
    CF_P = p
    CF_OK = 1
    let v = cfold_bor()
    return v
}

fn scan_all_consts() with Panic, Mut, Div {
    CONST_COUNT = 0
    var p: i64 = 0
    var cv: i64 = 0
    var neg_c: i64 = 0
    var cn_ns: i64 = 0
    var cn_ne: i64 = 0
    var depth: i64 = 0
    while p < TC {
        if TK[p as usize] == 8 { depth = depth + 1; p = p + 1; continue }
        if TK[p as usize] == 9 {
            if depth > 0 { depth = depth - 1 }
            p = p + 1
            continue
        }
        // top-level let NAME: TYPE = LITERAL
        if depth == 0 && TK[p as usize] == 11 {
            p = p + 1  // skip 'let'
            if TK[p as usize] != 3 { continue }
            if CONST_COUNT >= 4095 { p = p + 1; continue }
            cn_ns = TS[p as usize]; cn_ne = TE[p as usize]; p = p + 1
            var cty: i64 = 1
            var ctok: i64 = -1
            if TK[p as usize] == 15 {
                p = p + 1
                if TK[p as usize] == 3 && src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "f64") {
                    cty = 2
                }
                while p < TC && TK[p as usize] != 16 && TK[p as usize] != 0 { p = p + 1 }
            } else {
                while p < TC && TK[p as usize] != 16 && TK[p as usize] != 0 { p = p + 1 }
            }
            if TK[p as usize] == 16 { p = p + 1 }
            // Constant EXPRESSION initializer (`0 - 1`, `1 << 3`, `(A + 1) * 2`): fold it.
            // Before this, only `[-]LITERAL` was read and the rest of the expression was
            // silently dropped -- `let EG_INVALID: i64 = 0 - 1` became 0 in every source
            // build, so the small e-graph discarded its first node (id 0 == "invalid").
            // A bare literal still takes the original path below (cfold consumes 1 token).
            if TK[p as usize] == 4 || TK[p as usize] == 6 || (TK[p as usize] == 18 && TK[(p + 1) as usize] != 53)
                || (TK[p as usize] == 3 && const_find_val(TS[p as usize], TE[p as usize]) != 0) {
                let cfv = cfold_expr_at(p)
                // A bare literal (1 token) keeps the legacy path; an identifier alone or any
                // longer expression is the folder's (legacy recorded an identifier as 0).
                if CF_OK != 0 && (CF_P > p + 1 || TK[p as usize] == 3) {
                    CONST_NS[CONST_COUNT as usize] = cn_ns
                    CONST_NE[CONST_COUNT as usize] = cn_ne
                    CONST_VAL[CONST_COUNT as usize] = cfv
                    CONST_TYPE[CONST_COUNT as usize] = 1
                    CONST_TOK_IDX[CONST_COUNT as usize] = -1
                    CONST_COUNT = CONST_COUNT + 1
                    p = CF_P
                    continue
                }
            }
            cv = 0; neg_c = 0
            if TK[p as usize] == 18 { neg_c = 1; p = p + 1 }
            if TK[p as usize] == 4 { cv = TV[p as usize]; p = p + 1 }
            if TK[p as usize] == 53 { cty = 2; ctok = p; p = p + 1 }
            if neg_c != 0 { cv = 0 - cv }
            CONST_NS[CONST_COUNT as usize] = cn_ns
            CONST_NE[CONST_COUNT as usize] = cn_ne
            CONST_VAL[CONST_COUNT as usize] = cv
            CONST_TYPE[CONST_COUNT as usize] = cty
            CONST_TOK_IDX[CONST_COUNT as usize] = ctok
            CONST_COUNT = CONST_COUNT + 1
            continue
        }
        // bare 'const NAME: TYPE = VALUE'
        if depth == 0 && TK[p as usize] == 3 && src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "const") {
            p = p + 1  // skip 'const'
            if TK[p as usize] != 3 { continue }
            if CONST_COUNT >= 4095 { p = p + 1; continue }
            cn_ns = TS[p as usize]; cn_ne = TE[p as usize]; p = p + 1
            var cty2: i64 = 1
            var ctok2: i64 = -1
            if TK[p as usize] == 15 {
                p = p + 1
                if TK[p as usize] == 3 && src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "f64") {
                    cty2 = 2
                }
                while p < TC && TK[p as usize] != 16 && TK[p as usize] != 0 { p = p + 1 }
            } else {
                while p < TC && TK[p as usize] != 16 && TK[p as usize] != 0 { p = p + 1 }
            }
            if TK[p as usize] == 16 { p = p + 1 }
            // Constant EXPRESSION initializer (`0 - 1`, `1 << 3`, `(A + 1) * 2`): fold it.
            // Before this, only `[-]LITERAL` was read and the rest of the expression was
            // silently dropped -- `let EG_INVALID: i64 = 0 - 1` became 0 in every source
            // build, so the small e-graph discarded its first node (id 0 == "invalid").
            // A bare literal still takes the original path below (cfold consumes 1 token).
            if TK[p as usize] == 4 || TK[p as usize] == 6 || (TK[p as usize] == 18 && TK[(p + 1) as usize] != 53)
                || (TK[p as usize] == 3 && const_find_val(TS[p as usize], TE[p as usize]) != 0) {
                let cfv = cfold_expr_at(p)
                // A bare literal (1 token) keeps the legacy path; an identifier alone or any
                // longer expression is the folder's (legacy recorded an identifier as 0).
                if CF_OK != 0 && (CF_P > p + 1 || TK[p as usize] == 3) {
                    CONST_NS[CONST_COUNT as usize] = cn_ns
                    CONST_NE[CONST_COUNT as usize] = cn_ne
                    CONST_VAL[CONST_COUNT as usize] = cfv
                    CONST_TYPE[CONST_COUNT as usize] = 1
                    CONST_TOK_IDX[CONST_COUNT as usize] = -1
                    CONST_COUNT = CONST_COUNT + 1
                    p = CF_P
                    continue
                }
            }
            cv = 0; neg_c = 0
            if TK[p as usize] == 18 { neg_c = 1; p = p + 1 }
            if TK[p as usize] == 4 { cv = TV[p as usize]; p = p + 1 }
            if TK[p as usize] == 53 { cty2 = 2; ctok2 = p; p = p + 1 }
            if neg_c != 0 { cv = 0 - cv }
            CONST_NS[CONST_COUNT as usize] = cn_ns
            CONST_NE[CONST_COUNT as usize] = cn_ne
            CONST_VAL[CONST_COUNT as usize] = cv
            CONST_TYPE[CONST_COUNT as usize] = cty2
            CONST_TOK_IDX[CONST_COUNT as usize] = ctok2
            CONST_COUNT = CONST_COUNT + 1
            continue
        }
        if TK[p as usize] != 49 { p = p + 1; continue }
        p = p + 1  // skip 'pub'
        if TK[p as usize] != 3 { continue }
        // pub let NAME: TYPE = VALUE
        if src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "let") {
            p = p + 1  // skip 'let'
            if TK[p as usize] != 3 { continue }
            if CONST_COUNT >= 4095 { p = p + 1; continue }
            cn_ns = TS[p as usize]; cn_ne = TE[p as usize]; p = p + 1
            var cty4: i64 = 1
            var ctok4: i64 = -1
            if TK[p as usize] == 15 {
                p = p + 1
                if TK[p as usize] == 3 && src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "f64") {
                    cty4 = 2
                }
                while p < TC && TK[p as usize] != 16 && TK[p as usize] != 0 { p = p + 1 }
            } else {
                while p < TC && TK[p as usize] != 16 && TK[p as usize] != 0 { p = p + 1 }
            }
            if TK[p as usize] == 16 { p = p + 1 }
            // Constant EXPRESSION initializer (`0 - 1`, `1 << 3`, `(A + 1) * 2`): fold it.
            // Before this, only `[-]LITERAL` was read and the rest of the expression was
            // silently dropped -- `let EG_INVALID: i64 = 0 - 1` became 0 in every source
            // build, so the small e-graph discarded its first node (id 0 == "invalid").
            // A bare literal still takes the original path below (cfold consumes 1 token).
            if TK[p as usize] == 4 || TK[p as usize] == 6 || (TK[p as usize] == 18 && TK[(p + 1) as usize] != 53)
                || (TK[p as usize] == 3 && const_find_val(TS[p as usize], TE[p as usize]) != 0) {
                let cfv = cfold_expr_at(p)
                // A bare literal (1 token) keeps the legacy path; an identifier alone or any
                // longer expression is the folder's (legacy recorded an identifier as 0).
                if CF_OK != 0 && (CF_P > p + 1 || TK[p as usize] == 3) {
                    CONST_NS[CONST_COUNT as usize] = cn_ns
                    CONST_NE[CONST_COUNT as usize] = cn_ne
                    CONST_VAL[CONST_COUNT as usize] = cfv
                    CONST_TYPE[CONST_COUNT as usize] = 1
                    CONST_TOK_IDX[CONST_COUNT as usize] = -1
                    CONST_COUNT = CONST_COUNT + 1
                    p = CF_P
                    continue
                }
            }
            cv = 0; neg_c = 0
            if TK[p as usize] == 18 { neg_c = 1; p = p + 1 }
            if TK[p as usize] == 4 { cv = TV[p as usize]; p = p + 1 }
            if TK[p as usize] == 53 { cty4 = 2; ctok4 = p; p = p + 1 }
            if neg_c != 0 { cv = 0 - cv }
            CONST_NS[CONST_COUNT as usize] = cn_ns
            CONST_NE[CONST_COUNT as usize] = cn_ne
            CONST_VAL[CONST_COUNT as usize] = cv
            CONST_TYPE[CONST_COUNT as usize] = cty4
            CONST_TOK_IDX[CONST_COUNT as usize] = ctok4
            CONST_COUNT = CONST_COUNT + 1
            continue
        }
        if src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "const") == false { continue }
        p = p + 1  // skip 'const'
        if TK[p as usize] != 3 { continue }
        if CONST_COUNT >= 4095 { p = p + 1; continue }
        cn_ns = TS[p as usize]; cn_ne = TE[p as usize]; p = p + 1
        var cty3: i64 = 1
        var ctok3: i64 = -1
        if TK[p as usize] == 15 {
            p = p + 1
            if TK[p as usize] == 3 && src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "f64") {
                cty3 = 2
            }
            while p < TC && TK[p as usize] != 16 && TK[p as usize] != 0 { p = p + 1 }
        } else {
            while p < TC && TK[p as usize] != 16 && TK[p as usize] != 0 { p = p + 1 }
        }
        if TK[p as usize] == 16 { p = p + 1 }
        cv = 0; neg_c = 0
        if TK[p as usize] == 18 { neg_c = 1; p = p + 1 }
        if TK[p as usize] == 4 { cv = TV[p as usize]; p = p + 1 }
        if TK[p as usize] == 53 { cty3 = 2; ctok3 = p; p = p + 1 }
        if neg_c != 0 { cv = 0 - cv }
        CONST_NS[CONST_COUNT as usize] = cn_ns
        CONST_NE[CONST_COUNT as usize] = cn_ne
        CONST_VAL[CONST_COUNT as usize] = cv
        CONST_TYPE[CONST_COUNT as usize] = cty3
        CONST_TOK_IDX[CONST_COUNT as usize] = ctok3
        CONST_COUNT = CONST_COUNT + 1
    }
}

fn ont_find_class(ns: i64, ne: i64) -> bool with Mut, Panic {
    var i: i64 = 0
    while i < ONT_CLASS_COUNT {
        if name_eq(ns, ne, ONT_CLS_S[i as usize], ONT_CLASS_E[i as usize]) { return true }
        i = i + 1
    }
    return false
}

fn ont_find_role(ns: i64, ne: i64) -> bool with Mut, Panic {
    var i: i64 = 0
    while i < ONT_ROLE_COUNT {
        if name_eq(ns, ne, ONT_ROLE_S[i as usize], ONT_ROLE_E[i as usize]) { return true }
        i = i + 1
    }
    return false
}

fn ont_error(tok: i64, code: i64, msg: string) with IO, Mut, Panic {
    print("error[E")
    if code < 100 { print("0") }
    if code < 10 { print("0") }
    print_int(code)
    print("] at line ")
    print_int(TL[tok as usize])
    print(": ")
    print(msg)
    print("\n")
    tc_mark_failed()
}

fn ont_find_class_by_hash(h: i64) -> i64 with Mut, Panic {
    var i: i64 = 0
    while i < ONT_CLASS_COUNT {
        if ONT_CLASS_HASH[i as usize] == h { return i }
        i = i + 1
    }
    return -1
}

fn ont_materialize_kernel() with Mut, Panic {
    // Set reflexive closure
    var i: i64 = 0
    while i < ONT_CLASS_COUNT {
        ONT_SUB_MATRIX[(i * 64 + i) as usize] = 1
        i = i + 1
    }
    // Floyd-Warshall transitive closure on subclass matrix
    var k: i64 = 0
    while k < ONT_CLASS_COUNT {
        var ii: i64 = 0
        while ii < ONT_CLASS_COUNT {
            var j: i64 = 0
            while j < ONT_CLASS_COUNT {
                if ONT_SUB_MATRIX[(ii * 64 + k) as usize] != 0 && ONT_SUB_MATRIX[(k * 64 + j) as usize] != 0 {
                    ONT_SUB_MATRIX[(ii * 64 + j) as usize] = 1
                }
                j = j + 1
            }
            ii = ii + 1
        }
        k = k + 1
    }
    // Propagate disjoint through subclass hierarchy (single pass, closure already complete)
    var a: i64 = 0
    while a < ONT_CLASS_COUNT {
        var b: i64 = 0
        while b < ONT_CLASS_COUNT {
            if ONT_DIS_MATRIX[(a * 64 + b) as usize] != 0 {
                var x: i64 = 0
                while x < ONT_CLASS_COUNT {
                    if ONT_SUB_MATRIX[(x * 64 + a) as usize] != 0 {
                        ONT_DIS_MATRIX[(x * 64 + b) as usize] = 1
                        ONT_DIS_MATRIX[(b * 64 + x) as usize] = 1
                    }
                    if ONT_SUB_MATRIX[(x * 64 + b) as usize] != 0 {
                        ONT_DIS_MATRIX[(a * 64 + x) as usize] = 1
                        ONT_DIS_MATRIX[(x * 64 + a) as usize] = 1
                    }
                    x = x + 1
                }
            }
            b = b + 1
        }
        a = a + 1
    }
}

fn try_tc_ontology_call_error(tok: i64, param_hash: i64, arg_hash: i64) -> i64 with IO, Mut, Panic {
    if param_hash == 0 || arg_hash == 0 { return 0 }
    let pi = ont_find_class_by_hash(param_hash)
    let ai = ont_find_class_by_hash(arg_hash)
    if pi < 0 || ai < 0 { return 0 }
    if pi == ai { return 2 }
    if ONT_DIS_MATRIX[(ai * 64 + pi) as usize] != 0 {
        ont_error(tok, 151, "ontology classes are disjoint and cannot be substituted")
        return 1
    }
    if ONT_SUB_MATRIX[(ai * 64 + pi) as usize] != 0 { return 2 }
    ont_error(tok, 152, "cannot prove ontology subsumption at this call site")
    return 1
}

// Parse property declarations inside a class body { ... }, recording constraints.
// ci = class index, p0 = token after '{', body_end = token of closing '}'.
// Returns token position after consuming the class body (past '}').
fn ont_parse_class_body_props(ci: i64, p0: i64, body_end: i64) -> i64 with IO, Mut, Panic {
    var pp: i64 = p0
    while pp < body_end && TK[pp as usize] != 9 {
        if TK[pp as usize] != 3 { pp = pp + 1; continue }
        let kw_s = TS[pp as usize]
        let kw_l = TE[pp as usize] - TS[pp as usize]
        if src_match(kw_s, kw_l, "property") == false { pp = pp + 1; continue }
        pp = pp + 1  // skip "property"
        if pp >= body_end || TK[pp as usize] != 3 { continue }
        let prop_hash = gl_name_hash(TS[pp as usize], TE[pp as usize])
        pp = pp + 1  // skip property name
        // skip ": type"
        if pp < body_end && TK[pp as usize] == 43 {
            pp = pp + 1  // skip ':'
            if pp < body_end && TK[pp as usize] == 3 { pp = pp + 1 }  // skip type name
        }
        // look for "where"
        if pp >= body_end || TK[pp as usize] != 3 { continue }
        if src_match(TS[pp as usize], TE[pp as usize] - TS[pp as usize], "where") == false { continue }
        pp = pp + 1  // skip "where"
        if pp >= body_end || TK[pp as usize] != 3 { continue }
        pp = pp + 1  // skip property name in predicate
        if pp >= body_end { continue }
        var prop_dir: i64 = 0
        if TK[pp as usize] == 26 { prop_dir = 0; pp = pp + 1 }       // >=
        else if TK[pp as usize] == 25 { prop_dir = 1; pp = pp + 1 }  // <=
        else { continue }
        // read optional negation and numeric value
        var prop_neg: i64 = 0
        if pp < body_end && TK[pp as usize] == 18 { prop_neg = 1; pp = pp + 1 }
        var prop_int_val: i64 = 0
        var prop_frac_val: i64 = 0
        var prop_denom: i64 = 1
        if pp < body_end && TK[pp as usize] == 4 {
            prop_int_val = TV[pp as usize]
            pp = pp + 1
        } else if pp < body_end && TK[pp as usize] == 53 {
            prop_int_val = TV[pp as usize]
            prop_frac_val = TF[pp as usize]
            prop_denom = TD[pp as usize]
            if prop_denom == 0 { prop_denom = 1 }
            pp = pp + 1
        } else { continue }
        // Compute signed bound ×1000
        var bound: i64 = prop_int_val * 1000 + prop_frac_val * 1000 / prop_denom
        if prop_neg != 0 { bound = 0 - bound }
        // Store
        if ONT_PROP_CNT < 256 {
            ONT_PROP_CLS[ONT_PROP_CNT as usize] = ci
            ONT_PROP_NHASH[ONT_PROP_CNT as usize] = prop_hash
            ONT_PROP_BOUND[ONT_PROP_CNT as usize] = bound
            ONT_PROP_DIR[ONT_PROP_CNT as usize] = prop_dir
            ONT_PROP_CNT = ONT_PROP_CNT + 1
        }
    }
    // skip past closing '}'
    if pp < TC && TK[pp as usize] == 9 { pp = pp + 1 }
    return pp
}

// After ONT_SUB_MATRIX is built, check that every subclass relationship
// respects property constraint subsumption: child constraints must imply parent.
fn ont_check_prop_subsumption(ont_tok: i64) with IO, Mut, Panic {
    var ci: i64 = 0
    while ci < ONT_CLASS_COUNT {
        var pi: i64 = 0
        while pi < ONT_CLASS_COUNT {
            if ci != pi && ONT_SUB_MATRIX[(ci * 64 + pi) as usize] != 0 {
                // ci is a subclass of pi; check all pi's properties appear in ci with tighter constraints
                var j: i64 = 0
                while j < ONT_PROP_CNT {
                    if ONT_PROP_CLS[j as usize] == pi {
                        let par_hash = ONT_PROP_NHASH[j as usize]
                        let par_bound = ONT_PROP_BOUND[j as usize]
                        let par_dir = ONT_PROP_DIR[j as usize]
                        // find matching property in child ci
                        var k: i64 = 0
                        var found: i64 = 0
                        while k < ONT_PROP_CNT {
                            if ONT_PROP_CLS[k as usize] == ci && ONT_PROP_NHASH[k as usize] == par_hash {
                                let child_bound = ONT_PROP_BOUND[k as usize]
                                let child_dir = ONT_PROP_DIR[k as usize]
                                found = 1
                                // Check: child bound implies parent bound
                                // For >=: child_bound >= par_bound required (tighter lower bound)
                                // For <=: child_bound <= par_bound required (tighter upper bound)
                                var ok: i64 = 1
                                if par_dir == 0 && child_dir == 0 {
                                    if child_bound < par_bound { ok = 0 }
                                } else if par_dir == 1 && child_dir == 1 {
                                    if child_bound > par_bound { ok = 0 }
                                } else {
                                    ok = 0
                                }
                                if ok == 0 {
                                    ont_error(ont_tok, 160, "ontology subsumption could not be verified: child property constraint weakens parent")
                                }
                            }
                            k = k + 1
                        }
                    }
                    j = j + 1
                }
            }
            pi = pi + 1
        }
        ci = ci + 1
    }
}

fn skip_ontology_decl(p0: i64) -> i64 with IO, Mut, Panic {
    var p = p0 + 1  // skip 'ontology'
    let ont_tok = p0

    // Reset subclass/disjoint matrices from previous block
    var zi: i64 = 0
    while zi < ONT_CLASS_COUNT * 64 {
        ONT_SUB_MATRIX[zi as usize] = 0
        ONT_DIS_MATRIX[zi as usize] = 0
        zi = zi + 1
    }

    // Reset per-block tracking
    ONT_CLASS_COUNT = 0
    ONT_ROLE_COUNT = 0
    ONT_PROP_CNT = 0

    if p < TC && TK[p as usize] == 3 { p = p + 1 }  // skip name

    // Find opening brace
    while p < TC && TK[p as usize] != 8 && TK[p as usize] != 0 { p = p + 1 }
    if p >= TC || TK[p as usize] != 8 { return p }
    p = p + 1  // skip {
    let body_start = p

    // --- Pass 1: collect class/role names and store class hashes ---
    while p < TC && TK[p as usize] != 9 {
        if TK[p as usize] != 3 { p = p + 1; continue }
        let kw_s = TS[p as usize]
        let kw_l = TE[p as usize] - TS[p as usize]

        // "class" = 5 chars
        if src_match(kw_s, kw_l, "class") {
            p = p + 1  // skip "class"
            if p < TC && TK[p as usize] == 3 {
                if ONT_CLASS_COUNT < 64 {
                    ONT_CLS_S[ONT_CLASS_COUNT as usize] = TS[p as usize]
                    ONT_CLASS_E[ONT_CLASS_COUNT as usize] = TE[p as usize]
                    ONT_CLASS_HASH[ONT_CLASS_COUNT as usize] = gl_name_hash(TS[p as usize], TE[p as usize])
                    ONT_CLASS_COUNT = ONT_CLASS_COUNT + 1
                }
                p = p + 1  // skip class name
            }
            // Skip subclass_of clause (stop at declaration keywords to avoid over-advance)
            if p < TC && TK[p as usize] == 3 && src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "subclass_of") {
                p = p + 1  // skip "subclass_of"
                while p < TC && (TK[p as usize] == 3 || TK[p as usize] == 28) {
                    if TK[p as usize] == 3 {
                        let skip_l = TE[p as usize] - TS[p as usize]
                        if src_match(TS[p as usize], skip_l, "class") { break }
                        if src_match(TS[p as usize], skip_l, "disjoint") { break }
                        if src_match(TS[p as usize], skip_l, "role") { break }
                        if src_match(TS[p as usize], skip_l, "subclass_of") { break }
                    }
                    p = p + 1
                }
            }
            if p < TC && TK[p as usize] == 8 {
                // Skip nested { property ... } block
                var depth: i64 = 1
                p = p + 1
                while p < TC && depth > 0 {
                    if TK[p as usize] == 8 { depth = depth + 1 }
                    if TK[p as usize] == 9 { depth = depth - 1 }
                    p = p + 1
                }
            }
            continue
        }

        // "disjoint" = 8 chars
        if src_match(kw_s, kw_l, "disjoint") {
            p = p + 1  // skip "disjoint"
            // skip comma-separated names
            while p < TC && (TK[p as usize] == 3 || TK[p as usize] == 28) { p = p + 1 }
            continue
        }

        // "role" = 4 chars
        if src_match(kw_s, kw_l, "role") {
            let role_tok = p
            p = p + 1  // skip "role"
            if p >= TC || TK[p as usize] != 3 { continue }

            let rn_s = TS[p as usize]
            let rn_e = TE[p as usize]

            // Check duplicate role
            if ont_find_role(rn_s, rn_e) {
                ont_error(role_tok, 159, "duplicate role declaration")
            }

            // Register role
            if ONT_ROLE_COUNT < 32 {
                ONT_ROLE_S[ONT_ROLE_COUNT as usize] = rn_s
                ONT_ROLE_E[ONT_ROLE_COUNT as usize] = rn_e
                ONT_ROLE_COUNT = ONT_ROLE_COUNT + 1
            }
            p = p + 1  // skip role name

            // Parse role modifiers: domain, range, inverse_of, transitive, etc.
            while p < TC && TK[p as usize] == 3 {
                let mod_s = TS[p as usize]
                let mod_l = TE[p as usize] - TS[p as usize]

                if src_match(mod_s, mod_l, "domain") {
                    p = p + 1  // skip "domain"
                    if p < TC && TK[p as usize] == 3 {
                        if !ont_find_class(TS[p as usize], TE[p as usize]) {
                            ont_error(p, 156, "role domain class not found in ontology")
                        }
                        p = p + 1
                    }
                } else if src_match(mod_s, mod_l, "range") {
                    p = p + 1  // skip "range"
                    if p < TC && TK[p as usize] == 3 {
                        if !ont_find_class(TS[p as usize], TE[p as usize]) {
                            ont_error(p, 157, "role range class not found in ontology")
                        }
                        p = p + 1
                    }
                } else if src_match(mod_s, mod_l, "inverse_of") {
                    p = p + 1  // skip "inverse_of"
                    if p < TC && TK[p as usize] == 3 {
                        if !ont_find_role(TS[p as usize], TE[p as usize]) {
                            ont_error(p, 158, "inverse_of target role not found")
                        }
                        p = p + 1
                    }
                } else if src_match(mod_s, mod_l, "transitive") || src_match(mod_s, mod_l, "functional") || src_match(mod_s, mod_l, "symmetric") {
                    p = p + 1
                } else {
                    break
                }
            }
            continue
        }

        // Unknown keyword in ontology block — skip
        p = p + 1
    }
    let body_end = p

    // --- Pass 2: build subclass/disjoint relationship matrices ---
    p = body_start
    while p < TC && p < body_end && TK[p as usize] != 9 {
        if TK[p as usize] != 3 { p = p + 1; continue }
        let kw_s2 = TS[p as usize]
        let kw_l2 = TE[p as usize] - TS[p as usize]

        if src_match(kw_s2, kw_l2, "class") {
            p = p + 1  // skip "class"
            if p >= body_end || TK[p as usize] != 3 { continue }
            let cn_h = gl_name_hash(TS[p as usize], TE[p as usize])
            let ci = ont_find_class_by_hash(cn_h)
            p = p + 1  // skip class name
            // Handle subclass_of relationships
            if p < body_end && TK[p as usize] == 3 && src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "subclass_of") {
                p = p + 1  // skip "subclass_of"
                while p < body_end && (TK[p as usize] == 3 || TK[p as usize] == 28) {
                    if TK[p as usize] == 3 {
                        let tsn_l = TE[p as usize] - TS[p as usize]
                        if src_match(TS[p as usize], tsn_l, "class") { break }
                        if src_match(TS[p as usize], tsn_l, "disjoint") { break }
                        if src_match(TS[p as usize], tsn_l, "role") { break }
                        if src_match(TS[p as usize], tsn_l, "subclass_of") { break }
                        let sn_h = gl_name_hash(TS[p as usize], TE[p as usize])
                        let si = ont_find_class_by_hash(sn_h)
                        if ci >= 0 && si >= 0 {
                            ONT_SUB_MATRIX[(ci * 64 + si) as usize] = 1
                        }
                    }
                    p = p + 1
                }
            }
            // Parse class body { property ... } for constraint tracking
            if p < body_end && TK[p as usize] == 8 {
                let body_inner = p + 1
                p = ont_parse_class_body_props(ci, body_inner, body_end)
            }
            continue
        }

        if src_match(kw_s2, kw_l2, "disjoint") {
            p = p + 1  // skip "disjoint"
            ONT_DIS_TMP_CNT = 0
            while p < body_end && (TK[p as usize] == 3 || TK[p as usize] == 28) {
                if TK[p as usize] == 3 {
                    let tsn_l = TE[p as usize] - TS[p as usize]
                    if src_match(TS[p as usize], tsn_l, "class") { break }
                    if src_match(TS[p as usize], tsn_l, "disjoint") { break }
                    if src_match(TS[p as usize], tsn_l, "role") { break }
                    if src_match(TS[p as usize], tsn_l, "subclass_of") { break }
                    let dh = gl_name_hash(TS[p as usize], TE[p as usize])
                    let di = ont_find_class_by_hash(dh)
                    if di >= 0 && ONT_DIS_TMP_CNT < 64 {
                        ONT_DIS_TMP[ONT_DIS_TMP_CNT as usize] = di
                        ONT_DIS_TMP_CNT = ONT_DIS_TMP_CNT + 1
                    }
                }
                p = p + 1
            }
            var dii: i64 = 0
            while dii < ONT_DIS_TMP_CNT {
                var djj: i64 = dii + 1
                while djj < ONT_DIS_TMP_CNT {
                    let da = ONT_DIS_TMP[dii as usize]
                    let db = ONT_DIS_TMP[djj as usize]
                    ONT_DIS_MATRIX[(da * 64 + db) as usize] = 1
                    ONT_DIS_MATRIX[(db * 64 + da) as usize] = 1
                    djj = djj + 1
                }
                dii = dii + 1
            }
            continue
        }

        // Skip roles and other keywords token-by-token
        p = p + 1
    }

    // Compute transitive closure + propagate disjoint through subclass hierarchy
    ont_materialize_kernel()

    // Check property constraint subsumption for all subclass relationships
    ont_check_prop_subsumption(ont_tok)

    // Skip closing }
    if body_end < TC && TK[body_end as usize] == 9 { return body_end + 1 }
    return body_end
}

// Global: count of hypotheses in current compilation (for provenance metadata)
var STUDY_HYPO_COUNT: i64 = 0

fn skip_study_decl(p0: i64) -> i64 with IO, Mut, Panic {
    let study_tok = p0
    var p = p0 + 1
    var depth: i64 = 0
    var saw_hypothesis: i64 = 0

    while p < TC && TK[p as usize] != 8 && TK[p as usize] != 0 { p = p + 1 }
    if p >= TC || TK[p as usize] != 8 {
        return p
    }

    depth = 1
    p = p + 1
    while p < TC && depth > 0 {
        if TK[p as usize] == 3 && src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "hypothesis") {
            saw_hypothesis = 1
            STUDY_HYPO_COUNT = STUDY_HYPO_COUNT + 1
        }
        // Mark fn definitions inside study blocks with Hypothesis effect (bit 256)
        // by injecting the effect bit when the function scanner encounters them.
        // (The actual injection happens via CURRENT_STUDY_EFFECT in the fn scanner.)
        if TK[p as usize] == 8 {
            depth = depth + 1
        } else if TK[p as usize] == 9 {
            depth = depth - 1
        }
        p = p + 1
    }

    if saw_hypothesis == 0 {
        tc_mark_failed()
        print("error[E211]: study block requires at least one hypothesis at line ")
        print_int(TL[study_tok as usize])
        print("\n")
    }

    p
}

fn local_meta_add(
    ns: i64,
    ne: i64,
    slot: i64,
    len_slot: i64,
    alen: i64,
    esiz: i64,
    is_f64: i64,
    is_closure: i64,
    is_mut: i64,
    unit_hash: i64,
    is_linear: i64,
    used: i64,
    ty: i64,
    ty_hash: i64
) -> i64 with Mut, Panic {
    if VAR_COUNT >= local_cap() {
        note_limit_error(1)
        return -1
    }
    let idx = VAR_COUNT
    VAR_NS[idx as usize] = ns
    VAR_NE[idx as usize] = ne
    VAR_SLOT[idx as usize] = slot
    VAR_LEN_SLOT[idx as usize] = len_slot
    VAR_ALEN[idx as usize] = alen
    VAR_ESIZ[idx as usize] = esiz
    VAR_IS_F64[idx as usize] = is_f64
    VAR_IS_CLOSURE[idx as usize] = is_closure
    VAR_MUT[idx as usize] = is_mut
    VAR_UNIT[idx as usize] = unit_hash
    VAR_LINEAR[idx as usize] = is_linear
    VAR_AFFINE[idx as usize] = 0
    VAR_MOVED[idx as usize] = 0
    VAR_BORROW_COUNT[idx as usize] = 0
    VAR_BORROW_EXCL[idx as usize] = 0
    VAR_USED[idx as usize] = used
    VAR_TY[idx as usize] = ty
    VAR_TY_HASH[idx as usize] = ty_hash
    VAR_COUNT = VAR_COUNT + 1
    return idx
}

fn var_add(ns: i64, ne: i64) -> i64 with Mut, Panic {
    let slot = NEXT_SLOT
    if local_meta_add(ns, ne, slot, 0, 0, 8, 0, 0, 0, 0, 0, 0, 0, 0) < 0 {
        LAST_LOCAL_BSS_SPILL = 0
        LAST_LOCAL_BSS_ADDR = 0
        return -1
    }
    NEXT_SLOT = NEXT_SLOT + 1
    LAST_LOCAL_BSS_SPILL = 0
    LAST_LOCAL_BSS_ADDR = 0
    return slot
}

fn var_add_option_inline(ns: i64, ne: i64, ty_hash: i64) -> i64 with Mut, Panic {
    let tag_slot = NEXT_SLOT + 1
    if local_meta_add(ns, ne, tag_slot, 0, 0, 16, 0, 0, 0, 0, 0, 0, 11, ty_hash) < 0 {
        LAST_LOCAL_BSS_SPILL = 0
        LAST_LOCAL_BSS_ADDR = 0
        return -1
    }
    NEXT_SLOT = NEXT_SLOT + 2
    LAST_LOCAL_BSS_SPILL = 0
    LAST_LOCAL_BSS_ADDR = 0
    return tag_slot
}

fn emit_copy_option_to_local_x86(tag_slot: i64) with Mut, Panic, Div {
    em(0x48); em(0x89); em(0xc2)
    emit_lea_var(tag_slot)
    emit_copy_agg_to_ptr_x86(11, 0)
}

fn emit_copy_option_to_local_a64(tag_slot: i64) with Mut, Panic, Div {
    em32(0xAA0003EA)
    emit_lea_var_a64(tag_slot)
    emit_copy_agg_to_ptr_a64(11, 0)
}

// Add a local array variable: allocate N slots, return base slot, store lea as value
fn var_add_arr(ns: i64, ne: i64, alen: i64, esiz: i64, elem_ty: i64) -> i64 with Mut, Panic, Div {
    let storage_bytes = alen * 8
    let spill = storage_bytes >= local_bss_spill_bytes()
    let base = NEXT_SLOT
    if spill == false { NEXT_SLOT = NEXT_SLOT + alen }
    let ptr_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    if local_meta_add(ns, ne, ptr_slot, 0, alen, esiz, 0, 0, 0, 0, 0, 0, 8, arr_ty_hash(alen, esiz, elem_ty)) < 0 {
        if spill == false { NEXT_SLOT = NEXT_SLOT - alen }
        NEXT_SLOT = NEXT_SLOT - 1
        LAST_LOCAL_BSS_SPILL = 0
        LAST_LOCAL_BSS_ADDR = 0
        return -1
    }
    if spill != false {
        LAST_LOCAL_BSS_SPILL = 1
        LAST_LOCAL_BSS_ADDR = GL_BSS_BASE + bss_alloc_aligned(storage_bytes)
    } else {
        LAST_LOCAL_BSS_SPILL = 0
        LAST_LOCAL_BSS_ADDR = 0
    }
    return ptr_slot
}

fn var_find_len_slot(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = VAR_COUNT - 1
    while i >= 0 {
        if name_eq(VAR_NS[i as usize], VAR_NE[i as usize], ns, ne) { return VAR_LEN_SLOT[i as usize] }
        i = i - 1
    }
    return 0
}

fn bind_slice_local_from_rax_x86(ns: i64, ne: i64, ty_hash: i64) with Mut, Panic, Div {
    let inner_hash = ref_hash_inner_hash(ty_hash)
    let len_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    let ptr_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    if local_meta_add(ns, ne, ptr_slot, len_slot, 0, arr_hash_esiz(inner_hash), 0, 0, 0, 0, 0, 0, 10, ty_hash) < 0 {
        NEXT_SLOT = NEXT_SLOT - 2
        return
    }
    if type_is_slice_ref(EXPR_TY, EXPR_TY_HASH) {
        em(0x48); em(0x89); em(0xc2)  // mov rdx, rax
        em(0x48); em(0x8b); em(0x02)  // mov rax, [rdx]
        emit_store_var(ptr_slot)
        em(0x48); em(0x8b); em(0x42); em(8)  // mov rax, [rdx + 8]
        emit_store_var(len_slot)
    } else if EXPR_TY == 10 && ref_hash_inner_ty(EXPR_TY_HASH) == 8 {
        emit_store_var(ptr_slot)
        emit_imm64(arr_hash_alen(ref_hash_inner_hash(EXPR_TY_HASH)))
        emit_store_var(len_slot)
    } else {
        emit_store_var(ptr_slot)
        emit_imm64(0)
        emit_store_var(len_slot)
    }
    emit_lea_var(ptr_slot)
}

fn bind_slice_local_from_x0_a64(ns: i64, ne: i64, ty_hash: i64) with Mut, Panic, Div {
    let inner_hash = ref_hash_inner_hash(ty_hash)
    let len_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    let ptr_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    if local_meta_add(ns, ne, ptr_slot, len_slot, 0, arr_hash_esiz(inner_hash), 0, 0, 0, 0, 0, 0, 10, ty_hash) < 0 {
        NEXT_SLOT = NEXT_SLOT - 2
        return
    }
    if type_is_slice_ref(EXPR_TY, EXPR_TY_HASH) {
        em32(0xAA0003EA)  // mov x10, x0
        em32(0xF9400140)  // ldr x0, [x10]
        emit_store_var_a64(ptr_slot)
        em32(0xF9400540)  // ldr x0, [x10, #8]
        emit_store_var_a64(len_slot)
    } else if EXPR_TY == 10 && ref_hash_inner_ty(EXPR_TY_HASH) == 8 {
        emit_store_var_a64(ptr_slot)
        emit_imm64_a64(arr_hash_alen(ref_hash_inner_hash(EXPR_TY_HASH)))
        emit_store_var_a64(len_slot)
    } else {
        emit_store_var_a64(ptr_slot)
        em32(0xD2800000)
        emit_store_var_a64(len_slot)
    }
    emit_lea_var_a64(ptr_slot)
}

// Find array info for a local variable by name
fn var_find_alen(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = VAR_COUNT - 1
    while i >= 0 {
        if name_eq(VAR_NS[i as usize], VAR_NE[i as usize], ns, ne) { return VAR_ALEN[i as usize] }
        i = i - 1
    }
    return 0
}

fn var_find_esiz(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = VAR_COUNT - 1
    while i >= 0 {
        if name_eq(VAR_NS[i as usize], VAR_NE[i as usize], ns, ne) { return VAR_ESIZ[i as usize] }
        i = i - 1
    }
    return 8
}

fn var_find_is_f64(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = VAR_COUNT - 1
    while i >= 0 {
        if name_eq(VAR_NS[i as usize], VAR_NE[i as usize], ns, ne) { return VAR_IS_F64[i as usize] }
        i = i - 1
    }
    return 0
}

fn var_find_is_mut(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = VAR_COUNT - 1
    while i >= 0 {
        if name_eq(VAR_NS[i as usize], VAR_NE[i as usize], ns, ne) { return VAR_MUT[i as usize] }
        i = i - 1
    }
    return 0
}

fn var_find_is_closure(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = VAR_COUNT - 1
    while i >= 0 {
        if name_eq(VAR_NS[i as usize], VAR_NE[i as usize], ns, ne) { return VAR_IS_CLOSURE[i as usize] }
        i = i - 1
    }
    return 0
}

// Mark a variable as used (for linear type checking)
fn var_mark_used(ns: i64, ne: i64) with Mut, Panic {
    var i: i64 = VAR_COUNT - 1
    while i >= 0 {
        if name_eq(VAR_NS[i as usize], VAR_NE[i as usize], ns, ne) {
            VAR_USED[i as usize] = VAR_USED[i as usize] + 1
            return
        }
        i = i - 1
    }
}

// Find variable index by name (not slot, but index into VAR arrays)
fn var_find_idx(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = VAR_COUNT - 1
    while i >= 0 {
        if name_eq(VAR_NS[i as usize], VAR_NE[i as usize], ns, ne) { return i }
        i = i - 1
    }
    return -1
}

fn var_find_ty(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = VAR_COUNT - 1
    while i >= 0 {
        if name_eq(VAR_NS[i as usize], VAR_NE[i as usize], ns, ne) { return VAR_TY[i as usize] }
        i = i - 1
    }
    return 0
}

fn var_find_ty_hash(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = VAR_COUNT - 1
    while i >= 0 {
        if name_eq(VAR_NS[i as usize], VAR_NE[i as usize], ns, ne) { return VAR_TY_HASH[i as usize] }
        i = i - 1
    }
    return 0
}

// Release call-site borrows recorded during a call's argument list
// Release borrows recorded from index `from_n` to current CALL_ARG_BORROW_N,
// then restore CALL_ARG_BORROW_N to from_n.  Supports nested calls correctly:
// each call saves its own base and only releases the borrows it added.
fn release_call_arg_borrows(from_n: i64) with Mut {
    var ri: i64 = from_n
    while ri < CALL_ARG_BORROW_N {
        let rvi = CALL_ARG_BORROW_VI[ri as usize]
        if rvi >= 0 && rvi < 1024 {
            if CALL_ARG_BORROW_EXCL[ri as usize] != 0 {
                if VAR_BORROW_EXCL[rvi as usize] > 0 {
                    VAR_BORROW_EXCL[rvi as usize] = VAR_BORROW_EXCL[rvi as usize] - 1
                }
            } else {
                if VAR_BORROW_COUNT[rvi as usize] > 0 {
                    VAR_BORROW_COUNT[rvi as usize] = VAR_BORROW_COUNT[rvi as usize] - 1
                }
            }
        }
        ri = ri + 1
    }
    CALL_ARG_BORROW_N = from_n
}

// ─── Function lookup ───
fn fn_find(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = 0
    while i < FN_COUNT {
        if name_eq(FN_NS[i as usize], FN_NE[i as usize], ns, ne) { return i }
        i = i + 1
    }
    return -1
}

fn fn_find_method(ns: i64, ne: i64, recv_hash: i64) -> i64 with Panic, Mut {
    // First: exact match on name + receiver hash
    var i: i64 = 0
    while i < FN_COUNT {
        if name_eq(FN_NS[i as usize], FN_NE[i as usize], ns, ne) {
            if FN_RECV_HASH[i as usize] == recv_hash { return i }
        }
        i = i + 1
    }
    // Fallback: match by name only, but ONLY if receiver hash is 0 (no impl context)
    // This prevents ABI mismatch when two functions have the same name but different
    // return types (e.g., a method and a standalone function).
    if recv_hash == 0 {
        i = 0
        while i < FN_COUNT {
            if name_eq(FN_NS[i as usize], FN_NE[i as usize], ns, ne) { return i }
            i = i + 1
        }
    }
    // SIZE_HINT fallback: recv_hash is 1000000007+nslots after tuple .0 materialization.
    // The actual struct type was lost; fall back to name-only match so method calls work.
    if recv_hash >= 1000000007 {
        if recv_hash < 1000001007 {
            i = 0
            while i < FN_COUNT {
                if name_eq(FN_NS[i as usize], FN_NE[i as usize], ns, ne) { return i }
                i = i + 1
            }
        }
    }
    return -1
}

fn fn_find_lit(name: string) -> i64 with Panic, Mut, Div {
    let name_len = str_len(name)
    var i: i64 = 0
    while i < FN_COUNT {
        if FN_NE[i as usize] - FN_NS[i as usize] == name_len {
            if src_match(FN_NS[i as usize], name_len, name) { return i }
        }
        i = i + 1
    }
    return -1
}

fn print_fn_name(fi: i64) with IO, Mut, Panic {
    if fi < 0 || fi >= FN_COUNT { print("<invalid>"); return }
    var i: i64 = FN_NS[fi as usize]
    let e = FN_NE[fi as usize]
    while i < e {
        print_char(SRC[i as usize] as i64)
        i = i + 1
    }
}

fn find_matching_body_close(open_tok: i64) -> i64 with Panic, Mut {
    if open_tok < 0 || open_tok >= TC { return TC }
    if TK[open_tok as usize] != 8 { return TC }
    var q: i64 = open_tok
    var depth: i64 = 0
    while q < TC {
        if TK[q as usize] == 8 { depth = depth + 1 }
        if TK[q as usize] == 9 {
            depth = depth - 1
            if depth == 0 { return q }
        }
        q = q + 1
    }
    return TC
}

fn ep_before_body_close() -> bool {
    if CURRENT_BODY_CLOSE == 0 { return true }
    return EP < CURRENT_BODY_CLOSE
}

// ─── Emit helpers ───
// mov rax, [rbp - 8*slot]
fn emit_load_var(slot: i64) with Mut { em(0x48); em(0x8b); em(0x85); em32(0 - slot * 8) }
// mov [rbp - 8*slot], rax
fn emit_store_var(slot: i64) with Mut { em(0x48); em(0x89); em(0x85); em32(0 - slot * 8) }
// lea rax, [rbp - 8*slot]
fn emit_lea_var(slot: i64) with Mut { em(0x48); em(0x8d); em(0x85); em32(0 - slot * 8) }
// push rax
fn emit_push() with Mut { em(0x50) }
// pop rcx
fn emit_pop_rcx() with Mut { em(0x59) }
// mov rax, imm64
fn emit_imm64(v: i64) with Mut { em(0x48); em(0xb8); em64(v) }

fn emit_push_expr_as_slice_arg_x86(call_tok: i64) with IO, Mut, Panic, Div {
    if type_is_slice_ref(EXPR_TY, EXPR_TY_HASH) {
        em(0x48); em(0x89); em(0xc2)  // mov rdx, rax
        em(0x48); em(0x8b); em(0x02)  // mov rax, [rdx]
        emit_push()
        em(0x48); em(0x8b); em(0x42); em(8)  // mov rax, [rdx + 8]
        emit_push()
        return
    }
    if type_is_array_ref(EXPR_TY, EXPR_TY_HASH) {
        emit_push()
        emit_imm64(arr_hash_alen(ref_hash_inner_hash(EXPR_TY_HASH)))
        emit_push()
        return
    }
    tc_error(call_tok, "slice argument requires slice or array reference")
    emit_push()
    emit_imm64(0)
    emit_push()
}

fn emit_push_expr_as_slice_arg_a64(call_tok: i64) with IO, Mut, Panic, Div {
    if type_is_slice_ref(EXPR_TY, EXPR_TY_HASH) {
        em32(0xAA0003EA)  // mov x10, x0
        em32(0xF9400140)  // ldr x0, [x10]
        emit_push_a64()
        em32(0xF9400540)  // ldr x0, [x10, #8]
        emit_push_a64()
        return
    }
    if type_is_array_ref(EXPR_TY, EXPR_TY_HASH) {
        emit_push_a64()
        emit_imm64_a64(arr_hash_alen(ref_hash_inner_hash(EXPR_TY_HASH)))
        emit_push_a64()
        return
    }
    tc_error(call_tok, "slice argument requires slice or array reference")
    emit_push_a64()
    em32(0xD2800000)
    emit_push_a64()
}

fn emit_slice_len_of_expr_x86(call_tok: i64) with IO, Mut, Panic, Div {
    if type_is_slice_ref(EXPR_TY, EXPR_TY_HASH) {
        em(0x48); em(0x8b); em(0x40); em(8)  // mov rax, [rax + 8]
    } else if type_is_array_ref(EXPR_TY, EXPR_TY_HASH) {
        emit_imm64(arr_hash_alen(ref_hash_inner_hash(EXPR_TY_HASH)))
    } else {
        tc_error(call_tok, "slice_len requires slice or array reference")
        em(0x31); em(0xc0)
    }
    EXPR_IS_F64 = 0
    EXPR_TY = 1
    EXPR_TY_HASH = 0
}

fn emit_slice_len_of_expr_a64(call_tok: i64) with IO, Mut, Panic, Div {
    if type_is_slice_ref(EXPR_TY, EXPR_TY_HASH) {
        em32(0xF9400400)  // ldr x0, [x0, #8]
    } else if type_is_array_ref(EXPR_TY, EXPR_TY_HASH) {
        emit_imm64_a64(arr_hash_alen(ref_hash_inner_hash(EXPR_TY_HASH)))
    } else {
        tc_error(call_tok, "slice_len requires slice or array reference")
        em32(0xD2800000)
    }
    EXPR_IS_F64 = 0
    EXPR_TY = 1
    EXPR_TY_HASH = 0
}

fn bind_array_local_from_rax_x86(ns: i64, ne: i64, ty_hash: i64) with Mut, Panic, Div {
    let esiz = arr_hash_esiz(ty_hash)
    let elem_ty = arr_hash_elem_ty(ty_hash)
    let nslots = arr_storage_slots(ty_hash)
    let ptr_slot = var_add_arr(ns, ne, nslots, esiz, elem_ty)
    if ptr_slot < 0 { return }
    let arr_vi = VAR_COUNT - 1
    let base = ptr_slot - nslots
    VAR_TY[arr_vi as usize] = 8
    VAR_TY_HASH[arr_vi as usize] = ty_hash
    em(0x48); em(0x89); em(0xc2)  // mov rdx, rax
    if LAST_LOCAL_BSS_SPILL != 0 {
        em(0x48); em(0xb8); em64(LAST_LOCAL_BSS_ADDR)
        emit_copy_agg_to_ptr_x86(8, ty_hash)
        em(0x48); em(0xb8); em64(LAST_LOCAL_BSS_ADDR)
    } else {
        var i: i64 = 0
        while i < nslots {
            em(0x48); em(0x8b); em(0x82); em32(i * 8)  // mov rax, [rdx + off]
            emit_store_var(base + nslots - 1 - i)
            i = i + 1
        }
        em(0x48); em(0x8d); em(0x85)
        em32(0 - (base + nslots - 1) * 8)
    }
    emit_store_var(ptr_slot)
}

fn copy_array_into_local_slot_x86(slot: i64, ty_hash: i64) with Mut, Panic, Div {
    let nslots = arr_storage_slots(ty_hash)
    em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (src ptr)
    emit_load_var(slot)
    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (dst ptr)
    var i: i64 = 0
    while i < nslots {
        em(0x48); em(0x8b); em(0x82); em32(i * 8)  // mov rax, [rdx + off]
        em(0x48); em(0x89); em(0x81); em32(i * 8)  // mov [rcx + off], rax
        i = i + 1
    }
    em(0x48); em(0x89); em(0xc8)  // mov rax, rcx
}

fn bind_struct_local_from_rax_x86(ns: i64, ne: i64, ty_hash: i64) with Mut, Panic, Div {
    let si = st_find(ty_hash)
    if si < 0 && knowledge_hash_is(ty_hash) == false {
        let slot = var_add(ns, ne)
        if slot < 0 { return }
        emit_store_var(slot)
        let vix = VAR_COUNT - 1
        VAR_TY[vix as usize] = 6
        VAR_TY_HASH[vix as usize] = ty_hash
        return
    }
    let nslots = struct_like_nslots(ty_hash)
    // ptr_slot FIRST, then data slots. Keeps ptr safe from overwrites.
    let ptr_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    var base: i64 = 0
    var spill_addr: i64 = 0
    let spill = nslots * 8 >= local_bss_spill_bytes()
    if spill {
        spill_addr = GL_BSS_BASE + bss_alloc_aligned(nslots * 8)
    } else {
        base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + nslots
    }
    var linear_flag: i64 = 0
    var affine_flag: i64 = 0
    if knowledge_hash_is(ty_hash) == false { linear_flag = ST_LINEAR[si as usize]; affine_flag = ST_AFFINE[si as usize] }
    var out_ty: i64 = 0
    if knowledge_hash_is(ty_hash) == false { out_ty = 6 }
    if local_meta_add(ns, ne, ptr_slot, 0, 0, 8, 0, 0, 0, 0, linear_flag, 0, out_ty, ty_hash) < 0 {
        if spill == false { NEXT_SLOT = NEXT_SLOT - nslots }
        NEXT_SLOT = NEXT_SLOT - 1
        return
    }
    VAR_AFFINE[(VAR_COUNT - 1) as usize] = affine_flag
    // Copy struct data to local slots and store LEA pointer
    if spill {
        em(0x48); em(0x89); em(0xc2)  // mov rdx, rax
        em(0x48); em(0xb8); em64(spill_addr)
        emit_copy_agg_to_ptr_x86(6, ty_hash)
        em(0x48); em(0xb8); em64(spill_addr)
    } else {
        emit_bulk_copy_to_slots_x86(nslots, base)
    }
    emit_store_var(ptr_slot)
}

// Zero-initialize a struct local — used for 'var x: T' with no initializer
fn bind_struct_local_zeroinit_x86(ns: i64, ne: i64, ty_hash: i64) with Mut, Panic, Div {
    let si = st_find(ty_hash)
    if si < 0 && knowledge_hash_is(ty_hash) == false {
        let slot = var_add(ns, ne)
        if slot < 0 { return }
        em(0x48); em(0x31); em(0xc0)  // xor rax, rax
        emit_store_var(slot)
        let vix = VAR_COUNT - 1
        VAR_TY[vix as usize] = 6
        VAR_TY_HASH[vix as usize] = ty_hash
        return
    }
    let nslots = struct_like_nslots(ty_hash)
    let ptr_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    var base: i64 = 0
    var spill_addr: i64 = 0
    let spill = nslots * 8 >= local_bss_spill_bytes()
    if spill {
        spill_addr = GL_BSS_BASE + bss_alloc_aligned(nslots * 8)
    } else {
        base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + nslots
    }
    var linear_flag: i64 = 0
    var affine_flag: i64 = 0
    if knowledge_hash_is(ty_hash) == false { linear_flag = ST_LINEAR[si as usize]; affine_flag = ST_AFFINE[si as usize] }
    var out_ty: i64 = 0
    if knowledge_hash_is(ty_hash) == false { out_ty = 6 }
    if local_meta_add(ns, ne, ptr_slot, 0, 0, 8, 0, 0, 0, 0, linear_flag, 0, out_ty, ty_hash) < 0 {
        if spill == false { NEXT_SLOT = NEXT_SLOT - nslots }
        NEXT_SLOT = NEXT_SLOT - 1
        return
    }
    VAR_AFFINE[(VAR_COUNT - 1) as usize] = affine_flag
    // Zero-init slots via rep stosq
    if spill {
        em(0x48); em(0xbf); em64(spill_addr)
    } else {
        em(0x48); em(0x8d); em(0xbd)   // lea rdi, [rbp - (base+nslots-1)*8]
        em32(0 - (base + nslots - 1) * 8)
    }
    em(0x48); em(0x31); em(0xc0)   // xor rax, rax
    em(0xb9); em32(nslots)          // mov ecx, nslots
    em(0xf3); em(0x48); em(0xab)   // rep stosq
    // Store LEA pointer in ptr_slot
    if spill {
        em(0x48); em(0xb8); em64(spill_addr)
    } else {
        em(0x48); em(0x8d); em(0x85)   // lea rax, [rbp - (base+nslots-1)*8]
        em32(0 - (base + nslots - 1) * 8)
    }
    emit_store_var(ptr_slot)
}

// Emit init code for all top-level `var NAME: TY = EXPR` declarations.
// Called once at main's entry before the body is compiled. BSS-zero covers the
// zero-initialized case; this catches non-zero literal and expression inits
// (e.g. `var PI: f64 = 3.14159`, `var TUNE: i64 = 42`).
// Array globals with repeat syntax `[V; N]` fall through to BSS zero (V must be 0
// for correctness; other values are not yet supported).
fn emit_global_inits_x86() with IO, Mut, Panic, Div {
    var p: i64 = 0
    var depth: i64 = 0
    while p < TC {
        let tk = TK[p as usize]
        if tk == 8 { depth = depth + 1; p = p + 1; continue }
        if tk == 9 {
            // Clamped, matching Pass 0a. Unclamped, one stray `}` pins depth
            // negative for the whole remaining token stream, and every later
            // function-body `var` is treated as a global (#1634).
            if depth > 0 { depth = depth - 1 }
            p = p + 1
            continue
        }
        // File boundary (TK==77). Modules are independently balanced, so depth
        // must not carry across one. Pass 0a already resets here; these three
        // scanners did not, which is what let one file's imbalance poison the
        // rest of the bundle -- and made the three disagree about which `var`s
        // are global, between registration and initializer emission.
        if tk == 77 { depth = 0; p = p + 1; continue }
        if depth > 0 { p = p + 1; continue }
        if tk == 12 {
            p = p + 1
            let gns = TS[p as usize]
            let gne = TE[p as usize]
            p = p + 1
            if p < TC && TK[p as usize] == 43 {
                p = p + 1
                if TK[p as usize] == 41 {
                    while p < TC && TK[p as usize] != 42 { p = p + 1 }
                    if p < TC { p = p + 1 }
                } else {
                    scan_type(p)
                    p = SCAN_TY_NEXT
                }
            }
            if p < TC && TK[p as usize] == 16 {
                p = p + 1
                if TK[p as usize] == 41 {
                    // `[ ... ]` after `=` is one of TWO initializer forms, and this
                    // scanner used to assume it was always the first:
                    //
                    //   [V; N]      repeat  -- one value, splatted into N slots
                    //   [a, b, c]   list    -- N values, one per slot
                    //
                    // Compiled as a repeat, a LIST parses its first element as V,
                    // finds no `;`, and rep-stos that one value across the whole
                    // array: `var GA: [i64; 7] = [1,2,3,4,5,6,7]` read back as seven
                    // 1s (#1574). Silent wrong data -- the array is fully
                    // initialised, just uniformly with element 0.
                    //
                    // array_init_is_repeat is the same discriminator the LOCAL decl
                    // path already uses (compile_primary, compile_stmt); only the
                    // two global emitters were missing it.
                    let gi_arr = gl_find(gns, gne)
                    if gi_arr >= 0 && array_init_is_repeat(p) == false {
                        let l_base = GL_BSS_BASE + GL[(gi_arr * 4 + 1) as usize]
                        let l_esiz = GL[(gi_arr * 4 + 2) as usize]
                        let l_alen = GL[(gi_arr * 4 + 3) as usize]
                        p = p + 1                              // skip [
                        var l_idx: i64 = 0
                        while p < TC && TK[p as usize] != 42 && TK[p as usize] != 0 {
                            EP = p
                            compile_or()                       // element value in rax
                            p = EP
                            // Excess elements are compiled (so a bad one still
                            // diagnoses) but not stored: the slot does not exist.
                            if l_idx < l_alen {
                                if l_esiz == 1 {
                                    em(0x48); em(0x89); em(0xc1)   // mov rcx, rax
                                    emit_load_abs_addr_to_rax_x86(l_base + l_idx)
                                    em(0x88); em(0x08)             // mov [rax], cl
                                } else {
                                    emit_store_rax_to_abs_qword_x86(l_base + l_idx * l_esiz)
                                }
                            }
                            l_idx = l_idx + 1
                            if p < TC && TK[p as usize] == 28 { p = p + 1 }   // skip ,
                        }
                        if p < TC && TK[p as usize] == 42 { p = p + 1 }      // skip ]
                        // Short lists leave the tail at the BSS zero it already has.
                        continue
                    }
                    // Array repeat initializer: [V; N]
                    if gi_arr >= 0 {
                        p = p + 1                              // skip [
                        EP = p
                        compile_or()                           // value V in rax
                        p = EP
                        if p < TC && TK[p as usize] == 27 { p = p + 1 }   // skip ;
                        if p < TC && TK[p as usize] == 4 { p = p + 1 }    // skip N literal (alen already stored)
                        if p < TC && TK[p as usize] == 42 { p = p + 1 }   // skip ]
                        let base = GL_BSS_BASE + GL[(gi_arr * 4 + 1) as usize]
                        let esiz = GL[(gi_arr * 4 + 2) as usize]
                        let alen = GL[(gi_arr * 4 + 3) as usize]
                        if alen > 0 {
                            em(0x48); em(0xbf); em64(base)         // mov rdi, base
                            em(0x48); em(0xb9); em64(alen)         // mov rcx, alen
                            if esiz == 1 {
                                em(0xf3); em(0xaa)                 // rep stosb (uses al)
                            } else {
                                em(0xf3); em(0x48); em(0xab)       // rep stosq (uses rax)
                            }
                        }
                        continue
                    }
                    while p < TC && TK[p as usize] != 12 && TK[p as usize] != 1 && TK[p as usize] != 0 { p = p + 1 }
                    continue
                }
                let gi = gl_find(gns, gne)
                if gi >= 0 {
                    EP = p
                    compile_or()
                    let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                    if type_is_option_inline(GL_TY[gi as usize], GL_TY_HASH[gi as usize]) && GL[(gi * 4 + 2) as usize] >= 16 {
                        em(0x48); em(0x89); em(0xc2)
                        em(0x48); em(0xb8); em64(addr)
                        emit_copy_agg_to_ptr_x86(11, GL_TY_HASH[gi as usize])
                    } else if type_is_struct_like(GL_TY[gi as usize], GL_TY_HASH[gi as usize]) || knowledge_hash_is(GL_TY_HASH[gi as usize]) {
                        em(0x48); em(0x89); em(0xc2)
                        em(0x48); em(0xb8); em64(addr)
                        emit_copy_agg_to_ptr_x86(6, GL_TY_HASH[gi as usize])
                    } else {
                        em(0x48); em(0x89); em(0xc1)
                        em(0x48); em(0xb8); em64(addr)
                        em(0x48); em(0x89); em(0x08)
                    }
                    p = EP
                    continue
                }
            }
            while p < TC && TK[p as usize] != 12 && TK[p as usize] != 1 && TK[p as usize] != 0 { p = p + 1 }
            continue
        }
        p = p + 1
    }
}

fn emit_global_inits_a64() with IO, Mut, Panic, Div {
    var p: i64 = 0
    var depth: i64 = 0
    while p < TC {
        let tk = TK[p as usize]
        if tk == 8 { depth = depth + 1; p = p + 1; continue }
        if tk == 9 {
            // Clamped, matching Pass 0a. Unclamped, one stray `}` pins depth
            // negative for the whole remaining token stream, and every later
            // function-body `var` is treated as a global (#1634).
            if depth > 0 { depth = depth - 1 }
            p = p + 1
            continue
        }
        // File boundary (TK==77). Modules are independently balanced, so depth
        // must not carry across one. Pass 0a already resets here; these three
        // scanners did not, which is what let one file's imbalance poison the
        // rest of the bundle -- and made the three disagree about which `var`s
        // are global, between registration and initializer emission.
        if tk == 77 { depth = 0; p = p + 1; continue }
        if depth > 0 { p = p + 1; continue }
        if tk == 12 {
            p = p + 1
            let gns = TS[p as usize]
            let gne = TE[p as usize]
            p = p + 1
            if p < TC && TK[p as usize] == 43 {
                p = p + 1
                if TK[p as usize] == 41 {
                    while p < TC && TK[p as usize] != 42 { p = p + 1 }
                    if p < TC { p = p + 1 }
                } else {
                    scan_type(p)
                    p = SCAN_TY_NEXT
                }
            }
            if p < TC && TK[p as usize] == 16 {
                p = p + 1
                if TK[p as usize] == 41 {
                    // a64 twin of the x86 element-list fix (#1574). See
                    // emit_global_inits_x86 for why array_init_is_repeat has to
                    // gate this: without it `[a, b, c]` is compiled as `[a; N]`.
                    let gi_arr = gl_find(gns, gne)
                    if gi_arr >= 0 && array_init_is_repeat(p) == false {
                        let l_base = GL_BSS_BASE + GL[(gi_arr * 4 + 1) as usize]
                        let l_esiz = GL[(gi_arr * 4 + 2) as usize]
                        let l_alen = GL[(gi_arr * 4 + 3) as usize]
                        p = p + 1                              // skip [
                        var l_idx: i64 = 0
                        while p < TC && TK[p as usize] != 42 && TK[p as usize] != 0 {
                            EP = p
                            compile_or_a64()                   // element value in x0
                            p = EP
                            if l_idx < l_alen {
                                if l_esiz == 1 {
                                    emit_image_addr_reg_a64(9, l_base + l_idx)
                                    em32(0x39000120)           // strb w0, [x9]
                                } else {
                                    emit_store_x0_to_abs_qword_a64(l_base + l_idx * l_esiz)
                                }
                            }
                            l_idx = l_idx + 1
                            if p < TC && TK[p as usize] == 28 { p = p + 1 }   // skip ,
                        }
                        if p < TC && TK[p as usize] == 42 { p = p + 1 }      // skip ]
                        continue
                    }
                    // Array repeat initializer: [V; N]
                    if gi_arr >= 0 {
                        p = p + 1                              // skip [
                        EP = p
                        compile_or_a64()                       // value V in x0
                        p = EP
                        if p < TC && TK[p as usize] == 27 { p = p + 1 }   // skip ;
                        if p < TC && TK[p as usize] == 4 { p = p + 1 }    // skip N literal
                        if p < TC && TK[p as usize] == 42 { p = p + 1 }   // skip ]
                        let base = GL_BSS_BASE + GL[(gi_arr * 4 + 1) as usize]
                        let esiz = GL[(gi_arr * 4 + 2) as usize]
                        let alen = GL[(gi_arr * 4 + 3) as usize]
                        if alen > 0 {
                            em32(0xAA0003E2)                   // mov x2, x0 (save value)
                            emit_image_addr_a64(base)           // x0 = base
                            if esiz == 1 {
                                // byte fill loop: x0=dst, x2=byte, x1=counter
                                em32(0xAA0003E3)               // mov x3, x0 (save dst)
                                emit_imm64_reg_a64(1, alen)    // x1 = alen
                                let loop_off = CL
                                em32(0x39000062)               // strb w2, [x3]
                                em32(0x91000463)               // add x3, x3, #1
                                em32(0xF1000421)               // subs x1, x1, #1
                                let br_off = CL
                                let rel = (loop_off - br_off) / 4
                                em32(0x54000001 | ((rel & 0x7FFFF) << 5))  // b.ne loop
                            } else {
                                em32(0xAA0203ED)               // mov x13, x2 (value)
                                em32(0xAA0003EB)               // mov x11, x0 (dest)
                                emit_fill_words_x13_x11_a64(alen)
                            }
                        }
                        continue
                    }
                    while p < TC && TK[p as usize] != 12 && TK[p as usize] != 1 && TK[p as usize] != 0 { p = p + 1 }
                    continue
                }
                let gi = gl_find(gns, gne)
                if gi >= 0 {
                    EP = p
                    compile_or_a64()
                    let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                    if type_is_option_inline(GL_TY[gi as usize], GL_TY_HASH[gi as usize]) && GL[(gi * 4 + 2) as usize] >= 16 {
                        em32(0xAA0003EA)
                        emit_image_addr_a64(addr)
                        emit_copy_agg_to_ptr_a64(11, GL_TY_HASH[gi as usize])
                    } else if type_is_struct_like(GL_TY[gi as usize], GL_TY_HASH[gi as usize]) || knowledge_hash_is(GL_TY_HASH[gi as usize]) {
                        em32(0xAA0003EA)
                        emit_image_addr_a64(addr)
                        emit_copy_agg_to_ptr_a64(6, GL_TY_HASH[gi as usize])
                    } else {
                        em32(0xAA0003E1)
                        emit_image_addr_a64(addr)
                        em32(0xF9000001)
                    }
                    p = EP
                    continue
                }
            }
            while p < TC && TK[p as usize] != 12 && TK[p as usize] != 1 && TK[p as usize] != 0 { p = p + 1 }
            continue
        }
        p = p + 1
    }
}

fn copy_struct_into_local_slot_x86(slot: i64, ty_hash: i64) with Mut, Panic, Div {
    let si = st_find(ty_hash)
    if si < 0 && knowledge_hash_is(ty_hash) == false { emit_store_var(slot); return }
    let nslots = struct_like_nslots(ty_hash)
    em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (source ptr)
    emit_load_var(slot)
    emit_copy_agg_to_ptr_x86(6, ty_hash)
}

fn emit_bulk_copy_to_slots_x86(nslots: i64, base: i64) with Mut, Panic, Div {
    // rax = source pointer. Copy nslots qwords to stack slots [base..base+nslots-1].
    // Stack layout: slot base+nslots-1 is at lowest address = rbp - (base+nslots-1)*8.
    // For nslots > 32: use rep movsq (constant-size code).
    // For nslots <= 32: per-qword mov (lower overhead for small aggregates).
    if nslots > 32 {
        em(0x48); em(0x89); em(0xc6)      // mov rsi, rax (source)
        em(0x48); em(0x8d); em(0xbd)      // lea rdi, [rbp - (base+nslots-1)*8]
        em32(0 - (base + nslots - 1) * 8)
        em(0xb9); em32(nslots)            // mov ecx, nslots
        em(0xf3); em(0x48); em(0xa5)      // rep movsq
        em(0x48); em(0x8d); em(0x85)      // lea rax, [rbp - (base+nslots-1)*8]
        em32(0 - (base + nslots - 1) * 8)
    } else {
        em(0x48); em(0x89); em(0xc2)      // mov rdx, rax
        var i: i64 = 0
        while i < nslots {
            em(0x48); em(0x8b); em(0x82); em32(i * 8)  // mov rax, [rdx + i*8]
            emit_store_var(base + nslots - 1 - i)
            i = i + 1
        }
        em(0x48); em(0x8d); em(0x85)
        em32(0 - (base + nslots - 1) * 8)
    }
}

fn materialize_aggregate_expr_x86() with Mut, Panic, Div {
    if EXPR_TY == 8 {
        let nslots = arr_storage_slots(EXPR_TY_HASH)
        // Large arrays exceed the spill threshold: rax already holds a pointer to the
        // array data (from var load or BSS). Pass the pointer as-is rather than
        // copying 1M+ slots onto the local stack frame.
        if nslots * 8 >= local_bss_spill_bytes() { return }
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + nslots
        emit_bulk_copy_to_slots_x86(nslots, base)
        return
    }
    if type_is_option_inline(EXPR_TY, EXPR_TY_HASH) {
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 2
        emit_bulk_copy_to_slots_x86(2, base)
        return
    }
    if type_is_struct_like(EXPR_TY, EXPR_TY_HASH) {
        let nslots = struct_like_nslots(EXPR_TY_HASH)
        if nslots <= 0 { return }
        if nslots * 8 >= local_bss_spill_bytes() {
            let tmp_addr = GL_BSS_BASE + bss_alloc_aligned(nslots * 8)
            em(0x48); em(0x89); em(0xc2)  // mov rdx, rax
            em(0x48); em(0xb8); em64(tmp_addr)
            emit_copy_agg_to_ptr_x86(EXPR_TY, EXPR_TY_HASH)
            em(0x48); em(0xb8); em64(tmp_addr)
            return
        }
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + nslots
        emit_bulk_copy_to_slots_x86(nslots, base)
    }
}

fn copy_agg_into_struct_slots_x86(dst_start: i64, field_ty: i64, field_hash: i64) with Mut, Panic, Div {
    var nslots: i64 = 0
    if field_ty == 8 {
        nslots = arr_storage_slots(field_hash)
    } else if type_is_option_inline(field_ty, field_hash) {
        nslots = 2
    } else if type_is_struct_like(field_ty, field_hash) || knowledge_hash_is(field_hash) {
        nslots = struct_like_nslots(field_hash)
    }
    if nslots <= 0 { emit_store_var(dst_start); return }
    if nslots > 32 {
        // rep movsq: rax=source, dst slots are dst_start..dst_start-nslots+1
        em(0x48); em(0x89); em(0xc6)      // mov rsi, rax (source)
        em(0x48); em(0x8d); em(0xbd)      // lea rdi, [rbp - dst_start*8]
        em32(0 - dst_start * 8)
        em(0xb9); em32(nslots)            // mov ecx, nslots
        em(0xf3); em(0x48); em(0xa5)      // rep movsq
    } else {
        em(0x48); em(0x89); em(0xc2)
        var i: i64 = 0
        while i < nslots {
            em(0x48); em(0x8b); em(0x82); em32(i * 8)
            emit_store_var(dst_start - i)
            i = i + 1
        }
    }
}

fn emit_copy_agg_to_ptr_x86(field_ty: i64, field_hash: i64) with Mut, Panic, Div {
    // Copy nslots qwords from [rdx] to [rax] (both pointers)
    var nslots: i64 = 0
    if field_ty == 8 {
        nslots = arr_storage_slots(field_hash)
    } else if type_is_option_inline(field_ty, field_hash) {
        nslots = 2
    } else if type_is_struct_like(field_ty, field_hash) || knowledge_hash_is(field_hash) {
        nslots = struct_like_nslots(field_hash)
    }
    if nslots <= 0 { return }
    if nslots > 32 {
        // rep movsq: rsi=rdx (source), rdi=rax (dest)
        em(0x48); em(0x89); em(0xd6)      // mov rsi, rdx
        em(0x48); em(0x89); em(0xc7)      // mov rdi, rax
        em(0xb9); em32(nslots)            // mov ecx, nslots
        em(0xf3); em(0x48); em(0xa5)      // rep movsq
    } else {
        var i: i64 = 0
        while i < nslots {
            em(0x48); em(0x8b); em(0x8a); em32(i * 8)  // mov rcx, [rdx + i*8]
            em(0x48); em(0x89); em(0x88); em32(i * 8)  // mov [rax + i*8], rcx
            i = i + 1
        }
    }
}

fn emit_store_to_pointer_offset_x86(lslot: i64, byte_off: i64, target_ty: i64, target_hash: i64) with Mut, Panic, Div {
    if type_is_aggregate(target_ty, target_hash) {
        em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (source aggregate pointer)
        emit_load_var(lslot)
        if byte_off != 0 { em(0x48); em(0x8d); em(0x80); em32(byte_off) }
        emit_copy_agg_to_ptr_x86(target_ty, target_hash)
        return
    }
    em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (scalar value)
    emit_load_var(lslot)
    if byte_off != 0 { em(0x48); em(0x8d); em(0x80); em32(byte_off) }
    em(0x48); em(0x89); em(0x10)  // mov [rax], rdx
    return
}

fn fill_repeat_struct_array_slots_x86(dst_start: i64, field_hash: i64) with Mut, Panic, Div {
    let nslots = arr_storage_slots(field_hash)
    let elem_hash = arr_hash_elem_hash(field_hash)
    if elem_hash != 0 {
        let elem_nslots = struct_like_nslots(elem_hash)
        if elem_nslots > 0 {
            let src_slot = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var(src_slot)
            var j: i64 = 0
            while j < nslots {
                emit_pool_alloc_x86(elem_nslots * 8)
                em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (dest)
                emit_load_var(src_slot)
                em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (source)
                em(0x48); em(0x89); em(0xc8)  // mov rax, rcx (dest)
                emit_copy_agg_to_ptr_x86(6, elem_hash)
                emit_store_var(dst_start - j)
                j = j + 1
            }
            return
        }
        // nested array: elem is itself an array — create separate copy per outer slot
        let inner_nslots = arr_storage_slots(elem_hash)
        if inner_nslots > 0 {
            let src_slot = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var(src_slot)
            var j: i64 = 0
            while j < nslots {
                // allocate inner_nslots * 8 bytes for this outer slot's copy
                emit_pool_alloc_x86(inner_nslots * 8)
                // rax = new inner array ptr; set up copy from src
                let new_ptr_slot = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var(new_ptr_slot)          // save new ptr
                emit_load_var(src_slot)               // rax = src ptr
                em(0x48); em(0x89); em(0xc2)          // mov rdx, rax (src)
                emit_load_var(new_ptr_slot)           // rax = dst ptr
                emit_copy_agg_to_ptr_x86(8, elem_hash)  // copy inner_nslots qwords
                emit_load_var(new_ptr_slot)
                emit_store_var(dst_start - j)
                j = j + 1
            }
            return
        }
    }
    var i: i64 = 0
    while i < nslots {
        emit_store_var(dst_start - i)
        i = i + 1
    }
}

fn stabilize_return_agg_x86(expr_ty: i64, expr_hash: i64) with Mut, Panic, Div {
    var nslots = ret_agg_nslots(CURRENT_RET_TY, CURRENT_RET_HASH)
    if nslots <= 0 { nslots = ret_agg_nslots(expr_ty, expr_hash) }
    if nslots <= 0 { return }
    em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (src ptr)
    if CURRENT_SRET_SLOT > 0 {
        // Use r12 (callee-saved, set at prologue) as SRET pointer — immune to stack corruption
        em(0x4c); em(0x89); em(0xe1)  // mov rcx, r12
    } else {
        let dst = GL_BSS_BASE + RET_AGG_BSS_OFF
        em(0x48); em(0xb9); em64(dst)  // mov rcx, dst ptr
    }
    if nslots > 32 {
        em(0x48); em(0x89); em(0xd6)      // mov rsi, rdx (source)
        em(0x48); em(0x89); em(0xcf)      // mov rdi, rcx (dest)
        em(0xb9); em32(nslots)            // mov ecx, nslots
        em(0xf3); em(0x48); em(0xa5)      // rep movsq
    } else {
        var i: i64 = 0
        while i < nslots {
            em(0x48); em(0x8b); em(0x82); em32(i * 8)  // mov rax, [rdx + i*8]
            em(0x48); em(0x89); em(0x81); em32(i * 8)  // mov [rcx + i*8], rax
            i = i + 1
        }
    }
    if CURRENT_SRET_SLOT > 0 {
        em(0x4c); em(0x89); em(0xe0)  // mov rax, r12 (return SRET ptr in rax)
    } else {
        let dst2 = GL_BSS_BASE + RET_AGG_BSS_OFF
        em(0x48); em(0xb8); em64(dst2)
    }
}

// ─── Emit print("string") ───
fn emit_print(tok: i64) with Mut, Panic, Div {
    let ss = TS[tok as usize] + 1
    let se = TE[tok as usize] - 1
    var slen: i64 = 0
    var zi: i64 = 0
    while zi < 256 { SQW[zi as usize] = 0; zi = zi + 1 }
    var si: i64 = ss
    while si < se {
        let c = sb(si)
        var byte: i64 = c
        if c == 92 && si + 1 < se {
            let c2 = sb(si + 1)
            if c2 == 120 && si + 3 < se {
                let h1 = sb(si + 2)
                let h2 = sb(si + 3)
                var v1: i64 = 0 - 1
                if h1 >= 48 && h1 <= 57 { v1 = h1 - 48 }
                else if h1 >= 97 && h1 <= 102 { v1 = h1 - 87 }
                else if h1 >= 65 && h1 <= 70 { v1 = h1 - 55 }
                var v2: i64 = 0 - 1
                if h2 >= 48 && h2 <= 57 { v2 = h2 - 48 }
                else if h2 >= 97 && h2 <= 102 { v2 = h2 - 87 }
                else if h2 >= 65 && h2 <= 70 { v2 = h2 - 55 }
                if v1 >= 0 && v2 >= 0 {
                    byte = v1 * 16 + v2
                    si = si + 4
                } else {
                    byte = c2
                    si = si + 2
                }
            } else {
                if c2 == 110 { byte = 10 }
                else if c2 == 116 { byte = 9 }
                else if c2 == 48 { byte = 0 }
                else { byte = c2 }
                si = si + 2
            }
        } else { si = si + 1 }
        let qi = slen / 8
        let bi = slen - qi * 8
        SQW[qi as usize] = SQW[qi as usize] | (byte << (bi * 8))
        slen = slen + 1
    }
    let nq = (slen + 7) / 8
    var qi: i64 = nq - 1
    while qi >= 0 { em(0x48); em(0xb8); em64(SQW[qi as usize]); em(0x50); qi = qi - 1 }
    em(0xb8); em32(1); em(0xbf); em32(1)
    em(0x48); em(0x89); em(0xe6)
    em(0xba); em32(slen)
    em(0x0f); em(0x05)
    em(0x48); em(0x81); em(0xc4); em32(nq * 8)
}

fn emit_print_cstr() with Mut {
    // rax = C string pointer
    em(0x48); em(0x89); em(0xc7)  // mov rdi, rax (ptr)
    em(0x48); em(0x31); em(0xc9)  // xor rcx, rcx
    let slp = CL
    em(0x80); em(0x3c); em(0x0f); em(0x00)  // cmp byte [rdi+rcx], 0
    em(0x74); em(0x04)  // je done
    em(0x48); em(0xff); em(0xc1)  // inc rcx
    em(0xeb); em(0xf5 as i64 & 0xFF)  // jmp loop
    em(0x48); em(0x89); em(0xfe)  // mov rsi, rdi
    em(0x48); em(0x89); em(0xca)  // mov rdx, rcx
    em(0xb8); em32(1)
    em(0xbf); em32(1)
    em(0x0f); em(0x05)
}

fn emit_print_nl() with Mut {
    em(0x6a); em(10)  // push '\n'
    em(0xb8); em32(1)
    em(0xbf); em32(1)
    em(0x48); em(0x89); em(0xe6)
    em(0xba); em32(1)
    em(0x0f); em(0x05)
    em(0x48); em(0x83); em(0xc4); em(8)
}

fn emit_assert_fail() with Mut {
    em(0xbf); em32(1)
    em(0xb8); em32(60)
    em(0x0f); em(0x05)
}

