fn compile_indexed_field_field_array_store_a64() with IO, Mut, Panic, Div {
    let root_tok = EP
    let ns = TS[EP as usize]; let ne = TE[EP as usize]
    let array_field_tok = EP + 2
    let afns = TS[array_field_tok as usize]; let afne = TE[array_field_tok as usize]
    let array_fh = gl_name_hash(afns, afne)
    EP = EP + 4
    let slot_outer_idx = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    compile_or_a64()
    if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
    if TK[EP as usize] == 42 { EP = EP + 1 }
    emit_store_var_a64(slot_outer_idx)
    if TK[EP as usize] == 50 { EP = EP + 1 }
    let leaf_field_tok = EP
    let lfns = TS[EP as usize]; let lfne = TE[EP as usize]
    let leaf_fh = gl_name_hash(lfns, lfne)
    EP = EP + 1
    if TK[EP as usize] == 41 { EP = EP + 1 }
    let slot_inner_idx = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    compile_or_a64()
    if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
    if TK[EP as usize] == 42 { EP = EP + 1 }
    emit_store_var_a64(slot_inner_idx)
    if TK[EP as usize] == 16 { EP = EP + 1 }
    let slot_val = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    compile_or_a64()
    emit_store_var_a64(slot_val)
    ST_QUERY_NS = afns
    ST_QUERY_NE = afne
    let root_si = resolve_field_struct_index(ns, ne, array_fh)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if root_si < 0 {
        tc_error(array_field_tok, "unknown field access")
        return
    }
    if st_private_access_denied(root_si, array_field_tok) {
        tc_error_hard(array_field_tok, "private struct field access")
        return
    }
    ST_QUERY_NS = afns
    ST_QUERY_NE = afne
    let array_off = st_field_offset(root_si, array_fh)
    let array_ty = st_field_ty(root_si, array_fh)
    let array_hash = st_field_hash(root_si, array_fh)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if array_ty != 8 {
        tc_error(array_field_tok, "indexed field store requires array field")
        return
    }
    if arr_hash_elem_ty(array_hash) != 6 {
        tc_error(array_field_tok, "indexed field store requires struct array element")
        return
    }
    var elem_si: i64 = -1
    let elem_hash = arr_hash_elem_hash(array_hash)
    if elem_hash != 0 { elem_si = st_find(elem_hash) }
    ST_QUERY_NS = lfns
    ST_QUERY_NE = lfne
    if elem_si < 0 { elem_si = resolve_struct_index_by_field(leaf_fh) }
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if elem_si < 0 {
        tc_error(leaf_field_tok, "unknown field access")
        return
    }
    if st_private_access_denied(elem_si, leaf_field_tok) {
        tc_error_hard(leaf_field_tok, "private struct field access")
        return
    }
    ST_QUERY_NS = lfns
    ST_QUERY_NE = lfne
    let leaf_off = st_field_offset(elem_si, leaf_fh)
    let leaf_ty = st_field_ty(elem_si, leaf_fh)
    let leaf_hash = st_field_hash(elem_si, leaf_fh)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if leaf_ty != 8 {
        tc_error(leaf_field_tok, "indexed field store requires array leaf field")
        return
    }
    let leaf_esiz = arr_hash_esiz(leaf_hash)
    let slot = var_find(ns, ne)
    if slot >= 0 { emit_load_var_a64(slot) }
    else {
        let gi = gl_find(ns, ne)
        if gi >= 0 { emit_image_addr_a64(GL_BSS_BASE + GL[(gi * 4 + 1) as usize]) }
        else { tc_undefined_var(root_tok); em32(0xD2800000) }
    }
    if array_off != 0 {
        emit_imm64_reg_a64(11, array_off)
        em32(0x8B0B0000)
    }
    let slot_array_base = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var_a64(slot_array_base)
    emit_load_var_a64(slot_outer_idx)
    em32(0xAA0003E1)
    emit_load_var_a64(slot_array_base)
    em32(0xF8617800)
    if leaf_off != 0 {
        emit_imm64_reg_a64(11, leaf_off)
        em32(0x8B0B0000)
    }
    let slot_leaf_base = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var_a64(slot_leaf_base)
    emit_load_var_a64(slot_inner_idx)
    em32(0xAA0003E1)
    emit_load_var_a64(slot_val)
    em32(0xAA0003EA)
    emit_load_var_a64(slot_leaf_base)
    if leaf_esiz == 8 { em32(0xF821780A) }
    else { em32(0x3821680A) }
}

// root.array_field[idx].leaf = expr — AArch64 mirror of
// compile_indexed_field_field_store_x86. Array-of-struct elements are stored as
// pointers, so load the element pointer before applying the leaf-field offset.
fn compile_indexed_field_field_store_a64() with IO, Mut, Panic, Div {
    let root_tok = EP
    let ns = TS[EP as usize]
    let ne = TE[EP as usize]
    let array_field_tok = EP + 2
    let afns = TS[array_field_tok as usize]
    let afne = TE[array_field_tok as usize]
    let array_fh = gl_name_hash(afns, afne)

    EP = EP + 4
    let slot_idx = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    compile_or_a64()
    if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
    if TK[EP as usize] == 42 { EP = EP + 1 }
    emit_store_var_a64(slot_idx)
    if TK[EP as usize] == 50 { EP = EP + 1 }

    let leaf_field_tok = EP
    let lfns = TS[EP as usize]
    let lfne = TE[EP as usize]
    let leaf_fh = gl_name_hash(lfns, lfne)
    EP = EP + 1
    if TK[EP as usize] == 16 { EP = EP + 1 }

    let slot_val = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    compile_or_a64()
    let rhs_ty = EXPR_TY
    let rhs_ty_hash = EXPR_TY_HASH
    emit_store_var_a64(slot_val)

    ST_QUERY_NS = afns
    ST_QUERY_NE = afne
    let root_si = resolve_field_struct_index(ns, ne, array_fh)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if root_si < 0 {
        tc_error(array_field_tok, "unknown field access")
        return
    }
    if st_private_access_denied(root_si, array_field_tok) {
        tc_error_hard(array_field_tok, "private struct field access")
        return
    }
    ST_QUERY_NS = afns
    ST_QUERY_NE = afne
    let array_off = st_field_offset(root_si, array_fh)
    let array_ty = st_field_ty(root_si, array_fh)
    let array_hash = st_field_hash(root_si, array_fh)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if array_ty != 8 || arr_hash_elem_ty(array_hash) != 6 {
        tc_error(array_field_tok, "indexed field store requires struct array element")
        return
    }

    var elem_si: i64 = -1
    let elem_hash = arr_hash_elem_hash(array_hash)
    if elem_hash != 0 { elem_si = st_find(elem_hash) }
    ST_QUERY_NS = lfns
    ST_QUERY_NE = lfne
    if elem_si < 0 { elem_si = resolve_struct_index_by_field(leaf_fh) }
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if elem_si < 0 {
        tc_error(leaf_field_tok, "unknown field access")
        return
    }
    if st_private_access_denied(elem_si, leaf_field_tok) {
        tc_error_hard(leaf_field_tok, "private struct field access")
        return
    }
    ST_QUERY_NS = lfns
    ST_QUERY_NE = lfne
    let leaf_off = st_field_offset(elem_si, leaf_fh)
    let leaf_ty = st_field_ty(elem_si, leaf_fh)
    let leaf_hash = st_field_hash(elem_si, leaf_fh)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if leaf_off < 0 {
        tc_error(leaf_field_tok, "unknown field access")
        return
    }
    if leaf_ty != 0 && ty_eq(leaf_ty, leaf_hash, rhs_ty, rhs_ty_hash) == false {
        tc_error_hard(EP - 1, "assignment type mismatch")
    }

    let slot = var_find(ns, ne)
    if slot >= 0 { emit_load_var_a64(slot) }
    else {
        let gi = gl_find(ns, ne)
        if gi >= 0 { emit_image_addr_a64(GL_BSS_BASE + GL[(gi * 4 + 1) as usize]) }
        else { tc_undefined_var(root_tok); em32(0xD2800000) }
    }
    if array_off != 0 {
        emit_imm64_reg_a64(11, array_off)
        em32(0x8B0B0000)
    }
    let slot_array_base = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var_a64(slot_array_base)
    emit_load_var_a64(slot_idx)
    em32(0xAA0003E1)  // mov x1, x0 (index)
    emit_load_var_a64(slot_array_base)
    em32(0xF8617800)  // ldr x0, [x0, x1, lsl #3] (element pointer)
    if leaf_off != 0 {
        emit_imm64_reg_a64(11, leaf_off)
        em32(0x8B0B0000)
    }
    let slot_leaf_ptr = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var_a64(slot_leaf_ptr)
    emit_load_var_a64(slot_val)
    em32(0xAA0003EA)  // mov x10, x0 (value/source pointer)
    emit_load_var_a64(slot_leaf_ptr)
    if type_is_aggregate(leaf_ty, leaf_hash) {
        emit_copy_agg_to_ptr_a64(leaf_ty, leaf_hash)
    } else {
        em32(0xF900000A)  // str x10, [x0]
    }
}

fn resolve_struct_index_by_field(fh: i64) -> i64 with Panic, Div, Mut {
    var si: i64 = 0
    while si < ST_COUNT {
        if st_field_offset(si, fh) >= 0 { return si }
        si = si + 1
    }
    return -1
}

fn materialize_aggregate_array_element_x86(array_hash: i64) with Mut, Panic, Div {
    let elem_hash = arr_hash_elem_hash(array_hash)
    if elem_hash == 0 { return }
    let elem_nslots = struct_like_nslots(elem_hash)
    if elem_nslots <= 0 { return }
    let src_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    let dst_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var(src_slot)
    emit_pool_alloc_x86(elem_nslots * 8)
    emit_store_var(dst_slot)
    emit_load_var(src_slot)
    em(0x48); em(0x89); em(0xc2)
    emit_load_var(dst_slot)
    emit_copy_agg_to_ptr_x86(6, elem_hash)
}

fn materialize_aggregate_array_element_a64(array_hash: i64) with Mut, Panic, Div {
    let elem_hash = arr_hash_elem_hash(array_hash)
    if elem_hash == 0 { return }
    let elem_nslots = struct_like_nslots(elem_hash)
    if elem_nslots <= 0 { return }
    let src_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    let dst_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var_a64(src_slot)
    emit_imm64_a64(elem_nslots * 8)
    emit_heap_alloc_a64()
    emit_store_var_a64(dst_slot)
    emit_load_var_a64(src_slot)
    em32(0xAA0003EA)
    emit_load_var_a64(dst_slot)
    emit_copy_agg_to_ptr_a64(6, elem_hash)
}

// name.f1.f2 = expr — AUTO-DEREF two-level scalar store (pointer root). a64
// mirror of compile_autoderef_field_field_store_x86.
fn compile_autoderef_field_field_store_a64() with IO, Mut, Panic, Div {
    let name_tok = EP + 0
    let f1_tok = EP + 2
    let f2_tok = EP + 4
    if current_fn_allows_mutation() == false {
        tc_effect_violation(f2_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
    }
    let ns = TS[name_tok as usize]
    let ne = TE[name_tok as usize]
    let fh1 = gl_name_hash(TS[f1_tok as usize], TE[f1_tok as usize])
    let fh2 = gl_name_hash(TS[f2_tok as usize], TE[f2_tok as usize])
    EP = EP + 6  // skip name . f1 . f2 =
    compile_or_a64()  // rhs in x0
    let rhs_ty = EXPR_TY
    let rhs_ty_hash = EXPR_TY_HASH
    let lslot = var_find(ns, ne)
    if lslot < 0 {
        tc_undefined_var(name_tok)
        return
    }
    let lvi = var_find_idx(ns, ne)
    if lvi < 0 || type_is_pointer_like(VAR_TY[lvi as usize], VAR_TY_HASH[lvi as usize]) == false {
        tc_error(f1_tok, "field access through deref requires ref or pointer binding")
        return
    }
    let inner_ty = ptr_hash_inner_ty(VAR_TY_HASH[lvi as usize])
    let inner_hash = ptr_hash_inner_hash(VAR_TY_HASH[lvi as usize])
    if inner_ty != 6 {
        tc_error(f1_tok, "field access through pointer/ref requires struct pointee")
        return
    }
    let si1 = st_find(inner_hash)
    if si1 < 0 {
        tc_error(f1_tok, "unknown field access")
        return
    }
    ST_QUERY_NS = TS[f1_tok as usize]
    ST_QUERY_NE = TE[f1_tok as usize]
    let foff1 = st_field_offset(si1, fh1)
    let fty1 = st_field_ty(si1, fh1)
    let fhash1 = st_field_hash(si1, fh1)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if foff1 < 0 || fty1 != 6 {
        tc_error(f1_tok, "nested field store requires inline struct field")
        return
    }
    let si2 = st_find(fhash1)
    if si2 < 0 {
        tc_error(f2_tok, "unknown field access")
        return
    }
    ST_QUERY_NS = TS[f2_tok as usize]
    ST_QUERY_NE = TE[f2_tok as usize]
    let foff2 = st_field_offset(si2, fh2)
    let fty2 = st_field_ty(si2, fh2)
    let fhash2 = st_field_hash(si2, fh2)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if foff2 < 0 {
        tc_error(f2_tok, "unknown field access")
        return
    }
    if ty_eq(fty2, fhash2, rhs_ty, rhs_ty_hash) == false {
        tc_error(EP - 1, "assignment type mismatch")
    }
    emit_store_to_pointer_offset_a64(lslot, foff1 + foff2, fty2, fhash2)
}

// name.f1.f2 = expr — VALUE two-level scalar store (value-struct root). a64
// mirror of compile_value_field_field_store_x86 — see that function's comment
// for the rationale (a value-struct local's slot holds a pointer to the
// struct, so emit_store_to_pointer_offset_a64 stores correctly).
fn compile_value_field_field_store_a64() with IO, Mut, Panic, Div {
    let name_tok = EP + 0
    let f1_tok = EP + 2
    let f2_tok = EP + 4
    if current_fn_allows_mutation() == false {
        tc_effect_violation(f2_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
    }
    let ns = TS[name_tok as usize]
    let ne = TE[name_tok as usize]
    let fh1 = gl_name_hash(TS[f1_tok as usize], TE[f1_tok as usize])
    let fh2 = gl_name_hash(TS[f2_tok as usize], TE[f2_tok as usize])
    EP = EP + 6  // skip name . f1 . f2 =
    compile_or_a64()  // rhs in x0
    let rhs_ty = EXPR_TY
    let rhs_ty_hash = EXPR_TY_HASH
    let lslot = var_find(ns, ne)
    if lslot < 0 {
        tc_undefined_var(name_tok)
        return
    }
    ST_QUERY_NS = TS[f1_tok as usize]
    ST_QUERY_NE = TE[f1_tok as usize]
    let si1 = resolve_field_struct_index(ns, ne, fh1)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if si1 < 0 {
        tc_error(f1_tok, "unknown field access")
        return
    }
    ST_QUERY_NS = TS[f1_tok as usize]
    ST_QUERY_NE = TE[f1_tok as usize]
    let foff1 = st_field_offset(si1, fh1)
    let fty1 = st_field_ty(si1, fh1)
    let fhash1 = st_field_hash(si1, fh1)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if foff1 < 0 || fty1 != 6 {
        tc_error(f1_tok, "nested field store requires inline struct field")
        return
    }
    let si2 = st_find(fhash1)
    if si2 < 0 {
        tc_error(f2_tok, "unknown field access")
        return
    }
    ST_QUERY_NS = TS[f2_tok as usize]
    ST_QUERY_NE = TE[f2_tok as usize]
    let foff2 = st_field_offset(si2, fh2)
    let fty2 = st_field_ty(si2, fh2)
    let fhash2 = st_field_hash(si2, fh2)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if foff2 < 0 {
        tc_error(f2_tok, "unknown field access")
        return
    }
    if ty_eq(fty2, fhash2, rhs_ty, rhs_ty_hash) == false {
        tc_error(EP - 1, "assignment type mismatch")
    }
    emit_store_to_pointer_offset_a64(lslot, foff1 + foff2, fty2, fhash2)
}

// name.f1.f2[idx] = expr — AUTO-DEREF two-level array store (pointer root).
// a64 mirror of compile_autoderef_field_field_array_store_x86.
fn compile_autoderef_field_field_array_store_a64() with IO, Mut, Panic, Div {
    let name_tok = EP + 0
    let ns = TS[name_tok as usize]
    let ne = TE[name_tok as usize]
    let f1_tok = EP + 2
    let f2_tok = EP + 4
    let fh1 = gl_name_hash(TS[f1_tok as usize], TE[f1_tok as usize])
    let fh2 = gl_name_hash(TS[f2_tok as usize], TE[f2_tok as usize])
    if current_fn_allows_mutation() == false {
        tc_effect_violation(f2_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
    }
    EP = EP + 6  // skip name . f1 . f2 [
    compile_or_a64()  // index in x0
    if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }  // 'as usize'
    if TK[EP as usize] == 42 { EP = EP + 1 }  // ]
    if TK[EP as usize] == 16 { EP = EP + 1 }  // =
    emit_push_a64()  // push index
    compile_or_a64()  // value in x0
    let rhs_ty = EXPR_TY
    let rhs_ty_hash = EXPR_TY_HASH
    let lslot = var_find(ns, ne)
    let lvi = var_find_idx(ns, ne)
    if lslot < 0 || lvi < 0 || type_is_pointer_like(VAR_TY[lvi as usize], VAR_TY_HASH[lvi as usize]) == false {
        tc_error(f1_tok, "field access through deref requires ref or pointer binding")
        emit_pop_x1_a64()
        return
    }
    let inner_ty = ptr_hash_inner_ty(VAR_TY_HASH[lvi as usize])
    let inner_hash = ptr_hash_inner_hash(VAR_TY_HASH[lvi as usize])
    if inner_ty != 6 {
        tc_error(f1_tok, "field access through pointer/ref requires struct pointee")
        emit_pop_x1_a64()
        return
    }
    let si1 = st_find(inner_hash)
    if si1 < 0 {
        tc_error(f1_tok, "unknown field access")
        emit_pop_x1_a64()
        return
    }
    ST_QUERY_NS = TS[f1_tok as usize]
    ST_QUERY_NE = TE[f1_tok as usize]
    let foff1 = st_field_offset(si1, fh1)
    let fty1 = st_field_ty(si1, fh1)
    let fhash1 = st_field_hash(si1, fh1)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if foff1 < 0 || fty1 != 6 {
        tc_error(f1_tok, "nested field store requires inline struct field")
        emit_pop_x1_a64()
        return
    }
    let si2 = st_find(fhash1)
    if si2 < 0 {
        tc_error(f2_tok, "unknown field access")
        emit_pop_x1_a64()
        return
    }
    ST_QUERY_NS = TS[f2_tok as usize]
    ST_QUERY_NE = TE[f2_tok as usize]
    let foff2 = st_field_offset(si2, fh2)
    let fty2 = st_field_ty(si2, fh2)
    let fhash2 = st_field_hash(si2, fh2)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if foff2 < 0 || fty2 != 8 {
        tc_error(f2_tok, "indexed field store requires array field")
        emit_pop_x1_a64()
        return
    }
    if ty_eq(arr_hash_elem_ty(fhash2), arr_hash_elem_hash(fhash2), rhs_ty, rhs_ty_hash) == false {
        tc_error(EP - 1, "assignment type mismatch")
    }
    materialize_aggregate_array_element_a64(fhash2)
    em32(0xAA0003EA)  // mov x10, x0 (value)
    emit_pop_x1_a64()  // x1 = index
    emit_load_var_a64(lslot)  // x0 = base pointer
    let total_off = foff1 + foff2
    if total_off != 0 {
        emit_imm64_reg_a64(11, total_off)
        em32(0x8B0B0000)  // add x0, x0, x11
    }
    if arr_hash_esiz(fhash2) == 8 { em32(0xF821780A) }  // str x10, [x0, x1, lsl #3]
    else { em32(0x3821680A) }  // strb w10, [x0, x1]
}

// name.f1.f2[idx] = expr — VALUE two-level array store (value-struct root).
// a64 mirror of compile_value_field_field_array_store_x86 — see that
// function's comment for the rationale. Without this handler (and its
// autoderef/no-array siblings above), a64 had no dispatch entry at all for
// any two-level field chain assignment (`o.inner.b = v`, `o.inner.vals[i] =
// v`) — the statement silently fell through every existing shape check and
// the store never happened, with no diagnostic.
fn compile_value_field_field_array_store_a64() with IO, Mut, Panic, Div {
    let name_tok = EP
    let ns = TS[name_tok as usize]
    let ne = TE[name_tok as usize]
    let f1_tok = EP + 2
    let f2_tok = EP + 4
    let f1ns = TS[f1_tok as usize]
    let f1ne = TE[f1_tok as usize]
    let f2ns = TS[f2_tok as usize]
    let f2ne = TE[f2_tok as usize]
    let f1h = gl_name_hash(f1ns, f1ne)
    let f2h = gl_name_hash(f2ns, f2ne)

    EP = EP + 6
    compile_or_a64()  // index in x0
    if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
    if TK[EP as usize] == 42 { EP = EP + 1 }
    if TK[EP as usize] == 16 { EP = EP + 1 }
    emit_push_a64()  // push index
    compile_or_a64()  // value in x0
    let rhs_ty = EXPR_TY
    let rhs_ty_hash = EXPR_TY_HASH

    ST_QUERY_NS = f1ns
    ST_QUERY_NE = f1ne
    let si1 = resolve_field_struct_index(ns, ne, f1h)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if si1 < 0 {
        tc_error(f1_tok, "unknown field access")
        emit_pop_x1_a64()
        return
    }
    if st_private_access_denied(si1, f1_tok) {
        tc_error_hard(f1_tok, "private struct field access")
        emit_pop_x1_a64()
        return
    }
    ST_QUERY_NS = f1ns
    ST_QUERY_NE = f1ne
    let foff1 = st_field_offset(si1, f1h)
    let fty1 = st_field_ty(si1, f1h)
    let fhash1 = st_field_hash(si1, f1h)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if foff1 < 0 || fty1 != 6 {
        tc_error(f1_tok, "nested field store requires inline struct field")
        emit_pop_x1_a64()
        return
    }
    let si2 = st_find(fhash1)
    if si2 < 0 {
        tc_error(f1_tok, "nested field store requires known struct field type")
        emit_pop_x1_a64()
        return
    }
    if st_private_access_denied(si2, f2_tok) {
        tc_error_hard(f2_tok, "private struct field access")
        emit_pop_x1_a64()
        return
    }
    ST_QUERY_NS = f2ns
    ST_QUERY_NE = f2ne
    let foff2 = st_field_offset(si2, f2h)
    let fty2 = st_field_ty(si2, f2h)
    let fhash2 = st_field_hash(si2, f2h)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if foff2 < 0 || fty2 != 8 {
        tc_error(f2_tok, "indexed field store requires array field")
        emit_pop_x1_a64()
        return
    }
    if ty_eq(arr_hash_elem_ty(fhash2), arr_hash_elem_hash(fhash2), rhs_ty, rhs_ty_hash) == false {
        tc_error(EP - 1, "assignment type mismatch")
    }
    materialize_aggregate_array_element_a64(fhash2)
    em32(0xAA0003EA)  // mov x10, x0 (value)
    emit_pop_x1_a64()  // x1 = index
    let slot = var_find(ns, ne)
    if slot >= 0 {
        emit_load_var_a64(slot)
    } else {
        let gi = gl_find(ns, ne)
        if gi >= 0 {
            emit_image_addr_a64(GL_BSS_BASE + GL[(gi * 4 + 1) as usize])
        } else {
            tc_undefined_var(name_tok)
            em32(0xD2800000)
        }
    }
    let total_off = foff1 + foff2
    if total_off != 0 {
        emit_imm64_reg_a64(11, total_off)
        em32(0x8B0B0000)  // add x0, x0, x11
    }
    if arr_hash_esiz(fhash2) == 8 { em32(0xF821780A) }  // str x10, [x0, x1, lsl #3]
    else { em32(0x3821680A) }  // strb w10, [x0, x1]
}

// ARRAY[idx].field(.field)* = expr — store into a struct element of an array.
// Array-of-struct slots hold 8-byte pointers to heap-materialized struct copies
// (see materialize_aggregate_array_element_x86), so the element pointer is
// [base + idx*8]; we then add the inline field-chain offset and store at the
// leaf. Distinct from compile_indexed_field_field_store_x86 (root struct's array
// field) and compile_nested_field_store_x86 (root struct base, no index).
fn compile_array_elem_field_store_x86() with IO, Mut, Panic, Div {
    let name_tok = EP
    let ns = TS[EP as usize]
    let ne = TE[EP as usize]
    if current_fn_allows_mutation() == false {
        tc_effect_violation(name_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
    }
    var array_hash: i64 = 0
    var is_global: i64 = 0
    let gi = gl_find(ns, ne)
    var lslot: i64 = 0 - 1
    if gi >= 0 {
        is_global = 1
        array_hash = GL_TY_HASH[gi as usize]
    } else {
        lslot = var_find(ns, ne)
        let lvi = var_find_idx(ns, ne)
        if lslot < 0 || lvi < 0 {
            tc_undefined_var(name_tok)
            return
        }
        if VAR_TY[lvi as usize] == 8 {
            array_hash = VAR_TY_HASH[lvi as usize]
        } else if VAR_TY[lvi as usize] == 10 && ref_hash_inner_ty(VAR_TY_HASH[lvi as usize]) == 8 {
            array_hash = ref_hash_inner_hash(VAR_TY_HASH[lvi as usize])
        } else {
            tc_error(name_tok, "array-element field store requires an array of structs")
            return
        }
    }
    if arr_hash_elem_ty(array_hash) != 6 {
        tc_error(name_tok, "array-element field store requires struct array element")
        return
    }
    let elem_hash = arr_hash_elem_hash(array_hash)
    var elem_si: i64 = 0 - 1
    if elem_hash != 0 { elem_si = st_find(elem_hash) }
    if elem_si < 0 {
        tc_error(name_tok, "array-element field store requires a known struct element")
        return
    }

    EP = EP + 1
    EP = EP + 1
    compile_or()
    if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
    if TK[EP as usize] == 42 { EP = EP + 1 }
    em(0x50)

    var cur_si = elem_si
    var total_off: i64 = 0
    var leaf_ty: i64 = 0
    var leaf_hash: i64 = 0
    var leaf_tok: i64 = 0 - 1
    var bad: bool = false
    var done: bool = false
    while done == false && TK[EP as usize] == 50 {
        EP = EP + 1
        leaf_tok = EP
        let fns = TS[EP as usize]
        let fne = TE[EP as usize]
        let fh = gl_name_hash(fns, fne)
        EP = EP + 1
        ST_QUERY_NS = fns
        ST_QUERY_NE = fne
        let off = st_field_offset(cur_si, fh)
        let fty = st_field_ty(cur_si, fh)
        let fhash = st_field_hash(cur_si, fh)
        ST_QUERY_NS = 0 - 1
        ST_QUERY_NE = 0 - 1
        if off < 0 {
            tc_error(leaf_tok, "unknown field access")
            bad = true
            done = true
        } else {
            total_off = total_off + off
            if TK[EP as usize] == 16 {
                leaf_ty = fty
                leaf_hash = fhash
                done = true
            } else {
                let nsi = st_find(fhash)
                if nsi < 0 {
                    tc_error(leaf_tok, "array-element field store requires inline struct field")
                    bad = true
                    done = true
                } else {
                    cur_si = nsi
                }
            }
        }
    }
    if bad {
        em(0x58)
        return
    }
    if TK[EP as usize] == 16 { EP = EP + 1 }

    compile_or()
    let rhs_ty = EXPR_TY
    let rhs_ty_hash = EXPR_TY_HASH
    if leaf_ty != 0 && ty_eq(leaf_ty, leaf_hash, rhs_ty, rhs_ty_hash) == false {
        tc_error_hard(EP - 1, "assignment type mismatch")
    }
    em(0x48); em(0x89); em(0xc2)
    em(0x59)
    if is_global == 1 {
        let base = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
        em(0x48); em(0xb8); em64(base)
    } else {
        emit_load_var(lslot)
    }
    em(0x48); em(0x8b); em(0x04); em(0xc8)
    if total_off != 0 { em(0x48); em(0x8d); em(0x80); em32(total_off) }
    if leaf_ty == 8 || type_is_option_inline(leaf_ty, leaf_hash) || leaf_ty == 6 || knowledge_hash_is(leaf_hash) {
        emit_copy_agg_to_ptr_x86(leaf_ty, leaf_hash)
    } else {
        em(0x48); em(0x89); em(0x10)
    }
}

fn compile_indexed_field_field_store_x86() with IO, Mut, Panic, Div {
    let root_tok = EP
    let ns = TS[EP as usize]
    let ne = TE[EP as usize]
    let array_field_tok = EP + 2
    let afns = TS[array_field_tok as usize]
    let afne = TE[array_field_tok as usize]
    let array_fh = gl_name_hash(afns, afne)

    EP = EP + 4
    compile_or()
    if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
    if TK[EP as usize] == 42 { EP = EP + 1 }
    if TK[EP as usize] == 50 { EP = EP + 1 }

    let leaf_field_tok = EP
    let lfns = TS[EP as usize]
    let lfne = TE[EP as usize]
    let leaf_fh = gl_name_hash(lfns, lfne)
    EP = EP + 1
    if TK[EP as usize] == 16 { EP = EP + 1 }

    em(0x50)
    compile_or()
    let rhs_ty = EXPR_TY
    let rhs_ty_hash = EXPR_TY_HASH

    let root_si = resolve_field_struct_index(ns, ne, array_fh)
    if root_si < 0 {
        tc_error(array_field_tok, "unknown field access")
        em(0x59)
        return
    }
    if st_private_access_denied(root_si, array_field_tok) {
        tc_error_hard(array_field_tok, "private struct field access")
        em(0x59)
        return
    }
                    ST_QUERY_NS = afns
                    ST_QUERY_NE = afne
    let array_off = st_field_offset(root_si, array_fh)
    let array_ty = st_field_ty(root_si, array_fh)
    let array_hash = st_field_hash(root_si, array_fh)
                    ST_QUERY_NS = -1
                    ST_QUERY_NE = -1
    if array_ty != 8 {
        tc_error(array_field_tok, "indexed field store requires array field")
        em(0x59)
        return
    }
    if arr_hash_elem_ty(array_hash) != 6 {
        tc_error(array_field_tok, "indexed field store requires struct array element")
        em(0x59)
        return
    }

    var elem_si: i64 = -1
    let elem_hash = arr_hash_elem_hash(array_hash)
    if elem_hash != 0 { elem_si = st_find(elem_hash) }
    ST_QUERY_NS = lfns
    ST_QUERY_NE = lfne
    if elem_si < 0 { elem_si = resolve_struct_index_by_field(leaf_fh) }
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if elem_si < 0 {
        tc_error(leaf_field_tok, "unknown field access")
        em(0x59)
        return
    }
    if st_private_access_denied(elem_si, leaf_field_tok) {
        tc_error_hard(leaf_field_tok, "private struct field access")
        em(0x59)
        return
    }
                    ST_QUERY_NS = lfns
                    ST_QUERY_NE = lfne
    let leaf_off = st_field_offset(elem_si, leaf_fh)
    let leaf_ty = st_field_ty(elem_si, leaf_fh)
    let leaf_hash = st_field_hash(elem_si, leaf_fh)
                    ST_QUERY_NS = -1
                    ST_QUERY_NE = -1
    if leaf_ty != 0 && ty_eq(leaf_ty, leaf_hash, rhs_ty, rhs_ty_hash) == false {
        tc_error(EP - 1, "assignment type mismatch")
    }

    em(0x48); em(0x89); em(0xc2)
    em(0x59)
    let slot = var_find(ns, ne)
    if slot >= 0 { emit_load_var(slot) }
    else {
        let gi = gl_find(ns, ne)
        if gi >= 0 {
            let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
            em(0x48); em(0xb8); em64(addr)
        } else {
            tc_undefined_var(root_tok)
            em(0x31); em(0xc0)
        }
    }
    if array_off != 0 { em(0x48); em(0x8d); em(0x80); em32(array_off) }
    em(0x48); em(0x8b); em(0x04); em(0xc8)
    if leaf_off != 0 { em(0x48); em(0x8d); em(0x80); em32(leaf_off) }

    if type_is_aggregate(leaf_ty, leaf_hash) {
        emit_copy_agg_to_ptr_x86(leaf_ty, leaf_hash)
    } else {
        em(0x48); em(0x89); em(0x10)
    }
}

fn compile_indexed_field_field_array_store_x86() with IO, Mut, Panic, Div {
    let root_tok = EP
    let ns = TS[EP as usize]
    let ne = TE[EP as usize]
    let array_field_tok = EP + 2
    let afns = TS[array_field_tok as usize]
    let afne = TE[array_field_tok as usize]
    let array_fh = gl_name_hash(afns, afne)
    EP = EP + 4
    let slot_outer_idx = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    compile_or()
    if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
    if TK[EP as usize] == 42 { EP = EP + 1 }
    emit_store_var(slot_outer_idx)
    if TK[EP as usize] == 50 { EP = EP + 1 }
    let leaf_field_tok = EP
    let lfns = TS[EP as usize]
    let lfne = TE[EP as usize]
    let leaf_fh = gl_name_hash(lfns, lfne)
    EP = EP + 1
    if TK[EP as usize] == 41 { EP = EP + 1 }
    let slot_inner_idx = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    compile_or()
    if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
    if TK[EP as usize] == 42 { EP = EP + 1 }
    emit_store_var(slot_inner_idx)
    if TK[EP as usize] == 16 { EP = EP + 1 }
    let slot_val = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    compile_or()
    emit_store_var(slot_val)
    ST_QUERY_NS = afns
    ST_QUERY_NE = afne
    let root_si = resolve_field_struct_index(ns, ne, array_fh)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if root_si < 0 {
        tc_error(array_field_tok, "unknown field access")
        return
    }
    if st_private_access_denied(root_si, array_field_tok) {
        tc_error_hard(array_field_tok, "private struct field access")
        return
    }
    ST_QUERY_NS = afns
    ST_QUERY_NE = afne
    let array_off = st_field_offset(root_si, array_fh)
    let array_ty = st_field_ty(root_si, array_fh)
    let array_hash = st_field_hash(root_si, array_fh)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if array_ty != 8 {
        tc_error(array_field_tok, "indexed field store requires array field")
        return
    }
    if arr_hash_elem_ty(array_hash) != 6 {
        tc_error(array_field_tok, "indexed field store requires struct array element")
        return
    }
    var elem_si: i64 = -1
    let elem_hash = arr_hash_elem_hash(array_hash)
    if elem_hash != 0 { elem_si = st_find(elem_hash) }
    ST_QUERY_NS = lfns
    ST_QUERY_NE = lfne
    if elem_si < 0 { elem_si = resolve_struct_index_by_field(leaf_fh) }
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if elem_si < 0 {
        tc_error(leaf_field_tok, "unknown field access")
        return
    }
    if st_private_access_denied(elem_si, leaf_field_tok) {
        tc_error_hard(leaf_field_tok, "private struct field access")
        return
    }
    ST_QUERY_NS = lfns
    ST_QUERY_NE = lfne
    let leaf_off = st_field_offset(elem_si, leaf_fh)
    let leaf_ty = st_field_ty(elem_si, leaf_fh)
    let leaf_hash = st_field_hash(elem_si, leaf_fh)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if leaf_ty != 8 {
        tc_error(leaf_field_tok, "indexed field store requires array leaf field")
        return
    }
    let leaf_esiz = arr_hash_esiz(leaf_hash)
    let slot = var_find(ns, ne)
    if slot >= 0 { emit_load_var(slot) }
    else {
        let gi = gl_find(ns, ne)
        if gi >= 0 {
            let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
            em(0x48); em(0xb8); em64(addr)
        } else {
            tc_undefined_var(root_tok)
            em(0x31); em(0xc0)
        }
    }
    if array_off != 0 { em(0x48); em(0x8d); em(0x80); em32(array_off) }
    let slot_array_base = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var(slot_array_base)
    emit_load_var(slot_outer_idx)
    em(0x48); em(0x89); em(0xc1)
    emit_load_var(slot_array_base)
    em(0x48); em(0x8b); em(0x04); em(0xc8)
    if leaf_off != 0 { em(0x48); em(0x8d); em(0x80); em32(leaf_off) }
    let slot_leaf_base = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var(slot_leaf_base)
    emit_load_var(slot_inner_idx)
    em(0x48); em(0x89); em(0xc1)
    emit_load_var(slot_val)
    em(0x48); em(0x89); em(0xc2)
    emit_load_var(slot_leaf_base)
    if leaf_esiz == 8 {
        em(0x48); em(0x89); em(0x14); em(0xc8)
    } else {
        em(0x88); em(0x14); em(0x08)
    }
}

// ─── Statement compiler ───
// (*name).field1.field2 = expr  — two-level nested scalar/aggregate store through a *mut.
// field1 is an INLINE struct field, so the target address is a FLAT offset from the
// pointer base: [ptr + off(field1) + off(field2)]. Mirrors the working one-field
// deref_field_store, resolving one level deeper and summing offsets.
fn compile_deref_field_field_store_x86() with IO, Mut, Panic, Div {
    let name_tok = EP + 2
    let field1_tok = EP + 5
    let field2_tok = EP + 7
    if current_fn_allows_mutation() == false {
        tc_effect_violation(field2_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
    }
    let ns = TS[name_tok as usize]
    let ne = TE[name_tok as usize]
    let fh1 = gl_name_hash(TS[field1_tok as usize], TE[field1_tok as usize])
    let fh2 = gl_name_hash(TS[field2_tok as usize], TE[field2_tok as usize])
    EP = EP + 9
    compile_or()
    let rhs_ty = EXPR_TY
    let rhs_ty_hash = EXPR_TY_HASH
    let lslot = var_find(ns, ne)
    if lslot < 0 {
        tc_undefined_var(name_tok)
        return
    }
    let lvi = var_find_idx(ns, ne)
    if lvi < 0 || type_is_pointer_like(VAR_TY[lvi as usize], VAR_TY_HASH[lvi as usize]) == false {
        tc_error(field1_tok, "field access through deref requires ref or pointer binding")
        return
    }
    let inner_ty = ptr_hash_inner_ty(VAR_TY_HASH[lvi as usize])
    let inner_hash = ptr_hash_inner_hash(VAR_TY_HASH[lvi as usize])
    if inner_ty != 6 {
        tc_error(field1_tok, "field access through pointer/ref requires struct pointee")
        return
    }
    let si1 = st_find(inner_hash)
    if si1 < 0 {
        tc_error(field1_tok, "unknown field access")
        return
    }
    if st_private_access_denied(si1, field1_tok) {
        tc_error_hard(field1_tok, "private struct field access")
        return
    }
    ST_QUERY_NS = TS[field1_tok as usize]
    ST_QUERY_NE = TE[field1_tok as usize]
    let foff1 = st_field_offset(si1, fh1)
    let fty1 = st_field_ty(si1, fh1)
    let fhash1 = st_field_hash(si1, fh1)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if foff1 < 0 {
        tc_error(field1_tok, "unknown field access")
        return
    }
    if fty1 != 6 {
        tc_error(field2_tok, "field access through pointer/ref requires struct pointee")
        return
    }
    let si2 = st_find(fhash1)
    if si2 < 0 {
        tc_error(field2_tok, "unknown field access")
        return
    }
    if st_private_access_denied(si2, field2_tok) {
        tc_error_hard(field2_tok, "private struct field access")
        return
    }
    ST_QUERY_NS = TS[field2_tok as usize]
    ST_QUERY_NE = TE[field2_tok as usize]
    let foff2 = st_field_offset(si2, fh2)
    let fty2 = st_field_ty(si2, fh2)
    let fhash2 = st_field_hash(si2, fh2)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if foff2 < 0 {
        tc_error(field2_tok, "unknown field access")
        return
    }
    if ty_eq(fty2, fhash2, rhs_ty, rhs_ty_hash) == false {
        tc_error(EP - 1, "assignment type mismatch")
    } else {
        emit_store_to_pointer_offset_x86(lslot, foff1 + foff2, fty2, fhash2)
    }
}

// (*name).field1.field2[idx] = expr  — two-level nested ARRAY-field store through a *mut.
// Base address = [ptr + off(field1) + off(field2)]; element selected by idx*esize.
// Mirrors compile_deref_field_array_store_x86 with one extra field-resolution level.
fn compile_deref_field_field_array_store_x86() with IO, Mut, Panic, Div {
    let name_tok = EP + 2
    let ns = TS[name_tok as usize]
    let ne = TE[name_tok as usize]
    let field1_tok = EP + 5
    let field2_tok = EP + 7
    let fh1 = gl_name_hash(TS[field1_tok as usize], TE[field1_tok as usize])
    let fh2 = gl_name_hash(TS[field2_tok as usize], TE[field2_tok as usize])
    if current_fn_allows_mutation() == false {
        tc_effect_violation(field2_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
    }
    EP = EP + 9
    compile_or()
    if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
    if TK[EP as usize] == 42 { EP = EP + 1 }
    if TK[EP as usize] == 16 { EP = EP + 1 }
    em(0x50)
    compile_or()
    let rhs_ty = EXPR_TY
    let rhs_ty_hash = EXPR_TY_HASH
    let lslot = var_find(ns, ne)
    let lvi = var_find_idx(ns, ne)
    if lslot < 0 || lvi < 0 || type_is_pointer_like(VAR_TY[lvi as usize], VAR_TY_HASH[lvi as usize]) == false {
        tc_error(field1_tok, "field access through deref requires ref or pointer binding")
        em(0x59)
        return
    }
    let inner_ty = ptr_hash_inner_ty(VAR_TY_HASH[lvi as usize])
    let inner_hash = ptr_hash_inner_hash(VAR_TY_HASH[lvi as usize])
    if inner_ty != 6 {
        tc_error(field1_tok, "field access through pointer/ref requires struct pointee")
        em(0x59)
        return
    }
    let si1 = st_find(inner_hash)
    if si1 < 0 {
        tc_error(field1_tok, "unknown field access")
        em(0x59)
        return
    }
    if st_private_access_denied(si1, field1_tok) {
        tc_error_hard(field1_tok, "private struct field access")
        em(0x59)
        return
    }
    ST_QUERY_NS = TS[field1_tok as usize]
    ST_QUERY_NE = TE[field1_tok as usize]
    let foff1 = st_field_offset(si1, fh1)
    let fty1 = st_field_ty(si1, fh1)
    let fhash1 = st_field_hash(si1, fh1)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if foff1 < 0 || fty1 != 6 {
        tc_error(field2_tok, "field access through pointer/ref requires struct pointee")
        em(0x59)
        return
    }
    let si2 = st_find(fhash1)
    if si2 < 0 {
        tc_error(field2_tok, "unknown field access")
        em(0x59)
        return
    }
    if st_private_access_denied(si2, field2_tok) {
        tc_error_hard(field2_tok, "private struct field access")
        em(0x59)
        return
    }
    ST_QUERY_NS = TS[field2_tok as usize]
    ST_QUERY_NE = TE[field2_tok as usize]
    let foff2 = st_field_offset(si2, fh2)
    let fty2 = st_field_ty(si2, fh2)
    let fhash2 = st_field_hash(si2, fh2)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if fty2 != 8 {
        tc_error(field2_tok, "indexed field store requires array field")
        em(0x59)
        return
    }
    if ty_eq(arr_hash_elem_ty(fhash2), arr_hash_elem_hash(fhash2), rhs_ty, rhs_ty_hash) == false {
        tc_error(EP - 1, "assignment type mismatch")
    }
    materialize_aggregate_array_element_x86(fhash2)
    em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (value)
    em(0x59)  // pop rcx (index)
    emit_load_var(lslot)  // rax = base pointer
    let total_off = foff1 + foff2
    if total_off != 0 { em(0x48); em(0x8d); em(0x80); em32(total_off) }
    if arr_hash_esiz(fhash2) == 8 {
        em(0x48); em(0x89); em(0x14); em(0xc8)  // mov [rax + rcx*8], rdx
    } else {
        em(0x88); em(0x14); em(0x08)  // mov [rax + rcx], dl
    }
}

// (*name)<chain>.field = expr where <chain> crosses at least one index — see
// stmt_is_deref_indexed_elem_field_store. Walks the lvalue chain, materialising a real
// element ADDRESS instead of a value-copy:
//   `. field`  → inline: accumulate the field's byte offset
//   `[ idx ]`  → aggregate elements are pointer-per-slot, so LOAD [base + idx*8]
// and stores the RHS at the final address + accumulated offset. Because it returns before
// the expression-statement fall-through, the statement is also correctly typed as a unit
// (LAST_STMT_HAS_VALUE stays 0), which is what makes it legal as a tail-if arm.
fn compile_deref_indexed_elem_field_store_x86() with IO, Mut, Panic, Div {
    // Serves BOTH root spellings, which differ only in where the name sits and how many
    // tokens precede the chain: `(*name)<chain>` and the auto-deref `name<chain>`. The
    // pointee is loaded identically for both, so the chain walk below is shared verbatim.
    var name_tok = EP
    var chain_start = EP + 1
    var root_inner: i64 = 0   // 1 = `(*name.field…)` root: deref of a pointer FIELD
    if TK[EP as usize] == 6 {
        name_tok = EP + 2
        chain_start = EP + 4
        if TK[(EP + 3) as usize] == 50 {
            root_inner = 1
            var rp = EP + 3
            while rp < TC && TK[rp as usize] == 50 && TK[(rp + 1) as usize] == 3 {
                rp = rp + 2
            }
            chain_start = rp + 1  // past the `)`
        }
    }
    let ns = TS[name_tok as usize]
    let ne = TE[name_tok as usize]
    // Locate the terminating `=` up front (same scan the predicate ran) so every
    // diagnostic path can consume the whole statement instead of leaving a token tail
    // for the statement loop to re-parse as an expression (which produced a spurious
    // second "unknown identifier" cascade).
    var eq_pos = chain_start
    while eq_pos < TC && TK[eq_pos as usize] != 16 {
        if TK[eq_pos as usize] == 41 {
            var sdepth: i64 = 1
            eq_pos = eq_pos + 1
            while eq_pos < TC && sdepth > 0 {
                if TK[eq_pos as usize] == 41 { sdepth = sdepth + 1 }
                if TK[eq_pos as usize] == 42 { sdepth = sdepth - 1 }
                eq_pos = eq_pos + 1
            }
        } else {
            eq_pos = eq_pos + 1
        }
    }
    if current_fn_allows_mutation() == false {
        tc_effect_violation(name_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
    }
    // Structural failures below are HARD: before this handler existed these shapes
    // reached the generic path, which rejected them outright ("value is not indexable",
    // "unknown field access"). Reporting them as soft warnings would have turned those
    // rejections into silent acceptances — a strictly worse trade than the false-reject
    // this handler removes.
    var failed: i64 = 0
    let lslot = var_find(ns, ne)
    let lvi = var_find_idx(ns, ne)
    // The root must be a resolvable LOCAL; whether it is pointer-like or a plain struct is
    // decided just below (a value root is legal only for the auto-deref spelling). Requiring
    // pointer-like HERE would false-reject every value-rooted chain the dispatch admits.
    if lslot < 0 || lvi < 0 {
        tc_error_hard(name_tok, "field access through deref requires ref or pointer binding")
        EP = eq_pos + 1
        compile_or()
        return
    }
    // Base address: emit_load_var(lslot) below, identical to the read path for BOTH a
    // pointer-like root (slot holds the pointee address) and a plain struct root (slot holds
    // the pointer to the struct's inline slots). Only the TYPE derivation differs.
    var cur_ty = VAR_TY[lvi as usize]
    var cur_hash = VAR_TY_HASH[lvi as usize]
    if type_is_pointer_like(cur_ty, cur_hash) {
        cur_ty = ptr_hash_inner_ty(VAR_TY_HASH[lvi as usize])
        cur_hash = ptr_hash_inner_hash(VAR_TY_HASH[lvi as usize])
    } else {
        // The `(*name)` spelling asserts a pointer. A value root reaching it is the
        // pre-existing type error and must stay a hard reject; only the auto-deref spelling
        // may be value-rooted (gated by ident_chain_root_supported at the dispatch).
        // `(*name.field)` is exempt: there the `*` applies to the FIELD, not to the root, so
        // a value-struct root is perfectly legal.
        if TK[EP as usize] == 6 && root_inner == 0 {
            tc_error_hard(name_tok, "field access through deref requires ref or pointer binding")
            EP = eq_pos + 1
            compile_or()
            return
        }
    }
    // A struct root/pointee starts the chain at `.field`; an ARRAY pointee (&![T; N]) starts
    // it at `[idx]` — `(*arrptr)[i].f = v`. Both are accepted here and discriminated by the
    // chain walk itself (the `.field` step demands a struct, the `[idx]` step an array), so
    // the array-rooted form is lowered correctly instead of being rejected for not being a
    // struct: it is another shape that previously reached the generic path and was lost.
    if cur_ty != 6 && cur_ty != 8 {
        tc_error_hard(name_tok, "field access through pointer/ref requires struct or array pointee")
        EP = eq_pos + 1
        compile_or()
        return
    }
    EP = chain_start  // past `( * name … )` or past the bare `name`
    emit_load_var(lslot)  // rax = base pointer
    var pending_off: i64 = 0
    // `(*name.field…)` root: walk the INNER field chain inside the parens, accumulating inline
    // offsets, then LOAD the pointer stored in the final inner field. That load is the deref
    // the `(* )` spells, and it is what no existing predicate was willing to emit.
    if root_inner == 1 {
        var ip = name_tok + 1
        var inner_off: i64 = 0
        var inner_bad: i64 = 0
        while inner_bad == 0 && TK[ip as usize] == 50 {
            let itok = ip + 1
            if cur_ty != 6 {
                tc_error_hard(itok, "field access requires struct value")
                inner_bad = 1
                continue
            }
            let isi = st_find(cur_hash)
            if isi < 0 {
                tc_error_hard(itok, "unknown field access")
                inner_bad = 1
                continue
            }
            if st_private_access_denied(isi, itok) {
                tc_error_hard(itok, "private struct field access")
                inner_bad = 1
                continue
            }
            let ifh = gl_name_hash(TS[itok as usize], TE[itok as usize])
            ST_QUERY_NS = TS[itok as usize]
            ST_QUERY_NE = TE[itok as usize]
            let ioff = st_field_offset(isi, ifh)
            let ifty = st_field_ty(isi, ifh)
            let ifhash = st_field_hash(isi, ifh)
            ST_QUERY_NS = -1
            ST_QUERY_NE = -1
            if ioff < 0 {
                tc_error_hard(itok, "unknown field access")
                inner_bad = 1
                continue
            }
            inner_off = inner_off + ioff
            cur_ty = ifty
            cur_hash = ifhash
            ip = ip + 2
        }
        if inner_bad == 1 {
            EP = eq_pos + 1
            compile_or()
            return
        }
        if type_is_pointer_like(cur_ty, cur_hash) == false {
            tc_error_hard(name_tok, "deref of a struct field requires a pointer-typed field")
            EP = eq_pos + 1
            compile_or()
            return
        }
        if inner_off != 0 { em(0x48); em(0x8d); em(0x80); em32(inner_off) }  // lea rax,[rax+off]
        em(0x48); em(0x8b); em(0x00)  // mov rax,[rax] — the pointer held in the field
        cur_ty = ptr_hash_inner_ty(cur_hash)
        cur_hash = ptr_hash_inner_hash(cur_hash)
        if cur_ty != 6 && cur_ty != 8 {
            tc_error_hard(name_tok, "field access through pointer/ref requires struct or array pointee")
            EP = eq_pos + 1
            compile_or()
            return
        }
    }
    var target_ty: i64 = 0
    var target_hash: i64 = 0
    var done: i64 = 0
    while done == 0 {
        if TK[EP as usize] == 50 {
            let ftok = EP + 1
            let fh = gl_name_hash(TS[ftok as usize], TE[ftok as usize])
            if cur_ty != 6 {
                tc_error_hard(ftok, "field access requires struct value")
                failed = 1
                done = 1
                continue
            }
            let si = st_find(cur_hash)
            if si < 0 {
                tc_error_hard(ftok, "unknown field access")
                failed = 1
                done = 1
                continue
            }
            if st_private_access_denied(si, ftok) {
                tc_error_hard(ftok, "private struct field access")
                failed = 1
                done = 1
                continue
            }
            ST_QUERY_NS = TS[ftok as usize]
            ST_QUERY_NE = TE[ftok as usize]
            let foff = st_field_offset(si, fh)
            let fty = st_field_ty(si, fh)
            let fhash = st_field_hash(si, fh)
            ST_QUERY_NS = -1
            ST_QUERY_NE = -1
            if foff < 0 {
                tc_error_hard(ftok, "unknown field access")
                failed = 1
                done = 1
                continue
            }
            pending_off = pending_off + foff
            cur_ty = fty
            cur_hash = fhash
            EP = EP + 2
            if TK[EP as usize] == 16 {
                target_ty = fty
                target_hash = fhash
                done = 1
            }
            continue
        }
        if TK[EP as usize] == 41 {
            if cur_ty != 8 {
                tc_error_hard(EP, "indexed store requires array field")
                failed = 1
                done = 1
                continue
            }
            // Is this the TERMINAL step, i.e. `… [ idx ] = expr`? Then the store target is
            // the array ELEMENT itself rather than a field of it, which needs the aggregate
            // store form (elements are pointer-per-slot, so an aggregate RHS is copied into
            // fresh element storage and the POINTER is written into the slot;
            // materialize_aggregate_array_element_x86 no-ops for scalar elements and leaves
            // the value in rax, so one path serves both).
            var term_p = EP + 1
            var term_depth: i64 = 1
            while term_p < TC && term_depth > 0 {
                if TK[term_p as usize] == 41 { term_depth = term_depth + 1 }
                if TK[term_p as usize] == 42 { term_depth = term_depth - 1 }
                term_p = term_p + 1
            }
            if TK[term_p as usize] == 16 {
                let esiz_t = arr_hash_esiz(cur_hash)
                let elem_ty_t = arr_hash_elem_ty(cur_hash)
                let elem_hash_t = arr_hash_elem_hash(cur_hash)
                if pending_off != 0 { em(0x48); em(0x8d); em(0x80); em32(pending_off) }
                let arr_slot = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var(arr_slot)  // save the array base address
                EP = EP + 1               // skip [
                compile_or()              // index in rax
                if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }  // 'as usize'
                if TK[EP as usize] == 42 { EP = EP + 1 }  // ]
                if TK[EP as usize] == 16 { EP = EP + 1 }  // =
                em(0x50)                  // push index
                compile_or()              // rhs in rax
                let rhs_ty_t = EXPR_TY
                let rhs_hash_t = EXPR_TY_HASH
                if ty_eq(elem_ty_t, elem_hash_t, rhs_ty_t, rhs_hash_t) == false {
                    tc_error(EP - 1, "assignment type mismatch")
                }
                materialize_aggregate_array_element_x86(cur_hash)
                em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (value or fresh element ptr)
                em(0x59)                      // pop rcx (index)
                emit_load_var(arr_slot)       // rax = array base
                if esiz_t == 8 {
                    em(0x48); em(0x89); em(0x14); em(0xc8)  // mov [rax + rcx*8], rdx
                } else {
                    em(0x88); em(0x14); em(0x08)            // mov [rax + rcx], dl
                }
                return
            }
            if arr_hash_esiz(cur_hash) != 8 {
                tc_error_hard(EP, "indexed element field store requires 8-byte array elements")
                failed = 1
                done = 1
                continue
            }
            let elem_ty = arr_hash_elem_ty(cur_hash)
            let elem_hash = arr_hash_elem_hash(cur_hash)
            if elem_ty != 6 && elem_ty != 8 {
                tc_error_hard(EP, "indexed element field store requires aggregate elements")
                failed = 1
                done = 1
                continue
            }
            if pending_off != 0 { em(0x48); em(0x8d); em(0x80); em32(pending_off) }  // lea rax,[rax+off]
            pending_off = 0
            em(0x50)      // push array base
            EP = EP + 1   // skip [
            compile_or()  // index in rax
            if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }  // 'as usize'
            if TK[EP as usize] == 42 { EP = EP + 1 }  // ]
            em(0x48); em(0x89); em(0xc2)            // mov rdx, rax (index)
            em(0x59)                                // pop rcx (array base)
            em(0x48); em(0x8b); em(0x04); em(0xd1)  // mov rax, [rcx + rdx*8] (element ptr)
            cur_ty = elem_ty
            cur_hash = elem_hash
            continue
        }
        tc_error_hard(EP, "unsupported assignment target")
        failed = 1
        done = 1
    }
    if failed == 1 {
        EP = eq_pos + 1
        compile_or()
        return
    }
    // rax = pointer to the object that owns the final field.
    let addr_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var(addr_slot)
    if TK[EP as usize] == 16 { EP = EP + 1 }  // skip =
    compile_or()  // rhs in rax
    let rhs_ty = EXPR_TY
    let rhs_ty_hash = EXPR_TY_HASH
    // Severity note: soft, matching every other deref-store handler in this file
    // (compile_deref_field_field_store_x86 etc. all use tc_error here). Assignment-type
    // mismatch being a warning is a PRE-EXISTING file-wide hole, not one this handler
    // introduces — `(*p).f1.f2 = <wrong type>` warns identically. Tightening it belongs
    // to a separate, measured change: this seed compiles the whole compiler bundle, so a
    // new hard reject here risks false-rejecting valid code across all of main.sio.
    if ty_eq(target_ty, target_hash, rhs_ty, rhs_ty_hash) == false {
        tc_error(EP - 1, "assignment type mismatch")
    }
    emit_store_to_pointer_offset_x86(addr_slot, pending_off, target_ty, target_hash)
}

fn compile_stmt() with IO, Mut, Panic, Div {
    let k = TK[EP as usize]
    LAST_STMT_HAS_VALUE = 0

    // Skip semicolons
    if k == 27 { EP = EP + 1; return }

    // Skip unit declarations (top-level only; Gen 19)
    // Soft keyword: only treat `unit` as a declaration when followed by an ident
    // (the unit name). `let unit = x` / `unit.w` / `unit + 1` are ordinary ident use.
    if k == 3 && src_match(TS[EP as usize], TE[EP as usize] - TS[EP as usize], "unit") && TK[(EP + 1) as usize] == 3 {
        EP = EP + 1  // skip 'unit'
        while EP < TC && TK[EP as usize] != 27 && TK[EP as usize] != 0 { EP = EP + 1 }
        if TK[EP as usize] == 27 { EP = EP + 1 }  // skip ';'
        return
    }
    // Skip trait declarations (abstract — no codegen)
    if k == 75 {
        EP = EP + 1  // skip 'trait'
        if TK[EP as usize] == 3 { EP = EP + 1 }  // skip name
        if TK[EP as usize] == 8 {
            EP = EP + 1
            var td: i64 = 1
            while EP < TC && td > 0 {
                if TK[EP as usize] == 8 { td = td + 1 }
                if TK[EP as usize] == 9 { td = td - 1 }
                EP = EP + 1
            }
        }
        return
    }

    // Skip impl header (methods are compiled as normal functions)
    if k == 76 {
        EP = EP + 1  // skip 'impl'
        if TK[EP as usize] == 3 { EP = EP + 1 }  // skip name
        // Skip 'for Type' if present
        if TK[EP as usize] == 54 {
            EP = EP + 1  // skip 'for'
            if TK[EP as usize] == 3 { EP = EP + 1 }  // skip type name
        }
        // Skip generic <T> if present
        if TK[EP as usize] == 23 {
            while TK[EP as usize] != 24 && TK[EP as usize] != 0 { EP = EP + 1 }
            if TK[EP as usize] == 24 { EP = EP + 1 }
        }
        // Don't skip the block — let the normal fn compilation handle the methods
        return
    }

    // Study block: skip header tokens (study, hypothesis blocks), compile fn defs
    if k == 71 {
        EP = EP + 1  // skip 'study'
        // Skip tokens until opening brace
        while TK[EP as usize] != 8 && TK[EP as usize] != 0 { EP = EP + 1 }
        // Don't skip the block — let normal fn compilation handle methods inside
        return
    }

    // Skip hypothesis/outcome sub-blocks inside study (these are metadata, not code)
    if k == 3 && (src_match(TS[EP as usize], TE[EP as usize] - TS[EP as usize], "hypothesis") || src_match(TS[EP as usize], TE[EP as usize] - TS[EP as usize], "outcome")) {
        EP = EP + 1  // skip keyword
        // Skip to and past the block { ... }
        while TK[EP as usize] != 8 && TK[EP as usize] != 9 && TK[EP as usize] != 0 { EP = EP + 1 }
        if TK[EP as usize] == 8 {
            EP = EP + 1
            var hd: i64 = 1
            while EP < TC && hd > 0 {
                if TK[EP as usize] == 8 { hd = hd + 1 }
                if TK[EP as usize] == 9 { hd = hd - 1 }
                EP = EP + 1
            }
        }
        return
    }

    // let x = expr / var x = expr (with optional : type)
    if k == 11 || k == 12 {
        EP = EP + 1
        // Clear refinement predicate state so it is only set by the explicit type annotation
        // of THIS binding, not leaked from inner expressions (e.g. scan_fn_param_type in RHS).
        SCAN_HAS_PRED = 0
        // Strike 2: Reject 'let mut' Rust syntax
        if k == 11 && TK[EP as usize] == 3 {
            let ns = TS[EP as usize]
            let ne = TE[EP as usize]
            if src_match(ns, ne - ns, "mut") {
                tc_rust_let_mut(EP)
            }
        }
        if TK[EP as usize] == 6 {
            let pat_start = EP
            var pat_p = EP
            var pat_depth: i64 = 0
            while pat_p < TC {
                if TK[pat_p as usize] == 6 { pat_depth = pat_depth + 1 }
                if TK[pat_p as usize] == 7 {
                    pat_depth = pat_depth - 1
                    pat_p = pat_p + 1
                    if pat_depth == 0 { break }
                    continue
                }
                pat_p = pat_p + 1
            }
            EP = pat_p
            if TK[EP as usize] == 16 { EP = EP + 1 }
            if TK[EP as usize] != 6 {
                compile_or()
                if ret_agg_nslots(EXPR_TY, EXPR_TY_HASH) <= 0 {
                    tc_error(EP, "tuple destructuring: RHS must be a tuple expression")
                    return
                }
                let save_tup_hash = EXPR_TY_HASH
                let sret_ptr_slot = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var(sret_ptr_slot)
                tuple_destructure_from_ptr_x86(pat_start, save_tup_hash, sret_ptr_slot)
                return
            }
            tuple_bind_pattern_x86(pat_start, EP)
            EP = TUP_RHS_NEXT
            return
        }
        // Phase 1.6: struct pattern — let TypeName { field1, field2 } = expr
        if TK[EP as usize] == 3 && TK[(EP + 1) as usize] == 8 {
            let sname_ns = TS[EP as usize]
            let sname_ne = TE[EP as usize]
            let sname_hash = gl_name_hash(sname_ns, sname_ne)
            let si = st_find(sname_hash)
            if si >= 0 {
                let pat_start = EP + 1
                var skip_p = EP + 1
                var sdepth: i64 = 0
                while skip_p < TC {
                    if TK[skip_p as usize] == 8 { sdepth = sdepth + 1 }
                    if TK[skip_p as usize] == 9 {
                        sdepth = sdepth - 1
                        skip_p = skip_p + 1
                        if sdepth == 0 { break }
                    }
                    skip_p = skip_p + 1
                }
                EP = skip_p
                if TK[EP as usize] == 16 { EP = EP + 1 }
                compile_or()
                let sptr_slot = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var(sptr_slot)
                struct_destructure_x86(pat_start, si, sptr_slot)
                return
            }
        }
        let ns = TS[EP as usize]
        let ne = TE[EP as usize]
        EP = EP + 1
        // Check for : type annotation
        var is_arr: i64 = 0
        var arr_len: i64 = 0
        var arr_esiz: i64 = 8
        var decl_is_f64: i64 = -1
        var decl_ty: i64 = 0
        var decl_ty_hash: i64 = 0
        let decl_is_mut: i64 = if k == 12 { 1 } else { 0 }
        if TK[EP as usize] == 43 {
            EP = EP + 1  // skip :
            let ann_ns = TS[EP as usize]
            let ann_ne = TE[EP as usize]
            // Array type: [T; N] — detect and extract element type + length
            if TK[EP as usize] == 41 {
                EP = EP + 1  // skip [
                // Element type
                var arr_elem_ty: i64 = 0
                var arr_elem_hash: i64 = 0
                // Knowledge<T> element: scan the full type so the kind=7 element hash
                // is captured (`[Knowledge[f64]; N]`); the single-token path below only
                // handles simple names + registered structs.
                if src_match(TS[EP as usize], TE[EP as usize] - TS[EP as usize], "Knowledge")
                   && (TK[(EP + 1) as usize] == 41 || TK[(EP + 1) as usize] == 23) {
                    scan_type(EP)
                    arr_elem_ty = SCAN_TY
                    arr_elem_hash = SCAN_TY_HASH
                    EP = SCAN_TY_NEXT
                } else {
                    let etns = TS[EP as usize]
                    let etne = TE[EP as usize]
                    arr_elem_ty = type_name_kind(etns, etne)
                    if arr_elem_ty == 6 || arr_elem_ty == 7 { arr_elem_hash = gl_name_hash(etns, etne) }
                    if src_match(etns, etne - etns, "i8") { arr_esiz = 1 }
                    EP = EP + 1  // skip element type
                }
                if TK[EP as usize] == 27 { EP = EP + 1 }  // skip ;
                arr_len = TV[EP as usize]
                EP = EP + 1  // skip N
                if TK[EP as usize] == 42 { EP = EP + 1 }  // skip ]
                is_arr = 1
                decl_ty = 8
                decl_ty_hash = arr_ty_hash_for_elem_type(arr_len, arr_esiz, arr_elem_ty, arr_elem_hash)
                decl_is_f64 = 0
            } else {
                scan_type(EP)
                decl_ty = SCAN_TY
                decl_ty_hash = SCAN_TY_HASH
                if knowledge_hash_invalid(decl_ty_hash) {
                    tc_epistemic_boundary(EP)
                    decl_ty = 0
                    decl_ty_hash = 0
                }
                if decl_ty == 0 && name_is_lower(ann_ns, ann_ne) {
                    decl_ty = 2
                    decl_ty_hash = gl_name_hash(ann_ns, ann_ne)
                }
                if decl_ty == 0 && decl_ty_hash != 0 && type_hash_unit_dim(decl_ty_hash) != 0 {
                    decl_ty = 2
                }
                if decl_ty == 2 { decl_is_f64 = 1 }
                else { decl_is_f64 = 0 }
                EP = SCAN_TY_NEXT
            }
        }
        // Skip = sign; detect type-annotated decl without initializer
        var has_eq: i64 = 0
        if TK[EP as usize] == 16 { EP = EP + 1; has_eq = 1 }
        if is_arr == 1 && arr_len > 0 && TK[EP as usize] == 41 && array_init_is_repeat(EP) {
            // Local array with repeat initializer [V; N]: splat V into every slot.
            // (Previously V was SKIPPED and the slots were always zero-filled — the
            //  [V;N] non-zero-splat miscompile. We now mirror the already-correct
            //  global path (emit_global_inits_x86): compile V into rax, then rep-store.
            //  Byte-element arrays keep the zero-fill — non-zero byte splat is a
            //  documented remaining gap, so this is no regression for them.)
            EP = EP + 1  // skip [
            let val_ep = EP                       // remember where the fill value V starts
            while ep_before_body_close() && TK[EP as usize] != 42 && TK[EP as usize] != 0 { EP = EP + 1 }
            if TK[EP as usize] == 42 { EP = EP + 1 }  // skip ]
            let after_ep = EP
            var nslots = arr_len
            if arr_esiz == 1 { nslots = (arr_len + 7) / 8 }
            let ptr_slot = var_add_arr(ns, ne, nslots, arr_esiz, arr_hash_elem_ty(decl_ty_hash))
            if ptr_slot < 0 { return }
            let arr_vi = VAR_COUNT - 1
            VAR_TY[arr_vi as usize] = 8
            VAR_TY_HASH[arr_vi as usize] = decl_ty_hash
            VAR_MUT[arr_vi as usize] = decl_is_mut
            // Array slots: base..base+nslots-1, lowest addr = rbp-(base+nslots-1)*8
            // rep stosq: store rax to [rdi], rdi += 8, rcx--; repeats rcx times (DF=0 → ascending)
            let base = ptr_slot - nslots
            // Aggregate elements: a single-pointer splat would alias every
            // slot (tests/known_failures/lean_decl_repeat_alias.sio). Emit a
            // RUNTIME loop — O(1) code per decl, mandatory at [T;1024] scale
            // (the compile-time-unrolled variant grew Madaros +11MB and
            // broke self-host) — that heap-allocs and copies one fresh
            // element per slot from the once-compiled V.
            let dcl_elem_ty = arr_hash_elem_ty(decl_ty_hash)
            let dcl_elem_hash = arr_hash_elem_hash(decl_ty_hash)
            if dcl_elem_ty == 6 && struct_like_nslots(dcl_elem_hash) > 0 && LAST_LOCAL_BSS_SPILL == 0 {
                let d_nsl = struct_like_nslots(dcl_elem_hash)
                EP = val_ep
                compile_or()
                EP = after_ep
                let rl_src = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var(rl_src)
                em(0x48); em(0x8d); em(0x85)  // lea rax, [rbp+disp] (array base, lowest addr)
                em32(0 - (base + nslots - 1) * 8)
                let rl_base = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var(rl_base)
                // One BLOCK allocation for all N elements (an mmap per
                // element cost a 4 KiB page each — >8 GiB vmem at Madaros
                // scale, caught by the wrapper ulimit during the prebuilt
                // refresh). Element i lives at block + i*stride.
                emit_pool_alloc_x86(nslots * d_nsl * 8)
                let rl_blk = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var(rl_blk)
                em(0x48); em(0x31); em(0xc0)  // xor rax, rax (i = 0)
                let rl_i = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var(rl_i)
                let rl_head = CL
                emit_load_var(rl_i)
                em(0x48); em(0x3d); em32(nslots)  // cmp rax, nslots
                em(0x0f); em(0x8d)                // jge done (fwd, patched)
                let rl_exit = CL
                em32(0)
                emit_load_var(rl_i)
                em(0x48); em(0xb9); em64(d_nsl * 8)     // mov rcx, stride
                em(0x48); em(0x0f); em(0xaf); em(0xc1)  // imul rax, rcx
                em(0x48); em(0x89); em(0xc2)            // mov rdx, rax (off)
                emit_load_var(rl_blk)
                em(0x48); em(0x01); em(0xd0)            // add rax, rdx (elem dst)
                let rl_new = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var(rl_new)
                emit_load_var(rl_src)
                em(0x48); em(0x89); em(0xc2)      // mov rdx, rax (src)
                emit_load_var(rl_new)             // rax = dst
                emit_copy_agg_to_ptr_x86(6, dcl_elem_hash)
                emit_load_var(rl_new)
                em(0x48); em(0x89); em(0xc2)      // mov rdx, rax (new ptr)
                emit_load_var(rl_i)
                em(0x48); em(0x89); em(0xc1)      // mov rcx, rax (i)
                emit_load_var(rl_base)            // rax = array base
                em(0x48); em(0x89); em(0x14); em(0xc8)  // mov [rax+rcx*8], rdx
                emit_load_var(rl_i)
                em(0x48); em(0x83); em(0xc0); em(1)     // add rax, 1
                emit_store_var(rl_i)
                em(0xe9)                          // jmp head (backward rel32)
                em32(rl_head - (CL + 4))
                patch32(rl_exit, CL)
                emit_load_var(rl_base)
                emit_store_var(ptr_slot)
                return
            }
            // Compute the fill value into rax. For 8-byte elements (i64/f64/ptr) splat
            // the real V; var_add_arr emits no code and the rdi setup below does not
            // clobber rax, so V survives into the rep-store.
            var fill_zero: i64 = 1
            if arr_esiz != 1 {
                EP = val_ep
                compile_or()
                let v_is_f64 = EXPR_IS_F64
                EP = after_ep
                if v_is_f64 == 1 {
                    em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)  // movq rax, xmm0
                }
                fill_zero = 0
            }
            if LAST_LOCAL_BSS_SPILL != 0 {
                em(0x48); em(0xbf); em64(LAST_LOCAL_BSS_ADDR)
            } else {
                em(0x48); em(0x8d); em(0xbd)  // lea rdi, [rbp + disp32]  (lowest array addr)
                em32(0 - (base + nslots - 1) * 8)
            }
            if fill_zero == 1 {
                em(0x48); em(0x31); em(0xc0)  // xor rax, rax (byte-array path: zero-fill)
            }
            em(0xb9); em32(nslots)         // mov ecx, nslots (zero-extends to rcx)
            em(0xf3); em(0x48); em(0xab)  // rep stosq (splats rax across all slots)
            // Store lea (pointer to array start) in ptr_slot
            // Array slots are base..base+nslots-1, addresses [rbp-base*8]..[rbp-(base+nslots-1)*8]
            // Pointer must point to lowest address so arr[i] = [ptr + i*8] addresses upward
            if LAST_LOCAL_BSS_SPILL != 0 {
                em(0x48); em(0xb8); em64(LAST_LOCAL_BSS_ADDR)
            } else {
                em(0x48); em(0x8d); em(0x85)  // lea rax, [rbp + disp32]
                em32(0 - (base + nslots - 1) * 8)
            }
            emit_store_var(ptr_slot)
        } else if has_eq == 0 && (decl_ty != 0 || decl_ty_hash != 0) && type_is_struct_like(decl_ty, decl_ty_hash) {
            // var x: StructType  (no initializer) — zero-initialize struct slots
            bind_struct_local_zeroinit_x86(ns, ne, decl_ty_hash)
            if VAR_COUNT > 0 { VAR_MUT[(VAR_COUNT - 1) as usize] = decl_is_mut }
        } else if has_eq == 0 && type_is_option_inline(decl_ty, decl_ty_hash) {
            let opt_tag_slot = var_add_option_inline(ns, ne, decl_ty_hash)
            if opt_tag_slot >= 0 {
                em(0x48); em(0x31); em(0xc0)
                emit_store_var(opt_tag_slot)
                emit_store_var(opt_tag_slot - 1)
                VAR_MUT[(VAR_COUNT - 1) as usize] = decl_is_mut
            }
        } else {
            compile_or()
            if (decl_ty != 0 || decl_ty_hash != 0) && ty_eq(decl_ty, decl_ty_hash, EXPR_TY, EXPR_TY_HASH) == false {
                if type_has_knowledge(decl_ty, decl_ty_hash) || type_has_knowledge(EXPR_TY, EXPR_TY_HASH) {
                    tc_epistemic_boundary(EP)
                } else {
                    tc_decl_init_mismatch(EP - 1, decl_ty, decl_ty_hash, EXPR_TY, EXPR_TY_HASH)
                }
            }
            // Observation boundary: Unobserved<T> assigned to non-Unobserved binding
            if ty_is_unobserved(EXPR_TY) && !ty_is_unobserved(decl_ty) && (FN_EFFECTS[CURRENT_FN as usize] & 64) == 0 {
                tc_observe_boundary(EP - 1, "cannot assign Unobserved<T> to non-Unobserved binding")
            }
            if type_is_slice_ref(decl_ty, decl_ty_hash) || (decl_ty == 0 && type_is_slice_ref(EXPR_TY, EXPR_TY_HASH)) {
                var bind_hash = EXPR_TY_HASH
                if decl_ty != 0 || decl_ty_hash != 0 { bind_hash = decl_ty_hash }
                let before_vc = VAR_COUNT
                bind_slice_local_from_rax_x86(ns, ne, bind_hash)
                if VAR_COUNT > before_vc {
                    let svix = VAR_COUNT - 1
                    VAR_IS_CLOSURE[svix as usize] = 0
                    VAR_MUT[svix as usize] = decl_is_mut
                    VAR_LINEAR[svix as usize] = 0
                }
            } else if (decl_ty == 8) || (decl_ty == 0 && EXPR_TY == 8) {
                var bind_hash = EXPR_TY_HASH
                if decl_ty == 8 { bind_hash = decl_ty_hash }
                let before_vc = VAR_COUNT
                bind_array_local_from_rax_x86(ns, ne, bind_hash)
                if VAR_COUNT > before_vc {
                    let avix = VAR_COUNT - 1
                    VAR_IS_CLOSURE[avix as usize] = 0
                    VAR_MUT[avix as usize] = decl_is_mut
                    VAR_LINEAR[avix as usize] = 0
                }
            } else if type_is_option_inline(decl_ty, decl_ty_hash) || (decl_ty == 0 && type_is_option_inline(EXPR_TY, EXPR_TY_HASH)) {
                var bind_hash = EXPR_TY_HASH
                if option_hash_is(decl_ty_hash) { bind_hash = decl_ty_hash }
                let opt_slot = var_add_option_inline(ns, ne, bind_hash)
                if opt_slot >= 0 {
                    emit_copy_option_to_local_x86(opt_slot)
                    VAR_MUT[(VAR_COUNT - 1) as usize] = decl_is_mut
                }
            } else if type_is_struct_like(decl_ty, decl_ty_hash) || (decl_ty == 0 && type_is_struct_like(EXPR_TY, EXPR_TY_HASH)) {
                var bind_hash = EXPR_TY_HASH
                if decl_ty != 0 || decl_ty_hash != 0 { bind_hash = decl_ty_hash }
                let before_vc = VAR_COUNT
                bind_struct_local_from_rax_x86(ns, ne, bind_hash)
                if VAR_COUNT > before_vc {
                    let svix = VAR_COUNT - 1
                    VAR_IS_CLOSURE[svix as usize] = 0
                    VAR_MUT[svix as usize] = decl_is_mut
                }
            } else {
                let slot = var_add(ns, ne)
                if slot < 0 { return }
                let vix = VAR_COUNT - 1
                // PR-4: track per-variable literal value for cross-binding refinement
                // checks (let x = -5; takes_pos(x)). Only for immutable integer bindings.
                if LAST_IS_LITERAL == 1 && decl_is_mut == 0 && (decl_ty == 0 || decl_ty == 1) {
                    VAR_LIT_DATA[(vix * 2 + 0) as usize] = 1
                    VAR_LIT_DATA[(vix * 2 + 1) as usize] = LAST_LITERAL_VAL
                }
                // Refinement predicate: compile-time check for constant literals.
                if SCAN_HAS_PRED == 1 && LAST_IS_LITERAL == 1 && SCAN_PRED_IS_F64 == 0 {
                    let cv = LAST_LITERAL_VAL; let bv = SCAN_PRED_BOUND; var violated: i64 = 0
                    if SCAN_PRED_OP == 26 && cv < bv { violated = 1 }  // >= : violated if cv < bv
                    if SCAN_PRED_OP == 24 && cv <= bv { violated = 1 } // >  : violated if cv <= bv
                    if SCAN_PRED_OP == 25 && cv > bv { violated = 1 }  // <= : violated if cv > bv
                    if SCAN_PRED_OP == 23 && cv >= bv { violated = 1 } // <  : violated if cv >= bv
                    if SCAN_PRED_OP == 21 && cv != bv { violated = 1 } // == : violated if cv != bv
                    if SCAN_PRED_OP == 22 && cv == bv { violated = 1 } // != : violated if cv == bv
                    // PR-6: AND compound — check second independently; OR — second pred can clear violation
                    if SCAN_HAS_PRED2 == 1 && SCAN_PRED_IS_F64_2 == 0 {
                        let bv2 = SCAN_PRED_BOUND2
                        if SCAN_PRED_COMPOUND_IS_AND == 1 {
                            if SCAN_PRED_OP2 == 26 && cv < bv2 { violated = 1 }
                            if SCAN_PRED_OP2 == 24 && cv <= bv2 { violated = 1 }
                            if SCAN_PRED_OP2 == 25 && cv > bv2 { violated = 1 }
                            if SCAN_PRED_OP2 == 23 && cv >= bv2 { violated = 1 }
                            if SCAN_PRED_OP2 == 21 && cv != bv2 { violated = 1 }
                            if SCAN_PRED_OP2 == 22 && cv == bv2 { violated = 1 }
                        } else {
                            if violated == 1 {
                                var ok2: i64 = 0
                                if SCAN_PRED_OP2 == 26 && cv >= bv2 { ok2 = 1 }
                                if SCAN_PRED_OP2 == 24 && cv > bv2 { ok2 = 1 }
                                if SCAN_PRED_OP2 == 25 && cv <= bv2 { ok2 = 1 }
                                if SCAN_PRED_OP2 == 23 && cv < bv2 { ok2 = 1 }
                                if SCAN_PRED_OP2 == 21 && cv == bv2 { ok2 = 1 }
                                if SCAN_PRED_OP2 == 22 && cv != bv2 { ok2 = 1 }
                                if ok2 == 1 { violated = 0 }
                            }
                        }
                    }
                    if violated == 1 {
                        print("error[E208]: refinement type violation — value ")
                        print_int(cv)
                        print(" does not satisfy predicate at line ")
                        print_int(TL[(EP - 1) as usize])
                        print("\n")
                        tc_mark_failed()
                        SCAN_HAS_PRED = 0
                    }
                }
                // PR-9: f64 literal predicate check at let-binding site
                if SCAN_HAS_PRED == 1 && SCAN_PRED_IS_F64 == 1 && LAST_IS_LITERAL_F64 == 1 {
                    let cv9_int = LAST_LITERAL_F64_INT
                    let cv9_frac = LAST_LITERAL_F64_FRAC
                    let cv9_denom = LAST_LITERAL_F64_DENOM
                    let bv9_int = SCAN_PRED_BOUND
                    let bv9_frac = SCAN_PRED_BOUND_FRAC
                    let bv9_denom = SCAN_PRED_BOUND_DENOM
                    let lhs9 = (cv9_int * cv9_denom + cv9_frac) * bv9_denom
                    let rhs9 = (bv9_int * bv9_denom + bv9_frac) * cv9_denom
                    let op9 = SCAN_PRED_OP
                    var f64_viol9: i64 = 0
                    if op9 == 26 && lhs9 < rhs9 { f64_viol9 = 1 }
                    if op9 == 24 && lhs9 <= rhs9 { f64_viol9 = 1 }
                    if op9 == 25 && lhs9 > rhs9 { f64_viol9 = 1 }
                    if op9 == 23 && lhs9 >= rhs9 { f64_viol9 = 1 }
                    if SCAN_HAS_PRED2 == 1 {
                        let bv2_int9 = SCAN_PRED_BOUND2
                        let bv2_frac9 = SCAN_PRED_BOUND2_FRAC
                        let bv2_denom9 = SCAN_PRED_BOUND2_DENOM
                        let lhs9b = (cv9_int * cv9_denom + cv9_frac) * bv2_denom9
                        let rhs9b = (bv2_int9 * bv2_denom9 + bv2_frac9) * cv9_denom
                        let op9b = SCAN_PRED_OP2
                        if SCAN_PRED_COMPOUND_IS_AND == 1 {
                            if op9b == 26 && lhs9b < rhs9b { f64_viol9 = 1 }
                            if op9b == 24 && lhs9b <= rhs9b { f64_viol9 = 1 }
                            if op9b == 25 && lhs9b > rhs9b { f64_viol9 = 1 }
                            if op9b == 23 && lhs9b >= rhs9b { f64_viol9 = 1 }
                        } else {
                            if f64_viol9 == 1 {
                                var ok9b: i64 = 0
                                if op9b == 26 && lhs9b >= rhs9b { ok9b = 1 }
                                if op9b == 24 && lhs9b > rhs9b { ok9b = 1 }
                                if op9b == 25 && lhs9b <= rhs9b { ok9b = 1 }
                                if op9b == 23 && lhs9b < rhs9b { ok9b = 1 }
                                if ok9b == 1 { f64_viol9 = 0 }
                            }
                        }
                    }
                    if f64_viol9 == 1 {
                        print("error[E209]: refinement type violation — f64 value violates let-binding predicate at line ")
                        print_int(TL[(EP - 1) as usize])
                        print("\n")
                        tc_mark_failed()
                    }
                    SCAN_HAS_PRED = 0
                    SCAN_HAS_PRED2 = 0
                }
                // Refinement predicate runtime assertion (integer bounds only)
                // RAX holds the value before store — emit bound check + ud2 trap.
                // For OR predicates: first check passes → jump to ok; else check second → jump to ok; else trap.
                if SCAN_HAS_PRED == 1 && SCAN_PRED_IS_F64 == 0 {
                    if SCAN_HAS_PRED2 == 1 && SCAN_PRED_IS_F64_2 == 0 {
                        // OR: cmp rax,B1; Jcc ok; cmp rax,B2; Jcc ok; ud2
                        em(0x48); em(0x81); em(0xf8); em32(SCAN_PRED_BOUND)  // cmp rax, B1
                        if SCAN_PRED_OP == 26 { em(0x0f); em(0x8d) }  // JGE
                        if SCAN_PRED_OP == 24 { em(0x0f); em(0x8f) }  // JG
                        if SCAN_PRED_OP == 25 { em(0x0f); em(0x8e) }  // JLE
                        if SCAN_PRED_OP == 23 { em(0x0f); em(0x8c) }  // JL
                        if SCAN_PRED_OP == 21 { em(0x0f); em(0x84) }  // JE
                        if SCAN_PRED_OP == 22 { em(0x0f); em(0x85) }  // JNE
                        let pred_ok1 = CL; em32(0)  // placeholder for ok offset
                        em(0x48); em(0x81); em(0xf8); em32(SCAN_PRED_BOUND2)  // cmp rax, B2
                        if SCAN_PRED_OP2 == 26 { em(0x0f); em(0x8d) }
                        if SCAN_PRED_OP2 == 24 { em(0x0f); em(0x8f) }
                        if SCAN_PRED_OP2 == 25 { em(0x0f); em(0x8e) }
                        if SCAN_PRED_OP2 == 23 { em(0x0f); em(0x8c) }
                        if SCAN_PRED_OP2 == 21 { em(0x0f); em(0x84) }
                        if SCAN_PRED_OP2 == 22 { em(0x0f); em(0x85) }
                        let pred_ok2 = CL; em32(0)
                        em(0x0f); em(0x0b)  // ud2: neither condition satisfied
                        patch32(pred_ok1, CL)
                        patch32(pred_ok2, CL)
                    } else {
                        em(0x48); em(0x81); em(0xf8); em32(SCAN_PRED_BOUND)  // cmp rax, imm32
                        if SCAN_PRED_OP == 26 { em(0x0f); em(0x8d) }  // JGE (>=)
                        if SCAN_PRED_OP == 24 { em(0x0f); em(0x8f) }  // JG  (>)
                        if SCAN_PRED_OP == 25 { em(0x0f); em(0x8e) }  // JLE (<=)
                        if SCAN_PRED_OP == 23 { em(0x0f); em(0x8c) }  // JL  (<)
                        if SCAN_PRED_OP == 21 { em(0x0f); em(0x84) }  // JE  (==)
                        if SCAN_PRED_OP == 22 { em(0x0f); em(0x85) }  // JNE (!=)
                        let pred_ok_off = CL; em32(0)
                        em(0x0f); em(0x0b)  // ud2: refinement predicate violated (trap)
                        patch32(pred_ok_off, CL)
                    }
                    SCAN_HAS_PRED = 0
                    SCAN_HAS_PRED2 = 0
                }
                if SCAN_HAS_PRED == 1 && SCAN_PRED_IS_F64 == 1 {
                    // f64 refinement: movq xmm0, rax; load bound into xmm1; ucomisd; Jcc ok; ud2
                    // CMP does not clobber rax — ucomisd/movq xmm0,rax also does NOT modify rax.
                    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc0)  // movq xmm0, rax
                    em(0x48); em(0xb9); em64(SCAN_PRED_BOUND)         // mov rcx, imm64 (bound bits)
                    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc9)  // movq xmm1, rcx
                    em(0x66); em(0x0f); em(0x2e); em(0xc1)            // ucomisd xmm0, xmm1
                    if SCAN_PRED_OP == 26 { em(0x0f); em(0x83) }  // JAE (>=)
                    if SCAN_PRED_OP == 24 { em(0x0f); em(0x87) }  // JA  (>)
                    if SCAN_PRED_OP == 25 { em(0x0f); em(0x86) }  // JBE (<=)
                    if SCAN_PRED_OP == 23 { em(0x0f); em(0x82) }  // JB  (<)
                    if SCAN_PRED_OP == 21 { em(0x0f); em(0x84) }  // JE  (==)
                    if SCAN_PRED_OP == 22 { em(0x0f); em(0x85) }  // JNE (!=)
                    let pred_ok_f_off = CL; em32(0)
                    em(0x0f); em(0x0b)  // ud2: refinement predicate violated (trap)
                    patch32(pred_ok_f_off, CL)
                    SCAN_HAS_PRED = 0
                }
                emit_store_var(slot)
                // Set f64 flag: explicit type annotation takes priority, else infer from RHS
                if decl_is_f64 == 1 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 1 }
                else if decl_is_f64 == 0 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 0 }
                else { VAR_IS_F64[(VAR_COUNT - 1) as usize] = EXPR_IS_F64 }
                if decl_ty != 0 || decl_ty_hash != 0 {
                    VAR_TY[vix as usize] = decl_ty
                    VAR_TY_HASH[vix as usize] = decl_ty_hash
                } else {
                    VAR_TY[vix as usize] = EXPR_TY
                    VAR_TY_HASH[vix as usize] = EXPR_TY_HASH
                }
                if VAR_TY[vix as usize] == 8 {
                    VAR_ALEN[vix as usize] = arr_hash_alen(VAR_TY_HASH[vix as usize])
                    VAR_ESIZ[vix as usize] = arr_hash_esiz(VAR_TY_HASH[vix as usize])
                }
                // fn-type values always need closure-ABI dispatch (tagged thunk or struct)
                if EXPR_TY == 9 { LAST_EXPR_IS_CLOSURE = 1 }
                VAR_IS_CLOSURE[(VAR_COUNT - 1) as usize] = LAST_EXPR_IS_CLOSURE
                VAR_MUT[(VAR_COUNT - 1) as usize] = decl_is_mut
                // Set linear/affine flag if RHS was a linear/affine struct literal
                VAR_LINEAR[(VAR_COUNT - 1) as usize] = LAST_EXPR_IS_LINEAR
                VAR_AFFINE[(VAR_COUNT - 1) as usize] = LAST_EXPR_IS_AFFINE
                // Set unit hash for unit-typed variables (e.g. let mass: mg = 5.0, let e: J = 1.0)
                if decl_ty_hash != 0 && type_hash_unit_dim(decl_ty_hash) != 0 {
                    VAR_UNIT[(VAR_COUNT - 1) as usize] = decl_ty_hash
                } else if decl_ty == 0 && decl_ty_hash == 0 && EXPR_UNIT != 0 {
                    VAR_UNIT[(VAR_COUNT - 1) as usize] = EXPR_UNIT
                }
                // β⁴/β⁵: capture variance and sensitivity shadow slots into the new variable
                // Mutable f64 vars get a fixed runtime slot so variance_of() works across loop iterations
                if decl_is_mut == 1 && EXPR_IS_F64 == 1 {
                    let fixed_vs = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + 1
                    VAR_VSHADOW[vix as usize] = fixed_vs
                    if EXPR_VSHADOW >= 0 { emit_load_var(EXPR_VSHADOW) }
                    else { emit_imm64(0) }
                    emit_store_var(fixed_vs)
                } else {
                    VAR_VSHADOW[vix as usize] = EXPR_VSHADOW
                }
                VAR_SSHADOW[vix as usize] = EXPR_SSHADOW
                VAR_SSHADOW_1[vix as usize] = EXPR_SSHADOW_1
                VAR_SSHADOW_2[vix as usize] = EXPR_SSHADOW_2
                VAR_SSHADOW_3[vix as usize] = EXPR_SSHADOW_3
                VAR_SSHADOW_4[vix as usize] = EXPR_SSHADOW_4
                VAR_SSHADOW_5[vix as usize] = EXPR_SSHADOW_5
                VAR_SSHADOW_6[vix as usize] = EXPR_SSHADOW_6
                VAR_SSHADOW_7[vix as usize] = EXPR_SSHADOW_7
                VAR_HSHADOW_00[vix as usize] = EXPR_HSHADOW_00
                VAR_HSHADOW_01[vix as usize] = EXPR_HSHADOW_01
                VAR_HSHADOW_02[vix as usize] = EXPR_HSHADOW_02
                VAR_HSHADOW_03[vix as usize] = EXPR_HSHADOW_03
                VAR_HSHADOW_11[vix as usize] = EXPR_HSHADOW_11
                VAR_HSHADOW_12[vix as usize] = EXPR_HSHADOW_12
                VAR_HSHADOW_13[vix as usize] = EXPR_HSHADOW_13
                VAR_HSHADOW_22[vix as usize] = EXPR_HSHADOW_22
                VAR_HSHADOW_23[vix as usize] = EXPR_HSHADOW_23
                VAR_HSHADOW_33[vix as usize] = EXPR_HSHADOW_33
                VAR_HSHADOW_04[vix as usize] = EXPR_HSHADOW_04
                VAR_HSHADOW_05[vix as usize] = EXPR_HSHADOW_05
                VAR_HSHADOW_06[vix as usize] = EXPR_HSHADOW_06
                VAR_HSHADOW_07[vix as usize] = EXPR_HSHADOW_07
                VAR_HSHADOW_14[vix as usize] = EXPR_HSHADOW_14
                VAR_HSHADOW_15[vix as usize] = EXPR_HSHADOW_15
                VAR_HSHADOW_16[vix as usize] = EXPR_HSHADOW_16
                VAR_HSHADOW_17[vix as usize] = EXPR_HSHADOW_17
                VAR_HSHADOW_24[vix as usize] = EXPR_HSHADOW_24
                VAR_HSHADOW_25[vix as usize] = EXPR_HSHADOW_25
                VAR_HSHADOW_26[vix as usize] = EXPR_HSHADOW_26
                VAR_HSHADOW_27[vix as usize] = EXPR_HSHADOW_27
                VAR_HSHADOW_34[vix as usize] = EXPR_HSHADOW_34
                VAR_HSHADOW_35[vix as usize] = EXPR_HSHADOW_35
                VAR_HSHADOW_36[vix as usize] = EXPR_HSHADOW_36
                VAR_HSHADOW_37[vix as usize] = EXPR_HSHADOW_37
                VAR_HSHADOW_44[vix as usize] = EXPR_HSHADOW_44
                VAR_HSHADOW_45[vix as usize] = EXPR_HSHADOW_45
                VAR_HSHADOW_46[vix as usize] = EXPR_HSHADOW_46
                VAR_HSHADOW_47[vix as usize] = EXPR_HSHADOW_47
                VAR_HSHADOW_55[vix as usize] = EXPR_HSHADOW_55
                VAR_HSHADOW_56[vix as usize] = EXPR_HSHADOW_56
                VAR_HSHADOW_57[vix as usize] = EXPR_HSHADOW_57
                VAR_HSHADOW_66[vix as usize] = EXPR_HSHADOW_66
                VAR_HSHADOW_67[vix as usize] = EXPR_HSHADOW_67
                VAR_HSHADOW_77[vix as usize] = EXPR_HSHADOW_77
                // β⁹ GTT: persist the RHS expression's channel topology
                // into the newly-bound variable, then reset EXPR_CH_SET.
                VAR_CH_SET[vix as usize] = EXPR_CH_SET
                VAR_PARAM_USED[vix as usize] = EXPR_PARAM_USED
                EXPR_VSHADOW = -1
                EXPR_SSHADOW = -1
                EXPR_SSHADOW_1 = -1; EXPR_SSHADOW_2 = -1; EXPR_SSHADOW_3 = -1; EXPR_SSHADOW_4 = -1; EXPR_SSHADOW_5 = -1; EXPR_SSHADOW_6 = -1; EXPR_SSHADOW_7 = -1
                EXPR_HSHADOW_00 = -1; EXPR_HSHADOW_01 = -1; EXPR_HSHADOW_02 = -1; EXPR_HSHADOW_03 = -1
                EXPR_HSHADOW_11 = -1; EXPR_HSHADOW_12 = -1; EXPR_HSHADOW_13 = -1
                EXPR_HSHADOW_22 = -1; EXPR_HSHADOW_23 = -1; EXPR_HSHADOW_33 = -1
    EXPR_HSHADOW_04 = -1; EXPR_HSHADOW_05 = -1; EXPR_HSHADOW_06 = -1; EXPR_HSHADOW_07 = -1
    EXPR_HSHADOW_14 = -1; EXPR_HSHADOW_15 = -1; EXPR_HSHADOW_16 = -1; EXPR_HSHADOW_17 = -1
    EXPR_HSHADOW_24 = -1; EXPR_HSHADOW_25 = -1; EXPR_HSHADOW_26 = -1; EXPR_HSHADOW_27 = -1
    EXPR_HSHADOW_34 = -1; EXPR_HSHADOW_35 = -1; EXPR_HSHADOW_36 = -1; EXPR_HSHADOW_37 = -1
    EXPR_HSHADOW_44 = -1; EXPR_HSHADOW_45 = -1; EXPR_HSHADOW_46 = -1; EXPR_HSHADOW_47 = -1
    EXPR_HSHADOW_55 = -1; EXPR_HSHADOW_56 = -1; EXPR_HSHADOW_57 = -1
    EXPR_HSHADOW_66 = -1; EXPR_HSHADOW_67 = -1
    EXPR_HSHADOW_77 = -1
                EXPR_CH_SET = 0
                EXPR_PARAM_USED = 0
            }
        }
        return
    }

    // x.field[outer][inner] = expr (nested array double-subscript store)
    if stmt_is_field_array_array_store(EP) {
        if current_fn_allows_mutation() == false {
            tc_effect_violation(EP, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        compile_field_array_array_store_x86()
        return
    }

    // name.f1.f2[idx] = expr through either a pointer root or an inline value struct.
    if stmt_is_field_field_array_store_shape(EP) {
        if token_chain_root_is_pointer(EP) {
            compile_autoderef_field_field_array_store_x86()
        } else {
            compile_value_field_field_array_store_x86()
        }
        return
    }
    // name.f1.f2 = expr through a pointer var (auto-deref) OR an inline value struct.
    if stmt_is_field_field_store_shape(EP) {
        if token_chain_root_is_pointer(EP) {
            compile_autoderef_field_field_store_x86()
        } else {
            compile_value_field_field_store_x86()
        }
        return
    }
    // x.field[idx] = expr
    if stmt_is_field_array_store(EP) {
        if current_fn_allows_mutation() == false {
            tc_effect_violation(EP, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        compile_field_array_store_x86()
        return
    }

    // x.array_field[idx].leaf_array[idx2] = expr
    if stmt_is_indexed_field_field_array_store(EP) {
        if current_fn_allows_mutation() == false {
            tc_effect_violation(EP, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        compile_indexed_field_field_array_store_x86()
        return
    }

    // x.array_field[idx].field = expr
    if stmt_is_indexed_field_field_store(EP) {
        if current_fn_allows_mutation() == false {
            tc_effect_violation(EP, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        compile_indexed_field_field_store_x86()
        return
    }

    // x.field = expr (struct field write)
    if (k == 3 || k == 79) && TK[(EP + 1) as usize] == 50 && TK[(EP + 3) as usize] == 16 {
        let name_tok = EP
        if current_fn_allows_mutation() == false {
            tc_effect_violation(name_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[EP as usize]
        let ne = TE[EP as usize]
        let field_tok = EP + 2
        EP = EP + 2  // skip name and .
        let fns = TS[EP as usize]
        let fne = TE[EP as usize]
        let fh = gl_name_hash(fns, fne)
        EP = EP + 1  // skip field name
        if TK[EP as usize] == 16 { EP = EP + 1 }  // skip =
        compile_or()  // value in rax
        let rhs_ty = EXPR_TY
        let rhs_ty_hash = EXPR_TY_HASH
        ST_QUERY_NS = fns
        ST_QUERY_NE = fne
        let si = resolve_field_struct_index(ns, ne, fh)
        ST_QUERY_NS = -1
        ST_QUERY_NE = -1
        if si < 0 {
            tc_error(field_tok, "unknown field access")
            return
        }
        if st_private_access_denied(si, field_tok) {
            tc_error_hard(field_tok, "private struct field access")
            return
        }
        ST_QUERY_NS = fns
        ST_QUERY_NE = fne
        let off = st_field_offset(si, fh)
        let fty = st_field_ty(si, fh)
        let fhash = st_field_hash(si, fh)
        ST_QUERY_NS = -1
        ST_QUERY_NE = -1
        if fty != 0 && ty_eq(fty, fhash, rhs_ty, rhs_ty_hash) == false {
            tc_error(EP - 1, "assignment type mismatch")
        }
        // Observation boundary: storing Unobserved<T> into non-Unobserved field
        if ty_is_unobserved(rhs_ty) && !ty_is_unobserved(fty) && (FN_EFFECTS[CURRENT_FN as usize] & 64) == 0 {
            tc_observe_boundary(field_tok, "cannot store Unobserved<T> into non-Unobserved field")
        }
        em(0x50)  // push value/src ptr
        let slot = var_find(ns, ne)
        if slot >= 0 { emit_load_var(slot) }
        else {
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                em(0x48); em(0xb8); em64(addr)
            } else {
                tc_undefined_var(name_tok)
                em(0x31); em(0xc0)
            }
        }
        if off != 0 { em(0x48); em(0x8d); em(0x80); em32(off) }
        em(0x5a)  // pop rdx (value/src ptr)
        if fty == 8 || type_is_option_inline(fty, fhash) || fty == 6 || knowledge_hash_is(fhash) {
            emit_copy_agg_to_ptr_x86(fty, fhash)
        } else {
            em(0x48); em(0x89); em(0x10)  // mov [rax], rdx
        }
        return
    }

    // x = expr (local or global scalar assignment)
    if (k == 3 || k == 79) && TK[(EP + 1) as usize] == 16 {
        let name_tok = EP
        if current_fn_allows_mutation() == false {
            tc_effect_violation(name_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[EP as usize]
        let ne = TE[EP as usize]
        EP = EP + 2
        compile_or()
        let rhs_ty = EXPR_TY
        let rhs_ty_hash = EXPR_TY_HASH
        let slot = var_find(ns, ne)
        if slot >= 0 {
            let ty_vi = var_find_idx(ns, ne)
            if ty_vi >= 0 {
                if VAR_MUT[ty_vi as usize] == 0 {
                    tc_error_hard(name_tok, "assignment to immutable binding requires var/Mut")
                }
                if ty_eq(VAR_TY[ty_vi as usize], VAR_TY_HASH[ty_vi as usize], rhs_ty, rhs_ty_hash) == false {
                    tc_error(EP - 1, "assignment type mismatch")
                }
                // Linear reassignment: old value must be consumed before overwrite
                if VAR_LINEAR[ty_vi as usize] == 1 {
                    if VAR_USED[ty_vi as usize] == 0 {
                        tc_linear_violation(name_tok, "linear value not consumed")
                    }
                    VAR_USED[ty_vi as usize] = 0
                }
            }
            if ty_vi >= 0 && VAR_TY[ty_vi as usize] == 8 {
                copy_array_into_local_slot_x86(slot, VAR_TY_HASH[ty_vi as usize])
            } else if ty_vi >= 0 && type_is_option_inline(VAR_TY[ty_vi as usize], VAR_TY_HASH[ty_vi as usize]) && VAR_ESIZ[ty_vi as usize] >= 16 {
                emit_copy_option_to_local_x86(slot)
            } else if ty_vi >= 0 && type_is_struct_like(VAR_TY[ty_vi as usize], VAR_TY_HASH[ty_vi as usize]) {
                copy_struct_into_local_slot_x86(slot, VAR_TY_HASH[ty_vi as usize])
            } else {
                emit_store_var(slot)
            }
            // β⁵: update variance/sensitivity shadow on var reassignment
            if ty_vi >= 0 {
                if VAR_MUT[ty_vi as usize] == 1 && VAR_IS_F64[ty_vi as usize] == 1 {
                    // Fixed runtime variance slot: emit runtime update code
                    let fixed_vs = VAR_VSHADOW[ty_vi as usize]
                    if fixed_vs >= 0 {
                        if EXPR_VSHADOW >= 0 { emit_load_var(EXPR_VSHADOW) }
                        else { emit_imm64(0) }
                        emit_store_var(fixed_vs)
                    }
                    VAR_SSHADOW[ty_vi as usize] = EXPR_SSHADOW
                    VAR_SSHADOW_1[ty_vi as usize] = EXPR_SSHADOW_1
                    VAR_SSHADOW_2[ty_vi as usize] = EXPR_SSHADOW_2
                    VAR_SSHADOW_3[ty_vi as usize] = EXPR_SSHADOW_3
                } else {
                    VAR_VSHADOW[ty_vi as usize] = EXPR_VSHADOW
                    VAR_SSHADOW[ty_vi as usize] = EXPR_SSHADOW
                    VAR_SSHADOW_1[ty_vi as usize] = EXPR_SSHADOW_1
                    VAR_SSHADOW_2[ty_vi as usize] = EXPR_SSHADOW_2
                    VAR_SSHADOW_3[ty_vi as usize] = EXPR_SSHADOW_3
                }
                // β⁹ GTT: update channel topology on var reassignment (mirrors let-declaration path)
                VAR_CH_SET[ty_vi as usize] = EXPR_CH_SET
                VAR_PARAM_USED[ty_vi as usize] = EXPR_PARAM_USED
            }
            EXPR_VSHADOW = -1; EXPR_SSHADOW = -1; EXPR_SSHADOW_1 = -1; EXPR_SSHADOW_2 = -1; EXPR_SSHADOW_3 = -1; EXPR_SSHADOW_4 = -1; EXPR_SSHADOW_5 = -1; EXPR_SSHADOW_6 = -1; EXPR_SSHADOW_7 = -1
            // Update closure flag on reassignment
            if EXPR_TY == 9 { LAST_EXPR_IS_CLOSURE = 1 }
            var vi: i64 = VAR_COUNT - 1
            while vi >= 0 {
                if name_eq(VAR_NS[vi as usize], VAR_NE[vi as usize], ns, ne) {
                    VAR_IS_CLOSURE[vi as usize] = LAST_EXPR_IS_CLOSURE
                    vi = -1  // break
                }
                vi = vi - 1
            }
        }
        else {
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                if ty_eq(GL_TY[gi as usize], GL_TY_HASH[gi as usize], rhs_ty, rhs_ty_hash) == false {
                    tc_error(EP - 1, "assignment type mismatch")
                }
                let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                if type_is_option_inline(GL_TY[gi as usize], GL_TY_HASH[gi as usize]) && GL[(gi * 4 + 2) as usize] >= 16 {
                    em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (src ptr)
                    em(0x48); em(0xb8); em64(addr)  // mov rax, dst
                    emit_copy_agg_to_ptr_x86(11, GL_TY_HASH[gi as usize])
                } else if type_is_struct_like(GL_TY[gi as usize], GL_TY_HASH[gi as usize]) || knowledge_hash_is(GL_TY_HASH[gi as usize]) {
                    em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (src ptr)
                    em(0x48); em(0xb8); em64(addr)  // mov rax, dst
                    emit_copy_agg_to_ptr_x86(6, GL_TY_HASH[gi as usize])
                } else {
                    // mov rcx, rax; mov rax, addr; mov [rax], rcx
                    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (value)
                    em(0x48); em(0xb8); em64(addr)  // mov rax, addr
                    em(0x48); em(0x89); em(0x08)    // mov [rax], rcx
                }
            } else {
                tc_undefined_var(name_tok)
            }
        }
        return
    }
    // ARRAY[idx].field(.field)* = expr (store into struct element of an array)
    if stmt_is_array_elem_field_store(EP) {
        compile_array_elem_field_store_x86()
        return
    }
    // ARRAY[idx] = expr (global array write)
    if stmt_is_array_store(EP) {
        let name_tok = EP
        if current_fn_allows_mutation() == false {
            tc_effect_violation(name_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[EP as usize]
        let ne = TE[EP as usize]
        EP = EP + 2  // skip name and [
        compile_or()  // index in rax
        if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }  // skip 'as usize'
        if TK[EP as usize] == 42 { EP = EP + 1 }  // skip ]
        if TK[EP as usize] == 16 { EP = EP + 1 }  // skip =
        em(0x50)  // push index
        compile_or()  // value in rax
        // Seq<T> subscript store: seq[i] = v is sugar for seq.set(i, v) (local).
        let seq_svi = var_find_idx(ns, ne)
        if seq_svi >= 0 && VAR_TY[seq_svi as usize] == 12 {
            let seq_vslot = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var(seq_vslot)         // value (rax) → slot
            em(0x58)                           // pop rax (index)
            let seq_islot = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var(seq_islot)
            let seq_pslot = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_load_var(var_find(ns, ne))   // seq ptr
            emit_store_var(seq_pslot)
            emit_seq_set_slots_x86(seq_pslot, seq_islot, seq_vslot)
            return
        }
        let gi = gl_find(ns, ne)
        if gi >= 0 {
            let base = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
            let esz = GL[(gi * 4 + 2) as usize]
            // rax = value, stack = index
            materialize_aggregate_array_element_x86(GL_TY_HASH[gi as usize])
            em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (value)
            em(0x59)  // pop rcx (index)
            em(0x48); em(0xb8); em64(base)  // mov rax, base
            if esz == 8 {
                em(0x48); em(0x89); em(0x14); em(0xc8)  // mov [rax + rcx*8], rdx
            } else {
                em(0x88); em(0x14); em(0x08)  // mov [rax + rcx], dl (byte store)
            }
        } else {
            // Local array store: ptr[idx] = val
            let lslot = var_find(ns, ne)
            if lslot >= 0 {
                let llalen = var_find_alen(ns, ne)
                let lesiz = var_find_esiz(ns, ne)
                let lvi = var_find_idx(ns, ne)
                var is_arr_ty = 0
                var is_slice_ty = 0
                var array_hash: i64 = 0
                if lvi >= 0 && VAR_TY[lvi as usize] == 8 { is_arr_ty = 1; array_hash = VAR_TY_HASH[lvi as usize] }
                if lvi >= 0 && VAR_TY[lvi as usize] == 10 {
                    if ref_hash_inner_ty(VAR_TY_HASH[lvi as usize]) == 8 {
                        is_arr_ty = 1
                        array_hash = ref_hash_inner_hash(VAR_TY_HASH[lvi as usize])
                        if type_is_slice_ref(VAR_TY[lvi as usize], VAR_TY_HASH[lvi as usize]) { is_slice_ty = 1 }
                    }
                }
                materialize_aggregate_array_element_x86(array_hash)
                em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (value)
                em(0x59)  // pop rcx (index)
                if is_slice_ty == 1 {
                    emit_load_var(VAR_LEN_SLOT[lvi as usize])
                    em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
                    em(0x0f); em(0x82); let slice_store_ok = CL; em32(0)
                    emit_assert_fail()
                    patch32(slice_store_ok, CL)
                }
                emit_load_var(lslot)  // load base ptr into rax
                if is_arr_ty == 1 && lesiz == 8 {
                    em(0x48); em(0x89); em(0x14); em(0xc8)  // mov [rax + rcx*8], rdx
                } else if is_arr_ty == 1 && lesiz == 1 {
                    em(0x88); em(0x14); em(0x08)  // mov [rax + rcx], dl
                } else {
                    // Non-array local pointer: byte store
                    em(0x88); em(0x14); em(0x08)  // mov [rax + rcx], dl
                }
            } else {
                tc_undefined_var(name_tok)
                em(0x59)  // discard pushed index
            }
        }
        return
    }

    // (*name).field[idx] = expr  (explicit-deref store into a struct array field)
    if stmt_is_deref_field_array_store(EP) {
        compile_deref_field_array_store_x86()
        return
    }
    // (*<complex-expr>).field[idx] = expr  (e.g. (*(*c).w).data[i]) — general deref base
    if stmt_is_deref_complex_field_array_store(EP) {
        compile_deref_complex_field_array_store_x86()
        return
    }
    // (*ARRAY_PTR)[idx] = expr
    if stmt_is_deref_array_store(EP) {
        let name_tok = EP + 2
        if current_fn_allows_mutation() == false {
            tc_effect_violation(name_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[(EP + 2) as usize]
        let ne = TE[(EP + 2) as usize]
        EP = EP + 5  // skip ( * name ) [
        compile_or()  // index in rax
        if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }  // skip 'as usize'
        if TK[EP as usize] == 42 { EP = EP + 1 }  // skip ]
        if TK[EP as usize] == 16 { EP = EP + 1 }  // skip =
        em(0x50)  // push index
        compile_or()  // value in rax
        let lslot = var_find(ns, ne)
        if lslot >= 0 {
            let lesiz = var_find_esiz(ns, ne)
            em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (value)
            em(0x59)  // pop rcx (index)
            emit_load_var(lslot)  // load array base ptr into rax
            if lesiz == 8 {
                em(0x48); em(0x89); em(0x14); em(0xc8)  // mov [rax + rcx*8], rdx
            } else {
                em(0x88); em(0x14); em(0x08)  // mov [rax + rcx], dl
            }
        } else {
            tc_undefined_var(name_tok)
            em(0x59)  // discard pushed index
        }
        return
    }
    // *PTR = expr
    if stmt_is_deref_store(EP) {
        let name_tok = EP + 1
        if current_fn_allows_mutation() == false {
            tc_effect_violation(name_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[(EP + 1) as usize]
        let ne = TE[(EP + 1) as usize]
        EP = EP + 2
        if TK[EP as usize] == 16 { EP = EP + 1 }
        compile_or()
        let rhs_ty = EXPR_TY
        let rhs_ty_hash = EXPR_TY_HASH
        let lslot = var_find(ns, ne)
        if lslot >= 0 {
            let lvi = var_find_idx(ns, ne)
            // A raw pointer (VAR_TY 11) always allows the store below. A ref (VAR_TY
            // 10) shares the identical inner-type hash encoding (ptr_hash_* delegate
            // straight to ref_hash_*) and the identical runtime representation (an
            // address value in the variable's slot) — it was previously excluded here
            // entirely, so `*n = v` for `n: &!T` compiled with only a non-fatal
            // warning and NO store instruction emitted at all (issue #620). Only a
            // *mutable* ref (`&!T`, ref_hash_mut != 0) may be written through; a
            // shared ref (`&T`) must still be rejected.
            let lvar_ty = VAR_TY[lvi as usize]
            let lvar_hash = VAR_TY_HASH[lvi as usize]
            let is_raw_ptr = lvar_ty == 11 && type_is_pointer_like(lvar_ty, lvar_hash)
            let is_mut_ref = lvar_ty == 10 && ref_hash_mut(lvar_hash) != 0
            if lvi >= 0 && (is_raw_ptr || is_mut_ref) {
                let inner_ty = ptr_hash_inner_ty(lvar_hash)
                let inner_hash = ptr_hash_inner_hash(lvar_hash)
                if ty_eq(inner_ty, inner_hash, rhs_ty, rhs_ty_hash) == false {
                    tc_error(EP - 1, "assignment type mismatch")
                }
                emit_store_to_pointer_offset_x86(lslot, 0, inner_ty, inner_hash)
            } else {
                tc_error(name_tok, "dereference assignment requires a raw pointer or a mutable (&!T) reference binding")
            }
        } else {
            tc_undefined_var(name_tok)
        }
        return
    }
    // (*name).f1.f2[idx] = expr  (two-level nested deref store into an array field)
    if stmt_is_deref_field_field_array_store(EP) {
        compile_deref_field_field_array_store_x86()
        return
    }
    // (*name).f1.f2 = expr  (two-level nested deref store)
    if stmt_is_deref_field_field_store(EP) {
        compile_deref_field_field_store_x86()
        return
    }
    // (*PTR).field = expr
    if stmt_is_deref_field_store(EP) {
        let name_tok = EP + 2
        let field_tok = EP + 5
        if current_fn_allows_mutation() == false {
            tc_effect_violation(field_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[name_tok as usize]
        let ne = TE[name_tok as usize]
        let fh = gl_name_hash(TS[field_tok as usize], TE[field_tok as usize])
        EP = EP + 7
        compile_or()
        let rhs_ty = EXPR_TY
        let rhs_ty_hash = EXPR_TY_HASH
        let lslot = var_find(ns, ne)
        if lslot >= 0 {
            let lvi = var_find_idx(ns, ne)
            let lty = VAR_TY[lvi as usize]
            if lvi >= 0 && type_is_pointer_like(lty, VAR_TY_HASH[lvi as usize]) {
                let inner_ty = ptr_hash_inner_ty(VAR_TY_HASH[lvi as usize])
                let inner_hash = ptr_hash_inner_hash(VAR_TY_HASH[lvi as usize])
                if inner_ty != 6 {
                    tc_error(field_tok, "field access through pointer/ref requires struct pointee")
                } else {
                    let si = st_find(inner_hash)
                    if si < 0 {
                        tc_error(field_tok, "unknown field access")
                    } else if st_private_access_denied(si, field_tok) {
                        tc_error_hard(field_tok, "private struct field access")
                    } else {
                    ST_QUERY_NS = TS[field_tok as usize]
                    ST_QUERY_NE = TE[field_tok as usize]
                        let foff = st_field_offset(si, fh)
                        let fty = st_field_ty(si, fh)
                        let fhash = st_field_hash(si, fh)
                    ST_QUERY_NS = -1
                    ST_QUERY_NE = -1
                        if foff < 0 {
                            tc_error(field_tok, "unknown field access")
                        } else if ty_eq(fty, fhash, rhs_ty, rhs_ty_hash) == false {
                            tc_error(EP - 1, "assignment type mismatch")
                        } else {
                            emit_store_to_pointer_offset_x86(lslot, foff, fty, fhash)
                        }
                    }
                }
            } else {
                tc_error(field_tok, "field access through deref requires ref or pointer binding")
            }
        } else {
            tc_undefined_var(name_tok)
        }
        return
    }

    // (*name).field.field[idx] = expr  and  (*name).field.field = expr — two-level nested
    // *mut writes. Without these, the two-field LHS fell to the generic assignment path,
    // which materialised the inline intermediate struct field as a value-copy, wrote into
    // the copy, and discarded it (read back as 0) — the nested-*mut-write codegen bug.
    if stmt_is_deref_field_field_array_store(EP) {
        compile_deref_field_field_array_store_x86()
        return
    }
    if stmt_is_deref_field_field_store(EP) {
        compile_deref_field_field_store_x86()
        return
    }

    // (*name).arr[i].field = expr (and deeper: (*name).arr[i].arr2[j].field = expr) —
    // a field of an INDEXED element. Must be dispatched AFTER the shapes above (all of
    // which end in `]` or carry no index, so the predicate is disjoint) and BEFORE the
    // expression-statement fall-through, which silently wrote into a discarded value-copy
    // of the element AND typed the assignment as a value.
    if stmt_is_deref_indexed_elem_field_store(EP) {
        compile_deref_indexed_elem_field_store_x86()
        return
    }

    // name.arr[i].field = expr — the auto-deref twin of the shape above, for a ref/param root
    // OR a plain struct root (both keep their base address in the slot; see
    // ident_chain_root_supported, which also makes globals and non-aggregate roots fall
    // through untouched instead of being hard-rejected). Dispatched at this point (not
    // earlier) so every narrow ident-root handler above keeps its shapes — those cover one
    // field hop before the index; this catches the deeper chains they miss.
    if stmt_is_ident_indexed_elem_field_store(EP) {
        if ident_chain_root_supported(EP) {
            compile_deref_indexed_elem_field_store_x86()
            return
        }
    }

    // (*name.field)<chain> = expr — root is a deref of a pointer held in a struct field.
    // Disjoint from every predicate above by construction (they all require `)` right after
    // the simple name, or a parenthesised inner base), so no dispatch ordering hazard: this
    // accepts the full chain grammar because nothing else ever accepted this root at all.
    if stmt_is_deref_inner_root_store(EP) {
        compile_deref_indexed_elem_field_store_x86()
        return
    }

    // return expr
    if k == 2 {
        EP = EP + 1
        if TK[EP as usize] != 9 {
            compile_or()
        }
        else {
            em(0x31); em(0xc0)
            EXPR_TY = 5
            EXPR_TY_HASH = 0
        }
        if ty_eq(CURRENT_RET_TY, CURRENT_RET_HASH, EXPR_TY, EXPR_TY_HASH) == false {
            // Allow numeric coercions (i32→i64, unit→f64, etc.)
            if (ty_is_numeric(CURRENT_RET_TY) && ty_is_numeric(EXPR_TY)) == false {
                if (CURRENT_RET_TY != 0 || CURRENT_RET_HASH != 0) && (EXPR_TY != 0 || EXPR_TY_HASH != 0) {
                    if type_has_knowledge(CURRENT_RET_TY, CURRENT_RET_HASH) || type_has_knowledge(EXPR_TY, EXPR_TY_HASH) {
                        tc_epistemic_boundary(EP)
                    } else {
                        tc_error(EP - 1, "return type does not match function signature")
                    }
                }
            }
        }
        // PR-5: enforce refinement predicate on return value (literal/let-literal)
        try_apply_return_refinement(EP - 1)
        // Observation boundary: returning Unobserved<T> from non-Observe function
        if ty_is_unobserved(EXPR_TY) && !ty_is_unobserved(CURRENT_RET_TY) && (FN_EFFECTS[CURRENT_FN as usize] & 64) == 0 {
            tc_observe_boundary(EP - 1, "cannot return Unobserved<T> as non-Unobserved type")
        }
        if CURRENT_SRET_SLOT > 0 || type_is_aggregate(CURRENT_RET_TY, CURRENT_RET_HASH) || type_is_aggregate(EXPR_TY, EXPR_TY_HASH) {
            stabilize_return_agg_x86(EXPR_TY, EXPR_TY_HASH)
        }
        // Linear type check at early return: any unconsumed linear var is an error
        var lce: i64 = 0
        while lce < VAR_COUNT {
            if VAR_LINEAR[lce as usize] == 1 && VAR_USED[lce as usize] == 0 {
                tc_linear_violation(EP - 1, "linear value not consumed")
            }
            lce = lce + 1
        }
        // β⁵: store return variance to global BSS for inter-procedural propagation
        if EXPR_IS_F64 == 1 {
            em(0x50)  // push rax (save return value)
            if EXPR_VSHADOW >= 0 {
                emit_load_var(EXPR_VSHADOW)
            } else {
                emit_imm64(0)
            }
            emit_store_rax_to_abs_qword_x86(GL_BSS_BASE + B5_RET_VSHADOW_BSS_OFF)
            em(0x58)  // pop rax (restore return value)
        }
        em(0x48); em(0x81); em(0xc4); record_frame_patch(); em32(0)
        if CURRENT_SRET_SLOT > 0 {
            em(0x4c); em(0x89); em(0xe0)  // mov rax, r12 (return SRET ptr)
            em(0x41); em(0x5c)  // pop r12
        }
        em(0x5d); em(0xc3)
        return
    }

    // continue (33)
    if k == 33 {
        if LOOP_DEPTH <= 0 {
            tc_error_hard(EP, "continue outside loop")
            EP = EP + 1
            return
        }
        EP = EP + 1
        if LOOP_DEPTH > 0 {
            em(0xe9)
            let rel = LOOP_TOP[(LOOP_DEPTH - 1) as usize] - (CL + 4)
            em32(rel)
        }
        return
    }

    // break (34) — emit jmp rel32 placeholder, patched when while loop ends
    if k == 34 {
        if LOOP_DEPTH <= 0 {
            tc_error_hard(EP, "break outside loop")
            EP = EP + 1
            return
        }
        EP = EP + 1
        em(0xe9)  // jmp rel32
        BREAK_PATCH[BREAK_COUNT as usize] = CL
        BREAK_COUNT = BREAK_COUNT + 1
        em32(0)  // placeholder — patched by while handler
        return
    }

    if stmt_is_gpu_launch_perform(EP) {
        compile_gpu_launch_stmt_x86()
        return
    }

    if stmt_is_gpu_sync_perform(EP) {
        compile_gpu_sync_stmt_x86()
        return
    }

    // if expr { stmts } else if ... / else { stmts }
    if k == 13 {
        let if_tok = EP
        EP = EP + 1

        // ── Phase 1.3: if let <pattern> = <expr> { ... } ──
        // Syntax: if let <pat> = <scrutinee> { <then> } [else { <alt> }]
        // Supported patterns: Some(v), None, Ok(v), Err(e), Enum::Variant, Enum::Variant(v), _
        if TK[EP as usize] == 11 {
            EP = EP + 1  // skip 'let'
            // Determine pattern kind and binding info
            let pat_tk = TK[EP as usize]
            var il_disc: i64 = -1          // discriminant (for tagged unions)
            var il_is_tagged: i64 = 0      // 1 if pattern is Some/Ok/Err
            var il_is_wildcard: i64 = 0    // 1 for _
            var il_is_enum_variant: i64 = 0 // 1 for Enum::Variant
            var il_bind_ns: i64 = 0
            var il_bind_ne: i64 = 0
            var il_has_binding: i64 = 0
            // Some(v)
            if pat_tk == 57 {
                EP = EP + 1; il_disc = 1; il_is_tagged = 1
                if TK[EP as usize] == 6 {
                    EP = EP + 1
                    il_bind_ns = TS[EP as usize]; il_bind_ne = TE[EP as usize]
                    il_has_binding = 1; EP = EP + 1
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                }
            }
            // None
            if pat_tk == 58 { EP = EP + 1; il_disc = 0; il_is_tagged = 1 }
            // Ok(v)
            if pat_tk == 59 {
                EP = EP + 1; il_disc = 0; il_is_tagged = 1
                if TK[EP as usize] == 6 {
                    EP = EP + 1
                    il_bind_ns = TS[EP as usize]; il_bind_ne = TE[EP as usize]
                    il_has_binding = 1; EP = EP + 1
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                }
            }
            // Err(e)
            if pat_tk == 60 {
                EP = EP + 1; il_disc = 1; il_is_tagged = 1
                if TK[EP as usize] == 6 {
                    EP = EP + 1
                    il_bind_ns = TS[EP as usize]; il_bind_ne = TE[EP as usize]
                    il_has_binding = 1; EP = EP + 1
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                }
            }
            // Identifier: wildcard _ or Enum::Variant [( v )]
            if pat_tk == 3 {
                let pns = TS[EP as usize]
                let pne = TE[EP as usize]
                // wildcard _
                if pne - pns == 1 && sb(pns) == 95 {
                    il_is_wildcard = 1; EP = EP + 1
                } else if TK[(EP + 1) as usize] == 51 {
                    // Enum::Variant form
                    let eh = gl_name_hash(pns, pne)
                    EP = EP + 2
                    let vh = gl_name_hash(TS[EP as usize], TE[EP as usize])
                    EP = EP + 1
                    il_disc = en_variant_value(eh, vh)
                    il_is_enum_variant = 1
                    // optional ( binding )
                    if TK[EP as usize] == 6 {
                        EP = EP + 1
                        il_bind_ns = TS[EP as usize]; il_bind_ne = TE[EP as usize]
                        il_has_binding = 1; EP = EP + 1
                        if TK[EP as usize] == 7 { EP = EP + 1 }
                    }
                } else {
                    // bare ident pattern: treat as wildcard (always matches, binds name)
                    il_is_wildcard = 1; EP = EP + 1
                }
            }
            // Skip '='
            if TK[EP as usize] == 16 { EP = EP + 1 }
            // Compile scrutinee
            compile_or()
            // Record scrutinee type for binding propagation
            MATCH_SCRUT_TY   = EXPR_TY
            MATCH_SCRUT_HASH = EXPR_TY_HASH
            // Allocate slot for scrutinee
            let il_slot = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var(il_slot)
            // Emit branch: for wildcard always-true (no comparison needed)
            var il_je_off: i64 = 0
            if il_is_wildcard == 1 {
                // Always matches — no comparison, no jump
                il_je_off = 0
            } else if il_is_tagged == 1 || il_is_enum_variant == 1 {
                // Load tag word and compare to discriminant
                emit_load_var(il_slot)
                em(0x48); em(0x8b); em(0x00)   // mov rax, [rax]   — load tag
                em(0x50)                        // push rax
                em(0x48); em(0xb8); em64(il_disc) // mov rax, disc
                em(0x59)                        // pop rcx
                em(0x48); em(0x39); em(0xc1)   // cmp rcx, rax
                em(0x0f); em(0x85)              // jne fail
                il_je_off = CL; em32(0)
                // Bind inner value if pattern specifies one
                if il_has_binding == 1 {
                    emit_load_var(il_slot)
                    em(0x48); em(0x8b); em(0x40); em(0x08) // mov rax, [rax+8]
                    let bslot = var_add(il_bind_ns, il_bind_ne)
                    if bslot >= 0 {
                        emit_store_var(bslot)
                        if bslot >= 0 && VAR_COUNT > 0 {
                            let bvi = VAR_COUNT - 1
                            if type_is_option_inline(MATCH_SCRUT_TY, MATCH_SCRUT_HASH) && option_hash_is(MATCH_SCRUT_HASH) {
                                VAR_TY[bvi as usize] = option_hash_inner_ty(MATCH_SCRUT_HASH)
                                VAR_TY_HASH[bvi as usize] = option_hash_inner_hash(MATCH_SCRUT_HASH)
                            }
                        }
                    }
                }
            } else {
                // Numeric/bool: compare scrutinee to disc if disc is valid
                if il_disc >= 0 {
                    emit_load_var(il_slot)
                    em(0x50)
                    em(0x48); em(0xb8); em64(il_disc)
                    em(0x59)
                    em(0x48); em(0x39); em(0xc1)
                    em(0x0f); em(0x85)
                    il_je_off = CL; em32(0)
                }
            }
            // Snapshot VAR_USED + VAR_MOVED for linear tracking
            var il_snap: i64 = 0
            while il_snap < VAR_COUNT {
                CL_SAVE_USED[il_snap as usize] = VAR_USED[il_snap as usize]
                CL_SAVE_MUT[il_snap as usize] = VAR_MOVED[il_snap as usize]
                il_snap = il_snap + 1
            }
            // Compile then-body
            LAST_STMT_HAS_VALUE = 0; LAST_STMT_TY = 0; LAST_STMT_TY_HASH = 0
            if TK[EP as usize] == 8 { EP = EP + 1 }
            while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
            let il_then_has_value = LAST_STMT_HAS_VALUE
            let il_then_ty = LAST_STMT_TY
            let il_then_hash = LAST_STMT_TY_HASH
            if TK[EP as usize] == 9 { EP = EP + 1 }
            // Handle else
            LAST_STMT_HAS_VALUE = 0; LAST_STMT_TY = 0; LAST_STMT_TY_HASH = 0
            if TK[EP as usize] == 14 {
                EP = EP + 1
                em(0xe9)
                let il_jmp_off = CL; em32(0)
                if il_je_off > 0 { patch32(il_je_off, CL) }
                var il_lthen: i64 = 0
                while il_lthen < VAR_COUNT {
                    let tused = VAR_USED[il_lthen as usize]; let tmov = VAR_MOVED[il_lthen as usize]
                    VAR_USED[il_lthen as usize] = CL_SAVE_USED[il_lthen as usize]
                    VAR_MOVED[il_lthen as usize] = CL_SAVE_MUT[il_lthen as usize]
                    CL_SAVE_USED[il_lthen as usize] = tused; CL_SAVE_MUT[il_lthen as usize] = tmov
                    il_lthen = il_lthen + 1
                }
                if TK[EP as usize] == 13 { compile_stmt() }
                else {
                    LAST_STMT_HAS_VALUE = 0; LAST_STMT_TY = 0; LAST_STMT_TY_HASH = 0
                    if TK[EP as usize] == 8 { EP = EP + 1 }
                    while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
                    if TK[EP as usize] == 9 { EP = EP + 1 }
                }
                let il_else_has_value = LAST_STMT_HAS_VALUE
                let il_else_ty = LAST_STMT_TY
                let il_else_hash = LAST_STMT_TY_HASH
                patch32(il_jmp_off, CL)
                if il_then_has_value == 1 && il_else_has_value == 1 && il_then_ty != 5 && il_else_ty != 5 {
                    LAST_STMT_HAS_VALUE = 1; LAST_STMT_TY = il_then_ty; LAST_STMT_TY_HASH = il_then_hash
                    EXPR_TY = il_then_ty; EXPR_TY_HASH = il_then_hash
                }
            } else {
                if il_je_off > 0 { patch32(il_je_off, CL) }
                LAST_STMT_HAS_VALUE = 0; LAST_STMT_TY = 0; LAST_STMT_TY_HASH = 0
            }
            return
        }
        // ── end if let ──

        compile_or()
        // β⁹ GTT week-6 stage-2: capture cond's channel-set topology
        // before compile_stmt in the body overwrites EXPR_CH_SET.
        let if_cond_ch_set = EXPR_CH_SET
        if EXPR_TY != 0 && EXPR_TY != 4 { tc_error_hard(EP - 1, "if condition must be bool") }
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x0f); em(0x84)
        let je_off = CL; em32(0)
        LAST_STMT_HAS_VALUE = 0
        LAST_STMT_TY = 0
        LAST_STMT_TY_HASH = 0
        // Snapshot VAR_USED + VAR_MOVED for linear branch tracking
        var lsnap: i64 = 0
        while lsnap < VAR_COUNT {
            CL_SAVE_USED[lsnap as usize] = VAR_USED[lsnap as usize]
            CL_SAVE_MUT[lsnap as usize] = VAR_MOVED[lsnap as usize]
            lsnap = lsnap + 1
        }
        if TK[EP as usize] == 8 { EP = EP + 1 }
        while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
        // β⁹ GTT week-6 stage-2: capture then-body's tail channel-set topology.
        let if_then_ch_set = EXPR_CH_SET
        let then_has_value = LAST_STMT_HAS_VALUE
        let then_ty = LAST_STMT_TY
        let then_hash = LAST_STMT_TY_HASH
        if TK[EP as usize] == 9 { EP = EP + 1 }
        LAST_STMT_HAS_VALUE = 0
        LAST_STMT_TY = 0
        LAST_STMT_TY_HASH = 0
        if TK[EP as usize] == 14 {
            EP = EP + 1
            em(0xe9)
            let jmp_off = CL; em32(0)
            patch32(je_off, CL)
            // Save then-branch state, restore pre-branch snapshot for else
            var lthen: i64 = 0
            while lthen < VAR_COUNT {
                let then_used = VAR_USED[lthen as usize]
                let then_moved = VAR_MOVED[lthen as usize]
                VAR_USED[lthen as usize] = CL_SAVE_USED[lthen as usize]
                VAR_MOVED[lthen as usize] = CL_SAVE_MUT[lthen as usize]
                CL_SAVE_USED[lthen as usize] = then_used
                CL_SAVE_MUT[lthen as usize] = then_moved
                lthen = lthen + 1
            }
            // else if: recurse into compile_stmt which handles 'if'
            if TK[EP as usize] == 13 {
                compile_stmt()
            } else {
                LAST_STMT_HAS_VALUE = 0
                LAST_STMT_TY = 0
                LAST_STMT_TY_HASH = 0
                if TK[EP as usize] == 8 { EP = EP + 1 }
                while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
                if TK[EP as usize] == 9 { EP = EP + 1 }
            }
            // β⁹ GTT week-6 stage-2: capture else-body's tail channel-set topology.
            // Nested else-if (compile_stmt recursion) already propagates union
            // per this same rule, so EXPR_CH_SET is the full union from the
            // recursive call.
            let if_else_ch_set = EXPR_CH_SET
            // Linear branch asymmetry check: compare then vs else VAR_USED
            var lchk: i64 = 0
            while lchk < VAR_COUNT {
                if VAR_LINEAR[lchk as usize] == 1 {
                    let then_u = CL_SAVE_USED[lchk as usize]
                    let else_u = VAR_USED[lchk as usize]
                    if then_u > 0 && else_u == 0 {
                        tc_linear_violation(if_tok, "linear value consumed in then-branch but not else-branch")
                    }
                    if then_u == 0 && else_u > 0 {
                        tc_linear_violation(if_tok, "linear value consumed in else-branch but not then-branch")
                    }
                    // Merge: take the max so the function-end check sees "consumed"
                    if then_u > else_u { VAR_USED[lchk as usize] = then_u }
                }
                // Merge VAR_MOVED: only for linear/affine structs
                if VAR_LINEAR[lchk as usize] == 1 || VAR_AFFINE[lchk as usize] == 1 {
                    if CL_SAVE_MUT[lchk as usize] == 1 || VAR_MOVED[lchk as usize] == 1 {
                        VAR_MOVED[lchk as usize] = 1
                    }
                }
                lchk = lchk + 1
            }
            let else_has_value = LAST_STMT_HAS_VALUE
            let else_ty = LAST_STMT_TY
            let else_hash = LAST_STMT_TY_HASH
            patch32(jmp_off, CL)
            if then_has_value == 1 && else_has_value == 1 && then_ty != 5 && else_ty != 5 {
                if ty_eq(then_ty, then_hash, else_ty, else_hash) == false {
                    tc_error_hard(EP - 1, "if arm type does not match else arm")
                }
                LAST_STMT_HAS_VALUE = 1
                LAST_STMT_TY = then_ty
                LAST_STMT_TY_HASH = then_hash
                EXPR_TY = then_ty
                EXPR_TY_HASH = then_hash
                if then_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                // β⁹ GTT week-6 stage-2: union all three arm topologies into
                // the if-expression's EXPR_CH_SET.  Matches `Typing.tIf`'s
                // conclusion `Sc ∪ (S1 ∪ S2)` in formal/GradientTopology.lean §3.
                EXPR_CH_SET = if_cond_ch_set | if_then_ch_set | if_else_ch_set
            } else {
                LAST_STMT_HAS_VALUE = 0
                LAST_STMT_TY = 0
                LAST_STMT_TY_HASH = 0
            }
        } else {
            // No else branch: if any linear var consumed in then-branch, error
            var lne: i64 = 0
            while lne < VAR_COUNT {
                if VAR_LINEAR[lne as usize] == 1 {
                    if VAR_USED[lne as usize] > 0 && CL_SAVE_USED[lne as usize] == 0 {
                        tc_linear_violation(if_tok, "linear value consumed in if-branch with no else — not consumed on all paths")
                    }
                }
                lne = lne + 1
            }
            patch32(je_off, CL)
            // FALL-THROUGH FIX: an if WITHOUT else can fall through, but if its then-branch
            // ended in `return` the last emitted byte is 0xc3 (ret). The implicit-return
            // epilogue guard (CD[CL-1] != 0xc3 at the fn/closure body end) would then wrongly
            // conclude "all paths return" and skip the fall-through epilogue, leaving the
            // if-false je pointing one byte past the ret = the next function's prologue
            // (entered by je, not call -> its ret pops uninitialised stack -> rip=0/-1 smash).
            // Emit a nop at the merge point so CD[CL-1] != 0xc3 and the epilogue is emitted.
            em(0x90)
            LAST_STMT_HAS_VALUE = 0
            LAST_STMT_TY = 0
            LAST_STMT_TY_HASH = 0
        }
        return
    }

    // while expr { stmts }
    if k == 15 {
        EP = EP + 1
        // ── Phase 1.5: while let <pattern> = <expr> { ... } ──
        if TK[EP as usize] == 11 {
            EP = EP + 1  // skip 'let'
            // Parse pattern (same as if-let)
            let wl_pat_tk = TK[EP as usize]
            var wl_disc: i64 = -1
            var wl_is_tagged: i64 = 0
            var wl_is_wildcard: i64 = 0
            var wl_is_enum_variant: i64 = 0
            var wl_bind_ns: i64 = 0
            var wl_bind_ne: i64 = 0
            var wl_has_binding: i64 = 0
            // Some(v)
            if wl_pat_tk == 57 {
                EP = EP + 1; wl_disc = 1; wl_is_tagged = 1
                if TK[EP as usize] == 6 {
                    EP = EP + 1
                    wl_bind_ns = TS[EP as usize]; wl_bind_ne = TE[EP as usize]
                    wl_has_binding = 1; EP = EP + 1
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                }
            }
            // None
            if wl_pat_tk == 58 { EP = EP + 1; wl_disc = 0; wl_is_tagged = 1 }
            // Ok(v)
            if wl_pat_tk == 59 {
                EP = EP + 1; wl_disc = 0; wl_is_tagged = 1
                if TK[EP as usize] == 6 {
                    EP = EP + 1
                    wl_bind_ns = TS[EP as usize]; wl_bind_ne = TE[EP as usize]
                    wl_has_binding = 1; EP = EP + 1
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                }
            }
            // Err(e)
            if wl_pat_tk == 60 {
                EP = EP + 1; wl_disc = 1; wl_is_tagged = 1
                if TK[EP as usize] == 6 {
                    EP = EP + 1
                    wl_bind_ns = TS[EP as usize]; wl_bind_ne = TE[EP as usize]
                    wl_has_binding = 1; EP = EP + 1
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                }
            }
            // Identifier: wildcard _ or Enum::Variant [( v )]
            if wl_pat_tk == 3 {
                let wl_pns = TS[EP as usize]
                let wl_pne = TE[EP as usize]
                if wl_pne - wl_pns == 1 && sb(wl_pns) == 95 {
                    wl_is_wildcard = 1; EP = EP + 1
                } else if TK[(EP + 1) as usize] == 51 {
                    let wl_eh = gl_name_hash(wl_pns, wl_pne)
                    EP = EP + 2
                    let wl_vh = gl_name_hash(TS[EP as usize], TE[EP as usize])
                    EP = EP + 1
                    wl_disc = en_variant_value(wl_eh, wl_vh)
                    wl_is_enum_variant = 1
                    if TK[EP as usize] == 6 {
                        EP = EP + 1
                        wl_bind_ns = TS[EP as usize]; wl_bind_ne = TE[EP as usize]
                        wl_has_binding = 1; EP = EP + 1
                        if TK[EP as usize] == 7 { EP = EP + 1 }
                    }
                } else {
                    wl_is_wildcard = 1; EP = EP + 1
                }
            }
            // Skip '='
            if TK[EP as usize] == 16 { EP = EP + 1 }
            // Pre-allocate scrutinee slot BEFORE loop top so slot is stable
            let wl_slot = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            // Loop top: loop back here each iteration
            let wl_loop_top = CL
            LOOP_TOP[LOOP_DEPTH as usize] = wl_loop_top
            LOOP_DEPTH = LOOP_DEPTH + 1
            let wl_saved_bc = BREAK_COUNT
            // Evaluate scrutinee expression
            compile_or()
            MATCH_SCRUT_TY   = EXPR_TY
            MATCH_SCRUT_HASH = EXPR_TY_HASH
            // Store scrutinee into pre-allocated slot
            emit_store_var(wl_slot)
            // Emit pattern test; on failure jump to wl_exit (patched below)
            var wl_je_off: i64 = 0
            if wl_is_wildcard == 1 {
                // Always matches — loop forever (until break)
                wl_je_off = 0
            } else if wl_is_tagged == 1 || wl_is_enum_variant == 1 {
                emit_load_var(wl_slot)
                em(0x48); em(0x8b); em(0x00)        // mov rax, [rax]   — load tag
                em(0x50)                             // push rax
                em(0x48); em(0xb8); em64(wl_disc)   // mov rax, disc
                em(0x59)                             // pop rcx
                em(0x48); em(0x39); em(0xc1)        // cmp rcx, rax
                em(0x0f); em(0x85)                  // jne exit
                wl_je_off = CL; em32(0)
                // Bind inner value if pattern specifies one
                if wl_has_binding == 1 {
                    emit_load_var(wl_slot)
                    em(0x48); em(0x8b); em(0x40); em(0x08)  // mov rax, [rax+8]
                    let wl_bslot = var_add(wl_bind_ns, wl_bind_ne)
                    if wl_bslot >= 0 {
                        emit_store_var(wl_bslot)
                        if wl_bslot >= 0 && VAR_COUNT > 0 {
                            let wl_bvi = VAR_COUNT - 1
                            if type_is_option_inline(MATCH_SCRUT_TY, MATCH_SCRUT_HASH) && option_hash_is(MATCH_SCRUT_HASH) {
                                VAR_TY[wl_bvi as usize] = option_hash_inner_ty(MATCH_SCRUT_HASH)
                                VAR_TY_HASH[wl_bvi as usize] = option_hash_inner_hash(MATCH_SCRUT_HASH)
                            }
                        }
                    }
                }
            } else {
                if wl_disc >= 0 {
                    emit_load_var(wl_slot)
                    em(0x50)
                    em(0x48); em(0xb8); em64(wl_disc)
                    em(0x59)
                    em(0x48); em(0x39); em(0xc1)
                    em(0x0f); em(0x85)
                    wl_je_off = CL; em32(0)
                }
            }
            // Compile body
            if TK[EP as usize] == 8 { EP = EP + 1 }
            while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
            if TK[EP as usize] == 9 { EP = EP + 1 }
            // Jump back to loop top
            em(0xe9)
            em32(wl_loop_top - (CL + 4))
            // Patch exit: pattern-fail jump lands here
            if wl_je_off > 0 { patch32(wl_je_off, CL) }
            // Patch break jumps
            var wl_bi: i64 = wl_saved_bc
            while wl_bi < BREAK_COUNT { patch32(BREAK_PATCH[wl_bi as usize], CL); wl_bi = wl_bi + 1 }
            BREAK_COUNT = wl_saved_bc
            LOOP_DEPTH = LOOP_DEPTH - 1
            LAST_STMT_HAS_VALUE = 0; LAST_STMT_TY = 0; LAST_STMT_TY_HASH = 0
            return
        }
        // ── end while let ──
        let loop_top = CL
        LOOP_TOP[LOOP_DEPTH as usize] = loop_top
        LOOP_DEPTH = LOOP_DEPTH + 1
        let saved_bc = BREAK_COUNT
        // β⁹ GTT loop fixed-point: snapshot VAR_CH_SET before the loop runs
        gtt_loop_snapshot()
        compile_or()
        if EXPR_TY != 0 && EXPR_TY != 4 { tc_error_hard(EP - 1, "while condition must be bool") }
        em(0x48); em(0x85); em(0xc0)
        em(0x0f); em(0x84)
        let je_off = CL; em32(0)
        if TK[EP as usize] == 8 { EP = EP + 1 }
        while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
        if TK[EP as usize] == 9 { EP = EP + 1 }
        em(0xe9)
        em32(loop_top - (CL + 4))
        // β⁹ GTT loop fixed-point: union post-body topology with pre-loop snapshot
        gtt_loop_union()
        patch32(je_off, CL)
        // Patch all break jumps from this loop to point here
        var bi: i64 = saved_bc
        while bi < BREAK_COUNT { patch32(BREAK_PATCH[bi as usize], CL); bi = bi + 1 }
        BREAK_COUNT = saved_bc
        LOOP_DEPTH = LOOP_DEPTH - 1
        return
    }

    // for IDENT in range(START, END) { body }
    // for IDENT in START..END { body }
    // for IDENT in START..=END { body }   (inclusive)
    // Desugars to: var IDENT = START; while IDENT < END { body; IDENT = IDENT + 1 }
    if k == 54 {
        EP = EP + 1  // skip 'for'
        let vns = TS[EP as usize]
        let vne = TE[EP as usize]
        EP = EP + 1  // skip loop var name
        EP = EP + 1  // skip 'in'
        // Save slot base: both branches allocate iter at saved_next, end at saved_next+1
        let saved_next = NEXT_SLOT
        // Detect form: identifier followed by ( means range(START, END)
        if TK[EP as usize] == 3 && TK[(EP + 1) as usize] == 6 && src_match(TS[EP as usize], TE[EP as usize] - TS[EP as usize], "range") {
            // range(START, END) form
            EP = EP + 1  // skip 'range'
            EP = EP + 1  // skip (
            compile_or()  // START in rax
            if EXPR_TY != 0 && EXPR_TY != 1 { tc_error_hard(EP - 1, "for range start must be integer") }
            let iter_slot_a = var_add(vns, vne)
            if iter_slot_a < 0 { return }
            VAR_TY[(VAR_COUNT - 1) as usize] = 1
            VAR_TY_HASH[(VAR_COUNT - 1) as usize] = 0
            emit_store_var(iter_slot_a)
            if TK[EP as usize] == 28 { EP = EP + 1 }  // skip comma
            compile_or()  // END in rax
            if EXPR_TY != 0 && EXPR_TY != 1 { tc_error_hard(EP - 1, "for range end must be integer") }
            let end_slot_a = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var(end_slot_a)
            if TK[EP as usize] == 7 { EP = EP + 1 }  // skip )
        } else {
            // START..END or START..=END form, OR array/vec iteration
            compile_or()  // evaluate 'in' expression
            // for x in arr { body } — array iteration
            if EXPR_TY == 8 {
                let farr_hash = EXPR_TY_HASH
                let farr_alen = arr_hash_alen(farr_hash)
                let farr_esiz = arr_hash_esiz(farr_hash)
                let farr_elem_ty = arr_hash_elem_ty(farr_hash)
                let farr_elem_hash = arr_hash_elem_hash(farr_hash)
                // Save array pointer (rax) in a hidden slot
                let farr_ptr = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var(farr_ptr)
                // Bind loop variable to each element
                let farr_x = var_add(vns, vne)
                if farr_x < 0 { return }
                let farr_x_vi = VAR_COUNT - 1
                VAR_TY[farr_x_vi as usize] = farr_elem_ty
                VAR_TY_HASH[farr_x_vi as usize] = farr_elem_hash
                if farr_elem_ty == 2 { VAR_IS_F64[farr_x_vi as usize] = 1 }
                // Hidden index = 0
                let farr_idx = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                em(0x31); em(0xc0)  // xor rax, rax
                emit_store_var(farr_idx)
                // Hidden end = alen
                let farr_end = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                emit_imm64(farr_alen)
                emit_store_var(farr_end)
                gtt_loop_snapshot()
                em(0xe9); let farr_jcond = CL; em32(0)  // jmp cond
                let farr_incr = CL
                LOOP_TOP[LOOP_DEPTH as usize] = farr_incr
                LOOP_DEPTH = LOOP_DEPTH + 1
                let farr_sbc = BREAK_COUNT
                // incr: idx++
                emit_load_var(farr_idx)
                em(0x48); em(0x83); em(0xc0); em(1)  // add rax, 1
                emit_store_var(farr_idx)
                // cond: idx < end
                let farr_cond = CL
                patch32(farr_jcond, farr_cond)
                emit_load_var(farr_idx); em(0x50)      // push idx
                emit_load_var(farr_end); em(0x59)      // pop rcx = idx
                em(0x48); em(0x39); em(0xc1)           // cmp rcx, rax
                em(0x0f); em(0x9c); em(0xc0)           // setl al
                em(0x48); em(0x0f); em(0xb6); em(0xc0) // movzx rax, al
                em(0x48); em(0x85); em(0xc0)           // test rax, rax
                em(0x0f); em(0x84); let farr_je = CL; em32(0)
                // Load x = arr[idx]
                emit_load_var(farr_idx)
                em(0x48); em(0x89); em(0xc1)           // mov rcx, rax
                emit_load_var(farr_ptr)                // rax = ptr
                if farr_esiz == 8 {
                    em(0x48); em(0x8b); em(0x04); em(0xc8)  // mov rax, [rax+rcx*8]
                } else {
                    em(0x48); em(0x0f); em(0xbe); em(0x04); em(0x08)  // movsx rax, [rax+rcx]
                }
                emit_store_var(farr_x)
                if TK[EP as usize] == 8 { EP = EP + 1 }
                while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
                if TK[EP as usize] == 9 { EP = EP + 1 }
                em(0xe9); em32(farr_incr - (CL + 4))
                gtt_loop_union()
                patch32(farr_je, CL)
                var farr_bi: i64 = farr_sbc
                while farr_bi < BREAK_COUNT { patch32(BREAK_PATCH[farr_bi as usize], CL); farr_bi = farr_bi + 1 }
                BREAK_COUNT = farr_sbc
                LOOP_DEPTH = LOOP_DEPTH - 1
                LAST_STMT_HAS_VALUE = 0; LAST_STMT_TY = 0; LAST_STMT_TY_HASH = 0
                return
            }
            // for x in vec { body } — struct iteration (requires .data: [T;N] and .len: i64)
            // after compile_or(), rax = pointer to struct data (ptr_slot contents)
            if type_is_struct_like(EXPR_TY, EXPR_TY_HASH) {
                let fvec_si = st_find(EXPR_TY_HASH)
                if fvec_si >= 0 {
                    let fvec_hash_len  = 69632449292                   // "len"
                    let fvec_hash_data = 20811276965                   // "data"
                    let fvec_len_off   = st_field_offset(fvec_si, fvec_hash_len)
                    let fvec_data_off  = st_field_offset(fvec_si, fvec_hash_data)
                    let fvec_data_fty  = st_field_ty(fvec_si, fvec_hash_data)
                    let fvec_data_fhash = st_field_hash(fvec_si, fvec_hash_data)
                    if fvec_len_off >= 0 && fvec_data_off >= 0 && fvec_data_fty == 8 {
                        let fvec_esiz      = arr_hash_esiz(fvec_data_fhash)
                        let fvec_elem_ty   = arr_hash_elem_ty(fvec_data_fhash)
                        let fvec_elem_hash = arr_hash_elem_hash(fvec_data_fhash)
                        // Save struct pointer in a hidden slot
                        let fvec_ptr = NEXT_SLOT
                        NEXT_SLOT = NEXT_SLOT + 1
                        emit_store_var(fvec_ptr)
                        // Bind loop variable
                        let fvec_x = var_add(vns, vne)
                        if fvec_x < 0 { return }
                        let fvec_x_vi = VAR_COUNT - 1
                        VAR_TY[fvec_x_vi as usize]      = fvec_elem_ty
                        VAR_TY_HASH[fvec_x_vi as usize] = fvec_elem_hash
                        if fvec_elem_ty == 2 { VAR_IS_F64[fvec_x_vi as usize] = 1 }
                        // Hidden index slot = 0
                        let fvec_idx = NEXT_SLOT
                        NEXT_SLOT = NEXT_SLOT + 1
                        em(0x31); em(0xc0)  // xor eax, eax
                        emit_store_var(fvec_idx)
                        // Hidden end slot = struct.len (runtime load from [ptr + len_off])
                        let fvec_end = NEXT_SLOT
                        NEXT_SLOT = NEXT_SLOT + 1
                        emit_load_var(fvec_ptr)
                        // mov rax, [rax + fvec_len_off]
                        em(0x48); em(0x8b); em(0x80); em32(fvec_len_off)
                        emit_store_var(fvec_end)
                        gtt_loop_snapshot()
                        em(0xe9); let fvec_jcond = CL; em32(0)
                        let fvec_incr = CL
                        LOOP_TOP[LOOP_DEPTH as usize] = fvec_incr
                        LOOP_DEPTH = LOOP_DEPTH + 1
                        let fvec_sbc = BREAK_COUNT
                        // incr: idx++
                        emit_load_var(fvec_idx)
                        em(0x48); em(0x83); em(0xc0); em(1)  // add rax, 1
                        emit_store_var(fvec_idx)
                        // cond: idx < end
                        let fvec_cond = CL
                        patch32(fvec_jcond, fvec_cond)
                        emit_load_var(fvec_idx); em(0x50)       // push idx
                        emit_load_var(fvec_end); em(0x59)       // pop rcx = end
                        em(0x48); em(0x39); em(0xc1)            // cmp rcx, rax
                        em(0x0f); em(0x9c); em(0xc0)            // setl al
                        em(0x48); em(0x0f); em(0xb6); em(0xc0)  // movzx rax, al
                        em(0x48); em(0x85); em(0xc0)            // test rax, rax
                        em(0x0f); em(0x84); let fvec_je = CL; em32(0)
                        // Load x = ptr->data[idx]
                        emit_load_var(fvec_idx)
                        em(0x48); em(0x89); em(0xc1)            // mov rcx, rax (idx)
                        emit_load_var(fvec_ptr)                 // rax = struct ptr
                        // advance rax to data base pointer (rax += data_off)
                        if fvec_data_off > 0 {
                            em(0x48); em(0x81); em(0xc0); em32(fvec_data_off)  // add rax, imm32
                        }
                        // rax = data_ptr, rcx = idx
                        if fvec_esiz == 8 {
                            em(0x48); em(0x8b); em(0x04); em(0xc8)  // mov rax, [rax+rcx*8]
                        } else {
                            em(0x48); em(0x0f); em(0xbe); em(0x04); em(0x08)  // movsx rax, [rax+rcx]
                        }
                        emit_store_var(fvec_x)
                        if TK[EP as usize] == 8 { EP = EP + 1 }
                        while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
                        if TK[EP as usize] == 9 { EP = EP + 1 }
                        em(0xe9); em32(fvec_incr - (CL + 4))
                        gtt_loop_union()
                        patch32(fvec_je, CL)
                        var fvec_bi: i64 = fvec_sbc
                        while fvec_bi < BREAK_COUNT { patch32(BREAK_PATCH[fvec_bi as usize], CL); fvec_bi = fvec_bi + 1 }
                        BREAK_COUNT = fvec_sbc
                        LOOP_DEPTH = LOOP_DEPTH - 1
                        LAST_STMT_HAS_VALUE = 0; LAST_STMT_TY = 0; LAST_STMT_TY_HASH = 0
                        return
                    }
                }
            }
            if EXPR_TY != 0 && EXPR_TY != 1 { tc_error_hard(EP - 1, "for range start must be integer") }
            let iter_slot_r = var_add(vns, vne)
            if iter_slot_r < 0 { return }
            VAR_TY[(VAR_COUNT - 1) as usize] = 1
            VAR_TY_HASH[(VAR_COUNT - 1) as usize] = 0
            emit_store_var(iter_slot_r)
            var is_inclusive: i64 = 0
            if TK[EP as usize] == 64 { is_inclusive = 1 }
            if TK[EP as usize] == 63 || TK[EP as usize] == 64 { EP = EP + 1 }
            compile_or()  // END in rax
            if EXPR_TY != 0 && EXPR_TY != 1 { tc_error_hard(EP - 1, "for range end must be integer") }
            if is_inclusive != 0 {
                em(0x48); em(0x83); em(0xc0); em(1)  // add rax, 1
            }
            let end_slot_r = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var(end_slot_r)
        }
        // Both branches allocate: iter at saved_next, end at saved_next+1
        let iter_slot = saved_next
        let end_slot = saved_next + 1
        // β⁹ GTT loop fixed-point: snapshot VAR_CH_SET before the loop runs
        gtt_loop_snapshot()
        // For-loop structure: jmp cond; incr: iter++; cond: cmp; jge end; body; jmp incr; end:
        // This ensures 'continue' jumps to incr (not cond), so iter always increments.
        em(0xe9)
        let jmp_cond_off = CL; em32(0)  // jmp cond (patched below)
        // incr: — continue target
        let incr_addr = CL
        LOOP_TOP[LOOP_DEPTH as usize] = incr_addr
        LOOP_DEPTH = LOOP_DEPTH + 1
        let saved_bc = BREAK_COUNT
        emit_load_var(iter_slot)
        em(0x48); em(0x83); em(0xc0); em(1)  // add rax, 1
        emit_store_var(iter_slot)
        // cond:
        let cond_addr = CL
        patch32(jmp_cond_off, cond_addr)
        emit_load_var(iter_slot)
        em(0x50)  // push iter
        emit_load_var(end_slot)
        em(0x59)  // pop rcx (iter)
        em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
        em(0x0f); em(0x9c); em(0xc0)  // setl al
        em(0x48); em(0x0f); em(0xb6); em(0xc0)  // movzx rax, al
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x0f); em(0x84)
        let je_off = CL; em32(0)  // jz end
        if TK[EP as usize] == 8 { EP = EP + 1 }  // skip {
        while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
        if TK[EP as usize] == 9 { EP = EP + 1 }  // skip }
        // jmp incr
        em(0xe9)
        em32(incr_addr - (CL + 4))
        // end:
        // β⁹ GTT loop fixed-point: union post-body topology with pre-loop snapshot
        gtt_loop_union()
        patch32(je_off, CL)
        var bi: i64 = saved_bc
        while bi < BREAK_COUNT { patch32(BREAK_PATCH[bi as usize], CL); bi = bi + 1 }
        BREAK_COUNT = saved_bc
        LOOP_DEPTH = LOOP_DEPTH - 1
        return
    }

    // match expr { pattern => body, ... }
    // 48 = match keyword
    if k == 48 {
        EP = EP + 1
        compile_or()  // scrutinee in rax
        // β⁹ GTT week-7: capture scrutinee channel topology before any arm body
        // compilation can overwrite EXPR_CH_SET.  Mirror of week-6 `if_cond_ch_set`.
        let match_scrut_ch_set = EXPR_CH_SET
        let match_scrut_ty = EXPR_TY
        let match_scrut_hash = EXPR_TY_HASH
        MATCH_SCRUT_TY = match_scrut_ty
        MATCH_SCRUT_HASH = match_scrut_hash
        // Observation boundary: pattern-matching on an Unobserved<T> collapses uncertainty
        if ty_is_unobserved(EXPR_TY) && (FN_EFFECTS[CURRENT_FN as usize] & 64) == 0 {
            tc_observe_boundary(EP - 1, "cannot pattern-match on Unobserved<T> — requires `with Observe`")
        }
        // Store scrutinee in a local var (not stack — return inside arm would break stack)
        let match_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        emit_store_var(match_slot)
        if TK[EP as usize] == 8 { EP = EP + 1 }  // skip {
        var arm_count: i64 = 0
        // Per-match jump-to-merge patch sites. MUST be local (not the global
        // MATCH_ENDS): a nested match inside an arm body re-enters this function and
        // would otherwise overwrite the outer match's slots, leaving the outer arm's
        // jmp as an unpatched e9 00000000 (falls through into the next arm's tag test
        // → garbage/crash). lean_single uses if-chains so never hit this, but the
        // modular check.sio has hundreds of nested matches.
        var match_ends: [i64; 256] = [0; 256]
        var match_ty: i64 = 0
        var match_hash: i64 = 0
        var match_have_ty: i64 = 0
        var match_all_value: i64 = 1
        var match_arms: i64 = 0
        // β⁹ GTT week-7: accumulate each arm's tail EXPR_CH_SET into this union.
        // At the both-arms-have-value exit, EXPR_CH_SET = scrut | arms_union
        // to match `Typing.tMatch` conclusion `Sc.union (chsetUnionFin Ss)`.
        var match_arms_ch_union: i64 = 0
        while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 {
            var is_wildcard: i64 = 0
            var is_var_bind: i64 = 0
            var disc: i64 = -1
            var arm_is_tagged: i64 = 0
            var bind_ns: i64 = 0
            var bind_ne: i64 = 0
            var has_binding: i64 = 0
            var is_tuple_pattern: i64 = 0
            var tpat_count: i64 = 0
            let arm_tk = TK[EP as usize]
            // Some(v) pattern — tag=1, bind inner value
            if arm_tk == 57 {
                EP = EP + 1
                disc = 1
                arm_is_tagged = 1
                if TK[EP as usize] == 6 {
                    EP = EP + 1
                    bind_ns = TS[EP as usize]
                    bind_ne = TE[EP as usize]
                    has_binding = 1
                    EP = EP + 1
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                }
            }
            // None pattern — tag=0
            if arm_tk == 58 {
                EP = EP + 1
                disc = 0
                arm_is_tagged = 1
            }
            // Ok(v) pattern — tag=0, bind payload
            if arm_tk == 59 {
                EP = EP + 1
                disc = 0
                arm_is_tagged = 1
                if TK[EP as usize] == 6 {
                    EP = EP + 1
                    bind_ns = TS[EP as usize]
                    bind_ne = TE[EP as usize]
                    has_binding = 1
                    EP = EP + 1
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                }
            }
            // Err(e) pattern — tag=1, bind payload
            if arm_tk == 60 {
                EP = EP + 1
                disc = 1
                arm_is_tagged = 1
                if TK[EP as usize] == 6 {
                    EP = EP + 1
                    bind_ns = TS[EP as usize]
                    bind_ne = TE[EP as usize]
                    has_binding = 1
                    EP = EP + 1
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                }
            }
            if arm_tk == 3 {
                let pns = TS[EP as usize]
                let pne = TE[EP as usize]
                if pne - pns == 1 && sb(pns) == 95 {
                    is_wildcard = 1; EP = EP + 1
                } else if TK[(EP + 1) as usize] == 51 {
                    let eh = gl_name_hash(pns, pne)
                    EP = EP + 2
                    let vh = gl_name_hash(TS[EP as usize], TE[EP as usize])
                    EP = EP + 1
                    disc = en_variant_value(eh, vh)
                } else {
                    // Variable binding pattern: `v =>` or `v if cond =>`
                    is_var_bind = 1; bind_ns = pns; bind_ne = pne; EP = EP + 1
                }
            }
            if arm_tk == 4 {
                disc = TV[EP as usize]; EP = EP + 1
            }
            // Tuple pattern: `( p0 , p1 , ... )` — parse each element sub-pattern into TPAT_*.
            if arm_tk == 6 {
                is_tuple_pattern = 1
                EP = EP + 1  // consume (
                while TK[EP as usize] != 7 && TK[EP as usize] != 0 && tpat_count < 8 {
                    if TK[EP as usize] == 28 { EP = EP + 1; continue }  // skip comma
                    var edisc: i64 = -1
                    var etagged: i64 = 0
                    var ehasbind: i64 = 0
                    var ebns: i64 = 0
                    var ebne: i64 = 0
                    var ewild: i64 = 0
                    let etk = TK[EP as usize]
                    if etk == 57 { EP = EP + 1; edisc = 1; etagged = 1; if TK[EP as usize] == 6 { EP = EP + 1; ebns = TS[EP as usize]; ebne = TE[EP as usize]; ehasbind = 1; EP = EP + 1; if TK[EP as usize] == 7 { EP = EP + 1 } } }
                    else if etk == 58 { EP = EP + 1; edisc = 0; etagged = 1 }
                    else if etk == 59 { EP = EP + 1; edisc = 0; etagged = 1; if TK[EP as usize] == 6 { EP = EP + 1; ebns = TS[EP as usize]; ebne = TE[EP as usize]; ehasbind = 1; EP = EP + 1; if TK[EP as usize] == 7 { EP = EP + 1 } } }
                    else if etk == 60 { EP = EP + 1; edisc = 1; etagged = 1; if TK[EP as usize] == 6 { EP = EP + 1; ebns = TS[EP as usize]; ebne = TE[EP as usize]; ehasbind = 1; EP = EP + 1; if TK[EP as usize] == 7 { EP = EP + 1 } } }
                    else if etk == 3 {
                        let ens = TS[EP as usize]; let ene = TE[EP as usize]
                        if ene - ens == 1 && sb(ens) == 95 { ewild = 1; EP = EP + 1 }
                        else if TK[(EP + 1) as usize] == 51 { let eeh = gl_name_hash(ens, ene); EP = EP + 2; let evh = gl_name_hash(TS[EP as usize], TE[EP as usize]); EP = EP + 1; edisc = en_variant_value(eeh, evh); etagged = 1 }
                        else { ewild = 1; EP = EP + 1 }
                    }
                    else { EP = EP + 1 }
                    TPAT_DISC[tpat_count as usize] = edisc
                    TPAT_TAGGED[tpat_count as usize] = etagged
                    TPAT_HAS_BIND[tpat_count as usize] = ehasbind
                    TPAT_BIND_NS[tpat_count as usize] = ebns
                    TPAT_BIND_NE[tpat_count as usize] = ebne
                    TPAT_IS_WILD[tpat_count as usize] = ewild
                    tpat_count = tpat_count + 1
                }
                if TK[EP as usize] == 7 { EP = EP + 1 }  // consume )
            }
            if arm_tk != 57 && arm_tk != 58 && arm_tk != 59 && arm_tk != 60 && arm_tk != 3 && arm_tk != 4 && arm_tk != 6 { EP = EP + 1 }
            // Phase 1.4: Or-pattern detection (A | B | C => body)
            var is_or_pattern: i64 = 0
            if is_var_bind == 0 && TK[EP as usize] == 45 {
                is_or_pattern = 1
                // Store first alternative
                OR_ALT_DISC[0 as usize] = disc
                OR_ALT_TAGGED[0 as usize] = arm_is_tagged
                OR_ALT_HAS_BIND[0 as usize] = has_binding
                OR_ALT_BIND_NS[0 as usize] = bind_ns
                OR_ALT_BIND_NE[0 as usize] = bind_ne
                OR_ALT_IS_WILD[0 as usize] = is_wildcard
                OR_ALT_COUNT = 1
                // Parse additional alternatives
                while TK[EP as usize] == 45 {
                    EP = EP + 1
                    let alt_i = OR_ALT_COUNT
                    var a_disc: i64 = -1
                    var a_tagged: i64 = 0
                    var a_has_bind: i64 = 0
                    var a_bind_ns: i64 = 0
                    var a_bind_ne: i64 = 0
                    var a_is_wild: i64 = 0
                    let a_tk = TK[EP as usize]
                    if a_tk == 57 { EP = EP + 1; a_disc = 1; a_tagged = 1; if TK[EP as usize] == 6 { EP = EP + 1; a_bind_ns = TS[EP as usize]; a_bind_ne = TE[EP as usize]; a_has_bind = 1; EP = EP + 1; if TK[EP as usize] == 7 { EP = EP + 1 } } }
                    if a_tk == 58 { EP = EP + 1; a_disc = 0; a_tagged = 1 }
                    if a_tk == 59 { EP = EP + 1; a_disc = 0; a_tagged = 1; if TK[EP as usize] == 6 { EP = EP + 1; a_bind_ns = TS[EP as usize]; a_bind_ne = TE[EP as usize]; a_has_bind = 1; EP = EP + 1; if TK[EP as usize] == 7 { EP = EP + 1 } } }
                    if a_tk == 60 { EP = EP + 1; a_disc = 1; a_tagged = 1; if TK[EP as usize] == 6 { EP = EP + 1; a_bind_ns = TS[EP as usize]; a_bind_ne = TE[EP as usize]; a_has_bind = 1; EP = EP + 1; if TK[EP as usize] == 7 { EP = EP + 1 } } }
                    if a_tk == 3 {
                        let ans = TS[EP as usize]; let ane = TE[EP as usize]
                        if ane - ans == 1 && sb(ans) == 95 { a_is_wild = 1; EP = EP + 1 }
                        else if TK[(EP + 1) as usize] == 51 { let aeh = gl_name_hash(ans, ane); EP = EP + 2; let avh = gl_name_hash(TS[EP as usize], TE[EP as usize]); EP = EP + 1; a_disc = en_variant_value(aeh, avh) }
                        else { EP = EP + 1 }
                    }
                    if a_tk == 4 { a_disc = TV[EP as usize]; EP = EP + 1 }
                    OR_ALT_DISC[alt_i as usize] = a_disc
                    OR_ALT_TAGGED[alt_i as usize] = a_tagged
                    OR_ALT_HAS_BIND[alt_i as usize] = a_has_bind
                    OR_ALT_BIND_NS[alt_i as usize] = a_bind_ns
                    OR_ALT_BIND_NE[alt_i as usize] = a_bind_ne
                    OR_ALT_IS_WILD[alt_i as usize] = a_is_wild
                    OR_ALT_COUNT = OR_ALT_COUNT + 1
                }
                // Emit check sequence: non-last alts → je body; last alt → jne skip
                var or_i: i64 = 0
                while or_i < OR_ALT_COUNT - 1 {
                    let oa_disc = OR_ALT_DISC[or_i as usize]
                    let oa_tagged = OR_ALT_TAGGED[or_i as usize]
                    let oa_is_wild = OR_ALT_IS_WILD[or_i as usize]
                    OR_BODY_PV[or_i as usize] = 0
                    if oa_is_wild == 1 {
                        em(0xe9); OR_BODY_PATCHES[or_i as usize] = CL; em32(0); OR_BODY_PV[or_i as usize] = 1
                    } else if oa_tagged == 1 {
                        emit_load_var(match_slot)
                        em(0x48); em(0x8b); em(0x00)
                        em(0x50); em(0x48); em(0xb8); em64(oa_disc); em(0x59)
                        em(0x48); em(0x39); em(0xc1)
                        em(0x0f); em(0x84); OR_BODY_PATCHES[or_i as usize] = CL; em32(0); OR_BODY_PV[or_i as usize] = 1
                    } else if oa_disc >= 0 {
                        emit_load_var(match_slot)
                        em(0x50); em(0x48); em(0xb8); em64(oa_disc); em(0x59)
                        em(0x48); em(0x39); em(0xc1)
                        em(0x0f); em(0x84); OR_BODY_PATCHES[or_i as usize] = CL; em32(0); OR_BODY_PV[or_i as usize] = 1
                    }
                    or_i = or_i + 1
                }
                // Last alternative: jne skip (if not wildcard)
                let or_last = OR_ALT_COUNT - 1
                let ol_disc = OR_ALT_DISC[or_last as usize]
                let ol_tagged = OR_ALT_TAGGED[or_last as usize]
                let ol_is_wild = OR_ALT_IS_WILD[or_last as usize]
                var or_skip_patch: i64 = -1
                if ol_is_wild == 0 && ol_tagged == 1 {
                    emit_load_var(match_slot)
                    em(0x48); em(0x8b); em(0x00)
                    em(0x50); em(0x48); em(0xb8); em64(ol_disc); em(0x59)
                    em(0x48); em(0x39); em(0xc1)
                    em(0x0f); em(0x85); or_skip_patch = CL; em32(0)
                } else if ol_is_wild == 0 && ol_disc >= 0 {
                    emit_load_var(match_slot)
                    em(0x50); em(0x48); em(0xb8); em64(ol_disc); em(0x59)
                    em(0x48); em(0x39); em(0xc1)
                    em(0x0f); em(0x85); or_skip_patch = CL; em32(0)
                }
                // Bind inner value from last alt (if it has a tagged binding)
                let ol_has_bind = OR_ALT_HAS_BIND[or_last as usize]
                let ol_bns = OR_ALT_BIND_NS[or_last as usize]
                let ol_bne = OR_ALT_BIND_NE[or_last as usize]
                if ol_has_bind == 1 && ol_tagged == 1 {
                    emit_load_var(match_slot)
                    em(0x48); em(0x8b); em(0x40); em(0x08)
                    let obslot = var_add(ol_bns, ol_bne)
                    if obslot >= 0 {
                        emit_store_var(obslot)
                        if VAR_COUNT > 0 {
                            let obvi = VAR_COUNT - 1
                            if type_is_option_inline(match_scrut_ty, match_scrut_hash) && option_hash_is(match_scrut_hash) {
                                VAR_TY[obvi as usize] = option_hash_inner_ty(match_scrut_hash)
                                VAR_TY_HASH[obvi as usize] = option_hash_inner_hash(match_scrut_hash)
                            }
                            // β⁹ GTT week-7 follow-up: OR-pattern inner-value bound
                            // var inherits scrutinee's channel topology (same rule
                            // as the single-alt tagged bind at :~16765).
                            VAR_CH_SET[obvi as usize] = match_scrut_ch_set
                        }
                    }
                }
                // Patch all non-last body-jump offsets to current location (arm body start)
                let or_body_start = CL
                var pi: i64 = 0
                while pi < OR_ALT_COUNT - 1 { if OR_BODY_PV[pi as usize] == 1 { patch32(OR_BODY_PATCHES[pi as usize], or_body_start) }; pi = pi + 1 }
                // Check if any alt is wildcard → exhaustive
                var or_has_wild: i64 = 0
                var owj: i64 = 0
                while owj < OR_ALT_COUNT { if OR_ALT_IS_WILD[owj as usize] == 1 { or_has_wild = 1 }; owj = owj + 1 }
                if or_has_wild == 1 { if match_arms < 1000000 { match_arms = 1000000 } }
                // Compile arm body
                if TK[EP as usize] == 52 { EP = EP + 1 }
                var or_arm_block: i64 = 0
                if TK[EP as usize] == 8 { or_arm_block = 1; EP = EP + 1 }
                LAST_STMT_HAS_VALUE = 0
                if or_arm_block == 1 {
                    while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
                    if TK[EP as usize] == 9 { EP = EP + 1 }
                } else { compile_stmt() }
                // β⁹ GTT week-7: OR arm's tail EXPR_CH_SET into the running union.
                match_arms_ch_union = match_arms_ch_union | EXPR_CH_SET
                // Count each alternative as a separate arm for exhaustiveness
                match_arms = match_arms + OR_ALT_COUNT
                if LAST_STMT_HAS_VALUE == 1 {
                    if match_have_ty == 0 { match_have_ty = 1; match_ty = LAST_STMT_TY; match_hash = LAST_STMT_TY_HASH }
                    else if ty_eq(match_ty, match_hash, LAST_STMT_TY, LAST_STMT_TY_HASH) == false { tc_error(EP - 1, "match arm type does not match other arms") }
                } else { match_all_value = 0 }
                em(0xe9); match_ends[arm_count as usize] = CL; em32(0)
                arm_count = arm_count + 1
                if or_skip_patch >= 0 { patch32(or_skip_patch, CL) }
            }
            // Tuple pattern emission: `(p0, p1, ...) => body`. Scrutinee is a tuple pointer in
            // match_slot; element i is at [tuple + off_i] and is itself a pointer to the
            // element's {tag, payload} (Options/aggregates are pointer-represented, exactly as
            // the single-pattern path at the tagged emission below loads [scrut]→tag). Emit a
            // tag test per tagged element, ALL jumping to the shared skip; bind payloads; body.
            if is_tuple_pattern == 1 {
                var tup_first_slots: i64 = (match_scrut_hash % 1000000) / 1000
                if tup_first_slots < 1 { tup_first_slots = 1 }
                let elem1_off = tup_first_slots * 8
                // Element Option types (for typing the payload bindings — without this the
                // bound var is untyped and `*ia` in the arm body miscompiles).
                var tup_e0_hash: i64 = 0
                var tup_e1_hash: i64 = 0
                let tmci = tup_cache_lookup(match_scrut_hash)
                if tmci >= 0 {
                    tup_e0_hash = TUP_CACHE_FIRST_HASH[tmci as usize]
                    tup_e1_hash = TUP_CACHE_LAST_HASH[tmci as usize]
                }
                var nskip: i64 = 0
                var tei: i64 = 0
                while tei < tpat_count {
                    if TPAT_IS_WILD[tei as usize] == 0 && TPAT_TAGGED[tei as usize] == 1 {
                        let toff = if tei == 0 { 0 } else { elem1_off }
                        emit_load_var(match_slot)
                        if toff != 0 { em(0x48); em(0x8d); em(0x80); em32(toff) }
                        em(0x48); em(0x8b); em(0x00)  // mov rax,[tuple+toff] = element tag (elements are INLINE)
                        em(0x50)
                        em(0x48); em(0xb8); em64(TPAT_DISC[tei as usize])
                        em(0x59)
                        em(0x48); em(0x39); em(0xc1)
                        em(0x0f); em(0x85); TPAT_SKIP[nskip as usize] = CL; em32(0)
                        nskip = nskip + 1
                    }
                    tei = tei + 1
                }
                tei = 0
                while tei < tpat_count {
                    if TPAT_HAS_BIND[tei as usize] == 1 {
                        let toff = if tei == 0 { 0 } else { elem1_off }
                        emit_load_var(match_slot)
                        em(0x48); em(0x8d); em(0x80); em32(toff + 8)  // lea rax,[tuple+toff+8]
                        em(0x48); em(0x8b); em(0x00)  // mov rax,[..] = element payload (inline, slot after tag)
                        let tbslot = var_add(TPAT_BIND_NS[tei as usize], TPAT_BIND_NE[tei as usize])
                        if tbslot >= 0 {
                            emit_store_var(tbslot)
                            if VAR_COUNT > 0 {
                                let tbvi = VAR_COUNT - 1
                                let eoh = if tei == 0 { tup_e0_hash } else { tup_e1_hash }
                                if option_hash_is(eoh) {
                                    VAR_TY[tbvi as usize] = option_hash_inner_ty(eoh)
                                    VAR_TY_HASH[tbvi as usize] = option_hash_inner_hash(eoh)
                                }
                            }
                        }
                    }
                    tei = tei + 1
                }
                if TK[EP as usize] == 52 { EP = EP + 1 }
                var tup_arm_block: i64 = 0
                if TK[EP as usize] == 8 { tup_arm_block = 1; EP = EP + 1 }
                LAST_STMT_HAS_VALUE = 0
                if tup_arm_block == 1 {
                    while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
                    if TK[EP as usize] == 9 { EP = EP + 1 }
                } else { compile_stmt() }
                match_arms_ch_union = match_arms_ch_union | EXPR_CH_SET
                match_arms = match_arms + 1
                if LAST_STMT_HAS_VALUE == 1 {
                    if match_have_ty == 0 { match_have_ty = 1; match_ty = LAST_STMT_TY; match_hash = LAST_STMT_TY_HASH }
                    else if ty_eq(match_ty, match_hash, LAST_STMT_TY, LAST_STMT_TY_HASH) == false { tc_error(EP - 1, "match arm type does not match other arms") }
                } else { match_all_value = 0 }
                em(0xe9); match_ends[arm_count as usize] = CL; em32(0)
                arm_count = arm_count + 1
                var tpj: i64 = 0
                while tpj < nskip { patch32(TPAT_SKIP[tpj as usize], CL); tpj = tpj + 1 }
            }
            // Variable binding pattern (with optional guard)
            if is_or_pattern == 0 && is_var_bind == 1 {
                // Bind scrutinee to the variable name
                emit_load_var(match_slot)
                let vb_slot = var_add(bind_ns, bind_ne)
                if vb_slot >= 0 {
                    emit_store_var(vb_slot)
                    // Propagate scrutinee type to bound variable
                    if VAR_COUNT > 0 {
                        let vbi = VAR_COUNT - 1
                        VAR_TY[vbi as usize] = match_scrut_ty
                        VAR_TY_HASH[vbi as usize] = match_scrut_hash
                        // β⁹ GTT week-7 follow-up: bound var inherits scrutinee's
                        // channel topology.  Without this, arm bodies that reference
                        // the bound variable load VAR_CH_SET[bslot] = 0 (stale) and
                        // lose the scrutinee's topology inside the arm.  Upper-bound
                        // sound: bound ≤ scrutinee by construction (var binding is
                        // just an alias over the scrutinee's runtime value).
                        VAR_CH_SET[vbi as usize] = match_scrut_ch_set
                    }
                }
                // Optional guard: `if condition`
                var vb_has_guard: i64 = 0
                var vb_guard_skip: i64 = 0
                if TK[EP as usize] == 13 {
                    vb_has_guard = 1; EP = EP + 1
                    compile_or()  // guard condition → rax
                    em(0x48); em(0x85); em(0xc0)  // test rax, rax
                    em(0x0f); em(0x84); vb_guard_skip = CL; em32(0)  // je guard_fail
                }
                if TK[EP as usize] == 52 { EP = EP + 1 }  // skip =>
                var vb_arm_has_block: i64 = 0
                if TK[EP as usize] == 8 { vb_arm_has_block = 1; EP = EP + 1 }
                LAST_STMT_HAS_VALUE = 0
                if vb_arm_has_block == 1 {
                    while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
                    if TK[EP as usize] == 9 { EP = EP + 1 }
                } else { compile_stmt() }
                // β⁹ GTT week-7: OR var-binding arm's tail EXPR_CH_SET into union.
                match_arms_ch_union = match_arms_ch_union | EXPR_CH_SET
                match_arms = match_arms + 1
                // No guard → acts as wildcard for exhaustiveness
                if vb_has_guard == 0 { if match_arms < 1000000 { match_arms = 1000000 } }
                if LAST_STMT_HAS_VALUE == 1 {
                    if match_have_ty == 0 { match_have_ty = 1; match_ty = LAST_STMT_TY; match_hash = LAST_STMT_TY_HASH }
                    else if ty_eq(match_ty, match_hash, LAST_STMT_TY, LAST_STMT_TY_HASH) == false { tc_error(EP - 1, "match arm type does not match other arms") }
                } else { match_all_value = 0 }
                if vb_has_guard == 1 {
                    em(0xe9); match_ends[arm_count as usize] = CL; em32(0)
                    arm_count = arm_count + 1
                    patch32(vb_guard_skip, CL)
                }
            }
            if is_or_pattern == 0 && disc >= 0 {
                if arm_is_tagged == 1 {
                    // Tagged union match: load tag from [scrutinee + 0]
                    emit_load_var(match_slot)
                    em(0x48); em(0x8b); em(0x00)  // mov rax, [rax] (tag)
                    em(0x50)  // push tag
                    em(0x48); em(0xb8); em64(disc)
                    em(0x59)  // pop rcx (tag)
                    em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
                    em(0x0f); em(0x85); let skip_patch = CL; em32(0)  // jne skip
                    // Bind inner value if pattern has binding
                    if has_binding == 1 {
                        emit_load_var(match_slot)
                        em(0x48); em(0x8b); em(0x40); em(0x08)  // mov rax, [rax + 8] (value)
                        let bslot = var_add(bind_ns, bind_ne)
                        if bslot >= 0 { emit_store_var(bslot) }
                        // Propagate inner type from Option/Result scrutinee to bound variable
                        if bslot >= 0 && VAR_COUNT > 0 {
                            let bvi = VAR_COUNT - 1
                            if type_is_option_inline(match_scrut_ty, match_scrut_hash) && option_hash_is(match_scrut_hash) {
                                VAR_TY[bvi as usize] = option_hash_inner_ty(match_scrut_hash)
                                VAR_TY_HASH[bvi as usize] = option_hash_inner_hash(match_scrut_hash)
                            }
                            // β⁹ GTT week-7 follow-up: inner-value bound var inherits
                            // scrutinee's channel topology.  Upper-bound sound because
                            // the inner value was constructed into the scrutinee, so
                            // its topology ⊆ scrutinee's topology.
                            VAR_CH_SET[bvi as usize] = match_scrut_ch_set
                        }
                    }
                    if TK[EP as usize] == 52 { EP = EP + 1 }  // skip =>
                    var arm_has_block: i64 = 0
                    if TK[EP as usize] == 8 { arm_has_block = 1; EP = EP + 1 }
                    LAST_STMT_HAS_VALUE = 0
                    if arm_has_block == 1 {
                        while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
                        if TK[EP as usize] == 9 { EP = EP + 1 }
                    } else {
                        compile_stmt()
                    }
                    // β⁹ GTT week-7: OR tagged-variant arm's tail EXPR_CH_SET into union.
                    match_arms_ch_union = match_arms_ch_union | EXPR_CH_SET
                    match_arms = match_arms + 1
                    if LAST_STMT_HAS_VALUE == 1 {
                        if match_have_ty == 0 {
                            match_have_ty = 1
                            match_ty = LAST_STMT_TY
                            match_hash = LAST_STMT_TY_HASH
                        } else if ty_eq(match_ty, match_hash, LAST_STMT_TY, LAST_STMT_TY_HASH) == false {
                            tc_error(EP - 1, "match arm type does not match other arms")
                        }
                    } else {
                        match_all_value = 0
                    }
                    em(0xe9); match_ends[arm_count as usize] = CL; em32(0)
                    arm_count = arm_count + 1
                    patch32(skip_patch, CL)
                } else {
                    // Plain enum/integer match: compare scrutinee directly
                    emit_load_var(match_slot)
                    em(0x50)
                    em(0x48); em(0xb8); em64(disc)
                    em(0x59)
                    em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
                    em(0x0f); em(0x85); let skip_patch = CL; em32(0)  // jne skip
                    if TK[EP as usize] == 52 { EP = EP + 1 }  // skip =>
                    var arm_has_block2: i64 = 0
                    if TK[EP as usize] == 8 { arm_has_block2 = 1; EP = EP + 1 }
                    LAST_STMT_HAS_VALUE = 0
                    if arm_has_block2 == 1 {
                        while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
                        if TK[EP as usize] == 9 { EP = EP + 1 }
                    } else {
                        compile_stmt()
                    }
                    // β⁹ GTT week-7: OR plain-enum arm's tail EXPR_CH_SET into union.
                    match_arms_ch_union = match_arms_ch_union | EXPR_CH_SET
                    match_arms = match_arms + 1
                    if LAST_STMT_HAS_VALUE == 1 {
                        if match_have_ty == 0 {
                            match_have_ty = 1
                            match_ty = LAST_STMT_TY
                            match_hash = LAST_STMT_TY_HASH
                        } else if ty_eq(match_ty, match_hash, LAST_STMT_TY, LAST_STMT_TY_HASH) == false {
                            tc_error(EP - 1, "match arm type does not match other arms")
                        }
                    } else {
                        match_all_value = 0
                    }
                    em(0xe9); match_ends[arm_count as usize] = CL; em32(0)
                    arm_count = arm_count + 1
                    patch32(skip_patch, CL)
                }
            }
            if is_or_pattern == 0 && is_wildcard == 1 {
                if match_arms < 1000000 { match_arms = 1000000 }
                if TK[EP as usize] == 52 { EP = EP + 1 }
                var arm_has_block3: i64 = 0
                if TK[EP as usize] == 8 { arm_has_block3 = 1; EP = EP + 1 }
                LAST_STMT_HAS_VALUE = 0
                if arm_has_block3 == 1 {
                    while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
                    if TK[EP as usize] == 9 { EP = EP + 1 }
                } else {
                    compile_stmt()
                }
                // β⁹ GTT week-7: OR wildcard arm's tail EXPR_CH_SET into union.
                match_arms_ch_union = match_arms_ch_union | EXPR_CH_SET
                match_arms = match_arms + 1
                if LAST_STMT_HAS_VALUE == 1 {
                    if match_have_ty == 0 {
                        match_have_ty = 1
                        match_ty = LAST_STMT_TY
                        match_hash = LAST_STMT_TY_HASH
                    } else if ty_eq(match_ty, match_hash, LAST_STMT_TY, LAST_STMT_TY_HASH) == false {
                        tc_error(EP - 1, "match arm type does not match other arms")
                    }
                } else {
                    match_all_value = 0
                }
            }
            if TK[EP as usize] == 28 { EP = EP + 1 }
        }
        if TK[EP as usize] == 9 { EP = EP + 1 }
        var ai: i64 = 0
        while ai < arm_count { patch32(match_ends[ai as usize], CL); ai = ai + 1 }
        // FALL-THROUGH FIX (same root as the if-no-else nop): if the last-emitted arm ends in
        // `return` (last byte 0xc3) but a non-returning arm falls through to this merge, the
        // implicit-return epilogue guard (CD[CL-1] != 0xc3) would wrongly skip the epilogue,
        // dropping the fall-through path off the end of the function. Emit a nop at the merge
        // so CD[CL-1] != 0xc3 and the epilogue is emitted. Harmless for value-matches (value in
        // rax) and for all-returning matches (unreachable merge = dead nop).
        em(0x90)
        if match_scrut_ty == 7 && match_arms < 1000000 && match_arms < en_variant_count(match_scrut_hash) {
            tc_error_hard(EP - 1, "match must be exhaustive")
            LAST_STMT_HAS_VALUE = 0
            LAST_STMT_TY = 0
            LAST_STMT_TY_HASH = 0
            return
        }
        if match_arms > 0 && match_all_value == 1 && match_have_ty == 1 {
            LAST_STMT_HAS_VALUE = 1
            LAST_STMT_TY = match_ty
            LAST_STMT_TY_HASH = match_hash
            EXPR_TY = match_ty
            EXPR_TY_HASH = match_hash
            if match_ty == 2 { EXPR_IS_F64 = 1 }
            else { EXPR_IS_F64 = 0 }
            // β⁹ GTT week-7 stage 2: final topology = scrutinee ∪ union-of-arms.
            // Matches `Typing.tMatch` conclusion `Sc.union (chsetUnionFin Ss)`.
            EXPR_CH_SET = match_scrut_ch_set | match_arms_ch_union
        }
        return
    }

    // Expression statement
    compile_or()
    LAST_STMT_HAS_VALUE = 1
    LAST_STMT_TY = EXPR_TY
    LAST_STMT_TY_HASH = EXPR_TY_HASH
}

// ─── Epistemic Type System: Core Functions ───
// GUM-quantified type inference — the compiler is Patient Zero.

fn ety_clamp(c: i64) -> i64 {
    if c < 0 { return 0 }
    if c > 1000 { return 1000 }
    return c
}

fn ety_isqrt(n: i64) -> i64 with Div, Mut {
    // Integer square root (Newton-Raphson) for GUM quadrature
    if n <= 0 { return 0 }
    if n == 1 { return 1 }
    var x: i64 = n / 2 + 1
    var prev: i64 = x + 1
    while x < prev {
        prev = x
        x = (x + n / x) / 2
    }
    return prev
}

fn ety_alloc(kind: i64, conf: i64, unc: i64) -> i64 with Mut {
    // Allocate a new type in the epistemic pool
    let id = ETY_COUNT
    if id >= 16384 { return 0 }
    ETY_KIND[id as usize] = kind
    ETY_CONF[id as usize] = ety_clamp(conf)
    ETY_UNC[id as usize] = ety_clamp(unc)
    ETY_HASH[id as usize] = 0
    ETY_COUNT = ETY_COUNT + 1
    return id
}

fn ety_mk_i64() -> i64 with Mut { return ety_alloc(1, 1000, 0) }
fn ety_mk_f64() -> i64 with Mut { return ety_alloc(2, 1000, 0) }
fn ety_mk_bool() -> i64 with Mut { return ety_alloc(3, 1000, 0) }
fn ety_mk_string() -> i64 with Mut { return ety_alloc(4, 1000, 0) }
fn ety_mk_void() -> i64 with Mut { return ety_alloc(5, 1000, 0) }
fn ety_mk_unknown() -> i64 with Mut { return ety_alloc(0, 0, 1000) }
fn ety_mk_struct() -> i64 with Mut { return ety_alloc(6, 1000, 0) }  // Gen 16 Track A: kind=6 for struct/enum
// Gen 17 D3: Knowledge<T> as first-class ETY kind=7
// ETY_UNC stores inner type kind (1=i64, 2=f64, etc.), ETY_CONF stores confidence bound.
fn ety_mk_knowledge(inner_kind: i64, conf: i64, unit_dim: i64) -> i64 with Mut {
    let id = ety_alloc(7, conf, inner_kind)
    if id >= 0 && id < 16384 { ETY_UNIT_DIM[id as usize] = unit_dim }
    if unit_dim != 0 { KNOWLEDGE_UNITS_COUNT = KNOWLEDGE_UNITS_COUNT + 1 }
    return id
}

// Gen 17 D3: Epistemic subtyping for Knowledge<T>
// Knowledge<T, c1> is a subtype of Knowledge<T, c2> when c1 >= c2
fn ety_knowledge_subtype_ok(src_ety: i64, dst_ety: i64) -> bool {
    if ety_kind(src_ety) != 7 || ety_kind(dst_ety) != 7 { return true }
    return ETY_CONF[src_ety as usize] >= ETY_CONF[dst_ety as usize]
}

fn ety_conf(id: i64) -> i64 {
    if id < 0 || id >= ETY_COUNT { return 0 }
    return ETY_CONF[id as usize]
}

fn ety_kind(id: i64) -> i64 {
    if id < 0 || id >= ETY_COUNT { return 0 }
    return ETY_KIND[id as usize]
}

// GUM confidence propagation: product rule (uncertainty compounds)
fn ety_conf_product(c_a: i64, c_b: i64) -> i64 {
    return ety_clamp((c_a * c_b) / 1000)
}

// GUM uncertainty combination: RSS (root sum of squares)
fn ety_unc_combine(u_a: i64, u_b: i64) -> i64 with Div, Mut {
    return ety_clamp(ety_isqrt(u_a * u_a + u_b * u_b))
}

// Epistemic scope operations
fn escope_push() with Mut {
    ESCOPE_LEVEL = ESCOPE_LEVEL + 1
}

fn escope_pop() with Mut {
    // Remove all entries at current level
    while ESCOPE_COUNT > 0 && ESCOPE_DEPTH[(ESCOPE_COUNT - 1) as usize] == ESCOPE_LEVEL {
        ESCOPE_COUNT = ESCOPE_COUNT - 1
    }
    ESCOPE_LEVEL = ESCOPE_LEVEL - 1
}

fn escope_add(name_hash: i64, ty_id: i64, conf: i64) with Mut {
    if ESCOPE_COUNT >= 2048 { return }
    ESCOPE_HASH[ESCOPE_COUNT as usize] = name_hash
    ESCOPE_TY[ESCOPE_COUNT as usize] = ty_id
    ESCOPE_CONF[ESCOPE_COUNT as usize] = conf
    ESCOPE_DEPTH[ESCOPE_COUNT as usize] = ESCOPE_LEVEL
    ESCOPE_COUNT = ESCOPE_COUNT + 1
}

fn escope_find(name_hash: i64) -> i64 with Mut {
    // Returns index, or -1 if not found. Searches backward (innermost scope first).
    var i: i64 = ESCOPE_COUNT - 1
    while i >= 0 {
        if ESCOPE_HASH[i as usize] == name_hash { return i }
        i = i - 1
    }
    return -1
}

// ─── Gen 1: Epistemic Inference with GUM Propagation ───
// Literals: confidence 1000 (axiomatic).
// Variables: look up in epistemic scope → inherit confidence.
// Binary ops: GUM product (confidence compounds serially).
// Function calls: GUM product of arg confidences × callee effect confidence.
// Unification: GUM weighted average (parallel measurements).
// No codegen changes yet — EXPR_GATE computed but not consumed.

// Bridge: lean_single type_name_kind → epistemic type IDs
// type_name_kind: 1=int, 2=float, 3=string, 4=bool, 5=unit, 6=struct, 7=enum
// epistemic:      0=unknown, 1=i64, 2=f64, 3=bool, 4=string, 5=void
fn ety_from_tnk(tnk: i64) -> i64 {
    if tnk == 1 { return 1 }
    if tnk == 2 { return 2 }
    if tnk == 3 { return 4 }
    if tnk == 4 { return 3 }
    if tnk == 5 { return 5 }
    if tnk == 6 { return 6 }   // Gen 16 Track A: struct → kind=6, not unknown
    if tnk == 7 { return 6 }   // Gen 16 Track A: enum  → same struct pool slot
    return 0
}

// GUM-correct unification (Grok's weighted average + DeepSeek's dispatch)
var EUNIFY_CONF: i64 = 0
var EUNIFY_UNIT_DIM: i64 = 0  // result unit dim for kind=7 Knowledge<T> binary ops
var ETY_UNIFY_OP: i64 = 0     // operator token (17=+,18=-,19=*,20=/) set before ety_unify call
fn ety_unify(ty_a: i64, conf_a: i64, ty_b: i64, conf_b: i64) -> i64 with Mut, Div {
    // Unknown adopts the other type
    if ety_kind(ty_a) == 0 { EUNIFY_CONF = 0; return ty_b }
    if ety_kind(ty_b) == 0 { EUNIFY_CONF = 0; return ty_a }
    // Types match: confidence-squared weighted average
    // Gen 15: PLATINUM preservation — two maximally-certain types unify to 1000,
    // not 999. The formula (a²+b²)/(a+b+1) = 999 for a=b=1000 introduces
    // representational noise with no epistemic justification; if both inputs are
    // fully certain the output is fully certain.
    if ety_kind(ty_a) == ety_kind(ty_b) {
        if conf_a == 1000 && conf_b == 1000 { EUNIFY_CONF = 1000; return ty_a }
        var num: i64 = (conf_a * conf_a) + (conf_b * conf_b)
        var den: i64 = conf_a + conf_b + 1
        EUNIFY_CONF = ety_clamp(num / den)
        return ty_a
    }
    // Numeric promotion i64 → f64 — same PLATINUM preservation applies
    if (ety_kind(ty_a) == 1 && ety_kind(ty_b) == 2) || (ety_kind(ty_a) == 2 && ety_kind(ty_b) == 1) {
        if conf_a == 1000 && conf_b == 1000 { EUNIFY_CONF = 1000; return 2 }
        var num: i64 = (conf_a * conf_a) + (conf_b * conf_b)
        var den: i64 = conf_a + conf_b + 1
        EUNIFY_CONF = ety_clamp(num / den)
        return 2
    }
    // Gen 17 D3 / Gen 19: Knowledge<T> unification — min confidence + dimensional propagation
    if ety_kind(ty_a) == 7 || ety_kind(ty_b) == 7 {
        // Confidence: min(left, right) — GUM conservative rule for epistemic types
        var know_conf: i64 = conf_a
        if conf_b < know_conf { know_conf = conf_b }
        if ty_a >= 0 && ty_a < ETY_COUNT && ETY_CONF[ty_a as usize] < know_conf { know_conf = ETY_CONF[ty_a as usize] }
        if ty_b >= 0 && ty_b < ETY_COUNT && ETY_CONF[ty_b as usize] < know_conf { know_conf = ETY_CONF[ty_b as usize] }
        EUNIFY_CONF = know_conf
        // Dimensional propagation for arithmetic operators
        var dim_a: i64 = 0
        var dim_b: i64 = 0
        if ty_a >= 0 && ty_a < ETY_COUNT { dim_a = ETY_UNIT_DIM[ty_a as usize] }
        if ty_b >= 0 && ty_b < ETY_COUNT { dim_b = ETY_UNIT_DIM[ty_b as usize] }
        var result_dim: i64 = 0
        let op = ETY_UNIFY_OP
        if op == 17 || op == 18 {
            // +/-: require equal dims; result inherits left dim (mismatch → dimensionless)
            result_dim = dim_a
            if dim_a != 0 && dim_b != 0 && dim_a != dim_b { result_dim = 0 }
        } else if op == 19 {
            result_dim = dim_add(dim_a, dim_b)  // *: exponent addition
        } else if op == 20 {
            result_dim = dim_sub(dim_a, dim_b)  // /: exponent subtraction
        } else {
            result_dim = dim_a
        }
        EUNIFY_UNIT_DIM = result_dim
        // Inner kind from whichever side is kind=7
        var inner_k: i64 = 2
        if ety_kind(ty_a) == 7 && ty_a >= 0 && ty_a < ETY_COUNT { inner_k = ETY_UNC[ty_a as usize] }
        else if ety_kind(ty_b) == 7 && ty_b >= 0 && ty_b < ETY_COUNT { inner_k = ETY_UNC[ty_b as usize] }
        return ety_mk_knowledge(inner_k, know_conf, result_dim)
    }
    // Type conflict: confidence crashes, return higher-confidence type
    EUNIFY_CONF = 0
    if conf_a > conf_b { return ty_a }
    return ty_b
}

// Effect bitset parsing from function signatures
fn ety_parse_effect_name(ns: i64, ne: i64) -> i64 with Panic, Mut {
    let l = ne - ns
    if src_match(ns, l, "IO") { return 1 }
    if src_match(ns, l, "Mut") { return 2 }
    if src_match(ns, l, "Panic") { return 4 }
    if src_match(ns, l, "Div") { return 8 }
    if src_match(ns, l, "Alloc") { return 16 }
    if src_match(ns, l, "Observe") { return 32 }
    // Gen 20: GPU = bit 13 (8192) — above the & 1023 call-site mask, no propagation required
    if src_match(ns, l, "GPU") { return 8192 }
    // ZD = bit 14 (16384) — zero-divisor effect for sedenion-based exact erasure
    if src_match(ns, l, "ZD") { return 16384 }
    // Approx = bit 18 (262144) — numerical approximation tracking
    if src_match(ns, l, "Approx") { return 262144 }
    // Causal = bit 19 (524288) — causal inference effect
    if src_match(ns, l, "Causal") { return 524288 }
    // NaturalityG2 = bit 20 (1048576) — homology functor F: C_dial → C_𝕆
    // is G₂-equivariant. Functions carrying this effect will emit a Lean
    // obligation at IR-emit time (deferred to M4). For now, declaring the
    // effect is enough to type-check.
    if src_match(ns, l, "NaturalityG2") { return 1048576 }
    return 0
}

fn epistemic_infer_pass() with IO, Mut, Panic, Div {
    // Pre-allocate canonical types (IDs 0-5)
    ETY_COUNT = 0
    ESCOPE_COUNT = 0
    ESCOPE_LEVEL = 0
    GATE_THRESHOLD = 950
    KNOWLEDGE_UNITS_COUNT = 0
    let ty_unknown = ety_mk_unknown()  // 0
    let ty_i64 = ety_mk_i64()          // 1
    let ty_f64 = ety_mk_f64()          // 2
    let ty_bool = ety_mk_bool()        // 3
    let ty_string = ety_mk_string()    // 4
    let ty_void = ety_mk_void()        // 5
    let ty_struct_id = ety_mk_struct() // 6  Gen 16 Track A: struct canonical type
    EPIST_TOTAL_EXPR = 0
    EPIST_HIGH_CONF = 0
    EPIST_LOW_CONF = 0
    EPIST_MAIN_TOTAL = 0
    EPIST_MAIN_HIGH = 0
    EPIST_KTYPE_SITES = 0
    EPIST_KTYPE_CERTAIN = 0
    EPIST_MEAS_COUNT = 0
    EPIST_TIER_PLATINUM = 0
    EPIST_TIER_GOLD = 0
    EPIST_TIER_SILVER = 0
    EPIST_TIER_BRONZE = 0
    EPIST_EFFECT_VIOLATIONS = 0  // Gen 16 Track B

    // Phase A: Collect effect declarations for all registered functions
    var fi: i64 = 0
    while fi < FN_COUNT {
        FN_DECL_EFF[fi as usize] = 0
        FN_USED_EFF[fi as usize] = 0
        FN_EFF_CONF[fi as usize] = 1000
        // Scan from fn name token forward to find 'with' clause
        let fn_tok = FN_NAME_TOK[fi as usize]
        if fn_tok > 0 {
            var q: i64 = fn_tok
            while q < TC && TK[q as usize] != 8 && TK[q as usize] != 0 {
                if TK[q as usize] == 38 {
                    // 'with' keyword found — parse effects
                    q = q + 1
                    while q < TC && TK[q as usize] == 3 {
                        let eff = ety_parse_effect_name(TS[q as usize], TE[q as usize])
                        FN_DECL_EFF[fi as usize] = FN_DECL_EFF[fi as usize] | eff
                        q = q + 1
                        if q < TC && TK[q as usize] == 28 { q = q + 1 }
                    }
                    break
                }
                q = q + 1
            }
        }
        fi = fi + 1
    }

    // Gen 12 Phase A2: Epistemic constructor confidence bridge
    // Assign semantically meaningful FN_EFF_CONF to functions that return
    // Knowledge<T> (Epistemic) values, reflecting measurement quality rather
    // than defaulting to 1000 (type-system certainty).
    // - "measured": returns Epistemic from instrument data → conf 990
    //   (high but not perfect: instrument measurements carry inherent uncertainty)
    // - "asserted": user-asserted value → conf 970 (slightly less certain)
    // Both remain above GATE_THRESHOLD (950) so no guarded sites are introduced.
    // With arg_conf=1000, call_conf = 990*1000/1000 = 990 ≥ 950. ✓
    fi = 0
    while fi < FN_COUNT {
        let g12_fns = FN_NS[fi as usize]
        let g12_fne = FN_NE[fi as usize]
        let g12_flen = g12_fne - g12_fns
        if src_match(g12_fns, g12_flen, "measured") { FN_EFF_CONF[fi as usize] = 990 }
        if src_match(g12_fns, g12_flen, "asserted") { FN_EFF_CONF[fi as usize] = 970 }
        fi = fi + 1
    }

    // Gen 15 Phase A3: .econf certificate loading
    // If --load-econf was given, parse the raw byte buffer for lines of the form:
    //   fn <name> <conf>
    // and override FN_EFF_CONF for matching functions.
    // This allows cross-module epistemic certificates: a library compiled at
    // conf=990 for its measured() wrappers transfers that knowledge here.
    if CLI_LOAD_ECONF != 0 && ECONF_RAW_LEN > 0 {
        var ecp: i64 = 0
        while ecp < ECONF_RAW_LEN {
            // Skip non-'f' bytes (looking for "fn " prefix)
            if ECONF_RAW[ecp as usize] != 102 {  // 'f'
                while ecp < ECONF_RAW_LEN && ECONF_RAW[ecp as usize] != 10 { ecp = ecp + 1 }
                ecp = ecp + 1
                continue
            }
            if ecp + 2 >= ECONF_RAW_LEN { ecp = ecp + 1; continue }
            if ECONF_RAW[(ecp + 1) as usize] != 110 { // 'n'
                while ecp < ECONF_RAW_LEN && ECONF_RAW[ecp as usize] != 10 { ecp = ecp + 1 }
                ecp = ecp + 1
                continue
            }
            if ECONF_RAW[(ecp + 2) as usize] != 32 {  // ' '
                while ecp < ECONF_RAW_LEN && ECONF_RAW[ecp as usize] != 10 { ecp = ecp + 1 }
                ecp = ecp + 1
                continue
            }
            // "fn " matched — extract name start..end
            ecp = ecp + 3
            let ec_ns = ecp
            while ecp < ECONF_RAW_LEN && ECONF_RAW[ecp as usize] != 32 && ECONF_RAW[ecp as usize] != 10 { ecp = ecp + 1 }
            let ec_ne = ecp
            if ec_ne <= ec_ns { continue }
            // Skip space, parse conf integer
            if ecp < ECONF_RAW_LEN && ECONF_RAW[ecp as usize] == 32 { ecp = ecp + 1 }
            var ec_conf: i64 = 0
            while ecp < ECONF_RAW_LEN && ECONF_RAW[ecp as usize] >= 48 && ECONF_RAW[ecp as usize] <= 57 {
                ec_conf = ec_conf * 10 + (ECONF_RAW[ecp as usize] - 48)
                ecp = ecp + 1
            }
            if ec_conf <= 0 || ec_conf > 1000 { continue }
            // Match against registered functions
            let ec_name_len = ec_ne - ec_ns
            var efi2: i64 = 0
            while efi2 < FN_COUNT {
                let ef_fns = FN_NS[efi2 as usize]
                let ef_fne = FN_NE[efi2 as usize]
                let ef_flen = ef_fne - ef_fns
                if ef_flen == ec_name_len {
                    // Compare ECONF_RAW[ec_ns..ec_ne] against SRC[ef_fns..ef_fne]
                    var ec_match: i64 = 1
                    var ec_ki: i64 = 0
                    while ec_ki < ec_name_len {
                        if ECONF_RAW[(ec_ns + ec_ki) as usize] != (SRC[(ef_fns + ec_ki) as usize] as i64 & 0xFF) {
                            ec_match = 0
                            ec_ki = ec_name_len  // break
                        }
                        ec_ki = ec_ki + 1
                    }
                    if ec_match == 1 {
                        FN_EFF_CONF[efi2 as usize] = ec_conf
                        ECONF_APPLIED = ECONF_APPLIED + 1
                    }
                }
                efi2 = efi2 + 1
            }
            // Advance to next line
            while ecp < ECONF_RAW_LEN && ECONF_RAW[ecp as usize] != 10 { ecp = ecp + 1 }
            ecp = ecp + 1
        }
        if ECONF_APPLIED > 0 {
            print("econf_load: ")
            print_int(ECONF_APPLIED)
            print(" FN_EFF_CONF overrides applied from certificate\n")
        }
    }

    // Phase B: Walk all tokens, assign epistemic types
    // Gen 1: literals + variables (via scope) + binary op GUM propagation
    var p: i64 = 0
    var depth: i64 = 0
    while p < TC {
        let tk = TK[p as usize]

        // Track brace depth for scope
        if tk == 8 { escope_push(); depth = depth + 1; p = p + 1; continue }
        if tk == 9 { escope_pop(); depth = depth - 1; p = p + 1; continue }

        // Identifiers in declaration/structural positions — mark confident
        if tk == 3 && p > 0 {
            let prev = TK[(p - 1) as usize]
            // After fn, struct, enum, pub, linear, affine: declaration name
            if prev == 1 || prev == 46 || prev == 47 || prev == 49 || prev == 62 || prev == 73 {
                EXPR_ETY[p as usize] = ty_void
                EXPR_CONF[p as usize] = 1000
                EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
                if prev != 1 { p = p + 1; continue }
            }
            // After '.' — field access
            if prev == 50 {
                EXPR_ETY[p as usize] = ty_void
                EXPR_CONF[p as usize] = 1000
                EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
                p = p + 1
                continue
            }
            // After 'let' or 'var': variable declaration name
            if prev == 11 || prev == 12 {
                EXPR_ETY[p as usize] = ty_void
                EXPR_CONF[p as usize] = 1000
                EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
                p = p + 1
                continue
            }
            // After ':' or '->' — type position
            if prev == 43 || prev == 10 {
                EXPR_ETY[p as usize] = ty_void
                EXPR_CONF[p as usize] = 1000
                EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
                p = p + 1
                continue
            }
            // After ',' in a type/param context — also type position
            // (handles multi-param: fn f(a: i64, b: i64) — 'b' follows ',')
            // After another ident that was just a type name — chain types
            // After 'with' — effect names (IO, Mut, Panic, etc.)
            if prev == 38 {
                EXPR_ETY[p as usize] = ty_void
                EXPR_CONF[p as usize] = 1000
                EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
                p = p + 1
                continue
            }
            // Gen 11: effect names after comma in 'with X, Y, Z' — all are confident
            // regardless of prev_tk (they appear as ident-after-comma which isn't
            // covered by any other Phase B rule).
            if ety_parse_effect_name(TS[p as usize], TE[p as usize]) != 0 {
                EXPR_ETY[p as usize] = ty_void
                EXPR_CONF[p as usize] = 1000
                EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
                p = p + 1
                continue
            }
            // After '<' — generic type parameters
            if prev == 23 {
                EXPR_ETY[p as usize] = ty_void
                EXPR_CONF[p as usize] = 1000
                EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
                p = p + 1
                continue
            }
            // After '[' — array element type (e.g., [i8; N])
            if prev == 41 {
                EXPR_ETY[p as usize] = ty_void
                EXPR_CONF[p as usize] = 1000
                EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
                p = p + 1
                continue
            }
            // After ']' — post array type
            if prev == 42 {
                EXPR_ETY[p as usize] = ty_void
                EXPR_CONF[p as usize] = 1000
                EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
                p = p + 1
                continue
            }
        }

        // Function declaration: bind parameters into epistemic scope
        // fn NAME ( param1: type1, param2: type2 ) -> ret { body }
        if tk == 1 && p + 1 < TC && TK[(p + 1) as usize] == 3 {
            // Mark fn name as confident
            EXPR_ETY[(p + 1) as usize] = ty_void
            EXPR_CONF[(p + 1) as usize] = 1000
            // Skip 'fn' and name
            var fp: i64 = p + 2
            // Skip generic params <T> if present
            if fp < TC && TK[fp as usize] == 23 {
                while fp < TC && TK[fp as usize] != 24 { fp = fp + 1 }
                if fp < TC { fp = fp + 1 }
            }
            // Expect '('
            if fp < TC && TK[fp as usize] == 6 {
                fp = fp + 1
                // Parse parameter list: name : type , name : type , ...
                while fp < TC && TK[fp as usize] != 7 && TK[fp as usize] != 0 {
                    // Expect parameter name (identifier)
                    if TK[fp as usize] == 3 {
                        let pns = TS[fp as usize]
                        let pne = TE[fp as usize]
                        let pnh = gl_name_hash(pns, pne)
                        fp = fp + 1
                        var param_ty: i64 = ty_unknown
                        var param_conf: i64 = 0
                        // Expect ':'
                        if fp < TC && TK[fp as usize] == 43 {
                            fp = fp + 1
                            // Parse type — handle &, &!, [T; N], etc.
                            // Skip reference markers
                            if fp < TC && TK[fp as usize] == 44 { fp = fp + 1 }
                            if fp < TC && TK[fp as usize] == 32 { fp = fp + 1 }
                            if fp < TC && TK[fp as usize] == 3 {
                                let ptns = TS[fp as usize]
                                let ptne = TE[fp as usize]
                                if src_match(ptns, ptne - ptns, "i64") { param_ty = ty_i64; param_conf = 1000 }
                                if src_match(ptns, ptne - ptns, "i32") { param_ty = ty_i64; param_conf = 1000 }
                                if src_match(ptns, ptne - ptns, "i8") { param_ty = ty_i64; param_conf = 1000 }
                                if src_match(ptns, ptne - ptns, "u64") { param_ty = ty_i64; param_conf = 1000 }
                                if src_match(ptns, ptne - ptns, "usize") { param_ty = ty_i64; param_conf = 1000 }
                                if src_match(ptns, ptne - ptns, "f64") { param_ty = ty_f64; param_conf = 1000 }
                                if src_match(ptns, ptne - ptns, "f32") { param_ty = ty_f64; param_conf = 1000 }
                                if src_match(ptns, ptne - ptns, "bool") { param_ty = ty_bool; param_conf = 1000 }
                                if src_match(ptns, ptne - ptns, "string") { param_ty = ty_string; param_conf = 1000 }
                                // Gen 11: non-primitive type — check struct/enum table
                                if param_conf == 0 {
                                    let g11_pth = gl_name_hash(ptns, ptne)
                                    if st_find(g11_pth) >= 0 || en_find(g11_pth) >= 0 {
                                        param_ty = ty_void
                                        param_conf = 1000
                                    }
                                }
                                // Gen 11: fn-pointer parameter — match FN_NAME table
                                if param_conf == 0 {
                                    var g11_fj: i64 = 0
                                    while g11_fj < FN_COUNT {
                                        if name_eq(FN_NS[g11_fj as usize], FN_NE[g11_fj as usize], ptns, ptne) {
                                            param_ty = ety_from_tnk(FN_RET_TY[g11_fj as usize])
                                            param_conf = 1000
                                            g11_fj = FN_COUNT
                                        }
                                        g11_fj = g11_fj + 1
                                    }
                                }
                                fp = fp + 1
                            } else if fp < TC && TK[fp as usize] == 41 {
                                // Array type [T; N] — skip to ]
                                while fp < TC && TK[fp as usize] != 42 { fp = fp + 1 }
                                if fp < TC { fp = fp + 1 }
                                param_ty = ty_i64
                                param_conf = 1000
                            }
                        }
                        escope_add(pnh, param_ty, param_conf)
                        // Skip comma
                        if fp < TC && TK[fp as usize] == 28 { fp = fp + 1 }
                        continue
                    }
                    fp = fp + 1
                }
            }
            // Don't advance p — let the normal walk continue through fn tokens
            p = p + 1
            continue
        }

        // Keywords that are structural (not expressions): mark confident
        // return, continue, break, while, if, else, for, match, pub, linear
        if tk == 2 || tk == 33 || tk == 34 || tk == 15 || tk == 13 || tk == 54 || tk == 48 || tk == 49 || tk == 62 || tk == 46 || tk == 47 || tk == 38 || tk == 70 || tk == 71 || tk == 72 || tk == 61 || tk == 75 || tk == 76 {
            EXPR_ETY[p as usize] = ty_void
            EXPR_CONF[p as usize] = 1000
            EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
            EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
            p = p + 1
            continue
        }

        // Field access '.'
        if tk == 14 {
            if p > 0 {
                EXPR_ETY[p as usize] = EXPR_ETY[(p - 1) as usize]
                EXPR_CONF[p as usize] = EXPR_CONF[(p - 1) as usize]
            }
            p = p + 1
            continue
        }

        // Delimiters and punctuation: confident (structural, not epistemic)
        // ( ) , ; . :: => ..  ..=  ~
        if tk == 6 || tk == 7 || tk == 28 || tk == 27 || tk == 50 || tk == 51 || tk == 52 || tk == 63 || tk == 64 || tk == 55 || tk == 16 {
            EXPR_ETY[p as usize] = ty_void
            EXPR_CONF[p as usize] = 1000
            EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
            EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
            p = p + 1
            continue
        }

        // Some/None/Ok/Err — enum constructors, always confident
        if tk == 57 || tk == 58 || tk == 59 || tk == 60 {
            EXPR_ETY[p as usize] = ty_i64
            EXPR_CONF[p as usize] = 1000
            EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
            EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
            p = p + 1
            continue
        }

        // Integer literal → i64, confidence 1000
        if tk == 4 {
            EXPR_ETY[p as usize] = ty_i64
            EXPR_CONF[p as usize] = 1000
            EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
            EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
            p = p + 1
            continue
        }

        // Float literal → f64, confidence 1000
        if tk == 53 {
            EXPR_ETY[p as usize] = ty_f64
            EXPR_CONF[p as usize] = 1000
            EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
            EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
            p = p + 1
            continue
        }

        // String literal → string, confidence 1000
        if tk == 5 {
            EXPR_ETY[p as usize] = ty_string
            EXPR_CONF[p as usize] = 1000
            EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
            EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
            p = p + 1
            continue
        }

        // true/false → bool, confidence 1000
        if tk == 35 || tk == 36 {
            EXPR_ETY[p as usize] = ty_bool
            EXPR_CONF[p as usize] = 1000
            EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
            EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
            p = p + 1
            continue
        }

        // let/var binding: register variable with RHS confidence propagation
        if tk == 11 || tk == 12 {
            // let/var NAME [: TYPE] = EXPR
            if p + 1 < TC && TK[(p + 1) as usize] == 3 {
                let name_ns = TS[(p + 1) as usize]
                let name_ne = TE[(p + 1) as usize]
                let nh = gl_name_hash(name_ns, name_ne)
                var bind_ty: i64 = ty_unknown
                var bind_conf: i64 = 0
                var bind_meas_conf: i64 = 0   // Gen 13: measurement channel for this binding
                // Check for type annotation: NAME : TYPE
                var anno_end: i64 = p + 2
                if p + 2 < TC && TK[(p + 2) as usize] == 43 {
                    // Has type annotation → confidence from annotation
                    if p + 3 < TC && TK[(p + 3) as usize] == 3 {
                        let tns = TS[(p + 3) as usize]
                        let tne = TE[(p + 3) as usize]
                        if src_match(tns, tne - tns, "i64") { bind_ty = ty_i64; bind_conf = 1000 }
                        if src_match(tns, tne - tns, "f64") { bind_ty = ty_f64; bind_conf = 1000 }
                        if src_match(tns, tne - tns, "bool") { bind_ty = ty_bool; bind_conf = 1000 }
                        if src_match(tns, tne - tns, "string") { bind_ty = ty_string; bind_conf = 1000 }
                    }
                    // Skip past type annotation to find '=' — use scan_type to handle generics
                    scan_type(p + 3)
                    anno_end = SCAN_TY_NEXT
                }
                // Scan forward to find '=' and RHS expression
                var eq_pos: i64 = anno_end
                if eq_pos < p + 2 { eq_pos = p + 2 }
                while eq_pos < TC && TK[eq_pos as usize] != 16 && TK[eq_pos as usize] != 8 && TK[eq_pos as usize] != 0 {
                    eq_pos = eq_pos + 1
                }
                if eq_pos < TC && TK[eq_pos as usize] == 16 {
                    // Found '=' — look at RHS token for confidence
                    let rhs = eq_pos + 1
                    if rhs < TC {
                        let rhs_tk = TK[rhs as usize]
                        var rhs_conf: i64 = 0
                        var rhs_ty: i64 = ty_unknown
                        // Literal RHS
                        if rhs_tk == 4 { rhs_ty = ty_i64; rhs_conf = 1000 }
                        if rhs_tk == 53 { rhs_ty = ty_f64; rhs_conf = 1000 }
                        if rhs_tk == 5 { rhs_ty = ty_string; rhs_conf = 1000 }
                        if rhs_tk == 35 || rhs_tk == 36 { rhs_ty = ty_bool; rhs_conf = 1000 }
                        // Negated literal: -42 or -1.0
                        if rhs_tk == 18 && rhs + 1 < TC {
                            let nlk = TK[(rhs + 1) as usize]
                            if nlk == 4 { rhs_ty = ty_i64; rhs_conf = 1000 }
                            else if nlk == 53 { rhs_ty = ty_f64; rhs_conf = 1000 }
                        }
                        // Struct literal RHS: StructName { ... }
                        if rhs_tk == 3 && rhs + 1 < TC && TK[(rhs + 1) as usize] == 8 {
                            let slh = gl_name_hash(TS[rhs as usize], TE[rhs as usize])
                            if st_find(slh) >= 0 { rhs_ty = ty_void; rhs_conf = 1000 }
                        }
                        // Function call RHS: ident( — already inferred by left-to-right walk?
                        // No — we haven't visited RHS yet. But if RHS is a function call,
                        // we can look up the function's return type directly.
                        if rhs_tk == 3 && rhs + 1 < TC && TK[(rhs + 1) as usize] == 6 {
                            // RHS is a function call — look up return type
                            let rns = TS[rhs as usize]
                            let rne = TE[rhs as usize]
                            var rfj: i64 = 0
                            while rfj < FN_COUNT {
                                if name_eq(FN_NS[rfj as usize], FN_NE[rfj as usize], rns, rne) {
                                    rhs_ty = ety_from_tnk(FN_RET_TY[rfj as usize])
                                    rhs_conf = FN_EFF_CONF[rfj as usize]
                                    if rhs_ty == 0 { rhs_conf = 0 }
                                    // Gen 13: dual-channel — propagate measurement quality
                                    // from constructor call to the binding being created
                                    let g13_rns = FN_NS[rfj as usize]
                                    let g13_rlen = FN_NE[rfj as usize] - g13_rns
                                    if src_match(g13_rns, g13_rlen, "measured") { bind_meas_conf = 990 }
                                    if src_match(g13_rns, g13_rlen, "asserted") { bind_meas_conf = 970 }
                                    if src_match(g13_rns, g13_rlen, "constant") { bind_meas_conf = 1000 }
                                    break
                                }
                                rfj = rfj + 1
                            }
                            if rfj == FN_COUNT {
                                let rlen = rne - rns
                                if src_match(rns, rlen, "measure") || src_match(rns, rlen, "measured") {
                                    var m_conf: i64 = 990
                                    var mq: i64 = rhs + 2
                                    var m_val_tok: i64 = -1
                                    var m_unc_tok: i64 = -1
                                    var depth: i64 = 1
                                    while mq < TC && depth > 0 {
                                        if TK[mq as usize] == 6 { depth = depth + 1 }
                                        if TK[mq as usize] == 7 { depth = depth - 1 }
                                        if depth > 0 && (TK[mq as usize] == 53 || TK[mq as usize] == 4) {
                                            if m_val_tok < 0 { m_val_tok = mq }
                                            else if m_unc_tok < 0 { m_unc_tok = mq }
                                        }
                                        mq = mq + 1
                                    }
                                    if m_val_tok >= 0 && m_unc_tok >= 0 {
                                        let eps_scaled = infer_measure_eps_scaled(m_val_tok, m_unc_tok)
                                        if eps_scaled >= 0 {
                                            m_conf = 1000 - (eps_scaled / 1000)
                                            if m_conf < 0 { m_conf = 0 }
                                        }
                                    }
                                    rhs_ty = ety_mk_knowledge(2, m_conf, 0)
                                    rhs_conf = m_conf
                                    bind_meas_conf = m_conf
                                } else if src_match(rns, rlen, "asserted") {
                                    rhs_ty = ety_mk_knowledge(2, 970, 0)
                                    rhs_conf = 970
                                    bind_meas_conf = 970
                                } else if src_match(rns, rlen, "constant") {
                                    rhs_ty = ety_mk_knowledge(2, 1000, 0)
                                    rhs_conf = 1000
                                    bind_meas_conf = 1000
                                } else {
                                    rhs_ty = ty_i64
                                    rhs_conf = 1000
                                }
                            }
                        }
                        // Gen 11: Paren expression RHS — arithmetic/cast, always certain
                        if rhs_tk == 6 { rhs_ty = ty_i64; rhs_conf = 1000 }
                        // Gen 11: if-expression RHS — always evaluates to a value, always certain
                        if rhs_tk == 13 { rhs_ty = ty_i64; rhs_conf = 1000 }
                        // Gen 11: Reference RHS (&T or &!T) — confident
                        if rhs_tk == 44 { rhs_ty = ty_i64; rhs_conf = 1000 }
                        // Gen 11: unary NOT RHS (let x = !y) — look through ! to get operand confidence
                        if rhs_tk == 32 && rhs + 1 < TC && TK[(rhs + 1) as usize] == 3 {
                            let nrh = gl_name_hash(TS[(rhs + 1) as usize], TE[(rhs + 1) as usize])
                            let nri = escope_find(nrh)
                            if nri >= 0 && ESCOPE_CONF[nri as usize] >= GATE_THRESHOLD {
                                rhs_ty = ty_bool; rhs_conf = ESCOPE_CONF[nri as usize]
                            } else if gl_find(TS[(rhs + 1) as usize], TE[(rhs + 1) as usize]) >= 0 {
                                rhs_ty = ty_bool; rhs_conf = 1000
                            }
                        }
                        // Gen 11: Built-in function call fallback — ident( not in FN_NAME
                        if rhs_tk == 3 && rhs_conf == 0 && rhs + 1 < TC && TK[(rhs + 1) as usize] == 6 {
                            rhs_ty = ty_i64; rhs_conf = 1000
                        }
                        // Array index RHS: arr[idx] — look up array in globals/scope
                        if rhs_tk == 3 && rhs + 1 < TC && TK[(rhs + 1) as usize] == 41 {
                            let arh = gl_name_hash(TS[rhs as usize], TE[rhs as usize])
                            let agi = gl_find(TS[rhs as usize], TE[rhs as usize])
                            if agi >= 0 {
                                rhs_ty = ty_i64
                                rhs_conf = 1000
                            } else {
                                let avri = escope_find(arh)
                                if avri >= 0 { rhs_ty = ESCOPE_TY[avri as usize]; rhs_conf = ESCOPE_CONF[avri as usize] }
                            }
                        }
                        // Variable RHS: look up in scope
                        if rhs_tk == 3 && (rhs + 1 >= TC || (TK[(rhs + 1) as usize] != 6 && TK[(rhs + 1) as usize] != 41 && TK[(rhs + 1) as usize] != 8)) {
                            let vrh = gl_name_hash(TS[rhs as usize], TE[rhs as usize])
                            let vri = escope_find(vrh)
                            if vri >= 0 {
                                rhs_ty = ESCOPE_TY[vri as usize]
                                rhs_conf = ESCOPE_CONF[vri as usize]
                            } else {
                                // Not in local scope — check if it's a known global
                                let gvi = gl_find(TS[rhs as usize], TE[rhs as usize])
                                if gvi >= 0 { rhs_ty = ty_i64; rhs_conf = 1000 }
                            }
                        }
                        // GUM: if we have both annotation AND RHS, unify
                        if bind_conf > 0 && rhs_conf > 0 {
                            let ut = ety_unify(bind_ty, bind_conf, rhs_ty, rhs_conf)
                            bind_ty = ut
                            bind_conf = EUNIFY_CONF
                        } else if rhs_conf > 0 {
                            // No annotation but RHS is known → inherit
                            bind_ty = rhs_ty
                            bind_conf = rhs_conf
                        }
                        // If annotation gives type but RHS is unknown, keep annotation
                    }
                }
                escope_add(nh, bind_ty, bind_conf)
                // Gen 13: store measurement quality in parallel ESCOPE channel
                if bind_meas_conf > 0 && ESCOPE_COUNT > 0 {
                    ESCOPE_MEAS[(ESCOPE_COUNT - 1) as usize] = bind_meas_conf
                }
            }
            p = p + 1
            continue
        }

        // Identifier → variable lookup OR function call
        if tk == 3 {
            // Field access identifier (preceded by '.')
            if p > 0 && TK[(p - 1) as usize] == 14 {
                EXPR_ETY[p as usize] = EXPR_ETY[(p - 1) as usize]
                EXPR_CONF[p as usize] = EXPR_CONF[(p - 1) as usize]
                EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
                if EXPR_CONF[p as usize] >= GATE_THRESHOLD {
                    EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
                } else {
                    EPIST_LOW_CONF = EPIST_LOW_CONF + 1
                }
                p = p + 1
                continue
            }

            let ins = TS[p as usize]
            let ine = TE[p as usize]
            let ih = gl_name_hash(ins, ine)

            // Identifier immediately before ':' — struct field name or parameter name.
            // Always confident (syntactic position, not an expression).
            if p + 1 < TC && TK[(p + 1) as usize] == 43 {
                EXPR_ETY[p as usize] = ty_void
                EXPR_CONF[p as usize] = 1000
                EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
                p = p + 1
                continue
            }

            // Detect function call: ident followed by '('
            if p + 1 < TC && TK[(p + 1) as usize] == 6 {
                // Function call — look up in FN_* tables
                var call_fi: i64 = -1
                var fj: i64 = 0
                while fj < FN_COUNT {
                    if name_eq(FN_NS[fj as usize], FN_NE[fj as usize], ins, ine) {
                        call_fi = fj
                        break
                    }
                    fj = fj + 1
                }
                if call_fi >= 0 {
                    // Known function — return type from FN_RET_TY
                    let ret_ety = ety_from_tnk(FN_RET_TY[call_fi as usize])
                    // Scan args inside parens to accumulate GUM confidence
                    var arg_conf: i64 = 1000
                    var q: i64 = p + 2
                    var paren_depth: i64 = 1
                    while q < TC && paren_depth > 0 {
                        if TK[q as usize] == 6 { paren_depth = paren_depth + 1 }
                        if TK[q as usize] == 7 { paren_depth = paren_depth - 1; if paren_depth == 0 { break } }
                        let qtk = TK[q as usize]
                        // Skip commas and delimiters
                        if qtk == 28 || qtk == 27 { q = q + 1; continue }
                        // Literal args: confidence 1000
                        if qtk == 4 || qtk == 53 || qtk == 5 || qtk == 35 || qtk == 36 {
                            arg_conf = ety_conf_product(arg_conf, 1000)
                        } else if qtk == 3 {
                            // Identifier arg — check if it's a nested call
                            if q + 1 < TC && TK[(q + 1) as usize] == 6 {
                                // Nested function call: look up callee return type.
                                // Builtin measure()/measured() is not in FN_*; handle it here so
                                // calls like f(measure(10.0, uncertainty: 5.0)) keep the source
                                // confidence instead of falling back to 1000.
                                let nns = TS[q as usize]
                                let nne = TE[q as usize]
                                var nfj: i64 = 0
                                var nested_conf: i64 = 0
                                while nfj < FN_COUNT {
                                    if name_eq(FN_NS[nfj as usize], FN_NE[nfj as usize], nns, nne) {
                                        let nret = ety_from_tnk(FN_RET_TY[nfj as usize])
                                        if nret != 0 {
                                            nested_conf = FN_EFF_CONF[nfj as usize]
                                        }
                                        break
                                    }
                                    nfj = nfj + 1
                                }
                                if nested_conf == 0 && (src_match(nns, nne - nns, "measure") || src_match(nns, nne - nns, "measured")) {
                                    nested_conf = 990
                                    var nmq: i64 = q + 2
                                    var nm_val_tok: i64 = -1
                                    var nm_unc_tok: i64 = -1
                                    var nm_depth: i64 = 1
                                    while nmq < TC && nm_depth > 0 {
                                        if TK[nmq as usize] == 6 { nm_depth = nm_depth + 1 }
                                        if TK[nmq as usize] == 7 { nm_depth = nm_depth - 1 }
                                        if nm_depth > 0 && (TK[nmq as usize] == 53 || TK[nmq as usize] == 4) {
                                            if nm_val_tok < 0 { nm_val_tok = nmq }
                                            else if nm_unc_tok < 0 { nm_unc_tok = nmq }
                                        }
                                        nmq = nmq + 1
                                    }
                                    if nm_val_tok >= 0 && nm_unc_tok >= 0 {
                                        let nm_eps_scaled = infer_measure_eps_scaled(nm_val_tok, nm_unc_tok)
                                        if nm_eps_scaled >= 0 {
                                            nested_conf = 1000 - (nm_eps_scaled / 1000)
                                            if nested_conf < 0 { nested_conf = 0 }
                                        }
                                    }
                                }
                                // Gen 11: nested call not in FN_NAME → built-in fallback
                                if nested_conf == 0 { nested_conf = 1000 }
                                arg_conf = ety_conf_product(arg_conf, nested_conf)
                                // Skip past the nested call's parens
                                q = q + 2
                                var nd: i64 = 1
                                while q < TC && nd > 0 {
                                    if TK[q as usize] == 6 { nd = nd + 1 }
                                    if TK[q as usize] == 7 { nd = nd - 1 }
                                    if nd > 0 { q = q + 1 }
                                }
                                if q < TC && TK[q as usize] == 7 { q = q + 1 }
                                continue
                            }
                            // Plain identifier arg: look up scope
                            let aqh = gl_name_hash(TS[q as usize], TE[q as usize])
                            let asi = escope_find(aqh)
                            if asi >= 0 {
                                arg_conf = ety_conf_product(arg_conf, ESCOPE_CONF[asi as usize])
                            } else {
                                // Check if it's a known global var (by hash)
                                let gqh = gl_name_hash(TS[q as usize], TE[q as usize])
                                let gqi = gl_find(TS[q as usize], TE[q as usize])
                                if gqi >= 0 {
                                    // Known global — typed, confidence 1000
                                    arg_conf = ety_conf_product(arg_conf, 1000)
                                } else {
                                    arg_conf = 0
                                }
                            }
                        }
                        q = q + 1
                    }
                    // Final call confidence = args × effect confidence
                    var call_conf: i64 = ety_conf_product(arg_conf, FN_EFF_CONF[call_fi as usize])
                    var call_cmin: i64 = FN_EPISTEMIC_MIN[call_fi as usize]
                    if call_cmin > 0 && call_conf > 0 && call_conf < call_cmin {
                        print("error[E214]: confidence gate violation at line ")
                        print_int(TL[p as usize])
                        print(": args confidence ")
                        print_int(call_conf)
                        print(" < minconf ")
                        print_int(call_cmin)
                        print("\n")
                        EPIST_EFFECT_VIOLATIONS = EPIST_EFFECT_VIOLATIONS + 1
                    }
                    if ret_ety == 0 { call_conf = 0 }
                    EXPR_ETY[p as usize] = ret_ety
                    EXPR_CONF[p as usize] = call_conf
                    // Gen 11: tag closing ')' so binary operators comparing this result work
                    // q is already at the ')' position after the arg-scanning loop above
                    if q < TC && TK[q as usize] == 7 { EXPR_CONF[q as usize] = call_conf }
                    // Gen 13: dual-channel — tag MEAS_CONF at constructor call sites
                    let g13_cfns = FN_NS[call_fi as usize]
                    let g13_cflen = FN_NE[call_fi as usize] - g13_cfns
                    if src_match(g13_cfns, g13_cflen, "measured") { MEAS_CONF[p as usize] = 990 }
                    if src_match(g13_cfns, g13_cflen, "asserted") { MEAS_CONF[p as usize] = 970 }
                    if src_match(g13_cfns, g13_cflen, "constant") { MEAS_CONF[p as usize] = 1000 }
                    // Gen 17 D1: belief/plausibility interval at constructor sites
                    if src_match(g13_cfns, g13_cflen, "measured") {
                        EXPR_BELIEF[p as usize] = 985; EXPR_PLAUS[p as usize] = 995
                    }
                    if src_match(g13_cfns, g13_cflen, "asserted") {
                        EXPR_BELIEF[p as usize] = 960; EXPR_PLAUS[p as usize] = 980
                    }
                    if src_match(g13_cfns, g13_cflen, "constant") {
                        EXPR_BELIEF[p as usize] = 1000; EXPR_PLAUS[p as usize] = 1000
                    }
                    // For all other calls: belief = plaus = call_conf (no Knightian gap)
                    if EXPR_BELIEF[p as usize] == 0 && call_conf > 0 {
                        EXPR_BELIEF[p as usize] = call_conf
                        EXPR_PLAUS[p as usize]  = call_conf
                    }
                    // Gen 17 D3: Knowledge<T> ETY kind=7 at constructor call sites
                    // measured/asserted/constant return an Epistemic struct — tag as kind=7
                    var d3_is_know: i64 = 0
                    var d3_know_conf: i64 = 0
                    if src_match(g13_cfns, g13_cflen, "measured") { d3_is_know = 1; d3_know_conf = 990 }
                    if src_match(g13_cfns, g13_cflen, "asserted") { d3_is_know = 1; d3_know_conf = 970 }
                    if src_match(g13_cfns, g13_cflen, "constant") { d3_is_know = 1; d3_know_conf = 1000 }
                    if d3_is_know == 1 {
                        EXPR_ETY[p as usize] = ety_mk_knowledge(2, d3_know_conf, EXPR_UNIT_DIM)
                    }
                } else {
                    // Unknown function → must be a built-in (not in FN_NAME)
                    if src_match(ins, ine - ins, "measure") || src_match(ins, ine - ins, "measured") {
                        var m_conf: i64 = 990
                        var mq: i64 = p + 2
                        var m_val_tok: i64 = -1
                        var m_unc_tok: i64 = -1
                        var depth: i64 = 1
                        while mq < TC && depth > 0 {
                            if TK[mq as usize] == 6 { depth = depth + 1 }
                            if TK[mq as usize] == 7 { depth = depth - 1 }
                            if depth > 0 && (TK[mq as usize] == 53 || TK[mq as usize] == 4) {
                                if m_val_tok < 0 { m_val_tok = mq }
                                else if m_unc_tok < 0 { m_unc_tok = mq }
                            }
                            mq = mq + 1
                        }
                        if m_val_tok >= 0 && m_unc_tok >= 0 {
                            let eps_scaled = infer_measure_eps_scaled(m_val_tok, m_unc_tok)
                            if eps_scaled >= 0 {
                                m_conf = 1000 - (eps_scaled / 1000)
                                if m_conf < 0 { m_conf = 0 }
                            }
                        }
                        EXPR_ETY[p as usize] = ety_mk_knowledge(2, m_conf, EXPR_UNIT_DIM)
                        EXPR_CONF[p as usize] = m_conf
                        MEAS_CONF[p as usize] = m_conf
                        EXPR_BELIEF[p as usize] = m_conf
                        EXPR_PLAUS[p as usize] = m_conf
                        if q < TC && TK[q as usize] == 7 { EXPR_CONF[q as usize] = m_conf }
                    } else if src_match(ins, ine - ins, "Knowledge") {
                        // Knowledge(value, ε=eps, prov=..) — confidence is the
                        // static ε literal (Contribution 2: a low-ε prior lowers
                        // EXPR_CONF so `with Epistemic(N)` gates reject claims that
                        // over-state evidence). ε parsed BY NAME, not position
                        // (value is positional-first). No literal ε → stays 1000.
                        // [restored: dropped by a55cc97ff alongside the paren ctor]
                        var kconf: i64 = 1000
                        var saw_eps_key: i64 = 0
                        var eps_was_literal: i64 = 0
                        var kq: i64 = p + 2
                        var kdepth: i64 = 1
                        var kclose: i64 = 0 - 1
                        while kq < TC && kdepth > 0 {
                            if TK[kq as usize] == 6 { kdepth = kdepth + 1 }
                            if TK[kq as usize] == 7 {
                                kdepth = kdepth - 1
                                if kdepth == 0 { kclose = kq; break }
                            }
                            if kdepth > 0 && TK[kq as usize] == 3 {
                                var is_eps_key: i64 = 0
                                if tok_is_unicode_epsilon(kq) { is_eps_key = 1 }
                                if src_match(TS[kq as usize], TE[kq as usize] - TS[kq as usize], "epsilon") { is_eps_key = 1 }
                                if src_match(TS[kq as usize], TE[kq as usize] - TS[kq as usize], "confidence") { is_eps_key = 1 }
                                if is_eps_key == 1 && kq + 2 < TC && (TK[(kq + 1) as usize] == 16 || TK[(kq + 1) as usize] == 43) {
                                    saw_eps_key = 1
                                    let eps_val_tok = kq + 2
                                    let eps_after = kq + 3
                                    // Bare compile-time literal: a numeric token immediately
                                    // followed by a field terminator — ',' (28), ')' (7), or the
                                    // next field-key identifier (3, Style-B `ε: v  prov: …`).
                                    // NOT the head of an expression like `0.99 * runtime`, which
                                    // would launder high confidence through `*` (19).
                                    if (TK[eps_val_tok as usize] == 4 || TK[eps_val_tok as usize] == 53)
                                       && eps_after < TC
                                       && (TK[eps_after as usize] == 28 || TK[eps_after as usize] == 7 || TK[eps_after as usize] == 3) {
                                        let eps_scaled = tok_scaled_million(eps_val_tok)
                                        if eps_scaled >= 0 && eps_scaled <= 1000000 {
                                            kconf = eps_scaled / 1000
                                            eps_was_literal = 1
                                        }
                                    }
                                }
                            }
                            kq = kq + 1
                        }
                        // Soundness: ε declared but NOT a compile-time literal → its value is
                        // unprovable at compile time. Use 1 (positive, below any real gate min)
                        // so `with Epistemic(N)` REJECTS rather than laundering unknown/runtime
                        // confidence as certain. (No ε at all keeps the language's "asserted
                        // certain" 1000 default — matches the brace form.) A named-constant ε is
                        // conservatively treated as non-literal; const-folding is future work.
                        if saw_eps_key == 1 && eps_was_literal == 0 { kconf = 1 }
                        EXPR_ETY[p as usize] = ety_mk_knowledge(2, kconf, EXPR_UNIT_DIM)
                        EXPR_CONF[p as usize] = kconf
                        MEAS_CONF[p as usize] = kconf
                        EXPR_BELIEF[p as usize] = kconf
                        EXPR_PLAUS[p as usize] = kconf
                        if kclose >= 0 { EXPR_CONF[kclose as usize] = kconf }
                    } else if src_match(ins, ine - ins, "asserted") {
                        EXPR_ETY[p as usize] = ety_mk_knowledge(2, 970, EXPR_UNIT_DIM)
                        EXPR_CONF[p as usize] = 970
                        MEAS_CONF[p as usize] = 970
                        EXPR_BELIEF[p as usize] = 960
                        EXPR_PLAUS[p as usize] = 980
                        if q < TC && TK[q as usize] == 7 { EXPR_CONF[q as usize] = 970 }
                    } else if src_match(ins, ine - ins, "constant") {
                        EXPR_ETY[p as usize] = ety_mk_knowledge(2, 1000, EXPR_UNIT_DIM)
                        EXPR_CONF[p as usize] = 1000
                        MEAS_CONF[p as usize] = 1000
                        EXPR_BELIEF[p as usize] = 1000
                        EXPR_PLAUS[p as usize] = 1000
                        if q < TC && TK[q as usize] == 7 { EXPR_CONF[q as usize] = 1000 }
                    } else {
                        // Gen 11: assign confident — built-ins are always valid calls
                        EXPR_ETY[p as usize] = ty_i64
                        EXPR_CONF[p as usize] = 1000
                    }
                }
                EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
                if EXPR_CONF[p as usize] >= GATE_THRESHOLD {
                    EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
                } else {
                    EPIST_LOW_CONF = EPIST_LOW_CONF + 1
                }
                p = p + 1
                continue
            }

            // Not a call — variable lookup in epistemic scope
            let si = escope_find(ih)
            if si >= 0 {
                EXPR_ETY[p as usize] = ESCOPE_TY[si as usize]
                EXPR_CONF[p as usize] = ESCOPE_CONF[si as usize]
                // Gen 13: propagate measurement quality through variable reads
                MEAS_CONF[p as usize] = ESCOPE_MEAS[si as usize]
            } else {
                EXPR_ETY[p as usize] = ty_unknown
                EXPR_CONF[p as usize] = 0
            }
            EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
            if EXPR_CONF[p as usize] >= GATE_THRESHOLD {
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
            } else {
                EPIST_LOW_CONF = EPIST_LOW_CONF + 1
            }
            p = p + 1
            continue
        }

        // 'as' cast: propagate source confidence AND skip type target
        if tk == 37 {
            if p > 0 {
                EXPR_ETY[p as usize] = EXPR_ETY[(p - 1) as usize]
                EXPR_CONF[p as usize] = EXPR_CONF[(p - 1) as usize]
            } else {
                EXPR_ETY[p as usize] = ty_unknown
                EXPR_CONF[p as usize] = 0
            }
            EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
            if EXPR_CONF[p as usize] >= GATE_THRESHOLD {
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
            } else {
                EPIST_LOW_CONF = EPIST_LOW_CONF + 1
            }
            // Skip the type target (usize, i8, i64, etc.) — it's a type name, not a variable
            if p + 1 < TC && TK[(p + 1) as usize] == 3 {
                EXPR_ETY[(p + 1) as usize] = EXPR_ETY[p as usize]
                EXPR_CONF[(p + 1) as usize] = EXPR_CONF[p as usize]
                p = p + 2  // skip both 'as' and the type name
                continue
            }
            p = p + 1
            continue
        }

        // Type annotation positions: ':' followed by type name — mark as confident
        // These are declarations, not expressions
        if tk == 43 {
            // ':' — the next token(s) are a type, mark them
            if p + 1 < TC && TK[(p + 1) as usize] == 3 {
                EXPR_ETY[(p + 1) as usize] = ty_void
                EXPR_CONF[(p + 1) as usize] = 1000
            }
            p = p + 1
            continue
        }

        // Return type: '->' followed by type name
        if tk == 10 {
            if p + 1 < TC && TK[(p + 1) as usize] == 3 {
                EXPR_ETY[(p + 1) as usize] = ty_void
                EXPR_CONF[(p + 1) as usize] = 1000
            }
            p = p + 1
            continue
        }

        // Array index brackets: propagate confidence through indexing
        // '[' after an identifier/expression = array access
        if tk == 41 {
            // '[' — the base expression is at p-1 (already visited)
            if p > 0 {
                EXPR_ETY[p as usize] = EXPR_ETY[(p - 1) as usize]
                EXPR_CONF[p as usize] = EXPR_CONF[(p - 1) as usize]
            }
            p = p + 1
            continue
        }
        // ']' closing bracket: inherit confidence from matching '['
        if tk == 42 {
            if p > 0 {
                EXPR_ETY[p as usize] = EXPR_ETY[(p - 1) as usize]
                EXPR_CONF[p as usize] = EXPR_CONF[(p - 1) as usize]
            }
            p = p + 1
            continue
        }

        // Binary operators: GUM product propagation
        // +, -, *, /, ==, !=, <, >, <=, >=
        if tk == 17 || tk == 18 || tk == 19 || tk == 20 || tk == 21 || tk == 22 || tk == 23 || tk == 24 || tk == 25 || tk == 26 {
            // Look at left (p-1) and right (p+1) tokens for confidence
            var left_conf: i64 = 0
            var right_conf: i64 = 0
            var left_ty: i64 = ty_unknown
            var right_ty: i64 = ty_unknown
            if p > 0 {
                left_conf = EXPR_CONF[(p - 1) as usize]
                left_ty = EXPR_ETY[(p - 1) as usize]
            }
            if p + 1 < TC {
                // Right side not yet inferred — peek at token kind
                let rtk = TK[(p + 1) as usize]
                if rtk == 4 { right_ty = ty_i64; right_conf = 1000 }
                else if rtk == 53 { right_ty = ty_f64; right_conf = 1000 }
                else if rtk == 5 { right_ty = ty_string; right_conf = 1000 }
                else if rtk == 35 || rtk == 36 { right_ty = ty_bool; right_conf = 1000 }
                else if rtk == 3 {
                    // Look up right identifier
                    let rh = gl_name_hash(TS[(p + 1) as usize], TE[(p + 1) as usize])
                    let rsi = escope_find(rh)
                    if rsi >= 0 {
                        right_ty = ESCOPE_TY[rsi as usize]
                        right_conf = ESCOPE_CONF[rsi as usize]
                    }
                }
            }
            // GUM product: confidence of a OP b = product of confidences
            var op_conf: i64 = ety_conf_product(left_conf, right_conf)
            // For comparison ops, result is bool
            if tk == 21 || tk == 22 || tk == 23 || tk == 24 || tk == 25 || tk == 26 {
                EXPR_ETY[p as usize] = ty_bool
            } else {
                // Arithmetic: unify operand types (set op for kind=7 dim propagation)
                ETY_UNIFY_OP = tk
                let unified = ety_unify(left_ty, left_conf, right_ty, right_conf)
                ETY_UNIFY_OP = 0
                op_conf = ety_conf_product(op_conf, EUNIFY_CONF)
                EXPR_ETY[p as usize] = unified
            }
            EXPR_CONF[p as usize] = op_conf
            EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
            if op_conf >= GATE_THRESHOLD {
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
            } else {
                EPIST_LOW_CONF = EPIST_LOW_CONF + 1
            }
            p = p + 1
            continue
        }

        // All other tokens: not expressions
        EXPR_ETY[p as usize] = ty_void
        EXPR_CONF[p as usize] = 0
        p = p + 1
    }

    // Phase C: Compute confidence gates
    p = 0
    while p < TC {
        if EXPR_CONF[p as usize] >= GATE_THRESHOLD {
            EXPR_GATE[p as usize] = 0
        } else {
            EXPR_GATE[p as usize] = 1
        }
        p = p + 1
    }

    // Diagnostic: count uncertain tokens by kind
    var unc_idents: i64 = 0
    var unc_ops: i64 = 0
    var unc_other: i64 = 0
    p = 0
    while p < TC {
        if EXPR_CONF[p as usize] < GATE_THRESHOLD && EXPR_CONF[p as usize] >= 0 {
            let utk = TK[p as usize]
            if utk == 3 { unc_idents = unc_idents + 1 }
            else if utk >= 17 && utk <= 26 { unc_ops = unc_ops + 1 }
            else { unc_other = unc_other + 1 }
        }
        p = p + 1
    }

    // Phase D: Iterative refinement — loop until fixed point
    // Each pass re-evaluates uncertain idents using populated scope/globals/fns.
    // Also: upgrade uncertain operators whose operands became confident.
    var total_refined: i64 = 0
    var refine_pass: i64 = 0
    var refine_changed: i64 = 1
    while refine_changed > 0 && refine_pass < 7 {
        refine_changed = 0
        p = 0
        while p < TC {
            if EXPR_CONF[p as usize] < GATE_THRESHOLD {
                let rtk = TK[p as usize]
                if rtk == 3 {
                    // Uncertain ident — try resolving
                    let rns = TS[p as usize]
                    let rne = TE[p as usize]
                    let rh = gl_name_hash(rns, rne)
                    let rsi = escope_find(rh)
                    if rsi >= 0 && ESCOPE_CONF[rsi as usize] >= GATE_THRESHOLD {
                        EXPR_ETY[p as usize] = ESCOPE_TY[rsi as usize]
                        EXPR_CONF[p as usize] = ESCOPE_CONF[rsi as usize]
                        refine_changed = refine_changed + 1
                    } else {
                        let rgi = gl_find(rns, rne)
                        if rgi >= 0 {
                            EXPR_ETY[p as usize] = ty_i64
                            EXPR_CONF[p as usize] = 1000
                            refine_changed = refine_changed + 1
                        } else {
                            if !(p + 1 < TC && TK[(p + 1) as usize] == 6) {
                                var rfj: i64 = 0
                                while rfj < FN_COUNT {
                                    if name_eq(FN_NS[rfj as usize], FN_NE[rfj as usize], rns, rne) {
                                        EXPR_ETY[p as usize] = ety_from_tnk(FN_RET_TY[rfj as usize])
                                        EXPR_CONF[p as usize] = FN_EFF_CONF[rfj as usize]  // Gen 16 Track A: propagate actual effect conf
                                        refine_changed = refine_changed + 1
                                        break
                                    }
                                    rfj = rfj + 1
                                }
                            }
                            // Try struct name table
                            if EXPR_CONF[p as usize] < GATE_THRESHOLD {
                                if st_find(rh) >= 0 || en_find(rh) >= 0 {
                                    EXPR_ETY[p as usize] = ty_void
                                    EXPR_CONF[p as usize] = 1000
                                    refine_changed = refine_changed + 1
                                }
                            }
                            // Gen 10: generic call site — IDENT < TYPE > ( or IDENT :: < TYPE > (
                            // call_tok in compile_expr is the '>' position for generic calls,
                            // so we update EXPR_CONF there too to clear the epistemic gate.
                            if EXPR_CONF[p as usize] < GATE_THRESHOLD {
                                var g10_found: i64 = 0
                                var g10_call_tok: i64 = p
                                var g10_tys: i64 = 0
                                var g10_tye: i64 = 0
                                if p + 4 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 2) as usize] == 3 && TK[(p + 3) as usize] == 24 && TK[(p + 4) as usize] == 6 {
                                    g10_tys = TS[(p + 2) as usize]
                                    g10_tye = TE[(p + 2) as usize]
                                    g10_call_tok = p + 3
                                    g10_found = 1
                                }
                                if g10_found == 0 && p + 5 < TC && TK[(p + 1) as usize] == 51 && TK[(p + 2) as usize] == 23 && TK[(p + 3) as usize] == 3 && TK[(p + 4) as usize] == 24 && TK[(p + 5) as usize] == 6 {
                                    g10_tys = TS[(p + 3) as usize]
                                    g10_tye = TE[(p + 3) as usize]
                                    g10_call_tok = p + 4
                                    g10_found = 1
                                }
                                if g10_found == 1 {
                                    var g10_gi: i64 = 0
                                    while g10_gi < GEN_FN_COUNT {
                                        if name_eq(GEN_FN_NS[g10_gi as usize], GEN_FN_NE[g10_gi as usize], rns, rne) {
                                            let g10_mi = mono_find_inst(g10_gi, 0, g10_tys, g10_tye)
                                            if g10_mi >= 0 {
                                                var g10_fj: i64 = 0
                                                while g10_fj < FN_COUNT {
                                                    if name_eq(FN_NS[g10_fj as usize], FN_NE[g10_fj as usize], MAN_BUF_S[g10_mi as usize], MAN_BUF_E[g10_mi as usize]) {
                                                        EXPR_CONF[p as usize] = FN_EFF_CONF[g10_fj as usize]
                                                        EXPR_CONF[g10_call_tok as usize] = FN_EFF_CONF[g10_fj as usize]
                                                        EXPR_ETY[p as usize] = ety_from_tnk(FN_RET_TY[g10_fj as usize])
                                                        refine_changed = refine_changed + 1
                                                        g10_fj = FN_COUNT
                                                    }
                                                    g10_fj = g10_fj + 1
                                                }
                                            }
                                            g10_gi = GEN_FN_COUNT
                                        }
                                        g10_gi = g10_gi + 1
                                    }
                                }
                            }
                        }
                    }
                } else if rtk >= 17 && rtk <= 26 {
                    // Uncertain operator — check if both operands are now confident
                    if p > 0 && p + 1 < TC {
                        let lc = EXPR_CONF[(p - 1) as usize]
                        let rc = EXPR_CONF[(p + 1) as usize]
                        if lc >= GATE_THRESHOLD && rc >= GATE_THRESHOLD {
                            // Gen 11: use min(lc, rc) not ety_conf_product
                            // ety_conf_product(950,950)=902 < GATE_THRESHOLD
                            var lrc_min: i64 = lc
                            if rc < lrc_min { lrc_min = rc }
                            EXPR_CONF[p as usize] = lrc_min
                            refine_changed = refine_changed + 1
                        }
                    }
                }
            }
            p = p + 1
        }
        // Re-evaluate uncertain let/var ESCOPE entries using now-confident RHS EXPR_CONF.
        // This breaks the cascade: if variable X was bound to a struct/fn-call whose
        // EXPR_CONF is now >= threshold, upgrade X's ESCOPE entry so uses of X resolve.
        var lp: i64 = 0
        while lp < TC {
            if TK[lp as usize] == 11 || TK[lp as usize] == 12 {
                if lp + 1 < TC && TK[(lp + 1) as usize] == 3 {
                    let lnh = gl_name_hash(TS[(lp + 1) as usize], TE[(lp + 1) as usize])
                    let lsi = escope_find(lnh)
                    if lsi >= 0 && ESCOPE_CONF[lsi as usize] < GATE_THRESHOLD {
                        // Find '=' — skip type annotation via scan_type if present
                        var leq: i64 = lp + 2
                        if leq < TC && TK[leq as usize] == 43 {
                            scan_type(lp + 3)
                            leq = SCAN_TY_NEXT
                        }
                        while leq < TC && TK[leq as usize] != 16 && TK[leq as usize] != 8 && TK[leq as usize] != 0 {
                            leq = leq + 1
                        }
                        if leq < TC && TK[leq as usize] == 16 {
                            let lrhs = leq + 1
                            if lrhs < TC && EXPR_CONF[lrhs as usize] >= GATE_THRESHOLD {
                                ESCOPE_CONF[lsi as usize] = EXPR_CONF[lrhs as usize]
                                ESCOPE_TY[lsi as usize] = EXPR_ETY[lrhs as usize]
                                refine_changed = refine_changed + 1
                            }
                        }
                    }
                }
            }
            lp = lp + 1
        }
        total_refined = total_refined + refine_changed
        refine_pass = refine_pass + 1
    }
    // Gen 11: Post-Phase-D operator cleanup — two sweeps.
    // Sweep 1: unary minus/plus in unary position (prev not expression-end).
    //   These operators have only one operand (the right); upgrade using only EXPR_CONF[p+1].
    //   Handles: `eps_scaled < -1` where `-1` is unary and `-` needs upgrading first.
    p = 0
    while p < TC {
        if EXPR_CONF[p as usize] < GATE_THRESHOLD {
            let g11_utk = TK[p as usize]
            if g11_utk == 18 || g11_utk == 17 {
                // Check if in unary position: prev token is not an expression-ending token
                var g11_prev_is_expr: i64 = 0
                if p > 0 {
                    let g11_ptk = TK[(p - 1) as usize]
                    // Expression-ending tokens: ident(3), int(4), str(5), float(53), ')' (7), '}' (9)
                    if g11_ptk == 3 || g11_ptk == 4 || g11_ptk == 5 || g11_ptk == 53 || g11_ptk == 7 || g11_ptk == 9 {
                        g11_prev_is_expr = 1
                    }
                }
                if g11_prev_is_expr == 0 && p + 1 < TC {
                    let g11_rc = EXPR_CONF[(p + 1) as usize]
                    if g11_rc >= GATE_THRESHOLD { EXPR_CONF[p as usize] = g11_rc }
                }
            }
        }
        p = p + 1
    }
    // Sweep 2: binary operators whose both operands are now confident.
    // NOTE: use min(lc, rc), not ety_conf_product — product of two 950-conf
    // values = 902 which is below GATE_THRESHOLD.
    // Gen 13: also propagate MEAS_CONF through operators (GUM min-rule).
    p = 0
    while p < TC {
        if EXPR_CONF[p as usize] < GATE_THRESHOLD {
            let g11_ctk = TK[p as usize]
            if g11_ctk >= 17 && g11_ctk <= 26 {
                if p > 0 && p + 1 < TC {
                    let g11_lc = EXPR_CONF[(p - 1) as usize]
                    let g11_rc = EXPR_CONF[(p + 1) as usize]
                    if g11_lc >= GATE_THRESHOLD && g11_rc >= GATE_THRESHOLD {
                        var g11_min: i64 = g11_lc
                        if g11_rc < g11_min { g11_min = g11_rc }
                        EXPR_CONF[p as usize] = g11_min
                    }
                }
            }
        }
        // Gen 13: propagate MEAS_CONF regardless of EXPR_CONF certainty.
        // If either operand is in the measurement channel, the operation is too.
        let g13_otk = TK[p as usize]
        if g13_otk >= 17 && g13_otk <= 26 && p > 0 && p + 1 < TC {
            if MEAS_CONF[p as usize] == 0 {
                let g13_lm = MEAS_CONF[(p - 1) as usize]
                let g13_rm = MEAS_CONF[(p + 1) as usize]
                if g13_lm > 0 || g13_rm > 0 {
                    // min of non-zero values (0 = "not measured", not "zero quality")
                    var g13_mm: i64 = g13_lm
                    if g13_rm > 0 {
                        if g13_mm == 0 || g13_rm < g13_mm { g13_mm = g13_rm }
                    }
                    MEAS_CONF[p as usize] = g13_mm
                }
            }
        }
        p = p + 1
    }

    // Gen 17 D1-C: Post-Phase-D belief/plausibility propagation.
    // For any token upgraded to confidence >= GATE_THRESHOLD by Phase D (not set by
    // Phase B constructor rules), set BELIEF = PLAUS = EXPR_CONF (zero Knightian gap).
    p = 0
    while p < TC {
        if EXPR_CONF[p as usize] >= GATE_THRESHOLD && EXPR_BELIEF[p as usize] == 0 {
            EXPR_BELIEF[p as usize] = EXPR_CONF[p as usize]
            EXPR_PLAUS[p as usize]  = EXPR_CONF[p as usize]
        }
        p = p + 1
    }

    // Gen 16 Track B: EpistemicComplete effect enforcement
    // Functions declaring `with Epistemic(N)` (bit 512 + explicit FN_EPISTEMIC_MIN > 0) must
    // have all expression tokens in their body with confidence >= N.
    // Plain `with Epistemic` (no N, FN_EPISTEMIC_MIN == 0) is an effect tag only — no gate.
    var ec_fi: i64 = 0
    while ec_fi < FN_COUNT {
        if (FN_EFFECTS[ec_fi as usize] & 512) != 0 && FN_EPISTEMIC_MIN[ec_fi as usize] > 0 {
            // Locate function body: scan from name token forward for first '{'
            let ec_name_tok = FN_NAME_TOK[ec_fi as usize]
            var ec_tp: i64 = ec_name_tok
            var ec_body_start: i64 = 0 - 1
            while ec_tp < TC && ec_body_start < 0 {
                if TK[ec_tp as usize] == 8 { ec_body_start = ec_tp }
                ec_tp = ec_tp + 1
            }
            if ec_body_start >= 0 {
                // Walk body tracking brace depth; flag uncertain expression tokens
                var ec_depth: i64 = 1
                var ec_bp: i64 = ec_body_start + 1
                while ec_bp < TC && ec_depth > 0 {
                    let ec_btk = TK[ec_bp as usize]
                    if ec_btk == 8 { ec_depth = ec_depth + 1 }
                    if ec_btk == 9 { ec_depth = ec_depth - 1 }
                    if ec_depth > 0 {
                        // Check: is this token an expression with non-zero uncertain confidence?
                        var ec_is_expr: i64 = 0
                        if ec_btk == 3 || ec_btk == 4 || ec_btk == 5 || ec_btk == 53 { ec_is_expr = 1 }
                        if ec_btk == 35 || ec_btk == 36 { ec_is_expr = 1 }
                        if ec_btk >= 17 && ec_btk <= 26 { ec_is_expr = 1 }
                        if ec_is_expr == 1 {
                            let ec_conf = EXPR_CONF[ec_bp as usize]
                            let ec_min: i64 = FN_EPISTEMIC_MIN[ec_fi as usize]
                            if ec_conf > 0 && ec_conf < ec_min {
                                EPIST_EFFECT_VIOLATIONS = EPIST_EFFECT_VIOLATIONS + 1
                                print("error[E215]: EpistemicComplete violation in fn ")
                                var ec_np: i64 = FN_NS[ec_fi as usize]
                                while ec_np < FN_NE[ec_fi as usize] {
                                    print_char(SRC[ec_np as usize] as i64)
                                    ec_np = ec_np + 1
                                }
                                // Gen 21 Phase B′: report the source line and the token's
                                // actual text so the diagnostic is debuggable in dissertation
                                // stdlib code, not just "pos 12345".
                                print(" at line ")
                                print_int(TL[ec_bp as usize])
                                print(": `")
                                var ec_sp: i64 = TS[ec_bp as usize]
                                let ec_se: i64 = TE[ec_bp as usize]
                                while ec_sp < ec_se {
                                    print_char(SRC[ec_sp as usize] as i64)
                                    ec_sp = ec_sp + 1
                                }
                                print("` (conf=")
                                print_int(ec_conf)
                                print(" < ")
                                print_int(ec_min)
                                print(")\n")
                            }
                        }
                    }
                    ec_bp = ec_bp + 1
                }
            }
        }
        ec_fi = ec_fi + 1
    }
    if EPIST_EFFECT_VIOLATIONS > 0 {
        print("error: ")
        print_int(EPIST_EFFECT_VIOLATIONS)
        print(" EpistemicComplete violation(s) — `with Epistemic` requires 100% body confidence\n")
    }

    // Recount after refinement — only count tokens that are expressions
    EPIST_TOTAL_EXPR = 0
    EPIST_HIGH_CONF = 0
    EPIST_LOW_CONF = 0
    p = 0
    while p < TC {
        let ctk = TK[p as usize]
        // Count as expression: literals, idents, operators, booleans, Some/None/Ok/Err
        var is_expr: i64 = 0
        if ctk == 3 || ctk == 4 || ctk == 5 || ctk == 53 { is_expr = 1 }
        if ctk == 35 || ctk == 36 { is_expr = 1 }
        if ctk >= 17 && ctk <= 26 { is_expr = 1 }
        if ctk == 37 { is_expr = 1 }
        if ctk == 57 || ctk == 58 || ctk == 59 || ctk == 60 { is_expr = 1 }
        if is_expr == 1 {
            EPIST_TOTAL_EXPR = EPIST_TOTAL_EXPR + 1
            if EXPR_CONF[p as usize] >= GATE_THRESHOLD {
                EPIST_HIGH_CONF = EPIST_HIGH_CONF + 1
            } else {
                EPIST_LOW_CONF = EPIST_LOW_CONF + 1
            }
            // Gen 12: per-file split — main source vs imported modules
            if MAIN_SRC_END > 0 && TS[p as usize] < MAIN_SRC_END {
                EPIST_MAIN_TOTAL = EPIST_MAIN_TOTAL + 1
                if EXPR_CONF[p as usize] >= GATE_THRESHOLD {
                    EPIST_MAIN_HIGH = EPIST_MAIN_HIGH + 1
                }
            }
            // Gen 13: count tokens in measurement channel
            if MEAS_CONF[p as usize] > 0 { EPIST_MEAS_COUNT = EPIST_MEAS_COUNT + 1 }
            // Gen 14 (Track C): confidence tier distribution
            let tc14_c = EXPR_CONF[p as usize]
            if tc14_c == 1000 { EPIST_TIER_PLATINUM = EPIST_TIER_PLATINUM + 1 }
            if tc14_c >= 950 && tc14_c < 1000 { EPIST_TIER_GOLD = EPIST_TIER_GOLD + 1 }
            if tc14_c >= 800 && tc14_c < 950 { EPIST_TIER_SILVER = EPIST_TIER_SILVER + 1 }
            if tc14_c >= 500 && tc14_c < 800 { EPIST_TIER_BRONZE = EPIST_TIER_BRONZE + 1 }
        }
        p = p + 1
    }
    // Recompute gates after refinement
    p = 0
    while p < TC {
        if EXPR_CONF[p as usize] >= GATE_THRESHOLD {
            EXPR_GATE[p as usize] = 0
        } else {
            EXPR_GATE[p as usize] = 1
        }
        p = p + 1
    }
    if total_refined > 0 {
        print("refined: ")
        print_int(total_refined)
        print(" in ")
        print_int(refine_pass)
        print(" passes\n")
    }

    // Gen 12: Knowledge<T> (Epistemic) site scan
    // Count ident tokens whose name matches a known Epistemic constructor
    // ("measured", "asserted", "constant") to track Knowledge<T> usage.
    p = 0
    while p < TC {
        if TK[p as usize] == 3 && p + 1 < TC && TK[(p + 1) as usize] == 6 {
            let g12_ns = TS[p as usize]
            let g12_ne = TE[p as usize]
            let g12_len = g12_ne - g12_ns
            var g12_is_ktype: i64 = 0
            if src_match(g12_ns, g12_len, "measured") { g12_is_ktype = 1 }
            if src_match(g12_ns, g12_len, "asserted") { g12_is_ktype = 1 }
            if src_match(g12_ns, g12_len, "constant") { g12_is_ktype = 1 }
            if g12_is_ktype == 1 {
                EPIST_KTYPE_SITES = EPIST_KTYPE_SITES + 1
                if EXPR_CONF[p as usize] >= GATE_THRESHOLD {
                    EPIST_KTYPE_CERTAIN = EPIST_KTYPE_CERTAIN + 1
                }
            }
        }
        p = p + 1
    }

    // Diagnostic: categorize uncertain identifiers by prev token
    var unc_after_dot: i64 = 0
    var unc_after_decl: i64 = 0
    var unc_after_let: i64 = 0
    var unc_after_colon: i64 = 0
    var unc_other: i64 = 0
    p = 0
    while p < TC {
        if TK[p as usize] == 3 && EXPR_CONF[p as usize] < GATE_THRESHOLD {
            var prev_tk: i64 = 0
            if p > 0 { prev_tk = TK[(p - 1) as usize] }
            if prev_tk == 50 { unc_after_dot = unc_after_dot + 1 }
            else if prev_tk == 1 || prev_tk == 46 || prev_tk == 47 || prev_tk == 49 || prev_tk == 62 { unc_after_decl = unc_after_decl + 1 }
            else if prev_tk == 11 || prev_tk == 12 { unc_after_let = unc_after_let + 1 }
            else if prev_tk == 43 || prev_tk == 10 { unc_after_colon = unc_after_colon + 1 }
            else { unc_other = unc_other + 1; if unc_other <= 50 { print("  prev="); print_int(prev_tk); print(" L"); print_int(TL[p as usize]); print("\n") } }
        }
        p = p + 1
    }
    print("unc_detail: dot=")
    print_int(unc_after_dot)
    print(" decl=")
    print_int(unc_after_decl)
    print(" let=")
    print_int(unc_after_let)
    print(" colon=")
    print_int(unc_after_colon)
    print(" other=")
    print_int(unc_other)
    print("\n")

    // Report epistemic state
    print("epistemic: ")
    print_int(EPIST_TOTAL_EXPR)
    print(" expr, ")
    print_int(EPIST_HIGH_CONF)
    print(" certain (")
    if EPIST_TOTAL_EXPR > 0 {
        print_int((EPIST_HIGH_CONF * 100) / EPIST_TOTAL_EXPR)
    } else {
        print_int(0)
    }
    print("%), ")
    print_int(EPIST_LOW_CONF)
    print(" uncertain [ident=")
    print_int(unc_idents)
    print(" ops=")
    print_int(unc_ops)
    print(" other=")
    print_int(unc_other)
    print("], types=")
    print_int(ETY_COUNT)
    print(", gate=")
    print_int(GATE_THRESHOLD)
    print("/1000\n")
    // Gen 12: per-file epistemic stats
    if MAIN_SRC_END > 0 && EPIST_MAIN_TOTAL > 0 {
        print("epistemic_main: ")
        print_int(EPIST_MAIN_TOTAL)
        print(" expr, ")
        print_int(EPIST_MAIN_HIGH)
        print(" certain (")
        print_int((EPIST_MAIN_HIGH * 100) / EPIST_MAIN_TOTAL)
        print("%), ")
        print_int(EPIST_MAIN_TOTAL - EPIST_MAIN_HIGH)
        print(" uncertain\n")
    }
    // Gen 12: Knowledge<T> constructor sites
    if EPIST_KTYPE_SITES > 0 {
        print("epistemic_ktype: ")
        print_int(EPIST_KTYPE_SITES)
        print(" Knowledge<T> sites, ")
        print_int(EPIST_KTYPE_CERTAIN)
        print(" certain (")
        print_int((EPIST_KTYPE_CERTAIN * 100) / EPIST_KTYPE_SITES)
        print("%)\n")
    }
    // Gen 13: measurement channel stats
    if EPIST_MEAS_COUNT > 0 {
        print("epistemic_meas: ")
        print_int(EPIST_MEAS_COUNT)
        print(" tokens in measurement channel (meas_conf > 0)\n")
    }
    // Gen 17 D1-D: Knightian uncertainty diagnostics
    // Walk all tokens, count sites where BELIEF < PLAUS, sum gap.
    EPIST_KNIGHTIAN_SITES = 0
    EPIST_KNIGHTIAN_GAP   = 0
    var kp: i64 = 0
    while kp < TC {
        let kbel = EXPR_BELIEF[kp as usize]
        let kpla = EXPR_PLAUS[kp as usize]
        if kbel > 0 && kbel < kpla {
            EPIST_KNIGHTIAN_SITES = EPIST_KNIGHTIAN_SITES + 1
            EPIST_KNIGHTIAN_GAP   = EPIST_KNIGHTIAN_GAP + (kpla - kbel)
        }
        kp = kp + 1
    }
    print("knightian: ")
    print_int(EPIST_KNIGHTIAN_SITES)
    print(" sites, gap_sum=")
    print_int(EPIST_KNIGHTIAN_GAP)
    print("\n")

    // Gen 17 D3: Knowledge<T> subtype diagnostics
    // Scan let/var bindings where RHS has kind=7 ETY; check confidence subtyping.
    EPIST_KNOW_SUBTYPE_SITES = 0
    EPIST_KNOW_SUBTYPE_VIOLATIONS = 0
    var d3p: i64 = 0
    while d3p < TC {
        let d3tk = TK[d3p as usize]
        if (d3tk == 11 || d3tk == 12) && d3p + 1 < TC && TK[(d3p + 1) as usize] == 3 {
            // let/var binding — find '=' and check RHS ETY kind
            var d3eq: i64 = d3p + 2
            while d3eq < TC && TK[d3eq as usize] != 16 && TK[d3eq as usize] != 8 && TK[d3eq as usize] != 0 {
                d3eq = d3eq + 1
            }
            if d3eq < TC && TK[d3eq as usize] == 16 {
                let d3rhs = d3eq + 1
                if d3rhs < TC && ety_kind(EXPR_ETY[d3rhs as usize]) == 7 {
                    EPIST_KNOW_SUBTYPE_SITES = EPIST_KNOW_SUBTYPE_SITES + 1
                    // Check lhs is compatible (lhs name token at d3p+1)
                    let d3lhs_h = gl_name_hash(TS[(d3p + 1) as usize], TE[(d3p + 1) as usize])
                    let d3lhs_si = escope_find(d3lhs_h)
                    if d3lhs_si >= 0 {
                        let d3dst_ety = ESCOPE_TY[d3lhs_si as usize]
                        if ety_kind(d3dst_ety) == 7 {
                            if !ety_knowledge_subtype_ok(EXPR_ETY[d3rhs as usize], d3dst_ety) {
                                EPIST_KNOW_SUBTYPE_VIOLATIONS = EPIST_KNOW_SUBTYPE_VIOLATIONS + 1
                            }
                        }
                    }
                }
            }
        }
        d3p = d3p + 1
    }
    print("knowledge_subtype: ")
    print_int(EPIST_KNOW_SUBTYPE_SITES)
    print(" sites, ")
    print_int(EPIST_KNOW_SUBTYPE_VIOLATIONS)
    print(" violations\n")
    // Gen 19: Knowledge<T> + unit dim integration stat
    print("knowledge_units: ")
    print_int(KNOWLEDGE_UNITS_COUNT)
    print(" sites with dimensional Knowledge<T>\n")

    // Gen 14 (Track C): confidence tier distribution
    // Emitted when total > 0 (always for non-trivial programs)
    if EPIST_TOTAL_EXPR > 0 {
        print("tier_dist: PLATINUM=")
        print_int(EPIST_TIER_PLATINUM)
        print(" GOLD=")
        print_int(EPIST_TIER_GOLD)
        print(" SILVER=")
        print_int(EPIST_TIER_SILVER)
        print(" BRONZE=")
        print_int(EPIST_TIER_BRONZE)
        print(" [PLATINUM%=")
        print_int((EPIST_TIER_PLATINUM * 100) / EPIST_TOTAL_EXPR)
        print("%]\n")
    }
    // Gen 15 (Option B): --emit-econf — print function confidence certificate
    // Format: "fn <name> <conf>" per line, framed by econf_begin/econf_end markers.
    // Redirect stderr to capture: gen15.elf src.sio out.elf --emit-econf 2>src.econf
    // Load in subsequent compile:  gen15.elf src2.sio out2.elf --load-econf src.econf
    if CLI_EMIT_ECONF != 0 {
        print("econf_begin\n")
        var efi_out: i64 = 0
        while efi_out < FN_COUNT {
            let efo_ns = FN_NS[efi_out as usize]
            let efo_ne = FN_NE[efi_out as usize]
            let efo_conf = FN_EFF_CONF[efi_out as usize]
            if efo_ne > efo_ns && efo_conf > 0 {
                print("fn ")
                var efo_p: i64 = efo_ns
                while efo_p < efo_ne {
                    print_char(SRC[efo_p as usize] as i64)
                    efo_p = efo_p + 1
                }
                print(" ")
                print_int(efo_conf)
            }
            efi_out = efi_out + 1
        }
        print("econf_end\n")
    }
    // Gen 12: --dump-conf-json — print token-level confidence as JSON to stdout
    // Gen 13: adds "meas" field for measurement channel confidence
    if CLI_DUMP_CONF_JSON != 0 {
        print("{\"total\":")
        print_int(EPIST_TOTAL_EXPR)
        print(",\"certain\":")
        print_int(EPIST_HIGH_CONF)
        print(",\"meas_tokens\":")
        print_int(EPIST_MEAS_COUNT)
        print(",\"tokens\":[\n")
        var g12_first: i64 = 1
        var g12_tp: i64 = 0
        while g12_tp < TC {
            let g12_ctk = TK[g12_tp as usize]
            var g12_ie: i64 = 0
            if g12_ctk == 3 || g12_ctk == 4 || g12_ctk == 5 || g12_ctk == 53 { g12_ie = 1 }
            if g12_ctk == 35 || g12_ctk == 36 { g12_ie = 1 }
            if g12_ctk >= 17 && g12_ctk <= 26 { g12_ie = 1 }
            if g12_ctk == 37 { g12_ie = 1 }
            if g12_ctk == 57 || g12_ctk == 58 || g12_ctk == 59 || g12_ctk == 60 { g12_ie = 1 }
            if g12_ie == 1 {
                if g12_first == 0 { print(",\n") }
                g12_first = 0
                print("{\"p\":")
                print_int(g12_tp)
                print(",\"tk\":")
                print_int(g12_ctk)
                print(",\"conf\":")
                print_int(EXPR_CONF[g12_tp as usize])
                print(",\"meas\":")
                print_int(MEAS_CONF[g12_tp as usize])
                print(",\"line\":")
                print_int(TL[g12_tp as usize])
                print("}")
            }
            g12_tp = g12_tp + 1
        }
        print("\n]}\n")
    }
    // Gen 17 D6 / Gen 18: --emit-proof-obligations
    // Walk PLATINUM ident tokens, emit a Lake-buildable Lean 4 module to stdout.
    // Usage: gen17.elf src.sio out.elf --emit-proof-obligations 2>/dev/null \
    //          > formal/lean4/SounioProofObligation.lean
    // Verify: cd formal/lean4 && lake build SounioProofObligation
    if CLI_EMIT_PROOFS != 0 {
        // Lake module header — output is valid Lean 4 that lake build accepts directly
        print("-- SounioProofObligation.lean\n")
        print("-- Auto-generated by EGC --emit-proof-obligations\n")
        print("-- Each example goal witnesses a PLATINUM-confidence (conf=1000) identifier.\n")
        print("-- Verify: cd formal/lean4 && lake build SounioProofObligation\n")
        print("import SounioGradedModal\n")
        print("open SounioGradedModal\n")
        print("namespace SounioProofObligation\n\n")
        var d6p: i64 = 0
        var d6count: i64 = 0
        var d6limit: i64 = 2000  // cap at 2000 goals to avoid stdout flood
        while d6p < TC && d6count < d6limit {
            if TK[d6p as usize] == 3 && EXPR_CONF[d6p as usize] == 1000 {
                print("-- line ")
                print_int(TL[d6p as usize])
                print(": PLATINUM (conf=1000)\n")
                print("example : (1000 : Nat) >= GATE_THRESHOLD := by norm_num [GATE_THRESHOLD]\n")
                d6count = d6count + 1
            }
            d6p = d6p + 1
        }
        print("\nend SounioProofObligation\n")
        print("-- proof_obligations: ")
        print_int(d6count)
        print(" PLATINUM goals\n")
    }

    // EGC certificate stats: platinum_sites, knightian_sites, min_conf, mean_conf
    var egc_platinum: i64 = 0
    var egc_knightian: i64 = 0
    var egc_min_conf: i64 = 1000
    var egc_conf_sum: i64 = 0
    var egc_expr_count: i64 = 0
    p = 0
    while p < TC {
        let ctk2 = TK[p as usize]
        var is_expr2: i64 = 0
        if ctk2 == 3 || ctk2 == 4 || ctk2 == 5 || ctk2 == 53 { is_expr2 = 1 }
        if ctk2 == 35 || ctk2 == 36 { is_expr2 = 1 }
        if ctk2 >= 17 && ctk2 <= 26 { is_expr2 = 1 }
        if ctk2 == 37 { is_expr2 = 1 }
        if ctk2 == 57 || ctk2 == 58 || ctk2 == 59 || ctk2 == 60 { is_expr2 = 1 }
        if is_expr2 == 1 {
            let cv = EXPR_CONF[p as usize]
            if cv == 1000 { egc_platinum = egc_platinum + 1 }
            if cv == 0 { egc_knightian = egc_knightian + 1 }
            if cv < egc_min_conf { egc_min_conf = cv }
            egc_conf_sum = egc_conf_sum + cv
            egc_expr_count = egc_expr_count + 1
        }
        p = p + 1
    }
    var egc_mean_conf: i64 = 0
    if egc_expr_count > 0 { egc_mean_conf = egc_conf_sum / egc_expr_count }
    if egc_expr_count == 0 { egc_min_conf = 0 }
    // Print structured econf line for certificate generation
    print("econf: total=")
    print_int(egc_expr_count)
    print(" platinum=")
    print_int(egc_platinum)
    print(" gate_pass=")
    print_int(EPIST_HIGH_CONF)
    print(" knightian=")
    print_int(egc_knightian)
    print(" min=")
    print_int(egc_min_conf)
    print(" mean=")
    print_int(egc_mean_conf)
    print(" gate=")
    print_int(GATE_THRESHOLD)
    print("\n")
}

// ─── Top-level compiler ───
// ─── Monomorphization pass ───
// Scans for generic fn/struct declarations, finds instantiation sites,
// generates specialized token copies. Separate function to limit stack usage.
fn mono_pass() with IO, Mut, Panic, Div {
    GEN_FN_COUNT = 0
    GEN_ST_COUNT = 0
    MONO_COUNT = 0
    // Pre-write "i64" and "f64" into SRC for bare-call literal type inference
    INF_I64_S = SRC_LEN
    SRC[SRC_LEN as usize] = 105; SRC_LEN = SRC_LEN + 1
    SRC[SRC_LEN as usize] = 54;  SRC_LEN = SRC_LEN + 1
    SRC[SRC_LEN as usize] = 52;  SRC_LEN = SRC_LEN + 1
    INF_I64_E = SRC_LEN
    INF_F64_S = SRC_LEN
    SRC[SRC_LEN as usize] = 102; SRC_LEN = SRC_LEN + 1
    SRC[SRC_LEN as usize] = 54;  SRC_LEN = SRC_LEN + 1
    SRC[SRC_LEN as usize] = 52;  SRC_LEN = SRC_LEN + 1
    INF_F64_E = SRC_LEN
    // Pass 0c: scan generic function and struct declarations
    var p: i64 = 0
    while p < TC {
        // fn NAME < TPARAM , TPARAM > (
        if TK[p as usize] == 1 && p + 4 < TC && TK[(p + 2) as usize] == 23 {
            // Find closing >
            var tf_depth: i64 = 1
            var tf_p: i64 = p + 3
            while tf_depth > 0 && tf_p < TC {
                if TK[tf_p as usize] == 23 { tf_depth = tf_depth + 1 }
                if TK[tf_p as usize] == 24 { tf_depth = tf_depth - 1 }
                if tf_depth > 0 { tf_p = tf_p + 1 }
            }
            if tf_depth == 0 && tf_p + 1 < TC && TK[(tf_p + 1) as usize] == 6 {
                let gi = GEN_FN_COUNT
                GEN_FN_NS[gi as usize] = TS[(p + 1) as usize]
                GEN_FN_NE[gi as usize] = TE[(p + 1) as usize]
                // Store first type parameter; also record second if present (<T, U>)
                GEN_FN_TP_S[gi as usize] = TS[(p + 3) as usize]
                GEN_FN_TP_E[gi as usize] = TE[(p + 3) as usize]
                GEN_FN_TP2_S[gi as usize] = 0
                GEN_FN_TP2_E[gi as usize] = 0
                if TK[(p + 4) as usize] == 28 && p + 5 < TC && TK[(p + 5) as usize] == 3 {
                    GEN_FN_TP2_S[gi as usize] = TS[(p + 5) as usize]
                    GEN_FN_TP2_E[gi as usize] = TE[(p + 5) as usize]
                }
                GEN_FN_BDY_S[gi as usize] = p
                var q: i64 = tf_p + 1
                while q < TC && TK[q as usize] != 8 { q = q + 1 }
                var bd: i64 = 1
                q = q + 1
                while q < TC && bd > 0 { if TK[q as usize] == 8 { bd = bd + 1 }; if TK[q as usize] == 9 { bd = bd - 1 }; q = q + 1 }
                GEN_FN_BDY_E[gi as usize] = q
                GEN_FN_COUNT = GEN_FN_COUNT + 1
                p = q
                continue
            }
        }
        // struct NAME < TPARAM > {
        if TK[p as usize] == 46 && p + 4 < TC && TK[(p + 2) as usize] == 23 && TK[(p + 4) as usize] == 24 {
            let gi = GEN_ST_COUNT
            GEN_ST_NS[gi as usize] = TS[(p + 1) as usize]
            GEN_ST_NE[gi as usize] = TE[(p + 1) as usize]
            GEN_ST_TP_S[gi as usize] = TS[(p + 3) as usize]
            GEN_ST_TP_E[gi as usize] = TE[(p + 3) as usize]
            GEN_ST_BDY_S[gi as usize] = p
            var q: i64 = p + 5
            while q < TC && TK[q as usize] != 9 { q = q + 1 }
            q = q + 1
            if q < TC && TK[q as usize] == 76 && q + 4 < TC && TK[(q + 2) as usize] == 23 && TK[(q + 4) as usize] == 24 {
                if name_eq(TS[(q + 1) as usize], TE[(q + 1) as usize], GEN_ST_NS[gi as usize], GEN_ST_NE[gi as usize]) {
                    var r: i64 = q + 5
                    while r < TC && TK[r as usize] != 8 { r = r + 1 }
                    var bd2: i64 = 1
                    r = r + 1
                    while r < TC && bd2 > 0 { if TK[r as usize] == 8 { bd2 = bd2 + 1 }; if TK[r as usize] == 9 { bd2 = bd2 - 1 }; r = r + 1 }
                    q = r
                }
            }
            GEN_ST_BDY_E[gi as usize] = q
            GEN_ST_COUNT = GEN_ST_COUNT + 1
            p = q
            continue
        }
        // pub/linear struct generics
        if (TK[p as usize] == 49 || TK[p as usize] == 62) && p + 5 < TC && TK[(p + 1) as usize] == 46 && TK[(p + 3) as usize] == 23 && TK[(p + 5) as usize] == 24 {
            let gi = GEN_ST_COUNT
            GEN_ST_NS[gi as usize] = TS[(p + 2) as usize]
            GEN_ST_NE[gi as usize] = TE[(p + 2) as usize]
            GEN_ST_TP_S[gi as usize] = TS[(p + 4) as usize]
            GEN_ST_TP_E[gi as usize] = TE[(p + 4) as usize]
            GEN_ST_BDY_S[gi as usize] = p
            var q: i64 = p + 6
            while q < TC && TK[q as usize] != 9 { q = q + 1 }
            q = q + 1
            if q < TC && TK[q as usize] == 76 && q + 4 < TC && TK[(q + 2) as usize] == 23 && TK[(q + 4) as usize] == 24 {
                if name_eq(TS[(q + 1) as usize], TE[(q + 1) as usize], GEN_ST_NS[gi as usize], GEN_ST_NE[gi as usize]) {
                    var r: i64 = q + 5
                    while r < TC && TK[r as usize] != 8 { r = r + 1 }
                    var bd2: i64 = 1
                    r = r + 1
                    while r < TC && bd2 > 0 { if TK[r as usize] == 8 { bd2 = bd2 + 1 }; if TK[r as usize] == 9 { bd2 = bd2 - 1 }; r = r + 1 }
                    q = r
                }
            }
            GEN_ST_BDY_E[gi as usize] = q
            GEN_ST_COUNT = GEN_ST_COUNT + 1
            p = q
            continue
        }
        p = p + 1
    }
    if GEN_FN_COUNT > 0 || GEN_ST_COUNT > 0 {
        print("generics: fns="); print_int(GEN_FN_COUNT); print(" structs="); print_int(GEN_ST_COUNT); print("\n")
    }
    if GEN_FN_COUNT == 0 && GEN_ST_COUNT == 0 { return }
    // Pass 0d: find instantiation sites
    p = 0
    var in_gen: i64 = 0
    var ig: i64 = 0
    var d_gi: i64 = 0
    var d_cns: i64 = 0
    var d_cne: i64 = 0
    var d_tys: i64 = 0
    var d_tye: i64 = 0
    var d_mi: i64 = 0
    var d_ms: i64 = 0
    while p < TC {
        in_gen = 0
        ig = 0
        while ig < GEN_FN_COUNT { if p >= GEN_FN_BDY_S[ig as usize] && p < GEN_FN_BDY_E[ig as usize] { in_gen = 1 }; ig = ig + 1 }
        ig = 0
        while ig < GEN_ST_COUNT { if p >= GEN_ST_BDY_S[ig as usize] && p < GEN_ST_BDY_E[ig as usize] { in_gen = 1 }; ig = ig + 1 }
        if in_gen == 1 { p = p + 1; continue }
        if TK[p as usize] == 3 && p + 3 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 3) as usize] == 24 {
            d_cns = TS[p as usize]
            d_cne = TE[p as usize]
            d_tys = TS[(p + 2) as usize]
            d_tye = TE[(p + 2) as usize]
            d_gi = 0
            while d_gi < GEN_FN_COUNT {
                if name_eq(d_cns, d_cne, GEN_FN_NS[d_gi as usize], GEN_FN_NE[d_gi as usize]) {
                    if mono_find_inst(d_gi, 0, d_tys, d_tye) < 0 && MONO_COUNT < 128 {
                        d_mi = MONO_COUNT
                        MONO_GEN[d_mi as usize] = d_gi
                        MONO_TY_S[d_mi as usize] = d_tys
                        MONO_TY_E[d_mi as usize] = d_tye
                        MONO_TY2_S[d_mi as usize] = 0
                        MONO_TY2_E[d_mi as usize] = 0
                        MONO_IS_ST[d_mi as usize] = 0
                        d_ms = mono_mangle(GEN_FN_NS[d_gi as usize], GEN_FN_NE[d_gi as usize], d_tys, d_tye)
                        MAN_BUF_S[d_mi as usize] = d_ms
                        MAN_BUF_E[d_mi as usize] = SRC_LEN
                        MONO_COUNT = MONO_COUNT + 1
                    }
                    d_gi = GEN_FN_COUNT
                }
                d_gi = d_gi + 1
            }
            d_gi = 0
            while d_gi < GEN_ST_COUNT {
                if name_eq(d_cns, d_cne, GEN_ST_NS[d_gi as usize], GEN_ST_NE[d_gi as usize]) {
                    if mono_find_inst(d_gi, 1, d_tys, d_tye) < 0 {
                        d_mi = MONO_COUNT
                        MONO_GEN[d_mi as usize] = d_gi
                        MONO_TY_S[d_mi as usize] = d_tys
                        MONO_TY_E[d_mi as usize] = d_tye
                        MONO_TY2_S[d_mi as usize] = 0
                        MONO_TY2_E[d_mi as usize] = 0
                        MONO_IS_ST[d_mi as usize] = 1
                        d_ms = mono_mangle(GEN_ST_NS[d_gi as usize], GEN_ST_NE[d_gi as usize], d_tys, d_tye)
                        MAN_BUF_S[d_mi as usize] = d_ms
                        MAN_BUF_E[d_mi as usize] = SRC_LEN
                        MONO_COUNT = MONO_COUNT + 1
                    }
                    d_gi = GEN_ST_COUNT
                }
                d_gi = d_gi + 1
            }
        }
        // Turbofish: IDENT :: < TYPE , TYPE > (  — multi-arg generics
        if TK[p as usize] == 3 && p + 4 < TC && TK[(p + 1) as usize] == 51 && TK[(p + 2) as usize] == 23 {
            // Find closing >
            var tf_depth: i64 = 1
            var tf_p: i64 = p + 3
            while tf_depth > 0 && tf_p < TC {
                if TK[tf_p as usize] == 23 { tf_depth = tf_depth + 1 }
                if TK[tf_p as usize] == 24 { tf_depth = tf_depth - 1 }
                if tf_depth > 0 { tf_p = tf_p + 1 }
            }
            if tf_depth == 0 {
                d_cns = TS[p as usize]
                d_cne = TE[p as usize]
                // First type arg: token at p+3
                d_tys = TS[(p + 3) as usize]
                d_tye = TE[(p + 3) as usize]
                // Second type arg: token at p+5 if p+4 is ','
                var d_ty2s: i64 = 0
                var d_ty2e: i64 = 0
                if TK[(p + 4) as usize] == 28 && p + 5 < TC && TK[(p + 5) as usize] == 3 {
                    d_ty2s = TS[(p + 5) as usize]
                    d_ty2e = TE[(p + 5) as usize]
                }
                d_gi = 0
                while d_gi < GEN_FN_COUNT {
                    if name_eq(d_cns, d_cne, GEN_FN_NS[d_gi as usize], GEN_FN_NE[d_gi as usize]) {
                        if mono_find_inst(d_gi, 0, d_tys, d_tye) < 0 && MONO_COUNT < 128 {
                            d_mi = MONO_COUNT
                            MONO_GEN[d_mi as usize] = d_gi
                            MONO_TY_S[d_mi as usize] = d_tys
                            MONO_TY_E[d_mi as usize] = d_tye
                            MONO_TY2_S[d_mi as usize] = d_ty2s
                            MONO_TY2_E[d_mi as usize] = d_ty2e
                            MONO_IS_ST[d_mi as usize] = 0
                            d_ms = mono_mangle(GEN_FN_NS[d_gi as usize], GEN_FN_NE[d_gi as usize], d_tys, d_tye)
                            MAN_BUF_S[d_mi as usize] = d_ms
                            MAN_BUF_E[d_mi as usize] = SRC_LEN
                            MONO_COUNT = MONO_COUNT + 1
                        }
                        d_gi = GEN_FN_COUNT
                    }
                    d_gi = d_gi + 1
                }
                d_gi = 0
                while d_gi < GEN_ST_COUNT {
                    if name_eq(d_cns, d_cne, GEN_ST_NS[d_gi as usize], GEN_ST_NE[d_gi as usize]) {
                        if mono_find_inst(d_gi, 1, d_tys, d_tye) < 0 {
                            d_mi = MONO_COUNT
                            MONO_GEN[d_mi as usize] = d_gi
                            MONO_TY_S[d_mi as usize] = d_tys
                            MONO_TY_E[d_mi as usize] = d_tye
                            MONO_TY2_S[d_mi as usize] = 0
                            MONO_TY2_E[d_mi as usize] = 0
                            MONO_IS_ST[d_mi as usize] = 1
                            d_ms = mono_mangle(GEN_ST_NS[d_gi as usize], GEN_ST_NE[d_gi as usize], d_tys, d_tye)
                            MAN_BUF_S[d_mi as usize] = d_ms
                            MAN_BUF_E[d_mi as usize] = SRC_LEN
                            MONO_COUNT = MONO_COUNT + 1
                        }
                        d_gi = GEN_ST_COUNT
                    }
                    d_gi = d_gi + 1
                }
            }
        }
        // Bare call to generic fn: IDENT ( LITERAL — infer type from first arg literal
        if TK[p as usize] == 3 && p + 2 < TC && TK[(p + 1) as usize] == 6 {
            d_cns = TS[p as usize]; d_cne = TE[p as usize]
            d_gi = 0
            while d_gi < GEN_FN_COUNT {
                if name_eq(d_cns, d_cne, GEN_FN_NS[d_gi as usize], GEN_FN_NE[d_gi as usize]) {
                    var sig_scan: i64 = GEN_FN_BDY_S[d_gi as usize] + 3
                    while sig_scan < TC && TK[sig_scan as usize] != 24 { sig_scan = sig_scan + 1 }
                    if sig_scan + 4 < TC && TK[(sig_scan + 1) as usize] == 6 && TK[(sig_scan + 3) as usize] == 43 {
                        if TK[(sig_scan + 4) as usize] == 3 && name_eq(TS[(sig_scan + 4) as usize], TE[(sig_scan + 4) as usize], GEN_FN_TP_S[d_gi as usize], GEN_FN_TP_E[d_gi as usize]) {
                            let inf_arg = p + 2
                            d_tys = 0; d_tye = 0
                            if inf_arg < TC && TK[inf_arg as usize] == 53 { d_tys = INF_F64_S; d_tye = INF_F64_E }
                            if inf_arg < TC && TK[inf_arg as usize] == 4  { d_tys = INF_I64_S; d_tye = INF_I64_E }
                            if d_tys != 0 && mono_find_inst(d_gi, 0, d_tys, d_tye) < 0 {
                                d_mi = MONO_COUNT
                                MONO_GEN[d_mi as usize] = d_gi
                                MONO_TY_S[d_mi as usize] = d_tys
                                MONO_TY_E[d_mi as usize] = d_tye
                                MONO_TY2_S[d_mi as usize] = 0
                                MONO_TY2_E[d_mi as usize] = 0
                                MONO_IS_ST[d_mi as usize] = 0
                                d_ms = mono_mangle(GEN_FN_NS[d_gi as usize], GEN_FN_NE[d_gi as usize], d_tys, d_tye)
                                MAN_BUF_S[d_mi as usize] = d_ms
                                MAN_BUF_E[d_mi as usize] = SRC_LEN
                                MONO_COUNT = MONO_COUNT + 1
                            }
                        } else {
                            // Extended: first param is not directly T (e.g. fn(T)->T).
                            // Scan all params to find one with direct type T; infer from its arg.
                            var ep_p: i64 = sig_scan + 1  // at (
                            if TK[ep_p as usize] == 6 { ep_p = ep_p + 1 }
                            var ep_pi: i64 = 0
                            var ep_t_pi: i64 = -1
                            while ep_p < TC && TK[ep_p as usize] != 7 && ep_t_pi < 0 {
                                if TK[ep_p as usize] == 3 {
                                    ep_p = ep_p + 1
                                    if TK[ep_p as usize] == 43 {
                                        ep_p = ep_p + 1
                                        if TK[ep_p as usize] == 3 && name_eq(TS[ep_p as usize], TE[ep_p as usize], GEN_FN_TP_S[d_gi as usize], GEN_FN_TP_E[d_gi as usize]) {
                                            ep_t_pi = ep_pi
                                        } else {
                                            ep_p = skip_call_arg_expr(ep_p)
                                        }
                                    }
                                }
                                if ep_t_pi >= 0 { ep_p = TC }
                                else if TK[ep_p as usize] == 28 { ep_p = ep_p + 1; ep_pi = ep_pi + 1 }
                                else { ep_p = ep_p + 1 }
                            }
                            if ep_t_pi >= 0 {
                                var ea_p: i64 = p + 2
                                var ea_i: i64 = 0
                                while ea_i < ep_t_pi && ea_p < TC && TK[ea_p as usize] != 7 {
                                    ea_p = skip_call_arg_expr(ea_p)
                                    if TK[ea_p as usize] == 28 { ea_p = ea_p + 1 }
                                    ea_i = ea_i + 1
                                }
                                d_tys = 0; d_tye = 0
                                if TK[ea_p as usize] == 4  { d_tys = INF_I64_S; d_tye = INF_I64_E }
                                if TK[ea_p as usize] == 53 { d_tys = INF_F64_S; d_tye = INF_F64_E }
                                if d_tys != 0 && mono_find_inst(d_gi, 0, d_tys, d_tye) < 0 {
                                    d_mi = MONO_COUNT
                                    MONO_GEN[d_mi as usize] = d_gi
                                    MONO_TY_S[d_mi as usize] = d_tys
                                    MONO_TY_E[d_mi as usize] = d_tye
                                    MONO_TY2_S[d_mi as usize] = 0
                                    MONO_TY2_E[d_mi as usize] = 0
                                    MONO_IS_ST[d_mi as usize] = 0
                                    d_ms = mono_mangle(GEN_FN_NS[d_gi as usize], GEN_FN_NE[d_gi as usize], d_tys, d_tye)
                                    MAN_BUF_S[d_mi as usize] = d_ms
                                    MAN_BUF_E[d_mi as usize] = SRC_LEN
                                    MONO_COUNT = MONO_COUNT + 1
                                }
                            }
                        }
                    }
                    d_gi = GEN_FN_COUNT
                }
                d_gi = d_gi + 1
            }
        }
        p = p + 1
    }
    // Generate specialized token copies
    var m_i: i64 = 0
    var m_gi: i64 = 0
    var m_is_st: i64 = 0
    var m_tys: i64 = 0
    var m_tye: i64 = 0
    var m_ty2s: i64 = 0
    var m_ty2e: i64 = 0
    var m_mns: i64 = 0
    var m_mne: i64 = 0
    var m_bs: i64 = 0
    var m_be: i64 = 0
    var m_tps: i64 = 0
    var m_tpe: i64 = 0
    var m_tp2s: i64 = 0
    var m_tp2e: i64 = 0
    var m_gns: i64 = 0
    var m_gne: i64 = 0
    var m_ti: i64 = 0
    var m_skip: i64 = 0
    var m_tk: i64 = 0
    var m_tts: i64 = 0
    var m_tte: i64 = 0
    while m_i < MONO_COUNT {
        m_gi = MONO_GEN[m_i as usize]
        m_is_st = MONO_IS_ST[m_i as usize]
        m_tys = MONO_TY_S[m_i as usize]
        m_tye = MONO_TY_E[m_i as usize]
        m_ty2s = MONO_TY2_S[m_i as usize]
        m_ty2e = MONO_TY2_E[m_i as usize]
        m_mns = MAN_BUF_S[m_i as usize]
        m_mne = MAN_BUF_E[m_i as usize]
        m_bs = 0
        m_be = 0
        m_tps = 0
        m_tpe = 0
        m_tp2s = 0
        m_tp2e = 0
        m_gns = 0
        m_gne = 0
        if m_is_st == 0 {
            m_bs = GEN_FN_BDY_S[m_gi as usize]
            m_be = GEN_FN_BDY_E[m_gi as usize]
            m_tps = GEN_FN_TP_S[m_gi as usize]
            m_tpe = GEN_FN_TP_E[m_gi as usize]
            m_tp2s = GEN_FN_TP2_S[m_gi as usize]
            m_tp2e = GEN_FN_TP2_E[m_gi as usize]
            m_gns = GEN_FN_NS[m_gi as usize]
            m_gne = GEN_FN_NE[m_gi as usize]
        } else {
            m_bs = GEN_ST_BDY_S[m_gi as usize]
            m_be = GEN_ST_BDY_E[m_gi as usize]
            m_tps = GEN_ST_TP_S[m_gi as usize]
            m_tpe = GEN_ST_TP_E[m_gi as usize]
            m_gns = GEN_ST_NS[m_gi as usize]
            m_gne = GEN_ST_NE[m_gi as usize]
        }
        m_ti = m_bs
        m_skip = 0
        while m_ti < m_be && TC < 131000 {
            m_tk = TK[m_ti as usize]
            m_tts = TS[m_ti as usize]
            m_tte = TE[m_ti as usize]
            // Strip <TPARAMS> from function/struct signature (depth-tracking for multi-param)
            if m_skip == 0 && m_tk == 23 && m_ti > m_bs && name_eq(TS[(m_ti - 1) as usize], TE[(m_ti - 1) as usize], m_gns, m_gne) {
                var skip_depth: i64 = 1
                m_ti = m_ti + 1
                while m_ti < m_be && skip_depth > 0 {
                    if TK[m_ti as usize] == 23 { skip_depth = skip_depth + 1 }
                    if TK[m_ti as usize] == 24 { skip_depth = skip_depth - 1 }
                    if skip_depth > 0 { m_ti = m_ti + 1 }
                }
                if TK[m_ti as usize] == 24 { m_ti = m_ti + 1 }
                m_skip = 1
                continue
            }
            // Collapse `GenStruct < TYPE >` references inside a generic *fn* body into a
            // single `GenStruct_<ty>` token, registering the struct specialization so it
            // gets emitted + re-scanned into ST. TYPE is the fn's own param T → use the
            // concrete instantiation type [m_tys,m_tye); otherwise a literal type (e.g.
            // a hardcoded Box<i64>) → use the inner token's own range. Single-param only.
            if m_is_st == 0 && m_tk == 3 && m_ti + 2 < m_be && TK[(m_ti + 1) as usize] == 23 && TK[(m_ti + 2) as usize] == 3 && m_ti + 3 < m_be && TK[(m_ti + 3) as usize] == 24 {
                var cs_gi: i64 = 0
                var cs_hit: i64 = -1
                while cs_gi < GEN_ST_COUNT && cs_hit < 0 {
                    if name_eq(m_tts, m_tte, GEN_ST_NS[cs_gi as usize], GEN_ST_NE[cs_gi as usize]) { cs_hit = cs_gi }
                    cs_gi = cs_gi + 1
                }
                if cs_hit >= 0 {
                    var cs_tys: i64 = TS[(m_ti + 2) as usize]
                    var cs_tye: i64 = TE[(m_ti + 2) as usize]
                    if name_eq(cs_tys, cs_tye, m_tps, m_tpe) { cs_tys = m_tys; cs_tye = m_tye }
                    let cs_mi = mono_register_struct(cs_hit, cs_tys, cs_tye)
                    if cs_mi >= 0 {
                        TK[TC as usize] = 3
                        TS[TC as usize] = MAN_BUF_S[cs_mi as usize]
                        TE[TC as usize] = MAN_BUF_E[cs_mi as usize]
                        TV[TC as usize] = 0
                        TL[TC as usize] = TL[m_ti as usize]
                        TC = TC + 1
                        m_ti = m_ti + 4
                        continue
                    }
                }
            }
            // Rewrite a bare generic-struct CONSTRUCTOR `GenStruct {` inside a generic
            // *fn* body to the mangled `GenStruct_<ty> {` for this instantiation. The
            // collapse arm above only fires on `GenStruct < T >`; a plain struct
            // literal has no angle brackets, so without this the literal keeps the
            // template spelling, its type hash stays gl_name_hash("GenStruct") while
            // the declared return collapsed to "GenStruct_<ty>", and the tail-type
            // check rejects valid code ("tail type mismatch"). Single-param structs,
            // instantiated at the fn's first concrete type — same limitation as the
            // collapse arm. (An `IDENT {` where IDENT is a local var coincidentally
            // spelled like a generic struct would false-fire; requires an exact
            // case-sensitive collision with a generic struct name.)
            if m_is_st == 0 && m_tk == 3 && m_ti + 1 < m_be && TK[(m_ti + 1) as usize] == 8 {
                var bc_gi: i64 = 0
                var bc_hit: i64 = -1
                while bc_gi < GEN_ST_COUNT && bc_hit < 0 {
                    if name_eq(m_tts, m_tte, GEN_ST_NS[bc_gi as usize], GEN_ST_NE[bc_gi as usize]) { bc_hit = bc_gi }
                    bc_gi = bc_gi + 1
                }
                if bc_hit >= 0 {
                    let bc_mi = mono_register_struct(bc_hit, m_tys, m_tye)
                    if bc_mi >= 0 {
                        TK[TC as usize] = 3
                        TS[TC as usize] = MAN_BUF_S[bc_mi as usize]
                        TE[TC as usize] = MAN_BUF_E[bc_mi as usize]
                        TV[TC as usize] = 0
                        TL[TC as usize] = TL[m_ti as usize]
                        TC = TC + 1
                        m_ti = m_ti + 1
                        continue
                    }
                    print("warning: mono table overflow -- generic struct instantiation dropped\n")
                }
            }
            // Transitive generic-fn instantiation: register `callee ::< T [, U] >` seen
            // while copying a generic fn body (see mono_register_fn). Tokens are NOT
            // consumed -- the type-param arms below rewrite the T/U tokens as they are
            // copied, and compile_primary resolves the call via mono_find_inst.
            if m_is_st == 0 && m_tk == 3 && m_ti + 4 < m_be && TK[(m_ti + 1) as usize] == 51 && TK[(m_ti + 2) as usize] == 23 && TK[(m_ti + 3) as usize] == 3 {
                var tf_gi: i64 = 0
                var tf_hit: i64 = -1
                while tf_gi < GEN_FN_COUNT && tf_hit < 0 {
                    if name_eq(m_tts, m_tte, GEN_FN_NS[tf_gi as usize], GEN_FN_NE[tf_gi as usize]) { tf_hit = tf_gi }
                    tf_gi = tf_gi + 1
                }
                if tf_hit >= 0 {
                    var tf_tys: i64 = TS[(m_ti + 3) as usize]
                    var tf_tye: i64 = TE[(m_ti + 3) as usize]
                    if name_eq(tf_tys, tf_tye, m_tps, m_tpe) { tf_tys = m_tys; tf_tye = m_tye }
                    if m_tp2s != 0 && name_eq(TS[(m_ti + 3) as usize], TE[(m_ti + 3) as usize], m_tp2s, m_tp2e) { tf_tys = m_ty2s; tf_tye = m_ty2e }
                    var tf_ty2s: i64 = 0
                    var tf_ty2e: i64 = 0
                    if TK[(m_ti + 4) as usize] == 28 && m_ti + 5 < m_be && TK[(m_ti + 5) as usize] == 3 {
                        tf_ty2s = TS[(m_ti + 5) as usize]
                        tf_ty2e = TE[(m_ti + 5) as usize]
                        if name_eq(tf_ty2s, tf_ty2e, m_tps, m_tpe) { tf_ty2s = m_tys; tf_ty2e = m_tye }
                        if m_tp2s != 0 && name_eq(TS[(m_ti + 5) as usize], TE[(m_ti + 5) as usize], m_tp2s, m_tp2e) { tf_ty2s = m_ty2s; tf_ty2e = m_ty2e }
                    }
                    let tf_mi = mono_register_fn(tf_hit, tf_tys, tf_tye, tf_ty2s, tf_ty2e)
                    if tf_mi < 0 { print("warning: mono table overflow -- generic fn instantiation dropped\n") }
                }
            }
            if m_tk == 3 && name_eq(m_tts, m_tte, m_gns, m_gne) {
                TK[TC as usize] = 3
                TS[TC as usize] = m_mns
                TE[TC as usize] = m_mne
                TV[TC as usize] = 0
                TL[TC as usize] = TL[m_ti as usize]
                TC = TC + 1
                m_ti = m_ti + 1
                continue
            }
            if m_tk == 3 && name_eq(m_tts, m_tte, m_tps, m_tpe) {
                TK[TC as usize] = 3
                TS[TC as usize] = m_tys
                TE[TC as usize] = m_tye
                TV[TC as usize] = 0
                TL[TC as usize] = TL[m_ti as usize]
                TC = TC + 1
                m_ti = m_ti + 1
                continue
            }
            if m_tk == 3 && m_tp2s != 0 && name_eq(m_tts, m_tte, m_tp2s, m_tp2e) {
                TK[TC as usize] = 3
                TS[TC as usize] = m_ty2s
                TE[TC as usize] = m_ty2e
                TV[TC as usize] = 0
                TL[TC as usize] = TL[m_ti as usize]
                TC = TC + 1
                m_ti = m_ti + 1
                continue
            }
            TK[TC as usize] = m_tk
            TS[TC as usize] = m_tts
            TE[TC as usize] = m_tte
            TV[TC as usize] = TV[m_ti as usize]
            TF[TC as usize] = TF[m_ti as usize]
            TD[TC as usize] = TD[m_ti as usize]
            TL[TC as usize] = TL[m_ti as usize]
            TC = TC + 1
            m_ti = m_ti + 1
        }
        m_i = m_i + 1
    }
    // Re-add EOF token and re-scan monomorphized structs
    if MONO_COUNT > 0 {
        TK[TC as usize] = 0
        TC = TC + 1
        print("mono: "); print_int(MONO_COUNT); print(" specializations, tokens="); print_int(TC); print("\n")
        // Re-scan for monomorphized struct declarations
        p = 0
        while p < TC {
            if TK[p as usize] == 46 || TK[p as usize] == 49 || TK[p as usize] == 62 || TK[p as usize] == 73 {
                var ris_public: i64 = 0
                if TK[p as usize] == 49 { ris_public = 1 }
                if TK[p as usize] == 49 || TK[p as usize] == 62 || TK[p as usize] == 73 { p = p + 1 }
                if TK[p as usize] == 46 {
                    p = p + 1
                    let rsn_ns = TS[p as usize]
                    let rsn_ne = TE[p as usize]
                    let rsn_tok = p
                    let rsh = gl_name_hash(rsn_ns, rsn_ne)
                    if st_find(rsh) < 0 {
                        let rsi = ST_COUNT
                        let rbase = rsi * 130
                        ST[rbase as usize] = rsh
                        ST_PUBLIC[rsi as usize] = ris_public
                        ST_DECL_NS[rsi as usize] = rsn_ns
                        ST_DECL_NE[rsi as usize] = rsn_ne
                        p = p + 1
                        if TK[p as usize] == 23 { p = p + 1; while TK[p as usize] != 9 && TK[p as usize] != 0 { p = p + 1 }; if TK[p as usize] == 9 { p = p + 1 }; ST[(rbase + 1) as usize] = 0; ST_COUNT = ST_COUNT + 1; continue }
                        if TK[p as usize] == 8 { p = p + 1 }
                        var rfc: i64 = 0
                        while TK[p as usize] != 9 && TK[p as usize] != 0 {
                            if TK[p as usize] == 3 {
                                let rfh = gl_name_hash(TS[p as usize], TE[p as usize])
                                let rffi = rfc
                                ST[(rbase + 2 + rfc) as usize] = rfh
                                ST_FNS[(rsi * 128 + rffi) as usize] = TS[p as usize]
                                ST_FNE[(rsi * 128 + rffi) as usize] = TE[p as usize]
                                p = p + 1
                                if TK[p as usize] == 43 {
                                    p = p + 1
                                    scan_type(p)
                                    ST_FTY[(rsi * 128 + rffi) as usize] = SCAN_TY
                                    ST_FHASH[(rsi * 128 + rffi) as usize] = SCAN_TY_HASH
                                    p = SCAN_TY_NEXT
                                } else {
                                    ST_FTY[(rsi * 128 + rffi) as usize] = 0
                                    ST_FHASH[(rsi * 128 + rffi) as usize] = 0
                                }
                                rfc = rfc + 1
                                if TK[p as usize] == 28 { p = p + 1 }
                                continue
                            }
                            p = p + 1
                        }
                        ST[(rbase + 1) as usize] = rfc
                        var rffi_c1: i64 = 0
                        while rffi_c1 < rfc {
                            var rffi_c2: i64 = rffi_c1 + 1
                            while rffi_c2 < rfc {
                                if ST[(rbase + 2 + rffi_c1) as usize] == ST[(rbase + 2 + rffi_c2) as usize] {
                                    tc_error(rsn_tok, "struct field hash collision detected — struct literals may resolve to wrong fields")
                                    print("  colliding fields: '")
                                    var rcc1_i = ST_FNS[(rsi * 128 + rffi_c1) as usize]
                                    let rcc1_e = ST_FNE[(rsi * 128 + rffi_c1) as usize]
                                    while rcc1_i < rcc1_e { print_char(SRC[rcc1_i as usize] as i64); rcc1_i = rcc1_i + 1 }
                                    print("' and '")
                                    var rcc2_i = ST_FNS[(rsi * 128 + rffi_c2) as usize]
                                    let rcc2_e = ST_FNE[(rsi * 128 + rffi_c2) as usize]
                                    while rcc2_i < rcc2_e { print_char(SRC[rcc2_i as usize] as i64); rcc2_i = rcc2_i + 1 }
                                    print("' (hash=")
                                    print_int(ST[(rbase + 2 + rffi_c1) as usize])
                                    print(")\n")
                                }
                                rffi_c2 = rffi_c2 + 1
                            }
                            rffi_c1 = rffi_c1 + 1
                        }
                        ST_COUNT = ST_COUNT + 1
                    }
                    if TK[p as usize] == 9 { p = p + 1 }
                    continue
                }
            }
            p = p + 1
        }
    }
}

fn resolve_type_leaf(ty: i64, ty_hash: i64) with Mut, Panic, Div {
    RESOLVE_TY = ty
    RESOLVE_TY_HASH = ty_hash
    if ty == 0 && ty_hash != 0 {
        if st_find(ty_hash) >= 0 {
            RESOLVE_TY = 6
            return
        }
        if en_find(ty_hash) >= 0 {
            RESOLVE_TY = 7
            return
        }
    }
    return
}

fn resolve_type_deep(ty: i64, ty_hash: i64) with Mut, Panic, Div {
    RESOLVE_TY = ty
    RESOLVE_TY_HASH = ty_hash

    if ty == 0 {
        resolve_type_leaf(ty, ty_hash)
        return
    }

    if ty == 10 && ref_hash_is(ty_hash) {
        let ref_mode = ref_hash_mut(ty_hash)
        let ref_inner_ty = ref_hash_inner_ty(ty_hash)
        let ref_inner_hash = ref_hash_inner_hash(ty_hash)
        resolve_type_deep(ref_inner_ty, ref_inner_hash)
        let fixed_inner_ty = RESOLVE_TY
        let fixed_inner_hash = RESOLVE_TY_HASH
        RESOLVE_TY = 10
        RESOLVE_TY_HASH = ref_hash_make(fixed_inner_ty, fixed_inner_hash, ref_mode)
        return
    }

    if ty == 11 && ref_hash_is(ty_hash) {
        let ptr_mode = ptr_hash_mut(ty_hash)
        let ptr_inner_ty = ptr_hash_inner_ty(ty_hash)
        let ptr_inner_hash = ptr_hash_inner_hash(ty_hash)
        resolve_type_deep(ptr_inner_ty, ptr_inner_hash)
        let fixed_ptr_ty = RESOLVE_TY
        let fixed_ptr_hash = RESOLVE_TY_HASH
        RESOLVE_TY = 11
        if ptr_mode == 2 {
            RESOLVE_TY_HASH = option_hash_make(fixed_ptr_ty, fixed_ptr_hash)
            return
        }
        if ptr_mode == 3 {
            RESOLVE_TY_HASH = box_hash_make(fixed_ptr_ty, fixed_ptr_hash)
            return
        }
        RESOLVE_TY_HASH = ptr_hash_make(fixed_ptr_ty, fixed_ptr_hash, ptr_mode)
        return
    }

    return
}

fn resolve_forward_struct_types() with Mut, Panic, Div {
    var fix_si: i64 = 0
    while fix_si < ST_COUNT {
        var fix_fi: i64 = 0
        while fix_fi < ST[(fix_si * 130 + 1) as usize] {
            resolve_type_deep(ST_FTY[(fix_si * 128 + fix_fi) as usize], ST_FHASH[(fix_si * 128 + fix_fi) as usize])
            ST_FTY[(fix_si * 128 + fix_fi) as usize] = RESOLVE_TY
            ST_FHASH[(fix_si * 128 + fix_fi) as usize] = RESOLVE_TY_HASH
            fix_fi = fix_fi + 1
        }
        fix_si = fix_si + 1
    }
    return
}

fn compile_all() -> i64 with IO, Mut, Panic, Div {
    CL = 0
    POOL_ALLOC_ROUTINE_CL = 0 - 1
    FN_COUNT = 0
    PATCH_COUNT = 0
    FNSIG_COUNT = 1
    GL_COUNT = 0
    GL_BSS_SIZE = 0
    RET_AGG_BSS_OFF = 0
    GPU_EMU_THREAD_ID_BSS_OFF = 0
    R15_GATE_COUNT = 0
    R15_SIDE_TABLE_BSS_OFF = 0
    // Note: do NOT reset TYPECHECK_FAILED here — lexer-phase errors must persist
    LIMIT_ERROR_KIND = 0
    var p: i64 = 0

    // Gen 19: preload unit dimension table (SI, CGS, Imperial, Astronomical, Pharma, Atomic)
    init_unit_table()

    // C4: Pass 0 (token rewrite) — resolve `Self` inside impl blocks.
    // scan_type() has no "Self" case (it only understands a single bare
    // identifier resolved against structs/enums/primitives), so `o: Self` /
    // `-> Self` never typed correctly downstream. Rather than teach every
    // scan_type() call site about Self, rewrite the token stream ONCE, up
    // front: inside each `impl [Trait for] Target { ... }` body, every ident
    // token whose source text is exactly "Self" has its TS/TE overwritten to
    // Target's own identifier span (kind stays 3 = ident), so all later
    // passes see the concrete type name as if the source had said so
    // directly. Trait blocks (kw 75) are skipped entirely — they have no
    // concrete target to rewrite to, and bodyless trait methods must keep
    // `Self` unresolved (there is nothing else to check it against there).
    var selfrw_p: i64 = 0
    while selfrw_p < TC {
        if TK[selfrw_p as usize] == 75 {
            // Skip the whole trait block untouched.
            selfrw_p = selfrw_p + 1
            while selfrw_p < TC && TK[selfrw_p as usize] != 8 && TK[selfrw_p as usize] != 0 { selfrw_p = selfrw_p + 1 }
            if selfrw_p < TC && TK[selfrw_p as usize] == 8 {
                var srw_trait_depth: i64 = 1
                selfrw_p = selfrw_p + 1
                while selfrw_p < TC && srw_trait_depth > 0 {
                    if TK[selfrw_p as usize] == 8 { srw_trait_depth = srw_trait_depth + 1 }
                    if TK[selfrw_p as usize] == 9 { srw_trait_depth = srw_trait_depth - 1 }
                    selfrw_p = selfrw_p + 1
                }
            }
            continue
        }
        if TK[selfrw_p as usize] == 76 {
            selfrw_p = selfrw_p + 1  // skip 'impl'
            // Skip optional impl-level generic params: impl<T> ...
            if selfrw_p < TC && TK[selfrw_p as usize] == 23 {
                var srw_gd: i64 = 1
                selfrw_p = selfrw_p + 1
                while selfrw_p < TC && srw_gd > 0 {
                    if TK[selfrw_p as usize] == 23 { srw_gd = srw_gd + 1 }
                    if TK[selfrw_p as usize] == 24 { srw_gd = srw_gd - 1 }
                    selfrw_p = selfrw_p + 1
                }
            }
            var srw_target_ts: i64 = -1
            var srw_target_te: i64 = -1
            if selfrw_p < TC && TK[selfrw_p as usize] == 3 {
                srw_target_ts = TS[selfrw_p as usize]
                srw_target_te = TE[selfrw_p as usize]
                selfrw_p = selfrw_p + 1
                // `impl Trait for Target` — the target is the ident after `for`,
                // not the trait name right after `impl`.
                if selfrw_p < TC && TK[selfrw_p as usize] == 54 {
                    selfrw_p = selfrw_p + 1  // skip 'for'
                    if selfrw_p < TC && TK[selfrw_p as usize] == 3 {
                        srw_target_ts = TS[selfrw_p as usize]
                        srw_target_te = TE[selfrw_p as usize]
                        selfrw_p = selfrw_p + 1
                    }
                }
            }
            // Skip optional generic args on the target type: Foo<T>
            if selfrw_p < TC && TK[selfrw_p as usize] == 23 {
                var srw_tgd: i64 = 1
                selfrw_p = selfrw_p + 1
                while selfrw_p < TC && srw_tgd > 0 {
                    if TK[selfrw_p as usize] == 23 { srw_tgd = srw_tgd + 1 }
                    if TK[selfrw_p as usize] == 24 { srw_tgd = srw_tgd - 1 }
                    selfrw_p = selfrw_p + 1
                }
            }
            // Advance to the impl body's opening brace, then rewrite every
            // "Self" ident inside it (tracking nested braces so we stop at
            // the impl block's own matching close, not an inner one).
            while selfrw_p < TC && TK[selfrw_p as usize] != 8 && TK[selfrw_p as usize] != 0 { selfrw_p = selfrw_p + 1 }
            if selfrw_p < TC && TK[selfrw_p as usize] == 8 && srw_target_ts >= 0 {
                var srw_depth: i64 = 1
                selfrw_p = selfrw_p + 1
                while selfrw_p < TC && srw_depth > 0 {
                    if TK[selfrw_p as usize] == 8 { srw_depth = srw_depth + 1 }
                    if TK[selfrw_p as usize] == 9 { srw_depth = srw_depth - 1 }
                    if srw_depth > 0 && TK[selfrw_p as usize] == 3 && src_match(TS[selfrw_p as usize], TE[selfrw_p as usize] - TS[selfrw_p as usize], "Self") {
                        TS[selfrw_p as usize] = srw_target_ts
                        TE[selfrw_p as usize] = srw_target_te
                    }
                    selfrw_p = selfrw_p + 1
                }
            }
            continue
        }
        selfrw_p = selfrw_p + 1
    }

    // Pass 0a: register structs, constants, and skip algebra/study declarations
    ST_COUNT = 0
    scan_all_consts()
    var pass0a_depth: i64 = 0
    while p < TC {
        // Track brace depth to only process top-level declarations
        if TK[p as usize] == 8 {
            pass0a_depth = pass0a_depth + 1; p = p + 1; continue
        }
        if TK[p as usize] == 9 {
            if pass0a_depth > 0 { pass0a_depth = pass0a_depth - 1 }
            p = p + 1
            continue
        }
        // Reset depth at file boundaries (TK==77 = \x01...\x02 marker emitted by lexer)
        if TK[p as usize] == 77 {
            pass0a_depth = 0; p = p + 1; continue
        }
        if pass0a_depth == 0 && TK[p as usize] == 2 {
            tc_error_hard(p, "return outside function body is invalid module item")
            p = p + 1
            continue
        }
        // Gen 19: unit NAME;  or  unit NAME = SCALE * BASE_UNIT;
        // Registers NAME as a user-declared unit in UNIT_HASH_TABLE.
        // Minimal form: unit mg;  — just registers the hash (dim looked up from preloaded table)
        // Future form: unit furlongs = 201.168 * m; — inherits base unit dimension
        if pass0a_depth == 0 && TK[p as usize] == 3 && src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "unit") && TK[(p + 1) as usize] == 3 {
            p = p + 1  // skip 'unit'
            if p < TC && TK[p as usize] == 3 {
                let uns = TS[p as usize]
                let une = TE[p as usize]
                let uhash = gl_name_hash(uns, une)
                p = p + 1  // skip NAME
                // Check for '= unit_expr;' form. Supports SCALE * BASE and m / s derived units.
                if p < TC && TK[p as usize] == 16 {
                    p = p + 1  // skip '='
                    while p < TC && (TK[p as usize] == 4 || TK[p as usize] == 53 || TK[p as usize] == 50 || TK[p as usize] == 19) { p = p + 1 }
                    var derived_dim: i64 = 0
                    if p < TC && TK[p as usize] == 3 {
                        let buns = TS[p as usize]
                        let bune = TE[p as usize]
                        let base_hash = gl_name_hash(buns, bune)
                        derived_dim = unit_lookup_dim(base_hash)
                        p = p + 1
                        while p < TC && (TK[p as usize] == 19 || TK[p as usize] == 20) {
                            let unit_op = TK[p as usize]
                            p = p + 1
                            while p < TC && (TK[p as usize] == 4 || TK[p as usize] == 53 || TK[p as usize] == 50) { p = p + 1 }
                            if p < TC && TK[p as usize] == 3 {
                                let rhs_hash = gl_name_hash(TS[p as usize], TE[p as usize])
                                let rhs_dim = unit_lookup_dim(rhs_hash)
                                if unit_op == 19 { derived_dim = dim_add(derived_dim, rhs_dim) }
                                else { derived_dim = dim_sub(derived_dim, rhs_dim) }
                                p = p + 1
                            }
                        }
                    }
                    unit_register_h(uhash, derived_dim)
                } else {
                    // Plain 'unit NAME;' — look up dim from preloaded table (may be 0 if new)
                    let existing_dim = unit_lookup_dim(uhash)
                    unit_register_h(uhash, existing_dim)
                }
                // Skip to semicolon
                while p < TC && TK[p as usize] != 27 && TK[p as usize] != 0 { p = p + 1 }
                if p < TC && TK[p as usize] == 27 { p = p + 1 }
            }
            continue
        }
        // Algebra declarations: algebra Name over Base { ... }
        // If block contains 'basis: e0, e1, ...' → register Name as a struct type.
        if pass0a_depth == 0 && TK[p as usize] == 70 {
            p = p + 1  // skip 'algebra'
            let alg_ns = TS[p as usize]
            let alg_ne = TE[p as usize]
            let alg_hash = gl_name_hash(alg_ns, alg_ne)
            let alg_name_tok = p
            p = p + 1  // skip Name
            if p < TC && TK[p as usize] == 3 { p = p + 1 }  // skip 'over'
            var alg_base_ty: i64 = 1  // default i64
            if p < TC && TK[p as usize] == 3 {
                let bns2 = TS[p as usize]
                let bne2 = TE[p as usize]
                if src_match(bns2, bne2 - bns2, "f64") || src_match(bns2, bne2 - bns2, "f32") { alg_base_ty = 2 }
                p = p + 1
            }
            // Skip to opening brace
            while p < TC && TK[p as usize] != 8 && TK[p as usize] != 0 { p = p + 1 }
            if p < TC && TK[p as usize] == 8 { p = p + 1 }  // skip {
            // First pass: scan block for 'basis:' and count field idents
            var alg_basis_p: i64 = 0
            var alg_fc: i64 = 0
            var ap: i64 = p
            while ap < TC && TK[ap as usize] != 9 && TK[ap as usize] != 0 {
                if TK[ap as usize] == 3 {
                    let bkns = TS[ap as usize]
                    let bkne = TE[ap as usize]
                    if src_match(bkns, bkne - bkns, "basis") {
                        ap = ap + 1
                        if ap < TC && TK[ap as usize] == 43 { ap = ap + 1 }  // skip ':'
                        alg_basis_p = ap
                        while ap < TC && TK[ap as usize] != 9 && TK[ap as usize] != 0 {
                            if TK[ap as usize] == 3 && ap + 1 < TC && TK[(ap + 1) as usize] == 43 { break }
                            if TK[ap as usize] == 3 { alg_fc = alg_fc + 1 }
                            ap = ap + 1
                        }
                        continue
                    }
                }
                ap = ap + 1
            }
            // Second pass: scan for add:/mul:/reassociate: property declarations
            var al_props: i64 = 1  // bit 0 = is_algebra
            al_props = al_props | 8   // default: mul commutative
            al_props = al_props | 16  // default: mul associative
            ap = p
            while ap < TC && TK[ap as usize] != 9 && TK[ap as usize] != 0 {
                if TK[ap as usize] == 3 {
                    let pkns = TS[ap as usize]
                    let pkne = TE[ap as usize]
                    if src_match(pkns, pkne - pkns, "add") && ap + 1 < TC && TK[(ap + 1) as usize] == 43 {
                        ap = ap + 2
                        while ap < TC && TK[ap as usize] != 27 && TK[ap as usize] != 9 && TK[ap as usize] != 0 {
                            if TK[ap as usize] == 3 && ap + 1 < TC && TK[(ap + 1) as usize] == 43 { break }
                            if TK[ap as usize] == 3 {
                                if src_match(TS[ap as usize], TE[ap as usize] - TS[ap as usize], "commutative") { al_props = al_props | 2 }
                                if src_match(TS[ap as usize], TE[ap as usize] - TS[ap as usize], "associative") { al_props = al_props | 4 }
                            }
                            ap = ap + 1
                        }
                        if ap < TC && TK[ap as usize] == 27 { ap = ap + 1 }
                        continue
                    }
                    if src_match(pkns, pkne - pkns, "mul") && ap + 1 < TC && TK[(ap + 1) as usize] == 43 {
                        ap = ap + 2
                        // Clear defaults — explicit mul: overrides
                        al_props = bitset_clear(al_props, 8)   // clear mul_comm
                        al_props = bitset_clear(al_props, 16)  // clear mul_assoc
                        while ap < TC && TK[ap as usize] != 27 && TK[ap as usize] != 9 && TK[ap as usize] != 0 {
                            if TK[ap as usize] == 3 && ap + 1 < TC && TK[(ap + 1) as usize] == 43 { break }
                            if TK[ap as usize] == 3 {
                                if src_match(TS[ap as usize], TE[ap as usize] - TS[ap as usize], "commutative") { al_props = al_props | 8 }
                                if src_match(TS[ap as usize], TE[ap as usize] - TS[ap as usize], "non_commutative") { al_props = bitset_clear(al_props, 8) }
                                if src_match(TS[ap as usize], TE[ap as usize] - TS[ap as usize], "associative") { al_props = al_props | 16 }
                                if src_match(TS[ap as usize], TE[ap as usize] - TS[ap as usize], "alternative") { al_props = al_props | 32; al_props = bitset_clear(al_props, 16) }
                            }
                            ap = ap + 1
                        }
                        if ap < TC && TK[ap as usize] == 27 { ap = ap + 1 }
                        continue
                    }
                    if src_match(pkns, pkne - pkns, "reassociate") && ap + 1 < TC && TK[(ap + 1) as usize] == 43 {
                        ap = ap + 2
                        while ap < TC && TK[ap as usize] != 27 && TK[ap as usize] != 9 && TK[ap as usize] != 0 {
                            if TK[ap as usize] == 3 && ap + 1 < TC && TK[(ap + 1) as usize] == 43 { break }
                            if TK[ap as usize] == 3 {
                                if src_match(TS[ap as usize], TE[ap as usize] - TS[ap as usize], "full") { al_props = bitset_clear(al_props, 192) | 64 }
                                if src_match(TS[ap as usize], TE[ap as usize] - TS[ap as usize], "fano_selective") { al_props = bitset_clear(al_props, 192) | 128 }
                            }
                            ap = ap + 1
                        }
                        if ap < TC && TK[ap as usize] == 27 { ap = ap + 1 }
                        continue
                    }
                }
                ap = ap + 1
            }
            // Register as struct if basis was declared
            if alg_fc > 0 && ST_COUNT < 1024 {
                let asi = ST_COUNT
                let abase = asi * 130
                ST[abase as usize] = alg_hash
                ST_PUBLIC[asi as usize] = 1
                ST_DECL_NS[asi as usize] = alg_ns
                ST_DECL_NE[asi as usize] = alg_ne
                ST[(abase + 1) as usize] = alg_fc
                var afi_c1: i64 = 0
                while afi_c1 < alg_fc {
                    var afi_c2: i64 = afi_c1 + 1
                    while afi_c2 < alg_fc {
                        if ST[(abase + 2 + afi_c1) as usize] == ST[(abase + 2 + afi_c2) as usize] {
                            tc_error(alg_name_tok, "algebra basis field hash collision detected — struct literals may resolve to wrong fields")
                            print("  colliding fields: '")
                            var acc1_i = ST_FNS[(asi * 128 + afi_c1) as usize]
                            let acc1_e = ST_FNE[(asi * 128 + afi_c1) as usize]
                            while acc1_i < acc1_e { print_char(SRC[acc1_i as usize] as i64); acc1_i = acc1_i + 1 }
                            print("' and '")
                            var acc2_i = ST_FNS[(asi * 128 + afi_c2) as usize]
                            let acc2_e = ST_FNE[(asi * 128 + afi_c2) as usize]
                            while acc2_i < acc2_e { print_char(SRC[acc2_i as usize] as i64); acc2_i = acc2_i + 1 }
                            print("' (hash=")
                            print_int(ST[(abase + 2 + afi_c1) as usize])
                            print(")\n")
                        }
                        afi_c2 = afi_c2 + 1
                    }
                    afi_c1 = afi_c1 + 1
                }
                var fp: i64 = alg_basis_p
                var fi: i64 = 0
                while fi < alg_fc && fp < TC && TK[fp as usize] != 9 {
                    if TK[fp as usize] == 3 && fp + 1 < TC && TK[(fp + 1) as usize] == 43 { break }
                    if TK[fp as usize] == 3 {
                        ST[(abase + 2 + fi) as usize] = gl_name_hash(TS[fp as usize], TE[fp as usize])
                        ST_FNS[(asi * 128 + fi) as usize] = TS[fp as usize]
                        ST_FNE[(asi * 128 + fi) as usize] = TE[fp as usize]
                        ST_FTY[(asi * 128 + fi) as usize] = alg_base_ty
                        ST_FHASH[(asi * 128 + fi) as usize] = 0
                        fi = fi + 1
                    }
                    fp = fp + 1
                }
                ST_LINEAR[asi as usize] = 0
                ST_AFFINE[asi as usize] = 0
                AL_PROPS[asi as usize] = al_props
                ST_COUNT = ST_COUNT + 1
            }
            // Skip to end of algebra block
            while p < TC && TK[p as usize] != 9 && TK[p as usize] != 0 { p = p + 1 }
            if p < TC && TK[p as usize] == 9 { p = p + 1 }
            continue
        }
        // Study block: validate hypothesis presence + set CURRENT_STUDY_EFFECT
        // Functions inside study blocks get implicit Hypothesis effect (bit 256).
        if pass0a_depth == 0 && (TK[p as usize] == 71 || (TK[p as usize] == 3 && src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "study"))) {
            let study_tok = p
            // Pre-scan: walk ahead to check for hypothesis without consuming p
            var sp: i64 = p + 1
            var saw_hypo: i64 = 0
            while sp < TC && TK[sp as usize] != 8 && TK[sp as usize] != 0 { sp = sp + 1 }
            if sp < TC && TK[sp as usize] == 8 {
                var sd: i64 = 1
                sp = sp + 1
                while sp < TC && sd > 0 {
                    if TK[sp as usize] == 3 && src_match(TS[sp as usize], TE[sp as usize] - TS[sp as usize], "hypothesis") {
                        saw_hypo = 1
                        STUDY_HYPO_COUNT = STUDY_HYPO_COUNT + 1
                    }
                    if TK[sp as usize] == 8 { sd = sd + 1 }
                    if TK[sp as usize] == 9 { sd = sd - 1 }
                    sp = sp + 1
                }
            }
            if saw_hypo == 0 {
                tc_mark_failed()
                print("error[E211]: study block requires at least one hypothesis at line ")
                print_int(TL[study_tok as usize])
                print("\n")
            }
            // Set flag and let normal scanning handle the block contents
            CURRENT_STUDY_EFFECT = 256
            p = p + 1  // skip 'study' keyword
            while p < TC && TK[p as usize] != 8 && TK[p as usize] != 0 { p = p + 1 }
            continue
        }
        // Reset study context when closing a top-level study block
        if CURRENT_STUDY_EFFECT != 0 && TK[p as usize] == 9 && pass0a_depth == 1 {
            CURRENT_STUDY_EFFECT = 0
        }
        // Skip + validate ontology declarations — top-level only
        if pass0a_depth == 0 && TK[p as usize] == 72 {
            p = skip_ontology_decl(p)
            continue
        }
        // Trait declaration: trait Name { fn method(self, ...) -> T; ... }
        // Skip the block — trait methods are abstract (no codegen).
        // Register trait name hash with is_trait flag for later impl validation.
        if pass0a_depth == 0 && TK[p as usize] == 75 {
            p = p + 1  // skip 'trait'
            if p < TC && TK[p as usize] == 3 {
                let trait_ns = TS[p as usize]
                let trait_ne = TE[p as usize]
                let trait_hash = gl_name_hash(trait_ns, trait_ne)
                p = p + 1  // skip trait name
                // Register trait as a struct-like entry (for name resolution)
                if ST_COUNT < 1024 {
                    let tsi = ST_COUNT
                    let tbase = tsi * 130
                    ST[tbase as usize] = trait_hash
                    ST_PUBLIC[tsi as usize] = 1
                    ST_DECL_NS[tsi as usize] = trait_ns
                    ST_DECL_NE[tsi as usize] = trait_ne
                    ST[(tbase + 1) as usize] = 0  // no fields
                    ST_LINEAR[tsi as usize] = 0
                    ST_AFFINE[tsi as usize] = 0
                    // Mark as trait via AL_PROPS bit 8
                    AL_PROPS[tsi as usize] = AL_PROPS[tsi as usize] | 256
                    ST_COUNT = ST_COUNT + 1
                }
            }
            // Skip to end of trait block
            if p < TC && TK[p as usize] == 8 { p = p + 1 }
            var trait_depth: i64 = 1
            while p < TC && trait_depth > 0 {
                if TK[p as usize] == 8 { trait_depth = trait_depth + 1 }
                if TK[p as usize] == 9 { trait_depth = trait_depth - 1 }
                p = p + 1
            }
            continue
        }
        // Impl block: impl [TraitName for] TypeName { fn method(self: TypeName, ...) -> T { ... } }
        // Set CURRENT_IMPL_RECV_HASH so fn definitions inside get the receiver hash.
        // DON'T skip the block — let the normal function scanner handle the fn defs.
        if pass0a_depth == 0 && TK[p as usize] == 76 {
            p = p + 1  // skip 'impl'
            // Skip generic params <T> if present on impl (impl<T> Foo<T>)
            if p < TC && TK[p as usize] == 23 {
                var skip_depth: i64 = 1
                p = p + 1
                while p < TC && skip_depth > 0 {
                    if TK[p as usize] == 23 { skip_depth = skip_depth + 1 }
                    if TK[p as usize] == 24 { skip_depth = skip_depth - 1 }
                    if skip_depth > 0 { p = p + 1 }
                }
                if p < TC && TK[p as usize] == 24 { p = p + 1 }
            }
            // Read first identifier — could be TraitName or TypeName
            if p < TC && TK[p as usize] == 3 {
                let impl_ns1 = TS[p as usize]
                let impl_ne1 = TE[p as usize]
                let impl_hash1 = gl_name_hash(impl_ns1, impl_ne1)
                p = p + 1
                var impl_type_hash: i64 = impl_hash1
                // Check for "for" keyword — if present, this is `impl Trait for Type`
                if p < TC && TK[p as usize] == 54 {
                    p = p + 1  // skip 'for'
                    if p < TC && TK[p as usize] == 3 {
                        impl_type_hash = gl_name_hash(TS[p as usize], TE[p as usize])
                        p = p + 1  // skip type name
                    }
                }
                // Skip generic params <T> if present
                if p < TC && TK[p as usize] == 23 {
                    while p < TC && TK[p as usize] != 24 && TK[p as usize] != 0 { p = p + 1 }
                    if p < TC && TK[p as usize] == 24 { p = p + 1 }
                }
                CURRENT_IMPL_RECV_HASH = impl_type_hash
            }
            // Don't skip the block — fall through to let fn scanner handle methods.
            // The { will increment pass0a_depth, } will decrement it.
            // We need to reset CURRENT_IMPL_RECV_HASH when the block ends.
            continue
        }
        // Reset impl context when closing a top-level block
        if CURRENT_IMPL_RECV_HASH != 0 && TK[p as usize] == 9 && pass0a_depth == 1 {
            CURRENT_IMPL_RECV_HASH = 0
        }
        // Struct keyword at depth > 0 is inside a function body — skip (not a top-level decl)
        if pass0a_depth == 0 && (TK[p as usize] == 46 || TK[p as usize] == 49 || TK[p as usize] == 62 || TK[p as usize] == 73) {
            // struct or pub/linear/affine keyword — skip prefix, track linear/affine
            var is_linear_decl: i64 = 0
            var is_affine_decl: i64 = 0
            var is_pub_decl: i64 = 0
            if TK[p as usize] == 49 { is_pub_decl = 1 }
            if TK[p as usize] == 62 { is_linear_decl = 1 }
            if TK[p as usize] == 73 { is_affine_decl = 1 }
            if TK[p as usize] == 49 || TK[p as usize] == 62 || TK[p as usize] == 73 { p = p + 1 }
            if TK[p as usize] == 46 {
                p = p + 1  // skip 'struct'
                let sn_ns = TS[p as usize]
                let sn_ne = TE[p as usize]
                let struct_name_tok = p
                p = p + 1  // skip name
                // Generic templates still need field layouts for inferred struct literals.
                if TK[p as usize] == 23 {
                    while TK[p as usize] != 24 && TK[p as usize] != 0 { p = p + 1 }
                    if TK[p as usize] == 24 { p = p + 1 }
                }
                let sh = gl_name_hash(sn_ns, sn_ne)
                let si = ST_COUNT
                let base = si * 130
                ST[base as usize] = sh
                ST_PUBLIC[si as usize] = is_pub_decl
                ST_DECL_NS[si as usize] = sn_ns
                ST_DECL_NE[si as usize] = sn_ne
                if TK[p as usize] == 8 { p = p + 1 }  // skip {
                var fc: i64 = 0
                while TK[p as usize] != 9 && TK[p as usize] != 0 {
                    if TK[p as usize] == 3 {
                        let fh = gl_name_hash(TS[p as usize], TE[p as usize])
                        let ffi = fc
                        ST[(base + 2 + fc) as usize] = fh
                        ST_FNS[(si * 128 + ffi) as usize] = TS[p as usize]
                        ST_FNE[(si * 128 + ffi) as usize] = TE[p as usize]
                        p = p + 1
                        // Skip : type
                        if TK[p as usize] == 43 {
                            p = p + 1
                            scan_type(p)
                            ST_FTY[(si * 128 + ffi) as usize] = SCAN_TY
                            ST_FHASH[(si * 128 + ffi) as usize] = SCAN_TY_HASH
                            p = SCAN_TY_NEXT
                        } else {
                            ST_FTY[(si * 128 + ffi) as usize] = 0
                            ST_FHASH[(si * 128 + ffi) as usize] = 0
                        }
                        fc = fc + 1
                        // Skip comma
                        if TK[p as usize] == 28 { p = p + 1 }
                        continue
                    }
                    p = p + 1
                }
                ST[(base + 1) as usize] = fc
                var ffi_c1: i64 = 0
                while ffi_c1 < fc {
                    var ffi_c2: i64 = ffi_c1 + 1
                    while ffi_c2 < fc {
                        if ST[(base + 2 + ffi_c1) as usize] == ST[(base + 2 + ffi_c2) as usize] {
                            tc_error(struct_name_tok, "struct field hash collision detected — struct literals may resolve to wrong fields")
                            // Print the colliding field names for diagnosis
                            print("  colliding fields: '")
                            var cc1_i = ST_FNS[(si * 128 + ffi_c1) as usize]
                            let cc1_e = ST_FNE[(si * 128 + ffi_c1) as usize]
                            while cc1_i < cc1_e { print_char(SRC[cc1_i as usize] as i64); cc1_i = cc1_i + 1 }
                            print("' and '")
                            var cc2_i = ST_FNS[(si * 128 + ffi_c2) as usize]
                            let cc2_e = ST_FNE[(si * 128 + ffi_c2) as usize]
                            while cc2_i < cc2_e { print_char(SRC[cc2_i as usize] as i64); cc2_i = cc2_i + 1 }
                            print("' (hash=")
                            print_int(ST[(base + 2 + ffi_c1) as usize])
                            print(")\n")
                        }
                        ffi_c2 = ffi_c2 + 1
                    }
                    ffi_c1 = ffi_c1 + 1
                }
                // Propagate: if any field is a linear struct, this struct is implicitly linear
                var ffi3: i64 = 0
                while ffi3 < fc {
                    if ST_FTY[(si * 128 + ffi3) as usize] == 6 {
                        let fsi3 = st_find(ST_FHASH[(si * 128 + ffi3) as usize])
                        if fsi3 >= 0 && ST_LINEAR[fsi3 as usize] == 1 { is_linear_decl = 1 }
                    }
                    ffi3 = ffi3 + 1
                }
                ST_LINEAR[si as usize] = is_linear_decl
                ST_AFFINE[si as usize] = is_affine_decl
                ST_COUNT = ST_COUNT + 1
                if TK[p as usize] == 9 { p = p + 1 }
                continue
            }
        }
        p = p + 1
    }
    resolve_forward_struct_types()
    var rec_si: i64 = 0
    while rec_si < ST_COUNT {
        let rec_base = rec_si * 130
        let rec_hash = ST[rec_base as usize]
        let rec_fields = ST[(rec_base + 1) as usize]
        var rec_fi: i64 = 0
        while rec_fi < rec_fields {
            if ST_FTY[(rec_si * 128 + rec_fi) as usize] == 6 && ST_FHASH[(rec_si * 128 + rec_fi) as usize] == rec_hash {
                print("error[E216]: infinite recursive type\n")
                tc_mark_failed()
                rec_fi = rec_fields
            } else {
                rec_fi = rec_fi + 1
            }
        }
        rec_si = rec_si + 1
    }
    print("st_count: "); print_int(ST_COUNT); print(" depth_end: "); print_int(pass0a_depth); print("\n")
    // Also scan enums in the same pass
    p = 0
    EN_COUNT = 0
    while p < TC {
        if TK[p as usize] == 47 {
            p = p + 1  // skip 'enum'
            let en_ns = TS[p as usize]
            let en_ne = TE[p as usize]
            let eh = gl_name_hash(en_ns, en_ne)
            let ei = EN_COUNT
            let base = ei * 256
            EN[base as usize] = eh
            p = p + 1  // skip name
            if TK[p as usize] == 8 { p = p + 1 }  // skip {
            var vc: i64 = 0
            var inner_depth: i64 = 0
            // Limit: scan at most 500 tokens for enum variants (prevents runaway on parse errors)
            var enum_scan_limit: i64 = 500
            while p < TC && (TK[p as usize] != 9 || inner_depth > 0) && enum_scan_limit > 0 {
                if TK[p as usize] == 8 {
                    inner_depth = inner_depth + 1
                    p = p + 1
                    enum_scan_limit = enum_scan_limit - 1
                    continue
                }
                if TK[p as usize] == 9 {
                    inner_depth = inner_depth - 1
                    p = p + 1
                    enum_scan_limit = enum_scan_limit - 1
                    continue
                }
                if inner_depth == 0 && TK[p as usize] == 3 && vc < 254 {
                    let vh = gl_name_hash(TS[p as usize], TE[p as usize])
                    EN[(base + 2 + vc) as usize] = vh
                    vc = vc + 1
                }
                p = p + 1
                enum_scan_limit = enum_scan_limit - 1
            }
            EN[(base + 1) as usize] = vc
            EN_COUNT = EN_COUNT + 1
            if TK[p as usize] == 9 { p = p + 1 }
            continue
        }
        p = p + 1
    }
    resolve_forward_struct_types()
    p = 0

    // Pass 0c+0d: monomorphization (in separate function to limit stack usage)
    mono_pass()
    p = 0
    // Pass 0b: register global variables
    var depth: i64 = 0
    var open_tok: i64 = 0       // the `{` that took depth 0 -> 1 in this module
    var reported: i64 = 0       // at most one brace diagnostic per module
    while p < TC {
        let tk = TK[p as usize]
        if tk == 8 {
            if depth == 0 { open_tok = p }
            depth = depth + 1
            p = p + 1
            continue
        }
        if tk == 9 {
            // Clamped, matching Pass 0a. Unclamped, one stray `}` pins depth
            // negative for the whole remaining token stream, and every later
            // function-body `var` is treated as a global (#1634). Clamping
            // alone would make the stray `}` invisible, so it is reported here
            // -- at the offending token, which is the useful place.
            if depth > 0 {
                depth = depth - 1
            } else {
                if reported == 0 { tc_unbalanced_braces(p, 0 - 1)  reported = 1 }
            }
            p = p + 1
            continue
        }
        // File boundary (TK==77). Modules are independently balanced, so depth
        // must not carry across one. Pass 0a already resets here; these three
        // scanners did not, which is what let one file's imbalance poison the
        // rest of the bundle -- and made the three disagree about which `var`s
        // are global, between registration and initializer emission.
        if tk == 77 {
            if depth > 0 {
                if reported == 0 { tc_unbalanced_braces(open_tok, depth) }
            }
            depth = 0
            reported = 0
            p = p + 1
            continue
        }
        if depth > 0 { p = p + 1; continue }
        // Top-level var
        if tk == 12 {
            p = p + 1
            let gns = TS[p as usize]
            let gne = TE[p as usize]
            p = p + 1
            // Expect : type
            if TK[p as usize] == 43 {
                p = p + 1
                let tns = TS[p as usize]
                let tne = TE[p as usize]
                // Check if [TYPE; N] array
                if TK[p as usize] == 41 {
                    // [TYPE; N]
                    p = p + 1
                    let etns = TS[p as usize]
                    let etne = TE[p as usize]
                    let elem_ty = type_name_kind(etns, etne)
                    var elem_hash: i64 = 0
                    if elem_ty == 6 || elem_ty == 7 { elem_hash = gl_name_hash(etns, etne) }
                    var esiz: i64 = 8
                    if src_match(etns, etne - etns, "i8") { esiz = 1 }
                    if elem_ty == 6 || elem_ty == 7 { esiz = struct_like_nslots(elem_hash) * 8 }
                    p = p + 1
                    // Skip ;
                    if TK[p as usize] == 27 { p = p + 1 }
                    // Array length
                    let alen = TV[p as usize]
                    p = p + 1
                    // Skip ]
                    if TK[p as usize] == 42 { p = p + 1 }
                    let gix = gl_add(gns, gne, esiz, alen)
                    if gix >= 0 {
                        GL_TY[gix as usize] = 8
                        GL_TY_HASH[gix as usize] = arr_ty_hash_for_elem_type(alen, esiz, elem_ty, elem_hash)
                    }
                } else {
                    // Scalar: i64, i32, bool, string
                    scan_type(p)
                    var scalar_bytes: i64 = 8
                    if type_is_option_inline(SCAN_TY, SCAN_TY_HASH) { scalar_bytes = 16 }
                    if type_is_struct_like(SCAN_TY, SCAN_TY_HASH) || knowledge_hash_is(SCAN_TY_HASH) {
                        scalar_bytes = struct_like_nslots(SCAN_TY_HASH) * 8
                    }
                    let gix = gl_add(gns, gne, scalar_bytes, 0)
                    if gix >= 0 {
                        GL_TY[gix as usize] = SCAN_TY
                        GL_TY_HASH[gix as usize] = SCAN_TY_HASH
                    }
                    p = SCAN_TY_NEXT
                }
            }
            // Skip = initializer until next var or fn or file boundary or EOF. This
            // walks past arbitrary tokens INCLUDING braces, so it has to carry the
            // depth with it -- otherwise a top-level `var` followed by an
            // `impl Foo { ... }` swallows the opening brace and stops at the `fn`
            // inside the impl with depth still 0 (#1634).
            while p < TC && TK[p as usize] != 12 && TK[p as usize] != 1 && TK[p as usize] != 0 && TK[p as usize] != 77 {
                if TK[p as usize] == 8 { depth = depth + 1 }
                if TK[p as usize] == 9 {
                    if depth > 0 { depth = depth - 1 }
                }
                p = p + 1
            }
            continue
        }
        p = p + 1
    }
    // The last module has no trailing boundary marker. Report at the unmatched
    // `{` rather than at the end of the stream: the tail of the bundle is the
    // appended native prelude, whose line numbers mean nothing to the author.
    if depth > 0 {
        if reported == 0 { tc_unbalanced_braces(open_tok, depth) }
    }
    p = 0

    GPU_EMU_THREAD_ID_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_STATE_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_DIAG_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_LIBCUDA_HANDLE_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_DEVICE_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CTX_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CUINIT_PTR_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CUDEVICEGET_PTR_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CUCTXCREATE_PTR_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CUCTXSYNC_PTR_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CUMODULELOADDATA_PTR_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CUMODULEGETFUNCTION_PTR_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CUMEMALLOC_PTR_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CUMEMFREE_PTR_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CUMEMCPYHTOD_PTR_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CUMEMCPYDTOH_PTR_BSS_OFF = bss_alloc_aligned(8)
    GPU_RT_CULAUNCHKERNEL_PTR_BSS_OFF = bss_alloc_aligned(8)
    B5_RET_VSHADOW_BSS_OFF = bss_alloc_aligned(8)
    B5_ARG_VSHADOW_BSS_OFF = bss_alloc_aligned(128)
    AST_ARENA_BASE_BSS_OFF = bss_alloc_aligned(8)
    AST_ARENA_CURSOR_BSS_OFF = bss_alloc_aligned(8)
    AST_ARENA_LIMIT_BSS_OFF = bss_alloc_aligned(8)
    AGG_POOL_BASE_BSS_OFF = bss_alloc_aligned(8)
    AGG_POOL_CURSOR_BSS_OFF = bss_alloc_aligned(8)
    AGG_POOL_LIMIT_BSS_OFF = bss_alloc_aligned(8)
    RTMMAP_COUNT_BSS_OFF = bss_alloc_aligned(8)
    RTMMAP_BYTES_BSS_OFF = bss_alloc_aligned(8)
    READFILE_SCRATCH_BSS_OFF = bss_alloc_aligned(8)
    ARENA_REFILL_COUNT_BSS_OFF = bss_alloc_aligned(8)
    ARENA_REFILL_BYTES_BSS_OFF = bss_alloc_aligned(8)
    ARENA_UNMAP_COUNT_BSS_OFF = bss_alloc_aligned(8)
    ARENA_UNMAP_BYTES_BSS_OFF = bss_alloc_aligned(8)
    POOL_REFILL_COUNT_BSS_OFF = bss_alloc_aligned(8)
    POOL_REFILL_BYTES_BSS_OFF = bss_alloc_aligned(8)
    PTX_LEN = 0
    NEEDS_GPU_RUNTIME_DYNLINK = 0
    // R15 Runtime Tag Stack: reserve BSS for side table (up to 16384 call sites × 8 bytes)
    if CLI_R15_MONITOR != 0 {
        R15_SIDE_TABLE_BSS_OFF = bss_alloc_aligned(16384 * 8)
    }

    // BSS layout: [argc(8)] [argv(8)] [globals...] [aggregate return scratch]
    RET_AGG_BSS_OFF = GL_BSS_SIZE
    GL_BSS_SIZE = GL_BSS_SIZE + 1048576  // 1MB scratch for aggregate (struct/array) returns
    // Add 16 to BSS_BASE so globals start at BSS+16, but argc/argv at BSS+0.
    // The lean_single Mach-O path bakes absolute BSS addresses into emitted code,
    // so macOS needs a generous fixed gap between __TEXT and __DATA.
    if TARGET_OS == 2 {
        GL_BSS_BASE = 0x101000000 + 16    // macOS: __DATA segment at 0x101000000
    } else {
        GL_BSS_BASE = 0x10000000 + 16     // Linux/Windows: BSS at 0x10000000 (256MB, never overlaps code)
    }
    GL_BSS_SIZE = GL_BSS_SIZE + 16

    print("globals: "); print_int(GL_COUNT); print(" bss="); print_int(GL_BSS_SIZE); print("\n")

    // Pass 1: register all function names (skip generic templates)
    while p < TC {
        // Skip trait declarations — trait methods are abstract signatures, not fn defs.
        if TK[p as usize] == 75 {
            p = p + 1  // skip 'trait'
            if p < TC && TK[p as usize] == 3 { p = p + 1 }  // skip name
            if p < TC && TK[p as usize] == 8 {
                p = p + 1
                var trait_skip_depth1: i64 = 1
                while p < TC && trait_skip_depth1 > 0 {
                    if TK[p as usize] == 8 { trait_skip_depth1 = trait_skip_depth1 + 1 }
                    if TK[p as usize] == 9 { trait_skip_depth1 = trait_skip_depth1 - 1 }
                    p = p + 1
                }
            }
            continue
        }
        if TK[p as usize] == 1 && TK[(p + 1) as usize] == 3 {
            FN_IS_KERNEL[FN_COUNT as usize] = 0
            if token_is_kernel_marker(p - 1) { FN_IS_KERNEL[FN_COUNT as usize] = 1 }
            ptx_reset_fn_meta(FN_COUNT)
            p = p + 1
            // Skip generic function templates — match the same logic as Pass 2
            if p + 2 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 3) as usize] == 24 {
                while p < TC && TK[p as usize] != 8 { p = p + 1 }
                var gd: i64 = 1
                p = p + 1
                while p < TC && gd > 0 { if TK[p as usize] == 8 { gd = gd + 1 }; if TK[p as usize] == 9 { gd = gd - 1 }; p = p + 1 }
                continue
            }
            if FN_COUNT < 65535 {
                FN_NS[FN_COUNT as usize] = TS[p as usize]
                FN_NE[FN_COUNT as usize] = TE[p as usize]
                FN_OFF[FN_COUNT as usize] = -1
                FN_COUNT = FN_COUNT + 1
            }
        }
        p = p + 1
    }

    p = 0
    var sig_fi: i64 = 0
    var sig_study_depth: i64 = 0   // >0 means we're inside a study block
    var sig_impl_hash: i64 = 0     // receiver hash for impl blocks
    var sig_impl_depth: i64 = 0    // brace depth while inside an impl block
    var sig_impl_pending_open: i64 = 0
    while p < TC {
        // Skip trait declarations — trait methods are abstract signatures, not fn defs.
        if sig_impl_depth == 0 && TK[p as usize] == 75 {
            p = p + 1  // skip 'trait'
            if p < TC && TK[p as usize] == 3 { p = p + 1 }  // skip name
            if p < TC && TK[p as usize] == 8 {
                p = p + 1
                var trait_skip_depth2: i64 = 1
                while p < TC && trait_skip_depth2 > 0 {
                    if TK[p as usize] == 8 { trait_skip_depth2 = trait_skip_depth2 + 1 }
                    if TK[p as usize] == 9 { trait_skip_depth2 = trait_skip_depth2 - 1 }
                    p = p + 1
                }
            }
            continue
        }
        if TK[p as usize] == 77 {
            sig_impl_hash = 0
            sig_impl_depth = 0
            sig_impl_pending_open = 0
            sig_study_depth = 0
            p = p + 1
            continue
        }
        if sig_impl_depth > 0 {
            if TK[p as usize] == 8 {
                if sig_impl_pending_open != 0 {
                    sig_impl_pending_open = 0
                } else {
                    sig_impl_depth = sig_impl_depth + 1
                }
            }
            if TK[p as usize] == 9 {
                sig_impl_depth = sig_impl_depth - 1
                if sig_impl_depth == 0 {
                    sig_impl_hash = 0
                    sig_impl_pending_open = 0
                }
            }
        }
        // Track study block depth for implicit Hypothesis effect
        if TK[p as usize] == 71 || (TK[p as usize] == 3 && src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "study")) {
            // Find opening { of study block to set study_depth
            var sq: i64 = p + 1
            while sq < TC && TK[sq as usize] != 8 && TK[sq as usize] != 0 { sq = sq + 1 }
            if sq < TC && TK[sq as usize] == 8 { sig_study_depth = 1 }
            // Don't skip — let normal loop iteration continue
        }
        if sig_study_depth > 0 {
            if TK[p as usize] == 8 { sig_study_depth = sig_study_depth + 1 }
            if TK[p as usize] == 9 { sig_study_depth = sig_study_depth - 1 }
        }
        // Track impl block for receiver hash
        if TK[p as usize] == 76 {
            var iq: i64 = p + 1
            // Skip generic params <T> if present on impl (impl<T> Foo<T>)
            if iq < TC && TK[iq as usize] == 23 {
                var skip_depth: i64 = 1
                iq = iq + 1
                while iq < TC && skip_depth > 0 {
                    if TK[iq as usize] == 23 { skip_depth = skip_depth + 1 }
                    if TK[iq as usize] == 24 { skip_depth = skip_depth - 1 }
                    if skip_depth > 0 { iq = iq + 1 }
                }
                if iq < TC && TK[iq as usize] == 24 { iq = iq + 1 }
            }
            if iq < TC && TK[iq as usize] == 3 {
                var ih: i64 = gl_name_hash(TS[iq as usize], TE[iq as usize])
                iq = iq + 1
                if iq < TC && TK[iq as usize] == 54 {
                    iq = iq + 1
                    if iq < TC && TK[iq as usize] == 3 { ih = gl_name_hash(TS[iq as usize], TE[iq as usize]) }
                }
                sig_impl_hash = ih
                sig_impl_depth = 1
                sig_impl_pending_open = 1
            }
        }
        if TK[p as usize] == 1 && TK[(p + 1) as usize] == 3 {
            // Detect pub visibility (previous token == 49) and import origin
            let fn_is_pub = p > 0 && TK[(p - 1) as usize] == 49
            let fn_from_import = TS[p as usize] >= MAIN_SRC_END && MAIN_SRC_END > 0
            p = p + 1
            // Skip generic function templates — must match Pass 2 logic exactly
            if p + 2 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 3) as usize] == 24 {
                while p < TC && TK[p as usize] != 8 { p = p + 1 }
                var gd: i64 = 1
                p = p + 1
                while p < TC && gd > 0 { if TK[p as usize] == 8 { gd = gd + 1 }; if TK[p as usize] == 9 { gd = gd - 1 }; p = p + 1 }
                continue
            }
            FN_NAME_TOK[sig_fi as usize] = p
            FN_SIG[sig_fi as usize] = fnsig_from_decl_name_tok(p)
            FN_NEEDS_SESSION[sig_fi as usize] = 0
            FN_ARITY[sig_fi as usize] = 0
            FN_IN_IMPL[sig_fi as usize] = 0
            FN_RET_TY[sig_fi as usize] = 5
            FN_RET_HASH[sig_fi as usize] = 0
            var q: i64 = p + 1
            if TK[q as usize] == 6 { q = q + 1 }
            while TK[q as usize] != 7 && TK[q as usize] != 0 {
                if TK[q as usize] == 3 {
                    let is_first_param = FN_ARITY[sig_fi as usize] == 0
                    FN_ARITY[sig_fi as usize] = FN_ARITY[sig_fi as usize] + 1
                    q = q + 1
                    if TK[q as usize] == 43 {
                        q = q + 1
                        if TK[q as usize] == 3 && src_match(TS[q as usize], TE[q as usize] - TS[q as usize], "chan") {
                            FN_NEEDS_SESSION[sig_fi as usize] = 1
                        }
                        scan_type(q)
                        if is_first_param {
                            if SCAN_TY == 6 {
                                FN_RECV_HASH[sig_fi as usize] = SCAN_TY_HASH
                            } else if SCAN_TY == 10 {
                                let inner_ty = ref_hash_inner_ty(SCAN_TY_HASH)
                                let inner_hash = ref_hash_inner_hash(SCAN_TY_HASH)
                                if inner_ty == 6 {
                                    FN_RECV_HASH[sig_fi as usize] = inner_hash
                                }
                            }
                        }
                        if knowledge_hash_invalid(SCAN_TY_HASH) {
                            tc_epistemic_boundary(q)
                        }
                        q = SCAN_TY_NEXT
                    }
                } else {
                    q = q + 1
                }
                if TK[q as usize] == 28 { q = q + 1 }
            }
            if TK[q as usize] == 7 { q = q + 1 }
            if TK[q as usize] == 10 {
                q = q + 1
                if TK[q as usize] == 3 && src_match(TS[q as usize], TE[q as usize] - TS[q as usize], "chan") {
                    FN_NEEDS_SESSION[sig_fi as usize] = 1
                }
                // PR-6: record return-type token for Pass 1c.5 refinement re-scan
                FN_RET_TY_TOK[sig_fi as usize] = q
                scan_type(q)
                // scan_type()'s tuple branch now scans every element itself (not
                // just first+last) and registers the full per-element array to
                // TUP_CACHE directly, so no rescan is needed here — a prior
                // version of this code re-derived a 2-element-only hash from
                // scratch at this point, which silently truncated any 3+-element
                // tuple return type's total slot count (Bug G / issue #601).
                if knowledge_hash_invalid(SCAN_TY_HASH) {
                    tc_epistemic_boundary(q)
                    FN_RET_TY[sig_fi as usize] = 0
                    FN_RET_HASH[sig_fi as usize] = 0
                } else {
                    FN_RET_TY[sig_fi as usize] = SCAN_TY
                    FN_RET_HASH[sig_fi as usize] = SCAN_TY_HASH
                    // PR-5/PR-10: save refinement predicate on return type for compile-time checking.
                    if SCAN_HAS_PRED == 1 {
                        FN_RET_HAS_PRED[sig_fi as usize] = 1
                        FN_RET_PRED_OP[sig_fi as usize] = SCAN_PRED_OP
                        FN_RET_PRED_BOUND[sig_fi as usize] = SCAN_PRED_BOUND
                        FN_RET_PRED_IS_F64[sig_fi as usize] = SCAN_PRED_IS_F64
                        FN_RET_PRED_BOUND_FRAC[sig_fi as usize] = SCAN_PRED_BOUND_FRAC
                        FN_RET_PRED_BOUND_DENOM[sig_fi as usize] = SCAN_PRED_BOUND_DENOM
                        if SCAN_HAS_PRED2 == 1 {
                            FN_RET_HAS_PRED2[sig_fi as usize] = 1
                            FN_RET_PRED_OP2[sig_fi as usize] = SCAN_PRED_OP2
                            FN_RET_PRED_BOUND2[sig_fi as usize] = SCAN_PRED_BOUND2
                            FN_RET_PRED_IS_F64_2[sig_fi as usize] = SCAN_PRED_IS_F64_2
                            FN_RET_PRED_BOUND2_FRAC[sig_fi as usize] = SCAN_PRED_BOUND2_FRAC
                            FN_RET_PRED_BOUND2_DENOM[sig_fi as usize] = SCAN_PRED_BOUND2_DENOM
                        }
                    }
                }
                q = SCAN_TY_NEXT
            }
            q = skip_signature_where_clause(q)
            // Impl block: if we're inside an impl, force receiver hash
            if sig_impl_hash != 0 {
                FN_RECV_HASH[sig_fi as usize] = sig_impl_hash
                FN_IN_IMPL[sig_fi as usize] = 1
            }
            // Study block: functions inside get implicit Hypothesis effect (bit 256)
            if sig_study_depth > 0 {
                FN_EFFECTS[sig_fi as usize] = FN_EFFECTS[sig_fi as usize] | 256
            }
            // Visibility tracking: bit 10 = pub, bit 11 = from_import
            if fn_is_pub { FN_EFFECTS[sig_fi as usize] = FN_EFFECTS[sig_fi as usize] | 1024 }
            if fn_from_import { FN_EFFECTS[sig_fi as usize] = FN_EFFECTS[sig_fi as usize] | 2048 }
            var dup_i: i64 = 0
            while dup_i < sig_fi {
                if name_eq(FN_NS[dup_i as usize], FN_NE[dup_i as usize], FN_NS[sig_fi as usize], FN_NE[sig_fi as usize]) {
                    if FN_ARITY[dup_i as usize] != FN_ARITY[sig_fi as usize] {
                        // Same name, different arity. Free-call resolution
                        // (fn_find) is name-only — it ignores FN_RECV_HASH — so it
                        // will resolve calls to the wrong-arity definition and
                        // silently miscompile. Safe ONLY when BOTH defs are true
                        // impl-block methods on distinct receivers: those are
                        // dot-called through the recv-aware fn_find_method and
                        // never collide. Anything else (two free fns, a free fn
                        // vs a method, or UFCS free fns with struct receivers) is
                        // a bundle-structural error.
                        let both_methods = FN_IN_IMPL[dup_i as usize] == 1 && FN_IN_IMPL[sig_fi as usize] == 1
                        if both_methods && FN_RECV_HASH[dup_i as usize] != FN_RECV_HASH[sig_fi as usize] {
                            // legit method overloading across distinct types
                        } else {
                            tc_conflicting_arity_fn(FN_NAME_TOK[sig_fi as usize])
                        }
                    } else {
                        // Same name, same arity. Preserve prior behavior: a soft
                        // warning only when the receiver also matches (e.g. every
                        // module's 0-arg `run_tests`); distinct-receiver methods
                        // are fine.
                        if FN_RECV_HASH[dup_i as usize] == FN_RECV_HASH[sig_fi as usize] {
                            tc_duplicate_fn(FN_NAME_TOK[sig_fi as usize])
                        }
                    }
                }
                dup_i = dup_i + 1
            }
            if sig_fi < FN_COUNT { sig_fi = sig_fi + 1 }
        }
        p = p + 1
    }

    // Refine unsized array return signatures from direct top-level `return [ ... ]` literals.
    p = 0
    var ret_fi: i64 = 0
    while p < TC {
        // Skip trait declarations — must match Pass 1 / sig-pass trait skip so ret_fi
        // stays aligned with the FN_* index space (trait bodyless methods aren't registered).
        if TK[p as usize] == 75 {
            p = p + 1  // skip 'trait'
            if p < TC && TK[p as usize] == 3 { p = p + 1 }  // skip name
            if p < TC && TK[p as usize] == 8 {
                p = p + 1
                var trait_skip_depth3: i64 = 1
                while p < TC && trait_skip_depth3 > 0 {
                    if TK[p as usize] == 8 { trait_skip_depth3 = trait_skip_depth3 + 1 }
                    if TK[p as usize] == 9 { trait_skip_depth3 = trait_skip_depth3 - 1 }
                    p = p + 1
                }
            }
            continue
        }
        if TK[p as usize] == 1 && TK[(p + 1) as usize] == 3 {
            p = p + 1
            if p + 2 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 3) as usize] == 24 { p = p + 1; continue }
            var q: i64 = p + 1
            if TK[q as usize] == 6 { q = q + 1 }
            while q < TC && TK[q as usize] != 8 { q = q + 1 }
            if FN_RET_TY[ret_fi as usize] == 8 && arr_hash_alen(FN_RET_HASH[ret_fi as usize]) == 0 {
                let ret_esiz = arr_hash_esiz(FN_RET_HASH[ret_fi as usize])
                let ret_elem_ty = arr_hash_elem_ty(FN_RET_HASH[ret_fi as usize])
                let ret_elem_hash = arr_hash_elem_hash(FN_RET_HASH[ret_fi as usize])
                var bd: i64 = 0
                if TK[q as usize] == 8 { bd = 1; q = q + 1 }
                while q < TC && bd > 0 {
                    if TK[q as usize] == 8 { bd = bd + 1; q = q + 1; continue }
                    if TK[q as usize] == 9 { bd = bd - 1; q = q + 1; continue }
                    if bd == 1 && TK[q as usize] == 2 && TK[(q + 1) as usize] == 41 {
                        let ret_alen = array_lit_count(q + 1)
                        if ret_alen > 0 {
                            FN_RET_HASH[ret_fi as usize] = arr_ty_hash_for_elem_type(ret_alen, ret_esiz, ret_elem_ty, ret_elem_hash)
                        }
                        q = TC
                        bd = 0
                        continue
                    }
                    q = q + 1
                }
            }
            if ret_fi < FN_COUNT { ret_fi = ret_fi + 1 }
        }
        p = p + 1
    }

    // Pass 1b: scan effects clauses for each function
    // For each fn at index fi, scan forward from its name token to find 'with' (38)
    // and record effect bitmask: IO=1, Mut=2, Panic=4, Div=8, Alloc=16,
    // Observe=64, Audit=128, Hypothesis=256
    p = 0
    var eff_fi: i64 = 0
    while p < TC {
        // Skip trait declarations — must match Pass 1 / sig-pass trait skip so eff_fi
        // stays aligned with the FN_* index space (trait bodyless methods aren't registered).
        if TK[p as usize] == 75 {
            p = p + 1  // skip 'trait'
            if p < TC && TK[p as usize] == 3 { p = p + 1 }  // skip name
            if p < TC && TK[p as usize] == 8 {
                p = p + 1
                var trait_skip_depth4: i64 = 1
                while p < TC && trait_skip_depth4 > 0 {
                    if TK[p as usize] == 8 { trait_skip_depth4 = trait_skip_depth4 + 1 }
                    if TK[p as usize] == 9 { trait_skip_depth4 = trait_skip_depth4 - 1 }
                    p = p + 1
                }
            }
            continue
        }
        if TK[p as usize] == 1 && TK[(p + 1) as usize] == 3 {
            p = p + 1
            // Skip generic templates
            if p + 2 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 3) as usize] == 24 { p = p + 1; continue }
            // Scan forward to find { (start of body) — mirror the ew algorithm so that
            // refinement types in parameter or return position don't misfire.
            var eq: i64 = p + 1
            // Skip parameter list
            if TK[eq as usize] == 6 {
                var eq_depth: i64 = 1
                eq = eq + 1
                while eq < TC && eq_depth > 0 {
                    if TK[eq as usize] == 6 { eq_depth = eq_depth + 1 }
                    if TK[eq as usize] == 7 { eq_depth = eq_depth - 1 }
                    eq = eq + 1
                }
            }
            // Skip -> return type (scan_type handles refinement braces correctly)
            if TK[eq as usize] == 10 {
                eq = eq + 1
                scan_type(eq)
                eq = SCAN_TY_NEXT
            }
            // Skip where clause
            eq = skip_signature_where_clause(eq)
            // Skip with effects clause
            if TK[eq as usize] == 38 {
                eq = eq + 1
                while eq < TC && (TK[eq as usize] == 3 || TK[eq as usize] == 28) {
                    if TK[eq as usize] == 3 {
                        eq = eq + 1
                        if TK[eq as usize] == 6 {
                            eq = eq + 1
                            while eq < TC && TK[eq as usize] != 7 && TK[eq as usize] != 0 { eq = eq + 1 }
                            if TK[eq as usize] == 7 { eq = eq + 1 }
                        }
                    } else { eq = eq + 1 }
                }
            }
            // eq now points at the body { — or past it for bodyless declarations
            // (e.g. `fn pick() -> bool` inside `effect Choice { ... }`).
            // Use -1 as sentinel so the compilation loop can skip silently.
            if TK[eq as usize] != 8 { eq = 0 - 1 }
            if eff_fi < FN_COUNT {
                FN_BODY_OPEN[eff_fi as usize] = eq
                FN_BODY_CLOSE[eff_fi as usize] = if eq >= 0 { find_matching_body_close(eq) } else { 0 - 1 }
            }
            // Scan only the function's own top-level `with`, not nested effect
            // clauses inside function-typed parameters or return types.
            var ew: i64 = p + 1
            if TK[ew as usize] == 6 {
                var depth: i64 = 1
                ew = ew + 1
                while ew < eq && depth > 0 {
                    if TK[ew as usize] == 6 { depth = depth + 1 }
                    if TK[ew as usize] == 7 { depth = depth - 1 }
                    ew = ew + 1
                }
            }
            if TK[ew as usize] == 10 {
                ew = ew + 1
                scan_type(ew)
                ew = SCAN_TY_NEXT
            }
            ew = skip_signature_where_clause(ew)
            if TK[ew as usize] == 38 {
                ew = ew + 1
                while ew < eq && (TK[ew as usize] == 3 || TK[ew as usize] == 28) {
                    if TK[ew as usize] == 3 {
                        let ens = TS[ew as usize]
                        let ene = TE[ew as usize]
                        var matched_builtin: i64 = 0
                        if src_match(ens, ene - ens, "IO") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 1; matched_builtin = 1 }
                        if src_match(ens, ene - ens, "Mut") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 2; matched_builtin = 1 }
                        if src_match(ens, ene - ens, "Panic") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 4; matched_builtin = 1 }
                        if src_match(ens, ene - ens, "Div") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 8; matched_builtin = 1 }
                        if src_match(ens, ene - ens, "Alloc") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 16; matched_builtin = 1 }
                        if src_match(ens, ene - ens, "Observe") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 64; matched_builtin = 1 }
                        if src_match(ens, ene - ens, "Audit") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 128; matched_builtin = 1 }
                        if src_match(ens, ene - ens, "Hypothesis") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 256; matched_builtin = 1 }
                        // Gen 19: Deterministic = bit 12 (4096) — function cannot call IO
                        if src_match(ens, ene - ens, "Deterministic") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 4096; matched_builtin = 1 }
                        // Gen 20: GPU = bit 13 (8192) — function uses GPU dispatch (excluded from & 1023 call-site check)
                        if src_match(ens, ene - ens, "GPU") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 8192; matched_builtin = 1 }
                        // ZD = bit 14 (16384) — zero-divisor effect for sedenion-based exact erasure
                        if src_match(ens, ene - ens, "ZD") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 16384; matched_builtin = 1 }
                        // Witness = bit 15 (32768) — required alongside ZD by Audited<T>
                        if src_match(ens, ene - ens, "Witness") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 32768; matched_builtin = 1 }
                        // Temporal = bit 16 (65536) — required alongside ZD by Revivable<T>
                        if src_match(ens, ene - ens, "Temporal") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 65536; matched_builtin = 1 }
                        // Learn = bit 17 (131072) — gradient-producing functions consumed by SurgicalOptimizer
                        if src_match(ens, ene - ens, "Learn") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 131072; matched_builtin = 1 }
                        // Approx = bit 18 (262144) — numerical approximation tracking
                        if src_match(ens, ene - ens, "Approx") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 262144; matched_builtin = 1 }
                        // Causal = bit 19 (524288) — causal inference effect
                        if src_match(ens, ene - ens, "Causal") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 524288; matched_builtin = 1 }
                        // NaturalityG2 = bit 20 (1048576) — homology functor F: C_dial → C_𝕆
                        if src_match(ens, ene - ens, "NaturalityG2") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 1048576; matched_builtin = 1 }
                        // Gen 21 Phase A″: Confidence(N) is a reader-friendly alias for
                        // Epistemic(N). Same bit, same FN_EPISTEMIC_MIN slot. N is an
                        // integer on the 1..1000 scale (matches Knowledge<T>.confidence).
                        if src_match(ens, ene - ens, "Confidence") || src_match(ens, ene - ens, "Epistemic") {
                            FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 512
                            matched_builtin = 1
                            // Gen 17 D2: check for Epistemic(N) / Confidence(N) — parameterized min confidence
                            if ew + 1 < eq && TK[(ew + 1) as usize] == 6 {  // '(' follows
                                var ep: i64 = ew + 2  // skip past '('
                                var min_val: i64 = 0
                                while ep < eq && TK[ep as usize] == 4 {
                                    min_val = TV[ep as usize]
                                    ep = ep + 1
                                }
                                if min_val > 0 && min_val <= 1000 {
                                    FN_EPISTEMIC_MIN[eff_fi as usize] = min_val
                                }
                                while ew < eq && TK[ew as usize] != 7 { ew = ew + 1 }
                            }
                        }
                        if matched_builtin == 0 { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 32 }
                    }
                    ew = ew + 1
                }
            }
            // Gen 19: Deterministic × IO conflict — Deterministic function cannot declare IO
            if eff_fi < FN_COUNT && (FN_EFFECTS[eff_fi as usize] & 4096) != 0 && (FN_EFFECTS[eff_fi as usize] & 1) != 0 {
                print("error[E080]: Deterministic function declares IO effect at line ")
                print_int(TL[FN_NAME_TOK[eff_fi as usize] as usize])
                print(" — Deterministic functions cannot perform I/O\n")
                tc_mark_failed()
            }
            // E070/E072: Kernel function validation
            if eff_fi < FN_COUNT && FN_IS_KERNEL[eff_fi as usize] != 0 {
                let kernel_eff = FN_EFFECTS[eff_fi as usize]
                // E070: kernel cannot have IO, Mut, or Alloc effects
                if (kernel_eff & 1) != 0 { tc_kernel_invalid_effect(FN_NAME_TOK[eff_fi as usize], "IO") }
                if (kernel_eff & 2) != 0 { tc_kernel_invalid_effect(FN_NAME_TOK[eff_fi as usize], "Mut") }
                if (kernel_eff & 16) != 0 { tc_kernel_invalid_effect(FN_NAME_TOK[eff_fi as usize], "Alloc") }
                // E072: kernel must return unit type
                if FN_RET_TY[eff_fi as usize] != 5 && FN_RET_TY[eff_fi as usize] != 0 {
                    tc_kernel_nonvoid_return(FN_NAME_TOK[eff_fi as usize])
                }
            }
            if eff_fi < FN_COUNT { eff_fi = eff_fi + 1 }
        }
        p = p + 1
    }
    print("effects: scanned "); print_int(eff_fi); print(" functions\n")
    // Auto-grant main() all basic effects (IO|Mut|Panic|Div|Alloc = 31)
    // main is the program entry point — it implicitly has all capabilities
    var mai: i64 = 0
    while mai < FN_COUNT {
        let mns = FN_NS[mai as usize]
        let mne = FN_NE[mai as usize]
        if mne - mns == 4 && sb(mns) == 109 && sb(mns+1) == 97 && sb(mns+2) == 105 && sb(mns+3) == 110 {
            if FN_RECV_HASH[mai as usize] == 0 {
                FN_EFFECTS[mai as usize] = FN_EFFECTS[mai as usize] | 31
            }
        }
        mai = mai + 1
    }
    var evi: i64 = 0
    while evi < FN_COUNT {
        if FN_NEEDS_SESSION[evi as usize] != 0 && (FN_EFFECTS[evi as usize] & 32) == 0 && (FN_EFFECTS[evi as usize] & 2048) == 0 {
            tc_missing_effect(FN_NAME_TOK[evi as usize])
        }
        evi = evi + 1
    }

    // ZD gating: ExactlyPrivate<T>, Editable<T>, CapabilityGated<T>,
    // Composable<T>, Interpretable<T> require `with ZD`.
    // Audited<T> additionally requires `with Witness`.
    // Revivable<T> additionally requires `with Temporal`.
    var zd_fi: i64 = 0
    while zd_fi < FN_COUNT {
        let zd_fx = FN_EFFECTS[zd_fi as usize]
        if (zd_fx & 2048) == 0 {
            let need_zd = (zd_fx & 16384) == 0
            let need_witness = (zd_fx & 32768) == 0
            let need_temporal = (zd_fx & 65536) == 0
            let fn_tok = FN_NAME_TOK[zd_fi as usize]
            var pq: i64 = fn_tok + 1
            if pq < TC && TK[pq as usize] == 6 {
                var pd: i64 = 1
                pq = pq + 1
                while pq < TC && pd > 0 {
                    if TK[pq as usize] == 6 { pd = pd + 1 }
                    else if TK[pq as usize] == 7 { pd = pd - 1 }
                    else if TK[pq as usize] == 3 {
                        let pns = TS[pq as usize]
                        let pne = TE[pq as usize]
                        let pl = pne - pns
                        if need_zd && src_match(pns, pl, "ExactlyPrivate") {
                            print("error[E201]: parameter uses ExactlyPrivate<T> without `with ZD` effect at line ")
                            print_int(TL[fn_tok as usize])
                            print("\n")
                            TYPECHECK_FAILED = 1
                        }
                        if need_zd && src_match(pns, pl, "Editable") {
                            print("error[E202]: parameter uses Editable<T> without `with ZD` effect at line ")
                            print_int(TL[fn_tok as usize])
                            print("\n")
                            TYPECHECK_FAILED = 1
                        }
                        if need_zd && src_match(pns, pl, "CapabilityGated") {
                            print("error[E203]: parameter uses CapabilityGated<T> without `with ZD` effect at line ")
                            print_int(TL[fn_tok as usize])
                            print("\n")
                            TYPECHECK_FAILED = 1
                        }
                        if need_zd && src_match(pns, pl, "Composable") {
                            print("error[E204]: parameter uses Composable<T> without `with ZD` effect at line ")
                            print_int(TL[fn_tok as usize])
                            print("\n")
                            TYPECHECK_FAILED = 1
                        }
                        if src_match(pns, pl, "Audited") {
                            if need_zd || need_witness {
                                print("error[E205]: parameter uses Audited<T> without `with ZD, Witness` effects at line ")
                                print_int(TL[fn_tok as usize])
                                print("\n")
                                TYPECHECK_FAILED = 1
                            }
                        }
                        if src_match(pns, pl, "Revivable") {
                            if need_zd || need_temporal {
                                print("error[E206]: parameter uses Revivable<T> without `with ZD, Temporal` effects at line ")
                                print_int(TL[fn_tok as usize])
                                print("\n")
                                TYPECHECK_FAILED = 1
                            }
                        }
                        if need_zd && src_match(pns, pl, "Interpretable") {
                            print("error[E207]: parameter uses Interpretable<T> without `with ZD` effect at line ")
                            print_int(TL[fn_tok as usize])
                            print("\n")
                            TYPECHECK_FAILED = 1
                        }
                    }
                    pq = pq + 1
                }
            }
        }
        zd_fi = zd_fi + 1
    }

    // Pass 1c: scan top-level type aliases (token 61)
    p = 0
    var tdepth: i64 = 0
    while p < TC {
        let ttk = TK[p as usize]
        if ttk == 8 { tdepth = tdepth + 1; p = p + 1; continue }
        if ttk == 9 { tdepth = tdepth - 1; p = p + 1; continue }
        if tdepth > 0 { p = p + 1; continue }
        if ttk == 61 {
            // type NAME = ...
            p = p + 1
            var alias_idx: i64 = -1
            if p < TC && TK[p as usize] == 3 {
                let tnh = gl_name_hash(TS[p as usize], TE[p as usize])
                if REF_TYPE_COUNT < 32 {
                    alias_idx = REF_TYPE_COUNT
                    REF_TYPE_HASH[alias_idx as usize] = tnh
                    let _b = alias_idx * 10
                    REF_TYPE_DATA[(_b + 0) as usize] = 0
                    REF_TYPE_DATA[(_b + 1) as usize] = 0
                    REF_TYPE_DATA[(_b + 2) as usize] = 0
                    REF_TYPE_DATA[(_b + 6) as usize] = 0
                    REF_TYPE_COUNT = REF_TYPE_COUNT + 1
                }
                p = p + 1
            }
            // Expect '=' then optional refinement body { ident : T | pred }
            if alias_idx >= 0 && p < TC && TK[p as usize] == 16 {
                p = p + 1
                // Save current SCAN_HAS_PRED state (we will reuse scan_type)
                let save_has = SCAN_HAS_PRED
                let save_has2 = SCAN_HAS_PRED2
                let save_op = SCAN_PRED_OP
                let save_bound = SCAN_PRED_BOUND
                let save_isf = SCAN_PRED_IS_F64
                let save_op2 = SCAN_PRED_OP2
                let save_bound2 = SCAN_PRED_BOUND2
                let save_isf2 = SCAN_PRED_IS_F64_2
                let save_is_and = SCAN_PRED_COMPOUND_IS_AND
                scan_type(p)
                let _b2 = alias_idx * 10
                REF_TYPE_DATA[(_b2 + 0) as usize] = SCAN_TY
                REF_TYPE_DATA[(_b2 + 1) as usize] = SCAN_TY_HASH
                if SCAN_HAS_PRED == 1 {
                    REF_TYPE_DATA[(_b2 + 2) as usize] = 1
                    REF_TYPE_DATA[(_b2 + 3) as usize] = SCAN_PRED_OP
                    REF_TYPE_DATA[(_b2 + 4) as usize] = SCAN_PRED_BOUND
                    REF_TYPE_DATA[(_b2 + 5) as usize] = SCAN_PRED_IS_F64
                }
                if SCAN_HAS_PRED2 == 1 {
                    REF_TYPE_DATA[(_b2 + 6) as usize] = 1
                    REF_TYPE_DATA[(_b2 + 7) as usize] = SCAN_PRED_OP2
                    REF_TYPE_DATA[(_b2 + 8) as usize] = SCAN_PRED_BOUND2
                    REF_TYPE_DATA[(_b2 + 9) as usize] = SCAN_PRED_IS_F64_2
                    // PR-6: store AND/OR conjunction flag alongside second predicate
                    REF_TYPE_IS_AND[alias_idx as usize] = SCAN_PRED_COMPOUND_IS_AND
                }
                // Restore (do not leak alias-decl predicate into outer state)
                SCAN_HAS_PRED = save_has
                SCAN_HAS_PRED2 = save_has2
                SCAN_PRED_OP = save_op
                SCAN_PRED_BOUND = save_bound
                SCAN_PRED_IS_F64 = save_isf
                SCAN_PRED_OP2 = save_op2
                SCAN_PRED_BOUND2 = save_bound2
                SCAN_PRED_IS_F64_2 = save_isf2
                SCAN_PRED_COMPOUND_IS_AND = save_is_and
            }
            // Skip remainder to next top-level declaration
            while p < TC && TK[p as usize] != 1 && TK[p as usize] != 12 && TK[p as usize] != 46 && TK[p as usize] != 47 && TK[p as usize] != 61 && TK[p as usize] != 0 { p = p + 1 }
            continue
        }
        p = p + 1
    }
    if REF_TYPE_COUNT > 0 { print("types: "); print_int(REF_TYPE_COUNT); print(" aliases\n") }
    if CLI_SHOW_AST != 0 { dump_cli_ast_summary() }
    if CLI_SHOW_TYPES != 0 { dump_cli_type_summary() }

    // Pass 1c.5: re-scan return types for refinement predicates now that the alias table is complete.
    // Pass 1 signature scan runs before Pass 1c (type alias registration), so alias-typed returns
    // like `-> Pos` can't resolve their predicates at sig-scan time. This pass re-scans each
    // function's recorded return type token and (re-)populates FN_RET_HAS_PRED.
    var rp_i: i64 = 0
    while rp_i < FN_COUNT {
        let rp_tok = FN_RET_TY_TOK[rp_i as usize]
        if rp_tok >= 0 {
            scan_type(rp_tok)
            // Re-store the resolved return type ONLY for Knowledge<T>-alias returns
            // (e.g. `-> DailyDose` where `type DailyDose = Knowledge[f64]`): these could
            // not resolve at Pass-1 sig-scan time because the alias table was still
            // empty, so FN_RET_HASH held the bare alias-name hash and every return/caller
            // ty_eq mismatched (P0003). Narrowly guarded by knowledge_hash_is so non-alias
            // returns keep their Pass-1 type verbatim (a broad re-store corrupted complex
            // returns — e.g. Clifford multivectors — that Pass 1 had set correctly).
            if knowledge_hash_is(SCAN_TY_HASH) {
                FN_RET_TY[rp_i as usize] = SCAN_TY
                FN_RET_HASH[rp_i as usize] = SCAN_TY_HASH
            }
            // PR-10: store f64 metadata alongside integer predicates
            if SCAN_HAS_PRED == 1 {
                FN_RET_HAS_PRED[rp_i as usize] = 1
                FN_RET_PRED_OP[rp_i as usize] = SCAN_PRED_OP
                FN_RET_PRED_BOUND[rp_i as usize] = SCAN_PRED_BOUND
                FN_RET_PRED_IS_F64[rp_i as usize] = SCAN_PRED_IS_F64
                FN_RET_PRED_BOUND_FRAC[rp_i as usize] = SCAN_PRED_BOUND_FRAC
                FN_RET_PRED_BOUND_DENOM[rp_i as usize] = SCAN_PRED_BOUND_DENOM
                if SCAN_HAS_PRED2 == 1 {
                    FN_RET_HAS_PRED2[rp_i as usize] = 1
                    FN_RET_PRED_OP2[rp_i as usize] = SCAN_PRED_OP2
                    FN_RET_PRED_BOUND2[rp_i as usize] = SCAN_PRED_BOUND2
                    FN_RET_PRED_IS_F64_2[rp_i as usize] = SCAN_PRED_IS_F64_2
                    FN_RET_PRED_BOUND2_FRAC[rp_i as usize] = SCAN_PRED_BOUND2_FRAC
                    FN_RET_PRED_BOUND2_DENOM[rp_i as usize] = SCAN_PRED_BOUND2_DENOM
                    FN_RET_PRED_COMPOUND_IS_AND[rp_i as usize] = SCAN_PRED_COMPOUND_IS_AND
                }
            }
        }
        rp_i = rp_i + 1
    }

    // Pass 1d: Epistemic type inference (Patient Zero)
    epistemic_infer_pass()
    // Gen 16 Track B: abort if any EpistemicComplete violations detected
    if EPIST_EFFECT_VIOLATIONS > 0 { return 1 }
    if TARGET_ARCH == 1 { return 0 }

    // Pass 2: compile each function
    p = 0
    var fn_idx: i64 = 0
    while fn_idx < FN_COUNT {
        p = FN_NAME_TOK[fn_idx as usize]
        let is_kernel_fn = FN_IS_KERNEL[fn_idx as usize]
        let body_open = FN_BODY_OPEN[fn_idx as usize]
        let body_close = FN_BODY_CLOSE[fn_idx as usize]
        // -1 sentinel: bodyless declaration (e.g. fn inside effect block) — skip silently
        if body_open < 0 { fn_idx = fn_idx + 1; continue }
        if p <= 0 || p >= TC || body_open == 0 || body_close <= body_open || body_close > TC {
            print("error[E217]: invalid function body span for fn#")
            print_int(fn_idx)
            print(" ")
            print_fn_name(fn_idx)
            print("\n")
            return 1
        }

        // Record code offset + set current function for effects checking
        FN_OFF[fn_idx as usize] = CL
        CURRENT_FN = fn_idx
        CURRENT_RET_TY = FN_RET_TY[fn_idx as usize]
        CURRENT_RET_HASH = FN_RET_HASH[fn_idx as usize]

        // (stub infrastructure removed — imported functions compile fully)

        // E070: kernel functions cannot declare IO or Mut effects
        if is_kernel_fn != 0 {
            if (FN_EFFECTS[fn_idx as usize] & 1) != 0 {
                print("error[E070]: IO effect not allowed in kernel function at line ")
                print_int(TL[FN_NAME_TOK[fn_idx as usize] as usize])
                print("\n")
                tc_mark_failed()
            }
            if (FN_EFFECTS[fn_idx as usize] & 2) != 0 {
                print("error[E070]: Mut effect not allowed in kernel function at line ")
                print_int(TL[FN_NAME_TOK[fn_idx as usize] as usize])
                print("\n")
                tc_mark_failed()
            }
            // E072: kernel functions must return void
            if CURRENT_RET_TY != 5 && CURRENT_RET_TY != 0 {
                print("error[E072]: kernel function must return void at line ")
                print_int(TL[FN_NAME_TOK[fn_idx as usize] as usize])
                print("\n")
                tc_mark_failed()
            }
        }

        // Reset local vars
        VAR_COUNT = 0
        NEXT_SLOT = 1
        BREAK_COUNT = 0
        LAST_STMT_HAS_VALUE = 0
        LAST_STMT_TY = 0
        LAST_STMT_TY_HASH = 0
        CURRENT_SRET_SLOT = 0
        if ret_agg_nslots(CURRENT_RET_TY, CURRENT_RET_HASH) > 0 {
            // Slot 1 belongs to the `push r12` the SRET prologue emits.
            //
            // The prologue is `push rbp; mov rbp,rsp; push r12; sub rsp,frame`,
            // so the saved r12 lives at rbp-0x08 -- which is slot 1, exactly
            // where emit_store_incoming_arg_x86(0, CURRENT_SRET_SLOT) then wrote
            // the incoming SRET pointer. `pop r12` in the epilogue restored that
            // pointer instead of the CALLER's r12, so a function returning an
            // aggregate destroyed its caller's SRET destination.
            //
            // The caller then wrote its own result through a pointer into the
            // callee's dead frame, and the next call reused those bytes: two
            // `let z = outer(..)` bindings both read the second call's values.
            // Confirmed under gdb -- r12 intact at the callee's entry, holding
            // the callee's own SRET at its `ret`.
            NEXT_SLOT = NEXT_SLOT + 1
            CURRENT_SRET_SLOT = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
        }
        FRAME_PATCH_COUNT = 0
        // β⁴/β⁶/β⁷: reset shadow state for new function scope
        EXPR_VSHADOW = -1
        EXPR_SSHADOW = -1
        EXPR_SSHADOW_1 = -1; EXPR_SSHADOW_2 = -1; EXPR_SSHADOW_3 = -1; EXPR_SSHADOW_4 = -1; EXPR_SSHADOW_5 = -1; EXPR_SSHADOW_6 = -1; EXPR_SSHADOW_7 = -1
        EXPR_HSHADOW_00 = -1; EXPR_HSHADOW_01 = -1; EXPR_HSHADOW_02 = -1; EXPR_HSHADOW_03 = -1
        EXPR_HSHADOW_11 = -1; EXPR_HSHADOW_12 = -1; EXPR_HSHADOW_13 = -1
        EXPR_HSHADOW_22 = -1; EXPR_HSHADOW_23 = -1; EXPR_HSHADOW_33 = -1
    EXPR_HSHADOW_04 = -1; EXPR_HSHADOW_05 = -1; EXPR_HSHADOW_06 = -1; EXPR_HSHADOW_07 = -1
    EXPR_HSHADOW_14 = -1; EXPR_HSHADOW_15 = -1; EXPR_HSHADOW_16 = -1; EXPR_HSHADOW_17 = -1
    EXPR_HSHADOW_24 = -1; EXPR_HSHADOW_25 = -1; EXPR_HSHADOW_26 = -1; EXPR_HSHADOW_27 = -1
    EXPR_HSHADOW_34 = -1; EXPR_HSHADOW_35 = -1; EXPR_HSHADOW_36 = -1; EXPR_HSHADOW_37 = -1
    EXPR_HSHADOW_44 = -1; EXPR_HSHADOW_45 = -1; EXPR_HSHADOW_46 = -1; EXPR_HSHADOW_47 = -1
    EXPR_HSHADOW_55 = -1; EXPR_HSHADOW_56 = -1; EXPR_HSHADOW_57 = -1
    EXPR_HSHADOW_66 = -1; EXPR_HSHADOW_67 = -1
    EXPR_HSHADOW_77 = -1
        MEAS_CALL_IDX = 0
        MEAS_KNOW_IDX = 0
        KM_CACHE_COUNT = 0
        CHANNEL_INPUT_VAR_SLOT[0] = 0 - 1; CHANNEL_INPUT_VAR_SLOT[1] = 0 - 1; CHANNEL_INPUT_VAR_SLOT[2] = 0 - 1; CHANNEL_INPUT_VAR_SLOT[3] = 0 - 1
        CHANNEL_INPUT_VAR_SLOT[4] = 0 - 1; CHANNEL_INPUT_VAR_SLOT[5] = 0 - 1; CHANNEL_INPUT_VAR_SLOT[6] = 0 - 1; CHANNEL_INPUT_VAR_SLOT[7] = 0 - 1

        // Register parameters
        p = p + 1  // skip name
        var kernel_extent_slot: i64 = 0
        if TK[p as usize] == 6 { p = p + 1 }
        while true {
            let param_tk = TK[p as usize]
            if param_tk == 7 { break }
            if param_tk == 0 { break }
            if param_tk == 3 || param_tk == 79 {
                let pns = TS[p as usize]
                let pne = TE[p as usize]
                if var_find_idx(pns, pne) >= 0 { tc_duplicate_param(p) }
                let pslot = var_add(pns, pne)
                p = p + 1
                // Skip : type annotation (handles &T, &!T, [T; N], simple T)
                // Bare self parameter (no : annotation): infer type from impl block
                if TK[p as usize] != 43 && src_match(pns, pne - pns, "self") && FN_RECV_HASH[fn_idx as usize] != 0 {
                    let self_hash = FN_RECV_HASH[fn_idx as usize]
                    if pslot >= 0 {
                        // C3: `self` in `impl Trait for <primitive>` must carry the
                        // primitive's VAR_TY code (with hash 0, as every primitive
                        // does — see scan_type), not the struct code 6. Without this,
                        // arithmetic on `self` (e.g. `self * 10`) is typechecked as a
                        // struct operand and rejected ("arithmetic operands must have
                        // matching numeric types").
                        let self_prim_ty = prim_name_hash_ty(self_hash)
                        if self_prim_ty >= 0 {
                            VAR_TY[(VAR_COUNT - 1) as usize] = self_prim_ty
                            VAR_TY_HASH[(VAR_COUNT - 1) as usize] = 0
                            if self_prim_ty == 2 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 1 }
                        } else {
                            VAR_TY[(VAR_COUNT - 1) as usize] = 6
                            VAR_TY_HASH[(VAR_COUNT - 1) as usize] = self_hash
                        }
                    }
                }
                if TK[p as usize] == 43 {
                    p = p + 1  // skip :
                    scan_type(p)
                    if pslot >= 0 {
                        VAR_TY[(VAR_COUNT - 1) as usize] = SCAN_TY
                        VAR_TY_HASH[(VAR_COUNT - 1) as usize] = SCAN_TY_HASH
                        if SCAN_TY == 2 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 1 }
                        // fn-type parameters are always called with closure ABI (env_ptr in rdi)
                        if SCAN_TY == 9 { VAR_IS_CLOSURE[(VAR_COUNT - 1) as usize] = 1 }
                        if type_is_slice_ref(SCAN_TY, SCAN_TY_HASH) {
                            let len_slot = VAR_SLOT[(VAR_COUNT - 1) as usize]
                            let ptr_slot = NEXT_SLOT
                            NEXT_SLOT = NEXT_SLOT + 1
                            VAR_SLOT[(VAR_COUNT - 1) as usize] = ptr_slot
                            VAR_LEN_SLOT[(VAR_COUNT - 1) as usize] = len_slot
                            VAR_ESIZ[(VAR_COUNT - 1) as usize] = arr_hash_esiz(ref_hash_inner_hash(SCAN_TY_HASH))
                        } else if SCAN_TY == 8 {
                            VAR_ALEN[(VAR_COUNT - 1) as usize] = SCAN_TY_ALEN
                            VAR_ESIZ[(VAR_COUNT - 1) as usize] = SCAN_TY_ESIZ
                        } else if SCAN_TY == 10 && ref_hash_inner_ty(SCAN_TY_HASH) == 8 {
                            // &![T; N] fixed-size array ref param: record element size from
                            // inner array hash so arr[i] = v and (*arr)[i] = v use the correct
                            // stride (1 for i8, 8 for i64). Without this, VAR_ESIZ stays at 8
                            // (the var_add default) and i8-element arrays are accessed with
                            // stride-8, corrupting memory.
                            // Fixes: KNOWN_LIMITATIONS.md — "&![T;N] mutable ref mutation"
                            VAR_ESIZ[(VAR_COUNT - 1) as usize] = arr_hash_esiz(ref_hash_inner_hash(SCAN_TY_HASH))
                        }
                        if is_kernel_fn != 0 && kernel_extent_slot == 0 && SCAN_TY == 1 {
                            kernel_extent_slot = VAR_SLOT[(VAR_COUNT - 1) as usize]
                        }
                        // Mark parameter as linear/affine if its type is a linear/affine struct
                        let lin_si = st_find(SCAN_TY_HASH)
                        if lin_si >= 0 && knowledge_hash_is(SCAN_TY_HASH) == false {
                            VAR_LINEAR[(VAR_COUNT - 1) as usize] = ST_LINEAR[lin_si as usize]
                            VAR_AFFINE[(VAR_COUNT - 1) as usize] = ST_AFFINE[lin_si as usize]
                        }
                    }
                    p = SCAN_TY_NEXT
                }
            } else {
                p = p + 1  // skip keyword or other non-ident token used as param name
            }
            if TK[p as usize] == 28 { p = p + 1 }
        }
        if TK[p as usize] == 7 { p = p + 1 }
        // Skip -> type
        if TK[p as usize] == 10 {
            p = p + 1
            scan_type(p)
            p = SCAN_TY_NEXT
        }
        p = skip_signature_where_clause(p)
        // Skip 'with' effects clause (with=38, ident=3, comma=28)
        // Gen 17 D2: also skip Epistemic(N) parenthesized arguments
        if TK[p as usize] == 38 {
            p = p + 1
            while TK[p as usize] == 3 || TK[p as usize] == 28 {
                if TK[p as usize] == 3 {
                    p = p + 1
                    if TK[p as usize] == 6 {
                        p = p + 1
                        while TK[p as usize] != 7 && TK[p as usize] != 0 { p = p + 1 }
                        if TK[p as usize] == 7 { p = p + 1 }
                    }
                } else { p = p + 1 }
            }
        }
        p = body_open + 1
        CURRENT_BODY_CLOSE = body_close

        // Save error count before compiling this function's body
        let fn_err_before = TC_FN_ERR_COUNT

        // Emit prologue: push rbp; mov rbp, rsp; sub rsp, <frame>
        em(0x55); em(0x48); em(0x89); em(0xe5)
        // If SRET: save r12 (callee-saved), then mov r12, rdi (preserve SRET ptr)
        if CURRENT_SRET_SLOT > 0 {
            em(0x41); em(0x54)  // push r12
        }
        em(0x48); em(0x81); em(0xec); record_frame_patch(); em32(0)
        emit_stack_probe_x86()  // guard-page touch for multi-MB by-value frames

        // Store parameters from registers/stack using low-level ABI slot order.
        var param_vi: i64 = 0
        var abi_arg_idx: i64 = 0
        if CURRENT_SRET_SLOT > 0 {
            // Save SRET pointer to both stack slot AND r12
            emit_store_incoming_arg_x86(0, CURRENT_SRET_SLOT)
            em(0x49); em(0x89); em(0xfc)  // mov r12, rdi
            abi_arg_idx = 1
        }
        // Trace: fn61 parameter count
        while param_vi < VAR_COUNT {
            emit_store_incoming_arg_x86(abi_arg_idx, VAR_SLOT[param_vi as usize])
            abi_arg_idx = abi_arg_idx + 1
            if type_is_slice_ref(VAR_TY[param_vi as usize], VAR_TY_HASH[param_vi as usize]) {
                emit_store_incoming_arg_x86(abi_arg_idx, VAR_LEN_SLOT[param_vi as usize])
                abi_arg_idx = abi_arg_idx + 1
            }
            param_vi = param_vi + 1
        }
        // β⁵: load argument variance values from global BSS array into
        // parameter VAR_VSHADOW slots so callee body sees caller variances.
        param_vi = 0
        while param_vi < VAR_COUNT && param_vi < 16 {
            if VAR_IS_F64[param_vi as usize] == 1 {
                let pvs = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
                emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + B5_ARG_VSHADOW_BSS_OFF + param_vi * 8)
                emit_store_var(pvs)
                VAR_VSHADOW[param_vi as usize] = pvs
            }
            param_vi = param_vi + 1
        }

        // β⁹ GTT week-4: seed VAR_PARAM_USED for parameters so subsequent
        // loads surface the correct enclosing-fn param-index dependency.
        // Params occupy VAR slots 0..VAR_COUNT; cap indexed bits at 16
        // (B9_ARG_CH_SET slot limit). Params >=16 get 0, which forces the
        // body-precision gate at the caller's site to fall back to the
        // conservative union-all rule.
        var pu_seed: i64 = 0
        while pu_seed < VAR_COUNT {
            if pu_seed < 16 {
                VAR_PARAM_USED[pu_seed as usize] = 1 << pu_seed
            } else {
                VAR_PARAM_USED[pu_seed as usize] = 0
            }
            pu_seed = pu_seed + 1
        }
        EXPR_PARAM_USED = 0

        // Emit non-zero global initializers once, at main's entry.
        // BSS already zeros globals, so this only matters for inits like
        // `var PI: f64 = 3.14159` where the declared value is not zero.
        let main_ntk = FN_NAME_TOK[fn_idx as usize]
        let main_ns = TS[main_ntk as usize]
        let main_ne = TE[main_ntk as usize]
        if src_match(main_ns, main_ne - main_ns, "main") {
            let save_ep = EP
            let save_expr_ty = EXPR_TY
            let save_expr_ty_hash = EXPR_TY_HASH
            let save_expr_is_f64 = EXPR_IS_F64
            // Reserve the Box::new bump arena before any global init or body runs
            // (global inits may themselves Box-allocate). Emitted once, at main's entry.
            emit_ast_arena_init_x86()
            emit_global_inits_x86()
            EP = save_ep
            EXPR_TY = save_expr_ty
            EXPR_TY_HASH = save_expr_ty_hash
            EXPR_IS_F64 = save_expr_is_f64
        }

        // Kernels that reference GPU builtins are executed through a CPU lane loop
        // until the native runtime grows real CUDA dispatch support.
        var kernel_uses_gpu_builtins: i64 = 0
        if is_kernel_fn != 0 { kernel_uses_gpu_builtins = kernel_body_uses_gpu_builtins(p) }
        if is_kernel_fn != 0 { maybe_compile_kernel_ptx(fn_idx, p, kernel_extent_slot) }
        if kernel_uses_gpu_builtins != 0 && kernel_extent_slot > 0 {
            em(0x31); em(0xc0)
            emit_store_gpu_thread_id_x86()
            let kernel_loop_top = CL
            emit_load_gpu_thread_id_x86()
            em(0x50)
            emit_load_var(kernel_extent_slot)
            em(0x59)
            em(0x48); em(0x39); em(0xc1)
            em(0x0f); em(0x9c); em(0xc0)
            em(0x48); em(0x0f); em(0xb6); em(0xc0)
            em(0x48); em(0x85); em(0xc0)
            em(0x0f); em(0x84)
            let kernel_loop_end = CL
            em32(0)
            EP = p
            var kernel_body_depth: i64 = 1
            while EP < TC && EP < CURRENT_BODY_CLOSE && kernel_body_depth > 0 {
                if TK[EP as usize] == 9 { kernel_body_depth = kernel_body_depth - 1; if kernel_body_depth == 0 { EP = EP + 1; continue } else { EP = EP + 1; continue } }
                compile_stmt()
            }
            emit_load_gpu_thread_id_x86()
            em(0x48); em(0x83); em(0xc0); em(1)
            emit_store_gpu_thread_id_x86()
            em(0xe9)
            em32(kernel_loop_top - (CL + 4))
            patch32(kernel_loop_end, CL)
            p = body_close + 1
        } else {
            // Compile body
            EP = p
            var depth: i64 = 1
            while EP < TC && EP < CURRENT_BODY_CLOSE && depth > 0 {
                if TK[EP as usize] == 9 { depth = depth - 1; if depth == 0 { EP = EP + 1; continue } else { EP = EP + 1; continue } }
                compile_stmt()
            }
            p = body_close + 1
        }
        CURRENT_BODY_CLOSE = 0

        // β⁹ GTT week-4: capture body-tail EXPR_PARAM_USED into FN_USED_PARAMS
        // so callers can tighten channel-set unions to only the params this
        // function's return actually depends on.  Bit 62 (FN_USED_ANALYZED =
        // 4611686018427387904) distinguishes "analyzed, no params used" from
        // "unanalyzed" (fallback to conservative week-3 union).
        FN_USED_PARAMS[fn_idx as usize] = EXPR_PARAM_USED | 4611686018427387904

        // Linear type check: warn if any linear variable was not used exactly once
        var lci: i64 = 0
        while lci < VAR_COUNT {
            if VAR_LINEAR[lci as usize] == 1 {
                if VAR_USED[lci as usize] == 0 {
                    tc_linear_violation(FN_NAME_TOK[fn_idx as usize], "linear value not consumed")
                }
                if VAR_USED[lci as usize] > 1 {
                    tc_linear_violation(FN_NAME_TOK[fn_idx as usize], "linear value used more than once")
                }
            }
            lci = lci + 1
        }

        // Implicit return 0
        if CL > 0 && CD[(CL - 1) as usize] != 0xc3 as i8 {
            // Unit return type (5 = no explicit return): always emit xor eax, eax
            if CURRENT_RET_TY == 5 {
                em(0x31); em(0xc0)
            } else if LAST_STMT_HAS_VALUE == 0 {
                em(0x31); em(0xc0)
            } else {
                if ty_eq(CURRENT_RET_TY, CURRENT_RET_HASH, LAST_STMT_TY, LAST_STMT_TY_HASH) == false {
                    if (ty_is_numeric(CURRENT_RET_TY) && ty_is_numeric(LAST_STMT_TY)) == false {
                        if (CURRENT_RET_TY != 0 || CURRENT_RET_HASH != 0) && (LAST_STMT_TY != 0 || LAST_STMT_TY_HASH != 0) {
                            if type_has_knowledge(CURRENT_RET_TY, CURRENT_RET_HASH) || type_has_knowledge(LAST_STMT_TY, LAST_STMT_TY_HASH) {
                                tc_epistemic_boundary(EP)
                            } else {
                                print("error[E218]: tail type mismatch at ")
                                print_src_loc_for_tok(EP - 1)
                                print(" (bundle line ")
                                print_int(TL[(EP - 1) as usize])
                                print(")\n")
                                tc_mark_failed()
                            }
                        }
                    }
                }
                // SRET fix: stabilize whenever SRET was set up, regardless of type-eq result.
                // Without this, functions returning tuples with a mismatched LAST_STMT_TY
                // (e.g. last stmt typed as Item while return is (Parser,Item)) skip stabilization
                // and return a dangling local stack address instead of the r12 SRET buffer.
                if CURRENT_SRET_SLOT > 0 || type_is_aggregate(CURRENT_RET_TY, CURRENT_RET_HASH) || type_is_aggregate(LAST_STMT_TY, LAST_STMT_TY_HASH) {
                    stabilize_return_agg_x86(LAST_STMT_TY, LAST_STMT_TY_HASH)
                }
            }
            // Observation boundary: implicit tail return of Unobserved<T> as non-Unobserved
            if ty_is_unobserved(LAST_STMT_TY) && !ty_is_unobserved(CURRENT_RET_TY) && CURRENT_RET_TY != 5 && (FN_EFFECTS[CURRENT_FN as usize] & 64) == 0 {
                tc_observe_boundary(EP - 1, "cannot return Unobserved<T> as non-Unobserved type")
            }
            em(0x48); em(0x81); em(0xc4); record_frame_patch(); em32(0)
            if CURRENT_SRET_SLOT > 0 {
                em(0x4c); em(0x89); em(0xe0)  // mov rax, r12 (return SRET ptr)
                em(0x41); em(0x5c)  // pop r12 (restore callee-saved)
            }
            em(0x5d); em(0xc3)
        }
        // Patch sub rsp / add rsp with actual frame size
        let frame_sz = (NEXT_SLOT * 8 + 15) & 0xFFFFFFF0
        FN_FRAME_SIZE[fn_idx as usize] = frame_sz
        if frame_sz > max_frame_bytes() { tc_stack_frame_too_large(frame_sz) }
        var fpi: i64 = 0
        while fpi < FRAME_PATCH_COUNT { em32_at(FRAME_PATCH_OFF[fpi as usize], frame_sz); fpi = fpi + 1 }

        // CONVERGENCE FIX: If imported function had errors, rewind and emit clean stub.
        // This ensures FN_OFF[fn_idx] points to valid code (just returns 0) and
        // prevents broken partial codegen from corrupting downstream call offsets.
        let fn_err_count = TC_FN_ERR_COUNT - fn_err_before
        let fn_is_import = (FN_EFFECTS[fn_idx as usize] & 2048) != 0
        // Only stub if error count is high (>10). Functions with few E200s
        // can still run — the xor rax,rax placeholder returns 0 for undefined vars.
        if fn_err_count > 10 && fn_is_import {
            // Invalidate patches that were recorded during this function's body
            // (they reference code offsets that will be overwritten by the stub)
            let stub_start = FN_OFF[fn_idx as usize]
            var rpi: i64 = 0
            while rpi < PATCH_COUNT {
                if PATCH_OFF[rpi as usize] >= stub_start && PATCH_OFF[rpi as usize] < CL {
                    PATCH_FN[rpi as usize] = -1  // invalidate: fn_find check in patch loop skips fi<0
                }
                rpi = rpi + 1
            }
            // Rewind code to function start
            CL = stub_start
            // Emit minimal stub: push rbp; mov rbp,rsp; xor eax,eax; pop rbp; ret
            em(0x55)                         // push rbp
            em(0x48); em(0x89); em(0xe5)     // mov rbp, rsp
            em(0x31); em(0xc0)               // xor eax, eax
            em(0x5d)                         // pop rbp
            em(0xc3)                         // ret
            FN_FRAME_SIZE[fn_idx as usize] = 0
        }

        fn_idx = fn_idx + 1
    }

    if fn_idx != FN_COUNT {
        print("error: function pass mismatch compiled=")
        print_int(fn_idx)
        print(" registered=")
        print_int(FN_COUNT)
        print("\n")
        var ufi: i64 = 0
        var ushown: i64 = 0
        while ufi < FN_COUNT && ushown < 12 {
            if FN_OFF[ufi as usize] == -1 {
                print("uncompiled fn#")
                print_int(ufi)
                print(" ")
                print_fn_name(ufi)
                print(" line ")
                print_int(TL[FN_NAME_TOK[ufi as usize] as usize])
                print("\n")
                ushown = ushown + 1
            }
            ufi = ufi + 1
        }
        return 1
    }

    if TYPECHECK_FAILED != 0 {
        print_limit_error()
        print("typecheck: failed\n")
        return 1
    }

    // Patch function calls
    var pi: i64 = 0
    while pi < PATCH_COUNT {
        let off = PATCH_OFF[pi as usize]
        let fi = PATCH_FN[pi as usize]
        if fi >= 0 && fi < FN_COUNT && off >= 0 && off + 3 < CL {
            let target = FN_OFF[fi as usize]
            if target == -1 {
                print("error[E220]: unresolved function body for call target fn#")
                print_int(fi)
                print(" ")
                print_fn_name(fi)
                print(" at line ")
                print_int(TL[FN_NAME_TOK[fi as usize] as usize])
                print("\n")
                return 1
            }
            let rel = target - (off + 4)
            CD[(off) as usize] = (rel & 0xFF) as i8
            CD[(off + 1) as usize] = ((rel >> 8) & 0xFF) as i8
            CD[(off + 2) as usize] = ((rel >> 16) & 0xFF) as i8
            CD[(off + 3) as usize] = ((rel >> 24) & 0xFF) as i8
        }
        pi = pi + 1
    }

    // Find main
    var main_fn: i64 = -1
    var mi: i64 = 0
    while mi < FN_COUNT {
        let ms = FN_NS[mi as usize]
        let me = FN_NE[mi as usize]
        if main_fn < 0 && me - ms == 4 && sb(ms) == 109 && sb(ms+1) == 97 && sb(ms+2) == 105 && sb(ms+3) == 110 { main_fn = mi }
        mi = mi + 1
    }
    if main_fn < 0 { print("error[E221]: no main\n"); return 1 }

    // Trampoline: save argc/argv, call main, exit
    TRAMP_OFF = CL
    let tramp = CL

    if TARGET_OS == 3 {
        // Windows PE trampoline: call main, then ExitProcess(rax) via IAT
        // No argc/argv on Windows MVP (would need GetCommandLineW)
        // sub rsp, 40 — align stack + shadow space
        em(0x48); em(0x83); em(0xEC); em(0x28)
        // call main
        em(0xe8)
        let wrel = FN_OFF[main_fn as usize] - (CL + 4)
        em32(wrel)
        // mov ecx, eax — exit code to RCX (Win64 first param)
        em(0x89); em(0xC1)
        // call [rip+disp32] — ExitProcess via IAT (disp32 patched by write_pe)
        PE_EXIT_CALL_OFF = CL + 2   // remember offset of disp32 for patching
        em(0xFF); em(0x15); em32(0)  // placeholder disp32
        // ud2 (should never reach)
        em(0x0F); em(0x0B)
    } else if TARGET_OS == 2 {
        // macOS x86_64 trampoline
        // LC_MAIN entry arrives with argc/argv in the normal C ABI registers.
        // Skip argv[0] so the self-hosted CLI sees <source> at argv[0].
        let argc_addr = GL_BSS_BASE - 16
        let argv_addr = GL_BSS_BASE - 8
        em(0x48); em(0x89); em(0xf8)            // mov rax, rdi (argc)
        em(0x48); em(0x83); em(0xe8); em(0x01)  // sub rax, 1
        em(0x48); em(0xb9); em64(argc_addr)
        em(0x48); em(0x89); em(0x01)            // mov [rcx], rax
        em(0x48); em(0x89); em(0xf0)            // mov rax, rsi (argv)
        em(0x48); em(0x83); em(0xc0); em(0x08)  // add rax, 8
        em(0x48); em(0xb9); em64(argv_addr)
        em(0x48); em(0x89); em(0x01)            // mov [rcx], rax
        // call main
        em(0xe8)
        let mrel = FN_OFF[main_fn as usize] - (CL + 4)
        em32(mrel)
        // macOS exit: syscall 0x2000001
        em(0x89); em(0xc7)                     // mov edi, eax
        em(0x48); em(0xb8); em64(0x2000001)    // mov rax, 0x2000001
        em(0x0f); em(0x05)                     // syscall
    } else {
        // Linux trampoline
        let argc_addr = 0x10000000
        let argv_addr = 0x10000000 + 8
        em(0x48); em(0x8b); em(0x04); em(0x24)  // mov rax, [rsp] (argc)
        em(0x48); em(0x83); em(0xe8); em(0x01)  // sub rax, 1 (skip program name)
        em(0x48); em(0xb9); em64(argc_addr)
        em(0x48); em(0x89); em(0x01)  // mov [rcx], rax (save argc-1)
        em(0x48); em(0x8d); em(0x44); em(0x24); em(16)  // lea rax, [rsp+16] (argv+1)
        em(0x48); em(0xb9); em64(argv_addr)
        em(0x48); em(0x89); em(0x01)  // mov [rcx], rax (save argv ptr)
        // R15 Runtime Tag Stack: initialize R15 and fill side table with 1000 (full confidence)
        if CLI_R15_MONITOR != 0 {
            let r15_tbl_abs = 0x10000000 + R15_SIDE_TABLE_BSS_OFF
            // mov r15, side_table_abs_addr (10 bytes): REX.W+REX.B=0x49, opcode=0xbf (B8+7)
            em(0x49); em(0xbf); em64(r15_tbl_abs)
            // xor rcx, rcx (3 bytes)
            em(0x48); em(0x31); em(0xc9)
            // .loop: mov qword [r15 + rcx*8], 1000 (8 bytes)
            // REX.W+REX.B=0x49, MOV r/m64 imm32=0xc7, ModRM=0x04 (SIB follows), SIB=0xcf (×8, rcx, r15)
            em(0x49); em(0xc7); em(0x04); em(0xcf); em32(1000)
            // inc rcx (3 bytes)
            em(0x48); em(0xff); em(0xc1)
            // cmp rcx, R15_GATE_COUNT (7 bytes)
            em(0x48); em(0x81); em(0xf9); em32(R15_GATE_COUNT)
            // jl .loop (2 bytes, disp8=-20)
            em(0x7c); em(0xec)
        }
        // call main
        em(0xe8)
        let rel = FN_OFF[main_fn as usize] - (CL + 4)
        em32(rel)
        // exit(rax): Linux syscall 60
        em(0x89); em(0xc7)
        em(0xb8); em32(60)
        em(0x0f); em(0x05)
    }

    if CD_OVF != 0 { print("error[E222]: code buffer overflow at fn="); print_int(CD_OVF_FN); print(" name="); print_fn_name(CD_OVF_FN); print(" CL="); print_int(CD_OVF_CL); print(" total_fns="); print_int(FN_COUNT); print("\n"); return 1 }
    print("compile: fns="); print_int(FN_COUNT); print(" code="); print_int(CL)
    print(" main=fn"); print_int(main_fn); print(" patches="); print_int(PATCH_COUNT)
    print(" gates[direct="); print_int(EPIST_GATES_DIRECT)
    print(" guarded="); print_int(EPIST_GATES_GUARDED); print("]\n")
    if CLI_DEBUG_FN_MAP != 0 {
        var map_i: i64 = 0
        while map_i < FN_COUNT {
            print("fnmap fn="); print_int(map_i)
            print(" off="); print_int(FN_OFF[map_i as usize])
            print(" name="); print_fn_name(map_i)
            print("\n")
            map_i = map_i + 1
        }
    }
    if CLI_R15_MONITOR != 0 {
        print("r15_monitor: "); print_int(R15_GATE_COUNT); print(" sites instrumented")
        print(", side_table_size="); print_int(R15_GATE_COUNT * 8); print(" bytes")
        print(", bss_off="); print_int(R15_SIDE_TABLE_BSS_OFF); print("\n")
    }
    0
}

// ─── ELF byte writer helpers ───
fn elf_w8(off: i64, v: i64) with Mut, Panic { ELF[off as usize] = (v & 0xFF) as i8 }
fn elf_w16(off: i64, v: i64) with Mut, Panic { elf_w8(off, v); elf_w8(off+1, v >> 8) }
fn elf_w32(off: i64, v: i64) with Mut, Panic { elf_w16(off, v); elf_w16(off+2, v >> 16) }
fn elf_w64(off: i64, v: i64) with Mut, Panic { elf_w32(off, v); elf_w32(off+4, v >> 32) }

fn elf_write_cstr(off: i64, s: string) with Mut, Panic, Div {
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        elf_w8(off + i, str_char_at(s, i))
        i = i + 1
    }
    elf_w8(off + n, 0)
}

fn write_elf_gpu_dyn_x86(output: string) -> i64 with IO, Mut, Panic, Div {
    let text_base = gpu_dyn_linux_x86_text_base()
    let text_off = gpu_dyn_linux_x86_text_off()
    let data_off = ((text_off + CL + 4095) / 4096) * 4096
    let data_base = gpu_dyn_linux_x86_data_base()
    let bss_base = 0x10000000
    let entry = text_base + text_off + TRAMP_OFF
    let interp_off: i64 = 344
    let interp_len: i64 = 28

    let dynstr_rel: i64 = 0
    let dynstr_len: i64 = 33
    let dynsym_rel: i64 = 40
    let dynsym_entsize: i64 = 24
    let dynsym_count: i64 = 4
    let dynsym_size: i64 = dynsym_entsize * dynsym_count
    let hash_rel: i64 = 136
    let hash_size: i64 = 28
    let rela_rel: i64 = 168
    let rela_entsize: i64 = 24
    let rela_count: i64 = 3
    let rela_size: i64 = rela_entsize * rela_count
    let dynamic_rel: i64 = 240
    let dynamic_entsize: i64 = 16
    let dynamic_count: i64 = 10
    let dynamic_size: i64 = dynamic_entsize * dynamic_count
    let got_rel = gpu_dyn_linux_x86_got_off()
    let got_size: i64 = 24
    let data_size = got_rel + got_size
    let total_size = data_off + data_size

    var i: i64 = 0
    while i < total_size + 64 {
        ELF[i as usize] = 0
        i = i + 1
    }

    elf_w8(0, 0x7f); elf_w8(1, 69); elf_w8(2, 76); elf_w8(3, 70)
    elf_w8(4, 2); elf_w8(5, 1); elf_w8(6, 1)
    elf_w16(16, 2); elf_w16(18, 0x3e); elf_w32(20, 1)
    elf_w64(24, entry)
    elf_w64(32, 64)
    elf_w16(52, 64); elf_w16(54, 56); elf_w16(56, 5)
    elf_w16(58, 0); elf_w16(60, 0); elf_w16(62, 0)

    let text_filesz = text_off + CL
    let ph0 = 64
    elf_w32(ph0, 1)
    elf_w32(ph0 + 4, 5)
    elf_w64(ph0 + 8, 0)
    elf_w64(ph0 + 16, text_base)
    elf_w64(ph0 + 24, text_base)
    elf_w64(ph0 + 32, text_filesz)
    elf_w64(ph0 + 40, text_filesz)
    elf_w64(ph0 + 48, 4096)

    let ph1 = ph0 + 56
    elf_w32(ph1, 3)
    elf_w32(ph1 + 4, 4)
    elf_w64(ph1 + 8, interp_off)
    elf_w64(ph1 + 16, text_base + interp_off)
    elf_w64(ph1 + 24, text_base + interp_off)
    elf_w64(ph1 + 32, interp_len)
    elf_w64(ph1 + 40, interp_len)
    elf_w64(ph1 + 48, 1)

    let ph2 = ph1 + 56
    elf_w32(ph2, 1)
    elf_w32(ph2 + 4, 6)
    elf_w64(ph2 + 8, data_off)
    elf_w64(ph2 + 16, data_base)
    elf_w64(ph2 + 24, data_base)
    elf_w64(ph2 + 32, data_size)
    elf_w64(ph2 + 40, data_size)
    elf_w64(ph2 + 48, 4096)

    let ph3 = ph2 + 56
    elf_w32(ph3, 2)
    elf_w32(ph3 + 4, 6)
    elf_w64(ph3 + 8, data_off + dynamic_rel)
    elf_w64(ph3 + 16, data_base + dynamic_rel)
    elf_w64(ph3 + 24, data_base + dynamic_rel)
    elf_w64(ph3 + 32, dynamic_size)
    elf_w64(ph3 + 40, dynamic_size)
    elf_w64(ph3 + 48, 8)

    let ph4 = ph3 + 56
    elf_w32(ph4, 1)
    elf_w32(ph4 + 4, 6)
    elf_w64(ph4 + 8, 0)
    elf_w64(ph4 + 16, bss_base)
    elf_w64(ph4 + 24, bss_base)
    elf_w64(ph4 + 32, 0)
    elf_w64(ph4 + 40, GL_BSS_SIZE)
    elf_w64(ph4 + 48, 4096)

    elf_write_cstr(interp_off, "/lib64/ld-linux-x86-64.so.2")

    i = 0
    while i < CL {
        ELF[(text_off + i) as usize] = CD[i as usize]
        i = i + 1
    }

    let dynstr_off = data_off + dynstr_rel
    elf_w8(dynstr_off + 0, 0)
    elf_write_cstr(dynstr_off + 1, "libdl.so.2")
    elf_write_cstr(dynstr_off + 12, "dlopen")
    elf_write_cstr(dynstr_off + 19, "dlsym")
    elf_write_cstr(dynstr_off + 25, "dlclose")

    let dynsym_off = data_off + dynsym_rel
    elf_w32(dynsym_off + 24, 12)
    elf_w8(dynsym_off + 28, 0x12)
    elf_w16(dynsym_off + 30, 0)
    elf_w32(dynsym_off + 48, 19)
    elf_w8(dynsym_off + 52, 0x12)
    elf_w16(dynsym_off + 54, 0)
    elf_w32(dynsym_off + 72, 25)
    elf_w8(dynsym_off + 76, 0x12)
    elf_w16(dynsym_off + 78, 0)

    let hash_off = data_off + hash_rel
    elf_w32(hash_off + 0, 1)
    elf_w32(hash_off + 4, dynsym_count)
    elf_w32(hash_off + 8, 1)
    elf_w32(hash_off + 12, 0)
    elf_w32(hash_off + 16, 2)
    elf_w32(hash_off + 20, 3)
    elf_w32(hash_off + 24, 0)

    let rela_off = data_off + rela_rel
    elf_w64(rela_off + 0, gpu_dyn_linux_x86_got_slot_dlopen())
    elf_w64(rela_off + 8, (1 << 32) | 6)
    elf_w64(rela_off + 16, 0)
    elf_w64(rela_off + 24, gpu_dyn_linux_x86_got_slot_dlsym())
    elf_w64(rela_off + 32, (2 << 32) | 6)
    elf_w64(rela_off + 40, 0)
    elf_w64(rela_off + 48, gpu_dyn_linux_x86_got_slot_dlclose())
    elf_w64(rela_off + 56, (3 << 32) | 6)
    elf_w64(rela_off + 64, 0)

    let dynamic_off = data_off + dynamic_rel
    elf_w64(dynamic_off + 0, 1)
    elf_w64(dynamic_off + 8, 1)
    elf_w64(dynamic_off + 16, 5)
    elf_w64(dynamic_off + 24, data_base + dynstr_rel)
    elf_w64(dynamic_off + 32, 6)
    elf_w64(dynamic_off + 40, data_base + dynsym_rel)
    elf_w64(dynamic_off + 48, 10)
    elf_w64(dynamic_off + 56, dynstr_len)
    elf_w64(dynamic_off + 64, 11)
    elf_w64(dynamic_off + 72, dynsym_entsize)
    elf_w64(dynamic_off + 80, 4)
    elf_w64(dynamic_off + 88, data_base + hash_rel)
    elf_w64(dynamic_off + 96, 7)
    elf_w64(dynamic_off + 104, data_base + rela_rel)
    elf_w64(dynamic_off + 112, 8)
    elf_w64(dynamic_off + 120, rela_size)
    elf_w64(dynamic_off + 128, 9)
    elf_w64(dynamic_off + 136, rela_entsize)
    elf_w64(dynamic_off + 144, 0)
    elf_w64(dynamic_off + 152, 0)

    let ok = write_file(output, ELF, total_size)
    print("elf_dyn: "); print(output); print(" "); print_int(total_size)
    print(" bytes (bss="); print_int(GL_BSS_SIZE); print(")\n")
    return 0
}

// ─── ELF writer (2 LOAD segments: text RX + BSS RW) ───
fn write_elf(output: string) -> i64 with IO, Mut, Panic, Div {
    if TARGET_OS == 0 && TARGET_ARCH == 0 && NEEDS_GPU_RUNTIME_DYNLINK != 0 {
        return write_elf_gpu_dyn_x86(output)
    }
    let text_base = 0x400000
    let text_off = 4096
    let bss_base = 0x10000000        // 256MB: always above code, never overlaps
    let entry = text_base + text_off + TRAMP_OFF
    var i: i64 = 0
    while i < 4096 { ELF[i as usize] = 0; i = i + 1 }

    let tsz = text_off + CL

    // ELF header (64 bytes)
    elf_w8(0, 0x7f); elf_w8(1, 69); elf_w8(2, 76); elf_w8(3, 70)
    elf_w8(4, 2); elf_w8(5, 1); elf_w8(6, 1)
    elf_w16(16, 2); elf_w16(18, 0x3e); elf_w32(20, 1)
    elf_w64(24, entry)
    elf_w64(32, 64)
    elf_w16(52, 64); elf_w16(54, 56); elf_w16(56, 2); elf_w16(58, 64)

    // PT_LOAD #0: text (R+X)
    let ph0 = 64
    elf_w32(ph0, 1)                 // PT_LOAD
    elf_w32(ph0+4, 5)               // p_flags = R+X
    elf_w64(ph0+8, 0)               // p_offset = 0
    elf_w64(ph0+16, text_base)      // p_vaddr
    elf_w64(ph0+24, text_base)      // p_paddr
    elf_w64(ph0+32, tsz)            // p_filesz
    elf_w64(ph0+40, tsz)            // p_memsz (no zero-fill in text)
    elf_w64(ph0+48, 4096)           // p_align

    // PT_LOAD #1: BSS (R+W), no file data
    let ph1 = 120
    elf_w32(ph1, 1)                 // PT_LOAD
    elf_w32(ph1+4, 6)               // p_flags = R+W
    elf_w64(ph1+8, 0)               // p_offset = 0 (filesz=0, kernel zero-fills)
    elf_w64(ph1+16, bss_base)       // p_vaddr = 0x10000000
    elf_w64(ph1+24, bss_base)       // p_paddr
    elf_w64(ph1+32, 0)              // p_filesz = 0 (pure BSS)
    elf_w64(ph1+40, GL_BSS_SIZE)    // p_memsz
    elf_w64(ph1+48, 4096)           // p_align

    // Copy code after header
    i = 0
    while i < CL { ELF[(text_off + i) as usize] = CD[i as usize]; i = i + 1 }

    let ok = write_file(output, ELF, tsz)
    print("elf: "); print(output); print(" "); print_int(tsz)
    print(" bytes (bss="); print_int(GL_BSS_SIZE); print(")\n")
    return 0
}

// ─── PE/COFF writer ───
// Builds a Windows PE32+ executable from compiled code in CD[0..CL].
// Image layout: image_base=0x400000, .text at RVA 0x1000, .idata at next page, .bss at 0x200000.
// This keeps BSS virtual address at 0x600000 = 0x400000 + 0x200000, matching ELF layout.
fn write_pe(output: string) -> i64 with IO, Mut, Panic, Div {
    let image_base = 0x400000
    let sec_align = 0x1000
    let file_align = 0x200
    let text_rva = sec_align                      // 0x1000
    let text_raw_size = ((CL + file_align - 1) / file_align) * file_align
    let idata_rva = text_rva + ((CL + sec_align - 1) / sec_align) * sec_align

    // .idata layout: 1 import descriptor (20) + null (20) + INT(2*8+8=24) + IAT(24) + hints + dll name
    let idt_off: i64 = 0
    let int_off: i64 = 40
    let iat_off: i64 = 64
    let hnt_ep_off: i64 = 88         // "ExitProcess" hint/name entry
    let dll_name_off: i64 = 104      // "kernel32.dll\0"
    let idata_total: i64 = 117       // 104 + 13
    let idata_raw_size = ((idata_total + file_align - 1) / file_align) * file_align

    let bss_rva = 0x200000            // .bss section: RVA so that VA = 0x600000
    let bss_vsize = GL_BSS_SIZE
    if bss_vsize < 4096 { let bss_vsize_min = 4096 }  // minimum 1 page

    // Patch ExitProcess IAT displacement in trampoline code
    // call [rip+disp32]: disp32 = IAT_slot_RVA - (text_RVA + instruction_end_offset)
    if PE_EXIT_CALL_OFF >= 0 {
        let call_end = PE_EXIT_CALL_OFF + 4
        let disp = (idata_rva + iat_off) - (text_rva + call_end)  // IAT slot 0 = ExitProcess
        CD[PE_EXIT_CALL_OFF as usize] = (disp & 0xFF) as i8
        CD[(PE_EXIT_CALL_OFF + 1) as usize] = ((disp >> 8) & 0xFF) as i8
        CD[(PE_EXIT_CALL_OFF + 2) as usize] = ((disp >> 16) & 0xFF) as i8
        CD[(PE_EXIT_CALL_OFF + 3) as usize] = ((disp >> 24) & 0xFF) as i8
    }

    // Headers: DOS(64) + PE sig(4) + COFF(20) + OptHdr(112) + DataDirs(128) + 3 section headers(3*40=120) = 448
    // Round up to file_align = 512
    let num_sections = 3   // .text, .idata, .bss
    let headers_size = 512
    let entry_rva = text_rva + TRAMP_OFF

    // Compute size_of_image: round up to section_alignment
    let bss_end_rva = bss_rva + ((bss_vsize + sec_align - 1) / sec_align) * sec_align
    let size_of_image = bss_end_rva

    print("pe_build: code="); print_int(CL); print(" text_raw="); print_int(text_raw_size); print(" idata_rva="); print_int(idata_rva); print("\n")
    var i: i64 = 0
    while i < 1048576 { ELF[i as usize] = 0; i = i + 1 }

    // DOS header (64 bytes)
    elf_w8(0, 0x4D); elf_w8(1, 0x5A)             // "MZ"
    elf_w32(60, 64)                                // e_lfanew → PE header at offset 64

    // PE signature
    elf_w8(64, 0x50); elf_w8(65, 0x45)            // "PE\0\0"

    // COFF header (20 bytes at offset 68)
    elf_w16(68, 0x8664)                            // Machine = AMD64
    elf_w16(70, num_sections)                      // NumberOfSections
    elf_w16(84, 240)                               // SizeOfOptionalHeader (PE32+ = 112 + data dirs)
    elf_w16(86, 0x22)                              // Characteristics: EXECUTABLE | LARGE_ADDRESS_AWARE

    // Optional header (PE32+) at offset 88
    elf_w16(88, 0x020B)                            // Magic = PE32+
    elf_w32(104, entry_rva)                        // AddressOfEntryPoint
    elf_w64(112, image_base)                       // ImageBase
    elf_w32(120, sec_align)                        // SectionAlignment
    elf_w32(124, file_align)                       // FileAlignment
    elf_w16(128, 6)                                // MajorOperatingSystemVersion
    elf_w16(136, 6)                                // MajorSubsystemVersion
    elf_w32(144, size_of_image)                    // SizeOfImage
    elf_w32(148, headers_size)                     // SizeOfHeaders
    elf_w16(156, 3)                                // Subsystem = WINDOWS_CUI
    elf_w16(158, 0x8160)                           // DllCharacteristics: NX | DYNAMIC_BASE | HIGH_ENTROPY_VA | TERMINAL_SERVER
    elf_w64(160, 0x100000)                         // SizeOfStackReserve = 1MB
    elf_w64(168, 0x1000)                           // SizeOfStackCommit = 4KB
    elf_w64(176, 0x100000)                         // SizeOfHeapReserve = 1MB
    elf_w64(184, 0x1000)                           // SizeOfHeapCommit = 4KB
    elf_w32(196, 16)                               // NumberOfRvaAndSizes

    // Data directories start at offset 200 (after 112 bytes of PE32+ optional header fields)
    // Import directory (index 1, offset 200 + 1*8 = 208)
    elf_w32(208, idata_rva + idt_off)              // VirtualAddress
    elf_w32(212, 40)                               // Size (1 descriptor + null)
    // IAT directory (index 12, offset 200 + 12*8 = 296)
    elf_w32(296, idata_rva + iat_off)              // VirtualAddress
    elf_w32(300, 24)                               // Size (2 entries + null = 24)

    // Section headers start at offset 328 (88 + 240)
    let sh_base = 328

    // .text section header
    elf_w8(sh_base, 0x2E); elf_w8(sh_base+1, 0x74); elf_w8(sh_base+2, 0x65)
    elf_w8(sh_base+3, 0x78); elf_w8(sh_base+4, 0x74)  // ".text"
    elf_w32(sh_base+8, CL)                         // VirtualSize
    elf_w32(sh_base+12, text_rva)                   // VirtualAddress
    elf_w32(sh_base+16, text_raw_size)              // SizeOfRawData
    elf_w32(sh_base+20, headers_size)               // PointerToRawData
    elf_w32(sh_base+36, 0x60000020)                 // Characteristics: CODE | EXECUTE | READ

    // .idata section header
    let sh1 = sh_base + 40
    elf_w8(sh1, 0x2E); elf_w8(sh1+1, 0x69); elf_w8(sh1+2, 0x64)
    elf_w8(sh1+3, 0x61); elf_w8(sh1+4, 0x74); elf_w8(sh1+5, 0x61)  // ".idata"
    elf_w32(sh1+8, idata_total)                     // VirtualSize
    elf_w32(sh1+12, idata_rva)                      // VirtualAddress
    elf_w32(sh1+16, idata_raw_size)                 // SizeOfRawData
    elf_w32(sh1+20, headers_size + text_raw_size)   // PointerToRawData
    elf_w32(sh1+36, 0xC0000040)                     // Characteristics: INITIALIZED_DATA | READ | WRITE

    // .bss section header
    let sh2 = sh_base + 80
    elf_w8(sh2, 0x2E); elf_w8(sh2+1, 0x62); elf_w8(sh2+2, 0x73); elf_w8(sh2+3, 0x73)  // ".bss"
    elf_w32(sh2+8, bss_vsize)                       // VirtualSize
    elf_w32(sh2+12, bss_rva)                        // VirtualAddress
    elf_w32(sh2+16, 0)                              // SizeOfRawData = 0 (uninitialized)
    elf_w32(sh2+20, 0)                              // PointerToRawData = 0
    elf_w32(sh2+36, 0xC0000080)                     // Characteristics: UNINITIALIZED_DATA | READ | WRITE

    // Copy .text section (code)
    i = 0
    while i < CL { ELF[(headers_size + i) as usize] = CD[i as usize]; i = i + 1 }

    // Pad .text to file alignment
    let text_end = headers_size + text_raw_size

    // Write .idata section
    let idata_file_off = text_end

    // Import descriptor for kernel32.dll (20 bytes)
    elf_w32(idata_file_off + 0, idata_rva + int_off)    // OriginalFirstThunk (INT RVA)
    elf_w32(idata_file_off + 12, idata_rva + dll_name_off)  // Name RVA
    elf_w32(idata_file_off + 16, idata_rva + iat_off)   // FirstThunk (IAT RVA)
    // Null terminator descriptor (20 bytes of zeros — already zero)

    // INT: ExitProcess entry + null (offset 40)
    elf_w64(idata_file_off + int_off, idata_rva + hnt_ep_off)  // → hint/name for ExitProcess
    // null terminator at int_off+8 (already zero)

    // IAT: same as INT (offset 64)
    elf_w64(idata_file_off + iat_off, idata_rva + hnt_ep_off)
    // null terminator at iat_off+8 (already zero)

    // Hint/Name entry for ExitProcess (offset 88): hint(2) + "ExitProcess\0"
    elf_w16(idata_file_off + hnt_ep_off, 0)              // hint = 0
    // "ExitProcess" = 69 78 69 74 50 72 6F 63 65 73 73 00
    elf_w8(idata_file_off + hnt_ep_off + 2, 0x45)   // E
    elf_w8(idata_file_off + hnt_ep_off + 3, 0x78)   // x
    elf_w8(idata_file_off + hnt_ep_off + 4, 0x69)   // i
    elf_w8(idata_file_off + hnt_ep_off + 5, 0x74)   // t
    elf_w8(idata_file_off + hnt_ep_off + 6, 0x50)   // P
    elf_w8(idata_file_off + hnt_ep_off + 7, 0x72)   // r
    elf_w8(idata_file_off + hnt_ep_off + 8, 0x6F)   // o
    elf_w8(idata_file_off + hnt_ep_off + 9, 0x63)   // c
    elf_w8(idata_file_off + hnt_ep_off + 10, 0x65)  // e
    elf_w8(idata_file_off + hnt_ep_off + 11, 0x73)  // s
    elf_w8(idata_file_off + hnt_ep_off + 12, 0x73)  // s

    // DLL name: "kernel32.dll\0" (offset 104)
    elf_w8(idata_file_off + dll_name_off + 0, 0x6B)   // k
    elf_w8(idata_file_off + dll_name_off + 1, 0x65)   // e
    elf_w8(idata_file_off + dll_name_off + 2, 0x72)   // r
    elf_w8(idata_file_off + dll_name_off + 3, 0x6E)   // n
    elf_w8(idata_file_off + dll_name_off + 4, 0x65)   // e
    elf_w8(idata_file_off + dll_name_off + 5, 0x6C)   // l
    elf_w8(idata_file_off + dll_name_off + 6, 0x33)   // 3
    elf_w8(idata_file_off + dll_name_off + 7, 0x32)   // 2
    elf_w8(idata_file_off + dll_name_off + 8, 0x2E)   // .
    elf_w8(idata_file_off + dll_name_off + 9, 0x64)   // d
    elf_w8(idata_file_off + dll_name_off + 10, 0x6C)  // l
    elf_w8(idata_file_off + dll_name_off + 11, 0x6C)  // l

    let total_file_size = idata_file_off + idata_raw_size
    let ok = write_file(output, ELF, total_file_size)
    print("pe: "); print(output); print(" "); print_int(total_file_size)
    print(" bytes\n")
    return 0
}

// ─── Mach-O x86_64 writer ───
// Builds a macOS Mach-O 64-bit executable.
// Layout: __PAGEZERO(0..4GB) + __TEXT(4GB.., code) + __DATA(4GB+16MB, BSS)
fn write_macho_x86(output: string) -> i64 with IO, Mut, Panic, Div {
    let vm_base: i64 = 4294967296       // 0x100000000
    let page_size: i64 = 4096
    let text_vm = vm_base               // __TEXT vmaddr
    let data_vm = vm_base + 16777216    // __DATA vmaddr (BSS)
    let macos_build_ver: i64 = 720896   // 11.0.0

    // Mach-O header: 32 bytes
    // Load commands:
    // __PAGEZERO(72) + __TEXT(72+section*80=152) + __DATA(72+section*80=152)
    // + LC_LOAD_DYLINKER(32) + LC_UUID(24) + LC_BUILD_VERSION(24) + LC_MAIN(24)
    let hdr_size = 32
    let lc_pagezero_size = 72
    let lc_text_size = 72 + 80          // segment + 1 section (__text)
    let lc_data_size = 72 + 80          // segment + 1 section (__bss)
    let lc_dylinker_size = 32
    let lc_uuid_size = 24
    let lc_build_version_size = 24
    let lc_main_size = 24
    let ncmds = 7
    let sizeofcmds = lc_pagezero_size + lc_text_size + lc_data_size + lc_dylinker_size + lc_uuid_size + lc_build_version_size + lc_main_size

    let text_file_off = ((hdr_size + sizeofcmds + page_size - 1) / page_size) * page_size
    let text_file_size = ((CL + page_size - 1) / page_size) * page_size
    let total_file_size = text_file_off + text_file_size
    let text_seg_vmsize = text_file_off + text_file_size  // covers headers + code

    print("macho_build: code="); print_int(CL); print(" text_off="); print_int(text_file_off); print("\n")

    var i: i64 = 0
    while i < 1048576 { ELF[i as usize] = 0; i = i + 1 }

    // Mach-O header (32 bytes)
    elf_w32(0, 0xFEEDFACF)               // magic (64-bit)
    elf_w32(4, 0x01000007)                // cputype = x86_64
    elf_w32(8, 0x80000003)                // cpusubtype = ALL | LIB64
    elf_w32(12, 2)                        // filetype = MH_EXECUTE
    elf_w32(16, ncmds)                    // ncmds
    elf_w32(20, sizeofcmds)              // sizeofcmds
    elf_w32(24, 0x00000085)               // flags: NOUNDEFS | DYLDLINK | TWOLEVEL

    // LC_SEGMENT_64 __PAGEZERO (72 bytes at offset 32)
    var off = hdr_size
    elf_w32(off, 25)                      // cmd = LC_SEGMENT_64
    elf_w32(off+4, lc_pagezero_size)      // cmdsize
    // segname "__PAGEZERO" at off+8 (16 bytes)
    elf_w8(off+8, 95); elf_w8(off+9, 95)  // __
    elf_w8(off+10, 80); elf_w8(off+11, 65); elf_w8(off+12, 71); elf_w8(off+13, 69)  // PAGE
    elf_w8(off+14, 90); elf_w8(off+15, 69); elf_w8(off+16, 82); elf_w8(off+17, 79)  // ZERO
    elf_w64(off+24, 0)                    // vmaddr
    elf_w64(off+32, vm_base)              // vmsize = 4GB
    elf_w64(off+40, 0)                    // fileoff
    elf_w64(off+48, 0)                    // filesize
    elf_w32(off+56, 0)                    // maxprot
    elf_w32(off+60, 0)                    // initprot
    elf_w32(off+64, 0)                    // nsects
    elf_w32(off+68, 0)                    // flags

    // LC_SEGMENT_64 __TEXT + __text section (152 bytes)
    off = hdr_size + lc_pagezero_size
    elf_w32(off, 25)                      // cmd = LC_SEGMENT_64
    elf_w32(off+4, lc_text_size)          // cmdsize
    // segname "__TEXT"
    elf_w8(off+8, 95); elf_w8(off+9, 95)
    elf_w8(off+10, 84); elf_w8(off+11, 69); elf_w8(off+12, 88); elf_w8(off+13, 84)
    elf_w64(off+24, text_vm)              // vmaddr
    elf_w64(off+32, text_seg_vmsize)      // vmsize
    elf_w64(off+40, 0)                    // fileoff
    elf_w64(off+48, total_file_size)      // filesize
    elf_w32(off+56, 5)                    // maxprot = r-x
    elf_w32(off+60, 5)                    // initprot = r-x
    elf_w32(off+64, 1)                    // nsects = 1
    elf_w32(off+68, 0)                    // flags

    // __text section header (80 bytes at off+72)
    let sec = off + 72
    // sectname "__text"
    elf_w8(sec, 95); elf_w8(sec+1, 95)
    elf_w8(sec+2, 116); elf_w8(sec+3, 101); elf_w8(sec+4, 120); elf_w8(sec+5, 116)  // text
    // segname "__TEXT"
    elf_w8(sec+16, 95); elf_w8(sec+17, 95)
    elf_w8(sec+18, 84); elf_w8(sec+19, 69); elf_w8(sec+20, 88); elf_w8(sec+21, 84)
    elf_w64(sec+32, text_vm + text_file_off)  // addr
    elf_w64(sec+40, CL)                       // size
    elf_w32(sec+48, text_file_off)            // offset
    elf_w32(sec+52, 4)                        // align (2^4 = 16)
    elf_w32(sec+56, 0)                        // reloff
    elf_w32(sec+60, 0)                        // nreloc
    elf_w32(sec+64, 0x80000400)               // flags: PURE_INSTRUCTIONS | SOME_INSTRUCTIONS

    // LC_SEGMENT_64 __DATA + __bss section (152 bytes)
    off = hdr_size + lc_pagezero_size + lc_text_size
    elf_w32(off, 25)                      // cmd = LC_SEGMENT_64
    elf_w32(off+4, lc_data_size)          // cmdsize
    // segname "__DATA"
    elf_w8(off+8, 95); elf_w8(off+9, 95)
    elf_w8(off+10, 68); elf_w8(off+11, 65); elf_w8(off+12, 84); elf_w8(off+13, 65)
    elf_w64(off+24, data_vm)              // vmaddr
    elf_w64(off+32, ((GL_BSS_SIZE + page_size - 1) / page_size) * page_size)  // vmsize
    elf_w64(off+40, 0)                    // fileoff
    elf_w64(off+48, 0)                    // filesize = 0 (BSS)
    elf_w32(off+56, 3)                    // maxprot = rw-
    elf_w32(off+60, 3)                    // initprot = rw-
    elf_w32(off+64, 1)                    // nsects = 1
    elf_w32(off+68, 0)                    // flags

    // __bss section header (80 bytes at off+72)
    let bsec = off + 72
    elf_w8(bsec, 95); elf_w8(bsec+1, 95)
    elf_w8(bsec+2, 98); elf_w8(bsec+3, 115); elf_w8(bsec+4, 115)  // bss
    elf_w8(bsec+16, 95); elf_w8(bsec+17, 95)
    elf_w8(bsec+18, 68); elf_w8(bsec+19, 65); elf_w8(bsec+20, 84); elf_w8(bsec+21, 65)
    elf_w64(bsec+32, data_vm)                 // addr
    elf_w64(bsec+40, GL_BSS_SIZE)             // size
    elf_w32(bsec+48, 0)                       // offset = 0 (BSS)
    elf_w32(bsec+52, 4)                       // align (2^4 = 16)
    elf_w32(bsec+64, 1)                       // flags: S_ZEROFILL

    // LC_LOAD_DYLINKER (32 bytes)
    off = hdr_size + lc_pagezero_size + lc_text_size + lc_data_size
    elf_w32(off, 14)                       // cmd = LC_LOAD_DYLINKER
    elf_w32(off+4, lc_dylinker_size)       // cmdsize
    elf_w32(off+8, 12)                     // path offset
    elf_w8(off+12, 47); elf_w8(off+13, 117); elf_w8(off+14, 115); elf_w8(off+15, 114)   // /usr
    elf_w8(off+16, 47); elf_w8(off+17, 108); elf_w8(off+18, 105); elf_w8(off+19, 98)    // /lib
    elf_w8(off+20, 47); elf_w8(off+21, 100); elf_w8(off+22, 121); elf_w8(off+23, 108); elf_w8(off+24, 100); elf_w8(off+25, 0)   // /dyld

    // LC_UUID (24 bytes)
    off = hdr_size + lc_pagezero_size + lc_text_size + lc_data_size + lc_dylinker_size
    elf_w32(off, 27)                       // cmd = LC_UUID
    elf_w32(off+4, lc_uuid_size)           // cmdsize
    elf_w8(off+8, 83); elf_w8(off+9, 79); elf_w8(off+10, 85); elf_w8(off+11, 78)        // SOUN
    elf_w8(off+12, 73); elf_w8(off+13, 79); elf_w8(off+14, 88); elf_w8(off+15, 2)       // IOX + macOS
    elf_w8(off+16, CL & 255); elf_w8(off+17, (CL >> 8) & 255); elf_w8(off+18, (CL >> 16) & 255); elf_w8(off+19, (CL >> 24) & 255)
    elf_w8(off+20, GL_BSS_SIZE & 255); elf_w8(off+21, (GL_BSS_SIZE >> 8) & 255); elf_w8(off+22, (GL_BSS_SIZE >> 16) & 255); elf_w8(off+23, (GL_BSS_SIZE >> 24) & 255)

    // LC_BUILD_VERSION (24 bytes)
    off = hdr_size + lc_pagezero_size + lc_text_size + lc_data_size + lc_dylinker_size + lc_uuid_size
    elf_w32(off, 50)                       // cmd = LC_BUILD_VERSION
    elf_w32(off+4, lc_build_version_size) // cmdsize
    elf_w32(off+8, 1)                      // platform = macOS
    elf_w32(off+12, macos_build_ver)       // minos = 11.0.0
    elf_w32(off+16, macos_build_ver)       // sdk = 11.0.0
    elf_w32(off+20, 0)                     // ntools

    // LC_MAIN (24 bytes)
    off = hdr_size + lc_pagezero_size + lc_text_size + lc_data_size + lc_dylinker_size + lc_uuid_size + lc_build_version_size
    elf_w32(off, 0x80000028)              // cmd = LC_MAIN
    elf_w32(off+4, lc_main_size)          // cmdsize
    elf_w64(off+8, text_file_off + TRAMP_OFF)  // entryoff (file offset of entry)
    elf_w64(off+16, 0)                    // stacksize (0 = default)

    // Copy code at text_file_off
    i = 0
    while i < CL { ELF[(text_file_off + i) as usize] = CD[i as usize]; i = i + 1 }

    let ok = write_file(output, ELF, total_file_size)
    print("macho: "); print(output); print(" "); print_int(total_file_size)
    print(" bytes\n")
    return 0
}

// ═══ ARM64 (AArch64) Backend ═══

// ─── ARM64 syscall helper ───
fn emit_syscall_a64() with Mut {
    if TARGET_OS == 2 {
        em32(0xD4001001)  // svc #0x80 (macOS)
    } else {
        em32(0xD4000001)  // svc #0 (Linux)
    }
}

// a64 twin of emit_syscall6_x86 for `syscall6(number, a1..a6)`: 7 args are on the
// a64 stack (16-byte stride, arg0/number highest). Load number→x8, a1..a6→x0..x5,
// then svc; result in x0. (arm64 syscall ABI vs x86 rax/rdi/rsi/rdx/r10/r8/r9.)
fn emit_syscall6_a64(argc: i64) with Mut, Panic, Div {
    // Syscall number: x16 on macOS (svc #0x80), x8 on Linux (svc #0) — mirror the
    // OS split the rest of the a64 backend uses (e.g. emit_write_file_a64).
    if argc >= 1 {
        if TARGET_OS == 2 { em32(0xF94003F0 | ((((argc - 1) * 16) / 8) << 10)) }  // ldr x16, [sp, #(argc-1)*16]
        else { em32(0xF94003E8 | ((((argc - 1) * 16) / 8) << 10)) }              // ldr x8
    }
    if argc >= 2 { em32(0xF94003E0 | ((((argc - 2) * 16) / 8) << 10)) }  // ldr x0, [sp, ...]  (a1)
    if argc >= 3 { em32(0xF94003E1 | ((((argc - 3) * 16) / 8) << 10)) }  // ldr x1  (a2)
    if argc >= 4 { em32(0xF94003E2 | ((((argc - 4) * 16) / 8) << 10)) }  // ldr x2  (a3)
    if argc >= 5 { em32(0xF94003E3 | ((((argc - 5) * 16) / 8) << 10)) }  // ldr x3  (a4)
    if argc >= 6 { em32(0xF94003E4 | ((((argc - 6) * 16) / 8) << 10)) }  // ldr x4  (a5)
    if argc >= 7 { em32(0xF94003E5 | ((((argc - 7) * 16) / 8) << 10)) }  // ldr x5  (a6)
    emit_syscall_a64()
    emit_drop_call_args_a64(argc)
}

// ─── ARM64 print("string") ───
fn emit_print_a64(tok: i64) with Mut, Panic, Div {
    let ss = TS[tok as usize] + 1
    let se = TE[tok as usize] - 1
    var slen: i64 = 0
    var zi: i64 = 0
    while zi < 256 { SQW[zi as usize] = 0; zi = zi + 1 }
    var si: i64 = ss
    while si < se {
        let c = sb(si)
        var byte: i64 = c
        if c == 92 && si + 1 < se {
            let c2 = sb(si + 1)
            if c2 == 120 && si + 3 < se {
                let h1 = sb(si + 2)
                let h2 = sb(si + 3)
                var v1: i64 = 0 - 1
                if h1 >= 48 && h1 <= 57 { v1 = h1 - 48 }
                else if h1 >= 97 && h1 <= 102 { v1 = h1 - 87 }
                else if h1 >= 65 && h1 <= 70 { v1 = h1 - 55 }
                var v2: i64 = 0 - 1
                if h2 >= 48 && h2 <= 57 { v2 = h2 - 48 }
                else if h2 >= 97 && h2 <= 102 { v2 = h2 - 87 }
                else if h2 >= 65 && h2 <= 70 { v2 = h2 - 55 }
                if v1 >= 0 && v2 >= 0 {
                    byte = v1 * 16 + v2
                    si = si + 4
                } else {
                    byte = c2
                    si = si + 2
                }
            } else {
                if c2 == 110 { byte = 10 }
                else if c2 == 116 { byte = 9 }
                else if c2 == 48 { byte = 0 }
                else { byte = c2 }
                si = si + 2
            }
        } else { si = si + 1 }
        SQW[slen as usize] = byte
        slen = slen + 1
    }
    // Emit: b skip; string_bytes (4-byte padded); skip: adr x1, -(pad_len); ...
    let pad_len = (slen + 3) / 4 * 4
    // b skip: offset = 1 + pad_len/4 instructions
    let b_off = 1 + pad_len / 4
    em32(0x14000000 | (b_off & 0x3FFFFFF))
    let str_start = CL
    // Emit string bytes
    var bi: i64 = 0
    while bi < pad_len {
        if bi < slen { em(SQW[bi as usize] & 0xFF) }
        else { em(0) }
        bi = bi + 1
    }
    // skip: adr x1, -(pad_len) — point back at string data
    let adr_off = 0 - pad_len
    let adr_immlo = adr_off & 3
    let adr_immhi = (adr_off >> 2) & 0x7FFFF
    em32(0x10000000 | ((adr_immlo & 0x3) << 29) | ((adr_immhi & 0x7FFFF) << 5) | 1)
    // mov x0, #1 (stdout fd)
    em32(0xD2800020)  // movz x0, #1
    // mov x2, #slen
    em32(0xD2800000 | ((slen & 0xFFFF) << 5) | 2)  // movz x2, #slen
    // syscall: write
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 4)  // x16 = write syscall (macOS)
    } else {
        em32(0xD2800000 | ((64 & 0xFFFF) << 5) | 8)  // movz x8, #64 (Linux write)
    }
    emit_syscall_a64()
}

fn emit_print_cstr_a64() with Mut {
    // x0 = C string pointer
    em32(0xAA0003E9)  // mov x9, x0
    em32(0xAA0003E1)  // mov x1, x0
    em32(0xD280000A)  // movz x10, #0
    let slp = CL
    em32(0x386A6920)  // ldrb w0, [x9, x10]
    em32(0x34000000 | (3 << 5) | 0)  // cbz w0, done
    em32(0x9100054A)  // add x10, x10, #1
    let brel = (slp - CL) / 4
    em32(0x14000000 | (brel & 0x3FFFFFF))
    em32(0xAA0A03E2)  // mov x2, x10
    em32(0xD2800020)  // movz x0, #1
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 4)
    } else {
        em32(0xD2800000 | ((64 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
}

fn emit_print_nl_a64() with Mut {
    em32(0xD1000000 | (16 << 10) | (31 << 5) | 31)  // sub sp, sp, #16
    em32(0xD280014A)  // movz x10, #10
    em32(0x390003EA)  // strb w10, [sp]
    em32(0xD2800020)  // movz x0, #1
    em32(0x910003E1)  // mov x1, sp
    em32(0xD2800022)  // movz x2, #1
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 4)
    } else {
        em32(0xD2800000 | ((64 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    em32(0x910043FF)  // add sp, sp, #16
}

fn emit_print_char_lit_a64(ch: i64) with Mut {
    em32(0xD1000000 | (16 << 10) | (31 << 5) | 31)  // sub sp, sp, #16
    em32(0xD2800000 | ((ch & 0xFFFF) << 5) | 10)     // movz x10, #ch
    em32(0x390003EA)                                  // strb w10, [sp]
    em32(0xD2800020)                                  // movz x0, #1
    em32(0x910003E1)                                  // mov x1, sp
    em32(0xD2800022)                                  // movz x2, #1
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 4)
    } else {
        em32(0xD2800000 | ((64 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    em32(0x910043FF)  // add sp, sp, #16
}

fn emit_print_char_a64() with Mut {
    // x0 = char value (from compile_or_a64); write its low byte to stdout.
    em32(0xD1000000 | (16 << 10) | (31 << 5) | 31)  // sub sp, sp, #16
    em32(0x390003E0)                                 // strb w0, [sp]   (store char byte first)
    em32(0xD2800020)                                 // movz x0, #1     (fd = stdout)
    em32(0x910003E1)                                 // mov x1, sp      (buf)
    em32(0xD2800022)                                 // movz x2, #1     (len = 1)
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 4)                    // x16 = 4 (macOS write)
    } else {
        em32(0xD2800000 | ((64 & 0xFFFF) << 5) | 8)  // movz x8, #64 (Linux write)
    }
    emit_syscall_a64()
    em32(0x910043FF)  // add sp, sp, #16
}

fn emit_assert_fail_a64() with Mut {
    em32(0xD2800020)  // movz x0, #1
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 1)
    } else {
        em32(0xD2800000 | ((93 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
}

// ─── ARM64 print_int ───
fn emit_print_int_a64() with Mut {
    // x0 = value to print
    // sub sp, sp, #64 for scratch buffer
    em32(0xD1000000 | (64 << 10) | (31 << 5) | 31)  // sub sp, sp, #64
    // No baked-in '\n' -- see the x86-64 twin. x9 starts at sp+63 and the
    // length stays (sp+64) - x1, exactly as in emit_print_u64_no_nl_a64.
    em32(0x91000000 | (63 << 10) | (31 << 5) | 9)   // add x9, sp, #63
    // x11 = 0 (negative flag)
    em32(0xD2800000 | 11)  // movz x11, #0
    // Check if negative: cmp x0, #0; b.ge skip_neg
    em32(0xF100001F)  // cmp x0, #0
    em32(0x5400006A)  // b.ge +12 (skip neg + flag set)
    // neg x0, x0
    em32(0xCB0003E0)
    // x11 = 1
    em32(0xD2800020 | 11)  // movz x11, #1
    // div loop: x10 = 10 divisor
    em32(0xD2800140 | 10)  // movz x10, #10
    let loop_top = CL
    // sdiv x12, x0, x10
    em32(0x9AC00C00 | (10 << 16) | (0 << 5) | 12)   // sdiv x12, x0, x10
    // msub x13, x12, x10, x0  (x13 = x0 - x12*x10 = remainder)
    em32(0x9B008000 | (10 << 16) | (0 << 10) | (12 << 5) | 13)  // msub x13, x12, x10, x0
    // add x13, x13, #48 ('0')
    em32(0x91000000 | (48 << 10) | (13 << 5) | 13)
    // strb w13, [x9, #0]
    em32(0x39000000 | (0 << 10) | (9 << 5) | 13)
    // x9 = x9 - 1
    em32(0xD1000000 | (1 << 10) | (9 << 5) | 9)
    // x0 = x12 (quotient)
    em32(0xAA0C03E0)  // mov x0, x12
    // cbnz x0, loop_top
    let rel = (loop_top - CL) / 4
    em32(0xB5000000 | ((rel & 0x7FFFF) << 5) | 0)
    // If negative, store '-'
    // cbz x11, skip_minus
    em32(0xB400008B)  // cbz x11, +16 (skip minus write + pointer move)
    em32(0xD2800000 | (45 << 5) | 13)  // movz x13, #45 ('-')
    em32(0x39000000 | (0 << 10) | (9 << 5) | 13)  // strb w13, [x9]
    em32(0xD1000000 | (1 << 10) | (9 << 5) | 9)   // x9 = x9 - 1
    // x1 = x9 + 1 (start of string)
    em32(0x91000000 | (1 << 10) | (9 << 5) | 1)    // add x1, x9, #1
    // x2 = sp + 64 - x1 (length)
    em32(0x91000000 | (64 << 10) | (31 << 5) | 2)  // add x2, sp, #64
    em32(0xCB010042)                                  // sub x2, x2, x1
    // write(1, x1, x2)
    em32(0xD2800020)  // movz x0, #1 (fd=stdout)
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 4)
    } else {
        em32(0xD2800000 | ((64 & 0xFFFF) << 5) | 8)  // movz x8, #64 (Linux write)
    }
    emit_syscall_a64()
    // add sp, sp, #64
    em32(0x91000000 | (64 << 10) | (31 << 5) | 31)
}

fn emit_print_u64_no_nl_a64() with Mut {
    em32(0xD1000000 | (64 << 10) | (31 << 5) | 31)  // sub sp, sp, #64
    em32(0x91000000 | (63 << 10) | (31 << 5) | 9)   // add x9, sp, #63
    em32(0xD280014A)                                  // movz x10, #10
    let loop_top = CL
    em32(0x9AC00C00 | (10 << 16) | (0 << 5) | 12)   // sdiv x12, x0, x10
    em32(0x9B008000 | (10 << 16) | (0 << 10) | (12 << 5) | 13)  // msub x13, x12, x10, x0
    em32(0x91000000 | (48 << 10) | (13 << 5) | 13)  // add x13, x13, #48
    em32(0x39000000 | (0 << 10) | (9 << 5) | 13)    // strb w13, [x9]
    em32(0xD1000000 | (1 << 10) | (9 << 5) | 9)     // sub x9, x9, #1
    em32(0xAA0C03E0)                                  // mov x0, x12
    let rel = (loop_top - CL) / 4
    em32(0xB5000000 | ((rel & 0x7FFFF) << 5) | 0)    // cbnz x0, loop
    em32(0x91000000 | (1 << 10) | (9 << 5) | 1)      // add x1, x9, #1
    em32(0x91000000 | (64 << 10) | (31 << 5) | 2)    // add x2, sp, #64
    em32(0xCB010042)                                  // sub x2, x2, x1
    em32(0xD2800020)                                  // movz x0, #1
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 4)
    } else {
        em32(0xD2800000 | ((64 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    em32(0x91000000 | (64 << 10) | (31 << 5) | 31)   // add sp, sp, #64
}

fn emit_print_fixed6_a64() with Mut {
    em32(0xD1000000 | (16 << 10) | (31 << 5) | 31)  // sub sp, sp, #16
    emit_imm64_reg_a64(10, 100000)
    em32(0x9AC00C00 | (10 << 16) | (0 << 5) | 12)
    em32(0x9B008000 | (10 << 16) | (0 << 10) | (12 << 5) | 13)
    em32(0x91000000 | (48 << 10) | (12 << 5) | 12)
    em32(0x39000000 | (0 << 10) | (31 << 5) | 12)
    em32(0xAA0D03E0)
    emit_imm64_reg_a64(10, 10000)
    em32(0x9AC00C00 | (10 << 16) | (0 << 5) | 12)
    em32(0x9B008000 | (10 << 16) | (0 << 10) | (12 << 5) | 13)
    em32(0x91000000 | (48 << 10) | (12 << 5) | 12)
    em32(0x39000000 | (1 << 10) | (31 << 5) | 12)
    em32(0xAA0D03E0)
    emit_imm64_reg_a64(10, 1000)
    em32(0x9AC00C00 | (10 << 16) | (0 << 5) | 12)
    em32(0x9B008000 | (10 << 16) | (0 << 10) | (12 << 5) | 13)
    em32(0x91000000 | (48 << 10) | (12 << 5) | 12)
    em32(0x39000000 | (2 << 10) | (31 << 5) | 12)
    em32(0xAA0D03E0)
    emit_imm64_reg_a64(10, 100)
    em32(0x9AC00C00 | (10 << 16) | (0 << 5) | 12)
    em32(0x9B008000 | (10 << 16) | (0 << 10) | (12 << 5) | 13)
    em32(0x91000000 | (48 << 10) | (12 << 5) | 12)
    em32(0x39000000 | (3 << 10) | (31 << 5) | 12)
    em32(0xAA0D03E0)
    emit_imm64_reg_a64(10, 10)
    em32(0x9AC00C00 | (10 << 16) | (0 << 5) | 12)
    em32(0x9B008000 | (10 << 16) | (0 << 10) | (12 << 5) | 13)
    em32(0x91000000 | (48 << 10) | (12 << 5) | 12)
    em32(0x39000000 | (4 << 10) | (31 << 5) | 12)
    em32(0x91000000 | (48 << 10) | (13 << 5) | 13)
    em32(0x39000000 | (5 << 10) | (31 << 5) | 13)
    em32(0xD2800020)  // movz x0, #1
    em32(0x910003E1)  // mov x1, sp
    em32(0xD28000C2)  // movz x2, #6
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 4)
    } else {
        em32(0xD2800000 | ((64 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    em32(0x910043FF)  // add sp, sp, #16
}

// ─── ARM64 print_f64 ───
fn emit_print_f64_a64() with Mut, Panic {
    em32(0xD1000000 | (32 << 10) | (31 << 5) | 31)  // sub sp, sp, #32
    em32(0xAA0003EF)                                  // mov x15, x0
    emit_imm64_reg_a64(9, 9223372036854775807)
    em32(0x8A090000)                                  // and x0, x0, x9
    let zero_abs_patch = CL
    em32(0xB4000000)                                  // cbz x0, zero
    emit_imm64_reg_a64(10, 52)
    em32(0x9AC02800 | (10 << 16) | (0 << 5) | 9)     // asrv x9, x0, x10
    emit_imm64_reg_a64(10, 2047)
    em32(0xEB00001F | (10 << 16) | (9 << 5))         // cmp x9, x10
    let nan_patch = CL
    em32(0x54000000)                                  // b.eq nan
    let zero_sub_patch = CL
    em32(0xB4000000 | 9)                              // cbz x9, zero
    em32(0xF100001F | (15 << 5))                      // cmp x15, #0
    let sign_done_patch = CL
    em32(0x5400000A)                                  // b.ge sign_done
    emit_print_char_lit_a64(45)
    patch_branch_a64(sign_done_patch, CL)
    em32(0x9E670000)                                  // fmov d0, x0
    em32(0x9E78000D)                                  // fcvtzs x13, d0
    em32(0xAA0D03E0)                                  // mov x0, x13
    em32(0x9E620001)                                  // scvtf d1, x0
    em32(0x1E613800)                                  // fsub d0, d0, d1
    emit_imm64_reg_a64(10, 4696837146684686336)       // 1000000.0
    em32(0x9E670141)                                  // fmov d1, x10
    em32(0x1E610800)                                  // fmul d0, d0, d1
    emit_imm64_reg_a64(10, 4602678819172646912)       // 0.5
    em32(0x9E670141)                                  // fmov d1, x10
    em32(0x1E612800)                                  // fadd d0, d0, d1
    em32(0x9E78000E)                                  // fcvtzs x14, d0
    emit_imm64_reg_a64(10, 1000000)
    em32(0xEB00001F | (10 << 16) | (14 << 5))        // cmp x14, x10
    let frac_ok_patch = CL
    em32(0x5400000B)                                  // b.lt frac_ok
    em32(0xD280000E)                                  // movz x14, #0
    em32(0x91000000 | (1 << 10) | (13 << 5) | 13)    // add x13, x13, #1
    patch_branch_a64(frac_ok_patch, CL)
    em32(0xF90003ED)                                  // str x13, [sp, #0]
    em32(0xF90007EE)                                  // str x14, [sp, #8]
    em32(0xF94003E0)                                  // ldr x0, [sp, #0]
    emit_print_u64_no_nl_a64()
    emit_print_char_lit_a64(46)
    em32(0xF94007E0)                                  // ldr x0, [sp, #8]
    emit_print_fixed6_a64()
    let done_norm_patch = CL
    em32(0x14000000)                                  // b done
    let zero_label = CL
    em32(0xD2800000)                                  // movz x0, #0
    em32(0xF90003E0)                                  // str x0, [sp, #0]
    em32(0xF90007E0)                                  // str x0, [sp, #8]
    em32(0xF94003E0)                                  // ldr x0, [sp, #0]
    emit_print_u64_no_nl_a64()
    emit_print_char_lit_a64(46)
    em32(0xF94007E0)                                  // ldr x0, [sp, #8]
    emit_print_fixed6_a64()
    let done_zero_patch = CL
    em32(0x14000000)                                  // b done
    let nan_label = CL
    emit_print_char_lit_a64(110)
    emit_print_char_lit_a64(97)
    emit_print_char_lit_a64(110)
    let done_label = CL
    em32(0x91000000 | (32 << 10) | (31 << 5) | 31)   // add sp, sp, #32
    patch_branch_a64(zero_abs_patch, zero_label)
    patch_branch_a64(zero_sub_patch, zero_label)
    patch_branch_a64(nan_patch, nan_label)
    patch_branch_a64(done_norm_patch, done_label)
    patch_branch_a64(done_zero_patch, done_label)
}

fn emit_read_i64_a64() with Mut {
    emit_pop_x1_a64()
    em32(0xF8607820)  // ldr x0, [x1, x0, lsl #3]
}

fn emit_read_f64_a64() with Mut {
    emit_pop_x1_a64()
    em32(0xF8607820)  // ldr x0, [x1, x0, lsl #3]
}

// ─── ARM64 read_file ───
fn emit_read_file_a64() with Mut, Panic {
    // x0 = path (C string pointer)
    emit_push_a64()
    if TARGET_OS == 2 {
        // macOS: open(path, O_RDONLY=0)
        em32(0xD2800001)  // movz x1, #0
        emit_imm64_reg_a64(16, 5)  // x16 = SYS_open
    } else {
        // Linux: openat(AT_FDCWD=-100, path, O_RDONLY=0)
        em32(0xAA0003E1)  // mov x1, x0
        emit_imm64_reg_a64(0, -100)  // x0 = AT_FDCWD
        em32(0xD2800002)  // movz x2, #0
        em32(0xD2800000 | ((56 & 0xFFFF) << 5) | 8)  // movz x8, #56
    }
    emit_syscall_a64()
    // x0 = fd. Push it.
    emit_push_a64()
    // mmap(NULL, 4MB+1, 3, MAP_PRIVATE|MAP_ANON, -1, 0)
    em32(0xD2800000)  // x0 = NULL
    emit_imm64_reg_a64(1, 0x400001)  // x1 = 4MB+1
    em32(0xD2800060 | 2)  // x2 = 3
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(3, 0x1002)  // x3 = MAP_PRIVATE|MAP_ANON (Darwin)
    } else {
        em32(0xD2800000 | ((0x22 & 0xFFFF) << 5) | 3)  // x3 = 0x22
    }
    emit_imm64_reg_a64(4, -1)  // x4 = -1
    em32(0xD2800005)  // x5 = 0
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 197)
    } else {
        em32(0xD2800000 | ((222 & 0xFFFF) << 5) | 8)  // x8 = 222 (mmap)
    }
    emit_syscall_a64()
    // x0 = buf. Push it.
    emit_push_a64()
    // read(fd, buf, 4MB): x0=fd, x1=buf, x2=len
    em32(0xAA0003E1)  // mov x1, x0 (buf)
    em32(0xF9400000 | ((16/8) << 10) | (31 << 5) | 0)  // ldr x0, [sp, #16] (fd)
    emit_imm64_reg_a64(2, 0x400000)  // x2 = 4MB
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 3)
    } else {
        em32(0xD2800000 | ((63 & 0xFFFF) << 5) | 8)  // x8 = 63 (read)
    }
    emit_syscall_a64()
    em32(0xAA0003E2)  // mov x2, x0 (bytes read)
    em32(0xF100005F)  // cmp x2, #0
    let read_ok_patch = CL
    em32(0x5400000A)  // b.ge read_ok
    em32(0xD2800002)  // movz x2, #0
    let read_ok_target = CL
    patch_branch_a64(read_ok_patch, read_ok_target)
    em32(0xF9400000 | ((0/8) << 10) | (31 << 5) | 1)  // ldr x1, [sp, #0] (buf)
    em32(0x8B020021)  // add x1, x1, x2
    em32(0x3900003F)  // strb wzr, [x1]
    // close(fd)
    em32(0xF9400000 | ((16/8) << 10) | (31 << 5) | 0)  // ldr x0, [sp, #16]
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 6)
    } else {
        em32(0xD2800000 | ((57 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    // Return buf
    em32(0xF84107E0)  // ldr x0, [sp], #16 (pop buf)
    em32(0x91000000 | (16 << 10) | (31 << 5) | 31)  // add sp, sp, #16 (discard fd)
}

// ─── ARM64 write_file ───
fn emit_write_file_a64_flags(linux_flags: i64, macos_flags: i64) with Mut, Panic {
    // On entry: stack=[buf, path] (path pushed first, buf second), x0=len
    em32(0xAA0003E4)  // mov x4, x0 (save len)
    em32(0xF9400000 | ((16/8) << 10) | (31 << 5) | 5)  // ldr x5, [sp, #16] (path)
    em32(0xF9400000 | ((0/8) << 10) | (31 << 5) | 6)   // ldr x6, [sp, #0] (buf)
    em32(0x91000000 | (32 << 10) | (31 << 5) | 31)      // add sp, sp, #32
    // open(path, O_WRONLY|O_CREAT|O_TRUNC, 0644)
    em32(0xAA0503E0)  // mov x0, x5 (path)
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(1, macos_flags)
        em32(0xD2800000 | ((0x1A4 & 0xFFFF) << 5) | 2)
        emit_imm64_reg_a64(16, 5)
    } else {
        em32(0xAA0003E1)  // mov x1, x0
        emit_imm64_reg_a64(0, -100)
        emit_imm64_reg_a64(2, linux_flags)
        em32(0xD2800000 | ((0x1A4 & 0xFFFF) << 5) | 3)
        em32(0xD2800000 | ((56 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    em32(0xF100001F)  // cmp x0, #0
    let open_ok_patch = CL
    em32(0x5400000A)  // b.ge open_ok
    let open_fail_done = CL
    em32(0x14000000)  // b done
    let open_ok_target = CL
    em32(0xAA0003E7)  // mov x7, x0 (save fd)
    // write(fd, buf, len)
    em32(0xAA0703E0)  // mov x0, x7
    em32(0xAA0603E1)  // mov x1, x6
    em32(0xAA0403E2)  // mov x2, x4
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 4)
    } else {
        em32(0xD2800000 | ((64 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    em32(0xAA0003EA)  // mov x10, x0 (write result)
    // close(fd)
    em32(0xAA0703E0)  // mov x0, x7
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 6)
    } else {
        em32(0xD2800000 | ((57 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    em32(0xAA0A03E0)  // mov x0, x10
    let done_target = CL
    patch_branch_a64(open_ok_patch, open_ok_target)
    patch_branch_a64(open_fail_done, done_target)
}

fn emit_write_file_a64() with Mut, Panic {
    emit_write_file_a64_flags(0x241, 0x601)
}

fn emit_append_file_a64() with Mut, Panic {
    emit_write_file_a64_flags(0x441, 0x209)
}

// ─── ARM64 file_size ───
fn emit_file_size_a64() with Mut, Panic {
    // x0 = path
    if TARGET_OS == 2 {
        em32(0xD2800001)
        emit_imm64_reg_a64(16, 5)
    } else {
        em32(0xAA0003E1)
        emit_imm64_reg_a64(0, -100)
        em32(0xD2800002)
        em32(0xD2800000 | ((56 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    // Detect open() failure and return -1 so callers (file_exists) can tell an
    // absent file from an empty one. macOS signals errors with the CARRY flag set
    // and x0 = a POSITIVE errno (e.g. ENOENT=2) — NOT a negative fd; checking
    // `fd < 0` (the Linux convention) would treat errno 2 as a valid fd, fstat
    // stderr, and return a garbage positive size → file_exists true for a missing
    // file → wrong import-path resolution. So branch on carry for macOS.
    var fsz_fail_done: i64 = 0
    if TARGET_OS == 2 {
        let fsz_open_ok = CL
        em32(0x54000003)   // b.cc open_ok (carry clear = success; patched)
        em32(0x92800000)   // movn x0, #0  → x0 = -1
        fsz_fail_done = CL
        em32(0x14000000)   // b done (patched)
        patch_branch_a64(fsz_open_ok, CL)
    } else {
        em32(0xF100001F)   // cmp x0, #0
        let fsz_open_ok = CL
        em32(0x5400000A)   // b.ge open_ok (patched)
        em32(0x92800000)   // movn x0, #0  → x0 = -1
        fsz_fail_done = CL
        em32(0x14000000)   // b done (patched)
        patch_branch_a64(fsz_open_ok, CL)
    }
    emit_push_a64()  // save fd
    em32(0xD1000000 | (160 << 10) | (31 << 5) | 31)  // sub sp, sp, #160
    em32(0x910003E1)  // mov x1, sp
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 339)
    } else {
        em32(0xD2800000 | ((80 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    if TARGET_OS == 2 {
        em32(0x79400BEA)  // ldrh w10, [sp, #4] (Darwin st_mode, offset 4, 16-bit)
        em32(0xF94033E9)  // ldr x9, [sp, #96] (Darwin syscall 339 stat layout)
    } else {
        em32(0xB9401BEA)  // ldr w10, [sp, #24] (Linux st_mode, offset 24, 32-bit)
        em32(0xF9400000 | ((48/8) << 10) | (31 << 5) | 9)  // ldr x9, [sp, #48]
    }
    // reject directories: (st_mode & S_IFMT) == S_IFDIR → x9 = -1 (mirror x86;
    // callers treat a directory like an unreadable/absent file). Encodings
    // verified byte-exact vs clang --target=aarch64.
    em32(0x12140D4A)  // and w10, w10, #0xF000 (S_IFMT)
    em32(0x7140115F)  // cmp w10, #0x4000 (S_IFDIR)
    em32(0x54000041)  // b.ne +8 (skip movn if not a directory)
    em32(0x92800009)  // movn x9, #0 → x9 = -1 (directory)
    em32(0x91000000 | (160 << 10) | (31 << 5) | 31)     // add sp, sp, #160
    em32(0xF84107E0)  // pop fd
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 6)
    } else {
        em32(0xD2800000 | ((57 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    em32(0xAA0903E0)  // mov x0, x9
    patch_branch_a64(fsz_fail_done, CL)  // done:
}

// ─── ARM64 arg_count ───
fn emit_arg_count_a64() with Mut {
    let argc_addr = GL_BSS_BASE - 16
    emit_image_addr_a64(argc_addr)
    em32(0xF9400000)  // ldr x0, [x0]
}

// ─── ARM64 get_arg ───
fn emit_get_arg_a64() with Mut {
    let argv_addr = GL_BSS_BASE - 8
    em32(0xAA0003E9)  // mov x9, x0
    emit_image_addr_a64(argv_addr)
    em32(0xF9400000)  // ldr x0, [x0]
    em32(0xF8697800)  // ldr x0, [x0, x9, lsl #3]
}

// ─── ARM64 str_len ───
fn emit_str_len_a64() with Mut {
    em32(0xAA0003E9)  // mov x9, x0
    em32(0xD2800000)  // movz x0, #0
    let top = CL
    em32(0x38606920 | 10)  // ldrb w10, [x9, x0]
    em32(0x34000000 | (3 << 5) | 10)  // cbz w10, +3
    em32(0x91000400)  // add x0, x0, #1
    let brel = (top - CL) / 4
    em32(0x14000000 | (brel & 0x3FFFFFF))
}

// ─── ARM64 f64 binary op helper ───
fn emit_f64_binop_a64(opcode: i64) with Mut {
    em32(0x9E670020)  // fmov d0, x1 (LHS)
    em32(0x9E670001)  // fmov d1, x0 (RHS)
    em32(opcode)       // f64 op d0, d0, d1
    em32(0x9E660000)  // fmov x0, d0
}

fn compile_measure_call_a64(call_tok: i64) with IO, Mut, Panic, Div {
    EP = EP + 1
    var value_ty: i64 = 0
    var value_hash: i64 = 0
    var value_tok: i64 = -1
    var unc_ty: i64 = 0
    var unc_tok: i64 = -1
    var conf_ty: i64 = 0
    var value_slot: i64 = -1
    var unc_slot: i64 = -1
    var conf_slot: i64 = -1
    var argc: i64 = 0
    var saw_unc: i64 = 0
    var saw_conf: i64 = 0
    if TK[EP as usize] != 7 && TK[EP as usize] != 0 {
        let arg_start = EP
        compile_or_a64()
        value_ty = EXPR_TY
        value_hash = EXPR_TY_HASH
        value_tok = expr_simple_numeric_tok(arg_start, EP)
        value_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        emit_store_var_a64(value_slot)
        argc = 1
    }
    while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
        if TK[EP as usize] == 28 { EP = EP + 1 }
        if TK[EP as usize] == 7 || TK[EP as usize] == 0 { break }
        var label_kind: i64 = 0
        if TK[EP as usize] == 3 && TK[(EP + 1) as usize] == 43 {
            let lns = TS[EP as usize]
            let lne = TE[EP as usize]
            if src_match(lns, lne - lns, "uncertainty") { label_kind = 1 }
            else if src_match(lns, lne - lns, "confidence") { label_kind = 2 }
            else { tc_error(call_tok, "unknown measure metadata label") }
            EP = EP + 2
        }
        let arg_start = EP
        compile_or_a64()
        let arg_ty = EXPR_TY
        let lit_tok = expr_simple_numeric_tok(arg_start, EP)
        let tmp_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        emit_store_var_a64(tmp_slot)
        argc = argc + 1
        if label_kind == 2 || (label_kind == 0 && saw_unc != 0 && saw_conf == 0) {
            if saw_conf != 0 { tc_error(call_tok, "duplicate measure confidence") }
            conf_slot = tmp_slot
            conf_ty = arg_ty
            saw_conf = 1
        } else {
            if saw_unc != 0 { tc_error(call_tok, "duplicate measure uncertainty") }
            unc_slot = tmp_slot
            unc_ty = arg_ty
            unc_tok = lit_tok
            saw_unc = 1
        }
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }
    if argc <= 0 { tc_wrong_arity(call_tok, 2, 0) }
    let eps_scaled = infer_measure_eps_scaled(value_tok, unc_tok)
    let base_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 3
    if value_slot >= 0 { emit_load_var_a64(value_slot) } else { em32(0xD2800000) }
    emit_store_var_a64(base_slot + 2)
    if unc_slot >= 0 {
        emit_load_var_a64(unc_slot)
        if unc_ty != 2 {
            if ty_is_numeric(unc_ty) {
                em32(0x9E620000)
                em32(0x9E660000)
            } else {
                tc_error(call_tok, "measure uncertainty must be numeric")
                em32(0xD2800000)
            }
        }
        em32(0xAA0003E1)
        emit_f64_binop_a64(0x1E610800)
    } else {
        em32(0xD2800000)
    }
    emit_store_var_a64(base_slot + 1)
    if conf_slot >= 0 {
        emit_load_var_a64(conf_slot)
        if conf_ty != 2 {
            if ty_is_numeric(conf_ty) {
                em32(0x9E620000)
                em32(0x9E660000)
            } else {
                tc_error(call_tok, "measure confidence must be numeric")
                emit_imm64_a64(4607182418800017408)
            }
        }
    } else {
        emit_imm64_a64(4607182418800017408)
    }
    emit_store_var_a64(base_slot)
    emit_lea_var_a64(base_slot + 2)
    EXPR_IS_F64 = 0
    EXPR_TY = 0
    EXPR_TY_HASH = knowledge_hash_make(value_ty, value_hash, eps_scaled)
}

fn emit_heap_alloc_a64() with Mut {
    // x0 = requested size. Allocate size+8 via mmap, write header, return user ptr.
    em32(0x91002000)               // add x0, x0, #8 (total = size + header)
    em32(0xAA0003E9)               // mov x9, x0 (save total size in x9)
    em32(0xAA0003E1)               // mov x1, x0 (mmap size arg)
    em32(0xD2800000)               // movz x0, #0 (addr = NULL)
    em32(0xD2800062)               // movz x2, #3 (PROT_READ|PROT_WRITE)
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(3, 0x1002) // x3 = MAP_PRIVATE|MAP_ANON (Darwin)
    } else {
        em32(0xD2800443)               // movz x3, #0x22 (Linux)
    }
    em32(0x92800004)               // movn x4, #0 (fd = -1)
    em32(0xD2800005)               // movz x5, #0 (offset)
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 197)
    } else {
        em32(0xD2800000 | ((222 & 0xFFFF) << 5) | 8) // movz x8, #222 (SYS_mmap Linux)
    }
    emit_syscall_a64()             // x0 = mmap base
    em32(0xF9000009)               // str x9, [x0] (write header)
    em32(0x91002000)               // add x0, x0, #8 (return user ptr)
}

fn emit_heap_free_a64() with Mut {
    // x0 = user pointer. Read header at [ptr-8], munmap(base, total).
    em32(0xD1002000)               // sub x0, x0, #8 (back to mmap base)
    em32(0xF9400001)               // ldr x1, [x0] (total size)
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 73)
    } else {
        em32(0xD2800000 | ((215 & 0xFFFF) << 5) | 8) // movz x8, #215 (SYS_munmap Linux)
    }
    emit_syscall_a64()
}

fn emit_heap_realloc_a64() with Mut {
    // x10 = old_user_ptr (saved by caller), x0 = new_size.
    // Linux mremap(old_base, old_total, new_total, MREMAP_MAYMOVE)
    em32(0x91002000)               // add x0, x0, #8 (new_total)
    em32(0xAA0003E9)               // mov x9, x0 (save new_total in x9)
    em32(0xD100200A)               // sub x10, x0, ... wait — x10 has old_user_ptr from caller
    // Caller has: push old_ptr, then compile new_size → x0. We pop old_ptr.
    // Actually for ARM64, caller saves old_ptr in x10 before calling this.
    // x10 = old_user_ptr, x0 = new_size (already added 8 above)
    em32(0xD100214A)               // sub x10, x10, #8 (old mmap base)
    em32(0xF940014B)               // ldr x11, [x10] (old_total)
    em32(0xAA0A03E0)               // mov x0, x10 (old base → arg1)
    em32(0xAA0B03E1)               // mov x1, x11 (old_total → arg2)
    em32(0xAA0903E2)               // mov x2, x9 (new_total → arg3)
    em32(0xD2800023)               // movz x3, #1 (MREMAP_MAYMOVE)
    em32(0xD2800000 | ((216 & 0xFFFF) << 5) | 8) // movz x8, #216 (SYS_mremap Linux)
    emit_syscall_a64()             // x0 = new mmap base
    em32(0xF9000009)               // str x9, [x0] (write new header)
    em32(0x91002000)               // add x0, x0, #8 (return user ptr)
}

fn compile_acknowledge_call_a64(call_tok: i64) with IO, Mut, Panic, Div {
    // acknowledge(k: Knowledge<T>, reason: String) -> T  (ARM64)
    // Does NOT require `with Epistemic` — explicit uncertainty acknowledgment
    EP = EP + 1  // skip (
    if TK[EP as usize] == 7 || TK[EP as usize] == 0 {
        tc_arity_error(call_tok, "arity mismatch: acknowledge() requires 2 arguments")
        if TK[EP as usize] == 7 { EP = EP + 1 }
        EXPR_TY = 0
        EXPR_TY_HASH = 0
        EXPR_IS_F64 = 0
        return
    }
    // Compile first arg: the Knowledge<T> value
    compile_or_a64()
    let ack_k_ty_a = EXPR_TY
    let ack_k_hash_a = EXPR_TY_HASH
    // Expect comma + reason arg
    if TK[EP as usize] == 28 {
        EP = EP + 1
    } else {
        tc_arity_error(call_tok, "arity mismatch: acknowledge() requires 2 arguments")
    }
    // Skip reason arg (not compiled — documentation only)
    if TK[EP as usize] != 7 && TK[EP as usize] != 0 {
        EP = skip_call_arg_expr(EP)
    }
    // Check for extra args
    if TK[EP as usize] == 28 {
        tc_error(call_tok, "acknowledge() takes exactly 2 arguments")
        while TK[EP as usize] != 7 && TK[EP as usize] != 0 { EP = EP + 1 }
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }
    // Extract .value at offset 0: ldr x0, [x0]
    em32(0xF9400000)
    // Set result type to inner type
    if knowledge_hash_is(ack_k_hash_a) {
        let ack_inner_hash_a = knowledge_hash_inner_hash(ack_k_hash_a)
        EXPR_TY = knowledge_hash_inner_ty(ack_k_hash_a)
        EXPR_TY_HASH = ack_inner_hash_a
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
    } else if ack_k_ty_a == 6 {
        let ack_si_a = st_find(ack_k_hash_a)
        if ack_si_a >= 0 {
            EXPR_TY = ST_FTY[(ack_si_a * 128) as usize]
            EXPR_TY_HASH = ST_FHASH[(ack_si_a * 128) as usize]
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
        }
    }
}

fn compile_require_confidence_call_a64(call_tok: i64) with IO, Mut, Panic, Div {
    // require_confidence(k: Knowledge<T>, min: f64) -> T  (ARM64)
    // Extracts .value if confidence >= min, panics (exit 1) otherwise
    EP = EP + 1  // skip (
    if TK[EP as usize] == 7 || TK[EP as usize] == 0 {
        tc_arity_error(call_tok, "arity mismatch: require_confidence() requires 2 arguments")
        if TK[EP as usize] == 7 { EP = EP + 1 }
        EXPR_TY = 0
        EXPR_TY_HASH = 0
        EXPR_IS_F64 = 0
        return
    }
    // Compile first arg: Knowledge<T> value → x0 = struct ptr
    compile_or_a64()
    let rc_k_ty_a = EXPR_TY
    let rc_k_hash_a = EXPR_TY_HASH
    let rc_k_slot_a = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var_a64(rc_k_slot_a)
    // Expect comma + threshold
    if TK[EP as usize] == 28 {
        EP = EP + 1
    } else {
        tc_arity_error(call_tok, "arity mismatch: require_confidence() requires 2 arguments")
    }
    // Compile second arg: threshold f64
    compile_or_a64()
    let rc_min_slot_a = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var_a64(rc_min_slot_a)
    // Check for extra args
    if TK[EP as usize] == 28 {
        tc_error(call_tok, "require_confidence() takes exactly 2 arguments")
        while TK[EP as usize] != 7 && TK[EP as usize] != 0 { EP = EP + 1 }
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }
    // Load confidence field: [k_ptr + 16]
    emit_load_var_a64(rc_k_slot_a)
    em32(0xF9400800)   // ldr x0, [x0, #16] — confidence f64 bits
    em32(0xAA0003EA)   // mov x10, x0 (save confidence)
    emit_load_var_a64(rc_min_slot_a)  // x0 = threshold f64 bits
    // Compare: fcmp d0 (confidence), d1 (threshold)
    em32(0x9E670140)   // fmov d0, x10 (confidence)
    em32(0x9E670001)   // fmov d1, x0  (threshold)
    em32(0x1E612000)   // fcmp d0, d1
    // b.ge ok (skip panic if confidence >= threshold)
    em32(0x5400000A)   // b.ge placeholder
    let rc_ok_patch_a = CL - 4
    emit_assert_fail_a64()  // exit(1) — does not return
    patch_branch_a64(rc_ok_patch_a, CL)
    // Extract .value at offset 0
    emit_load_var_a64(rc_k_slot_a)
    em32(0xF9400000)   // ldr x0, [x0] — .value
    // Set result type to inner type
    if knowledge_hash_is(rc_k_hash_a) {
        let rc_inner_hash_a = knowledge_hash_inner_hash(rc_k_hash_a)
        EXPR_TY = knowledge_hash_inner_ty(rc_k_hash_a)
        EXPR_TY_HASH = rc_inner_hash_a
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
    } else if rc_k_ty_a == 6 {
        let rc_si_a = st_find(rc_k_hash_a)
        if rc_si_a >= 0 {
            EXPR_TY = ST_FTY[(rc_si_a * 128) as usize]
            EXPR_TY_HASH = ST_FHASH[(rc_si_a * 128) as usize]
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
        }
    }
}

fn compile_knowledge_literal_a64() with IO, Mut, Panic, Div {
    EP = EP + 1
    let base_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 3
    var value_ty: i64 = 0
    var value_hash: i64 = 0
    var saw_value: i64 = 0
    var saw_var: i64 = 0
    var saw_conf: i64 = 0
    var lit_mode: i64 = 0
    var lit_eps: i64 = -1
    while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 {
        if TK[EP as usize] == 3 {
            let field_tok = EP
            let fns = TS[EP as usize]
            let fne = TE[EP as usize]
            EP = EP + 1
            if TK[EP as usize] == 43 { EP = EP + 1 }
            let field_start = EP
            compile_or_a64()
            let field_ty = EXPR_TY
            let field_hash = EXPR_TY_HASH
            let lit_tok = expr_simple_numeric_tok(field_start, EP)
            if src_match(fns, fne - fns, "value") {
                emit_store_var_a64(base_slot + 2)
                value_ty = field_ty
                value_hash = field_hash
                saw_value = 1
            } else if src_match(fns, fne - fns, "variance") {
                if field_ty != 2 {
                    if ty_is_numeric(field_ty) {
                        em32(0x9E620000)
                        em32(0x9E660000)
                    } else {
                        tc_error(field_tok, "Knowledge variance must be numeric")
                        em32(0xD2800000)
                    }
                }
                emit_store_var_a64(base_slot + 1)
                saw_var = 1
            } else if src_match(fns, fne - fns, "uncertainty") {
                if field_ty != 2 {
                    if ty_is_numeric(field_ty) {
                        em32(0x9E620000)
                        em32(0x9E660000)
                    } else {
                        tc_error(field_tok, "Knowledge uncertainty must be numeric")
                        em32(0xD2800000)
                    }
                }
                em32(0xAA0003E1)
                emit_f64_binop_a64(0x1E610800)
                emit_store_var_a64(base_slot + 1)
                saw_var = 1
            } else if src_match(fns, fne - fns, "confidence") || src_match(fns, fne - fns, "epsilon") {
                if field_ty != 2 {
                    if ty_is_numeric(field_ty) {
                        em32(0x9E620000)
                        em32(0x9E660000)
                    } else {
                        tc_error(field_tok, "Knowledge epsilon must be numeric")
                        em32(0xD2800000)
                    }
                }
                emit_store_var_a64(base_slot)
                saw_conf = 1
                if lit_tok >= 0 {
                    let scaled = tok_scaled_million(lit_tok)
                    if scaled >= 0 && scaled <= 1000000 {
                        lit_mode = 1
                        lit_eps = scaled
                    }
                }
            } else if src_match(fns, fne - fns, "validity") || src_match(fns, fne - fns, "provenance") {
            } else {
                tc_error(field_tok, "unknown field in Knowledge literal")
            }
        }
        if TK[EP as usize] == 28 { EP = EP + 1 }
    }
    if TK[EP as usize] == 9 { EP = EP + 1 }
    if saw_value == 0 {
        em32(0xD2800000)
        emit_store_var_a64(base_slot + 2)
        value_ty = 0
        value_hash = 0
    }
    if saw_var == 0 {
        em32(0xD2800000)
        emit_store_var_a64(base_slot + 1)
    }
    if saw_conf == 0 {
        emit_imm64_a64(4607182418800017408)
        emit_store_var_a64(base_slot)
    }
    emit_lea_var_a64(base_slot + 2)
    EXPR_IS_F64 = 0
    EXPR_TY = 0
    EXPR_TY_HASH = knowledge_hash_make_mode(value_ty, value_hash, lit_mode, lit_eps)
    LAST_EXPR_IS_LINEAR = 0
}

// Paren-form constructor (ARM64): see compile_knowledge_paren_x86.
fn compile_knowledge_paren_a64() with IO, Mut, Panic, Div {
    EP = EP + 1  // skip '('
    let base_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 3
    var value_ty: i64 = 0
    var value_hash: i64 = 0
    var saw_value: i64 = 0
    var saw_var: i64 = 0
    var saw_conf: i64 = 0
    var lit_mode: i64 = 0
    var lit_eps: i64 = -1
    while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
        if TK[EP as usize] == 3 && (TK[(EP + 1) as usize] == 16 || TK[(EP + 1) as usize] == 43) {
            let field_tok = EP
            let fns = TS[EP as usize]
            let fne = TE[EP as usize]
            let is_eps_uni = tok_is_unicode_epsilon(field_tok)
            EP = EP + 2  // skip name and `=`/`:`
            let field_start = EP
            compile_or_a64()
            let field_ty = EXPR_TY
            let field_hash = EXPR_TY_HASH
            let lit_tok = expr_simple_numeric_tok(field_start, EP)
            if src_match(fns, fne - fns, "value") {
                emit_store_var_a64(base_slot + 2)
                value_ty = field_ty
                value_hash = field_hash
                saw_value = 1
            } else if src_match(fns, fne - fns, "variance") {
                if field_ty != 2 {
                    if ty_is_numeric(field_ty) {
                        em32(0x9E620000)
                        em32(0x9E660000)
                    } else {
                        tc_error(field_tok, "Knowledge variance must be numeric")
                        em32(0xD2800000)
                    }
                }
                emit_store_var_a64(base_slot + 1)
                saw_var = 1
            } else if src_match(fns, fne - fns, "uncertainty") {
                if field_ty != 2 {
                    if ty_is_numeric(field_ty) {
                        em32(0x9E620000)
                        em32(0x9E660000)
                    } else {
                        tc_error(field_tok, "Knowledge uncertainty must be numeric")
                        em32(0xD2800000)
                    }
                }
                em32(0xAA0003E1)
                emit_f64_binop_a64(0x1E610800)
                emit_store_var_a64(base_slot + 1)
                saw_var = 1
            } else if is_eps_uni || src_match(fns, fne - fns, "confidence") || src_match(fns, fne - fns, "epsilon") {
                if field_ty != 2 {
                    if ty_is_numeric(field_ty) {
                        em32(0x9E620000)
                        em32(0x9E660000)
                    } else {
                        tc_error(field_tok, "Knowledge epsilon must be numeric")
                        em32(0xD2800000)
                    }
                }
                emit_store_var_a64(base_slot)
                saw_conf = 1
                if lit_tok >= 0 {
                    let scaled = tok_scaled_million(lit_tok)
                    if scaled >= 0 && scaled <= 1000000 {
                        lit_mode = 1
                        lit_eps = scaled
                    }
                }
            } else if src_match(fns, fne - fns, "validity") || src_match(fns, fne - fns, "provenance") || src_match(fns, fne - fns, "prov") {
                // provenance string: compiled above, value discarded
            } else {
                tc_error(field_tok, "unknown field in Knowledge constructor")
            }
        } else {
            // Positional argument: the first one is the value
            compile_or_a64()
            if saw_value == 0 {
                emit_store_var_a64(base_slot + 2)
                value_ty = EXPR_TY
                value_hash = EXPR_TY_HASH
                saw_value = 1
            }
        }
        if TK[EP as usize] == 28 { EP = EP + 1 }  // optional comma
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }  // skip ')'
    if saw_value == 0 {
        em32(0xD2800000)
        emit_store_var_a64(base_slot + 2)
        value_ty = 0
        value_hash = 0
    }
    if saw_var == 0 {
        em32(0xD2800000)
        emit_store_var_a64(base_slot + 1)
    }
    if saw_conf == 0 {
        emit_imm64_a64(4607182418800017408)
        emit_store_var_a64(base_slot)
    }
    emit_lea_var_a64(base_slot + 2)
    EXPR_IS_F64 = 0
    EXPR_TY = 0
    EXPR_TY_HASH = knowledge_hash_make_mode(value_ty, value_hash, lit_mode, lit_eps)
    LAST_EXPR_IS_LINEAR = 0
}

// ─── ARM64 expression compiler ───
fn compile_primary_a64() with IO, Mut, Panic, Div {
    LAST_EXPR_IS_CLOSURE = 0
    LAST_EXPR_IS_LINEAR = 0
    EXPR_VSHADOW = -1
    EXPR_SSHADOW = -1
    EXPR_SSHADOW_1 = -1; EXPR_SSHADOW_2 = -1; EXPR_SSHADOW_3 = -1; EXPR_SSHADOW_4 = -1; EXPR_SSHADOW_5 = -1; EXPR_SSHADOW_6 = -1; EXPR_SSHADOW_7 = -1
    EXPR_HSHADOW_00 = -1; EXPR_HSHADOW_01 = -1; EXPR_HSHADOW_02 = -1; EXPR_HSHADOW_03 = -1
    EXPR_HSHADOW_11 = -1; EXPR_HSHADOW_12 = -1; EXPR_HSHADOW_13 = -1
    EXPR_HSHADOW_22 = -1; EXPR_HSHADOW_23 = -1; EXPR_HSHADOW_33 = -1
    EXPR_HSHADOW_04 = -1; EXPR_HSHADOW_05 = -1; EXPR_HSHADOW_06 = -1; EXPR_HSHADOW_07 = -1
    EXPR_HSHADOW_14 = -1; EXPR_HSHADOW_15 = -1; EXPR_HSHADOW_16 = -1; EXPR_HSHADOW_17 = -1
    EXPR_HSHADOW_24 = -1; EXPR_HSHADOW_25 = -1; EXPR_HSHADOW_26 = -1; EXPR_HSHADOW_27 = -1
    EXPR_HSHADOW_34 = -1; EXPR_HSHADOW_35 = -1; EXPR_HSHADOW_36 = -1; EXPR_HSHADOW_37 = -1
    EXPR_HSHADOW_44 = -1; EXPR_HSHADOW_45 = -1; EXPR_HSHADOW_46 = -1; EXPR_HSHADOW_47 = -1
    EXPR_HSHADOW_55 = -1; EXPR_HSHADOW_56 = -1; EXPR_HSHADOW_57 = -1
    EXPR_HSHADOW_66 = -1; EXPR_HSHADOW_67 = -1
    EXPR_HSHADOW_77 = -1
    let k = TK[EP as usize]
    // Integer literal
    if k == 4 {
        let v = TV[EP as usize]
        if v == 0 { em32(0xD2800000) }
        else { emit_imm64_a64(v) }
        EP = EP + 1
        EXPR_IS_F64 = 0
        EXPR_TY = 1
        EXPR_TY_HASH = 0
        return
    }
    // true/false
    if k == 35 { em32(0xD2800020); EP = EP + 1; EXPR_IS_F64 = 0; EXPR_TY = 4; EXPR_TY_HASH = 0; return }
    if k == 36 { em32(0xD2800000); EP = EP + 1; EXPR_IS_F64 = 0; EXPR_TY = 4; EXPR_TY_HASH = 0; return }
    // Float literal
    if k == 53 {
        let fl_int = TV[EP as usize]
        let fl_frac = TF[EP as usize]
        let fl_denom = TD[EP as usize]
        if TX[EP as usize] >= 0 { FL_SCI_SCRATCH = TX[EP as usize]; FL_SCI_NEG = 0 }
        else { FL_SCI_SCRATCH = 0 - TX[EP as usize]; FL_SCI_NEG = 1 }
        EP = EP + 1
        emit_imm64_a64(fl_int)
        em32(0x9E620000)  // scvtf d0, x0
        if fl_frac > 0 {
            emit_imm64_a64(fl_frac)
            em32(0x9E620001)  // scvtf d1, x0
            emit_imm64_a64(fl_denom)
            em32(0x9E620002)  // scvtf d2, x0
            em32(0x1E601800 | (2 << 16) | (1 << 5) | 1)  // fdiv d1, d1, d2
            em32(0x1E612800)  // fadd d0, d0, d1
        }
        // Apply scientific exponent: mul/div d0 by 10.0 FL_SCI_SCRATCH times
        if FL_SCI_SCRATCH != 0 {
            emit_imm64_a64(0x4024000000000000)  // x0 = bits of 10.0
            em32(0x9E670001)  // fmov d1, x0
            if FL_SCI_NEG == 0 {
                while FL_SCI_SCRATCH > 0 {
                    em32(0x1E610800)  // fmul d0, d0, d1
                    FL_SCI_SCRATCH = FL_SCI_SCRATCH - 1
                }
            } else {
                while FL_SCI_SCRATCH > 0 {
                    em32(0x1E611800)  // fdiv d0, d0, d1
                    FL_SCI_SCRATCH = FL_SCI_SCRATCH - 1
                }
            }
        }
        em32(0x9E660000)  // fmov x0, d0
        EXPR_IS_F64 = 1
        EXPR_TY = 2
        EXPR_TY_HASH = 0
        return
    }
    if k == 48 {
        let match_tok = EP
        compile_stmt_a64()
        if LAST_STMT_HAS_VALUE == 0 { tc_error(match_tok, "match expression must yield a value") }
        EXPR_TY = LAST_STMT_TY
        EXPR_TY_HASH = LAST_STMT_TY_HASH
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 }
        else { EXPR_IS_F64 = 0 }
        return
    }
    if k == 13 {
        let if_tok = EP
        compile_stmt_a64()
        if LAST_STMT_HAS_VALUE == 0 { tc_error(if_tok, "if expression must yield a value") }
        EXPR_TY = LAST_STMT_TY
        EXPR_TY_HASH = LAST_STMT_TY_HASH
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 }
        else { EXPR_IS_F64 = 0 }
        return
    }
    if k == 41 {
        if array_init_is_repeat(EP) {
            EP = EP + 1
            compile_or_a64()
            let elem_ty = EXPR_TY
            let elem_hash = EXPR_TY_HASH
            if TK[EP as usize] == 27 { EP = EP + 1 }
            let rep_count = TV[EP as usize]
            EP = EP + 1
            if TK[EP as usize] == 42 { EP = EP + 1 }
            let arr_hash = arr_ty_hash_for_elem_type(rep_count, 8, elem_ty, elem_hash)
            let nslots = arr_storage_slots(arr_hash)
            if nslots > 0 {
                let base = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + nslots
                em32(0xAA0003ED)  // mov x13, x0
                emit_lea_var_a64(base + nslots - 1)
                em32(0xAA0003EB)  // mov x11, x0
