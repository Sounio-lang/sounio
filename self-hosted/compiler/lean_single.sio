fn scan_fn_param_type(fi: i64, arg_idx: i64) with IO, Mut, Panic, Div {
    SCAN_TY = 0
    SCAN_TY_HASH = 0
    SCAN_TY_NEXT = 0
    if fi < 0 || fi >= FN_COUNT { return }
    var q = FN_NAME_TOK[fi as usize] + 1
    if TK[q as usize] != 6 { return }
    q = q + 1
    var idx: i64 = 0
    while TK[q as usize] != 7 && TK[q as usize] != 0 {
        if TK[q as usize] == 3 || TK[q as usize] == 79 {
            q = q + 1
            if TK[q as usize] == 43 {
                q = q + 1
                scan_type(q)
                if idx == arg_idx { return }
                q = SCAN_TY_NEXT
                idx = idx + 1
            }
        } else {
            q = q + 1
        }
        if TK[q as usize] == 28 { q = q + 1 }
    }
    SCAN_TY = 0
    SCAN_TY_HASH = 0
}

fn scan_fnsig_param_type(sig: i64, arg_idx: i64) with Mut, Panic {
    SCAN_TY = 0
    SCAN_TY_HASH = 0
    SCAN_TY_NEXT = 0
    if sig <= 0 || sig >= FNSIG_COUNT { return }
    if arg_idx < 0 || arg_idx >= FNSIG_ARITY[sig as usize] { return }
    let base = sig * 16 + arg_idx
    SCAN_TY = FNSIG_PARAM_TY[base as usize]
    SCAN_TY_HASH = FNSIG_PARAM_HASH[base as usize]
}


fn print_effect_mask(mask: i64) with IO, Mut {
    if mask == 0 {
        print("Pure")
        return
    }
    var first: i64 = 1
    if (mask & 1) != 0 {
        if first == 0 { print(",") }
        print("IO")
        first = 0
    }
    if (mask & 2) != 0 {
        if first == 0 { print(",") }
        print("Mut")
        first = 0
    }
    if (mask & 4) != 0 {
        if first == 0 { print(",") }
        print("Panic")
        first = 0
    }
    if (mask & 8) != 0 {
        if first == 0 { print(",") }
        print("Div")
        first = 0
    }
    if (mask & 16) != 0 {
        if first == 0 { print(",") }
        print("Alloc")
        first = 0
    }
    if (mask & 64) != 0 {
        if first == 0 { print(",") }
        print("Observe")
        first = 0
    }
    if (mask & 128) != 0 {
        if first == 0 { print(",") }
        print("Audit")
        first = 0
    }
    if (mask & 256) != 0 {
        if first == 0 { print(",") }
        print("Hypothesis")
        first = 0
    }
    if (mask & 512) != 0 {
        if first == 0 { print(",") }
        print("Epistemic")
        first = 0
    }
    if (mask & 262144) != 0 {
        if first == 0 { print(",") }
        print("Approx")
        first = 0
    }
    if (mask & 524288) != 0 {
        if first == 0 { print(",") }
        print("Causal")
        first = 0
    }
    if (mask & 1048576) != 0 {
        if first == 0 { print(",") }
        print("NaturalityG2")
    }
}

// Keep bitset subset/clear operations free of unary `~` so the
// source-bootstrap lane does not depend on its lowering.
fn bitset_is_subset(required: i64, available: i64) -> bool {
    return (required & available) == required
}

fn bitset_clear(bits: i64, clear_mask: i64) -> i64 {
    return bits - (bits & clear_mask)
}

fn tc_effect_violation(tok: i64, callee_eff: i64, caller_eff: i64) -> i64 with IO, Mut, Panic {
    // Skip effect violations for functions from imported modules — already validated
    if (FN_EFFECTS[CURRENT_FN as usize] & 2048) != 0 { return 0 }
    tc_mark_failed()
    print("error[E035]: effect not declared in function signature at line ")
    print_int(TL[tok as usize])
    print("\n")
    return 0
}

