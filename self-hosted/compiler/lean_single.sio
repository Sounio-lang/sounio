        if TK[EP as usize] == 23 && EP + 2 < TC && TK[(EP + 1) as usize] == 3 && TK[(EP + 2) as usize] == 24 {
            let g_tys = TS[(EP + 1) as usize]
            let g_tye = TE[(EP + 1) as usize]
            var g_gi: i64 = 0
            var g_found: i64 = 0
            while g_gi < GEN_FN_COUNT && g_found == 0 {
                if name_eq(ns, ne, GEN_FN_NS[g_gi as usize], GEN_FN_NE[g_gi as usize]) {
                    let g_mi = mono_find_inst(g_gi, 0, g_tys, g_tye)
                    if g_mi >= 0 { ns = MAN_BUF_S[g_mi as usize]; ne = MAN_BUF_E[g_mi as usize]; g_found = 1 }
                }
                g_gi = g_gi + 1
            }
            g_gi = 0
            while g_gi < GEN_ST_COUNT && g_found == 0 {
                if name_eq(ns, ne, GEN_ST_NS[g_gi as usize], GEN_ST_NE[g_gi as usize]) {
                    let g_mi = mono_find_inst(g_gi, 1, g_tys, g_tye)
                    if g_mi >= 0 { ns = MAN_BUF_S[g_mi as usize]; ne = MAN_BUF_E[g_mi as usize]; g_found = 1 }
                }
