        }
        let nparams_a = VAR_COUNT
        CL_FNSIG_NPARAMS[(CL_DEPTH - 1) as usize] = nparams_a
        var cl_pi_a: i64 = 0
        while cl_pi_a < nparams_a {
            CL_FNSIG_PARAM_TY[((CL_DEPTH - 1) * 16 + cl_pi_a) as usize] = VAR_TY[cl_pi_a as usize]
            CL_FNSIG_PARAM_TH[((CL_DEPTH - 1) * 16 + cl_pi_a) as usize] = VAR_TY_HASH[cl_pi_a as usize]
            cl_pi_a = cl_pi_a + 1
        }
        CL_FNSIG_RET_TY[(CL_DEPTH - 1) as usize] = CURRENT_RET_TY
        CL_FNSIG_RET_HASH[(CL_DEPTH - 1) as usize] = CURRENT_RET_HASH
        var ci_a: i64 = 0
        while ci_a < save_vc_a {
            let ons_a = CL_SAVE_NS[ci_a as usize]
            let one_a = CL_SAVE_NE[ci_a as usize]
            let outer_slot_a = CL_SAVE_SL[ci_a as usize]
            let existing_a = var_find(ons_a, one_a)
            if existing_a < 0 {
                let cap_slot_a = var_add(ons_a, one_a)
                if cap_slot_a >= 0 {
                    let cap_vi_a = VAR_COUNT - 1
                    VAR_LEN_SLOT[cap_vi_a as usize] = CL_SAVE_LS[ci_a as usize]
                    VAR_ALEN[cap_vi_a as usize] = CL_SAVE_AL[ci_a as usize]
                    VAR_ESIZ[cap_vi_a as usize] = CL_SAVE_ES[ci_a as usize]
                    VAR_IS_F64[cap_vi_a as usize] = CL_SAVE_F64[ci_a as usize]
                    VAR_IS_CLOSURE[cap_vi_a as usize] = CL_SAVE_ISCL[ci_a as usize]
                    VAR_MUT[cap_vi_a as usize] = CL_SAVE_MUT[ci_a as usize]
                    VAR_UNIT[cap_vi_a as usize] = CL_SAVE_UNIT[ci_a as usize]
                    VAR_LINEAR[cap_vi_a as usize] = CL_SAVE_LINEAR[ci_a as usize]
                    VAR_USED[cap_vi_a as usize] = CL_SAVE_USED[ci_a as usize]
                    VAR_TY[cap_vi_a as usize] = CL_SAVE_TY[ci_a as usize]
                    VAR_TY_HASH[cap_vi_a as usize] = CL_SAVE_TH[ci_a as usize]
