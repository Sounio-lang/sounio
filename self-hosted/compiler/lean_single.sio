            // leave rax as pointer to the copy (so subsequent SRET calls don't clobber).
            if TK[EP as usize] == 4 {
                let tup_idx = TV[EP as usize]
                EP = EP + 1
                if tup_idx > 1 {
                    tc_error_hard(method_tok, "tuple index out of bounds")
                }
                // True slot counts from the element-type cache. Keys are now unique
                // per element kind, so the cache is reliable. The packed 3-digit decode
                // truncates for elements >= 1000 slots, which mis-routed `.1` of a
                // large-first tuple to the aggregate path (returning a pointer instead
                // of the scalar value) and truncated `.0` copies.
                let tup_first_slots = tup_first_slots_true(EXPR_TY_HASH)
                let tup_total_slots = tup_total_slots_true(EXPR_TY_HASH)
                let tup_last_slots = tup_total_slots - tup_first_slots
                // For a 3+-element tuple, `.1` is element INDEX 1, not "everything
                // after element 0" (tup_last_slots) and not the LAST element (Bug G
                // / issue #601) — recover its own slot count from the full cache
                // row when present. `.2`+ remain rejected above (unchanged scope).
                let fa_ci = tup_cache_lookup(EXPR_TY_HASH)
                var elem1_slots_true: i64 = tup_last_slots
                if fa_ci >= 0 && TUP_CACHE_TCOUNT[fa_ci as usize] > 2 && tup_idx == 1 {
                    let e1s = ty_slot_count(TUP_CACHE_ELEM_TY[(fa_ci * 16 + 1) as usize], TUP_CACHE_ELEM_HASH[(fa_ci * 16 + 1) as usize])
                    if e1s > 0 { elem1_slots_true = e1s }
                }
                let elem_slots = if tup_idx == 0 { tup_first_slots } else { elem1_slots_true }
                if tup_idx == 0 {
                    // rax already points to first element, keep as-is for now
                } else {
                    let byte_offset = tup_first_slots * 8   // .1 offset (collision-safe)
                    if byte_offset > 0 && byte_offset < 2000000000 {
                        em(0x48); em(0x05); em32(byte_offset)  // add rax, offset
                    }
                }
                if elem_slots == 1 {
                    // Scalar element: dereference so rax holds the value. Take the type
                    // from the element cache (keys are now unique per element kind, so
                    // the cache is reliable). NOT from the packed kind digit — for a
                    // first element >= 1000 slots, first_nslots*1000 overflows into that
                    // digit and corrupts it. Cache: 2=f64, 4=bool, else i64. Fall back to
                    // the (unpolluted, small-tuple) digit only on a cache miss.
                    em(0x48); em(0x8b); em(0x00)  // mov rax, [rax]
                    let sc_ci = tup_cache_lookup(EXPR_TY_HASH)
                    if sc_ci >= 0 {
                        // Full element type from the (now collision-free) cache: covers
                        // i64/f64/bool/enum/string/etc. The packed digit can't carry this
                        // and is polluted by first_nslots*1000 overflow for large tuples.
                        if tup_idx == 0 {
                            EXPR_TY = TUP_CACHE_FIRST_TY[sc_ci as usize]
                            EXPR_TY_HASH = TUP_CACHE_FIRST_HASH[sc_ci as usize]
                        } else if TUP_CACHE_TCOUNT[sc_ci as usize] > 2 {
                            EXPR_TY = TUP_CACHE_ELEM_TY[(sc_ci * 16 + 1) as usize]
                            EXPR_TY_HASH = TUP_CACHE_ELEM_HASH[(sc_ci * 16 + 1) as usize]
                        } else {
                            EXPR_TY = TUP_CACHE_LAST_TY[sc_ci as usize]
                            EXPR_TY_HASH = TUP_CACHE_LAST_HASH[sc_ci as usize]
                        }
                        if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                    } else {
                        let elem_kind = if tup_idx == 0 { (EXPR_TY_HASH / 10000000) % 10 } else { (EXPR_TY_HASH / 1000000) % 10 }
                        if elem_kind == 1 { EXPR_IS_F64 = 1; EXPR_TY = 2 } else { EXPR_IS_F64 = 0; EXPR_TY = 1 }
                        EXPR_TY_HASH = 0
                    }
                } else {
                    // Aggregate element: materialize into fresh slots; rax is pointer.
                    EXPR_IS_F64 = 0
                    let tup_ci = tup_cache_lookup(EXPR_TY_HASH)
                    if tup_ci >= 0 {
                        if tup_idx == 0 {
                            EXPR_TY = TUP_CACHE_FIRST_TY[tup_ci as usize]
                            EXPR_TY_HASH = TUP_CACHE_FIRST_HASH[tup_ci as usize]
                        } else if TUP_CACHE_TCOUNT[tup_ci as usize] > 2 {
                            EXPR_TY = TUP_CACHE_ELEM_TY[(tup_ci * 16 + 1) as usize]
                            EXPR_TY_HASH = TUP_CACHE_ELEM_HASH[(tup_ci * 16 + 1) as usize]
                        } else {
                            EXPR_TY = TUP_CACHE_LAST_TY[tup_ci as usize]
                            EXPR_TY_HASH = TUP_CACHE_LAST_HASH[tup_ci as usize]
                        }
                    } else {
                        EXPR_TY = 6
                        if tup_idx == 0 {
                            if tup_first_slots > 0 { EXPR_TY_HASH = 1000000007 + tup_first_slots } else { EXPR_TY_HASH = 0 }
                        } else {
                            if tup_last_slots > 0 { EXPR_TY_HASH = 1000000007 + tup_last_slots } else { EXPR_TY_HASH = 0 }
                        }
                    }
                    var tup_mat_n: i64 = 128
                    if elem_slots > 0 { tup_mat_n = elem_slots }
                    // Recover the TRUE element slot count for the copy size: the packed
                    // elem_slots truncates when the first sibling is >= 1000 slots (e.g.
                    // (Checker, TypeEntry).0 truncated to 12 -> env.count read as garbage).
                    // Collision-safe: a wrong (collided) LAST element is still a 1-slot
                    // scalar here, and the FIRST element type is collision-invariant.
                    if tup_ci >= 0 {
                        let true_mat_n = ty_slot_count(EXPR_TY, EXPR_TY_HASH)
                        if true_mat_n > 0 { tup_mat_n = true_mat_n }
                    }
                    let tup_mat_base = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + tup_mat_n
                    emit_bulk_copy_to_slots_x86(tup_mat_n, tup_mat_base)
                }
                continue
            }
            // Field access: rax = struct pointer, load field
            let base_ty = EXPR_TY
            let base_hash = EXPR_TY_HASH
            var base_data_ty = base_ty
            var base_data_hash = base_hash
            if base_ty == 10 {
                base_data_ty = ref_hash_inner_ty(base_hash)
                base_data_hash = ref_hash_inner_hash(base_hash)
            }
            // `Box<T>` (TY 11) is the same unwrap as `&T` above and was simply
            // never added. Without it type_is_struct_like answered false, the
            // typed path below was skipped, and `x.boxed.field` fell through to
            // the scan that walks EVERY struct looking for that field NAME and
            // takes the first hit. Measured on a witness whose decoy struct
            // declares the same name one slot over: `.a` gave 10 (right, by
            // luck -- only one struct spells it), `.b` gave 30 where 20 was
            // declared, `.c` gave 30 (right again, by luck).
            //
            // No extra dereference is emitted, deliberately: a Box already holds
            // the payload address, which is exactly why the scan could read the
            // right WORD through the wrong STRUCT. Only the layout used to turn a
            // field name into an offset changes.
            if base_ty == 11 && box_hash_is(base_hash) {
                base_data_ty = ref_hash_inner_ty(base_hash)
                base_data_hash = ref_hash_inner_hash(base_hash)
            }
            EP = EP + 1
            var found: i64 = 0
            EXPR_TY = 0
            EXPR_TY_HASH = 0
            if knowledge_hash_is(base_data_hash) {
                if src_match(fns, fne - fns, "value") {
                    // E170: accessing .value on Knowledge<T> requires `with Epistemic`
                    if (FN_EFFECTS[CURRENT_FN as usize] & 512) == 0 {
                        tc_epistemic_value_access(method_tok)
                    }
                    // β⁴/β⁵ covariance: save variance/sensitivity shadow before loading .value
                    // rax = pointer to Knowledge struct: [0]=value [8]=variance [16]=confidence
                    // β⁵: reuse vseed/sseed for the same Knowledge<T> variable so that
                    // left_vshadow == right_vshadow in x.value - x.value → Var=0 at subtraction.
                    var b4_vseed: i64 = -1
                    var b4_sseed: i64 = -1
                    var b4_sseed_1: i64 = -1
                    var b4_sseed_2: i64 = -1
                    var b4_sseed_3: i64 = -1
                    var b4_sseed_4: i64 = -1
                    var b4_sseed_5: i64 = -1
                    var b4_sseed_6: i64 = -1
                    var b4_sseed_7: i64 = -1
                    var km_cached: i64 = 0
                    if LAST_EXPR_VAR_IDX >= 0 {
                        var ci: i64 = 0
                        while ci < KM_CACHE_COUNT {
                            if KM_CACHE_VI[ci as usize] == LAST_EXPR_VAR_IDX {
                                b4_vseed = KM_CACHE_VS[ci as usize]
                                b4_sseed = KM_CACHE_SS[ci as usize]
                                b4_sseed_1 = KM_CACHE_SS_1[ci as usize]
                                b4_sseed_2 = KM_CACHE_SS_2[ci as usize]
                                b4_sseed_3 = KM_CACHE_SS_3[ci as usize]
                                b4_sseed_4 = KM_CACHE_SS4[ci as usize]
                                b4_sseed_5 = KM_CACHE_SS_5[ci as usize]
                                b4_sseed_6 = KM_CACHE_SS_6[ci as usize]
                                b4_sseed_7 = KM_CACHE_SS_7[ci as usize]
                                km_cached = 1
                                ci = KM_CACHE_COUNT
                            }
                            ci = ci + 1
                        }
                    }
                    if km_cached == 1 {
                        // Reuse existing slots: just load .value; shadow slots already populated.
                        em(0x48); em(0x8b); em(0x00)          // mov rax, [rax]   (.value)
                    } else {
                        em(0x50)                               // push rax (save ptr)
                        em(0x48); em(0x8b); em(0x40); em(8)   // mov rax, [rax+8]  (variance)
                        b4_vseed = NEXT_SLOT
                        NEXT_SLOT = NEXT_SLOT + 1
                        emit_store_var(b4_vseed)               // store variance shadow
                        // β¹⁰: bind this Knowledge's σ² to its FO channel index
                        if MEAS_KNOW_IDX >= 0 && MEAS_KNOW_IDX < 8 {
                            CHANNEL_INPUT_VAR_SLOT[MEAS_KNOW_IDX as usize] = b4_vseed
                        }
                        em(0x58)                               // pop rax (restore ptr)
                        em(0x48); em(0x8b); em(0x00)          // mov rax, [rax]   (.value)
                        // Save .value before sensitivity seed (emit_imm64 overwrites rax)
                        let b4_valsave = NEXT_SLOT
                        NEXT_SLOT = NEXT_SLOT + 1
                        emit_store_var(b4_valsave)
                        // Sensitivity seeds ch0-ch7: 1.0 for the matching Knowledge access, else 0.0
                        b4_sseed = NEXT_SLOT
                        NEXT_SLOT = NEXT_SLOT + 1
                        if MEAS_KNOW_IDX == 0 { emit_imm64(4607182418800017408) } else { emit_imm64(0) }
                        emit_store_var(b4_sseed)
                        b4_sseed_1 = NEXT_SLOT
                        NEXT_SLOT = NEXT_SLOT + 1
                        if MEAS_KNOW_IDX == 1 { emit_imm64(4607182418800017408) } else { emit_imm64(0) }
                        emit_store_var(b4_sseed_1)
                        b4_sseed_2 = NEXT_SLOT
                        NEXT_SLOT = NEXT_SLOT + 1
                        if MEAS_KNOW_IDX == 2 { emit_imm64(4607182418800017408) } else { emit_imm64(0) }
                        emit_store_var(b4_sseed_2)
                        b4_sseed_3 = NEXT_SLOT
                        NEXT_SLOT = NEXT_SLOT + 1
                        if MEAS_KNOW_IDX == 3 { emit_imm64(4607182418800017408) } else { emit_imm64(0) }
                        emit_store_var(b4_sseed_3)
                        b4_sseed_4 = NEXT_SLOT
                        NEXT_SLOT = NEXT_SLOT + 1
                        if MEAS_KNOW_IDX == 4 { emit_imm64(4607182418800017408) } else { emit_imm64(0) }
                        emit_store_var(b4_sseed_4)
                        b4_sseed_5 = NEXT_SLOT
                        NEXT_SLOT = NEXT_SLOT + 1
                        if MEAS_KNOW_IDX == 5 { emit_imm64(4607182418800017408) } else { emit_imm64(0) }
                        emit_store_var(b4_sseed_5)
                        b4_sseed_6 = NEXT_SLOT
                        NEXT_SLOT = NEXT_SLOT + 1
                        if MEAS_KNOW_IDX == 6 { emit_imm64(4607182418800017408) } else { emit_imm64(0) }
                        emit_store_var(b4_sseed_6)
                        b4_sseed_7 = NEXT_SLOT
                        NEXT_SLOT = NEXT_SLOT + 1
                        if MEAS_KNOW_IDX == 7 { emit_imm64(4607182418800017408) } else { emit_imm64(0) }
                        emit_store_var(b4_sseed_7)
                        MEAS_KNOW_IDX = MEAS_KNOW_IDX + 1
                        // Restore .value (emit_imm64 overwrote rax)
                        emit_load_var(b4_valsave)
                        // Register in cache for future reuse
                        if LAST_EXPR_VAR_IDX >= 0 && KM_CACHE_COUNT < 32 {
                            KM_CACHE_VI[KM_CACHE_COUNT as usize] = LAST_EXPR_VAR_IDX
                            KM_CACHE_VS[KM_CACHE_COUNT as usize] = b4_vseed
                            KM_CACHE_SS[KM_CACHE_COUNT as usize] = b4_sseed
                            KM_CACHE_SS_1[KM_CACHE_COUNT as usize] = b4_sseed_1
                            KM_CACHE_SS_2[KM_CACHE_COUNT as usize] = b4_sseed_2
                            KM_CACHE_SS_3[KM_CACHE_COUNT as usize] = b4_sseed_3
                            KM_CACHE_SS4[KM_CACHE_COUNT as usize] = b4_sseed_4
                            KM_CACHE_SS_5[KM_CACHE_COUNT as usize] = b4_sseed_5
                            KM_CACHE_SS_6[KM_CACHE_COUNT as usize] = b4_sseed_6
                            KM_CACHE_SS_7[KM_CACHE_COUNT as usize] = b4_sseed_7
                            KM_CACHE_COUNT = KM_CACHE_COUNT + 1
                        }
                    }
                    EXPR_VSHADOW = b4_vseed
                    EXPR_SSHADOW = b4_sseed
                    EXPR_SSHADOW_1 = b4_sseed_1
                    EXPR_SSHADOW_2 = b4_sseed_2
                    EXPR_SSHADOW_3 = b4_sseed_3
                    EXPR_SSHADOW_4 = b4_sseed_4
                    EXPR_SSHADOW_5 = b4_sseed_5
                    EXPR_SSHADOW_6 = b4_sseed_6
                    EXPR_SSHADOW_7 = b4_sseed_7
                    // GTT: this .value access seeds channel (MEAS_KNOW_IDX - 1),
                    // since MEAS_KNOW_IDX was just incremented above.  The topology
                    // of the resulting scalar is the singleton {just-seeded channel}.
                    // β⁹ week-4: EXPR_PARAM_USED intentionally preserved from the
                    // base variable load — the scalar still depends on the same
                    // caller parameter whose Knowledge<T> we just extracted.
                    EXPR_CH_SET = 1 << (MEAS_KNOW_IDX - 1)
                    EXPR_TY = knowledge_hash_inner_ty(base_data_hash)
                    EXPR_TY_HASH = knowledge_hash_inner_hash(base_data_hash)
                    if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                } else if src_match(fns, fne - fns, "variance") {
                    em(0x48); em(0x8b); em(0x40); em(8)
                    EXPR_TY = 2
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 1
                } else if src_match(fns, fne - fns, "uncertainty") {
                    em(0x48); em(0x8b); em(0x40); em(8)
                    emit_sqrt_builtin_x86()
                    EXPR_TY = 2
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 1
                } else if src_match(fns, fne - fns, "confidence") || src_match(fns, fne - fns, "epsilon") {
                    em(0x48); em(0x8b); em(0x40); em(16)
                    EXPR_TY = 2
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 1
                } else {
                    tc_error_hard(method_tok, "unknown field access")
                    em(0x31); em(0xc0)
                    EXPR_IS_F64 = 0
                }
                found = 1
            }
            if type_is_struct_like(base_data_ty, base_data_hash) {
                let bsi = st_find(base_data_hash)
                if bsi >= 0 {
                    if st_private_access_denied(bsi, method_tok) {
                        tc_error_hard(method_tok, "private struct field access")
                        em(0x31); em(0xc0)
                    } else {
                        ST_QUERY_NS = fns
                        ST_QUERY_NE = fne
                        let off = st_field_offset(bsi, fh)
                        if off >= 0 {
                            EXPR_TY = st_field_ty(bsi, fh)
                            EXPR_TY_HASH = st_field_hash(bsi, fh)
                        ST_QUERY_NS = -1
                        ST_QUERY_NE = -1
                            if EXPR_TY == 12 {
                                em(0x50)
                                if off != 0 { em(0x48); em(0x8d); em(0x80); em32(off) }
                                let seq_place = NEXT_SLOT
                                NEXT_SLOT = NEXT_SLOT + 1
                                emit_store_var(seq_place)
                                SEQ_RECV_PLACE_SLOT = seq_place
                                em(0x58)
                            }
                            if EXPR_TY == 8 || type_is_struct_like(EXPR_TY, EXPR_TY_HASH) || type_is_option_inline(EXPR_TY, EXPR_TY_HASH) || knowledge_hash_is(EXPR_TY_HASH) {
                                if off != 0 { em(0x48); em(0x8d); em(0x80); em32(off) }
                            } else {
                                if off == 0 {
                                    em(0x48); em(0x8b); em(0x00)
                                } else {
                                    em(0x48); em(0x8b); em(0x80); em32(off)
                                }
                            }
                            if EXPR_TY == 8 { LAST_ALEN = arr_hash_alen(EXPR_TY_HASH) }
                        } else {
                            tc_error_hard(method_tok, "unknown field access")
                            em(0x31); em(0xc0)
                        }
                        ST_QUERY_NS = -1
                        ST_QUERY_NE = -1
                    }
                    found = 1
                }
            }
            var si: i64 = 0
            while si < ST_COUNT && found == 0 {
                ST_QUERY_NS = fns
                ST_QUERY_NE = fne
                let off = st_field_offset(si, fh)
                if off >= 0 {
                    if st_private_access_denied(si, method_tok) {
                        ST_QUERY_NS = -1
                        ST_QUERY_NE = -1
                        tc_error_hard(method_tok, "private struct field access")
                        em(0x31); em(0xc0)
                    } else {
                        EXPR_TY = st_field_ty(si, fh)
                        EXPR_TY_HASH = st_field_hash(si, fh)
                    ST_QUERY_NS = -1
                    ST_QUERY_NE = -1
                        if EXPR_TY == 12 {
                            em(0x50)
                            if off != 0 { em(0x48); em(0x8d); em(0x80); em32(off) }
                            let seq_place = NEXT_SLOT
                            NEXT_SLOT = NEXT_SLOT + 1
                            emit_store_var(seq_place)
                            SEQ_RECV_PLACE_SLOT = seq_place
                            em(0x58)
                        }
                        if EXPR_TY == 8 || type_is_struct_like(EXPR_TY, EXPR_TY_HASH) || type_is_option_inline(EXPR_TY, EXPR_TY_HASH) || knowledge_hash_is(EXPR_TY_HASH) {
                            if off != 0 { em(0x48); em(0x8d); em(0x80); em32(off) }
                        } else {
                            if off == 0 {
                                em(0x48); em(0x8b); em(0x00)
                            } else {
                                em(0x48); em(0x8b); em(0x80); em32(off)
                            }
                        }
                        if EXPR_TY == 8 { LAST_ALEN = arr_hash_alen(EXPR_TY_HASH) }
                    }
                    found = 1
                }
                si = si + 1
            }
            if found == 0 {
                if TK[EP as usize] == 6 {
                    tc_error_hard(method_tok, "unknown method")
                } else {
                    tc_error_hard(method_tok, "unknown field access")
                }
                em(0x31); em(0xc0)
            }
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
            continue
        }
        more = 0
    }
}

fn compile_multiplicative() with IO, Mut, Panic, Div {
    compile_postfix()
    var lhs_end_line: i64 = TL[(EP - 1) as usize]
    while TK[EP as usize] == 19 || TK[EP as usize] == 20 || TK[EP as usize] == 29 {
        // A `*` that starts a new line is a new statement's dereference-assignment
        // prefix (Sounio has no semicolons; one statement per line is idiomatic),
        // not a continued multiplication of the previous line's expression — no
        // codebase style continues `*`/`/`/`%` onto a following line. Previously
        // this only guarded EXPR_TY == 11 (raw pointer), so any other expression
        // type followed by a line-leading `*` (e.g. `noop()\n*n = 999`) was
        // silently absorbed as `noop() * n`, producing a spurious "arithmetic
        // operands must have matching numeric types" on the manufactured
        // multiplication instead of compiling `*n = 999` as its own statement.
        if TK[EP as usize] == 19 && TL[EP as usize] > lhs_end_line { return }
        let op_tok = EP
        let op = TK[EP as usize]
        EP = EP + 1
        let rhs_start = EP
        var rhs_const_known: i64 = 0
        var rhs_const_val: i64 = 0
        if TK[rhs_start as usize] == 4 {
            rhs_const_known = 1
            rhs_const_val = TV[rhs_start as usize]
        }
        if TK[rhs_start as usize] == 6 && TK[(rhs_start + 1) as usize] == 4 && TK[(rhs_start + 2) as usize] == 18 && TK[(rhs_start + 3) as usize] == 4 {
            rhs_const_known = 1
            rhs_const_val = TV[(rhs_start + 1) as usize] - TV[(rhs_start + 3) as usize]
        }
        let left_f64 = EXPR_IS_F64
        let left_ty = EXPR_TY
        let left_hash = EXPR_TY_HASH
        // Gen 19: capture unit dim before push (EXPR_UNIT_DIM is global, will be overwritten)
        let left_udim = EXPR_UNIT_DIM
        // β⁴: capture LHS shadow slots and save LHS value for GUM/AD propagation
        let left_vshadow = EXPR_VSHADOW
        let left_sshadow = EXPR_SSHADOW
        let left_sshadow_1 = EXPR_SSHADOW_1
        let left_sshadow_2 = EXPR_SSHADOW_2
        let left_sshadow_3 = EXPR_SSHADOW_3
        let left_sshadow_4 = EXPR_SSHADOW_4
        let left_sshadow_5 = EXPR_SSHADOW_5
        let left_sshadow_6 = EXPR_SSHADOW_6
        let left_sshadow_7 = EXPR_SSHADOW_7
        // GTT: capture LHS channel topology before right operand compiles (which resets EXPR_CH_SET).
        let left_ch_set = EXPR_CH_SET
        let left_param_used = EXPR_PARAM_USED
        let left_hsh_00 = EXPR_HSHADOW_00; let left_hsh_01 = EXPR_HSHADOW_01
        let left_hsh_02 = EXPR_HSHADOW_02; let left_hsh_03 = EXPR_HSHADOW_03
        let left_hsh_11 = EXPR_HSHADOW_11; let left_hsh_12 = EXPR_HSHADOW_12
        let left_hsh_13 = EXPR_HSHADOW_13; let left_hsh_22 = EXPR_HSHADOW_22
        let left_hsh_23 = EXPR_HSHADOW_23; let left_hsh_33 = EXPR_HSHADOW_33
        let left_hsh_04 = EXPR_HSHADOW_04; let left_hsh_05 = EXPR_HSHADOW_05
        let left_hsh_06 = EXPR_HSHADOW_06; let left_hsh_07 = EXPR_HSHADOW_07
        let left_hsh_14 = EXPR_HSHADOW_14; let left_hsh_15 = EXPR_HSHADOW_15
        let left_hsh_16 = EXPR_HSHADOW_16; let left_hsh_17 = EXPR_HSHADOW_17
        let left_hsh_24 = EXPR_HSHADOW_24; let left_hsh_25 = EXPR_HSHADOW_25
        let left_hsh_26 = EXPR_HSHADOW_26; let left_hsh_27 = EXPR_HSHADOW_27
