    em(0xe9); let argc2_done = CL; em32(0)
    let argc3_target = CL
    emit_task_push_marshaled_args_x86(3)
    em(0x48); em(0x8b); em(0x43); em(task_rec_entry_off_x86())
    emit_call_rax_x86(3)
