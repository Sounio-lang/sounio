            if TK[EP as usize] == 9 { EP = EP + 1 }
        } else {
            compile_or_a64()
        }
        var needs_cl_ep_a: i64 = 1
        if CL >= 4 { if rd32_at(CL - 4) == 0xD65F03C0 { needs_cl_ep_a = 0 } }
        if needs_cl_ep_a == 1 {
            if CURRENT_RET_TY == 5 { em32(0xD2800000) }
            else if LAST_STMT_HAS_VALUE == 0 && CURRENT_RET_TY != 0 { em32(0xD2800000) }
