                em32(0xAA0003EA)
                emit_load_var_a64(heap_slot_a)
                em32(0xAA0003E9)
                em32(0xF9000000 | ((capj_a + 1) << 10) | (9 << 5) | 10)
                capj_a = capj_a + 1
