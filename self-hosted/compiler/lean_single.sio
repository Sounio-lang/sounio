    em(0xdd); em(0x44); em(0x24); em(8)
    em(0xd9); em(0xea)
    em(0xde); em(0xc9)
    em(0xd9); em(0xc0)
    em(0xd9); em(0xfc)
    em(0xd9); em(0xc9)
    em(0xd8); em(0xe1)
    em(0xd9); em(0xf0)
    em(0xd9); em(0xe8)
    em(0xde); em(0xc1)
