    patch32(argc5, argc5_target)
    patch32(argc6, argc6_target)
    patch32(argc0_done, call_done_target)
    patch32(argc1_done, call_done_target)
    patch32(argc2_done, call_done_target)
    patch32(argc3_done, call_done_target)
    patch32(argc4_done, call_done_target)
    patch32(argc5_done, call_done_target)
}

fn emit_async_run_task_from_rax_x86() with Mut, Panic, Div {
    em(0x48); em(0x89); em(0xc3)
    emit_store_imm64_to_rbx_disp_x86(task_rec_state_off_x86(), task_state_running_x86())
    // Keep the worker stack 16-byte aligned across task calls.
    em(0x48); em(0x83); em(0xec); em(16)
    em(0x48); em(0x89); em(0x5c); em(0x24); em(8)
    emit_async_worker_dispatch_x86()
    em(0x48); em(0x8b); em(0x5c); em(0x24); em(8)
    em(0x48); em(0x83); em(0xc4); em(16)
    emit_store_rax_to_rbx_disp_x86(task_rec_result_off_x86())
    emit_store_imm64_to_rbx_disp_x86(task_rec_state_off_x86(), task_state_done_x86())
    em(0x48); em(0x8d); em(0x7b); em(task_rec_state_off_x86())
    em(0xbe); em32(1)
    em(0xba); em32(1)
    em(0x45); em(0x31); em(0xd2)
    em(0x45); em(0x31); em(0xc0)
    em(0x45); em(0x31); em(0xc9)
    em(0xb8); em32(202)
    em(0x0f); em(0x05)
}

fn emit_async_run_task_inline_x86() with Mut, Panic, Div {
    em(0x53)
    em(0x48); em(0x89); em(0xc3)
    emit_store_imm64_to_rbx_disp_x86(task_rec_state_off_x86(), task_state_running_x86())
    em(0x48); em(0x83); em(0xec); em(16)
    em(0x48); em(0x89); em(0x5c); em(0x24); em(8)
    emit_async_worker_dispatch_x86()
    em(0x48); em(0x8b); em(0x5c); em(0x24); em(8)
    em(0x48); em(0x83); em(0xc4); em(16)
    emit_store_rax_to_rbx_disp_x86(task_rec_result_off_x86())
    emit_store_imm64_to_rbx_disp_x86(task_rec_state_off_x86(), task_state_done_x86())
    em(0x5b)
}

fn emit_async_worker_entry_x86(worker_entry_off: i64) with Mut, Panic, Div {
    let worker_loop = CL
    emit_async_dequeue_task_x86()
    emit_task_try_claim_queued_x86()
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let worker_retry = CL; em32(0)
    em(0x48); em(0x89); em(0xd8)
    emit_async_run_task_from_rax_x86()
    em(0xe9); em32(worker_loop - (CL + 4))
    let worker_retry_target = CL
    patch32(worker_retry, worker_retry_target)
    em(0xe9); em32(worker_loop - (CL + 4))
}

fn emit_async_runtime_ensure_x86() with Mut, Panic, Div {
    em(0xe9); let worker_entry_skip = CL; em32(0)
    let worker_entry_off = CL
    emit_async_worker_entry_x86(worker_entry_off)
    let worker_entry_skip_target = CL
    patch32(worker_entry_skip, worker_entry_skip_target)
    emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + ASYNC_RT_INIT_BSS_OFF)
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x85); let rt_done = CL; em32(0)
    emit_abs_lock_acquire_x86(GL_BSS_BASE + ASYNC_RT_INIT_LOCK_BSS_OFF)
    emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + ASYNC_RT_INIT_BSS_OFF)
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x85); let already_init = CL; em32(0)
    emit_store_imm64_to_abs_qword_x86(GL_BSS_BASE + ASYNC_RT_WORKER_COUNT_BSS_OFF, async_rt_worker_count_x86())
    em(0xb8); em32(186)
    em(0x0f); em(0x05)
    emit_store_rax_to_abs_qword_x86(GL_BSS_BASE + ASYNC_RT_MAIN_TID_BSS_OFF)
    var wi: i64 = 0
    while wi < async_rt_worker_count_x86() {
        emit_async_spawn_worker_x86(worker_entry_off)
        wi = wi + 1
    }
    emit_store_imm64_to_abs_qword_x86(GL_BSS_BASE + ASYNC_RT_INIT_BSS_OFF, 1)
    let already_init_target = CL
    patch32(already_init, already_init_target)
    emit_abs_lock_release_x86(GL_BSS_BASE + ASYNC_RT_INIT_LOCK_BSS_OFF)
    let rt_done_target = CL
    patch32(rt_done, rt_done_target)
}

fn emit_task_await_x86() with Mut, Panic, Div {
    let task_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    let yield_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var(task_slot)
    emit_imm64(1024)
    emit_store_var(yield_slot)
    let wait_loop = CL
    emit_load_var(task_slot)
    em(0x48); em(0x89); em(0xc3)
    em(0x48); em(0x8b); em(0x4b); em(task_rec_state_off_x86())
    em(0x48); em(0x83); em(0xf9); em(task_state_done_x86())
    em(0x0f); em(0x8d); let wait_done = CL; em32(0)
    emit_load_var(task_slot)
    em(0x48); em(0x89); em(0xc3)
    em(0x48); em(0x8b); em(0x4b); em(task_rec_spawned_off_x86())
    em(0x48); em(0x85); em(0xc9)
    em(0x0f); em(0x84); let wait_try_claim = CL; em32(0)
    emit_load_var(yield_slot)
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let wait_try_claim_after_yield = CL; em32(0)
    em(0x48); em(0xff); em(0xc8)
    emit_store_var(yield_slot)
    em(0xb8); em32(24)
    em(0x0f); em(0x05)
    em(0xe9); em32(wait_loop - (CL + 4))
    let wait_try_claim_target = CL
    patch32(wait_try_claim, wait_try_claim_target)
    let wait_try_claim_after_yield_target = CL
    patch32(wait_try_claim_after_yield, wait_try_claim_after_yield_target)
    emit_load_var(task_slot)
    emit_task_try_claim_queued_x86()
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let wait_sleep = CL; em32(0)
    emit_load_var(task_slot)
    emit_async_run_task_from_rax_x86()
    em(0xe9); em32(wait_loop - (CL + 4))
    let wait_sleep_target = CL
    patch32(wait_sleep, wait_sleep_target)
    emit_load_var(task_slot)
    em(0x48); em(0x89); em(0xc3)
    em(0x48); em(0x8b); em(0x4b); em(task_rec_state_off_x86())
    em(0x48); em(0x83); em(0xf9); em(task_state_done_x86())
    em(0x0f); em(0x8d); let wait_done_after_reload = CL; em32(0)
    em(0x48); em(0x8d); em(0x7b); em(task_rec_state_off_x86())
    em(0x89); em(0xca)
    em(0xbe); em32(0)
    em(0x45); em(0x31); em(0xd2)
    em(0x45); em(0x31); em(0xc0)
    em(0x45); em(0x31); em(0xc9)
    em(0xb8); em32(202)
    em(0x0f); em(0x05)
    em(0xe9); em32(wait_loop - (CL + 4))
    let wait_done_target = CL
    patch32(wait_done, wait_done_target)
    patch32(wait_done_after_reload, wait_done_target)
    emit_load_var(task_slot)
    em(0x48); em(0x89); em(0xc3)
    em(0x48); em(0x8b); em(0x43); em(task_rec_result_off_x86())
}

fn emit_store_async_entry_ptr_patch_x86(fi: i64) with Mut {
    em(0x48); em(0xb8)
    PATCH_OFF[PATCH_COUNT as usize] = CL
    PATCH_FN[PATCH_COUNT as usize] = fi
    PATCH_KIND[PATCH_COUNT as usize] = 3
    PATCH_COUNT = PATCH_COUNT + 1
    em64(0)
}

fn emit_async_direct_fn_call_x86(fi: i64, argc: i64) with Mut, Panic, Div {
    emit_task_alloc_runtime_x86()
    let task_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var(task_slot)
    emit_load_var(task_slot)
    em(0x48); em(0x89); em(0xc3)
    emit_store_imm64_to_rbx_disp_x86(task_rec_argc_off_x86(), argc)
    emit_store_async_entry_ptr_patch_x86(fi)
    emit_store_rax_to_rbx_disp_x86(task_rec_entry_off_x86())
    emit_task_copy_call_args_to_record_x86(argc)
    emit_drop_call_args_x86(argc)
    emit_load_var(task_slot)
}

fn emit_async_launch_task_thread_x86() with Mut, Panic, Div {
    em(0x48); em(0x89); em(0xc3)
