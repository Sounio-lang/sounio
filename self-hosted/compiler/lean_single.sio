    em(0x0f); em(0x05)
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x88); let clone_fail = CL; em32(0)
    em(0x0f); em(0x85); let clone_parent = CL; em32(0)
    em(0x48); em(0x89); em(0xd8)
    emit_async_run_task_from_rax_x86()
    emit_task_exit_x86(0)
    let clone_parent_target = CL
    em(0x48); em(0x89); em(0xd8)
    em(0xe9); let clone_after = CL; em32(0)
    let clone_fail_target = CL
    let clone_after_target = CL
    patch32(clone_parent, clone_parent_target)
    patch32(clone_fail, clone_fail_target)
    patch32(clone_after, clone_after_target)
}

fn compile_async_inline_block_x86(tok: i64) with IO, Mut, Panic, Div {
    let is_spawn = TK[tok as usize] == 78
    var spawn_flag: i64 = 0
    if is_spawn != 0 { spawn_flag = 1 }
    if (FN_EFFECTS[CURRENT_FN as usize] & 32) == 0 { tc_effect_violation(tok, 32, FN_EFFECTS[CURRENT_FN as usize]) }
    EP = EP + 1
    let save_vc = VAR_COUNT
    let save_ns2 = NEXT_SLOT
    let save_ld = LOOP_DEPTH
    let save_bc = BREAK_COUNT
    let save_ret_ty = CURRENT_RET_TY
    let save_ret_hash = CURRENT_RET_HASH
    let save_sret_slot = CURRENT_SRET_SLOT
    var svi: i64 = 0
    while svi < save_vc {
        CL_SAVE_NS[svi as usize] = VAR_NS[svi as usize]
        CL_SAVE_NE[svi as usize] = VAR_NE[svi as usize]
        CL_SAVE_SL[svi as usize] = VAR_SLOT[svi as usize]
        CL_SAVE_LS[svi as usize] = VAR_LEN_SLOT[svi as usize]
        CL_SAVE_AL[svi as usize] = VAR_ALEN[svi as usize]
        CL_SAVE_ES[svi as usize] = VAR_ESIZ[svi as usize]
        CL_SAVE_F64[svi as usize] = VAR_IS_F64[svi as usize]
        CL_SAVE_ISCL[svi as usize] = VAR_IS_CLOSURE[svi as usize]
        CL_SAVE_MUT[svi as usize] = VAR_MUT[svi as usize]
        CL_SAVE_UNIT[svi as usize] = VAR_UNIT[svi as usize]
        CL_SAVE_LINEAR[svi as usize] = VAR_LINEAR[svi as usize]
        CL_SAVE_USED[svi as usize] = VAR_USED[svi as usize]
        CL_SAVE_TY[svi as usize] = VAR_TY[svi as usize]
        CL_SAVE_TH[svi as usize] = VAR_TY_HASH[svi as usize]
        svi = svi + 1
    }
    VAR_COUNT = 0
    NEXT_SLOT = 1
    LOOP_DEPTH = 0
    BREAK_COUNT = 0
    CURRENT_RET_TY = 0
    CURRENT_RET_HASH = 0
    CURRENT_SRET_SLOT = -1
    em(0xe9); let thunk_skip = CL; em32(0)
    let thunk_off = CL
    em(0x55)
    em(0x48); em(0x89); em(0xe5)
    let save_fpc = FRAME_PATCH_COUNT
    em(0x48); em(0x81); em(0xec); record_frame_patch(); em32(0)
    compile_inline_block_expr_x86()
    if type_is_aggregate(EXPR_TY, EXPR_TY_HASH) {
        tc_error(tok, "async aggregate results not yet supported")
        em(0x31); em(0xc0)
    }
    em(0x48); em(0x81); em(0xc4); record_frame_patch(); em32(0)
    em(0x5d); em(0xc3)
    let thunk_frame_sz = (NEXT_SLOT * 8 + 15) & 0xFFFFFFF0
    if thunk_frame_sz > max_frame_bytes() { tc_stack_frame_too_large(thunk_frame_sz) }
    var thunk_fpi: i64 = save_fpc
    while thunk_fpi < FRAME_PATCH_COUNT {
        em32_at(FRAME_PATCH_OFF[thunk_fpi as usize], thunk_frame_sz)
        thunk_fpi = thunk_fpi + 1
    }
    VAR_COUNT = save_vc
    NEXT_SLOT = save_ns2
    LOOP_DEPTH = save_ld
    BREAK_COUNT = save_bc
    CURRENT_RET_TY = save_ret_ty
    CURRENT_RET_HASH = save_ret_hash
    CURRENT_SRET_SLOT = save_sret_slot
    FRAME_PATCH_COUNT = save_fpc
    svi = 0
    while svi < save_vc {
        VAR_NS[svi as usize] = CL_SAVE_NS[svi as usize]
        VAR_NE[svi as usize] = CL_SAVE_NE[svi as usize]
        VAR_SLOT[svi as usize] = CL_SAVE_SL[svi as usize]
        VAR_LEN_SLOT[svi as usize] = CL_SAVE_LS[svi as usize]
        VAR_ALEN[svi as usize] = CL_SAVE_AL[svi as usize]
        VAR_ESIZ[svi as usize] = CL_SAVE_ES[svi as usize]
        VAR_IS_F64[svi as usize] = CL_SAVE_F64[svi as usize]
        VAR_IS_CLOSURE[svi as usize] = CL_SAVE_ISCL[svi as usize]
        VAR_MUT[svi as usize] = CL_SAVE_MUT[svi as usize]
        VAR_UNIT[svi as usize] = CL_SAVE_UNIT[svi as usize]
        VAR_LINEAR[svi as usize] = CL_SAVE_LINEAR[svi as usize]
        VAR_USED[svi as usize] = CL_SAVE_USED[svi as usize]
        VAR_TY[svi as usize] = CL_SAVE_TY[svi as usize]
        VAR_TY_HASH[svi as usize] = CL_SAVE_TH[svi as usize]
        svi = svi + 1
    }
    let thunk_skip_target = CL
    patch32(thunk_skip, thunk_skip_target)
    emit_task_alloc_runtime_x86()
    let task_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var(task_slot)
    emit_load_var(task_slot)
    em(0x48); em(0x89); em(0xc3)
    emit_store_imm64_to_rbx_disp_x86(task_rec_argc_off_x86(), 0)
    emit_imm64(async_rt_text_base_x86() + thunk_off)
    emit_store_rax_to_rbx_disp_x86(task_rec_entry_off_x86())
    emit_store_imm64_to_rbx_disp_x86(task_rec_spawned_off_x86(), spawn_flag)
    emit_load_var(task_slot)
    if is_spawn != 0 {
        emit_async_launch_task_thread_x86()
    }
    EXPR_TY_HASH = task_hash_make(EXPR_TY, EXPR_TY_HASH)
    EXPR_TY = 13
    EXPR_IS_F64 = 0
}

fn emit_write_file_flags(open_flags: i64) with Mut, Panic {
    // rdi = path, rsi = buf addr, rdx = len
    em(0x52)  // push rdx (len)
    em(0x56)  // push rsi (buf)
    em(0xbe); em32(open_flags)
    em(0xba); em32(0x1A4)  // mov edx, 0644
    em(0xb8); em32(2)  // mov eax, 2 (sys_open)
    em(0x0f); em(0x05)  // → fd in rax
    em(0x48); em(0x85); em(0xc0)  // test rax, rax
    em(0x0f); em(0x89); let open_ok = CL; em32(0)  // jns open_ok
    em(0x48); em(0x83); em(0xc4); em(0x10)  // add rsp, 16
    em(0xe9); let done = CL; em32(0)
    let open_ok_target = CL
    em(0x49); em(0x89); em(0xc0)  // mov r8, rax (fd)
    em(0x5e)  // pop rsi (buf)
    em(0x5a)  // pop rdx (len)
    em(0x4c); em(0x89); em(0xc7)  // mov rdi, r8
    em(0xb8); em32(1)  // mov eax, 1 (sys_write)
    em(0x0f); em(0x05)
    em(0x49); em(0x89); em(0xc1)  // mov r9, rax (write result)
    // close(fd)
    em(0x4c); em(0x89); em(0xc7)  // mov rdi, r8
    em(0xb8); em32(3)  // mov eax, 3 (sys_close)
    em(0x0f); em(0x05)
    em(0x4c); em(0x89); em(0xc8)  // mov rax, r9
    let done_target = CL
    patch32(open_ok, open_ok_target)
    patch32(done, done_target)
}

fn emit_write_file() with Mut, Panic {
    emit_write_file_flags(0x241)
}

fn emit_append_file() with Mut, Panic {
    emit_write_file_flags(0x441)
}

// ─── Expression compiler (recursive descent) ───
// Global parse position for expression parsing
var EP: i64 = 0
var EXPR_IS_F64: i64 = 0
var EXPR_TY: i64 = 0
var EXPR_TY_HASH: i64 = 0
var LAST_ALEN: i64 = 0
var LAST_STMT_TY: i64 = 0
var LAST_STMT_TY_HASH: i64 = 0
var CURRENT_RET_TY: i64 = 0
var CURRENT_RET_HASH: i64 = 0
var CURRENT_SRET_SLOT: i64 = 0
// Closure state save buffers (global to avoid stack overflow in recursive compile_primary)
var CL_SAVE_NS: [i64; 1024] = [0; 1024]
var CL_SAVE_NE: [i64; 1024] = [0; 1024]
var CL_SAVE_SL: [i64; 1024] = [0; 1024]
var CL_SAVE_LS: [i64; 1024] = [0; 1024]
var CL_SAVE_AL: [i64; 1024] = [0; 1024]
var CL_SAVE_ES: [i64; 1024] = [0; 1024]
var CL_SAVE_F64: [i64; 1024] = [0; 1024]
var CL_SAVE_ISCL: [i64; 1024] = [0; 1024]
var CL_SAVE_MUT: [i64; 1024] = [0; 1024]
var CL_SAVE_UNIT: [i64; 1024] = [0; 1024]
var CL_SAVE_LINEAR: [i64; 1024] = [0; 1024]
var CL_SAVE_USED: [i64; 1024] = [0; 1024]
var CL_SAVE_TY: [i64; 1024] = [0; 1024]
var CL_SAVE_TH: [i64; 1024] = [0; 1024]
// Capture tracking for closures
var CL_CAP_SLOT: [i64; 1024] = [0; 1024]
var CL_CAP_COUNT: i64 = 0
// Loop stack for continue/break (max 16 nested loops)
var LOOP_TOP: [i64; 16] = [0; 16]
var LOOP_END_PATCH: [i64; 16] = [0; 16]
var LOOP_DEPTH: i64 = 0
// Break fixup table: code offsets of jmp rel32 placeholders
var BREAK_PATCH: [i64; 64] = [0; 64]
var BREAK_COUNT: i64 = 0
// Track if last struct literal was a linear/affine type
var LAST_EXPR_IS_LINEAR: i64 = 0
var LAST_EXPR_IS_AFFINE: i64 = 0
// Track VAR index of last struct identifier loaded (-1 if not applicable)
var LAST_EXPR_VAR_IDX: i64 = -1
// Scratch local-slot ids for string builtins inside large expression compilers.
var BUILTIN_SLOT_A: i64 = 0
var BUILTIN_SLOT_B: i64 = 0
var BUILTIN_SLOT_C: i64 = 0

fn compile_measure_call_x86(call_tok: i64) with IO, Mut, Panic, Div {
    EP = EP + 1
    var value_ty: i64 = 0
    var value_hash: i64 = 0
    var value_tok: i64 = -1
    var unc_ty: i64 = 0
    var unc_tok: i64 = -1
    var conf_ty: i64 = 0
    var value_slot: i64 = -1
    var unc_slot: i64 = -1
    var conf_slot: i64 = -1
    var argc: i64 = 0
    var saw_unc: i64 = 0
    var saw_conf: i64 = 0
    if TK[EP as usize] != 7 && TK[EP as usize] != 0 {
        let arg_start = EP
        compile_or()
        value_ty = EXPR_TY
        value_hash = EXPR_TY_HASH
        value_tok = expr_simple_numeric_tok(arg_start, EP)
        value_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        emit_store_var(value_slot)
        argc = 1
    }
    while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
        if TK[EP as usize] == 28 { EP = EP + 1 }
        if TK[EP as usize] == 7 || TK[EP as usize] == 0 { break }
        var label_kind: i64 = 0
        if TK[EP as usize] == 3 && TK[(EP + 1) as usize] == 43 {
            let lns = TS[EP as usize]
            let lne = TE[EP as usize]
            if src_match(lns, lne - lns, "uncertainty") { label_kind = 1 }
            else if src_match(lns, lne - lns, "confidence") { label_kind = 2 }
            else { tc_error(call_tok, "unknown measure metadata label") }
            EP = EP + 2
        }
        let arg_start = EP
        compile_or()
        let arg_ty = EXPR_TY
        let lit_tok = expr_simple_numeric_tok(arg_start, EP)
        let tmp_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        emit_store_var(tmp_slot)
        argc = argc + 1
        if label_kind == 2 || (label_kind == 0 && saw_unc != 0 && saw_conf == 0) {
            if saw_conf != 0 { tc_error(call_tok, "duplicate measure confidence") }
            conf_slot = tmp_slot
            conf_ty = arg_ty
            saw_conf = 1
        } else {
            if saw_unc != 0 { tc_error(call_tok, "duplicate measure uncertainty") }
            unc_slot = tmp_slot
            unc_ty = arg_ty
            unc_tok = lit_tok
            saw_unc = 1
        }
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }
    if argc <= 0 { tc_wrong_arity(call_tok, 2, 0) }
    let eps_scaled = infer_measure_eps_scaled(value_tok, unc_tok)
    let base_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 3
    if value_slot >= 0 { emit_load_var(value_slot) } else { em(0x31); em(0xc0) }
    emit_store_var(base_slot + 2)
    if unc_slot >= 0 {
        emit_load_var(unc_slot)
        if unc_ty != 2 {
            if ty_is_numeric(unc_ty) {
                em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xc0)
                em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
            } else {
                tc_error(call_tok, "measure uncertainty must be numeric")
                em(0x31); em(0xc0)
            }
        }
        em(0x48); em(0x89); em(0xc1)
        em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc0)
        em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc9)
        em(0xf2); em(0x0f); em(0x59); em(0xc1)
        em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
    } else {
        emit_imm64(0)
    }
    emit_store_var(base_slot + 1)
    if conf_slot >= 0 {
        emit_load_var(conf_slot)
        if conf_ty != 2 {
            if ty_is_numeric(conf_ty) {
                em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xc0)
                em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
            } else {
                tc_error(call_tok, "measure confidence must be numeric")
                emit_imm64(4607182418800017408)
            }
        }
    } else {
        emit_imm64(4607182418800017408)
    }
    emit_store_var(base_slot)
    em(0x48); em(0x8d); em(0x85)
    em32(0 - (base_slot + 2) * 8)
    EXPR_IS_F64 = 0
    EXPR_TY = 0
    EXPR_TY_HASH = knowledge_hash_make(value_ty, value_hash, eps_scaled)
    // Compile-time confidence: 1000 - relative_uncertainty_per_mille
    if eps_scaled >= 0 {
        EXPR_CONFIDENCE = 1000 - eps_scaled / 1000
        if EXPR_CONFIDENCE < 0 { EXPR_CONFIDENCE = 0 }
    } else {
        EXPR_CONFIDENCE = 500  // unknown uncertainty → conservative default
    }
}

fn compile_acknowledge_call_x86(call_tok: i64) with IO, Mut, Panic, Div {
    // acknowledge(k: Knowledge<T>, reason: String) -> T
    // Does NOT require `with Epistemic` — explicit uncertainty acknowledgment
    EP = EP + 1  // skip (
    if TK[EP as usize] == 7 || TK[EP as usize] == 0 {
        tc_arity_error(call_tok, "arity mismatch: acknowledge() requires 2 arguments")
        if TK[EP as usize] == 7 { EP = EP + 1 }
        EXPR_TY = 0
        EXPR_TY_HASH = 0
        EXPR_IS_F64 = 0
        return
    }
    // Compile first arg: the Knowledge<T> value
    compile_or()
    let ack_k_ty = EXPR_TY
    let ack_k_hash = EXPR_TY_HASH
    // Expect comma + reason arg
    if TK[EP as usize] == 28 {
        EP = EP + 1
    } else {
        tc_arity_error(call_tok, "arity mismatch: acknowledge() requires 2 arguments")
    }
    // Skip reason arg (not compiled — documentation only)
    if TK[EP as usize] != 7 && TK[EP as usize] != 0 {
        EP = skip_call_arg_expr(EP)
    }
    // Check for extra args
    if TK[EP as usize] == 28 {
        tc_error(call_tok, "acknowledge() takes exactly 2 arguments")
        while TK[EP as usize] != 7 && TK[EP as usize] != 0 { EP = EP + 1 }
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }
    // GUM seed: extract variance from Knowledge struct → BSS_SCRATCH
    let ack_src_slot = EXPR_VAR_SLOT
    if ack_src_slot >= 0 && ack_src_slot < 1024 {
        if KNOWLEDGE_CHANNEL_FOR_SLOT[ack_src_slot as usize] == 0 {
            KNOWLEDGE_CHANNEL_FOR_SLOT[ack_src_slot as usize] = NEXT_BUDGET_PARAM + 1
            NEXT_BUDGET_PARAM = NEXT_BUDGET_PARAM + 1
        }
        emit_seed_variance_from_knowledge_to_channel_x86(KNOWLEDGE_CHANNEL_FOR_SLOT[ack_src_slot as usize] - 1)
    } else {
        emit_seed_variance_from_knowledge_x86()
        NEXT_BUDGET_PARAM = NEXT_BUDGET_PARAM + 1
    }
    // Extract .value at offset 0: mov rax, [rax]
    em(0x48); em(0x8b); em(0x00)
    EXPR_SCRATCH_SOURCE_SLOT = ack_src_slot  // β fix Part B
    if ack_src_slot >= 0 { EXPR_VARIANCE_HASH = ack_src_slot * 2 + 1 } else { EXPR_VARIANCE_HASH = 0 }
    EXPR_VAR_SLOT = -2  // variance in scratch
    // Set result type to inner type
    if knowledge_hash_is(ack_k_hash) {
        let ack_inner_hash = knowledge_hash_inner_hash(ack_k_hash)
        EXPR_TY = knowledge_hash_inner_ty(ack_k_hash)
        EXPR_TY_HASH = ack_inner_hash
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
    } else if ack_k_ty == 6 {
        let ack_si = st_find(ack_k_hash)
        if ack_si >= 0 {
            EXPR_TY = ST_FTY[(ack_si * 128) as usize]
            EXPR_TY_HASH = ST_FHASH[(ack_si * 128) as usize]
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
        }
    }
}

fn compile_require_confidence_call_x86(call_tok: i64) with IO, Mut, Panic, Div {
    // require_confidence(k: Knowledge<T>, min: f64) -> T
    // Extracts .value if confidence >= min, panics (exit 1) otherwise
    EP = EP + 1  // skip (
    if TK[EP as usize] == 7 || TK[EP as usize] == 0 {
        tc_arity_error(call_tok, "arity mismatch: require_confidence() requires 2 arguments")
        if TK[EP as usize] == 7 { EP = EP + 1 }
        EXPR_TY = 0
        EXPR_TY_HASH = 0
        EXPR_IS_F64 = 0
        return
    }
    // Compile first arg: Knowledge<T> value → rax = struct ptr
    compile_or()
    let rc_k_ty = EXPR_TY
    let rc_k_hash = EXPR_TY_HASH
    let rc_k_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var(rc_k_slot)
    // Expect comma + threshold
    if TK[EP as usize] == 28 {
        EP = EP + 1
    } else {
        tc_arity_error(call_tok, "arity mismatch: require_confidence() requires 2 arguments")
    }
    // Compile second arg: threshold f64
    compile_or()
    let rc_min_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var(rc_min_slot)
    // Check for extra args
    if TK[EP as usize] == 28 {
        tc_error(call_tok, "require_confidence() takes exactly 2 arguments")
        while TK[EP as usize] != 7 && TK[EP as usize] != 0 { EP = EP + 1 }
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }
    // Load confidence field: [k_ptr + 16]
    emit_load_var(rc_k_slot)
    em(0x48); em(0x8b); em(0x40); em(16)  // mov rax, [rax + 16] — confidence f64 bits
    em(0x48); em(0x89); em(0xc1)           // mov rcx, rax (save confidence)
    emit_load_var(rc_min_slot)              // rax = threshold f64 bits
    // Compare: ucomisd xmm0 (confidence), xmm1 (threshold)
    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1)  // movq xmm0, rcx (confidence)
    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)  // movq xmm1, rax (threshold)
    em(0x66); em(0x0f); em(0x2e); em(0xc1)             // ucomisd xmm0, xmm1
    // jae +N (skip panic if confidence >= threshold)
    em(0x73)  // jae rel8
    let rc_ok_patch = CL
    em(0x00)  // placeholder
    emit_assert_fail()  // exit(1) — does not return
    CD[rc_ok_patch as usize] = (CL - rc_ok_patch - 1) as i8
    // Extract .value at offset 0
    emit_load_var(rc_k_slot)
    // GUM seed: extract variance from Knowledge struct → BSS_SCRATCH
    if rc_k_slot >= 0 && rc_k_slot < 1024 {
        if KNOWLEDGE_CHANNEL_FOR_SLOT[rc_k_slot as usize] == 0 {
            KNOWLEDGE_CHANNEL_FOR_SLOT[rc_k_slot as usize] = NEXT_BUDGET_PARAM + 1
            NEXT_BUDGET_PARAM = NEXT_BUDGET_PARAM + 1
        }
        emit_seed_variance_from_knowledge_to_channel_x86(KNOWLEDGE_CHANNEL_FOR_SLOT[rc_k_slot as usize] - 1)
    } else {
        emit_seed_variance_from_knowledge_x86()
        NEXT_BUDGET_PARAM = NEXT_BUDGET_PARAM + 1
    }
    em(0x48); em(0x8b); em(0x00)  // mov rax, [rax + 0] — .value
    EXPR_SCRATCH_SOURCE_SLOT = rc_k_slot  // β fix Part B
    if rc_k_slot >= 0 { EXPR_VARIANCE_HASH = rc_k_slot * 2 + 1 } else { EXPR_VARIANCE_HASH = 0 }
    EXPR_VAR_SLOT = -2  // variance in scratch
    // Set result type to inner type
    if knowledge_hash_is(rc_k_hash) {
        let rc_inner_hash = knowledge_hash_inner_hash(rc_k_hash)
        EXPR_TY = knowledge_hash_inner_ty(rc_k_hash)
        EXPR_TY_HASH = rc_inner_hash
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
    } else if rc_k_ty == 6 {
        let rc_si = st_find(rc_k_hash)
        if rc_si >= 0 {
            EXPR_TY = ST_FTY[(rc_si * 128) as usize]
            EXPR_TY_HASH = ST_FHASH[(rc_si * 128) as usize]
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
        }
    }
}

fn compile_knowledge_literal_x86() with IO, Mut, Panic, Div {
    EP = EP + 1
    let base_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 3
    var value_ty: i64 = 0
    var value_hash: i64 = 0
    var saw_value: i64 = 0
    var saw_var: i64 = 0
    var saw_conf: i64 = 0
    var lit_mode: i64 = 0
    var lit_eps: i64 = -1
    while TK[EP as usize] != 9 && TK[EP as usize] != 0 {
        if TK[EP as usize] == 3 {
            let field_tok = EP
            let fns = TS[EP as usize]
            let fne = TE[EP as usize]
            EP = EP + 1
            if TK[EP as usize] == 43 { EP = EP + 1 }
            let field_start = EP
            compile_or()
            let field_ty = EXPR_TY
            let field_hash = EXPR_TY_HASH
            let lit_tok = expr_simple_numeric_tok(field_start, EP)
            if src_match(fns, fne - fns, "value") {
                emit_store_var(base_slot + 2)
                value_ty = field_ty
                value_hash = field_hash
                saw_value = 1
            } else if src_match(fns, fne - fns, "variance") {
                if field_ty != 2 {
                    if ty_is_numeric(field_ty) {
                        emit_i64_to_f64_in_rax_x86()
                    } else {
                        tc_error(field_tok, "Knowledge variance must be numeric")
                        em(0x31); em(0xc0)
                    }
                }
                emit_store_var(base_slot + 1)
                saw_var = 1
            } else if src_match(fns, fne - fns, "uncertainty") {
                if field_ty != 2 {
                    if ty_is_numeric(field_ty) {
                        emit_i64_to_f64_in_rax_x86()
                    } else {
                        tc_error(field_tok, "Knowledge uncertainty must be numeric")
                        em(0x31); em(0xc0)
                    }
                }
                em(0x48); em(0x89); em(0xc1)
                em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc0)
                em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc9)
                em(0xf2); em(0x0f); em(0x59); em(0xc1)
                em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
                emit_store_var(base_slot + 1)
                saw_var = 1
            } else if src_match(fns, fne - fns, "confidence") || src_match(fns, fne - fns, "epsilon") {
                if field_ty != 2 {
                    if ty_is_numeric(field_ty) {
                        emit_i64_to_f64_in_rax_x86()
                    } else {
                        tc_error(field_tok, "Knowledge epsilon must be numeric")
                        em(0x31); em(0xc0)
                    }
                }
                emit_store_var(base_slot)
                saw_conf = 1
                if lit_tok >= 0 {
                    let scaled = tok_scaled_million(lit_tok)
                    if scaled >= 0 && scaled <= 1000000 {
                        lit_mode = 1
                        lit_eps = scaled
                    }
                }
            } else if src_match(fns, fne - fns, "validity") || src_match(fns, fne - fns, "provenance") {
            } else {
                tc_error(field_tok, "unknown field in Knowledge literal")
            }
        }
        if TK[EP as usize] == 28 { EP = EP + 1 }
    }
    if TK[EP as usize] == 9 { EP = EP + 1 }
    if saw_value == 0 {
        em(0x31); em(0xc0)
        emit_store_var(base_slot + 2)
        value_ty = 0
        value_hash = 0
    }
    if saw_var == 0 {
        em(0x31); em(0xc0)
        emit_store_var(base_slot + 1)
    }
    if saw_conf == 0 {
        emit_imm64(4607182418800017408)
        emit_store_var(base_slot)
    }
    em(0x48); em(0x8d); em(0x85)
    em32(0 - (base_slot + 2) * 8)
    EXPR_IS_F64 = 0
    EXPR_TY = 0
    EXPR_TY_HASH = knowledge_hash_make_mode(value_ty, value_hash, lit_mode, lit_eps)
    LAST_EXPR_IS_LINEAR = 0
    LAST_EXPR_IS_AFFINE = 0
}

// Precedence (low→high): || < && < comparison < bitwise OR < bitwise AND < shift < additive < multiplicative < unary < postfix < primary

fn compile_borrow_primary_x86() with IO, Mut, Panic, Div {
    EP = EP + 1
    var want_mut: i64 = 0
    if TK[EP as usize] == 32 {
        want_mut = 1
        EP = EP + 1
    }
    let borrow_tok = EP - 1
    let rns = TS[EP as usize]
    let rne = TE[EP as usize]
    EP = EP + 1
    if TK[EP as usize] == 41 {
        EP = EP + 1
        let start_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        compile_or()
        emit_store_var(start_slot)
        if TK[EP as usize] == 64 { tc_error(borrow_tok, "slice borrows require half-open ranges") }
        if TK[EP as usize] == 63 || TK[EP as usize] == 64 {
            EP = EP + 1
        } else {
            tc_error(borrow_tok, "slice borrow requires a..b range")
        }
        let end_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        compile_or()
        emit_store_var(end_slot)
        if TK[EP as usize] == 42 { EP = EP + 1 }
        else { tc_error(borrow_tok, "slice borrow missing closing ]") }
        let lvi = var_find_idx(rns, rne)
        var base_ptr_slot: i64 = 0
        var base_len_slot: i64 = 0
        var base_len_const: i64 = 0
        var has_const_len: i64 = 0
        var elem_ty: i64 = 1
        var esiz: i64 = 8
        var ok_base: i64 = 0
        var allow_mut: i64 = 0
        if lvi >= 0 {
            let lty = VAR_TY[lvi as usize]
            let lhash = VAR_TY_HASH[lvi as usize]
            base_ptr_slot = VAR_SLOT[lvi as usize]
            if type_is_slice_ref(lty, lhash) {
                let inner_hash = ref_hash_inner_hash(lhash)
                base_len_slot = VAR_LEN_SLOT[lvi as usize]
                esiz = arr_hash_esiz(inner_hash)
                if arr_hash_elem_ty(inner_hash) != 0 { elem_ty = arr_hash_elem_ty(inner_hash) }
                ok_base = 1
                if want_mut == 0 || ref_hash_mut(lhash) != 0 { allow_mut = 1 }
            } else if lty == 8 {
                base_len_const = VAR_ALEN[lvi as usize]
                has_const_len = 1
                esiz = VAR_ESIZ[lvi as usize]
                if arr_hash_elem_ty(lhash) != 0 { elem_ty = arr_hash_elem_ty(lhash) }
                ok_base = 1
                if want_mut == 0 || VAR_MUT[lvi as usize] != 0 { allow_mut = 1 }
            } else if type_is_array_ref(lty, lhash) {
                let inner_hash = ref_hash_inner_hash(lhash)
                base_len_const = arr_hash_alen(inner_hash)
                has_const_len = 1
                esiz = arr_hash_esiz(inner_hash)
                if arr_hash_elem_ty(inner_hash) != 0 { elem_ty = arr_hash_elem_ty(inner_hash) }
                ok_base = 1
                if want_mut == 0 || ref_hash_mut(lhash) != 0 { allow_mut = 1 }
            }
        } else {
            let gi = gl_find(rns, rne)
            if gi >= 0 && GL_TY[gi as usize] == 8 {
                base_len_const = GL[(gi * 4 + 3) as usize]
                has_const_len = 1
                esiz = GL[(gi * 4 + 2) as usize]
                if arr_hash_elem_ty(GL_TY_HASH[gi as usize]) != 0 { elem_ty = arr_hash_elem_ty(GL_TY_HASH[gi as usize]) }
                ok_base = 1
                allow_mut = 1
            }
        }
        if ok_base == 0 {
            tc_error(borrow_tok, "slice borrow requires array or slice base")
            em(0x31); em(0xc0)
            EXPR_IS_F64 = 0
            EXPR_TY = 10
            EXPR_TY_HASH = ref_hash_make(8, arr_ty_hash(0, 8, 1), want_mut)
            return
        }
        if want_mut != 0 && allow_mut == 0 {
            tc_error(borrow_tok, "Mut borrow requires mutable slice source")
        }
        emit_load_var(end_slot)
        em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (end)
        emit_load_var(start_slot)
        em(0x48); em(0x39); em(0xc8)  // cmp rax, rcx
        em(0x0f); em(0x86); let slice_range_ok_a = CL; em32(0)
        emit_assert_fail()
        patch32(slice_range_ok_a, CL)
        if has_const_len != 0 { emit_imm64(base_len_const) }
        else { emit_load_var(base_len_slot) }
        em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
        em(0x0f); em(0x86); let slice_range_ok_b = CL; em32(0)
        emit_assert_fail()
        patch32(slice_range_ok_b, CL)
        let len_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        let ptr_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        if lvi >= 0 {
            emit_load_var(base_ptr_slot)
        } else {
            let gi = gl_find(rns, rne)
            if gi >= 0 { emit_imm64(GL_BSS_BASE + GL[(gi * 4 + 1) as usize]) }
            else { em(0x31); em(0xc0) }
        }
        em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (base ptr)
        emit_load_var(start_slot)
        if esiz == 8 {
            em(0x48); em(0xc1); em(0xe0); em(3)  // shl rax, 3
        }
        em(0x48); em(0x01); em(0xd0)  // add rax, rdx
        emit_store_var(ptr_slot)
        emit_load_var(end_slot)
        em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (end)
        emit_load_var(start_slot)
        em(0x48); em(0x29); em(0xc1)  // sub rcx, rax
        em(0x48); em(0x89); em(0xc8)  // mov rax, rcx
        emit_store_var(len_slot)
        emit_lea_var(ptr_slot)
        EXPR_IS_F64 = 0
        EXPR_TY = 10
        EXPR_TY_HASH = ref_hash_make(8, arr_ty_hash(0, esiz, elem_ty), want_mut)
        return
    }
    let slot = var_find(rns, rne)
    if slot >= 0 {
        if want_mut != 0 && var_find_is_mut(rns, rne) == 0 {
            tc_error(borrow_tok, "Mut borrow requires mutable binding")
        }
        let lalen = var_find_alen(rns, rne)
        let lty = var_find_ty(rns, rne)
        if lalen > 0 || lty == 6 || lty == 8 {
            emit_load_var(slot)
        } else {
            let off = 0 - slot * 8
            em(0x48); em(0x8d); em(0x85)
            em32(off)
        }
    } else {
        let gi = gl_find(rns, rne)
        if gi >= 0 {
            let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
            em(0x48); em(0xb8); em64(addr)
        } else { tc_undefined_var(EP - 1); em(0x31); em(0xc0) }
    }
    EXPR_IS_F64 = 0
    EXPR_TY = 10
    let bvi = var_find_idx(rns, rne)
    if bvi >= 0 {
        // Borrow conflict detection: exclusive borrows conflict with any other borrow.
        if want_mut != 0 {
            if VAR_BORROW_COUNT[bvi as usize] > 0 {
                tc_linear_violation(borrow_tok, "cannot borrow as mutable because it is also borrowed as shared")
            }
            if VAR_BORROW_EXCL[bvi as usize] > 0 {
                tc_linear_violation(borrow_tok, "Cannot borrow as mutable: exclusive borrow already active")
            }
            VAR_BORROW_EXCL[bvi as usize] = VAR_BORROW_EXCL[bvi as usize] + 1
        } else {
            if VAR_BORROW_EXCL[bvi as usize] > 0 {
                tc_linear_violation(borrow_tok, "cannot borrow as shared because it is also borrowed as mutable")
            }
            VAR_BORROW_COUNT[bvi as usize] = VAR_BORROW_COUNT[bvi as usize] + 1
        }
        if want_mut != 0 {
            EXPR_TY_HASH = ref_hash_make(VAR_TY[bvi as usize], VAR_TY_HASH[bvi as usize], 1)
        } else {
            EXPR_TY_HASH = ref_hash_make(VAR_TY[bvi as usize], VAR_TY_HASH[bvi as usize], 0)
        }
    } else {
        let rgi = gl_find(rns, rne)
        if rgi >= 0 {
            if want_mut != 0 { EXPR_TY_HASH = ref_hash_make(GL_TY[rgi as usize], GL_TY_HASH[rgi as usize], 1) }
            else { EXPR_TY_HASH = ref_hash_make(GL_TY[rgi as usize], GL_TY_HASH[rgi as usize], 0) }
        }
        else {
            if want_mut != 0 { EXPR_TY_HASH = ref_hash_make(0, 0, 1) }
            else { EXPR_TY_HASH = ref_hash_make(0, 0, 0) }
        }
    }
}

fn compile_inline_block_expr_x86() with IO, Mut, Panic, Div {
    LAST_STMT_HAS_VALUE = 0
    LAST_STMT_TY = 0
    LAST_STMT_TY_HASH = 0
    if TK[EP as usize] == 8 { EP = EP + 1 }
    while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
    if TK[EP as usize] == 9 { EP = EP + 1 }
    if LAST_STMT_HAS_VALUE == 0 {
        em(0x31); em(0xc0)
        EXPR_TY = 5
        EXPR_TY_HASH = 0
        EXPR_IS_F64 = 0
        return
    }
    EXPR_TY = LAST_STMT_TY
    EXPR_TY_HASH = LAST_STMT_TY_HASH
    if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
}

fn compile_primary() with IO, Mut, Panic, Div {
    LAST_EXPR_IS_CLOSURE = 0
    LAST_EXPR_IS_LINEAR = 0
    LAST_EXPR_IS_AFFINE = 0
    LAST_EXPR_VAR_IDX = -1
    EXPR_TY = 0
    EXPR_TY_HASH = 0
    EXPR_UNIT = 0
    LAST_IS_LITERAL = 0
    EXPR_VAR_SLOT = -1
    EXPR_CONFIDENCE = 1000  // default: literals are certain
    let k = TK[EP as usize]
    if k == 77 && TK[(EP + 1) as usize] == 8 {
        compile_async_inline_block_x86(EP)
        return
    }
    if k == 78 && TK[(EP + 1) as usize] == 8 {
        compile_async_inline_block_x86(EP)
        return
    }
    // Integer literal
    if k == 4 {
        let v = TV[EP as usize]
        if v == 0 { em(0x31); em(0xc0) }
        else { em(0x48); em(0xb8); em64(v) }
        EP = EP + 1
        EXPR_IS_F64 = 0
        EXPR_TY = 1
        LAST_IS_LITERAL = 1
        LAST_LITERAL_VAL = v
        return
    }
    // true=35, false=36
    if k == 35 { em(0x48); em(0xb8); em64(1); EP = EP + 1; EXPR_IS_F64 = 0; EXPR_TY = 4; return }
    if k == 36 { em(0x31); em(0xc0); EP = EP + 1; EXPR_IS_F64 = 0; EXPR_TY = 4; return }
    // Float literal (53): runtime conversion via SSE2
    if k == 53 {
        let fl_int = TV[EP as usize]
        let fl_frac = TF[EP as usize]
        let fl_denom = TD[EP as usize]
        // Store exponent info in globals to avoid extra locals shifting compile_primary's frame
        if TX[EP as usize] >= 0 { FL_SCI_SCRATCH = TX[EP as usize]; FL_SCI_NEG = 0 }
        else { FL_SCI_SCRATCH = 0 - TX[EP as usize]; FL_SCI_NEG = 1 }
        EP = EP + 1
        // mov rax, int_part; cvtsi2sd xmm0, rax
        em(0x48); em(0xb8); em64(fl_int)
        em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xc0)
        // If fractional part: frac/denom added to xmm0
        if fl_frac > 0 {
            em(0x48); em(0xb8); em64(fl_frac)
            em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xc8)  // cvtsi2sd xmm1, rax
            em(0x48); em(0xb8); em64(fl_denom)
            em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xd0)  // cvtsi2sd xmm2, rax
            em(0xf2); em(0x0f); em(0x5e); em(0xca)            // divsd xmm1, xmm2
            em(0xf2); em(0x0f); em(0x58); em(0xc1)            // addsd xmm0, xmm1
        }
        // Apply scientific exponent: multiply or divide xmm0 by 10.0 FL_SCI_SCRATCH times
        if FL_SCI_SCRATCH != 0 {
            // Load 10.0 into xmm1: movabs rax, 0x4024000000000000; movq xmm1, rax
            em(0x48); em(0xb8); em64(0x4024000000000000)
            em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)
            if FL_SCI_NEG == 0 {
                while FL_SCI_SCRATCH > 0 {
                    em(0xf2); em(0x0f); em(0x59); em(0xc1)  // mulsd xmm0, xmm1
                    FL_SCI_SCRATCH = FL_SCI_SCRATCH - 1
                }
            } else {
                while FL_SCI_SCRATCH > 0 {
                    em(0xf2); em(0x0f); em(0x5e); em(0xc1)  // divsd xmm0, xmm1
                    FL_SCI_SCRATCH = FL_SCI_SCRATCH - 1
                }
            }
        }
        // movq rax, xmm0 — store f64 bits in rax
        em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
        EXPR_IS_F64 = 1
        EXPR_TY = 2
        return
    }
    if k == 48 {
        let match_tok = EP
        compile_stmt()
        if LAST_STMT_HAS_VALUE == 0 { tc_error(match_tok, "match expression must yield a value") }
        EXPR_TY = LAST_STMT_TY
        EXPR_TY_HASH = LAST_STMT_TY_HASH
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 }
        else { EXPR_IS_F64 = 0 }
        return
    }
    if k == 13 {
        let if_tok = EP
        compile_stmt()
        if LAST_STMT_HAS_VALUE == 0 { tc_error(if_tok, "if expression must yield a value") }
        EXPR_TY = LAST_STMT_TY
        EXPR_TY_HASH = LAST_STMT_TY_HASH
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 }
        else { EXPR_IS_F64 = 0 }
        return
    }
    if k == 41 {
        if array_init_is_repeat(EP) {
            EP = EP + 1
            compile_or()
            let elem_ty = EXPR_TY
            if TK[EP as usize] == 27 { EP = EP + 1 }
            let rep_count = TV[EP as usize]
            EP = EP + 1
            if TK[EP as usize] == 42 { EP = EP + 1 }
            let arr_hash = arr_ty_hash(rep_count, 8, elem_ty)
            let nslots = arr_storage_slots(arr_hash)
            if nslots > 0 {
                let base = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + nslots
                em(0x48); em(0x8d); em(0xbd)
                em32(0 - (base + nslots - 1) * 8)
                em(0xb9); em32(nslots)
                em(0xf3); em(0x48); em(0xab)
                em(0x48); em(0x8d); em(0x85)
                em32(0 - (base + nslots - 1) * 8)
            } else {
                em(0x31); em(0xc0)
            }
            EXPR_IS_F64 = 0
            EXPR_TY = 8
            EXPR_TY_HASH = arr_hash
            LAST_ALEN = rep_count
            return
        }
        let arr_count = array_lit_count(EP)
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + arr_count
        EP = EP + 1
        var idx: i64 = 0
        var elem_ty: i64 = 0
        var elem_hash: i64 = 0
        while TK[EP as usize] != 42 && TK[EP as usize] != 0 {
            compile_or()
            if idx == 0 {
                elem_ty = EXPR_TY
                elem_hash = EXPR_TY_HASH
            } else {
                if ty_eq(elem_ty, elem_hash, EXPR_TY, EXPR_TY_HASH) == false {
                    tc_error(EP - 1, "array literal elements must have the same type")
                }
            }
            emit_store_var(base + arr_count - 1 - idx)
            idx = idx + 1
            if TK[EP as usize] == 28 { EP = EP + 1 }
        }
        if TK[EP as usize] == 42 { EP = EP + 1 }
        em(0x48); em(0x8d); em(0x85)
        em32(0 - (base + arr_count - 1) * 8)
        EXPR_IS_F64 = 0
        EXPR_TY = 8
        EXPR_TY_HASH = arr_ty_hash(arr_count, 8, elem_ty)
        LAST_ALEN = arr_count
        return
    }
    // Closure: |params| expr  or  |params| { stmts }
    // Token 45 = | at expression start = closure (not bitwise OR)
    // Supports captured variables from outer scope via closure struct.
    // All closures build a stack struct: [fn_ptr, cap_0, cap_1, ...]
    // Closure function receives hidden first param (env_ptr) in rdi.
    // User args shift to rsi, rdx, rcx, r8, r9 (max 5 user args).
    if k == 45 || k == 31 {
        var zero_param_closure: i64 = 0
        if k == 31 { zero_param_closure = 1 }
        EP = EP + 1  // skip opening | or ||
        // Save outer function state
        let save_vc = VAR_COUNT
        let save_ns2 = NEXT_SLOT
        let save_ld = LOOP_DEPTH
        let save_bc = BREAK_COUNT
        let save_ret_ty = CURRENT_RET_TY
        let save_ret_hash = CURRENT_RET_HASH
        let save_sret_slot = CURRENT_SRET_SLOT
        let save_fpc = FRAME_PATCH_COUNT
        // Do NOT reset FRAME_PATCH_COUNT to 0: closure patches append after outer patches,
        // preserving the outer function's sub-rsp patch location at [0..save_fpc).
        var svi: i64 = 0
        while svi < save_vc {
            CL_SAVE_NS[svi as usize] = VAR_NS[svi as usize]
            CL_SAVE_NE[svi as usize] = VAR_NE[svi as usize]
            CL_SAVE_SL[svi as usize] = VAR_SLOT[svi as usize]
            CL_SAVE_LS[svi as usize] = VAR_LEN_SLOT[svi as usize]
            CL_SAVE_AL[svi as usize] = VAR_ALEN[svi as usize]
            CL_SAVE_ES[svi as usize] = VAR_ESIZ[svi as usize]
            CL_SAVE_F64[svi as usize] = VAR_IS_F64[svi as usize]
            CL_SAVE_ISCL[svi as usize] = VAR_IS_CLOSURE[svi as usize]
            CL_SAVE_MUT[svi as usize] = VAR_MUT[svi as usize]
            CL_SAVE_UNIT[svi as usize] = VAR_UNIT[svi as usize]
            CL_SAVE_LINEAR[svi as usize] = VAR_LINEAR[svi as usize]
            CL_SAVE_USED[svi as usize] = VAR_USED[svi as usize]
            CL_SAVE_TY[svi as usize] = VAR_TY[svi as usize]
            CL_SAVE_TH[svi as usize] = VAR_TY_HASH[svi as usize]
            svi = svi + 1
        }
        // Reset state for closure body
        VAR_COUNT = 0
        NEXT_SLOT = 2  // slot 1 reserved for env_ptr (hidden rdi param)
        LOOP_DEPTH = 0
        BREAK_COUNT = 0
        CL_CAP_COUNT = 0
        CURRENT_SRET_SLOT = 0
        // Parse closure parameters (between | ... |)
        // User params get slots 2, 3, ... (registers rsi, rdx, rcx, r8, r9)
        if zero_param_closure == 0 {
            while TK[EP as usize] != 45 && TK[EP as usize] != 0 {
                if TK[EP as usize] == 3 {
                    let pns = TS[EP as usize]
                    let pne = TE[EP as usize]
                    let pslot = var_add(pns, pne)
                    EP = EP + 1
                    if TK[EP as usize] == 43 {
                        EP = EP + 1
                        scan_type(EP)
                        if pslot >= 0 {
                            VAR_TY[(VAR_COUNT - 1) as usize] = SCAN_TY
                            VAR_TY_HASH[(VAR_COUNT - 1) as usize] = SCAN_TY_HASH
                            if SCAN_TY == 2 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 1 }
                            if SCAN_TY == 8 {
                                VAR_ALEN[(VAR_COUNT - 1) as usize] = SCAN_TY_ALEN
                                VAR_ESIZ[(VAR_COUNT - 1) as usize] = SCAN_TY_ESIZ
                            }
                        }
                        EP = SCAN_TY_NEXT
                    }
                }
                if TK[EP as usize] == 28 { EP = EP + 1 }
            }
            if TK[EP as usize] == 45 { EP = EP + 1 }  // skip closing |
        }
        if TK[EP as usize] == 10 {
            EP = EP + 1
            scan_type(EP)
            CURRENT_RET_TY = SCAN_TY
            CURRENT_RET_HASH = SCAN_TY_HASH
            EP = SCAN_TY_NEXT
        } else {
            CURRENT_RET_TY = 0
            CURRENT_RET_HASH = 0
        }
        if TK[EP as usize] == 38 {
            EP = EP + 1
            while TK[EP as usize] == 3 || TK[EP as usize] == 28 { EP = EP + 1 }
        }
        let nparams = VAR_COUNT  // user params only
        // Register outer-scope vars as captures (those not shadowed by params)
        var ci: i64 = 0
        while ci < save_vc {
            let ons = CL_SAVE_NS[ci as usize]
            let one = CL_SAVE_NE[ci as usize]
            let outer_slot = CL_SAVE_SL[ci as usize]
            let existing = var_find(ons, one)
            if existing < 0 {
                let cap_slot = var_add(ons, one)
                if cap_slot >= 0 {
                    let cap_vi = VAR_COUNT - 1
                    VAR_LEN_SLOT[cap_vi as usize] = CL_SAVE_LS[ci as usize]
                    VAR_ALEN[cap_vi as usize] = CL_SAVE_AL[ci as usize]
                    VAR_ESIZ[cap_vi as usize] = CL_SAVE_ES[ci as usize]
                    VAR_IS_F64[cap_vi as usize] = CL_SAVE_F64[ci as usize]
                    VAR_IS_CLOSURE[cap_vi as usize] = CL_SAVE_ISCL[ci as usize]
                    VAR_MUT[cap_vi as usize] = CL_SAVE_MUT[ci as usize]
                    VAR_UNIT[cap_vi as usize] = CL_SAVE_UNIT[ci as usize]
                    VAR_LINEAR[cap_vi as usize] = CL_SAVE_LINEAR[ci as usize]
                    VAR_USED[cap_vi as usize] = CL_SAVE_USED[ci as usize]
                    VAR_TY[cap_vi as usize] = CL_SAVE_TY[ci as usize]
                    VAR_TY_HASH[cap_vi as usize] = CL_SAVE_TH[ci as usize]
                    if CL_CAP_COUNT < local_cap() {
                        CL_CAP_SLOT[CL_CAP_COUNT as usize] = outer_slot
                        CL_CAP_COUNT = CL_CAP_COUNT + 1
                    } else {
                        note_limit_error(1)
                    }
                }
            }
            ci = ci + 1
        }
        // Emit jmp over closure body
        em(0xe9)
        let jmp_patch = CL
        em32(0)
        // Emit closure function body
        let cl_start = CL
        // Prologue: push rbp; mov rbp, rsp; sub rsp, <dynamic frame>
        em(0x55); em(0x48); em(0x89); em(0xe5)
        em(0x48); em(0x81); em(0xec); record_frame_patch(); em32(0)
        // Spill env_ptr (rdi) to slot 1: mov [rbp-8], rdi
        em(0x48); em(0x89); em(0x7d); em(0xf8 as i64 & 0xFF)
        // Spill user params from shifted registers (rsi=slot2, rdx=slot3, ...)
        if nparams >= 1 { em(0x48); em(0x89); em(0x75); em(0xf0 as i64 & 0xFF) }
        if nparams >= 2 { em(0x48); em(0x89); em(0x55); em(0xe8 as i64 & 0xFF) }
        if nparams >= 3 { em(0x48); em(0x89); em(0x4d); em(0xe0 as i64 & 0xFF) }
        if nparams >= 4 { em(0x4c); em(0x89); em(0x45); em(0xd8 as i64 & 0xFF) }
        if nparams >= 5 { em(0x4c); em(0x89); em(0x4d); em(0xd0 as i64 & 0xFF) }
        var stack_param_idx: i64 = 6
        while stack_param_idx <= nparams {
            em(0x48); em(0x8b); em(0x85); em32(16 + (stack_param_idx - 6) * 8)
            emit_store_var(1 + stack_param_idx)
            stack_param_idx = stack_param_idx + 1
        }
        // Load captured vars from env struct into local slots
        // env struct layout: [fn_ptr, cap_0, cap_1, ...] at ascending addresses
        // env_ptr points to fn_ptr; cap_i is at [env_ptr + (i+1)*8]
        var capi: i64 = 0
        while capi < CL_CAP_COUNT {
            emit_load_var(1)  // rax = env_ptr
            let cap_off = (capi + 1) * 8
            em(0x48); em(0x8b); em(0x80); em32(cap_off)  // mov rax, [rax + cap_off]
            emit_store_var(2 + nparams + capi)  // store in capture's local slot
            capi = capi + 1
        }
        // Compile body
        if TK[EP as usize] == 8 {
            EP = EP + 1
            while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
            if TK[EP as usize] == 9 { EP = EP + 1 }
        } else {
            compile_or()
        }
        // Epilogue
        if CL > 0 && CD[(CL - 1) as usize] != 0xc3 as i8 {
            em(0x48); em(0x81); em(0xc4); record_frame_patch(); em32(0)
            em(0x5d); em(0xc3)
        }
        // Patch closure sub rsp / add rsp with actual frame size.
        // Closure's patches start at save_fpc (appended after outer patches).
        let cl_frame_sz = (NEXT_SLOT * 8 + 15) & 0xFFFFFFF0
        if cl_frame_sz > max_frame_bytes() { tc_stack_frame_too_large(cl_frame_sz) }
        var cl_fpi: i64 = save_fpc
        while cl_fpi < FRAME_PATCH_COUNT { em32_at(FRAME_PATCH_OFF[cl_fpi as usize], cl_frame_sz); cl_fpi = cl_fpi + 1 }
        // Patch jmp over closure body
        patch32(jmp_patch, CL)
        // Save capture count before restoring outer state
        let saved_cap_count = CL_CAP_COUNT
        // Restore outer function state
        VAR_COUNT = save_vc
        NEXT_SLOT = save_ns2
        LOOP_DEPTH = save_ld
        BREAK_COUNT = save_bc
        CURRENT_RET_TY = save_ret_ty
        CURRENT_RET_HASH = save_ret_hash
        CURRENT_SRET_SLOT = save_sret_slot
        FRAME_PATCH_COUNT = save_fpc
        svi = 0
        while svi < save_vc {
            VAR_NS[svi as usize] = CL_SAVE_NS[svi as usize]
            VAR_NE[svi as usize] = CL_SAVE_NE[svi as usize]
            VAR_SLOT[svi as usize] = CL_SAVE_SL[svi as usize]
            VAR_LEN_SLOT[svi as usize] = CL_SAVE_LS[svi as usize]
            VAR_ALEN[svi as usize] = CL_SAVE_AL[svi as usize]
            VAR_ESIZ[svi as usize] = CL_SAVE_ES[svi as usize]
            VAR_IS_F64[svi as usize] = CL_SAVE_F64[svi as usize]
            VAR_IS_CLOSURE[svi as usize] = CL_SAVE_ISCL[svi as usize]
            VAR_MUT[svi as usize] = CL_SAVE_MUT[svi as usize]
            VAR_UNIT[svi as usize] = CL_SAVE_UNIT[svi as usize]
            VAR_LINEAR[svi as usize] = CL_SAVE_LINEAR[svi as usize]
            VAR_USED[svi as usize] = CL_SAVE_USED[svi as usize]
            VAR_TY[svi as usize] = CL_SAVE_TY[svi as usize]
            VAR_TY_HASH[svi as usize] = CL_SAVE_TH[svi as usize]
            svi = svi + 1
        }
        // --- Build closure struct on OUTER stack ---
        // Stack layout: slot N is at [rbp - N*8]. Higher slot = lower address.
        // We want a contiguous struct at ascending addresses:
        //   ptr[0] = fn_ptr, ptr[8] = cap_0, ptr[16] = cap_1, ...
        // Since ptr + 8 = higher address = lower slot number:
        //   fn_ptr  at slot (struct_base + struct_size - 1)  ← lowest address = ptr[0]
        //   cap_0   at slot (struct_base + struct_size - 2)  ← ptr[8]
        //   cap_i   at slot (struct_base + struct_size - 2 - i)
        // ptr = [rbp - (struct_base + struct_size - 1) * 8]
        let struct_size = 1 + saved_cap_count
        let struct_base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + struct_size
        let struct_top = struct_base + struct_size - 1
        // Store fn_ptr at slot struct_top (ptr[0])
        em(0x48); em(0x8d); em(0x05)
        em32(cl_start - (CL + 4))  // lea rax, [rip + offset_to_cl_start]
        emit_store_var(struct_top)
        // Store captures: cap_i at slot (struct_top - 1 - i) → ptr[(i+1)*8]
        var capj: i64 = 0
        while capj < saved_cap_count {
            emit_load_var(CL_CAP_SLOT[capj as usize])
            emit_store_var(struct_top - 1 - capj)
            capj = capj + 1
        }
