                    emit_push_a64()
                    if TK[EP as usize] == 28 { EP = EP + 1 } else { tc_wrong_arity(name_tok, 3, 1) }
                    if TK[EP as usize] != 7 && TK[EP as usize] != 0 {
                        compile_or_a64()
                        if EXPR_TY != 0 && EXPR_TY != 1 { tc_error(name_tok, "parse offset must be integer") }
                    } else {
                        em32(0xD2800000)
                    }
                    emit_push_a64()
                    if TK[EP as usize] == 28 { EP = EP + 1 } else { tc_wrong_arity(name_tok, 3, 2) }
                    if TK[EP as usize] != 7 && TK[EP as usize] != 0 {
                        compile_or_a64()
                        if EXPR_TY != 0 && EXPR_TY != 1 { tc_error(name_tok, "parse length must be integer") }
                    } else {
                        em32(0xD2800000)
                    }
                    emit_push_a64()
                    if TK[EP as usize] == 28 {
                        tc_wrong_arity(name_tok, 3, 4)
                        while TK[EP as usize] != 7 && TK[EP as usize] != 0 { EP = EP + 1 }
                    }
                    var parse_fi: i64 = fn_find_lit("__native_parse_i64")
                    if parse_is_f64 { parse_fi = fn_find_lit("__native_parse_f64") }
                    if parse_fi >= 0 { emit_direct_fn_call_a64(parse_fi, 3) }
                    else {
                        tc_error(name_tok, "missing native parse helper")
                        emit_drop_call_args_a64(3)
                        em32(0xD2800000)
                    }
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                }
                if parse_is_f64 {
                    EXPR_IS_F64 = 1
                    EXPR_TY = 2
                } else {
                    EXPR_IS_F64 = 0
                    EXPR_TY = 1
                }
                EXPR_TY_HASH = 0
                return
            }
            // f64 builtins
            let bh = gl_name_hash(ns, ne)
            let bl = ne - ns
            if bl == 7 && bh == 7078482 { EP = EP + 1; compile_or_a64(); emit_push_a64(); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or_a64(); emit_pop_x1_a64(); emit_f64_binop_a64(0x1E612800); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 1; return }
            if bl == 7 && bh == 7084000 { EP = EP + 1; compile_or_a64(); emit_push_a64(); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or_a64(); emit_pop_x1_a64(); emit_f64_binop_a64(0x1E613800); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 1; return }
            if bl == 7 && bh == 7085240 { EP = EP + 1; compile_or_a64(); emit_push_a64(); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or_a64(); emit_pop_x1_a64(); emit_f64_binop_a64(0x1E610800); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 1; return }
            if bl == 7 && bh == 7083783 { EP = EP + 1; compile_or_a64(); emit_push_a64(); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or_a64(); emit_pop_x1_a64(); emit_f64_binop_a64(0x1E611800); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 1; return }
            if bl == 7 && bh == 7081334 { EP = EP + 1; compile_or_a64(); em32(0x9E670000); em32(0x1E614000); em32(0x9E660000); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 1; return }
            if bl == 6 && bh == 6061460 { EP = EP + 1; compile_or_a64(); emit_push_a64(); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or_a64(); emit_pop_x1_a64(); em32(0x9E670020); em32(0x9E670001); em32(0x1E612020); em32(0x9A9F57E0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 0; return }
            if bl == 6 && bh == 6058670 { EP = EP + 1; compile_or_a64(); emit_push_a64(); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or_a64(); emit_pop_x1_a64(); em32(0x9E670020); em32(0x9E670001); em32(0x1E612020); em32(0x9A9F87E0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 0; return }
            if bl == 6 && bh == 6059817 { EP = EP + 1; compile_or_a64(); emit_push_a64(); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or_a64(); emit_pop_x1_a64(); em32(0x9E670020); em32(0x9E670001); em32(0x1E612020); em32(0x9A9F17E0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 0; return }
            if bl == 6 && bh == 6060685 { EP = EP + 1; compile_or_a64(); emit_push_a64(); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or_a64(); emit_pop_x1_a64(); em32(0x9E670020); em32(0x9E670001); em32(0x1E612020); em32(0x9A9FC7E0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 0; return }
            if bl == 6 && bh == 6057895 { EP = EP + 1; compile_or_a64(); emit_push_a64(); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or_a64(); emit_pop_x1_a64(); em32(0x9E670020); em32(0x9E670001); em32(0x1E612020); em32(0x9A9FB7E0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 0; return }
            if bl == 10 && bh == 10139623 { EP = EP + 1; compile_or_a64(); em32(0x9E670000); em32(0x9E780000); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 0; return }
            if bl == 10 && bh == 10138972 { EP = EP + 1; compile_or_a64(); em32(0x9E620000); em32(0x9E660000); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 1; return }
            // User function call
            let fi = ident_fi
            let call_vslot = var_find(ns, ne)
            var call_sig: i64 = 0
            var call_is_closure: i64 = 0
            if call_vslot >= 0 && var_find_ty(ns, ne) == 9 {
                call_sig = var_find_ty_hash(ns, ne)
                call_is_closure = var_find_is_closure(ns, ne)
            }
            let call_tok = EP - 1
            EP = EP + 1
            var argc: i64 = 0
            var abi_argc: i64 = 0
            while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
                compile_or_a64()
                if fi >= 0 {
                    scan_fn_param_type(fi, argc)
                } else if call_sig > 0 {
                    scan_fnsig_param_type(call_sig, argc)
                } else {
                    SCAN_TY = 0
                    SCAN_TY_HASH = 0
                }
                if (SCAN_TY != 0 || SCAN_TY_HASH != 0) && call_arg_type_compatible(SCAN_TY, SCAN_TY_HASH, EXPR_TY, EXPR_TY_HASH) == false {
                    if type_has_knowledge(SCAN_TY, SCAN_TY_HASH) || type_has_knowledge(EXPR_TY, EXPR_TY_HASH) {
                        tc_epistemic_boundary(call_tok)
                    } else {
                        let ont_r = try_tc_ontology_call_error(call_tok, SCAN_TY_HASH, EXPR_TY_HASH)
                        if ont_r == 0 { tc_linear_violation(call_tok, "error[E001]: Type mismatch in call argument — declared type does not match") }
                    }
                }
                if (fi >= 0 || (call_sig > 0 && call_is_closure == 0)) && type_is_slice_ref(SCAN_TY, SCAN_TY_HASH) {
                    emit_push_expr_as_slice_arg_a64(call_tok)
                    abi_argc = abi_argc + 2
                } else {
                    materialize_aggregate_expr_a64()
                    emit_push_a64()
                    abi_argc = abi_argc + 1
                }
                argc = argc + 1
                if TK[EP as usize] == 28 { EP = EP + 1 }
            }
            if TK[EP as usize] == 7 { EP = EP + 1 }
            if fi >= 0 {
                if FN_ARITY[fi as usize] != argc { tc_wrong_arity(call_tok, FN_ARITY[fi as usize], argc) }
                let callee_eff = FN_EFFECTS[fi as usize]
                let caller_eff = FN_EFFECTS[CURRENT_FN as usize]
                if effect_mask_is_subset(callee_eff, caller_eff) == false { tc_effect_call_violation(call_tok, callee_eff, caller_eff) }
                if abi_argc >= 8 { em32(0xF8410FE7) }
                if abi_argc >= 7 { em32(0xF8410FE6) }
                if abi_argc >= 6 { em32(0xF8410FE5) }
                if abi_argc >= 5 { em32(0xF8410FE4) }
                if abi_argc >= 4 { em32(0xF8410FE3) }
                if abi_argc >= 3 { em32(0xF8410FE2) }
                if abi_argc >= 2 { emit_pop_x1_a64() }
                if abi_argc >= 1 { em32(0xF8410FE0) }
                PATCH_OFF[PATCH_COUNT as usize] = CL
                PATCH_FN[PATCH_COUNT as usize] = fi
                PATCH_KIND[PATCH_COUNT as usize] = 0
                PATCH_COUNT = PATCH_COUNT + 1
                em32(0x94000000)
                EXPR_TY = FN_RET_TY[fi as usize]
                EXPR_TY_HASH = FN_RET_HASH[fi as usize]
                if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
            } else {
                if call_vslot >= 0 {
                    if call_sig > 0 && FNSIG_ARITY[call_sig as usize] != argc { tc_wrong_arity(call_tok, FNSIG_ARITY[call_sig as usize], argc) }
                    if call_is_closure == 1 {
                        if argc >= 5 { em32(0xF8410FE5) }
                        if argc >= 4 { em32(0xF8410FE4) }
                        if argc >= 3 { em32(0xF8410FE3) }
                        if argc >= 2 { em32(0xF8410FE2) }
                        if argc >= 1 { em32(0xF8410FE1) }
                        emit_load_var_a64(call_vslot)
                        em32(0xF9400009)
                        em32(0xD63F0120)
                    } else {
                        emit_load_var_a64(call_vslot)
                        em32(0xAA0003E9)
                        if abi_argc >= 8 { em32(0xF8410FE7) }
                        if abi_argc >= 7 { em32(0xF8410FE6) }
                        if abi_argc >= 6 { em32(0xF8410FE5) }
                        if abi_argc >= 5 { em32(0xF8410FE4) }
                        if abi_argc >= 4 { em32(0xF8410FE3) }
                        if abi_argc >= 3 { em32(0xF8410FE2) }
                        if abi_argc >= 2 { emit_pop_x1_a64() }
                        if abi_argc >= 1 { em32(0xF8410FE0) }
                        em32(0xD63F0120)
                    }
                    if call_sig > 0 {
                        EXPR_TY = FNSIG_RET_TY[call_sig as usize]
                        EXPR_TY_HASH = FNSIG_RET_HASH[call_sig as usize]
                    } else {
                        EXPR_TY = 0
                        EXPR_TY_HASH = 0
                    }
                    if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                } else {
                    tc_undefined_var(name_tok)
                    em32(0xD2800000)
                    EXPR_IS_F64 = 0
                    EXPR_TY = 0
                    EXPR_TY_HASH = 0
                }
            }
            return
        }
        if TK[EP as usize] == 8 && src_match(ns, ne - ns, "Knowledge") {
            compile_knowledge_literal_a64()
            return
        }
        // Struct literal
        if TK[EP as usize] == 8 {
            let sh = gl_name_hash(ns, ne)
            let si = st_find(sh)
            if si >= 0 {
                EP = EP + 1
                let total_slots = st_total_size(si) / 8
                let base_slot = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + total_slots
                while TK[EP as usize] != 9 && TK[EP as usize] != 0 {
                    if TK[EP as usize] == 3 {
                        let field_tok = EP
                        let fns = TS[EP as usize]
                        let fne = TE[EP as usize]
                        let fh = gl_name_hash(fns, fne)
                        EP = EP + 1
                        if TK[EP as usize] == 43 { EP = EP + 1 }
                        let foff = st_field_offset(si, fh)
                        let fty = st_field_ty(si, fh)
                        let fhash = st_field_hash(si, fh)
                        if foff >= 0 {
                            let dst_start = base_slot + total_slots - 1 - foff / 8
                            if fty == 8 && TK[EP as usize] == 41 && array_init_is_repeat(EP) {
                                EP = EP + 1
                                compile_or_a64()
                                if ty_eq(arr_hash_elem_ty(fhash), 0, EXPR_TY, EXPR_TY_HASH) == false {
                                    tc_error(field_tok, "array repeat element type does not match field type")
                                }
                                if TK[EP as usize] == 27 { EP = EP + 1 }
                                let rep_count = TV[EP as usize]
                                EP = EP + 1
                                if TK[EP as usize] == 42 { EP = EP + 1 }
                                if rep_count != arr_hash_alen(fhash) {
                                    tc_error(field_tok, "array repeat length does not match field type")
                                }
                                fill_repeat_struct_array_slots_a64(dst_start, fhash)
                            } else {
                                compile_or_a64()
                                if fty != 0 && ty_eq(fty, fhash, EXPR_TY, EXPR_TY_HASH) == false {
                                    tc_error(field_tok, "field initializer type does not match struct field")
                                }
                                copy_agg_into_struct_slots_a64(dst_start, fty, fhash)
                            }
                        } else { tc_error(field_tok, "unknown field in struct literal"); compile_or_a64() }
                    }
                    if TK[EP as usize] == 28 { EP = EP + 1 }
                }
                if TK[EP as usize] == 9 { EP = EP + 1 }
                emit_lea_var_a64(base_slot + total_slots - 1)
                EXPR_IS_F64 = 0
                EXPR_TY = 6
                EXPR_TY_HASH = sh
                LAST_EXPR_IS_LINEAR = ST_LINEAR[si as usize]
                return
            }
        }
        // Array subscript
        if TK[EP as usize] == 41 {
            EP = EP + 1
            compile_or_a64()
            if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
            if TK[EP as usize] == 42 { EP = EP + 1 }
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                let base = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                let esz = GL[(gi * 4 + 2) as usize]
                var elem_ty = arr_hash_elem_ty(GL_TY_HASH[gi as usize])
                if elem_ty == 0 { elem_ty = 1 }
                em32(0xAA0003E9)
                emit_imm64_a64(base)
                if esz == 8 {
                    em32(0xF8697800)
                    EXPR_TY = elem_ty
                    EXPR_TY_HASH = 0
                    if elem_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                }
                else {
                    em32(0x38A96800)
                    EXPR_TY = 1
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 0
                }
            } else {
                let slot = var_find(ns, ne)
                if slot >= 0 {
                    let lalen = var_find_alen(ns, ne)
                    let lesiz = var_find_esiz(ns, ne)
                    let lvi = var_find_idx(ns, ne)
                    var elem_ty = 1
                    var is_arr_ty = 0
                    var is_slice_ty = 0
                    if lvi >= 0 {
                        elem_ty = arr_hash_elem_ty(VAR_TY_HASH[lvi as usize])
                        if elem_ty == 0 { elem_ty = 1 }
                        if VAR_TY[lvi as usize] == 8 { is_arr_ty = 1 }
                        if VAR_TY[lvi as usize] == 10 {
                            if ref_hash_inner_ty(VAR_TY_HASH[lvi as usize]) == 8 {
                                is_arr_ty = 1
                                if type_is_slice_ref(VAR_TY[lvi as usize], VAR_TY_HASH[lvi as usize]) { is_slice_ty = 1 }
                                if arr_hash_elem_ty(ref_hash_inner_hash(VAR_TY_HASH[lvi as usize])) != 0 {
                                    elem_ty = arr_hash_elem_ty(ref_hash_inner_hash(VAR_TY_HASH[lvi as usize]))
                                }
                            }
                        }
                    }
                    em32(0xAA0003E9)
                    if is_slice_ty == 1 {
                        emit_load_var_a64(VAR_LEN_SLOT[lvi as usize])
                        em32(0xAA0003EA)  // mov x10, x0
                        em32(0xEB00001F | (10 << 16) | (9 << 5))  // cmp x9, x10
                        let slice_ok_local_a = CL
                        em32(0x54000003)  // b.lo ok
                        emit_assert_fail_a64()
                        patch_branch_a64(slice_ok_local_a, CL)
                    }
                    emit_load_var_a64(slot)
                    if is_arr_ty == 1 && lesiz == 8 {
                        em32(0xF8697800)
                        EXPR_TY = elem_ty
                        EXPR_TY_HASH = 0
                        if elem_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                    } else if is_arr_ty == 1 && lesiz == 1 {
                        em32(0x38A96800)
                        EXPR_TY = 1
                        EXPR_TY_HASH = 0
                        EXPR_IS_F64 = 0
                    } else {
                        em32(0x38A96800)
                        EXPR_TY = 1
                        EXPR_TY_HASH = 0
                        EXPR_IS_F64 = 0
                    }
                } else {
                    tc_undefined_var(name_tok)
                    em32(0xD2800000)
                    EXPR_TY = 0
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 0
                }
            }
            return
        }
        // Variable load
        let slot = var_find(ns, ne)
        if slot >= 0 {
            let vi = var_find_idx(ns, ne)
            if vi >= 0 && type_is_slice_ref(VAR_TY[vi as usize], VAR_TY_HASH[vi as usize]) {
                emit_lea_var_a64(slot)
            } else {
                emit_load_var_a64(slot)
            }
            EXPR_IS_F64 = var_find_is_f64(ns, ne)
            if vi >= 0 {
                EXPR_TY = VAR_TY[vi as usize]
                EXPR_TY_HASH = VAR_TY_HASH[vi as usize]
                if VAR_ALEN[vi as usize] > 0 { LAST_ALEN = VAR_ALEN[vi as usize] }
                if VAR_IS_CLOSURE[vi as usize] == 1 { LAST_EXPR_IS_CLOSURE = 1 }
