            let rgi = gl_find(rns, rne)
            if rgi >= 0 {
                var inner_ty_gb = GL_TY[rgi as usize]
                var inner_hash_gb = GL_TY_HASH[rgi as usize]
                if inner_ty_gb == 11 && box_hash_is(inner_hash_gb) {
