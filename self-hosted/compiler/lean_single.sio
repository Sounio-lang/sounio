            if fn_find(ns, ne) < 0 && src_match(ns, ne - ns, "print") {
                if (FN_EFFECTS[CURRENT_FN as usize] & 1) == 0 { tc_effect_violation(name_tok, 1, FN_EFFECTS[CURRENT_FN as usize]) }
                EP = EP + 1
                if TK[EP as usize] == 5 && TK[(EP + 1) as usize] == 7 {
                    emit_print(EP); EP = EP + 1
                } else {
                    compile_or()
                    if EXPR_IS_F64 == 1 || EXPR_TY == 2 {
                        emit_print_f64()
                    } else if EXPR_TY == 3 {
                        emit_print_cstr()
                    } else {
                        emit_print_int()
                    }
