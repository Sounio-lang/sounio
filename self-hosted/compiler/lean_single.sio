            if bl == 6 && bh == 6060685 { EP = EP + 1; compile_or(); em(0x50); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or(); em(0x59); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8); em(0x66); em(0x0f); em(0x2e); em(0xc1); em(0x0f); em(0x97); em(0xc0); em(0x48); em(0x0f); em(0xb6); em(0xc0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 0; EXPR_TY = 4; return }
            if bl == 6 && bh == 6057895 { EP = EP + 1; compile_or(); em(0x50); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or(); em(0x59); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8); em(0x66); em(0x0f); em(0x2e); em(0xc1); em(0x0f); em(0x93); em(0xc0); em(0x48); em(0x0f); em(0xb6); em(0xc0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 0; EXPR_TY = 4; return }
            // f64_to_i64 / i64_to_f64: 10 chars
            if bl == 10 && bh == 10139623 { EP = EP + 1; compile_or(); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc0); em(0xf2); em(0x48); em(0x0f); em(0x2c); em(0xc0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 0; EXPR_TY = 1; return }
            if bl == 10 && bh == 10138972 { EP = EP + 1; compile_or(); em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xc0); em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 1; EXPR_TY = 2; return }
            // User function call
            let fi = fn_find(ns, ne)
            let call_vslot = var_find(ns, ne)
            let call_tok = EP - 1
            EP = EP + 1
            var argc: i64 = 0
            while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
                compile_or()
                em(0x50)
                argc = argc + 1
                if TK[EP as usize] == 28 { EP = EP + 1 }
            }
            if TK[EP as usize] == 7 { EP = EP + 1 }
            if fi >= 0 {
                if FN_ARITY[fi as usize] != argc { tc_wrong_arity(call_tok, FN_ARITY[fi as usize], argc) }
                // Effects check: callee effects must be subset of caller effects
                let callee_eff = FN_EFFECTS[fi as usize]
                let caller_eff = FN_EFFECTS[CURRENT_FN as usize]
                if (callee_eff & ~caller_eff) != 0 {
                    print("warning: effect violation: fn#")
                    print_int(fi)
                    print("(eff=")
                    print_int(callee_eff)
                    print(") called from fn#")
                    print_int(CURRENT_FN)
                    print("(eff=")
                    print_int(caller_eff)
                    print(")\n")
                }
                // Direct call: pop args into rdi,rsi,rdx,rcx,r8,r9
                if argc >= 6 { em(0x41); em(0x59) }
                if argc >= 5 { em(0x41); em(0x58) }
                if argc >= 4 { em(0x59) }
                if argc >= 3 { em(0x5a) }
                if argc >= 2 { em(0x5e) }
                if argc >= 1 { em(0x5f) }
                em(0xe8)
                PATCH_OFF[PATCH_COUNT as usize] = CL
                PATCH_FN[PATCH_COUNT as usize] = fi
                PATCH_COUNT = PATCH_COUNT + 1
                em32(0)
                EXPR_TY = FN_RET_TY[fi as usize]
                EXPR_TY_HASH = FN_RET_HASH[fi as usize]
                if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
            } else {
                // Indirect call through variable — uniform closure convention:
                // All callable values are closure struct pointers [fn_ptr, cap_0, ...]
                // Pop user args into shifted regs (rsi,rdx,rcx,r8,r9), max 5 user args
                // rdi = closure struct ptr (env), fn_ptr loaded from [env]
                if argc >= 5 { em(0x41); em(0x59) }  // pop r9
                if argc >= 4 { em(0x41); em(0x58) }  // pop r8
                if argc >= 3 { em(0x59) }              // pop rcx
                if argc >= 2 { em(0x5a) }              // pop rdx
                if argc >= 1 { em(0x5e) }              // pop rsi
                if call_vslot >= 0 {
                    emit_load_var(call_vslot)           // rax = closure struct ptr
                    em(0x48); em(0x89); em(0xc7)        // mov rdi, rax (env_ptr)
                    em(0x48); em(0x8b); em(0x00)        // mov rax, [rax] (fn_ptr)
                    em(0xff); em(0xd0)                  // call rax
                } else {
                    tc_undefined_var(call_tok)
                    em(0x31); em(0xc0)  // unknown fn
                }
            }
            if fi < 0 { EXPR_IS_F64 = 0 }
            return
        }
        // Struct literal: StructName { field: val, ... }
        if TK[EP as usize] == 8 {
            let sh = gl_name_hash(ns, ne)
            let si = st_find(sh)
            if si >= 0 {
                EP = EP + 1  // skip {
                let fc = ST[(si * 66 + 1) as usize]
                // Allocate fc consecutive stack slots for struct fields
                let base_slot = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + fc
                // Parse field: value pairs
                while TK[EP as usize] != 9 && TK[EP as usize] != 0 {
                    if TK[EP as usize] == 3 {
                        let field_tok = EP
                        let fns = TS[EP as usize]
                        let fne = TE[EP as usize]
                        let fh = gl_name_hash(fns, fne)
                        EP = EP + 1  // skip field name
                        if TK[EP as usize] == 43 { EP = EP + 1 }  // skip :
                        compile_or()  // value in rax
                        let foff = st_field_offset(si, fh)
                        if foff >= 0 {
                            emit_store_var(base_slot + fc - 1 - foff / 8)
                        } else {
                            tc_error(field_tok, "unknown field in struct literal")
                        }
                    }
                    if TK[EP as usize] == 28 { EP = EP + 1 }  // skip comma
                }
                if TK[EP as usize] == 9 { EP = EP + 1 }  // skip }
                // lea rax, [rbp - (base_slot+fc-1)*8] — pointer to struct data (lowest addr)
                em(0x48); em(0x8d); em(0x85)
                em32(0 - (base_slot + fc - 1) * 8)
                EXPR_IS_F64 = 0
                EXPR_TY = 6
                EXPR_TY_HASH = sh
                // Track if this struct is linear
                LAST_EXPR_IS_LINEAR = ST_LINEAR[si as usize]
                return
            }
        }
        // Array subscript: IDENT[expr]
        if TK[EP as usize] == 41 {
            EP = EP + 1  // skip [
            compile_or()  // index in rax
            if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }  // skip 'as usize'
            if TK[EP as usize] == 42 { EP = EP + 1 }  // skip ]
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                let base = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                let esz = GL[(gi * 4 + 2) as usize]
                if esz == 8 {
                    // mov rcx, rax; mov rax, base; mov rax, [rax + rcx*8]
                    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (index)
                    em(0x48); em(0xb8); em64(base)  // mov rax, base
                    em(0x48); em(0x8b); em(0x04); em(0xc8)  // mov rax, [rax + rcx*8]
                } else {
                    // i8 array: movsx rax, byte [rax + rcx]
                    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax
                    em(0x48); em(0xb8); em64(base)  // mov rax, base
                    em(0x48); em(0x0f); em(0xbe); em(0x04); em(0x08)  // movsx rax, byte [rax + rcx]
                }
                if esz == 1 { EXPR_TY = 1 }
            } else {
                // Local pointer subscript: ptr[idx] → load ptr from stack, add index
                let slot = var_find(ns, ne)
                if slot >= 0 {
                    let lalen = var_find_alen(ns, ne)
                    let lesiz = var_find_esiz(ns, ne)
                    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (index)
                    emit_load_var(slot)  // load ptr into rax
                    if lalen > 0 && lesiz == 8 {
                        em(0x48); em(0x8b); em(0x04); em(0xc8)  // mov rax, [rax + rcx*8]
                    } else if lalen > 0 && lesiz == 1 {
                        em(0x48); em(0x0f); em(0xbe); em(0x04); em(0x08)  // movsx rax, byte [rax + rcx]
                        EXPR_TY = 1
                    } else {
                        // Non-array local pointer (e.g. read_file result): byte access
                        em(0x48); em(0x0f); em(0xbe); em(0x04); em(0x08)  // movsx rax, byte [rax + rcx]
                        EXPR_TY = 1
                    }
                } else {
                    tc_undefined_var(name_tok)
                    em(0x31); em(0xc0)
                    EXPR_TY = 0
                    EXPR_TY_HASH = 0
                }
            }
            EXPR_IS_F64 = 0
            return
        }
        // Variable load (local first, then global)
        let slot = var_find(ns, ne)
        if slot >= 0 {
            let vi = var_find_idx(ns, ne)
            emit_load_var(slot)
            EXPR_IS_F64 = var_find_is_f64(ns, ne)
            if vi >= 0 {
                EXPR_TY = VAR_TY[vi as usize]
                EXPR_TY_HASH = VAR_TY_HASH[vi as usize]
            }
            var_mark_used(ns, ne)
        }
        else {
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                let alen = GL[(gi * 4 + 3) as usize]
                em(0x48); em(0xb8); em64(addr)  // mov rax, addr
                if alen == 0 {
                    em(0x48); em(0x8b); em(0x00)  // scalar: mov rax, [rax] (dereference)
                }
                EXPR_TY = GL_TY[gi as usize]
                EXPR_TY_HASH = GL_TY_HASH[gi as usize]
                // array: rax = address (no dereference — used as pointer)
            } else {
                // Function reference: let f = some_fn (no parens)
                // Wrap in closure struct so indirect calls use uniform convention.
                // Emit a wrapper fn that converts closure convention → normal convention:
                //   rdi=env(ignored), rsi=arg0, rdx=arg1, ... → rdi=arg0, rsi=arg1, ...
                // Then build a 1-slot struct [wrapper_addr] on the outer stack.
                let fri = fn_find(ns, ne)
                if fri >= 0 {
                    // Emit jmp over wrapper
                    em(0xe9)
                    let wr_jmp_patch = CL
                    em32(0)
                    let wr_start = CL
                    // Wrapper: shift args back (rsi→rdi, rdx→rsi, rcx→rdx, r8→rcx, r9→r8)
                    em(0x48); em(0x89); em(0xf7)  // mov rdi, rsi
                    em(0x48); em(0x89); em(0xd6)  // mov rsi, rdx
                    em(0x48); em(0x89); em(0xca)  // mov rdx, rcx
                    em(0x49); em(0x89); em(0xc0)  // mov r8, rax — save rax temporarily
                    em(0x4c); em(0x89); em(0xc1)  // mov rcx, r8 (original r8 value is lost, use r10)
                    // Actually we need: rcx = r8_old, r8 = r9_old
                    // The registers at entry: rdi=env, rsi=a0, rdx=a1, rcx=a2, r8=a3, r9=a4
                    // Target: rdi=a0, rsi=a1, rdx=a2, rcx=a3, r8=a4, r9=unused
                    // Careful ordering to avoid clobbering:
                    // 1. mov rdi, rsi (rdi clobbered, but we don't need env anymore)
                    // 2. mov rsi, rdx
                    // 3. mov rdx, rcx
                    // 4. mov rcx, r8
                    // 5. mov r8, r9
                    // Each reads from a register before it's overwritten. Safe order. Let me redo:
                    CL = wr_start  // rewind
                    em(0x48); em(0x89); em(0xf7)        // mov rdi, rsi
                    em(0x48); em(0x89); em(0xd6)        // mov rsi, rdx
                    em(0x48); em(0x89); em(0xca)        // mov rdx, rcx
                    em(0x4c); em(0x89); em(0xc1)        // mov rcx, r8
                    em(0x4d); em(0x89); em(0xc8)        // mov r8, r9
                    // jmp to real function (rel32, patched later)
                    em(0xe9)
                    PATCH_OFF[PATCH_COUNT as usize] = CL
                    PATCH_FN[PATCH_COUNT as usize] = fri
                    PATCH_COUNT = PATCH_COUNT + 1
                    em32(0)
                    // Patch jmp over wrapper
                    patch32(wr_jmp_patch, CL)
                    // Build 1-slot closure struct on stack: [wrapper_addr]
                    let fn_struct_slot = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + 1
                    em(0x48); em(0x8d); em(0x05)
                    em32(wr_start - (CL + 4))  // lea rax, [rip + offset_to_wrapper]
                    emit_store_var(fn_struct_slot)
                    // lea rax, [rbp - fn_struct_slot*8] — pointer to struct
                    em(0x48); em(0x8d); em(0x85)
                    em32(0 - fn_struct_slot * 8)
                    LAST_EXPR_IS_CLOSURE = 1
                    EXPR_TY = 9
                } else {
                    tc_undefined_var(name_tok)
                    em(0x31); em(0xc0)
                }
            }
            EXPR_IS_F64 = 0
        }
        return
    }
    EP = EP + 1
    em(0x31); em(0xc0)
    EXPR_IS_F64 = 0
}

// Postfix: `as` type casts, `.field` access
fn compile_postfix() with IO, Mut, Panic, Div {
    compile_primary()
    var more: i64 = 1
    while more == 1 {
        if TK[EP as usize] == 37 {
            EP = EP + 1  // skip 'as'
            let tp = EP
            let src_is_f64 = EXPR_IS_F64
            let tns = TS[EP as usize]
            let tne = TE[EP as usize]
            scan_type(tp)
            if SCAN_TY == 1 && src_is_f64 == 1 {
                em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc0)
                em(0xf2); em(0x48); em(0x0f); em(0x2c); em(0xc0)
            }
            if SCAN_TY == 2 && src_is_f64 == 0 {
                em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xc0)
                em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
            }
            if SCAN_TY == 1 && tne - tns == 2 && sb(tns) == 105 && sb(tns+1) == 56 {
                em(0x48); em(0x0f); em(0xbe); em(0xc0)  // as i8: movsx rax, al
            }
            EXPR_TY = SCAN_TY
            EXPR_TY_HASH = SCAN_TY_HASH
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
            EP = SCAN_TY_NEXT
            continue
        }
        if TK[EP as usize] == 50 {
            EP = EP + 1  // skip '.'
            let method_tok = EP
            let fns = TS[EP as usize]
            let fne = TE[EP as usize]
            let fh = gl_name_hash(fns, fne)
            // Method call: obj.method(args) → method(obj, args)
            if TK[(EP + 1) as usize] == 6 {
                let mfi = fn_find(fns, fne)
                if mfi >= 0 {
                    EP = EP + 1  // skip method name
                    EP = EP + 1  // skip (
                    // rax = self pointer. Push as first arg.
                    em(0x50)  // push self
                    var margc: i64 = 1
                    while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
                        compile_or()
                        em(0x50)
                        margc = margc + 1
                        if TK[EP as usize] == 28 { EP = EP + 1 }
                    }
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                    if FN_ARITY[mfi as usize] != margc { tc_wrong_arity(method_tok, FN_ARITY[mfi as usize], margc) }
                    // Pop args into registers (reverse order)
                    if margc >= 6 { em(0x41); em(0x59) }
                    if margc >= 5 { em(0x41); em(0x58) }
                    if margc >= 4 { em(0x59) }
                    if margc >= 3 { em(0x5a) }
                    if margc >= 2 { em(0x5e) }
                    if margc >= 1 { em(0x5f) }
                    em(0xe8)
                    PATCH_OFF[PATCH_COUNT as usize] = CL
                    PATCH_FN[PATCH_COUNT as usize] = mfi
                    PATCH_COUNT = PATCH_COUNT + 1
                    em32(0)
                    EXPR_TY = FN_RET_TY[mfi as usize]
                    EXPR_TY_HASH = FN_RET_HASH[mfi as usize]
                    if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                    continue
                }
            }
            // Field access: rax = struct pointer, load field
            let base_ty = EXPR_TY
            let base_hash = EXPR_TY_HASH
            EP = EP + 1
            var found: i64 = 0
            EXPR_TY = 0
            EXPR_TY_HASH = 0
            if base_ty == 6 {
                let bsi = st_find(base_hash)
                if bsi >= 0 {
                    let off = st_field_offset(bsi, fh)
                    if off >= 0 {
                        if off == 0 {
                            em(0x48); em(0x8b); em(0x00)  // mov rax, [rax]
                        } else {
                            em(0x48); em(0x8b); em(0x80); em32(off)  // mov rax, [rax+off]
                        }
                        EXPR_TY = st_field_ty(bsi, fh)
                        EXPR_TY_HASH = st_field_hash(bsi, fh)
                    } else {
                        tc_error(method_tok, "unknown field access")
                        em(0x31); em(0xc0)
                    }
                    found = 1
                }
            }
            var si: i64 = 0
            while si < ST_COUNT && found == 0 {
                let off = st_field_offset(si, fh)
                if off >= 0 {
                    if off == 0 {
                        em(0x48); em(0x8b); em(0x00)  // mov rax, [rax]
                    } else {
                        em(0x48); em(0x8b); em(0x80); em32(off)  // mov rax, [rax+off]
                    }
                    EXPR_TY = st_field_ty(si, fh)
                    EXPR_TY_HASH = st_field_hash(si, fh)
                    found = 1
                }
                si = si + 1
            }
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
            continue
        }
        more = 0
    }
}

fn compile_multiplicative() with IO, Mut, Panic, Div {
    compile_postfix()
    while TK[EP as usize] == 19 || TK[EP as usize] == 20 || TK[EP as usize] == 29 {
        let op_tok = EP
        let op = TK[EP as usize]
        EP = EP + 1
        let left_f64 = EXPR_IS_F64
        let left_ty = EXPR_TY
        emit_push()
        compile_postfix()
        let right_ty = EXPR_TY
        if left_ty != 0 && right_ty != 0 {
            if op == 29 {
                if left_ty != 1 || right_ty != 1 { tc_error(op_tok, "modulo requires integer operands") }
            } else {
                if ty_is_numeric(left_ty) == false || ty_is_numeric(right_ty) == false || left_ty != right_ty {
                    tc_error(op_tok, "arithmetic operands must have matching numeric types")
                }
            }
        }
        em(0x59)  // pop rcx (lhs)
        if left_f64 == 1 {
            // f64: movq xmm0, rcx; movq xmm1, rax; SSE2 op; movq rax, xmm0
            em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1)  // movq xmm0, rcx
            em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)  // movq xmm1, rax
            if op == 19 { em(0xf2); em(0x0f); em(0x59); em(0xc1) }  // mulsd xmm0, xmm1
            if op == 20 { em(0xf2); em(0x0f); em(0x5e); em(0xc1) }  // divsd xmm0, xmm1
            if op == 29 {
                // modulo: no f64 path, fall back to integer
                em(0x48); em(0x87); em(0xc1); em(0x48); em(0x99); em(0x48); em(0xf7); em(0xf9); em(0x48); em(0x89); em(0xd0)
            }
            em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)  // movq rax, xmm0
            EXPR_IS_F64 = 1
            EXPR_TY = 2
        } else {
            em(0x48); em(0x87); em(0xc1)  // xchg rax, rcx — rax=lhs, rcx=rhs
            if op == 19 { em(0x48); em(0x0f); em(0xaf); em(0xc1) }  // imul rax, rcx
            if op == 20 { em(0x48); em(0x99); em(0x48); em(0xf7); em(0xf9) }  // cqo; idiv rcx
            if op == 29 { em(0x48); em(0x99); em(0x48); em(0xf7); em(0xf9); em(0x48); em(0x89); em(0xd0) }  // cqo; idiv rcx; mov rax, rdx
            EXPR_TY = 1
        }
        EXPR_TY_HASH = 0
    }
}

fn compile_additive() with IO, Mut, Panic, Div {
    compile_multiplicative()
    while TK[EP as usize] == 17 || TK[EP as usize] == 18 {
        let op_tok = EP
        let op = TK[EP as usize]
        EP = EP + 1
        let left_f64 = EXPR_IS_F64
        let left_ty = EXPR_TY
        emit_push()
        compile_multiplicative()
        let right_ty = EXPR_TY
        if left_ty != 0 && right_ty != 0 {
            if ty_is_numeric(left_ty) == false || ty_is_numeric(right_ty) == false || left_ty != right_ty {
                tc_error(op_tok, "arithmetic operands must have matching numeric types")
            }
        }
        em(0x59)  // pop rcx (lhs)
        if left_f64 == 1 {
            // f64: movq xmm0, rcx; movq xmm1, rax; SSE2 op; movq rax, xmm0
            em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1)  // movq xmm0, rcx
            em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)  // movq xmm1, rax
            if op == 17 { em(0xf2); em(0x0f); em(0x58); em(0xc1) }  // addsd xmm0, xmm1
            if op == 18 { em(0xf2); em(0x0f); em(0x5c); em(0xc1) }  // subsd xmm0, xmm1
            em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)  // movq rax, xmm0
            EXPR_IS_F64 = 1
            EXPR_TY = 2
        } else {
            if op == 17 { em(0x48); em(0x01); em(0xc8) }  // add rax, rcx (commutative: rcx+rax = ok)
            if op == 18 { em(0x48); em(0x87); em(0xc1); em(0x48); em(0x29); em(0xc8) }  // xchg; sub rax, rcx
            EXPR_TY = 1
        }
        EXPR_TY_HASH = 0
    }
}

// Shift: << (40), >> (39)
fn compile_shift() with IO, Mut, Panic, Div {
    compile_additive()
    while TK[EP as usize] == 39 || TK[EP as usize] == 40 {
        let op_tok = EP
        let op = TK[EP as usize]
        EP = EP + 1
        let left_ty = EXPR_TY
        emit_push()
        compile_additive()
        let right_ty = EXPR_TY
        if left_ty != 0 && left_ty != 1 { tc_error(op_tok, "shift requires integer operands") }
        if right_ty != 0 && right_ty != 1 { tc_error(op_tok, "shift requires integer operands") }
        // rax=rhs (shift amount), stack=lhs
        em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (shift amount in cl)
        em(0x58)  // pop rax (lhs)
        if op == 40 { em(0x48); em(0xd3); em(0xe0) }  // shl rax, cl
        if op == 39 { em(0x48); em(0xd3); em(0xf8) }  // sar rax, cl
        EXPR_TY = 1
        EXPR_TY_HASH = 0
    }
}

// Bitwise AND: & (44)
fn compile_bitand() with IO, Mut, Panic, Div {
    compile_shift()
    while TK[EP as usize] == 44 {
        let op_tok = EP
        let left_ty = EXPR_TY
        EP = EP + 1; emit_push(); compile_shift()
        if left_ty != 0 && left_ty != 1 { tc_error(op_tok, "bitwise and requires integer operands") }
        if EXPR_TY != 0 && EXPR_TY != 1 { tc_error(op_tok, "bitwise and requires integer operands") }
        em(0x59); em(0x48); em(0x21); em(0xc8)  // pop rcx; and rax, rcx
        EXPR_TY = 1
        EXPR_TY_HASH = 0
    }
}

// Bitwise XOR: ^ (56)
fn compile_bitxor() with IO, Mut, Panic, Div {
    compile_bitand()
    while TK[EP as usize] == 56 {
        let op_tok = EP
        let left_ty = EXPR_TY
        EP = EP + 1; emit_push(); compile_bitand()
        if left_ty != 0 && left_ty != 1 { tc_error(op_tok, "bitwise xor requires integer operands") }
        if EXPR_TY != 0 && EXPR_TY != 1 { tc_error(op_tok, "bitwise xor requires integer operands") }
        em(0x59); em(0x48); em(0x31); em(0xc8)  // pop rcx; xor rax, rcx
        EXPR_TY = 1
        EXPR_TY_HASH = 0
    }
}

// Bitwise OR: | (45)
fn compile_bitor() with IO, Mut, Panic, Div {
    compile_bitxor()
    while TK[EP as usize] == 45 {
        let op_tok = EP
        let left_ty = EXPR_TY
        EP = EP + 1; emit_push(); compile_bitxor()
        if left_ty != 0 && left_ty != 1 { tc_error(op_tok, "bitwise or requires integer operands") }
        if EXPR_TY != 0 && EXPR_TY != 1 { tc_error(op_tok, "bitwise or requires integer operands") }
        em(0x59); em(0x48); em(0x09); em(0xc8)  // pop rcx; or rax, rcx
        EXPR_TY = 1
        EXPR_TY_HASH = 0
    }
}

fn compile_comparison() with IO, Mut, Panic, Div {
    compile_bitor()
    let op = TK[EP as usize]
    if op == 21 || op == 22 || op == 23 || op == 24 || op == 25 || op == 26 {
        let op_tok = EP
        let left_f64 = EXPR_IS_F64
        let left_ty = EXPR_TY
        let left_hash = EXPR_TY_HASH
        EP = EP + 1
        emit_push()
        compile_bitor()
        let right_ty = EXPR_TY
        let right_hash = EXPR_TY_HASH
        if op == 21 || op == 22 {
            if ty_eq(left_ty, left_hash, right_ty, right_hash) == false {
                tc_error(op_tok, "comparison operands must have the same type")
            }
        } else {
            if left_ty != 0 && right_ty != 0 {
                if ty_is_numeric(left_ty) == false || ty_is_numeric(right_ty) == false || left_ty != right_ty {
                    tc_error(op_tok, "ordered comparison requires matching numeric operands")
                }
            }
        }
        em(0x59)  // pop rcx (lhs)
        if left_f64 == 1 {
            // f64: movq xmm0, rcx (lhs); movq xmm1, rax (rhs); ucomisd xmm0, xmm1
            em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1)  // movq xmm0, rcx
            em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)  // movq xmm1, rax
            em(0x66); em(0x0f); em(0x2e); em(0xc1)            // ucomisd xmm0, xmm1
            // Use unsigned conditional sets for FP comparison
            if op == 21 { em(0x0f); em(0x94); em(0xc0) }  // sete al (==)
            if op == 22 { em(0x0f); em(0x95); em(0xc0) }  // setne al (!=)
            if op == 23 { em(0x0f); em(0x92); em(0xc0) }  // setb al (<)
            if op == 24 { em(0x0f); em(0x97); em(0xc0) }  // seta al (>)
            if op == 25 { em(0x0f); em(0x96); em(0xc0) }  // setbe al (<=)
            if op == 26 { em(0x0f); em(0x93); em(0xc0) }  // setae al (>=)
        } else {
            em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
            if op == 21 { em(0x0f); em(0x94); em(0xc0) }  // sete al
            if op == 22 { em(0x0f); em(0x95); em(0xc0) }  // setne al
            if op == 23 { em(0x0f); em(0x9c); em(0xc0) }  // setl al
            if op == 24 { em(0x0f); em(0x9f); em(0xc0) }  // setg al
            if op == 25 { em(0x0f); em(0x9e); em(0xc0) }  // setle al
            if op == 26 { em(0x0f); em(0x9d); em(0xc0) }  // setge al
        }
        em(0x48); em(0x0f); em(0xb6); em(0xc0)  // movzx rax, al
        EXPR_IS_F64 = 0
        EXPR_TY = 4
        EXPR_TY_HASH = 0
    }
}

// Logical AND: && (30) — short-circuit
fn compile_and() with IO, Mut, Panic, Div {
    compile_comparison()
    while TK[EP as usize] == 30 {
        let op_tok = EP
        let left_ty = EXPR_TY
        EP = EP + 1
        if left_ty != 0 && left_ty != 4 { tc_error(op_tok, "logical and requires bool operands") }
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x0f); em(0x84)             // je short_false (rel32)
        let patch = CL; em32(0)
        compile_comparison()
        if EXPR_TY != 0 && EXPR_TY != 4 { tc_error(op_tok, "logical and requires bool operands") }
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x0f); em(0x95); em(0xc0)  // setne al
        em(0x48); em(0x0f); em(0xb6); em(0xc0)  // movzx rax, al
        em(0xe9); let end_patch = CL; em32(0)  // jmp end
        // short_false: rax already 0
        let here = CL
        CD[patch as usize] = ((here - patch - 4) & 0xFF) as i8
        CD[(patch+1) as usize] = (((here - patch - 4) >> 8) & 0xFF) as i8
        CD[(patch+2) as usize] = (((here - patch - 4) >> 16) & 0xFF) as i8
        CD[(patch+3) as usize] = (((here - patch - 4) >> 24) & 0xFF) as i8
        em(0x31); em(0xc0)  // xor eax, eax
        let end = CL
        CD[end_patch as usize] = ((end - end_patch - 4) & 0xFF) as i8
        CD[(end_patch+1) as usize] = (((end - end_patch - 4) >> 8) & 0xFF) as i8
        CD[(end_patch+2) as usize] = (((end - end_patch - 4) >> 16) & 0xFF) as i8
        CD[(end_patch+3) as usize] = (((end - end_patch - 4) >> 24) & 0xFF) as i8
        EXPR_TY = 4
        EXPR_TY_HASH = 0
    }
}

// Logical OR: || (31) — short-circuit
fn compile_or() with IO, Mut, Panic, Div {
    compile_and()
    while TK[EP as usize] == 31 {
        let op_tok = EP
        let left_ty = EXPR_TY
        EP = EP + 1
        if left_ty != 0 && left_ty != 4 { tc_error(op_tok, "logical or requires bool operands") }
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x0f); em(0x85)             // jne short_true (rel32)
        let patch = CL; em32(0)
        compile_and()
        if EXPR_TY != 0 && EXPR_TY != 4 { tc_error(op_tok, "logical or requires bool operands") }
        em(0xe9); let end_patch = CL; em32(0)  // jmp end
        // short_true: result = 1
        let here = CL
        CD[patch as usize] = ((here - patch - 4) & 0xFF) as i8
        CD[(patch+1) as usize] = (((here - patch - 4) >> 8) & 0xFF) as i8
        CD[(patch+2) as usize] = (((here - patch - 4) >> 16) & 0xFF) as i8
        CD[(patch+3) as usize] = (((here - patch - 4) >> 24) & 0xFF) as i8
        em(0x48); em(0xb8); em64(1)
        let end = CL
        CD[end_patch as usize] = ((end - end_patch - 4) & 0xFF) as i8
        CD[(end_patch+1) as usize] = (((end - end_patch - 4) >> 8) & 0xFF) as i8
        CD[(end_patch+2) as usize] = (((end - end_patch - 4) >> 16) & 0xFF) as i8
        CD[(end_patch+3) as usize] = (((end - end_patch - 4) >> 24) & 0xFF) as i8
        EXPR_TY = 4
        EXPR_TY_HASH = 0
    }
}

// ─── Patch helper ───
fn patch32(off: i64, target: i64) with Mut, Panic {
    let rel = target - off - 4
    CD[off as usize] = (rel & 0xFF) as i8
    CD[(off+1) as usize] = ((rel >> 8) & 0xFF) as i8
    CD[(off+2) as usize] = ((rel >> 16) & 0xFF) as i8
    CD[(off+3) as usize] = ((rel >> 24) & 0xFF) as i8
}

var TUP_PAT_NEXT: i64 = 0
var TUP_RHS_NEXT: i64 = 0

fn tuple_bind_leaf_x86(ns: i64, ne: i64) with Mut, Panic, Div {
    let slot = var_add(ns, ne)
    let vix = VAR_COUNT - 1
    emit_store_var(slot)
    VAR_IS_F64[vix as usize] = EXPR_IS_F64
    VAR_TY[vix as usize] = EXPR_TY
    VAR_TY_HASH[vix as usize] = EXPR_TY_HASH
    if VAR_TY[vix as usize] == 8 {
        VAR_ALEN[vix as usize] = arr_hash_alen(VAR_TY_HASH[vix as usize])
        VAR_ESIZ[vix as usize] = arr_hash_esiz(VAR_TY_HASH[vix as usize])
    }
    VAR_IS_CLOSURE[vix as usize] = LAST_EXPR_IS_CLOSURE
    VAR_LINEAR[vix as usize] = LAST_EXPR_IS_LINEAR
}

fn tuple_bind_leaf_a64(ns: i64, ne: i64) with Mut, Panic, Div {
    let slot = var_add(ns, ne)
    let vix = VAR_COUNT - 1
    emit_store_var_a64(slot)
    VAR_IS_F64[vix as usize] = EXPR_IS_F64
    VAR_TY[vix as usize] = EXPR_TY
    VAR_TY_HASH[vix as usize] = EXPR_TY_HASH
    if VAR_TY[vix as usize] == 8 {
        VAR_ALEN[vix as usize] = arr_hash_alen(VAR_TY_HASH[vix as usize])
        VAR_ESIZ[vix as usize] = arr_hash_esiz(VAR_TY_HASH[vix as usize])
    }
    VAR_IS_CLOSURE[vix as usize] = LAST_EXPR_IS_CLOSURE
    VAR_LINEAR[vix as usize] = LAST_EXPR_IS_LINEAR
}

fn tuple_skip_value_x86() with IO, Mut, Panic, Div {
    if TK[EP as usize] == 6 {
        EP = EP + 1
        while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
            tuple_skip_value_x86()
            if TK[EP as usize] == 28 { EP = EP + 1 }
        }
        if TK[EP as usize] == 7 { EP = EP + 1 }
        EXPR_TY = 0
        EXPR_TY_HASH = 0
        EXPR_IS_F64 = 0
        return
    }
    compile_or()
}

fn tuple_skip_value_a64() with IO, Mut, Panic, Div {
    if TK[EP as usize] == 6 {
        EP = EP + 1
        while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
            tuple_skip_value_a64()
            if TK[EP as usize] == 28 { EP = EP + 1 }
        }
        if TK[EP as usize] == 7 { EP = EP + 1 }
        EXPR_TY = 0
        EXPR_TY_HASH = 0
        EXPR_IS_F64 = 0
        return
    }
    compile_or_a64()
}

fn tuple_bind_pattern_x86(pp0: i64, rp0: i64) with IO, Mut, Panic, Div {
    var pp = pp0
    var rp = rp0
    if TK[pp as usize] != 6 || TK[rp as usize] != 6 {
        tc_error(pp0, "tuple destructure shape mismatch")
        TUP_PAT_NEXT = pp
        TUP_RHS_NEXT = rp
        return
    }
    pp = pp + 1
    rp = rp + 1
    while TK[pp as usize] != 7 && TK[pp as usize] != 0 {
        if TK[pp as usize] == 6 {
            if TK[rp as usize] != 6 {
                tc_error(pp, "tuple destructure shape mismatch")
                EP = rp
                tuple_skip_value_x86()
                rp = EP
                while TK[pp as usize] != 7 && TK[pp as usize] != 0 { pp = pp + 1 }
            } else {
                tuple_bind_pattern_x86(pp, rp)
                pp = TUP_PAT_NEXT
                rp = TUP_RHS_NEXT
            }
        } else {
            let pns = TS[pp as usize]
            let pne = TE[pp as usize]
            var is_wild: i64 = 0
            if pne - pns == 1 && sb(pns) == 95 { is_wild = 1 }
            pp = pp + 1
            EP = rp
            if is_wild == 1 {
                tuple_skip_value_x86()
                rp = EP
            } else {
                if TK[rp as usize] == 6 {
                    tc_error(pp - 1, "tuple destructure shape mismatch")
                    tuple_skip_value_x86()
                    rp = EP
                } else {
                    compile_or()
                    rp = EP
                    tuple_bind_leaf_x86(pns, pne)
                }
            }
        }
        if TK[pp as usize] == 28 { pp = pp + 1 }
        if TK[rp as usize] == 28 { rp = rp + 1 }
    }
    if TK[pp as usize] != 7 || TK[rp as usize] != 7 { tc_error(pp0, "tuple destructure arity mismatch") }
    if TK[pp as usize] == 7 { pp = pp + 1 }
    if TK[rp as usize] == 7 { rp = rp + 1 }
    TUP_PAT_NEXT = pp
    TUP_RHS_NEXT = rp
}

fn tuple_bind_pattern_a64(pp0: i64, rp0: i64) with IO, Mut, Panic, Div {
    var pp = pp0
    var rp = rp0
    if TK[pp as usize] != 6 || TK[rp as usize] != 6 {
        tc_error(pp0, "tuple destructure shape mismatch")
        TUP_PAT_NEXT = pp
        TUP_RHS_NEXT = rp
        return
    }
    pp = pp + 1
    rp = rp + 1
    while TK[pp as usize] != 7 && TK[pp as usize] != 0 {
        if TK[pp as usize] == 6 {
            if TK[rp as usize] != 6 {
                tc_error(pp, "tuple destructure shape mismatch")
                EP = rp
                tuple_skip_value_a64()
                rp = EP
                while TK[pp as usize] != 7 && TK[pp as usize] != 0 { pp = pp + 1 }
            } else {
                tuple_bind_pattern_a64(pp, rp)
                pp = TUP_PAT_NEXT
                rp = TUP_RHS_NEXT
            }
        } else {
            let pns = TS[pp as usize]
            let pne = TE[pp as usize]
            var is_wild: i64 = 0
            if pne - pns == 1 && sb(pns) == 95 { is_wild = 1 }
            pp = pp + 1
            EP = rp
            if is_wild == 1 {
                tuple_skip_value_a64()
                rp = EP
            } else {
                if TK[rp as usize] == 6 {
                    tc_error(pp - 1, "tuple destructure shape mismatch")
                    tuple_skip_value_a64()
                    rp = EP
                } else {
                    compile_or_a64()
                    rp = EP
                    tuple_bind_leaf_a64(pns, pne)
                }
            }
        }
        if TK[pp as usize] == 28 { pp = pp + 1 }
        if TK[rp as usize] == 28 { rp = rp + 1 }
    }
    if TK[pp as usize] != 7 || TK[rp as usize] != 7 { tc_error(pp0, "tuple destructure arity mismatch") }
    if TK[pp as usize] == 7 { pp = pp + 1 }
    if TK[rp as usize] == 7 { rp = rp + 1 }
    TUP_PAT_NEXT = pp
    TUP_RHS_NEXT = rp
}

// ─── Statement compiler ───
fn compile_stmt() with IO, Mut, Panic, Div {
    let k = TK[EP as usize]
    LAST_STMT_HAS_VALUE = 0

    // Skip semicolons
    if k == 27 { EP = EP + 1; return }

    // let x = expr / var x = expr (with optional : type)
    if k == 11 || k == 12 {
        EP = EP + 1
        if TK[EP as usize] == 6 {
            let pat_start = EP
            var pat_p = EP
            var pat_depth: i64 = 0
            while pat_p < TC {
                if TK[pat_p as usize] == 6 { pat_depth = pat_depth + 1 }
                if TK[pat_p as usize] == 7 {
                    pat_depth = pat_depth - 1
                    pat_p = pat_p + 1
                    if pat_depth == 0 { break }
                    continue
                }
                pat_p = pat_p + 1
            }
            EP = pat_p
            if TK[EP as usize] == 16 { EP = EP + 1 }
            if TK[EP as usize] != 6 { tc_error(EP, "tuple destructuring requires tuple literal") }
            tuple_bind_pattern_x86(pat_start, EP)
            EP = TUP_RHS_NEXT
            return
        }
        let ns = TS[EP as usize]
        let ne = TE[EP as usize]
        EP = EP + 1
        // Check for : type annotation
        var is_arr: i64 = 0
        var arr_len: i64 = 0
        var arr_esiz: i64 = 8
        var decl_is_f64: i64 = -1
        var decl_ty: i64 = 0
        var decl_ty_hash: i64 = 0
        if TK[EP as usize] == 43 {
            EP = EP + 1  // skip :
            // Skip & or &!
            if TK[EP as usize] == 44 { EP = EP + 1 }
            if TK[EP as usize] == 32 { EP = EP + 1 }
            // Array type: [T; N] — detect and extract element type + length
            if TK[EP as usize] == 41 {
                EP = EP + 1  // skip [
                // Element type
                let etns = TS[EP as usize]
                let etne = TE[EP as usize]
                if src_match(etns, etne - etns, "i8") { arr_esiz = 1 }
                EP = EP + 1  // skip element type
                if TK[EP as usize] == 27 { EP = EP + 1 }  // skip ;
                arr_len = TV[EP as usize]
                EP = EP + 1  // skip N
                if TK[EP as usize] == 42 { EP = EP + 1 }  // skip ]
                is_arr = 1
                decl_ty = 8
                decl_ty_hash = arr_ty_hash(arr_len, arr_esiz)
                decl_is_f64 = 0
            } else {
                scan_type(EP)
                decl_ty = SCAN_TY
                decl_ty_hash = SCAN_TY_HASH
                if decl_ty == 2 { decl_is_f64 = 1 }
                else { decl_is_f64 = 0 }
                EP = SCAN_TY_NEXT
            }
        }
        // Skip = sign
        if TK[EP as usize] == 16 { EP = EP + 1 }
        if is_arr == 1 && arr_len > 0 {
            // Local array: allocate slots, skip initializer [0; N], store lea
            // Skip [0; N] or [val; N] initializer
            if TK[EP as usize] == 41 {
                EP = EP + 1  // skip [
                while TK[EP as usize] != 42 && TK[EP as usize] != 0 { EP = EP + 1 }
                if TK[EP as usize] == 42 { EP = EP + 1 }  // skip ]
            }
            let nslots = arr_len
            if arr_esiz == 1 { nslots = (arr_len + 7) / 8 }
            let ptr_slot = var_add_arr(ns, ne, nslots, arr_esiz)
            let arr_vi = VAR_COUNT - 1
            VAR_TY[arr_vi as usize] = 8
            VAR_TY_HASH[arr_vi as usize] = decl_ty_hash
            // Zero-init the array slots
            let base = ptr_slot - nslots
            var zi: i64 = 0
            while zi < nslots {
                em(0x48); em(0x31); em(0xc0)  // xor rax, rax
                emit_store_var(base + zi)
                zi = zi + 1
            }
            // Store lea (pointer to array start) in ptr_slot
            // Array slots are base..base+nslots-1, addresses [rbp-base*8]..[rbp-(base+nslots-1)*8]
            // Pointer must point to lowest address so arr[i] = [ptr + i*8] addresses upward
            em(0x48); em(0x8d); em(0x85)  // lea rax, [rbp + disp32]
            em32(0 - (base + nslots - 1) * 8)
            emit_store_var(ptr_slot)
        } else {
            compile_or()
            let slot = var_add(ns, ne)
            let vix = VAR_COUNT - 1
            if decl_ty != 0 && ty_eq(decl_ty, decl_ty_hash, EXPR_TY, EXPR_TY_HASH) == false {
                tc_error(EP - 1, "initializer type does not match declaration")
            }
            emit_store_var(slot)
            // Set f64 flag: explicit type annotation takes priority, else infer from RHS
            if decl_is_f64 == 1 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 1 }
            else if decl_is_f64 == 0 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 0 }
            else { VAR_IS_F64[(VAR_COUNT - 1) as usize] = EXPR_IS_F64 }
            if decl_ty != 0 {
                VAR_TY[vix as usize] = decl_ty
                VAR_TY_HASH[vix as usize] = decl_ty_hash
            } else {
                VAR_TY[vix as usize] = EXPR_TY
                VAR_TY_HASH[vix as usize] = EXPR_TY_HASH
            }
            if VAR_TY[vix as usize] == 8 {
                VAR_ALEN[vix as usize] = arr_hash_alen(VAR_TY_HASH[vix as usize])
                VAR_ESIZ[vix as usize] = arr_hash_esiz(VAR_TY_HASH[vix as usize])
            }
            // Set closure flag if RHS was a closure expression
            VAR_IS_CLOSURE[(VAR_COUNT - 1) as usize] = LAST_EXPR_IS_CLOSURE
            // Set linear flag if RHS was a linear struct literal
            VAR_LINEAR[(VAR_COUNT - 1) as usize] = LAST_EXPR_IS_LINEAR
        }
        return
    }

    // x.field = expr (struct field write)
    if k == 3 && TK[(EP + 1) as usize] == 50 && TK[(EP + 3) as usize] == 16 {
        let name_tok = EP
        let ns = TS[EP as usize]
        let ne = TE[EP as usize]
        EP = EP + 2  // skip name and .
        let fns = TS[EP as usize]
        let fne = TE[EP as usize]
        let fh = gl_name_hash(fns, fne)
        EP = EP + 1  // skip field name
        if TK[EP as usize] == 16 { EP = EP + 1 }  // skip =
        compile_or()  // value in rax
        em(0x50)  // push value
        // Load struct base pointer
        let slot = var_find(ns, ne)
        if slot >= 0 { emit_load_var(slot) }
        else {
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                em(0x48); em(0xb8); em64(addr)
            } else {
                tc_undefined_var(name_tok)
                em(0x31); em(0xc0)
            }
        }
        // rax = struct pointer. Find field offset and store.
        em(0x59)  // pop rcx (value)
        var si: i64 = 0
        while si < ST_COUNT {
            let off = st_field_offset(si, fh)
            if off >= 0 {
                if off == 0 { em(0x48); em(0x89); em(0x08) }  // mov [rax], rcx
                else { em(0x48); em(0x89); em(0x88); em32(off) }  // mov [rax+off], rcx
                si = ST_COUNT  // break
            }
            si = si + 1
        }
        return
    }

    // x = expr (local or global scalar assignment)
    if k == 3 && TK[(EP + 1) as usize] == 16 {
        let name_tok = EP
        let ns = TS[EP as usize]
        let ne = TE[EP as usize]
        EP = EP + 2
        compile_or()
        let rhs_ty = EXPR_TY
        let rhs_ty_hash = EXPR_TY_HASH
        let slot = var_find(ns, ne)
        if slot >= 0 {
            let ty_vi = var_find_idx(ns, ne)
            if ty_vi >= 0 {
                if ty_eq(VAR_TY[ty_vi as usize], VAR_TY_HASH[ty_vi as usize], rhs_ty, rhs_ty_hash) == false {
                    tc_error(EP - 1, "assignment type mismatch")
                }
            }
            emit_store_var(slot)
            // Update closure flag on reassignment
            var vi: i64 = VAR_COUNT - 1
            while vi >= 0 {
                if name_eq(VAR_NS[vi as usize], VAR_NE[vi as usize], ns, ne) {
                    VAR_IS_CLOSURE[vi as usize] = LAST_EXPR_IS_CLOSURE
                    vi = -1  // break
                }
                vi = vi - 1
            }
        }
        else {
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                if ty_eq(GL_TY[gi as usize], GL_TY_HASH[gi as usize], rhs_ty, rhs_ty_hash) == false {
                    tc_error(EP - 1, "assignment type mismatch")
                }
                let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                // mov rcx, rax; mov rax, addr; mov [rax], rcx
                em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (value)
                em(0x48); em(0xb8); em64(addr)  // mov rax, addr
                em(0x48); em(0x89); em(0x08)    // mov [rax], rcx
            } else {
                tc_undefined_var(name_tok)
            }
        }
        return
    }
    // ARRAY[idx] = expr (global array write)
    if stmt_is_array_store(EP) {
        let name_tok = EP
        let ns = TS[EP as usize]
        let ne = TE[EP as usize]
        EP = EP + 2  // skip name and [
        compile_or()  // index in rax
        if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }  // skip 'as usize'
        if TK[EP as usize] == 42 { EP = EP + 1 }  // skip ]
        if TK[EP as usize] == 16 { EP = EP + 1 }  // skip =
        em(0x50)  // push index
        compile_or()  // value in rax
        let gi = gl_find(ns, ne)
        if gi >= 0 {
            let base = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
            let esz = GL[(gi * 4 + 2) as usize]
            // rax = value, stack = index
            em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (value)
            em(0x59)  // pop rcx (index)
            em(0x48); em(0xb8); em64(base)  // mov rax, base
            if esz == 8 {
                em(0x48); em(0x89); em(0x14); em(0xc8)  // mov [rax + rcx*8], rdx
            } else {
                em(0x88); em(0x14); em(0x08)  // mov [rax + rcx], dl (byte store)
            }
        } else {
            // Local array store: ptr[idx] = val
            let lslot = var_find(ns, ne)
            if lslot >= 0 {
                let llalen = var_find_alen(ns, ne)
                let lesiz = var_find_esiz(ns, ne)
                em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (value)
                em(0x59)  // pop rcx (index)
                emit_load_var(lslot)  // load base ptr into rax
                if llalen > 0 && lesiz == 8 {
                    em(0x48); em(0x89); em(0x14); em(0xc8)  // mov [rax + rcx*8], rdx
                } else if llalen > 0 && lesiz == 1 {
                    em(0x88); em(0x14); em(0x08)  // mov [rax + rcx], dl
                } else {
                    // Non-array local pointer: byte store
                    em(0x88); em(0x14); em(0x08)  // mov [rax + rcx], dl
                }
            } else {
                tc_undefined_var(name_tok)
                em(0x59)  // discard pushed index
            }
        }
        return
    }

    // return expr
    if k == 2 {
        EP = EP + 1
        if TK[EP as usize] != 9 {
            compile_or()
        }
        else {
            em(0x31); em(0xc0)
            EXPR_TY = 5
            EXPR_TY_HASH = 0
        }
        if ty_eq(CURRENT_RET_TY, CURRENT_RET_HASH, EXPR_TY, EXPR_TY_HASH) == false {
            tc_error(EP - 1, "return type does not match function signature")
        }
        em(0x48); em(0x81); em(0xc4); em32(4096)
        em(0x5d); em(0xc3)
        return
    }

    // continue (33)
    if k == 33 {
        EP = EP + 1
        if LOOP_DEPTH > 0 {
            em(0xe9)
            let rel = LOOP_TOP[(LOOP_DEPTH - 1) as usize] - (CL + 4)
            em32(rel)
        }
        return
    }

    // break (34) — emit jmp rel32 placeholder, patched when while loop ends
    if k == 34 {
        EP = EP + 1
        em(0xe9)  // jmp rel32
        BREAK_PATCH[BREAK_COUNT as usize] = CL
        BREAK_COUNT = BREAK_COUNT + 1
        em32(0)  // placeholder — patched by while handler
        return
    }

    // if expr { stmts } else if ... / else { stmts }
    if k == 13 {
        EP = EP + 1
        compile_or()
        if EXPR_TY != 0 && EXPR_TY != 4 { tc_error(EP - 1, "if condition must be bool") }
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x0f); em(0x84)
        let je_off = CL; em32(0)
        if TK[EP as usize] == 8 { EP = EP + 1 }
        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
        if TK[EP as usize] == 9 { EP = EP + 1 }
        if TK[EP as usize] == 14 {
            EP = EP + 1
            em(0xe9)
            let jmp_off = CL; em32(0)
            patch32(je_off, CL)
            // else if: recurse into compile_stmt which handles 'if'
            if TK[EP as usize] == 13 {
                compile_stmt()
            } else {
                if TK[EP as usize] == 8 { EP = EP + 1 }
                while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
                if TK[EP as usize] == 9 { EP = EP + 1 }
            }
            patch32(jmp_off, CL)
        } else {
            patch32(je_off, CL)
        }
        return
    }

    // while expr { stmts }
    if k == 15 {
        EP = EP + 1
        let loop_top = CL
        LOOP_TOP[LOOP_DEPTH as usize] = loop_top
        LOOP_DEPTH = LOOP_DEPTH + 1
        let saved_bc = BREAK_COUNT
        compile_or()
        if EXPR_TY != 0 && EXPR_TY != 4 { tc_error(EP - 1, "while condition must be bool") }
        em(0x48); em(0x85); em(0xc0)
        em(0x0f); em(0x84)
        let je_off = CL; em32(0)
        if TK[EP as usize] == 8 { EP = EP + 1 }
        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
        if TK[EP as usize] == 9 { EP = EP + 1 }
        em(0xe9)
        em32(loop_top - (CL + 4))
        patch32(je_off, CL)
        // Patch all break jumps from this loop to point here
        var bi: i64 = saved_bc
        while bi < BREAK_COUNT { patch32(BREAK_PATCH[bi as usize], CL); bi = bi + 1 }
        BREAK_COUNT = saved_bc
        LOOP_DEPTH = LOOP_DEPTH - 1
        return
    }

    // for IDENT in range(START, END) { body }
    // Desugars to: var IDENT = START; while IDENT < END { body; IDENT = IDENT + 1 }
    if k == 54 {
        EP = EP + 1  // skip 'for'
        let vns = TS[EP as usize]
        let vne = TE[EP as usize]
        EP = EP + 1  // skip loop var name
        EP = EP + 1  // skip 'in'
        EP = EP + 1  // skip 'range'
        if TK[EP as usize] == 6 { EP = EP + 1 }  // skip (
        compile_or()  // START in rax
        if EXPR_TY != 0 && EXPR_TY != 1 { tc_error(EP - 1, "for range start must be integer") }
        let iter_slot = var_add(vns, vne)
        VAR_TY[(VAR_COUNT - 1) as usize] = 1
        VAR_TY_HASH[(VAR_COUNT - 1) as usize] = 0
        emit_store_var(iter_slot)
        if TK[EP as usize] == 28 { EP = EP + 1 }  // skip comma
        compile_or()  // END in rax
        if EXPR_TY != 0 && EXPR_TY != 1 { tc_error(EP - 1, "for range end must be integer") }
        let end_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        emit_store_var(end_slot)
        if TK[EP as usize] == 7 { EP = EP + 1 }  // skip )
        // while iter < end
        let loop_top = CL
        LOOP_TOP[LOOP_DEPTH as usize] = loop_top
        LOOP_DEPTH = LOOP_DEPTH + 1
        let saved_bc = BREAK_COUNT
        emit_load_var(iter_slot)
        em(0x50)  // push iter
        emit_load_var(end_slot)
        em(0x59)  // pop rcx (iter)
        em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
        em(0x0f); em(0x9c); em(0xc0)  // setl al
        em(0x48); em(0x0f); em(0xb6); em(0xc0)  // movzx rax, al
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x0f); em(0x84)
        let je_off = CL; em32(0)
        if TK[EP as usize] == 8 { EP = EP + 1 }  // skip {
        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
        if TK[EP as usize] == 9 { EP = EP + 1 }  // skip }
        // iter = iter + 1
        emit_load_var(iter_slot)
        em(0x48); em(0x83); em(0xc0); em(1)  // add rax, 1
        emit_store_var(iter_slot)
        em(0xe9)
        em32(loop_top - (CL + 4))
        patch32(je_off, CL)
        var bi: i64 = saved_bc
        while bi < BREAK_COUNT { patch32(BREAK_PATCH[bi as usize], CL); bi = bi + 1 }
        BREAK_COUNT = saved_bc
        LOOP_DEPTH = LOOP_DEPTH - 1
        return
    }

    // match expr { pattern => body, ... }
    // 48 = match keyword
    if k == 48 {
        EP = EP + 1
        compile_or()  // scrutinee in rax
        // Store scrutinee in a local var (not stack — return inside arm would break stack)
        let match_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        emit_store_var(match_slot)
        if TK[EP as usize] == 8 { EP = EP + 1 }  // skip {
        var arm_count: i64 = 0
        var match_ty: i64 = 0
        var match_hash: i64 = 0
        var match_have_ty: i64 = 0
        var match_all_value: i64 = 1
        var match_arms: i64 = 0
        while TK[EP as usize] != 9 && TK[EP as usize] != 0 {
            var is_wildcard: i64 = 0
            var disc: i64 = -1
            var arm_is_tagged: i64 = 0
            var bind_ns: i64 = 0
            var bind_ne: i64 = 0
            var has_binding: i64 = 0
            let arm_tk = TK[EP as usize]
            // Some(v) pattern — tag=1, bind inner value
            if arm_tk == 57 {
                EP = EP + 1
                disc = 1
                arm_is_tagged = 1
                if TK[EP as usize] == 6 {
                    EP = EP + 1
                    bind_ns = TS[EP as usize]
                    bind_ne = TE[EP as usize]
                    has_binding = 1
                    EP = EP + 1
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                }
            }
            // None pattern — tag=0
            if arm_tk == 58 {
                EP = EP + 1
                disc = 0
                arm_is_tagged = 1
            }
            // Ok(v) pattern — tag=0, bind payload
            if arm_tk == 59 {
                EP = EP + 1
                disc = 0
                arm_is_tagged = 1
                if TK[EP as usize] == 6 {
                    EP = EP + 1
                    bind_ns = TS[EP as usize]
                    bind_ne = TE[EP as usize]
                    has_binding = 1
                    EP = EP + 1
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                }
            }
            // Err(e) pattern — tag=1, bind payload
            if arm_tk == 60 {
                EP = EP + 1
                disc = 1
                arm_is_tagged = 1
                if TK[EP as usize] == 6 {
                    EP = EP + 1
                    bind_ns = TS[EP as usize]
                    bind_ne = TE[EP as usize]
                    has_binding = 1
                    EP = EP + 1
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                }
            }
            if arm_tk == 3 {
                let pns = TS[EP as usize]
                let pne = TE[EP as usize]
                if pne - pns == 1 && sb(pns) == 95 {
                    is_wildcard = 1; EP = EP + 1
                } else if TK[(EP + 1) as usize] == 51 {
                    let eh = gl_name_hash(pns, pne)
                    EP = EP + 2
                    let vh = gl_name_hash(TS[EP as usize], TE[EP as usize])
                    EP = EP + 1
                    disc = en_variant_value(eh, vh)
                } else { EP = EP + 1 }
            }
            if arm_tk == 4 {
                disc = TV[EP as usize]; EP = EP + 1
            }
            if arm_tk != 57 && arm_tk != 58 && arm_tk != 59 && arm_tk != 60 && arm_tk != 3 && arm_tk != 4 { EP = EP + 1 }
            if disc >= 0 {
                if arm_is_tagged == 1 {
                    // Tagged union match: load tag from [scrutinee + 0]
                    emit_load_var(match_slot)
                    em(0x48); em(0x8b); em(0x00)  // mov rax, [rax] (tag)
                    em(0x50)  // push tag
                    em(0x48); em(0xb8); em64(disc)
                    em(0x59)  // pop rcx (tag)
                    em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
                    em(0x0f); em(0x85); let skip_patch = CL; em32(0)  // jne skip
                    // Bind inner value if pattern has binding
                    if has_binding == 1 {
                        emit_load_var(match_slot)
                        em(0x48); em(0x8b); em(0x40); em(0x08)  // mov rax, [rax + 8] (value)
                        let bslot = var_add(bind_ns, bind_ne)
                        emit_store_var(bslot)
                    }
                    if TK[EP as usize] == 52 { EP = EP + 1 }  // skip =>
                    var arm_has_block: i64 = 0
                    if TK[EP as usize] == 8 { arm_has_block = 1; EP = EP + 1 }
                    LAST_STMT_HAS_VALUE = 0
                    if arm_has_block == 1 {
                        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
                        if TK[EP as usize] == 9 { EP = EP + 1 }
                    } else {
                        compile_stmt()
                    }
                    match_arms = match_arms + 1
                    if LAST_STMT_HAS_VALUE == 1 {
                        if match_have_ty == 0 {
                            match_have_ty = 1
                            match_ty = LAST_STMT_TY
                            match_hash = LAST_STMT_TY_HASH
                        } else if ty_eq(match_ty, match_hash, LAST_STMT_TY, LAST_STMT_TY_HASH) == false {
                            tc_error(EP - 1, "match arm type does not match other arms")
                        }
                    } else {
                        match_all_value = 0
                    }
                    em(0xe9); MATCH_ENDS[arm_count as usize] = CL; em32(0)
                    arm_count = arm_count + 1
                    patch32(skip_patch, CL)
                } else {
                    // Plain enum/integer match: compare scrutinee directly
                    emit_load_var(match_slot)
                    em(0x50)
                    em(0x48); em(0xb8); em64(disc)
                    em(0x59)
                    em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
                    em(0x0f); em(0x85); let skip_patch = CL; em32(0)  // jne skip
                    if TK[EP as usize] == 52 { EP = EP + 1 }  // skip =>
                    var arm_has_block2: i64 = 0
                    if TK[EP as usize] == 8 { arm_has_block2 = 1; EP = EP + 1 }
                    LAST_STMT_HAS_VALUE = 0
                    if arm_has_block2 == 1 {
                        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
                        if TK[EP as usize] == 9 { EP = EP + 1 }
                    } else {
                        compile_stmt()
                    }
                    match_arms = match_arms + 1
                    if LAST_STMT_HAS_VALUE == 1 {
                        if match_have_ty == 0 {
                            match_have_ty = 1
                            match_ty = LAST_STMT_TY
                            match_hash = LAST_STMT_TY_HASH
                        } else if ty_eq(match_ty, match_hash, LAST_STMT_TY, LAST_STMT_TY_HASH) == false {
                            tc_error(EP - 1, "match arm type does not match other arms")
                        }
                    } else {
                        match_all_value = 0
                    }
                    em(0xe9); MATCH_ENDS[arm_count as usize] = CL; em32(0)
                    arm_count = arm_count + 1
                    patch32(skip_patch, CL)
                }
            }
            if is_wildcard == 1 {
                if TK[EP as usize] == 52 { EP = EP + 1 }
                var arm_has_block3: i64 = 0
                if TK[EP as usize] == 8 { arm_has_block3 = 1; EP = EP + 1 }
                LAST_STMT_HAS_VALUE = 0
                if arm_has_block3 == 1 {
                    while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
                    if TK[EP as usize] == 9 { EP = EP + 1 }
                } else {
                    compile_stmt()
                }
                match_arms = match_arms + 1
                if LAST_STMT_HAS_VALUE == 1 {
                    if match_have_ty == 0 {
                        match_have_ty = 1
                        match_ty = LAST_STMT_TY
                        match_hash = LAST_STMT_TY_HASH
                    } else if ty_eq(match_ty, match_hash, LAST_STMT_TY, LAST_STMT_TY_HASH) == false {
                        tc_error(EP - 1, "match arm type does not match other arms")
                    }
                } else {
                    match_all_value = 0
                }
            }
            if TK[EP as usize] == 28 { EP = EP + 1 }
        }
        if TK[EP as usize] == 9 { EP = EP + 1 }
        var ai: i64 = 0
        while ai < arm_count { patch32(MATCH_ENDS[ai as usize], CL); ai = ai + 1 }
        if match_arms > 0 && match_all_value == 1 && match_have_ty == 1 {
            LAST_STMT_HAS_VALUE = 1
            LAST_STMT_TY = match_ty
            LAST_STMT_TY_HASH = match_hash
            EXPR_TY = match_ty
            EXPR_TY_HASH = match_hash
            if match_ty == 2 { EXPR_IS_F64 = 1 }
            else { EXPR_IS_F64 = 0 }
        }
        return
    }

    // Expression statement
    compile_or()
    LAST_STMT_HAS_VALUE = 1
    LAST_STMT_TY = EXPR_TY
    LAST_STMT_TY_HASH = EXPR_TY_HASH
}

// ─── Top-level compiler ───
// ─── Monomorphization pass ───
// Scans for generic fn/struct declarations, finds instantiation sites,
// generates specialized token copies. Separate function to limit stack usage.
fn mono_pass() with IO, Mut, Panic, Div {
    GEN_FN_COUNT = 0
    GEN_ST_COUNT = 0
    MONO_COUNT = 0
    // Pass 0c: scan generic function and struct declarations
    var p: i64 = 0
    while p < TC {
        // fn NAME < TPARAM > (
        if TK[p as usize] == 1 && p + 4 < TC && TK[(p + 2) as usize] == 23 && TK[(p + 4) as usize] == 24 {
            let gi = GEN_FN_COUNT
            GEN_FN_NS[gi as usize] = TS[(p + 1) as usize]
            GEN_FN_NE[gi as usize] = TE[(p + 1) as usize]
            GEN_FN_TP_S[gi as usize] = TS[(p + 3) as usize]
            GEN_FN_TP_E[gi as usize] = TE[(p + 3) as usize]
            GEN_FN_BDY_S[gi as usize] = p
            var q: i64 = p + 5
            while q < TC && TK[q as usize] != 8 { q = q + 1 }
            var bd: i64 = 1
            q = q + 1
            while q < TC && bd > 0 { if TK[q as usize] == 8 { bd = bd + 1 }; if TK[q as usize] == 9 { bd = bd - 1 }; q = q + 1 }
            GEN_FN_BDY_E[gi as usize] = q
            GEN_FN_COUNT = GEN_FN_COUNT + 1
            p = q
            continue
        }
        // struct NAME < TPARAM > {
        if TK[p as usize] == 46 && p + 4 < TC && TK[(p + 2) as usize] == 23 && TK[(p + 4) as usize] == 24 {
            let gi = GEN_ST_COUNT
            GEN_ST_NS[gi as usize] = TS[(p + 1) as usize]
            GEN_ST_NE[gi as usize] = TE[(p + 1) as usize]
            GEN_ST_TP_S[gi as usize] = TS[(p + 3) as usize]
            GEN_ST_TP_E[gi as usize] = TE[(p + 3) as usize]
            GEN_ST_BDY_S[gi as usize] = p
            var q: i64 = p + 5
            while q < TC && TK[q as usize] != 9 { q = q + 1 }
            q = q + 1
            GEN_ST_BDY_E[gi as usize] = q
            GEN_ST_COUNT = GEN_ST_COUNT + 1
            p = q
            continue
        }
        // pub/linear struct generics
        if (TK[p as usize] == 49 || TK[p as usize] == 62) && p + 5 < TC && TK[(p + 1) as usize] == 46 && TK[(p + 3) as usize] == 23 && TK[(p + 5) as usize] == 24 {
            let gi = GEN_ST_COUNT
            GEN_ST_NS[gi as usize] = TS[(p + 2) as usize]
            GEN_ST_NE[gi as usize] = TE[(p + 2) as usize]
            GEN_ST_TP_S[gi as usize] = TS[(p + 4) as usize]
            GEN_ST_TP_E[gi as usize] = TE[(p + 4) as usize]
            GEN_ST_BDY_S[gi as usize] = p
            var q: i64 = p + 6
            while q < TC && TK[q as usize] != 9 { q = q + 1 }
            q = q + 1
            GEN_ST_BDY_E[gi as usize] = q
            GEN_ST_COUNT = GEN_ST_COUNT + 1
            p = q
            continue
        }
        p = p + 1
    }
    if GEN_FN_COUNT > 0 || GEN_ST_COUNT > 0 {
        print("generics: fns="); print_int(GEN_FN_COUNT); print(" structs="); print_int(GEN_ST_COUNT); print("\n")
    }
    if GEN_FN_COUNT == 0 && GEN_ST_COUNT == 0 { return }
    // Pass 0d: find instantiation sites
    p = 0
    var in_gen: i64 = 0
    var ig: i64 = 0
    var d_gi: i64 = 0
    var d_cns: i64 = 0
    var d_cne: i64 = 0
    var d_tys: i64 = 0
    var d_tye: i64 = 0
    var d_mi: i64 = 0
    var d_ms: i64 = 0
    while p < TC {
        in_gen = 0
        ig = 0
        while ig < GEN_FN_COUNT { if p >= GEN_FN_BDY_S[ig as usize] && p < GEN_FN_BDY_E[ig as usize] { in_gen = 1 }; ig = ig + 1 }
        ig = 0
        while ig < GEN_ST_COUNT { if p >= GEN_ST_BDY_S[ig as usize] && p < GEN_ST_BDY_E[ig as usize] { in_gen = 1 }; ig = ig + 1 }
        if in_gen == 1 { p = p + 1; continue }
        if TK[p as usize] == 3 && p + 3 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 3) as usize] == 24 {
            d_cns = TS[p as usize]
            d_cne = TE[p as usize]
            d_tys = TS[(p + 2) as usize]
            d_tye = TE[(p + 2) as usize]
            d_gi = 0
            while d_gi < GEN_FN_COUNT {
                if name_eq(d_cns, d_cne, GEN_FN_NS[d_gi as usize], GEN_FN_NE[d_gi as usize]) {
                    if mono_find_inst(d_gi, 0, d_tys, d_tye) < 0 {
                        d_mi = MONO_COUNT
                        MONO_GEN[d_mi as usize] = d_gi
                        MONO_TY_S[d_mi as usize] = d_tys
                        MONO_TY_E[d_mi as usize] = d_tye
                        MONO_IS_ST[d_mi as usize] = 0
                        d_ms = mono_mangle(GEN_FN_NS[d_gi as usize], GEN_FN_NE[d_gi as usize], d_tys, d_tye)
                        MAN_BUF_S[d_mi as usize] = d_ms
                        MAN_BUF_E[d_mi as usize] = SRC_LEN
                        MONO_COUNT = MONO_COUNT + 1
                    }
                    d_gi = GEN_FN_COUNT
                }
                d_gi = d_gi + 1
            }
            d_gi = 0
            while d_gi < GEN_ST_COUNT {
                if name_eq(d_cns, d_cne, GEN_ST_NS[d_gi as usize], GEN_ST_NE[d_gi as usize]) {
                    if mono_find_inst(d_gi, 1, d_tys, d_tye) < 0 {
                        d_mi = MONO_COUNT
                        MONO_GEN[d_mi as usize] = d_gi
                        MONO_TY_S[d_mi as usize] = d_tys
                        MONO_TY_E[d_mi as usize] = d_tye
                        MONO_IS_ST[d_mi as usize] = 1
                        d_ms = mono_mangle(GEN_ST_NS[d_gi as usize], GEN_ST_NE[d_gi as usize], d_tys, d_tye)
                        MAN_BUF_S[d_mi as usize] = d_ms
                        MAN_BUF_E[d_mi as usize] = SRC_LEN
                        MONO_COUNT = MONO_COUNT + 1
                    }
                    d_gi = GEN_ST_COUNT
                }
                d_gi = d_gi + 1
            }
        }
        p = p + 1
    }
    // Generate specialized token copies
    var m_i: i64 = 0
    var m_gi: i64 = 0
    var m_is_st: i64 = 0
    var m_tys: i64 = 0
    var m_tye: i64 = 0
    var m_mns: i64 = 0
    var m_mne: i64 = 0
    var m_bs: i64 = 0
    var m_be: i64 = 0
    var m_tps: i64 = 0
    var m_tpe: i64 = 0
    var m_gns: i64 = 0
    var m_gne: i64 = 0
    var m_ti: i64 = 0
    var m_skip: i64 = 0
    var m_tk: i64 = 0
    var m_tts: i64 = 0
    var m_tte: i64 = 0
    while m_i < MONO_COUNT {
        m_gi = MONO_GEN[m_i as usize]
        m_is_st = MONO_IS_ST[m_i as usize]
        m_tys = MONO_TY_S[m_i as usize]
        m_tye = MONO_TY_E[m_i as usize]
        m_mns = MAN_BUF_S[m_i as usize]
        m_mne = MAN_BUF_E[m_i as usize]
        m_bs = 0
        m_be = 0
        m_tps = 0
        m_tpe = 0
        m_gns = 0
        m_gne = 0
        if m_is_st == 0 {
            m_bs = GEN_FN_BDY_S[m_gi as usize]
            m_be = GEN_FN_BDY_E[m_gi as usize]
            m_tps = GEN_FN_TP_S[m_gi as usize]
            m_tpe = GEN_FN_TP_E[m_gi as usize]
            m_gns = GEN_FN_NS[m_gi as usize]
            m_gne = GEN_FN_NE[m_gi as usize]
        } else {
            m_bs = GEN_ST_BDY_S[m_gi as usize]
            m_be = GEN_ST_BDY_E[m_gi as usize]
            m_tps = GEN_ST_TP_S[m_gi as usize]
            m_tpe = GEN_ST_TP_E[m_gi as usize]
            m_gns = GEN_ST_NS[m_gi as usize]
            m_gne = GEN_ST_NE[m_gi as usize]
        }
        m_ti = m_bs
        m_skip = 0
        while m_ti < m_be && TC < 32760 {
            m_tk = TK[m_ti as usize]
            m_tts = TS[m_ti as usize]
            m_tte = TE[m_ti as usize]
            if m_skip == 0 && m_tk == 23 && m_ti > m_bs && name_eq(TS[(m_ti - 1) as usize], TE[(m_ti - 1) as usize], m_gns, m_gne) {
                m_ti = m_ti + 3
                m_skip = 1
                continue
            }
            if m_tk == 3 && name_eq(m_tts, m_tte, m_gns, m_gne) {
                TK[TC as usize] = 3
                TS[TC as usize] = m_mns
                TE[TC as usize] = m_mne
                TV[TC as usize] = 0
                TL[TC as usize] = TL[m_ti as usize]
                TC = TC + 1
                m_ti = m_ti + 1
                continue
            }
            if m_tk == 3 && name_eq(m_tts, m_tte, m_tps, m_tpe) {
                TK[TC as usize] = 3
                TS[TC as usize] = m_tys
                TE[TC as usize] = m_tye
                TV[TC as usize] = 0
                TL[TC as usize] = TL[m_ti as usize]
                TC = TC + 1
                m_ti = m_ti + 1
                continue
            }
            TK[TC as usize] = m_tk
            TS[TC as usize] = m_tts
            TE[TC as usize] = m_tte
            TV[TC as usize] = TV[m_ti as usize]
            TF[TC as usize] = TF[m_ti as usize]
            TD[TC as usize] = TD[m_ti as usize]
            TL[TC as usize] = TL[m_ti as usize]
            TC = TC + 1
            m_ti = m_ti + 1
        }
        m_i = m_i + 1
    }
    // Re-add EOF token and re-scan monomorphized structs
    if MONO_COUNT > 0 {
        TK[TC as usize] = 0
        TC = TC + 1
        print("mono: "); print_int(MONO_COUNT); print(" specializations, tokens="); print_int(TC); print("\n")
        // Re-scan for monomorphized struct declarations
        p = 0
        while p < TC {
            if TK[p as usize] == 46 || TK[p as usize] == 49 || TK[p as usize] == 62 {
                if TK[p as usize] == 49 || TK[p as usize] == 62 { p = p + 1 }
                if TK[p as usize] == 46 {
                    p = p + 1
                    let rsn_ns = TS[p as usize]
                    let rsn_ne = TE[p as usize]
                    let rsh = gl_name_hash(rsn_ns, rsn_ne)
                    if st_find(rsh) < 0 {
                        let rsi = ST_COUNT
                        let rbase = rsi * 66
                        ST[rbase as usize] = rsh
                        p = p + 1
                        if TK[p as usize] == 23 { p = p + 1; while TK[p as usize] != 9 && TK[p as usize] != 0 { p = p + 1 }; if TK[p as usize] == 9 { p = p + 1 }; ST[(rbase + 1) as usize] = 0; ST_COUNT = ST_COUNT + 1; continue }
                        if TK[p as usize] == 8 { p = p + 1 }
                        var rfc: i64 = 0
                        while TK[p as usize] != 9 && TK[p as usize] != 0 {
                            if TK[p as usize] == 3 {
                                let rfh = gl_name_hash(TS[p as usize], TE[p as usize])
                                let rffi = rfc
                                ST[(rbase + 2 + rfc) as usize] = rfh
                                p = p + 1
                                if TK[p as usize] == 43 {
                                    p = p + 1
                                    scan_type(p)
                                    ST_FTY[(rsi * 64 + rffi) as usize] = SCAN_TY
                                    ST_FHASH[(rsi * 64 + rffi) as usize] = SCAN_TY_HASH
                                    p = SCAN_TY_NEXT
                                } else {
                                    ST_FTY[(rsi * 64 + rffi) as usize] = 0
                                    ST_FHASH[(rsi * 64 + rffi) as usize] = 0
                                }
                                rfc = rfc + 1
                                if TK[p as usize] == 28 { p = p + 1 }
                                continue
                            }
                            p = p + 1
                        }
                        ST[(rbase + 1) as usize] = rfc
                        ST_COUNT = ST_COUNT + 1
                    }
                    if TK[p as usize] == 9 { p = p + 1 }
                    continue
                }
            }
            p = p + 1
        }
    }
}

fn compile_all() -> i64 with IO, Mut, Panic, Div {
    CL = 0
    FN_COUNT = 0
    PATCH_COUNT = 0
    GL_COUNT = 0
    GL_BSS_SIZE = 0
    TYPECHECK_FAILED = 0
    var p: i64 = 0

    // Pass 0a: register structs
    ST_COUNT = 0
    while p < TC {
        if TK[p as usize] == 46 || TK[p as usize] == 49 || TK[p as usize] == 62 {
            // struct or pub/linear keyword — skip pub/linear prefix, track linear
            var is_linear_decl: i64 = 0
            if TK[p as usize] == 62 { is_linear_decl = 1 }
            if TK[p as usize] == 49 || TK[p as usize] == 62 { p = p + 1 }
            if TK[p as usize] == 46 {
                p = p + 1  // skip 'struct'
                let sn_ns = TS[p as usize]
                let sn_ne = TE[p as usize]
                p = p + 1  // skip name
                // Generic templates still need field layouts for inferred struct literals.
                if TK[p as usize] == 23 {
                    while TK[p as usize] != 24 && TK[p as usize] != 0 { p = p + 1 }
                    if TK[p as usize] == 24 { p = p + 1 }
                }
                let sh = gl_name_hash(sn_ns, sn_ne)
                let si = ST_COUNT
                let base = si * 66
                ST[base as usize] = sh
                if TK[p as usize] == 8 { p = p + 1 }  // skip {
                var fc: i64 = 0
                while TK[p as usize] != 9 && TK[p as usize] != 0 {
                    if TK[p as usize] == 3 {
                        let fh = gl_name_hash(TS[p as usize], TE[p as usize])
                        let ffi = fc
                        ST[(base + 2 + fc) as usize] = fh
                        p = p + 1
                        // Skip : type
                        if TK[p as usize] == 43 {
                            p = p + 1
                            scan_type(p)
                            ST_FTY[(si * 64 + ffi) as usize] = SCAN_TY
                            ST_FHASH[(si * 64 + ffi) as usize] = SCAN_TY_HASH
                            p = SCAN_TY_NEXT
                        } else {
                            ST_FTY[(si * 64 + ffi) as usize] = 0
                            ST_FHASH[(si * 64 + ffi) as usize] = 0
                        }
                        fc = fc + 1
                        // Skip comma
                        if TK[p as usize] == 28 { p = p + 1 }
                        continue
                    }
                    p = p + 1
                }
                ST[(base + 1) as usize] = fc
                ST_LINEAR[si as usize] = is_linear_decl
                ST_COUNT = ST_COUNT + 1
                if TK[p as usize] == 9 { p = p + 1 }
                continue
            }
        }
        p = p + 1
    }
    // Also scan enums in the same pass
    p = 0
    EN_COUNT = 0
    while p < TC {
        if TK[p as usize] == 47 {
            p = p + 1  // skip 'enum'
            let en_ns = TS[p as usize]
            let en_ne = TE[p as usize]
            let eh = gl_name_hash(en_ns, en_ne)
            let ei = EN_COUNT
            let base = ei * 34
            EN[base as usize] = eh
            p = p + 1  // skip name
            if TK[p as usize] == 8 { p = p + 1 }  // skip {
            var vc: i64 = 0
            var inner_depth: i64 = 0
            while p < TC && (TK[p as usize] != 9 || inner_depth > 0) {
                if TK[p as usize] == 8 {
                    inner_depth = inner_depth + 1
                    p = p + 1
                    continue
                }
                if TK[p as usize] == 9 {
                    inner_depth = inner_depth - 1
                    p = p + 1
                    continue
                }
                if inner_depth == 0 && TK[p as usize] == 3 {
                    let vh = gl_name_hash(TS[p as usize], TE[p as usize])
                    EN[(base + 2 + vc) as usize] = vh
                    vc = vc + 1
                }
                p = p + 1
            }
            EN[(base + 1) as usize] = vc
            EN_COUNT = EN_COUNT + 1
            if TK[p as usize] == 9 { p = p + 1 }
            continue
        }
        p = p + 1
    }
    p = 0

    // Pass 0c+0d: monomorphization (in separate function to limit stack usage)
    mono_pass()
    p = 0
    // Pass 0b: register global variables
    var depth: i64 = 0
    while p < TC {
        let tk = TK[p as usize]
        if tk == 8 { depth = depth + 1; p = p + 1; continue }
        if tk == 9 { depth = depth - 1; p = p + 1; continue }
        if depth > 0 { p = p + 1; continue }
        // Top-level var
        if tk == 12 {
            p = p + 1
            let gns = TS[p as usize]
            let gne = TE[p as usize]
            p = p + 1
            // Expect : type
            if TK[p as usize] == 43 {
                p = p + 1
                let tns = TS[p as usize]
                let tne = TE[p as usize]
                // Check if [TYPE; N] array
                if TK[p as usize] == 41 {
                    // [TYPE; N]
                    p = p + 1
                    let etns = TS[p as usize]
                    let etne = TE[p as usize]
                    var esiz: i64 = 8
                    if src_match(etns, etne - etns, "i8") { esiz = 1 }
                    p = p + 1
                    // Skip ;
                    if TK[p as usize] == 27 { p = p + 1 }
                    // Array length
                    let alen = TV[p as usize]
                    p = p + 1
                    // Skip ]
                    if TK[p as usize] == 42 { p = p + 1 }
                    let gix = GL_COUNT
                    gl_add(gns, gne, esiz, alen)
                    GL_TY[gix as usize] = 8
                    GL_TY_HASH[gix as usize] = esiz
                } else {
                    // Scalar: i64, i32, bool, string
                    scan_type(p)
                    let gix = GL_COUNT
                    gl_add(gns, gne, 8, 0)
                    GL_TY[gix as usize] = SCAN_TY
                    GL_TY_HASH[gix as usize] = SCAN_TY_HASH
                    p = SCAN_TY_NEXT
                }
            }
            // Skip = initializer until next var or fn or EOF
            while p < TC && TK[p as usize] != 12 && TK[p as usize] != 1 && TK[p as usize] != 0 { p = p + 1 }
            continue
        }
        p = p + 1
    }
    p = 0

    // BSS layout: [argc(8)] [argv(8)] [globals...]
    // Add 16 to BSS_BASE so globals start at BSS+16, but argc/argv at BSS+0
    if TARGET_OS == 2 {
        GL_BSS_BASE = 0x100008000 + 16    // macOS: __DATA segment at 0x100008000
    } else {
        GL_BSS_BASE = 0x600000 + 16       // Linux/Windows: BSS at 0x600000
    }
    GL_BSS_SIZE = GL_BSS_SIZE + 16

    print("globals: "); print_int(GL_COUNT); print(" bss="); print_int(GL_BSS_SIZE); print("\n")

    // Pass 1: register all function names (skip generic templates)
    while p < TC {
        if TK[p as usize] == 1 {
            p = p + 1
            if p + 2 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 3) as usize] == 24 { p = p + 1; continue }
            FN_NS[FN_COUNT as usize] = TS[p as usize]
            FN_NE[FN_COUNT as usize] = TE[p as usize]
            FN_OFF[FN_COUNT as usize] = -1
            FN_COUNT = FN_COUNT + 1
        }
        p = p + 1
    }

    p = 0
    var sig_fi: i64 = 0
    while p < TC {
        if TK[p as usize] == 1 {
            p = p + 1
            if p + 2 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 3) as usize] == 24 { p = p + 1; continue }
            FN_ARITY[sig_fi as usize] = 0
            FN_RET_TY[sig_fi as usize] = 5
            FN_RET_HASH[sig_fi as usize] = 0
            var q: i64 = p + 1
            if TK[q as usize] == 6 { q = q + 1 }
            while TK[q as usize] != 7 && TK[q as usize] != 0 {
                if TK[q as usize] == 3 {
                    FN_ARITY[sig_fi as usize] = FN_ARITY[sig_fi as usize] + 1
                    q = q + 1
                    if TK[q as usize] == 43 {
                        q = q + 1
                        scan_type(q)
                        q = SCAN_TY_NEXT
                    }
                } else {
                    q = q + 1
                }
                if TK[q as usize] == 28 { q = q + 1 }
            }
            if TK[q as usize] == 7 { q = q + 1 }
            if TK[q as usize] == 10 {
                q = q + 1
                scan_type(q)
                FN_RET_TY[sig_fi as usize] = SCAN_TY
                FN_RET_HASH[sig_fi as usize] = SCAN_TY_HASH
                q = SCAN_TY_NEXT
            }
            if sig_fi < FN_COUNT { sig_fi = sig_fi + 1 }
        }
        p = p + 1
    }

    // Pass 1b: scan effects clauses for each function
    // For each fn at index fi, scan forward from its name token to find 'with' (38)
    // and record effect bitmask: IO=1, Mut=2, Panic=4, Div=8, Alloc=16
    p = 0
    var eff_fi: i64 = 0
    while p < TC {
        if TK[p as usize] == 1 {
            p = p + 1
            // Skip generic templates
            if p + 2 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 3) as usize] == 24 { p = p + 1; continue }
            // Scan forward to find { (start of body) — effects are between ) -> type with ... {
            var eq: i64 = p + 1
            while eq < TC && TK[eq as usize] != 8 { eq = eq + 1 }
            // Now scan from p to eq for 'with' token (38)
            var ew: i64 = p
            while ew < eq {
                if TK[ew as usize] == 38 {
                    ew = ew + 1
                    while ew < eq && (TK[ew as usize] == 3 || TK[ew as usize] == 28) {
                        if TK[ew as usize] == 3 {
                            let ens = TS[ew as usize]
                            let ene = TE[ew as usize]
                            if src_match(ens, ene - ens, "IO") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 1 }
                            if src_match(ens, ene - ens, "Mut") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 2 }
                            if src_match(ens, ene - ens, "Panic") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 4 }
                            if src_match(ens, ene - ens, "Div") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 8 }
                            if src_match(ens, ene - ens, "Alloc") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 16 }
                        }
                        ew = ew + 1
                    }
                    ew = eq  // done scanning
                }
                ew = ew + 1
            }
            if eff_fi < FN_COUNT { eff_fi = eff_fi + 1 }
        }
        p = p + 1
    }
    print("effects: scanned "); print_int(eff_fi); print(" functions\n")

    // Pass 1c: scan top-level type aliases (token 61)
    p = 0
    var tdepth: i64 = 0
    while p < TC {
        let ttk = TK[p as usize]
        if ttk == 8 { tdepth = tdepth + 1; p = p + 1; continue }
        if ttk == 9 { tdepth = tdepth - 1; p = p + 1; continue }
        if tdepth > 0 { p = p + 1; continue }
        if ttk == 61 {
            // type NAME = ...
            p = p + 1
            if p < TC && TK[p as usize] == 3 {
                let tnh = gl_name_hash(TS[p as usize], TE[p as usize])
                if REF_TYPE_COUNT < 32 {
                    REF_TYPE_HASH[REF_TYPE_COUNT as usize] = tnh
                    REF_TYPE_COUNT = REF_TYPE_COUNT + 1
                }
                p = p + 1
            }
            // Skip = and everything to next top-level declaration
            while p < TC && TK[p as usize] != 1 && TK[p as usize] != 12 && TK[p as usize] != 46 && TK[p as usize] != 47 && TK[p as usize] != 61 && TK[p as usize] != 0 { p = p + 1 }
            continue
        }
        p = p + 1
    }
    if REF_TYPE_COUNT > 0 { print("types: "); print_int(REF_TYPE_COUNT); print(" aliases\n") }

    // Pass 2: compile each function
    p = 0
    var fn_idx: i64 = 0
    while p < TC {
        if TK[p as usize] != 1 { p = p + 1; continue }
        p = p + 1  // skip 'fn'

        // Skip generic function templates
        if p + 2 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 3) as usize] == 24 {
            while p < TC && TK[p as usize] != 8 { p = p + 1 }
            var gd: i64 = 1
            p = p + 1
            while p < TC && gd > 0 { if TK[p as usize] == 8 { gd = gd + 1 }; if TK[p as usize] == 9 { gd = gd - 1 }; p = p + 1 }
            continue
        }

        // Record code offset + set current function for effects checking
        FN_OFF[fn_idx as usize] = CL
        CURRENT_FN = fn_idx
        CURRENT_RET_TY = FN_RET_TY[fn_idx as usize]
        CURRENT_RET_HASH = FN_RET_HASH[fn_idx as usize]

        // Reset local vars
        VAR_COUNT = 0
        NEXT_SLOT = 1
        BREAK_COUNT = 0
        LAST_STMT_HAS_VALUE = 0
        LAST_STMT_TY = 0
        LAST_STMT_TY_HASH = 0

        // Register parameters
        p = p + 1  // skip name
        if TK[p as usize] == 6 { p = p + 1 }
        while TK[p as usize] != 7 && TK[p as usize] != 0 {
            if TK[p as usize] == 3 {
                let pns = TS[p as usize]
                let pne = TE[p as usize]
                let pslot = var_add(pns, pne)
                p = p + 1
                // Skip : type annotation (handles &T, &!T, [T; N], simple T)
                if TK[p as usize] == 43 {
                    p = p + 1  // skip :
                    scan_type(p)
                    VAR_TY[(VAR_COUNT - 1) as usize] = SCAN_TY
                    VAR_TY_HASH[(VAR_COUNT - 1) as usize] = SCAN_TY_HASH
                    if SCAN_TY == 2 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 1 }
                    if SCAN_TY == 8 {
                        VAR_ALEN[(VAR_COUNT - 1) as usize] = SCAN_TY_ALEN
                        VAR_ESIZ[(VAR_COUNT - 1) as usize] = SCAN_TY_ESIZ
                    }
                    p = SCAN_TY_NEXT
                }
            }
            if TK[p as usize] == 28 { p = p + 1 }
        }
        if TK[p as usize] == 7 { p = p + 1 }
        // Skip -> type
        if TK[p as usize] == 10 {
            p = p + 1
            scan_type(p)
            p = SCAN_TY_NEXT
        }
        // Skip 'with' effects clause (with=38, ident=3, comma=28)
        if TK[p as usize] == 38 { p = p + 1; while TK[p as usize] == 3 || TK[p as usize] == 28 { p = p + 1 } }
        if TK[p as usize] == 8 { p = p + 1 }

        // Emit prologue: push rbp; mov rbp, rsp; sub rsp, 512
        print_int(fn_idx)
        print(" ")
        em(0x55); em(0x48); em(0x89); em(0xe5)
        em(0x48); em(0x81); em(0xec); em32(4096)

        // Store parameters from registers to stack slots (System V ABI: rdi,rsi,rdx,rcx,r8,r9)
        if VAR_COUNT >= 1 { em(0x48); em(0x89); em(0x7d); em(0xf8 as i64 & 0xFF) }    // mov [rbp-8], rdi
        if VAR_COUNT >= 2 { em(0x48); em(0x89); em(0x75); em(0xf0 as i64 & 0xFF) }    // mov [rbp-16], rsi
        if VAR_COUNT >= 3 { em(0x48); em(0x89); em(0x55); em(0xe8 as i64 & 0xFF) }    // mov [rbp-24], rdx
        if VAR_COUNT >= 4 { em(0x48); em(0x89); em(0x4d); em(0xe0 as i64 & 0xFF) }    // mov [rbp-32], rcx
        if VAR_COUNT >= 5 { em(0x4c); em(0x89); em(0x45); em(0xd8 as i64 & 0xFF) }    // mov [rbp-40], r8
        if VAR_COUNT >= 6 { em(0x4c); em(0x89); em(0x4d); em(0xd0 as i64 & 0xFF) }    // mov [rbp-48], r9

        // Compile body
        EP = p
        var depth: i64 = 1
        while EP < TC && depth > 0 {
            if TK[EP as usize] == 9 { depth = depth - 1; if depth == 0 { EP = EP + 1; continue } else { EP = EP + 1; continue } }
            compile_stmt()
        }
        p = EP

        // Linear type check: warn if any linear variable was not used exactly once
        var lci: i64 = 0
        while lci < VAR_COUNT {
            if VAR_LINEAR[lci as usize] == 1 {
                if VAR_USED[lci as usize] == 0 {
                    print("warning: linear var#")
                    print_int(lci)
                    print(" in fn#")
                    print_int(fn_idx)
                    print(" never used (must use exactly once)\n")
                }
                if VAR_USED[lci as usize] > 1 {
                    print("warning: linear var#")
                    print_int(lci)
                    print(" in fn#")
                    print_int(fn_idx)
                    print(" used ")
                    print_int(VAR_USED[lci as usize])
                    print(" times (must use exactly once)\n")
                }
            }
            lci = lci + 1
        }

        // Implicit return 0
        if CL > 0 && CD[(CL - 1) as usize] != 0xc3 as i8 {
            if LAST_STMT_HAS_VALUE == 1 {
                if ty_eq(CURRENT_RET_TY, CURRENT_RET_HASH, LAST_STMT_TY, LAST_STMT_TY_HASH) == false {
                    tc_error(EP - 1, "tail expression type does not match function signature")
                }
            }
            if LAST_STMT_HAS_VALUE == 0 {
                em(0x31); em(0xc0)
            }
            em(0x48); em(0x81); em(0xc4); em32(4096)
            em(0x5d); em(0xc3)
        }
        fn_idx = fn_idx + 1
    }

    if TYPECHECK_FAILED != 0 {
        print("typecheck: failed\n")
        return 1
    }

    // Patch function calls
    var pi: i64 = 0
    while pi < PATCH_COUNT {
        let off = PATCH_OFF[pi as usize]
        let fi = PATCH_FN[pi as usize]
        if fi >= 0 && fi < FN_COUNT {
            let target = FN_OFF[fi as usize]
            let rel = target - (off + 4)
            CD[(off) as usize] = (rel & 0xFF) as i8
            CD[(off + 1) as usize] = ((rel >> 8) & 0xFF) as i8
            CD[(off + 2) as usize] = ((rel >> 16) & 0xFF) as i8
            CD[(off + 3) as usize] = ((rel >> 24) & 0xFF) as i8
        }
        pi = pi + 1
    }

    // Find main
    var main_fn: i64 = -1
    var mi: i64 = 0
    while mi < FN_COUNT {
        let ms = FN_NS[mi as usize]
        let me = FN_NE[mi as usize]
        if me - ms == 4 && sb(ms) == 109 && sb(ms+1) == 97 && sb(ms+2) == 105 && sb(ms+3) == 110 { main_fn = mi }
        mi = mi + 1
    }
    if main_fn < 0 { print("error: no main\n"); return 1 }

    // Trampoline: save argc/argv, call main, exit
    TRAMP_OFF = CL
    let tramp = CL

    if TARGET_OS == 3 {
        // Windows PE trampoline: call main, then ExitProcess(rax) via IAT
        // No argc/argv on Windows MVP (would need GetCommandLineW)
        // sub rsp, 40 — align stack + shadow space
        em(0x48); em(0x83); em(0xEC); em(0x28)
        // call main
        em(0xe8)
        let wrel = FN_OFF[main_fn as usize] - (CL + 4)
        em32(wrel)
        // mov ecx, eax — exit code to RCX (Win64 first param)
        em(0x89); em(0xC1)
        // call [rip+disp32] — ExitProcess via IAT (disp32 patched by write_pe)
        PE_EXIT_CALL_OFF = CL + 2   // remember offset of disp32 for patching
        em(0xFF); em(0x15); em32(0)  // placeholder disp32
        // ud2 (should never reach)
        em(0x0F); em(0x0B)
    } else if TARGET_OS == 2 {
        // macOS x86_64 trampoline
        // macOS entry: same argc/argv layout as Linux
        let argc_addr = 0x100008000  // __DATA segment base
        let argv_addr = 0x100008000 + 8
        em(0x48); em(0x8b); em(0x04); em(0x24)  // mov rax, [rsp] (argc)
        em(0x48); em(0x83); em(0xe8); em(0x01)  // sub rax, 1
        em(0x48); em(0xb9); em64(argc_addr)
        em(0x48); em(0x89); em(0x01)  // mov [rcx], rax
        em(0x48); em(0x8d); em(0x44); em(0x24); em(16)  // lea rax, [rsp+16]
        em(0x48); em(0xb9); em64(argv_addr)
        em(0x48); em(0x89); em(0x01)  // mov [rcx], rax
        // call main
        em(0xe8)
        let mrel = FN_OFF[main_fn as usize] - (CL + 4)
        em32(mrel)
        // macOS exit: syscall 0x2000001
        em(0x89); em(0xc7)                     // mov edi, eax
        em(0x48); em(0xb8); em64(0x2000001)    // mov rax, 0x2000001
        em(0x0f); em(0x05)                     // syscall
    } else {
        // Linux trampoline
        let argc_addr = 0x600000
        let argv_addr = 0x600000 + 8
        em(0x48); em(0x8b); em(0x04); em(0x24)  // mov rax, [rsp] (argc)
        em(0x48); em(0x83); em(0xe8); em(0x01)  // sub rax, 1 (skip program name)
        em(0x48); em(0xb9); em64(argc_addr)
        em(0x48); em(0x89); em(0x01)  // mov [rcx], rax (save argc-1)
        em(0x48); em(0x8d); em(0x44); em(0x24); em(16)  // lea rax, [rsp+16] (argv+1)
        em(0x48); em(0xb9); em64(argv_addr)
        em(0x48); em(0x89); em(0x01)  // mov [rcx], rax (save argv ptr)
        // call main
        em(0xe8)
        let rel = FN_OFF[main_fn as usize] - (CL + 4)
        em32(rel)
        // exit(rax): Linux syscall 60
        em(0x89); em(0xc7)
        em(0xb8); em32(60)
        em(0x0f); em(0x05)
    }

    print("compile: fns="); print_int(FN_COUNT); print(" code="); print_int(CL)
    print(" main=fn"); print_int(main_fn); print(" patches="); print_int(PATCH_COUNT); print("\n")
    0
}

// ─── ELF byte writer helpers ───
fn elf_w8(off: i64, v: i64) with Mut, Panic { ELF[off as usize] = (v & 0xFF) as i8 }
fn elf_w16(off: i64, v: i64) with Mut, Panic { elf_w8(off, v); elf_w8(off+1, v >> 8) }
fn elf_w32(off: i64, v: i64) with Mut, Panic { elf_w16(off, v); elf_w16(off+2, v >> 16) }
fn elf_w64(off: i64, v: i64) with Mut, Panic { elf_w32(off, v); elf_w32(off+4, v >> 32) }

// ─── ELF writer (2 LOAD segments: text RX + BSS RW) ───
fn write_elf(output: string) -> i64 with IO, Mut, Panic, Div {
    let text_base = 0x400000
    let text_off = 4096
    let bss_base = 0x600000
    let entry = text_base + text_off + TRAMP_OFF
    var i: i64 = 0
    while i < 4096 { ELF[i as usize] = 0; i = i + 1 }

    let tsz = text_off + CL
    // Total memory: from text_base to bss_base + GL_BSS_SIZE
    let total_memsz = (bss_base - text_base) + GL_BSS_SIZE

    // ELF header (64 bytes)
    elf_w8(0, 0x7f); elf_w8(1, 69); elf_w8(2, 76); elf_w8(3, 70)
    elf_w8(4, 2); elf_w8(5, 1); elf_w8(6, 1)
    elf_w16(16, 2); elf_w16(18, 0x3e); elf_w32(20, 1)
    elf_w64(24, entry)
    elf_w64(32, 64)
    elf_w16(52, 64); elf_w16(54, 56); elf_w16(56, 1); elf_w16(58, 64)

    // Single LOAD segment: text(RX) + gap + BSS(RW) — all RWX
    let ph0 = 64
    elf_w32(ph0, 1)                 // PT_LOAD
    elf_w32(ph0+4, 7)               // p_flags = R+W+X
    elf_w64(ph0+8, 0)               // p_offset
    elf_w64(ph0+16, text_base)      // p_vaddr
    elf_w64(ph0+24, text_base)      // p_paddr
    elf_w64(ph0+32, tsz)            // p_filesz (text only)
    elf_w64(ph0+40, total_memsz)    // p_memsz (text + gap + BSS)
    elf_w64(ph0+48, 0x200000)       // p_align = 2MB (cover gap)

    // Copy code after header
    i = 0
    while i < CL { ELF[(text_off + i) as usize] = CD[i as usize]; i = i + 1 }

    let ok = write_file(output, ELF, tsz)
    print("elf: "); print(output); print(" "); print_int(tsz)
    print(" bytes (bss="); print_int(GL_BSS_SIZE); print(")\n")
    return 0
}

// ─── PE/COFF writer ───
// Builds a Windows PE32+ executable from compiled code in CD[0..CL].
// Image layout: image_base=0x400000, .text at RVA 0x1000, .idata at next page, .bss at 0x200000.
// This keeps BSS virtual address at 0x600000 = 0x400000 + 0x200000, matching ELF layout.
fn write_pe(output: string) -> i64 with IO, Mut, Panic, Div {
    let image_base = 0x400000
    let sec_align = 0x1000
    let file_align = 0x200
    let text_rva = sec_align                      // 0x1000
    let text_raw_size = ((CL + file_align - 1) / file_align) * file_align
    let idata_rva = text_rva + ((CL + sec_align - 1) / sec_align) * sec_align

    // .idata layout: 1 import descriptor (20) + null (20) + INT(2*8+8=24) + IAT(24) + hints + dll name
    let idt_off: i64 = 0
    let int_off: i64 = 40
    let iat_off: i64 = 64
    let hnt_ep_off: i64 = 88         // "ExitProcess" hint/name entry
    let dll_name_off: i64 = 104      // "kernel32.dll\0"
    let idata_total: i64 = 117       // 104 + 13
    let idata_raw_size = ((idata_total + file_align - 1) / file_align) * file_align

    let bss_rva = 0x200000            // .bss section: RVA so that VA = 0x600000
    let bss_vsize = GL_BSS_SIZE
    if bss_vsize < 4096 { let bss_vsize_min = 4096 }  // minimum 1 page

    // Patch ExitProcess IAT displacement in trampoline code
    // call [rip+disp32]: disp32 = IAT_slot_RVA - (text_RVA + instruction_end_offset)
    if PE_EXIT_CALL_OFF >= 0 {
        let call_end = PE_EXIT_CALL_OFF + 4
        let disp = (idata_rva + iat_off) - (text_rva + call_end)  // IAT slot 0 = ExitProcess
        CD[PE_EXIT_CALL_OFF as usize] = (disp & 0xFF) as i8
        CD[(PE_EXIT_CALL_OFF + 1) as usize] = ((disp >> 8) & 0xFF) as i8
        CD[(PE_EXIT_CALL_OFF + 2) as usize] = ((disp >> 16) & 0xFF) as i8
        CD[(PE_EXIT_CALL_OFF + 3) as usize] = ((disp >> 24) & 0xFF) as i8
    }

    // Headers: DOS(64) + PE sig(4) + COFF(20) + OptHdr(112) + DataDirs(128) + 3 section headers(3*40=120) = 448
    // Round up to file_align = 512
    let num_sections = 3   // .text, .idata, .bss
    let headers_size = 512
    let entry_rva = text_rva + TRAMP_OFF

    // Compute size_of_image: round up to section_alignment
    let bss_end_rva = bss_rva + ((bss_vsize + sec_align - 1) / sec_align) * sec_align
    let size_of_image = bss_end_rva

    print("pe_build: code="); print_int(CL); print(" text_raw="); print_int(text_raw_size); print(" idata_rva="); print_int(idata_rva); print("\n")
    var i: i64 = 0
    while i < 1048576 { ELF[i as usize] = 0; i = i + 1 }

    // DOS header (64 bytes)
    elf_w8(0, 0x4D); elf_w8(1, 0x5A)             // "MZ"
    elf_w32(60, 64)                                // e_lfanew → PE header at offset 64

    // PE signature
    elf_w8(64, 0x50); elf_w8(65, 0x45)            // "PE\0\0"

    // COFF header (20 bytes at offset 68)
    elf_w16(68, 0x8664)                            // Machine = AMD64
    elf_w16(70, num_sections)                      // NumberOfSections
    elf_w16(84, 240)                               // SizeOfOptionalHeader (PE32+ = 112 + data dirs)
    elf_w16(86, 0x22)                              // Characteristics: EXECUTABLE | LARGE_ADDRESS_AWARE

    // Optional header (PE32+) at offset 88
    elf_w16(88, 0x020B)                            // Magic = PE32+
    elf_w32(104, entry_rva)                        // AddressOfEntryPoint
    elf_w64(112, image_base)                       // ImageBase
    elf_w32(120, sec_align)                        // SectionAlignment
    elf_w32(124, file_align)                       // FileAlignment
    elf_w16(128, 6)                                // MajorOperatingSystemVersion
    elf_w16(136, 6)                                // MajorSubsystemVersion
    elf_w32(144, size_of_image)                    // SizeOfImage
    elf_w32(148, headers_size)                     // SizeOfHeaders
    elf_w16(156, 3)                                // Subsystem = WINDOWS_CUI
    elf_w16(158, 0x8160)                           // DllCharacteristics: NX | DYNAMIC_BASE | HIGH_ENTROPY_VA | TERMINAL_SERVER
    elf_w64(160, 0x100000)                         // SizeOfStackReserve = 1MB
    elf_w64(168, 0x1000)                           // SizeOfStackCommit = 4KB
    elf_w64(176, 0x100000)                         // SizeOfHeapReserve = 1MB
    elf_w64(184, 0x1000)                           // SizeOfHeapCommit = 4KB
    elf_w32(196, 16)                               // NumberOfRvaAndSizes

    // Data directories start at offset 200 (after 112 bytes of PE32+ optional header fields)
    // Import directory (index 1, offset 200 + 1*8 = 208)
    elf_w32(208, idata_rva + idt_off)              // VirtualAddress
    elf_w32(212, 40)                               // Size (1 descriptor + null)
    // IAT directory (index 12, offset 200 + 12*8 = 296)
    elf_w32(296, idata_rva + iat_off)              // VirtualAddress
    elf_w32(300, 24)                               // Size (2 entries + null = 24)

    // Section headers start at offset 328 (88 + 240)
    let sh_base = 328

    // .text section header
    elf_w8(sh_base, 0x2E); elf_w8(sh_base+1, 0x74); elf_w8(sh_base+2, 0x65)
    elf_w8(sh_base+3, 0x78); elf_w8(sh_base+4, 0x74)  // ".text"
    elf_w32(sh_base+8, CL)                         // VirtualSize
    elf_w32(sh_base+12, text_rva)                   // VirtualAddress
    elf_w32(sh_base+16, text_raw_size)              // SizeOfRawData
    elf_w32(sh_base+20, headers_size)               // PointerToRawData
    elf_w32(sh_base+36, 0x60000020)                 // Characteristics: CODE | EXECUTE | READ

    // .idata section header
    let sh1 = sh_base + 40
    elf_w8(sh1, 0x2E); elf_w8(sh1+1, 0x69); elf_w8(sh1+2, 0x64)
    elf_w8(sh1+3, 0x61); elf_w8(sh1+4, 0x74); elf_w8(sh1+5, 0x61)  // ".idata"
    elf_w32(sh1+8, idata_total)                     // VirtualSize
    elf_w32(sh1+12, idata_rva)                      // VirtualAddress
    elf_w32(sh1+16, idata_raw_size)                 // SizeOfRawData
    elf_w32(sh1+20, headers_size + text_raw_size)   // PointerToRawData
    elf_w32(sh1+36, 0xC0000040)                     // Characteristics: INITIALIZED_DATA | READ | WRITE

    // .bss section header
    let sh2 = sh_base + 80
    elf_w8(sh2, 0x2E); elf_w8(sh2+1, 0x62); elf_w8(sh2+2, 0x73); elf_w8(sh2+3, 0x73)  // ".bss"
    elf_w32(sh2+8, bss_vsize)                       // VirtualSize
    elf_w32(sh2+12, bss_rva)                        // VirtualAddress
    elf_w32(sh2+16, 0)                              // SizeOfRawData = 0 (uninitialized)
    elf_w32(sh2+20, 0)                              // PointerToRawData = 0
    elf_w32(sh2+36, 0xC0000080)                     // Characteristics: UNINITIALIZED_DATA | READ | WRITE

    // Copy .text section (code)
    i = 0
    while i < CL { ELF[(headers_size + i) as usize] = CD[i as usize]; i = i + 1 }

    // Pad .text to file alignment
    let text_end = headers_size + text_raw_size

    // Write .idata section
    let idata_file_off = text_end

    // Import descriptor for kernel32.dll (20 bytes)
    elf_w32(idata_file_off + 0, idata_rva + int_off)    // OriginalFirstThunk (INT RVA)
    elf_w32(idata_file_off + 12, idata_rva + dll_name_off)  // Name RVA
    elf_w32(idata_file_off + 16, idata_rva + iat_off)   // FirstThunk (IAT RVA)
    // Null terminator descriptor (20 bytes of zeros — already zero)

    // INT: ExitProcess entry + null (offset 40)
    elf_w64(idata_file_off + int_off, idata_rva + hnt_ep_off)  // → hint/name for ExitProcess
    // null terminator at int_off+8 (already zero)

    // IAT: same as INT (offset 64)
    elf_w64(idata_file_off + iat_off, idata_rva + hnt_ep_off)
    // null terminator at iat_off+8 (already zero)

    // Hint/Name entry for ExitProcess (offset 88): hint(2) + "ExitProcess\0"
    elf_w16(idata_file_off + hnt_ep_off, 0)              // hint = 0
    // "ExitProcess" = 69 78 69 74 50 72 6F 63 65 73 73 00
    elf_w8(idata_file_off + hnt_ep_off + 2, 0x45)   // E
    elf_w8(idata_file_off + hnt_ep_off + 3, 0x78)   // x
    elf_w8(idata_file_off + hnt_ep_off + 4, 0x69)   // i
    elf_w8(idata_file_off + hnt_ep_off + 5, 0x74)   // t
    elf_w8(idata_file_off + hnt_ep_off + 6, 0x50)   // P
    elf_w8(idata_file_off + hnt_ep_off + 7, 0x72)   // r
    elf_w8(idata_file_off + hnt_ep_off + 8, 0x6F)   // o
    elf_w8(idata_file_off + hnt_ep_off + 9, 0x63)   // c
    elf_w8(idata_file_off + hnt_ep_off + 10, 0x65)  // e
    elf_w8(idata_file_off + hnt_ep_off + 11, 0x73)  // s
    elf_w8(idata_file_off + hnt_ep_off + 12, 0x73)  // s

    // DLL name: "kernel32.dll\0" (offset 104)
    elf_w8(idata_file_off + dll_name_off + 0, 0x6B)   // k
    elf_w8(idata_file_off + dll_name_off + 1, 0x65)   // e
    elf_w8(idata_file_off + dll_name_off + 2, 0x72)   // r
    elf_w8(idata_file_off + dll_name_off + 3, 0x6E)   // n
    elf_w8(idata_file_off + dll_name_off + 4, 0x65)   // e
    elf_w8(idata_file_off + dll_name_off + 5, 0x6C)   // l
    elf_w8(idata_file_off + dll_name_off + 6, 0x33)   // 3
    elf_w8(idata_file_off + dll_name_off + 7, 0x32)   // 2
    elf_w8(idata_file_off + dll_name_off + 8, 0x2E)   // .
    elf_w8(idata_file_off + dll_name_off + 9, 0x64)   // d
    elf_w8(idata_file_off + dll_name_off + 10, 0x6C)  // l
    elf_w8(idata_file_off + dll_name_off + 11, 0x6C)  // l

    let total_file_size = idata_file_off + idata_raw_size
    let ok = write_file(output, ELF, total_file_size)
    print("pe: "); print(output); print(" "); print_int(total_file_size)
    print(" bytes\n")
    return 0
}

// ─── Mach-O x86_64 writer ───
// Builds a macOS Mach-O 64-bit executable.
// Layout: __PAGEZERO(0..4GB) + __TEXT(4GB.., code) + __DATA(4GB+0x8000, BSS)
fn write_macho_x86(output: string) -> i64 with IO, Mut, Panic, Div {
    let vm_base: i64 = 4294967296       // 0x100000000
    let page_size: i64 = 4096
    let text_vm = vm_base               // __TEXT vmaddr
    let data_vm = vm_base + 0x8000      // __DATA vmaddr (BSS)

    // Mach-O header: 32 bytes
    // Load commands: __PAGEZERO(72) + __TEXT(72+section*80=152) + __DATA(72+section*80=152) + LC_MAIN(24)
    let hdr_size = 32
    let lc_pagezero_size = 72
    let lc_text_size = 72 + 80          // segment + 1 section (__text)
    let lc_data_size = 72 + 80          // segment + 1 section (__bss)
    let lc_main_size = 24
    let ncmds = 4
    let sizeofcmds = lc_pagezero_size + lc_text_size + lc_data_size + lc_main_size

    let text_file_off = ((hdr_size + sizeofcmds + page_size - 1) / page_size) * page_size
    let text_file_size = ((CL + page_size - 1) / page_size) * page_size
    let total_file_size = text_file_off + text_file_size
    let text_seg_vmsize = text_file_off + text_file_size  // covers headers + code

    print("macho_build: code="); print_int(CL); print(" text_off="); print_int(text_file_off); print("\n")

    var i: i64 = 0
    while i < 1048576 { ELF[i as usize] = 0; i = i + 1 }

    // Mach-O header (32 bytes)
    elf_w32(0, 0xFEEDFACF)               // magic (64-bit)
    elf_w32(4, 0x01000007)                // cputype = x86_64
    elf_w32(8, 0x80000003)                // cpusubtype = ALL | LIB64
    elf_w32(12, 2)                        // filetype = MH_EXECUTE
    elf_w32(16, ncmds)                    // ncmds
    elf_w32(20, sizeofcmds)              // sizeofcmds
    elf_w32(24, 0x00200085)               // flags: NOUNDEFS | DYLDLINK | TWOLEVEL | PIE

    // LC_SEGMENT_64 __PAGEZERO (72 bytes at offset 32)
    var off = hdr_size
    elf_w32(off, 25)                      // cmd = LC_SEGMENT_64
    elf_w32(off+4, lc_pagezero_size)      // cmdsize
    // segname "__PAGEZERO" at off+8 (16 bytes)
    elf_w8(off+8, 95); elf_w8(off+9, 95)  // __
    elf_w8(off+10, 80); elf_w8(off+11, 65); elf_w8(off+12, 71); elf_w8(off+13, 69)  // PAGE
    elf_w8(off+14, 90); elf_w8(off+15, 69); elf_w8(off+16, 82); elf_w8(off+17, 79)  // ZERO
    elf_w64(off+24, 0)                    // vmaddr
    elf_w64(off+32, vm_base)              // vmsize = 4GB
    elf_w64(off+40, 0)                    // fileoff
    elf_w64(off+48, 0)                    // filesize
    elf_w32(off+56, 0)                    // maxprot
    elf_w32(off+60, 0)                    // initprot
    elf_w32(off+64, 0)                    // nsects
    elf_w32(off+68, 0)                    // flags

    // LC_SEGMENT_64 __TEXT + __text section (152 bytes)
    off = hdr_size + lc_pagezero_size
    elf_w32(off, 25)                      // cmd = LC_SEGMENT_64
    elf_w32(off+4, lc_text_size)          // cmdsize
    // segname "__TEXT"
    elf_w8(off+8, 95); elf_w8(off+9, 95)
    elf_w8(off+10, 84); elf_w8(off+11, 69); elf_w8(off+12, 88); elf_w8(off+13, 84)
    elf_w64(off+24, text_vm)              // vmaddr
    elf_w64(off+32, text_seg_vmsize)      // vmsize
    elf_w64(off+40, 0)                    // fileoff
    elf_w64(off+48, total_file_size)      // filesize
    elf_w32(off+56, 7)                    // maxprot = rwx
    elf_w32(off+60, 5)                    // initprot = r-x
    elf_w32(off+64, 1)                    // nsects = 1
    elf_w32(off+68, 0)                    // flags

    // __text section header (80 bytes at off+72)
    let sec = off + 72
    // sectname "__text"
    elf_w8(sec, 95); elf_w8(sec+1, 95)
    elf_w8(sec+2, 116); elf_w8(sec+3, 101); elf_w8(sec+4, 120); elf_w8(sec+5, 116)  // text
    // segname "__TEXT"
    elf_w8(sec+16, 95); elf_w8(sec+17, 95)
    elf_w8(sec+18, 84); elf_w8(sec+19, 69); elf_w8(sec+20, 88); elf_w8(sec+21, 84)
    elf_w64(sec+32, text_vm + text_file_off)  // addr
    elf_w64(sec+40, CL)                       // size
    elf_w32(sec+48, text_file_off)            // offset
    elf_w32(sec+52, 0)                        // align (2^0 = 1)
    elf_w32(sec+56, 0)                        // reloff
    elf_w32(sec+60, 0)                        // nreloc
    elf_w32(sec+64, 0x80000400)               // flags: PURE_INSTRUCTIONS | SOME_INSTRUCTIONS

    // LC_SEGMENT_64 __DATA + __bss section (152 bytes)
    off = hdr_size + lc_pagezero_size + lc_text_size
    elf_w32(off, 25)                      // cmd = LC_SEGMENT_64
    elf_w32(off+4, lc_data_size)          // cmdsize
    // segname "__DATA"
    elf_w8(off+8, 95); elf_w8(off+9, 95)
    elf_w8(off+10, 68); elf_w8(off+11, 65); elf_w8(off+12, 84); elf_w8(off+13, 65)
    elf_w64(off+24, data_vm)              // vmaddr
    elf_w64(off+32, ((GL_BSS_SIZE + page_size - 1) / page_size) * page_size)  // vmsize
    elf_w64(off+40, 0)                    // fileoff
    elf_w64(off+48, 0)                    // filesize = 0 (BSS)
    elf_w32(off+56, 7)                    // maxprot = rwx
    elf_w32(off+60, 3)                    // initprot = rw-
    elf_w32(off+64, 1)                    // nsects = 1
    elf_w32(off+68, 0)                    // flags

    // __bss section header (80 bytes at off+72)
    let bsec = off + 72
    elf_w8(bsec, 95); elf_w8(bsec+1, 95)
    elf_w8(bsec+2, 98); elf_w8(bsec+3, 115); elf_w8(bsec+4, 115)  // bss
    elf_w8(bsec+16, 95); elf_w8(bsec+17, 95)
    elf_w8(bsec+18, 68); elf_w8(bsec+19, 65); elf_w8(bsec+20, 84); elf_w8(bsec+21, 65)
    elf_w64(bsec+32, data_vm)                 // addr
    elf_w64(bsec+40, GL_BSS_SIZE)             // size
    elf_w32(bsec+48, 0)                       // offset = 0 (BSS)
    elf_w32(bsec+64, 1)                       // flags: S_ZEROFILL

    // LC_MAIN (24 bytes)
    off = hdr_size + lc_pagezero_size + lc_text_size + lc_data_size
    elf_w32(off, 0x80000028)              // cmd = LC_MAIN
    elf_w32(off+4, lc_main_size)          // cmdsize
    elf_w64(off+8, text_file_off + TRAMP_OFF)  // entryoff (file offset of entry)
    elf_w64(off+16, 0)                    // stacksize (0 = default)

    // Copy code at text_file_off
    i = 0
    while i < CL { ELF[(text_file_off + i) as usize] = CD[i as usize]; i = i + 1 }

    let ok = write_file(output, ELF, total_file_size)
    print("macho: "); print(output); print(" "); print_int(total_file_size)
    print(" bytes\n")
    return 0
}

// ═══ ARM64 (AArch64) Backend ═══

// ─── ARM64 syscall helper ───
fn emit_syscall_a64() with Mut {
    if TARGET_OS == 2 {
        em32(0xD4001001)  // svc #0x80 (macOS)
    } else {
        em32(0xD4000001)  // svc #0 (Linux)
    }
}

// ─── ARM64 print("string") ───
fn emit_print_a64(tok: i64) with Mut, Panic, Div {
    let ss = TS[tok as usize] + 1
    let se = TE[tok as usize] - 1
    var slen: i64 = 0
    var zi: i64 = 0
    while zi < 256 { SQW[zi as usize] = 0; zi = zi + 1 }
    var si: i64 = ss
    while si < se {
        let c = sb(si)
        var byte: i64 = c
        if c == 92 && si + 1 < se {
            let c2 = sb(si + 1)
            if c2 == 110 { byte = 10 }
            else if c2 == 116 { byte = 9 }
            else if c2 == 48 { byte = 0 }
            else { byte = c2 }
            si = si + 2
        } else { si = si + 1 }
        SQW[slen as usize] = byte
        slen = slen + 1
    }
    // Emit: b skip; string_bytes (4-byte padded); skip: adr x1, -(pad_len); ...
    let pad_len = (slen + 3) / 4 * 4
    // b skip: offset = 1 + pad_len/4 instructions
    let b_off = 1 + pad_len / 4
    em32(0x14000000 | (b_off & 0x3FFFFFF))
    let str_start = CL
    // Emit string bytes
    var bi: i64 = 0
    while bi < pad_len {
        if bi < slen { em(SQW[bi as usize] & 0xFF) }
        else { em(0) }
        bi = bi + 1
    }
    // skip: adr x1, -(pad_len) — point back at string data
    let adr_off = 0 - pad_len
    let adr_immlo = adr_off & 3
    let adr_immhi = (adr_off >> 2) & 0x7FFFF
    em32(0x10000000 | ((adr_immlo & 0x3) << 29) | ((adr_immhi & 0x7FFFF) << 5) | 1)
    // mov x0, #1 (stdout fd)
    em32(0xD2800020)  // movz x0, #1
    // mov x2, #slen
    em32(0xD2800000 | ((slen & 0xFFFF) << 5) | 2)  // movz x2, #slen
    // syscall: write
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000004)  // x16 = write syscall (macOS)
    } else {
        em32(0xD2800000 | ((64 & 0xFFFF) << 5) | 8)  // movz x8, #64 (Linux write)
    }
    emit_syscall_a64()
}

fn emit_print_cstr_a64() with Mut {
    // x0 = C string pointer
    em32(0xAA0003E9)  // mov x9, x0
    em32(0xAA0003E1)  // mov x1, x0
    em32(0xD280000A)  // movz x10, #0
    let slp = CL
    em32(0x38606920 | 10)  // ldrb w0, [x9, x10]
    em32(0x34000000 | (3 << 5) | 0)  // cbz w0, done
    em32(0x9100054A)  // add x10, x10, #1
    let brel = (slp - CL) / 4
    em32(0x14000000 | (brel & 0x3FFFFFF))
    em32(0xAA0A03E2)  // mov x2, x10
    em32(0xD2800020)  // movz x0, #1
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000004)
    } else {
        em32(0xD2800000 | ((64 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
}

fn emit_print_nl_a64() with Mut {
    em32(0xD1000000 | (16 << 10) | (31 << 5) | 31)  // sub sp, sp, #16
    em32(0xD280014A)  // movz x10, #10
    em32(0x390003EA)  // strb w10, [sp]
    em32(0xD2800020)  // movz x0, #1
    em32(0x910003E1)  // mov x1, sp
    em32(0xD2800022)  // movz x2, #1
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000004)
    } else {
        em32(0xD2800000 | ((64 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    em32(0x910043FF)  // add sp, sp, #16
}

// ─── ARM64 print_int ───
fn emit_print_int_a64() with Mut {
    // x0 = value to print
    // sub sp, sp, #64 for scratch buffer
    em32(0xD1000000 | (64 << 10) | (31 << 5) | 31)  // sub sp, sp, #64
    // store '\n' at sp+63
    em32(0xD2800140 | 10)  // movz x10, #10
    em32(0x39000000 | (63 << 10) | (31 << 5) | 10)  // strb w10, [sp, #63]
    // x9 = sp + 62 (current write position)
    em32(0x91000000 | (62 << 10) | (31 << 5) | 9)   // add x9, sp, #62
    // x11 = 0 (negative flag)
    em32(0xD2800000 | 11)  // movz x11, #0
    // Check if negative: cmp x0, #0; b.ge skip_neg
    em32(0xF100001F)  // cmp x0, #0
    em32(0x5400000A | (2 << 5))  // b.ge +2 instructions (skip neg)
    // neg x0, x0
    em32(0xCB0003E0)
    // x11 = 1
    em32(0xD2800020 | 11)  // movz x11, #1
    // div loop: x10 = 10 divisor
    em32(0xD2800140 | 10)  // movz x10, #10
    let loop_top = CL
    // sdiv x12, x0, x10
    em32(0x9AC00C00 | (10 << 16) | (0 << 5) | 12)   // sdiv x12, x0, x10
    // msub x13, x12, x10, x0  (x13 = x0 - x12*x10 = remainder)
    em32(0x9B000000 | (10 << 16) | (0 << 10) | (12 << 5) | 13)  // msub x13, x12, x10, x0
    // add x13, x13, #48 ('0')
    em32(0x91000000 | (48 << 10) | (13 << 5) | 13)
    // strb w13, [x9, #0]
    em32(0x39000000 | (0 << 10) | (9 << 5) | 13)
    // x9 = x9 - 1
    em32(0xD1000000 | (1 << 10) | (9 << 5) | 9)
    // x0 = x12 (quotient)
    em32(0xAA0C03E0)  // mov x0, x12
    // cbnz x0, loop_top
    let rel = (loop_top - CL) / 4
    em32(0xB5000000 | ((rel & 0x7FFFF) << 5) | 0)
    // If negative, store '-'
    // cbz x11, skip_minus
    em32(0xB4000000 | (3 << 5) | 11)  // cbz x11, +3 instructions
    em32(0xD2800000 | (45 << 5) | 13)  // movz x13, #45 ('-')
    em32(0x39000000 | (0 << 10) | (9 << 5) | 13)  // strb w13, [x9]
    em32(0xD1000000 | (1 << 10) | (9 << 5) | 9)   // x9 = x9 - 1
    // x1 = x9 + 1 (start of string)
    em32(0x91000000 | (1 << 10) | (9 << 5) | 1)    // add x1, x9, #1
    // x2 = sp + 64 - x1 (length)
    em32(0x91000000 | (64 << 10) | (31 << 5) | 2)  // add x2, sp, #64
    em32(0xCB010042)                                  // sub x2, x2, x1
    // write(1, x1, x2)
    em32(0xD2800020)  // movz x0, #1 (fd=stdout)
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000004)
    } else {
        em32(0xD2800000 | ((64 & 0xFFFF) << 5) | 8)  // movz x8, #64 (Linux write)
    }
    emit_syscall_a64()
    // add sp, sp, #64
    em32(0x91000000 | (64 << 10) | (31 << 5) | 31)
}

// ─── ARM64 print_f64 (stub — prints integer part only) ───
fn emit_print_f64_a64() with Mut {
    // x0 = f64 bits. Convert to integer part, print that.
    em32(0x9E670000)  // fmov d0, x0
    em32(0x9E780000)  // fcvtzs x0, d0
    emit_print_int_a64()
}

// ─── ARM64 read_file ───
fn emit_read_file_a64() with Mut {
    // x0 = path (C string pointer)
    emit_push_a64()
    if TARGET_OS == 2 {
        // macOS: open(path, O_RDONLY=0)
        em32(0xD2800001)  // movz x1, #0
        emit_imm64_reg_a64(16, 0x2000005)  // x16 = SYS_open
    } else {
        // Linux: openat(AT_FDCWD=-100, path, O_RDONLY=0)
        em32(0xAA0003E1)  // mov x1, x0
        emit_imm64_reg_a64(0, -100)  // x0 = AT_FDCWD
        em32(0xD2800002)  // movz x2, #0
        em32(0xD2800000 | ((56 & 0xFFFF) << 5) | 8)  // movz x8, #56
    }
    emit_syscall_a64()
    // x0 = fd. Push it.
    emit_push_a64()
    // mmap(NULL, 4MB, 3, 0x22, -1, 0)
    em32(0xD2800000)  // x0 = NULL
    emit_imm64_reg_a64(1, 0x400000)  // x1 = 4MB
    em32(0xD2800060 | 2)  // x2 = 3
    em32(0xD2800000 | ((0x22 & 0xFFFF) << 5) | 3)  // x3 = 0x22
    emit_imm64_reg_a64(4, -1)  // x4 = -1
    em32(0xD2800005)  // x5 = 0
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x20000C5)
    } else {
        em32(0xD2800000 | ((222 & 0xFFFF) << 5) | 8)  // x8 = 222 (mmap)
    }
    emit_syscall_a64()
    // x0 = buf. Push it.
    emit_push_a64()
    // read(fd, buf, 4MB): x0=fd, x1=buf, x2=len
    em32(0xAA0003E1)  // mov x1, x0 (buf)
    em32(0xF9400000 | ((16/8) << 10) | (31 << 5) | 0)  // ldr x0, [sp, #16] (fd)
    emit_imm64_reg_a64(2, 0x400000)  // x2 = 4MB
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000003)
    } else {
        em32(0xD2800000 | ((63 & 0xFFFF) << 5) | 8)  // x8 = 63 (read)
    }
    emit_syscall_a64()
    // close(fd)
    em32(0xF9400000 | ((16/8) << 10) | (31 << 5) | 0)  // ldr x0, [sp, #16]
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000006)
    } else {
        em32(0xD2800000 | ((57 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    // Return buf
    em32(0xF8410FE0)  // ldr x0, [sp], #16 (pop buf)
    em32(0x91000000 | (16 << 10) | (31 << 5) | 31)  // add sp, sp, #16 (discard fd)
}

// ─── ARM64 write_file ───
fn emit_write_file_a64() with Mut {
    // On entry: stack=[buf, path] (path pushed first, buf second), x0=len
    em32(0xAA0003E4)  // mov x4, x0 (save len)
    em32(0xF9400000 | ((16/8) << 10) | (31 << 5) | 5)  // ldr x5, [sp, #16] (path)
    em32(0xF9400000 | ((0/8) << 10) | (31 << 5) | 6)   // ldr x6, [sp, #0] (buf)
    em32(0x91000000 | (32 << 10) | (31 << 5) | 31)      // add sp, sp, #32
    // open(path, O_WRONLY|O_CREAT|O_TRUNC, 0644)
    em32(0xAA0503E0)  // mov x0, x5 (path)
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(1, 0x601)
        em32(0xD2800000 | ((0x1A4 & 0xFFFF) << 5) | 2)
        emit_imm64_reg_a64(16, 0x2000005)
    } else {
        em32(0xAA0003E1)  // mov x1, x0
        emit_imm64_reg_a64(0, -100)
        emit_imm64_reg_a64(2, 0x241)
        em32(0xD2800000 | ((0x1A4 & 0xFFFF) << 5) | 3)
        em32(0xD2800000 | ((56 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    em32(0xAA0003E7)  // mov x7, x0 (save fd)
    // write(fd, buf, len)
    em32(0xAA0603E1)  // mov x1, x6
    em32(0xAA0403E2)  // mov x2, x4
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000004)
    } else {
        em32(0xD2800000 | ((64 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    // close(fd)
    em32(0xAA0703E0)  // mov x0, x7
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000006)
    } else {
        em32(0xD2800000 | ((57 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    em32(0xD2800020)  // movz x0, #1 (return 1)
}

// ─── ARM64 file_size ───
fn emit_file_size_a64() with Mut {
    // x0 = path
    if TARGET_OS == 2 {
        em32(0xD2800001)
        emit_imm64_reg_a64(16, 0x2000005)
    } else {
        em32(0xAA0003E1)
        emit_imm64_reg_a64(0, -100)
        em32(0xD2800002)
        em32(0xD2800000 | ((56 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    emit_push_a64()  // save fd
    em32(0xD1000000 | (144 << 10) | (31 << 5) | 31)  // sub sp, sp, #144
    em32(0x910003E1)  // mov x1, sp
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000153)
    } else {
        em32(0xD2800000 | ((80 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    em32(0xF9400000 | ((48/8) << 10) | (31 << 5) | 9)  // ldr x9, [sp, #48]
    em32(0x91000000 | (144 << 10) | (31 << 5) | 31)     // add sp, sp, #144
    em32(0xF8410FE0)  // pop fd
    if TARGET_OS == 2 {
        emit_imm64_reg_a64(16, 0x2000006)
    } else {
        em32(0xD2800000 | ((57 & 0xFFFF) << 5) | 8)
    }
    emit_syscall_a64()
    em32(0xAA0903E0)  // mov x0, x9
}

// ─── ARM64 arg_count ───
fn emit_arg_count_a64() with Mut {
    let argc_addr = GL_BSS_BASE - 16
    emit_imm64_a64(argc_addr)
    em32(0xF9400000)  // ldr x0, [x0]
}

// ─── ARM64 get_arg ───
fn emit_get_arg_a64() with Mut {
    let argv_addr = GL_BSS_BASE - 8
    em32(0xAA0003E9)  // mov x9, x0
    emit_imm64_a64(argv_addr)
    em32(0xF9400000)  // ldr x0, [x0]
    em32(0xF8697800)  // ldr x0, [x0, x9, lsl #3]
}

// ─── ARM64 str_len ───
fn emit_str_len_a64() with Mut {
    em32(0xAA0003E9)  // mov x9, x0
    em32(0xD2800000)  // movz x0, #0
    let top = CL
    em32(0x38606920 | 10)  // ldrb w10, [x9, x0]
    em32(0x34000000 | (3 << 5) | 10)  // cbz w10, +3
    em32(0x91000400)  // add x0, x0, #1
    let brel = (top - CL) / 4
    em32(0x14000000 | (brel & 0x3FFFFFF))
}

// ─── ARM64 f64 binary op helper ───
fn emit_f64_binop_a64(opcode: i64) with Mut {
    em32(0x9E670020)  // fmov d0, x1 (LHS)
    em32(0x9E670001)  // fmov d1, x0 (RHS)
    em32(opcode)       // f64 op d0, d0, d1
    em32(0x9E660000)  // fmov x0, d0
}

// ─── ARM64 expression compiler ───
fn compile_primary_a64() with IO, Mut, Panic, Div {
    LAST_EXPR_IS_CLOSURE = 0
    LAST_EXPR_IS_LINEAR = 0
    let k = TK[EP as usize]
    // Integer literal
    if k == 4 {
        let v = TV[EP as usize]
        if v == 0 { em32(0xD2800000) }
        else { emit_imm64_a64(v) }
        EP = EP + 1
        EXPR_IS_F64 = 0
        return
    }
    // true/false
    if k == 35 { em32(0xD2800020); EP = EP + 1; EXPR_IS_F64 = 0; return }
    if k == 36 { em32(0xD2800000); EP = EP + 1; EXPR_IS_F64 = 0; return }
    // Float literal
    if k == 53 {
        let fl_int = TV[EP as usize]
        let fl_frac = TF[EP as usize]
        let fl_denom = TD[EP as usize]
        EP = EP + 1
        emit_imm64_a64(fl_int)
        em32(0x9E620000)  // scvtf d0, x0
        if fl_frac > 0 {
            emit_imm64_a64(fl_frac)
            em32(0x9E620001)  // scvtf d1, x0
            emit_imm64_a64(fl_denom)
            em32(0x9E620002)  // scvtf d2, x0
            em32(0x1E601800 | (2 << 16) | (1 << 5) | 1)  // fdiv d1, d1, d2
            em32(0x1E612800)  // fadd d0, d0, d1
        }
        em32(0x9E660000)  // fmov x0, d0
        EXPR_IS_F64 = 1
        return
    }
    if k == 48 {
        let match_tok = EP
        compile_stmt_a64()
        if LAST_STMT_HAS_VALUE == 0 { tc_error(match_tok, "match expression must yield a value") }
        EXPR_IS_F64 = 0
        return
    }
    // Closure stub
    if k == 45 {
        EP = EP + 1
        while TK[EP as usize] != 45 && TK[EP as usize] != 0 { EP = EP + 1 }
        if TK[EP as usize] == 45 { EP = EP + 1 }
        if TK[EP as usize] == 8 {
            EP = EP + 1
            var cd: i64 = 1
            while EP < TC && cd > 0 { if TK[EP as usize] == 8 { cd = cd + 1 }; if TK[EP as usize] == 9 { cd = cd - 1 }; EP = EP + 1 }
        } else { EP = EP + 1 }
        em32(0xD2800000)
        EXPR_IS_F64 = 0
        LAST_EXPR_IS_CLOSURE = 1
        return
    }
    // None
    if k == 58 {
        EP = EP + 1
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 2
        em32(0xD2800000)
        emit_store_var_a64(base)
        emit_store_var_a64(base + 1)
        emit_lea_var_a64(base + 1)
        EXPR_IS_F64 = 0
        return
    }
    // Some(expr)
    if k == 57 {
        EP = EP + 1
        if TK[EP as usize] == 6 { EP = EP + 1 }
        compile_or_a64()
        if TK[EP as usize] == 7 { EP = EP + 1 }
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 2
        emit_store_var_a64(base)
        emit_imm64_a64(1)
        emit_store_var_a64(base + 1)
        emit_lea_var_a64(base + 1)
        EXPR_IS_F64 = 0
        return
    }
    // Ok(expr)
    if k == 59 {
        EP = EP + 1
        if TK[EP as usize] == 6 { EP = EP + 1 }
        compile_or_a64()
        if TK[EP as usize] == 7 { EP = EP + 1 }
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 2
        emit_store_var_a64(base)
        em32(0xD2800000)
        emit_store_var_a64(base + 1)
        emit_lea_var_a64(base + 1)
        EXPR_IS_F64 = 0
        return
    }
    // Err(expr)
    if k == 60 {
        EP = EP + 1
        if TK[EP as usize] == 6 { EP = EP + 1 }
        compile_or_a64()
        if TK[EP as usize] == 7 { EP = EP + 1 }
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 2
        emit_store_var_a64(base)
        emit_imm64_a64(1)
        emit_store_var_a64(base + 1)
        emit_lea_var_a64(base + 1)
        EXPR_IS_F64 = 0
        return
    }
    // Parenthesized
    if k == 6 { EP = EP + 1; compile_or_a64(); if TK[EP as usize] == 7 { EP = EP + 1 }; return }
    // Address-of
    if k == 44 {
        EP = EP + 1
        if TK[EP as usize] == 32 { EP = EP + 1 }
        let rns = TS[EP as usize]
        let rne = TE[EP as usize]
        EP = EP + 1
        let slot = var_find(rns, rne)
        if slot >= 0 { emit_lea_var_a64(slot) }
        else {
            let gi = gl_find(rns, rne)
            if gi >= 0 { emit_imm64_a64(GL_BSS_BASE + GL[(gi * 4 + 1) as usize]) }
            else { em32(0xD2800000) }
        }
        EXPR_IS_F64 = 0
        return
    }
    // Dereference *expr
    if k == 19 {
        EP = EP + 1
        compile_primary_a64()
        em32(0xF9400000)  // ldr x0, [x0]
        EXPR_IS_F64 = 0
        return
    }
    // Unary minus
    if k == 18 {
        EP = EP + 1
        compile_primary_a64()
        if EXPR_IS_F64 == 1 {
            em32(0x9E670000); em32(0x1E614000); em32(0x9E660000)
        } else {
            em32(0xCB0003E0)  // neg x0, x0
        }
        return
    }
    // Unary bitwise NOT ~
    if k == 55 {
        EP = EP + 1
        compile_primary_a64()
        em32(0xAA2003E0)  // mvn x0, x0
        EXPR_IS_F64 = 0
        return
    }
    // Unary not !
    if k == 32 {
        EP = EP + 1
        compile_primary_a64()
        em32(0xF100001F)  // cmp x0, #0
        em32(0x9A9F17E0)  // cset x0, eq
        EXPR_IS_F64 = 0
        return
    }
    // String literal
    if k == 5 {
        let ss = TS[EP as usize] + 1
        let se = TE[EP as usize] - 1
        var slen: i64 = 0
        var zi: i64 = 0
        while zi < 256 { SQW[zi as usize] = 0; zi = zi + 1 }
        var si: i64 = ss
        while si < se {
            let ch = sb(si)
            var byte: i64 = ch
            if ch == 92 && si + 1 < se {
                let c2 = sb(si + 1)
                if c2 == 110 { byte = 10 }
                else if c2 == 116 { byte = 9 }
                else if c2 == 48 { byte = 0 }
                else { byte = c2 }
                si = si + 2
            } else { si = si + 1 }
            SQW[slen as usize] = byte
            slen = slen + 1
        }
        let total_bytes = slen + 1
        let pad_len = (total_bytes + 3) / 4 * 4
        let b_off = 1 + pad_len / 4
        em32(0x14000000 | (b_off & 0x3FFFFFF))
        let str_start = CL
        var bi: i64 = 0
        while bi < pad_len {
            if bi < slen { em(SQW[bi as usize] & 0xFF) }
            else if bi == slen { em(0) }
            else { em(0) }
            bi = bi + 1
        }
        let adr_off = 0 - pad_len
        let adr_immlo = adr_off & 3
        let adr_immhi = (adr_off >> 2) & 0x7FFFF
        em32(0x10000000 | ((adr_immlo & 0x3) << 29) | ((adr_immhi & 0x7FFFF) << 5) | 0)
        EP = EP + 1
        EXPR_IS_F64 = 0
        return
    }
    // Identifier or function call
    if k == 3 {
        var ns: i64 = TS[EP as usize]
        var ne: i64 = TE[EP as usize]
        EP = EP + 1
        let name_tok = EP - 1
        // Box::new(expr)
        if TK[EP as usize] == 51 && src_match(ns, ne - ns, "Box") {
            EP = EP + 1; EP = EP + 1
            if TK[EP as usize] == 6 { EP = EP + 1 }
            compile_or_a64()
            if TK[EP as usize] == 7 { EP = EP + 1 }
            emit_push_a64()
            em32(0xD2800000)
            emit_imm64_reg_a64(1, 4096)
            em32(0xD2800060 | 2)
            em32(0xD2800000 | ((0x22 & 0xFFFF) << 5) | 3)
            emit_imm64_reg_a64(4, -1)
            em32(0xD2800005)
            if TARGET_OS == 2 { emit_imm64_reg_a64(16, 0x20000C5) }
            else { em32(0xD2800000 | ((222 & 0xFFFF) << 5) | 8) }
            emit_syscall_a64()
            emit_pop_x1_a64()
            em32(0xF9000001)  // str x1, [x0]
            EXPR_IS_F64 = 0
            return
        }
        // Enum::Variant
        if TK[EP as usize] == 51 {
            EP = EP + 1
            let vns = TS[EP as usize]
            let vne = TE[EP as usize]
            EP = EP + 1
            let eh = gl_name_hash(ns, ne)
            let vh = gl_name_hash(vns, vne)
            let disc = en_variant_value(eh, vh)
            if disc >= 0 { emit_imm64_a64(disc) }
            else { em32(0xD2800000) }
            EXPR_IS_F64 = 0
            return
        }
        // Generic resolution
        if TK[EP as usize] == 23 && EP + 2 < TC && TK[(EP + 1) as usize] == 3 && TK[(EP + 2) as usize] == 24 {
            let g_tys = TS[(EP + 1) as usize]
            let g_tye = TE[(EP + 1) as usize]
            var g_gi: i64 = 0
            var g_found: i64 = 0
            while g_gi < GEN_FN_COUNT && g_found == 0 {
                if name_eq(ns, ne, GEN_FN_NS[g_gi as usize], GEN_FN_NE[g_gi as usize]) {
                    let g_mi = mono_find_inst(g_gi, 0, g_tys, g_tye)
                    if g_mi >= 0 { ns = MAN_BUF_S[g_mi as usize]; ne = MAN_BUF_E[g_mi as usize]; g_found = 1 }
                }
                g_gi = g_gi + 1
            }
            g_gi = 0
            while g_gi < GEN_ST_COUNT && g_found == 0 {
                if name_eq(ns, ne, GEN_ST_NS[g_gi as usize], GEN_ST_NE[g_gi as usize]) {
                    let g_mi = mono_find_inst(g_gi, 1, g_tys, g_tye)
                    if g_mi >= 0 { ns = MAN_BUF_S[g_mi as usize]; ne = MAN_BUF_E[g_mi as usize]; g_found = 1 }
                }
                g_gi = g_gi + 1
            }
            if g_found == 1 { EP = EP + 3 }
        }
        // Function call
        if TK[EP as usize] == 6 {
            if src_match(ns, ne - ns, "print") {
                EP = EP + 1
                if TK[EP as usize] == 5 { emit_print_a64(EP); EP = EP + 1 }
                else {
                    compile_or_a64()
                    emit_print_cstr_a64()
                }
                if TK[EP as usize] == 7 { EP = EP + 1 }
                em32(0xD2800000)
                EXPR_IS_F64 = 0
                EXPR_TY = 5
                return
            }
            if src_match(ns, ne - ns, "println") {
                EP = EP + 1
                if TK[EP as usize] == 5 {
                    emit_print_a64(EP)
                    EP = EP + 1
                    emit_print_nl_a64()
                } else {
                    compile_or_a64()
                    if EXPR_IS_F64 == 1 || EXPR_TY == 2 {
                        emit_print_f64_a64()
                    } else if EXPR_TY == 3 {
                        emit_print_cstr_a64()
                        emit_print_nl_a64()
                    } else {
                        emit_print_int_a64()
                    }
                }
                if TK[EP as usize] == 7 { EP = EP + 1 }
                em32(0xD2800000)
                EXPR_IS_F64 = 0
                EXPR_TY = 5
                return
            }
            if src_match(ns, ne - ns, "print_int") {
                EP = EP + 1; compile_or_a64()
                if TK[EP as usize] == 7 { EP = EP + 1 }
                emit_print_int_a64()
                em32(0xD2800000); EXPR_IS_F64 = 0; EXPR_TY = 5; return
            }
            if src_match(ns, ne - ns, "print_f64") {
                EP = EP + 1; compile_or_a64()
                if TK[EP as usize] == 7 { EP = EP + 1 }
                emit_print_f64_a64()
                em32(0xD2800000); EXPR_IS_F64 = 0; EXPR_TY = 5; return
            }
            if src_match(ns, ne - ns, "arg_count") {
                EP = EP + 1
                if TK[EP as usize] == 7 { EP = EP + 1 }
                emit_arg_count_a64(); EXPR_IS_F64 = 0; return
            }
            if src_match(ns, ne - ns, "get_arg") {
                EP = EP + 1; compile_or_a64()
                if TK[EP as usize] == 7 { EP = EP + 1 }
                emit_get_arg_a64(); EXPR_IS_F64 = 0; return
            }
            if src_match(ns, ne - ns, "read_file") {
                EP = EP + 1; compile_or_a64()
                if TK[EP as usize] == 7 { EP = EP + 1 }
                emit_read_file_a64(); EXPR_IS_F64 = 0; return
            }
            if src_match(ns, ne - ns, "file_size") {
                EP = EP + 1; compile_or_a64()
                if TK[EP as usize] == 7 { EP = EP + 1 }
                emit_file_size_a64(); EXPR_IS_F64 = 0; return
            }
            if src_match(ns, ne - ns, "write_file") {
                EP = EP + 1
                compile_or_a64(); emit_push_a64()
                if TK[EP as usize] == 28 { EP = EP + 1 }
                compile_or_a64(); emit_push_a64()
                if TK[EP as usize] == 28 { EP = EP + 1 }
                compile_or_a64()
                if TK[EP as usize] == 7 { EP = EP + 1 }
                emit_write_file_a64(); EXPR_IS_F64 = 0; return
            }
            if src_match(ns, ne - ns, "str_len") {
                EP = EP + 1; compile_or_a64()
                if TK[EP as usize] == 7 { EP = EP + 1 }
                emit_str_len_a64(); EXPR_IS_F64 = 0; return
            }
            if src_match(ns, ne - ns, "str_char_at") {
                EP = EP + 1
                compile_or_a64(); emit_push_a64()
                if TK[EP as usize] == 28 { EP = EP + 1 }
                compile_or_a64()
                emit_pop_x1_a64()
                em32(0x38A06820)  // ldrsb x0, [x1, x0]
                if TK[EP as usize] == 7 { EP = EP + 1 }
                EXPR_IS_F64 = 0; return
            }
            // f64 builtins
            let bh = gl_name_hash(ns, ne)
            let bl = ne - ns
            if bl == 7 && bh == 7078482 { EP = EP + 1; compile_or_a64(); emit_push_a64(); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or_a64(); emit_pop_x1_a64(); emit_f64_binop_a64(0x1E612800); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 1; return }
            if bl == 7 && bh == 7084000 { EP = EP + 1; compile_or_a64(); emit_push_a64(); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or_a64(); emit_pop_x1_a64(); emit_f64_binop_a64(0x1E613800); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 1; return }
            if bl == 7 && bh == 7085240 { EP = EP + 1; compile_or_a64(); emit_push_a64(); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or_a64(); emit_pop_x1_a64(); emit_f64_binop_a64(0x1E610800); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 1; return }
            if bl == 7 && bh == 7083783 { EP = EP + 1; compile_or_a64(); emit_push_a64(); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or_a64(); emit_pop_x1_a64(); emit_f64_binop_a64(0x1E611800); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 1; return }
            if bl == 7 && bh == 7081334 { EP = EP + 1; compile_or_a64(); em32(0x9E670000); em32(0x1E614000); em32(0x9E660000); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 1; return }
            if bl == 6 && bh == 6061460 { EP = EP + 1; compile_or_a64(); emit_push_a64(); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or_a64(); emit_pop_x1_a64(); em32(0x9E670020); em32(0x9E670001); em32(0x1E612020); em32(0x9A9F57E0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 0; return }
            if bl == 6 && bh == 6058670 { EP = EP + 1; compile_or_a64(); emit_push_a64(); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or_a64(); emit_pop_x1_a64(); em32(0x9E670020); em32(0x9E670001); em32(0x1E612020); em32(0x9A9F87E0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 0; return }
            if bl == 6 && bh == 6059817 { EP = EP + 1; compile_or_a64(); emit_push_a64(); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or_a64(); emit_pop_x1_a64(); em32(0x9E670020); em32(0x9E670001); em32(0x1E612020); em32(0x9A9F17E0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 0; return }
            if bl == 6 && bh == 6060685 { EP = EP + 1; compile_or_a64(); emit_push_a64(); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or_a64(); emit_pop_x1_a64(); em32(0x9E670020); em32(0x9E670001); em32(0x1E612020); em32(0x9A9FC7E0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 0; return }
            if bl == 6 && bh == 6057895 { EP = EP + 1; compile_or_a64(); emit_push_a64(); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or_a64(); emit_pop_x1_a64(); em32(0x9E670020); em32(0x9E670001); em32(0x1E612020); em32(0x9A9FB7E0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 0; return }
            if bl == 10 && bh == 10139623 { EP = EP + 1; compile_or_a64(); em32(0x9E670000); em32(0x9E780000); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 0; return }
            if bl == 10 && bh == 10138972 { EP = EP + 1; compile_or_a64(); em32(0x9E620000); em32(0x9E660000); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 1; return }
            // User function call
            let fi = fn_find(ns, ne)
            let call_vslot = var_find(ns, ne)
            let call_tok = EP - 1
            EP = EP + 1
            var argc: i64 = 0
            while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
                compile_or_a64()
                emit_push_a64()
                argc = argc + 1
                if TK[EP as usize] == 28 { EP = EP + 1 }
            }
            if TK[EP as usize] == 7 { EP = EP + 1 }
            if fi >= 0 {
                if FN_ARITY[fi as usize] != argc { tc_wrong_arity(call_tok, FN_ARITY[fi as usize], argc) }
                let callee_eff = FN_EFFECTS[fi as usize]
                let caller_eff = FN_EFFECTS[CURRENT_FN as usize]
                if (callee_eff & ~caller_eff) != 0 { print("warning: effect violation in ARM64\n") }
                if argc >= 8 { em32(0xF8410FE7) }
                if argc >= 7 { em32(0xF8410FE6) }
                if argc >= 6 { em32(0xF8410FE5) }
                if argc >= 5 { em32(0xF8410FE4) }
                if argc >= 4 { em32(0xF8410FE3) }
                if argc >= 3 { em32(0xF8410FE2) }
                if argc >= 2 { emit_pop_x1_a64() }
                if argc >= 1 { em32(0xF8410FE0) }
                PATCH_OFF[PATCH_COUNT as usize] = CL
                PATCH_FN[PATCH_COUNT as usize] = fi
                PATCH_COUNT = PATCH_COUNT + 1
                em32(0x94000000)
                EXPR_TY = FN_RET_TY[fi as usize]
                EXPR_TY_HASH = FN_RET_HASH[fi as usize]
                if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
            } else {
                if argc >= 5 { em32(0xF8410FE5) }
                if argc >= 4 { em32(0xF8410FE4) }
                if argc >= 3 { em32(0xF8410FE3) }
                if argc >= 2 { em32(0xF8410FE2) }
                if argc >= 1 { em32(0xF8410FE1) }
                if call_vslot >= 0 {
                    emit_load_var_a64(call_vslot)
                    em32(0xF9400009)  // ldr x9, [x0] (fn_ptr)
                    em32(0xD63F0120)  // blr x9
                    EXPR_TY = 0
                    EXPR_TY_HASH = 0
                } else {
                    tc_undefined_var(name_tok)
                    em32(0xD2800000)
                    EXPR_TY = 0
                    EXPR_TY_HASH = 0
                }
            }
            if fi < 0 { EXPR_IS_F64 = 0 }
            return
        }
        // Struct literal
        if TK[EP as usize] == 8 {
            let sh = gl_name_hash(ns, ne)
            let si = st_find(sh)
            if si >= 0 {
                EP = EP + 1
                let fc = ST[(si * 66 + 1) as usize]
                let base_slot = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + fc
                while TK[EP as usize] != 9 && TK[EP as usize] != 0 {
                    if TK[EP as usize] == 3 {
                        let field_tok = EP
                        let fns = TS[EP as usize]
                        let fne = TE[EP as usize]
                        let fh = gl_name_hash(fns, fne)
                        EP = EP + 1
                        if TK[EP as usize] == 43 { EP = EP + 1 }
                        compile_or_a64()
                        let foff = st_field_offset(si, fh)
                        if foff >= 0 { emit_store_var_a64(base_slot + fc - 1 - foff / 8) }
                        else { tc_error(field_tok, "unknown field in struct literal") }
                    }
                    if TK[EP as usize] == 28 { EP = EP + 1 }
                }
                if TK[EP as usize] == 9 { EP = EP + 1 }
                emit_lea_var_a64(base_slot + fc - 1)
                EXPR_IS_F64 = 0
                EXPR_TY = 6
                EXPR_TY_HASH = sh
                LAST_EXPR_IS_LINEAR = ST_LINEAR[si as usize]
                return
            }
        }
        // Array subscript
        if TK[EP as usize] == 41 {
            EP = EP + 1
            compile_or_a64()
            if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
            if TK[EP as usize] == 42 { EP = EP + 1 }
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                let base = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                let esz = GL[(gi * 4 + 2) as usize]
                em32(0xAA0003E9)
                emit_imm64_a64(base)
                if esz == 8 { em32(0xF8697800) }
                else { em32(0x38A96800) }
            } else {
                let slot = var_find(ns, ne)
                if slot >= 0 {
                    let lalen = var_find_alen(ns, ne)
                    let lesiz = var_find_esiz(ns, ne)
                    em32(0xAA0003E9)
                    emit_load_var_a64(slot)
                    if lalen > 0 && lesiz == 8 { em32(0xF8697800) }
                    else { em32(0x38A96800) }
                } else {
                    tc_undefined_var(name_tok)
                    em32(0xD2800000)
                }
            }
            EXPR_IS_F64 = 0
            return
        }
        // Variable load
        let slot = var_find(ns, ne)
        if slot >= 0 {
            emit_load_var_a64(slot)
            EXPR_IS_F64 = var_find_is_f64(ns, ne)
            let vi = var_find_idx(ns, ne)
            if vi >= 0 {
                EXPR_TY = VAR_TY[vi as usize]
                EXPR_TY_HASH = VAR_TY_HASH[vi as usize]
            }
            var_mark_used(ns, ne)
        } else {
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                let alen = GL[(gi * 4 + 3) as usize]
                emit_imm64_a64(addr)
                if alen == 0 { em32(0xF9400000) }
                EXPR_TY = GL_TY[gi as usize]
                EXPR_TY_HASH = GL_TY_HASH[gi as usize]
                if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
            } else {
                let fri = fn_find(ns, ne)
                if fri >= 0 { em32(0xD2800000); LAST_EXPR_IS_CLOSURE = 1; EXPR_TY = 9; EXPR_TY_HASH = 0 }
                else { tc_undefined_var(name_tok); em32(0xD2800000); EXPR_TY = 0; EXPR_TY_HASH = 0 }
            }
            if gi < 0 { EXPR_IS_F64 = 0 }
        }
        return
    }
    EP = EP + 1
    em32(0xD2800000)
    EXPR_IS_F64 = 0
}

// ─── ARM64 postfix ───
fn compile_postfix_a64() with IO, Mut, Panic, Div {
    compile_primary_a64()
    var more: i64 = 1
    while more == 1 {
        if TK[EP as usize] == 37 {
            EP = EP + 1
            let tp = EP
            let src_is_f64 = EXPR_IS_F64
            let tns = TS[EP as usize]
            let tne = TE[EP as usize]
            scan_type(tp)
            if SCAN_TY == 1 && src_is_f64 == 1 {
                em32(0x9E670000)
                em32(0x9E780000)
            }
            if SCAN_TY == 2 && src_is_f64 == 0 {
                em32(0x9E620000)
                em32(0x9E660000)
            }
            if SCAN_TY == 1 && tne - tns == 2 && sb(tns) == 105 && sb(tns+1) == 56 {
                em32(0x93401C00)  // sxtb x0, w0
            }
            EXPR_TY = SCAN_TY
            EXPR_TY_HASH = SCAN_TY_HASH
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
            EP = SCAN_TY_NEXT
            continue
        }
        if TK[EP as usize] == 50 {
            EP = EP + 1
            let method_tok = EP
            let fns = TS[EP as usize]
            let fne = TE[EP as usize]
            let fh = gl_name_hash(fns, fne)
            if TK[(EP + 1) as usize] == 6 {
                let mfi = fn_find(fns, fne)
                if mfi >= 0 {
                    EP = EP + 1; EP = EP + 1
                    emit_push_a64()
                    var margc: i64 = 1
                    while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
                        compile_or_a64(); emit_push_a64()
                        margc = margc + 1
                        if TK[EP as usize] == 28 { EP = EP + 1 }
                    }
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                    if FN_ARITY[mfi as usize] != margc { tc_wrong_arity(method_tok, FN_ARITY[mfi as usize], margc) }
                    if margc >= 8 { em32(0xF8410FE7) }
                    if margc >= 7 { em32(0xF8410FE6) }
                    if margc >= 6 { em32(0xF8410FE5) }
                    if margc >= 5 { em32(0xF8410FE4) }
                    if margc >= 4 { em32(0xF8410FE3) }
                    if margc >= 3 { em32(0xF8410FE2) }
                    if margc >= 2 { emit_pop_x1_a64() }
                    if margc >= 1 { em32(0xF8410FE0) }
                    PATCH_OFF[PATCH_COUNT as usize] = CL
                    PATCH_FN[PATCH_COUNT as usize] = mfi
                    PATCH_COUNT = PATCH_COUNT + 1
                    em32(0x94000000)
                    EXPR_TY = FN_RET_TY[mfi as usize]
                    EXPR_TY_HASH = FN_RET_HASH[mfi as usize]
                    if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                    continue
                }
            }
            let base_ty = EXPR_TY
            let base_hash = EXPR_TY_HASH
            EP = EP + 1
            var found: i64 = 0
            EXPR_TY = 0
            EXPR_TY_HASH = 0
            if base_ty == 6 {
                let bsi = st_find(base_hash)
                if bsi >= 0 {
                    let off = st_field_offset(bsi, fh)
                    if off >= 0 {
                        if off == 0 { em32(0xF9400000) }
                        else { em32(0xF9400000 | ((off / 8) << 10) | (0 << 5) | 0) }
                        EXPR_TY = st_field_ty(bsi, fh)
                        EXPR_TY_HASH = st_field_hash(bsi, fh)
                    } else {
                        tc_error(method_tok, "unknown field access")
                        em32(0xD2800000)
                    }
                    found = 1
                }
            }
            var si: i64 = 0
            while si < ST_COUNT && found == 0 {
                let off = st_field_offset(si, fh)
                if off >= 0 {
                    if off == 0 { em32(0xF9400000) }
                    else { em32(0xF9400000 | ((off / 8) << 10) | (0 << 5) | 0) }
                    EXPR_TY = st_field_ty(si, fh)
                    EXPR_TY_HASH = st_field_hash(si, fh)
                    found = 1
                }
                si = si + 1
            }
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
            continue
        }
        more = 0
    }
}

// ─── ARM64 multiplicative ───
fn compile_multiplicative_a64() with IO, Mut, Panic, Div {
    compile_postfix_a64()
    while TK[EP as usize] == 19 || TK[EP as usize] == 20 || TK[EP as usize] == 29 {
        let op = TK[EP as usize]
        EP = EP + 1
        let left_f64 = EXPR_IS_F64
        emit_push_a64()
        compile_postfix_a64()
        emit_pop_x1_a64()
        if left_f64 == 1 {
            if op == 19 { emit_f64_binop_a64(0x1E610800) }
            if op == 20 { emit_f64_binop_a64(0x1E611800) }
            if op == 29 { em32(0x9B007C20) }
            EXPR_IS_F64 = 1
        } else {
            if op == 19 { em32(0x9B007C20) }  // mul x0, x1, x0
            if op == 20 { em32(0x9AC00C20) }  // sdiv x0, x1, x0
            if op == 29 {
                em32(0x9AC00C00 | (0 << 16) | (1 << 5) | 9)
                em32(0x9B000000 | (0 << 16) | (1 << 10) | (9 << 5) | 0)
            }
        }
    }
}

// ─── ARM64 additive ───
fn compile_additive_a64() with IO, Mut, Panic, Div {
    compile_multiplicative_a64()
    while TK[EP as usize] == 17 || TK[EP as usize] == 18 {
        let op = TK[EP as usize]
        EP = EP + 1
        let left_f64 = EXPR_IS_F64
        emit_push_a64()
        compile_multiplicative_a64()
        emit_pop_x1_a64()
        if left_f64 == 1 {
            if op == 17 { emit_f64_binop_a64(0x1E612800) }
            if op == 18 { emit_f64_binop_a64(0x1E613800) }
            EXPR_IS_F64 = 1
        } else {
            if op == 17 { em32(0x8B000020) }
            if op == 18 { em32(0xCB000020) }
        }
    }
}

// ─── ARM64 shift ───
fn compile_shift_a64() with IO, Mut, Panic, Div {
    compile_additive_a64()
    while TK[EP as usize] == 39 || TK[EP as usize] == 40 {
        let op = TK[EP as usize]
        EP = EP + 1
        emit_push_a64()
        compile_additive_a64()
        emit_pop_x1_a64()
        if op == 40 { em32(0x9AC02020) }
        if op == 39 { em32(0x9AC02820) }
    }
}

// ─── ARM64 bitand ───
fn compile_bitand_a64() with IO, Mut, Panic, Div {
    compile_shift_a64()
    while TK[EP as usize] == 44 {
        EP = EP + 1; emit_push_a64(); compile_shift_a64()
        emit_pop_x1_a64()
        em32(0x8A010000)
    }
}

// ─── ARM64 bitxor ───
fn compile_bitxor_a64() with IO, Mut, Panic, Div {
    compile_bitand_a64()
    while TK[EP as usize] == 56 {
        EP = EP + 1; emit_push_a64(); compile_bitand_a64()
        emit_pop_x1_a64()
        em32(0xCA010000)
    }
}

// ─── ARM64 bitor ───
fn compile_bitor_a64() with IO, Mut, Panic, Div {
    compile_bitxor_a64()
    while TK[EP as usize] == 45 {
        EP = EP + 1; emit_push_a64(); compile_bitxor_a64()
        emit_pop_x1_a64()
        em32(0xAA010000)
    }
}

// ─── ARM64 comparison ───
fn compile_comparison_a64() with IO, Mut, Panic, Div {
    compile_bitor_a64()
    let op = TK[EP as usize]
    if op == 21 || op == 22 || op == 23 || op == 24 || op == 25 || op == 26 {
        let left_f64 = EXPR_IS_F64
        EP = EP + 1
        emit_push_a64()
        compile_bitor_a64()
        emit_pop_x1_a64()
        if left_f64 == 1 {
            em32(0x9E670020); em32(0x9E670001); em32(0x1E612020)
            if op == 21 { em32(0x9A9F17E0) }
            if op == 22 { em32(0x9A9F07E0) }
            if op == 23 { em32(0x9A9F57E0) }
            if op == 24 { em32(0x9A9FC7E0) }
            if op == 25 { em32(0x9A9F87E0) }
            if op == 26 { em32(0x9A9FB7E0) }
        } else {
            em32(0xEB00003F)
            if op == 21 { em32(0x9A9F17E0) }
            if op == 22 { em32(0x9A9F07E0) }
            if op == 23 { em32(0x9A9FA7E0) }
            if op == 24 { em32(0x9A9FC7E0) }
            if op == 25 { em32(0x9A9FD7E0) }
            if op == 26 { em32(0x9A9FB7E0) }
        }
        EXPR_IS_F64 = 0
    }
}

// ─── ARM64 logical AND ───
fn compile_and_a64() with IO, Mut, Panic, Div {
    compile_comparison_a64()
    while TK[EP as usize] == 30 {
        EP = EP + 1
        let cbz_off = CL
        em32(0xB4000000)
        compile_comparison_a64()
        em32(0xF100001F); em32(0x9A9F07E0)
        let b_off = CL
        em32(0x14000000)
        patch_branch_a64(cbz_off, CL)
        em32(0xD2800000)
        patch_branch_a64(b_off, CL)
    }
}

// ─── ARM64 logical OR ───
fn compile_or_a64() with IO, Mut, Panic, Div {
    compile_and_a64()
    while TK[EP as usize] == 31 {
        EP = EP + 1
        let cbnz_off = CL
        em32(0xB5000000)
        compile_and_a64()
        let b_off = CL
        em32(0x14000000)
        patch_branch_a64(cbnz_off, CL)
        emit_imm64_a64(1)
        patch_branch_a64(b_off, CL)
    }
}

// ─── ARM64 statement compiler ───
fn compile_stmt_a64() with IO, Mut, Panic, Div {
    let k = TK[EP as usize]
    LAST_STMT_HAS_VALUE = 0
    if k == 27 { EP = EP + 1; return }
    // let/var
    if k == 11 || k == 12 {
        EP = EP + 1
        if TK[EP as usize] == 6 {
            let pat_start = EP
            var pat_p = EP
            var pat_depth: i64 = 0
            while pat_p < TC {
                if TK[pat_p as usize] == 6 { pat_depth = pat_depth + 1 }
                if TK[pat_p as usize] == 7 {
                    pat_depth = pat_depth - 1
                    pat_p = pat_p + 1
                    if pat_depth == 0 { break }
                    continue
                }
                pat_p = pat_p + 1
            }
            EP = pat_p
            if TK[EP as usize] == 16 { EP = EP + 1 }
            if TK[EP as usize] != 6 { tc_error(EP, "tuple destructuring requires tuple literal") }
            tuple_bind_pattern_a64(pat_start, EP)
            EP = TUP_RHS_NEXT
            return
        }
        let ns = TS[EP as usize]
        let ne = TE[EP as usize]
        EP = EP + 1
        var is_arr: i64 = 0
        var arr_len: i64 = 0
        var arr_esiz: i64 = 8
        var decl_is_f64: i64 = -1
        var decl_ty: i64 = 0
        var decl_ty_hash: i64 = 0
        if TK[EP as usize] == 43 {
            EP = EP + 1
            if TK[EP as usize] == 44 { EP = EP + 1 }
            if TK[EP as usize] == 32 { EP = EP + 1 }
            if TK[EP as usize] == 41 {
                EP = EP + 1
                let etns = TS[EP as usize]
                let etne = TE[EP as usize]
                if src_match(etns, etne - etns, "i8") { arr_esiz = 1 }
                EP = EP + 1
                if TK[EP as usize] == 27 { EP = EP + 1 }
                arr_len = TV[EP as usize]; EP = EP + 1
                if TK[EP as usize] == 42 { EP = EP + 1 }
                is_arr = 1
                decl_ty = 8
                decl_ty_hash = arr_ty_hash(arr_len, arr_esiz)
                decl_is_f64 = 0
            } else {
                scan_type(EP)
                decl_ty = SCAN_TY
                decl_ty_hash = SCAN_TY_HASH
                if decl_ty == 2 { decl_is_f64 = 1 }
                else { decl_is_f64 = 0 }
                EP = SCAN_TY_NEXT
            }
        }
        if TK[EP as usize] == 16 { EP = EP + 1 }
        if is_arr == 1 && arr_len > 0 {
            if TK[EP as usize] == 41 {
                EP = EP + 1
                while TK[EP as usize] != 42 && TK[EP as usize] != 0 { EP = EP + 1 }
                if TK[EP as usize] == 42 { EP = EP + 1 }
            }
            let nslots = arr_len
            if arr_esiz == 1 { nslots = (arr_len + 7) / 8 }
            let ptr_slot = var_add_arr(ns, ne, nslots, arr_esiz)
            let arr_vi = VAR_COUNT - 1
            VAR_TY[arr_vi as usize] = 8
            VAR_TY_HASH[arr_vi as usize] = decl_ty_hash
            let base = ptr_slot - nslots
            var zi: i64 = 0
            while zi < nslots { em32(0xD2800000); emit_store_var_a64(base + zi); zi = zi + 1 }
            emit_lea_var_a64(base + nslots - 1)
            emit_store_var_a64(ptr_slot)
        } else {
            compile_or_a64()
            let slot = var_add(ns, ne)
            let vix = VAR_COUNT - 1
            emit_store_var_a64(slot)
            if decl_is_f64 == 1 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 1 }
            else if decl_is_f64 == 0 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 0 }
            else { VAR_IS_F64[(VAR_COUNT - 1) as usize] = EXPR_IS_F64 }
            if decl_ty != 0 {
                VAR_TY[vix as usize] = decl_ty
                VAR_TY_HASH[vix as usize] = decl_ty_hash
            } else {
                VAR_TY[vix as usize] = EXPR_TY
                VAR_TY_HASH[vix as usize] = EXPR_TY_HASH
            }
            if VAR_TY[vix as usize] == 8 {
                VAR_ALEN[vix as usize] = arr_hash_alen(VAR_TY_HASH[vix as usize])
                VAR_ESIZ[vix as usize] = arr_hash_esiz(VAR_TY_HASH[vix as usize])
            }
            VAR_IS_CLOSURE[(VAR_COUNT - 1) as usize] = LAST_EXPR_IS_CLOSURE
            VAR_LINEAR[(VAR_COUNT - 1) as usize] = LAST_EXPR_IS_LINEAR
        }
        return
    }
    // x.field = expr
    if k == 3 && TK[(EP + 1) as usize] == 50 && TK[(EP + 3) as usize] == 16 {
        let name_tok = EP
        let ns = TS[EP as usize]; let ne = TE[EP as usize]
        EP = EP + 2
        let fns = TS[EP as usize]; let fne = TE[EP as usize]
        let fh = gl_name_hash(fns, fne)
        EP = EP + 1
        if TK[EP as usize] == 16 { EP = EP + 1 }
        compile_or_a64()
        emit_push_a64()
        let slot = var_find(ns, ne)
        if slot >= 0 { emit_load_var_a64(slot) }
        else {
            let gi = gl_find(ns, ne)
            if gi >= 0 { emit_imm64_a64(GL_BSS_BASE + GL[(gi * 4 + 1) as usize]) }
            else { tc_undefined_var(name_tok); em32(0xD2800000) }
        }
        emit_pop_x1_a64()
        var si: i64 = 0
        while si < ST_COUNT {
            let off = st_field_offset(si, fh)
            if off >= 0 { em32(0xF9000000 | ((off / 8) << 10) | (0 << 5) | 1); si = ST_COUNT }
            si = si + 1
        }
        return
    }
    // x = expr
    if k == 3 && TK[(EP + 1) as usize] == 16 {
        let name_tok = EP
        let ns = TS[EP as usize]; let ne = TE[EP as usize]
        EP = EP + 2
        compile_or_a64()
        let slot = var_find(ns, ne)
        if slot >= 0 {
            emit_store_var_a64(slot)
            var vi: i64 = VAR_COUNT - 1
            while vi >= 0 {
                if name_eq(VAR_NS[vi as usize], VAR_NE[vi as usize], ns, ne) { VAR_IS_CLOSURE[vi as usize] = LAST_EXPR_IS_CLOSURE; vi = -1 }
                vi = vi - 1
            }
        } else {
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                em32(0xAA0003E1)
                emit_imm64_a64(addr)
                em32(0xF9000001)
            } else {
                tc_undefined_var(name_tok)
            }
        }
        return
    }
    // ARRAY[idx] = expr
    if stmt_is_array_store(EP) {
        let name_tok = EP
        let ns = TS[EP as usize]; let ne = TE[EP as usize]
        EP = EP + 2
        compile_or_a64()
        if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
        if TK[EP as usize] == 42 { EP = EP + 1 }
        if TK[EP as usize] == 16 { EP = EP + 1 }
        emit_push_a64()
        compile_or_a64()
        let gi = gl_find(ns, ne)
        if gi >= 0 {
            let base = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
            let esz = GL[(gi * 4 + 2) as usize]
            em32(0xAA0003EA)
            emit_pop_x1_a64()
            emit_imm64_a64(base)
            if esz == 8 { em32(0xF821780A) }
            else { em32(0x3821680A) }
        } else {
            let lslot = var_find(ns, ne)
            if lslot >= 0 {
                let llalen = var_find_alen(ns, ne)
                let lesiz = var_find_esiz(ns, ne)
                em32(0xAA0003EA)
                emit_pop_x1_a64()
                emit_load_var_a64(lslot)
                if llalen > 0 && lesiz == 8 { em32(0xF821780A) }
                else { em32(0x3821680A) }
            } else {
                tc_undefined_var(name_tok)
                emit_pop_x1_a64()
            }
        }
        return
    }
    // return
    if k == 2 {
        EP = EP + 1
        if TK[EP as usize] != 9 { compile_or_a64() }
        else { em32(0xD2800000) }
        em32(0x91000000 | (2048 << 10) | (31 << 5) | 31)
        em32(0x91000000 | (2048 << 10) | (31 << 5) | 31)
        em32(0xA8C17BFD)
        em32(0xD65F03C0)
        return
    }
    // continue
    if k == 33 {
        EP = EP + 1
        if LOOP_DEPTH > 0 {
            let rel = (LOOP_TOP[(LOOP_DEPTH - 1) as usize] - CL) / 4
            em32(0x14000000 | (rel & 0x3FFFFFF))
        }
        return
    }
    // break
    if k == 34 {
        EP = EP + 1
        BREAK_PATCH[BREAK_COUNT as usize] = CL
        BREAK_COUNT = BREAK_COUNT + 1
        em32(0x14000000)
        return
    }
    // if/else
    if k == 13 {
        EP = EP + 1
        compile_or_a64()
        let cbz_off = CL
        em32(0xB4000000)
        if TK[EP as usize] == 8 { EP = EP + 1 }
        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt_a64() }
        if TK[EP as usize] == 9 { EP = EP + 1 }
        if TK[EP as usize] == 14 {
            EP = EP + 1
            let b_end_off = CL
            em32(0x14000000)
            patch_branch_a64(cbz_off, CL)
            if TK[EP as usize] == 13 { compile_stmt_a64() }
            else {
                if TK[EP as usize] == 8 { EP = EP + 1 }
                while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt_a64() }
                if TK[EP as usize] == 9 { EP = EP + 1 }
            }
            patch_branch_a64(b_end_off, CL)
        } else { patch_branch_a64(cbz_off, CL) }
        return
    }
    // while
    if k == 15 {
        EP = EP + 1
        let loop_top = CL
        LOOP_TOP[LOOP_DEPTH as usize] = loop_top
        LOOP_DEPTH = LOOP_DEPTH + 1
        let saved_bc = BREAK_COUNT
        compile_or_a64()
        let cbz_off = CL
        em32(0xB4000000)
        if TK[EP as usize] == 8 { EP = EP + 1 }
        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt_a64() }
        if TK[EP as usize] == 9 { EP = EP + 1 }
        let rel = (loop_top - CL) / 4
        em32(0x14000000 | (rel & 0x3FFFFFF))
        patch_branch_a64(cbz_off, CL)
        var bi: i64 = saved_bc
        while bi < BREAK_COUNT { patch_branch_a64(BREAK_PATCH[bi as usize], CL); bi = bi + 1 }
        BREAK_COUNT = saved_bc
        LOOP_DEPTH = LOOP_DEPTH - 1
        return
    }
    // for
    if k == 54 {
        EP = EP + 1
        let vns = TS[EP as usize]; let vne = TE[EP as usize]
        EP = EP + 1; EP = EP + 1; EP = EP + 1
        if TK[EP as usize] == 6 { EP = EP + 1 }
        compile_or_a64()
        let iter_slot = var_add(vns, vne)
        emit_store_var_a64(iter_slot)
        if TK[EP as usize] == 28 { EP = EP + 1 }
        compile_or_a64()
        let end_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
        emit_store_var_a64(end_slot)
        if TK[EP as usize] == 7 { EP = EP + 1 }
        let loop_top = CL
        LOOP_TOP[LOOP_DEPTH as usize] = loop_top
        LOOP_DEPTH = LOOP_DEPTH + 1
        let saved_bc = BREAK_COUNT
        emit_load_var_a64(iter_slot); emit_push_a64()
        emit_load_var_a64(end_slot); emit_pop_x1_a64()
        em32(0xEB00003F); em32(0x9A9FA7E0)
        let cbz_off = CL; em32(0xB4000000)
        if TK[EP as usize] == 8 { EP = EP + 1 }
        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt_a64() }
        if TK[EP as usize] == 9 { EP = EP + 1 }
        emit_load_var_a64(iter_slot); em32(0x91000400); emit_store_var_a64(iter_slot)
        let rel = (loop_top - CL) / 4
        em32(0x14000000 | (rel & 0x3FFFFFF))
        patch_branch_a64(cbz_off, CL)
        var bi: i64 = saved_bc
        while bi < BREAK_COUNT { patch_branch_a64(BREAK_PATCH[bi as usize], CL); bi = bi + 1 }
        BREAK_COUNT = saved_bc
        LOOP_DEPTH = LOOP_DEPTH - 1
        return
    }
    // match
    if k == 48 {
        EP = EP + 1
        compile_or_a64()
        let match_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
        emit_store_var_a64(match_slot)
        if TK[EP as usize] == 8 { EP = EP + 1 }
        var arm_count: i64 = 0
        var match_all_value: i64 = 1
        var match_arms: i64 = 0
        while TK[EP as usize] != 9 && TK[EP as usize] != 0 {
            var is_wildcard: i64 = 0
            var disc: i64 = -1
            var arm_is_tagged: i64 = 0
            var bind_ns: i64 = 0; var bind_ne: i64 = 0; var has_binding: i64 = 0
            let arm_tk = TK[EP as usize]
            if arm_tk == 57 { EP = EP + 1; disc = 1; arm_is_tagged = 1; if TK[EP as usize] == 6 { EP = EP + 1; bind_ns = TS[EP as usize]; bind_ne = TE[EP as usize]; has_binding = 1; EP = EP + 1; if TK[EP as usize] == 7 { EP = EP + 1 } } }
            if arm_tk == 58 { EP = EP + 1; disc = 0; arm_is_tagged = 1 }
            if arm_tk == 59 { EP = EP + 1; disc = 0; arm_is_tagged = 1; if TK[EP as usize] == 6 { EP = EP + 1; bind_ns = TS[EP as usize]; bind_ne = TE[EP as usize]; has_binding = 1; EP = EP + 1; if TK[EP as usize] == 7 { EP = EP + 1 } } }
            if arm_tk == 60 { EP = EP + 1; disc = 1; arm_is_tagged = 1; if TK[EP as usize] == 6 { EP = EP + 1; bind_ns = TS[EP as usize]; bind_ne = TE[EP as usize]; has_binding = 1; EP = EP + 1; if TK[EP as usize] == 7 { EP = EP + 1 } } }
            if arm_tk == 3 {
                let pns = TS[EP as usize]; let pne = TE[EP as usize]
                if pne - pns == 1 && sb(pns) == 95 { is_wildcard = 1; EP = EP + 1 }
                else if TK[(EP + 1) as usize] == 51 { let eh = gl_name_hash(pns, pne); EP = EP + 2; let vh = gl_name_hash(TS[EP as usize], TE[EP as usize]); EP = EP + 1; disc = en_variant_value(eh, vh) }
                else { EP = EP + 1 }
            }
            if arm_tk == 4 { disc = TV[EP as usize]; EP = EP + 1 }
            if arm_tk != 57 && arm_tk != 58 && arm_tk != 59 && arm_tk != 60 && arm_tk != 3 && arm_tk != 4 { EP = EP + 1 }
            if disc >= 0 {
                if arm_is_tagged == 1 {
                    emit_load_var_a64(match_slot); em32(0xF9400000); emit_push_a64()
                    emit_imm64_a64(disc); emit_pop_x1_a64()
                    em32(0xEB00003F)
                    let skip_off = CL; em32(0x54000001)
                    if has_binding == 1 { emit_load_var_a64(match_slot); em32(0xF9400400); let bslot = var_add(bind_ns, bind_ne); emit_store_var_a64(bslot) }
                    if TK[EP as usize] == 52 { EP = EP + 1 }
                    var arm_has_block: i64 = 0
                    if TK[EP as usize] == 8 { arm_has_block = 1; EP = EP + 1 }
                    LAST_STMT_HAS_VALUE = 0
                    if arm_has_block == 1 {
                        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt_a64() }
                        if TK[EP as usize] == 9 { EP = EP + 1 }
                    } else {
                        compile_stmt_a64()
                    }
                    match_arms = match_arms + 1
                    if LAST_STMT_HAS_VALUE == 0 { match_all_value = 0 }
                    MATCH_ENDS[arm_count as usize] = CL; em32(0x14000000)
                    arm_count = arm_count + 1
                    patch_branch_a64(skip_off, CL)
                } else {
                    emit_load_var_a64(match_slot); emit_push_a64()
                    emit_imm64_a64(disc); emit_pop_x1_a64()
                    em32(0xEB00003F)
                    let skip_off = CL; em32(0x54000001)
                    if TK[EP as usize] == 52 { EP = EP + 1 }
                    var arm_has_block2: i64 = 0
                    if TK[EP as usize] == 8 { arm_has_block2 = 1; EP = EP + 1 }
                    LAST_STMT_HAS_VALUE = 0
                    if arm_has_block2 == 1 {
                        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt_a64() }
                        if TK[EP as usize] == 9 { EP = EP + 1 }
                    } else {
                        compile_stmt_a64()
                    }
                    match_arms = match_arms + 1
                    if LAST_STMT_HAS_VALUE == 0 { match_all_value = 0 }
                    MATCH_ENDS[arm_count as usize] = CL; em32(0x14000000)
                    arm_count = arm_count + 1
                    patch_branch_a64(skip_off, CL)
                }
            }
            if is_wildcard == 1 {
                if TK[EP as usize] == 52 { EP = EP + 1 }
                var arm_has_block3: i64 = 0
                if TK[EP as usize] == 8 { arm_has_block3 = 1; EP = EP + 1 }
                LAST_STMT_HAS_VALUE = 0
                if arm_has_block3 == 1 {
                    while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt_a64() }
                    if TK[EP as usize] == 9 { EP = EP + 1 }
                } else {
                    compile_stmt_a64()
                }
                match_arms = match_arms + 1
                if LAST_STMT_HAS_VALUE == 0 { match_all_value = 0 }
            }
            if TK[EP as usize] == 28 { EP = EP + 1 }
        }
        if TK[EP as usize] == 9 { EP = EP + 1 }
        var ai: i64 = 0
        while ai < arm_count { patch_branch_a64(MATCH_ENDS[ai as usize], CL); ai = ai + 1 }
        if match_arms > 0 && match_all_value == 1 { LAST_STMT_HAS_VALUE = 1 }
        return
    }
    // Expression statement
    compile_or_a64()
    LAST_STMT_HAS_VALUE = 1
}

// ─── ARM64 top-level compiler ───
fn compile_all_arm64() -> i64 with IO, Mut, Panic, Div {
    // Run all frontend passes via compile_all (which also emits x86_64 code, discarded)
    let r = compile_all()
    if r != 0 { return r }
    // Reset code buffer and patches for ARM64 re-emission
    CL = 0
    PATCH_COUNT = 0
    print("arm64: re-emitting pass 2\n")
    // ARM64 Pass 2: compile each function
    var p: i64 = 0
    var fn_idx: i64 = 0
    while p < TC {
        if TK[p as usize] != 1 { p = p + 1; continue }
        p = p + 1
        if p + 2 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 3) as usize] == 24 {
            while p < TC && TK[p as usize] != 8 { p = p + 1 }
            var gd: i64 = 1; p = p + 1
            while p < TC && gd > 0 { if TK[p as usize] == 8 { gd = gd + 1 }; if TK[p as usize] == 9 { gd = gd - 1 }; p = p + 1 }
            continue
        }
        FN_OFF[fn_idx as usize] = CL
        CURRENT_FN = fn_idx
        VAR_COUNT = 0; NEXT_SLOT = 1; BREAK_COUNT = 0; LAST_STMT_HAS_VALUE = 0
        p = p + 1
        if TK[p as usize] == 6 { p = p + 1 }
        while TK[p as usize] != 7 && TK[p as usize] != 0 {
            if TK[p as usize] == 3 {
                let pns = TS[p as usize]; let pne = TE[p as usize]
                let pslot = var_add(pns, pne)
                p = p + 1
                if TK[p as usize] == 43 {
                    p = p + 1
                    scan_type(p)
                    VAR_TY[(VAR_COUNT - 1) as usize] = SCAN_TY
                    VAR_TY_HASH[(VAR_COUNT - 1) as usize] = SCAN_TY_HASH
                    if SCAN_TY == 2 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 1 }
                    if SCAN_TY == 8 {
                        VAR_ALEN[(VAR_COUNT - 1) as usize] = SCAN_TY_ALEN
                        VAR_ESIZ[(VAR_COUNT - 1) as usize] = SCAN_TY_ESIZ
                    }
                    p = SCAN_TY_NEXT
                }
            }
            if TK[p as usize] == 28 { p = p + 1 }
        }
        if TK[p as usize] == 7 { p = p + 1 }
        if TK[p as usize] == 10 {
            p = p + 1
            scan_type(p)
            p = SCAN_TY_NEXT
        }
        if TK[p as usize] == 38 { p = p + 1; while TK[p as usize] == 3 || TK[p as usize] == 28 { p = p + 1 } }
        if TK[p as usize] == 8 { p = p + 1 }
        // ARM64 prologue
        print_int(fn_idx); print(" ")
        em32(0xA9BF7BFD)  // stp x29, x30, [sp, #-16]!
        em32(0x910003FD)  // mov x29, sp
        em32(0xD1000000 | (2048 << 10) | (31 << 5) | 31)  // sub sp, sp, #2048
        em32(0xD1000000 | (2048 << 10) | (31 << 5) | 31)  // sub sp, sp, #2048
        // Spill params
        let nparams = VAR_COUNT
        if nparams >= 1 { emit_store_var_a64(1) }
        if nparams >= 2 { em32(0xAA0103E0); emit_store_var_a64(2) }
        if nparams >= 3 { em32(0xAA0203E0); emit_store_var_a64(3) }
        if nparams >= 4 { em32(0xAA0303E0); emit_store_var_a64(4) }
        if nparams >= 5 { em32(0xAA0403E0); emit_store_var_a64(5) }
        if nparams >= 6 { em32(0xAA0503E0); emit_store_var_a64(6) }
        if nparams >= 7 { em32(0xAA0603E0); emit_store_var_a64(7) }
        if nparams >= 8 { em32(0xAA0703E0); emit_store_var_a64(8) }
        // Compile body
        EP = p
        var depth: i64 = 1
        while EP < TC && depth > 0 {
            if TK[EP as usize] == 9 { depth = depth - 1; if depth == 0 { EP = EP + 1; continue } else { EP = EP + 1; continue } }
            compile_stmt_a64()
        }
        p = EP
        // Linear check
        var lci: i64 = 0
        while lci < VAR_COUNT {
            if VAR_LINEAR[lci as usize] == 1 && VAR_USED[lci as usize] == 0 { print("warning: linear var unused in ARM64 fn#"); print_int(fn_idx); print("\n") }
            lci = lci + 1
        }
        // Implicit return
        var needs_epilogue: i64 = 1
        if CL >= 4 { if rd32_at(CL - 4) == 0xD65F03C0 { needs_epilogue = 0 } }
        if needs_epilogue == 1 {
            if LAST_STMT_HAS_VALUE == 0 { em32(0xD2800000) }
            em32(0x91000000 | (2048 << 10) | (31 << 5) | 31)
            em32(0x91000000 | (2048 << 10) | (31 << 5) | 31)
            em32(0xA8C17BFD)
            em32(0xD65F03C0)
        }
        fn_idx = fn_idx + 1
    }
    // Patch BL instructions
    var pi: i64 = 0
    while pi < PATCH_COUNT {
        let off = PATCH_OFF[pi as usize]
        let fi = PATCH_FN[pi as usize]
        if fi >= 0 && fi < FN_COUNT {
            let target = FN_OFF[fi as usize]
            let rel = (target - off) / 4
            em32_at(off, 0x94000000 | (rel & 0x3FFFFFF))
        }
        pi = pi + 1
    }
    // Find main
    var main_fn: i64 = -1
    var mi: i64 = 0
    while mi < FN_COUNT {
        let ms = FN_NS[mi as usize]; let me = FN_NE[mi as usize]
        if me - ms == 4 && sb(ms) == 109 && sb(ms+1) == 97 && sb(ms+2) == 105 && sb(ms+3) == 110 { main_fn = mi }
        mi = mi + 1
    }
    if main_fn < 0 { print("error: no main\n"); return 1 }
    // Trampoline
    TRAMP_OFF = CL
    if TARGET_OS == 2 {
        let argc_addr = 0x100008000
        let argv_addr = 0x100008000 + 8
        em32(0xF94003E9)
        em32(0xD1000529)
        emit_imm64_reg_a64(10, argc_addr)
        em32(0xF9000149)
        em32(0x91000000 | (16 << 10) | (31 << 5) | 9)
        emit_imm64_reg_a64(10, argv_addr)
        em32(0xF9000149)
        let mrel = (FN_OFF[main_fn as usize] - CL) / 4
        em32(0x94000000 | (mrel & 0x3FFFFFF))
        emit_imm64_reg_a64(16, 0x2000001)
        em32(0xD4001001)
    } else {
        let argc_addr = 0x600000
        let argv_addr = 0x600000 + 8
        em32(0xF94003E9)
        em32(0xD1000529)
        emit_imm64_reg_a64(10, argc_addr)
        em32(0xF9000149)
        em32(0x91000000 | (16 << 10) | (31 << 5) | 9)
        emit_imm64_reg_a64(10, argv_addr)
        em32(0xF9000149)
        let mrel = (FN_OFF[main_fn as usize] - CL) / 4
        em32(0x94000000 | (mrel & 0x3FFFFFF))
        em32(0xD2800000 | ((93 & 0xFFFF) << 5) | 8)
        em32(0xD4000001)
    }
    print("arm64_compile: fns="); print_int(FN_COUNT); print(" code="); print_int(CL)
    print(" main=fn"); print_int(main_fn); print(" patches="); print_int(PATCH_COUNT); print("\n")
    0
}

// ─── ARM64 ELF writer ───
fn write_elf_arm64(output: string) -> i64 with IO, Mut, Panic, Div {
    let text_base = 0x400000
    let text_off = 4096
    let bss_base = 0x600000
    let entry = text_base + text_off + TRAMP_OFF
    var i: i64 = 0
    while i < 4096 { ELF[i as usize] = 0; i = i + 1 }
    let tsz = text_off + CL
    let total_memsz = (bss_base - text_base) + GL_BSS_SIZE
    // ELF header
    elf_w8(0, 0x7f); elf_w8(1, 69); elf_w8(2, 76); elf_w8(3, 70)
    elf_w8(4, 2); elf_w8(5, 1); elf_w8(6, 1)
    elf_w16(16, 2); elf_w16(18, 0xB7); elf_w32(20, 1)
    elf_w64(24, entry); elf_w64(32, 64)
    elf_w16(52, 64); elf_w16(54, 56); elf_w16(56, 1); elf_w16(58, 64)
    let ph0 = 64
    elf_w32(ph0, 1); elf_w32(ph0+4, 7)
    elf_w64(ph0+8, 0); elf_w64(ph0+16, text_base); elf_w64(ph0+24, text_base)
    elf_w64(ph0+32, tsz); elf_w64(ph0+40, total_memsz); elf_w64(ph0+48, 0x200000)
    i = 0
    while i < CL { ELF[(text_off + i) as usize] = CD[i as usize]; i = i + 1 }
    let ok = write_file(output, ELF, tsz)
    print("elf_arm64: "); print(output); print(" "); print_int(tsz); print(" bytes (bss="); print_int(GL_BSS_SIZE); print(")\n")
    return 0
}

// ─── ARM64 Mach-O writer ───
fn write_macho_arm64(output: string) -> i64 with IO, Mut, Panic, Div {
    let vm_base: i64 = 4294967296
    let page_size: i64 = 16384
    let text_vm = vm_base
    let data_vm = vm_base + 0x8000
    let hdr_size = 32
    let lc_pagezero_size = 72
    let lc_text_size = 72 + 80
    let lc_data_size = 72 + 80
    let lc_main_size = 24
    let ncmds = 4
    let sizeofcmds = lc_pagezero_size + lc_text_size + lc_data_size + lc_main_size
    let text_file_off = ((hdr_size + sizeofcmds + page_size - 1) / page_size) * page_size
    let text_file_size = ((CL + page_size - 1) / page_size) * page_size
    let total_file_size = text_file_off + text_file_size
    let text_seg_vmsize = text_file_off + text_file_size
    print("macho_arm64: code="); print_int(CL); print(" text_off="); print_int(text_file_off); print("\n")
    var i: i64 = 0
    while i < 1048576 { ELF[i as usize] = 0; i = i + 1 }
    // Header
    elf_w32(0, 0xFEEDFACF); elf_w32(4, 0x0100000C); elf_w32(8, 0)
    elf_w32(12, 2); elf_w32(16, ncmds); elf_w32(20, sizeofcmds); elf_w32(24, 0x00200085)
    // __PAGEZERO
    var off = hdr_size
    elf_w32(off, 25); elf_w32(off+4, lc_pagezero_size)
    elf_w8(off+8, 95); elf_w8(off+9, 95); elf_w8(off+10, 80); elf_w8(off+11, 65); elf_w8(off+12, 71); elf_w8(off+13, 69); elf_w8(off+14, 90); elf_w8(off+15, 69); elf_w8(off+16, 82); elf_w8(off+17, 79)
    elf_w64(off+24, 0); elf_w64(off+32, vm_base)
    // __TEXT
    off = hdr_size + lc_pagezero_size
    elf_w32(off, 25); elf_w32(off+4, lc_text_size)
    elf_w8(off+8, 95); elf_w8(off+9, 95); elf_w8(off+10, 84); elf_w8(off+11, 69); elf_w8(off+12, 88); elf_w8(off+13, 84)
    elf_w64(off+24, text_vm); elf_w64(off+32, text_seg_vmsize)
    elf_w64(off+40, 0); elf_w64(off+48, total_file_size)
    elf_w32(off+56, 7); elf_w32(off+60, 5); elf_w32(off+64, 1)
    let sec = off + 72
    elf_w8(sec, 95); elf_w8(sec+1, 95); elf_w8(sec+2, 116); elf_w8(sec+3, 101); elf_w8(sec+4, 120); elf_w8(sec+5, 116)
    elf_w8(sec+16, 95); elf_w8(sec+17, 95); elf_w8(sec+18, 84); elf_w8(sec+19, 69); elf_w8(sec+20, 88); elf_w8(sec+21, 84)
    elf_w64(sec+32, text_vm + text_file_off); elf_w64(sec+40, CL)
    elf_w32(sec+48, text_file_off); elf_w32(sec+64, 0x80000400)
    // __DATA
    off = hdr_size + lc_pagezero_size + lc_text_size
    elf_w32(off, 25); elf_w32(off+4, lc_data_size)
    elf_w8(off+8, 95); elf_w8(off+9, 95); elf_w8(off+10, 68); elf_w8(off+11, 65); elf_w8(off+12, 84); elf_w8(off+13, 65)
    elf_w64(off+24, data_vm); elf_w64(off+32, ((GL_BSS_SIZE + page_size - 1) / page_size) * page_size)
    elf_w64(off+40, 0); elf_w64(off+48, 0)
    elf_w32(off+56, 7); elf_w32(off+60, 3); elf_w32(off+64, 1)
    let bsec = off + 72
    elf_w8(bsec, 95); elf_w8(bsec+1, 95); elf_w8(bsec+2, 98); elf_w8(bsec+3, 115); elf_w8(bsec+4, 115)
    elf_w8(bsec+16, 95); elf_w8(bsec+17, 95); elf_w8(bsec+18, 68); elf_w8(bsec+19, 65); elf_w8(bsec+20, 84); elf_w8(bsec+21, 65)
    elf_w64(bsec+32, data_vm); elf_w64(bsec+40, GL_BSS_SIZE)
    elf_w32(bsec+48, 0); elf_w32(bsec+64, 1)
    // LC_MAIN
    off = hdr_size + lc_pagezero_size + lc_text_size + lc_data_size
    elf_w32(off, 0x80000028); elf_w32(off+4, lc_main_size)
    elf_w64(off+8, text_file_off + TRAMP_OFF); elf_w64(off+16, 0)
    // Copy code
    i = 0
    while i < CL { ELF[(text_file_off + i) as usize] = CD[i as usize]; i = i + 1 }
    let ok = write_file(output, ELF, total_file_size)
    print("macho_arm64: "); print(output); print(" "); print_int(total_file_size); print(" bytes\n")
    return 0
}

// ─── Import resolver ───
// Hash IMP_PATH[0..len] for dedup
fn imp_path_hash(len: i64) -> i64 with Panic {
    var h: i64 = len * 1000003
    var i: i64 = 0
    while i < len {
        let c = IMP_PATH[i as usize] as i64 & 0xFF
        h = h + c * (i + 1) * 31
        i = i + 1
    }
    return h
}

fn set_base_dir_from_src_path(ps: i64, pe: i64) with Mut, Panic {
    var last_slash: i64 = -1
    var i: i64 = ps
    while i < pe {
        if sb(i) == 47 { last_slash = i }
        i = i + 1
    }
    BASE_DIR_LEN = 0
    if last_slash < 0 {
        BASE_DIR[0 as usize] = 46
        BASE_DIR_LEN = 1
    } else {
        i = ps
        while i < last_slash && BASE_DIR_LEN < 511 {
            BASE_DIR[BASE_DIR_LEN as usize] = sb(i) as i8
            BASE_DIR_LEN = BASE_DIR_LEN + 1
            i = i + 1
        }
    }
    BASE_DIR[BASE_DIR_LEN as usize] = 0
}

// Resolve and load use statements from SRC[0..SRC_LEN]
fn resolve_imports() with IO, Mut, Panic, Div {
    var pos: i64 = 0
    while pos < SRC_LEN {
        if sb(pos) == 1 {
            var marker_s: i64 = pos + 1
            var marker_e: i64 = marker_s
            while marker_e < SRC_LEN && sb(marker_e) != 2 { marker_e = marker_e + 1 }
            if marker_e < SRC_LEN {
                set_base_dir_from_src_path(marker_s, marker_e)
                pos = marker_e + 1
                continue
            }
        }
        // Check for "use " at line start (117=u, 115=s, 101=e, 32=space)
        if pos + 4 < SRC_LEN && sb(pos) == 117 && sb(pos+1) == 115 && sb(pos+2) == 101 && sb(pos+3) == 32 {
            pos = pos + 4  // skip "use "
            // Extract module path until newline, semicolon, or ::*
            var path_start: i64 = pos
            var path_end: i64 = pos
            while pos < SRC_LEN && sb(pos) != 10 && sb(pos) != 59 && sb(pos) != 13 {
                if sb(pos) == 58 && pos + 1 < SRC_LEN && sb(pos+1) == 58 {
                    if pos + 2 < SRC_LEN && sb(pos+2) == 42 {
                        path_end = pos
                        pos = pos + 3  // skip ::*
                        break
                    }
                    if pos + 2 < SRC_LEN && sb(pos+2) == 123 {
                        path_end = pos
                        // Skip ::{...} until }
                        while pos < SRC_LEN && sb(pos) != 125 && sb(pos) != 10 { pos = pos + 1 }
                        if pos < SRC_LEN && sb(pos) == 125 { pos = pos + 1 }
                        break
                    }
                }
                pos = pos + 1
                path_end = pos
            }
            // Build filesystem path: convert :: to /
            var fp_len: i64 = 0
            // Check prefix: stdlib:: or self-hosted::
            var pi: i64 = path_start
            while pi < path_end {
                let c = sb(pi)
                if c == 58 && pi + 1 < path_end && sb(pi+1) == 58 {
                    IMP_PATH[fp_len as usize] = 47  // /
                    fp_len = fp_len + 1
                    pi = pi + 2
                } else if c == 42 || c == 123 || c == 125 || c == 32 {
                    pi = pi + 1  // skip wildcards, braces, spaces
                } else {
                    IMP_PATH[fp_len as usize] = c as i8
                    fp_len = fp_len + 1
                    pi = pi + 1
                }
            }
            // Append .sio if not already present
            if fp_len > 4 && IMP_PATH[(fp_len-4) as usize] == 46 && IMP_PATH[(fp_len-3) as usize] == 115 {
                // already has .sio — skip
            } else {
                IMP_PATH[fp_len as usize] = 46; fp_len = fp_len + 1   // .
                IMP_PATH[fp_len as usize] = 115; fp_len = fp_len + 1  // s
                IMP_PATH[fp_len as usize] = 105; fp_len = fp_len + 1  // i
                IMP_PATH[fp_len as usize] = 111; fp_len = fp_len + 1  // o
            }
            let raw_len = fp_len
            var raw_i: i64 = 0
            while raw_i < raw_len {
                IMP_RAW_PATH[raw_i as usize] = IMP_PATH[raw_i as usize]
                raw_i = raw_i + 1
            }
            IMP_RAW_PATH[raw_len as usize] = 0
            var needs_base_dir: i64 = 1
            if fp_len > 0 && IMP_PATH[0 as usize] as i64 == 47 { needs_base_dir = 0 }
            if fp_len >= 7 {
                if IMP_PATH[0 as usize] as i64 == 115 && IMP_PATH[1 as usize] as i64 == 116 && IMP_PATH[2 as usize] as i64 == 100 && IMP_PATH[3 as usize] as i64 == 108 && IMP_PATH[4 as usize] as i64 == 105 && IMP_PATH[5 as usize] as i64 == 98 && IMP_PATH[6 as usize] as i64 == 47 {
                    needs_base_dir = 0
                }
            }
            if fp_len >= 12 {
                if IMP_PATH[0 as usize] as i64 == 115 && IMP_PATH[1 as usize] as i64 == 101 && IMP_PATH[2 as usize] as i64 == 108 && IMP_PATH[3 as usize] as i64 == 102 && IMP_PATH[4 as usize] as i64 == 45 && IMP_PATH[5 as usize] as i64 == 104 && IMP_PATH[6 as usize] as i64 == 111 && IMP_PATH[7 as usize] as i64 == 115 && IMP_PATH[8 as usize] as i64 == 116 && IMP_PATH[9 as usize] as i64 == 101 && IMP_PATH[10 as usize] as i64 == 100 && IMP_PATH[11 as usize] as i64 == 47 {
                    needs_base_dir = 0
                }
            }
            if needs_base_dir == 1 && BASE_DIR_LEN > 0 {
                var sj: i64 = fp_len - 1
                while sj >= 0 {
                    IMP_PATH[(BASE_DIR_LEN + 1 + sj) as usize] = IMP_PATH[sj as usize]
                    sj = sj - 1
                }
                var bj: i64 = 0
                while bj < BASE_DIR_LEN {
                    IMP_PATH[bj as usize] = BASE_DIR[bj as usize]
                    bj = bj + 1
                }
                IMP_PATH[BASE_DIR_LEN as usize] = 47
                fp_len = BASE_DIR_LEN + 1 + fp_len
            }
            IMP_PATH[fp_len as usize] = 0  // null terminate
            var fsz: i64 = file_size(IMP_PATH)
            if fsz <= 0 && needs_base_dir == 1 {
                fp_len = raw_len
                raw_i = 0
                while raw_i < raw_len {
                    IMP_PATH[raw_i as usize] = IMP_RAW_PATH[raw_i as usize]
                    raw_i = raw_i + 1
                }
                IMP_PATH[fp_len as usize] = 0
                fsz = file_size(IMP_PATH)
                if fsz <= 0 {
                    IMP_PATH[0 as usize] = 115
                    IMP_PATH[1 as usize] = 116
                    IMP_PATH[2 as usize] = 100
                    IMP_PATH[3 as usize] = 108
                    IMP_PATH[4 as usize] = 105
                    IMP_PATH[5 as usize] = 98
                    IMP_PATH[6 as usize] = 47
                    raw_i = 0
                    while raw_i < raw_len {
                        IMP_PATH[(7 + raw_i) as usize] = IMP_RAW_PATH[raw_i as usize]
                        raw_i = raw_i + 1
                    }
                    fp_len = 7 + raw_len
                    IMP_PATH[fp_len as usize] = 0
                    fsz = file_size(IMP_PATH)
                }
            }
            // Dedup check
            let ph = imp_path_hash(fp_len)
            var already: i64 = 0
            var di: i64 = 0
            while di < IMP_COUNT {
                if IMP_LOADED[di as usize] == ph { already = 1 }
                di = di + 1
            }
            if already == 0 && IMP_COUNT < 64 {
                IMP_LOADED[IMP_COUNT as usize] = ph
                IMP_COUNT = IMP_COUNT + 1
                // Try to read the file
                if fsz > 0 && SRC_LEN + fp_len + fsz + 3 < 2097152 {
                    let raw = read_file(IMP_PATH)
                    // Append newline separator
                    SRC[SRC_LEN as usize] = 10
                    SRC_LEN = SRC_LEN + 1
                    SRC[SRC_LEN as usize] = 1
                    SRC_LEN = SRC_LEN + 1
                    var pi2: i64 = 0
                    while pi2 < fp_len {
                        SRC[(SRC_LEN + pi2) as usize] = IMP_PATH[pi2 as usize]
                        pi2 = pi2 + 1
                    }
                    SRC_LEN = SRC_LEN + fp_len
                    SRC[SRC_LEN as usize] = 2
                    SRC_LEN = SRC_LEN + 1
                    // Copy imported source
                    var ci: i64 = 0
                    while ci < fsz { SRC[(SRC_LEN + ci) as usize] = raw[ci as usize]; ci = ci + 1 }
                    SRC_LEN = SRC_LEN + fsz
                    print("import: "); print(IMP_PATH); print(" "); print_int(fsz); print(" bytes\n")
                }
            }
        }
        // Advance to next line
        while pos < SRC_LEN && sb(pos) != 10 { pos = pos + 1 }
        if pos < SRC_LEN { pos = pos + 1 }
    }
}

fn main() -> i64 with IO, Mut, Panic, Div {
    let argc = arg_count()
    if argc < 2 { print("Usage: mini_native <source.sio> <output> [--target x86_64-windows]\n"); return 1 }
    let src = get_arg(0)
    let out = get_arg(1)
    let src_len = str_len(src)
    BASE_DIR_LEN = 0
    var src_i: i64 = 0
    var last_slash: i64 = -1
    while src_i < src_len {
        if str_char_at(src, src_i) == 47 { last_slash = src_i }
        src_i = src_i + 1
    }
    if last_slash < 0 {
        BASE_DIR[0 as usize] = 46
        BASE_DIR_LEN = 1
    } else {
        src_i = 0
        while src_i < last_slash && src_i < 511 {
            BASE_DIR[src_i as usize] = str_char_at(src, src_i) as i8
            src_i = src_i + 1
        }
        BASE_DIR_LEN = src_i
    }
    BASE_DIR[BASE_DIR_LEN as usize] = 0

    // Parse optional --target flag
    if argc >= 4 {
        let flag = get_arg(2)
        let targ = get_arg(3)
        // Check if flag == "--target" and targ == "x86_64-windows"
        if file_size(flag) == 0 && file_size(targ) == 0 {
            // Can't use str_eq (not available in lean), use char comparison
        }
    }
    // Detect target from output extension: .exe → Windows, .macho → macOS
    let out_len = str_len(out)
    if out_len > 4 {
        let c3 = str_char_at(out, out_len - 4)
        let c2 = str_char_at(out, out_len - 3)
        let c1 = str_char_at(out, out_len - 2)
        let c0 = str_char_at(out, out_len - 1)
        if c3 == 46 && (c2 == 101 || c2 == 69) && (c1 == 120 || c1 == 88) && (c0 == 101 || c0 == 69) {
            TARGET_OS = 3
            print("target: x86_64-windows\n")
        }
    }
    // Check for .aarch64.elf suffix (12 chars) BEFORE .macho check
    if out_len > 12 {
        // Match ".aarch64.elf" at end
        let a = str_char_at(out, out_len - 12)  // .
        let b = str_char_at(out, out_len - 11)  // a
        let c = str_char_at(out, out_len - 10)  // a
        let d = str_char_at(out, out_len - 9)   // r
        let e = str_char_at(out, out_len - 8)   // c
        let f = str_char_at(out, out_len - 7)   // h
        let g = str_char_at(out, out_len - 6)   // 6
        let hh = str_char_at(out, out_len - 5)  // 4
        let ii = str_char_at(out, out_len - 4)  // .
        let jj = str_char_at(out, out_len - 3)  // e
        let kk = str_char_at(out, out_len - 2)  // l
        let ll = str_char_at(out, out_len - 1)  // f
        if a == 46 && b == 97 && c == 97 && d == 114 && e == 99 && f == 104 && g == 54 && hh == 52 && ii == 46 && jj == 101 && kk == 108 && ll == 102 {
            TARGET_ARCH = 1
            TARGET_OS = 0
            print("target: aarch64-linux\n")
        }
    }
    // Check for .aarch64.macho suffix (14 chars)
    if out_len > 14 {
        let a2 = str_char_at(out, out_len - 14)   // .
        let b2 = str_char_at(out, out_len - 13)   // a
        let c2a = str_char_at(out, out_len - 12)   // a
        let d2 = str_char_at(out, out_len - 11)   // r
        let e2 = str_char_at(out, out_len - 10)   // c
        let f2 = str_char_at(out, out_len - 9)    // h
        let g2 = str_char_at(out, out_len - 8)    // 6
        let h2 = str_char_at(out, out_len - 7)    // 4
        let i2 = str_char_at(out, out_len - 6)    // .
        let j2 = str_char_at(out, out_len - 5)    // m
        let k2 = str_char_at(out, out_len - 4)    // a
        let l2 = str_char_at(out, out_len - 3)    // c
        let m2a = str_char_at(out, out_len - 2)   // h
        let n2 = str_char_at(out, out_len - 1)    // o
        if a2 == 46 && b2 == 97 && c2a == 97 && d2 == 114 && e2 == 99 && f2 == 104 && g2 == 54 && h2 == 52 && i2 == 46 && j2 == 109 && k2 == 97 && l2 == 99 && m2a == 104 && n2 == 111 {
            TARGET_ARCH = 1
            TARGET_OS = 2
            print("target: aarch64-macos\n")
        }
    }
    // Check for .macho suffix (only if not already detected as aarch64)
    if TARGET_ARCH == 0 && out_len > 6 {
        let m5 = str_char_at(out, out_len - 6)
        let m4 = str_char_at(out, out_len - 5)
        let m3 = str_char_at(out, out_len - 4)
        let m2 = str_char_at(out, out_len - 3)
        let m1 = str_char_at(out, out_len - 2)
        let m0 = str_char_at(out, out_len - 1)
        if m5 == 46 && m4 == 109 && m3 == 97 && m2 == 99 && m1 == 104 && m0 == 111 {
            TARGET_OS = 2
            print("target: x86_64-macos\n")
        }
    }

    let raw = read_file(src)
    let sz = file_size(src)
    var i: i64 = 0
    while i < sz && i < 2097152 { SRC[i as usize] = raw[i as usize]; i = i + 1 }
    SRC_LEN = sz
    print("source: "); print(src); print(" "); print_int(sz); print(" bytes\n")
    resolve_imports()
    print("total source: "); print_int(SRC_LEN); print(" bytes\n")
    lex_all()
    print("tokens: "); print_int(TC); print("\n")
    var cr: i64 = 0
    if TARGET_ARCH == 1 {
        cr = compile_all_arm64()
    } else {
        cr = compile_all()
    }
    if cr != 0 { return cr }
    if TARGET_ARCH == 1 {
        if TARGET_OS == 2 {
            write_macho_arm64(out)
        } else {
            write_elf_arm64(out)
        }
    } else if TARGET_OS == 3 {
        write_pe(out)
    } else if TARGET_OS == 2 {
        write_macho_x86(out)
    } else {
        write_elf(out)
    }
    return 0
}
