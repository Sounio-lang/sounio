        CL_DEPTH = CL_DEPTH + 1
        CL_FNSIG_EFF[(CL_DEPTH - 1) as usize] = 0
        let save_vc_a = VAR_COUNT
        let save_ns_a = NEXT_SLOT
        let save_ld_a = LOOP_DEPTH
        let save_bc_a = BREAK_COUNT
        let save_ret_ty_a = CURRENT_RET_TY
        let save_ret_hash_a = CURRENT_RET_HASH
        let save_sret_slot_a = CURRENT_SRET_SLOT
        let save_a64_fpc = A64_FRAME_PATCH_COUNT
        var svi_a: i64 = 0
        while svi_a < save_vc_a {
            CL_SAVE_NS[svi_a as usize] = VAR_NS[svi_a as usize]
            CL_SAVE_NE[svi_a as usize] = VAR_NE[svi_a as usize]
            CL_SAVE_SL[svi_a as usize] = VAR_SLOT[svi_a as usize]
            CL_SAVE_LS[svi_a as usize] = VAR_LEN_SLOT[svi_a as usize]
            CL_SAVE_AL[svi_a as usize] = VAR_ALEN[svi_a as usize]
            CL_SAVE_ES[svi_a as usize] = VAR_ESIZ[svi_a as usize]
            CL_SAVE_F64[svi_a as usize] = VAR_IS_F64[svi_a as usize]
            CL_SAVE_ISCL[svi_a as usize] = VAR_IS_CLOSURE[svi_a as usize]
            CL_SAVE_MUT[svi_a as usize] = VAR_MUT[svi_a as usize]
            CL_SAVE_UNIT[svi_a as usize] = VAR_UNIT[svi_a as usize]
            CL_SAVE_LINEAR[svi_a as usize] = VAR_LINEAR[svi_a as usize]
            CL_SAVE_USED[svi_a as usize] = VAR_USED[svi_a as usize]
            CL_SAVE_TY[svi_a as usize] = VAR_TY[svi_a as usize]
            CL_SAVE_TH[svi_a as usize] = VAR_TY_HASH[svi_a as usize]
            svi_a = svi_a + 1
        }
        VAR_COUNT = 0
        NEXT_SLOT = 2
        LOOP_DEPTH = 0
        BREAK_COUNT = 0
        CL_CAP_COUNT = 0
        CURRENT_SRET_SLOT = 0
        if zero_param_closure_a == 0 {
            while TK[EP as usize] != 45 && TK[EP as usize] != 0 {
