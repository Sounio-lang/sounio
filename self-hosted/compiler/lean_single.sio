                EXPR_TY_HASH = GL_TY_HASH[gi as usize]
                if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
            } else {
                let fri = fn_find(TS[(EP - 1) as usize], TE[(EP - 1) as usize])
                if fri >= 0 {
                    em32(0x14000002)  // b +8, skipping the wrapper branch
                    let wr_start = CL
                    if FN_OFF[fri as usize] >= 0 {
                        let rel = (FN_OFF[fri as usize] - CL) / 4
                        em32(0x14000000 | (rel & 0x3FFFFFF))
                    } else {
                        PATCH_OFF[PATCH_COUNT as usize] = CL
                        PATCH_FN[PATCH_COUNT as usize] = fri
                        PATCH_KIND[PATCH_COUNT as usize] = 2
                        PATCH_COUNT = PATCH_COUNT + 1
                        em32(0x14000000)
                    }
                    let adr_off = wr_start - CL
                    let adr_immlo = adr_off & 0x3
                    let adr_immhi = (adr_off >> 2) & 0x7FFFF
                    em32(0x10000000 | ((adr_immlo & 0x3) << 29) | ((adr_immhi & 0x7FFFF) << 5) | 0)
                    EXPR_TY = 9
                    EXPR_TY_HASH = FN_SIG[fri as usize]
                    LAST_EXPR_IS_CLOSURE = 0
                }
                else { tc_undefined_var(name_tok); em32(0xD2800000); EXPR_TY = 0; EXPR_TY_HASH = 0 }
            }
            if gi < 0 { EXPR_IS_F64 = 0 }
        }
        return
    }
    EP = EP + 1
    em32(0xD2800000)
    EXPR_IS_F64 = 0
}

// ─── ARM64 postfix ───
fn compile_postfix_a64() with IO, Mut, Panic, Div {
    compile_primary_a64()
    compile_postfix_tail_a64()
}

fn compile_postfix_tail_a64() with IO, Mut, Panic, Div {
    var more: i64 = 1
    while more == 1 {
        if TK[EP as usize] == 37 {
            EP = EP + 1
            let tp = EP
            let src_ty = EXPR_TY
            let src_hash = EXPR_TY_HASH
            let src_is_f64 = EXPR_IS_F64
            let tns = TS[EP as usize]
            let tne = TE[EP as usize]
            scan_type(tp)
            var cast_ty = SCAN_TY
            var cast_hash = SCAN_TY_HASH
            if cast_ty == 0 && name_is_lower(tns, tne) {
                cast_ty = 2
                cast_hash = gl_name_hash(tns, tne)
            }
            // E171: cannot cast Knowledge<T> to its inner type via `as`
            if knowledge_hash_is(src_hash) && !knowledge_hash_is(cast_hash) {
                tc_epistemic_cast_blocked(tp)
            }
            if src_ty == 2 && cast_ty == 2 && src_hash != 0 && cast_hash != 0 && src_hash != cast_hash {
                tc_error(tp, "incompatible unit dimensions")
            }
            if cast_ty == 1 && src_is_f64 == 1 {
                em32(0x9E670000)
                em32(0x9E780000)
            }
            if cast_ty == 2 && src_is_f64 == 0 {
                em32(0x9E620000)
                em32(0x9E660000)
            }
            if cast_ty == 1 && tne - tns == 2 && sb(tns) == 105 && sb(tns+1) == 56 {
                em32(0x93401C00)  // sxtb x0, w0
            }
            EXPR_TY = cast_ty
            EXPR_TY_HASH = cast_hash
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
            EP = SCAN_TY_NEXT
            continue
        }
        if TK[EP as usize] == 41 {
            let base_ty = EXPR_TY
            let base_hash = EXPR_TY_HASH
            emit_push_a64()
            EP = EP + 1
            compile_or_a64()
            if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
            if TK[EP as usize] == 42 { EP = EP + 1 }
            em32(0xAA0003E9)  // mov x9, x0 (index)
            emit_pop_x1_a64()
            em32(0xAA0103E0)  // mov x0, x1 (base)
            if base_ty == 8 {
                let esiz = arr_hash_esiz(base_hash)
                var elem_ty = arr_hash_elem_ty(base_hash)
                if elem_ty == 0 { elem_ty = 1 }
                LAST_ALEN = arr_hash_alen(base_hash)
                if esiz == 8 {
                    em32(0xF8697800)
                    EXPR_TY = elem_ty
                    EXPR_TY_HASH = 0
                    if elem_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                } else {
                    em32(0x38A96800)
                    EXPR_TY = 1
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 0
                }
            } else if type_is_slice_ref(base_ty, base_hash) {
                let inner_hash = ref_hash_inner_hash(base_hash)
                let esiz = arr_hash_esiz(inner_hash)
                var elem_ty = arr_hash_elem_ty(inner_hash)
                if elem_ty == 0 { elem_ty = 1 }
                em32(0xF940042A)  // ldr x10, [x1, #8] (len)
                em32(0xEB00001F | (10 << 16) | (9 << 5))  // cmp x9, x10
                let slice_ok_patch_a = CL
                em32(0x54000003)  // b.lo ok
                emit_assert_fail_a64()
                patch_branch_a64(slice_ok_patch_a, CL)
                em32(0xF9400020)  // ldr x0, [x1] (data ptr)
                if esiz == 8 {
                    em32(0xF8697800)
                    EXPR_TY = elem_ty
                    EXPR_TY_HASH = 0
                    if elem_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                } else {
                    em32(0x38A96800)
                    EXPR_TY = 1
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 0
                }
            } else {
                em32(0x38A96800)
                EXPR_TY = 1
                EXPR_TY_HASH = 0
                EXPR_IS_F64 = 0
            }
            continue
        }
        if TK[EP as usize] == 50 {
            EP = EP + 1
            let method_tok = EP
            let fns = TS[EP as usize]
            let fne = TE[EP as usize]
            let fh = gl_name_hash(fns, fne)
            // Built-in .len() — return compile-time array length (ARM64)
            if src_match(fns, fne - fns, "len") && TK[(EP + 1) as usize] == 6 && TK[(EP + 2) as usize] == 7 {
                EP = EP + 1  // skip 'len'
                EP = EP + 1  // skip (
                EP = EP + 1  // skip )
                if type_is_slice_ref(EXPR_TY, EXPR_TY_HASH) {
                    em32(0xF9400400)  // ldr x0, [x0, #8]
                } else {
                    emit_imm64_a64(LAST_ALEN)
                }
                EXPR_TY = 1
                EXPR_TY_HASH = 0
                EXPR_IS_F64 = 0
                continue
            }
            // Built-in .unwrap(reason) — extract .value field (offset 0) from struct (ARM64)
            if src_match(fns, fne - fns, "unwrap") && TK[(EP + 1) as usize] == 6 {
                // E170: unwrap on Knowledge<T> requires `with Epistemic`
                if knowledge_hash_is(EXPR_TY_HASH) && (FN_EFFECTS[CURRENT_FN as usize] & 512) == 0 {
                    tc_epistemic_value_access(method_tok)
                }
                EP = EP + 1  // skip 'unwrap'
                EP = EP + 1  // skip (
                var uw_depth_a: i64 = 1
                while uw_depth_a > 0 && EP < TC {
                    if TK[EP as usize] == 6 { uw_depth_a = uw_depth_a + 1 }
                    if TK[EP as usize] == 7 { uw_depth_a = uw_depth_a - 1 }
                    if uw_depth_a > 0 { EP = EP + 1 }
                }
                if TK[EP as usize] == 7 { EP = EP + 1 }  // skip )
                em32(0xF9400000)  // ldr x0, [x0]
                if knowledge_hash_is(EXPR_TY_HASH) {
                    let inner_hash_a = knowledge_hash_inner_hash(EXPR_TY_HASH)
                    EXPR_TY = knowledge_hash_inner_ty(EXPR_TY_HASH)
                    EXPR_TY_HASH = inner_hash_a
                    if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                } else if EXPR_TY == 6 {
                    let uw_si_a = st_find(EXPR_TY_HASH)
                    if uw_si_a >= 0 {
                        EXPR_TY = ST_FTY[(uw_si_a * 128) as usize]
                        EXPR_TY_HASH = ST_FHASH[(uw_si_a * 128) as usize]
                        if EXPR_TY == 2 { EXPR_IS_F64 = 1 }
                    }
                }
                continue
            }
            // Math intrinsic methods (ARM64): val.sqrt(), val.exp(), etc.
            if TK[(EP + 1) as usize] == 6 && TK[(EP + 2) as usize] == 7 {
                var is_math_mm_a: i64 = 0
                var math_mm_fi_a: i64 = -1
                if src_match(fns, fne - fns, "sqrt") { is_math_mm_a = 1; math_mm_fi_a = fn_find_lit("__native_sqrt_f64") }
                if src_match(fns, fne - fns, "exp") { is_math_mm_a = 1; math_mm_fi_a = fn_find_lit("__native_exp_f64") }
                if src_match(fns, fne - fns, "ln") || src_match(fns, fne - fns, "log") { is_math_mm_a = 1; math_mm_fi_a = fn_find_lit("__native_ln_f64") }
                if src_match(fns, fne - fns, "sin") { is_math_mm_a = 1; math_mm_fi_a = fn_find_lit("__native_sin_f64") }
                if src_match(fns, fne - fns, "cos") { is_math_mm_a = 1; math_mm_fi_a = fn_find_lit("__native_cos_f64") }
                if src_match(fns, fne - fns, "tanh") { is_math_mm_a = 1; math_mm_fi_a = fn_find_lit("__native_tanh_f64") }
                if src_match(fns, fne - fns, "abs") { is_math_mm_a = 1; math_mm_fi_a = fn_find_lit("__native_abs_f64") }
                if src_match(fns, fne - fns, "floor") { is_math_mm_a = 1; math_mm_fi_a = fn_find_lit("__native_floor_f64") }
                if is_math_mm_a == 1 {
                    EP = EP + 1  // skip method name
                    EP = EP + 1  // skip (
                    EP = EP + 1  // skip )
                    if math_mm_fi_a >= 0 {
                        emit_push_a64()
                        emit_direct_fn_call_a64(math_mm_fi_a, 1)
                    } else {
                        tc_error(method_tok, "missing native math helper")
                        em32(0xD2800000)  // mov x0, #0
                        EXPR_IS_F64 = 0
                        EXPR_TY = 0
                        EXPR_TY_HASH = 0
                    }
                    EXPR_IS_F64 = 1
                    EXPR_TY = 2
                    EXPR_TY_HASH = 0
                    continue
                }
            }
            if TK[(EP + 1) as usize] == 6 {
                var recv_h = EXPR_TY_HASH
                if EXPR_TY == 10 {
                    recv_h = ref_hash_inner_hash(EXPR_TY_HASH)
                }
                let mfi = fn_find_method(fns, fne, recv_h)
                if mfi >= 0 {
                    EP = EP + 1; EP = EP + 1
                    // TODO: Add auto-borrow for ARM64 (see x86_64 version)
                    materialize_aggregate_expr_a64()
                    emit_push_a64()
                    var margc: i64 = 1
                    while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
                        compile_or_a64()
                        materialize_aggregate_expr_a64()
                        emit_push_a64()
                        margc = margc + 1
                        if TK[EP as usize] == 28 { EP = EP + 1 }
                    }
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                    if FN_ARITY[mfi as usize] != margc { tc_wrong_arity(method_tok, FN_ARITY[mfi as usize], margc) }
                    if margc >= 8 { em32(0xF8410FE7) }
                    if margc >= 7 { em32(0xF8410FE6) }
                    if margc >= 6 { em32(0xF8410FE5) }
                    if margc >= 5 { em32(0xF8410FE4) }
                    if margc >= 4 { em32(0xF8410FE3) }
                    if margc >= 3 { em32(0xF8410FE2) }
                    if margc >= 2 { emit_pop_x1_a64() }
                    if margc >= 1 { em32(0xF8410FE0) }
                    PATCH_OFF[PATCH_COUNT as usize] = CL
                    PATCH_FN[PATCH_COUNT as usize] = mfi
                    PATCH_KIND[PATCH_COUNT as usize] = 0
                    PATCH_COUNT = PATCH_COUNT + 1
                    em32(0x94000000)
                    EXPR_TY = FN_RET_TY[mfi as usize]
                    EXPR_TY_HASH = FN_RET_HASH[mfi as usize]
                    if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                    continue
                }
            }
            let base_ty = EXPR_TY
            let base_hash = EXPR_TY_HASH
            var base_data_ty = base_ty
            var base_data_hash = base_hash
            if base_ty == 10 {
                base_data_ty = ref_hash_inner_ty(base_hash)
                base_data_hash = ref_hash_inner_hash(base_hash)
            }
            EP = EP + 1
            var found: i64 = 0
            EXPR_TY = 0
            EXPR_TY_HASH = 0
            if knowledge_hash_is(base_data_hash) {
                if src_match(fns, fne - fns, "value") {
                    // E170: accessing .value on Knowledge<T> requires `with Epistemic`
                    if (FN_EFFECTS[CURRENT_FN as usize] & 512) == 0 {
                        tc_epistemic_value_access(method_tok)
                    }
                    em32(0xF9400000)
                    EXPR_TY = knowledge_hash_inner_ty(base_data_hash)
                    EXPR_TY_HASH = knowledge_hash_inner_hash(base_data_hash)
                    if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                } else if src_match(fns, fne - fns, "variance") {
                    em32(0xF9400400)
                    EXPR_TY = 2
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 1
                } else if src_match(fns, fne - fns, "confidence") {
                    em32(0xF9400800)
                    EXPR_TY = 2
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 1
                } else {
                    tc_error(method_tok, "unknown field access")
                    em32(0xD2800000)
                    EXPR_IS_F64 = 0
                }
                found = 1
            }
            if base_data_ty == 6 {
                let bsi = st_find(base_data_hash)
                if bsi >= 0 {
                    let off = st_field_offset(bsi, fh)
                    if off >= 0 {
                        EXPR_TY = st_field_ty(bsi, fh)
                        EXPR_TY_HASH = st_field_hash(bsi, fh)
                        if EXPR_TY == 8 || EXPR_TY == 6 || knowledge_hash_is(EXPR_TY_HASH) {
                            if off != 0 {
                                emit_imm64_reg_a64(1, off)
                                em32(0x8B010000)
                            }
                        } else {
                            if off == 0 { em32(0xF9400000) }
                            else { em32(0xF9400000 | ((off / 8) << 10) | (0 << 5) | 0) }
                        }
                        if EXPR_TY == 8 { LAST_ALEN = arr_hash_alen(EXPR_TY_HASH) }
                    } else {
                        tc_error(method_tok, "unknown field access")
                        em32(0xD2800000)
                    }
                    found = 1
                }
            }
            var si: i64 = 0
            while si < ST_COUNT && found == 0 {
                let off = st_field_offset(si, fh)
                if off >= 0 {
                    EXPR_TY = st_field_ty(si, fh)
                    EXPR_TY_HASH = st_field_hash(si, fh)
                    if EXPR_TY == 8 || EXPR_TY == 6 || knowledge_hash_is(EXPR_TY_HASH) {
                        if off != 0 {
                            emit_imm64_reg_a64(1, off)
                            em32(0x8B010000)
                        }
                    } else {
                        if off == 0 { em32(0xF9400000) }
                        else { em32(0xF9400000 | ((off / 8) << 10) | (0 << 5) | 0) }
                    }
                    if EXPR_TY == 8 { LAST_ALEN = arr_hash_alen(EXPR_TY_HASH) }
                    found = 1
                }
                si = si + 1
            }
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
            continue
        }
        more = 0
    }
}

// ─── ARM64 multiplicative ───
fn compile_multiplicative_a64() with IO, Mut, Panic, Div {
    compile_postfix_a64()
    var lhs_end_line: i64 = TL[(EP - 1) as usize]
    while TK[EP as usize] == 19 || TK[EP as usize] == 20 || TK[EP as usize] == 29 {
        if EXPR_TY == 11 && TK[EP as usize] == 19 && TL[EP as usize] > lhs_end_line { return }
        let op = TK[EP as usize]
        EP = EP + 1
        let left_f64 = EXPR_IS_F64
        emit_push_a64()
        compile_postfix_a64()
        emit_pop_x1_a64()
        if left_f64 == 1 {
            if op == 19 { emit_f64_binop_a64(0x1E610800) }
            if op == 20 { emit_f64_binop_a64(0x1E611800) }
            if op == 29 { em32(0x9B007C20) }
            EXPR_IS_F64 = 1
        } else {
            if op == 19 { em32(0x9B007C20) }  // mul x0, x1, x0
            if op == 20 { em32(0x9AC00C20) }  // sdiv x0, x1, x0
            if op == 29 {
                em32(0x9AC00C00 | (0 << 16) | (1 << 5) | 9)
                em32(0x9B000000 | (0 << 16) | (1 << 10) | (9 << 5) | 0)
            }
        }
        lhs_end_line = TL[(EP - 1) as usize]
    }
}

// ─── ARM64 additive ───
fn compile_additive_a64() with IO, Mut, Panic, Div {
    compile_multiplicative_a64()
    while TK[EP as usize] == 17 || TK[EP as usize] == 18 {
        let op = TK[EP as usize]
        EP = EP + 1
        let left_f64 = EXPR_IS_F64
        emit_push_a64()
        compile_multiplicative_a64()
        emit_pop_x1_a64()
        if left_f64 == 1 {
            if op == 17 { emit_f64_binop_a64(0x1E612800) }
            if op == 18 { emit_f64_binop_a64(0x1E613800) }
            EXPR_IS_F64 = 1
        } else {
            if op == 17 { em32(0x8B000020) }
            if op == 18 { em32(0xCB000020) }
        }
    }
}

// ─── ARM64 shift ───
fn compile_shift_a64() with IO, Mut, Panic, Div {
    compile_additive_a64()
    while TK[EP as usize] == 39 || TK[EP as usize] == 40 {
        let op = TK[EP as usize]
        EP = EP + 1
        emit_push_a64()
        compile_additive_a64()
        emit_pop_x1_a64()
        if op == 40 { em32(0x9AC02020) }
        if op == 39 { em32(0x9AC02820) }
    }
}

// ─── ARM64 bitand ───
fn compile_bitand_a64() with IO, Mut, Panic, Div {
    compile_shift_a64()
    while TK[EP as usize] == 44 {
        EP = EP + 1; emit_push_a64(); compile_shift_a64()
        emit_pop_x1_a64()
        em32(0x8A010000)
    }
}

// ─── ARM64 bitxor ───
fn compile_bitxor_a64() with IO, Mut, Panic, Div {
    compile_bitand_a64()
    while TK[EP as usize] == 56 {
        EP = EP + 1; emit_push_a64(); compile_bitand_a64()
        emit_pop_x1_a64()
        em32(0xCA010000)
    }
}

// ─── ARM64 bitor ───
fn compile_bitor_a64() with IO, Mut, Panic, Div {
    compile_bitxor_a64()
    while TK[EP as usize] == 45 {
        EP = EP + 1; emit_push_a64(); compile_bitxor_a64()
        emit_pop_x1_a64()
        em32(0xAA010000)
    }
}

// ─── ARM64 comparison ───
fn compile_comparison_a64() with IO, Mut, Panic, Div {
    compile_bitor_a64()
    let op = TK[EP as usize]
    if op == 21 || op == 22 || op == 23 || op == 24 || op == 25 || op == 26 {
        let op_tok = EP
        let left_raw_f64 = EXPR_IS_F64
        let left_raw_ty = EXPR_TY
        let left_raw_hash = EXPR_TY_HASH
        EP = EP + 1
        emit_push_a64()
        compile_bitor_a64()
        let right_raw_ty = EXPR_TY
        let right_raw_hash = EXPR_TY_HASH
        comparison_require_observe(op_tok, left_raw_ty, right_raw_ty)
        let left_ty = comparison_visible_ty(left_raw_ty, left_raw_hash)
        let left_hash = comparison_visible_hash(left_raw_ty, left_raw_hash)
        let right_ty = comparison_visible_ty(right_raw_ty, right_raw_hash)
        let right_hash = comparison_visible_hash(right_raw_ty, right_raw_hash)
        let left_f64 = if left_raw_f64 == 1 || left_ty == 2 { 1 } else { 0 }
        if op == 21 || op == 22 {
            if ty_eq(left_ty, left_hash, right_ty, right_hash) == false {
                if left_ty != 0 && right_ty != 0 {
                    if (left_ty == 2 && right_ty == 2) == false {
                        if (left_ty == 1 && right_ty == 1) == false {
                            tc_error(op_tok, "comparison operands must have the same type")
                        }
                    }
                }
            }
        } else {
            if left_ty != 0 && right_ty != 0 {
                if ty_is_numeric(left_ty) == false || ty_is_numeric(right_ty) == false || ty_eq(left_ty, left_hash, right_ty, right_hash) == false {
                    tc_error(op_tok, "ordered comparison requires matching numeric operands")
                }
            }
        }
        emit_pop_x1_a64()
        if left_f64 == 1 {
            em32(0x9E670020); em32(0x9E670001); em32(0x1E612020)
            if op == 21 { em32(0x9A9F17E0) }
            if op == 22 { em32(0x9A9F07E0) }
            if op == 23 { em32(0x9A9F57E0) }
            if op == 24 { em32(0x9A9FC7E0) }
            if op == 25 { em32(0x9A9F87E0) }
            if op == 26 { em32(0x9A9FB7E0) }
        } else {
            em32(0xEB00003F)
            if op == 21 { em32(0x9A9F17E0) }
            if op == 22 { em32(0x9A9F07E0) }
            if op == 23 { em32(0x9A9FA7E0) }
            if op == 24 { em32(0x9A9FC7E0) }
            if op == 25 { em32(0x9A9FD7E0) }
            if op == 26 { em32(0x9A9FB7E0) }
        }
        EXPR_IS_F64 = 0
        EXPR_TY = 4
        EXPR_TY_HASH = 0
    }
}

// ─── ARM64 logical AND ───
fn compile_and_a64() with IO, Mut, Panic, Div {
    compile_comparison_a64()
    while TK[EP as usize] == 30 {
        EP = EP + 1
        let cbz_off = CL
        em32(0xB4000000)
        compile_comparison_a64()
        em32(0xF100001F); em32(0x9A9F07E0)
        let b_off = CL
        em32(0x14000000)
        patch_branch_a64(cbz_off, CL)
        em32(0xD2800000)
        patch_branch_a64(b_off, CL)
    }
}

// ─── ARM64 logical OR ───
fn compile_or_a64() with IO, Mut, Panic, Div {
    compile_and_a64()
    while TK[EP as usize] == 31 {
        EP = EP + 1
        let cbnz_off = CL
        em32(0xB5000000)
        compile_and_a64()
        let b_off = CL
        em32(0x14000000)
        patch_branch_a64(cbnz_off, CL)
        emit_imm64_a64(1)
        patch_branch_a64(b_off, CL)
    }
}

// ─── ARM64 statement compiler ───
fn compile_stmt_a64() with IO, Mut, Panic, Div {
    let k = TK[EP as usize]
    LAST_STMT_HAS_VALUE = 0
    if k == 27 { EP = EP + 1; return }
    // let/var
    if k == 11 || k == 12 {
        EP = EP + 1
        if TK[EP as usize] == 6 {
            let pat_start = EP
            var pat_p = EP
            var pat_depth: i64 = 0
            while pat_p < TC {
                if TK[pat_p as usize] == 6 { pat_depth = pat_depth + 1 }
                if TK[pat_p as usize] == 7 {
                    pat_depth = pat_depth - 1
                    pat_p = pat_p + 1
                    if pat_depth == 0 { break }
                    continue
                }
                pat_p = pat_p + 1
            }
            EP = pat_p
            if TK[EP as usize] == 16 { EP = EP + 1 }
            if TK[EP as usize] != 6 { tc_error(EP, "tuple destructuring requires tuple literal") }
            tuple_bind_pattern_a64(pat_start, EP)
            EP = TUP_RHS_NEXT
            return
        }
        let ns = TS[EP as usize]
        let ne = TE[EP as usize]
        EP = EP + 1
        var is_arr: i64 = 0
        var arr_len: i64 = 0
        var arr_esiz: i64 = 8
        var decl_is_f64: i64 = -1
        var decl_ty: i64 = 0
        var decl_ty_hash: i64 = 0
        let decl_is_mut = k == 12
        if TK[EP as usize] == 43 {
            EP = EP + 1
            let ann_ns = TS[EP as usize]
            let ann_ne = TE[EP as usize]
            if TK[EP as usize] == 41 {
                EP = EP + 1
                let etns = TS[EP as usize]
                let etne = TE[EP as usize]
                let arr_elem_ty = type_name_kind(etns, etne)
                if src_match(etns, etne - etns, "i8") { arr_esiz = 1 }
                EP = EP + 1
                if TK[EP as usize] == 27 { EP = EP + 1 }
                arr_len = TV[EP as usize]; EP = EP + 1
                if TK[EP as usize] == 42 { EP = EP + 1 }
                is_arr = 1
                decl_ty = 8
                decl_ty_hash = arr_ty_hash(arr_len, arr_esiz, arr_elem_ty)
                decl_is_f64 = 0
            } else {
                scan_type(EP)
                decl_ty = SCAN_TY
                decl_ty_hash = SCAN_TY_HASH
                if knowledge_hash_invalid(decl_ty_hash) {
                    if 1 == 1 {
                        print("DEBUG decl ty=")
                        print_int(decl_ty)
                        print(" hash=")
                        print_int(decl_ty_hash)
                        print(" eps=")
                        print_int(knowledge_hash_eps(decl_ty_hash))
                        print("\n")
                    }
                    tc_epistemic_boundary(EP)
                    decl_ty = 0
                    decl_ty_hash = 0
                }
                if decl_ty == 0 && name_is_lower(ann_ns, ann_ne) {
                    decl_ty = 2
                    decl_ty_hash = gl_name_hash(ann_ns, ann_ne)
                }
                if decl_ty == 2 { decl_is_f64 = 1 }
                else { decl_is_f64 = 0 }
                EP = SCAN_TY_NEXT
            }
        }
        if TK[EP as usize] == 16 { EP = EP + 1 }
        if is_arr == 1 && arr_len > 0 && TK[EP as usize] == 41 && array_init_is_repeat(EP) {
            EP = EP + 1
            while TK[EP as usize] != 42 && TK[EP as usize] != 0 { EP = EP + 1 }
            if TK[EP as usize] == 42 { EP = EP + 1 }
            let nslots = arr_len
            if arr_esiz == 1 { nslots = (arr_len + 7) / 8 }
            let ptr_slot = var_add_arr(ns, ne, nslots, arr_esiz, arr_hash_elem_ty(decl_ty_hash))
            if ptr_slot < 0 { return }
            let arr_vi = VAR_COUNT - 1
            VAR_TY[arr_vi as usize] = 8
            VAR_TY_HASH[arr_vi as usize] = decl_ty_hash
            let base = ptr_slot - nslots
            if LAST_LOCAL_BSS_SPILL != 0 {
                emit_imm64_reg_a64(11, LAST_LOCAL_BSS_ADDR)
                emit_zero_words_x11_a64(nslots)
                emit_imm64_reg_a64(0, LAST_LOCAL_BSS_ADDR)
            } else {
                emit_lea_var_a64(base + nslots - 1)
                em32(0xAA0003EB)  // mov x11, x0
                emit_zero_words_x11_a64(nslots)
                emit_lea_var_a64(base + nslots - 1)
            }
            emit_store_var_a64(ptr_slot)
        } else {
            compile_or_a64()
            if (decl_ty != 0 || decl_ty_hash != 0) && ty_eq(decl_ty, decl_ty_hash, EXPR_TY, EXPR_TY_HASH) == false {
                if type_has_knowledge(decl_ty, decl_ty_hash) || type_has_knowledge(EXPR_TY, EXPR_TY_HASH) {
                    tc_epistemic_boundary(EP)
                } else {
                    tc_error(EP - 1, "initializer type does not match declaration")
                }
            }
            if type_is_slice_ref(decl_ty, decl_ty_hash) || (decl_ty == 0 && type_is_slice_ref(EXPR_TY, EXPR_TY_HASH)) {
                var bind_hash = EXPR_TY_HASH
                if decl_ty != 0 || decl_ty_hash != 0 { bind_hash = decl_ty_hash }
                let before_vc = VAR_COUNT
                bind_slice_local_from_x0_a64(ns, ne, bind_hash)
                if VAR_COUNT > before_vc {
                    let svix = VAR_COUNT - 1
                    VAR_IS_CLOSURE[svix as usize] = 0
                    VAR_MUT[svix as usize] = decl_is_mut
                    VAR_LINEAR[svix as usize] = 0
                }
            } else if (decl_ty == 8) || (decl_ty == 0 && EXPR_TY == 8) {
                var bind_hash = EXPR_TY_HASH
                if decl_ty == 8 { bind_hash = decl_ty_hash }
                let before_vc = VAR_COUNT
                bind_array_local_from_x0_a64(ns, ne, bind_hash)
                if VAR_COUNT > before_vc {
                    let avix = VAR_COUNT - 1
                    VAR_IS_CLOSURE[avix as usize] = 0
                    VAR_MUT[avix as usize] = decl_is_mut
                    VAR_LINEAR[avix as usize] = 0
                }
            } else if type_is_struct_like(decl_ty, decl_ty_hash) || (decl_ty == 0 && type_is_struct_like(EXPR_TY, EXPR_TY_HASH)) {
                var bind_hash = EXPR_TY_HASH
                if decl_ty != 0 || decl_ty_hash != 0 { bind_hash = decl_ty_hash }
                let before_vc = VAR_COUNT
                bind_struct_local_from_x0_a64(ns, ne, bind_hash)
                if VAR_COUNT > before_vc {
                    let svix = VAR_COUNT - 1
                    VAR_IS_CLOSURE[svix as usize] = 0
                    VAR_MUT[svix as usize] = decl_is_mut
                }
            } else if (decl_ty == 12 && tuple2_is(decl_ty_hash)) || (decl_ty == 0 && EXPR_TY == 12 && tuple2_is(EXPR_TY_HASH)) {
                var bind_hash = EXPR_TY_HASH
                if decl_ty == 12 && tuple2_is(decl_ty_hash) { bind_hash = decl_ty_hash }
                let before_vc = VAR_COUNT
                bind_tuple_local_from_x0_a64(ns, ne, bind_hash)
                if VAR_COUNT > before_vc {
                    let tvix = VAR_COUNT - 1
                    VAR_IS_CLOSURE[tvix as usize] = 0
                    VAR_MUT[tvix as usize] = decl_is_mut
                }
            } else {
                let slot = var_add(ns, ne)
                if slot < 0 { return }
                let vix = VAR_COUNT - 1
                emit_store_var_a64(slot)
                if decl_is_f64 == 1 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 1 }
                else if decl_is_f64 == 0 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 0 }
                else { VAR_IS_F64[(VAR_COUNT - 1) as usize] = EXPR_IS_F64 }
                if decl_ty != 0 || decl_ty_hash != 0 {
                    VAR_TY[vix as usize] = decl_ty
                    VAR_TY_HASH[vix as usize] = decl_ty_hash
                } else {
                    VAR_TY[vix as usize] = EXPR_TY
                    VAR_TY_HASH[vix as usize] = EXPR_TY_HASH
                }
                if VAR_TY[vix as usize] == 8 {
                    VAR_ALEN[vix as usize] = arr_hash_alen(VAR_TY_HASH[vix as usize])
                    VAR_ESIZ[vix as usize] = arr_hash_esiz(VAR_TY_HASH[vix as usize])
                }
                VAR_IS_CLOSURE[(VAR_COUNT - 1) as usize] = LAST_EXPR_IS_CLOSURE
                VAR_MUT[(VAR_COUNT - 1) as usize] = decl_is_mut
                VAR_LINEAR[(VAR_COUNT - 1) as usize] = LAST_EXPR_IS_LINEAR
            }
        }
        return
    }
    // x.field[idx] = expr
    if stmt_is_field_array_store(EP) {
        if current_fn_allows_mutation() == false {
            tc_effect_violation(EP, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        compile_field_array_store_a64()
        return
    }

    // x.field = expr
    if k == 3 && TK[(EP + 1) as usize] == 50 && TK[(EP + 3) as usize] == 16 {
        let name_tok = EP
        if current_fn_allows_mutation() == false {
            tc_effect_violation(name_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[EP as usize]; let ne = TE[EP as usize]
        let field_tok = EP + 2
        EP = EP + 2
        let fns = TS[EP as usize]; let fne = TE[EP as usize]
        let fh = gl_name_hash(fns, fne)
        EP = EP + 1
        if TK[EP as usize] == 16 { EP = EP + 1 }
        compile_or_a64()
        let rhs_ty = EXPR_TY
        let rhs_ty_hash = EXPR_TY_HASH
        let si = resolve_field_struct_index(ns, ne, fh)
        if si < 0 {
            tc_error(field_tok, "unknown field access")
            return
        }
        let off = st_field_offset(si, fh)
        let fty = st_field_ty(si, fh)
        let fhash = st_field_hash(si, fh)
        if fty != 0 && ty_eq(fty, fhash, rhs_ty, rhs_ty_hash) == false {
            tc_error(EP - 1, "assignment type mismatch")
        }
        emit_push_a64()
        let slot = var_find(ns, ne)
        if slot >= 0 { emit_load_var_a64(slot) }
        else {
            let gi = gl_find(ns, ne)
            if gi >= 0 { emit_imm64_a64(GL_BSS_BASE + GL[(gi * 4 + 1) as usize]) }
            else { tc_undefined_var(name_tok); em32(0xD2800000) }
        }
        if off != 0 {
            emit_imm64_reg_a64(11, off)
            em32(0x8B0B0000)  // add x0, x0, x11
        }
        emit_pop_x1_a64()
        if fty == 8 || fty == 6 || knowledge_hash_is(fhash) {
            em32(0xAA0103EA)  // mov x10, x1
            emit_copy_agg_to_ptr_a64(fty, fhash)
        } else {
            em32(0xF9000001)  // str x1, [x0]
        }
        return
    }
    // x = expr
    if k == 3 && TK[(EP + 1) as usize] == 16 {
        let name_tok = EP
        if current_fn_allows_mutation() == false {
            tc_effect_violation(name_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[EP as usize]; let ne = TE[EP as usize]
        EP = EP + 2
        compile_or_a64()
        let rhs_ty = EXPR_TY
        let rhs_ty_hash = EXPR_TY_HASH
        let slot = var_find(ns, ne)
        if slot >= 0 {
            let ty_vi = var_find_idx(ns, ne)
            if ty_vi >= 0 {
                if ty_eq(VAR_TY[ty_vi as usize], VAR_TY_HASH[ty_vi as usize], rhs_ty, rhs_ty_hash) == false {
                    tc_error(EP - 1, "assignment type mismatch")
                }
            }
            if ty_vi >= 0 && VAR_TY[ty_vi as usize] == 8 {
                copy_array_into_local_slot_a64(slot, VAR_TY_HASH[ty_vi as usize])
            } else if ty_vi >= 0 && type_is_struct_like(VAR_TY[ty_vi as usize], VAR_TY_HASH[ty_vi as usize]) {
                copy_struct_into_local_slot_a64(slot, VAR_TY_HASH[ty_vi as usize])
            } else if ty_vi >= 0 && VAR_TY[ty_vi as usize] == 12 && tuple2_is(VAR_TY_HASH[ty_vi as usize]) {
                copy_tuple_into_local_slot_a64(slot, VAR_TY_HASH[ty_vi as usize])
            } else {
                emit_store_var_a64(slot)
            }
            var vi: i64 = VAR_COUNT - 1
            while vi >= 0 {
                if name_eq(VAR_NS[vi as usize], VAR_NE[vi as usize], ns, ne) { VAR_IS_CLOSURE[vi as usize] = LAST_EXPR_IS_CLOSURE; vi = -1 }
                vi = vi - 1
            }
        } else {
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                if ty_eq(GL_TY[gi as usize], GL_TY_HASH[gi as usize], rhs_ty, rhs_ty_hash) == false {
                    tc_error(EP - 1, "assignment type mismatch")
                }
                let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                em32(0xAA0003E1)
                emit_imm64_a64(addr)
                em32(0xF9000001)
            } else {
                tc_undefined_var(name_tok)
            }
        }
        return
    }
    // ARRAY[idx] = expr
    if stmt_is_array_store(EP) {
        let name_tok = EP
        if current_fn_allows_mutation() == false {
            tc_effect_violation(name_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[EP as usize]; let ne = TE[EP as usize]
        EP = EP + 2
        compile_or_a64()
        if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
        if TK[EP as usize] == 42 { EP = EP + 1 }
        if TK[EP as usize] == 16 { EP = EP + 1 }
        emit_push_a64()
        compile_or_a64()
        let gi = gl_find(ns, ne)
        if gi >= 0 {
            let base = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
            let esz = GL[(gi * 4 + 2) as usize]
            em32(0xAA0003EA)
            emit_pop_x1_a64()
            emit_imm64_a64(base)
            if esz == 8 { em32(0xF821780A) }
            else { em32(0x3821680A) }
        } else {
            let lslot = var_find(ns, ne)
            if lslot >= 0 {
                let llalen = var_find_alen(ns, ne)
                let lesiz = var_find_esiz(ns, ne)
                let lvi = var_find_idx(ns, ne)
                var is_arr_ty = 0
                var is_slice_ty = 0
                if lvi >= 0 && VAR_TY[lvi as usize] == 8 { is_arr_ty = 1 }
                if lvi >= 0 && VAR_TY[lvi as usize] == 10 {
                    if ref_hash_inner_ty(VAR_TY_HASH[lvi as usize]) == 8 {
                        is_arr_ty = 1
                        if type_is_slice_ref(VAR_TY[lvi as usize], VAR_TY_HASH[lvi as usize]) { is_slice_ty = 1 }
                    }
                }
                em32(0xAA0003EA)
                emit_pop_x1_a64()
                if is_slice_ty == 1 {
                    emit_load_var_a64(VAR_LEN_SLOT[lvi as usize])
                    em32(0xEB00003F)  // cmp x1, x0
                    let slice_store_ok = CL
                    em32(0x54000003)  // b.lo ok
                    emit_assert_fail_a64()
                    patch_branch_a64(slice_store_ok, CL)
                }
                emit_load_var_a64(lslot)
                if is_arr_ty == 1 && lesiz == 8 { em32(0xF821780A) }
                else { em32(0x3821680A) }
            } else {
                tc_undefined_var(name_tok)
                emit_pop_x1_a64()
            }
        }
        return
    }
    // (*ARRAY_PTR)[idx] = expr
    if stmt_is_deref_array_store(EP) {
        let name_tok = EP + 2
        if current_fn_allows_mutation() == false {
            tc_effect_violation(name_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[(EP + 2) as usize]; let ne = TE[(EP + 2) as usize]
        EP = EP + 5
        compile_or_a64()
        if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
        if TK[EP as usize] == 42 { EP = EP + 1 }
        if TK[EP as usize] == 16 { EP = EP + 1 }
        emit_push_a64()
        compile_or_a64()
        let lslot = var_find(ns, ne)
        if lslot >= 0 {
            let lesiz = var_find_esiz(ns, ne)
            em32(0xAA0003EA)
            emit_pop_x1_a64()
            emit_load_var_a64(lslot)
            if lesiz == 8 { em32(0xF821780A) }
            else { em32(0x3821680A) }
        } else {
            tc_undefined_var(name_tok)
            emit_pop_x1_a64()
        }
        return
    }
    // *PTR = expr
    if stmt_is_deref_store(EP) {
        let name_tok = EP + 1
        if current_fn_allows_mutation() == false {
            tc_effect_violation(name_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[(EP + 1) as usize]
        let ne = TE[(EP + 1) as usize]
        EP = EP + 2
        if TK[EP as usize] == 16 { EP = EP + 1 }
        compile_or_a64()
        let rhs_ty = EXPR_TY
        let rhs_ty_hash = EXPR_TY_HASH
        let lslot = var_find(ns, ne)
        if lslot >= 0 {
            let lvi = var_find_idx(ns, ne)
            if lvi >= 0 && VAR_TY[lvi as usize] == 11 {
                let inner_ty = ptr_hash_inner_ty(VAR_TY_HASH[lvi as usize])
                let inner_hash = ptr_hash_inner_hash(VAR_TY_HASH[lvi as usize])
                if ty_eq(inner_ty, inner_hash, rhs_ty, rhs_ty_hash) == false {
                    tc_error(EP - 1, "assignment type mismatch")
                }
                if inner_ty == 8 || type_is_struct_like(inner_ty, inner_hash) {
                    tc_error(name_tok, "dereference assignment supports scalar pointer targets only")
                } else {
                    em32(0xAA0003EA)  // mov x10, x0 (value)
                    emit_load_var_a64(lslot)
                    em32(0xF900000A)  // str x10, [x0]
                }
            } else {
                tc_error(name_tok, "dereference assignment requires raw pointer binding")
            }
        } else {
            tc_undefined_var(name_tok)
        }
        return
    }
    // (*PTR).field = expr
    if stmt_is_deref_field_store(EP) {
        let name_tok = EP + 2
        let field_tok = EP + 5
        if current_fn_allows_mutation() == false {
            tc_effect_violation(field_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[name_tok as usize]
        let ne = TE[name_tok as usize]
        let fh = gl_name_hash(TS[field_tok as usize], TE[field_tok as usize])
        EP = EP + 7
        compile_or_a64()
        let rhs_ty = EXPR_TY
        let rhs_ty_hash = EXPR_TY_HASH
        let lslot = var_find(ns, ne)
        if lslot >= 0 {
            let lvi = var_find_idx(ns, ne)
            if lvi >= 0 && VAR_TY[lvi as usize] == 11 {
                let inner_ty = ptr_hash_inner_ty(VAR_TY_HASH[lvi as usize])
                let inner_hash = ptr_hash_inner_hash(VAR_TY_HASH[lvi as usize])
                if inner_ty != 6 {
                    tc_error(field_tok, "field access through raw pointer requires struct pointee")
                } else {
                    let si = st_find(inner_hash)
                    if si < 0 {
                        tc_error(field_tok, "unknown field access")
                    } else {
                        let foff = st_field_offset(si, fh)
                        let fty = st_field_ty(si, fh)
                        let fhash = st_field_hash(si, fh)
                        if foff < 0 {
                            tc_error(field_tok, "unknown field access")
                        } else if ty_eq(fty, fhash, rhs_ty, rhs_ty_hash) == false {
                            tc_error(EP - 1, "assignment type mismatch")
                        } else if fty == 8 || type_is_struct_like(fty, fhash) {
                            tc_error(field_tok, "raw pointer field store supports scalar fields only")
                        } else {
                            em32(0xAA0003EA)  // mov x10, x0 (value)
                            emit_load_var_a64(lslot)
                            if foff != 0 {
                                emit_imm64_reg_a64(11, foff)
                                em32(0x8B0B0000)  // add x0, x0, x11
                            }
                            em32(0xF900000A)  // str x10, [x0]
                        }
                    }
                }
            } else {
                tc_error(field_tok, "field access through raw pointer requires raw pointer binding")
            }
        } else {
            tc_undefined_var(name_tok)
        }
        return
    }
    // return
    if k == 2 {
        EP = EP + 1
        if TK[EP as usize] != 9 {
            compile_or_a64()
        } else {
            em32(0xD2800000)
            EXPR_TY = 5
            EXPR_TY_HASH = 0
        }
        if ty_eq(CURRENT_RET_TY, CURRENT_RET_HASH, EXPR_TY, EXPR_TY_HASH) == false {
            if (ty_is_numeric(CURRENT_RET_TY) && ty_is_numeric(EXPR_TY)) == false {
                if (CURRENT_RET_TY != 0 || CURRENT_RET_HASH != 0) && (EXPR_TY != 0 || EXPR_TY_HASH != 0) {
                    if type_has_knowledge(CURRENT_RET_TY, CURRENT_RET_HASH) || type_has_knowledge(EXPR_TY, EXPR_TY_HASH) {
                        tc_epistemic_boundary(EP)
                    } else {
                        tc_error(EP - 1, "return type does not match function signature")
                    }
                }
            }
        }
        if type_is_aggregate(CURRENT_RET_TY, CURRENT_RET_HASH) || type_is_aggregate(EXPR_TY, EXPR_TY_HASH) {
            stabilize_return_agg_a64(EXPR_TY, EXPR_TY_HASH)
        }
        emit_imm64_reg_a64(9, FN_FRAME_SIZE[CURRENT_FN as usize])
        em32(0x8B0903FF)  // add sp, sp, x9
        em32(0xA8C17BFD)
        em32(0xD65F03C0)
        return
    }
    // continue
    if k == 33 {
        EP = EP + 1
        if LOOP_DEPTH > 0 {
            let rel = (LOOP_TOP[(LOOP_DEPTH - 1) as usize] - CL) / 4
            em32(0x14000000 | (rel & 0x3FFFFFF))
        }
        return
    }
    // break
    if k == 34 {
        EP = EP + 1
        BREAK_PATCH[BREAK_COUNT as usize] = CL
        BREAK_COUNT = BREAK_COUNT + 1
        em32(0x14000000)
        return
    }
    // if/else
    if k == 13 {
        EP = EP + 1
        compile_or_a64()
        if EXPR_TY != 0 && EXPR_TY != 4 { tc_error(EP - 1, "if condition must be bool") }
        let cbz_off = CL
        em32(0xB4000000)
        LAST_STMT_HAS_VALUE = 0
        LAST_STMT_TY = 0
        LAST_STMT_TY_HASH = 0
        if TK[EP as usize] == 8 { EP = EP + 1 }
        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt_a64() }
        let then_has_value = LAST_STMT_HAS_VALUE
        let then_ty = LAST_STMT_TY
        let then_hash = LAST_STMT_TY_HASH
        let then_conf_a = EXPR_CONFIDENCE
        if TK[EP as usize] == 9 { EP = EP + 1 }
        LAST_STMT_HAS_VALUE = 0
        LAST_STMT_TY = 0
        LAST_STMT_TY_HASH = 0
        if TK[EP as usize] == 14 {
            EP = EP + 1
            let b_end_off = CL
            em32(0x14000000)
            patch_branch_a64(cbz_off, CL)
            if TK[EP as usize] == 13 { compile_stmt_a64() }
            else {
                LAST_STMT_HAS_VALUE = 0
                LAST_STMT_TY = 0
                LAST_STMT_TY_HASH = 0
                if TK[EP as usize] == 8 { EP = EP + 1 }
                while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt_a64() }
                if TK[EP as usize] == 9 { EP = EP + 1 }
            }
            let else_has_value = LAST_STMT_HAS_VALUE
            let else_ty = LAST_STMT_TY
            let else_hash = LAST_STMT_TY_HASH
            let else_conf_a = EXPR_CONFIDENCE
            patch_branch_a64(b_end_off, CL)
            if then_has_value == 1 && else_has_value == 1 && then_ty != 5 && else_ty != 5 {
                if ty_eq(then_ty, then_hash, else_ty, else_hash) == false {
                    tc_error(EP - 1, "if arm type does not match else arm")
                }
                LAST_STMT_HAS_VALUE = 1
                LAST_STMT_TY = then_ty
                LAST_STMT_TY_HASH = then_hash
                EXPR_TY = then_ty
                EXPR_TY_HASH = then_hash
                if then_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                // Epistemic: if-else result confidence = min(then, else)
                if then_conf_a < else_conf_a { EXPR_CONFIDENCE = then_conf_a }
                else { EXPR_CONFIDENCE = else_conf_a }
            } else {
                LAST_STMT_HAS_VALUE = 0
                LAST_STMT_TY = 0
                LAST_STMT_TY_HASH = 0
            }
        } else {
            patch_branch_a64(cbz_off, CL)
            LAST_STMT_HAS_VALUE = 0
            LAST_STMT_TY = 0
            LAST_STMT_TY_HASH = 0
        }
        return
    }
    // while
    if k == 15 {
        EP = EP + 1
        let loop_top = CL
        LOOP_TOP[LOOP_DEPTH as usize] = loop_top
        LOOP_DEPTH = LOOP_DEPTH + 1
        let saved_bc = BREAK_COUNT
        compile_or_a64()
        let cbz_off = CL
        em32(0xB4000000)
        if TK[EP as usize] == 8 { EP = EP + 1 }
        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt_a64() }
        if TK[EP as usize] == 9 { EP = EP + 1 }
        let rel = (loop_top - CL) / 4
        em32(0x14000000 | (rel & 0x3FFFFFF))
        patch_branch_a64(cbz_off, CL)
        var bi: i64 = saved_bc
        while bi < BREAK_COUNT { patch_branch_a64(BREAK_PATCH[bi as usize], CL); bi = bi + 1 }
        BREAK_COUNT = saved_bc
        LOOP_DEPTH = LOOP_DEPTH - 1
        // Epistemic: loop iteration amplifies uncertainty — degrade confidence by 5%
        EXPR_CONFIDENCE = EXPR_CONFIDENCE * 950 / 1000
        return
    }
    // for IDENT in range(START, END) / START..END / START..=END
    if k == 54 {
        EP = EP + 1
        let vns = TS[EP as usize]; let vne = TE[EP as usize]
        EP = EP + 1  // skip loop var
        EP = EP + 1  // skip 'in'
        let saved_next_a = NEXT_SLOT
        if TK[EP as usize] == 3 && TK[(EP + 1) as usize] == 6 && src_match(TS[EP as usize], TE[EP as usize] - TS[EP as usize], "range") {
            // range(START, END) form
            EP = EP + 1  // skip 'range'
            EP = EP + 1  // skip (
            compile_or_a64()
            let iter_slot_a = var_add(vns, vne)
            if iter_slot_a < 0 { return }
            emit_store_var_a64(iter_slot_a)
            if TK[EP as usize] == 28 { EP = EP + 1 }
            compile_or_a64()
            let end_slot_a = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var_a64(end_slot_a)
            if TK[EP as usize] == 7 { EP = EP + 1 }
        } else {
            // START..END or START..=END form
            compile_or_a64()
            let iter_slot_b = var_add(vns, vne)
            if iter_slot_b < 0 { return }
            emit_store_var_a64(iter_slot_b)
            var is_incl: i64 = 0
            if TK[EP as usize] == 64 { is_incl = 1 }
            if TK[EP as usize] == 63 || TK[EP as usize] == 64 { EP = EP + 1 }
            compile_or_a64()
            if is_incl != 0 {
                em32(0x91000400)  // add x0, x0, #1
            }
            let end_slot_b = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var_a64(end_slot_b)
        }
        let iter_slot = saved_next_a
        let end_slot = saved_next_a + 1
        // For-loop: b cond; incr: iter++; cond: cmp; cbz end; body; b incr; end:
        let jmp_cond_a = CL; em32(0x14000000)  // b cond (patched below)
        let incr_addr_a = CL
        LOOP_TOP[LOOP_DEPTH as usize] = incr_addr_a
        LOOP_DEPTH = LOOP_DEPTH + 1
        let saved_bc = BREAK_COUNT
        emit_load_var_a64(iter_slot); em32(0x91000400); emit_store_var_a64(iter_slot)
        let cond_addr_a = CL
        patch_branch_a64(jmp_cond_a, cond_addr_a)
        emit_load_var_a64(iter_slot); emit_push_a64()
        emit_load_var_a64(end_slot); emit_pop_x1_a64()
        em32(0xEB00003F); em32(0x9A9FA7E0)
        let cbz_off = CL; em32(0xB4000000)
        if TK[EP as usize] == 8 { EP = EP + 1 }
        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt_a64() }
        if TK[EP as usize] == 9 { EP = EP + 1 }
        let rel_bi = (incr_addr_a - CL) / 4
        em32(0x14000000 | (rel_bi & 0x3FFFFFF))
        patch_branch_a64(cbz_off, CL)
        var bi: i64 = saved_bc
        while bi < BREAK_COUNT { patch_branch_a64(BREAK_PATCH[bi as usize], CL); bi = bi + 1 }
        BREAK_COUNT = saved_bc
        LOOP_DEPTH = LOOP_DEPTH - 1
        // Epistemic: loop iteration amplifies uncertainty — degrade confidence by 5%
        EXPR_CONFIDENCE = EXPR_CONFIDENCE * 950 / 1000
        return
    }
    // match
    if k == 48 {
        EP = EP + 1
        compile_or_a64()
        MATCH_SCRUT_TY = EXPR_TY
        MATCH_SCRUT_HASH = EXPR_TY_HASH
        let match_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
        emit_store_var_a64(match_slot)
        if TK[EP as usize] == 8 { EP = EP + 1 }
        var arm_count: i64 = 0
        var match_all_value: i64 = 1
        var match_arms: i64 = 0
        var match_have_ty: i64 = 0
        var match_ty: i64 = 0
        var match_hash: i64 = 0
        var match_min_conf_a: i64 = 1000
        while TK[EP as usize] != 9 && TK[EP as usize] != 0 {
            var is_wildcard: i64 = 0
            var disc: i64 = -1
            var arm_is_tagged: i64 = 0
            var bind_ns: i64 = 0; var bind_ne: i64 = 0; var has_binding: i64 = 0
            let arm_tk = TK[EP as usize]
            if arm_tk == 57 { EP = EP + 1; disc = 1; arm_is_tagged = 1; if TK[EP as usize] == 6 { EP = EP + 1; bind_ns = TS[EP as usize]; bind_ne = TE[EP as usize]; has_binding = 1; EP = EP + 1; if TK[EP as usize] == 7 { EP = EP + 1 } } }
            if arm_tk == 58 { EP = EP + 1; disc = 0; arm_is_tagged = 1 }
            if arm_tk == 59 { EP = EP + 1; disc = 0; arm_is_tagged = 1; if TK[EP as usize] == 6 { EP = EP + 1; bind_ns = TS[EP as usize]; bind_ne = TE[EP as usize]; has_binding = 1; EP = EP + 1; if TK[EP as usize] == 7 { EP = EP + 1 } } }
            if arm_tk == 60 { EP = EP + 1; disc = 1; arm_is_tagged = 1; if TK[EP as usize] == 6 { EP = EP + 1; bind_ns = TS[EP as usize]; bind_ne = TE[EP as usize]; has_binding = 1; EP = EP + 1; if TK[EP as usize] == 7 { EP = EP + 1 } } }
            if arm_tk == 3 {
                let pns = TS[EP as usize]; let pne = TE[EP as usize]
                if pne - pns == 1 && sb(pns) == 95 { is_wildcard = 1; EP = EP + 1 }
                else if TK[(EP + 1) as usize] == 51 { let eh = gl_name_hash(pns, pne); EP = EP + 2; let vh = gl_name_hash(TS[EP as usize], TE[EP as usize]); EP = EP + 1; disc = en_variant_value(eh, vh) }
                else { EP = EP + 1 }
            }
            if arm_tk == 4 { disc = TV[EP as usize]; EP = EP + 1 }
            if arm_tk != 57 && arm_tk != 58 && arm_tk != 59 && arm_tk != 60 && arm_tk != 3 && arm_tk != 4 { EP = EP + 1 }
            if disc >= 0 {
                if arm_is_tagged == 1 {
                    emit_load_var_a64(match_slot); em32(0xF9400000); emit_push_a64()
                    emit_imm64_a64(disc); emit_pop_x1_a64()
                    em32(0xEB00003F)
                    let skip_off = CL; em32(0x54000001)
                    if has_binding == 1 {
                        emit_load_var_a64(match_slot)
                        em32(0xF9400400)
                        let bslot = var_add(bind_ns, bind_ne)
                        if bslot >= 0 { emit_store_var_a64(bslot) }
                    }
                    if TK[EP as usize] == 52 { EP = EP + 1 }
                    var arm_has_block: i64 = 0
                    if TK[EP as usize] == 8 { arm_has_block = 1; EP = EP + 1 }
                    LAST_STMT_HAS_VALUE = 0
                    if arm_has_block == 1 {
                        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt_a64() }
                        if TK[EP as usize] == 9 { EP = EP + 1 }
                    } else {
                        compile_stmt_a64()
                    }
                    match_arms = match_arms + 1
                    if EXPR_CONFIDENCE < match_min_conf_a { match_min_conf_a = EXPR_CONFIDENCE }
                    if LAST_STMT_HAS_VALUE == 1 {
                        if match_have_ty == 0 {
                            match_have_ty = 1
                            match_ty = LAST_STMT_TY
                            match_hash = LAST_STMT_TY_HASH
                        } else if ty_eq(match_ty, match_hash, LAST_STMT_TY, LAST_STMT_TY_HASH) == false {
                            tc_error(EP - 1, "match arm type does not match other arms")
                        }
                    } else {
                        match_all_value = 0
                    }
                    MATCH_ENDS[arm_count as usize] = CL; em32(0x14000000)
                    arm_count = arm_count + 1
                    patch_branch_a64(skip_off, CL)
                } else {
                    emit_load_var_a64(match_slot); emit_push_a64()
                    emit_imm64_a64(disc); emit_pop_x1_a64()
                    em32(0xEB00003F)
                    let skip_off = CL; em32(0x54000001)
                    if TK[EP as usize] == 52 { EP = EP + 1 }
                    var arm_has_block2: i64 = 0
                    if TK[EP as usize] == 8 { arm_has_block2 = 1; EP = EP + 1 }
                    LAST_STMT_HAS_VALUE = 0
                    if arm_has_block2 == 1 {
                        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt_a64() }
                        if TK[EP as usize] == 9 { EP = EP + 1 }
                    } else {
                        compile_stmt_a64()
                    }
                    match_arms = match_arms + 1
                    if EXPR_CONFIDENCE < match_min_conf_a { match_min_conf_a = EXPR_CONFIDENCE }
                    if LAST_STMT_HAS_VALUE == 1 {
                        if match_have_ty == 0 {
                            match_have_ty = 1
                            match_ty = LAST_STMT_TY
                            match_hash = LAST_STMT_TY_HASH
                        } else if ty_eq(match_ty, match_hash, LAST_STMT_TY, LAST_STMT_TY_HASH) == false {
                            tc_error(EP - 1, "match arm type does not match other arms")
                        }
                    } else {
                        match_all_value = 0
                    }
                    MATCH_ENDS[arm_count as usize] = CL; em32(0x14000000)
                    arm_count = arm_count + 1
                    patch_branch_a64(skip_off, CL)
                }
            }
            if is_wildcard == 1 {
                if match_arms < 1000000 { match_arms = 1000000 }
                if TK[EP as usize] == 52 { EP = EP + 1 }
                var arm_has_block3: i64 = 0
                if TK[EP as usize] == 8 { arm_has_block3 = 1; EP = EP + 1 }
                LAST_STMT_HAS_VALUE = 0
                if arm_has_block3 == 1 {
                    while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt_a64() }
                    if TK[EP as usize] == 9 { EP = EP + 1 }
                } else {
                    compile_stmt_a64()
                }
                match_arms = match_arms + 1
                if EXPR_CONFIDENCE < match_min_conf_a { match_min_conf_a = EXPR_CONFIDENCE }
                if LAST_STMT_HAS_VALUE == 1 {
                    if match_have_ty == 0 {
                        match_have_ty = 1
                        match_ty = LAST_STMT_TY
                        match_hash = LAST_STMT_TY_HASH
                    } else if ty_eq(match_ty, match_hash, LAST_STMT_TY, LAST_STMT_TY_HASH) == false {
                        tc_error(EP - 1, "match arm type does not match other arms")
                    }
                } else {
                    match_all_value = 0
                }
            }
            if TK[EP as usize] == 28 { EP = EP + 1 }
        }
        if TK[EP as usize] == 9 { EP = EP + 1 }
        var ai: i64 = 0
        while ai < arm_count { patch_branch_a64(MATCH_ENDS[ai as usize], CL); ai = ai + 1 }
        if MATCH_SCRUT_TY == 7 && match_arms < 1000000 && match_arms < en_variant_count(MATCH_SCRUT_HASH) {
            tc_error(EP - 1, "match must be exhaustive")
            LAST_STMT_HAS_VALUE = 0
            LAST_STMT_TY = 0
            LAST_STMT_TY_HASH = 0
            return
        }
        if match_arms > 0 && match_all_value == 1 && match_have_ty == 1 {
            LAST_STMT_HAS_VALUE = 1
            LAST_STMT_TY = match_ty
            LAST_STMT_TY_HASH = match_hash
            EXPR_TY = match_ty
            EXPR_TY_HASH = match_hash
            if match_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
            // Epistemic: match result confidence = min across all arms
            EXPR_CONFIDENCE = match_min_conf_a
        }
        return
    }
    // Expression statement
    compile_or_a64()
    LAST_STMT_HAS_VALUE = 1
    LAST_STMT_TY = EXPR_TY
    LAST_STMT_TY_HASH = EXPR_TY_HASH
}

// ─── ARM64 top-level compiler ───
fn compile_all_arm64() -> i64 with IO, Mut, Panic, Div {
    // Run all frontend passes via compile_all (which also emits x86_64 code, discarded)
    let r = compile_all()
    if r != 0 { return r }
    // Reset code buffer and patches for ARM64 re-emission
    CL = 0
    PATCH_COUNT = 0
    print("arm64: re-emitting pass 2\n")
    // ARM64 Pass 2: compile each function
    var p: i64 = 0
    var fn_idx: i64 = 0
    while p < TC {
        if tok_is_fn_decl_start(p) == false { p = p + 1; continue }
        p = tok_fn_name_index(p)
        if p + 2 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 3) as usize] == 24 {
            while p < TC && TK[p as usize] != 8 { p = p + 1 }
            var gd: i64 = 1; p = p + 1
            while p < TC && gd > 0 { if TK[p as usize] == 8 { gd = gd + 1 }; if TK[p as usize] == 9 { gd = gd - 1 }; p = p + 1 }
            continue
        }
        FN_OFF[fn_idx as usize] = CL
        CURRENT_FN = fn_idx
        CURRENT_RET_TY = FN_RET_TY[fn_idx as usize]
        CURRENT_RET_HASH = FN_RET_HASH[fn_idx as usize]
        VAR_COUNT = 0; NEXT_SLOT = 1; BREAK_COUNT = 0; LAST_STMT_HAS_VALUE = 0
        p = p + 1
        if TK[p as usize] == 6 { p = p + 1 }
        while TK[p as usize] != 7 && TK[p as usize] != 0 {
            if TK[p as usize] == 3 {
                let pns = TS[p as usize]; let pne = TE[p as usize]
                if var_find_idx(pns, pne) >= 0 { tc_duplicate_param(p) }
                let pslot = var_add(pns, pne)
                p = p + 1
                if TK[p as usize] == 43 {
                    p = p + 1
                    scan_type(p)
                    if pslot >= 0 {
                        VAR_TY[(VAR_COUNT - 1) as usize] = SCAN_TY
                        VAR_TY_HASH[(VAR_COUNT - 1) as usize] = SCAN_TY_HASH
                        if SCAN_TY == 2 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 1 }
                        if type_is_slice_ref(SCAN_TY, SCAN_TY_HASH) {
                            let len_slot = VAR_SLOT[(VAR_COUNT - 1) as usize]
                            let ptr_slot = NEXT_SLOT
                            NEXT_SLOT = NEXT_SLOT + 1
                            VAR_SLOT[(VAR_COUNT - 1) as usize] = ptr_slot
                            VAR_LEN_SLOT[(VAR_COUNT - 1) as usize] = len_slot
                            VAR_ESIZ[(VAR_COUNT - 1) as usize] = arr_hash_esiz(ref_hash_inner_hash(SCAN_TY_HASH))
                        } else if SCAN_TY == 8 {
                            VAR_ALEN[(VAR_COUNT - 1) as usize] = SCAN_TY_ALEN
                            VAR_ESIZ[(VAR_COUNT - 1) as usize] = SCAN_TY_ESIZ
                        }
                    }
                    p = SCAN_TY_NEXT
                }
            } else {
                p = p + 1  // skip keyword or other non-ident token used as param name
            }
            if TK[p as usize] == 28 { p = p + 1 }
        }
        if TK[p as usize] == 7 { p = p + 1 }
        if TK[p as usize] == 10 {
            p = p + 1
            scan_type(p)
            p = SCAN_TY_NEXT
        }
        if TK[p as usize] == 38 { p = p + 1; while TK[p as usize] == 3 || TK[p as usize] == 28 { p = p + 1 } }
        if TK[p as usize] == 8 { p = p + 1 }
        // ARM64 prologue
        print_int(fn_idx); print(" ")
        let frame_sz = FN_FRAME_SIZE[fn_idx as usize]
        em32(0xA9BF7BFD)  // stp x29, x30, [sp, #-16]!
        em32(0x910003FD)  // mov x29, sp
        emit_imm64_reg_a64(9, frame_sz)
        em32(0xCB0903FF)  // sub sp, sp, x9
        // Spill params using low-level ABI slot order.
        var param_vi_a: i64 = 0
        var abi_arg_idx_a: i64 = 0
        while param_vi_a < VAR_COUNT {
            emit_store_incoming_arg_a64(abi_arg_idx_a, VAR_SLOT[param_vi_a as usize])
            abi_arg_idx_a = abi_arg_idx_a + 1
            if type_is_slice_ref(VAR_TY[param_vi_a as usize], VAR_TY_HASH[param_vi_a as usize]) {
                emit_store_incoming_arg_a64(abi_arg_idx_a, VAR_LEN_SLOT[param_vi_a as usize])
                abi_arg_idx_a = abi_arg_idx_a + 1
            }
            param_vi_a = param_vi_a + 1
        }
        // Compile body
        EP = p
        var depth: i64 = 1
        while EP < TC && depth > 0 {
            if TK[EP as usize] == 9 { depth = depth - 1; if depth == 0 { EP = EP + 1; continue } else { EP = EP + 1; continue } }
            compile_stmt_a64()
        }
        p = EP
        // Linear check
        var lci: i64 = 0
        while lci < VAR_COUNT {
            if VAR_LINEAR[lci as usize] == 1 {
                if VAR_USED[lci as usize] == 0 {
                    tc_linear_violation(FN_NAME_TOK[fn_idx as usize], "linear value not consumed")
                }
                if VAR_USED[lci as usize] > 1 {
                    tc_linear_violation(FN_NAME_TOK[fn_idx as usize], "linear value used more than once")
                }
            }
            lci = lci + 1
        }
        // Implicit return
        var needs_epilogue: i64 = 1
        if CL >= 4 { if rd32_at(CL - 4) == 0xD65F03C0 { needs_epilogue = 0 } }
        if needs_epilogue == 1 {
            // Unit return type (5 = no explicit return): always emit mov x0, 0
            if CURRENT_RET_TY == 5 {
                em32(0xD2800000)
            } else if LAST_STMT_HAS_VALUE == 0 {
                em32(0xD2800000)
            } else if ty_eq(CURRENT_RET_TY, CURRENT_RET_HASH, LAST_STMT_TY, LAST_STMT_TY_HASH) == false {
                if (ty_is_numeric(CURRENT_RET_TY) && ty_is_numeric(LAST_STMT_TY)) == false {
                    if (CURRENT_RET_TY != 0 || CURRENT_RET_HASH != 0) && (LAST_STMT_TY != 0 || LAST_STMT_TY_HASH != 0) {
                        if type_has_knowledge(CURRENT_RET_TY, CURRENT_RET_HASH) || type_has_knowledge(LAST_STMT_TY, LAST_STMT_TY_HASH) {
                            tc_epistemic_boundary(EP)
                        } else {
                            print("warning: tail type mismatch at line ")
                            print_int(TL[(EP - 1) as usize])
                            print("\n")
                        }
                    }
                }
            } else if type_is_aggregate(CURRENT_RET_TY, CURRENT_RET_HASH) || type_is_aggregate(LAST_STMT_TY, LAST_STMT_TY_HASH) {
                stabilize_return_agg_a64(LAST_STMT_TY, LAST_STMT_TY_HASH)
            }
            emit_imm64_reg_a64(9, frame_sz)
            em32(0x8B0903FF)  // add sp, sp, x9
            em32(0xA8C17BFD)
            em32(0xD65F03C0)
        }
        fn_idx = fn_idx + 1
    }
    // Patch BL instructions
    var pi: i64 = 0
    while pi < PATCH_COUNT {
        let off = PATCH_OFF[pi as usize]
        let fi = PATCH_FN[pi as usize]
        if fi >= 0 && fi < FN_COUNT && off >= 0 && off + 3 < CL {
            let target = FN_OFF[fi as usize]
            if PATCH_KIND[pi as usize] == 1 {
                patch_adr_a64(off, target, 0)
            } else if PATCH_KIND[pi as usize] == 2 {
                let rel = (target - off) / 4
                em32_at(off, 0x14000000 | (rel & 0x3FFFFFF))
            } else {
                let rel = (target - off) / 4
                em32_at(off, 0x94000000 | (rel & 0x3FFFFFF))
            }
        }
        pi = pi + 1
    }
    // Find main
    var main_fn: i64 = -1
    var mi: i64 = 0
    while mi < FN_COUNT {
        let ms = FN_NS[mi as usize]; let me = FN_NE[mi as usize]
        if me - ms == 4 && sb(ms) == 109 && sb(ms+1) == 97 && sb(ms+2) == 105 && sb(ms+3) == 110 { main_fn = mi }
        mi = mi + 1
    }
    if main_fn < 0 { print("error: no main\n"); return 1 }
    // Trampoline
    TRAMP_OFF = CL
    if TARGET_OS == 2 {
        let argc_addr = 0x100008000
        let argv_addr = 0x100008000 + 8
        em32(0xF94003E9)
        em32(0xD1000529)
        emit_imm64_reg_a64(10, argc_addr)
        em32(0xF9000149)
        em32(0x91000000 | (16 << 10) | (31 << 5) | 9)
        emit_imm64_reg_a64(10, argv_addr)
        em32(0xF9000149)
        let mrel = (FN_OFF[main_fn as usize] - CL) / 4
        em32(0x94000000 | (mrel & 0x3FFFFFF))
        emit_imm64_reg_a64(16, 0x2000001)
        em32(0xD4001001)
    } else {
        let argc_addr = 0x10000000
        let argv_addr = 0x10000000 + 8
        em32(0xF94003E9)
        em32(0xD1000529)
        emit_imm64_reg_a64(10, argc_addr)
        em32(0xF9000149)
        em32(0x91000000 | (16 << 10) | (31 << 5) | 9)
        emit_imm64_reg_a64(10, argv_addr)
        em32(0xF9000149)
        let mrel = (FN_OFF[main_fn as usize] - CL) / 4
        em32(0x94000000 | (mrel & 0x3FFFFFF))
        em32(0xD2800000 | ((93 & 0xFFFF) << 5) | 8)
        em32(0xD4000001)
    }
    print("arm64_compile: fns="); print_int(FN_COUNT); print(" code="); print_int(CL)
    print(" main=fn"); print_int(main_fn); print(" patches="); print_int(PATCH_COUNT); print("\n")
    0
}

// ─── ARM64 ELF writer ───
fn write_elf_arm64(output: string) -> i64 with IO, Mut, Panic, Div {
    let text_base = 0x400000
    let text_off = 4096
    let bss_base = 0x10000000         // 256MB: always above code
    let entry = text_base + text_off + TRAMP_OFF
    var i: i64 = 0
    while i < 4096 { ELF[i as usize] = 0; i = i + 1 }
    let tsz = text_off + CL
    // ELF header
    elf_w8(0, 0x7f); elf_w8(1, 69); elf_w8(2, 76); elf_w8(3, 70)
    elf_w8(4, 2); elf_w8(5, 1); elf_w8(6, 1)
    elf_w16(16, 2); elf_w16(18, 0xB7); elf_w32(20, 1)
    elf_w64(24, entry); elf_w64(32, 64)
    elf_w16(52, 64); elf_w16(54, 56); elf_w16(56, 2); elf_w16(58, 64)
    let ph0 = 64
    elf_w32(ph0, 1); elf_w32(ph0+4, 5)   // PT_LOAD, R+X
    elf_w64(ph0+8, 0); elf_w64(ph0+16, text_base); elf_w64(ph0+24, text_base)
    elf_w64(ph0+32, tsz); elf_w64(ph0+40, tsz); elf_w64(ph0+48, 4096)
    let ph1 = 120
    elf_w32(ph1, 1); elf_w32(ph1+4, 6)   // PT_LOAD, R+W
    elf_w64(ph1+8, 0); elf_w64(ph1+16, bss_base); elf_w64(ph1+24, bss_base)
    elf_w64(ph1+32, 0); elf_w64(ph1+40, GL_BSS_SIZE); elf_w64(ph1+48, 4096)
    i = 0
    while i < CL { ELF[(text_off + i) as usize] = CD[i as usize]; i = i + 1 }
    let ok = write_file(output, ELF, tsz)
    print("elf_arm64: "); print(output); print(" "); print_int(tsz); print(" bytes (bss="); print_int(GL_BSS_SIZE); print(")\n")
    return 0
}

// ─── ARM64 Mach-O writer ───
fn write_macho_arm64(output: string) -> i64 with IO, Mut, Panic, Div {
    let vm_base: i64 = 4294967296
    let page_size: i64 = 16384
    let text_vm = vm_base
    let data_vm = vm_base + 0x8000
    let hdr_size = 32
    let lc_pagezero_size = 72
    let lc_text_size = 72 + 80
    let lc_data_size = 72 + 80
    let lc_main_size = 24
    let ncmds = 4
    let sizeofcmds = lc_pagezero_size + lc_text_size + lc_data_size + lc_main_size
    let text_file_off = ((hdr_size + sizeofcmds + page_size - 1) / page_size) * page_size
    let text_file_size = ((CL + page_size - 1) / page_size) * page_size
    let total_file_size = text_file_off + text_file_size
    let text_seg_vmsize = text_file_off + text_file_size
    print("macho_arm64: code="); print_int(CL); print(" text_off="); print_int(text_file_off); print("\n")
    var i: i64 = 0
    while i < 1048576 { ELF[i as usize] = 0; i = i + 1 }
    // Header
    elf_w32(0, 0xFEEDFACF); elf_w32(4, 0x0100000C); elf_w32(8, 0)
    elf_w32(12, 2); elf_w32(16, ncmds); elf_w32(20, sizeofcmds); elf_w32(24, 0x00200085)
    // __PAGEZERO
    var off = hdr_size
    elf_w32(off, 25); elf_w32(off+4, lc_pagezero_size)
    elf_w8(off+8, 95); elf_w8(off+9, 95); elf_w8(off+10, 80); elf_w8(off+11, 65); elf_w8(off+12, 71); elf_w8(off+13, 69); elf_w8(off+14, 90); elf_w8(off+15, 69); elf_w8(off+16, 82); elf_w8(off+17, 79)
    elf_w64(off+24, 0); elf_w64(off+32, vm_base)
    // __TEXT
    off = hdr_size + lc_pagezero_size
    elf_w32(off, 25); elf_w32(off+4, lc_text_size)
    elf_w8(off+8, 95); elf_w8(off+9, 95); elf_w8(off+10, 84); elf_w8(off+11, 69); elf_w8(off+12, 88); elf_w8(off+13, 84)
    elf_w64(off+24, text_vm); elf_w64(off+32, text_seg_vmsize)
    elf_w64(off+40, 0); elf_w64(off+48, total_file_size)
    elf_w32(off+56, 7); elf_w32(off+60, 5); elf_w32(off+64, 1)
    let sec = off + 72
    elf_w8(sec, 95); elf_w8(sec+1, 95); elf_w8(sec+2, 116); elf_w8(sec+3, 101); elf_w8(sec+4, 120); elf_w8(sec+5, 116)
    elf_w8(sec+16, 95); elf_w8(sec+17, 95); elf_w8(sec+18, 84); elf_w8(sec+19, 69); elf_w8(sec+20, 88); elf_w8(sec+21, 84)
    elf_w64(sec+32, text_vm + text_file_off); elf_w64(sec+40, CL)
    elf_w32(sec+48, text_file_off); elf_w32(sec+64, 0x80000400)
    // __DATA
    off = hdr_size + lc_pagezero_size + lc_text_size
    elf_w32(off, 25); elf_w32(off+4, lc_data_size)
    elf_w8(off+8, 95); elf_w8(off+9, 95); elf_w8(off+10, 68); elf_w8(off+11, 65); elf_w8(off+12, 84); elf_w8(off+13, 65)
    elf_w64(off+24, data_vm); elf_w64(off+32, ((GL_BSS_SIZE + page_size - 1) / page_size) * page_size)
    elf_w64(off+40, 0); elf_w64(off+48, 0)
    elf_w32(off+56, 7); elf_w32(off+60, 3); elf_w32(off+64, 1)
    let bsec = off + 72
    elf_w8(bsec, 95); elf_w8(bsec+1, 95); elf_w8(bsec+2, 98); elf_w8(bsec+3, 115); elf_w8(bsec+4, 115)
    elf_w8(bsec+16, 95); elf_w8(bsec+17, 95); elf_w8(bsec+18, 68); elf_w8(bsec+19, 65); elf_w8(bsec+20, 84); elf_w8(bsec+21, 65)
    elf_w64(bsec+32, data_vm); elf_w64(bsec+40, GL_BSS_SIZE)
    elf_w32(bsec+48, 0); elf_w32(bsec+64, 1)
    // LC_MAIN
    off = hdr_size + lc_pagezero_size + lc_text_size + lc_data_size
    elf_w32(off, 0x80000028); elf_w32(off+4, lc_main_size)
    elf_w64(off+8, text_file_off + TRAMP_OFF); elf_w64(off+16, 0)
    // Copy code
    i = 0
    while i < CL { ELF[(text_file_off + i) as usize] = CD[i as usize]; i = i + 1 }
    let ok = write_file(output, ELF, total_file_size)
    print("macho_arm64: "); print(output); print(" "); print_int(total_file_size); print(" bytes\n")
    return 0
}

// ─── Import resolver ───
// Hash IMP_PATH[0..len] for dedup
fn imp_path_hash(len: i64) -> i64 with Panic, Mut {
    var h: i64 = len * 1000003
    var i: i64 = 0
    while i < len {
        let c = IMP_PATH[i as usize] as i64 & 0xFF
        h = h + c * (i + 1) * 31
        i = i + 1
    }
    return h
}

fn print_imp_path() with IO, Mut, Panic {
    var i: i64 = 0
    while i < 4096 && IMP_PATH[i as usize] != 0 {
        print_char(IMP_PATH[i as usize] as i64)
        i = i + 1
    }
}

fn set_base_dir_from_src_path(ps: i64, pe: i64) with Mut, Panic {
    var last_slash: i64 = -1
    var i: i64 = ps
    while i < pe {
        if sb(i) == 47 { last_slash = i }
        i = i + 1
    }
    BASE_DIR_LEN = 0
    if last_slash < 0 {
        BASE_DIR[0 as usize] = 46
        BASE_DIR_LEN = 1
    } else {
        i = ps
        while i < last_slash && BASE_DIR_LEN < 511 {
            BASE_DIR[BASE_DIR_LEN as usize] = sb(i) as i8
            BASE_DIR_LEN = BASE_DIR_LEN + 1
            i = i + 1
        }
    }
    BASE_DIR[BASE_DIR_LEN as usize] = 0
}

fn append_src_lit(s: string) with Mut, Panic, Div {
    let n = str_len(s)
    var i: i64 = 0
    while i < n && SRC_LEN < 2097151 {
        SRC[SRC_LEN as usize] = str_char_at(s, i) as i8
        SRC_LEN = SRC_LEN + 1
        i = i + 1
    }
}

fn append_native_prelude_math() with Mut, Panic, Div {
    append_src_lit("fn __native_abs_i64(x: i64) -> i64 {\n")
    append_src_lit("    if x < 0 { return 0 - x }\n")
    append_src_lit("    x\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_abs_f64(x: f64) -> f64 {\n")
    append_src_lit("    if x < 0.0 { return 0.0 - x }\n")
    append_src_lit("    x\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_floor_f64(x: f64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    let i = x as i64\n")
    append_src_lit("    let f = i as f64\n")
    append_src_lit("    if x < 0.0 && f != x { return f - 1.0 }\n")
    append_src_lit("    f\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_sqrt_f64(x: f64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    if x <= 0.0 { return 0.0 }\n")
    append_src_lit("    var y = x\n")
    append_src_lit("    var i: i64 = 0\n")
    append_src_lit("    while i < 20 {\n")
    append_src_lit("        y = 0.5 * (y + x / y)\n")
    append_src_lit("        i = i + 1\n")
    append_src_lit("    }\n")
    append_src_lit("    y\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_ln_f64(x: f64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    if x <= 0.0 { return 0.0 - 1.0e30 }\n")
    append_src_lit("    if x == 1.0 { return 0.0 }\n")
    append_src_lit("    var m = x\n")
    append_src_lit("    var e_val: i64 = 0\n")
    append_src_lit("    while m >= 2.0 { m = m / 2.0; e_val = e_val + 1 }\n")
    append_src_lit("    while m < 0.5 { m = m * 2.0; e_val = e_val - 1 }\n")
    append_src_lit("    let t = (m - 1.0) / (m + 1.0)\n")
    append_src_lit("    let t2 = t * t\n")
    append_src_lit("    var sum = t\n")
    append_src_lit("    var term = t\n")
    append_src_lit("    var k: i64 = 1\n")
    append_src_lit("    while k < 15 {\n")
    append_src_lit("        term = term * t2\n")
    append_src_lit("        sum = sum + term / ((2 * k + 1) as f64)\n")
    append_src_lit("        k = k + 1\n")
    append_src_lit("    }\n")
    append_src_lit("    2.0 * sum + (e_val as f64) * 0.6931471805599453\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_exp_f64(x: f64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    if x > 500.0 { return 1.0e200 }\n")
    append_src_lit("    if x < 0.0 - 500.0 { return 0.0 }\n")
    append_src_lit("    let ln2 = 0.6931471805599453\n")
    append_src_lit("    let kf = __native_floor_f64(x / ln2)\n")
    append_src_lit("    let r = x - kf * ln2\n")
    append_src_lit("    var sum = 1.0\n")
    append_src_lit("    var term = 1.0\n")
    append_src_lit("    var n: i64 = 1\n")
    append_src_lit("    while n <= 12 {\n")
    append_src_lit("        term = term * r / (n as f64)\n")
    append_src_lit("        sum = sum + term\n")
    append_src_lit("        n = n + 1\n")
    append_src_lit("    }\n")
    append_src_lit("    let k = kf as i64\n")
    append_src_lit("    var out = sum\n")
    append_src_lit("    if k >= 0 {\n")
    append_src_lit("        n = 0\n")
    append_src_lit("        while n < k { out = out * 2.0; n = n + 1 }\n")
    append_src_lit("    } else {\n")
    append_src_lit("        n = 0\n")
    append_src_lit("        while n < 0 - k { out = out / 2.0; n = n + 1 }\n")
    append_src_lit("    }\n")
    append_src_lit("    out\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_sin_f64(x: f64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    let pi = 3.14159265358979323846\n")
    append_src_lit("    let two_pi = 6.28318530717958647692\n")
    append_src_lit("    var t = x\n")
    append_src_lit("    while t > pi { t = t - two_pi }\n")
    append_src_lit("    while t < 0.0 - pi { t = t + two_pi }\n")
    append_src_lit("    let x2 = t * t\n")
    append_src_lit("    let x3 = t * x2\n")
    append_src_lit("    let x5 = x3 * x2\n")
    append_src_lit("    let x7 = x5 * x2\n")
    append_src_lit("    t - x3 / 6.0 + x5 / 120.0 - x7 / 5040.0\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_cos_f64(x: f64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    let pi = 3.14159265358979323846\n")
    append_src_lit("    let two_pi = 6.28318530717958647692\n")
    append_src_lit("    var t = x\n")
    append_src_lit("    while t > pi { t = t - two_pi }\n")
    append_src_lit("    while t < 0.0 - pi { t = t + two_pi }\n")
    append_src_lit("    let x2 = t * t\n")
    append_src_lit("    let x4 = x2 * x2\n")
    append_src_lit("    let x6 = x4 * x2\n")
    append_src_lit("    1.0 - x2 / 2.0 + x4 / 24.0 - x6 / 720.0\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_tanh_f64(x: f64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    if x > 20.0 { return 1.0 }\n")
    append_src_lit("    if x < 0.0 - 20.0 { return 0.0 - 1.0 }\n")
    append_src_lit("    let e2x = __native_exp_f64(2.0 * x)\n")
    append_src_lit("    (e2x - 1.0) / (e2x + 1.0)\n")
    append_src_lit("}\n\n")
}

fn append_native_prelude_printing() with Mut, Panic, Div {
    append_src_lit("fn __native_print_u64_no_nl(v: i64) with IO, Mut, Panic, Div {\n")
    append_src_lit("    if v == 0 { print_char(48); return }\n")
    append_src_lit("    var div: i64 = 1\n")
    append_src_lit("    while div <= v / 10 { div = div * 10 }\n")
    append_src_lit("    var n = v\n")
    append_src_lit("    while div > 0 {\n")
    append_src_lit("        let digit = n / div\n")
    append_src_lit("        print_char(48 + digit)\n")
    append_src_lit("        n = n % div\n")
    append_src_lit("        div = div / 10\n")
    append_src_lit("    }\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_print_fixed_digits(v: i64, width: i64) with IO, Mut, Panic, Div {\n")
    append_src_lit("    if width <= 0 { return }\n")
    append_src_lit("    var div: i64 = 1\n")
    append_src_lit("    var i: i64 = 1\n")
    append_src_lit("    while i < width {\n")
    append_src_lit("        div = div * 10\n")
    append_src_lit("        i = i + 1\n")
    append_src_lit("    }\n")
    append_src_lit("    var n = v\n")
    append_src_lit("    while div > 0 {\n")
    append_src_lit("        let digit = n / div\n")
    append_src_lit("        print_char(48 + digit)\n")
    append_src_lit("        n = n % div\n")
    append_src_lit("        div = div / 10\n")
    append_src_lit("    }\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_print_f64_n(x: f64, decimals: i64) with IO, Mut, Panic, Div {\n")
    append_src_lit("    if x != x { print(\"nan\"); return }\n")
    append_src_lit("    var d = decimals\n")
    append_src_lit("    if d < 0 { d = 0 }\n")
    append_src_lit("    if d > 12 { d = 12 }\n")
    append_src_lit("    var y = x\n")
    append_src_lit("    if y < 0.0 {\n")
    append_src_lit("        print_char(45)\n")
    append_src_lit("        y = 0.0 - y\n")
    append_src_lit("    }\n")
    append_src_lit("    let whole_f = __native_floor_f64(y)\n")
    append_src_lit("    var whole = whole_f as i64\n")
    append_src_lit("    var scale_i: i64 = 0\n")
    append_src_lit("    var scale_int: i64 = 1\n")
    append_src_lit("    while scale_i < d {\n")
    append_src_lit("        scale_int = scale_int * 10\n")
    append_src_lit("        scale_i = scale_i + 1\n")
    append_src_lit("    }\n")
    append_src_lit("    let scale = scale_int as f64\n")
    append_src_lit("    var frac = ((y - whole_f) * scale + 0.5) as i64\n")
    append_src_lit("    if frac >= scale_int {\n")
    append_src_lit("        whole = whole + 1\n")
    append_src_lit("        frac = 0\n")
    append_src_lit("    }\n")
    append_src_lit("    __native_print_u64_no_nl(whole)\n")
    append_src_lit("    if d > 0 {\n")
    append_src_lit("        print_char(46)\n")
    append_src_lit("        __native_print_fixed_digits(frac, d)\n")
    append_src_lit("    }\n")
    append_src_lit("}\n\n")
}

fn append_native_prelude_parse() with Mut, Panic, Div {
    append_src_lit("fn __native_parse_i64(buf: string, offset: i64, len: i64) -> i64 with Mut, Div, Panic {\n")
    append_src_lit("    if len <= 0 { return 0 }\n")
    append_src_lit("    var i: i64 = 0\n")
    append_src_lit("    var sign: i64 = 1\n")
    append_src_lit("    var value: i64 = 0\n")
    append_src_lit("    if str_char_at(buf, offset) == 45 { sign = 0 - 1; i = 1 }\n")
    append_src_lit("    while i < len {\n")
    append_src_lit("        let c = str_char_at(buf, offset + i)\n")
    append_src_lit("        if c < 48 || c > 57 { break }\n")
    append_src_lit("        value = value * 10 + (c - 48)\n")
    append_src_lit("        i = i + 1\n")
    append_src_lit("    }\n")
    append_src_lit("    if sign < 0 { return 0 - value }\n")
    append_src_lit("    value\n")
    append_src_lit("}\n\n")

    append_src_lit("fn __native_parse_f64(buf: string, offset: i64, len: i64) -> f64 with Mut, Div, Panic {\n")
    append_src_lit("    if len <= 0 { return 0.0 }\n")
    append_src_lit("    var i: i64 = 0\n")
    append_src_lit("    var sign = 1.0\n")
    append_src_lit("    if str_char_at(buf, offset) == 45 { sign = 0.0 - 1.0; i = 1 }\n")
    append_src_lit("    var int_part = 0.0\n")
    append_src_lit("    while i < len {\n")
    append_src_lit("        let c = str_char_at(buf, offset + i)\n")
    append_src_lit("        if c < 48 || c > 57 { break }\n")
    append_src_lit("        int_part = int_part * 10.0 + ((c - 48) as f64)\n")
    append_src_lit("        i = i + 1\n")
    append_src_lit("    }\n")
    append_src_lit("    var frac = 0.0\n")
    append_src_lit("    var denom = 10.0\n")
    append_src_lit("    if i < len && str_char_at(buf, offset + i) == 46 {\n")
    append_src_lit("        i = i + 1\n")
    append_src_lit("        while i < len {\n")
    append_src_lit("            let c = str_char_at(buf, offset + i)\n")
    append_src_lit("            if c < 48 || c > 57 { break }\n")
    append_src_lit("            frac = frac + ((c - 48) as f64) / denom\n")
    append_src_lit("            denom = denom * 10.0\n")
    append_src_lit("            i = i + 1\n")
    append_src_lit("        }\n")
    append_src_lit("    }\n")
    append_src_lit("    var value = int_part + frac\n")
    append_src_lit("    if i < len {\n")
    append_src_lit("        let ec = str_char_at(buf, offset + i)\n")
    append_src_lit("        if ec == 101 || ec == 69 {\n")
    append_src_lit("            i = i + 1\n")
    append_src_lit("            var exp_sign: i64 = 1\n")
    append_src_lit("            if i < len {\n")
    append_src_lit("                let sc = str_char_at(buf, offset + i)\n")
    append_src_lit("                if sc == 45 { exp_sign = 0 - 1; i = i + 1 }\n")
    append_src_lit("                else if sc == 43 { i = i + 1 }\n")
    append_src_lit("            }\n")
    append_src_lit("            var exp_value: i64 = 0\n")
    append_src_lit("            while i < len {\n")
    append_src_lit("                let c = str_char_at(buf, offset + i)\n")
    append_src_lit("                if c < 48 || c > 57 { break }\n")
    append_src_lit("                exp_value = exp_value * 10 + (c - 48)\n")
    append_src_lit("                i = i + 1\n")
    append_src_lit("            }\n")
    append_src_lit("            if exp_sign < 0 { exp_value = 0 - exp_value }\n")
    append_src_lit("            var scale_i: i64 = 0\n")
    append_src_lit("            if exp_value >= 0 {\n")
    append_src_lit("                while scale_i < exp_value {\n")
    append_src_lit("                    value = value * 10.0\n")
    append_src_lit("                    scale_i = scale_i + 1\n")
    append_src_lit("                }\n")
    append_src_lit("            } else {\n")
    append_src_lit("                while scale_i < 0 - exp_value {\n")
    append_src_lit("                    value = value / 10.0\n")
    append_src_lit("                    scale_i = scale_i + 1\n")
    append_src_lit("                }\n")
    append_src_lit("            }\n")
    append_src_lit("        }\n")
    append_src_lit("    }\n")
    append_src_lit("    value * sign\n")
    append_src_lit("}\n")
}

fn append_native_prelude() with Mut, Panic, Div {
    append_src_lit("\n")
    append_native_prelude_math()
    append_native_prelude_printing()
    append_native_prelude_parse()
}

// Resolve and load use statements from SRC[0..SRC_LEN]
fn resolve_imports() with IO, Mut, Panic, Div {
    var pos: i64 = 0
    while pos < SRC_LEN {
        if sb(pos) == 1 {
            var marker_s: i64 = pos + 1
            var marker_e: i64 = marker_s
            while marker_e < SRC_LEN && sb(marker_e) != 2 { marker_e = marker_e + 1 }
            if marker_e < SRC_LEN {
                set_base_dir_from_src_path(marker_s, marker_e)
                pos = marker_e + 1
                continue
            }
        }
        // Check for "use " at line start (117=u, 115=s, 101=e, 32=space)
        if pos + 4 < SRC_LEN && sb(pos) == 117 && sb(pos+1) == 115 && sb(pos+2) == 101 && sb(pos+3) == 32 {
            pos = pos + 4  // skip "use "
            // Extract module path until newline, semicolon, or ::*
            var path_start: i64 = pos
            var path_end: i64 = pos
            while pos < SRC_LEN && sb(pos) != 10 && sb(pos) != 59 && sb(pos) != 13 {
                if sb(pos) == 58 && pos + 1 < SRC_LEN && sb(pos+1) == 58 {
                    if pos + 2 < SRC_LEN && sb(pos+2) == 42 {
                        path_end = pos
                        pos = pos + 3  // skip ::*
                        break
                    }
                    if pos + 2 < SRC_LEN && sb(pos+2) == 123 {
                        path_end = pos
                        // Skip ::{...} until }
                        while pos < SRC_LEN && sb(pos) != 125 && sb(pos) != 10 { pos = pos + 1 }
                        if pos < SRC_LEN && sb(pos) == 125 { pos = pos + 1 }
                        break
                    }
                }
                pos = pos + 1
                path_end = pos
            }
            // Build filesystem path: convert :: to /
            var fp_len: i64 = 0
            // Check prefix: stdlib:: or self-hosted::
            var pi: i64 = path_start
            while pi < path_end {
                let c = sb(pi)
                if c == 58 && pi + 1 < path_end && sb(pi+1) == 58 {
                    IMP_PATH[fp_len as usize] = 47  // /
                    fp_len = fp_len + 1
                    pi = pi + 2
                } else if c == 42 || c == 123 || c == 125 || c == 32 {
                    pi = pi + 1  // skip wildcards, braces, spaces
                } else {
                    IMP_PATH[fp_len as usize] = c as i8
                    fp_len = fp_len + 1
                    pi = pi + 1
                }
            }
            // Append .sio if not already present
            if fp_len > 4 && IMP_PATH[(fp_len-4) as usize] == 46 && IMP_PATH[(fp_len-3) as usize] == 115 {
                // already has .sio — skip
            } else {
                IMP_PATH[fp_len as usize] = 46; fp_len = fp_len + 1   // .
                IMP_PATH[fp_len as usize] = 115; fp_len = fp_len + 1  // s
                IMP_PATH[fp_len as usize] = 105; fp_len = fp_len + 1  // i
                IMP_PATH[fp_len as usize] = 111; fp_len = fp_len + 1  // o
            }
            let raw_len = fp_len
            var raw_i: i64 = 0
            while raw_i < raw_len {
                IMP_RAW_PATH[raw_i as usize] = IMP_PATH[raw_i as usize]
                raw_i = raw_i + 1
            }
            IMP_RAW_PATH[raw_len as usize] = 0
            var needs_base_dir: i64 = 1
            if fp_len > 0 && IMP_PATH[0 as usize] as i64 == 47 { needs_base_dir = 0 }
            if fp_len >= 7 {
                if IMP_PATH[0 as usize] as i64 == 115 && IMP_PATH[1 as usize] as i64 == 116 && IMP_PATH[2 as usize] as i64 == 100 && IMP_PATH[3 as usize] as i64 == 108 && IMP_PATH[4 as usize] as i64 == 105 && IMP_PATH[5 as usize] as i64 == 98 && IMP_PATH[6 as usize] as i64 == 47 {
                    needs_base_dir = 0
                }
            }
            if fp_len >= 12 {
                if IMP_PATH[0 as usize] as i64 == 115 && IMP_PATH[1 as usize] as i64 == 101 && IMP_PATH[2 as usize] as i64 == 108 && IMP_PATH[3 as usize] as i64 == 102 && IMP_PATH[4 as usize] as i64 == 45 && IMP_PATH[5 as usize] as i64 == 104 && IMP_PATH[6 as usize] as i64 == 111 && IMP_PATH[7 as usize] as i64 == 115 && IMP_PATH[8 as usize] as i64 == 116 && IMP_PATH[9 as usize] as i64 == 101 && IMP_PATH[10 as usize] as i64 == 100 && IMP_PATH[11 as usize] as i64 == 47 {
                    needs_base_dir = 0
                }
            }
            if needs_base_dir == 1 && BASE_DIR_LEN > 0 {
                var sj: i64 = fp_len - 1
                while sj >= 0 {
                    IMP_PATH[(BASE_DIR_LEN + 1 + sj) as usize] = IMP_PATH[sj as usize]
                    sj = sj - 1
                }
                var bj: i64 = 0
                while bj < BASE_DIR_LEN {
                    IMP_PATH[bj as usize] = BASE_DIR[bj as usize]
                    bj = bj + 1
                }
                IMP_PATH[BASE_DIR_LEN as usize] = 47
                fp_len = BASE_DIR_LEN + 1 + fp_len
            }
            IMP_PATH[fp_len as usize] = 0  // null terminate
            var raw = read_file(IMP_PATH)
            var copy_len = str_len(raw)
            var fsz: i64 = file_size(IMP_PATH)
            // mod.sio fallback for BASE_DIR path
            if copy_len <= 0 {
                var mfp: i64 = fp_len - 4
                var mi: i64 = 0
                while mi < mfp {
                    MOD_PATH[mi as usize] = IMP_PATH[mi as usize]
                    mi = mi + 1
                }
                MOD_PATH[mfp as usize] = 47
                MOD_PATH[(mfp+1) as usize] = 109
                MOD_PATH[(mfp+2) as usize] = 111
                MOD_PATH[(mfp+3) as usize] = 100
                MOD_PATH[(mfp+4) as usize] = 46
                MOD_PATH[(mfp+5) as usize] = 115
                MOD_PATH[(mfp+6) as usize] = 105
                MOD_PATH[(mfp+7) as usize] = 111
                mfp = mfp + 8
                MOD_PATH[mfp as usize] = 0
                raw = read_file(MOD_PATH)
                copy_len = str_len(raw)
                fsz = file_size(MOD_PATH)
                if copy_len > 0 {
                    mi = 0
                    while mi < mfp {
                        IMP_PATH[mi as usize] = MOD_PATH[mi as usize]
                        mi = mi + 1
                    }
                    fp_len = mfp
                    IMP_PATH[fp_len as usize] = 0
                }
            }
            if copy_len <= 0 && needs_base_dir == 1 {
                // Try stdlib/ prefix first
                IMP_PATH[0 as usize] = 115
                IMP_PATH[1 as usize] = 116
                IMP_PATH[2 as usize] = 100
                IMP_PATH[3 as usize] = 108
                IMP_PATH[4 as usize] = 105
                IMP_PATH[5 as usize] = 98
                IMP_PATH[6 as usize] = 47
                raw_i = 0
                while raw_i < raw_len {
                    IMP_PATH[(7 + raw_i) as usize] = IMP_RAW_PATH[raw_i as usize]
                    raw_i = raw_i + 1
                }
                fp_len = 7 + raw_len
                IMP_PATH[fp_len as usize] = 0
                raw = read_file(IMP_PATH)
                copy_len = str_len(raw)
                fsz = file_size(IMP_PATH)
                // mod.sio fallback for stdlib path
                if copy_len <= 0 {
                    var mfp: i64 = fp_len - 4
                    var mi: i64 = 0
                    while mi < mfp {
                        MOD_PATH[mi as usize] = IMP_PATH[mi as usize]
                        mi = mi + 1
                    }
                    MOD_PATH[mfp as usize] = 47
                    MOD_PATH[(mfp+1) as usize] = 109
                    MOD_PATH[(mfp+2) as usize] = 111
                    MOD_PATH[(mfp+3) as usize] = 100
                    MOD_PATH[(mfp+4) as usize] = 46
                    MOD_PATH[(mfp+5) as usize] = 115
                    MOD_PATH[(mfp+6) as usize] = 105
                    MOD_PATH[(mfp+7) as usize] = 111
                    mfp = mfp + 8
                    MOD_PATH[mfp as usize] = 0
                    raw = read_file(MOD_PATH)
                    copy_len = str_len(raw)
                    fsz = file_size(MOD_PATH)
                    if copy_len > 0 {
                        mi = 0
                        while mi < mfp {
                            IMP_PATH[mi as usize] = MOD_PATH[mi as usize]
                            mi = mi + 1
                        }
                        fp_len = mfp
                        IMP_PATH[fp_len as usize] = 0
                    }
                }
                if copy_len <= 0 {
                    fp_len = raw_len
                    raw_i = 0
                    while raw_i < raw_len {
                        IMP_PATH[raw_i as usize] = IMP_RAW_PATH[raw_i as usize]
                        raw_i = raw_i + 1
                    }
                    IMP_PATH[fp_len as usize] = 0
                    raw = read_file(IMP_PATH)
                    copy_len = str_len(raw)
                    fsz = file_size(IMP_PATH)
                    // mod.sio fallback for raw path
                    if copy_len <= 0 {
                        var mfp: i64 = fp_len - 4
                        var mi: i64 = 0
                        while mi < mfp {
                            MOD_PATH[mi as usize] = IMP_PATH[mi as usize]
                            mi = mi + 1
                        }
                        MOD_PATH[mfp as usize] = 47
                        MOD_PATH[(mfp+1) as usize] = 109
                        MOD_PATH[(mfp+2) as usize] = 111
                        MOD_PATH[(mfp+3) as usize] = 100
                        MOD_PATH[(mfp+4) as usize] = 46
                        MOD_PATH[(mfp+5) as usize] = 115
                        MOD_PATH[(mfp+6) as usize] = 105
                        MOD_PATH[(mfp+7) as usize] = 111
                        mfp = mfp + 8
                        MOD_PATH[mfp as usize] = 0
                        raw = read_file(MOD_PATH)
                        copy_len = str_len(raw)
                        fsz = file_size(MOD_PATH)
                        if copy_len > 0 {
                            mi = 0
                            while mi < mfp {
                                IMP_PATH[mi as usize] = MOD_PATH[mi as usize]
                                mi = mi + 1
                            }
                            fp_len = mfp
                            IMP_PATH[fp_len as usize] = 0
                        }
                    }
                }
                if copy_len <= 0 {
                    IMP_PATH[0 as usize] = 115
                    IMP_PATH[1 as usize] = 101
                    IMP_PATH[2 as usize] = 108
                    IMP_PATH[3 as usize] = 102
                    IMP_PATH[4 as usize] = 45
                    IMP_PATH[5 as usize] = 104
                    IMP_PATH[6 as usize] = 111
                    IMP_PATH[7 as usize] = 115
                    IMP_PATH[8 as usize] = 116
                    IMP_PATH[9 as usize] = 101
                    IMP_PATH[10 as usize] = 100
                    IMP_PATH[11 as usize] = 47
                    raw_i = 0
                    while raw_i < raw_len {
                        IMP_PATH[(12 + raw_i) as usize] = IMP_RAW_PATH[raw_i as usize]
                        raw_i = raw_i + 1
                    }
                    fp_len = 12 + raw_len
                    IMP_PATH[fp_len as usize] = 0
                    raw = read_file(IMP_PATH)
                    copy_len = str_len(raw)
                    fsz = file_size(IMP_PATH)
                    // mod.sio fallback for self-hosted path
                    if copy_len <= 0 {
                        var mfp: i64 = fp_len - 4
                        var mi: i64 = 0
                        while mi < mfp {
                            MOD_PATH[mi as usize] = IMP_PATH[mi as usize]
                            mi = mi + 1
                        }
                        MOD_PATH[mfp as usize] = 47
                        MOD_PATH[(mfp+1) as usize] = 109
                        MOD_PATH[(mfp+2) as usize] = 111
                        MOD_PATH[(mfp+3) as usize] = 100
                        MOD_PATH[(mfp+4) as usize] = 46
                        MOD_PATH[(mfp+5) as usize] = 115
                        MOD_PATH[(mfp+6) as usize] = 105
                        MOD_PATH[(mfp+7) as usize] = 111
                        mfp = mfp + 8
                        MOD_PATH[mfp as usize] = 0
                        raw = read_file(MOD_PATH)
                        copy_len = str_len(raw)
                        fsz = file_size(MOD_PATH)
                        if copy_len > 0 {
                            mi = 0
                            while mi < mfp {
                                IMP_PATH[mi as usize] = MOD_PATH[mi as usize]
                                mi = mi + 1
                            }
                            fp_len = mfp
                            IMP_PATH[fp_len as usize] = 0
                        }
                    }
                }
            }
            if copy_len <= 0 {
                print("error: unreadable import: ")
                print_imp_path()
                print("\n")
            } else {
                if fsz <= 0 || fsz >= 8388608 {
                    print("warning: import size invalid; using read count for ")
                    print_imp_path()
                    print("\n")
                }
                // Dedup check — string comparison (hash pre-filter + full path match)
                let ph = imp_path_hash(fp_len)
                var already: i64 = 0
                var di: i64 = 0
                while di < IMP_COUNT {
                    if IMP_LOADED[di as usize] == ph && IMP_LOADED_LENS[di as usize] == fp_len {
                        let off = IMP_LOADED_OFFS[di as usize]
                        var match_ok: i64 = 1
                        var mi: i64 = 0
                        while mi < fp_len {
                            if IMP_LOADED_PATHS[(off + mi) as usize] != IMP_PATH[mi as usize] { match_ok = 0 }
                            mi = mi + 1
                        }
                        if match_ok == 1 { already = 1 }
                    }
                    di = di + 1
                }
                if already == 0 {
                    if IMP_COUNT >= 1024 {
                        print("error: import dedup table full: ")
                        print_imp_path()
                        print("\n")
                    } else if IMP_PATHS_USED + fp_len > 262144 {
                        print("error: import path table full: ")
                        print_imp_path()
                        print("\n")
                    } else if copy_len >= 8388608 || SRC_LEN + fp_len + copy_len + 3 >= 8388608 {
                        print("error: import too large for SRC buffer: ")
                        print_imp_path()
                        print(" (")
                        print_int(copy_len)
                        print(" bytes)\n")
                    } else {
                        let prev_src_len = SRC_LEN
                        SRC[SRC_LEN as usize] = 10
                        SRC_LEN = SRC_LEN + 1
                        SRC[SRC_LEN as usize] = 1
                        SRC_LEN = SRC_LEN + 1
                        var pi2: i64 = 0
                        while pi2 < fp_len {
                            SRC[(SRC_LEN + pi2) as usize] = IMP_PATH[pi2 as usize]
                            pi2 = pi2 + 1
                        }
                        SRC_LEN = SRC_LEN + fp_len
                        SRC[SRC_LEN as usize] = 2
                        SRC_LEN = SRC_LEN + 1
                        var ci: i64 = 0
                        while ci < copy_len && SRC_LEN + ci < 8388608 {
                            SRC[(SRC_LEN + ci) as usize] = raw[ci as usize]
                            ci = ci + 1
                        }
                        if ci != copy_len {
                            SRC_LEN = prev_src_len
                            print("error: import copy truncated: ")
                            print_imp_path()
                            print("\n")
                        } else {
                            SRC_LEN = SRC_LEN + copy_len
                            IMP_LOADED[IMP_COUNT as usize] = ph
                            IMP_LOADED_OFFS[IMP_COUNT as usize] = IMP_PATHS_USED
                            IMP_LOADED_LENS[IMP_COUNT as usize] = fp_len
                            var ri: i64 = 0
                            while ri < fp_len {
                                IMP_LOADED_PATHS[(IMP_PATHS_USED + ri) as usize] = IMP_PATH[ri as usize]
                                ri = ri + 1
                            }
                            IMP_PATHS_USED = IMP_PATHS_USED + fp_len
                            IMP_COUNT = IMP_COUNT + 1
                            print("import: ")
                            print_imp_path()
                            print(" ")
                            print_int(copy_len)
                            print(" bytes\n")
                        }
                    }
                }
            }
        }
        // Advance to next line
        while pos < SRC_LEN && sb(pos) != 10 { pos = pos + 1 }
        if pos < SRC_LEN { pos = pos + 1 }
    }
}

// Track extern function count for diagnostics
var EXTERN_FN_COUNT: i64 = 0

fn strip_extern_blocks() with IO, Mut, Panic {
    // Phase 1: Count extern fn declarations for diagnostics
    var scan: i64 = 0
    while scan < SRC_LEN {
        if scan + 9 < SRC_LEN && sb(scan) == 101 && sb(scan + 1) == 120 && sb(scan + 2) == 116 && sb(scan + 3) == 101 && sb(scan + 4) == 114 && sb(scan + 5) == 110 && sb(scan + 6) == 32 && sb(scan + 7) == 34 && sb(scan + 8) == 67 && sb(scan + 9) == 34 {
            // Count fn declarations inside this extern block
            var es: i64 = scan
            while es < SRC_LEN && sb(es) != 123 { es = es + 1 }
            if es < SRC_LEN {
                var ed: i64 = 1
                es = es + 1
                while es < SRC_LEN && ed > 0 {
                    // Look for 'fn' keyword (102, 110, 32 or 10)
                    if sb(es) == 102 && es + 1 < SRC_LEN && sb(es + 1) == 110 && es + 2 < SRC_LEN && (sb(es + 2) == 32 || sb(es + 2) == 10) {
                        EXTERN_FN_COUNT = EXTERN_FN_COUNT + 1
                    }
                    if sb(es) == 123 { ed = ed + 1 }
                    if sb(es) == 125 { ed = ed - 1 }
                    es = es + 1
                }
            }
        }
        scan = scan + 1
    }

    // Phase 2: Strip extern blocks (preserve newlines for line tracking)
    var r: i64 = 0
    var w: i64 = 0
    while r < SRC_LEN {
        if r + 9 < SRC_LEN && sb(r) == 101 && sb(r + 1) == 120 && sb(r + 2) == 116 && sb(r + 3) == 101 && sb(r + 4) == 114 && sb(r + 5) == 110 && sb(r + 6) == 32 && sb(r + 7) == 34 && sb(r + 8) == 67 && sb(r + 9) == 34 {
            while r < SRC_LEN && sb(r) != 123 {
                if sb(r) == 10 {
                    SRC[w as usize] = 10
                    w = w + 1
                }
                r = r + 1
            }
            if r < SRC_LEN && sb(r) == 123 {
                var depth: i64 = 1
                r = r + 1
                while r < SRC_LEN && depth > 0 {
                    if sb(r) == 123 { depth = depth + 1 }
                    if sb(r) == 125 { depth = depth - 1 }
                    if sb(r) == 10 {
                        SRC[w as usize] = 10
                        w = w + 1
                    }
                    r = r + 1
                }
                continue
            }
        }
        SRC[w as usize] = SRC[r as usize]
        w = w + 1
        r = r + 1
    }
    SRC_LEN = w
}

fn main() -> i64 with IO, Mut, Panic, Div {
    // β fix: explicit init — native BSS zeroes var inits, overriding the
    // declared -1 sentinel for EXPR_SCRATCH_SOURCE_SLOT.
    EXPR_SCRATCH_SOURCE_SLOT = 0 - 1
    EXPR_VARIANCE_HASH = 0
    var beta_init_i: i64 = 0
    while beta_init_i < 1024 {
        KNOWLEDGE_CHANNEL_FOR_SLOT[beta_init_i as usize] = 0
        VAR_VARIANCE_HASH[beta_init_i as usize] = 0
        beta_init_i = beta_init_i + 1
    }
    let argc = arg_count()
    if argc < 2 {
        print("Usage: mini_native <source.sio> <output> [--show-ast] [--show-types] [--gpu-runtime] [--target x86_64-windows]\n")
        return 1
    }
    let src = get_arg(0)
    let out = get_arg(1)
    let src_len = str_len(src)
    BASE_DIR_LEN = 0
    var src_i: i64 = 0
    var last_slash: i64 = -1
    while src_i < src_len {
        if str_char_at(src, src_i) == 47 { last_slash = src_i }
        src_i = src_i + 1
    }
    if last_slash < 0 {
        BASE_DIR[0 as usize] = 46
        BASE_DIR_LEN = 1
    } else {
        src_i = 0
        while src_i < last_slash && src_i < 511 {
            BASE_DIR[src_i as usize] = str_char_at(src, src_i) as i8
            src_i = src_i + 1
        }
        BASE_DIR_LEN = src_i
    }
    BASE_DIR[BASE_DIR_LEN as usize] = 0

    CLI_SHOW_AST = 0
    CLI_SHOW_TYPES = 0
    CLI_GPU_RUNTIME_ENABLED = 0
    var arg_i: i64 = 2
    while arg_i < argc {
        let flag = get_arg(arg_i)
        if cli_arg_eq(flag, "--show-ast") {
            CLI_SHOW_AST = 1
        } else {
            if cli_arg_eq(flag, "--show-types") {
                CLI_SHOW_TYPES = 1
            } else {
                if cli_arg_eq(flag, "--backend") && arg_i + 1 < argc {
                    let be = get_arg(arg_i + 1)
                    if cli_arg_eq(be, "gpu") {
                        TARGET_BACKEND = 1
                        CLI_GPU_ENABLED = 1
                    } else {
                        if cli_arg_eq(be, "native") {
                            TARGET_BACKEND = 0
                        } else {
                            print("error: unknown backend '")
                            print(be)
                            print("' (supported: native, gpu)\n")
                            return 1
                        }
                    }
                    arg_i = arg_i + 1
                } else {
                    if cli_arg_eq(flag, "--gpu-runtime") {
                        CLI_GPU_RUNTIME_ENABLED = 1
                    } else {
                    if cli_arg_eq(flag, "--gpu-precision") && arg_i + 1 < argc {
                        let prec = get_arg(arg_i + 1)
                        if cli_arg_eq(prec, "f32") {
                            GPU_PRECISION = 1
                        } else {
                            if cli_arg_eq(prec, "f64") {
                                GPU_PRECISION = 0
                            } else {
                                print("error: unknown gpu precision '")
                                print(prec)
                                print("' (supported: f32, f64)\n")
                                return 1
                            }
                        }
                        arg_i = arg_i + 1
                    } else {
                        if cli_arg_eq(flag, "--gpu-target") && arg_i + 1 < argc {
                            arg_i = arg_i + 1
                        } else {
                            if cli_arg_eq(flag, "--target") && arg_i + 1 < argc {
                                let targ = get_arg(arg_i + 1)
                                if cli_arg_eq(targ, "x86_64-windows") {
                                    TARGET_OS = 3
                                    TARGET_ARCH = 0
                                } else {
                                    if cli_arg_eq(targ, "x86_64-macos") {
                                        TARGET_OS = 2
                                        TARGET_ARCH = 0
                                    } else {
                                        if cli_arg_eq(targ, "aarch64-macos") {
                                            TARGET_OS = 2
                                            TARGET_ARCH = 1
                                        } else {
                                            if cli_arg_eq(targ, "aarch64-linux") {
                                                TARGET_OS = 0
                                                TARGET_ARCH = 1
                                            }
                                        }
                                    }
                                }
                                arg_i = arg_i + 1
                            }
                        }
                    }
                    }
                }
            }
        }
        arg_i = arg_i + 1
    }

    let raw = read_file(src)
    let sz = file_size(src)
    var i: i64 = 0
    while i < sz && i < 8388608 { SRC[i as usize] = raw[i as usize]; i = i + 1 }
    SRC_LEN = sz
    MAIN_SRC_END = sz
    print("source: "); print(src); print(" "); print_int(sz); print(" bytes\n")
    resolve_imports()
    strip_extern_blocks()
    append_native_prelude()
    print("total source: "); print_int(SRC_LEN); print(" bytes\n")
    if precheck_knightian_conflict() != 0 { return 1 }
    if precheck_temporal_window_conflict() != 0 { return 1 }
    lex_all()
    if LEX_ERROR_LINE != 0 {
        print("lex error line ")
        print_int(LEX_ERROR_LINE)
        print(": ")
        if LEX_ERROR_KIND == 2 {
            print("invalid escape sequence\n")
        } else {
            print("Unexpected character\n")
        }
        return 1
    }
    print("tokens: "); print_int(TC); print("\n")
    var cr: i64 = 0
    if TARGET_ARCH == 1 {
        cr = compile_all_arm64()
    } else {
        cr = compile_all()
    }
    if cr != 0 { return cr }
    if TARGET_BACKEND == 1 {
        collect_all_kernels_ptx()
        assemble_all_kernels_ptx()
        return write_ptx(out)
    }
    if TARGET_ARCH == 1 {
        if TARGET_OS == 2 {
            write_macho_arm64(out)
        } else {
            write_elf_arm64(out)
        }
    } else if TARGET_OS == 3 {
        write_pe(out)
    } else if TARGET_OS == 2 {
        write_macho_x86(out)
    } else {
        write_elf(out)
    }
    return 0
}
