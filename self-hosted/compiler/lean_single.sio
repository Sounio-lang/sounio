        EXPR_IS_F64 = 0
        return
    }
    // Unary minus
    if k == 18 {
        let op_tok = EP
        EP = EP + 1
        compile_primary()
        if EXPR_TY != 0 && ty_is_numeric(EXPR_TY) == false { tc_error(op_tok, "unary - requires numeric operand") }
        // EXPR_IS_F64 kept from inner expression (unary minus preserves type)
        if EXPR_IS_F64 == 1 {
