            EXPR_TY = deref_inner_ty_a
            EXPR_TY_HASH = deref_inner_hash_a
        } else {
            em32(0xF9400000)  // ldr x0, [x0]
            EXPR_TY = 0
            EXPR_TY_HASH = 0
        }
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
        return
    }
    // Unary minus
    if k == 18 {
        EP = EP + 1
        compile_primary_a64()
        compile_postfix_tail_a64()
        if EXPR_IS_F64 == 1 {
            em32(0x9E670000); em32(0x1E614000); em32(0x9E660000)
        } else {
            em32(0xCB0003E0)  // neg x0, x0
        }
        return
    }
    // Unary bitwise NOT ~
    if k == 55 {
        EP = EP + 1
        compile_primary_a64()
        compile_postfix_tail_a64()
        em32(0xAA2003E0)  // mvn x0, x0
        EXPR_IS_F64 = 0
        return
    }
