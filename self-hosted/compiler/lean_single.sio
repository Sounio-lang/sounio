// bootstrap/mini_native.sio — Self-contained native compiler for Sounio subset.
// Compiles: fn, return, print("str"), let/var, arithmetic, if/else, while, function calls.
// Produces standalone x86-64 Linux ELF. No imports — boot4 compatible.
//
// Usage: boot4.elf bootstrap/mini_native.sio /tmp/mini_native.elf
//        /tmp/mini_native.elf input.sio output.elf

// ─── Global buffers ───
var SRC: [i8; 16777216] = [0; 16777216]
var SRC_LEN: i64 = 0
// Import resolution
var IMP_PATH: [i8; 4096] = [0; 4096]
var IMP_RAW_PATH: [i8; 4096] = [0; 4096]
var MOD_PATH: [i8; 4096] = [0; 4096]
var IMP_LOADED: [i64; 2048] = [0; 2048]
var IMP_LOADED_PATHS: [i8; 262144] = [0; 262144]
var IMP_LOADED_OFFS: [i64; 2048] = [0; 2048]
var IMP_LOADED_LENS: [i64; 2048] = [0; 2048]
var IMP_PATHS_USED: i64 = 0
var IMP_COUNT: i64 = 0
var IMPORT_RESOLUTION_FAILED: i64 = 0
var BASE_DIR: [i8; 512] = [0; 512]
var BASE_DIR_LEN: i64 = 0
var CLI_SHOW_AST: i64 = 0
var CLI_SHOW_TYPES: i64 = 0
var CLI_DEBUG_FN_MAP: i64 = 0
var CLI_R15_MONITOR: i64 = 0     // --r15-monitor: emit R15 confidence checks at all call sites
var R15_GATE_COUNT: i64 = 0      // number of call sites instrumented
var R15_SIDE_TABLE_BSS_OFF: i64 = 0  // BSS offset of the R15 side table

// Token parallel arrays (kind, start, end, int_value)
// Keep lean_single aligned with the 1M-token modular parser/lexer path.
var TK: [i64; 2097152] = [0; 2097152]
var TS: [i64; 2097152] = [0; 2097152]
var TE: [i64; 2097152] = [0; 2097152]
var TV: [i64; 2097152] = [0; 2097152]
// Float literal extra: frac numerator and denominator (kind=53)
var TF: [i64; 2097152] = [0; 2097152]
var TD: [i64; 2097152] = [0; 2097152]
// Float literal scientific exponent (signed exp_val; 0 = no exponent)
var TX: [i64; 2097152] = [0; 2097152]
var TL: [i64; 2097152] = [0; 2097152]
var TC: i64 = 0

// Code output
var CD: [i8; 134217728] = [0; 134217728]
var CL: i64 = 0
var CD_OVF: i64 = 0
var CD_OVF_FN: i64 = 0
var CD_OVF_CL: i64 = 0
var TRAMP_OFF: i64 = 0

// ELF/PE output
var ELF: [i8; 67112960] = [0; 67112960]

// Target OS: 0=linux (default), 2=macos, 3=windows
var TARGET_OS: i64 = 0
// Target arch: 0=x86_64 (default), 1=aarch64
var TARGET_ARCH: i64 = 0
// Ontology validation: class/role name tracking (reset per ontology block)
var ONT_CLS_S: [i64; 64] = [0; 64]
var ONT_CLASS_E: [i64; 64] = [0; 64]
var ONT_CLASS_COUNT: i64 = 0
var ONT_ROLE_S: [i64; 32] = [0; 32]
var ONT_ROLE_E: [i64; 32] = [0; 32]
var ONT_ROLE_COUNT: i64 = 0
// OWL2 kernel: class hashes + subclass/disjoint matrices (64×64, reset per ontology block)
var ONT_CLASS_HASH: [i64; 64] = [0; 64]
var ONT_SUB_MATRIX: [i64; 4096] = [0; 4096]
var ONT_DIS_MATRIX: [i64; 4096] = [0; 4096]
var ONT_DIS_TMP: [i64; 64] = [0; 64]  // temp list for disjoint class indices
var ONT_DIS_TMP_CNT: i64 = 0
// Property constraint storage for ontology subsumption checking
var ONT_PROP_CLS: [i64; 256] = [0; 256]    // class index
var ONT_PROP_NHASH: [i64; 256] = [0; 256]  // property name hash
var ONT_PROP_BOUND: [i64; 256] = [0; 256]  // signed bound ×1000 (neg stored as negative)
var ONT_PROP_DIR: [i64; 256] = [0; 256]    // 0 = >=, 1 = <=
var ONT_PROP_CNT: i64 = 0
// PE: offset within CD[] of the ExitProcess call [rip+disp32]'s disp32 field
var PE_EXIT_CALL_OFF: i64 = -1

// Shared string scratch buffer: used both as packed qwords and as decoded bytes.
var SQW: [i64; 256] = [0; 256]

// Function table: name start/end in source, code offset
var FN_NS: [i64; 65536] = [0; 65536]
var FN_NE: [i64; 65536] = [0; 65536]
var FN_OFF: [i64; 65536] = [0; 65536]
var FN_SIG: [i64; 65536] = [0; 65536]
var FN_IS_KERNEL: [i64; 65536] = [0; 65536]
var FN_PTX_SUPPORTED: [i64; 65536] = [0; 65536]
var FN_PTX_KIND: [i64; 65536] = [0; 65536]
var FN_PTX_OFF: [i64; 65536] = [0; 65536]
var FN_PTX_LEN: [i64; 65536] = [0; 65536]
var FN_PTX_EXTENT_SLOT: [i64; 65536] = [0; 65536]
var FN_PTX_PARAM_KINDS: [i64; 65536] = [0; 65536]
var FN_COUNT: i64 = 0
var FN_RECV_HASH: [i64; 65536] = [0; 65536]
// 1 iff the fn was defined inside a real `impl` block (a true method, dot-called
// via recv-aware fn_find_method). 0 for free functions — including UFCS free fns
// whose struct first param gives them a nonzero FN_RECV_HASH but which are still
// name-only-resolved by fn_find. Used by the bundle collision check.
var FN_IN_IMPL: [i64; 65536] = [0; 65536]

var PTX_BUF: [i8; 262144] = [0; 262144]
var PTX_LEN: i64 = 0

// Call patch table: code offset where rel32 needs patching, target fn index.
// Current main already records 65,333 patches while self-building. A modest IR
// accessor migration measured 66,056 and wrote past the old 65,536 arrays,
// corrupting PATCH_COUNT to 519 and leaving late calls at rel32=0. Match the
// current native relocation tier so bootstrap growth has real headroom.
var PATCH_OFF: [i64; 131072] = [0; 131072]
var PATCH_FN: [i64; 131072] = [0; 131072]
var PATCH_KIND: [i64; 131072] = [0; 131072]
var PATCH_COUNT: i64 = 0

// Canonical function-signature registry for fn-typed values and indirect calls.
// Signatures are stored as arity + param types/hashes + return type/hash.
var FNSIG_ARITY: [i64; 256] = [0; 256]
var FNSIG_RET_TY: [i64; 256] = [0; 256]
var FNSIG_RET_HASH: [i64; 256] = [0; 256]
var FNSIG_PARAM_TY: [i64; 4096] = [0; 4096]
var FNSIG_PARAM_HASH: [i64; 4096] = [0; 4096]
var FNSIG_EFF: [i64; 256] = [0; 256]
var FNSIG_COUNT: i64 = 1
var FNSIG_SCRATCH_ARITY: i64 = 0
var FNSIG_SCRATCH_RET_TY: i64 = 0
var FNSIG_SCRATCH_RET_HASH: i64 = 0
var FNSIG_SCRATCH_EFF: i64 = 0
var FNSIG_SCRATCH_PARAM_TY: [i64; 16] = [0; 16]
var FNSIG_SCRATCH_PARAM_HASH: [i64; 16] = [0; 16]
var FNSIG_SCAN_DEPTH: i64 = 0
var FNSIG_TMP_PARAM_TY: [i64; 256] = [0; 256]
var FNSIG_TMP_PARAM_HASH: [i64; 256] = [0; 256]

// Closure FNSIG inference: depth-indexed stacks (max 8 nesting levels)
var CL_DEPTH: i64 = 0
var CL_FNSIG_NPARAMS: [i64; 8] = [0; 8]
var CL_FNSIG_PARAM_TY: [i64; 128] = [0; 128]
var CL_FNSIG_PARAM_TH: [i64; 128] = [0; 128]
var CL_FNSIG_RET_TY: [i64; 8] = [0; 8]
var CL_FNSIG_RET_HASH: [i64; 8] = [0; 8]
var CL_FNSIG_EFF: [i64; 8] = [0; 8]

// Struct registry: flat array, up to 32 structs
// ST[i*66+0] = name hash
// ST[i*66+1] = field count
// ST[i*66+2..65] = field name hashes (up to 64 fields)
var ST: [i64; 133120] = [0; 133120]
// Per-struct field type metadata, indexed as si*64 + fi
var ST_FTY: [i64; 131072] = [0; 131072]
var ST_FHASH: [i64; 131072] = [0; 131072]
var ST_COUNT: i64 = 0
// Field-name source positions for collision-safe lookup (concatenated SRC buffer)
var ST_FNS: [i64; 131072] = [0; 131072]
var ST_FNE: [i64; 131072] = [0; 131072]
// Per-struct module visibility. A non-pub struct may be constructed and have
// fields inspected only from the source file where it was declared.
var ST_PUBLIC: [i64; 2048] = [0; 2048]
var ST_DECL_NS: [i64; 2048] = [0; 2048]
var ST_DECL_NE: [i64; 2048] = [0; 2048]
// Query bounds for struct field lookup collision resolution
var ST_QUERY_NS: i64 = -1
var ST_QUERY_NE: i64 = -1
// Diagnostic side-channel: set by st_private_access_denied when returning true
var PENDING_PRIV_SI: i64 = 0 - 1

// Enum registry: flat array, up to 64 enums
// EN[i*256+0] = name hash
// EN[i*256+1] = variant count
// EN[i*256+2..255] = variant name hashes (up to 254 variants)
var EN: [i64; 65536] = [0; 65536]
var EN_COUNT: i64 = 0
var MATCH_ENDS: [i64; 32] = [0; 32]

// Phase 1.4: Or-pattern arm alternatives (A | B | C => body)
var OR_ALT_DISC:    [i64; 8] = [0; 8]   // discriminant value for each alt (-1 = none)
var OR_ALT_TAGGED:  [i64; 8] = [0; 8]   // 1 if tagged union check (Some/None/Ok/Err)
var OR_ALT_HAS_BIND:[i64; 8] = [0; 8]   // 1 if this alt has an inner value binding
var OR_ALT_BIND_NS: [i64; 8] = [0; 8]   // binding name start in SRC
var OR_ALT_BIND_NE: [i64; 8] = [0; 8]   // binding name end in SRC
var OR_ALT_IS_WILD: [i64; 8] = [0; 8]   // 1 if wildcard _
var OR_BODY_PATCHES:[i64; 8] = [0; 8]   // offset of je/jmp → body for each non-last alt
var OR_BODY_PV:     [i64; 8] = [0; 8]   // 1 if OR_BODY_PATCHES[i] is a valid patch offset
var OR_ALT_COUNT:   i64 = 0
// Tuple-pattern arms: per-element sub-pattern data for `(p0, p1, ...) => body`.
var TPAT_DISC:      [i64; 8] = [0; 8]   // element discriminant (-1 = none/wild/bind)
var TPAT_TAGGED:    [i64; 8] = [0; 8]   // 1 if element is a tagged check (Some/None/Ok/Err/variant)
var TPAT_HAS_BIND:  [i64; 8] = [0; 8]   // 1 if element binds its inner payload
var TPAT_BIND_NS:   [i64; 8] = [0; 8]
var TPAT_BIND_NE:   [i64; 8] = [0; 8]
var TPAT_IS_WILD:   [i64; 8] = [0; 8]   // 1 if element is `_`
var TPAT_SKIP:      [i64; 8] = [0; 8]   // collected jne-skip patch offsets

// Generic function registry (for monomorphization)
var GEN_FN_NS: [i64; 64] = [0; 32]
var GEN_FN_NE: [i64; 64] = [0; 32]
var GEN_FN_TP_S: [i64; 64] = [0; 32]
var GEN_FN_TP_E: [i64; 64] = [0; 32]
var GEN_FN_BDY_S: [i64; 64] = [0; 32]
var GEN_FN_BDY_E: [i64; 64] = [0; 32]
var GEN_FN_COUNT: i64 = 0

// Generic struct registry
var GEN_ST_NS: [i64; 64] = [0; 32]
var GEN_ST_NE: [i64; 64] = [0; 32]
var GEN_ST_TP_S: [i64; 64] = [0; 32]
var GEN_ST_TP_E: [i64; 64] = [0; 32]
var GEN_ST_BDY_S: [i64; 64] = [0; 32]
var GEN_ST_BDY_E: [i64; 64] = [0; 32]
var GEN_ST_COUNT: i64 = 0

// Tuple element type cache: maps tuple hash → element types for .0 / .1 extraction
var TUP_CACHE_KEY: [i64; 16384] = [0; 16384]
var TUP_CACHE_FIRST_TY: [i64; 16384] = [0; 16384]
var TUP_CACHE_FIRST_HASH: [i64; 16384] = [0; 16384]
var TUP_CACHE_LAST_TY: [i64; 16384] = [0; 16384]
var TUP_CACHE_LAST_HASH: [i64; 16384] = [0; 16384]
var TUP_CACHE_COUNT: i64 = 0
// Full per-element type cache for N-ary (N>2) tuples: row idx holds up to 16
// elements at [idx*16 .. idx*16+15]; TUP_CACHE_TCOUNT[idx] is the true element
// count. FIRST/LAST above remain valid (element 0 / element tcount-1) for the
// legacy 2-element decoders; this extension lets N-ary decoders address any
// middle element instead of aliasing it onto the LAST bucket.
var TUP_CACHE_ELEM_TY: [i64; 262144] = [0; 262144]
var TUP_CACHE_ELEM_HASH: [i64; 262144] = [0; 262144]
var TUP_CACHE_TCOUNT: [i64; 16384] = [0; 16384]
// Scratch channel: populate before calling tup_cache_register() to also store
// the full element array (see tup_cache_store_elems). Left at COUNT=0 by
// 2-element-only call sites, which keeps their behavior byte-identical.
var TUP_SCRATCH_ELEM_TY: [i64; 16] = [0; 16]
var TUP_SCRATCH_ELEM_HASH: [i64; 16] = [0; 16]
var TUP_SCRATCH_COUNT: i64 = 0

// Generic function second type-param (for fn f<T, U>)
var GEN_FN_TP2_S: [i64; 64] = [0; 32]
var GEN_FN_TP2_E: [i64; 64] = [0; 32]

// Inference type name ranges in SRC (set by mono_pass for bare-call literal inference)
var INF_I64_S: i64 = 0
var INF_I64_E: i64 = 0
var INF_F64_S: i64 = 0
var INF_F64_E: i64 = 0

// Monomorphization instantiation pairs
var MONO_GEN: [i64; 128] = [0; 64]
var MONO_TY_S: [i64; 128] = [0; 64]
var MONO_TY_E: [i64; 128] = [0; 64]
var MONO_TY2_S: [i64; 128] = [0; 64]   // second type arg (0 if single-param)
var MONO_TY2_E: [i64; 128] = [0; 64]
var MONO_IS_ST: [i64; 128] = [0; 64]
var MONO_COUNT: i64 = 0

// Mangled name buffer (appended to SRC)
var MAN_BUF_S: [i64; 128] = [0; 64]
var MAN_BUF_E: [i64; 128] = [0; 64]

// ─── Phase 5: Effects checking ───
// Bitmask per function: IO=1, Mut=2, Panic=4, Div=8, Alloc=16,
// Custom/Session=32, Observe=64, Audit=128, Hypothesis=256, Epistemic=512,
// Visibility: bit 10 (1024) = is_pub, bit 11 (2048) = from_import
// Gen 19: Deterministic=4096 (bit 12) — function provably cannot call IO
// Gen 20: GPU=8192 (bit 13) — function dispatches work to GPU via CUDA/PTX
var FN_EFFECTS: [i64; 65536] = [0; 65536]
var FN_NAME_TOK: [i64; 65536] = [0; 65536]
var FN_BODY_OPEN: [i64; 65536] = [0; 65536]
var FN_BODY_CLOSE: [i64; 65536] = [0; 65536]
var FN_NEEDS_SESSION: [i64; 65536] = [0; 65536]
var CURRENT_FN: i64 = 0
var CURRENT_BODY_CLOSE: i64 = 0
// When inside an `impl Type { ... }` block, this is set to Type's hash.
// Functions registered while this is non-zero get FN_RECV_HASH set automatically.
var CURRENT_IMPL_RECV_HASH: i64 = 0
// When inside a `study { ... }` block, functions get implicit Hypothesis effect.
var CURRENT_STUDY_EFFECT: i64 = 0
// End of main source file in SRC buffer (positions >= this are from imports)
var MAIN_SRC_END: i64 = 0

// ─── Phase 6a: Unit tracking (compile-time only) ───
// Unit hash per local variable (0 = no unit)
var VAR_UNIT: [i64; 2048] = [0; 2048]

// ─── Phase 6c: Linear type tracking ───
// Per-struct: 1 if declared with 'linear' keyword, 0 otherwise
var ST_LINEAR: [i64; 2048] = [0; 2048]
// Per-struct: 1 if declared with 'affine' keyword, 0 otherwise
var ST_AFFINE: [i64; 2048] = [0; 2048]
// ─── Phase 6d: Algebra property tracking (bit-packed per struct) ───
// Bit 0: is_algebra, Bit 1: add_comm, Bit 2: add_assoc,
// Bit 3: mul_comm, Bit 4: mul_assoc, Bit 5: mul_alt
// Bits 6-7: reassoc mode (0=none, 1=full, 2=fano_selective)
var AL_PROPS: [i64; 200] = [0; 200]
// Per local variable: 1 if linear type, 0 otherwise
var VAR_LINEAR: [i64; 2048] = [0; 2048]
// Per local variable: 1 if affine type, 0 otherwise
var VAR_AFFINE: [i64; 2048] = [0; 2048]
// Per local variable: 1 if value was moved (passed by value to a function)
var VAR_MOVED: [i64; 2048] = [0; 2048]
// Per local variable: count of active borrows (&var taken, for move-while-borrowed check)
var VAR_BORROW_COUNT: [i64; 2048] = [0; 2048]
var VAR_BORROW_EXCL: [i64; 2048] = [0; 2048]   // exclusive borrow active for this var
// Call-site borrow tracking: borrows taken in arg position are ephemeral — released after call
var CALL_ARG_BORROW_VI:   [i64; 32] = [-1; 32]  // var index borrowed in current call's args
var CALL_ARG_BORROW_EXCL: [i64; 32] = [0; 32]   // 1=exclusive, 0=shared
var CALL_ARG_BORROW_N:    i64 = 0               // count of borrows recorded this call
var IN_CALL_ARGS:         i64 = 0               // 1 when compiling a call arg list
// Per local variable: use count (for linear/affine checking)
var VAR_USED: [i64; 2048] = [0; 2048]
// Compile-time literal tracking for refinement predicate checks
var LAST_IS_LITERAL: i64 = 0
var LAST_LITERAL_VAL: i64 = 0
// PR-4: per-variable literal tracking. Packed as VAR_LIT_DATA[idx*2+0]=has_lit,
// [idx*2+1]=lit_val. Lets immutable `let x = -5; takes_pos(x)` propagate the
// known value to the call-site refinement check.
var VAR_LIT_DATA: [i64; 4096] = [0; 4096]
var VAR_TY: [i64; 2048] = [0; 2048]
var VAR_TY_HASH: [i64; 2048] = [0; 2048]
var GL_TY: [i64; 2048] = [0; 2048]
var GL_TY_HASH: [i64; 2048] = [0; 2048]
var FN_RET_TY: [i64; 65536] = [0; 65536]
var FN_RET_HASH: [i64; 65536] = [0; 65536]
var FN_RET_HAS_PRED: [i64; 65536] = [0; 65536]
var FN_RET_PRED_OP: [i64; 65536] = [0; 65536]
var FN_RET_PRED_BOUND: [i64; 65536] = [0; 65536]
var FN_RET_HAS_PRED2: [i64; 65536] = [0; 65536]
var FN_RET_PRED_OP2: [i64; 65536] = [0; 65536]
var FN_RET_PRED_BOUND2: [i64; 65536] = [0; 65536]
// PR-10: f64 predicate metadata for return-type checks
var FN_RET_PRED_IS_F64: [i64; 65536] = [0; 65536]
var FN_RET_PRED_BOUND_FRAC: [i64; 65536] = [0; 65536]
var FN_RET_PRED_BOUND_DENOM: [i64; 65536] = [1; 65536]
var FN_RET_PRED_IS_F64_2: [i64; 65536] = [0; 65536]
var FN_RET_PRED_BOUND2_FRAC: [i64; 65536] = [0; 65536]
var FN_RET_PRED_BOUND2_DENOM: [i64; 65536] = [1; 65536]
// PR-6: token index of the start of each function's return type (right after ->).
// Populated in Pass 1; used in Pass 1c.5 to re-scan with the now-complete alias table.
var FN_RET_TY_TOK: [i64; 65536] = [-1; 65536]
var FN_ARITY: [i64; 65536] = [0; 65536]
var TYPECHECK_FAILED: i64 = 0
var SCAN_TY: i64 = 0
var SCAN_TY_HASH: i64 = 0
var SCAN_TY_ESIZ: i64 = 8
var SCAN_TY_ALEN: i64 = 0
var SCAN_TY_NEXT: i64 = 0
var SCAN_UNIT_EXPR_DIM: i64 = 0
var SCAN_UNIT_EXPR_NEXT: i64 = 0
var RESOLVE_TY: i64 = 0
var RESOLVE_TY_HASH: i64 = 0
var LEX_ERROR_LINE: i64 = 0
var LEX_ERROR_KIND: i64 = 0
var MATCH_SCRUT_TY: i64 = 0
var MATCH_SCRUT_HASH: i64 = 0

// ─── Phase 6b: Refinement type aliases ───
// type Name = { x: T | predicate } — stored as name hash + predicate fields
// PR-2: actually capture the predicate so call/binding sites can apply it.
// Packed layout: REF_TYPE_DATA[i*10 + k] for alias i, field k.
//   k=0 base_ty, 1 base_hash, 2 has_pred, 3 pred_op, 4 pred_bound, 5 pred_is_f64,
//   6 has_pred2, 7 pred_op2, 8 pred_bound2, 9 pred_is_f64_2
var REF_TYPE_HASH: [i64; 32] = [0; 32]
var REF_TYPE_COUNT: i64 = 0
var REF_TYPE_DATA: [i64; 320] = [0; 320]

// ─── Phase 6c: Refinement predicate runtime assertions ───
// Set by scan_type when a refinement type { x: T | pred } is scanned.
// Caller emits runtime check (integer bound comparison + ud2 trap).
var SCAN_HAS_PRED: i64 = 0      // 1 if predicate was successfully parsed
var SCAN_PRED_OP: i64 = 0       // comparison TK: 26=>=, 24=>, 25=<=, 23=<, 21===, 22=!=
var SCAN_PRED_BOUND: i64 = 0    // literal bound value (i64 bits; for f64, IEEE 754)
var SCAN_PRED_IS_F64: i64 = 0   // 1 if float predicate
var SCAN_HAS_PRED2: i64 = 0     // 1 if second compound predicate was parsed
var SCAN_PRED_OP2: i64 = 0      // second predicate operator
var SCAN_PRED_BOUND2: i64 = 0   // second predicate bound
var SCAN_PRED_IS_F64_2: i64 = 0 // 1 if second predicate is float
// PR-6: compound predicate conjunction. 0 = OR (existing ||), 1 = AND (&&).
// For AND: violation if EITHER predicate fails independently.
// For OR:  violation only if BOTH predicates fail.
var SCAN_PRED_COMPOUND_IS_AND: i64 = 0
// PR-6: per-alias AND/OR flag (parallel to REF_TYPE_DATA).
var REF_TYPE_IS_AND: [i64; 32] = [0; 32]
// PR-6: per-function return-type AND/OR flag.
var FN_RET_PRED_COMPOUND_IS_AND: [i64; 65536] = [0; 65536]
// PR-7: f64 literal tracking — set when compile_primary emits a float literal.
var LAST_IS_LITERAL_F64: i64 = 0
var LAST_LITERAL_F64_INT: i64 = 0
var LAST_LITERAL_F64_FRAC: i64 = 0
var LAST_LITERAL_F64_DENOM: i64 = 1
// PR-7: fractional parts of f64 predicate bounds (first and second predicate).
var SCAN_PRED_BOUND_FRAC: i64 = 0
var SCAN_PRED_BOUND_DENOM: i64 = 1
var SCAN_PRED_BOUND2_FRAC: i64 = 0
var SCAN_PRED_BOUND2_DENOM: i64 = 1

// ─── Phase 6d: Unit dimension checking ───
// Tracks unit hash of the last compiled expression sub-result.
// Set when a unit-typed variable is loaded; checked at + and - operators.
var EXPR_UNIT: i64 = 0

// Gen 19: Unit dimension system
// Packed dim vector: bits[3:0]=mass, [7:4]=length, [11:8]=time, [15:12]=temp,
//   [19:16]=amount, [23:20]=current, [27:24]=luminosity (4-bit 2's-complement each)
// UNIT_HASH_TABLE[slot] = full hash (0=empty), UNIT_DIM_TABLE[slot] = packed dim
var UNIT_HASH_TABLE: [i64; 2048] = [0; 2048]
var UNIT_DIM_TABLE:  [i64; 2048] = [0; 2048]
// Parallel token unit-hash array (for _suffix literals e.g. 500_mg)
var TU: [i64; 2097152] = [0; 2097152]
// Packed dimension vector of the current compiled expression (0 = dimensionless/unknown)
var EXPR_UNIT_DIM: i64 = 0

// ─── Phase 7: Epistemic Type System (Knowledge<Type>) ───
// Every type carries Confidence (0–1000) and GUM Uncertainty (0–1000).
// Fixed-point integer arithmetic only — no f64 (bootstrap determinism).
// Type kinds: 0=unknown, 1=i64, 2=f64, 3=bool, 4=string, 5=void,
//             10=fn, 11=array, 13=struct, 14=enum, 100=type_var
var ETY_KIND:     [i64; 65536] = [0; 65536]
var ETY_CONF:     [i64; 65536] = [0; 65536]
var ETY_UNC:      [i64; 65536] = [0; 65536]
var ETY_HASH:     [i64; 65536] = [0; 65536]
var ETY_UNIT_DIM: [i64; 65536] = [0; 65536]  // packed 7-field dim vector for kind=7 Knowledge<T>
var ETY_COUNT: i64 = 0
// Count of Knowledge<T> ETY entries with non-zero unit dimension (dimensional epistemic sites)
var KNOWLEDGE_UNITS_COUNT: i64 = 0
// Per-expression epistemic state (indexed by token position)
var EXPR_ETY:  [i64; 2097152] = [0; 2097152]
var EXPR_CONF: [i64; 2097152] = [0; 2097152]
var EXPR_GATE: [i64; 2097152] = [0; 2097152]
// Gen 17 D1: Belief/plausibility interval (Knightian uncertainty)
// EXPR_BELIEF = lower confidence bound, EXPR_PLAUS = upper bound
// Gap = EXPR_PLAUS - EXPR_BELIEF = known-unknown component (Dempster-Shafer)
var EXPR_BELIEF: [i64; 2097152] = [0; 2097152]
var EXPR_PLAUS:  [i64; 2097152] = [0; 2097152]
// Confidence gate threshold: 950 = 95.0% required for direct code emission
var GATE_THRESHOLD: i64 = 950
// Epistemic scope stack (variable name hash → type ID + confidence)
var ESCOPE_HASH: [i64; 2048] = [0; 2048]
var ESCOPE_TY:   [i64; 2048] = [0; 2048]
var ESCOPE_CONF: [i64; 2048] = [0; 2048]
var ESCOPE_DEPTH:[i64; 2048] = [0; 2048]
var ESCOPE_COUNT: i64 = 0
var ESCOPE_LEVEL: i64 = 0
// Effect confidence (per function)
var FN_DECL_EFF:  [i64; 65536] = [0; 65536]
var FN_USED_EFF:  [i64; 65536] = [0; 65536]
var FN_EFF_CONF:  [i64; 65536] = [0; 65536]
// Epistemic stats (for bootstrap convergence tracking)
var EPIST_TOTAL_EXPR: i64 = 0
var EPIST_HIGH_CONF:  i64 = 0
var EPIST_LOW_CONF:   i64 = 0
var EPIST_GATES_DIRECT: i64 = 0
var EPIST_GATES_GUARDED: i64 = 0
// Gen 12: per-file epistemic stats (main source vs imported)
var EPIST_MAIN_TOTAL: i64 = 0
var EPIST_MAIN_HIGH:  i64 = 0
// Gen 12: Knowledge<T> (Epistemic) type-site counter
var EPIST_KTYPE_SITES: i64 = 0
var EPIST_KTYPE_CERTAIN: i64 = 0
// Gen 12: --dump-conf-json flag
var CLI_DUMP_CONF_JSON: i64 = 0
// Gen 13: dual-channel measurement confidence (parallel to EXPR_CONF)
// MEAS_CONF[p] = GUM measurement quality of token p:
//   0    = not in measurement channel (bare types, constants, compiler-internal)
//   990  = instrument measurement ("measured" constructor)
//   970  = user assertion ("asserted" constructor)
//   1000 = physical constant ("constant" constructor)
//   propagates through arithmetic: min(left, right) via Sweep 2
var MEAS_CONF: [i64; 2097152] = [0; 2097152]
// Gen 13: ESCOPE measurement quality (parallel to ESCOPE_CONF)
var ESCOPE_MEAS: [i64; 65536] = [0; 65536]
// Gen 13: count of tokens with MEAS_CONF > 0 after all passes
var EPIST_MEAS_COUNT: i64 = 0
// Gen 14 (Track C): confidence tier distribution counters
// PLATINUM = conf == 1000 (maximally certain, no uncertainty anywhere in chain)
// GOLD     = conf >= 950  (above gate threshold, type-safe with minor heritage)
// SILVER   = conf >= 800  (below gate, compiler-uncertain, guarded at runtime)
// BRONZE   = conf >= 500  (low confidence, likely unresolved idents/imports)
var EPIST_TIER_PLATINUM: i64 = 0
var EPIST_TIER_GOLD:     i64 = 0
var EPIST_TIER_SILVER:   i64 = 0
var EPIST_TIER_BRONZE:   i64 = 0
// Gen 17 D1: Knightian uncertainty diagnostics
var EPIST_KNIGHTIAN_SITES: i64 = 0   // sites where belief < plaus
var EPIST_KNIGHTIAN_GAP:   i64 = 0   // sum of (plaus - belief) gaps
// Gen 17 D3: Knowledge<T> subtype tracking
var EPIST_KNOW_SUBTYPE_SITES: i64 = 0      // assignments where src has kind=7
var EPIST_KNOW_SUBTYPE_VIOLATIONS: i64 = 0  // where src conf < dst conf
// Gen 16 Track B: EpistemicComplete effect enforcement
var EPIST_EFFECT_VIOLATIONS: i64 = 0
// Gen 17 D2: Parameterized EpistemicComplete — per-function minimum confidence
var FN_EPISTEMIC_MIN: [i64; 65536] = [0; 65536]  // 0 = unset (use GATE_THRESHOLD)
// Gen 15 (Option B): epistemic certificate (.econf) support
// Gen 17 D6: --emit-proof-obligations — Lean 4 proof goals for PLATINUM bindings
var CLI_EMIT_PROOFS: i64 = 0
var PROOF_BUF: [i8; 65536] = [0; 65536]    // Lean 4 goal buffer
var PROOF_BUF_LEN: i64 = 0
// ─── β⁴ Variance + Sensitivity Shadow Buffers ───
// VAR_VSHADOW[vi]: stack slot holding GUM variance for variable vi (-1 = not tracked)
// VAR_SSHADOW[vi]: stack slot holding forward-mode sensitivity ∂y/∂x₀ for vi (-1 = not tracked)
// EXPR_VSHADOW / EXPR_SSHADOW: shadow slot for the most recently compiled expression
var VAR_VSHADOW:   [i64; 2048] = [-1; 2048]
var VAR_SSHADOW:   [i64; 2048] = [-1; 2048]
var EXPR_VSHADOW:  i64 = -1
var EXPR_SSHADOW:  i64 = -1
// MEAS_SENS_SLOT[k]: sensitivity seed slot for the k-th measure() call in current scope
// MEAS_CALL_IDX: running count of measure() calls in current function (resets per function)
// MEAS_KNOW_IDX: running count of .value extractions on Knowledge<T> (resets per function)
var MEAS_SENS_SLOT: [i64; 32]  = [-1; 32]
var MEAS_CALL_IDX:  i64 = 0
var MEAS_KNOW_IDX:  i64 = 0
// β⁵ covariance: per-function cache mapping Knowledge<T> variable index → (vseed, sseed) slots
// Reusing the same slots for repeated .value accesses on the same variable enables slot-identity
// detection in subtraction: left_vshadow == right_vshadow → Var(x−x) = 0.
var KM_CACHE_VI:    [i64; 32] = [-1; 32]
var KM_CACHE_VS:    [i64; 32] = [-1; 32]
var KM_CACHE_SS:    [i64; 32] = [-1; 32]
var KM_CACHE_SS_1:  [i64; 32] = [-1; 32]
var KM_CACHE_SS_2:  [i64; 32] = [-1; 32]
var KM_CACHE_SS_3:  [i64; 32] = [-1; 32]
var KM_CACHE_SS4:  [i64; 32] = [-1; 32]
var KM_CACHE_SS_5:  [i64; 32] = [-1; 32]
var KM_CACHE_SS_6:  [i64; 32] = [-1; 32]
var KM_CACHE_SS_7:  [i64; 32] = [-1; 32]
var KM_CACHE_COUNT: i64 = 0
// β¹⁰: per-channel input variance slots (σ² of the k-th Knowledge .value seed).
// Enables FO GUM reconstruction: Var(y) = Σ_k (∂y/∂x_k)² · σ²_k, including
// correlated cancellation on subtract: Var(L−R) = Σ_k (sL_k − sR_k)² · σ²_k.
var CHANNEL_INPUT_VAR_SLOT: [i64; 8] = [-1; 8]
// β⁶ multi-channel sensitivity: shadow buffers for channels 1-3 (∂y/∂xₖ)
var EXPR_SSHADOW_1:  i64 = -1
var VAR_SSHADOW_1:   [i64; 2048] = [-1; 2048]
var EXPR_SSHADOW_2:  i64 = -1
var VAR_SSHADOW_2:   [i64; 2048] = [-1; 2048]
var EXPR_SSHADOW_3:  i64 = -1
var VAR_SSHADOW_3:   [i64; 2048] = [-1; 2048]
var EXPR_SSHADOW_4:  i64 = -1
var VAR_SSHADOW_4:   [i64; 2048] = [-1; 2048]
var EXPR_SSHADOW_5:  i64 = -1
var VAR_SSHADOW_5:   [i64; 2048] = [-1; 2048]
var EXPR_SSHADOW_6:  i64 = -1
var VAR_SSHADOW_6:   [i64; 2048] = [-1; 2048]
var EXPR_SSHADOW_7:  i64 = -1
var VAR_SSHADOW_7:   [i64; 2048] = [-1; 2048]
// β⁷ second-order (Hessian) shadow channels: H[j,k] = ∂²y/∂xⱼ∂xₖ, j≤k, 10 upper-triangle entries
var EXPR_HSHADOW_00: i64 = -1; var VAR_HSHADOW_00: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_01: i64 = -1; var VAR_HSHADOW_01: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_02: i64 = -1; var VAR_HSHADOW_02: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_03: i64 = -1; var VAR_HSHADOW_03: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_11: i64 = -1; var VAR_HSHADOW_11: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_12: i64 = -1; var VAR_HSHADOW_12: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_13: i64 = -1; var VAR_HSHADOW_13: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_22: i64 = -1; var VAR_HSHADOW_22: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_23: i64 = -1; var VAR_HSHADOW_23: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_33: i64 = -1; var VAR_HSHADOW_33: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_04: i64 = -1; var VAR_HSHADOW_04: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_05: i64 = -1; var VAR_HSHADOW_05: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_06: i64 = -1; var VAR_HSHADOW_06: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_07: i64 = -1; var VAR_HSHADOW_07: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_14: i64 = -1; var VAR_HSHADOW_14: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_15: i64 = -1; var VAR_HSHADOW_15: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_16: i64 = -1; var VAR_HSHADOW_16: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_17: i64 = -1; var VAR_HSHADOW_17: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_24: i64 = -1; var VAR_HSHADOW_24: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_25: i64 = -1; var VAR_HSHADOW_25: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_26: i64 = -1; var VAR_HSHADOW_26: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_27: i64 = -1; var VAR_HSHADOW_27: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_34: i64 = -1; var VAR_HSHADOW_34: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_35: i64 = -1; var VAR_HSHADOW_35: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_36: i64 = -1; var VAR_HSHADOW_36: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_37: i64 = -1; var VAR_HSHADOW_37: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_44: i64 = -1; var VAR_HSHADOW_44: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_45: i64 = -1; var VAR_HSHADOW_45: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_46: i64 = -1; var VAR_HSHADOW_46: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_47: i64 = -1; var VAR_HSHADOW_47: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_55: i64 = -1; var VAR_HSHADOW_55: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_56: i64 = -1; var VAR_HSHADOW_56: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_57: i64 = -1; var VAR_HSHADOW_57: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_66: i64 = -1; var VAR_HSHADOW_66: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_67: i64 = -1; var VAR_HSHADOW_67: [i64; 2048] = [-1; 2048]
var EXPR_HSHADOW_77: i64 = -1; var VAR_HSHADOW_77: [i64; 2048] = [-1; 2048]

// ════════════════════════════════════════════════════════════════════
// Gradient Topology Types (GTT) — Phase β⁹
// ────────────────────────────────────────────────────────────────────
// A value's *topology* is the set of Hessian-input channels it depends on.
// Channels are assigned at .value extraction time (per MEAS_KNOW_IDX).
// Topology is tracked as an i64 bitmask: bit k set ⇔ channel k is in the set.
//
// Operations:
//   .value access    → EXPR_CH_SET = 1 << (MEAS_KNOW_IDX - 1)  (just-seeded channel)
//   a + b, a * b,... → EXPR_CH_SET = left_ch_set | right_ch_set  (union)
//   let x = e        → VAR_CH_SET[x] = EXPR_CH_SET
//   load x           → EXPR_CH_SET = VAR_CH_SET[x]
//   hessian_of(e,j,k)→ require bits j, k in EXPR_CH_SET; else tc_error
//
// This is the GTT MVP: type-level refusal of hessian_of queries that ask
// for Hessian entries outside the expression's channel topology.
var EXPR_CH_SET: i64 = 0
var VAR_CH_SET:  [i64; 2048] = [0; 2048]

// β⁵ Inter-procedural variance: at call sites, accumulate argument variances
// into the return EXPR_VSHADOW (conservative GUM: var_return ≈ Σ var(argᵢ))
var B5_VSHADOW: [i64; 16] = [-1; 16]
var B5_ARG_VCOUNT:  i64 = 0

// β⁹ GTT inter-procedural topology: at user-fn call sites, union argument
// channel sets into the return value's EXPR_CH_SET. Conservative upper
// bound — the return is assumed to depend on every argument. Body-level
// analysis (e.g. fn first(a,b) = a ⇒ {arg0} only) deferred to week-4+.
// Mirrors B5_VSHADOW's placement and scope: fi >= 0 branch only;
// closure / fn-ref indirect calls continue to leak the last arg's
// topology (pre-existing limitation, matches B5's scope).
// β⁹ GTT week-8 — call sites with argc ≥ 16 overflow this 16-slot
// table; the post-call union loop saturates EXPR_CH_SET to all-bits-set
// in that regime so the caller cannot under-approximate topology.
var B9_ARG_CH_SET:   [i64; 16] = [0; 16]
var B9_ARG_CH_COUNT: i64 = 0

// β⁹ GTT week-4 — body-level precision via parameter-index tracking.
// EXPR_PARAM_USED: bitmask of enclosing-function parameter indices that the
// current expression depends on.  Paired with EXPR_CH_SET at every update
// site and propagated through let/load via VAR_PARAM_USED (mirrors
// VAR_CH_SET exactly).  FN_USED_PARAMS[fi] is the per-function summary:
// bit 62 (FN_USED_ANALYZED = 1 << 62 = 4611686018427387904) marks the
// function as analyzed; low 16 bits = parameter indices referenced at
// the return-position tail.  Sentinel 0 = unanalyzed → caller falls back
// to the week-3 conservative union over all B9_ARG_CH_SET slots.
// B9_ARG_PARAM_USED captures each argument's EXPR_PARAM_USED so the
// caller can forward body-precision into its own enclosing-function's
// EXPR_PARAM_USED at the call-site return.
var EXPR_PARAM_USED:    i64 = 0
var VAR_PARAM_USED:     [i64; 2048] = [0; 2048]
var FN_USED_PARAMS:     [i64; 65536] = [0; 65536]
var B9_ARG_PARAM_USED:  [i64; 16] = [0; 16]

// β⁹ GTT loop fixed-point: snapshot VAR_CH_SET/VAR_PARAM_USED before each loop body,
// union at exit to preserve pre-loop topology (handles 0-iteration case soundly).
var GTT_LOOP_DEPTH:       i64 = 0
var LOOP_SNAP_CH_SET:     [i64; 8192] = [0; 8192]
var LOOP_SNAP_PARAM_USED: [i64; 8192] = [0; 8192]

// --emit-econf: print function confidence table to diagnostic stream
// --load-econf: pre-populate FN_EFF_CONF from a previously emitted .econf
var CLI_EMIT_ECONF: i64 = 0
var CLI_LOAD_ECONF: i64 = 0
// Raw bytes of a loaded .econf file (parsed in Phase A2)
var ECONF_RAW: [i64; 65536] = [0; 65536]
var ECONF_RAW_LEN: i64 = 0
// Count of FN_EFF_CONF overrides applied from a loaded .econf
var ECONF_APPLIED: i64 = 0

fn gtt_loop_snapshot() with Mut {
    let base = GTT_LOOP_DEPTH * 1024
    var i: i64 = 0
    while i < 1024 {
        LOOP_SNAP_CH_SET[(base + i) as usize] = VAR_CH_SET[i as usize]
        LOOP_SNAP_PARAM_USED[(base + i) as usize] = VAR_PARAM_USED[i as usize]
        i = i + 1
    }
    GTT_LOOP_DEPTH = GTT_LOOP_DEPTH + 1
}

fn gtt_loop_union() with Mut {
    GTT_LOOP_DEPTH = GTT_LOOP_DEPTH - 1
    let base = GTT_LOOP_DEPTH * 1024
    var i: i64 = 0
    while i < 1024 {
        VAR_CH_SET[i as usize] = VAR_CH_SET[i as usize] | LOOP_SNAP_CH_SET[(base + i) as usize]
        VAR_PARAM_USED[i as usize] = VAR_PARAM_USED[i as usize] | LOOP_SNAP_PARAM_USED[(base + i) as usize]
        i = i + 1
    }
}

fn en_find(hash: i64) -> i64 with Panic, Mut {
    var i: i64 = 0
    while i < EN_COUNT {
        if EN[(i * 256) as usize] == hash { return i }
        i = i + 1
    }
    return -1
}

// Look up EnumName::Variant → discriminant value
fn en_variant_value(enum_hash: i64, variant_hash: i64) -> i64 with Panic, Mut {
    let ei = en_find(enum_hash)
    if ei < 0 { return -1 }
    let base = ei * 256
    let vc = EN[(base + 1) as usize]
    var vi: i64 = 0
    while vi < vc {
        if EN[(base + 2 + vi) as usize] == variant_hash { return vi }
        vi = vi + 1
    }
    return -1
}

fn en_variant_count(enum_hash: i64) -> i64 with Panic, Mut {
    let ei = en_find(enum_hash)
    if ei < 0 { return 0 }
    return EN[(ei * 256 + 1) as usize]
}

fn st_find(hash: i64) -> i64 with Panic, Mut {
    var i: i64 = 0
    while i < ST_COUNT {
        if ST[(i * 130) as usize] == hash { return i }
        i = i + 1
    }
    return -1
}

fn src_file_marker_start(pos: i64) -> i64 with Panic, Mut {
    var start: i64 = 0
    var i: i64 = 0
    while i < pos && i < SRC_LEN {
        if SRC[i as usize] as i64 == 1 { start = i }
        i = i + 1
    }
    return start
}

fn src_same_file_pos(a: i64, b: i64) -> bool with Panic, Mut {
    if a < 0 || b < 0 { return true }
    return src_file_marker_start(a) == src_file_marker_start(b)
}

fn st_private_access_denied(si: i64, access_tok: i64) -> bool with IO, Mut, Panic {
    if si < 0 { return false }
    if ST_PUBLIC[si as usize] != 0 { return false }
    if ST_DECL_NE[si as usize] <= ST_DECL_NS[si as usize] { return false }
    if access_tok < 0 || access_tok >= TC { return false }
    if src_same_file_pos(TS[access_tok as usize], ST_DECL_NS[si as usize]) { return false }
    PENDING_PRIV_SI = si
    return true
}

fn tup_cache_store_elems(idx: i64) with Panic, Mut {
    var k: i64 = 0
    while k < TUP_SCRATCH_COUNT && k < 16 {
        TUP_CACHE_ELEM_TY[(idx * 16 + k) as usize] = TUP_SCRATCH_ELEM_TY[k as usize]
        TUP_CACHE_ELEM_HASH[(idx * 16 + k) as usize] = TUP_SCRATCH_ELEM_HASH[k as usize]
        k = k + 1
    }
    TUP_CACHE_TCOUNT[idx as usize] = TUP_SCRATCH_COUNT
}

fn tup_cache_register(tup_hash: i64, first_ty: i64, first_hash: i64, last_ty: i64, last_hash: i64) with Panic, Mut {
    if tup_hash == 0 { TUP_SCRATCH_COUNT = 0; return }
    var i: i64 = 0
    while i < TUP_CACHE_COUNT {
        if TUP_CACHE_KEY[i as usize] == tup_hash {
            // Backfill full per-element data if this call has it and the existing
            // entry doesn't yet (construction and type-annotation scans can each
            // register the same shape; whichever comes with elements wins).
            if TUP_SCRATCH_COUNT > TUP_CACHE_TCOUNT[i as usize] { tup_cache_store_elems(i) }
            TUP_SCRATCH_COUNT = 0
            return
        }
        i = i + 1
    }
    if TUP_CACHE_COUNT >= 16384 { TUP_SCRATCH_COUNT = 0; return }
    let idx = TUP_CACHE_COUNT
    TUP_CACHE_KEY[idx as usize] = tup_hash
    TUP_CACHE_FIRST_TY[idx as usize] = first_ty
    TUP_CACHE_FIRST_HASH[idx as usize] = first_hash
    TUP_CACHE_LAST_TY[idx as usize] = last_ty
    TUP_CACHE_LAST_HASH[idx as usize] = last_hash
    if TUP_SCRATCH_COUNT > 0 { tup_cache_store_elems(idx) } else { TUP_CACHE_TCOUNT[idx as usize] = 2 }
    TUP_SCRATCH_COUNT = 0
    TUP_CACHE_COUNT = TUP_CACHE_COUNT + 1
}

fn tup_cache_lookup(tup_hash: i64) -> i64 with Panic, Mut {
    var i: i64 = 0
    while i < TUP_CACHE_COUNT {
        if TUP_CACHE_KEY[i as usize] == tup_hash { return i }
        i = i + 1
    }
    return -1
}

fn ty_slot_count(ty: i64, ty_hash: i64) -> i64 with Panic, Div, Mut {
    if ty == 8 { return arr_storage_slots(ty_hash) }
    if ty == 6 {
        // Size-hint sentinel: 1000000007 + nslots, set after .0 tuple field access
        if ty_hash >= 1000000007 && ty_hash < 1000001007 { return ty_hash - 1000000007 }
        let si = st_find(ty_hash)
        if si >= 0 { return st_total_size(si) / 8 }
    }
    if ty == 0 && ty_hash != 0 {
        let fwd_si = st_find(ty_hash)
        if fwd_si >= 0 { return st_total_size(fwd_si) / 8 }
    }
    if type_is_option_inline(ty, ty_hash) { return 2 }
    if ty == 11 { return 1 }
    if knowledge_hash_is(ty_hash) { return 3 }
    return 1
}

// Recover a tuple's true total slot count from the element-type cache. The
// synthetic tuple hash packs first_nslots*1000 + total_nslots in 3-digit fields,
// which OVERFLOWS for any element >= 1000 slots (e.g. (Checker, TypeEntry):
// first=20991, total=21025 -> %1000 = 25, truncating a 167 KB by-value tuple
// RETURN to 200 bytes and leaving env.count uninitialised -> SIGSEGV). The cache
// (registered at every tuple encode site) stores the element types; ty_slot_count
// gives the true size. Falls back to the packed decode for uncached/small tuples.
// Mirrors the override already done in tuple_destructure_from_ptr_x86. Used for
// the return-copy size (ret_agg_nslots) AND the tuple `.0` field-access copy size.
// SIZE recovery is collision-SAFE: the first element is collision-invariant and
// its slot count dwarfs the modulo. We deliberately do NOT recover element TYPES
// from the cache in the .0/.1 path: the overflowed hash is not a unique key, so
// two distinct >=1000-slot tuples (e.g. (Checker,i64) vs (Checker,bool)) can
// collide and yield the wrong element type — which mis-types `.1` and breaks
// type-checking. So `.1` routing/typing is left exactly on the legacy packed path.
// Sum every element's slot count from the N-ary cache row (element 0..tcount-1).
// Only meaningful when TUP_CACHE_TCOUNT[tci] > 0 (a full row was registered).
fn tup_elem_slots_sum(tci: i64) -> i64 with Panic, Div, Mut {
    var total: i64 = 0
    var k: i64 = 0
    let n = TUP_CACHE_TCOUNT[tci as usize]
    while k < n && k < 16 {
        total = total + ty_slot_count(TUP_CACHE_ELEM_TY[(tci * 16 + k) as usize], TUP_CACHE_ELEM_HASH[(tci * 16 + k) as usize])
        k = k + 1
    }
    return total
}

fn tup_total_slots_true(tup_hash: i64) -> i64 with Panic, Div, Mut {
    let tci = tup_cache_lookup(tup_hash)
    if tci >= 0 {
        if TUP_CACHE_TCOUNT[tci as usize] > 2 {
            let es = tup_elem_slots_sum(tci)
            if es > 0 { return es }
        }
        let fs = ty_slot_count(TUP_CACHE_FIRST_TY[tci as usize], TUP_CACHE_FIRST_HASH[tci as usize])
        let ls = ty_slot_count(TUP_CACHE_LAST_TY[tci as usize], TUP_CACHE_LAST_HASH[tci as usize])
        if fs > 0 && ls > 0 { return fs + ls }
    }
    return tup_hash % 1000
}

// True slot count of a tuple's FIRST element (collision-safe: first element is
// invariant across hash collisions). Used to size the `.0` field-access copy,
// which the packed 3-digit decode truncates for first elements >= 1000 slots.
fn tup_first_slots_true(tup_hash: i64) -> i64 with Panic, Div, Mut {
    let tci = tup_cache_lookup(tup_hash)
    if tci >= 0 {
        let fs = ty_slot_count(TUP_CACHE_FIRST_TY[tci as usize], TUP_CACHE_FIRST_HASH[tci as usize])
        if fs > 0 { return fs }
    }
    return (tup_hash % 1000000) / 1000
}

fn st_field_slots_idx(si: i64, fi: i64) -> i64 with Panic, Div, Mut {
    return ty_slot_count(ST_FTY[(si * 128 + fi) as usize], ST_FHASH[(si * 128 + fi) as usize])
}

fn st_field_offset(si: i64, field_hash: i64) -> i64 with Panic, Div, Mut {
    let base = si * 130
    let fc = ST[(base + 1) as usize]
    var fi: i64 = 0
    var off: i64 = 0
    while fi < fc {
        if ST[(base + 2 + fi) as usize] == field_hash {
            if ST_QUERY_NS >= 0 {
                let fns = ST_FNS[(si * 128 + fi) as usize]
                let fne = ST_FNE[(si * 128 + fi) as usize]
                if src_region_eq(ST_QUERY_NS, ST_QUERY_NE - ST_QUERY_NS, fns, fne - fns) {
                    return off * 8
                }
            } else {
                return off * 8
            }
        }
        off = off + st_field_slots_idx(si, fi)
        fi = fi + 1
    }
    return -1
}

fn st_field_ty(si: i64, field_hash: i64) -> i64 with Panic, Mut {
    let base = si * 130
    let fc = ST[(base + 1) as usize]
    var fi: i64 = 0
    while fi < fc {
        if ST[(base + 2 + fi) as usize] == field_hash {
            if ST_QUERY_NS >= 0 {
                let fns = ST_FNS[(si * 128 + fi) as usize]
                let fne = ST_FNE[(si * 128 + fi) as usize]
                if src_region_eq(ST_QUERY_NS, ST_QUERY_NE - ST_QUERY_NS, fns, fne - fns) {
                    return ST_FTY[(si * 128 + fi) as usize]
                }
            } else {
                return ST_FTY[(si * 128 + fi) as usize]
            }
        }
        fi = fi + 1
    }
    return 0
}

fn st_field_hash(si: i64, field_hash: i64) -> i64 with Panic, Mut {
    let base = si * 130
    let fc = ST[(base + 1) as usize]
    var fi: i64 = 0
    while fi < fc {
        if ST[(base + 2 + fi) as usize] == field_hash {
            if ST_QUERY_NS >= 0 {
                let fns = ST_FNS[(si * 128 + fi) as usize]
                let fne = ST_FNE[(si * 128 + fi) as usize]
                if src_region_eq(ST_QUERY_NS, ST_QUERY_NE - ST_QUERY_NS, fns, fne - fns) {
                    return ST_FHASH[(si * 128 + fi) as usize]
                }
            } else {
                return ST_FHASH[(si * 128 + fi) as usize]
            }
        }
        fi = fi + 1
    }
    return 0
}

fn st_total_size(si: i64) -> i64 with Panic, Div, Mut {
    let fc = ST[(si * 130 + 1) as usize]
    var fi: i64 = 0
    var nslots: i64 = 0
    while fi < fc {
        nslots = nslots + st_field_slots_idx(si, fi)
        fi = fi + 1
    }
    return nslots * 8
}

// Global variable table: flat array, 4 fields per entry [hash, offset, esiz, alen]
var GL: [i64; 4096] = [0; 4096]
var GL_COUNT: i64 = 0
var GL_BSS_SIZE: i64 = 0

// Side-table for arr_ty_hash_with_elem: avoids overflow in the linear encoding
// for large FNV-1a struct hashes (masked to 0x1FFFFFFFFF ≈ 137B).
var EXT_ARR_ALEN:      [i64; 4096] = [0; 4096]
var EXT_ARR_ESIZ:      [i64; 4096] = [0; 4096]
var EXT_ARR_ELEM_TY:   [i64; 4096] = [0; 4096]
var EXT_ARR_ELEM_HASH: [i64; 4096] = [0; 4096]
var EXT_ARR_COUNT: i64 = 0
// Seq<T> element-type intern table. seq_hash interns (inner_ty, inner_hash) to a
// small bounded id so the type hash stays in [SEQ_HASH_BASE, +256): positive and
// well below the unobserved base (2^51), so knowledge_hash_is / unobserved_hash_is
// both return false for a Seq hash. Dispatch is by TAG (TY_SEQ=12), not by hash
// range, so numeric collision with a struct hash is harmless.
var SEQ_INNER_TY:   [i64; 256] = [0; 256]
var SEQ_INNER_HASH: [i64; 256] = [0; 256]
var SEQ_COUNT: i64 = 0
var GL_BSS_BASE: i64 = 0
var RET_AGG_BSS_OFF: i64 = 0
var LIMIT_ERROR_KIND: i64 = 0
var LAST_LOCAL_BSS_SPILL: i64 = 0
var LAST_LOCAL_BSS_ADDR: i64 = 0
var GPU_EMU_THREAD_ID_BSS_OFF: i64 = 0
var GPU_RT_STATE_BSS_OFF: i64 = 0
var GPU_RT_DIAG_BSS_OFF: i64 = 0
var GPU_RT_LIBCUDA_HANDLE_BSS_OFF: i64 = 0
var GPU_RT_DEVICE_BSS_OFF: i64 = 0
var GPU_RT_CTX_BSS_OFF: i64 = 0
var GPU_RT_CUINIT_PTR_BSS_OFF: i64 = 0
var GPU_RT_CUDEVICEGET_PTR_BSS_OFF: i64 = 0
var GPU_RT_CUCTXCREATE_PTR_BSS_OFF: i64 = 0
var GPU_RT_CUCTXSYNC_PTR_BSS_OFF: i64 = 0
var GPU_RT_CUMODULELOADDATA_PTR_BSS_OFF: i64 = 0
var GPU_RT_CUMODULEGETFUNCTION_PTR_BSS_OFF: i64 = 0
var GPU_RT_CUMEMALLOC_PTR_BSS_OFF: i64 = 0
var GPU_RT_CUMEMFREE_PTR_BSS_OFF: i64 = 0
var GPU_RT_CUMEMCPYHTOD_PTR_BSS_OFF: i64 = 0
var GPU_RT_CUMEMCPYDTOH_PTR_BSS_OFF: i64 = 0
var GPU_RT_CULAUNCHKERNEL_PTR_BSS_OFF: i64 = 0
// β⁵ inter-procedural variance: global slot holding the return variance value
// of the most recent f64-returning function call. Callee writes before ret;
// caller reads after call.
var B5_RET_VSHADOW_BSS_OFF: i64 = 0
// β⁵ inter-procedural variance: per-argument global array (16 slots × 8 bytes).
// Caller stores argument variance values here before a direct call;
// callee prologue reads them into parameter VAR_VSHADOW slots.
var B5_ARG_VSHADOW_BSS_OFF: i64 = 0

// Box::new bump-arena state (emitted-binary runtime). Replaces the per-Box mmap(4096)
// allocator (no-free, page-rounded -> 42GB RSS during self-host bodies lowering, job 2478).
// Three i64 globals: arena chunk base, bump cursor (next free addr), and current chunk limit.
// emit_arena_alloc_x86 bumps cursor; on overflow it re-reserves a fresh chunk (no free, like
// Box semantics; RSS == total packed allocations regardless of chunk count).
var AST_ARENA_BASE_BSS_OFF: i64 = 0
var AST_ARENA_CURSOR_BSS_OFF: i64 = 0
var AST_ARENA_LIMIT_BSS_OFF: i64 = 0

// Aggregate-storage bump pool: packs the never-freed aggregate backing blocks
// (struct-array element copies, array-literal blocks, Seq element
// materializations, closure envs) that previously went through
// emit_heap_alloc_x86 — one page-granular mmap EACH, so a ~250-byte struct
// temp cost 4 KiB of VmSize forever (measured: +11.5 GiB during native
// codegen of a 369-fn merged module, ~0.5 GiB per lowered module). The pool
// bump-packs them 8-aligned instead. Semantics are unchanged: blocks are
// never freed (same as the leaked mmaps), never reallocated, and the pool is
// deliberately SEPARATE from the Box arena so __arena_reset can never touch
// aggregate storage that outlives a reset window (e.g. merged-module element
// blocks aliased by struct assignment). heap_free/heap_realloc/seq_new keep
// the header'd mmap path.
var AGG_POOL_BASE_BSS_OFF: i64 = 0
var AGG_POOL_CURSOR_BSS_OFF: i64 = 0
var AGG_POOL_LIMIT_BSS_OFF: i64 = 0

// Diagnostics: count + total bytes of runtime mmap-path allocations
// (heap_alloc, heap_realloc, malloc/mmap_len). Read via __rtmmap_count() /
// __rtmmap_bytes().
var RTMMAP_COUNT_BSS_OFF: i64 = 0
var RTMMAP_BYTES_BSS_OFF: i64 = 0
// Cached 16 MiB read_file scratch buffer (lazy mmap, reused every call).
var READFILE_SCRATCH_BSS_OFF: i64 = 0
var ARENA_REFILL_COUNT_BSS_OFF: i64 = 0
var ARENA_REFILL_BYTES_BSS_OFF: i64 = 0
var ARENA_UNMAP_COUNT_BSS_OFF: i64 = 0
var ARENA_UNMAP_BYTES_BSS_OFF: i64 = 0
var POOL_REFILL_COUNT_BSS_OFF: i64 = 0
var POOL_REFILL_BYTES_BSS_OFF: i64 = 0

var NEEDS_GPU_RUNTIME_DYNLINK: i64 = 0

fn gpu_param_kind_scalar_i64() -> i64 { 1 }
fn gpu_param_kind_slice_in_f64() -> i64 { 2 }
fn gpu_param_kind_slice_out_f64() -> i64 { 3 }
fn gpu_kernel_ptx_kind_vec_binary_f64() -> i64 { 1 }

fn gpu_dyn_linux_x86_text_base() -> i64 { 0x400000 }
fn gpu_dyn_linux_x86_text_off() -> i64 { 4096 }
fn gpu_dyn_linux_x86_data_off() -> i64 { 8192 }
fn gpu_dyn_linux_x86_data_base() -> i64 { 0x600000 }
fn gpu_dyn_linux_x86_got_off() -> i64 { 512 }
fn gpu_dyn_linux_x86_got_base() -> i64 { return gpu_dyn_linux_x86_data_base() + gpu_dyn_linux_x86_got_off() }
fn gpu_dyn_linux_x86_got_slot_dlopen() -> i64 { return gpu_dyn_linux_x86_got_base() + 0 }
fn gpu_dyn_linux_x86_got_slot_dlsym() -> i64 { return gpu_dyn_linux_x86_got_base() + 8 }
fn gpu_dyn_linux_x86_got_slot_dlclose() -> i64 { return gpu_dyn_linux_x86_got_base() + 16 }

fn local_cap() -> i64 { return 2048 }
fn global_cap() -> i64 { return 2048 }
fn max_frame_bytes() -> i64 { return 4194304 }
fn box_page_bytes() -> i64 { return 4096 }
fn local_bss_spill_bytes() -> i64 { return 1048576 }
fn token_capacity() -> i64 { return 2097152 }

fn note_limit_error(kind: i64) with Mut {
    if LIMIT_ERROR_KIND == 0 { LIMIT_ERROR_KIND = kind }
    // Import-tolerant: errors in imported functions should not block ELF emission
    if MAIN_SRC_END > 0 && CURRENT_FN >= 0 && CURRENT_FN < 65536 {
        if (FN_EFFECTS[CURRENT_FN as usize] & 2048) != 0 {
            return  // imported function error — don't set TYPECHECK_FAILED
        }
    }
    TYPECHECK_FAILED = 1
}

fn print_limit_error() with IO, Mut, Panic {
    if LIMIT_ERROR_KIND == 1 {
        print("error[E007]: too many local variables in function (max ")
        print_int(local_cap())
        print(")\n")
    } else if LIMIT_ERROR_KIND == 2 {
        print("error[E008]: too many globals (max ")
        print_int(global_cap())
        print(")\n")
    }
}

fn bss_alloc_aligned(bytes: i64) -> i64 with Mut, Panic, Div {
    let aligned = (bytes + 7) / 8 * 8
    let off = GL_BSS_SIZE
    GL_BSS_SIZE = GL_BSS_SIZE + aligned
    return off
}

fn ptx_reset_fn_meta(fi: i64) with Mut, Panic {
    if fi < 0 || fi >= 4096 { return }
    FN_PTX_SUPPORTED[fi as usize] = 0
    FN_PTX_KIND[fi as usize] = 0
    FN_PTX_OFF[fi as usize] = 0
    FN_PTX_LEN[fi as usize] = 0
    FN_PTX_EXTENT_SLOT[fi as usize] = 0
    var i: i64 = 0
    while i < 8 {
        FN_PTX_PARAM_KINDS[(fi * 8 + i) as usize] = 0
        i = i + 1
    }
}

fn ptx_emit_byte(v: i64) with Mut {
    if PTX_LEN < 262144 {
        PTX_BUF[PTX_LEN as usize] = (v & 0xFF) as i8
        PTX_LEN = PTX_LEN + 1
    }
}

fn ptx_emit_string(s: string) with Mut, Panic, Div {
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        ptx_emit_byte(str_char_at(s, i))
        i = i + 1
    }
}

fn ptx_emit_src_range(ns: i64, ne: i64) with Mut, Panic {
    var i: i64 = ns
    while i < ne {
        ptx_emit_byte(sb(i))
        i = i + 1
    }
}

fn ptx_finish_fn(fi: i64, start_off: i64, kind: i64, extent_slot: i64) with Mut, Panic {
    if fi < 0 || fi >= 4096 { return }
    ptx_emit_byte(0)
    FN_PTX_SUPPORTED[fi as usize] = 1
    FN_PTX_KIND[fi as usize] = kind
    FN_PTX_OFF[fi as usize] = start_off
    FN_PTX_LEN[fi as usize] = PTX_LEN - start_off - 1
    FN_PTX_EXTENT_SLOT[fi as usize] = extent_slot
}

fn fn_param_kind(fi: i64, arg_idx: i64) -> i64 with IO, Mut, Panic, Div {
    if fi < 0 || fi >= FN_COUNT { return 0 }
    scan_fn_param_type(fi, arg_idx)
    if SCAN_TY == 1 && SCAN_TY_HASH == 0 { return gpu_param_kind_scalar_i64() }
    if type_is_slice_ref(SCAN_TY, SCAN_TY_HASH) {
        let inner_ty = ref_hash_inner_ty(SCAN_TY_HASH)
        let inner_hash = ref_hash_inner_hash(SCAN_TY_HASH)
        if inner_ty == 8 && arr_hash_elem_ty(inner_hash) == 2 && arr_hash_esiz(inner_hash) == 8 {
            if ref_hash_mut(SCAN_TY_HASH) != 0 { return gpu_param_kind_slice_out_f64() }
            return gpu_param_kind_slice_in_f64()
        }
    }
    return 0
}

fn kernel_matches_supported_vec_binary_pattern(fi: i64, body_start: i64) -> i64 with Mut, Panic {
    if fi < 0 || fi >= FN_COUNT { return 0 }
    var saw_gpu_tid: i64 = 0
    var saw_tid: i64 = 0
    var saw_n: i64 = 0
    var saw_a: i64 = 0
    var saw_b: i64 = 0
    var saw_c: i64 = 0
    var saw_add: i64 = 0
    var p: i64 = body_start
    var depth: i64 = 1
    while p < TC && depth > 0 {
        if TK[p as usize] == 8 { depth = depth + 1 }
        if TK[p as usize] == 9 { depth = depth - 1 }
        if TK[p as usize] == 3 {
            if src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "gpu_thread_id_x") { saw_gpu_tid = 1 }
            if src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "tid") { saw_tid = 1 }
            if src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "n") { saw_n = 1 }
            if src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "a") { saw_a = 1 }
            if src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "b") { saw_b = 1 }
            if src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "c") { saw_c = 1 }
        }
        if TK[p as usize] == 17 { saw_add = 1 }
        p = p + 1
    }
    if saw_gpu_tid == 0 { return 0 }
    if saw_tid == 0 || saw_n == 0 { return 0 }
    if saw_a == 0 || saw_b == 0 || saw_c == 0 { return 0 }
    if saw_add == 0 { return 0 }
    return 1
}

fn maybe_compile_kernel_ptx(fi: i64, body_start: i64, extent_slot: i64) with IO, Mut, Panic, Div {
    ptx_reset_fn_meta(fi)
    if fi < 0 || fi >= FN_COUNT { return }
    if FN_ARITY[fi as usize] != 4 { return }
    if fn_param_kind(fi, 0) != gpu_param_kind_scalar_i64() { return }
    if fn_param_kind(fi, 1) != gpu_param_kind_slice_in_f64() { return }
    if fn_param_kind(fi, 2) != gpu_param_kind_slice_in_f64() { return }
    if fn_param_kind(fi, 3) != gpu_param_kind_slice_out_f64() { return }
    if kernel_matches_supported_vec_binary_pattern(fi, body_start) == 0 { return }

    let name_tok = FN_NAME_TOK[fi as usize]
    if name_tok < 0 || name_tok >= TC { return }
    let n_ns = TS[name_tok as usize]
    let n_ne = TE[name_tok as usize]
    let start_off = PTX_LEN
    FN_PTX_PARAM_KINDS[(fi * 8 + 0) as usize] = gpu_param_kind_scalar_i64()
    FN_PTX_PARAM_KINDS[(fi * 8 + 1) as usize] = gpu_param_kind_slice_in_f64()
    FN_PTX_PARAM_KINDS[(fi * 8 + 2) as usize] = gpu_param_kind_slice_in_f64()
    FN_PTX_PARAM_KINDS[(fi * 8 + 3) as usize] = gpu_param_kind_slice_out_f64()

    ptx_emit_string(".version 7.0\n")
    ptx_emit_string(".target sm_70\n")
    ptx_emit_string(".address_size 64\n\n")
    ptx_emit_string(".visible .entry ")
    ptx_emit_src_range(n_ns, n_ne)
    ptx_emit_string("(\n")
    ptx_emit_string("    .param .u64 n,\n")
    ptx_emit_string("    .param .u64 a,\n")
    ptx_emit_string("    .param .u64 b,\n")
    ptx_emit_string("    .param .u64 c\n")
    ptx_emit_string(") {\n")
    ptx_emit_string("    .reg .u32 %r<4>;\n")
    ptx_emit_string("    .reg .u64 %rd<8>;\n")
    ptx_emit_string("    .reg .f64 %fd<4>;\n")
    ptx_emit_string("    .reg .pred %p<2>;\n")
    ptx_emit_string("    mov.u32 %r0, %tid.x;\n")
    ptx_emit_string("    mov.u32 %r1, %ntid.x;\n")
    ptx_emit_string("    mov.u32 %r2, %ctaid.x;\n")
    ptx_emit_string("    mad.lo.u32 %r3, %r2, %r1, %r0;\n")
    ptx_emit_string("    cvt.u64.u32 %rd0, %r3;\n")
    ptx_emit_string("    ld.param.u64 %rd1, [n];\n")
    ptx_emit_string("    setp.ge.u64 %p0, %rd0, %rd1;\n")
    ptx_emit_string("    @%p0 ret;\n")
    ptx_emit_string("    ld.param.u64 %rd2, [a];\n")
    ptx_emit_string("    ld.param.u64 %rd3, [b];\n")
    ptx_emit_string("    ld.param.u64 %rd4, [c];\n")
    ptx_emit_string("    shl.b64 %rd5, %rd0, 3;\n")
    ptx_emit_string("    add.u64 %rd2, %rd2, %rd5;\n")
    ptx_emit_string("    add.u64 %rd3, %rd3, %rd5;\n")
    ptx_emit_string("    add.u64 %rd4, %rd4, %rd5;\n")
    ptx_emit_string("    ld.global.f64 %fd0, [%rd2];\n")
    ptx_emit_string("    ld.global.f64 %fd1, [%rd3];\n")
    ptx_emit_string("    add.f64 %fd2, %fd0, %fd1;\n")
    ptx_emit_string("    st.global.f64 [%rd4], %fd2;\n")
    ptx_emit_string("    ret;\n")
    ptx_emit_string("}\n")
    ptx_finish_fn(fi, start_off, gpu_kernel_ptx_kind_vec_binary_f64(), extent_slot)
}

// Hash: FNV-1a 32-bit with 37-bit mask — collision-resistant, overflow-safe
fn gl_name_hash(ns: i64, ne: i64) -> i64 with Panic, Mut {
    let l = ne - ns
    var h: i64 = 2166136261
    var hi: i64 = 0
    while hi < l {
        h = ((h ^ (sb(ns + hi) & 0xFF)) * 16777619) & 0x1FFFFFFFFF
        hi = hi + 1
    }
    return h
}

// Same FNV-1a as gl_name_hash() but over a compiler-literal string instead of
// a source-buffer span — lets us compare a hash captured from source text
// (e.g. FN_RECV_HASH for `impl R for i64`, which is gl_name_hash() of the
// literal token text "i64") against a known primitive-type-name constant
// without needing that constant to also live in the source buffer.
fn str_lit_hash(kw: string) -> i64 with Panic, Mut {
    let l = str_len(kw)
    var h: i64 = 2166136261
    var hi: i64 = 0
    while hi < l {
        h = ((h ^ (str_char_at(kw, hi) & 0xFF)) * 16777619) & 0x1FFFFFFFFF
        hi = hi + 1
    }
    return h
}

// C3/C2 helper: does a name-hash (as produced by gl_name_hash on an impl
// target's identifier text, e.g. FN_RECV_HASH for `impl R for i64`) belong to
// a primitive type name? Returns the VAR_TY/SCAN_TY code scan_type() would
// assign that primitive (see scan_type ~line 5490-5525: i8/u8/i32/u32/i64/
// u64/usize -> 1, f32/f64 -> 2, str/string -> 3, bool -> 4), or -1 if h does
// not match any primitive-type-name literal.
fn prim_name_hash_ty(h: i64) -> i64 with Panic, Mut {
    if h == str_lit_hash("i64") { return 1 }
    if h == str_lit_hash("i32") { return 1 }
    if h == str_lit_hash("u64") { return 1 }
    if h == str_lit_hash("usize") { return 1 }
    if h == str_lit_hash("u8") { return 1 }
    if h == str_lit_hash("i8") { return 1 }
    if h == str_lit_hash("u32") { return 1 }
    if h == str_lit_hash("f64") { return 2 }
    if h == str_lit_hash("f32") { return 2 }
    if h == str_lit_hash("bool") { return 4 }
    return -1
}

// Inverse of prim_name_hash_ty(): canonical literal-name hash for a
// primitive VAR_TY/EXPR_TY code. Used at method-dispatch call sites (C2) to
// recover the same hash fn_find_method() indexes FN_RECV_HASH by for
// `impl Trait for <primitive>` blocks, since primitive expressions normally
// carry EXPR_TY_HASH == 0 (see scan_type — primitives never set SCAN_TY_HASH).
// Code 1 covers every integer-width primitive (i8/u8/i32/u32/i64/u64/usize);
// "i64" is used as the canonical text since that is the width in the C2/C3
// witnesses and lean_single's numeric expressions are otherwise width-erased.
fn prim_lit_hash(t: i64) -> i64 with Panic, Mut {
    if t == 1 { return str_lit_hash("i64") }
    if t == 2 { return str_lit_hash("f64") }
    if t == 3 { return str_lit_hash("str") }
    if t == 4 { return str_lit_hash("bool") }
    return 0
}

// ─── Gen 19: Unit dimension helpers ──────────────────────────────────────────

// Pack 7 dimension exponents (-8..+7 each) into one i64 using 4-bit 2's-complement
fn dim_pack(mass: i64, len: i64, time: i64, temp: i64, amount: i64, current: i64, lum: i64) -> i64 {
    return (mass & 15)
         | ((len     & 15) << 4)
         | ((time    & 15) << 8)
         | ((temp    & 15) << 12)
         | ((amount  & 15) << 16)
         | ((current & 15) << 20)
         | ((lum     & 15) << 24)
}

// Add two dimension vectors (multiply units: e.g. m * s⁻¹)
fn dim_add(a: i64, b: i64) -> i64 {
    return ((((a & 15) + (b & 15)) & 15))
         | (((((a >> 4) & 15) + ((b >> 4) & 15)) & 15) << 4)
         | (((((a >> 8) & 15) + ((b >> 8) & 15)) & 15) << 8)
         | (((((a >> 12) & 15) + ((b >> 12) & 15)) & 15) << 12)
         | (((((a >> 16) & 15) + ((b >> 16) & 15)) & 15) << 16)
         | (((((a >> 20) & 15) + ((b >> 20) & 15)) & 15) << 20)
         | (((((a >> 24) & 15) + ((b >> 24) & 15)) & 15) << 24)
}

// Subtract two dimension vectors (divide units: e.g. m / s)
fn dim_sub(a: i64, b: i64) -> i64 {
    return (((a & 15) - (b & 15)) & 15)
         | ((((((a >> 4) & 15) - ((b >> 4) & 15)) & 15)) << 4)
         | ((((((a >> 8) & 15) - ((b >> 8) & 15)) & 15)) << 8)
         | ((((((a >> 12) & 15) - ((b >> 12) & 15)) & 15)) << 12)
         | ((((((a >> 16) & 15) - ((b >> 16) & 15)) & 15)) << 16)
         | ((((((a >> 20) & 15) - ((b >> 20) & 15)) & 15)) << 20)
         | ((((((a >> 24) & 15) - ((b >> 24) & 15)) & 15)) << 24)
}

// Register a unit hash → dimension vector (open-addressing hash table, load factor <5%)
fn unit_register_h(h: i64, dim: i64) with Mut, Panic {
    if h == 0 { return }
    var idx: i64 = h % 2048
    if idx < 0 { idx = idx + 2048 }
    var probe: i64 = idx
    var iters: i64 = 0
    while iters < 2048 {
        if UNIT_HASH_TABLE[probe as usize] == 0 || UNIT_HASH_TABLE[probe as usize] == h {
            UNIT_HASH_TABLE[probe as usize] = h
            UNIT_DIM_TABLE[probe as usize] = dim
            return
        }
        probe = probe + 1
        if probe >= 2048 { probe = 0 }
        iters = iters + 1
    }
}

// Look up the dimension vector for a unit hash (returns 0 if not registered)
fn unit_lookup_dim(h: i64) -> i64 with Panic, Mut, Div {
    if h == 0 { return 0 }
    var idx: i64 = h % 2048
    if idx < 0 { idx = idx + 2048 }
    var probe: i64 = idx
    var iters: i64 = 0
    while iters < 2048 {
        if UNIT_HASH_TABLE[probe as usize] == 0 { return 0 }
        if UNIT_HASH_TABLE[probe as usize] == h { return UNIT_DIM_TABLE[probe as usize] }
        probe = probe + 1
        if probe >= 2048 { probe = 0 }
        iters = iters + 1
    }
    return 0
}

fn unit_is_registered_h(h: i64) -> bool with Panic, Mut, Div {
    if h == 0 { return false }
    var idx: i64 = h % 2048
    if idx < 0 { idx = idx + 2048 }
    var probe: i64 = idx
    var iters: i64 = 0
    while iters < 2048 {
        if UNIT_HASH_TABLE[probe as usize] == 0 { return false }
        if UNIT_HASH_TABLE[probe as usize] == h { return true }
        probe = probe + 1
        if probe >= 2048 { probe = 0 }
        iters = iters + 1
    }
    return false
}

fn unit_type_hash_base() -> i64 { return 900000000000 }

fn unit_type_hash_make(dim: i64) -> i64 {
    return unit_type_hash_base() + dim
}

fn unit_type_hash_is(h: i64) -> bool {
    return h >= unit_type_hash_base() && h < 901000000000
}

fn unit_type_hash_dim(h: i64) -> i64 {
    if unit_type_hash_is(h) == false { return 0 }
    return h - unit_type_hash_base()
}

fn type_hash_unit_dim(h: i64) -> i64 with Panic, Mut, Div {
    if unit_type_hash_is(h) { return unit_type_hash_dim(h) }
    return unit_lookup_dim(h)
}

fn unit_call_arg_mismatch(param_hash: i64, expr_unit: i64, expr_dim: i64) -> bool with Panic, Mut, Div {
    let param_dim = type_hash_unit_dim(param_hash)
    if param_dim == 0 { return false }
    if expr_unit == param_hash { return false }
    if expr_dim != 0 && expr_dim == param_dim { return false }
    return true
}

fn expr_set_unit_from_type(ty: i64, ty_hash: i64) with Panic, Mut, Div {
    EXPR_UNIT = 0
    EXPR_UNIT_DIM = 0
    if ty == 2 && ty_hash != 0 {
        EXPR_UNIT = ty_hash
        EXPR_UNIT_DIM = type_hash_unit_dim(ty_hash)
    }
}

// Compute gl_name_hash from raw byte values (for init_unit_table without src buffer)
// hash = len * 1000003 + sum(byte[i] * (i+1) * 31)
fn hash_1(b0: i64) -> i64                        { return 1000003 + b0 * 31 }
fn hash_2(b0: i64, b1: i64) -> i64               { return 2000006 + b0 * 31 + b1 * 62 }
fn hash_3(b0: i64, b1: i64, b2: i64) -> i64      { return 3000009 + b0 * 31 + b1 * 62 + b2 * 93 }
fn hash_4(b0: i64, b1: i64, b2: i64, b3: i64) -> i64 { return 4000012 + b0 * 31 + b1 * 62 + b2 * 93 + b3 * 124 }

// Preload standard unit systems: SI, CGS, Imperial, Astronomical, Pharmacological, Atomic
// dim_pack encoding: 4-bit 2's-complement per field, 0 = dimensionless
// Derived dim_pack values:
//   DIM_FORCE    = 1|(1<<4)|(14<<8) = 3601  [mass^1*len^1*time^-2, -2 → 14 in 4-bit 2's-c]
//   DIM_ENERGY   = 1|(2<<4)|(14<<8) = 3617  [mass^1*len^2*time^-2]
//   DIM_POWER    = 1|(2<<4)|(13<<8) = 3361  [mass^1*len^2*time^-3, -3 → 13]
//   DIM_FREQ     = (15<<8) = 3840           [time^-1, -1 → 15]
//   DIM_PRESSURE = 1|(15<<4)|(14<<8) = 3825 [mass^1*len^-1*time^-2, len^-1 → 15]
//   DIM_VOLUME   = (3<<4) = 48              [length^3]
fn init_unit_table() with Mut, Panic {
    let DIM_MASS     = 1;       let DIM_LEN    = 16;     let DIM_TIME    = 256
    let DIM_TEMP     = 4096;    let DIM_AMOUNT = 65536;  let DIM_CURRENT = 1048576
    let DIM_LUM      = 16777216
    let DIM_FORCE    = 3601;    let DIM_ENERGY = 3617;   let DIM_POWER   = 3361
    let DIM_FREQ     = 3840;    let DIM_PRESSURE = 3825; let DIM_VOLUME  = 48
    // ASCII byte values for hash helpers
    let A=65; let G=71; let H=72; let I=73; let J=74; let K=75; let L=76; let M=77
    let N=78; let P=80; let U=85; let V=86; let W=87
    let a=97; let b=98; let c=99; let d=100; let e=101; let f=102; let g=103; let h=104
    let i=105; let k=107; let l=108; let m=109; let n=110; let o=111; let p=112
    let r=114; let s=115; let t=116; let u=117; let y=121; let z=122

    // ── SI mass ───────────────────────────────────────────────────────────────
    unit_register_h(31310284279,    DIM_MASS)  // kg
    unit_register_h(38152185350,     DIM_MASS)  // g
    unit_register_h(87680757197,    DIM_MASS)  // mg
    unit_register_h(130362532706,    DIM_MASS)  // ng
    unit_register_h(20412157714,   DIM_MASS)  // mcg  hash_3(m,c,g)=3000009+109*31+99*62+103*93=3019105
    unit_register_h(38387072016,     DIM_MASS)  // u    (atomic mass unit)
    unit_register_h(60669009618,   DIM_MASS)  // amu  hash_3(a,m,u)=3000009+97*31+109*62+117*93=3020655
    unit_register_h(104273659979,    DIM_MASS)  // lb   (pound)
    unit_register_h(117393595628,    DIM_MASS)  // oz   (ounce)
    unit_register_h(26789588614,  DIM_MASS)  // Msun hash_4(M,s,u,n)=4000012+77*31+115*62+117*93+110*124=4034050

    // ── SI length ─────────────────────────────────────────────────────────────
    unit_register_h(38252851064,     DIM_LEN)   // m
    unit_register_h(61809993517,    DIM_LEN)   // cm
    unit_register_h(31209618565,    DIM_LEN)   // km   hash=2010081
    unit_register_h(87512981007,    DIM_LEN)   // mm   hash_2(m,m)=2000006+109*31+109*62=2010143
    unit_register_h(130463198420,    DIM_LEN)   // nm
    unit_register_h(22970292759,    DIM_LEN)   // ft   (foot)
    unit_register_h(5389187742,    DIM_LEN)   // in   (inch) note: same hash 2010081 as km → both length OK
    unit_register_h(87445870531,    DIM_LEN)   // mi   (mile) hash_2(m,i)=2000006+109*31+105*62=2009895
    unit_register_h(83070266544,    DIM_LEN)   // yd   (yard) hash_2(y,d)=2000006+121*31+100*62=2009957
    unit_register_h(13821620955,    DIM_LEN)   // AU   (astronomical unit)
    unit_register_h(125867808100,    DIM_LEN)   // pc   (parsec)
    unit_register_h(104424658550,    DIM_LEN)   // ly   (light-year)

    // ── SI time ───────────────────────────────────────────────────────────────
    unit_register_h(38487737730,     DIM_TIME)  // s
    unit_register_h(87345204817,    DIM_TIME)  // ms
    unit_register_h(130026980326,    DIM_TIME)  // ns   hash_2(n,s)=2000006+110*31+115*62=2010546
    unit_register_h(20561478999,   DIM_TIME)  // min
    unit_register_h(38336739159,     DIM_TIME)  // h    (hour)
    unit_register_h(18509123391,    DIM_TIME)  // hr
    unit_register_h(38135407731,     DIM_TIME)  // d    (day)
    unit_register_h(82902490354,    DIM_TIME)  // yr

    // ── SI current ────────────────────────────────────────────────────────────
    unit_register_h(37648856780,     DIM_CURRENT) // A
    unit_register_h(88116975291,    DIM_CURRENT) // mA

    // ── SI temperature ────────────────────────────────────────────────────────
    unit_register_h(37816632970,     DIM_TEMP)  // K
    unit_register_h(84203081940,  DIM_TEMP)  // degC hash_4(d,e,g,C)=4000012+100*31+101*62+103*93+67*124=4027261
    unit_register_h(84152749083,  DIM_TEMP)  // degF hash_4(d,e,g,F)=4027261-67*124+70*124=4027633

    // ── SI amount / luminosity ────────────────────────────────────────────────
    unit_register_h(102670171931,   DIM_AMOUNT) // mol
    unit_register_h(68031422658,   DIM_AMOUNT) // mEq  hash_3(m,E,q)=3000009+109*31+69*62+113*93=3018175
    unit_register_h(61658994946,    DIM_LUM)   // cd   (candela)

    // ── SI derived ────────────────────────────────────────────────────────────
    unit_register_h(37766300113,     DIM_FORCE)    // N   (Newton)
    unit_register_h(37833410589,     DIM_ENERGY)   // J   (Joule)
    unit_register_h(31629059040,    DIM_ENERGY)   // kJ
    unit_register_h(37883743446,     DIM_POWER)    // W   (Watt)
    unit_register_h(32115609991,    DIM_POWER)    // kW
    unit_register_h(134602238455,    DIM_FREQ)     // Hz
    unit_register_h(10356074548,   DIM_FREQ)     // kHz  hash_3(k,H,z)=3000009+107*31+72*62+122*93=3019136
    unit_register_h(108716374442,    DIM_PRESSURE) // Pa
    unit_register_h(57520666493,   DIM_PRESSURE) // kPa  hash_3(k,P,a)=3000009+107*31+80*62+97*93=3017307
    unit_register_h(37732744875,     DIM_VOLUME)   // L    (litre)
    unit_register_h(88033087196,    DIM_VOLUME)   // mL
    unit_register_h(61190898900,    DIM_VOLUME)   // uL   hash_2(u,L)=2000006+117*31+76*62=2008345

    // ── CGS ───────────────────────────────────────────────────────────────────
    unit_register_h(109414156195,   DIM_ENERGY)   // erg  (CGS energy = J in dimension)
    unit_register_h(85584488560,   DIM_FORCE)    // dyn  (CGS force = N in dimension)

    // ── Imperial pressure ─────────────────────────────────────────────────────
    unit_register_h(44870187079,   DIM_PRESSURE) // psi
    unit_register_h(36351474970,   DIM_PRESSURE) // bar
    unit_register_h(99126179711,   DIM_PRESSURE) // atm

    // ── Pharmacological ───────────────────────────────────────────────────────
    unit_register_h(4578478598,  DIM_PRESSURE) // mmHg hash_4(m,m,H,g)=4000012+109*31+109*62+72*93+103*124=4029617
    unit_register_h(122002408995,    0)            // IU   (dimensionless biological unit)

    // ── Atomic / nuclear ──────────────────────────────────────────────────────
    unit_register_h(117727470722,    DIM_ENERGY)   // eV
    unit_register_h(27096621329,   DIM_ENERGY)   // keV  hash_3(k,e,V)=3000009+107*31+101*62+86*93=3017586
    unit_register_h(133524763971,   DIM_ENERGY)   // MeV  hash_3(M,e,V)=3000009+77*31+101*62+86*93=3016656
    unit_register_h(3633804413,   DIM_ENERGY)   // GeV  hash_3(G,e,V)=3000009+71*31+101*62+86*93=3016470
}

fn gl_find(ns: i64, ne: i64) -> i64 with Panic, Mut {
    let h = gl_name_hash(ns, ne)
    var i: i64 = 0
    while i < GL_COUNT {
        if GL[(i * 4 + 0) as usize] == h { return i }
        i = i + 1
    }
    return -1
}

fn gl_add(ns: i64, ne: i64, esiz: i64, alen: i64) -> i64 with Mut, Panic {
    if GL_COUNT >= global_cap() {
        note_limit_error(2)
        return -1
    }
    var sz: i64 = 8
    if alen > 0 { sz = alen * esiz }
    let aligned = (sz + 7) / 8 * 8
    let gix = GL_COUNT
    GL[(GL_COUNT * 4 + 0) as usize] = gl_name_hash(ns, ne)
    GL[(GL_COUNT * 4 + 1) as usize] = GL_BSS_SIZE
    GL[(GL_COUNT * 4 + 2) as usize] = esiz
    GL[(GL_COUNT * 4 + 3) as usize] = alen
    GL_COUNT = GL_COUNT + 1
    GL_BSS_SIZE = GL_BSS_SIZE + aligned
    return gix
}

// Per-function local variable table (reset per function)
var VAR_NS: [i64; 2048] = [0; 2048]
var VAR_NE: [i64; 2048] = [0; 2048]
var VAR_SLOT: [i64; 2048] = [0; 2048]
var VAR_LEN_SLOT: [i64; 2048] = [0; 2048]
var VAR_ALEN: [i64; 2048] = [0; 2048]
var VAR_ESIZ: [i64; 2048] = [0; 2048]
var VAR_IS_F64: [i64; 2048] = [0; 2048]
var VAR_IS_CLOSURE: [i64; 2048] = [0; 2048]
var VAR_MUT: [i64; 2048] = [0; 2048]
var VAR_COUNT: i64 = 0
var NEXT_SLOT: i64 = 1
var FRAME_PATCH_COUNT: i64 = 0
var FRAME_PATCH_OFF: [i64; 65536] = [0; 65536]
var A64_FRAME_PATCH_COUNT: i64 = 0
var A64_FRAME_PATCH_OFF: [i64; 65536] = [0; 65536]
var A64_FRAME_PATCH_RD: [i64; 65536] = [0; 65536]
var FN_FRAME_SIZE: [i64; 65536] = [0; 65536]
var LAST_EXPR_IS_CLOSURE: i64 = 0
// Scratch globals for float scientific exponent (avoids extra locals in compile_primary)
var FL_SCI_SCRATCH: i64 = 0
var FL_SCI_NEG: i64 = 0
var FL_FRAC_DIGITS: i64 = 0
var LAST_STMT_HAS_VALUE: i64 = 0

// Constant table (let/const/pub let/pub const NAME: TYPE = VALUE)
var CONST_NS: [i64; 4096] = [0; 4096]
var CONST_NE: [i64; 4096] = [0; 4096]
var CONST_VAL: [i64; 4096] = [0; 4096]
var CONST_TYPE: [i64; 4096] = [0; 4096]
var CONST_TOK_IDX: [i64; 4096] = [0; 4096]
var CONST_COUNT: i64 = 0
var CONST_FOUND_VAL: i64 = 0
var CONST_FOUND_IDX: i64 = 0

// Token kinds: inlined as integers (boot4 doesn't init scalar globals)

// ─── Helpers ───
fn sb(i: i64) -> i64 with Panic, Mut { if i >= 0 && i < SRC_LEN { return SRC[i as usize] as i64 & 0xFF }; return 0 }
fn em(b: i64) with Mut { if CL >= 134217728 { if CD_OVF == 0 { CD_OVF_FN = CURRENT_FN; CD_OVF_CL = CL } CD_OVF = 1; return } CD[CL as usize] = b as i8; CL = CL + 1 }
fn em32(v: i64) with Mut { em(v & 0xFF); em((v >> 8) & 0xFF); em((v >> 16) & 0xFF); em((v >> 24) & 0xFF) }
fn em64(v: i64) with Mut { em32(v & 0xFFFFFFFF); em32((v >> 32) & 0xFFFFFFFF) }

fn emit_load_abs_addr_to_rax_x86(addr: i64) with Mut {
    em(0x48); em(0xb8); em64(addr)
}

fn emit_load_abs_qword_to_rax_x86(addr: i64) with Mut {
    emit_load_abs_addr_to_rax_x86(addr)
    em(0x48); em(0x8b); em(0x00)
}

fn emit_store_rax_to_abs_qword_x86(addr: i64) with Mut {
    em(0x48); em(0x89); em(0xc1)
    emit_load_abs_addr_to_rax_x86(addr)
    em(0x48); em(0x89); em(0x08)
    em(0x48); em(0x89); em(0xc8)
}

fn emit_store_imm64_to_abs_qword_x86(addr: i64, value: i64) with Mut {
    emit_imm64(value)
    emit_store_rax_to_abs_qword_x86(addr)
}

fn emit_load_stack_qword_to_rax_x86(disp: i64) with Mut {
    em(0x48); em(0x8b); em(0x84); em(0x24); em32(disp)
}

fn emit_load_call_arg_to_rax_x86(argc: i64, arg_idx: i64) with Mut {
    emit_load_stack_qword_to_rax_x86((argc - 1 - arg_idx) * 8)
}

fn emit_call_rax_x86(argc: i64) with Mut {
    emit_setup_direct_call_args_x86(argc)
    emit_prepare_stack_call_args_x86(argc, 6)
    em(0xff); em(0xd0)
    emit_drop_call_args_x86(argc + call_extra_stack_args_x86(argc, 6))
}

fn emit_call_abs_qword_x86(addr: i64, argc: i64) with Mut {
    emit_load_abs_qword_to_rax_x86(addr)
    emit_call_rax_x86(argc)
}

fn emit_inline_cstr_from_string_x86(s: string) with Mut, Panic, Div {
    let n = str_len(s)
    em(0xe9)
    em32(n + 1)
    let start = CL
    var i: i64 = 0
    while i < n {
        em(str_char_at(s, i))
        i = i + 1
    }
    em(0)
    let disp = start - (CL + 7)
    em(0x48); em(0x8d); em(0x05); em32(disp)
}

fn emit_inline_cstr_from_src_x86(ns: i64, ne: i64) with Mut, Panic {
    let n = ne - ns
    em(0xe9)
    em32(n + 1)
    let start = CL
    var i: i64 = 0
    while i < n {
        em(sb(ns + i))
        i = i + 1
    }
    em(0)
    let disp = start - (CL + 7)
    em(0x48); em(0x8d); em(0x05); em32(disp)
}

fn emit_inline_cstr_from_ptx_x86(off: i64, len: i64) with Mut, Panic {
    em(0xe9)
    em32(len + 1)
    let start = CL
    var i: i64 = 0
    while i < len {
        em(PTX_BUF[(off + i) as usize] as i64 & 0xFF)
        i = i + 1
    }
    em(0)
    let disp = start - (CL + 7)
    em(0x48); em(0x8d); em(0x05); em32(disp)
}

fn emit_gpu_diag_once_x86(msg: string) with Mut, Panic, Div {
    emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + GPU_RT_DIAG_BSS_OFF)
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x85)
    let skip = CL
    em32(0)
    emit_inline_cstr_from_string_x86(msg)
    emit_print_cstr()
    emit_store_imm64_to_abs_qword_x86(GL_BSS_BASE + GPU_RT_DIAG_BSS_OFF, 1)
    patch32(skip, CL)
}

fn emit_mark_gpu_unavailable_x86(msg: string) with Mut, Panic, Div {
    emit_store_imm64_to_abs_qword_x86(GL_BSS_BASE + GPU_RT_STATE_BSS_OFF, 0 - 1)
    emit_gpu_diag_once_x86(msg)
}

fn emit_gpu_resolve_symbol_x86(sym: string, sym_fallback: string, dst_addr: i64, fail_msg: string) with Mut, Panic, Div {
    emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + GPU_RT_LIBCUDA_HANDLE_BSS_OFF)
    em(0x50)
    emit_inline_cstr_from_string_x86(sym)
    em(0x50)
    emit_call_abs_qword_x86(gpu_dyn_linux_x86_got_slot_dlsym(), 2)
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x85)
    let have_primary = CL
    em32(0)
    if str_len(sym_fallback) > 0 {
        emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + GPU_RT_LIBCUDA_HANDLE_BSS_OFF)
        em(0x50)
        emit_inline_cstr_from_string_x86(sym_fallback)
        em(0x50)
        emit_call_abs_qword_x86(gpu_dyn_linux_x86_got_slot_dlsym(), 2)
    }
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x85)
    let have_symbol = CL
    em32(0)
    emit_mark_gpu_unavailable_x86(fail_msg)
    em(0x31); em(0xc0)
    em(0xe9)
    let end_jmp = CL
    em32(0)
    patch32(have_primary, CL)
    patch32(have_symbol, CL)
    emit_store_rax_to_abs_qword_x86(dst_addr)
    emit_imm64(1)
    patch32(end_jmp, CL)
}

fn emit_try_gpu_runtime_init_x86() with Mut, Panic, Div {
    if TARGET_OS != 0 || TARGET_ARCH != 0 {
        emit_mark_gpu_unavailable_x86("GPU unavailable: native CUDA runtime unsupported on this target\n")
        em(0x31); em(0xc0)
        return
    }
    NEEDS_GPU_RUNTIME_DYNLINK = 1
    emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + GPU_RT_STATE_BSS_OFF)
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84)
    let do_init = CL
    em32(0)
    em(0x48); em(0x83); em(0xf8); em(1)
    em(0x0f); em(0x84)
    let already_ok = CL
    em32(0)
    em(0x31); em(0xc0)
    em(0xe9)
    let end_jmp = CL
    em32(0)

    patch32(do_init, CL)
    // Guard: open /dev/nvidiactl before dlopen to avoid crash on GPU-less nodes
    emit_inline_cstr_from_string_x86("/dev/nvidiactl")
    em(0x48); em(0x89); em(0xc7)           // mov rdi, rax  (path)
    em(0x31); em(0xf6)                     // xor esi, esi  (O_RDONLY=0)
    em(0x31); em(0xd2)                     // xor edx, edx  (mode=0)
    em(0xb8); em(2); em(0); em(0); em(0)  // mov eax, 2   (SYS_open)
    em(0x0f); em(0x05)                     // syscall
    em(0x48); em(0x85); em(0xc0)           // test rax, rax
    em(0x0f); em(0x88)                     // js → no_gpu_device (no /dev/nvidiactl)
    let no_gpu_device = CL
    em32(0)
    em(0x48); em(0x89); em(0xc7)           // mov rdi, rax  (fd)
    em(0xb8); em(3); em(0); em(0); em(0)  // mov eax, 3   (SYS_close)
    em(0x0f); em(0x05)                     // syscall (close fd)
    emit_inline_cstr_from_string_x86("libcuda.so.1")
    em(0x50)
    emit_imm64(2)
    em(0x50)
    emit_call_abs_qword_x86(gpu_dyn_linux_x86_got_slot_dlopen(), 2)
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x85)
    let have_lib = CL
    em32(0)
    patch32(no_gpu_device, CL)
    emit_mark_gpu_unavailable_x86("GPU unavailable: libcuda.so not found\n")
    em(0x31); em(0xc0)
    em(0xe9)
    let after_fail_no_lib = CL
    em32(0)
    patch32(have_lib, CL)
    emit_store_rax_to_abs_qword_x86(GL_BSS_BASE + GPU_RT_LIBCUDA_HANDLE_BSS_OFF)

    emit_gpu_resolve_symbol_x86("cuInit", "", GL_BSS_BASE + GPU_RT_CUINIT_PTR_BSS_OFF, "GPU unavailable: cuInit unresolved\n")
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84)
    let fail_after_resolve = CL
    em32(0)
    emit_gpu_resolve_symbol_x86("cuDeviceGet", "", GL_BSS_BASE + GPU_RT_CUDEVICEGET_PTR_BSS_OFF, "GPU unavailable: cuDeviceGet unresolved\n")
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let fail_after_resolve_b = CL; em32(0)
    emit_gpu_resolve_symbol_x86("cuCtxCreate_v2", "cuCtxCreate", GL_BSS_BASE + GPU_RT_CUCTXCREATE_PTR_BSS_OFF, "GPU unavailable: cuCtxCreate unresolved\n")
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let fail_after_resolve_c = CL; em32(0)
    emit_gpu_resolve_symbol_x86("cuCtxSynchronize", "", GL_BSS_BASE + GPU_RT_CUCTXSYNC_PTR_BSS_OFF, "GPU unavailable: cuCtxSynchronize unresolved\n")
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let fail_after_resolve_d = CL; em32(0)
    emit_gpu_resolve_symbol_x86("cuModuleLoadData", "", GL_BSS_BASE + GPU_RT_CUMODULELOADDATA_PTR_BSS_OFF, "GPU unavailable: cuModuleLoadData unresolved\n")
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let fail_after_resolve_e = CL; em32(0)
    emit_gpu_resolve_symbol_x86("cuModuleGetFunction", "", GL_BSS_BASE + GPU_RT_CUMODULEGETFUNCTION_PTR_BSS_OFF, "GPU unavailable: cuModuleGetFunction unresolved\n")
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let fail_after_resolve_f = CL; em32(0)
    emit_gpu_resolve_symbol_x86("cuMemAlloc_v2", "cuMemAlloc", GL_BSS_BASE + GPU_RT_CUMEMALLOC_PTR_BSS_OFF, "GPU unavailable: cuMemAlloc unresolved\n")
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let fail_after_resolve_g = CL; em32(0)
    emit_gpu_resolve_symbol_x86("cuMemFree_v2", "cuMemFree", GL_BSS_BASE + GPU_RT_CUMEMFREE_PTR_BSS_OFF, "GPU unavailable: cuMemFree unresolved\n")
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let fail_after_resolve_h = CL; em32(0)
    emit_gpu_resolve_symbol_x86("cuMemcpyHtoD_v2", "cuMemcpyHtoD", GL_BSS_BASE + GPU_RT_CUMEMCPYHTOD_PTR_BSS_OFF, "GPU unavailable: cuMemcpyHtoD unresolved\n")
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let fail_after_resolve_i = CL; em32(0)
    emit_gpu_resolve_symbol_x86("cuMemcpyDtoH_v2", "cuMemcpyDtoH", GL_BSS_BASE + GPU_RT_CUMEMCPYDTOH_PTR_BSS_OFF, "GPU unavailable: cuMemcpyDtoH unresolved\n")
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let fail_after_resolve_j = CL; em32(0)
    emit_gpu_resolve_symbol_x86("cuLaunchKernel", "", GL_BSS_BASE + GPU_RT_CULAUNCHKERNEL_PTR_BSS_OFF, "GPU unavailable: cuLaunchKernel unresolved\n")
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let fail_after_resolve_k = CL; em32(0)

    emit_imm64(0)
    em(0x50)
    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUINIT_PTR_BSS_OFF, 1)
    em(0x85); em(0xc0)
    em(0x0f); em(0x85)
    let fail_init = CL
    em32(0)

    emit_imm64(GL_BSS_BASE + GPU_RT_DEVICE_BSS_OFF)
    em(0x50)
    emit_imm64(0)
    em(0x50)
    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUDEVICEGET_PTR_BSS_OFF, 2)
    em(0x85); em(0xc0)
    em(0x0f); em(0x85)
    let fail_device = CL
    em32(0)

    emit_imm64(GL_BSS_BASE + GPU_RT_CTX_BSS_OFF)
    em(0x50)
    emit_imm64(0)
    em(0x50)
    emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + GPU_RT_DEVICE_BSS_OFF)
    em(0x50)
    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUCTXCREATE_PTR_BSS_OFF, 3)
    em(0x85); em(0xc0)
    em(0x0f); em(0x85)
    let fail_ctx = CL
    em32(0)

    emit_store_imm64_to_abs_qword_x86(GL_BSS_BASE + GPU_RT_STATE_BSS_OFF, 1)
    emit_imm64(1)
    em(0xe9)
    let after_success = CL
    em32(0)

    patch32(fail_after_resolve, CL)
    patch32(fail_after_resolve_b, CL)
    patch32(fail_after_resolve_c, CL)
    patch32(fail_after_resolve_d, CL)
    patch32(fail_after_resolve_e, CL)
    patch32(fail_after_resolve_f, CL)
    patch32(fail_after_resolve_g, CL)
    patch32(fail_after_resolve_h, CL)
    patch32(fail_after_resolve_i, CL)
    patch32(fail_after_resolve_j, CL)
    patch32(fail_after_resolve_k, CL)
    patch32(fail_init, CL)
    patch32(fail_device, CL)
    patch32(fail_ctx, CL)
    emit_mark_gpu_unavailable_x86("GPU unavailable: CUDA initialization failed\n")
    em(0x31); em(0xc0)
    em(0xe9)
    let after_fail = CL
    em32(0)

    patch32(already_ok, CL)
    emit_imm64(1)
    patch32(after_fail_no_lib, CL)
    patch32(after_success, CL)
    patch32(after_fail, CL)
    patch32(end_jmp, CL)
}

fn emit_load_gpu_thread_id_x86() with Mut {
    emit_load_abs_addr_to_rax_x86(GL_BSS_BASE + GPU_EMU_THREAD_ID_BSS_OFF)
    em(0x48); em(0x8b); em(0x00)
}

fn emit_store_gpu_thread_id_x86() with Mut {
    em(0x48); em(0x89); em(0xc1)
    emit_load_abs_addr_to_rax_x86(GL_BSS_BASE + GPU_EMU_THREAD_ID_BSS_OFF)
    em(0x48); em(0x89); em(0x08)
}

fn emit_load_rsp_arg_x86(reg_idx: i64, disp: i64) with Mut {
    if reg_idx == 0 { em(0x48); em(0x8b); em(0xbc); em(0x24); em32(disp); return }
    if reg_idx == 1 { em(0x48); em(0x8b); em(0xb4); em(0x24); em32(disp); return }
    if reg_idx == 2 { em(0x48); em(0x8b); em(0x94); em(0x24); em32(disp); return }
    if reg_idx == 3 { em(0x48); em(0x8b); em(0x8c); em(0x24); em32(disp); return }
    if reg_idx == 4 { em(0x4c); em(0x8b); em(0x84); em(0x24); em32(disp); return }
    if reg_idx == 5 { em(0x4c); em(0x8b); em(0x8c); em(0x24); em32(disp); return }
}

fn emit_setup_call_args_shift_x86(argc: i64, shift: i64) with Mut {
    var arg_idx: i64 = 0
    while arg_idx < argc && arg_idx + shift < 6 {
        emit_load_rsp_arg_x86(arg_idx + shift, (argc - 1 - arg_idx) * 8)
        arg_idx = arg_idx + 1
    }
}

fn emit_setup_direct_call_args_x86(argc: i64) with Mut {
    emit_setup_call_args_shift_x86(argc, 0)
}

fn emit_setup_closure_call_args_x86(argc: i64) with Mut {
    emit_setup_call_args_shift_x86(argc, 1)
}

fn call_extra_stack_args_x86(argc: i64, regc: i64) -> i64 {
    if argc > regc + 1 { return argc - regc }
    return 0
}

fn emit_sret_destination_x86(ret_slots: i64) with Mut, Panic, Div {
    if ret_slots * 8 >= local_bss_spill_bytes() {
        let sret_addr = GL_BSS_BASE + bss_alloc_aligned(ret_slots * 8)
        em(0x48); em(0xb8); em64(sret_addr)
        return
    }
    let ret_base = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + ret_slots
    em(0x48); em(0x8d); em(0x85)
    em32(0 - (ret_base + ret_slots - 1) * 8)
    return
}

fn emit_prepare_stack_call_args_x86(argc: i64, regc: i64) with Mut {
    let extra = call_extra_stack_args_x86(argc, regc)
    if extra <= 1 { return }
    let scratch_bytes = extra * 8
    if scratch_bytes < 128 {
        em(0x48); em(0x83); em(0xec); em(scratch_bytes)
    } else {
        em(0x48); em(0x81); em(0xec); em32(scratch_bytes)
    }
    var i: i64 = 0
    while i < extra {
        em(0x48); em(0x8b); em(0x84); em(0x24); em32(scratch_bytes + i * 8)
        let dst = (extra - 1 - i) * 8
        if dst == 0 {
            em(0x48); em(0x89); em(0x04); em(0x24)
        } else {
            em(0x48); em(0x89); em(0x84); em(0x24); em32(dst)
        }
        i = i + 1
    }
}

fn emit_direct_fn_call_x86(fi: i64, argc: i64) with Mut, Panic, Div {
    let ret_slots = ret_agg_nslots(FN_RET_TY[fi as usize], FN_RET_HASH[fi as usize])
    if ret_slots > 0 {
        emit_setup_call_args_shift_x86(argc, 1)
        emit_prepare_stack_call_args_x86(argc, 5)
        emit_sret_destination_x86(ret_slots)
        em(0x48); em(0x89); em(0xc7)
        em(0xe8)
        PATCH_OFF[PATCH_COUNT as usize] = CL
        PATCH_FN[PATCH_COUNT as usize] = fi
        PATCH_KIND[PATCH_COUNT as usize] = 0
        PATCH_COUNT = PATCH_COUNT + 1
        em32(0)
        emit_drop_call_args_x86(argc + call_extra_stack_args_x86(argc, 5))
        return
    }
    emit_setup_direct_call_args_x86(argc)
    emit_prepare_stack_call_args_x86(argc, 6)
    em(0xe8)
    PATCH_OFF[PATCH_COUNT as usize] = CL
    PATCH_FN[PATCH_COUNT as usize] = fi
    PATCH_KIND[PATCH_COUNT as usize] = 0
    PATCH_COUNT = PATCH_COUNT + 1
    em32(0)
    emit_drop_call_args_x86(argc + call_extra_stack_args_x86(argc, 6))
}

fn emit_indirect_fn_call_x86(ptr_slot: i64, argc: i64, ret_ty: i64, ret_hash: i64) with Mut, Panic, Div {
    let ret_slots = ret_agg_nslots(ret_ty, ret_hash)
    if ret_slots > 0 {
        emit_setup_call_args_shift_x86(argc, 1)
        emit_prepare_stack_call_args_x86(argc, 5)
        emit_sret_destination_x86(ret_slots)
        em(0x48); em(0x89); em(0xc7)
        emit_load_var(ptr_slot)
        em(0xff); em(0xd0)
        emit_drop_call_args_x86(argc + call_extra_stack_args_x86(argc, 5))
        return
    }
    emit_setup_direct_call_args_x86(argc)
    emit_prepare_stack_call_args_x86(argc, 6)
    emit_load_var(ptr_slot)
    em(0xff); em(0xd0)
    emit_drop_call_args_x86(argc + call_extra_stack_args_x86(argc, 6))
}

fn emit_drop_call_args_x86(argc: i64) with Mut {
    let bytes = argc * 8
    if bytes <= 0 { return }
    if bytes < 128 {
        em(0x48); em(0x83); em(0xc4); em(bytes)
    } else {
        em(0x48); em(0x81); em(0xc4); em32(bytes)
    }
}

fn emit_store_incoming_arg_x86(arg_idx: i64, slot: i64) with Mut {
    if arg_idx == 0 { em(0x48); em(0x89); em(0xf8); emit_store_var(slot); return }  // mov rax, rdi
    if arg_idx == 1 { em(0x48); em(0x89); em(0xf0); emit_store_var(slot); return }  // mov rax, rsi
    if arg_idx == 2 { em(0x48); em(0x89); em(0xd0); emit_store_var(slot); return }  // mov rax, rdx
    if arg_idx == 3 { em(0x48); em(0x89); em(0xc8); emit_store_var(slot); return }  // mov rax, rcx
    if arg_idx == 4 { em(0x4c); em(0x89); em(0xc0); emit_store_var(slot); return }  // mov rax, r8
    if arg_idx == 5 { em(0x4c); em(0x89); em(0xc8); emit_store_var(slot); return }  // mov rax, r9
    em(0x48); em(0x8b); em(0x85); em32(16 + (arg_idx - 6) * 8)
    emit_store_var(slot)
}

// Write 32-bit value at arbitrary offset in CD[] (for ARM64 branch patching)
fn em32_at(off: i64, v: i64) with Mut, Panic {
    CD[off as usize] = (v & 0xFF) as i8
    CD[(off + 1) as usize] = ((v >> 8) & 0xFF) as i8
    CD[(off + 2) as usize] = ((v >> 16) & 0xFF) as i8
    CD[(off + 3) as usize] = ((v >> 24) & 0xFF) as i8
}
fn record_frame_patch() with Mut {
    if FRAME_PATCH_COUNT < 4096 { FRAME_PATCH_OFF[FRAME_PATCH_COUNT as usize] = CL; FRAME_PATCH_COUNT = FRAME_PATCH_COUNT + 1 }
}

// Stack-clash guard. Emitted right after the prologue `sub rsp,<frame>`. Walks
// rax from rbp down to rsp, touching one byte per 4 KB page, so a multi-MB frame
// (the check phase threads a ~164 KB Checker by value, building 0.5–8 MB frames)
// cannot jump the kernel's stack guard gap and SIGSEGV on the first deep push.
// Position-independent (the two jump displacements are fixed within the sequence).
fn emit_stack_probe_x86() with Mut {
    em(0x48); em(0x89); em(0xe8)         // mov rax, rbp
    em(0x48); em(0x2d); em32(0x1000)     // sub rax, 0x1000
    em(0x48); em(0x39); em(0xe0)         // cmp rax, rsp
    em(0x76); em(0x05)                   // jbe +5  (skip the touch+loop once rax<=rsp)
    em(0x80); em(0x08); em(0x00)         // or byte ptr [rax], 0   (fault-in the page, value unchanged)
    em(0xeb); em(0xf0)                   // jmp -16 (back to `sub rax,0x1000`)
}

fn record_frame_patch_a64(rd: i64) with Mut {
    if A64_FRAME_PATCH_COUNT < 32768 {
        A64_FRAME_PATCH_OFF[A64_FRAME_PATCH_COUNT as usize] = CL
        A64_FRAME_PATCH_RD[A64_FRAME_PATCH_COUNT as usize] = rd
        A64_FRAME_PATCH_COUNT = A64_FRAME_PATCH_COUNT + 1
    }
}

// Read 32-bit value from CD[] (for ARM64 branch patching)
fn rd32_at(off: i64) -> i64 with Panic, Mut {
    return (CD[off as usize] as i64 & 0xFF) |
           ((CD[(off + 1) as usize] as i64 & 0xFF) << 8) |
           ((CD[(off + 2) as usize] as i64 & 0xFF) << 16) |
           ((CD[(off + 3) as usize] as i64 & 0xFF) << 24)
}

// ─── ARM64 emit helpers ───
fn emit_load_var_a64(slot: i64) with Mut, Panic {
    let off = slot * 8
    if off <= 4095 {
        // sub x9, x29, #off
        em32(0xD1000000 | (off << 10) | (29 << 5) | 9)
    } else {
        emit_imm64_reg_a64(9, off)
        // sub x9, x29, x9
        em32(0xCB090000 | (29 << 5) | 9)
    }
    // ldr x0, [x9]
    em32(0xF9400120)
}

fn emit_store_var_a64(slot: i64) with Mut, Panic {
    let off = slot * 8
    if off <= 4095 {
        em32(0xD1000000 | (off << 10) | (29 << 5) | 9)
    } else {
        emit_imm64_reg_a64(9, off)
        em32(0xCB090000 | (29 << 5) | 9)
    }
    // str x0, [x9]
    em32(0xF9000120)
}

// a64 twin of emit_bulk_copy_to_slots_x86: x0 = source pointer, copy `nslots`
// qwords to stack slots [base .. base+nslots-1] (slot base+nslots-1 at the
// lowest address = the returned pointer). emit_store_var_a64 clobbers x9, so the
// source pointer is kept in a temp slot and reloaded each iteration rather than
// held in a register.
fn emit_bulk_copy_to_slots_a64(nslots: i64, base: i64) with Mut, Panic, Div {
    // x0 = source pointer on entry. Copy nslots qwords into stack slots
    // [base .. base+nslots-1] (slot base+nslots-1 = lowest address), then leave
    // x0 = that base. Uses the runtime byte-copy loop (constant code size) — a
    // large aggregate element (e.g. a Checker-sized tuple field, ~500k slots)
    // must NOT unroll or it blows the code buffer.
    em32(0xAA0003E1)                     // mov x1, x0  (src)
    emit_lea_var_a64(base + nslots - 1)  // x0 = dst base (lowest slot address)
    emit_imm64_reg_a64(2, nslots * 8)    // x2 = byte count
    emit_memcpy_a64()                    // copy x2 bytes src(x1) -> dst(x0)
    emit_lea_var_a64(base + nslots - 1)  // x0 = dst base (memcpy advanced x0)
}

fn emit_push_a64() with Mut { em32(0xF81F0FE0) }  // str x0, [sp, #-16]!

fn emit_pop_x1_a64() with Mut { em32(0xF84107E1) }  // ldr x1, [sp], #16

fn emit_pop_x0_a64() with Mut { em32(0xF84107E0) }  // ldr x0, [sp], #16

fn emit_pop_x2_a64() with Mut { em32(0xF84107E2) }  // ldr x2, [sp], #16

fn emit_copy_words_x10_x11_a64(words: i64) with Mut {
    if words <= 0 { return }
    emit_imm64_reg_a64(12, words)
    let loop_off = CL
    em32(0xF940014D)  // ldr x13, [x10]
    em32(0xF900016D)  // str x13, [x11]
    em32(0x9100214A)  // add x10, x10, #8
    em32(0x9100216B)  // add x11, x11, #8
    em32(0xF100058C)  // subs x12, x12, #1
    let br_off = CL
    let rel = (loop_off - br_off) / 4
    em32(0x54000001 | ((rel & 0x7FFFF) << 5))  // b.ne loop
}

fn emit_zero_words_x11_a64(words: i64) with Mut {
    if words <= 0 { return }
    emit_imm64_reg_a64(12, words)
    em32(0xD280000D)  // mov x13, #0
    let loop_off = CL
    em32(0xF900016D)  // str x13, [x11]
    em32(0x9100216B)  // add x11, x11, #8
    em32(0xF100058C)  // subs x12, x12, #1
    let br_off = CL
    let rel = (loop_off - br_off) / 4
    em32(0x54000001 | ((rel & 0x7FFFF) << 5))  // b.ne loop
}

fn emit_fill_words_x13_x11_a64(words: i64) with Mut {
    if words <= 0 { return }
    emit_imm64_reg_a64(12, words)
    let loop_off = CL
    em32(0xF900016D)  // str x13, [x11]
    em32(0x9100216B)  // add x11, x11, #8
    em32(0xF100058C)  // subs x12, x12, #1
    let br_off = CL
    let rel = (loop_off - br_off) / 4
    em32(0x54000001 | ((rel & 0x7FFFF) << 5))  // b.ne loop
}

fn emit_drop_call_args_a64(argc: i64) with Mut {
    let bytes = argc * 16
    if bytes <= 0 { return }
    if bytes <= 4095 {
        em32(0x91000000 | ((bytes & 0xFFF) << 10) | (31 << 5) | 31)
        return
    }
    emit_imm64_reg_a64(9, bytes)
    em32(0x8B2963FF)  // add sp, sp, x9
}

// add sp, sp, #bytes  (arbitrary positive multiple of 8)
fn emit_add_sp_bytes_a64(bytes: i64) with Mut {
    if bytes <= 0 { return }
    if bytes <= 4095 {
        em32(0x91000000 | ((bytes & 0xFFF) << 10) | (31 << 5) | 31)
        return
    }
    emit_imm64_reg_a64(9, bytes)
    em32(0x8B2963FF)  // add sp, sp, x9
}

// Set up the AArch64 calling convention for a call whose `n` ABI args were each
// pushed as a 16-byte stack slot in source order (arg1 deepest, argN at [sp]).
// For n<=8 the args are popped into x0..x(n-1) exactly as before. For n>8 the
// first 8 args are loaded into x0..x7 (from the bottom of the pushed block) and
// args 9..n are repacked into 8-byte ABI stack slots at [sp] in order — without
// this, the old code popped the TOP 8 (args n-7..n) into the registers and left
// the rest mis-positioned, corrupting every >8-arg call (e.g. local_meta_add).
// Uses x10 as the repack scratch so an indirect target in x9 survives.
// Returns the byte count to drop AFTER the bl/blr (0 for n<=8; the pops drop it).
fn emit_setup_call_args_a64(n: i64) -> i64 with Mut {
    if n <= 8 {
        if n >= 8 { em32(0xF84107E7) }
        if n >= 7 { em32(0xF84107E6) }
        if n >= 6 { em32(0xF84107E5) }
        if n >= 5 { em32(0xF84107E4) }
        if n >= 4 { em32(0xF84107E3) }
        if n >= 3 { em32(0xF84107E2) }
        if n >= 2 { em32(0xF84107E1) }
        if n >= 1 { em32(0xF84107E0) }
        return 0
    }
    let stk = (n - 8) * 8
    let stk16 = (stk + 15) & (0 - 16)        // round up to 16 (keep sp aligned)
    em32(0xD10003FF | ((stk16 & 0xFFF) << 10))               // sub sp, sp, #stk16
    var r: i64 = 0
    while r < 8 {
        let off = stk16 + (n - 1 - r) * 16                   // arg(r+1), from bottom of pushed block
        em32(0xF9400000 | (((off / 8) & 0xFFF) << 10) | (31 << 5) | r)   // ldr x_r, [sp, #off]
        r = r + 1
    }
    var j: i64 = 0
    while j < n - 8 {
        let src = stk16 + (n - 9 - j) * 16                   // arg(9+j), source-order
        em32(0xF940000A | (((src / 8) & 0xFFF) << 10) | (31 << 5))       // ldr x10, [sp, #src]
        em32(0xF900000A | ((j & 0xFFF) << 10) | (31 << 5))              // str x10, [sp, #(j*8)]
        j = j + 1
    }
    return stk16 + n * 16
}

fn emit_direct_fn_call_a64(fi: i64, argc: i64) with Mut {
    if argc >= 8 { em32(0xF84107E7) }
    if argc >= 7 { em32(0xF84107E6) }
    if argc >= 6 { em32(0xF84107E5) }
    if argc >= 5 { em32(0xF84107E4) }
    if argc >= 4 { em32(0xF84107E3) }
    if argc >= 3 { emit_pop_x2_a64() }
    if argc >= 2 { emit_pop_x1_a64() }
    if argc >= 1 { emit_pop_x0_a64() }
    PATCH_OFF[PATCH_COUNT as usize] = CL
    PATCH_FN[PATCH_COUNT as usize] = fi
    PATCH_KIND[PATCH_COUNT as usize] = 0
    PATCH_COUNT = PATCH_COUNT + 1
    em32(0x94000000)
}

// Load 64-bit immediate into x0 via movz/movk chain
fn emit_imm64_a64(v: i64) with Mut {
    let v0 = v & 0xFFFF
    let v1 = (v >> 16) & 0xFFFF
    let v2 = (v >> 32) & 0xFFFF
    let v3 = (v >> 48) & 0xFFFF
    // movz x0, #v0
    em32(0xD2800000 | (v0 << 5))
    if v1 != 0 { em32(0xF2A00000 | (v1 << 5)) }        // movk x0, #v1, lsl #16
    if v2 != 0 { em32(0xF2C00000 | (v2 << 5)) }        // movk x0, #v2, lsl #32
    if v3 != 0 { em32(0xF2E00000 | (v3 << 5)) }        // movk x0, #v3, lsl #48
}

fn emit_store_incoming_arg_a64(arg_idx: i64, slot: i64) with Mut, Panic {
    if arg_idx == 0 { emit_store_var_a64(slot); return }
    if arg_idx == 1 { em32(0xAA0103E0); emit_store_var_a64(slot); return }
    if arg_idx == 2 { em32(0xAA0203E0); emit_store_var_a64(slot); return }
    if arg_idx == 3 { em32(0xAA0303E0); emit_store_var_a64(slot); return }
    if arg_idx == 4 { em32(0xAA0403E0); emit_store_var_a64(slot); return }
    if arg_idx == 5 { em32(0xAA0503E0); emit_store_var_a64(slot); return }
    if arg_idx == 6 { em32(0xAA0603E0); emit_store_var_a64(slot); return }
    if arg_idx == 7 { em32(0xAA0703E0); emit_store_var_a64(slot); return }
    let off_words = (16 + (arg_idx - 8) * 8) / 8
    em32(0xF9400000 | (off_words << 10) | (29 << 5) | 0)
    emit_store_var_a64(slot)
}

fn bind_array_local_from_x0_a64(ns: i64, ne: i64, ty_hash: i64) with Mut, Panic, Div {
    let esiz = arr_hash_esiz(ty_hash)
    let elem_ty = arr_hash_elem_ty(ty_hash)
    let nslots = arr_storage_slots(ty_hash)
    let ptr_slot = var_add_arr(ns, ne, nslots, esiz, elem_ty)
    if ptr_slot < 0 { return }
    let arr_vi = VAR_COUNT - 1
    let base = ptr_slot - nslots
    VAR_TY[arr_vi as usize] = 8
    VAR_TY_HASH[arr_vi as usize] = ty_hash
    em32(0xAA0003EA)  // mov x10, x0
    if LAST_LOCAL_BSS_SPILL != 0 {
        emit_image_addr_a64(LAST_LOCAL_BSS_ADDR)
        emit_copy_agg_to_ptr_a64(8, ty_hash)
    } else {
        emit_lea_var_a64(base + nslots - 1)
        em32(0xAA0003EB)  // mov x11, x0
        emit_copy_words_x10_x11_a64(nslots)
    }
    emit_store_var_a64(ptr_slot)
}

fn copy_array_into_local_slot_a64(slot: i64, ty_hash: i64) with Mut, Panic, Div {
    let nslots = arr_storage_slots(ty_hash)
    em32(0xAA0003EA)  // mov x10, x0 (src ptr)
    emit_load_var_a64(slot)
    em32(0xAA0003EB)  // mov x11, x0 (dst ptr)
    emit_copy_words_x10_x11_a64(nslots)
}

fn bind_struct_local_from_x0_a64(ns: i64, ne: i64, ty_hash: i64) with Mut, Panic, Div {
    let si = st_find(ty_hash)
    if si < 0 && knowledge_hash_is(ty_hash) == false {
        let slot = var_add(ns, ne)
        if slot < 0 { return }
        emit_store_var_a64(slot)
        let vix = VAR_COUNT - 1
        VAR_TY[vix as usize] = 6
        VAR_TY_HASH[vix as usize] = ty_hash
        return
    }
    let nslots = struct_like_nslots(ty_hash)
    var base: i64 = 0
    var spill_addr: i64 = 0
    let spill = nslots * 8 >= local_bss_spill_bytes()
    if spill {
        spill_addr = GL_BSS_BASE + bss_alloc_aligned(nslots * 8)
    } else {
        base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + nslots
    }
    let ptr_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    var linear_flag: i64 = 0
    if knowledge_hash_is(ty_hash) == false { linear_flag = ST_LINEAR[si as usize] }
    var out_ty: i64 = 0
    if knowledge_hash_is(ty_hash) == false { out_ty = 6 }
    if local_meta_add(ns, ne, ptr_slot, 0, 0, 8, 0, 0, 0, 0, linear_flag, 0, out_ty, ty_hash) < 0 {
        if spill == false { NEXT_SLOT = NEXT_SLOT - nslots }
        NEXT_SLOT = NEXT_SLOT - 1
        return
    }
    em32(0xAA0003EA)  // mov x10, x0
    if spill {
        emit_image_addr_a64(spill_addr)
        emit_copy_agg_to_ptr_a64(6, ty_hash)
        emit_image_addr_a64(spill_addr)
    } else {
        emit_lea_var_a64(base + nslots - 1)
        em32(0xAA0003EB)  // mov x11, x0
        emit_copy_words_x10_x11_a64(nslots)
    }
    emit_store_var_a64(ptr_slot)
}

// x0 = destination base address (lowest). Zero `nslots` qwords via a runtime
// loop (constant code) so a large struct local doesn't unroll. Clobbers x0, x2.
fn emit_zero_words_a64(nslots: i64) with Mut, Panic, Div {
    emit_imm64_reg_a64(2, nslots)  // x2 = count
    em32(0xB40000A2)  // loop: cbz x2, done (+5)
    em32(0xF900001F)  //       str xzr, [x0]
    em32(0x91002000)  //       add x0, x0, #8
    em32(0xD1000442)  //       sub x2, x2, #1
    em32(0x17FFFFFC)  //       b loop (-4)
    // done:
}

// a64 twin of bind_struct_local_zeroinit_x86: `var x: T` with no initializer —
// register the struct local and zero-fill its slots.
fn bind_struct_local_zeroinit_a64(ns: i64, ne: i64, ty_hash: i64) with Mut, Panic, Div {
    let si = st_find(ty_hash)
    if si < 0 && knowledge_hash_is(ty_hash) == false {
        let slot = var_add(ns, ne)
        if slot < 0 { return }
        em32(0xD2800000)  // mov x0, #0
        emit_store_var_a64(slot)
        let vix = VAR_COUNT - 1
        VAR_TY[vix as usize] = 6
        VAR_TY_HASH[vix as usize] = ty_hash
        return
    }
    let nslots = struct_like_nslots(ty_hash)
    var base: i64 = 0
    var spill_addr: i64 = 0
    let spill = nslots * 8 >= local_bss_spill_bytes()
    if spill {
        spill_addr = GL_BSS_BASE + bss_alloc_aligned(nslots * 8)
    } else {
        base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + nslots
    }
    let ptr_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    var linear_flag: i64 = 0
    if knowledge_hash_is(ty_hash) == false { linear_flag = ST_LINEAR[si as usize] }
    var out_ty: i64 = 0
    if knowledge_hash_is(ty_hash) == false { out_ty = 6 }
    if local_meta_add(ns, ne, ptr_slot, 0, 0, 8, 0, 0, 0, 0, linear_flag, 0, out_ty, ty_hash) < 0 {
        if spill == false { NEXT_SLOT = NEXT_SLOT - nslots }
        NEXT_SLOT = NEXT_SLOT - 1
        return
    }
    if spill {
        emit_image_addr_a64(spill_addr)      // x0 = spill base
        emit_zero_words_a64(nslots)
        emit_image_addr_a64(spill_addr)      // x0 = spill base pointer
    } else {
        emit_lea_var_a64(base + nslots - 1)  // x0 = slots base (lowest addr)
        emit_zero_words_a64(nslots)
        emit_lea_var_a64(base + nslots - 1)  // x0 = base pointer (zero loop advanced x0)
    }
    emit_store_var_a64(ptr_slot)
}

fn copy_struct_into_local_slot_a64(slot: i64, ty_hash: i64) with Mut, Panic, Div {
    let si = st_find(ty_hash)
    if si < 0 && knowledge_hash_is(ty_hash) == false { emit_store_var_a64(slot); return }
    let nslots = struct_like_nslots(ty_hash)
    em32(0xAA0003EA)  // mov x10, x0 (src ptr)
    emit_load_var_a64(slot)
    em32(0xAA0003EB)  // mov x11, x0 (dst ptr)
    emit_copy_words_x10_x11_a64(nslots)
}

fn materialize_aggregate_expr_a64() with Mut, Panic, Div {
    if EXPR_TY == 8 {
        let nslots = arr_storage_slots(EXPR_TY_HASH)
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + nslots
        em32(0xAA0003EA)  // mov x10, x0
        emit_lea_var_a64(base + nslots - 1)
        em32(0xAA0003EB)  // mov x11, x0
        emit_copy_words_x10_x11_a64(nslots)
        return
    }
    if type_is_option_inline(EXPR_TY, EXPR_TY_HASH) {
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 2
        em32(0xAA0003EA)
        emit_lea_var_a64(base + 1)
        em32(0xAA0003EB)
        emit_copy_words_x10_x11_a64(2)
        return
    }
    if type_is_struct_like(EXPR_TY, EXPR_TY_HASH) {
        let nslots = struct_like_nslots(EXPR_TY_HASH)
        if nslots <= 0 { return }
        if nslots * 8 >= local_bss_spill_bytes() {
            let tmp_addr = GL_BSS_BASE + bss_alloc_aligned(nslots * 8)
            em32(0xAA0003EA)  // mov x10, x0
            emit_image_addr_a64(tmp_addr)
            emit_copy_agg_to_ptr_a64(EXPR_TY, EXPR_TY_HASH)
            emit_image_addr_a64(tmp_addr)
            return
        }
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + nslots
        em32(0xAA0003EA)  // mov x10, x0
        emit_lea_var_a64(base + nslots - 1)
        em32(0xAA0003EB)  // mov x11, x0
        emit_copy_words_x10_x11_a64(nslots)
    }
}

fn copy_agg_into_struct_slots_a64(dst_start: i64, field_ty: i64, field_hash: i64) with Mut, Panic, Div {
    // dst_start is the struct's HIGH slot number for this field (element 0 /
    // lowest address, matching the same "highest slot = lowest address =
    // element 0" convention the struct-literal caller already uses when it
    // computes dst_start). emit_copy_words_x10_x11_a64 walks upward in
    // ADDRESS (i.e. DOWNWARD in slot number) for `words` iterations, so
    // starting at dst_start already visits dst_start, dst_start-1, ...,
    // dst_start-(words-1) in order — exactly the x86-64 twin's per-element
    // `dst_start - i` addressing (copy_agg_into_struct_slots_x86). A prior
    // version of this function pre-subtracted (words-1) from the starting
    // slot here, which shifted the entire write into the wrong slot range —
    // e.g. an 8-slot array field's copy landed 7 slots away from where
    // every reader (field access, `.field[idx]`) expects it, corrupting
    // whatever unrelated stack data happened to occupy the wrong range and,
    // for large aggregates, segfaulting outright.
    if field_ty == 8 {
        let nslots = arr_storage_slots(field_hash)
        em32(0xAA0003EA)
        emit_lea_var_a64(dst_start)
        em32(0xAA0003EB)
        emit_copy_words_x10_x11_a64(nslots)
        return
    }
    if type_is_option_inline(field_ty, field_hash) {
        em32(0xAA0003EA)
        emit_lea_var_a64(dst_start)
        em32(0xAA0003EB)
        emit_copy_words_x10_x11_a64(2)
        return
    }
    if type_is_struct_like(field_ty, field_hash) || knowledge_hash_is(field_hash) {
        let nslots = struct_like_nslots(field_hash)
        if nslots > 0 {
            em32(0xAA0003EA)
            emit_lea_var_a64(dst_start)
            em32(0xAA0003EB)
            emit_copy_words_x10_x11_a64(nslots)
            return
        }
    }
    emit_store_var_a64(dst_start)
}

fn emit_copy_agg_to_ptr_a64(field_ty: i64, field_hash: i64) with Mut, Panic, Div {
    var nslots: i64 = 0
    if field_ty == 8 {
        nslots = arr_storage_slots(field_hash)
    } else if type_is_option_inline(field_ty, field_hash) {
        nslots = 2
    } else if type_is_struct_like(field_ty, field_hash) || knowledge_hash_is(field_hash) {
        nslots = struct_like_nslots(field_hash)
    }
    if nslots <= 0 { return }
    em32(0xAA0003EB)  // mov x11, x0
    emit_copy_words_x10_x11_a64(nslots)
}

fn emit_store_to_pointer_offset_a64(lslot: i64, byte_off: i64, target_ty: i64, target_hash: i64) with Mut, Panic, Div {
    if type_is_aggregate(target_ty, target_hash) {
        em32(0xAA0003EA)  // mov x10, x0 (source aggregate pointer)
        emit_load_var_a64(lslot)
        if byte_off != 0 {
            emit_imm64_reg_a64(11, byte_off)
            em32(0x8B0B0000)  // add x0, x0, x11
        }
        emit_copy_agg_to_ptr_a64(target_ty, target_hash)
        return
    }
    em32(0xAA0003EA)  // mov x10, x0 (scalar value)
    emit_load_var_a64(lslot)
    if byte_off != 0 {
        emit_imm64_reg_a64(11, byte_off)
        em32(0x8B0B0000)  // add x0, x0, x11
    }
    em32(0xF900000A)  // str x10, [x0]
    return
}

fn fill_repeat_struct_array_slots_a64(dst_start: i64, field_hash: i64) with Mut, Panic, Div {
    let nslots = arr_storage_slots(field_hash)
    let elem_hash = arr_hash_elem_hash(field_hash)
    if elem_hash != 0 {
        let elem_nslots = struct_like_nslots(elem_hash)
        if elem_nslots > 0 {
            let src_slot = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var_a64(src_slot)
            var j: i64 = 0
            while j < nslots {
                emit_imm64_a64(elem_nslots * 8)
                emit_heap_alloc_a64()
                em32(0xAA0003EB)  // mov x11, x0 (dest)
                emit_load_var_a64(src_slot)
                em32(0xAA0003EA)  // mov x10, x0 (source)
                em32(0xAA0B03E0)  // mov x0, x11 (dest)
                emit_copy_agg_to_ptr_a64(6, elem_hash)
                emit_store_var_a64(dst_start - j)
                j = j + 1
            }
            return
        }
    }
    var i: i64 = 0
    while i < nslots {
        emit_store_var_a64(dst_start - i)
        i = i + 1
    }
}

fn stabilize_return_agg_a64(expr_ty: i64, expr_hash: i64) with Mut, Panic, Div {
    var nslots = ret_agg_nslots(CURRENT_RET_TY, CURRENT_RET_HASH)
    if nslots <= 0 { nslots = ret_agg_nslots(expr_ty, expr_hash) }
    if nslots <= 0 { return }
    em32(0xAA0003EA)  // mov x10, x0 (src ptr)
    emit_image_addr_reg_a64(11, GL_BSS_BASE + RET_AGG_BSS_OFF)
    emit_copy_words_x10_x11_a64(nslots)
    emit_image_addr_a64(GL_BSS_BASE + RET_AGG_BSS_OFF)
}

// Load 64-bit immediate into arbitrary register
fn emit_imm64_reg_a64(rd: i64, v: i64) with Mut {
    let v0 = v & 0xFFFF
    let v1 = (v >> 16) & 0xFFFF
    let v2 = (v >> 32) & 0xFFFF
    let v3 = (v >> 48) & 0xFFFF
    em32(0xD2800000 | (v0 << 5) | rd)
    if v1 != 0 { em32(0xF2A00000 | (v1 << 5) | rd) }
    if v2 != 0 { em32(0xF2C00000 | (v2 << 5) | rd) }
    if v3 != 0 { em32(0xF2E00000 | (v3 << 5) | rd) }
}

fn emit_imm64_reg_a64_patchable(rd: i64) with Mut {
    record_frame_patch_a64(rd)
    em32(0xD2800000 | rd)
    em32(0xF2A00000 | rd)
    em32(0xF2C00000 | rd)
    em32(0xF2E00000 | rd)
}

fn patch_imm64_reg_a64(off: i64, rd: i64, v: i64) with Mut, Panic {
    let v0 = v & 0xFFFF
    let v1 = (v >> 16) & 0xFFFF
    let v2 = (v >> 32) & 0xFFFF
    let v3 = (v >> 48) & 0xFFFF
    em32_at(off, 0xD2800000 | (v0 << 5) | rd)
    em32_at(off + 4, 0xF2A00000 | (v1 << 5) | rd)
    em32_at(off + 8, 0xF2C00000 | (v2 << 5) | rd)
    em32_at(off + 12, 0xF2E00000 | (v3 << 5) | rd)
}

fn macho_arm64_code_vm_base() -> i64 {
    4294967296 + 16384
}

fn emit_image_addr_reg_a64(rd: i64, v: i64) with Mut {
    if TARGET_OS == 2 {
        let pc = macho_arm64_code_vm_base() + CL
        let pc_page = (pc >> 12) << 12
        let target_page = (v >> 12) << 12
        let page_delta = (target_page - pc_page) >> 12
        let immlo = page_delta & 3
        let immhi = (page_delta >> 2) & 0x7FFFF
        em32(0x90000000 | ((immlo & 3) << 29) | ((immhi & 0x7FFFF) << 5) | rd)
        let pageoff = v & 0xFFF
        if pageoff != 0 {
            em32(0x91000000 | ((pageoff & 0xFFF) << 10) | (rd << 5) | rd)
        }
    } else {
        emit_imm64_reg_a64(rd, v)
    }
}

fn emit_image_addr_a64(v: i64) with Mut {
    emit_image_addr_reg_a64(0, v)
}

// a64 twin of emit_load_abs_qword_to_rax_x86: x0 = qword at absolute image addr.
fn emit_load_abs_qword_a64(addr: i64) with Mut {
    emit_image_addr_a64(addr)  // x0 = addr
    em32(0xF9400000)           // ldr x0, [x0]
}

// a64 twin of emit_store_rax_to_abs_qword_x86: [addr] = x0 (x0 preserved; x9 scratch).
fn emit_store_x0_to_abs_qword_a64(addr: i64) with Mut {
    emit_image_addr_reg_a64(9, addr)  // x9 = addr (does not touch x0)
    em32(0xF9000120)                  // str x0, [x9]
}

// a64 twin of the x86 __arena_reset chunk-walk (compile_primary :~12331). x0 = the
// mark m on entry. If m is in the current chunk [base, limit], cursor = m; else the
// current chunk is younger than the mark and dead — follow its {prev_base,prev_limit}
// back-link header, munmap it, and repeat. Terminator (prev_base==0, invalid mark):
// recycle the initial chunk (cursor = base+16). munmap number is arm64/OS-specific
// (macOS x16=73 / Linux x8=215), unlike the x86 twin's eax=11.
fn emit_arena_reset_a64() with Mut, Panic, Div {
    em32(0xAA0003ED)  // mov x13, x0  (x13 = m; survives svc)
    let arst_loop = CL
    emit_load_abs_qword_a64(GL_BSS_BASE + AST_ARENA_BASE_BSS_OFF)   // x0 = base
    em32(0xEB0001BF)  // cmp x13, x0
    let arst_walk1 = CL
    em32(0x54000003)  // b.lo walk  (m < base)
    emit_load_abs_qword_a64(GL_BSS_BASE + AST_ARENA_LIMIT_BSS_OFF)  // x0 = limit
    em32(0xEB0001BF)  // cmp x13, x0
    let arst_walk2 = CL
    em32(0x54000008)  // b.hi walk  (m > limit)
    // in range: cursor = m
    em32(0xAA0D03E0)  // mov x0, x13
    emit_store_x0_to_abs_qword_a64(GL_BSS_BASE + AST_ARENA_CURSOR_BSS_OFF)
    let arst_done1 = CL
    em32(0x14000000)  // b done
    // walk: current chunk is dead — follow back-link, munmap
    patch_branch_a64(arst_walk1, CL)
    patch_branch_a64(arst_walk2, CL)
    emit_load_abs_qword_a64(GL_BSS_BASE + AST_ARENA_BASE_BSS_OFF)   // x0 = base
    em32(0xAA0003EE)  // mov x14, x0  (x14 = base = munmap addr)
    em32(0xF94001CF)  // ldr x15, [x14]  (prev_base)
    let arst_do_unmap = CL
    em32(0xB500000F)  // cbnz x15, do_unmap
    // terminator: invalid mark — recycle initial chunk, keep it mapped
    em32(0x910041C0)  // add x0, x14, #16
    emit_store_x0_to_abs_qword_a64(GL_BSS_BASE + AST_ARENA_CURSOR_BSS_OFF)
    let arst_done2 = CL
    em32(0x14000000)  // b done
    // do_unmap:
    patch_branch_a64(arst_do_unmap, CL)
    em32(0xF94001C9)  // ldr x9, [x14]     (prev_base)
    em32(0xF94005CA)  // ldr x10, [x14,#8] (prev_limit)
    emit_load_abs_qword_a64(GL_BSS_BASE + AST_ARENA_LIMIT_BSS_OFF)  // x0 = limit
    em32(0xCB0E0001)  // sub x1, x0, x14   (len = limit - base)
    em32(0xAA0E03E0)  // mov x0, x14       (munmap addr = base)
    if TARGET_OS == 2 { emit_imm64_reg_a64(16, 73) }
    else { em32(0xD2800000 | ((215 & 0xFFFF) << 5) | 8) }  // movz x8, #215 (SYS_munmap Linux arm64)
    emit_syscall_a64()
    em32(0xAA0903E0)  // mov x0, x9   (prev_base)
    emit_store_x0_to_abs_qword_a64(GL_BSS_BASE + AST_ARENA_BASE_BSS_OFF)
    em32(0xAA0A03E0)  // mov x0, x10  (prev_limit)
    emit_store_x0_to_abs_qword_a64(GL_BSS_BASE + AST_ARENA_LIMIT_BSS_OFF)
    em32(0x14000000 | (((arst_loop - CL) / 4) & 0x3FFFFFF))  // b loop
    // done:
    patch_branch_a64(arst_done1, CL)
    patch_branch_a64(arst_done2, CL)
    em32(0xD2800000)  // mov x0, #0
}

// Patch ARM64 branch instruction at off to jump to target
fn patch_branch_a64(off: i64, target: i64) with Mut, Panic {
    let rel = (target - off) / 4
    let insn = rd32_at(off)
    let top = (insn >> 24) & 0xFF
    if top == 0x14 || top == 0x94 || top == 0x17 || top == 0x97 {
        // B or BL: 26-bit offset in bits [25:0]
        em32_at(off, (insn & 0xFC000000) | (rel & 0x3FFFFFF))
    } else {
        // B.cond / CBZ / CBNZ: 19-bit offset in bits [23:5]
        em32_at(off, (insn & 0xFF00001F) | ((rel & 0x7FFFF) << 5))
    }
}

fn patch_adr_a64(off: i64, target: i64, rd: i64) with Mut, Panic {
    let rel = target - off
    let immlo = rel & 0x3
    let immhi = (rel >> 2) & 0x7FFFF
    em32_at(off, 0x10000000 | ((immlo & 0x3) << 29) | ((immhi & 0x7FFFF) << 5) | rd)
}

// ARM64 PC-relative address of a code-buffer target: adr rd, target
fn emit_adr_local_a64(target: i64, rd: i64) with Mut {
    let rel = target - CL
    let immlo = rel & 0x3
    let immhi = (rel >> 2) & 0x7FFFF
    em32(0x10000000 | ((immlo & 0x3) << 29) | ((immhi & 0x7FFFF) << 5) | rd)
}

// ARM64 address-of variable: lea x0, [x29 - slot*8]
fn emit_lea_var_a64(slot: i64) with Mut, Panic {
    let off = slot * 8
    if off <= 4095 {
        // sub x0, x29, #off
        em32(0xD1000000 | (off << 10) | (29 << 5) | 0)
    } else {
        emit_imm64_reg_a64(0, off)
        em32(0xCB000000 | (29 << 5) | 0)  // sub x0, x29, x0
    }
}

fn src_match(p: i64, l: i64, kw: string) -> bool with Panic, Mut {
    if l != str_len(kw) { return false }
    var i: i64 = 0
    while i < l { if sb(p + i) != str_char_at(kw, i) { return false }; i = i + 1 }
    return true
}

// Compare two source regions byte-for-byte (for struct field collision resolution)
fn src_region_eq(p1: i64, l1: i64, p2: i64, l2: i64) -> bool with Panic, Mut {
    if l1 != l2 { return false }
    var i: i64 = 0
    while i < l1 { if sb(p1 + i) != sb(p2 + i) { return false }; i = i + 1 }
    return true
}

fn token_is_kernel_marker(ti: i64) -> bool with Panic, Mut {
    if ti < 0 || ti >= TC { return false }
    // Gen 20: Door 2 — kernel is now TK=79 (dedicated keyword token)
    if TK[ti as usize] == 79 { return true }
    // Fallback: also accept TK=3 with text "kernel" for older token streams
    if TK[ti as usize] != 3 { return false }
    return src_match(TS[ti as usize], TE[ti as usize] - TS[ti as usize], "kernel")
}

fn token_is_ident_text(ti: i64, text: string) -> bool with Panic, Mut {
    if ti < 0 || ti >= TC { return false }
    if TK[ti as usize] != 3 { return false }
    return src_match(TS[ti as usize], TE[ti as usize] - TS[ti as usize], text)
}

fn token_is_gpu_builtin_name(ti: i64) -> bool with Panic, Mut {
    if ti < 0 || ti >= TC { return false }
    if TK[ti as usize] != 3 { return false }
    let ns = TS[ti as usize]
    let ne = TE[ti as usize]
    if src_match(ns, ne - ns, "gpu_thread_id_x") { return true }
    if src_match(ns, ne - ns, "gpu_thread_id_y") { return true }
    if src_match(ns, ne - ns, "gpu_thread_id_z") { return true }
    if src_match(ns, ne - ns, "gpu_block_id_x") { return true }
    if src_match(ns, ne - ns, "gpu_block_id_y") { return true }
    if src_match(ns, ne - ns, "gpu_block_id_z") { return true }
    if src_match(ns, ne - ns, "gpu_block_dim_x") { return true }
    if src_match(ns, ne - ns, "gpu_block_dim_y") { return true }
    if src_match(ns, ne - ns, "gpu_block_dim_z") { return true }
    if src_match(ns, ne - ns, "gpu_barrier") { return true }
    if src_match(ns, ne - ns, "gpu_barrier_sync") { return true }
    if src_match(ns, ne - ns, "gpu_sync_threads") { return true }
    return false
}

fn kernel_body_uses_gpu_builtins(body_start: i64) -> i64 with Panic, Mut {
    var p: i64 = body_start
    var depth: i64 = 1
    while p < TC && depth > 0 {
        if TK[p as usize] == 8 {
            depth = depth + 1
        } else if TK[p as usize] == 9 {
            depth = depth - 1
        } else if token_is_gpu_builtin_name(p) {
            return 1
        }
        p = p + 1
    }
    return 0
}

fn current_fn_allows_mutation() -> bool with Panic, Mut {
    if FN_IS_KERNEL[CURRENT_FN as usize] != 0 { return true }
    return (FN_EFFECTS[CURRENT_FN as usize] & 2) != 0
}

fn stmt_is_gpu_launch_perform(p0: i64) -> bool with Panic, Mut {
    if token_is_ident_text(p0, "perform") == false { return false }
    if token_is_ident_text(p0 + 1, "GPU") == false { return false }
    if TK[(p0 + 2) as usize] != 50 { return false }
    if token_is_ident_text(p0 + 3, "launch") == false { return false }
    return TK[(p0 + 4) as usize] == 6
}

fn stmt_is_gpu_sync_perform(p0: i64) -> bool with Panic, Mut {
    if token_is_ident_text(p0, "perform") == false { return false }
    if token_is_ident_text(p0 + 1, "GPU") == false { return false }
    if TK[(p0 + 2) as usize] != 50 { return false }
    if token_is_ident_text(p0 + 3, "sync") == false { return false }
    return TK[(p0 + 4) as usize] == 6
}

fn tok_is_unicode_epsilon(p: i64) -> bool with Panic, Mut {
    if TK[p as usize] != 3 { return false }
    let ns = TS[p as usize]
    let ne = TE[p as usize]
    if ne - ns != 2 { return false }
    return sb(ns) == 206 && sb(ns + 1) == 181
}

fn tok_is_unicode_bottom(p: i64) -> bool with Panic, Mut {
    if TK[p as usize] != 3 { return false }
    let ns = TS[p as usize]
    let ne = TE[p as usize]
    if ne - ns != 3 { return false }
    if sb(ns) != 226 || sb(ns + 1) != 138 { return false }
    return sb(ns + 2) == 165
}

fn cli_arg_eq(raw: string, kw: string) -> bool with Panic, Mut {
    let l = str_len(kw)
    if str_len(raw) != l { return false }
    var i: i64 = 0
    while i < l {
        if str_char_at(raw, i) != str_char_at(kw, i) { return false }
        i = i + 1
    }
    return true
}

fn name_is_lower(ns: i64, ne: i64) -> bool with Panic, Mut {
    if ne <= ns { return false }
    let c = sb(ns)
    return c >= 97 && c <= 122
}

fn name_eq(s1: i64, e1: i64, s2: i64, e2: i64) -> bool with Panic, Mut {
    let l = e1 - s1
    if l != e2 - s2 { return false }
    var i: i64 = 0
    while i < l { if sb(s1 + i) != sb(s2 + i) { return false }; i = i + 1 }
    return true
}

fn ty_is_numeric(k: i64) -> bool { return k == 1 || k == 2 }

fn tok_is_effect_name(p: i64) -> bool with Panic, Mut {
    if TK[p as usize] != 3 { return false }
    let ns = TS[p as usize]
    let ne = TE[p as usize]
    if src_match(ns, ne - ns, "IO") { return true }
    if src_match(ns, ne - ns, "Mut") { return true }
    if src_match(ns, ne - ns, "Panic") { return true }
    if src_match(ns, ne - ns, "Div") { return true }
    if src_match(ns, ne - ns, "Alloc") { return true }
    if src_match(ns, ne - ns, "Observe") { return true }
    if src_match(ns, ne - ns, "Audit") { return true }
    if src_match(ns, ne - ns, "Hypothesis") { return true }
    if src_match(ns, ne - ns, "MultiTest") { return true }
    if src_match(ns, ne - ns, "ZD") { return true }
    if src_match(ns, ne - ns, "Approx") { return true }
    if src_match(ns, ne - ns, "Causal") { return true }
    if src_match(ns, ne - ns, "NaturalityG2") { return true }
    return false
}

fn arr_ty_hash(alen: i64, esiz: i64, elem_ty: i64) -> i64 {
    if esiz == 1 { return alen * 32 + elem_ty * 2 + 1 }
    return alen * 32 + elem_ty * 2
}

fn arr_hash_ext_base() -> i64 {
    return 1000000000000
}

fn arr_hash_ext_alen_scale() -> i64 {
    return 10000000000
}

fn arr_hash_is_ext(h: i64) -> bool {
    return h >= arr_hash_ext_base()
}

fn arr_ty_hash_with_elem(alen: i64, esiz: i64, elem_ty: i64, elem_hash: i64) -> i64 with Mut {
    if elem_hash == 0 { return arr_ty_hash(alen, esiz, elem_ty) }
    // Search existing side-table entries for a match
    var i: i64 = 0
    while i < EXT_ARR_COUNT {
        if EXT_ARR_ALEN[i as usize] == alen
            && EXT_ARR_ESIZ[i as usize] == esiz
            && EXT_ARR_ELEM_TY[i as usize] == elem_ty
            && EXT_ARR_ELEM_HASH[i as usize] == elem_hash {
            return arr_hash_ext_base() + i
        }
        i = i + 1
    }
    // Guard overflow — table has 4096 slots
    if EXT_ARR_COUNT >= 4096 { return arr_ty_hash(alen, esiz, elem_ty) }
    // Register new entry
    EXT_ARR_ALEN[EXT_ARR_COUNT as usize]      = alen
    EXT_ARR_ESIZ[EXT_ARR_COUNT as usize]      = esiz
    EXT_ARR_ELEM_TY[EXT_ARR_COUNT as usize]   = elem_ty
    EXT_ARR_ELEM_HASH[EXT_ARR_COUNT as usize] = elem_hash
    let idx = EXT_ARR_COUNT
    EXT_ARR_COUNT = EXT_ARR_COUNT + 1
    return arr_hash_ext_base() + idx
}

fn arr_ty_hash_for_elem_type(alen: i64, esiz: i64, elem_ty: i64, elem_hash: i64) -> i64 with Panic, Mut {
    if elem_hash != 0 {
        if elem_ty == 6 || elem_ty == 7 { return arr_ty_hash_with_elem(alen, esiz, elem_ty, elem_hash) }
        if elem_ty == 0 && st_find(elem_hash) >= 0 { return arr_ty_hash_with_elem(alen, esiz, elem_ty, elem_hash) }
        // Knowledge<T> element (kind=7, negative hash): preserve the element hash in
        // the side table so `arr[i]` recovers its Knowledge type. The by-value
        // struct-array machinery already sizes it via struct_like_nslots()==3.
        if elem_ty == 0 && knowledge_hash_is(elem_hash) { return arr_ty_hash_with_elem(alen, esiz, elem_ty, elem_hash) }
    }
    return arr_ty_hash(alen, esiz, elem_ty)
}

fn arr_hash_payload(h: i64) -> i64 {
    if arr_hash_is_ext(h) { return h - arr_hash_ext_base() }
    return h
}

fn arr_hash_remainder(h: i64) -> i64 with Div, Mut {
    let payload = arr_hash_payload(h)
    if arr_hash_is_ext(h) {
        let alen = payload / arr_hash_ext_alen_scale()
        return payload - alen * arr_hash_ext_alen_scale()
    }
    return payload
}

fn arr_hash_is_real_ext(h: i64) -> bool with Mut {
    if arr_hash_is_ext(h) == false { return false }
    let idx = arr_hash_payload(h)
    return idx >= 0 && idx < EXT_ARR_COUNT
}

fn arr_hash_alen(h: i64) -> i64 with Div, Mut {
    if arr_hash_is_real_ext(h) {
        let idx = arr_hash_payload(h)
        return EXT_ARR_ALEN[idx as usize]
    }
    if arr_hash_is_ext(h) { return arr_hash_payload(h) / arr_hash_ext_alen_scale() }
    return h / 32
}

fn arr_hash_esiz(h: i64) -> i64 with Div, Mut {
    if arr_hash_is_real_ext(h) {
        let idx = arr_hash_payload(h)
        return EXT_ARR_ESIZ[idx as usize]
    }
    if arr_hash_remainder(h) % 2 == 1 { return 1 }
    return 8
}

fn arr_hash_elem_ty(h: i64) -> i64 with Div, Mut {
    if arr_hash_is_real_ext(h) {
        let idx = arr_hash_payload(h)
        return EXT_ARR_ELEM_TY[idx as usize]
    }
    return (arr_hash_remainder(h) % 32) / 2
}

fn arr_hash_elem_hash(h: i64) -> i64 with Div, Mut {
    if arr_hash_is_real_ext(h) == false { return 0 }
    let idx = arr_hash_payload(h)
    return EXT_ARR_ELEM_HASH[idx as usize]
}

fn arr_storage_slots(h: i64) -> i64 with Div, Mut {
    let alen = arr_hash_alen(h)
    if arr_hash_esiz(h) == 1 { return (alen + 7) / 8 }
    return alen
}

fn array_lit_count(p0: i64) -> i64 with Panic, Mut {
    var p = p0 + 1
    var br: i64 = 1
    var pa: i64 = 0
    var cu: i64 = 0
    var commas: i64 = 0
    var has_elem: i64 = 0
    while p < TC && br > 0 {
        let k = TK[p as usize]
        if br == 1 && pa == 0 && cu == 0 {
            if k == 28 { commas = commas + 1 }
            else if k != 42 { has_elem = 1 }
        }
        if k == 6 { pa = pa + 1 }
        if k == 7 { pa = pa - 1 }
        if k == 8 { cu = cu + 1 }
        if k == 9 { cu = cu - 1 }
        if k == 41 { br = br + 1 }
        if k == 42 { br = br - 1 }
        p = p + 1
    }
    if has_elem == 0 { return 0 }
    return commas + 1
}

fn array_init_is_repeat(p0: i64) -> bool with Panic, Mut {
    var p = p0 + 1
    var br: i64 = 1
    var pa: i64 = 0
    var cu: i64 = 0
    while p < TC && br > 0 {
        let k = TK[p as usize]
        if br == 1 && pa == 0 && cu == 0 && k == 27 { return true }
        if k == 6 { pa = pa + 1 }
        if k == 7 { pa = pa - 1 }
        if k == 8 { cu = cu + 1 }
        if k == 9 { cu = cu - 1 }
        if k == 41 { br = br + 1 }
        if k == 42 { br = br - 1 }
        p = p + 1
    }
    return false
}

fn knowledge_hash_is(h: i64) -> bool {
    return h < 0
}

fn unobserved_hash_base() -> i64 {
    return 2251799813685248
}

fn unobserved_hash_make(inner_ty: i64, inner_hash: i64) -> i64 {
    return unobserved_hash_base() + inner_ty * 64 + inner_hash * 4096
}

fn unobserved_hash_is(h: i64) -> bool {
    return h >= unobserved_hash_base()
}

fn unobserved_hash_inner_ty(h: i64) -> i64 with Panic, Div, Mut {
    return ((h - unobserved_hash_base()) / 64) % 64
}

fn unobserved_hash_inner_hash(h: i64) -> i64 with Panic, Div, Mut {
    return (h - unobserved_hash_base()) / 4096
}

fn knowledge_hash_make_mode(inner_ty: i64, inner_hash: i64, meta_mode: i64, eps_scaled: i64) -> i64 {
    let eps_code =
        if eps_scaled < -1 { 0 }
        else { if eps_scaled >= 0 { eps_scaled + 2 } else { 1 } }
    let packed_ty = inner_ty + meta_mode * 16
    let packed = eps_code + (packed_ty * 1048576) + (inner_hash * 67108864)
    return 0 - packed
}

fn knowledge_hash_make(inner_ty: i64, inner_hash: i64, eps_scaled: i64) -> i64 {
    return knowledge_hash_make_mode(inner_ty, inner_hash, 0, eps_scaled)
}

fn knowledge_hash_inner_ty(h: i64) -> i64 with Panic, Mut {
    let packed = 0 - h
    return ((packed / 1048576) % 64) % 16
}

fn knowledge_hash_meta_mode(h: i64) -> i64 with Panic, Mut {
    let packed = 0 - h
    return ((packed / 1048576) % 64) / 16
}

fn knowledge_hash_inner_hash(h: i64) -> i64 with Panic, Mut {
    let packed = 0 - h
    return packed / 67108864
}

fn knowledge_hash_eps(h: i64) -> i64 with Panic, Mut {
    let packed = 0 - h
    let eps_code = packed % 1048576
    if eps_code == 0 { return -2 }
    if eps_code == 1 { return -1 }
    return eps_code - 2
}

fn knowledge_hash_invalid(h: i64) -> bool with Panic, Mut {
    if knowledge_hash_is(h) == false { return false }
    return knowledge_hash_eps(h) < -1
}

fn knowledge_struct_hash() -> i64 {
    return 9 * 1000003
        + 75 * 1 * 31
        + 110 * 2 * 31
        + 111 * 3 * 31
        + 119 * 4 * 31
        + 108 * 5 * 31
        + 101 * 6 * 31
        + 100 * 7 * 31
        + 103 * 8 * 31
        + 101 * 9 * 31
}

// Overflow-safe nested ref/option/box hash encoding.
// Direct encoding: base + mut + ty*4 + hash*256. Each wrap level multiplies by 256
// (8 bits). After 3 levels (e.g. &Option<Box<Struct>>), 37-bit name hashes overflow
// i64. To prevent the overflow producing a negative value that collides with
// knowledge_hash_is, we intern overflowing composites into a side-table; the
// returned hash is a sentinel in [rh_intern_base, rh_intern_base+1024) which the
// decoders look up rather than divide.
var RH_INTERN_TY: [i64; 1024] = [0; 1024]
var RH_INTERN_HASH: [i64; 1024] = [0; 1024]
var RH_INTERN_MUT: [i64; 1024] = [0; 1024]
var RH_INTERN_COUNT: i64 = 0

fn rh_intern_base() -> i64 {
    // 2^51 - 1024: sits above 2^50 (ref base) and below 2^51 (unobserved base).
    return 2251799813684224
}

fn rh_intern_is(h: i64) -> bool {
    return h >= rh_intern_base() && h < rh_intern_base() + 1024
}

fn rh_intern_make(inner_ty: i64, inner_hash: i64, is_mut: i64) -> i64 with Mut, Panic {
    var i: i64 = 0
    while i < RH_INTERN_COUNT {
        if RH_INTERN_TY[i as usize] == inner_ty
            && RH_INTERN_HASH[i as usize] == inner_hash
            && RH_INTERN_MUT[i as usize] == is_mut {
            return rh_intern_base() + i
        }
        i = i + 1
    }
    if RH_INTERN_COUNT >= 1024 { return 0 }
    let idx = RH_INTERN_COUNT
    RH_INTERN_TY[idx as usize] = inner_ty
    RH_INTERN_HASH[idx as usize] = inner_hash
    RH_INTERN_MUT[idx as usize] = is_mut
    RH_INTERN_COUNT = RH_INTERN_COUNT + 1
    return rh_intern_base() + idx
}

fn ref_hash_make(inner_ty: i64, inner_hash: i64, is_mut: i64) -> i64 with Mut, Panic {
    // 2^55 is well clear of i64 overflow when multiplied by 256 and offset by base.
    // Above the threshold, intern the composite instead of overflowing.
    if inner_hash < 0 || inner_hash > 36028797018963967 {
        return rh_intern_make(inner_ty, inner_hash, is_mut)
    }
    return 1125899906842624 + is_mut + inner_ty * 4 + inner_hash * 256
}

fn ref_hash_is(h: i64) -> bool with Mut, Panic {
    if rh_intern_is(h) { return true }
    return h >= 1125899906842624
}

fn ref_hash_mut(h: i64) -> i64 with Div, Mut, Panic {
    if rh_intern_is(h) { return RH_INTERN_MUT[(h - rh_intern_base()) as usize] }
    return (h - 1125899906842624) % 4
}

fn ref_hash_inner_ty(h: i64) -> i64 with Div, Mut, Panic {
    if rh_intern_is(h) { return RH_INTERN_TY[(h - rh_intern_base()) as usize] }
    return ((h - 1125899906842624) / 4) % 64
}

fn ref_hash_inner_hash(h: i64) -> i64 with Div, Mut, Panic {
    if rh_intern_is(h) { return RH_INTERN_HASH[(h - rh_intern_base()) as usize] }
    return (h - 1125899906842624) / 256
}

fn ptr_hash_make(inner_ty: i64, inner_hash: i64, is_mut: i64) -> i64 with Mut, Panic {
    return ref_hash_make(inner_ty, inner_hash, is_mut)
}

fn ptr_hash_mut(h: i64) -> i64 with Div, Mut, Panic {
    return ref_hash_mut(h)
}

fn ptr_hash_inner_ty(h: i64) -> i64 with Div, Mut, Panic {
    return ref_hash_inner_ty(h)
}

fn ptr_hash_inner_hash(h: i64) -> i64 with Div, Mut, Panic {
    return ref_hash_inner_hash(h)
}

fn option_hash_make(inner_ty: i64, inner_hash: i64) -> i64 with Mut, Panic {
    return ref_hash_make(inner_ty, inner_hash, 2)
}

fn option_hash_is(h: i64) -> bool with Div, Mut, Panic {
    if h < 1125899906842624 { return false }
    return ref_hash_mut(h) == 2
}

fn option_hash_inner_ty(h: i64) -> i64 with Div, Mut, Panic {
    return ref_hash_inner_ty(h)
}

fn option_hash_inner_hash(h: i64) -> i64 with Div, Mut, Panic {
    return ref_hash_inner_hash(h)
}

fn box_hash_make(inner_ty: i64, inner_hash: i64) -> i64 with Mut, Panic {
    return ref_hash_make(inner_ty, inner_hash, 3)
}

fn box_hash_is(h: i64) -> bool with Div, Mut, Panic {
    if h < 1125899906842624 { return false }
    return ref_hash_mut(h) == 3
}

// ── Seq<T> type hash (TY_SEQ = 12) ──────────────────────────────────────────
// Interns (inner_ty, inner_hash) into a bounded id; the hash is base + id, so it
// stays in [1e9, 1e9+256): positive (knowledge_hash_is false), below 2^50 (ref/
// option/box false) and below 2^51 (unobserved false). Inner type is recovered
// only when the carrying tag is already known to be TY_SEQ.
fn seq_hash_base() -> i64 {
    return 1000000000
}

fn seq_hash_make(inner_ty: i64, inner_hash: i64) -> i64 with Mut {
    var i: i64 = 0
    while i < SEQ_COUNT {
        if SEQ_INNER_TY[i as usize] == inner_ty && SEQ_INNER_HASH[i as usize] == inner_hash {
            return seq_hash_base() + i
        }
        i = i + 1
    }
    if SEQ_COUNT < 256 {
        SEQ_INNER_TY[SEQ_COUNT as usize] = inner_ty
        SEQ_INNER_HASH[SEQ_COUNT as usize] = inner_hash
        let h = seq_hash_base() + SEQ_COUNT
        SEQ_COUNT = SEQ_COUNT + 1
        return h
    }
    return seq_hash_base()
}

fn seq_hash_is(h: i64) -> bool {
    return h >= seq_hash_base() && h < seq_hash_base() + 256
}

fn seq_hash_inner_ty(h: i64) -> i64 with Mut {
    let i = h - seq_hash_base()
    if i < 0 || i >= SEQ_COUNT { return 0 }
    return SEQ_INNER_TY[i as usize]
}

fn seq_hash_inner_hash(h: i64) -> i64 with Mut {
    let i = h - seq_hash_base()
    if i < 0 || i >= SEQ_COUNT { return 0 }
    return SEQ_INNER_HASH[i as usize]
}

fn type_is_option_inline(ty: i64, ty_hash: i64) -> bool with Div, Mut, Panic {
    if ty != 11 { return false }
    if ty_hash == 0 { return true }
    return option_hash_is(ty_hash)
}

fn type_is_pointer_like(ty: i64, ty_hash: i64) -> bool with Div, Mut, Panic {
    if ty == 10 { return true }
    if ty != 11 { return false }
    return type_is_option_inline(ty, ty_hash) == false
}

fn type_is_slice_ref(ty: i64, ty_hash: i64) -> bool with Panic, Div, Mut {
    if ty != 10 { return false }
    if ref_hash_inner_ty(ty_hash) != 8 { return false }
    return arr_hash_alen(ref_hash_inner_hash(ty_hash)) == 0
}

fn type_is_array_ref(ty: i64, ty_hash: i64) -> bool with Panic, Div, Mut {
    if ty != 10 { return false }
    return ref_hash_inner_ty(ty_hash) == 8
}

fn slice_inner_matches(expected_hash: i64, actual_hash: i64) -> bool with Panic, Div, Mut {
    let expected_inner = ref_hash_inner_hash(expected_hash)
    let actual_inner = ref_hash_inner_hash(actual_hash)
    if arr_hash_esiz(expected_inner) != arr_hash_esiz(actual_inner) { return false }
    if arr_hash_elem_ty(expected_inner) != arr_hash_elem_ty(actual_inner) { return false }
    let expected_elem_hash = arr_hash_elem_hash(expected_inner)
    let actual_elem_hash = arr_hash_elem_hash(actual_inner)
    if expected_elem_hash != 0 || actual_elem_hash != 0 {
        return expected_elem_hash == actual_elem_hash
    }
    return true
}

fn call_arg_type_compatible(expected_ty: i64, expected_hash: i64, actual_ty: i64, actual_hash: i64) -> bool with Panic, Div, Mut {
    // Unknown actual type (e.g. array element from struct array) — skip check
    if actual_ty == 0 && actual_hash == 0 { return true }
    // Struct element from array with no type hash — cannot verify, accept
    if (actual_ty == 6 || actual_ty == 7) && actual_hash == 0 { return true }
    // Size-hint sentinel from tuple field extraction — cannot verify struct name, accept
    if actual_ty == 6 && actual_hash >= 1000000007 && actual_hash < 1000001007 { return true }
    // 1-slot struct from tuple destructuring is bound as i64 (ABI-identical) — accept
    if expected_ty == 6 && actual_ty == 1 && actual_hash == 0 { return true }
    if ty_eq(expected_ty, expected_hash, actual_ty, actual_hash) { return true }
    if type_is_slice_ref(expected_ty, expected_hash) {
        if actual_ty == 10 && ref_hash_inner_ty(actual_hash) == 8 {
            if slice_inner_matches(expected_hash, actual_hash) == false { return false }
            if ref_hash_mut(expected_hash) != 0 && ref_hash_mut(actual_hash) == 0 { return false }
            return true
        }
    }
    // Auto-ref coercion: struct/array field access through a reference produces an address
    // in the codegen (via lea), so it is ABI-compatible with a shared &T parameter.
    // This handles patterns like: fn f(x: &Foo) called as f(obj.field) where obj: &Bar.
    if expected_ty == 10 && ref_hash_mut(expected_hash) == 0 {
        let exp_inner_ty = ref_hash_inner_ty(expected_hash)
        let exp_inner_hash = ref_hash_inner_hash(expected_hash)
        if (actual_ty == 6 || actual_ty == 8) && ty_eq(exp_inner_ty, exp_inner_hash, actual_ty, actual_hash) {
            return true
        }
        // Allow passing &!T (exclusive) where &T (shared) is expected — safe downgrade.
        if actual_ty == 10 && ref_hash_mut(actual_hash) != 0 {
            let act_inner_ty = ref_hash_inner_ty(actual_hash)
            let act_inner_hash = ref_hash_inner_hash(actual_hash)
            if ty_eq(exp_inner_ty, exp_inner_hash, act_inner_ty, act_inner_hash) {
                return true
            }
        }
        // A `string` value (string literal or otherwise) is already a bare
        // pointer at the ABI level — identical to &str's runtime rep. Accept
        // it directly where a &str parameter is declared (issue #601 Bug E).
        if exp_inner_ty == 3 && actual_ty == 3 { return true }
    }
    // Array-ref size leniency: `&[T; M]` / `&![T; M]` is ABI-compatible with a
    // same-ELEMENT array-ref of a different fixed size N — the size is metadata,
    // both are element pointers. The x86 frontend accepts this (e.g. passing a
    // struct's `[IrInstr; 2048]` field as `&![IrInstr; 1024]`); the a64 pass-2 arg
    // re-check must match (the side-table array hashes differ only by alen, so the
    // ty_eq `h1==h2` above rejects). Mut: allow &! where & is expected (safe
    // downgrade), reject & where &! is expected. (#740)
    if expected_ty == 10 && actual_ty == 10
        && ref_hash_inner_ty(expected_hash) == 8 && ref_hash_inner_ty(actual_hash) == 8 {
        let e_arr = ref_hash_inner_hash(expected_hash)
        let a_arr = ref_hash_inner_hash(actual_hash)
        if arr_hash_elem_ty(e_arr) == arr_hash_elem_ty(a_arr)
            && arr_hash_elem_hash(e_arr) == arr_hash_elem_hash(a_arr) {
            if ref_hash_mut(expected_hash) == 0 || ref_hash_mut(actual_hash) != 0 {
                return true
            }
        }
    }
    return false
}

fn expr_simple_numeric_tok(start: i64, finish: i64) -> i64 with Panic, Mut {
    if finish == start + 1 {
        let k = TK[start as usize]
        if k == 4 || k == 53 { return start }
    }
    return -1
}

fn type_has_knowledge(ty: i64, ty_hash: i64) -> bool {
    if ty != 0 { return false }
    return knowledge_hash_is(ty_hash)
}

fn ty_is_unobserved(ty: i64) -> bool {
    return ty == 20
}

fn comparison_visible_ty(ty: i64, ty_hash: i64) -> i64 with Panic, Div, Mut {
    if ty_is_unobserved(ty) { return unobserved_hash_inner_ty(ty_hash) }
    // &str and string are ABI-identical (both a bare byte pointer) — unwrap
    // &str to string so a `&str`-typed value compares against a bare string
    // literal via the existing string-equality codegen (issue #601 Bug E).
    if ty == 10 && ref_hash_inner_ty(ty_hash) == 3 { return 3 }
    return ty
}

// Algebra property queries (bit-packed in AL_PROPS)
fn al_is_algebra(ty: i64, ty_hash: i64) -> bool with Panic, Mut {
    if ty != 6 { return false }
    let si = st_find(ty_hash)
    if si < 0 { return false }
    return (AL_PROPS[si as usize] & 1) != 0
}
fn al_mul_is_commutative(ty_hash: i64) -> bool with Panic, Mut {
    let si = st_find(ty_hash)
    if si < 0 { return true }
    return (AL_PROPS[si as usize] & 8) != 0
}
fn al_mul_is_associative(ty_hash: i64) -> bool with Panic, Mut {
    let si = st_find(ty_hash)
    if si < 0 { return true }
    return (AL_PROPS[si as usize] & 16) != 0
}
fn al_add_is_commutative(ty_hash: i64) -> bool with Panic, Mut {
    let si = st_find(ty_hash)
    if si < 0 { return true }
    return (AL_PROPS[si as usize] & 2) != 0
}
fn al_reassoc_mode(ty_hash: i64) -> i64 with Panic, Mut {
    let si = st_find(ty_hash)
    if si < 0 { return 0 }
    return (AL_PROPS[si as usize] >> 6) & 3
}

fn comparison_visible_hash(ty: i64, ty_hash: i64) -> i64 with Panic, Div, Mut {
    if ty_is_unobserved(ty) { return unobserved_hash_inner_hash(ty_hash) }
    if ty == 10 && ref_hash_inner_ty(ty_hash) == 3 { return ref_hash_inner_hash(ty_hash) }
    return ty_hash
}

fn comparison_require_observe(op_tok: i64, left_ty: i64, right_ty: i64) with IO, Mut, Panic {
    if (ty_is_unobserved(left_ty) || ty_is_unobserved(right_ty)) && (FN_EFFECTS[CURRENT_FN as usize] & 64) == 0 {
        tc_observe_violation(op_tok)
    }
}

fn tok_scaled_million(p: i64) -> i64 with Panic, Mut {
    if TK[p as usize] == 4 { return TV[p as usize] * 1000000 }
    if TK[p as usize] == 53 {
        var frac_scaled = TF[p as usize]
        var denom = TD[p as usize]
        while denom < 1000000 {
            frac_scaled = frac_scaled * 10
            denom = denom * 10
        }
        if denom != 1000000 { return -1 }
        return TV[p as usize] * 1000000 + frac_scaled
    }
    return -1
}

fn tok_abs_scaled_million(p: i64) -> i64 with Panic, Div, Mut {
    let v = tok_scaled_million(p)
    if v < 0 { return 0 - v }
    return v
}

fn infer_measure_eps_scaled(value_tok: i64, unc_tok: i64) -> i64 with Panic, Div, Mut {
    if value_tok < 0 || unc_tok < 0 { return -1 }
    let value_scaled = tok_abs_scaled_million(value_tok)
    let unc_scaled = tok_abs_scaled_million(unc_tok)
    if value_scaled <= 0 { return -1 }
    let eps_scaled = (unc_scaled * 1000000) / value_scaled
    if eps_scaled < 0 || eps_scaled > 1000000 { return -1 }
    return eps_scaled
}

fn isqrt_i64(n: i64) -> i64 with Div, Mut {
    if n <= 0 { return 0 }
    var x = n
    var y = (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    return x
}

fn knowledge_eps_combine_independent(a: i64, b: i64) -> i64 with Panic, Div, Mut {
    if a < 0 || b < 0 { return -1 }
    let sum_sq = a * a + b * b
    var root = isqrt_i64(sum_sq)
    if root * root < sum_sq { root = root + 1 }
    if root > 1000000 { root = 1000000 }
    return root
}

fn knowledge_eps_combine_relative(a: i64, b: i64) -> i64 {
    if a < 0 || b < 0 { return -1 }
    let sum = a + b
    if sum > 1000000 { return 1000000 }
    return sum
}

fn knowledge_binary_result_hash(op: i64, left_ty: i64, left_hash: i64, right_ty: i64, right_hash: i64) -> i64 with Panic, Div, Mut {
    let left_has = knowledge_hash_is(left_hash)
    let right_has = knowledge_hash_is(right_hash)
    if left_has == false && right_has == false { return 0 }
    var inner_ty = left_ty
    var inner_hash = left_hash
    if left_has {
        inner_ty = knowledge_hash_inner_ty(left_hash)
        inner_hash = knowledge_hash_inner_hash(left_hash)
    } else {
        if right_has {
            inner_ty = knowledge_hash_inner_ty(right_hash)
            inner_hash = knowledge_hash_inner_hash(right_hash)
        }
    }
    var left_eps: i64 = 0
    if left_has { left_eps = knowledge_hash_eps(left_hash) }
    var right_eps: i64 = 0
    if right_has { right_eps = knowledge_hash_eps(right_hash) }
    var left_mode: i64 = 0
    if left_has { left_mode = knowledge_hash_meta_mode(left_hash) }
    var right_mode: i64 = 0
    if right_has { right_mode = knowledge_hash_meta_mode(right_hash) }
    if left_mode == 3 || right_mode == 3 {
        return knowledge_hash_make_mode(inner_ty, inner_hash, 3, -1)
    }
    var eps: i64 = -1
    if op == 17 || op == 18 || op == 29 {
        eps = knowledge_eps_combine_independent(left_eps, right_eps)
    } else {
        eps = knowledge_eps_combine_relative(left_eps, right_eps)
    }
    return knowledge_hash_make_mode(inner_ty, inner_hash, 0, eps)
}

fn skip_call_arg_expr(p0: i64) -> i64 with Panic, Mut {
    var p = p0
    var paren_depth: i64 = 0
    var bracket_depth: i64 = 0
    var brace_depth: i64 = 0
    while p < TC {
        let k = TK[p as usize]
        if k == 6 { paren_depth = paren_depth + 1 }
        if k == 7 {
            if paren_depth == 0 && bracket_depth == 0 && brace_depth == 0 { return p }
            paren_depth = paren_depth - 1
        }
        if k == 41 { bracket_depth = bracket_depth + 1 }
        if k == 42 { bracket_depth = bracket_depth - 1 }
        if k == 8 { brace_depth = brace_depth + 1 }
        if k == 9 {
            if brace_depth == 0 && paren_depth == 0 && bracket_depth == 0 { return p }
            brace_depth = brace_depth - 1
        }
        if k == 28 && paren_depth == 0 && bracket_depth == 0 && brace_depth == 0 { return p }
        p = p + 1
    }
    return p
}

fn skip_signature_where_clause(p0: i64) -> i64 with Panic, Mut {
    var p = p0
    if TK[p as usize] == 3 {
        let ns = TS[p as usize]
        let ne = TE[p as usize]
        if src_match(ns, ne - ns, "where") {
            p = p + 1
            while p < TC && TK[p as usize] != 8 && TK[p as usize] != 38 && TK[p as usize] != 0 {
                p = p + 1
            }
        }
    }
    return p
}

fn type_name_kind(ns: i64, ne: i64) -> i64 with Panic, Mut {
    if src_match(ns, ne - ns, "i8") { return 1 }
    if src_match(ns, ne - ns, "i32") { return 1 }
    if src_match(ns, ne - ns, "u32") { return 1 }
    if src_match(ns, ne - ns, "i64") { return 1 }
    if src_match(ns, ne - ns, "u64") { return 1 }
    if src_match(ns, ne - ns, "usize") { return 1 }
    if src_match(ns, ne - ns, "f32") { return 2 }
    if src_match(ns, ne - ns, "f64") { return 2 }
    if src_match(ns, ne - ns, "str") { return 3 }
    if src_match(ns, ne - ns, "string") { return 3 }
    if src_match(ns, ne - ns, "bool") { return 4 }
    if src_match(ns, ne - ns, "unit") { return 5 }
    let h = gl_name_hash(ns, ne)
    if st_find(h) >= 0 { return 6 }
    if en_find(h) >= 0 { return 7 }
    return 0
}

fn type_is_struct_like(ty: i64, ty_hash: i64) -> bool with Panic, Mut {
    if ty == 6 { return true }
    if ty == 0 && ty_hash != 0 {
        if st_find(ty_hash) >= 0 { return true }
    }
    if ty == 0 && knowledge_hash_is(ty_hash) { return true }
    return false
}

fn type_is_aggregate(ty: i64, ty_hash: i64) -> bool with Panic, Div, Mut {
    if ty == 8 { return true }
    if type_is_option_inline(ty, ty_hash) { return true }
    return type_is_struct_like(ty, ty_hash)
}

fn struct_like_nslots(ty_hash: i64) -> i64 with Panic, Div, Mut {
    if knowledge_hash_is(ty_hash) { return 3 }
    // Size-hint sentinel: 1000000007 + nslots, set after .0 tuple field access
    if ty_hash >= 1000000007 && ty_hash < 1000001007 { return ty_hash - 1000000007 }
    let si = st_find(ty_hash)
    if si >= 0 { return st_total_size(si) / 8 }
    return 0
}

fn ty_eq(k1: i64, h1: i64, k2: i64, h2: i64) -> bool with Panic, Div, Mut {
    if k1 == 10 && k2 == 10 {
        if ref_hash_mut(h1) != ref_hash_mut(h2) { return false }
        return ty_eq(ref_hash_inner_ty(h1), ref_hash_inner_hash(h1), ref_hash_inner_ty(h2), ref_hash_inner_hash(h2))
    }
    if k1 == 11 && k2 == 11 {
        if h1 == 0 || h2 == 0 { return true }
        if option_hash_is(h1) || option_hash_is(h2) {
            if option_hash_is(h1) == false || option_hash_is(h2) == false { return false }
            return ty_eq(option_hash_inner_ty(h1), option_hash_inner_hash(h1), option_hash_inner_ty(h2), option_hash_inner_hash(h2))
        }
        if box_hash_is(h1) || box_hash_is(h2) {
            if box_hash_is(h1) == false || box_hash_is(h2) == false { return false }
            return ty_eq(ptr_hash_inner_ty(h1), ptr_hash_inner_hash(h1), ptr_hash_inner_ty(h2), ptr_hash_inner_hash(h2))
        }
        if ptr_hash_mut(h1) != ptr_hash_mut(h2) { return false }
        return ty_eq(ptr_hash_inner_ty(h1), ptr_hash_inner_hash(h1), ptr_hash_inner_ty(h2), ptr_hash_inner_hash(h2))
    }
    if k1 == 12 && k2 == 12 {
        if h1 == 0 || h2 == 0 { return true }
        return ty_eq(seq_hash_inner_ty(h1), seq_hash_inner_hash(h1), seq_hash_inner_ty(h2), seq_hash_inner_hash(h2))
    }
    if k1 == 20 && k2 == 20 {
        return ty_eq(unobserved_hash_inner_ty(h1), unobserved_hash_inner_hash(h1), unobserved_hash_inner_ty(h2), unobserved_hash_inner_hash(h2))
    }
    if k1 == 20 {
        return ty_eq(unobserved_hash_inner_ty(h1), unobserved_hash_inner_hash(h1), k2, h2)
    }
    if k2 == 20 {
        return ty_eq(k1, h1, unobserved_hash_inner_ty(h2), unobserved_hash_inner_hash(h2))
    }
    if k1 == 0 && knowledge_hash_is(h1) && k2 == 6 && h2 == knowledge_struct_hash() { return true }
    if k1 == 0 && k2 == 0 && h1 != 0 && h2 != 0 {
        if knowledge_hash_is(h1) || knowledge_hash_is(h2) {
            if knowledge_hash_is(h1) == false || knowledge_hash_is(h2) == false { return false }
            if knowledge_hash_invalid(h1) || knowledge_hash_invalid(h2) { return false }
            if ty_eq(knowledge_hash_inner_ty(h1), knowledge_hash_inner_hash(h1), knowledge_hash_inner_ty(h2), knowledge_hash_inner_hash(h2)) == false {
                return false
            }
            let req_mode = knowledge_hash_meta_mode(h1)
            let got_mode = knowledge_hash_meta_mode(h2)
            let req_eps = knowledge_hash_eps(h1)
            let got_eps = knowledge_hash_eps(h2)
            if req_mode == 3 {
                if got_mode == 3 { return true }
                return got_mode == 0 && got_eps < 0
            }
            if req_mode == 2 {
                if got_mode == 3 { return false }
                if got_eps < 0 { return false }
                return got_eps >= req_eps
            }
            if req_mode == 1 {
                if got_mode == 3 { return false }
                if got_eps < 0 { return false }
                return got_eps == req_eps
            }
            if req_eps < 0 { return true }
            if got_mode == 2 || got_mode == 3 { return false }
            if got_eps < 0 { return false }
            return got_eps <= req_eps
        }
        return h1 == h2
    }
    // Native lowering still uses raw i64 handles for some legacy boundaries:
    // enum discriminants and untyped callable closure handles may flow into
    // integer-typed parameters in older tests.
    if k1 == 1 && k2 == 7 { return true }
    if k1 == 1 && k2 == 9 { return true }
    // Allow integer scalar (from tuple .0/.1 type-erasure) to fill enum struct fields.
    if k1 == 7 && k2 == 1 { return true }
    // Knowledge<T> must not silently coerce to non-Knowledge types (or vice versa)
    if k1 != 0 && k2 == 0 && knowledge_hash_is(h2) { return false }
    if k1 == 0 && k2 != 0 && knowledge_hash_is(h1) { return false }
    if k1 == 0 || k2 == 0 {
        return true
    }
    if k1 != k2 { return false }
    if k1 == 2 {
        if h1 != 0 && h2 != 0 {
            if unit_type_hash_is(h1) || unit_type_hash_is(h2) {
                let d1 = type_hash_unit_dim(h1)
                let d2 = type_hash_unit_dim(h2)
                return d1 != 0 && d1 == d2
            }
            return h1 == h2
        }
        return true
    }
    if k1 == 6 || k1 == 7 {
        if h1 == h2 { return true }
        if k1 == 6 {
            if h1 >= 1000000007 && h1 < 1000001007 { return true }
            if h2 >= 1000000007 && h2 < 1000001007 { return true }
        }
        return false
    }
    if k1 == 8 {
        let a1 = arr_hash_alen(h1)
        let a2 = arr_hash_alen(h2)
        if arr_hash_esiz(h1) != arr_hash_esiz(h2) { return false }
        if arr_hash_elem_ty(h1) != arr_hash_elem_ty(h2) { return false }
        let eh1 = arr_hash_elem_hash(h1)
        let eh2 = arr_hash_elem_hash(h2)
        if eh1 != 0 || eh2 != 0 {
            if eh1 != eh2 { return false }
        }
        if a1 == 0 || a2 == 0 { return true }
        return h1 == h2
    }
    return true
}

fn ret_agg_nslots(ty: i64, ty_hash: i64) -> i64 with Panic, Div, Mut {
    if ty == 8 { return arr_storage_slots(ty_hash) }
    if type_is_option_inline(ty, ty_hash) { return 2 }
    // Knowledge types use negative hashes, but only for type 0 (unresolved Knowledge)
    // or type 6 (struct-like). NOT for enums (ty==7) or scalars.
    if knowledge_hash_is(ty_hash) && ty != 7 && ty != 1 && ty != 4 { return 3 }
    if ty == 0 && ty_hash != 0 {
        let fwd_si = st_find(ty_hash)
        if fwd_si >= 0 { return st_total_size(fwd_si) / 8 }
    }
    if ty == 6 {
        let si = st_find(ty_hash)
        if si >= 0 { return st_total_size(si) / 8 }
        // Synthetic tuple: recover total slot count from the element-type cache
        // (the packed hash overflows for elements >= 1000 slots). Falls back to
        // the 3-digit decode / 128 for partially-encoded or unregistered structs.
        if ty_hash != 0 {
            let tup_total = tup_total_slots_true(ty_hash)
            if tup_total > 0 { return tup_total }
            return 128
        }
    }
    return 0
}

fn box_alloc_bytes(ty: i64, ty_hash: i64) -> i64 with Panic, Div, Mut {
    var bytes = box_page_bytes()
    if ty == 8 {
        bytes = arr_storage_slots(ty_hash) * 8
    } else if type_is_option_inline(ty, ty_hash) {
        bytes = 16
    } else if ty == 6 || knowledge_hash_is(ty_hash) {
        bytes = struct_like_nslots(ty_hash) * 8
    }
    // Arena packing: round to 8 bytes (was: page-rounded to 4096). Matched branches above
    // (array/option/struct) carry their exact size and now pack tightly; an unmatched
    // fall-through type keeps the conservative box_page_bytes() default set above, so it is
    // never under-allocated. (Paired with the emit_arena_alloc_x86 redirect in Box::new.)
    if bytes < 8 { bytes = 8 }
    return (bytes + 7) / 8 * 8
}

// Per-function error tracking for import-tolerant compilation.
var TC_FN_ERR_COUNT: i64 = 0

// Print "<source-file>:<local-line>" for a token's bundled byte position.
// Scans backwards from TS[tok] to the nearest \x01<path>\x02 marker (start
// of an imported file); newlines between the marker and the token give the
// local line number. If no marker is found, the token is in main and we
// print "main:<line>" using TL[tok] directly.
fn print_src_loc_for_tok(tok: i64) with IO, Mut, Panic {
    let pos = TS[tok as usize]
    if pos < 0 || pos >= SRC_LEN {
        print("<unknown>")
        return
    }
    // Walk backwards: find most recent \x02 (end of marker); the bytes
    // between the preceding \x01 and that \x02 are the source path.
    var scan: i64 = pos
    var marker_end: i64 = -1
    while scan >= 0 {
        if SRC[scan as usize] as i64 == 2 { marker_end = scan; break }
        scan = scan - 1
    }
    if marker_end < 0 {
        // No marker before this position — token is in the main file.
        print("<main>:")
        print_int(TL[tok as usize])
        return
    }
    // Walk further back to find the matching \x01.
    var marker_start: i64 = marker_end - 1
    while marker_start >= 0 && SRC[marker_start as usize] as i64 != 1 {
        marker_start = marker_start - 1
    }
    if marker_start < 0 {
        print("<orphan-marker>:")
        print_int(TL[tok as usize])
        return
    }
    // Print the path (bytes between marker_start+1 and marker_end).
    var pi: i64 = marker_start + 1
    while pi < marker_end {
        print_char(SRC[pi as usize] as i64)
        pi = pi + 1
    }
    print(":")
    // Count newlines from marker_end+1 to pos.
    var local_line: i64 = 1
    var nl_scan: i64 = marker_end + 1
    while nl_scan < pos {
        if SRC[nl_scan as usize] as i64 == 10 { local_line = local_line + 1 }
        nl_scan = nl_scan + 1
    }
    print_int(local_line)
}

// Guard: errors in imported module functions should NOT block ELF emission.
fn tc_mark_failed() with Mut {
    TC_FN_ERR_COUNT = TC_FN_ERR_COUNT + 1
    if MAIN_SRC_END > 0 && CURRENT_FN >= 0 && CURRENT_FN < 65536 {
        if (FN_EFFECTS[CURRENT_FN as usize] & 2048) != 0 {
            return
        }
    }
    TYPECHECK_FAILED = 1
}

fn tc_stack_frame_too_large(bytes: i64) with IO, Mut, Panic {
    print("warning: stack frame too large (")
    print_int(bytes)
    print(" bytes) in fn#")
    print_int(CURRENT_FN)
    print(" ")
    print_fn_name(CURRENT_FN)
    print(" at ")
    print_src_loc_for_tok(FN_NAME_TOK[CURRENT_FN as usize])
    print(" - consider *mut/heap or global arrays\n")
    // Not a hard error — large-struct value-semantics are valid but risky at runtime
}

fn tc_error(tok: i64, msg: string) -> i64 with IO, Mut, Panic {
    print("warning: ")
    print(msg)
    print(" at ")
    print_src_loc_for_tok(tok)
    print(" (bundle line ")
    print_int(TL[tok as usize])
    print(")\n")
    return 0
}

// Unbalanced braces in a module (#1634).
//
// Sets TYPECHECK_FAILED DIRECTLY rather than going through tc_mark_failed or
// note_limit_error. Both of those early-return for functions carrying
// FN_EFFECTS & 2048 (imported), which is how an unbalanced brace in an imported
// module used to fail the build while printing no `error:` line at all -- the
// only symptom was a scatter of E200s hundreds of tokens later, in a different
// file, naming a parameter that had nothing to do with it.
fn tc_unbalanced_braces(tok: i64, d: i64) with IO, Mut, Panic {
    print("error: unbalanced braces in module (")
    if d > 0 {
        print_int(d)
        print(" unclosed `{`")
    } else {
        print_int(0 - d)
        print(" extra `}`")
    }
    print(") near ")
    print_src_loc_for_tok(tok)
    print("\n")
    TYPECHECK_FAILED = 1
}

fn tc_error_hard(tok: i64, msg: string) -> i64 with IO, Mut, Panic {
    print("error: ")
    print(msg)
    if PENDING_PRIV_SI >= 0 {
        print(" [struct=")
        var priv_i: i64 = ST_DECL_NS[PENDING_PRIV_SI as usize]
        while priv_i < ST_DECL_NE[PENDING_PRIV_SI as usize] {
            print_char(SRC[priv_i as usize] as i64)
            priv_i = priv_i + 1
        }
        print("]")
        PENDING_PRIV_SI = 0 - 1
    }
    print(" at ")
    print_src_loc_for_tok(tok)
    print(" (bundle line ")
    print_int(TL[tok as usize])
    print(")\n")
    tc_mark_failed()
    return 0
}

fn tc_decl_init_mismatch(tok: i64, decl_ty: i64, decl_hash: i64, expr_ty: i64, expr_hash: i64) -> i64 with IO, Mut, Panic, Div {
    print("error[E001]: Type mismatch — expected ")
    print_type_label(decl_ty, decl_hash)
    print(", got ")
    print_type_label(expr_ty, expr_hash)
    print(" at ")
    print_src_loc_for_tok(tok)
    print(" (bundle line ")
    print_int(TL[tok as usize])
    print(")\n")
    tc_mark_failed()
    return 0
}

// PR-3: struct-field refinement enforcement. At struct-literal compile time,
// look up the field's stored type hash against the registered refinement-type
// aliases; if it matches an alias with an integer predicate and the just-compiled
// RHS is a literal, apply the predicate and emit a violation on failure.
// Field types are scanned in pass 0a before pass 1c registers aliases, so the
// stored fhash is the alias name hash, not the resolved base hash — we use that
// to dispatch back into REF_TYPE_DATA.
fn try_apply_field_alias_refinement(field_hash: i64, tok: i64) with IO, Mut, Panic, Div {
    var ref_idx: i64 = -1
    var ref_i: i64 = 0
    while ref_i < REF_TYPE_COUNT {
        if REF_TYPE_HASH[ref_i as usize] == field_hash { ref_idx = ref_i; ref_i = REF_TYPE_COUNT }
        ref_i = ref_i + 1
    }
    if ref_idx < 0 { return }
    let b = ref_idx * 10
    if REF_TYPE_DATA[(b + 2) as usize] != 1 { return }
    if REF_TYPE_DATA[(b + 5) as usize] == 1 { return }  // f64 predicates: codegen below handles non-literal case
    if LAST_IS_LITERAL != 1 { return }
    let cv = LAST_LITERAL_VAL
    let bv = REF_TYPE_DATA[(b + 4) as usize]
    let op = REF_TYPE_DATA[(b + 3) as usize]
    var violated: i64 = 0
    if op == 26 && cv < bv { violated = 1 }
    if op == 24 && cv <= bv { violated = 1 }
    if op == 25 && cv > bv { violated = 1 }
    if op == 23 && cv >= bv { violated = 1 }
    if op == 21 && cv != bv { violated = 1 }
    if op == 22 && cv == bv { violated = 1 }
    // PR-6: AND compound — check second predicate independently; OR — second pred can clear violation
    if REF_TYPE_DATA[(b + 6) as usize] == 1 {
        let bv2 = REF_TYPE_DATA[(b + 8) as usize]
        let op2 = REF_TYPE_DATA[(b + 7) as usize]
        if REF_TYPE_IS_AND[ref_idx as usize] == 1 {
            if op2 == 26 && cv < bv2 { violated = 1 }
            if op2 == 24 && cv <= bv2 { violated = 1 }
            if op2 == 25 && cv > bv2 { violated = 1 }
            if op2 == 23 && cv >= bv2 { violated = 1 }
            if op2 == 21 && cv != bv2 { violated = 1 }
            if op2 == 22 && cv == bv2 { violated = 1 }
        } else {
            if violated == 1 {
                var ok2: i64 = 0
                if op2 == 26 && cv >= bv2 { ok2 = 1 }
                if op2 == 24 && cv > bv2 { ok2 = 1 }
                if op2 == 25 && cv <= bv2 { ok2 = 1 }
                if op2 == 23 && cv < bv2 { ok2 = 1 }
                if op2 == 21 && cv == bv2 { ok2 = 1 }
                if op2 == 22 && cv != bv2 { ok2 = 1 }
                if ok2 == 1 { violated = 0 }
            }
        }
    }
    if violated == 1 {
        print("error[E208]: refinement type violation — value ")
        print_int(cv)
        print(" does not satisfy field predicate at line ")
        print_int(TL[tok as usize])
        print("\n")
        tc_mark_failed()
    }
}

// PR-4: call-arg refinement enforcement. When scan_fn_param_type/scan_type populates
// SCAN_HAS_PRED on a refined-typed parameter (`fn f(x: Pos)` with `type Pos = { v | v > 0 }`,
// or inline `fn f(x: { v: i32 | v > 0 })`), and the just-compiled actual argument is a
// known literal (a literal token, or an immutable `let x = -5` propagated via VAR_LIT_DATA),
// replay the predicate at compile time and emit a violation on failure. Mirrors the
// let-binding check at compile_stmt and the struct-field check in PR-3.
fn try_apply_call_arg_refinement(tok: i64) with IO, Mut, Panic, Div {
    if SCAN_HAS_PRED != 1 { return }
    // PR-7: f64 predicate — rational comparison using cross-multiplication
    if SCAN_PRED_IS_F64 == 1 {
        if LAST_IS_LITERAL_F64 != 1 { SCAN_HAS_PRED = 0; SCAN_HAS_PRED2 = 0; return }
        let cv_int = LAST_LITERAL_F64_INT
        let cv_frac = LAST_LITERAL_F64_FRAC
        let cv_denom = LAST_LITERAL_F64_DENOM
        let bv_int = SCAN_PRED_BOUND
        let bv_frac = SCAN_PRED_BOUND_FRAC
        let bv_denom = SCAN_PRED_BOUND_DENOM
        // value = (cv_int*cv_denom + cv_frac) / cv_denom; bound = (bv_int*bv_denom + bv_frac) / bv_denom
        // compare by cross-multiplying (both denoms positive)
        let lhs = (cv_int * cv_denom + cv_frac) * bv_denom
        let rhs = (bv_int * bv_denom + bv_frac) * cv_denom
        let op = SCAN_PRED_OP
        var f64_violated: i64 = 0
        if op == 26 && lhs < rhs { f64_violated = 1 }   // >= : violated if lhs < rhs
        if op == 24 && lhs <= rhs { f64_violated = 1 }  // >  : violated if lhs <= rhs
        if op == 25 && lhs > rhs { f64_violated = 1 }   // <= : violated if lhs > rhs
        if op == 23 && lhs >= rhs { f64_violated = 1 }  // <  : violated if lhs >= rhs
        if SCAN_HAS_PRED2 == 1 {
            let bv2_int = SCAN_PRED_BOUND2
            let bv2_frac = SCAN_PRED_BOUND2_FRAC
            let bv2_denom = SCAN_PRED_BOUND2_DENOM
            let lhs2 = (cv_int * cv_denom + cv_frac) * bv2_denom
            let rhs2 = (bv2_int * bv2_denom + bv2_frac) * cv_denom
            let op2 = SCAN_PRED_OP2
            if SCAN_PRED_COMPOUND_IS_AND == 1 {
                if op2 == 26 && lhs2 < rhs2 { f64_violated = 1 }
                if op2 == 24 && lhs2 <= rhs2 { f64_violated = 1 }
                if op2 == 25 && lhs2 > rhs2 { f64_violated = 1 }
                if op2 == 23 && lhs2 >= rhs2 { f64_violated = 1 }
            } else {
                if f64_violated == 1 {
                    var ok2: i64 = 0
                    if op2 == 26 && lhs2 >= rhs2 { ok2 = 1 }
                    if op2 == 24 && lhs2 > rhs2 { ok2 = 1 }
                    if op2 == 25 && lhs2 <= rhs2 { ok2 = 1 }
                    if op2 == 23 && lhs2 < rhs2 { ok2 = 1 }
                    if ok2 == 1 { f64_violated = 0 }
                }
            }
        }
        if f64_violated == 1 {
            print("error[E209]: refinement type violation — f64 value violates parameter predicate at line ")
            print_int(TL[tok as usize])
            print("\n")
            tc_mark_failed()
        }
        SCAN_HAS_PRED = 0
        SCAN_HAS_PRED2 = 0
        return
    }
    if LAST_IS_LITERAL != 1 {
        SCAN_HAS_PRED = 0
        SCAN_HAS_PRED2 = 0
        return
    }
    let cv = LAST_LITERAL_VAL
    let bv = SCAN_PRED_BOUND
    let op = SCAN_PRED_OP
    var violated: i64 = 0
    if op == 26 && cv < bv { violated = 1 }
    if op == 24 && cv <= bv { violated = 1 }
    if op == 25 && cv > bv { violated = 1 }
    if op == 23 && cv >= bv { violated = 1 }
    if op == 21 && cv != bv { violated = 1 }
    if op == 22 && cv == bv { violated = 1 }
    // PR-6: AND compound — check second predicate independently; OR compound — second pred can clear violation
    if SCAN_HAS_PRED2 == 1 && SCAN_PRED_IS_F64_2 == 0 {
        let bv2 = SCAN_PRED_BOUND2
        let op2 = SCAN_PRED_OP2
        if SCAN_PRED_COMPOUND_IS_AND == 1 {
            if op2 == 26 && cv < bv2 { violated = 1 }
            if op2 == 24 && cv <= bv2 { violated = 1 }
            if op2 == 25 && cv > bv2 { violated = 1 }
            if op2 == 23 && cv >= bv2 { violated = 1 }
            if op2 == 21 && cv != bv2 { violated = 1 }
            if op2 == 22 && cv == bv2 { violated = 1 }
        } else {
            if violated == 1 {
                var ok2: i64 = 0
                if op2 == 26 && cv >= bv2 { ok2 = 1 }
                if op2 == 24 && cv > bv2 { ok2 = 1 }
                if op2 == 25 && cv <= bv2 { ok2 = 1 }
                if op2 == 23 && cv < bv2 { ok2 = 1 }
                if op2 == 21 && cv == bv2 { ok2 = 1 }
                if op2 == 22 && cv != bv2 { ok2 = 1 }
                if ok2 == 1 { violated = 0 }
            }
        }
    }
    if violated == 1 {
        print("error[E208]: refinement type violation — value ")
        print_int(cv)
        print(" does not satisfy parameter predicate at line ")
        print_int(TL[tok as usize])
        print("\n")
        tc_mark_failed()
    }
    // Clear the per-arg refinement state so it does not leak past the call into
    // the surrounding let-binding refinement check (which would otherwise fire
    // a duplicate error on `let r = takes_pos(-5)` patterns).
    SCAN_HAS_PRED = 0
    SCAN_HAS_PRED2 = 0
}

// PR-5: Check whether the return value of the current function violates the
// refinement predicate on its declared return type (alias or inline refinement).
// Only fires when the return expression is a known compile-time literal; runtime
// values are left for the SMT backend.  Mirrors try_apply_call_arg_refinement.
fn try_apply_return_refinement(tok: i64) with IO, Mut, Panic, Div {
    if CURRENT_FN < 0 { return }
    if FN_RET_HAS_PRED[CURRENT_FN as usize] != 1 { return }
    // PR-10: f64 return predicate check via rational comparison
    if FN_RET_PRED_IS_F64[CURRENT_FN as usize] == 1 {
        if LAST_IS_LITERAL_F64 != 1 { return }
        let r10_cv_int = LAST_LITERAL_F64_INT
        let r10_cv_frac = LAST_LITERAL_F64_FRAC
        let r10_cv_denom = LAST_LITERAL_F64_DENOM
        let r10_bv_int = FN_RET_PRED_BOUND[CURRENT_FN as usize]
        let r10_bv_frac = FN_RET_PRED_BOUND_FRAC[CURRENT_FN as usize]
        let r10_bv_denom = FN_RET_PRED_BOUND_DENOM[CURRENT_FN as usize]
        let r10_lhs = (r10_cv_int * r10_cv_denom + r10_cv_frac) * r10_bv_denom
        let r10_rhs = (r10_bv_int * r10_bv_denom + r10_bv_frac) * r10_cv_denom
        let r10_op = FN_RET_PRED_OP[CURRENT_FN as usize]
        var r10_viol: i64 = 0
        if r10_op == 26 && r10_lhs < r10_rhs { r10_viol = 1 }
        if r10_op == 24 && r10_lhs <= r10_rhs { r10_viol = 1 }
        if r10_op == 25 && r10_lhs > r10_rhs { r10_viol = 1 }
        if r10_op == 23 && r10_lhs >= r10_rhs { r10_viol = 1 }
        if FN_RET_HAS_PRED2[CURRENT_FN as usize] == 1 {
            let r10_bv2_int = FN_RET_PRED_BOUND2[CURRENT_FN as usize]
            let r10_bv2_frac = FN_RET_PRED_BOUND2_FRAC[CURRENT_FN as usize]
            let r10_bv2_denom = FN_RET_PRED_BOUND2_DENOM[CURRENT_FN as usize]
            let r10_lhs2 = (r10_cv_int * r10_cv_denom + r10_cv_frac) * r10_bv2_denom
            let r10_rhs2 = (r10_bv2_int * r10_bv2_denom + r10_bv2_frac) * r10_cv_denom
            let r10_op2 = FN_RET_PRED_OP2[CURRENT_FN as usize]
            if FN_RET_PRED_COMPOUND_IS_AND[CURRENT_FN as usize] == 1 {
                if r10_op2 == 26 && r10_lhs2 < r10_rhs2 { r10_viol = 1 }
                if r10_op2 == 24 && r10_lhs2 <= r10_rhs2 { r10_viol = 1 }
                if r10_op2 == 25 && r10_lhs2 > r10_rhs2 { r10_viol = 1 }
                if r10_op2 == 23 && r10_lhs2 >= r10_rhs2 { r10_viol = 1 }
            } else {
                if r10_viol == 1 {
                    var r10_ok2: i64 = 0
                    if r10_op2 == 26 && r10_lhs2 >= r10_rhs2 { r10_ok2 = 1 }
                    if r10_op2 == 24 && r10_lhs2 > r10_rhs2 { r10_ok2 = 1 }
                    if r10_op2 == 25 && r10_lhs2 <= r10_rhs2 { r10_ok2 = 1 }
                    if r10_op2 == 23 && r10_lhs2 < r10_rhs2 { r10_ok2 = 1 }
                    if r10_ok2 == 1 { r10_viol = 0 }
                }
            }
        }
        if r10_viol == 1 {
            print("error[E209]: refinement type violation — f64 return value violates return type predicate at line ")
            print_int(TL[tok as usize])
            print("\n")
            tc_mark_failed()
        }
        return
    }
    if LAST_IS_LITERAL != 1 { return }
    let cv = LAST_LITERAL_VAL
    let bv = FN_RET_PRED_BOUND[CURRENT_FN as usize]
    let op = FN_RET_PRED_OP[CURRENT_FN as usize]
    var violated: i64 = 0
    if op == 26 && cv < bv { violated = 1 }
    if op == 24 && cv <= bv { violated = 1 }
    if op == 25 && cv > bv { violated = 1 }
    if op == 23 && cv >= bv { violated = 1 }
    if op == 21 && cv != bv { violated = 1 }
    if op == 22 && cv == bv { violated = 1 }
    // PR-6: AND compound — check second predicate independently; OR — second pred can clear violation
    if FN_RET_HAS_PRED2[CURRENT_FN as usize] == 1 {
        let bv2 = FN_RET_PRED_BOUND2[CURRENT_FN as usize]
        let op2 = FN_RET_PRED_OP2[CURRENT_FN as usize]
        if FN_RET_PRED_COMPOUND_IS_AND[CURRENT_FN as usize] == 1 {
            if op2 == 26 && cv < bv2 { violated = 1 }
            if op2 == 24 && cv <= bv2 { violated = 1 }
            if op2 == 25 && cv > bv2 { violated = 1 }
            if op2 == 23 && cv >= bv2 { violated = 1 }
            if op2 == 21 && cv != bv2 { violated = 1 }
            if op2 == 22 && cv == bv2 { violated = 1 }
        } else {
            if violated == 1 {
                var ok2: i64 = 0
                if op2 == 26 && cv >= bv2 { ok2 = 1 }
                if op2 == 24 && cv > bv2 { ok2 = 1 }
                if op2 == 25 && cv <= bv2 { ok2 = 1 }
                if op2 == 23 && cv < bv2 { ok2 = 1 }
                if op2 == 21 && cv == bv2 { ok2 = 1 }
                if op2 == 22 && cv != bv2 { ok2 = 1 }
                if ok2 == 1 { violated = 0 }
            }
        }
    }
    if violated == 1 {
        print("error[E208]: refinement type violation — return value ")
        print_int(cv)
        print(" does not satisfy return type predicate at line ")
        print_int(TL[tok as usize])
        print("\n")
        tc_mark_failed()
    }
}

fn tc_undefined_var(tok: i64) -> i64 with IO, Mut, Panic {
    print("error: unknown identifier `")
    var uv_i: i64 = TS[tok as usize]
    while uv_i < TE[tok as usize] { print_char(SRC[uv_i as usize] as i64); uv_i = uv_i + 1 }
    print("` at ")
    print_src_loc_for_tok(tok)
    print(" (bundle line ")
    print_int(TL[tok as usize])
    print(")\n")
    tc_mark_failed()
    return 0
}

fn tc_duplicate_fn(tok: i64) -> i64 with IO, Mut, Panic {
    tc_error(tok, "duplicate function name")
}

// Two bundled functions share a name + receiver but have DIFFERENT arity.
// Call resolution (fn_find) is name-only first-wins, so any call to the shadowed
// definition resolves to the surviving one's arity. This is only a *latent*
// hazard: if the shadowed definition is never called with its own arity, the
// bundle compiles and runs correctly (the loser is effectively dead). We only
// hard-fail when a wrong-arity call is actually resolved — that path is caught
// by tc_wrong_arity_hard, which now sets TYPECHECK_FAILED even for imported
// bodies. Here we emit a *warning* that names the collision, so that when the
// hard failure does fire the user has the cross-module context ("two `foo` with
// different arity") rather than a bare "arity mismatch at line N" in a library.
fn tc_conflicting_arity_fn(tok: i64) -> i64 with IO, Mut, Panic {
    print("warning: conflicting definitions of the same function name with different arity across the bundle at ")
    print_src_loc_for_tok(tok)
    print(" (bundle line ")
    print_int(TL[tok as usize])
    print(") — a call to the shadowed definition will fail to compile\n")
    return 0
}

fn tc_duplicate_param(tok: i64) -> i64 with IO, Mut, Panic {
    tc_error_hard(tok, "duplicate parameter name")
}

fn tc_missing_effect(tok: i64) -> i64 with IO, Mut, Panic {
    print("error[E035]: effect not declared in function signature at line ")
    print_int(TL[tok as usize])
    print("\n")
    tc_mark_failed()
    return 0
}

fn tc_linear_violation(tok: i64, msg: string) -> i64 with IO, Mut, Panic {
    print("error: ")
    print(msg)
    print(" at ")
    print_src_loc_for_tok(tok)
    print(" (bundle line ")
    print_int(TL[tok as usize])
    print(")\n")
    tc_mark_failed()
    return 0
}

fn tc_arity_error(tok: i64, msg: string) -> i64 with IO, Mut, Panic {
    print("error: ")
    print(msg)
    print(" at ")
    print_src_loc_for_tok(tok)
    print(" (bundle line ")
    print_int(TL[tok as usize])
    print(")\n")
    tc_mark_failed()
    return 0
}

fn tc_epistemic_boundary(tok: i64) -> i64 with IO, Mut, Panic {
    print("error[P0003]: Type mismatch — expected confidence level not satisfied: Knowledge ε boundary violation at line ")
    print_int(TL[tok as usize])
    print("\n")
    tc_mark_failed()
    return 0
}

