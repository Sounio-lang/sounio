// bootstrap/mini_native.sio — Self-contained native compiler for Sounio subset.
// Compiles: fn, return, print("str"), let/var, arithmetic, if/else, while, function calls.
// Produces standalone x86-64 Linux ELF. No imports — boot4 compatible.
//
// Usage: boot4.elf bootstrap/mini_native.sio /tmp/mini_native.elf
//        /tmp/mini_native.elf input.sio output.elf

// ─── Global buffers ───
var SRC: [i8; 8388608] = [0; 8388608]
var SRC_LEN: i64 = 0
// Import resolution
var IMP_PATH: [i8; 4096] = [0; 4096]
var IMP_RAW_PATH: [i8; 4096] = [0; 4096]
var MOD_PATH: [i8; 4096] = [0; 4096]
var IMP_LOADED: [i64; 1024] = [0; 1024]
var IMP_LOADED_PATHS: [i8; 262144] = [0; 262144]
var IMP_LOADED_OFFS: [i64; 1024] = [0; 1024]
var IMP_LOADED_LENS: [i64; 1024] = [0; 1024]
var IMP_PATHS_USED: i64 = 0
var IMP_COUNT: i64 = 0
var BASE_DIR: [i8; 512] = [0; 512]
var BASE_DIR_LEN: i64 = 0
var CLI_SHOW_AST: i64 = 0
var CLI_SHOW_TYPES: i64 = 0
var CLI_R15_MONITOR: i64 = 0     // --r15-monitor: emit R15 confidence checks at all call sites
var R15_GATE_COUNT: i64 = 0      // number of call sites instrumented
var R15_SIDE_TABLE_BSS_OFF: i64 = 0  // BSS offset of the R15 side table

// Token parallel arrays (kind, start, end, int_value)
// Raised from 262144 to 524288 for JIT-free bootstrap (compile native_compile_driver + main.sio)
var TK: [i64; 524288] = [0; 524288]
var TS: [i64; 524288] = [0; 524288]
var TE: [i64; 524288] = [0; 524288]
var TV: [i64; 524288] = [0; 524288]
// Float literal extra: frac numerator and denominator (kind=53)
var TF: [i64; 524288] = [0; 524288]
var TD: [i64; 524288] = [0; 524288]
// Float literal scientific exponent (signed exp_val; 0 = no exponent)
var TX: [i64; 524288] = [0; 524288]
var TL: [i64; 524288] = [0; 524288]
var TC: i64 = 0

// Code output
var CD: [i8; 33554432] = [0; 33554432]
var CL: i64 = 0
var TRAMP_OFF: i64 = 0

// ELF/PE output
var ELF: [i8; 33558528] = [0; 33558528]

// Target OS: 0=linux (default), 2=macos, 3=windows
var TARGET_OS: i64 = 0
// Target arch: 0=x86_64 (default), 1=aarch64
var TARGET_ARCH: i64 = 0
// Ontology validation: class/role name tracking (reset per ontology block)
var ONT_CLASS_S: [i64; 64] = [0; 64]
var ONT_CLASS_E: [i64; 64] = [0; 64]
var ONT_CLASS_COUNT: i64 = 0
var ONT_ROLE_S: [i64; 32] = [0; 32]
var ONT_ROLE_E: [i64; 32] = [0; 32]
var ONT_ROLE_COUNT: i64 = 0
// OWL2 kernel: class hashes + subclass/disjoint matrices (64×64, reset per ontology block)
var ONT_CLASS_HASH: [i64; 64] = [0; 64]
var ONT_SUB_MATRIX: [i64; 4096] = [0; 4096]
var ONT_DIS_MATRIX: [i64; 4096] = [0; 4096]
var ONT_DIS_TMP: [i64; 64] = [0; 64]  // temp list for disjoint class indices
var ONT_DIS_TMP_CNT: i64 = 0
// Property constraint storage for ontology subsumption checking
var ONT_PROP_CLS: [i64; 256] = [0; 256]    // class index
var ONT_PROP_NHASH: [i64; 256] = [0; 256]  // property name hash
var ONT_PROP_BOUND: [i64; 256] = [0; 256]  // signed bound ×1000 (neg stored as negative)
var ONT_PROP_DIR: [i64; 256] = [0; 256]    // 0 = >=, 1 = <=
var ONT_PROP_CNT: i64 = 0
// PE: offset within CD[] of the ExitProcess call [rip+disp32]'s disp32 field
var PE_EXIT_CALL_OFF: i64 = -1

// Shared string scratch buffer: used both as packed qwords and as decoded bytes.
var SQW: [i64; 256] = [0; 256]

// Function table: name start/end in source, code offset
var FN_NS: [i64; 16384] = [0; 16384]
var FN_NE: [i64; 16384] = [0; 16384]
var FN_OFF: [i64; 16384] = [0; 16384]
var FN_SIG: [i64; 16384] = [0; 16384]
var FN_IS_KERNEL: [i64; 16384] = [0; 16384]
var FN_PTX_SUPPORTED: [i64; 16384] = [0; 16384]
var FN_PTX_KIND: [i64; 16384] = [0; 16384]
var FN_PTX_OFF: [i64; 16384] = [0; 16384]
var FN_PTX_LEN: [i64; 16384] = [0; 16384]
var FN_PTX_EXTENT_SLOT: [i64; 16384] = [0; 16384]
var FN_PTX_PARAM_KINDS: [i64; 65536] = [0; 65536]
var FN_COUNT: i64 = 0
var FN_RECV_HASH: [i64; 16384] = [0; 16384]

var PTX_DATA: [i8; 262144] = [0; 262144]
var PTX_LEN: i64 = 0

// Call patch table: code offset where rel32 needs patching, target fn index
var PATCH_OFF: [i64; 65536] = [0; 65536]
var PATCH_FN: [i64; 65536] = [0; 65536]
var PATCH_KIND: [i64; 65536] = [0; 65536]
var PATCH_COUNT: i64 = 0

// Canonical function-signature registry for fn-typed values and indirect calls.
// Signatures are stored as arity + param types/hashes + return type/hash.
var FNSIG_ARITY: [i64; 256] = [0; 256]
var FNSIG_RET_TY: [i64; 256] = [0; 256]
var FNSIG_RET_HASH: [i64; 256] = [0; 256]
var FNSIG_PARAM_TY: [i64; 4096] = [0; 4096]
var FNSIG_PARAM_HASH: [i64; 4096] = [0; 4096]
var FNSIG_COUNT: i64 = 1
var FNSIG_SCRATCH_ARITY: i64 = 0
var FNSIG_SCRATCH_RET_TY: i64 = 0
var FNSIG_SCRATCH_RET_HASH: i64 = 0
var FNSIG_SCRATCH_PARAM_TY: [i64; 16] = [0; 16]
var FNSIG_SCRATCH_PARAM_HASH: [i64; 16] = [0; 16]
var FNSIG_SCAN_DEPTH: i64 = 0
var FNSIG_TMP_PARAM_TY: [i64; 256] = [0; 256]
var FNSIG_TMP_PARAM_HASH: [i64; 256] = [0; 256]

// Struct registry: flat array, up to 32 structs
// ST[i*66+0] = name hash
// ST[i*66+1] = field count
// ST[i*66+2..65] = field name hashes (up to 64 fields)
var ST: [i64; 133120] = [0; 133120]
// Per-struct field type metadata, indexed as si*64 + fi
var ST_FTY: [i64; 131072] = [0; 131072]
var ST_FHASH: [i64; 131072] = [0; 131072]
var ST_COUNT: i64 = 0

// Enum registry: flat array, up to 64 enums
// EN[i*256+0] = name hash
// EN[i*256+1] = variant count
// EN[i*256+2..255] = variant name hashes (up to 254 variants)
var EN: [i64; 16384] = [0; 16384]
var EN_COUNT: i64 = 0
var MATCH_ENDS: [i64; 32] = [0; 32]

// Phase 1.4: Or-pattern arm alternatives (A | B | C => body)
var OR_ALT_DISC:    [i64; 8] = [0; 8]   // discriminant value for each alt (-1 = none)
var OR_ALT_TAGGED:  [i64; 8] = [0; 8]   // 1 if tagged union check (Some/None/Ok/Err)
var OR_ALT_HAS_BIND:[i64; 8] = [0; 8]   // 1 if this alt has an inner value binding
var OR_ALT_BIND_NS: [i64; 8] = [0; 8]   // binding name start in SRC
var OR_ALT_BIND_NE: [i64; 8] = [0; 8]   // binding name end in SRC
var OR_ALT_IS_WILD: [i64; 8] = [0; 8]   // 1 if wildcard _
var OR_BODY_PATCHES:[i64; 8] = [0; 8]   // offset of je/jmp → body for each non-last alt
var OR_BODY_PV:     [i64; 8] = [0; 8]   // 1 if OR_BODY_PATCHES[i] is a valid patch offset
var OR_ALT_COUNT:   i64 = 0

// Generic function registry (for monomorphization)
var GEN_FN_NS: [i64; 64] = [0; 32]
var GEN_FN_NE: [i64; 64] = [0; 32]
var GEN_FN_TP_S: [i64; 64] = [0; 32]
var GEN_FN_TP_E: [i64; 64] = [0; 32]
var GEN_FN_BDY_S: [i64; 64] = [0; 32]
var GEN_FN_BDY_E: [i64; 64] = [0; 32]
var GEN_FN_COUNT: i64 = 0

// Generic struct registry
var GEN_ST_NS: [i64; 64] = [0; 32]
var GEN_ST_NE: [i64; 64] = [0; 32]
var GEN_ST_TP_S: [i64; 64] = [0; 32]
var GEN_ST_TP_E: [i64; 64] = [0; 32]
var GEN_ST_BDY_S: [i64; 64] = [0; 32]
var GEN_ST_BDY_E: [i64; 64] = [0; 32]
var GEN_ST_COUNT: i64 = 0

// Tuple element type cache: maps tuple hash → element types for .0 / .1 extraction
var TUP_CACHE_KEY: [i64; 512] = [0; 512]
var TUP_CACHE_FIRST_TY: [i64; 512] = [0; 512]
var TUP_CACHE_FIRST_HASH: [i64; 512] = [0; 512]
var TUP_CACHE_LAST_TY: [i64; 512] = [0; 512]
var TUP_CACHE_LAST_HASH: [i64; 512] = [0; 512]
var TUP_CACHE_COUNT: i64 = 0

// Monomorphization instantiation pairs
var MONO_GEN: [i64; 128] = [0; 64]
var MONO_TY_S: [i64; 128] = [0; 64]
var MONO_TY_E: [i64; 128] = [0; 64]
var MONO_IS_ST: [i64; 128] = [0; 64]
var MONO_COUNT: i64 = 0

// Mangled name buffer (appended to SRC)
var MAN_BUF_S: [i64; 128] = [0; 64]
var MAN_BUF_E: [i64; 128] = [0; 64]

// ─── Phase 5: Effects checking ───
// Bitmask per function: IO=1, Mut=2, Panic=4, Div=8, Alloc=16,
// Custom/Session=32, Observe=64, Audit=128, Hypothesis=256, Epistemic=512,
// Visibility: bit 10 (1024) = is_pub, bit 11 (2048) = from_import
// Gen 19: Deterministic=4096 (bit 12) — function provably cannot call IO
// Gen 20: GPU=8192 (bit 13) — function dispatches work to GPU via CUDA/PTX
var FN_EFFECTS: [i64; 16384] = [0; 16384]
var FN_NAME_TOK: [i64; 16384] = [0; 16384]
var FN_NEEDS_SESSION: [i64; 16384] = [0; 16384]
var CURRENT_FN: i64 = 0
// When inside an `impl Type { ... }` block, this is set to Type's hash.
// Functions registered while this is non-zero get FN_RECV_HASH set automatically.
var CURRENT_IMPL_RECV_HASH: i64 = 0
// When inside a `study { ... }` block, functions get implicit Hypothesis effect.
var CURRENT_STUDY_EFFECT: i64 = 0
// End of main source file in SRC buffer (positions >= this are from imports)
var MAIN_SRC_END: i64 = 0

// ─── Phase 6a: Unit tracking (compile-time only) ───
// Unit hash per local variable (0 = no unit)
var VAR_UNIT: [i64; 1024] = [0; 1024]

// ─── Phase 6c: Linear type tracking ───
// Per-struct: 1 if declared with 'linear' keyword, 0 otherwise
var ST_LINEAR: [i64; 1024] = [0; 1024]
// Per-struct: 1 if declared with 'affine' keyword, 0 otherwise
var ST_AFFINE: [i64; 1024] = [0; 1024]
// ─── Phase 6d: Algebra property tracking (bit-packed per struct) ───
// Bit 0: is_algebra, Bit 1: add_comm, Bit 2: add_assoc,
// Bit 3: mul_comm, Bit 4: mul_assoc, Bit 5: mul_alt
// Bits 6-7: reassoc mode (0=none, 1=full, 2=fano_selective)
var AL_PROPS: [i64; 200] = [0; 200]
// Per local variable: 1 if linear type, 0 otherwise
var VAR_LINEAR: [i64; 1024] = [0; 1024]
// Per local variable: 1 if affine type, 0 otherwise
var VAR_AFFINE: [i64; 1024] = [0; 1024]
// Per local variable: 1 if value was moved (passed by value to a function)
var VAR_MOVED: [i64; 1024] = [0; 1024]
// Per local variable: count of active borrows (&var taken, for move-while-borrowed check)
var VAR_BORROW_COUNT: [i64; 1024] = [0; 1024]
var VAR_BORROW_EXCL: [i64; 1024] = [0; 1024]   // exclusive borrow active for this var
// Call-site borrow tracking: borrows taken in arg position are ephemeral — released after call
var CALL_ARG_BORROW_VI:   [i64; 32] = [-1; 32]  // var index borrowed in current call's args
var CALL_ARG_BORROW_EXCL: [i64; 32] = [0; 32]   // 1=exclusive, 0=shared
var CALL_ARG_BORROW_N:    i64 = 0               // count of borrows recorded this call
var IN_CALL_ARGS:         i64 = 0               // 1 when compiling a call arg list
// Per local variable: use count (for linear/affine checking)
var VAR_USED: [i64; 1024] = [0; 1024]
// Compile-time literal tracking for refinement predicate checks
var LAST_IS_LITERAL: i64 = 0
var LAST_LITERAL_VAL: i64 = 0
var VAR_TY: [i64; 1024] = [0; 1024]
var VAR_TY_HASH: [i64; 1024] = [0; 1024]
var GL_TY: [i64; 1024] = [0; 1024]
var GL_TY_HASH: [i64; 1024] = [0; 1024]
var FN_RET_TY: [i64; 16384] = [0; 16384]
var FN_RET_HASH: [i64; 16384] = [0; 16384]
var FN_ARITY: [i64; 16384] = [0; 16384]
var TYPECHECK_FAILED: i64 = 0
var SCAN_TY: i64 = 0
var SCAN_TY_HASH: i64 = 0
var SCAN_TY_ESIZ: i64 = 8
var SCAN_TY_ALEN: i64 = 0
var SCAN_TY_NEXT: i64 = 0
var LEX_ERROR_LINE: i64 = 0
var LEX_ERROR_KIND: i64 = 0
var MATCH_SCRUT_TY: i64 = 0
var MATCH_SCRUT_HASH: i64 = 0

// ─── Phase 6b: Refinement type aliases ───
// type Name = { x: T | predicate } — stored as name hash + predicate token range
var REF_TYPE_HASH: [i64; 32] = [0; 32]
var REF_TYPE_COUNT: i64 = 0

// ─── Phase 6c: Refinement predicate runtime assertions ───
// Set by scan_type when a refinement type { x: T | pred } is scanned.
// Caller emits runtime check (integer bound comparison + ud2 trap).
var SCAN_HAS_PRED: i64 = 0      // 1 if predicate was successfully parsed
var SCAN_PRED_OP: i64 = 0       // comparison TK: 26=>=, 24=>, 25=<=, 23=<, 21===, 22=!=
var SCAN_PRED_BOUND: i64 = 0    // literal bound value (i64 bits; for f64, IEEE 754)
var SCAN_PRED_IS_F64: i64 = 0   // 1 if float predicate
var SCAN_HAS_PRED2: i64 = 0     // 1 if second OR-predicate was parsed
var SCAN_PRED_OP2: i64 = 0      // second predicate operator
var SCAN_PRED_BOUND2: i64 = 0   // second predicate bound
var SCAN_PRED_IS_F64_2: i64 = 0 // 1 if second predicate is float

// ─── Phase 6d: Unit dimension checking ───
// Tracks unit hash of the last compiled expression sub-result.
// Set when a unit-typed variable is loaded; checked at + and - operators.
var EXPR_UNIT: i64 = 0

// Gen 19: Unit dimension system
// Packed dim vector: bits[3:0]=mass, [7:4]=length, [11:8]=time, [15:12]=temp,
//   [19:16]=amount, [23:20]=current, [27:24]=luminosity (4-bit 2's-complement each)
// UNIT_HASH_TABLE[slot] = full hash (0=empty), UNIT_DIM_TABLE[slot] = packed dim
var UNIT_HASH_TABLE: [i64; 2048] = [0; 2048]
var UNIT_DIM_TABLE:  [i64; 2048] = [0; 2048]
// Parallel token unit-hash array (for _suffix literals e.g. 500_mg)
var TU: [i64; 524288] = [0; 524288]
// Packed dimension vector of the current compiled expression (0 = dimensionless/unknown)
var EXPR_UNIT_DIM: i64 = 0

// ─── Phase 7: Epistemic Type System (Knowledge<Type>) ───
// Every type carries Confidence (0–1000) and GUM Uncertainty (0–1000).
// Fixed-point integer arithmetic only — no f64 (bootstrap determinism).
// Type kinds: 0=unknown, 1=i64, 2=f64, 3=bool, 4=string, 5=void,
//             10=fn, 11=array, 13=struct, 14=enum, 100=type_var
var ETY_KIND:     [i64; 16384] = [0; 16384]
var ETY_CONF:     [i64; 16384] = [0; 16384]
var ETY_UNC:      [i64; 16384] = [0; 16384]
var ETY_HASH:     [i64; 16384] = [0; 16384]
var ETY_UNIT_DIM: [i64; 16384] = [0; 16384]  // packed 7-field dim vector for kind=7 Knowledge<T>
var ETY_COUNT: i64 = 0
// Count of Knowledge<T> ETY entries with non-zero unit dimension (dimensional epistemic sites)
var KNOWLEDGE_UNITS_COUNT: i64 = 0
// Per-expression epistemic state (indexed by token position)
var EXPR_ETY:  [i64; 524288] = [0; 524288]
var EXPR_CONF: [i64; 524288] = [0; 524288]
var EXPR_GATE: [i64; 524288] = [0; 524288]
// Gen 17 D1: Belief/plausibility interval (Knightian uncertainty)
// EXPR_BELIEF = lower confidence bound, EXPR_PLAUS = upper bound
// Gap = EXPR_PLAUS - EXPR_BELIEF = known-unknown component (Dempster-Shafer)
var EXPR_BELIEF: [i64; 524288] = [0; 524288]
var EXPR_PLAUS:  [i64; 524288] = [0; 524288]
// Confidence gate threshold: 950 = 95.0% required for direct code emission
var GATE_THRESHOLD: i64 = 950
// Epistemic scope stack (variable name hash → type ID + confidence)
var ESCOPE_HASH: [i64; 2048] = [0; 2048]
var ESCOPE_TY:   [i64; 2048] = [0; 2048]
var ESCOPE_CONF: [i64; 2048] = [0; 2048]
var ESCOPE_DEPTH:[i64; 2048] = [0; 2048]
var ESCOPE_COUNT: i64 = 0
var ESCOPE_LEVEL: i64 = 0
// Effect confidence (per function)
var FN_DECL_EFF:  [i64; 16384] = [0; 16384]
var FN_USED_EFF:  [i64; 16384] = [0; 16384]
var FN_EFF_CONF:  [i64; 16384] = [0; 16384]
// Epistemic stats (for bootstrap convergence tracking)
var EPIST_TOTAL_EXPR: i64 = 0
var EPIST_HIGH_CONF:  i64 = 0
var EPIST_LOW_CONF:   i64 = 0
var EPIST_GATES_DIRECT: i64 = 0
var EPIST_GATES_GUARDED: i64 = 0
// Gen 12: per-file epistemic stats (main source vs imported)
var EPIST_MAIN_TOTAL: i64 = 0
var EPIST_MAIN_HIGH:  i64 = 0
// Gen 12: Knowledge<T> (Epistemic) type-site counter
var EPIST_KTYPE_SITES: i64 = 0
var EPIST_KTYPE_CERTAIN: i64 = 0
// Gen 12: --dump-conf-json flag
var CLI_DUMP_CONF_JSON: i64 = 0
// Gen 13: dual-channel measurement confidence (parallel to EXPR_CONF)
// MEAS_CONF[p] = GUM measurement quality of token p:
//   0    = not in measurement channel (bare types, constants, compiler-internal)
//   990  = instrument measurement ("measured" constructor)
//   970  = user assertion ("asserted" constructor)
//   1000 = physical constant ("constant" constructor)
//   propagates through arithmetic: min(left, right) via Sweep 2
var MEAS_CONF: [i64; 262144] = [0; 262144]
// Gen 13: ESCOPE measurement quality (parallel to ESCOPE_CONF)
var ESCOPE_MEAS: [i64; 16384] = [0; 16384]
// Gen 13: count of tokens with MEAS_CONF > 0 after all passes
var EPIST_MEAS_COUNT: i64 = 0
// Gen 14 (Track C): confidence tier distribution counters
// PLATINUM = conf == 1000 (maximally certain, no uncertainty anywhere in chain)
// GOLD     = conf >= 950  (above gate threshold, type-safe with minor heritage)
// SILVER   = conf >= 800  (below gate, compiler-uncertain, guarded at runtime)
// BRONZE   = conf >= 500  (low confidence, likely unresolved idents/imports)
var EPIST_TIER_PLATINUM: i64 = 0
var EPIST_TIER_GOLD:     i64 = 0
var EPIST_TIER_SILVER:   i64 = 0
var EPIST_TIER_BRONZE:   i64 = 0
// Gen 17 D1: Knightian uncertainty diagnostics
var EPIST_KNIGHTIAN_SITES: i64 = 0   // sites where belief < plaus
var EPIST_KNIGHTIAN_GAP:   i64 = 0   // sum of (plaus - belief) gaps
// Gen 17 D3: Knowledge<T> subtype tracking
var EPIST_KNOW_SUBTYPE_SITES: i64 = 0      // assignments where src has kind=7
var EPIST_KNOW_SUBTYPE_VIOLATIONS: i64 = 0  // where src conf < dst conf
// Gen 16 Track B: EpistemicComplete effect enforcement
var EPIST_EFFECT_VIOLATIONS: i64 = 0
// Gen 17 D2: Parameterized EpistemicComplete — per-function minimum confidence
var FN_EPISTEMIC_MIN: [i64; 16384] = [0; 16384]  // 0 = unset (use GATE_THRESHOLD)
// Gen 15 (Option B): epistemic certificate (.econf) support
// Gen 17 D6: --emit-proof-obligations — Lean 4 proof goals for PLATINUM bindings
var CLI_EMIT_PROOFS: i64 = 0
var PROOF_BUF: [i8; 65536] = [0; 65536]    // Lean 4 goal buffer
var PROOF_BUF_LEN: i64 = 0
// --emit-econf: print function confidence table to diagnostic stream
// --load-econf: pre-populate FN_EFF_CONF from a previously emitted .econf
var CLI_EMIT_ECONF: i64 = 0
var CLI_LOAD_ECONF: i64 = 0
// Raw bytes of a loaded .econf file (parsed in Phase A2)
var ECONF_RAW: [i64; 65536] = [0; 65536]
var ECONF_RAW_LEN: i64 = 0
// Count of FN_EFF_CONF overrides applied from a loaded .econf
var ECONF_APPLIED: i64 = 0

fn en_find(hash: i64) -> i64 with Panic, Mut {
    var i: i64 = 0
    while i < EN_COUNT {
        if EN[(i * 256) as usize] == hash { return i }
        i = i + 1
    }
    return -1
}

// Look up EnumName::Variant → discriminant value
fn en_variant_value(enum_hash: i64, variant_hash: i64) -> i64 with Panic, Mut {
    let ei = en_find(enum_hash)
    if ei < 0 { return -1 }
    let base = ei * 256
    let vc = EN[(base + 1) as usize]
    var vi: i64 = 0
    while vi < vc {
        if EN[(base + 2 + vi) as usize] == variant_hash { return vi }
        vi = vi + 1
    }
    return -1
}

fn en_variant_count(enum_hash: i64) -> i64 with Panic, Mut {
    let ei = en_find(enum_hash)
    if ei < 0 { return 0 }
    return EN[(ei * 256 + 1) as usize]
}

fn st_find(hash: i64) -> i64 with Panic, Mut {
    var i: i64 = 0
    while i < ST_COUNT {
        if ST[(i * 130) as usize] == hash { return i }
        i = i + 1
    }
    return -1
}

fn tup_cache_register(tup_hash: i64, first_ty: i64, first_hash: i64, last_ty: i64, last_hash: i64) with Panic, Mut {
    if tup_hash == 0 { return }
    var i: i64 = 0
    while i < TUP_CACHE_COUNT {
        if TUP_CACHE_KEY[i as usize] == tup_hash { return }
        i = i + 1
    }
    if TUP_CACHE_COUNT >= 512 { return }
    let idx = TUP_CACHE_COUNT
    TUP_CACHE_KEY[idx as usize] = tup_hash
    TUP_CACHE_FIRST_TY[idx as usize] = first_ty
    TUP_CACHE_FIRST_HASH[idx as usize] = first_hash
    TUP_CACHE_LAST_TY[idx as usize] = last_ty
    TUP_CACHE_LAST_HASH[idx as usize] = last_hash
    TUP_CACHE_COUNT = TUP_CACHE_COUNT + 1
}

fn tup_cache_lookup(tup_hash: i64) -> i64 with Panic, Mut {
    var i: i64 = 0
    while i < TUP_CACHE_COUNT {
        if TUP_CACHE_KEY[i as usize] == tup_hash { return i }
        i = i + 1
    }
    return -1
}

fn ty_slot_count(ty: i64, ty_hash: i64) -> i64 with Panic, Div, Mut {
    if ty == 8 { return arr_storage_slots(ty_hash) }
    if ty == 6 {
        // Size-hint sentinel: 1000000007 + nslots, set after .0 tuple field access
        if ty_hash >= 1000000007 && ty_hash < 1000001007 { return ty_hash - 1000000007 }
        let si = st_find(ty_hash)
        if si >= 0 { return st_total_size(si) / 8 }
    }
    // Option<T> and Box<T> are 2-slot values (tag + pointer or similar)
    if ty == 11 { return 2 }
    if knowledge_hash_is(ty_hash) { return 3 }
    return 1
}

fn st_field_slots_idx(si: i64, fi: i64) -> i64 with Panic, Div, Mut {
    return ty_slot_count(ST_FTY[(si * 128 + fi) as usize], ST_FHASH[(si * 128 + fi) as usize])
}

fn st_field_offset(si: i64, field_hash: i64) -> i64 with Panic, Div, Mut {
    let base = si * 130
    let fc = ST[(base + 1) as usize]
    var fi: i64 = 0
    var off: i64 = 0
    while fi < fc {
        if ST[(base + 2 + fi) as usize] == field_hash { return off * 8 }
        off = off + st_field_slots_idx(si, fi)
        fi = fi + 1
    }
    return -1
}

fn st_field_ty(si: i64, field_hash: i64) -> i64 with Panic, Mut {
    let base = si * 130
    let fc = ST[(base + 1) as usize]
    var fi: i64 = 0
    while fi < fc {
        if ST[(base + 2 + fi) as usize] == field_hash { return ST_FTY[(si * 128 + fi) as usize] }
        fi = fi + 1
    }
    return 0
}

fn st_field_hash(si: i64, field_hash: i64) -> i64 with Panic, Mut {
    let base = si * 130
    let fc = ST[(base + 1) as usize]
    var fi: i64 = 0
    while fi < fc {
        if ST[(base + 2 + fi) as usize] == field_hash { return ST_FHASH[(si * 128 + fi) as usize] }
        fi = fi + 1
    }
    return 0
}

fn st_total_size(si: i64) -> i64 with Panic, Div, Mut {
    let fc = ST[(si * 130 + 1) as usize]
    var fi: i64 = 0
    var nslots: i64 = 0
    while fi < fc {
        nslots = nslots + st_field_slots_idx(si, fi)
        fi = fi + 1
    }
    return nslots * 8
}

// Global variable table: flat array, 4 fields per entry [hash, offset, esiz, alen]
var GL: [i64; 4096] = [0; 4096]
var GL_COUNT: i64 = 0
var GL_BSS_SIZE: i64 = 0
var GL_BSS_BASE: i64 = 0
var RET_AGG_BSS_OFF: i64 = 0
var LIMIT_ERROR_KIND: i64 = 0
var LAST_LOCAL_BSS_SPILL: i64 = 0
var LAST_LOCAL_BSS_ADDR: i64 = 0
var GPU_EMU_THREAD_ID_BSS_OFF: i64 = 0
var GPU_RT_STATE_BSS_OFF: i64 = 0
var GPU_RT_DIAG_BSS_OFF: i64 = 0
var GPU_RT_LIBCUDA_HANDLE_BSS_OFF: i64 = 0
var GPU_RT_DEVICE_BSS_OFF: i64 = 0
var GPU_RT_CTX_BSS_OFF: i64 = 0
var GPU_RT_CUINIT_PTR_BSS_OFF: i64 = 0
var GPU_RT_CUDEVICEGET_PTR_BSS_OFF: i64 = 0
var GPU_RT_CUCTXCREATE_PTR_BSS_OFF: i64 = 0
var GPU_RT_CUCTXSYNC_PTR_BSS_OFF: i64 = 0
var GPU_RT_CUMODULELOADDATA_PTR_BSS_OFF: i64 = 0
var GPU_RT_CUMODULEGETFUNCTION_PTR_BSS_OFF: i64 = 0
var GPU_RT_CUMEMALLOC_PTR_BSS_OFF: i64 = 0
var GPU_RT_CUMEMFREE_PTR_BSS_OFF: i64 = 0
var GPU_RT_CUMEMCPYHTOD_PTR_BSS_OFF: i64 = 0
var GPU_RT_CUMEMCPYDTOH_PTR_BSS_OFF: i64 = 0
var GPU_RT_CULAUNCHKERNEL_PTR_BSS_OFF: i64 = 0

var NEEDS_GPU_RUNTIME_DYNLINK: i64 = 0

fn gpu_param_kind_scalar_i64() -> i64 { 1 }
fn gpu_param_kind_slice_in_f64() -> i64 { 2 }
fn gpu_param_kind_slice_out_f64() -> i64 { 3 }
fn gpu_kernel_ptx_kind_vec_binary_f64() -> i64 { 1 }

fn gpu_dyn_linux_x86_text_base() -> i64 { 0x400000 }
fn gpu_dyn_linux_x86_text_off() -> i64 { 4096 }
fn gpu_dyn_linux_x86_data_off() -> i64 { 8192 }
fn gpu_dyn_linux_x86_data_base() -> i64 { 0x600000 }
fn gpu_dyn_linux_x86_got_off() -> i64 { 512 }
fn gpu_dyn_linux_x86_got_base() -> i64 { return gpu_dyn_linux_x86_data_base() + gpu_dyn_linux_x86_got_off() }
fn gpu_dyn_linux_x86_got_slot_dlopen() -> i64 { return gpu_dyn_linux_x86_got_base() + 0 }
fn gpu_dyn_linux_x86_got_slot_dlsym() -> i64 { return gpu_dyn_linux_x86_got_base() + 8 }
fn gpu_dyn_linux_x86_got_slot_dlclose() -> i64 { return gpu_dyn_linux_x86_got_base() + 16 }

fn local_cap() -> i64 { return 1024 }
fn global_cap() -> i64 { return 1024 }
fn max_frame_bytes() -> i64 { return 4194304 }
fn box_page_bytes() -> i64 { return 4096 }
fn local_bss_spill_bytes() -> i64 { return 524288 }

fn note_limit_error(kind: i64) with Mut {
    if LIMIT_ERROR_KIND == 0 { LIMIT_ERROR_KIND = kind }
    // Import-tolerant: errors in imported functions should not block ELF emission
    if MAIN_SRC_END > 0 && CURRENT_FN >= 0 && CURRENT_FN < 16384 {
        if (FN_EFFECTS[CURRENT_FN as usize] & 2048) != 0 {
            return  // imported function error — don't set TYPECHECK_FAILED
        }
    }
    TYPECHECK_FAILED = 1
}

fn print_limit_error() with IO, Mut, Panic {
    if LIMIT_ERROR_KIND == 1 {
        print("error: too many local variables in function (max ")
        print_int(local_cap())
        print(")\n")
    } else if LIMIT_ERROR_KIND == 2 {
        print("error: too many globals (max ")
        print_int(global_cap())
        print(")\n")
    }
}

fn bss_alloc_aligned(bytes: i64) -> i64 with Mut, Panic, Div {
    let aligned = (bytes + 7) / 8 * 8
    let off = GL_BSS_SIZE
    GL_BSS_SIZE = GL_BSS_SIZE + aligned
    return off
}

fn ptx_reset_fn_meta(fi: i64) with Mut, Panic {
    if fi < 0 || fi >= 4096 { return }
    FN_PTX_SUPPORTED[fi as usize] = 0
    FN_PTX_KIND[fi as usize] = 0
    FN_PTX_OFF[fi as usize] = 0
    FN_PTX_LEN[fi as usize] = 0
    FN_PTX_EXTENT_SLOT[fi as usize] = 0
    var i: i64 = 0
    while i < 8 {
        FN_PTX_PARAM_KINDS[(fi * 8 + i) as usize] = 0
        i = i + 1
    }
}

fn ptx_emit_byte(v: i64) with Mut {
    if PTX_LEN < 262144 {
        PTX_DATA[PTX_LEN as usize] = (v & 0xFF) as i8
        PTX_LEN = PTX_LEN + 1
    }
}

fn ptx_emit_string(s: string) with Mut, Panic, Div {
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        ptx_emit_byte(str_char_at(s, i))
        i = i + 1
    }
}

fn ptx_emit_src_range(ns: i64, ne: i64) with Mut, Panic {
    var i: i64 = ns
    while i < ne {
        ptx_emit_byte(sb(i))
        i = i + 1
    }
}

fn ptx_finish_fn(fi: i64, start_off: i64, kind: i64, extent_slot: i64) with Mut, Panic {
    if fi < 0 || fi >= 4096 { return }
    ptx_emit_byte(0)
    FN_PTX_SUPPORTED[fi as usize] = 1
    FN_PTX_KIND[fi as usize] = kind
    FN_PTX_OFF[fi as usize] = start_off
    FN_PTX_LEN[fi as usize] = PTX_LEN - start_off - 1
    FN_PTX_EXTENT_SLOT[fi as usize] = extent_slot
}

fn fn_param_kind(fi: i64, arg_idx: i64) -> i64 with IO, Mut, Panic, Div {
    if fi < 0 || fi >= FN_COUNT { return 0 }
    scan_fn_param_type(fi, arg_idx)
    if SCAN_TY == 1 && SCAN_TY_HASH == 0 { return gpu_param_kind_scalar_i64() }
    if type_is_slice_ref(SCAN_TY, SCAN_TY_HASH) {
        let inner_ty = ref_hash_inner_ty(SCAN_TY_HASH)
        let inner_hash = ref_hash_inner_hash(SCAN_TY_HASH)
        if inner_ty == 8 && arr_hash_elem_ty(inner_hash) == 2 && arr_hash_esiz(inner_hash) == 8 {
            if ref_hash_mut(SCAN_TY_HASH) != 0 { return gpu_param_kind_slice_out_f64() }
            return gpu_param_kind_slice_in_f64()
        }
    }
    return 0
}

fn kernel_matches_supported_vec_binary_pattern(fi: i64, body_start: i64) -> i64 with Mut, Panic {
    if fi < 0 || fi >= FN_COUNT { return 0 }
    var saw_gpu_tid: i64 = 0
    var saw_tid: i64 = 0
    var saw_n: i64 = 0
    var saw_a: i64 = 0
    var saw_b: i64 = 0
    var saw_c: i64 = 0
    var saw_add: i64 = 0
    var p: i64 = body_start
    var depth: i64 = 1
    while p < TC && depth > 0 {
        if TK[p as usize] == 8 { depth = depth + 1 }
        if TK[p as usize] == 9 { depth = depth - 1 }
        if TK[p as usize] == 3 {
            if src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "gpu_thread_id_x") { saw_gpu_tid = 1 }
            if src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "tid") { saw_tid = 1 }
            if src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "n") { saw_n = 1 }
            if src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "a") { saw_a = 1 }
            if src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "b") { saw_b = 1 }
            if src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "c") { saw_c = 1 }
        }
        if TK[p as usize] == 17 { saw_add = 1 }
        p = p + 1
    }
    if saw_gpu_tid == 0 { return 0 }
    if saw_tid == 0 || saw_n == 0 { return 0 }
    if saw_a == 0 || saw_b == 0 || saw_c == 0 { return 0 }
    if saw_add == 0 { return 0 }
    return 1
}

fn maybe_compile_kernel_ptx(fi: i64, body_start: i64, extent_slot: i64) with IO, Mut, Panic, Div {
    ptx_reset_fn_meta(fi)
    if fi < 0 || fi >= FN_COUNT { return }
    if FN_ARITY[fi as usize] != 4 { return }
    if fn_param_kind(fi, 0) != gpu_param_kind_scalar_i64() { return }
    if fn_param_kind(fi, 1) != gpu_param_kind_slice_in_f64() { return }
    if fn_param_kind(fi, 2) != gpu_param_kind_slice_in_f64() { return }
    if fn_param_kind(fi, 3) != gpu_param_kind_slice_out_f64() { return }
    if kernel_matches_supported_vec_binary_pattern(fi, body_start) == 0 { return }

    let name_tok = FN_NAME_TOK[fi as usize]
    if name_tok < 0 || name_tok >= TC { return }
    let n_ns = TS[name_tok as usize]
    let n_ne = TE[name_tok as usize]
    let start_off = PTX_LEN
    FN_PTX_PARAM_KINDS[(fi * 8 + 0) as usize] = gpu_param_kind_scalar_i64()
    FN_PTX_PARAM_KINDS[(fi * 8 + 1) as usize] = gpu_param_kind_slice_in_f64()
    FN_PTX_PARAM_KINDS[(fi * 8 + 2) as usize] = gpu_param_kind_slice_in_f64()
    FN_PTX_PARAM_KINDS[(fi * 8 + 3) as usize] = gpu_param_kind_slice_out_f64()

    ptx_emit_string(".version 7.0\n")
    ptx_emit_string(".target sm_70\n")
    ptx_emit_string(".address_size 64\n\n")
    ptx_emit_string(".visible .entry ")
    ptx_emit_src_range(n_ns, n_ne)
    ptx_emit_string("(\n")
    ptx_emit_string("    .param .u64 n,\n")
    ptx_emit_string("    .param .u64 a,\n")
    ptx_emit_string("    .param .u64 b,\n")
    ptx_emit_string("    .param .u64 c\n")
    ptx_emit_string(") {\n")
    ptx_emit_string("    .reg .u32 %r<4>;\n")
    ptx_emit_string("    .reg .u64 %rd<8>;\n")
    ptx_emit_string("    .reg .f64 %fd<4>;\n")
    ptx_emit_string("    .reg .pred %p<2>;\n")
    ptx_emit_string("    mov.u32 %r0, %tid.x;\n")
    ptx_emit_string("    mov.u32 %r1, %ntid.x;\n")
    ptx_emit_string("    mov.u32 %r2, %ctaid.x;\n")
    ptx_emit_string("    mad.lo.u32 %r3, %r2, %r1, %r0;\n")
    ptx_emit_string("    cvt.u64.u32 %rd0, %r3;\n")
    ptx_emit_string("    ld.param.u64 %rd1, [n];\n")
    ptx_emit_string("    setp.ge.u64 %p0, %rd0, %rd1;\n")
    ptx_emit_string("    @%p0 ret;\n")
    ptx_emit_string("    ld.param.u64 %rd2, [a];\n")
    ptx_emit_string("    ld.param.u64 %rd3, [b];\n")
    ptx_emit_string("    ld.param.u64 %rd4, [c];\n")
    ptx_emit_string("    shl.b64 %rd5, %rd0, 3;\n")
    ptx_emit_string("    add.u64 %rd2, %rd2, %rd5;\n")
    ptx_emit_string("    add.u64 %rd3, %rd3, %rd5;\n")
    ptx_emit_string("    add.u64 %rd4, %rd4, %rd5;\n")
    ptx_emit_string("    ld.global.f64 %fd0, [%rd2];\n")
    ptx_emit_string("    ld.global.f64 %fd1, [%rd3];\n")
    ptx_emit_string("    add.f64 %fd2, %fd0, %fd1;\n")
    ptx_emit_string("    st.global.f64 [%rd4], %fd2;\n")
    ptx_emit_string("    ret;\n")
    ptx_emit_string("}\n")
    ptx_finish_fn(fi, start_off, gpu_kernel_ptx_kind_vec_binary_f64(), extent_slot)
}

// Hash: pack name length + first 6 bytes into i64 (avoids sb()-based comparison during lookup)
fn gl_name_hash(ns: i64, ne: i64) -> i64 with Panic, Mut {
    // Hash: length + sum of (byte * position) — collision-resistant for same-prefix names
    let l = ne - ns
    var h: i64 = l * 1000003
    var hi: i64 = 0
    while hi < l {
        h = h + (sb(ns + hi) & 0xFF) * (hi + 1) * 31
        hi = hi + 1
    }
    return h
}

// ─── Gen 19: Unit dimension helpers ──────────────────────────────────────────

// Pack 7 dimension exponents (-8..+7 each) into one i64 using 4-bit 2's-complement
fn dim_pack(mass: i64, len: i64, time: i64, temp: i64, amount: i64, current: i64, lum: i64) -> i64 {
    return (mass & 15)
         | ((len     & 15) << 4)
         | ((time    & 15) << 8)
         | ((temp    & 15) << 12)
         | ((amount  & 15) << 16)
         | ((current & 15) << 20)
         | ((lum     & 15) << 24)
}

// Add two dimension vectors (multiply units: e.g. m * s⁻¹)
fn dim_add(a: i64, b: i64) -> i64 {
    return ((((a & 15) + (b & 15)) & 15))
         | (((((a >> 4) & 15) + ((b >> 4) & 15)) & 15) << 4)
         | (((((a >> 8) & 15) + ((b >> 8) & 15)) & 15) << 8)
         | (((((a >> 12) & 15) + ((b >> 12) & 15)) & 15) << 12)
         | (((((a >> 16) & 15) + ((b >> 16) & 15)) & 15) << 16)
         | (((((a >> 20) & 15) + ((b >> 20) & 15)) & 15) << 20)
         | (((((a >> 24) & 15) + ((b >> 24) & 15)) & 15) << 24)
}

// Subtract two dimension vectors (divide units: e.g. m / s)
fn dim_sub(a: i64, b: i64) -> i64 {
    return (((a & 15) - (b & 15)) & 15)
         | ((((((a >> 4) & 15) - ((b >> 4) & 15)) & 15)) << 4)
         | ((((((a >> 8) & 15) - ((b >> 8) & 15)) & 15)) << 8)
         | ((((((a >> 12) & 15) - ((b >> 12) & 15)) & 15)) << 12)
         | ((((((a >> 16) & 15) - ((b >> 16) & 15)) & 15)) << 16)
         | ((((((a >> 20) & 15) - ((b >> 20) & 15)) & 15)) << 20)
         | ((((((a >> 24) & 15) - ((b >> 24) & 15)) & 15)) << 24)
}

// Register a unit hash → dimension vector (open-addressing hash table, load factor <5%)
fn unit_register_h(h: i64, dim: i64) with Mut, Panic {
    if h == 0 { return }
    var idx: i64 = h % 2048
    if idx < 0 { idx = idx + 2048 }
    var probe: i64 = idx
    var iters: i64 = 0
    while iters < 2048 {
        if UNIT_HASH_TABLE[probe as usize] == 0 || UNIT_HASH_TABLE[probe as usize] == h {
            UNIT_HASH_TABLE[probe as usize] = h
            UNIT_DIM_TABLE[probe as usize] = dim
            return
        }
        probe = probe + 1
        if probe >= 2048 { probe = 0 }
        iters = iters + 1
    }
}

// Look up the dimension vector for a unit hash (returns 0 if not registered)
fn unit_lookup_dim(h: i64) -> i64 with Panic {
    if h == 0 { return 0 }
    var idx: i64 = h % 2048
    if idx < 0 { idx = idx + 2048 }
    var probe: i64 = idx
    var iters: i64 = 0
    while iters < 2048 {
        if UNIT_HASH_TABLE[probe as usize] == 0 { return 0 }
        if UNIT_HASH_TABLE[probe as usize] == h { return UNIT_DIM_TABLE[probe as usize] }
        probe = probe + 1
        if probe >= 2048 { probe = 0 }
        iters = iters + 1
    }
    return 0
}

// Compute gl_name_hash from raw byte values (for init_unit_table without src buffer)
// hash = len * 1000003 + sum(byte[i] * (i+1) * 31)
fn hash_1(b0: i64) -> i64                        { return 1000003 + b0 * 31 }
fn hash_2(b0: i64, b1: i64) -> i64               { return 2000006 + b0 * 31 + b1 * 62 }
fn hash_3(b0: i64, b1: i64, b2: i64) -> i64      { return 3000009 + b0 * 31 + b1 * 62 + b2 * 93 }
fn hash_4(b0: i64, b1: i64, b2: i64, b3: i64) -> i64 { return 4000012 + b0 * 31 + b1 * 62 + b2 * 93 + b3 * 124 }

// Preload standard unit systems: SI, CGS, Imperial, Astronomical, Pharmacological, Atomic
// dim_pack encoding: 4-bit 2's-complement per field, 0 = dimensionless
// Derived dim_pack values:
//   DIM_FORCE    = 1|(1<<4)|(14<<8) = 3601  [mass^1*len^1*time^-2, -2 → 14 in 4-bit 2's-c]
//   DIM_ENERGY   = 1|(2<<4)|(14<<8) = 3617  [mass^1*len^2*time^-2]
//   DIM_POWER    = 1|(2<<4)|(13<<8) = 3361  [mass^1*len^2*time^-3, -3 → 13]
//   DIM_FREQ     = (15<<8) = 3840           [time^-1, -1 → 15]
//   DIM_PRESSURE = 1|(15<<4)|(14<<8) = 3825 [mass^1*len^-1*time^-2, len^-1 → 15]
//   DIM_VOLUME   = (3<<4) = 48              [length^3]
fn init_unit_table() with Mut, Panic {
    let DIM_MASS     = 1;       let DIM_LEN    = 16;     let DIM_TIME    = 256
    let DIM_TEMP     = 4096;    let DIM_AMOUNT = 65536;  let DIM_CURRENT = 1048576
    let DIM_LUM      = 16777216
    let DIM_FORCE    = 3601;    let DIM_ENERGY = 3617;   let DIM_POWER   = 3361
    let DIM_FREQ     = 3840;    let DIM_PRESSURE = 3825; let DIM_VOLUME  = 48
    // ASCII byte values for hash helpers
    let A=65; let G=71; let H=72; let I=73; let J=74; let K=75; let L=76; let M=77
    let N=78; let P=80; let U=85; let V=86; let W=87
    let a=97; let b=98; let c=99; let d=100; let e=101; let f=102; let g=103; let h=104
    let i=105; let k=107; let l=108; let m=109; let n=110; let o=111; let p=112
    let r=114; let s=115; let t=116; let u=117; let y=121; let z=122

    // ── SI mass ───────────────────────────────────────────────────────────────
    unit_register_h(hash_2(k, g),   DIM_MASS)  // kg
    unit_register_h(hash_1(g),      DIM_MASS)  // g
    unit_register_h(hash_2(m, g),   DIM_MASS)  // mg
    unit_register_h(hash_2(n, g),   DIM_MASS)  // ng
    unit_register_h(3019105,        DIM_MASS)  // mcg  hash_3(m,c,g)=3000009+109*31+99*62+103*93=3019105
    unit_register_h(hash_1(u),      DIM_MASS)  // u    (atomic mass unit)
    unit_register_h(3020655,        DIM_MASS)  // amu  hash_3(a,m,u)=3000009+97*31+109*62+117*93=3020655
    unit_register_h(hash_2(l, b),   DIM_MASS)  // lb   (pound)
    unit_register_h(hash_2(o, z),   DIM_MASS)  // oz   (ounce)
    unit_register_h(4034050,        DIM_MASS)  // Msun hash_4(M,s,u,n)=4000012+77*31+115*62+117*93+110*124=4034050

    // ── SI length ─────────────────────────────────────────────────────────────
    unit_register_h(hash_1(m),      DIM_LEN)   // m
    unit_register_h(hash_2(c, m),   DIM_LEN)   // cm
    unit_register_h(hash_2(k, m),   DIM_LEN)   // km   hash=2010081
    unit_register_h(2010143,        DIM_LEN)   // mm   hash_2(m,m)=2000006+109*31+109*62=2010143
    unit_register_h(hash_2(n, m),   DIM_LEN)   // nm
    unit_register_h(hash_2(f, t),   DIM_LEN)   // ft   (foot)
    unit_register_h(hash_2(i, n),   DIM_LEN)   // in   (inch) note: same hash 2010081 as km → both length OK
    unit_register_h(2009895,        DIM_LEN)   // mi   (mile) hash_2(m,i)=2000006+109*31+105*62=2009895
    unit_register_h(2009957,        DIM_LEN)   // yd   (yard) hash_2(y,d)=2000006+121*31+100*62=2009957
    unit_register_h(hash_2(A, U),   DIM_LEN)   // AU   (astronomical unit)
    unit_register_h(hash_2(p, c),   DIM_LEN)   // pc   (parsec)
    unit_register_h(hash_2(l, y),   DIM_LEN)   // ly   (light-year)

    // ── SI time ───────────────────────────────────────────────────────────────
    unit_register_h(hash_1(s),       DIM_TIME)  // s
    unit_register_h(hash_2(m, s),    DIM_TIME)  // ms
    unit_register_h(2010546,         DIM_TIME)  // ns   hash_2(n,s)=2000006+110*31+115*62=2010546
    unit_register_h(hash_3(m, i, n), DIM_TIME)  // min
    unit_register_h(hash_1(h),       DIM_TIME)  // h    (hour)
    unit_register_h(hash_2(h, r),    DIM_TIME)  // hr
    unit_register_h(hash_1(d),       DIM_TIME)  // d    (day)
    unit_register_h(hash_2(y, r),    DIM_TIME)  // yr

    // ── SI current ────────────────────────────────────────────────────────────
    unit_register_h(hash_1(A),       DIM_CURRENT) // A
    unit_register_h(hash_2(m, A),    DIM_CURRENT) // mA

    // ── SI temperature ────────────────────────────────────────────────────────
    unit_register_h(hash_1(K),       DIM_TEMP)  // K
    unit_register_h(4027261,         DIM_TEMP)  // degC hash_4(d,e,g,C)=4000012+100*31+101*62+103*93+67*124=4027261
    unit_register_h(4027633,         DIM_TEMP)  // degF hash_4(d,e,g,F)=4027261-67*124+70*124=4027633

    // ── SI amount / luminosity ────────────────────────────────────────────────
    unit_register_h(hash_3(m, o, l), DIM_AMOUNT) // mol
    unit_register_h(3018175,         DIM_AMOUNT) // mEq  hash_3(m,E,q)=3000009+109*31+69*62+113*93=3018175
    unit_register_h(hash_2(c, d),    DIM_LUM)   // cd   (candela)

    // ── SI derived ────────────────────────────────────────────────────────────
    unit_register_h(hash_1(N),       DIM_FORCE)    // N   (Newton)
    unit_register_h(hash_1(J),       DIM_ENERGY)   // J   (Joule)
    unit_register_h(hash_2(k, J),    DIM_ENERGY)   // kJ
    unit_register_h(hash_1(W),       DIM_POWER)    // W   (Watt)
    unit_register_h(hash_2(k, W),    DIM_POWER)    // kW
    unit_register_h(hash_2(H, z),    DIM_FREQ)     // Hz
    unit_register_h(3019136,         DIM_FREQ)     // kHz  hash_3(k,H,z)=3000009+107*31+72*62+122*93=3019136
    unit_register_h(hash_2(P, a),    DIM_PRESSURE) // Pa
    unit_register_h(3017307,         DIM_PRESSURE) // kPa  hash_3(k,P,a)=3000009+107*31+80*62+97*93=3017307
    unit_register_h(hash_1(L),       DIM_VOLUME)   // L    (litre)
    unit_register_h(hash_2(m, L),    DIM_VOLUME)   // mL
    unit_register_h(2008345,         DIM_VOLUME)   // uL   hash_2(u,L)=2000006+117*31+76*62=2008345

    // ── CGS ───────────────────────────────────────────────────────────────────
    unit_register_h(hash_3(e, r, g), DIM_ENERGY)   // erg  (CGS energy = J in dimension)
    unit_register_h(hash_3(d, y, n), DIM_FORCE)    // dyn  (CGS force = N in dimension)

    // ── Imperial pressure ─────────────────────────────────────────────────────
    unit_register_h(hash_3(p, s, i), DIM_PRESSURE) // psi
    unit_register_h(hash_3(b, a, r), DIM_PRESSURE) // bar
    unit_register_h(hash_3(a, t, m), DIM_PRESSURE) // atm

    // ── Pharmacological ───────────────────────────────────────────────────────
    unit_register_h(4029617,         DIM_PRESSURE) // mmHg hash_4(m,m,H,g)=4000012+109*31+109*62+72*93+103*124=4029617
    unit_register_h(hash_2(I, U),    0)            // IU   (dimensionless biological unit)

    // ── Atomic / nuclear ──────────────────────────────────────────────────────
    unit_register_h(hash_2(e, V),    DIM_ENERGY)   // eV
    unit_register_h(3017586,         DIM_ENERGY)   // keV  hash_3(k,e,V)=3000009+107*31+101*62+86*93=3017586
    unit_register_h(3016656,         DIM_ENERGY)   // MeV  hash_3(M,e,V)=3000009+77*31+101*62+86*93=3016656
    unit_register_h(3016470,         DIM_ENERGY)   // GeV  hash_3(G,e,V)=3000009+71*31+101*62+86*93=3016470
}

fn gl_find(ns: i64, ne: i64) -> i64 with Panic, Mut {
    let h = gl_name_hash(ns, ne)
    var i: i64 = 0
    while i < GL_COUNT {
        if GL[(i * 4 + 0) as usize] == h { return i }
        i = i + 1
    }
    return -1
}

fn gl_add(ns: i64, ne: i64, esiz: i64, alen: i64) -> i64 with Mut, Panic {
    if GL_COUNT >= global_cap() {
        note_limit_error(2)
        return -1
    }
    var sz: i64 = 8
    if alen > 0 { sz = alen * esiz }
    let aligned = (sz + 7) / 8 * 8
    let gix = GL_COUNT
    GL[(GL_COUNT * 4 + 0) as usize] = gl_name_hash(ns, ne)
    GL[(GL_COUNT * 4 + 1) as usize] = GL_BSS_SIZE
    GL[(GL_COUNT * 4 + 2) as usize] = esiz
    GL[(GL_COUNT * 4 + 3) as usize] = alen
    GL_COUNT = GL_COUNT + 1
    GL_BSS_SIZE = GL_BSS_SIZE + aligned
    return gix
}

// Per-function local variable table (reset per function)
var VAR_NS: [i64; 1024] = [0; 1024]
var VAR_NE: [i64; 1024] = [0; 1024]
var VAR_SLOT: [i64; 1024] = [0; 1024]
var VAR_LEN_SLOT: [i64; 1024] = [0; 1024]
var VAR_ALEN: [i64; 1024] = [0; 1024]
var VAR_ESIZ: [i64; 1024] = [0; 1024]
var VAR_IS_F64: [i64; 1024] = [0; 1024]
var VAR_IS_CLOSURE: [i64; 1024] = [0; 1024]
var VAR_MUT: [i64; 1024] = [0; 1024]
var VAR_COUNT: i64 = 0
var NEXT_SLOT: i64 = 1
var FRAME_PATCH_COUNT: i64 = 0
var FRAME_PATCH_OFF: [i64; 16384] = [0; 16384]
var FN_FRAME_SIZE: [i64; 16384] = [0; 16384]
var LAST_EXPR_IS_CLOSURE: i64 = 0
// Scratch globals for float scientific exponent (avoids extra locals in compile_primary)
var FL_SCI_SCRATCH: i64 = 0
var FL_SCI_NEG: i64 = 0
var FL_FRAC_DIGITS: i64 = 0
var LAST_STMT_HAS_VALUE: i64 = 0

// Constant table (pub const NAME: TYPE = VALUE)
var CONST_NS: [i64; 512] = [0; 512]
var CONST_NE: [i64; 512] = [0; 512]
var CONST_VAL: [i64; 512] = [0; 512]
var CONST_COUNT: i64 = 0
var CONST_FOUND_VAL: i64 = 0

// Token kinds: inlined as integers (boot4 doesn't init scalar globals)

// ─── Helpers ───
fn sb(i: i64) -> i64 with Panic, Mut { if i >= 0 && i < SRC_LEN { return SRC[i as usize] as i64 & 0xFF }; return 0 }
fn em(b: i64) with Mut { if CL < 33554432 { CD[CL as usize] = b as i8; CL = CL + 1 } }
fn em32(v: i64) with Mut { em(v & 0xFF); em((v >> 8) & 0xFF); em((v >> 16) & 0xFF); em((v >> 24) & 0xFF) }
fn em64(v: i64) with Mut { em32(v & 0xFFFFFFFF); em32((v >> 32) & 0xFFFFFFFF) }

fn emit_load_abs_addr_to_rax_x86(addr: i64) with Mut {
    em(0x48); em(0xb8); em64(addr)
}

fn emit_load_abs_qword_to_rax_x86(addr: i64) with Mut {
    emit_load_abs_addr_to_rax_x86(addr)
    em(0x48); em(0x8b); em(0x00)
}

fn emit_store_rax_to_abs_qword_x86(addr: i64) with Mut {
    em(0x48); em(0x89); em(0xc1)
    emit_load_abs_addr_to_rax_x86(addr)
    em(0x48); em(0x89); em(0x08)
    em(0x48); em(0x89); em(0xc8)
}

fn emit_store_imm64_to_abs_qword_x86(addr: i64, value: i64) with Mut {
    emit_imm64(value)
    emit_store_rax_to_abs_qword_x86(addr)
}

fn emit_load_stack_qword_to_rax_x86(disp: i64) with Mut {
    em(0x48); em(0x8b); em(0x84); em(0x24); em32(disp)
}

fn emit_load_call_arg_to_rax_x86(argc: i64, arg_idx: i64) with Mut {
    emit_load_stack_qword_to_rax_x86((argc - 1 - arg_idx) * 8)
}

fn emit_call_rax_x86(argc: i64) with Mut {
    emit_setup_direct_call_args_x86(argc)
    emit_prepare_stack_call_args_x86(argc, 6)
    em(0xff); em(0xd0)
    emit_drop_call_args_x86(argc + call_extra_stack_args_x86(argc, 6))
}

fn emit_call_abs_qword_x86(addr: i64, argc: i64) with Mut {
    emit_load_abs_qword_to_rax_x86(addr)
    emit_call_rax_x86(argc)
}

fn emit_inline_cstr_from_string_x86(s: string) with Mut, Panic, Div {
    let n = str_len(s)
    em(0xe9)
    em32(n + 1)
    let start = CL
    var i: i64 = 0
    while i < n {
        em(str_char_at(s, i))
        i = i + 1
    }
    em(0)
    let disp = start - (CL + 7)
    em(0x48); em(0x8d); em(0x05); em32(disp)
}

fn emit_inline_cstr_from_src_x86(ns: i64, ne: i64) with Mut, Panic {
    let n = ne - ns
    em(0xe9)
    em32(n + 1)
    let start = CL
    var i: i64 = 0
    while i < n {
        em(sb(ns + i))
        i = i + 1
    }
    em(0)
    let disp = start - (CL + 7)
    em(0x48); em(0x8d); em(0x05); em32(disp)
}

fn emit_inline_cstr_from_ptx_x86(off: i64, len: i64) with Mut, Panic {
    em(0xe9)
    em32(len + 1)
    let start = CL
    var i: i64 = 0
    while i < len {
        em(PTX_DATA[(off + i) as usize] as i64 & 0xFF)
        i = i + 1
    }
    em(0)
    let disp = start - (CL + 7)
    em(0x48); em(0x8d); em(0x05); em32(disp)
}

fn emit_gpu_diag_once_x86(msg: string) with Mut, Panic, Div {
    emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + GPU_RT_DIAG_BSS_OFF)
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x85)
    let skip = CL
    em32(0)
    emit_inline_cstr_from_string_x86(msg)
    emit_print_cstr()
    emit_store_imm64_to_abs_qword_x86(GL_BSS_BASE + GPU_RT_DIAG_BSS_OFF, 1)
    patch32(skip, CL)
}

fn emit_mark_gpu_unavailable_x86(msg: string) with Mut, Panic, Div {
    emit_store_imm64_to_abs_qword_x86(GL_BSS_BASE + GPU_RT_STATE_BSS_OFF, 0 - 1)
    emit_gpu_diag_once_x86(msg)
}

fn emit_gpu_resolve_symbol_x86(sym: string, sym_fallback: string, dst_addr: i64, fail_msg: string) with Mut, Panic, Div {
    emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + GPU_RT_LIBCUDA_HANDLE_BSS_OFF)
    em(0x50)
    emit_inline_cstr_from_string_x86(sym)
    em(0x50)
    emit_call_abs_qword_x86(gpu_dyn_linux_x86_got_slot_dlsym(), 2)
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x85)
    let have_primary = CL
    em32(0)
    if str_len(sym_fallback) > 0 {
        emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + GPU_RT_LIBCUDA_HANDLE_BSS_OFF)
        em(0x50)
        emit_inline_cstr_from_string_x86(sym_fallback)
        em(0x50)
        emit_call_abs_qword_x86(gpu_dyn_linux_x86_got_slot_dlsym(), 2)
    }
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x85)
    let have_symbol = CL
    em32(0)
    emit_mark_gpu_unavailable_x86(fail_msg)
    em(0x31); em(0xc0)
    em(0xe9)
    let end_jmp = CL
    em32(0)
    patch32(have_primary, CL)
    patch32(have_symbol, CL)
    emit_store_rax_to_abs_qword_x86(dst_addr)
    emit_imm64(1)
    patch32(end_jmp, CL)
}

fn emit_try_gpu_runtime_init_x86() with Mut, Panic, Div {
    if TARGET_OS != 0 || TARGET_ARCH != 0 {
        emit_mark_gpu_unavailable_x86("GPU unavailable: native CUDA runtime unsupported on this target\n")
        em(0x31); em(0xc0)
        return
    }
    NEEDS_GPU_RUNTIME_DYNLINK = 1
    emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + GPU_RT_STATE_BSS_OFF)
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84)
    let do_init = CL
    em32(0)
    em(0x48); em(0x83); em(0xf8); em(1)
    em(0x0f); em(0x84)
    let already_ok = CL
    em32(0)
    em(0x31); em(0xc0)
    em(0xe9)
    let end_jmp = CL
    em32(0)

    patch32(do_init, CL)
    emit_inline_cstr_from_string_x86("libcuda.so.1")
    em(0x50)
    emit_imm64(2)
    em(0x50)
    emit_call_abs_qword_x86(gpu_dyn_linux_x86_got_slot_dlopen(), 2)
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x85)
    let have_lib = CL
    em32(0)
    emit_mark_gpu_unavailable_x86("GPU unavailable: libcuda.so not found\n")
    em(0x31); em(0xc0)
    em(0xe9)
    let after_fail_no_lib = CL
    em32(0)
    patch32(have_lib, CL)
    emit_store_rax_to_abs_qword_x86(GL_BSS_BASE + GPU_RT_LIBCUDA_HANDLE_BSS_OFF)

    emit_gpu_resolve_symbol_x86("cuInit", "", GL_BSS_BASE + GPU_RT_CUINIT_PTR_BSS_OFF, "GPU unavailable: cuInit unresolved\n")
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84)
    let fail_after_resolve = CL
    em32(0)
    emit_gpu_resolve_symbol_x86("cuDeviceGet", "", GL_BSS_BASE + GPU_RT_CUDEVICEGET_PTR_BSS_OFF, "GPU unavailable: cuDeviceGet unresolved\n")
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let fail_after_resolve_b = CL; em32(0)
    emit_gpu_resolve_symbol_x86("cuCtxCreate_v2", "cuCtxCreate", GL_BSS_BASE + GPU_RT_CUCTXCREATE_PTR_BSS_OFF, "GPU unavailable: cuCtxCreate unresolved\n")
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let fail_after_resolve_c = CL; em32(0)
    emit_gpu_resolve_symbol_x86("cuCtxSynchronize", "", GL_BSS_BASE + GPU_RT_CUCTXSYNC_PTR_BSS_OFF, "GPU unavailable: cuCtxSynchronize unresolved\n")
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let fail_after_resolve_d = CL; em32(0)
    emit_gpu_resolve_symbol_x86("cuModuleLoadData", "", GL_BSS_BASE + GPU_RT_CUMODULELOADDATA_PTR_BSS_OFF, "GPU unavailable: cuModuleLoadData unresolved\n")
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let fail_after_resolve_e = CL; em32(0)
    emit_gpu_resolve_symbol_x86("cuModuleGetFunction", "", GL_BSS_BASE + GPU_RT_CUMODULEGETFUNCTION_PTR_BSS_OFF, "GPU unavailable: cuModuleGetFunction unresolved\n")
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let fail_after_resolve_f = CL; em32(0)
    emit_gpu_resolve_symbol_x86("cuMemAlloc_v2", "cuMemAlloc", GL_BSS_BASE + GPU_RT_CUMEMALLOC_PTR_BSS_OFF, "GPU unavailable: cuMemAlloc unresolved\n")
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let fail_after_resolve_g = CL; em32(0)
    emit_gpu_resolve_symbol_x86("cuMemFree_v2", "cuMemFree", GL_BSS_BASE + GPU_RT_CUMEMFREE_PTR_BSS_OFF, "GPU unavailable: cuMemFree unresolved\n")
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let fail_after_resolve_h = CL; em32(0)
    emit_gpu_resolve_symbol_x86("cuMemcpyHtoD_v2", "cuMemcpyHtoD", GL_BSS_BASE + GPU_RT_CUMEMCPYHTOD_PTR_BSS_OFF, "GPU unavailable: cuMemcpyHtoD unresolved\n")
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let fail_after_resolve_i = CL; em32(0)
    emit_gpu_resolve_symbol_x86("cuMemcpyDtoH_v2", "cuMemcpyDtoH", GL_BSS_BASE + GPU_RT_CUMEMCPYDTOH_PTR_BSS_OFF, "GPU unavailable: cuMemcpyDtoH unresolved\n")
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let fail_after_resolve_j = CL; em32(0)
    emit_gpu_resolve_symbol_x86("cuLaunchKernel", "", GL_BSS_BASE + GPU_RT_CULAUNCHKERNEL_PTR_BSS_OFF, "GPU unavailable: cuLaunchKernel unresolved\n")
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let fail_after_resolve_k = CL; em32(0)

    emit_imm64(0)
    em(0x50)
    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUINIT_PTR_BSS_OFF, 1)
    em(0x85); em(0xc0)
    em(0x0f); em(0x85)
    let fail_init = CL
    em32(0)

    emit_imm64(GL_BSS_BASE + GPU_RT_DEVICE_BSS_OFF)
    em(0x50)
    emit_imm64(0)
    em(0x50)
    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUDEVICEGET_PTR_BSS_OFF, 2)
    em(0x85); em(0xc0)
    em(0x0f); em(0x85)
    let fail_device = CL
    em32(0)

    emit_imm64(GL_BSS_BASE + GPU_RT_CTX_BSS_OFF)
    em(0x50)
    emit_imm64(0)
    em(0x50)
    emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + GPU_RT_DEVICE_BSS_OFF)
    em(0x50)
    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUCTXCREATE_PTR_BSS_OFF, 3)
    em(0x85); em(0xc0)
    em(0x0f); em(0x85)
    let fail_ctx = CL
    em32(0)

    emit_store_imm64_to_abs_qword_x86(GL_BSS_BASE + GPU_RT_STATE_BSS_OFF, 1)
    emit_imm64(1)
    em(0xe9)
    let after_success = CL
    em32(0)

    patch32(fail_after_resolve, CL)
    patch32(fail_after_resolve_b, CL)
    patch32(fail_after_resolve_c, CL)
    patch32(fail_after_resolve_d, CL)
    patch32(fail_after_resolve_e, CL)
    patch32(fail_after_resolve_f, CL)
    patch32(fail_after_resolve_g, CL)
    patch32(fail_after_resolve_h, CL)
    patch32(fail_after_resolve_i, CL)
    patch32(fail_after_resolve_j, CL)
    patch32(fail_after_resolve_k, CL)
    patch32(fail_init, CL)
    patch32(fail_device, CL)
    patch32(fail_ctx, CL)
    emit_mark_gpu_unavailable_x86("GPU unavailable: CUDA initialization failed\n")
    em(0x31); em(0xc0)
    em(0xe9)
    let after_fail = CL
    em32(0)

    patch32(already_ok, CL)
    emit_imm64(1)
    patch32(after_fail_no_lib, CL)
    patch32(after_success, CL)
    patch32(after_fail, CL)
    patch32(end_jmp, CL)
}

fn emit_load_gpu_thread_id_x86() with Mut {
    emit_load_abs_addr_to_rax_x86(GL_BSS_BASE + GPU_EMU_THREAD_ID_BSS_OFF)
    em(0x48); em(0x8b); em(0x00)
}

fn emit_store_gpu_thread_id_x86() with Mut {
    em(0x48); em(0x89); em(0xc1)
    emit_load_abs_addr_to_rax_x86(GL_BSS_BASE + GPU_EMU_THREAD_ID_BSS_OFF)
    em(0x48); em(0x89); em(0x08)
}

fn emit_load_rsp_arg_x86(reg_idx: i64, disp: i64) with Mut {
    if reg_idx == 0 { em(0x48); em(0x8b); em(0xbc); em(0x24); em32(disp); return }
    if reg_idx == 1 { em(0x48); em(0x8b); em(0xb4); em(0x24); em32(disp); return }
    if reg_idx == 2 { em(0x48); em(0x8b); em(0x94); em(0x24); em32(disp); return }
    if reg_idx == 3 { em(0x48); em(0x8b); em(0x8c); em(0x24); em32(disp); return }
    if reg_idx == 4 { em(0x4c); em(0x8b); em(0x84); em(0x24); em32(disp); return }
    if reg_idx == 5 { em(0x4c); em(0x8b); em(0x8c); em(0x24); em32(disp); return }
}

fn emit_setup_call_args_shift_x86(argc: i64, shift: i64) with Mut {
    var arg_idx: i64 = 0
    while arg_idx < argc && arg_idx + shift < 6 {
        emit_load_rsp_arg_x86(arg_idx + shift, (argc - 1 - arg_idx) * 8)
        arg_idx = arg_idx + 1
    }
}

fn emit_setup_direct_call_args_x86(argc: i64) with Mut {
    emit_setup_call_args_shift_x86(argc, 0)
}

fn emit_setup_closure_call_args_x86(argc: i64) with Mut {
    emit_setup_call_args_shift_x86(argc, 1)
}

fn call_extra_stack_args_x86(argc: i64, regc: i64) -> i64 {
    if argc > regc + 1 { return argc - regc }
    return 0
}

fn emit_prepare_stack_call_args_x86(argc: i64, regc: i64) with Mut {
    let extra = call_extra_stack_args_x86(argc, regc)
    if extra <= 1 { return }
    let scratch_bytes = extra * 8
    if scratch_bytes < 128 {
        em(0x48); em(0x83); em(0xec); em(scratch_bytes)
    } else {
        em(0x48); em(0x81); em(0xec); em32(scratch_bytes)
    }
    var i: i64 = 0
    while i < extra {
        em(0x48); em(0x8b); em(0x84); em(0x24); em32(scratch_bytes + i * 8)
        let dst = (extra - 1 - i) * 8
        if dst == 0 {
            em(0x48); em(0x89); em(0x04); em(0x24)
        } else {
            em(0x48); em(0x89); em(0x84); em(0x24); em32(dst)
        }
        i = i + 1
    }
}

fn emit_direct_fn_call_x86(fi: i64, argc: i64) with Mut, Panic, Div {
    let ret_slots = ret_agg_nslots(FN_RET_TY[fi as usize], FN_RET_HASH[fi as usize])
    if ret_slots > 0 {
        let ret_base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + ret_slots
        emit_setup_call_args_shift_x86(argc, 1)
        emit_prepare_stack_call_args_x86(argc, 5)
        em(0x48); em(0x8d); em(0x85)
        em32(0 - (ret_base + ret_slots - 1) * 8)
        em(0x48); em(0x89); em(0xc7)
        em(0xe8)
        PATCH_OFF[PATCH_COUNT as usize] = CL
        PATCH_FN[PATCH_COUNT as usize] = fi
        PATCH_KIND[PATCH_COUNT as usize] = 0
        PATCH_COUNT = PATCH_COUNT + 1
        em32(0)
        emit_drop_call_args_x86(argc + call_extra_stack_args_x86(argc, 5))
        return
    }
    emit_setup_direct_call_args_x86(argc)
    emit_prepare_stack_call_args_x86(argc, 6)
    em(0xe8)
    PATCH_OFF[PATCH_COUNT as usize] = CL
    PATCH_FN[PATCH_COUNT as usize] = fi
    PATCH_KIND[PATCH_COUNT as usize] = 0
    PATCH_COUNT = PATCH_COUNT + 1
    em32(0)
    emit_drop_call_args_x86(argc + call_extra_stack_args_x86(argc, 6))
}

fn emit_indirect_fn_call_x86(ptr_slot: i64, argc: i64, ret_ty: i64, ret_hash: i64) with Mut, Panic, Div {
    let ret_slots = ret_agg_nslots(ret_ty, ret_hash)
    if ret_slots > 0 {
        let ret_base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + ret_slots
        emit_setup_call_args_shift_x86(argc, 1)
        emit_prepare_stack_call_args_x86(argc, 5)
        em(0x48); em(0x8d); em(0x85)
        em32(0 - (ret_base + ret_slots - 1) * 8)
        em(0x48); em(0x89); em(0xc7)
        emit_load_var(ptr_slot)
        em(0xff); em(0xd0)
        emit_drop_call_args_x86(argc + call_extra_stack_args_x86(argc, 5))
        return
    }
    emit_setup_direct_call_args_x86(argc)
    emit_prepare_stack_call_args_x86(argc, 6)
    emit_load_var(ptr_slot)
    em(0xff); em(0xd0)
    emit_drop_call_args_x86(argc + call_extra_stack_args_x86(argc, 6))
}

fn emit_drop_call_args_x86(argc: i64) with Mut {
    let bytes = argc * 8
    if bytes <= 0 { return }
    if bytes < 128 {
        em(0x48); em(0x83); em(0xc4); em(bytes)
    } else {
        em(0x48); em(0x81); em(0xc4); em32(bytes)
    }
}

fn emit_store_incoming_arg_x86(arg_idx: i64, slot: i64) with Mut {
    if arg_idx == 0 { em(0x48); em(0x89); em(0xf8); emit_store_var(slot); return }  // mov rax, rdi
    if arg_idx == 1 { em(0x48); em(0x89); em(0xf0); emit_store_var(slot); return }  // mov rax, rsi
    if arg_idx == 2 { em(0x48); em(0x89); em(0xd0); emit_store_var(slot); return }  // mov rax, rdx
    if arg_idx == 3 { em(0x48); em(0x89); em(0xc8); emit_store_var(slot); return }  // mov rax, rcx
    if arg_idx == 4 { em(0x4c); em(0x89); em(0xc0); emit_store_var(slot); return }  // mov rax, r8
    if arg_idx == 5 { em(0x4c); em(0x89); em(0xc8); emit_store_var(slot); return }  // mov rax, r9
    em(0x48); em(0x8b); em(0x85); em32(16 + (arg_idx - 6) * 8)
    emit_store_var(slot)
}

// Write 32-bit value at arbitrary offset in CD[] (for ARM64 branch patching)
fn em32_at(off: i64, v: i64) with Mut, Panic {
    CD[off as usize] = (v & 0xFF) as i8
    CD[(off + 1) as usize] = ((v >> 8) & 0xFF) as i8
    CD[(off + 2) as usize] = ((v >> 16) & 0xFF) as i8
    CD[(off + 3) as usize] = ((v >> 24) & 0xFF) as i8
}
fn record_frame_patch() with Mut {
    if FRAME_PATCH_COUNT < 4096 { FRAME_PATCH_OFF[FRAME_PATCH_COUNT as usize] = CL; FRAME_PATCH_COUNT = FRAME_PATCH_COUNT + 1 }
}

// Read 32-bit value from CD[] (for ARM64 branch patching)
fn rd32_at(off: i64) -> i64 with Panic, Mut {
    return (CD[off as usize] as i64 & 0xFF) |
           ((CD[(off + 1) as usize] as i64 & 0xFF) << 8) |
           ((CD[(off + 2) as usize] as i64 & 0xFF) << 16) |
           ((CD[(off + 3) as usize] as i64 & 0xFF) << 24)
}

// ─── ARM64 emit helpers ───
fn emit_load_var_a64(slot: i64) with Mut, Panic {
    let off = slot * 8
    if off <= 4095 {
        // sub x9, x29, #off
        em32(0xD1000000 | (off << 10) | (29 << 5) | 9)
    } else {
        emit_imm64_reg_a64(9, off)
        // sub x9, x29, x9
        em32(0xCB090000 | (29 << 5) | 9)
    }
    // ldr x0, [x9]
    em32(0xF9400120)
}

fn emit_store_var_a64(slot: i64) with Mut, Panic {
    let off = slot * 8
    if off <= 4095 {
        em32(0xD1000000 | (off << 10) | (29 << 5) | 9)
    } else {
        emit_imm64_reg_a64(9, off)
        em32(0xCB090000 | (29 << 5) | 9)
    }
    // str x0, [x9]
    em32(0xF9000120)
}

fn emit_push_a64() with Mut { em32(0xF81F0FE0) }  // str x0, [sp, #-16]!

fn emit_pop_x1_a64() with Mut { em32(0xF8410FE1) }  // ldr x1, [sp], #16

fn emit_pop_x0_a64() with Mut { em32(0xF8410FE0) }  // ldr x0, [sp], #16

fn emit_pop_x2_a64() with Mut { em32(0xF8410FE2) }  // ldr x2, [sp], #16

fn emit_copy_words_x10_x11_a64(words: i64) with Mut {
    if words <= 0 { return }
    emit_imm64_reg_a64(12, words)
    let loop_off = CL
    em32(0xF940014D)  // ldr x13, [x10]
    em32(0xF900016D)  // str x13, [x11]
    em32(0x9100214A)  // add x10, x10, #8
    em32(0x9100216B)  // add x11, x11, #8
    em32(0xF100058C)  // subs x12, x12, #1
    let br_off = CL
    let rel = (loop_off - br_off) / 4
    em32(0x54000001 | ((rel & 0x7FFFF) << 5))  // b.ne loop
}

fn emit_zero_words_x11_a64(words: i64) with Mut {
    if words <= 0 { return }
    emit_imm64_reg_a64(12, words)
    em32(0xD280000D)  // mov x13, #0
    let loop_off = CL
    em32(0xF900016D)  // str x13, [x11]
    em32(0x9100216B)  // add x11, x11, #8
    em32(0xF100058C)  // subs x12, x12, #1
    let br_off = CL
    let rel = (loop_off - br_off) / 4
    em32(0x54000001 | ((rel & 0x7FFFF) << 5))  // b.ne loop
}

fn emit_fill_words_x13_x11_a64(words: i64) with Mut {
    if words <= 0 { return }
    emit_imm64_reg_a64(12, words)
    let loop_off = CL
    em32(0xF900016D)  // str x13, [x11]
    em32(0x9100216B)  // add x11, x11, #8
    em32(0xF100058C)  // subs x12, x12, #1
    let br_off = CL
    let rel = (loop_off - br_off) / 4
    em32(0x54000001 | ((rel & 0x7FFFF) << 5))  // b.ne loop
}

fn emit_drop_call_args_a64(argc: i64) with Mut {
    let bytes = argc * 16
    if bytes <= 0 { return }
    if bytes <= 4095 {
        em32(0x91000000 | ((bytes & 0xFFF) << 10) | (31 << 5) | 31)
        return
    }
    emit_imm64_reg_a64(9, bytes)
    em32(0x8B0903FF)  // add sp, sp, x9
}

fn emit_direct_fn_call_a64(fi: i64, argc: i64) with Mut {
    if argc >= 8 { em32(0xF8410FE7) }
    if argc >= 7 { em32(0xF8410FE6) }
    if argc >= 6 { em32(0xF8410FE5) }
    if argc >= 5 { em32(0xF8410FE4) }
    if argc >= 4 { em32(0xF8410FE3) }
    if argc >= 3 { emit_pop_x2_a64() }
    if argc >= 2 { emit_pop_x1_a64() }
    if argc >= 1 { emit_pop_x0_a64() }
    PATCH_OFF[PATCH_COUNT as usize] = CL
    PATCH_FN[PATCH_COUNT as usize] = fi
    PATCH_KIND[PATCH_COUNT as usize] = 0
    PATCH_COUNT = PATCH_COUNT + 1
    em32(0x94000000)
}

// Load 64-bit immediate into x0 via movz/movk chain
fn emit_imm64_a64(v: i64) with Mut {
    let v0 = v & 0xFFFF
    let v1 = (v >> 16) & 0xFFFF
    let v2 = (v >> 32) & 0xFFFF
    let v3 = (v >> 48) & 0xFFFF
    // movz x0, #v0
    em32(0xD2800000 | (v0 << 5))
    if v1 != 0 { em32(0xF2A00000 | (v1 << 5)) }        // movk x0, #v1, lsl #16
    if v2 != 0 { em32(0xF2C00000 | (v2 << 5)) }        // movk x0, #v2, lsl #32
    if v3 != 0 { em32(0xF2E00000 | (v3 << 5)) }        // movk x0, #v3, lsl #48
}

fn emit_store_incoming_arg_a64(arg_idx: i64, slot: i64) with Mut, Panic {
    if arg_idx == 0 { emit_store_var_a64(slot); return }
    if arg_idx == 1 { em32(0xAA0103E0); emit_store_var_a64(slot); return }
    if arg_idx == 2 { em32(0xAA0203E0); emit_store_var_a64(slot); return }
    if arg_idx == 3 { em32(0xAA0303E0); emit_store_var_a64(slot); return }
    if arg_idx == 4 { em32(0xAA0403E0); emit_store_var_a64(slot); return }
    if arg_idx == 5 { em32(0xAA0503E0); emit_store_var_a64(slot); return }
    if arg_idx == 6 { em32(0xAA0603E0); emit_store_var_a64(slot); return }
    if arg_idx == 7 { em32(0xAA0703E0); emit_store_var_a64(slot); return }
    let off_words = (16 + (arg_idx - 8) * 8) / 8
    em32(0xF9400000 | (off_words << 10) | (29 << 5) | 0)
    emit_store_var_a64(slot)
}

fn bind_array_local_from_x0_a64(ns: i64, ne: i64, ty_hash: i64) with Mut, Panic, Div {
    let esiz = arr_hash_esiz(ty_hash)
    let elem_ty = arr_hash_elem_ty(ty_hash)
    let nslots = arr_storage_slots(ty_hash)
    let ptr_slot = var_add_arr(ns, ne, nslots, esiz, elem_ty)
    if ptr_slot < 0 { return }
    let arr_vi = VAR_COUNT - 1
    let base = ptr_slot - nslots
    VAR_TY[arr_vi as usize] = 8
    VAR_TY_HASH[arr_vi as usize] = ty_hash
    em32(0xAA0003EA)  // mov x10, x0
    if LAST_LOCAL_BSS_SPILL != 0 {
        emit_imm64_reg_a64(0, LAST_LOCAL_BSS_ADDR)
        emit_copy_agg_to_ptr_a64(8, ty_hash)
    } else {
        emit_lea_var_a64(base + nslots - 1)
        em32(0xAA0003EB)  // mov x11, x0
        emit_copy_words_x10_x11_a64(nslots)
    }
    emit_store_var_a64(ptr_slot)
}

fn copy_array_into_local_slot_a64(slot: i64, ty_hash: i64) with Mut, Panic, Div {
    let nslots = arr_storage_slots(ty_hash)
    em32(0xAA0003EA)  // mov x10, x0 (src ptr)
    emit_load_var_a64(slot)
    em32(0xAA0003EB)  // mov x11, x0 (dst ptr)
    emit_copy_words_x10_x11_a64(nslots)
}

fn bind_struct_local_from_x0_a64(ns: i64, ne: i64, ty_hash: i64) with Mut, Panic, Div {
    let si = st_find(ty_hash)
    if si < 0 && knowledge_hash_is(ty_hash) == false {
        let slot = var_add(ns, ne)
        if slot < 0 { return }
        emit_store_var_a64(slot)
        let vix = VAR_COUNT - 1
        VAR_TY[vix as usize] = 6
        VAR_TY_HASH[vix as usize] = ty_hash
        return
    }
    let nslots = struct_like_nslots(ty_hash)
    let base = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + nslots
    let ptr_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    var linear_flag: i64 = 0
    if knowledge_hash_is(ty_hash) == false { linear_flag = ST_LINEAR[si as usize] }
    var out_ty: i64 = 0
    if knowledge_hash_is(ty_hash) == false { out_ty = 6 }
    if local_meta_add(ns, ne, ptr_slot, 0, 0, 8, 0, 0, 0, 0, linear_flag, 0, out_ty, ty_hash) < 0 {
        NEXT_SLOT = NEXT_SLOT - nslots - 1
        return
    }
    em32(0xAA0003EA)  // mov x10, x0
    emit_lea_var_a64(base + nslots - 1)
    em32(0xAA0003EB)  // mov x11, x0
    emit_copy_words_x10_x11_a64(nslots)
    emit_store_var_a64(ptr_slot)
}

fn copy_struct_into_local_slot_a64(slot: i64, ty_hash: i64) with Mut, Panic, Div {
    let si = st_find(ty_hash)
    if si < 0 && knowledge_hash_is(ty_hash) == false { emit_store_var_a64(slot); return }
    let nslots = struct_like_nslots(ty_hash)
    em32(0xAA0003EA)  // mov x10, x0 (src ptr)
    emit_load_var_a64(slot)
    em32(0xAA0003EB)  // mov x11, x0 (dst ptr)
    emit_copy_words_x10_x11_a64(nslots)
}

fn materialize_aggregate_expr_a64() with Mut, Panic, Div {
    if EXPR_TY == 8 {
        let nslots = arr_storage_slots(EXPR_TY_HASH)
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + nslots
        em32(0xAA0003EA)  // mov x10, x0
        emit_lea_var_a64(base + nslots - 1)
        em32(0xAA0003EB)  // mov x11, x0
        emit_copy_words_x10_x11_a64(nslots)
        return
    }
    if type_is_struct_like(EXPR_TY, EXPR_TY_HASH) {
        let nslots = struct_like_nslots(EXPR_TY_HASH)
        if nslots <= 0 { return }
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + nslots
        em32(0xAA0003EA)  // mov x10, x0
        emit_lea_var_a64(base + nslots - 1)
        em32(0xAA0003EB)  // mov x11, x0
        emit_copy_words_x10_x11_a64(nslots)
    }
}

fn copy_agg_into_struct_slots_a64(dst_start: i64, field_ty: i64, field_hash: i64) with Mut, Panic, Div {
    if field_ty == 8 {
        let nslots = arr_storage_slots(field_hash)
        em32(0xAA0003EA)
        emit_lea_var_a64(dst_start - (nslots - 1))
        em32(0xAA0003EB)
        emit_copy_words_x10_x11_a64(nslots)
        return
    }
    if field_ty == 6 || knowledge_hash_is(field_hash) {
        let nslots = struct_like_nslots(field_hash)
        if nslots > 0 {
            em32(0xAA0003EA)
            emit_lea_var_a64(dst_start - (nslots - 1))
            em32(0xAA0003EB)
            emit_copy_words_x10_x11_a64(nslots)
            return
        }
    }
    emit_store_var_a64(dst_start)
}

fn emit_copy_agg_to_ptr_a64(field_ty: i64, field_hash: i64) with Mut, Panic, Div {
    var nslots: i64 = 0
    if field_ty == 8 {
        nslots = arr_storage_slots(field_hash)
    } else if field_ty == 6 || knowledge_hash_is(field_hash) {
        nslots = struct_like_nslots(field_hash)
    }
    if nslots <= 0 { return }
    em32(0xAA0003EB)  // mov x11, x0
    emit_copy_words_x10_x11_a64(nslots)
}

fn fill_repeat_struct_array_slots_a64(dst_start: i64, field_hash: i64) with Mut, Panic, Div {
    let nslots = arr_storage_slots(field_hash)
    var i: i64 = 0
    while i < nslots {
        emit_store_var_a64(dst_start - i)
        i = i + 1
    }
}

fn stabilize_return_agg_a64(expr_ty: i64, expr_hash: i64) with Mut, Panic, Div {
    var nslots = ret_agg_nslots(CURRENT_RET_TY, CURRENT_RET_HASH)
    if nslots <= 0 { nslots = ret_agg_nslots(expr_ty, expr_hash) }
    if nslots <= 0 { return }
    em32(0xAA0003EA)  // mov x10, x0 (src ptr)
    emit_imm64_reg_a64(11, GL_BSS_BASE + RET_AGG_BSS_OFF)
    emit_copy_words_x10_x11_a64(nslots)
    emit_imm64_reg_a64(0, GL_BSS_BASE + RET_AGG_BSS_OFF)
}

// Load 64-bit immediate into arbitrary register
fn emit_imm64_reg_a64(rd: i64, v: i64) with Mut {
    let v0 = v & 0xFFFF
    let v1 = (v >> 16) & 0xFFFF
    let v2 = (v >> 32) & 0xFFFF
    let v3 = (v >> 48) & 0xFFFF
    em32(0xD2800000 | (v0 << 5) | rd)
    if v1 != 0 { em32(0xF2A00000 | (v1 << 5) | rd) }
    if v2 != 0 { em32(0xF2C00000 | (v2 << 5) | rd) }
    if v3 != 0 { em32(0xF2E00000 | (v3 << 5) | rd) }
}

// Patch ARM64 branch instruction at off to jump to target
fn patch_branch_a64(off: i64, target: i64) with Mut, Panic {
    let rel = (target - off) / 4
    let insn = rd32_at(off)
    let top = (insn >> 24) & 0xFF
    if top == 0x14 || top == 0x94 || top == 0x17 || top == 0x97 {
        // B or BL: 26-bit offset in bits [25:0]
        em32_at(off, (insn & 0xFC000000) | (rel & 0x3FFFFFF))
    } else {
        // B.cond / CBZ / CBNZ: 19-bit offset in bits [23:5]
        em32_at(off, (insn & 0xFF00001F) | ((rel & 0x7FFFF) << 5))
    }
}

fn patch_adr_a64(off: i64, target: i64, rd: i64) with Mut, Panic {
    let rel = target - off
    let immlo = rel & 0x3
    let immhi = (rel >> 2) & 0x7FFFF
    em32_at(off, 0x10000000 | ((immlo & 0x3) << 29) | ((immhi & 0x7FFFF) << 5) | rd)
}

// ARM64 address-of variable: lea x0, [x29 - slot*8]
fn emit_lea_var_a64(slot: i64) with Mut, Panic {
    let off = slot * 8
    if off <= 4095 {
        // sub x0, x29, #off
        em32(0xD1000000 | (off << 10) | (29 << 5) | 0)
    } else {
        emit_imm64_reg_a64(0, off)
        em32(0xCB000000 | (29 << 5) | 0)  // sub x0, x29, x0
    }
}

fn src_match(p: i64, l: i64, kw: string) -> bool with Panic, Mut {
    if l != str_len(kw) { return false }
    var i: i64 = 0
    while i < l { if sb(p + i) != str_char_at(kw, i) { return false }; i = i + 1 }
    return true
}

fn token_is_kernel_marker(ti: i64) -> bool with Panic, Mut {
    if ti < 0 || ti >= TC { return false }
    // Gen 20: Door 2 — kernel is now TK=79 (dedicated keyword token)
    if TK[ti as usize] == 79 { return true }
    // Fallback: also accept TK=3 with text "kernel" for older token streams
    if TK[ti as usize] != 3 { return false }
    return src_match(TS[ti as usize], TE[ti as usize] - TS[ti as usize], "kernel")
}

fn token_is_ident_text(ti: i64, text: string) -> bool with Panic, Mut {
    if ti < 0 || ti >= TC { return false }
    if TK[ti as usize] != 3 { return false }
    return src_match(TS[ti as usize], TE[ti as usize] - TS[ti as usize], text)
}

fn token_is_gpu_builtin_name(ti: i64) -> bool with Panic, Mut {
    if ti < 0 || ti >= TC { return false }
    if TK[ti as usize] != 3 { return false }
    let ns = TS[ti as usize]
    let ne = TE[ti as usize]
    if src_match(ns, ne - ns, "gpu_thread_id_x") { return true }
    if src_match(ns, ne - ns, "gpu_block_id_x") { return true }
    if src_match(ns, ne - ns, "gpu_block_dim_x") { return true }
    if src_match(ns, ne - ns, "gpu_barrier") { return true }
    if src_match(ns, ne - ns, "gpu_barrier_sync") { return true }
    return false
}

fn kernel_body_uses_gpu_builtins(body_start: i64) -> i64 with Panic, Mut {
    var p: i64 = body_start
    var depth: i64 = 1
    while p < TC && depth > 0 {
        if TK[p as usize] == 8 {
            depth = depth + 1
        } else if TK[p as usize] == 9 {
            depth = depth - 1
        } else if token_is_gpu_builtin_name(p) {
            return 1
        }
        p = p + 1
    }
    return 0
}

fn current_fn_allows_mutation() -> bool with Panic, Mut {
    if FN_IS_KERNEL[CURRENT_FN as usize] != 0 { return true }
    return (FN_EFFECTS[CURRENT_FN as usize] & 2) != 0
}

fn stmt_is_gpu_launch_perform(p0: i64) -> bool with Panic, Mut {
    if token_is_ident_text(p0, "perform") == false { return false }
    if token_is_ident_text(p0 + 1, "GPU") == false { return false }
    if TK[(p0 + 2) as usize] != 50 { return false }
    if token_is_ident_text(p0 + 3, "launch") == false { return false }
    return TK[(p0 + 4) as usize] == 6
}

fn stmt_is_gpu_sync_perform(p0: i64) -> bool with Panic, Mut {
    if token_is_ident_text(p0, "perform") == false { return false }
    if token_is_ident_text(p0 + 1, "GPU") == false { return false }
    if TK[(p0 + 2) as usize] != 50 { return false }
    if token_is_ident_text(p0 + 3, "sync") == false { return false }
    return TK[(p0 + 4) as usize] == 6
}

fn tok_is_unicode_epsilon(p: i64) -> bool with Panic, Mut {
    if TK[p as usize] != 3 { return false }
    let ns = TS[p as usize]
    let ne = TE[p as usize]
    if ne - ns != 2 { return false }
    return sb(ns) == 206 && sb(ns + 1) == 181
}

fn tok_is_unicode_bottom(p: i64) -> bool with Panic, Mut {
    if TK[p as usize] != 3 { return false }
    let ns = TS[p as usize]
    let ne = TE[p as usize]
    if ne - ns != 3 { return false }
    if sb(ns) != 226 || sb(ns + 1) != 138 { return false }
    return sb(ns + 2) == 165
}

fn cli_arg_eq(raw: string, kw: string) -> bool with Panic, Mut {
    let l = str_len(kw)
    if str_len(raw) != l { return false }
    var i: i64 = 0
    while i < l {
        if str_char_at(raw, i) != str_char_at(kw, i) { return false }
        i = i + 1
    }
    return true
}

fn name_is_lower(ns: i64, ne: i64) -> bool with Panic, Mut {
    if ne <= ns { return false }
    let c = sb(ns)
    return c >= 97 && c <= 122
}

fn name_eq(s1: i64, e1: i64, s2: i64, e2: i64) -> bool with Panic, Mut {
    let l = e1 - s1
    if l != e2 - s2 { return false }
    var i: i64 = 0
    while i < l { if sb(s1 + i) != sb(s2 + i) { return false }; i = i + 1 }
    return true
}

fn ty_is_numeric(k: i64) -> bool { return k == 1 || k == 2 }

fn tok_is_effect_name(p: i64) -> bool with Panic, Mut {
    if TK[p as usize] != 3 { return false }
    let ns = TS[p as usize]
    let ne = TE[p as usize]
    if src_match(ns, ne - ns, "IO") { return true }
    if src_match(ns, ne - ns, "Mut") { return true }
    if src_match(ns, ne - ns, "Panic") { return true }
    if src_match(ns, ne - ns, "Div") { return true }
    if src_match(ns, ne - ns, "Alloc") { return true }
    if src_match(ns, ne - ns, "Observe") { return true }
    if src_match(ns, ne - ns, "Audit") { return true }
    if src_match(ns, ne - ns, "Hypothesis") { return true }
    if src_match(ns, ne - ns, "MultiTest") { return true }
    return false
}

fn arr_ty_hash(alen: i64, esiz: i64, elem_ty: i64) -> i64 {
    if esiz == 1 { return alen * 32 + elem_ty * 2 + 1 }
    return alen * 32 + elem_ty * 2
}

fn arr_hash_alen(h: i64) -> i64 with Div, Mut {
    return h / 32
}

fn arr_hash_esiz(h: i64) -> i64 with Div, Mut {
    if h % 2 == 1 { return 1 }
    return 8
}

fn arr_hash_elem_ty(h: i64) -> i64 with Div, Mut {
    return (h % 32) / 2
}

fn arr_storage_slots(h: i64) -> i64 with Div, Mut {
    let alen = arr_hash_alen(h)
    if arr_hash_esiz(h) == 1 { return (alen + 7) / 8 }
    return alen
}

fn array_lit_count(p0: i64) -> i64 with Panic, Mut {
    var p = p0 + 1
    var br: i64 = 1
    var pa: i64 = 0
    var cu: i64 = 0
    var commas: i64 = 0
    var has_elem: i64 = 0
    while p < TC && br > 0 {
        let k = TK[p as usize]
        if br == 1 && pa == 0 && cu == 0 {
            if k == 28 { commas = commas + 1 }
            else if k != 42 { has_elem = 1 }
        }
        if k == 6 { pa = pa + 1 }
        if k == 7 { pa = pa - 1 }
        if k == 8 { cu = cu + 1 }
        if k == 9 { cu = cu - 1 }
        if k == 41 { br = br + 1 }
        if k == 42 { br = br - 1 }
        p = p + 1
    }
    if has_elem == 0 { return 0 }
    return commas + 1
}

fn array_init_is_repeat(p0: i64) -> bool with Panic, Mut {
    var p = p0 + 1
    var br: i64 = 1
    var pa: i64 = 0
    var cu: i64 = 0
    while p < TC && br > 0 {
        let k = TK[p as usize]
        if br == 1 && pa == 0 && cu == 0 && k == 27 { return true }
        if k == 6 { pa = pa + 1 }
        if k == 7 { pa = pa - 1 }
        if k == 8 { cu = cu + 1 }
        if k == 9 { cu = cu - 1 }
        if k == 41 { br = br + 1 }
        if k == 42 { br = br - 1 }
        p = p + 1
    }
    return false
}

fn knowledge_hash_is(h: i64) -> bool {
    return h < 0
}

fn unobserved_hash_base() -> i64 {
    return 2251799813685248
}

fn unobserved_hash_make(inner_ty: i64, inner_hash: i64) -> i64 {
    return unobserved_hash_base() + inner_ty * 64 + inner_hash * 4096
}

fn unobserved_hash_is(h: i64) -> bool {
    return h >= unobserved_hash_base()
}

fn unobserved_hash_inner_ty(h: i64) -> i64 with Panic, Div, Mut {
    return ((h - unobserved_hash_base()) / 64) % 64
}

fn unobserved_hash_inner_hash(h: i64) -> i64 with Panic, Div, Mut {
    return (h - unobserved_hash_base()) / 4096
}

fn knowledge_hash_make_mode(inner_ty: i64, inner_hash: i64, meta_mode: i64, eps_scaled: i64) -> i64 {
    let eps_code =
        if eps_scaled < -1 { 0 }
        else { if eps_scaled >= 0 { eps_scaled + 2 } else { 1 } }
    let packed_ty = inner_ty + meta_mode * 16
    let packed = eps_code + (packed_ty * 1048576) + (inner_hash * 67108864)
    return 0 - packed
}

fn knowledge_hash_make(inner_ty: i64, inner_hash: i64, eps_scaled: i64) -> i64 {
    return knowledge_hash_make_mode(inner_ty, inner_hash, 0, eps_scaled)
}

fn knowledge_hash_inner_ty(h: i64) -> i64 with Panic, Mut {
    let packed = 0 - h
    return ((packed / 1048576) % 64) % 16
}

fn knowledge_hash_meta_mode(h: i64) -> i64 with Panic, Mut {
    let packed = 0 - h
    return ((packed / 1048576) % 64) / 16
}

fn knowledge_hash_inner_hash(h: i64) -> i64 with Panic, Mut {
    let packed = 0 - h
    return packed / 67108864
}

fn knowledge_hash_eps(h: i64) -> i64 with Panic, Mut {
    let packed = 0 - h
    let eps_code = packed % 1048576
    if eps_code == 0 { return -2 }
    if eps_code == 1 { return -1 }
    return eps_code - 2
}

fn knowledge_hash_invalid(h: i64) -> bool with Panic, Mut {
    if knowledge_hash_is(h) == false { return false }
    return knowledge_hash_eps(h) < -1
}

fn knowledge_struct_hash() -> i64 {
    return 9 * 1000003
        + 75 * 1 * 31
        + 110 * 2 * 31
        + 111 * 3 * 31
        + 119 * 4 * 31
        + 108 * 5 * 31
        + 101 * 6 * 31
        + 100 * 7 * 31
        + 103 * 8 * 31
        + 101 * 9 * 31
}

fn ref_hash_make(inner_ty: i64, inner_hash: i64, is_mut: i64) -> i64 {
    return 1125899906842624 + is_mut + inner_ty * 4 + inner_hash * 256
}

fn ref_hash_is(h: i64) -> bool {
    return h >= 1125899906842624
}

fn ref_hash_mut(h: i64) -> i64 with Div, Mut {
    return (h - 1125899906842624) % 4
}

fn ref_hash_inner_ty(h: i64) -> i64 with Div, Mut {
    return ((h - 1125899906842624) / 4) % 64
}

fn ref_hash_inner_hash(h: i64) -> i64 with Div, Mut {
    return (h - 1125899906842624) / 256
}

fn ptr_hash_make(inner_ty: i64, inner_hash: i64, is_mut: i64) -> i64 {
    return ref_hash_make(inner_ty, inner_hash, is_mut)
}

fn ptr_hash_mut(h: i64) -> i64 with Div, Mut {
    return ref_hash_mut(h)
}

fn ptr_hash_inner_ty(h: i64) -> i64 with Div, Mut {
    return ref_hash_inner_ty(h)
}

fn ptr_hash_inner_hash(h: i64) -> i64 with Div, Mut {
    return ref_hash_inner_hash(h)
}

fn type_is_slice_ref(ty: i64, ty_hash: i64) -> bool with Panic, Div, Mut {
    if ty != 10 { return false }
    if ref_hash_inner_ty(ty_hash) != 8 { return false }
    return arr_hash_alen(ref_hash_inner_hash(ty_hash)) == 0
}

fn type_is_array_ref(ty: i64, ty_hash: i64) -> bool with Panic, Div, Mut {
    if ty != 10 { return false }
    return ref_hash_inner_ty(ty_hash) == 8
}

fn slice_inner_matches(expected_hash: i64, actual_hash: i64) -> bool with Panic, Div, Mut {
    let expected_inner = ref_hash_inner_hash(expected_hash)
    let actual_inner = ref_hash_inner_hash(actual_hash)
    return arr_hash_esiz(expected_inner) == arr_hash_esiz(actual_inner)
        && arr_hash_elem_ty(expected_inner) == arr_hash_elem_ty(actual_inner)
}

fn call_arg_type_compatible(expected_ty: i64, expected_hash: i64, actual_ty: i64, actual_hash: i64) -> bool with Panic, Div, Mut {
    // Unknown actual type (e.g. array element from struct array) — skip check
    if actual_ty == 0 && actual_hash == 0 { return true }
    // Struct element from array with no type hash — cannot verify, accept
    if (actual_ty == 6 || actual_ty == 7) && actual_hash == 0 { return true }
    // Size-hint sentinel from tuple field extraction — cannot verify struct name, accept
    if actual_ty == 6 && actual_hash >= 1000000007 && actual_hash < 1000001007 { return true }
    if ty_eq(expected_ty, expected_hash, actual_ty, actual_hash) { return true }
    if type_is_slice_ref(expected_ty, expected_hash) {
        if actual_ty == 10 && ref_hash_inner_ty(actual_hash) == 8 {
            if slice_inner_matches(expected_hash, actual_hash) == false { return false }
            if ref_hash_mut(expected_hash) != 0 && ref_hash_mut(actual_hash) == 0 { return false }
            return true
        }
    }
    // Auto-ref coercion: struct/array field access through a reference produces an address
    // in the codegen (via lea), so it is ABI-compatible with a shared &T parameter.
    // This handles patterns like: fn f(x: &Foo) called as f(obj.field) where obj: &Bar.
    if expected_ty == 10 && ref_hash_mut(expected_hash) == 0 {
        let exp_inner_ty = ref_hash_inner_ty(expected_hash)
        let exp_inner_hash = ref_hash_inner_hash(expected_hash)
        if (actual_ty == 6 || actual_ty == 8) && ty_eq(exp_inner_ty, exp_inner_hash, actual_ty, actual_hash) {
            return true
        }
        // Allow passing &!T (exclusive) where &T (shared) is expected — safe downgrade.
        if actual_ty == 10 && ref_hash_mut(actual_hash) != 0 {
            let act_inner_ty = ref_hash_inner_ty(actual_hash)
            let act_inner_hash = ref_hash_inner_hash(actual_hash)
            if ty_eq(exp_inner_ty, exp_inner_hash, act_inner_ty, act_inner_hash) {
                return true
            }
        }
    }
    return false
}

fn expr_simple_numeric_tok(start: i64, finish: i64) -> i64 with Panic, Mut {
    if finish == start + 1 {
        let k = TK[start as usize]
        if k == 4 || k == 53 { return start }
    }
    return -1
}

fn type_has_knowledge(ty: i64, ty_hash: i64) -> bool {
    if ty != 0 { return false }
    return knowledge_hash_is(ty_hash)
}

fn ty_is_unobserved(ty: i64) -> bool {
    return ty == 20
}

fn comparison_visible_ty(ty: i64, ty_hash: i64) -> i64 with Panic, Div, Mut {
    if ty_is_unobserved(ty) { return unobserved_hash_inner_ty(ty_hash) }
    return ty
}

// Algebra property queries (bit-packed in AL_PROPS)
fn al_is_algebra(ty: i64, ty_hash: i64) -> bool with Panic, Mut {
    if ty != 6 { return false }
    let si = st_find(ty_hash)
    if si < 0 { return false }
    return (AL_PROPS[si as usize] & 1) != 0
}
fn al_mul_is_commutative(ty_hash: i64) -> bool with Panic, Mut {
    let si = st_find(ty_hash)
    if si < 0 { return true }
    return (AL_PROPS[si as usize] & 8) != 0
}
fn al_mul_is_associative(ty_hash: i64) -> bool with Panic, Mut {
    let si = st_find(ty_hash)
    if si < 0 { return true }
    return (AL_PROPS[si as usize] & 16) != 0
}
fn al_add_is_commutative(ty_hash: i64) -> bool with Panic, Mut {
    let si = st_find(ty_hash)
    if si < 0 { return true }
    return (AL_PROPS[si as usize] & 2) != 0
}
fn al_reassoc_mode(ty_hash: i64) -> i64 with Panic, Mut {
    let si = st_find(ty_hash)
    if si < 0 { return 0 }
    return (AL_PROPS[si as usize] >> 6) & 3
}

fn comparison_visible_hash(ty: i64, ty_hash: i64) -> i64 with Panic, Div, Mut {
    if ty_is_unobserved(ty) { return unobserved_hash_inner_hash(ty_hash) }
    return ty_hash
}

fn comparison_require_observe(op_tok: i64, left_ty: i64, right_ty: i64) with IO, Mut, Panic {
    if (ty_is_unobserved(left_ty) || ty_is_unobserved(right_ty)) && (FN_EFFECTS[CURRENT_FN as usize] & 64) == 0 {
        tc_observe_violation(op_tok)
    }
}

fn tok_scaled_million(p: i64) -> i64 with Panic, Mut {
    if TK[p as usize] == 4 { return TV[p as usize] * 1000000 }
    if TK[p as usize] == 53 {
        var frac_scaled = TF[p as usize]
        var denom = TD[p as usize]
        while denom < 1000000 {
            frac_scaled = frac_scaled * 10
            denom = denom * 10
        }
        if denom != 1000000 { return -1 }
        return TV[p as usize] * 1000000 + frac_scaled
    }
    return -1
}

fn tok_abs_scaled_million(p: i64) -> i64 with Panic, Div, Mut {
    let v = tok_scaled_million(p)
    if v < 0 { return 0 - v }
    return v
}

fn infer_measure_eps_scaled(value_tok: i64, unc_tok: i64) -> i64 with Panic, Div, Mut {
    if value_tok < 0 || unc_tok < 0 { return -1 }
    let value_scaled = tok_abs_scaled_million(value_tok)
    let unc_scaled = tok_abs_scaled_million(unc_tok)
    if value_scaled <= 0 { return -1 }
    let eps_scaled = (unc_scaled * 1000000) / value_scaled
    if eps_scaled < 0 || eps_scaled > 1000000 { return -1 }
    return eps_scaled
}

fn isqrt_i64(n: i64) -> i64 with Div, Mut {
    if n <= 0 { return 0 }
    var x = n
    var y = (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    return x
}

fn knowledge_eps_combine_independent(a: i64, b: i64) -> i64 with Panic, Div, Mut {
    if a < 0 || b < 0 { return -1 }
    let sum_sq = a * a + b * b
    var root = isqrt_i64(sum_sq)
    if root * root < sum_sq { root = root + 1 }
    if root > 1000000 { root = 1000000 }
    return root
}

fn knowledge_eps_combine_relative(a: i64, b: i64) -> i64 {
    if a < 0 || b < 0 { return -1 }
    let sum = a + b
    if sum > 1000000 { return 1000000 }
    return sum
}

fn knowledge_binary_result_hash(op: i64, left_ty: i64, left_hash: i64, right_ty: i64, right_hash: i64) -> i64 with Panic, Div, Mut {
    let left_has = knowledge_hash_is(left_hash)
    let right_has = knowledge_hash_is(right_hash)
    if left_has == false && right_has == false { return 0 }
    var inner_ty = left_ty
    var inner_hash = left_hash
    if left_has {
        inner_ty = knowledge_hash_inner_ty(left_hash)
        inner_hash = knowledge_hash_inner_hash(left_hash)
    } else {
        if right_has {
            inner_ty = knowledge_hash_inner_ty(right_hash)
            inner_hash = knowledge_hash_inner_hash(right_hash)
        }
    }
    var left_eps: i64 = 0
    if left_has { left_eps = knowledge_hash_eps(left_hash) }
    var right_eps: i64 = 0
    if right_has { right_eps = knowledge_hash_eps(right_hash) }
    var left_mode: i64 = 0
    if left_has { left_mode = knowledge_hash_meta_mode(left_hash) }
    var right_mode: i64 = 0
    if right_has { right_mode = knowledge_hash_meta_mode(right_hash) }
    if left_mode == 3 || right_mode == 3 {
        return knowledge_hash_make_mode(inner_ty, inner_hash, 3, -1)
    }
    var eps: i64 = -1
    if op == 17 || op == 18 || op == 29 {
        eps = knowledge_eps_combine_independent(left_eps, right_eps)
    } else {
        eps = knowledge_eps_combine_relative(left_eps, right_eps)
    }
    return knowledge_hash_make_mode(inner_ty, inner_hash, 0, eps)
}

fn skip_call_arg_expr(p0: i64) -> i64 with Panic, Mut {
    var p = p0
    var paren_depth: i64 = 0
    var bracket_depth: i64 = 0
    var brace_depth: i64 = 0
    while p < TC {
        let k = TK[p as usize]
        if k == 6 { paren_depth = paren_depth + 1 }
        if k == 7 {
            if paren_depth == 0 && bracket_depth == 0 && brace_depth == 0 { return p }
            paren_depth = paren_depth - 1
        }
        if k == 41 { bracket_depth = bracket_depth + 1 }
        if k == 42 { bracket_depth = bracket_depth - 1 }
        if k == 8 { brace_depth = brace_depth + 1 }
        if k == 9 {
            if brace_depth == 0 && paren_depth == 0 && bracket_depth == 0 { return p }
            brace_depth = brace_depth - 1
        }
        if k == 28 && paren_depth == 0 && bracket_depth == 0 && brace_depth == 0 { return p }
        p = p + 1
    }
    return p
}

fn skip_signature_where_clause(p0: i64) -> i64 with Panic, Mut {
    var p = p0
    if TK[p as usize] == 3 {
        let ns = TS[p as usize]
        let ne = TE[p as usize]
        if src_match(ns, ne - ns, "where") {
            p = p + 1
            while p < TC && TK[p as usize] != 8 && TK[p as usize] != 38 && TK[p as usize] != 0 {
                p = p + 1
            }
        }
    }
    return p
}

fn type_name_kind(ns: i64, ne: i64) -> i64 with Panic, Mut {
    if src_match(ns, ne - ns, "i8") { return 1 }
    if src_match(ns, ne - ns, "i32") { return 1 }
    if src_match(ns, ne - ns, "u32") { return 1 }
    if src_match(ns, ne - ns, "i64") { return 1 }
    if src_match(ns, ne - ns, "u64") { return 1 }
    if src_match(ns, ne - ns, "usize") { return 1 }
    if src_match(ns, ne - ns, "f32") { return 2 }
    if src_match(ns, ne - ns, "f64") { return 2 }
    if src_match(ns, ne - ns, "str") { return 3 }
    if src_match(ns, ne - ns, "string") { return 3 }
    if src_match(ns, ne - ns, "bool") { return 4 }
    if src_match(ns, ne - ns, "unit") { return 5 }
    let h = gl_name_hash(ns, ne)
    if st_find(h) >= 0 { return 6 }
    if en_find(h) >= 0 { return 7 }
    return 0
}

fn type_is_struct_like(ty: i64, ty_hash: i64) -> bool {
    if ty == 6 { return true }
    if ty == 0 && knowledge_hash_is(ty_hash) { return true }
    return false
}

fn type_is_aggregate(ty: i64, ty_hash: i64) -> bool {
    if ty == 8 { return true }
    return type_is_struct_like(ty, ty_hash)
}

fn struct_like_nslots(ty_hash: i64) -> i64 with Panic, Div, Mut {
    if knowledge_hash_is(ty_hash) { return 3 }
    // Size-hint sentinel: 1000000007 + nslots, set after .0 tuple field access
    if ty_hash >= 1000000007 && ty_hash < 1000001007 { return ty_hash - 1000000007 }
    let si = st_find(ty_hash)
    if si >= 0 { return st_total_size(si) / 8 }
    return 0
}

fn ty_eq(k1: i64, h1: i64, k2: i64, h2: i64) -> bool with Panic, Div, Mut {
    if k1 == 10 && k2 == 10 {
        if ref_hash_mut(h1) != ref_hash_mut(h2) { return false }
        return ty_eq(ref_hash_inner_ty(h1), ref_hash_inner_hash(h1), ref_hash_inner_ty(h2), ref_hash_inner_hash(h2))
    }
    if k1 == 11 && k2 == 11 {
        if h1 == 0 || h2 == 0 { return true }
        if ptr_hash_mut(h1) != ptr_hash_mut(h2) { return false }
        return ty_eq(ptr_hash_inner_ty(h1), ptr_hash_inner_hash(h1), ptr_hash_inner_ty(h2), ptr_hash_inner_hash(h2))
    }
    if k1 == 20 && k2 == 20 {
        return ty_eq(unobserved_hash_inner_ty(h1), unobserved_hash_inner_hash(h1), unobserved_hash_inner_ty(h2), unobserved_hash_inner_hash(h2))
    }
    if k1 == 20 {
        return ty_eq(unobserved_hash_inner_ty(h1), unobserved_hash_inner_hash(h1), k2, h2)
    }
    if k2 == 20 {
        return ty_eq(k1, h1, unobserved_hash_inner_ty(h2), unobserved_hash_inner_hash(h2))
    }
    if k1 == 0 && knowledge_hash_is(h1) && k2 == 6 && h2 == knowledge_struct_hash() { return true }
    if k1 == 0 && k2 == 0 && h1 != 0 && h2 != 0 {
        if knowledge_hash_is(h1) || knowledge_hash_is(h2) {
            if knowledge_hash_is(h1) == false || knowledge_hash_is(h2) == false { return false }
            if knowledge_hash_invalid(h1) || knowledge_hash_invalid(h2) { return false }
            if ty_eq(knowledge_hash_inner_ty(h1), knowledge_hash_inner_hash(h1), knowledge_hash_inner_ty(h2), knowledge_hash_inner_hash(h2)) == false {
                return false
            }
            let req_mode = knowledge_hash_meta_mode(h1)
            let got_mode = knowledge_hash_meta_mode(h2)
            let req_eps = knowledge_hash_eps(h1)
            let got_eps = knowledge_hash_eps(h2)
            if req_mode == 3 {
                if got_mode == 3 { return true }
                return got_mode == 0 && got_eps < 0
            }
            if req_mode == 2 {
                if got_mode == 3 { return false }
                if got_eps < 0 { return false }
                return got_eps >= req_eps
            }
            if req_mode == 1 {
                if got_mode == 3 { return false }
                if got_eps < 0 { return false }
                return got_eps == req_eps
            }
            if req_eps < 0 { return true }
            if got_mode == 2 || got_mode == 3 { return false }
            if got_eps < 0 { return false }
            return got_eps <= req_eps
        }
        return h1 == h2
    }
    // Native lowering still uses raw i64 handles for some legacy boundaries:
    // enum discriminants and untyped callable closure handles may flow into
    // integer-typed parameters in older tests.
    if k1 == 1 && k2 == 7 { return true }
    if k1 == 1 && k2 == 9 { return true }
    // Knowledge<T> must not silently coerce to non-Knowledge types (or vice versa)
    if k1 != 0 && k2 == 0 && knowledge_hash_is(h2) { return false }
    if k1 == 0 && k2 != 0 && knowledge_hash_is(h1) { return false }
    if k1 == 0 || k2 == 0 {
        return true
    }
    if k1 != k2 { return false }
    if k1 == 2 {
        if h1 != 0 && h2 != 0 { return h1 == h2 }
        return true
    }
    if k1 == 6 || k1 == 7 {
        if h1 == h2 { return true }
        if k1 == 6 {
            if h1 >= 1000000007 && h1 < 1000001007 { return true }
            if h2 >= 1000000007 && h2 < 1000001007 { return true }
        }
        return false
    }
    if k1 == 8 {
        let a1 = arr_hash_alen(h1)
        let a2 = arr_hash_alen(h2)
        if arr_hash_esiz(h1) != arr_hash_esiz(h2) { return false }
        if arr_hash_elem_ty(h1) != arr_hash_elem_ty(h2) { return false }
        if a1 == 0 || a2 == 0 { return true }
        return h1 == h2
    }
    return true
}

fn ret_agg_nslots(ty: i64, ty_hash: i64) -> i64 with Panic, Div, Mut {
    if ty == 8 { return arr_storage_slots(ty_hash) }
    // Knowledge types use negative hashes, but only for type 0 (unresolved Knowledge)
    // or type 6 (struct-like). NOT for enums (ty==7) or scalars.
    if knowledge_hash_is(ty_hash) && ty != 7 && ty != 1 && ty != 4 { return 3 }
    if ty == 6 {
        let si = st_find(ty_hash)
        if si >= 0 { return st_total_size(si) / 8 }
        // Synthetic tuple: decode total slot count from hash.
        // Hash format: tcount * 1000000 + first_nslots * 1000 + total_nslots
        // Falls back to 128 for partially-encoded or unregistered structs.
        if ty_hash != 0 {
            let tup_total = ty_hash % 1000
            if tup_total > 0 { return tup_total }
            return 128
        }
    }
    return 0
}

fn box_alloc_bytes(ty: i64, ty_hash: i64) -> i64 with Panic, Div, Mut {
    var bytes = box_page_bytes()
    if ty == 8 {
        bytes = arr_storage_slots(ty_hash) * 8
    } else if ty == 6 || knowledge_hash_is(ty_hash) {
        bytes = struct_like_nslots(ty_hash) * 8
    }
    if bytes < box_page_bytes() { bytes = box_page_bytes() }
    return ((bytes + box_page_bytes() - 1) / box_page_bytes()) * box_page_bytes()
}

// Per-function error tracking for import-tolerant compilation.
var TC_FN_ERR_COUNT: i64 = 0

// Guard: errors in imported module functions should NOT block ELF emission.
fn tc_mark_failed() with Mut {
    TC_FN_ERR_COUNT = TC_FN_ERR_COUNT + 1
    if MAIN_SRC_END > 0 && CURRENT_FN >= 0 && CURRENT_FN < 16384 {
        if (FN_EFFECTS[CURRENT_FN as usize] & 2048) != 0 {
            return
        }
    }
    TYPECHECK_FAILED = 1
}

fn tc_stack_frame_too_large(bytes: i64) with IO, Mut, Panic {
    print("warning: stack frame too large (")
    print_int(bytes)
    print(" bytes) - consider using global arrays\n")
    // Not a hard error — large-struct value-semantics are valid but risky at runtime
}

