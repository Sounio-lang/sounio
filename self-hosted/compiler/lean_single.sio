                    tc_error_hard(borrow_tok, "Mut borrow requires mutable binding")
                }
            }
            let lalen = var_find_alen(rns, rne)
            let lty = var_find_ty(rns, rne)
            let lvi_for_box = var_find_idx(rns, rne)
            var lhash_for_box: i64 = 0
