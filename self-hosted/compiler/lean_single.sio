fn print_array_elem_type(elem_ty: i64, esiz: i64) with IO, Mut, Panic, Div {
    if elem_ty == 1 {
        if esiz == 1 {
            print("i8")
        } else {
            print("i64")
        }
        return
    }
    if elem_ty == 2 { print("f64"); return }
    if elem_ty == 3 { print("string"); return }
    if elem_ty == 4 { print("bool"); return }
    if elem_ty == 5 { print("()"); return }
    if elem_ty == 6 { print("struct"); return }
    if elem_ty == 7 { print("enum"); return }
    if elem_ty == 8 { print("array"); return }
    if elem_ty == 9 { print("fn"); return }
    print("?")
}

fn print_scaled_million(v: i64) with IO, Mut, Panic, Div {
    if v < 0 {
        print("?")
        return
    }
    print_int(v / 1000000)
    print(".")
    let frac = v % 1000000
    if frac < 100000 { print("0") }
    if frac < 10000 { print("0") }
    if frac < 1000 { print("0") }
    if frac < 100 { print("0") }
    if frac < 10 { print("0") }
    print_int(frac)
}

fn print_type_label(ty: i64, ty_hash: i64) with IO, Mut, Panic, Div {
    if ty == 0 {
        if knowledge_hash_is(ty_hash) {
            print("Knowledge<")
            print_type_label(knowledge_hash_inner_ty(ty_hash), knowledge_hash_inner_hash(ty_hash))
            let mode = knowledge_hash_meta_mode(ty_hash)
            let eps = knowledge_hash_eps(ty_hash)
            if mode == 3 {
                print(", epsilon=bottom")
            } else if mode == 2 {
                if eps >= 0 {
                    print(", epsilon >= ")
                    print_scaled_million(eps)
                }
            } else if mode == 1 {
                if eps >= 0 {
                    print(", epsilon=")
                    print_scaled_million(eps)
                }
            } else {
                if eps >= 0 {
                    print(", epsilon < ")
                    print_scaled_million(eps)
                }
            }
            print(">")
            return
        }
        print("?")
        return
    }
    if ty == 1 { print("i64"); return }
    if ty == 2 { print("f64"); return }
    if ty == 3 { print("string"); return }
    if ty == 4 { print("bool"); return }
    if ty == 5 { print("()"); return }
    if ty == 6 {
        print("struct")
        return
    }
    if ty == 7 {
        print("enum")
        return
    }
    if ty == 8 {
        print("[")
        print_array_elem_type(arr_hash_elem_ty(ty_hash), arr_hash_esiz(ty_hash))
        print("; ")
        let alen = arr_hash_alen(ty_hash)
        if alen == 0 {
            print("?")
        } else {
            print_int(alen)
        }
        print("]")
        return
    }
    if ty == 9 { print("fn"); return }
    if ty == 10 {
        let inner_ty = ref_hash_inner_ty(ty_hash)
        let inner_hash = ref_hash_inner_hash(ty_hash)
        if type_is_slice_ref(ty, ty_hash) {
            if ref_hash_mut(ty_hash) != 0 { print("&![") }
            else { print("&[") }
            print_array_elem_type(arr_hash_elem_ty(inner_hash), arr_hash_esiz(inner_hash))
            print("]")
            return
        }
        if ref_hash_mut(ty_hash) != 0 { print("&!") }
        else { print("&") }
        print_type_label(inner_ty, inner_hash)
        return
    }
    if ty == 11 {
        if ptr_hash_mut(ty_hash) != 0 { print("*mut ") }
        else { print("*") }
        print_type_label(ptr_hash_inner_ty(ty_hash), ptr_hash_inner_hash(ty_hash))
        return
    }
    if ty == 20 {
        print("Unobserved<")
        print_type_label(unobserved_hash_inner_ty(ty_hash), unobserved_hash_inner_hash(ty_hash))
        print(">")
        return
    }
    print("?")
}

fn dump_cli_ast_summary() with IO, Mut, Panic, Div {
    print("AST summary:\n")
    var si: i64 = 0
    while si < ST_COUNT {
        print("struct#")
        print_int(si)
        print("\n")
        si = si + 1
    }
    var ei: i64 = 0
    while ei < EN_COUNT {
        print("enum#")
        print_int(ei)
        print("\n")
        ei = ei + 1
    }
    var gi: i64 = 0
    while gi < GL_COUNT {
        print("global#")
        print_int(gi)
        if GL_TY[gi as usize] != 0 {
            print(": ")
            print_type_label(GL_TY[gi as usize], GL_TY_HASH[gi as usize])
        }
        print("\n")
        gi = gi + 1
    }
    var fi: i64 = 0
    while fi < FN_COUNT {
        print("fn#")
        print_int(fi)
        print("(")
        print_int(FN_ARITY[fi as usize])
        print(" params)")
        if FN_RET_TY[fi as usize] != 5 {
            print(" -> ")
            print_type_label(FN_RET_TY[fi as usize], FN_RET_HASH[fi as usize])
        }
        if FN_EFFECTS[fi as usize] != 0 {
            print(" with ")
            print_effect_mask(FN_EFFECTS[fi as usize])
        }
        print("\n")
        fi = fi + 1
    }
}

fn dump_cli_type_summary() with IO, Mut, Panic, Div {
    print("Type summary:\n")
    var gi: i64 = 0
    while gi < GL_COUNT {
        print("global#")
        print_int(gi)
        print(": ")
        print_type_label(GL_TY[gi as usize], GL_TY_HASH[gi as usize])
        print("\n")
        gi = gi + 1
    }
    var fi: i64 = 0
    while fi < FN_COUNT {
        print("fn#")
        print_int(fi)
        print(": arity ")
        print_int(FN_ARITY[fi as usize])
        print(" -> ")
        print_type_label(FN_RET_TY[fi as usize], FN_RET_HASH[fi as usize])
        print(" with ")
        print_effect_mask(FN_EFFECTS[fi as usize])
        print("\n")
        fi = fi + 1
    }
}

fn tc_wrong_arity(tok: i64, expected: i64, got: i64) -> i64 with IO, Mut, Panic {
    print("warning: arity mismatch at line ")
    print_int(TL[tok as usize])
    print("\n")
    return 0
}

fn stmt_is_array_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 3 { return false }
    if TK[(p0 + 1) as usize] != 41 { return false }
    var p = p0 + 2
    var depth: i64 = 1
    while p < TC && depth > 0 {
        if TK[p as usize] == 41 { depth = depth + 1 }
        if TK[p as usize] == 42 { depth = depth - 1 }
        p = p + 1
    }
    return TK[p as usize] == 16
}

fn stmt_is_field_array_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 3 { return false }
    if TK[(p0 + 1) as usize] != 50 { return false }
    if TK[(p0 + 2) as usize] != 3 { return false }
    if TK[(p0 + 3) as usize] != 41 { return false }
    var p = p0 + 4
    var depth: i64 = 1
    while p < TC && depth > 0 {
        if TK[p as usize] == 41 { depth = depth + 1 }
        if TK[p as usize] == 42 { depth = depth - 1 }
        p = p + 1
    }
    return TK[p as usize] == 16
}

fn stmt_is_deref_array_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 6 { return false }
    if TK[(p0 + 1) as usize] != 19 { return false }
    if TK[(p0 + 2) as usize] != 3 { return false }
    if TK[(p0 + 3) as usize] != 7 { return false }
    if TK[(p0 + 4) as usize] != 41 { return false }
    var p = p0 + 5
    var depth: i64 = 1
    while p < TC && depth > 0 {
        if TK[p as usize] == 41 { depth = depth + 1 }
        if TK[p as usize] == 42 { depth = depth - 1 }
        p = p + 1
    }
    return TK[p as usize] == 16
}

fn stmt_is_deref_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 19 { return false }
    if TK[(p0 + 1) as usize] != 3 { return false }
    return TK[(p0 + 2) as usize] == 16
}

fn stmt_is_deref_field_store(p0: i64) -> bool with Panic, Mut {
    if TK[p0 as usize] != 6 { return false }
    if TK[(p0 + 1) as usize] != 19 { return false }
    if TK[(p0 + 2) as usize] != 3 { return false }
    if TK[(p0 + 3) as usize] != 7 { return false }
    if TK[(p0 + 4) as usize] != 50 { return false }
    if TK[(p0 + 5) as usize] != 3 { return false }
    return TK[(p0 + 6) as usize] == 16
}

fn skip_type_meta_item(p0: i64, close_tk: i64) -> i64 with Panic, Mut {
    var p = p0
    var paren_depth: i64 = 0
    var bracket_depth: i64 = 0
    var brace_depth: i64 = 0
    var angle_depth: i64 = 0
    while p < TC {
        let k = TK[p as usize]
        if k == 28 && paren_depth == 0 && bracket_depth == 0 && brace_depth == 0 && angle_depth == 0 { return p }
        if k == close_tk && paren_depth == 0 && bracket_depth == 0 && brace_depth == 0 && angle_depth == 0 { return p }
        if k == 6 { paren_depth = paren_depth + 1 }
        if k == 7 {
            if paren_depth > 0 { paren_depth = paren_depth - 1 }
        }
        if k == 41 { bracket_depth = bracket_depth + 1 }
        if k == 42 {
            if bracket_depth > 0 { bracket_depth = bracket_depth - 1 }
        }
        if k == 8 { brace_depth = brace_depth + 1 }
        if k == 9 {
            if brace_depth > 0 { brace_depth = brace_depth - 1 }
        }
        if k == 23 { angle_depth = angle_depth + 1 }
        if k == 24 {
            if angle_depth > 0 { angle_depth = angle_depth - 1 }
        }
        p = p + 1
    }
    return p
}

fn src_line_of(pos: i64) -> i64 with Panic, Mut {
    var line: i64 = 1
    var i: i64 = 0
    while i < pos && i < SRC_LEN {
        if sb(i) == 10 { line = line + 1 }
        i = i + 1
    }
    return line
}

fn src_has_knightian_bottom_at(pos: i64) -> bool with Panic, Mut {
    if pos + 5 >= SRC_LEN { return false }
    if sb(pos) != 206 || sb(pos + 1) != 181 { return false }
    if sb(pos + 2) != 61 { return false }
    if sb(pos + 3) != 226 || sb(pos + 4) != 138 || sb(pos + 5) != 165 { return false }
    return true
}

fn src_has_knightian_conf_req_at(pos: i64) -> bool with Panic, Mut {
    if pos + 4 >= SRC_LEN { return false }
    if sb(pos) != 206 || sb(pos + 1) != 181 { return false }
    if sb(pos + 2) == 32 && sb(pos + 3) == 62 && sb(pos + 4) == 61 { return true }
    if sb(pos + 2) == 62 && sb(pos + 3) == 61 { return true }
    return false
}

fn precheck_knightian_conflict() -> i64 with IO, Mut, Panic {
    var p: i64 = 0
    var knight_line: i64 = 0
    var has_conf_req: i64 = 0
    while p < SRC_LEN {
        if sb(p) == 47 && p + 1 < SRC_LEN && sb(p + 1) == 47 {
            p = p + 2
            while p < SRC_LEN && sb(p) != 10 { p = p + 1 }
            continue
        }
        if sb(p) == 34 {
            p = p + 1
            while p < SRC_LEN && sb(p) != 34 {
                if sb(p) == 92 && p + 1 < SRC_LEN {
                    p = p + 2
                } else {
                    p = p + 1
                }
            }
            if p < SRC_LEN && sb(p) == 34 { p = p + 1 }
            continue
        }
        if src_has_knightian_bottom_at(p) {
            if knight_line == 0 { knight_line = src_line_of(p) }
        }
        if src_has_knightian_conf_req_at(p) { has_conf_req = 1 }
        p = p + 1
    }
    if knight_line != 0 && has_conf_req != 0 {
        print("type error line ")
        print_int(knight_line)
        print(": Knightian uncertainty (")
        print("ε=⊥")
        print(") cannot satisfy required confidence\n")
        return 1
    }
    return 0
}

fn src_valid_until_date_eq(pos: i64, date_s: i64) -> bool with Panic, Mut {
    var i: i64 = 0
    while i < 10 {
        if sb(pos + i) != sb(date_s + i) { return false }
        i = i + 1
    }
    return true
}

fn precheck_temporal_window_conflict() -> i64 with IO, Mut, Panic {
    var p: i64 = 0
    var first_date_s: i64 = -1
    while p + 11 < SRC_LEN {
        if sb(p) == 47 && p + 1 < SRC_LEN && sb(p + 1) == 47 {
            p = p + 2
            while p < SRC_LEN && sb(p) != 10 { p = p + 1 }
            continue
        }
        if sb(p) == 34 {
            p = p + 1
            while p < SRC_LEN && sb(p) != 34 {
                if sb(p) == 92 && p + 1 < SRC_LEN {
                    p = p + 2
                } else {
                    p = p + 1
                }
            }
            if p < SRC_LEN && sb(p) == 34 { p = p + 1 }
            continue
        }
        if src_match(p, 12, "ValidUntil(\"") {
            let date_s = p + 12
            if date_s + 9 < SRC_LEN {
                if first_date_s < 0 {
                    first_date_s = date_s
                } else if src_valid_until_date_eq(date_s, first_date_s) == false {
                    print("type error line ")
                    print_int(src_line_of(p))
                    print(": Temporal validity window mismatch\n")
                    return 1
                }
            }
        }
        p = p + 1
    }
    return 0
}

fn fnsig_intern_scratch() -> i64 with Mut, Panic {
    var sig: i64 = 1
    while sig < FNSIG_COUNT {
        if FNSIG_ARITY[sig as usize] == FNSIG_SCRATCH_ARITY
            && FNSIG_RET_TY[sig as usize] == FNSIG_SCRATCH_RET_TY
            && FNSIG_RET_HASH[sig as usize] == FNSIG_SCRATCH_RET_HASH {
            var same: i64 = 1
            var pi: i64 = 0
            while pi < FNSIG_SCRATCH_ARITY {
                let base = sig * 16 + pi
                if FNSIG_PARAM_TY[base as usize] != FNSIG_SCRATCH_PARAM_TY[pi as usize]
                    || FNSIG_PARAM_HASH[base as usize] != FNSIG_SCRATCH_PARAM_HASH[pi as usize] {
                    same = 0
                    pi = FNSIG_SCRATCH_ARITY
                } else {
                    pi = pi + 1
                }
            }
            if same == 1 { return sig }
        }
        sig = sig + 1
    }
    sig = FNSIG_COUNT
    if sig >= 256 { return 0 }
    FNSIG_ARITY[sig as usize] = FNSIG_SCRATCH_ARITY
    FNSIG_RET_TY[sig as usize] = FNSIG_SCRATCH_RET_TY
    FNSIG_RET_HASH[sig as usize] = FNSIG_SCRATCH_RET_HASH
    var pi: i64 = 0
    while pi < 16 {
        let base = sig * 16 + pi
        if pi < FNSIG_SCRATCH_ARITY {
            FNSIG_PARAM_TY[base as usize] = FNSIG_SCRATCH_PARAM_TY[pi as usize]
            FNSIG_PARAM_HASH[base as usize] = FNSIG_SCRATCH_PARAM_HASH[pi as usize]
        } else {
            FNSIG_PARAM_TY[base as usize] = 0
            FNSIG_PARAM_HASH[base as usize] = 0
        }
        pi = pi + 1
    }
    FNSIG_COUNT = FNSIG_COUNT + 1
    return sig
}

fn scan_fn_type_signature(p0: i64) with IO, Mut, Panic {
    var p = p0 + 1
    let depth = FNSIG_SCAN_DEPTH
    let tmp_base = depth * 16
    if depth < 15 { FNSIG_SCAN_DEPTH = depth + 1 }
    var arity: i64 = 0
    var i: i64 = 0
    while i < 16 {
        FNSIG_TMP_PARAM_TY[(tmp_base + i) as usize] = 0
        FNSIG_TMP_PARAM_HASH[(tmp_base + i) as usize] = 0
        i = i + 1
    }
    if TK[p as usize] == 6 {
        p = p + 1
        while TK[p as usize] != 7 && TK[p as usize] != 0 {
            scan_type(p)
            if arity < 16 {
                FNSIG_TMP_PARAM_TY[(tmp_base + arity) as usize] = SCAN_TY
                FNSIG_TMP_PARAM_HASH[(tmp_base + arity) as usize] = SCAN_TY_HASH
            }
            arity = arity + 1
            p = SCAN_TY_NEXT
            if TK[p as usize] == 28 { p = p + 1 }
        }
        if TK[p as usize] == 7 { p = p + 1 }
    }
    var ret_ty: i64 = 5
    var ret_hash: i64 = 0
    if TK[p as usize] == 10 {
        p = p + 1
        scan_type(p)
        ret_ty = SCAN_TY
        ret_hash = SCAN_TY_HASH
        p = SCAN_TY_NEXT
    }
    if TK[p as usize] == 38 {
        p = p + 1
        while tok_is_effect_name(p) {
            p = p + 1
            if TK[p as usize] == 28 && tok_is_effect_name(p + 1) {
                p = p + 1
            } else {
                break
            }
        }
    }
    FNSIG_SCRATCH_ARITY = arity
    FNSIG_SCRATCH_RET_TY = ret_ty
    FNSIG_SCRATCH_RET_HASH = ret_hash
    i = 0
    while i < 16 {
        if i < arity {
            FNSIG_SCRATCH_PARAM_TY[i as usize] = FNSIG_TMP_PARAM_TY[(tmp_base + i) as usize]
            FNSIG_SCRATCH_PARAM_HASH[i as usize] = FNSIG_TMP_PARAM_HASH[(tmp_base + i) as usize]
        } else {
            FNSIG_SCRATCH_PARAM_TY[i as usize] = 0
            FNSIG_SCRATCH_PARAM_HASH[i as usize] = 0
        }
        i = i + 1
    }
    FNSIG_SCAN_DEPTH = depth
    SCAN_TY = 9
    SCAN_TY_HASH = fnsig_intern_scratch()
    SCAN_TY_NEXT = p
}

fn fnsig_from_decl_name_tok(name_tok: i64) -> i64 with IO, Mut, Panic {
    var p = name_tok + 1
    let depth = FNSIG_SCAN_DEPTH
    let tmp_base = depth * 16
    if depth < 15 { FNSIG_SCAN_DEPTH = depth + 1 }
    var arity: i64 = 0
    var i: i64 = 0
    while i < 16 {
        FNSIG_TMP_PARAM_TY[(tmp_base + i) as usize] = 0
        FNSIG_TMP_PARAM_HASH[(tmp_base + i) as usize] = 0
        i = i + 1
    }
    if TK[p as usize] == 6 {
        p = p + 1
        while TK[p as usize] != 7 && TK[p as usize] != 0 {
            if TK[p as usize] == 3 {
                p = p + 1
                if TK[p as usize] == 43 {
                    p = p + 1
                    scan_type(p)
                    if arity < 16 {
                        FNSIG_TMP_PARAM_TY[(tmp_base + arity) as usize] = SCAN_TY
                        FNSIG_TMP_PARAM_HASH[(tmp_base + arity) as usize] = SCAN_TY_HASH
                    }
                    arity = arity + 1
                    p = SCAN_TY_NEXT
                }
            } else {
                p = p + 1
            }
            if TK[p as usize] == 28 { p = p + 1 }
        }
        if TK[p as usize] == 7 { p = p + 1 }
    }
    var ret_ty: i64 = 5
    var ret_hash: i64 = 0
    if TK[p as usize] == 10 {
        p = p + 1
        scan_type(p)
        ret_ty = SCAN_TY
        ret_hash = SCAN_TY_HASH
        p = SCAN_TY_NEXT
    }
    p = skip_signature_where_clause(p)
    if TK[p as usize] == 38 {
        p = p + 1
        // Gen 17 D2: skip Epistemic(N) parenthesized arguments
        while TK[p as usize] == 3 || TK[p as usize] == 28 {
            if TK[p as usize] == 3 { p = p + 1; if TK[p as usize] == 6 { p = p + 1; while TK[p as usize] != 7 && TK[p as usize] != 0 { p = p + 1 }; if TK[p as usize] == 7 { p = p + 1 } } }
            else { p = p + 1 }
        }
    }
    FNSIG_SCRATCH_ARITY = arity
    FNSIG_SCRATCH_RET_TY = ret_ty
    FNSIG_SCRATCH_RET_HASH = ret_hash
    i = 0
    while i < 16 {
        if i < arity {
            FNSIG_SCRATCH_PARAM_TY[i as usize] = FNSIG_TMP_PARAM_TY[(tmp_base + i) as usize]
            FNSIG_SCRATCH_PARAM_HASH[i as usize] = FNSIG_TMP_PARAM_HASH[(tmp_base + i) as usize]
        } else {
            FNSIG_SCRATCH_PARAM_TY[i as usize] = 0
            FNSIG_SCRATCH_PARAM_HASH[i as usize] = 0
        }
        i = i + 1
    }
    FNSIG_SCAN_DEPTH = depth
    return fnsig_intern_scratch()
}

fn scan_type(p0: i64) with IO, Mut, Panic {
    var p = p0
    SCAN_TY = 0
    SCAN_TY_HASH = 0
    SCAN_TY_ESIZ = 8
    SCAN_TY_ALEN = 0
    // Tuple type: (T, U, ...) — skip balanced parens, treat as aggregate
    if TK[p as usize] == 6 {
        // Empty parens () = unit type (not a tuple)
        if TK[(p + 1) as usize] == 7 {
            SCAN_TY = 5
            SCAN_TY_HASH = 0
            SCAN_TY_NEXT = p + 2
            return
        }
        // Scan first element type (starts right after '(').
        let first_elem_start = p + 1
        scan_type(first_elem_start)
        let first_ty = SCAN_TY
        let first_hash = SCAN_TY_HASH
        var first_f64: i64 = 0
        if first_ty == 2 { first_f64 = 1 }
        var first_nslots: i64 = 1
        if first_ty == 6 && first_hash != 0 {
            let fsi = st_find(first_hash)
            if fsi >= 0 { first_nslots = st_total_size(fsi) / 8 }
        } else if first_ty == 8 {
            first_nslots = arr_storage_slots(first_hash)
        }
        // Skip balanced parens, count elements, track last element start.
        var td: i64 = 1
        var tcount: i64 = 1
        var last_elem_start: i64 = first_elem_start
        p = p + 1
        while p < TC && td > 0 {
            if TK[p as usize] == 6 { td = td + 1 }
            if TK[p as usize] == 7 { td = td - 1 }
            if td == 1 && TK[p as usize] == 28 {
                tcount = tcount + 1
                last_elem_start = p + 1
            }
            p = p + 1
        }
        // Scan last element type if distinct from first.
        var last_f64: i64 = first_f64
        var last_nslots: i64 = first_nslots
        var last_ty: i64 = first_ty
        var last_hash: i64 = first_hash
        if last_elem_start != first_elem_start {
            scan_type(last_elem_start)
            last_ty = SCAN_TY
            last_hash = SCAN_TY_HASH
            if last_ty == 2 { last_f64 = 1 } else { last_f64 = 0 }
            if last_ty == 6 && last_hash != 0 {
                let lsi = st_find(last_hash)
                if lsi >= 0 { last_nslots = st_total_size(lsi) / 8 } else { last_nslots = 1 }
            } else if last_ty == 8 {
                last_nslots = arr_storage_slots(last_hash)
            } else {
                last_nslots = 1
            }
        }
        let total_nslots = first_nslots + last_nslots
        SCAN_TY = 6
        // Hash: tcount*100M + first_f64*10M + last_f64*1M + first_nslots*1000 + total_nslots
        SCAN_TY_HASH = tcount * 100000000 + first_f64 * 10000000 + last_f64 * 1000000 + first_nslots * 1000 + total_nslots
        tup_cache_register(SCAN_TY_HASH, first_ty, first_hash, last_ty, last_hash)
        SCAN_TY_NEXT = p
        return
    }
    if TK[p as usize] == 19 {
        var ptr_mode: i64 = 0
        p = p + 1
        if TK[p as usize] == 32 {
            ptr_mode = 1
            p = p + 1
        } else if TK[p as usize] == 3 {
            let mns = TS[p as usize]
            let mne = TE[p as usize]
            if src_match(mns, mne - mns, "mut") {
                ptr_mode = 1
                p = p + 1
            }
        }
        scan_type(p)
        let inner_ty = SCAN_TY
        let inner_hash = SCAN_TY_HASH
        let inner_next = SCAN_TY_NEXT
        SCAN_TY_HASH = ptr_hash_make(inner_ty, inner_hash, ptr_mode)
        SCAN_TY = 11
        SCAN_TY_NEXT = inner_next
        return
    }
    if TK[p as usize] == 44 {
        var ref_mode: i64 = 0
        p = p + 1
        // Strike 2: Reject '&mut' Rust syntax
        if TK[p as usize] == 3 {
            let mns = TS[p as usize]
            let mne = TE[p as usize]
            if src_match(mns, mne - mns, "mut") {
                tc_rust_mut_ref(p)
            }
        }
        if TK[p as usize] == 32 { ref_mode = 1; p = p + 1 }
        scan_type(p)
        SCAN_TY_HASH = ref_hash_make(SCAN_TY, SCAN_TY_HASH, ref_mode)
        SCAN_TY = 10
        return
    }
    // Refinement type: { ident : TYPE | pred } -> treat as TYPE + parse predicate
    SCAN_HAS_PRED = 0
    SCAN_HAS_PRED2 = 0
    if TK[p as usize] == 8 {
        if p + 3 < TC {
            let ref_t1 = TK[(p + 1) as usize]
            let ref_t2 = TK[(p + 2) as usize]
            if ref_t1 == 3 {
                if ref_t2 == 43 {
                    var rp = p + 3
                    var found_pipe: i64 = 0
                    while rp < TC {
                        let rtk = TK[rp as usize]
                        if rtk == 9 { break }
                        if rtk == 0 { break }
                        if rtk == 45 { found_pipe = 1
                        break }
                        rp = rp + 1
                    }
                    if found_pipe == 1 {
                        scan_type(p + 3)
                        // Parse predicate: skip ref_var_ident, read op, read bound
                        var pp = rp + 1
                        if pp < TC && TK[pp as usize] == 3 { pp = pp + 1 }  // skip var ident
                        if pp < TC {
                            let pred_op = TK[pp as usize]
                            if pred_op == 26 || pred_op == 24 || pred_op == 25 || pred_op == 23 || pred_op == 21 || pred_op == 22 {
                                SCAN_PRED_OP = pred_op
                                pp = pp + 1
                                var pred_neg: i64 = 0
                                if pp < TC && TK[pp as usize] == 18 { pred_neg = 1; pp = pp + 1 }
                                if pp < TC && TK[pp as usize] == 4 {
                                    var bv = TV[pp as usize]
                                    if pred_neg == 1 { bv = 0 - bv }
                                    SCAN_PRED_BOUND = bv
                                    SCAN_PRED_IS_F64 = 0
                                    SCAN_HAS_PRED = 1
                                    pp = pp + 1
                                }
                                if pp < TC && TK[pp as usize] == 53 {
                                    var fbv = TV[pp as usize]
                                    if pred_neg == 1 { fbv = fbv | 0 - 9223372036854775808 }  // flip sign bit
                                    SCAN_PRED_BOUND = fbv
                                    SCAN_PRED_IS_F64 = 1
                                    SCAN_HAS_PRED = 1
                                    pp = pp + 1
                                }
                                // Check for || and parse second predicate
                                if SCAN_HAS_PRED == 1 && pp < TC && TK[pp as usize] == 31 {
                                    pp = pp + 1  // skip ||
                                    if pp < TC && TK[pp as usize] == 3 { pp = pp + 1 }  // skip var ident
                                    if pp < TC {
                                        let pred_op2 = TK[pp as usize]
                                        if pred_op2 == 26 || pred_op2 == 24 || pred_op2 == 25 || pred_op2 == 23 || pred_op2 == 21 || pred_op2 == 22 {
                                            SCAN_PRED_OP2 = pred_op2
                                            pp = pp + 1
                                            var pred_neg2: i64 = 0
                                            if pp < TC && TK[pp as usize] == 18 { pred_neg2 = 1; pp = pp + 1 }
                                            if pp < TC && TK[pp as usize] == 4 {
                                                var bv2 = TV[pp as usize]
                                                if pred_neg2 == 1 { bv2 = 0 - bv2 }
                                                SCAN_PRED_BOUND2 = bv2
                                                SCAN_PRED_IS_F64_2 = 0
                                                SCAN_HAS_PRED2 = 1
                                            }
                                            if pp < TC && TK[pp as usize] == 53 {
                                                var fbv2 = TV[pp as usize]
                                                if pred_neg2 == 1 { fbv2 = fbv2 | 0 - 9223372036854775808 }
                                                SCAN_PRED_BOUND2 = fbv2
                                                SCAN_PRED_IS_F64_2 = 1
                                                SCAN_HAS_PRED2 = 1
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        while rp < TC {
                            if TK[rp as usize] == 9 { break }
                            rp = rp + 1
                        }
                        if rp < TC { rp = rp + 1 }
                        SCAN_TY_NEXT = rp
                        return
                    }
                }
            }
        }
    }
    if TK[p as usize] == 44 { p = p + 1 }
    if TK[p as usize] == 32 { p = p + 1 }
    if TK[p as usize] == 1 {
        scan_fn_type_signature(p)
        return
    }
    if TK[p as usize] == 6 && TK[(p + 1) as usize] == 7 {
        SCAN_TY = 5
        SCAN_TY_NEXT = p + 2
        return
    }
    if TK[p as usize] == 41 {
        p = p + 1
        let ens = TS[p as usize]
        let ene = TE[p as usize]
        let elem_ty = type_name_kind(ens, ene)
        SCAN_TY = 8
        if src_match(ens, ene - ens, "i8") {
            SCAN_TY_ESIZ = 1
        } else {
            SCAN_TY_ESIZ = 8
        }
        p = p + 1
        if TK[p as usize] == 27 { p = p + 1 }
        if TK[p as usize] == 4 {
            SCAN_TY_ALEN = TV[p as usize]
            p = p + 1
        }
        if TK[p as usize] == 42 { p = p + 1 }
        SCAN_TY_HASH = arr_ty_hash(SCAN_TY_ALEN, SCAN_TY_ESIZ, elem_ty)
        SCAN_TY_NEXT = p
        return
    }
    if TK[p as usize] == 3 {
        let ns = TS[p as usize]
        let ne = TE[p as usize]
        var saw_generic: i64 = 0
        if src_match(ns, ne - ns, "chan") {
            SCAN_TY = 0
            SCAN_TY_HASH = 0
            p = p + 1
            if TK[p as usize] == 3 {
                SCAN_TY_HASH = gl_name_hash(TS[p as usize], TE[p as usize])
                p = p + 1
            }
            SCAN_TY_NEXT = p
            return
        }
        if src_match(ns, ne - ns, "i8") {
            SCAN_TY = 1
        } else {
            if src_match(ns, ne - ns, "i32") {
                SCAN_TY = 1
            } else {
                if src_match(ns, ne - ns, "u32") {
                    SCAN_TY = 1
                } else {
                    if src_match(ns, ne - ns, "i64") {
                        SCAN_TY = 1
                    } else {
                        if src_match(ns, ne - ns, "u64") {
                            SCAN_TY = 1
                        } else {
                            if src_match(ns, ne - ns, "usize") {
                                SCAN_TY = 1
                            } else {
                                if src_match(ns, ne - ns, "f32") {
                                    SCAN_TY = 2
                                } else {
                                    if src_match(ns, ne - ns, "f64") {
                                        SCAN_TY = 2
                                    } else {
                                        if src_match(ns, ne - ns, "str") {
                                            SCAN_TY = 3
                                        } else {
                                            if src_match(ns, ne - ns, "string") {
                                                SCAN_TY = 3
                                            } else {
                                                if src_match(ns, ne - ns, "bool") {
                                                    SCAN_TY = 4
                                                } else {
                                                    let h = gl_name_hash(ns, ne)
                                                    if st_find(h) >= 0 {
                                                        SCAN_TY = 6
                                                        SCAN_TY_HASH = h
                                                    } else {
                                                        if en_find(h) >= 0 {
                                                            SCAN_TY = 7
                                                            SCAN_TY_HASH = h
                                                        } else {
                                                            // Unknown type name — leave as type 0 (unresolved)
                                                            // Type checker will skip errors for type-0 operands
                                                            SCAN_TY = 0
                                                            SCAN_TY_HASH = h
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // Option<T> → pointer-sized (tag + value); in struct fields, 2 qwords
        if src_match(ns, ne - ns, "Option") && TK[(p + 1) as usize] == 23 {
            p = p + 2
            scan_type(p)
            let inner_ty = SCAN_TY
            let inner_hash = SCAN_TY_HASH
            p = SCAN_TY_NEXT
            // Handle closing >: single > (24) or >> (39, both > consumed here — outer finds nothing)
            if TK[p as usize] == 24 { p = p + 1 }
            else if TK[p as usize] == 39 {
                // >> token: rewrite as > for idempotency, then advance past it entirely
                TK[p as usize] = 24
                TS[p as usize] = TS[p as usize] + 1
                p = p + 1
            }
            SCAN_TY = 11
            SCAN_TY_HASH = ptr_hash_make(inner_ty, inner_hash, 0)
            SCAN_TY_NEXT = p
            return
        }
        // Box<T> → heap pointer (8 bytes); transparent wrapper
        if src_match(ns, ne - ns, "Box") && TK[(p + 1) as usize] == 23 {
            p = p + 2
            scan_type(p)
            let inner_ty = SCAN_TY
            let inner_hash = SCAN_TY_HASH
            p = SCAN_TY_NEXT
            // Handle closing >: single > (24) or >> (39, both > consumed here — outer finds nothing)
            if TK[p as usize] == 24 { p = p + 1 }
            else if TK[p as usize] == 39 {
                TK[p as usize] = 24
                TS[p as usize] = TS[p as usize] + 1
                p = p + 1
            }
            SCAN_TY = 11
            SCAN_TY_HASH = ptr_hash_make(inner_ty, inner_hash, 0)
            SCAN_TY_NEXT = p
            return
        }
        if src_match(ns, ne - ns, "Unobserved") && TK[(p + 1) as usize] == 23 {
            p = p + 2
            scan_type(p)
            let inner_ty = SCAN_TY
            let inner_hash = SCAN_TY_HASH
            p = SCAN_TY_NEXT
            if TK[p as usize] == 24 { p = p + 1 }
            else if TK[p as usize] == 39 {
                TK[p as usize] = 24
                TS[p as usize] = TS[p as usize] + 1
                p = p + 1
            }
            SCAN_TY = 20
            SCAN_TY_HASH = unobserved_hash_make(inner_ty, inner_hash)
            SCAN_TY_NEXT = p
            return
        }
        if src_match(ns, ne - ns, "Knowledge") && (TK[(p + 1) as usize] == 23 || TK[(p + 1) as usize] == 41) {
            let open_tk = TK[(p + 1) as usize]
            var close_tk: i64 = 24
            if open_tk == 41 { close_tk = 42 }
            p = p + 2
            scan_type(p)
            let inner_ty = SCAN_TY
            let inner_hash = SCAN_TY_HASH
            var meta_mode: i64 = 0
            var eps_scaled: i64 = -1
            var invalid_eps: i64 = 0
            var saw_eps_meta: i64 = 0
            p = SCAN_TY_NEXT
            while TK[p as usize] == 28 {
                p = p + 1
                let meta_start = p
                if TK[p as usize] == 3 && src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "epsilon") {
                    if saw_eps_meta != 0 { invalid_eps = 1 }
                    saw_eps_meta = 1
                    p = p + 1
                    if TK[p as usize] == 23 {
                        p = p + 1
                        if TK[p as usize] == 4 || TK[p as usize] == 53 {
                            eps_scaled = tok_scaled_million(p)
                            if eps_scaled < 0 || eps_scaled > 1000000 { invalid_eps = 1 }
                            p = p + 1
                        } else {
                            invalid_eps = 1
                        }
                    } else {
                        invalid_eps = 1
                        p = skip_type_meta_item(meta_start, close_tk)
                    }
                } else if tok_is_unicode_epsilon(p) {
                    if saw_eps_meta != 0 { invalid_eps = 1 }
                    saw_eps_meta = 1
                    p = p + 1
                    if TK[p as usize] == 16 {
                        p = p + 1
                        if tok_is_unicode_bottom(p) {
                            meta_mode = 3
                            eps_scaled = -1
                            p = p + 1
                        } else {
                            if TK[p as usize] == 4 || TK[p as usize] == 53 {
                                meta_mode = 1
                                eps_scaled = tok_scaled_million(p)
                                if eps_scaled < 0 || eps_scaled > 1000000 { invalid_eps = 1 }
                                p = p + 1
                            } else {
                                invalid_eps = 1
                            }
                        }
                    } else {
                        if TK[p as usize] == 26 {
                            p = p + 1
                            meta_mode = 2
                            if TK[p as usize] == 4 || TK[p as usize] == 53 {
                                eps_scaled = tok_scaled_million(p)
                                if eps_scaled < 0 || eps_scaled > 1000000 { invalid_eps = 1 }
                                p = p + 1
                            } else {
                                invalid_eps = 1
                            }
                        } else {
                            invalid_eps = 1
                        }
                    }
                } else if TK[p as usize] == 3 && src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "ValidUntil") {
                    p = p + 1
                    if TK[p as usize] == 6 {
                        p = p + 1
                        if TK[p as usize] == 5 { p = p + 1 } else { invalid_eps = 1 }
                        if TK[p as usize] == 7 { p = p + 1 } else { invalid_eps = 1 }
                    } else {
                        invalid_eps = 1
                        p = skip_type_meta_item(meta_start, close_tk)
                    }
                } else if TK[p as usize] == 3 {
                    // Accept ignorable provenance/evidence tags like Derived.
                    p = p + 1
                } else {
                    invalid_eps = 1
                    p = skip_type_meta_item(meta_start, close_tk)
                }
            }
            if knowledge_hash_invalid(inner_hash) { invalid_eps = 1 }
            if TK[p as usize] == close_tk {
                p = p + 1
            } else {
                invalid_eps = 1
                p = skip_type_meta_item(p, close_tk)
                if TK[p as usize] == close_tk { p = p + 1 }
            }
            SCAN_TY = 0
            if invalid_eps != 0 {
                SCAN_TY_HASH = knowledge_hash_make_mode(inner_ty, inner_hash, meta_mode, -2)
            } else {
                SCAN_TY_HASH = knowledge_hash_make_mode(inner_ty, inner_hash, meta_mode, eps_scaled)
            }
            SCAN_TY_NEXT = p
            return
        }
        p = p + 1
        if TK[p as usize] == 23 {
            saw_generic = 1
            var gd: i64 = 1
            p = p + 1
            while p < TC && gd > 0 {
                if TK[p as usize] == 23 { gd = gd + 1 }
                if TK[p as usize] == 24 { gd = gd - 1 }
                if TK[p as usize] == 39 { gd = gd - 2 }  // >> counts as two >
                p = p + 1
            }
        }
        // saw_generic: SCAN_TY_HASH already holds hash(base_name) from the unknown-type branch.
        // Do NOT re-hash across the <...> span — that produces a garbage key that never matches
        // any mono-mangled name. The call site (compile_primary) resolves the monomorphized
        // version via mono_find_inst using the base-name hash.
    }
    SCAN_TY_NEXT = p
}

// Build mangled name "name_type" in SRC buffer, return (start, end)
fn mono_mangle(ns: i64, ne: i64, ts: i64, te: i64) -> i64 with Mut, Panic {
    let start = SRC_LEN
    var i: i64 = 0
    while i < ne - ns { SRC[(SRC_LEN + i) as usize] = SRC[(ns + i) as usize]; i = i + 1 }
    SRC_LEN = SRC_LEN + (ne - ns)
    SRC[SRC_LEN as usize] = 95; SRC_LEN = SRC_LEN + 1
    i = 0
    while i < te - ts { SRC[(SRC_LEN + i) as usize] = SRC[(ts + i) as usize]; i = i + 1 }
    SRC_LEN = SRC_LEN + (te - ts)
    return start
}

// Check if instantiation pair (gen_idx, is_struct, type_s, type_e) already recorded
fn mono_find_inst(gi: i64, is_st: i64, tys: i64, tye: i64) -> i64 with Panic, Mut {
    var i: i64 = 0
    while i < MONO_COUNT {
        if MONO_GEN[i as usize] == gi && MONO_IS_ST[i as usize] == is_st {
            if name_eq(MONO_TY_S[i as usize], MONO_TY_E[i as usize], tys, tye) { return i }
        }
        i = i + 1
    }
    return -1
}

// ─── Lexer ───
fn lex_all() with IO, Mut, Panic, Div {
    TC = 0
    LEX_ERROR_LINE = 0
    LEX_ERROR_KIND = 0
    var p: i64 = 0
    var cur_line: i64 = 1
    while p < SRC_LEN && TC < 262143 {
        let c = sb(p)
        // Whitespace
        // File boundary marker \x01<path>\x02 — emit TK==77 and reset line counter
        if c == 1 {
            p = p + 1
            while p < SRC_LEN && sb(p) != 2 { p = p + 1 }
            if p < SRC_LEN { p = p + 1 }
            TK[TC as usize] = 77; TS[TC as usize] = p; TE[TC as usize] = p; TL[TC as usize] = cur_line; TC = TC + 1
            cur_line = 1
            continue
        }
        if c == 2 || c == 32 || c == 9 || c == 13 || c == 10 { if c == 10 { cur_line = cur_line + 1 }; p = p + 1; continue }
        // Line comment
        if c == 47 && p + 1 < SRC_LEN && sb(p + 1) == 47 {
            p = p + 2; while p < SRC_LEN && sb(p) != 10 { p = p + 1 }; continue
        }
        // String literal
        if c == 34 {
            let s = p; p = p + 1
            while p < SRC_LEN && sb(p) != 34 {
                let sc = sb(p)
                if sc == 10 { cur_line = cur_line + 1 }
                if sc == 92 {
                    if p + 1 >= SRC_LEN {
                        if LEX_ERROR_LINE == 0 {
                            LEX_ERROR_LINE = cur_line
                            LEX_ERROR_KIND = 2
                        }
                        p = p + 1
                        continue
                    }
                    let esc = sb(p + 1)
                    if esc != 110 && esc != 116 && esc != 48 && esc != 92 && esc != 34 {
                        if LEX_ERROR_LINE == 0 {
                            LEX_ERROR_LINE = cur_line
                            LEX_ERROR_KIND = 2
                        }
                    }
                    if esc == 10 { cur_line = cur_line + 1 }
                    p = p + 2
                    continue
                }
                p = p + 1
            }
            if p < SRC_LEN && sb(p) == 34 { p = p + 1 }
            TK[TC as usize] = 5; TS[TC as usize] = s; TE[TC as usize] = p; TL[TC as usize] = cur_line; TC = TC + 1; continue
        }
        // Number (decimal or hex 0x...)
        if c >= 48 && c <= 57 {
            let s = p; var v: i64 = 0
            var frac: i64 = 0
            var denom: i64 = 1
            var is_float: i64 = 0
            var exp_sign: i64 = 1
            var exp_val: i64 = 0
            if c == 48 && p + 1 < SRC_LEN && (sb(p + 1) == 120 || sb(p + 1) == 88) {
                p = p + 2
                var hx: i64 = 1
                while p < SRC_LEN && hx == 1 {
                    let h = sb(p)
                    if h >= 48 && h <= 57 { v = v * 16 + h - 48; p = p + 1 }
                    else if h >= 97 && h <= 102 { v = v * 16 + h - 87; p = p + 1 }
                    else if h >= 65 && h <= 70 { v = v * 16 + h - 55; p = p + 1 }
                    else { hx = 0 }
                }
            } else {
                while p < SRC_LEN && sb(p) >= 48 && sb(p) <= 57 { v = v * 10 + sb(p) - 48; p = p + 1 }
            }
            // Check for float: digits.digits (dot followed by digit, not .field)
            if p < SRC_LEN && sb(p) == 46 && p + 1 < SRC_LEN && sb(p + 1) >= 48 && sb(p + 1) <= 57 {
                is_float = 1
                p = p + 1  // skip .
                FL_FRAC_DIGITS = 0
                while p < SRC_LEN && sb(p) >= 48 && sb(p) <= 57 {
                    if FL_FRAC_DIGITS < 18 { frac = frac * 10 + sb(p) - 48; denom = denom * 10; FL_FRAC_DIGITS = FL_FRAC_DIGITS + 1 }
                    p = p + 1
                }
            }
            // Scientific notation: digits(.digits)?e[+/-]digits
            if p < SRC_LEN && (sb(p) == 101 || sb(p) == 69) {
                var ep = p + 1
                var esign: i64 = 1
                if ep < SRC_LEN && sb(ep) == 43 { ep = ep + 1 }
                else if ep < SRC_LEN && sb(ep) == 45 { esign = 0 - 1; ep = ep + 1 }
                if ep < SRC_LEN && sb(ep) >= 48 && sb(ep) <= 57 {
                    is_float = 1
                    exp_sign = esign
                    p = ep
                    while p < SRC_LEN && sb(p) >= 48 && sb(p) <= 57 {
                        exp_val = exp_val * 10 + sb(p) - 48
                        p = p + 1
                    }
                }
            }
            // Gen 19: _suffix unit annotation on numeric literals (e.g. 500_mg, 9.8_m)
            var lit_unit_hash: i64 = 0
            if p < SRC_LEN && sb(p) == 95 && p + 1 < SRC_LEN && ((sb(p + 1) >= 65 && sb(p + 1) <= 90) || (sb(p + 1) >= 97 && sb(p + 1) <= 122)) {
                p = p + 1  // skip '_'
                let us = p
                while p < SRC_LEN && ((sb(p) >= 65 && sb(p) <= 90) || (sb(p) >= 97 && sb(p) <= 122) || (sb(p) >= 48 && sb(p) <= 57)) { p = p + 1 }
                lit_unit_hash = gl_name_hash(us, p)
            }
            if is_float == 1 {
                // Store mantissa parts without applying the exponent (avoids i64 overflow
                // for large exponents like 1.0e30). The signed exponent is stored in TX
                // and applied at codegen time via SSE2 multiply/divide.
                TK[TC as usize] = 53; TS[TC as usize] = s; TE[TC as usize] = p
                TV[TC as usize] = v; TF[TC as usize] = frac; TD[TC as usize] = denom
                TX[TC as usize] = exp_sign * exp_val
                TU[TC as usize] = lit_unit_hash
                TL[TC as usize] = cur_line; TC = TC + 1; continue
            }
            TK[TC as usize] = 4; TS[TC as usize] = s; TE[TC as usize] = p; TV[TC as usize] = v
            TU[TC as usize] = lit_unit_hash
            TL[TC as usize] = cur_line; TC = TC + 1; continue
        }
        if c == 206 && p + 1 < SRC_LEN && sb(p + 1) == 181 {
            TK[TC as usize] = 3
            TS[TC as usize] = p
            TE[TC as usize] = p + 2
            TL[TC as usize] = cur_line
            TC = TC + 1
            p = p + 2
            continue
        }
        if c == 226 && p + 2 < SRC_LEN && sb(p + 1) == 138 && sb(p + 2) == 165 {
            TK[TC as usize] = 3
            TS[TC as usize] = p
            TE[TC as usize] = p + 3
            TL[TC as usize] = cur_line
            TC = TC + 1
            p = p + 3
            continue
        }
        // Identifier / keyword
        if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 {
            let s = p
            while p < SRC_LEN && ((sb(p) >= 65 && sb(p) <= 90) || (sb(p) >= 97 && sb(p) <= 122) || (sb(p) >= 48 && sb(p) <= 57) || sb(p) == 95) { p = p + 1 }
            let l = p - s
            var k: i64 = 3
            if src_match(s, l, "fn") { k = 1 }
            if src_match(s, l, "return") { k = 2 }
            if src_match(s, l, "let") { k = 11 }
            if src_match(s, l, "var") { k = 12 }
            if src_match(s, l, "if") { k = 13 }
            if src_match(s, l, "else") { k = 14 }
            if src_match(s, l, "while") { k = 15 }
            if src_match(s, l, "continue") { k = 33 }
            if src_match(s, l, "break") { k = 34 }
            if src_match(s, l, "for") { k = 54 }
            if src_match(s, l, "true") { k = 35 }
            if src_match(s, l, "false") { k = 36 }
            if src_match(s, l, "as") { k = 37 }
            if src_match(s, l, "with") { k = 38 }
            if src_match(s, l, "struct") { k = 46 }
            if src_match(s, l, "enum") { k = 47 }
            if src_match(s, l, "match") { k = 48 }
            if src_match(s, l, "pub") { k = 49 }
            if src_match(s, l, "linear") { k = 62 }
            if src_match(s, l, "affine") { k = 73 }
            if src_match(s, l, "type") { k = 61 }
            if src_match(s, l, "algebra") { k = 70 }
            if src_match(s, l, "study") { k = 71 }
            if src_match(s, l, "ontology") { k = 72 }
            if src_match(s, l, "trait") { k = 75 }
            if src_match(s, l, "impl") { k = 76 }
            // `unit` is a soft keyword: used for measurement-unit declarations
            // (`unit mg;`) at top level, but usable as an identifier elsewhere.
            // Detected by the stmt parser via string + lookahead, not by token kind.
            // Gen 20: Door 2 — `kernel` keyword (TK=79) for GPU kernel function declarations
            if src_match(s, l, "kernel") { k = 79 }
            if src_match(s, l, "Some") { k = 57 }
            if src_match(s, l, "None") { k = 58 }
            if src_match(s, l, "Ok") { k = 59 }
            if src_match(s, l, "Err") { k = 60 }
            TK[TC as usize] = k; TS[TC as usize] = s; TE[TC as usize] = p; TL[TC as usize] = cur_line; TC = TC + 1; continue
        }
        // Two-char operators
        if c == 45 && p + 1 < SRC_LEN && sb(p + 1) == 62 { TK[TC as usize] = 10; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        if c == 61 && p + 1 < SRC_LEN && sb(p + 1) == 61 { TK[TC as usize] = 21; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        if c == 33 && p + 1 < SRC_LEN && sb(p + 1) == 61 { TK[TC as usize] = 22; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        if c == 60 && p + 1 < SRC_LEN && sb(p + 1) == 61 { TK[TC as usize] = 25; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        if c == 62 && p + 1 < SRC_LEN && sb(p + 1) == 61 { TK[TC as usize] = 26; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        if c == 58 && p + 1 < SRC_LEN && sb(p + 1) == 58 { TK[TC as usize] = 51; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        if c == 61 && p + 1 < SRC_LEN && sb(p + 1) == 62 { TK[TC as usize] = 52; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        if c == 38 && p + 1 < SRC_LEN && sb(p + 1) == 38 { TK[TC as usize] = 30; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        if c == 124 && p + 1 < SRC_LEN && sb(p + 1) == 124 { TK[TC as usize] = 31; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        if c == 62 && p + 1 < SRC_LEN && sb(p + 1) == 62 { TK[TC as usize] = 39; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        if c == 60 && p + 1 < SRC_LEN && sb(p + 1) == 60 { TK[TC as usize] = 40; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        // Rust attribute rejection: #[
        if c == 35 && p + 1 < SRC_LEN && sb(p + 1) == 91 { tc_rust_attribute_lex(cur_line); p = p + 2; while p < SRC_LEN && sb(p) != 93 { if sb(p) == 10 { cur_line = cur_line + 1 }; p = p + 1 }; if p < SRC_LEN { p = p + 1 }; continue }
        // Single-char operators
        if c == 40 { TK[TC as usize] = 6; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 41 { TK[TC as usize] = 7; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 123 { TK[TC as usize] = 8; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 125 { TK[TC as usize] = 9; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 61 { TK[TC as usize] = 16; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 43 && p + 1 < SRC_LEN && sb(p + 1) == 43 { TK[TC as usize] = 74; TS[TC as usize] = p; TE[TC as usize] = p + 2; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 2; continue }
        if c == 43 { TK[TC as usize] = 17; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 45 { TK[TC as usize] = 18; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 42 { TK[TC as usize] = 19; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 47 { TK[TC as usize] = 20; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 37 { TK[TC as usize] = 29; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 60 { TK[TC as usize] = 23; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 62 { TK[TC as usize] = 24; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 59 { TK[TC as usize] = 27; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 44 { TK[TC as usize] = 28; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 33 { TK[TC as usize] = 32; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 91 { TK[TC as usize] = 41; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 93 { TK[TC as usize] = 42; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 58 { TK[TC as usize] = 43; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 38 { TK[TC as usize] = 44; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 124 { TK[TC as usize] = 45; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        // ..= range inclusive (3-char, check first)
        if c == 46 && p + 2 < SRC_LEN && sb(p + 1) == 46 && sb(p + 2) == 61 {
            TK[TC as usize] = 64
            TS[TC as usize] = p
            TE[TC as usize] = p + 3
            TL[TC as usize] = cur_line
            TC = TC + 1
            p = p + 3
            continue
        }
        // .. range exclusive (2-char)
        if c == 46 && p + 1 < SRC_LEN && sb(p + 1) == 46 {
            TK[TC as usize] = 63
            TS[TC as usize] = p
            TE[TC as usize] = p + 2
            TL[TC as usize] = cur_line
            TC = TC + 1
            p = p + 2
            continue
        }
        if c == 46 { TK[TC as usize] = 50; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 126 { TK[TC as usize] = 55; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c == 94 { TK[TC as usize] = 56; TS[TC as usize] = p; TE[TC as usize] = p + 1; TL[TC as usize] = cur_line; TC = TC + 1; p = p + 1; continue }
        if c >= 128 && LEX_ERROR_LINE == 0 {
            LEX_ERROR_LINE = cur_line
            LEX_ERROR_KIND = 1
        }
        p = p + 1
    }
    TK[TC as usize] = 0; TL[TC as usize] = cur_line; TC = TC + 1
}

// ─── Variable lookup ───
fn var_find(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = VAR_COUNT - 1
    while i >= 0 {
        if name_eq(VAR_NS[i as usize], VAR_NE[i as usize], ns, ne) { return VAR_SLOT[i as usize] }
        i = i - 1
    }
    return -1
}

fn const_find_val(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = 0
    while i < CONST_COUNT {
        if name_eq(CONST_NS[i as usize], CONST_NE[i as usize], ns, ne) {
            CONST_FOUND_VAL = CONST_VAL[i as usize]
            return 1
        }
        i = i + 1
    }
    return 0
}

fn scan_all_consts() with Panic, Mut {
    CONST_COUNT = 0
    var p: i64 = 0
    var cv: i64 = 0
    var neg_c: i64 = 0
    var cn_ns: i64 = 0
    var cn_ne: i64 = 0
    var depth: i64 = 0
    while p < TC {
        if TK[p as usize] == 8 { depth = depth + 1; p = p + 1; continue }
        if TK[p as usize] == 9 {
            if depth > 0 { depth = depth - 1 }
            p = p + 1
            continue
        }
        // top-level let NAME: TYPE = LITERAL
        if depth == 0 && TK[p as usize] == 11 {
            p = p + 1  // skip 'let'
            if TK[p as usize] != 3 { continue }
            if CONST_COUNT >= 511 { p = p + 1; continue }
            cn_ns = TS[p as usize]; cn_ne = TE[p as usize]; p = p + 1
            while p < TC && TK[p as usize] != 16 && TK[p as usize] != 0 { p = p + 1 }
            if TK[p as usize] == 16 { p = p + 1 }
            cv = 0; neg_c = 0
            if TK[p as usize] == 18 { neg_c = 1; p = p + 1 }
            if TK[p as usize] == 4 { cv = TV[p as usize]; p = p + 1 }
            if neg_c != 0 { cv = 0 - cv }
            CONST_NS[CONST_COUNT as usize] = cn_ns
            CONST_NE[CONST_COUNT as usize] = cn_ne
            CONST_VAL[CONST_COUNT as usize] = cv
            CONST_COUNT = CONST_COUNT + 1
            continue
        }
        // bare 'const NAME: TYPE = VALUE'
        if depth == 0 && TK[p as usize] == 3 && src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "const") {
            p = p + 1  // skip 'const'
            if TK[p as usize] != 3 { continue }
            if CONST_COUNT >= 511 { p = p + 1; continue }
            cn_ns = TS[p as usize]; cn_ne = TE[p as usize]; p = p + 1
            while p < TC && TK[p as usize] != 16 && TK[p as usize] != 0 { p = p + 1 }
            if TK[p as usize] == 16 { p = p + 1 }
            cv = 0; neg_c = 0
            if TK[p as usize] == 18 { neg_c = 1; p = p + 1 }
            if TK[p as usize] == 4 { cv = TV[p as usize]; p = p + 1 }
            if neg_c != 0 { cv = 0 - cv }
            CONST_NS[CONST_COUNT as usize] = cn_ns
            CONST_NE[CONST_COUNT as usize] = cn_ne
            CONST_VAL[CONST_COUNT as usize] = cv
            CONST_COUNT = CONST_COUNT + 1
            continue
        }
        if TK[p as usize] != 49 { p = p + 1; continue }
        p = p + 1  // skip 'pub'
        if TK[p as usize] != 3 { continue }
        if src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "const") == false { continue }
        p = p + 1  // skip 'const'
        if TK[p as usize] != 3 { continue }
        if CONST_COUNT >= 511 { p = p + 1; continue }
        cn_ns = TS[p as usize]; cn_ne = TE[p as usize]; p = p + 1
        while p < TC && TK[p as usize] != 16 && TK[p as usize] != 0 { p = p + 1 }
        if TK[p as usize] == 16 { p = p + 1 }
        cv = 0; neg_c = 0
        if TK[p as usize] == 18 { neg_c = 1; p = p + 1 }
        if TK[p as usize] == 4 { cv = TV[p as usize]; p = p + 1 }
        if neg_c != 0 { cv = 0 - cv }
        CONST_NS[CONST_COUNT as usize] = cn_ns
        CONST_NE[CONST_COUNT as usize] = cn_ne
        CONST_VAL[CONST_COUNT as usize] = cv
        CONST_COUNT = CONST_COUNT + 1
    }
}

fn ont_find_class(ns: i64, ne: i64) -> bool with Mut, Panic {
    var i: i64 = 0
    while i < ONT_CLASS_COUNT {
        if name_eq(ns, ne, ONT_CLASS_S[i as usize], ONT_CLASS_E[i as usize]) { return true }
        i = i + 1
    }
    return false
}

fn ont_find_role(ns: i64, ne: i64) -> bool with Mut, Panic {
    var i: i64 = 0
    while i < ONT_ROLE_COUNT {
        if name_eq(ns, ne, ONT_ROLE_S[i as usize], ONT_ROLE_E[i as usize]) { return true }
        i = i + 1
    }
    return false
}

fn ont_error(tok: i64, code: i64, msg: string) with IO, Mut, Panic {
    print("error[E")
    if code < 100 { print("0") }
    if code < 10 { print("0") }
    print_int(code)
    print("] at line ")
    print_int(TL[tok as usize])
    print(": ")
    print(msg)
    print("\n")
    tc_mark_failed()
}

fn ont_find_class_by_hash(h: i64) -> i64 with Mut, Panic {
    var i: i64 = 0
    while i < ONT_CLASS_COUNT {
        if ONT_CLASS_HASH[i as usize] == h { return i }
        i = i + 1
    }
    return -1
}

fn ont_materialize_kernel() with Mut, Panic {
    // Set reflexive closure
    var i: i64 = 0
    while i < ONT_CLASS_COUNT {
        ONT_SUB_MATRIX[(i * 64 + i) as usize] = 1
        i = i + 1
    }
    // Floyd-Warshall transitive closure on subclass matrix
    var k: i64 = 0
    while k < ONT_CLASS_COUNT {
        var ii: i64 = 0
        while ii < ONT_CLASS_COUNT {
            var j: i64 = 0
            while j < ONT_CLASS_COUNT {
                if ONT_SUB_MATRIX[(ii * 64 + k) as usize] != 0 && ONT_SUB_MATRIX[(k * 64 + j) as usize] != 0 {
                    ONT_SUB_MATRIX[(ii * 64 + j) as usize] = 1
                }
                j = j + 1
            }
            ii = ii + 1
        }
        k = k + 1
    }
    // Propagate disjoint through subclass hierarchy (single pass, closure already complete)
    var a: i64 = 0
    while a < ONT_CLASS_COUNT {
        var b: i64 = 0
        while b < ONT_CLASS_COUNT {
            if ONT_DIS_MATRIX[(a * 64 + b) as usize] != 0 {
                var x: i64 = 0
                while x < ONT_CLASS_COUNT {
                    if ONT_SUB_MATRIX[(x * 64 + a) as usize] != 0 {
                        ONT_DIS_MATRIX[(x * 64 + b) as usize] = 1
                        ONT_DIS_MATRIX[(b * 64 + x) as usize] = 1
                    }
                    if ONT_SUB_MATRIX[(x * 64 + b) as usize] != 0 {
                        ONT_DIS_MATRIX[(a * 64 + x) as usize] = 1
                        ONT_DIS_MATRIX[(x * 64 + a) as usize] = 1
                    }
                    x = x + 1
                }
            }
            b = b + 1
        }
        a = a + 1
    }
}

fn try_tc_ontology_call_error(tok: i64, param_hash: i64, arg_hash: i64) -> i64 with IO, Mut, Panic {
    if param_hash == 0 || arg_hash == 0 { return 0 }
    let pi = ont_find_class_by_hash(param_hash)
    let ai = ont_find_class_by_hash(arg_hash)
    if pi < 0 || ai < 0 { return 0 }
    if pi == ai { return 2 }
    if ONT_DIS_MATRIX[(ai * 64 + pi) as usize] != 0 {
        ont_error(tok, 151, "ontology classes are disjoint and cannot be substituted")
        return 1
    }
    if ONT_SUB_MATRIX[(ai * 64 + pi) as usize] != 0 { return 2 }
    ont_error(tok, 152, "cannot prove ontology subsumption at this call site")
    return 1
}

// Parse property declarations inside a class body { ... }, recording constraints.
// ci = class index, p0 = token after '{', body_end = token of closing '}'.
// Returns token position after consuming the class body (past '}').
fn ont_parse_class_body_props(ci: i64, p0: i64, body_end: i64) -> i64 with IO, Mut, Panic {
    var pp: i64 = p0
    while pp < body_end && TK[pp as usize] != 9 {
        if TK[pp as usize] != 3 { pp = pp + 1; continue }
        let kw_s = TS[pp as usize]
        let kw_l = TE[pp as usize] - TS[pp as usize]
        if src_match(kw_s, kw_l, "property") == false { pp = pp + 1; continue }
        pp = pp + 1  // skip "property"
        if pp >= body_end || TK[pp as usize] != 3 { continue }
        let prop_hash = gl_name_hash(TS[pp as usize], TE[pp as usize])
        pp = pp + 1  // skip property name
        // skip ": type"
        if pp < body_end && TK[pp as usize] == 43 {
            pp = pp + 1  // skip ':'
            if pp < body_end && TK[pp as usize] == 3 { pp = pp + 1 }  // skip type name
        }
        // look for "where"
        if pp >= body_end || TK[pp as usize] != 3 { continue }
        if src_match(TS[pp as usize], TE[pp as usize] - TS[pp as usize], "where") == false { continue }
        pp = pp + 1  // skip "where"
        if pp >= body_end || TK[pp as usize] != 3 { continue }
        pp = pp + 1  // skip property name in predicate
        if pp >= body_end { continue }
        var prop_dir: i64 = 0
        if TK[pp as usize] == 26 { prop_dir = 0; pp = pp + 1 }       // >=
        else if TK[pp as usize] == 25 { prop_dir = 1; pp = pp + 1 }  // <=
        else { continue }
        // read optional negation and numeric value
        var prop_neg: i64 = 0
        if pp < body_end && TK[pp as usize] == 18 { prop_neg = 1; pp = pp + 1 }
        var prop_int_val: i64 = 0
        var prop_frac_val: i64 = 0
        var prop_denom: i64 = 1
        if pp < body_end && TK[pp as usize] == 4 {
            prop_int_val = TV[pp as usize]
            pp = pp + 1
        } else if pp < body_end && TK[pp as usize] == 53 {
            prop_int_val = TV[pp as usize]
            prop_frac_val = TF[pp as usize]
            prop_denom = TD[pp as usize]
            if prop_denom == 0 { prop_denom = 1 }
            pp = pp + 1
        } else { continue }
        // Compute signed bound ×1000
        var bound: i64 = prop_int_val * 1000 + prop_frac_val * 1000 / prop_denom
        if prop_neg != 0 { bound = 0 - bound }
        // Store
        if ONT_PROP_CNT < 256 {
            ONT_PROP_CLS[ONT_PROP_CNT as usize] = ci
            ONT_PROP_NHASH[ONT_PROP_CNT as usize] = prop_hash
            ONT_PROP_BOUND[ONT_PROP_CNT as usize] = bound
            ONT_PROP_DIR[ONT_PROP_CNT as usize] = prop_dir
            ONT_PROP_CNT = ONT_PROP_CNT + 1
        }
    }
    // skip past closing '}'
    if pp < TC && TK[pp as usize] == 9 { pp = pp + 1 }
    return pp
}

// After ONT_SUB_MATRIX is built, check that every subclass relationship
// respects property constraint subsumption: child constraints must imply parent.
fn ont_check_prop_subsumption(ont_tok: i64) with IO, Mut, Panic {
    var ci: i64 = 0
    while ci < ONT_CLASS_COUNT {
        var pi: i64 = 0
        while pi < ONT_CLASS_COUNT {
            if ci != pi && ONT_SUB_MATRIX[(ci * 64 + pi) as usize] != 0 {
                // ci is a subclass of pi; check all pi's properties appear in ci with tighter constraints
                var j: i64 = 0
                while j < ONT_PROP_CNT {
                    if ONT_PROP_CLS[j as usize] == pi {
                        let par_hash = ONT_PROP_NHASH[j as usize]
                        let par_bound = ONT_PROP_BOUND[j as usize]
                        let par_dir = ONT_PROP_DIR[j as usize]
                        // find matching property in child ci
                        var k: i64 = 0
                        var found: i64 = 0
                        while k < ONT_PROP_CNT {
                            if ONT_PROP_CLS[k as usize] == ci && ONT_PROP_NHASH[k as usize] == par_hash {
                                let child_bound = ONT_PROP_BOUND[k as usize]
                                let child_dir = ONT_PROP_DIR[k as usize]
                                found = 1
                                // Check: child bound implies parent bound
                                // For >=: child_bound >= par_bound required (tighter lower bound)
                                // For <=: child_bound <= par_bound required (tighter upper bound)
                                var ok: i64 = 1
                                if par_dir == 0 && child_dir == 0 {
                                    if child_bound < par_bound { ok = 0 }
                                } else if par_dir == 1 && child_dir == 1 {
                                    if child_bound > par_bound { ok = 0 }
                                } else {
                                    ok = 0
                                }
                                if ok == 0 {
                                    ont_error(ont_tok, 160, "ontology subsumption could not be verified: child property constraint weakens parent")
                                }
                            }
                            k = k + 1
                        }
                    }
                    j = j + 1
                }
            }
            pi = pi + 1
        }
        ci = ci + 1
    }
}

fn skip_ontology_decl(p0: i64) -> i64 with IO, Mut, Panic {
    var p = p0 + 1  // skip 'ontology'
    let ont_tok = p0

    // Reset subclass/disjoint matrices from previous block
    var zi: i64 = 0
    while zi < ONT_CLASS_COUNT * 64 {
        ONT_SUB_MATRIX[zi as usize] = 0
        ONT_DIS_MATRIX[zi as usize] = 0
        zi = zi + 1
    }

    // Reset per-block tracking
    ONT_CLASS_COUNT = 0
    ONT_ROLE_COUNT = 0
    ONT_PROP_CNT = 0

    if p < TC && TK[p as usize] == 3 { p = p + 1 }  // skip name

    // Find opening brace
    while p < TC && TK[p as usize] != 8 && TK[p as usize] != 0 { p = p + 1 }
    if p >= TC || TK[p as usize] != 8 { return p }
    p = p + 1  // skip {
    let body_start = p

    // --- Pass 1: collect class/role names and store class hashes ---
    while p < TC && TK[p as usize] != 9 {
        if TK[p as usize] != 3 { p = p + 1; continue }
        let kw_s = TS[p as usize]
        let kw_l = TE[p as usize] - TS[p as usize]

        // "class" = 5 chars
        if src_match(kw_s, kw_l, "class") {
            p = p + 1  // skip "class"
            if p < TC && TK[p as usize] == 3 {
                if ONT_CLASS_COUNT < 64 {
                    ONT_CLASS_S[ONT_CLASS_COUNT as usize] = TS[p as usize]
                    ONT_CLASS_E[ONT_CLASS_COUNT as usize] = TE[p as usize]
                    ONT_CLASS_HASH[ONT_CLASS_COUNT as usize] = gl_name_hash(TS[p as usize], TE[p as usize])
                    ONT_CLASS_COUNT = ONT_CLASS_COUNT + 1
                }
                p = p + 1  // skip class name
            }
            // Skip subclass_of clause (stop at declaration keywords to avoid over-advance)
            if p < TC && TK[p as usize] == 3 && src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "subclass_of") {
                p = p + 1  // skip "subclass_of"
                while p < TC && (TK[p as usize] == 3 || TK[p as usize] == 28) {
                    if TK[p as usize] == 3 {
                        let skip_l = TE[p as usize] - TS[p as usize]
                        if src_match(TS[p as usize], skip_l, "class") { break }
                        if src_match(TS[p as usize], skip_l, "disjoint") { break }
                        if src_match(TS[p as usize], skip_l, "role") { break }
                        if src_match(TS[p as usize], skip_l, "subclass_of") { break }
                    }
                    p = p + 1
                }
            }
            if p < TC && TK[p as usize] == 8 {
                // Skip nested { property ... } block
                var depth: i64 = 1
                p = p + 1
                while p < TC && depth > 0 {
                    if TK[p as usize] == 8 { depth = depth + 1 }
                    if TK[p as usize] == 9 { depth = depth - 1 }
                    p = p + 1
                }
            }
            continue
        }

        // "disjoint" = 8 chars
        if src_match(kw_s, kw_l, "disjoint") {
            p = p + 1  // skip "disjoint"
            // skip comma-separated names
            while p < TC && (TK[p as usize] == 3 || TK[p as usize] == 28) { p = p + 1 }
            continue
        }

        // "role" = 4 chars
        if src_match(kw_s, kw_l, "role") {
            let role_tok = p
            p = p + 1  // skip "role"
            if p >= TC || TK[p as usize] != 3 { continue }

            let rn_s = TS[p as usize]
            let rn_e = TE[p as usize]

            // Check duplicate role
            if ont_find_role(rn_s, rn_e) {
                ont_error(role_tok, 159, "duplicate role declaration")
            }

            // Register role
            if ONT_ROLE_COUNT < 32 {
                ONT_ROLE_S[ONT_ROLE_COUNT as usize] = rn_s
                ONT_ROLE_E[ONT_ROLE_COUNT as usize] = rn_e
                ONT_ROLE_COUNT = ONT_ROLE_COUNT + 1
            }
            p = p + 1  // skip role name

            // Parse role modifiers: domain, range, inverse_of, transitive, etc.
            while p < TC && TK[p as usize] == 3 {
                let mod_s = TS[p as usize]
                let mod_l = TE[p as usize] - TS[p as usize]

                if src_match(mod_s, mod_l, "domain") {
                    p = p + 1  // skip "domain"
                    if p < TC && TK[p as usize] == 3 {
                        if !ont_find_class(TS[p as usize], TE[p as usize]) {
                            ont_error(p, 156, "role domain class not found in ontology")
                        }
                        p = p + 1
                    }
                } else if src_match(mod_s, mod_l, "range") {
                    p = p + 1  // skip "range"
                    if p < TC && TK[p as usize] == 3 {
                        if !ont_find_class(TS[p as usize], TE[p as usize]) {
                            ont_error(p, 157, "role range class not found in ontology")
                        }
                        p = p + 1
                    }
                } else if src_match(mod_s, mod_l, "inverse_of") {
                    p = p + 1  // skip "inverse_of"
                    if p < TC && TK[p as usize] == 3 {
                        if !ont_find_role(TS[p as usize], TE[p as usize]) {
                            ont_error(p, 158, "inverse_of target role not found")
                        }
                        p = p + 1
                    }
                } else if src_match(mod_s, mod_l, "transitive") || src_match(mod_s, mod_l, "functional") || src_match(mod_s, mod_l, "symmetric") {
                    p = p + 1
                } else {
                    break
                }
            }
            continue
        }

        // Unknown keyword in ontology block — skip
        p = p + 1
    }
    let body_end = p

    // --- Pass 2: build subclass/disjoint relationship matrices ---
    p = body_start
    while p < TC && p < body_end && TK[p as usize] != 9 {
        if TK[p as usize] != 3 { p = p + 1; continue }
        let kw_s2 = TS[p as usize]
        let kw_l2 = TE[p as usize] - TS[p as usize]

        if src_match(kw_s2, kw_l2, "class") {
            p = p + 1  // skip "class"
            if p >= body_end || TK[p as usize] != 3 { continue }
            let cn_h = gl_name_hash(TS[p as usize], TE[p as usize])
            let ci = ont_find_class_by_hash(cn_h)
            p = p + 1  // skip class name
            // Handle subclass_of relationships
            if p < body_end && TK[p as usize] == 3 && src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "subclass_of") {
                p = p + 1  // skip "subclass_of"
                while p < body_end && (TK[p as usize] == 3 || TK[p as usize] == 28) {
                    if TK[p as usize] == 3 {
                        let tsn_l = TE[p as usize] - TS[p as usize]
                        if src_match(TS[p as usize], tsn_l, "class") { break }
                        if src_match(TS[p as usize], tsn_l, "disjoint") { break }
                        if src_match(TS[p as usize], tsn_l, "role") { break }
                        if src_match(TS[p as usize], tsn_l, "subclass_of") { break }
                        let sn_h = gl_name_hash(TS[p as usize], TE[p as usize])
                        let si = ont_find_class_by_hash(sn_h)
                        if ci >= 0 && si >= 0 {
                            ONT_SUB_MATRIX[(ci * 64 + si) as usize] = 1
                        }
                    }
                    p = p + 1
                }
            }
            // Parse class body { property ... } for constraint tracking
            if p < body_end && TK[p as usize] == 8 {
                let body_inner = p + 1
                p = ont_parse_class_body_props(ci, body_inner, body_end)
            }
            continue
        }

        if src_match(kw_s2, kw_l2, "disjoint") {
            p = p + 1  // skip "disjoint"
            ONT_DIS_TMP_CNT = 0
            while p < body_end && (TK[p as usize] == 3 || TK[p as usize] == 28) {
                if TK[p as usize] == 3 {
                    let dh = gl_name_hash(TS[p as usize], TE[p as usize])
                    let di = ont_find_class_by_hash(dh)
                    if di >= 0 && ONT_DIS_TMP_CNT < 64 {
                        ONT_DIS_TMP[ONT_DIS_TMP_CNT as usize] = di
                        ONT_DIS_TMP_CNT = ONT_DIS_TMP_CNT + 1
                    }
                }
                p = p + 1
            }
            var dii: i64 = 0
            while dii < ONT_DIS_TMP_CNT {
                var djj: i64 = dii + 1
                while djj < ONT_DIS_TMP_CNT {
                    let da = ONT_DIS_TMP[dii as usize]
                    let db = ONT_DIS_TMP[djj as usize]
                    ONT_DIS_MATRIX[(da * 64 + db) as usize] = 1
                    ONT_DIS_MATRIX[(db * 64 + da) as usize] = 1
                    djj = djj + 1
                }
                dii = dii + 1
            }
            continue
        }

        // Skip roles and other keywords token-by-token
        p = p + 1
    }

    // Compute transitive closure + propagate disjoint through subclass hierarchy
    ont_materialize_kernel()

    // Check property constraint subsumption for all subclass relationships
    ont_check_prop_subsumption(ont_tok)

    // Skip closing }
    if body_end < TC && TK[body_end as usize] == 9 { return body_end + 1 }
    return body_end
}

// Global: count of hypotheses in current compilation (for provenance metadata)
var STUDY_HYPO_COUNT: i64 = 0

fn skip_study_decl(p0: i64) -> i64 with IO, Mut, Panic {
    let study_tok = p0
    var p = p0 + 1
    var depth: i64 = 0
    var saw_hypothesis: i64 = 0

    while p < TC && TK[p as usize] != 8 && TK[p as usize] != 0 { p = p + 1 }
    if p >= TC || TK[p as usize] != 8 {
        return p
    }

    depth = 1
    p = p + 1
    while p < TC && depth > 0 {
        if TK[p as usize] == 3 && src_match(TS[p as usize], TE[p as usize] - TS[p as usize], "hypothesis") {
            saw_hypothesis = 1
            STUDY_HYPO_COUNT = STUDY_HYPO_COUNT + 1
        }
        // Mark fn definitions inside study blocks with Hypothesis effect (bit 256)
        // by injecting the effect bit when the function scanner encounters them.
        // (The actual injection happens via CURRENT_STUDY_EFFECT in the fn scanner.)
        if TK[p as usize] == 8 {
            depth = depth + 1
        } else if TK[p as usize] == 9 {
            depth = depth - 1
        }
        p = p + 1
    }

    if saw_hypothesis == 0 {
        tc_mark_failed()
        print("error: study block requires at least one hypothesis at line ")
        print_int(TL[study_tok as usize])
        print("\n")
    }

    p
}

fn local_meta_add(
    ns: i64,
    ne: i64,
    slot: i64,
    len_slot: i64,
    alen: i64,
    esiz: i64,
    is_f64: i64,
    is_closure: i64,
    is_mut: i64,
    unit_hash: i64,
    is_linear: i64,
    used: i64,
    ty: i64,
    ty_hash: i64
) -> i64 with Mut, Panic {
    if VAR_COUNT >= local_cap() {
        note_limit_error(1)
        return -1
    }
    let idx = VAR_COUNT
    VAR_NS[idx as usize] = ns
    VAR_NE[idx as usize] = ne
    VAR_SLOT[idx as usize] = slot
    VAR_LEN_SLOT[idx as usize] = len_slot
    VAR_ALEN[idx as usize] = alen
    VAR_ESIZ[idx as usize] = esiz
    VAR_IS_F64[idx as usize] = is_f64
    VAR_IS_CLOSURE[idx as usize] = is_closure
    VAR_MUT[idx as usize] = is_mut
    VAR_UNIT[idx as usize] = unit_hash
    VAR_LINEAR[idx as usize] = is_linear
    VAR_AFFINE[idx as usize] = 0
    VAR_MOVED[idx as usize] = 0
    VAR_BORROW_COUNT[idx as usize] = 0
    VAR_BORROW_EXCL[idx as usize] = 0
    VAR_USED[idx as usize] = used
    VAR_TY[idx as usize] = ty
    VAR_TY_HASH[idx as usize] = ty_hash
    VAR_COUNT = VAR_COUNT + 1
    return idx
}

fn var_add(ns: i64, ne: i64) -> i64 with Mut, Panic {
    let slot = NEXT_SLOT
    if local_meta_add(ns, ne, slot, 0, 0, 8, 0, 0, 0, 0, 0, 0, 0, 0) < 0 {
        LAST_LOCAL_BSS_SPILL = 0
        LAST_LOCAL_BSS_ADDR = 0
        return -1
    }
    NEXT_SLOT = NEXT_SLOT + 1
    LAST_LOCAL_BSS_SPILL = 0
    LAST_LOCAL_BSS_ADDR = 0
    return slot
}

// Add a local array variable: allocate N slots, return base slot, store lea as value
fn var_add_arr(ns: i64, ne: i64, alen: i64, esiz: i64, elem_ty: i64) -> i64 with Mut, Panic, Div {
    let storage_bytes = alen * 8
    let spill = storage_bytes >= local_bss_spill_bytes()
    let base = NEXT_SLOT
    if spill == false { NEXT_SLOT = NEXT_SLOT + alen }
    let ptr_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    if local_meta_add(ns, ne, ptr_slot, 0, alen, esiz, 0, 0, 0, 0, 0, 0, 8, arr_ty_hash(alen, esiz, elem_ty)) < 0 {
        if spill == false { NEXT_SLOT = NEXT_SLOT - alen }
        NEXT_SLOT = NEXT_SLOT - 1
        LAST_LOCAL_BSS_SPILL = 0
        LAST_LOCAL_BSS_ADDR = 0
        return -1
    }
    if spill != false {
        LAST_LOCAL_BSS_SPILL = 1
        LAST_LOCAL_BSS_ADDR = GL_BSS_BASE + bss_alloc_aligned(storage_bytes)
    } else {
        LAST_LOCAL_BSS_SPILL = 0
        LAST_LOCAL_BSS_ADDR = 0
    }
    return ptr_slot
}

fn var_find_len_slot(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = VAR_COUNT - 1
    while i >= 0 {
        if name_eq(VAR_NS[i as usize], VAR_NE[i as usize], ns, ne) { return VAR_LEN_SLOT[i as usize] }
        i = i - 1
    }
    return 0
}

fn bind_slice_local_from_rax_x86(ns: i64, ne: i64, ty_hash: i64) with Mut, Panic, Div {
    let inner_hash = ref_hash_inner_hash(ty_hash)
    let len_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    let ptr_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    if local_meta_add(ns, ne, ptr_slot, len_slot, 0, arr_hash_esiz(inner_hash), 0, 0, 0, 0, 0, 0, 10, ty_hash) < 0 {
        NEXT_SLOT = NEXT_SLOT - 2
        return
    }
    if type_is_slice_ref(EXPR_TY, EXPR_TY_HASH) {
        em(0x48); em(0x89); em(0xc2)  // mov rdx, rax
        em(0x48); em(0x8b); em(0x02)  // mov rax, [rdx]
        emit_store_var(ptr_slot)
        em(0x48); em(0x8b); em(0x42); em(8)  // mov rax, [rdx + 8]
        emit_store_var(len_slot)
    } else if EXPR_TY == 10 && ref_hash_inner_ty(EXPR_TY_HASH) == 8 {
        emit_store_var(ptr_slot)
        emit_imm64(arr_hash_alen(ref_hash_inner_hash(EXPR_TY_HASH)))
        emit_store_var(len_slot)
    } else {
        emit_store_var(ptr_slot)
        emit_imm64(0)
        emit_store_var(len_slot)
    }
    emit_lea_var(ptr_slot)
}

fn bind_slice_local_from_x0_a64(ns: i64, ne: i64, ty_hash: i64) with Mut, Panic, Div {
    let inner_hash = ref_hash_inner_hash(ty_hash)
    let len_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    let ptr_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    if local_meta_add(ns, ne, ptr_slot, len_slot, 0, arr_hash_esiz(inner_hash), 0, 0, 0, 0, 0, 0, 10, ty_hash) < 0 {
        NEXT_SLOT = NEXT_SLOT - 2
        return
    }
    if type_is_slice_ref(EXPR_TY, EXPR_TY_HASH) {
        em32(0xAA0003EA)  // mov x10, x0
        em32(0xF9400140)  // ldr x0, [x10]
        emit_store_var_a64(ptr_slot)
        em32(0xF9400540)  // ldr x0, [x10, #8]
        emit_store_var_a64(len_slot)
    } else if EXPR_TY == 10 && ref_hash_inner_ty(EXPR_TY_HASH) == 8 {
        emit_store_var_a64(ptr_slot)
        emit_imm64_a64(arr_hash_alen(ref_hash_inner_hash(EXPR_TY_HASH)))
        emit_store_var_a64(len_slot)
    } else {
        emit_store_var_a64(ptr_slot)
        em32(0xD2800000)
        emit_store_var_a64(len_slot)
    }
    emit_lea_var_a64(ptr_slot)
}

// Find array info for a local variable by name
fn var_find_alen(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = VAR_COUNT - 1
    while i >= 0 {
        if name_eq(VAR_NS[i as usize], VAR_NE[i as usize], ns, ne) { return VAR_ALEN[i as usize] }
        i = i - 1
    }
    return 0
}

fn var_find_esiz(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = VAR_COUNT - 1
    while i >= 0 {
        if name_eq(VAR_NS[i as usize], VAR_NE[i as usize], ns, ne) { return VAR_ESIZ[i as usize] }
        i = i - 1
    }
    return 8
}

fn var_find_is_f64(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = VAR_COUNT - 1
    while i >= 0 {
        if name_eq(VAR_NS[i as usize], VAR_NE[i as usize], ns, ne) { return VAR_IS_F64[i as usize] }
        i = i - 1
    }
    return 0
}

fn var_find_is_mut(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = VAR_COUNT - 1
    while i >= 0 {
        if name_eq(VAR_NS[i as usize], VAR_NE[i as usize], ns, ne) { return VAR_MUT[i as usize] }
        i = i - 1
    }
    return 0
}

fn var_find_is_closure(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = VAR_COUNT - 1
    while i >= 0 {
        if name_eq(VAR_NS[i as usize], VAR_NE[i as usize], ns, ne) { return VAR_IS_CLOSURE[i as usize] }
        i = i - 1
    }
    return 0
}

// Mark a variable as used (for linear type checking)
fn var_mark_used(ns: i64, ne: i64) with Mut, Panic {
    var i: i64 = VAR_COUNT - 1
    while i >= 0 {
        if name_eq(VAR_NS[i as usize], VAR_NE[i as usize], ns, ne) {
            VAR_USED[i as usize] = VAR_USED[i as usize] + 1
            return
        }
        i = i - 1
    }
}

// Find variable index by name (not slot, but index into VAR arrays)
fn var_find_idx(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = VAR_COUNT - 1
    while i >= 0 {
        if name_eq(VAR_NS[i as usize], VAR_NE[i as usize], ns, ne) { return i }
        i = i - 1
    }
    return -1
}

fn var_find_ty(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = VAR_COUNT - 1
    while i >= 0 {
        if name_eq(VAR_NS[i as usize], VAR_NE[i as usize], ns, ne) { return VAR_TY[i as usize] }
        i = i - 1
    }
    return 0
}

fn var_find_ty_hash(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = VAR_COUNT - 1
    while i >= 0 {
        if name_eq(VAR_NS[i as usize], VAR_NE[i as usize], ns, ne) { return VAR_TY_HASH[i as usize] }
        i = i - 1
    }
    return 0
}

// Release call-site borrows recorded during a call's argument list
// Release borrows recorded from index `from_n` to current CALL_ARG_BORROW_N,
// then restore CALL_ARG_BORROW_N to from_n.  Supports nested calls correctly:
// each call saves its own base and only releases the borrows it added.
fn release_call_arg_borrows(from_n: i64) with Mut {
    var ri: i64 = from_n
    while ri < CALL_ARG_BORROW_N {
        let rvi = CALL_ARG_BORROW_VI[ri as usize]
        if rvi >= 0 && rvi < 1024 {
            if CALL_ARG_BORROW_EXCL[ri as usize] != 0 {
                if VAR_BORROW_EXCL[rvi as usize] > 0 {
                    VAR_BORROW_EXCL[rvi as usize] = VAR_BORROW_EXCL[rvi as usize] - 1
                }
            } else {
                if VAR_BORROW_COUNT[rvi as usize] > 0 {
                    VAR_BORROW_COUNT[rvi as usize] = VAR_BORROW_COUNT[rvi as usize] - 1
                }
            }
        }
        ri = ri + 1
    }
    CALL_ARG_BORROW_N = from_n
}

// ─── Function lookup ───
fn fn_find(ns: i64, ne: i64) -> i64 with Panic, Mut {
    var i: i64 = 0
    while i < FN_COUNT {
        if name_eq(FN_NS[i as usize], FN_NE[i as usize], ns, ne) { return i }
        i = i + 1
    }
    return -1
}

fn fn_find_method(ns: i64, ne: i64, recv_hash: i64) -> i64 with Panic, Mut {
    // First: exact match on name + receiver hash
    var i: i64 = 0
    while i < FN_COUNT {
        if name_eq(FN_NS[i as usize], FN_NE[i as usize], ns, ne) {
            if FN_RECV_HASH[i as usize] == recv_hash { return i }
        }
        i = i + 1
    }
    // Fallback: match by name only, but ONLY if receiver hash is 0 (no impl context)
    // This prevents ABI mismatch when two functions have the same name but different
    // return types (e.g., a method and a standalone function).
    if recv_hash == 0 {
        i = 0
        while i < FN_COUNT {
            if name_eq(FN_NS[i as usize], FN_NE[i as usize], ns, ne) { return i }
            i = i + 1
        }
    }
    // SIZE_HINT fallback: recv_hash is 1000000007+nslots after tuple .0 materialization.
    // The actual struct type was lost; fall back to name-only match so method calls work.
    if recv_hash >= 1000000007 {
        if recv_hash < 1000001007 {
            i = 0
            while i < FN_COUNT {
                if name_eq(FN_NS[i as usize], FN_NE[i as usize], ns, ne) { return i }
                i = i + 1
            }
        }
    }
    return -1
}

fn fn_find_lit(name: string) -> i64 with Panic, Mut, Div {
    let name_len = str_len(name)
    var i: i64 = 0
    while i < FN_COUNT {
        if FN_NE[i as usize] - FN_NS[i as usize] == name_len {
            if src_match(FN_NS[i as usize], name_len, name) { return i }
        }
        i = i + 1
    }
    return -1
}

// ─── Emit helpers ───
// mov rax, [rbp - 8*slot]
fn emit_load_var(slot: i64) with Mut { em(0x48); em(0x8b); em(0x85); em32(0 - slot * 8) }
// mov [rbp - 8*slot], rax
fn emit_store_var(slot: i64) with Mut { em(0x48); em(0x89); em(0x85); em32(0 - slot * 8) }
// lea rax, [rbp - 8*slot]
fn emit_lea_var(slot: i64) with Mut { em(0x48); em(0x8d); em(0x85); em32(0 - slot * 8) }
// push rax
fn emit_push() with Mut { em(0x50) }
// pop rcx
fn emit_pop_rcx() with Mut { em(0x59) }
// mov rax, imm64
fn emit_imm64(v: i64) with Mut { em(0x48); em(0xb8); em64(v) }

fn emit_push_expr_as_slice_arg_x86(call_tok: i64) with IO, Mut, Panic, Div {
    if type_is_slice_ref(EXPR_TY, EXPR_TY_HASH) {
        em(0x48); em(0x89); em(0xc2)  // mov rdx, rax
        em(0x48); em(0x8b); em(0x02)  // mov rax, [rdx]
        emit_push()
        em(0x48); em(0x8b); em(0x42); em(8)  // mov rax, [rdx + 8]
        emit_push()
        return
    }
    if type_is_array_ref(EXPR_TY, EXPR_TY_HASH) {
        emit_push()
        emit_imm64(arr_hash_alen(ref_hash_inner_hash(EXPR_TY_HASH)))
        emit_push()
        return
    }
    tc_error(call_tok, "slice argument requires slice or array reference")
    emit_push()
    emit_imm64(0)
    emit_push()
}

fn emit_push_expr_as_slice_arg_a64(call_tok: i64) with IO, Mut, Panic, Div {
    if type_is_slice_ref(EXPR_TY, EXPR_TY_HASH) {
        em32(0xAA0003EA)  // mov x10, x0
        em32(0xF9400140)  // ldr x0, [x10]
        emit_push_a64()
        em32(0xF9400540)  // ldr x0, [x10, #8]
        emit_push_a64()
        return
    }
    if type_is_array_ref(EXPR_TY, EXPR_TY_HASH) {
        emit_push_a64()
        emit_imm64_a64(arr_hash_alen(ref_hash_inner_hash(EXPR_TY_HASH)))
        emit_push_a64()
        return
    }
    tc_error(call_tok, "slice argument requires slice or array reference")
    emit_push_a64()
    em32(0xD2800000)
    emit_push_a64()
}

fn emit_slice_len_of_expr_x86(call_tok: i64) with IO, Mut, Panic, Div {
    if type_is_slice_ref(EXPR_TY, EXPR_TY_HASH) {
        em(0x48); em(0x8b); em(0x40); em(8)  // mov rax, [rax + 8]
    } else if type_is_array_ref(EXPR_TY, EXPR_TY_HASH) {
        emit_imm64(arr_hash_alen(ref_hash_inner_hash(EXPR_TY_HASH)))
    } else {
        tc_error(call_tok, "slice_len requires slice or array reference")
        em(0x31); em(0xc0)
    }
    EXPR_IS_F64 = 0
    EXPR_TY = 1
    EXPR_TY_HASH = 0
}

fn emit_slice_len_of_expr_a64(call_tok: i64) with IO, Mut, Panic, Div {
    if type_is_slice_ref(EXPR_TY, EXPR_TY_HASH) {
        em32(0xF9400400)  // ldr x0, [x0, #8]
    } else if type_is_array_ref(EXPR_TY, EXPR_TY_HASH) {
        emit_imm64_a64(arr_hash_alen(ref_hash_inner_hash(EXPR_TY_HASH)))
    } else {
        tc_error(call_tok, "slice_len requires slice or array reference")
        em32(0xD2800000)
    }
    EXPR_IS_F64 = 0
    EXPR_TY = 1
    EXPR_TY_HASH = 0
}

fn bind_array_local_from_rax_x86(ns: i64, ne: i64, ty_hash: i64) with Mut, Panic, Div {
    let esiz = arr_hash_esiz(ty_hash)
    let elem_ty = arr_hash_elem_ty(ty_hash)
    let nslots = arr_storage_slots(ty_hash)
    let ptr_slot = var_add_arr(ns, ne, nslots, esiz, elem_ty)
    if ptr_slot < 0 { return }
    let arr_vi = VAR_COUNT - 1
    let base = ptr_slot - nslots
    VAR_TY[arr_vi as usize] = 8
    VAR_TY_HASH[arr_vi as usize] = ty_hash
    em(0x48); em(0x89); em(0xc2)  // mov rdx, rax
    if LAST_LOCAL_BSS_SPILL != 0 {
        em(0x48); em(0xb8); em64(LAST_LOCAL_BSS_ADDR)
        emit_copy_agg_to_ptr_x86(8, ty_hash)
        em(0x48); em(0xb8); em64(LAST_LOCAL_BSS_ADDR)
    } else {
        var i: i64 = 0
        while i < nslots {
            em(0x48); em(0x8b); em(0x82); em32(i * 8)  // mov rax, [rdx + off]
            emit_store_var(base + nslots - 1 - i)
            i = i + 1
        }
        em(0x48); em(0x8d); em(0x85)
        em32(0 - (base + nslots - 1) * 8)
    }
    emit_store_var(ptr_slot)
}

fn copy_array_into_local_slot_x86(slot: i64, ty_hash: i64) with Mut, Panic, Div {
    let nslots = arr_storage_slots(ty_hash)
    em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (src ptr)
    emit_load_var(slot)
    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (dst ptr)
    var i: i64 = 0
    while i < nslots {
        em(0x48); em(0x8b); em(0x82); em32(i * 8)  // mov rax, [rdx + off]
        em(0x48); em(0x89); em(0x81); em32(i * 8)  // mov [rcx + off], rax
        i = i + 1
    }
    em(0x48); em(0x89); em(0xc8)  // mov rax, rcx
}

fn bind_struct_local_from_rax_x86(ns: i64, ne: i64, ty_hash: i64) with Mut, Panic, Div {
    let si = st_find(ty_hash)
    if si < 0 && knowledge_hash_is(ty_hash) == false {
        let slot = var_add(ns, ne)
        if slot < 0 { return }
        emit_store_var(slot)
        let vix = VAR_COUNT - 1
        VAR_TY[vix as usize] = 6
        VAR_TY_HASH[vix as usize] = ty_hash
        return
    }
    let nslots = struct_like_nslots(ty_hash)
    // ptr_slot FIRST, then data slots. Keeps ptr safe from overwrites.
    let ptr_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    let base = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + nslots
    var linear_flag: i64 = 0
    var affine_flag: i64 = 0
    if knowledge_hash_is(ty_hash) == false { linear_flag = ST_LINEAR[si as usize]; affine_flag = ST_AFFINE[si as usize] }
    var out_ty: i64 = 0
    if knowledge_hash_is(ty_hash) == false { out_ty = 6 }
    if local_meta_add(ns, ne, ptr_slot, 0, 0, 8, 0, 0, 0, 0, linear_flag, 0, out_ty, ty_hash) < 0 {
        NEXT_SLOT = NEXT_SLOT - nslots - 1
        return
    }
    VAR_AFFINE[(VAR_COUNT - 1) as usize] = affine_flag
    // Copy struct data to local slots and store LEA pointer
    emit_bulk_copy_to_slots_x86(nslots, base)
    emit_store_var(ptr_slot)
}

// Zero-initialize a struct local — used for 'var x: T' with no initializer
fn bind_struct_local_zeroinit_x86(ns: i64, ne: i64, ty_hash: i64) with Mut, Panic, Div {
    let si = st_find(ty_hash)
    if si < 0 && knowledge_hash_is(ty_hash) == false {
        let slot = var_add(ns, ne)
        if slot < 0 { return }
        em(0x48); em(0x31); em(0xc0)  // xor rax, rax
        emit_store_var(slot)
        let vix = VAR_COUNT - 1
        VAR_TY[vix as usize] = 6
        VAR_TY_HASH[vix as usize] = ty_hash
        return
    }
    let nslots = struct_like_nslots(ty_hash)
    let ptr_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    let base = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + nslots
    var linear_flag: i64 = 0
    var affine_flag: i64 = 0
    if knowledge_hash_is(ty_hash) == false { linear_flag = ST_LINEAR[si as usize]; affine_flag = ST_AFFINE[si as usize] }
    var out_ty: i64 = 0
    if knowledge_hash_is(ty_hash) == false { out_ty = 6 }
    if local_meta_add(ns, ne, ptr_slot, 0, 0, 8, 0, 0, 0, 0, linear_flag, 0, out_ty, ty_hash) < 0 {
        NEXT_SLOT = NEXT_SLOT - nslots - 1
        return
    }
    VAR_AFFINE[(VAR_COUNT - 1) as usize] = affine_flag
    // Zero-init slots via rep stosq
    em(0x48); em(0x8d); em(0xbd)   // lea rdi, [rbp - (base+nslots-1)*8]
    em32(0 - (base + nslots - 1) * 8)
    em(0x48); em(0x31); em(0xc0)   // xor rax, rax
    em(0xb9); em32(nslots)          // mov ecx, nslots
    em(0xf3); em(0x48); em(0xab)   // rep stosq
    // Store LEA pointer in ptr_slot
    em(0x48); em(0x8d); em(0x85)   // lea rax, [rbp - (base+nslots-1)*8]
    em32(0 - (base + nslots - 1) * 8)
    emit_store_var(ptr_slot)
}

// Emit init code for all top-level `var NAME: TY = EXPR` declarations.
// Called once at main's entry before the body is compiled. BSS-zero covers the
// zero-initialized case; this catches non-zero literal and expression inits
// (e.g. `var PI: f64 = 3.14159`, `var TUNE: i64 = 42`).
// Array globals with repeat syntax `[V; N]` fall through to BSS zero (V must be 0
// for correctness; other values are not yet supported).
fn emit_global_inits_x86() with IO, Mut, Panic, Div {
    var p: i64 = 0
    var depth: i64 = 0
    while p < TC {
        let tk = TK[p as usize]
        if tk == 8 { depth = depth + 1; p = p + 1; continue }
        if tk == 9 { depth = depth - 1; p = p + 1; continue }
        if depth > 0 { p = p + 1; continue }
        if tk == 12 {
            p = p + 1
            let gns = TS[p as usize]
            let gne = TE[p as usize]
            p = p + 1
            if p < TC && TK[p as usize] == 43 {
                p = p + 1
                if TK[p as usize] == 41 {
                    while p < TC && TK[p as usize] != 42 { p = p + 1 }
                    if p < TC { p = p + 1 }
                } else {
                    scan_type(p)
                    p = SCAN_TY_NEXT
                }
            }
            if p < TC && TK[p as usize] == 16 {
                p = p + 1
                if TK[p as usize] == 41 {
                    // Array repeat initializer: [V; N]
                    let gi_arr = gl_find(gns, gne)
                    if gi_arr >= 0 {
                        p = p + 1                              // skip [
                        EP = p
                        compile_or()                           // value V in rax
                        p = EP
                        if p < TC && TK[p as usize] == 27 { p = p + 1 }   // skip ;
                        if p < TC && TK[p as usize] == 4 { p = p + 1 }    // skip N literal (alen already stored)
                        if p < TC && TK[p as usize] == 42 { p = p + 1 }   // skip ]
                        let base = GL_BSS_BASE + GL[(gi_arr * 4 + 1) as usize]
                        let esiz = GL[(gi_arr * 4 + 2) as usize]
                        let alen = GL[(gi_arr * 4 + 3) as usize]
                        if alen > 0 {
                            em(0x48); em(0xbf); em64(base)         // mov rdi, base
                            em(0x48); em(0xb9); em64(alen)         // mov rcx, alen
                            if esiz == 1 {
                                em(0xf3); em(0xaa)                 // rep stosb (uses al)
                            } else {
                                em(0xf3); em(0x48); em(0xab)       // rep stosq (uses rax)
                            }
                        }
                        continue
                    }
                    while p < TC && TK[p as usize] != 12 && TK[p as usize] != 1 && TK[p as usize] != 0 { p = p + 1 }
                    continue
                }
                let gi = gl_find(gns, gne)
                if gi >= 0 {
                    EP = p
                    compile_or()
                    let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                    em(0x48); em(0x89); em(0xc1)
                    em(0x48); em(0xb8); em64(addr)
                    em(0x48); em(0x89); em(0x08)
                    p = EP
                    continue
                }
            }
            while p < TC && TK[p as usize] != 12 && TK[p as usize] != 1 && TK[p as usize] != 0 { p = p + 1 }
            continue
        }
        p = p + 1
    }
}

fn copy_struct_into_local_slot_x86(slot: i64, ty_hash: i64) with Mut, Panic, Div {
    let si = st_find(ty_hash)
    if si < 0 && knowledge_hash_is(ty_hash) == false { emit_store_var(slot); return }
    let nslots = struct_like_nslots(ty_hash)
    // Struct vars are laid out as [ptr_slot, data_slots...] by bind_struct_local_*.
    // Copy data from rax (source struct ptr, often a fresh SRET buffer) into the
    // var's stable data slots, then re-anchor ptr_slot to those data slots.
    // Storing only the pointer (an earlier optimization) caused `a = step(&a, dt)`
    // to silently corrupt: the next iteration's nested SRET buffer would alias
    // with where the previous SRET still lived through `a`'s ptr_slot.
    let data_base = slot + 1
    emit_bulk_copy_to_slots_x86(nslots, data_base)
    emit_store_var(slot)
}

fn emit_bulk_copy_to_slots_x86(nslots: i64, base: i64) with Mut, Panic, Div {
    // rax = source pointer. Copy nslots qwords to stack slots [base..base+nslots-1].
    // Stack layout: slot base+nslots-1 is at lowest address = rbp - (base+nslots-1)*8.
    // For nslots > 32: use rep movsq (constant-size code).
    // For nslots <= 32: per-qword mov (lower overhead for small aggregates).
    if nslots > 32 {
        em(0x48); em(0x89); em(0xc6)      // mov rsi, rax (source)
        em(0x48); em(0x8d); em(0xbd)      // lea rdi, [rbp - (base+nslots-1)*8]
        em32(0 - (base + nslots - 1) * 8)
        em(0xb9); em32(nslots)            // mov ecx, nslots
        em(0xf3); em(0x48); em(0xa5)      // rep movsq
        em(0x48); em(0x8d); em(0x85)      // lea rax, [rbp - (base+nslots-1)*8]
        em32(0 - (base + nslots - 1) * 8)
    } else {
        em(0x48); em(0x89); em(0xc2)      // mov rdx, rax
        var i: i64 = 0
        while i < nslots {
            em(0x48); em(0x8b); em(0x82); em32(i * 8)  // mov rax, [rdx + i*8]
            emit_store_var(base + nslots - 1 - i)
            i = i + 1
        }
        em(0x48); em(0x8d); em(0x85)
        em32(0 - (base + nslots - 1) * 8)
    }
}

fn materialize_aggregate_expr_x86() with Mut, Panic, Div {
    if EXPR_TY == 8 {
        let nslots = arr_storage_slots(EXPR_TY_HASH)
        // Large arrays exceed the spill threshold: rax already holds a pointer to the
        // array data (from var load or BSS). Pass the pointer as-is rather than
        // copying 1M+ slots onto the local stack frame.
        if nslots * 8 >= local_bss_spill_bytes() { return }
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + nslots
        emit_bulk_copy_to_slots_x86(nslots, base)
        return
    }
    if type_is_struct_like(EXPR_TY, EXPR_TY_HASH) {
        let nslots = struct_like_nslots(EXPR_TY_HASH)
        if nslots <= 0 { return }
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + nslots
        emit_bulk_copy_to_slots_x86(nslots, base)
    }
}

fn copy_agg_into_struct_slots_x86(dst_start: i64, field_ty: i64, field_hash: i64) with Mut, Panic, Div {
    var nslots: i64 = 0
    if field_ty == 8 {
        nslots = arr_storage_slots(field_hash)
    } else if field_ty == 6 || knowledge_hash_is(field_hash) {
        nslots = struct_like_nslots(field_hash)
    }
    if nslots <= 0 { emit_store_var(dst_start); return }
    if nslots > 32 {
        // rep movsq: rax=source, dst slots are dst_start..dst_start-nslots+1
        em(0x48); em(0x89); em(0xc6)      // mov rsi, rax (source)
        em(0x48); em(0x8d); em(0xbd)      // lea rdi, [rbp - dst_start*8]
        em32(0 - dst_start * 8)
        em(0xb9); em32(nslots)            // mov ecx, nslots
        em(0xf3); em(0x48); em(0xa5)      // rep movsq
    } else {
        em(0x48); em(0x89); em(0xc2)
        var i: i64 = 0
        while i < nslots {
            em(0x48); em(0x8b); em(0x82); em32(i * 8)
            emit_store_var(dst_start - i)
            i = i + 1
        }
    }
}

fn emit_copy_agg_to_ptr_x86(field_ty: i64, field_hash: i64) with Mut, Panic, Div {
    // Copy nslots qwords from [rdx] to [rax] (both pointers)
    var nslots: i64 = 0
    if field_ty == 8 {
        nslots = arr_storage_slots(field_hash)
    } else if field_ty == 6 || knowledge_hash_is(field_hash) {
        nslots = struct_like_nslots(field_hash)
    }
    if nslots <= 0 { return }
    if nslots > 32 {
        // rep movsq: rsi=rdx (source), rdi=rax (dest)
        em(0x48); em(0x89); em(0xd6)      // mov rsi, rdx
        em(0x48); em(0x89); em(0xc7)      // mov rdi, rax
        em(0xb9); em32(nslots)            // mov ecx, nslots
        em(0xf3); em(0x48); em(0xa5)      // rep movsq
    } else {
        var i: i64 = 0
        while i < nslots {
            em(0x48); em(0x8b); em(0x8a); em32(i * 8)  // mov rcx, [rdx + i*8]
            em(0x48); em(0x89); em(0x88); em32(i * 8)  // mov [rax + i*8], rcx
            i = i + 1
        }
    }
}

fn fill_repeat_struct_array_slots_x86(dst_start: i64, field_hash: i64) with Mut, Panic, Div {
    let nslots = arr_storage_slots(field_hash)
    var i: i64 = 0
    while i < nslots {
        emit_store_var(dst_start - i)
        i = i + 1
    }
}

fn stabilize_return_agg_x86(expr_ty: i64, expr_hash: i64) with Mut, Panic, Div {
    var nslots = ret_agg_nslots(CURRENT_RET_TY, CURRENT_RET_HASH)
    if nslots <= 0 { nslots = ret_agg_nslots(expr_ty, expr_hash) }
    if nslots <= 0 { return }
    em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (src ptr)
    if CURRENT_SRET_SLOT > 0 {
        // Use r12 (callee-saved, set at prologue) as SRET pointer — immune to stack corruption
        em(0x4c); em(0x89); em(0xe1)  // mov rcx, r12
    } else {
        let dst = GL_BSS_BASE + RET_AGG_BSS_OFF
        em(0x48); em(0xb9); em64(dst)  // mov rcx, dst ptr
    }
    if nslots > 32 {
        em(0x48); em(0x89); em(0xd6)      // mov rsi, rdx (source)
        em(0x48); em(0x89); em(0xcf)      // mov rdi, rcx (dest)
        em(0xb9); em32(nslots)            // mov ecx, nslots
        em(0xf3); em(0x48); em(0xa5)      // rep movsq
    } else {
        var i: i64 = 0
        while i < nslots {
            em(0x48); em(0x8b); em(0x82); em32(i * 8)  // mov rax, [rdx + i*8]
            em(0x48); em(0x89); em(0x81); em32(i * 8)  // mov [rcx + i*8], rax
            i = i + 1
        }
    }
    if CURRENT_SRET_SLOT > 0 {
        em(0x4c); em(0x89); em(0xe0)  // mov rax, r12 (return SRET ptr in rax)
    } else {
        let dst2 = GL_BSS_BASE + RET_AGG_BSS_OFF
        em(0x48); em(0xb8); em64(dst2)
    }
}

// ─── Emit print("string") ───
fn emit_print(tok: i64) with Mut, Panic, Div {
    let ss = TS[tok as usize] + 1
    let se = TE[tok as usize] - 1
    var slen: i64 = 0
    var zi: i64 = 0
    while zi < 256 { SQW[zi as usize] = 0; zi = zi + 1 }
    var si: i64 = ss
    while si < se {
        let c = sb(si)
        var byte: i64 = c
        if c == 92 && si + 1 < se {
            let c2 = sb(si + 1)
            if c2 == 110 { byte = 10 }
            else if c2 == 116 { byte = 9 }
            else if c2 == 48 { byte = 0 }
            else { byte = c2 }
            si = si + 2
        } else { si = si + 1 }
        let qi = slen / 8
        let bi = slen - qi * 8
        SQW[qi as usize] = SQW[qi as usize] | (byte << (bi * 8))
        slen = slen + 1
    }
    let nq = (slen + 7) / 8
    var qi: i64 = nq - 1
    while qi >= 0 { em(0x48); em(0xb8); em64(SQW[qi as usize]); em(0x50); qi = qi - 1 }
    em(0xb8); em32(1); em(0xbf); em32(1)
    em(0x48); em(0x89); em(0xe6)
    em(0xba); em32(slen)
    em(0x0f); em(0x05)
    em(0x48); em(0x81); em(0xc4); em32(nq * 8)
}

fn emit_print_cstr() with Mut {
    // rax = C string pointer
    em(0x48); em(0x89); em(0xc7)  // mov rdi, rax (ptr)
    em(0x48); em(0x31); em(0xc9)  // xor rcx, rcx
    let slp = CL
    em(0x80); em(0x3c); em(0x0f); em(0x00)  // cmp byte [rdi+rcx], 0
    em(0x74); em(0x04)  // je done
    em(0x48); em(0xff); em(0xc1)  // inc rcx
    em(0xeb); em(0xf5 as i64 & 0xFF)  // jmp loop
    em(0x48); em(0x89); em(0xfe)  // mov rsi, rdi
    em(0x48); em(0x89); em(0xca)  // mov rdx, rcx
    em(0xb8); em32(1)
    em(0xbf); em32(1)
    em(0x0f); em(0x05)
}

fn emit_print_nl() with Mut {
    em(0x6a); em(10)  // push '\n'
    em(0xb8); em32(1)
    em(0xbf); em32(1)
    em(0x48); em(0x89); em(0xe6)
    em(0xba); em32(1)
    em(0x0f); em(0x05)
    em(0x48); em(0x83); em(0xc4); em(8)
}

fn emit_assert_fail() with Mut {
    em(0xbf); em32(1)
    em(0xb8); em32(60)
    em(0x0f); em(0x05)
}

fn emit_sqrt_builtin_x86() with Mut {
    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc0)
    em(0xf2); em(0x0f); em(0x51); em(0xc0)
    em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
}

fn emit_exp_builtin_x86() with Mut {
    em(0x48); em(0x83); em(0xec); em(16)
    em(0x48); em(0x89); em(0x44); em(0x24); em(8)
    em(0xdd); em(0x44); em(0x24); em(8)
    em(0xd9); em(0xea)
    em(0xde); em(0xc9)
    em(0xd9); em(0xc0)
    em(0xd9); em(0xfc)
    em(0xd9); em(0xc9)
    em(0xd8); em(0xe1)
    em(0xd9); em(0xf0)
    em(0xd9); em(0xe8)
    em(0xde); em(0xc1)
    em(0xd9); em(0xfd)
    em(0xdd); em(0xd9)
    em(0xdd); em(0x1c); em(0x24)
    em(0x48); em(0x8b); em(0x04); em(0x24)
    em(0x48); em(0x83); em(0xc4); em(16)
}

fn emit_log_builtin_x86() with Mut {
    em(0x48); em(0x83); em(0xec); em(16)
    em(0x48); em(0x89); em(0x44); em(0x24); em(8)
    em(0xd9); em(0xed)
    em(0xdd); em(0x44); em(0x24); em(8)
    em(0xd9); em(0xf1)
    em(0xdd); em(0x1c); em(0x24)
    em(0x48); em(0x8b); em(0x04); em(0x24)
    em(0x48); em(0x83); em(0xc4); em(16)
}

fn emit_i64_to_f64_in_rax_x86() with Mut {
    em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xc0)
    em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
}

fn emit_f64_add_from_rcx_rax_x86() with Mut {
    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1)
    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)
    em(0xf2); em(0x0f); em(0x58); em(0xc1)
    em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
}

fn emit_f64_sub_from_rcx_rax_x86() with Mut {
    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1)
    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)
    em(0xf2); em(0x0f); em(0x5c); em(0xc1)
    em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
}

fn emit_f64_mul_from_rcx_rax_x86() with Mut {
    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1)
    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)
    em(0xf2); em(0x0f); em(0x59); em(0xc1)
    em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
}

fn emit_f64_div_from_rcx_rax_x86() with Mut {
    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1)
    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)
    em(0xf2); em(0x0f); em(0x5e); em(0xc1)
    em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
}

fn emit_load_operand_value_x86(slot: i64, ty: i64, ty_hash: i64, tok: i64) with IO, Mut, Panic, Div {
    emit_load_var(slot)
    if knowledge_hash_is(ty_hash) {
        em(0x48); em(0x8b); em(0x00)
        let inner_ty = knowledge_hash_inner_ty(ty_hash)
        if inner_ty != 2 {
            if ty_is_numeric(inner_ty) { emit_i64_to_f64_in_rax_x86() }
            else {
                tc_error(tok, "Knowledge arithmetic requires numeric inner type")
                em(0x31); em(0xc0)
            }
        }
        return
    }
    if ty != 2 {
        if ty_is_numeric(ty) { emit_i64_to_f64_in_rax_x86() }
        else {
            tc_error(tok, "Knowledge arithmetic requires numeric operands")
            em(0x31); em(0xc0)
        }
    }
}

fn emit_load_operand_variance_x86(slot: i64, ty_hash: i64) with Mut {
    if knowledge_hash_is(ty_hash) {
        emit_load_var(slot)
        em(0x48); em(0x8b); em(0x40); em(8)
        return
    }
    em(0x31); em(0xc0)
}

fn emit_load_operand_confidence_x86(slot: i64, ty_hash: i64) with Mut {
    if knowledge_hash_is(ty_hash) {
        emit_load_var(slot)
        em(0x48); em(0x8b); em(0x40); em(16)
        return
    }
    emit_imm64(4607182418800017408)
}

fn emit_min_positive_f64_bits_x86() with Mut {
    em(0x48); em(0x39); em(0xc1)
    em(0x48); em(0x0f); em(0x4e); em(0xc1)
}

fn compile_knowledge_addsub_x86(op_tok: i64, op: i64, left_ty: i64, left_hash: i64, right_ty: i64, right_hash: i64) with IO, Mut, Panic, Div {
    let rhs_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var(rhs_slot)
    let lhs_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    em(0x58)
    emit_store_var(lhs_slot)
    let base_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 3

    emit_load_operand_value_x86(lhs_slot, left_ty, left_hash, op_tok)
    em(0x50)
    emit_load_operand_value_x86(rhs_slot, right_ty, right_hash, op_tok)
    em(0x59)
    if op == 17 { emit_f64_add_from_rcx_rax_x86() } else { emit_f64_sub_from_rcx_rax_x86() }
    emit_store_var(base_slot + 2)

    emit_load_operand_variance_x86(lhs_slot, left_hash)
    em(0x50)
    emit_load_operand_variance_x86(rhs_slot, right_hash)
    em(0x59)
    emit_f64_add_from_rcx_rax_x86()
    emit_store_var(base_slot + 1)

    emit_load_operand_confidence_x86(lhs_slot, left_hash)
    em(0x50)
    emit_load_operand_confidence_x86(rhs_slot, right_hash)
    em(0x59)
    emit_min_positive_f64_bits_x86()
    emit_store_var(base_slot)

    em(0x48); em(0x8d); em(0x85)
    em32(0 - (base_slot + 2) * 8)
    EXPR_IS_F64 = 0
    EXPR_TY = 0
    EXPR_TY_HASH = knowledge_binary_result_hash(op, left_ty, left_hash, right_ty, right_hash)
}

fn compile_knowledge_muldiv_x86(op_tok: i64, op: i64, left_ty: i64, left_hash: i64, right_ty: i64, right_hash: i64) with IO, Mut, Panic, Div {
    let rhs_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var(rhs_slot)
    let lhs_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    em(0x58)
    emit_store_var(lhs_slot)
    let base_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 3

    emit_load_operand_value_x86(lhs_slot, left_ty, left_hash, op_tok)
    em(0x50)
    emit_load_operand_value_x86(rhs_slot, right_ty, right_hash, op_tok)
    em(0x59)
    if op == 19 { emit_f64_mul_from_rcx_rax_x86() } else { emit_f64_div_from_rcx_rax_x86() }
    emit_store_var(base_slot + 2)

    if op == 19 {
        emit_load_operand_value_x86(lhs_slot, left_ty, left_hash, op_tok)
        em(0x50)
        emit_load_operand_value_x86(lhs_slot, left_ty, left_hash, op_tok)
        em(0x59)
        emit_f64_mul_from_rcx_rax_x86()
        em(0x50)
        emit_load_operand_variance_x86(rhs_slot, right_hash)
        em(0x59)
        emit_f64_mul_from_rcx_rax_x86()
        em(0x50)

        emit_load_operand_value_x86(rhs_slot, right_ty, right_hash, op_tok)
        em(0x50)
        emit_load_operand_value_x86(rhs_slot, right_ty, right_hash, op_tok)
        em(0x59)
        emit_f64_mul_from_rcx_rax_x86()
        em(0x50)
        emit_load_operand_variance_x86(lhs_slot, left_hash)
        em(0x59)
        emit_f64_mul_from_rcx_rax_x86()

        em(0x59)
        emit_f64_add_from_rcx_rax_x86()
    } else {
        emit_load_operand_variance_x86(lhs_slot, left_hash)
        em(0x50)
        emit_load_operand_value_x86(rhs_slot, right_ty, right_hash, op_tok)
        em(0x50)
        emit_load_operand_value_x86(rhs_slot, right_ty, right_hash, op_tok)
        em(0x59)
        emit_f64_mul_from_rcx_rax_x86()
        em(0x59)
        emit_f64_div_from_rcx_rax_x86()
        em(0x50)

        emit_load_operand_value_x86(lhs_slot, left_ty, left_hash, op_tok)
        em(0x50)
        emit_load_operand_value_x86(lhs_slot, left_ty, left_hash, op_tok)
        em(0x59)
        emit_f64_mul_from_rcx_rax_x86()
        em(0x50)
        emit_load_operand_variance_x86(rhs_slot, right_hash)
        em(0x59)
        emit_f64_mul_from_rcx_rax_x86()
        em(0x50)

        emit_load_operand_value_x86(rhs_slot, right_ty, right_hash, op_tok)
        em(0x50)
        emit_load_operand_value_x86(rhs_slot, right_ty, right_hash, op_tok)
        em(0x59)
        emit_f64_mul_from_rcx_rax_x86()
        em(0x50)
        emit_load_operand_value_x86(rhs_slot, right_ty, right_hash, op_tok)
        em(0x50)
        emit_load_operand_value_x86(rhs_slot, right_ty, right_hash, op_tok)
        em(0x59)
        emit_f64_mul_from_rcx_rax_x86()
        em(0x59)
        emit_f64_mul_from_rcx_rax_x86()

        em(0x59)
        emit_f64_div_from_rcx_rax_x86()
        em(0x59)
        emit_f64_add_from_rcx_rax_x86()
    }
    emit_store_var(base_slot + 1)

    emit_load_operand_confidence_x86(lhs_slot, left_hash)
    em(0x50)
    emit_load_operand_confidence_x86(rhs_slot, right_hash)
    em(0x59)
    emit_min_positive_f64_bits_x86()
    emit_store_var(base_slot)

    em(0x48); em(0x8d); em(0x85)
    em32(0 - (base_slot + 2) * 8)
    EXPR_IS_F64 = 0
    EXPR_TY = 0
    EXPR_TY_HASH = knowledge_binary_result_hash(op, left_ty, left_hash, right_ty, right_hash)
}

// ─── Built-in function emitters ───

// print_int: rax = value → emit decimal digits + write syscall
fn emit_print_int() with Mut {
    // sub rsp, 32; mov rcx, rsp+31 (end of buffer); mov byte [rcx], 10 (\n); dec rcx
    // div loop: cdq; div 10; add dl, '0'; mov [rcx], dl; dec rcx; test rax,rax; jnz loop
    // lea rsi, [rcx+1]; mov rdx, rsp+32-rsi; write(1, rsi, rdx); add rsp, 32
    em(0x48); em(0x83); em(0xec); em(32)  // sub rsp, 32
    em(0x48); em(0x8d); em(0x4c); em(0x24); em(31)  // lea rcx, [rsp+31]
    em(0xc6); em(0x01); em(10)  // mov byte [rcx], '\n'
    em(0x48); em(0xff); em(0xc9)  // dec rcx
    // Handle negative: if rax < 0, negate, set r8=1
    em(0x4d); em(0x31); em(0xc0)  // xor r8, r8
    em(0x48); em(0x85); em(0xc0)  // test rax, rax
    em(0x79); em(0x06)  // jns +6
    em(0x48); em(0xf7); em(0xd8)  // neg rax
    em(0x49); em(0xff); em(0xc0)  // inc r8
    // div loop
    let loop_top = CL
    em(0x48); em(0x31); em(0xd2)  // xor rdx, rdx
    em(0x48); em(0xc7); em(0xc6); em32(10)  // mov rsi, 10
    em(0x48); em(0xf7); em(0xf6)  // div rsi (rax=quot, rdx=rem)
    em(0x80); em(0xc2); em(48)   // add dl, '0'
    em(0x88); em(0x11)            // mov [rcx], dl
    em(0x48); em(0xff); em(0xc9)  // dec rcx
    em(0x48); em(0x85); em(0xc0)  // test rax, rax
    em(0x0f); em(0x85); em32(loop_top - (CL + 4))  // jnz loop_top
    // If negative, add '-'
    em(0x4d); em(0x85); em(0xc0)  // test r8, r8
    em(0x74); em(0x06)  // jz +6
    em(0xc6); em(0x01); em(45)  // mov byte [rcx], '-'
    em(0x48); em(0xff); em(0xc9)  // dec rcx
    // rcx points to last written byte-1; string starts at rcx+1
    em(0x48); em(0xff); em(0xc1)  // inc rcx (start of string)
    em(0x48); em(0x89); em(0xce)  // mov rsi, rcx (buf)
    em(0x48); em(0x8d); em(0x54); em(0x24); em(32)  // lea rdx, [rsp+32]
    em(0x48); em(0x29); em(0xca)  // sub rdx, rcx (len = end - start)
    em(0xb8); em32(1)  // mov eax, 1 (sys_write)
    em(0xbf); em32(1)  // mov edi, 1 (stdout)
    em(0x0f); em(0x05)  // syscall
    em(0x48); em(0x83); em(0xc4); em(32)  // add rsp, 32
}

fn emit_print_char_lit_x86(ch: i64) with Mut {
    em(0x48); em(0x83); em(0xec); em(8)
    em(0xc6); em(0x04); em(0x24); em(ch)
    em(0xb8); em32(1)
    em(0xbf); em32(1)
    em(0x48); em(0x89); em(0xe6)
    em(0xba); em32(1)
    em(0x0f); em(0x05)
    em(0x48); em(0x83); em(0xc4); em(8)
}

fn emit_print_u64_no_nl_x86() with Mut {
    em(0x48); em(0x83); em(0xec); em(32)  // sub rsp, 32
    em(0x48); em(0x8d); em(0x4c); em(0x24); em(31)  // lea rcx, [rsp+31]
    em(0x48); em(0x85); em(0xc0)  // test rax, rax
    em(0x75); em(0x08)  // jnz div_loop
    em(0xc6); em(0x01); em(48)  // mov byte [rcx], '0'
    em(0x48); em(0xff); em(0xc9)  // dec rcx
    em(0xeb); em(30)  // jmp after_loop
    let pf_loop_top = CL
    em(0x48); em(0x31); em(0xd2)  // xor rdx, rdx
    em(0x48); em(0xc7); em(0xc6); em32(10)  // mov rsi, 10
    em(0x48); em(0xf7); em(0xf6)  // div rsi
    em(0x80); em(0xc2); em(48)   // add dl, '0'
    em(0x88); em(0x11)            // mov [rcx], dl
    em(0x48); em(0xff); em(0xc9)  // dec rcx
    em(0x48); em(0x85); em(0xc0)  // test rax, rax
    em(0x0f); em(0x85); em32(pf_loop_top - (CL + 4))  // jnz loop
    em(0x48); em(0xff); em(0xc1)  // inc rcx
    em(0x48); em(0x89); em(0xce)  // mov rsi, rcx
    em(0x48); em(0x8d); em(0x54); em(0x24); em(32)  // lea rdx, [rsp+32]
    em(0x48); em(0x29); em(0xca)  // sub rdx, rcx
    em(0xb8); em32(1); em(0xbf); em32(1)
    em(0x0f); em(0x05)
    em(0x48); em(0x83); em(0xc4); em(32)
}

fn emit_print_fixed6_x86() with Mut {
    em(0x48); em(0x83); em(0xec); em(8)
    em(0x48); em(0x31); em(0xd2)
    em(0x48); em(0xb9); em64(100000)
    em(0x48); em(0xf7); em(0xf1)
    em(0x48); em(0x83); em(0xc0); em(48)
    em(0x88); em(0x04); em(0x24)
    em(0x48); em(0x89); em(0xd0)
    em(0x48); em(0x31); em(0xd2)
    em(0x48); em(0xb9); em64(10000)
    em(0x48); em(0xf7); em(0xf1)
    em(0x48); em(0x83); em(0xc0); em(48)
    em(0x88); em(0x44); em(0x24); em(1)
    em(0x48); em(0x89); em(0xd0)
    em(0x48); em(0x31); em(0xd2)
    em(0x48); em(0xb9); em64(1000)
    em(0x48); em(0xf7); em(0xf1)
    em(0x48); em(0x83); em(0xc0); em(48)
    em(0x88); em(0x44); em(0x24); em(2)
    em(0x48); em(0x89); em(0xd0)
    em(0x48); em(0x31); em(0xd2)
    em(0x48); em(0xb9); em64(100)
    em(0x48); em(0xf7); em(0xf1)
    em(0x48); em(0x83); em(0xc0); em(48)
    em(0x88); em(0x44); em(0x24); em(3)
    em(0x48); em(0x89); em(0xd0)
    em(0x48); em(0x31); em(0xd2)
    em(0x48); em(0xb9); em64(10)
    em(0x48); em(0xf7); em(0xf1)
    em(0x48); em(0x83); em(0xc0); em(48)
    em(0x88); em(0x44); em(0x24); em(4)
    em(0x48); em(0x83); em(0xc2); em(48)
    em(0x88); em(0x54); em(0x24); em(5)
    em(0xb8); em32(1); em(0xbf); em32(1)
    em(0x48); em(0x89); em(0xe6)
    em(0xba); em32(6)
    em(0x0f); em(0x05)
    em(0x48); em(0x83); em(0xc4); em(8)
}

fn emit_print_nan_x86() with Mut {
    em(0x48); em(0x83); em(0xec); em(8)
    em(0x48); em(0xb8); em64(7233902)
    em(0x48); em(0x89); em(0x04); em(0x24)
    em(0xb8); em32(1)
    em(0xbf); em32(1)
    em(0x48); em(0x89); em(0xe6)
    em(0xba); em32(3)
    em(0x0f); em(0x05)
    em(0x48); em(0x83); em(0xc4); em(8)
}

// print_f64: rax = f64 bits → print decimal with 6 decimal places
fn emit_print_f64() with Mut, Panic {
    em(0x41); em(0x54)  // push r12
    em(0x41); em(0x55)  // push r13
    em(0x41); em(0x56)  // push r14
    em(0x49); em(0x89); em(0xc4)  // mov r12, rax
    em(0x4c); em(0x89); em(0xe0)  // mov rax, r12
    em(0x48); em(0xb9); em64(9223372036854775807)
    em(0x48); em(0x21); em(0xc8)  // and rax, rcx
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84); let zero_patch_a = CL; em32(0)
    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax
    em(0x48); em(0xc1); em(0xe9); em(52)  // shr rcx, 52
    em(0x48); em(0x81); em(0xf9); em32(2047)  // cmp rcx, 2047
    em(0x0f); em(0x84); let nan_patch = CL; em32(0)
    em(0x48); em(0x85); em(0xc9)
    em(0x0f); em(0x84); let zero_patch_b = CL; em32(0)
    em(0x49); em(0x0f); em(0xba); em(0xe4); em(63)  // bt r12, 63
    em(0x0f); em(0x83); let sign_done_patch = CL; em32(0)
    emit_print_char_lit_x86(45)
    patch32(sign_done_patch, CL)
    em(0x49); em(0x0f); em(0xba); em(0xf4); em(63)  // btr r12, 63
    em(0x66); em(0x49); em(0x0f); em(0x6e); em(0xc4)  // movq xmm0, r12
    em(0xf2); em(0x48); em(0x0f); em(0x2c); em(0xc0)  // cvttsd2si rax, xmm0
    em(0x49); em(0x89); em(0xc5)  // mov r13, rax
    em(0x66); em(0x49); em(0x0f); em(0x6e); em(0xc4)  // movq xmm0, r12
    em(0xf2); em(0x49); em(0x0f); em(0x2a); em(0xcd)  // cvtsi2sd xmm1, r13
    em(0xf2); em(0x0f); em(0x5c); em(0xc1)            // subsd xmm0, xmm1
    em(0x48); em(0xb8); em64(4696837146684686336)  // 1000000.0
    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)  // movq xmm1, rax
    em(0xf2); em(0x0f); em(0x59); em(0xc1)            // mulsd xmm0, xmm1
    em(0x48); em(0xb8); em64(4602678819172646912)  // 0.5
    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)  // movq xmm1, rax
    em(0xf2); em(0x0f); em(0x58); em(0xc1)            // addsd xmm0, xmm1
    em(0xf2); em(0x48); em(0x0f); em(0x2c); em(0xc0)  // cvttsd2si rax, xmm0
    em(0x48); em(0x3d); em32(1000000)                 // cmp rax, 1000000
    em(0x0f); em(0x8c); let frac_ok_patch = CL; em32(0)
    em(0x31); em(0xc0)                                // xor eax, eax
    em(0x49); em(0xff); em(0xc5)                      // inc r13
    patch32(frac_ok_patch, CL)
    em(0x49); em(0x89); em(0xc6)  // mov r14, rax
    em(0x4c); em(0x89); em(0xe8)  // mov rax, r13
    emit_print_u64_no_nl_x86()
    emit_print_char_lit_x86(46)
    em(0x4c); em(0x89); em(0xf0)  // mov rax, r14
    emit_print_fixed6_x86()
    em(0xe9); let done_after_norm = CL; em32(0)
    let zero_label = CL
    em(0x31); em(0xc0)
    emit_print_u64_no_nl_x86()
    emit_print_char_lit_x86(46)
    em(0x31); em(0xc0)
    emit_print_fixed6_x86()
    em(0xe9); let done_after_zero = CL; em32(0)
    let nan_label = CL
    emit_print_nan_x86()
    let done_label = CL
    patch32(zero_patch_a, zero_label)
    patch32(zero_patch_b, zero_label)
    patch32(nan_patch, nan_label)
    patch32(done_after_norm, done_label)
    patch32(done_after_zero, done_label)
    em(0x41); em(0x5e)  // pop r14
    em(0x41); em(0x5d)  // pop r13
    em(0x41); em(0x5c)  // pop r12
}

fn emit_read_i64() with Mut {
    em(0x48); em(0x89); em(0xc1)            // mov rcx, rax (index)
    em(0x58)                                // pop rax (buf)
    em(0x48); em(0x8b); em(0x04); em(0xc8)  // mov rax, [rax + rcx*8]
}

fn emit_read_f64() with Mut {
    em(0x48); em(0x89); em(0xc1)            // mov rcx, rax (index)
    em(0x58)                                // pop rax (buf)
    em(0xf2); em(0x0f); em(0x10); em(0x04); em(0xc8)  // movsd xmm0, [rax + rcx*8]
    em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)  // movq rax, xmm0
}

fn emit_write_i64() with Mut {
    // stack = [ptr, index], rax = value
    em(0x48); em(0x89); em(0xc2)             // mov rdx, rax (value)
    em(0x59)                                  // pop rcx (index)
    em(0x58)                                  // pop rax (ptr)
    em(0x48); em(0x89); em(0x14); em(0xc8)   // mov [rax + rcx*8], rdx
}

fn emit_write_f64() with Mut {
    // stack = [ptr, index], rax = f64 value bits
    em(0x48); em(0x89); em(0xc2)             // mov rdx, rax (f64 bits)
    em(0x59)                                  // pop rcx (index)
    em(0x58)                                  // pop rax (ptr)
    em(0x48); em(0x89); em(0x14); em(0xc8)   // mov [rax + rcx*8], rdx
}

fn emit_write_i64_a64() with Mut {
    // stack = [ptr, index], x0 = value
    em32(0xAA0003EA)   // mov x10, x0 (value)
    emit_pop_x1_a64()  // x1 = index
    emit_pop_x0_a64()  // x0 = ptr
    em32(0xF82178AA)   // str x10, [x0, x1, lsl #3]
}

fn emit_write_f64_a64() with Mut {
    // stack = [ptr, index], x0 = f64 value bits
    em32(0xAA0003EA)   // mov x10, x0 (f64 bits)
    emit_pop_x1_a64()  // x1 = index
    emit_pop_x0_a64()  // x0 = ptr
    em32(0xF82178AA)   // str x10, [x0, x1, lsl #3]
}

// arg_count: load argc from the saved stack pointer
// At program entry, [rsp] = argc, [rsp+8] = argv[0], etc.
// We save rsp at entry in a global.
var ENTRY_RSP_OFF: i64 = 0

fn emit_arg_count() with Mut {
    let argc_addr = GL_BSS_BASE - 16   // argc at BSS base (before globals)
    em(0x48); em(0xb8); em64(argc_addr)
    em(0x48); em(0x8b); em(0x00)  // mov rax, [rax]
}

fn emit_get_arg() with Mut {
    // rax = arg index. argv stored at BSS+8. argv[i] = [argv_base + i*8]
    let argv_addr = GL_BSS_BASE - 8    // argv at BSS base + 8
    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (index)
    em(0x48); em(0xb8); em64(argv_addr)
    em(0x48); em(0x8b); em(0x00)  // mov rax, [rax] = argv base
    em(0x48); em(0x8b); em(0x04); em(0xc8)  // mov rax, [rax + rcx*8]
}

fn emit_str_len() with Mut {
    // rax = string ptr; count until null byte
    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (ptr)
    em(0x48); em(0x31); em(0xc0)  // xor rax, rax (count=0)
    let top = CL
    em(0x80); em(0x3c); em(0x01); em(0x00)  // cmp byte [rcx+rax], 0
    em(0x74); em(0x04)  // je done (+4)
    em(0x48); em(0xff); em(0xc0)  // inc rax
    em(0xeb); em(0xf5 as i64 & 0xFF)  // jmp top (relative back)
    // done: rax = length
}

fn emit_print_char_x86() with Mut {
    em(0x48); em(0x83); em(0xec); em(8)
    em(0x88); em(0x04); em(0x24)
    em(0xb8); em32(1)
    em(0xbf); em32(1)
    em(0x48); em(0x89); em(0xe6)
    em(0xba); em32(1)
    em(0x0f); em(0x05)
    em(0x48); em(0x83); em(0xc4); em(8)
}

fn emit_str_eq_regs_x86() with Mut {
    em(0x48); em(0x89); em(0xcf)  // mov rdi, rcx
    em(0x48); em(0x89); em(0xc6)  // mov rsi, rax
    em(0x48); em(0x0f); em(0xb6); em(0x07)  // movzx rax, byte [rdi]
    em(0x3a); em(0x06)                      // cmp al, [rsi]
    em(0x75); em(12)                        // jne not_equal
    em(0x84); em(0xc0)                      // test al, al
    em(0x74); em(13)                        // jz equal
    em(0x48); em(0xff); em(0xc7)            // inc rdi
    em(0x48); em(0xff); em(0xc6)            // inc rsi
    em(0xeb); em(0xec as i64 & 0xFF)        // jmp loop
    em(0x48); em(0x31); em(0xc0)            // not_equal: xor rax, rax
    em(0xeb); em(7)                         // jmp done
    em(0x48); em(0xc7); em(0xc0); em32(1)   // equal: mov rax, 1
}

fn emit_starts_with_regs_x86() with Mut {
    em(0x48); em(0x89); em(0xcf)  // mov rdi, rcx
    em(0x48); em(0x89); em(0xc6)  // mov rsi, rax
    em(0x48); em(0x0f); em(0xb6); em(0x06)  // movzx rax, byte [rsi]
    em(0x84); em(0xc0)                      // test al, al
    em(0x74); em(12)                        // jz match
    em(0x3a); em(0x07)                      // cmp al, [rdi]
    em(0x75); em(17)                        // jne no_match
    em(0x48); em(0xff); em(0xc7)            // inc rdi
    em(0x48); em(0xff); em(0xc6)            // inc rsi
    em(0xeb); em(0xec as i64 & 0xFF)        // jmp loop
    em(0x48); em(0xc7); em(0xc0); em32(1)   // match: mov rax, 1
    em(0xeb); em(3)                         // jmp done
    em(0x48); em(0x31); em(0xc0)            // no_match: xor rax, rax
}

fn emit_mmap_len_in_rax_x86() with Mut {
    em(0x48); em(0x89); em(0xc6)            // mov rsi, rax
    em(0x48); em(0x31); em(0xff)            // xor rdi, rdi
    em(0xba); em32(3)                       // mov edx, 3
    em(0x41); em(0xba); em32(0x22)          // mov r10d, 0x22
    em(0x49); em(0xc7); em(0xc0); em32(-1)  // mov r8, -1
    em(0x4d); em(0x31); em(0xc9)            // xor r9, r9
    em(0xb8); em32(9)                       // mov eax, 9
    em(0x0f); em(0x05)                      // syscall
}

fn emit_heap_alloc_x86() with Mut {
    // rax = requested size. Allocate size+8 via mmap, write header, return user ptr.
    em(0x48); em(0x83); em(0xc0); em(8)     // add rax, 8 (total = size + header)
    em(0x48); em(0x89); em(0xc6)             // mov rsi, rax (mmap size arg)
    em(0x50)                                  // push rax (save total size)
    em(0x48); em(0x31); em(0xff)             // xor rdi, rdi (addr = NULL)
    em(0xba); em32(3)                        // mov edx, 3 (PROT_READ|PROT_WRITE)
    em(0x41); em(0xba); em32(0x22)           // mov r10d, 0x22 (MAP_PRIVATE|MAP_ANON)
    em(0x49); em(0xc7); em(0xc0); em32(-1)  // mov r8, -1 (fd)
    em(0x4d); em(0x31); em(0xc9)             // xor r9, r9 (offset)
    em(0xb8); em32(9)                        // mov eax, 9 (SYS_mmap)
    em(0x0f); em(0x05)                       // syscall → rax = mmap base
    em(0x59)                                  // pop rcx (total size)
    em(0x48); em(0x89); em(0x08)             // mov [rax], rcx (write header)
    em(0x48); em(0x83); em(0xc0); em(8)     // add rax, 8 (return user ptr)
}

fn emit_heap_free_x86() with Mut {
    // rax = user pointer. Read header at [ptr-8], munmap(base, total).
    em(0x48); em(0x83); em(0xe8); em(8)     // sub rax, 8 (back to mmap base)
    em(0x48); em(0x89); em(0xc7)             // mov rdi, rax (munmap addr)
    em(0x48); em(0x8b); em(0x37)             // mov rsi, [rdi] (total size)
    em(0xb8); em32(11)                       // mov eax, 11 (SYS_munmap)
    em(0x0f); em(0x05)                       // syscall
}

fn emit_heap_realloc_x86() with Mut {
    // stack = [old_user_ptr], rax = new_size.
    // mremap(old_base, old_total, new_total, MREMAP_MAYMOVE)
    em(0x48); em(0x83); em(0xc0); em(8)     // add rax, 8 (new_total = new_size + header)
    em(0x48); em(0x89); em(0xc2)             // mov rdx, rax (new_total for mremap arg3)
    em(0x49); em(0x89); em(0xc0)             // mov r8, rax (save new_total)
    em(0x5f)                                  // pop rdi (old_user_ptr)
    em(0x48); em(0x83); em(0xef); em(8)     // sub rdi, 8 (old mmap base)
    em(0x48); em(0x8b); em(0x37)             // mov rsi, [rdi] (old_total)
    em(0x41); em(0xba); em32(1)              // mov r10d, 1 (MREMAP_MAYMOVE)
    em(0xb8); em32(25)                       // mov eax, 25 (SYS_mremap)
    em(0x0f); em(0x05)                       // syscall → rax = new mmap base
    em(0x4c); em(0x89); em(0x00)             // mov [rax], r8 (write new header)
    em(0x48); em(0x83); em(0xc0); em(8)     // add rax, 8 (return user ptr)
}

fn emit_str_concat_slots_x86(slot_a: i64, slot_b: i64) with Mut {
    let slot_len_a = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    let slot_len_b = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    let slot_res = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1

    emit_load_var(slot_a)
    emit_str_len()
    emit_store_var(slot_len_a)

    emit_load_var(slot_b)
    emit_str_len()
    emit_store_var(slot_len_b)

    emit_load_var(slot_len_a)
    emit_push()
    emit_load_var(slot_len_b)
    em(0x59)
    em(0x48); em(0x01); em(0xc8)            // add rax, rcx
    em(0x48); em(0x83); em(0xc0); em(1)     // add rax, 1
    emit_mmap_len_in_rax_x86()
    emit_store_var(slot_res)

    em(0xfc)                                // cld
    emit_load_var(slot_len_a)
    em(0x48); em(0x89); em(0xc1)            // mov rcx, rax
    emit_load_var(slot_a)
    em(0x48); em(0x89); em(0xc6)            // mov rsi, rax
    emit_load_var(slot_res)
    em(0x48); em(0x89); em(0xc7)            // mov rdi, rax
    em(0xf3); em(0xa4)                      // rep movsb

    emit_load_var(slot_len_b)
    em(0x48); em(0x89); em(0xc1)            // mov rcx, rax
    emit_load_var(slot_b)
    em(0x48); em(0x89); em(0xc6)            // mov rsi, rax
    em(0xf3); em(0xa4)                      // rep movsb

    em(0xc6); em(0x07); em(0x00)            // mov byte [rdi], 0
    emit_load_var(slot_res)
}

fn emit_str_slice_range_slots_x86(slot_s: i64, slot_start: i64, slot_end: i64) with Mut {
    let slot_len = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    let slot_res = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1

    emit_load_var(slot_end)
    emit_push()
    emit_load_var(slot_start)
    em(0x59)
    em(0x48); em(0x29); em(0xc1)            // sub rcx, rax
    em(0x48); em(0x89); em(0xc8)            // mov rax, rcx
    emit_store_var(slot_len)

    emit_load_var(slot_len)
    em(0x48); em(0x83); em(0xc0); em(1)     // add rax, 1
    emit_mmap_len_in_rax_x86()
    emit_store_var(slot_res)

    em(0xfc)                                // cld
    emit_load_var(slot_len)
    em(0x48); em(0x89); em(0xc1)            // mov rcx, rax
    emit_load_var(slot_s)
    em(0x48); em(0x89); em(0xc2)            // mov rdx, rax
    emit_load_var(slot_start)
    em(0x48); em(0x01); em(0xd0)            // add rax, rdx
    em(0x48); em(0x89); em(0xc6)            // mov rsi, rax
    emit_load_var(slot_res)
    em(0x48); em(0x89); em(0xc7)            // mov rdi, rax
    em(0xf3); em(0xa4)                      // rep movsb
    em(0xc6); em(0x07); em(0x00)            // mov byte [rdi], 0
    emit_load_var(slot_res)
}

fn emit_read_file() with Mut {
    // Simpler: rax=path. open → save fd → mmap → read → close → return buf
    em(0x48); em(0x89); em(0xc7)  // mov rdi, rax
    em(0x48); em(0x31); em(0xf6)  // xor rsi, rsi
    em(0xb8); em32(2); em(0x0f); em(0x05)  // open → fd in rax
    em(0x50)  // push fd
    // mmap(NULL, 16MB+1, 3, 0x22, -1, 0)
    em(0x48); em(0x31); em(0xff)  // rdi=0
    em(0xbe); em32(0x1000001)  // esi=16MB+1
    em(0xba); em32(3)  // edx=PROT_RW
    em(0x41); em(0xba); em32(0x22)  // r10d=MAP_PRIVATE|MAP_ANON
    em(0x49); em(0xc7); em(0xc0); em32(-1)  // r8=-1
    em(0x4d); em(0x31); em(0xc9)  // r9=0
    em(0xb8); em32(9); em(0x0f); em(0x05)  // mmap → buf in rax
    em(0x50)  // push buf; stack=[fd, buf]
    // read(fd, buf, 16MB)
    em(0x48); em(0x89); em(0xc6)  // mov rsi, rax (buf)
    em(0x48); em(0x8b); em(0x7c); em(0x24); em(0x08)  // mov rdi, [rsp+8] (fd)
    em(0xba); em32(0x1000000)  // edx=16MB
    em(0xb8); em32(0); em(0x0f); em(0x05)  // read
    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (bytes read)
    em(0x48); em(0x85); em(0xc9)  // test rcx, rcx
    em(0x79); em(0x02)  // jns read_ok
    em(0x31); em(0xc9)  // xor ecx, ecx
    em(0x48); em(0x8b); em(0x04); em(0x24)  // mov rax, [rsp] (buf)
    em(0xc6); em(0x04); em(0x08); em(0x00)  // mov byte [rax + rcx], 0
    // close(fd)
    em(0x48); em(0x8b); em(0x7c); em(0x24); em(0x08)  // mov rdi, [rsp+8] (fd)
    em(0xb8); em32(3); em(0x0f); em(0x05)  // close
    // return buf
    em(0x58)  // pop rax (buf)
    em(0x48); em(0x83); em(0xc4); em(0x08)  // add rsp, 8 (discard fd)
}

fn emit_file_size() with Mut, Panic {
    // rax = path. stat(path, &statbuf) → statbuf.st_size at offset 48
    em(0x48); em(0x89); em(0xc7)  // mov rdi, rax (path)
    em(0x48); em(0x81); em(0xec); em32(160)  // sub rsp, 160 (struct stat + padding)
    em(0x48); em(0x89); em(0xe6)  // mov rsi, rsp (statbuf)
    em(0xb8); em32(4)  // mov eax, 4 (sys_stat)
    em(0x0f); em(0x05)
    em(0x48); em(0x85); em(0xc0)  // test rax, rax
    em(0x0f); em(0x88); let stat_fail = CL; em32(0)  // js stat_fail
    em(0x48); em(0x8b); em(0x44); em(0x24); em(48)  // mov rax, [rsp+48] (st_size)
    em(0xe9); let stat_done = CL; em32(0)
    let stat_fail_target = CL
    em(0x31); em(0xc0)  // xor eax, eax
    let stat_done_target = CL
    patch32(stat_fail, stat_fail_target)
    patch32(stat_done, stat_done_target)
    em(0x48); em(0x81); em(0xc4); em32(160)  // add rsp, 160
}

// Gen 19: read_line() — read one line from stdin (fd=0) into a fresh mmap buffer.
// Strips trailing newline. Returns null-terminated string pointer.
fn emit_read_line_x86() with Mut {
    // mmap(NULL, 4096, PROT_RW, MAP_PRIVATE|MAP_ANON, -1, 0)
    em(0x48); em(0x31); em(0xff)              // xor rdi, rdi
    em(0xbe); em32(4096)                      // mov esi, 4096
    em(0xba); em32(3)                         // mov edx, PROT_READ|PROT_WRITE
    em(0x41); em(0xba); em32(0x22)            // mov r10d, MAP_PRIVATE|MAP_ANON
    em(0x49); em(0xc7); em(0xc0); em32(-1)   // mov r8, -1
    em(0x4d); em(0x31); em(0xc9)              // xor r9, r9
    em(0xb8); em32(9); em(0x0f); em(0x05)    // mmap → buf in rax
    em(0x50)                                  // push buf
    // read(0, buf, 4095)
    em(0x48); em(0x89); em(0xc6)              // mov rsi, rax (buf)
    em(0x48); em(0x31); em(0xff)              // xor rdi, rdi (fd=0 stdin)
    em(0xba); em32(4095)                      // mov edx, 4095 (leave room for \0)
    em(0x48); em(0x31); em(0xc0)              // xor rax, rax (sys_read=0)
    em(0x0f); em(0x05)                        // syscall → bytes_read in rax
    // If bytes_read <= 0, rax stays negative/zero — still null-terminate
    em(0x48); em(0x85); em(0xc0)              // test rax, rax
    em(0x7e); em(0x08)                        // jle read_done (skip newline strip)
    // Strip trailing '\n' (10) if present
    em(0x48); em(0x8b); em(0x0c); em(0x24)   // mov rcx, [rsp] (buf)
    em(0x48); em(0x0f); em(0xbe); em(0x4c); em(0x01); em(0xff) // movsx rcx, byte[rcx+rax-1]
    em(0x48); em(0x83); em(0xf9); em(0x0a)   // cmp rcx, 10  ('\n')
    em(0x75); em(0x02)                        // jne read_done
    em(0x48); em(0xff); em(0xc8)              // dec rax
    // read_done: null-terminate buf[rax]
    em(0x48); em(0x8b); em(0x0c); em(0x24)   // mov rcx, [rsp] (buf)
    em(0xc6); em(0x04); em(0x01); em(0x00)   // mov byte[rcx+rax], 0
    em(0x58)                                  // pop rax (return buf)
}

fn emit_syscall6_x86(argc: i64) with Mut {
    if argc >= 1 {
        em(0x48); em(0x8b); em(0x84); em(0x24); em32((argc - 1) * 8)  // mov rax, [rsp+num]
    }
    if argc >= 2 { emit_load_rsp_arg_x86(0, (argc - 2) * 8) }  // rdi = a1
    if argc >= 3 { emit_load_rsp_arg_x86(1, (argc - 3) * 8) }  // rsi = a2
    if argc >= 4 { emit_load_rsp_arg_x86(2, (argc - 4) * 8) }  // rdx = a3
    if argc >= 5 { em(0x4c); em(0x8b); em(0x94); em(0x24); em32((argc - 5) * 8) }  // mov r10, [rsp+a4]
    if argc >= 6 { emit_load_rsp_arg_x86(4, (argc - 6) * 8) }  // r8 = a5
    if argc >= 7 { emit_load_rsp_arg_x86(5, (argc - 7) * 8) }  // r9 = a6
    em(0x0f); em(0x05)
    emit_drop_call_args_x86(argc)
}

fn emit_write_file_flags(open_flags: i64) with Mut, Panic {
    // rdi = path, rsi = buf addr, rdx = len
    em(0x52)  // push rdx (len)
    em(0x56)  // push rsi (buf)
    em(0xbe); em32(open_flags)
    em(0xba); em32(0x1A4)  // mov edx, 0644
    em(0xb8); em32(2)  // mov eax, 2 (sys_open)
    em(0x0f); em(0x05)  // → fd in rax
    em(0x48); em(0x85); em(0xc0)  // test rax, rax
    em(0x0f); em(0x89); let open_ok = CL; em32(0)  // jns open_ok
    em(0x48); em(0x83); em(0xc4); em(0x10)  // add rsp, 16
    em(0xe9); let done = CL; em32(0)
    let open_ok_target = CL
    em(0x49); em(0x89); em(0xc0)  // mov r8, rax (fd)
    em(0x5e)  // pop rsi (buf)
    em(0x5a)  // pop rdx (len)
    em(0x4c); em(0x89); em(0xc7)  // mov rdi, r8
    em(0xb8); em32(1)  // mov eax, 1 (sys_write)
    em(0x0f); em(0x05)
    em(0x49); em(0x89); em(0xc1)  // mov r9, rax (write result)
    // close(fd)
    em(0x4c); em(0x89); em(0xc7)  // mov rdi, r8
    em(0xb8); em32(3)  // mov eax, 3 (sys_close)
    em(0x0f); em(0x05)
    em(0x4c); em(0x89); em(0xc8)  // mov rax, r9
    let done_target = CL
    patch32(open_ok, open_ok_target)
    patch32(done, done_target)
}

fn emit_write_file() with Mut, Panic {
    emit_write_file_flags(0x241)
}

fn emit_append_file() with Mut, Panic {
    emit_write_file_flags(0x441)
}

// ─── Expression compiler (recursive descent) ───
// Global parse position for expression parsing
var EP: i64 = 0
var EXPR_IS_F64: i64 = 0
var EXPR_TY: i64 = 0
var EXPR_TY_HASH: i64 = 0
var LAST_ALEN: i64 = 0
var LAST_STMT_TY: i64 = 0
var LAST_STMT_TY_HASH: i64 = 0
var CURRENT_RET_TY: i64 = 0
var CURRENT_RET_HASH: i64 = 0
var CURRENT_SRET_SLOT: i64 = 0
// Closure state save buffers (global to avoid stack overflow in recursive compile_primary)
var CL_SAVE_NS: [i64; 1024] = [0; 1024]
var CL_SAVE_NE: [i64; 1024] = [0; 1024]
var CL_SAVE_SL: [i64; 1024] = [0; 1024]
var CL_SAVE_LS: [i64; 1024] = [0; 1024]
var CL_SAVE_AL: [i64; 1024] = [0; 1024]
var CL_SAVE_ES: [i64; 1024] = [0; 1024]
var CL_SAVE_F64: [i64; 1024] = [0; 1024]
var CL_SAVE_ISCL: [i64; 1024] = [0; 1024]
var CL_SAVE_MUT: [i64; 1024] = [0; 1024]
var CL_SAVE_UNIT: [i64; 1024] = [0; 1024]
var CL_SAVE_LINEAR: [i64; 1024] = [0; 1024]
var CL_SAVE_USED: [i64; 1024] = [0; 1024]
var CL_SAVE_TY: [i64; 1024] = [0; 1024]
var CL_SAVE_TH: [i64; 1024] = [0; 1024]
// Capture tracking for closures
var CL_CAP_SLOT: [i64; 1024] = [0; 1024]
var CL_CAP_COUNT: i64 = 0
// Loop stack for continue/break (max 16 nested loops)
var LOOP_TOP: [i64; 16] = [0; 16]
var LOOP_END_PATCH: [i64; 16] = [0; 16]
var LOOP_DEPTH: i64 = 0
// Break fixup table: code offsets of jmp rel32 placeholders
var BREAK_PATCH: [i64; 64] = [0; 64]
var BREAK_COUNT: i64 = 0
// Track if last struct literal was a linear/affine type
var LAST_EXPR_IS_LINEAR: i64 = 0
var LAST_EXPR_IS_AFFINE: i64 = 0
// Track VAR index of last struct identifier loaded (-1 if not applicable)
var LAST_EXPR_VAR_IDX: i64 = -1
// Scratch local-slot ids for string builtins inside large expression compilers.
var BUILTIN_SLOT_A: i64 = 0
var BUILTIN_SLOT_B: i64 = 0
var BUILTIN_SLOT_C: i64 = 0

fn compile_measure_call_x86(call_tok: i64) with IO, Mut, Panic, Div {
    EP = EP + 1
    var value_ty: i64 = 0
    var value_hash: i64 = 0
    var value_tok: i64 = -1
    var unc_ty: i64 = 0
    var unc_tok: i64 = -1
    var conf_ty: i64 = 0
    var value_slot: i64 = -1
    var unc_slot: i64 = -1
    var conf_slot: i64 = -1
    var argc: i64 = 0
    var saw_unc: i64 = 0
    var saw_conf: i64 = 0
    if TK[EP as usize] != 7 && TK[EP as usize] != 0 {
        let arg_start = EP
        compile_or()
        value_ty = EXPR_TY
        value_hash = EXPR_TY_HASH
        value_tok = expr_simple_numeric_tok(arg_start, EP)
        value_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        emit_store_var(value_slot)
        argc = 1
    }
    while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
        if TK[EP as usize] == 28 { EP = EP + 1 }
        if TK[EP as usize] == 7 || TK[EP as usize] == 0 { break }
        var label_kind: i64 = 0
        if TK[EP as usize] == 3 && TK[(EP + 1) as usize] == 43 {
            let lns = TS[EP as usize]
            let lne = TE[EP as usize]
            if src_match(lns, lne - lns, "uncertainty") { label_kind = 1 }
            else if src_match(lns, lne - lns, "confidence") { label_kind = 2 }
            else { tc_error(call_tok, "unknown measure metadata label") }
            EP = EP + 2
        }
        let arg_start = EP
        compile_or()
        let arg_ty = EXPR_TY
        let lit_tok = expr_simple_numeric_tok(arg_start, EP)
        let tmp_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        emit_store_var(tmp_slot)
        argc = argc + 1
        if label_kind == 2 || (label_kind == 0 && saw_unc != 0 && saw_conf == 0) {
            if saw_conf != 0 { tc_error(call_tok, "duplicate measure confidence") }
            conf_slot = tmp_slot
            conf_ty = arg_ty
            saw_conf = 1
        } else {
            if saw_unc != 0 { tc_error(call_tok, "duplicate measure uncertainty") }
            unc_slot = tmp_slot
            unc_ty = arg_ty
            unc_tok = lit_tok
            saw_unc = 1
        }
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }
    if argc <= 0 { tc_wrong_arity(call_tok, 2, 0) }
    let eps_scaled = infer_measure_eps_scaled(value_tok, unc_tok)
    let base_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 3
    if value_slot >= 0 { emit_load_var(value_slot) } else { em(0x31); em(0xc0) }
    emit_store_var(base_slot + 2)
    if unc_slot >= 0 {
        emit_load_var(unc_slot)
        if unc_ty != 2 {
            if ty_is_numeric(unc_ty) {
                em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xc0)
                em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
            } else {
                tc_error(call_tok, "measure uncertainty must be numeric")
                em(0x31); em(0xc0)
            }
        }
        em(0x48); em(0x89); em(0xc1)
        em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc0)
        em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc9)
        em(0xf2); em(0x0f); em(0x59); em(0xc1)
        em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
    } else {
        emit_imm64(0)
    }
    emit_store_var(base_slot + 1)
    if conf_slot >= 0 {
        emit_load_var(conf_slot)
        if conf_ty != 2 {
            if ty_is_numeric(conf_ty) {
                em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xc0)
                em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
            } else {
                tc_error(call_tok, "measure confidence must be numeric")
                emit_imm64(4607182418800017408)
            }
        }
    } else {
        emit_imm64(4607182418800017408)
    }
    emit_store_var(base_slot)
    em(0x48); em(0x8d); em(0x85)
    em32(0 - (base_slot + 2) * 8)
    EXPR_IS_F64 = 0
    EXPR_TY = 0
    EXPR_TY_HASH = knowledge_hash_make(value_ty, value_hash, eps_scaled)
}

fn compile_acknowledge_call_x86(call_tok: i64) with IO, Mut, Panic, Div {
    // acknowledge(k: Knowledge<T>, reason: String) -> T
    // Does NOT require `with Epistemic` — explicit uncertainty acknowledgment
    EP = EP + 1  // skip (
    if TK[EP as usize] == 7 || TK[EP as usize] == 0 {
        tc_arity_error(call_tok, "arity mismatch: acknowledge() requires 2 arguments")
        if TK[EP as usize] == 7 { EP = EP + 1 }
        EXPR_TY = 0
        EXPR_TY_HASH = 0
        EXPR_IS_F64 = 0
        return
    }
    // Compile first arg: the Knowledge<T> value
    compile_or()
    let ack_k_ty = EXPR_TY
    let ack_k_hash = EXPR_TY_HASH
    // Expect comma + reason arg
    if TK[EP as usize] == 28 {
        EP = EP + 1
    } else {
        tc_arity_error(call_tok, "arity mismatch: acknowledge() requires 2 arguments")
    }
    // Skip reason arg (not compiled — documentation only)
    if TK[EP as usize] != 7 && TK[EP as usize] != 0 {
        EP = skip_call_arg_expr(EP)
    }
    // Check for extra args
    if TK[EP as usize] == 28 {
        tc_error(call_tok, "acknowledge() takes exactly 2 arguments")
        while TK[EP as usize] != 7 && TK[EP as usize] != 0 { EP = EP + 1 }
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }
    // Extract .value at offset 0: mov rax, [rax]
    em(0x48); em(0x8b); em(0x00)
    // Set result type to inner type
    if knowledge_hash_is(ack_k_hash) {
        let ack_inner_hash = knowledge_hash_inner_hash(ack_k_hash)
        EXPR_TY = knowledge_hash_inner_ty(ack_k_hash)
        EXPR_TY_HASH = ack_inner_hash
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
    } else if ack_k_ty == 6 {
        let ack_si = st_find(ack_k_hash)
        if ack_si >= 0 {
            EXPR_TY = ST_FTY[(ack_si * 128) as usize]
            EXPR_TY_HASH = ST_FHASH[(ack_si * 128) as usize]
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
        }
    }
}

fn compile_require_confidence_call_x86(call_tok: i64) with IO, Mut, Panic, Div {
    // require_confidence(k: Knowledge<T>, min: f64) -> T
    // Extracts .value if confidence >= min, panics (exit 1) otherwise
    EP = EP + 1  // skip (
    if TK[EP as usize] == 7 || TK[EP as usize] == 0 {
        tc_arity_error(call_tok, "arity mismatch: require_confidence() requires 2 arguments")
        if TK[EP as usize] == 7 { EP = EP + 1 }
        EXPR_TY = 0
        EXPR_TY_HASH = 0
        EXPR_IS_F64 = 0
        return
    }
    // Compile first arg: Knowledge<T> value → rax = struct ptr
    compile_or()
    let rc_k_ty = EXPR_TY
    let rc_k_hash = EXPR_TY_HASH
    let rc_k_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var(rc_k_slot)
    // Expect comma + threshold
    if TK[EP as usize] == 28 {
        EP = EP + 1
    } else {
        tc_arity_error(call_tok, "arity mismatch: require_confidence() requires 2 arguments")
    }
    // Compile second arg: threshold f64
    compile_or()
    let rc_min_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var(rc_min_slot)
    // Check for extra args
    if TK[EP as usize] == 28 {
        tc_error(call_tok, "require_confidence() takes exactly 2 arguments")
        while TK[EP as usize] != 7 && TK[EP as usize] != 0 { EP = EP + 1 }
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }
    // Load confidence field: [k_ptr + 16]
    emit_load_var(rc_k_slot)
    em(0x48); em(0x8b); em(0x40); em(16)  // mov rax, [rax + 16] — confidence f64 bits
    em(0x48); em(0x89); em(0xc1)           // mov rcx, rax (save confidence)
    emit_load_var(rc_min_slot)              // rax = threshold f64 bits
    // Compare: ucomisd xmm0 (confidence), xmm1 (threshold)
    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1)  // movq xmm0, rcx (confidence)
    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)  // movq xmm1, rax (threshold)
    em(0x66); em(0x0f); em(0x2e); em(0xc1)             // ucomisd xmm0, xmm1
    // jae +N (skip panic if confidence >= threshold)
    em(0x73)  // jae rel8
    let rc_ok_patch = CL
    em(0x00)  // placeholder
    emit_assert_fail()  // exit(1) — does not return
    CD[rc_ok_patch as usize] = (CL - rc_ok_patch - 1) as i8
    // Extract .value at offset 0
    emit_load_var(rc_k_slot)
    em(0x48); em(0x8b); em(0x00)  // mov rax, [rax + 0] — .value
    // Set result type to inner type
    if knowledge_hash_is(rc_k_hash) {
        let rc_inner_hash = knowledge_hash_inner_hash(rc_k_hash)
        EXPR_TY = knowledge_hash_inner_ty(rc_k_hash)
        EXPR_TY_HASH = rc_inner_hash
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
    } else if rc_k_ty == 6 {
        let rc_si = st_find(rc_k_hash)
        if rc_si >= 0 {
            EXPR_TY = ST_FTY[(rc_si * 128) as usize]
            EXPR_TY_HASH = ST_FHASH[(rc_si * 128) as usize]
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
        }
    }
}

fn compile_knowledge_literal_x86() with IO, Mut, Panic, Div {
    EP = EP + 1
    let base_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 3
    var value_ty: i64 = 0
    var value_hash: i64 = 0
    var saw_value: i64 = 0
    var saw_var: i64 = 0
    var saw_conf: i64 = 0
    var lit_mode: i64 = 0
    var lit_eps: i64 = -1
    while TK[EP as usize] != 9 && TK[EP as usize] != 0 {
        if TK[EP as usize] == 3 {
            let field_tok = EP
            let fns = TS[EP as usize]
            let fne = TE[EP as usize]
            EP = EP + 1
            if TK[EP as usize] == 43 { EP = EP + 1 }
            let field_start = EP
            compile_or()
            let field_ty = EXPR_TY
            let field_hash = EXPR_TY_HASH
            let lit_tok = expr_simple_numeric_tok(field_start, EP)
            if src_match(fns, fne - fns, "value") {
                emit_store_var(base_slot + 2)
                value_ty = field_ty
                value_hash = field_hash
                saw_value = 1
            } else if src_match(fns, fne - fns, "variance") {
                if field_ty != 2 {
                    if ty_is_numeric(field_ty) {
                        emit_i64_to_f64_in_rax_x86()
                    } else {
                        tc_error(field_tok, "Knowledge variance must be numeric")
                        em(0x31); em(0xc0)
                    }
                }
                emit_store_var(base_slot + 1)
                saw_var = 1
            } else if src_match(fns, fne - fns, "uncertainty") {
                if field_ty != 2 {
                    if ty_is_numeric(field_ty) {
                        emit_i64_to_f64_in_rax_x86()
                    } else {
                        tc_error(field_tok, "Knowledge uncertainty must be numeric")
                        em(0x31); em(0xc0)
                    }
                }
                em(0x48); em(0x89); em(0xc1)
                em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc0)
                em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc9)
                em(0xf2); em(0x0f); em(0x59); em(0xc1)
                em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
                emit_store_var(base_slot + 1)
                saw_var = 1
            } else if src_match(fns, fne - fns, "confidence") || src_match(fns, fne - fns, "epsilon") {
                if field_ty != 2 {
                    if ty_is_numeric(field_ty) {
                        emit_i64_to_f64_in_rax_x86()
                    } else {
                        tc_error(field_tok, "Knowledge epsilon must be numeric")
                        em(0x31); em(0xc0)
                    }
                }
                emit_store_var(base_slot)
                saw_conf = 1
                if lit_tok >= 0 {
                    let scaled = tok_scaled_million(lit_tok)
                    if scaled >= 0 && scaled <= 1000000 {
                        lit_mode = 1
                        lit_eps = scaled
                    }
                }
            } else if src_match(fns, fne - fns, "validity") || src_match(fns, fne - fns, "provenance") {
            } else {
                tc_error(field_tok, "unknown field in Knowledge literal")
            }
        }
        if TK[EP as usize] == 28 { EP = EP + 1 }
    }
    if TK[EP as usize] == 9 { EP = EP + 1 }
    if saw_value == 0 {
        em(0x31); em(0xc0)
        emit_store_var(base_slot + 2)
        value_ty = 0
        value_hash = 0
    }
    if saw_var == 0 {
        em(0x31); em(0xc0)
        emit_store_var(base_slot + 1)
    }
    if saw_conf == 0 {
        emit_imm64(4607182418800017408)
        emit_store_var(base_slot)
    }
    em(0x48); em(0x8d); em(0x85)
    em32(0 - (base_slot + 2) * 8)
    EXPR_IS_F64 = 0
    EXPR_TY = 0
    EXPR_TY_HASH = knowledge_hash_make_mode(value_ty, value_hash, lit_mode, lit_eps)
    LAST_EXPR_IS_LINEAR = 0
    LAST_EXPR_IS_AFFINE = 0
}

// Precedence (low→high): || < && < comparison < bitwise OR < bitwise AND < shift < additive < multiplicative < unary < postfix < primary

fn compile_borrow_primary_x86() with IO, Mut, Panic, Div {
    EP = EP + 1
    var want_mut: i64 = 0
    if TK[EP as usize] == 32 {
        want_mut = 1
        EP = EP + 1
    }
    let borrow_tok = EP - 1
    let rns = TS[EP as usize]
    let rne = TE[EP as usize]
    EP = EP + 1
    if TK[EP as usize] == 41 {
        EP = EP + 1
        let start_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        compile_or()
        emit_store_var(start_slot)
        if TK[EP as usize] == 64 { tc_error(borrow_tok, "slice borrows require half-open ranges") }
        if TK[EP as usize] == 63 || TK[EP as usize] == 64 {
            EP = EP + 1
        } else {
            tc_error(borrow_tok, "slice borrow requires a..b range")
        }
        let end_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        compile_or()
        emit_store_var(end_slot)
        if TK[EP as usize] == 42 { EP = EP + 1 }
        else { tc_error(borrow_tok, "slice borrow missing closing ]") }
        let lvi = var_find_idx(rns, rne)
        var base_ptr_slot: i64 = 0
        var base_len_slot: i64 = 0
        var base_len_const: i64 = 0
        var has_const_len: i64 = 0
        var elem_ty: i64 = 1
        var esiz: i64 = 8
        var ok_base: i64 = 0
        var allow_mut: i64 = 0
        if lvi >= 0 {
            let lty = VAR_TY[lvi as usize]
            let lhash = VAR_TY_HASH[lvi as usize]
            base_ptr_slot = VAR_SLOT[lvi as usize]
            if type_is_slice_ref(lty, lhash) {
                let inner_hash = ref_hash_inner_hash(lhash)
                base_len_slot = VAR_LEN_SLOT[lvi as usize]
                esiz = arr_hash_esiz(inner_hash)
                if arr_hash_elem_ty(inner_hash) != 0 { elem_ty = arr_hash_elem_ty(inner_hash) }
                ok_base = 1
                if want_mut == 0 || ref_hash_mut(lhash) != 0 { allow_mut = 1 }
            } else if lty == 8 {
                base_len_const = VAR_ALEN[lvi as usize]
                has_const_len = 1
                esiz = VAR_ESIZ[lvi as usize]
                if arr_hash_elem_ty(lhash) != 0 { elem_ty = arr_hash_elem_ty(lhash) }
                ok_base = 1
                if want_mut == 0 || VAR_MUT[lvi as usize] != 0 { allow_mut = 1 }
            } else if type_is_array_ref(lty, lhash) {
                let inner_hash = ref_hash_inner_hash(lhash)
                base_len_const = arr_hash_alen(inner_hash)
                has_const_len = 1
                esiz = arr_hash_esiz(inner_hash)
                if arr_hash_elem_ty(inner_hash) != 0 { elem_ty = arr_hash_elem_ty(inner_hash) }
                ok_base = 1
                if want_mut == 0 || ref_hash_mut(lhash) != 0 { allow_mut = 1 }
            }
        } else {
            let gi = gl_find(rns, rne)
            if gi >= 0 && GL_TY[gi as usize] == 8 {
                base_len_const = GL[(gi * 4 + 3) as usize]
                has_const_len = 1
                esiz = GL[(gi * 4 + 2) as usize]
                if arr_hash_elem_ty(GL_TY_HASH[gi as usize]) != 0 { elem_ty = arr_hash_elem_ty(GL_TY_HASH[gi as usize]) }
                ok_base = 1
                allow_mut = 1
            }
        }
        if ok_base == 0 {
            tc_error(borrow_tok, "slice borrow requires array or slice base")
            em(0x31); em(0xc0)
            EXPR_IS_F64 = 0
            EXPR_TY = 10
            EXPR_TY_HASH = ref_hash_make(8, arr_ty_hash(0, 8, 1), want_mut)
            return
        }
        if want_mut != 0 && allow_mut == 0 {
            tc_error(borrow_tok, "Mut borrow requires mutable slice source")
        }
        emit_load_var(end_slot)
        em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (end)
        emit_load_var(start_slot)
        em(0x48); em(0x39); em(0xc8)  // cmp rax, rcx
        em(0x0f); em(0x86); let slice_range_ok_a = CL; em32(0)
        emit_assert_fail()
        patch32(slice_range_ok_a, CL)
        if has_const_len != 0 { emit_imm64(base_len_const) }
        else { emit_load_var(base_len_slot) }
        em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
        em(0x0f); em(0x86); let slice_range_ok_b = CL; em32(0)
        emit_assert_fail()
        patch32(slice_range_ok_b, CL)
        let len_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        let ptr_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        if lvi >= 0 {
            emit_load_var(base_ptr_slot)
        } else {
            let gi = gl_find(rns, rne)
            if gi >= 0 { emit_imm64(GL_BSS_BASE + GL[(gi * 4 + 1) as usize]) }
            else { em(0x31); em(0xc0) }
        }
        em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (base ptr)
        emit_load_var(start_slot)
        if esiz == 8 {
            em(0x48); em(0xc1); em(0xe0); em(3)  // shl rax, 3
        }
        em(0x48); em(0x01); em(0xd0)  // add rax, rdx
        emit_store_var(ptr_slot)
        emit_load_var(end_slot)
        em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (end)
        emit_load_var(start_slot)
        em(0x48); em(0x29); em(0xc1)  // sub rcx, rax
        em(0x48); em(0x89); em(0xc8)  // mov rax, rcx
        emit_store_var(len_slot)
        emit_lea_var(ptr_slot)
        EXPR_IS_F64 = 0
        EXPR_TY = 10
        EXPR_TY_HASH = ref_hash_make(8, arr_ty_hash(0, esiz, elem_ty), want_mut)
        return
    }
    let slot = var_find(rns, rne)
    if slot >= 0 {
        if want_mut != 0 && var_find_is_mut(rns, rne) == 0 {
            tc_error(borrow_tok, "Mut borrow requires mutable binding")
        }
        let lalen = var_find_alen(rns, rne)
        let lty = var_find_ty(rns, rne)
        if lalen > 0 || lty == 6 || lty == 8 {
            emit_load_var(slot)
        } else {
            let off = 0 - slot * 8
            em(0x48); em(0x8d); em(0x85)
            em32(off)
        }
    } else {
        let gi = gl_find(rns, rne)
        if gi >= 0 {
            let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
            em(0x48); em(0xb8); em64(addr)
        } else { tc_undefined_var(EP - 1); em(0x31); em(0xc0) }
    }
    EXPR_IS_F64 = 0
    EXPR_TY = 10
    let bvi = var_find_idx(rns, rne)
    if bvi >= 0 {
        // Reborrow-through-reference: if the target variable is itself a reference (ty=10),
        // e.g. `result: &!IEResult` parameter, then `&!result` or `&result` is a reborrow.
        // The exclusivity is already guaranteed by the existing reference — do not apply
        // borrow conflict checks or tracking (disjoint field reborrows are always safe).
        let bvi_is_ref = VAR_TY[bvi as usize] == 10
        // Borrow conflict detection: exclusive borrows conflict with any other borrow.
        if bvi_is_ref == false {
        if want_mut != 0 {
            if VAR_BORROW_COUNT[bvi as usize] > 0 {
                tc_linear_violation(borrow_tok, "cannot borrow as mutable because it is also borrowed as shared")
            }
            if VAR_BORROW_EXCL[bvi as usize] > 0 {
                tc_linear_violation(borrow_tok, "Cannot borrow as mutable: exclusive borrow already active")
            }
            VAR_BORROW_EXCL[bvi as usize] = VAR_BORROW_EXCL[bvi as usize] + 1
            // Track call-site exclusive borrows for release after the call
            if IN_CALL_ARGS != 0 && CALL_ARG_BORROW_N < 32 {
                CALL_ARG_BORROW_VI[CALL_ARG_BORROW_N as usize] = bvi
                CALL_ARG_BORROW_EXCL[CALL_ARG_BORROW_N as usize] = 1
                CALL_ARG_BORROW_N = CALL_ARG_BORROW_N + 1
            }
        } else {
            if VAR_BORROW_EXCL[bvi as usize] > 0 {
                tc_linear_violation(borrow_tok, "cannot borrow as shared because it is also borrowed as mutable")
            }
            VAR_BORROW_COUNT[bvi as usize] = VAR_BORROW_COUNT[bvi as usize] + 1
            // Track call-site shared borrows for release after the call
            if IN_CALL_ARGS != 0 && CALL_ARG_BORROW_N < 32 {
                CALL_ARG_BORROW_VI[CALL_ARG_BORROW_N as usize] = bvi
                CALL_ARG_BORROW_EXCL[CALL_ARG_BORROW_N as usize] = 0
                CALL_ARG_BORROW_N = CALL_ARG_BORROW_N + 1
            }
        }
        }
        // Navigate dot-chain in &var.field1.field2 before wrapping in reference type
        EXPR_TY = VAR_TY[bvi as usize]
        EXPR_TY_HASH = VAR_TY_HASH[bvi as usize]
        if TK[EP as usize] == 50 { compile_postfix_tail() }
        let inner_ty = EXPR_TY
        let inner_hash = EXPR_TY_HASH
        EXPR_IS_F64 = 0
        EXPR_TY = 10
        if want_mut != 0 { EXPR_TY_HASH = ref_hash_make(inner_ty, inner_hash, 1) }
        else { EXPR_TY_HASH = ref_hash_make(inner_ty, inner_hash, 0) }
    } else {
        let rgi = gl_find(rns, rne)
        if rgi >= 0 {
            EXPR_TY = GL_TY[rgi as usize]
            EXPR_TY_HASH = GL_TY_HASH[rgi as usize]
            if TK[EP as usize] == 50 { compile_postfix_tail() }
            let inner_ty2 = EXPR_TY
            let inner_hash2 = EXPR_TY_HASH
            EXPR_IS_F64 = 0
            EXPR_TY = 10
            if want_mut != 0 { EXPR_TY_HASH = ref_hash_make(inner_ty2, inner_hash2, 1) }
            else { EXPR_TY_HASH = ref_hash_make(inner_ty2, inner_hash2, 0) }
        }
        else {
            if want_mut != 0 { EXPR_TY_HASH = ref_hash_make(0, 0, 1) }
            else { EXPR_TY_HASH = ref_hash_make(0, 0, 0) }
        }
    }
}

fn compile_primary() with IO, Mut, Panic, Div {
    LAST_EXPR_IS_CLOSURE = 0
    LAST_EXPR_IS_LINEAR = 0
    LAST_EXPR_IS_AFFINE = 0
    LAST_EXPR_VAR_IDX = -1
    EXPR_TY = 0
    EXPR_TY_HASH = 0
    EXPR_UNIT = 0
    LAST_IS_LITERAL = 0
    let k = TK[EP as usize]
    // Integer literal
    if k == 4 {
        let v = TV[EP as usize]
        // Gen 19: _suffix unit annotation (e.g. 500_mg)
        let lit_uh = TU[EP as usize]
        if v == 0 { em(0x31); em(0xc0) }
        else { em(0x48); em(0xb8); em64(v) }
        EP = EP + 1
        EXPR_IS_F64 = 0
        EXPR_TY = 1
        LAST_IS_LITERAL = 1
        LAST_LITERAL_VAL = v
        if lit_uh != 0 { EXPR_UNIT = lit_uh; EXPR_UNIT_DIM = unit_lookup_dim(lit_uh) }
        return
    }
    // true=35, false=36
    if k == 35 { em(0x48); em(0xb8); em64(1); EP = EP + 1; EXPR_IS_F64 = 0; EXPR_TY = 4; return }
    if k == 36 { em(0x31); em(0xc0); EP = EP + 1; EXPR_IS_F64 = 0; EXPR_TY = 4; return }
    // Float literal (53): runtime conversion via SSE2
    if k == 53 {
        let fl_int = TV[EP as usize]
        let fl_frac = TF[EP as usize]
        let fl_denom = TD[EP as usize]
        // Gen 19: _suffix unit annotation (e.g. 9.8_m)
        let flit_uh = TU[EP as usize]
        // Store exponent info in globals to avoid extra locals shifting compile_primary's frame
        if TX[EP as usize] >= 0 { FL_SCI_SCRATCH = TX[EP as usize]; FL_SCI_NEG = 0 }
        else { FL_SCI_SCRATCH = 0 - TX[EP as usize]; FL_SCI_NEG = 1 }
        EP = EP + 1
        // mov rax, int_part; cvtsi2sd xmm0, rax
        em(0x48); em(0xb8); em64(fl_int)
        em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xc0)
        // If fractional part: frac/denom added to xmm0
        if fl_frac > 0 {
            em(0x48); em(0xb8); em64(fl_frac)
            em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xc8)  // cvtsi2sd xmm1, rax
            em(0x48); em(0xb8); em64(fl_denom)
            em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xd0)  // cvtsi2sd xmm2, rax
            em(0xf2); em(0x0f); em(0x5e); em(0xca)            // divsd xmm1, xmm2
            em(0xf2); em(0x0f); em(0x58); em(0xc1)            // addsd xmm0, xmm1
        }
        // Apply scientific exponent: multiply or divide xmm0 by 10.0 FL_SCI_SCRATCH times
        if FL_SCI_SCRATCH != 0 {
            // Load 10.0 into xmm1: movabs rax, 0x4024000000000000; movq xmm1, rax
            em(0x48); em(0xb8); em64(0x4024000000000000)
            em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)
            if FL_SCI_NEG == 0 {
                while FL_SCI_SCRATCH > 0 {
                    em(0xf2); em(0x0f); em(0x59); em(0xc1)  // mulsd xmm0, xmm1
                    FL_SCI_SCRATCH = FL_SCI_SCRATCH - 1
                }
            } else {
                while FL_SCI_SCRATCH > 0 {
                    em(0xf2); em(0x0f); em(0x5e); em(0xc1)  // divsd xmm0, xmm1
                    FL_SCI_SCRATCH = FL_SCI_SCRATCH - 1
                }
            }
        }
        // movq rax, xmm0 — store f64 bits in rax
        em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
        EXPR_IS_F64 = 1
        EXPR_TY = 2
        if flit_uh != 0 { EXPR_UNIT = flit_uh; EXPR_UNIT_DIM = unit_lookup_dim(flit_uh) }
        return
    }
    if k == 48 {
        let match_tok = EP
        compile_stmt()
        if LAST_STMT_HAS_VALUE == 0 { tc_error(match_tok, "match expression must yield a value") }
        EXPR_TY = LAST_STMT_TY
        EXPR_TY_HASH = LAST_STMT_TY_HASH
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 }
        else { EXPR_IS_F64 = 0 }
        return
    }
    if k == 13 {
        let if_tok = EP
        compile_stmt()
        if LAST_STMT_HAS_VALUE == 0 { tc_error(if_tok, "if expression must yield a value") }
        EXPR_TY = LAST_STMT_TY
        EXPR_TY_HASH = LAST_STMT_TY_HASH
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 }
        else { EXPR_IS_F64 = 0 }
        return
    }
    if k == 41 {
        if array_init_is_repeat(EP) {
            EP = EP + 1
            let expr_start = EP
            compile_or()
            let elem_ty = EXPR_TY
            let elem_hash = EXPR_TY_HASH
            if TK[EP as usize] == 27 { EP = EP + 1 }
            let rep_count = TV[EP as usize]
            EP = EP + 1
            if TK[EP as usize] == 42 { EP = EP + 1 }
            let arr_hash = arr_ty_hash(rep_count, 8, elem_ty)
            if elem_ty == 6 {
                // Struct element: each element occupies struct_nslots qwords
                let s_nslots = struct_like_nslots(elem_hash)
                let total_slots = rep_count * s_nslots
                if total_slots > 0 {
                    let base = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + total_slots
                    let end_ep = EP
                    // First element already compiled, RAX = struct ptr
                    em(0x48); em(0x89); em(0xc2)  // mov rdx, rax
                    var j: i64 = 0
                    while j < s_nslots {
                        em(0x48); em(0x8b); em(0x82); em32(j * 8)  // mov rax, [rdx + j*8]
                        emit_store_var(base + total_slots - 1 - j)
                        j = j + 1
                    }
                    // Remaining elements: re-compile expression for each
                    var ri: i64 = 1
                    while ri < rep_count {
                        EP = expr_start
                        compile_or()
                        em(0x48); em(0x89); em(0xc2)  // mov rdx, rax
                        j = 0
                        while j < s_nslots {
                            em(0x48); em(0x8b); em(0x82); em32(j * 8)  // mov rax, [rdx + j*8]
                            emit_store_var(base + total_slots - 1 - ri * s_nslots - j)
                            j = j + 1
                        }
                        ri = ri + 1
                    }
                    EP = end_ep
                    em(0x48); em(0x8d); em(0x85)  // lea rax, [rbp + disp32]
                    em32(0 - (base + total_slots - 1) * 8)
                } else {
                    em(0x31); em(0xc0)
                }
            } else {
                // Scalar element: rep stosq fills all slots with RAX
                let nslots = arr_storage_slots(arr_hash)
                if nslots > 0 {
                    let base = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + nslots
                    em(0x48); em(0x8d); em(0xbd)
                    em32(0 - (base + nslots - 1) * 8)
                    em(0xb9); em32(nslots)
                    em(0xf3); em(0x48); em(0xab)
                    em(0x48); em(0x8d); em(0x85)
                    em32(0 - (base + nslots - 1) * 8)
                } else {
                    em(0x31); em(0xc0)
                }
            }
            EXPR_IS_F64 = 0
            EXPR_TY = 8
            EXPR_TY_HASH = arr_hash
            LAST_ALEN = rep_count
            return
        }
        let arr_count = array_lit_count(EP)
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + arr_count
        EP = EP + 1
        var idx: i64 = 0
        var elem_ty: i64 = 0
        var elem_hash: i64 = 0
        while TK[EP as usize] != 42 && TK[EP as usize] != 0 {
            compile_or()
            if idx == 0 {
                elem_ty = EXPR_TY
                elem_hash = EXPR_TY_HASH
            } else {
                if ty_eq(elem_ty, elem_hash, EXPR_TY, EXPR_TY_HASH) == false {
                    tc_error(EP - 1, "array literal elements must have the same type")
                }
            }
            emit_store_var(base + arr_count - 1 - idx)
            idx = idx + 1
            if TK[EP as usize] == 28 { EP = EP + 1 }
        }
        if TK[EP as usize] == 42 { EP = EP + 1 }
        em(0x48); em(0x8d); em(0x85)
        em32(0 - (base + arr_count - 1) * 8)
        EXPR_IS_F64 = 0
        EXPR_TY = 8
        EXPR_TY_HASH = arr_ty_hash(arr_count, 8, elem_ty)
        LAST_ALEN = arr_count
        return
    }
    // Closure: |params| expr  or  |params| { stmts }
    // Token 45 = | at expression start = closure (not bitwise OR)
    // Supports captured variables from outer scope via closure struct.
    // All closures build a stack struct: [fn_ptr, cap_0, cap_1, ...]
    // Closure function receives hidden first param (env_ptr) in rdi.
    // User args shift to rsi, rdx, rcx, r8, r9 (max 5 user args).
    if k == 45 || k == 31 {
        var zero_param_closure: i64 = 0
        if k == 31 { zero_param_closure = 1 }
        EP = EP + 1  // skip opening | or ||
        // Save outer function state
        let save_vc = VAR_COUNT
        let save_ns2 = NEXT_SLOT
        let save_ld = LOOP_DEPTH
        let save_bc = BREAK_COUNT
        let save_ret_ty = CURRENT_RET_TY
        let save_ret_hash = CURRENT_RET_HASH
        let save_sret_slot = CURRENT_SRET_SLOT
        let save_fpc = FRAME_PATCH_COUNT
        // Do NOT reset FRAME_PATCH_COUNT to 0: closure patches append after outer patches,
        // preserving the outer function's sub-rsp patch location at [0..save_fpc).
        var svi: i64 = 0
        while svi < save_vc {
            CL_SAVE_NS[svi as usize] = VAR_NS[svi as usize]
            CL_SAVE_NE[svi as usize] = VAR_NE[svi as usize]
            CL_SAVE_SL[svi as usize] = VAR_SLOT[svi as usize]
            CL_SAVE_LS[svi as usize] = VAR_LEN_SLOT[svi as usize]
            CL_SAVE_AL[svi as usize] = VAR_ALEN[svi as usize]
            CL_SAVE_ES[svi as usize] = VAR_ESIZ[svi as usize]
            CL_SAVE_F64[svi as usize] = VAR_IS_F64[svi as usize]
            CL_SAVE_ISCL[svi as usize] = VAR_IS_CLOSURE[svi as usize]
            CL_SAVE_MUT[svi as usize] = VAR_MUT[svi as usize]
            CL_SAVE_UNIT[svi as usize] = VAR_UNIT[svi as usize]
            CL_SAVE_LINEAR[svi as usize] = VAR_LINEAR[svi as usize]
            CL_SAVE_USED[svi as usize] = VAR_USED[svi as usize]
            CL_SAVE_TY[svi as usize] = VAR_TY[svi as usize]
            CL_SAVE_TH[svi as usize] = VAR_TY_HASH[svi as usize]
            svi = svi + 1
        }
        // Reset state for closure body
        VAR_COUNT = 0
        NEXT_SLOT = 2  // slot 1 reserved for env_ptr (hidden rdi param)
        LOOP_DEPTH = 0
        BREAK_COUNT = 0
        CL_CAP_COUNT = 0
        CURRENT_SRET_SLOT = 0
        // Parse closure parameters (between | ... |)
        // User params get slots 2, 3, ... (registers rsi, rdx, rcx, r8, r9)
        if zero_param_closure == 0 {
            while TK[EP as usize] != 45 && TK[EP as usize] != 0 {
                if TK[EP as usize] == 3 {
                    let pns = TS[EP as usize]
                    let pne = TE[EP as usize]
                    let pslot = var_add(pns, pne)
                    EP = EP + 1
                    if TK[EP as usize] == 43 {
                        EP = EP + 1
                        scan_type(EP)
                        if pslot >= 0 {
                            VAR_TY[(VAR_COUNT - 1) as usize] = SCAN_TY
                            VAR_TY_HASH[(VAR_COUNT - 1) as usize] = SCAN_TY_HASH
                            if SCAN_TY == 2 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 1 }
                            if SCAN_TY == 8 {
                                VAR_ALEN[(VAR_COUNT - 1) as usize] = SCAN_TY_ALEN
                                VAR_ESIZ[(VAR_COUNT - 1) as usize] = SCAN_TY_ESIZ
                            }
                        }
                        EP = SCAN_TY_NEXT
                    } else {
                        // No type annotation: default to f64. Scientific code is the
                        // dominant use case; untyped closure params silently producing
                        // zeros for f64 inputs was a real footgun before this default.
                        if pslot >= 0 {
                            VAR_TY[(VAR_COUNT - 1) as usize] = 2
                            VAR_IS_F64[(VAR_COUNT - 1) as usize] = 1
                        }
                    }
                }
                if TK[EP as usize] == 28 { EP = EP + 1 }
            }
            if TK[EP as usize] == 45 { EP = EP + 1 }  // skip closing |
        }
        if TK[EP as usize] == 10 {
            EP = EP + 1
            scan_type(EP)
            CURRENT_RET_TY = SCAN_TY
            CURRENT_RET_HASH = SCAN_TY_HASH
            EP = SCAN_TY_NEXT
        } else {
            CURRENT_RET_TY = 0
            CURRENT_RET_HASH = 0
        }
        if TK[EP as usize] == 38 {
            EP = EP + 1
            // Gen 17 D2: skip effect list — handles Epistemic(N) parameterized effects
            while TK[EP as usize] == 3 || TK[EP as usize] == 28 {
                if TK[EP as usize] == 3 {
                    EP = EP + 1
                    // skip optional (N) argument (e.g. Epistemic(970))
                    if TK[EP as usize] == 6 {
                        EP = EP + 1
                        while TK[EP as usize] != 7 && TK[EP as usize] != 0 { EP = EP + 1 }
                        if TK[EP as usize] == 7 { EP = EP + 1 }
                    }
                } else {
                    EP = EP + 1
                }
            }
        }
        let nparams = VAR_COUNT  // user params only
        // Register outer-scope vars as captures (those not shadowed by params)
        var ci: i64 = 0
        while ci < save_vc {
            let ons = CL_SAVE_NS[ci as usize]
            let one = CL_SAVE_NE[ci as usize]
            let outer_slot = CL_SAVE_SL[ci as usize]
            let existing = var_find(ons, one)
            if existing < 0 {
                let cap_slot = var_add(ons, one)
                if cap_slot >= 0 {
                    let cap_vi = VAR_COUNT - 1
                    VAR_LEN_SLOT[cap_vi as usize] = CL_SAVE_LS[ci as usize]
                    VAR_ALEN[cap_vi as usize] = CL_SAVE_AL[ci as usize]
                    VAR_ESIZ[cap_vi as usize] = CL_SAVE_ES[ci as usize]
                    VAR_IS_F64[cap_vi as usize] = CL_SAVE_F64[ci as usize]
                    VAR_IS_CLOSURE[cap_vi as usize] = CL_SAVE_ISCL[ci as usize]
                    VAR_MUT[cap_vi as usize] = CL_SAVE_MUT[ci as usize]
                    VAR_UNIT[cap_vi as usize] = CL_SAVE_UNIT[ci as usize]
                    VAR_LINEAR[cap_vi as usize] = CL_SAVE_LINEAR[ci as usize]
                    VAR_USED[cap_vi as usize] = CL_SAVE_USED[ci as usize]
                    VAR_TY[cap_vi as usize] = CL_SAVE_TY[ci as usize]
                    VAR_TY_HASH[cap_vi as usize] = CL_SAVE_TH[ci as usize]
                    if CL_CAP_COUNT < local_cap() {
                        CL_CAP_SLOT[CL_CAP_COUNT as usize] = outer_slot
                        CL_CAP_COUNT = CL_CAP_COUNT + 1
                    } else {
                        note_limit_error(1)
                    }
                }
            }
            ci = ci + 1
        }
        // Emit jmp over closure body
        em(0xe9)
        let jmp_patch = CL
        em32(0)
        // Emit closure function body
        let cl_start = CL
        // Prologue: push rbp; mov rbp, rsp; sub rsp, <dynamic frame>
        em(0x55); em(0x48); em(0x89); em(0xe5)
        em(0x48); em(0x81); em(0xec); record_frame_patch(); em32(0)
        // Spill env_ptr (rdi) to slot 1: mov [rbp-8], rdi
        em(0x48); em(0x89); em(0x7d); em(0xf8 as i64 & 0xFF)
        // Spill user params from shifted registers (rsi=slot2, rdx=slot3, ...)
        if nparams >= 1 { em(0x48); em(0x89); em(0x75); em(0xf0 as i64 & 0xFF) }
        if nparams >= 2 { em(0x48); em(0x89); em(0x55); em(0xe8 as i64 & 0xFF) }
        if nparams >= 3 { em(0x48); em(0x89); em(0x4d); em(0xe0 as i64 & 0xFF) }
        if nparams >= 4 { em(0x4c); em(0x89); em(0x45); em(0xd8 as i64 & 0xFF) }
        if nparams >= 5 { em(0x4c); em(0x89); em(0x4d); em(0xd0 as i64 & 0xFF) }
        var stack_param_idx: i64 = 6
        while stack_param_idx <= nparams {
            em(0x48); em(0x8b); em(0x85); em32(16 + (stack_param_idx - 6) * 8)
            emit_store_var(1 + stack_param_idx)
            stack_param_idx = stack_param_idx + 1
        }
        // Load captured vars from env struct into local slots
        // env struct layout: [fn_ptr, cap_0, cap_1, ...] at ascending addresses
        // env_ptr points to fn_ptr; cap_i is at [env_ptr + (i+1)*8]
        var capi: i64 = 0
        while capi < CL_CAP_COUNT {
            emit_load_var(1)  // rax = env_ptr
            let cap_off = (capi + 1) * 8
            em(0x48); em(0x8b); em(0x80); em32(cap_off)  // mov rax, [rax + cap_off]
            emit_store_var(2 + nparams + capi)  // store in capture's local slot
            capi = capi + 1
        }
        // Compile body
        if TK[EP as usize] == 8 {
            EP = EP + 1
            while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
            if TK[EP as usize] == 9 { EP = EP + 1 }
        } else {
            compile_or()
        }
        // Epilogue
        if CL > 0 && CD[(CL - 1) as usize] != 0xc3 as i8 {
            em(0x48); em(0x81); em(0xc4); record_frame_patch(); em32(0)
            em(0x5d); em(0xc3)
        }
        // Patch closure sub rsp / add rsp with actual frame size.
        // Closure's patches start at save_fpc (appended after outer patches).
        let cl_frame_sz = (NEXT_SLOT * 8 + 15) & 0xFFFFFFF0
        if cl_frame_sz > max_frame_bytes() { tc_stack_frame_too_large(cl_frame_sz) }
        var cl_fpi: i64 = save_fpc
        while cl_fpi < FRAME_PATCH_COUNT { em32_at(FRAME_PATCH_OFF[cl_fpi as usize], cl_frame_sz); cl_fpi = cl_fpi + 1 }
        // Patch jmp over closure body
        patch32(jmp_patch, CL)
        // Save capture count before restoring outer state
        let saved_cap_count = CL_CAP_COUNT
        // Restore outer function state
        VAR_COUNT = save_vc
        NEXT_SLOT = save_ns2
        LOOP_DEPTH = save_ld
        BREAK_COUNT = save_bc
        CURRENT_RET_TY = save_ret_ty
        CURRENT_RET_HASH = save_ret_hash
        CURRENT_SRET_SLOT = save_sret_slot
        FRAME_PATCH_COUNT = save_fpc
        svi = 0
        while svi < save_vc {
            VAR_NS[svi as usize] = CL_SAVE_NS[svi as usize]
            VAR_NE[svi as usize] = CL_SAVE_NE[svi as usize]
            VAR_SLOT[svi as usize] = CL_SAVE_SL[svi as usize]
            VAR_LEN_SLOT[svi as usize] = CL_SAVE_LS[svi as usize]
            VAR_ALEN[svi as usize] = CL_SAVE_AL[svi as usize]
            VAR_ESIZ[svi as usize] = CL_SAVE_ES[svi as usize]
            VAR_IS_F64[svi as usize] = CL_SAVE_F64[svi as usize]
            VAR_IS_CLOSURE[svi as usize] = CL_SAVE_ISCL[svi as usize]
            VAR_MUT[svi as usize] = CL_SAVE_MUT[svi as usize]
            VAR_UNIT[svi as usize] = CL_SAVE_UNIT[svi as usize]
            VAR_LINEAR[svi as usize] = CL_SAVE_LINEAR[svi as usize]
            VAR_USED[svi as usize] = CL_SAVE_USED[svi as usize]
            VAR_TY[svi as usize] = CL_SAVE_TY[svi as usize]
            VAR_TY_HASH[svi as usize] = CL_SAVE_TH[svi as usize]
            svi = svi + 1
        }
        // --- Build closure struct on OUTER stack ---
        // Stack layout: slot N is at [rbp - N*8]. Higher slot = lower address.
        // We want a contiguous struct at ascending addresses:
        //   ptr[0] = fn_ptr, ptr[8] = cap_0, ptr[16] = cap_1, ...
        // Since ptr + 8 = higher address = lower slot number:
        //   fn_ptr  at slot (struct_base + struct_size - 1)  ← lowest address = ptr[0]
        //   cap_0   at slot (struct_base + struct_size - 2)  ← ptr[8]
        //   cap_i   at slot (struct_base + struct_size - 2 - i)
        // ptr = [rbp - (struct_base + struct_size - 1) * 8]
        let struct_size = 1 + saved_cap_count
        let struct_base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + struct_size
        let struct_top = struct_base + struct_size - 1
        // Store fn_ptr at slot struct_top (ptr[0])
        em(0x48); em(0x8d); em(0x05)
        em32(cl_start - (CL + 4))  // lea rax, [rip + offset_to_cl_start]
        emit_store_var(struct_top)
        // Store captures: cap_i at slot (struct_top - 1 - i) → ptr[(i+1)*8]
        var capj: i64 = 0
        while capj < saved_cap_count {
            emit_load_var(CL_CAP_SLOT[capj as usize])
            emit_store_var(struct_top - 1 - capj)
            capj = capj + 1
        }
        // lea rax, [rbp - struct_top*8] — pointer to closure struct
        em(0x48); em(0x8d); em(0x85)
        em32(0 - struct_top * 8)
        EXPR_IS_F64 = 0
        EXPR_TY = 9
        LAST_EXPR_IS_CLOSURE = 1
        return
    }
    // None → 2-qword tagged union [tag=0, value=0]
    if k == 58 {
        EP = EP + 1
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 2
        em(0x48); em(0x31); em(0xc0)  // xor rax, rax
        emit_store_var(base)      // value = 0
        emit_store_var(base + 1)  // tag = 0
        em(0x48); em(0x8d); em(0x85)  // lea rax, [rbp - (base+1)*8]
        em32(0 - (base + 1) * 8)
        EXPR_IS_F64 = 0
        EXPR_TY = 11
        EXPR_TY_HASH = 0
        return
    }
    // Some(expr) → 2-qword tagged union [tag=1, value=expr]
    if k == 57 {
        EP = EP + 1
        if TK[EP as usize] == 6 { EP = EP + 1 }
        compile_or()
        if TK[EP as usize] == 7 { EP = EP + 1 }
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 2
        emit_store_var(base)      // value at slot base
        emit_imm64(1)
        emit_store_var(base + 1)  // tag = 1 at slot base+1
        em(0x48); em(0x8d); em(0x85)  // lea rax, [rbp - (base+1)*8]
        em32(0 - (base + 1) * 8)
        EXPR_IS_F64 = 0
        EXPR_TY = 11
        EXPR_TY_HASH = 0
        return
    }
    // Ok(expr) → 2-qword tagged union [tag=0, payload=expr]
    if k == 59 {
        EP = EP + 1
        if TK[EP as usize] == 6 { EP = EP + 1 }
        compile_or()
        if TK[EP as usize] == 7 { EP = EP + 1 }
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 2
        emit_store_var(base)      // payload
        em(0x48); em(0x31); em(0xc0)  // xor rax, rax → tag = 0
        emit_store_var(base + 1)
        em(0x48); em(0x8d); em(0x85)
        em32(0 - (base + 1) * 8)
        EXPR_IS_F64 = 0
        EXPR_TY = 11
        EXPR_TY_HASH = 0
        return
    }
    // Err(expr) → 2-qword tagged union [tag=1, payload=expr]
    if k == 60 {
        EP = EP + 1
        if TK[EP as usize] == 6 { EP = EP + 1 }
        compile_or()
        if TK[EP as usize] == 7 { EP = EP + 1 }
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 2
        emit_store_var(base)
        emit_imm64(1)  // tag = 1
        emit_store_var(base + 1)
        em(0x48); em(0x8d); em(0x85)
        em32(0 - (base + 1) * 8)
        EXPR_IS_F64 = 0
        EXPR_TY = 11
        EXPR_TY_HASH = 0
        return
    }
    // Parenthesized expression or tuple literal
    if k == 6 {
        EP = EP + 1
        compile_or()
        if TK[EP as usize] == 28 {
            // Tuple literal: (expr1, expr2, ...)
            // First element already compiled (rax = value or pointer).
            // Layout requirement: .0 at lowest address (highest slot), .1 above.
            // Problem: we don't know total_slots until all elements are compiled.
            // Strategy:
            //   1. Save first element's rax to a temp slot.
            //   2. Compile remaining elements (last element stays in rax).
            //   3. Allocate tuple buffer now that total_slots is known.
            //   4. Store last element to low slots (dst_start = tup_base + last_nslots - 1).
            //   5. Restore first element rax; store to high slots (dst_start = tup_base + total - 1).
            //   6. LEA = rbp - (tup_base + total - 1)*8 → pointer to first element.
            let first_ty = EXPR_TY
            let first_hash = EXPR_TY_HASH
            let first_nslots = ty_slot_count(first_ty, first_hash)
            // Save first element's rax before second-element compilation clobbers it
            let first_save = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var(first_save)
            var tup_count: i64 = 1
            // Compile remaining elements; track the last one's type info
            var last_ty: i64 = 0
            var last_hash: i64 = 0
            var last_nslots: i64 = 0
            while TK[EP as usize] == 28 {
                EP = EP + 1  // skip ,
                if TK[EP as usize] == 7 { break }  // trailing comma
                compile_or()
                last_ty = EXPR_TY
                last_hash = EXPR_TY_HASH
                last_nslots = ty_slot_count(last_ty, last_hash)
                tup_count = tup_count + 1
            }
            if TK[EP as usize] == 7 { EP = EP + 1 }  // skip )
            // Allocate the tuple buffer (all sizes now known)
            let total_slots = first_nslots + last_nslots
            let tup_base = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + total_slots
            // Store last element (rax) to low slots: dst_start = tup_base + last_nslots - 1
            if last_nslots > 1 {
                copy_agg_into_struct_slots_x86(tup_base + last_nslots - 1, last_ty, last_hash)
            } else {
                emit_store_var(tup_base + last_nslots - 1)
            }
            // Restore first element's rax from temp slot
            em(0x48); em(0x8b); em(0x85); em32(0 - first_save * 8)
            // Store first element to high slots: dst_start = tup_base + total_slots - 1
            if first_nslots > 1 {
                copy_agg_into_struct_slots_x86(tup_base + total_slots - 1, first_ty, first_hash)
            } else {
                emit_store_var(tup_base + total_slots - 1)
            }
            // Return pointer to first element (lowest address = highest slot)
            em(0x48); em(0x8d); em(0x85)
            em32(0 - (tup_base + total_slots - 1) * 8)
            EXPR_IS_F64 = 0
            EXPR_TY = 6
            // Encode first_nslots, total_slots, and per-element f64-ness.
            // Format: tcount*100M + first_f64*10M + last_f64*1M + first_nslots*1000 + total_nslots
            let first_actual = if first_nslots > 1 { first_nslots } else { 1 }
            var first_f64_flag: i64 = 0
            if first_ty == 2 { first_f64_flag = 1 }
            var last_f64_flag: i64 = 0
            if last_ty == 2 { last_f64_flag = 1 }
            EXPR_TY_HASH = tup_count * 100000000 + first_f64_flag * 10000000 + last_f64_flag * 1000000 + first_actual * 1000 + total_slots
            tup_cache_register(EXPR_TY_HASH, first_ty, first_hash, last_ty, last_hash)
            return
        }
        if TK[EP as usize] == 7 { EP = EP + 1 }
        return
    }
    if k == 44 { compile_borrow_primary_x86(); return }
    // Dereference: *expr → compile expr, then load from pointer
    if k == 19 {
        EP = EP + 1
        compile_primary()
        compile_postfix_tail()
        if EXPR_TY != 0 && EXPR_TY != 10 && EXPR_TY != 11 { tc_error(EP - 1, "dereference requires reference operand") }
        if EXPR_TY == 10 || EXPR_TY == 11 {
            let deref_ref_hash = EXPR_TY_HASH
            let deref_inner_hash = ptr_hash_inner_hash(deref_ref_hash)
            let deref_inner_ty = ptr_hash_inner_ty(deref_ref_hash)
            if type_is_aggregate(deref_inner_ty, deref_inner_hash) == false {
                em(0x48); em(0x8b); em(0x00)  // mov rax, [rax] — scalar dereference
            }
            EXPR_TY = deref_inner_ty
            EXPR_TY_HASH = deref_inner_hash
        } else {
            em(0x48); em(0x8b); em(0x00)  // mov rax, [rax]
            EXPR_TY = 0
            EXPR_TY_HASH = 0
        }
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
        return
    }
    // Unary minus
    if k == 18 {
        let op_tok = EP
        EP = EP + 1
        compile_primary()
        compile_postfix_tail()
        if EXPR_TY != 0 && ty_is_numeric(EXPR_TY) == false { tc_error(op_tok, "unary - requires numeric operand") }
        // EXPR_IS_F64 kept from inner expression (unary minus preserves type)
        if EXPR_IS_F64 == 1 {
            // f64 negate: flip sign bit (bit 63)
