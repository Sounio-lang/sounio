                        if right_ha_56 >= 0 { emit_load_var(right_ha_56) } else { emit_imm64(0) }; em(0x59)
                        if op == 17 { emit_f64_add_from_rcx_rax_x86() } else { emit_f64_sub_from_rcx_rax_x86() }
                        emit_store_var(b4ha56_res); EXPR_HSHADOW_56 = b4ha56_res
                    }
                    if left_ha_57 >= 0 || right_ha_57 >= 0 {
                        let b4ha57_res = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
                        if left_ha_57 >= 0 { emit_load_var(left_ha_57) } else { emit_imm64(0) }; em(0x50)
                        if right_ha_57 >= 0 { emit_load_var(right_ha_57) } else { emit_imm64(0) }; em(0x59)
                        if op == 17 { emit_f64_add_from_rcx_rax_x86() } else { emit_f64_sub_from_rcx_rax_x86() }
                        emit_store_var(b4ha57_res); EXPR_HSHADOW_57 = b4ha57_res
                    }
                    if left_ha_66 >= 0 || right_ha_66 >= 0 {
                        let b4ha66_res = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
                        if left_ha_66 >= 0 { emit_load_var(left_ha_66) } else { emit_imm64(0) }; em(0x50)
                        if right_ha_66 >= 0 { emit_load_var(right_ha_66) } else { emit_imm64(0) }; em(0x59)
                        if op == 17 { emit_f64_add_from_rcx_rax_x86() } else { emit_f64_sub_from_rcx_rax_x86() }
                        emit_store_var(b4ha66_res); EXPR_HSHADOW_66 = b4ha66_res
                    }
                    if left_ha_67 >= 0 || right_ha_67 >= 0 {
                        let b4ha67_res = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
                        if left_ha_67 >= 0 { emit_load_var(left_ha_67) } else { emit_imm64(0) }; em(0x50)
                        if right_ha_67 >= 0 { emit_load_var(right_ha_67) } else { emit_imm64(0) }; em(0x59)
                        if op == 17 { emit_f64_add_from_rcx_rax_x86() } else { emit_f64_sub_from_rcx_rax_x86() }
                        emit_store_var(b4ha67_res); EXPR_HSHADOW_67 = b4ha67_res
                    }
                    if left_ha_77 >= 0 || right_ha_77 >= 0 {
                        let b4ha77_res = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
                        if left_ha_77 >= 0 { emit_load_var(left_ha_77) } else { emit_imm64(0) }; em(0x50)
                        if right_ha_77 >= 0 { emit_load_var(right_ha_77) } else { emit_imm64(0) }; em(0x59)
                        if op == 17 { emit_f64_add_from_rcx_rax_x86() } else { emit_f64_sub_from_rcx_rax_x86() }
                        emit_store_var(b4ha77_res); EXPR_HSHADOW_77 = b4ha77_res
                    }
                    if b4_result_slot_a >= 0 { emit_load_var(b4_result_slot_a) }
                } else {
                    if op == 17 { em(0x48); em(0x01); em(0xc8) }  // add rax, rcx (commutative: rcx+rax = ok)
                    if op == 18 { em(0x48); em(0x87); em(0xc1); em(0x48); em(0x29); em(0xc8) }  // xchg; sub rax, rcx
                    // PR-8: constant fold if both operands are known literals; otherwise clear
                    if left_is_literal == 1 && LAST_IS_LITERAL == 1 {
                        if op == 17 { LAST_LITERAL_VAL = left_literal_val + LAST_LITERAL_VAL }
                        if op == 18 { LAST_LITERAL_VAL = left_literal_val - LAST_LITERAL_VAL }
                    } else { LAST_IS_LITERAL = 0 }
                    EXPR_TY = 1
                    EXPR_VSHADOW = -1
                    EXPR_SSHADOW = -1
                    EXPR_SSHADOW_1 = -1; EXPR_SSHADOW_2 = -1; EXPR_SSHADOW_3 = -1; EXPR_SSHADOW_4 = -1; EXPR_SSHADOW_5 = -1; EXPR_SSHADOW_6 = -1; EXPR_SSHADOW_7 = -1
                    EXPR_HSHADOW_00 = -1; EXPR_HSHADOW_01 = -1; EXPR_HSHADOW_02 = -1; EXPR_HSHADOW_03 = -1
                    EXPR_HSHADOW_11 = -1; EXPR_HSHADOW_12 = -1; EXPR_HSHADOW_13 = -1
                    EXPR_HSHADOW_22 = -1; EXPR_HSHADOW_23 = -1; EXPR_HSHADOW_33 = -1
    EXPR_HSHADOW_04 = -1; EXPR_HSHADOW_05 = -1; EXPR_HSHADOW_06 = -1; EXPR_HSHADOW_07 = -1
    EXPR_HSHADOW_14 = -1; EXPR_HSHADOW_15 = -1; EXPR_HSHADOW_16 = -1; EXPR_HSHADOW_17 = -1
    EXPR_HSHADOW_24 = -1; EXPR_HSHADOW_25 = -1; EXPR_HSHADOW_26 = -1; EXPR_HSHADOW_27 = -1
    EXPR_HSHADOW_34 = -1; EXPR_HSHADOW_35 = -1; EXPR_HSHADOW_36 = -1; EXPR_HSHADOW_37 = -1
    EXPR_HSHADOW_44 = -1; EXPR_HSHADOW_45 = -1; EXPR_HSHADOW_46 = -1; EXPR_HSHADOW_47 = -1
    EXPR_HSHADOW_55 = -1; EXPR_HSHADOW_56 = -1; EXPR_HSHADOW_57 = -1
    EXPR_HSHADOW_66 = -1; EXPR_HSHADOW_67 = -1
    EXPR_HSHADOW_77 = -1
                }
                if left_ty == 2 { EXPR_TY_HASH = left_hash } else { EXPR_TY_HASH = 0 }
            }
        }
        // β⁹ GTT: channel topology of a + b, a - b is the union of operand topologies.
        EXPR_CH_SET = left_ch_set_a | right_ch_set_a
        EXPR_PARAM_USED = left_param_used_a | right_param_used_a
    }
}

fn emit_kernel_cpu_direct_call_x86(fi: i64, abi_argc: i64) with Mut {
    emit_setup_direct_call_args_x86(abi_argc)
    emit_prepare_stack_call_args_x86(abi_argc, 6)
    em(0xe8)
    PATCH_OFF[PATCH_COUNT as usize] = CL
    PATCH_FN[PATCH_COUNT as usize] = fi
    PATCH_KIND[PATCH_COUNT as usize] = 0
    PATCH_COUNT = PATCH_COUNT + 1
    em32(0)
    emit_drop_call_args_x86(abi_argc + call_extra_stack_args_x86(abi_argc, 6))
}

fn emit_kernel_dispatch_x86(fi: i64, abi_argc: i64) with Mut, Panic, Div {
    if fi < 0 || fi >= FN_COUNT {
        emit_drop_call_args_x86(abi_argc)
        em(0x31); em(0xc0)
        return
    }
    if TARGET_OS != 0 || TARGET_ARCH != 0 || FN_PTX_SUPPORTED[fi as usize] == 0 || FN_PTX_KIND[fi as usize] != gpu_kernel_ptx_kind_vec_binary_f64() {
        emit_kernel_cpu_direct_call_x86(fi, abi_argc)
        return
    }

    NEEDS_GPU_RUNTIME_DYNLINK = 1
    emit_try_gpu_runtime_init_x86()
    em(0x48); em(0x85); em(0xc0)
    em(0x0f); em(0x84)
    let cpu_fallback = CL
    em32(0)

    let n_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let a_ptr_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let a_len_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let b_ptr_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let b_len_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let c_ptr_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let c_len_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let module_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let func_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let dptr_a_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let dptr_b_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let dptr_c_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let grid_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let bytes_a_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let bytes_b_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let bytes_c_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let param0_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let param1_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let param2_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let param3_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let paddr0_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let paddr1_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let paddr2_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let paddr3_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1

    emit_load_call_arg_to_rax_x86(abi_argc, 0); emit_store_var(n_slot)
    emit_load_call_arg_to_rax_x86(abi_argc, 1); emit_store_var(a_ptr_slot)
    emit_load_call_arg_to_rax_x86(abi_argc, 2); emit_store_var(a_len_slot)
    emit_load_call_arg_to_rax_x86(abi_argc, 3); emit_store_var(b_ptr_slot)
    emit_load_call_arg_to_rax_x86(abi_argc, 4); emit_store_var(b_len_slot)
    emit_load_call_arg_to_rax_x86(abi_argc, 5); emit_store_var(c_ptr_slot)
    emit_load_call_arg_to_rax_x86(abi_argc, 6); emit_store_var(c_len_slot)

    emit_load_var(a_len_slot)
    em(0x48); em(0xc1); em(0xe0); em(3)
    emit_store_var(bytes_a_slot)
    emit_load_var(b_len_slot)
    em(0x48); em(0xc1); em(0xe0); em(3)
    emit_store_var(bytes_b_slot)
    emit_load_var(c_len_slot)
    em(0x48); em(0xc1); em(0xe0); em(3)
    emit_store_var(bytes_c_slot)

    emit_load_var(n_slot)
    em(0x48); em(0x05); em32(255)
    em(0x48); em(0xc1); em(0xe8); em(8)
    emit_store_var(grid_slot)

    emit_lea_var(module_slot); em(0x50)
    emit_inline_cstr_from_ptx_x86(FN_PTX_OFF[fi as usize], FN_PTX_LEN[fi as usize]); em(0x50)
    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMODULELOADDATA_PTR_BSS_OFF, 2)
    em(0x85); em(0xc0); em(0x0f); em(0x85); let gpu_fail = CL; em32(0)

    emit_lea_var(func_slot); em(0x50)
    emit_load_var(module_slot); em(0x50)
    let name_tok = FN_NAME_TOK[fi as usize]
    emit_inline_cstr_from_src_x86(TS[name_tok as usize], TE[name_tok as usize]); em(0x50)
    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMODULEGETFUNCTION_PTR_BSS_OFF, 3)
    em(0x85); em(0xc0); em(0x0f); em(0x85); let gpu_fail_b = CL; em32(0)

    emit_lea_var(dptr_a_slot); em(0x50)
    emit_load_var(bytes_a_slot); em(0x50)
    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMEMALLOC_PTR_BSS_OFF, 2)
    em(0x85); em(0xc0); em(0x0f); em(0x85); let gpu_fail_c = CL; em32(0)
    emit_lea_var(dptr_b_slot); em(0x50)
    emit_load_var(bytes_b_slot); em(0x50)
    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMEMALLOC_PTR_BSS_OFF, 2)
    em(0x85); em(0xc0); em(0x0f); em(0x85); let gpu_fail_d = CL; em32(0)
    emit_lea_var(dptr_c_slot); em(0x50)
    emit_load_var(bytes_c_slot); em(0x50)
    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMEMALLOC_PTR_BSS_OFF, 2)
    em(0x85); em(0xc0); em(0x0f); em(0x85); let gpu_fail_e = CL; em32(0)

    emit_load_var(dptr_a_slot); em(0x50)
    emit_load_var(a_ptr_slot); em(0x50)
    emit_load_var(bytes_a_slot); em(0x50)
    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMEMCPYHTOD_PTR_BSS_OFF, 3)
    em(0x85); em(0xc0); em(0x0f); em(0x85); let gpu_fail_f = CL; em32(0)
    emit_load_var(dptr_b_slot); em(0x50)
    emit_load_var(b_ptr_slot); em(0x50)
    emit_load_var(bytes_b_slot); em(0x50)
    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMEMCPYHTOD_PTR_BSS_OFF, 3)
    em(0x85); em(0xc0); em(0x0f); em(0x85); let gpu_fail_g = CL; em32(0)
    emit_load_var(dptr_c_slot); em(0x50)
    emit_load_var(c_ptr_slot); em(0x50)
    emit_load_var(bytes_c_slot); em(0x50)
    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMEMCPYHTOD_PTR_BSS_OFF, 3)
    em(0x85); em(0xc0); em(0x0f); em(0x85); let gpu_fail_h = CL; em32(0)

    emit_load_var(n_slot); emit_store_var(param0_slot)
    emit_load_var(dptr_a_slot); emit_store_var(param1_slot)
    emit_load_var(dptr_b_slot); emit_store_var(param2_slot)
    emit_load_var(dptr_c_slot); emit_store_var(param3_slot)
    emit_lea_var(param0_slot); emit_store_var(paddr0_slot)
    emit_lea_var(param1_slot); emit_store_var(paddr1_slot)
    emit_lea_var(param2_slot); emit_store_var(paddr2_slot)
    emit_lea_var(param3_slot); emit_store_var(paddr3_slot)

    emit_load_var(func_slot); em(0x50)
    emit_load_var(grid_slot); em(0x50)
    emit_imm64(1); em(0x50)
    emit_imm64(1); em(0x50)
    emit_imm64(256); em(0x50)
    emit_imm64(1); em(0x50)
    emit_imm64(1); em(0x50)
    emit_imm64(0); em(0x50)
    emit_imm64(0); em(0x50)
    emit_lea_var(paddr0_slot); em(0x50)
    emit_imm64(0); em(0x50)
    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CULAUNCHKERNEL_PTR_BSS_OFF, 11)
    em(0x85); em(0xc0); em(0x0f); em(0x85); let gpu_fail_i = CL; em32(0)

    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUCTXSYNC_PTR_BSS_OFF, 0)
    em(0x85); em(0xc0); em(0x0f); em(0x85); let gpu_fail_j = CL; em32(0)

    emit_load_var(c_ptr_slot); em(0x50)
    emit_load_var(dptr_c_slot); em(0x50)
    emit_load_var(bytes_c_slot); em(0x50)
    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMEMCPYDTOH_PTR_BSS_OFF, 3)
    em(0x85); em(0xc0); em(0x0f); em(0x85); let gpu_fail_k = CL; em32(0)

    emit_load_var(dptr_a_slot); em(0x50)
    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMEMFREE_PTR_BSS_OFF, 1)
    emit_load_var(dptr_b_slot); em(0x50)
    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMEMFREE_PTR_BSS_OFF, 1)
    emit_load_var(dptr_c_slot); em(0x50)
    emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUMEMFREE_PTR_BSS_OFF, 1)
    emit_drop_call_args_x86(abi_argc)
    em(0x31); em(0xc0)
    em(0xe9)
    let done = CL
    em32(0)

    patch32(gpu_fail, CL)
    patch32(gpu_fail_b, CL)
    patch32(gpu_fail_c, CL)
    patch32(gpu_fail_d, CL)
    patch32(gpu_fail_e, CL)
    patch32(gpu_fail_f, CL)
    patch32(gpu_fail_g, CL)
    patch32(gpu_fail_h, CL)
    patch32(gpu_fail_i, CL)
    patch32(gpu_fail_j, CL)
    patch32(gpu_fail_k, CL)
    emit_mark_gpu_unavailable_x86("GPU unavailable: CUDA kernel launch failed\n")
    patch32(cpu_fallback, CL)
    emit_kernel_cpu_direct_call_x86(fi, abi_argc)
    patch32(done, CL)
}

fn compile_gpu_launch_stmt_x86() with IO, Mut, Panic, Div {
    let perform_tok = EP
    EP = EP + 4  // skip perform GPU . launch
    let launch_tok = EP
    if TK[EP as usize] != 6 {
        tc_error(perform_tok, "GPU.launch requires launch(...)")
        return
    }
    EP = EP + 1  // skip (

    var fi: i64 = -1
    var launch_argc: i64 = 0
    if TK[EP as usize] != 7 && TK[EP as usize] != 0 {
        launch_argc = 1
        if TK[EP as usize] == 3 {
            fi = fn_find(TS[EP as usize], TE[EP as usize])
            if fi < 0 {
                tc_undefined_var(EP)
            } else if FN_IS_KERNEL[fi as usize] == 0 {
                tc_error(EP, "GPU.launch requires kernel fn")
                fi = -1
            }
            EP = EP + 1
        } else {
            tc_error(perform_tok, "GPU.launch requires kernel function name")
            EP = skip_call_arg_expr(EP)
        }
        while ep_before_body_close() && TK[EP as usize] == 28 {
            EP = EP + 1
            launch_argc = launch_argc + 1
            EP = skip_call_arg_expr(EP)
        }
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }
    else { tc_error(perform_tok, "GPU.launch missing closing )") }
    if launch_argc != 3 { tc_wrong_arity(launch_tok, 3, launch_argc) }

    if TK[EP as usize] != 6 {
        tc_error(perform_tok, "GPU.launch requires kernel argument list")
        return
    }
    EP = EP + 1  // skip (

    let call_tok = launch_tok
    var argc: i64 = 0
    var abi_argc: i64 = 0
    if fi >= 0 {
        while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
            compile_or()
            scan_fn_param_type(fi, argc)
            if (SCAN_TY == 0 || SCAN_TY == 2) && unit_call_arg_mismatch(SCAN_TY_HASH, EXPR_UNIT, EXPR_UNIT_DIM) {
                tc_linear_violation(call_tok, "unit mismatch in call argument")
            }
            if (SCAN_TY != 0 || SCAN_TY_HASH != 0) && call_arg_type_compatible(SCAN_TY, SCAN_TY_HASH, EXPR_TY, EXPR_TY_HASH) == false {
                if type_has_knowledge(SCAN_TY, SCAN_TY_HASH) || type_has_knowledge(EXPR_TY, EXPR_TY_HASH) {
                    tc_epistemic_boundary(call_tok)
                } else {
                    let ont_r = try_tc_ontology_call_error(call_tok, SCAN_TY_HASH, EXPR_TY_HASH)
                    if ont_r == 0 { tc_linear_violation(call_tok, "error[E001]: Type mismatch in call argument — declared type does not match") }
                }
            }
            try_apply_call_arg_refinement(call_tok)
            if type_is_slice_ref(SCAN_TY, SCAN_TY_HASH) {
                emit_push_expr_as_slice_arg_x86(call_tok)
                abi_argc = abi_argc + 2
            } else {
                materialize_aggregate_expr_x86()
                em(0x50)
                abi_argc = abi_argc + 1
            }
            argc = argc + 1
            if TK[EP as usize] == 28 { EP = EP + 1 }
        }
    } else {
        while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
            EP = skip_call_arg_expr(EP)
            argc = argc + 1
            if TK[EP as usize] == 28 { EP = EP + 1 }
        }
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }
    else { tc_error(perform_tok, "GPU.launch missing kernel argument )") }

    if fi >= 0 {
        if FN_ARITY[fi as usize] != argc { tc_wrong_arity(call_tok, FN_ARITY[fi as usize], argc) }
        let callee_eff = FN_EFFECTS[fi as usize]
        let caller_eff = FN_EFFECTS[CURRENT_FN as usize]
        let gpu_callee_imp = (FN_EFFECTS[fi as usize] & 2048) != 0
        let gpu_caller_imp = (FN_EFFECTS[CURRENT_FN as usize] & 2048) != 0
        if bitset_is_subset(callee_eff, caller_eff) == false && !(gpu_callee_imp && gpu_caller_imp) {
            tc_effect_call_violation(call_tok, callee_eff, caller_eff)
        }
        emit_kernel_dispatch_x86(fi, abi_argc)
    }
    EXPR_IS_F64 = 0
    EXPR_TY = 5
    EXPR_TY_HASH = 0
}

fn compile_gpu_sync_stmt_x86() with IO, Mut, Panic, Div {
    let sync_tok = EP
    EP = EP + 4  // skip perform GPU . sync
    if TK[EP as usize] != 6 {
        tc_error(sync_tok, "GPU.sync requires sync()")
        return
    }
    EP = EP + 1  // skip (
    var argc: i64 = 0
    while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
        EP = skip_call_arg_expr(EP)
        argc = argc + 1
        if TK[EP as usize] == 28 { EP = EP + 1 }
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }
    else { tc_error(sync_tok, "GPU.sync missing closing )") }
    if argc != 0 { tc_wrong_arity(sync_tok, 0, argc) }
    if TARGET_OS == 0 && TARGET_ARCH == 0 && NEEDS_GPU_RUNTIME_DYNLINK != 0 {
        emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + GPU_RT_STATE_BSS_OFF)
        em(0x48); em(0x83); em(0xf8); em(1)
        em(0x0f); em(0x85)
        let skip_sync = CL
        em32(0)
        emit_call_abs_qword_x86(GL_BSS_BASE + GPU_RT_CUCTXSYNC_PTR_BSS_OFF, 0)
        patch32(skip_sync, CL)
    }
    EXPR_IS_F64 = 0
    EXPR_TY = 5
    EXPR_TY_HASH = 0
}

// Shift: << (40), >> (39)
fn compile_shift() with IO, Mut, Panic, Div {
    compile_additive()
    while TK[EP as usize] == 39 || TK[EP as usize] == 40 {
        let op_tok = EP
        let op = TK[EP as usize]
        EP = EP + 1
        let left_ty = EXPR_TY
        emit_push()
        compile_additive()
        let right_ty = EXPR_TY
        if left_ty != 0 && left_ty != 1 { tc_error_hard(op_tok, "shift requires integer operands") }
        if right_ty != 0 && right_ty != 1 { tc_error_hard(op_tok, "shift requires integer operands") }
        // rax=rhs (shift amount), stack=lhs
        em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (shift amount in cl)
        em(0x58)  // pop rax (lhs)
        if op == 40 { em(0x48); em(0xd3); em(0xe0) }  // shl rax, cl
        if op == 39 { em(0x48); em(0xd3); em(0xf8) }  // sar rax, cl
        EXPR_TY = 1
        EXPR_TY_HASH = 0
    }
}

// Bitwise AND: & (44)
fn compile_bitand() with IO, Mut, Panic, Div {
    compile_shift()
    while TK[EP as usize] == 44 {
        let op_tok = EP
        let left_ty = EXPR_TY
        EP = EP + 1; emit_push(); compile_shift()
        if left_ty != 0 && left_ty != 1 { tc_error_hard(op_tok, "bitwise and requires integer operands") }
        if EXPR_TY != 0 && EXPR_TY != 1 { tc_error_hard(op_tok, "bitwise and requires integer operands") }
        em(0x59); em(0x48); em(0x21); em(0xc8)  // pop rcx; and rax, rcx
        EXPR_TY = 1
        EXPR_TY_HASH = 0
    }
}

// Bitwise XOR: ^ (56)
fn compile_bitxor() with IO, Mut, Panic, Div {
    compile_bitand()
    while TK[EP as usize] == 56 {
        let op_tok = EP
        let left_ty = EXPR_TY
        EP = EP + 1; emit_push(); compile_bitand()
        if left_ty != 0 && left_ty != 1 { tc_error_hard(op_tok, "bitwise xor requires integer operands") }
        if EXPR_TY != 0 && EXPR_TY != 1 { tc_error_hard(op_tok, "bitwise xor requires integer operands") }
        em(0x59); em(0x48); em(0x31); em(0xc8)  // pop rcx; xor rax, rcx
        EXPR_TY = 1
        EXPR_TY_HASH = 0
    }
}

// Bitwise OR: | (45)
fn compile_bitor() with IO, Mut, Panic, Div {
    compile_bitxor()
    while TK[EP as usize] == 45 {
        let op_tok = EP
        let left_ty = EXPR_TY
        EP = EP + 1; emit_push(); compile_bitxor()
        if left_ty != 0 && left_ty != 1 { tc_error_hard(op_tok, "bitwise or requires integer operands") }
        if EXPR_TY != 0 && EXPR_TY != 1 { tc_error_hard(op_tok, "bitwise or requires integer operands") }
        em(0x59); em(0x48); em(0x09); em(0xc8)  // pop rcx; or rax, rcx
        EXPR_TY = 1
        EXPR_TY_HASH = 0
    }
}

fn compile_comparison() with IO, Mut, Panic, Div {
    compile_bitor()
    let op = TK[EP as usize]
    if op == 21 || op == 22 || op == 23 || op == 24 || op == 25 || op == 26 {
        let op_tok = EP
        let left_raw_f64 = EXPR_IS_F64
        let left_raw_ty = EXPR_TY
        let left_raw_hash = EXPR_TY_HASH
        EP = EP + 1
        emit_push()
        compile_bitor()
        let right_raw_ty = EXPR_TY
        let right_raw_hash = EXPR_TY_HASH
        comparison_require_observe(op_tok, left_raw_ty, right_raw_ty)
        let left_ty = comparison_visible_ty(left_raw_ty, left_raw_hash)
        let left_hash = comparison_visible_hash(left_raw_ty, left_raw_hash)
        let right_ty = comparison_visible_ty(right_raw_ty, right_raw_hash)
        let right_hash = comparison_visible_hash(right_raw_ty, right_raw_hash)
        if left_ty == 3 && right_ty == 3 {
            if op != 21 && op != 22 {
                tc_error(op_tok, "ordered comparison requires matching numeric operands")
            }
            em(0x59)  // pop rcx (lhs)
            emit_str_eq_regs_x86()
            if op == 22 {
                em(0x48); em(0x83); em(0xf0); em(1)  // xor rax, 1
            }
            EXPR_IS_F64 = 0
            EXPR_TY = 4
            EXPR_TY_HASH = 0
            return
        }
        let left_f64 = if left_raw_f64 == 1 || left_ty == 2 { 1 } else { 0 }
        if op == 21 || op == 22 {
            if ty_eq(left_ty, left_hash, right_ty, right_hash) == false {
                // Allow: same numeric kind, or either side is unresolved (type 0)
                if left_ty != 0 && right_ty != 0 {
                    if (left_ty == 2 && right_ty == 2) == false {
                        if (left_ty == 1 && right_ty == 1) == false {
                            tc_error_hard(op_tok, "comparison operands must have the same type")
                        }
                    }
                }
            }
        } else {
            if left_ty != 0 && right_ty != 0 {
                if ty_is_numeric(left_ty) == false || ty_is_numeric(right_ty) == false || ty_eq(left_ty, left_hash, right_ty, right_hash) == false {
                    tc_error_hard(op_tok, "ordered comparison requires matching numeric operands")
                }
            }
        }
        em(0x59)  // pop rcx (lhs)
        if left_f64 == 1 {
            // f64: movq xmm0, rcx (lhs); movq xmm1, rax (rhs); ucomisd xmm0, xmm1
            em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1)  // movq xmm0, rcx
            em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)  // movq xmm1, rax
            em(0x66); em(0x0f); em(0x2e); em(0xc1)            // ucomisd xmm0, xmm1
            // Use unsigned conditional sets for FP comparison
            if op == 21 { em(0x0f); em(0x94); em(0xc0) }  // sete al (==)
            if op == 22 { em(0x0f); em(0x95); em(0xc0) }  // setne al (!=)
            if op == 23 { em(0x0f); em(0x92); em(0xc0) }  // setb al (<)
            if op == 24 { em(0x0f); em(0x97); em(0xc0) }  // seta al (>)
            if op == 25 { em(0x0f); em(0x96); em(0xc0) }  // setbe al (<=)
            if op == 26 { em(0x0f); em(0x93); em(0xc0) }  // setae al (>=)
        } else {
            em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
            if op == 21 { em(0x0f); em(0x94); em(0xc0) }  // sete al
            if op == 22 { em(0x0f); em(0x95); em(0xc0) }  // setne al
            if op == 23 { em(0x0f); em(0x9c); em(0xc0) }  // setl al
            if op == 24 { em(0x0f); em(0x9f); em(0xc0) }  // setg al
            if op == 25 { em(0x0f); em(0x9e); em(0xc0) }  // setle al
            if op == 26 { em(0x0f); em(0x9d); em(0xc0) }  // setge al
        }
        em(0x48); em(0x0f); em(0xb6); em(0xc0)  // movzx rax, al
        EXPR_IS_F64 = 0
        EXPR_TY = 4
        EXPR_TY_HASH = 0
    }
}

// Logical AND: && (30) — short-circuit
fn compile_and() with IO, Mut, Panic, Div {
    compile_comparison()
    while TK[EP as usize] == 30 {
        let op_tok = EP
        let left_ty = EXPR_TY
        EP = EP + 1
        if left_ty != 0 && left_ty != 4 { tc_error_hard(op_tok, "logical and requires bool operands") }
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x0f); em(0x84)             // je short_false (rel32)
        let patch = CL; em32(0)
        compile_comparison()
        if EXPR_TY != 0 && EXPR_TY != 4 { tc_error_hard(op_tok, "logical and requires bool operands") }
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x0f); em(0x95); em(0xc0)  // setne al
        em(0x48); em(0x0f); em(0xb6); em(0xc0)  // movzx rax, al
        em(0xe9); let end_patch = CL; em32(0)  // jmp end
        // short_false: rax already 0
        let here = CL
        CD[patch as usize] = ((here - patch - 4) & 0xFF) as i8
        CD[(patch+1) as usize] = (((here - patch - 4) >> 8) & 0xFF) as i8
        CD[(patch+2) as usize] = (((here - patch - 4) >> 16) & 0xFF) as i8
        CD[(patch+3) as usize] = (((here - patch - 4) >> 24) & 0xFF) as i8
        em(0x31); em(0xc0)  // xor eax, eax
        let end = CL
        CD[end_patch as usize] = ((end - end_patch - 4) & 0xFF) as i8
        CD[(end_patch+1) as usize] = (((end - end_patch - 4) >> 8) & 0xFF) as i8
        CD[(end_patch+2) as usize] = (((end - end_patch - 4) >> 16) & 0xFF) as i8
        CD[(end_patch+3) as usize] = (((end - end_patch - 4) >> 24) & 0xFF) as i8
        EXPR_TY = 4
        EXPR_TY_HASH = 0
    }
}

// Logical OR: || (31) — short-circuit
fn compile_or() with IO, Mut, Panic, Div {
    compile_and()
    while TK[EP as usize] == 31 {
        let op_tok = EP
        let left_ty = EXPR_TY
        EP = EP + 1
        if left_ty != 0 && left_ty != 4 { tc_error(op_tok, "logical or requires bool operands") }
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x0f); em(0x85)             // jne short_true (rel32)
        let patch = CL; em32(0)
        compile_and()
        if EXPR_TY != 0 && EXPR_TY != 4 { tc_error(op_tok, "logical or requires bool operands") }
        em(0xe9); let end_patch = CL; em32(0)  // jmp end
        // short_true: result = 1
        let here = CL
        CD[patch as usize] = ((here - patch - 4) & 0xFF) as i8
        CD[(patch+1) as usize] = (((here - patch - 4) >> 8) & 0xFF) as i8
        CD[(patch+2) as usize] = (((here - patch - 4) >> 16) & 0xFF) as i8
        CD[(patch+3) as usize] = (((here - patch - 4) >> 24) & 0xFF) as i8
        em(0x48); em(0xb8); em64(1)
        let end = CL
        CD[end_patch as usize] = ((end - end_patch - 4) & 0xFF) as i8
        CD[(end_patch+1) as usize] = (((end - end_patch - 4) >> 8) & 0xFF) as i8
        CD[(end_patch+2) as usize] = (((end - end_patch - 4) >> 16) & 0xFF) as i8
        CD[(end_patch+3) as usize] = (((end - end_patch - 4) >> 24) & 0xFF) as i8
        EXPR_TY = 4
        EXPR_TY_HASH = 0
    }
}

// ─── Patch helper ───
fn patch32(off: i64, target: i64) with Mut, Panic {
    let rel = target - off - 4
    CD[off as usize] = (rel & 0xFF) as i8
    CD[(off+1) as usize] = ((rel >> 8) & 0xFF) as i8
    CD[(off+2) as usize] = ((rel >> 16) & 0xFF) as i8
    CD[(off+3) as usize] = ((rel >> 24) & 0xFF) as i8
}

var TUP_PAT_NEXT: i64 = 0
var TUP_RHS_NEXT: i64 = 0

fn tuple_bind_leaf_x86(ns: i64, ne: i64) with Mut, Panic, Div {
    if type_is_option_inline(EXPR_TY, EXPR_TY_HASH) {
        let opt_slot = var_add_option_inline(ns, ne, EXPR_TY_HASH)
        if opt_slot < 0 { return }
        emit_copy_option_to_local_x86(opt_slot)
        VAR_IS_CLOSURE[(VAR_COUNT - 1) as usize] = 0
        VAR_LINEAR[(VAR_COUNT - 1) as usize] = 0
        VAR_AFFINE[(VAR_COUNT - 1) as usize] = 0
        return
    }
    let slot = var_add(ns, ne)
    if slot < 0 { return }
    let vix = VAR_COUNT - 1
    emit_store_var(slot)
    VAR_IS_F64[vix as usize] = EXPR_IS_F64
    VAR_TY[vix as usize] = EXPR_TY
    VAR_TY_HASH[vix as usize] = EXPR_TY_HASH
    if VAR_TY[vix as usize] == 8 {
        VAR_ALEN[vix as usize] = arr_hash_alen(VAR_TY_HASH[vix as usize])
        VAR_ESIZ[vix as usize] = arr_hash_esiz(VAR_TY_HASH[vix as usize])
    }
    VAR_IS_CLOSURE[vix as usize] = LAST_EXPR_IS_CLOSURE
    VAR_LINEAR[vix as usize] = LAST_EXPR_IS_LINEAR
    VAR_AFFINE[vix as usize] = LAST_EXPR_IS_AFFINE
}

fn tuple_bind_leaf_a64(ns: i64, ne: i64) with Mut, Panic, Div {
    if type_is_option_inline(EXPR_TY, EXPR_TY_HASH) {
        let opt_slot = var_add_option_inline(ns, ne, EXPR_TY_HASH)
        if opt_slot < 0 { return }
        emit_copy_option_to_local_a64(opt_slot)
        VAR_IS_CLOSURE[(VAR_COUNT - 1) as usize] = 0
        VAR_LINEAR[(VAR_COUNT - 1) as usize] = 0
        VAR_AFFINE[(VAR_COUNT - 1) as usize] = 0
        return
    }
    let slot = var_add(ns, ne)
    if slot < 0 { return }
    let vix = VAR_COUNT - 1
    emit_store_var_a64(slot)
    VAR_IS_F64[vix as usize] = EXPR_IS_F64
    VAR_TY[vix as usize] = EXPR_TY
    VAR_TY_HASH[vix as usize] = EXPR_TY_HASH
    if VAR_TY[vix as usize] == 8 {
        VAR_ALEN[vix as usize] = arr_hash_alen(VAR_TY_HASH[vix as usize])
        VAR_ESIZ[vix as usize] = arr_hash_esiz(VAR_TY_HASH[vix as usize])
    }
    VAR_IS_CLOSURE[vix as usize] = LAST_EXPR_IS_CLOSURE
    VAR_LINEAR[vix as usize] = LAST_EXPR_IS_LINEAR
    VAR_AFFINE[vix as usize] = LAST_EXPR_IS_AFFINE
}

fn tuple_skip_value_x86() with IO, Mut, Panic, Div {
    if TK[EP as usize] == 6 {
        EP = EP + 1
        while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
            tuple_skip_value_x86()
            if TK[EP as usize] == 28 { EP = EP + 1 }
        }
        if TK[EP as usize] == 7 { EP = EP + 1 }
        EXPR_TY = 0
        EXPR_TY_HASH = 0
        EXPR_IS_F64 = 0
        return
    }
    compile_or()
}

fn tuple_skip_value_a64() with IO, Mut, Panic, Div {
    if TK[EP as usize] == 6 {
        EP = EP + 1
        while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
            tuple_skip_value_a64()
            if TK[EP as usize] == 28 { EP = EP + 1 }
        }
        if TK[EP as usize] == 7 { EP = EP + 1 }
        EXPR_TY = 0
        EXPR_TY_HASH = 0
        EXPR_IS_F64 = 0
        return
    }
    compile_or_a64()
}

// Destructure a tuple-returning expression into pattern variables (x86 path).
// ptr_slot holds the SRET pointer (rax from the call).  tup_hash encodes the
// element types/sizes via the standard format:
//   tcount_enc * 1_000_000 + first_nslots * 1_000 + total_nslots
//   where tcount_enc = tup_first_f64 * 10 + tup_last_f64
// Currently handles flat 2-element tuples only.
fn tuple_destructure_from_ptr_x86(pat_start: i64, tup_hash: i64, ptr_slot: i64) with IO, Mut, Panic, Div {
    // Fall back to hash-derived values; override with TUP_CACHE if present (handles
    // slot counts > 999 that overflow the 3-digit hash encoding, e.g. TileBuf/65537).
    var tup_first_slots: i64 = (tup_hash % 1000000) / 1000
    var tup_total_slots: i64 = tup_hash % 1000
    var tup_first_f64: i64 = (tup_hash / 10000000) % 10
    var tup_last_f64: i64 = (tup_hash / 1000000) % 10
    var tup_first_ty: i64 = 1
    var tup_first_ty_hash: i64 = 0
    var tup_last_ty: i64 = 1
    var tup_last_ty_hash: i64 = 0
    let tup_ci = tup_cache_lookup(tup_hash)
    var have_full: i64 = 0
    if tup_ci >= 0 {
        tup_first_ty = TUP_CACHE_FIRST_TY[tup_ci as usize]
        tup_first_ty_hash = TUP_CACHE_FIRST_HASH[tup_ci as usize]
        tup_last_ty = TUP_CACHE_LAST_TY[tup_ci as usize]
        tup_last_ty_hash = TUP_CACHE_LAST_HASH[tup_ci as usize]
        let fs = ty_slot_count(tup_first_ty, tup_first_ty_hash)
        let ls = ty_slot_count(tup_last_ty, tup_last_ty_hash)
        if fs > 0 { tup_first_slots = fs }
        if tup_first_ty == 2 { tup_first_f64 = 1 } else { tup_first_f64 = 0 }
        if tup_last_ty == 2 { tup_last_f64 = 1 } else { tup_last_f64 = 0 }
        if TUP_CACHE_TCOUNT[tup_ci as usize] > 2 {
            // N-ary tuple (3+ elements): the first/last-only split below would
            // alias every middle element onto the LAST element's type/offset and
            // collide element 2+'s offset with element 1's — Bug G / issue #601.
            // Address every element from the full per-element cache row instead.
            have_full = 1
            let es = tup_elem_slots_sum(tup_ci)
            if es > 0 { tup_total_slots = es }
        } else if fs > 0 && ls > 0 {
            tup_total_slots = fs + ls
        }
    }
    let tup_last_slots = tup_total_slots - tup_first_slots
    var pp = pat_start + 1
    var elem_idx: i64 = 0
    var byte_off_acc: i64 = 0
    while TK[pp as usize] != 7 && TK[pp as usize] != 0 {
        if TK[pp as usize] == 28 { pp = pp + 1; continue }
        if TK[pp as usize] != 3 { pp = pp + 1; continue }
        let pns = TS[pp as usize]
        let pne = TE[pp as usize]
        let is_wild = if pne - pns == 1 && sb(pns) == 95 { 1 } else { 0 }
        pp = pp + 1
        var elem_is_f64: i64 = 0
        var elem_slots: i64 = 0
        var byte_off: i64 = 0
        var elem_ty: i64 = 0
        var elem_ty_hash: i64 = 0
        if have_full == 1 && elem_idx < TUP_CACHE_TCOUNT[tup_ci as usize] {
            elem_ty = TUP_CACHE_ELEM_TY[(tup_ci * 16 + elem_idx) as usize]
            elem_ty_hash = TUP_CACHE_ELEM_HASH[(tup_ci * 16 + elem_idx) as usize]
            elem_slots = ty_slot_count(elem_ty, elem_ty_hash)
            elem_is_f64 = if elem_ty == 2 { 1 } else { 0 }
            byte_off = byte_off_acc
        } else {
            elem_is_f64 = if elem_idx == 0 { tup_first_f64 } else { tup_last_f64 }
            elem_slots = if elem_idx == 0 { tup_first_slots } else { tup_last_slots }
            byte_off = if elem_idx == 0 { 0 } else { tup_first_slots * 8 }
            elem_ty = if elem_idx == 0 { tup_first_ty } else { tup_last_ty }
            elem_ty_hash = if elem_idx == 0 { tup_first_ty_hash } else { tup_last_ty_hash }
        }
        if is_wild == 0 {
            if elem_slots == 1 {
                emit_load_var(ptr_slot)
                if byte_off > 0 {
                    em(0x48); em(0x05); em32(byte_off)
                }
                em(0x48); em(0x8b); em(0x00)
                if elem_is_f64 == 1 { EXPR_IS_F64 = 1; EXPR_TY = 2 }
                else { EXPR_IS_F64 = 0; EXPR_TY = 1 }
                EXPR_TY_HASH = 0
                tuple_bind_leaf_x86(pns, pne)
            } else {
                // Aggregate element: bind as pointer into the SRET buffer.
                // rax = sret_ptr + byte_off points to the element's first slot.
                emit_load_var(ptr_slot)
                if byte_off > 0 {
                    em(0x48); em(0x05); em32(byte_off)
                }
                EXPR_IS_F64 = 0
                EXPR_TY = elem_ty
                EXPR_TY_HASH = elem_ty_hash
                tuple_bind_leaf_x86(pns, pne)
            }
        }
        byte_off_acc = byte_off_acc + elem_slots * 8
        elem_idx = elem_idx + 1
    }
}

// Destructure a tuple-returning expression into pattern variables (A64 path).
// ptr_slot holds the SRET pointer (x0 from the call).  tup_hash encodes the
// element types/sizes via the standard format.  Currently handles flat 2-element tuples only.
fn tuple_destructure_from_ptr_a64(pat_start: i64, tup_hash: i64, ptr_slot: i64) with IO, Mut, Panic, Div {
    let tup_first_slots = (tup_hash % 1000000) / 1000
    let tup_total_slots = tup_hash % 1000
    let tup_last_slots = tup_total_slots - tup_first_slots
    let tup_first_f64 = (tup_hash / 10000000) % 10
    let tup_last_f64 = (tup_hash / 1000000) % 10
    var pp = pat_start + 1
    var elem_idx: i64 = 0
    while TK[pp as usize] != 7 && TK[pp as usize] != 0 {
        if TK[pp as usize] == 28 { pp = pp + 1; continue }
        if TK[pp as usize] != 3 { pp = pp + 1; continue }
        let pns = TS[pp as usize]
        let pne = TE[pp as usize]
        let is_wild = if pne - pns == 1 && sb(pns) == 95 { 1 } else { 0 }
        pp = pp + 1
        let elem_is_f64 = if elem_idx == 0 { tup_first_f64 } else { tup_last_f64 }
        let elem_slots = if elem_idx == 0 { tup_first_slots } else { tup_last_slots }
        let byte_off = if elem_idx == 0 { 0 } else { tup_first_slots * 8 }
        if is_wild == 0 {
            if elem_slots == 1 {
                emit_load_var_a64(ptr_slot)
                if byte_off > 0 {
                    // add x0, x0, #byte_off  (imm12 in bits [21:10])
                    em32(0x91000000 | (byte_off << 10))
                }
                // ldr x0, [x0]
                em32(0xF9400000)
                if elem_is_f64 == 1 { EXPR_IS_F64 = 1; EXPR_TY = 2 }
                else { EXPR_IS_F64 = 0; EXPR_TY = 1 }
                EXPR_TY_HASH = 0
                tuple_bind_leaf_a64(pns, pne)
            }
        }
        elem_idx = elem_idx + 1
    }
}

// Struct pattern destructuring: let Point { x, y } = expr  (x86-64)
// pat_start = token index of '{'; si = struct table index; ptr_slot = saved struct pointer
fn struct_destructure_x86(pat_start: i64, si: i64, ptr_slot: i64) with IO, Mut, Panic, Div {
    if st_private_access_denied(si, pat_start) {
        tc_error_hard(pat_start, "private struct field access")
        return
    }
    var pp = pat_start + 1
    while TK[pp as usize] != 9 && TK[pp as usize] != 0 {
        if TK[pp as usize] == 28 { pp = pp + 1; continue }
        if TK[pp as usize] != 3 { pp = pp + 1; continue }
        let pns = TS[pp as usize]
        let pne = TE[pp as usize]
        let fh = gl_name_hash(pns, pne)
        pp = pp + 1
        let is_wild = if pne - pns == 1 && sb(pns) == 95 { 1 } else { 0 }
        if is_wild == 1 { continue }
        ST_QUERY_NS = pns
        ST_QUERY_NE = pne
        let off = st_field_offset(si, fh)
        if off < 0 { tc_error(pp - 1, "unknown struct field in pattern"); continue }
        let fty = st_field_ty(si, fh)
        let fhash = st_field_hash(si, fh)
        ST_QUERY_NS = -1
        ST_QUERY_NE = -1
        let fslots = ty_slot_count(fty, fhash)
        emit_load_var(ptr_slot)
        if fty == 6 || fty == 8 || type_is_option_inline(fty, fhash) {
            if off != 0 { em(0x48); em(0x8d); em(0x80); em32(off) }
            EXPR_TY = fty; EXPR_TY_HASH = fhash; EXPR_IS_F64 = 0
        } else {
            if off == 0 { em(0x48); em(0x8b); em(0x00) }
            else { em(0x48); em(0x8b); em(0x80); em32(off) }
            EXPR_IS_F64 = if fty == 2 { 1 } else { 0 }
            EXPR_TY = fty; EXPR_TY_HASH = fhash
        }
        tuple_bind_leaf_x86(pns, pne)
    }
}

// Struct pattern destructuring: let Point { x, y } = expr  (ARM64)
fn struct_destructure_a64(pat_start: i64, si: i64, ptr_slot: i64) with IO, Mut, Panic, Div {
    if st_private_access_denied(si, pat_start) {
        tc_error_hard(pat_start, "private struct field access")
        return
    }
    var pp = pat_start + 1
    while TK[pp as usize] != 9 && TK[pp as usize] != 0 {
        if TK[pp as usize] == 28 { pp = pp + 1; continue }
        if TK[pp as usize] != 3 { pp = pp + 1; continue }
        let pns = TS[pp as usize]
        let pne = TE[pp as usize]
        let fh = gl_name_hash(pns, pne)
        pp = pp + 1
        let is_wild = if pne - pns == 1 && sb(pns) == 95 { 1 } else { 0 }
        if is_wild == 1 { continue }
        ST_QUERY_NS = pns
        ST_QUERY_NE = pne
        let off = st_field_offset(si, fh)
        if off < 0 { tc_error(pp - 1, "unknown struct field in pattern"); continue }
        let fty = st_field_ty(si, fh)
        let fhash = st_field_hash(si, fh)
        ST_QUERY_NS = -1
        ST_QUERY_NE = -1
        emit_load_var_a64(ptr_slot)
        if fty == 6 || fty == 8 || type_is_option_inline(fty, fhash) {
            if off != 0 { em32(0x91000000 | (off << 10)) }
            EXPR_TY = fty; EXPR_TY_HASH = fhash; EXPR_IS_F64 = 0
        } else {
            if off == 0 { em32(0xF9400000) }
            else { em32(0xF9400000 | ((off / 8) << 10)) }
            EXPR_IS_F64 = if fty == 2 { 1 } else { 0 }
            EXPR_TY = fty; EXPR_TY_HASH = fhash
        }
        tuple_bind_leaf_a64(pns, pne)
    }
}

fn tuple_bind_pattern_x86(pp0: i64, rp0: i64) with IO, Mut, Panic, Div {
    var pp = pp0
    var rp = rp0
    if TK[pp as usize] != 6 || TK[rp as usize] != 6 {
        tc_error(pp0, "tuple destructure shape mismatch")
        TUP_PAT_NEXT = pp
        TUP_RHS_NEXT = rp
        return
    }
    pp = pp + 1
    rp = rp + 1
    while TK[pp as usize] != 7 && TK[pp as usize] != 0 {
        if TK[pp as usize] == 6 {
            if TK[rp as usize] != 6 {
                tc_error(pp, "tuple destructure shape mismatch")
                EP = rp
                tuple_skip_value_x86()
                rp = EP
                while TK[pp as usize] != 7 && TK[pp as usize] != 0 { pp = pp + 1 }
            } else {
                tuple_bind_pattern_x86(pp, rp)
                pp = TUP_PAT_NEXT
                rp = TUP_RHS_NEXT
            }
        } else {
            let pns = TS[pp as usize]
            let pne = TE[pp as usize]
            var is_wild: i64 = 0
            if pne - pns == 1 && sb(pns) == 95 { is_wild = 1 }
            pp = pp + 1
            EP = rp
            if is_wild == 1 {
                tuple_skip_value_x86()
                rp = EP
            } else {
                if TK[rp as usize] == 6 {
                    tc_error(pp - 1, "tuple destructure shape mismatch")
                    tuple_skip_value_x86()
                    rp = EP
                } else {
                    compile_or()
                    rp = EP
                    tuple_bind_leaf_x86(pns, pne)
                }
            }
        }
        if TK[pp as usize] == 28 { pp = pp + 1 }
        if TK[rp as usize] == 28 { rp = rp + 1 }
    }
    if TK[pp as usize] != 7 || TK[rp as usize] != 7 {
        // Count pattern elements: stop at matching closing ')'.
        var pc: i64 = 0; var qp = pp0 + 1; var dpth: i64 = 0; var pc_done: i64 = 0
        while TK[qp as usize] != 0 && pc_done == 0 {
            if TK[qp as usize] == 6 { dpth = dpth + 1 }
            if TK[qp as usize] == 7 && dpth == 0 { pc = pc + 1; pc_done = 1 }
            if TK[qp as usize] == 7 && dpth > 0 { dpth = dpth - 1 }
            if TK[qp as usize] == 28 && dpth == 0 { pc = pc + 1 }
            qp = qp + 1
        }
        var rc: i64 = 0; var qr = rp0 + 1; dpth = 0; var rc_done: i64 = 0
        while TK[qr as usize] != 0 && rc_done == 0 {
            if TK[qr as usize] == 6 { dpth = dpth + 1 }
            if TK[qr as usize] == 7 && dpth == 0 { rc = rc + 1; rc_done = 1 }
            if TK[qr as usize] == 7 && dpth > 0 { dpth = dpth - 1 }
            if TK[qr as usize] == 28 && dpth == 0 { rc = rc + 1 }
            qr = qr + 1
        }
        print("error[E213]: tuple destructure arity mismatch: has ")
        print_int(pc)
        print(" elements but type has ")
        print_int(rc)
        print(" at line ")
        print_int(TL[pp0 as usize])
        print("\n")
        tc_mark_failed()
    }
    if TK[pp as usize] == 7 { pp = pp + 1 }
    if TK[rp as usize] == 7 { rp = rp + 1 }
    TUP_PAT_NEXT = pp
    TUP_RHS_NEXT = rp
}

fn tuple_bind_pattern_a64(pp0: i64, rp0: i64) with IO, Mut, Panic, Div {
    var pp = pp0
    var rp = rp0
    if TK[pp as usize] != 6 || TK[rp as usize] != 6 {
        tc_error(pp0, "tuple destructure shape mismatch")
        TUP_PAT_NEXT = pp
        TUP_RHS_NEXT = rp
        return
    }
    pp = pp + 1
    rp = rp + 1
    while TK[pp as usize] != 7 && TK[pp as usize] != 0 {
        if TK[pp as usize] == 6 {
            if TK[rp as usize] != 6 {
                tc_error(pp, "tuple destructure shape mismatch")
                EP = rp
                tuple_skip_value_a64()
                rp = EP
                while TK[pp as usize] != 7 && TK[pp as usize] != 0 { pp = pp + 1 }
            } else {
                tuple_bind_pattern_a64(pp, rp)
                pp = TUP_PAT_NEXT
                rp = TUP_RHS_NEXT
            }
        } else {
            let pns = TS[pp as usize]
            let pne = TE[pp as usize]
            var is_wild: i64 = 0
            if pne - pns == 1 && sb(pns) == 95 { is_wild = 1 }
            pp = pp + 1
            EP = rp
            if is_wild == 1 {
                tuple_skip_value_a64()
                rp = EP
            } else {
                if TK[rp as usize] == 6 {
                    tc_error(pp - 1, "tuple destructure shape mismatch")
                    tuple_skip_value_a64()
                    rp = EP
                } else {
                    compile_or_a64()
                    rp = EP
                    tuple_bind_leaf_a64(pns, pne)
                }
            }
        }
        if TK[pp as usize] == 28 { pp = pp + 1 }
        if TK[rp as usize] == 28 { rp = rp + 1 }
    }
    if TK[pp as usize] != 7 || TK[rp as usize] != 7 { tc_error(pp0, "tuple destructure arity mismatch") }
    if TK[pp as usize] == 7 { pp = pp + 1 }
    if TK[rp as usize] == 7 { rp = rp + 1 }
    TUP_PAT_NEXT = pp
    TUP_RHS_NEXT = rp
}

fn resolve_field_struct_index(ns: i64, ne: i64, fh: i64) -> i64 with Panic, Div, Mut {
    let vi = var_find_idx(ns, ne)
    if vi >= 0 && type_is_struct_like(VAR_TY[vi as usize], VAR_TY_HASH[vi as usize]) {
        let si = st_find(VAR_TY_HASH[vi as usize])
        if si >= 0 { return si }
    }
    if vi >= 0 && (VAR_TY[vi as usize] == 10 || VAR_TY[vi as usize] == 11) {
        let inner_ty = ptr_hash_inner_ty(VAR_TY_HASH[vi as usize])
        let inner_hash = ptr_hash_inner_hash(VAR_TY_HASH[vi as usize])
        if inner_ty == 6 {
            let si = st_find(inner_hash)
            if si >= 0 { return si }
        }
    }
    let gi = gl_find(ns, ne)
    if gi >= 0 && type_is_struct_like(GL_TY[gi as usize], GL_TY_HASH[gi as usize]) {
        let si = st_find(GL_TY_HASH[gi as usize])
        if si >= 0 { return si }
    }
    var sj: i64 = 0
    while sj < ST_COUNT {
        if st_field_offset(sj, fh) >= 0 { return sj }
        sj = sj + 1
    }
    return -1
}

fn compile_field_array_store_x86() with IO, Mut, Panic, Div {
    let name_tok = EP
    let ns = TS[EP as usize]
    let ne = TE[EP as usize]
    let field_tok = EP + 2
    let fns = TS[(EP + 2) as usize]
    let fne = TE[(EP + 2) as usize]
    let fh = gl_name_hash(fns, fne)
    EP = EP + 4
    compile_or()
    if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
    if TK[EP as usize] == 42 { EP = EP + 1 }
    if TK[EP as usize] == 16 { EP = EP + 1 }
    em(0x50)
    compile_or()
    let rhs_ty = EXPR_TY
    let rhs_ty_hash = EXPR_TY_HASH
    ST_QUERY_NS = fns
    ST_QUERY_NE = fne
    let si = resolve_field_struct_index(ns, ne, fh)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if si < 0 {
        tc_error(field_tok, "unknown field access")
        em(0x59)
        return
    }
    if st_private_access_denied(si, field_tok) {
        tc_error_hard(field_tok, "private struct field access")
        em(0x59)
        return
    }
                    ST_QUERY_NS = fns
                    ST_QUERY_NE = fne
    let foff = st_field_offset(si, fh)
    let fty = st_field_ty(si, fh)
    let fhash = st_field_hash(si, fh)
                    ST_QUERY_NS = -1
                    ST_QUERY_NE = -1
    if fty != 8 {
        tc_error(field_tok, "indexed field store requires array field")
        em(0x59)
        return
    }
    if ty_eq(arr_hash_elem_ty(fhash), arr_hash_elem_hash(fhash), rhs_ty, rhs_ty_hash) == false {
        tc_error(EP - 1, "assignment type mismatch")
    }
    materialize_aggregate_array_element_x86(fhash)
    em(0x48); em(0x89); em(0xc2)
    em(0x59)
    let slot = var_find(ns, ne)
    if slot >= 0 { emit_load_var(slot) }
    else {
        let gi = gl_find(ns, ne)
        if gi >= 0 {
            let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
            em(0x48); em(0xb8); em64(addr)
        } else {
            tc_undefined_var(name_tok)
            em(0x31); em(0xc0)
        }
    }
    if foff != 0 { em(0x48); em(0x8d); em(0x80); em32(foff) }
    if arr_hash_esiz(fhash) == 8 {
        em(0x48); em(0x89); em(0x14); em(0xc8)
    } else {
        em(0x88); em(0x14); em(0x08)
    }
}

// (*name).field[idx] = expr — explicit-deref store into a struct array field.
// Mirror of compile_field_array_store_x86 with the name/field tokens shifted past
// `( * … )`: name at EP+2, field at EP+5, body starts at EP+7. resolve_field_struct_index
// already resolves the struct through the pointer var's inner type, and emit_load_var
// loads the pointer value as the base — so codegen is otherwise identical.
fn compile_deref_field_array_store_x86() with IO, Mut, Panic, Div {
    let name_tok = EP + 2
    let ns = TS[(EP + 2) as usize]
    let ne = TE[(EP + 2) as usize]
    let field_tok = EP + 5
    let fns = TS[(EP + 5) as usize]
    let fne = TE[(EP + 5) as usize]
    let fh = gl_name_hash(fns, fne)
    if current_fn_allows_mutation() == false {
        tc_effect_violation(field_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
    }
    EP = EP + 7  // skip ( * name ) . field [
    compile_or()
    if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
    if TK[EP as usize] == 42 { EP = EP + 1 }
    if TK[EP as usize] == 16 { EP = EP + 1 }
    em(0x50)
    compile_or()
    let rhs_ty = EXPR_TY
    let rhs_ty_hash = EXPR_TY_HASH
    ST_QUERY_NS = fns
    ST_QUERY_NE = fne
    let si = resolve_field_struct_index(ns, ne, fh)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if si < 0 {
        tc_error(field_tok, "unknown field access")
        em(0x59)
        return
    }
    if st_private_access_denied(si, field_tok) {
        tc_error_hard(field_tok, "private struct field access")
        em(0x59)
        return
    }
    ST_QUERY_NS = fns
    ST_QUERY_NE = fne
    let foff = st_field_offset(si, fh)
    let fty = st_field_ty(si, fh)
    let fhash = st_field_hash(si, fh)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if fty != 8 {
        tc_error(field_tok, "indexed field store requires array field")
        em(0x59)
        return
    }
    if ty_eq(arr_hash_elem_ty(fhash), arr_hash_elem_hash(fhash), rhs_ty, rhs_ty_hash) == false {
        tc_error(EP - 1, "assignment type mismatch")
    }
    materialize_aggregate_array_element_x86(fhash)
    em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (value)
    em(0x59)  // pop rcx (index)
    let slot = var_find(ns, ne)
    if slot >= 0 { emit_load_var(slot) }  // rax = pointer/base
    else {
        let gi = gl_find(ns, ne)
        if gi >= 0 {
            let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
            em(0x48); em(0xb8); em64(addr)
        } else {
            tc_undefined_var(name_tok)
            em(0x31); em(0xc0)
        }
    }
    if foff != 0 { em(0x48); em(0x8d); em(0x80); em32(foff) }
    if arr_hash_esiz(fhash) == 8 {
        em(0x48); em(0x89); em(0x14); em(0xc8)  // mov [rax + rcx*8], rdx
    } else {
        em(0x88); em(0x14); em(0x08)  // mov [rax + rcx], dl
    }
}

// (*<expr>).field[idx] = expr — indexed field store through a deref of an ARBITRARY
// pointer expression (not just a simple var). The base pointer is produced by evaluating
// the inner expression with compile_or, so any nesting works — e.g. (*(*c).w).data[i] or
// (*(*c).fn_sigs.entries).data[i]. lean_single previously had no general lvalue-address
// path: every deref store hardcoded a simple-name root via var_find, so a complex base
// fell through and the store was silently dropped. This closes the whole complex-base
// indexed-store class.
fn compile_deref_complex_field_array_store_x86() with IO, Mut, Panic, Div {
    EP = EP + 2  // skip outer ( *
    compile_or()  // inner expr -> base pointer in rax
    let base_ty = EXPR_TY
    let base_hash = EXPR_TY_HASH
    if TK[EP as usize] == 7 { EP = EP + 1 }  // skip outer )
    if type_is_pointer_like(base_ty, base_hash) == false {
        tc_error(EP, "indexed field store through deref requires pointer base")
        return
    }
    let inner_ty = ptr_hash_inner_ty(base_hash)
    let inner_hash = ptr_hash_inner_hash(base_hash)
    if inner_ty != 6 {
        tc_error(EP, "field access through pointer/ref requires struct pointee")
        return
    }
    let si = st_find(inner_hash)
    if si < 0 {
        tc_error(EP, "unknown field access")
        return
    }
    em(0x50)  // push base pointer
    if TK[EP as usize] == 50 { EP = EP + 1 }  // skip .
    let field_tok = EP
    let fns = TS[EP as usize]
    let fne = TE[EP as usize]
    let fh = gl_name_hash(fns, fne)
    EP = EP + 1  // skip field name
    if TK[EP as usize] == 41 { EP = EP + 1 }  // skip [
    if current_fn_allows_mutation() == false {
        tc_effect_violation(field_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
    }
    compile_or()  // index in rax
    if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }  // as usize
    if TK[EP as usize] == 42 { EP = EP + 1 }  // ]
    if TK[EP as usize] == 16 { EP = EP + 1 }  // =
    em(0x50)  // push index
    compile_or()  // rhs in rax
    let rhs_ty = EXPR_TY
    let rhs_ty_hash = EXPR_TY_HASH
    ST_QUERY_NS = fns
    ST_QUERY_NE = fne
    let foff = st_field_offset(si, fh)
    let fty = st_field_ty(si, fh)
    let fhash = st_field_hash(si, fh)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if fty != 8 {
        tc_error(field_tok, "indexed field store requires array field")
        em(0x59); em(0x59)
        return
    }
    if ty_eq(arr_hash_elem_ty(fhash), arr_hash_elem_hash(fhash), rhs_ty, rhs_ty_hash) == false {
        tc_error(EP - 1, "assignment type mismatch")
    }
    materialize_aggregate_array_element_x86(fhash)
    em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (rhs)
    em(0x59)  // pop rcx (index)
    em(0x58)  // pop rax (base pointer)
    if foff != 0 { em(0x48); em(0x8d); em(0x80); em32(foff) }  // lea rax, [rax + foff]
    if arr_hash_esiz(fhash) == 8 {
        em(0x48); em(0x89); em(0x14); em(0xc8)  // mov [rax + rcx*8], rdx
    } else {
        em(0x88); em(0x14); em(0x08)  // mov [rax + rcx], dl
    }
}

// name.f1.f2 = expr — AUTO-DEREF two-level scalar/aggregate store (pointer root).
// Identical to compile_deref_field_field_store_x86 but with the token offsets for an
// ident root (no `( * … )` wrapper): name@EP, f1@EP+2, f2@EP+4, rhs after EP+6.
fn compile_autoderef_field_field_store_x86() with IO, Mut, Panic, Div {
    let name_tok = EP + 0
    let f1_tok = EP + 2
    let f2_tok = EP + 4
    if current_fn_allows_mutation() == false {
        tc_effect_violation(f2_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
    }
    let ns = TS[name_tok as usize]
    let ne = TE[name_tok as usize]
    let fh1 = gl_name_hash(TS[f1_tok as usize], TE[f1_tok as usize])
    let fh2 = gl_name_hash(TS[f2_tok as usize], TE[f2_tok as usize])
    EP = EP + 6  // skip name . f1 . f2 =
    compile_or()  // rhs in rax
    let rhs_ty = EXPR_TY
    let rhs_ty_hash = EXPR_TY_HASH
    let lslot = var_find(ns, ne)
    if lslot < 0 {
        tc_undefined_var(name_tok)
        return
    }
    let lvi = var_find_idx(ns, ne)
    if lvi < 0 || type_is_pointer_like(VAR_TY[lvi as usize], VAR_TY_HASH[lvi as usize]) == false {
        tc_error(f1_tok, "field access through deref requires ref or pointer binding")
        return
    }
    let inner_ty = ptr_hash_inner_ty(VAR_TY_HASH[lvi as usize])
    let inner_hash = ptr_hash_inner_hash(VAR_TY_HASH[lvi as usize])
    if inner_ty != 6 {
        tc_error(f1_tok, "field access through pointer/ref requires struct pointee")
        return
    }
    let si1 = st_find(inner_hash)
    if si1 < 0 {
        tc_error(f1_tok, "unknown field access")
        return
    }
    ST_QUERY_NS = TS[f1_tok as usize]
    ST_QUERY_NE = TE[f1_tok as usize]
    let foff1 = st_field_offset(si1, fh1)
    let fty1 = st_field_ty(si1, fh1)
    let fhash1 = st_field_hash(si1, fh1)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if foff1 < 0 || fty1 != 6 {
        tc_error(f1_tok, "nested field store requires inline struct field")
        return
    }
    let si2 = st_find(fhash1)
    if si2 < 0 {
        tc_error(f2_tok, "unknown field access")
        return
    }
    ST_QUERY_NS = TS[f2_tok as usize]
    ST_QUERY_NE = TE[f2_tok as usize]
    let foff2 = st_field_offset(si2, fh2)
    let fty2 = st_field_ty(si2, fh2)
    let fhash2 = st_field_hash(si2, fh2)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if foff2 < 0 {
        tc_error(f2_tok, "unknown field access")
        return
    }
    if ty_eq(fty2, fhash2, rhs_ty, rhs_ty_hash) == false {
        tc_error(EP - 1, "assignment type mismatch")
    }
    emit_store_to_pointer_offset_x86(lslot, foff1 + foff2, fty2, fhash2)
}

// name.f1.f2 = expr — VALUE two-level scalar store (value-struct root). Mirrors
// compile_autoderef_field_field_store_x86 but resolves the root struct from the var's own
// (value) struct type instead of a pointer pointee — a value-struct local's slot holds a
// pointer to the struct, so emit_store_to_pointer_offset_x86 stores correctly. Without this
// handler `o.inner.b = v` on a value struct fell through, the `=` was skipped, and the store
// was silently dropped.
fn compile_value_field_field_store_x86() with IO, Mut, Panic, Div {
    let name_tok = EP + 0
    let f1_tok = EP + 2
    let f2_tok = EP + 4
    if current_fn_allows_mutation() == false {
        tc_effect_violation(f2_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
    }
    let ns = TS[name_tok as usize]
    let ne = TE[name_tok as usize]
    let fh1 = gl_name_hash(TS[f1_tok as usize], TE[f1_tok as usize])
    let fh2 = gl_name_hash(TS[f2_tok as usize], TE[f2_tok as usize])
    EP = EP + 6  // skip name . f1 . f2 =
    compile_or()  // rhs in rax
    let rhs_ty = EXPR_TY
    let rhs_ty_hash = EXPR_TY_HASH
    let lslot = var_find(ns, ne)
    if lslot < 0 {
        tc_undefined_var(name_tok)
        return
    }
    ST_QUERY_NS = TS[f1_tok as usize]
    ST_QUERY_NE = TE[f1_tok as usize]
    let si1 = resolve_field_struct_index(ns, ne, fh1)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if si1 < 0 {
        tc_error(f1_tok, "unknown field access")
        return
    }
    ST_QUERY_NS = TS[f1_tok as usize]
    ST_QUERY_NE = TE[f1_tok as usize]
    let foff1 = st_field_offset(si1, fh1)
    let fty1 = st_field_ty(si1, fh1)
    let fhash1 = st_field_hash(si1, fh1)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if foff1 < 0 || fty1 != 6 {
        tc_error(f1_tok, "nested field store requires inline struct field")
        return
    }
    let si2 = st_find(fhash1)
    if si2 < 0 {
        tc_error(f2_tok, "unknown field access")
        return
    }
    ST_QUERY_NS = TS[f2_tok as usize]
    ST_QUERY_NE = TE[f2_tok as usize]
    let foff2 = st_field_offset(si2, fh2)
    let fty2 = st_field_ty(si2, fh2)
    let fhash2 = st_field_hash(si2, fh2)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if foff2 < 0 {
        tc_error(f2_tok, "unknown field access")
        return
    }
    if ty_eq(fty2, fhash2, rhs_ty, rhs_ty_hash) == false {
        tc_error(EP - 1, "assignment type mismatch")
    }
    emit_store_to_pointer_offset_x86(lslot, foff1 + foff2, fty2, fhash2)
}

// name.f1.f2[idx] = expr — AUTO-DEREF two-level array store (pointer root).
fn compile_autoderef_field_field_array_store_x86() with IO, Mut, Panic, Div {
    let name_tok = EP + 0
    let ns = TS[name_tok as usize]
    let ne = TE[name_tok as usize]
    let f1_tok = EP + 2
    let f2_tok = EP + 4
    let fh1 = gl_name_hash(TS[f1_tok as usize], TE[f1_tok as usize])
    let fh2 = gl_name_hash(TS[f2_tok as usize], TE[f2_tok as usize])
    if current_fn_allows_mutation() == false {
        tc_effect_violation(f2_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
    }
    EP = EP + 6  // skip name . f1 . f2 [
    compile_or()  // index in rax
    if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }  // 'as usize'
    if TK[EP as usize] == 42 { EP = EP + 1 }  // ]
    if TK[EP as usize] == 16 { EP = EP + 1 }  // =
    em(0x50)  // push index
    compile_or()  // value in rax
    let rhs_ty = EXPR_TY
    let rhs_ty_hash = EXPR_TY_HASH
    let lslot = var_find(ns, ne)
    let lvi = var_find_idx(ns, ne)
    if lslot < 0 || lvi < 0 || type_is_pointer_like(VAR_TY[lvi as usize], VAR_TY_HASH[lvi as usize]) == false {
        tc_error(f1_tok, "field access through deref requires ref or pointer binding")
        em(0x59)
        return
    }
    let inner_ty = ptr_hash_inner_ty(VAR_TY_HASH[lvi as usize])
    let inner_hash = ptr_hash_inner_hash(VAR_TY_HASH[lvi as usize])
    if inner_ty != 6 {
        tc_error(f1_tok, "field access through pointer/ref requires struct pointee")
        em(0x59)
        return
    }
    let si1 = st_find(inner_hash)
    if si1 < 0 {
        tc_error(f1_tok, "unknown field access")
        em(0x59)
        return
    }
    ST_QUERY_NS = TS[f1_tok as usize]
    ST_QUERY_NE = TE[f1_tok as usize]
    let foff1 = st_field_offset(si1, fh1)
    let fty1 = st_field_ty(si1, fh1)
    let fhash1 = st_field_hash(si1, fh1)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if foff1 < 0 || fty1 != 6 {
        tc_error(f1_tok, "nested field store requires inline struct field")
        em(0x59)
        return
    }
    let si2 = st_find(fhash1)
    if si2 < 0 {
        tc_error(f2_tok, "unknown field access")
        em(0x59)
        return
    }
    ST_QUERY_NS = TS[f2_tok as usize]
    ST_QUERY_NE = TE[f2_tok as usize]
    let foff2 = st_field_offset(si2, fh2)
    let fty2 = st_field_ty(si2, fh2)
    let fhash2 = st_field_hash(si2, fh2)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if foff2 < 0 || fty2 != 8 {
        tc_error(f2_tok, "indexed field store requires array field")
        em(0x59)
        return
    }
    if ty_eq(arr_hash_elem_ty(fhash2), arr_hash_elem_hash(fhash2), rhs_ty, rhs_ty_hash) == false {
        tc_error(EP - 1, "assignment type mismatch")
    }
    materialize_aggregate_array_element_x86(fhash2)
    em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (value)
    em(0x59)  // pop rcx (index)
    emit_load_var(lslot)  // rax = base pointer
    let total_off = foff1 + foff2
    if total_off != 0 { em(0x48); em(0x8d); em(0x80); em32(total_off) }  // lea rax,[rax+total_off]
    if arr_hash_esiz(fhash2) == 8 {
        em(0x48); em(0x89); em(0x14); em(0xc8)  // mov [rax + rcx*8], rdx
    } else {
        em(0x88); em(0x14); em(0x08)  // mov [rax + rcx], dl
    }
}

fn compile_value_field_field_array_store_x86() with IO, Mut, Panic, Div {
    let name_tok = EP
    let ns = TS[name_tok as usize]
    let ne = TE[name_tok as usize]
    let f1_tok = EP + 2
    let f2_tok = EP + 4
    let f1ns = TS[f1_tok as usize]
    let f1ne = TE[f1_tok as usize]
    let f2ns = TS[f2_tok as usize]
    let f2ne = TE[f2_tok as usize]
    let f1h = gl_name_hash(f1ns, f1ne)
    let f2h = gl_name_hash(f2ns, f2ne)

    EP = EP + 6
    compile_or()
    if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
    if TK[EP as usize] == 42 { EP = EP + 1 }
    if TK[EP as usize] == 16 { EP = EP + 1 }
    em(0x50)
    compile_or()
    let rhs_ty = EXPR_TY
    let rhs_ty_hash = EXPR_TY_HASH

    ST_QUERY_NS = f1ns
    ST_QUERY_NE = f1ne
    let si1 = resolve_field_struct_index(ns, ne, f1h)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if si1 < 0 {
        tc_error(f1_tok, "unknown field access")
        em(0x59)
        return
    }
    if st_private_access_denied(si1, f1_tok) {
        tc_error_hard(f1_tok, "private struct field access")
        em(0x59)
        return
    }
    ST_QUERY_NS = f1ns
    ST_QUERY_NE = f1ne
    let foff1 = st_field_offset(si1, f1h)
    let fty1 = st_field_ty(si1, f1h)
    let fhash1 = st_field_hash(si1, f1h)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if foff1 < 0 || fty1 != 6 {
        tc_error(f1_tok, "nested field store requires inline struct field")
        em(0x59)
        return
    }
    let si2 = st_find(fhash1)
    if si2 < 0 {
        tc_error(f1_tok, "nested field store requires known struct field type")
        em(0x59)
        return
    }
    if st_private_access_denied(si2, f2_tok) {
        tc_error_hard(f2_tok, "private struct field access")
        em(0x59)
        return
    }
    ST_QUERY_NS = f2ns
    ST_QUERY_NE = f2ne
    let foff2 = st_field_offset(si2, f2h)
    let fty2 = st_field_ty(si2, f2h)
    let fhash2 = st_field_hash(si2, f2h)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if foff2 < 0 || fty2 != 8 {
        tc_error(f2_tok, "indexed field store requires array field")
        em(0x59)
        return
    }
    if ty_eq(arr_hash_elem_ty(fhash2), arr_hash_elem_hash(fhash2), rhs_ty, rhs_ty_hash) == false {
        tc_error(EP - 1, "assignment type mismatch")
    }
    materialize_aggregate_array_element_x86(fhash2)
    em(0x48); em(0x89); em(0xc2)
    em(0x59)
    let slot = var_find(ns, ne)
    if slot >= 0 {
        emit_load_var(slot)
    } else {
        let gi = gl_find(ns, ne)
        if gi >= 0 {
            let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
            em(0x48); em(0xb8); em64(addr)
        } else {
            tc_undefined_var(name_tok)
            em(0x31); em(0xc0)
        }
    }
    let total_off = foff1 + foff2
    if total_off != 0 { em(0x48); em(0x8d); em(0x80); em32(total_off) }
    if arr_hash_esiz(fhash2) == 8 {
        em(0x48); em(0x89); em(0x14); em(0xc8)
    } else {
        em(0x88); em(0x14); em(0x08)
    }
}

fn compile_field_array_array_store_x86() with IO, Mut, Panic, Div {
    // Handles: ident.field[outer_idx][inner_idx] = val
    let name_tok = EP
    let ns = TS[EP as usize]
    let ne = TE[EP as usize]
    let field_tok = EP + 2
    let fns = TS[(EP + 2) as usize]
    let fne = TE[(EP + 2) as usize]
    let fh = gl_name_hash(fns, fne)
    EP = EP + 4
    // compile outer index
    let slot_outer = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    compile_or()
    if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
    if TK[EP as usize] == 42 { EP = EP + 1 }
    emit_store_var(slot_outer)
    // skip inner [
    if TK[EP as usize] == 41 { EP = EP + 1 }
    // compile inner index
    let slot_inner = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    compile_or()
    if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
    if TK[EP as usize] == 42 { EP = EP + 1 }
    emit_store_var(slot_inner)
    // skip =
    if TK[EP as usize] == 16 { EP = EP + 1 }
    // compile RHS value
    compile_or()
    let slot_val = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var(slot_val)
    // resolve field
    ST_QUERY_NS = fns
    ST_QUERY_NE = fne
    let si = resolve_field_struct_index(ns, ne, fh)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if si < 0 {
        tc_error(field_tok, "unknown field access")
        return
    }
    if st_private_access_denied(si, field_tok) {
        tc_error_hard(field_tok, "private struct field access")
        return
    }
                    ST_QUERY_NS = fns
                    ST_QUERY_NE = fne
    let foff = st_field_offset(si, fh)
    let fty = st_field_ty(si, fh)
    let fhash = st_field_hash(si, fh)
    ST_QUERY_NS = -1
    ST_QUERY_NE = -1
    if fty != 8 {
        tc_error(field_tok, "double-indexed field requires array field")
        return
    }
    let inner_hash = arr_hash_elem_hash(fhash)
    if inner_hash == 0 {
        tc_error(field_tok, "field element is not a nested array type")
        return
    }
    let inner_esiz = arr_hash_esiz(inner_hash)
    let outer_stride = arr_storage_slots(inner_hash) * 8
    // load base address of struct variable
    let slot = var_find(ns, ne)
    if slot >= 0 { emit_load_var(slot) }
    else {
        let gi = gl_find(ns, ne)
        if gi >= 0 {
            let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
            em(0x48); em(0xb8); em64(addr)
        } else {
            tc_undefined_var(name_tok)
            em(0x31); em(0xc0)
        }
    }
    // rax = base; add field offset: rax = base + foff (pointer to outer array)
    if foff != 0 { em(0x48); em(0x8d); em(0x80); em32(foff) }
    // load inner-array pointer: [outer_base + outer_idx * 8]
    // rax = outer array base, load outer_idx into rcx
    emit_load_var(slot_outer)                           // rax = outer_idx
    em(0x48); em(0x89); em(0xc1)                        // mov rcx, rax (outer_idx)
    // need outer_base again — save it first via a temp slot
    let slot_outer_base = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    // reload outer array base
    let slot2 = var_find(ns, ne)
    if slot2 >= 0 { emit_load_var(slot2) }
    else {
        let gi2 = gl_find(ns, ne)
        if gi2 >= 0 {
            let addr2 = GL_BSS_BASE + GL[(gi2 * 4 + 1) as usize]
            em(0x48); em(0xb8); em64(addr2)
        } else {
            em(0x31); em(0xc0)
        }
    }
    if foff != 0 { em(0x48); em(0x8d); em(0x80); em32(foff) }
    emit_store_var(slot_outer_base)                     // save outer array base
    // load inner array pointer: [outer_base + outer_idx * 8]
    emit_load_var(slot_outer_base)                      // rax = outer array base
    em(0x48); em(0x8b); em(0x04); em(0xc8)              // mov rax, [rax + rcx*8]
    // rax = inner array pointer; save it
    let slot_inner_ptr = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var(slot_inner_ptr)
    // load inner_idx into rcx
    emit_load_var(slot_inner)
    em(0x48); em(0x89); em(0xc1)                        // mov rcx, rax (inner_idx)
    // load val into rdx
    emit_load_var(slot_val)
    em(0x48); em(0x89); em(0xc2)                        // mov rdx, rax (val)
    // reload inner array pointer into rax
    emit_load_var(slot_inner_ptr)
    // store: [rax + rcx * inner_esiz] = rdx
    if inner_esiz == 8 {
        em(0x48); em(0x89); em(0x14); em(0xc8)          // mov [rax + rcx*8], rdx
    } else {
        em(0x88); em(0x14); em(0x08)                    // mov [rax + rcx], dl
    }
}

fn compile_field_array_store_a64() with IO, Mut, Panic, Div {
    let name_tok = EP
    let ns = TS[EP as usize]; let ne = TE[EP as usize]
    let field_tok = EP + 2
    let fns = TS[(EP + 2) as usize]; let fne = TE[(EP + 2) as usize]
    let fh = gl_name_hash(fns, fne)
    EP = EP + 4
    compile_or_a64()
    if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
    if TK[EP as usize] == 42 { EP = EP + 1 }
    if TK[EP as usize] == 16 { EP = EP + 1 }
    emit_push_a64()
    compile_or_a64()
    let rhs_ty = EXPR_TY
    let rhs_ty_hash = EXPR_TY_HASH
    let si = resolve_field_struct_index(ns, ne, fh)
    if si < 0 {
        tc_error(field_tok, "unknown field access")
        emit_pop_x1_a64()
        return
    }
    if st_private_access_denied(si, field_tok) {
        tc_error_hard(field_tok, "private struct field access")
        emit_pop_x1_a64()
        return
    }
                    ST_QUERY_NS = fns
                    ST_QUERY_NE = fne
    let foff = st_field_offset(si, fh)
    let fty = st_field_ty(si, fh)
    let fhash = st_field_hash(si, fh)
                    ST_QUERY_NS = -1
                    ST_QUERY_NE = -1
    if fty != 8 {
        tc_error(field_tok, "indexed field store requires array field")
        emit_pop_x1_a64()
        return
    }
    if ty_eq(arr_hash_elem_ty(fhash), arr_hash_elem_hash(fhash), rhs_ty, rhs_ty_hash) == false {
        tc_error(EP - 1, "assignment type mismatch")
    }
    materialize_aggregate_array_element_a64(fhash)
    em32(0xAA0003EA)
    emit_pop_x1_a64()
    let slot = var_find(ns, ne)
    if slot >= 0 { emit_load_var_a64(slot) }
    else {
        let gi = gl_find(ns, ne)
        if gi >= 0 { emit_image_addr_a64(GL_BSS_BASE + GL[(gi * 4 + 1) as usize]) }
        else { tc_undefined_var(name_tok); em32(0xD2800000) }
    }
    if foff != 0 {
        emit_imm64_reg_a64(11, foff)
        em32(0x8B0B0000)
    }
    if arr_hash_esiz(fhash) == 8 { em32(0xF821780A) }
    else { em32(0x3821680A) }
}

