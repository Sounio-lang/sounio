            cl_fpi_a = cl_fpi_a + 1
        }
        patch_branch_a64(jmp_patch_a, CL)
        let saved_cap_count_a = CL_CAP_COUNT
        VAR_COUNT = save_vc_a
        NEXT_SLOT = save_ns_a
        LOOP_DEPTH = save_ld_a
        BREAK_COUNT = save_bc_a
        CURRENT_RET_TY = save_ret_ty_a
        CURRENT_RET_HASH = save_ret_hash_a
        CURRENT_SRET_SLOT = save_sret_slot_a
        A64_FRAME_PATCH_COUNT = save_a64_fpc
        svi_a = 0
        while svi_a < save_vc_a {
            VAR_NS[svi_a as usize] = CL_SAVE_NS[svi_a as usize]
            VAR_NE[svi_a as usize] = CL_SAVE_NE[svi_a as usize]
            VAR_SLOT[svi_a as usize] = CL_SAVE_SL[svi_a as usize]
            VAR_LEN_SLOT[svi_a as usize] = CL_SAVE_LS[svi_a as usize]
            VAR_ALEN[svi_a as usize] = CL_SAVE_AL[svi_a as usize]
            VAR_ESIZ[svi_a as usize] = CL_SAVE_ES[svi_a as usize]
            VAR_IS_F64[svi_a as usize] = CL_SAVE_F64[svi_a as usize]
            VAR_IS_CLOSURE[svi_a as usize] = CL_SAVE_ISCL[svi_a as usize]
            VAR_MUT[svi_a as usize] = CL_SAVE_MUT[svi_a as usize]
            VAR_UNIT[svi_a as usize] = CL_SAVE_UNIT[svi_a as usize]
            VAR_LINEAR[svi_a as usize] = CL_SAVE_LINEAR[svi_a as usize]
            VAR_USED[svi_a as usize] = CL_SAVE_USED[svi_a as usize]
            VAR_TY[svi_a as usize] = CL_SAVE_TY[svi_a as usize]
            VAR_TY_HASH[svi_a as usize] = CL_SAVE_TH[svi_a as usize]
            svi_a = svi_a + 1
