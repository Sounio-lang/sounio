    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)
    em(0xf2); em(0x0f); em(0x5e); em(0xc1)
    em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
}

// β¹⁰ — FO GUM Var(L−R) = Σ_k (sL_k − sR_k)² · σ²_k into a new stack slot.
// Cancels identical product paths (a·b − a·b → 0) that slot-identity cannot see.
fn emit_fo_channel_contrib_sub_x86(acc_slot: i64, ls: i64, rs: i64, ch: i64) with Mut {
    if ch < 0 || ch >= 8 { return }
    let iv = CHANNEL_INPUT_VAR_SLOT[ch as usize]
    if iv < 0 { return }
    if ls < 0 && rs < 0 { return }
    if ls >= 0 { emit_load_var(ls) } else { emit_imm64(0) }
    em(0x50)
    if rs >= 0 { emit_load_var(rs) } else { emit_imm64(0) }
    em(0x59)
    emit_f64_sub_from_rcx_rax_x86()
    // rax = ds; square
    em(0x50)
    em(0x59)
    emit_f64_mul_from_rcx_rax_x86()
    // rax = ds²; × σ²_k
    em(0x50)
    emit_load_var(iv)
    em(0x59)
    emit_f64_mul_from_rcx_rax_x86()
    // rax = contrib; acc += contrib
    em(0x50)
    emit_load_var(acc_slot)
    em(0x59)
    emit_f64_add_from_rcx_rax_x86()
    emit_store_var(acc_slot)
}

fn emit_fo_var_from_sens_diff_sub_x86(
    ls0: i64, ls1: i64, ls2: i64, ls3: i64, ls4: i64, ls5: i64, ls6: i64, ls7: i64,
    rs0: i64, rs1: i64, rs2: i64, rs3: i64, rs4: i64, rs5: i64, rs6: i64, rs7: i64
) -> i64 with Mut {
    let out = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_imm64(0)
    emit_store_var(out)
    emit_fo_channel_contrib_sub_x86(out, ls0, rs0, 0)
    emit_fo_channel_contrib_sub_x86(out, ls1, rs1, 1)
    emit_fo_channel_contrib_sub_x86(out, ls2, rs2, 2)
    emit_fo_channel_contrib_sub_x86(out, ls3, rs3, 3)
    emit_fo_channel_contrib_sub_x86(out, ls4, rs4, 4)
    emit_fo_channel_contrib_sub_x86(out, ls5, rs5, 5)
    emit_fo_channel_contrib_sub_x86(out, ls6, rs6, 6)
    emit_fo_channel_contrib_sub_x86(out, ls7, rs7, 7)
    return out
}

// β¹¹ — FO Var(y) = Σ_k s_k(y)² · σ²_k from live sensitivity shadows.
// Fixes independent-product under-count on a·a (needs 4a²σ², not 2a²σ²).
fn emit_fo_channel_contrib_sq_x86(acc_slot: i64, s_slot: i64, ch: i64) with Mut {
    if ch < 0 || ch >= 8 { return }
    let iv = CHANNEL_INPUT_VAR_SLOT[ch as usize]
    if iv < 0 { return }
    if s_slot < 0 { return }
    emit_load_var(s_slot)
    em(0x50)
    em(0x59)
    emit_f64_mul_from_rcx_rax_x86()
    em(0x50)
    emit_load_var(iv)
    em(0x59)
    emit_f64_mul_from_rcx_rax_x86()
    em(0x50)
    emit_load_var(acc_slot)
    em(0x59)
    emit_f64_add_from_rcx_rax_x86()
    emit_store_var(acc_slot)
}

fn emit_fo_var_from_sens_x86(
    s0: i64, s1: i64, s2: i64, s3: i64, s4: i64, s5: i64, s6: i64, s7: i64
) -> i64 with Mut {
    let out = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_imm64(0)
    emit_store_var(out)
    emit_fo_channel_contrib_sq_x86(out, s0, 0)
    emit_fo_channel_contrib_sq_x86(out, s1, 1)
    emit_fo_channel_contrib_sq_x86(out, s2, 2)
    emit_fo_channel_contrib_sq_x86(out, s3, 3)
    emit_fo_channel_contrib_sq_x86(out, s4, 4)
    emit_fo_channel_contrib_sq_x86(out, s5, 5)
    emit_fo_channel_contrib_sq_x86(out, s6, 6)
    emit_fo_channel_contrib_sq_x86(out, s7, 7)
    return out
}

fn emit_load_operand_value_x86(slot: i64, ty: i64, ty_hash: i64, tok: i64) with IO, Mut, Panic, Div {
    emit_load_var(slot)
    if knowledge_hash_is(ty_hash) {
        em(0x48); em(0x8b); em(0x00)
        let inner_ty = knowledge_hash_inner_ty(ty_hash)
        if inner_ty != 2 {
            if ty_is_numeric(inner_ty) { emit_i64_to_f64_in_rax_x86() }
            else {
                tc_error(tok, "Knowledge arithmetic requires numeric inner type")
                em(0x31); em(0xc0)
            }
        }
        return
    }
    if ty != 2 {
        if ty_is_numeric(ty) { emit_i64_to_f64_in_rax_x86() }
        else {
            tc_error(tok, "Knowledge arithmetic requires numeric operands")
            em(0x31); em(0xc0)
        }
    }
}

fn emit_load_operand_variance_x86(slot: i64, ty_hash: i64) with Mut {
    if knowledge_hash_is(ty_hash) {
        emit_load_var(slot)
        em(0x48); em(0x8b); em(0x40); em(8)
        return
    }
    em(0x31); em(0xc0)
}

fn emit_load_operand_confidence_x86(slot: i64, ty_hash: i64) with Mut {
    if knowledge_hash_is(ty_hash) {
        emit_load_var(slot)
        em(0x48); em(0x8b); em(0x40); em(16)
        return
    }
    emit_imm64(4607182418800017408)
}

fn emit_min_positive_f64_bits_x86() with Mut {
    em(0x48); em(0x39); em(0xc1)
    em(0x48); em(0x0f); em(0x4e); em(0xc1)
}

fn compile_knowledge_addsub_x86(op_tok: i64, op: i64, left_ty: i64, left_hash: i64, right_ty: i64, right_hash: i64) with IO, Mut, Panic, Div {
    let rhs_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var(rhs_slot)
    let lhs_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    em(0x58)
    emit_store_var(lhs_slot)
    let base_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 3

    emit_load_operand_value_x86(lhs_slot, left_ty, left_hash, op_tok)
    em(0x50)
    emit_load_operand_value_x86(rhs_slot, right_ty, right_hash, op_tok)
    em(0x59)
    if op == 17 { emit_f64_add_from_rcx_rax_x86() } else { emit_f64_sub_from_rcx_rax_x86() }
    emit_store_var(base_slot + 2)

    emit_load_operand_variance_x86(lhs_slot, left_hash)
    em(0x50)
    emit_load_operand_variance_x86(rhs_slot, right_hash)
    em(0x59)
    emit_f64_add_from_rcx_rax_x86()
    emit_store_var(base_slot + 1)

    emit_load_operand_confidence_x86(lhs_slot, left_hash)
    em(0x50)
    emit_load_operand_confidence_x86(rhs_slot, right_hash)
    em(0x59)
    emit_min_positive_f64_bits_x86()
    emit_store_var(base_slot)

    em(0x48); em(0x8d); em(0x85)
    em32(0 - (base_slot + 2) * 8)
    EXPR_IS_F64 = 0
    EXPR_TY = 0
    EXPR_TY_HASH = knowledge_binary_result_hash(op, left_ty, left_hash, right_ty, right_hash)
}

fn compile_knowledge_muldiv_x86(op_tok: i64, op: i64, left_ty: i64, left_hash: i64, right_ty: i64, right_hash: i64) with IO, Mut, Panic, Div {
    let rhs_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var(rhs_slot)
    let lhs_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    em(0x58)
    emit_store_var(lhs_slot)
    let base_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 3

    emit_load_operand_value_x86(lhs_slot, left_ty, left_hash, op_tok)
    em(0x50)
    emit_load_operand_value_x86(rhs_slot, right_ty, right_hash, op_tok)
    em(0x59)
    if op == 19 { emit_f64_mul_from_rcx_rax_x86() } else { emit_f64_div_from_rcx_rax_x86() }
    emit_store_var(base_slot + 2)

    if op == 19 {
        emit_load_operand_value_x86(lhs_slot, left_ty, left_hash, op_tok)
        em(0x50)
        emit_load_operand_value_x86(lhs_slot, left_ty, left_hash, op_tok)
        em(0x59)
        emit_f64_mul_from_rcx_rax_x86()
        em(0x50)
        emit_load_operand_variance_x86(rhs_slot, right_hash)
        em(0x59)
        emit_f64_mul_from_rcx_rax_x86()
        em(0x50)

        emit_load_operand_value_x86(rhs_slot, right_ty, right_hash, op_tok)
        em(0x50)
        emit_load_operand_value_x86(rhs_slot, right_ty, right_hash, op_tok)
        em(0x59)
        emit_f64_mul_from_rcx_rax_x86()
        em(0x50)
        emit_load_operand_variance_x86(lhs_slot, left_hash)
        em(0x59)
        emit_f64_mul_from_rcx_rax_x86()

        em(0x59)
        emit_f64_add_from_rcx_rax_x86()
    } else {
        emit_load_operand_variance_x86(lhs_slot, left_hash)
        em(0x50)
        emit_load_operand_value_x86(rhs_slot, right_ty, right_hash, op_tok)
        em(0x50)
        emit_load_operand_value_x86(rhs_slot, right_ty, right_hash, op_tok)
        em(0x59)
        emit_f64_mul_from_rcx_rax_x86()
        em(0x59)
        emit_f64_div_from_rcx_rax_x86()
        em(0x50)

        emit_load_operand_value_x86(lhs_slot, left_ty, left_hash, op_tok)
        em(0x50)
        emit_load_operand_value_x86(lhs_slot, left_ty, left_hash, op_tok)
        em(0x59)
        emit_f64_mul_from_rcx_rax_x86()
        em(0x50)
        emit_load_operand_variance_x86(rhs_slot, right_hash)
        em(0x59)
        emit_f64_mul_from_rcx_rax_x86()
        em(0x50)

        emit_load_operand_value_x86(rhs_slot, right_ty, right_hash, op_tok)
        em(0x50)
        emit_load_operand_value_x86(rhs_slot, right_ty, right_hash, op_tok)
        em(0x59)
        emit_f64_mul_from_rcx_rax_x86()
        em(0x50)
        emit_load_operand_value_x86(rhs_slot, right_ty, right_hash, op_tok)
        em(0x50)
        emit_load_operand_value_x86(rhs_slot, right_ty, right_hash, op_tok)
        em(0x59)
        emit_f64_mul_from_rcx_rax_x86()
        em(0x59)
        emit_f64_mul_from_rcx_rax_x86()

        em(0x59)
        emit_f64_div_from_rcx_rax_x86()
        em(0x59)
        emit_f64_add_from_rcx_rax_x86()
    }
    emit_store_var(base_slot + 1)

    emit_load_operand_confidence_x86(lhs_slot, left_hash)
    em(0x50)
    emit_load_operand_confidence_x86(rhs_slot, right_hash)
    em(0x59)
    emit_min_positive_f64_bits_x86()
    emit_store_var(base_slot)

    em(0x48); em(0x8d); em(0x85)
    em32(0 - (base_slot + 2) * 8)
    EXPR_IS_F64 = 0
    EXPR_TY = 0
    EXPR_TY_HASH = knowledge_binary_result_hash(op, left_ty, left_hash, right_ty, right_hash)
}

// ─── aarch64 twins: Knowledge<T> arithmetic (issue: a64 had none of this at
// all — compile_additive_a64()/compile_multiplicative_a64() never checked
// knowledge_hash_is and fell into plain scalar add/sub/mul/div on the raw
// Knowledge<T> POINTER values, producing a garbage "sum" that segfaulted on
// the next .value/.uncertainty/.confidence field access). Ported
// instruction-for-instruction from the x86-64 originals above, reusing the
// already-correct aarch64 primitives from elsewhere in this file
// (emit_f64_binop_a64 for the SSE2-equivalent ops, the same
// value@0/variance@8/confidence@16 field layout already used by working
// Knowledge<T> field access on a64).

fn emit_i64_to_f64_in_x0_a64() with Mut {
    em32(0x9E620000)  // scvtf d0, x0
    em32(0x9E660000)  // fmov x0, d0
}

fn emit_load_operand_value_a64(slot: i64, ty: i64, ty_hash: i64, tok: i64) with IO, Mut, Panic, Div {
    emit_load_var_a64(slot)
    if knowledge_hash_is(ty_hash) {
        em32(0xF9400000)  // ldr x0, [x0] (.value)
        let inner_ty = knowledge_hash_inner_ty(ty_hash)
        if inner_ty != 2 {
            if ty_is_numeric(inner_ty) { emit_i64_to_f64_in_x0_a64() }
            else {
                tc_error(tok, "Knowledge arithmetic requires numeric inner type")
                em32(0xD2800000)  // mov x0, #0
            }
        }
        return
    }
    if ty != 2 {
        if ty_is_numeric(ty) { emit_i64_to_f64_in_x0_a64() }
        else {
            tc_error(tok, "Knowledge arithmetic requires numeric operands")
            em32(0xD2800000)
        }
    }
}

fn emit_load_operand_variance_a64(slot: i64, ty_hash: i64) with Mut, Panic, Div {
    if knowledge_hash_is(ty_hash) {
        emit_load_var_a64(slot)
        em32(0xF9400400)  // ldr x0, [x0, #8] (variance)
        return
    }
    em32(0xD2800000)  // mov x0, #0 (0.0 bit pattern)
}

fn emit_load_operand_confidence_a64(slot: i64, ty_hash: i64) with Mut, Panic, Div {
    if knowledge_hash_is(ty_hash) {
        emit_load_var_a64(slot)
        em32(0xF9400800)  // ldr x0, [x0, #16] (confidence)
        return
    }
    emit_imm64_reg_a64(0, 4607182418800017408)  // x0 = 1.0 bits
}

// x1, x0 are two POSITIVE f64 bit patterns — for positive floats, integer
// comparison of the bit pattern preserves float ordering, so this avoids a
// real float comparison. Result (min) left in x0. Branch-based rather than
// CSEL to reuse the already-proven conditional-branch-and-patch pattern used
// throughout this file's a64 codegen (see aarch64-codegen-authoring-gotchas).
fn emit_min_positive_f64_bits_a64() with Mut, Panic {
    em32(0xEB00003F)  // cmp x1, x0
    let skip_off = CL
    em32(0x5400000C)  // b.gt skip (cond=gt=0xC): if x1 > x0, x0 already the min
    em32(0xAA0103E0)  // mov x0, x1
    patch_branch_a64(skip_off, CL)
}

// x0 = sqrt(x0), f64 bits in/out. a64 mirror of emit_sqrt_builtin_x86 (used
// by the .uncertainty field-read accessor below — .uncertainty surfaces
// sqrt(variance), variance is what's actually stored at offset 8).
fn emit_sqrt_builtin_a64() with Mut {
    em32(0x9E670000)  // fmov d0, x0
    em32(0x1E61C000)  // fsqrt d0, d0
    em32(0x9E660000)  // fmov x0, d0
}

fn compile_knowledge_addsub_a64(op_tok: i64, op: i64, left_ty: i64, left_hash: i64, right_ty: i64, right_hash: i64) with IO, Mut, Panic, Div {
    let rhs_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var_a64(rhs_slot)
    let lhs_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_pop_x0_a64()
    emit_store_var_a64(lhs_slot)
    let base_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 3

    emit_load_operand_value_a64(lhs_slot, left_ty, left_hash, op_tok)
    emit_push_a64()
    emit_load_operand_value_a64(rhs_slot, right_ty, right_hash, op_tok)
    emit_pop_x1_a64()
    if op == 17 { emit_f64_binop_a64(0x1E612800) } else { emit_f64_binop_a64(0x1E613800) }
    emit_store_var_a64(base_slot + 2)

    emit_load_operand_variance_a64(lhs_slot, left_hash)
    emit_push_a64()
    emit_load_operand_variance_a64(rhs_slot, right_hash)
    emit_pop_x1_a64()
    emit_f64_binop_a64(0x1E612800)
    emit_store_var_a64(base_slot + 1)

    emit_load_operand_confidence_a64(lhs_slot, left_hash)
    emit_push_a64()
    emit_load_operand_confidence_a64(rhs_slot, right_hash)
    emit_pop_x1_a64()
    emit_min_positive_f64_bits_a64()
    emit_store_var_a64(base_slot)

    emit_lea_var_a64(base_slot + 2)
    EXPR_IS_F64 = 0
    EXPR_TY = 0
    EXPR_TY_HASH = knowledge_binary_result_hash(op, left_ty, left_hash, right_ty, right_hash)
}

fn compile_knowledge_muldiv_a64(op_tok: i64, op: i64, left_ty: i64, left_hash: i64, right_ty: i64, right_hash: i64) with IO, Mut, Panic, Div {
    let rhs_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var_a64(rhs_slot)
    let lhs_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_pop_x0_a64()
    emit_store_var_a64(lhs_slot)
    let base_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 3

    emit_load_operand_value_a64(lhs_slot, left_ty, left_hash, op_tok)
    emit_push_a64()
    emit_load_operand_value_a64(rhs_slot, right_ty, right_hash, op_tok)
    emit_pop_x1_a64()
    if op == 19 { emit_f64_binop_a64(0x1E610800) } else { emit_f64_binop_a64(0x1E611800) }
    emit_store_var_a64(base_slot + 2)

    if op == 19 {
        emit_load_operand_value_a64(lhs_slot, left_ty, left_hash, op_tok)
        emit_push_a64()
        emit_load_operand_value_a64(lhs_slot, left_ty, left_hash, op_tok)
        emit_pop_x1_a64()
        emit_f64_binop_a64(0x1E610800)
        emit_push_a64()
        emit_load_operand_variance_a64(rhs_slot, right_hash)
        emit_pop_x1_a64()
        emit_f64_binop_a64(0x1E610800)
        emit_push_a64()

        emit_load_operand_value_a64(rhs_slot, right_ty, right_hash, op_tok)
        emit_push_a64()
        emit_load_operand_value_a64(rhs_slot, right_ty, right_hash, op_tok)
        emit_pop_x1_a64()
        emit_f64_binop_a64(0x1E610800)
        emit_push_a64()
        emit_load_operand_variance_a64(lhs_slot, left_hash)
        emit_pop_x1_a64()
        emit_f64_binop_a64(0x1E610800)

        emit_pop_x1_a64()
        emit_f64_binop_a64(0x1E612800)
    } else {
        emit_load_operand_variance_a64(lhs_slot, left_hash)
        emit_push_a64()
        emit_load_operand_value_a64(rhs_slot, right_ty, right_hash, op_tok)
        emit_push_a64()
        emit_load_operand_value_a64(rhs_slot, right_ty, right_hash, op_tok)
        emit_pop_x1_a64()
        emit_f64_binop_a64(0x1E610800)
        emit_pop_x1_a64()
        emit_f64_binop_a64(0x1E611800)
        emit_push_a64()

        emit_load_operand_value_a64(lhs_slot, left_ty, left_hash, op_tok)
        emit_push_a64()
        emit_load_operand_value_a64(lhs_slot, left_ty, left_hash, op_tok)
        emit_pop_x1_a64()
        emit_f64_binop_a64(0x1E610800)
        emit_push_a64()
        emit_load_operand_variance_a64(rhs_slot, right_hash)
        emit_pop_x1_a64()
        emit_f64_binop_a64(0x1E610800)
        emit_push_a64()

        emit_load_operand_value_a64(rhs_slot, right_ty, right_hash, op_tok)
        emit_push_a64()
        emit_load_operand_value_a64(rhs_slot, right_ty, right_hash, op_tok)
        emit_pop_x1_a64()
        emit_f64_binop_a64(0x1E610800)
        emit_push_a64()
        emit_load_operand_value_a64(rhs_slot, right_ty, right_hash, op_tok)
        emit_push_a64()
        emit_load_operand_value_a64(rhs_slot, right_ty, right_hash, op_tok)
        emit_pop_x1_a64()
        emit_f64_binop_a64(0x1E610800)
        emit_pop_x1_a64()
        emit_f64_binop_a64(0x1E610800)

        emit_pop_x1_a64()
        emit_f64_binop_a64(0x1E611800)
        emit_pop_x1_a64()
        emit_f64_binop_a64(0x1E612800)
    }
    emit_store_var_a64(base_slot + 1)

    emit_load_operand_confidence_a64(lhs_slot, left_hash)
    emit_push_a64()
    emit_load_operand_confidence_a64(rhs_slot, right_hash)
    emit_pop_x1_a64()
    emit_min_positive_f64_bits_a64()
    emit_store_var_a64(base_slot)

    emit_lea_var_a64(base_slot + 2)
    EXPR_IS_F64 = 0
    EXPR_TY = 0
    EXPR_TY_HASH = knowledge_binary_result_hash(op, left_ty, left_hash, right_ty, right_hash)
}

// ─── Built-in function emitters ───

// print_int: rax = value → emit decimal digits + write syscall
fn emit_print_int() with Mut {
    // sub rsp, 32; mov rcx, rsp+31 (end of buffer); mov byte [rcx], 10 (\n); dec rcx
    // div loop: cdq; div 10; add dl, '0'; mov [rcx], dl; dec rcx; test rax,rax; jnz loop
    // lea rsi, [rcx+1]; mov rdx, rsp+32-rsi; write(1, rsi, rdx); add rsp, 32
    em(0x48); em(0x83); em(0xec); em(32)  // sub rsp, 32
    em(0x48); em(0x8d); em(0x4c); em(0x24); em(31)  // lea rcx, [rsp+31]
    // No baked-in '\n'. It used to be written here, which made print(x) and
    // print_int(x) emit a newline nobody asked for and made println(x) correct
    // only by accident. println now appends it explicitly. Same buffer shape as
    // emit_print_u64_no_nl_x86 below: digits start at [rsp+31], end stays
    // rsp+32, so the length math is unchanged. (#1573)
    // Handle negative: if rax < 0, negate, set r8=1
    em(0x4d); em(0x31); em(0xc0)  // xor r8, r8
    em(0x48); em(0x85); em(0xc0)  // test rax, rax
    em(0x79); em(0x06)  // jns +6
    em(0x48); em(0xf7); em(0xd8)  // neg rax
    em(0x49); em(0xff); em(0xc0)  // inc r8
    // div loop
    let loop_top = CL
    em(0x48); em(0x31); em(0xd2)  // xor rdx, rdx
    em(0x48); em(0xc7); em(0xc6); em32(10)  // mov rsi, 10
    em(0x48); em(0xf7); em(0xf6)  // div rsi (rax=quot, rdx=rem)
    em(0x80); em(0xc2); em(48)   // add dl, '0'
    em(0x88); em(0x11)            // mov [rcx], dl
    em(0x48); em(0xff); em(0xc9)  // dec rcx
    em(0x48); em(0x85); em(0xc0)  // test rax, rax
    em(0x0f); em(0x85); em32(loop_top - (CL + 4))  // jnz loop_top
    // If negative, add '-'
    em(0x4d); em(0x85); em(0xc0)  // test r8, r8
    em(0x74); em(0x06)  // jz +6
    em(0xc6); em(0x01); em(45)  // mov byte [rcx], '-'
    em(0x48); em(0xff); em(0xc9)  // dec rcx
    // rcx points to last written byte-1; string starts at rcx+1
    em(0x48); em(0xff); em(0xc1)  // inc rcx (start of string)
    em(0x48); em(0x89); em(0xce)  // mov rsi, rcx (buf)
    em(0x48); em(0x8d); em(0x54); em(0x24); em(32)  // lea rdx, [rsp+32]
    em(0x48); em(0x29); em(0xca)  // sub rdx, rcx (len = end - start)
    em(0xb8); em32(1)  // mov eax, 1 (sys_write)
    em(0xbf); em32(1)  // mov edi, 1 (stdout)
    em(0x0f); em(0x05)  // syscall
    em(0x48); em(0x83); em(0xc4); em(32)  // add rsp, 32
}

fn emit_print_char_lit_x86(ch: i64) with Mut {
    em(0x48); em(0x83); em(0xec); em(8)
    em(0xc6); em(0x04); em(0x24); em(ch)
    em(0xb8); em32(1)
    em(0xbf); em32(1)
    em(0x48); em(0x89); em(0xe6)
    em(0xba); em32(1)
    em(0x0f); em(0x05)
    em(0x48); em(0x83); em(0xc4); em(8)
}

fn emit_print_u64_no_nl_x86() with Mut {
    em(0x48); em(0x83); em(0xec); em(32)  // sub rsp, 32
    em(0x48); em(0x8d); em(0x4c); em(0x24); em(31)  // lea rcx, [rsp+31]
    em(0x48); em(0x85); em(0xc0)  // test rax, rax
    em(0x75); em(0x08)  // jnz div_loop
    em(0xc6); em(0x01); em(48)  // mov byte [rcx], '0'
    em(0x48); em(0xff); em(0xc9)  // dec rcx
    em(0xeb); em(30)  // jmp after_loop
    let pf_loop_top = CL
    em(0x48); em(0x31); em(0xd2)  // xor rdx, rdx
    em(0x48); em(0xc7); em(0xc6); em32(10)  // mov rsi, 10
    em(0x48); em(0xf7); em(0xf6)  // div rsi
    em(0x80); em(0xc2); em(48)   // add dl, '0'
    em(0x88); em(0x11)            // mov [rcx], dl
    em(0x48); em(0xff); em(0xc9)  // dec rcx
    em(0x48); em(0x85); em(0xc0)  // test rax, rax
    em(0x0f); em(0x85); em32(pf_loop_top - (CL + 4))  // jnz loop
    em(0x48); em(0xff); em(0xc1)  // inc rcx
    em(0x48); em(0x89); em(0xce)  // mov rsi, rcx
    em(0x48); em(0x8d); em(0x54); em(0x24); em(32)  // lea rdx, [rsp+32]
    em(0x48); em(0x29); em(0xca)  // sub rdx, rcx
    em(0xb8); em32(1); em(0xbf); em32(1)
    em(0x0f); em(0x05)
    em(0x48); em(0x83); em(0xc4); em(32)
}

fn emit_print_fixed6_x86() with Mut {
    em(0x48); em(0x83); em(0xec); em(8)
    em(0x48); em(0x31); em(0xd2)
    em(0x48); em(0xb9); em64(100000)
    em(0x48); em(0xf7); em(0xf1)
    em(0x48); em(0x83); em(0xc0); em(48)
    em(0x88); em(0x04); em(0x24)
    em(0x48); em(0x89); em(0xd0)
    em(0x48); em(0x31); em(0xd2)
    em(0x48); em(0xb9); em64(10000)
    em(0x48); em(0xf7); em(0xf1)
    em(0x48); em(0x83); em(0xc0); em(48)
    em(0x88); em(0x44); em(0x24); em(1)
    em(0x48); em(0x89); em(0xd0)
    em(0x48); em(0x31); em(0xd2)
    em(0x48); em(0xb9); em64(1000)
    em(0x48); em(0xf7); em(0xf1)
    em(0x48); em(0x83); em(0xc0); em(48)
    em(0x88); em(0x44); em(0x24); em(2)
    em(0x48); em(0x89); em(0xd0)
    em(0x48); em(0x31); em(0xd2)
    em(0x48); em(0xb9); em64(100)
    em(0x48); em(0xf7); em(0xf1)
    em(0x48); em(0x83); em(0xc0); em(48)
    em(0x88); em(0x44); em(0x24); em(3)
    em(0x48); em(0x89); em(0xd0)
    em(0x48); em(0x31); em(0xd2)
    em(0x48); em(0xb9); em64(10)
    em(0x48); em(0xf7); em(0xf1)
    em(0x48); em(0x83); em(0xc0); em(48)
    em(0x88); em(0x44); em(0x24); em(4)
    em(0x48); em(0x83); em(0xc2); em(48)
    em(0x88); em(0x54); em(0x24); em(5)
    em(0xb8); em32(1); em(0xbf); em32(1)
    em(0x48); em(0x89); em(0xe6)
    em(0xba); em32(6)
    em(0x0f); em(0x05)
    em(0x48); em(0x83); em(0xc4); em(8)
}

fn emit_print_nan_x86() with Mut {
    em(0x48); em(0x83); em(0xec); em(8)
    em(0x48); em(0xb8); em64(7233902)
    em(0x48); em(0x89); em(0x04); em(0x24)
    em(0xb8); em32(1)
    em(0xbf); em32(1)
    em(0x48); em(0x89); em(0xe6)
    em(0xba); em32(3)
    em(0x0f); em(0x05)
    em(0x48); em(0x83); em(0xc4); em(8)
}

// print_f64: rax = f64 bits → dispatch to __native_print_f64_n(x, 6).
// The previous body inlined the conversion via cvttsd2si, which saturates
// for |x| ≥ 2^63 (printing "9223372036854775808" for any 1e24-scale
// input) and silently rounds tiny values to "0.000000". The Sounio-source
// helper handles both via scientific notation; this dispatch keeps the
// API stable while routing through the corrected formatter.
fn emit_print_f64() with Mut, Panic, Div {
    em(0x50)                                 // push rax  (f64 bits)
    em(0x48); em(0xb8); em64(6)              // mov rax, 6
    em(0x50)                                 // push rax  (decimals=6)
    let fmt_fi = fn_find_lit("__native_print_f64_n")
    if fmt_fi >= 0 {
        emit_direct_fn_call_x86(fmt_fi, 2)
    } else {
        emit_drop_call_args_x86(2)
        em(0x31); em(0xc0)
    }
}

fn emit_read_i64() with Mut {
    em(0x48); em(0x89); em(0xc1)            // mov rcx, rax (index)
    em(0x58)                                // pop rax (buf)
    em(0x48); em(0x8b); em(0x04); em(0xc8)  // mov rax, [rax + rcx*8]
}

fn emit_read_f64() with Mut {
    em(0x48); em(0x89); em(0xc1)            // mov rcx, rax (index)
    em(0x58)                                // pop rax (buf)
    em(0xf2); em(0x0f); em(0x10); em(0x04); em(0xc8)  // movsd xmm0, [rax + rcx*8]
    em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)  // movq rax, xmm0
}

fn emit_write_i64() with Mut {
    // stack = [ptr, index], rax = value
    em(0x48); em(0x89); em(0xc2)             // mov rdx, rax (value)
    em(0x59)                                  // pop rcx (index)
    em(0x58)                                  // pop rax (ptr)
    em(0x48); em(0x89); em(0x14); em(0xc8)   // mov [rax + rcx*8], rdx
}

fn emit_write_f64() with Mut {
    // stack = [ptr, index], rax = f64 value bits
    em(0x48); em(0x89); em(0xc2)             // mov rdx, rax (f64 bits)
    em(0x59)                                  // pop rcx (index)
    em(0x58)                                  // pop rax (ptr)
    em(0x48); em(0x89); em(0x14); em(0xc8)   // mov [rax + rcx*8], rdx
}

fn emit_write_i64_a64() with Mut {
    // stack = [ptr, index], x0 = value
    em32(0xAA0003EA)   // mov x10, x0 (value)
    emit_pop_x1_a64()  // x1 = index
    emit_pop_x0_a64()  // x0 = ptr
    em32(0xF82178AA)   // str x10, [x0, x1, lsl #3]
}

fn emit_write_f64_a64() with Mut {
    // stack = [ptr, index], x0 = f64 value bits
    em32(0xAA0003EA)   // mov x10, x0 (f64 bits)
    emit_pop_x1_a64()  // x1 = index
    emit_pop_x0_a64()  // x0 = ptr
    em32(0xF82178AA)   // str x10, [x0, x1, lsl #3]
}

// arg_count: load argc from the saved stack pointer
// At program entry, [rsp] = argc, [rsp+8] = argv[0], etc.
// We save rsp at entry in a global.
var ENTRY_RSP_OFF: i64 = 0

fn emit_arg_count() with Mut {
    let argc_addr = GL_BSS_BASE - 16   // argc at BSS base (before globals)
    em(0x48); em(0xb8); em64(argc_addr)
    em(0x48); em(0x8b); em(0x00)  // mov rax, [rax]
}

fn emit_get_arg() with Mut {
    // rax = arg index. argv stored at BSS+8. argv[i] = [argv_base + i*8]
    let argv_addr = GL_BSS_BASE - 8    // argv at BSS base + 8
    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (index)
    em(0x48); em(0xb8); em64(argv_addr)
    em(0x48); em(0x8b); em(0x00)  // mov rax, [rax] = argv base
    em(0x48); em(0x8b); em(0x04); em(0xc8)  // mov rax, [rax + rcx*8]
}

fn emit_str_len() with Mut {
    // rax = string ptr; count until null byte
    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (ptr)
    em(0x48); em(0x31); em(0xc0)  // xor rax, rax (count=0)
    let top = CL
    em(0x80); em(0x3c); em(0x01); em(0x00)  // cmp byte [rcx+rax], 0
    em(0x74); em(0x04)  // je done (+4)
    em(0x48); em(0xff); em(0xc0)  // inc rax
    em(0xeb); em(0xf5 as i64 & 0xFF)  // jmp top (relative back)
    // done: rax = length
}

fn emit_print_char_x86() with Mut {
    em(0x48); em(0x83); em(0xec); em(8)
    em(0x88); em(0x04); em(0x24)
    em(0xb8); em32(1)
    em(0xbf); em32(1)
    em(0x48); em(0x89); em(0xe6)
    em(0xba); em32(1)
    em(0x0f); em(0x05)
    em(0x48); em(0x83); em(0xc4); em(8)
}

fn emit_str_eq_regs_x86() with Mut {
    em(0x48); em(0x89); em(0xcf)  // mov rdi, rcx
    em(0x48); em(0x89); em(0xc6)  // mov rsi, rax
    em(0x48); em(0x0f); em(0xb6); em(0x07)  // movzx rax, byte [rdi]
    em(0x3a); em(0x06)                      // cmp al, [rsi]
    em(0x75); em(12)                        // jne not_equal
    em(0x84); em(0xc0)                      // test al, al
    em(0x74); em(13)                        // jz equal
    em(0x48); em(0xff); em(0xc7)            // inc rdi
    em(0x48); em(0xff); em(0xc6)            // inc rsi
    em(0xeb); em(0xec as i64 & 0xFF)        // jmp loop
    em(0x48); em(0x31); em(0xc0)            // not_equal: xor rax, rax
    em(0xeb); em(7)                         // jmp done
    em(0x48); em(0xc7); em(0xc0); em32(1)   // equal: mov rax, 1
}

// arm64 twin of emit_str_eq_regs_x86: compare NUL-terminated strings at x1 and x0,
// result (0/1) in x0.
fn emit_str_eq_regs_a64() with Mut {
    em32(0x39400029)  // loop: ldrb w9, [x1]
    em32(0x3940000A)  //       ldrb w10, [x0]
    em32(0x6B0A013F)  //       cmp w9, w10
    em32(0x540000A1)  //       b.ne +5 (not_equal)
    em32(0x340000C9)  //       cbz w9, +6 (equal)
    em32(0x91000421)  //       add x1, x1, #1
    em32(0x91000400)  //       add x0, x0, #1
    em32(0x17FFFFF9)  //       b -7 (loop)
    em32(0xD2800000)  // not_equal: mov x0, #0
    em32(0x14000002)  //       b +2 (done)
    em32(0xD2800020)  // equal: mov x0, #1
    // done:
}

fn emit_starts_with_regs_x86() with Mut {
    em(0x48); em(0x89); em(0xcf)  // mov rdi, rcx
    em(0x48); em(0x89); em(0xc6)  // mov rsi, rax
    em(0x48); em(0x0f); em(0xb6); em(0x06)  // movzx rax, byte [rsi]
    em(0x84); em(0xc0)                      // test al, al
    em(0x74); em(12)                        // jz match
    em(0x3a); em(0x07)                      // cmp al, [rdi]
    em(0x75); em(17)                        // jne no_match
    em(0x48); em(0xff); em(0xc7)            // inc rdi
    em(0x48); em(0xff); em(0xc6)            // inc rsi
    em(0xeb); em(0xec as i64 & 0xFF)        // jmp loop
    em(0x48); em(0xc7); em(0xc0); em32(1)   // match: mov rax, 1
    em(0xeb); em(3)                         // jmp done
    em(0x48); em(0x31); em(0xc0)            // no_match: xor rax, rax
}

// arm64 twin of emit_starts_with_regs_x86: does the string at x1 start with the
// prefix at x0?  Iterates the prefix (x0); result (0/1) in x0.
fn emit_starts_with_regs_a64() with Mut {
    em32(0x3940000A)  // loop: ldrb w10, [x0]  (prefix byte)
    em32(0x340000EA)  //       cbz w10, +7 (match — prefix exhausted)
    em32(0x39400029)  //       ldrb w9, [x1]   (string byte)
    em32(0x6B09015F)  //       cmp w10, w9
    em32(0x540000C1)  //       b.ne +6 (no_match)
    em32(0x91000421)  //       add x1, x1, #1
    em32(0x91000400)  //       add x0, x0, #1
    em32(0x17FFFFF9)  //       b -7 (loop)
    em32(0xD2800020)  // match: mov x0, #1
    em32(0x14000002)  //       b +2 (done)
    em32(0xD2800000)  // no_match: mov x0, #0
    // done:
}

// Copy x2 bytes from [x1] to [x0], advancing x0 and x1 (x0 ends past the region).
fn emit_memcpy_a64() with Mut {
    em32(0xB40000E2)  // loop: cbz x2, +7 (done)
    em32(0x39400029)  //       ldrb w9, [x1]
    em32(0x39000009)  //       strb w9, [x0]
    em32(0x91000421)  //       add x1, x1, #1
    em32(0x91000400)  //       add x0, x0, #1
    em32(0xD1000442)  //       sub x2, x2, #1
    em32(0x17FFFFFA)  //       b -6 (loop)
    // done:
}

// arm64 twin of emit_str_concat_slots_x86: result string ptr in x0.
fn emit_str_concat_slots_a64(slot_a: i64, slot_b: i64) with Mut, Panic, Div {
    let slot_len_a = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let slot_len_b = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let slot_res = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let slot_dst = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    // len_a = str_len(a); len_b = str_len(b)
    emit_load_var_a64(slot_a); emit_str_len_a64(); emit_store_var_a64(slot_len_a)
    emit_load_var_a64(slot_b); emit_str_len_a64(); emit_store_var_a64(slot_len_b)
    // total = len_a + len_b + 1; buffer = heap_alloc(total)
    emit_load_var_a64(slot_len_a); emit_push_a64()
    emit_load_var_a64(slot_len_b); emit_pop_x1_a64()  // x0 = len_b, x1 = len_a
    em32(0x8B010000)   // add x0, x0, x1
    em32(0x91000400)   // add x0, x0, #1
    emit_heap_alloc_a64()
    emit_store_var_a64(slot_res)
    // copy a: dst=res, src=a, len=len_a
    emit_load_var_a64(slot_len_a); em32(0xAA0003E2)  // x2 = len_a
    emit_load_var_a64(slot_a); em32(0xAA0003E1)      // x1 = a
    emit_load_var_a64(slot_res)                       // x0 = res
    emit_memcpy_a64()                                 // x0 -> res + len_a
    emit_store_var_a64(slot_dst)
    // copy b: dst=res+len_a, src=b, len=len_b
    emit_load_var_a64(slot_len_b); em32(0xAA0003E2)  // x2 = len_b
    emit_load_var_a64(slot_b); em32(0xAA0003E1)      // x1 = b
    emit_load_var_a64(slot_dst)                       // x0 = res + len_a
    emit_memcpy_a64()                                 // x0 -> end
    em32(0x3900001F)   // strb wzr, [x0]  (NUL terminator)
    emit_load_var_a64(slot_res)                       // return res
}

// arm64 twin of emit_str_slice_range_slots_x86: substring s[start..end], ptr in x0.
fn emit_str_slice_range_slots_a64(slot_s: i64, slot_start: i64, slot_end: i64) with Mut, Panic, Div {
    let slot_len = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    let slot_res = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
    // len = end - start
    emit_load_var_a64(slot_end); emit_push_a64()
    emit_load_var_a64(slot_start); emit_pop_x1_a64()  // x0 = start, x1 = end
    em32(0xCB000020)   // sub x0, x1, x0   (end - start)
    emit_store_var_a64(slot_len)
    // buffer = heap_alloc(len + 1)
    emit_load_var_a64(slot_len)
    em32(0x91000400)   // add x0, x0, #1
    emit_heap_alloc_a64()
    emit_store_var_a64(slot_res)
    // copy: dst=res, src=s+start, len=len
    emit_load_var_a64(slot_len); em32(0xAA0003E2)   // x2 = len
    emit_load_var_a64(slot_s); em32(0xAA0003E1)     // x1 = s
    emit_load_var_a64(slot_start)                    // x0 = start
    em32(0x8B000021)   // add x1, x1, x0   (src = s + start)
    emit_load_var_a64(slot_res)                       // x0 = res (dst)
    emit_memcpy_a64()
    em32(0x3900001F)   // strb wzr, [x0]  (NUL terminator)
    emit_load_var_a64(slot_res)
}

fn emit_bump_counter_rsi_x86(count_off: i64, bytes_off: i64) with Mut {
    // increment [count_off] and add rsi (length) to [bytes_off]; preserves rax/rcx? NO —
    // clobbers rcx; preserves rax and rsi via push/pop.
    em(0x50)                                 // push rax
    em(0x48); em(0x89); em(0xf1)             // mov rcx, rsi
    emit_load_abs_addr_to_rax_x86(GL_BSS_BASE + count_off)
    em(0x48); em(0xff); em(0x00)             // inc qword [rax]
    emit_load_abs_addr_to_rax_x86(GL_BSS_BASE + bytes_off)
    em(0x48); em(0x01); em(0x08)             // add [rax], rcx
    em(0x58)                                 // pop rax
}

fn emit_rtmmap_count_x86() with Mut {
    // rax = requested size at entry; bump count and bytes counters, preserve rax.
    em(0x50)                                 // push rax (size)
    em(0x48); em(0x89); em(0xc1)             // mov rcx, rax (size)
    emit_load_abs_addr_to_rax_x86(GL_BSS_BASE + RTMMAP_COUNT_BSS_OFF)
    em(0x48); em(0xff); em(0x00)             // inc qword [rax]
    emit_load_abs_addr_to_rax_x86(GL_BSS_BASE + RTMMAP_BYTES_BSS_OFF)
    em(0x48); em(0x01); em(0x08)             // add [rax], rcx
    em(0x58)                                 // pop rax (size)
}

fn emit_mmap_len_in_rax_x86() with Mut {
    emit_rtmmap_count_x86()
    em(0x48); em(0x89); em(0xc6)            // mov rsi, rax
    em(0x48); em(0x31); em(0xff)            // xor rdi, rdi
    em(0xba); em32(3)                       // mov edx, 3
    em(0x41); em(0xba); em32(0x22)          // mov r10d, 0x22
    em(0x49); em(0xc7); em(0xc0); em32(-1)  // mov r8, -1
    em(0x4d); em(0x31); em(0xc9)            // xor r9, r9
    em(0xb8); em32(9)                       // mov eax, 9
    em(0x0f); em(0x05)                      // syscall
}

fn emit_heap_alloc_x86() with Mut {
    // rax = requested size. Allocate size+8 via mmap, write header, return user ptr.
    emit_rtmmap_count_x86()
    em(0x48); em(0x83); em(0xc0); em(8)     // add rax, 8 (total = size + header)
    em(0x48); em(0x89); em(0xc6)             // mov rsi, rax (mmap size arg)
    em(0x50)                                  // push rax (save total size)
    em(0x48); em(0x31); em(0xff)             // xor rdi, rdi (addr = NULL)
    em(0xba); em32(3)                        // mov edx, 3 (PROT_READ|PROT_WRITE)
    em(0x41); em(0xba); em32(0x22)           // mov r10d, 0x22 (MAP_PRIVATE|MAP_ANON)
    em(0x49); em(0xc7); em(0xc0); em32(-1)  // mov r8, -1 (fd)
    em(0x4d); em(0x31); em(0xc9)             // xor r9, r9 (offset)
    em(0xb8); em32(9)                        // mov eax, 9 (SYS_mmap)
    em(0x0f); em(0x05)                       // syscall → rax = mmap base
    em(0x59)                                  // pop rcx (total size)
    em(0x48); em(0x89); em(0x08)             // mov [rax], rcx (write header)
    em(0x48); em(0x83); em(0xc0); em(8)     // add rax, 8 (return user ptr)
}

fn emit_heap_free_x86() with Mut {
    // rax = user pointer. Read header at [ptr-8], munmap(base, total).
    em(0x48); em(0x83); em(0xe8); em(8)     // sub rax, 8 (back to mmap base)
    em(0x48); em(0x89); em(0xc7)             // mov rdi, rax (munmap addr)
    em(0x48); em(0x8b); em(0x37)             // mov rsi, [rdi] (total size)
    em(0xb8); em32(11)                       // mov eax, 11 (SYS_munmap)
    em(0x0f); em(0x05)                       // syscall
}

fn emit_heap_realloc_x86() with Mut {
    // stack = [old_user_ptr], rax = new_size.
    // mremap(old_base, old_total, new_total, MREMAP_MAYMOVE)
    emit_rtmmap_count_x86()
    em(0x48); em(0x83); em(0xc0); em(8)     // add rax, 8 (new_total = new_size + header)
    em(0x48); em(0x89); em(0xc2)             // mov rdx, rax (new_total for mremap arg3)
    em(0x49); em(0x89); em(0xc0)             // mov r8, rax (save new_total)
    em(0x5f)                                  // pop rdi (old_user_ptr)
    em(0x48); em(0x83); em(0xef); em(8)     // sub rdi, 8 (old mmap base)
    em(0x48); em(0x8b); em(0x37)             // mov rsi, [rdi] (old_total)
    em(0x41); em(0xba); em32(1)              // mov r10d, 1 (MREMAP_MAYMOVE)
    em(0xb8); em32(25)                       // mov eax, 25 (SYS_mremap)
    em(0x0f); em(0x05)                       // syscall → rax = new mmap base
    em(0x4c); em(0x89); em(0x00)             // mov [rax], r8 (write new header)
    em(0x48); em(0x83); em(0xc0); em(8)     // add rax, 8 (return user ptr)
}

// ============================================================================
// Box::new bump arena (x86) — replaces the per-Box mmap(4096) no-free allocator.
// Each Box::new used to mmap a whole 4KB page (min) and never free it; during a
// self-host build's bodies-lowering phase that accumulated to 42GB RSS -> SIGSEGV
// (job 2478). The arena packs Box allocations 8-byte-aligned into large mmap'd
// chunks; on overflow it re-reserves a fresh chunk (still no free — RSS == total
// packed allocations, independent of chunk count). Chunks are demand-paged, so
// reserving big costs ~0 RSS until touched. emit_heap_alloc_x86 (heap_vec/map,
// explicitly freed) is intentionally NOT routed here.
// ============================================================================
fn arena_chunk_bytes() -> i64 { return 2147483648 }  // 2 GiB per chunk
// Sized so image (~3.3 GiB) + a few chunks stay under the bin/madaros
// wrapper's ulimit -v guards (8 GiB check / 16 GiB run): the adaptive
// refill keeps TOTAL arena unbounded in 2 GiB steps, and packing (the
// job-2478 fix) is what defeats per-Box page waste — chunk size is not
// load-bearing for that.

// Emit (into the produced binary) the one-time arena reservation. Called at main's
// entry, before any Box::new. Aborts the process (exit 42) if the initial mmap fails.
fn emit_ast_arena_init_x86() with Mut, Panic {
    // mmap with ADAPTIVE size: try CHUNK, halve on MAP_FAILED down to 16 MiB
    // (a fixed 8 GiB demand-paged reservation aborted under `ulimit -v` —
    // e.g. the bin/madaros wrapper's 8 GiB guard — even though real RSS is
    // tiny; the actual reserved size lives in rsi and [limit]-[base]).
    em(0x48); em(0xbe); em64(arena_chunk_bytes())   // movabs rsi, CHUNK
    let init_retry = CL
    em(0x48); em(0x31); em(0xff)                    // xor rdi, rdi
    em(0xba); em32(3)                               // mov edx, 3 (PROT_READ|PROT_WRITE)
    em(0x41); em(0xba); em32(0x22)                  // mov r10d, 0x22 (MAP_PRIVATE|MAP_ANON)
    em(0x49); em(0xc7); em(0xc0); em32(0 - 1)       // mov r8, -1 (fd)
    em(0x4d); em(0x31); em(0xc9)                     // xor r9, r9 (offset)
    em(0xb8); em32(9)                               // mov eax, 9 (SYS_mmap)
    em(0x0f); em(0x05)                              // syscall (clobbers rcx/r11; rsi survives)
    em(0x48); em(0x3d); em32(0 - 4096)              // cmp rax, -4096
    em(0x0f); em(0x86)                              // jbe success
    let init_ok = CL
    em32(0)
    em(0x48); em(0xd1); em(0xee)                    // shr rsi, 1
    em(0x48); em(0xb9); em64(16777216)              // movabs rcx, 16 MiB (floor)
    em(0x48); em(0x39); em(0xce)                    // cmp rsi, rcx
    em(0x0f); em(0x83)                              // jae retry
    em32(init_retry - (CL + 4))
    em(0xe9)                                        // jmp abort
    let init_abort = CL
    em32(0)
    patch32(init_ok, CL)
    // Chunk header (16 bytes at chunk base): {prev_base, prev_limit} back-link
    // for __arena_reset's walk-back munmap of dead chunks. Initial chunk links
    // to {0, 0} (chain terminator). User allocations start at base + 16.
    em(0x48); em(0xc7); em(0x00); em32(0)            // mov qword [rax], 0 (prev_base)
    em(0x48); em(0xc7); em(0x40); em(8); em32(0)     // mov qword [rax+8], 0 (prev_limit)
    emit_store_rax_to_abs_qword_x86(GL_BSS_BASE + AST_ARENA_BASE_BSS_OFF)    // [base] = rax (rax preserved)
    em(0x50)                                        // push rax (chunk base)
    em(0x48); em(0x83); em(0xc0); em(16)             // add rax, 16 (skip header)
    emit_store_rax_to_abs_qword_x86(GL_BSS_BASE + AST_ARENA_CURSOR_BSS_OFF)  // [cursor] = base + 16
    em(0x58)                                        // pop rax (chunk base)
    em(0x48); em(0x01); em(0xf0)                     // add rax, rsi -> rax = base + actual
    emit_store_rax_to_abs_qword_x86(GL_BSS_BASE + AST_ARENA_LIMIT_BSS_OFF)   // [limit] = rax
    em(0xe9)                                        // jmp done
    let init_done = CL
    em32(0)
    patch32(init_abort, CL)
    em(0xbf); em32(42)                              // mov edi, 42 (distinct exit code)
    em(0xb8); em32(60)                              // mov eax, 60 (SYS_exit)
    em(0x0f); em(0x05)                              // syscall
    patch32(init_done, CL)
}

// Emit a bump allocation of `alloc_size` bytes (8-aligned). Returns the pointer in rax.
// Fast path bumps the cursor; slow path re-reserves a fresh chunk (MAP_FAILED -> exit 42).
fn emit_arena_alloc_x86(alloc_size: i64) with Mut, Panic, Div {
    var sz = alloc_size
    if sz < 8 { sz = 8 }
    sz = (sz + 7) / 8 * 8
    // rax = cursor (candidate alloc base / return value)
    emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + AST_ARENA_CURSOR_BSS_OFF)
    em(0x48); em(0x89); em(0xc2)                     // mov rdx, rax (rdx = base)
    em(0x48); em(0x81); em(0xc2); em32(sz)           // add rdx, sz  (rdx = end = new cursor)
    em(0x50)                                        // push rax (base)
    emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + AST_ARENA_LIMIT_BSS_OFF)  // rax = limit
    em(0x48); em(0x39); em(0xc2)                     // cmp rdx, rax (end - limit)
    em(0x58)                                        // pop rax (base) — flags preserved
    em(0x0f); em(0x87)                              // ja slow (end > limit, unsigned)
    let slow = CL
    em32(0)
    // FAST PATH: [cursor] = rdx (new cursor); rax already holds base
    em(0x50)                                        // push rax (base)
    emit_load_abs_addr_to_rax_x86(GL_BSS_BASE + AST_ARENA_CURSOR_BSS_OFF)   // rax = &cursor
    em(0x48); em(0x89); em(0x10)                     // mov [rax], rdx
    em(0x58)                                        // pop rax (base = return)
    em(0xe9)                                        // jmp done
    let fast_done = CL
    em32(0)
    // SLOW PATH: re-reserve a fresh chunk of the NEGOTIATED size
    // ([limit]-[base], set adaptively at init), halving further on failure.
    patch32(slow, CL)
    emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + AST_ARENA_LIMIT_BSS_OFF)
    em(0x48); em(0x89); em(0xc6)                     // mov rsi, rax
    emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + AST_ARENA_BASE_BSS_OFF)
    em(0x48); em(0x29); em(0xc6)                     // sub rsi, rax (rsi = chunk size)
    // Oversized allocations: a Box larger than the negotiated chunk (e.g.
    // the multi-GB IrModule mega-struct during 300+-fn merged compiles)
    // must size the NEW chunk by the REQUEST — otherwise the fresh chunk
    // is immediately overrun, every subsequent alloc re-reserves another
    // chunk (VmPeak piles up in 2 GiB steps, ~24 GiB observed) and an
    // incidental mmap failure aborts with 42 despite ample free memory.
    em(0x48); em(0xb9); em64(sz + 4096)              // movabs rcx, sz + slack
    em(0x48); em(0x39); em(0xce)                     // cmp rsi, rcx
    em(0x0f); em(0x83)                               // jae keep (chunk >= need)
    let ovr_keep = CL
    em32(0)
    em(0x48); em(0x89); em(0xce)                     // mov rsi, rcx (grow to need)
    patch32(ovr_keep, CL)
    let slow_retry = CL
    em(0x48); em(0x31); em(0xff)                     // xor rdi, rdi
    em(0xba); em32(3)                                // mov edx, 3
    em(0x41); em(0xba); em32(0x22)                   // mov r10d, 0x22
    em(0x49); em(0xc7); em(0xc0); em32(0 - 1)        // mov r8, -1
    em(0x4d); em(0x31); em(0xc9)                      // xor r9, r9
    em(0xb8); em32(9)                                // mov eax, 9 (SYS_mmap)
    em(0x0f); em(0x05)                               // syscall -> rax = new base or MAP_FAILED
    em(0x48); em(0x3d); em32(0 - 4096)               // cmp rax, -4096
    em(0x0f); em(0x86)                               // jbe ok
    let slow_ok = CL
    em32(0)
    em(0x48); em(0xd1); em(0xee)                    // shr rsi, 1
    em(0x48); em(0xb9); em64(16777216)              // movabs rcx, 16 MiB floor
    em(0x48); em(0x39); em(0xce)                    // cmp rsi, rcx
    em(0x0f); em(0x83)                              // jae retry
    em32(slow_retry - (CL + 4))
    em(0xe9)                                        // jmp abort
    let slow_abort = CL
    em32(0)
    patch32(slow_ok, CL)
    emit_bump_counter_rsi_x86(ARENA_REFILL_COUNT_BSS_OFF, ARENA_REFILL_BYTES_BSS_OFF)
    // Write the back-link header {old_base, old_limit} into the NEW chunk
    // before repointing the BSS triple — __arena_reset walks this chain to
    // munmap chunks reserved after a mark. rax = new chunk base, rsi = size.
    em(0x48); em(0x89); em(0xc2)                     // mov rdx, rax (rdx = new chunk base)
    emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + AST_ARENA_BASE_BSS_OFF)     // rax = old base
    em(0x48); em(0x89); em(0x02)                     // mov [rdx], rax (header.prev_base)
    emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + AST_ARENA_LIMIT_BSS_OFF)    // rax = old limit
    em(0x48); em(0x89); em(0x42); em(8)              // mov [rdx+8], rax (header.prev_limit)
    em(0x48); em(0x89); em(0xd0)                     // mov rax, rdx (new chunk base)
    emit_store_rax_to_abs_qword_x86(GL_BSS_BASE + AST_ARENA_BASE_BSS_OFF)    // [base] = rax
    em(0x50)                                        // push rax (chunk base)
    em(0x48); em(0x01); em(0xf0)                      // add rax, rsi -> rax = base + actual
    emit_store_rax_to_abs_qword_x86(GL_BSS_BASE + AST_ARENA_LIMIT_BSS_OFF)   // [limit] = rax
    em(0x58)                                        // pop rax (chunk base)
    em(0x48); em(0x83); em(0xc0); em(16)             // add rax, 16 (skip header -> alloc base)
    em(0x50)                                        // push rax (return base)
    em(0x48); em(0x05); em32(sz)                     // add rax, sz
    emit_store_rax_to_abs_qword_x86(GL_BSS_BASE + AST_ARENA_CURSOR_BSS_OFF)  // [cursor] = base + 16 + sz
    em(0x58)                                        // pop rax (return base = alloc base)
    em(0xe9)                                        // jmp done
    let slow_done = CL
    em32(0)
    patch32(slow_abort, CL)
    em(0xbf); em32(42)                              // mov edi, 42
    em(0xb8); em32(60)                              // mov eax, 60 (SYS_exit)
    em(0x0f); em(0x05)                              // syscall
    patch32(fast_done, CL)
    patch32(slow_done, CL)
}

// Code offset of the shared pool-alloc routine in the CURRENT compile's CD
// buffer; -1 = not yet emitted. Reset alongside CL in compile_all. The routine
// is shared (call rel32 per site) rather than inlined: an inline expansion at
// every aggregate site overflowed the fixed 128 MiB CD buffer on the Madaros
// main.sio bundle (103.8 MiB of emitted code before this change).
var POOL_ALLOC_ROUTINE_CL: i64 = 0 - 1

// Emit (once, lazily, jumped over inside whatever function first needs it) the
// shared aggregate-pool allocation routine. ABI: rax = size in, rax = pointer
// out; clobbers rcx/rdx/rsi/rdi/r8-r11 (the same caller-saved set the old
// per-site inline mmap sequence clobbered). Pool state is the AGG_POOL_* BSS
// triple, lazily initialized ({0,0,0} fails the first fit check and reserves
// the first chunk). Chunk = max(limit-base, 256 MiB, size+4096); mmap halves
// on failure to a 16 MiB floor, then aborts with exit 42 like the Box arena.
fn emit_pool_alloc_routine_x86() with Mut, Panic, Div {
    em(0xe9)                                        // jmp over (routine body is not fall-through)
    let pool_skip = CL
    em32(0)
    POOL_ALLOC_ROUTINE_CL = CL
    // entry: rax = size -> 8-align
    em(0x48); em(0x83); em(0xc0); em(7)              // add rax, 7
    em(0x48); em(0x83); em(0xe0); em(0xf8)           // and rax, -8
    em(0x48); em(0x89); em(0xc1)                     // mov rcx, rax (rcx = sz)
    let pool_loop = CL
    // fast fit check: r8 = cursor, r9 = cursor + sz; if r9 <= limit commit
    emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + AGG_POOL_CURSOR_BSS_OFF)
    em(0x49); em(0x89); em(0xc0)                     // mov r8, rax (candidate base)
    em(0x48); em(0x01); em(0xc8)                     // add rax, rcx (end)
    em(0x49); em(0x89); em(0xc1)                     // mov r9, rax (end)
    emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + AGG_POOL_LIMIT_BSS_OFF)
    em(0x49); em(0x39); em(0xc1)                     // cmp r9, rax (end - limit)
    em(0x0f); em(0x87)                              // ja slow (end > limit; limit=0 first time)
    let pool_slow = CL
    em32(0)
    emit_load_abs_addr_to_rax_x86(GL_BSS_BASE + AGG_POOL_CURSOR_BSS_OFF)
    em(0x4c); em(0x89); em(0x08)                     // mov [rax], r9 (cursor = end)
    em(0x4c); em(0x89); em(0xc0)                     // mov rax, r8 (return base)
    em(0xc3)                                        // ret
    // SLOW: reserve a fresh chunk, then loop back to the fit check.
    patch32(pool_slow, CL)
    em(0x51)                                        // push rcx (save sz across syscalls)
    emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + AGG_POOL_LIMIT_BSS_OFF)
    em(0x48); em(0x89); em(0xc6)                     // mov rsi, rax
    emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + AGG_POOL_BASE_BSS_OFF)
    em(0x48); em(0x29); em(0xc6)                     // sub rsi, rax (current chunk size)
    em(0x48); em(0xba); em64(268435456)              // movabs rdx, 256 MiB
    em(0x48); em(0x39); em(0xd6)                     // cmp rsi, rdx
    em(0x0f); em(0x83)                               // jae keep1
    let pool_keep1 = CL
    em32(0)
    em(0x48); em(0x89); em(0xd6)                     // mov rsi, rdx
    patch32(pool_keep1, CL)
    em(0x48); em(0x89); em(0xca)                     // mov rdx, rcx (sz)
    em(0x48); em(0x81); em(0xc2); em32(4096)         // add rdx, 4096 (request + slack)
    em(0x48); em(0x39); em(0xd6)                     // cmp rsi, rdx
    em(0x0f); em(0x83)                               // jae keep2
    let pool_keep2 = CL
    em32(0)
    em(0x48); em(0x89); em(0xd6)                     // mov rsi, rdx (grow to need)
    patch32(pool_keep2, CL)
    let pool_retry = CL
    em(0x48); em(0x31); em(0xff)                     // xor rdi, rdi
    em(0xba); em32(3)                                // mov edx, 3
    em(0x41); em(0xba); em32(0x22)                   // mov r10d, 0x22
    em(0x49); em(0xc7); em(0xc0); em32(0 - 1)        // mov r8, -1
    em(0x4d); em(0x31); em(0xc9)                      // xor r9, r9
    em(0xb8); em32(9)                                // mov eax, 9 (SYS_mmap)
    em(0x0f); em(0x05)                               // syscall (clobbers rcx/r11 — sz is on the stack)
    em(0x48); em(0x3d); em32(0 - 4096)               // cmp rax, -4096
    em(0x0f); em(0x86)                               // jbe ok
    let pool_ok = CL
    em32(0)
    em(0x48); em(0xd1); em(0xee)                    // shr rsi, 1
    em(0x48); em(0xba); em64(16777216)              // movabs rdx, 16 MiB floor
    em(0x48); em(0x39); em(0xd6)                    // cmp rsi, rdx
    em(0x0f); em(0x83)                              // jae retry
    em32(pool_retry - (CL + 4))
    em(0xbf); em32(42)                              // mov edi, 42
    em(0xb8); em32(60)                              // mov eax, 60 (SYS_exit)
    em(0x0f); em(0x05)                              // syscall
    patch32(pool_ok, CL)
    emit_bump_counter_rsi_x86(POOL_REFILL_COUNT_BSS_OFF, POOL_REFILL_BYTES_BSS_OFF)
    // install chunk: base = cursor = rax, limit = rax + rsi; retry the fit
    em(0x48); em(0x89); em(0xc1)                     // mov rcx, rax (new base)
    em(0x48); em(0x89); em(0xc2)                     // mov rdx, rax
    em(0x48); em(0x01); em(0xf2)                     // add rdx, rsi (new limit)
    emit_load_abs_addr_to_rax_x86(GL_BSS_BASE + AGG_POOL_BASE_BSS_OFF)
    em(0x48); em(0x89); em(0x08)                     // mov [rax], rcx
    emit_load_abs_addr_to_rax_x86(GL_BSS_BASE + AGG_POOL_CURSOR_BSS_OFF)
    em(0x48); em(0x89); em(0x08)                     // mov [rax], rcx
    emit_load_abs_addr_to_rax_x86(GL_BSS_BASE + AGG_POOL_LIMIT_BSS_OFF)
    em(0x48); em(0x89); em(0x10)                     // mov [rax], rdx
    em(0x59)                                        // pop rcx (sz)
    em(0xe9); em32(pool_loop - (CL + 4))             // jmp fit check
    patch32(pool_skip, CL)
}

// Emit a bump allocation of `alloc_size` bytes (8-aligned) from the aggregate
// pool (AGG_POOL_* — see the BSS decl comment). Returns the pointer in rax.
// Per-site cost is 15 bytes (movabs rax, sz; call routine) — smaller than the
// old inline mmap sequence it replaces. Chunks are never freed and there is NO
// reset for this pool — it holds aggregate backing storage of arbitrary
// lifetime; the win over the old per-block mmap is purely packing (8-byte
// instead of 4 KiB page granularity).
fn emit_pool_alloc_x86(alloc_size: i64) with Mut, Panic, Div {
    var sz = alloc_size
    if sz < 8 { sz = 8 }
    sz = (sz + 7) / 8 * 8
    if POOL_ALLOC_ROUTINE_CL < 0 {
        emit_pool_alloc_routine_x86()
    }
    em(0x48); em(0xb8); em64(sz)                     // movabs rax, sz
    em(0xe8); em32(POOL_ALLOC_ROUTINE_CL - (CL + 4)) // call routine
}

// Pool allocation with a RUNTIME size already in rax (the routine 8-aligns).
// Replaces emit_mmap_len_in_rax_x86 for string concat/slice result buffers:
// every string op used to mmap a fresh page-granular block (a 20-byte concat
// cost 4 KiB of VmSize forever — measured ~12 GiB across a large merged
// compile's native codegen). Strings have arbitrary lifetime and are never
// freed either way, so pool-packing them changes nothing but the density.
fn emit_pool_alloc_rax_x86() with Mut, Panic, Div {
    if POOL_ALLOC_ROUTINE_CL < 0 {
        emit_pool_alloc_routine_x86()
    }
    em(0xe8); em32(POOL_ALLOC_ROUTINE_CL - (CL + 4)) // call routine (rax = size in)
}

fn emit_str_concat_slots_x86(slot_a: i64, slot_b: i64) with Mut, Panic, Div {
    let slot_len_a = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    let slot_len_b = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    let slot_res = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1

    emit_load_var(slot_a)
    emit_str_len()
    emit_store_var(slot_len_a)

    emit_load_var(slot_b)
    emit_str_len()
    emit_store_var(slot_len_b)

    emit_load_var(slot_len_a)
    emit_push()
    emit_load_var(slot_len_b)
    em(0x59)
    em(0x48); em(0x01); em(0xc8)            // add rax, rcx
    em(0x48); em(0x83); em(0xc0); em(1)     // add rax, 1
    emit_pool_alloc_rax_x86()
    emit_store_var(slot_res)

    em(0xfc)                                // cld
    emit_load_var(slot_len_a)
    em(0x48); em(0x89); em(0xc1)            // mov rcx, rax
    emit_load_var(slot_a)
    em(0x48); em(0x89); em(0xc6)            // mov rsi, rax
    emit_load_var(slot_res)
    em(0x48); em(0x89); em(0xc7)            // mov rdi, rax
    em(0xf3); em(0xa4)                      // rep movsb

    emit_load_var(slot_len_b)
    em(0x48); em(0x89); em(0xc1)            // mov rcx, rax
    emit_load_var(slot_b)
    em(0x48); em(0x89); em(0xc6)            // mov rsi, rax
    em(0xf3); em(0xa4)                      // rep movsb

    em(0xc6); em(0x07); em(0x00)            // mov byte [rdi], 0
    emit_load_var(slot_res)
}

fn emit_str_slice_range_slots_x86(slot_s: i64, slot_start: i64, slot_end: i64) with Mut, Panic, Div {
    let slot_len = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    let slot_res = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1

    emit_load_var(slot_end)
    emit_push()
    emit_load_var(slot_start)
    em(0x59)
    em(0x48); em(0x29); em(0xc1)            // sub rcx, rax
    em(0x48); em(0x89); em(0xc8)            // mov rax, rcx
    emit_store_var(slot_len)

    emit_load_var(slot_len)
    em(0x48); em(0x83); em(0xc0); em(1)     // add rax, 1
    emit_pool_alloc_rax_x86()
    emit_store_var(slot_res)

    em(0xfc)                                // cld
    emit_load_var(slot_len)
    em(0x48); em(0x89); em(0xc1)            // mov rcx, rax
    emit_load_var(slot_s)
    em(0x48); em(0x89); em(0xc2)            // mov rdx, rax
    emit_load_var(slot_start)
    em(0x48); em(0x01); em(0xd0)            // add rax, rdx
    em(0x48); em(0x89); em(0xc6)            // mov rsi, rax
    emit_load_var(slot_res)
    em(0x48); em(0x89); em(0xc7)            // mov rdi, rax
    em(0xf3); em(0xa4)                      // rep movsb
    em(0xc6); em(0x07); em(0x00)            // mov byte [rdi], 0
    emit_load_var(slot_res)
}

fn emit_read_file() with Mut, Panic, Div {
    // rax = path. open -> read into a CACHED 16 MiB scratch (lazy mmap, reused
    // every call) -> close -> pool-alloc (bytes_read + 64) -> copy + 64-byte
    // zero tail -> return the right-sized pool block.
    //
    // The old form mmap'd a FRESH 16 MiB zero-filled buffer per call and never
    // freed it: read_env() reads /proc/self/environ through here, and Madaros
    // trace gates call read_env per compiled function/module -- measured 1047
    // calls x 16 MiB = ~16.8 GiB of VmSize on one eisa_evm merged compile.
    // The 64-byte zero tail preserves the old zero-fill semantics for callers
    // that scan a few bytes past the content for NUL / double-NUL terminators
    // (read_env scans exactly content+2); length-bounded callers are unaffected.
    if POOL_ALLOC_ROUTINE_CL < 0 {
        emit_pool_alloc_routine_x86()
    }
    em(0x48); em(0x89); em(0xc7)  // mov rdi, rax (path)
    em(0x48); em(0x31); em(0xf6)  // xor rsi, rsi (O_RDONLY)
    em(0xb8); em32(2); em(0x0f); em(0x05)  // open -> fd in rax
    em(0x50)  // push fd                                  stack=[fd]
    // scratch = [READFILE_SCRATCH]; lazy mmap on first use
    emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + READFILE_SCRATCH_BSS_OFF)
    em(0x48); em(0x85); em(0xc0)  // test rax, rax
    em(0x0f); em(0x85); let rf_have = CL; em32(0)  // jnz have_scratch
    em(0x48); em(0x31); em(0xff)  // rdi=0
    em(0xbe); em32(0x1000001)  // esi=16MB+1
    em(0xba); em32(3)  // edx=PROT_RW
    em(0x41); em(0xba); em32(0x22)  // r10d=MAP_PRIVATE|MAP_ANON
    em(0x49); em(0xc7); em(0xc0); em32(-1)  // r8=-1
    em(0x4d); em(0x31); em(0xc9)  // r9=0
    em(0xb8); em32(9); em(0x0f); em(0x05)  // mmap -> scratch in rax
    em(0x48); em(0x3d); em32(0 - 4096)  // cmp rax, -4096
    em(0x0f); em(0x87); let rf_abort = CL; em32(0)  // ja abort (MAP_FAILED)
    emit_store_rax_to_abs_qword_x86(GL_BSS_BASE + READFILE_SCRATCH_BSS_OFF)  // cache (rax preserved)
    patch32(rf_have, CL)
    em(0x50)  // push scratch                             stack=[fd, scratch]
    // read(fd, scratch, 16MB)
    em(0x48); em(0x89); em(0xc6)  // mov rsi, rax (scratch)
    em(0x48); em(0x8b); em(0x7c); em(0x24); em(0x08)  // mov rdi, [rsp+8] (fd)
    em(0xba); em32(0x1000000)  // edx=16MB
    em(0xb8); em32(0); em(0x0f); em(0x05)  // read -> bytes in rax
    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (bytes read)
    em(0x48); em(0x85); em(0xc9)  // test rcx, rcx
    em(0x79); em(0x02)  // jns read_ok
    em(0x31); em(0xc9)  // xor ecx, ecx (read error -> len 0)
    // close(fd) -- preserve len across the syscall
    em(0x51)  // push rcx (len)                           stack=[fd, scratch, len]
    em(0x48); em(0x8b); em(0x7c); em(0x24); em(0x10)  // mov rdi, [rsp+16] (fd)
    em(0xb8); em32(3); em(0x0f); em(0x05)  // close
    em(0x59)  // pop rcx (len)                            stack=[fd, scratch]
    // dst = pool_alloc(len + 64)
    em(0x51)  // push rcx (len)                           stack=[fd, scratch, len]
    em(0x48); em(0x89); em(0xc8)  // mov rax, rcx
    em(0x48); em(0x83); em(0xc0); em(64)  // add rax, 64
    em(0xe8); em32(POOL_ALLOC_ROUTINE_CL - (CL + 4))  // call pool routine -> rax = dst
    em(0x59)  // pop rcx (len)                            stack=[fd, scratch]
    // copy len bytes scratch -> dst, then 64 zero tail bytes
    em(0x50)  // push rax (dst, the return value)         stack=[fd, scratch, dst]
    em(0x48); em(0x89); em(0xc7)  // mov rdi, rax (dst)
    em(0x48); em(0x8b); em(0x74); em(0x24); em(0x08)  // mov rsi, [rsp+8] (scratch)
    em(0xfc)  // cld
    em(0xf3); em(0xa4)  // rep movsb (rcx = len)
    em(0x31); em(0xc0)  // xor eax, eax
    em(0xb9); em32(64)  // mov ecx, 64
    em(0xf3); em(0xaa)  // rep stosb (zero tail)
    em(0x58)  // pop rax (dst = return buf)               stack=[fd, scratch]
    em(0x48); em(0x83); em(0xc4); em(0x10)  // add rsp, 16 (discard scratch, fd)
    em(0xe9); let rf_done = CL; em32(0)  // jmp done
    patch32(rf_abort, CL)
    em(0xbf); em32(42)  // mov edi, 42 (distinct OOM exit code, mirrors arena)
    em(0xb8); em32(60)  // mov eax, 60 (SYS_exit)
    em(0x0f); em(0x05)  // syscall
    patch32(rf_done, CL)
}

fn emit_file_size() with Mut, Panic {
    // rax = path. stat(path, &statbuf) → statbuf.st_size at offset 48.
    // A directory (st_mode S_IFDIR at offset 24) returns -1 so callers treat it
    // like an unreadable/absent file: file_exists() == (file_size() >= 0) then
    // reports false, and `--check <dir>` / `check <dir>` emit "could not read
    // input file" instead of parsing an empty AST. (Returning st_size for a dir
    // is a latent bug — a directory is never a valid source/import file.)
    em(0x48); em(0x89); em(0xc7)  // mov rdi, rax (path)
    em(0x48); em(0x81); em(0xec); em32(160)  // sub rsp, 160 (struct stat + padding)
    em(0x48); em(0x89); em(0xe6)  // mov rsi, rsp (statbuf)
    em(0xb8); em32(4)  // mov eax, 4 (sys_stat)
    em(0x0f); em(0x05)
    em(0x48); em(0x85); em(0xc0)  // test rax, rax
    em(0x0f); em(0x88); let stat_fail = CL; em32(0)  // js stat_fail
    // reject directories: (st_mode & S_IFMT) == S_IFDIR → -1
    em(0x8b); em(0x44); em(0x24); em(24)  // mov eax, [rsp+24] (st_mode, 32-bit)
    em(0x25); em32(0xF000)  // and eax, 0xF000 (S_IFMT)
    em(0x3d); em32(0x4000)  // cmp eax, 0x4000 (S_IFDIR)
    em(0x0f); em(0x84); let dir_fail = CL; em32(0)  // je stat_fail
    em(0x48); em(0x8b); em(0x44); em(0x24); em(48)  // mov rax, [rsp+48] (st_size)
    em(0xe9); let stat_done = CL; em32(0)
    let stat_fail_target = CL
    em(0x48); em(0xc7); em(0xc0); em32(-1)  // mov rax, -1 (missing/unreadable → sentinel)
    let stat_done_target = CL
    patch32(stat_fail, stat_fail_target)
    patch32(dir_fail, stat_fail_target)
    patch32(stat_done, stat_done_target)
    em(0x48); em(0x81); em(0xc4); em32(160)  // add rsp, 160
}

// Gen 18b: read_byte() — reads one byte from stdin (fd=0). Returns byte value or -1 on EOF.
fn emit_read_byte_x86() with Mut {
    em(0x48); em(0x83); em(0xec); em(0x08)      // sub rsp, 8
    em(0x48); em(0x31); em(0xff)                // xor rdi, rdi (fd=0 stdin)
    em(0x48); em(0x8d); em(0x34); em(0x24)      // lea rsi, [rsp]
    em(0xba); em(0x01); em(0x00); em(0x00); em(0x00) // mov edx, 1
    em(0x48); em(0x31); em(0xc0)                // xor rax, rax (SYS_read=0)
    em(0x0f); em(0x05)                           // syscall
    em(0x48); em(0x85); em(0xc0)                // test rax, rax
    em(0x7e); em(0x06)                           // jle eof (+6)
    em(0x0f); em(0xb6); em(0x04); em(0x24)      // movzx eax, byte[rsp]
    em(0xeb); em(0x07)                           // jmp done (+7)
    // eof:
    em(0x48); em(0xc7); em(0xc0); em(0xff); em(0xff); em(0xff); em(0xff) // mov rax, -1
    // done:
    em(0x48); em(0x83); em(0xc4); em(0x08)      // add rsp, 8
}

// Gen 19: read_line() — read one line from stdin (fd=0) into a fresh mmap buffer.
// Strips trailing newline. Returns null-terminated string pointer.
fn emit_read_line_x86() with Mut {
    // mmap(NULL, 4096, PROT_RW, MAP_PRIVATE|MAP_ANON, -1, 0)
    em(0x48); em(0x31); em(0xff)              // xor rdi, rdi
    em(0xbe); em32(4096)                      // mov esi, 4096
    em(0xba); em32(3)                         // mov edx, PROT_READ|PROT_WRITE
    em(0x41); em(0xba); em32(0x22)            // mov r10d, MAP_PRIVATE|MAP_ANON
    em(0x49); em(0xc7); em(0xc0); em32(-1)   // mov r8, -1
    em(0x4d); em(0x31); em(0xc9)              // xor r9, r9
    em(0xb8); em32(9); em(0x0f); em(0x05)    // mmap → buf in rax
    em(0x50)                                  // push buf
    // read(0, buf, 4095)
    em(0x48); em(0x89); em(0xc6)              // mov rsi, rax (buf)
    em(0x48); em(0x31); em(0xff)              // xor rdi, rdi (fd=0 stdin)
    em(0xba); em32(4095)                      // mov edx, 4095 (leave room for \0)
    em(0x48); em(0x31); em(0xc0)              // xor rax, rax (sys_read=0)
    em(0x0f); em(0x05)                        // syscall → bytes_read in rax
    // If bytes_read <= 0, rax stays negative/zero — still null-terminate
    em(0x48); em(0x85); em(0xc0)              // test rax, rax
    em(0x7e); em(0x08)                        // jle read_done (skip newline strip)
    // Strip trailing '\n' (10) if present
    em(0x48); em(0x8b); em(0x0c); em(0x24)   // mov rcx, [rsp] (buf)
    em(0x48); em(0x0f); em(0xbe); em(0x4c); em(0x01); em(0xff) // movsx rcx, byte[rcx+rax-1]
    em(0x48); em(0x83); em(0xf9); em(0x0a)   // cmp rcx, 10  ('\n')
    em(0x75); em(0x02)                        // jne read_done
    em(0x48); em(0xff); em(0xc8)              // dec rax
    // read_done: null-terminate buf[rax]
    em(0x48); em(0x8b); em(0x0c); em(0x24)   // mov rcx, [rsp] (buf)
    em(0xc6); em(0x04); em(0x01); em(0x00)   // mov byte[rcx+rax], 0
    em(0x58)                                  // pop rax (return buf)
}

fn emit_syscall6_x86(argc: i64) with Mut {
    if argc >= 1 {
        em(0x48); em(0x8b); em(0x84); em(0x24); em32((argc - 1) * 8)  // mov rax, [rsp+num]
    }
    if argc >= 2 { emit_load_rsp_arg_x86(0, (argc - 2) * 8) }  // rdi = a1
    if argc >= 3 { emit_load_rsp_arg_x86(1, (argc - 3) * 8) }  // rsi = a2
    if argc >= 4 { emit_load_rsp_arg_x86(2, (argc - 4) * 8) }  // rdx = a3
    if argc >= 5 { em(0x4c); em(0x8b); em(0x94); em(0x24); em32((argc - 5) * 8) }  // mov r10, [rsp+a4]
    if argc >= 6 { emit_load_rsp_arg_x86(4, (argc - 6) * 8) }  // r8 = a5
    if argc >= 7 { emit_load_rsp_arg_x86(5, (argc - 7) * 8) }  // r9 = a6
    em(0x0f); em(0x05)
    emit_drop_call_args_x86(argc)
}

fn emit_write_file_flags(open_flags: i64) with Mut, Panic {
    // rdi = path, rsi = buf addr, rdx = len
    em(0x52)  // push rdx (len)
    em(0x56)  // push rsi (buf)
    em(0xbe); em32(open_flags)
    em(0xba); em32(0x1A4)  // mov edx, 0644
    em(0xb8); em32(2)  // mov eax, 2 (sys_open)
    em(0x0f); em(0x05)  // → fd in rax
    em(0x48); em(0x85); em(0xc0)  // test rax, rax
    em(0x0f); em(0x89); let open_ok = CL; em32(0)  // jns open_ok
    em(0x48); em(0x83); em(0xc4); em(0x10)  // add rsp, 16
    em(0xe9); let done = CL; em32(0)
    let open_ok_target = CL
    em(0x49); em(0x89); em(0xc0)  // mov r8, rax (fd)
    em(0x5e)  // pop rsi (buf)
    em(0x5a)  // pop rdx (len)
    em(0x4c); em(0x89); em(0xc7)  // mov rdi, r8
    em(0xb8); em32(1)  // mov eax, 1 (sys_write)
    em(0x0f); em(0x05)
    em(0x49); em(0x89); em(0xc1)  // mov r9, rax (write result)
    // close(fd)
    em(0x4c); em(0x89); em(0xc7)  // mov rdi, r8
    em(0xb8); em32(3)  // mov eax, 3 (sys_close)
    em(0x0f); em(0x05)
    em(0x4c); em(0x89); em(0xc8)  // mov rax, r9
    let done_target = CL
    patch32(open_ok, open_ok_target)
    patch32(done, done_target)
}

fn emit_write_file() with Mut, Panic {
    emit_write_file_flags(0x241)
}

fn emit_append_file() with Mut, Panic {
    emit_write_file_flags(0x441)
}

// ─── Expression compiler (recursive descent) ───
// Global parse position for expression parsing
var EP: i64 = 0
var EXPR_IS_F64: i64 = 0
var EXPR_TY: i64 = 0
var EXPR_TY_HASH: i64 = 0
var LAST_ALEN: i64 = 0
var LAST_STMT_TY: i64 = 0
var LAST_STMT_TY_HASH: i64 = 0
var CURRENT_RET_TY: i64 = 0
var CURRENT_RET_HASH: i64 = 0
var CURRENT_SRET_SLOT: i64 = 0
// Closure state save buffers (global to avoid stack overflow in recursive compile_primary)
var CL_SAVE_NS: [i64; 2048] = [0; 2048]
var CL_SAVE_NE: [i64; 2048] = [0; 2048]
var CL_SAVE_SL: [i64; 2048] = [0; 2048]
var CL_SAVE_LS: [i64; 2048] = [0; 2048]
var CL_SAVE_AL: [i64; 2048] = [0; 2048]
var CL_SAVE_ES: [i64; 2048] = [0; 2048]
var CL_SAVE_F64: [i64; 2048] = [0; 2048]
var CL_SAVE_ISCL: [i64; 2048] = [0; 2048]
var CL_SAVE_MUT: [i64; 2048] = [0; 2048]
var CL_SAVE_UNIT: [i64; 2048] = [0; 2048]
var CL_SAVE_LINEAR: [i64; 2048] = [0; 2048]
var CL_SAVE_USED: [i64; 2048] = [0; 2048]
var CL_SAVE_TY: [i64; 2048] = [0; 2048]
var CL_SAVE_TH: [i64; 2048] = [0; 2048]
// Capture tracking for closures
var CL_CAP_SLOT: [i64; 2048] = [0; 2048]
var CL_CAP_COUNT: i64 = 0
// Loop stack for continue/break (max 16 nested loops)
var LOOP_TOP: [i64; 16] = [0; 16]
var LOOP_END_PATCH: [i64; 16] = [0; 16]
var LOOP_DEPTH: i64 = 0
// Break fixup table: code offsets of jmp rel32 placeholders
var BREAK_PATCH: [i64; 64] = [0; 64]
var BREAK_COUNT: i64 = 0
// Track if last struct literal was a linear/affine type
var LAST_EXPR_IS_LINEAR: i64 = 0
var LAST_EXPR_IS_AFFINE: i64 = 0
// Track VAR index of last struct identifier loaded (-1 if not applicable)
var LAST_EXPR_VAR_IDX: i64 = -1
// For a Seq method receiver that is a struct FIELD (e.g. obj.items.push(v)): a
// stack slot holding the ADDRESS of the cell that stores the Seq pointer, so a
// grow can write the moved pointer back into the field. -1 = receiver was not a
// Seq field (use the LAST_EXPR_VAR_IDX / bare-var path instead). Set in the
// struct field-load path, consumed+reset by the Seq .push/.push_uncertain arms.
var SEQ_RECV_PLACE_SLOT: i64 = -1
// Scratch local-slot ids for string builtins inside large expression compilers.
var BUILTIN_SLOT_A: i64 = 0
var BUILTIN_SLOT_B: i64 = 0
var BUILTIN_SLOT_CNT: i64 = 0

fn compile_measure_call_x86(call_tok: i64) with IO, Mut, Panic, Div {
    EP = EP + 1
    var value_ty: i64 = 0
    var value_hash: i64 = 0
    var value_tok: i64 = -1
    var unc_ty: i64 = 0
    var unc_tok: i64 = -1
    var conf_ty: i64 = 0
    var value_slot: i64 = -1
    var unc_slot: i64 = -1
    var conf_slot: i64 = -1
    var argc: i64 = 0
    var saw_unc: i64 = 0
    var saw_conf: i64 = 0
    if TK[EP as usize] != 7 && TK[EP as usize] != 0 {
        let arg_start = EP
        compile_or()
        value_ty = EXPR_TY
        value_hash = EXPR_TY_HASH
        value_tok = expr_simple_numeric_tok(arg_start, EP)
        value_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        emit_store_var(value_slot)
        argc = 1
    }
    while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
        if TK[EP as usize] == 28 { EP = EP + 1 }
        if TK[EP as usize] == 7 || TK[EP as usize] == 0 { break }
        var label_kind: i64 = 0
        if TK[EP as usize] == 3 && TK[(EP + 1) as usize] == 43 {
            let lns = TS[EP as usize]
            let lne = TE[EP as usize]
            if src_match(lns, lne - lns, "uncertainty") { label_kind = 1 }
            else if src_match(lns, lne - lns, "confidence") { label_kind = 2 }
            else { tc_error(call_tok, "unknown measure metadata label") }
            EP = EP + 2
        }
        let arg_start = EP
        compile_or()
        let arg_ty = EXPR_TY
        let lit_tok = expr_simple_numeric_tok(arg_start, EP)
        let tmp_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        emit_store_var(tmp_slot)
        argc = argc + 1
        if label_kind == 2 || (label_kind == 0 && saw_unc != 0 && saw_conf == 0) {
            if saw_conf != 0 { tc_error(call_tok, "duplicate measure confidence") }
            conf_slot = tmp_slot
            conf_ty = arg_ty
            saw_conf = 1
        } else {
            if saw_unc != 0 { tc_error(call_tok, "duplicate measure uncertainty") }
            unc_slot = tmp_slot
            unc_ty = arg_ty
            unc_tok = lit_tok
            saw_unc = 1
        }
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }
    if argc <= 0 { tc_wrong_arity(call_tok, 2, 0) }
    let eps_scaled = infer_measure_eps_scaled(value_tok, unc_tok)
    let base_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 3
    if value_slot >= 0 { emit_load_var(value_slot) } else { em(0x31); em(0xc0) }
    emit_store_var(base_slot + 2)
    if unc_slot >= 0 {
        emit_load_var(unc_slot)
        if unc_ty != 2 {
            if ty_is_numeric(unc_ty) {
                em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xc0)
                em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
            } else {
                tc_error(call_tok, "measure uncertainty must be numeric")
                em(0x31); em(0xc0)
            }
        }
        em(0x48); em(0x89); em(0xc1)
        em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc0)
        em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc9)
        em(0xf2); em(0x0f); em(0x59); em(0xc1)
        em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
    } else {
        emit_imm64(0)
    }
    emit_store_var(base_slot + 1)
    if conf_slot >= 0 {
        emit_load_var(conf_slot)
        if conf_ty != 2 {
            if ty_is_numeric(conf_ty) {
                em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xc0)
                em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
            } else {
                tc_error(call_tok, "measure confidence must be numeric")
                emit_imm64(4607182418800017408)
            }
        }
    } else {
        emit_imm64(4607182418800017408)
    }
    emit_store_var(base_slot)
    em(0x48); em(0x8d); em(0x85)
    em32(0 - (base_slot + 2) * 8)
    EXPR_IS_F64 = 0
    EXPR_TY = 0
    EXPR_TY_HASH = knowledge_hash_make(value_ty, value_hash, eps_scaled)
}

fn compile_acknowledge_call_x86(call_tok: i64) with IO, Mut, Panic, Div {
    // acknowledge(k: Knowledge<T>, reason: String) -> T
    // Does NOT require `with Epistemic` — explicit uncertainty acknowledgment
    EP = EP + 1  // skip (
    if TK[EP as usize] == 7 || TK[EP as usize] == 0 {
        tc_arity_error(call_tok, "arity mismatch: acknowledge() requires 2 arguments")
        if TK[EP as usize] == 7 { EP = EP + 1 }
        EXPR_TY = 0
        EXPR_TY_HASH = 0
        EXPR_IS_F64 = 0
        return
    }
    // Compile first arg: the Knowledge<T> value
    compile_or()
    let ack_k_ty = EXPR_TY
    let ack_k_hash = EXPR_TY_HASH
    // Expect comma + reason arg
    if TK[EP as usize] == 28 {
        EP = EP + 1
    } else {
        tc_arity_error(call_tok, "arity mismatch: acknowledge() requires 2 arguments")
    }
    // Skip reason arg (not compiled — documentation only)
    if TK[EP as usize] != 7 && TK[EP as usize] != 0 {
        EP = skip_call_arg_expr(EP)
    }
    // Check for extra args
    if TK[EP as usize] == 28 {
        tc_error(call_tok, "acknowledge() takes exactly 2 arguments")
        while TK[EP as usize] != 7 && TK[EP as usize] != 0 { EP = EP + 1 }
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }
    // Extract .value at offset 0: mov rax, [rax]
    em(0x48); em(0x8b); em(0x00)
    // Set result type to inner type
    if knowledge_hash_is(ack_k_hash) {
        let ack_inner_hash = knowledge_hash_inner_hash(ack_k_hash)
        EXPR_TY = knowledge_hash_inner_ty(ack_k_hash)
        EXPR_TY_HASH = ack_inner_hash
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
    } else if ack_k_ty == 6 {
        let ack_si = st_find(ack_k_hash)
        if ack_si >= 0 {
            EXPR_TY = ST_FTY[(ack_si * 128) as usize]
            EXPR_TY_HASH = ST_FHASH[(ack_si * 128) as usize]
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
        }
    }
}

// uncertainty_of(k: Knowledge<f64>) -> f64 — the std-dev uncertainty (sqrt of the variance
// field at [k+8]), symmetric with measure(.., uncertainty: u). Pure read; no effect required.
fn compile_uncertainty_of_call_x86(call_tok: i64) with IO, Mut, Panic, Div {
    EP = EP + 1  // skip (
    if TK[EP as usize] == 7 || TK[EP as usize] == 0 {
        tc_arity_error(call_tok, "arity mismatch: uncertainty_of() requires 1 argument")
        if TK[EP as usize] == 7 { EP = EP + 1 }
        EXPR_TY = 2; EXPR_TY_HASH = 0; EXPR_IS_F64 = 1
        return
    }
    compile_or()
    if TK[EP as usize] == 28 {
        tc_error(call_tok, "uncertainty_of() takes exactly 1 argument")
        while TK[EP as usize] != 7 && TK[EP as usize] != 0 { EP = EP + 1 }
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }
    em(0x48); em(0x8b); em(0x40); em(8)   // mov rax, [rax+8]  (variance field)
    emit_sqrt_builtin_x86()                // rax = sqrt(variance) = std-dev
    EXPR_IS_F64 = 1
    EXPR_TY = 2
    EXPR_TY_HASH = 0
}

fn compile_require_confidence_call_x86(call_tok: i64) with IO, Mut, Panic, Div {
    // require_confidence(k: Knowledge<T>, min: f64) -> T
    // Extracts .value if confidence >= min, panics (exit 1) otherwise
    EP = EP + 1  // skip (
    if TK[EP as usize] == 7 || TK[EP as usize] == 0 {
        tc_arity_error(call_tok, "arity mismatch: require_confidence() requires 2 arguments")
        if TK[EP as usize] == 7 { EP = EP + 1 }
        EXPR_TY = 0
        EXPR_TY_HASH = 0
        EXPR_IS_F64 = 0
        return
    }
    // Compile first arg: Knowledge<T> value → rax = struct ptr
    compile_or()
    let rc_k_ty = EXPR_TY
    let rc_k_hash = EXPR_TY_HASH
    let rc_k_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var(rc_k_slot)
    // Expect comma + threshold
    if TK[EP as usize] == 28 {
        EP = EP + 1
    } else {
        tc_arity_error(call_tok, "arity mismatch: require_confidence() requires 2 arguments")
    }
    // Compile second arg: threshold f64
    compile_or()
    let rc_min_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var(rc_min_slot)
    // Check for extra args
    if TK[EP as usize] == 28 {
        tc_error(call_tok, "require_confidence() takes exactly 2 arguments")
        while TK[EP as usize] != 7 && TK[EP as usize] != 0 { EP = EP + 1 }
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }
    // Load confidence field: [k_ptr + 16]
    emit_load_var(rc_k_slot)
    em(0x48); em(0x8b); em(0x40); em(16)  // mov rax, [rax + 16] — confidence f64 bits
    em(0x48); em(0x89); em(0xc1)           // mov rcx, rax (save confidence)
    emit_load_var(rc_min_slot)              // rax = threshold f64 bits
    // Compare: ucomisd xmm0 (confidence), xmm1 (threshold)
    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1)  // movq xmm0, rcx (confidence)
    em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)  // movq xmm1, rax (threshold)
    em(0x66); em(0x0f); em(0x2e); em(0xc1)             // ucomisd xmm0, xmm1
    // jae +N (skip panic if confidence >= threshold)
    em(0x73)  // jae rel8
    let rc_ok_patch = CL
    em(0x00)  // placeholder
    emit_assert_fail()  // exit(1) — does not return
    CD[rc_ok_patch as usize] = (CL - rc_ok_patch - 1) as i8
    // Extract .value at offset 0
    emit_load_var(rc_k_slot)
    em(0x48); em(0x8b); em(0x00)  // mov rax, [rax + 0] — .value
    // Set result type to inner type
    if knowledge_hash_is(rc_k_hash) {
        let rc_inner_hash = knowledge_hash_inner_hash(rc_k_hash)
        EXPR_TY = knowledge_hash_inner_ty(rc_k_hash)
        EXPR_TY_HASH = rc_inner_hash
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
    } else if rc_k_ty == 6 {
        let rc_si = st_find(rc_k_hash)
        if rc_si >= 0 {
            EXPR_TY = ST_FTY[(rc_si * 128) as usize]
            EXPR_TY_HASH = ST_FHASH[(rc_si * 128) as usize]
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
        }
    }
}

fn compile_knowledge_literal_x86() with IO, Mut, Panic, Div {
    EP = EP + 1
    let base_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 3
    var value_ty: i64 = 0
    var value_hash: i64 = 0
    var saw_value: i64 = 0
    var saw_var: i64 = 0
    var saw_conf: i64 = 0
    var lit_mode: i64 = 0
    var lit_eps: i64 = -1
    while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 {
        if TK[EP as usize] == 3 {
            let field_tok = EP
            let fns = TS[EP as usize]
            let fne = TE[EP as usize]
            EP = EP + 1
            if TK[EP as usize] == 43 { EP = EP + 1 }
            let field_start = EP
            compile_or()
            let field_ty = EXPR_TY
            let field_hash = EXPR_TY_HASH
            let lit_tok = expr_simple_numeric_tok(field_start, EP)
            if src_match(fns, fne - fns, "value") {
                emit_store_var(base_slot + 2)
                value_ty = field_ty
                value_hash = field_hash
                saw_value = 1
            } else if src_match(fns, fne - fns, "variance") {
                if field_ty != 2 {
                    if ty_is_numeric(field_ty) {
                        emit_i64_to_f64_in_rax_x86()
                    } else {
                        tc_error(field_tok, "Knowledge variance must be numeric")
                        em(0x31); em(0xc0)
                    }
                }
                emit_store_var(base_slot + 1)
                saw_var = 1
            } else if src_match(fns, fne - fns, "uncertainty") {
                if field_ty != 2 {
                    if ty_is_numeric(field_ty) {
                        emit_i64_to_f64_in_rax_x86()
                    } else {
                        tc_error(field_tok, "Knowledge uncertainty must be numeric")
                        em(0x31); em(0xc0)
                    }
                }
                em(0x48); em(0x89); em(0xc1)
                em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc0)
                em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc9)
                em(0xf2); em(0x0f); em(0x59); em(0xc1)
                em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
                emit_store_var(base_slot + 1)
                saw_var = 1
            } else if src_match(fns, fne - fns, "confidence") || src_match(fns, fne - fns, "epsilon") {
                if field_ty != 2 {
                    if ty_is_numeric(field_ty) {
                        emit_i64_to_f64_in_rax_x86()
                    } else {
                        tc_error(field_tok, "Knowledge epsilon must be numeric")
                        em(0x31); em(0xc0)
                    }
                }
                emit_store_var(base_slot)
                saw_conf = 1
                if lit_tok >= 0 {
                    let scaled = tok_scaled_million(lit_tok)
                    if scaled >= 0 && scaled <= 1000000 {
                        lit_mode = 1
                        lit_eps = scaled
                    }
                }
            } else if src_match(fns, fne - fns, "validity") || src_match(fns, fne - fns, "provenance") {
            } else {
                tc_error(field_tok, "unknown field in Knowledge literal")
            }
        }
        if TK[EP as usize] == 28 { EP = EP + 1 }
    }
    if TK[EP as usize] == 9 { EP = EP + 1 }
    if saw_value == 0 {
        em(0x31); em(0xc0)
        emit_store_var(base_slot + 2)
        value_ty = 0
        value_hash = 0
    }
    if saw_var == 0 {
        em(0x31); em(0xc0)
        emit_store_var(base_slot + 1)
    }
    if saw_conf == 0 {
        emit_imm64(4607182418800017408)
        emit_store_var(base_slot)
    }
    em(0x48); em(0x8d); em(0x85)
    em32(0 - (base_slot + 2) * 8)
    EXPR_IS_F64 = 0
    EXPR_TY = 0
    EXPR_TY_HASH = knowledge_hash_make_mode(value_ty, value_hash, lit_mode, lit_eps)
    LAST_EXPR_IS_LINEAR = 0
    LAST_EXPR_IS_AFFINE = 0
}

// ── Seq<T> codegen (TY_SEQ = 12, Phase 0: x86, elem_size fixed at 8) ─────────
// Heap layout at user pointer P (returned by emit_heap_alloc_x86):
//   P+0 len   P+8 capacity   P+16 elem_size   P+24 len_variance(f64)
//   P+32 len_confidence(f64) P+40 payload[0]…  (element i at P+40+i*8)

fn emit_seq_new_x86() with Mut, Panic {
    emit_imm64(72)
    emit_heap_alloc_x86()
    em(0x48); em(0xc7); em(0x40); em(0); em32(0)     // mov qword [rax+0], 0   (len)
    em(0x48); em(0xc7); em(0x40); em(8); em32(4)     // mov qword [rax+8], 4   (capacity)
    em(0x48); em(0xc7); em(0x40); em(16); em32(8)    // mov qword [rax+16], 8  (elem_size)
    em(0x48); em(0xc7); em(0x40); em(24); em32(0)    // mov qword [rax+24], 0  (len_variance)
    em(0x48); em(0xb9); em64(4607182418800017408)    // mov rcx, 0x3FF0000000000000 (1.0)
    em(0x48); em(0x89); em(0x48); em(32)             // mov [rax+32], rcx      (len_confidence)
}

fn emit_seq_push_slots_x86(slot_s: i64, slot_v: i64) with Mut, Panic {
    let slot_newcap = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_load_var(slot_s)                    // rax = P
    em(0x48); em(0x8b); em(0x48); em(0)      // mov rcx, [rax+0]  (len)
    em(0x48); em(0x8b); em(0x50); em(8)      // mov rdx, [rax+8]  (capacity)
    em(0x48); em(0x39); em(0xd1)             // cmp rcx, rdx
    em(0x0f); em(0x85)                       // jne no_grow
    let p_nogrow = CL
    em32(0)
    // grow: new_cap = capacity*2
    em(0x48); em(0x89); em(0xd0)             // mov rax, rdx (cap)
    em(0x48); em(0xd1); em(0xe0)             // shl rax, 1
    emit_store_var(slot_newcap)
    emit_load_var(slot_s)                    // rax = old P
    em(0x50)                                  // push old user ptr
    emit_load_var(slot_newcap)               // rax = new_cap
    em(0x48); em(0xc1); em(0xe0); em(3)      // shl rax, 3  (new_cap*8)
    em(0x48); em(0x83); em(0xc0); em(40)     // add rax, 40 (header bytes)
    emit_heap_realloc_x86()                  // pops old ptr; rax = new user ptr
    emit_store_var(slot_s)                    // write moved pointer back to receiver
    emit_load_var(slot_newcap)               // rax = new_cap
    em(0x48); em(0x89); em(0xc1)             // mov rcx, rax
    emit_load_var(slot_s)                    // rax = P
    em(0x48); em(0x89); em(0x48); em(8)      // mov [rax+8], rcx  (capacity = new_cap)
    // no_grow:
    em32_at(p_nogrow, CL - (p_nogrow + 4))
    emit_load_var(slot_s)                    // rax = P
    em(0x48); em(0x8b); em(0x48); em(0)      // mov rcx, [rax+0]  (len)
    em(0x48); em(0x8d); em(0x50); em(40)     // lea rdx, [rax+40] (payload base)
    emit_load_var(slot_v)                    // rax = value
    em(0x48); em(0x89); em(0x04); em(0xca)   // mov [rdx + rcx*8], rax
    emit_load_var(slot_s)                    // rax = P
    em(0x48); em(0xff); em(0x00)             // inc qword [rax]   (len++)
}

fn emit_seq_bounds_check_x86(slot_s: i64, slot_idx: i64) with Mut, Panic {
    emit_load_var(slot_idx)                  // rax = idx
    em(0x48); em(0x89); em(0xc1)             // mov rcx, rax (idx)
    emit_load_var(slot_s)                    // rax = P
    em(0x48); em(0x8b); em(0x00)             // mov rax, [rax] (len)
    em(0x48); em(0x39); em(0xc1)             // cmp rcx, rax  (idx - len)
    em(0x0f); em(0x82)                       // jb in_bounds  (unsigned idx < len)
    let p_ok = CL
    em32(0)
    emit_assert_fail()                       // OOB → exit(1)
    patch32(p_ok, CL)
}

fn emit_seq_get_slots_x86(slot_s: i64, slot_idx: i64) with Mut, Panic {
    emit_seq_bounds_check_x86(slot_s, slot_idx)
    emit_load_var(slot_s)                    // rax = P
    em(0x48); em(0x8d); em(0x50); em(40)     // lea rdx, [rax+40] (payload base)
    emit_load_var(slot_idx)                  // rax = idx
    em(0x48); em(0x89); em(0xc1)             // mov rcx, rax
    em(0x48); em(0x8b); em(0x04); em(0xca)   // mov rax, [rdx + rcx*8]
}

fn emit_seq_set_slots_x86(slot_s: i64, slot_idx: i64, slot_v: i64) with Mut, Panic {
    emit_seq_bounds_check_x86(slot_s, slot_idx)
    emit_load_var(slot_s)                    // rax = P
    em(0x48); em(0x8d); em(0x50); em(40)     // lea rdx, [rax+40]
    emit_load_var(slot_idx)                  // rax = idx
    em(0x48); em(0x89); em(0xc1)             // mov rcx, rax
    emit_load_var(slot_v)                    // rax = value
    em(0x48); em(0x89); em(0x04); em(0xca)   // mov [rdx + rcx*8], rax
}

fn emit_seq_len_x86(slot_s: i64) with Mut, Panic {
    let base = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 3
    emit_load_var(slot_s)
    em(0x48); em(0x8b); em(0x40); em(0)      // mov rax, [rax+0]  (len)
    emit_store_var(base + 2)                  // value @ lowest addr (offset 0)
    emit_load_var(slot_s)
    em(0x48); em(0x8b); em(0x40); em(24)     // mov rax, [rax+24] (variance)
    emit_store_var(base + 1)                  // variance @ offset 8
    emit_load_var(slot_s)
    em(0x48); em(0x8b); em(0x40); em(32)     // mov rax, [rax+32] (confidence)
    emit_store_var(base)                      // confidence @ offset 16
    emit_lea_var(base + 2)                    // rax = &record
}

fn emit_seq_count_x86(slot_s: i64) with Mut, Panic {
    emit_load_var(slot_s)
    em(0x48); em(0x8b); em(0x00)             // mov rax, [rax]  (len)
}

fn emit_seq_push_uncertain_slots_x86(slot_s: i64, slot_v: i64, slot_conf: i64, slot_var: i64) with Mut, Panic {
    emit_seq_push_slots_x86(slot_s, slot_v)
    // confidence = min(old_conf, new_conf)
    emit_load_var(slot_conf)
    em(0x48); em(0x89); em(0xc1)             // mov rcx, rax (new conf)
    emit_load_var(slot_s)
    em(0x48); em(0x8b); em(0x40); em(32)     // mov rax, [P+32] (old conf)
    emit_min_positive_f64_bits_x86()         // rax = min(rax, rcx)
    em(0x50)                                  // push min
    emit_load_var(slot_s)                    // rax = P
    em(0x59)                                  // pop rcx (min)
    em(0x48); em(0x89); em(0x48); em(32)     // mov [P+32], rcx
    // variance = old_var + new_var
    emit_load_var(slot_var)
    em(0x48); em(0x89); em(0xc1)             // mov rcx, rax (new var)
    emit_load_var(slot_s)
    em(0x48); em(0x8b); em(0x40); em(24)     // mov rax, [P+24] (old var)
    emit_f64_add_from_rcx_rax_x86()          // rax = rcx + rax
    em(0x50)                                  // push sum
    emit_load_var(slot_s)                    // rax = P
    em(0x59)                                  // pop rcx (sum)
    em(0x48); em(0x89); em(0x48); em(24)     // mov [P+24], rcx
}

fn emit_seq_push_at_place_x86(slot_place: i64, slot_v: i64) with Mut, Panic {
    let slot_pcur = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_load_var(slot_place)                // rax = field addr
    em(0x48); em(0x8b); em(0x00)             // mov rax, [rax]  (current Seq ptr)
    emit_store_var(slot_pcur)
    emit_seq_push_slots_x86(slot_pcur, slot_v)
    emit_load_var(slot_pcur)                 // rax = (possibly moved) ptr
    em(0x48); em(0x89); em(0xc1)             // mov rcx, rax
    emit_load_var(slot_place)                // rax = field addr
    em(0x48); em(0x89); em(0x08)             // mov [rax], rcx  (write back to field)
}

fn emit_seq_push_uncertain_at_place_x86(slot_place: i64, slot_v: i64, slot_conf: i64, slot_var: i64) with Mut, Panic {
    let slot_pcur = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_load_var(slot_place)
    em(0x48); em(0x8b); em(0x00)             // mov rax, [rax]
    emit_store_var(slot_pcur)
    emit_seq_push_uncertain_slots_x86(slot_pcur, slot_v, slot_conf, slot_var)
    emit_load_var(slot_pcur)
    em(0x48); em(0x89); em(0xc1)             // mov rcx, rax
    emit_load_var(slot_place)
    em(0x48); em(0x89); em(0x08)             // mov [rax], rcx
}

// Paren-form constructor: Knowledge(value, ε=eps, prov="...") or
// Knowledge(value: v  ε: eps  prov: "...").  Mirrors the brace literal but
// accepts a leading positional value, `=`/`:` separators, optional commas,
// and the unicode ε key.  Stores the static ε literal into the type hash so
// compile-time confidence gates see it (Contribution 2 substrate).
fn compile_knowledge_paren_x86() with IO, Mut, Panic, Div {
    EP = EP + 1  // skip '('
    let base_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 3
    var value_ty: i64 = 0
    var value_hash: i64 = 0
    var saw_value: i64 = 0
    var saw_var: i64 = 0
    var saw_conf: i64 = 0
    var lit_mode: i64 = 0
    var lit_eps: i64 = -1
    while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
        if TK[EP as usize] == 3 && (TK[(EP + 1) as usize] == 16 || TK[(EP + 1) as usize] == 43) {
            let field_tok = EP
            let fns = TS[EP as usize]
            let fne = TE[EP as usize]
            let is_eps_uni = tok_is_unicode_epsilon(field_tok)
            EP = EP + 2  // skip name and `=`/`:`
            let field_start = EP
            compile_or()
            let field_ty = EXPR_TY
            let field_hash = EXPR_TY_HASH
            let lit_tok = expr_simple_numeric_tok(field_start, EP)
            if src_match(fns, fne - fns, "value") {
                emit_store_var(base_slot + 2)
                value_ty = field_ty
                value_hash = field_hash
                saw_value = 1
            } else if src_match(fns, fne - fns, "variance") {
                if field_ty != 2 {
                    if ty_is_numeric(field_ty) {
                        emit_i64_to_f64_in_rax_x86()
                    } else {
                        tc_error(field_tok, "Knowledge variance must be numeric")
                        em(0x31); em(0xc0)
                    }
                }
                emit_store_var(base_slot + 1)
                saw_var = 1
            } else if src_match(fns, fne - fns, "uncertainty") {
                if field_ty != 2 {
                    if ty_is_numeric(field_ty) {
                        emit_i64_to_f64_in_rax_x86()
                    } else {
                        tc_error(field_tok, "Knowledge uncertainty must be numeric")
                        em(0x31); em(0xc0)
                    }
                }
                em(0x48); em(0x89); em(0xc1)
                em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc0)
                em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc9)
                em(0xf2); em(0x0f); em(0x59); em(0xc1)
                em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
                emit_store_var(base_slot + 1)
                saw_var = 1
            } else if is_eps_uni || src_match(fns, fne - fns, "confidence") || src_match(fns, fne - fns, "epsilon") {
                if field_ty != 2 {
                    if ty_is_numeric(field_ty) {
                        emit_i64_to_f64_in_rax_x86()
                    } else {
                        tc_error(field_tok, "Knowledge epsilon must be numeric")
                        em(0x31); em(0xc0)
                    }
                }
                emit_store_var(base_slot)
                saw_conf = 1
                if lit_tok >= 0 {
                    let scaled = tok_scaled_million(lit_tok)
                    if scaled >= 0 && scaled <= 1000000 {
                        lit_mode = 1
                        lit_eps = scaled
                    }
                }
            } else if src_match(fns, fne - fns, "validity") || src_match(fns, fne - fns, "provenance") || src_match(fns, fne - fns, "prov") {
                // provenance string: compiled above, value discarded
            } else {
                tc_error(field_tok, "unknown field in Knowledge constructor")
            }
        } else {
            // Positional argument: the first one is the value
            compile_or()
            if saw_value == 0 {
                emit_store_var(base_slot + 2)
                value_ty = EXPR_TY
                value_hash = EXPR_TY_HASH
                saw_value = 1
            }
        }
        if TK[EP as usize] == 28 { EP = EP + 1 }  // optional comma
    }
    if TK[EP as usize] == 7 { EP = EP + 1 }  // skip ')'
    if saw_value == 0 {
        em(0x31); em(0xc0)
        emit_store_var(base_slot + 2)
        value_ty = 0
        value_hash = 0
    }
    if saw_var == 0 {
        em(0x31); em(0xc0)
        emit_store_var(base_slot + 1)
    }
    if saw_conf == 0 {
        emit_imm64(4607182418800017408)
        emit_store_var(base_slot)
    }
    em(0x48); em(0x8d); em(0x85)
    em32(0 - (base_slot + 2) * 8)
    EXPR_IS_F64 = 0
    EXPR_TY = 0
    EXPR_TY_HASH = knowledge_hash_make_mode(value_ty, value_hash, lit_mode, lit_eps)
    LAST_EXPR_IS_LINEAR = 0
    LAST_EXPR_IS_AFFINE = 0
}

// Precedence (low→high): || < && < comparison < bitwise OR < bitwise AND < shift < additive < multiplicative < unary < postfix < primary

fn compile_borrow_primary_x86() with IO, Mut, Panic, Div {
    EP = EP + 1
    var want_mut: i64 = 0
    if TK[EP as usize] == 32 {
        want_mut = 1
        EP = EP + 1
    }
    let borrow_tok = EP - 1
    if TK[EP as usize] == 6 && TK[(EP + 1) as usize] == 19 && TK[(EP + 2) as usize] == 3 && TK[(EP + 3) as usize] == 7 {
        let ptr_tok = EP + 2
        let pns = TS[ptr_tok as usize]
        let pne = TE[ptr_tok as usize]
        EP = EP + 4
        let pvi = var_find_idx(pns, pne)
        if pvi >= 0 {
            emit_load_var(VAR_SLOT[pvi as usize])
            var inner_ty = VAR_TY[pvi as usize]
            var inner_hash = VAR_TY_HASH[pvi as usize]
            if type_is_pointer_like(inner_ty, inner_hash) {
                inner_ty = ptr_hash_inner_ty(inner_hash)
                inner_hash = ptr_hash_inner_hash(inner_hash)
            }
            while TK[EP as usize] == 50 {
                EP = EP + 1
                let f_tok = EP
                let fh = gl_name_hash(TS[EP as usize], TE[EP as usize])
                EP = EP + 1
                if inner_ty == 10 && type_is_pointer_like(inner_ty, inner_hash) {
                    inner_ty = ptr_hash_inner_ty(inner_hash)
                    inner_hash = ptr_hash_inner_hash(inner_hash)
                }
                let si = st_find(inner_hash)
                if si < 0 {
                    tc_error(f_tok, "field borrow through deref requires struct pointee")
                    em(0x31); em(0xc0)
                    inner_ty = 0
                    inner_hash = 0
                } else {
                    ST_QUERY_NS = TS[f_tok as usize]
                    ST_QUERY_NE = TE[f_tok as usize]
                    let off = st_field_offset(si, fh)
                    if off < 0 {
                        tc_error(f_tok, "unknown field access")
                        em(0x31); em(0xc0)
                        inner_ty = 0
                        inner_hash = 0
                    } else {
                        if off != 0 { em(0x48); em(0x8d); em(0x80); em32(off) }
                        inner_ty = st_field_ty(si, fh)
                        inner_hash = st_field_hash(si, fh)
                    ST_QUERY_NS = -1
                    ST_QUERY_NE = -1
                    }
                }
            }
            if inner_ty == 11 && box_hash_is(inner_hash) {
                em(0x48); em(0x8b); em(0x00)
                inner_ty = ptr_hash_inner_ty(inner_hash)
                inner_hash = ptr_hash_inner_hash(inner_hash)
            }
            EXPR_IS_F64 = 0
            EXPR_TY = 10
            if want_mut != 0 { EXPR_TY_HASH = ref_hash_make(inner_ty, inner_hash, 1) }
            else { EXPR_TY_HASH = ref_hash_make(inner_ty, inner_hash, 0) }
            return
        }
        tc_undefined_var(ptr_tok)
        em(0x31); em(0xc0)
        EXPR_IS_F64 = 0
        EXPR_TY = 10
        if want_mut != 0 { EXPR_TY_HASH = ref_hash_make(0, 0, 1) }
        else { EXPR_TY_HASH = ref_hash_make(0, 0, 0) }
        return
    }
    if TK[EP as usize] != 3 {
        // Bug E: &<literal> (array literal, string literal, ...) — everything
        // below this point assumes the token after &/&! is a variable
        // identifier. A literal's own primary-expression codegen already
        // produces the right runtime value for a reference (an array literal
        // materializes to a stack slot and returns its address via `lea`; a
        // string literal returns its own address via `lea rax, [rip+disp]`),
        // so borrowing one is just: compile it, then tag the result as a
        // reference to whatever type it produced.
        compile_primary()
        let lit_inner_ty = EXPR_TY
        let lit_inner_hash = EXPR_TY_HASH
        EXPR_IS_F64 = 0
        EXPR_TY = 10
        EXPR_TY_HASH = ref_hash_make(lit_inner_ty, lit_inner_hash, want_mut)
        return
    }
    let rns = TS[EP as usize]
    let rne = TE[EP as usize]
    EP = EP + 1
    if TK[EP as usize] == 41 {
        // &seq[i] single-element borrow on a Seq receiver: the element value (for a
        // struct inner that value is a heap pointer to the materialized struct, i.e.
        // already &Inner). Returns a reference to the inner type. Handled before the
        // slice-borrow logic, which only supports array/slice bases with a..b ranges.
        let seq_bvi = var_find_idx(rns, rne)
        if seq_bvi >= 0 && VAR_TY[seq_bvi as usize] == 12 {
            let sbh = VAR_TY_HASH[seq_bvi as usize]
            EP = EP + 1  // skip [
            let sb_ps = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_load_var(VAR_SLOT[seq_bvi as usize])
            emit_store_var(sb_ps)
            let sb_is = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            compile_or()  // index → rax
            emit_store_var(sb_is)
            if TK[EP as usize] == 42 { EP = EP + 1 }
            emit_seq_get_slots_x86(sb_ps, sb_is)  // rax = element (heap ptr for struct inner)
            let sb_in_ty = seq_hash_inner_ty(sbh)
            let sb_in_hash = seq_hash_inner_hash(sbh)
            EXPR_IS_F64 = 0
            EXPR_TY = 10
            if want_mut != 0 { EXPR_TY_HASH = ref_hash_make(sb_in_ty, sb_in_hash, 1) }
            else { EXPR_TY_HASH = ref_hash_make(sb_in_ty, sb_in_hash, 0) }
            return
        }
        EP = EP + 1
        let start_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        // [..n] half-open range: start defaults to 0 when .. appears first
        if TK[EP as usize] == 63 || TK[EP as usize] == 64 {
            if TK[EP as usize] == 64 { tc_error(borrow_tok, "slice borrows require half-open ranges") }
            em(0x31); em(0xc0)  // xor eax, eax (start = 0)
            emit_store_var(start_slot)
            EP = EP + 1
        } else {
            compile_or()
            emit_store_var(start_slot)
            if TK[EP as usize] == 64 { tc_error(borrow_tok, "slice borrows require half-open ranges") }
            if TK[EP as usize] == 63 || TK[EP as usize] == 64 {
                EP = EP + 1
            } else {
                tc_error(borrow_tok, "slice borrow requires a..b range")
            }
        }
        let end_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        compile_or()
        emit_store_var(end_slot)
        if TK[EP as usize] == 42 { EP = EP + 1 }
        else { tc_error(borrow_tok, "slice borrow missing closing ]") }
        let lvi = var_find_idx(rns, rne)
        var base_ptr_slot: i64 = 0
        var base_len_slot: i64 = 0
        var base_len_const: i64 = 0
        var has_const_len: i64 = 0
        var elem_ty: i64 = 1
        var elem_hash: i64 = 0
        var esiz: i64 = 8
        var ok_base: i64 = 0
        var allow_mut: i64 = 0
        if lvi >= 0 {
            let lty = VAR_TY[lvi as usize]
            let lhash = VAR_TY_HASH[lvi as usize]
            base_ptr_slot = VAR_SLOT[lvi as usize]
            if type_is_slice_ref(lty, lhash) {
                let inner_hash = ref_hash_inner_hash(lhash)
                base_len_slot = VAR_LEN_SLOT[lvi as usize]
                esiz = arr_hash_esiz(inner_hash)
                if arr_hash_elem_ty(inner_hash) != 0 { elem_ty = arr_hash_elem_ty(inner_hash) }
                elem_hash = arr_hash_elem_hash(inner_hash)
                ok_base = 1
                if want_mut == 0 || ref_hash_mut(lhash) != 0 { allow_mut = 1 }
            } else if lty == 8 {
                base_len_const = VAR_ALEN[lvi as usize]
                has_const_len = 1
                esiz = VAR_ESIZ[lvi as usize]
                if arr_hash_elem_ty(lhash) != 0 { elem_ty = arr_hash_elem_ty(lhash) }
                elem_hash = arr_hash_elem_hash(lhash)
                ok_base = 1
                if want_mut == 0 || VAR_MUT[lvi as usize] != 0 { allow_mut = 1 }
            } else if type_is_array_ref(lty, lhash) {
                let inner_hash = ref_hash_inner_hash(lhash)
                base_len_const = arr_hash_alen(inner_hash)
                has_const_len = 1
                esiz = arr_hash_esiz(inner_hash)
                if arr_hash_elem_ty(inner_hash) != 0 { elem_ty = arr_hash_elem_ty(inner_hash) }
                elem_hash = arr_hash_elem_hash(inner_hash)
                ok_base = 1
                if want_mut == 0 || ref_hash_mut(lhash) != 0 { allow_mut = 1 }
            } else if lty == 3 {
                // String base: treat as &[i8] with runtime strlen
                let slen_slot = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                emit_load_var(base_ptr_slot)
                emit_str_len()
                emit_store_var(slen_slot)
                base_len_slot = slen_slot
                esiz = 1
                elem_ty = 1
                ok_base = 1
                if want_mut == 0 { allow_mut = 1 }
            }
        } else {
            let gi = gl_find(rns, rne)
            if gi >= 0 && GL_TY[gi as usize] == 8 {
                base_len_const = GL[(gi * 4 + 3) as usize]
                has_const_len = 1
                esiz = GL[(gi * 4 + 2) as usize]
                if arr_hash_elem_ty(GL_TY_HASH[gi as usize]) != 0 { elem_ty = arr_hash_elem_ty(GL_TY_HASH[gi as usize]) }
                elem_hash = arr_hash_elem_hash(GL_TY_HASH[gi as usize])
                ok_base = 1
                allow_mut = 1
            }
        }
        if ok_base == 0 {
            tc_error(borrow_tok, "slice borrow requires array or slice base")
            em(0x31); em(0xc0)
            EXPR_IS_F64 = 0
            EXPR_TY = 10
            EXPR_TY_HASH = ref_hash_make(8, arr_ty_hash(0, 8, 1), want_mut)
            return
        }
        if want_mut != 0 && allow_mut == 0 {
            tc_error(borrow_tok, "Mut borrow requires mutable slice source")
        }
        emit_load_var(end_slot)
        em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (end)
        emit_load_var(start_slot)
        em(0x48); em(0x39); em(0xc8)  // cmp rax, rcx
        em(0x0f); em(0x86); let slice_range_ok_a = CL; em32(0)
        emit_assert_fail()
        patch32(slice_range_ok_a, CL)
        if has_const_len != 0 { emit_imm64(base_len_const) }
        else { emit_load_var(base_len_slot) }
        em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
        em(0x0f); em(0x86); let slice_range_ok_b = CL; em32(0)
        emit_assert_fail()
        patch32(slice_range_ok_b, CL)
        let len_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        let ptr_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        if lvi >= 0 {
            emit_load_var(base_ptr_slot)
        } else {
            let gi = gl_find(rns, rne)
            if gi >= 0 { emit_imm64(GL_BSS_BASE + GL[(gi * 4 + 1) as usize]) }
            else { em(0x31); em(0xc0) }
        }
        em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (base ptr)
        emit_load_var(start_slot)
        if esiz == 8 {
            em(0x48); em(0xc1); em(0xe0); em(3)  // shl rax, 3
        }
        em(0x48); em(0x01); em(0xd0)  // add rax, rdx
        emit_store_var(ptr_slot)
        emit_load_var(end_slot)
        em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (end)
        emit_load_var(start_slot)
        em(0x48); em(0x29); em(0xc1)  // sub rcx, rax
        em(0x48); em(0x89); em(0xc8)  // mov rax, rcx
        emit_store_var(len_slot)
        emit_lea_var(ptr_slot)
        EXPR_IS_F64 = 0
        EXPR_TY = 10
        EXPR_TY_HASH = ref_hash_make(8, arr_ty_hash_for_elem_type(0, esiz, elem_ty, elem_hash), want_mut)
        return
    }
    let slot = var_find(rns, rne)
    if slot >= 0 {
        if want_mut != 0 && var_find_is_mut(rns, rne) == 0 {
            // Allow &! on fields of &!T parameters (exclusive ref params are reborrow-safe)
            let chk_vi = var_find_idx(rns, rne)
            let chk_ty = if chk_vi >= 0 { VAR_TY[chk_vi as usize] } else { 0 }
            let chk_hash = if chk_vi >= 0 { VAR_TY_HASH[chk_vi as usize] } else { 0 }
            if chk_ty != 10 || ref_hash_mut(chk_hash) == 0 {
                tc_error_hard(borrow_tok, "Mut borrow requires mutable binding")
            }
        }
        let lalen = var_find_alen(rns, rne)
        let lty = var_find_ty(rns, rne)
        let addr_vi = var_find_idx(rns, rne)
        var lhash_for_addr: i64 = 0
        if addr_vi >= 0 { lhash_for_addr = VAR_TY_HASH[addr_vi as usize] }
        if TK[EP as usize] == 50 && lty == 10 && lhash_for_addr != 0 && type_is_pointer_like(lty, lhash_for_addr) {
            emit_load_var(slot)
        } else if lalen > 0 || lty == 6 || lty == 8 || (lty == 11 && box_hash_is(lhash_for_addr)) {
            emit_load_var(slot)
        } else {
            let off = 0 - slot * 8
            em(0x48); em(0x8d); em(0x85)
            em32(off)
        }
    } else {
        let gi = gl_find(rns, rne)
        if gi >= 0 {
            let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
            em(0x48); em(0xb8); em64(addr)
        } else { tc_undefined_var(EP - 1); em(0x31); em(0xc0) }
    }
    EXPR_IS_F64 = 0
    EXPR_TY = 10
    let bvi = var_find_idx(rns, rne)
    if bvi >= 0 {
        // Reborrow-through-reference: if the target variable is itself a reference (ty=10),
        // e.g. `result: &!IEResult` parameter, then `&!result` or `&result` is a reborrow.
        // The exclusivity is already guaranteed by the existing reference — do not apply
        // borrow conflict checks or tracking (disjoint field reborrows are always safe).
        let bvi_is_ref = VAR_TY[bvi as usize] == 10
        // Borrow conflict detection: exclusive borrows conflict with any other borrow.
        if bvi_is_ref == false {
        if want_mut != 0 {
            if VAR_BORROW_COUNT[bvi as usize] > 0 {
                tc_linear_violation(borrow_tok, "cannot borrow as mutable because it is also borrowed as shared")
            }
            if VAR_BORROW_EXCL[bvi as usize] > 0 {
                tc_linear_violation(borrow_tok, "Cannot borrow as mutable: exclusive borrow already active")
            }
            VAR_BORROW_EXCL[bvi as usize] = VAR_BORROW_EXCL[bvi as usize] + 1
            // Track call-site exclusive borrows for release after the call
            if IN_CALL_ARGS != 0 && CALL_ARG_BORROW_N < 32 {
                CALL_ARG_BORROW_VI[CALL_ARG_BORROW_N as usize] = bvi
                CALL_ARG_BORROW_EXCL[CALL_ARG_BORROW_N as usize] = 1
                CALL_ARG_BORROW_N = CALL_ARG_BORROW_N + 1
            }
        } else {
            if VAR_BORROW_EXCL[bvi as usize] > 0 {
                tc_linear_violation(borrow_tok, "cannot borrow as shared because it is also borrowed as mutable")
            }
            VAR_BORROW_COUNT[bvi as usize] = VAR_BORROW_COUNT[bvi as usize] + 1
            // Track call-site shared borrows for release after the call
            if IN_CALL_ARGS != 0 && CALL_ARG_BORROW_N < 32 {
                CALL_ARG_BORROW_VI[CALL_ARG_BORROW_N as usize] = bvi
                CALL_ARG_BORROW_EXCL[CALL_ARG_BORROW_N as usize] = 0
                CALL_ARG_BORROW_N = CALL_ARG_BORROW_N + 1
            }
        }
        }
        var inner_ty = VAR_TY[bvi as usize]
        var inner_hash = VAR_TY_HASH[bvi as usize]
        if TK[EP as usize] == 50 && inner_ty == 10 && type_is_pointer_like(inner_ty, inner_hash) {
            inner_ty = ptr_hash_inner_ty(inner_hash)
            inner_hash = ptr_hash_inner_hash(inner_hash)
        }
        while TK[EP as usize] == 50 {
            EP = EP + 1
            let f_tok = EP
            let fh = gl_name_hash(TS[EP as usize], TE[EP as usize])
            EP = EP + 1
            let si = st_find(inner_hash)
            if si < 0 {
                tc_error(f_tok, "field borrow requires struct base")
                em(0x31); em(0xc0)
                inner_ty = 0
                inner_hash = 0
            } else {
                ST_QUERY_NS = TS[f_tok as usize]
                ST_QUERY_NE = TE[f_tok as usize]
                let off = st_field_offset(si, fh)
                if off < 0 {
                    tc_error(f_tok, "unknown field access")
                    em(0x31); em(0xc0)
                    inner_ty = 0
                    inner_hash = 0
                } else {
                    if off != 0 { em(0x48); em(0x8d); em(0x80); em32(off) }
                    inner_ty = st_field_ty(si, fh)
                    inner_hash = st_field_hash(si, fh)
                ST_QUERY_NS = -1
                ST_QUERY_NE = -1
                }
            }
        }
        // &obj.field[i] : the field chain left rax = address of a Seq field cell.
        // Load the Seq pointer and borrow element i (heap ptr = &Inner for structs).
        if inner_ty == 12 && TK[EP as usize] == 41 {
            em(0x48); em(0x8b); em(0x00)   // mov rax, [rax]  (Seq ptr)
            let fb_ps = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var(fb_ps)
            EP = EP + 1  // skip [
            let fb_is = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            compile_or()  // index → rax
            emit_store_var(fb_is)
            if TK[EP as usize] == 42 { EP = EP + 1 }
            emit_seq_get_slots_x86(fb_ps, fb_is)
            let fb_in_ty = seq_hash_inner_ty(inner_hash)
            let fb_in_hash = seq_hash_inner_hash(inner_hash)
            EXPR_IS_F64 = 0
            EXPR_TY = 10
            if want_mut != 0 { EXPR_TY_HASH = ref_hash_make(fb_in_ty, fb_in_hash, 1) }
            else { EXPR_TY_HASH = ref_hash_make(fb_in_ty, fb_in_hash, 0) }
            return
        }
        if inner_ty == 11 && box_hash_is(inner_hash) {
            em(0x48); em(0x8b); em(0x00)
            inner_ty = ptr_hash_inner_ty(inner_hash)
            inner_hash = ptr_hash_inner_hash(inner_hash)
        }
        EXPR_IS_F64 = 0
        EXPR_TY = 10
        if want_mut != 0 { EXPR_TY_HASH = ref_hash_make(inner_ty, inner_hash, 1) }
        else { EXPR_TY_HASH = ref_hash_make(inner_ty, inner_hash, 0) }
    } else {
        let rgi = gl_find(rns, rne)
        if rgi >= 0 {
            var inner_ty2 = GL_TY[rgi as usize]
            var inner_hash2 = GL_TY_HASH[rgi as usize]
            while TK[EP as usize] == 50 {
                EP = EP + 1
                let f_tok2 = EP
                let fh2 = gl_name_hash(TS[EP as usize], TE[EP as usize])
                EP = EP + 1
                let si2 = st_find(inner_hash2)
                if si2 < 0 {
                    tc_error(f_tok2, "field borrow requires struct base")
                    em(0x31); em(0xc0)
                    inner_ty2 = 0
                    inner_hash2 = 0
                } else {
                    ST_QUERY_NS = TS[f_tok2 as usize]
                    ST_QUERY_NE = TE[f_tok2 as usize]
                    let off2 = st_field_offset(si2, fh2)
                    if off2 < 0 {
                        tc_error(f_tok2, "unknown field access")
                        em(0x31); em(0xc0)
                        inner_ty2 = 0
                        inner_hash2 = 0
                    } else {
                        if off2 != 0 { em(0x48); em(0x8d); em(0x80); em32(off2) }
                        inner_ty2 = st_field_ty(si2, fh2)
                        inner_hash2 = st_field_hash(si2, fh2)
                    ST_QUERY_NS = -1
                    ST_QUERY_NE = -1
                    }
                }
            }
            if inner_ty2 == 11 && box_hash_is(inner_hash2) {
                em(0x48); em(0x8b); em(0x00)
                inner_ty2 = ptr_hash_inner_ty(inner_hash2)
                inner_hash2 = ptr_hash_inner_hash(inner_hash2)
            }
            EXPR_IS_F64 = 0
            EXPR_TY = 10
            if want_mut != 0 { EXPR_TY_HASH = ref_hash_make(inner_ty2, inner_hash2, 1) }
            else { EXPR_TY_HASH = ref_hash_make(inner_ty2, inner_hash2, 0) }
        }
        else {
            if want_mut != 0 { EXPR_TY_HASH = ref_hash_make(0, 0, 1) }
            else { EXPR_TY_HASH = ref_hash_make(0, 0, 0) }
        }
    }
}

// Heap-copy the struct pointed to by rax (a fresh copy), leaving the new
// pointer in rax. Keyed on the struct hash directly. Used by Seq push to give
// each pushed struct element its own storage — otherwise repeated pushes alias
// the same reused materialization buffer.
fn materialize_struct_value_x86(struct_hash: i64) with Mut, Panic, Div {
    let nslots = struct_like_nslots(struct_hash)
    if nslots <= 0 { return }
    let src_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    let dst_slot = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    emit_store_var(src_slot)
    emit_pool_alloc_x86(nslots * 8)
    emit_store_var(dst_slot)
    emit_load_var(src_slot)
    em(0x48); em(0x89); em(0xc2)   // mov rdx, rax (src)
    emit_load_var(dst_slot)        // rax = dst
    emit_copy_agg_to_ptr_x86(6, struct_hash)
}

// If the Seq's element type is a struct/aggregate, heap-copy the value in rax
// so the element gets its own storage. Scalars (i64/f64/ptr) are left untouched.
fn seq_materialize_push_value_x86(seq_hash: i64) with Mut, Panic, Div {
    if seq_hash_is(seq_hash) == false { return }
    let in_ty = seq_hash_inner_ty(seq_hash)
    let in_hash = seq_hash_inner_hash(seq_hash)
    if in_ty == 6 || in_ty == 7 || type_is_struct_like(in_ty, in_hash) {
        materialize_struct_value_x86(in_hash)
    }
}

// E043: Rust macro syntax -- `ident!(...)` and `path::ident!(...)`.
//
// Mirrors the Madaros rule in self-hosted/parser/exprs.sio, deliberately down to
// the boundary test: `!` must touch BOTH the identifier before it and the `(`
// after it. Whitespace on either side keeps the existing operator expression
// valid, so `x! (y)`, `x !(y)` and `x ! (y)` all still parse and run.
//
// Why it exists here as well as in Madaros: a language-level grammar rule must
// not carry a different diagnostic identity depending on which frontend saw it.
// Before this, the same source was refused by both engines but as E043 under
// Madaros and E200 (undefined identifier) under lean_single -- which is why
// tests/compile-fail/parser_rust_macro.sio sat on the vacuous-expect baseline:
// the suite runs lean_single, so the fixture could never see the message it pins.
//
// Token kinds: 3 = ident, 51 = `::`, 32 = `!`, 6 = `(`.
// TE[i] == TS[i+1] means token i and i+1 are lexically adjacent (no whitespace).
fn tc_reject_rust_macro_at(p0: i64) -> bool with IO, Mut, Panic {
    if TK[p0 as usize] != 3 { return false }
    var q = p0
    while TK[(q + 1) as usize] == 51 && TK[(q + 2) as usize] == 3 { q = q + 2 }
    if TK[(q + 1) as usize] != 32 { return false }
    if TK[(q + 2) as usize] != 6 { return false }
    if TE[q as usize] != TS[(q + 1) as usize] { return false }
    if TE[(q + 1) as usize] != TS[(q + 2) as usize] { return false }
    print("error[E043]: Sounio does not use Rust macros (`ident!(...)`) at line ")
    print_int(TL[(q + 1) as usize])
    print("\n")
    print("  help: use a regular function call instead of macro syntax\n")
    tc_mark_failed()
    return true
}

fn compile_primary() with IO, Mut, Panic, Div {
    if tc_reject_rust_macro_at(EP) { }
    LAST_EXPR_IS_CLOSURE = 0
    LAST_EXPR_IS_LINEAR = 0
    LAST_EXPR_IS_AFFINE = 0
    LAST_EXPR_VAR_IDX = -1
    SEQ_RECV_PLACE_SLOT = -1
    EXPR_TY = 0
    EXPR_TY_HASH = 0
    // GTT: fresh primary expression starts with empty channel topology.
    EXPR_CH_SET = 0
    EXPR_PARAM_USED = 0
    EXPR_UNIT = 0
    LAST_IS_LITERAL = 0
    LAST_IS_LITERAL_F64 = 0
    EXPR_VSHADOW = -1
    EXPR_SSHADOW = -1
    EXPR_SSHADOW_1 = -1; EXPR_SSHADOW_2 = -1; EXPR_SSHADOW_3 = -1; EXPR_SSHADOW_4 = -1; EXPR_SSHADOW_5 = -1; EXPR_SSHADOW_6 = -1; EXPR_SSHADOW_7 = -1
    EXPR_HSHADOW_00 = -1; EXPR_HSHADOW_01 = -1; EXPR_HSHADOW_02 = -1; EXPR_HSHADOW_03 = -1
    EXPR_HSHADOW_11 = -1; EXPR_HSHADOW_12 = -1; EXPR_HSHADOW_13 = -1
    EXPR_HSHADOW_22 = -1; EXPR_HSHADOW_23 = -1; EXPR_HSHADOW_33 = -1
    EXPR_HSHADOW_04 = -1; EXPR_HSHADOW_05 = -1; EXPR_HSHADOW_06 = -1; EXPR_HSHADOW_07 = -1
    EXPR_HSHADOW_14 = -1; EXPR_HSHADOW_15 = -1; EXPR_HSHADOW_16 = -1; EXPR_HSHADOW_17 = -1
    EXPR_HSHADOW_24 = -1; EXPR_HSHADOW_25 = -1; EXPR_HSHADOW_26 = -1; EXPR_HSHADOW_27 = -1
    EXPR_HSHADOW_34 = -1; EXPR_HSHADOW_35 = -1; EXPR_HSHADOW_36 = -1; EXPR_HSHADOW_37 = -1
    EXPR_HSHADOW_44 = -1; EXPR_HSHADOW_45 = -1; EXPR_HSHADOW_46 = -1; EXPR_HSHADOW_47 = -1
    EXPR_HSHADOW_55 = -1; EXPR_HSHADOW_56 = -1; EXPR_HSHADOW_57 = -1
    EXPR_HSHADOW_66 = -1; EXPR_HSHADOW_67 = -1
    EXPR_HSHADOW_77 = -1
    let k = TK[EP as usize]
    // Integer literal
    if k == 4 {
        let v = TV[EP as usize]
        // Gen 19: _suffix unit annotation (e.g. 500_mg)
        let lit_uh = TU[EP as usize]
        if v == 0 { em(0x31); em(0xc0) }
        else { em(0x48); em(0xb8); em64(v) }
        EP = EP + 1
        EXPR_IS_F64 = 0
        EXPR_TY = 1
        LAST_IS_LITERAL = 1
        LAST_LITERAL_VAL = v
        if lit_uh != 0 { EXPR_UNIT = lit_uh; EXPR_UNIT_DIM = unit_lookup_dim(lit_uh) }
        return
    }
    // true=35, false=36
    if k == 35 { em(0x48); em(0xb8); em64(1); EP = EP + 1; EXPR_IS_F64 = 0; EXPR_TY = 4; return }
    if k == 36 { em(0x31); em(0xc0); EP = EP + 1; EXPR_IS_F64 = 0; EXPR_TY = 4; return }
    // Float literal (53): runtime conversion via SSE2
    if k == 53 {
        let fl_int = TV[EP as usize]
        let fl_frac = TF[EP as usize]
        let fl_denom = TD[EP as usize]
        // Gen 19: _suffix unit annotation (e.g. 9.8_m)
        let flit_uh = TU[EP as usize]
        // Store exponent info in globals to avoid extra locals shifting compile_primary's frame
        if TX[EP as usize] >= 0 { FL_SCI_SCRATCH = TX[EP as usize]; FL_SCI_NEG = 0 }
        else { FL_SCI_SCRATCH = 0 - TX[EP as usize]; FL_SCI_NEG = 1 }
        EP = EP + 1
        // mov rax, int_part; cvtsi2sd xmm0, rax
        em(0x48); em(0xb8); em64(fl_int)
        em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xc0)
        // If fractional part: frac/denom added to xmm0
        if fl_frac > 0 {
            em(0x48); em(0xb8); em64(fl_frac)
            em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xc8)  // cvtsi2sd xmm1, rax
            em(0x48); em(0xb8); em64(fl_denom)
            em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xd0)  // cvtsi2sd xmm2, rax
            em(0xf2); em(0x0f); em(0x5e); em(0xca)            // divsd xmm1, xmm2
            em(0xf2); em(0x0f); em(0x58); em(0xc1)            // addsd xmm0, xmm1
        }
        // Apply scientific exponent: multiply or divide xmm0 by 10.0 FL_SCI_SCRATCH times
        if FL_SCI_SCRATCH != 0 {
            // Load 10.0 into xmm1: movabs rax, 0x4024000000000000; movq xmm1, rax
            em(0x48); em(0xb8); em64(0x4024000000000000)
            em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)
            if FL_SCI_NEG == 0 {
                while FL_SCI_SCRATCH > 0 {
                    em(0xf2); em(0x0f); em(0x59); em(0xc1)  // mulsd xmm0, xmm1
                    FL_SCI_SCRATCH = FL_SCI_SCRATCH - 1
                }
            } else {
                while FL_SCI_SCRATCH > 0 {
                    em(0xf2); em(0x0f); em(0x5e); em(0xc1)  // divsd xmm0, xmm1
                    FL_SCI_SCRATCH = FL_SCI_SCRATCH - 1
                }
            }
        }
        // movq rax, xmm0 — store f64 bits in rax
        em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
        EXPR_IS_F64 = 1
        EXPR_TY = 2
        // PR-7: track f64 literal for compile-time predicate checking
        LAST_IS_LITERAL_F64 = 1
        LAST_LITERAL_F64_INT = fl_int
        LAST_LITERAL_F64_FRAC = fl_frac
        LAST_LITERAL_F64_DENOM = fl_denom
        if LAST_LITERAL_F64_DENOM == 0 { LAST_LITERAL_F64_DENOM = 1 }
        if flit_uh != 0 { EXPR_UNIT = flit_uh; EXPR_UNIT_DIM = unit_lookup_dim(flit_uh) }
        return
    }
    if k == 48 {
        let match_tok = EP
        compile_stmt()
        if LAST_STMT_HAS_VALUE == 0 { tc_error(match_tok, "match expression must yield a value") }
        EXPR_TY = LAST_STMT_TY
        EXPR_TY_HASH = LAST_STMT_TY_HASH
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 }
        else { EXPR_IS_F64 = 0 }
        return
    }
    if k == 13 {
        let if_tok = EP
        compile_stmt()
        if LAST_STMT_HAS_VALUE == 0 { tc_error(if_tok, "if expression must yield a value") }
        EXPR_TY = LAST_STMT_TY
        EXPR_TY_HASH = LAST_STMT_TY_HASH
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 }
        else { EXPR_IS_F64 = 0 }
        return
    }
    if k == 41 {
        if array_init_is_repeat(EP) {
            EP = EP + 1
            let expr_start = EP
            compile_or()
            let elem_ty = EXPR_TY
            let elem_hash = EXPR_TY_HASH
            if TK[EP as usize] == 27 { EP = EP + 1 }
            let rep_count = TV[EP as usize]
            EP = EP + 1
            if TK[EP as usize] == 42 { EP = EP + 1 }
            let arr_hash = arr_ty_hash_for_elem_type(rep_count, 8, elem_ty, elem_hash)
            if elem_ty == 6 {
                // Struct element: each element occupies struct_nslots qwords
                let s_nslots = struct_like_nslots(elem_hash)
                let total_slots = rep_count * s_nslots
                if total_slots > 0 {
                    let base = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + total_slots
                    let end_ep = EP
                    // ONE block for all elements (an mmap per element costs a
                    // 4 KiB page each — the vmem blowup caught by the wrapper
                    // ulimit during the prebuilt refresh). Element i lives at
                    // block + i*stride; each compiled element is copied in.
                    let lit_v = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + 1
                    emit_store_var(lit_v)
                    emit_pool_alloc_x86(rep_count * s_nslots * 8)
                    let lit_blk = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + 1
                    emit_store_var(lit_blk)
                    let lit_dst = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + 1
                    var ri: i64 = 0
                    while ri < rep_count {
                        if ri > 0 {
                            EP = expr_start
                            compile_or()
                            emit_store_var(lit_v)
                        }
                        emit_load_var(lit_blk)
                        if ri > 0 { em(0x48); em(0x05); em32(ri * s_nslots * 8) }  // add rax, off
                        emit_store_var(lit_dst)
                        emit_store_var(base + rep_count - 1 - ri)
                        emit_load_var(lit_v)
                        em(0x48); em(0x89); em(0xc2)      // mov rdx, rax (src)
                        emit_load_var(lit_dst)            // rax = dst
                        emit_copy_agg_to_ptr_x86(6, elem_hash)
                        ri = ri + 1
                    }
                    EP = end_ep
                    em(0x48); em(0x8d); em(0x85)  // lea rax, [rbp + disp32]
                    em32(0 - (base + total_slots - 1) * 8)
                } else {
                    em(0x31); em(0xc0)
                }
            } else {
                // Scalar element: rep stosq fills all slots with RAX
                let nslots = arr_storage_slots(arr_hash)
                if nslots > 0 {
                    let base = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + nslots
                    em(0x48); em(0x8d); em(0xbd)
                    em32(0 - (base + nslots - 1) * 8)
                    em(0xb9); em32(nslots)
                    em(0xf3); em(0x48); em(0xab)
                    em(0x48); em(0x8d); em(0x85)
                    em32(0 - (base + nslots - 1) * 8)
                } else {
                    em(0x31); em(0xc0)
                }
            }
            EXPR_IS_F64 = 0
            EXPR_TY = 8
            EXPR_TY_HASH = arr_hash
            LAST_ALEN = rep_count
            return
        }
        let arr_count = array_lit_count(EP)
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + arr_count
        EP = EP + 1
        var idx: i64 = 0
        var elem_ty: i64 = 0
        var elem_hash: i64 = 0
        while ep_before_body_close() && TK[EP as usize] != 42 && TK[EP as usize] != 0 {
            compile_or()
            if idx == 0 {
                elem_ty = EXPR_TY
                elem_hash = EXPR_TY_HASH
            } else {
                if ty_eq(elem_ty, elem_hash, EXPR_TY, EXPR_TY_HASH) == false {
                    tc_error_hard(EP - 1, "array literal elements must have the same type")
                }
            }
            emit_store_var(base + arr_count - 1 - idx)
            idx = idx + 1
            if TK[EP as usize] == 28 { EP = EP + 1 }
        }
        if TK[EP as usize] == 42 { EP = EP + 1 }
        em(0x48); em(0x8d); em(0x85)
        em32(0 - (base + arr_count - 1) * 8)
        EXPR_IS_F64 = 0
        EXPR_TY = 8
        EXPR_TY_HASH = arr_ty_hash_for_elem_type(arr_count, 8, elem_ty, elem_hash)
        LAST_ALEN = arr_count
        return
    }
    // Closure: |params| expr  or  |params| { stmts }
    // Token 45 = | at expression start = closure (not bitwise OR)
    // Supports captured variables from outer scope via closure struct.
    // All closures build a stack struct: [fn_ptr, cap_0, cap_1, ...]
    // Closure function receives hidden first param (env_ptr) in rdi.
    // User args shift to rsi, rdx, rcx, r8, r9 (max 5 user args).
    if k == 45 || k == 31 {
        var zero_param_closure: i64 = 0
        if k == 31 { zero_param_closure = 1 }
        EP = EP + 1  // skip opening | or ||
        CL_DEPTH = CL_DEPTH + 1
        CL_FNSIG_EFF[(CL_DEPTH - 1) as usize] = 0
        // Save outer function state
        let save_vc = VAR_COUNT
        let save_ns2 = NEXT_SLOT
        let save_ld = LOOP_DEPTH
        let save_bc = BREAK_COUNT
        let save_ret_ty = CURRENT_RET_TY
        let save_ret_hash = CURRENT_RET_HASH
        let save_sret_slot = CURRENT_SRET_SLOT
        let save_fpc = FRAME_PATCH_COUNT
        // Do NOT reset FRAME_PATCH_COUNT to 0: closure patches append after outer patches,
        // preserving the outer function's sub-rsp patch location at [0..save_fpc).
        var svi: i64 = 0
        while svi < save_vc {
            CL_SAVE_NS[svi as usize] = VAR_NS[svi as usize]
            CL_SAVE_NE[svi as usize] = VAR_NE[svi as usize]
            CL_SAVE_SL[svi as usize] = VAR_SLOT[svi as usize]
            CL_SAVE_LS[svi as usize] = VAR_LEN_SLOT[svi as usize]
            CL_SAVE_AL[svi as usize] = VAR_ALEN[svi as usize]
            CL_SAVE_ES[svi as usize] = VAR_ESIZ[svi as usize]
            CL_SAVE_F64[svi as usize] = VAR_IS_F64[svi as usize]
            CL_SAVE_ISCL[svi as usize] = VAR_IS_CLOSURE[svi as usize]
            CL_SAVE_MUT[svi as usize] = VAR_MUT[svi as usize]
            CL_SAVE_UNIT[svi as usize] = VAR_UNIT[svi as usize]
            CL_SAVE_LINEAR[svi as usize] = VAR_LINEAR[svi as usize]
            CL_SAVE_USED[svi as usize] = VAR_USED[svi as usize]
            CL_SAVE_TY[svi as usize] = VAR_TY[svi as usize]
            CL_SAVE_TH[svi as usize] = VAR_TY_HASH[svi as usize]
            svi = svi + 1
        }
        // Reset state for closure body
        VAR_COUNT = 0
        NEXT_SLOT = 2  // slot 1 reserved for env_ptr (hidden rdi param)
        LOOP_DEPTH = 0
        BREAK_COUNT = 0
        CL_CAP_COUNT = 0
        CURRENT_SRET_SLOT = 0
        // Parse closure parameters (between | ... |)
        // User params get slots 2, 3, ... (registers rsi, rdx, rcx, r8, r9)
        if zero_param_closure == 0 {
            while TK[EP as usize] != 45 && TK[EP as usize] != 0 {
                if TK[EP as usize] == 3 {
                    let pns = TS[EP as usize]
                    let pne = TE[EP as usize]
                    let pslot = var_add(pns, pne)
                    EP = EP + 1
                    if TK[EP as usize] == 43 {
                        EP = EP + 1
                        scan_type(EP)
                        if pslot >= 0 {
                            VAR_TY[(VAR_COUNT - 1) as usize] = SCAN_TY
                            VAR_TY_HASH[(VAR_COUNT - 1) as usize] = SCAN_TY_HASH
                            if SCAN_TY == 2 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 1 }
                            if SCAN_TY == 8 {
                                VAR_ALEN[(VAR_COUNT - 1) as usize] = SCAN_TY_ALEN
                                VAR_ESIZ[(VAR_COUNT - 1) as usize] = SCAN_TY_ESIZ
                            }
                        }
                        EP = SCAN_TY_NEXT
                    } else {
                        // No type annotation: default to i64. Use |x: f64| for float params.
                        if pslot >= 0 {
                            VAR_TY[(VAR_COUNT - 1) as usize] = 0
                            VAR_IS_F64[(VAR_COUNT - 1) as usize] = 0
                        }
                    }
                }
                if TK[EP as usize] == 28 { EP = EP + 1 }
            }
            if TK[EP as usize] == 45 { EP = EP + 1 }  // skip closing |
        }
        if TK[EP as usize] == 10 {
            EP = EP + 1
            scan_type(EP)
            CURRENT_RET_TY = SCAN_TY
            CURRENT_RET_HASH = SCAN_TY_HASH
            EP = SCAN_TY_NEXT
        } else {
            CURRENT_RET_TY = 0
            CURRENT_RET_HASH = 0
        }
        if TK[EP as usize] == 38 {
            EP = EP + 1
            while TK[EP as usize] == 3 || TK[EP as usize] == 28 {
                if TK[EP as usize] == 3 {
                    CL_FNSIG_EFF[(CL_DEPTH - 1) as usize] = CL_FNSIG_EFF[(CL_DEPTH - 1) as usize] | ety_parse_effect_name(TS[EP as usize], TE[EP as usize])
                    EP = EP + 1
                    if TK[EP as usize] == 6 {
                        EP = EP + 1
                        while TK[EP as usize] != 7 && TK[EP as usize] != 0 { EP = EP + 1 }
                        if TK[EP as usize] == 7 { EP = EP + 1 }
                    }
                } else {
                    EP = EP + 1
                }
            }
        }
        let nparams = VAR_COUNT  // user params only
        // Save closure's param types + ret type for FNSIG construction
        CL_FNSIG_NPARAMS[(CL_DEPTH - 1) as usize] = nparams
        var cl_pi: i64 = 0
        while cl_pi < nparams {
            CL_FNSIG_PARAM_TY[((CL_DEPTH - 1) * 16 + cl_pi) as usize] = VAR_TY[cl_pi as usize]
            CL_FNSIG_PARAM_TH[((CL_DEPTH - 1) * 16 + cl_pi) as usize] = VAR_TY_HASH[cl_pi as usize]
            cl_pi = cl_pi + 1
        }
        CL_FNSIG_RET_TY[(CL_DEPTH - 1) as usize] = CURRENT_RET_TY
        CL_FNSIG_RET_HASH[(CL_DEPTH - 1) as usize] = CURRENT_RET_HASH
        // Register outer-scope vars as captures (those not shadowed by params)
        var ci: i64 = 0
        while ci < save_vc {
            let ons = CL_SAVE_NS[ci as usize]
            let one = CL_SAVE_NE[ci as usize]
            let outer_slot = CL_SAVE_SL[ci as usize]
            let existing = var_find(ons, one)
            if existing < 0 {
                let cap_slot = var_add(ons, one)
                if cap_slot >= 0 {
                    let cap_vi = VAR_COUNT - 1
                    VAR_LEN_SLOT[cap_vi as usize] = CL_SAVE_LS[ci as usize]
                    VAR_ALEN[cap_vi as usize] = CL_SAVE_AL[ci as usize]
                    VAR_ESIZ[cap_vi as usize] = CL_SAVE_ES[ci as usize]
                    VAR_IS_F64[cap_vi as usize] = CL_SAVE_F64[ci as usize]
                    VAR_IS_CLOSURE[cap_vi as usize] = CL_SAVE_ISCL[ci as usize]
                    VAR_MUT[cap_vi as usize] = CL_SAVE_MUT[ci as usize]
                    VAR_UNIT[cap_vi as usize] = CL_SAVE_UNIT[ci as usize]
                    VAR_LINEAR[cap_vi as usize] = CL_SAVE_LINEAR[ci as usize]
                    VAR_USED[cap_vi as usize] = CL_SAVE_USED[ci as usize]
                    VAR_TY[cap_vi as usize] = CL_SAVE_TY[ci as usize]
                    VAR_TY_HASH[cap_vi as usize] = CL_SAVE_TH[ci as usize]
                    if CL_CAP_COUNT < local_cap() {
                        CL_CAP_SLOT[CL_CAP_COUNT as usize] = outer_slot
                        CL_CAP_COUNT = CL_CAP_COUNT + 1
                    } else {
                        note_limit_error(1)
                    }
                }
            }
            ci = ci + 1
        }
        // Emit jmp over closure body
        em(0xe9)
        let jmp_patch = CL
        em32(0)
        // Emit closure function body
        let cl_start = CL
        // Prologue: push rbp; mov rbp, rsp; sub rsp, <dynamic frame>
        em(0x55); em(0x48); em(0x89); em(0xe5)
        em(0x48); em(0x81); em(0xec); record_frame_patch(); em32(0)
        emit_stack_probe_x86()  // guard-page touch for multi-MB by-value frames
        // Spill env_ptr (rdi) to slot 1: mov [rbp-8], rdi
        em(0x48); em(0x89); em(0x7d); em(0xf8 as i64 & 0xFF)
        // Spill user params from shifted registers (rsi=slot2, rdx=slot3, ...)
        if nparams >= 1 { em(0x48); em(0x89); em(0x75); em(0xf0 as i64 & 0xFF) }
        if nparams >= 2 { em(0x48); em(0x89); em(0x55); em(0xe8 as i64 & 0xFF) }
        if nparams >= 3 { em(0x48); em(0x89); em(0x4d); em(0xe0 as i64 & 0xFF) }
        if nparams >= 4 { em(0x4c); em(0x89); em(0x45); em(0xd8 as i64 & 0xFF) }
        if nparams >= 5 { em(0x4c); em(0x89); em(0x4d); em(0xd0 as i64 & 0xFF) }
        var stack_param_idx: i64 = 6
        while stack_param_idx <= nparams {
            em(0x48); em(0x8b); em(0x85); em32(16 + (stack_param_idx - 6) * 8)
            emit_store_var(1 + stack_param_idx)
            stack_param_idx = stack_param_idx + 1
        }
        // Load captured vars from env struct into local slots
        // env struct layout: [fn_ptr, cap_0, cap_1, ...] at ascending addresses
        // env_ptr points to fn_ptr; cap_i is at [env_ptr + (i+1)*8]
        var capi: i64 = 0
        while capi < CL_CAP_COUNT {
            emit_load_var(1)  // rax = env_ptr
            let cap_off = (capi + 1) * 8
            em(0x48); em(0x8b); em(0x80); em32(cap_off)  // mov rax, [rax + cap_off]
            emit_store_var(2 + nparams + capi)  // store in capture's local slot
            capi = capi + 1
        }
        // Compile body
        if TK[EP as usize] == 8 {
            EP = EP + 1
            while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
            if TK[EP as usize] == 9 { EP = EP + 1 }
        } else {
            compile_or()
        }
        // Epilogue
        if CL > 0 && CD[(CL - 1) as usize] != 0xc3 as i8 {
            em(0x48); em(0x81); em(0xc4); record_frame_patch(); em32(0)
            em(0x5d); em(0xc3)
        }
        // Patch closure sub rsp / add rsp with actual frame size.
        // Closure's patches start at save_fpc (appended after outer patches).
        let cl_frame_sz = (NEXT_SLOT * 8 + 15) & 0xFFFFFFF0
        if cl_frame_sz > max_frame_bytes() { tc_stack_frame_too_large(cl_frame_sz) }
        var cl_fpi: i64 = save_fpc
        while cl_fpi < FRAME_PATCH_COUNT { em32_at(FRAME_PATCH_OFF[cl_fpi as usize], cl_frame_sz); cl_fpi = cl_fpi + 1 }
        // Patch jmp over closure body
        patch32(jmp_patch, CL)
        // Save capture count before restoring outer state
        let saved_cap_count = CL_CAP_COUNT
        // Restore outer function state
        VAR_COUNT = save_vc
        NEXT_SLOT = save_ns2
        LOOP_DEPTH = save_ld
        BREAK_COUNT = save_bc
        CURRENT_RET_TY = save_ret_ty
        CURRENT_RET_HASH = save_ret_hash
        CURRENT_SRET_SLOT = save_sret_slot
        FRAME_PATCH_COUNT = save_fpc
        svi = 0
        while svi < save_vc {
            VAR_NS[svi as usize] = CL_SAVE_NS[svi as usize]
            VAR_NE[svi as usize] = CL_SAVE_NE[svi as usize]
            VAR_SLOT[svi as usize] = CL_SAVE_SL[svi as usize]
            VAR_LEN_SLOT[svi as usize] = CL_SAVE_LS[svi as usize]
            VAR_ALEN[svi as usize] = CL_SAVE_AL[svi as usize]
            VAR_ESIZ[svi as usize] = CL_SAVE_ES[svi as usize]
            VAR_IS_F64[svi as usize] = CL_SAVE_F64[svi as usize]
            VAR_IS_CLOSURE[svi as usize] = CL_SAVE_ISCL[svi as usize]
            VAR_MUT[svi as usize] = CL_SAVE_MUT[svi as usize]
            VAR_UNIT[svi as usize] = CL_SAVE_UNIT[svi as usize]
            VAR_LINEAR[svi as usize] = CL_SAVE_LINEAR[svi as usize]
            VAR_USED[svi as usize] = CL_SAVE_USED[svi as usize]
            VAR_TY[svi as usize] = CL_SAVE_TY[svi as usize]
            VAR_TY_HASH[svi as usize] = CL_SAVE_TH[svi as usize]
            svi = svi + 1
        }
        // --- Build closure struct ---
        // Zero-capture: stack-allocate (fn_ptr only, no env needed).
        // With captures: heap-allocate via mmap so env survives the creating frame.
        let struct_size = 1 + saved_cap_count
        if saved_cap_count == 0 {
            let struct_base = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + struct_size
            let struct_top = struct_base + struct_size - 1
            em(0x48); em(0x8d); em(0x05)
            em32(cl_start - (CL + 4))  // lea rax, [rip + offset_to_cl_start]
            emit_store_var(struct_top)
            em(0x48); em(0x8d); em(0x85)
            em32(0 - struct_top * 8)
        } else {
            // heap path: pool-alloc struct_size*8; save heap_ptr; fill fields
            emit_pool_alloc_x86(struct_size * 8)        // rax = heap_ptr
            let heap_slot = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var(heap_slot)                   // save heap_ptr
            // store fn_ptr at [heap_ptr+0]
            em(0x48); em(0x8b); em(0x8d); em32(0 - heap_slot * 8)  // mov rcx, heap_ptr
            em(0x48); em(0x8d); em(0x05); em32(cl_start - (CL + 4)) // lea rax, fn_ptr
            em(0x48); em(0x89); em(0x01)                            // mov [rcx], rax
            // store each capture at [heap_ptr+(i+1)*8]
            var capj: i64 = 0
            while capj < saved_cap_count {
                emit_load_var(CL_CAP_SLOT[capj as usize])           // rax = cap_i
                em(0x48); em(0x8b); em(0x8d); em32(0 - heap_slot * 8) // rcx = heap_ptr
                em(0x48); em(0x89); em(0x81); em32((capj + 1) * 8)  // [rcx+(i+1)*8] = rax
                capj = capj + 1
            }
            emit_load_var(heap_slot)                    // rax = heap_ptr (return value)
        }
        // Build FNSIG with inferred/explicit effects for this closure
        CL_DEPTH = CL_DEPTH - 1
        FNSIG_SCRATCH_ARITY = CL_FNSIG_NPARAMS[CL_DEPTH as usize]
        FNSIG_SCRATCH_RET_TY = CL_FNSIG_RET_TY[CL_DEPTH as usize]
        FNSIG_SCRATCH_RET_HASH = CL_FNSIG_RET_HASH[CL_DEPTH as usize]
        FNSIG_SCRATCH_EFF = CL_FNSIG_EFF[CL_DEPTH as usize]
        svi = 0
        while svi < 16 {
            if svi < FNSIG_SCRATCH_ARITY {
                FNSIG_SCRATCH_PARAM_TY[svi as usize] = CL_FNSIG_PARAM_TY[(CL_DEPTH * 16 + svi) as usize]
                FNSIG_SCRATCH_PARAM_HASH[svi as usize] = CL_FNSIG_PARAM_TH[(CL_DEPTH * 16 + svi) as usize]
            } else {
                FNSIG_SCRATCH_PARAM_TY[svi as usize] = 0
                FNSIG_SCRATCH_PARAM_HASH[svi as usize] = 0
            }
            svi = svi + 1
        }
        EXPR_TY_HASH = fnsig_intern_scratch()
        EXPR_IS_F64 = 0
        EXPR_TY = 9
        LAST_EXPR_IS_CLOSURE = 1
        return
    }
    // None → 2-qword tagged union [tag=0, value=0]
    if k == 58 {
        EP = EP + 1
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 2
        em(0x48); em(0x31); em(0xc0)  // xor rax, rax
        emit_store_var(base)      // value = 0
        emit_store_var(base + 1)  // tag = 0
        em(0x48); em(0x8d); em(0x85)  // lea rax, [rbp - (base+1)*8]
        em32(0 - (base + 1) * 8)
        EXPR_IS_F64 = 0
        EXPR_TY = 11
        EXPR_TY_HASH = 0
        return
    }
    // Some(expr) → 2-qword tagged union [tag=1, value=expr]
    if k == 57 {
        EP = EP + 1
        if TK[EP as usize] == 6 { EP = EP + 1 }
        compile_or()
        let some_inner_ty = EXPR_TY
        let some_inner_hash = EXPR_TY_HASH
        if TK[EP as usize] == 7 { EP = EP + 1 }
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 2
        emit_store_var(base)      // value at slot base
        emit_imm64(1)
        emit_store_var(base + 1)  // tag = 1 at slot base+1
        em(0x48); em(0x8d); em(0x85)  // lea rax, [rbp - (base+1)*8]
        em32(0 - (base + 1) * 8)
        EXPR_IS_F64 = 0
        EXPR_TY = 11
        EXPR_TY_HASH = option_hash_make(some_inner_ty, some_inner_hash)
        return
    }
    // Ok(expr) → 2-qword tagged union [tag=0, payload=expr]
    if k == 59 {
        EP = EP + 1
        if TK[EP as usize] == 6 { EP = EP + 1 }
        compile_or()
        if TK[EP as usize] == 7 { EP = EP + 1 }
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 2
        emit_store_var(base)      // payload
        em(0x48); em(0x31); em(0xc0)  // xor rax, rax → tag = 0
        emit_store_var(base + 1)
        em(0x48); em(0x8d); em(0x85)
        em32(0 - (base + 1) * 8)
        EXPR_IS_F64 = 0
        EXPR_TY = 11
        EXPR_TY_HASH = 0
        return
    }
    // Err(expr) → 2-qword tagged union [tag=1, payload=expr]
    if k == 60 {
        EP = EP + 1
        if TK[EP as usize] == 6 { EP = EP + 1 }
        compile_or()
        if TK[EP as usize] == 7 { EP = EP + 1 }
        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 2
        emit_store_var(base)
        emit_imm64(1)  // tag = 1
        emit_store_var(base + 1)
        em(0x48); em(0x8d); em(0x85)
        em32(0 - (base + 1) * 8)
        EXPR_IS_F64 = 0
        EXPR_TY = 11
        EXPR_TY_HASH = 0
        return
    }
    // Parenthesized expression or tuple literal
    if k == 6 {
        EP = EP + 1
        compile_or()
        if TK[EP as usize] == 28 {
            // Tuple literal: (expr1, expr2, ..., exprN).
            // Layout requirement: .0 at lowest address (highest slot), .1 above, etc.
            // Problem: we don't know each element's slot count relative to the
            // others (hence total_slots and every offset) until ALL elements are
            // compiled. Strategy: save EVERY element's rax (a scalar value or an
            // aggregate pointer — either way just one register-width word) to its
            // own temp slot immediately after compiling it, so the next element's
            // compile_or() never clobbers an earlier one. Once all N are known,
            // allocate one buffer sized to the true sum of every element's slots
            // and copy each into its correct cumulative offset.
            // (A prior version only preserved the FIRST and LAST elements — any
            // middle element's compiled value was silently overwritten by the
            // next element's compile_or() before ever being stored anywhere, and
            // the buffer was sized first+last only, dropping every middle
            // element's slots too. Bug G / issue #601: this both mistyped and,
            // for tuples of 3+ same-typed elements, silently duplicated values.)
            var elem_ty: [i64; 16] = [0; 16]
            var elem_hash: [i64; 16] = [0; 16]
            var elem_nslots: [i64; 16] = [0; 16]
            var elem_slot: [i64; 16] = [0; 16]
            var n: i64 = 0
            elem_ty[0] = EXPR_TY
            elem_hash[0] = EXPR_TY_HASH
            elem_nslots[0] = ty_slot_count(EXPR_TY, EXPR_TY_HASH)
            elem_slot[0] = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var(elem_slot[0])
            n = 1
            while ep_before_body_close() && TK[EP as usize] == 28 {
                EP = EP + 1  // skip ,
                if TK[EP as usize] == 7 { break }  // trailing comma
                compile_or()
                if n >= 16 {
                    tc_error_hard(EP, "tuple literal exceeds maximum of 16 elements")
                    n = n + 1
                } else {
                    elem_ty[n as usize] = EXPR_TY
                    elem_hash[n as usize] = EXPR_TY_HASH
                    elem_nslots[n as usize] = ty_slot_count(EXPR_TY, EXPR_TY_HASH)
                    elem_slot[n as usize] = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + 1
                    emit_store_var(elem_slot[n as usize])
                    n = n + 1
                }
            }
            if TK[EP as usize] == 7 { EP = EP + 1 }  // skip )
            let tup_count = n
            var real_n = n
            if real_n > 16 { real_n = 16 }
            // Allocate the tuple buffer sized to the sum of every element's slots.
            var total_slots: i64 = 0
            var i: i64 = 0
            while i < real_n { total_slots = total_slots + elem_nslots[i as usize]; i = i + 1 }
            let tup_base = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + total_slots
            // Element i sits at slot (tup_base + total_slots - 1 - prefix_sum(i)),
            // where prefix_sum(i) = sum of elem_nslots[0..i-1] — element 0 at the
            // highest slot number (lowest address, the pointer this expression
            // returns), later elements at successively higher addresses.
            var prefix: i64 = 0
            i = 0
            while i < real_n {
                let dst_start = tup_base + total_slots - 1 - prefix
                em(0x48); em(0x8b); em(0x85); em32(0 - elem_slot[i as usize] * 8)  // restore rax
                if elem_nslots[i as usize] > 1 {
                    copy_agg_into_struct_slots_x86(dst_start, elem_ty[i as usize], elem_hash[i as usize])
                } else {
                    emit_store_var(dst_start)
                }
                prefix = prefix + elem_nslots[i as usize]
                i = i + 1
            }
            // Return pointer to element 0 (lowest address).
            em(0x48); em(0x8d); em(0x85)
            em32(0 - (tup_base + total_slots - 1) * 8)
            EXPR_IS_F64 = 0
            EXPR_TY = 6
            let first_ty = elem_ty[0]
            let first_hash = elem_hash[0]
            let first_nslots = elem_nslots[0]
            let last_ty = elem_ty[(real_n - 1) as usize]
            let last_hash = elem_hash[(real_n - 1) as usize]
            // Encode first_nslots, total_slots, and per-element f64-ness.
            // Format: tcount*100M + first_f64*10M + last_f64*1M + first_nslots*1000 + total_nslots
            let first_actual = if first_nslots > 1 { first_nslots } else { 1 }
            // Element-kind code (1=f64, 2=bool, 0=other) — see scan_type: encoding
            // bool as 2 keeps (Big,bool) and (Big,i64) hash-distinct so the element
            // cache doesn't collide and mistype `.1`. f64 decoders still test `== 1`.
            var first_f64_flag: i64 = 0
            if first_ty == 2 { first_f64_flag = 1 } else if first_ty == 4 { first_f64_flag = 2 }
            var last_f64_flag: i64 = 0
            if last_ty == 2 { last_f64_flag = 1 } else if last_ty == 4 { last_f64_flag = 2 }
            EXPR_TY_HASH = (first_hash % 1000) * 1000000000000000 + (last_hash % 1000000) * 1000000000 + tup_count * 100000000 + first_f64_flag * 10000000 + last_f64_flag * 1000000 + first_actual * 1000 + total_slots
            i = 0
            while i < real_n {
                TUP_SCRATCH_ELEM_TY[i as usize] = elem_ty[i as usize]
                TUP_SCRATCH_ELEM_HASH[i as usize] = elem_hash[i as usize]
                i = i + 1
            }
            TUP_SCRATCH_COUNT = real_n
            tup_cache_register(EXPR_TY_HASH, first_ty, first_hash, last_ty, last_hash)
            return
        }
        if TK[EP as usize] == 7 { EP = EP + 1 }
        return
    }
    if k == 44 { compile_borrow_primary_x86(); return }
    // Dereference: *expr → compile expr, then load from pointer
    if k == 19 {
        EP = EP + 1
        compile_primary()
        compile_postfix_tail()
        if EXPR_TY != 0 && type_is_pointer_like(EXPR_TY, EXPR_TY_HASH) == false { tc_error(EP - 1, "dereference requires reference operand") }
        if type_is_pointer_like(EXPR_TY, EXPR_TY_HASH) {
            let deref_ref_hash = EXPR_TY_HASH
            let deref_inner_hash = ptr_hash_inner_hash(deref_ref_hash)
            let deref_inner_ty = ptr_hash_inner_ty(deref_ref_hash)
            if type_is_aggregate(deref_inner_ty, deref_inner_hash) == false {
                em(0x48); em(0x8b); em(0x00)  // mov rax, [rax] — scalar dereference
            }
            EXPR_TY = deref_inner_ty
            EXPR_TY_HASH = deref_inner_hash
        } else {
            em(0x48); em(0x8b); em(0x00)  // mov rax, [rax]
            EXPR_TY = 0
            EXPR_TY_HASH = 0
        }
        if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
        return
    }
    // Unary minus
    if k == 18 {
        let op_tok = EP
        EP = EP + 1
        compile_primary()
        compile_postfix_tail()
        if EXPR_TY != 0 && ty_is_numeric(EXPR_TY) == false { tc_error_hard(op_tok, "unary - requires numeric operand") }
        // EXPR_IS_F64 kept from inner expression (unary minus preserves type)
        if EXPR_IS_F64 == 1 {
            // f64 negate: flip sign bit (bit 63)
            em(0x48); em(0x0f); em(0xba); em(0xf8); em(63)  // btc rax, 63
        } else {
            em(0x48); em(0xf7); em(0xd8)  // neg rax
            // Track negation in literal value so compile-time refinement checks use -N not N
            if LAST_IS_LITERAL != 0 { LAST_LITERAL_VAL = 0 - LAST_LITERAL_VAL }
        }
        return
    }
    // Unary bitwise NOT ~
    if k == 55 {
        let op_tok = EP
        EP = EP + 1
        compile_primary()
        compile_postfix_tail()
        if EXPR_TY != 0 && EXPR_TY != 1 { tc_error(op_tok, "bitwise not requires integer operand") }
        em(0x48); em(0xf7); em(0xd0)  // not rax
        EXPR_IS_F64 = 0
        EXPR_TY = 1
        return
    }
    // Unary not !
    if k == 32 {
        let op_tok = EP
        EP = EP + 1
        compile_primary()
        compile_postfix_tail()
        if EXPR_TY != 0 && EXPR_TY != 4 { tc_error_hard(op_tok, "logical not requires bool operand") }
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x0f); em(0x94); em(0xc0)  // sete al
        em(0x48); em(0x0f); em(0xb6); em(0xc0)  // movzx rax, al
        EXPR_IS_F64 = 0
        EXPR_TY = 4
        return
    }
    // String literal: embed in code section with jmp-over, return address via lea
    if k == 5 {
        let ss = TS[EP as usize] + 1
        let se = TE[EP as usize] - 1
        // Decode string bytes
        var slen: i64 = 0
        var zi: i64 = 0
        while zi < 256 { SQW[zi as usize] = 0; zi = zi + 1 }
        var si: i64 = ss
        while si < se {
            let ch = sb(si)
            var byte: i64 = ch
            if ch == 92 && si + 1 < se {
                let c2 = sb(si + 1)
                if c2 == 120 && si + 3 < se {
                    let h1 = sb(si + 2)
                    let h2 = sb(si + 3)
                    var v1: i64 = 0 - 1
                    if h1 >= 48 && h1 <= 57 { v1 = h1 - 48 }
                    else if h1 >= 97 && h1 <= 102 { v1 = h1 - 87 }
                    else if h1 >= 65 && h1 <= 70 { v1 = h1 - 55 }
                    var v2: i64 = 0 - 1
                    if h2 >= 48 && h2 <= 57 { v2 = h2 - 48 }
                    else if h2 >= 97 && h2 <= 102 { v2 = h2 - 87 }
                    else if h2 >= 65 && h2 <= 70 { v2 = h2 - 55 }
                    if v1 >= 0 && v2 >= 0 {
                        byte = v1 * 16 + v2
                        si = si + 4
                    } else {
                        byte = c2
                        si = si + 2
                    }
                } else {
                    if c2 == 110 { byte = 10 }
                    else if c2 == 116 { byte = 9 }
                    else if c2 == 48 { byte = 0 }
                    else { byte = c2 }
                    si = si + 2
                }
            } else { si = si + 1 }
            SQW[slen as usize] = byte
            slen = slen + 1
        }
        // Emit: jmp over string data; string bytes; null terminator; lea rax, [rip - N]
        em(0xeb)  // jmp rel8
        let jmp_off = CL
        em(slen + 1)  // skip slen + null terminator
        let str_start = CL
        var bi: i64 = 0
        while bi < slen { em(SQW[bi as usize] & 0xFF); bi = bi + 1 }
        em(0)  // null terminator
        // lea rax, [rip - (CL - str_start)]
        let disp = str_start - (CL + 7)
        em(0x48); em(0x8d); em(0x05)  // lea rax, [rip + disp32]
        em32(disp)
        EP = EP + 1
        EXPR_IS_F64 = 0
        EXPR_TY = 3
        return
    }
    // Identifier or function call
    if k == 3 || k == 79 {
        var ns: i64 = TS[EP as usize]
        var ne: i64 = TE[EP as usize]
        EP = EP + 1
        let name_tok = EP - 1
        // Soft keyword: async { block } — Phase 1: eager eval, identity semantics (no thread)
        if src_match(ns, ne - ns, "async") && TK[EP as usize] == 8 {
            EP = EP + 1  // skip {
            LAST_STMT_HAS_VALUE = 0; LAST_STMT_TY = 0; LAST_STMT_TY_HASH = 0
            while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
            if TK[EP as usize] == 9 { EP = EP + 1 }  // skip }
            EXPR_TY = LAST_STMT_TY
            EXPR_TY_HASH = LAST_STMT_TY_HASH
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
            return
        }
        // Soft keyword: spawn { block } — Phase 1: fork(2) + MAP_SHARED mmap result slot
        if src_match(ns, ne - ns, "spawn") && TK[EP as usize] == 8 {
            let sp_slot_slot = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            let sp_fork_slot = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            // mmap(NULL, 4096, PROT_READ|PROT_WRITE, MAP_SHARED|MAP_ANONYMOUS, -1, 0)
            em(0x48); em(0x31); em(0xff)            // xor rdi, rdi
            em(0xbe); em32(4096)                    // mov esi, 4096
            em(0xba); em32(3)                       // mov edx, 3
            em(0x41); em(0xba); em32(0x21)          // mov r10d, 0x21 (MAP_SHARED|MAP_ANONYMOUS)
            em(0x49); em(0xc7); em(0xc0); em32(-1)  // mov r8, -1
            em(0x4d); em(0x31); em(0xc9)            // xor r9, r9
            em(0xb8); em32(9)                       // mov eax, 9 (SYS_mmap)
            em(0x0f); em(0x05)                      // syscall
            emit_store_var(sp_slot_slot)
            em(0xb8); em32(57)                      // mov eax, 57 (SYS_fork)
            em(0x0f); em(0x05)                      // syscall
            emit_store_var(sp_fork_slot)
            em(0x48); em(0x85); em(0xc0)            // test rax, rax
            em(0x0f); em(0x85)                      // jnz rel32 (parent skips child body)
            let sp_jnz_off = CL; em32(0)
            // Child path: execute block, store result, exit
            EP = EP + 1  // skip {
            LAST_STMT_HAS_VALUE = 0; LAST_STMT_TY = 0; LAST_STMT_TY_HASH = 0
            while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
            if TK[EP as usize] == 9 { EP = EP + 1 }  // skip }
            // Block result is in rax; save then store to shared slot
            em(0x48); em(0x89); em(0xc6)            // mov rsi, rax  ; save block result
            emit_load_var(sp_slot_slot)              // rax = slot_ptr
            em(0x48); em(0x89); em(0x30)            // mov [rax], rsi  ; slot[0] = result
            em(0x31); em(0xff)                      // xor edi, edi
            em(0xb8); em32(60)                      // mov eax, 60 (SYS_exit)
            em(0x0f); em(0x05)                      // syscall
            // Parent path: patch jnz target here
            patch32(sp_jnz_off, CL)
            let sp_handle_base = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 2
            emit_load_var(sp_fork_slot)
            emit_store_var(sp_handle_base + 1)      // pid at slot+1 → [ptr+0]
            emit_load_var(sp_slot_slot)
            emit_store_var(sp_handle_base)          // slot_ptr at slot+0 → [ptr+8]
            em(0x48); em(0x8d); em(0x85)
            em32(0 - (sp_handle_base + 1) * 8)     // lea rax, [rbp + offset_of_pid]
            EXPR_TY = 100
            EXPR_TY_HASH = 0
            EXPR_IS_F64 = 0
            return
        }
        // Soft keyword: channel::<T>() — Phase 1: pipe2(2) returns (ChanTx, ChanRx) pair
        if src_match(ns, ne - ns, "channel") && TK[EP as usize] == 51 {
            EP = EP + 1  // skip ::
            // Skip turbofish <T>
            if TK[EP as usize] == 23 {
                EP = EP + 1  // skip <
                var td: i64 = 1
                while td > 0 && TK[EP as usize] != 0 {
                    if TK[EP as usize] == 23 { td = td + 1 }
                    if TK[EP as usize] == 24 { td = td - 1 }
                    EP = EP + 1
                }
            }
            if TK[EP as usize] == 6 { EP = EP + 1 }  // skip (
            if TK[EP as usize] == 7 { EP = EP + 1 }  // skip )
            // Allocate one stack slot as int[2] buffer for pipe2
            let ch_fds_slot = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            // lea rdi, [rbp + (0 - ch_fds_slot*8)]  — fds pointer
            em(0x48); em(0x8d); em(0xbd); em32(0 - ch_fds_slot * 8)
            em(0xbe); em32(0x80000)         // mov esi, O_CLOEXEC (flags)
            em(0xb8); em32(293)              // mov eax, 293 (SYS_pipe2)
            em(0x0f); em(0x05)              // syscall
            // Sign-extend read_fd = int at [rbp + (0-ch_fds_slot*8) + 0]
            em(0x48); em(0x63); em(0x85); em32(0 - ch_fds_slot * 8)
            let ch_read_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var(ch_read_slot)
            // Sign-extend write_fd = int at [rbp + (0-ch_fds_slot*8) + 4]
            em(0x48); em(0x63); em(0x85); em32(0 - ch_fds_slot * 8 + 4)
            let ch_write_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var(ch_write_slot)
            // Build 2-slot tuple [write_fd at ptr+0, read_fd at ptr+8] for (tx, rx)
            let ch_pair_base = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 2
            emit_load_var(ch_write_slot)
            emit_store_var(ch_pair_base + 1)  // write_fd at [ptr+0] → tx
            emit_load_var(ch_read_slot)
            emit_store_var(ch_pair_base)      // read_fd at [ptr+8] → rx
            em(0x48); em(0x8d); em(0x85); em32(0 - (ch_pair_base + 1) * 8)
            EXPR_TY = 6
            EXPR_TY_HASH = 1002
            EXPR_IS_F64 = 0
            return
        }
        // Soft keyword: sleep(ms: i64) → nanosleep(2) (SYS 35), ms in milliseconds
        if src_match(ns, ne - ns, "sleep") && TK[EP as usize] == 6 {
            EP = EP + 1  // skip (
            compile_or()  // ms value in rax
            if TK[EP as usize] == 7 { EP = EP + 1 }  // skip )
            let sl_ms_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var(sl_ms_slot)
            let ts_base = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 2
            // tv_sec = ms / 1000 (idiv), tv_nsec = (ms % 1000) * 1_000_000
            emit_load_var(sl_ms_slot)
            em(0xb9); em32(1000)                         // mov ecx, 1000
            em(0x48); em(0x99)                           // cqo
            em(0x48); em(0xf7); em(0xf9)                 // idiv rcx  ; rax=ms/1000, rdx=ms%1000
            emit_store_var(ts_base + 1)                  // tv_sec at offset 0 (lower addr)
            em(0x48); em(0x69); em(0xd2); em32(1000000)  // imul rdx, rdx, 1_000_000
            em(0x48); em(0x89); em(0xd0)                 // mov rax, rdx
            emit_store_var(ts_base)                      // tv_nsec at offset 8 (higher addr)
            // nanosleep(&timespec, NULL)
            em(0x48); em(0x8d); em(0xbd); em32(0 - (ts_base + 1) * 8)  // lea rdi, [rbp - (ts_base+1)*8]
            em(0x48); em(0x31); em(0xf6)                 // xor rsi, rsi
            em(0xb8); em32(35)                           // mov eax, 35 (SYS_nanosleep)
            em(0x0f); em(0x05)                           // syscall
            EXPR_TY = 0; EXPR_TY_HASH = 0; EXPR_IS_F64 = 0
            return
        }
        // Soft keyword: join(h1, h2) → sequential wait4, returns (r1, r2) 2-tuple
        if src_match(ns, ne - ns, "join") && TK[EP as usize] == 6 {
            EP = EP + 1  // skip (
            compile_or()  // h1 TaskHandle pointer in rax
            let j_h1_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var(j_h1_slot)
            if TK[EP as usize] == 28 { EP = EP + 1 }  // skip ,
            compile_or()  // h2 TaskHandle pointer in rax
            let j_h2_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var(j_h2_slot)
            if TK[EP as usize] == 7 { EP = EP + 1 }  // skip )
            // Await h1: wait4(pid1) + read slot1 result
            let j_r1_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
            emit_load_var(j_h1_slot)
            em(0x48); em(0x8b); em(0x00)           // mov rax, [rax]  ; pid
            em(0x48); em(0x89); em(0xc7)            // mov rdi, rax
            em(0x48); em(0x31); em(0xf6)            // xor rsi, rsi
            em(0x48); em(0x31); em(0xd2)            // xor rdx, rdx
            em(0x4d); em(0x31); em(0xd2)            // xor r10, r10
            em(0xb8); em32(61)                      // mov eax, 61 (SYS_wait4)
            em(0x0f); em(0x05)                      // syscall
            emit_load_var(j_h1_slot)
            em(0x48); em(0x8b); em(0x40); em(8)    // mov rax, [rax+8]  ; slot_ptr
            em(0x48); em(0x8b); em(0x00)            // mov rax, [rax]    ; result
            emit_store_var(j_r1_slot)
            // Await h2: wait4(pid2) + read slot2 result
            let j_r2_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
            emit_load_var(j_h2_slot)
            em(0x48); em(0x8b); em(0x00)           // mov rax, [rax]  ; pid
            em(0x48); em(0x89); em(0xc7)            // mov rdi, rax
            em(0x48); em(0x31); em(0xf6)            // xor rsi, rsi
            em(0x48); em(0x31); em(0xd2)            // xor rdx, rdx
            em(0x4d); em(0x31); em(0xd2)            // xor r10, r10
            em(0xb8); em32(61)                      // mov eax, 61 (SYS_wait4)
            em(0x0f); em(0x05)                      // syscall
            emit_load_var(j_h2_slot)
            em(0x48); em(0x8b); em(0x40); em(8)    // mov rax, [rax+8]  ; slot_ptr
            em(0x48); em(0x8b); em(0x00)            // mov rax, [rax]    ; result
            emit_store_var(j_r2_slot)
            // Build 2-tuple (r1, r2): r1 at offset 0, r2 at offset 8
