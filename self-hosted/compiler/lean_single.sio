    em(0x0f); em(0x84); let argc6 = CL; em32(0)
    emit_store_imm64_to_rbx_disp_x86(task_rec_state_off_x86(), task_state_failed_x86())
    em(0x31); em(0xc0)
    em(0xe9); let call_done = CL; em32(0)
