        EXPR_IS_F64 = 0
        EXPR_TY = 8
        EXPR_TY_HASH = arr_ty_hash_for_elem_type(arr_count, 8, elem_ty, elem_hash)
        LAST_ALEN = arr_count
        return
    }
    // Closure stub
    if k == 45 || k == 31 {
        var zero_param_closure_a: i64 = 0
        if k == 31 { zero_param_closure_a = 1 }
