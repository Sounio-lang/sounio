        let cl_start_a = CL
        em32(0xA9BF7BFD)
        em32(0x910003FD)
        emit_imm64_reg_a64_patchable(9)
        em32(0xCB2963FF)
        emit_store_incoming_arg_a64(0, 1)
        var pstore_a: i64 = 0
        while pstore_a < nparams_a {
            emit_store_incoming_arg_a64(pstore_a + 1, 2 + pstore_a)
            pstore_a = pstore_a + 1
        }
        var capi_a: i64 = 0
        while capi_a < CL_CAP_COUNT {
            emit_load_var_a64(1)
            em32(0xF9400000 | ((capi_a + 1) << 10) | (0 << 5) | 0)
