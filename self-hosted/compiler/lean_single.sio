                            var seen_i: i64 = 0
                            while seen_i < field_count {
                                if ST[(si * 130 + 2 + seen_i) as usize] == fh {
                                    let decl_fns = ST_FNS[(si * 128 + seen_i) as usize]
                                    let decl_fne = ST_FNE[(si * 128 + seen_i) as usize]
                                    if src_region_eq(fns, fne - fns, decl_fns, decl_fne - decl_fns) {
                                        if seen_i < 62 { seen_field_mask = seen_field_mask | (1 << seen_i) }
                                        seen_i = field_count
                                    }
                                }
                                seen_i = seen_i + 1
                            }
                            let dst_start = base_slot + total_slots - 1 - foff / 8
                            if fty == 8 && TK[EP as usize] == 41 && array_init_is_repeat(EP) {
                                EP = EP + 1
                                compile_or_a64()
                                if ty_eq(arr_hash_elem_ty(fhash), arr_hash_elem_hash(fhash), EXPR_TY, EXPR_TY_HASH) == false {
                                    tc_error(field_tok, "array repeat element type does not match field type")
                                }
                                if TK[EP as usize] == 27 { EP = EP + 1 }
                                let rep_count = TV[EP as usize]
                                EP = EP + 1
                                if TK[EP as usize] == 42 { EP = EP + 1 }
                                if rep_count != arr_hash_alen(fhash) {
                                    tc_error(field_tok, "array repeat length does not match field type")
                                }
                                fill_repeat_struct_array_slots_a64(dst_start, fhash)
                            } else {
                                compile_or_a64()
                                try_apply_field_alias_refinement(fhash, field_tok)
                                if fty != 0 && ty_eq(fty, fhash, EXPR_TY, EXPR_TY_HASH) == false {
                                    tc_error(field_tok, "field initializer type does not match struct field")
                                }
                                // β¹⁰: Knowledge<T> fields have fty==0; enforce type match separately
                                if fty == 0 && knowledge_hash_is(fhash) && ty_eq(0, fhash, EXPR_TY, EXPR_TY_HASH) == false {
                                    tc_linear_violation(field_tok, "field initializer type does not match Knowledge field type")
                                }
                                copy_agg_into_struct_slots_a64(dst_start, fty, fhash)
                            }
                        } else { tc_error(field_tok, "unknown field in struct literal"); compile_or_a64() }
                    }
                    if TK[EP as usize] == 28 { EP = EP + 1 }
                }
                let required_fields = ST[(si * 130 + 1) as usize]
                var miss_i: i64 = 0
                while miss_i < required_fields {
                    if miss_i < 62 && (seen_field_mask & (1 << miss_i)) == 0 {
                        tc_error(EP - 1, "missing field in struct literal")
                        miss_i = required_fields
                    } else {
                        miss_i = miss_i + 1
                    }
                }
                if TK[EP as usize] == 9 { EP = EP + 1 }
                emit_lea_var_a64(base_slot + total_slots - 1)
                EXPR_IS_F64 = 0
                EXPR_TY = 6
                EXPR_TY_HASH = sh
                LAST_EXPR_IS_LINEAR = ST_LINEAR[si as usize]
                return
            }
        }
        // Array subscript
        if TK[EP as usize] == 41 {
            EP = EP + 1
            compile_or_a64()
            if EXPR_TY != 0 && EXPR_TY != 1 {
                tc_error(EP - 1, "array index must be integer")
            }
            if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
            if TK[EP as usize] == 42 { EP = EP + 1 }
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                let base = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                let esz = GL[(gi * 4 + 2) as usize]
                var elem_ty = arr_hash_elem_ty(GL_TY_HASH[gi as usize])
                let elem_hash = arr_hash_elem_hash(GL_TY_HASH[gi as usize])
                em32(0xAA0003E9)
                emit_image_addr_a64(base)
                if esz == 8 {
                    em32(0xF8697800)
                    EXPR_TY = elem_ty
                    EXPR_TY_HASH = elem_hash
                    if elem_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                }
                else if esz > 8 {
                    // Struct-element array: x0 = base + index * esiz (pointer to element).
                    // x9 = index (set above), x0 = base (set above).
                    // MOVZ x10, #esiz (fits in 16-bit for any reasonable struct).
                    em32(0xD280000A | (esz * 32))  // movz x10, #esiz
                    em32(0x9B0A7D29)  // mul x9, x9, x10
                    em32(0x8B090000)  // add x0, x0, x9
                    EXPR_TY = elem_ty
                    EXPR_TY_HASH = elem_hash
                    EXPR_IS_F64 = 0
                }
                else {
                    em32(0x38A96800)
                    EXPR_TY = 1
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 0
                }
            } else {
                let slot = var_find(ns, ne)
                if slot >= 0 {
                    let lalen = var_find_alen(ns, ne)
                    let lesiz = var_find_esiz(ns, ne)
                    let lvi = var_find_idx(ns, ne)
                    var elem_ty = 1
                    var elem_hash: i64 = 0
                    var is_arr_ty = 0
                    var is_slice_ty = 0
                    if lvi >= 0 {
                        elem_ty = arr_hash_elem_ty(VAR_TY_HASH[lvi as usize])
                        elem_hash = arr_hash_elem_hash(VAR_TY_HASH[lvi as usize])
                        if VAR_TY[lvi as usize] == 8 { is_arr_ty = 1 }
                        if VAR_TY[lvi as usize] == 10 {
                            if ref_hash_inner_ty(VAR_TY_HASH[lvi as usize]) == 8 {
                                is_arr_ty = 1
                                if type_is_slice_ref(VAR_TY[lvi as usize], VAR_TY_HASH[lvi as usize]) { is_slice_ty = 1 }
                                if arr_hash_elem_ty(ref_hash_inner_hash(VAR_TY_HASH[lvi as usize])) != 0 {
                                    elem_ty = arr_hash_elem_ty(ref_hash_inner_hash(VAR_TY_HASH[lvi as usize]))
                                }
                                elem_hash = arr_hash_elem_hash(ref_hash_inner_hash(VAR_TY_HASH[lvi as usize]))
                            }
                        }
                    }
                    em32(0xAA0003EA)  // mov x10, x0 (index — x10 survives emit_load_var_a64's x9 clobber)
                    if is_slice_ty == 1 {
                        emit_load_var_a64(VAR_LEN_SLOT[lvi as usize])
                        em32(0xAA0003EB)  // mov x11, x0
                        em32(0xEB0B015F)  // cmp x10, x11
                        let slice_ok_local_a = CL
                        em32(0x54000003)  // b.lo ok
                        emit_assert_fail_a64()
                        patch_branch_a64(slice_ok_local_a, CL)
                    }
                    emit_load_var_a64(slot)
                    if is_arr_ty == 1 && lesiz == 8 {
                        em32(0xF86A7800)  // ldr x0, [x0, x10, lsl #3]
                        EXPR_TY = elem_ty
                        EXPR_TY_HASH = elem_hash
                        if elem_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                    } else if is_arr_ty == 1 && lesiz == 1 {
                        em32(0x386A6800)  // ldrb w0, [x0, x10]
                        EXPR_TY = 1
                        EXPR_TY_HASH = 0
                        EXPR_IS_F64 = 0
                    } else {
                        if lvi >= 0 && VAR_TY[lvi as usize] != 0 && VAR_TY[lvi as usize] != 3 {
                            tc_error(name_tok, "value is not indexable")
                        }
                        em32(0x386A6800)  // ldrb w0, [x0, x10]
                        EXPR_TY = 1
                        EXPR_TY_HASH = 0
                        EXPR_IS_F64 = 0
                    }
                } else {
                    tc_undefined_var(name_tok)
                    em32(0xD2800000)
                    EXPR_TY = 0
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 0
                }
            }
            return
        }
        // Variable load
        let slot = var_find(ns, ne)
        if slot >= 0 {
            let vi = var_find_idx(ns, ne)
            if vi >= 0 && type_is_slice_ref(VAR_TY[vi as usize], VAR_TY_HASH[vi as usize]) {
                emit_lea_var_a64(slot)
            } else if vi >= 0 && type_is_option_inline(VAR_TY[vi as usize], VAR_TY_HASH[vi as usize]) && VAR_ESIZ[vi as usize] >= 16 {
                emit_lea_var_a64(slot)
            } else {
                emit_load_var_a64(slot)
            }
            EXPR_IS_F64 = var_find_is_f64(ns, ne)
            if vi >= 0 {
                EXPR_TY = VAR_TY[vi as usize]
                EXPR_TY_HASH = VAR_TY_HASH[vi as usize]
                if VAR_ALEN[vi as usize] > 0 { LAST_ALEN = VAR_ALEN[vi as usize] }
                if VAR_IS_CLOSURE[vi as usize] == 1 { LAST_EXPR_IS_CLOSURE = 1 }
                // β⁴: propagate variance/sensitivity shadow for this variable
                EXPR_VSHADOW = VAR_VSHADOW[vi as usize]
                EXPR_SSHADOW = VAR_SSHADOW[vi as usize]
                EXPR_SSHADOW_1 = VAR_SSHADOW_1[vi as usize]
                EXPR_SSHADOW_2 = VAR_SSHADOW_2[vi as usize]
                EXPR_SSHADOW_3 = VAR_SSHADOW_3[vi as usize]
                EXPR_SSHADOW_4 = VAR_SSHADOW_4[vi as usize]
                EXPR_SSHADOW_5 = VAR_SSHADOW_5[vi as usize]
                EXPR_SSHADOW_6 = VAR_SSHADOW_6[vi as usize]
                EXPR_SSHADOW_7 = VAR_SSHADOW_7[vi as usize]
                EXPR_HSHADOW_00 = VAR_HSHADOW_00[vi as usize]
                EXPR_HSHADOW_01 = VAR_HSHADOW_01[vi as usize]
                EXPR_HSHADOW_02 = VAR_HSHADOW_02[vi as usize]
                EXPR_HSHADOW_03 = VAR_HSHADOW_03[vi as usize]
                EXPR_HSHADOW_11 = VAR_HSHADOW_11[vi as usize]
                EXPR_HSHADOW_12 = VAR_HSHADOW_12[vi as usize]
                EXPR_HSHADOW_13 = VAR_HSHADOW_13[vi as usize]
                EXPR_HSHADOW_22 = VAR_HSHADOW_22[vi as usize]
                EXPR_HSHADOW_23 = VAR_HSHADOW_23[vi as usize]
                EXPR_HSHADOW_33 = VAR_HSHADOW_33[vi as usize]
                EXPR_HSHADOW_04 = VAR_HSHADOW_04[vi as usize]
                EXPR_HSHADOW_05 = VAR_HSHADOW_05[vi as usize]
                EXPR_HSHADOW_06 = VAR_HSHADOW_06[vi as usize]
                EXPR_HSHADOW_07 = VAR_HSHADOW_07[vi as usize]
                EXPR_HSHADOW_14 = VAR_HSHADOW_14[vi as usize]
                EXPR_HSHADOW_15 = VAR_HSHADOW_15[vi as usize]
                EXPR_HSHADOW_16 = VAR_HSHADOW_16[vi as usize]
                EXPR_HSHADOW_17 = VAR_HSHADOW_17[vi as usize]
                EXPR_HSHADOW_24 = VAR_HSHADOW_24[vi as usize]
                EXPR_HSHADOW_25 = VAR_HSHADOW_25[vi as usize]
                EXPR_HSHADOW_26 = VAR_HSHADOW_26[vi as usize]
                EXPR_HSHADOW_27 = VAR_HSHADOW_27[vi as usize]
                EXPR_HSHADOW_34 = VAR_HSHADOW_34[vi as usize]
                EXPR_HSHADOW_35 = VAR_HSHADOW_35[vi as usize]
                EXPR_HSHADOW_36 = VAR_HSHADOW_36[vi as usize]
                EXPR_HSHADOW_37 = VAR_HSHADOW_37[vi as usize]
                EXPR_HSHADOW_44 = VAR_HSHADOW_44[vi as usize]
                EXPR_HSHADOW_45 = VAR_HSHADOW_45[vi as usize]
                EXPR_HSHADOW_46 = VAR_HSHADOW_46[vi as usize]
                EXPR_HSHADOW_47 = VAR_HSHADOW_47[vi as usize]
                EXPR_HSHADOW_55 = VAR_HSHADOW_55[vi as usize]
                EXPR_HSHADOW_56 = VAR_HSHADOW_56[vi as usize]
                EXPR_HSHADOW_57 = VAR_HSHADOW_57[vi as usize]
                EXPR_HSHADOW_66 = VAR_HSHADOW_66[vi as usize]
                EXPR_HSHADOW_67 = VAR_HSHADOW_67[vi as usize]
                EXPR_HSHADOW_77 = VAR_HSHADOW_77[vi as usize]
                // β⁹ GTT: restore the variable's channel topology on load (a64 path).
                EXPR_CH_SET = VAR_CH_SET[vi as usize]
                EXPR_PARAM_USED = VAR_PARAM_USED[vi as usize]
            } else {
                EXPR_VSHADOW = -1
                EXPR_SSHADOW = -1
                EXPR_SSHADOW_1 = -1; EXPR_SSHADOW_2 = -1; EXPR_SSHADOW_3 = -1; EXPR_SSHADOW_4 = -1; EXPR_SSHADOW_5 = -1; EXPR_SSHADOW_6 = -1; EXPR_SSHADOW_7 = -1
                EXPR_HSHADOW_00 = -1; EXPR_HSHADOW_01 = -1; EXPR_HSHADOW_02 = -1; EXPR_HSHADOW_03 = -1
                EXPR_HSHADOW_11 = -1; EXPR_HSHADOW_12 = -1; EXPR_HSHADOW_13 = -1
                EXPR_HSHADOW_22 = -1; EXPR_HSHADOW_23 = -1; EXPR_HSHADOW_33 = -1
                EXPR_HSHADOW_04 = -1; EXPR_HSHADOW_05 = -1; EXPR_HSHADOW_06 = -1; EXPR_HSHADOW_07 = -1
                EXPR_HSHADOW_14 = -1; EXPR_HSHADOW_15 = -1; EXPR_HSHADOW_16 = -1; EXPR_HSHADOW_17 = -1
                EXPR_HSHADOW_24 = -1; EXPR_HSHADOW_25 = -1; EXPR_HSHADOW_26 = -1; EXPR_HSHADOW_27 = -1
                EXPR_HSHADOW_34 = -1; EXPR_HSHADOW_35 = -1; EXPR_HSHADOW_36 = -1; EXPR_HSHADOW_37 = -1
                EXPR_HSHADOW_44 = -1; EXPR_HSHADOW_45 = -1; EXPR_HSHADOW_46 = -1; EXPR_HSHADOW_47 = -1
                EXPR_HSHADOW_55 = -1; EXPR_HSHADOW_56 = -1; EXPR_HSHADOW_57 = -1
                EXPR_HSHADOW_66 = -1; EXPR_HSHADOW_67 = -1
                EXPR_HSHADOW_77 = -1
                EXPR_CH_SET = 0
                EXPR_PARAM_USED = 0
            }
            var_mark_used(ns, ne)
        } else {
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                emit_image_addr_a64(GL_BSS_BASE + GL[(gi * 4 + 1) as usize])
                if GL[(gi * 4 + 3) as usize] == 0 {
                    if type_is_struct_like(GL_TY[gi as usize], GL_TY_HASH[gi as usize]) == false {
                        if type_is_option_inline(GL_TY[gi as usize], GL_TY_HASH[gi as usize]) == false || GL[(gi * 4 + 2) as usize] < 16 {
                            em32(0xF9400000)
                        }
                    }
                }
                EXPR_TY = GL_TY[gi as usize]
                EXPR_TY_HASH = GL_TY_HASH[gi as usize]
                if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
            } else {
                let fri = fn_find(TS[(EP - 1) as usize], TE[(EP - 1) as usize])
                if fri >= 0 {
                    // Mirror the x86 named-fn contract: every fn-typed value is
                    // materialized as a closure-ABI callable.  On arm64 the thunk
                    // tail-branches to the real function after dropping env_ptr.
                    let fn_arity = FN_ARITY[fri as usize]
                    let skip_thunk = CL
                    em32(0x14000000)
                    let thunk_start = CL
                    if fn_arity >= 1 { em32(0xAA0103E0) }  // mov x0, x1
                    if fn_arity >= 2 { em32(0xAA0203E1) }  // mov x1, x2
                    if fn_arity >= 3 { em32(0xAA0303E2) }  // mov x2, x3
                    if fn_arity >= 4 { em32(0xAA0403E3) }  // mov x3, x4
                    if fn_arity >= 5 { em32(0xAA0503E4) }  // mov x4, x5
                    if fn_arity >= 6 { em32(0xAA0603E5) }  // mov x5, x6
                    if fn_arity >= 7 { em32(0xAA0703E6) }  // mov x6, x7
                    if FN_OFF[fri as usize] != -1 {
                        let rel = (FN_OFF[fri as usize] - CL) / 4
                        em32(0x14000000 | (rel & 0x3FFFFFF))
                    } else {
                        PATCH_OFF[PATCH_COUNT as usize] = CL
                        PATCH_FN[PATCH_COUNT as usize] = fri
                        PATCH_KIND[PATCH_COUNT as usize] = 2
                        PATCH_COUNT = PATCH_COUNT + 1
                        em32(0x14000000)
                    }
                    patch_branch_a64(skip_thunk, CL)
                    // Named fn refs may escape their defining frame. Mirror
                    // x86: return a tagged thunk pointer (bit 0 = fn ref)
                    // instead of a caller-stack closure cell.
                    let adr_off = thunk_start - CL
                    let adr_immlo = adr_off & 0x3
                    let adr_immhi = (adr_off >> 2) & 0x7FFFF
                    em32(0x10000000 | ((adr_immlo & 0x3) << 29) | ((adr_immhi & 0x7FFFF) << 5) | 0)
                    em32(0xB2400000)  // orr x0, x0, #1
                    EXPR_TY = 9
                    EXPR_TY_HASH = FN_SIG[fri as usize]
                    LAST_EXPR_IS_CLOSURE = 1
                }
                else {
                    // Parity with the x86-64 twin (compile_primary ~15188): a bare
                    // identifier that is not a local/global/fn may be a named const.
                    // The arm64 walker previously skipped this lookup entirely, so
                    // every const reference (esp. imported enum-style consts) became
                    // a false "unknown identifier".
                    if const_find_val(ns, ne) != 0 {
                        let ci = CONST_FOUND_IDX
                        if CONST_TYPE[ci as usize] == 2 && CONST_TOK_IDX[ci as usize] >= 0 {
                            let ct = CONST_TOK_IDX[ci as usize]
                            emit_imm64_a64(TV[ct as usize])
                            em32(0x9E620000)  // scvtf d0, x0
                            if TF[ct as usize] > 0 {
                                emit_imm64_a64(TF[ct as usize])
                                em32(0x9E620001)  // scvtf d1, x0
                                emit_imm64_a64(TD[ct as usize])
                                em32(0x9E620002)  // scvtf d2, x0
                                em32(0x1E601800 | (2 << 16) | (1 << 5) | 1)  // fdiv d1, d1, d2
                                em32(0x1E612800)  // fadd d0, d0, d1
                            }
                            if TX[ct as usize] >= 0 { FL_SCI_SCRATCH = TX[ct as usize]; FL_SCI_NEG = 0 }
                            else { FL_SCI_SCRATCH = 0 - TX[ct as usize]; FL_SCI_NEG = 1 }
                            if FL_SCI_SCRATCH != 0 {
                                emit_imm64_a64(0x4024000000000000)  // bits of 10.0
                                em32(0x9E670001)  // fmov d1, x0
                                if FL_SCI_NEG == 0 {
                                    while FL_SCI_SCRATCH > 0 { em32(0x1E610800); FL_SCI_SCRATCH = FL_SCI_SCRATCH - 1 }  // fmul d0, d0, d1
                                } else {
                                    while FL_SCI_SCRATCH > 0 { em32(0x1E611800); FL_SCI_SCRATCH = FL_SCI_SCRATCH - 1 }  // fdiv d0, d0, d1
                                }
                            }
                            em32(0x9E660000)  // fmov x0, d0
                            EXPR_TY = 2; EXPR_TY_HASH = 0; EXPR_IS_F64 = 1
                        } else {
                            emit_imm64_reg_a64(0, CONST_FOUND_VAL)  // x0 = const value
                            EXPR_TY = 1; EXPR_TY_HASH = 0; EXPR_IS_F64 = 0
                        }
                        return
                    }
                    tc_undefined_var(name_tok); em32(0xD2800000); EXPR_TY = 0; EXPR_TY_HASH = 0
                }
            }
            if gi < 0 { EXPR_IS_F64 = 0 }
        }
        return
    }
    EP = EP + 1
    em32(0xD2800000)
    EXPR_IS_F64 = 0
}

// ─── ARM64 postfix ───
fn compile_postfix_a64() with IO, Mut, Panic, Div {
    compile_primary_a64()
    compile_postfix_tail_a64()
}

fn compile_postfix_tail_a64() with IO, Mut, Panic, Div {
    var more: i64 = 1
    while more == 1 {
        if TK[EP as usize] == 37 {
            EP = EP + 1
            let tp = EP
            let src_ty = EXPR_TY
            let src_hash = EXPR_TY_HASH
            let src_is_f64 = EXPR_IS_F64
            let tns = TS[EP as usize]
            let tne = TE[EP as usize]
            scan_type(tp)
            var cast_ty = SCAN_TY
            var cast_hash = SCAN_TY_HASH
            if cast_ty == 0 && name_is_lower(tns, tne) {
                cast_ty = 2
                cast_hash = gl_name_hash(tns, tne)
            }
            // E171: cannot cast Knowledge<T> to its inner type via `as`
            if knowledge_hash_is(src_hash) && !knowledge_hash_is(cast_hash) {
                tc_epistemic_cast_blocked(tp)
            }
            if src_ty == 2 && cast_ty == 2 && src_hash != 0 && cast_hash != 0 && src_hash != cast_hash {
                let src_dim = unit_lookup_dim(src_hash)
                let cast_dim = unit_lookup_dim(cast_hash)
                // Same-dimension casts (mg→kg, s→ms) are allowed; cross-dimension (mg→s) are not
                if src_dim == 0 || cast_dim == 0 || src_dim != cast_dim {
                    tc_arity_error(tp, "incompatible unit dimensions")
                }
            }
            if cast_ty == 1 && src_is_f64 == 1 {
                em32(0x9E670000)
                em32(0x9E780000)
            }
            if cast_ty == 2 && src_is_f64 == 0 {
                em32(0x9E620000)
                em32(0x9E660000)
            }
            if cast_ty == 1 && tne - tns == 2 && sb(tns) == 105 && sb(tns+1) == 56 {
                em32(0x93401C00)  // sxtb x0, w0
            }
            EXPR_TY = cast_ty
            EXPR_TY_HASH = cast_hash
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
            EP = SCAN_TY_NEXT
            continue
        }
        if TK[EP as usize] == 41 {
            let base_ty = EXPR_TY
            let base_hash = EXPR_TY_HASH
            emit_push_a64()
            EP = EP + 1
            compile_or_a64()
            if EXPR_TY != 0 && EXPR_TY != 1 {
                tc_error(EP - 1, "array index must be integer")
            }
            if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
            if TK[EP as usize] == 42 { EP = EP + 1 }
            em32(0xAA0003E9)  // mov x9, x0 (index)
            emit_pop_x1_a64()
            em32(0xAA0103E0)  // mov x0, x1 (base)
            if base_ty == 8 {
                let esiz = arr_hash_esiz(base_hash)
                var elem_ty = arr_hash_elem_ty(base_hash)
                let elem_hash = arr_hash_elem_hash(base_hash)
                LAST_ALEN = arr_hash_alen(base_hash)
                if esiz == 8 {
                    em32(0xF8697800)
                    EXPR_TY = elem_ty
                    EXPR_TY_HASH = elem_hash
                    if elem_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                } else {
                    em32(0x38A96800)
                    EXPR_TY = 1
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 0
                }
            } else if type_is_slice_ref(base_ty, base_hash) {
                let inner_hash = ref_hash_inner_hash(base_hash)
                let esiz = arr_hash_esiz(inner_hash)
                var elem_ty = arr_hash_elem_ty(inner_hash)
                let elem_hash = arr_hash_elem_hash(inner_hash)
                em32(0xF940042A)  // ldr x10, [x1, #8] (len)
                em32(0xEB00001F | (10 << 16) | (9 << 5))  // cmp x9, x10
                let slice_ok_patch_a = CL
                em32(0x54000003)  // b.lo ok
                emit_assert_fail_a64()
                patch_branch_a64(slice_ok_patch_a, CL)
                em32(0xF9400020)  // ldr x0, [x1] (data ptr)
                if esiz == 8 {
                    em32(0xF8697800)
                    EXPR_TY = elem_ty
                    EXPR_TY_HASH = elem_hash
                    if elem_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                } else {
                    em32(0x38A96800)
                    EXPR_TY = 1
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 0
                }
            } else if type_is_array_ref(base_ty, base_hash) {
                // Indexing a ref-to-array `&[T; N]` / `&![T; N]` yields a ref to
                // element i (its ADDRESS), preserving the base's mutability — so
                // `&! x.arr[i]` is `&!T`, not the element value (mirror of x86
                // :~15661). Fixes the `&!module.functions[i]` element-borrow #740.
                let inner_hash = ref_hash_inner_hash(base_hash)
                let esiz = arr_hash_esiz(inner_hash)
                let elem_ty = arr_hash_elem_ty(inner_hash)
                let elem_hash = arr_hash_elem_hash(inner_hash)
                LAST_ALEN = arr_hash_alen(inner_hash)
                if esiz == 8 {
                    em32(0x8B090C00)  // add x0, x0, x9, lsl #3  (element address)
                } else {
                    em32(0x8B090000)  // add x0, x0, x9          (esiz=1 byte)
                }
                EXPR_TY = 10
                EXPR_TY_HASH = ref_hash_make(elem_ty, elem_hash, ref_hash_mut(base_hash))
                EXPR_IS_F64 = 0
            } else {
                if base_ty != 0 && base_ty != 3 {
                    tc_error(EP - 1, "value is not indexable")
                }
                em32(0x38A96800)
                EXPR_TY = 1
                EXPR_TY_HASH = 0
                EXPR_IS_F64 = 0
            }
            continue
        }
        if TK[EP as usize] == 50 {
            EP = EP + 1
            let method_tok = EP
            let fns = TS[EP as usize]
            let fne = TE[EP as usize]
            let fh = gl_name_hash(fns, fne)
            // Built-in .as_bytes() — string → &[i8] pass-through (ARM64)
            if src_match(fns, fne - fns, "as_bytes") && TK[(EP + 1) as usize] == 6 && TK[(EP + 2) as usize] == 7 && EXPR_TY == 3 {
                EP = EP + 1  // skip 'as_bytes'
                EP = EP + 1  // skip (
                EP = EP + 1  // skip )
                EXPR_IS_F64 = 0
                continue
            }
            // Built-in .len() — runtime length for strings, compile-time for arrays/slices (ARM64)
            if src_match(fns, fne - fns, "len") && TK[(EP + 1) as usize] == 6 && TK[(EP + 2) as usize] == 7 && (EXPR_TY == 8 || EXPR_TY == 3 || type_is_slice_ref(EXPR_TY, EXPR_TY_HASH)) {
                EP = EP + 1  // skip 'len'
                EP = EP + 1  // skip (
                EP = EP + 1  // skip )
                if type_is_slice_ref(EXPR_TY, EXPR_TY_HASH) {
                    em32(0xF9400400)  // ldr x0, [x0, #8]
                } else if EXPR_TY == 3 {
                    emit_str_len_a64()
                } else {
                    emit_imm64_a64(LAST_ALEN)
                }
                EXPR_TY = 1
                EXPR_TY_HASH = 0
                EXPR_IS_F64 = 0
                continue
            }
            // Built-in .unwrap(reason) — extract .value field (offset 0) from struct (ARM64)
            if src_match(fns, fne - fns, "unwrap") && TK[(EP + 1) as usize] == 6 {
                // E170: unwrap on Knowledge<T> requires `with Epistemic`
                if knowledge_hash_is(EXPR_TY_HASH) && (FN_EFFECTS[CURRENT_FN as usize] & 512) == 0 {
                    tc_epistemic_value_access(method_tok)
                }
                EP = EP + 1  // skip 'unwrap'
                EP = EP + 1  // skip (
                // Validate argument: must be exactly one string literal reason
                if TK[EP as usize] == 7 {
                    tc_arity_error(method_tok, "Knowledge.unwrap requires exactly one argument")
                } else if TK[EP as usize] != 5 {
                    tc_arity_error(method_tok, "reason must be a `string` literal")
                }
                var uw_depth_a: i64 = 1
                while uw_depth_a > 0 && EP < TC {
                    if TK[EP as usize] == 6 { uw_depth_a = uw_depth_a + 1 }
                    if TK[EP as usize] == 7 { uw_depth_a = uw_depth_a - 1 }
                    if uw_depth_a > 0 { EP = EP + 1 }
                }
                if TK[EP as usize] == 7 { EP = EP + 1 }  // skip )
                em32(0xF9400000)  // ldr x0, [x0]
                if knowledge_hash_is(EXPR_TY_HASH) {
                    let inner_hash_a = knowledge_hash_inner_hash(EXPR_TY_HASH)
                    EXPR_TY = knowledge_hash_inner_ty(EXPR_TY_HASH)
                    EXPR_TY_HASH = inner_hash_a
                    if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                } else if EXPR_TY == 6 {
                    let uw_si_a = st_find(EXPR_TY_HASH)
                    if uw_si_a >= 0 {
                        EXPR_TY = ST_FTY[(uw_si_a * 128) as usize]
                        EXPR_TY_HASH = ST_FHASH[(uw_si_a * 128) as usize]
                        if EXPR_TY == 2 { EXPR_IS_F64 = 1 }
                    }
                }
                continue
            }
            // Math intrinsic methods (ARM64): val.sqrt(), val.exp(), etc.
            if TK[(EP + 1) as usize] == 6 && TK[(EP + 2) as usize] == 7 {
                var is_math_mm_a: i64 = 0
                var math_mm_fi_a: i64 = -1
                if src_match(fns, fne - fns, "sqrt") { is_math_mm_a = 1; math_mm_fi_a = fn_find_lit("__native_sqrt_f64") }
                if src_match(fns, fne - fns, "exp") { is_math_mm_a = 1; math_mm_fi_a = fn_find_lit("__native_exp_f64") }
                if src_match(fns, fne - fns, "ln") || src_match(fns, fne - fns, "log") { is_math_mm_a = 1; math_mm_fi_a = fn_find_lit("__native_ln_f64") }
                if src_match(fns, fne - fns, "sin") { is_math_mm_a = 1; math_mm_fi_a = fn_find_lit("__native_sin_f64") }
                if src_match(fns, fne - fns, "cos") { is_math_mm_a = 1; math_mm_fi_a = fn_find_lit("__native_cos_f64") }
                if src_match(fns, fne - fns, "tanh") { is_math_mm_a = 1; math_mm_fi_a = fn_find_lit("__native_tanh_f64") }
                if src_match(fns, fne - fns, "abs") { is_math_mm_a = 1; math_mm_fi_a = fn_find_lit("__native_abs_f64") }
                if src_match(fns, fne - fns, "floor") { is_math_mm_a = 1; math_mm_fi_a = fn_find_lit("__native_floor_f64") }
                if is_math_mm_a == 1 {
                    EP = EP + 1  // skip method name
                    EP = EP + 1  // skip (
                    EP = EP + 1  // skip )
                    if math_mm_fi_a >= 0 {
                        emit_push_a64()
                        emit_direct_fn_call_a64(math_mm_fi_a, 1)
                    } else {
                        tc_error(method_tok, "missing native math helper")
                        em32(0xD2800000)  // mov x0, #0
                        EXPR_IS_F64 = 0
                        EXPR_TY = 0
                        EXPR_TY_HASH = 0
                    }
                    EXPR_IS_F64 = 1
                    EXPR_TY = 2
                    EXPR_TY_HASH = 0
                    continue
                }
            }
            // Method turbofish: obj.method::<T>(args) — consume :: <T> so EP+1 becomes (
            if TK[(EP + 1) as usize] == 51 && EP + 2 < TC && TK[(EP + 2) as usize] == 23 {
                EP = EP + 2  // skip :: and <
                var mtf_d_a: i64 = 1
                while mtf_d_a > 0 && EP < TC {
                    EP = EP + 1
                    if TK[EP as usize] == 23 { mtf_d_a = mtf_d_a + 1 }
                    if TK[EP as usize] == 24 { mtf_d_a = mtf_d_a - 1 }
                }
                // EP is now at >; EP+1 is ( for method call dispatch below
            }
            if TK[(EP + 1) as usize] == 6 {
                var recv_h = EXPR_TY_HASH
                if EXPR_TY == 10 {
                    recv_h = ref_hash_inner_hash(EXPR_TY_HASH)
                }
                // C2 (a64 mirror of the x86_64 fix): see the x86_64 method-call site
                // for the full rationale.
                if recv_h == 0 {
                    let recv_prim_h = prim_lit_hash(EXPR_TY)
                    if recv_prim_h != 0 { recv_h = recv_prim_h }
                }
                let mfi = fn_find_method(fns, fne, recv_h)
                if mfi >= 0 {
                    EP = EP + 1; EP = EP + 1
                    // TODO: Add auto-borrow for ARM64 (see x86_64 version)
                    materialize_aggregate_expr_a64()
                    emit_push_a64()
                    var margc: i64 = 1
                    while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
                        compile_or_a64()
                        materialize_aggregate_expr_a64()
                        emit_push_a64()
                        margc = margc + 1
                        if TK[EP as usize] == 28 { EP = EP + 1 }
                    }
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                    if FN_ARITY[mfi as usize] != margc { tc_wrong_arity(method_tok, FN_ARITY[mfi as usize], margc) }
                    let a64_margs_drop = emit_setup_call_args_a64(margc)
                    PATCH_OFF[PATCH_COUNT as usize] = CL
                    PATCH_FN[PATCH_COUNT as usize] = mfi
                    PATCH_KIND[PATCH_COUNT as usize] = 0
                    PATCH_COUNT = PATCH_COUNT + 1
                    em32(0x94000000)
                    emit_add_sp_bytes_a64(a64_margs_drop)
                    EXPR_TY = FN_RET_TY[mfi as usize]
                    EXPR_TY_HASH = FN_RET_HASH[mfi as usize]
                    if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                    continue
                }
            }
            // Tuple field access: expr.0, expr.1 — a64 port of the x86 twin
            // (compile_primary :~16301). Scalar (nslots==1) element → load the value
            // into x0; aggregate element → copy it to fresh slots, leave x0 as the
            // pointer. Without this `pair.0` produced EXPR_TY=0, so `var c = pair.0`
            // left `c` untyped and `c.field` blind-scanned onto the wrong struct
            // (the private-field [Lowerer] cascade, #740).
            if TK[EP as usize] == 4 {
                let tup_idx = TV[EP as usize]
                EP = EP + 1
                if tup_idx > 1 {
                    tc_error_hard(method_tok, "tuple index out of bounds")
                }
                let tup_first_slots = tup_first_slots_true(EXPR_TY_HASH)
                let tup_total_slots = tup_total_slots_true(EXPR_TY_HASH)
                let tup_last_slots = tup_total_slots - tup_first_slots
                let fa_ci = tup_cache_lookup(EXPR_TY_HASH)
                var elem1_slots_true: i64 = tup_last_slots
                if fa_ci >= 0 && TUP_CACHE_TCOUNT[fa_ci as usize] > 2 && tup_idx == 1 {
                    let e1s = ty_slot_count(TUP_CACHE_ELEM_TY[(fa_ci * 16 + 1) as usize], TUP_CACHE_ELEM_HASH[(fa_ci * 16 + 1) as usize])
                    if e1s > 0 { elem1_slots_true = e1s }
                }
                let elem_slots = if tup_idx == 0 { tup_first_slots } else { elem1_slots_true }
                if tup_idx == 0 {
                    // x0 already points to element 0
                } else {
                    let byte_offset = tup_first_slots * 8   // .1 offset
                    if byte_offset > 0 {
                        if byte_offset < 4096 { em32(0x91000000 | ((byte_offset & 0xFFF) << 10)) }  // add x0, x0, #off
                        else { emit_imm64_reg_a64(9, byte_offset); em32(0x8B090000) }                // x9=off; add x0,x0,x9
                    }
                }
                if elem_slots == 1 {
                    em32(0xF9400000)  // ldr x0, [x0] — scalar element value
                    let sc_ci = tup_cache_lookup(EXPR_TY_HASH)
                    if sc_ci >= 0 {
                        if tup_idx == 0 {
                            EXPR_TY = TUP_CACHE_FIRST_TY[sc_ci as usize]
                            EXPR_TY_HASH = TUP_CACHE_FIRST_HASH[sc_ci as usize]
                        } else if TUP_CACHE_TCOUNT[sc_ci as usize] > 2 {
                            EXPR_TY = TUP_CACHE_ELEM_TY[(sc_ci * 16 + 1) as usize]
                            EXPR_TY_HASH = TUP_CACHE_ELEM_HASH[(sc_ci * 16 + 1) as usize]
                        } else {
                            EXPR_TY = TUP_CACHE_LAST_TY[sc_ci as usize]
                            EXPR_TY_HASH = TUP_CACHE_LAST_HASH[sc_ci as usize]
                        }
                        if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                    } else {
                        let elem_kind = if tup_idx == 0 { (EXPR_TY_HASH / 10000000) % 10 } else { (EXPR_TY_HASH / 1000000) % 10 }
                        if elem_kind == 1 { EXPR_IS_F64 = 1; EXPR_TY = 2 } else { EXPR_IS_F64 = 0; EXPR_TY = 1 }
                        EXPR_TY_HASH = 0
                    }
                } else {
                    EXPR_IS_F64 = 0
                    let tup_ci = tup_cache_lookup(EXPR_TY_HASH)
                    if tup_ci >= 0 {
                        if tup_idx == 0 {
                            EXPR_TY = TUP_CACHE_FIRST_TY[tup_ci as usize]
                            EXPR_TY_HASH = TUP_CACHE_FIRST_HASH[tup_ci as usize]
                        } else if TUP_CACHE_TCOUNT[tup_ci as usize] > 2 {
                            EXPR_TY = TUP_CACHE_ELEM_TY[(tup_ci * 16 + 1) as usize]
                            EXPR_TY_HASH = TUP_CACHE_ELEM_HASH[(tup_ci * 16 + 1) as usize]
                        } else {
                            EXPR_TY = TUP_CACHE_LAST_TY[tup_ci as usize]
                            EXPR_TY_HASH = TUP_CACHE_LAST_HASH[tup_ci as usize]
                        }
                    } else {
                        EXPR_TY = 6
                        if tup_idx == 0 {
                            if tup_first_slots > 0 { EXPR_TY_HASH = 1000000007 + tup_first_slots } else { EXPR_TY_HASH = 0 }
                        } else {
                            if tup_last_slots > 0 { EXPR_TY_HASH = 1000000007 + tup_last_slots } else { EXPR_TY_HASH = 0 }
                        }
                    }
                    var tup_mat_n: i64 = 128
                    if elem_slots > 0 { tup_mat_n = elem_slots }
                    if tup_ci >= 0 {
                        let true_mat_n = ty_slot_count(EXPR_TY, EXPR_TY_HASH)
                        if true_mat_n > 0 { tup_mat_n = true_mat_n }
                    }
                    let tup_mat_base = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + tup_mat_n
                    emit_bulk_copy_to_slots_a64(tup_mat_n, tup_mat_base)
                }
                continue
            }
            let base_ty = EXPR_TY
            let base_hash = EXPR_TY_HASH
            var base_data_ty = base_ty
            var base_data_hash = base_hash
            if base_ty == 10 {
                base_data_ty = ref_hash_inner_ty(base_hash)
                base_data_hash = ref_hash_inner_hash(base_hash)
            }
            // `Box<T>` (TY 11) is the same unwrap as `&T` above and was simply
            // never added. Without it type_is_struct_like answered false, the
            // typed path below was skipped, and `x.boxed.field` fell through to
            // the scan that walks EVERY struct looking for that field NAME and
            // takes the first hit. Measured on a witness whose decoy struct
            // declares the same name one slot over: `.a` gave 10 (right, by
            // luck -- only one struct spells it), `.b` gave 30 where 20 was
            // declared, `.c` gave 30 (right again, by luck).
            //
            // No extra dereference is emitted, deliberately: a Box already holds
            // the payload address, which is exactly why the scan could read the
            // right WORD through the wrong STRUCT. Only the layout used to turn a
            // field name into an offset changes.
            if base_ty == 11 && box_hash_is(base_hash) {
                base_data_ty = ref_hash_inner_ty(base_hash)
                base_data_hash = ref_hash_inner_hash(base_hash)
            }
            EP = EP + 1
            var found: i64 = 0
            EXPR_TY = 0
            EXPR_TY_HASH = 0
            if knowledge_hash_is(base_data_hash) {
                if src_match(fns, fne - fns, "value") {
                    // E170: accessing .value on Knowledge<T> requires `with Epistemic`
                    if (FN_EFFECTS[CURRENT_FN as usize] & 512) == 0 {
                        tc_epistemic_value_access(method_tok)
                    }
                    // β⁴: save ptr, load variance shadow, restore ptr, load .value
                    // x0 = Knowledge ptr: [x0+0]=value, [x0+8]=variance
                    let b4a_ptr_slot = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + 1
                    emit_store_var_a64(b4a_ptr_slot)         // save ptr
                    em32(0xF9400400)                          // ldr x0, [x0, #8] (variance)
                    let b4a_vseed = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + 1
                    emit_store_var_a64(b4a_vseed)             // store variance shadow
                    // β¹⁰: bind σ² to FO channel (parity with x86 path)
                    if MEAS_KNOW_IDX >= 0 && MEAS_KNOW_IDX < 8 {
                        CHANNEL_INPUT_VAR_SLOT[MEAS_KNOW_IDX as usize] = b4a_vseed
                    }
                    emit_load_var_a64(b4a_ptr_slot)           // restore ptr
                    em32(0xF9400000)                          // ldr x0, [x0] (.value)
                    EXPR_VSHADOW = b4a_vseed
                    // Save .value before emitting sensitivity seed (emit_imm64_a64 overwrites x0)
                    let b4a_valsave = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + 1
                    emit_store_var_a64(b4a_valsave)
                    // Sensitivity seeds ch0-ch3: 1.0 for the matching Knowledge access, else 0.0
                    let b4a_sseed = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + 1
                    if MEAS_KNOW_IDX == 0 { emit_imm64_a64(4607182418800017408) } else { emit_imm64_a64(0) }
                    emit_store_var_a64(b4a_sseed)
                    let b4a_sseed_1 = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + 1
                    if MEAS_KNOW_IDX == 1 { emit_imm64_a64(4607182418800017408) } else { emit_imm64_a64(0) }
                    emit_store_var_a64(b4a_sseed_1)
                    let b4a_sseed_2 = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + 1
                    if MEAS_KNOW_IDX == 2 { emit_imm64_a64(4607182418800017408) } else { emit_imm64_a64(0) }
                    emit_store_var_a64(b4a_sseed_2)
                    let b4a_sseed_3 = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + 1
                    if MEAS_KNOW_IDX == 3 { emit_imm64_a64(4607182418800017408) } else { emit_imm64_a64(0) }
                    emit_store_var_a64(b4a_sseed_3)
                    EXPR_SSHADOW = b4a_sseed
                    EXPR_SSHADOW_1 = b4a_sseed_1
                    EXPR_SSHADOW_2 = b4a_sseed_2
                    EXPR_SSHADOW_3 = b4a_sseed_3
                    MEAS_KNOW_IDX = MEAS_KNOW_IDX + 1
                    // Restore .value (emit_imm64_a64 overwrote x0 with sensitivity seed)
                    emit_load_var_a64(b4a_valsave)
                    EXPR_TY = knowledge_hash_inner_ty(base_data_hash)
                    EXPR_TY_HASH = knowledge_hash_inner_hash(base_data_hash)
                    if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                } else if src_match(fns, fne - fns, "variance") {
                    em32(0xF9400400)
                    EXPR_TY = 2
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 1
                } else if src_match(fns, fne - fns, "uncertainty") {
                    // a64 twin of the x86 .uncertainty accessor (compile_postfix())
                    // — a whole missing case, not previously ported: .uncertainty
                    // surfaces sqrt(variance); variance is what's actually stored
                    // at offset 8. Without this, `.uncertainty` fell through to
                    // the generic "unknown field access" branch below, which
                    // tc_error()s (non-fatal — see reference_sounio_visibility_model)
                    // and leaves x0/EXPR_IS_F64 untouched, silently reading as 0.
                    em32(0xF9400400)
                    emit_sqrt_builtin_a64()
                    EXPR_TY = 2
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 1
                } else if src_match(fns, fne - fns, "confidence") || src_match(fns, fne - fns, "epsilon") {
                    em32(0xF9400800)
                    EXPR_TY = 2
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 1
                } else {
                    tc_error(method_tok, "unknown field access")
                    em32(0xD2800000)
                    EXPR_IS_F64 = 0
                }
                found = 1
            }
            if type_is_struct_like(base_data_ty, base_data_hash) {
                let bsi = st_find(base_data_hash)
                if bsi >= 0 {
                    if st_private_access_denied(bsi, method_tok) {
                        tc_error_hard(method_tok, "private struct field access")
                        em32(0xD2800000)
                    } else {
                        ST_QUERY_NS = fns
                        ST_QUERY_NE = fne
                        let off = st_field_offset(bsi, fh)
                        if off >= 0 {
                            EXPR_TY = st_field_ty(bsi, fh)
                            EXPR_TY_HASH = st_field_hash(bsi, fh)
                        ST_QUERY_NS = -1
                        ST_QUERY_NE = -1
                            if EXPR_TY == 8 || type_is_struct_like(EXPR_TY, EXPR_TY_HASH) || type_is_option_inline(EXPR_TY, EXPR_TY_HASH) || knowledge_hash_is(EXPR_TY_HASH) {
                                if off != 0 {
                                    emit_imm64_reg_a64(1, off)
                                    em32(0x8B010000)
                                }
                            } else {
                                // ldr's unsigned-offset imm is 12-bit scaled (max #32760); a field
                                // past a large array (e.g. env.count after [TypeBinding; 4096]) has
                                // off >= 32768, which wraps the imm to ~0 → reads the wrong slot.
                                // Fall back to a register add + [x0] load for big offsets.
                                if off == 0 { em32(0xF9400000) }
                                else if off / 8 < 4096 { em32(0xF9400000 | ((off / 8) << 10) | (0 << 5) | 0) }
                                else { emit_imm64_reg_a64(1, off); em32(0x8B010000); em32(0xF9400000) }
                            }
                            if EXPR_TY == 8 { LAST_ALEN = arr_hash_alen(EXPR_TY_HASH) }
                        } else {
                            tc_error(method_tok, "unknown field access")
                            em32(0xD2800000)
                        }
                        ST_QUERY_NS = -1
                        ST_QUERY_NE = -1
                    }
                    found = 1
                }
            }
            var si: i64 = 0
            while si < ST_COUNT && found == 0 {
                ST_QUERY_NS = fns
                ST_QUERY_NE = fne
                let off = st_field_offset(si, fh)
                if off >= 0 {
                    if st_private_access_denied(si, method_tok) {
                        ST_QUERY_NS = -1
                        ST_QUERY_NE = -1
                        tc_error_hard(method_tok, "private struct field access")
                        em32(0xD2800000)
                    } else {
                        EXPR_TY = st_field_ty(si, fh)
                        EXPR_TY_HASH = st_field_hash(si, fh)
                    ST_QUERY_NS = -1
                    ST_QUERY_NE = -1
                        if EXPR_TY == 8 || type_is_struct_like(EXPR_TY, EXPR_TY_HASH) || type_is_option_inline(EXPR_TY, EXPR_TY_HASH) || knowledge_hash_is(EXPR_TY_HASH) {
                            if off != 0 {
                                emit_imm64_reg_a64(1, off)
                                em32(0x8B010000)
                            }
                        } else {
                            if off == 0 { em32(0xF9400000) }
                            else if off / 8 < 4096 { em32(0xF9400000 | ((off / 8) << 10) | (0 << 5) | 0) }
                            else { emit_imm64_reg_a64(1, off); em32(0x8B010000); em32(0xF9400000) }
                        }
                        if EXPR_TY == 8 { LAST_ALEN = arr_hash_alen(EXPR_TY_HASH) }
                    }
                    found = 1
                }
                si = si + 1
            }
            if found == 0 {
                if TK[EP as usize] == 6 {
                    tc_error(method_tok, "unknown method")
                } else {
                    tc_error(method_tok, "unknown field access")
                }
                em32(0xD2800000)
            }
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
            continue
        }
        more = 0
    }
}

// ─── ARM64 multiplicative ───
fn compile_multiplicative_a64() with IO, Mut, Panic, Div {
    compile_postfix_a64()
    var lhs_end_line: i64 = TL[(EP - 1) as usize]
    while TK[EP as usize] == 19 || TK[EP as usize] == 20 || TK[EP as usize] == 29 {
        // See compile_multiplicative() (x86 twin) for the full rationale: a `*`
        // starting a new line is always a new statement's dereference prefix in
        // this codebase's style, never continued multiplication — the guard must
        // not be limited to EXPR_TY == 11 (raw pointer).
        if TK[EP as usize] == 19 && TL[EP as usize] > lhs_end_line { return }
        let op_tok = EP
        let op = TK[EP as usize]
        EP = EP + 1
        let rhs_start = EP
        var rhs_const_known: i64 = 0
        var rhs_const_val: i64 = 0
        if TK[rhs_start as usize] == 4 {
            rhs_const_known = 1
            rhs_const_val = TV[rhs_start as usize]
        }
        if TK[rhs_start as usize] == 6 && TK[(rhs_start + 1) as usize] == 4 && TK[(rhs_start + 2) as usize] == 18 && TK[(rhs_start + 3) as usize] == 4 {
            rhs_const_known = 1
            rhs_const_val = TV[(rhs_start + 1) as usize] - TV[(rhs_start + 3) as usize]
        }
        let left_f64 = EXPR_IS_F64
        let left_ty = EXPR_TY
        let left_hash = EXPR_TY_HASH
        // β⁴: capture LHS shadow + save LHS f64 value for GUM/AD propagation
        let b4am_left_vshadow = EXPR_VSHADOW
        let b4am_left_sshadow = EXPR_SSHADOW
        let b4am_left_sshadow_1 = EXPR_SSHADOW_1
        let b4am_left_sshadow_2 = EXPR_SSHADOW_2
        let b4am_left_sshadow_3 = EXPR_SSHADOW_3
        // β⁴: always save lval/rval for f64 mul (a²·var(b) needs a even when var(a)=0)
        var b4am_lval_slot: i64 = -1
        if left_f64 == 1 {
            b4am_lval_slot = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var_a64(b4am_lval_slot)
        }
        EXPR_VSHADOW = -1; EXPR_SSHADOW = -1; EXPR_SSHADOW_1 = -1; EXPR_SSHADOW_2 = -1; EXPR_SSHADOW_3 = -1; EXPR_SSHADOW_4 = -1; EXPR_SSHADOW_5 = -1; EXPR_SSHADOW_6 = -1; EXPR_SSHADOW_7 = -1
        emit_push_a64()
        compile_postfix_a64()
        let right_ty = EXPR_TY
        let right_hash = EXPR_TY_HASH
        if (op == 20 || op == 29) && rhs_const_known != 0 && rhs_const_val == 0 {
            if op == 20 { tc_error(op_tok, "division by zero") }
            else { tc_error(op_tok, "modulo by zero") }
        }
        let left_has_knowledge = knowledge_hash_is(left_hash)
        let right_has_knowledge = knowledge_hash_is(right_hash)
        if left_has_knowledge || right_has_knowledge {
            // LHS is still on the stack (pushed above) and x0 holds the
            // freshly-compiled RHS — the stack shape compile_knowledge_muldiv_a64
            // expects (it does its own pop). See compile_multiplicative() (x86
            // twin) for the full rationale, including why modulo still calls
            // through after the diagnostic (mirrors x86 exactly).
            var left_inner_ty = left_ty
            var left_inner_hash = left_hash
            if left_has_knowledge {
                left_inner_ty = knowledge_hash_inner_ty(left_hash)
                left_inner_hash = knowledge_hash_inner_hash(left_hash)
            }
            var right_inner_ty = right_ty
            var right_inner_hash = right_hash
            if right_has_knowledge {
                right_inner_ty = knowledge_hash_inner_ty(right_hash)
                right_inner_hash = knowledge_hash_inner_hash(right_hash)
            }
            if op == 29 {
                tc_error(op_tok, "modulo requires integer operands")
            } else if left_inner_ty != 0 && right_inner_ty != 0 {
                if ty_is_numeric(left_inner_ty) == false || ty_is_numeric(right_inner_ty) == false || ty_eq(left_inner_ty, left_inner_hash, right_inner_ty, right_inner_hash) == false {
                    tc_error(op_tok, "Knowledge arithmetic requires matching numeric operands")
                }
            }
            compile_knowledge_muldiv_a64(op_tok, op, left_ty, left_hash, right_ty, right_hash)
            continue
        }
        // β⁴: capture RHS shadow + save RHS f64 value
        let b4am_right_vshadow = EXPR_VSHADOW
        let b4am_right_sshadow = EXPR_SSHADOW
        let b4am_right_sshadow_1 = EXPR_SSHADOW_1
        let b4am_right_sshadow_2 = EXPR_SSHADOW_2
        let b4am_right_sshadow_3 = EXPR_SSHADOW_3
        var b4am_rval_slot: i64 = -1
        if left_f64 == 1 {
            b4am_rval_slot = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var_a64(b4am_rval_slot)
        }
        emit_pop_x1_a64()
        if left_f64 == 1 {
            if op == 19 { emit_f64_binop_a64(0x1E610800) }
            if op == 20 { emit_f64_binop_a64(0x1E611800) }
            if op == 29 { em32(0x9B007C20) }
            EXPR_IS_F64 = 1
        } else {
            if op == 19 { em32(0x9B007C20) }  // mul x0, x1, x0
            if op == 20 { em32(0x9AC00C20) }  // sdiv x0, x1, x0
            if op == 29 {
                em32(0x9AC00C00 | (0 << 16) | (1 << 5) | 9)
                em32(0x9B008000 | (0 << 16) | (1 << 10) | (9 << 5) | 0)
            }
        }
        // β⁴: GUM variance propagation through *
        // Save result first — shadow computation overwrites x0
        EXPR_VSHADOW = -1; EXPR_SSHADOW = -1; EXPR_SSHADOW_1 = -1; EXPR_SSHADOW_2 = -1; EXPR_SSHADOW_3 = -1; EXPR_SSHADOW_4 = -1; EXPR_SSHADOW_5 = -1; EXPR_SSHADOW_6 = -1; EXPR_SSHADOW_7 = -1
        var b4am_result_slot: i64 = -1
        if left_f64 == 1 && op == 19 && ((b4am_left_vshadow >= 0 || b4am_right_vshadow >= 0) || (b4am_left_sshadow >= 0 || b4am_right_sshadow >= 0) || (b4am_left_sshadow_1 >= 0 || b4am_right_sshadow_1 >= 0) || (b4am_left_sshadow_2 >= 0 || b4am_right_sshadow_2 >= 0) || (b4am_left_sshadow_3 >= 0 || b4am_right_sshadow_3 >= 0)) {
            b4am_result_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var_a64(b4am_result_slot)
        }
        if left_f64 == 1 && op == 19 && (b4am_left_vshadow >= 0 || b4am_right_vshadow >= 0) {
            // var(a*b) = a²·var(b) + b²·var(a)
            // a²·var(b)
            if b4am_lval_slot >= 0 {
                emit_load_var_a64(b4am_lval_slot); emit_push_a64()
                emit_load_var_a64(b4am_lval_slot)
                emit_pop_x1_a64(); emit_f64_binop_a64(0x1E610800)  // a²
            } else { emit_imm64_a64(0) }
            emit_push_a64()
            if b4am_right_vshadow >= 0 { emit_load_var_a64(b4am_right_vshadow) } else { emit_imm64_a64(0) }
            emit_pop_x1_a64(); emit_f64_binop_a64(0x1E610800)  // a²·var(b)
            emit_push_a64()
            // b²·var(a)
            if b4am_rval_slot >= 0 {
                emit_load_var_a64(b4am_rval_slot); emit_push_a64()
                emit_load_var_a64(b4am_rval_slot)
                emit_pop_x1_a64(); emit_f64_binop_a64(0x1E610800)  // b²
            } else { emit_imm64_a64(0) }
            emit_push_a64()
            if b4am_left_vshadow >= 0 { emit_load_var_a64(b4am_left_vshadow) } else { emit_imm64_a64(0) }
            emit_pop_x1_a64(); emit_f64_binop_a64(0x1E610800)  // b²·var(a)
            emit_pop_x1_a64(); emit_f64_binop_a64(0x1E612800)  // sum
            let b4am_vres = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var_a64(b4am_vres)
            EXPR_VSHADOW = b4am_vres
        }
        if left_f64 == 1 && op == 19 && (b4am_left_sshadow >= 0 || b4am_right_sshadow >= 0) {
            // sens(a*b) = a·sens(b) + b·sens(a)
            if b4am_lval_slot >= 0 { emit_load_var_a64(b4am_lval_slot) } else { emit_imm64_a64(0) }
            emit_push_a64()
            if b4am_right_sshadow >= 0 { emit_load_var_a64(b4am_right_sshadow) } else { emit_imm64_a64(0) }
            emit_pop_x1_a64(); emit_f64_binop_a64(0x1E610800)  // a·sens(b)
            emit_push_a64()
            if b4am_rval_slot >= 0 { emit_load_var_a64(b4am_rval_slot) } else { emit_imm64_a64(0) }
            emit_push_a64()
            if b4am_left_sshadow >= 0 { emit_load_var_a64(b4am_left_sshadow) } else { emit_imm64_a64(0) }
            emit_pop_x1_a64(); emit_f64_binop_a64(0x1E610800)  // b·sens(a)
            emit_pop_x1_a64(); emit_f64_binop_a64(0x1E612800)  // sum
            let b4am_sres = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var_a64(b4am_sres)
            EXPR_SSHADOW = b4am_sres
        }
        if left_f64 == 1 && op == 19 && (b4am_left_sshadow_1 >= 0 || b4am_right_sshadow_1 >= 0) {
            // sens_ch1(a*b) = a·sens_ch1(b) + b·sens_ch1(a)
            if b4am_lval_slot >= 0 { emit_load_var_a64(b4am_lval_slot) } else { emit_imm64_a64(0) }
            emit_push_a64()
            if b4am_right_sshadow_1 >= 0 { emit_load_var_a64(b4am_right_sshadow_1) } else { emit_imm64_a64(0) }
            emit_pop_x1_a64(); emit_f64_binop_a64(0x1E610800)
            emit_push_a64()
            if b4am_rval_slot >= 0 { emit_load_var_a64(b4am_rval_slot) } else { emit_imm64_a64(0) }
            emit_push_a64()
            if b4am_left_sshadow_1 >= 0 { emit_load_var_a64(b4am_left_sshadow_1) } else { emit_imm64_a64(0) }
            emit_pop_x1_a64(); emit_f64_binop_a64(0x1E610800)
            emit_pop_x1_a64(); emit_f64_binop_a64(0x1E612800)
            let b4am_sres1 = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var_a64(b4am_sres1)
            EXPR_SSHADOW_1 = b4am_sres1
        }
        if left_f64 == 1 && op == 19 && (b4am_left_sshadow_2 >= 0 || b4am_right_sshadow_2 >= 0) {
            // sens_ch2(a*b) = a·sens_ch2(b) + b·sens_ch2(a)
            if b4am_lval_slot >= 0 { emit_load_var_a64(b4am_lval_slot) } else { emit_imm64_a64(0) }
            emit_push_a64()
            if b4am_right_sshadow_2 >= 0 { emit_load_var_a64(b4am_right_sshadow_2) } else { emit_imm64_a64(0) }
            emit_pop_x1_a64(); emit_f64_binop_a64(0x1E610800)
            emit_push_a64()
            if b4am_rval_slot >= 0 { emit_load_var_a64(b4am_rval_slot) } else { emit_imm64_a64(0) }
            emit_push_a64()
            if b4am_left_sshadow_2 >= 0 { emit_load_var_a64(b4am_left_sshadow_2) } else { emit_imm64_a64(0) }
            emit_pop_x1_a64(); emit_f64_binop_a64(0x1E610800)
            emit_pop_x1_a64(); emit_f64_binop_a64(0x1E612800)
            let b4am_sres2 = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var_a64(b4am_sres2)
            EXPR_SSHADOW_2 = b4am_sres2
        }
        if left_f64 == 1 && op == 19 && (b4am_left_sshadow_3 >= 0 || b4am_right_sshadow_3 >= 0) {
            // sens_ch3(a*b) = a·sens_ch3(b) + b·sens_ch3(a)
            if b4am_lval_slot >= 0 { emit_load_var_a64(b4am_lval_slot) } else { emit_imm64_a64(0) }
            emit_push_a64()
            if b4am_right_sshadow_3 >= 0 { emit_load_var_a64(b4am_right_sshadow_3) } else { emit_imm64_a64(0) }
            emit_pop_x1_a64(); emit_f64_binop_a64(0x1E610800)
            emit_push_a64()
            if b4am_rval_slot >= 0 { emit_load_var_a64(b4am_rval_slot) } else { emit_imm64_a64(0) }
            emit_push_a64()
            if b4am_left_sshadow_3 >= 0 { emit_load_var_a64(b4am_left_sshadow_3) } else { emit_imm64_a64(0) }
            emit_pop_x1_a64(); emit_f64_binop_a64(0x1E610800)
            emit_pop_x1_a64(); emit_f64_binop_a64(0x1E612800)
            let b4am_sres3 = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var_a64(b4am_sres3)
            EXPR_SSHADOW_3 = b4am_sres3
        }
        // Restore arithmetic result
        if b4am_result_slot >= 0 { emit_load_var_a64(b4am_result_slot) }
        lhs_end_line = TL[(EP - 1) as usize]
    }
}

// ─── ARM64 additive ───
fn compile_additive_a64() with IO, Mut, Panic, Div {
    compile_multiplicative_a64()
    while TK[EP as usize] == 17 || TK[EP as usize] == 18 {
        let op_tok = EP
        let op = TK[EP as usize]
        EP = EP + 1
        let left_f64 = EXPR_IS_F64
        let left_ty = EXPR_TY
        let left_hash = EXPR_TY_HASH
        // β⁴: capture LHS shadow
        let b4aa_left_vshadow = EXPR_VSHADOW
        let b4aa_left_sshadow = EXPR_SSHADOW
        let b4aa_left_sshadow_1 = EXPR_SSHADOW_1
        let b4aa_left_sshadow_2 = EXPR_SSHADOW_2
        let b4aa_left_sshadow_3 = EXPR_SSHADOW_3
        EXPR_VSHADOW = -1; EXPR_SSHADOW = -1; EXPR_SSHADOW_1 = -1; EXPR_SSHADOW_2 = -1; EXPR_SSHADOW_3 = -1; EXPR_SSHADOW_4 = -1; EXPR_SSHADOW_5 = -1; EXPR_SSHADOW_6 = -1; EXPR_SSHADOW_7 = -1
        emit_push_a64()
        compile_multiplicative_a64()
        let right_ty = EXPR_TY
        let right_hash = EXPR_TY_HASH
        // β⁴: capture RHS shadow
        let b4aa_right_vshadow = EXPR_VSHADOW
        let b4aa_right_sshadow = EXPR_SSHADOW
        let b4aa_right_sshadow_1 = EXPR_SSHADOW_1
        let b4aa_right_sshadow_2 = EXPR_SSHADOW_2
        let b4aa_right_sshadow_3 = EXPR_SSHADOW_3
        // String `+` concatenation (a64 twin of compile_additive :~18549). Without
        // this branch the else path below emits `add x0, x1, x0` — ADDING the two
        // string POINTERS as integers, yielding a garbage address that prints junk.
        // (The str_concat BUILTIN worked; only the `+` OPERATOR was missing this.)
        if op == 17 && left_ty == 3 && right_ty == 3 {
            let cc_slot_b = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var_a64(cc_slot_b)   // rhs (x0) → slot B
            let cc_slot_a = NEXT_SLOT
            NEXT_SLOT = NEXT_SLOT + 1
            emit_pop_x0_a64()               // pop lhs → x0
            emit_store_var_a64(cc_slot_a)   // lhs → slot A
            emit_str_concat_slots_a64(cc_slot_a, cc_slot_b)
            EXPR_IS_F64 = 0
            EXPR_TY = 3
            EXPR_TY_HASH = 0
            continue
        }
        let left_has_knowledge = knowledge_hash_is(left_hash)
        let right_has_knowledge = knowledge_hash_is(right_hash)
        if left_has_knowledge || right_has_knowledge {
            // LHS is still on the stack (pushed above, not yet popped) and
            // x0 holds the freshly-compiled RHS — exactly the stack shape
            // compile_knowledge_addsub_a64 expects (it does its own pop).
            var left_inner_ty = left_ty
            var left_inner_hash = left_hash
            if left_has_knowledge {
                left_inner_ty = knowledge_hash_inner_ty(left_hash)
                left_inner_hash = knowledge_hash_inner_hash(left_hash)
            }
            var right_inner_ty = right_ty
            var right_inner_hash = right_hash
            if right_has_knowledge {
                right_inner_ty = knowledge_hash_inner_ty(right_hash)
                right_inner_hash = knowledge_hash_inner_hash(right_hash)
            }
            if left_inner_ty != 0 && right_inner_ty != 0 {
                if ty_is_numeric(left_inner_ty) == false || ty_is_numeric(right_inner_ty) == false || ty_eq(left_inner_ty, left_inner_hash, right_inner_ty, right_inner_hash) == false {
                    tc_error(op_tok, "Knowledge arithmetic requires matching numeric operands")
                }
            }
            compile_knowledge_addsub_a64(op_tok, op, left_ty, left_hash, right_ty, right_hash)
            continue
        }
        emit_pop_x1_a64()
        if left_f64 == 1 {
            if op == 17 { emit_f64_binop_a64(0x1E612800) }
            if op == 18 { emit_f64_binop_a64(0x1E613800) }
            EXPR_IS_F64 = 1
            // β⁴: GUM variance: var(a±b) = var(a) + var(b)
            // Save result first — shadow computation overwrites x0
            EXPR_VSHADOW = -1; EXPR_SSHADOW = -1; EXPR_SSHADOW_1 = -1; EXPR_SSHADOW_2 = -1; EXPR_SSHADOW_3 = -1; EXPR_SSHADOW_4 = -1; EXPR_SSHADOW_5 = -1; EXPR_SSHADOW_6 = -1; EXPR_SSHADOW_7 = -1
            var b4aa_result_slot: i64 = -1
            if (b4aa_left_vshadow >= 0 || b4aa_right_vshadow >= 0) || (b4aa_left_sshadow >= 0 || b4aa_right_sshadow >= 0) || (b4aa_left_sshadow_1 >= 0 || b4aa_right_sshadow_1 >= 0) || (b4aa_left_sshadow_2 >= 0 || b4aa_right_sshadow_2 >= 0) || (b4aa_left_sshadow_3 >= 0 || b4aa_right_sshadow_3 >= 0) {
                b4aa_result_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var_a64(b4aa_result_slot)
            }
            if b4aa_left_vshadow >= 0 || b4aa_right_vshadow >= 0 {
                if b4aa_left_vshadow >= 0 { emit_load_var_a64(b4aa_left_vshadow) } else { emit_imm64_a64(0) }
                emit_push_a64()
                if b4aa_right_vshadow >= 0 { emit_load_var_a64(b4aa_right_vshadow) } else { emit_imm64_a64(0) }
                emit_pop_x1_a64(); emit_f64_binop_a64(0x1E612800)  // fadd
                let b4aa_vres = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var_a64(b4aa_vres)
                EXPR_VSHADOW = b4aa_vres
            }
            if b4aa_left_sshadow >= 0 || b4aa_right_sshadow >= 0 {
                // sens(a+b)=sens(a)+sens(b); sens(a-b)=sens(a)-sens(b)
                if b4aa_left_sshadow >= 0 { emit_load_var_a64(b4aa_left_sshadow) } else { emit_imm64_a64(0) }
                emit_push_a64()
                if b4aa_right_sshadow >= 0 { emit_load_var_a64(b4aa_right_sshadow) } else { emit_imm64_a64(0) }
                emit_pop_x1_a64()
                if op == 17 { emit_f64_binop_a64(0x1E612800) } else { emit_f64_binop_a64(0x1E613800) }
                let b4aa_sres = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var_a64(b4aa_sres)
                EXPR_SSHADOW = b4aa_sres
            }
            if b4aa_left_sshadow_1 >= 0 || b4aa_right_sshadow_1 >= 0 {
                // sens_ch1(a+b)=sens_ch1(a)+sens_ch1(b); sens_ch1(a-b)=sens_ch1(a)-sens_ch1(b)
                if b4aa_left_sshadow_1 >= 0 { emit_load_var_a64(b4aa_left_sshadow_1) } else { emit_imm64_a64(0) }
                emit_push_a64()
                if b4aa_right_sshadow_1 >= 0 { emit_load_var_a64(b4aa_right_sshadow_1) } else { emit_imm64_a64(0) }
                emit_pop_x1_a64()
                if op == 17 { emit_f64_binop_a64(0x1E612800) } else { emit_f64_binop_a64(0x1E613800) }
                let b4aa_sres1 = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var_a64(b4aa_sres1)
                EXPR_SSHADOW_1 = b4aa_sres1
            }
            if b4aa_left_sshadow_2 >= 0 || b4aa_right_sshadow_2 >= 0 {
                if b4aa_left_sshadow_2 >= 0 { emit_load_var_a64(b4aa_left_sshadow_2) } else { emit_imm64_a64(0) }
                emit_push_a64()
                if b4aa_right_sshadow_2 >= 0 { emit_load_var_a64(b4aa_right_sshadow_2) } else { emit_imm64_a64(0) }
                emit_pop_x1_a64()
                if op == 17 { emit_f64_binop_a64(0x1E612800) } else { emit_f64_binop_a64(0x1E613800) }
                let b4aa_sres2 = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var_a64(b4aa_sres2)
                EXPR_SSHADOW_2 = b4aa_sres2
            }
            if b4aa_left_sshadow_3 >= 0 || b4aa_right_sshadow_3 >= 0 {
                if b4aa_left_sshadow_3 >= 0 { emit_load_var_a64(b4aa_left_sshadow_3) } else { emit_imm64_a64(0) }
                emit_push_a64()
                if b4aa_right_sshadow_3 >= 0 { emit_load_var_a64(b4aa_right_sshadow_3) } else { emit_imm64_a64(0) }
                emit_pop_x1_a64()
                if op == 17 { emit_f64_binop_a64(0x1E612800) } else { emit_f64_binop_a64(0x1E613800) }
                let b4aa_sres3 = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var_a64(b4aa_sres3)
                EXPR_SSHADOW_3 = b4aa_sres3
            }
            if b4aa_result_slot >= 0 { emit_load_var_a64(b4aa_result_slot) }
        } else {
            if op == 17 { em32(0x8B000020) }
            if op == 18 { em32(0xCB000020) }
            EXPR_VSHADOW = -1; EXPR_SSHADOW = -1; EXPR_SSHADOW_1 = -1; EXPR_SSHADOW_2 = -1; EXPR_SSHADOW_3 = -1; EXPR_SSHADOW_4 = -1; EXPR_SSHADOW_5 = -1; EXPR_SSHADOW_6 = -1; EXPR_SSHADOW_7 = -1
        }
    }
}

// ─── ARM64 shift ───
fn compile_shift_a64() with IO, Mut, Panic, Div {
    compile_additive_a64()
    while TK[EP as usize] == 39 || TK[EP as usize] == 40 {
        let op = TK[EP as usize]
        EP = EP + 1
        emit_push_a64()
        compile_additive_a64()
        emit_pop_x1_a64()
        if op == 40 { em32(0x9AC02020) }
        if op == 39 { em32(0x9AC02820) }
    }
}

// ─── ARM64 bitand ───
fn compile_bitand_a64() with IO, Mut, Panic, Div {
    compile_shift_a64()
    while TK[EP as usize] == 44 {
        EP = EP + 1; emit_push_a64(); compile_shift_a64()
        emit_pop_x1_a64()
        em32(0x8A010000)
    }
}

// ─── ARM64 bitxor ───
fn compile_bitxor_a64() with IO, Mut, Panic, Div {
    compile_bitand_a64()
    while TK[EP as usize] == 56 {
        EP = EP + 1; emit_push_a64(); compile_bitand_a64()
        emit_pop_x1_a64()
        em32(0xCA010000)
    }
}

// ─── ARM64 bitor ───
fn compile_bitor_a64() with IO, Mut, Panic, Div {
    compile_bitxor_a64()
    while TK[EP as usize] == 45 {
        EP = EP + 1; emit_push_a64(); compile_bitxor_a64()
        emit_pop_x1_a64()
        em32(0xAA010000)
    }
}

// ─── ARM64 comparison ───
fn compile_comparison_a64() with IO, Mut, Panic, Div {
    compile_bitor_a64()
    let op = TK[EP as usize]
    if op == 21 || op == 22 || op == 23 || op == 24 || op == 25 || op == 26 {
        let op_tok = EP
        let left_raw_f64 = EXPR_IS_F64
        let left_raw_ty = EXPR_TY
        let left_raw_hash = EXPR_TY_HASH
        EP = EP + 1
        emit_push_a64()
        compile_bitor_a64()
        let right_raw_ty = EXPR_TY
        let right_raw_hash = EXPR_TY_HASH
        comparison_require_observe(op_tok, left_raw_ty, right_raw_ty)
        let left_ty = comparison_visible_ty(left_raw_ty, left_raw_hash)
        let left_hash = comparison_visible_hash(left_raw_ty, left_raw_hash)
        let right_ty = comparison_visible_ty(right_raw_ty, right_raw_hash)
        let right_hash = comparison_visible_hash(right_raw_ty, right_raw_hash)
        // String == / != : byte-compare, not pointer-compare. The x86 twin
        // (compile_comparison ~19417) special-cases two string operands; without
        // this the arm64 path falls into the generic integer `cmp x1, x0` below,
        // comparing the two string POINTERS — distinct literals never match, so
        // every `str == str` returns false (breaks all CLI/keyword dispatch).
        if left_ty == 3 && right_ty == 3 {
            if op != 21 && op != 22 {
                tc_error(op_tok, "ordered comparison requires matching numeric operands")
            }
            emit_pop_x1_a64()        // x1 = lhs string ptr (x0 already = rhs)
            emit_str_eq_regs_a64()   // x0 = 1 iff bytes equal
            if op == 22 {
                em32(0xF100001F)     // cmp x0, #0
                em32(0x9A9F17E0)     // cset x0, eq  → x0 = 1 iff NOT equal
            }
            EXPR_IS_F64 = 0
            EXPR_TY = 4
            EXPR_TY_HASH = 0
            return
        }
        let left_f64 = if left_raw_f64 == 1 || left_ty == 2 { 1 } else { 0 }
        if op == 21 || op == 22 {
            if ty_eq(left_ty, left_hash, right_ty, right_hash) == false {
                if left_ty != 0 && right_ty != 0 {
                    if (left_ty == 2 && right_ty == 2) == false {
                        if (left_ty == 1 && right_ty == 1) == false {
                            tc_error(op_tok, "comparison operands must have the same type")
                        }
                    }
                }
            }
        } else {
            if left_ty != 0 && right_ty != 0 {
                if ty_is_numeric(left_ty) == false || ty_is_numeric(right_ty) == false || ty_eq(left_ty, left_hash, right_ty, right_hash) == false {
                    tc_error(op_tok, "ordered comparison requires matching numeric operands")
                }
            }
        }
        emit_pop_x1_a64()
        if left_f64 == 1 {
            em32(0x9E670020); em32(0x9E670001); em32(0x1E612000)
            if op == 21 { em32(0x9A9F17E0) }
            if op == 22 { em32(0x9A9F07E0) }
            if op == 23 { em32(0x9A9F27E0) }  // cset x0, lo
            if op == 24 { em32(0x9A9F97E0) }  // cset x0, hi
            if op == 25 { em32(0x9A9F87E0) }  // cset x0, ls
            if op == 26 { em32(0x9A9F37E0) }  // cset x0, hs
        } else {
            em32(0xEB00003F)
            if op == 21 { em32(0x9A9F17E0) }
            if op == 22 { em32(0x9A9F07E0) }
            if op == 23 { em32(0x9A9FA7E0) }
            if op == 24 { em32(0x9A9FD7E0) }  // cset x0, gt
            if op == 25 { em32(0x9A9FC7E0) }  // cset x0, le
            if op == 26 { em32(0x9A9FB7E0) }
        }
        EXPR_IS_F64 = 0
        EXPR_TY = 4
        EXPR_TY_HASH = 0
    }
}

// ─── ARM64 logical AND ───
fn compile_and_a64() with IO, Mut, Panic, Div {
    compile_comparison_a64()
    while TK[EP as usize] == 30 {
        EP = EP + 1
        let cbz_off = CL
        em32(0xB4000000)
        compile_comparison_a64()
        em32(0xF100001F); em32(0x9A9F07E0)
        let b_off = CL
        em32(0x14000000)
        patch_branch_a64(cbz_off, CL)
        em32(0xD2800000)
        patch_branch_a64(b_off, CL)
    }
}

// ─── ARM64 logical OR ───
fn compile_or_a64() with IO, Mut, Panic, Div {
    compile_and_a64()
    while TK[EP as usize] == 31 {
        EP = EP + 1
        let cbnz_off = CL
        em32(0xB5000000)
        compile_and_a64()
        let b_off = CL
        em32(0x14000000)
        patch_branch_a64(cbnz_off, CL)
        emit_imm64_a64(1)
        patch_branch_a64(b_off, CL)
    }
}

// ─── ARM64 statement compiler ───
fn compile_stmt_a64() with IO, Mut, Panic, Div {
    let k = TK[EP as usize]
    LAST_STMT_HAS_VALUE = 0
    if k == 27 { EP = EP + 1; return }
    // let/var
    if k == 11 || k == 12 {
        EP = EP + 1
        if TK[EP as usize] == 6 {
            let pat_start = EP
            var pat_p = EP
            var pat_depth: i64 = 0
            while pat_p < TC {
                if TK[pat_p as usize] == 6 { pat_depth = pat_depth + 1 }
                if TK[pat_p as usize] == 7 {
                    pat_depth = pat_depth - 1
                    pat_p = pat_p + 1
                    if pat_depth == 0 { break }
                    continue
                }
                pat_p = pat_p + 1
            }
            EP = pat_p
            if TK[EP as usize] == 16 { EP = EP + 1 }
            if TK[EP as usize] != 6 {
                compile_or_a64()
                if ret_agg_nslots(EXPR_TY, EXPR_TY_HASH) <= 0 {
                    tc_error(EP, "tuple destructuring: RHS must be a tuple expression")
                    return
                }
                let save_tup_hash = EXPR_TY_HASH
                let sret_ptr_slot = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var_a64(sret_ptr_slot)
                tuple_destructure_from_ptr_a64(pat_start, save_tup_hash, sret_ptr_slot)
                return
            }
            tuple_bind_pattern_a64(pat_start, EP)
            EP = TUP_RHS_NEXT
            return
        }
        // Phase 1.6: struct pattern — let TypeName { field1, field2 } = expr (ARM64)
        if TK[EP as usize] == 3 && TK[(EP + 1) as usize] == 8 {
            let sname_ns = TS[EP as usize]
            let sname_ne = TE[EP as usize]
            let sname_hash = gl_name_hash(sname_ns, sname_ne)
            let si = st_find(sname_hash)
            if si >= 0 {
                let pat_start = EP + 1
                var skip_p = EP + 1
                var sdepth: i64 = 0
                while skip_p < TC {
                    if TK[skip_p as usize] == 8 { sdepth = sdepth + 1 }
                    if TK[skip_p as usize] == 9 {
                        sdepth = sdepth - 1
                        skip_p = skip_p + 1
                        if sdepth == 0 { break }
                    }
                    skip_p = skip_p + 1
                }
                EP = skip_p
                if TK[EP as usize] == 16 { EP = EP + 1 }
                compile_or_a64()
                let sptr_slot = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var_a64(sptr_slot)
                struct_destructure_a64(pat_start, si, sptr_slot)
                return
            }
        }
        let ns = TS[EP as usize]
        let ne = TE[EP as usize]
        EP = EP + 1
        var is_arr: i64 = 0
        var arr_len: i64 = 0
        var arr_esiz: i64 = 8
        var decl_is_f64: i64 = -1
        var decl_ty: i64 = 0
        var decl_ty_hash: i64 = 0
        let decl_is_mut: i64 = if k == 12 { 1 } else { 0 }
        if TK[EP as usize] == 43 {
            EP = EP + 1
            let ann_ns = TS[EP as usize]
            let ann_ne = TE[EP as usize]
            if TK[EP as usize] == 41 {
                EP = EP + 1
                var arr_elem_ty: i64 = 0
                var arr_elem_hash: i64 = 0
                // Knowledge<T> element: scan the full type so the kind=7 element hash
                // is captured (`[Knowledge[f64]; N]`); the single-token path below only
                // handles simple names + registered structs.
                if src_match(TS[EP as usize], TE[EP as usize] - TS[EP as usize], "Knowledge")
                   && (TK[(EP + 1) as usize] == 41 || TK[(EP + 1) as usize] == 23) {
                    scan_type(EP)
                    arr_elem_ty = SCAN_TY
                    arr_elem_hash = SCAN_TY_HASH
                    EP = SCAN_TY_NEXT
                } else {
                    let etns = TS[EP as usize]
                    let etne = TE[EP as usize]
                    arr_elem_ty = type_name_kind(etns, etne)
                    if arr_elem_ty == 6 || arr_elem_ty == 7 { arr_elem_hash = gl_name_hash(etns, etne) }
                    if src_match(etns, etne - etns, "i8") { arr_esiz = 1 }
                    EP = EP + 1
                }
                if TK[EP as usize] == 27 { EP = EP + 1 }
                arr_len = TV[EP as usize]; EP = EP + 1
                if TK[EP as usize] == 42 { EP = EP + 1 }
                is_arr = 1
                decl_ty = 8
                decl_ty_hash = arr_ty_hash_for_elem_type(arr_len, arr_esiz, arr_elem_ty, arr_elem_hash)
                decl_is_f64 = 0
            } else {
                scan_type(EP)
                decl_ty = SCAN_TY
                decl_ty_hash = SCAN_TY_HASH
                if knowledge_hash_invalid(decl_ty_hash) {
                    tc_epistemic_boundary(EP)
                    decl_ty = 0
                    decl_ty_hash = 0
                }
                if decl_ty == 0 && name_is_lower(ann_ns, ann_ne) {
                    decl_ty = 2
                    decl_ty_hash = gl_name_hash(ann_ns, ann_ne)
                }
                if decl_ty == 0 && decl_ty_hash != 0 && type_hash_unit_dim(decl_ty_hash) != 0 {
                    decl_ty = 2
                }
                if decl_ty == 2 { decl_is_f64 = 1 }
                else { decl_is_f64 = 0 }
                EP = SCAN_TY_NEXT
            }
        }
        var has_eq: i64 = 0
        if TK[EP as usize] == 16 { EP = EP + 1; has_eq = 1 }
        if is_arr == 1 && arr_len > 0 && TK[EP as usize] == 41 && array_init_is_repeat(EP) {
            EP = EP + 1
            let a64_val_ep = EP
            while ep_before_body_close() && TK[EP as usize] != 42 && TK[EP as usize] != 0 { EP = EP + 1 }
            if TK[EP as usize] == 42 { EP = EP + 1 }
            let a64_after_ep = EP
            var nslots = arr_len
            if arr_esiz == 1 { nslots = (arr_len + 7) / 8 }
            let ptr_slot = var_add_arr(ns, ne, nslots, arr_esiz, arr_hash_elem_ty(decl_ty_hash))
            if ptr_slot < 0 { return }
            let arr_vi = VAR_COUNT - 1
            VAR_TY[arr_vi as usize] = 8
            VAR_TY_HASH[arr_vi as usize] = decl_ty_hash
            VAR_MUT[arr_vi as usize] = decl_is_mut
            let base = ptr_slot - nslots
            // Mirror of the x86 decl-init: aggregates get a RUNTIME loop
            // (O(1) code) allocating a fresh heap copy per slot; 8-byte
            // scalars get the real V-splat (this path used to IGNORE V and
            // zero-fill: null element pointers / silent zeros).
            let d_ty = arr_hash_elem_ty(decl_ty_hash)
            let d_hash = arr_hash_elem_hash(decl_ty_hash)
            if d_ty == 6 && struct_like_nslots(d_hash) > 0 && LAST_LOCAL_BSS_SPILL == 0 {
                let d_nsl = struct_like_nslots(d_hash)
                EP = a64_val_ep
                compile_or_a64()
                EP = a64_after_ep
                let rl_src = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var_a64(rl_src)
                emit_lea_var_a64(base + nslots - 1)
                let rl_base = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var_a64(rl_base)
                // One BLOCK allocation for all N elements (mirror of the
                // x86 page-granularity fix). Element i at block + i*stride.
                emit_imm64_a64(nslots * d_nsl * 8)
                emit_heap_alloc_a64()
                let rl_blk = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var_a64(rl_blk)
                em32(0xD2800000)  // mov x0, #0 (i)
                let rl_i = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var_a64(rl_i)
                let rl_head = CL
                emit_load_var_a64(rl_i)
                em32(0xAA0003E9)  // mov x9, x0
                emit_imm64_reg_a64(10, nslots)
                em32(0xEB0A013F)  // cmp x9, x10
                let rl_exit = CL
                em32(0x5400000A)  // b.ge done (patched)
                emit_load_var_a64(rl_i)
                emit_imm64_reg_a64(11, d_nsl * 8)
                em32(0x9B0B7C00)  // mul x0, x0, x11
                em32(0xAA0003EB)  // mov x11, x0 (off)
                emit_load_var_a64(rl_blk)
                em32(0x8B0B0000)  // add x0, x0, x11 (elem dst)
                let rl_new = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var_a64(rl_new)
                emit_load_var_a64(rl_src)
                em32(0xAA0003EA)  // mov x10, x0 (src)
                emit_load_var_a64(rl_new)
                emit_copy_agg_to_ptr_a64(6, d_hash)
                emit_load_var_a64(rl_new)
                em32(0xAA0003EA)  // mov x10, x0 (new)
                emit_load_var_a64(rl_i)
                em32(0xAA0003E1)  // mov x1, x0 (i)
                emit_load_var_a64(rl_base)
                em32(0xF821780A)  // str x10, [x0, x1, lsl #3]
                emit_load_var_a64(rl_i)
                em32(0x91000400)  // add x0, x0, #1
                emit_store_var_a64(rl_i)
                let rl_b = CL
                let rl_rel = (rl_head - rl_b) / 4
                em32(0x14000000 | (rl_rel & 0x3FFFFFF))  // b head
                patch_branch_a64(rl_exit, CL)
                emit_load_var_a64(rl_base)
                emit_store_var_a64(ptr_slot)
                return
            }
            if arr_esiz != 1 && LAST_LOCAL_BSS_SPILL == 0 {
                EP = a64_val_ep
                compile_or_a64()
                EP = a64_after_ep
                em32(0xAA0003ED)  // mov x13, x0 (V)
                emit_lea_var_a64(base + nslots - 1)
                em32(0xAA0003EB)  // mov x11, x0
                emit_fill_words_x13_x11_a64(nslots)
                emit_lea_var_a64(base + nslots - 1)
                emit_store_var_a64(ptr_slot)
                return
            }
            if LAST_LOCAL_BSS_SPILL != 0 {
                emit_image_addr_reg_a64(11, LAST_LOCAL_BSS_ADDR)
                emit_zero_words_x11_a64(nslots)
                emit_image_addr_a64(LAST_LOCAL_BSS_ADDR)
            } else {
                emit_lea_var_a64(base + nslots - 1)
                em32(0xAA0003EB)  // mov x11, x0
                emit_zero_words_x11_a64(nslots)
                emit_lea_var_a64(base + nslots - 1)
            }
            emit_store_var_a64(ptr_slot)
        } else if has_eq == 0 && (decl_ty != 0 || decl_ty_hash != 0) && type_is_struct_like(decl_ty, decl_ty_hash) {
            // `var x: StructT` with no initializer — register + zero-fill (mirror
            // of the x86 twin, compile_stmt :~22226). Without this the a64 pass
            // never bound `x`, so later `x.field = …` raised "unknown identifier"
            // (the native/*.sio `var out: Elf64Binary` class, #740).
            bind_struct_local_zeroinit_a64(ns, ne, decl_ty_hash)
        } else if has_eq == 0 && type_is_option_inline(decl_ty, decl_ty_hash) {
            let opt_tag_slot = var_add_option_inline(ns, ne, decl_ty_hash)
            if opt_tag_slot >= 0 {
                em32(0xD2800000)
                emit_store_var_a64(opt_tag_slot)
                emit_store_var_a64(opt_tag_slot - 1)
                VAR_MUT[(VAR_COUNT - 1) as usize] = decl_is_mut
            }
        } else {
            compile_or_a64()
            if (decl_ty != 0 || decl_ty_hash != 0) && ty_eq(decl_ty, decl_ty_hash, EXPR_TY, EXPR_TY_HASH) == false {
                if type_has_knowledge(decl_ty, decl_ty_hash) || type_has_knowledge(EXPR_TY, EXPR_TY_HASH) {
                    tc_epistemic_boundary(EP)
                } else {
                    tc_decl_init_mismatch(EP - 1, decl_ty, decl_ty_hash, EXPR_TY, EXPR_TY_HASH)
                }
            }
            if type_is_slice_ref(decl_ty, decl_ty_hash) || (decl_ty == 0 && type_is_slice_ref(EXPR_TY, EXPR_TY_HASH)) {
                var bind_hash = EXPR_TY_HASH
                if decl_ty != 0 || decl_ty_hash != 0 { bind_hash = decl_ty_hash }
                let before_vc = VAR_COUNT
                bind_slice_local_from_x0_a64(ns, ne, bind_hash)
                if VAR_COUNT > before_vc {
                    let svix = VAR_COUNT - 1
                    VAR_IS_CLOSURE[svix as usize] = 0
                    VAR_MUT[svix as usize] = decl_is_mut
                    VAR_LINEAR[svix as usize] = 0
                }
            } else if (decl_ty == 8) || (decl_ty == 0 && EXPR_TY == 8) {
                var bind_hash = EXPR_TY_HASH
                if decl_ty == 8 { bind_hash = decl_ty_hash }
                let before_vc = VAR_COUNT
                bind_array_local_from_x0_a64(ns, ne, bind_hash)
                if VAR_COUNT > before_vc {
                    let avix = VAR_COUNT - 1
                    VAR_IS_CLOSURE[avix as usize] = 0
                    VAR_MUT[avix as usize] = decl_is_mut
                    VAR_LINEAR[avix as usize] = 0
                }
            } else if type_is_option_inline(decl_ty, decl_ty_hash) || (decl_ty == 0 && type_is_option_inline(EXPR_TY, EXPR_TY_HASH)) {
                var bind_hash = EXPR_TY_HASH
                if option_hash_is(decl_ty_hash) { bind_hash = decl_ty_hash }
                let opt_slot = var_add_option_inline(ns, ne, bind_hash)
                if opt_slot >= 0 {
                    emit_copy_option_to_local_a64(opt_slot)
                    VAR_MUT[(VAR_COUNT - 1) as usize] = decl_is_mut
                }
            } else if type_is_struct_like(decl_ty, decl_ty_hash) || (decl_ty == 0 && type_is_struct_like(EXPR_TY, EXPR_TY_HASH)) {
                var bind_hash = EXPR_TY_HASH
                if decl_ty != 0 || decl_ty_hash != 0 { bind_hash = decl_ty_hash }
                let before_vc = VAR_COUNT
                bind_struct_local_from_x0_a64(ns, ne, bind_hash)
                if VAR_COUNT > before_vc {
                    let svix = VAR_COUNT - 1
                    VAR_IS_CLOSURE[svix as usize] = 0
                    VAR_MUT[svix as usize] = decl_is_mut
                }
            } else {
                let slot = var_add(ns, ne)
                if slot < 0 { return }
                let vix = VAR_COUNT - 1
                emit_store_var_a64(slot)
                if decl_is_f64 == 1 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 1 }
                else if decl_is_f64 == 0 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 0 }
                else { VAR_IS_F64[(VAR_COUNT - 1) as usize] = EXPR_IS_F64 }
                if decl_ty != 0 || decl_ty_hash != 0 {
                    VAR_TY[vix as usize] = decl_ty
                    VAR_TY_HASH[vix as usize] = decl_ty_hash
                } else {
                    VAR_TY[vix as usize] = EXPR_TY
                    VAR_TY_HASH[vix as usize] = EXPR_TY_HASH
                }
                if VAR_TY[vix as usize] == 8 {
                    VAR_ALEN[vix as usize] = arr_hash_alen(VAR_TY_HASH[vix as usize])
                    VAR_ESIZ[vix as usize] = arr_hash_esiz(VAR_TY_HASH[vix as usize])
                }
                if EXPR_TY == 9 { LAST_EXPR_IS_CLOSURE = 1 }
                VAR_IS_CLOSURE[(VAR_COUNT - 1) as usize] = LAST_EXPR_IS_CLOSURE
                VAR_MUT[(VAR_COUNT - 1) as usize] = decl_is_mut
                VAR_LINEAR[(VAR_COUNT - 1) as usize] = LAST_EXPR_IS_LINEAR
                // β⁴/β⁵: capture variance/sensitivity shadow into the new variable
                // Mutable f64 vars get a fixed runtime slot so variance_of() works across loop iterations
                if decl_is_mut == 1 && EXPR_IS_F64 == 1 {
                    let fixed_vs = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + 1
                    VAR_VSHADOW[vix as usize] = fixed_vs
                    if EXPR_VSHADOW >= 0 { emit_load_var_a64(EXPR_VSHADOW) }
                    else { em32(0xD2800000) }
                    emit_store_var_a64(fixed_vs)
                } else {
                    VAR_VSHADOW[vix as usize] = EXPR_VSHADOW
                }
                VAR_SSHADOW[vix as usize] = EXPR_SSHADOW
                VAR_SSHADOW_1[vix as usize] = EXPR_SSHADOW_1
                VAR_SSHADOW_2[vix as usize] = EXPR_SSHADOW_2
                VAR_SSHADOW_3[vix as usize] = EXPR_SSHADOW_3
                VAR_SSHADOW_4[vix as usize] = EXPR_SSHADOW_4
                VAR_SSHADOW_5[vix as usize] = EXPR_SSHADOW_5
                VAR_SSHADOW_6[vix as usize] = EXPR_SSHADOW_6
                VAR_SSHADOW_7[vix as usize] = EXPR_SSHADOW_7
                VAR_HSHADOW_00[vix as usize] = EXPR_HSHADOW_00
                VAR_HSHADOW_01[vix as usize] = EXPR_HSHADOW_01
                VAR_HSHADOW_02[vix as usize] = EXPR_HSHADOW_02
                VAR_HSHADOW_03[vix as usize] = EXPR_HSHADOW_03
                VAR_HSHADOW_11[vix as usize] = EXPR_HSHADOW_11
                VAR_HSHADOW_12[vix as usize] = EXPR_HSHADOW_12
                VAR_HSHADOW_13[vix as usize] = EXPR_HSHADOW_13
                VAR_HSHADOW_22[vix as usize] = EXPR_HSHADOW_22
                VAR_HSHADOW_23[vix as usize] = EXPR_HSHADOW_23
                VAR_HSHADOW_33[vix as usize] = EXPR_HSHADOW_33
                VAR_HSHADOW_04[vix as usize] = EXPR_HSHADOW_04
                VAR_HSHADOW_05[vix as usize] = EXPR_HSHADOW_05
                VAR_HSHADOW_06[vix as usize] = EXPR_HSHADOW_06
                VAR_HSHADOW_07[vix as usize] = EXPR_HSHADOW_07
                VAR_HSHADOW_14[vix as usize] = EXPR_HSHADOW_14
                VAR_HSHADOW_15[vix as usize] = EXPR_HSHADOW_15
                VAR_HSHADOW_16[vix as usize] = EXPR_HSHADOW_16
                VAR_HSHADOW_17[vix as usize] = EXPR_HSHADOW_17
                VAR_HSHADOW_24[vix as usize] = EXPR_HSHADOW_24
                VAR_HSHADOW_25[vix as usize] = EXPR_HSHADOW_25
                VAR_HSHADOW_26[vix as usize] = EXPR_HSHADOW_26
                VAR_HSHADOW_27[vix as usize] = EXPR_HSHADOW_27
                VAR_HSHADOW_34[vix as usize] = EXPR_HSHADOW_34
                VAR_HSHADOW_35[vix as usize] = EXPR_HSHADOW_35
                VAR_HSHADOW_36[vix as usize] = EXPR_HSHADOW_36
                VAR_HSHADOW_37[vix as usize] = EXPR_HSHADOW_37
                VAR_HSHADOW_44[vix as usize] = EXPR_HSHADOW_44
                VAR_HSHADOW_45[vix as usize] = EXPR_HSHADOW_45
                VAR_HSHADOW_46[vix as usize] = EXPR_HSHADOW_46
                VAR_HSHADOW_47[vix as usize] = EXPR_HSHADOW_47
                VAR_HSHADOW_55[vix as usize] = EXPR_HSHADOW_55
                VAR_HSHADOW_56[vix as usize] = EXPR_HSHADOW_56
                VAR_HSHADOW_57[vix as usize] = EXPR_HSHADOW_57
                VAR_HSHADOW_66[vix as usize] = EXPR_HSHADOW_66
                VAR_HSHADOW_67[vix as usize] = EXPR_HSHADOW_67
                VAR_HSHADOW_77[vix as usize] = EXPR_HSHADOW_77
                // β⁹ GTT: persist RHS channel topology (a64 path).
                VAR_CH_SET[vix as usize] = EXPR_CH_SET
                VAR_PARAM_USED[vix as usize] = EXPR_PARAM_USED
                EXPR_VSHADOW = -1
                EXPR_SSHADOW = -1
                EXPR_SSHADOW_1 = -1; EXPR_SSHADOW_2 = -1; EXPR_SSHADOW_3 = -1; EXPR_SSHADOW_4 = -1; EXPR_SSHADOW_5 = -1; EXPR_SSHADOW_6 = -1; EXPR_SSHADOW_7 = -1
                EXPR_HSHADOW_00 = -1; EXPR_HSHADOW_01 = -1; EXPR_HSHADOW_02 = -1; EXPR_HSHADOW_03 = -1
                EXPR_HSHADOW_11 = -1; EXPR_HSHADOW_12 = -1; EXPR_HSHADOW_13 = -1
                EXPR_HSHADOW_22 = -1; EXPR_HSHADOW_23 = -1; EXPR_HSHADOW_33 = -1
    EXPR_HSHADOW_04 = -1; EXPR_HSHADOW_05 = -1; EXPR_HSHADOW_06 = -1; EXPR_HSHADOW_07 = -1
    EXPR_HSHADOW_14 = -1; EXPR_HSHADOW_15 = -1; EXPR_HSHADOW_16 = -1; EXPR_HSHADOW_17 = -1
    EXPR_HSHADOW_24 = -1; EXPR_HSHADOW_25 = -1; EXPR_HSHADOW_26 = -1; EXPR_HSHADOW_27 = -1
    EXPR_HSHADOW_34 = -1; EXPR_HSHADOW_35 = -1; EXPR_HSHADOW_36 = -1; EXPR_HSHADOW_37 = -1
    EXPR_HSHADOW_44 = -1; EXPR_HSHADOW_45 = -1; EXPR_HSHADOW_46 = -1; EXPR_HSHADOW_47 = -1
    EXPR_HSHADOW_55 = -1; EXPR_HSHADOW_56 = -1; EXPR_HSHADOW_57 = -1
    EXPR_HSHADOW_66 = -1; EXPR_HSHADOW_67 = -1
    EXPR_HSHADOW_77 = -1
                EXPR_CH_SET = 0
                EXPR_PARAM_USED = 0
            }
        }
        return
    }
    // x.f1.f2[idx] = expr — two chained field accesses then an array index.
    if stmt_is_field_field_array_store_shape(EP) {
        if token_chain_root_is_pointer(EP) {
            compile_autoderef_field_field_array_store_a64()
        } else {
            compile_value_field_field_array_store_a64()
        }
        return
    }
    // x.f1.f2 = expr — two chained field accesses, no array, through a
    // pointer var (auto-deref) OR an inline value struct.
    if stmt_is_field_field_store_shape(EP) {
        if token_chain_root_is_pointer(EP) {
            compile_autoderef_field_field_store_a64()
        } else {
            compile_value_field_field_store_a64()
        }
        return
    }
    // x.array_field[idx].leaf_array[idx2] = expr
    if stmt_is_indexed_field_field_array_store(EP) {
        if current_fn_allows_mutation() == false {
            tc_effect_violation(EP, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        compile_indexed_field_field_array_store_a64()
        return
    }
    // x.array_field[idx].leaf = expr
    if stmt_is_indexed_field_field_store(EP) {
        if current_fn_allows_mutation() == false {
            tc_effect_violation(EP, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        compile_indexed_field_field_store_a64()
        return
    }
    // x.field[idx] = expr
    if stmt_is_field_array_store(EP) {
        if current_fn_allows_mutation() == false {
            tc_effect_violation(EP, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        compile_field_array_store_a64()
        return
    }

    // x.field = expr
    if k == 3 && TK[(EP + 1) as usize] == 50 && TK[(EP + 3) as usize] == 16 {
        let name_tok = EP
        if current_fn_allows_mutation() == false {
            tc_effect_violation(name_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[EP as usize]; let ne = TE[EP as usize]
        let field_tok = EP + 2
        EP = EP + 2
        let fns = TS[EP as usize]; let fne = TE[EP as usize]
        let fh = gl_name_hash(fns, fne)
        EP = EP + 1
        if TK[EP as usize] == 16 { EP = EP + 1 }
        compile_or_a64()
        let rhs_ty = EXPR_TY
        let rhs_ty_hash = EXPR_TY_HASH
        ST_QUERY_NS = fns
        ST_QUERY_NE = fne
        let si = resolve_field_struct_index(ns, ne, fh)
        ST_QUERY_NS = -1
        ST_QUERY_NE = -1
        if si < 0 {
            tc_error(field_tok, "unknown field access")
            return
        }
        if st_private_access_denied(si, field_tok) {
            tc_error_hard(field_tok, "private struct field access")
            return
        }
        ST_QUERY_NS = fns
        ST_QUERY_NE = fne
        let off = st_field_offset(si, fh)
        let fty = st_field_ty(si, fh)
        let fhash = st_field_hash(si, fh)
        ST_QUERY_NS = -1
        ST_QUERY_NE = -1
        if fty != 0 && ty_eq(fty, fhash, rhs_ty, rhs_ty_hash) == false {
            tc_error(EP - 1, "assignment type mismatch")
        }
        emit_push_a64()
        let slot = var_find(ns, ne)
        if slot >= 0 { emit_load_var_a64(slot) }
        else {
            let gi = gl_find(ns, ne)
            if gi >= 0 { emit_image_addr_a64(GL_BSS_BASE + GL[(gi * 4 + 1) as usize]) }
            else { tc_undefined_var(name_tok); em32(0xD2800000) }
        }
        if off != 0 {
            emit_imm64_reg_a64(11, off)
            em32(0x8B0B0000)  // add x0, x0, x11
        }
        emit_pop_x1_a64()
        if fty == 8 || type_is_option_inline(fty, fhash) || fty == 6 || knowledge_hash_is(fhash) {
            em32(0xAA0103EA)  // mov x10, x1
            emit_copy_agg_to_ptr_a64(fty, fhash)
        } else {
            em32(0xF9000001)  // str x1, [x0]
        }
        return
    }
    // x = expr
    if k == 3 && TK[(EP + 1) as usize] == 16 {
        let name_tok = EP
        if current_fn_allows_mutation() == false {
            tc_effect_violation(name_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[EP as usize]; let ne = TE[EP as usize]
        EP = EP + 2
        compile_or_a64()
        let rhs_ty = EXPR_TY
        let rhs_ty_hash = EXPR_TY_HASH
        let slot = var_find(ns, ne)
        if slot >= 0 {
            let ty_vi = var_find_idx(ns, ne)
            if ty_vi >= 0 {
                if VAR_MUT[ty_vi as usize] == 0 {
                    tc_error_hard(name_tok, "assignment to immutable binding requires var/Mut")
                }
                if ty_eq(VAR_TY[ty_vi as usize], VAR_TY_HASH[ty_vi as usize], rhs_ty, rhs_ty_hash) == false {
                    tc_error(EP - 1, "assignment type mismatch")
                }
            }
            if ty_vi >= 0 && VAR_TY[ty_vi as usize] == 8 {
                copy_array_into_local_slot_a64(slot, VAR_TY_HASH[ty_vi as usize])
            } else if ty_vi >= 0 && type_is_option_inline(VAR_TY[ty_vi as usize], VAR_TY_HASH[ty_vi as usize]) && VAR_ESIZ[ty_vi as usize] >= 16 {
                emit_copy_option_to_local_a64(slot)
            } else if ty_vi >= 0 && type_is_struct_like(VAR_TY[ty_vi as usize], VAR_TY_HASH[ty_vi as usize]) {
                copy_struct_into_local_slot_a64(slot, VAR_TY_HASH[ty_vi as usize])
            } else {
                emit_store_var_a64(slot)
            }
            // β⁵: update variance/sensitivity shadow on var reassignment (a64)
            if ty_vi >= 0 {
                if VAR_MUT[ty_vi as usize] == 1 && VAR_IS_F64[ty_vi as usize] == 1 {
                    // Fixed runtime variance slot: emit runtime update code
                    let fixed_vs = VAR_VSHADOW[ty_vi as usize]
                    if fixed_vs >= 0 {
                        if EXPR_VSHADOW >= 0 { emit_load_var_a64(EXPR_VSHADOW) }
                        else { em32(0xD2800000) }
                        emit_store_var_a64(fixed_vs)
                    }
                    VAR_SSHADOW[ty_vi as usize] = EXPR_SSHADOW
                    VAR_SSHADOW_1[ty_vi as usize] = EXPR_SSHADOW_1
                    VAR_SSHADOW_2[ty_vi as usize] = EXPR_SSHADOW_2
                    VAR_SSHADOW_3[ty_vi as usize] = EXPR_SSHADOW_3
                } else {
                    VAR_VSHADOW[ty_vi as usize] = EXPR_VSHADOW
                    VAR_SSHADOW[ty_vi as usize] = EXPR_SSHADOW
                    VAR_SSHADOW_1[ty_vi as usize] = EXPR_SSHADOW_1
                    VAR_SSHADOW_2[ty_vi as usize] = EXPR_SSHADOW_2
                    VAR_SSHADOW_3[ty_vi as usize] = EXPR_SSHADOW_3
                }
            }
            EXPR_VSHADOW = -1; EXPR_SSHADOW = -1; EXPR_SSHADOW_1 = -1; EXPR_SSHADOW_2 = -1; EXPR_SSHADOW_3 = -1; EXPR_SSHADOW_4 = -1; EXPR_SSHADOW_5 = -1; EXPR_SSHADOW_6 = -1; EXPR_SSHADOW_7 = -1
            if EXPR_TY == 9 { LAST_EXPR_IS_CLOSURE = 1 }
            var vi: i64 = VAR_COUNT - 1
            while vi >= 0 {
                if name_eq(VAR_NS[vi as usize], VAR_NE[vi as usize], ns, ne) { VAR_IS_CLOSURE[vi as usize] = LAST_EXPR_IS_CLOSURE; vi = -1 }
                vi = vi - 1
            }
        } else {
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                if ty_eq(GL_TY[gi as usize], GL_TY_HASH[gi as usize], rhs_ty, rhs_ty_hash) == false {
                    tc_error(EP - 1, "assignment type mismatch")
                }
                let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                if type_is_option_inline(GL_TY[gi as usize], GL_TY_HASH[gi as usize]) && GL[(gi * 4 + 2) as usize] >= 16 {
                    em32(0xAA0003EA)
                    emit_image_addr_a64(addr)
                    emit_copy_agg_to_ptr_a64(11, GL_TY_HASH[gi as usize])
                } else if type_is_struct_like(GL_TY[gi as usize], GL_TY_HASH[gi as usize]) || knowledge_hash_is(GL_TY_HASH[gi as usize]) {
                    em32(0xAA0003EA)
                    emit_image_addr_a64(addr)
                    emit_copy_agg_to_ptr_a64(6, GL_TY_HASH[gi as usize])
                } else {
                    em32(0xAA0003E1)
                    emit_image_addr_a64(addr)
                    em32(0xF9000001)
                }
            } else {
                tc_undefined_var(name_tok)
            }
        }
        return
    }
    // ARRAY[idx] = expr
    if stmt_is_array_store(EP) {
        let name_tok = EP
        if current_fn_allows_mutation() == false {
            tc_effect_violation(name_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[EP as usize]; let ne = TE[EP as usize]
        EP = EP + 2
        compile_or_a64()
        if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
        if TK[EP as usize] == 42 { EP = EP + 1 }
        if TK[EP as usize] == 16 { EP = EP + 1 }
        emit_push_a64()
        compile_or_a64()
        let gi = gl_find(ns, ne)
        if gi >= 0 {
            let base = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
            let esz = GL[(gi * 4 + 2) as usize]
            materialize_aggregate_array_element_a64(GL_TY_HASH[gi as usize])
            em32(0xAA0003EA)
            emit_pop_x1_a64()
            emit_image_addr_a64(base)
            if esz == 8 { em32(0xF821780A) }
            else { em32(0x3821680A) }
        } else {
            let lslot = var_find(ns, ne)
            if lslot >= 0 {
                let llalen = var_find_alen(ns, ne)
                let lesiz = var_find_esiz(ns, ne)
                let lvi = var_find_idx(ns, ne)
                var is_arr_ty = 0
                var is_slice_ty = 0
                var array_hash: i64 = 0
                if lvi >= 0 && VAR_TY[lvi as usize] == 8 { is_arr_ty = 1; array_hash = VAR_TY_HASH[lvi as usize] }
                if lvi >= 0 && VAR_TY[lvi as usize] == 10 {
                    if ref_hash_inner_ty(VAR_TY_HASH[lvi as usize]) == 8 {
                        is_arr_ty = 1
                        array_hash = ref_hash_inner_hash(VAR_TY_HASH[lvi as usize])
                        if type_is_slice_ref(VAR_TY[lvi as usize], VAR_TY_HASH[lvi as usize]) { is_slice_ty = 1 }
                    }
                }
                materialize_aggregate_array_element_a64(array_hash)
                em32(0xAA0003EA)
                emit_pop_x1_a64()
                if is_slice_ty == 1 {
                    emit_load_var_a64(VAR_LEN_SLOT[lvi as usize])
                    em32(0xEB00003F)  // cmp x1, x0
                    let slice_store_ok = CL
                    em32(0x54000003)  // b.lo ok
                    emit_assert_fail_a64()
                    patch_branch_a64(slice_store_ok, CL)
                }
                emit_load_var_a64(lslot)
                // Derive the element width from the array hash, not the stale
                // VAR_ESIZ (var_find_esiz can return 8 for a `&! [i8; N]` param,
                // which would emit a qword `str …,lsl#3` for a BYTE array —
                // scaling the index ×8 and writing 8N bytes out of bounds,
                // clobbering the caller frame). Mirrors the read path, which
                // already uses arr_hash_esiz(inner_hash).
                var eff_esiz = lesiz
                if is_arr_ty == 1 && array_hash != 0 { eff_esiz = arr_hash_esiz(array_hash) }
                if is_arr_ty == 1 && eff_esiz == 8 { em32(0xF821780A) }
                else { em32(0x3821680A) }
            } else {
                tc_undefined_var(name_tok)
                emit_pop_x1_a64()
            }
        }
        return
    }
    // (*name).field[idx] = expr  (explicit-deref store into a struct array field)
    if stmt_is_deref_field_array_store(EP) {
        compile_deref_field_array_store_a64()
        return
    }
    // (*ARRAY_PTR)[idx] = expr
    if stmt_is_deref_array_store(EP) {
        let name_tok = EP + 2
        if current_fn_allows_mutation() == false {
            tc_effect_violation(name_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[(EP + 2) as usize]; let ne = TE[(EP + 2) as usize]
        EP = EP + 5
        compile_or_a64()
        if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
        if TK[EP as usize] == 42 { EP = EP + 1 }
        if TK[EP as usize] == 16 { EP = EP + 1 }
        emit_push_a64()
        compile_or_a64()
        let lslot = var_find(ns, ne)
        if lslot >= 0 {
            let lesiz = var_find_esiz(ns, ne)
            em32(0xAA0003EA)
            emit_pop_x1_a64()
            emit_load_var_a64(lslot)
            if lesiz == 8 { em32(0xF821780A) }
            else { em32(0x3821680A) }
        } else {
            tc_undefined_var(name_tok)
            emit_pop_x1_a64()
        }
        return
    }
    // *PTR = expr
    if stmt_is_deref_store(EP) {
        let name_tok = EP + 1
        if current_fn_allows_mutation() == false {
            tc_effect_violation(name_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[(EP + 1) as usize]
        let ne = TE[(EP + 1) as usize]
        EP = EP + 2
        if TK[EP as usize] == 16 { EP = EP + 1 }
        compile_or_a64()
        let rhs_ty = EXPR_TY
        let rhs_ty_hash = EXPR_TY_HASH
        let lslot = var_find(ns, ne)
        if lslot >= 0 {
            let lvi = var_find_idx(ns, ne)
            // See the x86 twin above (compile_deref_store_x86-equivalent) for the
            // full rationale — issue #620: a mutable ref (VAR_TY 10, &!T) shares the
            // raw pointer's inner-type hash encoding and runtime representation and
            // must be allowed to store, not just VAR_TY 11 raw pointers.
            let lvar_ty = VAR_TY[lvi as usize]
            let lvar_hash = VAR_TY_HASH[lvi as usize]
            let is_raw_ptr = lvar_ty == 11 && type_is_pointer_like(lvar_ty, lvar_hash)
            let is_mut_ref = lvar_ty == 10 && ref_hash_mut(lvar_hash) != 0
            if lvi >= 0 && (is_raw_ptr || is_mut_ref) {
                let inner_ty = ptr_hash_inner_ty(lvar_hash)
                let inner_hash = ptr_hash_inner_hash(lvar_hash)
                if ty_eq(inner_ty, inner_hash, rhs_ty, rhs_ty_hash) == false {
                    tc_error(EP - 1, "assignment type mismatch")
                }
                emit_store_to_pointer_offset_a64(lslot, 0, inner_ty, inner_hash)
            } else {
                tc_error(name_tok, "dereference assignment requires a raw pointer or a mutable (&!T) reference binding")
            }
        } else {
            tc_undefined_var(name_tok)
        }
        return
    }
    // (*name).field1.field2 = expr — two-level nested field store through a *mut/ref.
    // a64 mirror of compile_deref_field_field_store_x86. WITHOUT this, `(*c).env.count = X`
    // (env is an inline sub-struct) fell to the generic assignment path, which materialised
    // the intermediate INLINE field as a value-copy, wrote into the copy, and discarded it —
    // so the checker env.count never incremented (read back 0) and the runtime-builtin
    // bindings (Some/None/…) were lost → standalone files (no imports) E137'd.
    if stmt_is_deref_field_field_store(EP) {
        let ff_name_tok = EP + 2
        let ff_field1_tok = EP + 5
        let ff_field2_tok = EP + 7
        if current_fn_allows_mutation() == false {
            tc_effect_violation(ff_field2_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ff_ns = TS[ff_name_tok as usize]
        let ff_ne = TE[ff_name_tok as usize]
        let ff_h1 = gl_name_hash(TS[ff_field1_tok as usize], TE[ff_field1_tok as usize])
        let ff_h2 = gl_name_hash(TS[ff_field2_tok as usize], TE[ff_field2_tok as usize])
        EP = EP + 9
        compile_or_a64()
        let ff_rhs_ty = EXPR_TY
        let ff_rhs_hash = EXPR_TY_HASH
        let ff_lslot = var_find(ff_ns, ff_ne)
        if ff_lslot < 0 {
            tc_undefined_var(ff_name_tok)
            return
        }
        let ff_lvi = var_find_idx(ff_ns, ff_ne)
        if ff_lvi < 0 || type_is_pointer_like(VAR_TY[ff_lvi as usize], VAR_TY_HASH[ff_lvi as usize]) == false {
            tc_error(ff_field1_tok, "field access through deref requires ref or pointer binding")
            return
        }
        let ff_inner_ty = ptr_hash_inner_ty(VAR_TY_HASH[ff_lvi as usize])
        let ff_inner_hash = ptr_hash_inner_hash(VAR_TY_HASH[ff_lvi as usize])
        if ff_inner_ty != 6 {
            tc_error(ff_field1_tok, "field access through pointer/ref requires struct pointee")
            return
        }
        let ff_si1 = st_find(ff_inner_hash)
        if ff_si1 < 0 {
            tc_error(ff_field1_tok, "unknown field access")
            return
        }
        if st_private_access_denied(ff_si1, ff_field1_tok) {
            tc_error_hard(ff_field1_tok, "private struct field access")
            return
        }
        ST_QUERY_NS = TS[ff_field1_tok as usize]
        ST_QUERY_NE = TE[ff_field1_tok as usize]
        let ff_foff1 = st_field_offset(ff_si1, ff_h1)
        let ff_fty1 = st_field_ty(ff_si1, ff_h1)
        let ff_fhash1 = st_field_hash(ff_si1, ff_h1)
        ST_QUERY_NS = -1
        ST_QUERY_NE = -1
        if ff_foff1 < 0 {
            tc_error(ff_field1_tok, "unknown field access")
            return
        }
        if ff_fty1 != 6 {
            tc_error(ff_field2_tok, "field access through pointer/ref requires struct pointee")
            return
        }
        let ff_si2 = st_find(ff_fhash1)
        if ff_si2 < 0 {
            tc_error(ff_field2_tok, "unknown field access")
            return
        }
        if st_private_access_denied(ff_si2, ff_field2_tok) {
            tc_error_hard(ff_field2_tok, "private struct field access")
            return
        }
        ST_QUERY_NS = TS[ff_field2_tok as usize]
        ST_QUERY_NE = TE[ff_field2_tok as usize]
        let ff_foff2 = st_field_offset(ff_si2, ff_h2)
        let ff_fty2 = st_field_ty(ff_si2, ff_h2)
        let ff_fhash2 = st_field_hash(ff_si2, ff_h2)
        ST_QUERY_NS = -1
        ST_QUERY_NE = -1
        if ff_foff2 < 0 {
            tc_error(ff_field2_tok, "unknown field access")
            return
        }
        if ty_eq(ff_fty2, ff_fhash2, ff_rhs_ty, ff_rhs_hash) == false {
            tc_error(EP - 1, "assignment type mismatch")
        } else {
            emit_store_to_pointer_offset_a64(ff_lslot, ff_foff1 + ff_foff2, ff_fty2, ff_fhash2)
        }
        return
    }
    // (*name).field1.field2[idx] = expr — two-level nested ARRAY-field store through a
    // *mut/ref. a64 mirror of compile_deref_field_field_array_store_x86. WITHOUT this,
    // `(*c).env.bindings[idx] = TypeBinding{…}` fell to the generic path and wrote nowhere,
    // so bound builtins were lost. Base = ptr + off(field1) + off(field2); element by idx.
    if stmt_is_deref_field_field_array_store(EP) {
        let fa_name_tok = EP + 2
        let fa_ns = TS[fa_name_tok as usize]
        let fa_ne = TE[fa_name_tok as usize]
        let fa_field1_tok = EP + 5
        let fa_field2_tok = EP + 7
        let fa_h1 = gl_name_hash(TS[fa_field1_tok as usize], TE[fa_field1_tok as usize])
        let fa_h2 = gl_name_hash(TS[fa_field2_tok as usize], TE[fa_field2_tok as usize])
        if current_fn_allows_mutation() == false {
            tc_effect_violation(fa_field2_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        EP = EP + 9
        compile_or_a64()
        if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
        if TK[EP as usize] == 42 { EP = EP + 1 }
        if TK[EP as usize] == 16 { EP = EP + 1 }
        emit_push_a64()
        compile_or_a64()
        let fa_rhs_ty = EXPR_TY
        let fa_rhs_hash = EXPR_TY_HASH
        let fa_lslot = var_find(fa_ns, fa_ne)
        let fa_lvi = var_find_idx(fa_ns, fa_ne)
        if fa_lslot < 0 || fa_lvi < 0 || type_is_pointer_like(VAR_TY[fa_lvi as usize], VAR_TY_HASH[fa_lvi as usize]) == false {
            tc_error(fa_field1_tok, "field access through deref requires ref or pointer binding")
            emit_pop_x1_a64()
            return
        }
        let fa_inner_ty = ptr_hash_inner_ty(VAR_TY_HASH[fa_lvi as usize])
        let fa_inner_hash = ptr_hash_inner_hash(VAR_TY_HASH[fa_lvi as usize])
        if fa_inner_ty != 6 {
            tc_error(fa_field1_tok, "field access through pointer/ref requires struct pointee")
            emit_pop_x1_a64()
            return
        }
        let fa_si1 = st_find(fa_inner_hash)
        if fa_si1 < 0 {
            tc_error(fa_field1_tok, "unknown field access")
            emit_pop_x1_a64()
            return
        }
        if st_private_access_denied(fa_si1, fa_field1_tok) {
            tc_error_hard(fa_field1_tok, "private struct field access")
            emit_pop_x1_a64()
            return
        }
        ST_QUERY_NS = TS[fa_field1_tok as usize]
        ST_QUERY_NE = TE[fa_field1_tok as usize]
        let fa_foff1 = st_field_offset(fa_si1, fa_h1)
        let fa_fty1 = st_field_ty(fa_si1, fa_h1)
        let fa_fhash1 = st_field_hash(fa_si1, fa_h1)
        ST_QUERY_NS = -1
        ST_QUERY_NE = -1
        if fa_foff1 < 0 || fa_fty1 != 6 {
            tc_error(fa_field2_tok, "field access through pointer/ref requires struct pointee")
            emit_pop_x1_a64()
            return
        }
        let fa_si2 = st_find(fa_fhash1)
        if fa_si2 < 0 {
            tc_error(fa_field2_tok, "unknown field access")
            emit_pop_x1_a64()
            return
        }
        if st_private_access_denied(fa_si2, fa_field2_tok) {
            tc_error_hard(fa_field2_tok, "private struct field access")
            emit_pop_x1_a64()
            return
        }
        ST_QUERY_NS = TS[fa_field2_tok as usize]
        ST_QUERY_NE = TE[fa_field2_tok as usize]
        let fa_foff2 = st_field_offset(fa_si2, fa_h2)
        let fa_fty2 = st_field_ty(fa_si2, fa_h2)
        let fa_fhash2 = st_field_hash(fa_si2, fa_h2)
        ST_QUERY_NS = -1
        ST_QUERY_NE = -1
        if fa_fty2 != 8 {
            tc_error(fa_field2_tok, "indexed field store requires array field")
            emit_pop_x1_a64()
            return
        }
        if ty_eq(arr_hash_elem_ty(fa_fhash2), arr_hash_elem_hash(fa_fhash2), fa_rhs_ty, fa_rhs_hash) == false {
            tc_error(EP - 1, "assignment type mismatch")
        }
        materialize_aggregate_array_element_a64(fa_fhash2)
        em32(0xAA0003EA)  // mov x10, x0 (value)
        emit_pop_x1_a64()  // x1 = index
        emit_load_var_a64(fa_lslot)  // x0 = base pointer
        let fa_total_off = fa_foff1 + fa_foff2
        if fa_total_off != 0 {
            emit_imm64_reg_a64(11, fa_total_off)
            em32(0x8B0B0000)  // add x0, x0, x11
        }
        if arr_hash_esiz(fa_fhash2) == 8 { em32(0xF821780A) }
        else { em32(0x3821680A) }
        return
    }
    // (*PTR).field = expr
    if stmt_is_deref_field_store(EP) {
        let name_tok = EP + 2
        let field_tok = EP + 5
        if current_fn_allows_mutation() == false {
            tc_effect_violation(field_tok, 2, FN_EFFECTS[CURRENT_FN as usize])
        }
        let ns = TS[name_tok as usize]
        let ne = TE[name_tok as usize]
        let fh = gl_name_hash(TS[field_tok as usize], TE[field_tok as usize])
        EP = EP + 7
        compile_or_a64()
        let rhs_ty = EXPR_TY
        let rhs_ty_hash = EXPR_TY_HASH
        let lslot = var_find(ns, ne)
        if lslot >= 0 {
            let lvi = var_find_idx(ns, ne)
            // Accept both raw pointers (ty==11) and exclusive references (ty==10, &!T)
            let lty = VAR_TY[lvi as usize]
            if lvi >= 0 && (lty == 11 || lty == 10) {
                let inner_ty = ptr_hash_inner_ty(VAR_TY_HASH[lvi as usize])
                let inner_hash = ptr_hash_inner_hash(VAR_TY_HASH[lvi as usize])
                if inner_ty != 6 {
                    tc_error(field_tok, "field access through pointer/ref requires struct pointee")
                } else {
                    let si = st_find(inner_hash)
                    if si < 0 {
                        tc_error(field_tok, "unknown field access")
                    } else if st_private_access_denied(si, field_tok) {
                        tc_error_hard(field_tok, "private struct field access")
                    } else {
                    ST_QUERY_NS = TS[field_tok as usize]
                    ST_QUERY_NE = TE[field_tok as usize]
                        let foff = st_field_offset(si, fh)
                        let fty = st_field_ty(si, fh)
                        let fhash = st_field_hash(si, fh)
                    ST_QUERY_NS = -1
                    ST_QUERY_NE = -1
                        if foff < 0 {
                            tc_error(field_tok, "unknown field access")
                        } else if ty_eq(fty, fhash, rhs_ty, rhs_ty_hash) == false {
                            tc_error(EP - 1, "assignment type mismatch")
                        } else {
                            emit_store_to_pointer_offset_a64(lslot, foff, fty, fhash)
                        }
                    }
                }
            } else {
                tc_error(field_tok, "field access through deref requires ref or pointer binding")
            }
        } else {
            tc_undefined_var(name_tok)
        }
        return
    }
    // return
    if k == 2 {
        EP = EP + 1
        if TK[EP as usize] != 9 {
            compile_or_a64()
        } else {
            em32(0xD2800000)
            EXPR_TY = 5
            EXPR_TY_HASH = 0
        }
        if ty_eq(CURRENT_RET_TY, CURRENT_RET_HASH, EXPR_TY, EXPR_TY_HASH) == false {
            if (ty_is_numeric(CURRENT_RET_TY) && ty_is_numeric(EXPR_TY)) == false {
                if (CURRENT_RET_TY != 0 || CURRENT_RET_HASH != 0) && (EXPR_TY != 0 || EXPR_TY_HASH != 0) {
                    if type_has_knowledge(CURRENT_RET_TY, CURRENT_RET_HASH) || type_has_knowledge(EXPR_TY, EXPR_TY_HASH) {
                        tc_epistemic_boundary(EP)
                    } else {
                        tc_error(EP - 1, "return type does not match function signature")
                    }
                }
            }
        }
        // PR-5: enforce refinement predicate on return value (a64 mirror)
        try_apply_return_refinement(EP - 1)
        if CURRENT_SRET_SLOT > 0 || type_is_aggregate(CURRENT_RET_TY, CURRENT_RET_HASH) || type_is_aggregate(EXPR_TY, EXPR_TY_HASH) {
            stabilize_return_agg_a64(EXPR_TY, EXPR_TY_HASH)
        }
        // β⁵: store return variance to global BSS for inter-procedural propagation
        if EXPR_IS_F64 == 1 {
            emit_push_a64()  // str x0, [sp, #-16]! (save return value)
            if EXPR_VSHADOW >= 0 {
                emit_load_var_a64(EXPR_VSHADOW)
            } else {
                emit_imm64_a64(0)
            }
            // x0 = variance value
            em32(0xAA0003EA)  // mov x10, x0
            emit_image_addr_reg_a64(11, GL_BSS_BASE + B5_RET_VSHADOW_BSS_OFF)
            em32(0xF900016A)  // str x10, [x11]
            emit_pop_x0_a64()  // ldr x0, [sp], #16 (restore return value)
        }
        // Restore sp from the frame pointer so any transient expression-stack
        // imbalance cannot make the epilogue pop x29/x30 from the wrong address.
        em32(0x910003BF)  // mov sp, x29
        em32(0xA8C17BFD)
        em32(0xD65F03C0)
        return
    }
    // continue
    if k == 33 {
        if LOOP_DEPTH <= 0 {
            tc_error(EP, "continue outside loop")
            EP = EP + 1
            return
        }
        EP = EP + 1
        if LOOP_DEPTH > 0 {
            let rel = (LOOP_TOP[(LOOP_DEPTH - 1) as usize] - CL) / 4
            em32(0x14000000 | (rel & 0x3FFFFFF))
        }
        return
    }
    // break
    if k == 34 {
        if LOOP_DEPTH <= 0 {
            tc_error(EP, "break outside loop")
            EP = EP + 1
            return
        }
        EP = EP + 1
        BREAK_PATCH[BREAK_COUNT as usize] = CL
        BREAK_COUNT = BREAK_COUNT + 1
        em32(0x14000000)
        return
    }
    // if/else  (with Phase 1.3 if-let support)
    if k == 13 {
        EP = EP + 1

        // ── Phase 1.3: if let <pattern> = <expr> { ... } (AArch64) ──
        if TK[EP as usize] == 11 {
            EP = EP + 1
            let pat_tk = TK[EP as usize]
            var il_disc: i64 = -1
            var il_is_tagged: i64 = 0
            var il_is_wildcard: i64 = 0
            var il_is_enum_variant: i64 = 0
            var il_bind_ns: i64 = 0
            var il_bind_ne: i64 = 0
            var il_has_binding: i64 = 0
            if pat_tk == 57 {
                EP = EP + 1; il_disc = 1; il_is_tagged = 1
                if TK[EP as usize] == 6 {
                    EP = EP + 1
                    il_bind_ns = TS[EP as usize]; il_bind_ne = TE[EP as usize]
                    il_has_binding = 1; EP = EP + 1
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                }
            }
            if pat_tk == 58 { EP = EP + 1; il_disc = 0; il_is_tagged = 1 }
            if pat_tk == 59 {
                EP = EP + 1; il_disc = 0; il_is_tagged = 1
                if TK[EP as usize] == 6 {
                    EP = EP + 1
                    il_bind_ns = TS[EP as usize]; il_bind_ne = TE[EP as usize]
                    il_has_binding = 1; EP = EP + 1
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                }
            }
            if pat_tk == 60 {
                EP = EP + 1; il_disc = 1; il_is_tagged = 1
                if TK[EP as usize] == 6 {
                    EP = EP + 1
                    il_bind_ns = TS[EP as usize]; il_bind_ne = TE[EP as usize]
                    il_has_binding = 1; EP = EP + 1
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                }
            }
            if pat_tk == 3 {
                let pns = TS[EP as usize]; let pne = TE[EP as usize]
                if pne - pns == 1 && sb(pns) == 95 {
                    il_is_wildcard = 1; EP = EP + 1
                } else if TK[(EP + 1) as usize] == 51 {
                    let eh = gl_name_hash(pns, pne)
                    EP = EP + 2
                    let vh = gl_name_hash(TS[EP as usize], TE[EP as usize])
                    EP = EP + 1
                    il_disc = en_variant_value(eh, vh)
                    il_is_enum_variant = 1
                    if TK[EP as usize] == 6 {
                        EP = EP + 1
                        il_bind_ns = TS[EP as usize]; il_bind_ne = TE[EP as usize]
                        il_has_binding = 1; EP = EP + 1
                        if TK[EP as usize] == 7 { EP = EP + 1 }
                    }
                } else { il_is_wildcard = 1; EP = EP + 1 }
            }
            if TK[EP as usize] == 16 { EP = EP + 1 }
            compile_or_a64()
            MATCH_SCRUT_TY   = EXPR_TY
            MATCH_SCRUT_HASH = EXPR_TY_HASH
            let il_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
            emit_store_var_a64(il_slot)
            var il_cbz_off: i64 = 0
            if il_is_wildcard == 0 {
                if il_is_tagged == 1 || il_is_enum_variant == 1 {
                    // A64: ldr x0, [x0]; cmp x0, disc; b.ne fail
                    emit_load_var_a64(il_slot)
                    em32(0xF9400000)   // ldr x0, [x0]  (load tag at offset 0)
                    // mov x1, disc
                    em32(0xD2800001 | ((il_disc & 0xFFFF) << 5))
                    em32(0xEB010000)   // subs x0, x0, x1 (cmp)
                    il_cbz_off = CL
                    em32(0x54000001)   // b.ne placeholder
                    if il_has_binding == 1 {
                        emit_load_var_a64(il_slot)
                        em32(0xF9400400)   // ldr x0, [x0, #8]
                        let bslot = var_add(il_bind_ns, il_bind_ne)
                        if bslot >= 0 {
                            emit_store_var_a64(bslot)
                            if VAR_COUNT > 0 {
                                let bvi = VAR_COUNT - 1
                                if type_is_option_inline(MATCH_SCRUT_TY, MATCH_SCRUT_HASH) && option_hash_is(MATCH_SCRUT_HASH) {
                                    VAR_TY[bvi as usize] = option_hash_inner_ty(MATCH_SCRUT_HASH)
                                    VAR_TY_HASH[bvi as usize] = option_hash_inner_hash(MATCH_SCRUT_HASH)
                                }
                            }
                        }
                    }
                }
            }
            var il_snap: i64 = 0
            while il_snap < VAR_COUNT {
                CL_SAVE_USED[il_snap as usize] = VAR_USED[il_snap as usize]
                CL_SAVE_MUT[il_snap as usize] = VAR_MOVED[il_snap as usize]
                il_snap = il_snap + 1
            }
            LAST_STMT_HAS_VALUE = 0; LAST_STMT_TY = 0; LAST_STMT_TY_HASH = 0
            if TK[EP as usize] == 8 { EP = EP + 1 }
            while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt_a64() }
            let il_then_has_value = LAST_STMT_HAS_VALUE
            let il_then_ty = LAST_STMT_TY; let il_then_hash = LAST_STMT_TY_HASH
            if TK[EP as usize] == 9 { EP = EP + 1 }
            LAST_STMT_HAS_VALUE = 0; LAST_STMT_TY = 0; LAST_STMT_TY_HASH = 0
            if TK[EP as usize] == 14 {
                EP = EP + 1
                let il_b_end_off = CL; em32(0x14000000)
                if il_cbz_off > 0 { patch_branch_a64(il_cbz_off, CL) }
                var il_lt: i64 = 0
                while il_lt < VAR_COUNT {
                    let tu = VAR_USED[il_lt as usize]; let tm = VAR_MOVED[il_lt as usize]
                    VAR_USED[il_lt as usize] = CL_SAVE_USED[il_lt as usize]
                    VAR_MOVED[il_lt as usize] = CL_SAVE_MUT[il_lt as usize]
                    CL_SAVE_USED[il_lt as usize] = tu; CL_SAVE_MUT[il_lt as usize] = tm
                    il_lt = il_lt + 1
                }
                if TK[EP as usize] == 13 { compile_stmt_a64() }
                else {
                    LAST_STMT_HAS_VALUE = 0; LAST_STMT_TY = 0; LAST_STMT_TY_HASH = 0
                    if TK[EP as usize] == 8 { EP = EP + 1 }
                    while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt_a64() }
                    if TK[EP as usize] == 9 { EP = EP + 1 }
                }
                let il_else_has_value = LAST_STMT_HAS_VALUE
                let il_else_ty = LAST_STMT_TY; let il_else_hash = LAST_STMT_TY_HASH
                patch_branch_a64(il_b_end_off, CL)
                if il_then_has_value == 1 && il_else_has_value == 1 && il_then_ty != 5 && il_else_ty != 5 {
                    LAST_STMT_HAS_VALUE = 1; LAST_STMT_TY = il_then_ty; LAST_STMT_TY_HASH = il_then_hash
                    EXPR_TY = il_then_ty; EXPR_TY_HASH = il_then_hash
                }
            } else {
                if il_cbz_off > 0 { patch_branch_a64(il_cbz_off, CL) }
                // FALL-THROUGH FIX (a64): nop at if-let no-else merge so a `ret`-ending then-branch
                // does not make the implicit-return guard skip the epilogue on the no-match path.
                em32(0xD503201F)  // nop
                LAST_STMT_HAS_VALUE = 0; LAST_STMT_TY = 0; LAST_STMT_TY_HASH = 0
            }
            return
        }
        // ── end if let (AArch64) ──

        compile_or_a64()
        // β⁹ GTT week-6 stage-2: capture cond's channel-set topology
        // (mirror of x86 compile_stmt).
        let if_cond_ch_set_a = EXPR_CH_SET
        if EXPR_TY != 0 && EXPR_TY != 4 { tc_error(EP - 1, "if condition must be bool") }
        let cbz_off = CL
        em32(0xB4000000)
        LAST_STMT_HAS_VALUE = 0
        LAST_STMT_TY = 0
        LAST_STMT_TY_HASH = 0
        if TK[EP as usize] == 8 { EP = EP + 1 }
        while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt_a64() }
        // β⁹ GTT week-6 stage-2: capture then-body's tail channel-set topology.
        let if_then_ch_set_a = EXPR_CH_SET
        let then_has_value = LAST_STMT_HAS_VALUE
        let then_ty = LAST_STMT_TY
        let then_hash = LAST_STMT_TY_HASH
        if TK[EP as usize] == 9 { EP = EP + 1 }
        LAST_STMT_HAS_VALUE = 0
        LAST_STMT_TY = 0
        LAST_STMT_TY_HASH = 0
        if TK[EP as usize] == 14 {
            EP = EP + 1
            let b_end_off = CL
            em32(0x14000000)
            patch_branch_a64(cbz_off, CL)
            if TK[EP as usize] == 13 { compile_stmt_a64() }
            else {
                LAST_STMT_HAS_VALUE = 0
                LAST_STMT_TY = 0
                LAST_STMT_TY_HASH = 0
                if TK[EP as usize] == 8 { EP = EP + 1 }
                while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt_a64() }
                if TK[EP as usize] == 9 { EP = EP + 1 }
            }
            // β⁹ GTT week-6 stage-2: capture else-body's tail channel-set topology.
            let if_else_ch_set_a = EXPR_CH_SET
            let else_has_value = LAST_STMT_HAS_VALUE
            let else_ty = LAST_STMT_TY
            let else_hash = LAST_STMT_TY_HASH
            patch_branch_a64(b_end_off, CL)
            if then_has_value == 1 && else_has_value == 1 && then_ty != 5 && else_ty != 5 {
                if ty_eq(then_ty, then_hash, else_ty, else_hash) == false {
                    tc_error(EP - 1, "if arm type does not match else arm")
                }
                LAST_STMT_HAS_VALUE = 1
                LAST_STMT_TY = then_ty
                LAST_STMT_TY_HASH = then_hash
                EXPR_TY = then_ty
                EXPR_TY_HASH = then_hash
                if then_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                // β⁹ GTT week-6 stage-2: union all three arm topologies — mirror
                // of x86 compile_stmt.  Matches `Typing.tIf`'s conclusion
                // `Sc ∪ (S1 ∪ S2)` in formal/GradientTopology.lean §3.
                EXPR_CH_SET = if_cond_ch_set_a | if_then_ch_set_a | if_else_ch_set_a
            } else {
                LAST_STMT_HAS_VALUE = 0
                LAST_STMT_TY = 0
                LAST_STMT_TY_HASH = 0
            }
