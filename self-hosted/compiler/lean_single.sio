            NEXT_SLOT = NEXT_SLOT + struct_size_a
            let struct_top_a = struct_base_a + struct_size_a - 1
            emit_adr_local_a64(cl_start_a, 0)
            emit_store_var_a64(struct_top_a)
            emit_lea_var_a64(struct_top_a)
        } else {
