        FNSIG_SCRATCH_ARITY = CL_FNSIG_NPARAMS[CL_DEPTH as usize]
        FNSIG_SCRATCH_RET_TY = CL_FNSIG_RET_TY[CL_DEPTH as usize]
        FNSIG_SCRATCH_RET_HASH = CL_FNSIG_RET_HASH[CL_DEPTH as usize]
        FNSIG_SCRATCH_EFF = CL_FNSIG_EFF[CL_DEPTH as usize]
