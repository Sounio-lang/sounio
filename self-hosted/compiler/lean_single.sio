                if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
            } else {
                let fri = fn_find(TS[(EP - 1) as usize], TE[(EP - 1) as usize])
                if fri >= 0 {
                    em32(0x14000002)  // b +8, skipping the wrapper branch
                    let wr_start = CL
                    if FN_OFF[fri as usize] >= 0 {
                        let rel = (FN_OFF[fri as usize] - CL) / 4
                        em32(0x14000000 | (rel & 0x3FFFFFF))
                    } else {
                        PATCH_OFF[PATCH_COUNT as usize] = CL
                        PATCH_FN[PATCH_COUNT as usize] = fri
                        PATCH_KIND[PATCH_COUNT as usize] = 2
                        PATCH_COUNT = PATCH_COUNT + 1
                        em32(0x14000000)
                    }
                    let adr_off = wr_start - CL
                    let adr_immlo = adr_off & 0x3
                    let adr_immhi = (adr_off >> 2) & 0x7FFFF
                    em32(0x10000000 | ((adr_immlo & 0x3) << 29) | ((adr_immhi & 0x7FFFF) << 5) | 0)
                    EXPR_TY = 9
                    EXPR_TY_HASH = FN_SIG[fri as usize]
                    LAST_EXPR_IS_CLOSURE = 0
                }
                else { tc_undefined_var(name_tok); em32(0xD2800000); EXPR_TY = 0; EXPR_TY_HASH = 0 }
            }
            if gi < 0 { EXPR_IS_F64 = 0 }
        }
