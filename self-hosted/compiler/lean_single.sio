    }
    // Dereference *expr
    if k == 19 {
        EP = EP + 1
        compile_primary_a64()
        compile_postfix_tail_a64()
        if EXPR_TY != 0 && type_is_pointer_like(EXPR_TY, EXPR_TY_HASH) == false { tc_error(EP - 1, "dereference requires reference operand") }
        if type_is_pointer_like(EXPR_TY, EXPR_TY_HASH) {
            let deref_ref_hash_a = EXPR_TY_HASH
            let deref_inner_hash_a = ptr_hash_inner_hash(deref_ref_hash_a)
            let deref_inner_ty_a = ptr_hash_inner_ty(deref_ref_hash_a)
            if type_is_aggregate(deref_inner_ty_a, deref_inner_hash_a) == false {
