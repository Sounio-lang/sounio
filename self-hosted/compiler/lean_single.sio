        let base = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + arr_count
        EP = EP + 1
        var idx: i64 = 0
        var elem_ty: i64 = 0
        var elem_hash: i64 = 0
        while ep_before_body_close() && TK[EP as usize] != 42 && TK[EP as usize] != 0 {
            compile_or_a64()
