                    while b9_i < 16 && b9_i < B9_ARG_CH_COUNT {
                        if (b9_used_mask & (1 << b9_i)) != 0 {
                            b9_ch_union = b9_ch_union | B9_ARG_CH_SET[b9_i as usize]
                            b9_pu_union = b9_pu_union | B9_ARG_PARAM_USED[b9_i as usize]
                        }
                        b9_i = b9_i + 1
                    }
                } else {
                    var b9_i: i64 = 0
                    while b9_i < B9_ARG_CH_COUNT {
                        if b9_i < 16 {
                            b9_ch_union = b9_ch_union | B9_ARG_CH_SET[b9_i as usize]
                            b9_pu_union = b9_pu_union | B9_ARG_PARAM_USED[b9_i as usize]
                        }
                        b9_i = b9_i + 1
                    }
                }
                // β⁹ GTT week-8: argc ≥ 16 overflows B9_ARG_CH_SET[16].
                // The capture loop at the call site only stores slots 0..15
                // and the union loop above only walks the same range, so
                // any channel carried by arg 16+ would be silently dropped
                // → under-approximation of EXPR_CH_SET.  Conservatively
                // saturate to all-bits-set so the caller cannot accept a
                // hessian_of(.., j, k) query whose true topology requires
                // a dropped channel.  The body-side overflow handling at
                // the callee entry already widens via VAR_PARAM_USED=0
                // for params ≥ 16 (forces fall-back), but the call site
                // itself had no widening — this closes that hole.
                if argc >= 16 {
                    b9_ch_union = -1
                    b9_pu_union = -1
                }
                EXPR_CH_SET = b9_ch_union
                EXPR_PARAM_USED = b9_pu_union
                // β⁵: read callee return variance from global BSS; fall back to
                // conservative argument-variance sum when exact is 0 (covers
                // callee bodies with unsupported ops like division).
                EXPR_VSHADOW = -1
                if EXPR_IS_F64 == 1 {
                    // Save f64 result (RAX holds bit-cast of return value) to temp slot
                    let b5_res = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
                    emit_store_var(b5_res)
                    // Load exact variance value from global BSS
                    emit_load_abs_qword_to_rax_x86(GL_BSS_BASE + B5_RET_VSHADOW_BSS_OFF)
                    let b5_exact_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
                    emit_store_var(b5_exact_slot)
                    // Compute conservative sum of argument variances
                    var b5_sum_slot: i64 = -1
                    var b5_first: i64 = 1
                    var b5_i: i64 = 0
                    while b5_i < B5_ARG_VCOUNT {
                        let b5_av = B5_VSHADOW[b5_i as usize]
                        if b5_av >= 0 {
                            if b5_first == 1 {
                                b5_sum_slot = b5_av
                                b5_first = 0
                            } else {
                                emit_load_var(b5_sum_slot)
                                emit_push()                              // push rax (sum bits)
                                emit_load_var(b5_av)                    // rax = argᵢ variance bits
                                em(0x59)                                 // pop rcx (sum bits)
                                emit_f64_add_from_rcx_rax_x86()         // rax = f64(rcx)+f64(rax) as bits
                                let b5_new = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
                                emit_store_var(b5_new)
                                b5_sum_slot = b5_new
                            }
                        }
                        b5_i = b5_i + 1
                    }
                    if b5_sum_slot >= 0 {
                        // Emit: if exact != 0, use exact; else use sum
                        emit_load_var(b5_exact_slot)
                        em(0x48); em(0x85); em(0xc0)  // test rax, rax
                        em(0x0f); em(0x85)             // jne use_exact
                        let patch_exact = CL; em32(0)
                        // use_sum:
                        emit_load_var(b5_sum_slot)
                        em(0xe9)                       // jmp done
                        let patch_done = CL; em32(0)
                        // use_exact:
                        let here_exact = CL
                        emit_load_var(b5_exact_slot)
                        // done:
                        let here_done = CL
                        patch32(patch_exact, here_exact)
                        patch32(patch_done, here_done)
                        let b5_vslot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
                        emit_store_var(b5_vslot)
                        EXPR_VSHADOW = b5_vslot
                    } else if b5_exact_slot >= 0 {
                        EXPR_VSHADOW = b5_exact_slot
                    }
                    // Restore f64 result
                    emit_load_var(b5_res)
                }
            } else {
                if call_vslot >= 0 {
                    if call_sig <= 0 {
                        tc_error_hard(call_tok, "value is not callable")
                    }
                    if call_sig > 0 && FNSIG_ARITY[call_sig as usize] != argc { tc_wrong_arity(call_tok, FNSIG_ARITY[call_sig as usize], argc) }
                    if call_is_closure == 1 {
                        emit_setup_closure_call_args_x86(argc)
                        emit_prepare_stack_call_args_x86(argc, 5)
                        emit_load_var(call_vslot)
                        // Tagged pointer dispatch: bit 0=0 → closure struct, bit 0=1 → fn ref thunk
                        em(0x49); em(0x89); em(0xc3)          // mov r11, rax
                        em(0xf6); em(0xc0); em(0x01)          // test al, 1
                        em(0x75)                               // jnz rel8
                        let hof_jnz_patch = CL
                        em(0x00)
                        em(0x4c); em(0x89); em(0xdf)          // struct path: mov rdi, r11
                        em(0x49); em(0x8b); em(0x03)          // mov rax, [r11]
                        em(0xff); em(0xd0)                    // call rax
                        em(0xeb)                               // jmp rel8
                        let hof_jmp_patch = CL
                        em(0x00)
                        CD[hof_jnz_patch as usize] = (CL - hof_jnz_patch - 1) as i8
                        em(0x4c); em(0x89); em(0xd8)          // thunk path: mov rax, r11
                        em(0x48); em(0x83); em(0xe0); em(0xfe) // and rax, -2
                        em(0xff); em(0xd0)                    // call rax
                        CD[hof_jmp_patch as usize] = (CL - hof_jmp_patch - 1) as i8
                        emit_drop_call_args_x86(argc + call_extra_stack_args_x86(argc, 5))
                    } else {
                        emit_indirect_fn_call_x86(call_vslot, abi_argc, FNSIG_RET_TY[call_sig as usize], FNSIG_RET_HASH[call_sig as usize])
                    }
                    if call_sig > 0 {
                        EXPR_TY = FNSIG_RET_TY[call_sig as usize]
                        EXPR_TY_HASH = FNSIG_RET_HASH[call_sig as usize]
                    } else {
                        EXPR_TY = 0
                        EXPR_TY_HASH = 0
                    }
                    if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                    // β⁹ GTT week-9: closure / fn-ref indirect call topology.
                    // Callee body is unknown so body-precision is unavailable;
                    // conservatively union all in-range B9_ARG_CH_SET slots
                    // (matches the week-3 fallback rule for direct calls).
                    // Saturate to all-bits-set when argc ≥ 16 — same overflow
                    // discipline as week-8 stage 2.  Without this, EXPR_CH_SET
                    // / EXPR_PARAM_USED leak the last `compile_or()` arg's
                    // values, which is unsound: a hessian_of(.., j, k) on the
                    // returned value could be accepted when its true topology
                    // requires another arg's channel.
                    var b9c_ch_union: i64 = 0
                    var b9c_pu_union: i64 = 0
                    var b9c_i: i64 = 0
                    while b9c_i < B9_ARG_CH_COUNT && b9c_i < 16 {
                        b9c_ch_union = b9c_ch_union | B9_ARG_CH_SET[b9c_i as usize]
                        b9c_pu_union = b9c_pu_union | B9_ARG_PARAM_USED[b9c_i as usize]
                        b9c_i = b9c_i + 1
                    }
                    if argc >= 16 {
                        b9c_ch_union = -1
                        b9c_pu_union = -1
                    }
                    EXPR_CH_SET = b9c_ch_union
                    EXPR_PARAM_USED = b9c_pu_union
                } else {
                    tc_undefined_var(call_tok)
                    emit_drop_call_args_x86(abi_argc + call_extra_stack_args_x86(abi_argc, 6))
                    em(0x31); em(0xc0)
                    EXPR_IS_F64 = 0
                    EXPR_TY = 0
                    EXPR_TY_HASH = 0
                    EXPR_CH_SET = 0
                    EXPR_PARAM_USED = 0
                }
            }
            return
        }
        if TK[EP as usize] == 8 && src_match(ns, ne - ns, "Knowledge") && st_find(gl_name_hash(ns, ne)) < 0 {
            compile_knowledge_literal_x86()
            return
        }
        // Struct literal: StructName { field: val, ... }
        if TK[EP as usize] == 8 {
            let sh = gl_name_hash(ns, ne)
            let si = st_find(sh)
            if si >= 0 {
                if st_private_access_denied(si, name_tok) {
                    tc_error_hard(name_tok, "private struct literal")
                }
                EP = EP + 1  // skip {
                let total_slots = st_total_size(si) / 8
                let base_slot = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + total_slots
                var seen_field_mask: i64 = 0
                // Parse field: value pairs
                while ep_before_body_close() && TK[EP as usize] != 9 && TK[EP as usize] != 0 {
                    if TK[EP as usize] == 3 {
                        let field_tok = EP
                        let fns = TS[EP as usize]
                        let fne = TE[EP as usize]
                        let fh = gl_name_hash(fns, fne)
                        EP = EP + 1  // skip field name
                        let shorthand_ep = field_tok
                        if TK[EP as usize] == 43 {
                            EP = EP + 1  // skip :
                        } else {
                            EP = shorthand_ep
                        }
                    ST_QUERY_NS = fns
                    ST_QUERY_NE = fne
                        let foff = st_field_offset(si, fh)
                        let fty = st_field_ty(si, fh)
                        let fhash = st_field_hash(si, fh)
                    ST_QUERY_NS = -1
                    ST_QUERY_NE = -1
                        if foff >= 0 {
                            let field_count = ST[(si * 130 + 1) as usize]
                            var seen_i: i64 = 0
                            while seen_i < field_count {
                                if ST[(si * 130 + 2 + seen_i) as usize] == fh {
                                    let decl_fns = ST_FNS[(si * 128 + seen_i) as usize]
                                    let decl_fne = ST_FNE[(si * 128 + seen_i) as usize]
                                    if src_region_eq(fns, fne - fns, decl_fns, decl_fne - decl_fns) {
                                        if seen_i < 62 { seen_field_mask = seen_field_mask | (1 << seen_i) }
                                        seen_i = field_count
                                    }
                                }
                                seen_i = seen_i + 1
                            }
                            let dst_start = base_slot + total_slots - 1 - foff / 8
                            if fty == 8 && TK[EP as usize] == 41 && array_init_is_repeat(EP) {
                                EP = EP + 1
                                compile_or()
                                if ty_eq(arr_hash_elem_ty(fhash), arr_hash_elem_hash(fhash), EXPR_TY, EXPR_TY_HASH) == false {
                                    tc_error(field_tok, "array repeat element type does not match field type")
                                }
                                if TK[EP as usize] == 27 { EP = EP + 1 }
                                let rep_count = TV[EP as usize]
                                EP = EP + 1
                                if TK[EP as usize] == 42 { EP = EP + 1 }
                                if rep_count != arr_hash_alen(fhash) {
                                    tc_error(field_tok, "array repeat length does not match field type")
                                }
                                fill_repeat_struct_array_slots_x86(dst_start, fhash)
                            } else {
                                compile_or()
                                try_apply_field_alias_refinement(fhash, field_tok)
                                if fty != 0 && ty_eq(fty, fhash, EXPR_TY, EXPR_TY_HASH) == false {
                                    tc_error_hard(field_tok, "field initializer type does not match struct field")
                                }
                                // β¹⁰: Knowledge<T> fields have fty==0; enforce type match separately
                                if fty == 0 && knowledge_hash_is(fhash) && ty_eq(0, fhash, EXPR_TY, EXPR_TY_HASH) == false {
                                    tc_linear_violation(field_tok, "field initializer type does not match Knowledge field type")
                                }
                                copy_agg_into_struct_slots_x86(dst_start, fty, fhash)
                            }
                        } else {
                            tc_error_hard(field_tok, "unknown field in struct literal")
                            compile_or()  // advance EP past the value to avoid infinite loop
                        }
                    } else {
                        // Non-identifier token in struct literal body — skip to prevent infinite loop
                        EP = EP + 1
                    }
                    if TK[EP as usize] == 28 { EP = EP + 1 }  // skip comma
                }
                let required_fields = ST[(si * 130 + 1) as usize]
                var miss_i: i64 = 0
                while miss_i < required_fields {
                    if miss_i < 62 && (seen_field_mask & (1 << miss_i)) == 0 {
                        tc_error_hard(EP - 1, "missing field in struct literal")
                        miss_i = required_fields
                    } else {
                        miss_i = miss_i + 1
                    }
                }
                if TK[EP as usize] == 9 { EP = EP + 1 }  // skip }
                // lea rax, [rbp - (base_slot+total_slots-1)*8] — pointer to struct data (lowest addr)
                em(0x48); em(0x8d); em(0x85)
                em32(0 - (base_slot + total_slots - 1) * 8)
                EXPR_IS_F64 = 0
                // Convert Knowledge struct literal to epistemic Knowledge type
                if sh == knowledge_struct_hash() {
                    EXPR_TY = 0
                    EXPR_TY_HASH = knowledge_hash_make(ST_FTY[(si * 128) as usize], ST_FHASH[(si * 128) as usize], -2)
                } else {
                    EXPR_TY = 6
                    EXPR_TY_HASH = sh
                }
                // Track if this struct is linear/affine
                LAST_EXPR_IS_LINEAR = ST_LINEAR[si as usize]
                LAST_EXPR_IS_AFFINE = ST_AFFINE[si as usize]
                return
            }
        }
        // Array subscript: IDENT[expr]
        if TK[EP as usize] == 41 {
            EP = EP + 1  // skip [
            compile_or()  // index in rax
            if EXPR_TY != 0 && EXPR_TY != 1 {
                tc_error_hard(EP - 1, "array index must be integer")
            }
            if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }  // skip 'as usize'
            if TK[EP as usize] == 42 { EP = EP + 1 }  // skip ]
            // Seq<T> subscript read: seq[i] is sugar for seq.get(i) (local receiver).
            let seq_vi = var_find_idx(ns, ne)
            if seq_vi >= 0 && VAR_TY[seq_vi as usize] == 12 {
                let seq_sh = VAR_TY_HASH[seq_vi as usize]
                let seq_islot = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var(seq_islot)         // index (rax) → slot
                let seq_pslot = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                emit_load_var(var_find(ns, ne))   // seq ptr → rax
                emit_store_var(seq_pslot)
                emit_seq_get_slots_x86(seq_pslot, seq_islot)
                EXPR_IS_F64 = 0
                if seq_hash_is(seq_sh) {
                    EXPR_TY = seq_hash_inner_ty(seq_sh)
                    EXPR_TY_HASH = seq_hash_inner_hash(seq_sh)
                } else {
                    EXPR_TY = 1
                    EXPR_TY_HASH = 0
                }
                return
            }
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                let base = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                let esz = GL[(gi * 4 + 2) as usize]
                var elem_ty = arr_hash_elem_ty(GL_TY_HASH[gi as usize])
                let elem_hash = arr_hash_elem_hash(GL_TY_HASH[gi as usize])
                if esz == 8 {
                    // mov rcx, rax; mov rax, base; mov rax, [rax + rcx*8]
                    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (index)
                    em(0x48); em(0xb8); em64(base)  // mov rax, base
                    em(0x48); em(0x8b); em(0x04); em(0xc8)  // mov rax, [rax + rcx*8]
                    EXPR_TY = elem_ty
                    EXPR_TY_HASH = elem_hash
                    if elem_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                } else if esz > 8 {
                    // Struct-element array: rax = base + idx * esiz (pointer to element).
                    // esiz > 8 means the element is a multi-slot struct (e.g. [Token; N]).
                    // Caller's SRET copy (stabilize_return_agg_x86) reads from this pointer.
                    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (save index)
                    em(0x48); em(0xb8); em64(base)  // mov rax, base
                    em(0x48); em(0x69); em(0xc9); em32(esz)  // imul rcx, rcx, esiz
                    em(0x48); em(0x01); em(0xc8)  // add rax, rcx
                    EXPR_TY = elem_ty
                    EXPR_TY_HASH = elem_hash
                    EXPR_IS_F64 = 0
                } else {
                    // i8 array: movsx rax, byte [rax + rcx]
                    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax
                    em(0x48); em(0xb8); em64(base)  // mov rax, base
                    em(0x48); em(0x0f); em(0xbe); em(0x04); em(0x08)  // movsx rax, byte [rax + rcx]
                    EXPR_TY = 1
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 0
                }
            } else {
                // Local pointer subscript: ptr[idx] → load ptr from stack, add index
                let slot = var_find(ns, ne)
                if slot >= 0 {
                    let lalen = var_find_alen(ns, ne)
                    let lesiz = var_find_esiz(ns, ne)
                    let lvi = var_find_idx(ns, ne)
                    var elem_ty = 1
                    var elem_hash: i64 = 0
                    var is_arr_ty = 0
                    var is_slice_ty = 0
                    if lvi >= 0 {
                        elem_ty = arr_hash_elem_ty(VAR_TY_HASH[lvi as usize])
                        elem_hash = arr_hash_elem_hash(VAR_TY_HASH[lvi as usize])
                        if VAR_TY[lvi as usize] == 8 { is_arr_ty = 1 }
                        // &! [T; N] reference param: VAR_TY==10, inner type is array (ty==8)
                        if VAR_TY[lvi as usize] == 10 {
                            if ref_hash_inner_ty(VAR_TY_HASH[lvi as usize]) == 8 {
                                is_arr_ty = 1
                                if type_is_slice_ref(VAR_TY[lvi as usize], VAR_TY_HASH[lvi as usize]) { is_slice_ty = 1 }
                                if arr_hash_elem_ty(ref_hash_inner_hash(VAR_TY_HASH[lvi as usize])) != 0 {
                                    elem_ty = arr_hash_elem_ty(ref_hash_inner_hash(VAR_TY_HASH[lvi as usize]))
                                }
                                elem_hash = arr_hash_elem_hash(ref_hash_inner_hash(VAR_TY_HASH[lvi as usize]))
                            }
                        }
                    }
                    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (index)
                    if is_slice_ty == 1 {
                        emit_load_var(VAR_LEN_SLOT[lvi as usize])
                        em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
                        em(0x0f); em(0x82); let slice_ok_local = CL; em32(0)
                        emit_assert_fail()
                        let slice_ok_local_target = CL
                        patch32(slice_ok_local, slice_ok_local_target)
                    }
                    emit_load_var(slot)  // load ptr into rax
                    if is_arr_ty == 1 && lesiz == 8 {
                        em(0x48); em(0x8b); em(0x04); em(0xc8)  // mov rax, [rax + rcx*8]
                        EXPR_TY = elem_ty
                        EXPR_TY_HASH = elem_hash
                        if elem_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                    } else if is_arr_ty == 1 && lesiz == 1 {
                        em(0x48); em(0x0f); em(0xbe); em(0x04); em(0x08)  // movsx rax, byte [rax + rcx]
                        EXPR_TY = 1
                        EXPR_TY_HASH = 0
                        EXPR_IS_F64 = 0
                    } else {
                        // Non-array local pointer (e.g. read_file result): byte access
                        if lvi >= 0 && VAR_TY[lvi as usize] != 0 && VAR_TY[lvi as usize] != 3 {
                            tc_error_hard(name_tok, "value is not indexable")
                        }
                        em(0x48); em(0x0f); em(0xbe); em(0x04); em(0x08)  // movsx rax, byte [rax + rcx]
                        EXPR_TY = 1
                        EXPR_TY_HASH = 0
                        EXPR_IS_F64 = 0
                    }
                } else {
                    tc_undefined_var(name_tok)
                    em(0x31); em(0xc0)
                    EXPR_TY = 0
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 0
                }
            }
            return
        }
        // Variable load (local first, then global)
        let slot = var_find(ns, ne)
        if slot >= 0 {
            let vi = var_find_idx(ns, ne)
            if vi >= 0 && type_is_slice_ref(VAR_TY[vi as usize], VAR_TY_HASH[vi as usize]) {
                emit_lea_var(slot)
            } else if vi >= 0 && type_is_option_inline(VAR_TY[vi as usize], VAR_TY_HASH[vi as usize]) && VAR_ESIZ[vi as usize] >= 16 {
                emit_lea_var(slot)
            } else {
                emit_load_var(slot)
            }
            EXPR_IS_F64 = var_find_is_f64(ns, ne)
            if vi >= 0 {
                EXPR_TY = VAR_TY[vi as usize]
                EXPR_TY_HASH = VAR_TY_HASH[vi as usize]
                if VAR_ALEN[vi as usize] > 0 { LAST_ALEN = VAR_ALEN[vi as usize] }
                if VAR_IS_CLOSURE[vi as usize] == 1 { LAST_EXPR_IS_CLOSURE = 1 }
                // PR-4: propagate tracked literal value so cross-binding refinement
                // checks fire on `let x = -5; takes_pos(x)`.
                if VAR_LIT_DATA[(vi * 2 + 0) as usize] == 1 {
                    LAST_IS_LITERAL = 1
                    LAST_LITERAL_VAL = VAR_LIT_DATA[(vi * 2 + 1) as usize]
                }
            }
            // Use-after-move check: only for linear/affine struct variables
            if vi >= 0 && VAR_MOVED[vi as usize] == 1 && (VAR_LINEAR[vi as usize] == 1 || VAR_AFFINE[vi as usize] == 1) {
                if VAR_LINEAR[vi as usize] == 1 {
                    tc_linear_violation(EP - 1, "use of moved value")
                } else {
                    tc_linear_violation(EP - 1, "use of moved value")
                }
            }
            // Track variable index for move marking (structs), covariance cache (Knowledge<T>), and Seq push receiver (TY_SEQ=12)
            if vi >= 0 && (VAR_TY[vi as usize] == 6 || VAR_TY[vi as usize] == 12 || knowledge_hash_is(VAR_TY_HASH[vi as usize])) { LAST_EXPR_VAR_IDX = vi }
            // β⁴: propagate variance/sensitivity shadow slot for this variable
            if vi >= 0 {
                EXPR_VSHADOW = VAR_VSHADOW[vi as usize]
                EXPR_SSHADOW = VAR_SSHADOW[vi as usize]
                EXPR_SSHADOW_1 = VAR_SSHADOW_1[vi as usize]
                EXPR_SSHADOW_2 = VAR_SSHADOW_2[vi as usize]
                EXPR_SSHADOW_3 = VAR_SSHADOW_3[vi as usize]
                EXPR_SSHADOW_4 = VAR_SSHADOW_4[vi as usize]
                EXPR_SSHADOW_5 = VAR_SSHADOW_5[vi as usize]
                EXPR_SSHADOW_6 = VAR_SSHADOW_6[vi as usize]
                EXPR_SSHADOW_7 = VAR_SSHADOW_7[vi as usize]
                EXPR_HSHADOW_00 = VAR_HSHADOW_00[vi as usize]
                EXPR_HSHADOW_01 = VAR_HSHADOW_01[vi as usize]
                EXPR_HSHADOW_02 = VAR_HSHADOW_02[vi as usize]
                EXPR_HSHADOW_03 = VAR_HSHADOW_03[vi as usize]
                EXPR_HSHADOW_11 = VAR_HSHADOW_11[vi as usize]
                EXPR_HSHADOW_12 = VAR_HSHADOW_12[vi as usize]
                EXPR_HSHADOW_13 = VAR_HSHADOW_13[vi as usize]
                EXPR_HSHADOW_22 = VAR_HSHADOW_22[vi as usize]
                EXPR_HSHADOW_23 = VAR_HSHADOW_23[vi as usize]
                EXPR_HSHADOW_33 = VAR_HSHADOW_33[vi as usize]
                EXPR_HSHADOW_04 = VAR_HSHADOW_04[vi as usize]
                EXPR_HSHADOW_05 = VAR_HSHADOW_05[vi as usize]
                EXPR_HSHADOW_06 = VAR_HSHADOW_06[vi as usize]
                EXPR_HSHADOW_07 = VAR_HSHADOW_07[vi as usize]
                EXPR_HSHADOW_14 = VAR_HSHADOW_14[vi as usize]
                EXPR_HSHADOW_15 = VAR_HSHADOW_15[vi as usize]
                EXPR_HSHADOW_16 = VAR_HSHADOW_16[vi as usize]
                EXPR_HSHADOW_17 = VAR_HSHADOW_17[vi as usize]
                EXPR_HSHADOW_24 = VAR_HSHADOW_24[vi as usize]
                EXPR_HSHADOW_25 = VAR_HSHADOW_25[vi as usize]
                EXPR_HSHADOW_26 = VAR_HSHADOW_26[vi as usize]
                EXPR_HSHADOW_27 = VAR_HSHADOW_27[vi as usize]
                EXPR_HSHADOW_34 = VAR_HSHADOW_34[vi as usize]
                EXPR_HSHADOW_35 = VAR_HSHADOW_35[vi as usize]
                EXPR_HSHADOW_36 = VAR_HSHADOW_36[vi as usize]
                EXPR_HSHADOW_37 = VAR_HSHADOW_37[vi as usize]
                EXPR_HSHADOW_44 = VAR_HSHADOW_44[vi as usize]
                EXPR_HSHADOW_45 = VAR_HSHADOW_45[vi as usize]
                EXPR_HSHADOW_46 = VAR_HSHADOW_46[vi as usize]
                EXPR_HSHADOW_47 = VAR_HSHADOW_47[vi as usize]
                EXPR_HSHADOW_55 = VAR_HSHADOW_55[vi as usize]
                EXPR_HSHADOW_56 = VAR_HSHADOW_56[vi as usize]
                EXPR_HSHADOW_57 = VAR_HSHADOW_57[vi as usize]
                EXPR_HSHADOW_66 = VAR_HSHADOW_66[vi as usize]
                EXPR_HSHADOW_67 = VAR_HSHADOW_67[vi as usize]
                EXPR_HSHADOW_77 = VAR_HSHADOW_77[vi as usize]
                // β⁹ GTT: restore the variable's channel topology on load.
                EXPR_CH_SET = VAR_CH_SET[vi as usize]
                EXPR_PARAM_USED = VAR_PARAM_USED[vi as usize]
            } else {
                EXPR_VSHADOW = -1
                EXPR_SSHADOW = -1
                EXPR_SSHADOW_1 = -1; EXPR_SSHADOW_2 = -1; EXPR_SSHADOW_3 = -1; EXPR_SSHADOW_4 = -1; EXPR_SSHADOW_5 = -1; EXPR_SSHADOW_6 = -1; EXPR_SSHADOW_7 = -1
                EXPR_HSHADOW_00 = -1; EXPR_HSHADOW_01 = -1; EXPR_HSHADOW_02 = -1; EXPR_HSHADOW_03 = -1
                EXPR_HSHADOW_11 = -1; EXPR_HSHADOW_12 = -1; EXPR_HSHADOW_13 = -1
                EXPR_HSHADOW_22 = -1; EXPR_HSHADOW_23 = -1; EXPR_HSHADOW_33 = -1
                EXPR_HSHADOW_04 = -1; EXPR_HSHADOW_05 = -1; EXPR_HSHADOW_06 = -1; EXPR_HSHADOW_07 = -1
                EXPR_HSHADOW_14 = -1; EXPR_HSHADOW_15 = -1; EXPR_HSHADOW_16 = -1; EXPR_HSHADOW_17 = -1
                EXPR_HSHADOW_24 = -1; EXPR_HSHADOW_25 = -1; EXPR_HSHADOW_26 = -1; EXPR_HSHADOW_27 = -1
                EXPR_HSHADOW_34 = -1; EXPR_HSHADOW_35 = -1; EXPR_HSHADOW_36 = -1; EXPR_HSHADOW_37 = -1
                EXPR_HSHADOW_44 = -1; EXPR_HSHADOW_45 = -1; EXPR_HSHADOW_46 = -1; EXPR_HSHADOW_47 = -1
                EXPR_HSHADOW_55 = -1; EXPR_HSHADOW_56 = -1; EXPR_HSHADOW_57 = -1
                EXPR_HSHADOW_66 = -1; EXPR_HSHADOW_67 = -1
                EXPR_HSHADOW_77 = -1
                EXPR_CH_SET = 0
                EXPR_PARAM_USED = 0
            }
            // Track unit for dimension checking at + and -
            if vi >= 0 { EXPR_UNIT = VAR_UNIT[vi as usize] } else { EXPR_UNIT = 0 }
            EXPR_UNIT_DIM = unit_lookup_dim(EXPR_UNIT)
            var_mark_used(ns, ne)
            // Linear variable consumed inside a loop — would be consumed multiple times
            if vi >= 0 && VAR_LINEAR[vi as usize] == 1 && LOOP_DEPTH > 0 {
                tc_linear_violation(EP - 1, "linear value consumed in loop body")
            }
            // Affine variable used more than once
            if vi >= 0 && VAR_AFFINE[vi as usize] == 1 && VAR_USED[vi as usize] > 1 {
                tc_linear_violation(EP - 1, "affine value used more than once")
            }
        }
        else {
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                em(0x48); em(0xb8); em64(GL_BSS_BASE + GL[(gi * 4 + 1) as usize])  // mov rax, addr
                if GL[(gi * 4 + 3) as usize] == 0 {
                    if type_is_struct_like(GL_TY[gi as usize], GL_TY_HASH[gi as usize]) == false {
                        if type_is_option_inline(GL_TY[gi as usize], GL_TY_HASH[gi as usize]) == false || GL[(gi * 4 + 2) as usize] < 16 {
                            em(0x48); em(0x8b); em(0x00)  // scalar: mov rax, [rax] (dereference)
                        }
                    }
                }
                EXPR_TY = GL_TY[gi as usize]
                EXPR_TY_HASH = GL_TY_HASH[gi as usize]
                if GL_TY[gi as usize] == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                return
            } else {
                // Named function reference: materialize a closure-ABI adapter thunk.
                // Thunk: shifts args (rdi=env_ptr dropped, rsi→rdi, rdx→rsi, ...) then calls fn.
                // Wrapped in a one-slot closure struct [thunk_ptr] for uniform HOF ABI.
                let fri = fn_find(TS[(EP - 1) as usize], TE[(EP - 1) as usize])
                if fri >= 0 {
                    let fn_arity = FN_ARITY[fri as usize]
                    // thunk_size = 3 bytes/arg (shift) + 5 (call rel32) + 1 (ret)
                    let thunk_size = fn_arity * 3 + 6
                    // Align thunk to even byte so tagged-ptr bit-0 trick is safe
                    if CL & 1 != 0 { em(0x90) }
                    em(0xeb); em(thunk_size)  // jmp short past thunk
                    let cl_thunk_start = CL    // always even after alignment
                    // Emit arg shifts: reg[i] ← reg[i+1] to drop env_ptr slot
                    // regs: rdi=0, rsi=1, rdx=2, rcx=3, r8=4, r9=5
                    var shi: i64 = 0
                    while shi < fn_arity {
                        if shi == 0 { em(0x48); em(0x89); em(0xf7) }       // mov rdi, rsi
                        else if shi == 1 { em(0x48); em(0x89); em(0xd6) }  // mov rsi, rdx
                        else if shi == 2 { em(0x48); em(0x89); em(0xca) }  // mov rdx, rcx
                        else if shi == 3 { em(0x4c); em(0x89); em(0xc1) }  // mov rcx, r8
                        else if shi == 4 { em(0x4d); em(0x89); em(0xc8) }  // mov r8, r9
                        shi = shi + 1
                    }
                    em(0xe8)   // call rel32
                    if FN_OFF[fri as usize] != -1 {
                        em32(FN_OFF[fri as usize] - (CL + 4))
                    } else {
                        PATCH_OFF[PATCH_COUNT as usize] = CL
                        PATCH_FN[PATCH_COUNT as usize] = fri
                        PATCH_KIND[PATCH_COUNT as usize] = 0
                        PATCH_COUNT = PATCH_COUNT + 1
                        em32(0)
                    }
                    em(0xc3)  // ret
                    // Tagged thunk: lea rax, [rip+thunk_start]; or rax, 1 (bit 0 = fn ref tag)
                    em(0x48); em(0x8d); em(0x05); em32(cl_thunk_start - (CL + 4))
                    em(0x48); em(0x83); em(0xc8); em(0x01)  // or rax, 1
                    EXPR_TY = 9
                    EXPR_TY_HASH = FN_SIG[fri as usize]
                    LAST_EXPR_IS_CLOSURE = 1
                } else {
                    if const_find_val(ns, ne) != 0 {
                        let ci = CONST_FOUND_IDX
                        if CONST_TYPE[ci as usize] == 2 && CONST_TOK_IDX[ci as usize] >= 0 {
                            let fl_int = TV[CONST_TOK_IDX[ci as usize] as usize]
                            let fl_frac = TF[CONST_TOK_IDX[ci as usize] as usize]
                            let fl_denom = TD[CONST_TOK_IDX[ci as usize] as usize]
                            var fl_sci: i64 = 0
                            var fl_sci_neg: i64 = 0
                            if TX[CONST_TOK_IDX[ci as usize] as usize] >= 0 {
                                fl_sci = TX[CONST_TOK_IDX[ci as usize] as usize]
                                fl_sci_neg = 0
                            } else {
                                fl_sci = 0 - TX[CONST_TOK_IDX[ci as usize] as usize]
                                fl_sci_neg = 1
                            }
                            em(0x48); em(0xb8); em64(fl_int)
                            em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xc0)
                            if fl_frac > 0 {
                                em(0x48); em(0xb8); em64(fl_frac)
                                em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xc8)
                                em(0x48); em(0xb8); em64(fl_denom)
                                em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xd0)
                                em(0xf2); em(0x0f); em(0x5e); em(0xca)
                                em(0xf2); em(0x0f); em(0x58); em(0xc1)
                            }
                            if fl_sci != 0 {
                                em(0x48); em(0xb8); em64(0x4024000000000000)
                                em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)
                                if fl_sci_neg == 0 {
                                    while fl_sci > 0 {
                                        em(0xf2); em(0x0f); em(0x59); em(0xc1)
                                        fl_sci = fl_sci - 1
                                    }
                                } else {
                                    while fl_sci > 0 {
                                        em(0xf2); em(0x0f); em(0x5e); em(0xc1)
                                        fl_sci = fl_sci - 1
                                    }
                                }
                            }
                            em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
                            EXPR_TY = 2
                            EXPR_TY_HASH = 0
                            EXPR_IS_F64 = 1
                        } else {
                            if CONST_FOUND_VAL == 0 { em(0x31); em(0xc0) }
                            else { em(0x48); em(0xb8); em64(CONST_FOUND_VAL) }
                            EXPR_TY = 1; EXPR_TY_HASH = 0; EXPR_IS_F64 = 0
                        }
                        return
                    }
                    // True undefined variable: not local, not global, not fn, not const
                    // #1634: was `E200 \`x\` at line N` -- no `error:` prefix, so
                    // grep '^error' missed it, and a bare bundle line number with
                    // no file to resolve it against.
                    print("error[E200]: undefined identifier `")
                    var e200_i: i64 = ns
                    while e200_i < ne { print_char(SRC[e200_i as usize] as i64); e200_i = e200_i + 1 }
                    print("` at ")
                    print_src_loc_for_tok(name_tok)
                    print("\n")
                    tc_mark_failed()
                    em(0x31); em(0xc0)
                    EXPR_TY = 0
                    EXPR_TY_HASH = 0
                }
            }
            EXPR_IS_F64 = 0
        }
        return
    }
    EP = EP + 1
    em(0x31); em(0xc0)
    EXPR_IS_F64 = 0
}

// Postfix: `as` type casts, `.field` access
fn compile_postfix() with IO, Mut, Panic, Div {
    compile_primary()
    compile_postfix_tail()
}

fn compile_postfix_tail() with IO, Mut, Panic, Div {
    var more: i64 = 1
    while more == 1 {
        if TK[EP as usize] == 37 {
            EP = EP + 1  // skip 'as'
            let tp = EP
            let src_ty = EXPR_TY
            let src_hash = EXPR_TY_HASH
            let src_is_f64 = EXPR_IS_F64
            let tns = TS[EP as usize]
            let tne = TE[EP as usize]
            scan_type(tp)
            var cast_ty = SCAN_TY
            var cast_hash = SCAN_TY_HASH
            if cast_ty == 0 && name_is_lower(tns, tne) {
                cast_ty = 2
                cast_hash = gl_name_hash(tns, tne)
            }
            // E171: cannot cast Knowledge<T> to its inner type via `as`
            if knowledge_hash_is(src_hash) && !knowledge_hash_is(cast_hash) {
                tc_epistemic_cast_blocked(tp)
            }
            if src_ty == 2 && cast_ty == 2 && src_hash != 0 && cast_hash != 0 && src_hash != cast_hash {
                let src_dim = unit_lookup_dim(src_hash)
                let cast_dim = unit_lookup_dim(cast_hash)
                // Same-dimension casts (mg→kg, s→ms) are allowed; cross-dimension (mg→s) are not
                if src_dim == 0 || cast_dim == 0 || src_dim != cast_dim {
                    tc_arity_error(tp, "incompatible unit dimensions")
                }
            }
            if cast_ty == 1 && src_is_f64 == 1 {
                em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc0)
                em(0xf2); em(0x48); em(0x0f); em(0x2c); em(0xc0)
            }
            if cast_ty == 2 && src_is_f64 == 0 {
                em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xc0)
                em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)
            }
            if cast_ty == 1 && tne - tns == 2 && sb(tns) == 105 && sb(tns+1) == 56 {
                em(0x48); em(0x0f); em(0xbe); em(0xc0)  // as i8: movsx rax, al
            }
            // integer/unit as string: no conversion emitted; leave EXPR_TY as-is so
            // print/println dispatch to emit_print_int rather than emit_print_cstr
            if cast_ty == 3 && src_is_f64 == 0 { EP = SCAN_TY_NEXT; continue }
            EXPR_TY = cast_ty
            EXPR_TY_HASH = cast_hash
            if EXPR_TY == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
            EP = SCAN_TY_NEXT
            continue
        }
        if TK[EP as usize] == 41 {
            let base_ty = EXPR_TY
            let base_hash = EXPR_TY_HASH
            emit_push()
            EP = EP + 1
            compile_or()
            if EXPR_TY != 0 && EXPR_TY != 1 {
                tc_error_hard(EP - 1, "array index must be integer")
            }
            if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }
            if TK[EP as usize] == 42 { EP = EP + 1 }
            em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (index)
            em(0x59)  // pop rcx (base pointer)
            if base_ty == 8 {
                let esiz = arr_hash_esiz(base_hash)
                var elem_ty = arr_hash_elem_ty(base_hash)
                let elem_hash = arr_hash_elem_hash(base_hash)
                LAST_ALEN = arr_hash_alen(base_hash)
                if elem_ty == 8 && elem_hash != 0 {
                    // nested array stored as pointer-per-slot: load pointer to inner array
                    // rcx = outer array base, rdx = outer index
                    em(0x48); em(0x8b); em(0x04); em(0xd1)  // mov rax, [rcx + rdx*8]
                    EXPR_TY = 8
                    EXPR_TY_HASH = elem_hash
                    EXPR_IS_F64 = 0
                } else if esiz == 8 {
                    em(0x48); em(0x8b); em(0x04); em(0xd1)  // mov rax, [rcx + rdx*8]
                    EXPR_TY = elem_ty
                    EXPR_TY_HASH = elem_hash
                    if elem_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                } else {
                    em(0x48); em(0x0f); em(0xbe); em(0x04); em(0x11)  // movsx rax, byte [rcx + rdx]
                    EXPR_TY = 1
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 0
                }
            } else if base_ty == 12 {
                // Seq element read: rcx = Seq ptr, rdx = index → seq.get(index)
                let sub_sgp = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                em(0x48); em(0x89); em(0xc8)   // mov rax, rcx (Seq ptr)
                emit_store_var(sub_sgp)
                let sub_sgi = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + 1
                em(0x48); em(0x89); em(0xd0)   // mov rax, rdx (index)
                emit_store_var(sub_sgi)
                emit_seq_get_slots_x86(sub_sgp, sub_sgi)
                EXPR_IS_F64 = 0
                if seq_hash_is(base_hash) {
                    EXPR_TY = seq_hash_inner_ty(base_hash)
                    EXPR_TY_HASH = seq_hash_inner_hash(base_hash)
                } else {
                    EXPR_TY = 1
                    EXPR_TY_HASH = 0
                }
            } else if type_is_slice_ref(base_ty, base_hash) {
                let inner_hash = ref_hash_inner_hash(base_hash)
                let esiz = arr_hash_esiz(inner_hash)
                var elem_ty = arr_hash_elem_ty(inner_hash)
                let elem_hash = arr_hash_elem_hash(inner_hash)
                em(0x48); em(0x8b); em(0x41); em(8)  // mov rax, [rcx + 8] (len)
                em(0x48); em(0x39); em(0xc2)         // cmp rdx, rax
                em(0x0f); em(0x82); let slice_ok = CL; em32(0)
                emit_assert_fail()
                let slice_ok_target = CL
                patch32(slice_ok, slice_ok_target)
                em(0x48); em(0x8b); em(0x01)         // mov rax, [rcx] (data ptr)
                if esiz == 8 {
                    em(0x48); em(0x8b); em(0x04); em(0xd0)  // mov rax, [rax + rdx*8]
                    EXPR_TY = elem_ty
                    EXPR_TY_HASH = elem_hash
                    if elem_ty == 2 { EXPR_IS_F64 = 1 } else { EXPR_IS_F64 = 0 }
                } else {
                    em(0x48); em(0x0f); em(0xbe); em(0x04); em(0x10)  // movsx rax, byte [rax + rdx]
                    EXPR_TY = 1
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 0
                }
            } else if type_is_array_ref(base_ty, base_hash) {
                let inner_hash = ref_hash_inner_hash(base_hash)
                let esiz = arr_hash_esiz(inner_hash)
                let elem_ty = arr_hash_elem_ty(inner_hash)
                let elem_hash = arr_hash_elem_hash(inner_hash)
                LAST_ALEN = arr_hash_alen(inner_hash)
                if esiz == 8 {
                    // #1678: array elements of AGGREGATE type are stored
                    // pointer-per-slot, not inline -- see the store-path comments
                    // in this file. The value path already LOADS the element
                    // pointer here; this borrow path handed back the address of
                    // the pointer CELL, so the callee read the pointer bits as the
                    // first field. One opcode: 0x8b, not 0x8d.
                    //
                    // This is the unfinished half of #740, which corrected the
                    // TYPE of &!module.functions[i] -- ref rather than value --
                    // and left the address arithmetic alone.
                    if (elem_ty == 6 || elem_ty == 7 || elem_ty == 8) && elem_hash != 0 {
                        em(0x48); em(0x8b); em(0x04); em(0xd1)  // mov rax, [rcx + rdx*8] (element ptr)
                    } else {
                        em(0x48); em(0x8d); em(0x04); em(0xd1)  // lea rax, [rcx + rdx*8]
                    }
                } else {
                    em(0x48); em(0x8d); em(0x04); em(0x11)  // lea rax, [rcx + rdx] (esiz=1)
                }
                EXPR_TY = 10
                EXPR_TY_HASH = ref_hash_make(elem_ty, elem_hash, ref_hash_mut(base_hash))
                EXPR_IS_F64 = 0
            } else {
                if base_ty != 0 && base_ty != 3 {
                    tc_error_hard(EP - 1, "value is not indexable")
                }
                em(0x48); em(0x0f); em(0xbe); em(0x04); em(0x11)  // movsx rax, byte [rcx + rdx]
                EXPR_TY = 1
                EXPR_TY_HASH = 0
                EXPR_IS_F64 = 0
            }
            continue
        }
        if TK[EP as usize] == 50 {
            EP = EP + 1  // skip '.'
            let method_tok = EP
            let fns = TS[EP as usize]
            let fne = TE[EP as usize]
            let fh = gl_name_hash(fns, fne)
            // Built-in .await — Phase 1: TaskHandle join (EXPR_TY==100) or identity
            if src_match(fns, fne - fns, "await") {
                EP = EP + 1  // skip 'await'
                if EXPR_TY == 100 {
                    // TaskHandle {pid, slot_ptr}: wait4(pid) then read slot
                    let aw_handle_slot = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + 1
                    emit_store_var(aw_handle_slot)  // save handle ptr
                    // Load pid = [handle + 0]
                    emit_load_var(aw_handle_slot)
                    em(0x48); em(0x8b); em(0x00)    // mov rax, [rax]  ; pid
                    em(0x48); em(0x89); em(0xc7)    // mov rdi, rax    ; arg1=pid
                    em(0x48); em(0x31); em(0xf6)    // xor rsi, rsi    ; arg2=NULL
                    em(0x48); em(0x31); em(0xd2)    // xor rdx, rdx    ; arg3=0
                    em(0x4d); em(0x31); em(0xd2)    // xor r10, r10    ; arg4=NULL
                    em(0xb8); em32(61)              // mov eax, 61 (SYS_wait4)
                    em(0x0f); em(0x05)              // syscall
                    // Read result from slot_ptr = [handle + 8]
                    emit_load_var(aw_handle_slot)
                    em(0x48); em(0x8b); em(0x40); em(8)  // mov rax, [rax+8] ; slot_ptr
                    em(0x48); em(0x8b); em(0x00)         // mov rax, [rax]   ; result
                    EXPR_TY = 1
                    EXPR_TY_HASH = 0
                    EXPR_IS_F64 = 0
                }
                // else: identity — value already in rax, EXPR_TY unchanged
                continue
            }
            // Built-in .send(v) — Phase 1: write(fd, &v, 8) on channel tx (i64 fd)
            if src_match(fns, fne - fns, "send") && TK[(EP + 1) as usize] == 6 && EXPR_TY == 1 {
                EP = EP + 1  // skip 'send'
                EP = EP + 1  // skip (
                let ch_fd_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var(ch_fd_slot)          // save fd
                compile_or()                        // value to send in rax
                let ch_val_slot = NEXT_SLOT; NEXT_SLOT = NEXT_SLOT + 1
                emit_store_var(ch_val_slot)          // save value
                if TK[EP as usize] == 7 { EP = EP + 1 }  // skip )
                emit_load_var(ch_fd_slot)
                em(0x48); em(0x89); em(0xc7)        // mov rdi, rax  (fd)
