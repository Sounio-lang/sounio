// self-hosted::compiler::lean
//
// Lean modular compiler entrypoint.
// This keeps the day-to-day CLI path off compiler/main.sio's embedded
// self-test/backend laboratory while reusing the split frontend and native
// driver modules.

use module_frontend::{load_multimodule_ir, preflight_multimodule_frontend}
use module_native_driver::{compile_multimodule_llvm, compile_multimodule_native_advanced}

struct LeanOptions {
    input_file: string,
    output_file: string,
    target: string,
    matrix: string,
    explicit_target: bool,
    optimize: bool,
    verbose: bool,
    help: bool,
    self_test: bool,
    check_only: bool,
    ir_summary: bool,
    cache_dir: string,
    cache_mode: string,
    cache_stats: bool,
    gpu_target: string,
    gpu_binary_format: string,
    gpu_strict_parity: bool,
}

fn lean_print_help() with IO {
    println("Usage: souc-lean [options] <input.sio>")
    println("")
    println("Options:")
    println("  -o, --output <file>       Output file (default: a.out)")
    println("  -t, --target <target>     Target: native, x86_64-linux, wasm, llvm")
    println("  --matrix <mode>           Native target matrix mode (default: auto)")
    println("  -O, --optimize            Request optimization")
    println("  --check <source.sio>      Parse, resolve and typecheck only")
    println("  --ir-summary <source.sio> Print loaded IR function/string counts")
    println("  --self-test               Run lean CLI/import-contract smoke")
    println("  --cache-dir <dir>         Accepted for CLI compatibility")
    println("  --cache-mode <mode>       Accepted for CLI compatibility")
    println("  --cache-stats             Accepted for CLI compatibility")
    println("  --gpu-target <name>       Accepted for CLI compatibility")
    println("  --gpu-binary-format <fmt> Accepted for CLI compatibility")
    println("  --gpu-strict-parity       Accepted for CLI compatibility")
    println("  -v, --verbose             Print dispatch details")
    println("  -h, --help                Print this help message")
}

fn lean_empty_options() -> LeanOptions {
    LeanOptions {
        input_file: "",
        output_file: "a.out",
        target: "native",
        matrix: "auto",
        explicit_target: false,
        optimize: false,
        verbose: false,
        help: false,
        self_test: false,
        check_only: false,
        ir_summary: false,
        cache_dir: "",
        cache_mode: "off",
        cache_stats: false,
        gpu_target: "",
        gpu_binary_format: "",
        gpu_strict_parity: false,
    }
}

fn lean_parse_options() -> LeanOptions with IO, Mut, Panic, Div {
    var opts = lean_empty_options()
    let argc = arg_count()
    var i: i64 = 0
    while i < argc {
        let arg = get_arg(i)
        if arg == "-o" || arg == "--output" {
            i = i + 1
            if i < argc {
                opts.output_file = get_arg(i)
            }
        } else if arg == "-t" || arg == "--target" {
            i = i + 1
            if i < argc {
                opts.target = get_arg(i)
                opts.explicit_target = true
            }
        } else if arg == "--matrix" {
            i = i + 1
            if i < argc {
                opts.matrix = get_arg(i)
            }
        } else if arg == "-O" || arg == "--optimize" {
            opts.optimize = true
        } else if arg == "-v" || arg == "--verbose" {
            opts.verbose = true
        } else if arg == "--self-test" {
            opts.self_test = true
        } else if arg == "--check" {
            opts.check_only = true
            i = i + 1
            if i < argc {
                opts.input_file = get_arg(i)
            }
        } else if arg == "--ir-summary" {
            opts.ir_summary = true
            i = i + 1
            if i < argc {
                opts.input_file = get_arg(i)
            }
        } else if arg == "--cache-dir" {
            i = i + 1
            if i < argc {
                opts.cache_dir = get_arg(i)
            }
        } else if arg == "--cache-mode" {
            i = i + 1
            if i < argc {
                opts.cache_mode = get_arg(i)
            }
        } else if arg == "--cache-stats" {
            opts.cache_stats = true
        } else if arg == "--gpu-target" {
            i = i + 1
            if i < argc {
                opts.gpu_target = get_arg(i)
            }
        } else if arg == "--gpu-binary-format" {
            i = i + 1
            if i < argc {
                opts.gpu_binary_format = get_arg(i)
            }
        } else if arg == "--gpu-strict-parity" {
            opts.gpu_strict_parity = true
        } else if arg == "-h" || arg == "--help" {
            opts.help = true
            lean_print_help()
        } else if str_len(arg) > 0 && str_char_at(arg, 0) != 45 {
            opts.input_file = arg
        }
        i = i + 1
    }
    opts
}

fn lean_print_options(opts: LeanOptions) with IO {
    println("souc-lean: modular compiler entrypoint")
    println("  input:  " + opts.input_file)
    println("  output: " + opts.output_file)
    println("  target: " + opts.target)
    println("  matrix: " + opts.matrix)
    if opts.optimize {
        println("  optimize: true")
    } else {
        println("  optimize: false")
    }
}

fn lean_run_check(source_path: string) -> i64 with IO, Mut, Panic, Div, Alloc {
    let result = preflight_multimodule_frontend(source_path)
    if result.ok {
        println("souc-lean check: ok")
        return 0
    }
    println("souc-lean check: failed: " + result.error_msg)
    1
}

fn lean_run_ir_summary(source_path: string) -> i64 with IO, Mut, Panic, Div, Alloc {
    let result = load_multimodule_ir(source_path)
    if !result.ok {
        println("souc-lean ir-summary: failed: " + result.error_msg)
        return 1
    }
    print("souc-lean ir-summary: functions=")
    print_int(result.module.fn_count)
    print(" strings=")
    print_int(result.module.string_count)
    print(" epistemic_contests=")
    print_int(result.module.epistemic.contest_count)
    print("\n")
    0
}

fn lean_run_compile(opts: LeanOptions) -> i64 with IO, Mut, Panic, Div, Alloc {
    if opts.target == "llvm" {
        return compile_multimodule_llvm(opts.input_file, opts.output_file, opts.optimize) as i64
    }
    compile_multimodule_native_advanced(
        opts.input_file,
        opts.output_file,
        opts.target,
        opts.matrix,
        opts.explicit_target,
        opts.gpu_target,
        opts.gpu_binary_format,
        opts.gpu_strict_parity,
        opts.optimize,
        false,
        "",
        opts.cache_dir,
        opts.cache_mode,
        opts.cache_stats
    ) as i64
}

fn lean_run_self_test() -> i64 with IO {
    let rc = compile_multimodule_llvm("examples/hello.sio", "/tmp/sounio-lean-self-test.ll", false)
    if rc == 1 {
        println("souc-lean self-test: ok")
        return 0
    }
    println("souc-lean self-test: unexpected llvm backend status")
    1
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let opts = lean_parse_options()
    if opts.help {
        return 0
    }
    if opts.self_test {
        return lean_run_self_test()
    }
    if opts.input_file == "" {
        lean_print_help()
        return 1
    }
    if opts.verbose {
        lean_print_options(opts)
    }
    if opts.check_only {
        return lean_run_check(opts.input_file)
    }
    if opts.ir_summary {
        return lean_run_ir_summary(opts.input_file)
    }
    lean_run_compile(opts)
}
