// self-hosted::compiler::module_loader
//
// Multi-module compilation with resolve_modules integration
// This module is only available when the self-hosted suite is loaded.

fn compile_multimodule_program(main_path: string) -> CompileResult with IO, Mut, Div, Panic, Alloc {
    // Full module graph compilation
    // Pipeline: parse main → extract imports → load modules → resolve_modules
    //           → check all → lower → serialize

    // Step 1: Parse main file
    let main_state = read_source_file(main_path)
    let main_prog = parse_program_preloaded(main_state.token_count)

    // Step 2: Extract import paths
    let imports = extract_imports_from_ast(main_prog)
    let import_count = imports.count

    // Step 3: Load all modules
    var programs: [Program; 64] = [empty_program(); 64]
    programs[0] = main_prog
    var loaded: i64 = 1

    var i: i64 = 0
    while i < import_count && loaded < 64 {
        let module_name = imports.paths[i as usize]
        let module_file = resolve_module_file_path(module_name)

        if file_exists(module_file) {
            let mod_state = read_source_file(module_file)
            let mod_prog = parse_program_preloaded(mod_state.token_count)
            programs[loaded as usize] = mod_prog
            loaded = loaded + 1
        }

        i = i + 1
    }

    // Step 4: Resolve all modules together
    let resolve_result = resolve_modules(programs, loaded)
    if resolve_result.had_error {
        return compile_result_error("module_resolution_failed")
    }

    // Step 5: Type check all modules
    i = 0
    while i < loaded {
        let check_result = check_program(programs[i as usize])
        if check_result.had_error {
            return compile_result_error("type_check_failed")
        }
        i = i + 1
    }

    // Step 6: Lower main program to IR
    let lower_result = lower_program_to_ir(main_prog)
    if lower_result.had_error {
        return compile_result_error("ir_lowering_failed")
    }

    // Step 7: Serialize to bytecode
    let serialized = serialize_ir_module(lower_result.module)

    compile_result_ok(serialized.0, serialized.1)
}

struct ImportList {
    paths: [string; 64],
    count: i64,
}

fn extract_imports_from_ast(prog: Program) -> ImportList with Mut, Panic, Div {
    var imports: ImportList = ImportList {
        paths: [""; 64],
        count: 0,
    }

    match prog.items {
        None => imports,
        Some(items) => {
            var current = Some(items)
            while imports.count < 64 {
                match current {
                    None => break,
                    Some(list) => {
                        if list.head.kind == ItemKind::ItemUse {
                            // Extract module path from use item
                            let path_str = use_path_to_string(list.head.use_path)
                            imports.paths[imports.count as usize] = path_str
                            imports.count = imports.count + 1
                        }
                        current = list.tail
                    }
                }
            }
            imports
        }
    }
}

fn use_path_to_string(path: AstPath) -> string with Mut, Panic, Div {
    // Convert AstPath to string
    // For bootstrap: hardcode common patterns

    if path.seg_count == 0 {
        return ""
    }

    let seg = path.segments

    // Match known module paths
    // "compiler" first segment
    if seg.head_len >= 8 {
        if seg.head_buf[0] == 99 && seg.head_buf[1] == 111 &&  // "co"
           seg.head_buf[2] == 109 && seg.head_buf[3] == 112 {  // "mp"
            return "compiler::bootstrap"
        }
    }

    // "core" first segment
    if seg.head_len >= 4 {
        if seg.head_buf[0] == 99 && seg.head_buf[1] == 111 &&  // "co"
           seg.head_buf[2] == 114 && seg.head_buf[3] == 101 {  // "re"
            return "core::option"
        }
    }

    ""
}

fn resolve_module_file_path(module_path: string) -> string with IO, Panic, Div {
    // Convert module path to file path
    // "compiler::bootstrap" → "stdlib/compiler/bootstrap.sio"

    if str_eq(module_path, "compiler::bootstrap") {
        return "stdlib/compiler/bootstrap.sio"
    }
    if str_eq(module_path, "core::option") {
        return "stdlib/core/option.sio"
    }
    if str_eq(module_path, "core::list") {
        return "stdlib/core/list.sio"
    }

    // Default: try stdlib/MODULE.sio
    path_join("stdlib", path_join(module_path, ".sio"))
}

fn file_exists(path: string) -> bool with IO {
    file_size(path) > 0
}

fn empty_program() -> Program {
    Program {
        module_path: empty_path(),
        items: None,
    }
}

struct CompileResult {
    ok: bool,
    bytecode: [i8; 131072],
    bytecode_len: i64,
    error_msg: string,
}

fn compile_result_ok(bytecode: [i8; 131072], len: i64) -> CompileResult {
    CompileResult {
        ok: true,
        bytecode: bytecode,
        bytecode_len: len,
        error_msg: "",
    }
}

fn compile_result_error(msg: string) -> CompileResult {
    CompileResult {
        ok: false,
        bytecode: [0; 131072],
        bytecode_len: 0,
        error_msg: msg,
    }
}
