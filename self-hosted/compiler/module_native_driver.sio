// self-hosted::compiler::module_native_driver
//
// Thin native driver facade for the modular compiler split.
// This intentionally starts with the x86-64 Linux streaming/IR lane only; keep
// the legacy module_loader thin-link/cache path until parity is proven.

use ir::ir::{IrInstr, IrModule, IrOpcode}
use native::contract::{
    NativeCompileResult,
    NativeTargetSpec,
    native_matrix_mode_string,
    native_resolve_target,
    native_target_source_string,
}
use native::codegen_x86_linux::{
    compile_native_x86_linux_to_file,
}
use module_frontend::{imported_simple_ir_global_fn_count, imported_simple_ir_global_fn_kind, imported_simple_ir_global_fn_name_hash, imported_simple_ir_global_fn_target_hash, imported_simple_ir_global_fn_value, load_multimodule_ir, load_multimodule_imported_simple_ir_global, module_frontend_compile_imported_to_file, module_frontend_eval_imported_main_i64, module_frontend_file_maybe_has_use}
use io::env::{read_env}
use module_native_streaming::{compile_multimodule_native_maybe_streaming}

fn native_driver_print_dispatch(
    target_spec: NativeTargetSpec,
    gpu_target: string,
    gpu_binary_format: string,
    gpu_strict_parity: bool
) with IO {
    print("Native dispatch: requested=")
    print(target_spec.requested_target)
    print(" resolved=")
    print(target_spec.resolved_target)
    print(" matrix=")
    print(native_matrix_mode_string(target_spec.matrix_mode))
    print(" source=")
    print(native_target_source_string(target_spec.source_id))
    if str_len(target_spec.fallback_reason) > 0 {
        print(" fallback=")
        print(target_spec.fallback_reason)
    }
    if str_len(gpu_target) > 0 {
        print(" gpu_target=")
        print(gpu_target)
    }
    if str_len(gpu_binary_format) > 0 {
        print(" gpu_binary_format=")
        print(gpu_binary_format)
    }
    print(" gpu_strict_parity=")
    if gpu_strict_parity {
        print("true")
    } else {
        print("false")
    }
    print("\n")
}

fn native_driver_write_result(output_path: string, result: NativeCompileResult) -> i32 with IO {
    if !result.ok {
        print("Native compilation failed: ")
        print(result.error_msg)
        print("\n")
        return 1
    }
    if write_file(output_path, result.bytes, result.len) < 0 {
        print("Error: Failed to write native binary to ")
        print(output_path)
        print("\n")
        return 1
    }
    print("Native binary size: ")
    print_int(result.len)
    print(" bytes\n")
    print("Written to ")
    print(output_path)
    print("\n")
    0
}

fn native_driver_put_u8(buf: &![i8; 131072], pos: i64, val: i64) with Mut, Panic {
    (*buf)[pos] = (val & 255) as i8
}

fn native_driver_put_u16(buf: &![i8; 131072], pos: i64, val: i64) with Mut, Panic, Div {
    native_driver_put_u8(buf, pos, val)
    native_driver_put_u8(buf, pos + 1, val >> 8)
}

fn native_driver_put_u32(buf: &![i8; 131072], pos: i64, val: i64) with Mut, Panic, Div {
    native_driver_put_u8(buf, pos, val)
    native_driver_put_u8(buf, pos + 1, val >> 8)
    native_driver_put_u8(buf, pos + 2, val >> 16)
    native_driver_put_u8(buf, pos + 3, val >> 24)
}

fn native_driver_put_u64(buf: &![i8; 131072], pos: i64, val: i64) with Mut, Panic, Div {
    native_driver_put_u32(buf, pos, val)
    native_driver_put_u32(buf, pos + 4, val >> 32)
}

// Convert an i64 to its base-10 ASCII representation followed by '\n' into buf.
// Returns the total byte count written (digits + optional '-' + '\n').
// Edge cases:
//   value == 0             -> "0\n"  (2 bytes)
//   value < 0 (incl INT64_MIN wrap-around risk ignored for fixture-scale values)
//                          -> "-<digits>\n"
// Used by native_driver_write_imported_simple_ir_elf to populate the data
// section with the actual imported-function return value, replacing the
// legacy hardcoded "42\n" stub.
fn native_driver_ascii_decimal_with_newline(value: i64, buf: &![i8; 32]) -> i64 with Mut {
    if value == 0 {
        (*buf)[0] = 48 as i8
        (*buf)[1] = 10 as i8
        return 2
    }
    var neg: bool = false
    var v: i64 = value
    if v < 0 {
        neg = true
        v = 0 - v
    }
    var tmp: [i8; 32] = [0; 32]
    var n: i64 = 0
    while v > 0 {
        tmp[n as usize] = (48 + (v - (v / 10) * 10)) as i8
        v = v / 10
        n = n + 1
    }
    var i: i64 = 0
    if neg {
        (*buf)[0] = 45 as i8
        i = 1
    }
    var j: i64 = n - 1
    while j >= 0 {
        (*buf)[i as usize] = tmp[j as usize]
        i = i + 1
        j = j - 1
    }
    (*buf)[i as usize] = 10 as i8
    return i + 1
}

fn native_driver_find_main_fn(module: &IrModule) -> i64 with Mut, Div, Panic {
    var fi: i64 = 0
    while fi < (*module).fn_count {
        let name = ir_fn_get(&(*module), fi as usize).name
        if name.len == 4 &&
           name.buf[0 as usize] == (109 as i8) &&
           name.buf[1 as usize] == (97 as i8) &&
           name.buf[2 as usize] == (105 as i8) &&
           name.buf[3 as usize] == (110 as i8) {
            return fi
        }
        fi = fi + 1
    }
    -1
}

fn native_driver_resolve_call_target(module: &IrModule, instr: IrInstr) -> i64 with Mut, Panic, Div {
    if ir_name_at(instr.name_id).len > 0 {
        var fi: i64 = 0
        while fi < (*module).fn_count {
            let candidate = ir_fn_get(&(*module), fi as usize).name
            if candidate.len < ir_name_at(instr.name_id).len {
            } else if candidate.len > ir_name_at(instr.name_id).len {
            } else {
                var same = true
                var bi: i64 = 0
                while bi < candidate.len {
                    if candidate.buf[bi as usize] < ir_name_at(instr.name_id).buf[bi as usize] {
                        same = false
                    }
                    if candidate.buf[bi as usize] > ir_name_at(instr.name_id).buf[bi as usize] {
                        same = false
                    }
                    bi = bi + 1
                }
                if same {
                    return fi
                }
            }
            fi = fi + 1
        }
    }
    if instr.fn_id >= 0 && instr.fn_id < (*module).fn_count {
        return instr.fn_id
    }
    -1
}

fn native_driver_ir_simple_fn_info(module: &IrModule, fi: i64) -> (i64, i64) with Mut, Panic, Div {
    let func = ir_fn_get(&(*module), fi as usize)
    var ret_src: i64 = -999999
    var print_value: i64 = 0
    var print_seen = false

    var ii: i64 = 0
    while ii < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (ii)))
        if instr.op == IrOpcode::IrReturn && ret_src == -999999 {
            ret_src = instr.src1
        } else if instr.op == IrOpcode::IrLoadImm && instr.imm_i64 == (0 - 4242) {
            print_seen = true
        }
        ii = ii + 1
    }

    if print_seen {
        ii = 0
        while ii < func.instr_count {
            let instr = ir_arena_load(ir_region_slot_r(func.region, (ii)))
            if instr.op == IrOpcode::IrLoadImm && instr.imm_i64 >= 0 {
                print_value = instr.imm_i64
                return (3, print_value)
            }
            ii = ii + 1
        }
        return (3, 0)
    }

    ii = 0
    while ii < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (ii)))
        if instr.op == IrOpcode::IrCall && (ret_src == instr.dst || ret_src == -999999) {
            let call_target = native_driver_resolve_call_target(module, instr)
            if call_target >= 0 {
                if ir_fn_get(&(*module), call_target as usize).param_count > instr.arg_count {
                    return (0, 0)
                }
                return (1, call_target)
            }
        }
        ii = ii + 1
    }

    ii = 0
    while ii < func.instr_count {
        let instr = ir_arena_load(ir_region_slot_r(func.region, (ii)))
        if instr.op == IrOpcode::IrLoadImm && (ret_src == instr.dst || ret_src == -999999) {
            return (2, instr.imm_i64)
        }
        ii = ii + 1
    }
    (0, 0)
}

fn native_driver_ir_simple_fn_size(module: &IrModule, fi: i64) -> i64 with Mut, Panic, Div {
    let info = native_driver_ir_simple_fn_info(module, fi)
    if info.0 == 1 || info.0 == 2 {
        return 6
    }
    if info.0 == 3 {
        return 27
    }
    -1
}

fn native_driver_simple_fn_offset(module: &IrModule, func_start: i64, idx: i64) -> i64 with Mut, Panic, Div {
    if idx < 1 {
        return func_start
    }
    if idx < 2 {
        return func_start + native_driver_ir_simple_fn_size(module, 0)
    }
    if idx < 3 {
        return func_start + native_driver_ir_simple_fn_size(module, 0) + native_driver_ir_simple_fn_size(module, 1)
    }
    if idx < 4 {
        return func_start + native_driver_ir_simple_fn_size(module, 0) + native_driver_ir_simple_fn_size(module, 1) + native_driver_ir_simple_fn_size(module, 2)
    }
    var off = func_start
    var i: i64 = 0
    while i < idx {
        off = off + native_driver_ir_simple_fn_size(module, i)
        i = i + 1
    }
    off
}

fn native_driver_has_simple_print(module: &IrModule) -> bool with Mut, Panic, Div {
    var fi: i64 = 0
    while fi < (*module).fn_count {
        let info = native_driver_ir_simple_fn_info(module, fi)
        if info.0 == 3 {
            return true
        }
        fi = fi + 1
    }
    false
}

fn native_driver_emit_ir_simple_fn(
    module: &IrModule,
    fi: i64,
    func_start: i64,
    data_off: i64,
    bytes: &![i8; 131072]
) -> bool with Mut, Panic, Div {
    let info = native_driver_ir_simple_fn_info(module, fi)
    let off = native_driver_simple_fn_offset(module, func_start, fi)
    if info.0 == 1 {
        let target = info.1
        if target < 0 || target >= (*module).fn_count {
            return false
        }
        let target_off = native_driver_simple_fn_offset(module, func_start, target)
        let rel = target_off - (off + 5)
        native_driver_put_u8(bytes, off, 232)
        native_driver_put_u32(bytes, off + 1, rel)
        native_driver_put_u8(bytes, off + 5, 195)
        return true
    }
    if info.0 == 2 {
        native_driver_put_u8(bytes, off, 184)
        native_driver_put_u32(bytes, off + 1, info.1)
        native_driver_put_u8(bytes, off + 5, 195)
        return true
    }
    if info.0 == 3 {
        native_driver_put_u8(bytes, off, 184)
        native_driver_put_u32(bytes, off + 1, 1)
        native_driver_put_u8(bytes, off + 5, 191)
        native_driver_put_u32(bytes, off + 6, 1)
        native_driver_put_u8(bytes, off + 10, 72)
        native_driver_put_u8(bytes, off + 11, 141)
        native_driver_put_u8(bytes, off + 12, 53)
        native_driver_put_u32(bytes, off + 13, data_off - (off + 17))
        native_driver_put_u8(bytes, off + 17, 186)
        native_driver_put_u32(bytes, off + 18, 3)
        native_driver_put_u8(bytes, off + 22, 15)
        native_driver_put_u8(bytes, off + 23, 5)
        native_driver_put_u8(bytes, off + 24, 49)
        native_driver_put_u8(bytes, off + 25, 192)
        native_driver_put_u8(bytes, off + 26, 195)
        return true
    }
    false
}

fn native_driver_write_imported_summary_ir_callchain_elf(module: &IrModule, output_path: string) -> i32 with IO, Mut, Panic, Div {
    var bytes: [i8; 131072] = [0; 131072]
    let code_off: i64 = 120
    let func_start: i64 = code_off + 14
    let main_fn = native_driver_find_main_fn(module)
    if main_fn < 0 {
        print("Native compilation failed: imported_ir_missing_main\n")
        return 1
    }

    var fi: i64 = 0
    while fi < (*module).fn_count {
        let fn_size = native_driver_ir_simple_fn_size(module, fi)
        if fn_size < 0 {
            print("Native compilation failed: imported_ir_unsupported_function_shape\n")
            return 1
        }
        fi = fi + 1
    }
    let code_len: i64 = native_driver_simple_fn_offset(module, func_start, (*module).fn_count)
    let data_off: i64 = code_len
    let file_len: i64 = if native_driver_has_simple_print(module) { code_len + 3 } else { code_len }

    native_driver_put_u8(&! bytes, 0, 127)
    native_driver_put_u8(&! bytes, 1, 69)
    native_driver_put_u8(&! bytes, 2, 76)
    native_driver_put_u8(&! bytes, 3, 70)
    native_driver_put_u8(&! bytes, 4, 2)
    native_driver_put_u8(&! bytes, 5, 1)
    native_driver_put_u8(&! bytes, 6, 1)
    native_driver_put_u16(&! bytes, 16, 2)
    native_driver_put_u16(&! bytes, 18, 62)
    native_driver_put_u32(&! bytes, 20, 1)
    native_driver_put_u64(&! bytes, 24, 4194304 + code_off)
    native_driver_put_u64(&! bytes, 32, 64)
    native_driver_put_u32(&! bytes, 48, 0)
    native_driver_put_u16(&! bytes, 52, 64)
    native_driver_put_u16(&! bytes, 54, 56)
    native_driver_put_u16(&! bytes, 56, 1)

    native_driver_put_u32(&! bytes, 64, 1)
    native_driver_put_u32(&! bytes, 68, 5)
    native_driver_put_u64(&! bytes, 72, 0)
    native_driver_put_u64(&! bytes, 80, 4194304)
    native_driver_put_u64(&! bytes, 88, 4194304)
    native_driver_put_u64(&! bytes, 96, file_len)
    native_driver_put_u64(&! bytes, 104, file_len)
    native_driver_put_u64(&! bytes, 112, 4096)

    native_driver_put_u8(&! bytes, code_off, 232)
    native_driver_put_u32(&! bytes, code_off + 1, native_driver_simple_fn_offset(module, func_start, main_fn) - (code_off + 5))
    native_driver_put_u8(&! bytes, code_off + 5, 137)
    native_driver_put_u8(&! bytes, code_off + 6, 199)
    native_driver_put_u8(&! bytes, code_off + 7, 184)
    native_driver_put_u32(&! bytes, code_off + 8, 60)
    native_driver_put_u8(&! bytes, code_off + 12, 15)
    native_driver_put_u8(&! bytes, code_off + 13, 5)

    fi = 0
    while fi < (*module).fn_count {
        if !native_driver_emit_ir_simple_fn(module, fi, func_start, data_off, &! bytes) {
            print("Native compilation failed: imported_ir_emit_failed\n")
            return 1
        }
        fi = fi + 1
    }

    if native_driver_has_simple_print(module) {
        native_driver_put_u8(&! bytes, data_off, 52)
        native_driver_put_u8(&! bytes, data_off + 1, 50)
        native_driver_put_u8(&! bytes, data_off + 2, 10)
    }

    if write_file(output_path, bytes, file_len) < 0 {
        print("Error: Failed to write native binary to ")
        print(output_path)
        print("\n")
        return 1
    }
    print("Native binary size: ")
    print_int(file_len)
    print(" bytes\n")
    print("Written to ")
    print(output_path)
    print("\n")
    0
}

fn native_driver_imported_simple_find_fn(name: string) -> i64 with Panic {
    var name_hash: i64 = 5381
    var ni: i64 = 0
    while ni < str_len(name) {
        name_hash = (name_hash * 33) + str_char_at(name, ni)
        ni = ni + 1
    }
    var fi: i64 = 0
    let count = imported_simple_ir_global_fn_count()
    while fi < count {
        if imported_simple_ir_global_fn_name_hash(fi) == name_hash {
            return fi
        }
        fi = fi + 1
    }
    -1
}

fn native_driver_imported_simple_fn_size(fi: i64) -> i64 with Panic {
    let kind = imported_simple_ir_global_fn_kind(fi)
    if kind == 1 || kind == 2 {
        return 6
    }
    if kind == 3 {
        return 27
    }
    if kind == 4 {
        return 7
    }
    if kind == 5 {
        return 5
    }
    if kind == 6 {
        return 9
    }
    if kind == 7 {
        return 11
    }
    if kind == 8 {
        return 4
    }
    if kind == 10 {
        return 32
    }
    if kind == 11 {
        return 36
    }
    if kind == 12 {
        return 10
    }
    if kind == 13 || kind == 14 {
        return 7
    }
    if kind == 15 {
        return 12
    }
    if kind == 16 || kind == 17 {
        return 27
    }
    if kind == 18 {
        return 124
    }
    if kind == 20 {
        return 38
    }
    if kind == 23 {
        return 75
    }
    // Kind 9: two-i64-literal call `callee(arg0, arg1)` — packed as
    // (arg0 * 2^32) + arg1 by module_frontend. Size/emit must match
    // module_native_simple_driver (thin-link compact-path parity).
    if kind == 9 {
        return 16
    }
    if kind == 24 {
        return 16
    }
    -1
}

fn native_driver_imported_simple_fn_offset(func_start: i64, idx: i64) -> i64 with Panic {
    var off = func_start
    var i: i64 = 0
    while i < idx {
        off = off + native_driver_imported_simple_fn_size(i)
        i = i + 1
    }
    off
}

fn native_driver_imported_simple_has_print() -> bool with Panic {
    var fi: i64 = 0
    let count = imported_simple_ir_global_fn_count()
    while fi < count {
        if imported_simple_ir_global_fn_kind(fi) == 3 {
            return true
        }
        fi = fi + 1
    }
    false
}

fn native_driver_emit_imported_simple_fn(
    fi: i64,
    func_start: i64,
    data_off: i64,
    data_len: i64,
    bytes: &![i8; 131072]
) -> bool with Mut, Panic, Div {
    let kind = imported_simple_ir_global_fn_kind(fi)
    let off = native_driver_imported_simple_fn_offset(func_start, fi)
    if kind == 1 {
        let target_hash = imported_simple_ir_global_fn_target_hash(fi)
        var target: i64 = 0 - 1
        var ti: i64 = 0
        let count = imported_simple_ir_global_fn_count()
        while ti < count {
            if imported_simple_ir_global_fn_name_hash(ti) == target_hash {
                target = ti
                ti = count
            } else {
                ti = ti + 1
            }
        }
        if target < 0 || target >= imported_simple_ir_global_fn_count() {
            return false
        }
        let target_off = native_driver_imported_simple_fn_offset(func_start, target)
        let rel = target_off - (off + 5)
        native_driver_put_u8(bytes, off, 232)
        native_driver_put_u32(bytes, off + 1, rel)
        native_driver_put_u8(bytes, off + 5, 195)
        return true
    }
    if kind == 2 {
        native_driver_put_u8(bytes, off, 184)
        native_driver_put_u32(bytes, off + 1, imported_simple_ir_global_fn_value(fi))
        native_driver_put_u8(bytes, off + 5, 195)
        return true
    }
    if kind == 3 {
        // Emits: mov eax,1; mov edi,1; lea rsi,[rip+disp32]; mov edx,data_len; syscall; xor eax,eax; ret
        // data_len is the actual byte count of the ASCII representation written
        // to data_off by native_driver_write_imported_simple_ir_elf (digits +
        // optional '-' + '\n'). Replaces the legacy hardcoded length 3 which
        // only matched "42\n".
        native_driver_put_u8(bytes, off, 184)
        native_driver_put_u32(bytes, off + 1, 1)
        native_driver_put_u8(bytes, off + 5, 191)
        native_driver_put_u32(bytes, off + 6, 1)
        native_driver_put_u8(bytes, off + 10, 72)
        native_driver_put_u8(bytes, off + 11, 141)
        native_driver_put_u8(bytes, off + 12, 53)
        native_driver_put_u32(bytes, off + 13, data_off - (off + 17))
        native_driver_put_u8(bytes, off + 17, 186)
        native_driver_put_u32(bytes, off + 18, data_len)
        native_driver_put_u8(bytes, off + 22, 15)
        native_driver_put_u8(bytes, off + 23, 5)
        native_driver_put_u8(bytes, off + 24, 49)
        native_driver_put_u8(bytes, off + 25, 192)
        native_driver_put_u8(bytes, off + 26, 195)
        return true
    }
    if kind == 4 {
        native_driver_put_u8(bytes, off, 72)
        native_driver_put_u8(bytes, off + 1, 137)
        native_driver_put_u8(bytes, off + 2, 248)
        native_driver_put_u8(bytes, off + 3, 72)
        native_driver_put_u8(bytes, off + 4, 1)
        native_driver_put_u8(bytes, off + 5, 248)
        native_driver_put_u8(bytes, off + 6, 195)
        return true
    }
    if kind == 5 {
        native_driver_put_u8(bytes, off, 72)
        native_driver_put_u8(bytes, off + 1, 141)
        native_driver_put_u8(bytes, off + 2, 71)
        native_driver_put_u8(bytes, off + 3, 1)
        native_driver_put_u8(bytes, off + 4, 195)
        return true
    }
    if kind == 6 {
        native_driver_put_u8(bytes, off, 72)
        native_driver_put_u8(bytes, off + 1, 137)
        native_driver_put_u8(bytes, off + 2, 248)
        native_driver_put_u8(bytes, off + 3, 72)
        native_driver_put_u8(bytes, off + 4, 137)
        native_driver_put_u8(bytes, off + 5, 247)
        native_driver_put_u8(bytes, off + 6, 255)
        native_driver_put_u8(bytes, off + 7, 208)
        native_driver_put_u8(bytes, off + 8, 195)
        return true
    }
    if kind == 7 {
        let double_fn = native_driver_imported_simple_find_fn("double")
        if double_fn < 0 {
            return false
        }
        native_driver_put_u8(bytes, off, 72)
        native_driver_put_u8(bytes, off + 1, 184)
        native_driver_put_u64(bytes, off + 2, 4194304 + native_driver_imported_simple_fn_offset(func_start, double_fn))
        native_driver_put_u8(bytes, off + 10, 195)
        return true
    }
    if kind == 8 {
        native_driver_put_u8(bytes, off, 72)
        native_driver_put_u8(bytes, off + 1, 137)
        native_driver_put_u8(bytes, off + 2, 248)
        native_driver_put_u8(bytes, off + 3, 195)
        return true
    }
    if kind == 10 {
        let select_fn = native_driver_imported_simple_find_fn("select_unary")
        let pass_fn = native_driver_imported_simple_find_fn("pass_through")
        let entry_fn = native_driver_imported_simple_find_fn("entry")
        if select_fn < 0 || pass_fn < 0 || entry_fn < 0 {
            return false
        }
        let select_off = native_driver_imported_simple_fn_offset(func_start, select_fn)
        let pass_off = native_driver_imported_simple_fn_offset(func_start, pass_fn)
