// self-hosted::compiler::module_native_driver
//
// Thin native driver facade for the modular compiler split.
// This intentionally starts with the x86-64 Linux streaming/IR lane only; keep
// the legacy module_loader thin-link/cache path until parity is proven.

use ir::ir::{IrModule}
use native::contract::{
    ARCH_X86_64,
    ERR_BACKEND_NOT_IMPLEMENTED,
    ERR_OK,
    FORMAT_ELF64,
    NativeCompileResult,
    NativeTargetSpec,
    OS_LINUX,
    native_compile_result_error,
    native_compile_result_ok,
    native_matrix_mode_string,
    native_resolve_target,
    native_target_source_string,
}
use native::elf::{Elf64Binary}
use native::frame::{compiler_new, NativeCompiler}
use native::machine_ir::{native_v2_legalize_function, native_v2_lower_function_to_machine, MachineFunction}
use native::codegen_x86_linux::{
    compile_ir_function,
    compile_ir_function_v2,
    compile_module_streaming_begin,
    compile_module_streaming_finish,
    finalize_compiled_elf,
}
use module_frontend::{load_multimodule_ir}
use module_native_streaming::{compile_multimodule_native_maybe_streaming}

fn native_driver_copy_elf_to_small(src: [i8; 1048576], len: i64) -> [i8; 131072] with Mut, Panic, Div {
    var out: [i8; 131072] = [0; 131072]
    var i: i64 = 0
    while i < len && i < 131072 {
        out[i as usize] = src[i as usize]
        i = i + 1
    }
    out
}

fn native_driver_result_from_elf(bytes: [i8; 1048576], len: i64, format_id: i64) -> NativeCompileResult with Mut, Panic, Div {
    if len <= 0 || len > 131072 {
        return native_compile_result_error(ERR_BACKEND_NOT_IMPLEMENTED(), "native_driver_binary_too_large")
    }
    let narrow = native_driver_copy_elf_to_small(bytes, len)
    native_compile_result_ok(narrow, len, format_id)
}

fn native_driver_compile_ir_x86_linux(module: &IrModule, target_spec: NativeTargetSpec) -> NativeCompileResult with Mut, Panic, Div, Alloc {
    if target_spec.arch_id != ARCH_X86_64() || target_spec.os_id != OS_LINUX() {
        return native_compile_result_error(ERR_BACKEND_NOT_IMPLEMENTED(), "native_driver_target_not_supported")
    }
    if (*module).fn_count <= 0 {
        return native_compile_result_error(ERR_BACKEND_NOT_IMPLEMENTED(), "native_driver_empty_module")
    }

    var nc: NativeCompiler = compile_module_streaming_begin(compiler_new(), module)
    var fi: i64 = 0
    while fi < (*module).fn_count {
        let fn_body = (*module).functions[fi as usize]
        let lowered: MachineFunction = native_v2_lower_function_to_machine(fn_body)
        let legal: MachineFunction = native_v2_legalize_function(lowered)
        if legal.supported {
            nc = compile_ir_function_v2(nc, fn_body, legal, fi)
        } else {
            nc = compile_ir_function(nc, fn_body, fi)
        }
        fi = fi + 1
    }

    nc = compile_module_streaming_finish(nc, module)
    let elf: Elf64Binary = finalize_compiled_elf(nc, 4194304)
    native_driver_result_from_elf(elf.bytes, elf.len, FORMAT_ELF64())
}

fn native_driver_print_dispatch(
    target_spec: NativeTargetSpec,
    gpu_target: string,
    gpu_binary_format: string,
    gpu_strict_parity: bool
) with IO {
    print("Native dispatch: requested=")
    print(target_spec.requested_target)
    print(" resolved=")
    print(target_spec.resolved_target)
    print(" matrix=")
    print(native_matrix_mode_string(target_spec.matrix_mode))
    print(" source=")
    print(native_target_source_string(target_spec.source_id))
    if str_len(target_spec.fallback_reason) > 0 {
        print(" fallback=")
        print(target_spec.fallback_reason)
    }
    if str_len(gpu_target) > 0 {
        print(" gpu_target=")
        print(gpu_target)
    }
    if str_len(gpu_binary_format) > 0 {
        print(" gpu_binary_format=")
        print(gpu_binary_format)
    }
    print(" gpu_strict_parity=")
    if gpu_strict_parity {
        print("true")
    } else {
        print("false")
    }
    print("\n")
}

fn native_driver_write_result(output_path: string, result: NativeCompileResult) -> i32 with IO {
    if !result.ok {
        print("Native compilation failed: ")
        print(result.error_msg)
        print("\n")
        return 1
    }
    if !(write_file(output_path, result.bytes, result.len) == 0) {
        print("Error: Failed to write native binary to ")
        print(output_path)
        print("\n")
        return 1
    }
    print("Native binary size: ")
    print_int(result.len)
    print(" bytes\n")
    print("Written to ")
    print(output_path)
    print("\n")
    0
}

pub fn compile_multimodule_llvm(main_path: string, output_path: string, optimize: bool) -> i32 with IO {
    print("LLVM multimodule backend is unavailable in module_native_driver: ")
    print(main_path)
    print(" -> ")
    print(output_path)
    if optimize {
        print(" (opt)")
    }
    print("\n")
    1
}

pub fn compile_multimodule_native_with_ir(
    main_path: string,
    preloaded_ir: IrModule,
    output_path: string,
    requested_target: string,
    requested_matrix: string,
    explicit_target: bool,
    gpu_target: string,
    gpu_binary_format: string,
    gpu_strict_parity: bool
) -> i32 with IO, Mut, Div, Panic, Alloc {
    if str_eq(requested_target, "wasm") {
        print("WASM backend is not yet split into module_native_driver: ")
        print(main_path)
        print("\n")
        return 1
    }

    let target_spec = native_resolve_target(requested_target, requested_matrix, explicit_target)
    native_driver_print_dispatch(target_spec, gpu_target, gpu_binary_format, gpu_strict_parity)
    let native_result = native_driver_compile_ir_x86_linux(&preloaded_ir, target_spec)
    native_driver_write_result(output_path, native_result)
}

pub fn compile_multimodule_native_advanced(
    main_path: string,
    output_path: string,
    requested_target: string,
    requested_matrix: string,
    explicit_target: bool,
    gpu_target: string,
    gpu_binary_format: string,
    gpu_strict_parity: bool,
    optimize: bool,
    use_profile: bool,
    use_profile_path: string,
    cache_dir: string,
    cache_mode: string,
    cache_stats: bool
) -> i32 with IO, Mut, Div, Panic, Alloc {
    if optimize || use_profile || str_len(use_profile_path) > 0 || str_len(cache_dir) > 0 || cache_stats {
        print("module_native_driver: optimizer/profile/cache lane not split yet; using uncached modular path\n")
    }
    if str_len(cache_mode) > 0 && !str_eq(cache_mode, "off") {
        print("module_native_driver: cache_mode ignored until thin-link parity lands\n")
    }

    let target_spec = native_resolve_target(requested_target, requested_matrix, explicit_target)
    native_driver_print_dispatch(target_spec, gpu_target, gpu_binary_format, gpu_strict_parity)

    let stream_pair = compile_multimodule_native_maybe_streaming(main_path, target_spec)
    if stream_pair.0 {
        return native_driver_write_result(output_path, stream_pair.1)
    }

    let ir_result = load_multimodule_ir(main_path)
    if !ir_result.ok {
        print("Multi-module IR failed: ")
        print(ir_result.error_msg)
        print("\n")
        return 1
    }
    let native_result = native_driver_compile_ir_x86_linux(&ir_result.module, target_spec)
    native_driver_write_result(output_path, native_result)
}

pub fn compile_multimodule_native_maybe_streaming_for_target(
    main_path: string,
    requested_target: string,
    requested_matrix: string,
    explicit_target: bool
) -> (bool, NativeCompileResult) with IO, Mut, Div, Panic, Alloc {
    let target_spec = native_resolve_target(requested_target, requested_matrix, explicit_target)
    compile_multimodule_native_maybe_streaming(main_path, target_spec)
}

pub fn compile_multimodule_native(
    main_path: string,
    output_path: string,
    requested_target: string,
    requested_matrix: string,
    explicit_target: bool,
    gpu_target: string,
    gpu_binary_format: string,
    gpu_strict_parity: bool
) -> i32 with IO, Mut, Div, Panic, Alloc {
    compile_multimodule_native_advanced(
        main_path,
        output_path,
        requested_target,
        requested_matrix,
        explicit_target,
        gpu_target,
        gpu_binary_format,
        gpu_strict_parity,
        false,
        false,
        "",
        "",
        "off",
        false
    )
}
