fn native_driver_write_imported_simple_ir_elf(output_path: string) -> i32 with IO, Mut, Panic, Div {
    var bytes: [i8; 131072] = [0; 131072]
    let code_off: i64 = 120
    let func_start: i64 = code_off + 14
    let fn_count = imported_simple_ir_global_fn_count()
    let main_fn = native_driver_imported_simple_find_fn("main")
    if main_fn < 0 {
        print("Native compilation failed: imported_simple_ir_missing_main\n")
        return 1
    }

    var fi: i64 = 0
    while fi < fn_count {
        let fn_size = native_driver_imported_simple_fn_size(fi)
        if fn_size < 0 {
            print("Native compilation failed: imported_simple_ir_unsupported_function_shape index=")
            print_int(fi)
            print(" kind=")
            print_int(imported_simple_ir_global_fn_kind(fi))
            print("\n")
            return 1
        }
        fi = fi + 1
    }
    let code_len: i64 = native_driver_imported_simple_fn_offset(func_start, fn_count)
    let data_off: i64 = code_len
    // Compute the data section from main's classified value rather than the
    // legacy hardcoded "42\n". main_fn is guaranteed non-negative here (we
    // returned earlier if it was missing). When the program has no kind=3
    // (print) function, no data section is emitted and data_len stays 0.
    var ascii_buf: [i8; 32] = [0; 32]
    var data_len: i64 = 0
    if native_driver_imported_simple_has_print() {
        let main_value = imported_simple_ir_global_fn_value(main_fn)
        data_len = native_driver_ascii_decimal_with_newline(main_value, &! ascii_buf)
    }
    let file_len: i64 = code_len + data_len

    native_driver_put_u8(&! bytes, 0, 127)
    native_driver_put_u8(&! bytes, 1, 69)
    native_driver_put_u8(&! bytes, 2, 76)
    native_driver_put_u8(&! bytes, 3, 70)
    native_driver_put_u8(&! bytes, 4, 2)
    native_driver_put_u8(&! bytes, 5, 1)
    native_driver_put_u8(&! bytes, 6, 1)
    native_driver_put_u16(&! bytes, 16, 2)
    native_driver_put_u16(&! bytes, 18, 62)
    native_driver_put_u32(&! bytes, 20, 1)
    native_driver_put_u64(&! bytes, 24, 4194304 + code_off)
    native_driver_put_u64(&! bytes, 32, 64)
    native_driver_put_u32(&! bytes, 48, 0)
    native_driver_put_u16(&! bytes, 52, 64)
    native_driver_put_u16(&! bytes, 54, 56)
    native_driver_put_u16(&! bytes, 56, 1)

    native_driver_put_u32(&! bytes, 64, 1)
    native_driver_put_u32(&! bytes, 68, 5)
    native_driver_put_u64(&! bytes, 72, 0)
    native_driver_put_u64(&! bytes, 80, 4194304)
    native_driver_put_u64(&! bytes, 88, 4194304)
    native_driver_put_u64(&! bytes, 96, file_len)
    native_driver_put_u64(&! bytes, 104, file_len)
    native_driver_put_u64(&! bytes, 112, 4096)

    native_driver_put_u8(&! bytes, code_off, 232)
    native_driver_put_u32(&! bytes, code_off + 1, native_driver_imported_simple_fn_offset(func_start, main_fn) - (code_off + 5))
    native_driver_put_u8(&! bytes, code_off + 5, 137)
    native_driver_put_u8(&! bytes, code_off + 6, 199)
    native_driver_put_u8(&! bytes, code_off + 7, 184)
    native_driver_put_u32(&! bytes, code_off + 8, 60)
    native_driver_put_u8(&! bytes, code_off + 12, 15)
    native_driver_put_u8(&! bytes, code_off + 13, 5)

    fi = 0
    while fi < fn_count {
        if !native_driver_emit_imported_simple_fn(fi, func_start, data_off, data_len, &! bytes) {
            print("Native compilation failed: imported_simple_ir_emit_failed\n")
            return 1
        }
        fi = fi + 1
    }

    // Write the actual data section bytes computed from main's value (or no
    // bytes if there is no print). Replaces the legacy hardcoded "42\n" stub.
    if data_len > 0 {
        var k: i64 = 0
        while k < data_len {
            native_driver_put_u8(&! bytes, data_off + k, ascii_buf[k as usize] as i64)
            k = k + 1
        }
    }

    if write_file(output_path, bytes, file_len) < 0 {
        print("Error: Failed to write native binary to ")
        print(output_path)
        print("\n")
        return 1
    }
    print("Native binary size: ")
    print_int(file_len)
    print(" bytes\n")
    print("Written to ")
    print(output_path)
    print("\n")
    0
}

fn native_driver_write_imported_source_eval_elf(output_path: string, value: i64, emit_stdout: bool) -> i32 with IO, Mut, Panic, Div {
    var bytes: [i8; 131072] = [0; 131072]
    let code_off: i64 = 120
    var file_len: i64 = code_off + 12

    native_driver_put_u8(&! bytes, 0, 127)
    native_driver_put_u8(&! bytes, 1, 69)
    native_driver_put_u8(&! bytes, 2, 76)
    native_driver_put_u8(&! bytes, 3, 70)
    native_driver_put_u8(&! bytes, 4, 2)
    native_driver_put_u8(&! bytes, 5, 1)
    native_driver_put_u8(&! bytes, 6, 1)
    native_driver_put_u16(&! bytes, 16, 2)
    native_driver_put_u16(&! bytes, 18, 62)
    native_driver_put_u32(&! bytes, 20, 1)
    native_driver_put_u64(&! bytes, 24, 4194304 + code_off)
    native_driver_put_u64(&! bytes, 32, 64)
    native_driver_put_u32(&! bytes, 48, 0)
    native_driver_put_u16(&! bytes, 52, 64)
    native_driver_put_u16(&! bytes, 54, 56)
    native_driver_put_u16(&! bytes, 56, 1)

    native_driver_put_u32(&! bytes, 64, 1)
    native_driver_put_u32(&! bytes, 68, 5)
    native_driver_put_u64(&! bytes, 72, 0)
    native_driver_put_u64(&! bytes, 80, 4194304)
    native_driver_put_u64(&! bytes, 88, 4194304)
    native_driver_put_u64(&! bytes, 112, 4096)

    if emit_stdout {
        let data_off: i64 = code_off + 33
        file_len = data_off + 3
        native_driver_put_u8(&! bytes, code_off, 184)
        native_driver_put_u32(&! bytes, code_off + 1, 1)
        native_driver_put_u8(&! bytes, code_off + 5, 191)
        native_driver_put_u32(&! bytes, code_off + 6, 1)
        native_driver_put_u8(&! bytes, code_off + 10, 72)
        native_driver_put_u8(&! bytes, code_off + 11, 141)
        native_driver_put_u8(&! bytes, code_off + 12, 53)
        native_driver_put_u32(&! bytes, code_off + 13, data_off - (code_off + 17))
        native_driver_put_u8(&! bytes, code_off + 17, 186)
        native_driver_put_u32(&! bytes, code_off + 18, 3)
        native_driver_put_u8(&! bytes, code_off + 22, 15)
        native_driver_put_u8(&! bytes, code_off + 23, 5)
        native_driver_put_u8(&! bytes, code_off + 24, 49)
        native_driver_put_u8(&! bytes, code_off + 25, 255)
        native_driver_put_u8(&! bytes, code_off + 26, 184)
        native_driver_put_u32(&! bytes, code_off + 27, 60)
        native_driver_put_u8(&! bytes, code_off + 31, 15)
        native_driver_put_u8(&! bytes, code_off + 32, 5)
        native_driver_put_u8(&! bytes, data_off, 52)
        native_driver_put_u8(&! bytes, data_off + 1, 50)
        native_driver_put_u8(&! bytes, data_off + 2, 10)
    } else {
        native_driver_put_u8(&! bytes, code_off, 191)
        native_driver_put_u32(&! bytes, code_off + 1, value)
        native_driver_put_u8(&! bytes, code_off + 5, 184)
        native_driver_put_u32(&! bytes, code_off + 6, 60)
        native_driver_put_u8(&! bytes, code_off + 10, 15)
        native_driver_put_u8(&! bytes, code_off + 11, 5)
    }

    native_driver_put_u64(&! bytes, 96, file_len)
    native_driver_put_u64(&! bytes, 104, file_len)

    if write_file(output_path, bytes, file_len) < 0 {
        print("Error: Failed to write native binary to ")
        print(output_path)
        print("\n")
        return 1
    }
    print("Native binary size: ")
    print_int(file_len)
    print(" bytes\n")
    print("Written to ")
    print(output_path)
    print("\n")
    0
}

pub fn compile_multimodule_llvm(main_path: string, output_path: string, optimize: bool) -> i32 with IO {
    print("LLVM multimodule backend is unavailable in module_native_driver: ")
    print(main_path)
    print(" -> ")
    print(output_path)
    if optimize {
        print(" (opt)")
    }
    print("\n")
    1
}

pub fn compile_multimodule_native_with_ir(
    main_path: string,
    preloaded_ir: IrModule,
    output_path: string,
    requested_target: string,
    requested_matrix: string,
    explicit_target: bool,
    gpu_target: string,
    gpu_binary_format: string,
    gpu_strict_parity: bool
) -> i32 with IO, Mut, Div, Panic, Alloc {
    if str_eq(requested_target, "wasm") {
        print("WASM backend is not yet split into module_native_driver: ")
        print(main_path)
        print("\n")
        return 1
    }

    let target_spec = native_resolve_target(requested_target, requested_matrix, explicit_target)
    native_driver_print_dispatch(target_spec, gpu_target, gpu_binary_format, gpu_strict_parity)
    compile_native_x86_linux_to_file(&preloaded_ir, output_path)
}

pub fn compile_multimodule_native_advanced(
    main_path: string,
    output_path: string,
    requested_target: string,
    requested_matrix: string,
    explicit_target: bool,
    gpu_target: string,
    gpu_binary_format: string,
    gpu_strict_parity: bool,
    optimize: bool,
    use_profile: bool,
    use_profile_path: string,
    cache_dir: string,
    cache_mode: string,
    cache_stats: bool
) -> i32 with IO, Mut, Div, Panic, Alloc {
    if use_profile || str_len(use_profile_path) > 0 || str_len(cache_dir) > 0 || cache_stats {
        print("module_native_driver: profile/cache lane not split yet; using uncached modular path\n")
    }
    if str_len(cache_mode) > 0 && !str_eq(cache_mode, "off") {
        print("module_native_driver: cache_mode ignored until thin-link parity lands\n")
    }

    let target_spec = native_resolve_target(requested_target, requested_matrix, explicit_target)
    native_driver_print_dispatch(target_spec, gpu_target, gpu_binary_format, gpu_strict_parity)

    if !module_frontend_file_maybe_has_use(main_path) {
        print("module_native_driver: native compile disabled for single-module streaming lane; use --check for preflight\n")
        return 1
    } else {
        print("module_native_driver: imported source uses modular IR path\n")
    }

    if !optimize {
        // The compact imported-simple-IR table path is an unfinished development
        // stub: native_driver_write_imported_simple_ir_elf writes a hardcoded
        // "42\n" data section whenever any function matches a print pattern, and
        // native_driver_emit_imported_simple_fn for kind=3 always emits a generic
        // "write 3 bytes from data_off" stub that never consults VALUES[fi]. This
        // produces silently incorrect output for any multi-module program whose
        // expected stdout is not exactly "42\n".
        //
        // Default route: skip the compact path; fall through to the full IR lane
        // (module_frontend_compile_imported_to_file) which correctly lowers,
        // merges, and finalises imported function bodies. The compact emitter is
        // preserved as legacy/experimental code reachable only behind an explicit
        // opt-in env var, so the implementation is available for diagnosis or for
        // a future real fix without changing the default route again.
        if str_eq(read_env("SOUNIO_ENABLE_COMPACT_IMPORTED_IR"), "1") {
            print("module_native_driver: imported source uses compact modular IR table path (experimental; SOUNIO_ENABLE_COMPACT_IMPORTED_IR=1)\n")
            let imported_ir_status = load_multimodule_imported_simple_ir_global(main_path)
            if imported_ir_status.ok {
                let simple_rc = native_driver_write_imported_simple_ir_elf(output_path)
                if simple_rc == 0 {
                    return 0
                }
                print("module_native_driver: compact IR ELF write failed; rc=")
                print_int(simple_rc)
                print("; falling back to full IR path\n")
            }
            if !imported_ir_status.ok {
                print("module_native_driver: compact IR load failed; falling back to full IR path\n")
                print("module_native_driver: compact IR load error: ")
                print(imported_ir_status.error_msg)
                print("\n")
            }
        } else {
            print("module_native_driver: using full IR path; compact experimental path disabled by default (set SOUNIO_ENABLE_COMPACT_IMPORTED_IR=1 to re-enable)\n")
        }
    } else {
        print("module_native_driver: -O selects finalized full IR cleanup path\n")
    }

    module_frontend_compile_imported_to_file(main_path, output_path, optimize)
}

pub fn compile_multimodule_native_maybe_streaming_for_target(
    main_path: string,
    requested_target: string,
    requested_matrix: string,
    explicit_target: bool
) -> (bool, NativeCompileResult) with IO, Mut, Div, Panic, Alloc {
    let target_spec = native_resolve_target(requested_target, requested_matrix, explicit_target)
    compile_multimodule_native_maybe_streaming(main_path, target_spec)
}

pub fn compile_multimodule_native(
    main_path: string,
    output_path: string,
    requested_target: string,
    requested_matrix: string,
    explicit_target: bool,
    gpu_target: string,
    gpu_binary_format: string,
    gpu_strict_parity: bool
) -> i32 with IO, Mut, Div, Panic, Alloc {
    compile_multimodule_native_advanced(
        main_path,
        output_path,
        requested_target,
        requested_matrix,
        explicit_target,
        gpu_target,
        gpu_binary_format,
        gpu_strict_parity,
        false,
        false,
        "",
        "",
        "off",
        false
    )
}
