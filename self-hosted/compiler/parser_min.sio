use lexer::{Token, TokenKind, TokenList}

struct Span { line: i64, column: i64 }
struct Type { kind: i64, name: string, args: [i64; 16], args_len: i64 }
struct Expr { kind: i64, value: string, children: [i64; 64], children_len: i64, type_ann: Type, span: Span }
struct Parser { tokens: [Token; 4096], tokens_len: i64, pos: i64, errors: [string; 128], errors_len: i64 }

fn peek_ref(p: &Parser) -> Token {
    if p.pos < p.tokens_len {
        return p.tokens[p.pos as usize]
    }
    return Token { kind: TokenKind::Eof, text: "", line: 0, column: 0 }
}

fn parse_primary(p: Parser) -> (Parser, Expr) with Mut, Panic {
    return (p, Expr { kind: 0, value: "", children: [0; 64], children_len: 0, type_ann: Type { kind: 0, name: "", args: [0; 16], args_len: 0 }, span: Span { line: 0, column: 0 } })
}
