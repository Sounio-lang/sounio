        var info = src.alternative_sets[i]
        info.id = merged.alternative_set_count
        info.frontier_id = ir_epistemic_offset_id(info.frontier_id, alternative_frontier_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        info.candidate_start = ir_epistemic_offset_id(info.candidate_start, alternative_candidate_offset)
        merged.alternative_sets[merged.alternative_set_count as usize] = info
        merged.alternative_set_count = merged.alternative_set_count + 1
        i = i + 1
    }

    i = 0
    while i < src.alternative_reason_witness_count && merged.alternative_reason_witness_count < IR_MAX_EPI_ALTERNATIVE_REASON_WITNESSES {
        var info = src.alternative_reason_witnesses[i]
        info.id = merged.alternative_reason_witness_count
        info.alternative_set_id = ir_epistemic_offset_id(info.alternative_set_id, alternative_set_offset)
        info.candidate_id = ir_epistemic_offset_id(info.candidate_id, alternative_candidate_offset)
        merged.alternative_reason_witnesses[merged.alternative_reason_witness_count as usize] = info
        merged.alternative_reason_witness_count = merged.alternative_reason_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < src.transition_policy_count && merged.transition_policy_count < IR_MAX_EPI_TRANSITION_POLICIES {
        var info = src.transition_policies[i]
        info.id = merged.transition_policy_count
        merged.transition_policies[merged.transition_policy_count as usize] = info
        merged.transition_policy_count = merged.transition_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.transition_step_count && merged.transition_step_count < IR_MAX_EPI_TRANSITION_STEPS {
        var info = src.transition_steps[i]
        info.id = merged.transition_step_count
        info.protocol_id = ir_epistemic_offset_id(info.protocol_id, transition_protocol_offset)
        merged.transition_steps[merged.transition_step_count as usize] = info
        merged.transition_step_count = merged.transition_step_count + 1
        i = i + 1
    }

    i = 0
    while i < src.transition_protocol_count && merged.transition_protocol_count < IR_MAX_EPI_TRANSITION_PROTOCOLS {
        var info = src.transition_protocols[i]
        info.id = merged.transition_protocol_count
        info.transition_policy_id = ir_epistemic_offset_id(info.transition_policy_id, transition_policy_offset)
        info.step_start = ir_epistemic_offset_id(info.step_start, transition_step_offset)
        merged.transition_protocols[merged.transition_protocol_count as usize] = info
        merged.transition_protocol_count = merged.transition_protocol_count + 1
        i = i + 1
    }

    i = 0
    while i < src.transition_plan_count && merged.transition_plan_count < IR_MAX_EPI_TRANSITION_PLANS {
        var info = src.transition_plans[i]
        info.id = merged.transition_plan_count
        info.transition_policy_id = ir_epistemic_offset_id(info.transition_policy_id, transition_policy_offset)
        info.transition_protocol_id = ir_epistemic_offset_id(info.transition_protocol_id, transition_protocol_offset)
        info.alternative_option_id = ir_epistemic_offset_id(info.alternative_option_id, alternative_candidate_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        merged.transition_plans[merged.transition_plan_count as usize] = info
        merged.transition_plan_count = merged.transition_plan_count + 1
        i = i + 1
    }

    i = 0
    while i < src.transition_reason_witness_count && merged.transition_reason_witness_count < IR_MAX_EPI_TRANSITION_REASON_WITNESSES {
        var info = src.transition_reason_witnesses[i]
        info.id = merged.transition_reason_witness_count
        info.transition_plan_id = ir_epistemic_offset_id(info.transition_plan_id, transition_plan_offset)
        merged.transition_reason_witnesses[merged.transition_reason_witness_count as usize] = info
        merged.transition_reason_witness_count = merged.transition_reason_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < src.monitoring_policy_count && merged.monitoring_policy_count < IR_MAX_EPI_MONITORING_POLICIES {
        var info = src.monitoring_policies[i]
        info.id = merged.monitoring_policy_count
        merged.monitoring_policies[merged.monitoring_policy_count as usize] = info
        merged.monitoring_policy_count = merged.monitoring_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.observed_transition_count && merged.observed_transition_count < IR_MAX_EPI_OBSERVED_TRANSITIONS {
        var info = src.observed_transitions[i]
        info.id = merged.observed_transition_count
        info.transition_plan_id = ir_epistemic_offset_id(info.transition_plan_id, transition_plan_offset)
        info.monitoring_policy_id = ir_epistemic_offset_id(info.monitoring_policy_id, monitoring_policy_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        merged.observed_transitions[merged.observed_transition_count as usize] = info
        merged.observed_transition_count = merged.observed_transition_count + 1
        i = i + 1
    }

    i = 0
    while i < src.rollback_certificate_count && merged.rollback_certificate_count < IR_MAX_EPI_ROLLBACK_CERTIFICATES {
        var info = src.rollback_certificates[i]
        info.id = merged.rollback_certificate_count
        info.transition_plan_id = ir_epistemic_offset_id(info.transition_plan_id, transition_plan_offset)
        info.monitoring_policy_id = ir_epistemic_offset_id(info.monitoring_policy_id, monitoring_policy_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        merged.rollback_certificates[merged.rollback_certificate_count as usize] = info
        merged.rollback_certificate_count = merged.rollback_certificate_count + 1
        i = i + 1
    }

    merged
}

// ============================================================
// IR module merging
// ============================================================

fn ir_merge_modules(dst: IrModule, src: IrModule) -> IrModule with Mut, Panic, Div {
    // Merge src functions into dst, adjusting fn_ids in call instructions
    var merged = dst
    let fn_offset = dst.fn_count  // src function IDs shift by this amount
    let contest_offset = dst.epistemic.contest_count
    let robust_offset = dst.epistemic.robust_proof_count
    let decision_offset = dst.epistemic.decision_certificate_count
    let deferred_offset = dst.epistemic.deferred_certificate_count
    let validated_offset = dst.epistemic.validated_manifest_count
    let acquisition_plan_offset = dst.epistemic.acquisition_plan_count
    let recourse_plan_offset = dst.epistemic.recourse_plan_count
    let alternative_set_offset = dst.epistemic.alternative_set_count
    let transition_plan_offset = dst.epistemic.transition_plan_count
    let observed_transition_offset = dst.epistemic.observed_transition_count
    let rollback_certificate_offset = dst.epistemic.rollback_certificate_count

    // Copy functions
    var fi: i64 = 0
    while fi < src.fn_count && merged.fn_count < IR_MAX_FUNCS {
        var func = src.functions[fi]
        func.compile_strategy = src.functions[fi].compile_strategy
        var ii: i64 = 0
        while ii < func.instr_count {
            if func.instrs[ii].op == IrOpcode::IrCall {
                if func.instrs[ii].fn_id >= 0 {
                    func.instrs[ii].fn_id = func.instrs[ii].fn_id + fn_offset
                }
            }
            func.instrs[ii] = ir_merge_adjust_epistemic_instr(
                func.instrs[ii],
                contest_offset,
                robust_offset,
                decision_offset,
                deferred_offset,
                validated_offset,
                acquisition_plan_offset,
                recourse_plan_offset,
                alternative_set_offset,
                transition_plan_offset,
                observed_transition_offset,
                rollback_certificate_offset
            )
            ii = ii + 1
        }
        merged.functions[merged.fn_count] = func
        merged.fn_count = merged.fn_count + 1
        fi = fi + 1
    }

    // Merge string tables (simple append, no dedup for now)
    var si: i64 = 0
    while si < src.string_count && merged.string_count < IR_MAX_STRINGS {
        merged.string_table[merged.string_count] = src.string_table[si]
        merged.string_count = merged.string_count + 1
        si = si + 1
    }

    merged.epistemic = ir_merge_epistemic_sections(merged.epistemic, src.epistemic)
    merged.algebras = ir_merge_algebra_tables(merged.algebras, src.algebras)
    merged.ontologies = ir_merge_ontology_parameter_links(merged.ontologies, src.ontologies)

    merged
}

fn ir_merge_is_direct_fn_ref_opcode(op: IrOpcode) -> bool {
    match op {
        IrOpcode::IrCall => true,
        IrOpcode::IrCallSret => true,
        IrOpcode::IrLoadFnRef => true,
        _ => false,
    }
}

fn ir_merge_function_name_at(module: &IrModule, fn_id: i64) -> Name with Mut, Div, Panic {
    if fn_id >= 0 && fn_id < (*module).fn_count {
        return (*module).functions[fn_id as usize].name
    }
    ir_empty_name()
}

fn ir_merge_prepare_function_with_remap_from_func(
    func_in: IrFunction,
    src: &IrModule,
    dst: &IrModule,
    dep_fn_count: i64,
    fn_remap: &[i64; 2048],
    contest_offset: i64,
    robust_offset: i64,
    decision_offset: i64,
    deferred_offset: i64,
    validated_offset: i64,
    acquisition_plan_offset: i64,
    recourse_plan_offset: i64,
    alternative_set_offset: i64,
    transition_plan_offset: i64,
    observed_transition_offset: i64,
    rollback_certificate_offset: i64
) -> IrFunction with Mut, Panic, Div {
    var func = func_in
    var ii: i64 = 0
    while ii < func.instr_count {
        if ir_merge_is_direct_fn_ref_opcode(func.instrs[ii as usize].op) {
            let old_id = func.instrs[ii as usize].fn_id
            if old_id >= 0 && old_id < dep_fn_count {
                let mapped_id = fn_remap[old_id as usize]
                if mapped_id >= 0 {
                    let dep_name = (*src).functions[old_id as usize].name
                    let current_name = ir_merge_function_name_at(dst, old_id)
                    if ir_name_eq(dep_name, current_name) || ir_merge_find_function_name_index(dst, dep_name) < 0 {
                        func.instrs[ii as usize].fn_id = mapped_id
                    }
                }
            }
        }
        func.instrs[ii as usize] = ir_merge_adjust_epistemic_instr(
            func.instrs[ii as usize],
            contest_offset,
            robust_offset,
            decision_offset,
            deferred_offset,
            validated_offset,
            acquisition_plan_offset,
            recourse_plan_offset,
            alternative_set_offset,
            transition_plan_offset,
            observed_transition_offset,
            rollback_certificate_offset
        )
        ii = ii + 1
    }
    func
}

fn ir_merge_prepare_function_with_remap(
    src: &IrModule,
    src_fi: i64,
    dep_fn_count: i64,
    fn_remap: &[i64; 2048],
    contest_offset: i64,
    robust_offset: i64,
    decision_offset: i64,
    deferred_offset: i64,
    validated_offset: i64,
    acquisition_plan_offset: i64,
    recourse_plan_offset: i64,
    alternative_set_offset: i64,
    transition_plan_offset: i64,
    observed_transition_offset: i64,
    rollback_certificate_offset: i64
) -> IrFunction with Mut, Panic, Div {
    ir_merge_prepare_function_with_remap_from_func(
        (*src).functions[src_fi as usize],
        src,
        src,
        dep_fn_count,
        fn_remap,
        contest_offset,
        robust_offset,
        decision_offset,
        deferred_offset,
        validated_offset,
        acquisition_plan_offset,
        recourse_plan_offset,
        alternative_set_offset,
        transition_plan_offset,
        observed_transition_offset,
        rollback_certificate_offset
    )
}

// Resolve a merged-module fn_id by symbol name. Prefer a lowered body (instr_count>0)
// over import stubs so dependency functions keep calling real implementations.
fn ir_merge_find_function_name_index(module: &IrModule, name: Name) -> i64 with Mut, Div, Panic {
    var fi: i64 = 0
    var found: i64 = 0 - 1
    var found_stub: i64 = 0 - 1
    while fi < (*module).fn_count {
        if ir_name_eq((*module).functions[fi as usize].name, name) {
            if (*module).functions[fi as usize].instr_count > 0 {
                found = fi
            } else if found_stub < 0 {
                found_stub = fi
            }
        }
        fi = fi + 1
    }
    if found >= 0 { found } else { found_stub }
}

// After stub replacement, remap in-function IrCall/IrCallSret targets from the
// dependency module's local fn_id space to the accumulated module by name.
fn ir_merge_remap_existing_call_targets(func: IrFunction, src: &IrModule, dst: &IrModule) -> IrFunction with Mut, Panic, Div {
    var out = func
    var ii: i64 = 0
    while ii < out.instr_count {
        if out.instrs[ii as usize].op == IrOpcode::IrCall || out.instrs[ii as usize].op == IrOpcode::IrCallSret {
            let old_id = out.instrs[ii as usize].fn_id
            if old_id >= 0 && old_id < (*src).fn_count {
                let target_name = (*src).functions[old_id as usize].name
                let new_id = ir_merge_find_function_name_index(dst, target_name)
                if new_id >= 0 {
                    out.instrs[ii as usize].fn_id = new_id
                }
            }
        }
        ii = ii + 1
    }
    out
}

// Takes &! IrModule (not &! Box<IrModule>): the latter triggers a lean_single
// codegen bug where (*box_ref).field reads garbage. Callers materialize the
// IrModule reference via &! (*acc_box) at the call site.
fn ir_merge_append_function_into_box(dst: &! IrModule, src: &IrModule, src_fi: i64) with Mut, Panic, Div {
    if src_fi < 0 || src_fi >= (*src).fn_count || (*dst).fn_count >= IR_MAX_FUNCS {
        return
    }
    let fn_offset = (*dst).fn_count
    let contest_offset = (*dst).epistemic.contest_count
    let robust_offset = (*dst).epistemic.robust_proof_count
    let decision_offset = (*dst).epistemic.decision_certificate_count
    let deferred_offset = (*dst).epistemic.deferred_certificate_count
    let validated_offset = (*dst).epistemic.validated_manifest_count
    let acquisition_plan_offset = (*dst).epistemic.acquisition_plan_count
    let recourse_plan_offset = (*dst).epistemic.recourse_plan_count
    let alternative_set_offset = (*dst).epistemic.alternative_set_count
    let transition_plan_offset = (*dst).epistemic.transition_plan_count
    let observed_transition_offset = (*dst).epistemic.observed_transition_count
    let rollback_certificate_offset = (*dst).epistemic.rollback_certificate_count
    var func = (*src).functions[src_fi as usize]
    func.compile_strategy = (*src).functions[src_fi as usize].compile_strategy
    var ii: i64 = 0
    while ii < func.instr_count {
        if ir_merge_is_direct_fn_ref_opcode(func.instrs[ii as usize].op) {
            if func.instrs[ii as usize].fn_id >= 0 {
                func.instrs[ii as usize].fn_id = func.instrs[ii as usize].fn_id + fn_offset
            }
        }
        func.instrs[ii as usize] = ir_merge_adjust_epistemic_instr(
            func.instrs[ii as usize],
            contest_offset,
            robust_offset,
            decision_offset,
            deferred_offset,
            validated_offset,
            acquisition_plan_offset,
            recourse_plan_offset,
            alternative_set_offset,
            transition_plan_offset,
            observed_transition_offset,
            rollback_certificate_offset
        )
        ii = ii + 1
    }
    let dst_idx = (*dst).fn_count
    (*dst).functions[dst_idx as usize] = func
    (*dst).fn_count = (*dst).fn_count + 1
}

// Resolve a call's canonical target from its (fn_id, name) fields only.
// Prefer lowered bodies (instr_count>0) over import stubs; fall back to the
// callee symbol at the current fn_id when the call's name is empty.
//
// A8 fix: the previous entry point (`ir_module_resolve_one_call_target`) took
// `instr: IrInstr` BY VALUE. IrInstr is a
// large struct carrying a `Box` (call_args); under lean_single, passing it by value
// miscompiles the copy and corrupts the CALLER's `ins` local (dst/src1/call_args all
// scramble), which was then written back — SIGSEGV in cross-module forwarding fns
// (`var r = zero(k); r.c[i]=1; return r`). Passing only the scalar fn_id + fixed-size
// Name avoids the large-struct/Box by-value copy entirely.
fn ir_module_resolve_call_target_fields(module: &IrModule, old_id: i64, instr_name: Name) -> i64 with Mut, Div, Panic {
    var resolve_name = instr_name
    if resolve_name.len == 0 && old_id >= 0 && old_id < (*module).fn_count {
        resolve_name = (*module).functions[old_id as usize].name
    }
    if resolve_name.len > 0 {
        let new_id = ir_merge_find_function_name_index(module, resolve_name)
        if new_id >= 0 && (*module).functions[new_id as usize].instr_count > 0 {
            return new_id
        }
    }
    // Remap calls that still point at import stubs (ic=0) even when name-based
    // lookup above failed — duplicate symbols can leave stale low fn_ids.
    if old_id >= 0 && old_id < (*module).fn_count {
        if (*module).functions[old_id as usize].instr_count == 0 {
            let stub_name = (*module).functions[old_id as usize].name
            let new_id = ir_merge_find_function_name_index(module, stub_name)
            if new_id >= 0 && new_id != old_id && (*module).functions[new_id as usize].instr_count > 0 {
                return new_id
            }
        }
    }
    old_id
}

// After multimodule merge, rebind every direct IrCall/IrCallSret to the merged
// module's canonical fn_id for instr.name. Prefer lowered bodies over import stubs.
fn ir_module_resolve_all_call_targets(module: &! IrModule) with Mut, Div, Panic {
    var fi: i64 = 0
    while fi < (*module).fn_count {
        var f = (*module).functions[fi as usize]
        var changed: bool = false
        var ii: i64 = 0
        while ii < f.instr_count {
            let op = f.instrs[ii as usize].op
            if op == IrOpcode::IrCall || op == IrOpcode::IrCallSret {
                let cur_fn = f.instrs[ii as usize].fn_id
                let cur_nm = f.instrs[ii as usize].name
                var new_fn = cur_fn
                if cur_nm.len > 0 && native_v2_builtin_id_for_name(cur_nm) != 0 {
                    let builtin_fn = ir_merge_find_function_name_index(module, cur_nm)
                    if builtin_fn >= 0 { new_fn = builtin_fn }
                } else {
                    new_fn = ir_module_resolve_call_target_fields(module, cur_fn, cur_nm)
                }
                if new_fn != cur_fn {
                    f.instrs[ii as usize].fn_id = new_fn
                    changed = true
                }
            }
            ii = ii + 1
        }
        if changed { (*module).functions[fi as usize] = f }
        fi = fi + 1
    }
}

fn ir_module_dump_find_name(module: &IrModule, label: Name, sym: Name) with IO, Mut, Div, Panic {
    let idx = ir_merge_find_function_name_index(module, sym)
    print("MERGE_DUMP: find(")
    print(str_from_bytes(label.buf, label.len))
    print(")=")
    print_int(idx)
    if idx >= 0 && idx < (*module).fn_count {
        print(" ic=")
        print_int((*module).functions[idx as usize].instr_count)
    }
    print("\n")
}

fn ir_module_dump_instr_op_tag(op: IrOpcode) -> i64 with Mut, Panic, Div {
    // Use IrOpcode enum discriminants (not serialize wire tags).
    if op == IrOpcode::IrLoadImm { return 0 }
    if op == IrOpcode::IrLoadFloat { return 1 }
    if op == IrOpcode::IrIntToFloat { return 2 }
    if op == IrOpcode::IrFloatToInt { return 3 }
    if op == IrOpcode::IrLoadBool { return 4 }
    if op == IrOpcode::IrLoadString { return 5 }
    if op == IrOpcode::IrCopy { return 6 }
    if op == IrOpcode::IrBinOp { return 7 }
    if op == IrOpcode::IrUnaryOp { return 8 }
    if op == IrOpcode::IrCall { return 9 }
    if op == IrOpcode::IrReturn { return 10 }
    if op == IrOpcode::IrJump { return 11 }
    if op == IrOpcode::IrBranchTrue { return 12 }
    if op == IrOpcode::IrBranchFalse { return 13 }
    if op == IrOpcode::IrFieldGet { return 14 }
    if op == IrOpcode::IrFieldSet { return 15 }
    if op == IrOpcode::IrIndexGet { return 16 }
    if op == IrOpcode::IrIndexSet { return 17 }
    if op == IrOpcode::IrAlloc { return 18 }
    if op == IrOpcode::IrLabel { return 19 }
    if op == IrOpcode::IrNop { return 20 }
    if op == IrOpcode::IrCallSret { return 35 }
    if op == IrOpcode::IrReturnSret { return 36 }
    if op == IrOpcode::IrCallExtern { return 40 }
    if op == IrOpcode::IrCallIndirect { return 41 }
    99
}

fn ir_module_dump_fn_body(module: &IrModule, fn_index: i64, label: string) with IO, Mut, Div, Panic {
    if fn_index < 0 || fn_index >= (*module).fn_count { return }
    print("MERGE_DUMP: body ")
    print(label)
    print(" fn=")
    print_int(fn_index)
    print(" name=")
    print(str_from_bytes((*module).functions[fn_index as usize].name.buf, (*module).functions[fn_index as usize].name.len))
    print(" ic=")
    print_int((*module).functions[fn_index as usize].instr_count)
    print("\n")
    var ii: i64 = 0
    while ii < (*module).functions[fn_index as usize].instr_count {
        let ins = (*module).functions[fn_index as usize].instrs[ii as usize]
        let tag = ir_module_dump_instr_op_tag(ins.op)
        print("  ii=")
        print_int(ii)
        print(" tag=")
        print_int(tag)
        if tag > 0 {
            print(" dst=")
            print_int(ins.dst)
            print(" src1=")
            print_int(ins.src1)
            print(" src2=")
            print_int(ins.src2)
            print(" field=")
            print_int(ins.field_idx)
            print(" label=")
            print_int(ins.label_id)
            print(" fn_id=")
            print_int(ins.fn_id)
            if ins.op == IrOpcode::IrCall || ins.op == IrOpcode::IrCallSret {
                print(" name=")
                print(str_from_bytes(ins.name.buf, ins.name.len))
            }
        }
        print("\n")
        ii = ii + 1
    }
}

fn ir_diag_opcode_tag(op: IrOpcode) -> i64 {
    if op == IrOpcode::IrLoadImm { 0 }
    else if op == IrOpcode::IrCopy { 4 }
    else if op == IrOpcode::IrBinOp { 5 }
    else if op == IrOpcode::IrCall { 7 }
    else if op == IrOpcode::IrReturn { 8 }
    else if op == IrOpcode::IrFieldGet { 12 }
    else if op == IrOpcode::IrFieldSet { 13 }
    else if op == IrOpcode::IrIndexGet { 14 }
    else if op == IrOpcode::IrIndexSet { 15 }
    else if op == IrOpcode::IrAlloc { 16 }
    else if op == IrOpcode::IrCallSret { 40 }
    else if op == IrOpcode::IrReturnSret { 41 }
    else { 99 }
}

fn ir_module_dump_all_calls_diag(module: &IrModule) with IO, Mut, Div, Panic {
    print("DUMPALL fn_count=")
    print_int((*module).fn_count)
    print("\n")
    var fi: i64 = 0
    while fi < (*module).fn_count {
        let fname = (*module).functions[fi as usize].name
        print("DUMPFN idx ")
        print_int(fi)
        print(" ic ")
        print_int((*module).functions[fi as usize].instr_count)
        print(" NM=[")
        print(str_from_bytes(fname.buf, fname.len))
        print("]\n")
        let ficnt = (*module).functions[fi as usize].instr_count
        if ficnt > 0 && ficnt < 40 {
            var ii: i64 = 0
            while ii < ficnt {
                let ins = (*module).functions[fi as usize].instrs[ii as usize]
                // one print_int per line (compiler print_int appends \n).
                print("Dq i=")
                print_int(ii)
                print("Dq op=")
                print_int(ir_diag_opcode_tag(ins.op))
                print("Dq dst=")
                print_int(ins.dst)
                print("Dq s1=")
                print_int(ins.src1)
                print("Dq s2=")
                print_int(ins.src2)
                print("Dq fi=")
                print_int(ins.field_idx)
                print("Dq ac=")
                print_int(ins.arg_count)
                print("Dq imm=")
                print_int(ins.imm_i64)
                print("Dq fn=")
                print_int(ins.fn_id)
                var cur_args = &ins.call_args
                var guard: i64 = 0
                while guard < 8 {
                    match *cur_args {
                        Some(rl) => {
                            print("Dq arg=")
                            print_int((*rl).head)
                            cur_args = &(*rl).tail
                            guard = guard + 1
                        }
                        None => { guard = 8 }
                    }
                }
                ii = ii + 1
            }
        }
        fi = fi + 1
    }
}

fn ir_module_dump_merge_calls(module: &IrModule) with IO, Mut, Div, Panic {
    print("MERGE_DUMP: fn_count=")
    print_int((*module).fn_count)
    print("\n")
    let watch_pb = make_name("pb_vacuous")
    let watch_pred = make_name("predict_cmin_knightian")
    let watch_main = make_name("main")
    ir_module_dump_find_name(module, make_name("pb_vacuous"), watch_pb)
    ir_module_dump_find_name(module, make_name("pb_new"), make_name("pb_new"))
    ir_module_dump_find_name(module, make_name("pb_lo_mean"), make_name("pb_lo_mean"))
    ir_module_dump_find_name(module, make_name("vp_vc_to_pbox"), make_name("vp_vc_to_pbox"))
    ir_module_dump_find_name(module, make_name("vp_default"), make_name("vp_default"))
    var fi: i64 = 0
    while fi < (*module).fn_count {
        let fname = (*module).functions[fi as usize].name
        if ir_name_eq(fname, watch_pb) || ir_name_eq(fname, watch_pred) || ir_name_eq(fname, watch_main)
            || ir_name_eq(fname, make_name("pb_new")) || ir_name_eq(fname, make_name("pb_lo_mean"))
            || ir_name_eq(fname, make_name("vp_vc_to_pbox")) || ir_name_eq(fname, make_name("vp_default")) {
            print("MERGE_DUMP: sym[")
            print_int(fi)
            print("] ")
            print(str_from_bytes(fname.buf, fname.len))
            print(" ic=")
            print_int((*module).functions[fi as usize].instr_count)
            print("\n")
        }
        fi = fi + 1
    }
    var vfi: i64 = 0
    while vfi < (*module).fn_count {
        if ir_name_eq((*module).functions[vfi as usize].name, make_name("vp_vc_to_pbox")) {
            if (*module).functions[vfi as usize].instr_count > 0 {
                print("MERGE_DUMP: vp_vc_to_pbox calls\n")
                var ii: i64 = 0
                while ii < (*module).functions[vfi as usize].instr_count {
                    let ins = (*module).functions[vfi as usize].instrs[ii as usize]
                    if ins.op == IrOpcode::IrCall || ins.op == IrOpcode::IrCallSret {
                        print("  call ii=")
                        print_int(ii)
                        print(" fn_id=")
                        print_int(ins.fn_id)
                        print(" name=")
                        print(str_from_bytes(ins.name.buf, ins.name.len))
                        if ins.fn_id >= 0 && ins.fn_id < (*module).fn_count {
                            print(" ->")
                            print(str_from_bytes((*module).functions[ins.fn_id as usize].name.buf, (*module).functions[ins.fn_id as usize].name.len))
                            print(" ic=")
                            print_int((*module).functions[ins.fn_id as usize].instr_count)
                        }
                        print("\n")
                    }
                    ii = ii + 1
                }
            }
        }
        vfi = vfi + 1
    }
    var pfi: i64 = 0
    while pfi < (*module).fn_count {
        if ir_name_eq((*module).functions[pfi as usize].name, watch_pred) {
            print("MERGE_DUMP: predict calls/returns\n")
            var ii: i64 = 0
            while ii < (*module).functions[pfi as usize].instr_count {
                let ins = (*module).functions[pfi as usize].instrs[ii as usize]
                if ins.op == IrOpcode::IrCall || ins.op == IrOpcode::IrCallSret {
                    print("  call ii=")
                    print_int(ii)
                    print(" fn_id=")
                    print_int(ins.fn_id)
                    print(" name=")
                    print(str_from_bytes(ins.name.buf, ins.name.len))
                    if ins.fn_id >= 0 && ins.fn_id < (*module).fn_count {
                        print(" ->")
                        print(str_from_bytes((*module).functions[ins.fn_id as usize].name.buf, (*module).functions[ins.fn_id as usize].name.len))
                        print(" ic=")
                        print_int((*module).functions[ins.fn_id as usize].instr_count)
                    }
                    print("\n")
                } else if ins.op == IrOpcode::IrReturn {
                    print("  return ii=")
                    print_int(ii)
                    print(" reg=")
                    print_int(ins.src1)
                    print("\n")
                }
                ii = ii + 1
            }
        }
        pfi = pfi + 1
    }
    // User main is the smallest `main` body (lowest instr_count) — merged modules
    // and debug helpers can append larger `main` stubs later in fn_id space.
    var user_main: i64 = 0 - 1
    var user_main_ic: i64 = 1000000000
    var mfi: i64 = 0
    while mfi < (*module).fn_count {
        if ir_name_eq((*module).functions[mfi as usize].name, watch_main) {
            let mic = (*module).functions[mfi as usize].instr_count
            if mic > 0 && mic < user_main_ic {
                user_main = mfi
                user_main_ic = mic
            }
        }
        mfi = mfi + 1
    }
    if user_main >= 0 {
        print("MERGE_DUMP: user_main_idx=")
        print_int(user_main)
        print(" ic=")
        print_int((*module).functions[user_main as usize].instr_count)
        print("\n")
        print("MERGE_DUMP: user_main calls\n")
        var ii: i64 = 0
        while ii < (*module).functions[user_main as usize].instr_count {
            let ins = (*module).functions[user_main as usize].instrs[ii as usize]
            if ins.op == IrOpcode::IrCall || ins.op == IrOpcode::IrCallSret {
                print("  call ii=")
                print_int(ii)
                print(" fn_id=")
                print_int(ins.fn_id)
                print(" name=")
                print(str_from_bytes(ins.name.buf, ins.name.len))
                if ins.fn_id >= 0 && ins.fn_id < (*module).fn_count {
                    print(" ->")
                    print(str_from_bytes((*module).functions[ins.fn_id as usize].name.buf, (*module).functions[ins.fn_id as usize].name.len))
                    print(" ic=")
                    print_int((*module).functions[ins.fn_id as usize].instr_count)
                }
                print("\n")
            }
            ii = ii + 1
        }
        ir_module_dump_fn_body(module, user_main, "user_main")
        let pb_conf_idx = ir_merge_find_function_name_index(module, make_name("pb_confidence"))
        if pb_conf_idx >= 0 {
            ir_module_dump_fn_body(module, pb_conf_idx, "pb_confidence")
        }
        let pb_lo_idx = ir_merge_find_function_name_index(module, make_name("pb_lo_mean"))
        if pb_lo_idx >= 0 {
            ir_module_dump_fn_body(module, pb_lo_idx, "pb_lo_mean")
        }
    }
}

// Map a fn_id to the merged module's canonical index for its symbol name.
// Prefer lowered bodies (instr_count>0) over import stubs.
fn ir_module_canonical_fn_id_for_index(module: &IrModule, fn_id: i64) -> i64 with Mut, Div, Panic {
    if fn_id < 0 || fn_id >= (*module).fn_count {
        return fn_id
    }
    let sym_name = (*module).functions[fn_id as usize].name
    if sym_name.len == 0 {
        return fn_id
    }
    let canon = ir_merge_find_function_name_index(module, sym_name)
    if canon >= 0 {
        return canon
    }
    fn_id
}

// Rewrite fn refs via whole-function writeback; nested instr writes are dropped by lean_single.
fn ir_module_compact_duplicate_fn_refs(module: IrModule) -> IrModule with Mut, Div, Panic {
    var out = module
    var pass: i64 = 0
    while pass < 2 {
        var fi: i64 = 0
        while fi < out.fn_count {
            var f = out.functions[fi as usize]
            var changed: bool = false
            var ii: i64 = 0
            while ii < f.instr_count {
                if ir_merge_is_direct_fn_ref_opcode(f.instrs[ii as usize].op) {
                    let old_id = f.instrs[ii as usize].fn_id
                    let nm = f.instrs[ii as usize].name
                    var canon: i64 = old_id
                    if nm.len > 0 {
                        let by_name = ir_merge_find_function_name_index(&out, nm)
                        if by_name >= 0 && out.functions[by_name as usize].instr_count > 0 {
                            canon = by_name
                        }
                    } else if old_id >= 0 {
                        canon = ir_module_canonical_fn_id_for_index(&out, old_id)
                    }
                    if canon >= 0
                        && canon < out.fn_count
                        && out.functions[canon as usize].instr_count > 0
                        && canon != old_id {
                        f.instrs[ii as usize].fn_id = canon
                        changed = true
                    }
                }
                ii = ii + 1
            }
            if changed {
                out.functions[fi as usize] = f
            }
            fi = fi + 1
        }
        pass = pass + 1
    }
    out
}

// Deep-copy an IrFunction so lean_single struct assignment does not alias instr slots.
fn ir_function_deep_copy(func: IrFunction) -> IrFunction with Mut, Panic, Div {
    var out = func
    var ii: i64 = 0
    while ii < func.instr_count && ii < IR_MAX_INSTRS {
        out.instrs[ii as usize] = func.instrs[ii as usize]
        ii = ii + 1
    }
    out
}

// When merge leaves import stubs (ic=0) alongside lowered duplicates at higher
// fn_id, copy the canonical body into the stub slot so codegen fn_offsets for
// stale low indices still reach real implementations.
fn ir_module_promote_canonical_into_stub_slots(module: IrModule) -> IrModule with Mut, Div, Panic {
    var out = module
    var fi: i64 = 0
    while fi < out.fn_count {
        if out.functions[fi as usize].instr_count == 0 {
            let sym_name = out.functions[fi as usize].name
            if sym_name.len > 0 {
                let canon = ir_merge_find_function_name_index(&out, sym_name)
                if canon >= 0 && canon != fi && out.functions[canon as usize].instr_count > 0 {
                    out.functions[fi as usize] = ir_function_deep_copy(out.functions[canon as usize])
                }
            }
        }
        fi = fi + 1
    }
    out
}

// Materialize merged IR, resolve call targets on an owned IrModule (not through
// &! Box<IrModule> — lean_single drops those writes), and return the finalized module.
// Ensure every call to a BUILTIN name (str_char_at, str_len, str_from_bytes, ...)
// points at a slot bearing that name so codegen emits the builtin body. Builtins
// carry no IR body (instr_count==0, synthesized at codegen), so the normal name
// resolver — which only accepts targets with instr_count>0 — never binds them. A
// builtin referenced ONLY transitively (an imported fn's body calls it, the root
// module never does) is also absent from the merged module entirely. Append a
// named stub when missing and rebind the call. Whole-function writeback per A14.
fn ir_module_ensure_builtin_call_targets(module: IrModule) -> IrModule with Mut, Div, Panic {
    var out = module
    var fi: i64 = 0
    while fi < out.fn_count {
        var f = out.functions[fi as usize]
        var changed: bool = false
        var ii: i64 = 0
        while ii < f.instr_count {
            let op = f.instrs[ii as usize].op
            if op == IrOpcode::IrCall || op == IrOpcode::IrCallSret {
                let cn = f.instrs[ii as usize].name
                if cn.len > 0 && native_v2_builtin_id_for_name(cn) != 0 {
                    let cur = f.instrs[ii as usize].fn_id
                    var ok: bool = false
                    if cur >= 0 && cur < out.fn_count {
                        if ir_name_eq(out.functions[cur as usize].name, cn) { ok = true }
                    }
                    if !ok {
                        var target = ir_merge_find_function_name_index(&out, cn)
                        if target < 0 && out.fn_count < IR_MAX_FUNCS {
                            var stub = ir_empty_function()
                            stub.name = cn
                            out.functions[out.fn_count as usize] = stub
                            target = out.fn_count
                            out.fn_count = out.fn_count + 1
                        }
                        if target >= 0 {
                            f.instrs[ii as usize].fn_id = target
                            changed = true
                        }
                    }
                }
            }
            ii = ii + 1
        }
        if changed { out.functions[fi as usize] = f }
        fi = fi + 1
    }
    out
}

fn ir_module_finalize_merged_calls(module: IrModule) -> IrModule with Mut, Div, Panic {
    var out = module
    ir_module_resolve_named_calls(&! out)
    // Promote before compaction so import stubs at low fn_id gain bodies while
    // seed main still references those indices.
    out = ir_module_promote_canonical_into_stub_slots(out)
    out = ir_module_compact_duplicate_fn_refs(out)
    out = ir_module_promote_canonical_into_stub_slots(out)
    // Two passes after promotion: duplicate import stubs (ic=0) can alias lowered
    // bodies under the same name at higher fn_id; promotion fills stub slots first.
    var pass: i64 = 0
    while pass < 2 {
        var fi: i64 = 0
        while fi < out.fn_count {
            // A14: whole-function copy/writeback (see ir_module_compact_duplicate_fn_refs)
            // — nested `out.functions[fi].instrs[ii].fn_id=v` writes are dropped.
            var f = out.functions[fi as usize]
            var changed: bool = false
            var ii: i64 = 0
            while ii < f.instr_count {
                let op = f.instrs[ii as usize].op
                if op == IrOpcode::IrCall || op == IrOpcode::IrCallSret || op == IrOpcode::IrLoadFnRef {
                    let cur_fn = f.instrs[ii as usize].fn_id
                    let cur_nm = f.instrs[ii as usize].name
                    let new_id = ir_module_resolve_call_target_fields(&out, cur_fn, cur_nm)
                    if new_id != cur_fn {
                        f.instrs[ii as usize].fn_id = new_id
                        changed = true
                    }
                }
                ii = ii + 1
            }
            if changed {
                out.functions[fi as usize] = f
            }
            fi = fi + 1
        }
        pass = pass + 1
    }
    out = ir_module_ensure_builtin_call_targets(out)
    out
}

// Reinstall seed user main after finalize: owned-module finalize passes can clobber
// fn=0 under the lean_single JIT. Stub slots are already promoted; keep seed fn_ids.
fn ir_module_restore_user_main_calls(module: IrModule, user_main: IrFunction) -> IrModule with Mut, Div, Panic {
    var out = module
    if out.fn_count <= 0 {
        return out
    }
    var slot = out.functions[0 as usize]
    slot.name = user_main.name
    slot.instr_count = user_main.instr_count
    slot.reg_count = user_main.reg_count
    slot.label_count = user_main.label_count
    slot.param_count = user_main.param_count
    slot.compile_strategy = user_main.compile_strategy
    slot.returns_float = user_main.returns_float
    slot.return_struct_name = user_main.return_struct_name
    slot.prof_counter_id = user_main.prof_counter_id
    slot.hyper_algebra_kind = user_main.hyper_algebra_kind
    slot.is_sret = user_main.is_sret
    slot.sret_dest_reg = user_main.sret_dest_reg
    slot.bss_size = user_main.bss_size
    var pi: i64 = 0
    while pi < user_main.param_count && pi < IR_MAX_PARAMS {
        slot.param_regs[pi as usize] = user_main.param_regs[pi as usize]
        pi = pi + 1
    }
    var ii: i64 = 0
    while ii < user_main.instr_count && ii < IR_MAX_INSTRS {
        var ins = user_main.instrs[ii as usize]
        if (ins.op == IrOpcode::IrCall || ins.op == IrOpcode::IrCallSret) && ins.fn_id >= 0 && ins.fn_id < out.fn_count {
            if out.functions[ins.fn_id as usize].returns_float == 1 {
                ins.imm_flags = IR_FLOAT_REG_MARKER_FLAG
            }
        }
        slot.instrs[ii as usize] = ins
        ii = ii + 1
    }
    out.functions[0 as usize] = slot
    out
}

// Resolve fn_id=-1 named calls (cross-module calls emitted by module_frontend_ir_named_call)
// to their position in the merged module. Operates through &! to avoid large-local JIT writes.
fn ir_module_resolve_named_calls(module: &! IrModule) with Mut, Div, Panic {
    var fi: i64 = 0
    while fi < (*module).fn_count {
        var ii: i64 = 0
        while ii < (*module).functions[fi as usize].instr_count {
            let call_op = (*module).functions[fi as usize].instrs[ii as usize].op
            if (call_op == IrOpcode::IrCall || call_op == IrOpcode::IrCallSret)
                && (*module).functions[fi as usize].instrs[ii as usize].fn_id < 0 {
                let call_name = (*module).functions[fi as usize].instrs[ii as usize].name
                if call_name.len > 0 {
                    let found_ji = ir_merge_find_function_name_index(module, call_name)
                    if found_ji >= 0 {
                        (*module).functions[fi as usize].instrs[ii as usize].fn_id = found_ji
                    }
                }
            }
            ii = ii + 1
        }
        fi = fi + 1
    }
}

fn ir_merge_algebra_tables(dst: IrAlgebraTable, src: IrAlgebraTable) -> IrAlgebraTable with Mut, Panic, Div {
    var merged = dst
    var si: i64 = 0
    while si < src.count && merged.count < 32 {
        let candidate = src.entries[si]
        if candidate.is_valid {
            var exists: bool = false
            var di: i64 = 0
            while di < merged.count {
                let entry = merged.entries[di]
                if entry.is_valid && entry.algebra_tag == candidate.algebra_tag && ir_name_eq(entry.name, candidate.name) {
                    exists = true
                    di = merged.count
                } else {
                    di = di + 1
                }
            }
            if exists == false {
                merged.entries[merged.count as usize] = candidate
                merged.count = merged.count + 1
            }
        }
        si = si + 1
    }
    merged
}

fn ir_epistemic_section_is_empty(epistemic: IrEpistemicSection) -> bool {
    epistemic.model_family_count == 0 &&
    epistemic.policy_count == 0 &&
    epistemic.decision_policy_count == 0 &&
    epistemic.deferral_policy_count == 0 &&
    epistemic.acquisition_policy_count == 0 &&
    epistemic.recourse_policy_count == 0 &&
    epistemic.validation_count == 0 &&
    epistemic.mechanistic_report_count == 0 &&
    epistemic.posterior_weights_count == 0 &&
    epistemic.counterexample_count == 0 &&
    epistemic.audit_count == 0 &&
    epistemic.contest_count == 0 &&
    epistemic.contest_witness_count == 0 &&
    epistemic.robust_proof_count == 0 &&
    epistemic.decision_certificate_count == 0 &&
    epistemic.deferred_certificate_count == 0 &&
    epistemic.deferred_reason_witness_count == 0 &&
    epistemic.acquisition_plan_count == 0 &&
    epistemic.acquisition_reason_witness_count == 0 &&
    epistemic.recourse_plan_count == 0 &&
    epistemic.recourse_reason_witness_count == 0 &&
    epistemic.alternative_policy_count == 0 &&
    epistemic.alternative_frontier_count == 0 &&
    epistemic.alternative_candidate_count == 0 &&
    epistemic.alternative_set_count == 0 &&
    epistemic.alternative_reason_witness_count == 0 &&
    epistemic.transition_policy_count == 0 &&
    epistemic.transition_protocol_count == 0 &&
    epistemic.transition_step_count == 0 &&
    epistemic.transition_plan_count == 0 &&
    epistemic.transition_reason_witness_count == 0 &&
    epistemic.monitoring_policy_count == 0 &&
    epistemic.observed_transition_count == 0 &&
    epistemic.rollback_certificate_count == 0 &&
    epistemic.validated_manifest_count == 0
}

// ============================================================
// Visited-set helpers for transitive import resolution
// ============================================================

fn visited_contains(visited: [string; 256], count: i64, path: string) -> bool with Mut, Panic, Div {
    var j: i64 = 0
    while j < count {
        if str_eq(visited[j], path) {
            return true
        }
        j = j + 1
    }
    false
}

// Caller-owned AST closure shared by visibility checking and boundary reports.
// Missing imports and capacity saturation are data, never implicit success.
pub struct ModuleClosure {
    pub paths: [string; 256],
    pub logical_paths: [string; 256],
    pub edge_callers: [string; 512],
    pub edge_dependencies: [string; 512],
    pub edge_imports: [string; 512],
    pub edge_caller_ids: [i64; 512],
    pub edge_dependency_ids: [i64; 512],
    pub unresolved_callers: [string; 256],
    pub unresolved_imports: [string; 256],
    pub ambiguous_callers: [string; 256],
    pub ambiguous_imports: [string; 256],
    pub surface_error_callers: [string; 256],
    pub surface_error_imports: [string; 256],
    pub surface_error_names: [string; 256],
    pub node_count: i64,
    pub edge_count: i64,
    pub unresolved_count: i64,
    pub ambiguity_count: i64,
    pub surface_error_count: i64,
    pub saturated: bool,
    pub parse_failed: bool,
}

fn module_frontend_trace_full_ir_closure(closure: &ModuleClosure) with IO, Mut, Panic, Div {
    if !module_frontend_lower_trace_enabled() {
        return
    }
    var i: i64 = 0
    while i < (*closure).node_count {
        print("module_frontend_full_ir: lower_node module_id=")
        print(io_trace_i64_string(i))
        print(" logical=")
        print((*closure).logical_paths[i])
        print(" physical=")
        println((*closure).paths[i])
        i = i + 1
    }
    i = 0
    while i < (*closure).edge_count {
        print("module_frontend_full_ir: lower_edge caller_id=")
        print(io_trace_i64_string((*closure).edge_caller_ids[i]))
        print(" dependency_id=")
        print(io_trace_i64_string((*closure).edge_dependency_ids[i]))
        print(" import=")
        println((*closure).edge_imports[i])
        i = i + 1
    }
}

fn module_frontend_closure_node_index(
    closure: &ModuleClosure,
    path: string,
) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < (*closure).node_count {
        if str_eq((*closure).paths[i], path) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn module_frontend_closure_edge_index(
    closure: &ModuleClosure,
    caller_id: i64,
    requested_import: string,
) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < (*closure).edge_count {
        if (*closure).edge_caller_ids[i] == caller_id &&
           str_eq((*closure).edge_imports[i], requested_import) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn module_frontend_import_items_contain_name(
    items: Option<Box<ImportItemList>>,
    name: Name,
) -> bool with Mut, Panic, Div, Alloc {
    var cursor = items
    while true {
        match cursor {
            Some(node) => {
                if name_eq((*node).head, name) {
                    return true
                }
                cursor = (*node).tail
            }
            None => return false
        }
    }
    false
}

fn module_frontend_variant_list_contains_name(
    variants: Option<Box<VariantDefList>>,
    name: Name,
) -> bool with Mut, Panic, Div, Alloc {
    var cursor = variants
    while true {
        match cursor {
            Some(node) => {
                if name_eq((*node).head.name, name) {
                    return true
                }
                cursor = (*node).tail
            }
            None => return false
        }
    }
    false
}

fn module_frontend_item_directly_exports_name(
    item: Item,
    name: Name,
) -> bool with Mut, Panic, Div, Alloc {
    if !visibility_to_bool(item.visibility) {
        return false
    }
    if item.kind == ItemKind::ItemUse || item.kind == ItemKind::ItemImpl {
        return false
    }
    if item.name.len > 0 && name_eq(item.name, name) {
        return true
    }
    if item.kind == ItemKind::ItemEnum {
        match item.enum_def {
            Some(enum_def) => return module_frontend_variant_list_contains_name((*enum_def).variants, name)
            None => {}
        }
    }
    false
}

fn module_frontend_module_exports_name(
    closure: &ModuleClosure,
    programs: &! [Program; 256],
    module_id: i64,
    name: Name,
    visited: &! [bool; 256],
) -> bool with Mut, Panic, Div, Alloc {
    if module_id < 0 || module_id >= (*closure).node_count || module_id >= 256 {
        return false
    }
    if (*visited)[module_id] {
        return false
    }
    (*visited)[module_id] = true

    var found = false
    var cursor = (*programs)[module_id].items
    while !found {
        match cursor {
            Some(node) => {
                let item = (*node).head
                if module_frontend_item_directly_exports_name(item, name) {
                    found = true
                } else if item.kind == ItemKind::ItemUse && visibility_to_bool(item.visibility) {
                    let requested_import = use_path_to_string(item.use_path)
                    let edge_index = module_frontend_closure_edge_index(closure, module_id, requested_import)
                    if edge_index >= 0 {
                        let dependency_id = (*closure).edge_dependency_ids[edge_index]
                        let reexports_name = item.use_glob ||
                            module_frontend_import_items_contain_name(item.use_items, name)
                        if reexports_name && module_frontend_module_exports_name(
                            closure,
                            programs,
                            dependency_id,
                            name,
                            visited,
                        ) {
                            found = true
                        }
                    }
                }
                cursor = (*node).tail
            }
            None => break
        }
    }

    (*visited)[module_id] = false
    found
}

fn module_frontend_record_surface_error(
    closure: &!ModuleClosure,
    caller_path: string,
    requested_import: string,
    name: Name,
) with Mut, Panic {
    if (*closure).surface_error_count >= 256 {
        (*closure).saturated = true
        return
    }
    let index = (*closure).surface_error_count
    (*closure).surface_error_callers[index] = caller_path
    (*closure).surface_error_imports[index] = requested_import
    (*closure).surface_error_names[index] = str_from_bytes(name.buf, name.len)
    (*closure).surface_error_count = index + 1
}

// A facade-only module has authored imports but no named implementation item of
// its own. This bounded vertical validates facade surfaces without redefining
// the compiler's existing crate-private import semantics (#854).
fn module_frontend_program_is_facade(program: Program) -> bool with Alloc {
    var has_import = false
    var has_named_item = false
    var cursor = program.items
    while true {
        match cursor {
            Some(node) => {
                let item = (*node).head
                if item.kind == ItemKind::ItemUse {
                    has_import = true
                } else if item.name.len > 0 {
                    has_named_item = true
                }
                cursor = (*node).tail
            }
            None => break
        }
    }
    has_import && !has_named_item
}

fn module_frontend_validate_import_item_names(
    closure: &!ModuleClosure,
    programs: &! [Program; 256],
    caller_id: i64,
    dependency_id: i64,
    requested_import: string,
    items: Option<Box<ImportItemList>>,
) with Mut, Panic, Div, Alloc {
    var cursor = items
    while true {
        match cursor {
            Some(node) => {
                let name = (*node).head
                var visited: [bool; 256] = [false; 256]
                if !module_frontend_module_exports_name(
                    &(*closure),
                    programs,
                    dependency_id,
                    name,
                    &!visited,
                ) {
                    module_frontend_record_surface_error(
                        closure,
                        (*closure).paths[caller_id],
                        requested_import,
                        name,
                    )
                }
                cursor = (*node).tail
            }
            None => break
        }
    }
}

fn module_frontend_validate_import_surfaces(
    closure: &!ModuleClosure,
    programs: &! [Program; 256],
) with Mut, Panic, Div, Alloc {
    (*closure).surface_error_count = 0
    var module_id: i64 = 0
    while module_id < (*closure).node_count {
        var cursor = (*programs)[module_id].items
        while true {
            match cursor {
                Some(node) => {
                    let item = (*node).head
                    if item.kind == ItemKind::ItemUse {
                        let requested_import = use_path_to_string(item.use_path)
                        let edge_index = module_frontend_closure_edge_index(
                            &(*closure),
                            module_id,
                            requested_import,
                        )
                        if edge_index >= 0 {
                            let dependency_id = (*closure).edge_dependency_ids[edge_index]
                            let caller_is_facade = module_frontend_program_is_facade((*programs)[module_id])
                            let dependency_is_facade = dependency_id >= 0 &&
                                module_frontend_program_is_facade((*programs)[dependency_id])
                            let validates_public_facade_edge = caller_is_facade &&
                                visibility_to_bool(item.visibility)
                            if dependency_id >= 0 &&
                               (dependency_is_facade || validates_public_facade_edge) {
                                module_frontend_validate_import_item_names(
                                    closure,
                                    programs,
                                    module_id,
                                    dependency_id,
                                    requested_import,
                                    item.use_items,
                                )
                            }
                        }
                    }
                    cursor = (*node).tail
                }
                None => break
            }
        }
        module_id = module_id + 1
    }
}

pub fn module_frontend_collect_ast_closure_programs_into(
    main_path: string,
    out: &!ModuleClosure,
    programs: &! [Program; 256],
) -> bool with IO, Mut, Panic, Div, Alloc {
    (*out).node_count = 0
    (*out).edge_count = 0
    (*out).unresolved_count = 0
    (*out).ambiguity_count = 0
    (*out).surface_error_count = 0
    (*out).saturated = false
    (*out).parse_failed = false

    parser_reset_last_errors()
    (*programs)[0] = load_module_file(main_path)
    if parser_last_error_count() > 0 {
        (*out).parse_failed = true
        return false
    }
    (*out).paths[0] = main_path
    (*out).logical_paths[0] = use_path_to_string((*programs)[0].module_path)
    (*out).node_count = 1

    var work_front: i64 = 0
    while work_front < (*out).node_count {
        let caller_path = (*out).paths[work_front]
        let cur_dir = module_frontend_path_directory_slice(caller_path)
        let work_prog = (*programs)[work_front]
        let imports = extract_imports_from_ast(work_prog)
        if imports.overflow {
            (*out).saturated = true
        }
        var i: i64 = 0
        while i < imports.count && !(*out).parse_failed {
            let requested_import = use_path_to_string(imports.paths[i])
            let resolution = resolve_import_file_path_result(imports.paths[i], cur_dir)
            let dependency_path = resolution.path
            var dependency_id: i64 = 0 - 1

            if resolution.ambiguous {
                if (*out).ambiguity_count < 256 {
                    let ambiguity_index = (*out).ambiguity_count
                    (*out).ambiguous_callers[ambiguity_index] = caller_path
                    (*out).ambiguous_imports[ambiguity_index] = requested_import
                    (*out).ambiguity_count = ambiguity_index + 1
                } else {
                    (*out).saturated = true
                }
            } else if !file_exists(dependency_path) {
                if (*out).unresolved_count < 256 {
                    let unresolved_index = (*out).unresolved_count
                    (*out).unresolved_callers[unresolved_index] = caller_path
                    (*out).unresolved_imports[unresolved_index] = requested_import
                    (*out).unresolved_count = unresolved_index + 1
                } else {
                    (*out).saturated = true
                }
            } else {
                dependency_id = module_frontend_closure_node_index(&(*out), dependency_path)
                if dependency_id < 0 {
                    if (*out).node_count >= 256 {
                        (*out).saturated = true
                    } else {
                        dependency_id = (*out).node_count
                        parser_reset_last_errors()
                        (*programs)[dependency_id] = load_module_file(dependency_path)
                        if parser_last_error_count() > 0 {
                            (*out).parse_failed = true
                        } else {
                            (*out).paths[dependency_id] = dependency_path
                            (*out).logical_paths[dependency_id] = use_path_to_string(
                                (*programs)[dependency_id].module_path
                            )
                            (*out).node_count = dependency_id + 1
                        }
                    }
                }
            }

            if (*out).edge_count < 512 {
                let edge_index = (*out).edge_count
                (*out).edge_callers[edge_index] = caller_path
                (*out).edge_dependencies[edge_index] = dependency_path
                (*out).edge_imports[edge_index] = requested_import
                (*out).edge_caller_ids[edge_index] = work_front
                (*out).edge_dependency_ids[edge_index] = dependency_id
                (*out).edge_count = edge_index + 1
            } else {
                (*out).saturated = true
            }
            i = i + 1
        }
        work_front = work_front + 1
    }
    let structurally_complete = !(*out).saturated &&
        !(*out).parse_failed &&
        (*out).unresolved_count == 0 &&
        (*out).ambiguity_count == 0
    if structurally_complete {
        module_frontend_validate_import_surfaces(out, programs)
    }
    // Closure topology and import-surface validity are independent evidence.
    // Callers must inspect surface_error_count before checking or lowering.
    structurally_complete
}

pub fn module_frontend_collect_ast_closure_into(
    main_path: string,
    out: &!ModuleClosure
) -> bool with IO, Mut, Panic, Div, Alloc {
    var programs: [Program; 256] = [mf_empty_program(); 256]
    module_frontend_collect_ast_closure_programs_into(main_path, out, &!programs)
}

pub struct ImportPathList {
    paths: [string; 256],
    count: i64,
}

fn import_path_list_empty() -> ImportPathList {
    ImportPathList {
        paths: [""; 256],
        count: 0,
    }
}

fn import_path_list_contains(imports: ImportPathList, path: string) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < imports.count {
        if str_eq(imports.paths[i], path) {
            return true
        }
        i = i + 1
    }
    false
}

fn module_frontend_import_is_use_at(data: string, pos: i64, size: i64) -> bool {
    if pos + 3 >= size {
        return false
    }
    if pos > 0 && data[(pos - 1) as usize] != (10 as i8) {
        return false
    }
    data[pos as usize] == (117 as i8) &&
    data[(pos + 1) as usize] == (115 as i8) &&
    data[(pos + 2) as usize] == (101 as i8) &&
    data[(pos + 3) as usize] == (32 as i8)
}

fn module_frontend_import_path_from_source(
    data: string,
    start: i64,
    size: i64,
    prefix: string
) -> string with Mut, Panic, Div {
    var buf: [i8; 512] = [0; 512]
    var pos: i64 = 0
    let prefix_len = str_len(prefix)
    var pi: i64 = 0
    while pi < prefix_len && pos < 490 {
        buf[pos as usize] = str_char_at(prefix, pi) as i8
        pos = pos + 1
        pi = pi + 1
    }
    if pos < 490 {
        buf[pos as usize] = 47 as i8
        pos = pos + 1
    }

    var i = start
    while i < size && data[i as usize] == (32 as i8) {
        i = i + 1
    }
    while i < size && pos < 500 {
        let ch = data[i as usize]
        if ch == (10 as i8) || ch == (13 as i8) || ch == (32 as i8) ||
           ch == (9 as i8) || ch == (59 as i8) || ch == (123 as i8) ||
           ch == (44 as i8) {
            break
        }
        if ch == (58 as i8) && i + 1 < size && data[(i + 1) as usize] == (58 as i8) {
            if i + 2 < size {
                let next = data[(i + 2) as usize]
                if next == (123 as i8) || next == (42 as i8) {
                    break
                }
            }
            buf[pos as usize] = 47 as i8
            pos = pos + 1
            i = i + 2
        } else {
            buf[pos as usize] = ch
            pos = pos + 1
            i = i + 1
        }
    }
    if pos < 508 {
        buf[pos as usize] = 46 as i8
        buf[(pos + 1) as usize] = 115 as i8
        buf[(pos + 2) as usize] = 105 as i8
        buf[(pos + 3) as usize] = 111 as i8
        pos = pos + 4
    }
    str_from_bytes(buf, pos)
}

pub fn module_frontend_import_files_from_source(path: string) -> ImportPathList with IO, Mut, Panic, Div {
    var imports = import_path_list_empty()
    let n = module_frontend_load_import_file(path)
    if n <= 0 {
        return imports
    }
    let cur_dir = module_frontend_path_directory_slice(path)
    var line_start: i64 = 0
    var i: i64 = 0
    while i <= n && imports.count < 256 {
        let at_end = i == n
        let ch = if at_end { 10 as i8 } else { MODULE_FRONTEND_IMPORT_FILE_DATA[i as usize] }
        if ch == (10 as i8) {
            let line_end = i
            var path_start: i64 = 0 - 1
            if line_end - line_start >= 4 &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[line_start as usize] == (117 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 1) as usize] == (115 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 2) as usize] == (101 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 3) as usize] == (32 as i8) {
                path_start = line_start + 4
            }
            if path_start < 0 &&
               line_end - line_start >= 8 &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[line_start as usize] == (112 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 1) as usize] == (117 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 2) as usize] == (98 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 3) as usize] == (32 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 4) as usize] == (117 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 5) as usize] == (115 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 6) as usize] == (101 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 7) as usize] == (32 as i8) {
                path_start = line_start + 8
            }
            if path_start < 0 &&
               line_end - line_start >= 7 &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[line_start as usize] == (105 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 1) as usize] == (109 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 2) as usize] == (112 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 3) as usize] == (111 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 4) as usize] == (114 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 5) as usize] == (116 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 6) as usize] == (32 as i8) {
                path_start = line_start + 7
            }

            if path_start >= 0 {
                let rel_path = module_frontend_extract_relpath_from_loaded(path_start, line_end)
                if str_len(rel_path) > 0 {
                    let dep_path = module_frontend_resolve_import_relpath(rel_path, cur_dir)
                    if file_exists(dep_path) && !import_path_list_contains(imports, dep_path) {
                        imports.paths[imports.count] = dep_path
                        imports.count = imports.count + 1
                    }
                }
            }
            line_start = i + 1
        }
        i = i + 1
    }
    imports
}

fn module_frontend_source_is_fn_at(data: string, pos: i64, size: i64) -> bool {
    if pos + 2 >= size {
        return false
    }
    if pos > 0 && data[(pos - 1) as usize] != (10 as i8) {
        return false
    }
    if data[pos as usize] == (102 as i8) &&
       data[(pos + 1) as usize] == (110 as i8) &&
       data[(pos + 2) as usize] == (32 as i8) {
        return true
    }
    if pos + 6 >= size {
        return false
    }
    data[pos as usize] == (112 as i8) &&
    data[(pos + 1) as usize] == (117 as i8) &&
    data[(pos + 2) as usize] == (98 as i8) &&
    data[(pos + 3) as usize] == (32 as i8) &&
    data[(pos + 4) as usize] == (102 as i8) &&
    data[(pos + 5) as usize] == (110 as i8) &&
    data[(pos + 6) as usize] == (32 as i8)
}

fn module_frontend_source_fn_name_start(data: string, fn_pos: i64, size: i64) -> i64 {
    if fn_pos + 6 < size &&
       data[fn_pos as usize] == (112 as i8) &&
       data[(fn_pos + 1) as usize] == (117 as i8) &&
       data[(fn_pos + 2) as usize] == (98 as i8) &&
       data[(fn_pos + 3) as usize] == (32 as i8) &&
       data[(fn_pos + 4) as usize] == (102 as i8) &&
       data[(fn_pos + 5) as usize] == (110 as i8) &&
       data[(fn_pos + 6) as usize] == (32 as i8) {
        return fn_pos + 7
    }
    fn_pos + 3
}

fn module_frontend_source_fn_name(data: string, start: i64, size: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 0 }
    var i = start
    while i < size && data[i as usize] == (32 as i8) {
        i = i + 1
    }
    while i < size && n.len < 128 {
        let ch = data[i as usize]
        if ch == (40 as i8) || ch == (32 as i8) || ch == (9 as i8) ||
           ch == (10 as i8) || ch == (13 as i8) {
            break
        }
        n.buf[n.len] = ch
        n.len = n.len + 1
        i = i + 1
    }
    n
}

fn module_frontend_source_skip_ws(data: string, start: i64, size: i64) -> i64 {
    var i = start
    while i < size {
        let ch = data[i as usize]
        if ch == (32 as i8) || ch == (9 as i8) || ch == (10 as i8) || ch == (13 as i8) {
            i = i + 1
        } else {
            return i
        }
    }
    i
}

// Skip optional "let name = " or "var name: T = " or "let name : T = " prefix to reach the rhs expression start.
// Used by the summary/simple body lower to recognize "let p = cd_mul(...)" style calls in test mains for imported modules.
fn module_frontend_source_skip_let_or_var_assign(data: string, start: i64, size: i64) -> i64 {
    var i = module_frontend_source_skip_ws(data, start, size)
    // check for let or var
    let is_let = (i + 3 < size) &&
        data[i as usize] == (108 as i8) && data[i+1 as usize] == (101 as i8) && data[i+2 as usize] == (116 as i8) && data[i+3 as usize] == (32 as i8)
    let is_var = (i + 3 < size) &&
        data[i as usize] == (118 as i8) && data[i+1 as usize] == (97 as i8) && data[i+2 as usize] == (114 as i8) && data[i+3 as usize] == (32 as i8)
    if !is_let && !is_var {
        return i
    }
    i = i + 4
    i = module_frontend_source_skip_ws(data, i, size)
    // skip the lhs name (ident chars)
    while i < size {
        let ch = data[i as usize]
        let is_ident = (ch >= (97 as i8) && ch <= (122 as i8)) || (ch >= (65 as i8) && ch <= (90 as i8)) || (ch >= (48 as i8) && ch <= (57 as i8)) || ch == (95 as i8)
        if !is_ident { break }
        i = i + 1
    }
    i = module_frontend_source_skip_ws(data, i, size)
    // optional : type
    if i < size && data[i as usize] == (58 as i8) {
        i = i + 1
        i = module_frontend_source_skip_ws(data, i, size)
        // skip type ident (and generics etc crudely until space or = or ( )
        while i < size {
            let ch = data[i as usize]
            if ch == (32 as i8) || ch == (9 as i8) || ch == (61 as i8) || ch == (40 as i8) { break }
            i = i + 1
        }
        i = module_frontend_source_skip_ws(data, i, size)
    }
    // expect =
    if i < size && data[i as usize] == (61 as i8) {
        i = i + 1
    }
    module_frontend_source_skip_ws(data, i, size)
}

fn module_frontend_source_body_start(data: string, start: i64, size: i64) -> i64 {
    var i = start
    while i < size {
        if data[i as usize] == (123 as i8) {
            return i + 1
        }
        i = i + 1
    }
    -1
}

fn module_frontend_source_body_end(data: string, start: i64, size: i64) -> i64 {
    var i = start
    var depth: i64 = 0
    while i < size {
        let ch = data[i as usize]
        if ch == (123 as i8) {
            depth = depth + 1
        } else if ch == (125 as i8) {
            if depth == 0 {
                return i
            }
            depth = depth - 1
        }
        i = i + 1
    }
    size
}

fn module_frontend_source_ident_at(data: string, start: i64, size: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 0 }
    var i = start
    while i < size && n.len < 128 {
        let ch = data[i as usize]
        let is_lower = ch >= (97 as i8) && ch <= (122 as i8)
        let is_upper = ch >= (65 as i8) && ch <= (90 as i8)
        let is_digit = ch >= (48 as i8) && ch <= (57 as i8)
        if is_lower || is_upper || is_digit || ch == (95 as i8) {
            n.buf[n.len] = ch
            n.len = n.len + 1
            i = i + 1
        } else {
            return n
        }
    }
    n
}

fn module_frontend_source_int_at(data: string, start: i64, size: i64) -> (bool, i64) {
    var i = start
    var value: i64 = 0
    var seen = false
    while i < size {
        let ch = data[i as usize]
        if ch >= (48 as i8) && ch <= (57 as i8) {
            seen = true
            value = (value * 10) + ((ch as i64) - 48)
            i = i + 1
        } else {
            return (seen, value)
        }
    }
    (seen, value)
}

fn module_frontend_source_line_end(data: string, start: i64, end: i64) -> i64 {
    var i = start
    while i < end {
        let ch = data[i as usize]
        if ch == (59 as i8) || ch == (10 as i8) || ch == (13 as i8) {
            return i
        }
        i = i + 1
    }
    end
}

fn module_frontend_source_after_line(data: string, start: i64, end: i64) -> i64 {
    var i = start
    while i < end {
        let ch = data[i as usize]
        if ch == (59 as i8) || ch == (10 as i8) || ch == (13 as i8) {
            i = i + 1
        } else if ch == (32 as i8) || ch == (9 as i8) {
            i = i + 1
        } else {
            return i
        }
    }
    i
}

fn module_frontend_source_find_fn(data: string, size: i64, target: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i + 2 < size {
        if module_frontend_source_is_fn_at(data, i, size) {
            let name = module_frontend_source_fn_name(data, module_frontend_source_fn_name_start(data, i, size), size)
            if ir_name_eq(name, target) {
                return i
            }
        }
        i = i + 1
    }
    0 - 1
}

fn module_frontend_name_is_println(name: Name) -> bool {
    name.len == 7 &&
    name.buf[0] == (112 as i8) &&
    name.buf[1] == (114 as i8) &&
    name.buf[2] == (105 as i8) &&
    name.buf[3] == (110 as i8) &&
    name.buf[4] == (116 as i8) &&
    name.buf[5] == (108 as i8) &&
    name.buf[6] == (110 as i8)
}

fn module_frontend_name_is_print_int(name: Name) -> bool {
    name.len == 9 &&
    name.buf[0] == (112 as i8) &&
    name.buf[1] == (114 as i8) &&
    name.buf[2] == (105 as i8) &&
    name.buf[3] == (110 as i8) &&
    name.buf[4] == (116 as i8) &&
    name.buf[5] == (95 as i8) &&
    name.buf[6] == (105 as i8) &&
    name.buf[7] == (110 as i8) &&
    name.buf[8] == (116 as i8)
}

fn module_frontend_ir_named_call(dst: i64, fn_name: Name) -> IrInstr {
    var instr = ir_call(dst, 0 - 1, fn_name, None, 0)
    instr.fn_id = 0 - 1
    instr.name = fn_name
    instr
}

fn module_frontend_name_is_main(name: Name) -> bool {
    name.len == 4 &&
    name.buf[0] == (109 as i8) &&
    name.buf[1] == (97 as i8) &&
    name.buf[2] == (105 as i8) &&
    name.buf[3] == (110 as i8)
}

fn module_frontend_name_eq_str(name: Name, text: string) -> bool with Mut, Panic, Div {
    let text_len = str_len(text)
    if name.len != text_len {
        return false
    }
    var i: i64 = 0
    while i < text_len {
        if name.buf[i as usize] != (str_char_at(text, i) as i8) {
            return false
        }
        i = i + 1
    }
    true
}

fn module_frontend_name_from_string(text: string) -> Name with Mut, Panic, Div {
    var name = Name { buf: [0; 128], len: 0 }
    let text_len = str_len(text)
    var i: i64 = 0
    while i < text_len && name.len < 128 {
        name.buf[name.len] = str_char_at(text, i) as i8
        name.len = name.len + 1
        i = i + 1
    }
    name
}

fn module_frontend_force_i64_return(func_in: IrFunction, value: i64) -> IrFunction with Mut, Panic, Div {
    var func = func_in
    func.reg_count = 1
    func.instrs[0] = ir_load_imm(0, value)
    func.instrs[1] = ir_return(0)
    func.instr_count = 2
    func
}

fn module_frontend_source_strip_return_prefix(data: string, start: i64, end: i64) -> i64 {
    var expr = module_frontend_source_skip_ws(data, start, end)
    if expr + 6 < end &&
       data[expr as usize] == (114 as i8) &&
       data[(expr + 1) as usize] == (101 as i8) &&
       data[(expr + 2) as usize] == (116 as i8) &&
       data[(expr + 3) as usize] == (117 as i8) &&
       data[(expr + 4) as usize] == (114 as i8) &&
       data[(expr + 5) as usize] == (110 as i8) &&
       data[(expr + 6) as usize] == (32 as i8) {
        return module_frontend_source_skip_ws(data, expr + 7, end)
    }
    expr
}

fn module_frontend_source_is_let_at(data: string, pos: i64, end: i64) -> bool {
    if pos + 3 >= end {
        return false
    }
    data[pos as usize] == (108 as i8) &&
    data[(pos + 1) as usize] == (101 as i8) &&
    data[(pos + 2) as usize] == (116 as i8) &&
    data[(pos + 3) as usize] == (32 as i8)
}

fn module_frontend_source_is_return_at(data: string, pos: i64, end: i64) -> bool {
    if pos + 6 >= end {
        return false
    }
    data[pos as usize] == (114 as i8) &&
    data[(pos + 1) as usize] == (101 as i8) &&
    data[(pos + 2) as usize] == (116 as i8) &&
    data[(pos + 3) as usize] == (117 as i8) &&
    data[(pos + 4) as usize] == (114 as i8) &&
    data[(pos + 5) as usize] == (110 as i8) &&
    data[(pos + 6) as usize] == (32 as i8)
}

fn module_frontend_source_is_if_at(data: string, pos: i64, end: i64) -> bool {
    if pos + 2 >= end {
        return false
    }
    data[pos as usize] == (105 as i8) &&
    data[(pos + 1) as usize] == (102 as i8) &&
    data[(pos + 2) as usize] == (32 as i8)
}

fn module_frontend_source_is_var_at(data: string, pos: i64, end: i64) -> bool {
    if pos + 3 >= end {
        return false
    }
    data[pos as usize] == (118 as i8) &&
    data[(pos + 1) as usize] == (97 as i8) &&
    data[(pos + 2) as usize] == (114 as i8) &&
    data[(pos + 3) as usize] == (32 as i8)
}

fn module_frontend_source_is_while_at(data: string, pos: i64, end: i64) -> bool {
    if pos + 5 >= end {
        return false
    }
    data[pos as usize] == (119 as i8) &&
    data[(pos + 1) as usize] == (104 as i8) &&
    data[(pos + 2) as usize] == (105 as i8) &&
    data[(pos + 3) as usize] == (108 as i8) &&
    data[(pos + 4) as usize] == (101 as i8) &&
    data[(pos + 5) as usize] == (32 as i8)
}

fn module_frontend_source_is_else_at(data: string, pos: i64, end: i64) -> bool {
    if pos + 4 >= end {
        return false
    }
    data[pos as usize] == (101 as i8) &&
    data[(pos + 1) as usize] == (108 as i8) &&
    data[(pos + 2) as usize] == (115 as i8) &&
    data[(pos + 3) as usize] == (101 as i8) &&
    (data[(pos + 4) as usize] == (32 as i8) || data[(pos + 4) as usize] == (123 as i8))
}

fn module_frontend_source_brace_close(data: string, open: i64, end: i64) -> i64 {
    var depth = 1
    var k = open + 1
    while k < end && depth > 0 {
        let bc = data[k as usize]
        if bc == (123 as i8) { depth = depth + 1 }
        else if bc == (125 as i8) { depth = depth - 1 }
        k = k + 1
    }
    if depth != 0 { return -1 }
    k - 1
}

fn module_frontend_lookup_source_local_i64(name: Name, local_name: Name, local_value: i64, has_local: bool) -> (bool, i64) with Mut, Panic, Div {
    if has_local && ir_name_eq(name, local_name) {
        return (true, local_value)
    }
    (false, 0)
}

fn module_frontend_lookup_source_locals4_i64(name: Name, local0_name: Name, local0_value: i64, has_local0: bool, local1_name: Name, local1_value: i64, has_local1: bool, local2_name: Name, local2_value: i64, has_local2: bool, local3_name: Name, local3_value: i64, has_local3: bool) -> (bool, i64) with Mut, Panic, Div {
    let local0 = module_frontend_lookup_source_local_i64(name, local0_name, local0_value, has_local0)
    if local0.0 {
        return local0
    }
    let local1 = module_frontend_lookup_source_local_i64(name, local1_name, local1_value, has_local1)
    if local1.0 {
        return local1
    }
    let local2 = module_frontend_lookup_source_local_i64(name, local2_name, local2_value, has_local2)
    if local2.0 {
        return local2
    }
    module_frontend_lookup_source_local_i64(name, local3_name, local3_value, has_local3)
}

fn module_frontend_try_eval_source_body_i64(data: string, body: i64, end: i64, size: i64, depth: i64) -> (bool, i64) with Mut, Panic, Div {
    let expr = module_frontend_source_strip_return_prefix(data, body, end)
    let direct = module_frontend_try_eval_source_expr_i64(data, expr, end, size, depth)
    if direct.0 {
        return direct
    }

    var local0_name = Name { buf: [0; 128], len: 0 }
    var local1_name = Name { buf: [0; 128], len: 0 }
    var local2_name = Name { buf: [0; 128], len: 0 }
    var local3_name = Name { buf: [0; 128], len: 0 }
    var local0_value: i64 = 0
    var local1_value: i64 = 0
    var local2_value: i64 = 0
    var local3_value: i64 = 0
    var has_local0 = false
    var has_local1 = false
    var has_local2 = false
    var has_local3 = false
    var local_count: i64 = 0
    var pos = module_frontend_source_skip_ws(data, body, end)
    while pos < end {
        pos = module_frontend_source_skip_ws(data, pos, end)
        if pos >= end {
            break
        }
        if module_frontend_source_is_let_at(data, pos, end) {
            if local_count >= 4 {
                return (false, 0)
            }
            var name_pos = module_frontend_source_skip_ws(data, pos + 4, end)
            let parsed_name = module_frontend_source_ident_at(data, name_pos, end)
            if parsed_name.len <= 0 {
                return (false, 0)
            }
            var rhs_pos = module_frontend_source_skip_ws(data, name_pos + parsed_name.len, end)
            if rhs_pos < end && data[rhs_pos as usize] == (58 as i8) {
                while rhs_pos < end && data[rhs_pos as usize] != (61 as i8) {
                    rhs_pos = rhs_pos + 1
                }
            }
            rhs_pos = module_frontend_source_skip_ws(data, rhs_pos, end)
            if rhs_pos >= end || data[rhs_pos as usize] != (61 as i8) {
                return (false, 0)
            }
            let expr_start = module_frontend_source_skip_ws(data, rhs_pos + 1, end)
            let expr_end = module_frontend_source_line_end(data, expr_start, end)
            let value = module_frontend_try_eval_source_expr_i64_with_locals4(data, expr_start, expr_end, size, depth, local0_name, local0_value, has_local0, local1_name, local1_value, has_local1, local2_name, local2_value, has_local2, local3_name, local3_value, has_local3)
            if !value.0 {
                return (false, 0)
            }
            if local_count == 0 {
                local0_name = parsed_name
                local0_value = value.1
                has_local0 = true
            } else if local_count == 1 {
                local1_name = parsed_name
                local1_value = value.1
                has_local1 = true
            } else if local_count == 2 {
                local2_name = parsed_name
                local2_value = value.1
                has_local2 = true
            } else {
                local3_name = parsed_name
                local3_value = value.1
                has_local3 = true
            }
            local_count = local_count + 1
            pos = module_frontend_source_after_line(data, expr_end, end)
        } else if module_frontend_source_is_return_at(data, pos, end) {
            let expr_start = module_frontend_source_strip_return_prefix(data, pos, end)
            let expr_end = module_frontend_source_line_end(data, expr_start, end)
            return module_frontend_try_eval_source_expr_i64_with_locals4(data, expr_start, expr_end, size, depth, local0_name, local0_value, has_local0, local1_name, local1_value, has_local1, local2_name, local2_value, has_local2, local3_name, local3_value, has_local3)
        } else if module_frontend_source_is_if_at(data, pos, end) {
            let cond_start = module_frontend_source_skip_ws(data, pos + 3, end)
            var brace_open = cond_start
            while brace_open < end && data[brace_open as usize] != (123 as i8) {
                brace_open = brace_open + 1
            }
            if brace_open >= end {
                return (false, 0)
            }
            let brace_close = module_frontend_source_brace_close(data, brace_open, end)
            if brace_close < 0 {
                return (false, 0)
            }
            let cond = module_frontend_try_eval_source_expr_i64_with_locals4(data, cond_start, brace_open, size, depth, local0_name, local0_value, has_local0, local1_name, local1_value, has_local1, local2_name, local2_value, has_local2, local3_name, local3_value, has_local3)
            if !cond.0 {
                return (false, 0)
            }
            if cond.1 != 0 {
                let inner = module_frontend_source_skip_ws(data, brace_open + 1, brace_close)
                if !module_frontend_source_is_return_at(data, inner, brace_close) {
                    return (false, 0)
                }
                let ret_start = module_frontend_source_strip_return_prefix(data, inner, brace_close)
                let ret_end = module_frontend_source_line_end(data, ret_start, brace_close)
                return module_frontend_try_eval_source_expr_i64_with_locals4(data, ret_start, ret_end, brace_close, depth, local0_name, local0_value, has_local0, local1_name, local1_value, has_local1, local2_name, local2_value, has_local2, local3_name, local3_value, has_local3)
            }
            let after = module_frontend_source_skip_ws(data, brace_close + 1, end)
            if module_frontend_source_is_else_at(data, after, end) {
                var else_brace = module_frontend_source_skip_ws(data, after + 4, end)
                if module_frontend_source_is_if_at(data, else_brace, end) {
                    pos = else_brace
                    continue
                }
                if else_brace >= end || data[else_brace as usize] != (123 as i8) {
                    return (false, 0)
                }
                let else_close = module_frontend_source_brace_close(data, else_brace, end)
                if else_close < 0 {
                    return (false, 0)
                }
                let einner = module_frontend_source_skip_ws(data, else_brace + 1, else_close)
                if !module_frontend_source_is_return_at(data, einner, else_close) {
                    return (false, 0)
                }
                let eret_start = module_frontend_source_strip_return_prefix(data, einner, else_close)
                let eret_end = module_frontend_source_line_end(data, eret_start, else_close)
                return module_frontend_try_eval_source_expr_i64_with_locals4(data, eret_start, eret_end, else_close, depth, local0_name, local0_value, has_local0, local1_name, local1_value, has_local1, local2_name, local2_value, has_local2, local3_name, local3_value, has_local3)
            }
            pos = brace_close + 1
        } else if module_frontend_source_is_var_at(data, pos, end) {
            if local_count >= 4 {
                return (false, 0)
            }
            var vname_pos = module_frontend_source_skip_ws(data, pos + 4, end)
            let vparsed_name = module_frontend_source_ident_at(data, vname_pos, end)
            if vparsed_name.len <= 0 {
                return (false, 0)
            }
            var vrhs_pos = module_frontend_source_skip_ws(data, vname_pos + vparsed_name.len, end)
            if vrhs_pos < end && data[vrhs_pos as usize] == (58 as i8) {
                while vrhs_pos < end && data[vrhs_pos as usize] != (61 as i8) {
                    vrhs_pos = vrhs_pos + 1
                }
            }
            vrhs_pos = module_frontend_source_skip_ws(data, vrhs_pos, end)
            if vrhs_pos >= end || data[vrhs_pos as usize] != (61 as i8) {
                return (false, 0)
            }
            let vexpr_start = module_frontend_source_skip_ws(data, vrhs_pos + 1, end)
            let vexpr_end = module_frontend_source_line_end(data, vexpr_start, end)
            let vvalue = module_frontend_try_eval_source_expr_i64_with_locals4(data, vexpr_start, vexpr_end, size, depth, local0_name, local0_value, has_local0, local1_name, local1_value, has_local1, local2_name, local2_value, has_local2, local3_name, local3_value, has_local3)
            if !vvalue.0 {
                return (false, 0)
            }
            if local_count == 0 {
                local0_name = vparsed_name
                local0_value = vvalue.1
                has_local0 = true
            } else if local_count == 1 {
                local1_name = vparsed_name
                local1_value = vvalue.1
                has_local1 = true
            } else if local_count == 2 {
                local2_name = vparsed_name
                local2_value = vvalue.1
                has_local2 = true
            } else {
                local3_name = vparsed_name
                local3_value = vvalue.1
                has_local3 = true
            }
            local_count = local_count + 1
            pos = module_frontend_source_after_line(data, vexpr_end, end)
        } else if module_frontend_source_is_while_at(data, pos, end) {
            let wcond_start = module_frontend_source_skip_ws(data, pos + 6, end)
            var wbrace_open = wcond_start
            while wbrace_open < end && data[wbrace_open as usize] != (123 as i8) {
                wbrace_open = wbrace_open + 1
            }
            if wbrace_open >= end {
                return (false, 0)
            }
            let wbrace_close = module_frontend_source_brace_close(data, wbrace_open, end)
            if wbrace_close < 0 {
                return (false, 0)
            }
            var iter_count: i64 = 0
            var while_done = false
            while iter_count < 10000 && while_done == false {
                let wcond = module_frontend_try_eval_source_expr_i64_with_locals4(data, wcond_start, wbrace_open, size, depth, local0_name, local0_value, has_local0, local1_name, local1_value, has_local1, local2_name, local2_value, has_local2, local3_name, local3_value, has_local3)
                if !wcond.0 {
                    return (false, 0)
                }
                if wcond.1 == 0 {
                    while_done = true
                } else {
                    var wip = module_frontend_source_skip_ws(data, wbrace_open + 1, wbrace_close)
                    var wbody_done = false
                    while wip < wbrace_close && wbody_done == false {
                        wip = module_frontend_source_skip_ws(data, wip, wbrace_close)
                        if wip >= wbrace_close {
                            wbody_done = true
                        } else if module_frontend_source_is_return_at(data, wip, wbrace_close) {
                            let wret_start = module_frontend_source_strip_return_prefix(data, wip, wbrace_close)
                            let wret_end = module_frontend_source_line_end(data, wret_start, wbrace_close)
                            return module_frontend_try_eval_source_expr_i64_with_locals4(data, wret_start, wret_end, wbrace_close, depth, local0_name, local0_value, has_local0, local1_name, local1_value, has_local1, local2_name, local2_value, has_local2, local3_name, local3_value, has_local3)
                        } else {
                            let wident = module_frontend_source_ident_at(data, wip, wbrace_close)
                            if wident.len <= 0 {
                                return (false, 0)
                            }
                            var weq_pos = module_frontend_source_skip_ws(data, wip + wident.len, wbrace_close)
                            if weq_pos >= wbrace_close || data[weq_pos as usize] != (61 as i8) {
                                return (false, 0)
                            }
                            if weq_pos + 1 < wbrace_close && data[(weq_pos + 1) as usize] == (61 as i8) {
                                return (false, 0)
                            }
                            let wrhs_start = module_frontend_source_skip_ws(data, weq_pos + 1, wbrace_close)
                            let wrhs_end = module_frontend_source_line_end(data, wrhs_start, wbrace_close)
                            let wnew_val = module_frontend_try_eval_source_expr_i64_with_locals4(data, wrhs_start, wrhs_end, size, depth, local0_name, local0_value, has_local0, local1_name, local1_value, has_local1, local2_name, local2_value, has_local2, local3_name, local3_value, has_local3)
                            if !wnew_val.0 {
                                return (false, 0)
                            }
                            if has_local0 && ir_name_eq(wident, local0_name) {
                                local0_value = wnew_val.1
                            } else if has_local1 && ir_name_eq(wident, local1_name) {
                                local1_value = wnew_val.1
                            } else if has_local2 && ir_name_eq(wident, local2_name) {
                                local2_value = wnew_val.1
                            } else if has_local3 && ir_name_eq(wident, local3_name) {
                                local3_value = wnew_val.1
                            } else {
                                return (false, 0)
                            }
                            wip = module_frontend_source_after_line(data, wrhs_end, wbrace_close)
                        }
                    }
                    iter_count = iter_count + 1
                }
            }
            if iter_count >= 10000 {
                return (false, 0)
            }
            pos = wbrace_close + 1
        } else {
            let aident = module_frontend_source_ident_at(data, pos, end)
            if aident.len > 0 {
                var aeq_pos = module_frontend_source_skip_ws(data, pos + aident.len, end)
                if aeq_pos < end && data[aeq_pos as usize] == (61 as i8) && (aeq_pos + 1 >= end || data[(aeq_pos + 1) as usize] != (61 as i8)) {
                    let arhs_start = module_frontend_source_skip_ws(data, aeq_pos + 1, end)
                    let arhs_end = module_frontend_source_line_end(data, arhs_start, end)
                    let anew_val = module_frontend_try_eval_source_expr_i64_with_locals4(data, arhs_start, arhs_end, size, depth, local0_name, local0_value, has_local0, local1_name, local1_value, has_local1, local2_name, local2_value, has_local2, local3_name, local3_value, has_local3)
                    if !anew_val.0 {
                        return (false, 0)
                    }
                    if has_local0 && ir_name_eq(aident, local0_name) {
                        local0_value = anew_val.1
                    } else if has_local1 && ir_name_eq(aident, local1_name) {
                        local1_value = anew_val.1
                    } else if has_local2 && ir_name_eq(aident, local2_name) {
                        local2_value = anew_val.1
                    } else if has_local3 && ir_name_eq(aident, local3_name) {
                        local3_value = anew_val.1
                    } else {
                        return (false, 0)
                    }
                    pos = module_frontend_source_after_line(data, arhs_end, end)
                } else {
                    return (false, 0)
                }
            } else {
                return (false, 0)
            }
        }
    }
    (false, 0)
}

fn module_frontend_source_paren_close(data: string, open: i64, end: i64) -> i64 {
    var depth = 1
    var k = open + 1
    while k < end && depth > 0 {
        let pc = data[k as usize]
        if pc == (40 as i8) {
            depth = depth + 1
        } else if pc == (41 as i8) {
            depth = depth - 1
        }
        k = k + 1
    }
    if depth != 0 {
        return -1
    }
    k - 1
}

fn module_frontend_source_trim_ws_end(data: string, start: i64, end: i64) -> i64 {
    var k = end
    while k > start {
        let ch = data[(k - 1) as usize]
        if ch == (32 as i8) || ch == (9 as i8) || ch == (10 as i8) || ch == (13 as i8) {
            k = k - 1
        } else {
            return k
        }
    }
    k
}

fn module_frontend_source_arg_count(data: string, start: i64, end: i64) -> i64 {
    let first = module_frontend_source_skip_ws(data, start, end)
    if first >= end {
        return 0
    }
    var count: i64 = 1
    var depth: i64 = 0
    var i = first
    while i < end {
        let ch = data[i as usize]
        if ch == (40 as i8) {
            depth = depth + 1
        } else if ch == (41 as i8) {
            if depth > 0 {
                depth = depth - 1
            }
        } else if ch == (44 as i8) && depth == 0 {
            count = count + 1
        }
        i = i + 1
    }
    count
}

struct ModuleFrontendArgSpan {
    ok: bool,
    start: i64,
    end: i64,
}

fn module_frontend_source_arg_span(data: string, start: i64, end: i64, target_idx: i64) -> ModuleFrontendArgSpan {
    var idx: i64 = 0
    var depth: i64 = 0
    var arg_start = module_frontend_source_skip_ws(data, start, end)
    var i = arg_start
    while i < end {
        let ch = data[i as usize]
        if ch == (40 as i8) {
            depth = depth + 1
        } else if ch == (41 as i8) {
            if depth > 0 {
                depth = depth - 1
            }
        } else if ch == (44 as i8) && depth == 0 {
            if idx == target_idx {
                let arg_end = module_frontend_source_trim_ws_end(data, arg_start, i)
                return ModuleFrontendArgSpan { ok: true, start: arg_start, end: arg_end }
            }
            idx = idx + 1
            arg_start = module_frontend_source_skip_ws(data, i + 1, end)
        }
        i = i + 1
    }
    if idx == target_idx {
        let final_end = module_frontend_source_trim_ws_end(data, arg_start, end)
        return ModuleFrontendArgSpan { ok: arg_start < final_end, start: arg_start, end: final_end }
    }
    ModuleFrontendArgSpan { ok: false, start: 0, end: 0 }
}

fn module_frontend_source_fn_param_name(data: string, fn_pos: i64, size: i64, target_idx: i64) -> Name with Mut, Panic, Div {
    var empty = Name { buf: [0; 128], len: 0 }
    var open = fn_pos
    while open < size && data[open as usize] != (40 as i8) {
        open = open + 1
    }
    if open >= size {
        return empty
    }
    var idx: i64 = 0
    var depth: i64 = 0
    var i = open + 1
    while i < size {
        i = module_frontend_source_skip_ws(data, i, size)
        if i >= size || data[i as usize] == (41 as i8) {
            return empty
        }
        let name = module_frontend_source_ident_at(data, i, size)
        if name.len <= 0 {
            return empty
        }
        if idx == target_idx {
            return name
        }
        i = i + name.len
        while i < size {
            let ch = data[i as usize]
            if ch == (40 as i8) {
                depth = depth + 1
            } else if ch == (41 as i8) {
                if depth == 0 {
                    return empty
                }
                depth = depth - 1
            } else if ch == (44 as i8) && depth == 0 {
                idx = idx + 1
                i = i + 1
                break
            }
            i = i + 1
        }
    }
    empty
}

fn module_frontend_try_eval_source_fn_i64_one_arg(data: string, size: i64, fn_name: Name, arg0_value: i64, depth: i64) -> (bool, i64) with Mut, Panic, Div {
    if depth > 16 {
        return (false, 0)
    }
    let fn_pos = module_frontend_source_find_fn(data, size, fn_name)
    if fn_pos < 0 {
        return (false, 0)
    }
    let param0 = module_frontend_source_fn_param_name(data, fn_pos, size, 0)
    if param0.len <= 0 {
        return (false, 0)
    }
    let body = module_frontend_source_body_start(data, fn_pos, size)
    if body < 0 {
        return (false, 0)
    }
    let body_end = module_frontend_source_body_end(data, body, size)
    let expr = module_frontend_source_strip_return_prefix(data, body, body_end)
    let empty = Name { buf: [0; 128], len: 0 }
