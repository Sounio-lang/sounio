}

fn module_frontend_source_paren_close(data: string, open: i64, end: i64) -> i64 {
    var depth = 1
    var k = open + 1
    while k < end && depth > 0 {
        let pc = data[k as usize]
        if pc == (40 as i8) {
            depth = depth + 1
        } else if pc == (41 as i8) {
            depth = depth - 1
        }
        k = k + 1
    }
    if depth != 0 {
        return -1
    }
    k - 1
}

fn module_frontend_try_eval_source_expr_i64_with_locals4(data: string, start: i64, end: i64, size: i64, depth: i64, local0_name: Name, local0_value: i64, has_local0: bool, local1_name: Name, local1_value: i64, has_local1: bool, local2_name: Name, local2_value: i64, has_local2: bool, local3_name: Name, local3_value: i64, has_local3: bool) -> (bool, i64) with Mut, Panic, Div {
    if depth > 16 {
        return (false, 0)
    }
    var i = module_frontend_source_skip_ws(data, start, end)
    var sum: i64 = 0
    var seg: i64 = 0
    var seg_started = false
    var seen = false
    var expect_term = true
    var mul_op: i64 = 0
    var pending_sign: i64 = 0
    var negate_next = false
    var has_cmp = false
    var cmp_op: i64 = 0
    var lhs: i64 = 0
    var has_bool = false
    var bool_op: i64 = 0
    var bool_acc: i64 = 0
    while i < end {
        i = module_frontend_source_skip_ws(data, i, end)
        if i >= end {
            break
        }
        let ch = data[i as usize]
        if ch == (59 as i8) || ch == (10 as i8) || ch == (13 as i8) {
            break
        }
        if ch == (43 as i8) {
            if expect_term {
                return (false, 0)
            }
            if seg_started {
                if pending_sign == 1 {
                    sum = sum - seg
                } else {
                    sum = sum + seg
                }
            }
            seg = 0
            seg_started = false
            mul_op = 0
            pending_sign = 0
            expect_term = true
            i = i + 1
        } else if ch == (45 as i8) {
            if expect_term {
                if negate_next {
                    return (false, 0)
                }
                negate_next = true
                i = i + 1
            } else {
                if seg_started {
                    if pending_sign == 1 {
                        sum = sum - seg
                    } else {
                        sum = sum + seg
                    }
                }
                seg = 0
                seg_started = false
                mul_op = 0
                pending_sign = 1
                negate_next = false
                expect_term = true
                i = i + 1
            }
        } else if ch == (42 as i8) {
            if expect_term {
                return (false, 0)
            }
            mul_op = 2
            expect_term = true
            i = i + 1
        } else if ch == (47 as i8) {
            if expect_term {
                return (false, 0)
            }
            mul_op = 3
            expect_term = true
            i = i + 1
        } else if ch == (61 as i8) {
            if expect_term || has_cmp {
                return (false, 0)
            }
            if i + 1 >= end || data[(i + 1) as usize] != (61 as i8) {
                return (false, 0)
            }
            if seg_started {
                if pending_sign == 1 { sum = sum - seg } else { sum = sum + seg }
            }
            lhs = sum
            sum = 0
            seg = 0
            seg_started = false
            mul_op = 0
            pending_sign = 0
            negate_next = false
            has_cmp = true
            cmp_op = 1
            expect_term = true
            i = i + 2
        } else if ch == (33 as i8) {
            if expect_term || has_cmp {
                return (false, 0)
            }
            if i + 1 >= end || data[(i + 1) as usize] != (61 as i8) {
                return (false, 0)
            }
            if seg_started {
                if pending_sign == 1 { sum = sum - seg } else { sum = sum + seg }
            }
            lhs = sum
            sum = 0
            seg = 0
            seg_started = false
            mul_op = 0
            pending_sign = 0
            negate_next = false
            has_cmp = true
            cmp_op = 2
            expect_term = true
            i = i + 2
        } else if ch == (60 as i8) {
            if expect_term || has_cmp {
                return (false, 0)
            }
            if seg_started {
                if pending_sign == 1 { sum = sum - seg } else { sum = sum + seg }
            }
            lhs = sum
            sum = 0
            seg = 0
            seg_started = false
