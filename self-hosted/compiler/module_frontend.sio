var MODULE_FRONTEND_REBRACKET_TRACE_ENABLED_ON: i64 = 0
var MODULE_FRONTEND_REBRACKET_TRACE_ENABLED_CHECKED: i64 = 0

fn module_frontend_rebracket_trace_enabled() -> bool with IO, Mut, Panic, Div {
    if MODULE_FRONTEND_REBRACKET_TRACE_ENABLED_CHECKED == 0 {
        MODULE_FRONTEND_REBRACKET_TRACE_ENABLED_CHECKED = 1
        if str_eq(read_env("SOUNIO_REBRACKET_TRACE"), "1") {
