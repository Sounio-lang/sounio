fn module_frontend_source_paren_close(data: string, open: i64, end: i64) -> i64 {
    var depth = 1
    var k = open + 1
    while k < end && depth > 0 {
        let pc = data[k as usize]
        if pc == (40 as i8) {
            depth = depth + 1
        } else if pc == (41 as i8) {
            depth = depth - 1
        }
        k = k + 1
    }
    if depth != 0 {
        return -1
    }
    k - 1
}

fn module_frontend_source_trim_ws_end(data: string, start: i64, end: i64) -> i64 {
    var k = end
    while k > start {
        let ch = data[(k - 1) as usize]
        if ch == (32 as i8) || ch == (9 as i8) || ch == (10 as i8) || ch == (13 as i8) {
            k = k - 1
        } else {
            return k
        }
    }
    k
}

fn module_frontend_source_arg_count(data: string, start: i64, end: i64) -> i64 {
    let first = module_frontend_source_skip_ws(data, start, end)
    if first >= end {
        return 0
    }
    var count: i64 = 1
    var depth: i64 = 0
    var i = first
    while i < end {
        let ch = data[i as usize]
        if ch == (40 as i8) {
            depth = depth + 1
        } else if ch == (41 as i8) {
            if depth > 0 {
                depth = depth - 1
            }
        } else if ch == (44 as i8) && depth == 0 {
            count = count + 1
        }
        i = i + 1
    }
    count
}

struct ModuleFrontendArgSpan {
    ok: bool,
    start: i64,
    end: i64,
}

fn module_frontend_source_arg_span(data: string, start: i64, end: i64, target_idx: i64) -> ModuleFrontendArgSpan {
    var idx: i64 = 0
    var depth: i64 = 0
    var arg_start = module_frontend_source_skip_ws(data, start, end)
    var i = arg_start
    while i < end {
        let ch = data[i as usize]
        if ch == (40 as i8) {
            depth = depth + 1
        } else if ch == (41 as i8) {
            if depth > 0 {
                depth = depth - 1
            }
        } else if ch == (44 as i8) && depth == 0 {
            if idx == target_idx {
                let arg_end = module_frontend_source_trim_ws_end(data, arg_start, i)
                return ModuleFrontendArgSpan { ok: true, start: arg_start, end: arg_end }
            }
            idx = idx + 1
            arg_start = module_frontend_source_skip_ws(data, i + 1, end)
        }
        i = i + 1
    }
    if idx == target_idx {
        let final_end = module_frontend_source_trim_ws_end(data, arg_start, end)
        return ModuleFrontendArgSpan { ok: arg_start < final_end, start: arg_start, end: final_end }
    }
    ModuleFrontendArgSpan { ok: false, start: 0, end: 0 }
}

fn module_frontend_source_fn_param_name(data: string, fn_pos: i64, size: i64, target_idx: i64) -> Name with Mut, Panic, Div {
    var empty = Name { buf: [0; 384], len: 0 }
    var open = fn_pos
    while open < size && data[open as usize] != (40 as i8) {
        open = open + 1
    }
    if open >= size {
        return empty
    }
    var idx: i64 = 0
    var depth: i64 = 0
    var i = open + 1
    while i < size {
        i = module_frontend_source_skip_ws(data, i, size)
        if i >= size || data[i as usize] == (41 as i8) {
            return empty
        }
        let name = module_frontend_source_ident_at(data, i, size)
        if name.len <= 0 {
            return empty
        }
        if idx == target_idx {
            return name
        }
        i = i + name.len
        while i < size {
            let ch = data[i as usize]
            if ch == (40 as i8) {
                depth = depth + 1
            } else if ch == (41 as i8) {
                if depth == 0 {
                    return empty
                }
                depth = depth - 1
            } else if ch == (44 as i8) && depth == 0 {
                idx = idx + 1
                i = i + 1
                break
            }
            i = i + 1
        }
    }
    empty
}

fn module_frontend_try_eval_source_fn_i64_one_arg(data: string, size: i64, fn_name: Name, arg0_value: i64, depth: i64) -> (bool, i64) with Mut, Panic, Div {
