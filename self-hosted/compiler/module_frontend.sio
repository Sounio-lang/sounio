            pending_sign = 0
            negate_next = false
            has_cmp = true
            if i + 1 < end && data[(i + 1) as usize] == (61 as i8) {
                cmp_op = 5
                i = i + 2
            } else {
                cmp_op = 3
                i = i + 1
            }
            expect_term = true
        } else if ch == (62 as i8) {
            if expect_term || has_cmp {
                return (false, 0)
            }
            if seg_started {
                if pending_sign == 1 { sum = sum - seg } else { sum = sum + seg }
            }
