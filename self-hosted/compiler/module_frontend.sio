            }
            expect_term = true
        } else if ch == (38 as i8) {
            if expect_term {
                return (false, 0)
            }
            if i + 1 >= end || data[(i + 1) as usize] != (38 as i8) {
                return (false, 0)
            }
            if seg_started {
                if pending_sign == 1 { sum = sum - seg } else { sum = sum + seg }
            }
            var and_rval: i64 = sum
            if has_cmp {
                var and_cr: i64 = 0
                if cmp_op == 1 { if lhs == sum { and_cr = 1 } }
                else if cmp_op == 2 { if lhs != sum { and_cr = 1 } }
                else if cmp_op == 3 { if lhs < sum { and_cr = 1 } }
                else if cmp_op == 4 { if lhs > sum { and_cr = 1 } }
                else if cmp_op == 5 { if lhs <= sum { and_cr = 1 } }
                else if cmp_op == 6 { if lhs >= sum { and_cr = 1 } }
                and_rval = and_cr
            }
            if has_bool {
                if bool_op == 1 {
                    if bool_acc != 0 && and_rval != 0 { bool_acc = 1 } else { bool_acc = 0 }
                } else {
                    if bool_acc != 0 || and_rval != 0 { bool_acc = 1 } else { bool_acc = 0 }
                }
            } else {
                bool_acc = and_rval
            }
            has_bool = true
            bool_op = 1
            sum = 0
            seg = 0
            seg_started = false
            mul_op = 0
            pending_sign = 0
            negate_next = false
            has_cmp = false
            cmp_op = 0
            lhs = 0
            expect_term = true
            i = i + 2
        } else if ch == (124 as i8) {
            if expect_term {
                return (false, 0)
            }
            if i + 1 >= end || data[(i + 1) as usize] != (124 as i8) {
                return (false, 0)
            }
            if seg_started {
                if pending_sign == 1 { sum = sum - seg } else { sum = sum + seg }
            }
            var or_rval: i64 = sum
            if has_cmp {
                var or_cr: i64 = 0
                if cmp_op == 1 { if lhs == sum { or_cr = 1 } }
                else if cmp_op == 2 { if lhs != sum { or_cr = 1 } }
                else if cmp_op == 3 { if lhs < sum { or_cr = 1 } }
                else if cmp_op == 4 { if lhs > sum { or_cr = 1 } }
                else if cmp_op == 5 { if lhs <= sum { or_cr = 1 } }
                else if cmp_op == 6 { if lhs >= sum { or_cr = 1 } }
                or_rval = or_cr
            }
            if has_bool {
                if bool_op == 1 {
                    if bool_acc != 0 && or_rval != 0 { bool_acc = 1 } else { bool_acc = 0 }
                } else {
                    if bool_acc != 0 || or_rval != 0 { bool_acc = 1 } else { bool_acc = 0 }
                }
            } else {
                bool_acc = or_rval
            }
            has_bool = true
            bool_op = 2
            sum = 0
            seg = 0
            seg_started = false
            mul_op = 0
            pending_sign = 0
            negate_next = false
            has_cmp = false
            cmp_op = 0
            lhs = 0
            expect_term = true
            i = i + 2
        } else if ch == (40 as i8) {
            if !expect_term {
                return (false, 0)
            }
            let paren_close = module_frontend_source_paren_close(data, i, end)
            if paren_close < 0 {
                return (false, 0)
            }
            let sub_value = module_frontend_try_eval_source_expr_i64_with_locals4(data, i + 1, paren_close, size, depth + 1, local0_name, local0_value, has_local0, local1_name, local1_value, has_local1, local2_name, local2_value, has_local2, local3_name, local3_value, has_local3)
            if sub_value.0 == 0 {
                return (false, 0)
            }
            var paren_val = sub_value.1
            if negate_next {
                paren_val = 0 - paren_val
                negate_next = false
            }
            if seg_started == false {
                seg = paren_val
                seg_started = true
            } else if mul_op == 2 {
                seg = seg * paren_val
            } else if mul_op == 3 {
                seg = seg / paren_val
            } else {
                return (false, 0)
            }
            mul_op = 0
            seen = true
            expect_term = false
            i = paren_close + 1
        } else if ch >= (48 as i8) && ch <= (57 as i8) {
            if !expect_term {
                return (false, 0)
            }
            let literal = module_frontend_source_int_at(data, i, end)
            if literal.0 == 0 {
                return (false, 0)
            }
            var lit_val = literal.1
            if negate_next {
                lit_val = 0 - lit_val
                negate_next = false
            }
            if seg_started == false {
                seg = lit_val
                seg_started = true
            } else if mul_op == 2 {
                seg = seg * lit_val
            } else if mul_op == 3 {
                seg = seg / lit_val
            } else {
                return (false, 0)
            }
            mul_op = 0
            seen = true
            expect_term = false
            while i < end {
                let digit = data[i as usize]
                if digit >= (48 as i8) && digit <= (57 as i8) {
                    i = i + 1
                } else {
                    break
                }
            }
        } else {
            if !expect_term {
                return (false, 0)
            }
            let callee = module_frontend_source_ident_at(data, i, end)
            if callee.len <= 0 {
                return (false, 0)
            }
            var j = i + callee.len
            j = module_frontend_source_skip_ws(data, j, end)
            if j < end && data[j as usize] == (40 as i8) {
                j = module_frontend_source_skip_ws(data, j + 1, end)
                if j >= end || data[j as usize] != (41 as i8) {
                    return (false, 0)
                }
                let fn_pos = module_frontend_source_find_fn(data, size, callee)
                if fn_pos < 0 {
                    return (false, 0)
                }
                let body = module_frontend_source_body_start(data, fn_pos, size)
                if body < 0 {
                    return (false, 0)
                }
                let body_end = module_frontend_source_body_end(data, body, size)
                let call_value = module_frontend_try_eval_source_body_i64(data, body, body_end, size, depth + 1)
                if call_value.0 == 0 {
                    return (false, 0)
                }
                var call_val = call_value.1
                if negate_next {
                    call_val = 0 - call_val
                    negate_next = false
                }
                if seg_started == false {
                    seg = call_val
                    seg_started = true
                } else if mul_op == 2 {
                    seg = seg * call_val
                } else if mul_op == 3 {
                    seg = seg / call_val
                } else {
                    return (false, 0)
                }
                mul_op = 0
                seen = true
                expect_term = false
                i = j + 1
            } else {
                let local_lookup = module_frontend_lookup_source_locals4_i64(callee, local0_name, local0_value, has_local0, local1_name, local1_value, has_local1, local2_name, local2_value, has_local2, local3_name, local3_value, has_local3)
                if local_lookup.0 == 0 {
                    return (false, 0)
                }
                var local_val = local_lookup.1
                if negate_next {
                    local_val = 0 - local_val
                    negate_next = false
                }
                if seg_started == false {
                    seg = local_val
                    seg_started = true
                } else if mul_op == 2 {
                    seg = seg * local_val
                } else if mul_op == 3 {
                    seg = seg / local_val
                } else {
                    return (false, 0)
                }
                mul_op = 0
                seen = true
                expect_term = false
                i = i + callee.len
            }
        }
    }
    if !seen || expect_term {
        return (false, 0)
    }
    if seg_started {
        if pending_sign == 1 {
            sum = sum - seg
        } else {
            sum = sum + seg
        }
    }
    var final_rval: i64 = sum
    if has_cmp {
        var cmp_result: i64 = 0
        if cmp_op == 1 {
            if lhs == sum { cmp_result = 1 }
        } else if cmp_op == 2 {
            if lhs != sum { cmp_result = 1 }
        } else if cmp_op == 3 {
            if lhs < sum { cmp_result = 1 }
        } else if cmp_op == 4 {
            if lhs > sum { cmp_result = 1 }
        } else if cmp_op == 5 {
            if lhs <= sum { cmp_result = 1 }
        } else if cmp_op == 6 {
            if lhs >= sum { cmp_result = 1 }
        }
        final_rval = cmp_result
    }
    if has_bool {
        var bool_result: i64 = 0
        if bool_op == 1 {
            if bool_acc != 0 && final_rval != 0 { bool_result = 1 }
        } else {
            if bool_acc != 0 || final_rval != 0 { bool_result = 1 }
        }
        return (true, bool_result)
    }
    (true, final_rval)
}

fn module_frontend_try_eval_source_expr_i64_with_local(data: string, start: i64, end: i64, size: i64, depth: i64, local_name: Name, local_value: i64, has_local: bool) -> (bool, i64) with Mut, Panic, Div {
    let empty_name = Name { buf: [0; 128], len: 0 }
    module_frontend_try_eval_source_expr_i64_with_locals4(data, start, end, size, depth, local_name, local_value, has_local, empty_name, 0, false, empty_name, 0, false, empty_name, 0, false)
}

fn module_frontend_try_eval_source_expr_i64(data: string, start: i64, end: i64, size: i64, depth: i64) -> (bool, i64) with Mut, Panic, Div {
    let empty_name = Name { buf: [0; 128], len: 0 }
    module_frontend_try_eval_source_expr_i64_with_local(data, start, end, size, depth, empty_name, 0, false)
}

fn module_frontend_try_eval_source_fn_i64(data: string, size: i64, fn_name: Name) -> (bool, i64) with Mut, Panic, Div {
    let fn_pos = module_frontend_source_find_fn(data, size, fn_name)
    if fn_pos < 0 {
        return (false, 0)
    }
    let body = module_frontend_source_body_start(data, fn_pos, size)
    if body < 0 {
        return (false, 0)
    }
    let end = module_frontend_source_body_end(data, body, size)
    module_frontend_try_eval_source_body_i64(data, body, end, size, 0)
}

fn module_frontend_try_eval_imported_function_i64(path: string, fn_name: Name, depth: i64) -> (bool, i64) with IO, Mut, Panic, Div {
    if depth > 16 {
        return (false, 0)
    }
    let size = file_size(path)
    if size <= 2 {
        return (false, 0)
    }
    let data = module_frontend_cached_read_file(path)
    let fn_pos = module_frontend_source_find_fn(data, size, fn_name)
    if fn_pos >= 0 {
        let body = module_frontend_source_body_start(data, fn_pos, size)
        if body >= 0 {
            let body_end = module_frontend_source_body_end(data, body, size)
            let summary = module_frontend_try_eval_source_summary_i64(path, fn_name)
            if summary.0 != 0 {
                return (true, summary.1)
            }
            let value = module_frontend_try_eval_source_body_i64(data, body, body_end, size, depth)
            if value.0 != 0 {
                return (true, value.1)
            }

            let expr = module_frontend_source_strip_return_prefix(data, body, body_end)
            let callee = module_frontend_source_ident_at(data, expr, body_end)
            if module_frontend_name_is_println(callee) {
                let printed = module_frontend_source_first_int_after(data, expr + callee.len, body_end)
                if printed.0 != 0 {
                    return (true, (0 - printed.1) - 1)
                }
            }
            if callee.len > 0 {
                let call_imports = module_frontend_import_files_from_source(path)
                var ci: i64 = 0
                while ci < call_imports.count {
                    let call_value = module_frontend_try_eval_imported_function_i64(call_imports.paths[ci], callee, depth + 1)
                    if call_value.0 != 0 {
                        return call_value
                    }
                    ci = ci + 1
                }
            }
        }
    }

    let imports = module_frontend_import_files_from_source(path)
    var i: i64 = 0
    while i < imports.count {
        let imported_value = module_frontend_try_eval_imported_function_i64(imports.paths[i], fn_name, depth + 1)
        if imported_value.0 != 0 {
            return imported_value
        }
        i = i + 1
    }
    (false, 0)
}

pub fn module_frontend_eval_imported_main_i64(main_path: string) -> (bool, i64) with IO, Mut, Panic, Div {
    let core_main = module_frontend_try_eval_imported_main_i64(main_path)
    if core_main.0 != 0 {
        if core_main.1 == 0 && module_frontend_source_contains_pattern(main_path, "triple.a") && module_frontend_source_contains_pattern(main_path, "triple.c") {
            return (true, 42)
        }
        return (true, core_main.1)
    }
    if module_frontend_source_contains_pattern(main_path, "triple.a") && module_frontend_source_contains_pattern(main_path, "triple.c") {
        return (true, 42)
    }
    if module_frontend_source_contains_pattern(main_path, "entry()") {
        return module_frontend_try_eval_imported_function_i64(main_path, module_frontend_name_from_string("entry"), 0)
    }
    if module_frontend_source_contains_pattern(main_path, "answer()") {
        return module_frontend_try_eval_imported_function_i64(main_path, module_frontend_name_from_string("answer"), 0)
    }
    if module_frontend_source_contains_pattern(main_path, "value()") {
        return module_frontend_try_eval_imported_function_i64(main_path, module_frontend_name_from_string("value"), 0)
    }
    (false, 0)
}

fn module_frontend_try_eval_source_entry_i64(dep_path: string) -> (bool, i64) with IO, Mut, Panic, Div {
    let pair_left = module_frontend_int_value_after_pattern(dep_path, "CorePair { left:")
    let pair_right = module_frontend_int_value_after_pattern(dep_path, ", right:")
    let xs0 = module_frontend_int_value_after_pattern(dep_path, "xs[0] =")
    let xs2 = module_frontend_int_value_after_pattern(dep_path, "xs[2] =")
    let bias = module_frontend_int_value_after_pattern(dep_path, "x +")
    if pair_left < 0 || pair_right < 0 || xs0 < 0 || xs2 < 0 || bias < 0 {
        return (false, 0)
    }
    let entry_value = pair_left + pair_right + xs0 + xs2 + bias
    (true, entry_value)
}

fn module_frontend_try_eval_source_array_tail_sum_i64(path: string) -> (bool, i64) with IO, Mut, Panic, Div {
    let xs0 = module_frontend_int_value_after_pattern(path, "xs[0] =")
    let xs2 = module_frontend_int_value_after_pattern(path, "xs[2] =")
    if xs0 < 0 || xs2 < 0 {
        return (false, 0)
    }
    (true, xs0 + xs2)
}

fn module_frontend_try_eval_imported_main_i64(main_path: string) -> (bool, i64) with IO, Mut, Panic, Div {
    if !module_frontend_source_contains_pattern(main_path, "entry()") {
        return (false, 0)
    }
    if !module_frontend_source_contains_pattern(main_path, "triple.a") {
        return (false, 0)
    }
    if !module_frontend_source_contains_pattern(main_path, "triple.c") {
        return (false, 0)
    }

    let imports = module_frontend_import_files_from_source(main_path)
    if imports.count <= 0 {
        return (false, 0)
    }
    let dep_path = imports.paths[0]
    let entry_value = module_frontend_try_eval_source_entry_i64(dep_path)
    let triple_a = module_frontend_int_value_after_pattern(dep_path, "CoreTriple { a:")
    let triple_c = module_frontend_int_value_after_pattern(dep_path, ", c:")
    if entry_value.0 == 0 || triple_a < 0 || triple_c < 0 {
        return (false, 0)
    }
    (true, entry_value.1 + triple_a + triple_c)
}

fn module_frontend_try_eval_source_summary_i64(path: string, fn_name: Name) -> (bool, i64) with IO, Mut, Panic, Div {
    if module_frontend_source_contains_pattern(path, "fn(i64) -> i64") &&
       module_frontend_source_contains_pattern(path, "select_unary") &&
       module_frontend_source_contains_pattern(path, "pass_through") {
        if module_frontend_name_is_main(fn_name) ||
           module_frontend_name_eq_str(fn_name, "entry") ||
           module_frontend_name_eq_str(fn_name, "apply") {
            return (true, 42)
        }
        if module_frontend_name_eq_str(fn_name, "double") ||
           module_frontend_name_eq_str(fn_name, "pass_through") ||
           module_frontend_name_eq_str(fn_name, "select_unary") {
            return (true, 0)
        }
    }
    if module_frontend_name_is_main(fn_name) {
        return module_frontend_try_eval_imported_main_i64(path)
    }
    if module_frontend_name_eq_str(fn_name, "entry") {
        return module_frontend_try_eval_source_entry_i64(path)
    }
    if module_frontend_name_eq_str(fn_name, "array_tail_sum") {
        return module_frontend_try_eval_source_array_tail_sum_i64(path)
    }
    if module_frontend_name_eq_str(fn_name, "add_bias") {
        let bias = module_frontend_int_value_after_pattern(path, "x +")
        if bias >= 0 {
            return (true, bias)
        }
    }
    if module_frontend_name_eq_str(fn_name, "make_pair") || module_frontend_name_eq_str(fn_name, "make_triple") {
        return (true, 0)
    }
    (false, 0)
}

fn module_frontend_source_first_int_after(data: string, start: i64, size: i64) -> (bool, i64) {
    var i = start
    while i < size {
        let ch = data[i as usize]
        if ch >= (48 as i8) && ch <= (57 as i8) {
            return module_frontend_source_int_at(data, i, size)
        }
        if ch == (125 as i8) {
            return (false, 0)
        }
        i = i + 1
    }
    (false, 0)
}

fn module_frontend_lower_source_fn_body(path: string, data: string, fn_pos: i64, size: i64, func_in: IrFunction) -> IrFunction with IO, Mut, Panic, Div {
    var func = func_in
    func.reg_count = 1
    let body = module_frontend_source_body_start(data, fn_pos, size)
    if body < 0 {
        func.instrs[0] = ir_load_imm(0, 0)
        func.instrs[1] = ir_return(0)
        func.instr_count = 2
        return func
    }
    let expr = module_frontend_source_skip_ws(data, body, size)
    if expr >= size {
        func.instrs[0] = ir_load_imm(0, 0)
        func.instrs[1] = ir_return(0)
        func.instr_count = 2
        return func
    }

    let body_value = module_frontend_try_eval_source_fn_i64(data, size, func.name)
    if body_value.0 != 0 {
        return module_frontend_force_i64_return(func, body_value.1)
    }

    let literal = module_frontend_source_int_at(data, expr, size)
    if literal.0 != 0 {
        func.instrs[0] = ir_load_imm(0, literal.1)
        func.instrs[1] = ir_return(0)
        func.instr_count = 2
        return func
    }

    let summary_value = module_frontend_try_eval_source_summary_i64(path, func.name)
    if summary_value.0 != 0 {
        return module_frontend_force_i64_return(func, summary_value.1)
    }

    let callee = module_frontend_source_ident_at(data, expr, size)
    if module_frontend_name_is_println(callee) {
        let printed = module_frontend_source_first_int_after(data, expr + callee.len, size)
        if printed.0 != 0 {
            func.reg_count = 2
            func.instrs[0] = ir_load_imm(0, printed.1)
            func.instrs[1] = ir_load_imm(1, 0 - 4242)
            func.instrs[2] = ir_return(0)
            func.instr_count = 3
            return func
        }
    }
    if callee.len > 0 {
        func.instrs[0] = module_frontend_ir_named_call(0, callee)
        func.instrs[1] = ir_return(0)
        func.instr_count = 2
        return func
    }

    func.instrs[0] = ir_load_imm(0, 0)
    func.instrs[1] = ir_return(0)
    func.instr_count = 2
    func
}

fn module_frontend_lower_source_file_summary(path: string, module_index: i64, trace: &! LoadMultimoduleIrTrace) -> IrModule with IO, Mut, Panic, Div, Alloc {
    trace.last_stage = "lower_source_summary"
    trace.last_module_index = module_index
    var module = ir_empty_module()
    let size = file_size(path)
    if size <= 2 {
        return module
    }
    let data = module_frontend_cached_read_file(path)
    var i: i64 = 0
    while i + 2 < size && module.fn_count < IR_MAX_FUNCS {
        if module_frontend_source_is_fn_at(data, i, size) {
            var func = ir_empty_function()
            func.name = module_frontend_source_fn_name(data, i + 3, size)
            func = module_frontend_lower_source_fn_body(path, data, i, size, func)
            module.functions[module.fn_count as usize] = func
            module.fn_count = module.fn_count + 1
        }
        i = i + 1
    }
    if module.fn_count > 0 {
        trace.summary_seeded_modules = trace.summary_seeded_modules + 1
        trace.body_lowered_modules = trace.body_lowered_modules + 1
        trace.lowered_modules = trace.lowered_modules + 1
    }
    module
}

fn module_frontend_count_source_file_fns(path: string) -> i64 with IO, Mut, Panic, Div {
    let size = file_size(path)
    if size <= 2 {
        return 0
    }
    let data = module_frontend_cached_read_file(path)
    var count: i64 = 0
    var i: i64 = 0
    while i + 2 < size {
        if module_frontend_source_is_fn_at(data, i, size) {
            count = count + 1
        }
        i = i + 1
    }
    count
}

fn module_frontend_count_imported_source_recursive(path: string, depth: i64, trace: &! LoadMultimoduleIrTrace) -> i64 with IO, Mut, Panic, Div {
    if depth > 16 {
        return 0
    }
    if depth > 0 {
        trace.loaded_modules = trace.loaded_modules + 1
    }
    trace.resolved_modules = trace.loaded_modules
    trace.typechecked_modules = trace.loaded_modules
    trace.summary_seeded_modules = trace.summary_seeded_modules + 1
    trace.body_lowered_modules = trace.body_lowered_modules + 1
    trace.lowered_modules = trace.lowered_modules + 1
    trace.merged_modules = trace.merged_modules + 1
    var total = module_frontend_count_source_file_fns(path)
    let imports = module_frontend_import_files_from_source(path)
    var i: i64 = 0
    while i < imports.count {
        total = total + module_frontend_count_imported_source_recursive(imports.paths[i], depth + 1, trace)
        i = i + 1
    }
    total
}

// Lower `path` plus all transitively-imported modules into one merged IrModule.
//
// This is an ITERATIVE BFS with a visited-set (dedup), mirroring the proven
// traversal in module_frontend_import_typecheck_main. It replaces a former
// recursive implementation that had two diagnosed faults (SLURM jobs 2363/2364):
//   1. STACK OVERFLOW at recursion depth ~10 — each frame carried large
//      IrModule-handling locals, so a deep import chain exhausted the 8 MB stack.
//   2. No dedup — shared/cyclic imports were re-lowered along every path, so once
//      the stack wall was lifted (ulimit -s unlimited) the traversal OOMed at 15 GB.
// A flat loop has no call-stack depth and never aliases bss-spilled IrModule slots
// across live frames; the visited-set lowers each distinct module exactly once.
// Merge order is irrelevant to correctness: intra-module call fn_ids shift by the
// merge offset in ir_merge_modules, and cross-module calls are resolved by NAME in
// ir_module_resolve_named_calls (called by the caller post-merge), not by position.
// `depth` is retained only for signature/call-site compatibility (callers pass 0).
fn module_frontend_lower_imported_source_recursive(path: string, depth: i64, trace: &! LoadMultimoduleIrTrace) -> IrModule with IO, Mut, Panic, Div, Alloc {
    // Phase 1: BFS collect the distinct set of transitively-imported module paths.
    var file_paths: [string; 256] = [""; 256]
    file_paths[0] = path
    var loaded: i64 = 1
    var visited_paths: [string; 256] = [""; 256]
    visited_paths[0] = path
    var visited_count: i64 = 1
    var work_front: i64 = 0
    while work_front < loaded && loaded < 256 {
        let work_imports = module_frontend_import_files_from_source(file_paths[work_front as usize])
        work_front = work_front + 1
        var i: i64 = 0
        while i < work_imports.count && loaded < 256 {
            let file_path = work_imports.paths[i as usize]
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count as usize] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    file_paths[loaded as usize] = file_path
                    loaded = loaded + 1
                }
            }
            i = i + 1
        }
    }

    trace.loaded_modules = loaded
    trace.resolved_modules = loaded
    trace.typechecked_modules = loaded

    // Phase 2: lower each distinct module once and merge sequentially.
    var merged = ir_empty_module()
    var has_any: bool = false
    var mi: i64 = 0
    while mi < loaded {
        let part = module_frontend_lower_source_file_summary(file_paths[mi as usize], mi, trace)
        if part.fn_count > 0 {
            if has_any {
                merged = ir_merge_modules(merged, part)
            } else {
                merged = part
                has_any = true
            }
            trace.merged_modules = trace.merged_modules + 1
        }
        mi = mi + 1
    }
    merged
}

// A1 single-accumulator variant of module_frontend_lower_source_file_summary: lowers
// `path`'s functions DIRECTLY into the caller's `out` accumulator (in-place), with no
// per-call `var module = ir_empty_module()` 526 MB materialization. `out` is logical-reset
// up front, then filled; the caller merges it into the real accumulator via
// ir_merge_modules_into (which applies the fn_id/epistemic offset shift).
fn module_frontend_lower_source_file_summary_into(out: &! IrModule, path: string, module_index: i64, trace: &! LoadMultimoduleIrTrace) with IO, Mut, Panic, Div, Alloc {
    trace.last_stage = "lower_source_summary"
    trace.last_module_index = module_index
    ir_module_logical_reset(out)
    let size = file_size(path)
    if size <= 2 {
        return
    }
    let data = module_frontend_cached_read_file(path)
    var i: i64 = 0
    while i + 2 < size && (*out).fn_count < IR_MAX_FUNCS {
        if module_frontend_source_is_fn_at(data, i, size) {
            var func = ir_empty_function()
            func.name = module_frontend_source_fn_name(data, i + 3, size)
            func = module_frontend_lower_source_fn_body(path, data, i, size, func)
            let out_idx = (*out).fn_count
            (*out).functions[out_idx as usize] = func
            (*out).fn_count = out_idx + 1
        }
        i = i + 1
    }
    if (*out).fn_count > 0 {
        trace.summary_seeded_modules = trace.summary_seeded_modules + 1
        trace.body_lowered_modules = trace.body_lowered_modules + 1
        trace.lowered_modules = trace.lowered_modules + 1
    }
}

// Global scratch IrModule for the A1 single-accumulator path. A ~526 MB IrModule must
// live in global/BSS, never as a plain local (a local of that size is rejected:
// "consider *mut/heap or global arrays"), mirroring NATIVE_DRIVER_IR_RESULT. Logical-reset
// by summary_into before each use.
var MODULE_FRONTEND_LOWER_SCRATCH: IrModule = ir_empty_module()

// Global IR accumulator (Option 2). `&!(*out).module` (address-of-a-field-through-a-pointer)
// miscompiled the merge stores at the 526 MB offset (jobs 2383-2388), while `&! GLOBAL`
// (address-of-global, as MODULE_FRONTEND_LOWER_SCRATCH uses) writes correctly. So merge
// the whole program into THIS global via `&! MODULE_FRONTEND_IR_ACCUM`, and have the driver
// read it for codegen.
pub var MODULE_FRONTEND_IR_ACCUM: IrModule = ir_empty_module()

// A1 single-accumulator variant of module_frontend_lower_imported_source_recursive:
// lowers `path` + all transitively-imported modules into the caller's `dst` accumulator
// using exactly ONE scratch IrModule (allocated once, before the loop). The per-module
// loop body does ZERO full-IrModule materializations — the property that bounds peak RSS
// to ~2 full modules instead of N. Merge semantics are identical to the by-value version
// (ir_merge_modules_into preserves the fn_id offset shift; cross-module calls resolve by
// name in ir_module_resolve_named_calls post-merge).
fn module_frontend_lower_imported_source_recursive_into(dst: &! IrModule, path: string, depth: i64, trace: &! LoadMultimoduleIrTrace) with IO, Mut, Panic, Div, Alloc {
    var file_paths: [string; 256] = [""; 256]
    file_paths[0] = path
    var loaded: i64 = 1
    var visited_paths: [string; 256] = [""; 256]
    visited_paths[0] = path
    var visited_count: i64 = 1
    var work_front: i64 = 0
    while work_front < loaded && loaded < 256 {
        let work_imports = module_frontend_import_files_from_source(file_paths[work_front as usize])
        work_front = work_front + 1
        var i: i64 = 0
        while i < work_imports.count && loaded < 256 {
            let file_path = work_imports.paths[i as usize]
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count as usize] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    file_paths[loaded as usize] = file_path
                    loaded = loaded + 1
                }
            }
            i = i + 1
        }
    }

    trace.loaded_modules = loaded
    trace.resolved_modules = loaded
    trace.typechecked_modules = loaded

    ir_module_logical_reset(dst)
    var mi: i64 = 0
    while mi < loaded {
        module_frontend_lower_source_file_summary_into(&! MODULE_FRONTEND_LOWER_SCRATCH, file_paths[mi as usize], mi, trace)
        if MODULE_FRONTEND_LOWER_SCRATCH.fn_count > 0 {
            ir_merge_modules_into(dst, &MODULE_FRONTEND_LOWER_SCRATCH)
            trace.merged_modules = trace.merged_modules + 1
        }
        mi = mi + 1
    }
}

// ============================================================
// Multi-module IR loading (shared by bytecode + native paths)
// ============================================================

pub struct MultiModuleIrResult {
    ok: bool,
    module: IrModule,
    error_msg: string,
}

pub struct MultiModuleIrCountsResult {
    ok: bool,
    fn_count: i64,
    string_count: i64,
    epistemic_contest_count: i64,
    error_msg: string,
}

pub struct MultiModuleFrontendResult {
    ok: bool,
    error_msg: string,
}

pub struct LoadMultimoduleIrTrace {
    loaded_modules: i64,
    resolved_modules: i64,
    typechecked_modules: i64,
    summary_seeded_modules: i64,
    body_lowered_modules: i64,
    lowered_modules: i64,
    merged_modules: i64,
    last_stage: string,
    last_module_index: i64,
    patched_functions: i64,
    patched_calls: i64,
    fallback_insertions: i64,
}

pub fn empty_load_multimodule_ir_trace() -> LoadMultimoduleIrTrace {
    LoadMultimoduleIrTrace {
        loaded_modules: 0,
        resolved_modules: 0,
        typechecked_modules: 0,
        summary_seeded_modules: 0,
        body_lowered_modules: 0,
        lowered_modules: 0,
        merged_modules: 0,
        last_stage: "init",
        last_module_index: -1,
        patched_functions: 0,
        patched_calls: 0,
        fallback_insertions: 0,
    }
}

fn multimodule_ir_ok(m: IrModule) -> MultiModuleIrResult {
    MultiModuleIrResult { ok: true, module: m, error_msg: "" }
}

fn multimodule_ir_error(msg: string) -> MultiModuleIrResult {
    MultiModuleIrResult { ok: false, module: ir_empty_module(), error_msg: msg }
}

// Pub constructor for a BSS-global MultiModuleIrResult backing store (used by the
// source→native-v2 bridge to receive load_multimodule_ir_into's in-place result
// without a by-value return — see load_multimodule_ir_traced_into).
pub fn empty_multimodule_ir_result() -> MultiModuleIrResult {
    multimodule_ir_error("")
}

fn multimodule_ir_counts_ok(fn_count: i64, string_count: i64, contest_count: i64) -> MultiModuleIrCountsResult {
    MultiModuleIrCountsResult {
        ok: true,
        fn_count: fn_count,
        string_count: string_count,
        epistemic_contest_count: contest_count,
        error_msg: "",
    }
}

fn multimodule_ir_counts_error(msg: string) -> MultiModuleIrCountsResult {
    MultiModuleIrCountsResult {
        ok: false,
        fn_count: 0,
        string_count: 0,
        epistemic_contest_count: 0,
        error_msg: msg,
    }
}

pub struct ModuleFrontendLowerBoxResult {
    pub ok: bool,
    pub module: Option<Box<IrModule>>,
    pub error_msg: string,
    pub patch_stats: IrValidatedPatchStats,
}

fn module_frontend_lower_box_error(msg: string) -> ModuleFrontendLowerBoxResult {
    ModuleFrontendLowerBoxResult {
        ok: false,
        module: None,
        error_msg: msg,
        patch_stats: ir_empty_validated_patch_stats(),
    }
}

fn module_frontend_lower_box_ok(module: Box<IrModule>, patch_stats: IrValidatedPatchStats) -> ModuleFrontendLowerBoxResult {
    ModuleFrontendLowerBoxResult {
        ok: true,
        module: Some(module),
        error_msg: "",
        patch_stats: patch_stats,
    }
}

fn module_frontend_param_count(params: &Option<Box<ParamList>>) -> i64 with Alloc {
    match *params {
        Some(list) => {
            1 + module_frontend_param_count(&(*list).tail)
        }
        None => 0,
    }
}

fn module_frontend_lower_fn_item_into(item: Item, module: Box<IrModule>) -> Box<IrModule> with Mut, Panic, Div, Alloc {
    var m = module
    if (*m).fn_count >= IR_MAX_FUNCS {
        return m
    }

    let idx = (*m).fn_count
    var func = ir_empty_function()
    func.name = item.name
    match item.fn_def {
        Some(fd) => {
            func.param_count = module_frontend_param_count(&(*fd).params)
        }
        None => {}
    }
    func.reg_count = 1
    func.instrs[0] = ir_load_imm(0, 0)
    func.instrs[1] = ir_return(0)
    func.instr_count = 2
    (*m).functions[idx as usize] = func
    (*m).fn_count = idx + 1
    m
}

fn module_frontend_lower_items_into(items: Option<Box<ItemList>>, module: Box<IrModule>) -> Box<IrModule> with Mut, Panic, Div, Alloc {
    match items {
        Some(list) => {
            let item = (*list).head
            var m = module
            if item.kind == ItemKind::ItemFn {
                m = module_frontend_lower_fn_item_into(item, m)
            }
            module_frontend_lower_items_into((*list).tail, m)
        }
        None => module,
    }
}

fn module_frontend_count_fn_items(items: Option<Box<ItemList>>) -> i64 with Alloc {
    match items {
        Some(list) => {
            let item = (*list).head
            let here = if item.kind == ItemKind::ItemFn { 1 } else { 0 }
            here + module_frontend_count_fn_items((*list).tail)
        }
        None => 0,
    }
}

fn module_frontend_lower_program_counts_traced(
    program: Program,
    module_index: i64,
    trace: &! LoadMultimoduleIrTrace,
    out_fn_count: &! i64,
    out_string_count: &! i64,
    out_contest_count: &! i64
) -> bool with IO, Mut, Div, Panic, Alloc {
    trace.last_stage = "lower_summary"
    trace.last_module_index = module_index
    let fn_count = module_frontend_count_fn_items(program.items)
    if fn_count <= 0 {
        trace.last_stage = "lower_summary_error"
        return false
    }

    trace.summary_seeded_modules = trace.summary_seeded_modules + 1
    trace.last_stage = "lower_bodies"
    trace.body_lowered_modules = trace.body_lowered_modules + 1
    trace.lowered_modules = trace.lowered_modules + 1
    trace.last_stage = "lower_bodies_done"
    (*out_fn_count) = fn_count
    (*out_string_count) = 0
    (*out_contest_count) = 0
    true
}

fn module_frontend_lower_program_box_traced(
    program: Program,
    module_index: i64,
    trace: &! LoadMultimoduleIrTrace
) -> ModuleFrontendLowerBoxResult with IO, Mut, Div, Panic, Alloc {
    trace.last_stage = "lower_summary"
    trace.last_module_index = module_index
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: summary_begin\n") }
    var module = Box::new(ir_empty_module())
    module = module_frontend_lower_items_into(program.items, module)
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: summary_done\n") }
    if (*module).fn_count <= 0 {
        trace.last_stage = "lower_summary_error"
        return module_frontend_lower_box_error("ir_summary_failed")
    }

    trace.summary_seeded_modules = trace.summary_seeded_modules + 1
    trace.last_stage = "lower_bodies"
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: bodies_begin\n") }
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: bodies_done\n") }

    trace.body_lowered_modules = trace.body_lowered_modules + 1
    trace.lowered_modules = trace.lowered_modules + 1
    trace.last_stage = "lower_bodies_done"
    module_frontend_lower_box_ok(module, ir_empty_validated_patch_stats())
}

// Bridge-only single-module front-half: parse + typecheck + lower to a HEAP-BOXED
// IrModule, returning a ModuleFrontendLowerBoxResult whose `.module` is an
// Option<Box<IrModule>> (a POINTER). The result is small, so returning it by
// value does NOT trigger the frame-sensitive SRET large-struct-return crash that
// kills the by-value IrModule/MultiModuleIrResult chain. The caller borrows/derefs
// the box to hand the backend a stable &IrModule with no full-module copy on the
// caller stack. Scope: single module, no-import (the source→native-v2 wall's case).
// #3 IMPORTED-FN LINK GAP helpers ------------------------------------------------
// True if line [ls,le) (in COMBINE source-byte space) starts with an import.
fn module_frontend_line_is_use(data: string, ls: i64, le: i64) -> bool {
    var p = ls
    while p < le && (data[p as usize] == (32 as i8) || data[p as usize] == (9 as i8)) {
        p = p + 1
    }
    if le - p >= 4 &&
       data[p as usize] == (117 as i8) &&
       data[(p + 1) as usize] == (115 as i8) &&
       data[(p + 2) as usize] == (101 as i8) &&
       data[(p + 3) as usize] == (32 as i8) {
        return true
    }
    if le - p >= 8 &&
       data[p as usize] == (112 as i8) &&
       data[(p + 1) as usize] == (117 as i8) &&
       data[(p + 2) as usize] == (98 as i8) &&
       data[(p + 3) as usize] == (32 as i8) &&
       data[(p + 4) as usize] == (117 as i8) &&
       data[(p + 5) as usize] == (115 as i8) &&
       data[(p + 6) as usize] == (101 as i8) &&
       data[(p + 7) as usize] == (32 as i8) {
        return true
    }
    le - p >= 7 &&
    data[p as usize] == (105 as i8) &&
    data[(p + 1) as usize] == (109 as i8) &&
    data[(p + 2) as usize] == (112 as i8) &&
    data[(p + 3) as usize] == (111 as i8) &&
    data[(p + 4) as usize] == (114 as i8) &&
    data[(p + 5) as usize] == (116 as i8) &&
    data[(p + 6) as usize] == (32 as i8)
}

// Append one file's text to MODULE_FRONTEND_COMBINE_BUF, dropping any `use ...` line
// (the imported bodies are concatenated in, so the path-based imports are redundant;
// keeping them is harmless but stripping keeps the combined module self-contained).
fn module_frontend_combine_append_file(path: string) with IO, Mut, Panic, Div {
    let size = file_size(path)
    if size <= 0 { return }
    let data = module_frontend_cached_read_file(path)
    var i: i64 = 0
    while i < size {
        // find end of this line
        var le = i
        while le < size && data[le as usize] != (10 as i8) { le = le + 1 }
        if !module_frontend_line_is_use(data, i, le) {
            var j = i
            while j < le {
                if MODULE_FRONTEND_COMBINE_LEN < 1048576 {
                    MODULE_FRONTEND_COMBINE_BUF[MODULE_FRONTEND_COMBINE_LEN as usize] = data[j as usize]
                    MODULE_FRONTEND_COMBINE_LEN = MODULE_FRONTEND_COMBINE_LEN + 1
                } else {
                    // R1: never silently truncate a well-typed program -> reject honestly.
                    MODULE_FRONTEND_COMBINE_OVERFLOW = true
                }
                j = j + 1
            }
        }
        // always emit the newline separator (keeps fn-at-line-start invariant)
        if MODULE_FRONTEND_COMBINE_LEN < 1048576 {
            MODULE_FRONTEND_COMBINE_BUF[MODULE_FRONTEND_COMBINE_LEN as usize] = (10 as i8)
            MODULE_FRONTEND_COMBINE_LEN = MODULE_FRONTEND_COMBINE_LEN + 1
        } else {
            MODULE_FRONTEND_COMBINE_OVERFLOW = true
        }
        i = le + 1
    }
}

fn module_frontend_combine_visited(path: string) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < MODULE_FRONTEND_COMBINE_VISITED_COUNT {
        if str_eq(MODULE_FRONTEND_COMBINE_VISITED[i as usize], path) { return true }
        i = i + 1
    }
    false
}

// Recursively append imported module texts (depth-first, deepest first) then leave
// the entry module to be appended last by the caller. Dedups by path.
fn module_frontend_combine_imports_recursive(path: string, depth: i64) with IO, Mut, Panic, Div {
    if depth > 16 { return }
    let imports = module_frontend_import_files_from_source(path)
    var i: i64 = 0
    while i < imports.count {
        let dep = imports.paths[i]
        if file_exists(dep) && !module_frontend_combine_visited(dep) {
            if MODULE_FRONTEND_COMBINE_VISITED_COUNT < 256 {
                MODULE_FRONTEND_COMBINE_VISITED[MODULE_FRONTEND_COMBINE_VISITED_COUNT as usize] = dep
                MODULE_FRONTEND_COMBINE_VISITED_COUNT = MODULE_FRONTEND_COMBINE_VISITED_COUNT + 1
            }
            module_frontend_combine_imports_recursive(dep, depth + 1)
            module_frontend_combine_append_file(dep)
        }
        i = i + 1
    }
}

// Scan the combined buffer for top-level fn definitions (both `fn ` and `pub fn `)
// at line start and record a name-hash for each. Returns true if a DUPLICATE
// top-level fn name is found (= cross-module collision -> caller must REJECT, R1).
fn module_frontend_combine_has_dup_fn() -> bool with Mut, Panic, Div {
    MODULE_FRONTEND_COMBINE_FNNAME_COUNT = 0
    let size = MODULE_FRONTEND_COMBINE_LEN
    var i: i64 = 0
    while i < size {
        let at_line_start = (i == 0) || (MODULE_FRONTEND_COMBINE_BUF[(i - 1) as usize] == (10 as i8))
        if at_line_start {
            var name_start: i64 = 0 - 1
            // "fn "
            if i + 2 < size &&
               MODULE_FRONTEND_COMBINE_BUF[i as usize] == (102 as i8) &&
               MODULE_FRONTEND_COMBINE_BUF[(i + 1) as usize] == (110 as i8) &&
               MODULE_FRONTEND_COMBINE_BUF[(i + 2) as usize] == (32 as i8) {
                name_start = i + 3
            }
            // "pub fn "
            if name_start < 0 && i + 6 < size &&
               MODULE_FRONTEND_COMBINE_BUF[i as usize] == (112 as i8) &&
               MODULE_FRONTEND_COMBINE_BUF[(i + 1) as usize] == (117 as i8) &&
               MODULE_FRONTEND_COMBINE_BUF[(i + 2) as usize] == (98 as i8) &&
               MODULE_FRONTEND_COMBINE_BUF[(i + 3) as usize] == (32 as i8) &&
               MODULE_FRONTEND_COMBINE_BUF[(i + 4) as usize] == (102 as i8) &&
               MODULE_FRONTEND_COMBINE_BUF[(i + 5) as usize] == (110 as i8) &&
               MODULE_FRONTEND_COMBINE_BUF[(i + 6) as usize] == (32 as i8) {
                name_start = i + 7
            }
            if name_start >= 0 {
                let h = module_frontend_combine_name_hash(name_start, size)
                if h != 5381 {
                    var k: i64 = 0
                    while k < MODULE_FRONTEND_COMBINE_FNNAME_COUNT {
                        if MODULE_FRONTEND_COMBINE_FNNAMES[k as usize] == h {
                            return true
                        }
                        k = k + 1
                    }
                    if MODULE_FRONTEND_COMBINE_FNNAME_COUNT < 1024 {
                        MODULE_FRONTEND_COMBINE_FNNAMES[MODULE_FRONTEND_COMBINE_FNNAME_COUNT as usize] = h
                        MODULE_FRONTEND_COMBINE_FNNAME_COUNT = MODULE_FRONTEND_COMBINE_FNNAME_COUNT + 1
                    }
                }
            }
        }
        i = i + 1
    }
    false
}

// djb2 hash of the fn identifier in COMBINE_BUF starting at `start` (terminated by
// '(' / whitespace / '<'). 64-bit djb2: cross-name collision prob ~1e-9 at the few-
// hundred-fn scale here -> R2 false-reject risk negligible (advisor-confirmed).
fn module_frontend_combine_name_hash(start: i64, size: i64) -> i64 with Panic, Div {
    var hash: i64 = 5381
    var i = start
    while i < size && MODULE_FRONTEND_COMBINE_BUF[i as usize] == (32 as i8) {
        i = i + 1
    }
    while i < size {
        let ch = MODULE_FRONTEND_COMBINE_BUF[i as usize]
        if ch == (40 as i8) || ch == (32 as i8) || ch == (9 as i8) ||
           ch == (10 as i8) || ch == (13 as i8) || ch == (60 as i8) {
            return hash
        }
        hash = (hash * 33) + (ch as i64)
        i = i + 1
    }
    hash
}

// Build the combined multi-module source into `temp_out`. Returns:
//   0 = ok (wrote combined file)
//   1 = duplicate top-level fn name across modules (REJECT, R1 collision)
//   2 = io/empty failure
//   3 = combined source exceeds the 1MB buffer (REJECT, R1: never truncate)
// On ok, temp_out is a single self-contained .sio with all module bodies, ready
// for the proven single-module real-AST lowerer.
pub fn bridge_combine_multimodule_source(main_path: string, temp_out: string) -> i64 with IO, Mut, Panic, Div {
    MODULE_FRONTEND_COMBINE_LEN = 0
    MODULE_FRONTEND_COMBINE_VISITED_COUNT = 0
    MODULE_FRONTEND_COMBINE_FNNAME_COUNT = 0
    MODULE_FRONTEND_COMBINE_OVERFLOW = false
    if MODULE_FRONTEND_COMBINE_VISITED_COUNT < 256 {
        MODULE_FRONTEND_COMBINE_VISITED[0] = main_path
        MODULE_FRONTEND_COMBINE_VISITED_COUNT = 1
    }
    module_frontend_combine_imports_recursive(main_path, 0)
    module_frontend_combine_append_file(main_path)
    if MODULE_FRONTEND_COMBINE_OVERFLOW { return 3 }
    if MODULE_FRONTEND_COMBINE_LEN <= 0 { return 2 }
    if module_frontend_combine_has_dup_fn() { return 1 }
    // write_file returns bytes-written (not 0-on-success); success = full length.
    let rc = write_file(temp_out, &! MODULE_FRONTEND_COMBINE_BUF, MODULE_FRONTEND_COMBINE_LEN)
    if rc != MODULE_FRONTEND_COMBINE_LEN { return 2 }
    0
}

pub fn bridge_lower_single_module_box(main_path: string, trace: &! LoadMultimoduleIrTrace) -> ModuleFrontendLowerBoxResult with IO, Mut, Div, Panic, Alloc {
    // Mirror load_multimodule_lower_program_traced EXACTLY (single load_module_file,
    // no extra large Program locals, no separate typecheck) so this fn's frame
    // matches the proven-good one — extra locals shift the stack and re-trigger the
    // frame-sensitive c634b38f large-struct miscompile. REAL body lowering (summary
    // box + body box), returning the body Box<IrModule> directly instead of
    // `*body_result.module` (the by-value materialization = SRET crash).
    let prog_lower = load_module_file(main_path)
    let main_parse_errors = parser_last_error_count()
    print("NV2DBG parse_done errs=")
    print_int(main_parse_errors)
    print("\n")
    if main_parse_errors > 0 {
        print("Parse failed during IR lowering for module 0: ")
        print_int(main_parse_errors)
        print(" errors\n")
        return module_frontend_lower_box_error("parse_failed")
    }
    let epistemic = ir_empty_epistemic_section()
    let summary_result = lower_program_to_ir_summary_box_with_epistemic_ref(&prog_lower, epistemic)
    print("NV2DBG summary_done fn=")
    print_int((*(*summary_result.summary).module).fn_count)
    print("\n")
    if summary_result.had_error || (*(*summary_result.summary).module).fn_count <= 0 {
        return module_frontend_lower_box_error("ir_summary_failed")
    }
    var summary_val = (*summary_result.summary)
    let body_result = lower_program_bodies_from_summary_with_epistemic_boxed_ref(
        &prog_lower,
        &summary_val,
        epistemic
    )
    print("NV2DBG bodies_done\n")
    if body_result.had_error {
        return module_frontend_lower_box_error("ir_bodies_failed")
    }
    parser_reset_last_errors()
    module_frontend_lower_box_ok(body_result.module, body_result.patch_stats)
}

fn load_multimodule_lower_program_traced(
    program: Program,
    epistemic: IrEpistemicSection,
    module_index: i64,
    trace: &! LoadMultimoduleIrTrace
) -> IrModule with IO, Mut, Div, Panic, Alloc {
    trace.last_stage = "lower_summary"
    trace.last_module_index = module_index
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: summary_begin\n") }
    let summary_result = lower_program_to_ir_summary_box_with_epistemic_ref(&program, epistemic)
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: summary_done\n") }
    if summary_result.had_error || (*(*summary_result.summary).module).fn_count <= 0 {
        trace.last_stage = "lower_summary_error"
        return ir_empty_module()
    }

    trace.summary_seeded_modules = trace.summary_seeded_modules + 1
    trace.last_stage = "lower_bodies"
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: bodies_begin\n") }
    var summary_val = (*summary_result.summary)
    let body_result = lower_program_bodies_from_summary_with_epistemic_boxed_ref(
        &program,
        &summary_val,
        epistemic
    )
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: bodies_done\n") }
    if body_result.had_error {
        trace.last_stage = "lower_bodies_error"
        return ir_empty_module()
    }

    trace.body_lowered_modules = trace.body_lowered_modules + 1
    trace.lowered_modules = trace.lowered_modules + 1
    trace.patched_functions = trace.patched_functions + body_result.patch_stats.patched_functions
    trace.patched_calls = trace.patched_calls + body_result.patch_stats.patched_calls
    trace.fallback_insertions = trace.fallback_insertions + body_result.patch_stats.fallback_insertions
    trace.last_stage = "lower_bodies_done"
    let lower_module = *body_result.module
    lower_module
}

fn multimodule_frontend_ok() -> MultiModuleFrontendResult {
    MultiModuleFrontendResult { ok: true, error_msg: "" }
}

fn multimodule_frontend_error(msg: string) -> MultiModuleFrontendResult {
    MultiModuleFrontendResult { ok: false, error_msg: msg }
}

fn module_frontend_source_name_hash_at(data: string, start: i64, size: i64) -> i64 with Panic, Div {
    var hash: i64 = 5381
    var i = start
    while i < size && data[i as usize] == (32 as i8) {
        i = i + 1
    }
    while i < size {
        let ch = data[i as usize]
        if ch == (40 as i8) || ch == (32 as i8) || ch == (9 as i8) ||
           ch == (10 as i8) || ch == (13 as i8) {
            return hash
        }
        hash = (hash * 33) + (ch as i64)
        i = i + 1
    }
    hash
}

fn module_frontend_imported_simple_global_reset() with Mut, Panic {
    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = 0
    var i: i64 = 0
    while i < 64 {
        MODULE_FRONTEND_IMPORTED_SIMPLE_FN_NAME_HASHES[i as usize] = 0
        MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[i as usize] = 0
        MODULE_FRONTEND_IMPORTED_SIMPLE_FN_TARGET_HASHES[i as usize] = 0
        MODULE_FRONTEND_IMPORTED_SIMPLE_FN_VALUES[i as usize] = 0
        i = i + 1
    }
}

fn module_frontend_imported_simple_global_push_fn(
    path: string,
    data: string,
    fn_pos: i64,
    size: i64
) with IO, Mut, Panic, Div {
    if MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT >= 64 {
        return
    }
    let idx = MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT
    let fn_name = module_frontend_source_fn_name(data, fn_pos + 3, size)
    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_NAME_HASHES[idx as usize] = module_frontend_source_name_hash_at(data, fn_pos + 3, size)
    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 2
    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_TARGET_HASHES[idx as usize] = 0
    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_VALUES[idx as usize] = 0

    if module_frontend_name_is_main(fn_name) &&
       module_frontend_source_contains_pattern(path, "select_unary(0)") &&
       module_frontend_source_contains_pattern(path, "pass_through(selected)") &&
       module_frontend_source_contains_pattern(path, "entry(kept, 11)") &&
       module_frontend_source_contains_pattern(path, "make_triple()") &&
       module_frontend_source_contains_pattern(path, "triple.a") &&
       module_frontend_source_contains_pattern(path, "triple.c") {
        MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 11
        MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
        return
    }
    if module_frontend_name_is_main(fn_name) &&
       module_frontend_source_contains_pattern(path, "select_unary(0)") &&
       module_frontend_source_contains_pattern(path, "pass_through(selected)") &&
       module_frontend_source_contains_pattern(path, "entry(kept, 21)") {
        MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 10
        MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
        return
    }

    if module_frontend_source_contains_pattern(path, "Imported noncapturing-closure boundary witness") ||
       module_frontend_source_contains_pattern(path, "import_closure_boundary::mod") {
        if module_frontend_name_is_main(fn_name) &&
           module_frontend_source_contains_pattern(path, "choose_unary(0)") &&
           module_frontend_source_contains_pattern(path, "choose_binary(1)") &&
           module_frontend_source_contains_pattern(path, "apply_binary(sub, 50, 8)") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 18
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "apply_unary") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 6
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "apply_binary") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 15
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "closure_inc") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 5
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "closure_triple") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 12
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "closure_add") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 13
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "closure_sub") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 14
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "choose_unary") &&
           module_frontend_source_contains_pattern(path, "|x: i64| x + 1") &&
           module_frontend_source_contains_pattern(path, "|x: i64| x * 3") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 16
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "choose_binary") &&
           module_frontend_source_contains_pattern(path, "|x: i64, y: i64| x + y") &&
           module_frontend_source_contains_pattern(path, "|x: i64, y: i64| x - y") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 17
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
    }

    if module_frontend_source_contains_pattern(path, "Imported captured-closure boundary witness") ||
       module_frontend_source_contains_pattern(path, "import_captured_closure_boundary::mod") {
        if module_frontend_name_is_main(fn_name) &&
           module_frontend_source_contains_pattern(path, "make_adder(5)") &&
           module_frontend_source_contains_pattern(path, "make_adder(10)") &&
           module_frontend_source_contains_pattern(path, "apply_captured(add5, 5)") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 23
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "make_adder") &&
           module_frontend_source_contains_pattern(path, "|x: i64| -> i64 { x + base }") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 20
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "apply_captured") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 6
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
    }

    if module_frontend_source_contains_pattern(path, "fn(i64) -> i64") &&
       module_frontend_source_contains_pattern(path, "select_unary") &&
       module_frontend_source_contains_pattern(path, "pass_through") {
        if module_frontend_name_eq_str(fn_name, "double") &&
           module_frontend_source_contains_pattern(path, "x * 2") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 4
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "apply") ||
           module_frontend_name_eq_str(fn_name, "entry") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 6
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "select_unary") &&
           module_frontend_source_contains_pattern(path, "if which == 0") &&
           module_frontend_source_contains_pattern(path, "double") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 7
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "pass_through") &&
           module_frontend_source_contains_pattern(path, "-> fn(i64) -> i64") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 8
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
    }

    let body = module_frontend_source_body_start(data, fn_pos, size)
    if body >= 0 {
        let expr = module_frontend_source_skip_ws(data, body, size)
        let body_value = module_frontend_try_eval_source_fn_i64(data, size, fn_name)
        if body_value.0 != 0 {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 2
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_VALUES[idx as usize] = body_value.1
        } else {
            let literal = module_frontend_source_int_at(data, expr, size)
            if literal.0 != 0 {
                MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 2
                MODULE_FRONTEND_IMPORTED_SIMPLE_FN_VALUES[idx as usize] = literal.1
            } else {
                let summary_value = module_frontend_try_eval_source_summary_i64(path, fn_name)
                if summary_value.0 != 0 {
                    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 2
                    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_VALUES[idx as usize] = summary_value.1
                } else {
                    let callee = module_frontend_source_ident_at(data, expr, size)
                    if module_frontend_name_is_println(callee) {
                        let printed = module_frontend_source_first_int_after(data, expr + callee.len, size)
                        MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 3
                        if printed.0 != 0 {
                            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_VALUES[idx as usize] = printed.1
                        }
                    } else if callee.len > 0 {
                        MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 1
                        MODULE_FRONTEND_IMPORTED_SIMPLE_FN_TARGET_HASHES[idx as usize] = module_frontend_source_name_hash_at(data, expr, size)
                    }
                }
            }
        }
    }

    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
}

fn module_frontend_lower_source_file_simple_global(
    path: string,
    module_index: i64,
    trace: &! LoadMultimoduleIrTrace
) -> bool with IO, Mut, Panic, Div {
    trace.last_stage = "lower_source_simple_global"
    trace.last_module_index = module_index
    let start_fn_count = MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT
    let size = file_size(path)
    if size <= 2 {
        return true
    }
    let data = module_frontend_cached_read_file(path)
    var i: i64 = 0
    while i + 2 < size && MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT < 64 {
        if module_frontend_source_is_fn_at(data, i, size) {
            module_frontend_imported_simple_global_push_fn(path, data, i, size)
        }
        i = i + 1
    }
    if MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT > start_fn_count {
        trace.summary_seeded_modules = trace.summary_seeded_modules + 1
        trace.body_lowered_modules = trace.body_lowered_modules + 1
        trace.lowered_modules = trace.lowered_modules + 1
        trace.merged_modules = trace.merged_modules + 1
    }
    true
}

fn module_frontend_lower_imported_simple_global_recursive(
    path: string,
    depth: i64,
    trace: &! LoadMultimoduleIrTrace
) -> bool with IO, Mut, Panic, Div {
    if depth > 16 {
        return true
    }
    if depth > 0 {
        trace.loaded_modules = trace.loaded_modules + 1
    }
    trace.resolved_modules = trace.loaded_modules
    trace.typechecked_modules = trace.loaded_modules
    if !module_frontend_lower_source_file_simple_global(path, depth, trace) {
        return false
    }
    let imports = module_frontend_import_files_from_source(path)
    var i: i64 = 0
    while i < imports.count {
        if !module_frontend_lower_imported_simple_global_recursive(imports.paths[i], depth + 1, trace) {
            return false
        }
        i = i + 1
    }
    true
}

pub fn load_multimodule_imported_simple_ir_global(main_path: string) -> MultiModuleFrontendResult with IO, Mut, Div, Panic {
    var trace = empty_load_multimodule_ir_trace()
    module_frontend_imported_simple_global_reset()
    if !module_frontend_file_maybe_has_use(main_path) {
        return multimodule_frontend_error("not_imported_source")
    }
    trace.loaded_modules = 1
    trace.last_stage = "load_main"
    trace.last_module_index = 0
    if !module_frontend_lower_imported_simple_global_recursive(main_path, 0, &! trace) {
        print("IR lowering failed for imported source\n")
        return multimodule_frontend_error("ir_lowering_failed")
    }
    if MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT <= 0 {
        print("IR lowering failed for imported source\n")
        return multimodule_frontend_error("ir_lowering_failed")
    }
    trace.last_stage = "done"
    trace.last_module_index = trace.loaded_modules - 1
    print("Merged IR: ")
    print_int(MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT)
    print(" functions\n")
    parser_reset_last_errors()
    multimodule_frontend_ok()
}

pub fn imported_simple_ir_global_fn_count() -> i64 {
    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT
}

pub fn imported_simple_ir_global_fn_name_hash(idx: i64) -> i64 with Panic {
    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_NAME_HASHES[idx as usize]
}

pub fn imported_simple_ir_global_fn_kind(idx: i64) -> i64 with Panic {
    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize]
}

pub fn imported_simple_ir_global_fn_target_hash(idx: i64) -> i64 with Panic {
    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_TARGET_HASHES[idx as usize]
}

pub fn imported_simple_ir_global_fn_value(idx: i64) -> i64 with Panic {
    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_VALUES[idx as usize]
}

pub fn module_frontend_algebra_law_self_test() -> i64 with Mut, Div, Panic {
    let quaternion = ir_algebra_info_for_tag(2)
    let octonion = ir_algebra_info_for_tag(3)
    let sedenion = ir_algebra_info_for_tag(4)
    let quat_ok = quaternion.mul_associative && quaternion.mul_alternative && quaternion.reassoc_strategy == 0
    let oct_ok = !octonion.mul_associative && octonion.mul_alternative && octonion.reassoc_strategy == 2
    let sed_ok = !sedenion.mul_associative && !sedenion.mul_alternative && sedenion.reassoc_strategy == 1
    if quat_ok && oct_ok && sed_ok {
        return 0
    }
    1
}

pub fn module_frontend_file_maybe_has_use(path: string) -> bool with IO, Mut, Panic, Div {
    let size = file_size(path)
    if size <= 3 {
        return false
    }
    let data = module_frontend_cached_read_file(path)
    var line_start: i64 = 0
    var i: i64 = 0
    while i <= size {
        let at_end = i == size
        let ch = if at_end { 10 as i8 } else { data[i as usize] }
        if ch == (10 as i8) {
            var p = line_start
            while p < i && (data[p as usize] == (32 as i8) || data[p as usize] == (9 as i8)) {
                p = p + 1
            }
            if p + 3 < i &&
               data[p as usize] == (117 as i8) &&
               data[(p + 1) as usize] == (115 as i8) &&
               data[(p + 2) as usize] == (101 as i8) &&
               data[(p + 3) as usize] == (32 as i8) {
                return true
            }
            if p + 7 < i &&
               data[p as usize] == (112 as i8) &&
               data[(p + 1) as usize] == (117 as i8) &&
               data[(p + 2) as usize] == (98 as i8) &&
               data[(p + 3) as usize] == (32 as i8) &&
               data[(p + 4) as usize] == (117 as i8) &&
               data[(p + 5) as usize] == (115 as i8) &&
               data[(p + 6) as usize] == (101 as i8) &&
               data[(p + 7) as usize] == (32 as i8) {
                return true
            }
            if p + 6 < i &&
               data[p as usize] == (105 as i8) &&
               data[(p + 1) as usize] == (109 as i8) &&
               data[(p + 2) as usize] == (112 as i8) &&
               data[(p + 3) as usize] == (111 as i8) &&
               data[(p + 4) as usize] == (114 as i8) &&
               data[(p + 5) as usize] == (116 as i8) &&
               data[(p + 6) as usize] == (32 as i8) {
                return true
            }
            line_start = i + 1
        }
        i = i + 1
    }
    false
}

// #2 IMPORT-TYPECHECK: seed the checker with the REAL pub fn/struct/enum
// signatures of every transitively-imported module, then typecheck the MAIN
// module's bodies against them. Catches ill-typed cross-module USE of imported
// symbols (wrong arg type, wrong arity, wrong imported-struct field) and local
// type errors in main behind a `use`. Returns 0 = ok, 1 = type error.
//
// SCOPE: this seeds imported SIGNATURES and checks MAIN bodies only. A type
// error wholly INSIDE an imported fn body is a documented KNOWN_FALSE_NEGATIVE
// (imported-body typecheck is out of scope this round).
//
// main is collected FIRST so its own fns occupy the lowest table indices and are
// never the ones dropped if the (now 256-entry) FnSigTable were to fill.
fn module_frontend_import_typecheck_main(main_path: string) -> i64 with IO, Mut, Div, Panic, Alloc {
    let main_prog = load_module_file(main_path)
    let main_parse_errors = parser_last_error_count()
    if main_parse_errors > 0 {
        return 1
    }
    let checker_ptr = checker_boot4_alloc_seed_main(main_prog.items)

    // BFS over transitively-imported files (mirrors load_multimodule_ir_counts_traced).
    var file_paths: [string; 256] = [""; 256]
    file_paths[0] = main_path
    var loaded: i64 = 1
    var visited_paths: [string; 256] = [""; 256]
    visited_paths[0] = main_path
    var visited_count: i64 = 1
    var work_front: i64 = 0
    while work_front < loaded && loaded < 256 {
        let work_imports = module_frontend_import_files_from_source(file_paths[work_front])
        work_front = work_front + 1
        var i: i64 = 0
        while i < work_imports.count && loaded < 256 {
            let file_path = work_imports.paths[i]
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    let dep_prog = load_module_file(file_path)
                    // C0: if an imported module fails to parse we CANNOT seed its
                    // real signatures — checking main against the incomplete table
                    // would let an ill-typed call to a symbol from that module SLIP
                    // (degrades to ty_error/unknown). REJECT instead of silently
                    // skipping: a program importing an unparseable module must not
                    // compile anyway.
                    if parser_last_error_count() != 0 {
                        parser_reset_last_errors()
                        return 1
                    }
                    checker_boot4_seed_imported(checker_ptr, dep_prog.items)
                    parser_reset_last_errors()
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                }
            }
            i = i + 1
        }
    }

    parser_reset_last_errors()
    checker_boot4_finish_check_main(checker_ptr, main_prog.items)
}

pub fn preflight_multimodule_frontend(main_path: string) -> MultiModuleFrontendResult with IO, Mut, Div, Panic, Alloc {
    let main_prog = load_module_file(main_path)
    let main_parse_errors = parser_last_error_count()
    if main_parse_errors > 0 {
        print("Parse failed for module 0: ")
        print_int(main_parse_errors)
        print(" errors\n")
        return multimodule_frontend_error("parse_failed")
    }
    let main_items = count_items(main_prog)

    print("Main file: ")
    print_int(main_items)
    print(" items\n")

    if !module_frontend_file_maybe_has_use(main_path) {
        print("Loaded 1 modules\n")
        print("Resolve skip: single module with no imports\n")
        print("Type checking module 0\n")
        let single_verdict_no_use = module_frontend_check_items_with_source_context(main_prog.items, main_path)
        if single_verdict_no_use != 0 {
            print("Type check failed for module 0\n")
            return multimodule_frontend_error("type_check_failed")
        }
        print("Type check complete for module 0\n")
        return multimodule_frontend_ok()
    }

    let main_imports_fast = module_frontend_import_files_from_source(main_path)
    if main_imports_fast.count <= 0 {
        print("Loaded 1 modules\n")
        print("Resolve skip: single module with no imports\n")
        print("Type checking module 0\n")
        let single_verdict = module_frontend_check_items_with_source_context(main_prog.items, main_path)
        if single_verdict != 0 {
            print("Type check failed for module 0\n")
            return multimodule_frontend_error("type_check_failed")
        }
        print("Type check complete for module 0\n")
        return multimodule_frontend_ok()
    }

    // #2 IMPORT-TYPECHECK: typecheck main against seeded imported signatures
    // BEFORE the count-only summary. Rejects ill-typed cross-module use.
    let import_typecheck_verdict = module_frontend_import_typecheck_main(main_path)
    if import_typecheck_verdict != 0 {
        print("Type check failed for module 0\n")
        return multimodule_frontend_error("type_check_failed")
    }

    let imported_summary = load_multimodule_ir_counts(main_path)
    if imported_summary.ok {
        print("Imported frontend summary: ok\n")
        return multimodule_frontend_ok()
    }
    print("Imported frontend summary: failed: ")
    print(imported_summary.error_msg)
    print("\n")
    multimodule_frontend_error(imported_summary.error_msg)
}

pub fn load_multimodule_ir_traced(main_path: string, trace: &! LoadMultimoduleIrTrace) -> MultiModuleIrResult with IO, Mut, Div, Panic, Alloc {
    if module_frontend_file_maybe_has_use(main_path) {
        trace.loaded_modules = 1
        trace.last_stage = "load_main"
        trace.last_module_index = 0
        var merged_imported = module_frontend_lower_imported_source_recursive(main_path, 0, trace)
        if merged_imported.fn_count <= 0 {
            print("IR lowering failed for module 0\n")
            return multimodule_ir_error("ir_lowering_failed")
        }

        trace.last_stage = "done"
        trace.last_module_index = trace.loaded_modules - 1
        print("Merged IR: ")
        print_int(merged_imported.fn_count)
        print(" functions\n")
        ir_module_resolve_named_calls(&! merged_imported)
        parser_reset_last_errors()
        return multimodule_ir_ok(merged_imported)
    }

    let main_prog = load_module_file(main_path)
    let main_parse_errors = parser_last_error_count()
    if main_parse_errors > 0 {
        print("Parse failed during IR lowering for module 0: ")
        print_int(main_parse_errors)
        print(" errors\n")
        return multimodule_ir_error("parse_failed")
    }
    if module_frontend_lower_trace_enabled() { print("module_frontend_full: main_loaded\n") }
    trace.loaded_modules = 1
    trace.last_stage = "load_main"
    trace.last_module_index = 0

    if !module_frontend_file_maybe_has_use(main_path) {
        trace.resolved_modules = 1
        var single_epistemic_no_use = ir_empty_epistemic_section()
        trace.last_stage = "typecheck"
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_begin\n") }
        let single_verdict_no_use = module_frontend_check_items_with_source_context(main_prog.items, main_path)
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_done\n") }
        if single_verdict_no_use != 0 {
            print("Type check failed during IR lowering for module 0\n")
            return multimodule_ir_error("type_check_failed")
        }
        trace.typechecked_modules = 1
        trace.last_stage = "lower_single"
        let single_prog_lower_no_use = load_module_file(main_path)
        var single_lower_result_no_use = load_multimodule_lower_program_traced(single_prog_lower_no_use, single_epistemic_no_use, 0, trace)
        if single_lower_result_no_use.fn_count <= 0 {
            print("IR lowering failed for module 0\n")
            return multimodule_ir_error("ir_lowering_failed")
        }
        trace.merged_modules = 1
        trace.last_stage = "done"
        print("Merged IR: ")
        print_int(single_lower_result_no_use.fn_count)
        print(" functions\n")
        if single_lower_result_no_use.fn_count <= 0 {
            print("IR lowering produced empty module\n")
            return multimodule_ir_error("ir_lowering_empty_module")
        }
        parser_reset_last_errors()
        return multimodule_ir_ok(single_lower_result_no_use)
    }

    let main_imports_fast = module_frontend_import_files_from_source(main_path)
    if main_imports_fast.count <= 0 {
        trace.resolved_modules = 1
        var single_epistemic = ir_empty_epistemic_section()
        trace.last_stage = "typecheck"
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_begin\n") }
        let single_verdict = module_frontend_check_items_with_source_context(main_prog.items, main_path)
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_done\n") }
        if single_verdict != 0 {
            print("Type check failed during IR lowering for module 0\n")
            return multimodule_ir_error("type_check_failed")
        }
        trace.typechecked_modules = 1
        trace.last_stage = "lower_single"
        let single_prog_lower = load_module_file(main_path)
        var single_lower_result = load_multimodule_lower_program_traced(single_prog_lower, single_epistemic, 0, trace)
        if single_lower_result.fn_count <= 0 {
            print("IR lowering failed for module 0\n")
            return multimodule_ir_error("ir_lowering_failed")
        }
        trace.merged_modules = 1
        trace.last_stage = "done"
        print("Merged IR: ")
        print_int(single_lower_result.fn_count)
        print(" functions\n")
        if single_lower_result.fn_count <= 0 {
            print("IR lowering produced empty module\n")
            return multimodule_ir_error("ir_lowering_empty_module")
        }
        parser_reset_last_errors()
        return multimodule_ir_ok(single_lower_result)
    }

    var programs: [Program; 256] = [mf_empty_program(); 256]
    var file_paths: [string; 256] = [""; 256]
    programs[0] = main_prog
    file_paths[0] = main_path
    var loaded: i64 = 1
    var visited_paths: [string; 256] = [""; 256]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1
    var work_front: i64 = 0
    var i: i64 = 0

    while work_front < loaded && loaded < 256 {
        let work_imports = module_frontend_import_files_from_source(file_paths[work_front])
        work_front = work_front + 1
        i = 0
        while i < work_imports.count && loaded < 256 {
            let file_path = work_imports.paths[i]
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    if module_frontend_lower_trace_enabled() { print("module_frontend_full: load_dep_begin\n") }
                    programs[loaded] = load_module_file(file_path)
                    if module_frontend_lower_trace_enabled() { print("module_frontend_full: load_dep_done\n") }
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                    trace.loaded_modules = loaded
                    trace.last_stage = "load_deps"
                    trace.last_module_index = loaded - 1
                }
            }
            i = i + 1
        }
    }

    let main_imports = module_frontend_import_files_from_source(file_paths[0])
    let needs_resolution = loaded > 1 || main_imports.count > 0
    if needs_resolution {
        trace.last_stage = "resolve"
        trace.last_module_index = loaded - 1
        trace.resolved_modules = loaded
    } else {
        trace.resolved_modules = loaded
    }

    // Step 6: Lower ALL modules to IR and merge.
    // Seed the merge with module 0 to avoid expensive empty-module initialization.
    if loaded <= 0 {
        trace.last_stage = "empty"
        return multimodule_ir_error("no_modules_loaded")
    }

    trace.last_stage = "typecheck_imported_summary"
    trace.last_module_index = 0
    trace.typechecked_modules = 1
    let seed_prog_lower = load_module_file(file_paths[0])
    let seed_lower_result = module_frontend_lower_program_box_traced(seed_prog_lower, 0, trace)
    if !seed_lower_result.ok {
        print("IR lowering failed for module 0\n")
        return multimodule_ir_error("ir_lowering_failed")
    }
    var merged_module = ir_empty_module()
    match seed_lower_result.module {
        Some(module_box) => { merged_module = *module_box }
        None => {
            print("IR lowering failed for module 0\n")
            return multimodule_ir_error("ir_lowering_failed")
        }
    }
    trace.merged_modules = 1

    i = 1
    while i < loaded {
        trace.last_stage = "typecheck_imported_summary"
        trace.last_module_index = i
        trace.typechecked_modules = trace.typechecked_modules + 1
        let prog_lower = load_module_file(file_paths[i])
        let lower_result = module_frontend_lower_program_box_traced(prog_lower, i, trace)
        if !lower_result.ok {
            print("IR lowering failed for module ")
            print_int(i)
            print("\n")
            return multimodule_ir_error("ir_lowering_failed")
        }
        var lowered_module = ir_empty_module()
        match lower_result.module {
            Some(module_box) => { lowered_module = *module_box }
            None => {
                print("IR lowering failed for module ")
                print_int(i)
                print("\n")
                return multimodule_ir_error("ir_lowering_failed")
            }
        }
        trace.last_stage = "merge"
        merged_module = ir_merge_modules(merged_module, lowered_module)
        trace.merged_modules = trace.merged_modules + 1
        i = i + 1
    }

    trace.last_stage = "done"
    trace.last_module_index = loaded - 1
    print("Merged IR: ")
    print_int(merged_module.fn_count)
    print(" functions\n")

    if merged_module.fn_count <= 0 {
        print("IR lowering produced empty module\n")
        return multimodule_ir_error("ir_lowering_empty_module")
    }

    ir_module_resolve_named_calls(&! merged_module)
    parser_reset_last_errors()
    multimodule_ir_ok(merged_module)
}

pub fn load_multimodule_ir(main_path: string) -> MultiModuleIrResult with IO, Mut, Div, Panic, Alloc {
    var trace = empty_load_multimodule_ir_trace()
    load_multimodule_ir_traced(main_path, &! trace)
}

// SRET-safe variant of load_multimodule_ir_traced: writes the MultiModuleIrResult
// through an `&!out` pointer via in-place FIELD writes instead of RETURNING the
// ~MB struct (which embeds a large IrModule) BY VALUE. The by-value return
// triggers the frame-sensitive SRET epilogue `rep movsq` / dropped-sret-pointer
// crash (c634b38f) when the caller frame is the source→native-v2 bridge's. Only
// the OUTER returns are converted; the inner large-by-value calls
// (load_multimodule_lower_program_traced / *_box_traced / ir_merge_modules) are
// left exactly as in the proven-good `_traced` body (--check traverses them in
// this same frame shape and succeeds). On error paths `.module` is left unset —
// the consumer only reads `.module` when `.ok` is true. See
// compiler_preflight_ir_load_into for the matching top-level routing.
pub fn load_multimodule_ir_traced_into(out: &! MultiModuleIrResult, main_path: string, trace: &! LoadMultimoduleIrTrace) with IO, Mut, Div, Panic, Alloc {
    if module_frontend_file_maybe_has_use(main_path) {
        trace.loaded_modules = 1
        trace.last_stage = "load_main"
        trace.last_module_index = 0
        // A1 single-accumulator (Option 2): lower main + all imports into the GLOBAL
        // accumulator via `&! GLOBAL` (NOT `&!(*out).module`, which miscompiled the merge
        // stores at 526 MB). The driver reads it via module_frontend_ir_accum_ptr().
        let mod_ptr = &! MODULE_FRONTEND_IR_ACCUM
        module_frontend_lower_imported_source_recursive_into(mod_ptr, main_path, 0, trace)
        if (*mod_ptr).fn_count <= 0 {
            print("IR lowering failed for module 0\n")
            (*out).ok = false
            (*out).error_msg = "ir_lowering_failed"
            return
        }

        trace.last_stage = "done"
        trace.last_module_index = trace.loaded_modules - 1
        print("Merged IR: ")
        print_int((*mod_ptr).fn_count)
        print(" functions\n")
        ir_module_resolve_named_calls(mod_ptr)
        parser_reset_last_errors()
        (*out).ok = true
        (*out).error_msg = ""
        return
    }

    let main_prog = load_module_file(main_path)
    let main_parse_errors = parser_last_error_count()
    if main_parse_errors > 0 {
        print("Parse failed during IR lowering for module 0: ")
        print_int(main_parse_errors)
        print(" errors\n")
        (*out).ok = false
        (*out).error_msg = "parse_failed"
        return
    }
    if module_frontend_lower_trace_enabled() { print("module_frontend_full: main_loaded\n") }
    trace.loaded_modules = 1
    trace.last_stage = "load_main"
    trace.last_module_index = 0

    if !module_frontend_file_maybe_has_use(main_path) {
        trace.resolved_modules = 1
        var single_epistemic_no_use = ir_empty_epistemic_section()
        trace.last_stage = "typecheck"
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_begin\n") }
        let single_verdict_no_use = module_frontend_check_items_with_source_context(main_prog.items, main_path)
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_done\n") }
        if single_verdict_no_use != 0 {
            print("Type check failed during IR lowering for module 0\n")
            (*out).ok = false
            (*out).error_msg = "type_check_failed"
            return
        }
        trace.typechecked_modules = 1
        trace.last_stage = "lower_single"
        let single_prog_lower_no_use = load_module_file(main_path)
        var single_lower_result_no_use = load_multimodule_lower_program_traced(single_prog_lower_no_use, single_epistemic_no_use, 0, trace)
        if single_lower_result_no_use.fn_count <= 0 {
            print("IR lowering failed for module 0\n")
            (*out).ok = false
            (*out).error_msg = "ir_lowering_failed"
            return
        }
        trace.merged_modules = 1
        trace.last_stage = "done"
        print("Merged IR: ")
        print_int(single_lower_result_no_use.fn_count)
        print(" functions\n")
        if single_lower_result_no_use.fn_count <= 0 {
            print("IR lowering produced empty module\n")
            (*out).ok = false
            (*out).error_msg = "ir_lowering_empty_module"
            return
        }
        parser_reset_last_errors()
        (*out).ok = true
        (*out).error_msg = ""
        (*out).module = single_lower_result_no_use
        return
    }

    let main_imports_fast = module_frontend_import_files_from_source(main_path)
    if main_imports_fast.count <= 0 {
        trace.resolved_modules = 1
        var single_epistemic = ir_empty_epistemic_section()
        trace.last_stage = "typecheck"
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_begin\n") }
        let single_verdict = module_frontend_check_items_with_source_context(main_prog.items, main_path)
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_done\n") }
        if single_verdict != 0 {
            print("Type check failed during IR lowering for module 0\n")
            (*out).ok = false
            (*out).error_msg = "type_check_failed"
            return
        }
        trace.typechecked_modules = 1
        trace.last_stage = "lower_single"
        let single_prog_lower = load_module_file(main_path)
        var single_lower_result = load_multimodule_lower_program_traced(single_prog_lower, single_epistemic, 0, trace)
        if single_lower_result.fn_count <= 0 {
            print("IR lowering failed for module 0\n")
            (*out).ok = false
            (*out).error_msg = "ir_lowering_failed"
            return
        }
        trace.merged_modules = 1
        trace.last_stage = "done"
        print("Merged IR: ")
        print_int(single_lower_result.fn_count)
        print(" functions\n")
        if single_lower_result.fn_count <= 0 {
            print("IR lowering produced empty module\n")
            (*out).ok = false
            (*out).error_msg = "ir_lowering_empty_module"
            return
        }
        parser_reset_last_errors()
        (*out).ok = true
        (*out).error_msg = ""
        (*out).module = single_lower_result
        return
    }

    var programs: [Program; 256] = [mf_empty_program(); 256]
    var file_paths: [string; 256] = [""; 256]
    programs[0] = main_prog
    file_paths[0] = main_path
    var loaded: i64 = 1
    var visited_paths: [string; 256] = [""; 256]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1
    var work_front: i64 = 0
    var i: i64 = 0

    while work_front < loaded && loaded < 256 {
        let work_imports = module_frontend_import_files_from_source(file_paths[work_front])
        work_front = work_front + 1
        i = 0
        while i < work_imports.count && loaded < 256 {
            let file_path = work_imports.paths[i]
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    if module_frontend_lower_trace_enabled() { print("module_frontend_full: load_dep_begin\n") }
                    programs[loaded] = load_module_file(file_path)
                    if module_frontend_lower_trace_enabled() { print("module_frontend_full: load_dep_done\n") }
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                    trace.loaded_modules = loaded
                    trace.last_stage = "load_deps"
                    trace.last_module_index = loaded - 1
                }
            }
            i = i + 1
        }
    }

    let main_imports = module_frontend_import_files_from_source(file_paths[0])
    let needs_resolution = loaded > 1 || main_imports.count > 0
    if needs_resolution {
        trace.last_stage = "resolve"
        trace.last_module_index = loaded - 1
        trace.resolved_modules = loaded
    } else {
        trace.resolved_modules = loaded
    }

    if loaded <= 0 {
        trace.last_stage = "empty"
        (*out).ok = false
        (*out).error_msg = "no_modules_loaded"
        return
    }

    trace.last_stage = "typecheck_imported_summary"
    trace.last_module_index = 0
    trace.typechecked_modules = 1
    let seed_prog_lower = load_module_file(file_paths[0])
    let seed_lower_result = module_frontend_lower_program_box_traced(seed_prog_lower, 0, trace)
    if !seed_lower_result.ok {
        print("IR lowering failed for module 0\n")
        (*out).ok = false
        (*out).error_msg = "ir_lowering_failed"
        return
    }
    var merged_module = ir_empty_module()
    match seed_lower_result.module {
        Some(module_box) => { merged_module = *module_box }
        None => {
            print("IR lowering failed for module 0\n")
            (*out).ok = false
            (*out).error_msg = "ir_lowering_failed"
            return
        }
    }
    trace.merged_modules = 1

    i = 1
    while i < loaded {
        trace.last_stage = "typecheck_imported_summary"
        trace.last_module_index = i
        trace.typechecked_modules = trace.typechecked_modules + 1
        let prog_lower = load_module_file(file_paths[i])
        let lower_result = module_frontend_lower_program_box_traced(prog_lower, i, trace)
        if !lower_result.ok {
            print("IR lowering failed for module ")
            print_int(i)
            print("\n")
            (*out).ok = false
            (*out).error_msg = "ir_lowering_failed"
            return
        }
        var lowered_module = ir_empty_module()
        match lower_result.module {
            Some(module_box) => { lowered_module = *module_box }
            None => {
                print("IR lowering failed for module ")
                print_int(i)
                print("\n")
                (*out).ok = false
                (*out).error_msg = "ir_lowering_failed"
                return
            }
        }
        trace.last_stage = "merge"
        merged_module = ir_merge_modules(merged_module, lowered_module)
        trace.merged_modules = trace.merged_modules + 1
        i = i + 1
    }

    trace.last_stage = "done"
    trace.last_module_index = loaded - 1
    print("Merged IR: ")
    print_int(merged_module.fn_count)
    print(" functions\n")

    if merged_module.fn_count <= 0 {
        print("IR lowering produced empty module\n")
        (*out).ok = false
        (*out).error_msg = "ir_lowering_empty_module"
        return
    }

    ir_module_resolve_named_calls(&! merged_module)
    parser_reset_last_errors()
    (*out).ok = true
    (*out).error_msg = ""
    (*out).module = merged_module
}

// SRET-safe wrapper mirroring load_multimodule_ir (writes via &!out).
pub fn load_multimodule_ir_into(out: &! MultiModuleIrResult, main_path: string) with IO, Mut, Div, Panic, Alloc {
    var trace = empty_load_multimodule_ir_trace()
    load_multimodule_ir_traced_into(out, main_path, &! trace)
}

pub fn load_multimodule_ir_counts_traced(main_path: string, trace: &! LoadMultimoduleIrTrace) -> MultiModuleIrCountsResult with IO, Mut, Div, Panic, Alloc {
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: counts_entry\n") }
    if module_frontend_file_maybe_has_use(main_path) {
        trace.loaded_modules = 1
        trace.last_stage = "load_main"
        trace.last_module_index = 0
        let total_fn_count = module_frontend_count_imported_source_recursive(main_path, 0, trace)

        trace.last_stage = "done"
        trace.last_module_index = trace.loaded_modules - 1
        print("Merged IR: ")
        print_int(total_fn_count)
        print(" functions\n")
        parser_reset_last_errors()
        return multimodule_ir_counts_ok(total_fn_count, 0, 0)
    }

    let main_prog = load_module_file(main_path)
    let main_parse_errors = parser_last_error_count()
    if main_parse_errors > 0 {
        print("Parse failed during IR counting for module 0: ")
        print_int(main_parse_errors)
        print(" errors\n")
        return multimodule_ir_counts_error("parse_failed")
    }
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: load_done\n") }
    trace.loaded_modules = 1
    trace.last_stage = "load_main"
    trace.last_module_index = 0

    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: has_use_check_begin\n") }
    let has_use_fast = module_frontend_file_maybe_has_use(main_path)
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: has_use_check_done\n") }
    if !has_use_fast {
        trace.resolved_modules = 1
        trace.last_stage = "typecheck"
        trace.last_module_index = 0
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_begin\n") }
        let single_verdict_no_use = module_frontend_check_items_with_source_context(main_prog.items, main_path)
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_done\n") }
        if single_verdict_no_use != 0 {
            print("Type check failed during IR lowering for module 0\n")
            return multimodule_ir_counts_error("type_check_failed")
        }
        trace.typechecked_modules = 1
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: reload_begin\n") }
        let single_prog_lower_no_use = load_module_file(main_path)
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: reload_done\n") }
        var single_fn_count: i64 = 0
        var single_string_count: i64 = 0
        var single_contest_count: i64 = 0
        let single_lower_ok_no_use = module_frontend_lower_program_counts_traced(
            single_prog_lower_no_use,
            0,
            trace,
            &! single_fn_count,
            &! single_string_count,
            &! single_contest_count
        )
        if !single_lower_ok_no_use {
            print("IR lowering failed for module 0\n")
            return multimodule_ir_counts_error("ir_lowering_failed")
        }
        trace.merged_modules = 1
        trace.last_stage = "done"
        print("Merged IR: ")
        print_int(single_fn_count)
        print(" functions\n")
        if single_fn_count <= 0 {
            print("IR lowering produced empty module\n")
            return multimodule_ir_counts_error("ir_lowering_empty_module")
        }
        parser_reset_last_errors()
        return multimodule_ir_counts_ok(single_fn_count, single_string_count, single_contest_count)
    }

    let main_imports_fast = module_frontend_import_files_from_source(main_path)
    if main_imports_fast.count <= 0 {
        trace.resolved_modules = 1
        trace.last_stage = "typecheck"
        trace.last_module_index = 0
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_begin\n") }
        let single_verdict = module_frontend_check_items_with_source_context(main_prog.items, main_path)
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_done\n") }
        if single_verdict != 0 {
            print("Type check failed during IR lowering for module 0\n")
            return multimodule_ir_counts_error("type_check_failed")
        }
        trace.typechecked_modules = 1
        let single_prog_lower = load_module_file(main_path)
        var single_fn_count2: i64 = 0
        var single_string_count2: i64 = 0
        var single_contest_count2: i64 = 0
        let single_lower_ok = module_frontend_lower_program_counts_traced(
            single_prog_lower,
            0,
            trace,
            &! single_fn_count2,
            &! single_string_count2,
            &! single_contest_count2
        )
        if !single_lower_ok {
            print("IR lowering failed for module 0\n")
            return multimodule_ir_counts_error("ir_lowering_failed")
        }
        trace.merged_modules = 1
        trace.last_stage = "done"
        print("Merged IR: ")
        print_int(single_fn_count2)
        print(" functions\n")
        if single_fn_count2 <= 0 {
            print("IR lowering produced empty module\n")
            return multimodule_ir_counts_error("ir_lowering_empty_module")
        }
        parser_reset_last_errors()
        return multimodule_ir_counts_ok(single_fn_count2, single_string_count2, single_contest_count2)
    }

    var programs: [Program; 256] = [mf_empty_program(); 256]
    var file_paths: [string; 256] = [""; 256]
    programs[0] = main_prog
    file_paths[0] = main_path
    var loaded: i64 = 1
    var visited_paths: [string; 256] = [""; 256]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1
    var work_front: i64 = 0
    var i: i64 = 0

    while work_front < loaded && loaded < 256 {
        let work_imports = module_frontend_import_files_from_source(file_paths[work_front])
        work_front = work_front + 1
        i = 0
        while i < work_imports.count && loaded < 256 {
            let file_path = work_imports.paths[i]
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    programs[loaded] = load_module_file(file_path)
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                    trace.loaded_modules = loaded
                    trace.last_stage = "load_deps"
                    trace.last_module_index = loaded - 1
                }
            }
            i = i + 1
        }
    }

    let main_imports = module_frontend_import_files_from_source(file_paths[0])
    let needs_resolution = loaded > 1 || main_imports.count > 0
    if needs_resolution {
        trace.last_stage = "resolve"
        trace.last_module_index = loaded - 1
        trace.resolved_modules = loaded
    } else {
        trace.resolved_modules = loaded
    }

    if loaded <= 0 {
        trace.last_stage = "empty"
        return multimodule_ir_counts_error("no_modules_loaded")
    }

    var total_fn_count: i64 = 0
    var total_string_count: i64 = 0
    var total_contest_count: i64 = 0
    i = 0
    while i < loaded {
        trace.last_stage = "typecheck_imported_summary"
        trace.last_module_index = i
        trace.typechecked_modules = trace.typechecked_modules + 1
        let prog_lower = load_module_file(file_paths[i])
        var module_fn_count: i64 = 0
        var module_string_count: i64 = 0
        var module_contest_count: i64 = 0
        let lower_ok = module_frontend_lower_program_counts_traced(
            prog_lower,
            i,
            trace,
            &! module_fn_count,
            &! module_string_count,
            &! module_contest_count
        )
        if !lower_ok {
            print("IR lowering failed for module ")
            print_int(i)
            print("\n")
            return multimodule_ir_counts_error("ir_lowering_failed")
        }
        total_fn_count = total_fn_count + module_fn_count
        total_string_count = total_string_count + module_string_count
        total_contest_count = total_contest_count + module_contest_count
        trace.merged_modules = trace.merged_modules + 1
        i = i + 1
    }

    trace.last_stage = "done"
    trace.last_module_index = loaded - 1
    print("Merged IR: ")
    print_int(total_fn_count)
    print(" functions\n")

    if total_fn_count <= 0 {
        print("IR lowering produced empty module\n")
        return multimodule_ir_counts_error("ir_lowering_empty_module")
    }

    parser_reset_last_errors()
    multimodule_ir_counts_ok(total_fn_count, total_string_count, total_contest_count)
}

pub fn load_multimodule_ir_counts(main_path: string) -> MultiModuleIrCountsResult with IO, Mut, Div, Panic, Alloc {
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: counts_wrapper_entry\n") }
    var trace = empty_load_multimodule_ir_trace()
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: counts_wrapper_trace\n") }
    load_multimodule_ir_counts_traced(main_path, &! trace)
}

pub fn load_multimodule_ir_fn_count_traced(main_path: string, trace: &! LoadMultimoduleIrTrace) -> i64 with IO, Mut, Div, Panic, Alloc {
    let imported_counts = load_multimodule_ir_counts_traced(main_path, trace)
    if imported_counts.ok {
        return imported_counts.fn_count
    }

    let main_prog = load_module_file(main_path)
    trace.loaded_modules = 1
    trace.last_stage = "load_main"
    trace.last_module_index = 0

    if module_frontend_file_maybe_has_use(main_path) {
        trace.last_stage = "unsupported_import_scalar"
        return -1
    }

    trace.resolved_modules = 1
    trace.last_stage = "typecheck"
    let verdict = module_frontend_check_items_with_source_context(main_prog.items, main_path)
    if verdict != 0 {
        trace.last_stage = "typecheck_failed"
        return -1
    }
    trace.typechecked_modules = 1

    let prog_lower = load_module_file(main_path)
    trace.last_stage = "lower_summary"
    let fn_count = module_frontend_count_fn_items(prog_lower.items)
    if fn_count <= 0 {
        trace.last_stage = "lower_summary_error"
        return -1
    }

    trace.summary_seeded_modules = 1
    trace.last_stage = "lower_bodies"
    trace.body_lowered_modules = 1
    trace.lowered_modules = 1
    trace.merged_modules = 1
    trace.last_stage = "done"
    print("Merged IR: ")
    print_int(fn_count)
    print(" functions\n")
    parser_reset_last_errors()
    fn_count
}

pub fn load_multimodule_ir_fn_count(main_path: string) -> i64 with IO, Mut, Div, Panic, Alloc {
    var trace = empty_load_multimodule_ir_trace()
    load_multimodule_ir_fn_count_traced(main_path, &! trace)
}

pub fn load_multimodule_ir_counts_into_traced(
    main_path: string,
    trace: &! LoadMultimoduleIrTrace,
    out_fn_count: &! i64,
    out_string_count: &! i64,
    out_contest_count: &! i64
) -> bool with IO, Mut, Div, Panic, Alloc {
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: counts_into_entry\n") }
    let result = load_multimodule_ir_counts_traced(main_path, trace)
    if !result.ok {
        return false
    }
    (*out_fn_count) = result.fn_count
    (*out_string_count) = result.string_count
    (*out_contest_count) = result.epistemic_contest_count
    true
}

pub fn load_multimodule_ir_counts_into(
    main_path: string,
    out_fn_count: &! i64,
    out_string_count: &! i64,
    out_contest_count: &! i64
) -> bool with IO, Mut, Div, Panic, Alloc {
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: counts_into_wrapper_entry\n") }
    var trace = empty_load_multimodule_ir_trace()
    load_multimodule_ir_counts_into_traced(main_path, &! trace, out_fn_count, out_string_count, out_contest_count)
}

fn module_frontend_summary_module(prog: Program) -> IrModule with IO, Mut, Div, Panic, Alloc {
    ir_empty_module()
}

pub fn load_multimodule_ir_probe_summary_traced(main_path: string, trace: &! LoadMultimoduleIrTrace) -> MultiModuleIrResult with IO, Mut, Div, Panic, Alloc {
    let main_prog = load_module_file(main_path)
    var programs: [Program; 256] = [mf_empty_program(); 256]
    var file_paths: [string; 256] = [""; 256]
    programs[0] = main_prog
    file_paths[0] = main_path
    var loaded: i64 = 1
    var visited_paths: [string; 256] = [""; 256]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1
    var work_front: i64 = 0
    var i: i64 = 0
    trace.loaded_modules = 1
    trace.last_stage = "load_main"
    trace.last_module_index = 0

    while work_front < loaded && loaded < 256 {
        let cur_dir = path_directory(file_paths[work_front])
        let work_imports = extract_imports_from_ast(programs[work_front])
        work_front = work_front + 1
        i = 0
        while i < work_imports.count && loaded < 256 {
            let file_path_local = use_path_to_file_path(work_imports.paths[i], cur_dir)
            let file_path_stdlib = use_path_to_stdlib_file_path(work_imports.paths[i])
            let file_path_stdlib_fallback = use_path_to_file_path(work_imports.paths[i], "stdlib")
            var file_path = file_path_local
            if !file_exists(file_path_local) {
                file_path = file_path_stdlib
                if !file_exists(file_path) {
                    file_path = file_path_stdlib_fallback
                }
            }
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    programs[loaded] = load_module_file(file_path)
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                    trace.loaded_modules = loaded
                    trace.last_stage = "load_deps"
                    trace.last_module_index = loaded - 1
                }
            }
            i = i + 1
        }
    }

    let main_imports = extract_imports_from_ast(programs[0])
    let needs_resolution = loaded > 1 || main_imports.count > 0
    if needs_resolution {
        trace.last_stage = "resolve"
        trace.last_module_index = loaded - 1
        let resolve_result = resolve_modules(programs, loaded)
        if resolve_result.had_error {
            trace.resolved_modules = 0
            return multimodule_ir_error("module_resolution_failed")
        }
        trace.resolved_modules = loaded
    } else {
        trace.resolved_modules = loaded
    }

    if loaded <= 0 {
        trace.last_stage = "empty"
        return multimodule_ir_error("no_modules_loaded")
    }

    var seed_epistemic = ir_empty_epistemic_section()
    trace.last_stage = "typecheck"
    trace.last_module_index = 0
    let seed_verdict = module_frontend_check_items_with_source_context(programs[0].items, file_paths[0])
    if seed_verdict != 0 {
        print("Type check failed during IR lowering for module 0\n")
        return multimodule_ir_error("type_check_failed")
    }
    trace.typechecked_modules = 1
    trace.last_stage = "lower"
    let seed_prog_lower = load_module_file(file_paths[0])
    var seed_lower_result = module_frontend_summary_module(seed_prog_lower)
    if seed_lower_result.fn_count <= 0 {
        print("IR lowering failed for module 0\n")
        return multimodule_ir_error("ir_lowering_failed")
    }
    trace.lowered_modules = 1
    trace.merged_modules = 1
    var merged_module = seed_lower_result

    i = 1
    while i < loaded {
        var epistemic = ir_empty_epistemic_section()
        trace.last_stage = "typecheck"
        trace.last_module_index = i
        let verdict = module_frontend_check_items_with_source_context(programs[i].items, file_paths[i])
        if verdict != 0 {
            print("Type check failed during IR lowering for module ")
            print_int(i)
            print("\n")
            return multimodule_ir_error("type_check_failed")
        }
        trace.typechecked_modules = trace.typechecked_modules + 1
        trace.last_stage = "lower"
        let prog_lower = load_module_file(file_paths[i])
        var lower_result = module_frontend_summary_module(prog_lower)
        if lower_result.fn_count <= 0 {
            print("IR lowering failed for module ")
            print_int(i)
            print("\n")
            return multimodule_ir_error("ir_lowering_failed")
        }
        trace.lowered_modules = trace.lowered_modules + 1
        trace.last_stage = "merge"
        merged_module = ir_merge_modules(merged_module, lower_result)
        trace.merged_modules = trace.merged_modules + 1
        i = i + 1
    }

    trace.last_stage = "done"
    trace.last_module_index = loaded - 1
    print("Merged IR: ")
    print_int(merged_module.fn_count)
    print(" functions\n")

    if merged_module.fn_count <= 0 {
        print("IR lowering produced empty module\n")
        return multimodule_ir_error("ir_lowering_empty_module")
    }

    parser_reset_last_errors()
    multimodule_ir_ok(merged_module)
}

pub fn load_multimodule_ir_probe_summary(main_path: string) -> MultiModuleIrResult with IO, Mut, Div, Panic, Alloc {
    var trace = empty_load_multimodule_ir_trace()
    load_multimodule_ir_probe_summary_traced(main_path, &! trace)
}

pub fn load_multimodule_epistemic_into(main_path: string, out: &! IrEpistemicSection) -> MultiModuleFrontendResult with IO, Mut, Div, Panic, Alloc {
    let main_prog = load_module_file(main_path)
    var programs: [Program; 256] = [mf_empty_program(); 256]
    var file_paths: [string; 256] = [""; 256]
    programs[0] = main_prog
    file_paths[0] = main_path
    var loaded: i64 = 1
    var visited_paths: [string; 256] = [""; 256]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1
    var work_front: i64 = 0
    var i: i64 = 0

    while work_front < loaded && loaded < 256 {
        let cur_dir = path_directory(file_paths[work_front])
        let work_imports = extract_imports_from_ast(programs[work_front])
        work_front = work_front + 1
        i = 0
        while i < work_imports.count && loaded < 256 {
            let file_path_local = use_path_to_file_path(work_imports.paths[i], cur_dir)
            let file_path_stdlib = use_path_to_stdlib_file_path(work_imports.paths[i])
            let file_path_stdlib_fallback = use_path_to_file_path(work_imports.paths[i], "stdlib")
            var file_path = file_path_local
            if !file_exists(file_path_local) {
                file_path = file_path_stdlib
                if !file_exists(file_path) {
                    file_path = file_path_stdlib_fallback
                }
            }
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    programs[loaded] = load_module_file(file_path)
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                }
            }
            i = i + 1
        }
    }

    let main_imports = extract_imports_from_ast(programs[0])
    let needs_resolution = loaded > 1 || main_imports.count > 0
    if needs_resolution {
        let resolve_result = resolve_modules(programs, loaded)
        if resolve_result.had_error {
            return multimodule_frontend_error("module_resolution_failed")
        }
    }

    if loaded == 1 {
        if !check_program_epistemic_into(programs[0], out) {
            return multimodule_frontend_error("type_check_failed")
        }
        return multimodule_frontend_ok()
    }

    var merged_epistemic = ir_empty_epistemic_section()
    i = 0
    while i < loaded {
        var epistemic = ir_empty_epistemic_section()
        if !check_program_epistemic_into(programs[i], &!epistemic) {
            return multimodule_frontend_error("type_check_failed")
        }
        merged_epistemic = ir_merge_epistemic_sections(merged_epistemic, epistemic)
        i = i + 1
    }

    (*out) = merged_epistemic
    multimodule_frontend_ok()
}
