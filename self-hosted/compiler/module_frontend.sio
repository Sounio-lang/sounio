// Memoised: read_env allocates and the runtime allocator never reclaims,
// so a gate evaluated at every call site leaks on every call. CHECKED is
// separate from the value because "off" and "not yet read" are different.
var MODULE_FRONTEND_ORDERED_PATH_TRACE_ENABLED_ON: i64 = 0
var MODULE_FRONTEND_ORDERED_PATH_TRACE_ENABLED_CHECKED: i64 = 0
// #1649: how many function regions were sealed at publication. A count below
// fn_count is not an error -- an empty function is never given a region -- but a
// count of ZERO on a module with functions means sealing silently did nothing,
// which is the way this guard would rot.
fn module_frontend_print_seal_receipt(phase: string, sealed: i64, fn_count: i64) with IO, Mut, Panic, Div {
    if !module_frontend_rebracket_trace_enabled() { return }
    print("[ir-seal] phase=")
    print(phase)
    print(" sealed=")
    print(io_trace_i64_string(sealed))
    print(" of=")
    print(io_trace_i64_string(fn_count))
    print("\n")
}

// #1669 probe. Prints the three numbers that separate the failure modes:
// never written / written and lost in transit / written, live, and the consumers
// still not using them. Off unless SOUNIO_FLOAT_BITS_PROBE=1.
fn module_frontend_print_float_bits_probe(phase: string, module: &IrModule) with Alloc, IO, Mut, Panic, Div {
    if !str_eq(read_env("SOUNIO_FLOAT_BITS_PROBE"), "1") { return }
    print("[float-bits] phase=")
    print(phase)
    print(" writes=")
    print(io_trace_i64_string(IR_FLOAT_BITS_WRITES))
    print(" gets_true=")
    print(io_trace_i64_string(IR_FLOAT_BITS_GETS))
    print(" live_at_codegen=")
    print(io_trace_i64_string(ir_module_count_float_bits(module)))
    print(" over_cap=")
    print(io_trace_i64_string(IR_FLOAT_BITS_OVER_CAP))
    // Total bits found already set in a slot at the moment it was allocated,
    // BEFORE lowering wrote anything to it. Nonzero proves the slot is recycled
    // memory and that the clear at the allocation site is load-bearing; zero on
    // a run that lowers several functions would mean the clear is dead code and
    // this whole diagnosis is wrong.
    print(" inherited_at_alloc=")
    print(io_trace_i64_string(IR_FLOAT_BITS_INHERITED))
    // #1655 test on THIS field, with a known pattern instead of an inference.
    // inherited_at_alloc came back 0 while the live count (which reads by
    // REFERENCE) came back in the thousands. Either the copy drops the array
    // field or the reference reads memory the copy never sees. Set 8 bits by
    // hand, then read them back three ways:
    //   direct  -- same variable, no copy at all
    //   copied  -- through one by-value struct assignment
    // 8/8 means copies are fine and the diagnosis is elsewhere; 8/0 means a
    // by-value IrFunction silently loses the bitset, and a struct field is the
    // wrong home for it no matter where it is cleared.
    var pat = ir_empty_function()
    var b: i64 = 0
    while b < 8 {
        let _s = ir_float_bits_set(&! pat, b)
        b = b + 1
    }
    print(" pattern_direct=")
    print(io_trace_i64_string(ir_function_count_float_bits(&pat)))
    var pat_copy = pat
    print(" pattern_copied=")
    print(io_trace_i64_string(ir_function_count_float_bits(&pat_copy)))
    // The two numbers that separate "the initialiser does not zero" from "the
    // field is lost on the way into the module array". A fresh IrFunction is
    // ~2 KB; deliberately NOT building an ir_empty_module() here, which would put
    // a 4.2 MB frame on the stack just to ask a question.
    var fresh = ir_empty_function()
    print(" fresh=")
    print(io_trace_i64_string(ir_function_count_float_bits(&fresh)))
    if (*module).fn_count > 0 {
        // The last unhoisted reader, kept deliberately until it was explained.
        // Hoisted it reports 8; in place it reported ~1000 and varied per run.
        var f0 = ir_fn_get(&(*module), 0 as usize)
        print(" live_fn0=")
        print(io_trace_i64_string(ir_function_count_float_bits(&f0)))
    }
    // Slots lowering never touched. Dirty here means the array was born dirty.
    print(" untouched8=")
    print(io_trace_i64_string(ir_module_count_float_bits_untouched(module, 8)))
    print(" fn_count=")
    print(io_trace_i64_string((*module).fn_count))
    print("\n")
}

fn module_frontend_load_float_marker_switch() with IO, Mut, Panic, Div {
    if str_eq(read_env("SOUNIO_FLOAT_NO_MARKERS"), "1") { IR_FLOAT_NO_MARKERS = 1 }
}

fn module_frontend_ordered_path_trace_enabled() -> bool with IO, Mut, Panic, Div {
    if MODULE_FRONTEND_ORDERED_PATH_TRACE_ENABLED_CHECKED == 0 {
        MODULE_FRONTEND_ORDERED_PATH_TRACE_ENABLED_CHECKED = 1
        if str_eq(read_env("SOUNIO_ORDERED_PATH_TRACE"), "1") {
            MODULE_FRONTEND_ORDERED_PATH_TRACE_ENABLED_ON = 1
        }
    }
    MODULE_FRONTEND_ORDERED_PATH_TRACE_ENABLED_ON == 1
}

fn module_frontend_items_have_ontology(items: &Option<Box<ItemList>>) -> bool with Alloc {
    match *items {
        Some(list) => {
            if (*list).head.kind == ItemKind::ItemOntology {
                true
            } else {
                module_frontend_items_have_ontology(&(*list).tail)
            }
        }
        None => false,
    }
}

fn module_frontend_print_rebracket_receipt(
    phase: string,
    receipt: OcpCleanupModuleReceipt,
) with IO, Mut, Panic, Div {
    if !module_frontend_rebracket_trace_enabled() { return }
    print("[rebracket-native-v2] phase=")
    print(phase)
    print(" schema=")
    print(io_trace_i64_string(OCP_CLEANUP_RECEIPT_SCHEMA_VERSION))
    print(" optimize=1 functions=")
    print(io_trace_i64_string(receipt.function_count))
    print(" transactions=")
    print(io_trace_i64_string(receipt.exact_bitwise_transaction_count))
    print(" authorizations=")
    print(io_trace_i64_string(receipt.exact_bitwise_authorization_count))
    print(" applications=")
    print(io_trace_i64_string(receipt.exact_bitwise_application_count))
    print(" refusals=")
    print(io_trace_i64_string(receipt.exact_bitwise_refusal_count))
    print(" same_region_applications=")
    print(io_trace_i64_string(receipt.exact_bitwise_same_region_application_count))
    print(" cross_block_applications=")
    print(io_trace_i64_string(receipt.exact_bitwise_cross_block_application_count))
    print(" refusal_reason_mask=")
    print(io_trace_i64_string(receipt.exact_bitwise_refusal_reason_mask))
    print(" transaction_ontology_parameter_links=")
    print(io_trace_i64_string(receipt.exact_bitwise_transaction_ontology_parameter_link_count))
    print(" application_ontology_parameter_links=")
    print(io_trace_i64_string(receipt.exact_bitwise_application_ontology_parameter_link_count))
    print(" last_ontology_class_hash=")
    print(io_trace_i64_string(receipt.last_transaction_ontology_class_hash))
    print(" operator_mask=")
    print(io_trace_i64_string(receipt.exact_bitwise_operator_mask))
    print(" last_function=")
    print(io_trace_i64_string(receipt.last_application_function_index))
    print(" combined=")
    print(io_trace_i64_string(receipt.last_combined_const_value))
    print("\n")
}

fn module_frontend_print_rebracket_disabled(phase: string, function_count: i64) with IO, Mut, Panic, Div {
    if !module_frontend_rebracket_trace_enabled() { return }
    print("[rebracket-native-v2] phase=")
    print(phase)
    print(" schema=")
    print(io_trace_i64_string(OCP_CLEANUP_RECEIPT_SCHEMA_VERSION))
    print(" optimize=0 functions=")
    print(io_trace_i64_string(function_count))
    print(" transactions=0 authorizations=0 applications=0 refusals=0 same_region_applications=0 cross_block_applications=0 refusal_reason_mask=0 transaction_ontology_parameter_links=0 application_ontology_parameter_links=0 last_ontology_class_hash=0 operator_mask=0 last_function=-1 combined=0\n")
}

fn module_frontend_print_ordered_path_receipt(
    phase: string,
    optimize: bool,
    module: &IrModule,
) with IO, Mut, Panic, Div {
    if !module_frontend_ordered_path_trace_enabled() { return }
    let link_total = ir_ontology_parameter_link_total(&(*module).ontologies)
    let bounded = ir_ontology_parameter_link_count_is_bounded(&(*module).ontologies)
    print("[ordered-path-native-v2] phase=")
    print(phase)
    print(" schema=1 optimize=")
    print(if optimize { "1" } else { "0" })
    print(" functions=")
    print(io_trace_i64_string((*module).fn_count))
    print(" links=")
    print(io_trace_i64_string(link_total))
    print(" bounded=")
    print(if bounded { "1" } else { "0" })
    print(" authority=0\n")

    if !bounded { return }

    var link_index: i64 = 0
    while link_index < link_total {
        if ir_ontology_parameter_link_is_valid_at(&(*module).ontologies, link_index) {
            let function_name = ir_ontology_parameter_link_function_name_at(&(*module).ontologies, link_index)
            let parameter_index = ir_ontology_parameter_link_parameter_index_at(&(*module).ontologies, link_index)
            let class_name = ir_ontology_parameter_link_class_name_at(&(*module).ontologies, link_index)
            print("[ordered-path-link] phase=")
            print(phase)
            print(" schema=1 function=")
            print(str_from_bytes(function_name.buf, function_name.len))
            print(" parameter=")
            print(io_trace_i64_string(parameter_index))
            print(" class=")
            print(str_from_bytes(class_name.buf, class_name.len))
            print(" authority=0\n")
        }
        link_index = link_index + 1
    }
}

var MODULE_FRONTEND_IMPORT_FILE_DATA: [i8; 1048576] = [0; 1048576]
var MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT: i64 = 0
var MODULE_FRONTEND_IMPORTED_SIMPLE_FN_NAME_HASHES: [i64; 64] = [0; 64]
var MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS: [i64; 64] = [0; 64]
var MODULE_FRONTEND_IMPORTED_SIMPLE_FN_TARGET_HASHES: [i64; 64] = [0; 64]
var MODULE_FRONTEND_IMPORTED_SIMPLE_FN_VALUES: [i64; 64] = [0; 64]

fn module_frontend_import_is_ident_ch(c: i8) -> bool {
    (c >= 65 as i8 && c <= 90 as i8) ||
    (c >= 97 as i8 && c <= 122 as i8) ||
    (c >= 48 as i8 && c <= 57 as i8) ||
    c == 95 as i8
}

fn module_frontend_import_byte_to_str(c: i8) -> string {
    let v = c as i64
    if v >= 97 && v <= 122 {
        return str_slice("abcdefghijklmnopqrstuvwxyz", v - 97, v - 96)
    }
    if v >= 65 && v <= 90 {
        return str_slice("ABCDEFGHIJKLMNOPQRSTUVWXYZ", v - 65, v - 64)
    }
    if v >= 48 && v <= 57 {
        return str_slice("0123456789", v - 48, v - 47)
    }
    if v == 95 { return "_" }
    if v == 47 { return "/" }
    if v == 46 { return "." }
    if v == 45 { return "-" }
    ""
}

fn module_frontend_load_import_file(path: string) -> i64 with IO, Mut, Panic, Div {
    let size = file_size(path)
    if size <= 0 {
        return 0
    }
    let n = if size > 1048576 { 1048576 } else { size }
    let raw = read_file(path)
    var i: i64 = 0
    while i < n {
        MODULE_FRONTEND_IMPORT_FILE_DATA[i as usize] = raw[i as usize]
        i = i + 1
    }
    n
}

fn module_frontend_path_directory_slice(path: string) -> string with Mut, Panic, Div {
    let path_len = str_len(path)
    var last_slash: i64 = 0 - 1
    var i: i64 = 0
    while i < path_len {
        if str_char_at(path, i) == 47 {
            last_slash = i
        }
        i = i + 1
    }
    if last_slash < 0 {
        return "."
    }
    str_slice(path, 0, last_slash)
}

fn module_frontend_relpath_to_package_path(rel_path: string) -> string with Mut, Panic, Div {
    let path_len = str_len(rel_path)
    if path_len < 5 {
        return ""
    }
    if str_char_at(rel_path, path_len - 4) != 46 ||
       str_char_at(rel_path, path_len - 3) != 115 ||
       str_char_at(rel_path, path_len - 2) != 105 ||
       str_char_at(rel_path, path_len - 1) != 111 {
        return ""
    }

    var slash_pos: i64 = 0 - 1
    var i: i64 = 0
    let stem_end = path_len - 4
    while i < stem_end {
        if str_char_at(rel_path, i) == 47 {
            slash_pos = i
            break
        }
        i = i + 1
    }

    var out = "packages/"
    let root_end = if slash_pos >= 0 { slash_pos } else { stem_end }
    i = 0
    while i < root_end {
        let c = str_char_at(rel_path, i)
        if c == 95 {
            out = str_concat(out, "-")
        } else {
            out = str_concat(out, module_frontend_import_byte_to_str(c as i8))
        }
        i = i + 1
    }
    out = str_concat(out, "/src")
    if slash_pos >= 0 {
        i = slash_pos
        while i < path_len {
            out = str_concat(out, module_frontend_import_byte_to_str(str_char_at(rel_path, i) as i8))
            i = i + 1
        }
    } else {
        out = str_concat(out, "/lib.sio")
    }
    out
}

fn module_frontend_file_path_mod_fallback(path: string) -> string with Mut, Panic, Div {
    let path_len = str_len(path)
    if path_len < 5 {
        return path
    }
    if str_char_at(path, path_len - 4) != 46 {
        return path
    }
    let base = str_slice(path, 0, path_len - 4)
    str_concat(str_concat(base, "/mod"), ".sio")
}

fn module_frontend_resolve_import_relpath(rel_path: string, cur_dir: string) -> string with IO, Mut, Panic, Div {
    let local_path = str_concat(str_concat(cur_dir, "/"), rel_path)
    if file_exists(local_path) {
        return local_path
    }
    // Search upward through ancestor directories. The compiler's modules share one source
    // root (e.g. self-hosted/), so an import like `check::types` from
    // self-hosted/compiler/main.sio resolves to the sibling self-hosted/check/types.sio,
    // found by walking up from cur_dir. Closest ancestor wins (returned first). Without
    // this, every cross-directory import resolved as undeclared and the compiler could not
    // type-check its own source.
    var ancestor = cur_dir
    var anc_depth: i64 = 0
    while anc_depth < 8 {
        let parent = module_frontend_path_directory_slice(ancestor)
        if str_len(parent) == 0 || str_eq(parent, ".") || str_eq(parent, ancestor) {
            anc_depth = 8
        } else {
            let anc_path = str_concat(str_concat(parent, "/"), rel_path)
            if file_exists(anc_path) {
                return anc_path
            }
            ancestor = parent
            anc_depth = anc_depth + 1
        }
    }
    // Repo-root relative. The ancestor walk stops when `parent` of a top-level
    // directory (e.g. `tests` from `tests/run-pass`) is empty, so it never
    // tries the bare rel_path at the repository root. That left every
    // `use scripts::…` / `use tools::…` import from under tests/ permanently
    // unresolved even when the file existed (dossier_smoke →
    // scripts/dissertation/dossier_generator.sio). Not an import-cap drop:
    // the path was never a candidate. Same honesty class as silent token
    // truncation — absence must not look like "module missing" when the
    // resolver simply did not look.
    if file_exists(rel_path) {
        return rel_path
    }
    let stdlib_env_root = read_env("SOUNIO_STDLIB_PATH")
    if str_len(stdlib_env_root) > 0 {
        let stdlib_env_path = str_concat(str_concat(stdlib_env_root, "/"), rel_path)
        if file_exists(stdlib_env_path) {
            return stdlib_env_path
        }
    }
    let stdlib_path = str_concat("stdlib/", rel_path)
    if file_exists(stdlib_path) {
        return stdlib_path
    }
    let pkg_path = module_frontend_relpath_to_package_path(rel_path)
    if str_len(pkg_path) > 0 && file_exists(pkg_path) {
        return pkg_path
    }
    let pkg_mod = module_frontend_file_path_mod_fallback(pkg_path)
    if str_len(pkg_mod) > 0 && file_exists(pkg_mod) {
        return pkg_mod
    }
    local_path
}

fn module_frontend_extract_relpath_from_loaded(path_start: i64, line_end: i64) -> string with Mut, Panic {
    var pos = path_start
    var path: string = ""
    var first_seg = true

    while pos < line_end {
        let c = MODULE_FRONTEND_IMPORT_FILE_DATA[pos as usize]
        if module_frontend_import_is_ident_ch(c) {
            if !first_seg {
                path = str_concat(path, "/")
            }
            first_seg = false
            while pos < line_end && module_frontend_import_is_ident_ch(MODULE_FRONTEND_IMPORT_FILE_DATA[pos as usize]) {
                path = str_concat(path, module_frontend_import_byte_to_str(MODULE_FRONTEND_IMPORT_FILE_DATA[pos as usize]))
                pos = pos + 1
            }
            if pos + 1 < line_end &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[pos as usize] == (58 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(pos + 1) as usize] == (58 as i8) {
                let after_cc = pos + 2
                if after_cc < line_end {
                    let next = MODULE_FRONTEND_IMPORT_FILE_DATA[after_cc as usize]
                    if next == (123 as i8) || next == (42 as i8) {
                        pos = line_end
                    } else {
                        pos = after_cc
                    }
                } else {
                    pos = line_end
                }
            } else {
                pos = line_end
            }
        } else {
            pos = pos + 1
        }
    }

    if str_len(path) == 0 {
        return ""
    }
    str_concat(path, ".sio")
}

fn module_frontend_loaded_find_pattern(size: i64, pattern: string) -> i64 with Mut, Panic, Div {
    let plen = str_len(pattern)
    if plen <= 0 {
        return 0
    }
    var i: i64 = 0
    while i + plen <= size {
        var same = true
        var j: i64 = 0
        while j < plen {
            if MODULE_FRONTEND_IMPORT_FILE_DATA[(i + j) as usize] != (str_char_at(pattern, j) as i8) {
                same = false
            }
            j = j + 1
        }
        if same {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn module_frontend_loaded_contains_pattern(size: i64, pattern: string) -> bool with Mut, Panic, Div {
    module_frontend_loaded_find_pattern(size, pattern) >= 0
}

fn module_frontend_loaded_first_int_value_after(start: i64, size: i64) -> i64 {
    var i = start
    while i < size {
        let ch = MODULE_FRONTEND_IMPORT_FILE_DATA[i as usize]
        if ch >= (48 as i8) && ch <= (57 as i8) {
            var value: i64 = 0
            while i < size {
                let digit = MODULE_FRONTEND_IMPORT_FILE_DATA[i as usize]
                if digit >= (48 as i8) && digit <= (57 as i8) {
                    value = (value * 10) + ((digit as i64) - 48)
                    i = i + 1
                } else {
                    return value
                }
            }
            return value
        }
        i = i + 1
    }
    0 - 1
}

fn module_frontend_int_value_after_pattern(path: string, pattern: string) -> i64 with IO, Mut, Panic, Div {
    let size = module_frontend_load_import_file(path)
    if size <= 0 {
        return 0 - 1
    }
    let pos = module_frontend_loaded_find_pattern(size, pattern)
    if pos < 0 {
        return 0 - 1
    }
    module_frontend_loaded_first_int_value_after(pos + str_len(pattern), size)
}

fn module_frontend_source_contains_pattern(path: string, pattern: string) -> bool with IO, Mut, Panic, Div {
    let size = module_frontend_load_import_file(path)
    if size <= 0 {
        return false
    }
    module_frontend_loaded_contains_pattern(size, pattern)
}

pub(crate) fn module_frontend_check_items_with_source_context(items: Option<Box<ItemList>>, source_path: string) -> i64 with IO, Mut, Div, Panic, Alloc {
    let module_path = file_path_to_module_path(source_path)
    if module_frontend_source_contains_pattern(source_path, "//@ ontology-side-table-cache:") {
        let cache_verdict = check_items_verdict_boot4_with_ontocache_sidecar(items, source_path, module_path)
        if cache_verdict != 0 {
            return cache_verdict
        }
        return knowledge_context_validate_items_values_only(items)
    }

    let verdict = check_items_verdict_boot4_with_module_path(items, module_path)
    if verdict != 0 {
        return verdict
    }
    knowledge_context_validate_items(items)
}

fn module_frontend_string_segment(sl: StringList) -> string with Mut, Panic, Div {
    var segment: string = ""
    var i: i64 = 0
    while i < sl.head_len {
        segment = str_concat(segment, module_frontend_import_byte_to_str(sl.head_buf[i]))
        i = i + 1
    }
    segment
}

fn module_frontend_qualified_segments(sl: StringList) -> string with Mut, Panic, Div, Alloc {
    let segment = module_frontend_string_segment(sl)
    match sl.tail {
        None => segment
        Some(next) => str_concat(str_concat(segment, "::"), module_frontend_qualified_segments(*next))
    }
}

fn use_path_to_string(path: AstPath) -> string with Mut, Panic, Div, Alloc {
    if path.seg_count == 0 {
        return ""
    }
    module_frontend_qualified_segments(path.segments)
}

fn module_frontend_ast_import_relpath(path: AstPath) -> string with Mut, Panic, Div, Alloc {
    let qualified = use_path_to_string(path)
    let qualified_len = str_len(qualified)
    if qualified_len == 0 {
        return ""
    }

    var rel_path: string = ""
    var i: i64 = 0
    while i < qualified_len {
        let ch = str_char_at(qualified, i)
        if ch == 58 && i + 1 < qualified_len && str_char_at(qualified, i + 1) == 58 {
            rel_path = str_concat(rel_path, "/")
            i = i + 2
        } else {
            rel_path = str_concat(rel_path, module_frontend_import_byte_to_str(ch as i8))
            i = i + 1
        }
    }
    str_concat(rel_path, ".sio")
}

fn module_frontend_resolve_ast_import_relpath(rel_path: string, cur_dir: string) -> string with IO, Mut, Panic, Div {
    var base_dir = cur_dir
    var offset: i64 = 0
    let rel_len = str_len(rel_path)
    var stripping_super = true
    while stripping_super && offset + 6 <= rel_len {
        if str_char_at(rel_path, offset) == 115 &&
           str_char_at(rel_path, offset + 1) == 117 &&
           str_char_at(rel_path, offset + 2) == 112 &&
           str_char_at(rel_path, offset + 3) == 101 &&
           str_char_at(rel_path, offset + 4) == 114 &&
           str_char_at(rel_path, offset + 5) == 47 {
            base_dir = module_frontend_path_directory_slice(base_dir)
            offset = offset + 6
        } else {
            stripping_super = false
        }
    }
    module_frontend_resolve_import_relpath(str_slice(rel_path, offset, rel_len), base_dir)
}

// Strip the final path segment of a ".sio" relpath produced by
// module_frontend_ast_import_relpath. Used as the named-import fallback for
// bare `use module::symbol` forms that are token-identical to whole-file
// imports: when `mod/half.sio` does not exist, retry `mod.sio`.
// Returns "" when there is no parent segment to strip.
fn module_frontend_relpath_strip_last_segment(rel_path: string) -> string with Mut, Panic, Div {
    let len = str_len(rel_path)
    if len < 5 {
        return ""
    }
    var last_slash: i64 = 0 - 1
    var i: i64 = 0
    while i < len {
        if str_char_at(rel_path, i) == 47 {
            last_slash = i
        }
        i = i + 1
    }
    if last_slash < 0 {
        return ""
    }
    str_concat(str_slice(rel_path, 0, last_slash), ".sio")
}

fn resolve_import_file_path(path: AstPath, cur_dir: string) -> string with IO, Mut, Panic, Div, Alloc {
    let rel_path = module_frontend_ast_import_relpath(path)
    if str_len(rel_path) == 0 {
        return ""
    }
    let resolved = module_frontend_resolve_ast_import_relpath(rel_path, cur_dir)
    if file_exists(resolved) {
        return resolved
    }
    // Named-import fallback (Madaros port of lean_single Bug C / #601):
    // `use mod::half` is ambiguous with whole-file `use mod::half` where the
    // last segment is a real file. Prefer the whole-file hit above; only when
    // that misses, drop the last segment and retry so the parent module file
    // loads. See docs/audit/LEAN_SINGLE_NAMED_USE_IMPORT_2026-07-05.md and
    // docs/audit/MADAROS_MULTIMODULE_PRINT_IMPORT_BUGS_2026-07-13.md defect 1.
    if path.seg_count >= 2 {
        let parent_rel = module_frontend_relpath_strip_last_segment(rel_path)
        if str_len(parent_rel) > 0 {
            let parent_resolved = module_frontend_resolve_ast_import_relpath(parent_rel, cur_dir)
            if file_exists(parent_resolved) {
                return parent_resolved
            }
        }
    }
    resolved
}

fn mf_empty_program() -> Program {
    Program {
        module_path: empty_path(),
        items: None,
    }
}

fn mf_program_from_items(items: &Option<Box<ItemList>>) -> Program {
    Program {
        module_path: empty_path(),
        items: *items,
    }
}

fn ir_epistemic_offset_id(id: i64, offset: i64) -> i64 {
    if id >= 0 { id + offset } else { id }
}

// Scalar-only epistemic id shift. Prefer this over IrInstr by-value adjust
// (A8: IrInstr carries Option<Box<IrRegList>> call_args — by-value scramble).
fn ir_merge_adjusted_label_id(
    op: IrOpcode,
    label_id: i64,
    contest_offset: i64,
    robust_offset: i64,
    decision_offset: i64,
    deferred_offset: i64,
    validated_offset: i64,
    acquisition_plan_offset: i64,
    recourse_plan_offset: i64,
    alternative_set_offset: i64,
    transition_plan_offset: i64,
    observed_transition_offset: i64,
    rollback_certificate_offset: i64
) -> i64 {
    if op == IrOpcode::IrContest || op == IrOpcode::IrLiftKnowledge {
        return ir_epistemic_offset_id(label_id, contest_offset)
    } else if op == IrOpcode::IrProveRobust {
        return ir_epistemic_offset_id(label_id, robust_offset)
    } else if op == IrOpcode::IrAdmitAction {
        return ir_epistemic_offset_id(label_id, decision_offset)
    } else if op == IrOpcode::IrDeferAction {
        return ir_epistemic_offset_id(label_id, deferred_offset)
    } else if op == IrOpcode::IrValidated {
        return ir_epistemic_offset_id(label_id, validated_offset)
    } else if op == IrOpcode::IrPlanAcquisition {
        return ir_epistemic_offset_id(label_id, acquisition_plan_offset)
    } else if op == IrOpcode::IrPlanRecourse {
        return ir_epistemic_offset_id(label_id, recourse_plan_offset)
    } else if op == IrOpcode::IrProposeAlternatives {
        return ir_epistemic_offset_id(label_id, alternative_set_offset)
    } else if op == IrOpcode::IrCommitAlternative {
        return ir_epistemic_offset_id(label_id, transition_plan_offset)
    } else if op == IrOpcode::IrObserveTransition {
        return ir_epistemic_offset_id(label_id, observed_transition_offset)
    } else if op == IrOpcode::IrRollbackTransition {
        return ir_epistemic_offset_id(label_id, rollback_certificate_offset)
    }
    label_id
}

// Legacy wrapper: only for residual call sites. Prefer scalar label_id path
// on the multi-mod merge hot path (no IrInstr by-value).
fn ir_merge_adjust_epistemic_instr(
    instr: IrInstr,
    contest_offset: i64,
    robust_offset: i64,
    decision_offset: i64,
    deferred_offset: i64,
    validated_offset: i64,
    acquisition_plan_offset: i64,
    recourse_plan_offset: i64,
    alternative_set_offset: i64,
    transition_plan_offset: i64,
    observed_transition_offset: i64,
    rollback_certificate_offset: i64
) -> IrInstr with Mut {
    var out = instr
    out.label_id = ir_merge_adjusted_label_id(
        out.op,
        out.label_id,
        contest_offset,
        robust_offset,
        decision_offset,
        deferred_offset,
        validated_offset,
        acquisition_plan_offset,
        recourse_plan_offset,
        alternative_set_offset,
        transition_plan_offset,
        observed_transition_offset,
        rollback_certificate_offset
    )
    out
}

// In-place epistemic section merge (Wave10 memory wall).
// Avoids full IrEpistemicSection by-value (dst+src params + return + local).
fn ir_merge_epistemic_sections_into(dst: &! IrEpistemicSection, src: &IrEpistemicSection) with Mut, Panic, Div {
    let family_offset = (*dst).model_family_count
    let policy_offset = (*dst).policy_count
    let decision_policy_offset = (*dst).decision_policy_count
    let deferral_policy_offset = (*dst).deferral_policy_count
    let acquisition_policy_offset = (*dst).acquisition_policy_count
    let recourse_policy_offset = (*dst).recourse_policy_count
    let validation_offset = (*dst).validation_count
    let mechanistic_offset = (*dst).mechanistic_report_count
    let posterior_weights_offset = (*dst).posterior_weights_count
    let counterexample_offset = (*dst).counterexample_count
    let audit_offset = (*dst).audit_count
    let contest_offset = (*dst).contest_count
    let contest_witness_offset = (*dst).contest_witness_count
    let robust_offset = (*dst).robust_proof_count
    let decision_certificate_offset = (*dst).decision_certificate_count
    let deferred_certificate_offset = (*dst).deferred_certificate_count
    let deferred_reason_witness_offset = (*dst).deferred_reason_witness_count
    let acquisition_plan_offset = (*dst).acquisition_plan_count
    let acquisition_reason_witness_offset = (*dst).acquisition_reason_witness_count
    let recourse_plan_offset = (*dst).recourse_plan_count
    let recourse_reason_witness_offset = (*dst).recourse_reason_witness_count
    let alternative_policy_offset = (*dst).alternative_policy_count
    let alternative_frontier_offset = (*dst).alternative_frontier_count
    let alternative_candidate_offset = (*dst).alternative_candidate_count
    let alternative_set_offset = (*dst).alternative_set_count
    let alternative_reason_witness_offset = (*dst).alternative_reason_witness_count
    let transition_policy_offset = (*dst).transition_policy_count
    let transition_step_offset = (*dst).transition_step_count
    let transition_protocol_offset = (*dst).transition_protocol_count
    let transition_plan_offset = (*dst).transition_plan_count
    let transition_reason_witness_offset = (*dst).transition_reason_witness_count
    let monitoring_policy_offset = (*dst).monitoring_policy_count
    let observed_transition_offset = (*dst).observed_transition_count
    let rollback_certificate_offset = (*dst).rollback_certificate_count
    let validated_offset = (*dst).validated_manifest_count

    var i: i64 = 0
    while i < (*src).model_family_count && (*dst).model_family_count < IR_MAX_EPI_MODEL_FAMILIES {
        var info = (*src).model_families[i]
        info.id = (*dst).model_family_count
        (*dst).model_families[(*dst).model_family_count as usize] = info
        (*dst).model_family_count = (*dst).model_family_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).policy_count && (*dst).policy_count < IR_MAX_EPI_POLICIES {
        var info = (*src).policies[i]
        info.id = (*dst).policy_count
        (*dst).policies[(*dst).policy_count as usize] = info
        (*dst).policy_count = (*dst).policy_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).decision_policy_count && (*dst).decision_policy_count < IR_MAX_EPI_DECISION_POLICIES {
        var info = (*src).decision_policies[i]
        info.id = (*dst).decision_policy_count
        (*dst).decision_policies[(*dst).decision_policy_count as usize] = info
        (*dst).decision_policy_count = (*dst).decision_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).deferral_policy_count && (*dst).deferral_policy_count < IR_MAX_EPI_DEFERRAL_POLICIES {
        var info = (*src).deferral_policies[i]
        info.id = (*dst).deferral_policy_count
        (*dst).deferral_policies[(*dst).deferral_policy_count as usize] = info
        (*dst).deferral_policy_count = (*dst).deferral_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).acquisition_policy_count && (*dst).acquisition_policy_count < IR_MAX_EPI_ACQUISITION_POLICIES {
        var info = (*src).acquisition_policies[i]
        info.id = (*dst).acquisition_policy_count
        (*dst).acquisition_policies[(*dst).acquisition_policy_count as usize] = info
        (*dst).acquisition_policy_count = (*dst).acquisition_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).recourse_policy_count && (*dst).recourse_policy_count < IR_MAX_EPI_RECOURSE_POLICIES {
        var info = (*src).recourse_policies[i]
        info.id = (*dst).recourse_policy_count
        (*dst).recourse_policies[(*dst).recourse_policy_count as usize] = info
        (*dst).recourse_policy_count = (*dst).recourse_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).validation_count && (*dst).validation_count < IR_MAX_EPI_VALIDATIONS {
        var info = (*src).validations[i]
        info.id = (*dst).validation_count
        (*dst).validations[(*dst).validation_count as usize] = info
        (*dst).validation_count = (*dst).validation_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).mechanistic_report_count && (*dst).mechanistic_report_count < IR_MAX_EPI_MECHANISTIC_REPORTS {
        var info = (*src).mechanistic_reports[i]
        info.id = (*dst).mechanistic_report_count
        (*dst).mechanistic_reports[(*dst).mechanistic_report_count as usize] = info
        (*dst).mechanistic_report_count = (*dst).mechanistic_report_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).posterior_weights_count && (*dst).posterior_weights_count < IR_MAX_EPI_POSTERIOR_WEIGHTS {
        var info = (*src).posterior_weights[i]
        info.id = (*dst).posterior_weights_count
        (*dst).posterior_weights[(*dst).posterior_weights_count as usize] = info
        (*dst).posterior_weights_count = (*dst).posterior_weights_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).counterexample_count && (*dst).counterexample_count < IR_MAX_EPI_COUNTEREXAMPLES {
        var info = (*src).counterexamples[i]
        info.id = (*dst).counterexample_count
        (*dst).counterexamples[(*dst).counterexample_count as usize] = info
        (*dst).counterexample_count = (*dst).counterexample_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).audit_count && (*dst).audit_count < IR_MAX_EPI_AUDITS {
        var info = (*src).audits[i]
        info.id = (*dst).audit_count
        info.family_id = ir_epistemic_offset_id(info.family_id, family_offset)
        info.policy_id = ir_epistemic_offset_id(info.policy_id, policy_offset)
        info.mechanistic_report_id = ir_epistemic_offset_id(info.mechanistic_report_id, mechanistic_offset)
        info.posterior_weights_id = ir_epistemic_offset_id(info.posterior_weights_id, posterior_weights_offset)
        info.counterexample_id = ir_epistemic_offset_id(info.counterexample_id, counterexample_offset)
        (*dst).audits[(*dst).audit_count as usize] = info
        (*dst).audit_count = (*dst).audit_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).contest_count && (*dst).contest_count < IR_MAX_EPI_CONTESTS {
        var info = (*src).contests[i]
        info.id = (*dst).contest_count
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.family_id = ir_epistemic_offset_id(info.family_id, family_offset)
        info.policy_id = ir_epistemic_offset_id(info.policy_id, policy_offset)
        info.mechanistic_report_id = ir_epistemic_offset_id(info.mechanistic_report_id, mechanistic_offset)
        info.posterior_weights_id = ir_epistemic_offset_id(info.posterior_weights_id, posterior_weights_offset)
        info.counterexample_id = ir_epistemic_offset_id(info.counterexample_id, counterexample_offset)
        (*dst).contests[(*dst).contest_count as usize] = info
        (*dst).contest_count = (*dst).contest_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).contest_witness_count && (*dst).contest_witness_count < IR_MAX_EPI_CONTEST_WITNESSES {
        var info = (*src).contest_witnesses[i]
        info.id = (*dst).contest_witness_count
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        (*dst).contest_witnesses[(*dst).contest_witness_count as usize] = info
        (*dst).contest_witness_count = (*dst).contest_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).robust_proof_count && (*dst).robust_proof_count < IR_MAX_EPI_ROBUST_PROOFS {
        var info = (*src).robust_proofs[i]
        info.id = (*dst).robust_proof_count
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        info.policy_id = ir_epistemic_offset_id(info.policy_id, policy_offset)
        (*dst).robust_proofs[(*dst).robust_proof_count as usize] = info
        (*dst).robust_proof_count = (*dst).robust_proof_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).validated_manifest_count && (*dst).validated_manifest_count < IR_MAX_EPI_VALIDATED_MANIFESTS {
        let src_info = (*src).validated_manifests[i]
        (*dst).validated_manifests[(*dst).validated_manifest_count as usize] = IrValidatedManifestInfo {
            id: (*dst).validated_manifest_count,
            span_start: src_info.span_start,
            span_end: src_info.span_end,
            audit_id: ir_epistemic_offset_id(src_info.audit_id, audit_offset),
            robust_proof_id: ir_epistemic_offset_id(src_info.robust_proof_id, robust_offset),
            validation_id: if src_info.validation_id >= 0 {
                src_info.validation_id + validation_offset
            } else {
                src_info.validation_id
            },
            inner_ty: src_info.inner_ty,
        }
        (*dst).validated_manifest_count = (*dst).validated_manifest_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).decision_certificate_count && (*dst).decision_certificate_count < IR_MAX_EPI_DECISION_CERTIFICATES {
        var info = (*src).decision_certificates[i]
        info.id = (*dst).decision_certificate_count
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.robust_proof_id = ir_epistemic_offset_id(info.robust_proof_id, robust_offset)
        info.decision_policy_id = ir_epistemic_offset_id(info.decision_policy_id, decision_policy_offset)
        (*dst).decision_certificates[(*dst).decision_certificate_count as usize] = info
        (*dst).decision_certificate_count = (*dst).decision_certificate_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).deferred_certificate_count && (*dst).deferred_certificate_count < IR_MAX_EPI_DEFERRED_CERTIFICATES {
        var info = (*src).deferred_certificates[i]
        info.id = (*dst).deferred_certificate_count
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        info.robust_proof_id = ir_epistemic_offset_id(info.robust_proof_id, robust_offset)
        info.deferral_policy_id = ir_epistemic_offset_id(info.deferral_policy_id, deferral_policy_offset)
        (*dst).deferred_certificates[(*dst).deferred_certificate_count as usize] = info
        (*dst).deferred_certificate_count = (*dst).deferred_certificate_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).deferred_reason_witness_count && (*dst).deferred_reason_witness_count < IR_MAX_EPI_DEFERRED_REASON_WITNESSES {
        var info = (*src).deferred_reason_witnesses[i]
        info.id = (*dst).deferred_reason_witness_count
        info.deferred_certificate_id = ir_epistemic_offset_id(info.deferred_certificate_id, deferred_certificate_offset)
        (*dst).deferred_reason_witnesses[(*dst).deferred_reason_witness_count as usize] = info
        (*dst).deferred_reason_witness_count = (*dst).deferred_reason_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).acquisition_plan_count && (*dst).acquisition_plan_count < IR_MAX_EPI_ACQUISITION_PLANS {
        var info = (*src).acquisition_plans[i]
        info.id = (*dst).acquisition_plan_count
        info.deferred_certificate_id = ir_epistemic_offset_id(info.deferred_certificate_id, deferred_certificate_offset)
        info.acquisition_policy_id = ir_epistemic_offset_id(info.acquisition_policy_id, acquisition_policy_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        (*dst).acquisition_plans[(*dst).acquisition_plan_count as usize] = info
        (*dst).acquisition_plan_count = (*dst).acquisition_plan_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).acquisition_reason_witness_count && (*dst).acquisition_reason_witness_count < IR_MAX_EPI_ACQUISITION_REASON_WITNESSES {
        let src_info = (*src).acquisition_reason_witnesses[i]
        (*dst).acquisition_reason_witnesses[(*dst).acquisition_reason_witness_count as usize] = IrAcquisitionReasonWitnessInfo {
            id: (*dst).acquisition_reason_witness_count,
            span_start: src_info.span_start,
            span_end: src_info.span_end,
            acquisition_plan_id: if src_info.acquisition_plan_id >= 0 {
                src_info.acquisition_plan_id + acquisition_plan_offset
            } else {
                src_info.acquisition_plan_id
            },
        }
        (*dst).acquisition_reason_witness_count = (*dst).acquisition_reason_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).recourse_plan_count && (*dst).recourse_plan_count < IR_MAX_EPI_RECOURSE_PLANS {
        var info = (*src).recourse_plans[i]
        info.id = (*dst).recourse_plan_count
        info.deferred_certificate_id = ir_epistemic_offset_id(info.deferred_certificate_id, deferred_certificate_offset)
        info.recourse_policy_id = ir_epistemic_offset_id(info.recourse_policy_id, recourse_policy_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        (*dst).recourse_plans[(*dst).recourse_plan_count as usize] = info
        (*dst).recourse_plan_count = (*dst).recourse_plan_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).recourse_reason_witness_count && (*dst).recourse_reason_witness_count < IR_MAX_EPI_RECOURSE_REASON_WITNESSES {
        var info = (*src).recourse_reason_witnesses[i]
        info.id = (*dst).recourse_reason_witness_count
        info.recourse_plan_id = ir_epistemic_offset_id(info.recourse_plan_id, recourse_plan_offset)
        (*dst).recourse_reason_witnesses[(*dst).recourse_reason_witness_count as usize] = info
        (*dst).recourse_reason_witness_count = (*dst).recourse_reason_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).alternative_policy_count && (*dst).alternative_policy_count < IR_MAX_EPI_ALTERNATIVE_POLICIES {
        var info = (*src).alternative_policies[i]
        info.id = (*dst).alternative_policy_count
        (*dst).alternative_policies[(*dst).alternative_policy_count as usize] = info
        (*dst).alternative_policy_count = (*dst).alternative_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).alternative_frontier_count && (*dst).alternative_frontier_count < IR_MAX_EPI_ALTERNATIVE_FRONTIERS {
        var info = (*src).alternative_frontiers[i]
        info.id = (*dst).alternative_frontier_count
        info.alternative_policy_id = ir_epistemic_offset_id(info.alternative_policy_id, alternative_policy_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        info.source_policy_id = ir_epistemic_offset_id(info.source_policy_id, recourse_policy_offset)
        info.source_plan_id = ir_epistemic_offset_id(info.source_plan_id, recourse_plan_offset)
        info.candidate_start = ir_epistemic_offset_id(info.candidate_start, alternative_candidate_offset)
        (*dst).alternative_frontiers[(*dst).alternative_frontier_count as usize] = info
        (*dst).alternative_frontier_count = (*dst).alternative_frontier_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).alternative_candidate_count && (*dst).alternative_candidate_count < IR_MAX_EPI_ALTERNATIVE_CANDIDATES {
        var info = (*src).alternative_candidates[i]
        info.id = (*dst).alternative_candidate_count
        info.frontier_id = ir_epistemic_offset_id(info.frontier_id, alternative_frontier_offset)
        info.source_policy_id = ir_epistemic_offset_id(info.source_policy_id, recourse_policy_offset)
        info.source_plan_id = ir_epistemic_offset_id(info.source_plan_id, recourse_plan_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        (*dst).alternative_candidates[(*dst).alternative_candidate_count as usize] = info
        (*dst).alternative_candidate_count = (*dst).alternative_candidate_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).alternative_set_count && (*dst).alternative_set_count < IR_MAX_EPI_ALTERNATIVE_SETS {
        var info = (*src).alternative_sets[i]
        info.id = (*dst).alternative_set_count
        info.frontier_id = ir_epistemic_offset_id(info.frontier_id, alternative_frontier_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        info.candidate_start = ir_epistemic_offset_id(info.candidate_start, alternative_candidate_offset)
        (*dst).alternative_sets[(*dst).alternative_set_count as usize] = info
        (*dst).alternative_set_count = (*dst).alternative_set_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).alternative_reason_witness_count && (*dst).alternative_reason_witness_count < IR_MAX_EPI_ALTERNATIVE_REASON_WITNESSES {
        var info = (*src).alternative_reason_witnesses[i]
        info.id = (*dst).alternative_reason_witness_count
        info.alternative_set_id = ir_epistemic_offset_id(info.alternative_set_id, alternative_set_offset)
        info.candidate_id = ir_epistemic_offset_id(info.candidate_id, alternative_candidate_offset)
        (*dst).alternative_reason_witnesses[(*dst).alternative_reason_witness_count as usize] = info
        (*dst).alternative_reason_witness_count = (*dst).alternative_reason_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).transition_policy_count && (*dst).transition_policy_count < IR_MAX_EPI_TRANSITION_POLICIES {
        var info = (*src).transition_policies[i]
        info.id = (*dst).transition_policy_count
        (*dst).transition_policies[(*dst).transition_policy_count as usize] = info
        (*dst).transition_policy_count = (*dst).transition_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).transition_step_count && (*dst).transition_step_count < IR_MAX_EPI_TRANSITION_STEPS {
        var info = (*src).transition_steps[i]
        info.id = (*dst).transition_step_count
        info.protocol_id = ir_epistemic_offset_id(info.protocol_id, transition_protocol_offset)
        (*dst).transition_steps[(*dst).transition_step_count as usize] = info
        (*dst).transition_step_count = (*dst).transition_step_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).transition_protocol_count && (*dst).transition_protocol_count < IR_MAX_EPI_TRANSITION_PROTOCOLS {
        var info = (*src).transition_protocols[i]
        info.id = (*dst).transition_protocol_count
        info.transition_policy_id = ir_epistemic_offset_id(info.transition_policy_id, transition_policy_offset)
        info.step_start = ir_epistemic_offset_id(info.step_start, transition_step_offset)
        (*dst).transition_protocols[(*dst).transition_protocol_count as usize] = info
        (*dst).transition_protocol_count = (*dst).transition_protocol_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).transition_plan_count && (*dst).transition_plan_count < IR_MAX_EPI_TRANSITION_PLANS {
        var info = (*src).transition_plans[i]
        info.id = (*dst).transition_plan_count
        info.transition_policy_id = ir_epistemic_offset_id(info.transition_policy_id, transition_policy_offset)
        info.transition_protocol_id = ir_epistemic_offset_id(info.transition_protocol_id, transition_protocol_offset)
        info.alternative_option_id = ir_epistemic_offset_id(info.alternative_option_id, alternative_candidate_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        (*dst).transition_plans[(*dst).transition_plan_count as usize] = info
        (*dst).transition_plan_count = (*dst).transition_plan_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).transition_reason_witness_count && (*dst).transition_reason_witness_count < IR_MAX_EPI_TRANSITION_REASON_WITNESSES {
        var info = (*src).transition_reason_witnesses[i]
        info.id = (*dst).transition_reason_witness_count
        info.transition_plan_id = ir_epistemic_offset_id(info.transition_plan_id, transition_plan_offset)
        (*dst).transition_reason_witnesses[(*dst).transition_reason_witness_count as usize] = info
        (*dst).transition_reason_witness_count = (*dst).transition_reason_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).monitoring_policy_count && (*dst).monitoring_policy_count < IR_MAX_EPI_MONITORING_POLICIES {
        var info = (*src).monitoring_policies[i]
        info.id = (*dst).monitoring_policy_count
        (*dst).monitoring_policies[(*dst).monitoring_policy_count as usize] = info
        (*dst).monitoring_policy_count = (*dst).monitoring_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).observed_transition_count && (*dst).observed_transition_count < IR_MAX_EPI_OBSERVED_TRANSITIONS {
        var info = (*src).observed_transitions[i]
        info.id = (*dst).observed_transition_count
        info.transition_plan_id = ir_epistemic_offset_id(info.transition_plan_id, transition_plan_offset)
        info.monitoring_policy_id = ir_epistemic_offset_id(info.monitoring_policy_id, monitoring_policy_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        (*dst).observed_transitions[(*dst).observed_transition_count as usize] = info
        (*dst).observed_transition_count = (*dst).observed_transition_count + 1
        i = i + 1
    }

    i = 0
    while i < (*src).rollback_certificate_count && (*dst).rollback_certificate_count < IR_MAX_EPI_ROLLBACK_CERTIFICATES {
        var info = (*src).rollback_certificates[i]
        info.id = (*dst).rollback_certificate_count
        info.transition_plan_id = ir_epistemic_offset_id(info.transition_plan_id, transition_plan_offset)
        info.monitoring_policy_id = ir_epistemic_offset_id(info.monitoring_policy_id, monitoring_policy_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        (*dst).rollback_certificates[(*dst).rollback_certificate_count as usize] = info
        (*dst).rollback_certificate_count = (*dst).rollback_certificate_count + 1
        i = i + 1
    }
}

// Compatibility: densifies once into a local then merges in place.
fn ir_merge_epistemic_sections(dst: IrEpistemicSection, src: IrEpistemicSection) -> IrEpistemicSection with Mut, Panic, Div {
    var merged = dst
    ir_merge_epistemic_sections_into(&! merged, &src)
    merged
}

fn ir_merge_algebra_tables_into(dst: &! IrAlgebraTable, src: &IrAlgebraTable) with Mut, Panic, Div {
    var si: i64 = 0
    while si < (*src).count && (*dst).count < 32 {
        let candidate = (*src).entries[si]
        if candidate.is_valid {
            var exists: bool = false
            var di: i64 = 0
            while di < (*dst).count {
                let entry = (*dst).entries[di]
                if entry.is_valid && entry.algebra_tag == candidate.algebra_tag && ir_name_eq(entry.name, candidate.name) {
                    exists = true
                    di = (*dst).count
                } else {
                    di = di + 1
                }
            }
            if exists == false {
                let idx = (*dst).count
                (*dst).entries[idx as usize] = candidate
                (*dst).count = idx + 1
            }
        }
        si = si + 1
    }
}

fn ir_merge_algebra_tables(dst: IrAlgebraTable, src: IrAlgebraTable) -> IrAlgebraTable with Mut, Panic, Div {
    var merged = dst
    ir_merge_algebra_tables_into(&! merged, &src)
    merged
}


// In-place ontology parameter-link merge (Wave10). Prefer over by-value API.
// Same semantics as ir::ir_merge_ontology_parameter_links: compose audit links only;
// destination class/property tables remain authoritative.
fn ir_merge_ontology_parameter_links_into(dst: &! IrOntologyTable, src: &IrOntologyTable) with Mut, Panic, Div {
    var si: i64 = 0
    while si < (*src).parameter_link_count && si < 128 && (*dst).parameter_link_count < 128 {
        let candidate = (*src).parameter_links[si as usize]
        if candidate.is_valid {
            var exists = false
            var di: i64 = 0
            while di < (*dst).parameter_link_count {
                let current = (*dst).parameter_links[di as usize]
                if current.is_valid &&
                   current.parameter_index == candidate.parameter_index &&
                   ir_name_eq(current.function_name, candidate.function_name) &&
                   ir_name_eq(current.class_name, candidate.class_name) {
                    exists = true
                    di = (*dst).parameter_link_count
                } else {
                    di = di + 1
                }
            }
            if !exists {
                let idx = (*dst).parameter_link_count
                (*dst).parameter_links[idx as usize] = candidate
                (*dst).parameter_link_count = idx + 1
            }
        }
        si = si + 1
    }
}

// Proven exclusive-ref surface: &! IrModule (not nested field &!).
// lean_single has historically dropped/miscompiled nested exclusive field refs
// through Box; keep mutations on the whole module ref.
fn ir_merge_sections_into_module(dst: &! IrModule, src: &IrModule) with Mut, Panic, Div {
    ir_merge_epistemic_sections_into(&! (*dst).epistemic, &(*src).epistemic)
    ir_merge_algebra_tables_into(&! (*dst).algebras, &(*src).algebras)
    ir_merge_ontology_parameter_links_into(&! (*dst).ontologies, &(*src).ontologies)
}



// ============================================================
// IR module merging
// ============================================================

// In-place merge: append `src` into `dst` with the same fn_id / epistemic
// offset shifts as the historical by-value `ir_merge_modules`, without the
// two full-IrModule by-value parameter copies and the full by-value return.
// Memory wall P1 (post-#1319 finalize-byref residual).
//
// Index-bind idiom: bind `dst_idx` to a local before the whole-element store —
// inline `ir_fn_set(&! (*dst), (*dst).fn_count, func` miscompiles under lean_single)
// (64KB element store can overshoot onto fn_count). Same proven pattern as
// ir_merge_append_function_into_box / find_or_add_fn_id.
fn ir_merge_modules_into(dst: &! IrModule, src: &IrModule) with Mut, Panic, Div {
    let fn_offset = (*dst).fn_count
    let contest_offset = (*dst).epistemic.contest_count
    let robust_offset = (*dst).epistemic.robust_proof_count
    let decision_offset = (*dst).epistemic.decision_certificate_count
    let deferred_offset = (*dst).epistemic.deferred_certificate_count
    let validated_offset = (*dst).epistemic.validated_manifest_count
    let acquisition_plan_offset = (*dst).epistemic.acquisition_plan_count
    let recourse_plan_offset = (*dst).epistemic.recourse_plan_count
    let alternative_set_offset = (*dst).epistemic.alternative_set_count
    let transition_plan_offset = (*dst).epistemic.transition_plan_count
    let observed_transition_offset = (*dst).epistemic.observed_transition_count
    let rollback_certificate_offset = (*dst).epistemic.rollback_certificate_count
    // Wave11: relocate src BSS past dst BSS (same residual as lower_array path).
    let bss_offset_delta = (*dst).bss_total_size

    var fi: i64 = 0
    while fi < (*src).fn_count && (*dst).fn_count < IR_MAX_FUNCS {
        var func = ir_fn_get(&(*src), fi)
        func.compile_strategy = ir_fn_get(&(*src), fi).compile_strategy
        if func.compile_strategy == IR_STRATEGY_BSS_GLOBAL {
            if bss_offset_delta != 0 {
                func.param_count = func.param_count + bss_offset_delta
            }
        }
        var ii: i64 = 0
        while ii < func.instr_count {
            if (IR_A_OP[(ir_region_slot_r(func.region, (ii))) as usize] as IrOpcode) == IrOpcode::IrCall {
                if IR_A_FN_ID[(ir_region_slot_r(func.region, (ii))) as usize] >= 0 {
                    IR_A_FN_ID[(ir_region_slot_w(func.region, (ii))) as usize] = IR_A_FN_ID[(ir_region_slot_r(func.region, (ii))) as usize] + fn_offset
                }
            }
            if bss_offset_delta != 0 {
                if (IR_A_OP[(ir_region_slot_r(func.region, (ii))) as usize] as IrOpcode) == IrOpcode::IrLoadGlobal || (IR_A_OP[(ir_region_slot_r(func.region, (ii))) as usize] as IrOpcode) == IrOpcode::IrStoreGlobal {
                    IR_A_IMM_I64[(ir_region_slot_w(func.region, (ii))) as usize] = IR_A_IMM_I64[(ir_region_slot_r(func.region, (ii))) as usize] + bss_offset_delta
                }
                if (IR_A_OP[(ir_region_slot_r(func.region, (ii))) as usize] as IrOpcode) == IrOpcode::IrLoadImm {
                    let imm = IR_A_IMM_I64[(ir_region_slot_r(func.region, (ii))) as usize]
                    if imm >= BSS_BASE_LINUX && imm < BSS_BASE_LINUX + 268435456 {
                        IR_A_IMM_I64[(ir_region_slot_w(func.region, (ii))) as usize] = imm + bss_offset_delta
                    }
                }
            }
            let _epi_lid = ir_merge_adjusted_label_id(
                (IR_A_OP[(ir_region_slot_r(func.region, (ii))) as usize] as IrOpcode),
                IR_A_LABEL_ID[(ir_region_slot_r(func.region, (ii))) as usize],
                contest_offset,
                robust_offset,
                decision_offset,
                deferred_offset,
                validated_offset,
                acquisition_plan_offset,
                recourse_plan_offset,
                alternative_set_offset,
                transition_plan_offset,
                observed_transition_offset,
                rollback_certificate_offset
            )
            if _epi_lid != IR_A_LABEL_ID[(ir_region_slot_r(func.region, (ii))) as usize] {
                IR_A_LABEL_ID[(ir_region_slot_w(func.region, (ii))) as usize] = _epi_lid
            }
            ii = ii + 1
        }
        func.compile_strategy = ir_fn_get(&(*src), fi).compile_strategy
        if func.compile_strategy == IR_STRATEGY_BSS_GLOBAL {
            // strategy re-copy may have clobbered param_count; re-apply delta from src base.
            if bss_offset_delta != 0 {
                func.param_count = ir_fn_get(&(*src), fi).param_count + bss_offset_delta
            }
        }
        let dst_idx = (*dst).fn_count
        ir_fn_set(&! (*dst), dst_idx as usize, func)
        (*dst).fn_count = dst_idx + 1
        fi = fi + 1
    }

    (*dst).bss_total_size = (*dst).bss_total_size + (*src).bss_total_size

    var si: i64 = 0
    while si < (*src).string_count && (*dst).string_count < IR_MAX_STRINGS {
        let dst_sidx = (*dst).string_count
        (*dst).string_table[dst_sidx as usize] = (*src).string_table[si as usize]
        (*dst).string_count = dst_sidx + 1
        si = si + 1
    }

    ir_merge_sections_into_module(dst, src)
}

// Compatibility wrapper: only for call sites that still own both modules by
// value. Prefer ir_merge_modules_into. This still densifies once into a local
// then mutates in place — better than the old three-copy (dst+src params + return).
fn ir_merge_modules(dst: IrModule, src: IrModule) -> IrModule with Mut, Panic, Div {
    var merged = dst
    ir_merge_modules_into(&! merged, &src)
    merged
}

fn ir_merge_is_direct_fn_ref_opcode(op: IrOpcode) -> bool {
    match op {
        IrOpcode::IrCall => true,
        IrOpcode::IrCallSret => true,
        IrOpcode::IrLoadFnRef => true,
        _ => false,
    }
}

fn ir_merge_function_name_at(module: &IrModule, fn_id: i64) -> Name with Mut, Div, Panic {
    if fn_id >= 0 && fn_id < (*module).fn_count {
        return ir_fn_get(&(*module), fn_id as usize).name
    }
    ir_empty_name()
}

fn ir_merge_prepare_function_with_remap_from_func(
    func_in: IrFunction,
    src: &IrModule,
    dst: &IrModule,
    dep_fn_count: i64,
    fn_remap: &[i64; 2048],
    contest_offset: i64,
    robust_offset: i64,
    decision_offset: i64,
    deferred_offset: i64,
    validated_offset: i64,
    acquisition_plan_offset: i64,
    recourse_plan_offset: i64,
    alternative_set_offset: i64,
    transition_plan_offset: i64,
    observed_transition_offset: i64,
    rollback_certificate_offset: i64
) -> IrFunction with Mut, Panic, Div {
    var func = ir_function_clone(&func_in)
    var ii: i64 = 0
    while ii < func.instr_count {
        if ir_merge_is_direct_fn_ref_opcode((IR_A_OP[(ir_region_slot_r(func.region, (ii))) as usize] as IrOpcode)) {
            let old_id = IR_A_FN_ID[(ir_region_slot_r(func.region, (ii))) as usize]
            if old_id >= 0 && old_id < dep_fn_count {
                let mapped_id = fn_remap[old_id as usize]
                if mapped_id >= 0 {
                    let dep_name = ir_fn_get(&(*src), old_id as usize).name
                    let current_name = ir_merge_function_name_at(dst, old_id)
                    if ir_name_eq(dep_name, current_name) || ir_merge_find_function_name_index(dst, dep_name) < 0 {
                        IR_A_FN_ID[(ir_region_slot_w(func.region, (ii))) as usize] = mapped_id
                    }
                }
            }
        }
        let _epi_lid = ir_merge_adjusted_label_id(
            (IR_A_OP[(ir_region_slot_r(func.region, (ii))) as usize] as IrOpcode),
            IR_A_LABEL_ID[(ir_region_slot_r(func.region, (ii))) as usize],
            contest_offset,
            robust_offset,
            decision_offset,
            deferred_offset,
            validated_offset,
            acquisition_plan_offset,
            recourse_plan_offset,
            alternative_set_offset,
            transition_plan_offset,
            observed_transition_offset,
            rollback_certificate_offset
        )
        if _epi_lid != IR_A_LABEL_ID[(ir_region_slot_r(func.region, (ii))) as usize] {
            IR_A_LABEL_ID[(ir_region_slot_w(func.region, (ii))) as usize] = _epi_lid
        }
        ii = ii + 1
    }
    func
}

fn ir_merge_prepare_function_with_remap(
    src: &IrModule,
    src_fi: i64,
    dep_fn_count: i64,
    fn_remap: &[i64; 2048],
    contest_offset: i64,
    robust_offset: i64,
    decision_offset: i64,
    deferred_offset: i64,
    validated_offset: i64,
    acquisition_plan_offset: i64,
    recourse_plan_offset: i64,
    alternative_set_offset: i64,
    transition_plan_offset: i64,
    observed_transition_offset: i64,
    rollback_certificate_offset: i64
) -> IrFunction with Mut, Panic, Div {
    ir_merge_prepare_function_with_remap_from_func(
        ir_fn_get(&(*src), src_fi as usize),
        src,
        src,
        dep_fn_count,
        fn_remap,
        contest_offset,
        robust_offset,
        decision_offset,
        deferred_offset,
        validated_offset,
        acquisition_plan_offset,
        recourse_plan_offset,
        alternative_set_offset,
        transition_plan_offset,
        observed_transition_offset,
        rollback_certificate_offset
    )
}

// Resolve a merged-module fn_id by symbol name. Prefer a lowered body (instr_count>0)
// over import stubs so dependency functions keep calling real implementations.
fn ir_merge_find_function_name_index(module: &IrModule, name: Name) -> i64 with Mut, Div, Panic {
    var fi: i64 = 0
    var found: i64 = 0 - 1
    var found_stub: i64 = 0 - 1
    while fi < (*module).fn_count {
        if ir_name_eq(ir_function_name_at(module, fi as usize), name) {
            if ir_fn_instr_count(module, fi as usize) > 0 {
                found = fi
            } else if found_stub < 0 {
                found_stub = fi
            }
        }
        fi = fi + 1
    }
    if found >= 0 { found } else { found_stub }
}

// After stub replacement, remap in-function IrCall/IrCallSret targets from the
// dependency module's local fn_id space to the accumulated module by name.
fn ir_merge_remap_existing_call_targets(func: IrFunction, src: &IrModule, dst: &IrModule) -> IrFunction with Mut, Panic, Div {
    var out = ir_function_clone(&func)
    var ii: i64 = 0
    while ii < out.instr_count {
        if (IR_A_OP[(ir_region_slot_r(out.region, (ii))) as usize] as IrOpcode) == IrOpcode::IrCall || (IR_A_OP[(ir_region_slot_r(out.region, (ii))) as usize] as IrOpcode) == IrOpcode::IrCallSret {
            let old_id = IR_A_FN_ID[(ir_region_slot_r(out.region, (ii))) as usize]
            if old_id >= 0 && old_id < (*src).fn_count {
                let target_name = ir_fn_get(&(*src), old_id as usize).name
                let new_id = ir_merge_find_function_name_index(dst, target_name)
                if new_id >= 0 {
                    IR_A_FN_ID[(ir_region_slot_w(out.region, (ii))) as usize] = new_id
                }
            }
        }
        ii = ii + 1
    }
    out
}

// Memory wall Wave10: single IrFunction materialization for place+remap.
// Old lower_array path did:
//   dep_func = ir_fn_get(&src, mfi)                         // copy 1
//   dep_func = remap_existing_call_targets(dep_func, ...) // copy 2 in+out
//   func = prepare_with_remap_from_func(dep_func, ...)    // copy 3 in+out
//   ir_fn_set(&! dst, dst_fi, func                          // copy 4)
// Each IrFunction is ~[IrInstr;4096] (~1 MiB). Peak temps stacked.
// New: one local + one slot write. Remap call targets + prepare map +
// epistemic label shifts in a single instr pass. Scalar field stores only
// on the owned local (no IrInstr by-value; A8/A14 safe).
// Wave11: also remap BSS offsets. Each module lowers BSS slots with
// module-local param_count/imm starting at 0. Without +bss_offset_delta
// (= dst.bss_total_size at merge time), two imported modules' f64 globals
// collide at BSS+0 — last init wins (A_CONST and B_CONST both read as 2.5).
fn ir_merge_place_and_remap_function(
    dst: &! IrModule,
    src: &IrModule,
    src_fi: i64,
    dst_fi: i64,
    dep_fn_count: i64,
    fn_remap: &[i64; 2048],
    contest_offset: i64,
    robust_offset: i64,
    decision_offset: i64,
    deferred_offset: i64,
    validated_offset: i64,
    acquisition_plan_offset: i64,
    recourse_plan_offset: i64,
    alternative_set_offset: i64,
    transition_plan_offset: i64,
    observed_transition_offset: i64,
    rollback_certificate_offset: i64,
    bss_offset_delta: i64
) with Mut, Panic, Div {
    if src_fi < 0 || src_fi >= (*src).fn_count {
        return
    }
    if dst_fi < 0 || dst_fi >= IR_MAX_FUNCS {
        return
    }
    // One full-function materialization from the dependency module.
    var func = ir_fn_get(&(*src), src_fi as usize)
    func.compile_strategy = ir_fn_get(&(*src), src_fi as usize).compile_strategy
    // BSS slot: param_count holds the module-local BSS byte offset.
    if func.compile_strategy == IR_STRATEGY_BSS_GLOBAL {
        if bss_offset_delta != 0 {
            func.param_count = func.param_count + bss_offset_delta
        }
    }
    var ii: i64 = 0
    while ii < func.instr_count {
        let op = (IR_A_OP[(ir_region_slot_r(func.region, (ii))) as usize] as IrOpcode)
        // Combined remap_existing + prepare map for direct fn refs.
        if ir_merge_is_direct_fn_ref_opcode(op) {
            let old_id = IR_A_FN_ID[(ir_region_slot_r(func.region, (ii))) as usize]
            if old_id >= 0 && old_id < dep_fn_count {
                // Name-based remap to already-merged bodies in dst (remap_existing).
                let target_name = ir_fn_get(&(*src), old_id as usize).name
                let named_id = ir_merge_find_function_name_index(dst, target_name)
                if named_id >= 0 {
                    IR_A_FN_ID[(ir_region_slot_w(func.region, (ii))) as usize] = named_id
                } else {
                    // Planned append index from fn_remap (prepare path).
                    let mapped_id = fn_remap[old_id as usize]
                    if mapped_id >= 0 {
                        let dep_name = ir_fn_get(&(*src), old_id as usize).name
                        let current_name = ir_merge_function_name_at(dst, old_id)
                        if ir_name_eq(dep_name, current_name) || ir_merge_find_function_name_index(dst, dep_name) < 0 {
                            IR_A_FN_ID[(ir_region_slot_w(func.region, (ii))) as usize] = mapped_id
                        }
                    }
                }
            }
        }
        // Relative BSS offsets in global load/store (codegen adds BSS_BASE).
        // Wave13: prefer name→existing BSS slot when seed preseeded (or prior
        // merge DEDUP'd) the global — plain +delta is wrong for those slots.
        if op == IrOpcode::IrLoadGlobal || op == IrOpcode::IrStoreGlobal {
            let gname = ir_arena_name(ir_region_slot_r(func.region, (ii)))
            var named_bss: i64 = 0 - 1
            if gname.len > 0 {
                var gi: i64 = 0
                while gi < (*dst).fn_count {
                    if ir_name_eq(ir_fn_get(&(*dst), gi as usize).name, gname)
                        && ir_fn_get(&(*dst), gi as usize).compile_strategy == IR_STRATEGY_BSS_GLOBAL
                    {
                        named_bss = gi
                        gi = (*dst).fn_count
                    } else {
                        gi = gi + 1
                    }
                }
            }
            if named_bss >= 0 {
                IR_A_IMM_I64[(ir_region_slot_w(func.region, (ii))) as usize] = ir_fn_get(&(*dst), named_bss as usize).param_count
            } else if bss_offset_delta != 0 {
                IR_A_IMM_I64[(ir_region_slot_w(func.region, (ii))) as usize] = IR_A_IMM_I64[(ir_region_slot_r(func.region, (ii))) as usize] + bss_offset_delta
            }
        }
        // Aggregate path bakes BSS_BASE+local_off as IrLoadImm absolute.
        // Remap addresses in the BSS window; skip unrelated immediates.
        if bss_offset_delta != 0 {
            if op == IrOpcode::IrLoadImm {
                let imm = IR_A_IMM_I64[(ir_region_slot_r(func.region, (ii))) as usize]
                if imm >= BSS_BASE_LINUX && imm < BSS_BASE_LINUX + 268435456 {
                    IR_A_IMM_I64[(ir_region_slot_w(func.region, (ii))) as usize] = imm + bss_offset_delta
                }
            }
        }
        // Scalar-only epistemic label shift — never rebind IrInstr by value.
        let new_lid = ir_merge_adjusted_label_id(
            op,
            IR_A_LABEL_ID[(ir_region_slot_r(func.region, (ii))) as usize],
            contest_offset,
            robust_offset,
            decision_offset,
            deferred_offset,
            validated_offset,
            acquisition_plan_offset,
            recourse_plan_offset,
            alternative_set_offset,
            transition_plan_offset,
            observed_transition_offset,
            rollback_certificate_offset
        )
        if new_lid != IR_A_LABEL_ID[(ir_region_slot_r(func.region, (ii))) as usize] {
            IR_A_LABEL_ID[(ir_region_slot_w(func.region, (ii))) as usize] = new_lid
        }
        ii = ii + 1
    }
    // Index-bind before whole-element store (lean_single proven pattern).
    if dst_fi < (*dst).fn_count {
        let _rc_existing = ir_fn_set(&! (*dst), dst_fi as usize, func)
    } else if dst_fi == (*dst).fn_count && (*dst).fn_count < IR_MAX_FUNCS {
        let idx = (*dst).fn_count
        let _rc_append = ir_fn_set(&! (*dst), idx as usize, func)
        (*dst).fn_count = idx + 1
    }
}

// Takes &! IrModule (not &! Box<IrModule>): the latter triggers a lean_single
// codegen bug where (*box_ref).field reads garbage. Callers materialize the
// IrModule reference via &! (*acc_box) at the call site.
fn ir_merge_append_function_into_box(dst: &! IrModule, src: &IrModule, src_fi: i64) with Mut, Panic, Div {
    if src_fi < 0 || src_fi >= (*src).fn_count || (*dst).fn_count >= IR_MAX_FUNCS {
        return
    }
    let fn_offset = (*dst).fn_count
    let contest_offset = (*dst).epistemic.contest_count
    let robust_offset = (*dst).epistemic.robust_proof_count
    let decision_offset = (*dst).epistemic.decision_certificate_count
    let deferred_offset = (*dst).epistemic.deferred_certificate_count
    let validated_offset = (*dst).epistemic.validated_manifest_count
    let acquisition_plan_offset = (*dst).epistemic.acquisition_plan_count
    let recourse_plan_offset = (*dst).epistemic.recourse_plan_count
    let alternative_set_offset = (*dst).epistemic.alternative_set_count
    let transition_plan_offset = (*dst).epistemic.transition_plan_count
    let observed_transition_offset = (*dst).epistemic.observed_transition_count
    let rollback_certificate_offset = (*dst).epistemic.rollback_certificate_count
    var func = ir_fn_get(&(*src), src_fi as usize)
    func.compile_strategy = ir_fn_get(&(*src), src_fi as usize).compile_strategy
    var ii: i64 = 0
    while ii < func.instr_count {
        if ir_merge_is_direct_fn_ref_opcode((IR_A_OP[(ir_region_slot_r(func.region, (ii))) as usize] as IrOpcode)) {
            if IR_A_FN_ID[(ir_region_slot_r(func.region, (ii))) as usize] >= 0 {
                IR_A_FN_ID[(ir_region_slot_w(func.region, (ii))) as usize] = IR_A_FN_ID[(ir_region_slot_r(func.region, (ii))) as usize] + fn_offset
            }
        }
        let _epi_lid = ir_merge_adjusted_label_id(
            (IR_A_OP[(ir_region_slot_r(func.region, (ii))) as usize] as IrOpcode),
            IR_A_LABEL_ID[(ir_region_slot_r(func.region, (ii))) as usize],
            contest_offset,
            robust_offset,
            decision_offset,
            deferred_offset,
            validated_offset,
            acquisition_plan_offset,
            recourse_plan_offset,
            alternative_set_offset,
            transition_plan_offset,
            observed_transition_offset,
            rollback_certificate_offset
        )
        if _epi_lid != IR_A_LABEL_ID[(ir_region_slot_r(func.region, (ii))) as usize] {
            IR_A_LABEL_ID[(ir_region_slot_w(func.region, (ii))) as usize] = _epi_lid
        }
        ii = ii + 1
    }
    let dst_idx = (*dst).fn_count
    ir_fn_set(&! (*dst), dst_idx as usize, func)
    (*dst).fn_count = (*dst).fn_count + 1
}

// Resolve a call's canonical target from its (fn_id, name) fields only.
// Prefer lowered bodies (instr_count>0) over import stubs; fall back to the
// callee symbol at the current fn_id when the call's name is empty.
//
// A8 fix: the previous entry point (`ir_module_resolve_one_call_target`) took
// `instr: IrInstr` BY VALUE. IrInstr is a
// large struct carrying a `Box` (call_args); under lean_single, passing it by value
// miscompiles the copy and corrupts the CALLER's `ins` local (dst/src1/call_args all
// scramble), which was then written back — SIGSEGV in cross-module forwarding fns
// (`var r = zero(k); r.c[i]=1; return r`). Passing only the scalar fn_id + fixed-size
// Name avoids the large-struct/Box by-value copy entirely.
fn ir_module_resolve_call_target_fields(module: &IrModule, old_id: i64, instr_name: Name) -> i64 with Mut, Div, Panic {
    var resolve_name = instr_name
    if resolve_name.len == 0 && old_id >= 0 && old_id < (*module).fn_count {
        resolve_name = ir_function_name_at(module, old_id as usize)
    }
    if resolve_name.len > 0 {
        let new_id = ir_merge_find_function_name_index(module, resolve_name)
        if new_id >= 0 && ir_fn_instr_count(module, new_id as usize) > 0 {
            return new_id
        }
    }
    // Remap calls that still point at import stubs (ic=0) even when name-based
    // lookup above failed — duplicate symbols can leave stale low fn_ids.
    if old_id >= 0 && old_id < (*module).fn_count {
        if ir_fn_instr_count(module, old_id as usize) == 0 {
            let stub_name = ir_function_name_at(module, old_id as usize)
            let new_id = ir_merge_find_function_name_index(module, stub_name)
            if new_id >= 0 && new_id != old_id && ir_fn_instr_count(module, new_id as usize) > 0 {
                return new_id
            }
        }
    }
    old_id
}

// After multimodule merge, rebind every direct IrCall/IrCallSret to the merged
// module's canonical fn_id for instr.name. Prefer lowered bodies over import stubs.
fn ir_module_resolve_all_call_targets(module: &! IrModule) with Mut, Div, Panic {
    var fi: i64 = 0
    while fi < (*module).fn_count {
        var f = ir_fn_get(&(*module), fi as usize)
        var changed: bool = false
        var ii: i64 = 0
        while ii < f.instr_count {
            let op = (IR_A_OP[(ir_region_slot_r(f.region, (ii))) as usize] as IrOpcode)
            if op == IrOpcode::IrCall || op == IrOpcode::IrCallSret {
                let cur_fn = IR_A_FN_ID[(ir_region_slot_r(f.region, (ii))) as usize]
                let cur_nm = ir_arena_name(ir_region_slot_r(f.region, (ii)))
                var new_fn = cur_fn
                if cur_nm.len > 0 && native_v2_builtin_id_for_name(cur_nm) != 0 {
                    let builtin_fn = ir_merge_find_function_name_index(module, cur_nm)
                    if builtin_fn >= 0 { new_fn = builtin_fn }
                } else {
                    new_fn = ir_module_resolve_call_target_fields(module, cur_fn, cur_nm)
                }
                if new_fn != cur_fn {
                    IR_A_FN_ID[(ir_region_slot_w(f.region, (ii))) as usize] = new_fn
                    changed = true
                }
            }
            ii = ii + 1
        }
        if changed {
            ir_fn_set(&! (*module), fi as usize, f)
        }
        fi = fi + 1
    }
}

fn ir_module_dump_find_name(module: &IrModule, label: Name, sym: Name) with IO, Mut, Div, Panic {
    let idx = ir_merge_find_function_name_index(module, sym)
    print("MERGE_DUMP: find(")
    print(str_from_bytes(label.buf, label.len))
    print(")=")
    print_int(idx)
    if idx >= 0 && idx < (*module).fn_count {
        print(" ic=")
        print_int(ir_fn_get(&(*module), idx as usize).instr_count)
    }
    print("\n")
}

fn ir_module_dump_instr_op_tag(op: IrOpcode) -> i64 with Mut, Panic, Div {
    // Use IrOpcode enum discriminants (not serialize wire tags).
    if op == IrOpcode::IrLoadImm { return 0 }
    if op == IrOpcode::IrLoadFloat { return 1 }
    if op == IrOpcode::IrIntToFloat { return 2 }
    if op == IrOpcode::IrFloatToInt { return 3 }
    if op == IrOpcode::IrLoadBool { return 4 }
    if op == IrOpcode::IrLoadString { return 5 }
    if op == IrOpcode::IrCopy { return 6 }
    if op == IrOpcode::IrBinOp { return 7 }
    if op == IrOpcode::IrUnaryOp { return 8 }
    if op == IrOpcode::IrCall { return 9 }
    if op == IrOpcode::IrReturn { return 10 }
    if op == IrOpcode::IrJump { return 11 }
    if op == IrOpcode::IrBranchTrue { return 12 }
    if op == IrOpcode::IrBranchFalse { return 13 }
    if op == IrOpcode::IrFieldGet { return 14 }
    if op == IrOpcode::IrFieldSet { return 15 }
    if op == IrOpcode::IrIndexGet { return 16 }
    if op == IrOpcode::IrIndexSet { return 17 }
    if op == IrOpcode::IrAlloc { return 18 }
    if op == IrOpcode::IrLabel { return 19 }
    if op == IrOpcode::IrNop { return 20 }
    if op == IrOpcode::IrCallSret { return 35 }
    if op == IrOpcode::IrReturnSret { return 36 }
    if op == IrOpcode::IrCallExtern { return 40 }
    if op == IrOpcode::IrCallIndirect { return 41 }
    99
}

fn ir_module_dump_fn_body(module: &IrModule, fn_index: i64, label: string) with IO, Mut, Div, Panic {
    if fn_index < 0 || fn_index >= (*module).fn_count { return }
    print("MERGE_DUMP: body ")
    print(label)
    print(" fn=")
    print_int(fn_index)
    print(" name=")
    print(str_from_bytes(ir_fn_get(&(*module), fn_index as usize).name.buf, ir_fn_get(&(*module), fn_index as usize).name.len))
    print(" ic=")
    print_int(ir_fn_get(&(*module), fn_index as usize).instr_count)
    print("\n")
    var ii: i64 = 0
    while ii < ir_fn_get(&(*module), fn_index as usize).instr_count {
        let ins = ir_arena_load(ir_region_slot_r(ir_fn_get(&(*module), fn_index as usize).region, (ii)))
        let tag = ir_module_dump_instr_op_tag(ins.op)
        print("  ii=")
        print_int(ii)
        print(" tag=")
        print_int(tag)
        if tag > 0 {
            print(" dst=")
            print_int(ins.dst)
            print(" src1=")
            print_int(ins.src1)
            print(" src2=")
            print_int(ins.src2)
            print(" field=")
            print_int(ins.field_idx)
            print(" label=")
            print_int(ins.label_id)
            print(" fn_id=")
            print_int(ins.fn_id)
            if ins.op == IrOpcode::IrCall || ins.op == IrOpcode::IrCallSret {
                print(" name=")
                print(str_from_bytes(ir_name_at(ins.name_id).buf, ir_name_at(ins.name_id).len))
            }
        }
        print("\n")
        ii = ii + 1
    }
}

fn ir_diag_opcode_tag(op: IrOpcode) -> i64 {
    if op == IrOpcode::IrLoadImm { 0 }
    else if op == IrOpcode::IrCopy { 4 }
    else if op == IrOpcode::IrBinOp { 5 }
    else if op == IrOpcode::IrCall { 7 }
    else if op == IrOpcode::IrReturn { 8 }
    else if op == IrOpcode::IrFieldGet { 12 }
    else if op == IrOpcode::IrFieldSet { 13 }
    else if op == IrOpcode::IrIndexGet { 14 }
    else if op == IrOpcode::IrIndexSet { 15 }
    else if op == IrOpcode::IrAlloc { 16 }
    else if op == IrOpcode::IrCallSret { 40 }
    else if op == IrOpcode::IrReturnSret { 41 }
    else { 99 }
}

fn ir_module_dump_all_calls_diag(module: &IrModule) with IO, Mut, Div, Panic {
    print("DUMPALL fn_count=")
    print_int((*module).fn_count)
    print("\n")
    var fi: i64 = 0
    while fi < (*module).fn_count {
        let fname = ir_fn_get(&(*module), fi as usize).name
        print("DUMPFN idx ")
        print_int(fi)
        print(" ic ")
        print_int(ir_fn_get(&(*module), fi as usize).instr_count)
        print(" NM=[")
        print(str_from_bytes(fname.buf, fname.len))
        print("]\n")
        let ficnt = ir_fn_get(&(*module), fi as usize).instr_count
        if ficnt > 0 && ficnt < 40 {
            var ii: i64 = 0
            while ii < ficnt {
                let ins = ir_arena_load(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (ii)))
                // one print_int per line (compiler print_int appends \n).
                print("Dq i=")
                print_int(ii)
                print("Dq op=")
                print_int(ir_diag_opcode_tag(ins.op))
                print("Dq dst=")
                print_int(ins.dst)
                print("Dq s1=")
                print_int(ins.src1)
                print("Dq s2=")
                print_int(ins.src2)
                print("Dq fi=")
                print_int(ins.field_idx)
                print("Dq ac=")
                print_int(ins.arg_count)
                print("Dq imm=")
                print_int(ins.imm_i64)
                print("Dq fn=")
                print_int(ins.fn_id)
                var cur_args = &ins.call_args
                var guard: i64 = 0
                while guard < 8 {
                    match *cur_args {
                        Some(rl) => {
                            print("Dq arg=")
                            print_int((*rl).head)
                            cur_args = &(*rl).tail
                            guard = guard + 1
                        }
                        None => { guard = 8 }
                    }
                }
                ii = ii + 1
            }
        }
        fi = fi + 1
    }
}

fn ir_module_dump_merge_calls(module: &IrModule) with IO, Mut, Div, Panic {
    print("MERGE_DUMP: fn_count=")
    print_int((*module).fn_count)
    print("\n")
    let watch_pb = make_name("pb_vacuous")
    let watch_pred = make_name("predict_cmin_knightian")
    let watch_main = make_name("main")
    ir_module_dump_find_name(module, make_name("pb_vacuous"), watch_pb)
    ir_module_dump_find_name(module, make_name("pb_new"), make_name("pb_new"))
    ir_module_dump_find_name(module, make_name("pb_lo_mean"), make_name("pb_lo_mean"))
    ir_module_dump_find_name(module, make_name("vp_vc_to_pbox"), make_name("vp_vc_to_pbox"))
    ir_module_dump_find_name(module, make_name("vp_default"), make_name("vp_default"))
    var fi: i64 = 0
    while fi < (*module).fn_count {
        let fname = ir_fn_get(&(*module), fi as usize).name
        if ir_name_eq(fname, watch_pb) || ir_name_eq(fname, watch_pred) || ir_name_eq(fname, watch_main)
            || ir_name_eq(fname, make_name("pb_new")) || ir_name_eq(fname, make_name("pb_lo_mean"))
            || ir_name_eq(fname, make_name("vp_vc_to_pbox")) || ir_name_eq(fname, make_name("vp_default")) {
            print("MERGE_DUMP: sym[")
            print_int(fi)
            print("] ")
            print(str_from_bytes(fname.buf, fname.len))
            print(" ic=")
            print_int(ir_fn_get(&(*module), fi as usize).instr_count)
            print("\n")
        }
        fi = fi + 1
    }
    var vfi: i64 = 0
    while vfi < (*module).fn_count {
        if ir_name_eq(ir_fn_get(&(*module), vfi as usize).name, make_name("vp_vc_to_pbox")) {
            if ir_fn_get(&(*module), vfi as usize).instr_count > 0 {
                print("MERGE_DUMP: vp_vc_to_pbox calls\n")
                var ii: i64 = 0
                while ii < ir_fn_get(&(*module), vfi as usize).instr_count {
                    let ins = ir_arena_load(ir_region_slot_r(ir_fn_get(&(*module), vfi as usize).region, (ii)))
                    if ins.op == IrOpcode::IrCall || ins.op == IrOpcode::IrCallSret {
                        print("  call ii=")
                        print_int(ii)
                        print(" fn_id=")
                        print_int(ins.fn_id)
                        print(" name=")
                        print(str_from_bytes(ir_name_at(ins.name_id).buf, ir_name_at(ins.name_id).len))
                        if ins.fn_id >= 0 && ins.fn_id < (*module).fn_count {
                            print(" ->")
                            print(str_from_bytes(ir_fn_get(&(*module), ins.fn_id as usize).name.buf, ir_fn_get(&(*module), ins.fn_id as usize).name.len))
                            print(" ic=")
                            print_int(ir_fn_get(&(*module), ins.fn_id as usize).instr_count)
                        }
                        print("\n")
                    }
                    ii = ii + 1
                }
            }
        }
        vfi = vfi + 1
    }
    var pfi: i64 = 0
    while pfi < (*module).fn_count {
        if ir_name_eq(ir_fn_get(&(*module), pfi as usize).name, watch_pred) {
            print("MERGE_DUMP: predict calls/returns\n")
            var ii: i64 = 0
            while ii < ir_fn_get(&(*module), pfi as usize).instr_count {
                let ins = ir_arena_load(ir_region_slot_r(ir_fn_get(&(*module), pfi as usize).region, (ii)))
                if ins.op == IrOpcode::IrCall || ins.op == IrOpcode::IrCallSret {
                    print("  call ii=")
                    print_int(ii)
                    print(" fn_id=")
                    print_int(ins.fn_id)
                    print(" name=")
                    print(str_from_bytes(ir_name_at(ins.name_id).buf, ir_name_at(ins.name_id).len))
                    if ins.fn_id >= 0 && ins.fn_id < (*module).fn_count {
                        print(" ->")
                        print(str_from_bytes(ir_fn_get(&(*module), ins.fn_id as usize).name.buf, ir_fn_get(&(*module), ins.fn_id as usize).name.len))
                        print(" ic=")
                        print_int(ir_fn_get(&(*module), ins.fn_id as usize).instr_count)
                    }
                    print("\n")
                } else if ins.op == IrOpcode::IrReturn {
                    print("  return ii=")
                    print_int(ii)
                    print(" reg=")
                    print_int(ins.src1)
                    print("\n")
                }
                ii = ii + 1
            }
        }
        pfi = pfi + 1
    }
    // User main is the smallest `main` body (lowest instr_count) — merged modules
    // and debug helpers can append larger `main` stubs later in fn_id space.
    var user_main: i64 = 0 - 1
    var user_main_ic: i64 = 1000000000
    var mfi: i64 = 0
    while mfi < (*module).fn_count {
        if ir_name_eq(ir_fn_get(&(*module), mfi as usize).name, watch_main) {
            let mic = ir_fn_get(&(*module), mfi as usize).instr_count
            if mic > 0 && mic < user_main_ic {
                user_main = mfi
                user_main_ic = mic
            }
        }
        mfi = mfi + 1
    }
    if user_main >= 0 {
        print("MERGE_DUMP: user_main_idx=")
        print_int(user_main)
        print(" ic=")
        print_int(ir_fn_get(&(*module), user_main as usize).instr_count)
        print("\n")
        print("MERGE_DUMP: user_main calls\n")
        var ii: i64 = 0
        while ii < ir_fn_get(&(*module), user_main as usize).instr_count {
            let ins = ir_arena_load(ir_region_slot_r(ir_fn_get(&(*module), user_main as usize).region, (ii)))
            if ins.op == IrOpcode::IrCall || ins.op == IrOpcode::IrCallSret {
                print("  call ii=")
                print_int(ii)
                print(" fn_id=")
                print_int(ins.fn_id)
                print(" name=")
                print(str_from_bytes(ir_name_at(ins.name_id).buf, ir_name_at(ins.name_id).len))
                if ins.fn_id >= 0 && ins.fn_id < (*module).fn_count {
                    print(" ->")
                    print(str_from_bytes(ir_fn_get(&(*module), ins.fn_id as usize).name.buf, ir_fn_get(&(*module), ins.fn_id as usize).name.len))
                    print(" ic=")
                    print_int(ir_fn_get(&(*module), ins.fn_id as usize).instr_count)
                }
                print("\n")
            }
            ii = ii + 1
        }
        ir_module_dump_fn_body(module, user_main, "user_main")
        let pb_conf_idx = ir_merge_find_function_name_index(module, make_name("pb_confidence"))
        if pb_conf_idx >= 0 {
            ir_module_dump_fn_body(module, pb_conf_idx, "pb_confidence")
        }
        let pb_lo_idx = ir_merge_find_function_name_index(module, make_name("pb_lo_mean"))
        if pb_lo_idx >= 0 {
            ir_module_dump_fn_body(module, pb_lo_idx, "pb_lo_mean")
        }
    }
}

// Map a fn_id to the merged module's canonical index for its symbol name.
// Prefer lowered bodies (instr_count>0) over import stubs.
fn ir_module_canonical_fn_id_for_index(module: &IrModule, fn_id: i64) -> i64 with Mut, Div, Panic {
    if fn_id < 0 || fn_id >= (*module).fn_count {
        return fn_id
    }
    let sym_name = ir_fn_get(&(*module), fn_id as usize).name
    if sym_name.len == 0 {
        return fn_id
    }
    let canon = ir_merge_find_function_name_index(module, sym_name)
    if canon >= 0 {
        return canon
    }
    fn_id
}

// Rewrite fn refs via whole-function writeback; nested instr writes are dropped by lean_single.
// In-place on &! IrModule (memory wall P0): never take/return full IrModule by value.
fn ir_module_compact_duplicate_fn_refs(module: &! IrModule) with Mut, Div, Panic {
    var pass: i64 = 0
    while pass < 2 {
        var fi: i64 = 0
        while fi < (*module).fn_count {
            // A14: whole-function copy/writeback — do not reintroduce IrInstr by-value.
            var f = ir_fn_get(&(*module), fi as usize)
            var changed: bool = false
            var ii: i64 = 0
            while ii < f.instr_count {
                if ir_merge_is_direct_fn_ref_opcode((IR_A_OP[(ir_region_slot_r(f.region, (ii))) as usize] as IrOpcode)) {
                    let old_id = IR_A_FN_ID[(ir_region_slot_r(f.region, (ii))) as usize]
                    let nm = ir_arena_name(ir_region_slot_r(f.region, (ii)))
                    var canon: i64 = old_id
                    if nm.len > 0 {
                        let by_name = ir_merge_find_function_name_index(module, nm)
                        if by_name >= 0 && ir_fn_get(&(*module), by_name as usize).instr_count > 0 {
                            canon = by_name
                        }
                    } else if old_id >= 0 {
                        canon = ir_module_canonical_fn_id_for_index(module, old_id)
                    }
                    if canon >= 0
                        && canon < (*module).fn_count
                        && ir_fn_get(&(*module), canon as usize).instr_count > 0
                        && canon != old_id {
                        IR_A_FN_ID[(ir_region_slot_w(f.region, (ii))) as usize] = canon
                        changed = true
                    }
                }
                ii = ii + 1
            }
            if changed {
                ir_fn_set(&! (*module), fi as usize, f)
            }
            fi = fi + 1
        }
        pass = pass + 1
    }
}

// Deep-copy an IrFunction so lean_single struct assignment does not alias instr slots.
fn ir_function_deep_copy(func: IrFunction) -> IrFunction with Mut, Panic, Div {
    var out = ir_function_clone(&func)
    var ii: i64 = 0
    while ii < func.instr_count && ii < IR_MAX_INSTRS {
        ir_arena_copy_slot(ir_region_slot_w(out.region, (ii)),ir_region_slot_r(func.region, (ii)))
        ii = ii + 1
    }
    out
}

// When merge leaves import stubs (ic=0) alongside lowered duplicates at higher
// fn_id, copy the canonical body into the stub slot so codegen fn_offsets for
// stale low indices still reach real implementations.
// In-place on &! IrModule (memory wall P0).
fn ir_module_promote_canonical_into_stub_slots(module: &! IrModule) with Mut, Div, Panic {
    var fi: i64 = 0
    while fi < (*module).fn_count {
        if ir_fn_get(&(*module), fi as usize).instr_count == 0 {
            let sym_name = ir_fn_get(&(*module), fi as usize).name
            if sym_name.len > 0 {
                let canon = ir_merge_find_function_name_index(module, sym_name)
                if canon >= 0 && canon != fi && ir_fn_get(&(*module), canon as usize).instr_count > 0 {
                    ir_fn_set(&! (*module), fi as usize, ir_function_deep_copy(ir_fn_get(&(*module), canon as usize)))
                }
            }
        }
        fi = fi + 1
    }
}

// Ensure every call to a BUILTIN name (str_char_at, str_len, str_from_bytes, ...)
// points at a slot bearing that name so codegen emits the builtin body. Builtins
// carry no IR body (instr_count==0, synthesized at codegen), so the normal name
// resolver — which only accepts targets with instr_count>0 — never binds them. A
// builtin referenced ONLY transitively (an imported fn's body calls it, the root
// module never does) is also absent from the merged module entirely. Append a
// named stub when missing and rebind the call. Whole-function writeback per A14.
// In-place on &! IrModule (memory wall P0): mutate through exclusive ref of the
// unboxed module (same pattern as ir_module_resolve_named_calls / resolve_all).
// Do not take/return full IrModule by value — multi-mod modules are hundreds of MB.
// Wave14e: float-returning empty stubs (exp/cos/sin/log/sqrt) must set
// returns_float=1 and stamp IR_FLOAT_REG_MARKER_FLAG on call sites. Otherwise
// bare float intrinsics look correct under print_f64/f64_to_bits (integer ABI
// on bits) but subsequent f64 arithmetic cvtsi2sd's the bit pattern.
fn ir_module_ensure_builtin_call_targets(module: &! IrModule) with Mut, Div, Panic {
    var fi: i64 = 0
    while fi < (*module).fn_count {
        // A14: whole-function copy/writeback — do not reintroduce IrInstr by-value.
        var f = ir_fn_get(&(*module), fi as usize)
        var changed: bool = false
        var ii: i64 = 0
        while ii < f.instr_count {
            let op = (IR_A_OP[(ir_region_slot_r(f.region, (ii))) as usize] as IrOpcode)
            if op == IrOpcode::IrCall || op == IrOpcode::IrCallSret {
                var cn = ir_arena_name(ir_region_slot_r(f.region, (ii)))
                var bid = if cn.len > 0 { native_v2_builtin_id_for_name(cn) } else { 0 }
                // #2244: str_slice is arity-polymorphic at the source level --
                // (s, start) is the suffix pointer, (s, start, end) is a copy of
                // the half-open range. lean_single dispatches on arity while it
                // parses; a native builtin is one stub with no view of its call
                // site, so both spellings lowered to the suffix form and end was
                // discarded at 102 call sites. Retag the 3-arg sites onto their
                // own builtin name here, where the arity is still on the
                // instruction, so each spelling gets its own stub. Making the one
                // stub 3-arg instead would turn the specified 2-arg form into a
                // range copy over an uninitialised end -- corruption, not a wrong
                // string. Idempotent: a retagged call reads back as bid 51.
                if bid == 8 {
                    let slice_argc = IR_A_ARG_COUNT[(ir_region_slot_r(f.region, (ii))) as usize]
                    // `== 3`, not `>= 3`. The retag decides an overload
                    // IDENTITY, so it must name the arity it means. With `>=`
                    // a 4-argument call is relabelled str_slice.3 and its
                    // fourth argument disappears -- and that call is
                    // reachable: `souc check` accepts str_slice(s,2,5,7)
                    // today (measured 2026-08-28), so the checker does not
                    // stand between source and this line. A 4-argument call
                    // now keeps the 2-argument spelling, which is still
                    // wrong for the caller but is wrong VISIBLY, rather than
                    // being silently accepted as something it is not.
                    if slice_argc == 3 {
                        cn = make_name("str_slice.3")
                        ir_arena_put_name(ir_region_slot_w(f.region, (ii)), cn)
                        bid = native_v2_builtin_id_for_name(cn)
                        changed = true
                    }
                }
                if cn.len > 0 && bid != 0 {
                    let cur = IR_A_FN_ID[(ir_region_slot_r(f.region, (ii))) as usize]
                    var ok: bool = false
                    if cur >= 0 && cur < (*module).fn_count {
                        if ir_name_eq(ir_fn_get(&(*module), cur as usize).name, cn) { ok = true }
                    }
                    var target = cur
                    if !ok {
                        target = ir_merge_find_function_name_index(module, cn)
                        if target < 0 && (*module).fn_count < IR_MAX_FUNCS {
                            var stub = ir_empty_function()
                            stub.name = cn
                            if native_v2_builtin_returns_float(bid) {
                                stub.returns_float = 1
                            }
                            ir_fn_set(&! (*module), (*module).fn_count as usize, stub)
                            target = (*module).fn_count
                            (*module).fn_count = (*module).fn_count + 1
                        }
                        if target >= 0 {
                            IR_A_FN_ID[(ir_region_slot_w(f.region, (ii))) as usize] = target
                            changed = true
                        }
                    }
                    // Advertise f64 return on empty float-intrinsic stubs (new or pre-existing)
                    // and stamp the call site so native core does not mark the result INT.
                    if target >= 0 && target < (*module).fn_count && native_v2_builtin_returns_float(bid) {
                        let stub_ic = ir_fn_get(&(*module), target as usize).instr_count
                        if stub_ic == 0 {
                            if ir_fn_get(&(*module), target as usize).returns_float != 1 {
                                var tf = ir_fn_get(&(*module), target as usize)
                                tf.returns_float = 1
                                ir_fn_set(&! (*module), target as usize, tf)
                            }
                            if IR_A_IMM_FLAGS[(ir_region_slot_r(f.region, (ii))) as usize] != IR_FLOAT_REG_MARKER_FLAG {
                                IR_A_IMM_FLAGS[(ir_region_slot_w(f.region, (ii))) as usize] = IR_FLOAT_REG_MARKER_FLAG
                                changed = true
                            }
                        } else {
                            // User/stdlib body shares the name: still honour declared returns_float.
                            if ir_fn_get(&(*module), target as usize).returns_float == 1 {
                                if IR_A_IMM_FLAGS[(ir_region_slot_r(f.region, (ii))) as usize] != IR_FLOAT_REG_MARKER_FLAG {
                                    IR_A_IMM_FLAGS[(ir_region_slot_w(f.region, (ii))) as usize] = IR_FLOAT_REG_MARKER_FLAG
                                    changed = true
                                }
                            }
                        }
                    }
                }
            }
            ii = ii + 1
        }
        if changed {
            ir_fn_set(&! (*module), fi as usize, f)
        }
        fi = fi + 1
    }
}

// Finalize merged multi-mod call targets in place. Memory wall P0: take &! IrModule
// only — never copy full IrModule through promote/compact/ensure/resolve chain.
// A14 invariant preserved: rebinds use whole-function writeback (not IrInstr by-value).
fn ir_module_finalize_merged_calls(module: &! IrModule) with Mut, Div, Panic {
    ir_module_resolve_named_calls(module)
    // Promote before compaction so import stubs at low fn_id gain bodies while
    // seed main still references those indices.
    ir_module_promote_canonical_into_stub_slots(module)
    ir_module_compact_duplicate_fn_refs(module)
    ir_module_promote_canonical_into_stub_slots(module)
    // Two passes after promotion: duplicate import stubs (ic=0) can alias lowered
    // bodies under the same name at higher fn_id; promotion fills stub slots first.
    var pass: i64 = 0
    while pass < 2 {
        var fi: i64 = 0
        while fi < (*module).fn_count {
            // A14: whole-function copy/writeback (see ir_module_compact_duplicate_fn_refs)
            // — nested `IR_A_FN_ID[(ir_region_slot_w(ir_fn_get(&(*module), fi).region, (ii))) as usize]=v` writes are dropped.
            var f = ir_fn_get(&(*module), fi as usize)
            var changed: bool = false
            var ii: i64 = 0
            while ii < f.instr_count {
                let op = (IR_A_OP[(ir_region_slot_r(f.region, (ii))) as usize] as IrOpcode)
                if op == IrOpcode::IrCall || op == IrOpcode::IrCallSret || op == IrOpcode::IrLoadFnRef {
                    let cur_fn = IR_A_FN_ID[(ir_region_slot_r(f.region, (ii))) as usize]
                    let cur_nm = ir_arena_name(ir_region_slot_r(f.region, (ii)))
                    let new_id = ir_module_resolve_call_target_fields(module, cur_fn, cur_nm)
                    if new_id != cur_fn {
                        IR_A_FN_ID[(ir_region_slot_w(f.region, (ii))) as usize] = new_id
                        changed = true
                    }
                }
                ii = ii + 1
            }
            if changed {
                ir_fn_set(&! (*module), fi as usize, f)
            }
            fi = fi + 1
        }
        pass = pass + 1
    }
    ir_module_ensure_builtin_call_targets(module)
}

// Reinstall seed user main after finalize: finalize passes can clobber
// fn=0 under the lean_single JIT. Stub slots are already promoted; keep seed fn_ids.
// In-place on &! IrModule (memory wall P0).
fn ir_module_restore_user_main_calls(module: &! IrModule, user_main: IrFunction) with Mut, Div, Panic {
    if (*module).fn_count <= 0 {
        return
    }
    var slot = ir_fn_get(&(*module), 0 as usize)
    slot.name = user_main.name
    slot.instr_count = user_main.instr_count
    slot.reg_count = user_main.reg_count
    slot.label_count = user_main.label_count
    slot.param_count = user_main.param_count
    slot.compile_strategy = user_main.compile_strategy
    slot.returns_float = user_main.returns_float
    slot.return_struct_name = user_main.return_struct_name
    slot.prof_counter_id = user_main.prof_counter_id
    slot.hyper_algebra_kind = user_main.hyper_algebra_kind
    slot.is_sret = user_main.is_sret
    slot.sret_dest_reg = user_main.sret_dest_reg
    slot.bss_size = user_main.bss_size
    var pi: i64 = 0
    while pi < user_main.param_count && pi < IR_MAX_PARAMS {
        slot.param_regs[pi as usize] = user_main.param_regs[pi as usize]
        pi = pi + 1
    }
    // #1669: this rebuilds an IrFunction FIELD BY FIELD, so it is a drop hazard
    // for every field that is not listed. float_reg_bits has to travel with
    // param_regs -- both are per-function vreg facts, and losing either silently
    // retypes registers. Wherever one is copied element-wise, so is the other.
    var fw: i64 = 0
    while fw < 64 {
        slot.float_reg_bits[fw as usize] = user_main.float_reg_bits[fw as usize]
        fw = fw + 1
    }
    var ii: i64 = 0
    while ii < user_main.instr_count && ii < IR_MAX_INSTRS {
        var ins = ir_arena_load(ir_region_slot_r(user_main.region, (ii)))
        if (ins.op == IrOpcode::IrCall || ins.op == IrOpcode::IrCallSret) && ins.fn_id >= 0 && ins.fn_id < (*module).fn_count {
            if ir_fn_get(&(*module), ins.fn_id as usize).returns_float == 1 {
                ins.imm_flags = IR_FLOAT_REG_MARKER_FLAG
            }
        }
        ir_arena_store_from(ir_region_slot_w(slot.region, (ii)), ins, ir_region_slot_r(user_main.region, (ii)))
        ii = ii + 1
    }
    ir_fn_set(&! (*module), 0 as usize, slot)
}

// Resolve fn_id=-1 named calls (cross-module calls emitted by module_frontend_ir_named_call)
// to their position in the merged module. Operates through &! to avoid large-local JIT writes.
fn ir_module_resolve_named_calls(module: &! IrModule) with Mut, Div, Panic {
    var fi: i64 = 0
    while fi < (*module).fn_count {
        var ii: i64 = 0
        while ii < ir_fn_get(&(*module), fi as usize).instr_count {
            let call_op = (IR_A_OP[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (ii))) as usize] as IrOpcode)
            if (call_op == IrOpcode::IrCall || call_op == IrOpcode::IrCallSret)
                && IR_A_FN_ID[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (ii))) as usize] < 0 {
                let call_name = ir_arena_name(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (ii)))
                if call_name.len > 0 {
                    let found_ji = ir_merge_find_function_name_index(module, call_name)
                    if found_ji >= 0 {
                        IR_A_FN_ID[(ir_region_slot_w(ir_fn_get(&(*module), fi as usize).region, (ii))) as usize] = found_ji
                    }
                }
            }
            ii = ii + 1
        }
        fi = fi + 1
    }
}

fn ir_epistemic_section_is_empty(epistemic: IrEpistemicSection) -> bool {
    epistemic.model_family_count == 0 &&
    epistemic.policy_count == 0 &&
    epistemic.decision_policy_count == 0 &&
    epistemic.deferral_policy_count == 0 &&
    epistemic.acquisition_policy_count == 0 &&
    epistemic.recourse_policy_count == 0 &&
    epistemic.validation_count == 0 &&
    epistemic.mechanistic_report_count == 0 &&
    epistemic.posterior_weights_count == 0 &&
    epistemic.counterexample_count == 0 &&
    epistemic.audit_count == 0 &&
    epistemic.contest_count == 0 &&
    epistemic.contest_witness_count == 0 &&
    epistemic.robust_proof_count == 0 &&
    epistemic.decision_certificate_count == 0 &&
    epistemic.deferred_certificate_count == 0 &&
    epistemic.deferred_reason_witness_count == 0 &&
    epistemic.acquisition_plan_count == 0 &&
    epistemic.acquisition_reason_witness_count == 0 &&
    epistemic.recourse_plan_count == 0 &&
    epistemic.recourse_reason_witness_count == 0 &&
    epistemic.alternative_policy_count == 0 &&
    epistemic.alternative_frontier_count == 0 &&
    epistemic.alternative_candidate_count == 0 &&
    epistemic.alternative_set_count == 0 &&
    epistemic.alternative_reason_witness_count == 0 &&
    epistemic.transition_policy_count == 0 &&
    epistemic.transition_protocol_count == 0 &&
    epistemic.transition_step_count == 0 &&
    epistemic.transition_plan_count == 0 &&
    epistemic.transition_reason_witness_count == 0 &&
    epistemic.monitoring_policy_count == 0 &&
    epistemic.observed_transition_count == 0 &&
    epistemic.rollback_certificate_count == 0 &&
    epistemic.validated_manifest_count == 0
}

// ============================================================
// Visited-set helpers for transitive import resolution
// ============================================================

fn visited_contains(visited: [string; 256], count: i64, path: string) -> bool with Mut, Panic, Div {
    var j: i64 = 0
    while j < count {
        if str_eq(visited[j], path) {
            return true
        }
        j = j + 1
    }
    false
}

// Caller-owned AST closure shared by visibility checking and boundary reports.
// Missing imports and capacity saturation are data, never implicit success.
pub struct ModuleClosure {
    pub paths: [string; 256],
    pub edge_callers: [string; 512],
    pub edge_dependencies: [string; 512],
    pub unresolved_callers: [string; 256],
    pub unresolved_imports: [string; 256],
    pub node_count: i64,
    pub edge_count: i64,
    pub unresolved_count: i64,
    pub saturated: bool,
    pub parse_failed: bool,
    // Path of the module whose parse failed. Empty when parse_failed is false.
    //
    // Without this a caller can report THAT the closure is incomplete but not
    // WHY or WHERE: a dependency parse failure short-circuits the walk, leaving
    // unresolved_count at 0 and saturated at false, so every field the diagnostic
    // prints looks healthy while the one that explains the failure is absent.
    pub parse_failed_path: string,
}

pub fn module_frontend_collect_ast_closure_into(
    main_path: string,
    out: &!ModuleClosure
) -> bool with IO, Mut, Panic, Div, Alloc {
    (*out).node_count = 0
    (*out).edge_count = 0
    (*out).unresolved_count = 0
    (*out).saturated = false
    (*out).parse_failed = false
    (*out).parse_failed_path = ""

    parser_reset_last_errors()
    let main_prog = load_module_file(main_path)
    if parser_last_error_count() > 0 {
        (*out).parse_failed = true
        (*out).parse_failed_path = main_path
        return false
    }
    (*out).paths[0] = main_path
    (*out).node_count = 1

    var work_front: i64 = 0
    while work_front < (*out).node_count {
        let caller_path = (*out).paths[work_front]
        let cur_dir = module_frontend_path_directory_slice(caller_path)
        parser_reset_last_errors()
        let work_prog = load_module_file(caller_path)
        if parser_last_error_count() > 0 {
            (*out).parse_failed = true
            (*out).parse_failed_path = caller_path
            work_front = (*out).node_count
        }
        let imports = extract_imports_from_ast(work_prog)
        if imports.overflowed {
            // More `use` statements than ImportList can hold. Reported through the same channel as
            // the walker's own caps so the closure is never silently incomplete.
            (*out).saturated = true
        }
        var i: i64 = 0
        while i < imports.count && !(*out).parse_failed {
            let dependency_path = resolve_import_file_path(imports.paths[i], cur_dir)
            if (*out).edge_count < 512 {
                let edge_index = (*out).edge_count
                (*out).edge_callers[edge_index] = caller_path
                (*out).edge_dependencies[edge_index] = dependency_path
                (*out).edge_count = edge_index + 1
            } else {
                (*out).saturated = true
            }

            if !file_exists(dependency_path) {
                if (*out).unresolved_count < 256 {
                    let unresolved_index = (*out).unresolved_count
                    (*out).unresolved_callers[unresolved_index] = caller_path
                    (*out).unresolved_imports[unresolved_index] = use_path_to_string(imports.paths[i])
                    (*out).unresolved_count = unresolved_index + 1
                } else {
                    (*out).saturated = true
                }
            } else if !visited_contains((*out).paths, (*out).node_count, dependency_path) {
                if (*out).node_count >= 256 {
                    (*out).saturated = true
                } else {
                    let node_index = (*out).node_count
                    (*out).paths[node_index] = dependency_path
                    (*out).node_count = node_index + 1
                }
            }
            i = i + 1
        }
        work_front = work_front + 1
    }
    !(*out).saturated && !(*out).parse_failed && (*out).unresolved_count == 0
}

pub struct ImportPathList {
    paths: [string; 256],
    count: i64,
}

fn import_path_list_empty() -> ImportPathList {
    ImportPathList {
        paths: [""; 256],
        count: 0,
    }
}

fn import_path_list_contains(imports: ImportPathList, path: string) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < imports.count {
        if str_eq(imports.paths[i], path) {
            return true
        }
        i = i + 1
    }
    false
}

fn module_frontend_import_is_use_at(data: string, pos: i64, size: i64) -> bool {
    if pos + 3 >= size {
        return false
    }
    if pos > 0 && data[(pos - 1) as usize] != (10 as i8) {
        return false
    }
    data[pos as usize] == (117 as i8) &&
    data[(pos + 1) as usize] == (115 as i8) &&
    data[(pos + 2) as usize] == (101 as i8) &&
    data[(pos + 3) as usize] == (32 as i8)
}

fn module_frontend_import_path_from_source(
    data: string,
    start: i64,
    size: i64,
    prefix: string
) -> string with Mut, Panic, Div {
    var buf: [i8; 512] = [0; 512]
    var pos: i64 = 0
    let prefix_len = str_len(prefix)
    var pi: i64 = 0
    while pi < prefix_len && pos < 490 {
        buf[pos as usize] = str_char_at(prefix, pi) as i8
        pos = pos + 1
        pi = pi + 1
    }
    if pos < 490 {
        buf[pos as usize] = 47 as i8
        pos = pos + 1
    }

    var i = start
    while i < size && data[i as usize] == (32 as i8) {
        i = i + 1
    }
    while i < size && pos < 500 {
        let ch = data[i as usize]
        if ch == (10 as i8) || ch == (13 as i8) || ch == (32 as i8) ||
           ch == (9 as i8) || ch == (59 as i8) || ch == (123 as i8) ||
           ch == (44 as i8) {
            break
        }
        if ch == (58 as i8) && i + 1 < size && data[(i + 1) as usize] == (58 as i8) {
            if i + 2 < size {
                let next = data[(i + 2) as usize]
                if next == (123 as i8) || next == (42 as i8) {
                    break
                }
            }
            buf[pos as usize] = 47 as i8
            pos = pos + 1
            i = i + 2
        } else {
            buf[pos as usize] = ch
            pos = pos + 1
            i = i + 1
        }
    }
    if pos < 508 {
        buf[pos as usize] = 46 as i8
        buf[(pos + 1) as usize] = 115 as i8
        buf[(pos + 2) as usize] = 105 as i8
        buf[(pos + 3) as usize] = 111 as i8
        pos = pos + 4
    }
    str_from_bytes(buf, pos)
}

pub fn module_frontend_import_files_from_source(path: string) -> ImportPathList with IO, Mut, Panic, Div {
    var imports = import_path_list_empty()
    let n = module_frontend_load_import_file(path)
    if n <= 0 {
        return imports
    }
    let cur_dir = module_frontend_path_directory_slice(path)
    var line_start: i64 = 0
    var i: i64 = 0
    while i <= n && imports.count < 256 {
        let at_end = i == n
        let ch = if at_end { 10 as i8 } else { MODULE_FRONTEND_IMPORT_FILE_DATA[i as usize] }
        if ch == (10 as i8) {
            let line_end = i
            var path_start: i64 = 0 - 1
            if line_end - line_start >= 4 &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[line_start as usize] == (117 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 1) as usize] == (115 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 2) as usize] == (101 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 3) as usize] == (32 as i8) {
                path_start = line_start + 4
            }
            if path_start < 0 &&
               line_end - line_start >= 8 &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[line_start as usize] == (112 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 1) as usize] == (117 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 2) as usize] == (98 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 3) as usize] == (32 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 4) as usize] == (117 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 5) as usize] == (115 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 6) as usize] == (101 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 7) as usize] == (32 as i8) {
                path_start = line_start + 8
            }
            if path_start < 0 &&
               line_end - line_start >= 7 &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[line_start as usize] == (105 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 1) as usize] == (109 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 2) as usize] == (112 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 3) as usize] == (111 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 4) as usize] == (114 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 5) as usize] == (116 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 6) as usize] == (32 as i8) {
                path_start = line_start + 7
            }

            if path_start >= 0 {
                let rel_path = module_frontend_extract_relpath_from_loaded(path_start, line_end)
                if str_len(rel_path) > 0 {
                    var dep_path = module_frontend_resolve_import_relpath(rel_path, cur_dir)
                    // Named-import fallback: bare `use pkg::mod::sym` embeds the
                    // symbol as a path segment; strip it when the full relpath
                    // does not exist on disk (same rule as resolve_import_file_path).
                    if !file_exists(dep_path) {
                        let parent_rel = module_frontend_relpath_strip_last_segment(rel_path)
                        if str_len(parent_rel) > 0 {
                            let parent_dep = module_frontend_resolve_import_relpath(parent_rel, cur_dir)
                            if file_exists(parent_dep) {
                                dep_path = parent_dep
                            }
                        }
                    }
                    if file_exists(dep_path) && !import_path_list_contains(imports, dep_path) {
                        imports.paths[imports.count] = dep_path
                        imports.count = imports.count + 1
                    }
                }
            }
            line_start = i + 1
        }
        i = i + 1
    }
    imports
}

fn module_frontend_source_is_fn_at(data: string, pos: i64, size: i64) -> bool {
    if pos + 2 >= size {
        return false
    }
    if pos > 0 && data[(pos - 1) as usize] != (10 as i8) {
        return false
    }
    if data[pos as usize] == (102 as i8) &&
       data[(pos + 1) as usize] == (110 as i8) &&
       data[(pos + 2) as usize] == (32 as i8) {
        return true
    }
    if pos + 6 >= size {
        return false
    }
    data[pos as usize] == (112 as i8) &&
    data[(pos + 1) as usize] == (117 as i8) &&
    data[(pos + 2) as usize] == (98 as i8) &&
    data[(pos + 3) as usize] == (32 as i8) &&
    data[(pos + 4) as usize] == (102 as i8) &&
    data[(pos + 5) as usize] == (110 as i8) &&
    data[(pos + 6) as usize] == (32 as i8)
}

fn module_frontend_source_fn_name_start(data: string, fn_pos: i64, size: i64) -> i64 {
    if fn_pos + 6 < size &&
       data[fn_pos as usize] == (112 as i8) &&
       data[(fn_pos + 1) as usize] == (117 as i8) &&
       data[(fn_pos + 2) as usize] == (98 as i8) &&
       data[(fn_pos + 3) as usize] == (32 as i8) &&
       data[(fn_pos + 4) as usize] == (102 as i8) &&
       data[(fn_pos + 5) as usize] == (110 as i8) &&
       data[(fn_pos + 6) as usize] == (32 as i8) {
        return fn_pos + 7
    }
    fn_pos + 3
}

fn module_frontend_source_fn_name(data: string, start: i64, size: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 384], len: 0 }
    var i = start
    while i < size && data[i as usize] == (32 as i8) {
        i = i + 1
    }
    while i < size && n.len < 128 {
        let ch = data[i as usize]
        if ch == (40 as i8) || ch == (32 as i8) || ch == (9 as i8) ||
           ch == (10 as i8) || ch == (13 as i8) {
            break
        }
        n.buf[n.len] = ch
        n.len = n.len + 1
        i = i + 1
    }
    n
}

fn module_frontend_source_skip_ws(data: string, start: i64, size: i64) -> i64 {
    var i = start
    while i < size {
        let ch = data[i as usize]
        if ch == (32 as i8) || ch == (9 as i8) || ch == (10 as i8) || ch == (13 as i8) {
            i = i + 1
        } else {
            return i
        }
    }
    i
}

// Skip optional "let name = " or "var name: T = " or "let name : T = " prefix to reach the rhs expression start.
// Used by the summary/simple body lower to recognize "let p = cd_mul(...)" style calls in test mains for imported modules.
fn module_frontend_source_skip_let_or_var_assign(data: string, start: i64, size: i64) -> i64 {
    var i = module_frontend_source_skip_ws(data, start, size)
    // check for let or var
    let is_let = (i + 3 < size) &&
        data[i as usize] == (108 as i8) && data[i+1 as usize] == (101 as i8) && data[i+2 as usize] == (116 as i8) && data[i+3 as usize] == (32 as i8)
    let is_var = (i + 3 < size) &&
        data[i as usize] == (118 as i8) && data[i+1 as usize] == (97 as i8) && data[i+2 as usize] == (114 as i8) && data[i+3 as usize] == (32 as i8)
    if !is_let && !is_var {
        return i
    }
    i = i + 4
    i = module_frontend_source_skip_ws(data, i, size)
    // skip the lhs name (ident chars)
    while i < size {
        let ch = data[i as usize]
        let is_ident = (ch >= (97 as i8) && ch <= (122 as i8)) || (ch >= (65 as i8) && ch <= (90 as i8)) || (ch >= (48 as i8) && ch <= (57 as i8)) || ch == (95 as i8)
        if !is_ident { break }
        i = i + 1
    }
    i = module_frontend_source_skip_ws(data, i, size)
    // optional : type
    if i < size && data[i as usize] == (58 as i8) {
        i = i + 1
        i = module_frontend_source_skip_ws(data, i, size)
        // skip type ident (and generics etc crudely until space or = or ( )
        while i < size {
            let ch = data[i as usize]
            if ch == (32 as i8) || ch == (9 as i8) || ch == (61 as i8) || ch == (40 as i8) { break }
            i = i + 1
        }
        i = module_frontend_source_skip_ws(data, i, size)
    }
    // expect =
    if i < size && data[i as usize] == (61 as i8) {
        i = i + 1
    }
    module_frontend_source_skip_ws(data, i, size)
}

fn module_frontend_source_body_start(data: string, start: i64, size: i64) -> i64 {
    var i = start
    while i < size {
        if data[i as usize] == (123 as i8) {
            return i + 1
        }
        i = i + 1
    }
    -1
}

fn module_frontend_source_body_end(data: string, start: i64, size: i64) -> i64 {
    var i = start
    var depth: i64 = 0
    while i < size {
        let ch = data[i as usize]
        if ch == (123 as i8) {
            depth = depth + 1
        } else if ch == (125 as i8) {
            if depth == 0 {
                return i
            }
            depth = depth - 1
        }
        i = i + 1
    }
    size
}

fn module_frontend_source_ident_at(data: string, start: i64, size: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 384], len: 0 }
    var i = start
    while i < size && n.len < 128 {
        let ch = data[i as usize]
        let is_lower = ch >= (97 as i8) && ch <= (122 as i8)
        let is_upper = ch >= (65 as i8) && ch <= (90 as i8)
        let is_digit = ch >= (48 as i8) && ch <= (57 as i8)
        if is_lower || is_upper || is_digit || ch == (95 as i8) {
            n.buf[n.len] = ch
            n.len = n.len + 1
            i = i + 1
        } else {
            return n
        }
    }
    n
}

fn module_frontend_source_int_at(data: string, start: i64, size: i64) -> (bool, i64) {
    var i = start
    var value: i64 = 0
    var seen = false
    while i < size {
        let ch = data[i as usize]
        if ch >= (48 as i8) && ch <= (57 as i8) {
            seen = true
            value = (value * 10) + ((ch as i64) - 48)
            i = i + 1
        } else {
            return (seen, value)
        }
    }
    (seen, value)
}

fn module_frontend_source_line_end(data: string, start: i64, end: i64) -> i64 {
    var i = start
    while i < end {
        let ch = data[i as usize]
        if ch == (59 as i8) || ch == (10 as i8) || ch == (13 as i8) {
            return i
        }
        i = i + 1
    }
    end
}

fn module_frontend_source_after_line(data: string, start: i64, end: i64) -> i64 {
    var i = start
    while i < end {
        let ch = data[i as usize]
        if ch == (59 as i8) || ch == (10 as i8) || ch == (13 as i8) {
            i = i + 1
        } else if ch == (32 as i8) || ch == (9 as i8) {
            i = i + 1
        } else {
            return i
        }
    }
    i
}

fn module_frontend_source_find_fn(data: string, size: i64, target: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i + 2 < size {
        if module_frontend_source_is_fn_at(data, i, size) {
            let name = module_frontend_source_fn_name(data, module_frontend_source_fn_name_start(data, i, size), size)
            if ir_name_eq(name, target) {
                return i
            }
        }
        i = i + 1
    }
    0 - 1
}

fn module_frontend_name_is_println(name: Name) -> bool {
    name.len == 7 &&
    name.buf[0] == (112 as i8) &&
    name.buf[1] == (114 as i8) &&
    name.buf[2] == (105 as i8) &&
    name.buf[3] == (110 as i8) &&
    name.buf[4] == (116 as i8) &&
    name.buf[5] == (108 as i8) &&
    name.buf[6] == (110 as i8)
}

fn module_frontend_name_is_print_int(name: Name) -> bool {
    name.len == 9 &&
    name.buf[0] == (112 as i8) &&
    name.buf[1] == (114 as i8) &&
    name.buf[2] == (105 as i8) &&
    name.buf[3] == (110 as i8) &&
    name.buf[4] == (116 as i8) &&
    name.buf[5] == (95 as i8) &&
    name.buf[6] == (105 as i8) &&
    name.buf[7] == (110 as i8) &&
    name.buf[8] == (116 as i8)
}

fn module_frontend_ir_named_call(dst: i64, fn_name: Name) -> IrInstr with Div, Mut, Panic {
    var instr = ir_call(dst, 0 - 1, fn_name, None, 0)
    instr.fn_id = 0 - 1
    instr.name_id = ir_intern_name(fn_name)
    instr
}

fn module_frontend_name_is_main(name: Name) -> bool {
    name.len == 4 &&
    name.buf[0] == (109 as i8) &&
    name.buf[1] == (97 as i8) &&
    name.buf[2] == (105 as i8) &&
    name.buf[3] == (110 as i8)
}

fn module_frontend_name_eq_str(name: Name, text: string) -> bool with Mut, Panic, Div {
    let text_len = str_len(text)
    if name.len != text_len {
        return false
    }
    var i: i64 = 0
    while i < text_len {
        if name.buf[i as usize] != (str_char_at(text, i) as i8) {
            return false
        }
        i = i + 1
    }
    true
}

fn module_frontend_name_from_string(text: string) -> Name with Mut, Panic, Div {
    var name = Name { buf: [0; 384], len: 0 }
    let text_len = str_len(text)
    var i: i64 = 0
    while i < text_len && name.len < 128 {
        name.buf[name.len] = str_char_at(text, i) as i8
        name.len = name.len + 1
        i = i + 1
    }
    name
}

fn module_frontend_force_i64_return(func_in: IrFunction, value: i64) -> IrFunction with Mut, Panic, Div {
    var func = ir_function_clone(&func_in)
    func.reg_count = 1
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, value))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_return(0))
    func.instr_count = 2
    func
}

fn module_frontend_source_strip_return_prefix(data: string, start: i64, end: i64) -> i64 {
    var expr = module_frontend_source_skip_ws(data, start, end)
    if expr + 6 < end &&
       data[expr as usize] == (114 as i8) &&
       data[(expr + 1) as usize] == (101 as i8) &&
       data[(expr + 2) as usize] == (116 as i8) &&
       data[(expr + 3) as usize] == (117 as i8) &&
       data[(expr + 4) as usize] == (114 as i8) &&
       data[(expr + 5) as usize] == (110 as i8) &&
       data[(expr + 6) as usize] == (32 as i8) {
        return module_frontend_source_skip_ws(data, expr + 7, end)
    }
    expr
}

fn module_frontend_source_is_let_at(data: string, pos: i64, end: i64) -> bool {
    if pos + 3 >= end {
        return false
    }
    data[pos as usize] == (108 as i8) &&
    data[(pos + 1) as usize] == (101 as i8) &&
    data[(pos + 2) as usize] == (116 as i8) &&
    data[(pos + 3) as usize] == (32 as i8)
}

fn module_frontend_source_is_return_at(data: string, pos: i64, end: i64) -> bool {
    if pos + 6 >= end {
        return false
    }
    data[pos as usize] == (114 as i8) &&
    data[(pos + 1) as usize] == (101 as i8) &&
    data[(pos + 2) as usize] == (116 as i8) &&
    data[(pos + 3) as usize] == (117 as i8) &&
    data[(pos + 4) as usize] == (114 as i8) &&
    data[(pos + 5) as usize] == (110 as i8) &&
    data[(pos + 6) as usize] == (32 as i8)
}

fn module_frontend_source_is_if_at(data: string, pos: i64, end: i64) -> bool {
    if pos + 2 >= end {
        return false
    }
    data[pos as usize] == (105 as i8) &&
    data[(pos + 1) as usize] == (102 as i8) &&
    data[(pos + 2) as usize] == (32 as i8)
}

fn module_frontend_source_is_var_at(data: string, pos: i64, end: i64) -> bool {
    if pos + 3 >= end {
        return false
    }
    data[pos as usize] == (118 as i8) &&
    data[(pos + 1) as usize] == (97 as i8) &&
    data[(pos + 2) as usize] == (114 as i8) &&
    data[(pos + 3) as usize] == (32 as i8)
}

fn module_frontend_source_is_while_at(data: string, pos: i64, end: i64) -> bool {
    if pos + 5 >= end {
        return false
    }
    data[pos as usize] == (119 as i8) &&
    data[(pos + 1) as usize] == (104 as i8) &&
    data[(pos + 2) as usize] == (105 as i8) &&
    data[(pos + 3) as usize] == (108 as i8) &&
    data[(pos + 4) as usize] == (101 as i8) &&
    data[(pos + 5) as usize] == (32 as i8)
}

fn module_frontend_source_is_else_at(data: string, pos: i64, end: i64) -> bool {
    if pos + 4 >= end {
        return false
    }
    data[pos as usize] == (101 as i8) &&
    data[(pos + 1) as usize] == (108 as i8) &&
    data[(pos + 2) as usize] == (115 as i8) &&
    data[(pos + 3) as usize] == (101 as i8) &&
    (data[(pos + 4) as usize] == (32 as i8) || data[(pos + 4) as usize] == (123 as i8))
}

fn module_frontend_source_brace_close(data: string, open: i64, end: i64) -> i64 {
    var depth = 1
    var k = open + 1
    while k < end && depth > 0 {
        let bc = data[k as usize]
        if bc == (123 as i8) { depth = depth + 1 }
        else if bc == (125 as i8) { depth = depth - 1 }
        k = k + 1
    }
    if depth != 0 { return -1 }
    k - 1
}

