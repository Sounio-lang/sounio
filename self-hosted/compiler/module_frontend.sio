// self-hosted::compiler::module_frontend
//
// Multimodule frontend and IR-loading lane split from module_loader.sio.
// Keeps frontend probes off the native/wasm/optimizer/thin-link backend surface.

use parser::ast::{AstPath, empty_path, Item, ItemKind, ItemList, Name, ParamList, Program, StringList}
use parser::mod::{count_items}
use parser::parser::{parser_last_error_count, parser_reset_last_errors}
use ir::ir::*
use io::env::{read_env}
use check::mod::{check_items_verdict_boot4, check_items_verdict_boot4_with_ontocache_sidecar, check_program_epistemic_into}
use check::mod::{checker_boot4_alloc_seed_main, checker_boot4_seed_imported, checker_boot4_finish_check_main}
use check::knowledge_context::{knowledge_context_validate_items, knowledge_context_validate_items_values_only}
use resolve::mod::{resolve_modules}
use module_parse::{extract_imports_from_ast, file_exists, load_module_file}

fn module_frontend_lower_trace_enabled() -> bool with IO, Mut, Panic, Div {
    str_eq(read_env("SOUNIO_MODULE_FRONTEND_LOWER_TRACE"), "1")
}

fn module_frontend_stdlib_root() -> string with IO, Mut, Panic, Div {
    let configured = read_env("SOUNIO_STDLIB_PATH")
    if str_len(configured) > 0 {
        return configured
    }
    "stdlib"
}

var MODULE_FRONTEND_IMPORT_FILE_DATA: [i8; 1048576] = [0; 1048576]
// #3 IMPORTED-FN LINK: combined-source buffer for multi-module native compile.
// Imported module texts (use-lines stripped) are concatenated here ahead of the
// entry module, then written to a temp file and fed to the proven single-module
// real-AST lowerer (bridge_lower_single_module_box) so find_or_add_fn_id links
// cross-module calls in one pass. Dup top-level fn names across the merge are
// detected and REJECTED (R1: never silently miscompile a name collision).
var MODULE_FRONTEND_COMBINE_BUF: [i8; 1048576] = [0; 1048576]
var MODULE_FRONTEND_COMBINE_LEN: i64 = 0
var MODULE_FRONTEND_COMBINE_VISITED: [string; 256] = [""; 256]
var MODULE_FRONTEND_COMBINE_VISITED_COUNT: i64 = 0
var MODULE_FRONTEND_COMBINE_FNNAMES: [i64; 1024] = [0; 1024]
var MODULE_FRONTEND_COMBINE_FNNAME_COUNT: i64 = 0
var MODULE_FRONTEND_COMBINE_OVERFLOW: bool = false
var MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT: i64 = 0
var MODULE_FRONTEND_IMPORTED_SIMPLE_FN_NAME_HASHES: [i64; 64] = [0; 64]
var MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS: [i64; 64] = [0; 64]
var MODULE_FRONTEND_IMPORTED_SIMPLE_FN_TARGET_HASHES: [i64; 64] = [0; 64]
var MODULE_FRONTEND_IMPORTED_SIMPLE_FN_VALUES: [i64; 64] = [0; 64]

fn module_frontend_import_is_ident_ch(c: i8) -> bool {
    (c >= 65 as i8 && c <= 90 as i8) ||
    (c >= 97 as i8 && c <= 122 as i8) ||
    (c >= 48 as i8 && c <= 57 as i8) ||
    c == 95 as i8
}

fn module_frontend_import_byte_to_str(c: i8) -> string {
    let v = c as i64
    if v >= 97 && v <= 122 {
        return str_slice("abcdefghijklmnopqrstuvwxyz", v - 97, v - 96)
    }
    if v >= 65 && v <= 90 {
        return str_slice("ABCDEFGHIJKLMNOPQRSTUVWXYZ", v - 65, v - 64)
    }
    if v >= 48 && v <= 57 {
        return str_slice("0123456789", v - 48, v - 47)
    }
    if v == 95 { return "_" }
    if v == 47 { return "/" }
    if v == 46 { return "." }
    if v == 45 { return "-" }
    ""
}

// Content cache for read_file (Residual 1). The full-IR front-half re-reads each source
// file many times — once per function via the eval heuristics — and the no-free bump
// allocator never reclaims those buffers (~1.6 MB/fn × 6681 fns ≈ 10.6 GB peak). This caches
// by path so a file is read from disk at most once; repeat reads return the already-allocated
// content (the buffer persists under no-free anyway). ~81 distinct files; cap 512.
// Parallel string arrays (NOT a struct-of-strings array — storing a string FIELD of a
// struct array element corrupts the fat-pointer, the c634b38f string/struct-field class).
// String arrays + direct element stores are the proven pattern (cf. visited_paths).
var READ_FILE_CACHE_PATH: [string; 512] = [""; 512]
var READ_FILE_CACHE_CONTENT: [string; 512] = [""; 512]
var READ_FILE_CACHE_COUNT: i64 = 0

fn module_frontend_cached_read_file(path: string) -> string with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < READ_FILE_CACHE_COUNT {
        if str_eq(READ_FILE_CACHE_PATH[i as usize], path) {
            return READ_FILE_CACHE_CONTENT[i as usize]
        }
        i = i + 1
    }
    let content = read_file(path)
    if READ_FILE_CACHE_COUNT < 512 {
        let idx = READ_FILE_CACHE_COUNT
        READ_FILE_CACHE_PATH[idx as usize] = path
        READ_FILE_CACHE_CONTENT[idx as usize] = content
        READ_FILE_CACHE_COUNT = idx + 1
    }
    content
}

fn module_frontend_load_import_file(path: string) -> i64 with IO, Mut, Panic, Div {
    let size = file_size(path)
    if size <= 0 {
        return 0
    }
    let n = if size > 1048576 { 1048576 } else { size }
    let raw = module_frontend_cached_read_file(path)
    var i: i64 = 0
    while i < n {
        MODULE_FRONTEND_IMPORT_FILE_DATA[i as usize] = raw[i as usize]
        i = i + 1
    }
    n
}

fn module_frontend_path_directory_slice(path: string) -> string with Mut, Panic, Div {
    let path_len = str_len(path)
    var last_slash: i64 = 0 - 1
    var i: i64 = 0
    while i < path_len {
        if str_char_at(path, i) == 47 {
            last_slash = i
        }
        i = i + 1
    }
    if last_slash < 0 {
        return "."
    }
    str_slice(path, 0, last_slash)
}

fn module_frontend_extract_relpath_from_loaded(path_start: i64, line_end: i64) -> string with Mut, Panic {
    var pos = path_start
    var path: string = ""
    var first_seg = true

    while pos < line_end {
        let c = MODULE_FRONTEND_IMPORT_FILE_DATA[pos as usize]
        if module_frontend_import_is_ident_ch(c) {
            if !first_seg {
                path = str_concat(path, "/")
            }
            first_seg = false
            while pos < line_end && module_frontend_import_is_ident_ch(MODULE_FRONTEND_IMPORT_FILE_DATA[pos as usize]) {
                path = str_concat(path, module_frontend_import_byte_to_str(MODULE_FRONTEND_IMPORT_FILE_DATA[pos as usize]))
                pos = pos + 1
            }
            if pos + 1 < line_end &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[pos as usize] == (58 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(pos + 1) as usize] == (58 as i8) {
                let after_cc = pos + 2
                if after_cc < line_end {
                    let next = MODULE_FRONTEND_IMPORT_FILE_DATA[after_cc as usize]
                    if next == (123 as i8) || next == (42 as i8) {
                        pos = line_end
                    } else {
                        pos = after_cc
                    }
                } else {
                    pos = line_end
                }
            } else {
                pos = line_end
            }
        } else {
            pos = pos + 1
        }
    }

    if str_len(path) == 0 {
        return ""
    }
    str_concat(path, ".sio")
}

fn module_frontend_loaded_find_pattern(size: i64, pattern: string) -> i64 with Mut, Panic, Div {
    let plen = str_len(pattern)
    if plen <= 0 {
        return 0
    }
    var i: i64 = 0
    while i + plen <= size {
        var same = true
        var j: i64 = 0
        while j < plen {
            if MODULE_FRONTEND_IMPORT_FILE_DATA[(i + j) as usize] != (str_char_at(pattern, j) as i8) {
                same = false
            }
            j = j + 1
        }
        if same {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn module_frontend_loaded_contains_pattern(size: i64, pattern: string) -> bool with Mut, Panic, Div {
    module_frontend_loaded_find_pattern(size, pattern) >= 0
}

fn module_frontend_loaded_first_int_value_after(start: i64, size: i64) -> i64 {
    var i = start
    while i < size {
        let ch = MODULE_FRONTEND_IMPORT_FILE_DATA[i as usize]
        if ch >= (48 as i8) && ch <= (57 as i8) {
            var value: i64 = 0
            while i < size {
                let digit = MODULE_FRONTEND_IMPORT_FILE_DATA[i as usize]
                if digit >= (48 as i8) && digit <= (57 as i8) {
                    value = (value * 10) + ((digit as i64) - 48)
                    i = i + 1
                } else {
                    return value
                }
            }
            return value
        }
        i = i + 1
    }
    0 - 1
}

fn module_frontend_int_value_after_pattern(path: string, pattern: string) -> i64 with IO, Mut, Panic, Div {
    let size = module_frontend_load_import_file(path)
    if size <= 0 {
        return 0 - 1
    }
    let pos = module_frontend_loaded_find_pattern(size, pattern)
    if pos < 0 {
        return 0 - 1
    }
    module_frontend_loaded_first_int_value_after(pos + str_len(pattern), size)
}

fn module_frontend_source_contains_pattern(path: string, pattern: string) -> bool with IO, Mut, Panic, Div {
    let size = module_frontend_load_import_file(path)
    if size <= 0 {
        return false
    }
    module_frontend_loaded_contains_pattern(size, pattern)
}

fn module_frontend_check_items_with_source_context(items: Option<Box<ItemList>>, source_path: string) -> i64 with IO, Mut, Div, Panic, Alloc {
    if module_frontend_source_contains_pattern(source_path, "//@ ontology-side-table-cache:") {
        let cache_verdict = check_items_verdict_boot4_with_ontocache_sidecar(items, source_path)
        if cache_verdict != 0 {
            return cache_verdict
        }
        return knowledge_context_validate_items_values_only(items)
    }

    let verdict = check_items_verdict_boot4(items)
    if verdict != 0 {
        return verdict
    }
    knowledge_context_validate_items(items)
}

fn string_list_seg_to_buf(sl: StringList, out: [i8; 512], pos: i64) -> ([i8; 512], i64) with Mut, Panic, Div {
    var buf = out
    var p = pos
    // Copy this segment's bytes
    var i: i64 = 0
    while i < sl.head_len && p < 500 {
        buf[p] = sl.head_buf[i]
        p = p + 1
        i = i + 1
    }
    (buf, p)
}

fn string_list_to_path_buf(sl: StringList, sep_a: i8, sep_b: i8, out: [i8; 512], pos: i64) -> ([i8; 512], i64) with Mut, Panic, Div, Alloc {
    // Copy head segment
    let head_pair = string_list_seg_to_buf(sl, out, pos)
    // If there is a tail, add separator and recurse
    match sl.tail {
        None => head_pair
        Some(next) => {
            var buf2 = head_pair.0
            var p2 = head_pair.1
            if p2 < 500 {
                buf2[p2] = sep_a
                p2 = p2 + 1
            }
            if sep_b != (0 as i8) && p2 < 500 {
                buf2[p2] = sep_b
                p2 = p2 + 1
            }
            string_list_to_path_buf(*next, sep_a, sep_b, buf2, p2)
        }
    }
}

fn use_path_to_string(path: AstPath) -> string with Mut, Panic, Div, Alloc {
    // Convert AstPath to "seg1::seg2::seg3" string
    if path.seg_count == 0 {
        return ""
    }
    var buf: [i8; 512] = [0; 512]
    // Use :: as separator (58 = ':', 58 = ':')
    let path_pair = string_list_to_path_buf(path.segments, 58 as i8, 58 as i8, buf, 0)
    // Convert [i8; 512] to string via byte printing
    buf_to_string(path_pair.0, path_pair.1)
}

// Check if a StringList head segment is exactly "super" (115,117,112,101,114)
fn seg_is_super(sl: StringList) -> bool {
    if sl.head_len != 5 { return false }
    sl.head_buf[0] == (115 as i8) &&
    sl.head_buf[1] == (117 as i8) &&
    sl.head_buf[2] == (112 as i8) &&
    sl.head_buf[3] == (101 as i8) &&
    sl.head_buf[4] == (114 as i8)
}

// Strip the last directory component from a path buffer.
// "/a/b/c" -> "/a/b" (returns index of last '/')
fn buf_strip_last_dir(buf: [i8; 512], len: i64) -> ([i8; 512], i64) with Mut, Panic, Div {
    var i = len - 1
    while i > 0 {
        if buf[i as usize] == (47 as i8) {
            return (buf, i)
        }
        i = i - 1
    }
    (buf, len)
}

// Process path segments into buf, handling "super" as parent-dir navigation.
// Each non-super segment is appended as "/seg"; "super" strips the last dir component.
fn use_path_segs_to_buf(sl: StringList, out: [i8; 512], pos: i64) -> ([i8; 512], i64) with Mut, Panic, Div, Alloc {
    if seg_is_super(sl) {
        let strip_pair = buf_strip_last_dir(out, pos)
        match sl.tail {
            None => strip_pair
            Some(next) => use_path_segs_to_buf(*next, strip_pair.0, strip_pair.1)
        }
    } else {
        var buf2 = out
        var p2 = pos
        if p2 < 500 {
            buf2[p2] = 47 as i8  // '/'
            p2 = p2 + 1
        }
        let seg_pair = string_list_seg_to_buf(sl, buf2, p2)
        match sl.tail {
            None => seg_pair
            Some(next) => use_path_segs_to_buf(*next, seg_pair.0, seg_pair.1)
        }
    }
}

fn use_path_to_file_path(path: AstPath, prefix: string) -> string with Mut, Panic, Div, Alloc {
    // Convert AstPath to "prefix/seg1/seg2/seg3.sio" file path.
    // "super" segments navigate up one directory level.
    if path.seg_count == 0 {
        return ""
    }
    var buf: [i8; 512] = [0; 512]
    var pos: i64 = 0
    // Write prefix bytes (no trailing slash — segments add their own leading slash)
    let prefix_len = str_len(prefix)
    var pi: i64 = 0
    while pi < prefix_len && pos < 490 {
        buf[pos] = str_char_at(prefix, pi) as i8
        pos = pos + 1
        pi = pi + 1
    }
    // Process all segments (super-aware)
    let path_pair = use_path_segs_to_buf(path.segments, buf, pos)
    // Append ".sio"
    var final_buf = path_pair.0
    var fp = path_pair.1
    if fp < 508 {
        final_buf[fp] = 46 as i8      // '.'
        final_buf[fp + 1] = 115 as i8 // 's'
        final_buf[fp + 2] = 105 as i8 // 'i'
        final_buf[fp + 3] = 111 as i8 // 'o'
        fp = fp + 4
    }
    buf_to_string(final_buf, fp)
}

fn use_path_to_stdlib_file_path(path: AstPath) -> string with IO, Mut, Panic, Div, Alloc {
    use_path_to_file_path(path, module_frontend_stdlib_root())
}

// Convert byte buffer to VM string using str_from_bytes builtin
fn buf_to_string(buf: [i8; 512], len: i64) -> string with Mut, Panic, Div {
    str_from_bytes(buf, len)
}

fn module_frontend_stdlib_rel_path(rel_path: string) -> string with IO, Mut, Panic, Div {
    str_concat(str_concat(module_frontend_stdlib_root(), "/"), rel_path)
}

fn path_directory(path: string) -> string with Mut, Panic, Div {
    var path_len = str_len(path)
    var last_slash: i64 = 0 - 1
    var i: i64 = 0
    while i < path_len {
        if str_char_at(path, i) == 47 {
            last_slash = i
        }
        i = i + 1
    }
    if last_slash < 0 {
        return "."
    }
    var buf: [i8; 512] = [0; 512]
    i = 0
    while i <= last_slash && i < 511 {
        buf[i] = str_char_at(path, i) as i8
        i = i + 1
    }
    str_from_bytes(buf, last_slash)
}

fn mf_empty_program() -> Program {
    Program {
        module_path: empty_path(),
        items: None,
    }
}

fn ir_epistemic_offset_id(id: i64, offset: i64) -> i64 {
    if id >= 0 { id + offset } else { id }
}

fn ir_merge_adjust_epistemic_instr(
    instr: IrInstr,
    contest_offset: i64,
    robust_offset: i64,
    decision_offset: i64,
    deferred_offset: i64,
    validated_offset: i64,
    acquisition_plan_offset: i64,
    recourse_plan_offset: i64,
    alternative_set_offset: i64,
    transition_plan_offset: i64,
    observed_transition_offset: i64,
    rollback_certificate_offset: i64
) -> IrInstr with Mut {
    var out = instr
    if out.op == IrOpcode::IrContest || out.op == IrOpcode::IrLiftKnowledge {
        out.label_id = ir_epistemic_offset_id(out.label_id, contest_offset)
    } else if out.op == IrOpcode::IrProveRobust {
        out.label_id = ir_epistemic_offset_id(out.label_id, robust_offset)
    } else if out.op == IrOpcode::IrAdmitAction {
        out.label_id = ir_epistemic_offset_id(out.label_id, decision_offset)
    } else if out.op == IrOpcode::IrDeferAction {
        out.label_id = ir_epistemic_offset_id(out.label_id, deferred_offset)
    } else if out.op == IrOpcode::IrValidated {
        out.label_id = ir_epistemic_offset_id(out.label_id, validated_offset)
    } else if out.op == IrOpcode::IrPlanAcquisition {
        out.label_id = ir_epistemic_offset_id(out.label_id, acquisition_plan_offset)
    } else if out.op == IrOpcode::IrPlanRecourse {
        out.label_id = ir_epistemic_offset_id(out.label_id, recourse_plan_offset)
    } else if out.op == IrOpcode::IrProposeAlternatives {
        out.label_id = ir_epistemic_offset_id(out.label_id, alternative_set_offset)
    } else if out.op == IrOpcode::IrCommitAlternative {
        out.label_id = ir_epistemic_offset_id(out.label_id, transition_plan_offset)
    } else if out.op == IrOpcode::IrObserveTransition {
        out.label_id = ir_epistemic_offset_id(out.label_id, observed_transition_offset)
    } else if out.op == IrOpcode::IrRollbackTransition {
        out.label_id = ir_epistemic_offset_id(out.label_id, rollback_certificate_offset)
    }
    out
}

fn ir_merge_epistemic_sections(dst: IrEpistemicSection, src: IrEpistemicSection) -> IrEpistemicSection with Mut, Panic, Div {
    var merged = dst
    let family_offset = dst.model_family_count
    let policy_offset = dst.policy_count
    let decision_policy_offset = dst.decision_policy_count
    let deferral_policy_offset = dst.deferral_policy_count
    let acquisition_policy_offset = dst.acquisition_policy_count
    let recourse_policy_offset = dst.recourse_policy_count
    let validation_offset = dst.validation_count
    let mechanistic_offset = dst.mechanistic_report_count
    let posterior_weights_offset = dst.posterior_weights_count
    let counterexample_offset = dst.counterexample_count
    let audit_offset = dst.audit_count
    let contest_offset = dst.contest_count
    let contest_witness_offset = dst.contest_witness_count
    let robust_offset = dst.robust_proof_count
    let decision_certificate_offset = dst.decision_certificate_count
    let deferred_certificate_offset = dst.deferred_certificate_count
    let deferred_reason_witness_offset = dst.deferred_reason_witness_count
    let acquisition_plan_offset = dst.acquisition_plan_count
    let acquisition_reason_witness_offset = dst.acquisition_reason_witness_count
    let recourse_plan_offset = dst.recourse_plan_count
    let recourse_reason_witness_offset = dst.recourse_reason_witness_count
    let alternative_policy_offset = dst.alternative_policy_count
    let alternative_frontier_offset = dst.alternative_frontier_count
    let alternative_candidate_offset = dst.alternative_candidate_count
    let alternative_set_offset = dst.alternative_set_count
    let alternative_reason_witness_offset = dst.alternative_reason_witness_count
    let transition_policy_offset = dst.transition_policy_count
    let transition_step_offset = dst.transition_step_count
    let transition_protocol_offset = dst.transition_protocol_count
    let transition_plan_offset = dst.transition_plan_count
    let transition_reason_witness_offset = dst.transition_reason_witness_count
    let monitoring_policy_offset = dst.monitoring_policy_count
    let observed_transition_offset = dst.observed_transition_count
    let rollback_certificate_offset = dst.rollback_certificate_count
    let validated_offset = dst.validated_manifest_count

    var i: i64 = 0
    while i < src.model_family_count && merged.model_family_count < IR_MAX_EPI_MODEL_FAMILIES {
        var info = src.model_families[i]
        info.id = merged.model_family_count
        merged.model_families[merged.model_family_count as usize] = info
        merged.model_family_count = merged.model_family_count + 1
        i = i + 1
    }

    i = 0
    while i < src.policy_count && merged.policy_count < IR_MAX_EPI_POLICIES {
        var info = src.policies[i]
        info.id = merged.policy_count
        merged.policies[merged.policy_count as usize] = info
        merged.policy_count = merged.policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.decision_policy_count && merged.decision_policy_count < IR_MAX_EPI_DECISION_POLICIES {
        var info = src.decision_policies[i]
        info.id = merged.decision_policy_count
        merged.decision_policies[merged.decision_policy_count as usize] = info
        merged.decision_policy_count = merged.decision_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.deferral_policy_count && merged.deferral_policy_count < IR_MAX_EPI_DEFERRAL_POLICIES {
        var info = src.deferral_policies[i]
        info.id = merged.deferral_policy_count
        merged.deferral_policies[merged.deferral_policy_count as usize] = info
        merged.deferral_policy_count = merged.deferral_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.acquisition_policy_count && merged.acquisition_policy_count < IR_MAX_EPI_ACQUISITION_POLICIES {
        var info = src.acquisition_policies[i]
        info.id = merged.acquisition_policy_count
        merged.acquisition_policies[merged.acquisition_policy_count as usize] = info
        merged.acquisition_policy_count = merged.acquisition_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.recourse_policy_count && merged.recourse_policy_count < IR_MAX_EPI_RECOURSE_POLICIES {
        var info = src.recourse_policies[i]
        info.id = merged.recourse_policy_count
        merged.recourse_policies[merged.recourse_policy_count as usize] = info
        merged.recourse_policy_count = merged.recourse_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.validation_count && merged.validation_count < IR_MAX_EPI_VALIDATIONS {
        var info = src.validations[i]
        info.id = merged.validation_count
        merged.validations[merged.validation_count as usize] = info
        merged.validation_count = merged.validation_count + 1
        i = i + 1
    }

    i = 0
    while i < src.mechanistic_report_count && merged.mechanistic_report_count < IR_MAX_EPI_MECHANISTIC_REPORTS {
        var info = src.mechanistic_reports[i]
        info.id = merged.mechanistic_report_count
        merged.mechanistic_reports[merged.mechanistic_report_count as usize] = info
        merged.mechanistic_report_count = merged.mechanistic_report_count + 1
        i = i + 1
    }

    i = 0
    while i < src.posterior_weights_count && merged.posterior_weights_count < IR_MAX_EPI_POSTERIOR_WEIGHTS {
        var info = src.posterior_weights[i]
        info.id = merged.posterior_weights_count
        merged.posterior_weights[merged.posterior_weights_count as usize] = info
        merged.posterior_weights_count = merged.posterior_weights_count + 1
        i = i + 1
    }

    i = 0
    while i < src.counterexample_count && merged.counterexample_count < IR_MAX_EPI_COUNTEREXAMPLES {
        var info = src.counterexamples[i]
        info.id = merged.counterexample_count
        merged.counterexamples[merged.counterexample_count as usize] = info
        merged.counterexample_count = merged.counterexample_count + 1
        i = i + 1
    }

    i = 0
    while i < src.audit_count && merged.audit_count < IR_MAX_EPI_AUDITS {
        var info = src.audits[i]
        info.id = merged.audit_count
        info.family_id = ir_epistemic_offset_id(info.family_id, family_offset)
        info.policy_id = ir_epistemic_offset_id(info.policy_id, policy_offset)
        info.mechanistic_report_id = ir_epistemic_offset_id(info.mechanistic_report_id, mechanistic_offset)
        info.posterior_weights_id = ir_epistemic_offset_id(info.posterior_weights_id, posterior_weights_offset)
        info.counterexample_id = ir_epistemic_offset_id(info.counterexample_id, counterexample_offset)
        merged.audits[merged.audit_count as usize] = info
        merged.audit_count = merged.audit_count + 1
        i = i + 1
    }

    i = 0
    while i < src.contest_count && merged.contest_count < IR_MAX_EPI_CONTESTS {
        var info = src.contests[i]
        info.id = merged.contest_count
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.family_id = ir_epistemic_offset_id(info.family_id, family_offset)
        info.policy_id = ir_epistemic_offset_id(info.policy_id, policy_offset)
        info.mechanistic_report_id = ir_epistemic_offset_id(info.mechanistic_report_id, mechanistic_offset)
        info.posterior_weights_id = ir_epistemic_offset_id(info.posterior_weights_id, posterior_weights_offset)
        info.counterexample_id = ir_epistemic_offset_id(info.counterexample_id, counterexample_offset)
