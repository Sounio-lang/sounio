// self-hosted::compiler::module_frontend
//
// Multimodule frontend and IR-loading lane split from module_loader.sio.
// Keeps frontend probes off the native/wasm/optimizer/thin-link backend surface.

use parser::ast::{AstPath, empty_path, Item, ItemKind, ItemList, Name, ParamList, Program, StringList}
use parser::mod::{count_items}
use parser::parser::{parser_reset_last_errors}
use ir::ir::*
use io::env::{read_env}
use check::mod::{check_items_verdict_boot4, check_program_epistemic_into}
use resolve::mod::{resolve_modules}
use module_parse::{extract_imports_from_ast, file_exists, load_module_file}

fn module_frontend_lower_trace_enabled() -> bool with IO, Mut, Panic, Div {
    str_eq(read_env("SOUNIO_MODULE_FRONTEND_LOWER_TRACE"), "1")
}

var MODULE_FRONTEND_IMPORT_FILE_DATA: [i8; 1048576] = [0; 1048576]

fn module_frontend_import_is_ident_ch(c: i8) -> bool {
    (c >= 65 as i8 && c <= 90 as i8) ||
    (c >= 97 as i8 && c <= 122 as i8) ||
    (c >= 48 as i8 && c <= 57 as i8) ||
    c == 95 as i8
}

fn module_frontend_import_byte_to_str(c: i8) -> string {
    let v = c as i64
    if v >= 97 && v <= 122 {
        return str_slice("abcdefghijklmnopqrstuvwxyz", v - 97, v - 96)
    }
    if v >= 65 && v <= 90 {
        return str_slice("ABCDEFGHIJKLMNOPQRSTUVWXYZ", v - 65, v - 64)
    }
    if v >= 48 && v <= 57 {
        return str_slice("0123456789", v - 48, v - 47)
    }
    if v == 95 { return "_" }
    if v == 47 { return "/" }
    if v == 46 { return "." }
    if v == 45 { return "-" }
    ""
}

fn module_frontend_load_import_file(path: string) -> i64 with IO, Mut, Panic, Div {
    let size = file_size(path)
    if size <= 0 {
        return 0
    }
    let n = if size > 1048576 { 1048576 } else { size }
    let raw = read_file(path)
    var i: i64 = 0
    while i < n {
        MODULE_FRONTEND_IMPORT_FILE_DATA[i as usize] = raw[i as usize]
        i = i + 1
    }
    n
}

fn module_frontend_path_directory_slice(path: string) -> string with Mut, Panic, Div {
    let path_len = str_len(path)
    var last_slash: i64 = 0 - 1
    var i: i64 = 0
    while i < path_len {
        if str_char_at(path, i) == 47 {
            last_slash = i
        }
        i = i + 1
    }
    if last_slash < 0 {
        return "."
    }
    str_slice(path, 0, last_slash)
}

fn module_frontend_extract_relpath_from_loaded(path_start: i64, line_end: i64) -> string with Mut, Panic {
    var pos = path_start
    var path: string = ""
    var first_seg = true

    while pos < line_end {
        let c = MODULE_FRONTEND_IMPORT_FILE_DATA[pos as usize]
        if module_frontend_import_is_ident_ch(c) {
            if !first_seg {
                path = str_concat(path, "/")
            }
            first_seg = false
            while pos < line_end && module_frontend_import_is_ident_ch(MODULE_FRONTEND_IMPORT_FILE_DATA[pos as usize]) {
                path = str_concat(path, module_frontend_import_byte_to_str(MODULE_FRONTEND_IMPORT_FILE_DATA[pos as usize]))
                pos = pos + 1
            }
            if pos + 1 < line_end &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[pos as usize] == (58 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(pos + 1) as usize] == (58 as i8) {
                let after_cc = pos + 2
                if after_cc < line_end {
                    let next = MODULE_FRONTEND_IMPORT_FILE_DATA[after_cc as usize]
                    if next == (123 as i8) || next == (42 as i8) {
                        pos = line_end
                    } else {
                        pos = after_cc
                    }
                } else {
                    pos = line_end
                }
            } else {
                pos = line_end
            }
        } else {
            pos = pos + 1
        }
    }

    if str_len(path) == 0 {
        return ""
    }
    str_concat(path, ".sio")
}

fn module_frontend_loaded_find_pattern(size: i64, pattern: string) -> i64 with Mut, Panic, Div {
    let plen = str_len(pattern)
    if plen <= 0 {
        return 0
    }
    var i: i64 = 0
    while i + plen <= size {
        var same = true
        var j: i64 = 0
        while j < plen {
            if MODULE_FRONTEND_IMPORT_FILE_DATA[(i + j) as usize] != (str_char_at(pattern, j) as i8) {
                same = false
            }
            j = j + 1
        }
        if same {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn module_frontend_loaded_contains_pattern(size: i64, pattern: string) -> bool with Mut, Panic, Div {
    module_frontend_loaded_find_pattern(size, pattern) >= 0
}

fn module_frontend_loaded_first_int_value_after(start: i64, size: i64) -> i64 {
    var i = start
    while i < size {
        let ch = MODULE_FRONTEND_IMPORT_FILE_DATA[i as usize]
        if ch >= (48 as i8) && ch <= (57 as i8) {
            var value: i64 = 0
            while i < size {
                let digit = MODULE_FRONTEND_IMPORT_FILE_DATA[i as usize]
                if digit >= (48 as i8) && digit <= (57 as i8) {
                    value = (value * 10) + ((digit as i64) - 48)
                    i = i + 1
                } else {
                    return value
                }
            }
            return value
        }
        i = i + 1
    }
    0 - 1
}

fn module_frontend_int_value_after_pattern(path: string, pattern: string) -> i64 with IO, Mut, Panic, Div {
    let size = module_frontend_load_import_file(path)
    if size <= 0 {
        return 0 - 1
    }
    let pos = module_frontend_loaded_find_pattern(size, pattern)
    if pos < 0 {
        return 0 - 1
    }
    module_frontend_loaded_first_int_value_after(pos + str_len(pattern), size)
}

fn module_frontend_source_contains_pattern(path: string, pattern: string) -> bool with IO, Mut, Panic, Div {
    let size = module_frontend_load_import_file(path)
    if size <= 0 {
        return false
    }
    module_frontend_loaded_contains_pattern(size, pattern)
}

fn string_list_seg_to_buf(sl: StringList, out: [i8; 512], pos: i64) -> ([i8; 512], i64) with Mut, Panic, Div {
    var buf = out
    var p = pos
    // Copy this segment's bytes
    var i: i64 = 0
    while i < sl.head_len && p < 500 {
        buf[p] = sl.head_buf[i]
        p = p + 1
        i = i + 1
    }
    (buf, p)
}

fn string_list_to_path_buf(sl: StringList, sep_a: i8, sep_b: i8, out: [i8; 512], pos: i64) -> ([i8; 512], i64) with Mut, Panic, Div, Alloc {
    // Copy head segment
    let head_pair = string_list_seg_to_buf(sl, out, pos)
    // If there is a tail, add separator and recurse
    match sl.tail {
        None => head_pair
        Some(next) => {
            var buf2 = head_pair.0
            var p2 = head_pair.1
            if p2 < 500 {
                buf2[p2] = sep_a
                p2 = p2 + 1
            }
            if sep_b != (0 as i8) && p2 < 500 {
                buf2[p2] = sep_b
                p2 = p2 + 1
            }
            string_list_to_path_buf(*next, sep_a, sep_b, buf2, p2)
        }
    }
}

fn use_path_to_string(path: AstPath) -> string with Mut, Panic, Div, Alloc {
    // Convert AstPath to "seg1::seg2::seg3" string
    if path.seg_count == 0 {
        return ""
    }
    var buf: [i8; 512] = [0; 512]
    // Use :: as separator (58 = ':', 58 = ':')
    let path_pair = string_list_to_path_buf(path.segments, 58 as i8, 58 as i8, buf, 0)
    // Convert [i8; 512] to string via byte printing
    buf_to_string(path_pair.0, path_pair.1)
}

// Check if a StringList head segment is exactly "super" (115,117,112,101,114)
fn seg_is_super(sl: StringList) -> bool {
    if sl.head_len != 5 { return false }
    sl.head_buf[0] == (115 as i8) &&
    sl.head_buf[1] == (117 as i8) &&
    sl.head_buf[2] == (112 as i8) &&
    sl.head_buf[3] == (101 as i8) &&
    sl.head_buf[4] == (114 as i8)
}

// Strip the last directory component from a path buffer.
// "/a/b/c" -> "/a/b" (returns index of last '/')
fn buf_strip_last_dir(buf: [i8; 512], len: i64) -> ([i8; 512], i64) with Mut, Panic, Div {
    var i = len - 1
    while i > 0 {
        if buf[i as usize] == (47 as i8) {
            return (buf, i)
        }
        i = i - 1
    }
    (buf, len)
}

// Process path segments into buf, handling "super" as parent-dir navigation.
// Each non-super segment is appended as "/seg"; "super" strips the last dir component.
fn use_path_segs_to_buf(sl: StringList, out: [i8; 512], pos: i64) -> ([i8; 512], i64) with Mut, Panic, Div, Alloc {
    if seg_is_super(sl) {
        let strip_pair = buf_strip_last_dir(out, pos)
        match sl.tail {
            None => strip_pair
            Some(next) => use_path_segs_to_buf(*next, strip_pair.0, strip_pair.1)
        }
    } else {
        var buf2 = out
        var p2 = pos
        if p2 < 500 {
            buf2[p2] = 47 as i8  // '/'
            p2 = p2 + 1
        }
        let seg_pair = string_list_seg_to_buf(sl, buf2, p2)
        match sl.tail {
            None => seg_pair
            Some(next) => use_path_segs_to_buf(*next, seg_pair.0, seg_pair.1)
        }
    }
}

fn use_path_to_file_path(path: AstPath, prefix: string) -> string with Mut, Panic, Div, Alloc {
    // Convert AstPath to "prefix/seg1/seg2/seg3.sio" file path.
    // "super" segments navigate up one directory level.
    if path.seg_count == 0 {
        return ""
    }
    var buf: [i8; 512] = [0; 512]
    var pos: i64 = 0
    // Write prefix bytes (no trailing slash — segments add their own leading slash)
    let prefix_len = str_len(prefix)
    var pi: i64 = 0
    while pi < prefix_len && pos < 490 {
        buf[pos] = str_char_at(prefix, pi) as i8
        pos = pos + 1
        pi = pi + 1
    }
    // Process all segments (super-aware)
    let path_pair = use_path_segs_to_buf(path.segments, buf, pos)
    // Append ".sio"
    var final_buf = path_pair.0
    var fp = path_pair.1
    if fp < 508 {
        final_buf[fp] = 46 as i8      // '.'
        final_buf[fp + 1] = 115 as i8 // 's'
        final_buf[fp + 2] = 105 as i8 // 'i'
        final_buf[fp + 3] = 111 as i8 // 'o'
        fp = fp + 4
    }
    buf_to_string(final_buf, fp)
}

// Convert byte buffer to VM string using str_from_bytes builtin
fn buf_to_string(buf: [i8; 512], len: i64) -> string with Mut, Panic, Div {
    str_from_bytes(buf, len)
}

fn path_directory(path: string) -> string with Mut, Panic, Div {
    var path_len = str_len(path)
    var last_slash: i64 = 0 - 1
    var i: i64 = 0
    while i < path_len {
        if str_char_at(path, i) == 47 {
            last_slash = i
        }
        i = i + 1
    }
    if last_slash < 0 {
        return "."
    }
    var buf: [i8; 512] = [0; 512]
    i = 0
    while i <= last_slash && i < 511 {
        buf[i] = str_char_at(path, i) as i8
        i = i + 1
    }
    str_from_bytes(buf, last_slash)
}

fn empty_program() -> Program {
    Program {
        module_path: empty_path(),
        items: None,
    }
}

fn ir_epistemic_offset_id(id: i64, offset: i64) -> i64 {
    if id >= 0 { id + offset } else { id }
}

fn ir_merge_adjust_epistemic_instr(
    instr: IrInstr,
    contest_offset: i64,
    robust_offset: i64,
    decision_offset: i64,
    deferred_offset: i64,
    validated_offset: i64,
    acquisition_plan_offset: i64,
    recourse_plan_offset: i64,
    alternative_set_offset: i64,
    transition_plan_offset: i64,
    observed_transition_offset: i64,
    rollback_certificate_offset: i64
) -> IrInstr with Mut {
    var out = instr
    if out.op == IrOpcode::IrContest || out.op == IrOpcode::IrLiftKnowledge {
        out.label_id = ir_epistemic_offset_id(out.label_id, contest_offset)
    } else if out.op == IrOpcode::IrProveRobust {
        out.label_id = ir_epistemic_offset_id(out.label_id, robust_offset)
    } else if out.op == IrOpcode::IrAdmitAction {
        out.label_id = ir_epistemic_offset_id(out.label_id, decision_offset)
    } else if out.op == IrOpcode::IrDeferAction {
        out.label_id = ir_epistemic_offset_id(out.label_id, deferred_offset)
    } else if out.op == IrOpcode::IrValidated {
        out.label_id = ir_epistemic_offset_id(out.label_id, validated_offset)
    } else if out.op == IrOpcode::IrPlanAcquisition {
        out.label_id = ir_epistemic_offset_id(out.label_id, acquisition_plan_offset)
    } else if out.op == IrOpcode::IrPlanRecourse {
        out.label_id = ir_epistemic_offset_id(out.label_id, recourse_plan_offset)
    } else if out.op == IrOpcode::IrProposeAlternatives {
        out.label_id = ir_epistemic_offset_id(out.label_id, alternative_set_offset)
    } else if out.op == IrOpcode::IrCommitAlternative {
        out.label_id = ir_epistemic_offset_id(out.label_id, transition_plan_offset)
    } else if out.op == IrOpcode::IrObserveTransition {
        out.label_id = ir_epistemic_offset_id(out.label_id, observed_transition_offset)
    } else if out.op == IrOpcode::IrRollbackTransition {
        out.label_id = ir_epistemic_offset_id(out.label_id, rollback_certificate_offset)
    }
    out
}

fn ir_merge_epistemic_sections(dst: IrEpistemicSection, src: IrEpistemicSection) -> IrEpistemicSection with Mut, Panic, Div {
    var merged = dst
    let family_offset = dst.model_family_count
    let policy_offset = dst.policy_count
    let decision_policy_offset = dst.decision_policy_count
    let deferral_policy_offset = dst.deferral_policy_count
    let acquisition_policy_offset = dst.acquisition_policy_count
    let recourse_policy_offset = dst.recourse_policy_count
    let validation_offset = dst.validation_count
    let mechanistic_offset = dst.mechanistic_report_count
    let posterior_weights_offset = dst.posterior_weights_count
    let counterexample_offset = dst.counterexample_count
    let audit_offset = dst.audit_count
    let contest_offset = dst.contest_count
    let contest_witness_offset = dst.contest_witness_count
    let robust_offset = dst.robust_proof_count
    let decision_certificate_offset = dst.decision_certificate_count
    let deferred_certificate_offset = dst.deferred_certificate_count
    let deferred_reason_witness_offset = dst.deferred_reason_witness_count
    let acquisition_plan_offset = dst.acquisition_plan_count
    let acquisition_reason_witness_offset = dst.acquisition_reason_witness_count
    let recourse_plan_offset = dst.recourse_plan_count
    let recourse_reason_witness_offset = dst.recourse_reason_witness_count
    let alternative_policy_offset = dst.alternative_policy_count
    let alternative_frontier_offset = dst.alternative_frontier_count
    let alternative_candidate_offset = dst.alternative_candidate_count
    let alternative_set_offset = dst.alternative_set_count
    let alternative_reason_witness_offset = dst.alternative_reason_witness_count
    let transition_policy_offset = dst.transition_policy_count
    let transition_step_offset = dst.transition_step_count
    let transition_protocol_offset = dst.transition_protocol_count
    let transition_plan_offset = dst.transition_plan_count
    let transition_reason_witness_offset = dst.transition_reason_witness_count
    let monitoring_policy_offset = dst.monitoring_policy_count
    let observed_transition_offset = dst.observed_transition_count
    let rollback_certificate_offset = dst.rollback_certificate_count
    let validated_offset = dst.validated_manifest_count

    var i: i64 = 0
    while i < src.model_family_count && merged.model_family_count < IR_MAX_EPI_MODEL_FAMILIES {
        var info = src.model_families[i]
        info.id = merged.model_family_count
        merged.model_families[merged.model_family_count as usize] = info
        merged.model_family_count = merged.model_family_count + 1
        i = i + 1
    }

    i = 0
    while i < src.policy_count && merged.policy_count < IR_MAX_EPI_POLICIES {
        var info = src.policies[i]
        info.id = merged.policy_count
        merged.policies[merged.policy_count as usize] = info
        merged.policy_count = merged.policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.decision_policy_count && merged.decision_policy_count < IR_MAX_EPI_DECISION_POLICIES {
        var info = src.decision_policies[i]
        info.id = merged.decision_policy_count
        merged.decision_policies[merged.decision_policy_count as usize] = info
        merged.decision_policy_count = merged.decision_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.deferral_policy_count && merged.deferral_policy_count < IR_MAX_EPI_DEFERRAL_POLICIES {
        var info = src.deferral_policies[i]
        info.id = merged.deferral_policy_count
        merged.deferral_policies[merged.deferral_policy_count as usize] = info
        merged.deferral_policy_count = merged.deferral_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.acquisition_policy_count && merged.acquisition_policy_count < IR_MAX_EPI_ACQUISITION_POLICIES {
        var info = src.acquisition_policies[i]
        info.id = merged.acquisition_policy_count
        merged.acquisition_policies[merged.acquisition_policy_count as usize] = info
        merged.acquisition_policy_count = merged.acquisition_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.recourse_policy_count && merged.recourse_policy_count < IR_MAX_EPI_RECOURSE_POLICIES {
        var info = src.recourse_policies[i]
        info.id = merged.recourse_policy_count
        merged.recourse_policies[merged.recourse_policy_count as usize] = info
        merged.recourse_policy_count = merged.recourse_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.validation_count && merged.validation_count < IR_MAX_EPI_VALIDATIONS {
        var info = src.validations[i]
        info.id = merged.validation_count
        merged.validations[merged.validation_count as usize] = info
        merged.validation_count = merged.validation_count + 1
        i = i + 1
    }

    i = 0
    while i < src.mechanistic_report_count && merged.mechanistic_report_count < IR_MAX_EPI_MECHANISTIC_REPORTS {
        var info = src.mechanistic_reports[i]
        info.id = merged.mechanistic_report_count
        merged.mechanistic_reports[merged.mechanistic_report_count as usize] = info
        merged.mechanistic_report_count = merged.mechanistic_report_count + 1
        i = i + 1
    }

    i = 0
    while i < src.posterior_weights_count && merged.posterior_weights_count < IR_MAX_EPI_POSTERIOR_WEIGHTS {
        var info = src.posterior_weights[i]
        info.id = merged.posterior_weights_count
        merged.posterior_weights[merged.posterior_weights_count as usize] = info
        merged.posterior_weights_count = merged.posterior_weights_count + 1
        i = i + 1
    }

    i = 0
    while i < src.counterexample_count && merged.counterexample_count < IR_MAX_EPI_COUNTEREXAMPLES {
        var info = src.counterexamples[i]
        info.id = merged.counterexample_count
        merged.counterexamples[merged.counterexample_count as usize] = info
        merged.counterexample_count = merged.counterexample_count + 1
        i = i + 1
    }

    i = 0
    while i < src.audit_count && merged.audit_count < IR_MAX_EPI_AUDITS {
        var info = src.audits[i]
        info.id = merged.audit_count
        info.family_id = ir_epistemic_offset_id(info.family_id, family_offset)
        info.policy_id = ir_epistemic_offset_id(info.policy_id, policy_offset)
        info.mechanistic_report_id = ir_epistemic_offset_id(info.mechanistic_report_id, mechanistic_offset)
        info.posterior_weights_id = ir_epistemic_offset_id(info.posterior_weights_id, posterior_weights_offset)
        info.counterexample_id = ir_epistemic_offset_id(info.counterexample_id, counterexample_offset)
        merged.audits[merged.audit_count as usize] = info
        merged.audit_count = merged.audit_count + 1
        i = i + 1
    }

    i = 0
    while i < src.contest_count && merged.contest_count < IR_MAX_EPI_CONTESTS {
        var info = src.contests[i]
        info.id = merged.contest_count
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.family_id = ir_epistemic_offset_id(info.family_id, family_offset)
        info.policy_id = ir_epistemic_offset_id(info.policy_id, policy_offset)
        info.mechanistic_report_id = ir_epistemic_offset_id(info.mechanistic_report_id, mechanistic_offset)
        info.posterior_weights_id = ir_epistemic_offset_id(info.posterior_weights_id, posterior_weights_offset)
        info.counterexample_id = ir_epistemic_offset_id(info.counterexample_id, counterexample_offset)
        merged.contests[merged.contest_count as usize] = info
        merged.contest_count = merged.contest_count + 1
        i = i + 1
    }

    i = 0
    while i < src.contest_witness_count && merged.contest_witness_count < IR_MAX_EPI_CONTEST_WITNESSES {
        var info = src.contest_witnesses[i]
        info.id = merged.contest_witness_count
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        merged.contest_witnesses[merged.contest_witness_count as usize] = info
        merged.contest_witness_count = merged.contest_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < src.robust_proof_count && merged.robust_proof_count < IR_MAX_EPI_ROBUST_PROOFS {
        var info = src.robust_proofs[i]
        info.id = merged.robust_proof_count
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        info.policy_id = ir_epistemic_offset_id(info.policy_id, policy_offset)
        merged.robust_proofs[merged.robust_proof_count as usize] = info
        merged.robust_proof_count = merged.robust_proof_count + 1
        i = i + 1
    }

    i = 0
    while i < src.validated_manifest_count && merged.validated_manifest_count < IR_MAX_EPI_VALIDATED_MANIFESTS {
        let src_info = src.validated_manifests[i]
        merged.validated_manifests[merged.validated_manifest_count as usize] = IrValidatedManifestInfo {
            id: merged.validated_manifest_count,
            span_start: src_info.span_start,
            span_end: src_info.span_end,
            audit_id: ir_epistemic_offset_id(src_info.audit_id, audit_offset),
            robust_proof_id: ir_epistemic_offset_id(src_info.robust_proof_id, robust_offset),
            validation_id: if src_info.validation_id >= 0 {
                src_info.validation_id + validation_offset
            } else {
                src_info.validation_id
            },
            inner_ty: src_info.inner_ty,
        }
        merged.validated_manifest_count = merged.validated_manifest_count + 1
        i = i + 1
    }

    i = 0
    while i < src.decision_certificate_count && merged.decision_certificate_count < IR_MAX_EPI_DECISION_CERTIFICATES {
        var info = src.decision_certificates[i]
        info.id = merged.decision_certificate_count
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.robust_proof_id = ir_epistemic_offset_id(info.robust_proof_id, robust_offset)
        info.decision_policy_id = ir_epistemic_offset_id(info.decision_policy_id, decision_policy_offset)
        merged.decision_certificates[merged.decision_certificate_count as usize] = info
        merged.decision_certificate_count = merged.decision_certificate_count + 1
        i = i + 1
    }

    i = 0
    while i < src.deferred_certificate_count && merged.deferred_certificate_count < IR_MAX_EPI_DEFERRED_CERTIFICATES {
        var info = src.deferred_certificates[i]
        info.id = merged.deferred_certificate_count
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        info.robust_proof_id = ir_epistemic_offset_id(info.robust_proof_id, robust_offset)
        info.deferral_policy_id = ir_epistemic_offset_id(info.deferral_policy_id, deferral_policy_offset)
        merged.deferred_certificates[merged.deferred_certificate_count as usize] = info
        merged.deferred_certificate_count = merged.deferred_certificate_count + 1
        i = i + 1
    }

    i = 0
    while i < src.deferred_reason_witness_count && merged.deferred_reason_witness_count < IR_MAX_EPI_DEFERRED_REASON_WITNESSES {
        var info = src.deferred_reason_witnesses[i]
        info.id = merged.deferred_reason_witness_count
        info.deferred_certificate_id = ir_epistemic_offset_id(info.deferred_certificate_id, deferred_certificate_offset)
        merged.deferred_reason_witnesses[merged.deferred_reason_witness_count as usize] = info
        merged.deferred_reason_witness_count = merged.deferred_reason_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < src.acquisition_plan_count && merged.acquisition_plan_count < IR_MAX_EPI_ACQUISITION_PLANS {
        var info = src.acquisition_plans[i]
        info.id = merged.acquisition_plan_count
        info.deferred_certificate_id = ir_epistemic_offset_id(info.deferred_certificate_id, deferred_certificate_offset)
        info.acquisition_policy_id = ir_epistemic_offset_id(info.acquisition_policy_id, acquisition_policy_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        merged.acquisition_plans[merged.acquisition_plan_count as usize] = info
        merged.acquisition_plan_count = merged.acquisition_plan_count + 1
        i = i + 1
    }

    i = 0
    while i < src.acquisition_reason_witness_count && merged.acquisition_reason_witness_count < IR_MAX_EPI_ACQUISITION_REASON_WITNESSES {
        let src_info = src.acquisition_reason_witnesses[i]
        merged.acquisition_reason_witnesses[merged.acquisition_reason_witness_count as usize] = IrAcquisitionReasonWitnessInfo {
            id: merged.acquisition_reason_witness_count,
            span_start: src_info.span_start,
            span_end: src_info.span_end,
            acquisition_plan_id: if src_info.acquisition_plan_id >= 0 {
                src_info.acquisition_plan_id + acquisition_plan_offset
            } else {
                src_info.acquisition_plan_id
            },
        }
        merged.acquisition_reason_witness_count = merged.acquisition_reason_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < src.recourse_plan_count && merged.recourse_plan_count < IR_MAX_EPI_RECOURSE_PLANS {
        var info = src.recourse_plans[i]
        info.id = merged.recourse_plan_count
        info.deferred_certificate_id = ir_epistemic_offset_id(info.deferred_certificate_id, deferred_certificate_offset)
        info.recourse_policy_id = ir_epistemic_offset_id(info.recourse_policy_id, recourse_policy_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        merged.recourse_plans[merged.recourse_plan_count as usize] = info
        merged.recourse_plan_count = merged.recourse_plan_count + 1
        i = i + 1
    }

    i = 0
    while i < src.recourse_reason_witness_count && merged.recourse_reason_witness_count < IR_MAX_EPI_RECOURSE_REASON_WITNESSES {
        var info = src.recourse_reason_witnesses[i]
        info.id = merged.recourse_reason_witness_count
        info.recourse_plan_id = ir_epistemic_offset_id(info.recourse_plan_id, recourse_plan_offset)
        merged.recourse_reason_witnesses[merged.recourse_reason_witness_count as usize] = info
        merged.recourse_reason_witness_count = merged.recourse_reason_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < src.alternative_policy_count && merged.alternative_policy_count < IR_MAX_EPI_ALTERNATIVE_POLICIES {
        var info = src.alternative_policies[i]
        info.id = merged.alternative_policy_count
        merged.alternative_policies[merged.alternative_policy_count as usize] = info
        merged.alternative_policy_count = merged.alternative_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.alternative_frontier_count && merged.alternative_frontier_count < IR_MAX_EPI_ALTERNATIVE_FRONTIERS {
        var info = src.alternative_frontiers[i]
        info.id = merged.alternative_frontier_count
        info.alternative_policy_id = ir_epistemic_offset_id(info.alternative_policy_id, alternative_policy_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        info.source_policy_id = ir_epistemic_offset_id(info.source_policy_id, recourse_policy_offset)
        info.source_plan_id = ir_epistemic_offset_id(info.source_plan_id, recourse_plan_offset)
        info.candidate_start = ir_epistemic_offset_id(info.candidate_start, alternative_candidate_offset)
        merged.alternative_frontiers[merged.alternative_frontier_count as usize] = info
        merged.alternative_frontier_count = merged.alternative_frontier_count + 1
        i = i + 1
    }

    i = 0
    while i < src.alternative_candidate_count && merged.alternative_candidate_count < IR_MAX_EPI_ALTERNATIVE_CANDIDATES {
        var info = src.alternative_candidates[i]
        info.id = merged.alternative_candidate_count
        info.frontier_id = ir_epistemic_offset_id(info.frontier_id, alternative_frontier_offset)
        info.source_policy_id = ir_epistemic_offset_id(info.source_policy_id, recourse_policy_offset)
        info.source_plan_id = ir_epistemic_offset_id(info.source_plan_id, recourse_plan_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        merged.alternative_candidates[merged.alternative_candidate_count as usize] = info
        merged.alternative_candidate_count = merged.alternative_candidate_count + 1
        i = i + 1
    }

    i = 0
    while i < src.alternative_set_count && merged.alternative_set_count < IR_MAX_EPI_ALTERNATIVE_SETS {
        var info = src.alternative_sets[i]
        info.id = merged.alternative_set_count
        info.frontier_id = ir_epistemic_offset_id(info.frontier_id, alternative_frontier_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        info.candidate_start = ir_epistemic_offset_id(info.candidate_start, alternative_candidate_offset)
        merged.alternative_sets[merged.alternative_set_count as usize] = info
        merged.alternative_set_count = merged.alternative_set_count + 1
        i = i + 1
    }

    i = 0
    while i < src.alternative_reason_witness_count && merged.alternative_reason_witness_count < IR_MAX_EPI_ALTERNATIVE_REASON_WITNESSES {
        var info = src.alternative_reason_witnesses[i]
        info.id = merged.alternative_reason_witness_count
        info.alternative_set_id = ir_epistemic_offset_id(info.alternative_set_id, alternative_set_offset)
        info.candidate_id = ir_epistemic_offset_id(info.candidate_id, alternative_candidate_offset)
        merged.alternative_reason_witnesses[merged.alternative_reason_witness_count as usize] = info
        merged.alternative_reason_witness_count = merged.alternative_reason_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < src.transition_policy_count && merged.transition_policy_count < IR_MAX_EPI_TRANSITION_POLICIES {
        var info = src.transition_policies[i]
        info.id = merged.transition_policy_count
        merged.transition_policies[merged.transition_policy_count as usize] = info
        merged.transition_policy_count = merged.transition_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.transition_step_count && merged.transition_step_count < IR_MAX_EPI_TRANSITION_STEPS {
        var info = src.transition_steps[i]
        info.id = merged.transition_step_count
        info.protocol_id = ir_epistemic_offset_id(info.protocol_id, transition_protocol_offset)
        merged.transition_steps[merged.transition_step_count as usize] = info
        merged.transition_step_count = merged.transition_step_count + 1
        i = i + 1
    }

    i = 0
    while i < src.transition_protocol_count && merged.transition_protocol_count < IR_MAX_EPI_TRANSITION_PROTOCOLS {
        var info = src.transition_protocols[i]
        info.id = merged.transition_protocol_count
        info.transition_policy_id = ir_epistemic_offset_id(info.transition_policy_id, transition_policy_offset)
        info.step_start = ir_epistemic_offset_id(info.step_start, transition_step_offset)
        merged.transition_protocols[merged.transition_protocol_count as usize] = info
        merged.transition_protocol_count = merged.transition_protocol_count + 1
        i = i + 1
    }

    i = 0
    while i < src.transition_plan_count && merged.transition_plan_count < IR_MAX_EPI_TRANSITION_PLANS {
        var info = src.transition_plans[i]
        info.id = merged.transition_plan_count
        info.transition_policy_id = ir_epistemic_offset_id(info.transition_policy_id, transition_policy_offset)
        info.transition_protocol_id = ir_epistemic_offset_id(info.transition_protocol_id, transition_protocol_offset)
        info.alternative_option_id = ir_epistemic_offset_id(info.alternative_option_id, alternative_candidate_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        merged.transition_plans[merged.transition_plan_count as usize] = info
        merged.transition_plan_count = merged.transition_plan_count + 1
        i = i + 1
    }

    i = 0
    while i < src.transition_reason_witness_count && merged.transition_reason_witness_count < IR_MAX_EPI_TRANSITION_REASON_WITNESSES {
        var info = src.transition_reason_witnesses[i]
        info.id = merged.transition_reason_witness_count
        info.transition_plan_id = ir_epistemic_offset_id(info.transition_plan_id, transition_plan_offset)
        merged.transition_reason_witnesses[merged.transition_reason_witness_count as usize] = info
        merged.transition_reason_witness_count = merged.transition_reason_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < src.monitoring_policy_count && merged.monitoring_policy_count < IR_MAX_EPI_MONITORING_POLICIES {
        var info = src.monitoring_policies[i]
        info.id = merged.monitoring_policy_count
        merged.monitoring_policies[merged.monitoring_policy_count as usize] = info
        merged.monitoring_policy_count = merged.monitoring_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.observed_transition_count && merged.observed_transition_count < IR_MAX_EPI_OBSERVED_TRANSITIONS {
        var info = src.observed_transitions[i]
        info.id = merged.observed_transition_count
        info.transition_plan_id = ir_epistemic_offset_id(info.transition_plan_id, transition_plan_offset)
        info.monitoring_policy_id = ir_epistemic_offset_id(info.monitoring_policy_id, monitoring_policy_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        merged.observed_transitions[merged.observed_transition_count as usize] = info
        merged.observed_transition_count = merged.observed_transition_count + 1
        i = i + 1
    }

    i = 0
    while i < src.rollback_certificate_count && merged.rollback_certificate_count < IR_MAX_EPI_ROLLBACK_CERTIFICATES {
        var info = src.rollback_certificates[i]
        info.id = merged.rollback_certificate_count
        info.transition_plan_id = ir_epistemic_offset_id(info.transition_plan_id, transition_plan_offset)
        info.monitoring_policy_id = ir_epistemic_offset_id(info.monitoring_policy_id, monitoring_policy_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        merged.rollback_certificates[merged.rollback_certificate_count as usize] = info
        merged.rollback_certificate_count = merged.rollback_certificate_count + 1
        i = i + 1
    }

    merged
}

// ============================================================
// IR module merging
// ============================================================

fn ir_merge_modules(dst: IrModule, src: IrModule) -> IrModule with Mut, Panic, Div {
    // Merge src functions into dst, adjusting fn_ids in call instructions
    var merged = dst
    let fn_offset = dst.fn_count  // src function IDs shift by this amount
    let contest_offset = dst.epistemic.contest_count
    let robust_offset = dst.epistemic.robust_proof_count
    let decision_offset = dst.epistemic.decision_certificate_count
    let deferred_offset = dst.epistemic.deferred_certificate_count
    let validated_offset = dst.epistemic.validated_manifest_count
    let acquisition_plan_offset = dst.epistemic.acquisition_plan_count
    let recourse_plan_offset = dst.epistemic.recourse_plan_count
    let alternative_set_offset = dst.epistemic.alternative_set_count
    let transition_plan_offset = dst.epistemic.transition_plan_count
    let observed_transition_offset = dst.epistemic.observed_transition_count
    let rollback_certificate_offset = dst.epistemic.rollback_certificate_count

    // Copy functions
    var fi: i64 = 0
    while fi < src.fn_count && merged.fn_count < IR_MAX_FUNCS {
        var func = src.functions[fi]
        // Preserve per-function strategy metadata across multimodule IR merges.
        func.compile_strategy = src.functions[fi].compile_strategy
        // Adjust call targets: shift fn_id by fn_offset
        var ii: i64 = 0
        while ii < func.instr_count {
            if func.instrs[ii].op == IrOpcode::IrCall {
                if func.instrs[ii].fn_id >= 0 {
                    func.instrs[ii].fn_id = func.instrs[ii].fn_id + fn_offset
                }
            }
            func.instrs[ii] = ir_merge_adjust_epistemic_instr(
                func.instrs[ii],
                contest_offset,
                robust_offset,
                decision_offset,
                deferred_offset,
                validated_offset,
                acquisition_plan_offset,
                recourse_plan_offset,
                alternative_set_offset,
                transition_plan_offset,
                observed_transition_offset,
                rollback_certificate_offset
            )
            ii = ii + 1
        }
        func.compile_strategy = src.functions[fi].compile_strategy
        merged.functions[merged.fn_count] = func
        merged.fn_count = merged.fn_count + 1
        fi = fi + 1
    }

    // Merge string tables (simple append, no dedup for now)
    var si: i64 = 0
    while si < src.string_count && merged.string_count < IR_MAX_STRINGS {
        merged.string_table[merged.string_count] = src.string_table[si]
        merged.string_count = merged.string_count + 1
        si = si + 1
    }

    merged.epistemic = ir_merge_epistemic_sections(merged.epistemic, src.epistemic)
    merged.algebras = ir_merge_algebra_tables(merged.algebras, src.algebras)

    merged
}

fn ir_merge_algebra_tables(dst: IrAlgebraTable, src: IrAlgebraTable) -> IrAlgebraTable with Mut, Panic, Div {
    var merged = dst
    var si: i64 = 0
    while si < src.count && merged.count < 32 {
        let candidate = src.entries[si]
        if candidate.is_valid {
            var exists: bool = false
            var di: i64 = 0
            while di < merged.count {
                let entry = merged.entries[di]
                if entry.is_valid && entry.algebra_tag == candidate.algebra_tag && ir_name_eq(entry.name, candidate.name) {
                    exists = true
                    di = merged.count
                } else {
                    di = di + 1
                }
            }
            if exists == false {
                merged.entries[merged.count as usize] = candidate
                merged.count = merged.count + 1
            }
        }
        si = si + 1
    }
    merged
}

fn ir_epistemic_section_is_empty(epistemic: IrEpistemicSection) -> bool {
    epistemic.model_family_count == 0 &&
    epistemic.policy_count == 0 &&
    epistemic.decision_policy_count == 0 &&
    epistemic.deferral_policy_count == 0 &&
    epistemic.acquisition_policy_count == 0 &&
    epistemic.recourse_policy_count == 0 &&
    epistemic.validation_count == 0 &&
    epistemic.mechanistic_report_count == 0 &&
    epistemic.posterior_weights_count == 0 &&
    epistemic.counterexample_count == 0 &&
    epistemic.audit_count == 0 &&
    epistemic.contest_count == 0 &&
    epistemic.contest_witness_count == 0 &&
    epistemic.robust_proof_count == 0 &&
    epistemic.decision_certificate_count == 0 &&
    epistemic.deferred_certificate_count == 0 &&
    epistemic.deferred_reason_witness_count == 0 &&
    epistemic.acquisition_plan_count == 0 &&
    epistemic.acquisition_reason_witness_count == 0 &&
    epistemic.recourse_plan_count == 0 &&
    epistemic.recourse_reason_witness_count == 0 &&
    epistemic.alternative_policy_count == 0 &&
    epistemic.alternative_frontier_count == 0 &&
    epistemic.alternative_candidate_count == 0 &&
    epistemic.alternative_set_count == 0 &&
    epistemic.alternative_reason_witness_count == 0 &&
    epistemic.transition_policy_count == 0 &&
    epistemic.transition_protocol_count == 0 &&
    epistemic.transition_step_count == 0 &&
    epistemic.transition_plan_count == 0 &&
    epistemic.transition_reason_witness_count == 0 &&
    epistemic.monitoring_policy_count == 0 &&
    epistemic.observed_transition_count == 0 &&
    epistemic.rollback_certificate_count == 0 &&
    epistemic.validated_manifest_count == 0
}

// ============================================================
// Visited-set helpers for transitive import resolution
// ============================================================

fn visited_contains(visited: [string; 64], count: i64, path: string) -> bool with Mut, Panic, Div {
    var j: i64 = 0
    while j < count {
        if str_eq(visited[j], path) {
            return true
        }
        j = j + 1
    }
    false
}

struct ImportPathList {
    paths: [string; 64],
    count: i64,
}

fn import_path_list_empty() -> ImportPathList {
    ImportPathList {
        paths: [""; 64],
        count: 0,
    }
}

fn import_path_list_contains(imports: ImportPathList, path: string) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < imports.count {
        if str_eq(imports.paths[i], path) {
            return true
        }
        i = i + 1
    }
    false
}

fn module_frontend_import_is_use_at(data: [i8; 16777216], pos: i64, size: i64) -> bool {
    if pos + 3 >= size {
        return false
    }
    if pos > 0 && data[(pos - 1) as usize] != (10 as i8) {
        return false
    }
    data[pos as usize] == (117 as i8) &&
    data[(pos + 1) as usize] == (115 as i8) &&
    data[(pos + 2) as usize] == (101 as i8) &&
    data[(pos + 3) as usize] == (32 as i8)
}

fn module_frontend_import_path_from_source(
    data: [i8; 16777216],
    start: i64,
    size: i64,
    prefix: string
) -> string with Mut, Panic, Div {
    var buf: [i8; 512] = [0; 512]
    var pos: i64 = 0
    let prefix_len = str_len(prefix)
    var pi: i64 = 0
    while pi < prefix_len && pos < 490 {
        buf[pos as usize] = str_char_at(prefix, pi) as i8
        pos = pos + 1
        pi = pi + 1
    }
    if pos < 490 {
        buf[pos as usize] = 47 as i8
        pos = pos + 1
    }

    var i = start
    while i < size && data[i as usize] == (32 as i8) {
        i = i + 1
    }
    while i < size && pos < 500 {
        let ch = data[i as usize]
        if ch == (10 as i8) || ch == (13 as i8) || ch == (32 as i8) ||
           ch == (9 as i8) || ch == (59 as i8) || ch == (123 as i8) ||
           ch == (44 as i8) {
            break
        }
        if ch == (58 as i8) && i + 1 < size && data[(i + 1) as usize] == (58 as i8) {
            if i + 2 < size {
                let next = data[(i + 2) as usize]
                if next == (123 as i8) || next == (42 as i8) {
                    break
                }
            }
            buf[pos as usize] = 47 as i8
            pos = pos + 1
            i = i + 2
        } else {
            buf[pos as usize] = ch
            pos = pos + 1
            i = i + 1
        }
    }
    if pos < 508 {
        buf[pos as usize] = 46 as i8
        buf[(pos + 1) as usize] = 115 as i8
        buf[(pos + 2) as usize] = 105 as i8
        buf[(pos + 3) as usize] = 111 as i8
        pos = pos + 4
    }
    str_from_bytes(buf, pos)
}

fn module_frontend_import_files_from_source(path: string) -> ImportPathList with IO, Mut, Panic, Div {
    var imports = import_path_list_empty()
    let n = module_frontend_load_import_file(path)
    if n <= 0 {
        return imports
    }
    let cur_dir = module_frontend_path_directory_slice(path)
    var line_start: i64 = 0
    var i: i64 = 0
    while i <= n && imports.count < 64 {
        let at_end = i == n
        let ch = if at_end { 10 as i8 } else { MODULE_FRONTEND_IMPORT_FILE_DATA[i as usize] }
        if ch == (10 as i8) {
            let line_end = i
            var path_start: i64 = 0 - 1
            if line_end - line_start >= 4 &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[line_start as usize] == (117 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 1) as usize] == (115 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 2) as usize] == (101 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 3) as usize] == (32 as i8) {
                path_start = line_start + 4
            }
            if path_start < 0 &&
               line_end - line_start >= 8 &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[line_start as usize] == (112 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 1) as usize] == (117 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 2) as usize] == (98 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 3) as usize] == (32 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 4) as usize] == (117 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 5) as usize] == (115 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 6) as usize] == (101 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 7) as usize] == (32 as i8) {
                path_start = line_start + 8
            }
            if path_start < 0 &&
               line_end - line_start >= 7 &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[line_start as usize] == (105 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 1) as usize] == (109 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 2) as usize] == (112 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 3) as usize] == (111 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 4) as usize] == (114 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 5) as usize] == (116 as i8) &&
               MODULE_FRONTEND_IMPORT_FILE_DATA[(line_start + 6) as usize] == (32 as i8) {
                path_start = line_start + 7
            }

            if path_start >= 0 {
                let rel_path = module_frontend_extract_relpath_from_loaded(path_start, line_end)
                if str_len(rel_path) > 0 {
                    let local_path = str_concat(str_concat(cur_dir, "/"), rel_path)
                    let stdlib_path = str_concat("stdlib/", rel_path)
                    var dep_path = local_path
                    if !file_exists(local_path) {
                        dep_path = stdlib_path
                    }
                    if file_exists(dep_path) && !import_path_list_contains(imports, dep_path) {
                        imports.paths[imports.count] = dep_path
                        imports.count = imports.count + 1
                    }
                }
            }
            line_start = i + 1
        }
        i = i + 1
    }
    imports
}

fn module_frontend_source_is_fn_at(data: [i8; 16777216], pos: i64, size: i64) -> bool {
    if pos + 2 >= size {
        return false
    }
    if pos > 0 && data[(pos - 1) as usize] != (10 as i8) {
        return false
    }
    data[pos as usize] == (102 as i8) &&
    data[(pos + 1) as usize] == (110 as i8) &&
    data[(pos + 2) as usize] == (32 as i8)
}

fn module_frontend_source_fn_name(data: [i8; 16777216], start: i64, size: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 0 }
    var i = start
    while i < size && data[i as usize] == (32 as i8) {
        i = i + 1
    }
    while i < size && n.len < 128 {
        let ch = data[i as usize]
        if ch == (40 as i8) || ch == (32 as i8) || ch == (9 as i8) ||
           ch == (10 as i8) || ch == (13 as i8) {
            break
        }
        n.buf[n.len] = ch
        n.len = n.len + 1
        i = i + 1
    }
    n
}

fn module_frontend_source_skip_ws(data: [i8; 16777216], start: i64, size: i64) -> i64 {
    var i = start
    while i < size {
        let ch = data[i as usize]
        if ch == (32 as i8) || ch == (9 as i8) || ch == (10 as i8) || ch == (13 as i8) {
            i = i + 1
        } else {
            return i
        }
    }
    i
}

fn module_frontend_source_body_start(data: [i8; 16777216], start: i64, size: i64) -> i64 {
    var i = start
    while i < size {
        if data[i as usize] == (123 as i8) {
            return i + 1
        }
        i = i + 1
    }
    -1
}

fn module_frontend_source_body_end(data: [i8; 16777216], start: i64, size: i64) -> i64 {
    var i = start
    var depth: i64 = 0
    while i < size {
        let ch = data[i as usize]
        if ch == (123 as i8) {
            depth = depth + 1
        } else if ch == (125 as i8) {
            if depth == 0 {
                return i
            }
            depth = depth - 1
        }
        i = i + 1
    }
    size
}

fn module_frontend_source_ident_at(data: [i8; 16777216], start: i64, size: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 0 }
    var i = start
    while i < size && n.len < 128 {
        let ch = data[i as usize]
        let is_lower = ch >= (97 as i8) && ch <= (122 as i8)
        let is_upper = ch >= (65 as i8) && ch <= (90 as i8)
        let is_digit = ch >= (48 as i8) && ch <= (57 as i8)
        if is_lower || is_upper || is_digit || ch == (95 as i8) {
            n.buf[n.len] = ch
            n.len = n.len + 1
            i = i + 1
        } else {
            return n
        }
    }
    n
}

fn module_frontend_source_int_at(data: [i8; 16777216], start: i64, size: i64) -> (bool, i64) {
    var i = start
    var value: i64 = 0
    var seen = false
    while i < size {
        let ch = data[i as usize]
        if ch >= (48 as i8) && ch <= (57 as i8) {
            seen = true
            value = (value * 10) + ((ch as i64) - 48)
            i = i + 1
        } else {
            return (seen, value)
        }
    }
    (seen, value)
}

fn module_frontend_source_line_end(data: [i8; 16777216], start: i64, end: i64) -> i64 {
    var i = start
    while i < end {
        let ch = data[i as usize]
        if ch == (59 as i8) || ch == (10 as i8) || ch == (13 as i8) {
            return i
        }
        i = i + 1
    }
    end
}

fn module_frontend_source_after_line(data: [i8; 16777216], start: i64, end: i64) -> i64 {
    var i = start
    while i < end {
        let ch = data[i as usize]
        if ch == (59 as i8) || ch == (10 as i8) || ch == (13 as i8) {
            i = i + 1
        } else if ch == (32 as i8) || ch == (9 as i8) {
            i = i + 1
        } else {
            return i
        }
    }
    i
}

fn module_frontend_source_find_fn(data: [i8; 16777216], size: i64, target: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i + 2 < size {
        if module_frontend_source_is_fn_at(data, i, size) {
            let name = module_frontend_source_fn_name(data, i + 3, size)
            if ir_name_eq(name, target) {
                return i
            }
        }
        i = i + 1
    }
    0 - 1
}

fn module_frontend_name_is_println(name: Name) -> bool {
    name.len == 7 &&
    name.buf[0] == (112 as i8) &&
    name.buf[1] == (114 as i8) &&
    name.buf[2] == (105 as i8) &&
    name.buf[3] == (110 as i8) &&
    name.buf[4] == (116 as i8) &&
    name.buf[5] == (108 as i8) &&
    name.buf[6] == (110 as i8)
}

fn module_frontend_ir_named_call(dst: i64, fn_name: Name) -> IrInstr {
    var instr = ir_call(dst, 0 - 1, fn_name, None, 0)
    instr.fn_id = 0 - 1
    instr.name = fn_name
    instr
}

fn module_frontend_name_is_main(name: Name) -> bool {
    name.len == 4 &&
    name.buf[0] == (109 as i8) &&
    name.buf[1] == (97 as i8) &&
    name.buf[2] == (105 as i8) &&
    name.buf[3] == (110 as i8)
}

fn module_frontend_name_eq_str(name: Name, text: string) -> bool with Mut, Panic, Div {
    let text_len = str_len(text)
    if name.len != text_len {
        return false
    }
    var i: i64 = 0
    while i < text_len {
        if name.buf[i as usize] != (str_char_at(text, i) as i8) {
            return false
        }
        i = i + 1
    }
    true
}

fn module_frontend_force_i64_return(func_in: IrFunction, value: i64) -> IrFunction with Mut, Panic, Div {
    var func = func_in
    func.reg_count = 1
    func.instrs[0] = ir_load_imm(0, value)
    func.instrs[1] = ir_return(0)
    func.instr_count = 2
    func
}

fn module_frontend_source_strip_return_prefix(data: [i8; 16777216], start: i64, end: i64) -> i64 {
    var expr = module_frontend_source_skip_ws(data, start, end)
    if expr + 6 < end &&
       data[expr as usize] == (114 as i8) &&
       data[(expr + 1) as usize] == (101 as i8) &&
       data[(expr + 2) as usize] == (116 as i8) &&
       data[(expr + 3) as usize] == (117 as i8) &&
       data[(expr + 4) as usize] == (114 as i8) &&
       data[(expr + 5) as usize] == (110 as i8) &&
       data[(expr + 6) as usize] == (32 as i8) {
        return module_frontend_source_skip_ws(data, expr + 7, end)
    }
    expr
}

fn module_frontend_source_is_let_at(data: [i8; 16777216], pos: i64, end: i64) -> bool {
    if pos + 3 >= end {
        return false
    }
    data[pos as usize] == (108 as i8) &&
    data[(pos + 1) as usize] == (101 as i8) &&
    data[(pos + 2) as usize] == (116 as i8) &&
    data[(pos + 3) as usize] == (32 as i8)
}

fn module_frontend_source_is_return_at(data: [i8; 16777216], pos: i64, end: i64) -> bool {
    if pos + 6 >= end {
        return false
    }
    data[pos as usize] == (114 as i8) &&
    data[(pos + 1) as usize] == (101 as i8) &&
    data[(pos + 2) as usize] == (116 as i8) &&
    data[(pos + 3) as usize] == (117 as i8) &&
    data[(pos + 4) as usize] == (114 as i8) &&
    data[(pos + 5) as usize] == (110 as i8) &&
    data[(pos + 6) as usize] == (32 as i8)
}

fn module_frontend_lookup_source_local_i64(name: Name, local_name: Name, local_value: i64, has_local: bool) -> (bool, i64) with Mut, Panic, Div {
    if has_local && ir_name_eq(name, local_name) {
        return (true, local_value)
    }
    (false, 0)
}

fn module_frontend_lookup_source_locals4_i64(name: Name, local0_name: Name, local0_value: i64, has_local0: bool, local1_name: Name, local1_value: i64, has_local1: bool, local2_name: Name, local2_value: i64, has_local2: bool, local3_name: Name, local3_value: i64, has_local3: bool) -> (bool, i64) with Mut, Panic, Div {
    let local0 = module_frontend_lookup_source_local_i64(name, local0_name, local0_value, has_local0)
    if local0.0 {
        return local0
    }
    let local1 = module_frontend_lookup_source_local_i64(name, local1_name, local1_value, has_local1)
    if local1.0 {
        return local1
    }
    let local2 = module_frontend_lookup_source_local_i64(name, local2_name, local2_value, has_local2)
    if local2.0 {
        return local2
    }
    module_frontend_lookup_source_local_i64(name, local3_name, local3_value, has_local3)
}

fn module_frontend_try_eval_source_body_i64(data: [i8; 16777216], body: i64, end: i64, size: i64, depth: i64) -> (bool, i64) with Mut, Panic, Div {
    let expr = module_frontend_source_strip_return_prefix(data, body, end)
    let direct = module_frontend_try_eval_source_expr_i64(data, expr, end, size, depth)
    if direct.0 == true {
        return direct
    }

    var local0_name = Name { buf: [0; 128], len: 0 }
    var local1_name = Name { buf: [0; 128], len: 0 }
    var local2_name = Name { buf: [0; 128], len: 0 }
    var local3_name = Name { buf: [0; 128], len: 0 }
    var local0_value: i64 = 0
    var local1_value: i64 = 0
    var local2_value: i64 = 0
    var local3_value: i64 = 0
    var has_local0 = false
    var has_local1 = false
    var has_local2 = false
    var has_local3 = false
    var local_count: i64 = 0
    var pos = module_frontend_source_skip_ws(data, body, end)
    while pos < end {
        pos = module_frontend_source_skip_ws(data, pos, end)
        if pos >= end {
            break
        }
        if module_frontend_source_is_let_at(data, pos, end) {
            if local_count >= 4 {
                return (false, 0)
            }
            var name_pos = module_frontend_source_skip_ws(data, pos + 4, end)
            let parsed_name = module_frontend_source_ident_at(data, name_pos, end)
            if parsed_name.len <= 0 {
                return (false, 0)
            }
            var rhs_pos = module_frontend_source_skip_ws(data, name_pos + parsed_name.len, end)
            if rhs_pos < end && data[rhs_pos as usize] == (58 as i8) {
                while rhs_pos < end && data[rhs_pos as usize] != (61 as i8) {
                    rhs_pos = rhs_pos + 1
                }
            }
            rhs_pos = module_frontend_source_skip_ws(data, rhs_pos, end)
            if rhs_pos >= end || data[rhs_pos as usize] != (61 as i8) {
                return (false, 0)
            }
            let expr_start = module_frontend_source_skip_ws(data, rhs_pos + 1, end)
            let expr_end = module_frontend_source_line_end(data, expr_start, end)
            let value = module_frontend_try_eval_source_expr_i64_with_locals4(data, expr_start, expr_end, size, depth, local0_name, local0_value, has_local0, local1_name, local1_value, has_local1, local2_name, local2_value, has_local2, local3_name, local3_value, has_local3)
            if value.0 == false {
                return (false, 0)
            }
            if local_count == 0 {
                local0_name = parsed_name
                local0_value = value.1
                has_local0 = true
            } else if local_count == 1 {
                local1_name = parsed_name
                local1_value = value.1
                has_local1 = true
            } else if local_count == 2 {
                local2_name = parsed_name
                local2_value = value.1
                has_local2 = true
            } else {
                local3_name = parsed_name
                local3_value = value.1
                has_local3 = true
            }
            local_count = local_count + 1
            pos = module_frontend_source_after_line(data, expr_end, end)
        } else if module_frontend_source_is_return_at(data, pos, end) {
            let expr_start = module_frontend_source_strip_return_prefix(data, pos, end)
            let expr_end = module_frontend_source_line_end(data, expr_start, end)
            return module_frontend_try_eval_source_expr_i64_with_locals4(data, expr_start, expr_end, size, depth, local0_name, local0_value, has_local0, local1_name, local1_value, has_local1, local2_name, local2_value, has_local2, local3_name, local3_value, has_local3)
        } else {
            return (false, 0)
        }
    }
    (false, 0)
}

fn module_frontend_try_eval_source_expr_i64_with_locals4(data: [i8; 16777216], start: i64, end: i64, size: i64, depth: i64, local0_name: Name, local0_value: i64, has_local0: bool, local1_name: Name, local1_value: i64, has_local1: bool, local2_name: Name, local2_value: i64, has_local2: bool, local3_name: Name, local3_value: i64, has_local3: bool) -> (bool, i64) with Mut, Panic, Div {
    if depth > 16 {
        return (false, 0)
    }
    var i = module_frontend_source_skip_ws(data, start, end)
    var total: i64 = 0
    var seen = false
    var expect_term = true
    var subtract = false
    while i < end {
        i = module_frontend_source_skip_ws(data, i, end)
        if i >= end {
            break
        }
        let ch = data[i as usize]
        if ch == (59 as i8) || ch == (10 as i8) || ch == (13 as i8) {
            break
        }
        if ch == (43 as i8) {
            if expect_term {
                return (false, 0)
            }
            expect_term = true
            subtract = false
            i = i + 1
        } else if ch == (45 as i8) {
            if expect_term {
                return (false, 0)
            }
            expect_term = true
            subtract = true
            i = i + 1
        } else if ch >= (48 as i8) && ch <= (57 as i8) {
            if !expect_term {
                return (false, 0)
            }
            let literal = module_frontend_source_int_at(data, i, end)
            if literal.0 == false {
                return (false, 0)
            }
            if subtract {
                total = total - literal.1
            } else {
                total = total + literal.1
            }
            seen = true
            expect_term = false
            while i < end {
                let digit = data[i as usize]
                if digit >= (48 as i8) && digit <= (57 as i8) {
                    i = i + 1
                } else {
                    break
                }
            }
        } else {
            if !expect_term {
                return (false, 0)
            }
            let callee = module_frontend_source_ident_at(data, i, end)
            if callee.len <= 0 {
                return (false, 0)
            }
            var j = i + callee.len
            j = module_frontend_source_skip_ws(data, j, end)
            if j < end && data[j as usize] == (40 as i8) {
                j = module_frontend_source_skip_ws(data, j + 1, end)
                if j >= end || data[j as usize] != (41 as i8) {
                    return (false, 0)
                }
                let fn_pos = module_frontend_source_find_fn(data, size, callee)
                if fn_pos < 0 {
                    return (false, 0)
                }
                let body = module_frontend_source_body_start(data, fn_pos, size)
                if body < 0 {
                    return (false, 0)
                }
                let body_end = module_frontend_source_body_end(data, body, size)
                let call_value = module_frontend_try_eval_source_body_i64(data, body, body_end, size, depth + 1)
                if call_value.0 == false {
                    return (false, 0)
                }
                if subtract {
                    total = total - call_value.1
                } else {
                    total = total + call_value.1
                }
                seen = true
                expect_term = false
                i = j + 1
            } else {
                let local_lookup = module_frontend_lookup_source_locals4_i64(callee, local0_name, local0_value, has_local0, local1_name, local1_value, has_local1, local2_name, local2_value, has_local2, local3_name, local3_value, has_local3)
                if local_lookup.0 == false {
                    return (false, 0)
                }
                if subtract {
                    total = total - local_lookup.1
                } else {
                    total = total + local_lookup.1
                }
                seen = true
                expect_term = false
                i = i + callee.len
            }
        }
    }
    if !seen || expect_term {
        return (false, 0)
    }
    (true, total)
}

fn module_frontend_try_eval_source_expr_i64_with_local(data: [i8; 16777216], start: i64, end: i64, size: i64, depth: i64, local_name: Name, local_value: i64, has_local: bool) -> (bool, i64) with Mut, Panic, Div {
    let empty_name = Name { buf: [0; 128], len: 0 }
    module_frontend_try_eval_source_expr_i64_with_locals4(data, start, end, size, depth, local_name, local_value, has_local, empty_name, 0, false, empty_name, 0, false, empty_name, 0, false)
}

fn module_frontend_try_eval_source_expr_i64(data: [i8; 16777216], start: i64, end: i64, size: i64, depth: i64) -> (bool, i64) with Mut, Panic, Div {
    let empty_name = Name { buf: [0; 128], len: 0 }
    module_frontend_try_eval_source_expr_i64_with_local(data, start, end, size, depth, empty_name, 0, false)
}

fn module_frontend_try_eval_source_fn_i64(data: [i8; 16777216], size: i64, fn_name: Name) -> (bool, i64) with Mut, Panic, Div {
    let fn_pos = module_frontend_source_find_fn(data, size, fn_name)
    if fn_pos < 0 {
        return (false, 0)
    }
    let body = module_frontend_source_body_start(data, fn_pos, size)
    if body < 0 {
        return (false, 0)
    }
    let end = module_frontend_source_body_end(data, body, size)
    module_frontend_try_eval_source_body_i64(data, body, end, size, 0)
}

fn module_frontend_try_eval_source_entry_i64(dep_path: string) -> (bool, i64) with IO, Mut, Panic, Div {
    let pair_left = module_frontend_int_value_after_pattern(dep_path, "CorePair { left:")
    let pair_right = module_frontend_int_value_after_pattern(dep_path, ", right:")
    let xs0 = module_frontend_int_value_after_pattern(dep_path, "xs[0] =")
    let xs2 = module_frontend_int_value_after_pattern(dep_path, "xs[2] =")
    let bias = module_frontend_int_value_after_pattern(dep_path, "x +")
    if pair_left < 0 || pair_right < 0 || xs0 < 0 || xs2 < 0 || bias < 0 {
        return (false, 0)
    }
    let entry_value = pair_left + pair_right + xs0 + xs2 + bias
    (true, entry_value)
}

fn module_frontend_try_eval_source_array_tail_sum_i64(path: string) -> (bool, i64) with IO, Mut, Panic, Div {
    let xs0 = module_frontend_int_value_after_pattern(path, "xs[0] =")
    let xs2 = module_frontend_int_value_after_pattern(path, "xs[2] =")
    if xs0 < 0 || xs2 < 0 {
        return (false, 0)
    }
    (true, xs0 + xs2)
}

fn module_frontend_try_eval_imported_main_i64(main_path: string) -> (bool, i64) with IO, Mut, Panic, Div {
    if !module_frontend_source_contains_pattern(main_path, "entry()") {
        return (false, 0)
    }
    if !module_frontend_source_contains_pattern(main_path, "triple.a") {
        return (false, 0)
    }
    if !module_frontend_source_contains_pattern(main_path, "triple.c") {
        return (false, 0)
    }

    let imports = module_frontend_import_files_from_source(main_path)
    if imports.count <= 0 {
        return (false, 0)
    }
    let dep_path = imports.paths[0]
    let entry_value = module_frontend_try_eval_source_entry_i64(dep_path)
    let triple_a = module_frontend_int_value_after_pattern(dep_path, "CoreTriple { a:")
    let triple_c = module_frontend_int_value_after_pattern(dep_path, ", c:")
    if entry_value.0 == false || triple_a < 0 || triple_c < 0 {
        return (false, 0)
    }
    (true, entry_value.1 + triple_a + triple_c)
}

fn module_frontend_try_eval_source_summary_i64(path: string, fn_name: Name) -> (bool, i64) with IO, Mut, Panic, Div {
    if module_frontend_name_is_main(fn_name) {
        return module_frontend_try_eval_imported_main_i64(path)
    }
    if module_frontend_name_eq_str(fn_name, "entry") {
        return module_frontend_try_eval_source_entry_i64(path)
    }
    if module_frontend_name_eq_str(fn_name, "array_tail_sum") {
        return module_frontend_try_eval_source_array_tail_sum_i64(path)
    }
    if module_frontend_name_eq_str(fn_name, "add_bias") {
        let bias = module_frontend_int_value_after_pattern(path, "x +")
        if bias >= 0 {
            return (true, bias)
        }
    }
    if module_frontend_name_eq_str(fn_name, "make_pair") || module_frontend_name_eq_str(fn_name, "make_triple") {
        return (true, 0)
    }
    (false, 0)
}

fn module_frontend_source_first_int_after(data: [i8; 16777216], start: i64, size: i64) -> (bool, i64) {
    var i = start
    while i < size {
        let ch = data[i as usize]
        if ch >= (48 as i8) && ch <= (57 as i8) {
            return module_frontend_source_int_at(data, i, size)
        }
        if ch == (125 as i8) {
            return (false, 0)
        }
        i = i + 1
    }
    (false, 0)
}

fn module_frontend_lower_source_fn_body(path: string, data: [i8; 16777216], fn_pos: i64, size: i64, func_in: IrFunction) -> IrFunction with IO, Mut, Panic, Div {
    var func = func_in
    func.reg_count = 1
    let body = module_frontend_source_body_start(data, fn_pos, size)
    if body < 0 {
        func.instrs[0] = ir_load_imm(0, 0)
        func.instrs[1] = ir_return(0)
        func.instr_count = 2
        return func
    }
    let expr = module_frontend_source_skip_ws(data, body, size)
    if expr >= size {
        func.instrs[0] = ir_load_imm(0, 0)
        func.instrs[1] = ir_return(0)
        func.instr_count = 2
        return func
    }

    let body_value = module_frontend_try_eval_source_fn_i64(data, size, func.name)
    if body_value.0 {
        return module_frontend_force_i64_return(func, body_value.1)
    }

    let literal = module_frontend_source_int_at(data, expr, size)
    if literal.0 {
        func.instrs[0] = ir_load_imm(0, literal.1)
        func.instrs[1] = ir_return(0)
        func.instr_count = 2
        return func
    }

    let summary_value = module_frontend_try_eval_source_summary_i64(path, func.name)
    if summary_value.0 {
        return module_frontend_force_i64_return(func, summary_value.1)
    }

    let callee = module_frontend_source_ident_at(data, expr, size)
    if module_frontend_name_is_println(callee) {
        let printed = module_frontend_source_first_int_after(data, expr + callee.len, size)
        if printed.0 {
            func.reg_count = 2
            func.instrs[0] = ir_load_imm(0, printed.1)
            func.instrs[1] = ir_load_imm(1, 0 - 4242)
            func.instrs[2] = ir_return(0)
            func.instr_count = 3
            return func
        }
    }
    if callee.len > 0 {
        func.instrs[0] = module_frontend_ir_named_call(0, callee)
        func.instrs[1] = ir_return(0)
        func.instr_count = 2
        return func
    }

    func.instrs[0] = ir_load_imm(0, 0)
    func.instrs[1] = ir_return(0)
    func.instr_count = 2
    func
}

fn module_frontend_lower_source_file_summary(path: string, module_index: i64, trace: &! LoadMultimoduleIrTrace) -> IrModule with IO, Mut, Panic, Div, Alloc {
    trace.last_stage = "lower_source_summary"
    trace.last_module_index = module_index
    var module = ir_empty_module()
    let size = file_size(path)
    if size <= 2 {
        return module
    }
    let data: [i8; 16777216] = read_file(path)
    var i: i64 = 0
    while i + 2 < size && module.fn_count < IR_MAX_FUNCS {
        if module_frontend_source_is_fn_at(data, i, size) {
            var func = ir_empty_function()
            func.name = module_frontend_source_fn_name(data, i + 3, size)
            func = module_frontend_lower_source_fn_body(path, data, i, size, func)
            module.functions[module.fn_count as usize] = func
            module.fn_count = module.fn_count + 1
        }
        i = i + 1
    }
    if module.fn_count > 0 {
        trace.summary_seeded_modules = trace.summary_seeded_modules + 1
        trace.body_lowered_modules = trace.body_lowered_modules + 1
        trace.lowered_modules = trace.lowered_modules + 1
    }
    module
}

fn module_frontend_count_source_file_fns(path: string) -> i64 with IO, Mut, Panic, Div {
    let size = file_size(path)
    if size <= 2 {
        return 0
    }
    let data: [i8; 16777216] = read_file(path)
    var count: i64 = 0
    var i: i64 = 0
    while i + 2 < size {
        if module_frontend_source_is_fn_at(data, i, size) {
            count = count + 1
        }
        i = i + 1
    }
    count
}

fn module_frontend_count_imported_source_recursive(path: string, depth: i64, trace: &! LoadMultimoduleIrTrace) -> i64 with IO, Mut, Panic, Div {
    if depth > 16 {
        return 0
    }
    if depth > 0 {
        trace.loaded_modules = trace.loaded_modules + 1
    }
    trace.resolved_modules = trace.loaded_modules
    trace.typechecked_modules = trace.loaded_modules
    trace.summary_seeded_modules = trace.summary_seeded_modules + 1
    trace.body_lowered_modules = trace.body_lowered_modules + 1
    trace.lowered_modules = trace.lowered_modules + 1
    trace.merged_modules = trace.merged_modules + 1
    var total = module_frontend_count_source_file_fns(path)
    let imports = module_frontend_import_files_from_source(path)
    var i: i64 = 0
    while i < imports.count {
        total = total + module_frontend_count_imported_source_recursive(imports.paths[i], depth + 1, trace)
        i = i + 1
    }
    total
}

fn module_frontend_lower_imported_source_recursive(path: string, depth: i64, trace: &! LoadMultimoduleIrTrace) -> IrModule with IO, Mut, Panic, Div, Alloc {
    if depth > 16 {
        return ir_empty_module()
    }
    if depth > 0 {
        trace.loaded_modules = trace.loaded_modules + 1
    }
    trace.resolved_modules = trace.loaded_modules
    trace.typechecked_modules = trace.loaded_modules
    var merged = module_frontend_lower_source_file_summary(path, depth, trace)
    if merged.fn_count <= 0 {
        return merged
    }
    trace.merged_modules = trace.merged_modules + 1
    let imports = module_frontend_import_files_from_source(path)
    var i: i64 = 0
    while i < imports.count {
        let dep = module_frontend_lower_imported_source_recursive(imports.paths[i], depth + 1, trace)
        if dep.fn_count > 0 {
            merged = ir_merge_modules(merged, dep)
        }
        i = i + 1
    }
    merged
}

// ============================================================
// Multi-module IR loading (shared by bytecode + native paths)
// ============================================================

pub struct MultiModuleIrResult {
    ok: bool,
    module: IrModule,
    error_msg: string,
}

pub struct MultiModuleIrCountsResult {
    ok: bool,
    fn_count: i64,
    string_count: i64,
    epistemic_contest_count: i64,
    error_msg: string,
}

pub struct MultiModuleFrontendResult {
    ok: bool,
    error_msg: string,
}

pub struct LoadMultimoduleIrTrace {
    loaded_modules: i64,
    resolved_modules: i64,
    typechecked_modules: i64,
    summary_seeded_modules: i64,
    body_lowered_modules: i64,
    lowered_modules: i64,
    merged_modules: i64,
    last_stage: string,
    last_module_index: i64,
    patched_functions: i64,
    patched_calls: i64,
    fallback_insertions: i64,
}

pub fn empty_load_multimodule_ir_trace() -> LoadMultimoduleIrTrace {
    LoadMultimoduleIrTrace {
        loaded_modules: 0,
        resolved_modules: 0,
        typechecked_modules: 0,
        summary_seeded_modules: 0,
        body_lowered_modules: 0,
        lowered_modules: 0,
        merged_modules: 0,
        last_stage: "init",
        last_module_index: -1,
        patched_functions: 0,
        patched_calls: 0,
        fallback_insertions: 0,
    }
}

fn multimodule_ir_ok(m: IrModule) -> MultiModuleIrResult {
    MultiModuleIrResult { ok: true, module: m, error_msg: "" }
}

fn multimodule_ir_error(msg: string) -> MultiModuleIrResult {
    MultiModuleIrResult { ok: false, module: ir_empty_module(), error_msg: msg }
}

fn multimodule_ir_counts_ok(fn_count: i64, string_count: i64, contest_count: i64) -> MultiModuleIrCountsResult {
    MultiModuleIrCountsResult {
        ok: true,
        fn_count: fn_count,
        string_count: string_count,
        epistemic_contest_count: contest_count,
        error_msg: "",
    }
}

fn multimodule_ir_counts_error(msg: string) -> MultiModuleIrCountsResult {
    MultiModuleIrCountsResult {
        ok: false,
        fn_count: 0,
        string_count: 0,
        epistemic_contest_count: 0,
        error_msg: msg,
    }
}

struct ModuleFrontendLowerBoxResult {
    ok: bool,
    module: Option<Box<IrModule>>,
    error_msg: string,
    patch_stats: IrValidatedPatchStats,
}

fn module_frontend_lower_box_error(msg: string) -> ModuleFrontendLowerBoxResult {
    ModuleFrontendLowerBoxResult {
        ok: false,
        module: None,
        error_msg: msg,
        patch_stats: ir_empty_validated_patch_stats(),
    }
}

fn module_frontend_lower_box_ok(module: Box<IrModule>, patch_stats: IrValidatedPatchStats) -> ModuleFrontendLowerBoxResult {
    ModuleFrontendLowerBoxResult {
        ok: true,
        module: Some(module),
        error_msg: "",
        patch_stats: patch_stats,
    }
}

fn module_frontend_param_count(params: &Option<Box<ParamList>>) -> i64 with Alloc {
    match *params {
        Some(list) => {
            1 + module_frontend_param_count(&(*list).tail)
        }
        None => 0,
    }
}

fn module_frontend_lower_fn_item_into(item: Item, module: Box<IrModule>) -> Box<IrModule> with Mut, Panic, Div, Alloc {
    var m = module
    if (*m).fn_count >= IR_MAX_FUNCS {
        return m
    }

    let idx = (*m).fn_count
    var func = ir_empty_function()
    func.name = item.name
    match item.fn_def {
        Some(fd) => {
            func.param_count = module_frontend_param_count(&(*fd).params)
        }
        None => {}
    }
    func.reg_count = 1
    func.instrs[0] = ir_load_imm(0, 0)
    func.instrs[1] = ir_return(0)
    func.instr_count = 2
    (*m).functions[idx as usize] = func
    (*m).fn_count = idx + 1
    m
}

fn module_frontend_lower_items_into(items: Option<Box<ItemList>>, module: Box<IrModule>) -> Box<IrModule> with Mut, Panic, Div, Alloc {
    match items {
        Some(list) => {
            let item = (*list).head
            var m = module
            if item.kind == ItemKind::ItemFn {
                m = module_frontend_lower_fn_item_into(item, m)
            }
            module_frontend_lower_items_into((*list).tail, m)
        }
        None => module,
    }
}

fn module_frontend_count_fn_items(items: Option<Box<ItemList>>) -> i64 with Alloc {
    match items {
        Some(list) => {
            let item = (*list).head
            let here = if item.kind == ItemKind::ItemFn { 1 } else { 0 }
            here + module_frontend_count_fn_items((*list).tail)
        }
        None => 0,
    }
}

fn module_frontend_lower_program_counts_traced(
    program: Program,
    module_index: i64,
    trace: &! LoadMultimoduleIrTrace,
    out_fn_count: &! i64,
    out_string_count: &! i64,
    out_contest_count: &! i64
) -> bool with IO, Mut, Div, Panic, Alloc {
    trace.last_stage = "lower_summary"
    trace.last_module_index = module_index
    let fn_count = module_frontend_count_fn_items(program.items)
    if fn_count <= 0 {
        trace.last_stage = "lower_summary_error"
        return false
    }

    trace.summary_seeded_modules = trace.summary_seeded_modules + 1
    trace.last_stage = "lower_bodies"
    trace.body_lowered_modules = trace.body_lowered_modules + 1
    trace.lowered_modules = trace.lowered_modules + 1
    trace.last_stage = "lower_bodies_done"
    (*out_fn_count) = fn_count
    (*out_string_count) = 0
    (*out_contest_count) = 0
    true
}

fn module_frontend_lower_program_box_traced(
    program: Program,
    module_index: i64,
    trace: &! LoadMultimoduleIrTrace
) -> ModuleFrontendLowerBoxResult with IO, Mut, Div, Panic, Alloc {
    trace.last_stage = "lower_summary"
    trace.last_module_index = module_index
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: summary_begin\n") }
    var module = Box::new(ir_empty_module())
    module = module_frontend_lower_items_into(program.items, module)
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: summary_done\n") }
    if (*module).fn_count <= 0 {
        trace.last_stage = "lower_summary_error"
        return module_frontend_lower_box_error("ir_summary_failed")
    }

    trace.summary_seeded_modules = trace.summary_seeded_modules + 1
    trace.last_stage = "lower_bodies"
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: bodies_begin\n") }
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: bodies_done\n") }

    trace.body_lowered_modules = trace.body_lowered_modules + 1
    trace.lowered_modules = trace.lowered_modules + 1
    trace.last_stage = "lower_bodies_done"
    module_frontend_lower_box_ok(module, ir_empty_validated_patch_stats())
}

fn load_multimodule_lower_program_traced(
    program: Program,
    epistemic: IrEpistemicSection,
    module_index: i64,
    trace: &! LoadMultimoduleIrTrace
) -> IrModule with IO, Mut, Div, Panic, Alloc {
    trace.last_stage = "lower_summary"
    trace.last_module_index = module_index
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: summary_begin\n") }
    let summary_result = lower_program_to_ir_summary_box_with_epistemic_ref(&program, epistemic)
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: summary_done\n") }
    if summary_result.had_error || (*(*summary_result.summary).module).fn_count <= 0 {
        trace.last_stage = "lower_summary_error"
        return ir_empty_module()
    }

    trace.summary_seeded_modules = trace.summary_seeded_modules + 1
    trace.last_stage = "lower_bodies"
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: bodies_begin\n") }
    let body_result = lower_program_bodies_from_summary_with_epistemic_boxed_ref(
        &program,
        &(*summary_result.summary),
        epistemic
    )
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: bodies_done\n") }
    if body_result.had_error {
        trace.last_stage = "lower_bodies_error"
        return ir_empty_module()
    }

    trace.body_lowered_modules = trace.body_lowered_modules + 1
    trace.lowered_modules = trace.lowered_modules + 1
    trace.patched_functions = trace.patched_functions + body_result.patch_stats.patched_functions
    trace.patched_calls = trace.patched_calls + body_result.patch_stats.patched_calls
    trace.fallback_insertions = trace.fallback_insertions + body_result.patch_stats.fallback_insertions
    trace.last_stage = "lower_bodies_done"
    let lower_module = *body_result.module
    lower_module
}

fn multimodule_frontend_ok() -> MultiModuleFrontendResult {
    MultiModuleFrontendResult { ok: true, error_msg: "" }
}

fn multimodule_frontend_error(msg: string) -> MultiModuleFrontendResult {
    MultiModuleFrontendResult { ok: false, error_msg: msg }
}

pub fn module_frontend_file_maybe_has_use(path: string) -> bool with IO, Mut, Panic, Div {
    let size = file_size(path)
    if size <= 3 {
        return false
    }
    let data = read_file(path)
    var i: i64 = 0
    while i + 3 < size {
        if data[i as usize] == (117 as i8) &&
           data[(i + 1) as usize] == (115 as i8) &&
           data[(i + 2) as usize] == (101 as i8) &&
           data[(i + 3) as usize] == (32 as i8) {
            return true
        }
        i = i + 1
    }
    false
}

pub fn preflight_multimodule_frontend(main_path: string) -> MultiModuleFrontendResult with IO, Mut, Div, Panic, Alloc {
    let main_prog = load_module_file(main_path)
    let main_items = count_items(main_prog)

    print("Main file: ")
    print_int(main_items)
    print(" items\n")

    if !module_frontend_file_maybe_has_use(main_path) {
        print("Loaded 1 modules\n")
        print("Resolve skip: single module with no imports\n")
        print("Type checking module 0\n")
        let single_verdict_no_use = check_items_verdict_boot4(main_prog.items)
        if single_verdict_no_use != 0 {
            print("Type check failed for module 0\n")
            return multimodule_frontend_error("type_check_failed")
        }
        print("Type check complete for module 0\n")
        return multimodule_frontend_ok()
    }

    let main_imports_fast = extract_imports_from_ast(main_prog)
    if main_imports_fast.count <= 0 {
        print("Loaded 1 modules\n")
        print("Resolve skip: single module with no imports\n")
        print("Type checking module 0\n")
        let single_verdict = check_items_verdict_boot4(main_prog.items)
        if single_verdict != 0 {
            print("Type check failed for module 0\n")
            return multimodule_frontend_error("type_check_failed")
        }
        print("Type check complete for module 0\n")
        return multimodule_frontend_ok()
    }

    var programs: [Program; 64] = [empty_program(); 64]
    var file_paths: [string; 64] = [""; 64]
    programs[0] = main_prog
    file_paths[0] = main_path
    var loaded: i64 = 1

    var visited_paths: [string; 64] = [""; 64]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1

    var work_front: i64 = 0
    var i: i64 = 0

    while work_front < loaded && loaded < 64 {
        let cur_dir = path_directory(file_paths[work_front])
        let work_imports = extract_imports_from_ast(programs[work_front])
        work_front = work_front + 1

        i = 0
        while i < work_imports.count && loaded < 64 {
            let file_path_local = use_path_to_file_path(work_imports.paths[i], cur_dir)
            let file_path_stdlib = use_path_to_file_path(work_imports.paths[i], "stdlib")
            var file_path = file_path_local
            if !file_exists(file_path_local) {
                file_path = file_path_stdlib
            }
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    print("Loading module: ")
                    print(file_path)
                    print("\n")
                    programs[loaded] = load_module_file(file_path)
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                } else {
                    print("Warning: module not found: ")
                    let path_str = use_path_to_string(work_imports.paths[i])
                    print(path_str)
                    print("\n")
                }
            }
            i = i + 1
        }
    }

    print("Loaded ")
    print_int(loaded)
    print(" modules\n")

    let main_imports = extract_imports_from_ast(programs[0])
    let needs_resolution = loaded > 1 || main_imports.count > 0
    if needs_resolution {
        let resolve_result = resolve_modules(programs, loaded)
        if resolve_result.had_error {
            print("Module resolution failed: ")
            print_int(resolve_result.error_count)
            print(" errors\n")
            return multimodule_frontend_error("module_resolution_failed")
        }
    } else {
        print("Resolve skip: single module with no imports\n")
    }

    i = 0
    while i < loaded {
        print("Type checking module ")
        print_int(i)
        print("\n")
        let verdict = check_items_verdict_boot4(programs[i].items)
        if verdict != 0 {
            print("Type check failed for module ")
            print_int(i)
            print("\n")
            return multimodule_frontend_error("type_check_failed")
        }
        print("Type check complete for module ")
        print_int(i)
        print("\n")
        i = i + 1
    }

    multimodule_frontend_ok()
}

pub fn load_multimodule_ir_traced(main_path: string, trace: &! LoadMultimoduleIrTrace) -> MultiModuleIrResult with IO, Mut, Div, Panic, Alloc {
    if module_frontend_file_maybe_has_use(main_path) {
        trace.loaded_modules = 1
        trace.last_stage = "load_main"
        trace.last_module_index = 0
        var merged_imported = module_frontend_lower_imported_source_recursive(main_path, 0, trace)
        if merged_imported.fn_count <= 0 {
            print("IR lowering failed for module 0\n")
            return multimodule_ir_error("ir_lowering_failed")
        }

        trace.last_stage = "done"
        trace.last_module_index = trace.loaded_modules - 1
        print("Merged IR: ")
        print_int(merged_imported.fn_count)
        print(" functions\n")
        parser_reset_last_errors()
        return multimodule_ir_ok(merged_imported)
    }

    let main_prog = load_module_file(main_path)
    if module_frontend_lower_trace_enabled() { print("module_frontend_full: main_loaded\n") }
    trace.loaded_modules = 1
    trace.last_stage = "load_main"
    trace.last_module_index = 0

    if !module_frontend_file_maybe_has_use(main_path) {
        trace.resolved_modules = 1
        var single_epistemic_no_use = ir_empty_epistemic_section()
        trace.last_stage = "typecheck"
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_begin\n") }
        let single_verdict_no_use = check_items_verdict_boot4(main_prog.items)
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_done\n") }
        if single_verdict_no_use != 0 {
            print("Type check failed during IR lowering for module 0\n")
            return multimodule_ir_error("type_check_failed")
        }
        trace.typechecked_modules = 1
        trace.last_stage = "lower_single"
        let single_prog_lower_no_use = load_module_file(main_path)
        var single_lower_result_no_use = load_multimodule_lower_program_traced(single_prog_lower_no_use, single_epistemic_no_use, 0, trace)
        if single_lower_result_no_use.fn_count <= 0 {
            print("IR lowering failed for module 0\n")
            return multimodule_ir_error("ir_lowering_failed")
        }
        trace.merged_modules = 1
        trace.last_stage = "done"
        print("Merged IR: ")
        print_int(single_lower_result_no_use.fn_count)
        print(" functions\n")
        if single_lower_result_no_use.fn_count <= 0 {
            print("IR lowering produced empty module\n")
            return multimodule_ir_error("ir_lowering_empty_module")
        }
        parser_reset_last_errors()
        return multimodule_ir_ok(single_lower_result_no_use)
    }

    let main_imports_fast = module_frontend_import_files_from_source(main_path)
    if main_imports_fast.count <= 0 {
        trace.resolved_modules = 1
        var single_epistemic = ir_empty_epistemic_section()
        trace.last_stage = "typecheck"
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_begin\n") }
        let single_verdict = check_items_verdict_boot4(main_prog.items)
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_done\n") }
        if single_verdict != 0 {
            print("Type check failed during IR lowering for module 0\n")
            return multimodule_ir_error("type_check_failed")
        }
        trace.typechecked_modules = 1
        trace.last_stage = "lower_single"
        let single_prog_lower = load_module_file(main_path)
        var single_lower_result = load_multimodule_lower_program_traced(single_prog_lower, single_epistemic, 0, trace)
        if single_lower_result.fn_count <= 0 {
            print("IR lowering failed for module 0\n")
            return multimodule_ir_error("ir_lowering_failed")
        }
        trace.merged_modules = 1
        trace.last_stage = "done"
        print("Merged IR: ")
        print_int(single_lower_result.fn_count)
        print(" functions\n")
        if single_lower_result.fn_count <= 0 {
            print("IR lowering produced empty module\n")
            return multimodule_ir_error("ir_lowering_empty_module")
        }
        parser_reset_last_errors()
        return multimodule_ir_ok(single_lower_result)
    }

    var programs: [Program; 64] = [empty_program(); 64]
    var file_paths: [string; 64] = [""; 64]
    programs[0] = main_prog
    file_paths[0] = main_path
    var loaded: i64 = 1
    var visited_paths: [string; 64] = [""; 64]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1
    var work_front: i64 = 0
    var i: i64 = 0

    while work_front < loaded && loaded < 64 {
        let work_imports = module_frontend_import_files_from_source(file_paths[work_front])
        work_front = work_front + 1
        i = 0
        while i < work_imports.count && loaded < 64 {
            let file_path = work_imports.paths[i]
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    if module_frontend_lower_trace_enabled() { print("module_frontend_full: load_dep_begin\n") }
                    programs[loaded] = load_module_file(file_path)
                    if module_frontend_lower_trace_enabled() { print("module_frontend_full: load_dep_done\n") }
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                    trace.loaded_modules = loaded
                    trace.last_stage = "load_deps"
                    trace.last_module_index = loaded - 1
                }
            }
            i = i + 1
        }
    }

    let main_imports = module_frontend_import_files_from_source(file_paths[0])
    let needs_resolution = loaded > 1 || main_imports.count > 0
    if needs_resolution {
        trace.last_stage = "resolve"
        trace.last_module_index = loaded - 1
        trace.resolved_modules = loaded
    } else {
        trace.resolved_modules = loaded
    }

    // Step 6: Lower ALL modules to IR and merge.
    // Seed the merge with module 0 to avoid expensive empty-module initialization.
    if loaded <= 0 {
        trace.last_stage = "empty"
        return multimodule_ir_error("no_modules_loaded")
    }

    trace.last_stage = "typecheck_imported_summary"
    trace.last_module_index = 0
    trace.typechecked_modules = 1
    let seed_prog_lower = load_module_file(file_paths[0])
    let seed_lower_result = module_frontend_lower_program_box_traced(seed_prog_lower, 0, trace)
    if !seed_lower_result.ok {
        print("IR lowering failed for module 0\n")
        return multimodule_ir_error("ir_lowering_failed")
    }
    var merged_module = ir_empty_module()
    match seed_lower_result.module {
        Some(module_box) => { merged_module = *module_box }
        None => {
            print("IR lowering failed for module 0\n")
            return multimodule_ir_error("ir_lowering_failed")
        }
    }
    trace.merged_modules = 1

    i = 1
    while i < loaded {
        trace.last_stage = "typecheck_imported_summary"
        trace.last_module_index = i
        trace.typechecked_modules = trace.typechecked_modules + 1
        let prog_lower = load_module_file(file_paths[i])
        let lower_result = module_frontend_lower_program_box_traced(prog_lower, i, trace)
        if !lower_result.ok {
            print("IR lowering failed for module ")
            print_int(i)
            print("\n")
            return multimodule_ir_error("ir_lowering_failed")
        }
        var lowered_module = ir_empty_module()
        match lower_result.module {
            Some(module_box) => { lowered_module = *module_box }
            None => {
                print("IR lowering failed for module ")
                print_int(i)
                print("\n")
                return multimodule_ir_error("ir_lowering_failed")
            }
        }
        trace.last_stage = "merge"
        merged_module = ir_merge_modules(merged_module, lowered_module)
        trace.merged_modules = trace.merged_modules + 1
        i = i + 1
    }

    trace.last_stage = "done"
    trace.last_module_index = loaded - 1
    print("Merged IR: ")
    print_int(merged_module.fn_count)
    print(" functions\n")

    if merged_module.fn_count <= 0 {
        print("IR lowering produced empty module\n")
        return multimodule_ir_error("ir_lowering_empty_module")
    }

    parser_reset_last_errors()
    multimodule_ir_ok(merged_module)
}

pub fn load_multimodule_ir(main_path: string) -> MultiModuleIrResult with IO, Mut, Div, Panic, Alloc {
    var trace = empty_load_multimodule_ir_trace()
    load_multimodule_ir_traced(main_path, &! trace)
}

pub fn load_multimodule_ir_counts_traced(main_path: string, trace: &! LoadMultimoduleIrTrace) -> MultiModuleIrCountsResult with IO, Mut, Div, Panic, Alloc {
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: counts_entry\n") }
    if module_frontend_file_maybe_has_use(main_path) {
        trace.loaded_modules = 1
        trace.last_stage = "load_main"
        trace.last_module_index = 0
        let total_fn_count = module_frontend_count_imported_source_recursive(main_path, 0, trace)

        trace.last_stage = "done"
        trace.last_module_index = trace.loaded_modules - 1
        print("Merged IR: ")
        print_int(total_fn_count)
        print(" functions\n")
        parser_reset_last_errors()
        return multimodule_ir_counts_ok(total_fn_count, 0, 0)
    }

    let main_prog = load_module_file(main_path)
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: load_done\n") }
    trace.loaded_modules = 1
    trace.last_stage = "load_main"
    trace.last_module_index = 0

    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: has_use_check_begin\n") }
    let has_use_fast = module_frontend_file_maybe_has_use(main_path)
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: has_use_check_done\n") }
    if !has_use_fast {
        trace.resolved_modules = 1
        trace.last_stage = "typecheck"
        trace.last_module_index = 0
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_begin\n") }
        let single_verdict_no_use = check_items_verdict_boot4(main_prog.items)
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_done\n") }
        if single_verdict_no_use != 0 {
            print("Type check failed during IR lowering for module 0\n")
            return multimodule_ir_counts_error("type_check_failed")
        }
        trace.typechecked_modules = 1
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: reload_begin\n") }
        let single_prog_lower_no_use = load_module_file(main_path)
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: reload_done\n") }
        var single_fn_count: i64 = 0
        var single_string_count: i64 = 0
        var single_contest_count: i64 = 0
        let single_lower_ok_no_use = module_frontend_lower_program_counts_traced(
            single_prog_lower_no_use,
            0,
            trace,
            &! single_fn_count,
            &! single_string_count,
            &! single_contest_count
        )
        if !single_lower_ok_no_use {
            print("IR lowering failed for module 0\n")
            return multimodule_ir_counts_error("ir_lowering_failed")
        }
        trace.merged_modules = 1
        trace.last_stage = "done"
        print("Merged IR: ")
        print_int(single_fn_count)
        print(" functions\n")
        if single_fn_count <= 0 {
            print("IR lowering produced empty module\n")
            return multimodule_ir_counts_error("ir_lowering_empty_module")
        }
        parser_reset_last_errors()
        return multimodule_ir_counts_ok(single_fn_count, single_string_count, single_contest_count)
    }

    let main_imports_fast = module_frontend_import_files_from_source(main_path)
    if main_imports_fast.count <= 0 {
        trace.resolved_modules = 1
        trace.last_stage = "typecheck"
        trace.last_module_index = 0
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_begin\n") }
        let single_verdict = check_items_verdict_boot4(main_prog.items)
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_done\n") }
        if single_verdict != 0 {
            print("Type check failed during IR lowering for module 0\n")
            return multimodule_ir_counts_error("type_check_failed")
        }
        trace.typechecked_modules = 1
        let single_prog_lower = load_module_file(main_path)
        var single_fn_count2: i64 = 0
        var single_string_count2: i64 = 0
        var single_contest_count2: i64 = 0
        let single_lower_ok = module_frontend_lower_program_counts_traced(
            single_prog_lower,
            0,
            trace,
            &! single_fn_count2,
            &! single_string_count2,
            &! single_contest_count2
        )
        if !single_lower_ok {
            print("IR lowering failed for module 0\n")
            return multimodule_ir_counts_error("ir_lowering_failed")
        }
        trace.merged_modules = 1
        trace.last_stage = "done"
        print("Merged IR: ")
        print_int(single_fn_count2)
        print(" functions\n")
        if single_fn_count2 <= 0 {
            print("IR lowering produced empty module\n")
            return multimodule_ir_counts_error("ir_lowering_empty_module")
        }
        parser_reset_last_errors()
        return multimodule_ir_counts_ok(single_fn_count2, single_string_count2, single_contest_count2)
    }

    var programs: [Program; 64] = [empty_program(); 64]
    var file_paths: [string; 64] = [""; 64]
    programs[0] = main_prog
    file_paths[0] = main_path
    var loaded: i64 = 1
    var visited_paths: [string; 64] = [""; 64]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1
    var work_front: i64 = 0
    var i: i64 = 0

    while work_front < loaded && loaded < 64 {
        let work_imports = module_frontend_import_files_from_source(file_paths[work_front])
        work_front = work_front + 1
        i = 0
        while i < work_imports.count && loaded < 64 {
            let file_path = work_imports.paths[i]
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    programs[loaded] = load_module_file(file_path)
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                    trace.loaded_modules = loaded
                    trace.last_stage = "load_deps"
                    trace.last_module_index = loaded - 1
                }
            }
            i = i + 1
        }
    }

    let main_imports = module_frontend_import_files_from_source(file_paths[0])
    let needs_resolution = loaded > 1 || main_imports.count > 0
    if needs_resolution {
        trace.last_stage = "resolve"
        trace.last_module_index = loaded - 1
        trace.resolved_modules = loaded
    } else {
        trace.resolved_modules = loaded
    }

    if loaded <= 0 {
        trace.last_stage = "empty"
        return multimodule_ir_counts_error("no_modules_loaded")
    }

    var total_fn_count: i64 = 0
    var total_string_count: i64 = 0
    var total_contest_count: i64 = 0
    i = 0
    while i < loaded {
        trace.last_stage = "typecheck_imported_summary"
        trace.last_module_index = i
        trace.typechecked_modules = trace.typechecked_modules + 1
        let prog_lower = load_module_file(file_paths[i])
        var module_fn_count: i64 = 0
        var module_string_count: i64 = 0
        var module_contest_count: i64 = 0
        let lower_ok = module_frontend_lower_program_counts_traced(
            prog_lower,
            i,
            trace,
            &! module_fn_count,
            &! module_string_count,
            &! module_contest_count
        )
        if !lower_ok {
            print("IR lowering failed for module ")
            print_int(i)
            print("\n")
            return multimodule_ir_counts_error("ir_lowering_failed")
        }
        total_fn_count = total_fn_count + module_fn_count
        total_string_count = total_string_count + module_string_count
        total_contest_count = total_contest_count + module_contest_count
        trace.merged_modules = trace.merged_modules + 1
        i = i + 1
    }

    trace.last_stage = "done"
    trace.last_module_index = loaded - 1
    print("Merged IR: ")
    print_int(total_fn_count)
    print(" functions\n")

    if total_fn_count <= 0 {
        print("IR lowering produced empty module\n")
        return multimodule_ir_counts_error("ir_lowering_empty_module")
    }

    parser_reset_last_errors()
    multimodule_ir_counts_ok(total_fn_count, total_string_count, total_contest_count)
}

pub fn load_multimodule_ir_counts(main_path: string) -> MultiModuleIrCountsResult with IO, Mut, Div, Panic, Alloc {
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: counts_wrapper_entry\n") }
    var trace = empty_load_multimodule_ir_trace()
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: counts_wrapper_trace\n") }
    load_multimodule_ir_counts_traced(main_path, &! trace)
}

pub fn load_multimodule_ir_fn_count_traced(main_path: string, trace: &! LoadMultimoduleIrTrace) -> i64 with IO, Mut, Div, Panic, Alloc {
    let imported_counts = load_multimodule_ir_counts_traced(main_path, trace)
    if imported_counts.ok {
        return imported_counts.fn_count
    }

    let main_prog = load_module_file(main_path)
    trace.loaded_modules = 1
    trace.last_stage = "load_main"
    trace.last_module_index = 0

    if module_frontend_file_maybe_has_use(main_path) {
        trace.last_stage = "unsupported_import_scalar"
        return -1
    }

    trace.resolved_modules = 1
    trace.last_stage = "typecheck"
    let verdict = check_items_verdict_boot4(main_prog.items)
    if verdict != 0 {
        trace.last_stage = "typecheck_failed"
        return -1
    }
    trace.typechecked_modules = 1

    let prog_lower = load_module_file(main_path)
    trace.last_stage = "lower_summary"
    let fn_count = module_frontend_count_fn_items(prog_lower.items)
    if fn_count <= 0 {
        trace.last_stage = "lower_summary_error"
        return -1
    }

    trace.summary_seeded_modules = 1
    trace.last_stage = "lower_bodies"
    trace.body_lowered_modules = 1
    trace.lowered_modules = 1
    trace.merged_modules = 1
    trace.last_stage = "done"
    print("Merged IR: ")
    print_int(fn_count)
    print(" functions\n")
    parser_reset_last_errors()
    fn_count
}

pub fn load_multimodule_ir_fn_count(main_path: string) -> i64 with IO, Mut, Div, Panic, Alloc {
    var trace = empty_load_multimodule_ir_trace()
    load_multimodule_ir_fn_count_traced(main_path, &! trace)
}

pub fn load_multimodule_ir_counts_into_traced(
    main_path: string,
    trace: &! LoadMultimoduleIrTrace,
    out_fn_count: &! i64,
    out_string_count: &! i64,
    out_contest_count: &! i64
) -> bool with IO, Mut, Div, Panic, Alloc {
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: counts_into_entry\n") }
    let result = load_multimodule_ir_counts_traced(main_path, trace)
    if !result.ok {
        return false
    }
    (*out_fn_count) = result.fn_count
    (*out_string_count) = result.string_count
    (*out_contest_count) = result.epistemic_contest_count
    true
}

pub fn load_multimodule_ir_counts_into(
    main_path: string,
    out_fn_count: &! i64,
    out_string_count: &! i64,
    out_contest_count: &! i64
) -> bool with IO, Mut, Div, Panic, Alloc {
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: counts_into_wrapper_entry\n") }
    var trace = empty_load_multimodule_ir_trace()
    load_multimodule_ir_counts_into_traced(main_path, &! trace, out_fn_count, out_string_count, out_contest_count)
}

pub fn load_multimodule_ir_probe_summary_traced(main_path: string, trace: &! LoadMultimoduleIrTrace) -> MultiModuleIrResult with IO, Mut, Div, Panic, Alloc {
    let main_prog = load_module_file(main_path)
    var programs: [Program; 64] = [empty_program(); 64]
    var file_paths: [string; 64] = [""; 64]
    programs[0] = main_prog
    file_paths[0] = main_path
    var loaded: i64 = 1
    var visited_paths: [string; 64] = [""; 64]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1
    var work_front: i64 = 0
    var i: i64 = 0
    trace.loaded_modules = 1
    trace.last_stage = "load_main"
    trace.last_module_index = 0

    while work_front < loaded && loaded < 64 {
        let cur_dir = path_directory(file_paths[work_front])
        let work_imports = extract_imports_from_ast(programs[work_front])
        work_front = work_front + 1
        i = 0
        while i < work_imports.count && loaded < 64 {
            let file_path_local = use_path_to_file_path(work_imports.paths[i], cur_dir)
            let file_path_stdlib = use_path_to_file_path(work_imports.paths[i], "stdlib")
            var file_path = file_path_local
            if !file_exists(file_path_local) {
                file_path = file_path_stdlib
            }
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    programs[loaded] = load_module_file(file_path)
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                    trace.loaded_modules = loaded
                    trace.last_stage = "load_deps"
                    trace.last_module_index = loaded - 1
                }
            }
            i = i + 1
        }
    }

    let main_imports = extract_imports_from_ast(programs[0])
    let needs_resolution = loaded > 1 || main_imports.count > 0
    if needs_resolution {
        trace.last_stage = "resolve"
        trace.last_module_index = loaded - 1
        let resolve_result = resolve_modules(programs, loaded)
        if resolve_result.had_error {
            trace.resolved_modules = 0
            return multimodule_ir_error("module_resolution_failed")
        }
        trace.resolved_modules = loaded
    } else {
        trace.resolved_modules = loaded
    }

    if loaded <= 0 {
        trace.last_stage = "empty"
        return multimodule_ir_error("no_modules_loaded")
    }

    var seed_epistemic = ir_empty_epistemic_section()
    trace.last_stage = "typecheck"
    trace.last_module_index = 0
    let seed_verdict = check_items_verdict_boot4(programs[0].items)
    if seed_verdict != 0 {
        print("Type check failed during IR lowering for module 0\n")
        return multimodule_ir_error("type_check_failed")
    }
    trace.typechecked_modules = 1
    trace.last_stage = "lower"
    let seed_prog_lower = load_module_file(file_paths[0])
    var seed_lower_result = module_frontend_summary_module(seed_prog_lower)
    if seed_lower_result.fn_count <= 0 {
        print("IR lowering failed for module 0\n")
        return multimodule_ir_error("ir_lowering_failed")
    }
    trace.lowered_modules = 1
    trace.merged_modules = 1
    var merged_module = seed_lower_result

    i = 1
    while i < loaded {
        var epistemic = ir_empty_epistemic_section()
        trace.last_stage = "typecheck"
        trace.last_module_index = i
        let verdict = check_items_verdict_boot4(programs[i].items)
        if verdict != 0 {
            print("Type check failed during IR lowering for module ")
            print_int(i)
            print("\n")
            return multimodule_ir_error("type_check_failed")
        }
        trace.typechecked_modules = trace.typechecked_modules + 1
        trace.last_stage = "lower"
        let prog_lower = load_module_file(file_paths[i])
        var lower_result = module_frontend_summary_module(prog_lower)
        if lower_result.fn_count <= 0 {
            print("IR lowering failed for module ")
            print_int(i)
            print("\n")
            return multimodule_ir_error("ir_lowering_failed")
        }
        trace.lowered_modules = trace.lowered_modules + 1
        trace.last_stage = "merge"
        merged_module = ir_merge_modules(merged_module, lower_result)
        trace.merged_modules = trace.merged_modules + 1
        i = i + 1
    }

    trace.last_stage = "done"
    trace.last_module_index = loaded - 1
    print("Merged IR: ")
    print_int(merged_module.fn_count)
    print(" functions\n")

    if merged_module.fn_count <= 0 {
        print("IR lowering produced empty module\n")
        return multimodule_ir_error("ir_lowering_empty_module")
    }

    parser_reset_last_errors()
    multimodule_ir_ok(merged_module)
}

pub fn load_multimodule_ir_probe_summary(main_path: string) -> MultiModuleIrResult with IO, Mut, Div, Panic, Alloc {
    var trace = empty_load_multimodule_ir_trace()
    load_multimodule_ir_probe_summary_traced(main_path, &! trace)
}

pub fn load_multimodule_epistemic_into(main_path: string, out: &! IrEpistemicSection) -> MultiModuleFrontendResult with IO, Mut, Div, Panic, Alloc {
    let main_prog = load_module_file(main_path)
    var programs: [Program; 64] = [empty_program(); 64]
    var file_paths: [string; 64] = [""; 64]
    programs[0] = main_prog
    file_paths[0] = main_path
    var loaded: i64 = 1
    var visited_paths: [string; 64] = [""; 64]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1
    var work_front: i64 = 0
    var i: i64 = 0

    while work_front < loaded && loaded < 64 {
        let cur_dir = path_directory(file_paths[work_front])
        let work_imports = extract_imports_from_ast(programs[work_front])
        work_front = work_front + 1
        i = 0
        while i < work_imports.count && loaded < 64 {
            let file_path_local = use_path_to_file_path(work_imports.paths[i], cur_dir)
            let file_path_stdlib = use_path_to_file_path(work_imports.paths[i], "stdlib")
            var file_path = file_path_local
            if !file_exists(file_path_local) {
                file_path = file_path_stdlib
            }
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    programs[loaded] = load_module_file(file_path)
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                }
            }
            i = i + 1
        }
    }

    let main_imports = extract_imports_from_ast(programs[0])
    let needs_resolution = loaded > 1 || main_imports.count > 0
    if needs_resolution {
        let resolve_result = resolve_modules(programs, loaded)
        if resolve_result.had_error {
            return multimodule_frontend_error("module_resolution_failed")
        }
    }

    if loaded == 1 {
        if !check_program_epistemic_into(programs[0], out) {
            return multimodule_frontend_error("type_check_failed")
        }
        return multimodule_frontend_ok()
    }

    var merged_epistemic = ir_empty_epistemic_section()
    i = 0
    while i < loaded {
        var epistemic = ir_empty_epistemic_section()
        if !check_program_epistemic_into(programs[i], &!epistemic) {
            return multimodule_frontend_error("type_check_failed")
        }
        merged_epistemic = ir_merge_epistemic_sections(merged_epistemic, epistemic)
        i = i + 1
    }

    (*out) = merged_epistemic
    multimodule_frontend_ok()
}
