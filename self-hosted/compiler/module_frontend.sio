fn module_frontend_populate_imported_programs(
    main_path: string,
    programs: &! [Program; 256],
    trace: &! LoadMultimoduleIrTrace
) -> i64 with IO, Mut, Panic, Div, Alloc {
    var file_paths: [string; 256] = [""; 256]
    (*programs)[0] = load_module_file(main_path)
    file_paths[0] = main_path
    var loaded: i64 = 1
    var visited_paths: [string; 256] = [""; 256]
    var visited_count: i64 = 1
    visited_paths[0] = main_path
    var work_front: i64 = 0

    trace.loaded_modules = 1
    trace.last_stage = "load_main"
    trace.last_module_index = 0

    while work_front < loaded && loaded < 256 {
        let work_imports = module_frontend_import_files_from_source(file_paths[work_front])
        work_front = work_front + 1
        var i: i64 = 0
        while i < work_imports.count && loaded < 256 {
            let file_path = work_imports.paths[i]
            if !visited_contains(visited_paths, visited_count, file_path) && file_exists(file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                (*programs)[loaded] = load_module_file(file_path)
                file_paths[loaded] = file_path
                loaded = loaded + 1
                trace.loaded_modules = loaded
                trace.last_stage = "load_deps"
                trace.last_module_index = loaded - 1
            }
            i = i + 1
        }
    }

    trace.resolved_modules = loaded
    loaded
}

pub fn module_frontend_check_imported_modules_verdict(main_path: string) -> i64 with IO, Mut, Panic, Div, Alloc {
    var trace = empty_load_multimodule_ir_trace()
    var programs: [Program; 256] = [mf_empty_program(); 256]
    let loaded = module_frontend_populate_imported_programs(main_path, &! programs, &! trace)
    if loaded <= 0 {
        return 0
    }
    check_modules_verdict_boot4(&! programs, loaded)
}

// ============================================================================
// Per-module arena-reset scratch (Box-arena churn reclaim, see docs/handoff).
//
// module_frontend_lower_programs_array_direct_box lowers each imported module
// into a fresh Box<IrModule> (dep_box, ~hundreds of MB: [IrFunction; 2048])
// purely as scratch to extract a handful of merged functions into the
// running accumulator (acc_box). Everything in dep_box's Box-arena window
// is dead once its functions/strings/epistemic/algebras are copied into
// acc_box BY VALUE -- except IrInstr.call_args: Option<Box<IrRegList>>,
// whose Box POINTER is copied shallow by struct assignment. Left alone,
// that pointer would keep referencing dep_box's soon-to-be-reset memory.
//
// Re-box path (Wave9 / memory-wall residual):
//   1. Scan newly-appended functions; snapshot every live call_args chain into
//      BSS fixed arrays (NOT Box-arena) — reg heads only, max 8 args/site.
//      Wider chains mark overflow and keep the module arena alive rather than
//      silently rebuilding a truncated argument list.
//   2. __arena_reset(dep mark) — reclaim the dep lowering window.
//   3. Rebuild fresh Box<IrRegList> chains from BSS and write them back via the
//      A14 whole-function idiom (by-value IrFunction, 2-level field store,
//      1-level array writeback). Nested
//      `IR_INSTR_ARENA[ir_region_slot_w(ir_fn_get(&(*module), fi).region, (ii)) as usize].call_args = …` is a 3-level store
//      through Box that lean_single silently DROPS — that was the residual
//      that forced the post-#832 "skip when live call_args" retreat. Do NOT
//      reintroduce A8 by-value IrInstr argument scramble.
// Overflow (sites > MF_AREBOX_CAP) still skips reset for that module only.
// ============================================================================
let MF_AREBOX_CAP: i64 = 8192
var MF_AREBOX_FI: [i64; 8192] = [0; 8192]
var MF_AREBOX_II: [i64; 8192] = [0; 8192]
var MF_AREBOX_ARGC: [i64; 8192] = [0; 8192]
var MF_AREBOX_ARGS: [i64; 65536] = [0; 65536]
var MF_AREBOX_COUNT: i64 = 0
var MF_AREBOX_OVERFLOW: bool = false
// Loud metrics (session totals across lower_array dep merges).
var MF_AREBOX_RESET_OK: i64 = 0
var MF_AREBOX_RESET_SKIP: i64 = 0
var MF_AREBOX_SITES_RECLAIMED: i64 = 0

fn mf_arebox_reset_scratch() with Mut {
    MF_AREBOX_COUNT = 0
    MF_AREBOX_OVERFLOW = false
}

// Extract up to 8 reg heads from the call_args chain at (fi, ii) into
// MF_AREBOX_ARGS[slot*8 ..]. Walks via module indices so we never pass a
// Box-carrying Option into a helper by value (defense in depth vs A8-class
// large-struct/Box by-value miscompiles). A wider chain cannot be rebuilt from
// this scratch slot, so mark overflow and let the caller skip the arena reset.
fn mf_arebox_extract_at(module: &IrModule, fi: i64, ii: i64, slot: i64) -> i64 with Mut, Panic, Div {
    // #1649: read the FLAT POOL, not the Box chain. ir_arena_load does not
    // rebuild call_args -- rebuilding needs Alloc and it is called at ~431 sites
    // -- so the chain walked here was ALWAYS None, this returned 0 for every
    // instruction, and the reset proceeded believing no call had arguments to
    // preserve. Silent argument loss on the dependency-merge path, not a crash.
    // The pool needs no allocation, so this is also simpler than what it replaces.
    let at = ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (ii))
    let total = IR_A_ARG_COUNT[at as usize]
    if total <= 0 { return 0 }
    var n: i64 = 0
    while n < 8 && n < total {
        MF_AREBOX_ARGS[(slot * 8 + n) as usize] = ir_arena_arg_at(at, n)
        n = n + 1
    }
    if total > 8 { MF_AREBOX_OVERFLOW = true }
    n
}

// Record one (fi, ii) call-arg site for post-reset re-boxing, extracting its
// args NOW while the source (pre-reset) memory is still valid.
fn mf_arebox_record_at(module: &IrModule, fi: i64, ii: i64) with Mut, Panic, Div {
    if MF_AREBOX_COUNT >= MF_AREBOX_CAP {
        MF_AREBOX_OVERFLOW = true
        return
    }
    let slot = MF_AREBOX_COUNT
    let n = mf_arebox_extract_at(module, fi, ii, slot)
    MF_AREBOX_FI[slot as usize] = fi
    MF_AREBOX_II[slot as usize] = ii
    MF_AREBOX_ARGC[slot as usize] = n
    MF_AREBOX_COUNT = slot + 1
}

// Rebuild a fresh Box<IrRegList> chain from scratch slot `slot`, preserving
// original head-first arg order. Must only be called AFTER __arena_reset so
// the Box::new allocations land in the freed (reused) window.
fn mf_arebox_rebuild(slot: i64) -> Option<Box<IrRegList>> with Alloc, Mut, Panic, Div {
    let n = MF_AREBOX_ARGC[slot as usize]
    var out: Option<Box<IrRegList>> = None
    var k = n - 1
    while k >= 0 {
        out = Some(Box::new(ir_reg_list_cons(MF_AREBOX_ARGS[(slot * 8 + k) as usize], out)))
        k = k - 1
    }
    out
}

// Scan functions [fn_lo, fn_hi) of `module` for instrs carrying a live
// call_args chain, recording each for post-reset re-boxing. Returns false
// (capacity exceeded, MF_AREBOX_OVERFLOW set) if the caller must skip the
// arena reset for this module.
fn mf_arebox_scan(module: &IrModule, fn_lo: i64, fn_hi: i64) -> bool with Mut, Panic, Div {
    mf_arebox_reset_scratch()
    var fi = fn_lo
    while fi < fn_hi {
        let ic = ir_fn_get(&(*module), fi as usize).instr_count
        var ii: i64 = 0
        while ii < ic {
            // #1649: same correction -- ask the pool whether this instruction has
            // arguments. The call_args chain on a loaded instr is always empty.
            if IR_A_ARG_COUNT[(ir_region_slot_r(ir_fn_get(&(*module), fi as usize).region, (ii))) as usize] > 0 {
                mf_arebox_record_at(module, fi, ii)
            }
            ii = ii + 1
        }
        fi = fi + 1
    }
    !MF_AREBOX_OVERFLOW
}

// Write the rebuilt (post-reset) call_args chains back into `module`. Must be
// called strictly after __arena_reset.
//
// A14 whole-function writeback: lean_single drops 3-level nested stores of the
// form `ir_fn_get(&(*module), fi).instrs[ii].call_args = rebuilt` (now
// `ir_arena_put_args(ir_region_slot_w(...), rebuilt, ...)`), leaving the
// shallow (now-dangling) Box pointer in place — that is the observed
// "corrupts IrRegList heads" residual after arena reclaim. Copy the IrFunction
// out, mutate call_args on the owned local (2-level field store, same proven
// pattern as fn_id rebinding), write the whole function back once.
// Do NOT take IrInstr by value (A8 scramble).
fn mf_arebox_apply(module: &! IrModule) with Alloc, Mut, Panic, Div {
    var s: i64 = 0
    while s < MF_AREBOX_COUNT {
        let fi = MF_AREBOX_FI[s as usize]
        let ii = MF_AREBOX_II[s as usize]
        let rebuilt = mf_arebox_rebuild(s)
        if fi >= 0 && fi < (*module).fn_count {
            var f = ir_fn_get(&(*module), fi as usize)
            if ii >= 0 && ii < f.instr_count {
                ir_arena_put_args(ir_region_slot_w(f.region, (ii)), rebuilt, ir_reg_list_len(rebuilt))
                ir_fn_set(&! (*module), fi as usize, f)
            }
        }
        s = s + 1
    }
}

fn module_frontend_lower_single_program_array_direct_box(
    programs: &! [Program; 256],
    trace: &! LoadMultimoduleIrTrace
) -> ModuleFrontendLowerDirectBoxResult with IO, Mut, Panic, Div, Alloc {
    trace.last_stage = "lower_summary"
    trace.last_module_index = 0
    let dce_marks = spec_dce_mark_across_programs(programs, 1)
    if dce_marks > 0 && module_frontend_dce_trace_enabled() {
        print("lower_array: dce marks=")
        print_int(dce_marks)
        print("\n")
    }
    if module_frontend_loaded_ir_slot_capacity_exceeded(programs, 1) {
        trace.last_stage = "lower_summary_error"
        return module_frontend_lower_direct_box_error(module_frontend_loaded_ir_slot_capacity_error(programs, 1))
    }

    fo_xfer_global_reset()
    let program = (*programs)[0]
    fo_preregister_program_items_multipass(&program.items)
    print("lower_array: seed_begin\n")
    let seed_items = spec_dce_filter_with_global_marks(program.items)
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: summary_begin\n") }
    if module_frontend_ir_slot_capacity_exceeded(&seed_items) {
        trace.last_stage = "lower_summary_error"
        return module_frontend_lower_direct_box_error(module_frontend_ir_slot_capacity_error(&seed_items))
    }
    let epistemic = ir_empty_epistemic_section_boxed()
    let seed_program = mf_program_from_items(&seed_items)
    let summary_result = lower_program_to_ir_summary_box_with_externs_ref(&seed_program, programs, 1, 0, &(*epistemic))
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: summary_done\n") }
    if summary_result.had_error {
        trace.last_stage = "lower_summary_error"
        lower_hard_error_report()
        return module_frontend_lower_direct_box_error("ir_summary_failed: lowering reported an error")
    }
    if (*(*summary_result.summary).module).fn_count <= 0 {
        trace.last_stage = "lower_summary_error"
        return module_frontend_lower_direct_box_error("ir_summary_failed: lowering produced an empty module (fn_count 0)")
    }
    trace.summary_seeded_modules = trace.summary_seeded_modules + 1
    trace.last_stage = "lower_bodies"
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: bodies_begin\n") }
    let body_result = lower_program_bodies_from_summary_with_epistemic_boxed_owned(
        &seed_program,
        *summary_result.summary,
        &(*epistemic)
    )
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: bodies_done\n") }
    if body_result.had_error {
        trace.last_stage = "lower_bodies_error"
        lower_hard_error_report()
        return module_frontend_lower_direct_box_error("ir_bodies_failed")
    }
    if module_frontend_items_have_ontology(&seed_items) {
        checker_apply_ir_ontology_parameter_links_from_items(&seed_items, &! (*body_result.module))
    }
    trace.body_lowered_modules = trace.body_lowered_modules + 1
    trace.lowered_modules = trace.lowered_modules + 1
    trace.patched_functions = trace.patched_functions + body_result.patch_stats.patched_functions
    trace.patched_calls = trace.patched_calls + body_result.patch_stats.patched_calls
    trace.fallback_insertions = trace.fallback_insertions + body_result.patch_stats.fallback_insertions
    print("lower_array: seed_done\n")
    trace.last_stage = "done"
    trace.merged_modules = 1
    module_frontend_lower_direct_box_ok(body_result.module, body_result.patch_stats)
}

fn module_frontend_lower_programs_array_direct_box_multi(
    programs: &! [Program; 256],
    loaded: i64,
    trace: &! LoadMultimoduleIrTrace
) -> ModuleFrontendLowerDirectBoxResult with IO, Mut, Panic, Div, Alloc {
    if loaded <= 0 {
        return module_frontend_lower_direct_box_error("no_modules_loaded")
    }

    trace.last_stage = "lower_summary"
    trace.last_module_index = 0
    // Cross-module DCE BEFORE the capacity preflight, so the preflight counts
    // what will be lowered rather than what was parsed. spec_dce_unreachable_item_fns
    // only runs on the specialized-collapse path, so this path had no pruning at
    // all: main.sio's 120-module closure declares 10705 functions against a
    // limit of IR_MAX_FUNCS - 1, while only 5997 are reachable from `main`.
    // Returns -1 when the mark set could not be completed, and the filter
    // helpers then hand back their input unchanged — a refusal upstream cannot
    // become a deletion downstream.
    let dce_marks = spec_dce_mark_across_programs(programs, loaded)
    if dce_marks > 0 && module_frontend_dce_trace_enabled() {
        print("lower_array: dce marks=")
        print_int(dce_marks)
        print("\n")
    }
    if module_frontend_loaded_ir_slot_capacity_exceeded(programs, loaded) {
        trace.last_stage = "lower_summary_error"
        return module_frontend_lower_direct_box_error(module_frontend_loaded_ir_slot_capacity_error(programs, loaded))
    }
    // FO multi-mod: register pure-fn transfers from *all* loaded modules before
    // seed body lower, so user main FO-sees imported helpers (epistemic::fo, …).
    // CRITICAL: copy Program to a local first. Nested field-address of large
    // Program in a large array (&programs[i].items) is a lean_single residual
    // that reads as Option::None (measured: fo_prereg none=1). Whole-Program
    // by-value load then &prog.items is the proven A14-safe pattern.
    fo_xfer_global_reset()
    var fo_pi: i64 = 0
    while fo_pi < loaded {
        var prog = (*programs)[fo_pi as usize]
        fo_preregister_program_items_multipass(&prog.items)
        fo_pi = fo_pi + 1
    }
    print("lower_array: seed_begin\n")
    let seed_items = spec_dce_filter_with_global_marks((*programs)[0].items)
    let seed_lower = module_frontend_lower_program_items_box_traced_with_externs(&seed_items, programs, loaded, 0, trace)
    print("lower_array: seed_done\n")
    if !seed_lower.ok {
        return module_frontend_lower_direct_box_error(seed_lower.error_msg)
    }
    match seed_lower.module {
        Some(seed_acc) => {
            // var so into-acc can rebind the Box after each dep (takes acc by value).
            var acc_box = seed_acc
            if module_frontend_dump_merged_calls_enabled() {
                print("MERGE_DUMP: seed_module\n")
                ir_module_dump_merge_calls(&(*acc_box))
            }
            trace.merged_modules = 1
            // Snapshot seed *user* main (by name, smallest body) — NOT functions[0].
            // Into-acc fills dep helpers into low fn_ids (os_oct_mul at fi=0 measured);
            // restoring functions[0] destroyed those bodies → order_spread SEGV.
            var seed_main_idx = module_frontend_find_user_main_idx(&(*acc_box))
            if seed_main_idx < 0 {
                seed_main_idx = 0
            }
            var seed_user_main = ir_function_deep_copy(ir_fn_get(&(*acc_box), seed_main_idx as usize))
            let into_acc_default = module_frontend_into_acc_enabled()
            if into_acc_default {
                print("lower_array: dep_mode into_acc\n")
            } else {
                print("lower_array: dep_mode place_remap\n")
            }
            print("lower_array: seed_main_idx ")
            print_int(seed_main_idx)
            print("\n")

            var i: i64 = 1
            while i < loaded {
                trace.last_module_index = i
                print("lower_array: dep_begin ")
                print_int(i)
                print("\n")
                // Mark the Box-arena BEFORE lowering module i. dep_items itself
                // (programs[i].items) was already parsed earlier in the
                // load/typecheck phase and must stay live for OTHER modules'
                // extern resolution, so it is intentionally allocated before
                // this mark and is untouched by the reset below -- only the
                // per-module lowering scratch falls inside [mark, reset).
                let dep_arena_mark = __arena_mark()
                let dep_items = spec_dce_filter_with_global_marks((*programs)[i as usize].items)

                if into_acc_default {
                    // Wave13: body-lower dep directly into acc (no concurrent dep_box).
                    // Fills seed-preseeded stubs (ic=0) and appends new names in place.
                    // Call targets already bind to absolute acc fn_ids by name.
                    let dep_fn_before = (*acc_box).fn_count
                    let into_result = lower_dep_program_items_into_acc_with_externs(
                        &dep_items,
                        programs,
                        loaded,
                        i,
                        acc_box
                    )
                    print("lower_array: into_acc_done ")
                    print_int(i)
                    print("\n")
                    if into_result.had_error {
                        // Say WHICH module and WHAT was raised. This site used to
                        // return the bare string, so a failure here named the
                        // stage and nothing else -- and the lowering-error ledger
                        // that knows the answer was already sitting in globals,
                        // unread. The four *_ir_slot paths above already do this.
                        print("  into_acc failed at module index ")
                        print_int(i)
                        print(" of ")
                        print_int(loaded)
                        print("\n")
                        lower_hard_error_report()
                        return module_frontend_lower_direct_box_error("ir_into_acc_failed")
                    }
                    acc_box = into_result.module
                    // Into-acc fills stubs at low fn_ids AND may append. Re-box
                    // call_args for the whole module before arena_reset so filled
                    // stubs' chains (allocated post-mark) are not left dangling.
                    // Opt-out: SOUNIO_INTO_ACC_NO_RESET=1 keeps post-mark boxes live
                    // (peak slightly higher; useful for residual diagnosis).
                    if str_eq(read_env("SOUNIO_INTO_ACC_NO_RESET"), "1") {
                        MF_AREBOX_RESET_SKIP = MF_AREBOX_RESET_SKIP + 1
                        print("lower_array: arena_reset_skipped (into_acc_no_reset) module ")
                        print_int(i)
                        print(" fn_after ")
                        print_int((*acc_box).fn_count)
                        print("\n")
                    } else {
                        let dep_arena_scan_ok = mf_arebox_scan(&(*acc_box), 0, (*acc_box).fn_count)
                        let dep_rebox_sites = MF_AREBOX_COUNT
                        if dep_arena_scan_ok {
                            __arena_reset(dep_arena_mark)
                            mf_arebox_apply(&! (*acc_box))
                            MF_AREBOX_RESET_OK = MF_AREBOX_RESET_OK + 1
                            MF_AREBOX_SITES_RECLAIMED = MF_AREBOX_SITES_RECLAIMED + dep_rebox_sites
                            print("lower_array: arena_reset_ok module ")
                            print_int(i)
                            print(" rebox_sites ")
                            print_int(dep_rebox_sites)
                            print(" into_acc fn_before ")
                            print_int(dep_fn_before)
                            print(" fn_after ")
                            print_int((*acc_box).fn_count)
                            print("\n")
                        } else {
                            MF_AREBOX_RESET_SKIP = MF_AREBOX_RESET_SKIP + 1
                            print("lower_array: arena_reset_skipped (call-arg scratch overflow) module ")
                            print_int(i)
                            print(" sites ")
                            print_int(dep_rebox_sites)
                            print("\n")
                        }
                    }
                } else {
                    // Proven path: full dep_box lower + place+remap + section merge.
                    let dep_lower = module_frontend_lower_program_items_box_traced_with_externs(&dep_items, programs, loaded, i, trace)
                    print("lower_array: dep_lower_done ")
                    print_int(i)
                    print("\n")
                    if !dep_lower.ok {
                        return module_frontend_lower_direct_box_error(dep_lower.error_msg)
                    }
                    match dep_lower.module {
                        Some(dep_box) => {
                            print("lower_array: merge_begin ")
                            print_int(i)
                            print("\n")
                            let dep_fn_count = (*dep_box).fn_count
                            let dep_merge_old_fn_count = (*acc_box).fn_count
                            let string_offset = (*acc_box).string_count
                            let contest_offset = (*acc_box).epistemic.contest_count
                            let robust_offset = (*acc_box).epistemic.robust_proof_count
                            let decision_offset = (*acc_box).epistemic.decision_certificate_count
                            let deferred_offset = (*acc_box).epistemic.deferred_certificate_count
                            let validated_offset = (*acc_box).epistemic.validated_manifest_count
                            let acquisition_plan_offset = (*acc_box).epistemic.acquisition_plan_count
                            let recourse_plan_offset = (*acc_box).epistemic.recourse_plan_count
                            let alternative_set_offset = (*acc_box).epistemic.alternative_set_count
                            let transition_plan_offset = (*acc_box).epistemic.transition_plan_count
                            let observed_transition_offset = (*acc_box).epistemic.observed_transition_count
                            let rollback_certificate_offset = (*acc_box).epistemic.rollback_certificate_count
                            let bss_offset_delta = (*acc_box).bss_total_size
                            let acc_fn_before = (*acc_box).fn_count
                            var fn_remap: [i64; 2048] = [-1; 2048]
                            var append_count: i64 = 0
                            var rfi: i64 = 0
                            while rfi < dep_fn_count {
                                let dep_ic = ir_fn_get(&(*dep_box), rfi as usize).instr_count
                                let dep_is_bss = ir_fn_get(&(*dep_box), rfi as usize).compile_strategy == IR_STRATEGY_BSS_GLOBAL
                                var stub_idx: i64 = 0 - 1
                                var existing_body_idx: i64 = 0 - 1
                                var sfi: i64 = 0
                                while sfi < (*acc_box).fn_count {
                                    if ir_name_eq(
                                        ir_fn_get(&(*acc_box), sfi as usize).name,
                                        ir_fn_get(&(*dep_box), rfi as usize).name
                                    ) {
                                        // Wave13: seed may have preseeded external BSS so bare
                                        // Ident from main resolves. DEDUP those slots by name
                                        // (instr_count is 0 for scalar BSS — do not treat as stub).
                                        if dep_is_bss
                                            && ir_fn_get(&(*acc_box), sfi as usize).compile_strategy == IR_STRATEGY_BSS_GLOBAL
                                        {
                                            existing_body_idx = sfi
                                        } else if ir_fn_get(&(*acc_box), sfi as usize).instr_count <= 0 {
                                            stub_idx = sfi
                                        } else {
                                            existing_body_idx = sfi
                                        }
                                    }
                                    sfi = sfi + 1
                                }
                                if existing_body_idx >= 0 {
                                    fn_remap[rfi as usize] = existing_body_idx
                                } else if stub_idx >= 0 && dep_ic > 0 {
                                    let planned_idx = (*acc_box).fn_count + append_count
                                    if planned_idx < IR_MAX_FUNCS {
                                        fn_remap[rfi as usize] = planned_idx
                                        append_count = append_count + 1
                                    }
                                } else {
                                    let planned_idx = (*acc_box).fn_count + append_count
                                    if planned_idx < IR_MAX_FUNCS {
                                        fn_remap[rfi as usize] = planned_idx
                                        append_count = append_count + 1
                                    }
                                }
                                rfi = rfi + 1
                            }

                            // Wave13: when seed preseeded dep BSS, DEDUP skips those slots —
                            // only grow acc BSS by non-deduped dep BSS size (not full dep total).
                            var bss_grow: i64 = 0
                            var mfi: i64 = 0
                            while mfi < dep_fn_count {
                                let dst_fi = fn_remap[mfi as usize]
                                if dst_fi >= acc_fn_before {
                                    ir_merge_place_and_remap_function(
                                        &! (*acc_box),
                                        &(*dep_box),
                                        mfi,
                                        dst_fi,
                                        dep_fn_count,
                                        &fn_remap,
                                        contest_offset,
                                        robust_offset,
                                        decision_offset,
                                        deferred_offset,
                                        validated_offset,
                                        acquisition_plan_offset,
                                        recourse_plan_offset,
                                        alternative_set_offset,
                                        transition_plan_offset,
                                        observed_transition_offset,
                                        rollback_certificate_offset,
                                        bss_offset_delta
                                    )
                                    if ir_fn_get(&(*dep_box), mfi as usize).compile_strategy == IR_STRATEGY_BSS_GLOBAL {
                                        let bsz = ir_fn_get(&(*dep_box), mfi as usize).bss_size
                                        let aligned = ((bsz + 7) / 8) * 8
                                        bss_grow = bss_grow + aligned
                                    }
                                }
                                mfi = mfi + 1
                            }
                            // Prefer exact non-deduped BSS growth. When the dep had no BSS
                            // slots at all (or only non-BSS), fall back keeps prior behaviour
                            // for any untracked BSS footprint (should be zero when DEDUP-clean).
                            if bss_grow > 0 {
                                (*acc_box).bss_total_size = (*acc_box).bss_total_size + bss_grow
                            } else {
                                // No newly-placed BSS: if every dep BSS was DEDUP'd, grow 0.
                                // If dep had no BSS_GLOBAL entries, also grow 0 (dep.bss may
                                // still be 0). Only use full dep.bss when we placed nothing
                                // and dep claims BSS we failed to classify — defensive.
                                var dep_bss_slots: i64 = 0
                                var dbi: i64 = 0
                                while dbi < dep_fn_count {
                                    if ir_fn_get(&(*dep_box), dbi as usize).compile_strategy == IR_STRATEGY_BSS_GLOBAL {
                                        dep_bss_slots = dep_bss_slots + 1
                                    }
                                    dbi = dbi + 1
                                }
                                if dep_bss_slots == 0 && (*dep_box).bss_total_size > 0 {
                                    (*acc_box).bss_total_size = (*acc_box).bss_total_size + (*dep_box).bss_total_size
                                }
                            }
                            var si: i64 = 0
                            while si < (*dep_box).string_count && (*acc_box).string_count < IR_MAX_STRINGS {
                                (*acc_box).string_table[(*acc_box).string_count as usize] = (*dep_box).string_table[si as usize]
                                (*acc_box).string_count = (*acc_box).string_count + 1
                                si = si + 1
                            }
                            // The loop above stops on EITHER condition and said so
                            // nowhere. intern_string refuses loudly when the table
                            // is full (lower.sio, site 9120); this path -- the one
                            // the into_acc build actually takes -- dropped the tail
                            // in silence. A dropped literal is not a missing one at
                            // runtime: the instructions that referenced it keep
                            // their index and read whatever now sits there.
                            //
                            // Reported, not refused: the two sibling merges
                            // (ir_merge_modules_into, ir_merge_modules) carry no IO
                            // effect, so making all three refuse together is an
                            // effect-signature change across their callers and does
                            // not belong in a capacity measurement.
                            if si < (*dep_box).string_count {
                                print("warning: string table full at ")
                                print_int(IR_MAX_STRINGS)
                                print("; dropped ")
                                print_int((*dep_box).string_count - si)
                                print(" strings merging module ")
                                print_int(i)
                                print("\n")
                            }
                            ir_merge_sections_into_module(&! (*acc_box), &(*dep_box))
                            let dep_merge_new_fn_count = (*acc_box).fn_count
                            let dep_arena_scan_ok = mf_arebox_scan(&(*acc_box), dep_merge_old_fn_count, dep_merge_new_fn_count)
                            let dep_rebox_sites = MF_AREBOX_COUNT
                            if dep_arena_scan_ok {
                                __arena_reset(dep_arena_mark)
                                mf_arebox_apply(&! (*acc_box))
                                MF_AREBOX_RESET_OK = MF_AREBOX_RESET_OK + 1
                                MF_AREBOX_SITES_RECLAIMED = MF_AREBOX_SITES_RECLAIMED + dep_rebox_sites
                                print("lower_array: arena_reset_ok module ")
                                print_int(i)
                                print(" rebox_sites ")
                                print_int(dep_rebox_sites)
                                print("\n")
                            } else {
                                MF_AREBOX_RESET_SKIP = MF_AREBOX_RESET_SKIP + 1
                                print("lower_array: arena_reset_skipped (call-arg scratch overflow) module ")
                                print_int(i)
                                print(" sites ")
                                print_int(dep_rebox_sites)
                                print("\n")
                            }
                            print("lower_array: merge_done ")
                            print_int(i)
                            print("\n")
                            let _keep_string_offset = string_offset
                        }
                        None => return module_frontend_lower_direct_box_error("ir_lowering_failed")
                    }
                }
                trace.merged_modules = trace.merged_modules + 1
                i = i + 1
            }

            // Restore user main at its seed index (not fn_id=0).
            if seed_main_idx >= 0 && seed_main_idx < (*acc_box).fn_count {
                ir_fn_set(&! (*acc_box), seed_main_idx as usize, seed_user_main)
            }

            trace.last_stage = "done"
            print("lower_array: final_fn_count ")
            print_int((*acc_box).fn_count)
            print("\n")
            print("lower_array: arena_reset_totals ok=")
            print_int(MF_AREBOX_RESET_OK)
            print(" skip=")
            print_int(MF_AREBOX_RESET_SKIP)
            print(" sites_reclaimed=")
            print_int(MF_AREBOX_SITES_RECLAIMED)
            print("\n")
            module_frontend_lower_direct_box_ok(acc_box, ir_empty_validated_patch_stats())
        }
        None => module_frontend_lower_direct_box_error("ir_lowering_failed")
    }
}

fn module_frontend_lower_programs_array_direct_box(
    programs: &! [Program; 256],
    loaded: i64,
    trace: &! LoadMultimoduleIrTrace
) -> ModuleFrontendLowerDirectBoxResult with IO, Mut, Panic, Div, Alloc {
    if loaded <= 0 {
        return module_frontend_lower_direct_box_error("no_modules_loaded")
    }
    if loaded == 1 {
        return module_frontend_lower_single_program_array_direct_box(programs, trace)
    }
    module_frontend_lower_programs_array_direct_box_multi(programs, loaded, trace)
}

fn module_frontend_lower_programs_array_boxed(
    programs: &! [Program; 256],
    loaded: i64,
    trace: &! LoadMultimoduleIrTrace
) -> ModuleFrontendLowerBoxResult with IO, Mut, Panic, Div, Alloc {
    if loaded <= 0 {
        return module_frontend_lower_box_error("no_modules_loaded")
    }

    let lowered = module_frontend_lower_programs_array_direct_box(programs, loaded, trace)
    if !lowered.ok {
        return module_frontend_lower_box_error(lowered.error_msg)
    }
    module_frontend_lower_box_ok(lowered.module, lowered.patch_stats)
}

fn bridge_lower_imported_modules_box(main_path: string, trace: &! LoadMultimoduleIrTrace) -> ModuleFrontendLowerBoxResult with IO, Mut, Div, Panic, Alloc {
    // Keep the merged Box canonical — do not densify through MultiModuleIrResult
    // then Box::new again (was a full second materialization).
    let boxed = load_multimodule_ir_to_box_traced(main_path, trace)
    if !boxed.ok {
        return module_frontend_lower_box_error(boxed.error_msg)
    }
    if (*boxed.module).fn_count <= 0 {
        return module_frontend_lower_box_error("ir_lowering_failed")
    }
    trace.last_stage = "done"
    module_frontend_lower_box_ok(boxed.module, ir_empty_validated_patch_stats())
}

pub fn bridge_lower_module_box(main_path: string, trace: &! LoadMultimoduleIrTrace) -> ModuleFrontendLowerBoxResult with IO, Mut, Div, Panic, Alloc {
    let imports = module_frontend_import_files_from_source(main_path)
    if imports.count > 0 {
        return bridge_lower_imported_modules_box(main_path, trace)
    }
    bridge_lower_single_module_box(main_path, trace)
}

pub fn bridge_lower_single_module_box(main_path: string, trace: &! LoadMultimoduleIrTrace) -> ModuleFrontendLowerBoxResult with IO, Mut, Div, Panic, Alloc {
    trace.loaded_modules = 1
    trace.resolved_modules = 1
    trace.last_stage = "load_main"
    trace.last_module_index = 0
    let program = load_module_file(main_path)
    let parse_errors = parser_last_error_count()
    if parse_errors > 0 {
        trace.last_stage = "parse_error"
        return module_frontend_lower_box_error("parse_failed")
    }
    trace.last_stage = "typecheck"
    let verdict = module_frontend_check_items_with_source_context(program.items, main_path)
    if verdict != 0 {
        trace.last_stage = "typecheck_error"
        return module_frontend_lower_box_error("type_check_failed")
    }
    var epistemic = ir_empty_epistemic_section()
    if !check_program_epistemic_into(program, &!epistemic) {
        trace.last_stage = "epistemic_export_error"
        return module_frontend_lower_box_error("epistemic_export_failed")
    }
    if module_frontend_lower_trace_enabled() {
        print("module_frontend_lower: epistemic_contest_count ")
        print_int(epistemic.contest_count)
        print("\n")
    }
    trace.typechecked_modules = 1
    trace.last_stage = "lower_single"
    let lowered = module_frontend_lower_program_box_traced_with_epistemic(&program, &epistemic, 0, trace)
    if !lowered.ok {
        return lowered
    }
    trace.merged_modules = 1
    trace.last_stage = "done"
    lowered
}

fn module_frontend_lower_program_full_traced(
    program: Program,
    epistemic: IrEpistemicSection,
    module_index: i64,
    trace: &! LoadMultimoduleIrTrace
) -> IrLowerResult with IO, Mut, Div, Panic, Alloc {
    trace.last_stage = "lower_summary"
    trace.last_module_index = module_index
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: summary_begin\n") }
    let summary_result = lower_program_to_ir_summary_box_with_epistemic_ref(&program, &epistemic)
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: summary_done\n") }
    if summary_result.had_error || (*(*summary_result.summary).module).fn_count <= 0 {
        trace.last_stage = "lower_summary_error"
        return IrLowerResult {
            module: ir_empty_module(),
            had_error: true,
            error_count: summary_result.error_count,
            patch_stats: ir_empty_validated_patch_stats(),
        }
    }

    trace.summary_seeded_modules = trace.summary_seeded_modules + 1
    trace.last_stage = "lower_bodies"
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: bodies_begin\n") }
    // Consume summary Box: reuse its IrModule for body lower (no second empty).
    let body_result = lower_program_bodies_from_summary_with_epistemic_boxed_owned(
        &program,
        *summary_result.summary,
        &epistemic
    )
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: bodies_done\n") }
    if body_result.had_error {
        trace.last_stage = "lower_bodies_error"
        lower_hard_error_report()
        return IrLowerResult {
            module: ir_empty_module(),
            had_error: true,
            error_count: 0,
            patch_stats: ir_empty_validated_patch_stats(),
        }
    }

    trace.body_lowered_modules = trace.body_lowered_modules + 1
    trace.lowered_modules = trace.lowered_modules + 1
    trace.patched_functions = trace.patched_functions + body_result.patch_stats.patched_functions
    trace.patched_calls = trace.patched_calls + body_result.patch_stats.patched_calls
    trace.fallback_insertions = trace.fallback_insertions + body_result.patch_stats.fallback_insertions
    trace.last_stage = "lower_bodies_done"
    IrLowerResult {
        module: *body_result.module,
        had_error: false,
        error_count: summary_result.error_count,
        patch_stats: body_result.patch_stats,
    }
}

// WP-A3: run the AST generic specializer over the MERGED multi-module item list
// to produce the TYPE-CHECK verdict for imported programs that instantiate a
// cross-module generic.
//
// The single-module specializer (check::specializer) is name-safe only when it
// sees every locally declared struct/enum, so it was hooked only into the
// no-import lanes. Here we recover it for the imported path via design (a):
// concatenate all modules' items (main first) into ONE list and run
// specialize_generics over that fully-merged view — where an imported
// `struct F {..}` is now a "known name" and thus excluded from free-type-var
// recovery, and every turbofish call site + template is simultaneously visible.
//
// It is deliberately TYPE-CHECK-ONLY: the merged, monomorphized list is used to
// compute the verdict (which drops the `expected CDElementExact / found
// CDElementExact__T` E008 mono-mismatch the un-specialized imported checker
// emitted), but the per-module `programs` array is left UNTOUCHED so the
// existing per-module IR lowering / cross-module merge path is unchanged. This
// keeps working generic multi-module programs (e.g. wrap::<i64> returning
// W<i64>) lowering exactly as before while removing the spurious E008.
//
// Returns (handled, verdict): handled=false means the pass did not instantiate
// any generic (merged list differs from the inputs by at most dropped
// never-referenced templates) — the caller MUST fall back to its normal
// per-module check_modules_verdict_boot4 so ordinary multi-module code stays
// byte-identical. handled=true means `verdict` is the authoritative merged
// verdict (0 ok / 1 reject).
// Merge every loaded module's items (last → first) into one list for the
// WP-A3 specializer. Order matches module_frontend_specialized_typecheck /
// visibility preflight so free-var exclusion sees the same imported names.
fn module_frontend_merge_program_items(
    programs: &! [Program; 256],
    count: i64
) -> Option<Box<ItemList>> with Mut, Alloc {
    var merged: Option<Box<ItemList>> = None
    var i: i64 = count - 1
    while i >= 0 {
        merged = spec_append_item_lists((*programs)[i as usize].items, merged)
        i = i - 1
    }
    merged
}

// WP-A3 typecheck-only residual (callers that do not own programs for rewrite).
// Prefer module_frontend_specialized_prepare when IR lower follows — that path
// rewrites programs[0] to the monomorphized merged list so body lower never
// sees generic templates (Wave12 cd_exact residual: SEGV in cd_add_exact body
// lower on trait-method loops over [F;2048]).
fn module_frontend_specialized_typecheck(programs: &! [Program; 256], count: i64) -> (bool, i64) with IO, Mut, Panic, Div, Alloc {
    if count <= 0 {
        return (false, 0)
    }
    let specialized = specialize_generics(module_frontend_merge_program_items(programs, count))
    // i64 mono-marker gate — not bare `if !bool` (CI-seed fragile).
    let mono_n: i64 = spec_mono_marker_count()
    if mono_n <= 0 {
        return (false, 0)
    }
    if str_eq(read_env("SOUNIO_MM_SPEC_TRACE"), "1") {
        print("mm_spec: specialized-typecheck over merged ")
        print_int(count)
        print(" modules mono_markers=")
        print_int(mono_n)
        print("\n")
    }
    let verdict = check_items_verdict_boot4(specialized)
    (true, verdict)
}

// WP-A3 full prepare: merge → specialize → typecheck, and when a generic was
// actually monomorphized, emit a monomorphized item list for single-module IR
// lower (specializer design intent; see specializer.sio multi-module lane
// notes). Collapse signal is *specialized_items_out:
//   None  → use plain multi-module check+lower over `count` modules
//   Some  → return value is typecheck verdict; out-param holds the monomorphized
//           merge and the caller MUST lower THAT list as freestanding single module
// Return: typecheck verdict when specialized_items_out is Some (collapse path);
// ignored when out-param stays None (ordinary multi-mod). Do NOT return (bool, i64)
// from a function that also takes &! out-params — measured Wave12 CI failure:
// lean_single seed misreads tuple.0 as true after early return (false, 0), so
// callers collapsed with specialized_items=None → ir_summary_failed on every
// non-generic multi-mod (imported_deref_f64_array gate, dual_import). Gate
// collapse on Option occupancy only.
//
// Handoff MUST NOT rely on nested field-in-array store
// `(*programs)[0].items = specialized_ir` — lean_single drops it (A8/A14/A10),
// leaving only main body-lowered and mono cd_* stubs with ic=0 → ZD FAIL +
// SEGV. Whole-Program array writeback is also fragile for large Program
// (measured Wave12 STAR: seed_begin SEGV after writeback). Caller lowers the
// out-param list directly via module_frontend_lower_specialized_items_box.
fn module_frontend_specialized_prepare(
    programs: &! [Program; 256],
    count: i64,
    specialized_items_out: &! Option<Box<ItemList>>
) -> i64 with IO, Mut, Panic, Div, Alloc {
    // Always clear: Option occupancy is the sole collapse signal.
    *specialized_items_out = None
    if count <= 0 {
        return 0
    }
    // First specialize: typecheck only. Do NOT park this list on programs[0]
    // yet — checker collect may mutate Item/fn_def through the shared Box
    // spine, which would leave body lower seeing only main with live clones
    // stripped (measured: body_fn_count 4 but only main body-lowered → ZD FAIL
    // / SEGV on empty mono stubs).
    let specialized_tc = specialize_generics(module_frontend_merge_program_items(programs, count))
    // Seed-safe i64 mono markers. Leave specialized_items_out as None when
    // mono_n==0 so Option occupancy stays the sole collapse arm.
    let mono_n: i64 = spec_mono_marker_count()
    if mono_n <= 0 {
        return 0
    }
    if str_eq(read_env("SOUNIO_MM_SPEC_TRACE"), "1") {
        print("mm_spec: specialized-prepare over merged ")
        print_int(count)
        print(" modules mono_markers=")
        print_int(mono_n)
        print(" (collapse candidate)\n")
    }
    let verdict = check_items_verdict_boot4(specialized_tc)
    // Second specialize: fresh monomorphized list for IR lower, rebuilt from
    // still-intact per-module originals (merge only reads programs[i].items).
    // Monomorphized + retained non-generic items from every module live in
    // one list under same-name mono. Multi-mod template body lower SEGV'd on
    // cd_add_exact / trait-method array loops (Wave12 residual).
    let specialized_raw = specialize_generics(module_frontend_merge_program_items(programs, count))
    let mono_n2: i64 = spec_mono_marker_count()
    if mono_n2 <= 0 {
        return 0
    }
    // Wave13: drop unused top-level ItemFns (e.g. full f64 CD helpers when
    // only transitive `cd_sigma` is live) before body lower. Reachability
    // from main; non-fn items always kept. No-op without main.
    let specialized_ir = spec_dce_unreachable_item_fns(specialized_raw)
    let ir_slots = module_frontend_count_lowered_ir_slots(&specialized_ir)
    if ir_slots <= 0 {
        return 0
    }
    if str_eq(read_env("SOUNIO_MM_SPEC_TRACE"), "1") {
        print("mm_spec: specialized_ir ir_slots=")
        print_int(ir_slots)
        print(" mono_markers=")
        print_int(mono_n2)
        print(" (post-dce)\n")
    }
    // Out-param handoff (lean_single-safe). No programs[] mutation.
    // Some(...) is the authoritative "handled / collapse" signal for callers.
    *specialized_items_out = specialized_ir
    verdict
}

// True when the lowered module has at least one `main` with a non-empty body.
// Specialized collapse must not ship a hollow main (measured dual gum+knowledge:
// specialized lower left main@53 ic=0 → silent rc=0 without DUAL_GUM_KNOWLEDGE_OK).
fn module_frontend_module_has_main_body(module: &IrModule) -> bool with Div, Mut, Panic {
    let watch_main = make_name("main")
    var fi: i64 = 0
    while fi < (*module).fn_count {
        if ir_name_eq(ir_fn_get(&(*module), fi as usize).name, watch_main) {
            if ir_fn_get(&(*module), fi as usize).instr_count > 0 {
                return true
            }
        }
        fi = fi + 1
    }
    false
}

// Single-module lower of a monomorphized item list produced by
// module_frontend_specialized_prepare. Lowers the out-param items as a
// freestanding Program (no programs[] writeback) while still allowing
// multi-mod extern resolution against the original loaded modules. Pure
// no-externs freestanding failed dual with ir_summary_failed; with-externs
// + hollow-main guard is the green path (cd_exact body-lowers, dual falls
// back to multi-mod when main stays ic=0).
fn module_frontend_lower_specialized_items_box(
    items: &Option<Box<ItemList>>,
    programs: &! [Program; 256],
    program_count: i64,
    trace: &! LoadMultimoduleIrTrace
) -> ModuleFrontendLowerDirectBoxResult with IO, Mut, Panic, Div, Alloc {
    print("lower_specialized: begin\n")
    // program_count stays at the original loaded module count so extern
    // lookup still sees sibling modules; the ITEMS being lowered are the
    // monomorphized merge (not programs[0].items).
    let seed_lower = module_frontend_lower_program_items_box_traced_with_externs(
        items,
        programs,
        program_count,
        0,
        trace
    )
    print("lower_specialized: done\n")
    if !seed_lower.ok {
        return module_frontend_lower_direct_box_error(seed_lower.error_msg)
    }
    match seed_lower.module {
        Some(module_box) => {
            if module_frontend_dump_merged_calls_enabled() {
                print("MERGE_DUMP: specialized_module\n")
                ir_module_dump_merge_calls(&(*module_box))
            }
            // Hollow-main guard: collapse without a body-lowered main is
            // worse than multi-mod (silent rc=0). Caller falls back.
            if !module_frontend_module_has_main_body(&(*module_box)) {
                print("lower_specialized: hollow_main — reject for multi-mod fallback\n")
                return module_frontend_lower_direct_box_error("specialized_hollow_main")
            }
            trace.merged_modules = 1
            // Resolve same-module call targets (mono names already in one list).
            ir_module_resolve_all_call_targets(&! (*module_box))
            if module_frontend_dump_merged_calls_enabled() {
                print("MERGE_DUMP: specialized_module_post_resolve\n")
                ir_module_dump_merge_calls(&(*module_box))
            }
            module_frontend_lower_direct_box_ok(module_box, ir_empty_validated_patch_stats())
        }
        None => {
            module_frontend_lower_direct_box_error("specialized_lower_no_module")
        }
    }
}

// Finalize merged multi-mod IR in place and return the live Box. No densify.
// Primary Madaros compile path (module_frontend_compile_imported_to_file) already
// stays on the box end-to-end; this helper serves load_* / merge_imported_into.
fn module_frontend_merge_imported_box(
    programs: &! [Program; 256],
    loaded: i64,
    trace: &! LoadMultimoduleIrTrace
) -> ModuleFrontendLowerDirectBoxResult with IO, Mut, Div, Panic, Alloc {
    if loaded <= 0 {
        return module_frontend_lower_direct_box_error("no_modules_loaded")
    }

    trace.last_stage = "typecheck"
    // Wave12: specialize+collapse when generics instantiate so body lower
    // sees monomorphized items (not free-var templates).
    var specialized_items: Option<Box<ItemList>> = None
    let prep_verdict = module_frontend_specialized_prepare(programs, loaded, &! specialized_items)
    // Option occupancy is the collapse signal (not a (bool,i64) tuple — see prepare).
    var use_collapse = false
    match specialized_items {
        Some(_) => { use_collapse = true }
        None => { use_collapse = false }
    }
    var verdict: i64 = 0
    if use_collapse {
        verdict = prep_verdict
    } else {
        verdict = check_modules_verdict_boot4(programs, loaded)
    }
    if verdict != 0 {
        print("Type check failed during imported IR merge\n")
        return module_frontend_lower_direct_box_error("type_check_failed")
    }
    trace.typechecked_modules = loaded

    // Per-module check_program_with_artifacts cannot see cross-module imports and
    // either rejects (E137) or spins; multimodule verdict above is authoritative.
    // Specialized collapse: freestanding lower of monomorphized list (no array
    // writeback). On hollow-main / lower failure, fall back to multi-mod so dual
    // gum+knowledge stays green. Ordinary multi-mod: lower_programs_array_direct_box.
    var used_specialized: bool = false
    var lowered: ModuleFrontendLowerDirectBoxResult = module_frontend_lower_direct_box_error("uninitialized")
    if use_collapse {
        lowered = module_frontend_lower_specialized_items_box(&specialized_items, programs, loaded, trace)
        if lowered.ok {
            used_specialized = true
        } else {
            print("imported_merge: specialized lower failed (")
            print(lowered.error_msg)
            print(") — multi-mod fallback\n")
            lowered = module_frontend_lower_programs_array_direct_box(programs, loaded, trace)
        }
    } else {
        lowered = module_frontend_lower_programs_array_direct_box(programs, loaded, trace)
    }
    if !lowered.ok {
        print("IR lowering failed during merge: ")
        print(lowered.error_msg)
        print("\n")
        return module_frontend_lower_direct_box_error(lowered.error_msg)
    }
    let module_box = lowered.module
    if (*module_box).fn_count <= 0 {
        print("IR lowering produced empty module\n")
        return module_frontend_lower_direct_box_error("ir_lowering_empty_module")
    }
    // Specialized freestanding path already resolve_all_call_targets; multi-mod
    // still needs finalize/restore of merged import stubs.
    if !used_specialized {
        let user_main_snapshot = ir_function_deep_copy(ir_fn_get(&(*module_box), 0 as usize))
        // Memory wall P0: finalize/restore in place on the boxed module — no full
        // IrModule by-value chain (promote/compact/ensure/resolve each used to copy).
        ir_module_finalize_merged_calls(&! (*module_box))
        ir_module_restore_user_main_calls(&! (*module_box), user_main_snapshot)
        // #2244: the restore above replays a PRE-finalize snapshot over slot 0, so
        // it undoes what ir_module_ensure_builtin_call_targets just did to that
        // slot. It already re-applies the float-marker half of that pass by hand
        // (see the IR_FLOAT_REG_MARKER_FLAG loop inside it); the name/fn_id half
        // was missing, so a builtin call in the restored slot kept its pre-finalize
        // binding. Measured: the first function of the first imported module was
        // the only one in a merged compile whose 3-arg str_slice was not retagged.
        // Re-running the pass is idempotent -- it rewrites only what is still stale.
        ir_module_ensure_builtin_call_targets(&! (*module_box))
    }
    module_frontend_lower_direct_box_ok(module_box, ir_empty_validated_patch_stats())
}

fn module_frontend_merge_imported_into(
    programs: &! [Program; 256],
    loaded: i64,
    trace: &! LoadMultimoduleIrTrace,
    out_module: &! IrModule
) -> bool with IO, Mut, Div, Panic, Alloc {
    let merged = module_frontend_merge_imported_box(programs, loaded, trace)
    if !merged.ok {
        return false
    }
    // Residual densify only when the caller still owns a stack IrModule.
    // Prefer merge_imported_box / merge_imported_into_box / compile-to-file
    // (and load_multimodule_ir_to_box_traced) which keep the Box canonical.
    (*out_module) = *merged.module
    true
}

// Box-preserving write: move the finalized module into caller-owned Box without
// densifying through a stack IrModule. Avoids the empty+densify pair that used
// to allocate two full modules at the load_multimodule_ir boundary.
fn module_frontend_merge_imported_into_box(
    programs: &! [Program; 256],
    loaded: i64,
    trace: &! LoadMultimoduleIrTrace,
    out_box: &! Box<IrModule>
) -> bool with IO, Mut, Div, Panic, Alloc {
    let merged = module_frontend_merge_imported_box(programs, loaded, trace)
    if !merged.ok {
        return false
    }
    (*out_box) = merged.module
    true
}

// Load the per-peel kill switch once, here: this compile entry already carries
// IO, and the peels it gates do not. One env var per peel rather than an integer
// mask, so the peel's name appears in the command line that reproduced a bug.
fn module_frontend_load_ocp_skip_mask() with IO, Mut, Panic, Div {
    // A second definition of this function stood earlier in the file with its
    // own bit numbering, and it was the one in effect: the first definition
    // wins. Its numbering disagreed with ocp_skip()'s call sites, so ten of the
    // twelve names below disabled a DIFFERENT peel than the one they name, and
    // compact_nops (bit 4096) could not be reached at all -- that table stopped
    // at 2048. Measured with a name present in only one table:
    // SOUNIO_OCP_SKIP_DCE_LOOP=1 left the output byte-identical while
    // SOUNIO_OCP_SKIP_DCE=1 changed it. The note at opt_cleanup.sio:41 removed
    // the duplicate GLOBAL left by the same merge and says to audit for names
    // declared twice after any merge; that audit covered globals and missed
    // functions, and this is the function it missed. The deleted definition
    // also carried the float-marker switch, which is why it is called here.
    module_frontend_load_float_marker_switch()
    var m: i64 = 0
    if str_eq(read_env("SOUNIO_OCP_SKIP_DEDUP_IMM"), "1")       { m = m + 1 }
    if str_eq(read_env("SOUNIO_OCP_SKIP_CONST_FOLD"), "1")      { m = m + 2 }
    if str_eq(read_env("SOUNIO_OCP_SKIP_COPY_PROP"), "1")       { m = m + 4 }
    if str_eq(read_env("SOUNIO_OCP_SKIP_DSE"), "1")             { m = m + 8 }
    if str_eq(read_env("SOUNIO_OCP_SKIP_REDUNDANT_JUMP"), "1")  { m = m + 16 }
    if str_eq(read_env("SOUNIO_OCP_SKIP_JUMP_TO_RETURN"), "1")  { m = m + 32 }
    if str_eq(read_env("SOUNIO_OCP_SKIP_DEAD_AFTER_JUMP"), "1") { m = m + 64 }
    if str_eq(read_env("SOUNIO_OCP_SKIP_DEAD_LABEL"), "1")      { m = m + 128 }
    if str_eq(read_env("SOUNIO_OCP_SKIP_CSE"), "1")             { m = m + 256 }
    if str_eq(read_env("SOUNIO_OCP_SKIP_DCE_LOOP"), "1")        { m = m + 512 }
    if str_eq(read_env("SOUNIO_OCP_SKIP_SCCP"), "1")            { m = m + 1024 }
    if str_eq(read_env("SOUNIO_OCP_SKIP_DCE_FINAL"), "1")       { m = m + 2048 }
    if str_eq(read_env("SOUNIO_OCP_SKIP_COMPACT_NOPS"), "1")    { m = m + 4096 }
    OCP_SKIP_MASK = m
    if m != 0 {
        print("[ocp-skip] mask=")
        print(io_trace_i64_string(m))
        print("\n")
    }
}

pub fn module_frontend_compile_imported_to_file(
    main_path: string,
    output_path: string,
    optimize: bool,
) -> i32 with IO, Mut, Div, Panic, Alloc {
    module_frontend_load_ocp_skip_mask()
    parser_reset_last_errors()
    // One reset + suppress for the full multi-mod load/typecheck/lower window so
    // imported module f64 constants (e.g. stats::densities::DE_LN_SQRT_2PI) remain
    // in GLOBAL_VAR_INIT_* until BSS slots are seeded at lower time.
    module_frontend_global_init_compile_begin()
    print("imported_compile: begin\n")
    var trace = empty_load_multimodule_ir_trace()
    print("imported_compile: load_begin\n")
    let main_prog = load_module_file(main_path)
    print("imported_compile: load_done\n")
    if parser_last_error_count() > 0 {
        print("Parse failed during imported compile\n")
        module_frontend_global_init_compile_end()
        return 1
    }

    var programs: [Program; 256] = [mf_empty_program(); 256]
    var file_paths: [string; 256] = [""; 256]
    programs[0] = main_prog
    file_paths[0] = main_path
    var loaded: i64 = 1
    var visited_paths: [string; 256] = [""; 256]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1
    var work_front: i64 = 0
    var dep_i: i64 = 0
    trace.loaded_modules = 1
    trace.last_stage = "load_main"
    trace.last_module_index = 0

    while work_front < loaded && loaded < 256 {
        let work_imports = module_frontend_import_files_from_source(file_paths[work_front])
        if module_frontend_lower_trace_enabled() {
            print("imported_compile: scan_front=")
            print_int(work_front)
            print(" loaded=")
            print_int(loaded)
            print(" count=")
            print_int(work_imports.count)
            print("\n")
        }
        work_front = work_front + 1
        dep_i = 0
        while dep_i < work_imports.count && loaded < 256 {
            let file_path: string = work_imports.paths[dep_i]
            if module_frontend_lower_trace_enabled() {
                print("imported_compile: dep front=")
                print_int(work_front - 1)
                print(" dep=")
                print_int(dep_i)
                print(" path=")
                print(file_path)
                print("\n")
            }
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    programs[loaded] = load_module_file(file_path)
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                    trace.loaded_modules = loaded
                    trace.last_stage = "load_deps"
                    trace.last_module_index = loaded - 1
                }
            }
            dep_i = dep_i + 1
        }
    }

    if loaded <= 0 {
        print("Multi-module IR failed: no_modules_loaded\n")
        module_frontend_global_init_compile_end()
        return 1
    }
    trace.resolved_modules = loaded
    print("imported_compile: loaded ")
    print_int(loaded)
    print(" modules\n")

    trace.last_stage = "typecheck"
    print("imported_compile: typecheck_begin\n")
    // WP-A3 + Wave12: when a cross-module generic is instantiated, monomorphize
    // the merged item list (drops E008 CDElementExact__T mono-mismatch) AND
    // lower the monomorphized list as a freestanding single module. Leaving
    // programs untouched after typecheck-only specialize caused SEGV in
    // multi-mod body lower of generic templates (cd_add_exact residual).
    // Nested field-in-array / whole-Program array writeback is not the handoff
    // (lean_single drops nested stores; whole-Program writeback SEGV'd at
    // seed_begin). Out-param list + freestanding lower is the lean_single-safe
    // path. Ordinary multi-module (no instantiation) still uses per-module
    // check+lower.
    var specialized_items: Option<Box<ItemList>> = None
    let prep_verdict = module_frontend_specialized_prepare(&! programs, loaded, &! specialized_items)
    // Option occupancy is the collapse signal (not a (bool,i64) tuple — see prepare).
    var use_collapse = false
    match specialized_items {
        Some(_) => { use_collapse = true }
        None => { use_collapse = false }
    }
    var verdict: i64 = 0
    if use_collapse {
        verdict = prep_verdict
    } else {
        verdict = check_modules_verdict_boot4(&! programs, loaded)
    }
    print("imported_compile: typecheck_done\n")
    if verdict != 0 {
        print("Type check failed during imported IR merge\n")
        module_frontend_global_init_compile_end()
        return 1
    }
    trace.typechecked_modules = loaded
    print("imported_compile: typecheck ok\n")
    if use_collapse && loaded > 1 {
        print("imported_compile: specialized_collapse lower_count=1 (from ")
        print_int(loaded)
        print(" modules)\n")
    }

    trace.last_stage = "lower_merge"
    print("imported_compile: lower_begin\n")
    var used_specialized: bool = false
    var lowered: ModuleFrontendLowerDirectBoxResult = module_frontend_lower_direct_box_error("uninitialized")
    if use_collapse {
        lowered = module_frontend_lower_specialized_items_box(&specialized_items, &! programs, loaded, &! trace)
        if lowered.ok {
            used_specialized = true
        } else {
            print("imported_compile: specialized lower failed (")
            print(lowered.error_msg)
            print(") — multi-mod fallback\n")
            lowered = module_frontend_lower_programs_array_direct_box(&! programs, loaded, &! trace)
        }
    } else {
        lowered = module_frontend_lower_programs_array_direct_box(&! programs, loaded, &! trace)
    }
    print("imported_compile: lower_done\n")
    if !lowered.ok {
        print("IR lowering failed during merge: ")
        print(lowered.error_msg)
        print("\n")
        module_frontend_global_init_compile_end()
        return 1
    }

    let module_box = lowered.module
    // Single module (true single-file OR Wave12 specialized collapse that kept
    // a body-lowered main) has no cross-module calls to finalize. Compile the
    // boxed IrModule directly so the bridge never materializes or returns the
    // very large module by value.
    if used_specialized || loaded == 1 {
        // Specialized path already ran resolve_all inside lower_specialized_items_box;
        // true single-module still needs resolve here.
        if !used_specialized {
            ir_module_resolve_all_call_targets(&! (*module_box))
        }
        // Wave14e: single-file / specialized-collapse never enter multi-mod
        // finalize_merged_calls, so bare float intrinsics (exp/cos/sin/log/sqrt)
        // would keep returns_float=0 empty stubs and subsequent f64 arithmetic
        // would cvtsi2sd the IEEE bit pattern. Stamp here before codegen.
        ir_module_ensure_builtin_call_targets(&! (*module_box))
        let fn_count = (*module_box).fn_count
        trace.last_stage = "done"
        trace.last_module_index = 0
        trace.merged_modules = 1
        ir_instr_census_report()
        print("Merged IR: ")
        print_int(fn_count)
        print(" functions\n")
        if fn_count <= 0 {
            print("IR lowering produced empty module\n")
            module_frontend_global_init_compile_end()
            return 1
        }
        if optimize {
            module_frontend_load_ocp_skip_mask()
            let cleanup_receipt = opt_cleanup_module_inplace(&! (*module_box))
            module_frontend_print_rebracket_receipt("single-post-resolve", cleanup_receipt)
        } else {
            module_frontend_print_rebracket_disabled("single-disabled", fn_count)
        }
        // Cleanup is the final mutable IR pass on this route; codegen receives
        // only an immutable module reference after this audit snapshot.
        //
        // #1649: that sentence used to be a comment. Sealing makes it checked --
        // any write past this point lands in quarantine and latches, and the
        // barriers below refuse the binary.
        let single_sealed = ir_module_seal_functions(&(*module_box))
        module_frontend_print_seal_receipt("single", single_sealed, fn_count)
        module_frontend_print_ordered_path_receipt("single-final", optimize, &(*module_box))
        parser_reset_last_errors()
        if module_frontend_lower_trace_enabled() { ir_arena_report_usage() }
        if ir_arena_report_violation() {
            print("Error: refusing to write a binary built on a violated IR arena contract\n")
            module_frontend_global_init_compile_end()
            return 1
        }
        if lower_hard_error_pending() {
            lower_hard_error_report()
            print("Error: refusing to write a binary -- lowering hit a hard error (see the error above)\n")
            module_frontend_global_init_compile_end()
            return 1
        }
        module_frontend_print_float_bits_probe("single", &(*module_box))
        let single_target_spec = native_resolve_target("native", "auto", false)
        let single_write_rc = compile_native_v2_preview_to_file(&(*module_box), single_target_spec, output_path)
        if single_write_rc != 0 {
            print("Error: Failed to write native binary to ")
            print(output_path)
            print(" rc=")
            print_int(single_write_rc)
            print("\n")
            module_frontend_global_init_compile_end()
            return 1
        }
        // #1649: sealing only means something if a write AFTER publication is caught,
        // and the barrier above runs BEFORE codegen. Check again here, so a
        // codegen-time write through a sealed region cannot latch unobserved.
        if module_frontend_lower_trace_enabled() { ir_arena_report_usage() }
        if ir_arena_report_violation() {
            print("Error: refusing to keep a binary -- the IR arena contract was violated during codegen\n")
            module_frontend_global_init_compile_end()
            return 1
        }
        print("Written to ")
        print(output_path)
        print("\n")
        module_frontend_global_init_compile_end()
        return 0
    }
    if module_frontend_dump_merged_calls_enabled() {
        print("MERGE_DUMP: pre_finalize\n")
        ir_module_dump_merge_calls(&(*module_box))
    }
    let user_main_snapshot = ir_function_deep_copy(ir_fn_get(&(*module_box), 0 as usize))
    if str_eq(read_env("SOUNIO_DUMP_ALL_CALLS"), "1") {
        print("DUMPALL: pre_finalize\n")
        ir_module_dump_all_calls_diag(&(*module_box))
    }
    // Memory wall P0: finalize/restore in place — no full IrModule by-value locals.
    ir_module_finalize_merged_calls(&! (*module_box))
    ir_module_restore_user_main_calls(&! (*module_box), user_main_snapshot)
    // #2244: the restore above replays a PRE-finalize snapshot over slot 0, so
    // it undoes what ir_module_ensure_builtin_call_targets just did to that
    // slot. It already re-applies the float-marker half of that pass by hand
    // (see the IR_FLOAT_REG_MARKER_FLAG loop inside it); the name/fn_id half
    // was missing, so a builtin call in the restored slot kept its pre-finalize
    // binding. Measured: the first function of the first imported module was
    // the only one in a merged compile whose 3-arg str_slice was not retagged.
    // Re-running the pass is idempotent -- it rewrites only what is still stale.
    ir_module_ensure_builtin_call_targets(&! (*module_box))
    if str_eq(read_env("SOUNIO_DUMP_ALL_CALLS"), "1") {
        print("DUMPALL: post_finalize\n")
        ir_module_dump_all_calls_diag(&(*module_box))
    }
    let fn_count = (*module_box).fn_count
    trace.last_stage = "done"
    trace.last_module_index = loaded - 1
    trace.merged_modules = loaded
    ir_instr_census_report()
    print("Merged IR: ")
    print_int(fn_count)
    print(" functions\n")
    if fn_count <= 0 {
        print("IR lowering produced empty module\n")
        module_frontend_global_init_compile_end()
        return 1
    }
    if module_frontend_dump_merged_calls_enabled() {
        ir_module_dump_merge_calls(&(*module_box))
    }
    if optimize {
        module_frontend_load_ocp_skip_mask()
        let cleanup_receipt = opt_cleanup_module_inplace(&! (*module_box))
        module_frontend_print_rebracket_receipt("merged-post-finalize", cleanup_receipt)
    } else {
        module_frontend_print_rebracket_disabled("merged-disabled", fn_count)
    }
    // Finalization and cleanup are complete; codegen receives an immutable
    // module reference after this audit snapshot. Sealed, so that claim is
    // checked rather than asserted -- see the single route above.
    let merged_sealed = ir_module_seal_functions(&(*module_box))
    module_frontend_print_seal_receipt("merged", merged_sealed, fn_count)
    module_frontend_print_ordered_path_receipt("merged-final", optimize, &(*module_box))
    parser_reset_last_errors()
    // Last barrier before the ELF is written. The OR into had_error at every
    // IrLowerResult construction should already have stopped this compile, but a
    // truncated binary that exits 0 is the failure mode this whole change exists
    // to remove, so it is also checked at the one place every route passes
    // through -- it must not depend on which of the six lowering wrappers ran.
    if module_frontend_lower_trace_enabled() { ir_arena_report_usage() }
    if ir_arena_report_violation() {
        print("Error: refusing to write a binary built on a violated IR arena contract\n")
        module_frontend_global_init_compile_end()
        return 1
    }
    if lower_hard_error_pending() {
        lower_hard_error_report()
        print("Error: refusing to write a binary -- lowering hit a hard error (see the error above)\n")
        module_frontend_global_init_compile_end()
        return 1
    }
    module_frontend_print_float_bits_probe("merged", &(*module_box))
    let target_spec = native_resolve_target("native", "auto", false)
    let write_rc = compile_native_v2_preview_to_file(&(*module_box), target_spec, output_path)
    if write_rc != 0 {
        print("Error: Failed to write native binary to ")
        print(output_path)
        print(" rc=")
        print_int(write_rc)
        print("\n")
        module_frontend_global_init_compile_end()
        return 1
    }
    // #1649: sealing only means something if a write AFTER publication is caught,
    // and the barrier above runs BEFORE codegen. Check again here, so a
    // codegen-time write through a sealed region cannot latch unobserved.
    if module_frontend_lower_trace_enabled() { ir_arena_report_usage() }
    if ir_arena_report_violation() {
        print("Error: refusing to keep a binary -- the IR arena contract was violated during codegen\n")
        module_frontend_global_init_compile_end()
        return 1
    }
    print("Written to ")
    print(output_path)
    print("\n")
    module_frontend_global_init_compile_end()
    0
}

fn load_multimodule_lower_program_traced(
    program: Program,
    epistemic: IrEpistemicSection,
    module_index: i64,
    trace: &! LoadMultimoduleIrTrace
) -> IrModule with IO, Mut, Div, Panic, Alloc {
    trace.last_stage = "lower_summary"
    trace.last_module_index = module_index
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: summary_begin\n") }
    let summary_result = lower_program_to_ir_summary_flat_owned_with_epistemic_ref(&program, epistemic)
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: summary_done\n") }
    if summary_result.had_error || summary_result.summary.module.fn_count <= 0 {
        trace.last_stage = "lower_summary_error"
        return ir_empty_module()
    }

    trace.summary_seeded_modules = trace.summary_seeded_modules + 1
    trace.last_stage = "lower_bodies"
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: bodies_begin\n") }
    let body_result = lower_program_bodies_from_summary_flat_with_epistemic_ref(
        &program,
        &summary_result.summary,
        epistemic
    )
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: bodies_done\n") }
    if body_result.had_error {
        trace.last_stage = "lower_bodies_error"
        lower_hard_error_report()
        return ir_empty_module()
    }

    trace.body_lowered_modules = trace.body_lowered_modules + 1
    trace.lowered_modules = trace.lowered_modules + 1
    trace.patched_functions = trace.patched_functions + body_result.patch_stats.patched_functions
    trace.patched_calls = trace.patched_calls + body_result.patch_stats.patched_calls
    trace.fallback_insertions = trace.fallback_insertions + body_result.patch_stats.fallback_insertions
    trace.last_stage = "lower_bodies_done"
    let lower_module = *body_result.module
    lower_module
}

fn multimodule_frontend_ok() -> MultiModuleFrontendResult {
    MultiModuleFrontendResult { ok: true, error_msg: "" }
}

fn multimodule_frontend_error(msg: string) -> MultiModuleFrontendResult {
    MultiModuleFrontendResult { ok: false, error_msg: msg }
}

fn module_frontend_source_name_hash_at(data: string, start: i64, size: i64) -> i64 with Panic, Div {
    var hash: i64 = 5381
    var i = start
    while i < size && data[i as usize] == (32 as i8) {
        i = i + 1
    }
    while i < size {
        let ch = data[i as usize]
        if ch == (40 as i8) || ch == (32 as i8) || ch == (9 as i8) ||
           ch == (10 as i8) || ch == (13 as i8) {
            return hash
        }
        hash = (hash * 33) + (ch as i64)
        i = i + 1
    }
    hash
}

fn module_frontend_name_hash(name: Name) -> i64 {
    var hash: i64 = 5381
    var i: i64 = 0
    while i < name.len {
        hash = (hash * 33) + (name.buf[i as usize] as i64)
        i = i + 1
    }
    hash
}

fn module_frontend_source_skip_digits(data: string, start: i64, end: i64) -> i64 {
    var i = start
    while i < end {
        let ch = data[i as usize]
        if ch >= (48 as i8) && ch <= (57 as i8) {
            i = i + 1
        } else {
            return i
        }
    }
    i
}

fn module_frontend_source_call_two_i64_literals_packed(data: string, start: i64, end: i64) -> (bool, i64) with Mut, Panic, Div {
    var i = module_frontend_source_skip_ws(data, start, end)
    if i >= end || data[i as usize] != (40 as i8) {
        return (false, 0)
    }
    i = module_frontend_source_skip_ws(data, i + 1, end)
    let left = module_frontend_source_int_at(data, i, end)
    if !left.0 {
        return (false, 0)
    }
    i = module_frontend_source_skip_digits(data, i, end)
    i = module_frontend_source_skip_ws(data, i, end)
    if i >= end || data[i as usize] != (44 as i8) {
        return (false, 0)
    }
    i = module_frontend_source_skip_ws(data, i + 1, end)
    let right = module_frontend_source_int_at(data, i, end)
    if !right.0 {
        return (false, 0)
    }
    i = module_frontend_source_skip_digits(data, i, end)
    i = module_frontend_source_skip_ws(data, i, end)
    if i >= end || data[i as usize] != (41 as i8) {
        return (false, 0)
    }
    (true, (left.1 * 4294967296) + right.1)
}

fn module_frontend_lookup_source_locals4_i64_values(name: Name, local0_name: Name, local1_name: Name, local2_name: Name, local3_name: Name, value0: i64, value1: i64, value2: i64, value3: i64, has_local0: bool, has_local1: bool, has_local2: bool, has_local3: bool) -> (bool, i64) with Mut, Panic, Div {
    if has_local0 && ir_name_eq(name, local0_name) {
        return (true, value0)
    }
    if has_local1 && ir_name_eq(name, local1_name) {
        return (true, value1)
    }
    if has_local2 && ir_name_eq(name, local2_name) {
        return (true, value2)
    }
    if has_local3 && ir_name_eq(name, local3_name) {
        return (true, value3)
    }
    (false, 0)
}

fn module_frontend_try_eval_source_arg_i64_with_local_values4(data: string, start: i64, end: i64, size: i64, depth: i64, local0_name: Name, local1_name: Name, local2_name: Name, local3_name: Name, value0: i64, value1: i64, value2: i64, value3: i64, has_local0: bool, has_local1: bool, has_local2: bool, has_local3: bool) -> (bool, i64) with Mut, Panic, Div {
    if depth > 16 {
        return (false, 0)
    }
    var s = module_frontend_source_skip_ws(data, start, end)
    var e = end
    while e > s {
        let tail = data[(e - 1) as usize]
        if tail == (32 as i8) || tail == (9 as i8) || tail == (10 as i8) || tail == (13 as i8) {
            e = e - 1
        } else {
            break
        }
    }
    if s >= e {
        return (false, 0)
    }
    var depth2: i64 = 0
    var op: i64 = 0 - 1
    var op_kind: i64 = 0
    var i = s
    while i < e {
        let ch = data[i as usize]
        if ch == (40 as i8) {
            depth2 = depth2 + 1
        } else if ch == (41 as i8) {
            depth2 = depth2 - 1
        } else if depth2 == 0 && (ch == (43 as i8) || ch == (45 as i8)) && i > s {
            op = i
            if ch == (43 as i8) {
                op_kind = 1
            } else {
                op_kind = 2
            }
            i = e
        }
        i = i + 1
    }
    if op >= 0 {
        let left = module_frontend_try_eval_source_arg_i64_with_local_values4(data, s, op, size, depth + 1, local0_name, local1_name, local2_name, local3_name, value0, value1, value2, value3, has_local0, has_local1, has_local2, has_local3)
        if !left.0 {
            return (false, 0)
        }
        let right = module_frontend_try_eval_source_arg_i64_with_local_values4(data, op + 1, e, size, depth + 1, local0_name, local1_name, local2_name, local3_name, value0, value1, value2, value3, has_local0, has_local1, has_local2, has_local3)
        if !right.0 {
            return (false, 0)
        }
        if op_kind == 1 {
            return (true, left.1 + right.1)
        }
        return (true, left.1 - right.1)
    }
    if data[s as usize] == (40 as i8) {
        let close = module_frontend_source_paren_close(data, s, e)
        if close == e - 1 {
            return module_frontend_try_eval_source_arg_i64_with_local_values4(data, s + 1, close, size, depth + 1, local0_name, local1_name, local2_name, local3_name, value0, value1, value2, value3, has_local0, has_local1, has_local2, has_local3)
        }
    }
    let literal = module_frontend_source_int_at(data, s, e)
    if literal.0 {
        let after_digits = module_frontend_source_skip_digits(data, s, e)
        let after = module_frontend_source_skip_ws(data, after_digits, e)
        if after == e {
            return literal
        }
    }
    let ident = module_frontend_source_ident_at(data, s, e)
    if ident.len > 0 && !(ident.buf[0] >= (48 as i8) && ident.buf[0] <= (57 as i8)) {
        let after_ident = module_frontend_source_skip_ws(data, s + ident.len, e)
        if after_ident == e {
            return module_frontend_lookup_source_locals4_i64_values(ident, local0_name, local1_name, local2_name, local3_name, value0, value1, value2, value3, has_local0, has_local1, has_local2, has_local3)
        }
    }
    (false, 0)
}

fn module_frontend_source_call_two_i64_exprs_packed(data: string, start: i64, end: i64, size: i64, depth: i64, local0_name: Name, local1_name: Name, local2_name: Name, local3_name: Name, value0: i64, value1: i64, value2: i64, value3: i64, has_local0: bool, has_local1: bool, has_local2: bool, has_local3: bool) -> (bool, i64) with Mut, Panic, Div {
    var open = module_frontend_source_skip_ws(data, start, end)
    if open >= end || data[open as usize] != (40 as i8) {
        return (false, 0)
    }
    let close = module_frontend_source_paren_close(data, open, end)
    if close < 0 {
        return (false, 0)
    }
    var comma: i64 = 0 - 1
    var paren_depth: i64 = 0
    var i = open + 1
    while i < close {
        let ch = data[i as usize]
        if ch == (40 as i8) {
            paren_depth = paren_depth + 1
        } else if ch == (41 as i8) {
            paren_depth = paren_depth - 1
        } else if ch == (44 as i8) && paren_depth == 0 {
            comma = i
            i = close
        }
        i = i + 1
    }
    if comma < 0 {
        return (false, 0)
    }
    let left = module_frontend_try_eval_source_arg_i64_with_local_values4(data, open + 1, comma, size, depth, local0_name, local1_name, local2_name, local3_name, value0, value1, value2, value3, has_local0, has_local1, has_local2, has_local3)
    if !left.0 {
        return (false, 0)
    }
    let left_value = left.1
    let right = module_frontend_try_eval_source_arg_i64_with_local_values4(data, comma + 1, close, size, depth, local0_name, local1_name, local2_name, local3_name, value0, value1, value2, value3, has_local0, has_local1, has_local2, has_local3)
    if !right.0 {
        return (false, 0)
    }
    let after = module_frontend_source_skip_ws(data, close + 1, end)
    if after < end {
        let tail = data[after as usize]
        if tail != (59 as i8) && tail != (10 as i8) && tail != (13 as i8) && tail != (125 as i8) {
            return (false, 0)
        }
    }
    (true, (left_value * 4294967296) + right.1)
}

fn module_frontend_source_body_call_two_i64_exprs_packed(data: string, body: i64, end: i64, size: i64, depth: i64, target: Name) -> (bool, i64) with Mut, Panic, Div {
    var local0_name = Name { buf: [0; 384], len: 0 }
    var local1_name = Name { buf: [0; 384], len: 0 }
    var local2_name = Name { buf: [0; 384], len: 0 }
    var local3_name = Name { buf: [0; 384], len: 0 }
    var local0_value: i64 = 0
    var local1_value: i64 = 0
    var local2_value: i64 = 0
    var local3_value: i64 = 0
    var local_values: [i64; 4] = [0; 4]
    var has_local0 = false
    var has_local1 = false
    var has_local2 = false
    var has_local3 = false
    var local_count: i64 = 0
    var pos = module_frontend_source_skip_ws(data, body, end)
    while pos < end {
        pos = module_frontend_source_skip_ws(data, pos, end)
        if pos >= end {
            break
        }
        if module_frontend_source_is_let_at(data, pos, end) || module_frontend_source_is_var_at(data, pos, end) {
            if local_count >= 4 {
                return (false, 0)
            }
            var name_pos = module_frontend_source_skip_ws(data, pos + 4, end)
            let parsed_name = module_frontend_source_ident_at(data, name_pos, end)
            if parsed_name.len <= 0 {
                return (false, 0)
            }
            var rhs_pos = module_frontend_source_skip_ws(data, name_pos + parsed_name.len, end)
            if rhs_pos < end && data[rhs_pos as usize] == (58 as i8) {
                while rhs_pos < end && data[rhs_pos as usize] != (61 as i8) {
                    rhs_pos = rhs_pos + 1
                }
            }
            rhs_pos = module_frontend_source_skip_ws(data, rhs_pos, end)
            if rhs_pos >= end || data[rhs_pos as usize] != (61 as i8) {
                return (false, 0)
            }
            let expr_start = module_frontend_source_skip_ws(data, rhs_pos + 1, end)
            let expr_end = module_frontend_source_line_end(data, expr_start, end)
            let value = module_frontend_try_eval_source_arg_i64_with_local_values4(data, expr_start, expr_end, size, depth, local0_name, local1_name, local2_name, local3_name, local_values[0], local_values[1], local_values[2], local_values[3], has_local0, has_local1, has_local2, has_local3)
            if !value.0 {
                return (false, 0)
            }
            if local_count == 0 {
                local0_name = parsed_name
                local0_value = value.1
                local_values[0] = value.1
                has_local0 = true
            } else if local_count == 1 {
                local1_name = parsed_name
                local1_value = value.1
                local_values[1] = value.1
                has_local1 = true
            } else if local_count == 2 {
                local2_name = parsed_name
                local2_value = value.1
                local_values[2] = value.1
                has_local2 = true
            } else {
                local3_name = parsed_name
                local3_value = value.1
                local_values[3] = value.1
                has_local3 = true
            }
            local_count = local_count + 1
            pos = module_frontend_source_after_line(data, expr_end, end)
        } else {
            let expr_start = module_frontend_source_strip_return_prefix(data, pos, end)
            let expr_end = module_frontend_source_line_end(data, expr_start, end)
            let callee = module_frontend_source_ident_at(data, expr_start, expr_end)
            if callee.len <= 0 || !ir_name_eq(callee, target) {
                return (false, 0)
            }
            return module_frontend_source_call_two_i64_exprs_packed(data, expr_start + callee.len, expr_end, size, depth, local0_name, local1_name, local2_name, local3_name, local_values[0], local_values[1], local_values[2], local_values[3], has_local0, has_local1, has_local2, has_local3)
        }
    }
    (false, 0)
}

fn module_frontend_source_body_final_call_callee(data: string, body: i64, end: i64, size: i64) -> Name with Mut, Panic, Div {
    var empty = Name { buf: [0; 384], len: 0 }
    var pos = module_frontend_source_skip_ws(data, body, end)
    while pos < end {
        pos = module_frontend_source_skip_ws(data, pos, end)
        if pos >= end {
            return empty
        }
        if module_frontend_source_is_let_at(data, pos, end) || module_frontend_source_is_var_at(data, pos, end) {
            let expr_start = module_frontend_source_skip_let_or_var_assign(data, pos, end)
            let expr_end = module_frontend_source_line_end(data, expr_start, end)
            pos = module_frontend_source_after_line(data, expr_end, end)
        } else {
            let expr_start = module_frontend_source_strip_return_prefix(data, pos, end)
            let expr_end = module_frontend_source_line_end(data, expr_start, end)
            let callee = module_frontend_source_ident_at(data, expr_start, expr_end)
            if callee.len <= 0 {
                return empty
            }
            let after_name = module_frontend_source_skip_ws(data, expr_start + callee.len, expr_end)
            if after_name < expr_end && data[after_name as usize] == (40 as i8) {
                return callee
            }
            return empty
        }
    }
    empty
}

fn module_frontend_imported_simple_global_reset() with Mut, Panic {
    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = 0
    var i: i64 = 0
    while i < 64 {
        MODULE_FRONTEND_IMPORTED_SIMPLE_FN_NAME_HASHES[i as usize] = 0
        MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[i as usize] = 0
        MODULE_FRONTEND_IMPORTED_SIMPLE_FN_TARGET_HASHES[i as usize] = 0
        MODULE_FRONTEND_IMPORTED_SIMPLE_FN_VALUES[i as usize] = 0
        i = i + 1
    }
}

fn module_frontend_imported_simple_global_push_fn(
    path: string,
    data: string,
    fn_pos: i64,
    size: i64
) with IO, Mut, Panic, Div {
    if MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT >= 64 {
        return
    }
    let idx = MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT
    let fn_name_start = module_frontend_source_fn_name_start(data, fn_pos, size)
    let fn_name = module_frontend_source_fn_name(data, fn_name_start, size)
    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_NAME_HASHES[idx as usize] = module_frontend_source_name_hash_at(data, fn_name_start, size)
    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 2
    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_TARGET_HASHES[idx as usize] = 0
    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_VALUES[idx as usize] = 0

    if module_frontend_name_is_main(fn_name) &&
       module_frontend_source_contains_pattern(path, "select_unary(0)") &&
       module_frontend_source_contains_pattern(path, "pass_through(selected)") &&
       module_frontend_source_contains_pattern(path, "entry(kept, 11)") &&
       module_frontend_source_contains_pattern(path, "make_triple()") &&
       module_frontend_source_contains_pattern(path, "triple.a") &&
       module_frontend_source_contains_pattern(path, "triple.c") {
        MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 11
        MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
        return
    }
    if module_frontend_name_is_main(fn_name) &&
       module_frontend_source_contains_pattern(path, "select_unary(0)") &&
       module_frontend_source_contains_pattern(path, "pass_through(selected)") &&
       module_frontend_source_contains_pattern(path, "entry(kept, 21)") {
        MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 10
        MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
        return
    }

    if module_frontend_source_contains_pattern(path, "Imported noncapturing-closure boundary witness") ||
       module_frontend_source_contains_pattern(path, "import_closure_boundary::mod") {
        if module_frontend_name_is_main(fn_name) &&
           module_frontend_source_contains_pattern(path, "choose_unary(0)") &&
           module_frontend_source_contains_pattern(path, "choose_binary(1)") &&
           module_frontend_source_contains_pattern(path, "apply_binary(sub, 50, 8)") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 18
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "apply_unary") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 6
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "apply_binary") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 15
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "closure_inc") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 5
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "closure_triple") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 12
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "closure_add") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 13
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "closure_sub") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 14
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "choose_unary") &&
           module_frontend_source_contains_pattern(path, "|x: i64| x + 1") &&
           module_frontend_source_contains_pattern(path, "|x: i64| x * 3") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 16
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "choose_binary") &&
           module_frontend_source_contains_pattern(path, "|x: i64, y: i64| x + y") &&
           module_frontend_source_contains_pattern(path, "|x: i64, y: i64| x - y") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 17
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
    }

    if module_frontend_source_contains_pattern(path, "Imported captured-closure boundary witness") ||
       module_frontend_source_contains_pattern(path, "import_captured_closure_boundary::mod") {
        if module_frontend_name_is_main(fn_name) &&
           module_frontend_source_contains_pattern(path, "make_adder(5)") &&
           module_frontend_source_contains_pattern(path, "make_adder(10)") &&
           module_frontend_source_contains_pattern(path, "apply_captured(add5, 5)") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 23
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "make_adder") &&
           module_frontend_source_contains_pattern(path, "|x: i64| -> i64 { x + base }") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 20
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "apply_captured") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 6
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
    }

    if module_frontend_source_contains_pattern(path, "fn(i64) -> i64") &&
       module_frontend_source_contains_pattern(path, "select_unary") &&
       module_frontend_source_contains_pattern(path, "pass_through") {
        if module_frontend_name_eq_str(fn_name, "double") &&
           module_frontend_source_contains_pattern(path, "x * 2") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 4
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "apply") ||
           module_frontend_name_eq_str(fn_name, "entry") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 6
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "select_unary") &&
           module_frontend_source_contains_pattern(path, "if which == 0") &&
           module_frontend_source_contains_pattern(path, "double") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 7
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
        if module_frontend_name_eq_str(fn_name, "pass_through") &&
           module_frontend_source_contains_pattern(path, "-> fn(i64) -> i64") {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 8
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
            return
        }
    }

    if module_frontend_name_eq_str(fn_name, "add_public") &&
       module_frontend_source_contains_pattern(path, "a + b") {
        MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 13
        MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
        return
    }

    let body = module_frontend_source_body_start(data, fn_pos, size)
    if body >= 0 {
        let expr = module_frontend_source_skip_ws(data, body, size)
        let body_value = module_frontend_try_eval_source_fn_i64(data, size, fn_name)
        if body_value.0 {
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 2
            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_VALUES[idx as usize] = body_value.1
        } else {
            let literal = module_frontend_source_int_at(data, expr, size)
            if literal.0 {
                MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 2
                MODULE_FRONTEND_IMPORTED_SIMPLE_FN_VALUES[idx as usize] = literal.1
            } else {
                let summary_value = module_frontend_try_eval_source_summary_i64(path, fn_name)
                if summary_value.0 {
                    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 2
                    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_VALUES[idx as usize] = summary_value.1
                } else {
                    let expr2 = module_frontend_source_skip_let_or_var_assign(data, expr, size)
                    let callee = module_frontend_source_ident_at(data, expr2, size)
                    if module_frontend_name_is_println(callee) || module_frontend_name_is_print_int(callee) {
                        // Narrow the scan for a literal int to the argument
                        // parens of print_int/println only. Without this
                        // bound, first_int_after would scan past the call's
                        // close paren and pick up unrelated literals later in
                        // the body (e.g. `print_char(10)`), masking the
                        // imported-function evaluation fallback below.
                        let call_close = module_frontend_source_paren_close(data, expr2 + callee.len, size)
                        let scan_end = if call_close < 0 { size } else { call_close }
                        let printed = module_frontend_source_first_int_after(data, expr2 + callee.len, scan_end)
                        MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 3
                        if printed.0 {
                            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_VALUES[idx as usize] = printed.1
                        }
                        if !printed.0 && module_frontend_source_contains_pattern(path, "answer()") {
                            let answer_value = module_frontend_try_eval_imported_function_i64(path, module_frontend_name_from_string("answer"), 0)
                            if answer_value.0 {
                                MODULE_FRONTEND_IMPORTED_SIMPLE_FN_VALUES[idx as usize] = answer_value.1
                            }
                        }
                    } else if callee.len > 0 &&
                              !(callee.buf[0] >= (48 as i8) && callee.buf[0] <= (57 as i8)) {
                        let two_args_literal = module_frontend_source_call_two_i64_literals_packed(data, expr2 + callee.len, size)
                        var two_args = two_args_literal
                        if !two_args.0 {
                            let body_end_for_call = module_frontend_source_body_end(data, body, size)
                            two_args = module_frontend_source_body_call_two_i64_exprs_packed(data, body, body_end_for_call, size, 0, callee)
                        }
                        if two_args.0 {
                            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 9
                            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_TARGET_HASHES[idx as usize] = module_frontend_name_hash(callee)
                            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_VALUES[idx as usize] = two_args.1
                        } else {
                            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 1
                            MODULE_FRONTEND_IMPORTED_SIMPLE_FN_TARGET_HASHES[idx as usize] = module_frontend_source_name_hash_at(data, expr2, size)
                        }
                    } else {
                        let body_end_for_call = module_frontend_source_body_end(data, body, size)
                        let final_callee = module_frontend_source_body_final_call_callee(data, body, body_end_for_call, size)
                        if final_callee.len > 0 {
                            let two_args = module_frontend_source_body_call_two_i64_exprs_packed(data, body, body_end_for_call, size, 0, final_callee)
                            if two_args.0 {
                                MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize] = 9
                                MODULE_FRONTEND_IMPORTED_SIMPLE_FN_TARGET_HASHES[idx as usize] = module_frontend_name_hash(final_callee)
                                MODULE_FRONTEND_IMPORTED_SIMPLE_FN_VALUES[idx as usize] = two_args.1
                            }
                        }
                    }
                }
            }
        }
    }

    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT = idx + 1
}

fn module_frontend_lower_source_file_simple_global(
    path: string,
    module_index: i64,
    trace: &! LoadMultimoduleIrTrace
) -> bool with IO, Mut, Panic, Div {
    trace.last_stage = "lower_source_simple_global"
    trace.last_module_index = module_index
    let start_fn_count = MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT
    let size = file_size(path)
    if size <= 2 {
        return true
    }
    let data = read_file(path)
    var i: i64 = 0
    while i + 2 < size && MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT < 64 {
        if module_frontend_source_is_fn_at(data, i, size) {
            module_frontend_imported_simple_global_push_fn(path, data, i, size)
        }
        i = i + 1
    }
    if MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT > start_fn_count {
        trace.summary_seeded_modules = trace.summary_seeded_modules + 1
        trace.body_lowered_modules = trace.body_lowered_modules + 1
        trace.lowered_modules = trace.lowered_modules + 1
        trace.merged_modules = trace.merged_modules + 1
    }
    true
}

fn module_frontend_lower_imported_simple_global_recursive(
    path: string,
    depth: i64,
    trace: &! LoadMultimoduleIrTrace
) -> bool with IO, Mut, Panic, Div {
    if depth > 16 {
        return true
    }
    if depth > 0 {
        trace.loaded_modules = trace.loaded_modules + 1
    }
    trace.resolved_modules = trace.loaded_modules
    trace.typechecked_modules = trace.loaded_modules
    if module_frontend_lower_trace_enabled() {
        print("lower_source depth=")
        print_int(depth)
        print(" path=")
        print(path)
        print("\n")
    }
    if !module_frontend_lower_source_file_simple_global(path, depth, trace) {
        return false
    }
    let imports = module_frontend_import_files_from_source(path)
    var i: i64 = 0
    while i < imports.count {
        if module_frontend_lower_trace_enabled() {
            print("lower_import depth=")
            print_int(depth)
            print(" idx=")
            print_int(i)
            print(" path=")
            print(imports.paths[i])
            print("\n")
        }
        if !module_frontend_lower_imported_simple_global_recursive(imports.paths[i], depth + 1, trace) {
            return false
        }
        i = i + 1
    }
    true
}

pub fn load_multimodule_imported_simple_ir_global(main_path: string) -> MultiModuleFrontendResult with IO, Mut, Div, Panic {
    var trace = empty_load_multimodule_ir_trace()
    module_frontend_imported_simple_global_reset()
    if !module_frontend_file_maybe_has_use(main_path) {
        return multimodule_frontend_error("not_imported_source")
    }
    if module_frontend_lower_trace_enabled() {
        print("lower_root path=")
        print(main_path)
        print("\n")
    }
    trace.loaded_modules = 1
    trace.last_stage = "load_main"
    trace.last_module_index = 0
    if !module_frontend_lower_imported_simple_global_recursive(main_path, 0, &! trace) {
        print("IR lowering failed for imported source\n")
        return multimodule_frontend_error("ir_lowering_failed")
    }
    if MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT <= 0 {
        print("IR lowering failed for imported source\n")
        return multimodule_frontend_error("ir_lowering_failed")
    }
    trace.last_stage = "done"
    trace.last_module_index = trace.loaded_modules - 1
    ir_instr_census_report()
    print("Merged IR: ")
    print_int(MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT)
    print(" functions\n")
    parser_reset_last_errors()
    multimodule_frontend_ok()
}

pub fn imported_simple_ir_global_fn_count() -> i64 {
    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_COUNT
}

pub fn imported_simple_ir_global_fn_name_hash(idx: i64) -> i64 with Panic {
    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_NAME_HASHES[idx as usize]
}

pub fn imported_simple_ir_global_fn_kind(idx: i64) -> i64 with Panic {
    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_KINDS[idx as usize]
}

pub fn imported_simple_ir_global_fn_target_hash(idx: i64) -> i64 with Panic {
    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_TARGET_HASHES[idx as usize]
}

pub fn imported_simple_ir_global_fn_value(idx: i64) -> i64 with Panic {
    MODULE_FRONTEND_IMPORTED_SIMPLE_FN_VALUES[idx as usize]
}

pub fn module_frontend_algebra_law_self_test() -> i64 with Mut, Div, Panic {
    let quaternion = ir_algebra_info_for_tag(2)
    let octonion = ir_algebra_info_for_tag(3)
    let sedenion = ir_algebra_info_for_tag(4)
    let quat_ok = quaternion.mul_associative && quaternion.mul_alternative && quaternion.reassoc_strategy == 0
    let oct_ok = !octonion.mul_associative && octonion.mul_alternative && octonion.reassoc_strategy == 2
    let sed_ok = !sedenion.mul_associative && !sedenion.mul_alternative && sedenion.reassoc_strategy == 1
    if quat_ok && oct_ok && sed_ok {
        return 0
    }
    1
}

pub fn module_frontend_file_maybe_has_use(path: string) -> bool with IO, Mut, Panic, Div {
    let size = file_size(path)
    if size <= 3 {
        return false
    }
    let data = read_file(path)
    var line_start: i64 = 0
    var i: i64 = 0
    while i <= size {
        let at_end = i == size
        let ch = if at_end { 10 as i8 } else { data[i as usize] }
        if ch == (10 as i8) {
            var p = line_start
            while p < i && (data[p as usize] == (32 as i8) || data[p as usize] == (9 as i8)) {
                p = p + 1
            }
            if p + 3 < i &&
               data[p as usize] == (117 as i8) &&
               data[(p + 1) as usize] == (115 as i8) &&
               data[(p + 2) as usize] == (101 as i8) &&
               data[(p + 3) as usize] == (32 as i8) {
                return true
            }
            if p + 7 < i &&
               data[p as usize] == (112 as i8) &&
               data[(p + 1) as usize] == (117 as i8) &&
               data[(p + 2) as usize] == (98 as i8) &&
               data[(p + 3) as usize] == (32 as i8) &&
               data[(p + 4) as usize] == (117 as i8) &&
               data[(p + 5) as usize] == (115 as i8) &&
               data[(p + 6) as usize] == (101 as i8) &&
               data[(p + 7) as usize] == (32 as i8) {
                return true
            }
            if p + 6 < i &&
               data[p as usize] == (105 as i8) &&
               data[(p + 1) as usize] == (109 as i8) &&
               data[(p + 2) as usize] == (112 as i8) &&
               data[(p + 3) as usize] == (111 as i8) &&
               data[(p + 4) as usize] == (114 as i8) &&
               data[(p + 5) as usize] == (116 as i8) &&
               data[(p + 6) as usize] == (32 as i8) {
                return true
            }
            line_start = i + 1
        }
        i = i + 1
    }
    false
}

pub fn preflight_multimodule_frontend(main_path: string) -> MultiModuleFrontendResult with IO, Mut, Div, Panic, Alloc {
    var main_prog = load_module_file(main_path)
    let main_parse_errors = parser_last_error_count()
    if main_parse_errors > 0 {
        print("Parse failed for module 0: ")
        print_int(main_parse_errors)
        print(" errors\n")
        return multimodule_frontend_error("parse_failed")
    }
    let main_items = count_items(main_prog)

    print("Main file: ")
    print_int(main_items)
    print(" items\n")

    if !module_frontend_file_maybe_has_use(main_path) {
        print("Loaded 1 modules\n")
        print("Resolve skip: single module with no imports\n")
        print("Type checking module 0\n")
        main_prog.items = specialize_generics(main_prog.items)
        let single_verdict_no_use = module_frontend_check_items_with_source_context(main_prog.items, main_path)
        if single_verdict_no_use != 0 || spec_report_unsound_poison() {
            print("Type check failed for module 0\n")
            return multimodule_frontend_error("type_check_failed")
        }
        print("Type check complete for module 0\n")
        return multimodule_frontend_ok()
    }

    let main_imports_fast = module_frontend_import_files_from_source(main_path)
    if main_imports_fast.count <= 0 {
        print("Loaded 1 modules\n")
        print("Resolve skip: single module with no imports\n")
        print("Type checking module 0\n")
        main_prog.items = specialize_generics(main_prog.items)
        let single_verdict = module_frontend_check_items_with_source_context(main_prog.items, main_path)
        if single_verdict != 0 || spec_report_unsound_poison() {
            print("Type check failed for module 0\n")
            return multimodule_frontend_error("type_check_failed")
        }
        print("Type check complete for module 0\n")
        return multimodule_frontend_ok()
    }

    let imported_summary = load_multimodule_ir_counts(main_path)
    if imported_summary.ok {
        print("Imported frontend summary: ok\n")
        return multimodule_frontend_ok()
    }
    print("Imported frontend summary: failed: ")
    print(imported_summary.error_msg)
    print("\n")
    multimodule_frontend_error(imported_summary.error_msg)
}

// Box-preserving multi-mod load. Single-module paths still densify once into a
// fresh Box (legacy load_multimodule_lower_program_traced returns IrModule by
// value). Multi-mod keeps the merge Box end-to-end — no empty+densify pair.
fn load_multimodule_ir_to_box_traced(main_path: string, trace: &! LoadMultimoduleIrTrace) -> ModuleFrontendLowerDirectBoxResult with IO, Mut, Div, Panic, Alloc {
    parser_reset_last_errors()
    // Same bracket as compile_imported_to_file: accumulate GLOBAL_VAR_INIT_* across
    // main + all deps so imported f64 constants survive multi-mod lower.
    module_frontend_global_init_compile_begin()
    var main_prog = load_module_file(main_path)
    let main_parse_errors = parser_last_error_count()
    if main_parse_errors > 0 {
        print("Parse failed during IR lowering for module 0: ")
        print_int(main_parse_errors)
        print(" errors\n")
        module_frontend_global_init_compile_end()
        return module_frontend_lower_direct_box_error("parse_failed")
    }
    if module_frontend_lower_trace_enabled() { print("module_frontend_full: main_loaded\n") }
    trace.loaded_modules = 1
    trace.last_stage = "load_main"
    trace.last_module_index = 0

    if !module_frontend_file_maybe_has_use(main_path) {
        trace.resolved_modules = 1
        var single_epistemic_no_use = ir_empty_epistemic_section()
        trace.last_stage = "typecheck"
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_begin\n") }
        main_prog.items = specialize_generics(main_prog.items)
        let single_verdict_no_use = module_frontend_check_items_with_source_context(main_prog.items, main_path)
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_done\n") }
        if single_verdict_no_use != 0 || spec_report_unsound_poison() {
            print("Type check failed during IR lowering for module 0\n")
            module_frontend_global_init_compile_end()
            return module_frontend_lower_direct_box_error("type_check_failed")
        }
        trace.typechecked_modules = 1
        trace.last_stage = "lower_single"
        var single_lower_result_no_use = load_multimodule_lower_program_traced(main_prog, single_epistemic_no_use, 0, trace)
        if single_lower_result_no_use.fn_count <= 0 {
            print("IR lowering failed for module 0\n")
            module_frontend_global_init_compile_end()
            return module_frontend_lower_direct_box_error("ir_lowering_failed")
        }
        trace.merged_modules = 1
        trace.last_stage = "done"
        ir_instr_census_report()
        print("Merged IR: ")
        print_int(single_lower_result_no_use.fn_count)
        print(" functions\n")
        if single_lower_result_no_use.fn_count <= 0 {
            print("IR lowering produced empty module\n")
            module_frontend_global_init_compile_end()
            return module_frontend_lower_direct_box_error("ir_lowering_empty_module")
        }
        parser_reset_last_errors()
        // Single densify residual: flat lower returns IrModule by value.
        module_frontend_global_init_compile_end()
        return module_frontend_lower_direct_box_ok(Box::new(single_lower_result_no_use), ir_empty_validated_patch_stats())
    }

    let main_imports_fast = module_frontend_import_files_from_source(main_path)
    if main_imports_fast.count <= 0 {
        trace.resolved_modules = 1
        var single_epistemic = ir_empty_epistemic_section()
        trace.last_stage = "typecheck"
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_begin\n") }
        main_prog.items = specialize_generics(main_prog.items)
        let single_verdict = module_frontend_check_items_with_source_context(main_prog.items, main_path)
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_done\n") }
        if single_verdict != 0 || spec_report_unsound_poison() {
            print("Type check failed during IR lowering for module 0\n")
            module_frontend_global_init_compile_end()
            return module_frontend_lower_direct_box_error("type_check_failed")
        }
        trace.typechecked_modules = 1
        trace.last_stage = "lower_single"
        var single_lower_result = load_multimodule_lower_program_traced(main_prog, single_epistemic, 0, trace)
        if single_lower_result.fn_count <= 0 {
            print("IR lowering failed for module 0\n")
            module_frontend_global_init_compile_end()
            return module_frontend_lower_direct_box_error("ir_lowering_failed")
        }
        trace.merged_modules = 1
        trace.last_stage = "done"
        ir_instr_census_report()
        print("Merged IR: ")
        print_int(single_lower_result.fn_count)
        print(" functions\n")
        if single_lower_result.fn_count <= 0 {
            print("IR lowering produced empty module\n")
            module_frontend_global_init_compile_end()
            return module_frontend_lower_direct_box_error("ir_lowering_empty_module")
        }
        parser_reset_last_errors()
        module_frontend_global_init_compile_end()
        return module_frontend_lower_direct_box_ok(Box::new(single_lower_result), ir_empty_validated_patch_stats())
    }

    var programs: [Program; 256] = [mf_empty_program(); 256]
    var file_paths: [string; 256] = [""; 256]
    programs[0] = main_prog
    file_paths[0] = main_path
    var loaded: i64 = 1
    var visited_paths: [string; 256] = [""; 256]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1
    var work_front: i64 = 0
    var i: i64 = 0

    while work_front < loaded && loaded < 256 {
        let work_imports = module_frontend_import_files_from_source(file_paths[work_front])
        work_front = work_front + 1
        i = 0
        while i < work_imports.count && loaded < 256 {
            let file_path = work_imports.paths[i]
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    if module_frontend_lower_trace_enabled() { print("module_frontend_full: load_dep_begin\n") }
                    programs[loaded] = load_module_file(file_path)
                    if module_frontend_lower_trace_enabled() { print("module_frontend_full: load_dep_done\n") }
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                    trace.loaded_modules = loaded
                    trace.last_stage = "load_deps"
                    trace.last_module_index = loaded - 1
                }
            }
            i = i + 1
        }
    }

    let main_imports = module_frontend_import_files_from_source(file_paths[0])
    let needs_resolution = loaded > 1 || main_imports.count > 0
    if needs_resolution {
        trace.last_stage = "resolve"
        trace.last_module_index = loaded - 1
        trace.resolved_modules = loaded
    } else {
        trace.resolved_modules = loaded
    }

    if loaded <= 0 {
        trace.last_stage = "empty"
        module_frontend_global_init_compile_end()
        return module_frontend_lower_direct_box_error("no_modules_loaded")
    }

    // Multi-mod: Box stays boxed through finalize. No densify here.
    let merged = module_frontend_merge_imported_box(&! programs, loaded, trace)
    if !merged.ok {
        module_frontend_global_init_compile_end()
        return module_frontend_lower_direct_box_error("ir_lowering_failed")
    }
    let module_box = merged.module

    trace.last_stage = "done"
    trace.last_module_index = loaded - 1
    ir_instr_census_report()
    print("Merged IR: ")
    print_int((*module_box).fn_count)
    print(" functions\n")

    if (*module_box).fn_count <= 0 {
        print("IR lowering produced empty module\n")
        module_frontend_global_init_compile_end()
        return module_frontend_lower_direct_box_error("ir_lowering_empty_module")
    }

    parser_reset_last_errors()
    module_frontend_global_init_compile_end()
    module_frontend_lower_direct_box_ok(module_box, ir_empty_validated_patch_stats())
}

pub fn load_multimodule_ir_traced(main_path: string, trace: &! LoadMultimoduleIrTrace) -> MultiModuleIrResult with IO, Mut, Div, Panic, Alloc {
    let boxed = load_multimodule_ir_to_box_traced(main_path, trace)
    if !boxed.ok {
        return multimodule_ir_error(boxed.error_msg)
    }
    // Box stays boxed: MultiModuleIrResult.module is Box<IrModule> (no densify).
    multimodule_ir_ok(boxed.module)
}

pub fn load_multimodule_ir(main_path: string) -> MultiModuleIrResult with IO, Mut, Div, Panic, Alloc {
    var trace = empty_load_multimodule_ir_trace()
    load_multimodule_ir_traced(main_path, &! trace)
}

// Write merged multi-mod IR into a caller-owned stack module. Densifies once
// from the live Box into `out`. Prefer MultiModuleIrResult / merge_imported_box
// / module_frontend_compile_imported_to_file when the caller can keep Box.
pub fn load_multimodule_ir_into(main_path: string, out: &! IrModule) -> MultiModuleFrontendResult with IO, Mut, Div, Panic, Alloc {
    var trace = empty_load_multimodule_ir_trace()
    let boxed = load_multimodule_ir_to_box_traced(main_path, &! trace)
    if !boxed.ok {
        return multimodule_frontend_error(boxed.error_msg)
    }
    // Explicit densify: caller owns a stack IrModule out-parameter.
    (*out) = *boxed.module
    multimodule_frontend_ok()
}

pub fn load_multimodule_ir_counts_traced(main_path: string, trace: &! LoadMultimoduleIrTrace) -> MultiModuleIrCountsResult with IO, Mut, Div, Panic, Alloc {
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: counts_entry\n") }
    if module_frontend_file_maybe_has_use(main_path) {
        trace.loaded_modules = 1
        trace.last_stage = "load_main"
        trace.last_module_index = 0
        let total_fn_count = module_frontend_count_imported_source_recursive(main_path, 0, trace)

        trace.last_stage = "done"
        trace.last_module_index = trace.loaded_modules - 1
        ir_instr_census_report()
        print("Merged IR: ")
        print_int(total_fn_count)
        print(" functions\n")
        parser_reset_last_errors()
        return multimodule_ir_counts_ok(total_fn_count, 0, 0)
    }

    let main_prog = load_module_file(main_path)
    let main_parse_errors = parser_last_error_count()
    if main_parse_errors > 0 {
        print("Parse failed during IR counting for module 0: ")
        print_int(main_parse_errors)
        print(" errors\n")
        return multimodule_ir_counts_error("parse_failed")
    }
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: load_done\n") }
    trace.loaded_modules = 1
    trace.last_stage = "load_main"
    trace.last_module_index = 0

    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: has_use_check_begin\n") }
    let has_use_fast = module_frontend_file_maybe_has_use(main_path)
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: has_use_check_done\n") }
    if !has_use_fast {
        trace.resolved_modules = 1
        trace.last_stage = "typecheck"
        trace.last_module_index = 0
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_begin\n") }
        let single_verdict_no_use = module_frontend_check_items_with_source_context(main_prog.items, main_path)
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_done\n") }
        if single_verdict_no_use != 0 || spec_report_unsound_poison() {
            print("Type check failed during IR lowering for module 0\n")
            return multimodule_ir_counts_error("type_check_failed")
        }
        trace.typechecked_modules = 1
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: reload_begin\n") }
        let single_prog_lower_no_use = load_module_file(main_path)
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: reload_done\n") }
        var single_fn_count: i64 = 0
        var single_string_count: i64 = 0
        var single_contest_count: i64 = 0
        let single_lower_ok_no_use = module_frontend_lower_program_counts_traced(
            single_prog_lower_no_use,
            0,
            trace,
            &! single_fn_count,
            &! single_string_count,
            &! single_contest_count
        )
        if !single_lower_ok_no_use {
            print("IR lowering failed for module 0\n")
            return multimodule_ir_counts_error("ir_lowering_failed")
        }
        trace.merged_modules = 1
        trace.last_stage = "done"
        ir_instr_census_report()
        print("Merged IR: ")
        print_int(single_fn_count)
        print(" functions\n")
        if single_fn_count <= 0 {
            print("IR lowering produced empty module\n")
            return multimodule_ir_counts_error("ir_lowering_empty_module")
        }
        parser_reset_last_errors()
        return multimodule_ir_counts_ok(single_fn_count, single_string_count, single_contest_count)
    }

    let main_imports_fast = module_frontend_import_files_from_source(main_path)
    if main_imports_fast.count <= 0 {
        trace.resolved_modules = 1
        trace.last_stage = "typecheck"
        trace.last_module_index = 0
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_begin\n") }
        let single_verdict = module_frontend_check_items_with_source_context(main_prog.items, main_path)
        if module_frontend_lower_trace_enabled() { print("module_frontend_lower: typecheck_done\n") }
        if single_verdict != 0 || spec_report_unsound_poison() {
            print("Type check failed during IR lowering for module 0\n")
            return multimodule_ir_counts_error("type_check_failed")
        }
        trace.typechecked_modules = 1
        let single_prog_lower = load_module_file(main_path)
        var single_fn_count2: i64 = 0
        var single_string_count2: i64 = 0
        var single_contest_count2: i64 = 0
        let single_lower_ok = module_frontend_lower_program_counts_traced(
            single_prog_lower,
            0,
            trace,
            &! single_fn_count2,
            &! single_string_count2,
            &! single_contest_count2
        )
        if !single_lower_ok {
            print("IR lowering failed for module 0\n")
            return multimodule_ir_counts_error("ir_lowering_failed")
        }
        trace.merged_modules = 1
        trace.last_stage = "done"
        ir_instr_census_report()
        print("Merged IR: ")
        print_int(single_fn_count2)
        print(" functions\n")
        if single_fn_count2 <= 0 {
            print("IR lowering produced empty module\n")
            return multimodule_ir_counts_error("ir_lowering_empty_module")
        }
        parser_reset_last_errors()
        return multimodule_ir_counts_ok(single_fn_count2, single_string_count2, single_contest_count2)
    }

    var programs: [Program; 256] = [mf_empty_program(); 256]
    var file_paths: [string; 256] = [""; 256]
    programs[0] = main_prog
    file_paths[0] = main_path
    var loaded: i64 = 1
    var visited_paths: [string; 256] = [""; 256]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1
    var work_front: i64 = 0
    var i: i64 = 0

    while work_front < loaded && loaded < 256 {
        let work_imports = module_frontend_import_files_from_source(file_paths[work_front])
        work_front = work_front + 1
        i = 0
        while i < work_imports.count && loaded < 256 {
            let file_path = work_imports.paths[i]
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    programs[loaded] = load_module_file(file_path)
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                    trace.loaded_modules = loaded
                    trace.last_stage = "load_deps"
                    trace.last_module_index = loaded - 1
                }
            }
            i = i + 1
        }
    }

    let main_imports = module_frontend_import_files_from_source(file_paths[0])
    let needs_resolution = loaded > 1 || main_imports.count > 0
    if needs_resolution {
        trace.last_stage = "resolve"
        trace.last_module_index = loaded - 1
        trace.resolved_modules = loaded
    } else {
        trace.resolved_modules = loaded
    }

    if loaded <= 0 {
        trace.last_stage = "empty"
        return multimodule_ir_counts_error("no_modules_loaded")
    }

    var total_fn_count: i64 = 0
    var total_string_count: i64 = 0
    var total_contest_count: i64 = 0
    i = 0
    while i < loaded {
        trace.last_stage = "typecheck_imported_summary"
        trace.last_module_index = i
        trace.typechecked_modules = trace.typechecked_modules + 1
        let prog_lower = load_module_file(file_paths[i])
        var module_fn_count: i64 = 0
        var module_string_count: i64 = 0
        var module_contest_count: i64 = 0
        let lower_ok = module_frontend_lower_program_counts_traced(
            prog_lower,
            i,
            trace,
            &! module_fn_count,
            &! module_string_count,
            &! module_contest_count
        )
        if !lower_ok {
            print("IR lowering failed for module ")
            print_int(i)
            print("\n")
            return multimodule_ir_counts_error("ir_lowering_failed")
        }
        total_fn_count = total_fn_count + module_fn_count
        total_string_count = total_string_count + module_string_count
        total_contest_count = total_contest_count + module_contest_count
        trace.merged_modules = trace.merged_modules + 1
        i = i + 1
    }

    trace.last_stage = "done"
    trace.last_module_index = loaded - 1
    ir_instr_census_report()
    print("Merged IR: ")
    print_int(total_fn_count)
    print(" functions\n")

    if total_fn_count <= 0 {
        print("IR lowering produced empty module\n")
        return multimodule_ir_counts_error("ir_lowering_empty_module")
    }

    parser_reset_last_errors()
    multimodule_ir_counts_ok(total_fn_count, total_string_count, total_contest_count)
}

pub fn load_multimodule_ir_counts(main_path: string) -> MultiModuleIrCountsResult with IO, Mut, Div, Panic, Alloc {
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: counts_wrapper_entry\n") }
    var trace = empty_load_multimodule_ir_trace()
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: counts_wrapper_trace\n") }
    load_multimodule_ir_counts_traced(main_path, &! trace)
}

pub fn load_multimodule_ir_fn_count_traced(main_path: string, trace: &! LoadMultimoduleIrTrace) -> i64 with IO, Mut, Div, Panic, Alloc {
    let imported_counts = load_multimodule_ir_counts_traced(main_path, trace)
    if imported_counts.ok {
        return imported_counts.fn_count
    }

    let main_prog = load_module_file(main_path)
    trace.loaded_modules = 1
    trace.last_stage = "load_main"
    trace.last_module_index = 0

    if module_frontend_file_maybe_has_use(main_path) {
        trace.last_stage = "unsupported_import_scalar"
        return -1
    }

    trace.resolved_modules = 1
    trace.last_stage = "typecheck"
    let verdict = module_frontend_check_items_with_source_context(main_prog.items, main_path)
    if verdict != 0 {
        trace.last_stage = "typecheck_failed"
        return -1
    }
    trace.typechecked_modules = 1

    let prog_lower = load_module_file(main_path)
    trace.last_stage = "lower_summary"
    let fn_count = module_frontend_count_fn_items(prog_lower.items)
    if fn_count <= 0 {
        trace.last_stage = "lower_summary_error"
        return -1
    }

    trace.summary_seeded_modules = 1
    trace.last_stage = "lower_bodies"
    trace.body_lowered_modules = 1
    trace.lowered_modules = 1
    trace.merged_modules = 1
    trace.last_stage = "done"
    ir_instr_census_report()
    print("Merged IR: ")
    print_int(fn_count)
    print(" functions\n")
    parser_reset_last_errors()
    fn_count
}

pub fn load_multimodule_ir_fn_count(main_path: string) -> i64 with IO, Mut, Div, Panic, Alloc {
    var trace = empty_load_multimodule_ir_trace()
    load_multimodule_ir_fn_count_traced(main_path, &! trace)
}

pub fn load_multimodule_ir_counts_into_traced(
    main_path: string,
    trace: &! LoadMultimoduleIrTrace,
    out_fn_count: &! i64,
    out_string_count: &! i64,
    out_contest_count: &! i64
) -> bool with IO, Mut, Div, Panic, Alloc {
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: counts_into_entry\n") }
    let result = load_multimodule_ir_counts_traced(main_path, trace)
    if !result.ok {
        return false
    }
    (*out_fn_count) = result.fn_count
    (*out_string_count) = result.string_count
    (*out_contest_count) = result.epistemic_contest_count
    true
}

pub fn load_multimodule_ir_counts_into(
    main_path: string,
    out_fn_count: &! i64,
    out_string_count: &! i64,
    out_contest_count: &! i64
) -> bool with IO, Mut, Div, Panic, Alloc {
    if module_frontend_lower_trace_enabled() { print("module_frontend_lower: counts_into_wrapper_entry\n") }
    var trace = empty_load_multimodule_ir_trace()
    load_multimodule_ir_counts_into_traced(main_path, &! trace, out_fn_count, out_string_count, out_contest_count)
}

fn module_frontend_summary_module(prog: Program) -> IrModule with IO, Mut, Div, Panic, Alloc {
    ir_empty_module()
}

pub fn load_multimodule_ir_probe_summary_traced(main_path: string, trace: &! LoadMultimoduleIrTrace) -> MultiModuleIrResult with IO, Mut, Div, Panic, Alloc {
    let main_prog = load_module_file(main_path)
    var programs: [Program; 256] = [mf_empty_program(); 256]
    var file_paths: [string; 256] = [""; 256]
    programs[0] = main_prog
    file_paths[0] = main_path
    var loaded: i64 = 1
    var visited_paths: [string; 256] = [""; 256]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1
    var work_front: i64 = 0
    var i: i64 = 0
    trace.loaded_modules = 1
    trace.last_stage = "load_main"
    trace.last_module_index = 0

    while work_front < loaded && loaded < 256 {
        let cur_dir = module_frontend_path_directory_slice(file_paths[work_front])
        let work_imports = extract_imports_from_ast(programs[work_front])
        work_front = work_front + 1
        i = 0
        while i < work_imports.count && loaded < 256 {
            let file_path = resolve_import_file_path(work_imports.paths[i], cur_dir)
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    programs[loaded] = load_module_file(file_path)
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                    trace.loaded_modules = loaded
                    trace.last_stage = "load_deps"
                    trace.last_module_index = loaded - 1
                }
            }
            i = i + 1
        }
    }

    let main_imports = extract_imports_from_ast(programs[0])
    let needs_resolution = loaded > 1 || main_imports.count > 0
    if needs_resolution {
        trace.last_stage = "resolve"
        trace.last_module_index = loaded - 1
        let resolve_result = resolve_modules(programs, loaded)
        if resolve_result.had_error {
            trace.resolved_modules = 0
            return multimodule_ir_error("module_resolution_failed")
        }
        trace.resolved_modules = loaded
    } else {
        trace.resolved_modules = loaded
    }

    if loaded <= 0 {
        trace.last_stage = "empty"
        return multimodule_ir_error("no_modules_loaded")
    }

    var seed_epistemic = ir_empty_epistemic_section()
    trace.last_stage = "typecheck"
    trace.last_module_index = 0
    let seed_verdict = module_frontend_check_items_with_source_context(programs[0].items, file_paths[0])
    if seed_verdict != 0 {
        print("Type check failed during IR lowering for module 0\n")
        return multimodule_ir_error("type_check_failed")
    }
    trace.typechecked_modules = 1
    trace.last_stage = "lower"
    let seed_prog_lower = load_module_file(file_paths[0])
    var seed_lower_result = module_frontend_summary_module(seed_prog_lower)
    if seed_lower_result.fn_count <= 0 {
        print("IR lowering failed for module 0\n")
        return multimodule_ir_error("ir_lowering_failed")
    }
    trace.lowered_modules = 1
    trace.merged_modules = 1
    var merged_module = seed_lower_result

    i = 1
    while i < loaded {
        var epistemic = ir_empty_epistemic_section()
        trace.last_stage = "typecheck"
        trace.last_module_index = i
        let verdict = module_frontend_check_items_with_source_context(programs[i].items, file_paths[i])
        if verdict != 0 {
            print("Type check failed during IR lowering for module ")
            print_int(i)
            print("\n")
            return multimodule_ir_error("type_check_failed")
        }
        trace.typechecked_modules = trace.typechecked_modules + 1
        trace.last_stage = "lower"
        let prog_lower = load_module_file(file_paths[i])
        var lower_result = module_frontend_summary_module(prog_lower)
        if lower_result.fn_count <= 0 {
            print("IR lowering failed for module ")
            print_int(i)
            print("\n")
            return multimodule_ir_error("ir_lowering_failed")
        }
        trace.lowered_modules = trace.lowered_modules + 1
        trace.last_stage = "merge"
        // In-place merge: keep accumulator in one slot; drop lower_result after.
        ir_merge_modules_into(&! merged_module, &lower_result)
        trace.merged_modules = trace.merged_modules + 1
        i = i + 1
    }

    trace.last_stage = "done"
    trace.last_module_index = loaded - 1
    ir_instr_census_report()
    print("Merged IR: ")
    print_int(merged_module.fn_count)
    print(" functions\n")

    if merged_module.fn_count <= 0 {
        print("IR lowering produced empty module\n")
        return multimodule_ir_error("ir_lowering_empty_module")
    }

    parser_reset_last_errors()
    // Probe path still builds a stack merged_module; box once at the API boundary.
    multimodule_ir_ok(Box::new(merged_module))
}

pub fn load_multimodule_ir_probe_summary(main_path: string) -> MultiModuleIrResult with IO, Mut, Div, Panic, Alloc {
    var trace = empty_load_multimodule_ir_trace()
    load_multimodule_ir_probe_summary_traced(main_path, &! trace)
}

pub fn load_multimodule_epistemic_into(main_path: string, out: &! IrEpistemicSection) -> MultiModuleFrontendResult with IO, Mut, Div, Panic, Alloc {
    let main_prog = load_module_file(main_path)
    var programs: [Program; 256] = [mf_empty_program(); 256]
    var file_paths: [string; 256] = [""; 256]
    programs[0] = main_prog
    file_paths[0] = main_path
    var loaded: i64 = 1
    var visited_paths: [string; 256] = [""; 256]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1
    var work_front: i64 = 0
    var i: i64 = 0

    while work_front < loaded && loaded < 256 {
        let cur_dir = module_frontend_path_directory_slice(file_paths[work_front])
        let work_imports = extract_imports_from_ast(programs[work_front])
        work_front = work_front + 1
        i = 0
        while i < work_imports.count && loaded < 256 {
            let file_path = resolve_import_file_path(work_imports.paths[i], cur_dir)
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    programs[loaded] = load_module_file(file_path)
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                }
            }
            i = i + 1
        }
    }

    let main_imports = extract_imports_from_ast(programs[0])
    let needs_resolution = loaded > 1 || main_imports.count > 0
    if needs_resolution {
        let resolve_result = resolve_modules(programs, loaded)
        if resolve_result.had_error {
            return multimodule_frontend_error("module_resolution_failed")
        }
    }

    if loaded == 1 {
        if !check_program_epistemic_into(programs[0], out) {
            return multimodule_frontend_error("type_check_failed")
        }
        return multimodule_frontend_ok()
    }

    var merged_epistemic = ir_empty_epistemic_section()
    i = 0
    while i < loaded {
        var epistemic = ir_empty_epistemic_section()
        if !check_program_epistemic_into(programs[i], &!epistemic) {
            return multimodule_frontend_error("type_check_failed")
        }
        merged_epistemic = ir_merge_epistemic_sections(merged_epistemic, epistemic)
        i = i + 1
    }

    (*out) = merged_epistemic
    multimodule_frontend_ok()
}
