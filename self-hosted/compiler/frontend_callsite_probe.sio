module frontend_callsite_probe

use parser::ast::*
use parser::parser::{parser_last_error_count}
use ir::ir::*
use module_frontend::{bridge_lower_single_module_box, empty_load_multimodule_ir_trace}

fn frontend_callsite_probe_find_fn(m: &IrModule, name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < (*m).fn_count {
        if ir_name_eq((*m).functions[i as usize].name, name) {
            return i
        }
        i = i + 1
    }
    -1
}

fn frontend_callsite_probe_find_call_idx(m: &IrModule, fn_idx: i64, callee_idx: i64, callee_name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    var first_call_idx: i64 = -1
    var call_count: i64 = 0
    while i < (*m).functions[fn_idx as usize].instr_count {
        if (IR_A_OP[(ir_region_slot_r((*m).functions[fn_idx as usize].region, (i))) as usize] as IrOpcode) == IrOpcode::IrCall {
            if first_call_idx < 0 {
                first_call_idx = i
            }
            call_count = call_count + 1
            if IR_A_FN_ID[(ir_region_slot_r((*m).functions[fn_idx as usize].region, (i))) as usize] == callee_idx ||
               ir_name_eq(ir_arena_name(ir_region_slot_r((*m).functions[fn_idx as usize].region, (i))), callee_name) {
                return i
            }
        }
        i = i + 1
    }
    if call_count == 1 {
        return first_call_idx
    }
    -1
}

fn frontend_callsite_probe_has_load_imm_dst_value(m: &IrModule, fn_idx: i64, dst: i64, value: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < (*m).functions[fn_idx as usize].instr_count {
        if (IR_A_OP[(ir_region_slot_r((*m).functions[fn_idx as usize].region, (i))) as usize] as IrOpcode) == IrOpcode::IrLoadImm &&
           IR_A_DST[(ir_region_slot_r((*m).functions[fn_idx as usize].region, (i))) as usize] == dst &&
           IR_A_IMM_I64[(ir_region_slot_r((*m).functions[fn_idx as usize].region, (i))) as usize] == value {
            return true
        }
        i = i + 1
    }
    false
}

fn frontend_callsite_probe_print_name(name: Name) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < name.len {
        print_char(name.buf[i] as i64)
        i = i + 1
    }
}

pub(crate) fn run_frontend_callsite_probe(source_path: string, caller_name_str: string, callee_name_str: string) with IO, Mut, Panic, Div, Alloc {
    let caller_name = make_name(caller_name_str)
    let callee_name = make_name(callee_name_str)
    println("probe_ir_callsite: begin")
    print("probe_ir_callsite: source=")
    print(source_path)
    print(" caller=")
    print(caller_name_str)
    print(" callee=")
    print(callee_name_str)
    print("\n")

    var trace = empty_load_multimodule_ir_trace()
    let frontend_result = bridge_lower_single_module_box(source_path, &! trace)
    let parse_errors = parser_last_error_count()
    if !frontend_result.ok || parse_errors > 0 {
        println("probe_ir_callsite: fail")
        if str_len(frontend_result.error_msg) > 0 {
            print("probe_ir_callsite: error=")
            print(frontend_result.error_msg)
            print("\n")
        }
        if parse_errors > 0 {
            println("probe_ir_callsite: parser_errors=" + int_to_string(parse_errors))
        }
        panic("probe_ir_callsite failed")
    }

    match frontend_result.module {
        Some(module_box) => {
            let caller_idx = frontend_callsite_probe_find_fn(&(*module_box), caller_name)
            let callee_idx = frontend_callsite_probe_find_fn(&(*module_box), callee_name)
            if caller_idx < 0 || callee_idx < 0 {
                println("probe_ir_callsite: fail")
                println("probe_ir_callsite: error=function_not_found")
                panic("probe_ir_callsite failed")
            }

            let call_idx = frontend_callsite_probe_find_call_idx(&(*module_box), caller_idx, callee_idx, callee_name)
            if call_idx < 0 {
                println("probe_ir_callsite: fail")
                println("probe_ir_callsite: error=call_not_found")
                panic("probe_ir_callsite failed")
            }

            let call = ir_arena_load(ir_region_slot_r((*module_box).functions[caller_idx as usize].region, (call_idx)))
            let forwards_param0 = (*module_box).functions[caller_idx as usize].param_count > 0 &&
                call.src1 == (*module_box).functions[caller_idx as usize].param_regs[0]
            let fallback_load_imm1 = frontend_callsite_probe_has_load_imm_dst_value(
                &(*module_box),
                caller_idx,
                call.src1,
                1,
            )
            print("probe_ir_callsite: caller=")
            frontend_callsite_probe_print_name((*module_box).functions[caller_idx as usize].name)
            print(" callee=")
            frontend_callsite_probe_print_name((*module_box).functions[callee_idx as usize].name)
            print(" caller_strategy=")
            print(ir_strategy_name((*module_box).functions[caller_idx as usize].compile_strategy))
            print(" callee_strategy=")
            print(ir_strategy_name((*module_box).functions[callee_idx as usize].compile_strategy))
            print(" arg_count=")
            print_int(call.arg_count)
            print(" src1=")
            print_int(call.src1)
            print(" src2=")
            print_int(call.src2)
            print(" forwards_param0=")
            if forwards_param0 { print("true") } else { print("false") }
            print(" fallback_load_imm1=")
            if fallback_load_imm1 { print("true") } else { print("false") }
            print("\n")
            println("probe_ir_callsite: ok")
        }
        None => {
            println("probe_ir_callsite: fail")
            println("probe_ir_callsite: error=missing_boxed_module")
            panic("probe_ir_callsite failed")
        }
    }
}
