use check::check::{
    Checker,
    checker_import_bridge_pointer_probe_value
}

fn main() -> i64 with IO {
    print("k2_check_import_pointer_probe=start\n")
    let checker = 0 as *mut Checker
    let value = checker_import_bridge_pointer_probe_value(checker)
    print("k2_check_import_pointer_probe=value=")
    print_int(value)
    print("\n")
    if value == 515151 {
        print("k2_check_import_pointer_probe=ok\n")
        return 0
    }
    print("k2_check_import_pointer_probe=bad\n")
    1
}
