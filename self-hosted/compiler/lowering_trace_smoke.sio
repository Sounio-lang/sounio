// self-hosted::compiler::lowering_trace_smoke
//
// Dedicated Sprint 70 full traced IR lowering smoke.
// Mirrors compiler/main.sio's flat-root import surface so module_loader
// resolves under the current self-hosted runtime.

use lexer::mod::*
use parser::ast::*
use ir::ir::*
use check::dependent::*
use check::types::*
use check::mod::{check_program, check_program_epistemic_into}
use check::ownership::*
use check::lint::*
use check::layout::*
use io::file_write::*
use native::encode::*
use native::elf::*
use native::reloc::*
use native::frame::*
use native::lower_ir::*
use native::machine_ir::*
use native::runtime_context::*
use native::target_policy::*
use wasm::core::*
use wasm::encode::*
use wasm::lower::*
use native::codegen::*
use resolve::resolve::*
use resolve::imports::*
use resolve::symbol::*
use resolve::scope::*
use resolve::mod::{resolve_modules, resolve_program, ResolveBatchResult}
use module_loader::{load_multimodule_ir_traced, empty_load_multimodule_ir_trace}
use parser::parser::{parser_last_error_count}
use ir::opt_strategy::{ir_opt_apply_strategy, ir_opt_find_return_vreg, ir_opt_max_label, ir_opt_max_vreg}
use ir::lower::{ir_patch_validated_calls, lower_program_to_ir, lower_program_to_ir_with_epistemic}
use ir::const_prop::{cp_check_load_imm, cp_empty_instrs, cp_make_test_func, cp_optimize_function}
use ir::dce::{dce_check_nop, dce_empty_instrs, dce_make_test_func, dce_optimize_function}
use ir::profile::*
use ir::inline::*
use ir::layout::*
use ir::opt_cleanup::*
use ir::loop_opt::*
use ir::tailcall::*
use native::regalloc::*
use native::peephole::*

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    var trace = empty_load_multimodule_ir_trace()
    let result = load_multimodule_ir_traced("tests/frontend/lowering_stability_two_fn_loop.sio", &! trace)
    if !result.ok { return 1 }
    if parser_last_error_count() > 0 { return 2 }
    print("lowering_trace_smoke: stage=")
    print(trace.last_stage)
    print(" summary=")
    print_int(trace.summary_seeded_modules)
    print(" bodies=")
    print_int(trace.body_lowered_modules)
    print(" lowered=")
    print_int(trace.lowered_modules)
    print("\n")
    0
}
