       plan.first_disjoint_right_numeric_id == 12 &&
       plan.payload_shape_valid &&
       plan.mini_table_valid &&
       plan.mini_class_count == 112 &&
       plan.mini_class0 == 1 &&
       plan.mini_class1 == 2 &&
       plan.mini_class2 == 3 &&
       plan.mini_class3 == 4 &&
       plan.mini_parent_edge_count == 111 &&
       plan.mini_parent_child0 == 2 &&
       plan.mini_parent_parent0 == 1 &&
       plan.mini_parent_child1 == 3 &&
       plan.mini_parent_parent1 == 2 &&
       plan.mini_disjoint_pair_count == 1 &&
       plan.mini_disjoint_left0 == 3 &&
       plan.mini_disjoint_right0 == 12 &&
       plan.mini_table_truncated &&
       q_first_edge_direct &&
       !q_snomed_chain &&
       q_part_chain &&
       q_first_disjoint &&
       q_first_disjoint_symmetric &&
       plan.kernel_stage_valid &&
       plan.kernel_slot_count == 5 &&
       plan.kernel_slot0 == 1 &&
       plan.kernel_slot1 == 2 &&
       plan.kernel_slot2 == 3 &&
       plan.kernel_slot3 == 4 &&
       plan.kernel_slot4 == 12 &&
       plan.kernel_subclass_axiom_count == 3 &&
       plan.kernel_subclass_subject0 == 1 &&
       plan.kernel_subclass_object0 == 0 &&
       plan.kernel_subclass_subject1 == 2 &&
       plan.kernel_subclass_object1 == 1 &&
       plan.kernel_subclass_subject2 == 3 &&
       plan.kernel_subclass_object2 == 2 &&
       plan.kernel_disjoint_axiom_count == 1 &&
       plan.kernel_disjoint_subject0 == 2 &&
       plan.kernel_disjoint_object0 == 4 &&
       k_first_edge_direct &&
       !k_snomed_chain &&
       k_part_chain &&
       k_first_disjoint &&
       k_first_disjoint_symmetric &&
       plan.kernel_materialized_valid &&
       plan.kernel_materialized_reflexive_count == 5 &&
       plan.kernel_materialized_subclass_fact_count == 11 &&
       plan.kernel_materialized_disjoint_fact_count == 2 &&
       km_first_edge &&
       !km_snomed_chain &&
       km_part_chain &&
       km_first_disjoint &&
       km_first_disjoint_symmetric {
        return 0
    }
    1
}
