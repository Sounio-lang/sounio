// self-hosted::compiler::native_compile_driver_slim_flat
//
// Slim native compile driver using flat_lex_parse module.
// Avoids idiomatic features (methods, enums, Box) that lean compiler can't codegen.
// Uses flat_lex_parse::flat_lex_file and flat_lex_parse::flat_parse_tokens instead of
// lexer::mod and parser::mod.
//
// Pipeline: flat_lex → flat_parse → ... (remaining pipeline same as slim driver)
//
// Usage (natively compiled):
//   ./native_driver_flat.elf <source.sio> [-o <output>]
//   ./native_driver_flat.elf <source.sio> <output>

use compiler::flat_lex_parse::{flat_lex_file, flat_parse_tokens}

fn main() -> i64 with IO, Mut {
    let argc = arg_count()
    if argc < 1 {
        print("native_compile_flat: usage: native_compile_driver_slim_flat.sio <source.sio> [-o <output>]\n")
        print("native_compile_flat: usage: native_compile_driver_slim_flat.sio <source.sio> <output>\n")
        return 1
    }
    let source_path = get_arg(0)

    // Parse output path: supports both "-o <output>" and positional "<output>"
    var output_path = "a.out"
    if argc >= 3 {
        let flag = get_arg(1)
        if flag == "-o" {
            output_path = get_arg(2)
        }
    }
    if argc == 2 {
        // Positional: <source> <output> (backward compat)
        let arg1 = get_arg(1)
        if arg1 != "-o" {
            output_path = arg1
        }
    }

    print("native_compile_flat: source=")
    print(source_path)
    print(" output=")
    print(output_path)
    print("\n")

    // Phase 0: Flat lex
    let tc = flat_lex_file(source_path)
    if tc <= 0 {
        print("native_compile_flat: lex_error\n")
        return 1
    }
    print("native_compile_flat: lex_ok token_count=")
    print_int(tc)
    print("\n")

    // Phase 1: Flat parse
    let prog = flat_parse_tokens(tc)
    if prog.fn_count <= 0 {
        print("native_compile_flat: parse_error (no functions)\n")
        return 1
    }
    print("native_compile_flat: parse_ok fn_count=")
    print_int(prog.fn_count)
    print("\n")

    // NOTE: Full compilation pipeline (IR, codegen, ELF) intentionally skipped.
    // This driver is a minimal test of flat_lex_parse integration.
    // Return success once parsing completes without error.

    print("native_compile_flat: ok\n")
    0
}
