// Focused E2B probe for compiler-owned finite v1 control-flow lowering.

use enir::ir::*
use enir::parser::*
use enir::canonical::*
use enir::verify::*
use enir::source_lower::*

fn main() with IO, Mut, Panic, Div, Alloc {
    let source = "epistemic fn cfg_probe() {\nlet zero = 0.0\nlet neg = -1.0\nwhile zero != 0.0 {\n}\nif neg < 0.0 {\n}\ngate neg\ngate zero\n}\n"
    let lowered = enir_lower_source_v1(source)
    assert(lowered.ok)
    assert(lowered.module.stage == ENIR_STAGE_LOWERED)
    assert(lowered.module.profile == enir_profile_eisa_v1())
    assert(lowered.module.program_count == 1)
    assert(lowered.module.observation_count == 2)
    assert(enir_verify(lowered.module) == 0)

    var brz: i64 = 0
    var brn: i64 = 0
    var br: i64 = 0
    var halt: i64 = 0
    var i: i64 = 0
    while i < lowered.module.op_count {
        let op = lowered.module.ops[i as usize]
        if op.opcode == enir_op_ebrz() {
            assert(op.target > op.id && op.target < lowered.module.op_count)
            brz = brz + 1
        } else if op.opcode == enir_op_ebrn() {
            assert(op.target == op.id + 2)
            brn = brn + 1
        } else if op.opcode == enir_op_ebr() {
            assert(op.target >= 0 && op.target < lowered.module.op_count)
            br = br + 1
        } else if op.opcode == enir_op_ehalt() {
            halt = halt + 1
        }
        i = i + 1
    }
    assert(brz == 1)
    assert(brn == 1)
    assert(br == 2)
    assert(halt == 1)

    let canonical = enir_print_canonical(lowered.module)
    let parsed = enir_parse(canonical)
    assert(parsed.ok)
    assert(enir_verify(parsed.module) == 0)
    assert(enir_print_canonical(parsed.module) == canonical)
    println("ENIR_E2B_V1_CFG_PROBE_PASS")
}
