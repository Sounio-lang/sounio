    we(0x45)
    we(0xfb)
    we(0x80)
    we(0xc2)
    we(0x30)
    we(0x88)
    we(0x55)
    we(0xfc)
    we(0x48)
    we(0x8d)
    we(0x75)
    we(0xf7)
    we(0xba)
    we(0x06)
    we(0x00)
    we(0x00)
    we(0x00)
    we(0xbf)
    we(0x01)
    we(0x00)
    we(0x00)
    we(0x00)
    we(0xb8)
    we(0x01)
    we(0x00)
    we(0x00)
    we(0x00)
    we(0x0f)
    we(0x05)
    we(0xc6)
    we(0x45)
    we(0xfd)
    we(0x0a)
    we(0x48)
    we(0x8d)
    we(0x75)
    we(0xfd)
    we(0xba)
    we(0x01)
    we(0x00)
    we(0x00)
    we(0x00)
    we(0xbf)
    we(0x01)
    we(0x00)
    we(0x00)
    we(0x00)
    we(0xb8)
    we(0x01)
    we(0x00)
    we(0x00)
    we(0x00)
    we(0x0f)
    we(0x05)
    we(0xc9)
    we(0xc3)
}

// --- Emit inline string print (push to stack + sys_write) ---
fn mc_emit_print_str(str_start: i64, str_end: i64) with Mut, Panic, Div {
    // Decode string bytes (handle \n, \t, \\, \0)
    var str_buf: [i8; 512] = [0; 512]
    var str_len: i64 = 0
    var si: i64 = str_start
    while si < str_end && str_len < 512 {
        let ch = (LEAN_SOURCE[(si) as usize] as i64)
        if ch == 92 as i8 && si + 1 < str_end {
            let ch2 = (LEAN_SOURCE[(si + 1) as usize] as i64)
            if ch2 == 110 { str_buf[str_len as usize] = 10 }
            else if ch2 == 116 as i8 { str_buf[str_len as usize] = 9 as i8 }
            else if ch2 == 92 as i8 { str_buf[str_len as usize] = 92 as i8 }
            else if ch2 == 48 as i8 { str_buf[str_len as usize] = 0 }
            else if ch2 == 34 as i8 { str_buf[str_len as usize] = 34 as i8 }
            else { str_buf[str_len as usize] = ch2 }
            si = si + 2
        } else {
            str_buf[str_len as usize] = ch
            si = si + 1
        }
        str_len = str_len + 1
    }
    if str_len == 0 { return 0 }
    // Push string bytes onto stack in 8-byte chunks (reverse order)
    let n_chunks = (str_len + 7) / 8
    var chi: i64 = n_chunks - 1
    while chi >= 0 {
        var qw: i64 = 0
        var bi: i64 = 0
        while bi < 8 {
            let idx = chi * 8 + bi
            if idx < str_len {
                qw = qw | ((str_buf[idx as usize] as i64 & 0xFF) << (bi * 8))
            }
            bi = bi + 1
        }
        we(0x48)
        we(0xb8); we64(qw)  // mov rax, imm64
        we(0x50)                        // push rax
        chi = chi - 1
    }
    // write(1, rsp, str_len)
    we(0xb8); we32(1)                   // mov eax, 1
    we(0xbf); we32(1)                   // mov edi, 1
    we(0x48)
    we(0x89)
    we(0xe6)        // mov rsi, rsp
    we(0xba); we32(str_len)             // mov edx, str_len
    we(0x0f)
    we(0x05)                  // syscall
    // Clean up stack
    let stack_used = n_chunks * 8
    we(0x48)
    we(0x81)
    we(0xc4); we32(stack_used)
}

// --- Expression parser: emits code leaving result in rax ---

// Forward-declare: mc_parse_expr is recursive through mc_parse_primary
// (Sounio supports forward refs to functions in the same module.)

fn mc_parse_primary() with Mut, Panic, Div {
    let k = MP_KIND[MC_POS as usize]

    // Integer literal
    if k == 121 {
        let val = MP_INT_VALUE[MC_POS as usize]
        MC_POS = MC_POS + 1
        // mov rax, imm64
        we(0x48)
        we(0xb8); we64(val)
        MC_EXPR_IS_F64 = 0
        MC_EXPR_ELEM_IS_F64 = 0
        return 0
    }

    // Float literal: emit runtime SSE2 conversion from integer parts
    if k == 122 {
        let fl_int = MP_FLOAT_INT[MC_POS as usize]
        let fl_frac = MP_FLOAT_FRAC[MC_POS as usize]
        let fl_denom = MP_FLOAT_DENOM[MC_POS as usize]
        MC_POS = MC_POS + 1
        // Emit: cvtsi2sd xmm0, int_part
        we(0x48)
        we(0xb8); we64(fl_int)  // mov rax, int_part
        we(0xF2)
        we(0x48)
        we(0x0F)
        we(0x2A)
        we(0xC0)  // cvtsi2sd xmm0, rax
        // Emit: cvtsi2sd xmm1, frac_val; cvtsi2sd xmm2, denom; divsd xmm1, xmm2; addsd xmm0, xmm1
        if fl_frac > 0 {
            we(0x48)
            we(0xb8); we64(fl_frac)  // mov rax, frac_val
            we(0xF2)
            we(0x48)
            we(0x0F)
            we(0x2A)
            we(0xC8)  // cvtsi2sd xmm1, rax
            we(0x48)
            we(0xb8); we64(fl_denom)  // mov rax, denom
            we(0xF2)
            we(0x48)
            we(0x0F)
            we(0x2A)
            we(0xD0)  // cvtsi2sd xmm2, rax
            we(0xF2)
            we(0x0F)
            we(0x5E)
            we(0xCA)  // divsd xmm1, xmm2
            we(0xF2)
            we(0x0F)
            we(0x58)
            we(0xC1)  // addsd xmm0, xmm1
        }
        // movq rax, xmm0 — store f64 bits in rax
        we(0x66)
        we(0x48)
        we(0x0F)
        we(0x7E)
        we(0xC0)
        MC_EXPR_IS_F64 = 1
        return 0
    }

    // true / false
    if k == 32 {
        MC_POS = MC_POS + 1
        we(0x48)
        we(0xb8); we64(1)
        MC_EXPR_IS_F64 = 0
        return 0
    }
    if k == 33 {
        MC_POS = MC_POS + 1
        we(0x48)
        we(0xb8); we64(0)
        MC_EXPR_IS_F64 = 0
        return 0
    }

    // String literal
    if k == 123 {
        let ss = MP_START[MC_POS as usize] + 1  // skip opening "
        let se = MP_END[MC_POS as usize] - 1    // skip closing "
        MC_POS = MC_POS + 1
        // Embed string inline: jmp over, then data, then lea rax, [rip+data]
        // First decode string bytes to get length
        var sb: [i8; 512] = [0; 512]
        var sl: i64 = 0
        var di: i64 = ss
        while di < se && sl < 512 {
            let dc = (LEAN_SOURCE[(di) as usize] as i64)
            if dc == 92 as i8 && di + 1 < se {
                let dc2 = (LEAN_SOURCE[(di + 1) as usize] as i64)
                if dc2 == 110 { sb[sl as usize] = 10 }
                else if dc2 == 116 as i8 { sb[sl as usize] = 9 as i8 }
                else if dc2 == 92 as i8 { sb[sl as usize] = 92 as i8 }
                else if dc2 == 48 as i8 { sb[sl as usize] = 0 }
                else if dc2 == 34 as i8 { sb[sl as usize] = 34 as i8 }
                else { sb[sl as usize] = dc2 }
                di = di + 2
            } else {
                sb[sl as usize] = dc
                di = di + 1
            }
            sl = sl + 1
        }
        // jmp over data+null: EB <len+1>
        let jmp_off = WIDE_LEN
        we(0xeb)
        we(0x00)  // placeholder
        let data_start = WIDE_LEN
        var wi: i64 = 0
        while wi < sl { we(sb[wi as usize] as i64 & 0xFF); wi = wi + 1 }
        we(0x00)  // null terminator
        let data_end = WIDE_LEN
        // Patch jmp
        let jmp_dist = data_end - (jmp_off + 2)
        WIDE_OUT[(jmp_off + 1) as usize] = (jmp_dist & 0xFF) as i8
        // lea rax, [rip + rel32] pointing to data_start
        we(0x48)
        we(0x8d)
        we(0x05)
        let rip_rel = data_start - (WIDE_LEN + 4)
        we32(rip_rel)
        return 0
    }

    // Parenthesized expression
    if k == 171 {
        MC_POS = MC_POS + 1
        mc_parse_expr()
        MC_POS = MC_POS + 1
        return 0
    }

    // Unary minus
    if k == 130 {
        MC_POS = MC_POS + 1
        mc_parse_primary()
        if MC_EXPR_IS_F64 == 1 {
            // f64 negate: flip sign bit (xor rax, 0x8000000000000000)
            we(0x48)
            we(0xb9)
            we(0x00)
            we(0x00)
            we(0x00)
            we(0x00)
            we(0x00)
            we(0x00)
            we(0x00)
            we(0x80)
            we(0x48)
            we(0x31)
            we(0xc8)  // xor rax, rcx
        } else {
            // neg rax
            we(0x48)
            we(0xf7)
            we(0xd8)
        }
        return 0
    }

    // Unary not (!)
    if k == 137 {
        MC_POS = MC_POS + 1
        mc_parse_primary()
        // test rax, rax; sete al; movzx rax, al
        we(0x48)
        we(0x85)
        we(0xc0)
        we(0x0f)
        we(0x94)
        we(0xc0)
        we(0x48)
        we(0x0f)
        we(0xb6)
        we(0xc0)
        return 0
    }

    // If expression (value-producing)
    if k == 17 {
        mc_parse_if_expr()
        return 0
    }

    // Match expression (value-producing)
    if k == 202 {
        mc_parse_match_expr()
        return 0
    }

    // Enum name as primary (Enum::Variant)
    if k == 201 {
        let en_s = MP_START[MC_POS as usize]
        let en_e = MP_END[MC_POS as usize]
        let en_len = en_e - en_s
        MC_POS = MC_POS + 1  // consume enum name
        MC_POS = MC_POS + 1  // consume ::
        let var_s = MP_START[MC_POS as usize]
        let var_e = MP_END[MC_POS as usize]
        let var_len = var_e - var_s
        MC_POS = MC_POS + 1  // consume variant name
        let en_idx = mc_find_enum(en_s, en_len)
        if en_idx >= 0 {
            let ev_val = mc_find_enum_variant(en_idx, var_s, var_len)
            if ev_val >= 0 {
                we(0x48)
                we(0xb8); we64(ev_val)  // mov rax, variant_value
            } else {
                print("mc: unknown variant\n")
                we(0x48)
                we(0x31)
                we(0xc0)
            }
        } else {
            print("mc: unknown enum\n")
            we(0x48)
            we(0x31)
            we(0xc0)
        }
        MC_EXPR_IS_F64 = 0
        return 0
    }

    // Identifier: variable ref, function call, struct literal, or Enum::Variant
    if k == 120 {
        let id_s = MP_START[MC_POS as usize]
        let id_e = MP_END[MC_POS as usize]
        let id_len = id_e - id_s
        MC_POS = MC_POS + 1

        // Check for Enum::Variant path: ident followed by ::
        if MP_KIND[MC_POS as usize] == 159 {
            MC_POS = MC_POS + 1  // consume ::
            let var_s = MP_START[MC_POS as usize]
            let var_e = MP_END[MC_POS as usize]
            let var_len = var_e - var_s
            MC_POS = MC_POS + 1  // consume variant name
            let en_idx = mc_find_enum(id_s, id_len)
            if en_idx >= 0 {
                let ev_val = mc_find_enum_variant(en_idx, var_s, var_len)
                if ev_val >= 0 {
                    we(0x48)
                    we(0xb8); we64(ev_val)  // mov rax, variant_value
                } else {
                    print("mc: unknown variant '")
                    var evi: i64 = 0
                    while evi < var_len && evi < 32 { print_char((LEAN_SOURCE[(var_s + evi) as usize] as i64) as i64); evi = evi + 1 }
                    print("'\n")
                    we(0x48)
                    we(0x31)
                    we(0xc0)
                }
            } else {
                print("mc: unknown enum '")
                var eni: i64 = 0
                while eni < id_len && eni < 32 { print_char((LEAN_SOURCE[(id_s + eni) as usize] as i64) as i64); eni = eni + 1 }
                print("'\n")
                we(0x48)
                we(0x31)
                we(0xc0)
            }
            MC_EXPR_IS_F64 = 0
            return 0
        }

        // Check for function call: ident followed by (
        if MP_KIND[MC_POS as usize] == 171 {
            MC_POS = MC_POS + 1  // consume (
            mc_emit_call(id_s, id_len)
            return 0
        }

        // Check for struct literal: ident followed by { where ident is a struct name
        if MP_KIND[MC_POS as usize] == 173 {
            let st_idx = mc_find_struct(id_s, id_len)
            if st_idx >= 0 {
                MC_POS = MC_POS + 1  // consume {
                // Allocate temp stack space for the struct
                let tmp_slot = MC_NEXT_SLOT
                let flat = MC_ST_FLAT_SIZE[st_idx as usize]
                MC_NEXT_SLOT = MC_NEXT_SLOT + flat
                // Parse field: value pairs and store each field
                while true {
        let pk = MP_KIND[MC_POS as usize]
        if pk == 174 || pk == 0 { break }
                    let fs = MP_START[MC_POS as usize]
                    let fe = MP_END[MC_POS as usize]
                    let fl = fe - fs
                    MC_POS = MC_POS + 1  // consume field name
                    MC_POS = MC_POS + 1
                    mc_parse_expr()
                    // Find field offset and store
                    let fi = mc_find_struct_field(st_idx, fs, fl)
                    if fi >= 0 {
                        let fbase = MC_ST_FIELD_BASE[st_idx as usize]
                        let foff = MC_SF_OFFSET[(fbase + fi) as usize]
                        mc_emit_store_rax(tmp_slot + foff)
                    }
                    if MP_KIND[MC_POS as usize] == 179 { MC_POS = MC_POS + 1 }
                }
                MC_POS = MC_POS + 1
                // Leave pointer to struct in rax
                mc_emit_lea_slot(tmp_slot)
                // Set expression type to struct
                MC_EXPR_IS_F64 = 0
                return 0
            }
        }

        // Variable reference
        let slot = mc_find_local(id_s, id_len)
        if slot >= 0 {
            let lt = mc_find_local_type(id_s, id_len)
            if lt == -3 { mc_emit_load_rax(slot); MC_EXPR_ELEM_SZ = 1 } else if lt == -2 { mc_emit_lea_slot(slot); MC_EXPR_IS_LOCAL_ARR = 1 } else if lt >= 0 {
                // Struct variable: load pointer to first slot
                mc_emit_lea_slot(slot)
            } else {
                mc_emit_load_rax(slot)
            }
            MC_EXPR_IS_F64 = mc_local_is_f64(id_s, id_len)
        } else {
            // Try global variable lookup
            let gi = mc_find_global_src(id_s, id_len)
            if gi >= 0 {
                let gsz = GLOBAL_SIZES[gi as usize]
                if gsz > 8 {
                    // Array global — load base address
                    mc_emit_load_global_base()
                    let goff = GLOBAL_OFFSETS[gi as usize]
                    if goff > 0 {
                        we(0x48); we(0x05)
                        we(goff & 0xFF); we((goff >> 8) & 0xFF)
                        we((goff >> 16) & 0xFF); we((goff >> 24) & 0xFF)
                    }
                    MC_EXPR_ELEM_SZ = GLOBAL_ELEM_SIZES[gi as usize]
                } else {
                    // Scalar global — load value
                    mc_emit_load_global_scalar(gi)
                }
                MC_EXPR_IS_F64 = GLOBAL_IS_FLOAT[gi as usize]
            } else {
                // Unknown variable — emit 0 with warning
                print("mc: unknown var '")
                var vi: i64 = 0
                while vi < id_len && vi < 32 {
                    print_char((LEAN_SOURCE[(id_s + vi) as usize] as i64) as i64)
                    vi = vi + 1
                }
                print("'\n")
                we(0x48)
                we(0x31)
                we(0xc0)  // xor rax, rax
            }
        }
        return 0
    }

    // Fallback: skip token, emit 0
    MC_POS = MC_POS + 1
    we(0x48)
    we(0x31)
    we(0xc0)
    0
}

// Emit a function call. Arguments already consumed up to but not including ).
fn mc_emit_call(name_s: i64, name_len: i64) with Mut, Panic, Div {
    // Special builtins
    // print(str_expr)
    if mc_src_eq_at(name_s, name_len, "print") {
        // Check if argument is a string literal for inline optimization
        if MP_KIND[MC_POS as usize] == 123 {
            let ss = MP_START[MC_POS as usize] + 1
            let se = MP_END[MC_POS as usize] - 1
            MC_POS = MC_POS + 1
            mc_emit_print_str(ss, se)
        } else {
            // Runtime print: evaluate expr, rax = pointer to null-terminated string
            mc_parse_expr()
            // mov rsi, rax; inline strlen; sys_write
            we(0x48)
            we(0x89)
            we(0xc6)  // mov rsi, rax
            we(0x48)
            we(0x89)
            we(0xc7)  // mov rdi, rax
            we(0x31)
            we(0xc9)            // xor ecx, ecx
            // loop: cmp byte [rdi+rcx], 0; je done; inc rcx; jmp loop
            we(0x80)
            we(0x3c)
            we(0x0f)
            we(0x00)
            we(0x74)
            we(0x04)
            we(0x48)
            we(0xff)
            we(0xc1)
            we(0xeb)
            we(0xf5)
            we(0x48)
            we(0x89)
            we(0xca)  // mov rdx, rcx
            we(0xbf); we32(1)
            we(0xb8); we32(1)
            we(0x0f)
            we(0x05)
        }
        MC_POS = MC_POS + 1
        we(0x48)
        we(0x31)
        we(0xc0)  // xor rax, rax (return 0)
        return 0
    }

    // print_int(expr)
    if mc_src_eq_at(name_s, name_len, "print_int") {
        mc_parse_expr()
        MC_POS = MC_POS + 1
        // mov rdi, rax; call print_int_helper
        we(0x48)
        we(0x89)
        we(0xc7)
        we(0xe8)
        let rel = MC_PRINT_INT_OFF - (WIDE_LEN + 4)
        we32(rel)
        we(0x48)
        we(0x31)
        we(0xc0)
        MC_EXPR_IS_F64 = 0
        return 0
    }

    // print_f64(expr) — f64 bit pattern in rax, pass to helper via rdi
    if mc_src_eq_at(name_s, name_len, "print_f64") {
        mc_parse_expr()
        MC_POS = MC_POS + 1
        // mov rdi, rax; call print_f64_helper
        we(0x48)
        we(0x89)
        we(0xc7)
        we(0xe8)
        let f64_rel = MC_PRINT_F64_OFF - (WIDE_LEN + 4)
        we32(f64_rel)
        we(0x48)
        we(0x31)
        we(0xc0)
        MC_EXPR_IS_F64 = 0
        return 0
    }

    // sqrt(expr) — sqrtsd xmm0, xmm0 on f64 bit pattern
    if mc_src_eq_at(name_s, name_len, "sqrt") {
        mc_parse_expr()
        MC_POS = MC_POS + 1
        // rax has f64 bits; movq xmm0, rax; sqrtsd xmm0, xmm0; movq rax, xmm0
        we(0x66)
        we(0x48)
        we(0x0F)
        we(0x6E)
        we(0xC0)  // movq xmm0, rax
        we(0xF2)
        we(0x0F)
        we(0x51)
        we(0xC0)             // sqrtsd xmm0, xmm0
        we(0x66)
        we(0x48)
        we(0x0F)
        we(0x7E)
        we(0xC0)  // movq rax, xmm0
        MC_EXPR_IS_F64 = 1
        return 0
    }

    // exit(expr) — mov edi, eax; mov eax, 60; syscall
    if mc_src_eq_at(name_s, name_len, "exit") {
        mc_parse_expr()
        MC_POS = MC_POS + 1
        we(0x89)
        we(0xc7)    // mov edi, eax
        we(0xb8); we32(60)    // mov eax, 60
        we(0x0f)
        we(0x05)    // syscall
        return 0
    }


    if mc_src_eq_at(name_s, name_len, "print_char") {
        mc_parse_expr()
        MC_POS = MC_POS + 1
        we(0x50)
        we(0xb8); we32(1)
        we(0xbf); we32(1)
        we(0x48); we(0x89); we(0xe6)
        we(0xba); we32(1)
        we(0x0f); we(0x05)
        we(0x58)
        we(0x48); we(0x31); we(0xc0)
        return 0
    }
    if mc_src_eq_at(name_s, name_len, "file_size") {
        mc_parse_expr()
        MC_POS = MC_POS + 1
        we(0x48); we(0x89); we(0xc7)
        we(0x48); we(0x81); we(0xec); we32(256)
        we(0x48); we(0x89); we(0xe6)
        we(0xb8); we32(4)
        we(0x0f); we(0x05)
        we(0x48); we(0x8B); we(0x44); we(0x24); we(48)
        we(0x48); we(0x81); we(0xc4); we32(256)
        MC_EXPR_IS_F64 = 0
        return 0
    }

    // arg_count() → number of CLI arguments (excluding program name)
    if mc_src_eq_at(name_s, name_len, "arg_count") {
        MC_POS = MC_POS + 1  // skip )
        let argc_addr2 = MC_BSS_BASE() + GLOBAL_TOTAL_SIZE
        we(0x48); we(0xA1)  // movabs rax, [argc_addr]
        var bk: i64 = 0
        while bk < 8 { we((argc_addr2 >> (bk * 8)) & 0xFF); bk = bk + 1 }
        // Subtract 1 (program name)
        we(0x48); we(0xFF); we(0xC8)  // dec rax
        MC_EXPR_IS_F64 = 0
        return 0
    }

    // get_arg(idx) → string pointer to argv[idx+1]
    if mc_src_eq_at(name_s, name_len, "get_arg") {
        mc_parse_expr()
        MC_POS = MC_POS + 1
        // rax = index; load argv_base, then argv[idx+1]
        we(0x48); we(0xFF); we(0xC0)  // inc rax (skip program name)
        we(0x48); we(0xC1); we(0xE0); we(0x03)  // shl rax, 3 (index * 8)
        we(0x48); we(0x89); we(0xC1)  // mov rcx, rax (scaled offset)
        let argv_addr2 = MC_BSS_BASE() + GLOBAL_TOTAL_SIZE + 8
        we(0x48); we(0xA1)  // movabs rax, [argv_addr]
        var bk: i64 = 0
        while bk < 8 { we((argv_addr2 >> (bk * 8)) & 0xFF); bk = bk + 1 }
        we(0x48); we(0x01); we(0xC8)  // add rax, rcx
        we(0x48); we(0x8B); we(0x00)  // mov rax, [rax] (argv[idx+1])
        MC_EXPR_IS_F64 = 0
        return 0
    }

    // read_into_read_buf(path) -> bytes read into READ_BUF global
    if mc_src_eq_at(name_s, name_len, "read_into_read_buf") {
        mc_parse_expr()
        MC_POS = MC_POS + 1
        // open(path, O_RDONLY)
        we(0x48); we(0x89); we(0xc7)
        we(0x48); we(0x31); we(0xf6)
        we(0x48); we(0x31); we(0xd2)
        we(0xb8); we32(2)
        we(0x0f); we(0x05)
        we(0x48); we(0x89); we(0xc7)
        // read(fd, READ_BUF_addr, 2MB) — READ_BUF is at known global offset
        let rb_gi = mc_find_global_src_name("READ_BUF", 8)
        let rb_addr = MC_BSS_BASE() + (if rb_gi >= 0 { GLOBAL_OFFSETS[rb_gi as usize] } else { 0 })
        we(0x48); we(0xBE)
        var lk: i64 = 0
        while lk < 8 { we((rb_addr >> (lk * 8)) & 0xFF); lk = lk + 1 }
        we(0xba); we32(2097152)
        we(0xb8); we32(0)
        we(0x0f); we(0x05)
        we(0x50)
        we(0xb8); we32(3)
        we(0x0f); we(0x05)
        we(0x58)
        MC_EXPR_IS_F64 = 0
        return 0
    }

    // read_file(path) → pointer to null-terminated content (stack-allocated 1MB buffer)
    if mc_src_eq_at(name_s, name_len, "read_file") {
        mc_parse_expr()
        MC_POS = MC_POS + 1
        // rax = path; open, read, close
        we(0x48); we(0x89); we(0xc7)  // mov rdi, rax
        we(0x48); we(0x31); we(0xf6)  // xor rsi, rsi (O_RDONLY)
        we(0x48); we(0x31); we(0xd2)  // xor rdx, rdx
        we(0xb8); we32(2)             // mov eax, 2 (SYS_OPEN)
        we(0x0f); we(0x05)            // syscall → fd in rax
        we(0x48); we(0x89); we(0xc7)  // mov rdi, rax (fd)
        we(0x48); we(0x81); we(0xec); we32(1048576) // sub rsp, 1MB
        we(0x48); we(0x89); we(0xe6)  // mov rsi, rsp
        we(0xba); we32(1048576)       // mov edx, 1048576
        we(0xb8); we32(0)             // mov eax, 0 (SYS_READ)
        we(0x0f); we(0x05)            // syscall → bytes_read
        // Null-terminate
        we(0xC6); we(0x04); we(0x04); we(0x00) // mov byte [rsp+rax], 0
        // Close fd
        we(0xb8); we32(3)             // mov eax, 3 (SYS_CLOSE)
        we(0x0f); we(0x05)            // syscall
        we(0x48); we(0x89); we(0xe0)  // mov rax, rsp (return buffer ptr)
        MC_EXPR_IS_F64 = 0
        MC_EXPR_ELEM_SZ = 1  // read_file returns byte pointer
        return 0
    }

    // write_file(path, buf, len) → bytes written
    if mc_src_eq_at(name_s, name_len, "write_file") {
        // Parse 3 args: path, buffer, length
        mc_parse_expr()
        let wf_path = mc_alloc_slot()
        mc_emit_store_rax(wf_path)
        MC_POS = MC_POS + 1  // skip comma
        mc_parse_expr()
        let wf_buf = mc_alloc_slot()
        mc_emit_store_rax(wf_buf)
        MC_POS = MC_POS + 1  // skip comma
        mc_parse_expr()
        let wf_len = mc_alloc_slot()
        mc_emit_store_rax(wf_len)
        MC_POS = MC_POS + 1  // skip )
        // open(path, O_WRONLY|O_CREAT|O_TRUNC=577, 0644=420)
        mc_emit_load_rax(wf_path)
        we(0x48); we(0x89); we(0xc7)  // mov rdi, rax
        we(0x48); we(0xc7); we(0xc6); we32(577)  // mov rsi, 577
        we(0x48); we(0xc7); we(0xc2); we32(420)  // mov rdx, 420
        we(0xb8); we32(2)             // mov eax, 2 (SYS_OPEN)
        we(0x0f); we(0x05)            // syscall → fd
        we(0x48); we(0x89); we(0xc7)  // mov rdi, rax (fd)
        // write(fd, buf, len)
        mc_emit_load_rax(wf_buf)
        we(0x48); we(0x89); we(0xc6)  // mov rsi, rax (buf)
        mc_emit_load_rax(wf_len)
        we(0x48); we(0x89); we(0xc2)  // mov rdx, rax (len)
        we(0xb8); we32(1)             // mov eax, 1 (SYS_WRITE)
        we(0x0f); we(0x05)            // syscall
        we(0x50)                      // push rax (bytes written)
        // close(fd)
        we(0xb8); we32(3)             // mov eax, 3 (SYS_CLOSE)
        we(0x0f); we(0x05)            // syscall
        we(0x58)                      // pop rax (restore bytes written)
        MC_EXPR_IS_F64 = 0
        return 0
    }

    // str_len(s) → length (inline strlen)
    if mc_src_eq_at(name_s, name_len, "str_len") {
        mc_parse_expr()
        MC_POS = MC_POS + 1
        // rax = string ptr; count bytes until 0
        we(0x48); we(0x89); we(0xC7)  // mov rdi, rax
        we(0x31); we(0xC9)            // xor ecx, ecx
        // loop: cmp byte [rdi+rcx], 0; je done; inc rcx; jmp loop
        we(0x80); we(0x3C); we(0x0F); we(0x00) // cmp byte [rdi+rcx], 0
        we(0x74); we(0x04)            // je +4
        we(0x48); we(0xFF); we(0xC1)  // inc rcx
        we(0xEB); we(0xF5)            // jmp -11
        we(0x48); we(0x89); we(0xC8)  // mov rax, rcx
        MC_EXPR_IS_F64 = 0
        return 0
    }

    // str_char_at(s, idx) → byte value at index
    if mc_src_eq_at(name_s, name_len, "str_char_at") {
        mc_parse_expr()
        let sca_str = mc_alloc_slot()
        mc_emit_store_rax(sca_str)
        MC_POS = MC_POS + 1  // comma
        mc_parse_expr()
        MC_POS = MC_POS + 1  // )
        // rax = index, sca_str = string ptr
        we(0x48); we(0x89); we(0xC1)  // mov rcx, rax (index)
        mc_emit_load_rax(sca_str)
        we(0x48); we(0x0F); we(0xB6); we(0x04); we(0x08) // movzx rax, byte [rax+rcx]
        MC_EXPR_IS_F64 = 0
        return 0
    }

    // str_eq(a, b) → 1 if equal, 0 if not (inline strcmp)
    if mc_src_eq_at(name_s, name_len, "str_eq") {
        mc_parse_expr()
        let seq_a = mc_alloc_slot()
        mc_emit_store_rax(seq_a)
        MC_POS = MC_POS + 1  // comma
        mc_parse_expr()
        MC_POS = MC_POS + 1  // )
        // rax = b, seq_a = a
        we(0x48); we(0x89); we(0xC6)  // mov rsi, rax (b)
        mc_emit_load_rax(seq_a)
        we(0x48); we(0x89); we(0xC7)  // mov rdi, rax (a)
        // loop: movzx cl, [rdi]; movzx dl, [rsi]; cmp cl, dl; jne fail
        //       test cl, cl; jz pass; inc rdi; inc rsi; jmp loop
        // fail: xor eax, eax; jmp end; pass: mov eax, 1; end:
        we(0x0F); we(0xB6); we(0x0F)  // movzx ecx, byte [rdi]
        we(0x0F); we(0xB6); we(0x16)  // movzx edx, byte [rsi]
        we(0x38); we(0xD1)            // cmp cl, dl
        we(0x75); we(0x0C)            // jne fail (+12)
        we(0x84); we(0xC9)            // test cl, cl
        we(0x74); we(0x0C)            // jz pass (+12)
        we(0x48); we(0xFF); we(0xC7)  // inc rdi
        we(0x48); we(0xFF); we(0xC6)  // inc rsi
        we(0xEB); we(0xEA)            // jmp loop (-22)
        // fail:
        we(0x31); we(0xC0)            // xor eax, eax
        we(0xEB); we(0x05)            // jmp end (+5)
        // pass:
        we(0xB8); we32(1)             // mov eax, 1
        // end:
        MC_EXPR_IS_F64 = 0
        return 0
    }

    // General function call: evaluate args into rdi, rsi, rdx, rcx, r8, r9
    // Use individual scalars (boot4 can't handle local array writes via variable index)
    var as0: i64 = 0
    var as1: i64 = 0
    var as2: i64 = 0
    var as3: i64 = 0
    var as4: i64 = 0
    var as5: i64 = 0
    var arg_count: i64 = 0
    if MP_KIND[MC_POS as usize] != 172 {
        mc_parse_expr()
        as0 = mc_alloc_slot()
        mc_emit_store_rax(as0)
        arg_count = 1
        if MP_KIND[MC_POS as usize] == 179 {
            MC_POS = MC_POS + 1
            mc_parse_expr()
            as1 = mc_alloc_slot()
            mc_emit_store_rax(as1)
            arg_count = 2
        }
        if MP_KIND[MC_POS as usize] == 179 {
            MC_POS = MC_POS + 1
            mc_parse_expr()
            as2 = mc_alloc_slot()
            mc_emit_store_rax(as2)
            arg_count = 3
        }
        if MP_KIND[MC_POS as usize] == 179 {
            MC_POS = MC_POS + 1
            mc_parse_expr()
            as3 = mc_alloc_slot()
            mc_emit_store_rax(as3)
            arg_count = 4
        }
        if MP_KIND[MC_POS as usize] == 179 {
            MC_POS = MC_POS + 1
            mc_parse_expr()
            as4 = mc_alloc_slot()
            mc_emit_store_rax(as4)
            arg_count = 5
        }
        if MP_KIND[MC_POS as usize] == 179 {
            MC_POS = MC_POS + 1
            mc_parse_expr()
            as5 = mc_alloc_slot()
            mc_emit_store_rax(as5)
            arg_count = 6
        }
        // Skip remaining commas
        while MP_KIND[MC_POS as usize] == 179 {
            MC_POS = MC_POS + 1
            mc_parse_expr()
            arg_count = arg_count + 1
        }
    }
    MC_POS = MC_POS + 1

    // Load args into ABI registers
    if arg_count > 0 { mc_emit_load_rax(as0)
    we(0x48)
    we(0x89)
    we(0xc7) }  // mov rdi, rax
    if arg_count > 1 { mc_emit_load_rax(as1)
    we(0x48)
    we(0x89)
    we(0xc6) }  // mov rsi, rax
    if arg_count > 2 { mc_emit_load_rax(as2)
    we(0x48)
    we(0x89)
    we(0xc2) }  // mov rdx, rax
    if arg_count > 3 { mc_emit_load_rax(as3)
    we(0x48)
    we(0x89)
    we(0xc1) }  // mov rcx, rax
    if arg_count > 4 {
        mc_emit_load_rax(as4)
        we(0x49)
        we(0x89)
        we(0xc0)  // mov r8, rax
    }
    if arg_count > 5 {
        mc_emit_load_rax(as5)
        we(0x49)
        we(0x89)
        we(0xc1)  // mov r9, rax
    }

    // Find target function
    let fn_idx = mc_find_fn(name_s, name_len)
    if fn_idx >= 0 {
        // call rel32 — emit sentinel, will be patched
        we(0xe8)
        MC_CALL_FIX_OFF[MC_CALL_FIX_COUNT as usize] = WIDE_LEN
        MC_CALL_FIX_TARGET[MC_CALL_FIX_COUNT as usize] = fn_idx
        MC_CALL_FIX_COUNT = MC_CALL_FIX_COUNT + 1
        we32(0)  // placeholder
    } else {
        // Unknown function — emit warning + nop call
        print("mc: unknown fn '")
        var fi: i64 = 0
        while fi < name_len && fi < 32 {
            print_char((LEAN_SOURCE[(name_s + fi) as usize] as i64) as i64)
            fi = fi + 1
        }
        print("'\n")
        we(0x48)
        we(0x31)
        we(0xc0)  // xor rax, rax
    }
    0
}

// If expression: if cond { body } [else { body }]
fn mc_parse_if_expr() with Mut, Panic, Div {
    MC_POS = MC_POS + 1
    // Parse condition
    mc_parse_expr()
    // test rax, rax; jz else_branch
    we(0x48)
    we(0x85)
    we(0xc0)
    we(0x0f)
    we(0x84)   // jz rel32
    let else_fix = WIDE_LEN
    we32(0)  // placeholder

    // Then branch
    MC_POS = MC_POS + 1
    mc_parse_block_body()
    MC_POS = MC_POS + 1

    // Check for else
    if MP_KIND[MC_POS as usize] == 18 {
        MC_POS = MC_POS + 1
        // jmp over_else
        we(0xe9)
        let end_fix = WIDE_LEN
        we32(0)
        // Patch else_fix to here
        let else_target = WIDE_LEN
        let else_disp = else_target - (else_fix + 4)
        WIDE_OUT[else_fix as usize] = (else_disp & 0xFF) as i8
        WIDE_OUT[(else_fix + 1) as usize] = ((else_disp >> 8) & 0xFF) as i8
        WIDE_OUT[(else_fix + 2) as usize] = ((else_disp >> 16) & 0xFF) as i8
        WIDE_OUT[(else_fix + 3) as usize] = ((else_disp >> 24) & 0xFF) as i8

        if MP_KIND[MC_POS as usize] == 17 {
            // else if
            mc_parse_if_expr()
        } else {
            MC_POS = MC_POS + 1
            mc_parse_block_body()
            MC_POS = MC_POS + 1
        }
        // Patch end_fix to here
        let end_target = WIDE_LEN
        let end_disp = end_target - (end_fix + 4)
        WIDE_OUT[end_fix as usize] = (end_disp & 0xFF) as i8
        WIDE_OUT[(end_fix + 1) as usize] = ((end_disp >> 8) & 0xFF) as i8
        WIDE_OUT[(end_fix + 2) as usize] = ((end_disp >> 16) & 0xFF) as i8
        WIDE_OUT[(end_fix + 3) as usize] = ((end_disp >> 24) & 0xFF) as i8
    } else {
        // No else: patch else_fix to here
        let no_else_target = WIDE_LEN
        let no_else_disp = no_else_target - (else_fix + 4)
        WIDE_OUT[else_fix as usize] = (no_else_disp & 0xFF) as i8
        WIDE_OUT[(else_fix + 1) as usize] = ((no_else_disp >> 8) & 0xFF) as i8
        WIDE_OUT[(else_fix + 2) as usize] = ((no_else_disp >> 16) & 0xFF) as i8
        WIDE_OUT[(else_fix + 3) as usize] = ((no_else_disp >> 24) & 0xFF) as i8
    }
    0
}

// --- Match expression: match subject { Arm1 => expr, Arm2 => expr, _ => expr } ---
// Compiles as chain of compare-and-branch. Result in rax.
fn mc_parse_match_expr() with Mut, Panic, Div {
    MC_POS = MC_POS + 1
    // Evaluate subject expression
    mc_parse_expr()
    // Save subject to temp slot
    let subj_slot = mc_alloc_slot()
    mc_emit_store_rax(subj_slot)
    MC_POS = MC_POS + 1
    // End-jump fixups: use global arrays to avoid boot4 local array issues
    let saved_match_fix_count = MC_MATCH_END_FIX_COUNT
    MC_MATCH_END_FIX_COUNT = 0
    while true {
        let pk = MP_KIND[MC_POS as usize]
        if pk == 174 || pk == 0 { break }
        // Parse arm pattern
        let arm_k = MP_KIND[MC_POS as usize]
        // Check for wildcard: _ (ident with length 1, byte == 95)
        var is_wildcard = false
        var arm_value: i64 = 0
        if arm_k == 120 {
            let arm_s = MP_START[MC_POS as usize]
            let arm_l = MP_END[MC_POS as usize] - arm_s
            if arm_l == 1 && (LEAN_SOURCE[(arm_s) as usize] as i64) == 95 {
                is_wildcard = true
                MC_POS = MC_POS + 1  // consume _
            } else {
                if MP_KIND[(MC_POS + 1) as usize] == 159 {
                    MC_POS = MC_POS + 1
                    MC_POS = MC_POS + 1
                    let pv_s = MP_START[MC_POS as usize]
                    let pv_l = MP_END[MC_POS as usize] - pv_s
                    MC_POS = MC_POS + 1
                    let pen_idx = mc_find_enum(arm_s, arm_l)
                    if pen_idx >= 0 { arm_value = mc_find_enum_variant(pen_idx, pv_s, pv_l) }
                } else {
                    MC_POS = MC_POS + 1
                    var found_ev: i64 = 0
                    var evi: i64 = 0
                    while evi < MC_EN_COUNT && found_ev == 0 {
                        let ev = mc_find_enum_variant(evi, arm_s, arm_l)
                        if ev >= 0 { arm_value = ev; found_ev = 1 }
                        evi = evi + 1
                    }
                }
            }
        } else if arm_k == 201 {
            // Enum name token (recognized keyword)
            let arm_s = MP_START[MC_POS as usize]
            let arm_l = MP_END[MC_POS as usize] - arm_s
            MC_POS = MC_POS + 1  // consume enum name
            MC_POS = MC_POS + 1
            let pv_s = MP_START[MC_POS as usize]
            let pv_l = MP_END[MC_POS as usize] - pv_s
            MC_POS = MC_POS + 1  // consume variant name
            let pen_idx = mc_find_enum(arm_s, arm_l)
            if pen_idx >= 0 {
                arm_value = mc_find_enum_variant(pen_idx, pv_s, pv_l)
            }
        } else {
            // Unknown pattern, skip token
            MC_POS = MC_POS + 1
        }
        MC_POS = MC_POS + 1
        if is_wildcard {
            // Wildcard arm: unconditionally execute body
            // Check if body is a block or single expression
            if MP_KIND[MC_POS as usize] == 173 {
                MC_POS = MC_POS + 1
                mc_parse_block_body()
                MC_POS = MC_POS + 1
            } else {
                mc_parse_expr()
            }
            if MP_KIND[MC_POS as usize] == 179 { MC_POS = MC_POS + 1 }
            // Jump to end
            we(0xe9)
            MC_MATCH_END_FIX[MC_MATCH_END_FIX_COUNT as usize] = WIDE_LEN
            MC_MATCH_END_FIX_COUNT = MC_MATCH_END_FIX_COUNT + 1
            we32(0)
        } else {
            // Non-wildcard arm: compare subject to arm_value
            mc_emit_load_rax(subj_slot)
            // cmp rax, imm32 — use mov rcx, imm64; cmp rax, rcx
            we(0x48)
            we(0xb9); we64(arm_value)  // mov rcx, arm_value
            we(0x48)
            we(0x39)
            we(0xc8)          // cmp rax, rcx
            // jne skip_this_arm
            we(0x0f)
            we(0x85)
            let skip_fix = WIDE_LEN
            we32(0)
            // Arm body
            if MP_KIND[MC_POS as usize] == 173 {
                MC_POS = MC_POS + 1
                mc_parse_block_body()
                MC_POS = MC_POS + 1
            } else {
                mc_parse_expr()
            }
            if MP_KIND[MC_POS as usize] == 179 { MC_POS = MC_POS + 1 }
            // Jump to end of match
            we(0xe9)
            MC_MATCH_END_FIX[MC_MATCH_END_FIX_COUNT as usize] = WIDE_LEN
            MC_MATCH_END_FIX_COUNT = MC_MATCH_END_FIX_COUNT + 1
            we32(0)
            // Patch skip_fix to here
            let skip_target = WIDE_LEN
            let skip_disp = skip_target - (skip_fix + 4)
            WIDE_OUT[skip_fix as usize] = (skip_disp & 0xFF) as i8
            WIDE_OUT[(skip_fix + 1) as usize] = ((skip_disp >> 8) & 0xFF) as i8
            WIDE_OUT[(skip_fix + 2) as usize] = ((skip_disp >> 16) & 0xFF) as i8
            WIDE_OUT[(skip_fix + 3) as usize] = ((skip_disp >> 24) & 0xFF) as i8
        }
    }
    MC_POS = MC_POS + 1
    // Patch all end-jump fixups to here
    let match_end = WIDE_LEN
    var efi: i64 = 0
    while efi < MC_MATCH_END_FIX_COUNT {
        let fix_off = MC_MATCH_END_FIX[efi as usize]
        let end_disp = match_end - (fix_off + 4)
        WIDE_OUT[fix_off as usize] = (end_disp & 0xFF) as i8
        WIDE_OUT[(fix_off + 1) as usize] = ((end_disp >> 8) & 0xFF) as i8
        WIDE_OUT[(fix_off + 2) as usize] = ((end_disp >> 16) & 0xFF) as i8
        WIDE_OUT[(fix_off + 3) as usize] = ((end_disp >> 24) & 0xFF) as i8
        efi = efi + 1
    }
    MC_MATCH_END_FIX_COUNT = saved_match_fix_count
    MC_EXPR_IS_F64 = 0
    0
}

// Operator precedence
fn mc_binop_prec(k: i64) -> i64 {
    if k == 148 { return 1 }                           // ||
    if k == 147 { return 2 }                           // &&
    if k == 139 { return 3 }                           // |  (bitwise OR, token 139)
    if k == 140 { return 4 }                           // ^  (bitwise XOR, token 140)
    if k == 138 { return 5 }                           // &  (bitwise AND, token 138)
    if k == 143 || k == 144 { return 6 }               // == !=
    if k == 135 || k == 136 || k == 145 || k == 146 { return 7 }  // < > <= >=
    if k == 149 || k == 150 { return 8 }               // << >>
    if k == 129 || k == 130 { return 9 }               // + -
    if k == 131 || k == 132 || k == 133 { return 10 }  // * / %
    0
}

fn mc_parse_expr() with Mut, Panic, Div {
    mc_parse_expr_prec(1)
    // Consume trailing `as TYPE` casts (no-op — value already in rax)
    while MP_KIND[MC_POS as usize] == 27 {
        MC_POS = MC_POS + 1  // skip 'as'
        if MP_KIND[MC_POS as usize] == 120 || MP_KIND[MC_POS as usize] == 201 { MC_POS = MC_POS + 1 }
    }
}

fn mc_parse_expr_prec(min_prec: i64) with Mut, Panic, Div {
    mc_parse_primary()
    // Handle postfix dot access (highest precedence)
    while MP_KIND[MC_POS as usize] == 180 {
        MC_POS = MC_POS + 1
        let fs = MP_START[MC_POS as usize]
        let fe = MP_END[MC_POS as usize]
        let fl = fe - fs
        MC_POS = MC_POS + 1
        // Brute-force: find field across all structs
        var dot_off: i64 = -1
        var dot_flat: i64 = 1
        var dot_is_f64: i64 = 0
        var dsi: i64 = 0
        while dsi < MC_ST_COUNT {
            let dfi = mc_find_struct_field(dsi, fs, fl)
            if dfi >= 0 {
                let dfb = MC_ST_FIELD_BASE[dsi as usize]
                dot_off = MC_SF_OFFSET[(dfb + dfi) as usize]
                dot_flat = MC_SF_FLAT_SIZE[(dfb + dfi) as usize]
                dot_is_f64 = MC_SF_IS_F64[(dfb + dfi) as usize]
                dsi = MC_ST_COUNT
            }
            dsi = dsi + 1
        }
        if dot_off >= 0 {
            // Stack structs grow downward: field N is at [base - N*8]
            let dot_disp = 0 - (dot_off * 8)
            if dot_flat == 1 {
                if dot_off == 0 {
                    we(0x48)
                    we(0x8b)
                    we(0x00)  // mov rax, [rax]
                } else {
                    we(0x48)
                    we(0x8b)
                    we(0x80)  // mov rax, [rax + disp32]
                    we32(dot_disp)
                }
                // Propagate f64 type from struct field. A value of 2 means this
                // field is an array whose elements are f64; the field value
                // itself is still a pointer/base address until postfix [].
                if dot_is_f64 == 1 {
                    MC_EXPR_IS_F64 = 1
                    MC_EXPR_ELEM_IS_F64 = 0
                    we(0x66)
                    we(0x48)
                    we(0x0f)
                    we(0x6e)
                    we(0xc0)  // movq xmm0, rax
                } else if dot_is_f64 == 2 {
                    MC_EXPR_IS_F64 = 0
                    MC_EXPR_ELEM_SZ = 8
                    MC_EXPR_ELEM_IS_F64 = 1
                } else {
                    MC_EXPR_ELEM_IS_F64 = 0
                }
            } else {
                if dot_off > 0 {
                    we(0x48)
                    we(0x8d)
                    we(0x80)  // lea rax, [rax + disp32]
                    we32(dot_disp)
                }
            }
        }
    }
    // Handle postfix array index: expr[idx] — 175=LBracket, 176=RBracket, 27=As
    // Stack-safe: use temp slot instead of push (push corrupts stack arrays)
    if MP_KIND[MC_POS as usize] == 175 {
        let was_local_arr = MC_EXPR_IS_LOCAL_ARR
        MC_EXPR_IS_LOCAL_ARR = 0
        MC_POS = MC_POS + 1
        let arr_base_slot = mc_alloc_slot()
        mc_emit_store_rax(arr_base_slot)  // save base to named slot
        let saved_elem_sz = MC_EXPR_ELEM_SZ  // save before index parse might overwrite
        let saved_elem_is_f64 = MC_EXPR_ELEM_IS_F64
        mc_parse_expr()  // index → rax
        if MP_KIND[MC_POS as usize] == 27 { MC_POS = MC_POS + 1 }   // skip 'as'
        if MP_KIND[MC_POS as usize] == 120 { MC_POS = MC_POS + 1 }  // skip 'usize'/'i64'/etc
        if MP_KIND[MC_POS as usize] == 176 { MC_POS = MC_POS + 1 }  // skip ]
        // Use element size from base expression (1=byte array, 8=qword array)
        let elem_sz = saved_elem_sz
        if elem_sz == 8 {
            we(0x48); we(0xC1); we(0xE0); we(0x03)  // shl rax, 3 (index*8)
        }
        // else: elem_sz==1, index is already byte offset
        we(0x48); we(0x89); we(0xC1)  // mov rcx, rax (scaled index → rcx)
        mc_emit_load_rax(arr_base_slot)  // rax = base address
        if was_local_arr == 1 {
            we(0x48); we(0x29); we(0xC8)  // sub rax, rcx
        } else {
            we(0x48); we(0x01); we(0xC8)  // add rax, rcx
        }
        if elem_sz == 1 {
            we(0x48); we(0x0F); we(0xB6); we(0x00)  // movzx rax, byte [rax]
        } else {
            we(0x48); we(0x8B); we(0x00)  // mov rax, [rax]
        }
        MC_EXPR_ELEM_SZ = 8  // reset
        MC_EXPR_ELEM_IS_F64 = 0
        if saved_elem_is_f64 == 1 {
            MC_EXPR_IS_F64 = 1
        } else {
            MC_EXPR_IS_F64 = 0
        }
    }
    // Handle trailing `as TYPE` casts (e.g., `expr as i64`, `expr as i8`)
    // Just consume the tokens — the value is already in rax
    if MP_KIND[MC_POS as usize] == 27 {
        MC_POS = MC_POS + 1  // skip 'as'
        if MP_KIND[MC_POS as usize] == 120 || MP_KIND[MC_POS as usize] == 201 { MC_POS = MC_POS + 1 }  // skip type name
    }
    if MP_KIND[MC_POS as usize] == 175 {
        MC_POS = MC_POS + 1
        we(0x50)
        mc_parse_expr()
        if MP_KIND[MC_POS as usize] == 27 { MC_POS = MC_POS + 1 }
        if MP_KIND[MC_POS as usize] == 120 { MC_POS = MC_POS + 1 }
        if MP_KIND[MC_POS as usize] == 176 { MC_POS = MC_POS + 1 }
        we(0x48); we(0xC1); we(0xE0); we(0x03)
        we(0x59)
        we(0x48); we(0x01); we(0xC8)
        we(0x48); we(0x8B); we(0x00)
    }
    // Handle 'as' cast: expr as i8, expr as i64, expr as usize, expr as f64
    if MP_KIND[MC_POS as usize] == 27 {
        MC_POS = MC_POS + 1  // skip 'as'
        let cast_s = MP_START[MC_POS as usize]
        let cast_l = MP_END[MC_POS as usize] - cast_s
        if mc_src_eq_at(cast_s, cast_l, "i8") {
            // Truncate to byte: movzx eax, al (zero-extend low byte)
            we(0x0F); we(0xB6); we(0xC0)
        } else if mc_src_eq_at(cast_s, cast_l, "f64") {
            // i64 → f64: cvtsi2sd xmm0, rax; movq rax, xmm0
            we(0xF2); we(0x48); we(0x0F); we(0x2A); we(0xC0)
            we(0x66); we(0x48); we(0x0F); we(0x7E); we(0xC0)
            MC_EXPR_IS_F64 = 1
        }
        // i64, usize, i32: identity (already 64-bit register)
        MC_POS = MC_POS + 1  // skip type name
    }
    // Pratt operator loop
    while true {
        let op = MP_KIND[MC_POS as usize]
        let prec = mc_binop_prec(op)
        if prec == 0 || prec < min_prec { break }
        MC_POS = MC_POS + 1

        // Save left operand and its type
        let left_slot = mc_alloc_slot()
        mc_emit_store_rax(left_slot)
        var mc_left_is_f64 = MC_EXPR_IS_F64

        // Parse right operand with higher precedence
        mc_parse_expr_prec(prec + 1)

        // rax = right, [left_slot] = left
        // mov rcx, rax (right); load rax, left
        we(0x48)
        we(0x89)
        we(0xc1)  // mov rcx, rax
        mc_emit_load_rax(left_slot)

        // Emit binary operation: rax = rax OP rcx
        // Check if this is f64 arithmetic (left_was_f64 saved before right parse)
        if mc_left_is_f64 == 1 && (op == 129 || op == 130 || op == 131 || op == 132) {
            // f64 path: bits in rax (left) and rcx (right)
            // movq xmm0, rax; movq xmm1, rcx
            we(0x66)
            we(0x48)
            we(0x0F)
            we(0x6E)
            we(0xC0)
            we(0x66)
            we(0x48)
            we(0x0F)
            we(0x6E)
            we(0xC9)
            if op == 129 {
                we(0xF2)
                we(0x0F)
                we(0x58)
                we(0xC1)  // addsd xmm0, xmm1
            } else if op == 130 {
                we(0xF2)
                we(0x0F)
                we(0x5C)
                we(0xC1)  // subsd xmm0, xmm1
            } else if op == 131 {
                we(0xF2)
                we(0x0F)
                we(0x59)
                we(0xC1)  // mulsd xmm0, xmm1
            } else if op == 132 {
                we(0xF2)
                we(0x0F)
                we(0x5E)
                we(0xC1)  // divsd xmm0, xmm1
            }
            // movq rax, xmm0
            we(0x66)
            we(0x48)
            we(0x0F)
            we(0x7E)
            we(0xC0)
            MC_EXPR_IS_F64 = 1
        } else if mc_left_is_f64 == 1 && (op == 143 || op == 144 || op == 135 || op == 136 || op == 145 || op == 146) {
            // f64 comparison: ucomisd xmm0, xmm1 then setCC
            we(0x66)
            we(0x48)
            we(0x0F)
            we(0x6E)
            we(0xC0)
            we(0x66)
            we(0x48)
            we(0x0F)
            we(0x6E)
            we(0xC9)
            we(0x66)
            we(0x0F)
            we(0x2E)
            we(0xC1)  // ucomisd xmm0, xmm1
            if op == 143 { we(0x0f)
            we(0x94)
            we(0xc0) }
            else if op == 144 { we(0x0f)
            we(0x95)
            we(0xc0) }
            else if op == 135 { we(0x0f)
            we(0x92)
            we(0xc0) }
            else if op == 136 { we(0x0f)
            we(0x97)
            we(0xc0) }
            else if op == 145 { we(0x0f)
            we(0x96)
            we(0xc0) }
            else if op == 146 { we(0x0f)
            we(0x93)
            we(0xc0) }
            we(0x48)
            we(0x0f)
            we(0xb6)
            we(0xc0)  // movzx rax, al
            MC_EXPR_IS_F64 = 0
        } else if op == 129 {
            we(0x48)
            we(0x01)
            we(0xc8)  // add rax, rcx
        } else if op == 130 {
            we(0x48)
            we(0x29)
            we(0xc8)  // sub rax, rcx
        } else if op == 131 {
            we(0x48)
            we(0x0f)
            we(0xaf)
            we(0xc1)  // imul rax, rcx
        } else if op == 132 {
            // cqo; idiv rcx
            we(0x48)
            we(0x99)
            we(0x48)
            we(0xf7)
            we(0xf9)
        } else if op == 133 {
            // cqo; idiv rcx; mov rax, rdx
            we(0x48)
            we(0x99)
            we(0x48)
            we(0xf7)
            we(0xf9)
            we(0x48)
            we(0x89)
            we(0xd0)
        } else if op == 143 {
            we(0x48)
            we(0x39)
            we(0xc8)  // cmp rax, rcx
            we(0x0f)
            we(0x94)
            we(0xc0)  // sete al
            we(0x48)
            we(0x0f)
            we(0xb6)
            we(0xc0)  // movzx rax, al
        } else if op == 144 {
            we(0x48)
            we(0x39)
            we(0xc8)
            we(0x0f)
            we(0x95)
            we(0xc0)  // setne al
            we(0x48)
            we(0x0f)
            we(0xb6)
            we(0xc0)
        } else if op == 135 {
            we(0x48)
            we(0x39)
            we(0xc8)
            we(0x0f)
            we(0x9c)
            we(0xc0)  // setl al
            we(0x48)
            we(0x0f)
            we(0xb6)
            we(0xc0)
        } else if op == 136 {
            we(0x48)
            we(0x39)
            we(0xc8)
            we(0x0f)
            we(0x9f)
            we(0xc0)  // setg al
            we(0x48)
            we(0x0f)
            we(0xb6)
            we(0xc0)
        } else if op == 145 {
            we(0x48)
            we(0x39)
            we(0xc8)
            we(0x0f)
            we(0x9e)
            we(0xc0)  // setle al
            we(0x48)
            we(0x0f)
            we(0xb6)
            we(0xc0)
        } else if op == 146 {
            we(0x48)
            we(0x39)
            we(0xc8)
            we(0x0f)
            we(0x9d)
            we(0xc0)  // setge al
            we(0x48)
            we(0x0f)
            we(0xb6)
            we(0xc0)
        } else if op == 147 {
            // Logical AND: both non-zero → 1
            we(0x48)
            we(0x85)
            we(0xc0)  // test rax, rax
            we(0x0f)
            we(0x95)
            we(0xc0)  // setne al
            we(0x48)
            we(0x85)
            we(0xc9)  // test rcx, rcx
            we(0x0f)
            we(0x95)
            we(0xc1)  // setne cl
            we(0x20)
            we(0xc8)            // and al, cl
            we(0x48)
            we(0x0f)
            we(0xb6)
            we(0xc0)
        } else if op == 148 {
            // Logical OR: either non-zero → 1
            we(0x48)
            we(0x09)
            we(0xc8)  // or rax, rcx
            we(0x48)
            we(0x85)
            we(0xc0)  // test rax, rax
            we(0x0f)
            we(0x95)
            we(0xc0)  // setne al
            we(0x48)
            we(0x0f)
            we(0xb6)
            we(0xc0)
        } else if op == 149 {
            // << : shl rax, cl
            we(0x48); we(0xD3); we(0xE0)
        } else if op == 150 {
            // >> : shr rax, cl
            we(0x48); we(0xD3); we(0xE8)
        } else if op == 138 {
            // & : and rax, rcx
            we(0x48); we(0x21); we(0xC8)
        } else if op == 139 {
            // | : or rax, rcx
            we(0x48); we(0x09); we(0xC8)
        } else if op == 140 {
            // ^ : xor rax, rcx
            we(0x48); we(0x31); we(0xC8)
        }
    }
    0
}

// --- Statement helpers (extracted for boot4 code-size limit) ---

fn mc_stmt_let() with Mut, Panic, Div {
    MC_POS = MC_POS + 1
    let ns = MP_START[MC_POS as usize]
    let ne = MP_END[MC_POS as usize]
    let nl = ne - ns
    MC_POS = MC_POS + 1  // consume ident
    // Optional type annotation: : TYPE — detect f64 and struct
    var let_is_f64: i64 = 0
    var let_st: i64 = -1
    if MP_KIND[MC_POS as usize] == 178 {
        MC_POS = MC_POS + 1
        let tk_at = MP_KIND[MC_POS as usize]
        if tk_at == 120 || tk_at == 201 {
            let ts = MP_START[MC_POS as usize]
            let tl = MP_END[MC_POS as usize] - ts
            if mc_src_eq_at(ts, tl, "f64") { let_is_f64 = 1 }
            else { let_st = mc_type_name_to_struct(ts, tl) }
        }
        mc_skip_type()
    }
    MC_POS = MC_POS + 1
    // If no type annotation, peek for struct literal: StructName {
    if let_st < 0 && let_is_f64 == 0 && MP_KIND[MC_POS as usize] == 120 {
        let rhs_s = MP_START[MC_POS as usize]
        let rhs_l = MP_END[MC_POS as usize] - rhs_s
        if MC_POS + 1 < MC_TC && MP_KIND[(MC_POS + 1) as usize] == 173 {
            let_st = mc_find_struct(rhs_s, rhs_l)
        }
    }
    mc_parse_expr()
    if let_st >= 0 {
        let slot = mc_add_local_struct(ns, nl, let_st)
        mc_emit_struct_copy_from_rax(slot, MC_ST_FLAT_SIZE[let_st as usize])
    } else if let_is_f64 == 1 {
        let slot = mc_add_local_f64(ns, nl)
        mc_emit_store_rax(slot)
    } else if MC_EXPR_IS_F64 == 1 {
        let slot = mc_add_local_f64(ns, nl)
        mc_emit_store_rax(slot)
    } else {
        let slot = mc_add_local(ns, nl)
        mc_emit_store_rax(slot)
        if MC_EXPR_ELEM_SZ == 1 {
            MC_LOC_TYPE[(MC_LOC_COUNT - 1) as usize] = -3
        }
    }
    0
}

fn mc_stmt_var() with Mut, Panic, Div {
    MC_POS = MC_POS + 1
    let ns = MP_START[MC_POS as usize]
    let ne = MP_END[MC_POS as usize]
    let nl = ne - ns
    MC_POS = MC_POS + 1  // consume ident
    // Optional type annotation — detect f64 and struct
    var var_is_f64: i64 = 0
    var var_st: i64 = -1
    if MP_KIND[MC_POS as usize] == 178 {
        MC_POS = MC_POS + 1
        let tk_at = MP_KIND[MC_POS as usize]
        if tk_at == 120 || tk_at == 201 {
            let ts = MP_START[MC_POS as usize]
            let tl = MP_END[MC_POS as usize] - ts
            if mc_src_eq_at(ts, tl, "f64") { var_is_f64 = 1 }
            else { var_st = mc_type_name_to_struct(ts, tl) }
        }
        mc_skip_type()
    }
    MC_POS = MC_POS + 1  // skip =
    // Detect local array initializer: [val; N]
    if var_st < 0 && var_is_f64 == 0 && MP_KIND[MC_POS as usize] == 175 {
        // Scan for ; inside brackets to get count
        var arr_depth: i64 = 1
        var arr_semi_pos: i64 = -1
        var arr_count: i64 = 4
        var ap: i64 = MC_POS + 1
        while ap < MC_TC && arr_depth > 0 {
            if MP_KIND[ap as usize] == 175 { arr_depth = arr_depth + 1 }
            if MP_KIND[ap as usize] == 176 { arr_depth = arr_depth - 1 }
            if arr_depth == 1 && MP_KIND[ap as usize] == 177 { arr_semi_pos = ap }
            ap = ap + 1
        }
        if arr_semi_pos >= 0 && arr_semi_pos + 1 < MC_TC && MP_KIND[(arr_semi_pos + 1) as usize] == 121 {
            arr_count = MP_INT_VALUE[(arr_semi_pos + 1) as usize]
        }
        let arr_slots = arr_count
        let base_slot = MC_NEXT_SLOT
        MC_NEXT_SLOT = MC_NEXT_SLOT + arr_slots
        let idx = MC_LOC_COUNT
        MC_LOC_NAME_START[idx as usize] = ns
        MC_LOC_NAME_LEN[idx as usize] = nl
        MC_LOC_SLOT[idx as usize] = base_slot
        MC_LOC_IS_F64[idx as usize] = 0
        MC_LOC_TYPE[idx as usize] = -2  // marks local array
        MC_LOC_COUNT = MC_LOC_COUNT + 1
        // Zero-initialize all slots
        var zi: i64 = 0
        while zi < arr_slots {
            we(0x48); we(0x31); we(0xC0)  // xor rax, rax
            mc_emit_store_rax(base_slot + zi)
            zi = zi + 1
        }
        MC_POS = ap  // skip past [val; N]
        return 0
    }
    if var_st < 0 && var_is_f64 == 0 && MP_KIND[MC_POS as usize] == 120 {
        let rhs_s = MP_START[MC_POS as usize]
        let rhs_l = MP_END[MC_POS as usize] - rhs_s
        if MC_POS + 1 < MC_TC && MP_KIND[(MC_POS + 1) as usize] == 173 {
            var_st = mc_find_struct(rhs_s, rhs_l)
        }
    }
    mc_parse_expr()
    if var_st >= 0 {
        let slot = mc_add_local_struct(ns, nl, var_st)
        mc_emit_struct_copy_from_rax(slot, MC_ST_FLAT_SIZE[var_st as usize])
    } else if var_is_f64 == 1 {
        let slot = mc_add_local_f64(ns, nl)
        mc_emit_store_rax(slot)
    } else if MC_EXPR_IS_F64 == 1 {
        let slot = mc_add_local_f64(ns, nl)
        mc_emit_store_rax(slot)
    } else {
        let slot = mc_add_local(ns, nl)
        mc_emit_store_rax(slot)
        if MC_EXPR_ELEM_SZ == 1 {
            MC_LOC_TYPE[(MC_LOC_COUNT - 1) as usize] = -3
        }
    }
    0
}

fn mc_stmt_return() with Mut, Panic, Div {
    MC_POS = MC_POS + 1
    let ret_tk = MP_KIND[MC_POS as usize]
    if ret_tk != 174 && ret_tk != 0 {
        mc_parse_expr()
    } else {
        we(0x48)
        we(0x31)
        we(0xc0)  // xor rax, rax
    }
    // Epilogue: mov rsp, rbp; pop rbp; ret
    we(0x48)
    we(0x89)
    we(0xec)
    we(0x5d)
    we(0xc3)
    0
}

fn mc_stmt_while() with Mut, Panic, Div {
    MC_POS = MC_POS + 1
    let loop_top = WIDE_LEN
    // Push loop state
    MC_LOOP_TOP_STACK[MC_LOOP_DEPTH as usize] = loop_top
    MC_LOOP_DEPTH = MC_LOOP_DEPTH + 1
    let saved_break_count = MC_BREAK_FIX_COUNT

    mc_parse_expr()
    // test rax, rax; jz end
    we(0x48)
    we(0x85)
    we(0xc0)
    we(0x0f)
    we(0x84)
    let end_fix = WIDE_LEN
    we32(0)

    MC_POS = MC_POS + 1
    mc_parse_block_body()
    MC_POS = MC_POS + 1

    // jmp loop_top
    we(0xe9)
    let back_disp = loop_top - (WIDE_LEN + 4)
    we32(back_disp)

    // Patch end_fix
    let end_off = WIDE_LEN
    let end_disp = end_off - (end_fix + 4)
    WIDE_OUT[end_fix as usize] = (end_disp & 0xFF) as i8
    WIDE_OUT[(end_fix + 1) as usize] = ((end_disp >> 8) & 0xFF) as i8
    WIDE_OUT[(end_fix + 2) as usize] = ((end_disp >> 16) & 0xFF) as i8
    WIDE_OUT[(end_fix + 3) as usize] = ((end_disp >> 24) & 0xFF) as i8

    // Patch break fixups for this loop level
    var bi: i64 = saved_break_count
    while bi < MC_BREAK_FIX_COUNT {
        let bf = MC_BREAK_FIX_OFF[bi as usize]
        let bd = end_off - (bf + 4)
        WIDE_OUT[bf as usize] = (bd & 0xFF) as i8
        WIDE_OUT[(bf + 1) as usize] = ((bd >> 8) & 0xFF) as i8
        WIDE_OUT[(bf + 2) as usize] = ((bd >> 16) & 0xFF) as i8
        WIDE_OUT[(bf + 3) as usize] = ((bd >> 24) & 0xFF) as i8
        bi = bi + 1
    }
    MC_BREAK_FIX_COUNT = saved_break_count

    MC_LOOP_DEPTH = MC_LOOP_DEPTH - 1
    0
}

fn mc_stmt_field_access() with Mut, Panic, Div {
    // SC_ID_S, SC_ID_LEN set by caller
    let id_s = SC_ID_S
    let id_len = SC_ID_LEN
    // Save position to detect assignment vs expression
    let dot_save_pos = MC_POS
    var dot_total_off: i64 = 0
    while MP_KIND[MC_POS as usize] == 180 {
        MC_POS = MC_POS + 1
        let dfs = MP_START[MC_POS as usize]
        let dfl = MP_END[MC_POS as usize] - dfs
        MC_POS = MC_POS + 1
        var dsi: i64 = 0
        while dsi < MC_ST_COUNT {
            let dfi = mc_find_struct_field(dsi, dfs, dfl)
            if dfi >= 0 {
                let dfb = MC_ST_FIELD_BASE[dsi as usize]
                dot_total_off = dot_total_off + MC_SF_OFFSET[(dfb + dfi) as usize]
                dsi = MC_ST_COUNT
            }
            dsi = dsi + 1
        }
    }
    if MP_KIND[MC_POS as usize] == 134 {
        // Field assignment: ident.field = expr
        MC_POS = MC_POS + 1
        mc_parse_expr()
        let slot = mc_find_local(id_s, id_len)
        if slot >= 0 {
            mc_emit_store_rax(slot + dot_total_off)
        }
        return 0
    }
    // Not assignment — rewind and parse as expression
    MC_POS = dot_save_pos - 1  // rewind to ident
    mc_parse_expr()
    0
}

fn mc_stmt_compound_assign() with Mut, Panic, Div {
    // SC_ID_S, SC_ID_LEN set by caller
    let id_s = SC_ID_S
    let id_len = SC_ID_LEN
    let op = MP_KIND[MC_POS as usize]
    MC_POS = MC_POS + 1
    mc_parse_expr()
    let slot = mc_find_local(id_s, id_len)
    if slot >= 0 {
        we(0x48)
        we(0x89)
        we(0xc1)  // mov rcx, rax
        mc_emit_load_rax(slot)
        if op == 151 {
            // +=
            we(0x48)
            we(0x01)
            we(0xc8)  // add rax, rcx
        } else if op == 152 {
            // -=
            we(0x48)
            we(0x29)
            we(0xc8)  // sub rax, rcx
        } else if op == 153 {
            // *=
            we(0x48)
            we(0x0f)
            we(0xaf)
            we(0xc1)  // imul rax, rcx
        }
        mc_emit_store_rax(slot)
    }
    0
}

fn mc_stmt_trailing_binops_f64(op: i64) with Mut, Panic {
    // movq xmm0, rax; movq xmm1, rcx
    we(0x66)
    we(0x48)
    we(0x0F)
    we(0x6E)
    we(0xC0)
    we(0x66)
    we(0x48)
    we(0x0F)
    we(0x6E)
    we(0xC9)
    if op == 129 { we(0xF2)
    we(0x0F)
    we(0x58)
    we(0xC1) }
    else if op == 130 { we(0xF2)
    we(0x0F)
    we(0x5C)
    we(0xC1) }
    else if op == 131 { we(0xF2)
    we(0x0F)
    we(0x59)
    we(0xC1) }
    else if op == 132 { we(0xF2)
    we(0x0F)
    we(0x5E)
    we(0xC1) }
    // movq rax, xmm0
    we(0x66)
    we(0x48)
    we(0x0F)
    we(0x7E)
    we(0xC0)
    MC_EXPR_IS_F64 = 1
    0
}

fn mc_stmt_trailing_cmp_f64(op: i64) with Mut, Panic {
    // movq xmm0, rax; movq xmm1, rcx; ucomisd xmm0, xmm1
    we(0x66)
    we(0x48)
    we(0x0F)
    we(0x6E)
    we(0xC0)
    we(0x66)
    we(0x48)
    we(0x0F)
    we(0x6E)
    we(0xC9)
    we(0x66)
    we(0x0F)
    we(0x2E)
    we(0xC1)
    if op == 143 { we(0x0f)
    we(0x94)
    we(0xc0) }
    else if op == 144 { we(0x0f)
    we(0x95)
    we(0xc0) }
    else if op == 135 { we(0x0f)
    we(0x92)
    we(0xc0) }
    else if op == 136 { we(0x0f)
    we(0x97)
    we(0xc0) }
    else if op == 145 { we(0x0f)
    we(0x96)
    we(0xc0) }
    else if op == 146 { we(0x0f)
    we(0x93)
    we(0xc0) }
    we(0x48)
    we(0x0f)
    we(0xb6)
    we(0xc0)
    MC_EXPR_IS_F64 = 0
    0
}

fn mc_stmt_trailing_binop_int(op: i64) with Mut, Panic {
    if op == 129 { we(0x48)
    we(0x01)
    we(0xc8) }
    else if op == 130 { we(0x48)
    we(0x29)
    we(0xc8) }
    else if op == 131 { we(0x48)
    we(0x0f)
    we(0xaf)
    we(0xc1) }
    else if op == 132 { we(0x48)
    we(0x99)
    we(0x48)
    we(0xf7)
    we(0xf9) }
    else if op == 133 { we(0x48)
    we(0x99)
    we(0x48)
    we(0xf7)
    we(0xf9)
    we(0x48)
    we(0x89)
    we(0xd0) }
    else if op == 143 { we(0x48)
    we(0x39)
    we(0xc8)
    we(0x0f)
    we(0x94)
    we(0xc0)
    we(0x48)
    we(0x0f)
    we(0xb6)
    we(0xc0) }
    else if op == 144 { we(0x48)
    we(0x39)
    we(0xc8)
    we(0x0f)
    we(0x95)
    we(0xc0)
    we(0x48)
    we(0x0f)
    we(0xb6)
    we(0xc0) }
    else if op == 135 { we(0x48)
    we(0x39)
    we(0xc8)
    we(0x0f)
    we(0x9c)
    we(0xc0)
    we(0x48)
    we(0x0f)
    we(0xb6)
    we(0xc0) }
    else if op == 136 { we(0x48)
    we(0x39)
    we(0xc8)
    we(0x0f)
    we(0x9f)
    we(0xc0)
    we(0x48)
    we(0x0f)
    we(0xb6)
    we(0xc0) }
    else if op == 145 { we(0x48)
    we(0x39)
    we(0xc8)
    we(0x0f)
    we(0x9e)
    we(0xc0)
    we(0x48)
    we(0x0f)
    we(0xb6)
    we(0xc0) }
    else if op == 146 { we(0x48)
    we(0x39)
    we(0xc8)
    we(0x0f)
    we(0x9d)
    we(0xc0)
    we(0x48)
    we(0x0f)
    we(0xb6)
    we(0xc0) }
    else if op == 147 {
        we(0x48)
        we(0x85)
        we(0xc0)
        we(0x0f)
        we(0x95)
        we(0xc0)
        we(0x48)
        we(0x85)
        we(0xc9)
        we(0x0f)
        we(0x95)
        we(0xc1)
        we(0x20)
        we(0xc8)
        we(0x48)
        we(0x0f)
        we(0xb6)
        we(0xc0)
    }
    else if op == 148 {
        we(0x48)
        we(0x09)
        we(0xc8)
        we(0x48)
        we(0x85)
        we(0xc0)
        we(0x0f)
        we(0x95)
        we(0xc0)
        we(0x48)
        we(0x0f)
        we(0xb6)
        we(0xc0)
    }
    0
}

fn mc_stmt_trailing_binops() with Mut, Panic, Div {
    while true {
        let op = MP_KIND[MC_POS as usize]
        let prec = mc_binop_prec(op)
        if prec == 0 { break }
        MC_POS = MC_POS + 1
        let ls = mc_alloc_slot()
        mc_emit_store_rax(ls)
        var stmt_left_f64 = MC_EXPR_IS_F64
        mc_parse_expr_prec(prec + 1)
        we(0x48)
        we(0x89)
        we(0xc1)
        mc_emit_load_rax(ls)
        // f64 arithmetic path — boot4-safe: no && with ||
        var did_f64: i64 = 0
        if stmt_left_f64 == 1 {
            if op == 129 { mc_stmt_trailing_binops_f64(op)
            did_f64 = 1 }
            if op == 130 { mc_stmt_trailing_binops_f64(op)
            did_f64 = 1 }
            if op == 131 { mc_stmt_trailing_binops_f64(op)
            did_f64 = 1 }
            if op == 132 { mc_stmt_trailing_binops_f64(op)
            did_f64 = 1 }
            if op == 143 { mc_stmt_trailing_cmp_f64(op)
            did_f64 = 1 }
            if op == 144 { mc_stmt_trailing_cmp_f64(op)
            did_f64 = 1 }
            if op == 135 { mc_stmt_trailing_cmp_f64(op)
            did_f64 = 1 }
            if op == 136 { mc_stmt_trailing_cmp_f64(op)
            did_f64 = 1 }
            if op == 145 { mc_stmt_trailing_cmp_f64(op)
            did_f64 = 1 }
            if op == 146 { mc_stmt_trailing_cmp_f64(op)
            did_f64 = 1 }
        }
        if did_f64 == 0 {
            mc_stmt_trailing_binop_int(op)
        }
    }
    0
}

fn mc_stmt_ident() with Mut, Panic, Div {
    // SC_ID_S, SC_ID_LEN set by caller
    let id_s = SC_ID_S
    let id_len = SC_ID_LEN
    MC_POS = MC_POS + 1

    // Field access or assignment: ident.field[.field...]
    if MP_KIND[MC_POS as usize] == 180 {
        mc_stmt_field_access()
        return 0
    }

    // Array index: ident[idx] = expr  OR  ident[idx] (read)
    // 175=LBracket, 176=RBracket, 27=As keyword
    if MP_KIND[MC_POS as usize] == 175 {
        MC_POS = MC_POS + 1  // skip [
        mc_parse_expr()        // index → rax
        if MP_KIND[MC_POS as usize] == 27 { MC_POS = MC_POS + 1 }   // skip 'as'
        if MP_KIND[MC_POS as usize] == 120 { MC_POS = MC_POS + 1 }  // skip 'usize'
        if MP_KIND[MC_POS as usize] == 176 { MC_POS = MC_POS + 1 }  // skip ]

        let agi = mc_find_global_src(id_s, id_len)
        var a_elem_sz: i64 = 8
        if agi >= 0 { a_elem_sz = GLOBAL_ELEM_SIZES[agi as usize] }

        if MP_KIND[MC_POS as usize] == 134 {
            // Assignment: ident[idx] = expr
            MC_POS = MC_POS + 1
            let idx_tmp = mc_alloc_slot()
            mc_emit_store_rax(idx_tmp)  // save index to slot (not push — push corrupts frame)
            mc_parse_expr()  // value → rax
            we(0x48); we(0x89); we(0xC2)  // mov rdx, rax (value)
            mc_emit_load_rax(idx_tmp)     // load index from slot
            if agi >= 0 {
                let gaddr = MC_BSS_BASE() + GLOBAL_OFFSETS[agi as usize]
                if a_elem_sz == 1 {
                    we(0x48); we(0xB9)
                    var k: i64 = 0
                    while k < 8 { we((gaddr >> (k * 8)) & 0xFF); k = k + 1 }
                    we(0x48); we(0x01); we(0xC1)  // add rcx, rax
                    we(0x88); we(0x11)             // mov [rcx], dl
                } else {
                    we(0x48); we(0xC1); we(0xE0); we(0x03)  // shl rax, 3
                    we(0x48); we(0xB9)
                    var k: i64 = 0
                    while k < 8 { we((gaddr >> (k * 8)) & 0xFF); k = k + 1 }
                    we(0x48); we(0x01); we(0xC1)  // add rcx, rax
                    we(0x48); we(0x89); we(0x11)  // mov [rcx], rdx
                }
            } else {
                // Local array store: contragradiant sub
                let la_slot2 = mc_find_local(id_s, id_len)
                if la_slot2 >= 0 {
                    let idx_tmp2 = mc_alloc_slot()
                    we(0x48); we(0xC1); we(0xE0); we(0x03)  // shl rax, 3
                    mc_emit_store_rax(idx_tmp2)
                    mc_emit_lea_slot(la_slot2)
                    we(0x48); we(0x89); we(0xC1)  // mov rcx, rax (base)
                    mc_emit_load_rax(idx_tmp2)
                    we(0x48); we(0x29); we(0xC1)  // sub rcx, rax
                    we(0x48); we(0x89); we(0x11)  // mov [rcx], rdx
                } else {
                    // Local pointer store: raw[idx] = val
                    let lp2_slot = mc_find_local(id_s, id_len)
                    if lp2_slot >= 0 {
                        // rax=index, rdx=value; ptr in slot
                        let lp2_idx = mc_alloc_slot()
                        mc_emit_store_rax(lp2_idx)
                        mc_emit_load_rax(lp2_slot)
                        we(0x48); we(0x89); we(0xC1)  // mov rcx, rax (ptr)
                        mc_emit_load_rax(lp2_idx)
                        we(0x48); we(0x01); we(0xC8)  // add rax, rcx
                        we(0x88); we(0x10)             // mov [rax], dl (byte store)
                    }
                }
            }
        } else {
            // Read: ident[idx] → rax
            if agi >= 0 {
                let gaddr = MC_BSS_BASE() + GLOBAL_OFFSETS[agi as usize]
                if a_elem_sz == 1 {
                    we(0x48); we(0xB9)
                    var k: i64 = 0
                    while k < 8 { we((gaddr >> (k * 8)) & 0xFF); k = k + 1 }
                    we(0x48); we(0x01); we(0xC8)  // add rax, rcx
                    we(0x48); we(0x0F); we(0xB6); we(0x00)  // movzx rax, byte [rax]
                } else {
                    we(0x48); we(0xC1); we(0xE0); we(0x03)  // shl rax, 3
                    we(0x48); we(0xB9)
                    var k: i64 = 0
                    while k < 8 { we((gaddr >> (k * 8)) & 0xFF); k = k + 1 }
                    we(0x48); we(0x01); we(0xC8)  // add rax, rcx
                    we(0x48); we(0x8B); we(0x00)  // mov rax, [rax]
                }
            } else {
                // Local pointer indexing: raw[idx] where raw is a local scalar (pointer)
                let lp_slot = mc_find_local(id_s, id_len)
                if lp_slot >= 0 {
                    // rax = index; load pointer from slot, add index, deref
                    let lp_idx_slot = mc_alloc_slot()
                    mc_emit_store_rax(lp_idx_slot)       // save index
                    mc_emit_load_rax(lp_slot)             // rax = pointer
                    we(0x48); we(0x89); we(0xC1)          // mov rcx, rax (pointer)
                    mc_emit_load_rax(lp_idx_slot)         // rax = index
                    we(0x48); we(0x01); we(0xC8)          // add rax, rcx (ptr + index)
                    we(0x48); we(0x0F); we(0xB6); we(0x00) // movzx rax, byte [rax]
                }
            }
        }
        // Consume trailing 'as TYPE' (e.g., BUF[idx as usize] as i64)
        if MP_KIND[MC_POS as usize] == 27 {
            MC_POS = MC_POS + 1
            if MP_KIND[MC_POS as usize] == 120 || MP_KIND[MC_POS as usize] == 201 { MC_POS = MC_POS + 1 }
        }
        mc_stmt_trailing_binops()
        return 0
    }

    // Assignment: ident = expr
    if MP_KIND[MC_POS as usize] == 134 {
        MC_POS = MC_POS + 1
        mc_parse_expr()
        let slot = mc_find_local(id_s, id_len)
        if slot >= 0 {
            mc_emit_store_rax(slot)
        } else {
            let gi = mc_find_global_src(id_s, id_len)
            if gi >= 0 {
                mc_emit_store_global_scalar(gi)
            }
        }
        return 0
    }

    // Compound assignment: ident PlusEq expr or MinusEq or StarEq
    if MP_KIND[MC_POS as usize] == 151 {
        mc_stmt_compound_assign()
        return 0
    }
    if MP_KIND[MC_POS as usize] == 152 {
        mc_stmt_compound_assign()
        return 0
    }
    if MP_KIND[MC_POS as usize] == 153 {
        mc_stmt_compound_assign()
        return 0
    }

    // Function call: ident(args)
    if MP_KIND[MC_POS as usize] == 171 {
        MC_POS = MC_POS + 1
        mc_emit_call(id_s, id_len)
        // rax = call result; fall through to trailing binop check
    } else {
        // Bare expression — the ident was already consumed, emit variable load
        let slot = mc_find_local(id_s, id_len)
        if slot >= 0 {
            mc_emit_load_rax(slot)
            MC_EXPR_IS_F64 = mc_local_is_f64(id_s, id_len)
        } else {
            // Try global
            let gi_fb = mc_find_global_src(id_s, id_len)
            if gi_fb >= 0 {
                let gsz_fb = GLOBAL_SIZES[gi_fb as usize]
                if gsz_fb > 8 {
                    mc_emit_load_global_base()
                    let goff_fb = GLOBAL_OFFSETS[gi_fb as usize]
                    if goff_fb > 0 {
                        we(0x48); we(0x05)
                        we(goff_fb & 0xFF); we((goff_fb >> 8) & 0xFF)
                        we((goff_fb >> 16) & 0xFF); we((goff_fb >> 24) & 0xFF)
                    }
                } else {
                    mc_emit_load_global_scalar(gi_fb)
                }
                MC_EXPR_ELEM_SZ = GLOBAL_ELEM_SIZES[gi_fb as usize]
                MC_EXPR_IS_F64 = GLOBAL_IS_FLOAT[gi_fb as usize]
            } else {
                we(0x48)
                we(0x31)
                we(0xc0)
                MC_EXPR_IS_F64 = 0
            }
        }
    }
    // Check for trailing binops
    mc_stmt_trailing_binops()
    0
}

// --- Statement parser ---

fn mc_parse_stmt() with Mut, Panic, Div {
    let k = MP_KIND[MC_POS as usize]
    if k == 8 { mc_stmt_let()
    return 0 }
    if k == 9 { mc_stmt_var()
    return 0 }
    if k == 25 { mc_stmt_return()
    return 0 }
    if k == 21 { mc_stmt_while()
    return 0 }
    if k == 23 {
        MC_POS = MC_POS + 1
        we(0xe9)
        MC_BREAK_FIX_OFF[MC_BREAK_FIX_COUNT as usize] = WIDE_LEN
        MC_BREAK_FIX_COUNT = MC_BREAK_FIX_COUNT + 1
        we32(0)
        return 0
    }
    if k == 24 {
        MC_POS = MC_POS + 1
        if MC_LOOP_DEPTH > 0 {
            let lt = MC_LOOP_TOP_STACK[(MC_LOOP_DEPTH - 1) as usize]
            we(0xe9)
            let cd = lt - (WIDE_LEN + 4)
            we32(cd)
        }
        return 0
    }
    if k == 17 { mc_parse_if_expr()
    return 0 }
    if k == 202 { mc_parse_match_expr()
    return 0 }
    if k == 120 {
        SC_ID_S = MP_START[MC_POS as usize]
        SC_ID_LEN = MP_END[MC_POS as usize] - SC_ID_S
        mc_stmt_ident()
        return 0
    }
    mc_parse_expr()
    0
}

// Skip a type annotation (consumes tokens until next = or { or , or ) )
fn mc_skip_type() with Mut, Panic {
    SC_DEPTH = 0
    while MC_POS < MC_TC {
        let tk = MP_KIND[MC_POS as usize]
        // Opening brackets: ( [ <
        if tk == 171 { SC_DEPTH = SC_DEPTH + 1
            MC_POS = MC_POS + 1
            continue }
        if tk == 175 { SC_DEPTH = SC_DEPTH + 1
            MC_POS = MC_POS + 1
            continue }
        if tk == 135 { SC_DEPTH = SC_DEPTH + 1
            MC_POS = MC_POS + 1
            continue }
        // Closing brackets: ) ] >
        if tk == 172 {
            if SC_DEPTH > 0 { SC_DEPTH = SC_DEPTH - 1
                MC_POS = MC_POS + 1
                continue }
            break
        }
        if tk == 176 {
            if SC_DEPTH > 0 { SC_DEPTH = SC_DEPTH - 1
                MC_POS = MC_POS + 1
                continue }
            break
        }
        if tk == 136 {
            if SC_DEPTH > 0 { SC_DEPTH = SC_DEPTH - 1
                MC_POS = MC_POS + 1
                continue }
            break
        }
        if SC_DEPTH == 0 {
            if tk == 134 { break }
            if tk == 173 { break }
            if tk == 179 { break }
            if tk == 42 { break }
        }
        MC_POS = MC_POS + 1
    }
}

// Parse block body (between { and }) — handles multiple statements
fn mc_parse_block_body() with Mut, Panic, Div {
    while true {
        let pk = MP_KIND[MC_POS as usize]
        if pk == 174 || pk == 0 { break }
        mc_parse_stmt()
    }
}

// --- Pass 0: Scan struct declarations ---
fn mc_scan_structs() with Mut, Panic, Div {
    MC_POS = 0
    MC_ST_COUNT = 0
    MC_SF_TOTAL = 0
    while MC_POS < MC_TC {
        let k = MP_KIND[MC_POS as usize]
        if k == 200 {
            MC_POS = MC_POS + 1
            // Struct name
            let ns = MP_START[MC_POS as usize]
            let ne = MP_END[MC_POS as usize]
            let nl = ne - ns
            let si = MC_ST_COUNT
            MC_ST_NAME_START[si as usize] = ns
            MC_ST_NAME_LEN[si as usize] = nl
            MC_ST_FIELD_BASE[si as usize] = MC_SF_TOTAL
            MC_POS = MC_POS + 1  // consume name
            MC_POS = MC_POS + 1
            var fc: i64 = 0
            var flat_off: i64 = 0
            while true {
        let pk = MP_KIND[MC_POS as usize]
        if pk == 174 || pk == 0 { break }
                // field_name : type ,
                let fs = MP_START[MC_POS as usize]
                let fe = MP_END[MC_POS as usize]
                let fl = fe - fs
                MC_POS = MC_POS + 1  // consume field name
                let fi = MC_SF_TOTAL
                MC_SF_NAME_START[fi as usize] = fs
                MC_SF_NAME_LEN[fi as usize] = fl
                MC_SF_OFFSET[fi as usize] = flat_off
                // Parse : type
                var field_struct: i64 = -1
                var field_flat: i64 = 1
                var field_is_f64: i64 = 0
                if MP_KIND[MC_POS as usize] == 178 {
                    MC_POS = MC_POS + 1
                    // Read type name token
                    if MP_KIND[MC_POS as usize] == 120 || MP_KIND[MC_POS as usize] == 200 || MP_KIND[MC_POS as usize] == 201 {
                        let ts = MP_START[MC_POS as usize]
                        let te = MP_END[MC_POS as usize]
                        let tl = te - ts
                        // Look up if it's a previously declared struct
                        field_struct = mc_find_struct(ts, tl)
                        if field_struct >= 0 {
                            field_flat = MC_ST_FLAT_SIZE[field_struct as usize]
                        }
                        if tl == 3 {
                            if (LEAN_SOURCE[ts as usize] as i64) == 102 && (LEAN_SOURCE[(ts + 1) as usize] as i64) == 54 && (LEAN_SOURCE[(ts + 2) as usize] as i64) == 52 {
                                field_is_f64 = 1
                            }
                        }
                        MC_POS = MC_POS + 1
                    } else if MP_KIND[MC_POS as usize] == 175 {
                        let arr_ty_pos = MC_POS + 1
                        if arr_ty_pos < MC_TC {
                            let ats = MP_START[arr_ty_pos as usize]
                            let ate = MP_END[arr_ty_pos as usize]
                            if ate - ats == 3 {
                                if (LEAN_SOURCE[ats as usize] as i64) == 102 && (LEAN_SOURCE[(ats + 1) as usize] as i64) == 54 && (LEAN_SOURCE[(ats + 2) as usize] as i64) == 52 {
                                    field_is_f64 = 2
                                }
                            }
                        }
                        mc_skip_type()
                    } else {
                        // Skip other type tokens (scalars etc)
                        mc_skip_type()
                    }
                }
                // Legacy fallback for scalar f64 tokens that were already consumed.
                if field_is_f64 == 0 && field_struct < 0 && field_flat == 1 {
                    // Re-check type name for "f64"
                    let fts = MC_SF_NAME_START[fi as usize]  // reuse for type check
                    // Actually check the type token we just parsed
                    // The type was at ts,tl — check if it's "f64" (102, 54, 52)
                    if MP_KIND[MC_POS as usize] == 179 || MP_KIND[MC_POS as usize] == 174 {
                        // Type already consumed; check ts/tl from above
                        // Note: ts/tl are out of scope here, so check via flat_off tracking
                        // Instead, peek back at the source bytes at the type token position
                        let ft_pos = MC_POS - 1
                        if ft_pos >= 0 && ft_pos < MC_TC {
                            let fts2 = MP_START[ft_pos as usize]
                            let fte2 = MP_END[ft_pos as usize]
                            if fte2 - fts2 == 3 {
                                if (LEAN_SOURCE[(fts2) as usize] as i64) == 102 && (LEAN_SOURCE[(fts2 + 1) as usize] as i64) == 54 && (LEAN_SOURCE[(fts2 + 2) as usize] as i64) == 52 {
                                    field_is_f64 = 1
                                }
                            }
                        }
                    }
                }
                MC_SF_FLAT_SIZE[fi as usize] = field_flat
                MC_SF_TYPE_STRUCT[fi as usize] = field_struct
                MC_SF_IS_F64[fi as usize] = field_is_f64
                MC_SF_TOTAL = MC_SF_TOTAL + 1
                flat_off = flat_off + field_flat
                fc = fc + 1
                if MP_KIND[MC_POS as usize] == 179 { MC_POS = MC_POS + 1 }
            }
            MC_POS = MC_POS + 1
            MC_ST_FIELD_COUNT[si as usize] = fc
            MC_ST_FLAT_SIZE[si as usize] = flat_off
            MC_ST_COUNT = MC_ST_COUNT + 1
            print("mc: struct ")
            var pi: i64 = 0
            while pi < nl && pi < 32 { print_char((LEAN_SOURCE[(ns + pi) as usize] as i64) as i64); pi = pi + 1 }
            print(" fields=")
            print_int(fc)
            print(" flat=")
            print_int(flat_off)
            print("\n")
        } else {
            MC_POS = MC_POS + 1
        }
    }
}

// --- Pass 0b: Scan enum declarations ---
fn mc_scan_enums() with Mut, Panic, Div {
    MC_POS = 0
    MC_EN_COUNT = 0
    MC_EV_COUNT = 0
    while MC_POS < MC_TC {
        let k = MP_KIND[MC_POS as usize]
        if k == 201 {
            MC_POS = MC_POS + 1
            // Enum name
            let ns = MP_START[MC_POS as usize]
            let ne = MP_END[MC_POS as usize]
            let nl = ne - ns
            let ei = MC_EN_COUNT
            MC_EN_NAME_START[ei as usize] = ns
            MC_EN_NAME_LEN[ei as usize] = nl
            MC_EN_FIRST_EV[ei as usize] = MC_EV_COUNT
            MC_POS = MC_POS + 1  // consume name
            MC_POS = MC_POS + 1
            var vc: i64 = 0
            while true {
        let pk = MP_KIND[MC_POS as usize]
        if pk == 174 || pk == 0 { break }
                // Variant name
                let vs = MP_START[MC_POS as usize]
                let ve = MP_END[MC_POS as usize]
                let vl = ve - vs
                MC_POS = MC_POS + 1  // consume variant name
                let vi = MC_EV_COUNT
                MC_EV_NAME_START[vi as usize] = vs
                MC_EV_NAME_LEN[vi as usize] = vl
                MC_EV_VALUE[vi as usize] = vc
                MC_EV_COUNT = MC_EV_COUNT + 1
                vc = vc + 1
                if MP_KIND[MC_POS as usize] == 179 { MC_POS = MC_POS + 1 }
            }
            MC_POS = MC_POS + 1
            MC_EN_EV_COUNT[ei as usize] = vc
            MC_EN_COUNT = MC_EN_COUNT + 1
            print("mc: enum ")
            var pi: i64 = 0
            while pi < nl && pi < 32 { print_char((LEAN_SOURCE[(ns + pi) as usize] as i64) as i64); pi = pi + 1 }
            print(" variants=")
            print_int(vc)
            print("\n")
        } else {
            MC_POS = MC_POS + 1
        }
    }
}

// boot4-safe helpers: small functions with few locals to avoid frame overflow

fn mc_scan_fn_params() with Mut, Panic, Div {
    while MC_POS < MC_TC {
        if MP_KIND[MC_POS as usize] == 172 { break }
        if MP_KIND[MC_POS as usize] == 0 { break }
        SC_NS = MP_START[MC_POS as usize]
        SC_NE = MP_END[MC_POS as usize]
        MC_POS = MC_POS + 1
        MC_PARAM_NAME_START[MC_PARAM_TOTAL as usize] = SC_NS
        MC_PARAM_NAME_LEN[MC_PARAM_TOTAL as usize] = SC_NE - SC_NS
        MC_PARAM_TYPE[MC_PARAM_TOTAL as usize] = -1
        MC_PARAM_IS_F64[MC_PARAM_TOTAL as usize] = 0
        if MP_KIND[MC_POS as usize] == 178 {
            MC_POS = MC_POS + 1
            if MP_KIND[MC_POS as usize] == 120 {
                if mc_src_eq_at(MP_START[MC_POS as usize], MP_END[MC_POS as usize] - MP_START[MC_POS as usize], "f64") {
                    MC_PARAM_IS_F64[MC_PARAM_TOTAL as usize] = 1
                } else {
                    MC_PARAM_TYPE[MC_PARAM_TOTAL as usize] = mc_type_name_to_struct(MP_START[MC_POS as usize], MP_END[MC_POS as usize] - MP_START[MC_POS as usize])
                }
            }
            mc_skip_type()
        }
        MC_PARAM_TOTAL = MC_PARAM_TOTAL + 1
        SC_PC = SC_PC + 1
        if MP_KIND[MC_POS as usize] == 179 { MC_POS = MC_POS + 1 }
    }
}

fn mc_scan_fn_return_and_effects() with Mut, Panic {
    print("R")
    if MP_KIND[MC_POS as usize] == 155 {
        print(">")
        MC_POS = MC_POS + 1
        let rtk = MP_KIND[MC_POS as usize]
        if rtk == 120 {
            MC_FN_RET_TYPE[SC_FI as usize] = mc_type_name_to_struct(MP_START[MC_POS as usize], MP_END[MC_POS as usize] - MP_START[MC_POS as usize])
        }
        if rtk == 200 {
            MC_FN_RET_TYPE[SC_FI as usize] = mc_type_name_to_struct(MP_START[MC_POS as usize], MP_END[MC_POS as usize] - MP_START[MC_POS as usize])
        }
        mc_skip_type()
    }
    if MP_KIND[MC_POS as usize] == 42 {
        MC_POS = MC_POS + 1
        while MC_POS < MC_TC {
            let etk = MP_KIND[MC_POS as usize]
            if etk != 120 && etk != 179 { break }
            MC_POS = MC_POS + 1
        }
    }
}

fn mc_skip_braces() with Mut, Panic {
    if MP_KIND[MC_POS as usize] == 173 {
        MC_POS = MC_POS + 1
        SC_DEPTH = 1
        while MC_POS < MC_TC {
            if SC_DEPTH == 0 { break }
            if MP_KIND[MC_POS as usize] == 173 { SC_DEPTH = SC_DEPTH + 1 }
            if MP_KIND[MC_POS as usize] == 174 { SC_DEPTH = SC_DEPTH - 1 }
            MC_POS = MC_POS + 1
        }
    }
}

// --- Pass 1: Scan all fn declarations — boot4-safe (uses SC_ globals to avoid frame overflow) ---
fn mc_scan_functions() with Mut, Panic, Div {
    MC_POS = 0
    MC_FN_COUNT = 0
    MC_PARAM_TOTAL = 0
    print("SF\n")
    while MC_POS < MC_TC {
        print(".")
        if MP_KIND[MC_POS as usize] == 7 {
            MC_POS = MC_POS + 1
            print("A")
            SC_NS = MP_START[MC_POS as usize]
            print("B")
            SC_NE = MP_END[MC_POS as usize]
            SC_NL = SC_NE - SC_NS
            SC_FI = MC_FN_COUNT
            print("C")
            MC_FN_NAME_START[SC_FI as usize] = SC_NS
            MC_FN_NAME_LEN[SC_FI as usize] = SC_NL
            MC_FN_OFF[SC_FI as usize] = 0
            MC_FN_PARAM_BASE[SC_FI as usize] = MC_PARAM_TOTAL
            MC_POS = MC_POS + 1
            print("D")
            if mc_src_eq_at(SC_NS, SC_NL, "main") { MC_MAIN_FN = SC_FI }
            print("E")
            MC_POS = MC_POS + 1
            SC_PC = 0
            print("F")
            mc_scan_fn_params()
            print("G")
            MC_POS = MC_POS + 1
            MC_FN_PARAM_COUNT[SC_FI as usize] = SC_PC
            MC_FN_RET_TYPE[SC_FI as usize] = -1
            // Skip to body { — just advance until we hit { (boot4 frame too small for full parsing)
            while MC_POS < MC_TC {
                if MP_KIND[MC_POS as usize] == 173 { break }
                MC_POS = MC_POS + 1
            }
            print("I")
            MC_FN_BODY_TOK[SC_FI as usize] = MC_POS
            MC_FN_COUNT = MC_FN_COUNT + 1
            print("J")
            mc_skip_braces()
            print("K")
        } else if MP_KIND[MC_POS as usize] == 200 || MP_KIND[MC_POS as usize] == 201 {
            // Skip struct/enum declaration — advance past name + braces
            MC_POS = MC_POS + 1
            if MP_KIND[MC_POS as usize] == 120 { MC_POS = MC_POS + 1 }
            mc_skip_braces()
        } else {
            MC_POS = MC_POS + 1
        }
    }
}

// --- Pass 2: Compile each function body ---
fn mc_compile_functions() with Mut, Panic, Div {
    print("CF\n")
    var fi: i64 = 0
    while fi < MC_FN_COUNT {
        print("CF:")
        MC_FN_OFF[fi as usize] = WIDE_LEN

        // Reset locals
        mc_locals_reset()

        // Prologue: push rbp; mov rbp, rsp; sub rsp, FRAME_SIZE
        we(0x55)
        we(0x48)
        we(0x89)
        we(0xe5)
        we(0x48)
        we(0x81)
        we(0xec)
        we32(MC_FRAME_SIZE())

        // Spill parameters into local slots
        let param_base = MC_FN_PARAM_BASE[fi as usize]
        let param_count = MC_FN_PARAM_COUNT[fi as usize]
        var pi: i64 = 0
        while pi < param_count {
            let ps = MC_PARAM_NAME_START[(param_base + pi) as usize]
            let pl = MC_PARAM_NAME_LEN[(param_base + pi) as usize]
            let pst = MC_PARAM_TYPE[(param_base + pi) as usize]
            if pst >= 0 {
                // Struct parameter: register holds pointer to struct data
                let slot = mc_add_local_struct(ps, pl, pst)
                // Move pointer from ABI register into rax
                if pi == 0 { we(0x48)
                we(0x89)
                we(0xf8) }       // mov rax, rdi
                else if pi == 1 { we(0x48)
                we(0x89)
                we(0xf0) }  // mov rax, rsi
                else if pi == 2 { we(0x48)
                we(0x89)
                we(0xd0) }  // mov rax, rdx
                else if pi == 3 { we(0x48)
                we(0x89)
                we(0xc8) }  // mov rax, rcx
                else if pi == 4 { we(0x4c)
                we(0x89)
                we(0xc0) }  // mov rax, r8
                else if pi == 5 { we(0x4c)
                we(0x89)
                we(0xc8) }  // mov rax, r9
                // Copy struct fields from [rax] to local stack slots
                mc_emit_struct_copy_from_rax(slot, MC_ST_FLAT_SIZE[pst as usize])
            } else {
                // Scalar or f64 parameter
                let param_is_float = MC_PARAM_IS_F64[(param_base + pi) as usize]
                var slot: i64 = 0
                if param_is_float == 1 {
                    slot = mc_add_local_f64(ps, pl)
                } else {
                    slot = mc_add_local(ps, pl)
                }
                if pi == 0 { we(0x48)
                we(0x89)
                we(0xf8) }       // mov rax, rdi
                else if pi == 1 { we(0x48)
                we(0x89)
                we(0xf0) }  // mov rax, rsi
                else if pi == 2 { we(0x48)
                we(0x89)
                we(0xd0) }  // mov rax, rdx
                else if pi == 3 { we(0x48)
                we(0x89)
                we(0xc8) }  // mov rax, rcx
                else if pi == 4 { we(0x4c)
                we(0x89)
                we(0xc0) }  // mov rax, r8
                else if pi == 5 { we(0x4c)
                we(0x89)
                we(0xc8) }  // mov rax, r9
                mc_emit_store_rax(slot)
            }
            pi = pi + 1
        }

        // Position at body start (should be { token)
        MC_POS = MC_FN_BODY_TOK[fi as usize]
        MC_POS = MC_POS + 1

        // Compile body statements
        mc_parse_block_body()
        MC_POS = MC_POS + 1

        // Implicit epilogue (if not already returned)
        // Check if last emitted byte was ret
        if WIDE_LEN == 0 || WIDE_OUT[(WIDE_LEN - 1) as usize] != (0xc3 as i8) {
            // Don't zero rax — last expression value is the implicit return
            // mov rsp, rbp; pop rbp; ret
            we(0x48)
            we(0x89)
            we(0xec)
            we(0x5d)
            we(0xc3)
        }

        print("mc: fn ")
        var ni: i64 = 0
        let nns = MC_FN_NAME_START[fi as usize]
        let nnl = MC_FN_NAME_LEN[fi as usize]
        while ni < nnl && ni < 32 {
            print_char((LEAN_SOURCE[(nns + ni) as usize] as i64) as i64)
            ni = ni + 1
        }
        print(" off=")
        print_int(MC_FN_OFF[fi as usize])
        print(" sz=")
        print_int(WIDE_LEN - MC_FN_OFF[fi as usize])
        print(" slots=")
        print_int(MC_NEXT_SLOT)
        print("\n")

        fi = fi + 1
    }
}

// --- Patch call fixups ---
fn mc_patch_calls() with Mut, Panic {
    var i: i64 = 0
    while i < MC_CALL_FIX_COUNT {
        let fix_off = MC_CALL_FIX_OFF[i as usize]
        let fn_idx = MC_CALL_FIX_TARGET[i as usize]
        let target = MC_FN_OFF[fn_idx as usize]
        let disp = target - (fix_off + 4)
        WIDE_OUT[fix_off as usize] = (disp & 0xFF) as i8
        WIDE_OUT[(fix_off + 1) as usize] = ((disp >> 8) & 0xFF) as i8
        WIDE_OUT[(fix_off + 2) as usize] = ((disp >> 16) & 0xFF) as i8
        WIDE_OUT[(fix_off + 3) as usize] = ((disp >> 24) & 0xFF) as i8
        i = i + 1
    }
}

// --- Main entry point ---
// Minimal PE writer for mini_compile output
// Produces a Windows x86_64 console executable with inline code
fn mc_write_pe(output_path: string, code_len: i64, entry_off: i64) with IO, Mut, Panic, Div {
    // PE layout: DOS header (64) + PE sig (4) + COFF header (20) + Optional header (112+128=240)
    //          + Section headers (40 each, 1 section)
    // Total headers ≈ 368, aligned to 512
    let headers_size: i64 = 512      // file-aligned
    let section_align: i64 = 4096
    let file_align: i64 = 512
    let image_base: i64 = 0x400000
    let text_rva: i64 = 4096
    // Round code to file alignment
    let text_raw_size = ((code_len + file_align - 1) / file_align) * file_align
    let text_virt_size = code_len
    let image_size = text_rva + ((text_virt_size + section_align - 1) / section_align) * section_align

    var pe_pos: i64 = 0
    // DOS stub (64 bytes)
    GLOBAL_ELF[0 as usize] = 0x4D as i8  // M
    GLOBAL_ELF[1 as usize] = 0x5A as i8  // Z
    // e_lfanew at offset 60: pointer to PE signature
    GLOBAL_ELF[60 as usize] = 64 as i8
    pe_pos = 64

    // PE signature: "PE\0\0"
    GLOBAL_ELF[64 as usize] = 80 as i8    // P
    GLOBAL_ELF[65 as usize] = 69 as i8    // E
    pe_pos = 68

    // COFF header (20 bytes)
    mc_pe_write_u16(68, 0x8664)            // Machine: AMD64
    mc_pe_write_u16(70, 1)                 // NumberOfSections: 1
    mc_pe_write_u32(76, 0)                 // SizeOfOptionalHeader will be set
    mc_pe_write_u16(76, 240)               // SizeOfOptionalHeader
    mc_pe_write_u16(78, 0x22)              // Characteristics: EXECUTABLE_IMAGE | LARGE_ADDRESS_AWARE

    // Optional header (PE32+)
    let opt_start: i64 = 88
    mc_pe_write_u16(opt_start, 0x020B)     // PE32+ magic
    GLOBAL_ELF[(opt_start + 16) as usize] = ((text_rva + entry_off) & 0xFF) as i8
    GLOBAL_ELF[(opt_start + 17) as usize] = (((text_rva + entry_off) >> 8) & 0xFF) as i8
    GLOBAL_ELF[(opt_start + 18) as usize] = (((text_rva + entry_off) >> 16) & 0xFF) as i8
    GLOBAL_ELF[(opt_start + 19) as usize] = (((text_rva + entry_off) >> 24) & 0xFF) as i8
    // ImageBase
    mc_pe_write_u64(opt_start + 24, image_base)
    // SectionAlignment, FileAlignment
    mc_pe_write_u32(opt_start + 32, section_align)
    mc_pe_write_u32(opt_start + 36, file_align)
    // OS version 6.0, subsystem version 6.0
    mc_pe_write_u16(opt_start + 40, 6)
    mc_pe_write_u16(opt_start + 44, 6)
    // SizeOfImage
    mc_pe_write_u32(opt_start + 56, image_size)
    // SizeOfHeaders
    mc_pe_write_u32(opt_start + 60, headers_size)
    // Subsystem: 3 = WINDOWS_CUI (console)
    mc_pe_write_u16(opt_start + 68, 3)
    // DllCharacteristics: NX_COMPAT | DYNAMIC_BASE | TERMINAL_SERVER_AWARE
    mc_pe_write_u16(opt_start + 70, 0x8160)
    // Stack/Heap sizes
    mc_pe_write_u64(opt_start + 72, 1048576)    // SizeOfStackReserve
    mc_pe_write_u64(opt_start + 80, 4096)       // SizeOfStackCommit
    mc_pe_write_u64(opt_start + 88, 1048576)    // SizeOfHeapReserve
    mc_pe_write_u64(opt_start + 96, 4096)       // SizeOfHeapCommit
    // NumberOfRvaAndSizes = 16
    mc_pe_write_u32(opt_start + 108, 16)

    // Section header: .text
    let sec_start: i64 = opt_start + 240      // after data directories (16 × 8 = 128)
    GLOBAL_ELF[sec_start as usize] = 46 as i8      // .
    GLOBAL_ELF[(sec_start + 1) as usize] = 116 as i8 // t
    GLOBAL_ELF[(sec_start + 2) as usize] = 101 as i8 // e
    GLOBAL_ELF[(sec_start + 3) as usize] = 120 as i8 // x
    GLOBAL_ELF[(sec_start + 4) as usize] = 116 as i8 // t
    mc_pe_write_u32(sec_start + 8, text_virt_size)
    mc_pe_write_u32(sec_start + 12, text_rva)
    mc_pe_write_u32(sec_start + 16, text_raw_size)
    mc_pe_write_u32(sec_start + 20, headers_size)   // PointerToRawData
    mc_pe_write_u32(sec_start + 36, 0x60000020)     // CNT_CODE | MEM_EXECUTE | MEM_READ

    // Copy code to file offset = headers_size
    var ci: i64 = 0
    while ci < code_len {
        GLOBAL_ELF[(headers_size + ci) as usize] = WIDE_OUT[ci as usize]
        ci = ci + 1
    }

    let total_len = headers_size + text_raw_size
    write_file(output_path, GLOBAL_ELF, total_len)
    print("mini_compile: PE written, size=")
    print_int(total_len)
    print("\n")
}

fn mc_pe_write_u16(off: i64, val: i64) with Mut, Panic {
    GLOBAL_ELF[off as usize] = (val & 0xFF) as i8
    GLOBAL_ELF[(off + 1) as usize] = ((val >> 8) & 0xFF) as i8
}

fn mc_pe_write_u32(off: i64, val: i64) with Mut, Panic {
    GLOBAL_ELF[off as usize] = (val & 0xFF) as i8
    GLOBAL_ELF[(off + 1) as usize] = ((val >> 8) & 0xFF) as i8
    GLOBAL_ELF[(off + 2) as usize] = ((val >> 16) & 0xFF) as i8
    GLOBAL_ELF[(off + 3) as usize] = ((val >> 24) & 0xFF) as i8
}

fn mc_pe_write_u64(off: i64, val: i64) with Mut, Panic {
    var i: i64 = 0
    while i < 8 { GLOBAL_ELF[(off + i) as usize] = ((val >> (i * 8)) & 0xFF) as i8; i = i + 1 }
}

fn mini_compile(output_path: string) -> i64 with IO, Mut, Panic, Div, Alloc {
    print("mini_compile: start\n")
    WIDE_LEN = 0
    MC_CALL_FIX_COUNT = 0
    MC_BREAK_FIX_COUNT = 0
    MC_LOOP_DEPTH = 0
    // Ensure LTP_N is set for ltp_byte() (used by string comparison helpers)
    LTP_N = LEAN_SOURCE_LEN

    // Lex source into MP_* token arrays
    // NOTE: lean_lex_to_parser() populates MP_* arrays and sets LTP_TC.
    // Under boot4, call it from main() before mini_compile — boot4 codegen
    // for large functions (mini_compile is fn 207, ~2000 lines) has stack frame
    // issues that crash on the while loop. Lexing from a separate, smaller
    // function avoids this.
    MC_TC = LTP_TC
    print("mini_compile: tokens=")
    print_int(MC_TC)
    print("\n")

    // Emit print_int helper at start of code section
    print("mc:pi\n")
    mc_emit_print_int_helper()
    print("mc:ss\n")

    // f64 helper skipped — hello.sio is integer-only; boot4 crashes on
    // we32() semicolon-separated calls and complex local-var array patches
    // in mc_emit_print_f64_helper. Emit lazily when f64 support is needed.
    // mc_emit_print_f64_helper()

    // Pass 0a: scan struct declarations
    print("mc:0a\n")
    mc_scan_structs()
    print("mc:0b\n")

    // Pass 0b: scan enum declarations
    mc_scan_enums()
    print("mc:1\n")

    // Pass 1: scan all function declarations
    mc_scan_functions()
    print("mc:2\n")
    print_int(MC_FN_COUNT)
    print(" main=")
    print_int(MC_MAIN_FN)
    print("\n")

    if MC_MAIN_FN < 0 {
        print("mini_compile: no main function found\n")
        return 2
    }

    // Pass 2: compile each function body
    mc_compile_functions()

    // Patch all call fixups
    mc_patch_calls()

    // Emit trampoline: save argc/argv, call main, exit
    let tramp_off = WIDE_LEN
    let main_off = MC_FN_OFF[MC_MAIN_FN as usize]
    // At ELF entry: [rsp]=argc, [rsp+8..]=argv[]
    // Save argc to BSS (MC_BSS_BASE - 16) and argv_base to BSS (MC_BSS_BASE - 8)
    let argc_addr = MC_BSS_BASE() + GLOBAL_TOTAL_SIZE
    let argv_addr = MC_BSS_BASE() + GLOBAL_TOTAL_SIZE + 8
    // mov rax, [rsp] (argc)
    we(0x48); we(0x8B); we(0x04); we(0x24)
    // movabs [argc_addr], rax
    we(0x48); we(0xA3)
    var ak: i64 = 0
    while ak < 8 { we((argc_addr >> (ak * 8)) & 0xFF); ak = ak + 1 }
    // lea rax, [rsp+8] (argv base)
    we(0x48); we(0x8D); we(0x44); we(0x24); we(0x08)
    // movabs [argv_addr], rax
    we(0x48); we(0xA3)
    ak = 0
    while ak < 8 { we((argv_addr >> (ak * 8)) & 0xFF); ak = ak + 1 }
    // call main
    we(0xe8)
    let call_rel = main_off - (WIDE_LEN + 4)
    we32(call_rel)
    we(0x89); we(0xc7)       // mov edi, eax
    we(0xb8); we32(60)       // mov eax, 60 (exit)
    we(0x0f); we(0x05)       // syscall

    let total_code = WIDE_LEN
    print("mini_compile: code=")
    print_int(total_code)
    print(" tramp=")
    print_int(tramp_off)
    print("\n")

    // Build ELF
    let base_addr: i64 = 4194304   // 0x400000
    let text_off: i64 = 4096       // 0x1000
    let entry_va = base_addr + text_off + tramp_off

    var ei: i64 = 0
    while ei < text_off + total_code + 16 { GLOBAL_ELF[ei as usize] = 0; ei = ei + 1 }

    // ELF header
    elf_write_byte(0, 0x7f)
    elf_write_byte(1, 69)
    elf_write_byte(2, 76)
    elf_write_byte(3, 70)
    elf_write_byte(4, 2)
    elf_write_byte(5, 1)
    elf_write_byte(6, 1)
    elf_write_u16(16, 2)
    elf_write_u16(18, 0x3e)
    elf_write_u32(20, 1)
    elf_write_u64(24, entry_va)
    elf_write_u64(32, 64)
    elf_write_u16(52, 64)
    elf_write_u16(54, 56)
    elf_write_u16(56, 2)       // e_phnum = 2 (text + BSS)
    elf_write_u16(58, 64)
    // phdr 0: PT_LOAD for text (RWX)
    elf_write_u32(64, 1)       // p_type = PT_LOAD
    elf_write_u32(68, 7)       // p_flags = RWX
    elf_write_u64(72, 0)       // p_offset
    elf_write_u64(80, base_addr)
    elf_write_u64(88, base_addr)
    let fsz = text_off + total_code
    elf_write_u64(96, fsz)
    elf_write_u64(104, fsz)
    elf_write_u64(112, 4096)
    // phdr 1: PT_LOAD for BSS (RW, zero-initialized by kernel)
    let bss_base: i64 = 0x700000
    let bss_size = GLOBAL_TOTAL_SIZE + 4096
    elf_write_u32(120, 1)      // p_type = PT_LOAD
    elf_write_u32(124, 6)      // p_flags = RW
    elf_write_u64(128, 0)      // p_offset = 0 (BSS has p_filesz=0, offset irrelevant)
    elf_write_u64(136, bss_base)
    elf_write_u64(144, bss_base)
    elf_write_u64(152, 0)      // p_filesz = 0 (BSS)
    elf_write_u64(160, bss_size)
    elf_write_u64(168, 4096)   // p_align

    // Copy code to text section
    var ci: i64 = 0
    while ci < total_code {
        GLOBAL_ELF[(text_off + ci) as usize] = WIDE_OUT[ci as usize]
        ci = ci + 1
    }

    let total_len = text_off + total_code

    // Detect output format from filename extension
    let out_len = str_len(output_path)
    var is_pe: i64 = 0
    if out_len >= 4 {
        if str_char_at(output_path, out_len - 4) == 46 {
            let e1 = str_char_at(output_path, out_len - 3)
            let e2 = str_char_at(output_path, out_len - 2)
            let e3 = str_char_at(output_path, out_len - 1)
            if (e1 == 101 || e1 == 69) && (e2 == 120 || e2 == 88) && (e3 == 101 || e3 == 69) {
                is_pe = 1
            }
        }
    }

    if is_pe == 1 {
        // Minimal PE output
        mc_write_pe(output_path, total_code, tramp_off)
    } else {
        let write_ok = write_file(output_path, GLOBAL_ELF, total_len)
    }

    print("mini_compile: ok written=")
    print(output_path)
    print(" size=")
    print_int(total_len)
    print("\n")
    0
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    if argc < 2 {
        print("Usage: render_native_compile_driver_lean.sio <source.sio> <output>\n")
        return 1
    }
    let source_path = get_arg(0)
    let output_path = get_arg(1)

    print("render_compile: source=")
    print(source_path)
    print(" output=")
    print(output_path)
    print("\n")

    // Scan source for global variable declarations before parsing
    scan_source_globals(source_path)
    // LEAN_SOURCE + LEAN_SOURCE_LEN already populated by scan_source_globals
    print("render_compile: globals=")
    print_int(GLOBAL_COUNT)
    print(" total_bytes=")
    print_int(GLOBAL_TOTAL_SIZE)
    print("\n")
    if GLOBAL_COUNT <= 0 {  // skip display — str_from_bytes crashes under boot4
        var gpi: i64 = 0
        while gpi < GLOBAL_COUNT {
            let gn_base = gpi * 128
            let gn_len = GLOBAL_NAME_LEN[gpi as usize]
            var gni: i64 = 0
            while gni < 128 { GN_DISPLAY_TMP[gni as usize] = 0; gni = gni + 1 }
            gni = 0
            while gni < gn_len && gni < 128 { GN_DISPLAY_TMP[gni as usize] = GLOBAL_NAME_BUF[(gn_base + gni) as usize]; gni = gni + 1 }
            let gns = str_from_bytes(GN_DISPLAY_TMP, gn_len)
            print("  global: ")
            print(gns)
            print(" off=")
            print_int(GLOBAL_OFFSETS[gpi as usize])
            print(" sz=")
            print_int(GLOBAL_SIZES[gpi as usize])
            print(" elem=")
            print_int(GLOBAL_ELEM_SIZES[gpi as usize])
            print("\n")
            gpi = gpi + 1
        }
    }

    // Lex source into MP_* token arrays
    lean_lex_to_parser()

    // Compile from token arrays
    return mini_compile(output_path)
}

