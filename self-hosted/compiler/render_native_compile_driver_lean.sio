// Was: Phase 0 (struct registry), Phase 1 (fn registry), Phase 2 (codegen),
// Phase 3 (relocation), Phase 4 (ELF emission). All bypassed by mini_compile.

fn _dead_code_removed() -> i64 { 0 }
