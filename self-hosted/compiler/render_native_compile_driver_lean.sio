// self-hosted::compiler::render_native_compile_driver_lean
//
// Ultra-lean native compile driver with micro-emitter.
// AST-direct compilation — bypasses IR lowering and NativeCompiler entirely.
// Uses ONLY CodeBuffer by-value returns (65KB, proven JIT-safe).
//
// Pipeline: parse → AST-direct x86-64 emit → inline ELF → write
//
// Usage:
//   souc run self-hosted/compiler/render_native_compile_driver_lean.sio -- <source> <output>

use lexer::mod::*
use parser::ast::*
use ir::ir::*
use native::encode::*
use io::file_write::*
use interop::contract::*
use parser::mod::{parse_program_preloaded, count_items}
use parser::parser::{parser_last_error_count}
// Helpers required by codegen dependency chain (flat-namespace resolution).
fn char_from_i64(n: i64) -> string with Mut, Panic {
    if n == 0 { "0" }
    else if n == 1 { "1" }
    else if n == 2 { "2" }
    else if n == 3 { "3" }
    else if n == 4 { "4" }
    else if n == 5 { "5" }
    else if n == 6 { "6" }
    else if n == 7 { "7" }
    else if n == 8 { "8" }
    else if n == 9 { "9" }
    else { "?" }
}

fn pow10_idx(idx: i64) -> i64 {
    if idx == 0 { 1000000000000000000 }
    else if idx == 1 { 100000000000000000 }
    else if idx == 2 { 10000000000000000 }
    else if idx == 3 { 1000000000000000 }
    else if idx == 4 { 100000000000000 }
    else if idx == 5 { 10000000000000 }
    else if idx == 6 { 1000000000000 }
    else if idx == 7 { 100000000000 }
    else if idx == 8 { 10000000000 }
    else if idx == 9 { 1000000000 }
    else if idx == 10 { 100000000 }
    else if idx == 11 { 10000000 }
    else if idx == 12 { 1000000 }
    else if idx == 13 { 100000 }
    else if idx == 14 { 10000 }
    else if idx == 15 { 1000 }
    else if idx == 16 { 100 }
    else if idx == 17 { 10 }
    else { 1 }
}

fn digit_for_power(rem: i64, power: i64) -> i64 {
    if rem <= (0 - (9 * power)) { 9 }
    else if rem <= (0 - (8 * power)) { 8 }
    else if rem <= (0 - (7 * power)) { 7 }
    else if rem <= (0 - (6 * power)) { 6 }
    else if rem <= (0 - (5 * power)) { 5 }
    else if rem <= (0 - (4 * power)) { 4 }
    else if rem <= (0 - (3 * power)) { 3 }
    else if rem <= (0 - (2 * power)) { 2 }
    else if rem <= (0 - power) { 1 }
    else { 0 }
}

fn i64_to_digits_no_div(rem: i64, idx: i64, started: bool) -> string with Mut, Panic {
    if idx >= 19 { return "" }
    let power = pow10_idx(idx)
    let digit = digit_for_power(rem, power)
    let rem_next = rem + (digit * power)
    let emit = started || digit > 0 || idx == 18
    let head = if emit { char_from_i64(digit) } else { "" }
    head + i64_to_digits_no_div(rem_next, idx + 1, emit)
}

fn int_to_string(n: i64) -> string with Mut, Panic, Div {
    if n == 0 { return "0" }
    let negative = n < 0
    let rem = if negative { n } else { 0 - n }
    let digits = i64_to_digits_no_div(rem, 0, false)
    if negative { "-" + digits } else { digits }
}

fn parse_i64_decimal(raw: string) -> (bool, i64) with Mut, Div {
    if str_len(raw) == 0 { return (false, 0) }
    var idx: i64 = 0
    var negative = false
    if str_char_at(raw, 0) == "-" {
        negative = true
        idx = 1
        if idx >= str_len(raw) { return (false, 0) }
    }
    var value: i64 = 0
    while idx < str_len(raw) {
        let ch = str_char_at(raw, idx)
        if ch < "0" || ch > "9" { return (false, 0) }
        value = value * 10 + ((ch as i64) - ("0" as i64))
        idx = idx + 1
    }
    if negative { (true, 0 - value) } else { (true, value) }
}

fn load_source_file(path: string) -> Program with IO, Mut, Div, Panic, Alloc {
    let data = read_file(path)
    let size = file_size(path)
    var buf: [i8; 1048576] = [0; 1048576]
    var i: i64 = 0
    while i < size && i < 1048576 {
        buf[i as usize] = data[i as usize]
        i = i + 1
    }
    let state = lex(buf, size, 0)
    parse_program_preloaded(state.token_count)
}

// ============================================================================
// Micro-emitter: IR → x86-64 using ONLY CodeBuffer (65KB by-value, JIT-safe)
// Stack-slot model: vreg N → [rbp - 8*(N+1)]
// ============================================================================

fn micro_store_rax(code: CodeBuffer, vreg: i64) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    let disp = 0 - ((vreg + 1) * 8)
    c = emit_byte(c, 0x48)
    c = emit_byte(c, 0x89)
    c = emit_byte(c, 0x85)
    c = emit_byte(c, disp & 0xFF)
    c = emit_byte(c, (disp >> 8) & 0xFF)
    c = emit_byte(c, (disp >> 16) & 0xFF)
    c = emit_byte(c, (disp >> 24) & 0xFF)
    c
}

fn micro_load_rax(code: CodeBuffer, vreg: i64) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    let disp = 0 - ((vreg + 1) * 8)
    c = emit_byte(c, 0x48)
    c = emit_byte(c, 0x8b)
    c = emit_byte(c, 0x85)
    c = emit_byte(c, disp & 0xFF)
    c = emit_byte(c, (disp >> 8) & 0xFF)
    c = emit_byte(c, (disp >> 16) & 0xFF)
    c = emit_byte(c, (disp >> 24) & 0xFF)
    c
}

fn micro_load_rcx(code: CodeBuffer, vreg: i64) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    let disp = 0 - ((vreg + 1) * 8)
    c = emit_byte(c, 0x48)
    c = emit_byte(c, 0x8b)
    c = emit_byte(c, 0x8d)
    c = emit_byte(c, disp & 0xFF)
    c = emit_byte(c, (disp >> 8) & 0xFF)
    c = emit_byte(c, (disp >> 16) & 0xFF)
    c = emit_byte(c, (disp >> 24) & 0xFF)
    c
}

fn micro_compile_function(code: CodeBuffer, func: IrFunction, fn_offsets: [i64; 256]) -> CodeBuffer with Mut, Panic, Div {
    let frame_raw = (func.reg_count + 2) * 8
    let frame_size = ((frame_raw + 15) / 16) * 16

    // Prologue
    var c = code
    c = emit_byte(c, 0x55)
    c = emit_byte(c, 0x48)
    c = emit_byte(c, 0x89)
    c = emit_byte(c, 0xe5)
    if frame_size > 0 {
        c = emit_byte(c, 0x48)
        c = emit_byte(c, 0x81)
        c = emit_byte(c, 0xec)
        c = emit_byte(c, frame_size & 0xFF)
        c = emit_byte(c, (frame_size >> 8) & 0xFF)
        c = emit_byte(c, (frame_size >> 16) & 0xFF)
        c = emit_byte(c, (frame_size >> 24) & 0xFF)
    }

    // Spill params (rdi→p0, rsi→p1, rdx→p2, rcx→p3)
    var pi: i64 = 0
    while pi < func.param_count && pi < 4 {
        let vreg = func.param_regs[pi as usize]
        if vreg >= 0 {
            if pi == 0 {
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x89)
                c = emit_byte(c, 0xf8)
            } else if pi == 1 {
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x89)
                c = emit_byte(c, 0xf0)
            } else if pi == 2 {
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x89)
                c = emit_byte(c, 0xd0)
            } else if pi == 3 {
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x89)
                c = emit_byte(c, 0xc8)
            }
            c = micro_store_rax(c, vreg)
        }
        pi = pi + 1
    }

    // Label offsets and patch lists
    var labels: [i64; 256] = [-1; 256]
    var ret_sites: [i64; 64] = [0; 64]
    var ret_count: i64 = 0
    var fwd_sites: [i64; 128] = [0; 128]
    var fwd_count: i64 = 0

    // Emit instructions
    var ip: i64 = 0
    while ip < func.instr_count {
        let instr = func.instrs[ip as usize]

        if instr.op == IrOpcode::IrLoadImm || instr.op == IrOpcode::IrLoadBool {
            // Inline mov rax, imm64 — avoid nested CodeBuffer returns
            c = emit_byte(c, 0x48)
            c = emit_byte(c, 0xb8)
            c = emit_byte(c, instr.imm_i64 & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 8) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 16) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 24) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 32) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 40) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 48) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 56) & 0xFF)
            if instr.dst >= 0 { c = micro_store_rax(c, instr.dst) }

        } else if instr.op == IrOpcode::IrReturn {
            if instr.src1 >= 0 { c = micro_load_rax(c, instr.src1) }
            let site = c.len
            c = emit_byte(c, 0xe9)
            c = emit_byte(c, 0)
            c = emit_byte(c, 0)
            c = emit_byte(c, 0)
            c = emit_byte(c, 0)
            if ret_count < 64 { ret_sites[ret_count as usize] = site }
            ret_count = ret_count + 1

        } else if instr.op == IrOpcode::IrBinOp {
            c = micro_load_rax(c, instr.src1)
            c = micro_load_rcx(c, instr.src2)
            if instr.bin_op == BinaryOp::OpAdd {
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x01)
                c = emit_byte(c, 0xc8)
            } else if instr.bin_op == BinaryOp::OpSub {
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x29)
                c = emit_byte(c, 0xc8)
            } else if instr.bin_op == BinaryOp::OpMul {
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x0f)
                c = emit_byte(c, 0xaf)
                c = emit_byte(c, 0xc1)
            } else if instr.bin_op == BinaryOp::OpDiv {
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x99)
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0xf7)
                c = emit_byte(c, 0xf9)
            } else if instr.bin_op == BinaryOp::OpRem {
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x99)
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0xf7)
                c = emit_byte(c, 0xf9)
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x89)
                c = emit_byte(c, 0xd0)
            } else if instr.bin_op == BinaryOp::OpLt {
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x39)
                c = emit_byte(c, 0xc8)
                c = emit_byte(c, 0x0f)
                c = emit_byte(c, 0x9c)
                c = emit_byte(c, 0xc0)
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x0f)
                c = emit_byte(c, 0xb6)
                c = emit_byte(c, 0xc0)
            } else if instr.bin_op == BinaryOp::OpLe {
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x39)
                c = emit_byte(c, 0xc8)
                c = emit_byte(c, 0x0f)
                c = emit_byte(c, 0x9e)
                c = emit_byte(c, 0xc0)
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x0f)
                c = emit_byte(c, 0xb6)
                c = emit_byte(c, 0xc0)
            } else if instr.bin_op == BinaryOp::OpGt {
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x39)
                c = emit_byte(c, 0xc8)
                c = emit_byte(c, 0x0f)
                c = emit_byte(c, 0x9f)
                c = emit_byte(c, 0xc0)
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x0f)
                c = emit_byte(c, 0xb6)
                c = emit_byte(c, 0xc0)
            } else if instr.bin_op == BinaryOp::OpGe {
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x39)
                c = emit_byte(c, 0xc8)
                c = emit_byte(c, 0x0f)
                c = emit_byte(c, 0x9d)
                c = emit_byte(c, 0xc0)
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x0f)
                c = emit_byte(c, 0xb6)
                c = emit_byte(c, 0xc0)
            } else if instr.bin_op == BinaryOp::OpEq {
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x39)
                c = emit_byte(c, 0xc8)
                c = emit_byte(c, 0x0f)
                c = emit_byte(c, 0x94)
                c = emit_byte(c, 0xc0)
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x0f)
                c = emit_byte(c, 0xb6)
                c = emit_byte(c, 0xc0)
            } else if instr.bin_op == BinaryOp::OpNe {
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x39)
                c = emit_byte(c, 0xc8)
                c = emit_byte(c, 0x0f)
                c = emit_byte(c, 0x95)
                c = emit_byte(c, 0xc0)
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x0f)
                c = emit_byte(c, 0xb6)
                c = emit_byte(c, 0xc0)
            }
            if instr.dst >= 0 { c = micro_store_rax(c, instr.dst) }

        } else if instr.op == IrOpcode::IrCall {
            // Push caller-saved regs if needed, load args, call, store result
            if instr.arg_count >= 1 && instr.src1 >= 0 {
                c = micro_load_rax(c, instr.src1)
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x89)
                c = emit_byte(c, 0xc7)
            }
            if instr.arg_count >= 2 && instr.src2 >= 0 {
                c = micro_load_rax(c, instr.src2)
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x89)
                c = emit_byte(c, 0xc6)
            }
            let cs = c.len
            let tgt = fn_offsets[instr.fn_id as usize]
            let disp = tgt - (cs + 5)
            c = emit_byte(c, 0xe8)
            c = emit_byte(c, disp & 0xFF)
            c = emit_byte(c, (disp >> 8) & 0xFF)
            c = emit_byte(c, (disp >> 16) & 0xFF)
            c = emit_byte(c, (disp >> 24) & 0xFF)
            if instr.dst >= 0 { c = micro_store_rax(c, instr.dst) }

        } else if instr.op == IrOpcode::IrCopy {
            c = micro_load_rax(c, instr.src1)
            if instr.dst >= 0 { c = micro_store_rax(c, instr.dst) }

        } else if instr.op == IrOpcode::IrLabel {
            labels[instr.label_id as usize] = c.len

        } else if instr.op == IrOpcode::IrJump {
            let tgt = labels[instr.label_id as usize]
            let site = c.len
            c = emit_byte(c, 0xe9)
            if tgt >= 0 {
                let d = tgt - (site + 5)
                c = emit_byte(c, d & 0xFF)
                c = emit_byte(c, (d >> 8) & 0xFF)
                c = emit_byte(c, (d >> 16) & 0xFF)
                c = emit_byte(c, (d >> 24) & 0xFF)
            } else {
                c = emit_byte(c, 0)
                c = emit_byte(c, 0)
                c = emit_byte(c, 0)
                c = emit_byte(c, 0)
                if fwd_count < 128 {
                    fwd_sites[fwd_count as usize] = (site + 1) + (instr.label_id * 65536)
                    fwd_count = fwd_count + 1
                }
            }

        } else if instr.op == IrOpcode::IrBranchTrue {
            c = micro_load_rax(c, instr.src1)
            c = emit_byte(c, 0x48)
            c = emit_byte(c, 0x85)
            c = emit_byte(c, 0xc0)
            let tgt = labels[instr.label_id as usize]
            let site = c.len
            c = emit_byte(c, 0x0f)
            c = emit_byte(c, 0x85)
            if tgt >= 0 {
                let d = tgt - (site + 6)
                c = emit_byte(c, d & 0xFF)
                c = emit_byte(c, (d >> 8) & 0xFF)
                c = emit_byte(c, (d >> 16) & 0xFF)
                c = emit_byte(c, (d >> 24) & 0xFF)
            } else {
                c = emit_byte(c, 0)
                c = emit_byte(c, 0)
                c = emit_byte(c, 0)
                c = emit_byte(c, 0)
                if fwd_count < 128 {
                    fwd_sites[fwd_count as usize] = (site + 2) + (instr.label_id * 65536)
                    fwd_count = fwd_count + 1
                }
            }

        } else if instr.op == IrOpcode::IrBranchFalse {
            c = micro_load_rax(c, instr.src1)
            c = emit_byte(c, 0x48)
            c = emit_byte(c, 0x85)
            c = emit_byte(c, 0xc0)
            let tgt = labels[instr.label_id as usize]
            let site = c.len
            c = emit_byte(c, 0x0f)
            c = emit_byte(c, 0x84)
            if tgt >= 0 {
                let d = tgt - (site + 6)
                c = emit_byte(c, d & 0xFF)
                c = emit_byte(c, (d >> 8) & 0xFF)
                c = emit_byte(c, (d >> 16) & 0xFF)
                c = emit_byte(c, (d >> 24) & 0xFF)
            } else {
                c = emit_byte(c, 0)
                c = emit_byte(c, 0)
                c = emit_byte(c, 0)
                c = emit_byte(c, 0)
                if fwd_count < 128 {
                    fwd_sites[fwd_count as usize] = (site + 2) + (instr.label_id * 65536)
                    fwd_count = fwd_count + 1
                }
            }

        } else if instr.op == IrOpcode::IrNop {
            // skip
        } else if instr.op == IrOpcode::IrLoadString {
            c = emit_byte(c, 0x48)
            c = emit_byte(c, 0xb8)
            c = emit_byte(c, instr.imm_i64 & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 8) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 16) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 24) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 32) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 40) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 48) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 56) & 0xFF)
            if instr.dst >= 0 { c = micro_store_rax(c, instr.dst) }
        } else {
            print("  UNSUPPORTED op=")
            print_int(instr.op as i64)
            print("\n")
        }
        ip = ip + 1
    }

    // Epilogue
    let epilogue_off = c.len
    c = emit_byte(c, 0xc9)
    c = emit_byte(c, 0xc3)

    // Patch return jumps
    var ri: i64 = 0
    while ri < ret_count && ri < 64 {
        let s = ret_sites[ri as usize]
        let d = epilogue_off - (s + 5)
        c.bytes[(s + 1) as usize] = (d & 0xFF) as i8
        c.bytes[(s + 2) as usize] = ((d >> 8) & 0xFF) as i8
        c.bytes[(s + 3) as usize] = ((d >> 16) & 0xFF) as i8
        c.bytes[(s + 4) as usize] = ((d >> 24) & 0xFF) as i8
        ri = ri + 1
    }

    // Patch forward branches
    var fi: i64 = 0
    while fi < fwd_count {
        let enc = fwd_sites[fi as usize]
        let s = enc % 65536
        let lid = enc / 65536
        let tgt = labels[lid as usize]
        if tgt >= 0 {
            let d = tgt - (s + 4)
            c.bytes[(s + 0) as usize] = (d & 0xFF) as i8
            c.bytes[(s + 1) as usize] = ((d >> 8) & 0xFF) as i8
            c.bytes[(s + 2) as usize] = ((d >> 16) & 0xFF) as i8
            c.bytes[(s + 3) as usize] = ((d >> 24) & 0xFF) as i8
        }
        fi = fi + 1
    }

    c
}
// ============================================================================
// Struct helpers: field key, prefix check, struct def lookup
// ============================================================================

// Returns true if key == var_name + "_" + something
fn name_has_prefix_of(key: Name, var_name: Name) -> bool {
    if key.len <= var_name.len { return false }
    if key.buf[var_name.len as usize] != (95 as i8) { return false }  // '_'
    var i: i64 = 0
    while i < var_name.len {
        if key.buf[i as usize] != var_name.buf[i as usize] { return false }
        i = i + 1
    }
    true
}

// Compare Name against the first segment of an AstPath
fn name_matches_path(name: Name, path: AstPath) -> bool {
    if name.len != path.segments.head_len { return false }
    var i: i64 = 0
    while i < name.len {
        if name.buf[i as usize] != path.segments.head_buf[i as usize] { return false }
        i = i + 1
    }
    true
}

// Count fields in a named struct from the program's item list
fn struct_field_count(prog: &Program, type_name: Name) -> i64 {
    let items_ref: &Option<Box<ItemList>> = &prog.items
    var cur = items_ref
    while true {
        match *cur {
            Some(il) => {
                let itm: &Item = &(*il).head
                if itm.kind == ItemKind::ItemStruct {
                    let sdef_ref: &Option<Box<StructDef>> = &itm.struct_def
                    match *sdef_ref {
                        Some(sd) => {
                            if ir_name_eq((*sd).name, type_name) {
                                var count: i64 = 0
                                let flist_ref: &Option<Box<FieldDefList>> = &(*sd).fields
                                var fc = flist_ref
                                while true {
                                    match *fc {
                                        Some(fl) => { count = count + 1; fc = &(*fl).tail }
                                        _ => break
                                    }
                                }
                                return count
                            }
                        }
                        _ => {}
                    }
                }
                cur = &(*il).tail
            }
            _ => break
        }
    }
    0
}

// Return the name of field at index idx in a named struct
fn struct_field_name_at(prog: &Program, type_name: Name, idx: i64) -> Name {
    let items_ref: &Option<Box<ItemList>> = &prog.items
    var cur = items_ref
    while true {
        match *cur {
            Some(il) => {
                let itm: &Item = &(*il).head
                if itm.kind == ItemKind::ItemStruct {
                    let sdef_ref: &Option<Box<StructDef>> = &itm.struct_def
                    match *sdef_ref {
                        Some(sd) => {
                            if ir_name_eq((*sd).name, type_name) {
                                var i: i64 = 0
                                let flist_ref: &Option<Box<FieldDefList>> = &(*sd).fields
                                var fc = flist_ref
                                while true {
                                    match *fc {
                                        Some(fl) => {
                                            if i == idx { return (*fl).head.name }
                                            i = i + 1
                                            fc = &(*fl).tail
                                        }
                                        _ => break
                                    }
                                }
                                return ir_empty_name()
                            }
                        }
                        _ => {}
                    }
                }
                cur = &(*il).tail
            }
            _ => break
        }
    }
    ir_empty_name()
}

// ============================================================================
// Struct field key: var_name + "_" + field_name
// ============================================================================
fn make_field_key(var_name: Name, field_name: Name) -> Name {
    var result: Name = ir_empty_name()
    var i: i64 = 0
    while i < var_name.len {
        result.buf[i as usize] = var_name.buf[i as usize]
        i = i + 1
    }
    result.buf[i as usize] = 95 as i8  // '_'
    i = i + 1
    var j: i64 = 0
    while j < field_name.len {
        result.buf[(i + j) as usize] = field_name.buf[j as usize]
        j = j + 1
    }
    result.len = var_name.len + 1 + field_name.len
    result
}

// Returns the named type of a function's return type (empty name if scalar/void)
fn fn_return_type_name(prog: &Program, fn_name: Name) -> Name {
    let items_ref: &Option<Box<ItemList>> = &prog.items
    var item_cur = items_ref
    while true {
        match *item_cur {
            Some(il) => {
                let itm: &Item = &(*il).head
                if itm.kind == ItemKind::ItemFn && ir_name_eq(itm.name, fn_name) {
                    let fdef_ref: &Option<Box<FnDef>> = &itm.fn_def
                    match *fdef_ref {
                        Some(fd) => {
                            let ret_ref: &Option<Box<TypeExpr>> = &(*fd).return_type
                            match *ret_ref {
                                Some(te) => {
                                    if (*te).kind == TypeExprKind::TypeNamed {
                                        var type_name: Name = ir_empty_name()
                                        type_name.len = (*te).path.segments.head_len
                                        var tni: i64 = 0
                                        while tni < type_name.len {
                                            type_name.buf[tni as usize] = (*te).path.segments.head_buf[tni as usize]
                                            tni = tni + 1
                                        }
                                        return type_name
                                    }
                                }
                                _ => {}
                            }
                        }
                        _ => {}
                    }
                }
                item_cur = &(*il).tail
            }
            _ => break
        }
    }
    ir_empty_name()
}

// ============================================================================
// Builtin name constructors
// ============================================================================
fn make_name_print_int() -> Name {
    var n = ir_empty_name()
    // "print_int" = 9 chars
    n.buf[0 as usize] = 112 as i8  // p
    n.buf[1 as usize] = 114 as i8  // r
    n.buf[2 as usize] = 105 as i8  // i
    n.buf[3 as usize] = 110 as i8  // n
    n.buf[4 as usize] = 116 as i8  // t
    n.buf[5 as usize] = 95 as i8   // _
    n.buf[6 as usize] = 105 as i8  // i
    n.buf[7 as usize] = 110 as i8  // n
    n.buf[8 as usize] = 116 as i8  // t
    n.len = 9
    n
}

fn make_name_print() -> Name {
    var n = ir_empty_name()
    // "print" = 5 chars
    n.buf[0 as usize] = 112 as i8  // p
    n.buf[1 as usize] = 114 as i8  // r
    n.buf[2 as usize] = 105 as i8  // i
    n.buf[3 as usize] = 110 as i8  // n
    n.buf[4 as usize] = 116 as i8  // t
    n.len = 5
    n
}

fn make_name_println() -> Name {
    var n = ir_empty_name()
    // "println" = 7 chars
    n.buf[0 as usize] = 112 as i8  // p
    n.buf[1 as usize] = 114 as i8  // r
    n.buf[2 as usize] = 105 as i8  // i
    n.buf[3 as usize] = 110 as i8  // n
    n.buf[4 as usize] = 116 as i8  // t
    n.buf[5 as usize] = 108 as i8  // l
    n.buf[6 as usize] = 110 as i8  // n
    n.len = 7
    n
}

// Emit __print_int runtime helper (130 bytes of precompiled x86-64)
fn emit_runtime_print_int(code: CodeBuffer) -> CodeBuffer with Mut, Panic {
    var c = code
    // x86-64 print_int: rdi=value, writes decimal to stdout via syscall
    c = emit_byte(c, 0x55); c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xe5)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x83); c = emit_byte(c, 0xec); c = emit_byte(c, 0x30)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xf8)
    // test rax,rax; jns positive
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0); c = emit_byte(c, 0x79); c = emit_byte(c, 0x1e)
    // neg rax; mov byte [rbp-0x30], '-'; push rax; write '-'
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xd8)
    c = emit_byte(c, 0xc6); c = emit_byte(c, 0x45); c = emit_byte(c, 0xd0); c = emit_byte(c, 0x2d)
    c = emit_byte(c, 0x50)
    c = emit_byte(c, 0xbf); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x75); c = emit_byte(c, 0xd0)
    c = emit_byte(c, 0xba); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xb8); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x05)
    c = emit_byte(c, 0x58)
    // test rax,rax; jnz convert
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0); c = emit_byte(c, 0x75); c = emit_byte(c, 0x1b)
    // zero case: write '0'
    c = emit_byte(c, 0xc6); c = emit_byte(c, 0x45); c = emit_byte(c, 0xff); c = emit_byte(c, 0x30)
    c = emit_byte(c, 0xbf); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x75); c = emit_byte(c, 0xff)
    c = emit_byte(c, 0xba); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xb8); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x05)
    c = emit_byte(c, 0xeb); c = emit_byte(c, 0x32)
    // convert loop: lea rdi,[rbp-1]; xor ecx,ecx; mov r8,10
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x7d); c = emit_byte(c, 0xff)
    c = emit_byte(c, 0x31); c = emit_byte(c, 0xc9)
    c = emit_byte(c, 0x49); c = emit_byte(c, 0xc7); c = emit_byte(c, 0xc0); c = emit_byte(c, 0x0a); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    // div r8; add dl,'0'; dec rdi; mov [rdi],dl; inc ecx; test rax,rax; jnz loop
    c = emit_byte(c, 0x31); c = emit_byte(c, 0xd2)
    c = emit_byte(c, 0x49); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xf0)
    c = emit_byte(c, 0x80); c = emit_byte(c, 0xc2); c = emit_byte(c, 0x30)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xff); c = emit_byte(c, 0xcf)
    c = emit_byte(c, 0x88); c = emit_byte(c, 0x17)
    c = emit_byte(c, 0xff); c = emit_byte(c, 0xc1)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0)
    c = emit_byte(c, 0x75); c = emit_byte(c, 0xec)
    // write(1, rdi, ecx)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xfe)
    c = emit_byte(c, 0x89); c = emit_byte(c, 0xca)
    c = emit_byte(c, 0xbf); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xb8); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x05)
    // leave; ret
    c = emit_byte(c, 0xc9); c = emit_byte(c, 0xc3)
    c
}

// Emit __print_newline runtime helper (35 bytes)
fn emit_runtime_print_newline(code: CodeBuffer) -> CodeBuffer with Mut, Panic {
    var c = code
    // push rbp; mov rbp,rsp; sub rsp,16
    c = emit_byte(c, 0x55)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xe5)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x83); c = emit_byte(c, 0xec); c = emit_byte(c, 0x10)
    // mov byte [rbp-1], 0x0a
    c = emit_byte(c, 0xc6); c = emit_byte(c, 0x45); c = emit_byte(c, 0xff); c = emit_byte(c, 0x0a)
    // mov edi,1; lea rsi,[rbp-1]; mov edx,1; mov eax,1; syscall
    c = emit_byte(c, 0xbf); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x75); c = emit_byte(c, 0xff)
    c = emit_byte(c, 0xba); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xb8); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x05)
    // leave; ret
    c = emit_byte(c, 0xc9); c = emit_byte(c, 0xc3)
    c
}
// Emit inline print(string_literal): jump over data, then sys_write
fn emit_inline_print_string(code: CodeBuffer, str_name: Name) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    let slen = str_name.len

    // jmp near (e9 + disp32) to skip over string data
    let jmp_site = c.len
    c = emit_byte(c, 0xe9)
    c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)

    // String data starts here
    let str_data_off = c.len
    var si: i64 = 0
    while si < slen {
        c = emit_byte(c, str_name.buf[si as usize] as i64)
        si = si + 1
    }

    // Patch jmp displacement
    let after_str = c.len
    let jmp_disp = after_str - (jmp_site + 5)
    c.bytes[(jmp_site + 1) as usize] = (jmp_disp & 0xFF) as i8
    c.bytes[(jmp_site + 2) as usize] = ((jmp_disp >> 8) & 0xFF) as i8
    c.bytes[(jmp_site + 3) as usize] = ((jmp_disp >> 16) & 0xFF) as i8
    c.bytes[(jmp_site + 4) as usize] = ((jmp_disp >> 24) & 0xFF) as i8

    // mov eax, 1 (sys_write)
    c = emit_byte(c, 0xb8); c = emit_byte(c, 1); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)

    // mov edi, 1 (stdout)
    c = emit_byte(c, 0xbf); c = emit_byte(c, 1); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)

    // lea rsi, [rip + disp32] — point to string data
    let lea_site = c.len
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x35)
    // disp32 = str_data_off - (lea_site + 7)
    let lea_disp = str_data_off - (lea_site + 7)
    c = emit_byte(c, lea_disp & 0xFF)
    c = emit_byte(c, (lea_disp >> 8) & 0xFF)
    c = emit_byte(c, (lea_disp >> 16) & 0xFF)
    c = emit_byte(c, (lea_disp >> 24) & 0xFF)

    // mov edx, slen (string length)
    c = emit_byte(c, 0xba)
    c = emit_byte(c, slen & 0xFF)
    c = emit_byte(c, (slen >> 8) & 0xFF)
    c = emit_byte(c, (slen >> 16) & 0xFF)
    c = emit_byte(c, (slen >> 24) & 0xFF)

    // syscall
    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x05)

    // Result in rax = number of bytes written (or error)
    c
}


// ============================================================================
// Direct AST to x86-64 compiler (bypasses IR lowering entirely)
// Uses inline arrays for locals (no Box) to avoid JIT by-value corruption.
// ============================================================================

fn ast_compile_expr(code: CodeBuffer, expr: &Expr,
    local_names: [Name; 64], local_slots: [i64; 64], local_count: i64
) -> CodeBuffer with Mut, Panic, Div, IO {
    var c = code
    if expr.kind == ExprKind::ExprIntLit {
        c = emit_byte(c, 0x48)
        c = emit_byte(c, 0xb8)
        c = emit_byte(c, expr.int_val & 0xFF)
        c = emit_byte(c, (expr.int_val >> 8) & 0xFF)
        c = emit_byte(c, (expr.int_val >> 16) & 0xFF)
        c = emit_byte(c, (expr.int_val >> 24) & 0xFF)
        c = emit_byte(c, (expr.int_val >> 32) & 0xFF)
        c = emit_byte(c, (expr.int_val >> 40) & 0xFF)
        c = emit_byte(c, (expr.int_val >> 48) & 0xFF)
        c = emit_byte(c, (expr.int_val >> 56) & 0xFF)
        c
    } else if expr.kind == ExprKind::ExprBoolTrue {
        c = emit_byte(c, 0x48); c = emit_byte(c, 0xb8)
        c = emit_byte(c, 1)
        var bi: i64 = 0
        while bi < 7 { c = emit_byte(c, 0); bi = bi + 1 }
        c
    } else if expr.kind == ExprKind::ExprBoolFalse {
        c = emit_byte(c, 0x48); c = emit_byte(c, 0xb8)
        var bi: i64 = 0
        while bi < 8 { c = emit_byte(c, 0); bi = bi + 1 }
        c
    } else if expr.kind == ExprKind::ExprIdent {
        var slot: i64 = -1
        var li = local_count - 1
        while li >= 0 {
            if ir_name_eq(local_names[li as usize], expr.name) {
                slot = local_slots[li as usize]
                li = -1
            } else {
                li = li - 1
            }
        }
        if slot >= 0 {
            c = micro_load_rax(c, slot)
        } else {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
        }
        c
    } else if expr.kind == ExprKind::ExprBinary {
        // Short-circuit operators handled before the standard eval sequence
        if expr.bin_op == BinaryOp::OpAnd {
            // && : eval left; if false, skip right; result is right's value (or 0)
            let sc_left_ref: &Option<Box<Expr>> = &expr.left
            match *sc_left_ref {
                Some(le) => { c = ast_compile_expr(c, &(*le), local_names, local_slots, local_count) }
                _ => {}
            }
            // test rax,rax; jz sc_false (e9 disp32 placeholder)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0)
            let sc_and_jz = c.len
            c = emit_byte(c, 0x0f); c = emit_byte(c, 0x84)
            c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
            let sc_right_ref: &Option<Box<Expr>> = &expr.right
            match *sc_right_ref {
                Some(re) => { c = ast_compile_expr(c, &(*re), local_names, local_slots, local_count) }
                _ => {}
            }
            let sc_and_jmp = c.len
            c = emit_byte(c, 0xe9)
            c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
            // sc_false: xor rax,rax
            let sc_and_false = c.len
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
            let sc_and_end = c.len
            // Patch jz displacement
            let jz_disp = sc_and_false - (sc_and_jz + 6)
            c.bytes[(sc_and_jz + 2) as usize] = (jz_disp & 0xFF) as i8
            c.bytes[(sc_and_jz + 3) as usize] = ((jz_disp >> 8) & 0xFF) as i8
            c.bytes[(sc_and_jz + 4) as usize] = ((jz_disp >> 16) & 0xFF) as i8
            c.bytes[(sc_and_jz + 5) as usize] = ((jz_disp >> 24) & 0xFF) as i8
            // Patch jmp displacement
            let jmp_disp = sc_and_end - (sc_and_jmp + 5)
            c.bytes[(sc_and_jmp + 1) as usize] = (jmp_disp & 0xFF) as i8
            c.bytes[(sc_and_jmp + 2) as usize] = ((jmp_disp >> 8) & 0xFF) as i8
            c.bytes[(sc_and_jmp + 3) as usize] = ((jmp_disp >> 16) & 0xFF) as i8
            c.bytes[(sc_and_jmp + 4) as usize] = ((jmp_disp >> 24) & 0xFF) as i8
            return c
        } else if expr.bin_op == BinaryOp::OpOr {
            // || : eval left; if true, result is 1; else eval right
            let sc_l_ref: &Option<Box<Expr>> = &expr.left
            match *sc_l_ref {
                Some(le) => { c = ast_compile_expr(c, &(*le), local_names, local_slots, local_count) }
                _ => {}
            }
            // test rax,rax; jnz sc_true
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0)
            let sc_or_jnz = c.len
            c = emit_byte(c, 0x0f); c = emit_byte(c, 0x85)
            c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
            let sc_r_ref: &Option<Box<Expr>> = &expr.right
            match *sc_r_ref {
                Some(re) => { c = ast_compile_expr(c, &(*re), local_names, local_slots, local_count) }
                _ => {}
            }
            let sc_or_jmp = c.len
            c = emit_byte(c, 0xe9)
            c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
            // sc_true: mov rax,1
            let sc_or_true = c.len
            c = emit_byte(c, 0x48); c = emit_byte(c, 0xb8)
            c = emit_byte(c, 1); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
            c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
            let sc_or_end = c.len
            // Patch jnz
            let jnz_disp = sc_or_true - (sc_or_jnz + 6)
            c.bytes[(sc_or_jnz + 2) as usize] = (jnz_disp & 0xFF) as i8
            c.bytes[(sc_or_jnz + 3) as usize] = ((jnz_disp >> 8) & 0xFF) as i8
            c.bytes[(sc_or_jnz + 4) as usize] = ((jnz_disp >> 16) & 0xFF) as i8
            c.bytes[(sc_or_jnz + 5) as usize] = ((jnz_disp >> 24) & 0xFF) as i8
            // Patch jmp
            let or_jmp_disp = sc_or_end - (sc_or_jmp + 5)
            c.bytes[(sc_or_jmp + 1) as usize] = (or_jmp_disp & 0xFF) as i8
            c.bytes[(sc_or_jmp + 2) as usize] = ((or_jmp_disp >> 8) & 0xFF) as i8
            c.bytes[(sc_or_jmp + 3) as usize] = ((or_jmp_disp >> 16) & 0xFF) as i8
            c.bytes[(sc_or_jmp + 4) as usize] = ((or_jmp_disp >> 24) & 0xFF) as i8
            return c
        }
        // Standard binary ops: left → stack, right → rax, then op
        let left_ref: &Option<Box<Expr>> = &expr.left
        match *left_ref {
            Some(le) => {
                c = ast_compile_expr(c, &(*le), local_names, local_slots, local_count)
            }
            _ => {}
        }
        c = emit_byte(c, 0x50)
        let right_ref: &Option<Box<Expr>> = &expr.right
        match *right_ref {
            Some(re) => {
                c = ast_compile_expr(c, &(*re), local_names, local_slots, local_count)
            }
            _ => {}
        }
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc1)
        c = emit_byte(c, 0x58)
        if expr.bin_op == BinaryOp::OpAdd {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x01); c = emit_byte(c, 0xc8)
        } else if expr.bin_op == BinaryOp::OpSub {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x29); c = emit_byte(c, 0xc8)
        } else if expr.bin_op == BinaryOp::OpMul {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xaf); c = emit_byte(c, 0xc1)
        } else if expr.bin_op == BinaryOp::OpDiv {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x99)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xf9)
        } else if expr.bin_op == BinaryOp::OpRem {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x99)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xf9)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xd0)
        } else if expr.bin_op == BinaryOp::OpEq {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
            c = emit_byte(c, 0x0f); c = emit_byte(c, 0x94); c = emit_byte(c, 0xc0)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0)
        } else if expr.bin_op == BinaryOp::OpNe {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
            c = emit_byte(c, 0x0f); c = emit_byte(c, 0x95); c = emit_byte(c, 0xc0)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0)
        } else if expr.bin_op == BinaryOp::OpLt {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
            c = emit_byte(c, 0x0f); c = emit_byte(c, 0x9c); c = emit_byte(c, 0xc0)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0)
        } else if expr.bin_op == BinaryOp::OpLe {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
            c = emit_byte(c, 0x0f); c = emit_byte(c, 0x9e); c = emit_byte(c, 0xc0)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0)
        } else if expr.bin_op == BinaryOp::OpGt {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
            c = emit_byte(c, 0x0f); c = emit_byte(c, 0x9f); c = emit_byte(c, 0xc0)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0)
        } else if expr.bin_op == BinaryOp::OpGe {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
            c = emit_byte(c, 0x0f); c = emit_byte(c, 0x9d); c = emit_byte(c, 0xc0)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0)
        } else if expr.bin_op == BinaryOp::OpBitAnd {
            // and rax, rcx: 48 21 C8
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x21); c = emit_byte(c, 0xc8)
        } else if expr.bin_op == BinaryOp::OpBitOr {
            // or rax, rcx: 48 09 C8
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x09); c = emit_byte(c, 0xc8)
        } else if expr.bin_op == BinaryOp::OpBitXor {
            // xor rax, rcx: 48 31 C8
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc8)
        } else if expr.bin_op == BinaryOp::OpShl {
            // shl rax, cl: 48 D3 E0
            c = emit_byte(c, 0x48); c = emit_byte(c, 0xd3); c = emit_byte(c, 0xe0)
        } else if expr.bin_op == BinaryOp::OpShr {
            // sar rax, cl: 48 D3 F8
            c = emit_byte(c, 0x48); c = emit_byte(c, 0xd3); c = emit_byte(c, 0xf8)
        }
        c
    } else if expr.kind == ExprKind::ExprCall {
        let callee_opt: &Option<Box<Expr>> = &expr.left
        var callee_name = ir_empty_name()
        match *callee_opt {
            Some(ce) => { callee_name = (*ce).name }
            _ => {}
        }

        // Special case: print(string_literal) → inline sys_write
        let is_print = ir_name_eq(callee_name, make_name_print())
        let is_println = ir_name_eq(callee_name, make_name_println())
        var handled_inline = false
        if is_print || is_println {
            let args_check: &Option<Box<ExprList>> = &expr.args
            match *args_check {
                Some(al) => {
                    if (*al).head.kind == ExprKind::ExprStringLit {
                        // Inline print of string literal
                        c = emit_inline_print_string(c, (*al).head.name)
                        if is_println {
                            // Also emit newline: mov byte [rsp-1], 0x0a; write(1, rsp-1, 1)
                            c = emit_byte(c, 0xc6); c = emit_byte(c, 0x44); c = emit_byte(c, 0x24); c = emit_byte(c, 0xff); c = emit_byte(c, 0x0a)
                            c = emit_byte(c, 0xb8); c = emit_byte(c, 1); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
                            c = emit_byte(c, 0xbf); c = emit_byte(c, 1); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
                            c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x74); c = emit_byte(c, 0x24); c = emit_byte(c, 0xff)
                            c = emit_byte(c, 0xba); c = emit_byte(c, 1); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
                            c = emit_byte(c, 0x0f); c = emit_byte(c, 0x05)
                        }
                        handled_inline = true
                    }
                }
                _ => {}
            }
        }

        if !handled_inline {
            var fn_slot: i64 = -1
            var li = local_count - 1
            while li >= 0 {
                if ir_name_eq(local_names[li as usize], callee_name) {
                    fn_slot = local_slots[li as usize]
                    li = -1
                } else {
                    li = li - 1
                }
            }
            // arg eval: struct idents expand to per-field pushes; track reg_count
            var reg_count: i64 = 0
            let args_ref: &Option<Box<ExprList>> = &expr.args
            var current_arg = args_ref
            while true {
                match *current_arg {
                    Some(al) => {
                        let ah: &Expr = &(*al).head
                        if (*ah).kind == ExprKind::ExprIdent {
                            // Check if scalar (has exact name entry)
                            let av = (*ah).name
                            var is_scalar: i64 = 0
                            var sli = local_count - 1
                            while sli >= 0 {
                                if ir_name_eq(local_names[sli as usize], av) {
                                    is_scalar = 1; sli = -1
                                } else { sli = sli - 1 }
                            }
                            if is_scalar == 1 {
                                c = ast_compile_expr(c, ah, local_names, local_slots, local_count)
                                c = emit_byte(c, 0x50)
                                reg_count = reg_count + 1
                            } else {
                                // Struct: push fields in registration order
                                var fsli: i64 = 0
                                while fsli < local_count {
                                    if name_has_prefix_of(local_names[fsli as usize], av) {
                                        c = micro_load_rax(c, local_slots[fsli as usize])
                                        c = emit_byte(c, 0x50)
                                        reg_count = reg_count + 1
                                    }
                                    fsli = fsli + 1
                                }
                            }
                        } else {
                            c = ast_compile_expr(c, ah, local_names, local_slots, local_count)
                            c = emit_byte(c, 0x50)
                            reg_count = reg_count + 1
                        }
                        current_arg = &(*al).tail
                    }
                    _ => break
                }
            }
            if reg_count >= 6 { c = emit_byte(c, 0x41); c = emit_byte(c, 0x59) }
            if reg_count >= 5 { c = emit_byte(c, 0x41); c = emit_byte(c, 0x58) }
            if reg_count >= 4 { c = emit_byte(c, 0x59) }
            if reg_count >= 3 { c = emit_byte(c, 0x5a) }
            if reg_count >= 2 { c = emit_byte(c, 0x5e) }
            if reg_count >= 1 { c = emit_byte(c, 0x5f) }
            if fn_slot <= -1000 {
                let target_idx = 0 - (fn_slot + 1000)
                c = emit_byte(c, 0xe8)
                c = emit_byte(c, target_idx & 0xFF)
                c = emit_byte(c, (target_idx >> 8) & 0xFF)
                c = emit_byte(c, 0xCA as i64)
                c = emit_byte(c, 0xFE as i64)
            }
        }
        c
    } else if expr.kind == ExprKind::ExprIf {
        let cond_ref: &Option<Box<Expr>> = &expr.left
        match *cond_ref {
            Some(ce) => {
                c = ast_compile_expr(c, &(*ce), local_names, local_slots, local_count)
            }
            _ => {}
        }
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0)
        let jz_site = c.len
        c = emit_byte(c, 0x0f); c = emit_byte(c, 0x84)
        c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
        let then_ref: &Option<Box<Block>> = &expr.block
        match *then_ref {
            Some(tb) => {
                c = ast_compile_block(c, &(*tb), local_names, local_slots, local_count)
            }
            _ => {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
            }
        }
        let jmp_site = c.len
        c = emit_byte(c, 0xe9)
        c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
        let else_off = c.len
        let jz_disp = else_off - (jz_site + 6)
        c.bytes[(jz_site + 2) as usize] = (jz_disp & 0xFF) as i8
        c.bytes[(jz_site + 3) as usize] = ((jz_disp >> 8) & 0xFF) as i8
        c.bytes[(jz_site + 4) as usize] = ((jz_disp >> 16) & 0xFF) as i8
        c.bytes[(jz_site + 5) as usize] = ((jz_disp >> 24) & 0xFF) as i8
        let else_expr_ref: &Option<Box<Expr>> = &expr.else_expr
        match *else_expr_ref {
            Some(ee) => {
                c = ast_compile_expr(c, &(*ee), local_names, local_slots, local_count)
            }
            _ => {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
            }
        }
        let end_off = c.len
        let jmp_disp = end_off - (jmp_site + 5)
        c.bytes[(jmp_site + 1) as usize] = (jmp_disp & 0xFF) as i8
        c.bytes[(jmp_site + 2) as usize] = ((jmp_disp >> 8) & 0xFF) as i8
        c.bytes[(jmp_site + 3) as usize] = ((jmp_disp >> 16) & 0xFF) as i8
        c.bytes[(jmp_site + 4) as usize] = ((jmp_disp >> 24) & 0xFF) as i8
        c
    } else if expr.kind == ExprKind::ExprWhile {
        let loop_top = c.len
        let wcond_ref: &Option<Box<Expr>> = &expr.left
        match *wcond_ref {
            Some(wce) => {
                c = ast_compile_expr(c, &(*wce), local_names, local_slots, local_count)
            }
            _ => {}
        }
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0)
        let wjz_site = c.len
        c = emit_byte(c, 0x0f); c = emit_byte(c, 0x84)
        c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
        let wbody_ref: &Option<Box<Block>> = &expr.block
        match *wbody_ref {
            Some(wb) => {
                c = ast_compile_block(c, &(*wb), local_names, local_slots, local_count)
            }
            _ => {}
        }
        let jback_site = c.len
        let jback_disp = loop_top - (jback_site + 5)
        c = emit_byte(c, 0xe9)
        c = emit_byte(c, jback_disp & 0xFF)
        c = emit_byte(c, (jback_disp >> 8) & 0xFF)
        c = emit_byte(c, (jback_disp >> 16) & 0xFF)
        c = emit_byte(c, (jback_disp >> 24) & 0xFF)
        let wend_off = c.len
        let wjz_disp = wend_off - (wjz_site + 6)
        c.bytes[(wjz_site + 2) as usize] = (wjz_disp & 0xFF) as i8
        c.bytes[(wjz_site + 3) as usize] = ((wjz_disp >> 8) & 0xFF) as i8
        c.bytes[(wjz_site + 4) as usize] = ((wjz_disp >> 16) & 0xFF) as i8
        c.bytes[(wjz_site + 5) as usize] = ((wjz_disp >> 24) & 0xFF) as i8
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
        c
    } else if expr.kind == ExprKind::ExprReturn {
        let ret_ref: &Option<Box<Expr>> = &expr.left
        match *ret_ref {
            Some(re) => {
                c = ast_compile_expr(c, &(*re), local_names, local_slots, local_count)
            }
            _ => {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
            }
        }
        c = emit_byte(c, 0xc9)
        c = emit_byte(c, 0xc3)
        c
    } else if expr.kind == ExprKind::ExprBlock {
        let blk_ref: &Option<Box<Block>> = &expr.block
        match *blk_ref {
            Some(blk) => {
                c = ast_compile_block(c, &(*blk), local_names, local_slots, local_count)
            }
            _ => {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
            }
        }
        c
    } else if expr.kind == ExprKind::ExprStructLit {
        // Sprint 118: two-register struct return: field0→rax, field1→rdx
        // Phase 1: count fields
        var esf_nfields: i64 = 0
        let esf_cnt_ref: &Option<Box<StructFieldList>> = &expr.fields
        var esf_cnt = esf_cnt_ref
        while true {
            match *esf_cnt {
                Some(sfl) => { esf_nfields = esf_nfields + 1; esf_cnt = &(*sfl).tail }
                _ => break
            }
        }
        // Phase 2: emit fields
        let esf_ref: &Option<Box<StructFieldList>> = &expr.fields
        var esf_cur = esf_ref
        var esf_idx: i64 = 0
        while true {
            match *esf_cur {
                Some(sfl) => {
                    let sfi: &StructFieldInit = &(*sfl).head
                    let esf_val: &Expr = &(*sfi).value
                    c = ast_compile_expr(c, esf_val, local_names, local_slots, local_count)
                    if esf_idx == 0 && esf_nfields > 1 {
                        c = emit_byte(c, 0x50)  // push rax (save field0)
                    } else if esf_idx == 1 {
                        // mov rdx, rax: rdx=field1; pop rax: rax=field0
                        c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc2)
                        c = emit_byte(c, 0x58)  // pop rax
                    }
                    esf_cur = &(*sfl).tail
                    esf_idx = esf_idx + 1
                }
                _ => break
            }
        }
        c
    } else if expr.kind == ExprKind::ExprUnary {
        let uop_ref: &Option<Box<Expr>> = &expr.left
        if expr.un_op == UnaryOp::OpRef || expr.un_op == UnaryOp::OpRefMut {
            // &arr / &! arr → emit address (LEA) of the base slot rather than loading its value
            match *uop_ref {
                Some(ue) => {
                    if (*ue).kind == ExprKind::ExprIdent {
                        var ref_slot: i64 = -1
                        var rli = local_count - 1
                        while rli >= 0 {
                            if ir_name_eq(local_names[rli as usize], (*ue).name) {
                                ref_slot = local_slots[rli as usize]
                                rli = -1
                            } else { rli = rli - 1 }
                        }
                        if ref_slot >= 0 {
                            // lea rax, [rbp - 8*(ref_slot+1)]
                            let ref_disp = 0 - ((ref_slot + 1) * 8)
                            c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x85)
                            c = emit_byte(c, ref_disp & 0xFF); c = emit_byte(c, (ref_disp >> 8) & 0xFF)
                            c = emit_byte(c, (ref_disp >> 16) & 0xFF); c = emit_byte(c, (ref_disp >> 24) & 0xFF)
                        } else {
                            c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
                        }
                    } else {
                        c = ast_compile_expr(c, &(*ue), local_names, local_slots, local_count)
                    }
                }
                _ => { c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0) }
            }
        } else if expr.un_op == UnaryOp::OpDeref {
            // *ptr → compile ptr → rax, then load [rax]
            match *uop_ref {
                Some(ue) => {
                    c = ast_compile_expr(c, &(*ue), local_names, local_slots, local_count)
                }
                _ => {}
            }
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x8b); c = emit_byte(c, 0x00)
        } else {
            match *uop_ref {
                Some(ue) => {
                    c = ast_compile_expr(c, &(*ue), local_names, local_slots, local_count)
                }
                _ => {}
            }
            if expr.un_op == UnaryOp::OpNeg {
                // neg rax
                c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xd8)
            } else if expr.un_op == UnaryOp::OpNot {
                // xor rax, 1
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x83); c = emit_byte(c, 0xf0); c = emit_byte(c, 0x01)
            }
        }
        c
    } else if expr.kind == ExprKind::ExprCast {
        // Type cast — integer casts are no-ops at x86-64 level
        // Just compile the inner expression; the value in rax is the cast result
        let cast_ref: &Option<Box<Expr>> = &expr.left
        match *cast_ref {
            Some(ie) => {
                c = ast_compile_expr(c, &(*ie), local_names, local_slots, local_count)
            }
            _ => {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
            }
        }
        c
    } else if expr.kind == ExprKind::ExprFieldAccess {
        // Field access: expr.left = base expr, expr.name = field name
        let fname = expr.name
        let fa_base_ref: &Option<Box<Expr>> = &expr.left
        var fa_handled: i64 = 0
        match *fa_base_ref {
            Some(be) => {
                if (*be).kind == ExprKind::ExprIdent {
                    // Local struct variable: look up mangled key var_name_field_name
                    let key = make_field_key((*be).name, fname)
                    var fa_slot: i64 = -1
                    var fli = local_count - 1
                    while fli >= 0 {
                        if ir_name_eq(local_names[fli as usize], key) {
                            fa_slot = local_slots[fli as usize]
                            fli = -1
                        } else { fli = fli - 1 }
                    }
                    if fa_slot >= 0 {
                        c = micro_load_rax(c, fa_slot)
                        fa_handled = 1
                    }
                }
            }
            _ => {}
        }
        if fa_handled == 0 {
            // Fallback: compile base → rax, then load via pointer with hardcoded offsets
            match *fa_base_ref {
                Some(be) => {
                    c = ast_compile_expr(c, &(*be), local_names, local_slots, local_count)
                }
                _ => {
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
                }
            }
            let is_len = fname.len == 3 &&
                fname.buf[0 as usize] == (108 as i8) &&  // l
                fname.buf[1 as usize] == (101 as i8) &&  // e
                fname.buf[2 as usize] == (110 as i8)     // n
            let is_bytes = fname.len == 5 &&
                fname.buf[0 as usize] == (98 as i8) &&   // b
                fname.buf[1 as usize] == (121 as i8) &&  // y
                fname.buf[2 as usize] == (116 as i8) &&  // t
                fname.buf[3 as usize] == (101 as i8) &&  // e
                fname.buf[4 as usize] == (115 as i8)     // s
            let is_buf = fname.len == 3 &&
                fname.buf[0 as usize] == (98 as i8) &&   // b
                fname.buf[1 as usize] == (117 as i8) &&  // u
                fname.buf[2 as usize] == (102 as i8)     // f
            if is_len {
                let off: i64 = 65536
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x8b); c = emit_byte(c, 0x80)
                c = emit_byte(c, off & 0xFF); c = emit_byte(c, (off >> 8) & 0xFF)
                c = emit_byte(c, (off >> 16) & 0xFF); c = emit_byte(c, (off >> 24) & 0xFF)
            } else if is_bytes || is_buf {
                // .bytes/.buf at offset 0 — rax is already the address
            } else {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x8b); c = emit_byte(c, 0x00)
            }
        }
        c
    } else if expr.kind == ExprKind::ExprIndex {
        // Array index: base[index] — base is local ident or (*ptr) deref
        var idx_base_slot: i64 = -1
        var idx_use_ptr: i64 = 0  // 0=local LEA, 1=load ptr value (MOV)
        let idx_base_ref: &Option<Box<Expr>> = &expr.left
        match *idx_base_ref {
            Some(be) => {
                if (*be).kind == ExprKind::ExprIdent {
                    // Local array: address computed via LEA
                    var li = local_count - 1
                    while li >= 0 {
                        if ir_name_eq(local_names[li as usize], (*be).name) {
                            idx_base_slot = local_slots[li as usize]
                            li = -1
                        } else { li = li - 1 }
                    }
                    idx_use_ptr = 0
                } else if (*be).kind == ExprKind::ExprUnary {
                    // (*ptr)[i] — deref case: ptr slot holds the base address
                    let deref_inner: &Option<Box<Expr>> = &(*be).left
                    match *deref_inner {
                        Some(de) => {
                            if (*de).kind == ExprKind::ExprIdent {
                                var li2 = local_count - 1
                                while li2 >= 0 {
                                    if ir_name_eq(local_names[li2 as usize], (*de).name) {
                                        idx_base_slot = local_slots[li2 as usize]
                                        li2 = -1
                                    } else { li2 = li2 - 1 }
                                }
                                idx_use_ptr = 1
                            }
                        }
                        _ => {}
                    }
                }
            }
            _ => {}
        }
        if idx_base_slot >= 0 {
            // Compile index → rax
            let idx_expr_ref: &Option<Box<Expr>> = &expr.right
            match *idx_expr_ref {
                Some(ie) => {
                    c = ast_compile_expr(c, &(*ie), local_names, local_slots, local_count)
                }
                _ => { c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0) }
            }
            // mov rcx, rax (index in rcx)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc1)
            let idx_disp = 0 - ((idx_base_slot + 1) * 8)
            if idx_use_ptr == 0 {
                // lea rax, [rbp - 8*(slot+1)] — local array base address
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x85)
            } else {
                // mov rax, [rbp - 8*(slot+1)] — load pointer value (which IS the base address)
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x8b); c = emit_byte(c, 0x85)
            }
            c = emit_byte(c, idx_disp & 0xFF); c = emit_byte(c, (idx_disp >> 8) & 0xFF)
            c = emit_byte(c, (idx_disp >> 16) & 0xFF); c = emit_byte(c, (idx_disp >> 24) & 0xFF)
            // neg rcx; lea rax, [rax + rcx*8] = element address; mov rax, [rax]
            c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xd9)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x04); c = emit_byte(c, 0xc8)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x8b); c = emit_byte(c, 0x00)
        } else {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
        }
        c
    } else if expr.kind == ExprKind::ExprBreak {
        // break — emit jump to nearest loop end (placeholder: NOP for now)
        c = emit_byte(c, 0x90)  // nop
        c
    } else if expr.kind == ExprKind::ExprContinue {
        // continue — emit jump to loop top (placeholder: NOP for now)
        c = emit_byte(c, 0x90)  // nop
        c
    } else {
        c = emit_byte(c, 0x48)
        c = emit_byte(c, 0x31)
        c = emit_byte(c, 0xc0)
        c
    }
}
fn ast_compile_block(code: CodeBuffer, blk: &Block,
    local_names: [Name; 64], local_slots: [i64; 64], local_count: i64
) -> CodeBuffer with Mut, Panic, Div, IO {
    var c = code
    var ln = local_names
    var ls = local_slots
    var lc = local_count
    var next_slot: i64 = 0
    // Find max existing slot to avoid conflicts
    var si: i64 = 0
    while si < lc {
        if ls[si as usize] >= next_slot {
            next_slot = ls[si as usize] + 1
        }
        si = si + 1
    }
    let stmts_ref: &Option<Box<StmtList>> = &blk.stmts
    var stmt_cur = stmts_ref
    while true {
        match *stmt_cur {
            Some(sl) => {
                let s: &Stmt = &(*sl).head
                if s.kind == StmtKind::StmtLet || s.kind == StmtKind::StmtVar {
                    // Check for array type annotation
                    var blk_arr_size: i64 = 0
                    let blk_ty_ref: &Option<Box<TypeExpr>> = &s.ty
                    match *blk_ty_ref {
                        Some(te) => {
                            if (*te).kind == TypeExprKind::TypeArray {
                                let blk_sz_ref: &Option<Box<Expr>> = &(*te).array_size
                                match *blk_sz_ref {
                                    Some(se) => { blk_arr_size = (*se).int_val }
                                    _ => {}
                                }
                            }
                        }
                        _ => {}
                    }
                    if blk_arr_size > 1 {
                        // Array variable: allocate blk_arr_size consecutive slots
                        let blk_arr_base = next_slot
                        next_slot = next_slot + blk_arr_size
                        // Determine init value from [val; N] repeat literal
                        var blk_init_val: i64 = 0
                        let blk_init_ref: &Option<Box<Expr>> = &s.expr
                        match *blk_init_ref {
                            Some(ie) => {
                                if (*ie).kind == ExprKind::ExprArrayLit {
                                    let blk_val_ref: &Option<Box<Expr>> = &(*ie).left
                                    match *blk_val_ref {
                                        Some(ve) => {
                                            if (*ve).kind == ExprKind::ExprIntLit {
                                                blk_init_val = (*ve).int_val
                                            }
                                        }
                                        _ => {}
                                    }
                                }
                            }
                            _ => {}
                        }
                        // Emit: mov rax, init_val
                        c = emit_byte(c, 0x48); c = emit_byte(c, 0xb8)
                        c = emit_byte(c, blk_init_val & 0xFF)
                        c = emit_byte(c, (blk_init_val >> 8) & 0xFF)
                        c = emit_byte(c, (blk_init_val >> 16) & 0xFF)
                        c = emit_byte(c, (blk_init_val >> 24) & 0xFF)
                        c = emit_byte(c, (blk_init_val >> 32) & 0xFF)
                        c = emit_byte(c, (blk_init_val >> 40) & 0xFF)
                        c = emit_byte(c, (blk_init_val >> 48) & 0xFF)
                        c = emit_byte(c, (blk_init_val >> 56) & 0xFF)
                        // Fill each slot
                        var blk_si: i64 = 0
                        while blk_si < blk_arr_size {
                            c = micro_store_rax(c, blk_arr_base + blk_si)
                            blk_si = blk_si + 1
                        }
                        ln[lc as usize] = s.name
                        ls[lc as usize] = blk_arr_base
                        lc = lc + 1
                    } else {
                        let init_ref: &Option<Box<Expr>> = &s.expr
                        var blk_is_struct: i64 = 0
                        match *init_ref {
                            Some(ie) => {
                                if (*ie).kind == ExprKind::ExprStructLit {
                                    blk_is_struct = 1
                                }
                            }
                            _ => {}
                        }
                        if blk_is_struct == 1 {
                            // Struct literal: register each field as var_name_field_name
                            match *init_ref {
                                Some(ie) => {
                                    let blk_sf_ref: &Option<Box<StructFieldList>> = &(*ie).fields
                                    var blk_sf_cur = blk_sf_ref
                                    while true {
                                        match *blk_sf_cur {
                                            Some(sfl) => {
                                                let sfi: &StructFieldInit = &(*sfl).head
                                                let field_slot = next_slot
                                                next_slot = next_slot + 1
                                                let val_ref: &Expr = &(*sfi).value
                                                c = ast_compile_expr(c, val_ref, ln, ls, lc)
                                                c = micro_store_rax(c, field_slot)
                                                ln[lc as usize] = make_field_key(s.name, (*sfi).name)
                                                ls[lc as usize] = field_slot
                                                lc = lc + 1
                                                blk_sf_cur = &(*sfl).tail
                                            }
                                            _ => break
                                        }
                                    }
                                }
                                _ => {}
                            }
                        } else {
                            match *init_ref {
                                Some(ie) => {
                                    c = ast_compile_expr(c, &(*ie), ln, ls, lc)
                                }
                                _ => {
                                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
                                }
                            }
                            let slot = next_slot
                            next_slot = next_slot + 1
                            c = micro_store_rax(c, slot)
                            ln[lc as usize] = s.name
                            ls[lc as usize] = slot
                            lc = lc + 1
                        }
                    }
                } else if s.kind == StmtKind::StmtExpr {
                    let expr_ref: &Option<Box<Expr>> = &s.expr
                    match *expr_ref {
                        Some(ee) => {
                            c = ast_compile_expr(c, &(*ee), ln, ls, lc)
                        }
                        _ => {}
                    }
                } else if s.kind == StmtKind::StmtAssign {
                    let rhs_ref: &Option<Box<Expr>> = &s.expr
                    match *rhs_ref {
                        Some(re) => {
                            c = ast_compile_expr(c, &(*re), ln, ls, lc)
                        }
                        _ => {}
                    }
                    let tgt_ref: &Option<Box<Expr>> = &s.target
                    match *tgt_ref {
                        Some(te) => {
                            if (*te).kind == ExprKind::ExprIdent {
                                var slot: i64 = -1
                                var li = lc - 1
                                while li >= 0 {
                                    if ir_name_eq(ln[li as usize], (*te).name) {
                                        slot = ls[li as usize]
                                        li = -1
                                    } else { li = li - 1 }
                                }
                                if slot >= 0 {
                                    c = micro_store_rax(c, slot)
                                }
                            } else if (*te).kind == ExprKind::ExprFieldAccess {
                                // pt.field = val — store rax to mangled slot
                                let fa_asgn_fname = (*te).name
                                let fa_asgn_base_ref: &Option<Box<Expr>> = &(*te).left
                                match *fa_asgn_base_ref {
                                    Some(fab) => {
                                        if (*fab).kind == ExprKind::ExprIdent {
                                            let fa_asgn_key = make_field_key((*fab).name, fa_asgn_fname)
                                            var fa_asgn_slot: i64 = -1
                                            var fali = lc - 1
                                            while fali >= 0 {
                                                if ir_name_eq(ln[fali as usize], fa_asgn_key) {
                                                    fa_asgn_slot = ls[fali as usize]
                                                    fali = -1
                                                } else { fali = fali - 1 }
                                            }
                                            if fa_asgn_slot >= 0 {
                                                c = micro_store_rax(c, fa_asgn_slot)
                                            }
                                        }
                                    }
                                    _ => {}
                                }
                            } else if (*te).kind == ExprKind::ExprIndex {
                                // arr[i] = val or (*ptr)[i] = val — val in rax
                                c = emit_byte(c, 0x50)  // push rax (value)
                                var blk_asgn_base: i64 = -1
                                var blk_asgn_use_ptr: i64 = 0
                                let blk_asgn_arr_ref: &Option<Box<Expr>> = &(*te).left
                                match *blk_asgn_arr_ref {
                                    Some(abe) => {
                                        if (*abe).kind == ExprKind::ExprIdent {
                                            var li2 = lc - 1
                                            while li2 >= 0 {
                                                if ir_name_eq(ln[li2 as usize], (*abe).name) {
                                                    blk_asgn_base = ls[li2 as usize]
                                                    li2 = -1
                                                } else { li2 = li2 - 1 }
                                            }
                                            blk_asgn_use_ptr = 0
                                        } else if (*abe).kind == ExprKind::ExprUnary {
                                            let blk_deref_ref: &Option<Box<Expr>> = &(*abe).left
                                            match *blk_deref_ref {
                                                Some(de) => {
                                                    if (*de).kind == ExprKind::ExprIdent {
                                                        var li3 = lc - 1
                                                        while li3 >= 0 {
                                                            if ir_name_eq(ln[li3 as usize], (*de).name) {
                                                                blk_asgn_base = ls[li3 as usize]
                                                                li3 = -1
                                                            } else { li3 = li3 - 1 }
                                                        }
                                                        blk_asgn_use_ptr = 1
                                                    }
                                                }
                                                _ => {}
                                            }
                                        }
                                    }
                                    _ => {}
                                }
                                if blk_asgn_base >= 0 {
                                    let blk_idx_ref: &Option<Box<Expr>> = &(*te).right
                                    match *blk_idx_ref {
                                        Some(aie) => {
                                            c = ast_compile_expr(c, &(*aie), ln, ls, lc)
                                        }
                                        _ => { c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0) }
                                    }
                                    // mov rcx, rax
                                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc1)
                                    let blk_asgn_disp = 0 - ((blk_asgn_base + 1) * 8)
                                    if blk_asgn_use_ptr == 0 {
                                        c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x85)
                                    } else {
                                        c = emit_byte(c, 0x48); c = emit_byte(c, 0x8b); c = emit_byte(c, 0x85)
                                    }
                                    c = emit_byte(c, blk_asgn_disp & 0xFF); c = emit_byte(c, (blk_asgn_disp >> 8) & 0xFF)
                                    c = emit_byte(c, (blk_asgn_disp >> 16) & 0xFF); c = emit_byte(c, (blk_asgn_disp >> 24) & 0xFF)
                                    // neg rcx; lea rax, [rax+rcx*8]; pop rdx; mov [rax], rdx
                                    c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xd9)
                                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x04); c = emit_byte(c, 0xc8)
                                    c = emit_byte(c, 0x5a)
                                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0x10)
                                } else {
                                    c = emit_byte(c, 0x58)  // pop and discard
                                }
                            }
                        }
                        _ => {}
                    }
                }
                stmt_cur = &(*sl).tail
            }
            _ => break
        }
    }
    c
}

fn ast_compile_fn_body(code: CodeBuffer, fd: &FnDef,
    fn_names: [Name; 64], fn_count: i64, prog_ref: &Program
) -> CodeBuffer with Mut, Panic, Div, IO {
    var c = code
    var local_names: [Name; 64] = [ir_empty_name(); 64]
    var local_slots: [i64; 64] = [0; 64]
    var local_count: i64 = 0
    var next_slot: i64 = 0

    // Register function names as locals with negative slots (for call resolution)
    // This is a simple approach — function calls will be patched by the caller
    var fi: i64 = 0
    while fi < fn_count {
        local_names[local_count as usize] = fn_names[fi as usize]
        local_slots[local_count as usize] = 0 - 1000 - fi
        local_count = local_count + 1
        fi = fi + 1
    }

    // Register params: rdi=p0, rsi=p1, rdx=p2, rcx=p3, r8=p4, r9=p5
    // Struct params occupy multiple consecutive registers (one per field)
    var param_ref: &Option<Box<ParamList>> = &fd.params
    var param_idx: i64 = 0
    while true {
        match *param_ref {
            Some(pl) => {
                let p_name = (*pl).head.name
                let p_ty: &TypeExpr = &(*pl).head.ty
                // Check if param is a named struct type
                var p_fcount: i64 = 0
                if (*p_ty).kind == TypeExprKind::TypeNamed {
                    // Extract type name from path first segment
                    var type_name: Name = ir_empty_name()
                    type_name.len = (*p_ty).path.segments.head_len
                    var tni: i64 = 0
                    while tni < type_name.len {
                        type_name.buf[tni as usize] = (*p_ty).path.segments.head_buf[tni as usize]
                        tni = tni + 1
                    }
                    p_fcount = struct_field_count(prog_ref, type_name)
                    if p_fcount > 0 {
                        // Struct param: spill p_fcount registers, register mangled field names
                        var fj: i64 = 0
                        while fj < p_fcount {
                            let fname: Name = struct_field_name_at(prog_ref, type_name, fj)
                            let fkey = make_field_key(p_name, fname)
                            let p_fslot = next_slot
                            next_slot = next_slot + 1
                            local_names[local_count as usize] = fkey
                            local_slots[local_count as usize] = p_fslot
                            local_count = local_count + 1
                            let reg_idx = param_idx + fj
                            if reg_idx == 0 {
                                c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xf8)
                            } else if reg_idx == 1 {
                                c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xf0)
                            } else if reg_idx == 2 {
                                c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xd0)
                            } else if reg_idx == 3 {
                                c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc8)
                            } else if reg_idx == 4 {
                                c = emit_byte(c, 0x4c); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc0)
                            } else if reg_idx == 5 {
                                c = emit_byte(c, 0x4c); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc8)
                            }
                            c = micro_store_rax(c, p_fslot)
                            fj = fj + 1
                        }
                        param_idx = param_idx + p_fcount
                    }
                }
                if p_fcount == 0 {
                    // Scalar param
                    let p_slot = next_slot
                    next_slot = next_slot + 1
                    local_names[local_count as usize] = p_name
                    local_slots[local_count as usize] = p_slot
                    local_count = local_count + 1
                    if param_idx == 0 {
                        c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xf8)
                    } else if param_idx == 1 {
                        c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xf0)
                    } else if param_idx == 2 {
                        c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xd0)
                    } else if param_idx == 3 {
                        c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc8)
                    } else if param_idx == 4 {
                        c = emit_byte(c, 0x4c); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc0)
                    } else if param_idx == 5 {
                        c = emit_byte(c, 0x4c); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc8)
                    }
                    c = micro_store_rax(c, p_slot)
                    param_idx = param_idx + 1
                }
                param_ref = &(*pl).tail
            }
            _ => break
        }
    }

    // Walk body stmts
    let stmts_ref: &Option<Box<StmtList>> = &fd.body.stmts
    var stmt_cur = stmts_ref
    var last_expr_emitted = false
    while true {
        match *stmt_cur {
            Some(sl) => {
                let s: &Stmt = &(*sl).head
                if s.kind == StmtKind::StmtLet || s.kind == StmtKind::StmtVar {
                    // Check for array type annotation
                    var fn_arr_size: i64 = 0
                    let fn_ty_ref: &Option<Box<TypeExpr>> = &s.ty
                    match *fn_ty_ref {
                        Some(te) => {
                            if (*te).kind == TypeExprKind::TypeArray {
                                let fn_sz_ref: &Option<Box<Expr>> = &(*te).array_size
                                match *fn_sz_ref {
                                    Some(se) => { fn_arr_size = (*se).int_val }
                                    _ => {}
                                }
                            }
                        }
                        _ => {}
                    }
                    if fn_arr_size > 1 {
                        // Array variable: allocate fn_arr_size consecutive slots
                        let fn_arr_base = next_slot
                        next_slot = next_slot + fn_arr_size
                        // Determine init value from [val; N] repeat literal
                        var fn_init_val: i64 = 0
                        let fn_init_ref: &Option<Box<Expr>> = &s.expr
                        match *fn_init_ref {
                            Some(ie) => {
                                if (*ie).kind == ExprKind::ExprArrayLit {
                                    let fn_val_ref: &Option<Box<Expr>> = &(*ie).left
                                    match *fn_val_ref {
                                        Some(ve) => {
                                            if (*ve).kind == ExprKind::ExprIntLit {
                                                fn_init_val = (*ve).int_val
                                            }
                                        }
                                        _ => {}
                                    }
                                }
                            }
                            _ => {}
                        }
                        // Emit: mov rax, init_val
                        c = emit_byte(c, 0x48); c = emit_byte(c, 0xb8)
                        c = emit_byte(c, fn_init_val & 0xFF)
                        c = emit_byte(c, (fn_init_val >> 8) & 0xFF)
                        c = emit_byte(c, (fn_init_val >> 16) & 0xFF)
                        c = emit_byte(c, (fn_init_val >> 24) & 0xFF)
                        c = emit_byte(c, (fn_init_val >> 32) & 0xFF)
                        c = emit_byte(c, (fn_init_val >> 40) & 0xFF)
                        c = emit_byte(c, (fn_init_val >> 48) & 0xFF)
                        c = emit_byte(c, (fn_init_val >> 56) & 0xFF)
                        // Fill each slot
                        var fn_si: i64 = 0
                        while fn_si < fn_arr_size {
                            c = micro_store_rax(c, fn_arr_base + fn_si)
                            fn_si = fn_si + 1
                        }
                        local_names[local_count as usize] = s.name
                        local_slots[local_count as usize] = fn_arr_base
                        local_count = local_count + 1
                        last_expr_emitted = false
                    } else {
                        let init_ref: &Option<Box<Expr>> = &s.expr
                        var fn_is_struct: i64 = 0
                        match *init_ref {
                            Some(ie) => {
                                if (*ie).kind == ExprKind::ExprStructLit {
                                    fn_is_struct = 1
                                }
                            }
                            _ => {}
                        }
                        if fn_is_struct == 1 {
                            // Struct literal: register each field as var_name_field_name
                            match *init_ref {
                                Some(ie) => {
                                    let fn_sf_ref: &Option<Box<StructFieldList>> = &(*ie).fields
                                    var fn_sf_cur = fn_sf_ref
                                    while true {
                                        match *fn_sf_cur {
                                            Some(sfl) => {
                                                let sfi: &StructFieldInit = &(*sfl).head
                                                let fn_fslot = next_slot
                                                next_slot = next_slot + 1
                                                let fn_val_ref: &Expr = &(*sfi).value
                                                c = ast_compile_expr(c, fn_val_ref, local_names, local_slots, local_count)
                                                c = micro_store_rax(c, fn_fslot)
                                                local_names[local_count as usize] = make_field_key(s.name, (*sfi).name)
                                                local_slots[local_count as usize] = fn_fslot
                                                local_count = local_count + 1
                                                fn_sf_cur = &(*sfl).tail
                                            }
                                            _ => break
                                        }
                                    }
                                }
                                _ => {}
                            }
                            last_expr_emitted = false
                        } else {
                            // Check if init is a call to a struct-returning function (Sprint 118)
                            var s118_ret_nfields: i64 = 0
                            var s118_ret_type: Name = ir_empty_name()
                            match *init_ref {
                                Some(ie) => {
                                    if (*ie).kind == ExprKind::ExprCall {
                                        let s118_callee_opt: &Option<Box<Expr>> = &(*ie).left
                                        match *s118_callee_opt {
                                            Some(ce) => {
                                                s118_ret_type = fn_return_type_name(prog_ref, (*ce).name)
                                                s118_ret_nfields = struct_field_count(prog_ref, s118_ret_type)
                                            }
                                            _ => {}
                                        }
                                    }
                                }
                                _ => {}
                            }
                            if s118_ret_nfields > 0 {
                                // Struct-returning call: rax=field0, rdx=field1
                                match *init_ref {
                                    Some(ie) => {
                                        c = ast_compile_expr(c, &(*ie), local_names, local_slots, local_count)
                                    }
                                    _ => {}
                                }
                                // Bind s_field0 from rax, s_field1 from rdx, etc.
                                var s118_fj: i64 = 0
                                while s118_fj < s118_ret_nfields {
                                    let s118_fname = struct_field_name_at(prog_ref, s118_ret_type, s118_fj)
                                    let s118_fkey = make_field_key(s.name, s118_fname)
                                    let s118_fslot = next_slot
                                    next_slot = next_slot + 1
                                    local_names[local_count as usize] = s118_fkey
                                    local_slots[local_count as usize] = s118_fslot
                                    local_count = local_count + 1
                                    if s118_fj == 0 {
                                        c = micro_store_rax(c, s118_fslot)
                                    } else if s118_fj == 1 {
                                        // mov rax, rdx: 48 89 D0 — store rdx into slot via rax
                                        c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xd0)
                                        c = micro_store_rax(c, s118_fslot)
                                    }
                                    s118_fj = s118_fj + 1
                                }
                                last_expr_emitted = false
                            } else {
                                // Scalar — compile init expression → rax
                                match *init_ref {
                                    Some(ie) => {
                                        c = ast_compile_expr(c, &(*ie), local_names, local_slots, local_count)
                                    }
                                    _ => {
                                        // No init — load 0
                                        c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
                                    }
                                }
                                // Bind local
                                let slot = next_slot
                                next_slot = next_slot + 1
                                c = micro_store_rax(c, slot)
                                local_names[local_count as usize] = s.name
                                local_slots[local_count as usize] = slot
                                local_count = local_count + 1
                                last_expr_emitted = false
                            }
                        }
                    }
                } else if s.kind == StmtKind::StmtExpr {
                    // Compile expression → rax
                    let expr_ref: &Option<Box<Expr>> = &s.expr
                    match *expr_ref {
                        Some(ee) => {
                            c = ast_compile_expr(c, &(*ee), local_names, local_slots, local_count)
                            last_expr_emitted = true
                        }
                        _ => { last_expr_emitted = false }
                    }
                } else if s.kind == StmtKind::StmtAssign {
                    // Compile RHS → rax
                    let rhs_ref: &Option<Box<Expr>> = &s.expr
                    match *rhs_ref {
                        Some(re) => {
                            c = ast_compile_expr(c, &(*re), local_names, local_slots, local_count)
                        }
                        _ => {}
                    }
                    // Store to target
                    let tgt_ref: &Option<Box<Expr>> = &s.target
                    match *tgt_ref {
                        Some(te) => {
                            if (*te).kind == ExprKind::ExprIdent {
                                var slot: i64 = -1
                                var li = local_count - 1
                                while li >= 0 {
                                    if ir_name_eq(local_names[li as usize], (*te).name) {
                                        slot = local_slots[li as usize]
                                        li = -1
                                    } else { li = li - 1 }
                                }
                                if slot >= 0 {
                                    c = micro_store_rax(c, slot)
                                }
                            } else if (*te).kind == ExprKind::ExprFieldAccess {
                                // pt.field = val — store rax to mangled slot
                                let fn_fa_fname = (*te).name
                                let fn_fa_base_ref: &Option<Box<Expr>> = &(*te).left
                                match *fn_fa_base_ref {
                                    Some(fab) => {
                                        if (*fab).kind == ExprKind::ExprIdent {
                                            let fn_fa_key = make_field_key((*fab).name, fn_fa_fname)
                                            var fn_fa_slot: i64 = -1
                                            var fn_fali = local_count - 1
                                            while fn_fali >= 0 {
                                                if ir_name_eq(local_names[fn_fali as usize], fn_fa_key) {
                                                    fn_fa_slot = local_slots[fn_fali as usize]
                                                    fn_fali = -1
                                                } else { fn_fali = fn_fali - 1 }
                                            }
                                            if fn_fa_slot >= 0 {
                                                c = micro_store_rax(c, fn_fa_slot)
                                            }
                                        }
                                    }
                                    _ => {}
                                }
                            } else if (*te).kind == ExprKind::ExprIndex {
                                // arr[i] = val or (*ptr)[i] = val — val in rax
                                c = emit_byte(c, 0x50)  // push rax (value)
                                var fn_asgn_base: i64 = -1
                                var fn_asgn_use_ptr: i64 = 0
                                let fn_asgn_arr_ref: &Option<Box<Expr>> = &(*te).left
                                match *fn_asgn_arr_ref {
                                    Some(abe) => {
                                        if (*abe).kind == ExprKind::ExprIdent {
                                            var li2 = local_count - 1
                                            while li2 >= 0 {
                                                if ir_name_eq(local_names[li2 as usize], (*abe).name) {
                                                    fn_asgn_base = local_slots[li2 as usize]
                                                    li2 = -1
                                                } else { li2 = li2 - 1 }
                                            }
                                            fn_asgn_use_ptr = 0
                                        } else if (*abe).kind == ExprKind::ExprUnary {
                                            let fn_deref_ref: &Option<Box<Expr>> = &(*abe).left
                                            match *fn_deref_ref {
                                                Some(de) => {
                                                    if (*de).kind == ExprKind::ExprIdent {
                                                        var li3 = local_count - 1
                                                        while li3 >= 0 {
                                                            if ir_name_eq(local_names[li3 as usize], (*de).name) {
                                                                fn_asgn_base = local_slots[li3 as usize]
                                                                li3 = -1
                                                            } else { li3 = li3 - 1 }
                                                        }
                                                        fn_asgn_use_ptr = 1
                                                    }
                                                }
                                                _ => {}
                                            }
                                        }
                                    }
                                    _ => {}
                                }
                                if fn_asgn_base >= 0 {
                                    let fn_idx_ref: &Option<Box<Expr>> = &(*te).right
                                    match *fn_idx_ref {
                                        Some(aie) => {
                                            c = ast_compile_expr(c, &(*aie), local_names, local_slots, local_count)
                                        }
                                        _ => { c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0) }
                                    }
                                    // mov rcx, rax
                                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc1)
                                    let fn_asgn_disp = 0 - ((fn_asgn_base + 1) * 8)
                                    if fn_asgn_use_ptr == 0 {
                                        c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x85)
                                    } else {
                                        c = emit_byte(c, 0x48); c = emit_byte(c, 0x8b); c = emit_byte(c, 0x85)
                                    }
                                    c = emit_byte(c, fn_asgn_disp & 0xFF); c = emit_byte(c, (fn_asgn_disp >> 8) & 0xFF)
                                    c = emit_byte(c, (fn_asgn_disp >> 16) & 0xFF); c = emit_byte(c, (fn_asgn_disp >> 24) & 0xFF)
                                    // neg rcx; lea rax, [rax+rcx*8]; pop rdx; mov [rax], rdx
                                    c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xd9)
                                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x04); c = emit_byte(c, 0xc8)
                                    c = emit_byte(c, 0x5a)
                                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0x10)
                                } else {
                                    c = emit_byte(c, 0x58)  // pop and discard
                                }
                            }
                        }
                        _ => {}
                    }
                    last_expr_emitted = false
                }
                stmt_cur = &(*sl).tail
            }
            _ => break
        }
    }
    // rax already has the result of the last expression
    c
}


fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    if argc < 2 {
        print("Usage: render_native_compile_driver_lean.sio <source.sio> <output>\n")
        return 1
    }
    let source_path = get_arg(0)
    let output_path = get_arg(1)

    print("render_compile: source=")
    print(source_path)
    print(" output=")
    print(output_path)
    print("\n")

    let prog = load_source_file(source_path)
    if parser_last_error_count() > 0 {
        print("render_compile: parse_error\n")
        return 1
    }

    // ---- AST-direct compilation with builtin support ----

    // Step 1: Emit runtime helpers at the start of the code buffer
    var code = code_buffer_new()

    // __print_int at offset 0 (130 bytes)
    let print_int_off: i64 = 0
    code = emit_runtime_print_int(code)
    let print_int_end = code.len
    print("render_compile: builtin print_int off=0 sz=")
    print_int(print_int_end)
    print("\n")

    // __print_newline right after (35 bytes)
    let print_nl_off = code.len
    code = emit_runtime_print_newline(code)
    let print_nl_end = code.len
    print("render_compile: builtin print_nl off=")
    print_int(print_nl_off)
    print(" sz=")
    print_int(print_nl_end - print_nl_off)
    print("\n")

    // Step 2: Register builtins in fn_names FIRST (indices 0, 1, 2)
    var fn_names: [Name; 64] = [ir_empty_name(); 64]
    var fn_offsets: [i64; 256] = [-1; 256]
    var fn_count: i64 = 0
    var main_fn_idx: i64 = -1

    // Builtin 0: print_int
    fn_names[0 as usize] = make_name_print_int()
    fn_offsets[0 as usize] = print_int_off
    fn_count = 1

    // Builtin 1: println (maps to print_newline)
    fn_names[1 as usize] = make_name_println()
    fn_offsets[1 as usize] = print_nl_off
    fn_count = 2

    // Builtin 2: print (also maps to print_newline for now — string printing not supported)
    fn_names[2 as usize] = make_name_print()
    fn_offsets[2 as usize] = print_nl_off
    fn_count = 3

    // Step 3: Collect user function names from AST
    let items_ref: &Option<Box<ItemList>> = &prog.items
    var item_cur = items_ref
    while true {
        match *item_cur {
            Some(il) => {
                let itm: &Item = &(*il).head
                if itm.kind == ItemKind::ItemFn {
                    fn_names[fn_count as usize] = itm.name
                    let ns = str_from_bytes(itm.name.buf, itm.name.len)
                    if str_eq(ns, "main") { main_fn_idx = fn_count }
                    fn_count = fn_count + 1
                }
                item_cur = &(*il).tail
            }
            _ => break
        }
    }
    print("render_compile: fn_count=")
    print_int(fn_count)
    print(" (")
    print_int(3)
    print(" builtins + ")
    print_int(fn_count - 3)
    print(" user)\n")

    if main_fn_idx < 0 {
        print("render_compile: no_main\n")
        return 4
    }

    // Step 4: Compile each user function body from AST
    var call_patches: [i64; 256] = [0; 256]
    var call_targets: [i64; 256] = [0; 256]
    var call_patch_count: i64 = 0

    item_cur = items_ref
    var fn_idx: i64 = 3  // start after builtins
    while true {
        match *item_cur {
            Some(il) => {
                let itm: &Item = &(*il).head
                if itm.kind == ItemKind::ItemFn {
                    let fdef_ref: &Option<Box<FnDef>> = &itm.fn_def
                    match *fdef_ref {
                        Some(fd) => {
                            fn_offsets[fn_idx as usize] = code.len
                            let ns = str_from_bytes(itm.name.buf, itm.name.len)
                            print("render_compile: fn=")
                            print(ns)

                            // Prologue: push rbp; mov rbp, rsp; sub rsp, 8192
                            let frame_size: i64 = 8192
                            code = emit_byte(code, 0x55)
                            code = emit_byte(code, 0x48)
                            code = emit_byte(code, 0x89)
                            code = emit_byte(code, 0xe5)
                            code = emit_byte(code, 0x48)
                            code = emit_byte(code, 0x81)
                            code = emit_byte(code, 0xec)
                            code = emit_byte(code, frame_size & 0xFF)
                            code = emit_byte(code, (frame_size >> 8) & 0xFF)
                            code = emit_byte(code, (frame_size >> 16) & 0xFF)
                            code = emit_byte(code, (frame_size >> 24) & 0xFF)

                            // Compile body
                            code = ast_compile_fn_body(code, &(*fd), fn_names, fn_count, &prog)

                            // Epilogue: leave; ret
                            code = emit_byte(code, 0xc9)
                            code = emit_byte(code, 0xc3)

                            let sz = code.len - fn_offsets[fn_idx as usize]
                            print(" off=")
                            print_int(fn_offsets[fn_idx as usize])
                            print(" sz=")
                            print_int(sz)
                            print("\n")
                        }
                        _ => {
                            fn_offsets[fn_idx as usize] = code.len
                        }
                    }
                    fn_idx = fn_idx + 1
                }
                item_cur = &(*il).tail
            }
            _ => break
        }
    }

    // Step 5: Patch call instructions
    // Scan for pattern: 0xe8 <fn_idx_lo> <fn_idx_hi> 0xCA 0xFE
    var pi: i64 = 0
    while pi < code.len - 4 {
        if code.bytes[pi as usize] == (0xe8 as i8) &&
           code.bytes[(pi + 3) as usize] == (0xCA as i8) &&
           code.bytes[(pi + 4) as usize] == (0xFE as i8) {
            let lo_byte = code.bytes[(pi + 1) as usize] as i64
            let hi_byte = code.bytes[(pi + 2) as usize] as i64
            let target_idx = (lo_byte & 0xFF) + ((hi_byte & 0xFF) << 8)
            if target_idx >= 0 && target_idx < fn_count {
                let target_off = fn_offsets[target_idx as usize]
                if target_off >= 0 {
                    let call_site = pi
                    let disp = target_off - (call_site + 5)
                    code.bytes[(pi + 1) as usize] = (disp & 0xFF) as i8
                    code.bytes[(pi + 2) as usize] = ((disp >> 8) & 0xFF) as i8
                    code.bytes[(pi + 3) as usize] = ((disp >> 16) & 0xFF) as i8
                    code.bytes[(pi + 4) as usize] = ((disp >> 24) & 0xFF) as i8
                }
            }
        }
        pi = pi + 1
    }

    // Step 6: Trampoline — call main; mov edi,eax; mov eax,60; syscall
    let tramp_off = code.len
    let cs = code.len
    let moff = fn_offsets[main_fn_idx as usize]
    let cd = moff - (cs + 5)
    code = emit_byte(code, 0xe8)
    code = emit_byte(code, cd & 0xFF)
    code = emit_byte(code, (cd >> 8) & 0xFF)
    code = emit_byte(code, (cd >> 16) & 0xFF)
    code = emit_byte(code, (cd >> 24) & 0xFF)
    code = emit_byte(code, 0x89)
    code = emit_byte(code, 0xc7)
    code = emit_byte(code, 0xb8)
    code = emit_byte(code, 0x3c)
    code = emit_byte(code, 0x00)
    code = emit_byte(code, 0x00)
    code = emit_byte(code, 0x00)
    code = emit_byte(code, 0x0f)
    code = emit_byte(code, 0x05)

    let total_code = code.len
    print("render_compile: total_code=")
    print_int(total_code)
    print(" tramp=")
    print_int(tramp_off)
    print("\n")

    // Step 7: Inline ELF writer
    let base_addr: i64 = 4194304
    let text_off: i64 = 4096
    let entry_va = base_addr + text_off + tramp_off

    var out: [i8; 65536] = [0; 65536]
    out[0 as usize] = 0x7f as i8
    out[1 as usize] = 69 as i8
    out[2 as usize] = 76 as i8
    out[3 as usize] = 70 as i8
    out[4 as usize] = 2 as i8
    out[5 as usize] = 1 as i8
    out[6 as usize] = 1 as i8
    out[16 as usize] = 2 as i8
    out[18 as usize] = 0x3e as i8
    out[20 as usize] = 1 as i8
    out[24 as usize] = (entry_va & 0xFF) as i8
    out[25 as usize] = ((entry_va >> 8) & 0xFF) as i8
    out[26 as usize] = ((entry_va >> 16) & 0xFF) as i8
    out[27 as usize] = ((entry_va >> 24) & 0xFF) as i8
    out[28 as usize] = ((entry_va >> 32) & 0xFF) as i8
    out[29 as usize] = ((entry_va >> 40) & 0xFF) as i8
    out[30 as usize] = ((entry_va >> 48) & 0xFF) as i8
    out[31 as usize] = ((entry_va >> 56) & 0xFF) as i8
    out[32 as usize] = 64 as i8
    out[52 as usize] = 64 as i8
    out[54 as usize] = 56 as i8
    out[56 as usize] = 2 as i8
    out[58 as usize] = 64 as i8
    out[64 as usize] = 1 as i8
    out[68 as usize] = 5 as i8
    out[80 as usize] = (base_addr & 0xFF) as i8
    out[81 as usize] = ((base_addr >> 8) & 0xFF) as i8
    out[82 as usize] = ((base_addr >> 16) & 0xFF) as i8
    out[83 as usize] = ((base_addr >> 24) & 0xFF) as i8
    out[88 as usize] = (base_addr & 0xFF) as i8
    out[89 as usize] = ((base_addr >> 8) & 0xFF) as i8
    out[90 as usize] = ((base_addr >> 16) & 0xFF) as i8
    out[91 as usize] = ((base_addr >> 24) & 0xFF) as i8
    let fsz = text_off + total_code
    out[96 as usize] = (fsz & 0xFF) as i8
    out[97 as usize] = ((fsz >> 8) & 0xFF) as i8
    out[98 as usize] = ((fsz >> 16) & 0xFF) as i8
    out[99 as usize] = ((fsz >> 24) & 0xFF) as i8
    out[104 as usize] = (fsz & 0xFF) as i8
    out[105 as usize] = ((fsz >> 8) & 0xFF) as i8
    out[106 as usize] = ((fsz >> 16) & 0xFF) as i8
    out[107 as usize] = ((fsz >> 24) & 0xFF) as i8
    out[112 as usize] = 0 as i8
    out[113 as usize] = 16 as i8
    out[120 as usize] = 0x51 as i8
    out[121 as usize] = 0xe5 as i8
    out[122 as usize] = 0x74 as i8
    out[123 as usize] = 0x64 as i8
    out[124 as usize] = 6 as i8

    var ci: i64 = 0
    while ci < total_code && (text_off + ci) < 65536 {
        out[(text_off + ci) as usize] = code.bytes[ci as usize]
        ci = ci + 1
    }

    let total_len = text_off + total_code
    let write_ok = io_write_native_binary(output_path, out, total_len)
    if !write_ok {
        print("render_compile: write_error\n")
        return 5
    }

    print("render_compile: ok written=")
    print(output_path)
    print(" size=")
    print_int(total_len)
    print("\n")
    0
}
