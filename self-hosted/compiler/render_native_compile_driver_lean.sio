// self-hosted::compiler::render_native_compile_driver_lean
//
// Ultra-lean native compile driver with micro-emitter.
// Avoids NativeCompiler by-value returns (broken under Cranelift JIT).
// Uses ONLY CodeBuffer by-value returns (65KB, proven JIT-safe).
//
// Pipeline: parse → flat IR summary → per-body lower → micro-emit x86-64 → inline ELF → write
//
// Usage:
//   souc run self-hosted/compiler/render_native_compile_driver_lean.sio -- <source> <output>

// Imports: parser + IR + native encode for full AST-direct pipeline.
// parser::mod provides parse_items_preloaded (boot4-safe: returns Option<Box<ItemList>>).
use lexer::mod::*
use parser::ast::*
use parser::mod::*
use parser::parser::*
use ir::ir::*
use io::file_write::*
use interop::contract::*
use native::encode::*

// Wide output buffer for programs exceeding 65KB code size (16MB — supports ~1MB+ x86-64)
var WIDE_OUT: [i8; 16777216] = [0; 16777216]
var WIDE_LEN: i64 = 0

// Sprint 234 Track A: Closure registry
// CLOSURE_OFFSETS[i] = WIDE_LEN offset where closure i's code starts
// Closure LEA sentinel: 48 8D 05 <cidx_lo> <cidx_hi> 0xC1 0xBE (7 bytes, distinct from fn-ref 0xDA 0xBE)
var CLOSURE_OFFSETS: [i64; 64] = [-1; 64]
var CLOSURE_COUNT: i64 = 0
// Closure body scope — globals so body expression compiler (recursive) only passes CodeBuffer.
// [Name; 8] = 1,088 bytes: 8 × ir_empty_name() = trivial vs [Name; 512] = 66K IR nodes.
var CL_BODY_NAMES: [Name; 8] = [ir_empty_name(); 8]
var CL_BODY_SLOTS: [i64; 8] = [0; 8]
var CL_BODY_COUNT: i64 = 0

// Global ELF assembly buffer — must be global (not stack) to avoid stack overflow for large binaries
var GLOBAL_ELF: [i8; 16777216] = [0; 16777216]

// Global variable registry (file-scope var declarations)
var GLOBAL_NAMES: [Name; 256] = [ir_empty_name(); 256]
var GLOBAL_OFFSETS: [i64; 256] = [0; 256]      // byte offset from global_base
var GLOBAL_SIZES: [i64; 256] = [0; 256]        // total byte size of this global
var GLOBAL_ELEM_SIZES: [i64; 256] = [0; 256]   // element size (1 for i8, 8 for i64, 8 for scalar)
var GLOBAL_IS_FLOAT: [i64; 256] = [0; 256]     // 1 if element type is f64, 0 otherwise
var GLOBAL_COUNT: i64 = 0
var GLOBAL_TOTAL_SIZE: i64 = 0
var GLOBAL_BASE_ABS: i64 = 0  // absolute VA of global_base_ptr storage
// JIT Heisenbug workaround: MAIN_FN_IDX as global — JIT clobbers locals across str_eq calls.
var MAIN_FN_IDX: i64 = -1
// Source buffer for lexer (same-module global — avoids cross-module BSS NULL pointer bug)
var LEAN_SOURCE: [i8; 1048576] = [0; 1048576]
var LEAN_SOURCE_LEN: i64 = 0
// Boot4-safe lexer state (all same-module globals)
var LTP_POS: i64 = 0
var LTP_LINE: i64 = 1
var LTP_COL: i64 = 1
var LTP_TC: i64 = 0
var LTP_N: i64 = 0

// Same-module token arrays (replaces cross-module PT_* from parser.sio)
var MP_KIND: [i64; 65536] = [0; 65536]
var MP_START: [i64; 65536] = [0; 65536]
var MP_END: [i64; 65536] = [0; 65536]
var MP_LINE: [i64; 65536] = [0; 65536]
var MP_INT_VALUE: [i64; 65536] = [0; 65536]

// Float literal decomposition (integer-part and fractional numerator/denominator)
var MP_FLOAT_INT: [i64; 65536] = [0; 65536]    // integer part
var MP_FLOAT_FRAC: [i64; 65536] = [0; 65536]   // fractional numerator
var MP_FLOAT_DENOM: [i64; 65536] = [0; 65536]  // fractional denominator (10^digits)

fn ltp_byte(idx: i64) -> i8 with Panic {
    if idx >= 0 && idx < LTP_N { LEAN_SOURCE[idx as usize] } else { 0 as i8 }
}

// Same-module token setters (replaces cross-module parser_set_token_* calls)
fn mp_set_token(idx: i64, kind: i64, start: i64, end: i64, line: i64) with Mut, Panic {
    if idx >= 0 && idx < 65536 {
        MP_KIND[idx as usize] = kind
        MP_START[idx as usize] = start
        MP_END[idx as usize] = end
        MP_LINE[idx as usize] = line
    }
}

fn mp_set_int_value(idx: i64, val: i64) with Mut, Panic {
    if idx >= 0 && idx < 65536 { MP_INT_VALUE[idx as usize] = val }
}

// Boot4-safe helpers (replaces imported is_digit/is_ident_start/is_ident_continue)
fn ltp_is_digit(ch: i8) -> bool { ch >= 48 && ch <= 57 }
fn ltp_is_hex_digit(ch: i8) -> bool {
    (ch >= 48 && ch <= 57) || (ch >= 97 && ch <= 102) || (ch >= 65 && ch <= 70)
}
fn ltp_is_bin_digit(ch: i8) -> bool { ch == 48 || ch == 49 }
fn ltp_is_alpha(ch: i8) -> bool {
    (ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) || ch == 95
}
fn ltp_is_alnum(ch: i8) -> bool { ltp_is_alpha(ch) || ltp_is_digit(ch) }

fn ltp_scan_string() with Mut, Div, Panic {
    let ss = LTP_POS
    let sl = LTP_LINE
    LTP_POS = LTP_POS + 1; LTP_COL = LTP_COL + 1
    while LTP_POS < LTP_N && ltp_byte(LTP_POS) != 34 {
        if ltp_byte(LTP_POS) == 92 { LTP_POS = LTP_POS + 1; LTP_COL = LTP_COL + 1 }
        if ltp_byte(LTP_POS) == 10 { LTP_LINE = LTP_LINE + 1; LTP_COL = 1 }
        LTP_POS = LTP_POS + 1; LTP_COL = LTP_COL + 1
    }
    if LTP_POS < LTP_N { LTP_POS = LTP_POS + 1; LTP_COL = LTP_COL + 1 }
    mp_set_token(LTP_TC, 123, ss, LTP_POS, sl)  // 123 = StringLit
    MP_INT_VALUE[LTP_TC as usize] = 0
    LTP_TC = LTP_TC + 1
}

fn ltp_scan_number(ch: i8) with Mut, Div, Panic {
    let ns = LTP_POS
    let nl = LTP_LINE
    var nk: i64 = 121  // IntLit
    if ch == 48 && LTP_POS + 1 < LTP_N && (ltp_byte(LTP_POS + 1) == 120 || ltp_byte(LTP_POS + 1) == 88) {
        LTP_POS = LTP_POS + 2
        while LTP_POS < LTP_N && (ltp_is_hex_digit(ltp_byte(LTP_POS)) || ltp_byte(LTP_POS) == 95) { LTP_POS = LTP_POS + 1 }
    } else if ch == 48 && LTP_POS + 1 < LTP_N && (ltp_byte(LTP_POS + 1) == 98 || ltp_byte(LTP_POS + 1) == 66) {
        LTP_POS = LTP_POS + 2
        while LTP_POS < LTP_N && (ltp_is_bin_digit(ltp_byte(LTP_POS)) || ltp_byte(LTP_POS) == 95) { LTP_POS = LTP_POS + 1 }
    } else {
        while LTP_POS < LTP_N && (ltp_is_digit(ltp_byte(LTP_POS)) || ltp_byte(LTP_POS) == 95) { LTP_POS = LTP_POS + 1 }
        if LTP_POS < LTP_N && ltp_byte(LTP_POS) == 46 && LTP_POS + 1 < LTP_N && ltp_is_digit(ltp_byte(LTP_POS + 1)) {
            nk = 122  // FloatLit
            LTP_POS = LTP_POS + 1
            while LTP_POS < LTP_N && (ltp_is_digit(ltp_byte(LTP_POS)) || ltp_byte(LTP_POS) == 95) { LTP_POS = LTP_POS + 1 }
        }
    }
    LTP_COL = LTP_COL + (LTP_POS - ns)
    mp_set_token(LTP_TC, nk, ns, LTP_POS, nl)
    if nk == 121 { mp_set_int_value(LTP_TC, mc_parse_int(ns, LTP_POS)) }
    else { mc_parse_float_parts(LTP_TC, ns, LTP_POS) }
    LTP_TC = LTP_TC + 1
}

// keyword_lookup_cs: look up keyword from LEAN_SOURCE at offset `start` with length `len`
// Returns raw integer token kind matching MC_TK_* constants. Boot4-safe (no TokenKind enum).
fn keyword_lookup_cs(start: i64, len: i64) -> i64 with Panic {
    let b0 = if len > 0 { ltp_byte(start) } else { 0 as i8 }
    let b1 = if len > 1 { ltp_byte(start + 1) } else { 0 as i8 }
    let b2 = if len > 2 { ltp_byte(start + 2) } else { 0 as i8 }
    let b3 = if len > 3 { ltp_byte(start + 3) } else { 0 as i8 }
    let b4 = if len > 4 { ltp_byte(start + 4) } else { 0 as i8 }
    let b5 = if len > 5 { ltp_byte(start + 5) } else { 0 as i8 }
    let b6 = if len > 6 { ltp_byte(start + 6) } else { 0 as i8 }
    let b7 = if len > 7 { ltp_byte(start + 7) } else { 0 as i8 }
    // Length 2: fn=7, if=17, in=120(ident), as=27
    if len == 2 {
        if b0 == 102 && b1 == 110 { return 7 }
        if b0 == 105 && b1 == 102 { return 17 }
        if b0 == 105 && b1 == 110 { return 120 }
        if b0 == 97 && b1 == 115 { return 27 }
    }
    // Length 3: let=8, var=9, for=21, pub=120(ident), use=120(ident)
    if len == 3 {
        if b0 == 108 && b1 == 101 && b2 == 116 { return 8 }
        if b0 == 118 && b1 == 97 && b2 == 114 { return 9 }
        if b0 == 102 && b1 == 111 && b2 == 114 { return 21 }
        if b0 == 112 && b1 == 117 && b2 == 98 { return 120 }
        if b0 == 117 && b1 == 115 && b2 == 101 { return 120 }
    }
    // Length 4: else=18, enum=201, impl=120, with=42, self=120, true=32, type=120, loop=21
    if len == 4 {
        if b0 == 101 && b1 == 108 && b2 == 115 && b3 == 101 { return 18 }
        if b0 == 101 && b1 == 110 && b2 == 117 && b3 == 109 { return 201 }
        if b0 == 105 && b1 == 109 && b2 == 112 && b3 == 108 { return 120 }
        if b0 == 119 && b1 == 105 && b2 == 116 && b3 == 104 { return 42 }
        if b0 == 115 && b1 == 101 && b2 == 108 && b3 == 102 { return 120 }
        if b0 == 116 && b1 == 114 && b2 == 117 && b3 == 101 { return 32 }
        if b0 == 116 && b1 == 121 && b2 == 112 && b3 == 101 { return 120 }
        if b0 == 108 && b1 == 111 && b2 == 111 && b3 == 112 { return 21 }
        if b0 == 78 && b1 == 111 && b2 == 110 && b3 == 101 { return 120 }
        if b0 == 83 && b1 == 111 && b2 == 109 && b3 == 101 { return 120 }
    }
    // Length 5: while=21, break=23, match=202, false=33, trait=120, const=120
    if len == 5 {
        if b0 == 119 && b1 == 104 && b2 == 105 && b3 == 108 && b4 == 101 { return 21 }
        if b0 == 98 && b1 == 114 && b2 == 101 && b3 == 97 && b4 == 107 { return 23 }
        if b0 == 109 && b1 == 97 && b2 == 116 && b3 == 99 && b4 == 104 { return 202 }
        if b0 == 102 && b1 == 97 && b2 == 108 && b3 == 115 && b4 == 101 { return 33 }
        if b0 == 116 && b1 == 114 && b2 == 97 && b3 == 105 && b4 == 116 { return 120 }
        if b0 == 99 && b1 == 111 && b2 == 110 && b3 == 115 && b4 == 116 { return 120 }
    }
    // Length 6: return=25, struct=200, module=120, extern=120, static=120, effect=120, unsafe=120, linear=120
    if len == 6 {
        if b0 == 114 && b1 == 101 && b2 == 116 && b3 == 117 && b4 == 114 && b5 == 110 { return 25 }
        if b0 == 115 && b1 == 116 && b2 == 114 && b3 == 117 && b4 == 99 && b5 == 116 { return 200 }
        if b0 == 109 && b1 == 111 && b2 == 100 && b3 == 117 && b4 == 108 && b5 == 101 { return 120 }
        if b0 == 101 && b1 == 120 && b2 == 116 && b3 == 101 && b4 == 114 && b5 == 110 { return 120 }
        if b0 == 115 && b1 == 116 && b2 == 97 && b3 == 116 && b4 == 105 && b5 == 99 { return 120 }
        if b0 == 101 && b1 == 102 && b2 == 102 && b3 == 101 && b4 == 99 && b5 == 116 { return 120 }
        if b0 == 117 && b1 == 110 && b2 == 115 && b3 == 97 && b4 == 102 && b5 == 101 { return 120 }
        if b0 == 108 && b1 == 105 && b2 == 110 && b3 == 101 && b4 == 97 && b5 == 114 { return 120 }
    }
    // Length 8: continue=24
    if len == 8 {
        if b0 == 99 && b1 == 111 && b2 == 110 && b3 == 116 && b4 == 105 && b5 == 110 && b6 == 117 && b7 == 101 { return 24 }
    }
    120  // Ident
}

fn ltp_scan_ident() with Mut, Div, Panic {
    let is = LTP_POS
    let il = LTP_LINE
    while LTP_POS < LTP_N && ltp_is_alnum(ltp_byte(LTP_POS)) { LTP_POS = LTP_POS + 1 }
    let ilen = LTP_POS - is
    LTP_COL = LTP_COL + ilen
    let kind = keyword_lookup_cs(is, ilen)
    mp_set_token(LTP_TC, kind, is, LTP_POS, il)
    MP_INT_VALUE[LTP_TC as usize] = 0
    LTP_TC = LTP_TC + 1
}

fn ltp_scan_op(ch: i8) -> i64 with Mut, Div, Panic {
    var m: i64 = 0
    var k: i64 = 1  // 1 = Error
    var a: i64 = 1
    let c1 = if LTP_POS + 1 < LTP_N { ltp_byte(LTP_POS + 1) } else { 0 as i8 }
    let c2 = if LTP_POS + 2 < LTP_N { ltp_byte(LTP_POS + 2) } else { 0 as i8 }
    // 3-char operators (must check before 2-char)
    if m == 0 && ch == 60 && c1 == 60 && c2 == 61 { k = 167; a = 3; m = 1 }   // <<=  ShlEq
    if m == 0 && ch == 62 && c1 == 62 && c2 == 61 { k = 168; a = 3; m = 1 }   // >>=  ShrEq
    // 2-char operators
    if m == 0 && ch == 61 && c1 == 61 { k = 143; a = 2; m = 1 }   // ==   EqEq
    if m == 0 && ch == 33 && c1 == 61 { k = 144; a = 2; m = 1 }   // !=   BangEq
    if m == 0 && ch == 60 && c1 == 61 { k = 145; a = 2; m = 1 }   // <=   LtEq
    if m == 0 && ch == 62 && c1 == 61 { k = 146; a = 2; m = 1 }   // >=   GtEq
    if m == 0 && ch == 38 && c1 == 38 { k = 147; a = 2; m = 1 }   // &&   AmpAmp
    if m == 0 && ch == 124 && c1 == 124 { k = 148; a = 2; m = 1 } // ||   PipePipe
    if m == 0 && ch == 60 && c1 == 60 { k = 149; a = 2; m = 1 }   // <<   Shl
    if m == 0 && ch == 62 && c1 == 62 { k = 150; a = 2; m = 1 }   // >>   Shr
    if m == 0 && ch == 43 && c1 == 61 { k = 151; a = 2; m = 1 }   // +=   PlusEq
    if m == 0 && ch == 45 && c1 == 61 { k = 152; a = 2; m = 1 }   // -=   MinusEq
    if m == 0 && ch == 42 && c1 == 61 { k = 153; a = 2; m = 1 }   // *=   StarEq
    if m == 0 && ch == 47 && c1 == 61 { k = 154; a = 2; m = 1 }   // /=   SlashEq
    if m == 0 && ch == 37 && c1 == 61 { k = 162; a = 2; m = 1 }   // %=   PercentEq
    if m == 0 && ch == 124 && c1 == 61 { k = 157; a = 2; m = 1 }  // |=   PipeEq
    if m == 0 && ch == 94 && c1 == 61 { k = 158; a = 2; m = 1 }   // ^=   CaretEq
    if m == 0 && ch == 38 && c1 == 61 { k = 165; a = 2; m = 1 }   // &=   AmpEq
    if m == 0 && ch == 45 && c1 == 62 { k = 155; a = 2; m = 1 }   // ->   Arrow
    if m == 0 && ch == 61 && c1 == 62 { k = 156; a = 2; m = 1 }   // =>   FatArrow
    if m == 0 && ch == 58 && c1 == 58 { k = 159; a = 2; m = 1 }   // ::   ColonColon
    if m == 0 && ch == 38 && c1 == 33 { k = 160; a = 2; m = 1 }   // &!   AmpBang
    if m == 0 && ch == 43 && c1 == 43 { k = 161; a = 2; m = 1 }   // ++   PlusPlus
    // 1-char operators
    if m == 0 && ch == 43 { k = 129; m = 1 }   // +   Plus
    if m == 0 && ch == 45 { k = 130; m = 1 }   // -   Minus
    if m == 0 && ch == 42 { k = 131; m = 1 }   // *   Star
    if m == 0 && ch == 47 { k = 132; m = 1 }   // /   Slash
    if m == 0 && ch == 37 { k = 133; m = 1 }   // %   Percent
    if m == 0 && ch == 61 { k = 134; m = 1 }   // =   Eq
    if m == 0 && ch == 60 { k = 135; m = 1 }   // <   Lt
    if m == 0 && ch == 62 { k = 136; m = 1 }   // >   Gt
    if m == 0 && ch == 33 { k = 137; m = 1 }   // !   Bang
    if m == 0 && ch == 38 { k = 138; m = 1 }   // &   Amp
    if m == 0 && ch == 124 { k = 139; m = 1 }  // |   Pipe
    if m == 0 && ch == 94 { k = 140; m = 1 }   // ^   Caret
    if m == 0 && ch == 126 { k = 141; m = 1 }  // ~   Tilde
    if m == 0 && ch == 63 { k = 142; m = 1 }   // ?   Question
    if m == 0 && ch == 40 { k = 171; m = 1 }   // (   LParen
    if m == 0 && ch == 41 { k = 172; m = 1 }   // )   RParen
    if m == 0 && ch == 123 { k = 173; m = 1 }  // {   LBrace
    if m == 0 && ch == 125 { k = 174; m = 1 }  // }   RBrace
    if m == 0 && ch == 91 { k = 175; m = 1 }   // [   LBracket
    if m == 0 && ch == 93 { k = 176; m = 1 }   // ]   RBracket
    if m == 0 && ch == 59 { k = 177; m = 1 }   // ;   Semi
    if m == 0 && ch == 58 { k = 178; m = 1 }   // :   Colon
    if m == 0 && ch == 44 { k = 179; m = 1 }   // ,   Comma
    if m == 0 && ch == 46 { k = 180; m = 1 }   // .   Dot
    if m == 0 && ch == 64 { k = 181; m = 1 }   // @   At
    if m == 0 && ch == 35 { k = 182; m = 1 }   // #   Hash
    if m == 0 && ch == 95 { k = 183; m = 1 }   // _   Underscore
    if m == 1 {
        mp_set_token(LTP_TC, k, LTP_POS, LTP_POS + a, LTP_LINE)
        MP_INT_VALUE[LTP_TC as usize] = 0
        LTP_TC = LTP_TC + 1; LTP_POS = LTP_POS + a; LTP_COL = LTP_COL + a
    }
    m
}

fn lean_lex_to_parser() -> i64 with Mut, Div, Panic {
    LTP_N = LEAN_SOURCE_LEN
    LTP_POS = 0; LTP_LINE = 1; LTP_COL = 1; LTP_TC = 0
    while LTP_POS < LTP_N {
        let ch = ltp_byte(LTP_POS)
        if ch == 32 || ch == 9 || ch == 13 { LTP_POS = LTP_POS + 1; LTP_COL = LTP_COL + 1; continue }
        if ch == 10 { LTP_POS = LTP_POS + 1; LTP_LINE = LTP_LINE + 1; LTP_COL = 1; continue }
        if ch == 47 && LTP_POS + 1 < LTP_N && ltp_byte(LTP_POS + 1) == 47 {
            LTP_POS = LTP_POS + 2
            while LTP_POS < LTP_N && ltp_byte(LTP_POS) != 10 { LTP_POS = LTP_POS + 1 }
            continue
        }
        if ch == 47 && LTP_POS + 1 < LTP_N && ltp_byte(LTP_POS + 1) == 42 {
            var depth: i64 = 1; LTP_POS = LTP_POS + 2
            while LTP_POS + 1 < LTP_N && depth > 0 {
                if ltp_byte(LTP_POS) == 47 && ltp_byte(LTP_POS + 1) == 42 { depth = depth + 1; LTP_POS = LTP_POS + 2; continue }
                if ltp_byte(LTP_POS) == 42 && ltp_byte(LTP_POS + 1) == 47 { depth = depth - 1; LTP_POS = LTP_POS + 2; continue }
                if ltp_byte(LTP_POS) == 10 { LTP_LINE = LTP_LINE + 1; LTP_COL = 1 }
                LTP_POS = LTP_POS + 1
            }
            continue
        }
        if ch == 34 { ltp_scan_string(); continue }
        if ltp_is_digit(ch) { ltp_scan_number(ch); continue }
        if ltp_is_alpha(ch) { ltp_scan_ident(); continue }
        if ltp_scan_op(ch) == 1 { continue }
        if ch == 39 {
            let cs = LTP_POS; LTP_POS = LTP_POS + 1
            if LTP_POS < LTP_N && ltp_byte(LTP_POS) == 92 { LTP_POS = LTP_POS + 1 }
            if LTP_POS < LTP_N { LTP_POS = LTP_POS + 1 }
            if LTP_POS < LTP_N && ltp_byte(LTP_POS) == 39 { LTP_POS = LTP_POS + 1 }
            LTP_COL = LTP_COL + (LTP_POS - cs)
            mp_set_token(LTP_TC, 124, cs, LTP_POS, LTP_LINE)  // 124 = CharLit
            MP_INT_VALUE[LTP_TC as usize] = 0
            LTP_TC = LTP_TC + 1; continue
        }
        LTP_POS = LTP_POS + 1; LTP_COL = LTP_COL + 1
    }
    mp_set_token(LTP_TC, 0, LTP_POS, LTP_POS, LTP_LINE)  // 0 = Eof
    MP_INT_VALUE[LTP_TC as usize] = 0
    LTP_TC = LTP_TC + 1
    LTP_TC
}

fn wide_flush(code: CodeBuffer) with Mut, Panic, Div {
    var i: i64 = 0
    while i < code.len && WIDE_LEN < 16777216 {
        WIDE_OUT[WIDE_LEN as usize] = code.bytes[i as usize]
        WIDE_LEN = WIDE_LEN + 1
        i = i + 1
    }
}

// Helpers required by codegen dependency chain (flat-namespace resolution).
fn char_from_i64(n: i64) -> string with Mut, Panic {
    if n == 0 { "0" }
    else if n == 1 { "1" }
    else if n == 2 { "2" }
    else if n == 3 { "3" }
    else if n == 4 { "4" }
    else if n == 5 { "5" }
    else if n == 6 { "6" }
    else if n == 7 { "7" }
    else if n == 8 { "8" }
    else if n == 9 { "9" }
    else { "?" }
}

fn pow10_idx(idx: i64) -> i64 {
    if idx == 0 { 1000000000000000000 }
    else if idx == 1 { 100000000000000000 }
    else if idx == 2 { 10000000000000000 }
    else if idx == 3 { 1000000000000000 }
    else if idx == 4 { 100000000000000 }
    else if idx == 5 { 10000000000000 }
    else if idx == 6 { 1000000000000 }
    else if idx == 7 { 100000000000 }
    else if idx == 8 { 10000000000 }
    else if idx == 9 { 1000000000 }
    else if idx == 10 { 100000000 }
    else if idx == 11 { 10000000 }
    else if idx == 12 { 1000000 }
    else if idx == 13 { 100000 }
    else if idx == 14 { 10000 }
    else if idx == 15 { 1000 }
    else if idx == 16 { 100 }
    else if idx == 17 { 10 }
    else { 1 }
}

fn digit_for_power(rem: i64, power: i64) -> i64 {
    if rem <= (0 - (9 * power)) { 9 }
    else if rem <= (0 - (8 * power)) { 8 }
    else if rem <= (0 - (7 * power)) { 7 }
    else if rem <= (0 - (6 * power)) { 6 }
    else if rem <= (0 - (5 * power)) { 5 }
    else if rem <= (0 - (4 * power)) { 4 }
    else if rem <= (0 - (3 * power)) { 3 }
    else if rem <= (0 - (2 * power)) { 2 }
    else if rem <= (0 - power) { 1 }
    else { 0 }
}

fn i64_to_digits_no_div(rem: i64, idx: i64, started: bool) -> string with Mut, Panic {
    if idx >= 19 { return "" }
    let power = pow10_idx(idx)
    let digit = digit_for_power(rem, power)
    let rem_next = rem + (digit * power)
    let emit = started || digit > 0 || idx == 18
    let head = if emit { char_from_i64(digit) } else { "" }
    head + i64_to_digits_no_div(rem_next, idx + 1, emit)
}

fn int_to_string(n: i64) -> string with Mut, Panic, Div {
    if n == 0 { return "0" }
    let negative = n < 0
    let rem = if negative { n } else { 0 - n }
    let digits = i64_to_digits_no_div(rem, 0, false)
    if negative { "-" + digits } else { digits }
}

fn parse_i64_decimal(raw: string) -> (bool, i64) with Mut, Div {
    if str_len(raw) == 0 { return (false, 0) }
    var idx: i64 = 0
    var negative = false
    if str_char_at(raw, 0) == "-" {
        negative = true
        idx = 1
        if idx >= str_len(raw) { return (false, 0) }
    }
    var value: i64 = 0
    while idx < str_len(raw) {
        let ch = str_char_at(raw, idx)
        if ch < "0" || ch > "9" { return (false, 0) }
        value = value * 10 + ((ch as i64) - ("0" as i64))
        idx = idx + 1
    }
    if negative { (true, 0 - value) } else { (true, value) }
}

// Extract IEEE 754 bit pattern from f64 (runs at compile time in JIT)
fn f64_bits(v: f64) -> i64 with Mut, Panic, Div {
    if v == 0.0 { return 0 }
    var sign: i64 = 0
    var abs_v = v
    if v < 0.0 { sign = 1; abs_v = 0.0 - v }
    var exp: i64 = 1023
    var m = abs_v
    while m >= 2.0 { m = m / 2.0; exp = exp + 1 }
    while m < 1.0 { m = m * 2.0; exp = exp - 1 }
    let mant = ((m - 1.0) * 4503599627370496.0) as i64
    (sign << 63) | (exp << 52) | mant
}

// load_and_parse: lex source → call real parser → return Option<Box<ItemList>>
// Uses parse_items_preloaded (imported from parser::mod) which returns ≤2 slots (boot4-safe).
fn load_and_parse(path: string) -> Option<Box<ItemList>> with IO, Mut, Div, Panic, Alloc {
    let tc = lean_lex_to_parser()
    print("lex: tokens=")
    print_int(tc)
    print("\n")
    parse_items_preloaded(tc)
}

// ============================================================================
// Micro-emitter: IR → x86-64 using ONLY CodeBuffer (65KB by-value, JIT-safe)
// Stack-slot model: vreg N → [rbp - 8*(N+1)]
// ============================================================================

fn micro_store_rax(code: CodeBuffer, vreg: i64) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    let disp = 0 - ((vreg + 1) * 8)
    c = emit_byte(c, 0x48)
    c = emit_byte(c, 0x89)
    c = emit_byte(c, 0x85)
    c = emit_byte(c, disp & 0xFF)
    c = emit_byte(c, (disp >> 8) & 0xFF)
    c = emit_byte(c, (disp >> 16) & 0xFF)
    c = emit_byte(c, (disp >> 24) & 0xFF)
    c
}

fn micro_load_rax(code: CodeBuffer, vreg: i64) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    let disp = 0 - ((vreg + 1) * 8)
    c = emit_byte(c, 0x48)
    c = emit_byte(c, 0x8b)
    c = emit_byte(c, 0x85)
    c = emit_byte(c, disp & 0xFF)
    c = emit_byte(c, (disp >> 8) & 0xFF)
    c = emit_byte(c, (disp >> 16) & 0xFF)
    c = emit_byte(c, (disp >> 24) & 0xFF)
    c
}

fn micro_load_rcx(code: CodeBuffer, vreg: i64) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    let disp = 0 - ((vreg + 1) * 8)
    c = emit_byte(c, 0x48)
    c = emit_byte(c, 0x8b)
    c = emit_byte(c, 0x8d)
    c = emit_byte(c, disp & 0xFF)
    c = emit_byte(c, (disp >> 8) & 0xFF)
    c = emit_byte(c, (disp >> 16) & 0xFF)
    c = emit_byte(c, (disp >> 24) & 0xFF)
    c
}

// XMM micro helpers — same stack layout, SSE2 MOVSD encoding
// MOVSD [rbp+disp32], xmm0: F2 0F 11 85 <disp32>
fn micro_store_xmm0(code: CodeBuffer, vreg: i64) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    let disp = 0 - ((vreg + 1) * 8)
    c = emit_byte(c, 0xF2 as i64)
    c = emit_byte(c, 0x0F)
    c = emit_byte(c, 0x11)
    c = emit_byte(c, 0x85 as i64)
    c = emit_byte(c, disp & 0xFF)
    c = emit_byte(c, (disp >> 8) & 0xFF)
    c = emit_byte(c, (disp >> 16) & 0xFF)
    c = emit_byte(c, (disp >> 24) & 0xFF)
    c
}

// MOVSD xmm0, [rbp+disp32]: F2 0F 10 85 <disp32>
fn micro_load_xmm0(code: CodeBuffer, vreg: i64) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    let disp = 0 - ((vreg + 1) * 8)
    c = emit_byte(c, 0xF2 as i64)
    c = emit_byte(c, 0x0F)
    c = emit_byte(c, 0x10)
    c = emit_byte(c, 0x85 as i64)
    c = emit_byte(c, disp & 0xFF)
    c = emit_byte(c, (disp >> 8) & 0xFF)
    c = emit_byte(c, (disp >> 16) & 0xFF)
    c = emit_byte(c, (disp >> 24) & 0xFF)
    c
}

// MOVSD xmm1, [rbp+disp32]: F2 0F 10 8D <disp32>
fn micro_load_xmm1(code: CodeBuffer, vreg: i64) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    let disp = 0 - ((vreg + 1) * 8)
    c = emit_byte(c, 0xF2 as i64)
    c = emit_byte(c, 0x0F)
    c = emit_byte(c, 0x10)
    c = emit_byte(c, 0x8D as i64)
    c = emit_byte(c, disp & 0xFF)
    c = emit_byte(c, (disp >> 8) & 0xFF)
    c = emit_byte(c, (disp >> 16) & 0xFF)
    c = emit_byte(c, (disp >> 24) & 0xFF)
    c
}

fn micro_compile_function(code: CodeBuffer, func: IrFunction, fn_offsets: [i64; 512]) -> CodeBuffer with Mut, Panic, Div {
    let frame_raw = (func.reg_count + 2) * 8
    let frame_size = ((frame_raw + 15) / 16) * 16

    // Prologue
    var c = code
    c = emit_byte(c, 0x55)
    c = emit_byte(c, 0x48)
    c = emit_byte(c, 0x89)
    c = emit_byte(c, 0xe5)
    if frame_size > 0 {
        c = emit_byte(c, 0x48)
        c = emit_byte(c, 0x81)
        c = emit_byte(c, 0xec)
        c = emit_byte(c, frame_size & 0xFF)
        c = emit_byte(c, (frame_size >> 8) & 0xFF)
        c = emit_byte(c, (frame_size >> 16) & 0xFF)
        c = emit_byte(c, (frame_size >> 24) & 0xFF)
    }

    // Spill params (rdi→p0, rsi→p1, rdx→p2, rcx→p3)
    var pi: i64 = 0
    while pi < func.param_count && pi < 4 {
        let vreg = func.param_regs[pi as usize]
        if vreg >= 0 {
            if pi == 0 {
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x89)
                c = emit_byte(c, 0xf8)
            } else if pi == 1 {
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x89)
                c = emit_byte(c, 0xf0)
            } else if pi == 2 {
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x89)
                c = emit_byte(c, 0xd0)
            } else if pi == 3 {
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x89)
                c = emit_byte(c, 0xc8)
            }
            c = micro_store_rax(c, vreg)
        }
        pi = pi + 1
    }

    // Label offsets and patch lists
    var labels: [i64; 256] = [-1; 256]
    var ret_sites: [i64; 64] = [0; 64]
    var ret_count: i64 = 0
    var fwd_sites: [i64; 128] = [0; 128]
    var fwd_count: i64 = 0

    // Type tracking: 0=i64, 1=f64
    var vreg_is_float: [i64; 256] = [0; 256]

    // Emit instructions
    print("  MICRO instr_count=")
    print_int(func.instr_count)
    print(" reg_count=")
    print_int(func.reg_count)
    print("\n")
    var ip: i64 = 0
    while ip < func.instr_count {
        let instr = func.instrs[ip as usize]
        print("  ir[")
        print_int(ip)
        print("]=")
        print_int(instr.op as i64)
        print(" dst=")
        print_int(instr.dst)
        print(" s1=")
        print_int(instr.src1)
        print(" s2=")
        print_int(instr.src2)
        print("\n")

        if instr.op == IrOpcode::IrLoadImm || instr.op == IrOpcode::IrLoadBool {
            // Inline mov rax, imm64 — avoid nested CodeBuffer returns
            c = emit_byte(c, 0x48)
            c = emit_byte(c, 0xb8)
            c = emit_byte(c, instr.imm_i64 & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 8) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 16) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 24) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 32) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 40) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 48) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 56) & 0xFF)
            if instr.dst >= 0 { c = micro_store_rax(c, instr.dst) }

        } else if instr.op == IrOpcode::IrLoadFloat {
            // Store f64 bit pattern via RAX into stack slot, mark as float
            let fbits = f64_bits(instr.imm_f64)
            c = emit_byte(c, 0x48)
            c = emit_byte(c, 0xb8)
            c = emit_byte(c, fbits & 0xFF)
            c = emit_byte(c, (fbits >> 8) & 0xFF)
            c = emit_byte(c, (fbits >> 16) & 0xFF)
            c = emit_byte(c, (fbits >> 24) & 0xFF)
            c = emit_byte(c, (fbits >> 32) & 0xFF)
            c = emit_byte(c, (fbits >> 40) & 0xFF)
            c = emit_byte(c, (fbits >> 48) & 0xFF)
            c = emit_byte(c, (fbits >> 56) & 0xFF)
            if instr.dst >= 0 {
                c = micro_store_rax(c, instr.dst)
                vreg_is_float[instr.dst as usize] = 1
            }

        } else if instr.op == IrOpcode::IrIntToFloat {
            // CVTSI2SD xmm0, rax: F2 48 0F 2A C0
            if instr.src1 >= 0 { c = micro_load_rax(c, instr.src1) }
            c = emit_byte(c, 0xF2 as i64)
            c = emit_byte(c, 0x48)
            c = emit_byte(c, 0x0F)
            c = emit_byte(c, 0x2A)
            c = emit_byte(c, 0xC0 as i64)
            if instr.dst >= 0 {
                c = micro_store_xmm0(c, instr.dst)
                vreg_is_float[instr.dst as usize] = 1
            }

        } else if instr.op == IrOpcode::IrFloatToInt {
            // CVTTSD2SI rax, xmm0: F2 48 0F 2C C0
            if instr.src1 >= 0 { c = micro_load_xmm0(c, instr.src1) }
            c = emit_byte(c, 0xF2 as i64)
            c = emit_byte(c, 0x48)
            c = emit_byte(c, 0x0F)
            c = emit_byte(c, 0x2C)
            c = emit_byte(c, 0xC0 as i64)
            if instr.dst >= 0 {
                c = micro_store_rax(c, instr.dst)
                vreg_is_float[instr.dst as usize] = 0
            }

        } else if instr.op == IrOpcode::IrReturn {
            if instr.src1 >= 0 {
                if vreg_is_float[instr.src1 as usize] == 1 {
                    // f64 return: MOVSD xmm0, [slot]; then MOVQ rax, xmm0
                    c = micro_load_xmm0(c, instr.src1)
                    // MOVQ rax, xmm0: 66 48 0F 7E C0
                    c = emit_byte(c, 0x66)
                    c = emit_byte(c, 0x48)
                    c = emit_byte(c, 0x0F)
                    c = emit_byte(c, 0x7E)
                    c = emit_byte(c, 0xC0 as i64)
                } else {
                    c = micro_load_rax(c, instr.src1)
                }
            }
            let site = c.len
            c = emit_byte(c, 0xe9)
            c = emit_byte(c, 0)
            c = emit_byte(c, 0)
            c = emit_byte(c, 0)
            c = emit_byte(c, 0)
            if ret_count < 64 { ret_sites[ret_count as usize] = site }
            ret_count = ret_count + 1

        } else if instr.op == IrOpcode::IrBinOp {
            let is_float_op = instr.src1 >= 0 && vreg_is_float[instr.src1 as usize] == 1
            if is_float_op {
                // Float path: load xmm0 ← src1, xmm1 ← src2
                c = micro_load_xmm0(c, instr.src1)
                c = micro_load_xmm1(c, instr.src2)
                if instr.bin_op == BinaryOp::OpAdd {
                    // ADDSD xmm0, xmm1: F2 0F 58 C1
                    c = emit_byte(c, 0xF2 as i64); c = emit_byte(c, 0x0F)
                    c = emit_byte(c, 0x58); c = emit_byte(c, 0xC1 as i64)
                } else if instr.bin_op == BinaryOp::OpSub {
                    // SUBSD xmm0, xmm1: F2 0F 5C C1
                    c = emit_byte(c, 0xF2 as i64); c = emit_byte(c, 0x0F)
                    c = emit_byte(c, 0x5C); c = emit_byte(c, 0xC1 as i64)
                } else if instr.bin_op == BinaryOp::OpMul {
                    // MULSD xmm0, xmm1: F2 0F 59 C1
                    c = emit_byte(c, 0xF2 as i64); c = emit_byte(c, 0x0F)
                    c = emit_byte(c, 0x59); c = emit_byte(c, 0xC1 as i64)
                } else if instr.bin_op == BinaryOp::OpDiv {
                    // DIVSD xmm0, xmm1: F2 0F 5E C1
                    c = emit_byte(c, 0xF2 as i64); c = emit_byte(c, 0x0F)
                    c = emit_byte(c, 0x5E); c = emit_byte(c, 0xC1 as i64)
                } else if instr.bin_op == BinaryOp::OpLt {
                    // COMISD xmm1, xmm0: 66 0F 2F C8 ; SETA al; MOVZX rax, al
                    c = emit_byte(c, 0x66); c = emit_byte(c, 0x0F)
                    c = emit_byte(c, 0x2F); c = emit_byte(c, 0xC8 as i64)
                    c = emit_byte(c, 0x0F); c = emit_byte(c, 0x97 as i64); c = emit_byte(c, 0xC0 as i64)
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x0F); c = emit_byte(c, 0xB6 as i64); c = emit_byte(c, 0xC0 as i64)
                } else if instr.bin_op == BinaryOp::OpLe {
                    // COMISD xmm1, xmm0: 66 0F 2F C8 ; SETAE al; MOVZX rax, al
                    c = emit_byte(c, 0x66); c = emit_byte(c, 0x0F)
                    c = emit_byte(c, 0x2F); c = emit_byte(c, 0xC8 as i64)
                    c = emit_byte(c, 0x0F); c = emit_byte(c, 0x93 as i64); c = emit_byte(c, 0xC0 as i64)
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x0F); c = emit_byte(c, 0xB6 as i64); c = emit_byte(c, 0xC0 as i64)
                } else if instr.bin_op == BinaryOp::OpGt {
                    // COMISD xmm0, xmm1: 66 0F 2F C1 ; SETA al; MOVZX rax, al
                    c = emit_byte(c, 0x66); c = emit_byte(c, 0x0F)
                    c = emit_byte(c, 0x2F); c = emit_byte(c, 0xC1 as i64)
                    c = emit_byte(c, 0x0F); c = emit_byte(c, 0x97 as i64); c = emit_byte(c, 0xC0 as i64)
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x0F); c = emit_byte(c, 0xB6 as i64); c = emit_byte(c, 0xC0 as i64)
                } else if instr.bin_op == BinaryOp::OpGe {
                    // COMISD xmm0, xmm1: 66 0F 2F C1 ; SETAE al; MOVZX rax, al
                    c = emit_byte(c, 0x66); c = emit_byte(c, 0x0F)
                    c = emit_byte(c, 0x2F); c = emit_byte(c, 0xC1 as i64)
                    c = emit_byte(c, 0x0F); c = emit_byte(c, 0x93 as i64); c = emit_byte(c, 0xC0 as i64)
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x0F); c = emit_byte(c, 0xB6 as i64); c = emit_byte(c, 0xC0 as i64)
                } else if instr.bin_op == BinaryOp::OpEq {
                    // COMISD xmm0, xmm1: 66 0F 2F C1 ; SETE al; MOVZX rax, al
                    c = emit_byte(c, 0x66); c = emit_byte(c, 0x0F)
                    c = emit_byte(c, 0x2F); c = emit_byte(c, 0xC1 as i64)
                    c = emit_byte(c, 0x0F); c = emit_byte(c, 0x94 as i64); c = emit_byte(c, 0xC0 as i64)
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x0F); c = emit_byte(c, 0xB6 as i64); c = emit_byte(c, 0xC0 as i64)
                } else if instr.bin_op == BinaryOp::OpNe {
                    // COMISD xmm0, xmm1: 66 0F 2F C1 ; SETNE al; MOVZX rax, al
                    c = emit_byte(c, 0x66); c = emit_byte(c, 0x0F)
                    c = emit_byte(c, 0x2F); c = emit_byte(c, 0xC1 as i64)
                    c = emit_byte(c, 0x0F); c = emit_byte(c, 0x95 as i64); c = emit_byte(c, 0xC0 as i64)
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x0F); c = emit_byte(c, 0xB6 as i64); c = emit_byte(c, 0xC0 as i64)
                }
                // Float arithmetic results stay in xmm0 → store as float
                if instr.bin_op == BinaryOp::OpAdd || instr.bin_op == BinaryOp::OpSub || instr.bin_op == BinaryOp::OpMul || instr.bin_op == BinaryOp::OpDiv {
                    if instr.dst >= 0 {
                        c = micro_store_xmm0(c, instr.dst)
                        vreg_is_float[instr.dst as usize] = 1
                    }
                } else {
                    // Comparison results are i64 (0 or 1) in rax
                    if instr.dst >= 0 {
                        c = micro_store_rax(c, instr.dst)
                        vreg_is_float[instr.dst as usize] = 0
                    }
                }
            } else {
                // Integer path (original)
                c = micro_load_rax(c, instr.src1)
                c = micro_load_rcx(c, instr.src2)
                if instr.bin_op == BinaryOp::OpAdd {
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x01); c = emit_byte(c, 0xc8)
                } else if instr.bin_op == BinaryOp::OpSub {
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x29); c = emit_byte(c, 0xc8)
                } else if instr.bin_op == BinaryOp::OpMul {
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xaf); c = emit_byte(c, 0xc1)
                } else if instr.bin_op == BinaryOp::OpDiv {
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x99)
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xf9)
                } else if instr.bin_op == BinaryOp::OpRem {
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x99)
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xf9)
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xd0)
                } else if instr.bin_op == BinaryOp::OpLt {
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
                    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x9c); c = emit_byte(c, 0xc0)
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0)
                } else if instr.bin_op == BinaryOp::OpLe {
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
                    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x9e); c = emit_byte(c, 0xc0)
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0)
                } else if instr.bin_op == BinaryOp::OpGt {
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
                    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x9f); c = emit_byte(c, 0xc0)
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0)
                } else if instr.bin_op == BinaryOp::OpGe {
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
                    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x9d); c = emit_byte(c, 0xc0)
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0)
                } else if instr.bin_op == BinaryOp::OpEq {
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
                    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x94); c = emit_byte(c, 0xc0)
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0)
                } else if instr.bin_op == BinaryOp::OpNe {
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
                    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x95); c = emit_byte(c, 0xc0)
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0)
                }
                if instr.dst >= 0 { c = micro_store_rax(c, instr.dst) }
            }

        } else if instr.op == IrOpcode::IrCall {
            // Push caller-saved regs if needed, load args, call, store result
            if instr.arg_count >= 1 && instr.src1 >= 0 {
                c = micro_load_rax(c, instr.src1)
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x89)
                c = emit_byte(c, 0xc7)
            }
            if instr.arg_count >= 2 && instr.src2 >= 0 {
                c = micro_load_rax(c, instr.src2)
                c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x89)
                c = emit_byte(c, 0xc6)
            }
            let cs = c.len
            let tgt = fn_offsets[instr.fn_id as usize]
            let disp = tgt - (cs + 5)
            c = emit_byte(c, 0xe8)
            c = emit_byte(c, disp & 0xFF)
            c = emit_byte(c, (disp >> 8) & 0xFF)
            c = emit_byte(c, (disp >> 16) & 0xFF)
            c = emit_byte(c, (disp >> 24) & 0xFF)
            if instr.dst >= 0 { c = micro_store_rax(c, instr.dst) }

        } else if instr.op == IrOpcode::IrCopy {
            if instr.src1 >= 0 && vreg_is_float[instr.src1 as usize] == 1 {
                c = micro_load_xmm0(c, instr.src1)
                if instr.dst >= 0 {
                    c = micro_store_xmm0(c, instr.dst)
                    vreg_is_float[instr.dst as usize] = 1
                }
            } else {
                c = micro_load_rax(c, instr.src1)
                if instr.dst >= 0 { c = micro_store_rax(c, instr.dst) }
            }

        } else if instr.op == IrOpcode::IrLabel {
            labels[instr.label_id as usize] = c.len

        } else if instr.op == IrOpcode::IrJump {
            let tgt = labels[instr.label_id as usize]
            let site = c.len
            c = emit_byte(c, 0xe9)
            if tgt >= 0 {
                let d = tgt - (site + 5)
                c = emit_byte(c, d & 0xFF)
                c = emit_byte(c, (d >> 8) & 0xFF)
                c = emit_byte(c, (d >> 16) & 0xFF)
                c = emit_byte(c, (d >> 24) & 0xFF)
            } else {
                c = emit_byte(c, 0)
                c = emit_byte(c, 0)
                c = emit_byte(c, 0)
                c = emit_byte(c, 0)
                if fwd_count < 128 {
                    fwd_sites[fwd_count as usize] = (site + 1) + (instr.label_id * 65536)
                    fwd_count = fwd_count + 1
                }
            }

        } else if instr.op == IrOpcode::IrBranchTrue {
            c = micro_load_rax(c, instr.src1)
            c = emit_byte(c, 0x48)
            c = emit_byte(c, 0x85)
            c = emit_byte(c, 0xc0)
            let tgt = labels[instr.label_id as usize]
            let site = c.len
            c = emit_byte(c, 0x0f)
            c = emit_byte(c, 0x85)
            if tgt >= 0 {
                let d = tgt - (site + 6)
                c = emit_byte(c, d & 0xFF)
                c = emit_byte(c, (d >> 8) & 0xFF)
                c = emit_byte(c, (d >> 16) & 0xFF)
                c = emit_byte(c, (d >> 24) & 0xFF)
            } else {
                c = emit_byte(c, 0)
                c = emit_byte(c, 0)
                c = emit_byte(c, 0)
                c = emit_byte(c, 0)
                if fwd_count < 128 {
                    fwd_sites[fwd_count as usize] = (site + 2) + (instr.label_id * 65536)
                    fwd_count = fwd_count + 1
                }
            }

        } else if instr.op == IrOpcode::IrBranchFalse {
            c = micro_load_rax(c, instr.src1)
            c = emit_byte(c, 0x48)
            c = emit_byte(c, 0x85)
            c = emit_byte(c, 0xc0)
            let tgt = labels[instr.label_id as usize]
            let site = c.len
            c = emit_byte(c, 0x0f)
            c = emit_byte(c, 0x84)
            if tgt >= 0 {
                let d = tgt - (site + 6)
                c = emit_byte(c, d & 0xFF)
                c = emit_byte(c, (d >> 8) & 0xFF)
                c = emit_byte(c, (d >> 16) & 0xFF)
                c = emit_byte(c, (d >> 24) & 0xFF)
            } else {
                c = emit_byte(c, 0)
                c = emit_byte(c, 0)
                c = emit_byte(c, 0)
                c = emit_byte(c, 0)
                if fwd_count < 128 {
                    fwd_sites[fwd_count as usize] = (site + 2) + (instr.label_id * 65536)
                    fwd_count = fwd_count + 1
                }
            }

        } else if instr.op == IrOpcode::IrNop {
            // skip
        } else if instr.op == IrOpcode::IrLoadString {
            c = emit_byte(c, 0x48)
            c = emit_byte(c, 0xb8)
            c = emit_byte(c, instr.imm_i64 & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 8) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 16) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 24) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 32) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 40) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 48) & 0xFF)
            c = emit_byte(c, (instr.imm_i64 >> 56) & 0xFF)
            if instr.dst >= 0 { c = micro_store_rax(c, instr.dst) }
        } else {
            print("  UNSUPPORTED op=")
            print_int(instr.op as i64)
            print("\n")
        }
        ip = ip + 1
    }

    // Epilogue
    let epilogue_off = c.len
    c = emit_byte(c, 0xc9)
    c = emit_byte(c, 0xc3)

    // Patch return jumps
    var ri: i64 = 0
    while ri < ret_count && ri < 64 {
        let s = ret_sites[ri as usize]
        let d = epilogue_off - (s + 5)
        c.bytes[(s + 1) as usize] = (d & 0xFF) as i8
        c.bytes[(s + 2) as usize] = ((d >> 8) & 0xFF) as i8
        c.bytes[(s + 3) as usize] = ((d >> 16) & 0xFF) as i8
        c.bytes[(s + 4) as usize] = ((d >> 24) & 0xFF) as i8
        ri = ri + 1
    }

    // Patch forward branches
    var fi: i64 = 0
    while fi < fwd_count {
        let enc = fwd_sites[fi as usize]
        let s = enc % 65536
        let lid = enc / 65536
        let tgt = labels[lid as usize]
        if tgt >= 0 {
            let d = tgt - (s + 4)
            c.bytes[(s + 0) as usize] = (d & 0xFF) as i8
            c.bytes[(s + 1) as usize] = ((d >> 8) & 0xFF) as i8
            c.bytes[(s + 2) as usize] = ((d >> 16) & 0xFF) as i8
            c.bytes[(s + 3) as usize] = ((d >> 24) & 0xFF) as i8
        }
        fi = fi + 1
    }

    c
}

// ============================================================================
// Builtin function emitters for static ELF binaries
// ============================================================================

// Emit print_int(n: i64) — converts n to decimal, writes to stdout
// n arrives in rdi. Uses stack buffer for itoa.
// Layout: push rbp; mov rbp,rsp; sub rsp,32 (32-byte buffer at [rbp-32..rbp-1])
fn ast_emit_print_int_builtin(code: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    // prologue
    c = emit_byte(c, 0x55)                   // push rbp
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xe5) // mov rbp, rsp
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x83); c = emit_byte(c, 0xec); c = emit_byte(c, 0x30) // sub rsp, 48

    // mov rax, rdi (n)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xf8)

    // r8 = write position = rbp - 1 (end of buffer, write right-to-left)
    // lea r8, [rbp-1]
    c = emit_byte(c, 0x4c); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x45); c = emit_byte(c, 0xFF)

    // Handle sign: if rax < 0, negate and set r9=1
    // xor r9d, r9d  (sign flag)
    c = emit_byte(c, 0x45); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc9)
    // test rax, rax
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0)
    // jns +6 (skip neg rax [3 bytes] + mov r9b,1 [3 bytes])
    c = emit_byte(c, 0x79); c = emit_byte(c, 0x06)
    // neg rax
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xd8)
    // mov r9d, 1
    c = emit_byte(c, 0x41); c = emit_byte(c, 0xb1); c = emit_byte(c, 0x01)

    // Handle zero: test rax, rax; jnz itoa_loop
    // test rax, rax
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0)
    // jnz +9 (skip zero handling: 4 bytes mov + 3 bytes dec + 2 bytes jmp)
    c = emit_byte(c, 0x75); c = emit_byte(c, 0x09)
    // mov byte [r8], '0' (0x30)
    c = emit_byte(c, 0x41); c = emit_byte(c, 0xc6); c = emit_byte(c, 0x00); c = emit_byte(c, 0x30)
    // dec r8 (so do_write's inc r8 points to first digit)
    c = emit_byte(c, 0x49); c = emit_byte(c, 0xff); c = emit_byte(c, 0xc8)
    // jmp do_write
    let jmp_zero_site = c.len
    c = emit_byte(c, 0xeb); c = emit_byte(c, 0x00) // placeholder

    // itoa_loop:
    let itoa_loop = c.len
    // xor edx, edx
    c = emit_byte(c, 0x31); c = emit_byte(c, 0xd2)
    // mov rcx, 10
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xc7); c = emit_byte(c, 0xc1)
    c = emit_byte(c, 0x0a); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    // div rcx  (rax = quotient, rdx = remainder)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xf1)
    // add dl, '0'
    c = emit_byte(c, 0x80); c = emit_byte(c, 0xc2); c = emit_byte(c, 0x30)
    // mov [r8], dl
    c = emit_byte(c, 0x41); c = emit_byte(c, 0x88); c = emit_byte(c, 0x10)
    // dec r8
    c = emit_byte(c, 0x49); c = emit_byte(c, 0xff); c = emit_byte(c, 0xc8)
    // test rax, rax
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0)
    // jnz itoa_loop
    let jnz_back = c.len
    let back_disp = itoa_loop - (jnz_back + 2)
    c = emit_byte(c, 0x75); c = emit_byte(c, back_disp & 0xFF)

    // Check sign: test r9b, r9b; jz do_write
    // test r9b, r9b
    c = emit_byte(c, 0x45); c = emit_byte(c, 0x84); c = emit_byte(c, 0xc9)
    // jz +7 (skip: mov byte [4] + dec r8 [3] = 7 bytes)
    c = emit_byte(c, 0x74); c = emit_byte(c, 0x07)
    // mov byte [r8], '-' (0x2d)
    c = emit_byte(c, 0x41); c = emit_byte(c, 0xc6); c = emit_byte(c, 0x00); c = emit_byte(c, 0x2d)
    // dec r8
    c = emit_byte(c, 0x49); c = emit_byte(c, 0xff); c = emit_byte(c, 0xc8)

    // do_write:
    let do_write = c.len
    // Patch jmp_zero_site
    let zero_disp = do_write - (jmp_zero_site + 2)
    c.bytes[(jmp_zero_site + 1) as usize] = (zero_disp & 0xFF) as i8

    // r8+1 = start of string, rbp-1 = last byte written
    // inc r8 (point to first digit)
    c = emit_byte(c, 0x49); c = emit_byte(c, 0xff); c = emit_byte(c, 0xc0)
    // lea rsi, [r8]  (buf ptr for sys_write)
    c = emit_byte(c, 0x4c); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc6)
    // lea rdx, [rbp]  (end+1)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xea)
    // sub rdx, r8  (len = rbp - r8... but r8 was already incremented)
    // Actually: len = (rbp) - (r8) where r8 = first digit, last byte at [rbp-1]
    // so len = rbp - r8
    c = emit_byte(c, 0x4c); c = emit_byte(c, 0x29); c = emit_byte(c, 0xc2) // sub rdx, r8

    // sys_write(1, rsi, rdx): mov edi, 1; mov eax, 1; syscall
    c = emit_byte(c, 0xbf); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xb8); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x05)

    // epilogue: leave; ret
    c = emit_byte(c, 0xc9)
    c = emit_byte(c, 0xc3)
    c
}

// Sprint 235: print_f64(x: f64) builtin — outputs sign + int + '.' + 6-digit fraction + '\n'
fn ast_emit_print_f64_builtin(code: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    c = emit_byte(c, 0x55); c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xe5)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x83); c = emit_byte(c, 0xec); c = emit_byte(c, 0x50)
    c = emit_byte(c, 0x66); c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x6e); c = emit_byte(c, 0xc7)
    c = emit_byte(c, 0x66); c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x7e); c = emit_byte(c, 0xc0)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0)
    let skip_neg = c.len
    c = emit_byte(c, 0x79); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xc6); c = emit_byte(c, 0x45); c = emit_byte(c, 0xff); c = emit_byte(c, 0x2d)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x75); c = emit_byte(c, 0xff)
    c = emit_byte(c, 0xba); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xbf); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xb8); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x05)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x25); c = emit_byte(c, 0xff); c = emit_byte(c, 0xff); c = emit_byte(c, 0xff); c = emit_byte(c, 0xff)
    c = emit_byte(c, 0xff); c = emit_byte(c, 0xff); c = emit_byte(c, 0xff); c = emit_byte(c, 0x7f)
    c = emit_byte(c, 0x66); c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x6e); c = emit_byte(c, 0xc0)
    c.bytes[(skip_neg + 1) as usize] = ((c.len - (skip_neg + 2)) & 0xFF) as i8
    c = emit_byte(c, 0xf2); c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x2c); c = emit_byte(c, 0xc0)
    c = emit_byte(c, 0x4c); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x55); c = emit_byte(c, 0xd8)
    c = emit_byte(c, 0x49); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc0)
    c = emit_byte(c, 0x41); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc0)
    c = emit_byte(c, 0x41); c = emit_byte(c, 0x80); c = emit_byte(c, 0xc0); c = emit_byte(c, 0x30)
    c = emit_byte(c, 0x45); c = emit_byte(c, 0x88); c = emit_byte(c, 0x02)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x75); c = emit_byte(c, 0xd8)
    c = emit_byte(c, 0xba); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xbf); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xb8); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x05)
    c = emit_byte(c, 0xc6); c = emit_byte(c, 0x45); c = emit_byte(c, 0xfe); c = emit_byte(c, 0x2e)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x75); c = emit_byte(c, 0xfe)
    c = emit_byte(c, 0xba); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xbf); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xb8); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x05)
    c = emit_byte(c, 0xf2); c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x2a); c = emit_byte(c, 0xc8)
    c = emit_byte(c, 0xf2); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x5c); c = emit_byte(c, 0xc1)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xb8); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x80); c = emit_byte(c, 0x84); c = emit_byte(c, 0x2e); c = emit_byte(c, 0x41)
    c = emit_byte(c, 0x66); c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x6e); c = emit_byte(c, 0xd0)
    c = emit_byte(c, 0xf2); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x59); c = emit_byte(c, 0xc2)
    c = emit_byte(c, 0xf2); c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x2c); c = emit_byte(c, 0xc8)
    // Extract 6 fractional digits from rcx (= frac * 1e6)
    // digit 0: rcx / 100000
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc8) // mov rax, rcx
    c = emit_byte(c, 0x31); c = emit_byte(c, 0xd2)                         // xor edx, edx
    c = emit_byte(c, 0xb9); c = emit_byte(c, 0xa0); c = emit_byte(c, 0x86); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00) // mov ecx, 100000
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xf1) // div rcx
    c = emit_byte(c, 0x04); c = emit_byte(c, 0x30)                         // add al, '0'
    c = emit_byte(c, 0x88); c = emit_byte(c, 0x45); c = emit_byte(c, 0xf7) // mov [rbp-9], al
    // digit 1: rdx / 10000
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xd0) // mov rax, rdx
    c = emit_byte(c, 0x31); c = emit_byte(c, 0xd2)                         // xor edx, edx
    c = emit_byte(c, 0xb9); c = emit_byte(c, 0x10); c = emit_byte(c, 0x27); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00) // mov ecx, 10000
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xf1) // div rcx
    c = emit_byte(c, 0x04); c = emit_byte(c, 0x30)                         // add al, '0'
    c = emit_byte(c, 0x88); c = emit_byte(c, 0x45); c = emit_byte(c, 0xf8) // mov [rbp-8], al
    // digit 2: rdx / 1000
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xd0)
    c = emit_byte(c, 0x31); c = emit_byte(c, 0xd2)
    c = emit_byte(c, 0xb9); c = emit_byte(c, 0xe8); c = emit_byte(c, 0x03); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xf1)
    c = emit_byte(c, 0x04); c = emit_byte(c, 0x30)
    c = emit_byte(c, 0x88); c = emit_byte(c, 0x45); c = emit_byte(c, 0xf9) // mov [rbp-7], al
    // digit 3: rdx / 100
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xd0)
    c = emit_byte(c, 0x31); c = emit_byte(c, 0xd2)
    c = emit_byte(c, 0xb9); c = emit_byte(c, 0x64); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xf1)
    c = emit_byte(c, 0x04); c = emit_byte(c, 0x30)
    c = emit_byte(c, 0x88); c = emit_byte(c, 0x45); c = emit_byte(c, 0xfa) // mov [rbp-6], al
    // digit 4: rdx / 10
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xd0)
    c = emit_byte(c, 0x31); c = emit_byte(c, 0xd2)
    c = emit_byte(c, 0xb9); c = emit_byte(c, 0x0a); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xf1)
    c = emit_byte(c, 0x04); c = emit_byte(c, 0x30)
    c = emit_byte(c, 0x88); c = emit_byte(c, 0x45); c = emit_byte(c, 0xfb) // mov [rbp-5], al
    // digit 5: rdx is the last digit
    c = emit_byte(c, 0x80); c = emit_byte(c, 0xc2); c = emit_byte(c, 0x30) // add dl, '0'
    c = emit_byte(c, 0x88); c = emit_byte(c, 0x55); c = emit_byte(c, 0xfc) // mov [rbp-4], dl
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x75); c = emit_byte(c, 0xf7)
    c = emit_byte(c, 0xba); c = emit_byte(c, 0x06); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xbf); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xb8); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x05)
    c = emit_byte(c, 0xc6); c = emit_byte(c, 0x45); c = emit_byte(c, 0xfd); c = emit_byte(c, 0x0a)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x75); c = emit_byte(c, 0xfd)
    c = emit_byte(c, 0xba); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xbf); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xb8); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x05)
    c = emit_byte(c, 0xc9); c = emit_byte(c, 0xc3)
    c
}

// Emit inline print of a string literal: embeds bytes in code, emits sys_write
// str_buf/str_len = the string literal content from AST Name field
fn ast_emit_inline_print_str(code: CodeBuffer, str_buf: [i8; 128], str_len: i64) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    // jmp over string data
    let jmp_site = c.len
    c = emit_byte(c, 0xeb); c = emit_byte(c, 0x00) // placeholder disp8

    // Embed string bytes
    let str_start = c.len
    var si: i64 = 0
    while si < str_len {
        c = emit_byte(c, str_buf[si as usize] as i64)
        si = si + 1
    }

    // Patch jmp disp8
    let jmp_disp = c.len - (jmp_site + 2)
    c.bytes[(jmp_site + 1) as usize] = (jmp_disp & 0xFF) as i8

    // lea rsi, [rip - (current - str_start)]
    // The string is at str_start in the code buffer. At runtime, we need its VA.
    // RIP-relative: [rip + disp32] where rip = address after this instruction
    // lea rsi, [rip + disp32]: 48 8d 35 <disp32>
    let lea_pos = c.len
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x35)
    // disp32 = str_start - (lea_pos + 7)  (7 = size of LEA instruction)
    let lea_disp = str_start - (lea_pos + 7)
    c = emit_byte(c, lea_disp & 0xFF)
    c = emit_byte(c, (lea_disp >> 8) & 0xFF)
    c = emit_byte(c, (lea_disp >> 16) & 0xFF)
    c = emit_byte(c, (lea_disp >> 24) & 0xFF)

    // mov edx, str_len  (len for sys_write)
    c = emit_byte(c, 0xba)
    c = emit_byte(c, str_len & 0xFF)
    c = emit_byte(c, (str_len >> 8) & 0xFF)
    c = emit_byte(c, (str_len >> 16) & 0xFF)
    c = emit_byte(c, (str_len >> 24) & 0xFF)

    // mov edi, 1  (fd = stdout)
    c = emit_byte(c, 0xbf); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)

    // mov eax, 1  (sys_write)
    c = emit_byte(c, 0xb8); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)

    // syscall
    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x05)

    c
}

// ============================================================================
// find_eigenform(op_addr, initial, tolerance, max_iter) → f64
//
// Banach fixed-point iteration: x* where Op(x*) = x*.
// Native x86-64 builtin for cybernetic eigenform computation.
//
// ABI (lean driver convention — all args as i64 bit patterns):
//   rdi = op_addr  (absolute code address of fn(f64)->f64)
//   rsi = initial  (f64 bit pattern)
//   rdx = tolerance (f64 bit pattern)
//   rcx = max_iter (i64)
//   Return: rax = eigenform value (f64 bit pattern)
//
// Uses callee-saved r12 (op_addr), r13 (max_iter), r14 (counter).
// Calls op(x) via CALL r12 with x passed in rdi as bit pattern.
// ============================================================================
fn ast_emit_find_eigenform_builtin(code: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var c = code

    // ---- PROLOGUE ----
    c = emit_byte(c, 0x55)                                                      // push rbp
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xe5)     // mov rbp, rsp
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x83); c = emit_byte(c, 0xec); c = emit_byte(c, 0x30) // sub rsp, 48

    // Save callee-saved registers
    c = emit_byte(c, 0x53)                            // push rbx
    c = emit_byte(c, 0x41); c = emit_byte(c, 0x54)   // push r12
    c = emit_byte(c, 0x41); c = emit_byte(c, 0x55)   // push r13
    c = emit_byte(c, 0x41); c = emit_byte(c, 0x56)   // push r14

    // ---- SETUP: save arguments ----
    // r12 = op function address
    c = emit_byte(c, 0x49); c = emit_byte(c, 0x89); c = emit_byte(c, 0xFC)     // mov r12, rdi

    // Convert initial from i64 bit pattern → f64, store at [rbp-8]
    c = emit_byte(c, 0x66); c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f)
    c = emit_byte(c, 0x6e); c = emit_byte(c, 0xC6)                             // movq xmm0, rsi
    c = emit_byte(c, 0xF2); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x11)
    c = emit_byte(c, 0x45); c = emit_byte(c, 0xF8)                             // movsd [rbp-8], xmm0

    // Convert tolerance from i64 bit pattern → f64, store at [rbp-16]
    c = emit_byte(c, 0x66); c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f)
    c = emit_byte(c, 0x6e); c = emit_byte(c, 0xC2)                             // movq xmm0, rdx
    c = emit_byte(c, 0xF2); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x11)
    c = emit_byte(c, 0x45); c = emit_byte(c, 0xF0)                             // movsd [rbp-16], xmm0

    // r13 = max_iter
    c = emit_byte(c, 0x49); c = emit_byte(c, 0x89); c = emit_byte(c, 0xCD)     // mov r13, rcx
    // r14 = 0 (iteration counter)
    c = emit_byte(c, 0x45); c = emit_byte(c, 0x31); c = emit_byte(c, 0xF6)     // xor r14d, r14d

    // ---- LOOP START ----
    let loop_start = c.len

    // Check: i >= max_iter → done
    c = emit_byte(c, 0x4D); c = emit_byte(c, 0x39); c = emit_byte(c, 0xEE)     // cmp r14, r13
    let jge_site = c.len
    c = emit_byte(c, 0x7D); c = emit_byte(c, 0x00)                             // jge return_x (patch)

    // Call op(x): load x from [rbp-8], pass as bit pattern in rdi
    c = emit_byte(c, 0xF2); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x10)
    c = emit_byte(c, 0x45); c = emit_byte(c, 0xF8)                             // movsd xmm0, [rbp-8]
    c = emit_byte(c, 0x66); c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f)
    c = emit_byte(c, 0x7e); c = emit_byte(c, 0xC7)                             // movq rdi, xmm0
    c = emit_byte(c, 0x41); c = emit_byte(c, 0xFF); c = emit_byte(c, 0xD4)     // call r12

    // rax = op(x) as bit pattern → convert to xmm1
    c = emit_byte(c, 0x66); c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f)
    c = emit_byte(c, 0x6e); c = emit_byte(c, 0xC8)                             // movq xmm1, rax
    // Save new_x at [rbp-24]
    c = emit_byte(c, 0xF2); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x11)
    c = emit_byte(c, 0x4D); c = emit_byte(c, 0xE8)                             // movsd [rbp-24], xmm1

    // Compute diff = new_x - x
    c = emit_byte(c, 0xF2); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x10)
    c = emit_byte(c, 0x45); c = emit_byte(c, 0xF8)                             // movsd xmm0, [rbp-8]
    c = emit_byte(c, 0xF2); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x5C)
    c = emit_byte(c, 0xC8)                                                      // subsd xmm1, xmm0

    // Absolute value: clear sign bit via AND with 0x7FFFFFFFFFFFFFFF
    c = emit_byte(c, 0x66); c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f)
    c = emit_byte(c, 0x7e); c = emit_byte(c, 0xC8)                             // movq rax, xmm1
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xBB)                             // mov rbx, imm64
    c = emit_byte(c, 0xFF); c = emit_byte(c, 0xFF); c = emit_byte(c, 0xFF); c = emit_byte(c, 0xFF)
    c = emit_byte(c, 0xFF); c = emit_byte(c, 0xFF); c = emit_byte(c, 0xFF); c = emit_byte(c, 0x7F) // 0x7FFFFFFFFFFFFFFF
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x21); c = emit_byte(c, 0xD8)     // and rax, rbx
    c = emit_byte(c, 0x66); c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f)
    c = emit_byte(c, 0x6e); c = emit_byte(c, 0xC8)                             // movq xmm1, rax

    // Update x := new_x (before convergence check)
    c = emit_byte(c, 0xF2); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x10)
    c = emit_byte(c, 0x45); c = emit_byte(c, 0xE8)                             // movsd xmm0, [rbp-24]
    c = emit_byte(c, 0xF2); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x11)
    c = emit_byte(c, 0x45); c = emit_byte(c, 0xF8)                             // movsd [rbp-8], xmm0

    // Compare |diff| <= tolerance
    c = emit_byte(c, 0x66); c = emit_byte(c, 0x0F); c = emit_byte(c, 0x2E)
    c = emit_byte(c, 0x4D); c = emit_byte(c, 0xF0)                             // ucomisd xmm1, [rbp-16]
    let jbe_site = c.len
    c = emit_byte(c, 0x76); c = emit_byte(c, 0x00)                             // jbe return_x (patch)

    // i++
    c = emit_byte(c, 0x49); c = emit_byte(c, 0xFF); c = emit_byte(c, 0xC6)     // inc r14

    // jmp loop_start
    let jmp_back_site = c.len
    let back_disp = loop_start - (jmp_back_site + 2)
    c = emit_byte(c, 0xEB); c = emit_byte(c, back_disp & 0xFF)                 // jmp loop_start

    // ---- RETURN: x is in [rbp-8], return as bit pattern in rax ----
    let return_pos = c.len

    c = emit_byte(c, 0xF2); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x10)
    c = emit_byte(c, 0x45); c = emit_byte(c, 0xF8)                             // movsd xmm0, [rbp-8]
    c = emit_byte(c, 0x66); c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f)
    c = emit_byte(c, 0x7e); c = emit_byte(c, 0xC0)                             // movq rax, xmm0

    // Restore callee-saved registers (reverse order)
    c = emit_byte(c, 0x41); c = emit_byte(c, 0x5E)   // pop r14
    c = emit_byte(c, 0x41); c = emit_byte(c, 0x5D)   // pop r13
    c = emit_byte(c, 0x41); c = emit_byte(c, 0x5C)   // pop r12
    c = emit_byte(c, 0x5B)                            // pop rbx

    // leave + ret
    c = emit_byte(c, 0xC9)                            // leave
    c = emit_byte(c, 0xC3)                            // ret

    // ---- PATCH forward jumps ----
    c.bytes[(jge_site + 1) as usize] = ((return_pos - (jge_site + 2)) & 0xFF) as i8
    c.bytes[(jbe_site + 1) as usize] = ((return_pos - (jbe_site + 2)) & 0xFF) as i8

    c
}

// ============================================================================
// Struct registry context for AST-direct compiler
// ============================================================================

struct AstCompileCtx {
    struct_count: i64,
    struct_names: [Name; 128],
    struct_flat_size: [i64; 128],
    struct_field_count: [i64; 128],
    struct_field_base: [i64; 128],
    sf_names: [Name; 512],
    sf_flat_offset: [i64; 512],
    sf_type: [i64; 512],       // 0=i64, 1=f64, 10+=struct_idx+10
    sf_flat_size: [i64; 512],  // 1 for scalars, N for sub-structs
    fn_return_types: [i64; 512],
    fn_names: [Name; 512],
    fn_count: i64,
    // Per-function sret state (set before compiling each function body)
    cur_sret: i64,           // 1 if current function uses sret, 0 otherwise
    cur_sret_dest_slot: i64, // slot holding the sret destination pointer
    cur_sret_flat_size: i64, // flat size of the return struct
    // Enum variant registry (Phase 0 scanned)
    enum_variant_names: [Name; 512],
    enum_variant_disc: [i64; 512],
    enum_variant_count: i64,
}

// Sret dest slot stored in CodeBuffer metadata at bytes [65526..65527]
fn code_get_sret_slot(c: CodeBuffer) -> i64 with Mut, Panic {
    let b0 = (c.bytes[65526 as usize] as i64) & 0xFF
    let b1 = (c.bytes[65527 as usize] as i64) & 0xFF
    b0 | (b1 << 8)
}

fn code_set_sret_slot(c: CodeBuffer, slot: i64) -> CodeBuffer with Mut, Panic {
    var r = c
    r.bytes[65526 as usize] = (slot & 0xFF) as i8
    r.bytes[65527 as usize] = ((slot >> 8) & 0xFF) as i8
    r
}

fn code_get_ns(c: CodeBuffer) -> i64 with Mut, Panic {
    let b0 = (c.bytes[65530 as usize] as i64) & 0xFF
    let b1 = (c.bytes[65531 as usize] as i64) & 0xFF
    b0 | (b1 << 8)
}

fn code_set_ns(c: CodeBuffer, ns: i64) -> CodeBuffer with Mut, Panic {
    var r = c
    r.bytes[65530 as usize] = (ns & 0xFF) as i8
    r.bytes[65531 as usize] = ((ns >> 8) & 0xFF) as i8
    r
}

// Loop context stack in high bytes [65400..65529]
// bytes[65529] = current loop level (-1=none, 0,1,2 = nesting)
// Per level, 64 bytes starting at base = 65400 + level*64 (but only 3 levels: 0,1,2)
//   +0..3 = loop_top (continue target, i32)
//   +4..5 = break_count (u16)
//   +8..n = break_patches[i] (i32 each, up to 13 patches)
// Returns -1 when no loop is active (0xFF byte = 255 = -1 when sign-extended)
fn lctx_level(c: CodeBuffer) -> i64 with Mut, Panic {
    let raw = (c.bytes[65529 as usize] as i64) & 0xFF
    if raw == 255 { -1 } else { raw }
}
fn lctx_set_level(c: CodeBuffer, v: i64) -> CodeBuffer with Mut, Panic {
    var r = c
    // -1 stored as 0xFF
    if v < 0 { r.bytes[65529 as usize] = (0xFF as i8) } else { r.bytes[65529 as usize] = v as i8 }
    r
}
fn lctx_base(level: i64) -> i64 {
    65400 + level * 64
}
fn lctx_get_top(c: CodeBuffer, level: i64) -> i64 with Mut, Panic {
    let b = lctx_base(level)
    ((c.bytes[b as usize] as i64) & 0xFF) |
    (((c.bytes[(b+1) as usize] as i64) & 0xFF) << 8) |
    (((c.bytes[(b+2) as usize] as i64) & 0xFF) << 16) |
    (((c.bytes[(b+3) as usize] as i64) & 0xFF) << 24)
}
fn lctx_set_top(c: CodeBuffer, level: i64, v: i64) -> CodeBuffer with Mut, Panic {
    var r = c
    let b = lctx_base(level)
    r.bytes[b as usize] = (v & 0xFF) as i8
    r.bytes[(b+1) as usize] = ((v >> 8) & 0xFF) as i8
    r.bytes[(b+2) as usize] = ((v >> 16) & 0xFF) as i8
    r.bytes[(b+3) as usize] = ((v >> 24) & 0xFF) as i8
    r
}
fn lctx_get_break_count(c: CodeBuffer, level: i64) -> i64 with Mut, Panic {
    let b = lctx_base(level) + 4
    ((c.bytes[b as usize] as i64) & 0xFF) |
    (((c.bytes[(b+1) as usize] as i64) & 0xFF) << 8)
}
fn lctx_set_break_count(c: CodeBuffer, level: i64, v: i64) -> CodeBuffer with Mut, Panic {
    var r = c
    let b = lctx_base(level) + 4
    r.bytes[b as usize] = (v & 0xFF) as i8
    r.bytes[(b+1) as usize] = ((v >> 8) & 0xFF) as i8
    r
}
fn lctx_get_break_patch(c: CodeBuffer, level: i64, i: i64) -> i64 with Mut, Panic {
    let b = lctx_base(level) + 8 + (i * 4)
    ((c.bytes[b as usize] as i64) & 0xFF) |
    (((c.bytes[(b+1) as usize] as i64) & 0xFF) << 8) |
    (((c.bytes[(b+2) as usize] as i64) & 0xFF) << 16) |
    (((c.bytes[(b+3) as usize] as i64) & 0xFF) << 24)
}
fn lctx_set_break_patch(c: CodeBuffer, level: i64, i: i64, v: i64) -> CodeBuffer with Mut, Panic {
    var r = c
    let b = lctx_base(level) + 8 + (i * 4)
    r.bytes[b as usize] = (v & 0xFF) as i8
    r.bytes[(b+1) as usize] = ((v >> 8) & 0xFF) as i8
    r.bytes[(b+2) as usize] = ((v >> 16) & 0xFF) as i8
    r.bytes[(b+3) as usize] = ((v >> 24) & 0xFF) as i8
    r
}

fn micro_lea_rax_slot(code: CodeBuffer, slot: i64) -> CodeBuffer with Mut, Panic, Div {
    // lea rax, [rbp - 8*(slot+1)]
    var c = code
    let disp = 0 - ((slot + 1) * 8)
    c = emit_byte(c, 0x48)
    c = emit_byte(c, 0x8d)
    c = emit_byte(c, 0x85)
    c = emit_byte(c, disp & 0xFF)
    c = emit_byte(c, (disp >> 8) & 0xFF)
    c = emit_byte(c, (disp >> 16) & 0xFF)
    c = emit_byte(c, (disp >> 24) & 0xFF)
    c
}

// Emit mov rax, imm64 — 48 B8 <8 bytes LE>
fn emit_mov_rax_imm64(code: CodeBuffer, val: i64) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xB8)
    c = emit_byte(c, val & 0xFF)
    c = emit_byte(c, (val >> 8) & 0xFF)
    c = emit_byte(c, (val >> 16) & 0xFF)
    c = emit_byte(c, (val >> 24) & 0xFF)
    c = emit_byte(c, (val >> 32) & 0xFF)
    c = emit_byte(c, (val >> 40) & 0xFF)
    c = emit_byte(c, (val >> 48) & 0xFF)
    c = emit_byte(c, (val >> 56) & 0xFF)
    c
}

// Emit mov rcx, imm64 — 48 B9 <8 bytes LE>
fn emit_mov_rcx_imm64(code: CodeBuffer, val: i64) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xB9)
    c = emit_byte(c, val & 0xFF)
    c = emit_byte(c, (val >> 8) & 0xFF)
    c = emit_byte(c, (val >> 16) & 0xFF)
    c = emit_byte(c, (val >> 24) & 0xFF)
    c = emit_byte(c, (val >> 32) & 0xFF)
    c = emit_byte(c, (val >> 40) & 0xFF)
    c = emit_byte(c, (val >> 48) & 0xFF)
    c = emit_byte(c, (val >> 56) & 0xFF)
    c
}

// Emit code to load global base address into rax: mov rax, imm64(GLOBAL_BASE_ABS); mov rax, [rax]
fn emit_load_global_base(code: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    c = emit_mov_rax_imm64(c, GLOBAL_BASE_ABS)
    // mov rax, [rax]
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8b); c = emit_byte(c, 0x00)
    c
}

// Lookup global by name, return index or -1
fn global_lookup(name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < GLOBAL_COUNT {
        if ir_name_eq(GLOBAL_NAMES[i as usize], name) { return i }
        i = i + 1
    }
    -1
}

// Emit code to read a scalar global into rax
// global_idx identifies which global
fn emit_global_scalar_read(code: CodeBuffer, global_idx: i64) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    c = emit_load_global_base(c)
    let off = GLOBAL_OFFSETS[global_idx as usize]
    if off > 0 {
        // add rax, imm32
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x05)
        c = emit_byte(c, off & 0xFF); c = emit_byte(c, (off >> 8) & 0xFF)
        c = emit_byte(c, (off >> 16) & 0xFF); c = emit_byte(c, (off >> 24) & 0xFF)
    }
    // mov rax, [rax]
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8b); c = emit_byte(c, 0x00)
    c
}

// Emit code to store rax to a scalar global (assumes value in rax)
// Clobbers rcx
fn emit_global_scalar_write(code: CodeBuffer, global_idx: i64) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    // Save value in rcx
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc1) // mov rcx, rax
    c = emit_load_global_base(c)
    let off = GLOBAL_OFFSETS[global_idx as usize]
    if off > 0 {
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x05)
        c = emit_byte(c, off & 0xFF); c = emit_byte(c, (off >> 8) & 0xFF)
        c = emit_byte(c, (off >> 16) & 0xFF); c = emit_byte(c, (off >> 24) & 0xFF)
    }
    // mov [rax], rcx
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0x08)
    c
}

// Emit code to get address of global array element for READ
// Index is in rax on entry. Result address in rax.
fn emit_global_array_addr(code: CodeBuffer, global_idx: i64) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    let elem_sz = GLOBAL_ELEM_SIZES[global_idx as usize]
    // Save index to rcx
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc1) // mov rcx, rax
    c = emit_load_global_base(c)
    let off = GLOBAL_OFFSETS[global_idx as usize]
    if off > 0 {
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x05)
        c = emit_byte(c, off & 0xFF); c = emit_byte(c, (off >> 8) & 0xFF)
        c = emit_byte(c, (off >> 16) & 0xFF); c = emit_byte(c, (off >> 24) & 0xFF)
    }
    // rax = base + offset, rcx = index
    if elem_sz == 8 {
        // lea rax, [rax + rcx*8]
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x04); c = emit_byte(c, 0xc8)
    } else {
        // elem_sz == 1: add rax, rcx
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x01); c = emit_byte(c, 0xc8)
    }
    c
}

// Scan source bytes to collect global variable declarations.
// Looks for lines starting with "var NAME: TYPE"
// Populates GLOBAL_NAMES, GLOBAL_OFFSETS, GLOBAL_SIZES, GLOBAL_ELEM_SIZES, GLOBAL_COUNT, GLOBAL_TOTAL_SIZE
fn scan_byte(buf: [i8; 1048576], pos: i64) -> i64 with Mut, Panic {
    (buf[pos as usize] as i64) & 0xFF
}

// Tiny function: populate LEAN_SOURCE from read_file result (keeps frame small)
fn populate_lean_source(path: string) with IO, Mut, Panic, Div {
    let raw = read_file(path)
    let src_size = file_size(path)
    var csi: i64 = 0
    while csi < src_size {
        LEAN_SOURCE[csi as usize] = raw[csi as usize]
        csi = csi + 1
    }
    LEAN_SOURCE_LEN = src_size
}


// ============================================================================
// Import resolution: scan LEAN_SOURCE for `use` lines, read imported files,
// append content to LEAN_SOURCE. Handles transitive imports and dedup.
// ============================================================================

fn imp_src_byte(idx: i64) -> i8 with Panic {
    if idx >= 0 && idx < LEAN_SOURCE_LEN { LEAN_SOURCE[idx as usize] } else { 0 as i8 }
}

fn mc_imp_init_base_dir(path: string) with IO, Mut, Panic, Div {
    let plen = str_len(path)
    var last_slash: i64 = -1
    var i: i64 = 0
    while i < plen && i < 510 {
        let c = str_char_at(path, i)
        if c == 47 { last_slash = i }
        i = i + 1
    }
    if last_slash >= 0 {
        var j: i64 = 0
        while j <= last_slash && j < 510 {
            MC_IMP_BASE_DIR[j as usize] = str_char_at(path, j) as i8
            j = j + 1
        }
        MC_IMP_BASE_DIR_LEN = last_slash + 1
    } else {
        MC_IMP_BASE_DIR_LEN = 0
    }
}

fn mc_imp_build_fname(path_start: i64, path_len: i64) -> i64 with IO, Mut, Panic, Div {
    var bi: i64 = 0
    var seg_end: i64 = 0
    while seg_end < path_len {
        if imp_src_byte(path_start + seg_end) as i64 == 58 { break }
        seg_end = seg_end + 1
    }
    var is_self_hosted = false
    if seg_end == 11 {
        if imp_src_byte(path_start) as i64 == 115 && imp_src_byte(path_start + 1) as i64 == 101 && imp_src_byte(path_start + 2) as i64 == 108 && imp_src_byte(path_start + 3) as i64 == 102 { is_self_hosted = true }
    }
    var is_stdlib = false
    if seg_end == 6 {
        if imp_src_byte(path_start) as i64 == 115 && imp_src_byte(path_start + 1) as i64 == 116 && imp_src_byte(path_start + 2) as i64 == 100 && imp_src_byte(path_start + 3) as i64 == 108 && imp_src_byte(path_start + 4) as i64 == 105 && imp_src_byte(path_start + 5) as i64 == 98 { is_stdlib = true }
    }
    if is_self_hosted {
        MC_IMP_FNAME[0 as usize] = 115 as i8; MC_IMP_FNAME[1 as usize] = 101 as i8; MC_IMP_FNAME[2 as usize] = 108 as i8; MC_IMP_FNAME[3 as usize] = 102 as i8
        MC_IMP_FNAME[4 as usize] = 45 as i8; MC_IMP_FNAME[5 as usize] = 104 as i8; MC_IMP_FNAME[6 as usize] = 111 as i8; MC_IMP_FNAME[7 as usize] = 115 as i8
        MC_IMP_FNAME[8 as usize] = 116 as i8; MC_IMP_FNAME[9 as usize] = 101 as i8; MC_IMP_FNAME[10 as usize] = 100 as i8; MC_IMP_FNAME[11 as usize] = 47 as i8
        bi = 12
        var pi: i64 = seg_end
        if pi + 1 < path_len && imp_src_byte(path_start + pi) as i64 == 58 && imp_src_byte(path_start + pi + 1) as i64 == 58 { pi = pi + 2 }
        while pi < path_len && bi < 500 {
            let c = imp_src_byte(path_start + pi) as i64
            if c == 58 && pi + 1 < path_len && imp_src_byte(path_start + pi + 1) as i64 == 58 {
                if pi + 2 >= path_len { break }
                let af = imp_src_byte(path_start + pi + 2) as i64
                if af == 42 || af == 123 { break }
                MC_IMP_FNAME[bi as usize] = 47 as i8; bi = bi + 1; pi = pi + 2
            } else if c == 32 || c == 9 || c == 10 || c == 13 || c == 59 || c == 123 { break
            } else { MC_IMP_FNAME[bi as usize] = c as i8; bi = bi + 1; pi = pi + 1 }
        }
    } else if is_stdlib {
        MC_IMP_FNAME[0 as usize] = 115 as i8; MC_IMP_FNAME[1 as usize] = 116 as i8; MC_IMP_FNAME[2 as usize] = 100 as i8; MC_IMP_FNAME[3 as usize] = 108 as i8
        MC_IMP_FNAME[4 as usize] = 105 as i8; MC_IMP_FNAME[5 as usize] = 98 as i8; MC_IMP_FNAME[6 as usize] = 47 as i8
        bi = 7
        var pi2: i64 = seg_end
        if pi2 + 1 < path_len && imp_src_byte(path_start + pi2) as i64 == 58 && imp_src_byte(path_start + pi2 + 1) as i64 == 58 { pi2 = pi2 + 2 }
        while pi2 < path_len && bi < 500 {
            let c2 = imp_src_byte(path_start + pi2) as i64
            if c2 == 58 && pi2 + 1 < path_len && imp_src_byte(path_start + pi2 + 1) as i64 == 58 {
                if pi2 + 2 >= path_len { break }
                let af2 = imp_src_byte(path_start + pi2 + 2) as i64
                if af2 == 42 || af2 == 123 { break }
                MC_IMP_FNAME[bi as usize] = 47 as i8; bi = bi + 1; pi2 = pi2 + 2
            } else if c2 == 32 || c2 == 9 || c2 == 10 || c2 == 13 || c2 == 59 || c2 == 123 { break
            } else { MC_IMP_FNAME[bi as usize] = c2 as i8; bi = bi + 1; pi2 = pi2 + 1 }
        }
    } else {
        var di: i64 = 0
        while di < MC_IMP_BASE_DIR_LEN && bi < 500 { MC_IMP_FNAME[bi as usize] = MC_IMP_BASE_DIR[di as usize]; bi = bi + 1; di = di + 1 }
        var pi3: i64 = 0
        while pi3 < path_len && bi < 500 {
            let c3 = imp_src_byte(path_start + pi3) as i64
            if c3 == 58 && pi3 + 1 < path_len && imp_src_byte(path_start + pi3 + 1) as i64 == 58 {
                if pi3 + 2 >= path_len { break }
                let af3 = imp_src_byte(path_start + pi3 + 2) as i64
                if af3 == 42 || af3 == 123 { break }
                MC_IMP_FNAME[bi as usize] = 47 as i8; bi = bi + 1; pi3 = pi3 + 2
            } else if c3 == 32 || c3 == 9 || c3 == 10 || c3 == 13 || c3 == 59 || c3 == 123 { break
            } else { MC_IMP_FNAME[bi as usize] = c3 as i8; bi = bi + 1; pi3 = pi3 + 1 }
        }
    }
    MC_IMP_FNAME[bi as usize] = 46 as i8; bi = bi + 1
    MC_IMP_FNAME[bi as usize] = 115 as i8; bi = bi + 1
    MC_IMP_FNAME[bi as usize] = 105 as i8; bi = bi + 1
    MC_IMP_FNAME[bi as usize] = 111 as i8; bi = bi + 1
    MC_IMP_FNAME[bi as usize] = 0 as i8
    bi
}

fn mc_imp_already_loaded(fname_len: i64) -> bool with Mut, Panic {
    var ci: i64 = 0
    while ci < MC_IMP_COUNT {
        let poff = MC_IMP_PATH_OFF[ci as usize]
        let plen = MC_IMP_PATH_LEN[ci as usize]
        if plen == fname_len {
            var same: i64 = 1
            var mi: i64 = 0
            while mi < fname_len {
                if MC_IMP_PATH_BUF[(poff + mi) as usize] != MC_IMP_FNAME[mi as usize] { same = 0 }
                mi = mi + 1
            }
            if same == 1 { return true }
        }
        ci = ci + 1
    }
    false
}

fn mc_imp_record_loaded(fname_len: i64) with Mut, Panic {
    if MC_IMP_COUNT >= 128 { return }
    if MC_IMP_PATH_BUF_POS + fname_len >= 8192 { return }
    let pstart = MC_IMP_PATH_BUF_POS
    var i: i64 = 0
    while i < fname_len { MC_IMP_PATH_BUF[(pstart + i) as usize] = MC_IMP_FNAME[i as usize]; i = i + 1 }
    MC_IMP_PATH_OFF[MC_IMP_COUNT as usize] = pstart
    MC_IMP_PATH_LEN[MC_IMP_COUNT as usize] = fname_len
    MC_IMP_COUNT = MC_IMP_COUNT + 1
    MC_IMP_PATH_BUF_POS = MC_IMP_PATH_BUF_POS + fname_len
}

fn mc_imp_append_file(fname_len: i64) with IO, Mut, Panic, Div {
    // Copy MC_IMP_FNAME into a local buffer for str_from_bytes
    // (boot4 cannot pass global [i8;N] arrays as function arguments directly)
    var local_fname: [i8; 512] = [0 as i8; 512]
    var cfi: i64 = 0
    while cfi < fname_len && cfi < 511 {
        local_fname[cfi as usize] = MC_IMP_FNAME[cfi as usize]
        cfi = cfi + 1
    }
    local_fname[fname_len as usize] = 0 as i8
    let fpath = str_from_bytes(local_fname, fname_len)
    let fsz = file_size(fpath)
    if fsz <= 0 {
        print("  import: file not found: ")
        print(fpath)
        print("\n")
        return
    }
    let fraw = read_file(fpath)
    if LEAN_SOURCE_LEN > 0 && LEAN_SOURCE_LEN < 1048576 {
        LEAN_SOURCE[LEAN_SOURCE_LEN as usize] = 10 as i8
        LEAN_SOURCE_LEN = LEAN_SOURCE_LEN + 1
    }
    var ci: i64 = 0
    while ci < fsz && LEAN_SOURCE_LEN < 1048576 {
        LEAN_SOURCE[LEAN_SOURCE_LEN as usize] = fraw[ci as usize]
        LEAN_SOURCE_LEN = LEAN_SOURCE_LEN + 1
        ci = ci + 1
    }
    print("  import: ")
    print(fpath)
    print(" (+")
    print_int(fsz)
    print(" bytes, total=")
    print_int(LEAN_SOURCE_LEN)
    print(")\n")
}

fn mc_resolve_imports() with IO, Mut, Panic, Div {
    MC_IMP_COUNT = 0
    MC_IMP_PATH_BUF_POS = 0
    var pos: i64 = 0
    while pos < LEAN_SOURCE_LEN {
        let c = imp_src_byte(pos) as i64
        if c == 117 {
            var at_line_start: i64 = 0
            if pos == 0 { at_line_start = 1 }
            else if imp_src_byte(pos - 1) as i64 == 10 { at_line_start = 1 }
            if at_line_start == 1 && pos + 4 <= LEAN_SOURCE_LEN {
                let c1 = imp_src_byte(pos + 1) as i64
                let c2 = imp_src_byte(pos + 2) as i64
                let c3 = imp_src_byte(pos + 3) as i64
                if c1 == 115 && c2 == 101 && (c3 == 32 || c3 == 9) {
                    var p2: i64 = pos + 4
                    while p2 < LEAN_SOURCE_LEN && (imp_src_byte(p2) as i64 == 32 || imp_src_byte(p2) as i64 == 9) { p2 = p2 + 1 }
                    let path_start = p2
                    while p2 < LEAN_SOURCE_LEN {
                        let cc = imp_src_byte(p2) as i64
                        if cc == 10 || cc == 59 { break }
                        p2 = p2 + 1
                    }
                    let path_len = p2 - path_start
                    if path_len > 0 && path_len < 480 {
                        let fname_len = mc_imp_build_fname(path_start, path_len)
                        if !mc_imp_already_loaded(fname_len) {
                            mc_imp_record_loaded(fname_len)
                            mc_imp_append_file(fname_len)
                        }
                    }
                }
            }
        }
        pos = pos + 1
    }
}

fn mc_scan_lean_globals(start: i64, end: i64) with IO, Mut, Panic, Div {
    var pos: i64 = start
    while pos < end - 4 {
        var at_line_start = false
        if pos == 0 { at_line_start = true }
        else if (imp_src_byte(pos - 1) as i64) == 10 { at_line_start = true }
        if at_line_start && (imp_src_byte(pos) as i64) == 118 && (imp_src_byte(pos + 1) as i64) == 97 && (imp_src_byte(pos + 2) as i64) == 114 && (imp_src_byte(pos + 3) as i64) == 32 {
            var np = pos + 4
            while np < end && (imp_src_byte(np) as i64) == 32 { np = np + 1 }
            var name_start = np
            while np < end && (imp_src_byte(np) as i64) != 58 && (imp_src_byte(np) as i64) != 32 && (imp_src_byte(np) as i64) != 10 { np = np + 1 }
            var name_len = np - name_start
            if name_len > 0 && name_len < 128 && GLOBAL_COUNT < 256 {
                var gn = ir_empty_name()
                var ni: i64 = 0
                while ni < name_len && ni < 128 { gn.buf[ni as usize] = LEAN_SOURCE[(name_start + ni) as usize]; ni = ni + 1 }
                gn.len = name_len
                while np < end && (imp_src_byte(np) as i64) == 32 { np = np + 1 }
                if np < end && (imp_src_byte(np) as i64) == 58 {
                    np = np + 1
                    while np < end && (imp_src_byte(np) as i64) == 32 { np = np + 1 }
                    var elem_size: i64 = 8
                    var total_size: i64 = 8
                    var is_f64_elem: i64 = 0
                    if np + 2 < end && (imp_src_byte(np) as i64) == 102 && (imp_src_byte(np + 1) as i64) == 54 && (imp_src_byte(np + 2) as i64) == 52 { is_f64_elem = 1 }
                    if np < end && (imp_src_byte(np) as i64) == 91 {
                        np = np + 1
                        while np < end && (imp_src_byte(np) as i64) == 32 { np = np + 1 }
                        if np + 1 < end && (imp_src_byte(np) as i64) == 105 && (imp_src_byte(np + 1) as i64) == 56 { elem_size = 1 }
                        if np + 2 < end && (imp_src_byte(np) as i64) == 102 && (imp_src_byte(np + 1) as i64) == 54 && (imp_src_byte(np + 2) as i64) == 52 { is_f64_elem = 1 }
                        while np < end && (imp_src_byte(np) as i64) != 59 { np = np + 1 }
                        if np < end { np = np + 1 }
                        while np < end && (imp_src_byte(np) as i64) == 32 { np = np + 1 }
                        var arr_size: i64 = 0
                        while np < end && (imp_src_byte(np) as i64) >= 48 && (imp_src_byte(np) as i64) <= 57 { arr_size = arr_size * 10 + ((imp_src_byte(np) as i64) - 48); np = np + 1 }
                        if arr_size > 0 { total_size = arr_size * elem_size; if total_size <= 8 { total_size = 16 } }
                    }
                    total_size = ((total_size + 7) / 8) * 8
                    let gi = GLOBAL_COUNT
                    GLOBAL_NAMES[gi as usize] = gn
                    GLOBAL_OFFSETS[gi as usize] = GLOBAL_TOTAL_SIZE
                    GLOBAL_SIZES[gi as usize] = total_size
                    GLOBAL_ELEM_SIZES[gi as usize] = elem_size
                    GLOBAL_IS_FLOAT[gi as usize] = is_f64_elem
                    GLOBAL_COUNT = GLOBAL_COUNT + 1
                    GLOBAL_TOTAL_SIZE = GLOBAL_TOTAL_SIZE + total_size
                }
            }
        }
        pos = pos + 1
    }
}

fn scan_source_globals(path: string) with IO, Mut, Panic, Div {
    GLOBAL_COUNT = 0
    GLOBAL_TOTAL_SIZE = 0
    let raw = read_file(path)
    let src_size = file_size(path)
    // Copy source into LEAN_SOURCE for lean_lex_to_parser
    var csi: i64 = 0
    while csi < src_size && csi < 1048576 {
        LEAN_SOURCE[csi as usize] = raw[csi as usize]
        csi = csi + 1
    }
    LEAN_SOURCE_LEN = src_size
    // Resolve imports: scan for `use` lines, read and append imported files
    mc_imp_init_base_dir(path)
    let pre_import_len = LEAN_SOURCE_LEN
    mc_resolve_imports()
    if LEAN_SOURCE_LEN > pre_import_len {
        print("scan_source_globals: imports added ")
        print_int(LEAN_SOURCE_LEN - pre_import_len)
        print(" bytes (")
        print_int(MC_IMP_COUNT)
        print(" files)\n")
    }
    // Scan imported file globals (the main file globals are scanned below from raw)
    if LEAN_SOURCE_LEN > pre_import_len {
        mc_scan_lean_globals(pre_import_len, LEAN_SOURCE_LEN)
    }
    var pos: i64 = 0
    while pos < src_size - 4 {
        // Check for line starting with "var " (v=118, a=97, r=114, space=32)
        var at_line_start = false
        if pos == 0 { at_line_start = true }
        else if scan_byte(raw, pos - 1) == 10 { at_line_start = true }
        if at_line_start && scan_byte(raw, pos) == 118 && scan_byte(raw, pos + 1) == 97 && scan_byte(raw, pos + 2) == 114 && scan_byte(raw, pos + 3) == 32 {
            // Found "var " — extract name
            var np = pos + 4
            while np < src_size && scan_byte(raw, np) == 32 { np = np + 1 }
            var name_start = np
            while np < src_size && scan_byte(raw, np) != 58 && scan_byte(raw, np) != 32 && scan_byte(raw, np) != 10 {
                np = np + 1
            }
            var name_len = np - name_start
            if name_len > 0 && name_len < 128 && GLOBAL_COUNT < 256 {
                var gn = ir_empty_name()
                var ni: i64 = 0
                while ni < name_len && ni < 128 {
                    gn.buf[ni as usize] = raw[(name_start + ni) as usize]
                    ni = ni + 1
                }
                gn.len = name_len
                // Skip to colon
                while np < src_size && scan_byte(raw, np) == 32 { np = np + 1 }
                if np < src_size && scan_byte(raw, np) == 58 {
                    np = np + 1
                    while np < src_size && scan_byte(raw, np) == 32 { np = np + 1 }
                    // Parse type: check for [ (array) or scalar
                    var elem_size: i64 = 8
                    var total_size: i64 = 8
                    var is_f64_elem: i64 = 0
                    // Check for scalar f64 type
                    if np + 2 < src_size && scan_byte(raw, np) == 102 && scan_byte(raw, np + 1) == 54 && scan_byte(raw, np + 2) == 52 {
                        is_f64_elem = 1
                    }
                    if np < src_size && scan_byte(raw, np) == 91 {
                        // Array type: [T; N]
                        np = np + 1
                        while np < src_size && scan_byte(raw, np) == 32 { np = np + 1 }
                        // Check for i8 (105, 56)
                        if np + 1 < src_size && scan_byte(raw, np) == 105 && scan_byte(raw, np + 1) == 56 {
                            elem_size = 1
                        }
                        // Check for f64 (102, 54, 52)
                        if np + 2 < src_size && scan_byte(raw, np) == 102 && scan_byte(raw, np + 1) == 54 && scan_byte(raw, np + 2) == 52 {
                            is_f64_elem = 1
                        }
                        // Skip to semicolon
                        while np < src_size && scan_byte(raw, np) != 59 { np = np + 1 }
                        if np < src_size { np = np + 1 } // skip ;
                        while np < src_size && scan_byte(raw, np) == 32 { np = np + 1 }
                        // Parse array size (digits)
                        var arr_size: i64 = 0
                        while np < src_size && scan_byte(raw, np) >= 48 && scan_byte(raw, np) <= 57 {
                            arr_size = arr_size * 10 + (scan_byte(raw, np) - 48)
                            np = np + 1
                        }
                        if arr_size > 0 {
                            total_size = arr_size * elem_size
                            // Ensure arrays are > 8 bytes to distinguish from scalars
                            if total_size <= 8 { total_size = 16 }
                        }
                    }
                    // Round up to 8 bytes
                    total_size = ((total_size + 7) / 8) * 8
                    let gi = GLOBAL_COUNT
                    GLOBAL_NAMES[gi as usize] = gn
                    GLOBAL_OFFSETS[gi as usize] = GLOBAL_TOTAL_SIZE
                    GLOBAL_SIZES[gi as usize] = total_size
                    GLOBAL_ELEM_SIZES[gi as usize] = elem_size
                    GLOBAL_IS_FLOAT[gi as usize] = is_f64_elem
                    GLOBAL_COUNT = GLOBAL_COUNT + 1
                    GLOBAL_TOTAL_SIZE = GLOBAL_TOTAL_SIZE + total_size
                }
            }
        }
        pos = pos + 1
    }
}

fn ast_lookup_struct(ctx: &AstCompileCtx, name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < ctx.struct_count {
        if ir_name_eq(ctx.struct_names[i as usize], name) { return i }
        i = i + 1
    }
    -1
}

fn ast_lookup_variant(ctx: &AstCompileCtx, variant_name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < ctx.enum_variant_count {
        if ir_name_eq(ctx.enum_variant_names[i as usize], variant_name) {
            return ctx.enum_variant_disc[i as usize]
        }
        i = i + 1
    }
    -1
}

// Walk AstPath to extract the last segment name (for Color::Red → Red)
fn ast_path_last_name_ref(path: &AstPath) -> Name with Mut, Panic, Div {
    let seg: &StringList = &path.segments
    var cur_buf = seg.head_buf
    var cur_len = seg.head_len
    var tail_ref: &Option<Box<StringList>> = &seg.tail
    var done = false
    while !done {
        match *tail_ref {
            Some(rest) => {
                cur_buf = (*rest).head_buf
                cur_len = (*rest).head_len
                tail_ref = &(*rest).tail
            }
            _ => { done = true }
        }
    }
    var nm = ir_empty_name()
    var j: i64 = 0
    while j < cur_len && j < 128 {
        nm.buf[j as usize] = cur_buf[j as usize]
        j = j + 1
    }
    nm.len = cur_len
    nm
}

fn ast_struct_field_info(ctx: &AstCompileCtx, struct_idx: i64, field_name: Name) -> i64 with Mut, Panic, Div {
    let base = ctx.struct_field_base[struct_idx as usize]
    let count = ctx.struct_field_count[struct_idx as usize]
    var i: i64 = 0
    while i < count {
        if ir_name_eq(ctx.sf_names[(base + i) as usize], field_name) {
            return base + i
        }
        i = i + 1
    }
    -1
}

// Returns flat_size of a TypeExpr given already-registered structs.
// i64/bool/ref/string → 1 slot; f64 → 1 slot; array → 1 slot;
// named struct → struct_flat_size; tuple → sum of elements; else → 1
fn ast_type_flat_size(ty: &TypeExpr, ctx: &AstCompileCtx) -> i64 with Mut, Panic, Div {
    if ty.kind == TypeExprKind::TypeTuple {
        var total: i64 = 0
        let targs: &Option<Box<TypeExprList>> = &ty.type_args
        var tcur = targs
        var tdone = false
        while !tdone {
            match *tcur {
                Some(tl) => {
                    let elem_sz = ast_type_flat_size(&(*tl).head, ctx)
                    total = total + elem_sz
                    tcur = &(*tl).tail
                }
                _ => { tdone = true }
            }
        }
        if total == 0 { 1 } else { total }
    } else if ty.kind == TypeExprKind::TypeNamed {
        let nm = ast_name_from_path(&ty.path)
        let si = ast_lookup_struct(ctx, nm)
        if si >= 0 { ctx.struct_flat_size[si as usize] } else { 1 }
    } else { 1 }
}

// Synthesize a tuple (T0, T1) as an anonymous struct in ctx.
// Returns the struct index, or existing index if already registered.
// Name is "__tN_M" where N = flat_size(T0), M = flat_size(T1).
fn ast_ensure_tuple2(ctx: &!AstCompileCtx, te: &TypeExpr) -> i64 with Mut, Panic, Div {
    // Only handle 2-element tuples for now (covers all (Parser, T) patterns)
    let targs: &Option<Box<TypeExprList>> = &te.type_args
    var e0_sz: i64 = 1
    var e1_sz: i64 = 1
    match *targs {
        Some(tl0) => {
            e0_sz = ast_type_flat_size(&(*tl0).head, ctx)
            let targs1: &Option<Box<TypeExprList>> = &(*tl0).tail
            match *targs1 {
                Some(tl1) => {
                    e1_sz = ast_type_flat_size(&(*tl1).head, ctx)
                }
                _ => {}
            }
        }
        _ => {}
    }
    // Build name "__tN_M"
    var tname = ir_empty_name()
    tname.buf[0 as usize] = 95 as i8  // _
    tname.buf[1 as usize] = 95 as i8  // _
    tname.buf[2 as usize] = 116 as i8 // t
    // encode e0_sz as decimal
    var ni: i64 = 3
    var v0 = e0_sz
    if v0 == 0 { tname.buf[ni as usize] = 48 as i8; ni = ni + 1 }
    else {
        var tmp0: [i8; 8] = [0; 8]
        var tc0: i64 = 0
        while v0 > 0 {
            tmp0[tc0 as usize] = (48 + (v0 - (v0 / 10) * 10)) as i8
            v0 = v0 / 10
            tc0 = tc0 + 1
        }
        var ri0 = tc0 - 1
        while ri0 >= 0 {
            tname.buf[ni as usize] = tmp0[ri0 as usize]
            ni = ni + 1
            ri0 = ri0 - 1
        }
    }
    tname.buf[ni as usize] = 95 as i8  // _
    ni = ni + 1
    var v1 = e1_sz
    if v1 == 0 { tname.buf[ni as usize] = 48 as i8; ni = ni + 1 }
    else {
        var tmp1: [i8; 8] = [0; 8]
        var tc1: i64 = 0
        while v1 > 0 {
            tmp1[tc1 as usize] = (48 + (v1 - (v1 / 10) * 10)) as i8
            v1 = v1 / 10
            tc1 = tc1 + 1
        }
        var ri1 = tc1 - 1
        while ri1 >= 0 {
            tname.buf[ni as usize] = tmp1[ri1 as usize]
            ni = ni + 1
            ri1 = ri1 - 1
        }
    }
    tname.len = ni
    // Check if already registered
    let existing = ast_lookup_struct(ctx, tname)
    if existing >= 0 { return existing }
    // Register new tuple struct
    let si = ctx.struct_count
    ctx.struct_names[si as usize] = tname
    ctx.struct_flat_size[si as usize] = e0_sz + e1_sz
    let fb = if si == 0 { 0 } else { ctx.struct_field_base[(si-1) as usize] + ctx.struct_field_count[(si-1) as usize] }
    ctx.struct_field_base[si as usize] = fb
    ctx.struct_field_count[si as usize] = 2
    // Field "0" (first element)
    var f0name = ir_empty_name()
    f0name.buf[0 as usize] = 48 as i8  // '0'
    f0name.len = 1
    ctx.sf_names[fb as usize] = f0name
    ctx.sf_flat_offset[fb as usize] = 0
    ctx.sf_type[fb as usize] = if e0_sz == 1 { 0 } else { 0 }  // simplified: just size matters
    ctx.sf_flat_size[fb as usize] = e0_sz
    // Field "1" (second element)
    var f1name = ir_empty_name()
    f1name.buf[0 as usize] = 49 as i8  // '1'
    f1name.len = 1
    ctx.sf_names[(fb+1) as usize] = f1name
    ctx.sf_flat_offset[(fb+1) as usize] = e0_sz
    ctx.sf_type[(fb+1) as usize] = 0
    ctx.sf_flat_size[(fb+1) as usize] = e1_sz
    ctx.struct_count = si + 1
    si
}

// Read-only lookup: find tuple struct by name without creating it.
// Used in ast_compile_fn_body where ctx is &AstCompileCtx (not &!).
// All tuples must already be registered by the first pass in main().
fn ast_lookup_tuple2_struct(ctx: &AstCompileCtx, te: &TypeExpr) -> i64 with Mut, Panic, Div {
    let targs: &Option<Box<TypeExprList>> = &te.type_args
    var e0_sz: i64 = 1
    var e1_sz: i64 = 1
    match *targs {
        Some(tl0) => {
            e0_sz = ast_type_flat_size(&(*tl0).head, ctx)
            let targs1: &Option<Box<TypeExprList>> = &(*tl0).tail
            match *targs1 {
                Some(tl1) => {
                    e1_sz = ast_type_flat_size(&(*tl1).head, ctx)
                }
                _ => {}
            }
        }
        _ => {}
    }
    // Build name "__tN_M"
    var tname = ir_empty_name()
    tname.buf[0 as usize] = 95 as i8  // _
    tname.buf[1 as usize] = 95 as i8  // _
    tname.buf[2 as usize] = 116 as i8 // t
    var ni: i64 = 3
    var v0 = e0_sz
    if v0 == 0 { tname.buf[ni as usize] = 48 as i8; ni = ni + 1 }
    else {
        var tmp0: [i8; 8] = [0; 8]
        var tc0: i64 = 0
        while v0 > 0 {
            tmp0[tc0 as usize] = (48 + (v0 - (v0 / 10) * 10)) as i8
            v0 = v0 / 10
            tc0 = tc0 + 1
        }
        var ri0 = tc0 - 1
        while ri0 >= 0 {
            tname.buf[ni as usize] = tmp0[ri0 as usize]
            ni = ni + 1
            ri0 = ri0 - 1
        }
    }
    tname.buf[ni as usize] = 95 as i8  // _
    ni = ni + 1
    var v1 = e1_sz
    if v1 == 0 { tname.buf[ni as usize] = 48 as i8; ni = ni + 1 }
    else {
        var tmp1: [i8; 8] = [0; 8]
        var tc1: i64 = 0
        while v1 > 0 {
            tmp1[tc1 as usize] = (48 + (v1 - (v1 / 10) * 10)) as i8
            v1 = v1 / 10
            tc1 = tc1 + 1
        }
        var ri1 = tc1 - 1
        while ri1 >= 0 {
            tname.buf[ni as usize] = tmp1[ri1 as usize]
            ni = ni + 1
            ri1 = ri1 - 1
        }
    }
    tname.len = ni
    ast_lookup_struct(ctx, tname)
}

fn ast_name_from_path(path: &AstPath) -> Name with Mut, Panic, Div {
    let seg: &StringList = &path.segments
    var nm = ir_empty_name()
    var j: i64 = 0
    while j < seg.head_len && j < 128 {
        nm.buf[j as usize] = seg.head_buf[j as usize]
        j = j + 1
    }
    nm.len = seg.head_len
    nm
}

fn ast_emit_mmap(code: CodeBuffer, size_bytes: i64) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    // mov rax, 9 (sys_mmap)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xc7); c = emit_byte(c, 0xc0)
    c = emit_byte(c, 0x09); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    // xor rdi, rdi
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xff)
    // mov rsi, size_bytes (imm64)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xbe)
    c = emit_byte(c, size_bytes & 0xFF)
    c = emit_byte(c, (size_bytes >> 8) & 0xFF)
    c = emit_byte(c, (size_bytes >> 16) & 0xFF)
    c = emit_byte(c, (size_bytes >> 24) & 0xFF)
    c = emit_byte(c, (size_bytes >> 32) & 0xFF)
    c = emit_byte(c, (size_bytes >> 40) & 0xFF)
    c = emit_byte(c, (size_bytes >> 48) & 0xFF)
    c = emit_byte(c, (size_bytes >> 56) & 0xFF)
    // mov rdx, 3 (PROT_READ|PROT_WRITE)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xc7); c = emit_byte(c, 0xc2)
    c = emit_byte(c, 0x03); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    // mov r10, 0x22 (MAP_PRIVATE|MAP_ANONYMOUS)
    c = emit_byte(c, 0x49); c = emit_byte(c, 0xc7); c = emit_byte(c, 0xc2)
    c = emit_byte(c, 0x22); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    // mov r8, -1
    c = emit_byte(c, 0x49); c = emit_byte(c, 0xc7); c = emit_byte(c, 0xc0)
    c = emit_byte(c, 0xff); c = emit_byte(c, 0xff); c = emit_byte(c, 0xff); c = emit_byte(c, 0xff)
    // xor r9, r9
    c = emit_byte(c, 0x4d); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc9)
    // syscall
    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x05)
    c
}

// Determine result type: 0=i64, 1=f64, 10+=struct-on-stack, 100+=struct-pointer
fn ast_expr_result_type(expr: &Expr, local_names: [Name; 512], local_types: [i64; 512], local_count: i64, ctx: &AstCompileCtx) -> i64 with Mut, Panic, Div {
    if expr.kind == ExprKind::ExprFloatLit { return 1 }
    if expr.kind == ExprKind::ExprIntLit || expr.kind == ExprKind::ExprBoolTrue || expr.kind == ExprKind::ExprBoolFalse { return 0 }
    if expr.kind == ExprKind::ExprIdent {
        var li = local_count - 1
        while li >= 0 {
            if ir_name_eq(local_names[li as usize], expr.name) {
                return local_types[li as usize]
            }
            li = li - 1
        }
        return 0
    }
    if expr.kind == ExprKind::ExprCall {
        let co: &Option<Box<Expr>> = &expr.left
        match *co {
            Some(ce) => {
                var li = local_count - 1
                while li >= 0 {
                    if ir_name_eq(local_names[li as usize], (*ce).name) {
                        return local_types[li as usize]
                    }
                    li = li - 1
                }
            }
            _ => {}
        }
        return 0
    }
    if expr.kind == ExprKind::ExprIndex {
        // Check if base is a global f64 array
        let ib2: &Option<Box<Expr>> = &expr.left
        match *ib2 {
            Some(ibe) => {
                if (*ibe).kind == ExprKind::ExprIdent {
                    let gidx2 = global_lookup((*ibe).name)
                    if gidx2 >= 0 && GLOBAL_IS_FLOAT[gidx2 as usize] == 1 {
                        return 1  // f64
                    }
                }
            }
            _ => {}
        }
        return 0
    }
    if expr.kind == ExprKind::ExprMethodCall {
        // Look up method return type by method name
        var mli2 = local_count - 1
        while mli2 >= 0 {
            if ir_name_eq(local_names[mli2 as usize], expr.name) {
                return local_types[mli2 as usize]
            }
            mli2 = mli2 - 1
        }
        return 0
    }
    if expr.kind == ExprKind::ExprStructLit {
        let sn = ast_name_from_path(&expr.path)
        let si = ast_lookup_struct(ctx, sn)
        if si >= 0 { return si + 10 }
        return 0
    }
    if expr.kind == ExprKind::ExprTupleLit {
        // Look up the tuple type by reconstructing element sizes
        let tlt: &Option<Box<ExprList>> = &expr.args
        var e0: i64 = 0
        var e1: i64 = 0
        match *tlt {
            Some(tel0) => {
                let t0 = ast_expr_result_type(&(*tel0).head, local_names, local_types, local_count, ctx)
                if t0 >= 10 && t0 < 100 { e0 = ctx.struct_flat_size[(t0-10) as usize] } else { e0 = 1 }
                let tl1: &Option<Box<ExprList>> = &(*tel0).tail
                match *tl1 {
                    Some(tel1) => {
                        let t1 = ast_expr_result_type(&(*tel1).head, local_names, local_types, local_count, ctx)
                        if t1 >= 10 && t1 < 100 { e1 = ctx.struct_flat_size[(t1-10) as usize] } else { e1 = 1 }
                    }
                    _ => {}
                }
            }
            _ => {}
        }
        // Build name and look up
        var ttname = ir_empty_name()
        ttname.buf[0 as usize] = 95 as i8; ttname.buf[1 as usize] = 95 as i8; ttname.buf[2 as usize] = 116 as i8
        var tni: i64 = 3
        if e0 == 0 { ttname.buf[tni as usize] = 48 as i8; tni = tni + 1 }
        else {
            var tv0 = e0
            var tt0: [i8; 8] = [0; 8]; var ttc0: i64 = 0
            while tv0 > 0 {
                tt0[ttc0 as usize] = (48 + (tv0 - (tv0/10)*10)) as i8
                tv0 = tv0 / 10; ttc0 = ttc0 + 1
            }
            var tri0 = ttc0 - 1
            while tri0 >= 0 { ttname.buf[tni as usize] = tt0[tri0 as usize]; tni = tni + 1; tri0 = tri0 - 1 }
        }
        ttname.buf[tni as usize] = 95 as i8; tni = tni + 1
        if e1 == 0 { ttname.buf[tni as usize] = 48 as i8; tni = tni + 1 }
        else {
            var tv1 = e1
            var tt1: [i8; 8] = [0; 8]; var ttc1: i64 = 0
            while tv1 > 0 {
                tt1[ttc1 as usize] = (48 + (tv1 - (tv1/10)*10)) as i8
                tv1 = tv1 / 10; ttc1 = ttc1 + 1
            }
            var tri1 = ttc1 - 1
            while tri1 >= 0 { ttname.buf[tni as usize] = tt1[tri1 as usize]; tni = tni + 1; tri1 = tri1 - 1 }
        }
        ttname.len = tni
        let tsi2 = ast_lookup_struct(ctx, ttname)
        if tsi2 >= 0 { return tsi2 + 10 }
        return 0
    }
    if expr.kind == ExprKind::ExprFieldAccess {
        let br: &Option<Box<Expr>> = &expr.left
        match *br {
            Some(be) => {
                let bt = ast_expr_result_type(&(*be), local_names, local_types, local_count, ctx)
                var si: i64 = -1
                if bt >= 100 { si = bt - 100 }
                else if bt >= 10 { si = bt - 10 }
                if si >= 0 {
                    let fi = ast_struct_field_info(ctx, si, expr.name)
                    if fi >= 0 { return ctx.sf_type[fi as usize] }
                }
            }
            _ => {}
        }
        return 0
    }
    if expr.kind == ExprKind::ExprCast {
        // Sprint 230: Check cast target type for f64 result tracking
        let ct_ref: &Option<Box<TypeExpr>> = &expr.cast_type
        match *ct_ref {
            Some(cte) => {
                if ast_type_is_f64(&(*cte)) { return 1 }
            }
            _ => {}
        }
        // Also check if source is f64 and target is int
        let src_ref: &Option<Box<Expr>> = &expr.left
        match *src_ref {
            Some(se) => {
                if ast_expr_is_float(&(*se), local_names, local_types, local_count, ctx) {
                    return 0  // f64→i64 = integer result
                }
            }
            _ => {}
        }
        return 0
    }
    if expr.kind == ExprKind::ExprBinary {
        let lr: &Option<Box<Expr>> = &expr.left
        match *lr {
            Some(le) => {
                let lt = ast_expr_result_type(&(*le), local_names, local_types, local_count, ctx)
                if lt == 1 {
                    if expr.bin_op == BinaryOp::OpAdd || expr.bin_op == BinaryOp::OpSub ||
                       expr.bin_op == BinaryOp::OpMul || expr.bin_op == BinaryOp::OpDiv {
                        return 1
                    }
                    return 0
                }
            }
            _ => {}
        }
        return 0
    }
    0
}

// ============================================================================
// Direct AST to x86-64 compiler (bypasses IR lowering entirely)
// Uses inline arrays for locals (no Box) to avoid JIT by-value corruption.
// ============================================================================

// Helper: check if a TypeExpr refers to "f64"
fn ast_type_is_f64(ty: &TypeExpr) -> bool with Mut, Panic {
    if ty.kind != TypeExprKind::TypeNamed { return false }
    let seg: &StringList = &ty.path.segments
    if seg.head_len != 3 { return false }
    if seg.head_buf[0 as usize] == (102 as i8) &&
       seg.head_buf[1 as usize] == (54 as i8) &&
       seg.head_buf[2 as usize] == (52 as i8) {
        return true
    }
    false
}

// Helper: determine if an expression produces an f64 value
fn ast_expr_is_float(expr: &Expr, local_names: [Name; 512], local_types: [i64; 512], local_count: i64, ctx: &AstCompileCtx) -> bool with Mut, Panic, Div {
    if expr.kind == ExprKind::ExprFloatLit { return true }
    if expr.kind == ExprKind::ExprIdent {
        var li = local_count - 1
        while li >= 0 {
            if ir_name_eq(local_names[li as usize], expr.name) {
                return local_types[li as usize] == 1
            }
            li = li - 1
        }
        return false
    }
    if expr.kind == ExprKind::ExprBinary {
        let left_ref: &Option<Box<Expr>> = &expr.left
        match *left_ref {
            Some(le) => { return ast_expr_is_float(&(*le), local_names, local_types, local_count, ctx) }
            _ => { return false }
        }
    }
    if expr.kind == ExprKind::ExprCast {
        // Check source: f64→i64 = int result; i64→f64 = float result
        let cast_sub: &Option<Box<Expr>> = &expr.left
        match *cast_sub {
            Some(cse) => {
                if ast_expr_is_float(&(*cse), local_names, local_types, local_count, ctx) {
                    return false  // f64→i64 produces int
                }
            }
            _ => {}
        }
        // Check target type
        let ct_r: &Option<Box<TypeExpr>> = &expr.cast_type
        match *ct_r {
            Some(ctr) => {
                if ast_type_is_f64(&(*ctr)) { return true }
            }
            _ => {}
        }
        return false
    }
    // ExprIndex: check if base is a global f64 array
    if expr.kind == ExprKind::ExprIndex {
        let idx_b: &Option<Box<Expr>> = &expr.left
        match *idx_b {
            Some(ib) => {
                if (*ib).kind == ExprKind::ExprIdent {
                    let gidx = global_lookup((*ib).name)
                    if gidx >= 0 && GLOBAL_IS_FLOAT[gidx as usize] == 1 {
                        return true
                    }
                }
            }
            _ => {}
        }
        return false
    }
    // ExprFieldAccess: check if the accessed field is f64
    if expr.kind == ExprKind::ExprFieldAccess {
        let fb_ref: &Option<Box<Expr>> = &expr.left
        match *fb_ref {
            Some(fbe) => {
                let bt = ast_expr_result_type(&(*fbe), local_names, local_types, local_count, ctx)
                var si: i64 = -1
                if bt >= 100 { si = bt - 100 }
                else if bt >= 10 { si = bt - 10 }
                if si >= 0 {
                    let fi = ast_struct_field_info(ctx, si, expr.name)
                    if fi >= 0 {
                        return ctx.sf_type[fi as usize] == 1
                    }
                }
            }
            _ => {}
        }
        return false
    }
    // ExprCall: look up callee name, check its return type from local_types
    if expr.kind == ExprKind::ExprCall {
        let callee_opt: &Option<Box<Expr>> = &expr.left
        match *callee_opt {
            Some(ce) => {
                var li = local_count - 1
                while li >= 0 {
                    if ir_name_eq(local_names[li as usize], (*ce).name) {
                        return local_types[li as usize] == 1
                    }
                    li = li - 1
                }
            }
            _ => {}
        }
        return false
    }
    false
}

// Sprint 234 Track A: Minimal expression compiler for closure bodies.
// Uses [Name; 8] (1,088 bytes) not [Name; 512] (69,632 bytes) — avoids Cranelift JIT IR explosion.
// Handles: ExprIntLit, ExprBoolTrue/False, ExprIdent (closure param lookup), ExprBinary (int ops).
// Closures are pure functions of their params — no outer frame locals captured (lambda-lifting).
// Sprint 234 Track A: Closure body expression compiler.
// Uses CL_BODY_NAMES/SLOTS/COUNT globals (set by ast_compile_closure_emit before call)
// instead of [Name; 8] params — avoids Cranelift JIT IR explosion from large by-value
// array copies at the two recursive call sites in ExprBinary.
fn ast_compile_closure_body_expr(code: CodeBuffer, expr: &Expr
) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    if expr.kind == ExprKind::ExprIntLit {
        c = emit_mov_rax_imm64(c, expr.int_val)
        return c
    }
    if expr.kind == ExprKind::ExprBoolTrue {
        c = emit_mov_rax_imm64(c, 1)
        return c
    }
    if expr.kind == ExprKind::ExprBoolFalse {
        c = emit_mov_rax_imm64(c, 0)
        return c
    }
    if expr.kind == ExprKind::ExprIdent {
        var found_slot: i64 = -9999
        var ci = CL_BODY_COUNT - 1
        while ci >= 0 {
            if ir_name_eq(CL_BODY_NAMES[ci as usize], expr.name) {
                found_slot = CL_BODY_SLOTS[ci as usize]
                ci = -1
            } else { ci = ci - 1 }
        }
        if found_slot >= 0 { c = micro_load_rax(c, found_slot) } else { c = emit_mov_rax_imm64(c, 0) }
        return c
    }
    if expr.kind == ExprKind::ExprBinary {
        let left_ref: &Option<Box<Expr>> = &expr.left
        match *left_ref {
            Some(le) => { c = ast_compile_closure_body_expr(c, &(*le)) }
            _ => {}
        }
        c = emit_byte(c, 0x50)  // push rax (left)
        let right_ref: &Option<Box<Expr>> = &expr.right
        match *right_ref {
            Some(re) => { c = ast_compile_closure_body_expr(c, &(*re)) }
            _ => {}
        }
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc1)  // mov rcx, rax (right)
        c = emit_byte(c, 0x58)  // pop rax (left)
        if expr.bin_op == BinaryOp::OpAdd {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x01); c = emit_byte(c, 0xc8)
        } else if expr.bin_op == BinaryOp::OpSub {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x29); c = emit_byte(c, 0xc8)
        } else if expr.bin_op == BinaryOp::OpMul {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xaf); c = emit_byte(c, 0xc1)
        } else if expr.bin_op == BinaryOp::OpEq {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
            c = emit_byte(c, 0x0f); c = emit_byte(c, 0x94); c = emit_byte(c, 0xc0 as i64)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0 as i64)
        } else if expr.bin_op == BinaryOp::OpNe {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
            c = emit_byte(c, 0x0f); c = emit_byte(c, 0x95); c = emit_byte(c, 0xc0 as i64)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0 as i64)
        } else if expr.bin_op == BinaryOp::OpLt {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
            c = emit_byte(c, 0x0f); c = emit_byte(c, 0x9c); c = emit_byte(c, 0xc0 as i64)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0 as i64)
        } else if expr.bin_op == BinaryOp::OpGt {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
            c = emit_byte(c, 0x0f); c = emit_byte(c, 0x9f); c = emit_byte(c, 0xc0 as i64)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0 as i64)
        } else if expr.bin_op == BinaryOp::OpLe {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
            c = emit_byte(c, 0x0f); c = emit_byte(c, 0x9e); c = emit_byte(c, 0xc0 as i64)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0 as i64)
        } else if expr.bin_op == BinaryOp::OpGe {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
            c = emit_byte(c, 0x0f); c = emit_byte(c, 0x9d); c = emit_byte(c, 0xc0 as i64)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0 as i64)
        }
        return c
    }
    c = emit_mov_rax_imm64(c, 0)
    c
}

fn ast_compile_closure_emit(code: CodeBuffer, expr: &Expr,
    ctx: &AstCompileCtx
) -> CodeBuffer with Mut, Panic, Div, IO {
    var c = code
    let cl_idx = CLOSURE_COUNT
    CLOSURE_COUNT = CLOSURE_COUNT + 1

    // Build a fresh CodeBuffer for the closure function body
    var cl_code = code_buffer_new()
    cl_code = lctx_set_level(cl_code, -1)
    let cl_frame: i64 = 32768
    // Prologue: push rbp; mov rbp,rsp; sub rsp,cl_frame
    cl_code = emit_byte(cl_code, 0x55)
    cl_code = emit_byte(cl_code, 0x48); cl_code = emit_byte(cl_code, 0x89); cl_code = emit_byte(cl_code, 0xe5)
    cl_code = emit_byte(cl_code, 0x48); cl_code = emit_byte(cl_code, 0x81); cl_code = emit_byte(cl_code, 0xec)
    cl_code = emit_byte(cl_code, cl_frame & 0xFF); cl_code = emit_byte(cl_code, (cl_frame >> 8) & 0xFF)
    cl_code = emit_byte(cl_code, (cl_frame >> 16) & 0xFF); cl_code = emit_byte(cl_code, (cl_frame >> 24) & 0xFF)

    // Populate CL_BODY_* globals (avoids [Name; 8] by-value copies in recursive body compiler).
    // Reset from previous closure (single-file programs, sequential closure compilation).
    CL_BODY_COUNT = 0

    // Spill closure params from ABI registers into stack slots (rdi, rsi, rdx, rcx, r8, r9 → slots 0..5)
    let cl_params_ref: &Option<Box<ClosureParamList>> = &expr.closure_params
    var cl_param_cur = cl_params_ref
    var cl_param_idx: i64 = 0
    var cl_next_slot: i64 = 0
    while true {
        match *cl_param_cur {
            Some(cpl) => {
                let cp_name = (*cpl).head.name
                let cp_ty: &TypeExpr = &(*cpl).head.ty
                var cp_type: i64 = 0
                if ast_type_is_f64(cp_ty) { cp_type = 1 }
                let cp_slot = cl_next_slot
                cl_next_slot = cl_next_slot + 1
                if CL_BODY_COUNT < 8 {
                    CL_BODY_NAMES[CL_BODY_COUNT as usize] = cp_name
                    CL_BODY_SLOTS[CL_BODY_COUNT as usize] = cp_slot
                    CL_BODY_COUNT = CL_BODY_COUNT + 1
                }
                // Load ABI register → rax
                if cl_param_idx == 0 {
                    cl_code = emit_byte(cl_code, 0x48); cl_code = emit_byte(cl_code, 0x89); cl_code = emit_byte(cl_code, 0xf8)
                } else if cl_param_idx == 1 {
                    cl_code = emit_byte(cl_code, 0x48); cl_code = emit_byte(cl_code, 0x89); cl_code = emit_byte(cl_code, 0xf0)
                } else if cl_param_idx == 2 {
                    cl_code = emit_byte(cl_code, 0x48); cl_code = emit_byte(cl_code, 0x89); cl_code = emit_byte(cl_code, 0xd0)
                } else if cl_param_idx == 3 {
                    cl_code = emit_byte(cl_code, 0x48); cl_code = emit_byte(cl_code, 0x89); cl_code = emit_byte(cl_code, 0xc8)
                } else if cl_param_idx == 4 {
                    cl_code = emit_byte(cl_code, 0x4c); cl_code = emit_byte(cl_code, 0x89); cl_code = emit_byte(cl_code, 0xc0)
                } else if cl_param_idx == 5 {
                    cl_code = emit_byte(cl_code, 0x4c); cl_code = emit_byte(cl_code, 0x89); cl_code = emit_byte(cl_code, 0xc8)
                }
                cl_code = micro_store_rax(cl_code, cp_slot)
                cl_param_idx = cl_param_idx + 1
                cl_param_cur = &(*cpl).tail
            }
            _ => break
        }
    }
    cl_code = code_set_ns(cl_code, cl_next_slot)

    // Compile closure body using globals-based expression compiler (no [Name; 8] copies in recursion)
    let cl_body_ref: &Option<Box<Expr>> = &expr.closure_body
    match *cl_body_ref {
        Some(cbe) => {
            cl_code = ast_compile_closure_body_expr(cl_code, &(*cbe))
        }
        _ => {
            cl_code = emit_byte(cl_code, 0x48); cl_code = emit_byte(cl_code, 0x31); cl_code = emit_byte(cl_code, 0xc0)
        }
    }
    // Epilogue: leave; ret
    cl_code = emit_byte(cl_code, 0xc9)
    cl_code = emit_byte(cl_code, 0xc3)

    // Flush closure function to WIDE_OUT (placed before the enclosing function's code)
    CLOSURE_OFFSETS[cl_idx as usize] = WIDE_LEN
    wide_flush(cl_code)

    // Emit closure LEA sentinel in caller's CodeBuffer: 48 8D 05 <cidx_lo> <cidx_hi> 0xC1 0xBE
    c = emit_byte(c, 0x48)
    c = emit_byte(c, 0x8D)
    c = emit_byte(c, 0x05)
    c = emit_byte(c, cl_idx & 0xFF)
    c = emit_byte(c, (cl_idx >> 8) & 0xFF)
    c = emit_byte(c, 0xC1 as i64)
    c = emit_byte(c, 0xBE as i64)
    c
}

fn ast_compile_expr(code: CodeBuffer, expr: &Expr,
    local_names: [Name; 512], local_slots: [i64; 512], local_types: [i64; 512], local_count: i64,
    ctx: &AstCompileCtx
) -> CodeBuffer with Mut, Panic, Div, IO {
    var c = code
    if expr.kind == ExprKind::ExprIntLit {
        c = emit_byte(c, 0x48)
        c = emit_byte(c, 0xb8)
        c = emit_byte(c, expr.int_val & 0xFF)
        c = emit_byte(c, (expr.int_val >> 8) & 0xFF)
        c = emit_byte(c, (expr.int_val >> 16) & 0xFF)
        c = emit_byte(c, (expr.int_val >> 24) & 0xFF)
        c = emit_byte(c, (expr.int_val >> 32) & 0xFF)
        c = emit_byte(c, (expr.int_val >> 40) & 0xFF)
        c = emit_byte(c, (expr.int_val >> 48) & 0xFF)
        c = emit_byte(c, (expr.int_val >> 56) & 0xFF)
        c
    } else if expr.kind == ExprKind::ExprBoolTrue {
        c = emit_byte(c, 0x48); c = emit_byte(c, 0xb8)
        c = emit_byte(c, 1)
        var bi: i64 = 0
        while bi < 7 { c = emit_byte(c, 0); bi = bi + 1 }
        c
    } else if expr.kind == ExprKind::ExprBoolFalse {
        c = emit_byte(c, 0x48); c = emit_byte(c, 0xb8)
        var bi: i64 = 0
        while bi < 8 { c = emit_byte(c, 0); bi = bi + 1 }
        c
    } else if expr.kind == ExprKind::ExprFloatLit {
        // Store f64 IEEE 754 bit pattern in RAX (shares stack slots with i64)
        let fbits = f64_bits(expr.float_val)
        c = emit_byte(c, 0x48)
        c = emit_byte(c, 0xb8)
        c = emit_byte(c, fbits & 0xFF)
        c = emit_byte(c, (fbits >> 8) & 0xFF)
        c = emit_byte(c, (fbits >> 16) & 0xFF)
        c = emit_byte(c, (fbits >> 24) & 0xFF)
        c = emit_byte(c, (fbits >> 32) & 0xFF)
        c = emit_byte(c, (fbits >> 40) & 0xFF)
        c = emit_byte(c, (fbits >> 48) & 0xFF)
        c = emit_byte(c, (fbits >> 56) & 0xFF)
        c
    } else if expr.kind == ExprKind::ExprCast {
        // Compile source expression first
        let sub_ref: &Option<Box<Expr>> = &expr.left
        match *sub_ref {
            Some(se) => {
                c = ast_compile_expr(c, &(*se), local_names, local_slots, local_types, local_count, ctx)
                let src_is_float = ast_expr_is_float(&(*se), local_names, local_types, local_count, ctx)
                if src_is_float {
                    // f64→i64: MOVQ xmm0, rax then CVTTSD2SI rax, xmm0
                    // MOVQ xmm0, rax: 66 48 0F 6E C0
                    c = emit_byte(c, 0x66); c = emit_byte(c, 0x48)
                    c = emit_byte(c, 0x0F); c = emit_byte(c, 0x6E); c = emit_byte(c, 0xC0 as i64)
                    // CVTTSD2SI rax, xmm0: F2 48 0F 2C C0
                    c = emit_byte(c, 0xF2 as i64); c = emit_byte(c, 0x48)
                    c = emit_byte(c, 0x0F); c = emit_byte(c, 0x2C); c = emit_byte(c, 0xC0 as i64)
                } else {
                    // Source is int. Check if target type is f64.
                    let ct_ref: &Option<Box<TypeExpr>> = &expr.cast_type
                    var target_is_f64 = false
                    match *ct_ref {
                        Some(cte) => {
                            target_is_f64 = ast_type_is_f64(&(*cte))
                        }
                        _ => {}
                    }
                    if target_is_f64 {
                        // i64→f64: CVTSI2SD xmm0, rax then MOVQ rax, xmm0
                        // CVTSI2SD xmm0, rax: F2 48 0F 2A C0
                        c = emit_byte(c, 0xF2 as i64); c = emit_byte(c, 0x48)
                        c = emit_byte(c, 0x0F); c = emit_byte(c, 0x2A); c = emit_byte(c, 0xC0 as i64)
                        // MOVQ rax, xmm0: 66 48 0F 7E C0
                        c = emit_byte(c, 0x66); c = emit_byte(c, 0x48)
                        c = emit_byte(c, 0x0F); c = emit_byte(c, 0x7E); c = emit_byte(c, 0xC0 as i64)
                    }
                    // else: int→int cast (as usize, as i64) — no-op
                }
            }
            _ => {}
        }
        c
    } else if expr.kind == ExprKind::ExprIdent {
        var slot: i64 = -1
        var ltype: i64 = 0
        var li = local_count - 1
        while li >= 0 {
            if ir_name_eq(local_names[li as usize], expr.name) {
                slot = local_slots[li as usize]
                ltype = local_types[li as usize]
                li = -1
            } else {
                li = li - 1
            }
        }
        if slot >= 0 {
            if ltype >= 10 && ltype < 100 {
                // Struct on stack — return address via LEA
                c = micro_lea_rax_slot(c, slot)
            } else {
                c = micro_load_rax(c, slot)
            }
        } else if slot <= -2000 {
            // Global variable read
            let gi = 0 - (slot + 2000)
            let gsz = GLOBAL_SIZES[gi as usize]
            if gsz > 8 {
                // Array global — load base address (pointer to first element)
                c = emit_load_global_base(c)
                let goff = GLOBAL_OFFSETS[gi as usize]
                if goff > 0 {
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x05)
                    c = emit_byte(c, goff & 0xFF); c = emit_byte(c, (goff >> 8) & 0xFF)
                    c = emit_byte(c, (goff >> 16) & 0xFF); c = emit_byte(c, (goff >> 24) & 0xFF)
                }
            } else {
                // Scalar global — load value
                c = emit_global_scalar_read(c, gi)
            }
        } else if slot <= -1000 {
            // Sprint 229: Function name used as first-class value — emit LEA sentinel
            // Pattern: 48 8D 05 <fn_idx_lo> <fn_idx_hi> DA BE (7 bytes)
            // Patched in post-pass to LEA rax, [RIP+disp32] pointing to function
            let fn_idx = 0 - (slot + 1000)
            c = emit_byte(c, 0x48)                       // REX.W
            c = emit_byte(c, 0x8D)                       // LEA
            c = emit_byte(c, 0x05)                       // ModR/M: rax, [RIP+disp32]
            c = emit_byte(c, fn_idx & 0xFF)              // fn_idx lo
            c = emit_byte(c, (fn_idx >> 8) & 0xFF)       // fn_idx hi
            c = emit_byte(c, 0xDA as i64)                // sentinel marker lo
            c = emit_byte(c, 0xBE as i64)                // sentinel marker hi
        } else {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
        }
        c
    } else if expr.kind == ExprKind::ExprPath {
        // Enum variant expression: Color::Red → discriminant i64
        let pln = ast_path_last_name_ref(&expr.path)
        if ir_name_is_none(pln) {
            c = emit_mov_rax_imm64(c, 0)
        } else {
            let disc = ast_lookup_variant(ctx, pln)
            if disc >= 0 {
                c = emit_mov_rax_imm64(c, disc)
            } else {
                // Not a variant — try local variable lookup (single-segment path)
                let pfn = ast_name_from_path(&expr.path)
                var pslot: i64 = -1
                var pli = local_count - 1
                while pli >= 0 {
                    if ir_name_eq(local_names[pli as usize], pfn) {
                        pslot = local_slots[pli as usize]
                        pli = -1
                    } else { pli = pli - 1 }
                }
                if pslot >= 0 {
                    c = micro_load_rax(c, pslot)
                } else {
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
                }
            }
        }
        c
    } else if expr.kind == ExprKind::ExprFieldAccess {
        // Compile base → rax (address of struct)
        let fa_base: &Option<Box<Expr>> = &expr.left
        var base_type: i64 = 0
        match *fa_base {
            Some(be) => {
                base_type = ast_expr_result_type(&(*be), local_names, local_types, local_count, ctx)
                c = ast_compile_expr(c, &(*be), local_names, local_slots, local_types, local_count, ctx)
            }
            _ => {}
        }
        var si: i64 = -1
        if base_type >= 100 { si = base_type - 100 }
        else if base_type >= 10 { si = base_type - 10 }
        if si >= 0 {
            let fi = ast_struct_field_info(ctx, si, expr.name)
            if fi >= 0 {
                let foff = ctx.sf_flat_offset[fi as usize]
                let fsz = ctx.sf_flat_size[fi as usize]
                // Stack slots grow downward: field at flat_offset K is at [base - K*8]
                let off = 0 - (foff * 8)
                if fsz == 1 {
                    // Scalar: mov rax, [rax + off] (off is negative)
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8b); c = emit_byte(c, 0x80)
                    c = emit_byte(c, off & 0xFF); c = emit_byte(c, (off >> 8) & 0xFF)
                    c = emit_byte(c, (off >> 16) & 0xFF); c = emit_byte(c, (off >> 24) & 0xFF)
                } else {
                    // Sub-struct: lea rax, [rax + off] (off is negative)
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x80)
                    c = emit_byte(c, off & 0xFF); c = emit_byte(c, (off >> 8) & 0xFF)
                    c = emit_byte(c, (off >> 16) & 0xFF); c = emit_byte(c, (off >> 24) & 0xFF)
                }
            }
        }
        c
    } else if expr.kind == ExprKind::ExprUnary {
        let un_sub: &Option<Box<Expr>> = &expr.left
        if expr.un_op == UnaryOp::OpRef || expr.un_op == UnaryOp::OpRefMut {
            match *un_sub {
                Some(ue) => {
                    if (*ue).kind == ExprKind::ExprIdent {
                        var slot: i64 = -1
                        var ltype: i64 = 0
                        var uli = local_count - 1
                        while uli >= 0 {
                            if ir_name_eq(local_names[uli as usize], (*ue).name) {
                                slot = local_slots[uli as usize]
                                ltype = local_types[uli as usize]
                                uli = -1
                            } else { uli = uli - 1 }
                        }
                        if ltype == 2 {
                            // Array: variable holds data pointer, just load it
                            c = micro_load_rax(c, slot)
                        } else if ltype >= 10 && ltype < 100 {
                            // Struct on stack: LEA
                            c = micro_lea_rax_slot(c, slot)
                        } else {
                            // Scalar: LEA of slot
                            c = micro_lea_rax_slot(c, slot)
                        }
                    } else {
                        c = ast_compile_expr(c, &(*ue), local_names, local_slots, local_types, local_count, ctx)
                    }
                }
                _ => {}
            }
        } else if expr.un_op == UnaryOp::OpDeref {
            match *un_sub {
                Some(ue) => {
                    c = ast_compile_expr(c, &(*ue), local_names, local_slots, local_types, local_count, ctx)
                    // For array refs, the value IS the data pointer — no extra deref
                }
                _ => {}
            }
        } else if expr.un_op == UnaryOp::OpNeg {
            match *un_sub {
                Some(ue) => {
                    c = ast_compile_expr(c, &(*ue), local_names, local_slots, local_types, local_count, ctx)
                }
                _ => {}
            }
            // neg rax
            c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xd8)
        } else if expr.un_op == UnaryOp::OpNot {
            match *un_sub {
                Some(ue) => {
                    c = ast_compile_expr(c, &(*ue), local_names, local_slots, local_types, local_count, ctx)
                }
                _ => {}
            }
            // xor rax, 1
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x83); c = emit_byte(c, 0xf0); c = emit_byte(c, 0x01)
        }
        c
    } else if expr.kind == ExprKind::ExprIndex {
        // base[index]: compile base → rax (data pointer), then index
        // Check if base is a global array for element-size-aware access
        var idx_global_idx: i64 = -1
        let idx_base: &Option<Box<Expr>> = &expr.left
        match *idx_base {
            Some(be) => {
                if (*be).kind == ExprKind::ExprIdent {
                    let gidx = global_lookup((*be).name)
                    if gidx >= 0 && GLOBAL_SIZES[gidx as usize] > 8 {
                        idx_global_idx = gidx
                    }
                }
                c = ast_compile_expr(c, &(*be), local_names, local_slots, local_types, local_count, ctx)
            }
            _ => {}
        }
        c = emit_byte(c, 0x50) // push rax (base pointer)
        let idx_expr: &Option<Box<Expr>> = &expr.right
        match *idx_expr {
            Some(ie) => {
                c = ast_compile_expr(c, &(*ie), local_names, local_slots, local_types, local_count, ctx)
            }
            _ => {}
        }
        // rax=index, pop rcx=base
        c = emit_byte(c, 0x59) // pop rcx
        if idx_global_idx >= 0 && GLOBAL_ELEM_SIZES[idx_global_idx as usize] == 1 {
            // i8 array: movsx rax, byte [rcx + rax]  (48 0f be 04 01)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xbe); c = emit_byte(c, 0x04); c = emit_byte(c, 0x01)
        } else {
            // i64 array or local array: mov rax, [rcx + rax*8]
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x8b); c = emit_byte(c, 0x04); c = emit_byte(c, 0xc1)
        }
        c
    } else if expr.kind == ExprKind::ExprBinary && expr.bin_op == BinaryOp::OpAnd {
        // Short-circuit &&: eval left; if 0, result=0; else eval right
        let la_ref: &Option<Box<Expr>> = &expr.left
        match *la_ref {
            Some(le) => { c = ast_compile_expr(c, &(*le), local_names, local_slots, local_types, local_count, ctx) }
            _ => {}
        }
        // test rax, rax; jz short_false
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0)
        let and_jz = c.len
        c = emit_byte(c, 0x0f); c = emit_byte(c, 0x84)
        c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
        // Eval right
        let ra_ref: &Option<Box<Expr>> = &expr.right
        match *ra_ref {
            Some(re) => { c = ast_compile_expr(c, &(*re), local_names, local_slots, local_types, local_count, ctx) }
            _ => {}
        }
        // jmp end
        let and_jmp = c.len
        c = emit_byte(c, 0xe9)
        c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
        // short_false: xor eax, eax (result = 0)
        let and_false = c.len
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
        let and_end = c.len
        // Patch jz → short_false
        let jz_d = and_false - (and_jz + 6)
        c.bytes[(and_jz + 2) as usize] = (jz_d & 0xFF) as i8
        c.bytes[(and_jz + 3) as usize] = ((jz_d >> 8) & 0xFF) as i8
        c.bytes[(and_jz + 4) as usize] = ((jz_d >> 16) & 0xFF) as i8
        c.bytes[(and_jz + 5) as usize] = ((jz_d >> 24) & 0xFF) as i8
        // Patch jmp → end
        let jmp_d = and_end - (and_jmp + 5)
        c.bytes[(and_jmp + 1) as usize] = (jmp_d & 0xFF) as i8
        c.bytes[(and_jmp + 2) as usize] = ((jmp_d >> 8) & 0xFF) as i8
        c.bytes[(and_jmp + 3) as usize] = ((jmp_d >> 16) & 0xFF) as i8
        c.bytes[(and_jmp + 4) as usize] = ((jmp_d >> 24) & 0xFF) as i8
        c
    } else if expr.kind == ExprKind::ExprBinary && expr.bin_op == BinaryOp::OpOr {
        // Short-circuit ||: eval left; if non-zero, result=1; else eval right
        let lo_ref: &Option<Box<Expr>> = &expr.left
        match *lo_ref {
            Some(le) => { c = ast_compile_expr(c, &(*le), local_names, local_slots, local_types, local_count, ctx) }
            _ => {}
        }
        // test rax, rax; jnz short_true
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0)
        let or_jnz = c.len
        c = emit_byte(c, 0x0f); c = emit_byte(c, 0x85)
        c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
        // Eval right
        let ro_ref: &Option<Box<Expr>> = &expr.right
        match *ro_ref {
            Some(re) => { c = ast_compile_expr(c, &(*re), local_names, local_slots, local_types, local_count, ctx) }
            _ => {}
        }
        // jmp end
        let or_jmp = c.len
        c = emit_byte(c, 0xe9)
        c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
        // short_true: mov rax, 1
        let or_true = c.len
        c = emit_byte(c, 0x48); c = emit_byte(c, 0xc7); c = emit_byte(c, 0xc0)
        c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
        let or_end = c.len
        // Patch jnz → short_true
        let jnz_d = or_true - (or_jnz + 6)
        c.bytes[(or_jnz + 2) as usize] = (jnz_d & 0xFF) as i8
        c.bytes[(or_jnz + 3) as usize] = ((jnz_d >> 8) & 0xFF) as i8
        c.bytes[(or_jnz + 4) as usize] = ((jnz_d >> 16) & 0xFF) as i8
        c.bytes[(or_jnz + 5) as usize] = ((jnz_d >> 24) & 0xFF) as i8
        // Patch jmp → end
        let jmpd = or_end - (or_jmp + 5)
        c.bytes[(or_jmp + 1) as usize] = (jmpd & 0xFF) as i8
        c.bytes[(or_jmp + 2) as usize] = ((jmpd >> 8) & 0xFF) as i8
        c.bytes[(or_jmp + 3) as usize] = ((jmpd >> 16) & 0xFF) as i8
        c.bytes[(or_jmp + 4) as usize] = ((jmpd >> 24) & 0xFF) as i8
        c
    } else if expr.kind == ExprKind::ExprBinary {
        // Check if this is a float operation
        var is_float_binop = false
        let left_ref: &Option<Box<Expr>> = &expr.left
        match *left_ref {
            Some(le) => {
                is_float_binop = ast_expr_is_float(&(*le), local_names, local_types, local_count, ctx)
            }
            _ => {}
        }
        // Compile left → rax
        match *left_ref {
            Some(le) => {
                c = ast_compile_expr(c, &(*le), local_names, local_slots, local_types, local_count, ctx)
            }
            _ => {}
        }
        c = emit_byte(c, 0x50)  // push rax (left f64 bits or i64)
        let right_ref: &Option<Box<Expr>> = &expr.right
        match *right_ref {
            Some(re) => {
                c = ast_compile_expr(c, &(*re), local_names, local_slots, local_types, local_count, ctx)
            }
            _ => {}
        }
        if is_float_binop {
            // rax = right f64 bits (on stack: left f64 bits)
            // MOVQ xmm1, rax: 66 48 0F 6E C8
            c = emit_byte(c, 0x66); c = emit_byte(c, 0x48)
            c = emit_byte(c, 0x0F); c = emit_byte(c, 0x6E); c = emit_byte(c, 0xC8 as i64)
            // pop rax (left bits)
            c = emit_byte(c, 0x58)
            // MOVQ xmm0, rax: 66 48 0F 6E C0
            c = emit_byte(c, 0x66); c = emit_byte(c, 0x48)
            c = emit_byte(c, 0x0F); c = emit_byte(c, 0x6E); c = emit_byte(c, 0xC0 as i64)
            // Now xmm0=left, xmm1=right
            if expr.bin_op == BinaryOp::OpAdd {
                // ADDSD xmm0, xmm1: F2 0F 58 C1
                c = emit_byte(c, 0xF2 as i64); c = emit_byte(c, 0x0F)
                c = emit_byte(c, 0x58); c = emit_byte(c, 0xC1 as i64)
            } else if expr.bin_op == BinaryOp::OpSub {
                c = emit_byte(c, 0xF2 as i64); c = emit_byte(c, 0x0F)
                c = emit_byte(c, 0x5C); c = emit_byte(c, 0xC1 as i64)
            } else if expr.bin_op == BinaryOp::OpMul {
                c = emit_byte(c, 0xF2 as i64); c = emit_byte(c, 0x0F)
                c = emit_byte(c, 0x59); c = emit_byte(c, 0xC1 as i64)
            } else if expr.bin_op == BinaryOp::OpDiv {
                c = emit_byte(c, 0xF2 as i64); c = emit_byte(c, 0x0F)
                c = emit_byte(c, 0x5E); c = emit_byte(c, 0xC1 as i64)
            } else if expr.bin_op == BinaryOp::OpGt {
                // COMISD xmm0, xmm1: 66 0F 2F C1 ; SETA al; MOVZX rax, al
                c = emit_byte(c, 0x66); c = emit_byte(c, 0x0F)
                c = emit_byte(c, 0x2F); c = emit_byte(c, 0xC1 as i64)
                c = emit_byte(c, 0x0F); c = emit_byte(c, 0x97 as i64); c = emit_byte(c, 0xC0 as i64)
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x0F); c = emit_byte(c, 0xB6 as i64); c = emit_byte(c, 0xC0 as i64)
            } else if expr.bin_op == BinaryOp::OpGe {
                c = emit_byte(c, 0x66); c = emit_byte(c, 0x0F)
                c = emit_byte(c, 0x2F); c = emit_byte(c, 0xC1 as i64)
                c = emit_byte(c, 0x0F); c = emit_byte(c, 0x93 as i64); c = emit_byte(c, 0xC0 as i64)
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x0F); c = emit_byte(c, 0xB6 as i64); c = emit_byte(c, 0xC0 as i64)
            } else if expr.bin_op == BinaryOp::OpLt {
                // COMISD xmm1, xmm0: 66 0F 2F C8 ; SETA al
                c = emit_byte(c, 0x66); c = emit_byte(c, 0x0F)
                c = emit_byte(c, 0x2F); c = emit_byte(c, 0xC8 as i64)
                c = emit_byte(c, 0x0F); c = emit_byte(c, 0x97 as i64); c = emit_byte(c, 0xC0 as i64)
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x0F); c = emit_byte(c, 0xB6 as i64); c = emit_byte(c, 0xC0 as i64)
            } else if expr.bin_op == BinaryOp::OpLe {
                c = emit_byte(c, 0x66); c = emit_byte(c, 0x0F)
                c = emit_byte(c, 0x2F); c = emit_byte(c, 0xC8 as i64)
                c = emit_byte(c, 0x0F); c = emit_byte(c, 0x93 as i64); c = emit_byte(c, 0xC0 as i64)
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x0F); c = emit_byte(c, 0xB6 as i64); c = emit_byte(c, 0xC0 as i64)
            } else if expr.bin_op == BinaryOp::OpEq {
                c = emit_byte(c, 0x66); c = emit_byte(c, 0x0F)
                c = emit_byte(c, 0x2F); c = emit_byte(c, 0xC1 as i64)
                c = emit_byte(c, 0x0F); c = emit_byte(c, 0x94 as i64); c = emit_byte(c, 0xC0 as i64)
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x0F); c = emit_byte(c, 0xB6 as i64); c = emit_byte(c, 0xC0 as i64)
            } else if expr.bin_op == BinaryOp::OpNe {
                c = emit_byte(c, 0x66); c = emit_byte(c, 0x0F)
                c = emit_byte(c, 0x2F); c = emit_byte(c, 0xC1 as i64)
                c = emit_byte(c, 0x0F); c = emit_byte(c, 0x95 as i64); c = emit_byte(c, 0xC0 as i64)
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x0F); c = emit_byte(c, 0xB6 as i64); c = emit_byte(c, 0xC0 as i64)
            }
            // For arithmetic ops, result is in xmm0 — move to rax as f64 bits
            if expr.bin_op == BinaryOp::OpAdd || expr.bin_op == BinaryOp::OpSub || expr.bin_op == BinaryOp::OpMul || expr.bin_op == BinaryOp::OpDiv {
                // MOVQ rax, xmm0: 66 48 0F 7E C0
                c = emit_byte(c, 0x66); c = emit_byte(c, 0x48)
                c = emit_byte(c, 0x0F); c = emit_byte(c, 0x7E); c = emit_byte(c, 0xC0 as i64)
            }
        } else {
            // Integer path (original)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc1)  // mov rcx, rax
            c = emit_byte(c, 0x58)  // pop rax
            if expr.bin_op == BinaryOp::OpAdd {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x01); c = emit_byte(c, 0xc8)
            } else if expr.bin_op == BinaryOp::OpSub {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x29); c = emit_byte(c, 0xc8)
            } else if expr.bin_op == BinaryOp::OpMul {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xaf); c = emit_byte(c, 0xc1)
            } else if expr.bin_op == BinaryOp::OpDiv {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x99)
                c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xf9)
            } else if expr.bin_op == BinaryOp::OpRem {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x99)
                c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xf9)
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xd0)
            } else if expr.bin_op == BinaryOp::OpEq {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
                c = emit_byte(c, 0x0f); c = emit_byte(c, 0x94); c = emit_byte(c, 0xc0)
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0)
            } else if expr.bin_op == BinaryOp::OpNe {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
                c = emit_byte(c, 0x0f); c = emit_byte(c, 0x95); c = emit_byte(c, 0xc0)
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0)
            } else if expr.bin_op == BinaryOp::OpLt {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
                c = emit_byte(c, 0x0f); c = emit_byte(c, 0x9c); c = emit_byte(c, 0xc0)
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0)
            } else if expr.bin_op == BinaryOp::OpLe {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
                c = emit_byte(c, 0x0f); c = emit_byte(c, 0x9e); c = emit_byte(c, 0xc0)
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0)
            } else if expr.bin_op == BinaryOp::OpGt {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
                c = emit_byte(c, 0x0f); c = emit_byte(c, 0x9f); c = emit_byte(c, 0xc0)
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0)
            } else if expr.bin_op == BinaryOp::OpGe {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x39); c = emit_byte(c, 0xc8)
                c = emit_byte(c, 0x0f); c = emit_byte(c, 0x9d); c = emit_byte(c, 0xc0)
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0xb6); c = emit_byte(c, 0xc0)
            } else if expr.bin_op == BinaryOp::OpBitAnd {
                // AND rax, rcx: 48 21 C8
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x21); c = emit_byte(c, 0xc8)
            } else if expr.bin_op == BinaryOp::OpBitOr {
                // OR rax, rcx: 48 09 C8
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x09); c = emit_byte(c, 0xc8)
            } else if expr.bin_op == BinaryOp::OpBitXor {
                // XOR rax, rcx: 48 31 C8
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc8)
            } else if expr.bin_op == BinaryOp::OpShl {
                // SHL rax, cl: 48 D3 E0
                c = emit_byte(c, 0x48); c = emit_byte(c, 0xd3); c = emit_byte(c, 0xe0)
            } else if expr.bin_op == BinaryOp::OpShr {
                // SHR rax, cl: 48 D3 E8
                c = emit_byte(c, 0x48); c = emit_byte(c, 0xd3); c = emit_byte(c, 0xe8)
            }
        }
        c
    } else if expr.kind == ExprKind::ExprMethodCall {
        // receiver.method(args) — look up method by name, prepend receiver as arg 0
        let mc_method_name = expr.name
        // Find method in local_names (functions registered as negative-slot locals)
        var mc_fn_slot: i64 = -1
        var mc_ret_type: i64 = 0
        var mfi: i64 = local_count - 1
        while mfi >= 0 {
            if ir_name_eq(local_names[mfi as usize], mc_method_name) {
                mc_fn_slot = local_slots[mfi as usize]
                mc_ret_type = local_types[mfi as usize]
                mfi = -1  // break
            } else {
                mfi = mfi - 1
            }
        }
        // Determine sret
        var mc_sret = false
        var mc_sret_idx: i64 = -1
        var mc_sret_flat: i64 = 0
        if mc_ret_type >= 10 && mc_ret_type < 100 {
            mc_sret = true
            mc_sret_idx = mc_ret_type - 10
            mc_sret_flat = ctx.struct_flat_size[mc_sret_idx as usize]
        }
        var mc_sret_base: i64 = 0
        if mc_sret {
            var mc_sns = code_get_ns(c)
            mc_sret_base = mc_sns
            mc_sns = mc_sns + mc_sret_flat
            c = code_set_ns(c, mc_sns)
        }
        // Arg 0 = receiver (expr.left)
        var mc_arg_slots: [i64; 16] = [0; 16]
        var mc_arg_count: i64 = 0
        let mc_recv_ref: &Option<Box<Expr>> = &expr.left
        match *mc_recv_ref {
            Some(mc_re) => {
                c = ast_compile_expr(c, &(*mc_re), local_names, local_slots, local_types, local_count, ctx)
            }
            _ => {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
            }
        }
        var mc_ns0 = code_get_ns(c)
        let mc_r_slot = mc_ns0
        mc_ns0 = mc_ns0 + 1
        c = code_set_ns(c, mc_ns0)
        c = micro_store_rax(c, mc_r_slot)
        mc_arg_slots[0] = mc_r_slot
        mc_arg_count = 1
        // Remaining args
        let mc_args_ref: &Option<Box<ExprList>> = &expr.args
        var mc_arg_cur = mc_args_ref
        while true {
            match *mc_arg_cur {
                Some(mc_al) => {
                    c = ast_compile_expr(c, &(*mc_al).head, local_names, local_slots, local_types, local_count, ctx)
                    var mc_ns1 = code_get_ns(c)
                    let mc_as = mc_ns1
                    mc_ns1 = mc_ns1 + 1
                    c = code_set_ns(c, mc_ns1)
                    c = micro_store_rax(c, mc_as)
                    mc_arg_slots[mc_arg_count as usize] = mc_as
                    mc_arg_count = mc_arg_count + 1
                    mc_arg_cur = &(*mc_al).tail
                }
                _ => break
            }
        }
        // Register setup — same convention as ExprCall
        var mc_reg_shift: i64 = 0
        if mc_sret { mc_reg_shift = 1 }
        let mc_stack_start = 6 - mc_reg_shift
        var mc_stack_count: i64 = 0
        if mc_arg_count > mc_stack_start {
            var mc_sa = mc_arg_count - 1
            while mc_sa >= mc_stack_start {
                c = micro_load_rax(c, mc_arg_slots[mc_sa as usize])
                c = emit_byte(c, 0x50)
                mc_stack_count = mc_stack_count + 1
                mc_sa = mc_sa - 1
            }
        }
        var mc_max_reg = mc_arg_count
        if mc_max_reg > mc_stack_start { mc_max_reg = mc_stack_start }
        if mc_reg_shift + mc_max_reg > 5 {
            let mc_a5 = 5 - mc_reg_shift
            if mc_a5 >= 0 && mc_a5 < mc_arg_count {
                c = micro_load_rax(c, mc_arg_slots[mc_a5 as usize])
                c = emit_byte(c, 0x49); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc1) // mov r9, rax
            }
        }
        if mc_reg_shift + mc_max_reg > 4 {
            let mc_a4 = 4 - mc_reg_shift
            if mc_a4 >= 0 && mc_a4 < mc_arg_count {
                c = micro_load_rax(c, mc_arg_slots[mc_a4 as usize])
                c = emit_byte(c, 0x49); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc0) // mov r8, rax
            }
        }
        if mc_reg_shift + mc_max_reg > 3 {
            let mc_a3 = 3 - mc_reg_shift
            if mc_a3 >= 0 && mc_a3 < mc_arg_count {
                c = micro_load_rax(c, mc_arg_slots[mc_a3 as usize])
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc1) // mov rcx, rax
            }
        }
        if mc_reg_shift + mc_max_reg > 2 {
            let mc_a2 = 2 - mc_reg_shift
            if mc_a2 >= 0 && mc_a2 < mc_arg_count {
                c = micro_load_rax(c, mc_arg_slots[mc_a2 as usize])
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc2) // mov rdx, rax
            }
        }
        if mc_reg_shift + mc_max_reg > 1 {
            let mc_a1 = 1 - mc_reg_shift
            if mc_a1 >= 0 && mc_a1 < mc_arg_count {
                c = micro_load_rax(c, mc_arg_slots[mc_a1 as usize])
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc6) // mov rsi, rax
            }
        }
        if mc_sret {
            c = micro_lea_rax_slot(c, mc_sret_base)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc7) // mov rdi, rax
        } else {
            if mc_max_reg > 0 {
                c = micro_load_rax(c, mc_arg_slots[0])
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc7) // mov rdi, rax
            }
        }
        // Emit call sentinel
        if mc_fn_slot <= -1000 {
            let mc_ti = 0 - (mc_fn_slot + 1000)
            c = emit_byte(c, 0xe8)
            c = emit_byte(c, mc_ti & 0xFF)
            c = emit_byte(c, (mc_ti >> 8) & 0xFF)
            c = emit_byte(c, 0xCA as i64)
            c = emit_byte(c, 0xFE as i64)
        }
        // Clean stack
        if mc_stack_count > 0 {
            let mc_cleanup = mc_stack_count * 8
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x81); c = emit_byte(c, 0xc4)
            c = emit_byte(c, mc_cleanup & 0xFF); c = emit_byte(c, (mc_cleanup >> 8) & 0xFF)
            c = emit_byte(c, 0); c = emit_byte(c, 0)
        }
        if mc_sret {
            c = micro_lea_rax_slot(c, mc_sret_base)
        }
        c
    } else if expr.kind == ExprKind::ExprCall {
        let callee_opt: &Option<Box<Expr>> = &expr.left
        var callee_name = ir_empty_name()
        match *callee_opt {
            Some(ce) => { callee_name = (*ce).name }
            _ => {}
        }

        // Check for print("string_literal") — emit inline syscall
        var is_print_str = false
        if callee_name.len == 5 &&
           callee_name.buf[0 as usize] == (112 as i8) &&
           callee_name.buf[1 as usize] == (114 as i8) &&
           callee_name.buf[2 as usize] == (105 as i8) &&
           callee_name.buf[3 as usize] == (110 as i8) &&
           callee_name.buf[4 as usize] == (116 as i8) {
            let pargs: &Option<Box<ExprList>> = &expr.args
            match *pargs {
                Some(pal) => {
                    if (*pal).head.kind == ExprKind::ExprStringLit {
                        c = ast_emit_inline_print_str(c, (*pal).head.name.buf, (*pal).head.name.len)
                        is_print_str = true
                    }
                }
                _ => {}
            }
        }

        if !is_print_str {
            // Look up callee fn_slot and return type
            var fn_slot: i64 = -1
            var callee_ret_type: i64 = 0
            var li = local_count - 1
            while li >= 0 {
                if ir_name_eq(local_names[li as usize], callee_name) {
                    fn_slot = local_slots[li as usize]
                    callee_ret_type = local_types[li as usize]
                    li = -1
                } else {
                    li = li - 1
                }
            }
            // Determine if callee returns a struct (sret convention)
            var sret = false
            var sret_struct_idx: i64 = -1
            var sret_flat_size: i64 = 0
            if callee_ret_type >= 10 && callee_ret_type < 100 {
                sret = true
                sret_struct_idx = callee_ret_type - 10
                sret_flat_size = ctx.struct_flat_size[sret_struct_idx as usize]
            }
            // Allocate sret destination space if needed
            var sret_base: i64 = 0
            if sret {
                var call_ns = code_get_ns(c)
                sret_base = call_ns
                call_ns = call_ns + sret_flat_size
                c = code_set_ns(c, call_ns)
            }
            // Evaluate all args into temp slots
            var arg_slots: [i64; 16] = [0; 16]
            var arg_count: i64 = 0
            let args_ref: &Option<Box<ExprList>> = &expr.args
            var current_arg = args_ref
            while true {
                match *current_arg {
                    Some(al) => {
                        c = ast_compile_expr(c, &(*al).head, local_names, local_slots, local_types, local_count, ctx)
                        // Store to temp slot
                        var call_ns2 = code_get_ns(c)
                        let tmp_s = call_ns2
                        call_ns2 = call_ns2 + 1
                        c = code_set_ns(c, call_ns2)
                        c = micro_store_rax(c, tmp_s)
                        arg_slots[arg_count as usize] = tmp_s
                        arg_count = arg_count + 1
                        current_arg = &(*al).tail
                    }
                    _ => break
                }
            }
            // Determine register mapping (with sret shift)
            // sret: rdi=sret_addr, rsi=arg0, rdx=arg1, rcx=arg2, r8=arg3, r9=arg4, stack=arg5+
            // no sret: rdi=arg0, rsi=arg1, rdx=arg2, rcx=arg3, r8=arg4, r9=arg5, stack=arg6+
            var reg_shift: i64 = 0
            if sret { reg_shift = 1 }
            let stack_start = 6 - reg_shift  // args with index >= stack_start go on stack
            // Push stack args in reverse order
            var stack_count: i64 = 0
            if arg_count > stack_start {
                var sa = arg_count - 1
                while sa >= stack_start {
                    c = micro_load_rax(c, arg_slots[sa as usize])
                    c = emit_byte(c, 0x50) // push rax
                    stack_count = stack_count + 1
                    sa = sa - 1
                }
            }
            // Load register args in reverse order to avoid clobbering
            // Slot in reg order: rdi(0), rsi(1), rdx(2), rcx(3), r8(4), r9(5)
            // With sret: rdi=sret, rsi=arg0, rdx=arg1, rcx=arg2, r8=arg3, r9=arg4
            var max_reg_arg = arg_count
            if max_reg_arg > stack_start { max_reg_arg = stack_start }
            // r9 (reg slot 5)
            if reg_shift + max_reg_arg > 5 {
                let a5i = 5 - reg_shift
                if a5i >= 0 && a5i < arg_count {
                    c = micro_load_rax(c, arg_slots[a5i as usize])
                    // mov r9, rax: 49 89 C1
                    c = emit_byte(c, 0x49); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc1)
                }
            }
            // r8 (reg slot 4)
            if reg_shift + max_reg_arg > 4 {
                let a4i = 4 - reg_shift
                if a4i >= 0 && a4i < arg_count {
                    c = micro_load_rax(c, arg_slots[a4i as usize])
                    // mov r8, rax: 49 89 C0
                    c = emit_byte(c, 0x49); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc0)
                }
            }
            // rcx (reg slot 3)
            if reg_shift + max_reg_arg > 3 {
                let a3i = 3 - reg_shift
                if a3i >= 0 && a3i < arg_count {
                    c = micro_load_rax(c, arg_slots[a3i as usize])
                    // mov rcx, rax
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc1)
                }
            }
            // rdx (reg slot 2)
            if reg_shift + max_reg_arg > 2 {
                let a2i = 2 - reg_shift
                if a2i >= 0 && a2i < arg_count {
                    c = micro_load_rax(c, arg_slots[a2i as usize])
                    // mov rdx, rax
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc2)
                }
            }
            // rsi (reg slot 1)
            if reg_shift + max_reg_arg > 1 {
                let a1i = 1 - reg_shift
                if a1i >= 0 && a1i < arg_count {
                    c = micro_load_rax(c, arg_slots[a1i as usize])
                    // mov rsi, rax
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc6)
                }
            }
            // rdi (reg slot 0)
            if sret {
                // rdi = sret destination address
                c = micro_lea_rax_slot(c, sret_base)
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc7) // mov rdi, rax
            } else {
                if max_reg_arg > 0 {
                    c = micro_load_rax(c, arg_slots[0])
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc7) // mov rdi, rax
                }
            }
            // Emit call sentinel or indirect call
            if fn_slot <= -1000 {
                let target_idx = 0 - (fn_slot + 1000)
                c = emit_byte(c, 0xe8)
                c = emit_byte(c, target_idx & 0xFF)
                c = emit_byte(c, (target_idx >> 8) & 0xFF)
                c = emit_byte(c, 0xCA as i64)
                c = emit_byte(c, 0xFE as i64)
            } else if fn_slot >= 0 {
                // Sprint 229: Indirect call — callee is a local variable holding fn pointer
                // All SysV argument registers are already loaded above.
                // Load the function pointer from the callee's stack slot into rax
                c = micro_load_rax(c, fn_slot)
                // CALL rax: FF D0
                c = emit_byte(c, 0xFF as i64)
                c = emit_byte(c, 0xD0 as i64)
                // NOTE: f64 indirect-call return (XMM0→RAX) requires TypeFn return type
                // tracking in the lean emitter. Deferred — use wrapper functions for now.
            }
            // Clean up stack args
            if stack_count > 0 {
                let cleanup = stack_count * 8
                // add rsp, cleanup
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x81); c = emit_byte(c, 0xc4)
                c = emit_byte(c, cleanup & 0xFF); c = emit_byte(c, (cleanup >> 8) & 0xFF)
                c = emit_byte(c, 0); c = emit_byte(c, 0)
            }
            // For sret: rax already has return value (sret address) from callee convention
            // But callee puts it in rdi and returns — we need to produce the address
            if sret {
                c = micro_lea_rax_slot(c, sret_base)
            }
        }
        c
    } else if expr.kind == ExprKind::ExprIf {
        let cond_ref: &Option<Box<Expr>> = &expr.left
        match *cond_ref {
            Some(ce) => {
                c = ast_compile_expr(c, &(*ce), local_names, local_slots, local_types, local_count, ctx)
            }
            _ => {}
        }
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0)
        let jz_site = c.len
        c = emit_byte(c, 0x0f); c = emit_byte(c, 0x84)
        c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
        let then_ref: &Option<Box<Block>> = &expr.block
        match *then_ref {
            Some(tb) => {
                c = ast_compile_block(c, &(*tb), local_names, local_slots, local_types, local_count, ctx)
            }
            _ => {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
            }
        }
        let jmp_site = c.len
        c = emit_byte(c, 0xe9)
        c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
        let else_off = c.len
        let jz_disp = else_off - (jz_site + 6)
        c.bytes[(jz_site + 2) as usize] = (jz_disp & 0xFF) as i8
        c.bytes[(jz_site + 3) as usize] = ((jz_disp >> 8) & 0xFF) as i8
        c.bytes[(jz_site + 4) as usize] = ((jz_disp >> 16) & 0xFF) as i8
        c.bytes[(jz_site + 5) as usize] = ((jz_disp >> 24) & 0xFF) as i8
        let else_expr_ref: &Option<Box<Expr>> = &expr.else_expr
        match *else_expr_ref {
            Some(ee) => {
                c = ast_compile_expr(c, &(*ee), local_names, local_slots, local_types, local_count, ctx)
            }
            _ => {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
            }
        }
        let end_off = c.len
        let jmp_disp = end_off - (jmp_site + 5)
        c.bytes[(jmp_site + 1) as usize] = (jmp_disp & 0xFF) as i8
        c.bytes[(jmp_site + 2) as usize] = ((jmp_disp >> 8) & 0xFF) as i8
        c.bytes[(jmp_site + 3) as usize] = ((jmp_disp >> 16) & 0xFF) as i8
        c.bytes[(jmp_site + 4) as usize] = ((jmp_disp >> 24) & 0xFF) as i8
        c
    } else if expr.kind == ExprKind::ExprWhile {
        // Push loop level (-1 = no loop → 0; 0 → 1; etc.)
        let prev_level = lctx_level(c)
        let level = if prev_level < 0 { 0 } else { prev_level + 1 }
        c = lctx_set_level(c, level)
        let loop_top = c.len
        c = lctx_set_top(c, level, loop_top)
        c = lctx_set_break_count(c, level, 0)
        // Compile condition
        let wcond_ref: &Option<Box<Expr>> = &expr.left
        match *wcond_ref {
            Some(wce) => {
                c = ast_compile_expr(c, &(*wce), local_names, local_slots, local_types, local_count, ctx)
            }
            _ => {}
        }
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0)
        let wjz_site = c.len
        c = emit_byte(c, 0x0f); c = emit_byte(c, 0x84)
        c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
        // Compile body
        let wbody_ref: &Option<Box<Block>> = &expr.block
        match *wbody_ref {
            Some(wb) => {
                c = ast_compile_block(c, &(*wb), local_names, local_slots, local_types, local_count, ctx)
            }
            _ => {}
        }
        // JMP back to loop top
        let jback_site = c.len
        let jback_disp = loop_top - (jback_site + 5)
        c = emit_byte(c, 0xe9)
        c = emit_byte(c, jback_disp & 0xFF)
        c = emit_byte(c, (jback_disp >> 8) & 0xFF)
        c = emit_byte(c, (jback_disp >> 16) & 0xFF)
        c = emit_byte(c, (jback_disp >> 24) & 0xFF)
        let wend_off = c.len
        // Patch JZ (condition exit) to wend_off
        let wjz_disp = wend_off - (wjz_site + 6)
        c.bytes[(wjz_site + 2) as usize] = (wjz_disp & 0xFF) as i8
        c.bytes[(wjz_site + 3) as usize] = ((wjz_disp >> 8) & 0xFF) as i8
        c.bytes[(wjz_site + 4) as usize] = ((wjz_disp >> 16) & 0xFF) as i8
        c.bytes[(wjz_site + 5) as usize] = ((wjz_disp >> 24) & 0xFF) as i8
        // Patch all break jumps to wend_off
        var wbi: i64 = 0
        let wbc = lctx_get_break_count(c, level)
        while wbi < wbc {
            let wbp = lctx_get_break_patch(c, level, wbi)
            let wbd = wend_off - (wbp + 4)
            c.bytes[(wbp) as usize] = (wbd & 0xFF) as i8
            c.bytes[(wbp + 1) as usize] = ((wbd >> 8) & 0xFF) as i8
            c.bytes[(wbp + 2) as usize] = ((wbd >> 16) & 0xFF) as i8
            c.bytes[(wbp + 3) as usize] = ((wbd >> 24) & 0xFF) as i8
            wbi = wbi + 1
        }
        // Pop loop level
        c = lctx_set_level(c, prev_level)
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
        c
    } else if expr.kind == ExprKind::ExprBreak {
        // Emit JMP rel32 placeholder; record patch site for enclosing while
        let blevel = lctx_level(c)
        c = emit_byte(c, 0xe9)
        let bpatch = c.len
        c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
        let bcount = lctx_get_break_count(c, blevel)
        c = lctx_set_break_patch(c, blevel, bcount, bpatch)
        c = lctx_set_break_count(c, blevel, bcount + 1)
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
        c
    } else if expr.kind == ExprKind::ExprContinue {
        // JMP back to loop top
        let clevel = lctx_level(c)
        let ctop = lctx_get_top(c, clevel)
        let csite = c.len
        let cdisp = ctop - (csite + 5)
        c = emit_byte(c, 0xe9)
        c = emit_byte(c, cdisp & 0xFF)
        c = emit_byte(c, (cdisp >> 8) & 0xFF)
        c = emit_byte(c, (cdisp >> 16) & 0xFF)
        c = emit_byte(c, (cdisp >> 24) & 0xFF)
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
        c
    } else if expr.kind == ExprKind::ExprReturn {
        let ret_ref: &Option<Box<Expr>> = &expr.left
        match *ret_ref {
            Some(re) => {
                c = ast_compile_expr(c, &(*re), local_names, local_slots, local_types, local_count, ctx)
            }
            _ => {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
            }
        }
        // If current function uses sret, copy return struct to sret destination
        if ctx.cur_sret == 1 {
            let sr_flat = ctx.cur_sret_flat_size
            let sr_dest = code_get_sret_slot(c)
            // rax = source base (highest addr). Copy to sret dest.
            c = emit_byte(c, 0x56); c = emit_byte(c, 0x57); c = emit_byte(c, 0x51) // push rsi,rdi,rcx
            if sr_flat > 1 {
                let sr_adj = (sr_flat - 1) * 8
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x2d) // sub rax, imm32
                c = emit_byte(c, sr_adj & 0xFF); c = emit_byte(c, (sr_adj >> 8) & 0xFF)
                c = emit_byte(c, (sr_adj >> 16) & 0xFF); c = emit_byte(c, (sr_adj >> 24) & 0xFF)
            }
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc6) // mov rsi, rax
            // Load sret dest pointer, adjust to lowest addr
            c = micro_load_rax(c, sr_dest)
            if sr_flat > 1 {
                let sr_dadj = (sr_flat - 1) * 8
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x2d) // sub rax, imm32
                c = emit_byte(c, sr_dadj & 0xFF); c = emit_byte(c, (sr_dadj >> 8) & 0xFF)
                c = emit_byte(c, (sr_dadj >> 16) & 0xFF); c = emit_byte(c, (sr_dadj >> 24) & 0xFF)
            }
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc7) // mov rdi, rax
            c = emit_byte(c, 0x48); c = emit_byte(c, 0xc7); c = emit_byte(c, 0xc1) // mov rcx, imm32
            c = emit_byte(c, sr_flat & 0xFF); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
            c = emit_byte(c, 0xf3); c = emit_byte(c, 0x48); c = emit_byte(c, 0xa5) // rep movsq
            c = emit_byte(c, 0x59); c = emit_byte(c, 0x5f); c = emit_byte(c, 0x5e) // pop rcx,rdi,rsi
        }
        c = emit_byte(c, 0xc9)
        c = emit_byte(c, 0xc3)
        c
    } else if expr.kind == ExprKind::ExprBlock {
        let blk_ref: &Option<Box<Block>> = &expr.block
        match *blk_ref {
            Some(blk) => {
                c = ast_compile_block(c, &(*blk), local_names, local_slots, local_types, local_count, ctx)
            }
            _ => {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
            }
        }
        c
    } else if expr.kind == ExprKind::ExprMethodCall {
        // Method call: base.method(args) → call method(base, args)
        // Look up method name in fn_names
        let mc_name = expr.name
        var mc_fn_slot: i64 = -1
        var mc_ret_type: i64 = 0
        var mli = local_count - 1
        while mli >= 0 {
            if ir_name_eq(local_names[mli as usize], mc_name) {
                mc_fn_slot = local_slots[mli as usize]
                mc_ret_type = local_types[mli as usize]
                mli = -1
            } else {
                mli = mli - 1
            }
        }
        // Determine sret
        var mc_sret = false
        var mc_sret_idx: i64 = -1
        var mc_sret_flat: i64 = 0
        if mc_ret_type >= 10 && mc_ret_type < 100 {
            mc_sret = true
            mc_sret_idx = mc_ret_type - 10
            mc_sret_flat = ctx.struct_flat_size[mc_sret_idx as usize]
        }
        var mc_sret_base: i64 = 0
        if mc_sret {
            var mc_ns = code_get_ns(c)
            mc_sret_base = mc_ns
            mc_ns = mc_ns + mc_sret_flat
            c = code_set_ns(c, mc_ns)
        }
        // Evaluate base expr (implicit self) + explicit args → temp slots
        var mc_arg_slots: [i64; 16] = [0; 16]
        var mc_arg_count: i64 = 0
        // Arg0 = base expression
        let mc_base: &Option<Box<Expr>> = &expr.left
        match *mc_base {
            Some(mcb) => {
                c = ast_compile_expr(c, &(*mcb), local_names, local_slots, local_types, local_count, ctx)
            }
            _ => {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
            }
        }
        var mc_ns2 = code_get_ns(c)
        let mc_self_slot = mc_ns2
        mc_ns2 = mc_ns2 + 1
        c = code_set_ns(c, mc_ns2)
        c = micro_store_rax(c, mc_self_slot)
        mc_arg_slots[0] = mc_self_slot
        mc_arg_count = 1
        // Remaining args
        let mc_args: &Option<Box<ExprList>> = &expr.args
        var mc_ac = mc_args
        while true {
            match *mc_ac {
                Some(mal) => {
                    c = ast_compile_expr(c, &(*mal).head, local_names, local_slots, local_types, local_count, ctx)
                    var mc_ns3 = code_get_ns(c)
                    let mc_ts = mc_ns3
                    mc_ns3 = mc_ns3 + 1
                    c = code_set_ns(c, mc_ns3)
                    c = micro_store_rax(c, mc_ts)
                    mc_arg_slots[mc_arg_count as usize] = mc_ts
                    mc_arg_count = mc_arg_count + 1
                    mc_ac = &(*mal).tail
                }
                _ => break
            }
        }
        // Load args into registers (same pattern as ExprCall)
        var mc_reg_shift: i64 = 0
        if mc_sret { mc_reg_shift = 1 }
        let mc_stack_start = 6 - mc_reg_shift
        var mc_stack_count: i64 = 0
        if mc_arg_count > mc_stack_start {
            var mc_sa = mc_arg_count - 1
            while mc_sa >= mc_stack_start {
                c = micro_load_rax(c, mc_arg_slots[mc_sa as usize])
                c = emit_byte(c, 0x50) // push rax
                mc_stack_count = mc_stack_count + 1
                mc_sa = mc_sa - 1
            }
        }
        var mc_max = mc_arg_count
        if mc_max > mc_stack_start { mc_max = mc_stack_start }
        if mc_reg_shift + mc_max > 5 {
            let a5i = 5 - mc_reg_shift
            if a5i >= 0 && a5i < mc_arg_count {
                c = micro_load_rax(c, mc_arg_slots[a5i as usize])
                c = emit_byte(c, 0x49); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc1) // mov r9, rax
            }
        }
        if mc_reg_shift + mc_max > 4 {
            let a4i = 4 - mc_reg_shift
            if a4i >= 0 && a4i < mc_arg_count {
                c = micro_load_rax(c, mc_arg_slots[a4i as usize])
                c = emit_byte(c, 0x49); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc0) // mov r8, rax
            }
        }
        if mc_reg_shift + mc_max > 3 {
            let a3i = 3 - mc_reg_shift
            if a3i >= 0 && a3i < mc_arg_count {
                c = micro_load_rax(c, mc_arg_slots[a3i as usize])
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc1) // mov rcx, rax
            }
        }
        if mc_reg_shift + mc_max > 2 {
            let a2i = 2 - mc_reg_shift
            if a2i >= 0 && a2i < mc_arg_count {
                c = micro_load_rax(c, mc_arg_slots[a2i as usize])
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc2) // mov rdx, rax
            }
        }
        if mc_reg_shift + mc_max > 1 {
            let a1i = 1 - mc_reg_shift
            if a1i >= 0 && a1i < mc_arg_count {
                c = micro_load_rax(c, mc_arg_slots[a1i as usize])
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc6) // mov rsi, rax
            }
        }
        if mc_sret {
            c = micro_lea_rax_slot(c, mc_sret_base)
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc7) // mov rdi, rax (sret dest)
        } else {
            if mc_max > 0 {
                c = micro_load_rax(c, mc_arg_slots[0])
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc7) // mov rdi, rax
            }
        }
        // Emit call sentinel
        if mc_fn_slot <= -1000 {
            let mc_target = 0 - (mc_fn_slot + 1000)
            c = emit_byte(c, 0xe8)
            c = emit_byte(c, mc_target & 0xFF)
            c = emit_byte(c, (mc_target >> 8) & 0xFF)
            c = emit_byte(c, 0xCA as i64)
            c = emit_byte(c, 0xFE as i64)
        }
        if mc_stack_count > 0 {
            let mc_cleanup = mc_stack_count * 8
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x81); c = emit_byte(c, 0xc4)
            c = emit_byte(c, mc_cleanup & 0xFF); c = emit_byte(c, (mc_cleanup >> 8) & 0xFF)
            c = emit_byte(c, 0); c = emit_byte(c, 0)
        }
        if mc_sret {
            c = micro_lea_rax_slot(c, mc_sret_base)
        }
        c
    } else if expr.kind == ExprKind::ExprStructLit {
        // Look up struct type
        let sl_name = ast_name_from_path(&expr.path)
        let sl_idx = ast_lookup_struct(ctx, sl_name)
        if sl_idx >= 0 {
            let sl_flat = ctx.struct_flat_size[sl_idx as usize]
            // Allocate temp slots for this struct
            var sl_ns = code_get_ns(c)
            let sl_base = sl_ns
            sl_ns = sl_ns + sl_flat
            c = code_set_ns(c, sl_ns)
            // Fill fields from struct literal
            let sl_fields: &Option<Box<StructFieldList>> = &expr.fields
            var sl_cur = sl_fields
            while true {
                match *sl_cur {
                    Some(sfl) => {
                        let sf_fi = ast_struct_field_info(ctx, sl_idx, (*sfl).head.name)
                        if sf_fi >= 0 {
                            let sf_foff = ctx.sf_flat_offset[sf_fi as usize]
                            let sf_fsz = ctx.sf_flat_size[sf_fi as usize]
                            // Compile field value → rax
                            c = ast_compile_expr(c, &(*sfl).head.value, local_names, local_slots, local_types, local_count, ctx)
                            if sf_fsz == 1 {
                                // Scalar: store rax → slot
                                c = micro_store_rax(c, sl_base + sf_foff)
                            } else {
                                // Sub-struct: rax = source base (highest addr), memcpy N qwords
                                // Adjust both to lowest address for rep movsq
                                c = emit_byte(c, 0x56); c = emit_byte(c, 0x57); c = emit_byte(c, 0x51) // push rsi,rdi,rcx
                                // Adjust source to lowest addr: sub rax, (N-1)*8
                                if sf_fsz > 1 {
                                    let adj = (sf_fsz - 1) * 8
                                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x2d) // sub rax, imm32
                                    c = emit_byte(c, adj & 0xFF); c = emit_byte(c, (adj >> 8) & 0xFF)
                                    c = emit_byte(c, (adj >> 16) & 0xFF); c = emit_byte(c, (adj >> 24) & 0xFF)
                                }
                                c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc6) // mov rsi, rax
                                // Dest lowest addr: slot (sl_base + sf_foff + sf_fsz - 1)
                                c = micro_lea_rax_slot(c, sl_base + sf_foff + sf_fsz - 1)
                                c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc7) // mov rdi, rax
                                c = emit_byte(c, 0x48); c = emit_byte(c, 0xc7); c = emit_byte(c, 0xc1) // mov rcx, imm32
                                c = emit_byte(c, sf_fsz & 0xFF); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
                                c = emit_byte(c, 0xf3); c = emit_byte(c, 0x48); c = emit_byte(c, 0xa5) // rep movsq
                                c = emit_byte(c, 0x59); c = emit_byte(c, 0x5f); c = emit_byte(c, 0x5e) // pop rcx,rdi,rsi
                            }
                        }
                        sl_cur = &(*sfl).tail
                    }
                    _ => break
                }
            }
            // Return address of struct in rax
            c = micro_lea_rax_slot(c, sl_base)
        } else {
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
        }
        c
    } else if expr.kind == ExprKind::ExprTupleLit {
        // Tuple literal (e0, e1): allocate consecutive stack slots, compile each element,
        // store to slots, return LEA to base slot (highest addr = slot 0).
        let tl_args: &Option<Box<ExprList>> = &expr.args
        // Collect element sizes to allocate total space
        var tl_ns = code_get_ns(c)
        let tl_base = tl_ns
        // First pass: count elements and determine total slots needed
        var tl_total: i64 = 0
        var tl_el_cur = tl_args
        while true {
            match *tl_el_cur {
                Some(tel) => {
                    let elem_type = ast_expr_result_type(&(*tel).head, local_names, local_types, local_count, ctx)
                    var esz: i64 = 1
                    if elem_type >= 10 && elem_type < 100 {
                        let esi2 = elem_type - 10
                        esz = ctx.struct_flat_size[esi2 as usize]
                    } else if elem_type >= 100 {
                        esz = 1  // pointer
                    }
                    tl_total = tl_total + esz
                    tl_el_cur = &(*tel).tail
                }
                _ => break
            }
        }
        tl_ns = tl_ns + tl_total
        c = code_set_ns(c, tl_ns)
        // Second pass: compile each element and store to its slot
        var tl_offset: i64 = 0
        var tl_el_cur2 = tl_args
        while true {
            match *tl_el_cur2 {
                Some(tel2) => {
                    let et2 = ast_expr_result_type(&(*tel2).head, local_names, local_types, local_count, ctx)
                    c = ast_compile_expr(c, &(*tel2).head, local_names, local_slots, local_types, local_count, ctx)
                    var esz2: i64 = 1
                    if et2 >= 10 && et2 < 100 {
                        let esi3 = et2 - 10
                        esz2 = ctx.struct_flat_size[esi3 as usize]
                    }
                    if esz2 == 1 {
                        c = micro_store_rax(c, tl_base + tl_offset)
                    } else {
                        // Sub-struct: rax = source base, memcpy esz2 qwords
                        c = emit_byte(c, 0x56); c = emit_byte(c, 0x57); c = emit_byte(c, 0x51)
                        if esz2 > 1 {
                            let tadj = (esz2 - 1) * 8
                            c = emit_byte(c, 0x48); c = emit_byte(c, 0x2d)
                            c = emit_byte(c, tadj & 0xFF); c = emit_byte(c, (tadj >> 8) & 0xFF)
                            c = emit_byte(c, (tadj >> 16) & 0xFF); c = emit_byte(c, (tadj >> 24) & 0xFF)
                        }
                        c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc6) // mov rsi, rax
                        c = micro_lea_rax_slot(c, tl_base + tl_offset + esz2 - 1)
                        c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc7) // mov rdi, rax
                        c = emit_byte(c, 0x48); c = emit_byte(c, 0xc7); c = emit_byte(c, 0xc1)
                        c = emit_byte(c, esz2 & 0xFF); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
                        c = emit_byte(c, 0xf3); c = emit_byte(c, 0x48); c = emit_byte(c, 0xa5) // rep movsq
                        c = emit_byte(c, 0x59); c = emit_byte(c, 0x5f); c = emit_byte(c, 0x5e)
                    }
                    tl_offset = tl_offset + esz2
                    tl_el_cur2 = &(*tel2).tail
                }
                _ => break
            }
        }
        // Return LEA to base slot (first element, highest addr in stack-down layout)
        c = micro_lea_rax_slot(c, tl_base)
        c
    } else if expr.kind == ExprKind::ExprMatch {
        // Compile match expression (Option pattern: Some(x) / _ only for now)
        // 1. Compile scrutinee → rax
        let m_subj: &Option<Box<Expr>> = &expr.left
        match *m_subj {
            Some(ms) => {
                c = ast_compile_expr(c, &(*ms), local_names, local_slots, local_types, local_count, ctx)
            }
            _ => {
                c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
            }
        }
        // Save scrutinee to a temp slot for bindings
        var m_ns = code_get_ns(c)
        let m_scrut_slot = m_ns
        m_ns = m_ns + 1
        c = code_set_ns(c, m_ns)
        c = micro_store_rax(c, m_scrut_slot)
        // Walk arms: linked list of MatchArmList
        let m_arms: &Option<Box<MatchArmList>> = &expr.arms
        var m_arm_cur = m_arms
        // Reserve space for end-jump patches (up to 16 arms)
        var m_end_patches: [i64; 16] = [0; 16]
        var m_end_count: i64 = 0
        var m_done = false
        while !m_done {
            match *m_arm_cur {
                Some(arm_node) => {
                    let arm: &MatchArm = &(*arm_node).head
                    if arm.pattern.kind == PatternKind::PatWildcard || arm.pattern.kind == PatternKind::PatBinding {
                        // Wildcard or binding: unconditional — compile body
                        if arm.pattern.kind == PatternKind::PatBinding {
                            var m_bln = local_names
                            var m_bls = local_slots
                            var m_blt = local_types
                            var m_blc = local_count
                            m_bln[m_blc as usize] = arm.pattern.name
                            m_bls[m_blc as usize] = m_scrut_slot
                            m_blt[m_blc as usize] = 0
                            m_blc = m_blc + 1
                            c = ast_compile_expr(c, &arm.body, m_bln, m_bls, m_blt, m_blc, ctx)
                        } else {
                            c = ast_compile_expr(c, &arm.body, local_names, local_slots, local_types, local_count, ctx)
                        }
                        // JMP to end
                        c = emit_byte(c, 0xe9)
                        m_end_patches[m_end_count as usize] = c.len
                        m_end_count = m_end_count + 1
                        c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
                    } else if arm.pattern.kind == PatternKind::PatEnum {
                        let pn = ast_name_from_path(&arm.pattern.path)
                        if ir_name_is_some(pn) {
                            // Some(binding): test scrutinee != 0
                            c = micro_load_rax(c, m_scrut_slot)
                            c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0) // TEST rax, rax
                            c = emit_byte(c, 0x0f); c = emit_byte(c, 0x84) // JZ skip
                            let m_jz_site = c.len
                            c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
                            // Bind inner pattern to scrutinee value
                            var m_sln = local_names
                            var m_sls = local_slots
                            var m_slt = local_types
                            var m_slc = local_count
                            let sp_ref: &Option<Box<PatternList>> = &arm.pattern.sub_patterns
                            match *sp_ref {
                                Some(sp) => {
                                    m_sln[m_slc as usize] = (*sp).head.name
                                    m_sls[m_slc as usize] = m_scrut_slot
                                    m_slt[m_slc as usize] = 0
                                    m_slc = m_slc + 1
                                }
                                _ => {}
                            }
                            c = ast_compile_expr(c, &arm.body, m_sln, m_sls, m_slt, m_slc, ctx)
                            c = emit_byte(c, 0xe9) // JMP end
                            m_end_patches[m_end_count as usize] = c.len
                            m_end_count = m_end_count + 1
                            c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
                            // Patch JZ to here
                            let m_jz_target = c.len
                            let m_jz_disp = m_jz_target - (m_jz_site + 4)
                            c.bytes[(m_jz_site) as usize] = (m_jz_disp & 0xFF) as i8
                            c.bytes[(m_jz_site + 1) as usize] = ((m_jz_disp >> 8) & 0xFF) as i8
                            c.bytes[(m_jz_site + 2) as usize] = ((m_jz_disp >> 16) & 0xFF) as i8
                            c.bytes[(m_jz_site + 3) as usize] = ((m_jz_disp >> 24) & 0xFF) as i8
                        } else if ir_name_is_none(pn) {
                            // None: test scrutinee == 0
                            c = micro_load_rax(c, m_scrut_slot)
                            c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0) // TEST rax, rax
                            c = emit_byte(c, 0x0f); c = emit_byte(c, 0x85) // JNZ skip
                            let m_jnz_site = c.len
                            c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
                            c = ast_compile_expr(c, &arm.body, local_names, local_slots, local_types, local_count, ctx)
                            c = emit_byte(c, 0xe9) // JMP end
                            m_end_patches[m_end_count as usize] = c.len
                            m_end_count = m_end_count + 1
                            c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
                            // Patch JNZ to here
                            let m_jnz_target = c.len
                            let m_jnz_disp = m_jnz_target - (m_jnz_site + 4)
                            c.bytes[(m_jnz_site) as usize] = (m_jnz_disp & 0xFF) as i8
                            c.bytes[(m_jnz_site + 1) as usize] = ((m_jnz_disp >> 8) & 0xFF) as i8
                            c.bytes[(m_jnz_site + 2) as usize] = ((m_jnz_disp >> 16) & 0xFF) as i8
                            c.bytes[(m_jnz_site + 3) as usize] = ((m_jnz_disp >> 24) & 0xFF) as i8
                        } else {
                            // General enum variant: compare scrutinee to discriminant
                            let ev_name = ast_path_last_name_ref(&arm.pattern.path)
                            let ev_disc = ast_lookup_variant(ctx, ev_name)
                            if ev_disc >= 0 {
                                c = micro_load_rax(c, m_scrut_slot)
                                // CMP rax, imm32: 48 3D <4 bytes>
                                c = emit_byte(c, 0x48); c = emit_byte(c, 0x3d)
                                c = emit_byte(c, ev_disc & 0xFF)
                                c = emit_byte(c, (ev_disc >> 8) & 0xFF)
                                c = emit_byte(c, (ev_disc >> 16) & 0xFF)
                                c = emit_byte(c, (ev_disc >> 24) & 0xFF)
                                // JNE skip
                                c = emit_byte(c, 0x0f); c = emit_byte(c, 0x85)
                                let ev_jne = c.len
                                c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
                                c = ast_compile_expr(c, &arm.body, local_names, local_slots, local_types, local_count, ctx)
                                c = emit_byte(c, 0xe9) // JMP end
                                m_end_patches[m_end_count as usize] = c.len
                                m_end_count = m_end_count + 1
                                c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
                                // Patch JNE
                                let ev_tgt = c.len
                                let ev_d = ev_tgt - (ev_jne + 4)
                                c.bytes[(ev_jne) as usize] = (ev_d & 0xFF) as i8
                                c.bytes[(ev_jne + 1) as usize] = ((ev_d >> 8) & 0xFF) as i8
                                c.bytes[(ev_jne + 2) as usize] = ((ev_d >> 16) & 0xFF) as i8
                                c.bytes[(ev_jne + 3) as usize] = ((ev_d >> 24) & 0xFF) as i8
                            }
                        }
                    } else if arm.pattern.kind == PatternKind::PatIntLit {
                        // Integer literal match: CMP scrutinee, imm32
                        let il_val = arm.pattern.int_val
                        c = micro_load_rax(c, m_scrut_slot)
                        c = emit_byte(c, 0x48); c = emit_byte(c, 0x3d)
                        c = emit_byte(c, il_val & 0xFF)
                        c = emit_byte(c, (il_val >> 8) & 0xFF)
                        c = emit_byte(c, (il_val >> 16) & 0xFF)
                        c = emit_byte(c, (il_val >> 24) & 0xFF)
                        c = emit_byte(c, 0x0f); c = emit_byte(c, 0x85) // JNE skip
                        let il_jne = c.len
                        c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
                        c = ast_compile_expr(c, &arm.body, local_names, local_slots, local_types, local_count, ctx)
                        c = emit_byte(c, 0xe9) // JMP end
                        m_end_patches[m_end_count as usize] = c.len
                        m_end_count = m_end_count + 1
                        c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
                        let il_tgt = c.len
                        let il_d = il_tgt - (il_jne + 4)
                        c.bytes[(il_jne) as usize] = (il_d & 0xFF) as i8
                        c.bytes[(il_jne + 1) as usize] = ((il_d >> 8) & 0xFF) as i8
                        c.bytes[(il_jne + 2) as usize] = ((il_d >> 16) & 0xFF) as i8
                        c.bytes[(il_jne + 3) as usize] = ((il_d >> 24) & 0xFF) as i8
                    }
                    // Advance to next arm
                    m_arm_cur = &(*arm_node).tail
                }
                _ => {
                    m_done = true
                }
            }
        }
        // Patch all end-jumps to here
        var m_pi: i64 = 0
        while m_pi < m_end_count {
            let m_ep = m_end_patches[m_pi as usize]
            let m_end_disp = c.len - (m_ep + 4)
            c.bytes[(m_ep) as usize] = (m_end_disp & 0xFF) as i8
            c.bytes[(m_ep + 1) as usize] = ((m_end_disp >> 8) & 0xFF) as i8
            c.bytes[(m_ep + 2) as usize] = ((m_end_disp >> 16) & 0xFF) as i8
            c.bytes[(m_ep + 3) as usize] = ((m_end_disp >> 24) & 0xFF) as i8
            m_pi = m_pi + 1
        }
        c
    } else if expr.kind == ExprKind::ExprClosure {
        // Sprint 234 Track A: Lambda-lift closure to synthetic fn in WIDE_OUT.
        // Uses [Name; 8] scope internally — avoids [Name; 512] Cranelift JIT IR explosion.
        c = ast_compile_closure_emit(c, expr, ctx)
        c
    } else {
        c = emit_byte(c, 0x48)
        c = emit_byte(c, 0x31)
        c = emit_byte(c, 0xc0)
        c
    }
}
fn ast_compile_block(code: CodeBuffer, blk: &Block,
    local_names: [Name; 512], local_slots: [i64; 512], local_types: [i64; 512], local_count: i64,
    ctx: &AstCompileCtx
) -> CodeBuffer with Mut, Panic, Div, IO {
    var c = code
    var ln = local_names
    var ls = local_slots
    var lt = local_types
    var lc = local_count
    var next_slot: i64 = 0
    // Find max existing slot to avoid conflicts
    var si: i64 = 0
    while si < lc {
        if ls[si as usize] >= next_slot {
            next_slot = ls[si as usize] + 1
        }
        si = si + 1
    }
    // Also check next_slot from code_get_ns (temp allocations from struct literals etc)
    let ns_check = code_get_ns(c)
    if ns_check > next_slot { next_slot = ns_check }
    c = code_set_ns(c, next_slot)
    let stmts_ref: &Option<Box<StmtList>> = &blk.stmts
    var stmt_cur = stmts_ref
    while true {
        match *stmt_cur {
            Some(sl) => {
                let s: &Stmt = &(*sl).head
                if s.kind == StmtKind::StmtLet || s.kind == StmtKind::StmtVar {
                    // Check for array type annotation: [T; N]
                    var is_array = false
                    let ty_ref: &Option<Box<TypeExpr>> = &s.ty
                    match *ty_ref {
                        Some(tye) => {
                            if (*tye).kind == TypeExprKind::TypeArray {
                                is_array = true
                            }
                        }
                        _ => {}
                    }
                    if is_array {
                        // Array: mmap 512KB (65536 * 8), store pointer
                        c = ast_emit_mmap(c, 524288)
                        let slot = next_slot
                        next_slot = next_slot + 1
                        c = code_set_ns(c, next_slot)
                        c = micro_store_rax(c, slot)
                        ln[lc as usize] = s.name
                        ls[lc as usize] = slot
                        lt[lc as usize] = 2  // array_ptr
                        lc = lc + 1
                    } else {
                        // Compile init expression
                        let init_ref: &Option<Box<Expr>> = &s.expr
                        match *init_ref {
                            Some(ie) => {
                                c = ast_compile_expr(c, &(*ie), ln, ls, lt, lc, ctx)
                            }
                            _ => {
                                c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0)
                            }
                        }
                        // Sync next_slot with code_get_ns to avoid overlapping sret/local slots
                        let ns_sync = code_get_ns(c)
                        if ns_sync > next_slot { next_slot = ns_sync }
                        // Detect init result type
                        var init_type: i64 = 0
                        match *init_ref {
                            Some(ie2) => {
                                init_type = ast_expr_result_type(&(*ie2), ln, lt, lc, ctx)
                            }
                            _ => {}
                        }
                        if init_type >= 10 && init_type < 100 {
                            // Struct result: rax = base addr (highest), copy to local slots
                            let s_idx = init_type - 10
                            let s_flat = ctx.struct_flat_size[s_idx as usize]
                            let slot = next_slot
                            next_slot = next_slot + s_flat
                            c = code_set_ns(c, next_slot)
                            // Adjust source to lowest addr for rep movsq
                            c = emit_byte(c, 0x56); c = emit_byte(c, 0x57); c = emit_byte(c, 0x51) // push rsi,rdi,rcx
                            if s_flat > 1 {
                                let adj2 = (s_flat - 1) * 8
                                c = emit_byte(c, 0x48); c = emit_byte(c, 0x2d) // sub rax, imm32
                                c = emit_byte(c, adj2 & 0xFF); c = emit_byte(c, (adj2 >> 8) & 0xFF)
                                c = emit_byte(c, (adj2 >> 16) & 0xFF); c = emit_byte(c, (adj2 >> 24) & 0xFF)
                            }
                            c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc6) // mov rsi, rax
                            // Dest lowest addr: slot (slot + s_flat - 1)
                            c = micro_lea_rax_slot(c, slot + s_flat - 1)
                            c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc7) // mov rdi, rax
                            c = emit_byte(c, 0x48); c = emit_byte(c, 0xc7); c = emit_byte(c, 0xc1) // mov rcx, imm32
                            c = emit_byte(c, s_flat & 0xFF); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
                            c = emit_byte(c, 0xf3); c = emit_byte(c, 0x48); c = emit_byte(c, 0xa5) // rep movsq
                            c = emit_byte(c, 0x59); c = emit_byte(c, 0x5f); c = emit_byte(c, 0x5e) // pop rcx,rdi,rsi
                            ln[lc as usize] = s.name
                            ls[lc as usize] = slot
                            lt[lc as usize] = init_type  // 10+struct_idx
                            lc = lc + 1
                        } else {
                            // Scalar (i64, f64, pointer)
                            let slot = next_slot
                            next_slot = next_slot + 1
                            c = code_set_ns(c, next_slot)
                            c = micro_store_rax(c, slot)
                            ln[lc as usize] = s.name
                            ls[lc as usize] = slot
                            lt[lc as usize] = init_type
                            lc = lc + 1
                        }
                    }
                } else if s.kind == StmtKind::StmtExpr {
                    let expr_ref: &Option<Box<Expr>> = &s.expr
                    match *expr_ref {
                        Some(ee) => {
                            c = ast_compile_expr(c, &(*ee), ln, ls, lt, lc, ctx)
                        }
                        _ => {}
                    }
                } else if s.kind == StmtKind::StmtAssign {
                    // Check for deref-index assignment: (*ref)[idx] = value
                    let tgt_ref: &Option<Box<Expr>> = &s.target
                    var is_deref_idx = false
                    match *tgt_ref {
                        Some(te) => {
                            if (*te).kind == ExprKind::ExprIndex {
                                // Target is indexing — check if base is a deref
                                let idx_base2: &Option<Box<Expr>> = &(*te).left
                                match *idx_base2 {
                                    Some(ib) => {
                                        if (*ib).kind == ExprKind::ExprUnary && (*ib).un_op == UnaryOp::OpDeref {
                                            is_deref_idx = true
                                        }
                                    }
                                    _ => {}
                                }
                            }
                        }
                        _ => {}
                    }
                    if is_deref_idx {
                        // (*ref)[idx] = value
                        // Compile RHS → temp slot
                        let rhs_ref: &Option<Box<Expr>> = &s.expr
                        match *rhs_ref {
                            Some(re) => {
                                c = ast_compile_expr(c, &(*re), ln, ls, lt, lc, ctx)
                            }
                            _ => {}
                        }
                        c = emit_byte(c, 0x50) // push rax (value)
                        // Compile target: get base pointer
                        match *tgt_ref {
                            Some(te) => {
                                // te is ExprIndex; te.left is ExprUnary(OpDeref, inner)
                                let di_base: &Option<Box<Expr>> = &(*te).left
                                match *di_base {
                                    Some(dib) => {
                                        // Deref: compile inner → rax (pointer)
                                        let di_inner: &Option<Box<Expr>> = &(*dib).left
                                        match *di_inner {
                                            Some(dii) => {
                                                c = ast_compile_expr(c, &(*dii), ln, ls, lt, lc, ctx)
                                            }
                                            _ => {}
                                        }
                                    }
                                    _ => {}
                                }
                                c = emit_byte(c, 0x50) // push rax (base pointer)
                                // Compile index
                                let di_idx: &Option<Box<Expr>> = &(*te).right
                                match *di_idx {
                                    Some(die) => {
                                        c = ast_compile_expr(c, &(*die), ln, ls, lt, lc, ctx)
                                    }
                                    _ => {}
                                }
                                // rax=index, pop rcx=base, pop rdx=value
                                c = emit_byte(c, 0x59) // pop rcx (base)
                                c = emit_byte(c, 0x5a) // pop rdx (value)
                                // mov [rcx + rax*8], rdx
                                c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0x14); c = emit_byte(c, 0xc1)
                            }
                            _ => {}
                        }
                    } else {
                        // Normal assignment: var = value
                        let rhs_ref: &Option<Box<Expr>> = &s.expr
                        match *rhs_ref {
                            Some(re) => {
                                c = ast_compile_expr(c, &(*re), ln, ls, lt, lc, ctx)
                            }
                            _ => {}
                        }
                        match *tgt_ref {
                            Some(te) => {
                                if (*te).kind == ExprKind::ExprIdent {
                                    var slot: i64 = -1
                                    var asgn_type: i64 = 0
                                    var bli = lc - 1
                                    while bli >= 0 {
                                        if ir_name_eq(ln[bli as usize], (*te).name) {
                                            slot = ls[bli as usize]
                                            asgn_type = lt[bli as usize]
                                            bli = -1
                                        } else { bli = bli - 1 }
                                    }
                                    if slot >= 0 && asgn_type >= 10 && asgn_type < 100 {
                                        // Struct assignment: copy struct data from rax (source base) to slot
                                        let sa_idx = asgn_type - 10
                                        let sa_flat = ctx.struct_flat_size[sa_idx as usize]
                                        c = emit_byte(c, 0x56); c = emit_byte(c, 0x57); c = emit_byte(c, 0x51) // push rsi,rdi,rcx
                                        if sa_flat > 1 {
                                            let sa_adj = (sa_flat - 1) * 8
                                            c = emit_byte(c, 0x48); c = emit_byte(c, 0x2d) // sub rax, imm32
                                            c = emit_byte(c, sa_adj & 0xFF); c = emit_byte(c, (sa_adj >> 8) & 0xFF)
                                            c = emit_byte(c, (sa_adj >> 16) & 0xFF); c = emit_byte(c, (sa_adj >> 24) & 0xFF)
                                        }
                                        c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc6) // mov rsi, rax
                                        c = micro_lea_rax_slot(c, slot + sa_flat - 1)
                                        c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc7) // mov rdi, rax
                                        c = emit_byte(c, 0x48); c = emit_byte(c, 0xc7); c = emit_byte(c, 0xc1) // mov rcx, imm32
                                        c = emit_byte(c, sa_flat & 0xFF); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
                                        c = emit_byte(c, 0xf3); c = emit_byte(c, 0x48); c = emit_byte(c, 0xa5) // rep movsq
                                        c = emit_byte(c, 0x59); c = emit_byte(c, 0x5f); c = emit_byte(c, 0x5e) // pop rcx,rdi,rsi
                                    } else if slot >= 0 {
                                        c = micro_store_rax(c, slot)
                                    } else if slot <= -2000 {
                                        // Global scalar write
                                        let gwi = 0 - (slot + 2000)
                                        c = emit_global_scalar_write(c, gwi)
                                    }
                                } else if (*te).kind == ExprKind::ExprFieldAccess {
                                    // Struct field assignment: s.field = value
                                    // rax = RHS value (already compiled above)
                                    c = emit_byte(c, 0x50) // push rax (value)
                                    // Determine base type to find struct index
                                    let fa_base2: &Option<Box<Expr>> = &(*te).left
                                    var fa_base_type: i64 = 0
                                    match *fa_base2 {
                                        Some(fab) => {
                                            fa_base_type = ast_expr_result_type(&(*fab), ln, lt, lc, ctx)
                                            // Compile base → rax (address of struct via LEA)
                                            c = ast_compile_expr(c, &(*fab), ln, ls, lt, lc, ctx)
                                        }
                                        _ => {}
                                    }
                                    var fa_si: i64 = -1
                                    if fa_base_type >= 100 { fa_si = fa_base_type - 100 }
                                    else if fa_base_type >= 10 { fa_si = fa_base_type - 10 }
                                    if fa_si >= 0 {
                                        let fa_fi = ast_struct_field_info(ctx, fa_si, (*te).name)
                                        if fa_fi >= 0 {
                                            let fa_foff = ctx.sf_flat_offset[fa_fi as usize]
                                            let fa_off = 0 - (fa_foff * 8)
                                            // rax = struct base address
                                            // pop rdx = value
                                            c = emit_byte(c, 0x5a) // pop rdx
                                            // mov [rax + off], rdx: 48 89 90 <disp32>
                                            c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0x90)
                                            c = emit_byte(c, fa_off & 0xFF); c = emit_byte(c, (fa_off >> 8) & 0xFF)
                                            c = emit_byte(c, (fa_off >> 16) & 0xFF); c = emit_byte(c, (fa_off >> 24) & 0xFF)
                                        }
                                    }
                                } else if (*te).kind == ExprKind::ExprIndex {
                                    // Array index assignment: ARR[idx] = value
                                    // rax = value from RHS. Check if base is a global.
                                    let aib: &Option<Box<Expr>> = &(*te).left
                                    var assign_gi: i64 = -1
                                    match *aib {
                                        Some(ab) => {
                                            if (*ab).kind == ExprKind::ExprIdent {
                                                var aslot: i64 = -1
                                                var abli = lc - 1
                                                while abli >= 0 {
                                                    if ir_name_eq(ln[abli as usize], (*ab).name) {
                                                        aslot = ls[abli as usize]
                                                        abli = -1
                                                    } else { abli = abli - 1 }
                                                }
                                                if aslot <= -2000 {
                                                    assign_gi = 0 - (aslot + 2000)
                                                }
                                            }
                                        }
                                        _ => {}
                                    }
                                    if assign_gi >= 0 {
                                        // Global array index assignment
                                        // rax = value (from RHS already compiled above)
                                        c = emit_byte(c, 0x50) // push rax (value)
                                        // Compile index
                                        let aii: &Option<Box<Expr>> = &(*te).right
                                        match *aii {
                                            Some(ai) => {
                                                c = ast_compile_expr(c, &(*ai), ln, ls, lt, lc, ctx)
                                            }
                                            _ => {}
                                        }
                                        // rax = index. Compute element address.
                                        c = emit_global_array_addr(c, assign_gi)
                                        // rax = &arr[idx], pop rdx = value
                                        c = emit_byte(c, 0x5a) // pop rdx
                                        let aesz = GLOBAL_ELEM_SIZES[assign_gi as usize]
                                        if aesz == 1 {
                                            // mov [rax], dl (88 10)
                                            c = emit_byte(c, 0x88); c = emit_byte(c, 0x10)
                                        } else {
                                            // mov [rax], rdx (48 89 10)
                                            c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0x10)
                                        }
                                    } else {
                                        // Local array index assignment
                                        c = emit_byte(c, 0x50) // push rax (value)
                                        // Compile base
                                        match *aib {
                                            Some(ab2) => {
                                                c = ast_compile_expr(c, &(*ab2), ln, ls, lt, lc, ctx)
                                            }
                                            _ => {}
                                        }
                                        c = emit_byte(c, 0x50) // push rax (base)
                                        // Compile index
                                        let aii2: &Option<Box<Expr>> = &(*te).right
                                        match *aii2 {
                                            Some(ai2) => {
                                                c = ast_compile_expr(c, &(*ai2), ln, ls, lt, lc, ctx)
                                            }
                                            _ => {}
                                        }
                                        // rax=index, pop rcx=base, pop rdx=value
                                        c = emit_byte(c, 0x59) // pop rcx (base)
                                        c = emit_byte(c, 0x5a) // pop rdx (value)
                                        // mov [rcx + rax*8], rdx
                                        c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0x14); c = emit_byte(c, 0xc1)
                                    }
                                }
                            }
                            _ => {}
                        }
                    }
                }
                stmt_cur = &(*sl).tail
            }
            _ => break
        }
    }
    c
}

fn ast_compile_fn_body(code: CodeBuffer, fd: &FnDef,
    fn_count: i64,
    ctx: &AstCompileCtx
) -> CodeBuffer with Mut, Panic, Div, IO {
    var c = code
    var local_names: [Name; 512] = [ir_empty_name(); 512]
    var local_slots: [i64; 512] = [0; 512]
    var local_types: [i64; 512] = [0; 512]
    var local_count: i64 = 0
    var next_slot: i64 = 0

    // Detect if this function returns a struct (sret convention)
    var is_sret = false
    var sret_struct_idx: i64 = -1
    var sret_flat_size: i64 = 0
    var sret_dest_slot: i64 = -1
    let rt_ref: &Option<Box<TypeExpr>> = &fd.return_type
    match *rt_ref {
        Some(rte) => {
            if (*rte).kind == TypeExprKind::TypeNamed && !ast_type_is_f64(&(*rte)) {
                let rt_name = ast_name_from_path(&(*rte).path)
                let rt_si = ast_lookup_struct(ctx, rt_name)
                if rt_si >= 0 {
                    is_sret = true
                    sret_struct_idx = rt_si
                    sret_flat_size = ctx.struct_flat_size[rt_si as usize]
                }
            } else if (*rte).kind == TypeExprKind::TypeTuple {
                // Tuple return type — look up already-registered tuple struct
                let tsi = ast_lookup_tuple2_struct(ctx, &(*rte))
                if tsi >= 0 {
                    is_sret = true
                    sret_struct_idx = tsi
                    sret_flat_size = ctx.struct_flat_size[tsi as usize]
                }
            }
        }
        _ => {}
    }

    // If sret, save the hidden first param (rdi = sret destination pointer)
    if is_sret {
        sret_dest_slot = next_slot
        next_slot = next_slot + 1
        // mov rax, rdi
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xf8)
        c = micro_store_rax(c, sret_dest_slot)
        // Store sret_dest_slot in CodeBuffer metadata for ExprReturn to use
        c = code_set_sret_slot(c, sret_dest_slot)
    }

    // Register function names as locals with negative slots (for call resolution)
    var fi: i64 = 0
    while fi < fn_count && local_count < 512 {
        local_names[local_count as usize] = ctx.fn_names[fi as usize]
        local_slots[local_count as usize] = 0 - 1000 - fi
        local_types[local_count as usize] = ctx.fn_return_types[fi as usize]
        local_count = local_count + 1
        fi = fi + 1
    }

    // Register global variables with special negative slots (slot = -2000 - global_idx)
    var gi: i64 = 0
    while gi < GLOBAL_COUNT && local_count < 512 {
        local_names[local_count as usize] = GLOBAL_NAMES[gi as usize]
        local_slots[local_count as usize] = 0 - 2000 - gi
        // Type: 2 for arrays (> 8 bytes), 0 for scalars
        if GLOBAL_SIZES[gi as usize] > 8 {
            local_types[local_count as usize] = 2
        } else {
            local_types[local_count as usize] = 0
        }
        local_count = local_count + 1
        gi = gi + 1
    }

    // Register params with extended calling convention
    // Without sret: rdi=p0, rsi=p1, rdx=p2, rcx=p3, r8=p4, r9=p5, stack=p6+
    // With sret: rdi=sret, rsi=p0, rdx=p1, rcx=p2, r8=p3, r9=p4, stack=p5+
    var param_ref: &Option<Box<ParamList>> = &fd.params
    var param_idx: i64 = 0
    while true {
        match *param_ref {
            Some(pl) => {
                let p_name = (*pl).head.name
                let p_ty: &TypeExpr = &(*pl).head.ty
                // Detect param type
                var p_type: i64 = 0
                if ast_type_is_f64(p_ty) {
                    p_type = 1
                } else if p_ty.kind == TypeExprKind::TypeReference || p_ty.kind == TypeExprKind::TypeRefMut {
                    p_type = 3
                } else if p_ty.kind == TypeExprKind::TypeArray {
                    p_type = 2
                } else if p_ty.kind == TypeExprKind::TypeNamed {
                    let pt_name = ast_name_from_path(&p_ty.path)
                    let pt_si = ast_lookup_struct(ctx, pt_name)
                    if pt_si >= 0 {
                        p_type = 100 + pt_si  // struct param = pointer to struct data
                    }
                }
                let p_slot = next_slot
                next_slot = next_slot + 1
                local_names[local_count as usize] = p_name
                local_slots[local_count as usize] = p_slot
                local_types[local_count as usize] = p_type
                local_count = local_count + 1
                // Compute register index with sret shift
                var reg_idx = param_idx
                if is_sret { reg_idx = param_idx + 1 }
                // Spill register or load from stack → rax
                if reg_idx == 0 {
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xf8) // mov rax, rdi
                } else if reg_idx == 1 {
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xf0) // mov rax, rsi
                } else if reg_idx == 2 {
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xd0) // mov rax, rdx
                } else if reg_idx == 3 {
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc8) // mov rax, rcx
                } else if reg_idx == 4 {
                    c = emit_byte(c, 0x4c); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc0) // mov rax, r8
                } else if reg_idx == 5 {
                    c = emit_byte(c, 0x4c); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc8) // mov rax, r9
                } else {
                    // Stack param: mov rax, [rbp + 16 + 8*(reg_idx - 6)]
                    let stk_disp = 16 + 8 * (reg_idx - 6)
                    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8b); c = emit_byte(c, 0x85)
                    c = emit_byte(c, stk_disp & 0xFF); c = emit_byte(c, (stk_disp >> 8) & 0xFF)
                    c = emit_byte(c, (stk_disp >> 16) & 0xFF); c = emit_byte(c, (stk_disp >> 24) & 0xFF)
                }
                c = micro_store_rax(c, p_slot)
                param_idx = param_idx + 1
                param_ref = &(*pl).tail
            }
            _ => break
        }
    }

    // Initialize next_slot tracker in code buffer
    c = code_set_ns(c, next_slot)

    // Compile body using ast_compile_block
    c = ast_compile_block(c, &fd.body, local_names, local_slots, local_types, local_count, ctx)

    // If sret: copy result struct to sret destination
    if is_sret {
        // rax = source base (highest addr). Adjust to lowest for rep movsq.
        c = emit_byte(c, 0x56); c = emit_byte(c, 0x57); c = emit_byte(c, 0x51) // push rsi,rdi,rcx
        if sret_flat_size > 1 {
            let sadj = (sret_flat_size - 1) * 8
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x2d) // sub rax, imm32
            c = emit_byte(c, sadj & 0xFF); c = emit_byte(c, (sadj >> 8) & 0xFF)
            c = emit_byte(c, (sadj >> 16) & 0xFF); c = emit_byte(c, (sadj >> 24) & 0xFF)
        }
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc6) // mov rsi, rax
        // Load sret dest (highest addr), adjust to lowest
        c = micro_load_rax(c, sret_dest_slot)
        if sret_flat_size > 1 {
            let dadj = (sret_flat_size - 1) * 8
            c = emit_byte(c, 0x48); c = emit_byte(c, 0x2d) // sub rax, imm32
            c = emit_byte(c, dadj & 0xFF); c = emit_byte(c, (dadj >> 8) & 0xFF)
            c = emit_byte(c, (dadj >> 16) & 0xFF); c = emit_byte(c, (dadj >> 24) & 0xFF)
        }
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc7) // mov rdi, rax
        c = emit_byte(c, 0x48); c = emit_byte(c, 0xc7); c = emit_byte(c, 0xc1) // mov rcx, imm32
        c = emit_byte(c, sret_flat_size & 0xFF); c = emit_byte(c, 0); c = emit_byte(c, 0); c = emit_byte(c, 0)
        c = emit_byte(c, 0xf3); c = emit_byte(c, 0x48); c = emit_byte(c, 0xa5) // rep movsq
        c = emit_byte(c, 0x59); c = emit_byte(c, 0x5f); c = emit_byte(c, 0x5e) // pop rcx,rdi,rsi
        // Return sret dest address in rax (highest addr)
        c = micro_load_rax(c, sret_dest_slot)
    }

    // If function has no return type, ensure rax=0
    var has_return_type = false
    match *rt_ref {
        Some(rt2) => { has_return_type = true }
        _ => {}
    }
    if !has_return_type {
        c = emit_byte(c, 0x48); c = emit_byte(c, 0x31); c = emit_byte(c, 0xc0) // xor rax, rax
    }

    c
}

// ============================================================================
// Mini-compiler: one-pass token→x86-64→ELF for simple programs.
// Handles: fn NAME(PARAMS) -> RETTYPE { return INTLIT }
// Uses WIDE_OUT/WIDE_LEN for code, GLOBAL_ELF for output.
// Bypasses the full AST-direct pipeline (avoids IS_SPTR=4 and FIX_OFF overflow).
// ============================================================================

fn we(b: i64) with Mut {
    if WIDE_LEN < 16777216 { WIDE_OUT[WIDE_LEN as usize] = b as i8; WIDE_LEN = WIDE_LEN + 1 }
}

fn we32(v: i64) with Mut {
    we(v & 0xFF); we((v >> 8) & 0xFF); we((v >> 16) & 0xFF); we((v >> 24) & 0xFF)
}

fn we64(v: i64) with Mut {
    we32(v & 0xFFFFFFFF); we32((v >> 32) & 0xFFFFFFFF)
}

fn elf_write_byte(buf_idx: i64, v: i64) with Mut, Panic {
    GLOBAL_ELF[buf_idx as usize] = v as i8
}

fn elf_write_u16(off: i64, v: i64) with Mut, Panic {
    elf_write_byte(off, v & 0xFF); elf_write_byte(off + 1, (v >> 8) & 0xFF)
}

fn elf_write_u32(off: i64, v: i64) with Mut, Panic {
    elf_write_byte(off, v & 0xFF); elf_write_byte(off + 1, (v >> 8) & 0xFF)
    elf_write_byte(off + 2, (v >> 16) & 0xFF); elf_write_byte(off + 3, (v >> 24) & 0xFF)
}

fn elf_write_u64(off: i64, v: i64) with Mut, Panic {
    elf_write_u32(off, v & 0xFFFFFFFF); elf_write_u32(off + 4, (v >> 32) & 0xFFFFFFFF)
}

// ============================================================================
// Boot4-safe lexer: avoids TokenKind enum entirely, uses raw integer constants.
// Writes to MP_KIND/MP_START/MP_END/MP_INT_VALUE arrays.
// Token kind values match the TokenKind enum discriminant numbering.
// ============================================================================

fn mc_is_ws(ch: i8) -> bool { ch == 32 || ch == 9 || ch == 13 || ch == 10 }
fn mc_is_digit(ch: i8) -> bool { ch >= 48 && ch <= 57 }
fn mc_is_alpha(ch: i8) -> bool {
    (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95
}
fn mc_is_alnum(ch: i8) -> bool { mc_is_alpha(ch) || mc_is_digit(ch) }

fn mc_src_byte(idx: i64) -> i8 with Panic {
    if idx >= 0 && idx < LEAN_SOURCE_LEN { LEAN_SOURCE[idx as usize] } else { 0 as i8 }
}

// Keyword lookup: returns token kind integer directly (no enum)
// 0=Eof, 7=Fn, 8=Let, 9=Var, 17=If, 18=Else, 21=While, 23=Break,
// 24=Continue, 25=Return, 27=As, 32=True, 33=False, 42=With, 120=Ident
fn mc_kw_lookup(start: i64, len: i64) -> i64 with Panic {
    let b0 = mc_src_byte(start)
    let b1 = if len > 1 { mc_src_byte(start + 1) } else { 0 as i8 }
    let b2 = if len > 2 { mc_src_byte(start + 2) } else { 0 as i8 }
    let b3 = if len > 3 { mc_src_byte(start + 3) } else { 0 as i8 }
    let b4 = if len > 4 { mc_src_byte(start + 4) } else { 0 as i8 }
    let b5 = if len > 5 { mc_src_byte(start + 5) } else { 0 as i8 }
    let b6 = if len > 6 { mc_src_byte(start + 6) } else { 0 as i8 }
    let b7 = if len > 7 { mc_src_byte(start + 7) } else { 0 as i8 }
    if len == 2 {
        // fn
        if b0 == 102 && b1 == 110 { return 7 }
        // if
        if b0 == 105 && b1 == 102 { return 17 }
        // as
        if b0 == 97 && b1 == 115 { return 27 }
        // in
        if b0 == 105 && b1 == 110 { return 120 }
    }
    if len == 3 {
        // let
        if b0 == 108 && b1 == 101 && b2 == 116 { return 8 }
        // var
        if b0 == 118 && b1 == 97 && b2 == 114 { return 9 }
        // for
        if b0 == 102 && b1 == 111 && b2 == 114 { return 21 }
        // use
        if b0 == 117 && b1 == 115 && b2 == 101 { return 120 }
        // pub
        if b0 == 112 && b1 == 117 && b2 == 98 { return 120 }
    }
    if len == 4 {
        // else
        if b0 == 101 && b1 == 108 && b2 == 115 && b3 == 101 { return 18 }
        // true
        if b0 == 116 && b1 == 114 && b2 == 117 && b3 == 101 { return 32 }
        // with
        if b0 == 119 && b1 == 105 && b2 == 116 && b3 == 104 { return 42 }
        // type
        if b0 == 116 && b1 == 121 && b2 == 112 && b3 == 101 { return 120 }
        // impl
        if b0 == 105 && b1 == 109 && b2 == 112 && b3 == 108 { return 120 }
        // enum
        if b0 == 101 && b1 == 110 && b2 == 117 && b3 == 109 { return 201 }
        // loop
        if b0 == 108 && b1 == 111 && b2 == 111 && b3 == 112 { return 21 }
        // None
        if b0 == 78 && b1 == 111 && b2 == 110 && b3 == 101 { return 120 }
        // Some
        if b0 == 83 && b1 == 111 && b2 == 109 && b3 == 101 { return 120 }
    }
    if len == 5 {
        // while
        if b0 == 119 && b1 == 104 && b2 == 105 && b3 == 108 && b4 == 101 { return 21 }
        // break
        if b0 == 98 && b1 == 114 && b2 == 101 && b3 == 97 && b4 == 107 { return 23 }
        // false
        if b0 == 102 && b1 == 97 && b2 == 108 && b3 == 115 && b4 == 101 { return 33 }
        // match
        if b0 == 109 && b1 == 97 && b2 == 116 && b3 == 99 && b4 == 104 { return 202 }
        // const
        if b0 == 99 && b1 == 111 && b2 == 110 && b3 == 115 && b4 == 116 { return 120 }
    }
    if len == 6 {
        // return
        if b0 == 114 && b1 == 101 && b2 == 116 && b3 == 117 && b4 == 114 && b5 == 110 { return 25 }
        // struct
        if b0 == 115 && b1 == 116 && b2 == 114 && b3 == 117 && b4 == 99 && b5 == 116 { return 200 }
        // module
        if b0 == 109 && b1 == 111 && b2 == 100 && b3 == 117 && b4 == 108 && b5 == 101 { return 120 }
        // linear
        if b0 == 108 && b1 == 105 && b2 == 110 && b3 == 101 && b4 == 97 && b5 == 114 { return 120 }
    }
    if len == 8 {
        // continue
        if b0 == 99 && b1 == 111 && b2 == 110 && b3 == 116 && b4 == 105 && b5 == 110 && b6 == 117 && b7 == 101 { return 24 }
    }
    120  // Ident
}

// Parse integer literal from source bytes
fn mc_parse_int(start: i64, end: i64) -> i64 with Panic {
    var val: i64 = 0
    var p: i64 = start
    var neg = false
    if p < end && mc_src_byte(p) == 45 { neg = true; p = p + 1 }
    // Check for hex: 0x
    if p + 1 < end && mc_src_byte(p) == 48 && (mc_src_byte(p + 1) == 120 || mc_src_byte(p + 1) == 88) {
        p = p + 2
        while p < end {
            let c = mc_src_byte(p) as i64
            if c >= 48 && c <= 57 { val = val * 16 + (c - 48) }
            else if c >= 97 && c <= 102 { val = val * 16 + (c - 87) }
            else if c >= 65 && c <= 70 { val = val * 16 + (c - 55) }
            else if c == 95 { 0 }
            else { break }
            p = p + 1
        }
    }
    // Check for binary: 0b
    else if p + 1 < end && mc_src_byte(p) == 48 && (mc_src_byte(p + 1) == 98 || mc_src_byte(p + 1) == 66) {
        p = p + 2
        while p < end {
            let c = mc_src_byte(p) as i64
            if c == 48 || c == 49 { val = val * 2 + (c - 48) }
            else if c == 95 { 0 }
            else { break }
            p = p + 1
        }
    } else {
        while p < end {
            let c = mc_src_byte(p) as i64
            if c >= 48 && c <= 57 { val = val * 10 + (c - 48) }
            else if c == 95 { 0 }
            else { break }
            p = p + 1
        }
    }
    if neg { 0 - val } else { val }
}

// Parse float literal parts from source bytes into arrays (boot4-safe, no f64 ops).
// Stores integer part, fractional numerator, and denominator separately.
// Actual IEEE 754 conversion happens at codegen time via x86-64 SSE2.
fn mc_parse_float_parts(tc: i64, start: i64, end: i64) with Panic, Mut {
    var int_part: i64 = 0
    var p: i64 = start
    while p < end && mc_src_byte(p) != 46 {
        let c = mc_src_byte(p) as i64
        if c >= 48 && c <= 57 { int_part = int_part * 10 + (c - 48) }
        p = p + 1
    }
    if p < end && mc_src_byte(p) == 46 { p = p + 1 }
    var frac_val: i64 = 0
    var frac_digits: i64 = 0
    while p < end {
        let c = mc_src_byte(p) as i64
        if c >= 48 && c <= 57 { frac_val = frac_val * 10 + (c - 48); frac_digits = frac_digits + 1 }
        else if c == 95 { 0 }
        else { break }
        p = p + 1
    }
    var divisor: i64 = 1
    var di: i64 = 0
    while di < frac_digits { divisor = divisor * 10; di = di + 1 }
    MP_FLOAT_INT[tc as usize] = int_part
    MP_FLOAT_FRAC[tc as usize] = frac_val
    MP_FLOAT_DENOM[tc as usize] = divisor
}

// Boot4-safe lexer: writes to MP_KIND/MP_START/MP_END/MP_INT_VALUE
fn mc_lex() -> i64 with Mut, Panic, Div {
    var p: i64 = 0
    var tc: i64 = 0
    let n = LEAN_SOURCE_LEN
    while p < n {
        let ch = mc_src_byte(p)
        // Whitespace
        if ch == 32 || ch == 9 || ch == 13 || ch == 10 { p = p + 1; continue }
        // Line comment: //
        if ch == 47 && p + 1 < n && mc_src_byte(p + 1) == 47 {
            p = p + 2
            while p < n && mc_src_byte(p) != 10 { p = p + 1 }
            continue
        }
        // Block comment: /* ... */
        if ch == 47 && p + 1 < n && mc_src_byte(p + 1) == 42 {
            var depth: i64 = 1
            p = p + 2
            while p + 1 < n && depth > 0 {
                if mc_src_byte(p) == 47 && mc_src_byte(p + 1) == 42 { depth = depth + 1; p = p + 2; continue }
                if mc_src_byte(p) == 42 && mc_src_byte(p + 1) == 47 { depth = depth - 1; p = p + 2; continue }
                p = p + 1
            }
            continue
        }
        // String literal
        if ch == 34 {
            let ss = p
            p = p + 1
            while p < n && mc_src_byte(p) != 34 {
                if mc_src_byte(p) == 92 { p = p + 1 }
                p = p + 1
            }
            if p < n { p = p + 1 }
            MP_KIND[tc as usize] = 123  // StringLit
            MP_START[tc as usize] = ss
            MP_END[tc as usize] = p
            MP_INT_VALUE[tc as usize] = 0
            tc = tc + 1
            continue
        }
        // Number literal
        if mc_is_digit(ch) {
            let ns = p
            // Check for hex/bin prefix
            if ch == 48 && p + 1 < n && (mc_src_byte(p + 1) == 120 || mc_src_byte(p + 1) == 88 || mc_src_byte(p + 1) == 98 || mc_src_byte(p + 1) == 66) {
                p = p + 2
                while p < n && (mc_is_alnum(mc_src_byte(p)) || mc_src_byte(p) == 95) { p = p + 1 }
            } else {
                while p < n && (mc_is_digit(mc_src_byte(p)) || mc_src_byte(p) == 95) { p = p + 1 }
                // Check for float (e.g. 1.5)
                if p < n && mc_src_byte(p) == 46 && p + 1 < n && mc_is_digit(mc_src_byte(p + 1)) {
                    p = p + 1
                    while p < n && (mc_is_digit(mc_src_byte(p)) || mc_src_byte(p) == 95) { p = p + 1 }
                    MP_KIND[tc as usize] = 122  // FloatLit
                    MP_START[tc as usize] = ns
                    MP_END[tc as usize] = p
                    mc_parse_float_parts(tc, ns, p)
                    tc = tc + 1
                    continue
                }
            }
            MP_KIND[tc as usize] = 121  // IntLit
            MP_START[tc as usize] = ns
            MP_END[tc as usize] = p
            MP_INT_VALUE[tc as usize] = mc_parse_int(ns, p)
            tc = tc + 1
            continue
        }
        // Identifier / keyword
        if mc_is_alpha(ch) {
            let is = p
            while p < n && mc_is_alnum(mc_src_byte(p)) { p = p + 1 }
            let ilen = p - is
            let kind = mc_kw_lookup(is, ilen)
            MP_KIND[tc as usize] = kind
            MP_START[tc as usize] = is
            MP_END[tc as usize] = p
            MP_INT_VALUE[tc as usize] = 0
            tc = tc + 1
            continue
        }
        // Operators and punctuation (multi-char first)
        let c1 = if p + 1 < n { mc_src_byte(p + 1) } else { 0 as i8 }
        var matched: i64 = 0
        // ==
        if matched == 0 && ch == 61 && c1 == 61 { MP_KIND[tc as usize] = 143; MP_START[tc as usize] = p; MP_END[tc as usize] = p + 2; tc = tc + 1; p = p + 2; matched = 1 }
        // !=
        if matched == 0 && ch == 33 && c1 == 61 { MP_KIND[tc as usize] = 144; MP_START[tc as usize] = p; MP_END[tc as usize] = p + 2; tc = tc + 1; p = p + 2; matched = 1 }
        // <=
        if matched == 0 && ch == 60 && c1 == 61 { MP_KIND[tc as usize] = 145; MP_START[tc as usize] = p; MP_END[tc as usize] = p + 2; tc = tc + 1; p = p + 2; matched = 1 }
        // >=
        if matched == 0 && ch == 62 && c1 == 61 { MP_KIND[tc as usize] = 146; MP_START[tc as usize] = p; MP_END[tc as usize] = p + 2; tc = tc + 1; p = p + 2; matched = 1 }
        // &&
        if matched == 0 && ch == 38 && c1 == 38 { MP_KIND[tc as usize] = 147; MP_START[tc as usize] = p; MP_END[tc as usize] = p + 2; tc = tc + 1; p = p + 2; matched = 1 }
        // ||
        if matched == 0 && ch == 124 && c1 == 124 { MP_KIND[tc as usize] = 148; MP_START[tc as usize] = p; MP_END[tc as usize] = p + 2; tc = tc + 1; p = p + 2; matched = 1 }
        // ->
        if matched == 0 && ch == 45 && c1 == 62 { MP_KIND[tc as usize] = 155; MP_START[tc as usize] = p; MP_END[tc as usize] = p + 2; tc = tc + 1; p = p + 2; matched = 1 }
        // =>
        if matched == 0 && ch == 61 && c1 == 62 { MP_KIND[tc as usize] = 156; MP_START[tc as usize] = p; MP_END[tc as usize] = p + 2; tc = tc + 1; p = p + 2; matched = 1 }
        // ::
        if matched == 0 && ch == 58 && c1 == 58 { MP_KIND[tc as usize] = 159; MP_START[tc as usize] = p; MP_END[tc as usize] = p + 2; tc = tc + 1; p = p + 2; matched = 1 }
        // &!
        if matched == 0 && ch == 38 && c1 == 33 { MP_KIND[tc as usize] = 160; MP_START[tc as usize] = p; MP_END[tc as usize] = p + 2; tc = tc + 1; p = p + 2; matched = 1 }
        // +=
        if matched == 0 && ch == 43 && c1 == 61 { MP_KIND[tc as usize] = 151; MP_START[tc as usize] = p; MP_END[tc as usize] = p + 2; tc = tc + 1; p = p + 2; matched = 1 }
        // -=
        if matched == 0 && ch == 45 && c1 == 61 { MP_KIND[tc as usize] = 152; MP_START[tc as usize] = p; MP_END[tc as usize] = p + 2; tc = tc + 1; p = p + 2; matched = 1 }
        // *=
        if matched == 0 && ch == 42 && c1 == 61 { MP_KIND[tc as usize] = 153; MP_START[tc as usize] = p; MP_END[tc as usize] = p + 2; tc = tc + 1; p = p + 2; matched = 1 }
        // <<
        if matched == 0 && ch == 60 && c1 == 60 { MP_KIND[tc as usize] = 149; MP_START[tc as usize] = p; MP_END[tc as usize] = p + 2; tc = tc + 1; p = p + 2; matched = 1 }
        // >>
        if matched == 0 && ch == 62 && c1 == 62 { MP_KIND[tc as usize] = 150; MP_START[tc as usize] = p; MP_END[tc as usize] = p + 2; tc = tc + 1; p = p + 2; matched = 1 }
        // ++
        if matched == 0 && ch == 43 && c1 == 43 { MP_KIND[tc as usize] = 161; MP_START[tc as usize] = p; MP_END[tc as usize] = p + 2; tc = tc + 1; p = p + 2; matched = 1 }
        if matched == 1 { continue }
        // Single-char operators
        var sk: i64 = 0
        if ch == 43 { sk = 129 }       // +
        else if ch == 45 { sk = 130 }  // -
        else if ch == 42 { sk = 131 }  // *
        else if ch == 47 { sk = 132 }  // /
        else if ch == 37 { sk = 133 }  // %
        else if ch == 61 { sk = 134 }  // =
        else if ch == 60 { sk = 135 }  // <
        else if ch == 62 { sk = 136 }  // >
        else if ch == 33 { sk = 137 }  // !
        else if ch == 38 { sk = 138 }  // &
        else if ch == 124 { sk = 139 } // |
        else if ch == 94 { sk = 140 }  // ^
        else if ch == 126 { sk = 141 } // ~
        else if ch == 40 { sk = 171 }  // (
        else if ch == 41 { sk = 172 }  // )
        else if ch == 123 { sk = 173 } // {
        else if ch == 125 { sk = 174 } // }
        else if ch == 91 { sk = 175 }  // [
        else if ch == 93 { sk = 176 }  // ]
        else if ch == 59 { sk = 177 }  // ;
        else if ch == 58 { sk = 178 }  // :
        else if ch == 44 { sk = 179 }  // ,
        else if ch == 46 { sk = 180 }  // .
        else if ch == 64 { sk = 181 }  // @
        else if ch == 35 { sk = 182 }  // #
        if sk > 0 {
            MP_KIND[tc as usize] = sk
            MP_START[tc as usize] = p
            MP_END[tc as usize] = p + 1
            MP_INT_VALUE[tc as usize] = 0
            tc = tc + 1
            p = p + 1
            continue
        }
        // Char literal
        if ch == 39 {
            let cs = p
            p = p + 1
            if p < n && mc_src_byte(p) == 92 { p = p + 1 }
            if p < n { p = p + 1 }
            if p < n && mc_src_byte(p) == 39 { p = p + 1 }
            MP_KIND[tc as usize] = 124  // CharLit
            MP_START[tc as usize] = cs
            MP_END[tc as usize] = p
            tc = tc + 1
            continue
        }
        // Unknown: skip
        p = p + 1
    }
    // EOF token
    MP_KIND[tc as usize] = 0
    MP_START[tc as usize] = p
    MP_END[tc as usize] = p
    MP_INT_VALUE[tc as usize] = 0
    tc = tc + 1
    tc
}

// ============================================================================
// Mini-compiler v2: single-pass token→x86-64 with full expression support.
// Recursive descent parser reads from MP_KIND/MP_START/MP_END/MP_INT_VALUE.
// Each parse function directly emits x86-64 via we()/we32()/we64().
// Local variables tracked via MC_LOCAL_* arrays (name → stack slot).
// Function offsets stored in MC_FN_OFF[] for call patching.
// ============================================================================

// --- Mini-compiler global state ---
var MC_POS: i64 = 0       // current token position in MP_* arrays
var MC_TC: i64 = 0        // total token count

// Function registry (pass 1 collects, pass 2 compiles)
var MC_FN_NAME_START: [i64; 256] = [0; 256]  // source offset of fn name
var MC_FN_NAME_LEN: [i64; 256] = [0; 256]    // length of fn name
var MC_FN_OFF: [i64; 256] = [0; 256]          // WIDE_LEN offset of fn code
var MC_FN_BODY_TOK: [i64; 256] = [0; 256]    // token index of opening { of body
var MC_FN_PARAM_COUNT: [i64; 256] = [0; 256]
var MC_FN_PARAM_BASE: [i64; 256] = [0; 256]  // index into MC_PARAM_* arrays
var MC_FN_COUNT: i64 = 0
var MC_MAIN_FN: i64 = -1
var MC_PRINT_INT_OFF: i64 = 0  // WIDE_LEN offset of print_int helper

// Parameter name storage (flat, indexed by MC_FN_PARAM_BASE + i)
var MC_PARAM_NAME_START: [i64; 1024] = [0; 1024]
var MC_PARAM_NAME_LEN: [i64; 1024] = [0; 1024]
var MC_PARAM_TOTAL: i64 = 0

// Local variable registry (per-function, reset before each fn body)
var MC_LOC_NAME_START: [i64; 512] = [0; 512]
var MC_LOC_NAME_LEN: [i64; 512] = [0; 512]
var MC_LOC_SLOT: [i64; 512] = [0; 512]
var MC_LOC_IS_F64: [i64; 512] = [0; 512]   // 1 if local is f64, 0 if i64
var MC_LOC_COUNT: i64 = 0
var MC_NEXT_SLOT: i64 = 0

// f64 expression type propagation: set by codegen, read by callers
var MC_EXPR_IS_F64: i64 = 0

// print_f64 helper offset
var MC_PRINT_F64_OFF: i64 = 0

// Call fixup table: sentinel bytes to patch with real offsets
var MC_CALL_FIX_OFF: [i64; 2048] = [0; 2048]    // WIDE_LEN position of rel32
var MC_CALL_FIX_TARGET: [i64; 2048] = [0; 2048]  // fn index
var MC_CALL_FIX_COUNT: i64 = 0

// While loop state (stack for nesting)
var MC_LOOP_TOP_STACK: [i64; 32] = [0; 32]
var MC_LOOP_DEPTH: i64 = 0
var MC_BREAK_FIX_OFF: [i64; 256] = [0; 256]
var MC_BREAK_FIX_DEPTH: [i64; 256] = [0; 256]
var MC_BREAK_FIX_COUNT: i64 = 0

// --- Match end-jump fixups (global to avoid boot4 local array issues) ---
var MC_MATCH_END_FIX: [i64; 64] = [0; 64]
var MC_MATCH_END_FIX_COUNT: i64 = 0

// --- Import resolution state ---
// Scratch buffer for constructing import file paths (e.g. "self-hosted/lexer/cursor.sio")
var MC_IMP_FNAME: [i8; 512] = [0; 512]
// Dedup registry: store loaded file path bytes in MC_IMP_PATH_BUF, track offsets/lengths
var MC_IMP_PATH_BUF: [i8; 8192] = [0; 8192]
var MC_IMP_PATH_OFF: [i64; 128] = [0; 128]   // byte offset into MC_IMP_PATH_BUF for each loaded path
var MC_IMP_PATH_LEN: [i64; 128] = [0; 128]   // byte length of each loaded path
var MC_IMP_COUNT: i64 = 0                      // number of loaded imports
var MC_IMP_PATH_BUF_POS: i64 = 0             // next free position in MC_IMP_PATH_BUF
// Base directory of the source file (for relative import resolution)
var MC_IMP_BASE_DIR: [i8; 512] = [0; 512]
var MC_IMP_BASE_DIR_LEN: i64 = 0

// --- Struct registry (populated in mc_scan_structs, before mc_scan_functions) ---
// Up to 64 structs, each with up to 32 fields.
var MC_ST_COUNT: i64 = 0
var MC_ST_NAME_START: [i64; 64] = [0; 64]    // source offset of struct name
var MC_ST_NAME_LEN: [i64; 64] = [0; 64]      // length of struct name
var MC_ST_FIELD_COUNT: [i64; 64] = [0; 64]   // number of fields
var MC_ST_FLAT_SIZE: [i64; 64] = [0; 64]     // total 8-byte slots (sum of field flat sizes)
// Per-field storage: flat, indexed by MC_ST_FIELD_BASE[struct_idx] + field_idx
var MC_ST_FIELD_BASE: [i64; 64] = [0; 64]    // index into MC_SF_* arrays
var MC_SF_NAME_START: [i64; 512] = [0; 512]  // source offset of field name
var MC_SF_NAME_LEN: [i64; 512] = [0; 512]    // length of field name
var MC_SF_OFFSET: [i64; 512] = [0; 512]      // slot offset of field within struct
var MC_SF_FLAT_SIZE: [i64; 512] = [0; 512]   // flat size of field (1 for scalars, N for nested structs)
var MC_SF_TYPE_STRUCT: [i64; 512] = [0; 512]  // struct index if field is a struct type, else -1 (set at scan time)
var MC_SF_IS_F64: [i64; 512] = [0; 512]      // 1 if field type is f64, 0 otherwise
var MC_SF_TOTAL: i64 = 0

// --- Enum registry (populated in mc_scan_enums, before mc_scan_functions) ---
// Up to 64 enums, each with variants.
var MC_EN_COUNT: i64 = 0
var MC_EN_NAME_START: [i64; 64] = [0; 64]    // source offset of enum name
var MC_EN_NAME_LEN: [i64; 64] = [0; 64]      // length of enum name
var MC_EN_FIRST_EV: [i64; 64] = [0; 64]      // index of first variant in MC_EV_* arrays
var MC_EN_EV_COUNT: [i64; 64] = [0; 64]      // number of variants

// Per-variant storage: flat arrays, up to 512 variants total
var MC_EV_NAME_START: [i64; 512] = [0; 512]  // source offset of variant name
var MC_EV_NAME_LEN: [i64; 512] = [0; 512]    // length of variant name
var MC_EV_VALUE: [i64; 512] = [0; 512]       // discriminant value (0, 1, 2, ...)
var MC_EV_COUNT: i64 = 0

// --- Local variable type tracking (parallel to MC_LOC_*) ---
// -1 = scalar (i64/bool/etc), >=0 = struct index
var MC_LOC_TYPE: [i64; 512] = [0; 512]  // set to -1 by mc_add_local, >=0 by mc_add_local_struct

// --- Function parameter type tracking (parallel to MC_PARAM_*) ---
// -1 = scalar, >=0 = struct index
var MC_PARAM_TYPE: [i64; 1024] = [0; 1024]  // set per-param in mc_scan_functions
var MC_PARAM_IS_F64: [i64; 1024] = [0; 1024]  // 1 if param type is f64

// --- Function return type tracking ---
// -1 = scalar, >=0 = struct index
var MC_FN_RET_TYPE: [i64; 256] = [0; 256]  // set per-fn in mc_scan_functions

// Frame size: fixed 4096 bytes (512 slots * 8)
fn MC_FRAME_SIZE() -> i64 { 4096 }

// --- Token kind constants (from TokenKind enum discriminant numbering) ---
fn MC_TK_EOF() -> i64 { 0 }
fn MC_TK_FN() -> i64 { 7 }
fn MC_TK_LET() -> i64 { 8 }
fn MC_TK_VAR() -> i64 { 9 }
fn MC_TK_IF() -> i64 { 17 }
fn MC_TK_ELSE() -> i64 { 18 }
fn MC_TK_WHILE() -> i64 { 21 }
fn MC_TK_BREAK() -> i64 { 23 }
fn MC_TK_CONTINUE() -> i64 { 24 }
fn MC_TK_RETURN() -> i64 { 25 }
fn MC_TK_AS() -> i64 { 27 }
fn MC_TK_TRUE() -> i64 { 32 }
fn MC_TK_FALSE() -> i64 { 33 }
fn MC_TK_WITH() -> i64 { 42 }
fn MC_TK_IDENT() -> i64 { 120 }
fn MC_TK_INT() -> i64 { 121 }
fn MC_TK_FLOAT() -> i64 { 122 }
fn MC_TK_STR() -> i64 { 123 }
fn MC_TK_PLUS() -> i64 { 129 }
fn MC_TK_MINUS() -> i64 { 130 }
fn MC_TK_STAR() -> i64 { 131 }
fn MC_TK_SLASH() -> i64 { 132 }
fn MC_TK_PERCENT() -> i64 { 133 }
fn MC_TK_EQ() -> i64 { 134 }
fn MC_TK_LT() -> i64 { 135 }
fn MC_TK_GT() -> i64 { 136 }
fn MC_TK_BANG() -> i64 { 137 }
fn MC_TK_EQEQ() -> i64 { 143 }
fn MC_TK_BANGEQ() -> i64 { 144 }
fn MC_TK_LTEQ() -> i64 { 145 }
fn MC_TK_GTEQ() -> i64 { 146 }
fn MC_TK_AMPAMP() -> i64 { 147 }
fn MC_TK_PIPEPIPE() -> i64 { 148 }
fn MC_TK_ARROW() -> i64 { 155 }
fn MC_TK_LPAREN() -> i64 { 171 }
fn MC_TK_RPAREN() -> i64 { 172 }
fn MC_TK_LBRACE() -> i64 { 173 }
fn MC_TK_RBRACE() -> i64 { 174 }
fn MC_TK_LBRACKET() -> i64 { 175 }
fn MC_TK_RBRACKET() -> i64 { 176 }
fn MC_TK_SEMI() -> i64 { 177 }
fn MC_TK_COLON() -> i64 { 178 }
fn MC_TK_COMMA() -> i64 { 179 }
fn MC_TK_DOT() -> i64 { 180 }
fn MC_TK_MINUS_EQ() -> i64 { 152 }
fn MC_TK_PLUS_EQ() -> i64 { 151 }
fn MC_TK_STAR_EQ() -> i64 { 153 }
fn MC_TK_STRUCT() -> i64 { 200 }  // synthetic token kind for struct keyword
fn MC_TK_ENUM() -> i64 { 201 }    // synthetic token kind for enum keyword
fn MC_TK_MATCH() -> i64 { 202 }   // synthetic token kind for match keyword
fn MC_TK_COLONCOLON() -> i64 { 159 }  // :: token
fn MC_TK_FATARROW() -> i64 { 156 }    // => token

// --- Token access helpers ---
fn mc_peek() -> i64 with Panic {
    if MC_POS >= MC_TC { return MC_TK_EOF() }
    MP_KIND[MC_POS as usize]
}

fn mc_advance() with Mut, Panic {
    if MC_POS < MC_TC { MC_POS = MC_POS + 1 }
}

fn mc_expect(kind: i64) with Mut, Panic {
    if mc_peek() != kind {
        print("mc_expect: expected tk=")
        print_int(kind)
        print(" got=")
        print_int(mc_peek())
        print(" at pos=")
        print_int(MC_POS)
        print("\n")
    }
    mc_advance()
}

fn mc_match_tk(kind: i64) -> bool with Mut, Panic {
    if mc_peek() == kind { mc_advance(); return true }
    false
}

// Compare source bytes at token pos with a known string
fn mc_src_eq_at(src_start: i64, src_len: i64, target: string) -> bool with Mut, Panic, Div {
    if src_len != str_len(target) { return false }
    var i: i64 = 0
    while i < src_len {
        let a = ltp_byte(src_start + i) as i64
        let b = str_char_at(target, i) as i64
        if a != b { return false }
        i = i + 1
    }
    true
}

// Compare source bytes of two token ranges
fn mc_src_eq_range(s1: i64, l1: i64, s2: i64, l2: i64) -> bool with Panic {
    if l1 != l2 { return false }
    var i: i64 = 0
    while i < l1 {
        if ltp_byte(s1 + i) != ltp_byte(s2 + i) { return false }
        i = i + 1
    }
    true
}

// --- Stack slot helpers ---
fn mc_alloc_slot() -> i64 with Mut {
    let s = MC_NEXT_SLOT
    MC_NEXT_SLOT = MC_NEXT_SLOT + 1
    s
}

fn mc_emit_store_rax(slot: i64) with Mut {
    let disp = 0 - ((slot + 1) * 8)
    we(0x48); we(0x89); we(0x85)
    we32(disp)
}

fn mc_emit_load_rax(slot: i64) with Mut {
    let disp = 0 - ((slot + 1) * 8)
    we(0x48); we(0x8B); we(0x85)
    we32(disp)
}

fn mc_emit_load_rcx(slot: i64) with Mut {
    let disp = 0 - ((slot + 1) * 8)
    we(0x48); we(0x8B); we(0x8D)
    we32(disp)
}

// --- SSE2 store/load helpers for f64 (xmm0 ↔ stack slot) ---
// movsd [rbp+disp], xmm0  =  F2 0F 11 85 <disp32>
fn mc_emit_store_xmm0(slot: i64) with Mut {
    let disp = 0 - ((slot + 1) * 8)
    we(0xF2); we(0x0F); we(0x11); we(0x85)
    we32(disp)
}

// movsd xmm0, [rbp+disp]  =  F2 0F 10 85 <disp32>
fn mc_emit_load_xmm0(slot: i64) with Mut {
    let disp = 0 - ((slot + 1) * 8)
    we(0xF2); we(0x0F); we(0x10); we(0x85)
    we32(disp)
}

// movsd xmm1, [rbp+disp]  =  F2 0F 10 8D <disp32>
fn mc_emit_load_xmm1(slot: i64) with Mut {
    let disp = 0 - ((slot + 1) * 8)
    we(0xF2); we(0x0F); we(0x10); we(0x8D)
    we32(disp)
}

// --- Local variable management ---
fn mc_locals_reset() with Mut {
    MC_LOC_COUNT = 0
    MC_NEXT_SLOT = 0
}

fn mc_add_local(ns: i64, nl: i64) -> i64 with Mut, Panic {
    let idx = MC_LOC_COUNT
    let slot = mc_alloc_slot()
    MC_LOC_NAME_START[idx as usize] = ns
    MC_LOC_NAME_LEN[idx as usize] = nl
    MC_LOC_SLOT[idx as usize] = slot
    MC_LOC_IS_F64[idx as usize] = 0
    MC_LOC_TYPE[idx as usize] = -1
    MC_LOC_COUNT = MC_LOC_COUNT + 1
    slot
}

// Add local with f64 type flag
fn mc_add_local_f64(ns: i64, nl: i64) -> i64 with Mut, Panic {
    let idx = MC_LOC_COUNT
    let slot = mc_alloc_slot()
    MC_LOC_NAME_START[idx as usize] = ns
    MC_LOC_NAME_LEN[idx as usize] = nl
    MC_LOC_SLOT[idx as usize] = slot
    MC_LOC_IS_F64[idx as usize] = 1
    MC_LOC_TYPE[idx as usize] = -1  // not a struct
    MC_LOC_COUNT = MC_LOC_COUNT + 1
    slot
}

fn mc_find_local(ns: i64, nl: i64) -> i64 with Panic {
    var i: i64 = MC_LOC_COUNT - 1
    while i >= 0 {
        if mc_src_eq_range(ns, nl, MC_LOC_NAME_START[i as usize], MC_LOC_NAME_LEN[i as usize]) {
            return MC_LOC_SLOT[i as usize]
        }
        i = i - 1
    }
    -1
}

// Check if a local variable is f64 (by name match)
fn mc_local_is_f64(ns: i64, nl: i64) -> i64 with Panic {
    var i: i64 = MC_LOC_COUNT - 1
    while i >= 0 {
        if mc_src_eq_range(ns, nl, MC_LOC_NAME_START[i as usize], MC_LOC_NAME_LEN[i as usize]) {
            return MC_LOC_IS_F64[i as usize]
        }
        i = i - 1
    }
    0
}

// --- Function lookup ---
fn mc_find_fn(ns: i64, nl: i64) -> i64 with Panic {
    var i: i64 = 0
    while i < MC_FN_COUNT {
        if mc_src_eq_range(ns, nl, MC_FN_NAME_START[i as usize], MC_FN_NAME_LEN[i as usize]) {
            return i
        }
        i = i + 1
    }
    -1
}

// --- Struct lookup by name ---
fn mc_find_struct(ns: i64, nl: i64) -> i64 with Panic {
    var i: i64 = 0
    while i < MC_ST_COUNT {
        if mc_src_eq_range(ns, nl, MC_ST_NAME_START[i as usize], MC_ST_NAME_LEN[i as usize]) {
            return i
        }
        i = i + 1
    }
    -1
}

// --- Struct field lookup: returns field index within struct, or -1 ---
fn mc_find_struct_field(st_idx: i64, fs: i64, fl: i64) -> i64 with Panic {
    let base = MC_ST_FIELD_BASE[st_idx as usize]
    let count = MC_ST_FIELD_COUNT[st_idx as usize]
    var i: i64 = 0
    while i < count {
        if mc_src_eq_range(fs, fl, MC_SF_NAME_START[(base + i) as usize], MC_SF_NAME_LEN[(base + i) as usize]) {
            return i
        }
        i = i + 1
    }
    -1
}

// --- Enum lookup by name: returns enum index, or -1 ---
fn mc_find_enum(ns: i64, nl: i64) -> i64 with Panic {
    var i: i64 = 0
    while i < MC_EN_COUNT {
        if mc_src_eq_range(ns, nl, MC_EN_NAME_START[i as usize], MC_EN_NAME_LEN[i as usize]) {
            return i
        }
        i = i + 1
    }
    -1
}

// --- Enum variant lookup: returns variant value, or -1 if not found ---
fn mc_find_enum_variant(en_idx: i64, vs: i64, vl: i64) -> i64 with Panic {
    let base = MC_EN_FIRST_EV[en_idx as usize]
    let count = MC_EN_EV_COUNT[en_idx as usize]
    var i: i64 = 0
    while i < count {
        if mc_src_eq_range(vs, vl, MC_EV_NAME_START[(base + i) as usize], MC_EV_NAME_LEN[(base + i) as usize]) {
            return MC_EV_VALUE[(base + i) as usize]
        }
        i = i + 1
    }
    -1
}

// --- Add multi-slot local for struct ---
fn mc_add_local_struct(ns: i64, nl: i64, st_idx: i64) -> i64 with Mut, Panic {
    let idx = MC_LOC_COUNT
    let flat = MC_ST_FLAT_SIZE[st_idx as usize]
    let slot = MC_NEXT_SLOT
    MC_NEXT_SLOT = MC_NEXT_SLOT + flat
    MC_LOC_NAME_START[idx as usize] = ns
    MC_LOC_NAME_LEN[idx as usize] = nl
    MC_LOC_SLOT[idx as usize] = slot
    MC_LOC_TYPE[idx as usize] = st_idx
    MC_LOC_IS_F64[idx as usize] = 0
    MC_LOC_COUNT = MC_LOC_COUNT + 1
    slot
}

// --- Get local type (struct index or -1 for scalar) ---
fn mc_find_local_type(ns: i64, nl: i64) -> i64 with Panic {
    var i: i64 = MC_LOC_COUNT - 1
    while i >= 0 {
        if mc_src_eq_range(ns, nl, MC_LOC_NAME_START[i as usize], MC_LOC_NAME_LEN[i as usize]) {
            return MC_LOC_TYPE[i as usize]
        }
        i = i - 1
    }
    -1
}

// --- Resolve type name to struct index (-1 if scalar) ---
fn mc_type_name_to_struct(ts: i64, tl: i64) -> i64 with Mut, Panic, Div {
    if mc_src_eq_at(ts, tl, "i64") { return -1 }
    if mc_src_eq_at(ts, tl, "i32") { return -1 }
    if mc_src_eq_at(ts, tl, "i8") { return -1 }
    if mc_src_eq_at(ts, tl, "bool") { return -1 }
    if mc_src_eq_at(ts, tl, "f64") { return -1 }
    if mc_src_eq_at(ts, tl, "string") { return -1 }
    mc_find_struct(ts, tl)
}

// --- Emit lea rax, [rbp - disp] for a given slot ---
fn mc_emit_lea_slot(slot: i64) with Mut {
    let disp = 0 - ((slot + 1) * 8)
    we(0x48); we(0x8d); we(0x85)  // lea rax, [rbp + disp32]
    we32(disp)
}

// --- Emit struct copy: copy flat_size qwords from [rax] to stack slots ---
fn mc_emit_struct_copy_from_rax(dst_slot: i64, flat_size: i64) with Mut {
    // Stack structs grow downward: field N is at [base - N*8]
    var i: i64 = 0
    while i < flat_size {
        if i == 0 {
            we(0x48); we(0x8b); we(0x08)  // mov rcx, [rax]
        } else {
            let off = 0 - (i * 8)  // negative offset for downward growth
            we(0x48); we(0x8b); we(0x88)  // mov rcx, [rax + disp32]
            we32(off)
        }
        let ddisp = 0 - ((dst_slot + 1 + i) * 8)
        we(0x48); we(0x89); we(0x8d)  // mov [rbp + ddisp], rcx
        we32(ddisp)
        i = i + 1
    }
}

// --- Emit struct copy: copy flat_size qwords from stack to [rdi] ---
fn mc_emit_struct_copy_to_ptr(src_slot: i64, flat_size: i64) with Mut {
    var i: i64 = 0
    while i < flat_size {
        let sdisp = 0 - ((src_slot + 1 + i) * 8)
        we(0x48); we(0x8b); we(0x85)  // mov rax, [rbp + sdisp]
        we32(sdisp)
        if i == 0 {
            we(0x48); we(0x89); we(0x07)  // mov [rdi], rax
        } else {
            let off = i * 8
            we(0x48); we(0x89); we(0x87)  // mov [rdi + disp32], rax
            we32(off)
        }
        i = i + 1
    }
}

// --- Emit print_int helper (itoa + sys_write) ---
fn mc_emit_print_int_helper() with Mut {
    MC_PRINT_INT_OFF = WIDE_LEN
    // push rbp; mov rbp, rsp; sub rsp, 48
    we(0x55)
    we(0x48); we(0x89); we(0xe5)
    we(0x48); we(0x83); we(0xec); we(0x30)
    // mov rax, rdi
    we(0x48); we(0x89); we(0xf8)
    // lea r8, [rbp-1]
    we(0x4c); we(0x8d); we(0x45); we(0xff)
    // xor r9d, r9d
    we(0x45); we(0x31); we(0xc9)
    // test rax, rax
    we(0x48); we(0x85); we(0xc0)
    // jns +6
    we(0x79); we(0x06)
    // neg rax
    we(0x48); we(0xf7); we(0xd8)
    // mov r9b, 1
    we(0x41); we(0xb1); we(0x01)
    // test rax, rax; jnz +9
    we(0x48); we(0x85); we(0xc0)
    we(0x75); we(0x09)
    // mov byte [r8], '0'
    we(0x41); we(0xc6); we(0x00); we(0x30)
    // dec r8
    we(0x49); we(0xff); we(0xc8)
    // jmp do_write (+38)
    we(0xeb); we(0x26)
    // itoa_loop:
    // xor edx, edx
    we(0x31); we(0xd2)
    // mov rcx, 10
    we(0x48); we(0xc7); we(0xc1); we(0x0a); we(0x00); we(0x00); we(0x00)
    // div rcx
    we(0x48); we(0xf7); we(0xf1)
    // add dl, '0'
    we(0x80); we(0xc2); we(0x30)
    // mov [r8], dl
    we(0x41); we(0x88); we(0x10)
    // dec r8
    we(0x49); we(0xff); we(0xc8)
    // test rax, rax
    we(0x48); we(0x85); we(0xc0)
    // jnz itoa_loop (-26)
    we(0x75); we(0xe6)
    // test r9b, r9b
    we(0x45); we(0x84); we(0xc9)
    // jz +7
    we(0x74); we(0x07)
    // mov byte [r8], '-'
    we(0x41); we(0xc6); we(0x00); we(0x2d)
    // dec r8
    we(0x49); we(0xff); we(0xc8)
    // do_write:
    // inc r8
    we(0x49); we(0xff); we(0xc0)
    // mov rsi, r8
    we(0x4c); we(0x89); we(0xc6)
    // mov rdx, rbp; sub rdx, r8 (len = rbp - r8)
    we(0x48); we(0x89); we(0xea)
    we(0x4c); we(0x29); we(0xc2)
    // mov edi, 1
    we(0xbf); we(0x01); we(0x00); we(0x00); we(0x00)
    // mov eax, 1
    we(0xb8); we(0x01); we(0x00); we(0x00); we(0x00)
    // syscall
    we(0x0f); we(0x05)
    // leave; ret
    we(0xc9); we(0xc3)
}

// --- Emit print_f64 helper ---
// Calling convention: f64 bit pattern passed in rdi
// Prints: ['-']<integer_part>'.'<6 fractional digits>'\n'
fn mc_emit_print_f64_helper() with Mut {
    MC_PRINT_F64_OFF = WIDE_LEN
    we(0x55)
    we(0x48); we(0x89); we(0xe5)
    we(0x48); we(0x83); we(0xec); we(0x50)
    we(0x66); we(0x48); we(0x0F); we(0x6E); we(0xC7)
    we(0x66); we(0x48); we(0x0F); we(0x7E); we(0xC0)
    we(0x48); we(0x85); we(0xc0)
    let skip_neg_off = WIDE_LEN
    we(0x79); we(0x00)
    // Save rax (bit pattern) to [rbp-40] before syscall clobbers it
    we(0x48); we(0x89); we(0x45); we(0xD8)
    we(0xc6); we(0x45); we(0xff); we(0x2d)
    we(0x48); we(0x8d); we(0x75); we(0xff)
    we(0xba); we(0x01); we(0x00); we(0x00); we(0x00)
    we(0xbf); we(0x01); we(0x00); we(0x00); we(0x00)
    we(0xb8); we(0x01); we(0x00); we(0x00); we(0x00)
    we(0x0f); we(0x05)
    // Reload bit pattern after syscall
    we(0x48); we(0x8B); we(0x45); we(0xD8)
    // Clear sign bit: mov rcx, 0x7FFFFFFFFFFFFFFF; and rax, rcx
    we(0x48); we(0xb9)
    we(0xff); we(0xff); we(0xff); we(0xff); we(0xff); we(0xff); we(0xff); we(0x7f)
    we(0x48); we(0x21); we(0xc8)
    we(0x66); we(0x48); we(0x0F); we(0x6E); we(0xC0)
    let skip_neg_target = WIDE_LEN
    WIDE_OUT[(skip_neg_off + 1) as usize] = ((skip_neg_target - (skip_neg_off + 2)) & 0xFF) as i8
    we(0xF2); we(0x48); we(0x0F); we(0x2C); we(0xC0)
    we(0xF2); we(0x0F); we(0x11); we(0x45); we(0xF0)
    we(0x48); we(0x89); we(0x45); we(0xE8)
    we(0x48); we(0x89); we(0xc7)
    we(0xe8)
    let int_call_rel = MC_PRINT_INT_OFF - (WIDE_LEN + 4)
    we32(int_call_rel)
    we(0xc6); we(0x45); we(0xfe); we(0x2e)
    we(0x48); we(0x8d); we(0x75); we(0xfe)
    we(0xba); we(0x01); we(0x00); we(0x00); we(0x00)
    we(0xbf); we(0x01); we(0x00); we(0x00); we(0x00)
    we(0xb8); we(0x01); we(0x00); we(0x00); we(0x00)
    we(0x0f); we(0x05)
    we(0xF2); we(0x0F); we(0x10); we(0x45); we(0xF0)
    we(0x48); we(0x8B); we(0x45); we(0xE8)
    we(0xF2); we(0x48); we(0x0F); we(0x2A); we(0xC8)
    we(0xF2); we(0x0F); we(0x5C); we(0xC1)
    we(0x48); we(0xb8)
    we(0x00); we(0x00); we(0x00); we(0x00); we(0x80); we(0x84); we(0x2E); we(0x41)
    we(0x66); we(0x48); we(0x0F); we(0x6E); we(0xD0)
    we(0xF2); we(0x0F); we(0x59); we(0xC2)
    we(0xF2); we(0x48); we(0x0F); we(0x2C); we(0xC8)
    we(0x48); we(0x89); we(0xc8); we(0x31); we(0xd2)
    we(0xb9); we(0xa0); we(0x86); we(0x01); we(0x00)
    we(0x48); we(0xf7); we(0xf1); we(0x04); we(0x30)
    we(0x88); we(0x45); we(0xf7)
    we(0x48); we(0x89); we(0xd0); we(0x31); we(0xd2)
    we(0xb9); we(0x10); we(0x27); we(0x00); we(0x00)
    we(0x48); we(0xf7); we(0xf1); we(0x04); we(0x30)
    we(0x88); we(0x45); we(0xf8)
    we(0x48); we(0x89); we(0xd0); we(0x31); we(0xd2)
    we(0xb9); we(0xe8); we(0x03); we(0x00); we(0x00)
    we(0x48); we(0xf7); we(0xf1); we(0x04); we(0x30)
    we(0x88); we(0x45); we(0xf9)
    we(0x48); we(0x89); we(0xd0); we(0x31); we(0xd2)
    we(0xb9); we(0x64); we(0x00); we(0x00); we(0x00)
    we(0x48); we(0xf7); we(0xf1); we(0x04); we(0x30)
    we(0x88); we(0x45); we(0xfa)
    we(0x48); we(0x89); we(0xd0); we(0x31); we(0xd2)
    we(0xb9); we(0x0a); we(0x00); we(0x00); we(0x00)
    we(0x48); we(0xf7); we(0xf1); we(0x04); we(0x30)
    we(0x88); we(0x45); we(0xfb)
    we(0x80); we(0xc2); we(0x30)
    we(0x88); we(0x55); we(0xfc)
    we(0x48); we(0x8d); we(0x75); we(0xf7)
    we(0xba); we(0x06); we(0x00); we(0x00); we(0x00)
    we(0xbf); we(0x01); we(0x00); we(0x00); we(0x00)
    we(0xb8); we(0x01); we(0x00); we(0x00); we(0x00)
    we(0x0f); we(0x05)
    we(0xc6); we(0x45); we(0xfd); we(0x0a)
    we(0x48); we(0x8d); we(0x75); we(0xfd)
    we(0xba); we(0x01); we(0x00); we(0x00); we(0x00)
    we(0xbf); we(0x01); we(0x00); we(0x00); we(0x00)
    we(0xb8); we(0x01); we(0x00); we(0x00); we(0x00)
    we(0x0f); we(0x05)
    we(0xc9); we(0xc3)
}

// --- Emit inline string print (push to stack + sys_write) ---
fn mc_emit_print_str(str_start: i64, str_end: i64) with Mut, Panic, Div {
    // Decode string bytes (handle \n, \t, \\, \0)
    var str_buf: [i8; 512] = [0; 512]
    var str_len: i64 = 0
    var si: i64 = str_start
    while si < str_end && str_len < 512 {
        let ch = ltp_byte(si)
        if ch == 92 as i8 && si + 1 < str_end {
            let ch2 = ltp_byte(si + 1)
            if ch2 == 110 as i8 { str_buf[str_len as usize] = 10 as i8 }
            else if ch2 == 116 as i8 { str_buf[str_len as usize] = 9 as i8 }
            else if ch2 == 92 as i8 { str_buf[str_len as usize] = 92 as i8 }
            else if ch2 == 48 as i8 { str_buf[str_len as usize] = 0 as i8 }
            else if ch2 == 34 as i8 { str_buf[str_len as usize] = 34 as i8 }
            else { str_buf[str_len as usize] = ch2 }
            si = si + 2
        } else {
            str_buf[str_len as usize] = ch
            si = si + 1
        }
        str_len = str_len + 1
    }
    if str_len == 0 { return 0 }
    // Push string bytes onto stack in 8-byte chunks (reverse order)
    let n_chunks = (str_len + 7) / 8
    var chi: i64 = n_chunks - 1
    while chi >= 0 {
        var qw: i64 = 0
        var bi: i64 = 0
        while bi < 8 {
            let idx = chi * 8 + bi
            if idx < str_len {
                qw = qw | ((str_buf[idx as usize] as i64 & 0xFF) << (bi * 8))
            }
            bi = bi + 1
        }
        we(0x48); we(0xb8); we64(qw)  // mov rax, imm64
        we(0x50)                        // push rax
        chi = chi - 1
    }
    // write(1, rsp, str_len)
    we(0xb8); we32(1)                   // mov eax, 1
    we(0xbf); we32(1)                   // mov edi, 1
    we(0x48); we(0x89); we(0xe6)        // mov rsi, rsp
    we(0xba); we32(str_len)             // mov edx, str_len
    we(0x0f); we(0x05)                  // syscall
    // Clean up stack
    let stack_used = n_chunks * 8
    we(0x48); we(0x81); we(0xc4); we32(stack_used)
}

// --- Expression parser: emits code leaving result in rax ---

// Forward-declare: mc_parse_expr is recursive through mc_parse_primary
// (Sounio supports forward refs to functions in the same module.)

fn mc_parse_primary() with Mut, Panic, Div {
    let k = mc_peek()

    // Integer literal
    if k == MC_TK_INT() {
        let val = MP_INT_VALUE[MC_POS as usize]
        mc_advance()
        // mov rax, imm64
        we(0x48); we(0xb8); we64(val)
        MC_EXPR_IS_F64 = 0
        return 0
    }

    // Float literal: emit runtime SSE2 conversion from integer parts
    if k == MC_TK_FLOAT() {
        let fl_int = MP_FLOAT_INT[MC_POS as usize]
        let fl_frac = MP_FLOAT_FRAC[MC_POS as usize]
        let fl_denom = MP_FLOAT_DENOM[MC_POS as usize]
        mc_advance()
        // Emit: cvtsi2sd xmm0, int_part
        we(0x48); we(0xb8); we64(fl_int)  // mov rax, int_part
        we(0xF2); we(0x48); we(0x0F); we(0x2A); we(0xC0)  // cvtsi2sd xmm0, rax
        // Emit: cvtsi2sd xmm1, frac_val; cvtsi2sd xmm2, denom; divsd xmm1, xmm2; addsd xmm0, xmm1
        if fl_frac > 0 {
            we(0x48); we(0xb8); we64(fl_frac)  // mov rax, frac_val
            we(0xF2); we(0x48); we(0x0F); we(0x2A); we(0xC8)  // cvtsi2sd xmm1, rax
            we(0x48); we(0xb8); we64(fl_denom)  // mov rax, denom
            we(0xF2); we(0x48); we(0x0F); we(0x2A); we(0xD0)  // cvtsi2sd xmm2, rax
            we(0xF2); we(0x0F); we(0x5E); we(0xCA)  // divsd xmm1, xmm2
            we(0xF2); we(0x0F); we(0x58); we(0xC1)  // addsd xmm0, xmm1
        }
        // movq rax, xmm0 — store f64 bits in rax
        we(0x66); we(0x48); we(0x0F); we(0x7E); we(0xC0)
        MC_EXPR_IS_F64 = 1
        return 0
    }

    // true / false
    if k == MC_TK_TRUE() {
        mc_advance()
        we(0x48); we(0xb8); we64(1)
        MC_EXPR_IS_F64 = 0
        return 0
    }
    if k == MC_TK_FALSE() {
        mc_advance()
        we(0x48); we(0xb8); we64(0)
        MC_EXPR_IS_F64 = 0
        return 0
    }

    // String literal
    if k == MC_TK_STR() {
        let ss = MP_START[MC_POS as usize] + 1  // skip opening "
        let se = MP_END[MC_POS as usize] - 1    // skip closing "
        mc_advance()
        // Embed string inline: jmp over, then data, then lea rax, [rip+data]
        // First decode string bytes to get length
        var sb: [i8; 512] = [0; 512]
        var sl: i64 = 0
        var di: i64 = ss
        while di < se && sl < 512 {
            let dc = ltp_byte(di)
            if dc == 92 as i8 && di + 1 < se {
                let dc2 = ltp_byte(di + 1)
                if dc2 == 110 as i8 { sb[sl as usize] = 10 as i8 }
                else if dc2 == 116 as i8 { sb[sl as usize] = 9 as i8 }
                else if dc2 == 92 as i8 { sb[sl as usize] = 92 as i8 }
                else if dc2 == 48 as i8 { sb[sl as usize] = 0 as i8 }
                else if dc2 == 34 as i8 { sb[sl as usize] = 34 as i8 }
                else { sb[sl as usize] = dc2 }
                di = di + 2
            } else {
                sb[sl as usize] = dc
                di = di + 1
            }
            sl = sl + 1
        }
        // jmp over data+null: EB <len+1>
        let jmp_off = WIDE_LEN
        we(0xeb); we(0x00)  // placeholder
        let data_start = WIDE_LEN
        var wi: i64 = 0
        while wi < sl { we(sb[wi as usize] as i64 & 0xFF); wi = wi + 1 }
        we(0x00)  // null terminator
        let data_end = WIDE_LEN
        // Patch jmp
        let jmp_dist = data_end - (jmp_off + 2)
        WIDE_OUT[(jmp_off + 1) as usize] = (jmp_dist & 0xFF) as i8
        // lea rax, [rip + rel32] pointing to data_start
        we(0x48); we(0x8d); we(0x05)
        let rip_rel = data_start - (WIDE_LEN + 4)
        we32(rip_rel)
        return 0
    }

    // Parenthesized expression
    if k == MC_TK_LPAREN() {
        mc_advance()
        mc_parse_expr()
        mc_expect(MC_TK_RPAREN())
        return 0
    }

    // Unary minus
    if k == MC_TK_MINUS() {
        mc_advance()
        mc_parse_primary()
        if MC_EXPR_IS_F64 == 1 {
            // f64 negate: flip sign bit (xor rax, 0x8000000000000000)
            we(0x48); we(0xb9)
            we(0x00); we(0x00); we(0x00); we(0x00); we(0x00); we(0x00); we(0x00); we(0x80)
            we(0x48); we(0x31); we(0xc8)  // xor rax, rcx
        } else {
            // neg rax
            we(0x48); we(0xf7); we(0xd8)
        }
        return 0
    }

    // Unary not (!)
    if k == MC_TK_BANG() {
        mc_advance()
        mc_parse_primary()
        // test rax, rax; sete al; movzx rax, al
        we(0x48); we(0x85); we(0xc0)
        we(0x0f); we(0x94); we(0xc0)
        we(0x48); we(0x0f); we(0xb6); we(0xc0)
        return 0
    }

    // If expression (value-producing)
    if k == MC_TK_IF() {
        mc_parse_if_expr()
        return 0
    }

    // Match expression (value-producing)
    if k == MC_TK_MATCH() {
        mc_parse_match_expr()
        return 0
    }

    // Enum name as primary (Enum::Variant)
    if k == MC_TK_ENUM() {
        let en_s = MP_START[MC_POS as usize]
        let en_e = MP_END[MC_POS as usize]
        let en_len = en_e - en_s
        mc_advance()  // consume enum name
        mc_expect(MC_TK_COLONCOLON())  // consume ::
        let var_s = MP_START[MC_POS as usize]
        let var_e = MP_END[MC_POS as usize]
        let var_len = var_e - var_s
        mc_advance()  // consume variant name
        let en_idx = mc_find_enum(en_s, en_len)
        if en_idx >= 0 {
            let ev_val = mc_find_enum_variant(en_idx, var_s, var_len)
            if ev_val >= 0 {
                we(0x48); we(0xb8); we64(ev_val)  // mov rax, variant_value
            } else {
                print("mc: unknown variant\n")
                we(0x48); we(0x31); we(0xc0)
            }
        } else {
            print("mc: unknown enum\n")
            we(0x48); we(0x31); we(0xc0)
        }
        MC_EXPR_IS_F64 = 0
        return 0
    }

    // Identifier: variable ref, function call, struct literal, or Enum::Variant
    if k == MC_TK_IDENT() {
        let id_s = MP_START[MC_POS as usize]
        let id_e = MP_END[MC_POS as usize]
        let id_len = id_e - id_s
        mc_advance()

        // Check for Enum::Variant path: ident followed by ::
        if mc_peek() == MC_TK_COLONCOLON() {
            mc_advance()  // consume ::
            let var_s = MP_START[MC_POS as usize]
            let var_e = MP_END[MC_POS as usize]
            let var_len = var_e - var_s
            mc_advance()  // consume variant name
            let en_idx = mc_find_enum(id_s, id_len)
            if en_idx >= 0 {
                let ev_val = mc_find_enum_variant(en_idx, var_s, var_len)
                if ev_val >= 0 {
                    we(0x48); we(0xb8); we64(ev_val)  // mov rax, variant_value
                } else {
                    print("mc: unknown variant '")
                    var evi: i64 = 0
                    while evi < var_len && evi < 32 { print_char(ltp_byte(var_s + evi) as i64); evi = evi + 1 }
                    print("'\n")
                    we(0x48); we(0x31); we(0xc0)
                }
            } else {
                print("mc: unknown enum '")
                var eni: i64 = 0
                while eni < id_len && eni < 32 { print_char(ltp_byte(id_s + eni) as i64); eni = eni + 1 }
                print("'\n")
                we(0x48); we(0x31); we(0xc0)
            }
            MC_EXPR_IS_F64 = 0
            return 0
        }

        // Check for function call: ident followed by (
        if mc_peek() == MC_TK_LPAREN() {
            mc_advance()  // consume (
            mc_emit_call(id_s, id_len)
            return 0
        }

        // Check for struct literal: ident followed by { where ident is a struct name
        if mc_peek() == MC_TK_LBRACE() {
            let st_idx = mc_find_struct(id_s, id_len)
            if st_idx >= 0 {
                mc_advance()  // consume {
                // Allocate temp stack space for the struct
                let tmp_slot = MC_NEXT_SLOT
                let flat = MC_ST_FLAT_SIZE[st_idx as usize]
                MC_NEXT_SLOT = MC_NEXT_SLOT + flat
                // Parse field: value pairs and store each field
                while mc_peek() != MC_TK_RBRACE() && mc_peek() != MC_TK_EOF() {
                    let fs = MP_START[MC_POS as usize]
                    let fe = MP_END[MC_POS as usize]
                    let fl = fe - fs
                    mc_advance()  // consume field name
                    mc_expect(MC_TK_COLON())
                    mc_parse_expr()
                    // Find field offset and store
                    let fi = mc_find_struct_field(st_idx, fs, fl)
                    if fi >= 0 {
                        let fbase = MC_ST_FIELD_BASE[st_idx as usize]
                        let foff = MC_SF_OFFSET[(fbase + fi) as usize]
                        mc_emit_store_rax(tmp_slot + foff)
                    }
                    if mc_peek() == MC_TK_COMMA() { mc_advance() }
                }
                mc_expect(MC_TK_RBRACE())
                // Leave pointer to struct in rax
                mc_emit_lea_slot(tmp_slot)
                // Set expression type to struct
                MC_EXPR_IS_F64 = 0
                return 0
            }
        }

        // Variable reference
        let slot = mc_find_local(id_s, id_len)
        if slot >= 0 {
            let lt = mc_find_local_type(id_s, id_len)
            if lt >= 0 {
                // Struct variable: load pointer to first slot
                mc_emit_lea_slot(slot)
            } else {
                mc_emit_load_rax(slot)
            }
            MC_EXPR_IS_F64 = mc_local_is_f64(id_s, id_len)
        } else {
            // Unknown variable — emit 0 with warning
            print("mc: unknown var '")
            var vi: i64 = 0
            while vi < id_len && vi < 32 {
                print_char(ltp_byte(id_s + vi) as i64)
                vi = vi + 1
            }
            print("'\n")
            we(0x48); we(0x31); we(0xc0)  // xor rax, rax
        }
        return 0
    }

    // Fallback: skip token, emit 0
    mc_advance()
    we(0x48); we(0x31); we(0xc0)
    0
}

// Emit a function call. Arguments already consumed up to but not including ).
fn mc_emit_call(name_s: i64, name_len: i64) with Mut, Panic, Div {
    // Special builtins
    // print(str_expr)
    if mc_src_eq_at(name_s, name_len, "print") {
        // Check if argument is a string literal for inline optimization
        if mc_peek() == MC_TK_STR() {
            let ss = MP_START[MC_POS as usize] + 1
            let se = MP_END[MC_POS as usize] - 1
            mc_advance()
            mc_emit_print_str(ss, se)
        } else {
            // Runtime print: evaluate expr, rax = pointer to null-terminated string
            mc_parse_expr()
            // mov rsi, rax; inline strlen; sys_write
            we(0x48); we(0x89); we(0xc6)  // mov rsi, rax
            we(0x48); we(0x89); we(0xc7)  // mov rdi, rax
            we(0x31); we(0xc9)            // xor ecx, ecx
            // loop: cmp byte [rdi+rcx], 0; je done; inc rcx; jmp loop
            we(0x80); we(0x3c); we(0x0f); we(0x00)
            we(0x74); we(0x04)
            we(0x48); we(0xff); we(0xc1)
            we(0xeb); we(0xf5)
            we(0x48); we(0x89); we(0xca)  // mov rdx, rcx
            we(0xbf); we32(1)
            we(0xb8); we32(1)
            we(0x0f); we(0x05)
        }
        mc_expect(MC_TK_RPAREN())
        we(0x48); we(0x31); we(0xc0)  // xor rax, rax (return 0)
        return 0
    }

    // print_int(expr)
    if mc_src_eq_at(name_s, name_len, "print_int") {
        mc_parse_expr()
        mc_expect(MC_TK_RPAREN())
        // mov rdi, rax; call print_int_helper
        we(0x48); we(0x89); we(0xc7)
        we(0xe8)
        let rel = MC_PRINT_INT_OFF - (WIDE_LEN + 4)
        we32(rel)
        we(0x48); we(0x31); we(0xc0)
        MC_EXPR_IS_F64 = 0
        return 0
    }

    // print_f64(expr) — f64 bit pattern in rax, pass to helper via rdi
    if mc_src_eq_at(name_s, name_len, "print_f64") {
        mc_parse_expr()
        mc_expect(MC_TK_RPAREN())
        // mov rdi, rax; call print_f64_helper
        we(0x48); we(0x89); we(0xc7)
        we(0xe8)
        let f64_rel = MC_PRINT_F64_OFF - (WIDE_LEN + 4)
        we32(f64_rel)
        we(0x48); we(0x31); we(0xc0)
        MC_EXPR_IS_F64 = 0
        return 0
    }

    // sqrt(expr) — sqrtsd xmm0, xmm0 on f64 bit pattern
    if mc_src_eq_at(name_s, name_len, "sqrt") {
        mc_parse_expr()
        mc_expect(MC_TK_RPAREN())
        // rax has f64 bits; movq xmm0, rax; sqrtsd xmm0, xmm0; movq rax, xmm0
        we(0x66); we(0x48); we(0x0F); we(0x6E); we(0xC0)  // movq xmm0, rax
        we(0xF2); we(0x0F); we(0x51); we(0xC0)             // sqrtsd xmm0, xmm0
        we(0x66); we(0x48); we(0x0F); we(0x7E); we(0xC0)  // movq rax, xmm0
        MC_EXPR_IS_F64 = 1
        return 0
    }

    // exit(expr) — mov edi, eax; mov eax, 60; syscall
    if mc_src_eq_at(name_s, name_len, "exit") {
        mc_parse_expr()
        mc_expect(MC_TK_RPAREN())
        we(0x89); we(0xc7)    // mov edi, eax
        we(0xb8); we32(60)    // mov eax, 60
        we(0x0f); we(0x05)    // syscall
        return 0
    }

    // General function call: evaluate args into rdi, rsi, rdx, rcx, r8, r9
    var arg_slots: [i64; 8] = [0; 8]
    var arg_count: i64 = 0
    if mc_peek() != MC_TK_RPAREN() {
        // Parse first argument
        mc_parse_expr()
        let s0 = mc_alloc_slot()
        mc_emit_store_rax(s0)
        arg_slots[0 as usize] = s0
        arg_count = 1
        // Parse subsequent arguments
        while mc_peek() == MC_TK_COMMA() {
            mc_advance()
            mc_parse_expr()
            let sn = mc_alloc_slot()
            mc_emit_store_rax(sn)
            arg_slots[arg_count as usize] = sn
            arg_count = arg_count + 1
        }
    }
    mc_expect(MC_TK_RPAREN())

    // Load args into ABI registers
    if arg_count > 0 { mc_emit_load_rax(arg_slots[0 as usize]); we(0x48); we(0x89); we(0xc7) }  // mov rdi, rax
    if arg_count > 1 { mc_emit_load_rax(arg_slots[1 as usize]); we(0x48); we(0x89); we(0xc6) }  // mov rsi, rax
    if arg_count > 2 { mc_emit_load_rax(arg_slots[2 as usize]); we(0x48); we(0x89); we(0xc2) }  // mov rdx, rax
    if arg_count > 3 { mc_emit_load_rax(arg_slots[3 as usize]); we(0x48); we(0x89); we(0xc1) }  // mov rcx, rax
    if arg_count > 4 {
        mc_emit_load_rax(arg_slots[4 as usize])
        we(0x49); we(0x89); we(0xc0)  // mov r8, rax
    }
    if arg_count > 5 {
        mc_emit_load_rax(arg_slots[5 as usize])
        we(0x49); we(0x89); we(0xc1)  // mov r9, rax
    }

    // Find target function
    let fn_idx = mc_find_fn(name_s, name_len)
    if fn_idx >= 0 {
        // call rel32 — emit sentinel, will be patched
        we(0xe8)
        MC_CALL_FIX_OFF[MC_CALL_FIX_COUNT as usize] = WIDE_LEN
        MC_CALL_FIX_TARGET[MC_CALL_FIX_COUNT as usize] = fn_idx
        MC_CALL_FIX_COUNT = MC_CALL_FIX_COUNT + 1
        we32(0)  // placeholder
    } else {
        // Unknown function — emit warning + nop call
        print("mc: unknown fn '")
        var fi: i64 = 0
        while fi < name_len && fi < 32 {
            print_char(ltp_byte(name_s + fi) as i64)
            fi = fi + 1
        }
        print("'\n")
        we(0x48); we(0x31); we(0xc0)  // xor rax, rax
    }
    0
}

// If expression: if cond { body } [else { body }]
fn mc_parse_if_expr() with Mut, Panic, Div {
    mc_expect(MC_TK_IF())
    // Parse condition
    mc_parse_expr()
    // test rax, rax; jz else_branch
    we(0x48); we(0x85); we(0xc0)
    we(0x0f); we(0x84)   // jz rel32
    let else_fix = WIDE_LEN
    we32(0)  // placeholder

    // Then branch
    mc_expect(MC_TK_LBRACE())
    mc_parse_block_body()
    mc_expect(MC_TK_RBRACE())

    // Check for else
    if mc_peek() == MC_TK_ELSE() {
        mc_advance()
        // jmp over_else
        we(0xe9)
        let end_fix = WIDE_LEN
        we32(0)
        // Patch else_fix to here
        let else_target = WIDE_LEN
        let else_disp = else_target - (else_fix + 4)
        WIDE_OUT[else_fix as usize] = (else_disp & 0xFF) as i8
        WIDE_OUT[(else_fix + 1) as usize] = ((else_disp >> 8) & 0xFF) as i8
        WIDE_OUT[(else_fix + 2) as usize] = ((else_disp >> 16) & 0xFF) as i8
        WIDE_OUT[(else_fix + 3) as usize] = ((else_disp >> 24) & 0xFF) as i8

        if mc_peek() == MC_TK_IF() {
            // else if
            mc_parse_if_expr()
        } else {
            mc_expect(MC_TK_LBRACE())
            mc_parse_block_body()
            mc_expect(MC_TK_RBRACE())
        }
        // Patch end_fix to here
        let end_target = WIDE_LEN
        let end_disp = end_target - (end_fix + 4)
        WIDE_OUT[end_fix as usize] = (end_disp & 0xFF) as i8
        WIDE_OUT[(end_fix + 1) as usize] = ((end_disp >> 8) & 0xFF) as i8
        WIDE_OUT[(end_fix + 2) as usize] = ((end_disp >> 16) & 0xFF) as i8
        WIDE_OUT[(end_fix + 3) as usize] = ((end_disp >> 24) & 0xFF) as i8
    } else {
        // No else: patch else_fix to here
        let no_else_target = WIDE_LEN
        let no_else_disp = no_else_target - (else_fix + 4)
        WIDE_OUT[else_fix as usize] = (no_else_disp & 0xFF) as i8
        WIDE_OUT[(else_fix + 1) as usize] = ((no_else_disp >> 8) & 0xFF) as i8
        WIDE_OUT[(else_fix + 2) as usize] = ((no_else_disp >> 16) & 0xFF) as i8
        WIDE_OUT[(else_fix + 3) as usize] = ((no_else_disp >> 24) & 0xFF) as i8
    }
    0
}

// --- Match expression: match subject { Arm1 => expr, Arm2 => expr, _ => expr } ---
// Compiles as chain of compare-and-branch. Result in rax.
fn mc_parse_match_expr() with Mut, Panic, Div {
    mc_expect(MC_TK_MATCH())
    // Evaluate subject expression
    mc_parse_expr()
    // Save subject to temp slot
    let subj_slot = mc_alloc_slot()
    mc_emit_store_rax(subj_slot)
    mc_expect(MC_TK_LBRACE())
    // End-jump fixups: use global arrays to avoid boot4 local array issues
    let saved_match_fix_count = MC_MATCH_END_FIX_COUNT
    MC_MATCH_END_FIX_COUNT = 0
    while mc_peek() != MC_TK_RBRACE() && mc_peek() != MC_TK_EOF() {
        // Parse arm pattern
        let arm_k = mc_peek()
        // Check for wildcard: _ (ident with length 1, byte == 95)
        var is_wildcard = false
        var arm_value: i64 = 0
        if arm_k == MC_TK_IDENT() {
            let arm_s = MP_START[MC_POS as usize]
            let arm_l = MP_END[MC_POS as usize] - arm_s
            if arm_l == 1 && ltp_byte(arm_s) == 95 as i8 {
                is_wildcard = true
                mc_advance()  // consume _
            } else {
                // Enum::Variant pattern via IDENT
                mc_advance()  // consume enum name
                mc_expect(MC_TK_COLONCOLON())
                let pv_s = MP_START[MC_POS as usize]
                let pv_l = MP_END[MC_POS as usize] - pv_s
                mc_advance()  // consume variant name
                let pen_idx = mc_find_enum(arm_s, arm_l)
                if pen_idx >= 0 {
                    arm_value = mc_find_enum_variant(pen_idx, pv_s, pv_l)
                }
            }
        } else if arm_k == MC_TK_ENUM() {
            // Enum name token (recognized keyword)
            let arm_s = MP_START[MC_POS as usize]
            let arm_l = MP_END[MC_POS as usize] - arm_s
            mc_advance()  // consume enum name
            mc_expect(MC_TK_COLONCOLON())
            let pv_s = MP_START[MC_POS as usize]
            let pv_l = MP_END[MC_POS as usize] - pv_s
            mc_advance()  // consume variant name
            let pen_idx = mc_find_enum(arm_s, arm_l)
            if pen_idx >= 0 {
                arm_value = mc_find_enum_variant(pen_idx, pv_s, pv_l)
            }
        } else {
            // Unknown pattern, skip token
            mc_advance()
        }
        mc_expect(MC_TK_FATARROW())
        if is_wildcard {
            // Wildcard arm: unconditionally execute body
            // Check if body is a block or single expression
            if mc_peek() == MC_TK_LBRACE() {
                mc_advance()
                mc_parse_block_body()
                mc_expect(MC_TK_RBRACE())
            } else {
                mc_parse_expr()
            }
            if mc_peek() == MC_TK_COMMA() { mc_advance() }
            // Jump to end
            we(0xe9)
            MC_MATCH_END_FIX[MC_MATCH_END_FIX_COUNT as usize] = WIDE_LEN
            MC_MATCH_END_FIX_COUNT = MC_MATCH_END_FIX_COUNT + 1
            we32(0)
        } else {
            // Non-wildcard arm: compare subject to arm_value
            mc_emit_load_rax(subj_slot)
            // cmp rax, imm32 — use mov rcx, imm64; cmp rax, rcx
            we(0x48); we(0xb9); we64(arm_value)  // mov rcx, arm_value
            we(0x48); we(0x39); we(0xc8)          // cmp rax, rcx
            // jne skip_this_arm
            we(0x0f); we(0x85)
            let skip_fix = WIDE_LEN
            we32(0)
            // Arm body
            if mc_peek() == MC_TK_LBRACE() {
                mc_advance()
                mc_parse_block_body()
                mc_expect(MC_TK_RBRACE())
            } else {
                mc_parse_expr()
            }
            if mc_peek() == MC_TK_COMMA() { mc_advance() }
            // Jump to end of match
            we(0xe9)
            MC_MATCH_END_FIX[MC_MATCH_END_FIX_COUNT as usize] = WIDE_LEN
            MC_MATCH_END_FIX_COUNT = MC_MATCH_END_FIX_COUNT + 1
            we32(0)
            // Patch skip_fix to here
            let skip_target = WIDE_LEN
            let skip_disp = skip_target - (skip_fix + 4)
            WIDE_OUT[skip_fix as usize] = (skip_disp & 0xFF) as i8
            WIDE_OUT[(skip_fix + 1) as usize] = ((skip_disp >> 8) & 0xFF) as i8
            WIDE_OUT[(skip_fix + 2) as usize] = ((skip_disp >> 16) & 0xFF) as i8
            WIDE_OUT[(skip_fix + 3) as usize] = ((skip_disp >> 24) & 0xFF) as i8
        }
    }
    mc_expect(MC_TK_RBRACE())
    // Patch all end-jump fixups to here
    let match_end = WIDE_LEN
    var efi: i64 = 0
    while efi < MC_MATCH_END_FIX_COUNT {
        let fix_off = MC_MATCH_END_FIX[efi as usize]
        let end_disp = match_end - (fix_off + 4)
        WIDE_OUT[fix_off as usize] = (end_disp & 0xFF) as i8
        WIDE_OUT[(fix_off + 1) as usize] = ((end_disp >> 8) & 0xFF) as i8
        WIDE_OUT[(fix_off + 2) as usize] = ((end_disp >> 16) & 0xFF) as i8
        WIDE_OUT[(fix_off + 3) as usize] = ((end_disp >> 24) & 0xFF) as i8
        efi = efi + 1
    }
    MC_MATCH_END_FIX_COUNT = saved_match_fix_count
    MC_EXPR_IS_F64 = 0
    0
}

// Operator precedence
fn mc_binop_prec(k: i64) -> i64 {
    if k == MC_TK_PIPEPIPE() { return 1 }
    if k == MC_TK_AMPAMP() { return 2 }
    if k == MC_TK_EQEQ() || k == MC_TK_BANGEQ() { return 3 }
    if k == MC_TK_LT() || k == MC_TK_GT() || k == MC_TK_LTEQ() || k == MC_TK_GTEQ() { return 4 }
    if k == MC_TK_PLUS() || k == MC_TK_MINUS() { return 5 }
    if k == MC_TK_STAR() || k == MC_TK_SLASH() || k == MC_TK_PERCENT() { return 6 }
    0
}

fn mc_parse_expr() with Mut, Panic, Div {
    mc_parse_expr_prec(1)
}

fn mc_parse_expr_prec(min_prec: i64) with Mut, Panic, Div {
    mc_parse_primary()
    // Handle postfix dot access (highest precedence)
    while mc_peek() == MC_TK_DOT() {
        mc_advance()
        let fs = MP_START[MC_POS as usize]
        let fe = MP_END[MC_POS as usize]
        let fl = fe - fs
        mc_advance()
        // Brute-force: find field across all structs
        var dot_off: i64 = -1
        var dot_flat: i64 = 1
        var dot_is_f64: i64 = 0
        var dsi: i64 = 0
        while dsi < MC_ST_COUNT {
            let dfi = mc_find_struct_field(dsi, fs, fl)
            if dfi >= 0 {
                let dfb = MC_ST_FIELD_BASE[dsi as usize]
                dot_off = MC_SF_OFFSET[(dfb + dfi) as usize]
                dot_flat = MC_SF_FLAT_SIZE[(dfb + dfi) as usize]
                dot_is_f64 = MC_SF_IS_F64[(dfb + dfi) as usize]
                dsi = MC_ST_COUNT
            }
            dsi = dsi + 1
        }
        if dot_off >= 0 {
            // Stack structs grow downward: field N is at [base - N*8]
            let dot_disp = 0 - (dot_off * 8)
            if dot_flat == 1 {
                if dot_off == 0 {
                    we(0x48); we(0x8b); we(0x00)  // mov rax, [rax]
                } else {
                    we(0x48); we(0x8b); we(0x80)  // mov rax, [rax + disp32]
                    we32(dot_disp)
                }
                // Propagate f64 type from struct field
                if dot_is_f64 == 1 {
                    MC_EXPR_IS_F64 = 1
                    we(0x66); we(0x48); we(0x0f); we(0x6e); we(0xc0)  // movq xmm0, rax
                }
            } else {
                if dot_off > 0 {
                    we(0x48); we(0x8d); we(0x80)  // lea rax, [rax + disp32]
                    we32(dot_disp)
                }
            }
        }
    }
    // Pratt operator loop
    while true {
        let op = mc_peek()
        let prec = mc_binop_prec(op)
        if prec == 0 || prec < min_prec { break }
        mc_advance()

        // Save left operand and its type
        let left_slot = mc_alloc_slot()
        mc_emit_store_rax(left_slot)
        var mc_left_is_f64 = MC_EXPR_IS_F64

        // Parse right operand with higher precedence
        mc_parse_expr_prec(prec + 1)

        // rax = right, [left_slot] = left
        // mov rcx, rax (right); load rax, left
        we(0x48); we(0x89); we(0xc1)  // mov rcx, rax
        mc_emit_load_rax(left_slot)

        // Emit binary operation: rax = rax OP rcx
        // Check if this is f64 arithmetic (left_was_f64 saved before right parse)
        if mc_left_is_f64 == 1 && (op == MC_TK_PLUS() || op == MC_TK_MINUS() || op == MC_TK_STAR() || op == MC_TK_SLASH()) {
            // f64 path: bits in rax (left) and rcx (right)
            // movq xmm0, rax; movq xmm1, rcx
            we(0x66); we(0x48); we(0x0F); we(0x6E); we(0xC0)
            we(0x66); we(0x48); we(0x0F); we(0x6E); we(0xC9)
            if op == MC_TK_PLUS() {
                we(0xF2); we(0x0F); we(0x58); we(0xC1)  // addsd xmm0, xmm1
            } else if op == MC_TK_MINUS() {
                we(0xF2); we(0x0F); we(0x5C); we(0xC1)  // subsd xmm0, xmm1
            } else if op == MC_TK_STAR() {
                we(0xF2); we(0x0F); we(0x59); we(0xC1)  // mulsd xmm0, xmm1
            } else if op == MC_TK_SLASH() {
                we(0xF2); we(0x0F); we(0x5E); we(0xC1)  // divsd xmm0, xmm1
            }
            // movq rax, xmm0
            we(0x66); we(0x48); we(0x0F); we(0x7E); we(0xC0)
            MC_EXPR_IS_F64 = 1
        } else if mc_left_is_f64 == 1 && (op == MC_TK_EQEQ() || op == MC_TK_BANGEQ() || op == MC_TK_LT() || op == MC_TK_GT() || op == MC_TK_LTEQ() || op == MC_TK_GTEQ()) {
            // f64 comparison: ucomisd xmm0, xmm1 then setCC
            we(0x66); we(0x48); we(0x0F); we(0x6E); we(0xC0)
            we(0x66); we(0x48); we(0x0F); we(0x6E); we(0xC9)
            we(0x66); we(0x0F); we(0x2E); we(0xC1)  // ucomisd xmm0, xmm1
            if op == MC_TK_EQEQ() { we(0x0f); we(0x94); we(0xc0) }
            else if op == MC_TK_BANGEQ() { we(0x0f); we(0x95); we(0xc0) }
            else if op == MC_TK_LT() { we(0x0f); we(0x92); we(0xc0) }
            else if op == MC_TK_GT() { we(0x0f); we(0x97); we(0xc0) }
            else if op == MC_TK_LTEQ() { we(0x0f); we(0x96); we(0xc0) }
            else if op == MC_TK_GTEQ() { we(0x0f); we(0x93); we(0xc0) }
            we(0x48); we(0x0f); we(0xb6); we(0xc0)  // movzx rax, al
            MC_EXPR_IS_F64 = 0
        } else if op == MC_TK_PLUS() {
            we(0x48); we(0x01); we(0xc8)  // add rax, rcx
        } else if op == MC_TK_MINUS() {
            we(0x48); we(0x29); we(0xc8)  // sub rax, rcx
        } else if op == MC_TK_STAR() {
            we(0x48); we(0x0f); we(0xaf); we(0xc1)  // imul rax, rcx
        } else if op == MC_TK_SLASH() {
            // cqo; idiv rcx
            we(0x48); we(0x99)
            we(0x48); we(0xf7); we(0xf9)
        } else if op == MC_TK_PERCENT() {
            // cqo; idiv rcx; mov rax, rdx
            we(0x48); we(0x99)
            we(0x48); we(0xf7); we(0xf9)
            we(0x48); we(0x89); we(0xd0)
        } else if op == MC_TK_EQEQ() {
            we(0x48); we(0x39); we(0xc8)  // cmp rax, rcx
            we(0x0f); we(0x94); we(0xc0)  // sete al
            we(0x48); we(0x0f); we(0xb6); we(0xc0)  // movzx rax, al
        } else if op == MC_TK_BANGEQ() {
            we(0x48); we(0x39); we(0xc8)
            we(0x0f); we(0x95); we(0xc0)  // setne al
            we(0x48); we(0x0f); we(0xb6); we(0xc0)
        } else if op == MC_TK_LT() {
            we(0x48); we(0x39); we(0xc8)
            we(0x0f); we(0x9c); we(0xc0)  // setl al
            we(0x48); we(0x0f); we(0xb6); we(0xc0)
        } else if op == MC_TK_GT() {
            we(0x48); we(0x39); we(0xc8)
            we(0x0f); we(0x9f); we(0xc0)  // setg al
            we(0x48); we(0x0f); we(0xb6); we(0xc0)
        } else if op == MC_TK_LTEQ() {
            we(0x48); we(0x39); we(0xc8)
            we(0x0f); we(0x9e); we(0xc0)  // setle al
            we(0x48); we(0x0f); we(0xb6); we(0xc0)
        } else if op == MC_TK_GTEQ() {
            we(0x48); we(0x39); we(0xc8)
            we(0x0f); we(0x9d); we(0xc0)  // setge al
            we(0x48); we(0x0f); we(0xb6); we(0xc0)
        } else if op == MC_TK_AMPAMP() {
            // Logical AND: both non-zero → 1
            we(0x48); we(0x85); we(0xc0)  // test rax, rax
            we(0x0f); we(0x95); we(0xc0)  // setne al
            we(0x48); we(0x85); we(0xc9)  // test rcx, rcx
            we(0x0f); we(0x95); we(0xc1)  // setne cl
            we(0x20); we(0xc8)            // and al, cl
            we(0x48); we(0x0f); we(0xb6); we(0xc0)
        } else if op == MC_TK_PIPEPIPE() {
            // Logical OR: either non-zero → 1
            we(0x48); we(0x09); we(0xc8)  // or rax, rcx
            we(0x48); we(0x85); we(0xc0)  // test rax, rax
            we(0x0f); we(0x95); we(0xc0)  // setne al
            we(0x48); we(0x0f); we(0xb6); we(0xc0)
        }
    }
    0
}

// --- Statement parser ---

fn mc_parse_stmt() with Mut, Panic, Div {
    let k = mc_peek()

    // let binding
    if k == MC_TK_LET() {
        mc_advance()
        let ns = MP_START[MC_POS as usize]
        let ne = MP_END[MC_POS as usize]
        let nl = ne - ns
        mc_advance()  // consume ident
        // Optional type annotation: : TYPE — detect f64 and struct
        var let_is_f64: i64 = 0
        var let_st: i64 = -1
        if mc_peek() == MC_TK_COLON() {
            mc_advance()
            if mc_peek() == MC_TK_IDENT() || mc_peek() == MC_TK_ENUM() {
                let ts = MP_START[MC_POS as usize]
                let tl = MP_END[MC_POS as usize] - ts
                if mc_src_eq_at(ts, tl, "f64") { let_is_f64 = 1 }
                else { let_st = mc_type_name_to_struct(ts, tl) }
            }
            mc_skip_type()
        }
        mc_expect(MC_TK_EQ())
        // If no type annotation, peek for struct literal: StructName {
        if let_st < 0 && let_is_f64 == 0 && mc_peek() == MC_TK_IDENT() {
            let rhs_s = MP_START[MC_POS as usize]
            let rhs_l = MP_END[MC_POS as usize] - rhs_s
            if MC_POS + 1 < MC_TC && MP_KIND[(MC_POS + 1) as usize] == MC_TK_LBRACE() {
                let_st = mc_find_struct(rhs_s, rhs_l)
            }
        }
        mc_parse_expr()
        if let_st >= 0 {
            let slot = mc_add_local_struct(ns, nl, let_st)
            mc_emit_struct_copy_from_rax(slot, MC_ST_FLAT_SIZE[let_st as usize])
        } else if let_is_f64 == 1 || MC_EXPR_IS_F64 == 1 {
            let slot = mc_add_local_f64(ns, nl)
            mc_emit_store_rax(slot)
        } else {
            let slot = mc_add_local(ns, nl)
            mc_emit_store_rax(slot)
        }
        return 0
    }

    // var binding
    if k == MC_TK_VAR() {
        mc_advance()
        let ns = MP_START[MC_POS as usize]
        let ne = MP_END[MC_POS as usize]
        let nl = ne - ns
        mc_advance()  // consume ident
        // Optional type annotation — detect f64 and struct
        var var_is_f64: i64 = 0
        var var_st: i64 = -1
        if mc_peek() == MC_TK_COLON() {
            mc_advance()
            if mc_peek() == MC_TK_IDENT() || mc_peek() == MC_TK_ENUM() {
                let ts = MP_START[MC_POS as usize]
                let tl = MP_END[MC_POS as usize] - ts
                if mc_src_eq_at(ts, tl, "f64") { var_is_f64 = 1 }
                else { var_st = mc_type_name_to_struct(ts, tl) }
            }
            mc_skip_type()
        }
        mc_expect(MC_TK_EQ())
        if var_st < 0 && var_is_f64 == 0 && mc_peek() == MC_TK_IDENT() {
            let rhs_s = MP_START[MC_POS as usize]
            let rhs_l = MP_END[MC_POS as usize] - rhs_s
            if MC_POS + 1 < MC_TC && MP_KIND[(MC_POS + 1) as usize] == MC_TK_LBRACE() {
                var_st = mc_find_struct(rhs_s, rhs_l)
            }
        }
        mc_parse_expr()
        if var_st >= 0 {
            let slot = mc_add_local_struct(ns, nl, var_st)
            mc_emit_struct_copy_from_rax(slot, MC_ST_FLAT_SIZE[var_st as usize])
        } else if var_is_f64 == 1 || MC_EXPR_IS_F64 == 1 {
            let slot = mc_add_local_f64(ns, nl)
            mc_emit_store_rax(slot)
        } else {
            let slot = mc_add_local(ns, nl)
            mc_emit_store_rax(slot)
        }
        return 0
    }

    // return
    if k == MC_TK_RETURN() {
        mc_advance()
        if mc_peek() != MC_TK_RBRACE() && mc_peek() != MC_TK_EOF() {
            mc_parse_expr()
        } else {
            we(0x48); we(0x31); we(0xc0)  // xor rax, rax
        }
        // Epilogue: mov rsp, rbp; pop rbp; ret
        we(0x48); we(0x89); we(0xec)
        we(0x5d)
        we(0xc3)
        return 0
    }

    // while loop
    if k == MC_TK_WHILE() {
        mc_advance()
        let loop_top = WIDE_LEN
        // Push loop state
        MC_LOOP_TOP_STACK[MC_LOOP_DEPTH as usize] = loop_top
        MC_LOOP_DEPTH = MC_LOOP_DEPTH + 1
        let saved_break_count = MC_BREAK_FIX_COUNT

        mc_parse_expr()
        // test rax, rax; jz end
        we(0x48); we(0x85); we(0xc0)
        we(0x0f); we(0x84)
        let end_fix = WIDE_LEN
        we32(0)

        mc_expect(MC_TK_LBRACE())
        mc_parse_block_body()
        mc_expect(MC_TK_RBRACE())

        // jmp loop_top
        we(0xe9)
        let back_disp = loop_top - (WIDE_LEN + 4)
        we32(back_disp)

        // Patch end_fix
        let end_off = WIDE_LEN
        let end_disp = end_off - (end_fix + 4)
        WIDE_OUT[end_fix as usize] = (end_disp & 0xFF) as i8
        WIDE_OUT[(end_fix + 1) as usize] = ((end_disp >> 8) & 0xFF) as i8
        WIDE_OUT[(end_fix + 2) as usize] = ((end_disp >> 16) & 0xFF) as i8
        WIDE_OUT[(end_fix + 3) as usize] = ((end_disp >> 24) & 0xFF) as i8

        // Patch break fixups for this loop level
        var bi: i64 = saved_break_count
        while bi < MC_BREAK_FIX_COUNT {
            let bf = MC_BREAK_FIX_OFF[bi as usize]
            let bd = end_off - (bf + 4)
            WIDE_OUT[bf as usize] = (bd & 0xFF) as i8
            WIDE_OUT[(bf + 1) as usize] = ((bd >> 8) & 0xFF) as i8
            WIDE_OUT[(bf + 2) as usize] = ((bd >> 16) & 0xFF) as i8
            WIDE_OUT[(bf + 3) as usize] = ((bd >> 24) & 0xFF) as i8
            bi = bi + 1
        }
        MC_BREAK_FIX_COUNT = saved_break_count

        MC_LOOP_DEPTH = MC_LOOP_DEPTH - 1
        return 0
    }

    // break
    if k == MC_TK_BREAK() {
        mc_advance()
        we(0xe9)
        MC_BREAK_FIX_OFF[MC_BREAK_FIX_COUNT as usize] = WIDE_LEN
        MC_BREAK_FIX_COUNT = MC_BREAK_FIX_COUNT + 1
        we32(0)
        return 0
    }

    // continue
    if k == MC_TK_CONTINUE() {
        mc_advance()
        if MC_LOOP_DEPTH > 0 {
            let lt = MC_LOOP_TOP_STACK[(MC_LOOP_DEPTH - 1) as usize]
            we(0xe9)
            let cd = lt - (WIDE_LEN + 4)
            we32(cd)
        }
        return 0
    }

    // if statement
    if k == MC_TK_IF() {
        mc_parse_if_expr()
        return 0
    }

    // match statement/expression
    if k == MC_TK_MATCH() {
        mc_parse_match_expr()
        return 0
    }

    // Expression statement (including assignment)
    // Could be: ident = expr, ident(args), or bare expression
    if k == MC_TK_IDENT() {
        let id_s = MP_START[MC_POS as usize]
        let id_e = MP_END[MC_POS as usize]
        let id_len = id_e - id_s
        mc_advance()

        // Field access or assignment: ident.field[.field...]
        if mc_peek() == MC_TK_DOT() {
            // Save position to detect assignment vs expression
            let dot_save_pos = MC_POS
            var dot_total_off: i64 = 0
            while mc_peek() == MC_TK_DOT() {
                mc_advance()
                let dfs = MP_START[MC_POS as usize]
                let dfl = MP_END[MC_POS as usize] - dfs
                mc_advance()
                var dsi: i64 = 0
                while dsi < MC_ST_COUNT {
                    let dfi = mc_find_struct_field(dsi, dfs, dfl)
                    if dfi >= 0 {
                        let dfb = MC_ST_FIELD_BASE[dsi as usize]
                        dot_total_off = dot_total_off + MC_SF_OFFSET[(dfb + dfi) as usize]
                        dsi = MC_ST_COUNT
                    }
                    dsi = dsi + 1
                }
            }
            if mc_peek() == MC_TK_EQ() {
                // Field assignment: ident.field = expr
                mc_advance()
                mc_parse_expr()
                let slot = mc_find_local(id_s, id_len)
                if slot >= 0 {
                    mc_emit_store_rax(slot + dot_total_off)
                }
                return 0
            }
            // Not assignment — rewind and parse as expression
            MC_POS = MC_POS - 1  // back up
            // Actually, reset to before dot and let expression parser handle it
            MC_POS = dot_save_pos - 1  // rewind to ident
            mc_parse_expr()
            return 0
        }

        // Assignment: ident = expr
        if mc_peek() == MC_TK_EQ() {
            mc_advance()
            mc_parse_expr()
            let slot = mc_find_local(id_s, id_len)
            if slot >= 0 {
                mc_emit_store_rax(slot)
            }
            return 0
        }

        // Compound assignment: ident += expr
        if mc_peek() == MC_TK_PLUS_EQ() {
            mc_advance()
            mc_parse_expr()
            let slot = mc_find_local(id_s, id_len)
            if slot >= 0 {
                we(0x48); we(0x89); we(0xc1)  // mov rcx, rax
                mc_emit_load_rax(slot)
                we(0x48); we(0x01); we(0xc8)  // add rax, rcx
                mc_emit_store_rax(slot)
            }
            return 0
        }
        if mc_peek() == MC_TK_MINUS_EQ() {
            mc_advance()
            mc_parse_expr()
            let slot = mc_find_local(id_s, id_len)
            if slot >= 0 {
                we(0x48); we(0x89); we(0xc1)
                mc_emit_load_rax(slot)
                we(0x48); we(0x29); we(0xc8)
                mc_emit_store_rax(slot)
            }
            return 0
        }
        if mc_peek() == MC_TK_STAR_EQ() {
            mc_advance()
            mc_parse_expr()
            let slot = mc_find_local(id_s, id_len)
            if slot >= 0 {
                we(0x48); we(0x89); we(0xc1)
                mc_emit_load_rax(slot)
                we(0x48); we(0x0f); we(0xaf); we(0xc1)
                mc_emit_store_rax(slot)
            }
            return 0
        }

        // Function call: ident(args) — may have trailing binops (e.g. fib(n-1) + fib(n-2))
        if mc_peek() == MC_TK_LPAREN() {
            mc_advance()
            mc_emit_call(id_s, id_len)
            // rax = call result; fall through to trailing binop check
        } else {
            // Bare expression — the ident was already consumed, emit variable load
            let slot = mc_find_local(id_s, id_len)
            if slot >= 0 {
                mc_emit_load_rax(slot)
                MC_EXPR_IS_F64 = mc_local_is_f64(id_s, id_len)
            } else {
                we(0x48); we(0x31); we(0xc0)
                MC_EXPR_IS_F64 = 0
            }
        }
        // Check for trailing binops (handles: fib(n-1) + fib(n-2), x + 1, etc.)
        while true {
            let op = mc_peek()
            let prec = mc_binop_prec(op)
            if prec == 0 { break }
            mc_advance()
            let ls = mc_alloc_slot()
            mc_emit_store_rax(ls)
            var stmt_left_f64 = MC_EXPR_IS_F64
            mc_parse_expr_prec(prec + 1)
            we(0x48); we(0x89); we(0xc1)
            mc_emit_load_rax(ls)
            // f64 trailing binop path
            if stmt_left_f64 == 1 && (op == MC_TK_PLUS() || op == MC_TK_MINUS() || op == MC_TK_STAR() || op == MC_TK_SLASH()) {
                we(0x66); we(0x48); we(0x0F); we(0x6E); we(0xC0)
                we(0x66); we(0x48); we(0x0F); we(0x6E); we(0xC9)
                if op == MC_TK_PLUS() { we(0xF2); we(0x0F); we(0x58); we(0xC1) }
                else if op == MC_TK_MINUS() { we(0xF2); we(0x0F); we(0x5C); we(0xC1) }
                else if op == MC_TK_STAR() { we(0xF2); we(0x0F); we(0x59); we(0xC1) }
                else if op == MC_TK_SLASH() { we(0xF2); we(0x0F); we(0x5E); we(0xC1) }
                we(0x66); we(0x48); we(0x0F); we(0x7E); we(0xC0)
                MC_EXPR_IS_F64 = 1
            } else if stmt_left_f64 == 1 && (op == MC_TK_EQEQ() || op == MC_TK_BANGEQ() || op == MC_TK_LT() || op == MC_TK_GT() || op == MC_TK_LTEQ() || op == MC_TK_GTEQ()) {
                we(0x66); we(0x48); we(0x0F); we(0x6E); we(0xC0)
                we(0x66); we(0x48); we(0x0F); we(0x6E); we(0xC9)
                we(0x66); we(0x0F); we(0x2E); we(0xC1)
                if op == MC_TK_EQEQ() { we(0x0f); we(0x94); we(0xc0) }
                else if op == MC_TK_BANGEQ() { we(0x0f); we(0x95); we(0xc0) }
                else if op == MC_TK_LT() { we(0x0f); we(0x92); we(0xc0) }
                else if op == MC_TK_GT() { we(0x0f); we(0x97); we(0xc0) }
                else if op == MC_TK_LTEQ() { we(0x0f); we(0x96); we(0xc0) }
                else if op == MC_TK_GTEQ() { we(0x0f); we(0x93); we(0xc0) }
                we(0x48); we(0x0f); we(0xb6); we(0xc0)
                MC_EXPR_IS_F64 = 0
            } else if op == MC_TK_PLUS() { we(0x48); we(0x01); we(0xc8) }
            else if op == MC_TK_MINUS() { we(0x48); we(0x29); we(0xc8) }
            else if op == MC_TK_STAR() { we(0x48); we(0x0f); we(0xaf); we(0xc1) }
            else if op == MC_TK_SLASH() { we(0x48); we(0x99); we(0x48); we(0xf7); we(0xf9) }
            else if op == MC_TK_PERCENT() { we(0x48); we(0x99); we(0x48); we(0xf7); we(0xf9); we(0x48); we(0x89); we(0xd0) }
            else if op == MC_TK_EQEQ() { we(0x48); we(0x39); we(0xc8); we(0x0f); we(0x94); we(0xc0); we(0x48); we(0x0f); we(0xb6); we(0xc0) }
            else if op == MC_TK_BANGEQ() { we(0x48); we(0x39); we(0xc8); we(0x0f); we(0x95); we(0xc0); we(0x48); we(0x0f); we(0xb6); we(0xc0) }
            else if op == MC_TK_LT() { we(0x48); we(0x39); we(0xc8); we(0x0f); we(0x9c); we(0xc0); we(0x48); we(0x0f); we(0xb6); we(0xc0) }
            else if op == MC_TK_GT() { we(0x48); we(0x39); we(0xc8); we(0x0f); we(0x9f); we(0xc0); we(0x48); we(0x0f); we(0xb6); we(0xc0) }
            else if op == MC_TK_LTEQ() { we(0x48); we(0x39); we(0xc8); we(0x0f); we(0x9e); we(0xc0); we(0x48); we(0x0f); we(0xb6); we(0xc0) }
            else if op == MC_TK_GTEQ() { we(0x48); we(0x39); we(0xc8); we(0x0f); we(0x9d); we(0xc0); we(0x48); we(0x0f); we(0xb6); we(0xc0) }
            else if op == MC_TK_AMPAMP() {
                we(0x48); we(0x85); we(0xc0); we(0x0f); we(0x95); we(0xc0)
                we(0x48); we(0x85); we(0xc9); we(0x0f); we(0x95); we(0xc1)
                we(0x20); we(0xc8); we(0x48); we(0x0f); we(0xb6); we(0xc0)
            }
            else if op == MC_TK_PIPEPIPE() {
                we(0x48); we(0x09); we(0xc8); we(0x48); we(0x85); we(0xc0)
                we(0x0f); we(0x95); we(0xc0); we(0x48); we(0x0f); we(0xb6); we(0xc0)
            }
        }
        return 0
    }

    // Default: try to parse as expression
    mc_parse_expr()
    0
}

// Skip a type annotation (consumes tokens until next = or { or , or ) )
fn mc_skip_type() with Mut, Panic {
    var depth: i64 = 0
    while MC_POS < MC_TC {
        let tk = mc_peek()
        if tk == MC_TK_LPAREN() || tk == MC_TK_LBRACKET() || tk == MC_TK_LT() { depth = depth + 1; mc_advance(); continue }
        if tk == MC_TK_RPAREN() || tk == MC_TK_RBRACKET() || tk == MC_TK_GT() {
            if depth > 0 { depth = depth - 1; mc_advance(); continue }
            break
        }
        if depth == 0 {
            if tk == MC_TK_EQ() || tk == MC_TK_LBRACE() || tk == MC_TK_COMMA() { break }
            if tk == MC_TK_WITH() { break }
        }
        mc_advance()
    }
}

// Parse block body (between { and }) — handles multiple statements
fn mc_parse_block_body() with Mut, Panic, Div {
    while mc_peek() != MC_TK_RBRACE() && mc_peek() != MC_TK_EOF() {
        mc_parse_stmt()
    }
}

// --- Pass 0: Scan struct declarations ---
fn mc_scan_structs() with Mut, Panic, Div {
    MC_POS = 0
    MC_ST_COUNT = 0
    MC_SF_TOTAL = 0
    while MC_POS < MC_TC {
        let k = mc_peek()
        if k == MC_TK_STRUCT() {
            mc_advance()
            // Struct name
            let ns = MP_START[MC_POS as usize]
            let ne = MP_END[MC_POS as usize]
            let nl = ne - ns
            let si = MC_ST_COUNT
            MC_ST_NAME_START[si as usize] = ns
            MC_ST_NAME_LEN[si as usize] = nl
            MC_ST_FIELD_BASE[si as usize] = MC_SF_TOTAL
            mc_advance()  // consume name
            mc_expect(MC_TK_LBRACE())
            var fc: i64 = 0
            var flat_off: i64 = 0
            while mc_peek() != MC_TK_RBRACE() && mc_peek() != MC_TK_EOF() {
                // field_name : type ,
                let fs = MP_START[MC_POS as usize]
                let fe = MP_END[MC_POS as usize]
                let fl = fe - fs
                mc_advance()  // consume field name
                let fi = MC_SF_TOTAL
                MC_SF_NAME_START[fi as usize] = fs
                MC_SF_NAME_LEN[fi as usize] = fl
                MC_SF_OFFSET[fi as usize] = flat_off
                // Parse : type
                var field_struct: i64 = -1
                var field_flat: i64 = 1
                if mc_peek() == MC_TK_COLON() {
                    mc_advance()
                    // Read type name token
                    if mc_peek() == MC_TK_IDENT() || mc_peek() == MC_TK_STRUCT() || mc_peek() == MC_TK_ENUM() {
                        let ts = MP_START[MC_POS as usize]
                        let te = MP_END[MC_POS as usize]
                        let tl = te - ts
                        // Look up if it's a previously declared struct
                        field_struct = mc_find_struct(ts, tl)
                        if field_struct >= 0 {
                            field_flat = MC_ST_FLAT_SIZE[field_struct as usize]
                        }
                        mc_advance()
                    } else {
                        // Skip other type tokens (scalars etc)
                        mc_skip_type()
                    }
                }
                // Check if field type is f64
                var field_is_f64: i64 = 0
                if field_struct < 0 && field_flat == 1 {
                    // Re-check type name for "f64"
                    let fts = MC_SF_NAME_START[fi as usize]  // reuse for type check
                    // Actually check the type token we just parsed
                    // The type was at ts,tl — check if it's "f64" (102, 54, 52)
                    if mc_peek() == MC_TK_COMMA() || mc_peek() == MC_TK_RBRACE() {
                        // Type already consumed; check ts/tl from above
                        // Note: ts/tl are out of scope here, so check via flat_off tracking
                        // Instead, peek back at the source bytes at the type token position
                        let ft_pos = MC_POS - 1
                        if ft_pos >= 0 && ft_pos < MC_TC {
                            let fts2 = MP_START[ft_pos as usize]
                            let fte2 = MP_END[ft_pos as usize]
                            if fte2 - fts2 == 3 {
                                if ltp_byte(fts2) == 102 && ltp_byte(fts2 + 1) == 54 && ltp_byte(fts2 + 2) == 52 {
                                    field_is_f64 = 1
                                }
                            }
                        }
                    }
                }
                MC_SF_FLAT_SIZE[fi as usize] = field_flat
                MC_SF_TYPE_STRUCT[fi as usize] = field_struct
                MC_SF_IS_F64[fi as usize] = field_is_f64
                MC_SF_TOTAL = MC_SF_TOTAL + 1
                flat_off = flat_off + field_flat
                fc = fc + 1
                if mc_peek() == MC_TK_COMMA() { mc_advance() }
            }
            mc_expect(MC_TK_RBRACE())
            MC_ST_FIELD_COUNT[si as usize] = fc
            MC_ST_FLAT_SIZE[si as usize] = flat_off
            MC_ST_COUNT = MC_ST_COUNT + 1
            print("mc: struct ")
            var pi: i64 = 0
            while pi < nl && pi < 32 { print_char(ltp_byte(ns + pi) as i64); pi = pi + 1 }
            print(" fields=")
            print_int(fc)
            print(" flat=")
            print_int(flat_off)
            print("\n")
        } else {
            mc_advance()
        }
    }
}

// --- Pass 0b: Scan enum declarations ---
fn mc_scan_enums() with Mut, Panic, Div {
    MC_POS = 0
    MC_EN_COUNT = 0
    MC_EV_COUNT = 0
    while MC_POS < MC_TC {
        let k = mc_peek()
        if k == MC_TK_ENUM() {
            mc_advance()
            // Enum name
            let ns = MP_START[MC_POS as usize]
            let ne = MP_END[MC_POS as usize]
            let nl = ne - ns
            let ei = MC_EN_COUNT
            MC_EN_NAME_START[ei as usize] = ns
            MC_EN_NAME_LEN[ei as usize] = nl
            MC_EN_FIRST_EV[ei as usize] = MC_EV_COUNT
            mc_advance()  // consume name
            mc_expect(MC_TK_LBRACE())
            var vc: i64 = 0
            while mc_peek() != MC_TK_RBRACE() && mc_peek() != MC_TK_EOF() {
                // Variant name
                let vs = MP_START[MC_POS as usize]
                let ve = MP_END[MC_POS as usize]
                let vl = ve - vs
                mc_advance()  // consume variant name
                let vi = MC_EV_COUNT
                MC_EV_NAME_START[vi as usize] = vs
                MC_EV_NAME_LEN[vi as usize] = vl
                MC_EV_VALUE[vi as usize] = vc
                MC_EV_COUNT = MC_EV_COUNT + 1
                vc = vc + 1
                if mc_peek() == MC_TK_COMMA() { mc_advance() }
            }
            mc_expect(MC_TK_RBRACE())
            MC_EN_EV_COUNT[ei as usize] = vc
            MC_EN_COUNT = MC_EN_COUNT + 1
            print("mc: enum ")
            var pi: i64 = 0
            while pi < nl && pi < 32 { print_char(ltp_byte(ns + pi) as i64); pi = pi + 1 }
            print(" variants=")
            print_int(vc)
            print("\n")
        } else {
            mc_advance()
        }
    }
}

// --- Pass 1: Scan all fn declarations, collect names + body token positions ---
fn mc_scan_functions() with Mut, Panic, Div {
    MC_POS = 0
    MC_FN_COUNT = 0
    MC_PARAM_TOTAL = 0
    while MC_POS < MC_TC {
        let k = mc_peek()
        if k == MC_TK_FN() {
            mc_advance()
            // Function name
            let ns = MP_START[MC_POS as usize]
            let ne = MP_END[MC_POS as usize]
            let nl = ne - ns
            let fi = MC_FN_COUNT

            MC_FN_NAME_START[fi as usize] = ns
            MC_FN_NAME_LEN[fi as usize] = nl
            MC_FN_OFF[fi as usize] = 0  // will be set in pass 2
            MC_FN_PARAM_BASE[fi as usize] = MC_PARAM_TOTAL
            mc_advance()  // consume name

            // Check if this is main
            if mc_src_eq_at(ns, nl, "main") { MC_MAIN_FN = fi }

            // Parse params: ( name: type, ... )
            mc_expect(MC_TK_LPAREN())
            var pc: i64 = 0
            while mc_peek() != MC_TK_RPAREN() && mc_peek() != MC_TK_EOF() {
                let ps = MP_START[MC_POS as usize]
                let pe = MP_END[MC_POS as usize]
                let pl = pe - ps
                mc_advance()  // consume param name
                MC_PARAM_NAME_START[MC_PARAM_TOTAL as usize] = ps
                MC_PARAM_NAME_LEN[MC_PARAM_TOTAL as usize] = pl
                // Parse : type and resolve struct
                var param_st: i64 = -1
                var param_f64: i64 = 0
                if mc_peek() == MC_TK_COLON() {
                    mc_advance()
                    if mc_peek() == MC_TK_IDENT() || mc_peek() == MC_TK_STRUCT() || mc_peek() == MC_TK_ENUM() {
                        let ts = MP_START[MC_POS as usize]
                        let te = MP_END[MC_POS as usize]
                        let tl = te - ts
                        if mc_src_eq_at(ts, tl, "f64") { param_f64 = 1 }
                        else { param_st = mc_type_name_to_struct(ts, tl) }
                    }
                    mc_skip_type()
                }
                MC_PARAM_TYPE[MC_PARAM_TOTAL as usize] = param_st
                MC_PARAM_IS_F64[MC_PARAM_TOTAL as usize] = param_f64
                MC_PARAM_TOTAL = MC_PARAM_TOTAL + 1
                pc = pc + 1
                if mc_peek() == MC_TK_COMMA() { mc_advance() }
            }
            mc_expect(MC_TK_RPAREN())
            MC_FN_PARAM_COUNT[fi as usize] = pc

            // Parse -> return_type (and resolve struct)
            MC_FN_RET_TYPE[fi as usize] = -1
            if mc_peek() == MC_TK_ARROW() {
                mc_advance()
                if mc_peek() == MC_TK_IDENT() || mc_peek() == MC_TK_STRUCT() || mc_peek() == MC_TK_ENUM() {
                    let rts = MP_START[MC_POS as usize]
                    let rte = MP_END[MC_POS as usize]
                    let rtl = rte - rts
                    MC_FN_RET_TYPE[fi as usize] = mc_type_name_to_struct(rts, rtl)
                }
                mc_skip_type()
            }

            // Skip with EFFECTS
            if mc_peek() == MC_TK_WITH() {
                mc_advance()
                while mc_peek() == MC_TK_IDENT() || mc_peek() == MC_TK_COMMA() {
                    mc_advance()
                }
            }

            // Record body token position
            MC_FN_BODY_TOK[fi as usize] = MC_POS  // should be at {
            MC_FN_COUNT = MC_FN_COUNT + 1

            // Skip body (brace-balanced)
            if mc_peek() == MC_TK_LBRACE() {
                mc_advance()
                var depth: i64 = 1
                while MC_POS < MC_TC && depth > 0 {
                    let bk = mc_peek()
                    if bk == MC_TK_LBRACE() { depth = depth + 1 }
                    if bk == MC_TK_RBRACE() { depth = depth - 1 }
                    mc_advance()
                }
            }
        } else if k == MC_TK_STRUCT() {
            // Skip struct declaration (already parsed in mc_scan_structs)
            mc_advance()  // struct
            if mc_peek() == MC_TK_IDENT() { mc_advance() }  // name
            if mc_peek() == MC_TK_LBRACE() {
                mc_advance()
                var sd: i64 = 1
                while MC_POS < MC_TC && sd > 0 {
                    let sk = mc_peek()
                    if sk == MC_TK_LBRACE() { sd = sd + 1 }
                    if sk == MC_TK_RBRACE() { sd = sd - 1 }
                    mc_advance()
                }
            }
        } else if k == MC_TK_ENUM() {
            // Skip enum declaration (already parsed in mc_scan_enums)
            mc_advance()  // enum
            if mc_peek() == MC_TK_IDENT() || mc_peek() == MC_TK_ENUM() { mc_advance() }  // name
            if mc_peek() == MC_TK_LBRACE() {
                mc_advance()
                var ed: i64 = 1
                while MC_POS < MC_TC && ed > 0 {
                    let ek = mc_peek()
                    if ek == MC_TK_LBRACE() { ed = ed + 1 }
                    if ek == MC_TK_RBRACE() { ed = ed - 1 }
                    mc_advance()
                }
            }
        } else {
            // Skip non-fn top-level items (var declarations, use, etc.)
            mc_advance()
        }
    }
}

// --- Pass 2: Compile each function body ---
fn mc_compile_functions() with Mut, Panic, Div {
    var fi: i64 = 0
    while fi < MC_FN_COUNT {
        MC_FN_OFF[fi as usize] = WIDE_LEN

        // Reset locals
        mc_locals_reset()

        // Prologue: push rbp; mov rbp, rsp; sub rsp, FRAME_SIZE
        we(0x55)
        we(0x48); we(0x89); we(0xe5)
        we(0x48); we(0x81); we(0xec)
        we32(MC_FRAME_SIZE())

        // Spill parameters into local slots
        let param_base = MC_FN_PARAM_BASE[fi as usize]
        let param_count = MC_FN_PARAM_COUNT[fi as usize]
        var pi: i64 = 0
        while pi < param_count {
            let ps = MC_PARAM_NAME_START[(param_base + pi) as usize]
            let pl = MC_PARAM_NAME_LEN[(param_base + pi) as usize]
            let pst = MC_PARAM_TYPE[(param_base + pi) as usize]
            if pst >= 0 {
                // Struct parameter: register holds pointer to struct data
                let slot = mc_add_local_struct(ps, pl, pst)
                // Move pointer from ABI register into rax
                if pi == 0 { we(0x48); we(0x89); we(0xf8) }       // mov rax, rdi
                else if pi == 1 { we(0x48); we(0x89); we(0xf0) }  // mov rax, rsi
                else if pi == 2 { we(0x48); we(0x89); we(0xd0) }  // mov rax, rdx
                else if pi == 3 { we(0x48); we(0x89); we(0xc8) }  // mov rax, rcx
                else if pi == 4 { we(0x4c); we(0x89); we(0xc0) }  // mov rax, r8
                else if pi == 5 { we(0x4c); we(0x89); we(0xc8) }  // mov rax, r9
                // Copy struct fields from [rax] to local stack slots
                mc_emit_struct_copy_from_rax(slot, MC_ST_FLAT_SIZE[pst as usize])
            } else {
                // Scalar or f64 parameter
                let param_is_float = MC_PARAM_IS_F64[(param_base + pi) as usize]
                var slot: i64 = 0
                if param_is_float == 1 {
                    slot = mc_add_local_f64(ps, pl)
                } else {
                    slot = mc_add_local(ps, pl)
                }
                if pi == 0 { we(0x48); we(0x89); we(0xf8) }       // mov rax, rdi
                else if pi == 1 { we(0x48); we(0x89); we(0xf0) }  // mov rax, rsi
                else if pi == 2 { we(0x48); we(0x89); we(0xd0) }  // mov rax, rdx
                else if pi == 3 { we(0x48); we(0x89); we(0xc8) }  // mov rax, rcx
                else if pi == 4 { we(0x4c); we(0x89); we(0xc0) }  // mov rax, r8
                else if pi == 5 { we(0x4c); we(0x89); we(0xc8) }  // mov rax, r9
                mc_emit_store_rax(slot)
            }
            pi = pi + 1
        }

        // Position at body start (should be { token)
        MC_POS = MC_FN_BODY_TOK[fi as usize]
        mc_expect(MC_TK_LBRACE())

        // Compile body statements
        mc_parse_block_body()
        mc_expect(MC_TK_RBRACE())

        // Implicit epilogue (if not already returned)
        // Check if last emitted byte was ret
        if WIDE_LEN == 0 || WIDE_OUT[(WIDE_LEN - 1) as usize] != (0xc3 as i8) {
            // Don't zero rax — last expression value is the implicit return
            // mov rsp, rbp; pop rbp; ret
            we(0x48); we(0x89); we(0xec)
            we(0x5d)
            we(0xc3)
        }

        print("mc: fn ")
        var ni: i64 = 0
        let nns = MC_FN_NAME_START[fi as usize]
        let nnl = MC_FN_NAME_LEN[fi as usize]
        while ni < nnl && ni < 32 {
            print_char(ltp_byte(nns + ni) as i64)
            ni = ni + 1
        }
        print(" off=")
        print_int(MC_FN_OFF[fi as usize])
        print(" sz=")
        print_int(WIDE_LEN - MC_FN_OFF[fi as usize])
        print("\n")

        fi = fi + 1
    }
}

// --- Patch call fixups ---
fn mc_patch_calls() with Mut, Panic {
    var i: i64 = 0
    while i < MC_CALL_FIX_COUNT {
        let fix_off = MC_CALL_FIX_OFF[i as usize]
        let fn_idx = MC_CALL_FIX_TARGET[i as usize]
        let target = MC_FN_OFF[fn_idx as usize]
        let disp = target - (fix_off + 4)
        WIDE_OUT[fix_off as usize] = (disp & 0xFF) as i8
        WIDE_OUT[(fix_off + 1) as usize] = ((disp >> 8) & 0xFF) as i8
        WIDE_OUT[(fix_off + 2) as usize] = ((disp >> 16) & 0xFF) as i8
        WIDE_OUT[(fix_off + 3) as usize] = ((disp >> 24) & 0xFF) as i8
        i = i + 1
    }
}

// --- Main entry point ---
fn mini_compile(output_path: string) -> i64 with IO, Mut, Panic, Div, Alloc {
    print("mini_compile: start\n")
    WIDE_LEN = 0
    MC_CALL_FIX_COUNT = 0
    MC_BREAK_FIX_COUNT = 0
    MC_LOOP_DEPTH = 0
    // Ensure LTP_N is set for ltp_byte() (used by string comparison helpers)
    LTP_N = LEAN_SOURCE_LEN

    // MP_* arrays already populated by lean_lex_to_parser() in load_and_parse()
    MC_TC = LTP_TC
    print("mini_compile: tokens=")
    print_int(MC_TC)
    print("\n")

    // Emit print_int helper at start of code section
    mc_emit_print_int_helper()

    // Emit print_f64 helper
    mc_emit_print_f64_helper()

    // Pass 0a: scan struct declarations
    mc_scan_structs()
    print("mini_compile: structs=")
    print_int(MC_ST_COUNT)
    print("\n")

    // Pass 0b: scan enum declarations
    mc_scan_enums()
    print("mini_compile: enums=")
    print_int(MC_EN_COUNT)
    print("\n")

    // Pass 1: scan all function declarations
    mc_scan_functions()
    print("mini_compile: fn_count=")
    print_int(MC_FN_COUNT)
    print(" main=")
    print_int(MC_MAIN_FN)
    print("\n")

    if MC_MAIN_FN < 0 {
        print("mini_compile: no main function found\n")
        return 2
    }

    // Pass 2: compile each function body
    mc_compile_functions()

    // Patch all call fixups
    mc_patch_calls()

    // Emit trampoline: call main, mov edi eax, exit syscall
    let tramp_off = WIDE_LEN
    let main_off = MC_FN_OFF[MC_MAIN_FN as usize]
    we(0xe8)
    let call_rel = main_off - (WIDE_LEN + 4)
    we32(call_rel)
    we(0x89); we(0xc7)                  // mov edi, eax
    we(0xb8); we32(60)                  // mov eax, 60 (exit)
    we(0x0f); we(0x05)                  // syscall

    let total_code = WIDE_LEN
    print("mini_compile: code=")
    print_int(total_code)
    print(" tramp=")
    print_int(tramp_off)
    print("\n")

    // Build ELF
    let base_addr: i64 = 4194304   // 0x400000
    let text_off: i64 = 4096       // 0x1000
    let entry_va = base_addr + text_off + tramp_off

    var ei: i64 = 0
    while ei < text_off + total_code + 16 { GLOBAL_ELF[ei as usize] = 0; ei = ei + 1 }

    // ELF header
    elf_write_byte(0, 0x7f); elf_write_byte(1, 69); elf_write_byte(2, 76); elf_write_byte(3, 70)
    elf_write_byte(4, 2); elf_write_byte(5, 1); elf_write_byte(6, 1)
    elf_write_u16(16, 2); elf_write_u16(18, 0x3e); elf_write_u32(20, 1)
    elf_write_u64(24, entry_va)
    elf_write_u64(32, 64); elf_write_u16(52, 64); elf_write_u16(54, 56); elf_write_u16(56, 1); elf_write_u16(58, 64)
    elf_write_u32(64, 1); elf_write_u32(68, 7)
    elf_write_u64(72, 0); elf_write_u64(80, base_addr); elf_write_u64(88, base_addr)
    let fsz = text_off + total_code
    elf_write_u64(96, fsz); elf_write_u64(104, fsz)
    elf_write_u64(112, 4096)

    // Copy code to text section
    var ci: i64 = 0
    while ci < total_code {
        GLOBAL_ELF[(text_off + ci) as usize] = WIDE_OUT[ci as usize]
        ci = ci + 1
    }

    let total_len = text_off + total_code
    // Use write_file (boot4-compatible) instead of io_write_huge_binary
    let write_ok = write_file(output_path, GLOBAL_ELF, total_len)

    print("mini_compile: ok written=")
    print(output_path)
    print(" size=")
    print_int(total_len)
    print("\n")
    0
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    if argc < 2 {
        print("Usage: render_native_compile_driver_lean.sio <source.sio> <output>\n")
        return 1
    }
    let source_path = get_arg(0)
    let output_path = get_arg(1)

    print("render_compile: source=")
    print(source_path)
    print(" output=")
    print(output_path)
    print("\n")

    // Scan source for global variable declarations before parsing
    scan_source_globals(source_path)
    // LTP_SOURCE + LTP_N already populated by scan_source_globals
    print("render_compile: globals=")
    print_int(GLOBAL_COUNT)
    print(" total_bytes=")
    print_int(GLOBAL_TOTAL_SIZE)
    print("\n")
    var gpi: i64 = 0
    while gpi < GLOBAL_COUNT {
        let gns = str_from_bytes(GLOBAL_NAMES[gpi as usize].buf, GLOBAL_NAMES[gpi as usize].len)
        print("  global: ")
        print(gns)
        print(" off=")
        print_int(GLOBAL_OFFSETS[gpi as usize])
        print(" sz=")
        print_int(GLOBAL_SIZES[gpi as usize])
        print(" elem=")
        print_int(GLOBAL_ELEM_SIZES[gpi as usize])
        print("\n")
        gpi = gpi + 1
    }

    let parsed_items = load_and_parse(source_path)
    if parser_last_error_count() > 0 {
        print("render_compile: parse_error\n")
        return 1
    }
    match parsed_items {
        None => {
            print("render_compile: empty_program (parser returned None)\n")
            return mini_compile(output_path)
        }
        _ => {}
    }

    // ---- AST-direct compilation (bypasses IR lowering + JIT Box bugs) ----

    // === Phase 0: Build struct registry ===
    var ctx: AstCompileCtx = AstCompileCtx {
        struct_count: 0,
        struct_names: [ir_empty_name(); 128],
        struct_flat_size: [0; 128],
        struct_field_count: [0; 128],
        struct_field_base: [0; 128],
        sf_names: [ir_empty_name(); 512],
        sf_flat_offset: [0; 512],
        sf_type: [0; 512],
        sf_flat_size: [0; 512],
        fn_return_types: [0; 512],
        fn_names: [ir_empty_name(); 512],
        fn_count: 0,
        cur_sret: 0,
        cur_sret_dest_slot: 0,
        cur_sret_flat_size: 0,
        enum_variant_names: [ir_empty_name(); 512],
        enum_variant_disc: [0; 512],
        enum_variant_count: 0,
    }
    var sf_next: i64 = 0  // next index in sf_* arrays

    let items_ref0: &Option<Box<ItemList>> = &parsed_items
    var item_cur0 = items_ref0
    while true {
        match *item_cur0 {
            Some(il) => {
                let itm: &Item = &(*il).head
                if itm.kind == ItemKind::ItemStruct {
                    let sd_ref: &Option<Box<StructDef>> = &itm.struct_def
                    match *sd_ref {
                        Some(sd) => {
                            let si = ctx.struct_count
                            ctx.struct_names[si as usize] = (*sd).name
                            ctx.struct_field_base[si as usize] = sf_next
                            var field_count: i64 = 0
                            var flat_off: i64 = 0
                            let fld_ref: &Option<Box<FieldDefList>> = &(*sd).fields
                            var fld_cur = fld_ref
                            while true {
                                match *fld_cur {
                                    Some(fl) => {
                                        let fld: &FieldDef = &(*fl).head
                                        ctx.sf_names[sf_next as usize] = fld.name
                                        ctx.sf_flat_offset[sf_next as usize] = flat_off
                                        // Determine field type
                                        let fty: &TypeExpr = &fld.ty
                                        if fty.kind == TypeExprKind::TypeNamed {
                                            if ast_type_is_f64(fty) {
                                                ctx.sf_type[sf_next as usize] = 1
                                                ctx.sf_flat_size[sf_next as usize] = 1
                                                flat_off = flat_off + 1
                                            } else {
                                                // Check if it's another struct
                                                let fty_name = ast_name_from_path(&fty.path)
                                                let fty_si = ast_lookup_struct(&ctx, fty_name)
                                                if fty_si >= 0 {
                                                    ctx.sf_type[sf_next as usize] = 10 + fty_si
                                                    let sub_sz = ctx.struct_flat_size[fty_si as usize]
                                                    ctx.sf_flat_size[sf_next as usize] = sub_sz
                                                    flat_off = flat_off + sub_sz
                                                } else {
                                                    // i64 or other scalar
                                                    ctx.sf_type[sf_next as usize] = 0
                                                    ctx.sf_flat_size[sf_next as usize] = 1
                                                    flat_off = flat_off + 1
                                                }
                                            }
                                        } else {
                                            ctx.sf_type[sf_next as usize] = 0
                                            ctx.sf_flat_size[sf_next as usize] = 1
                                            flat_off = flat_off + 1
                                        }
                                        sf_next = sf_next + 1
                                        field_count = field_count + 1
                                        fld_cur = &(*fl).tail
                                    }
                                    _ => break
                                }
                            }
                            ctx.struct_field_count[si as usize] = field_count
                            ctx.struct_flat_size[si as usize] = flat_off
                            print("render_compile: struct=")
                            let sn = str_from_bytes((*sd).name.buf, (*sd).name.len)
                            print(sn)
                            print(" flat_size=")
                            print_int(flat_off)
                            print(" fields=")
                            print_int(field_count)
                            print("\n")
                            ctx.struct_count = ctx.struct_count + 1
                        }
                        _ => {}
                    }
                } else if itm.kind == ItemKind::ItemEnum {
                    let ed_ref: &Option<Box<EnumDef>> = &itm.enum_def
                    match *ed_ref {
                        Some(ed) => {
                            let enum_name: Name = (*ed).name
                            let vl_ref: &Option<Box<VariantDefList>> = &(*ed).variants
                            var vl_cur = vl_ref
                            var disc: i64 = 0
                            while true {
                                match *vl_cur {
                                    Some(vl) => {
                                        if ctx.enum_variant_count < 512 {
                                            let vi = ctx.enum_variant_count
                                            ctx.enum_variant_names[vi as usize] = (*vl).head.name
                                            ctx.enum_variant_disc[vi as usize] = disc
                                            ctx.enum_variant_count = ctx.enum_variant_count + 1
                                        }
                                        disc = disc + 1
                                        vl_cur = &(*vl).tail
                                    }
                                    _ => break
                                }
                            }
                            let en = str_from_bytes(enum_name.buf, enum_name.len)
                            print("render_compile: enum=")
                            print(en)
                            print(" variants=")
                            print_int(disc)
                            print("\n")
                        }
                        _ => {}
                    }
                }
                item_cur0 = &(*il).tail
            }
            _ => break
        }
    }

    // === Phase 1: Collect function names + return types ===
    var fn_names: [Name; 512] = [ir_empty_name(); 512]
    var fn_return_types: [i64; 512] = [0; 512]  // 0=i64, 1=f64, 10+=struct
    var fn_count: i64 = 0
    MAIN_FN_IDX = -1  // reset global (global avoids JIT register-clobber heisenbug)

    let items_ref: &Option<Box<ItemList>> = &parsed_items
    var item_cur = items_ref
    while true {
        match *item_cur {
            Some(il) => {
                let itm: &Item = &(*il).head
                if itm.kind == ItemKind::ItemFn {
                    // Check if this is actually a function (has fn_def) or a global var (fn_def=None)
                    let fdef_r: &Option<Box<FnDef>> = &itm.fn_def
                    var is_real_fn = false
                    match *fdef_r {
                        Some(fdr) => { is_real_fn = true }
                        _ => {}
                    }
                    if is_real_fn {
                        fn_names[fn_count as usize] = itm.name
                        // Detect return type: f64 → 1, struct → 10+idx, else → 0
                        match *fdef_r {
                            Some(fdr) => {
                                let rt_ref: &Option<Box<TypeExpr>> = &(*fdr).return_type
                                match *rt_ref {
                                    Some(rte) => {
                                        if ast_type_is_f64(&(*rte)) {
                                            fn_return_types[fn_count as usize] = 1
                                        } else if (*rte).kind == TypeExprKind::TypeNamed {
                                            let rt_name = ast_name_from_path(&(*rte).path)
                                            let rt_si = ast_lookup_struct(&ctx, rt_name)
                                            if rt_si >= 0 {
                                                fn_return_types[fn_count as usize] = 10 + rt_si
                                            }
                                        } else if (*rte).kind == TypeExprKind::TypeTuple {
                                            let tsi = ast_ensure_tuple2(&ctx, &(*rte))
                                            if tsi >= 0 {
                                                fn_return_types[fn_count as usize] = 10 + tsi
                                            }
                                        }
                                    }
                                    _ => {}
                                }
                            }
                            _ => {}
                        }
                        let ns = str_from_bytes(itm.name.buf, itm.name.len)
                        if str_eq(ns, "main") { MAIN_FN_IDX = fn_count }
                        fn_count = fn_count + 1
                    }
                    // else: global var — already collected by scan_source_globals
                } else if itm.kind == ItemKind::ItemImpl {
                    // Collect methods from impl blocks
                    let impl_r: &Option<Box<ImplDef>> = &itm.impl_def
                    match *impl_r {
                        Some(idef) => {
                            let meth_ref: &Option<Box<ItemList>> = &(*idef).methods
                            var meth_cur = meth_ref
                            while true {
                                match *meth_cur {
                                    Some(ml) => {
                                        let mitm: &Item = &(*ml).head
                                        if mitm.kind == ItemKind::ItemFn {
                                            fn_names[fn_count as usize] = mitm.name
                                            let mfdef_r: &Option<Box<FnDef>> = &mitm.fn_def
                                            match *mfdef_r {
                                                Some(mfdr) => {
                                                    let mrt_ref: &Option<Box<TypeExpr>> = &(*mfdr).return_type
                                                    match *mrt_ref {
                                                        Some(mrte) => {
                                                            if ast_type_is_f64(&(*mrte)) {
                                                                fn_return_types[fn_count as usize] = 1
                                                            } else if (*mrte).kind == TypeExprKind::TypeNamed {
                                                                let mrt_name = ast_name_from_path(&(*mrte).path)
                                                                let mrt_si = ast_lookup_struct(&ctx, mrt_name)
                                                                if mrt_si >= 0 {
                                                                    fn_return_types[fn_count as usize] = 10 + mrt_si
                                                                }
                                                            } else if (*mrte).kind == TypeExprKind::TypeTuple {
                                                                let mtsi = ast_ensure_tuple2(&ctx, &(*mrte))
                                                                if mtsi >= 0 {
                                                                    fn_return_types[fn_count as usize] = 10 + mtsi
                                                                }
                                                            }
                                                        }
                                                        _ => {}
                                                    }
                                                }
                                                _ => {}
                                            }
                                            fn_count = fn_count + 1
                                        }
                                        meth_cur = &(*ml).tail
                                    }
                                    _ => break
                                }
                            }
                        }
                        _ => {}
                    }
                }
                item_cur = &(*il).tail
            }
            _ => break
        }
    }
    // Early check: if main not found, fail before builtin registration.
    if MAIN_FN_IDX < 0 {
        print("render_compile: no_main\n")
        return 4
    }
    // Register builtins BEFORE source functions (builtins shadow source defs with same name)
    var print_int_idx = fn_count
    var piname = ir_empty_name()
    piname.buf[0 as usize] = 112 as i8  // p
    piname.buf[1 as usize] = 114 as i8  // r
    piname.buf[2 as usize] = 105 as i8  // i
    piname.buf[3 as usize] = 110 as i8  // n
    piname.buf[4 as usize] = 116 as i8  // t
    piname.buf[5 as usize] = 95 as i8   // _
    piname.buf[6 as usize] = 105 as i8  // i
    piname.buf[7 as usize] = 110 as i8  // n
    piname.buf[8 as usize] = 116 as i8  // t
    piname.len = 9
    fn_names[fn_count as usize] = piname
    fn_return_types[fn_count as usize] = 0
    fn_count = fn_count + 1

    // print_f64(x: f64) builtin
    var print_f64_idx = fn_count
    var pfname = ir_empty_name()
    pfname.buf[0 as usize] = 112 as i8  // p
    pfname.buf[1 as usize] = 114 as i8  // r
    pfname.buf[2 as usize] = 105 as i8  // i
    pfname.buf[3 as usize] = 110 as i8  // n
    pfname.buf[4 as usize] = 116 as i8  // t
    pfname.buf[5 as usize] = 95 as i8   // _
    pfname.buf[6 as usize] = 102 as i8  // f
    pfname.buf[7 as usize] = 54 as i8   // 6
    pfname.buf[8 as usize] = 52 as i8   // 4
    pfname.len = 9
    fn_names[fn_count as usize] = pfname
    fn_return_types[fn_count as usize] = 0
    fn_count = fn_count + 1

    // "print" registered so ast_expr_is_float can find it, but calls are inlined
    var print_idx = fn_count
    var prname = ir_empty_name()
    prname.buf[0 as usize] = 112 as i8  // p
    prname.buf[1 as usize] = 114 as i8  // r
    prname.buf[2 as usize] = 105 as i8  // i
    prname.buf[3 as usize] = 110 as i8  // n
    prname.buf[4 as usize] = 116 as i8  // t
    prname.len = 5
    fn_names[fn_count as usize] = prname
    fn_return_types[fn_count as usize] = 0
    fn_count = fn_count + 1

    // Register runtime builtins: arg_count, get_arg, str_len, str_char_at, str_eq, file_size, read_file, write_file
    var arg_count_idx = fn_count
    var acname = ir_empty_name()
    acname.buf[0 as usize] = 97 as i8   // a
    acname.buf[1 as usize] = 114 as i8  // r
    acname.buf[2 as usize] = 103 as i8  // g
    acname.buf[3 as usize] = 95 as i8   // _
    acname.buf[4 as usize] = 99 as i8   // c
    acname.buf[5 as usize] = 111 as i8  // o
    acname.buf[6 as usize] = 117 as i8  // u
    acname.buf[7 as usize] = 110 as i8  // n
    acname.buf[8 as usize] = 116 as i8  // t
    acname.len = 9
    fn_names[fn_count as usize] = acname
    fn_return_types[fn_count as usize] = 0
    fn_count = fn_count + 1

    var get_arg_idx = fn_count
    var ganame = ir_empty_name()
    ganame.buf[0 as usize] = 103 as i8  // g
    ganame.buf[1 as usize] = 101 as i8  // e
    ganame.buf[2 as usize] = 116 as i8  // t
    ganame.buf[3 as usize] = 95 as i8   // _
    ganame.buf[4 as usize] = 97 as i8   // a
    ganame.buf[5 as usize] = 114 as i8  // r
    ganame.buf[6 as usize] = 103 as i8  // g
    ganame.len = 7
    fn_names[fn_count as usize] = ganame
    fn_return_types[fn_count as usize] = 0
    fn_count = fn_count + 1

    var str_len_idx = fn_count
    var slname = ir_empty_name()
    slname.buf[0 as usize] = 115 as i8  // s
    slname.buf[1 as usize] = 116 as i8  // t
    slname.buf[2 as usize] = 114 as i8  // r
    slname.buf[3 as usize] = 95 as i8   // _
    slname.buf[4 as usize] = 108 as i8  // l
    slname.buf[5 as usize] = 101 as i8  // e
    slname.buf[6 as usize] = 110 as i8  // n
    slname.len = 7
    fn_names[fn_count as usize] = slname
    fn_return_types[fn_count as usize] = 0
    fn_count = fn_count + 1

    var str_char_at_idx = fn_count
    var scaname = ir_empty_name()
    scaname.buf[0 as usize] = 115 as i8  // s
    scaname.buf[1 as usize] = 116 as i8  // t
    scaname.buf[2 as usize] = 114 as i8  // r
    scaname.buf[3 as usize] = 95 as i8   // _
    scaname.buf[4 as usize] = 99 as i8   // c
    scaname.buf[5 as usize] = 104 as i8  // h
    scaname.buf[6 as usize] = 97 as i8   // a
    scaname.buf[7 as usize] = 114 as i8  // r
    scaname.buf[8 as usize] = 95 as i8   // _
    scaname.buf[9 as usize] = 97 as i8   // a
    scaname.buf[10 as usize] = 116 as i8 // t
    scaname.len = 11
    fn_names[fn_count as usize] = scaname
    fn_return_types[fn_count as usize] = 0
    fn_count = fn_count + 1

    var str_eq_idx = fn_count
    var sename = ir_empty_name()
    sename.buf[0 as usize] = 115 as i8  // s
    sename.buf[1 as usize] = 116 as i8  // t
    sename.buf[2 as usize] = 114 as i8  // r
    sename.buf[3 as usize] = 95 as i8   // _
    sename.buf[4 as usize] = 101 as i8  // e
    sename.buf[5 as usize] = 113 as i8  // q
    sename.len = 6
    fn_names[fn_count as usize] = sename
    fn_return_types[fn_count as usize] = 0
    fn_count = fn_count + 1

    var file_size_idx = fn_count
    var fsname = ir_empty_name()
    fsname.buf[0 as usize] = 102 as i8  // f
    fsname.buf[1 as usize] = 105 as i8  // i
    fsname.buf[2 as usize] = 108 as i8  // l
    fsname.buf[3 as usize] = 101 as i8  // e
    fsname.buf[4 as usize] = 95 as i8   // _
    fsname.buf[5 as usize] = 115 as i8  // s
    fsname.buf[6 as usize] = 105 as i8  // i
    fsname.buf[7 as usize] = 122 as i8  // z
    fsname.buf[8 as usize] = 101 as i8  // e
    fsname.len = 9
    fn_names[fn_count as usize] = fsname
    fn_return_types[fn_count as usize] = 0
    fn_count = fn_count + 1

    var read_file_idx = fn_count
    var rfname = ir_empty_name()
    rfname.buf[0 as usize] = 114 as i8  // r
    rfname.buf[1 as usize] = 101 as i8  // e
    rfname.buf[2 as usize] = 97 as i8   // a
    rfname.buf[3 as usize] = 100 as i8  // d
    rfname.buf[4 as usize] = 95 as i8   // _
    rfname.buf[5 as usize] = 102 as i8  // f
    rfname.buf[6 as usize] = 105 as i8  // i
    rfname.buf[7 as usize] = 108 as i8  // l
    rfname.buf[8 as usize] = 101 as i8  // e
    rfname.len = 9
    fn_names[fn_count as usize] = rfname
    fn_return_types[fn_count as usize] = 0
    fn_count = fn_count + 1

    var write_file_idx = fn_count
    var wfname = ir_empty_name()
    wfname.buf[0 as usize] = 119 as i8  // w
    wfname.buf[1 as usize] = 114 as i8  // r
    wfname.buf[2 as usize] = 105 as i8  // i
    wfname.buf[3 as usize] = 116 as i8  // t
    wfname.buf[4 as usize] = 101 as i8  // e
    wfname.buf[5 as usize] = 95 as i8   // _
    wfname.buf[6 as usize] = 102 as i8  // f
    wfname.buf[7 as usize] = 105 as i8  // i
    wfname.buf[8 as usize] = 108 as i8  // l
    wfname.buf[9 as usize] = 101 as i8  // e
    wfname.len = 10
    fn_names[fn_count as usize] = wfname
    fn_return_types[fn_count as usize] = 0
    fn_count = fn_count + 1

    // load_source(path) — reads file into native buffer, returns size
    var load_source_idx = fn_count
    var lsname = ir_empty_name()
    lsname.buf[0 as usize] = 108 as i8  // l
    lsname.buf[1 as usize] = 111 as i8  // o
    lsname.buf[2 as usize] = 97 as i8   // a
    lsname.buf[3 as usize] = 100 as i8  // d
    lsname.buf[4 as usize] = 95 as i8   // _
    lsname.buf[5 as usize] = 115 as i8  // s
    lsname.buf[6 as usize] = 111 as i8  // o
    lsname.buf[7 as usize] = 117 as i8  // u
    lsname.buf[8 as usize] = 114 as i8  // r
    lsname.buf[9 as usize] = 99 as i8   // c
    lsname.buf[10 as usize] = 101 as i8 // e
    lsname.len = 11
    fn_names[fn_count as usize] = lsname
    fn_return_types[fn_count as usize] = 0
    fn_count = fn_count + 1

    // source_byte(idx) — reads byte from native buffer at idx
    var source_byte_idx = fn_count
    var sbname = ir_empty_name()
    sbname.buf[0 as usize] = 115 as i8  // s
    sbname.buf[1 as usize] = 111 as i8  // o
    sbname.buf[2 as usize] = 117 as i8  // u
    sbname.buf[3 as usize] = 114 as i8  // r
    sbname.buf[4 as usize] = 99 as i8   // c
    sbname.buf[5 as usize] = 101 as i8  // e
    sbname.buf[6 as usize] = 95 as i8   // _
    sbname.buf[7 as usize] = 98 as i8   // b
    sbname.buf[8 as usize] = 121 as i8  // y
    sbname.buf[9 as usize] = 116 as i8  // t
    sbname.buf[10 as usize] = 101 as i8 // e
    sbname.len = 11
    fn_names[fn_count as usize] = sbname
    fn_return_types[fn_count as usize] = 0
    fn_count = fn_count + 1

    // find_eigenform(op_addr, initial, tolerance, max_iter) → f64
    // Banach fixed-point iteration for cybernetic eigenform computation
    var find_eigenform_idx = fn_count
    var fename = ir_empty_name()
    fename.buf[0 as usize] = 102 as i8   // f
    fename.buf[1 as usize] = 105 as i8   // i
    fename.buf[2 as usize] = 110 as i8   // n
    fename.buf[3 as usize] = 100 as i8   // d
    fename.buf[4 as usize] = 95 as i8    // _
    fename.buf[5 as usize] = 101 as i8   // e
    fename.buf[6 as usize] = 105 as i8   // i
    fename.buf[7 as usize] = 103 as i8   // g
    fename.buf[8 as usize] = 101 as i8   // e
    fename.buf[9 as usize] = 110 as i8   // n
    fename.buf[10 as usize] = 102 as i8  // f
    fename.buf[11 as usize] = 111 as i8  // o
    fename.buf[12 as usize] = 114 as i8  // r
    fename.buf[13 as usize] = 109 as i8  // m
    fename.len = 14
    fn_names[fn_count as usize] = fename
    fn_return_types[fn_count as usize] = 1  // returns f64
    fn_count = fn_count + 1

    // Populate ctx with function info
    var cfi: i64 = 0
    while cfi < fn_count {
        ctx.fn_names[cfi as usize] = fn_names[cfi as usize]
        ctx.fn_return_types[cfi as usize] = fn_return_types[cfi as usize]
        cfi = cfi + 1
    }
    ctx.fn_count = fn_count

    print("render_compile: fn_count=")
    print_int(fn_count)
    print(" (incl builtins)\n")

    // Second pass: emit builtins + compile source functions
    var code = code_buffer_new()
    code = lctx_set_level(code, -1)  // No loop active
    var fn_offsets: [i64; 512] = [-1; 512]
    var call_patches: [i64; 512] = [0; 512]  // code offset of each call rel32
    var call_targets: [i64; 512] = [0; 512]  // target fn index for each call
    var call_patch_count: i64 = 0

    // Emit print_int builtin
    fn_offsets[print_int_idx as usize] = WIDE_LEN
    code = ast_emit_print_int_builtin(code)
    wide_flush(code)
    print("render_compile: builtin=print_int off=")
    print_int(fn_offsets[print_int_idx as usize])
    print(" sz=")
    print_int(WIDE_LEN - fn_offsets[print_int_idx as usize])
    print("\n")

    // Emit print_f64 builtin
    fn_offsets[print_f64_idx as usize] = WIDE_LEN
    code = ast_emit_print_f64_builtin(code)
    wide_flush(code)
    print("render_compile: builtin=print_f64 off=")
    print_int(fn_offsets[print_f64_idx as usize])
    print(" sz=")
    print_int(WIDE_LEN - fn_offsets[print_f64_idx as usize])
    print("\n")

    // print() is handled inline at call sites — emit a no-op stub
    fn_offsets[print_idx as usize] = WIDE_LEN
    code = code_buffer_new()
    // Minimal stub: ret (in case it's called without string literal arg)
    code = emit_byte(code, 0xc3)
    wide_flush(code)

    // Emit saved_rsp storage (8 bytes of zero, will be written by trampoline)
    let saved_rsp_off = WIDE_LEN
    code = code_buffer_new()
    code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    wide_flush(code)

    // Emit source_buf_ptr storage (8 bytes, stores mmap'd file buffer pointer)
    let source_buf_off = WIDE_LEN
    code = code_buffer_new()
    code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    wide_flush(code)

    // Emit global_base_ptr storage (8 bytes, stores mmap'd global region pointer)
    let global_base_off = WIDE_LEN
    code = code_buffer_new()
    code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    wide_flush(code)

    // Compute absolute addresses
    let base_addr_c: i64 = 4194304   // 0x400000
    let text_off_c: i64 = 4096
    let saved_rsp_abs = base_addr_c + text_off_c + saved_rsp_off
    let source_buf_abs = base_addr_c + text_off_c + source_buf_off
    GLOBAL_BASE_ABS = base_addr_c + text_off_c + global_base_off
    print("render_compile: global_base_abs=")
    print_int(GLOBAL_BASE_ABS)
    print("\n")

    // Emit arg_count() builtin
    // push rbp; mov rbp,rsp; mov rax,imm64(saved_rsp_abs); mov rax,[rax]; mov rax,[rax]; pop rbp; ret
    fn_offsets[arg_count_idx as usize] = WIDE_LEN
    code = code_buffer_new()
    code = emit_byte(code, 0x55)                                      // push rbp
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0xe5)  // mov rbp,rsp
    // mov rax, imm64 (saved_rsp_abs) — 48 B8 <8 bytes LE>
    code = emit_byte(code, 0x48); code = emit_byte(code, 0xB8)
    code = emit_byte(code, saved_rsp_abs & 0xFF)
    code = emit_byte(code, (saved_rsp_abs >> 8) & 0xFF)
    code = emit_byte(code, (saved_rsp_abs >> 16) & 0xFF)
    code = emit_byte(code, (saved_rsp_abs >> 24) & 0xFF)
    code = emit_byte(code, (saved_rsp_abs >> 32) & 0xFF)
    code = emit_byte(code, (saved_rsp_abs >> 40) & 0xFF)
    code = emit_byte(code, (saved_rsp_abs >> 48) & 0xFF)
    code = emit_byte(code, (saved_rsp_abs >> 56) & 0xFF)
    // mov rax, [rax] — load saved rsp value
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x8b); code = emit_byte(code, 0x00)
    // mov rax, [rax] — load argc from [rsp]
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x8b); code = emit_byte(code, 0x00)
    // dec rax — subtract 1 to exclude program name (match JIT behavior)
    code = emit_byte(code, 0x48); code = emit_byte(code, 0xff); code = emit_byte(code, 0xc8)
    code = emit_byte(code, 0x5d)  // pop rbp
    code = emit_byte(code, 0xc3)  // ret
    wide_flush(code)
    print("render_compile: builtin=arg_count off=")
    print_int(fn_offsets[arg_count_idx as usize])
    print("\n")

    // Emit get_arg(n) builtin — rdi=n, returns argv[n]
    // push rbp; mov rbp,rsp; mov rax,imm64(saved_rsp_abs); mov rax,[rax]
    // lea rax,[rax+rdi*8+8]; mov rax,[rax]; pop rbp; ret
    fn_offsets[get_arg_idx as usize] = WIDE_LEN
    code = code_buffer_new()
    code = emit_byte(code, 0x55)
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0xe5)
    // mov rax, imm64 (saved_rsp_abs)
    code = emit_byte(code, 0x48); code = emit_byte(code, 0xB8)
    code = emit_byte(code, saved_rsp_abs & 0xFF)
    code = emit_byte(code, (saved_rsp_abs >> 8) & 0xFF)
    code = emit_byte(code, (saved_rsp_abs >> 16) & 0xFF)
    code = emit_byte(code, (saved_rsp_abs >> 24) & 0xFF)
    code = emit_byte(code, (saved_rsp_abs >> 32) & 0xFF)
    code = emit_byte(code, (saved_rsp_abs >> 40) & 0xFF)
    code = emit_byte(code, (saved_rsp_abs >> 48) & 0xFF)
    code = emit_byte(code, (saved_rsp_abs >> 56) & 0xFF)
    // mov rax, [rax] — load saved rsp
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x8b); code = emit_byte(code, 0x00)
    // lea rax, [rax + rdi*8 + 16] — 48 8D 44 F8 10 (skip argc + argv[0])
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x8d)
    code = emit_byte(code, 0x44); code = emit_byte(code, 0xf8); code = emit_byte(code, 0x10)
    // mov rax, [rax] — load argv[n]
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x8b); code = emit_byte(code, 0x00)
    code = emit_byte(code, 0x5d)  // pop rbp
    code = emit_byte(code, 0xc3)  // ret
    wide_flush(code)
    print("render_compile: builtin=get_arg off=")
    print_int(fn_offsets[get_arg_idx as usize])
    print("\n")

    // Emit str_len(s) builtin — rdi=s, returns length
    // push rbp; mov rbp,rsp; xor rax,rax; movzx ecx,byte[rdi+rax]; test cl,cl; jz done; inc rax; jmp loop; done: pop rbp; ret
    fn_offsets[str_len_idx as usize] = WIDE_LEN
    code = code_buffer_new()
    code = emit_byte(code, 0x55)
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0xe5)
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x31); code = emit_byte(code, 0xc0)  // xor rax,rax
    // loop: movzx ecx, byte [rdi+rax] — 0F B6 0C 07
    code = emit_byte(code, 0x0f); code = emit_byte(code, 0xb6); code = emit_byte(code, 0x0c); code = emit_byte(code, 0x07)
    // test cl, cl — 84 C9
    code = emit_byte(code, 0x84); code = emit_byte(code, 0xc9)
    // jz +5 (skip inc rax + jmp -> pop rbp) — 74 05
    code = emit_byte(code, 0x74); code = emit_byte(code, 0x05)
    // inc rax — 48 FF C0
    code = emit_byte(code, 0x48); code = emit_byte(code, 0xff); code = emit_byte(code, 0xc0)
    // jmp -13 (back to movzx at offset 7) — EB F3
    code = emit_byte(code, 0xeb); code = emit_byte(code, 0xf3)
    code = emit_byte(code, 0x5d)  // pop rbp
    code = emit_byte(code, 0xc3)  // ret
    wide_flush(code)
    print("render_compile: builtin=str_len off=")
    print_int(fn_offsets[str_len_idx as usize])
    print("\n")

    // Emit str_char_at(s, i) builtin — rdi=s, rsi=i, returns byte at s[i]
    // push rbp; mov rbp,rsp; movzx eax,byte[rdi+rsi]; pop rbp; ret
    fn_offsets[str_char_at_idx as usize] = WIDE_LEN
    code = code_buffer_new()
    code = emit_byte(code, 0x55)
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0xe5)
    // movzx eax, byte [rdi+rsi] — 0F B6 04 37
    code = emit_byte(code, 0x0f); code = emit_byte(code, 0xb6); code = emit_byte(code, 0x04); code = emit_byte(code, 0x37)
    code = emit_byte(code, 0x5d)  // pop rbp
    code = emit_byte(code, 0xc3)  // ret
    wide_flush(code)
    print("render_compile: builtin=str_char_at off=")
    print_int(fn_offsets[str_char_at_idx as usize])
    print("\n")

    // Emit str_eq(s1, s2) builtin — rdi=s1, rsi=s2, returns 1 if equal, 0 if not
    // push rbp; mov rbp,rsp
    // loop: movzx eax,byte[rdi]; movzx ecx,byte[rsi]; cmp al,cl; jne .ne
    //   test al,al; jz .eq; inc rdi; inc rsi; jmp loop
    // .eq: mov eax,1; pop rbp; ret
    // .ne: xor eax,eax; pop rbp; ret
    fn_offsets[str_eq_idx as usize] = WIDE_LEN
    code = code_buffer_new()
    code = emit_byte(code, 0x55)
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0xe5)
    // loop (offset 4):
    // movzx eax, byte [rdi] — 0F B6 07
    code = emit_byte(code, 0x0f); code = emit_byte(code, 0xb6); code = emit_byte(code, 0x07)
    // movzx ecx, byte [rsi] — 0F B6 0E
    code = emit_byte(code, 0x0f); code = emit_byte(code, 0xb6); code = emit_byte(code, 0x0e)
    // cmp al, cl — 38 C8
    code = emit_byte(code, 0x38); code = emit_byte(code, 0xc8)
    // jne +19 (.ne at offset 33) — 75 13
    code = emit_byte(code, 0x75); code = emit_byte(code, 0x13)
    // test al, al — 84 C0
    code = emit_byte(code, 0x84); code = emit_byte(code, 0xc0)
    // jz +8 (.eq at offset 26) — 74 08
    code = emit_byte(code, 0x74); code = emit_byte(code, 0x08)
    // inc rdi — 48 FF C7
    code = emit_byte(code, 0x48); code = emit_byte(code, 0xff); code = emit_byte(code, 0xc7)
    // inc rsi — 48 FF C6
    code = emit_byte(code, 0x48); code = emit_byte(code, 0xff); code = emit_byte(code, 0xc6)
    // jmp loop — EB EA (back 22 bytes to offset 4)
    code = emit_byte(code, 0xeb); code = emit_byte(code, 0xea)
    // .eq: mov eax, 1 — B8 01 00 00 00
    code = emit_byte(code, 0xb8); code = emit_byte(code, 0x01); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    // pop rbp; ret
    code = emit_byte(code, 0x5d); code = emit_byte(code, 0xc3)
    // .ne: xor eax, eax — 31 C0
    code = emit_byte(code, 0x31); code = emit_byte(code, 0xc0)
    // pop rbp; ret
    code = emit_byte(code, 0x5d); code = emit_byte(code, 0xc3)
    wide_flush(code)
    print("render_compile: builtin=str_eq off=")
    print_int(fn_offsets[str_eq_idx as usize])
    print("\n")

    // Emit file_size(path) builtin — rdi=path, returns file size
    // Uses sys_open, sys_fstat, sys_close
    fn_offsets[file_size_idx as usize] = WIDE_LEN
    code = code_buffer_new()
    code = emit_byte(code, 0x55)  // push rbp
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0xe5)  // mov rbp,rsp
    // sub rsp, 176 — 48 81 EC B0000000
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x81); code = emit_byte(code, 0xec)
    code = emit_byte(code, 0xb0); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    // mov [rbp-8], rdi — 48 89 7D F8
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0x7d); code = emit_byte(code, 0xf8)
    // sys_open: mov eax, 2
    code = emit_byte(code, 0xb8); code = emit_byte(code, 0x02); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    // xor esi, esi — 31 F6
    code = emit_byte(code, 0x31); code = emit_byte(code, 0xf6)
    // xor edx, edx — 31 D2
    code = emit_byte(code, 0x31); code = emit_byte(code, 0xd2)
    // syscall — 0F 05
    code = emit_byte(code, 0x0f); code = emit_byte(code, 0x05)
    // mov [rbp-16], rax — 48 89 45 F0
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0x45); code = emit_byte(code, 0xf0)
    // sys_fstat: mov rdi, rax — 48 89 C7
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0xc7)
    // lea rsi, [rbp-176] — 48 8D B5 50FFFFFF
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x8d); code = emit_byte(code, 0xb5)
    code = emit_byte(code, 0x50); code = emit_byte(code, 0xff); code = emit_byte(code, 0xff); code = emit_byte(code, 0xff)
    // mov eax, 5 — B8 05000000
    code = emit_byte(code, 0xb8); code = emit_byte(code, 0x05); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    // syscall
    code = emit_byte(code, 0x0f); code = emit_byte(code, 0x05)
    // mov rax, [rbp-128] — st_size at offset 48 from stat buf: rbp-176+48 = rbp-128
    // 48 8B 85 80FFFFFF
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x8b); code = emit_byte(code, 0x85)
    code = emit_byte(code, 0x80); code = emit_byte(code, 0xff); code = emit_byte(code, 0xff); code = emit_byte(code, 0xff)
    // mov [rbp-24], rax — 48 89 45 E8
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0x45); code = emit_byte(code, 0xe8)
    // sys_close: mov rdi, [rbp-16] — 48 8B 7D F0
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x8b); code = emit_byte(code, 0x7d); code = emit_byte(code, 0xf0)
    // mov eax, 3 — B8 03000000
    code = emit_byte(code, 0xb8); code = emit_byte(code, 0x03); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    // syscall
    code = emit_byte(code, 0x0f); code = emit_byte(code, 0x05)
    // mov rax, [rbp-24] — 48 8B 45 E8
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x8b); code = emit_byte(code, 0x45); code = emit_byte(code, 0xe8)
    // leave; ret
    code = emit_byte(code, 0xc9); code = emit_byte(code, 0xc3)
    wide_flush(code)
    print("render_compile: builtin=file_size off=")
    print_int(fn_offsets[file_size_idx as usize])
    print("\n")

    // Emit read_file(path) builtin — rdi=path, returns pointer to mmap'd buffer
    // Uses sys_mmap, sys_open, sys_read, sys_close
    fn_offsets[read_file_idx as usize] = WIDE_LEN
    code = code_buffer_new()
    code = emit_byte(code, 0x55)  // push rbp
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0xe5)  // mov rbp,rsp
    // sub rsp, 32 — 48 83 EC 20
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x83); code = emit_byte(code, 0xec); code = emit_byte(code, 0x20)
    // mov [rbp-8], rdi — save path
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0x7d); code = emit_byte(code, 0xf8)
    // sys_mmap: xor edi, edi — 31 FF
    code = emit_byte(code, 0x31); code = emit_byte(code, 0xff)
    // mov esi, 1048576 — BE 00001000
    code = emit_byte(code, 0xbe); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00); code = emit_byte(code, 0x10); code = emit_byte(code, 0x00)
    // mov edx, 3 — BA 03000000
    code = emit_byte(code, 0xba); code = emit_byte(code, 0x03); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    // mov r10d, 0x22 — 41 BA 22000000
    code = emit_byte(code, 0x41); code = emit_byte(code, 0xba); code = emit_byte(code, 0x22); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    // mov r8d, -1 — 41 B8 FFFFFFFF
    code = emit_byte(code, 0x41); code = emit_byte(code, 0xb8); code = emit_byte(code, 0xff); code = emit_byte(code, 0xff); code = emit_byte(code, 0xff); code = emit_byte(code, 0xff)
    // xor r9d, r9d — 45 31 C9
    code = emit_byte(code, 0x45); code = emit_byte(code, 0x31); code = emit_byte(code, 0xc9)
    // mov eax, 9 — B8 09000000
    code = emit_byte(code, 0xb8); code = emit_byte(code, 0x09); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    // syscall
    code = emit_byte(code, 0x0f); code = emit_byte(code, 0x05)
    // mov [rbp-16], rax — save buf ptr
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0x45); code = emit_byte(code, 0xf0)
    // sys_open: mov rdi, [rbp-8] — 48 8B 7D F8
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x8b); code = emit_byte(code, 0x7d); code = emit_byte(code, 0xf8)
    // mov eax, 2
    code = emit_byte(code, 0xb8); code = emit_byte(code, 0x02); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    // xor esi, esi
    code = emit_byte(code, 0x31); code = emit_byte(code, 0xf6)
    // xor edx, edx
    code = emit_byte(code, 0x31); code = emit_byte(code, 0xd2)
    // syscall
    code = emit_byte(code, 0x0f); code = emit_byte(code, 0x05)
    // mov [rbp-24], rax — save fd
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0x45); code = emit_byte(code, 0xe8)
    // sys_read: mov rdi, rax — 48 89 C7
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0xc7)
    // mov rsi, [rbp-16] — 48 8B 75 F0
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x8b); code = emit_byte(code, 0x75); code = emit_byte(code, 0xf0)
    // mov edx, 1048576 — BA 00001000
    code = emit_byte(code, 0xba); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00); code = emit_byte(code, 0x10); code = emit_byte(code, 0x00)
    // xor eax, eax — 31 C0
    code = emit_byte(code, 0x31); code = emit_byte(code, 0xc0)
    // syscall
    code = emit_byte(code, 0x0f); code = emit_byte(code, 0x05)
    // sys_close: mov rdi, [rbp-24] — 48 8B 7D E8
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x8b); code = emit_byte(code, 0x7d); code = emit_byte(code, 0xe8)
    // mov eax, 3
    code = emit_byte(code, 0xb8); code = emit_byte(code, 0x03); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    // syscall
    code = emit_byte(code, 0x0f); code = emit_byte(code, 0x05)
    // mov rax, [rbp-16] — return buf ptr
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x8b); code = emit_byte(code, 0x45); code = emit_byte(code, 0xf0)
    // leave; ret
    code = emit_byte(code, 0xc9); code = emit_byte(code, 0xc3)
    wide_flush(code)
    print("render_compile: builtin=read_file off=")
    print_int(fn_offsets[read_file_idx as usize])
    print("\n")

    // Emit write_file(path, data, len) builtin — rdi=path, rsi=data, rdx=len, returns 0
    // Uses sys_open(O_WRONLY|O_CREAT|O_TRUNC), sys_write, sys_close
    fn_offsets[write_file_idx as usize] = WIDE_LEN
    code = code_buffer_new()
    code = emit_byte(code, 0x55)  // push rbp
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0xe5)  // mov rbp,rsp
    // sub rsp, 32
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x83); code = emit_byte(code, 0xec); code = emit_byte(code, 0x20)
    // mov [rbp-8], rsi — save data
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0x75); code = emit_byte(code, 0xf8)
    // mov [rbp-16], rdx — save len
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0x55); code = emit_byte(code, 0xf0)
    // sys_open: mov eax, 2
    code = emit_byte(code, 0xb8); code = emit_byte(code, 0x02); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    // mov esi, 0x241 — O_WRONLY|O_CREAT|O_TRUNC
    code = emit_byte(code, 0xbe); code = emit_byte(code, 0x41); code = emit_byte(code, 0x02); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    // mov edx, 0x1A4 — 0644 octal
    code = emit_byte(code, 0xba); code = emit_byte(code, 0xa4); code = emit_byte(code, 0x01); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    // syscall
    code = emit_byte(code, 0x0f); code = emit_byte(code, 0x05)
    // mov [rbp-24], rax — save fd
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0x45); code = emit_byte(code, 0xe8)
    // sys_write: mov rdi, rax
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0xc7)
    // mov rsi, [rbp-8]
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x8b); code = emit_byte(code, 0x75); code = emit_byte(code, 0xf8)
    // mov rdx, [rbp-16]
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x8b); code = emit_byte(code, 0x55); code = emit_byte(code, 0xf0)
    // mov eax, 1
    code = emit_byte(code, 0xb8); code = emit_byte(code, 0x01); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    // syscall
    code = emit_byte(code, 0x0f); code = emit_byte(code, 0x05)
    // sys_close: mov rdi, [rbp-24]
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x8b); code = emit_byte(code, 0x7d); code = emit_byte(code, 0xe8)
    // mov eax, 3
    code = emit_byte(code, 0xb8); code = emit_byte(code, 0x03); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    // syscall
    code = emit_byte(code, 0x0f); code = emit_byte(code, 0x05)
    // xor eax, eax — return 0
    code = emit_byte(code, 0x31); code = emit_byte(code, 0xc0)
    // leave; ret
    code = emit_byte(code, 0xc9); code = emit_byte(code, 0xc3)
    wide_flush(code)
    print("render_compile: builtin=write_file off=")
    print_int(fn_offsets[write_file_idx as usize])
    print("\n")

    // Emit load_source(path) builtin — mmap 1MB, open+read file, store ptr in source_buf, return size
    fn_offsets[load_source_idx as usize] = WIDE_LEN
    code = code_buffer_new()
    code = emit_byte(code, 0x55)  // push rbp
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0xe5)  // mov rbp, rsp
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x83); code = emit_byte(code, 0xec); code = emit_byte(code, 0x30) // sub rsp, 48
    // save path at [rbp-8]
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0x7d); code = emit_byte(code, 0xf8)
    // sys_mmap(NULL, 1048576, PROT_RW, MAP_PRIVATE|MAP_ANON, -1, 0)
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x31); code = emit_byte(code, 0xff) // xor rdi,rdi
    code = emit_byte(code, 0xbe); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    code = emit_byte(code, 0x10); code = emit_byte(code, 0x00)  // mov esi, 1048576
    code = emit_byte(code, 0xba); code = emit_byte(code, 0x03); code = emit_byte(code, 0x00)
    code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)  // mov edx, 3
    code = emit_byte(code, 0x41); code = emit_byte(code, 0xba); code = emit_byte(code, 0x22)
    code = emit_byte(code, 0x00); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00) // mov r10d, 0x22
    code = emit_byte(code, 0x49); code = emit_byte(code, 0xc7); code = emit_byte(code, 0xc0)
    code = emit_byte(code, 0xff); code = emit_byte(code, 0xff); code = emit_byte(code, 0xff); code = emit_byte(code, 0xff) // mov r8, -1
    code = emit_byte(code, 0x4d); code = emit_byte(code, 0x31); code = emit_byte(code, 0xc9) // xor r9,r9
    code = emit_byte(code, 0xb8); code = emit_byte(code, 0x09); code = emit_byte(code, 0x00)
    code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)  // mov eax, 9 (sys_mmap)
    code = emit_byte(code, 0x0f); code = emit_byte(code, 0x05) // syscall
    // save buf ptr at [rbp-16]
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0x45); code = emit_byte(code, 0xf0)
    // store buf ptr to source_buf global: mov rcx, imm64(source_buf_abs); mov [rcx], rax
    code = emit_byte(code, 0x48); code = emit_byte(code, 0xb9) // mov rcx, imm64
    code = emit_byte(code, source_buf_abs & 0xFF)
    code = emit_byte(code, (source_buf_abs >> 8) & 0xFF)
    code = emit_byte(code, (source_buf_abs >> 16) & 0xFF)
    code = emit_byte(code, (source_buf_abs >> 24) & 0xFF)
    code = emit_byte(code, (source_buf_abs >> 32) & 0xFF)
    code = emit_byte(code, (source_buf_abs >> 40) & 0xFF)
    code = emit_byte(code, (source_buf_abs >> 48) & 0xFF)
    code = emit_byte(code, (source_buf_abs >> 56) & 0xFF)
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0x01) // mov [rcx], rax
    // sys_open(path, O_RDONLY, 0)
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x8b); code = emit_byte(code, 0x7d); code = emit_byte(code, 0xf8) // mov rdi, [rbp-8]
    code = emit_byte(code, 0xb8); code = emit_byte(code, 0x02); code = emit_byte(code, 0x00)
    code = emit_byte(code, 0x00); code = emit_byte(code, 0x00) // mov eax, 2
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x31); code = emit_byte(code, 0xf6) // xor rsi, rsi
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x31); code = emit_byte(code, 0xd2) // xor rdx, rdx
    code = emit_byte(code, 0x0f); code = emit_byte(code, 0x05) // syscall
    // save fd at [rbp-24]
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0x45); code = emit_byte(code, 0xe8)
    // sys_read(fd, buf, 1048576)
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0xc7) // mov rdi, rax (fd)
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x8b); code = emit_byte(code, 0x75); code = emit_byte(code, 0xf0) // mov rsi, [rbp-16] (buf)
    code = emit_byte(code, 0xba); code = emit_byte(code, 0x00); code = emit_byte(code, 0x00)
    code = emit_byte(code, 0x10); code = emit_byte(code, 0x00) // mov edx, 1048576
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x31); code = emit_byte(code, 0xc0) // xor rax, rax (sys_read=0)
    code = emit_byte(code, 0x0f); code = emit_byte(code, 0x05) // syscall
    // save bytes_read at [rbp-32]
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0x45); code = emit_byte(code, 0xe0)
    // sys_close(fd)
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x8b); code = emit_byte(code, 0x7d); code = emit_byte(code, 0xe8) // mov rdi, [rbp-24]
    code = emit_byte(code, 0xb8); code = emit_byte(code, 0x03); code = emit_byte(code, 0x00)
    code = emit_byte(code, 0x00); code = emit_byte(code, 0x00) // mov eax, 3
    code = emit_byte(code, 0x0f); code = emit_byte(code, 0x05) // syscall
    // return bytes_read
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x8b); code = emit_byte(code, 0x45); code = emit_byte(code, 0xe0)
    code = emit_byte(code, 0xc9); code = emit_byte(code, 0xc3) // leave; ret
    wide_flush(code)
    print("render_compile: builtin=load_source off=")
    print_int(fn_offsets[load_source_idx as usize])
    print("\n")

    // Emit source_byte(idx) builtin — load byte from source_buf[idx]
    fn_offsets[source_byte_idx as usize] = WIDE_LEN
    code = code_buffer_new()
    code = emit_byte(code, 0x55)  // push rbp
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0xe5) // mov rbp,rsp
    // mov rax, imm64(source_buf_abs)
    code = emit_byte(code, 0x48); code = emit_byte(code, 0xb8)
    code = emit_byte(code, source_buf_abs & 0xFF)
    code = emit_byte(code, (source_buf_abs >> 8) & 0xFF)
    code = emit_byte(code, (source_buf_abs >> 16) & 0xFF)
    code = emit_byte(code, (source_buf_abs >> 24) & 0xFF)
    code = emit_byte(code, (source_buf_abs >> 32) & 0xFF)
    code = emit_byte(code, (source_buf_abs >> 40) & 0xFF)
    code = emit_byte(code, (source_buf_abs >> 48) & 0xFF)
    code = emit_byte(code, (source_buf_abs >> 56) & 0xFF)
    // mov rax, [rax] — load buf pointer
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x8b); code = emit_byte(code, 0x00)
    // movzx eax, byte [rax+rdi] — 0F B6 04 38
    code = emit_byte(code, 0x0f); code = emit_byte(code, 0xb6); code = emit_byte(code, 0x04); code = emit_byte(code, 0x38)
    code = emit_byte(code, 0x5d)  // pop rbp
    code = emit_byte(code, 0xc3)  // ret
    wide_flush(code)
    print("render_compile: builtin=source_byte off=")
    print_int(fn_offsets[source_byte_idx as usize])
    print("\n")

    // Emit find_eigenform builtin
    fn_offsets[find_eigenform_idx as usize] = WIDE_LEN
    code = code_buffer_new()
    code = ast_emit_find_eigenform_builtin(code)
    wide_flush(code)
    print("render_compile: builtin=find_eigenform off=")
    print_int(fn_offsets[find_eigenform_idx as usize])
    print(" sz=")
    print_int(WIDE_LEN - fn_offsets[find_eigenform_idx as usize])
    print("\n")

    item_cur = items_ref
    var fn_idx: i64 = 0
    while true {
        match *item_cur {
            Some(il) => {
                let itm: &Item = &(*il).head
                if itm.kind == ItemKind::ItemFn {
                    let fdef_ref: &Option<Box<FnDef>> = &itm.fn_def
                    var is_real_fn2 = false
                    match *fdef_ref {
                        Some(fd) => { is_real_fn2 = true }
                        _ => {}
                    }
                    if is_real_fn2 {
                        match *fdef_ref {
                            Some(fd) => {
                                let ns = str_from_bytes(itm.name.buf, itm.name.len)
                                print("render_compile: fn=")
                                print(ns)
                                let frame_size: i64 = 32768
                                code = code_buffer_new()
                                code = lctx_set_level(code, -1)
                                code = emit_byte(code, 0x55)
                                code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0xe5)
                                code = emit_byte(code, 0x48); code = emit_byte(code, 0x81); code = emit_byte(code, 0xec)
                                code = emit_byte(code, frame_size & 0xFF); code = emit_byte(code, (frame_size >> 8) & 0xFF)
                                code = emit_byte(code, (frame_size >> 16) & 0xFF); code = emit_byte(code, (frame_size >> 24) & 0xFF)
                                print(" pre="); print_int(code.len)
                                // Set per-function sret state in ctx before compiling body
                                let fn_rt2 = ctx.fn_return_types[fn_idx as usize]
                                if fn_rt2 >= 10 && fn_rt2 < 100 {
                                    ctx.cur_sret = 1
                                    ctx.cur_sret_flat_size = ctx.struct_flat_size[(fn_rt2 - 10) as usize]
                                    // cur_sret_dest_slot will be set inside ast_compile_fn_body
                                } else {
                                    ctx.cur_sret = 0
                                    ctx.cur_sret_flat_size = 0
                                }
                                code = ast_compile_fn_body(code, &(*fd), fn_count, &ctx)
                                code = emit_byte(code, 0xc9); code = emit_byte(code, 0xc3)
                                print(" post="); print_int(code.len)
                                // Record fn offset AFTER closure flushes (during body compile) but BEFORE fn body flush.
                                // Closures flushed during ast_compile_fn_body advance WIDE_LEN; fn's actual code follows.
                                fn_offsets[fn_idx as usize] = WIDE_LEN
                                let fn_start = fn_offsets[fn_idx as usize]
                                wide_flush(code)
                                let sz = WIDE_LEN - fn_start
                                print(" off="); print_int(fn_start)
                                print(" sz="); print_int(sz); print("\n")
                            }
                            _ => { fn_offsets[fn_idx as usize] = WIDE_LEN }
                        }
                        fn_idx = fn_idx + 1
                    }
                    // else: global var — skip
                } else if itm.kind == ItemKind::ItemImpl {
                    // Compile method bodies from impl blocks
                    let mci_r: &Option<Box<ImplDef>> = &itm.impl_def
                    match *mci_r {
                        Some(midef) => {
                            let mc_ref: &Option<Box<ItemList>> = &(*midef).methods
                            var mc_cur = mc_ref
                            while true {
                                match *mc_cur {
                                    Some(mcl) => {
                                        let mcitm: &Item = &(*mcl).head
                                        if mcitm.kind == ItemKind::ItemFn {
                                            let mcfd_r: &Option<Box<FnDef>> = &mcitm.fn_def
                                            match *mcfd_r {
                                                Some(mcfd) => {
                                                    let mcns = str_from_bytes(mcitm.name.buf, mcitm.name.len)
                                                    print("render_compile: method=")
                                                    print(mcns)
                                                    let mframe: i64 = 32768
                                                    code = code_buffer_new()
                                                    code = lctx_set_level(code, -1)
                                                    code = emit_byte(code, 0x55)
                                                    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0xe5)
                                                    code = emit_byte(code, 0x48); code = emit_byte(code, 0x81); code = emit_byte(code, 0xec)
                                                    code = emit_byte(code, mframe & 0xFF); code = emit_byte(code, (mframe >> 8) & 0xFF)
                                                    code = emit_byte(code, (mframe >> 16) & 0xFF); code = emit_byte(code, (mframe >> 24) & 0xFF)
                                                    // Set sret state for method
                                                    let mrt2 = ctx.fn_return_types[fn_idx as usize]
                                                    if mrt2 >= 10 && mrt2 < 100 {
                                                        ctx.cur_sret = 1
                                                        ctx.cur_sret_flat_size = ctx.struct_flat_size[(mrt2 - 10) as usize]
                                                    } else {
                                                        ctx.cur_sret = 0
                                                        ctx.cur_sret_flat_size = 0
                                                    }
                                                    code = ast_compile_fn_body(code, &(*mcfd), fn_count, &ctx)
                                                    code = emit_byte(code, 0xc9); code = emit_byte(code, 0xc3)
                                                    // Record offset after closure flushes, before method body flush
                                                    fn_offsets[fn_idx as usize] = WIDE_LEN
                                                    let mc_start = fn_offsets[fn_idx as usize]
                                                    wide_flush(code)
                                                    let mcsz = WIDE_LEN - mc_start
                                                    print(" off="); print_int(mc_start)
                                                    print(" sz="); print_int(mcsz); print("\n")
                                                }
                                                _ => { fn_offsets[fn_idx as usize] = WIDE_LEN }
                                            }
                                            fn_idx = fn_idx + 1
                                        }
                                        mc_cur = &(*mcl).tail
                                    }
                                    _ => break
                                }
                            }
                        }
                        _ => {}
                    }
                }
                item_cur = &(*il).tail
            }
            _ => break
        }
    }

    // Patch call instructions in WIDE_OUT
    // Scan for pattern: 0xe8 <fn_idx_lo> <fn_idx_hi> 0xCA 0xFE
    var pi: i64 = 0
    while pi < WIDE_LEN - 4 {
        if WIDE_OUT[pi as usize] == (0xe8 as i8) &&
           WIDE_OUT[(pi + 3) as usize] == (0xCA as i8) &&
           WIDE_OUT[(pi + 4) as usize] == (0xFE as i8) {
            let lo_byte = WIDE_OUT[(pi + 1) as usize] as i64
            let hi_byte = WIDE_OUT[(pi + 2) as usize] as i64
            let target_idx = (lo_byte & 0xFF) + ((hi_byte & 0xFF) << 8)
            if target_idx >= 0 && target_idx < fn_count {
                let target_off = fn_offsets[target_idx as usize]
                let call_site = pi
                let disp = target_off - (call_site + 5)
                WIDE_OUT[(pi + 1) as usize] = (disp & 0xFF) as i8
                WIDE_OUT[(pi + 2) as usize] = ((disp >> 8) & 0xFF) as i8
                WIDE_OUT[(pi + 3) as usize] = ((disp >> 16) & 0xFF) as i8
                WIDE_OUT[(pi + 4) as usize] = ((disp >> 24) & 0xFF) as i8
            }
        }
        pi = pi + 1
    }

    // Sprint 229: Patch LEA fn-ref sentinels in WIDE_OUT
    // Scan for pattern: 0x48 0x8D 0x05 <fn_idx_lo> <fn_idx_hi> 0xDA 0xBE
    var li: i64 = 0
    while li < WIDE_LEN - 6 {
        if WIDE_OUT[li as usize] == (0x48 as i8) &&
           WIDE_OUT[(li + 1) as usize] == (0x8D as i8) &&
           WIDE_OUT[(li + 2) as usize] == (0x05 as i8) &&
           WIDE_OUT[(li + 5) as usize] == (0xDA as i8) &&
           WIDE_OUT[(li + 6) as usize] == (0xBE as i8) {
            let lea_lo = WIDE_OUT[(li + 3) as usize] as i64
            let lea_hi = WIDE_OUT[(li + 4) as usize] as i64
            let lea_fn_idx = (lea_lo & 0xFF) + ((lea_hi & 0xFF) << 8)
            if lea_fn_idx >= 0 && lea_fn_idx < fn_count {
                let lea_target = fn_offsets[lea_fn_idx as usize]
                let lea_disp = lea_target - (li + 7)
                WIDE_OUT[(li + 3) as usize] = (lea_disp & 0xFF) as i8
                WIDE_OUT[(li + 4) as usize] = ((lea_disp >> 8) & 0xFF) as i8
                WIDE_OUT[(li + 5) as usize] = ((lea_disp >> 16) & 0xFF) as i8
                WIDE_OUT[(li + 6) as usize] = ((lea_disp >> 24) & 0xFF) as i8
            }
        }
        li = li + 1
    }

    // Sprint 234 Track A: Patch closure LEA sentinels
    // Pattern: 0x48 0x8D 0x05 <cidx_lo> <cidx_hi> 0xC1 0xBE
    var cpi: i64 = 0
    while cpi < WIDE_LEN - 6 {
        if WIDE_OUT[cpi as usize] == (0x48 as i8) &&
           WIDE_OUT[(cpi + 1) as usize] == (0x8D as i8) &&
           WIDE_OUT[(cpi + 2) as usize] == (0x05 as i8) &&
           WIDE_OUT[(cpi + 5) as usize] == (0xC1 as i8) &&
           WIDE_OUT[(cpi + 6) as usize] == (0xBE as i8) {
            let cl_lo = WIDE_OUT[(cpi + 3) as usize] as i64
            let cl_hi = WIDE_OUT[(cpi + 4) as usize] as i64
            let cl_idx2 = (cl_lo & 0xFF) | ((cl_hi & 0xFF) << 8)
            if cl_idx2 >= 0 && cl_idx2 < CLOSURE_COUNT {
                let cl_target = CLOSURE_OFFSETS[cl_idx2 as usize]
                let cl_disp = cl_target - (cpi + 7)
                WIDE_OUT[(cpi + 3) as usize] = (cl_disp & 0xFF) as i8
                WIDE_OUT[(cpi + 4) as usize] = ((cl_disp >> 8) & 0xFF) as i8
                WIDE_OUT[(cpi + 5) as usize] = ((cl_disp >> 16) & 0xFF) as i8
                WIDE_OUT[(cpi + 6) as usize] = ((cl_disp >> 24) & 0xFF) as i8
            }
        }
        cpi = cpi + 1
    }

    // Inline trampoline: save RSP to saved_rsp; call main; mov edi,eax; mov eax,60; syscall
    let tramp_off = WIDE_LEN
    code = code_buffer_new()
    // mov rax, imm64(saved_rsp_abs) — 48 B8 <8 bytes>
    code = emit_byte(code, 0x48); code = emit_byte(code, 0xB8)
    code = emit_byte(code, saved_rsp_abs & 0xFF)
    code = emit_byte(code, (saved_rsp_abs >> 8) & 0xFF)
    code = emit_byte(code, (saved_rsp_abs >> 16) & 0xFF)
    code = emit_byte(code, (saved_rsp_abs >> 24) & 0xFF)
    code = emit_byte(code, (saved_rsp_abs >> 32) & 0xFF)
    code = emit_byte(code, (saved_rsp_abs >> 40) & 0xFF)
    code = emit_byte(code, (saved_rsp_abs >> 48) & 0xFF)
    code = emit_byte(code, (saved_rsp_abs >> 56) & 0xFF)
    // mov [rax], rsp — 48 89 20
    code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0x20)
    // mmap global region if there are globals
    if GLOBAL_TOTAL_SIZE > 0 {
        // Ensure at least one page for mmap
        var mmap_size = GLOBAL_TOTAL_SIZE
        if mmap_size < 4096 { mmap_size = 4096 }
        // Round up to page boundary
        mmap_size = ((mmap_size + 4095) / 4096) * 4096
        code = ast_emit_mmap(code, mmap_size)
        // rax = mmap result (pointer to global region)
        // Store into global_base_ptr: mov rcx, imm64(global_base_abs); mov [rcx], rax
        code = emit_mov_rcx_imm64(code, GLOBAL_BASE_ABS)
        // mov [rcx], rax — 48 89 01
        code = emit_byte(code, 0x48); code = emit_byte(code, 0x89); code = emit_byte(code, 0x01)
    }
    // call main
    let cs = WIDE_LEN + code.len
    let moff = fn_offsets[MAIN_FN_IDX as usize]
    let cd = moff - (cs + 5)
    code = emit_byte(code, 0xe8)
    code = emit_byte(code, cd & 0xFF)
    code = emit_byte(code, (cd >> 8) & 0xFF)
    code = emit_byte(code, (cd >> 16) & 0xFF)
    code = emit_byte(code, (cd >> 24) & 0xFF)
    // mov edi, eax
    code = emit_byte(code, 0x89)
    code = emit_byte(code, 0xc7)
    // mov eax, 60
    code = emit_byte(code, 0xb8)
    code = emit_byte(code, 0x3c)
    code = emit_byte(code, 0x00)
    code = emit_byte(code, 0x00)
    code = emit_byte(code, 0x00)
    // syscall
    code = emit_byte(code, 0x0f)
    code = emit_byte(code, 0x05)
    wide_flush(code)

    let total_code = WIDE_LEN
    print("render_compile: total_code=")
    print_int(total_code)
    print(" tramp=")
    print_int(tramp_off)
    print("\n")

    // Inline ELF writer — use wide buffer for output
    let base_addr: i64 = 4194304
    let text_off: i64 = 4096
    let entry_va = base_addr + text_off + tramp_off

    // Use global ELF buffer (not stack-allocated) to support 16MB output
    var ei: i64 = 0
    while ei < 16777216 { GLOBAL_ELF[ei as usize] = 0; ei = ei + 1 }
    GLOBAL_ELF[0 as usize] = 0x7f as i8
    GLOBAL_ELF[1 as usize] = 69 as i8
    GLOBAL_ELF[2 as usize] = 76 as i8
    GLOBAL_ELF[3 as usize] = 70 as i8
    GLOBAL_ELF[4 as usize] = 2 as i8
    GLOBAL_ELF[5 as usize] = 1 as i8
    GLOBAL_ELF[6 as usize] = 1 as i8
    GLOBAL_ELF[16 as usize] = 2 as i8
    GLOBAL_ELF[18 as usize] = 0x3e as i8
    GLOBAL_ELF[20 as usize] = 1 as i8
    GLOBAL_ELF[24 as usize] = (entry_va & 0xFF) as i8
    GLOBAL_ELF[25 as usize] = ((entry_va >> 8) & 0xFF) as i8
    GLOBAL_ELF[26 as usize] = ((entry_va >> 16) & 0xFF) as i8
    GLOBAL_ELF[27 as usize] = ((entry_va >> 24) & 0xFF) as i8
    GLOBAL_ELF[28 as usize] = ((entry_va >> 32) & 0xFF) as i8
    GLOBAL_ELF[29 as usize] = ((entry_va >> 40) & 0xFF) as i8
    GLOBAL_ELF[30 as usize] = ((entry_va >> 48) & 0xFF) as i8
    GLOBAL_ELF[31 as usize] = ((entry_va >> 56) & 0xFF) as i8
    GLOBAL_ELF[32 as usize] = 64 as i8
    GLOBAL_ELF[52 as usize] = 64 as i8
    GLOBAL_ELF[54 as usize] = 56 as i8
    GLOBAL_ELF[56 as usize] = 2 as i8
    GLOBAL_ELF[58 as usize] = 64 as i8
    GLOBAL_ELF[64 as usize] = 1 as i8
    GLOBAL_ELF[68 as usize] = 7 as i8  // PF_R|PF_W|PF_X — needed for saved_rsp write
    GLOBAL_ELF[80 as usize] = (base_addr & 0xFF) as i8
    GLOBAL_ELF[81 as usize] = ((base_addr >> 8) & 0xFF) as i8
    GLOBAL_ELF[82 as usize] = ((base_addr >> 16) & 0xFF) as i8
    GLOBAL_ELF[83 as usize] = ((base_addr >> 24) & 0xFF) as i8
    GLOBAL_ELF[88 as usize] = (base_addr & 0xFF) as i8
    GLOBAL_ELF[89 as usize] = ((base_addr >> 8) & 0xFF) as i8
    GLOBAL_ELF[90 as usize] = ((base_addr >> 16) & 0xFF) as i8
    GLOBAL_ELF[91 as usize] = ((base_addr >> 24) & 0xFF) as i8
    let fsz = text_off + total_code
    GLOBAL_ELF[96 as usize] = (fsz & 0xFF) as i8
    GLOBAL_ELF[97 as usize] = ((fsz >> 8) & 0xFF) as i8
    GLOBAL_ELF[98 as usize] = ((fsz >> 16) & 0xFF) as i8
    GLOBAL_ELF[99 as usize] = ((fsz >> 24) & 0xFF) as i8
    GLOBAL_ELF[104 as usize] = (fsz & 0xFF) as i8
    GLOBAL_ELF[105 as usize] = ((fsz >> 8) & 0xFF) as i8
    GLOBAL_ELF[106 as usize] = ((fsz >> 16) & 0xFF) as i8
    GLOBAL_ELF[107 as usize] = ((fsz >> 24) & 0xFF) as i8
    GLOBAL_ELF[112 as usize] = 0 as i8
    GLOBAL_ELF[113 as usize] = 16 as i8
    GLOBAL_ELF[120 as usize] = 0x51 as i8
    GLOBAL_ELF[121 as usize] = 0xe5 as i8
    GLOBAL_ELF[122 as usize] = 0x74 as i8
    GLOBAL_ELF[123 as usize] = 0x64 as i8
    GLOBAL_ELF[124 as usize] = 6 as i8

    var ci: i64 = 0
    while ci < total_code && (text_off + ci) < 16777216 {
        GLOBAL_ELF[(text_off + ci) as usize] = WIDE_OUT[ci as usize]
        ci = ci + 1
    }

    let total_len = text_off + total_code
    let write_ok = write_file(output_path, GLOBAL_ELF, total_len)
    if write_ok == 0 {
        print("render_compile: write_error\n")
        return 5
    }

    print("render_compile: ok written=")
    print(output_path)
    print(" size=")
    print_int(total_len)
    print("\n")
    0
}
