        needs_runtime_guards: false,
        pre_native_guard_expansion_requested: false,
        pre_native_guard_plan_ready: false,
        native_lowering_ready: false,
        backend_guard_count: 0,
        first_obligation_found: false,
        first_obligation_site_kind: 0,
        first_obligation_type_name: empty_name(),
        first_obligation_field_name: empty_name(),
        first_obligation_constraint_kind: 0,
        first_obligation_value_kind: 0,
        first_obligation_int_value: 0,
        first_obligation_float_value: 0.0,
        first_obligation_scaled_value: 0,
        first_obligation_value_scale: 1,
        first_obligation_unit_name: empty_name(),
        first_obligation_dynamic_expr_kind: 0,
        first_backend_guard_row_ready: false,
        first_backend_guard_compare_opcode: 0,
        first_backend_guard_threshold_kind: 0,
        first_backend_guard_trap_exit_code: 0,
        second_obligation_found: false,
        second_obligation_site_kind: 0,
        second_obligation_type_name: empty_name(),
        second_obligation_field_name: empty_name(),
        second_obligation_constraint_kind: 0,
        second_obligation_value_kind: 0,
        second_obligation_int_value: 0,
        second_obligation_float_value: 0.0,
        second_obligation_scaled_value: 0,
        second_obligation_value_scale: 1,
        second_obligation_unit_name: empty_name(),
        second_obligation_dynamic_expr_kind: 0,
        second_backend_guard_row_ready: false,
        second_backend_guard_compare_opcode: 0,
        second_backend_guard_threshold_kind: 0,
        second_backend_guard_trap_exit_code: 0,
        staged_backend_guard_row_count: 0,
    }
}

