}

fn knowledge_runtime_guard_backend_row_from_obligation(row_index: i64, runtime_obligation_count: i64, obligation: KnowledgeRuntimeObligationDescriptor) -> KnowledgeRuntimeGuardBackendRow {
    var row = knowledge_runtime_guard_backend_row_empty(row_index)
    row.source_valid = true
    row.runtime_obligation_count = runtime_obligation_count
    row.in_bounds = row_index >= 0 && row_index < runtime_obligation_count
    row.obligation_found = obligation.found
    row.site_kind = obligation.site_kind
    row.type_name = obligation.type_name
    row.field_name = obligation.field_name
    row.constraint_kind = obligation.constraint_kind
    row.value_kind = obligation.value_kind
    row.int_value = obligation.int_value
    row.float_value = obligation.float_value
    row.scaled_value = obligation.scaled_value
    row.value_scale = obligation.value_scale
    row.unit_name = obligation.unit_name
    row.dynamic_expr_kind = obligation.dynamic_expr_kind
    if obligation.found {
        row.compare_opcode = knowledge_runtime_guard_compare_opcode_from_constraint_kind(obligation.constraint_kind)
        if obligation.unit_name.len > 0 {
            row.threshold_kind = knowledge_runtime_guard_backend_threshold_unit_ratio()
            row.float_value = 1.0
        } else {
            row.threshold_kind = knowledge_runtime_guard_threshold_kind_from_value_kind(obligation.value_kind)
        }
        row.trap_exit_code = 1
        row.native_cmp_code = knowledge_runtime_guard_native_cmp_code_from_backend_compare_opcode(row.compare_opcode)
        row.native_trap_builtin_id = knowledge_runtime_guard_native_trap_builtin_sys_exit_1()
        row.native_trap_on_false = true
        row.row_ready =
            row.compare_opcode != knowledge_runtime_guard_backend_compare_none() &&
            row.native_cmp_code != 0 &&
            row.threshold_kind != knowledge_runtime_guard_backend_threshold_none() &&
            row.native_trap_builtin_id == knowledge_runtime_guard_native_trap_builtin_sys_exit_1()
    }
    row
}

pub fn knowledge_runtime_guard_native_emission_plan_from_row(row: KnowledgeRuntimeGuardBackendRow) -> KnowledgeRuntimeGuardNativeEmissionPlan {
    var plan = knowledge_runtime_guard_native_emission_plan_empty(row.row_index)
    plan.source_valid = row.source_valid
    plan.in_bounds = row.in_bounds
    plan.runtime_obligation_count = row.runtime_obligation_count
    if !row.row_ready {
        return plan
    }
    plan.needs_value_register = true
    plan.threshold_kind = row.threshold_kind
    plan.threshold_int_value = row.scaled_value
    plan.threshold_float_value = row.float_value
    plan.threshold_scaled_value = row.scaled_value
    plan.threshold_scale = row.value_scale
    plan.native_cmp_code = row.native_cmp_code
    plan.native_trap_builtin_id = row.native_trap_builtin_id
    plan.native_trap_on_false = row.native_trap_on_false
    if row.threshold_kind == knowledge_runtime_guard_backend_threshold_unit_ratio() && row.scaled_value != 0 {
        plan.emit_load_threshold = true
        plan.emit_divide_value_by_threshold = true
        plan.emit_load_one = true
        plan.emit_compare_value_threshold = true
        plan.emit_load_zero = true
        plan.emit_eq_zero = true
        plan.emit_branch_false_to_ok = true
        plan.emit_trap_call = true
        plan.emit_ok_label = true
        plan.zero_cmp_code = knowledge_runtime_guard_native_cmp_eq_zero_code()
        plan.native_step_count = 9
    } else {
        plan.emit_load_threshold = true
        plan.emit_compare_value_threshold = true
        plan.emit_load_zero = true
        plan.emit_eq_zero = true
        plan.emit_branch_false_to_ok = true
        plan.emit_trap_call = true
        plan.emit_ok_label = true
        plan.zero_cmp_code = knowledge_runtime_guard_native_cmp_eq_zero_code()
        plan.native_step_count = 7
    }
    plan.plan_ready =
        plan.needs_value_register &&
        plan.threshold_kind != knowledge_runtime_guard_backend_threshold_none() &&
        plan.native_cmp_code != 0 &&
        plan.native_trap_builtin_id == knowledge_runtime_guard_native_trap_builtin_sys_exit_1() &&
        plan.native_trap_on_false &&
        plan.zero_cmp_code == knowledge_runtime_guard_native_cmp_eq_zero_code()
    plan
}

pub fn knowledge_runtime_guard_native_emission_step_from_plan(plan: KnowledgeRuntimeGuardNativeEmissionPlan, step_index: i64) -> KnowledgeRuntimeGuardNativeEmissionStep {
    var step = knowledge_runtime_guard_native_emission_step_empty(plan.row_index, step_index)
    step.plan_ready = plan.plan_ready
    step.source_valid = plan.source_valid
    step.in_bounds = plan.in_bounds
    step.total_step_count = plan.native_step_count
    if !plan.plan_ready || step_index < 0 || step_index >= plan.native_step_count {
        return step
    }

    step.step_ready = true
    step.threshold_kind = plan.threshold_kind
    step.threshold_int_value = plan.threshold_int_value
    step.threshold_float_value = plan.threshold_float_value
    step.threshold_scaled_value = plan.threshold_scaled_value
    step.threshold_scale = plan.threshold_scale
    step.native_cmp_code = plan.native_cmp_code
    step.native_trap_builtin_id = plan.native_trap_builtin_id
    step.label_role = knowledge_runtime_guard_native_step_label_ok()

    if plan.threshold_kind == knowledge_runtime_guard_backend_threshold_unit_ratio() && plan.threshold_scaled_value != 0 {
        if step_index == 0 {
            step.op_kind = knowledge_runtime_guard_native_step_op_load_threshold()
            step.dst_role = knowledge_runtime_guard_native_step_role_unit_threshold()
            return step
        }
        if step_index == 1 {
            step.op_kind = knowledge_runtime_guard_native_step_op_divide_value_by_threshold()
            step.dst_role = knowledge_runtime_guard_native_step_role_ratio()
            step.src1_role = knowledge_runtime_guard_native_step_role_dynamic_value()
            step.src2_role = knowledge_runtime_guard_native_step_role_unit_threshold()
            return step
        }
        if step_index == 2 {
            step.op_kind = knowledge_runtime_guard_native_step_op_load_one()
            step.dst_role = knowledge_runtime_guard_native_step_role_one()
            return step
        }
        if step_index == 3 {
            step.op_kind = knowledge_runtime_guard_native_step_op_compare_value_threshold()
            step.dst_role = knowledge_runtime_guard_native_step_role_compare_result()
            step.src1_role = knowledge_runtime_guard_native_step_role_ratio()
            step.src2_role = knowledge_runtime_guard_native_step_role_one()
            return step
        }
        if step_index == 4 {
            step.op_kind = knowledge_runtime_guard_native_step_op_load_zero()
            step.dst_role = knowledge_runtime_guard_native_step_role_zero()
            return step
        }
        if step_index == 5 {
            step.op_kind = knowledge_runtime_guard_native_step_op_eq_zero()
            step.dst_role = knowledge_runtime_guard_native_step_role_eq_zero()
            step.src1_role = knowledge_runtime_guard_native_step_role_compare_result()
            step.src2_role = knowledge_runtime_guard_native_step_role_zero()
            step.native_cmp_code = knowledge_runtime_guard_native_cmp_eq_zero_code()
            return step
        }
        if step_index == 6 {
            step.op_kind = knowledge_runtime_guard_native_step_op_branch_false_to_ok()
            step.src1_role = knowledge_runtime_guard_native_step_role_eq_zero()
            return step
        }
        if step_index == 7 {
            step.op_kind = knowledge_runtime_guard_native_step_op_trap_call()
            step.dst_role = knowledge_runtime_guard_native_step_role_trap_result()
            return step
        }
        if step_index == 8 {
            step.op_kind = knowledge_runtime_guard_native_step_op_ok_label()
            return step
        }
        return knowledge_runtime_guard_native_emission_step_empty(plan.row_index, step_index)
    }

    if step_index == 0 {
        step.op_kind = knowledge_runtime_guard_native_step_op_load_threshold()
        step.dst_role = knowledge_runtime_guard_native_step_role_threshold()
        return step
    }
    if step_index == 1 {
        step.op_kind = knowledge_runtime_guard_native_step_op_compare_value_threshold()
        step.dst_role = knowledge_runtime_guard_native_step_role_compare_result()
        step.src1_role = knowledge_runtime_guard_native_step_role_dynamic_value()
        step.src2_role = knowledge_runtime_guard_native_step_role_threshold()
        return step
    }
    if step_index == 2 {
        step.op_kind = knowledge_runtime_guard_native_step_op_load_zero()
        step.dst_role = knowledge_runtime_guard_native_step_role_zero()
        return step
    }
    if step_index == 3 {
        step.op_kind = knowledge_runtime_guard_native_step_op_eq_zero()
        step.dst_role = knowledge_runtime_guard_native_step_role_eq_zero()
        step.src1_role = knowledge_runtime_guard_native_step_role_compare_result()
        step.src2_role = knowledge_runtime_guard_native_step_role_zero()
        step.native_cmp_code = knowledge_runtime_guard_native_cmp_eq_zero_code()
        return step
    }
    if step_index == 4 {
        step.op_kind = knowledge_runtime_guard_native_step_op_branch_false_to_ok()
        step.src1_role = knowledge_runtime_guard_native_step_role_eq_zero()
        return step
    }
    if step_index == 5 {
        step.op_kind = knowledge_runtime_guard_native_step_op_trap_call()
        step.dst_role = knowledge_runtime_guard_native_step_role_trap_result()
        return step
    }
    if step_index == 6 {
        step.op_kind = knowledge_runtime_guard_native_step_op_ok_label()
        return step
    }

    knowledge_runtime_guard_native_emission_step_empty(plan.row_index, step_index)
}

pub fn knowledge_runtime_guard_lowering_plan_build(source_path: string) -> KnowledgeRuntimeGuardLoweringPlan with IO, Mut, Panic, Div, Alloc {
    let intent = knowledge_runtime_guard_directive_build_intent(source_path)
    var plan = knowledge_runtime_guard_lowering_plan_empty()
    plan.directive_found = intent.found
    plan.directive_count = intent.count
    plan.directive_malformed = intent.malformed
    plan.pre_native_guard_expansion_requested = intent.enable_pre_native_guard_expansion
    plan.native_lowering_ready = intent.native_lowering_ready

    if intent.malformed {
        return plan
    }

    let items = lex_file_parse_items(source_path)
    plan.parse_errors = parser_last_error_count()
    if plan.parse_errors > 0 {
        return plan
    }

    plan.semantic_verdict = knowledge_context_validate_items(items)
    if plan.semantic_verdict != 0 {
        return plan
    }

    plan.runtime_obligation_count = knowledge_context_count_runtime_obligations_items(items)
    let first_obligation = knowledge_context_first_runtime_obligation_items(items)
    plan.first_obligation_found = first_obligation.found
    plan.first_obligation_site_kind = first_obligation.site_kind
    plan.first_obligation_type_name = first_obligation.type_name
    plan.first_obligation_field_name = first_obligation.field_name
    plan.first_obligation_constraint_kind = first_obligation.constraint_kind
    plan.first_obligation_value_kind = first_obligation.value_kind
    plan.first_obligation_int_value = first_obligation.int_value
    plan.first_obligation_float_value = first_obligation.float_value
    plan.first_obligation_scaled_value = first_obligation.scaled_value
    plan.first_obligation_value_scale = first_obligation.value_scale
    plan.first_obligation_unit_name = first_obligation.unit_name
    plan.first_obligation_dynamic_expr_kind = first_obligation.dynamic_expr_kind
    if first_obligation.found {
        plan.first_backend_guard_compare_opcode = knowledge_runtime_guard_compare_opcode_from_constraint_kind(first_obligation.constraint_kind)
        if first_obligation.unit_name.len > 0 {
            plan.first_backend_guard_threshold_kind = knowledge_runtime_guard_backend_threshold_unit_ratio()
        } else {
            plan.first_backend_guard_threshold_kind = knowledge_runtime_guard_threshold_kind_from_value_kind(first_obligation.value_kind)
        }
        plan.first_backend_guard_trap_exit_code = 1
        plan.first_backend_guard_row_ready =
            plan.first_backend_guard_compare_opcode != knowledge_runtime_guard_backend_compare_none() &&
            plan.first_backend_guard_threshold_kind != knowledge_runtime_guard_backend_threshold_none()
        if plan.first_backend_guard_row_ready {
            plan.staged_backend_guard_row_count = plan.runtime_obligation_count
        }
    }
    let second_obligation = knowledge_context_nth_runtime_obligation_items(items, 1)
    plan.second_obligation_found = second_obligation.found
    plan.second_obligation_site_kind = second_obligation.site_kind
    plan.second_obligation_type_name = second_obligation.type_name
    plan.second_obligation_field_name = second_obligation.field_name
    plan.second_obligation_constraint_kind = second_obligation.constraint_kind
    plan.second_obligation_value_kind = second_obligation.value_kind
    plan.second_obligation_int_value = second_obligation.int_value
    plan.second_obligation_float_value = second_obligation.float_value
    plan.second_obligation_scaled_value = second_obligation.scaled_value
    plan.second_obligation_value_scale = second_obligation.value_scale
    plan.second_obligation_unit_name = second_obligation.unit_name
    plan.second_obligation_dynamic_expr_kind = second_obligation.dynamic_expr_kind
    if second_obligation.found {
        plan.second_backend_guard_compare_opcode = knowledge_runtime_guard_compare_opcode_from_constraint_kind(second_obligation.constraint_kind)
        if second_obligation.unit_name.len > 0 {
            plan.second_backend_guard_threshold_kind = knowledge_runtime_guard_backend_threshold_unit_ratio()
        } else {
            plan.second_backend_guard_threshold_kind = knowledge_runtime_guard_threshold_kind_from_value_kind(second_obligation.value_kind)
        }
        plan.second_backend_guard_trap_exit_code = 1
        plan.second_backend_guard_row_ready =
            plan.second_backend_guard_compare_opcode != knowledge_runtime_guard_backend_compare_none() &&
            plan.second_backend_guard_threshold_kind != knowledge_runtime_guard_backend_threshold_none()
    }
    plan.needs_runtime_guards = plan.runtime_obligation_count > 0

    // Walk all obligations: native_lowering_ready becomes true when every
    // obligation can be represented as a backend row. Unit labels use the
    // unit-ratio row kind and the 9-step backend plan.
    var all_emittable: bool = plan.runtime_obligation_count > 0
    var emittable_check_i: i64 = 0
    while emittable_check_i < plan.runtime_obligation_count {
        let emittable_obl = knowledge_context_nth_runtime_obligation_items(items, emittable_check_i)
        if !emittable_obl.found {
            all_emittable = false
        } else {
            var emittable_tk = knowledge_runtime_guard_threshold_kind_from_value_kind(emittable_obl.value_kind)
            if emittable_obl.unit_name.len > 0 {
                emittable_tk = knowledge_runtime_guard_backend_threshold_unit_ratio()
            }
            if emittable_tk == knowledge_runtime_guard_backend_threshold_none() {
                all_emittable = false
            }
        }
        emittable_check_i = emittable_check_i + 1
    }
    plan.native_lowering_ready = all_emittable

    plan.pre_native_guard_plan_ready =
        plan.pre_native_guard_expansion_requested &&
        plan.needs_runtime_guards &&
        !plan.native_lowering_ready

    if plan.native_lowering_ready {
        plan.backend_guard_count = plan.runtime_obligation_count
    } else {
        plan.backend_guard_count = 0
    }

    plan
}

pub fn knowledge_runtime_guard_lowering_plan_row_at(source_path: string, row_index: i64) -> KnowledgeRuntimeGuardBackendRow with IO, Mut, Panic, Div, Alloc {
    var row = knowledge_runtime_guard_backend_row_empty(row_index)
    if row_index < 0 {
        return row
    }

    let intent = knowledge_runtime_guard_directive_build_intent(source_path)
    if intent.malformed {
        return row
    }

    let items = lex_file_parse_items(source_path)
    row.parse_errors = parser_last_error_count()
    if row.parse_errors > 0 {
        return row
    }

    row.semantic_verdict = knowledge_context_validate_items(items)
    if row.semantic_verdict != 0 {
        return row
    }

    let runtime_obligation_count = knowledge_context_count_runtime_obligations_items(items)
    let obligation = knowledge_context_nth_runtime_obligation_items(items, row_index)
    knowledge_runtime_guard_backend_row_from_obligation(row_index, runtime_obligation_count, obligation)
}

pub fn knowledge_runtime_guard_native_emission_plan_at(source_path: string, row_index: i64) -> KnowledgeRuntimeGuardNativeEmissionPlan with IO, Mut, Panic, Div, Alloc {
    let row = knowledge_runtime_guard_lowering_plan_row_at(source_path, row_index)
    knowledge_runtime_guard_native_emission_plan_from_row(row)
}

pub fn knowledge_runtime_guard_native_emission_step_at(source_path: string, row_index: i64, step_index: i64) -> KnowledgeRuntimeGuardNativeEmissionStep with IO, Mut, Panic, Div, Alloc {
    let plan = knowledge_runtime_guard_native_emission_plan_at(source_path, row_index)
    knowledge_runtime_guard_native_emission_step_from_plan(plan, step_index)
}
