// self-hosted::compiler::knowledge_runtime_guard_lowering_plan
//
// Compiler-side planning surface for dynamic Knowledge<T> runtime guards. This
// joins the raw-source directive intent with checker-visible runtime obligation
// counting. It is the explicit staging surface consumed by the bounded
// native-v2 guard/trap slice; broader row-stream replacement work can grow from
// this same API.

use lexer::mod::{lex_file_parse_items}
use parser::ast::{Name, empty_name}
use parser::parser::{parser_last_error_count}
use check::knowledge_context::{KnowledgeRuntimeObligationDescriptor, knowledge_context_validate_items, knowledge_context_count_runtime_obligations_items, knowledge_context_first_runtime_obligation_items, knowledge_context_nth_runtime_obligation_items}
use knowledge_runtime_guard_directive::{knowledge_runtime_guard_directive_build_intent}

pub struct KnowledgeRuntimeGuardLoweringPlan {
    directive_found: bool,
    directive_count: i64,
    directive_malformed: bool,
    parse_errors: i64,
    semantic_verdict: i64,
    runtime_obligation_count: i64,
    needs_runtime_guards: bool,
    pre_native_guard_expansion_requested: bool,
    pre_native_guard_plan_ready: bool,
    native_lowering_ready: bool,
    backend_guard_count: i64,
    first_obligation_found: bool,
    first_obligation_site_kind: i64,
    first_obligation_type_name: Name,
    first_obligation_field_name: Name,
    first_obligation_constraint_kind: i64,
    first_obligation_value_kind: i64,
    first_obligation_int_value: i64,
    first_obligation_float_value: f64,
    first_obligation_scaled_value: i64,
    first_obligation_value_scale: i64,
    first_obligation_unit_name: Name,
    first_obligation_dynamic_expr_kind: i64,
    first_backend_guard_row_ready: bool,
    first_backend_guard_compare_opcode: i64,
    first_backend_guard_threshold_kind: i64,
    first_backend_guard_trap_exit_code: i64,
    second_obligation_found: bool,
    second_obligation_site_kind: i64,
    second_obligation_type_name: Name,
    second_obligation_field_name: Name,
    second_obligation_constraint_kind: i64,
    second_obligation_value_kind: i64,
    second_obligation_int_value: i64,
    second_obligation_float_value: f64,
    second_obligation_scaled_value: i64,
    second_obligation_value_scale: i64,
    second_obligation_unit_name: Name,
    second_obligation_dynamic_expr_kind: i64,
    second_backend_guard_row_ready: bool,
    second_backend_guard_compare_opcode: i64,
    second_backend_guard_threshold_kind: i64,
    second_backend_guard_trap_exit_code: i64,
    staged_backend_guard_row_count: i64,
}

pub struct KnowledgeRuntimeGuardBackendRow {
    row_index: i64,
    source_valid: bool,
    parse_errors: i64,
    semantic_verdict: i64,
    runtime_obligation_count: i64,
    in_bounds: bool,
    obligation_found: bool,
    site_kind: i64,
    type_name: Name,
    field_name: Name,
    constraint_kind: i64,
    value_kind: i64,
    int_value: i64,
    float_value: f64,
    scaled_value: i64,
    value_scale: i64,
    unit_name: Name,
    dynamic_expr_kind: i64,
    row_ready: bool,
    compare_opcode: i64,
    native_cmp_code: i64,
    native_trap_builtin_id: i64,
    native_trap_on_false: bool,
    threshold_kind: i64,
    trap_exit_code: i64,
}

pub struct KnowledgeRuntimeGuardNativeEmissionPlan {
    row_index: i64,
    plan_ready: bool,
    source_valid: bool,
    in_bounds: bool,
    runtime_obligation_count: i64,
    needs_value_register: bool,
    threshold_kind: i64,
    threshold_int_value: i64,
    threshold_float_value: f64,
    threshold_scaled_value: i64,
    threshold_scale: i64,
    native_cmp_code: i64,
    native_trap_builtin_id: i64,
    native_trap_on_false: bool,
    emit_load_threshold: bool,
    emit_compare_value_threshold: bool,
    emit_load_zero: bool,
    emit_eq_zero: bool,
    emit_branch_false_to_ok: bool,
    emit_trap_call: bool,
    emit_ok_label: bool,
    emit_divide_value_by_threshold: bool,
    emit_load_one: bool,
    zero_cmp_code: i64,
    native_step_count: i64,
}

pub struct KnowledgeRuntimeGuardNativeEmissionStep {
    row_index: i64,
    step_index: i64,
    step_ready: bool,
    plan_ready: bool,
    source_valid: bool,
    in_bounds: bool,
    total_step_count: i64,
    op_kind: i64,
    dst_role: i64,
    src1_role: i64,
    src2_role: i64,
    threshold_kind: i64,
    threshold_int_value: i64,
    threshold_float_value: f64,
    threshold_scaled_value: i64,
    threshold_scale: i64,
    native_cmp_code: i64,
    native_trap_builtin_id: i64,
    label_role: i64,
}

pub fn knowledge_runtime_guard_backend_compare_none() -> i64 { 0 }
pub fn knowledge_runtime_guard_backend_compare_eq() -> i64 { 1 }
pub fn knowledge_runtime_guard_backend_compare_ge() -> i64 { 2 }
pub fn knowledge_runtime_guard_backend_compare_gt() -> i64 { 3 }
pub fn knowledge_runtime_guard_backend_compare_le() -> i64 { 4 }
pub fn knowledge_runtime_guard_backend_compare_lt() -> i64 { 5 }

pub fn knowledge_runtime_guard_backend_threshold_none() -> i64 { 0 }
pub fn knowledge_runtime_guard_backend_threshold_int() -> i64 { 1 }
pub fn knowledge_runtime_guard_backend_threshold_float() -> i64 { 2 }
pub fn knowledge_runtime_guard_backend_threshold_unit_ratio() -> i64 { 3 }
pub fn knowledge_runtime_guard_native_trap_builtin_sys_exit_1() -> i64 { 20 }
pub fn knowledge_runtime_guard_native_cmp_eq_zero_code() -> i64 { 5 }

pub fn knowledge_runtime_guard_native_step_op_none() -> i64 { 0 }
pub fn knowledge_runtime_guard_native_step_op_load_threshold() -> i64 { 1 }
pub fn knowledge_runtime_guard_native_step_op_compare_value_threshold() -> i64 { 2 }
pub fn knowledge_runtime_guard_native_step_op_load_zero() -> i64 { 3 }
pub fn knowledge_runtime_guard_native_step_op_eq_zero() -> i64 { 4 }
pub fn knowledge_runtime_guard_native_step_op_branch_false_to_ok() -> i64 { 5 }
pub fn knowledge_runtime_guard_native_step_op_trap_call() -> i64 { 6 }
pub fn knowledge_runtime_guard_native_step_op_ok_label() -> i64 { 7 }
pub fn knowledge_runtime_guard_native_step_op_divide_value_by_threshold() -> i64 { 8 }
pub fn knowledge_runtime_guard_native_step_op_load_one() -> i64 { 9 }

pub fn knowledge_runtime_guard_native_step_role_none() -> i64 { 0 }
pub fn knowledge_runtime_guard_native_step_role_dynamic_value() -> i64 { 1 }
pub fn knowledge_runtime_guard_native_step_role_threshold() -> i64 { 2 }
pub fn knowledge_runtime_guard_native_step_role_compare_result() -> i64 { 3 }
pub fn knowledge_runtime_guard_native_step_role_zero() -> i64 { 4 }
pub fn knowledge_runtime_guard_native_step_role_eq_zero() -> i64 { 5 }
pub fn knowledge_runtime_guard_native_step_role_trap_result() -> i64 { 6 }
pub fn knowledge_runtime_guard_native_step_label_ok() -> i64 { 1 }
pub fn knowledge_runtime_guard_native_step_role_unit_threshold() -> i64 { 7 }
pub fn knowledge_runtime_guard_native_step_role_ratio() -> i64 { 8 }
pub fn knowledge_runtime_guard_native_step_role_one() -> i64 { 9 }

fn knowledge_runtime_guard_compare_opcode_from_constraint_kind(kind: i64) -> i64 {
    if kind == 1 { return knowledge_runtime_guard_backend_compare_eq() }
    if kind == 2 { return knowledge_runtime_guard_backend_compare_ge() }
    if kind == 3 { return knowledge_runtime_guard_backend_compare_gt() }
    if kind == 4 { return knowledge_runtime_guard_backend_compare_le() }
    if kind == 5 { return knowledge_runtime_guard_backend_compare_lt() }
    knowledge_runtime_guard_backend_compare_none()
}

fn knowledge_runtime_guard_threshold_kind_from_value_kind(kind: i64) -> i64 {
    if kind == 2 { return knowledge_runtime_guard_backend_threshold_int() }
    if kind == 3 { return knowledge_runtime_guard_backend_threshold_float() }
    knowledge_runtime_guard_backend_threshold_none()
}

fn knowledge_runtime_guard_native_cmp_code_from_backend_compare_opcode(opcode: i64) -> i64 {
    if opcode == knowledge_runtime_guard_backend_compare_eq() { return 5 }
    if opcode == knowledge_runtime_guard_backend_compare_lt() { return 7 }
    if opcode == knowledge_runtime_guard_backend_compare_le() { return 8 }
    if opcode == knowledge_runtime_guard_backend_compare_gt() { return 9 }
    if opcode == knowledge_runtime_guard_backend_compare_ge() { return 10 }
    0
}

