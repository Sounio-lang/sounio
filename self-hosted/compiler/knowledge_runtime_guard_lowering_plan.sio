        op_kind: knowledge_runtime_guard_native_step_op_none(),
        dst_role: knowledge_runtime_guard_native_step_role_none(),
        src1_role: knowledge_runtime_guard_native_step_role_none(),
        src2_role: knowledge_runtime_guard_native_step_role_none(),
        threshold_kind: knowledge_runtime_guard_backend_threshold_none(),
        threshold_int_value: 0,
        threshold_float_value: 0.0,
        threshold_scaled_value: 0,
