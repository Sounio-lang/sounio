use lexer::mod::{lex_file_parse_items}
use parser::parser::{parser_last_error_count}
use check::knowledge_context::{knowledge_context_unit_derived_semantic_probe_items}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    var path = "tests/frontend/unit_derived_acceleration_chain_current_source.sio"
    if argc >= 1 {
        path = get_arg(0)
    }
    let items = lex_file_parse_items(path)
    if parser_last_error_count() > 0 {
        print("parse_errors=")
        print_int(parser_last_error_count())
        print("\n")
        return 2
    }
    let verdict = knowledge_context_unit_derived_semantic_probe_items(items)
    print("unit_derived_checker_verdict=")
    print_int(verdict)
    print("\n")
    verdict
}
