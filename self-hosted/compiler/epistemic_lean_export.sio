module epistemic_lean_export

use ir::ir::*
use io::file_write::*
use module_frontend::{load_multimodule_epistemic_into}

struct EpistemicLeanExportResult {
    ok: bool,
    contest_count: i64,
    robust_proof_count: i64,
    counterexample_count: i64,
    error_msg: string,
}

fn epistemic_lean_export_result_ok(contest_count: i64, robust_proof_count: i64, counterexample_count: i64) -> EpistemicLeanExportResult {
    EpistemicLeanExportResult {
        ok: true,
        contest_count: contest_count,
        robust_proof_count: robust_proof_count,
        counterexample_count: counterexample_count,
        error_msg: "",
    }
}

fn epistemic_lean_export_result_error(msg: string) -> EpistemicLeanExportResult {
    EpistemicLeanExportResult {
        ok: false,
        contest_count: 0,
        robust_proof_count: 0,
        counterexample_count: 0,
        error_msg: msg,
    }
}

fn epistemic_lean_append_i64(buf: [i8; 65536], pos: i64, value: i64) -> ([i8; 65536], i64) with Mut, Panic, Div {
    io_trace_append_string(buf, pos, io_trace_i64_string(value))
}

fn epistemic_lean_append_name_string(buf: [i8; 65536], pos: i64, name: Name) -> ([i8; 65536], i64) with Mut, Panic, Div {
    io_trace_append_json_string(buf, pos, str_from_bytes(name.buf, name.len))
}

fn emit_epistemic_lean_section(path: string, output_path: string, ep: &IrEpistemicSection) -> bool with IO, Mut, Panic, Div, Alloc {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0
    var i: i64 = 0

    let h0 = io_trace_append_string(buf, p, "-- Auto-generated by SOUNIO self-hosted compiler\n")
    buf = h0.0
    p = h0.1
    let h1 = io_trace_append_string(buf, p, "-- Source: ")
    buf = h1.0
    p = h1.1
    let h2 = io_trace_append_json_string(buf, p, path)
    buf = h2.0
    p = h2.1
    let h3 = io_trace_append_string(buf, p, "\n\nnamespace SounioEpistemicExport\n\n")
    buf = h3.0
    p = h3.1

    let s0 = io_trace_append_string(buf, p, "structure CounterexampleRecord where\n  id : Int\n  modelName : String\n  subgroupName : String\n  metricName : String\n  summary : String\n  deriving Repr\n\n")
    buf = s0.0
    p = s0.1
    let s1 = io_trace_append_string(buf, p, "structure ContestRecord where\n  id : Int\n  auditId : Int\n  familyId : Int\n  policyId : Int\n  modelCount : Int\n  counterexampleId : Int\n  provenanceBundleId : Int\n  deriving Repr\n\n")
    buf = s1.0
    p = s1.1
    let s2 = io_trace_append_string(buf, p, "structure RobustProofRecord where\n  id : Int\n  auditId : Int\n  contestId : Int\n  policyId : Int\n  levelId : Int\n  scopeId : Int\n  deriving Repr\n\n")
    buf = s2.0
    p = s2.1

    let sp0 = io_trace_append_string(buf, p, "def sourcePath : String := \"")
    buf = sp0.0
    p = sp0.1
    let sp1 = io_trace_append_json_string(buf, p, path)
    buf = sp1.0
    p = sp1.1
    let sp2 = io_trace_append_string(buf, p, "\"\n\n")
    buf = sp2.0
    p = sp2.1

    let c0 = io_trace_append_string(buf, p, "def counterexamples : List CounterexampleRecord := [\n")
    buf = c0.0
    p = c0.1
    i = 0
    while i < (*ep).counterexample_count {
        if i > 0 {
            let sep = io_trace_append_string(buf, p, ",\n")
            buf = sep.0
            p = sep.1
        }
        let r0 = io_trace_append_string(buf, p, "  { id := ")
        buf = r0.0
        p = r0.1
        let r1 = epistemic_lean_append_i64(buf, p, (*ep).counterexamples[i].id)
        buf = r1.0
        p = r1.1
        let r2 = io_trace_append_string(buf, p, ", modelName := \"")
        buf = r2.0
        p = r2.1
        let r3 = epistemic_lean_append_name_string(buf, p, (*ep).counterexamples[i].model_name)
        buf = r3.0
        p = r3.1
        let r4 = io_trace_append_string(buf, p, "\", subgroupName := \"")
        buf = r4.0
        p = r4.1
        let r5 = epistemic_lean_append_name_string(buf, p, (*ep).counterexamples[i].subgroup_name)
        buf = r5.0
        p = r5.1
        let r6 = io_trace_append_string(buf, p, "\", metricName := \"")
        buf = r6.0
        p = r6.1
        let r7 = epistemic_lean_append_name_string(buf, p, (*ep).counterexamples[i].metric_name)
        buf = r7.0
        p = r7.1
        let r8 = io_trace_append_string(buf, p, "\", summary := \"")
        buf = r8.0
        p = r8.1
        let r9 = epistemic_lean_append_name_string(buf, p, (*ep).counterexamples[i].summary)
        buf = r9.0
        p = r9.1
        let r10 = io_trace_append_string(buf, p, "\" }")
        buf = r10.0
        p = r10.1
        i = i + 1
    }
    let c1 = io_trace_append_string(buf, p, "\n]\n\n")
    buf = c1.0
    p = c1.1

    let t0 = io_trace_append_string(buf, p, "def contests : List ContestRecord := [\n")
    buf = t0.0
    p = t0.1
    i = 0
    while i < (*ep).contest_count {
        if i > 0 {
            let sep = io_trace_append_string(buf, p, ",\n")
            buf = sep.0
            p = sep.1
        }
        let q0 = io_trace_append_string(buf, p, "  { id := ")
        buf = q0.0
        p = q0.1
        let q1 = epistemic_lean_append_i64(buf, p, (*ep).contests[i].id)
        buf = q1.0
        p = q1.1
        let q2 = io_trace_append_string(buf, p, ", auditId := ")
        buf = q2.0
        p = q2.1
        let q3 = epistemic_lean_append_i64(buf, p, (*ep).contests[i].audit_id)
        buf = q3.0
        p = q3.1
        let q4 = io_trace_append_string(buf, p, ", familyId := ")
        buf = q4.0
        p = q4.1
        let q5 = epistemic_lean_append_i64(buf, p, (*ep).contests[i].family_id)
        buf = q5.0
        p = q5.1
        let q6 = io_trace_append_string(buf, p, ", policyId := ")
        buf = q6.0
        p = q6.1
        let q7 = epistemic_lean_append_i64(buf, p, (*ep).contests[i].policy_id)
        buf = q7.0
        p = q7.1
        let q8 = io_trace_append_string(buf, p, ", modelCount := ")
        buf = q8.0
        p = q8.1
        let q9 = epistemic_lean_append_i64(buf, p, (*ep).contests[i].model_count)
        buf = q9.0
        p = q9.1
        let q10 = io_trace_append_string(buf, p, ", counterexampleId := ")
        buf = q10.0
        p = q10.1
        let q11 = epistemic_lean_append_i64(buf, p, (*ep).contests[i].counterexample_id)
        buf = q11.0
        p = q11.1
        let q12 = io_trace_append_string(buf, p, ", provenanceBundleId := ")
        buf = q12.0
        p = q12.1
        let q13 = epistemic_lean_append_i64(buf, p, (*ep).contests[i].provenance_bundle_id)
        buf = q13.0
        p = q13.1
        let q14 = io_trace_append_string(buf, p, " }")
        buf = q14.0
        p = q14.1
        i = i + 1
    }
    let t1 = io_trace_append_string(buf, p, "\n]\n\n")
    buf = t1.0
    p = t1.1

    let p0 = io_trace_append_string(buf, p, "def robustProofs : List RobustProofRecord := [\n")
    buf = p0.0
    p = p0.1
    i = 0
    while i < (*ep).robust_proof_count {
        if i > 0 {
            let sep = io_trace_append_string(buf, p, ",\n")
            buf = sep.0
            p = sep.1
        }
        let rp0 = io_trace_append_string(buf, p, "  { id := ")
        buf = rp0.0
        p = rp0.1
        let rp1 = epistemic_lean_append_i64(buf, p, (*ep).robust_proofs[i].id)
        buf = rp1.0
        p = rp1.1
        let rp2 = io_trace_append_string(buf, p, ", auditId := ")
        buf = rp2.0
        p = rp2.1
        let rp3 = epistemic_lean_append_i64(buf, p, (*ep).robust_proofs[i].audit_id)
        buf = rp3.0
        p = rp3.1
        let rp4 = io_trace_append_string(buf, p, ", contestId := ")
        buf = rp4.0
        p = rp4.1
        let rp5 = epistemic_lean_append_i64(buf, p, (*ep).robust_proofs[i].contest_id)
        buf = rp5.0
        p = rp5.1
        let rp6 = io_trace_append_string(buf, p, ", policyId := ")
        buf = rp6.0
        p = rp6.1
        let rp7 = epistemic_lean_append_i64(buf, p, (*ep).robust_proofs[i].policy_id)
        buf = rp7.0
        p = rp7.1
        let rp8 = io_trace_append_string(buf, p, ", levelId := ")
        buf = rp8.0
        p = rp8.1
        let rp9 = epistemic_lean_append_i64(buf, p, (*ep).robust_proofs[i].level_id)
        buf = rp9.0
        p = rp9.1
        let rp10 = io_trace_append_string(buf, p, ", scopeId := ")
        buf = rp10.0
        p = rp10.1
        let rp11 = epistemic_lean_append_i64(buf, p, (*ep).robust_proofs[i].scope_id)
        buf = rp11.0
        p = rp11.1
        let rp12 = io_trace_append_string(buf, p, " }")
        buf = rp12.0
        p = rp12.1
        i = i + 1
    }
    let p1 = io_trace_append_string(buf, p, "\n]\n\n")
    buf = p1.0
    p = p1.1

    let th0 = io_trace_append_string(buf, p, "theorem counterexamples_length : counterexamples.length = ")
    buf = th0.0
    p = th0.1
    let th1 = epistemic_lean_append_i64(buf, p, (*ep).counterexample_count)
    buf = th1.0
    p = th1.1
    let th2 = io_trace_append_string(buf, p, " := rfl\n")
    buf = th2.0
    p = th2.1

    let th3 = io_trace_append_string(buf, p, "theorem contests_length : contests.length = ")
    buf = th3.0
    p = th3.1
    let th4 = epistemic_lean_append_i64(buf, p, (*ep).contest_count)
    buf = th4.0
    p = th4.1
    let th5 = io_trace_append_string(buf, p, " := rfl\n")
    buf = th5.0
    p = th5.1

    let th6 = io_trace_append_string(buf, p, "theorem robustProofs_length : robustProofs.length = ")
    buf = th6.0
    p = th6.1
    let th7 = epistemic_lean_append_i64(buf, p, (*ep).robust_proof_count)
    buf = th7.0
    p = th7.1
    let th8 = io_trace_append_string(buf, p, " := rfl\n\nend SounioEpistemicExport\n")
    buf = th8.0
    p = th8.1

    write_file(output_path, buf, p) == 0
}

fn emit_epistemic_lean_from_source_path(source_path: string, output_path: string) -> EpistemicLeanExportResult with IO, Mut, Panic, Div, Alloc {
    var merged_epistemic = ir_empty_epistemic_section()
    let frontend_result = load_multimodule_epistemic_into(source_path, &!merged_epistemic)
    if !frontend_result.ok {
        return epistemic_lean_export_result_error(frontend_result.error_msg)
    }

    if !emit_epistemic_lean_section(source_path, output_path, &merged_epistemic) {
        return epistemic_lean_export_result_error("write_failed")
    }

    epistemic_lean_export_result_ok(
        merged_epistemic.contest_count,
        merged_epistemic.robust_proof_count,
        merged_epistemic.counterexample_count
    )
}
