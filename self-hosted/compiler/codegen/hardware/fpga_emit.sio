// FPGA HLS emitter (SIO-307): Sounio subset -> Vitis HLS C++ for Alveo U250.
//
// Self-hosted port of the verified Python prototype (tools/fpga/sio_fpga_emit.py).
// The prototype remains the executable specification; this module is what
// souc compile -t fpga-u250 runs. Subset v0 (ADR-022): i64/bool scalars,
// fixed arrays, bounded for, if/else, integer arithmetic and indexing.
// Anything outside the subset panics with SIO_FPGA_EMIT_FAIL (loud rejection).
//
// Kernel selection: the first fn whose name is not "main".

pub struct FpgaBuf {
    pub data: [i8; 16384],
    pub len: i64,
}

pub fn fpga_buf_new() -> FpgaBuf {
    FpgaBuf { data: [0; 16384], len: 0 }
}

pub fn fpga_buf_push(buf: &!FpgaBuf, b: i8) with Mut, Panic {
    if buf.len >= 0 && buf.len < 16384 {
        buf.data[buf.len as usize] = b
        buf.len = buf.len + 1
    }
}

pub fn fpga_buf_push_str(buf: &!FpgaBuf, s: string) with Mut, Panic, Div, Alloc {
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        fpga_buf_push(buf, str_char_at(s, i) as i8)
        i = i + 1
    }
}

pub fn fpga_buf_push_line(buf: &!FpgaBuf, s: string) with Mut, Panic, Div, Alloc {
    fpga_buf_push_str(buf, s)
    fpga_buf_push(buf, 10 as i8)
}

pub fn fpga_buf_to_string(buf: FpgaBuf) -> string with Mut, Panic, Div, Alloc {
    var s = ""
    var i: i64 = 0
    while i < buf.len {
        s = str_concat(s, fpga_char_to_str(buf.data[i as usize] as i64))
        i = i + 1
    }
    s
}
pub fn fpga_char_to_str(ch: i64) -> string with Mut, Panic, Div, Alloc {
    if ch == 10 { return "\n" }
    else if ch == 32 { return " " }
    else if ch == 33 { return "!" }
    else if ch == 34 { return "\"" }
    else if ch == 35 { return "#" }
    else if ch == 36 { return "$" }
    else if ch == 37 { return "%" }
    else if ch == 38 { return "&" }
    else if ch == 39 { return "'" }
    else if ch == 40 { return "(" }
    else if ch == 41 { return ")" }
    else if ch == 42 { return "*" }
    else if ch == 43 { return "+" }
    else if ch == 44 { return "," }
    else if ch == 45 { return "-" }
    else if ch == 46 { return "." }
    else if ch == 47 { return "/" }
    else if ch == 48 { return "0" }
    else if ch == 49 { return "1" }
    else if ch == 50 { return "2" }
    else if ch == 51 { return "3" }
    else if ch == 52 { return "4" }
    else if ch == 53 { return "5" }
    else if ch == 54 { return "6" }
    else if ch == 55 { return "7" }
    else if ch == 56 { return "8" }
    else if ch == 57 { return "9" }
    else if ch == 58 { return ":" }
    else if ch == 59 { return ";" }
    else if ch == 60 { return "<" }
    else if ch == 61 { return "=" }
    else if ch == 62 { return ">" }
    else if ch == 63 { return "?" }
    else if ch == 64 { return "@" }
    else if ch == 65 { return "A" }
    else if ch == 66 { return "B" }
    else if ch == 67 { return "C" }
    else if ch == 68 { return "D" }
    else if ch == 69 { return "E" }
    else if ch == 70 { return "F" }
    else if ch == 71 { return "G" }
    else if ch == 72 { return "H" }
    else if ch == 73 { return "I" }
    else if ch == 74 { return "J" }
    else if ch == 75 { return "K" }
    else if ch == 76 { return "L" }
    else if ch == 77 { return "M" }
    else if ch == 78 { return "N" }
    else if ch == 79 { return "O" }
    else if ch == 80 { return "P" }
    else if ch == 81 { return "Q" }
    else if ch == 82 { return "R" }
    else if ch == 83 { return "S" }
    else if ch == 84 { return "T" }
    else if ch == 85 { return "U" }
    else if ch == 86 { return "V" }
    else if ch == 87 { return "W" }
    else if ch == 88 { return "X" }
    else if ch == 89 { return "Y" }
    else if ch == 90 { return "Z" }
    else if ch == 91 { return "[" }
    else if ch == 92 { return "\\" }
    else if ch == 93 { return "]" }
    else if ch == 94 { return "^" }
    else if ch == 95 { return "_" }
    else if ch == 96 { return "`" }
    else if ch == 97 { return "a" }
    else if ch == 98 { return "b" }
    else if ch == 99 { return "c" }
    else if ch == 100 { return "d" }
    else if ch == 101 { return "e" }
    else if ch == 102 { return "f" }
    else if ch == 103 { return "g" }
    else if ch == 104 { return "h" }
    else if ch == 105 { return "i" }
    else if ch == 106 { return "j" }
    else if ch == 107 { return "k" }
    else if ch == 108 { return "l" }
    else if ch == 109 { return "m" }
    else if ch == 110 { return "n" }
    else if ch == 111 { return "o" }
    else if ch == 112 { return "p" }
    else if ch == 113 { return "q" }
    else if ch == 114 { return "r" }
    else if ch == 115 { return "s" }
    else if ch == 116 { return "t" }
    else if ch == 117 { return "u" }
    else if ch == 118 { return "v" }
    else if ch == 119 { return "w" }
    else if ch == 120 { return "x" }
    else if ch == 121 { return "y" }
    else if ch == 122 { return "z" }
    else if ch == 123 { return "{" }
    else if ch == 124 { return "|" }
    else if ch == 125 { return "}" }
    else if ch == 126 { return "~" }
    else { return "?" }
}

// ---- string helpers (byte-wise, no slicing in the language) ----

pub fn fs_sub(s: string, a: i64, b: i64) -> string with Mut, Panic, Div, Alloc {
    var out = ""
    let n = str_len(s)
    var end = b
    if end > n { end = n }
    var i = a
    while i < end {
        out = str_concat(out, fpga_char_to_str(str_char_at(s, i) as i64))
        i = i + 1
    }
    out
}

pub fn fs_trim(s: string) -> string with Mut, Panic, Div, Alloc {
    let n = str_len(s)
    var a: i64 = 0
    var b = n
    while a < b && (str_char_at(s, a) == 32 || str_char_at(s, a) == 9) { a = a + 1 }
    while b > a && (str_char_at(s, b - 1) == 32 || str_char_at(s, b - 1) == 9 || str_char_at(s, b - 1) == 13) { b = b - 1 }
    fs_sub(s, a, b)
}

pub fn fs_starts(s: string, prefix: string) -> bool with Mut, Panic, Div {
    let n = str_len(prefix)
    if str_len(s) < n { return false }
    var i: i64 = 0
    while i < n {
        if str_char_at(s, i) != str_char_at(prefix, i) { return false }
        i = i + 1
    }
    true
}

pub fn fs_ends(s: string, suffix: string) -> bool with Mut, Panic, Div, Alloc {
    let n = str_len(suffix)
    let m = str_len(s)
    if m < n { return false }
    fs_sub(s, m - n, m) == suffix
}

pub fn fs_index_of(s: string, needle: string, from: i64) -> i64 with Mut, Panic, Div, Alloc {
    let n = str_len(s)
    let m = str_len(needle)
    if m == 0 { return from }
    var i = from
    while i + m <= n {
        if fs_sub(s, i, i + m) == needle { return i }
        i = i + 1
    }
    return 0 - 1
}

pub fn fs_contains(s: string, needle: string) -> bool with Mut, Panic, Div, Alloc {
    fs_index_of(s, needle, 0) >= 0
}

pub fn fs_count_char(s: string, ch: i64) -> i64 with Mut, Panic, Div {
    var n: i64 = 0
    var i: i64 = 0
    let m = str_len(s)
    while i < m {
        if str_char_at(s, i) == ch { n = n + 1 }
        i = i + 1
    }
    n
}

// Remove every occurrence of needle (used for " as usize").
pub fn fs_remove_all(s: string, needle: string) -> string with Mut, Panic, Div, Alloc {
    var buf = fpga_buf_new()
    let n = str_len(s)
    let m = str_len(needle)
    var i: i64 = 0
    while i < n {
        if i + m <= n && fs_sub(s, i, i + m) == needle {
            i = i + m
        } else {
            fpga_buf_push(&!buf, str_char_at(s, i) as i8)
            i = i + 1
        }
    }
    fpga_buf_to_string(buf)
}

// Index-based line access (tuple destructuring is avoided in this module).
pub fn fs_line_count(src: string) -> i64 with Mut, Panic, Div {
    let n = str_len(src)
    if n == 0 { return 0 }
    var c = fs_count_char(src, 10)
    if str_char_at(src, n - 1) != 10 { c = c + 1 }
    c
}

pub fn fs_line_at(src: string, idx: i64) -> string with Mut, Panic, Div, Alloc {
    let n = str_len(src)
    var cur: i64 = 0
    var start: i64 = 0
    var i: i64 = 0
    while i <= n {
        if i == n || str_char_at(src, i) == 10 {
            if cur == idx { return fs_sub(src, start, i) }
            cur = cur + 1
            start = i + 1
        }
        i = i + 1
    }
    ""
}

// Split packed list "a|b|c" item idx (0-based); "" when absent.
pub fn fs_pack_get(packed: string, idx: i64) -> string with Mut, Panic, Div, Alloc {
    var cur: i64 = 0
    var start: i64 = 0
    let n = str_len(packed)
    var i: i64 = 0
    while i <= n {
        if i == n || str_char_at(packed, i) == 124 {
            if cur == idx { return fs_sub(packed, start, i) }
            cur = cur + 1
            start = i + 1
        }
        i = i + 1
    }
    ""
}

pub fn fs_pack_count(packed: string) -> i64 with Mut, Panic, Div {
    if str_len(packed) == 0 { return 0 }
    fs_count_char(packed, 124) + 1
}

// ---- type mapping ----

pub fn fs_match(s: string, open_pos: i64, open_ch: i64, close_ch: i64) -> i64 with Mut, Panic, Div {
    var depth: i64 = 0
    var i = open_pos
    let n = str_len(s)
    while i < n {
        let c = str_char_at(s, i)
        if c == open_ch { depth = depth + 1 }
        if c == close_ch {
            depth = depth - 1
            if depth == 0 { return i }
        }
        i = i + 1
    }
    return 0 - 1
}

pub fn fpga_c_base(t: string) -> string {
    if t == "i64" { return "int64_t" }
    if t == "i32" { return "int" }
    if t == "i16" { return "short" }
    if t == "i8" { return "signed char" }
    if t == "u64" { return "uint64_t" }
    if t == "u32" { return "unsigned int" }
    if t == "u8" { return "unsigned char" }
    if t == "f64" { return "double" }
    if t == "f32" { return "float" }
    if t == "bool" { return "bool" }
    ""
}

// C declaration for one Sounio parameter; returns (decl, is_array).
pub fn fpga_decl_for(name: string, type_str: string) -> string with Mut, Panic, Div, Alloc {
    var t = fs_trim(type_str)
    var suffix = ""
    while fs_starts(t, "[") {
        let close = fs_match(t, 0, 91, 93)
        if close < 0 { panic("SIO_FPGA_EMIT_FAIL: unbalanced [ in type") }
        let inner = fs_sub(t, 1, close)
        var last_semi = 0 - 1
        var i: i64 = 0
        while i < str_len(inner) {
            if str_char_at(inner, i) == 59 { last_semi = i }
            i = i + 1
        }
        if last_semi < 0 { panic("SIO_FPGA_EMIT_FAIL: array type needs [T; N]") }
        let elem = fs_trim(fs_sub(inner, 0, last_semi))
        let cnt = fs_trim(fs_sub(inner, last_semi + 1, str_len(inner)))
        if fs_contains(cnt, " ") { panic("SIO_FPGA_EMIT_FAIL: non-constant array size") }
        suffix = str_concat(str_concat(str_concat(suffix, "["), cnt), "]")
        t = elem
    }
    let base = fpga_c_base(t)
    if base == "" { panic("SIO_FPGA_EMIT_FAIL: unsupported type") }
    var decl = str_concat(str_concat(base, " "), name)
    decl = str_concat(decl, suffix)
    decl
}

// A decl is an array decl when it carries C brackets.
pub fn fpga_decl_is_array(decl: string) -> bool with Mut, Panic, Div, Alloc {
    fs_contains(decl, "[")
}

pub fn fpga_indent(depth: i64) -> string with Mut, Panic, Div, Alloc {
    var out = ""
    var i: i64 = 0
    while i < depth * 4 {
        out = str_concat(out, " ")
        i = i + 1
    }
    out
}

// Translate one kernel source (subset v0) to Vitis HLS C++.
pub fn fpga_emit_hls_buf(src: string) -> FpgaBuf with Mut, Panic, Div, Alloc {
    // Phase A: locate the kernel (first fn that is not main).
    var found = false
    var kernel = ""
    var sig_line = ""
    var body_li: i64 = 0
    let nlines = fs_line_count(src)
    var li: i64 = 0
    while li < nlines && !found {
        let t = fs_trim(fs_line_at(src, li))
        if fs_starts(t, "fn ") {
            let lp = fs_index_of(t, "(", 0)
            let name = fs_trim(fs_sub(t, 3, lp))
            if name != "main" {
                found = true
                kernel = name
                sig_line = t
                body_li = li + 1
            }
        }
        li = li + 1
    }
    if !found { panic("SIO_FPGA_EMIT_FAIL: no kernel fn found (first non-main fn)") }

    // Phase B: signature.
    let lp = fs_index_of(sig_line, "(", 0)
    let rp = fs_match(sig_line, lp, 40, 41)
    if rp < 0 { panic("SIO_FPGA_EMIT_FAIL: unbalanced signature") }
    let params_str = fs_sub(sig_line, lp + 1, rp)
    var ret_sio = ""
    let arrow = fs_index_of(sig_line, "->", rp)
    if arrow >= 0 {
        var tail = fs_sub(sig_line, arrow + 2, str_len(sig_line))
        let wpos = fs_index_of(tail, " with", 0)
        if wpos >= 0 { tail = fs_sub(tail, 0, wpos) }
        tail = fs_trim(tail)
        if fs_ends(tail, "{") { tail = fs_trim(fs_sub(tail, 0, str_len(tail) - 1)) }
        ret_sio = tail
    }
    var cret = "void"
    if ret_sio != "" {
        cret = fpga_c_base(ret_sio)
        if cret == "" { panic("SIO_FPGA_EMIT_FAIL: unsupported return type") }
    }
    // Parameters: split on top-level commas.
    var pnames = ""
    var pdecls = ""
    var parrays = ""
    let trimmed_params = fs_trim(params_str)
    if str_len(trimmed_params) > 0 {
        var start: i64 = 0
        var depth: i64 = 0
        var i: i64 = 0
        let n = str_len(params_str)
        while i <= n {
            var at_end = false
            var is_sep = false
            if i == n { at_end = true; is_sep = true }
            if !at_end {
                let c = str_char_at(params_str, i)
                if c == 91 { depth = depth + 1 }
                if c == 93 { depth = depth - 1 }
                if c == 44 && depth == 0 { is_sep = true }
            }
            if is_sep {
                let part = fs_trim(fs_sub(params_str, start, i))
                let colon = fs_index_of(part, ":", 0)
                if colon < 0 { panic("SIO_FPGA_EMIT_FAIL: parameter needs name: type") }
                let pname = fs_trim(fs_sub(part, 0, colon))
                let ptype = fs_trim(fs_sub(part, colon + 1, str_len(part)))
                let decl = fpga_decl_for(pname, ptype)
                let is_arr = fpga_decl_is_array(decl)
                if str_len(pnames) > 0 {
                    pnames = str_concat(pnames, "|")
                    pdecls = str_concat(pdecls, "|")
                    parrays = str_concat(parrays, "|")
                }
                pnames = str_concat(pnames, pname)
                pdecls = str_concat(pdecls, decl)
                if is_arr { parrays = str_concat(parrays, "1") } else { parrays = str_concat(parrays, "0") }
                start = i + 1
            }
            i = i + 1
        }
    }

    // Phase C: emit header, signature and interface pragmas.
    var out = fpga_buf_new()
    fpga_buf_push_line(&!out, "// Generated by souc --target fpga-u250 (SIO-307, ADR-022 subset v0).")
    fpga_buf_push_str(&!out, "// Kernel: ")
    fpga_buf_push_line(&!out, kernel)
    fpga_buf_push_line(&!out, "#include <cstdint>")
    fpga_buf_push_line(&!out, "#include <cstddef>")
    fpga_buf_push_line(&!out, "")
    var sig = "extern \"C\" "
    sig = str_concat(str_concat(str_concat(sig, cret), " "), kernel)
    sig = str_concat(sig, "(")
    let pc = fs_pack_count(pnames)
    var j: i64 = 0
    var joined = ""
    while j < pc {
        if j > 0 { joined = str_concat(joined, ", ") }
        joined = str_concat(joined, fs_pack_get(pdecls, j))
        j = j + 1
    }
    fpga_buf_push_str(&!out, sig)
    fpga_buf_push_str(&!out, joined)
    fpga_buf_push_line(&!out, ") {")
    j = 0
    while j < pc {
        let pname = fs_pack_get(pnames, j)
        if fs_pack_get(parrays, j) == "1" {
            fpga_buf_push_line(&!out, str_concat(str_concat("    #pragma HLS INTERFACE m_axi port=", pname), " offset=slave bundle=gmem"))
        } else {
            fpga_buf_push_line(&!out, str_concat("    #pragma HLS INTERFACE s_axilite port=", pname))
        }
        j = j + 1
    }
    if cret != "void" {
        fpga_buf_push_line(&!out, "    #pragma HLS INTERFACE s_axilite port=return")
    }

    // Phase D: body translation.
    var bdepth: i64 = 1
    var first_for = true
    li = body_li
    while li < nlines && bdepth > 0 {
        {
            var t = fs_trim(fs_line_at(src, li))
            li = li + 1
            if str_len(t) > 0 && !fs_starts(t, "//") {
                t = fs_remove_all(t, " as usize")
                if fs_contains(t, "\"") { panic("SIO_FPGA_EMIT_FAIL: string literals outside subset v0") }
                if fs_starts(t, "while") { panic("SIO_FPGA_EMIT_FAIL: while outside subset v0 (use bounded for)") }
                if fs_contains(t, "print") { panic("SIO_FPGA_EMIT_FAIL: print outside subset v0") }
                if t == "}" {
                    bdepth = bdepth - 1
                    fpga_buf_push_line(&!out, str_concat(fpga_indent(bdepth), "}"))
                } else if t == "} else {" {
                    fpga_buf_push_line(&!out, str_concat(fpga_indent(bdepth - 1), "} else {"))
                } else if fs_starts(t, "for ") && fs_contains(t, " in ") && fs_ends(t, "{") {
                    let inpos = fs_index_of(t, " in ", 0)
                    let varname = fs_trim(fs_sub(t, 4, inpos))
                    let rng = fs_trim(fs_sub(t, inpos + 4, str_len(t) - 1))
                    let dots = fs_index_of(rng, "..", 0)
                    if dots < 0 { panic("SIO_FPGA_EMIT_FAIL: for needs A..B range") }
                    let lo = fs_trim(fs_sub(rng, 0, dots))
                    let hi = fs_trim(fs_sub(rng, dots + 2, str_len(rng)))
                    var fl = "for (int64_t "
                    fl = str_concat(str_concat(fl, varname), " = ")
                    fl = str_concat(str_concat(fl, lo), "; ")
                    fl = str_concat(str_concat(fl, varname), " < ")
                    fl = str_concat(str_concat(fl, hi), "; ")
                    fl = str_concat(str_concat(fl, varname), "++) {")
                    fpga_buf_push_str(&!out, fpga_indent(bdepth))
                    fpga_buf_push_str(&!out, "for (int64_t ")
                    fpga_buf_push_str(&!out, varname)
                    fpga_buf_push_str(&!out, " = ")
                    fpga_buf_push_str(&!out, lo)
                    fpga_buf_push_str(&!out, "; ")
                    fpga_buf_push_str(&!out, varname)
                    fpga_buf_push_str(&!out, " < ")
                    fpga_buf_push_str(&!out, hi)
                    fpga_buf_push_str(&!out, "; ")
                    fpga_buf_push_str(&!out, varname)
                    fpga_buf_push_line(&!out, "++) {")
                    bdepth = bdepth + 1
                    if first_for {
                        fpga_buf_push_line(&!out, str_concat(fpga_indent(bdepth), "#pragma HLS PIPELINE II=1"))
                        first_for = false
                    }
                } else if fs_starts(t, "if ") && fs_ends(t, "{") {
                    let cond = fs_trim(fs_sub(t, 3, str_len(t) - 1))
                    fpga_buf_push_str(&!out, fpga_indent(bdepth))
                    fpga_buf_push_str(&!out, "if (")
                    fpga_buf_push_str(&!out, cond)
                    fpga_buf_push_line(&!out, ") {")
                    bdepth = bdepth + 1
                } else if fs_starts(t, "var ") || fs_starts(t, "let ") {
                    let rest = fs_sub(t, 4, str_len(t))
                    let eq = fs_index_of(rest, "=", 0)
                    if eq < 0 { panic("SIO_FPGA_EMIT_FAIL: declaration needs initializer") }
                    let lhs = fs_sub(rest, 0, eq)
                    let colon = fs_index_of(lhs, ":", 0)
                    var nm = fs_trim(lhs)
                    var decl = ""
                    if colon >= 0 {
                        nm = fs_trim(fs_sub(lhs, 0, colon))
                        let ltype = fs_trim(fs_sub(lhs, colon + 1, str_len(lhs)))
                        decl = fpga_decl_for(nm, ltype)
                    } else {
                        decl = str_concat("int64_t ", nm)
                    }
                    let rhs = fs_trim(fs_sub(rest, eq + 1, str_len(rest)))
                    fpga_buf_push_str(&!out, fpga_indent(bdepth))
                    fpga_buf_push_str(&!out, decl)
                    fpga_buf_push_str(&!out, " = ")
                    fpga_buf_push_str(&!out, rhs)
                    fpga_buf_push_line(&!out, ";")
                } else if fs_starts(t, "else") {
                    panic("SIO_FPGA_EMIT_FAIL: else-if outside subset v0")
                } else {
                    let single_eq = fs_contains(t, "=") && !fs_contains(t, "==") && !fs_contains(t, ">=") && !fs_contains(t, "<=") && !fs_contains(t, "!=")
                    if single_eq {
                        fpga_buf_push_str(&!out, fpga_indent(bdepth))
                    fpga_buf_push_str(&!out, t)
                    fpga_buf_push_line(&!out, ";")
                    } else {
                        if cret == "void" { panic("SIO_FPGA_EMIT_FAIL: bare expression in void kernel") }
                        fpga_buf_push_str(&!out, fpga_indent(bdepth))
                    fpga_buf_push_str(&!out, "return ")
                    fpga_buf_push_str(&!out, t)
                    fpga_buf_push_line(&!out, ";")
                    }
                }
            }
        }
    }
    if bdepth != 0 { panic("SIO_FPGA_EMIT_FAIL: unbalanced braces in kernel") }
    out
}

pub fn fpga_emit_hls(src: string) -> string with Mut, Panic, Div, Alloc {
    fpga_buf_to_string(fpga_emit_hls_buf(src))
}

// souc --target fpga-u250 entry: .sio in, HLS C++ out.
pub fn fpga_emit_file(input: string, output: string) -> i64 with IO, Mut, Panic, Div, Alloc {
    let src = read_file(input)
    if str_len(src) == 0 { panic("SIO_FPGA_EMIT_FAIL: empty or unreadable input") }
    let buf = fpga_emit_hls_buf(src)
    write_file(output, buf.data, buf.len)
    println(str_concat(str_concat(str_concat("SIO_FPGA_EMIT_OK ", input), " -> "), output))
    0
}
