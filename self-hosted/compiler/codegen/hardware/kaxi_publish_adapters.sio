let HARDWARE_PUBLISH_NATIVE_KEYWORD = "hardware_publish"
let KAXI_OP_PASS: i64 = 0
let KAXI_OP_ADD: i64 = 1
let KAXI_OP_MUL: i64 = 2
let KAXI_OP_DIV: i64 = 3
let KAXI_OP_FMA: i64 = 4
let KAXI_OP_PROP_VAR: i64 = 5

fn hardware_publish_is_supported_op(op_kind: i64) -> bool {
    op_kind == KAXI_OP_ADD ||
    op_kind == KAXI_OP_MUL ||
    op_kind == KAXI_OP_DIV ||
    op_kind == KAXI_OP_FMA ||
    op_kind == KAXI_OP_PROP_VAR
}

fn hardware_publish_pack_flags(op_kind: i64) -> i64 {
    // Native keyword contract: every publish contributes one success delta,
    // no failure delta, and default degradation alpha_q8 = 16.
    let success = if op_kind == KAXI_OP_PASS { 0 as i64 } else { 1 as i64 }
    let failure = 0 as i64
    let alpha_q8 = 16 as i64
    kaxi_flags_pack(op_kind, success, failure, alpha_q8)
}

fn hardware_publish_preview(value_bits: i64, variance_bits: i64, op_kind: i64) -> string with Alloc {
    let flags = hardware_publish_pack_flags(op_kind)
    kaxi_replay_entry_summary(value_bits, variance_bits, flags)
}

fn hardware_publish_counter_step(
    fidelity_total: i64,
    prov_total: i64,
    formal_total: i64,
    op_kind: i64
