    let flags = hardware_publish_pack_flags(op_kind)
    kaxi_hw_counter_step(fidelity_total, prov_total, formal_total, flags)
}

fn hardware_publish_self_check() -> bool with Alloc {
    let flags = hardware_publish_pack_flags(KAXI_OP_FMA)
    let summary = hardware_publish_preview(42, 7, KAXI_OP_FMA)
    let (fidelity_total, prov_total, formal_total) =
        hardware_publish_counter_step(0, 0, 0, KAXI_OP_FMA)
    let prop_flags = hardware_publish_pack_flags(KAXI_OP_PROP_VAR)
    hardware_publish_is_supported_op(KAXI_OP_FMA) &&
    hardware_publish_is_supported_op(KAXI_OP_PROP_VAR) &&
    !hardware_publish_is_supported_op(9) &&
    kaxi_flags_unpack_op_kind(flags) == KAXI_OP_FMA &&
    kaxi_flags_unpack_success_inc(flags) == 1 &&
    kaxi_flags_unpack_failure_inc(flags) == 0 &&
    kaxi_flags_unpack_alpha_q8(flags) == 16 &&
    kaxi_flags_is_valid(prop_flags) &&
    kaxi_replay_is_epistemic(prop_flags) &&
    fidelity_total == 1 &&
    prov_total == 1 &&
    formal_total == 1 &&
