// self-hosted/compiler/codegen/hardware/kaxi_emitter.sio
// Pure Sounio control emitter.
// Emits an extraction instruction so wrapper materializes template blocks from
// stdlib/hardware/kaxi.sio (single canonical source of truth).

fn main() -> i32 with IO {
    print("@@EXTRACT_TEMPLATES:stdlib/hardware/kaxi.sio\n")
    print("PURE_SOUNIO_KAXI_BUILD_OK\n")
    return 0 as i32
}
