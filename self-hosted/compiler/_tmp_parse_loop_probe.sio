use parser::ast::*
use lexer::mod::*
use io::file_write::*
use parser::parser::{parser_new, parser_reset_last_errors}

fn preflight_parse_errors(path: string) -> i64 with IO, Mut, Panic, Div, Alloc {
    let state = io_read_source_file(path)
    parser_reset_last_errors()
    var p = parser_new()
    p.token_count = state.token_count

    while !p.at_eof() {
        while p.peek() == TokenKind::Newline || p.peek() == TokenKind::Semi {
            p = p.advance()
        }
        if p.at_eof() {
            break
        }
        let before_pos = p.pos
        let pair = p.parse_item()
        let p2 = pair.0
        if p2.pos <= before_pos {
            p = p2.advance()
        } else {
            p = p2
        }
    }
    p.error_count
}

fn main() with IO, Mut, Panic, Div, Alloc {
    print_int(preflight_parse_errors("/tmp/sprint1_bad_input.sio"))
    print("\n")
}
