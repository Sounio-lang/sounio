// self-hosted::compiler::native_compile_smoke
//
// Dedicated Sprint 70 native compile smoke. Keeps the command surface small
// while exercising the same staged multimodule lowering and native backend.

use lexer::mod::*
use parser::ast::*
use ir::ir::*
use check::dependent::*
use check::types::*
use check::mod::{check_program, check_program_epistemic_into}
use check::ownership::*
use check::lint::*
use check::layout::*
use io::file_write::*
use native::aarch64::*
use native::encode::*
use native::elf::*
use native::macho::*
use native::reloc::*
use native::frame::*
use native::lower_ir::*
use native::machine_ir::*
use native::gc::*
use native::runtime_context::*
use native::stack_maps::*
use native::target_policy::*
use wasm::core::*
use wasm::encode::*
use wasm::lower::*
use native::codegen::*
use module_loader::{compile_multimodule_native, file_exists}
use parser::parser::{parser_last_error_count}
use ir::opt_strategy::{ir_opt_apply_strategy, ir_opt_find_return_vreg, ir_opt_max_label, ir_opt_max_vreg}
use ir::lower::{ir_patch_validated_calls, lower_program_to_ir, lower_program_to_ir_with_epistemic}
use ir::const_prop::{cp_check_load_imm, cp_empty_instrs, cp_make_test_func, cp_optimize_function}
use ir::dce::{dce_check_nop, dce_empty_instrs, dce_make_test_func, dce_optimize_function}
use ir::profile::*
use ir::inline::*
use ir::layout::*
use ir::opt_cleanup::*
use ir::loop_opt::*
use ir::tailcall::*
use native::regalloc::*
use native::peephole::*

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let out_path = "artifacts/sprint70/lowering_stability_native_loop_smoke.out"
    let code = compile_multimodule_native(
        "tests/frontend/lowering_stability_native_loop.sio",
        out_path,
        "",
        "",
        false,
        "",
        "",
        false
    )
    if code != 0 { return 1 }
    if parser_last_error_count() > 0 { return 2 }
    if !file_exists(out_path) { return 3 }
    print("native_compile_smoke: output=")
    print(out_path)
    print("\n")
    0
}
