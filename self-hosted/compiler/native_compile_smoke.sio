// self-hosted::compiler::native_compile_smoke
//
// Dedicated Sprint 70 native compile smoke. Uses the split streaming-native
// lane so this smoke no longer drags in the full module_loader monolith.

use native::contract::{native_resolve_target}
use module_native_streaming::{compile_multimodule_native_maybe_streaming}
use module_parse::{file_exists}
use parser::parser::{parser_last_error_count}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let out_path = "artifacts/sprint70/lowering_stability_native_loop_smoke.out"
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let pair = compile_multimodule_native_maybe_streaming(
        "tests/frontend/lowering_stability_native_loop.sio",
        spec
    )
    if pair.0 == 0 { return 1 }
    if !pair.1.ok { return 2 }
    if write_file(out_path, pair.1.bytes, pair.1.len) != 0 { return 3 }
    if parser_last_error_count() > 0 { return 4 }
    if !file_exists(out_path) { return 5 }
    print("native_compile_smoke: output=")
    print(out_path)
    print("\n")
    0
}
