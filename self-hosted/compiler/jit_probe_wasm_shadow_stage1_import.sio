use jit_probe::wasm_stage1::{wasm_buf_new, wasm_push_byte}

fn main() with IO, Mut, Panic, Div {
    let buf = wasm_buf_new()
    let buf2 = wasm_push_byte(buf, 65)
    if buf2.len == 1 {
        println("jit_wasm_shadow_stage1_ok")
    } else {
        println("jit_wasm_shadow_stage1_bad")
    }
}
