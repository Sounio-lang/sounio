use check::mod::{
    check_ontology_side_table_cache_disjoint_verdict_probe,
    check_ontology_side_table_cache_subclass_verdict_probe,
}

fn main() -> i64 with IO, Mut, Panic, Div {
    print("k2_check_mod_ontology_cache_directive_probe=start\n")
    let argc = arg_count()
    if argc < 1 {
        print("usage: k2_check_mod_ontology_cache_directive_probe <cache-consumer-source>\n")
        return 2
    }

    let source_path = get_arg(0)
    let snomed_ok = check_ontology_side_table_cache_subclass_verdict_probe(source_path, 73211009, 138875005)
    let snomed_reject = check_ontology_side_table_cache_subclass_verdict_probe(source_path, 138875005, 73211009)
    let part_subclass_ok = check_ontology_side_table_cache_subclass_verdict_probe(source_path, 4, 2)
    let part_subclass_reject = check_ontology_side_table_cache_subclass_verdict_probe(source_path, 2, 4)
    let part_disjoint_ok = check_ontology_side_table_cache_disjoint_verdict_probe(source_path, 3, 12)
    let part_disjoint_reject = check_ontology_side_table_cache_disjoint_verdict_probe(source_path, 2, 4)

    print("check_mod_cache_verdict_snomed_73211009_subclass_138875005=")
    print_int(snomed_ok)
    print("\n")
    print("check_mod_cache_verdict_snomed_138875005_subclass_73211009=")
    print_int(snomed_reject)
    print("\n")
    print("check_mod_cache_verdict_part_4_subclass_2=")
    print_int(part_subclass_ok)
    print("\n")
    print("check_mod_cache_verdict_part_2_subclass_4=")
    print_int(part_subclass_reject)
    print("\n")
    print("check_mod_cache_verdict_part_3_disjoint_12=")
    print_int(part_disjoint_ok)
    print("\n")
    print("check_mod_cache_verdict_part_2_disjoint_4=")
    print_int(part_disjoint_reject)
    print("\n")

    print("k2_check_mod_ontology_cache_directive_probe=ok\n")
    0
}
