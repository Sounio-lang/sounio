// self-hosted::compiler::module_native_simple_driver
//
// Minimal imported-simple-IR native writer for the modular lean CLI.
// Keep this file free of the full native codegen imports: lean.sio must be
// runnable for frontend probes without paying the heavy backend/global-init cost.

use module_frontend::{
    imported_simple_ir_global_fn_count,
    imported_simple_ir_global_fn_kind,
    imported_simple_ir_global_fn_name_hash,
    imported_simple_ir_global_fn_target_hash,
    imported_simple_ir_global_fn_value,
    load_multimodule_imported_simple_ir_global,
    module_frontend_file_maybe_has_use
}

fn simple_driver_put_u8(buf: &![i8; 131072], pos: i64, val: i64) with Mut, Panic {
    (*buf)[pos] = (val & 255) as i8
}

fn simple_driver_put_u16(buf: &![i8; 131072], pos: i64, val: i64) with Mut, Panic, Div {
    simple_driver_put_u8(buf, pos, val)
    simple_driver_put_u8(buf, pos + 1, val >> 8)
}

fn simple_driver_put_u32(buf: &![i8; 131072], pos: i64, val: i64) with Mut, Panic, Div {
    simple_driver_put_u8(buf, pos, val)
    simple_driver_put_u8(buf, pos + 1, val >> 8)
    simple_driver_put_u8(buf, pos + 2, val >> 16)
    simple_driver_put_u8(buf, pos + 3, val >> 24)
}

fn simple_driver_put_u64(buf: &![i8; 131072], pos: i64, val: i64) with Mut, Panic, Div {
    simple_driver_put_u32(buf, pos, val)
    simple_driver_put_u32(buf, pos + 4, val >> 32)
}

fn simple_driver_find_fn(name: string) -> i64 with Panic {
    var name_hash: i64 = 5381
    var ni: i64 = 0
    while ni < str_len(name) {
        name_hash = (name_hash * 33) + str_char_at(name, ni)
        ni = ni + 1
    }
    var fi: i64 = 0
    let count = imported_simple_ir_global_fn_count()
    while fi < count {
        if imported_simple_ir_global_fn_name_hash(fi) == name_hash {
            return fi
        }
        fi = fi + 1
    }
    -1
}

fn simple_driver_fn_size(fi: i64) -> i64 with Panic {
    let kind = imported_simple_ir_global_fn_kind(fi)
    if kind == 1 || kind == 2 {
        return 6
    }
    if kind == 3 {
        return 27
    }
    if kind == 4 {
        return 7
    }
    if kind == 5 {
        return 5
    }
    if kind == 6 {
        return 9
    }
    if kind == 7 {
        return 11
    }
    if kind == 8 {
        return 4
    }
    if kind == 10 {
        return 32
    }
    if kind == 11 {
        return 36
    }
    if kind == 12 {
        return 10
    }
    if kind == 13 || kind == 14 {
        return 7
    }
    if kind == 15 {
        return 12
    }
    if kind == 16 || kind == 17 {
        return 27
    }
    if kind == 18 {
        return 124
    }
    if kind == 20 {
        return 38
    }
    if kind == 23 {
        return 75
    }
    if kind == 9 {
        return 16
    }
    if kind == 24 {
        return 16
    }
    -1
}

fn simple_driver_fn_offset(func_start: i64, idx: i64) -> i64 with Panic {
    var off = func_start
    var i: i64 = 0
    while i < idx {
        off = off + simple_driver_fn_size(i)
        i = i + 1
    }
    off
}

fn simple_driver_has_print() -> bool with Panic {
    var fi: i64 = 0
    let count = imported_simple_ir_global_fn_count()
    while fi < count {
        if imported_simple_ir_global_fn_kind(fi) == 3 {
            return true
        }
        fi = fi + 1
    }
    false
}

fn simple_driver_emit_fn(
    fi: i64,
    func_start: i64,
    data_off: i64,
    bytes: &![i8; 131072]
) -> bool with Mut, Panic, Div {
    let kind = imported_simple_ir_global_fn_kind(fi)
    let off = simple_driver_fn_offset(func_start, fi)
    if kind == 1 {
        let target_hash = imported_simple_ir_global_fn_target_hash(fi)
        var target: i64 = 0 - 1
        var ti: i64 = 0
        let count = imported_simple_ir_global_fn_count()
        while ti < count {
            if imported_simple_ir_global_fn_name_hash(ti) == target_hash {
                target = ti
                ti = count
            } else {
                ti = ti + 1
            }
        }
        if target < 0 || target >= imported_simple_ir_global_fn_count() {
            return false
        }
        let target_off = simple_driver_fn_offset(func_start, target)
        let rel = target_off - (off + 5)
        simple_driver_put_u8(bytes, off, 232)
        simple_driver_put_u32(bytes, off + 1, rel)
        simple_driver_put_u8(bytes, off + 5, 195)
        return true
    }
    if kind == 2 {
        simple_driver_put_u8(bytes, off, 184)
        simple_driver_put_u32(bytes, off + 1, imported_simple_ir_global_fn_value(fi))
        simple_driver_put_u8(bytes, off + 5, 195)
        return true
    }
    if kind == 3 {
        simple_driver_put_u8(bytes, off, 184)
        simple_driver_put_u32(bytes, off + 1, 1)
        simple_driver_put_u8(bytes, off + 5, 191)
        simple_driver_put_u32(bytes, off + 6, 1)
        simple_driver_put_u8(bytes, off + 10, 72)
        simple_driver_put_u8(bytes, off + 11, 141)
        simple_driver_put_u8(bytes, off + 12, 53)
        simple_driver_put_u32(bytes, off + 13, data_off - (off + 17))
        simple_driver_put_u8(bytes, off + 17, 186)
        simple_driver_put_u32(bytes, off + 18, 3)
        simple_driver_put_u8(bytes, off + 22, 15)
        simple_driver_put_u8(bytes, off + 23, 5)
        simple_driver_put_u8(bytes, off + 24, 49)
        simple_driver_put_u8(bytes, off + 25, 192)
        simple_driver_put_u8(bytes, off + 26, 195)
        return true
    }
    if kind == 4 {
        simple_driver_put_u8(bytes, off, 72)
        simple_driver_put_u8(bytes, off + 1, 137)
        simple_driver_put_u8(bytes, off + 2, 248)
        simple_driver_put_u8(bytes, off + 3, 72)
        simple_driver_put_u8(bytes, off + 4, 1)
        simple_driver_put_u8(bytes, off + 5, 248)
        simple_driver_put_u8(bytes, off + 6, 195)
        return true
    }
    if kind == 5 {
        simple_driver_put_u8(bytes, off, 72)
        simple_driver_put_u8(bytes, off + 1, 141)
        simple_driver_put_u8(bytes, off + 2, 71)
        simple_driver_put_u8(bytes, off + 3, 1)
        simple_driver_put_u8(bytes, off + 4, 195)
        return true
    }
    if kind == 6 {
        simple_driver_put_u8(bytes, off, 72)
        simple_driver_put_u8(bytes, off + 1, 137)
        simple_driver_put_u8(bytes, off + 2, 248)
        simple_driver_put_u8(bytes, off + 3, 72)
        simple_driver_put_u8(bytes, off + 4, 137)
        simple_driver_put_u8(bytes, off + 5, 247)
        simple_driver_put_u8(bytes, off + 6, 255)
        simple_driver_put_u8(bytes, off + 7, 208)
        simple_driver_put_u8(bytes, off + 8, 195)
        return true
    }
    if kind == 7 {
        let double_fn = simple_driver_find_fn("double")
        if double_fn < 0 {
            return false
        }
        simple_driver_put_u8(bytes, off, 72)
        simple_driver_put_u8(bytes, off + 1, 184)
        simple_driver_put_u64(bytes, off + 2, 4194304 + simple_driver_fn_offset(func_start, double_fn))
        simple_driver_put_u8(bytes, off + 10, 195)
        return true
    }
    if kind == 8 {
        simple_driver_put_u8(bytes, off, 72)
        simple_driver_put_u8(bytes, off + 1, 137)
        simple_driver_put_u8(bytes, off + 2, 248)
        simple_driver_put_u8(bytes, off + 3, 195)
        return true
    }
    if kind == 10 {
        let select_fn = simple_driver_find_fn("select_unary")
        let pass_fn = simple_driver_find_fn("pass_through")
        let entry_fn = simple_driver_find_fn("entry")
        if select_fn < 0 || pass_fn < 0 || entry_fn < 0 {
            return false
        }
        let select_off = simple_driver_fn_offset(func_start, select_fn)
        let pass_off = simple_driver_fn_offset(func_start, pass_fn)
        let entry_off = simple_driver_fn_offset(func_start, entry_fn)
        simple_driver_put_u8(bytes, off, 191)
        simple_driver_put_u32(bytes, off + 1, 0)
        simple_driver_put_u8(bytes, off + 5, 232)
        simple_driver_put_u32(bytes, off + 6, select_off - (off + 10))
        simple_driver_put_u8(bytes, off + 10, 72)
        simple_driver_put_u8(bytes, off + 11, 137)
        simple_driver_put_u8(bytes, off + 12, 199)
        simple_driver_put_u8(bytes, off + 13, 232)
        simple_driver_put_u32(bytes, off + 14, pass_off - (off + 18))
        simple_driver_put_u8(bytes, off + 18, 72)
        simple_driver_put_u8(bytes, off + 19, 137)
        simple_driver_put_u8(bytes, off + 20, 199)
        simple_driver_put_u8(bytes, off + 21, 190)
        simple_driver_put_u32(bytes, off + 22, 21)
        simple_driver_put_u8(bytes, off + 26, 232)
        simple_driver_put_u32(bytes, off + 27, entry_off - (off + 31))
        simple_driver_put_u8(bytes, off + 31, 195)
        return true
    }
    if kind == 11 {
        let select_fn = simple_driver_find_fn("select_unary")
        let pass_fn = simple_driver_find_fn("pass_through")
        let entry_fn = simple_driver_find_fn("entry")
        if select_fn < 0 || pass_fn < 0 || entry_fn < 0 {
            return false
        }
        let select_off = simple_driver_fn_offset(func_start, select_fn)
        let pass_off = simple_driver_fn_offset(func_start, pass_fn)
        let entry_off = simple_driver_fn_offset(func_start, entry_fn)
