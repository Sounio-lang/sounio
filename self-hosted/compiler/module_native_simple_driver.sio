        simple_driver_put_u8(bytes, off + 27, 137)
        simple_driver_put_u8(bytes, off + 28, 199)
        simple_driver_put_u8(bytes, off + 29, 190)
        simple_driver_put_u32(bytes, off + 30, 10)
        simple_driver_put_u8(bytes, off + 34, 232)
        simple_driver_put_u32(bytes, off + 35, apply_off - (off + 39))
        simple_driver_put_u8(bytes, off + 39, 72)
        simple_driver_put_u8(bytes, off + 40, 137)
        simple_driver_put_u8(bytes, off + 41, 195)
        simple_driver_put_u8(bytes, off + 42, 76)
        simple_driver_put_u8(bytes, off + 43, 137)
        simple_driver_put_u8(bytes, off + 44, 207)
        simple_driver_put_u8(bytes, off + 45, 190)
        simple_driver_put_u32(bytes, off + 46, 7)
        simple_driver_put_u8(bytes, off + 50, 232)
        simple_driver_put_u32(bytes, off + 51, apply_off - (off + 55))
        simple_driver_put_u8(bytes, off + 55, 72)
        simple_driver_put_u8(bytes, off + 56, 1)
        simple_driver_put_u8(bytes, off + 57, 195)
        simple_driver_put_u8(bytes, off + 58, 76)
        simple_driver_put_u8(bytes, off + 59, 137)
        simple_driver_put_u8(bytes, off + 60, 199)
        simple_driver_put_u8(bytes, off + 61, 190)
        simple_driver_put_u32(bytes, off + 62, 5)
        simple_driver_put_u8(bytes, off + 66, 232)
        simple_driver_put_u32(bytes, off + 67, apply_off - (off + 71))
        simple_driver_put_u8(bytes, off + 71, 72)
        simple_driver_put_u8(bytes, off + 72, 1)
        simple_driver_put_u8(bytes, off + 73, 216)
        simple_driver_put_u8(bytes, off + 74, 195)
        return true
    }
    if kind == 9 {
        let target_hash = imported_simple_ir_global_fn_target_hash(fi)
        var target: i64 = 0 - 1
        var ti: i64 = 0
        let count = imported_simple_ir_global_fn_count()
        while ti < count {
            if imported_simple_ir_global_fn_name_hash(ti) == target_hash {
                target = ti
                ti = count
            } else {
                ti = ti + 1
            }
        }
        if target < 0 || target >= imported_simple_ir_global_fn_count() {
            return false
        }
        let target_off = simple_driver_fn_offset(func_start, target)
        let packed = imported_simple_ir_global_fn_value(fi)
        let arg0 = packed >> 32
        let arg1 = packed & 4294967295
        simple_driver_put_u8(bytes, off, 191)
        simple_driver_put_u32(bytes, off + 1, arg0)
        simple_driver_put_u8(bytes, off + 5, 190)
        simple_driver_put_u32(bytes, off + 6, arg1)
        simple_driver_put_u8(bytes, off + 10, 232)
        simple_driver_put_u32(bytes, off + 11, target_off - (off + 15))
        simple_driver_put_u8(bytes, off + 15, 195)
        return true
    }
    if kind == 24 {
        let target_hash = imported_simple_ir_global_fn_target_hash(fi)
        var target: i64 = 0 - 1
        var ti: i64 = 0
        let count = imported_simple_ir_global_fn_count()
        while ti < count {
            if imported_simple_ir_global_fn_name_hash(ti) == target_hash {
                target = ti
                ti = count
            } else {
                ti = ti + 1
            }
        }
        if target < 0 || target >= imported_simple_ir_global_fn_count() {
            return false
        }
        let packed = imported_simple_ir_global_fn_value(fi)
        let arg0 = packed / 1000000
        let arg1 = packed - (arg0 * 1000000)
        let target_off = simple_driver_fn_offset(func_start, target)
        simple_driver_put_u8(bytes, off, 191)
        simple_driver_put_u32(bytes, off + 1, arg0)
        simple_driver_put_u8(bytes, off + 5, 190)
        simple_driver_put_u32(bytes, off + 6, arg1)
        simple_driver_put_u8(bytes, off + 10, 232)
        simple_driver_put_u32(bytes, off + 11, target_off - (off + 15))
        simple_driver_put_u8(bytes, off + 15, 195)
        return true
    }
    false
}

fn simple_driver_write_imported_simple_ir_elf(output_path: string) -> i32 with IO, Mut, Panic, Div {
    var bytes: [i8; 131072] = [0; 131072]
    let code_off: i64 = 120
    let func_start: i64 = code_off + 14
    let fn_count = imported_simple_ir_global_fn_count()
    let main_fn = simple_driver_find_fn("main")
    if main_fn < 0 {
        print("Native compilation failed: imported_simple_ir_missing_main\n")
        return 1
    }

    var fi: i64 = 0
    while fi < fn_count {
        let fn_size = simple_driver_fn_size(fi)
        if fn_size < 0 {
            print("Native compilation failed: imported_simple_ir_unsupported_function_shape index=")
            print_int(fi)
            print(" kind=")
            print_int(imported_simple_ir_global_fn_kind(fi))
            print("\n")
            return 1
        }
        fi = fi + 1
    }
    let code_len: i64 = simple_driver_fn_offset(func_start, fn_count)
    let data_off: i64 = code_len
    let file_len: i64 = if simple_driver_has_print() { code_len + 3 } else { code_len }

    simple_driver_put_u8(&! bytes, 0, 127)
    simple_driver_put_u8(&! bytes, 1, 69)
    simple_driver_put_u8(&! bytes, 2, 76)
    simple_driver_put_u8(&! bytes, 3, 70)
    simple_driver_put_u8(&! bytes, 4, 2)
    simple_driver_put_u8(&! bytes, 5, 1)
    simple_driver_put_u8(&! bytes, 6, 1)
    simple_driver_put_u16(&! bytes, 16, 2)
    simple_driver_put_u16(&! bytes, 18, 62)
    simple_driver_put_u32(&! bytes, 20, 1)
    simple_driver_put_u64(&! bytes, 24, 4194304 + code_off)
    simple_driver_put_u64(&! bytes, 32, 64)
    simple_driver_put_u32(&! bytes, 48, 0)
    simple_driver_put_u16(&! bytes, 52, 64)
    simple_driver_put_u16(&! bytes, 54, 56)
    simple_driver_put_u16(&! bytes, 56, 1)

    simple_driver_put_u32(&! bytes, 64, 1)
    simple_driver_put_u32(&! bytes, 68, 5)
    simple_driver_put_u64(&! bytes, 72, 0)
    simple_driver_put_u64(&! bytes, 80, 4194304)
    simple_driver_put_u64(&! bytes, 88, 4194304)
    simple_driver_put_u64(&! bytes, 96, file_len)
    simple_driver_put_u64(&! bytes, 104, file_len)
    simple_driver_put_u64(&! bytes, 112, 4096)

    simple_driver_put_u8(&! bytes, code_off, 232)
    simple_driver_put_u32(&! bytes, code_off + 1, simple_driver_fn_offset(func_start, main_fn) - (code_off + 5))
    simple_driver_put_u8(&! bytes, code_off + 5, 137)
    simple_driver_put_u8(&! bytes, code_off + 6, 199)
    simple_driver_put_u8(&! bytes, code_off + 7, 184)
    simple_driver_put_u32(&! bytes, code_off + 8, 60)
    simple_driver_put_u8(&! bytes, code_off + 12, 15)
    simple_driver_put_u8(&! bytes, code_off + 13, 5)

    fi = 0
    while fi < fn_count {
        if !simple_driver_emit_fn(fi, func_start, data_off, &! bytes) {
            print("Native compilation failed: imported_simple_ir_emit_failed\n")
            return 1
        }
        fi = fi + 1
    }

    if simple_driver_has_print() {
        simple_driver_put_u8(&! bytes, data_off, 52)
        simple_driver_put_u8(&! bytes, data_off + 1, 50)
        simple_driver_put_u8(&! bytes, data_off + 2, 10)
    }

    if write_file(output_path, bytes, file_len) < 0 {
        print("Error: Failed to write native binary to ")
        print(output_path)
        print("\n")
        return 1
    }
    print("Native binary size: ")
    print_int(file_len)
    print(" bytes\n")
    print("Written to ")
    print(output_path)
    print("\n")
    0
}

pub fn compile_imported_simple_native_advanced(
    main_path: string,
    output_path: string,
    requested_target: string,
    requested_matrix: string,
    gpu_target: string,
    gpu_binary_format: string,
    gpu_strict_parity: bool,
    optimize: bool,
    use_profile: bool,
    use_profile_path: string,
    cache_dir: string,
    cache_mode: string,
    cache_stats: bool
) -> i32 with IO, Mut, Div, Panic {
    if requested_target == "wasm" {
        print("WASM backend is unavailable in module_native_simple_driver: ")
        print(main_path)
        print("\n")
        return 1
    }
    if optimize || use_profile || str_len(use_profile_path) > 0 || str_len(cache_dir) > 0 || cache_stats {
        print("module_native_driver: optimizer/profile/cache lane not split yet; using uncached modular path\n")
    }
    if str_len(cache_mode) > 0 && cache_mode != "off" {
        print("module_native_driver: cache_mode ignored until thin-link parity lands\n")
    }

    print("Native dispatch: requested=")
    print(requested_target)
    print(" resolved=x86_64-linux matrix=")
    print(requested_matrix)
    if str_len(gpu_target) > 0 {
        print(" gpu_target=")
        print(gpu_target)
    }
    if str_len(gpu_binary_format) > 0 {
        print(" gpu_binary_format=")
        print(gpu_binary_format)
    }
    print(" gpu_strict_parity=")
    if gpu_strict_parity {
        print("true")
    } else {
        print("false")
    }
    print("\n")

    if !module_frontend_file_maybe_has_use(main_path) {
        print("module_native_driver: non-imported source requires full native driver split\n")
        return 1
    }

    print("module_native_driver: imported source uses modular IR path\n")
    print("module_native_driver: imported source uses compact modular IR table path\n")
    let imported_ir_status = load_multimodule_imported_simple_ir_global(main_path)
    if imported_ir_status.ok {
        return simple_driver_write_imported_simple_ir_elf(output_path)
    }
    print("module_native_driver: compact IR load failed: ")
    print(imported_ir_status.error_msg)
    print("\n")
    1
}
