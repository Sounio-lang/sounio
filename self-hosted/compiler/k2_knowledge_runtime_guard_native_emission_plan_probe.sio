use knowledge_runtime_guard_lowering_plan::{knowledge_runtime_guard_native_emission_plan_at}

fn print_bool_digit(value: bool) with IO {
    if value {
        print("1")
    } else {
        print("0")
    }
}

fn parse_dec_arg(s: string) -> i64 with Mut, Panic, Div {
    var v: i64 = 0
    var i: i64 = 0
    let n = str_len(s)
    while i < n {
        let c = str_char_at(s, i)
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48)
        }
        i = i + 1
    }
    v
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    var path = "tests/frontend/knowledge_runtime_guard_directive_positive.sio"
    if argc >= 1 {
        path = get_arg(0)
    }
    var row_index: i64 = 0
    if argc >= 2 {
        row_index = parse_dec_arg(get_arg(1))
    }

    let plan = knowledge_runtime_guard_native_emission_plan_at(path, row_index)
    print("knowledge_runtime_guard_native_emission_row_index=")
    print_int(plan.row_index)
    print(" plan_ready=")
    print_bool_digit(plan.plan_ready)
    print(" source_valid=")
    print_bool_digit(plan.source_valid)
    print(" in_bounds=")
    print_bool_digit(plan.in_bounds)
    print(" runtime_obligation_count=")
    print_int(plan.runtime_obligation_count)
    print(" needs_value_register=")
    print_bool_digit(plan.needs_value_register)
    print(" threshold_kind=")
    print_int(plan.threshold_kind)
    print(" threshold_int_value=")
    print_int(plan.threshold_int_value)
    print(" threshold_float_value=")
    print_f64(plan.threshold_float_value)
    print(" threshold_scaled_value=")
    print_int(plan.threshold_scaled_value)
    print(" threshold_scale=")
    print_int(plan.threshold_scale)
    print(" native_cmp_code=")
    print_int(plan.native_cmp_code)
    print(" native_trap_builtin_id=")
    print_int(plan.native_trap_builtin_id)
    print(" native_trap_on_false=")
    print_bool_digit(plan.native_trap_on_false)
    print(" emit_load_threshold=")
    print_bool_digit(plan.emit_load_threshold)
    print(" emit_compare_value_threshold=")
    print_bool_digit(plan.emit_compare_value_threshold)
    print(" emit_load_zero=")
    print_bool_digit(plan.emit_load_zero)
    print(" emit_eq_zero=")
    print_bool_digit(plan.emit_eq_zero)
    print(" emit_branch_false_to_ok=")
    print_bool_digit(plan.emit_branch_false_to_ok)
    print(" emit_trap_call=")
    print_bool_digit(plan.emit_trap_call)
    print(" emit_ok_label=")
    print_bool_digit(plan.emit_ok_label)
    print(" emit_divide_value_by_threshold=")
    print_bool_digit(plan.emit_divide_value_by_threshold)
    print(" emit_load_one=")
    print_bool_digit(plan.emit_load_one)
    print(" zero_cmp_code=")
    print_int(plan.zero_cmp_code)
    print(" native_step_count=")
    print_int(plan.native_step_count)
    print("\n")
    0
}
