}

// mov rax, [rdi]  (48 8B 07)
fn drv_emit_load_rax_from_rdi() with Mut, Div, Panic {
    drv_emit_byte(72)
    drv_emit_byte(139)
    drv_emit_byte(7)
}

// mov [rdi], rax  (48 89 07)
fn drv_emit_store_rax_to_rdi() with Mut, Div, Panic {
    drv_emit_byte(72)
