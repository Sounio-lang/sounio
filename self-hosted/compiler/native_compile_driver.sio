    if token_text_eq(tok, "V2_GLOBAL_DRV_FN_OFFSETS") { return 61 }
    if token_text_eq(tok, "V2_GLOBAL_DRV_FN_COUNT") { return 62 }
    if token_text_eq(tok, "V2_GLOBAL_DRV_ENTRY_OFFSET") { return 63 }
    if token_text_eq(tok, "V2_GLOBAL_DRV_LABEL_OFFSETS") { return 64 }
    if token_text_eq(tok, "V2_GLOBAL_DRV_LABEL_PATCH_OFFSETS") { return 65 }
    if token_text_eq(tok, "V2_GLOBAL_DRV_LABEL_PATCH_IDS") { return 66 }
    if token_text_eq(tok, "V2_GLOBAL_DRV_LABEL_PATCH_COUNT") { return 67 }
    if token_text_eq(tok, "V2_GLOBAL_DRV_ELF_BYTES") { return 68 }
    if token_text_eq(tok, "V2_GLOBAL_DRV_ELF_LEN") { return 69 }
    if token_text_eq(tok, "V2_GLOBAL_UFN_FLOAT_SCALE") { return 74 }
    if token_text_eq(tok, "V2_GLOBAL_REG_IS_F64") { return 75 }
    if token_text_eq(tok, "V2_GLOBAL_STRUCT_FIELD_IS_F64") { return 76 }
    if token_text_eq(tok, "V2_GLOBAL_USER_FN_RETURN_IS_F64") { return 77 }
    if token_text_eq(tok, "V2_GLOBAL_STRUCT_FIELD_GENERIC_F64") { return 78 }
    if token_text_eq(tok, "V2_GLOBAL_EP_TOTAL_INSTR") { return 79 }
    if token_text_eq(tok, "V2_GLOBAL_EP_KNOWLEDGE_COUNT") { return 80 }
    -999999999
}

fn skip_index_cast_end(pos: i64) -> i64 with Panic {
    if token_kind(pos) == TK_AS {
        return pos + 2
    }
    pos
}

fn token_string_name(idx: i64) -> Name with Mut, Panic, Div {
    var n = empty_name()
    var i = pt_read_start(idx) + 1
    let end = pt_read_end(idx) - 1
    while i < end && n.len < 128 {
        let ch = CURSOR_SOURCE[i as usize]
        if ch == 92 as i8 && i + 1 < end {
            let esc = CURSOR_SOURCE[(i + 1) as usize]
            if esc == 110 as i8 { n.buf[n.len as usize] = 10 as i8 }
            else if esc == 116 as i8 { n.buf[n.len as usize] = 9 as i8 }
            else if esc == 114 as i8 { n.buf[n.len as usize] = 13 as i8 }
            else if esc == 34 as i8 { n.buf[n.len as usize] = 34 as i8 }
            else if esc == 92 as i8 { n.buf[n.len as usize] = 92 as i8 }
            else { n.buf[n.len as usize] = esc }
            n.len = n.len + 1
            i = i + 2
        } else {
            n.buf[n.len as usize] = ch
            n.len = n.len + 1
            i = i + 1
        }
    }
    n
}

fn alloc_reg(ctx: &! V2DriverContext) -> i64 with Mut {
    let r = V2_NEXT_REG
    V2_NEXT_REG = r + 1
    r
}

fn alloc_label() -> i64 with Mut {
    let l = V2_NEXT_LABEL
    V2_NEXT_LABEL = l + 1
    l
}

fn reset_user_fn_label_state() with Mut {
    V2_NEXT_LABEL = 0
}

fn reset_parse_unsupported() with Mut {
    V2_PARSE_UNSUPPORTED = 0
    V2_PARSE_UNSUPPORTED_TOKEN = -1
    V2_PARSE_UNSUPPORTED_KIND = -1
    V2_PARSE_UNSUPPORTED_REASON = 0
}

fn mark_parse_unsupported(pos: i64) with Mut, Panic {
    if V2_PARSE_UNSUPPORTED == 0 {
        V2_PARSE_UNSUPPORTED = 1
        V2_PARSE_UNSUPPORTED_TOKEN = pos
        V2_PARSE_UNSUPPORTED_KIND = token_kind(pos)
    }
}

fn mark_parse_unsupported_call(pos: i64) with Mut, Panic {
    if V2_PARSE_UNSUPPORTED == 0 {
        V2_PARSE_UNSUPPORTED_REASON = 1
        mark_parse_unsupported(pos)
    }
}

fn register_user_fn(token_idx: i64, fn_id: i64) with Mut, Panic {
    let idx = V2_USER_FN_COUNT
    if idx < 512 {
        V2_USER_FN_TOKEN_IDX[idx as usize] = token_idx
        V2_USER_FN_IDS[idx as usize] = fn_id
        V2_USER_FN_COUNT = idx + 1
    }
}

fn lookup_user_fn_id(name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < V2_USER_FN_COUNT {
        let tok = V2_USER_FN_TOKEN_IDX[i as usize]
        if name_eq(token_name(tok), name) {
            return V2_USER_FN_IDS[i as usize]
        }
        i = i + 1
    }
    -1
}

fn lookup_user_fn_id_tok(name_tok: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < V2_USER_FN_COUNT {
        let tok = V2_USER_FN_TOKEN_IDX[i as usize]
        if toks_ident_eq(tok, name_tok) {
            return V2_USER_FN_IDS[i as usize]
        }
        i = i + 1
    }
    -1
}

fn user_fn_name_at(idx: i64) -> Name with Mut, Panic, Div {
    token_name(V2_USER_FN_TOKEN_IDX[idx as usize])
}

fn skip_trivia(pos: i64, close: i64) -> i64 with Mut, Panic {
    var p = pos
    while p < close {
        let k = token_kind(p)
        if k == TK_NEWLINE || k == TK_SEMI { p = p + 1 }
        else { break }
    }
    p
}

// ============================================================
// Struct layout pre-scanner
// ============================================================

fn find_ident_token_text(token_count: i64, text: string) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < token_count {
        if token_kind(i) == TK_IDENT && token_text_eq(i, text) {
            return i
        }
        i = i + 1
    }
    -1
}

fn find_name_struct_idx() -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < STRUCT_COUNT {
        if token_text_eq(STRUCT_NAME_TOKS[i as usize], "Name") {
            return i
        }
        i = i + 1
    }
    -1
}

fn register_builtin_name_struct(token_count: i64) with Mut, Panic, Div {
    if find_name_struct_idx() >= 0 { return }
    let name_tok = find_ident_token_text(token_count, "Name")
    let buf_tok = find_ident_token_text(token_count, "buf")
    let len_tok = find_ident_token_text(token_count, "len")
    if name_tok < 0 || buf_tok < 0 || len_tok < 0 { return }
    if STRUCT_COUNT >= 16 || STRUCT_FIELD_TOTAL + 2 >= 128 { return }
    let sidx = STRUCT_COUNT
    let fstart = STRUCT_FIELD_TOTAL
    STRUCT_NAME_TOKS[sidx as usize] = name_tok
    STRUCT_FIELD_START[sidx as usize] = fstart
    STRUCT_FIELD_COUNT[sidx as usize] = 2
    STRUCT_FLAT_SIZE[sidx as usize] = 129
    STRUCT_FIELDS[fstart as usize] = buf_tok
    STRUCT_FIELD_STRUCT_IDX[fstart as usize] = -1
    STRUCT_FIELD_FLAT_OFFSET[fstart as usize] = 0
    STRUCT_FIELDS[(fstart + 1) as usize] = len_tok
    STRUCT_FIELD_STRUCT_IDX[(fstart + 1) as usize] = -1
    STRUCT_FIELD_FLAT_OFFSET[(fstart + 1) as usize] = 128
    STRUCT_FIELD_TOTAL = fstart + 2
    STRUCT_COUNT = sidx + 1
}

fn scan_struct_decls(token_count: i64) with Mut, Panic, Div {
    STRUCT_COUNT = 0
    STRUCT_FIELD_TOTAL = 0
    var i: i64 = 0
    while i + 1 < token_count {
        if token_kind(i) == TK_STRUCT && token_kind(i + 1) == TK_IDENT {
            let sidx = STRUCT_COUNT
            if sidx < 16 {
                STRUCT_NAME_TOKS[sidx as usize] = i + 1
                STRUCT_FIELD_START[sidx as usize] = STRUCT_FIELD_TOTAL
                STRUCT_FIELD_COUNT[sidx as usize] = 0
                STRUCT_COUNT = sidx + 1
                var j = i + 2
                while j < token_count && token_kind(j) != TK_LBRACE { j = j + 1 }
                j = j + 1
                while j < token_count && token_kind(j) != TK_RBRACE {
                    let kj = token_kind(j)
                    if kj == TK_IDENT && STRUCT_FIELD_TOTAL < 128 {
                        STRUCT_FIELDS[STRUCT_FIELD_TOTAL as usize] = j
                        STRUCT_FIELD_TOTAL = STRUCT_FIELD_TOTAL + 1
                        STRUCT_FIELD_COUNT[sidx as usize] = STRUCT_FIELD_COUNT[sidx as usize] + 1
                        j = j + 1
                        while j < token_count && token_kind(j) != TK_COMMA && token_kind(j) != TK_RBRACE { j = j + 1 }
                        if j < token_count && token_kind(j) == TK_COMMA { j = j + 1 }
                    } else if kj == TK_NEWLINE || kj == TK_SEMI {
                        j = j + 1
                    } else {
                        j = j + 1
                    }
                }
                i = j + 1
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    scan_struct_field_types(token_count)
    compute_struct_flat_sizes()
    register_builtin_name_struct(token_count)
}

// Second pass: determine each field's type (struct or scalar) and flat offsets
fn scan_struct_field_types(token_count: i64) with Mut, Panic, Div {
    var fi: i64 = 0
    while fi < STRUCT_FIELD_TOTAL {
        let name_tok = STRUCT_FIELDS[fi as usize]
        var type_sidx: i64 = -1
        STRUCT_FIELD_IS_F64[fi as usize] = 0
        STRUCT_FIELD_GENERIC_F64[fi as usize] = 0
        if name_tok + 2 < token_count {
            if token_kind(name_tok + 1) == TK_COLON && token_kind(name_tok + 2) == TK_IDENT {
                type_sidx = find_struct_idx_tok(name_tok + 2)
                if token_text_eq(name_tok + 2, "f64") {
                    STRUCT_FIELD_IS_F64[fi as usize] = 1
                }
                if name_tok + 5 < token_count && token_kind(name_tok + 3) == TK_LT && token_kind(name_tok + 4) == TK_IDENT && token_kind(name_tok + 5) == TK_GT && token_text_eq(name_tok + 4, "f64") {
                    STRUCT_FIELD_GENERIC_F64[fi as usize] = 1
                }
            }
        }
        STRUCT_FIELD_STRUCT_IDX[fi as usize] = type_sidx
        fi = fi + 1
    }
}

// Compute flattened register counts and offsets (iterate to handle forward refs)
fn compute_struct_flat_sizes() with Mut {
    var si: i64 = 0
    while si < STRUCT_COUNT {
        STRUCT_FLAT_SIZE[si as usize] = STRUCT_FIELD_COUNT[si as usize]
        si = si + 1
    }
    var iter: i64 = 0
    while iter < STRUCT_COUNT {
        si = 0
        while si < STRUCT_COUNT {
            let start = STRUCT_FIELD_START[si as usize]
            let count = STRUCT_FIELD_COUNT[si as usize]
            var flat: i64 = 0
            var fi: i64 = 0
            while fi < count {
                let abs_fi = start + fi
                STRUCT_FIELD_FLAT_OFFSET[abs_fi as usize] = flat
                let fsidx = STRUCT_FIELD_STRUCT_IDX[abs_fi as usize]
                if fsidx >= 0 {
                    flat = flat + STRUCT_FLAT_SIZE[fsidx as usize]
                } else {
                    flat = flat + 1
                }
                fi = fi + 1
            }
            STRUCT_FLAT_SIZE[si as usize] = flat
            si = si + 1
        }
        iter = iter + 1
    }
}

// Enum pre-scanner
fn scan_enum_decls(token_count: i64) with Mut, Panic {
    ENUM_COUNT = 0
    ENUM_VARIANT_TOTAL = 0
    var i: i64 = 0
    while i + 1 < token_count {
        if token_kind(i) == TK_ENUM && token_kind(i + 1) == TK_IDENT {
            let eidx = ENUM_COUNT
            if eidx < 16 {
                ENUM_NAME_TOKS[eidx as usize] = i + 1
                ENUM_VARIANT_START[eidx as usize] = ENUM_VARIANT_TOTAL
                ENUM_VARIANT_COUNT[eidx as usize] = 0
                ENUM_COUNT = eidx + 1
                var j = i + 2
                while j < token_count && token_kind(j) != TK_LBRACE { j = j + 1 }
                j = j + 1
                while j < token_count && token_kind(j) != TK_RBRACE {
                    let kj = token_kind(j)
                    if kj == TK_IDENT && ENUM_VARIANT_TOTAL < 128 {
                        ENUM_VARIANTS[ENUM_VARIANT_TOTAL as usize] = j
                        ENUM_VARIANT_TOTAL = ENUM_VARIANT_TOTAL + 1
                        ENUM_VARIANT_COUNT[eidx as usize] = ENUM_VARIANT_COUNT[eidx as usize] + 1
                        j = j + 1
                        while j < token_count && token_kind(j) != TK_COMMA && token_kind(j) != TK_RBRACE { j = j + 1 }
                        if j < token_count && token_kind(j) == TK_COMMA { j = j + 1 }
                    } else if kj == TK_NEWLINE || kj == TK_SEMI { j = j + 1
                    } else { j = j + 1 }
                }
                i = j + 1
            } else { i = i + 1 }
        } else { i = i + 1 }
    }
}

fn find_enum_idx_tok(name_tok: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < ENUM_COUNT {
        if toks_ident_eq(ENUM_NAME_TOKS[i as usize], name_tok) { return i }
        i = i + 1
    }
    -1
}

fn find_enum_variant_value(eidx: i64, variant_tok: i64) -> i64 with Mut, Panic, Div {
    let start = ENUM_VARIANT_START[eidx as usize]
    let count = ENUM_VARIANT_COUNT[eidx as usize]
    var vi: i64 = 0
    while vi < count {
        if toks_ident_eq(ENUM_VARIANTS[(start + vi) as usize], variant_tok) { return vi }
        vi = vi + 1
    }
    -1
}

fn lookup_user_fn_return_struct_idx(fn_id: i64) -> i64 with Mut {
    var i: i64 = 0
    while i < V2_USER_FN_COUNT {
        if V2_USER_FN_IDS[i as usize] == fn_id {
            return V2_USER_FN_RETURN_STRUCT_IDX[i as usize]
        }
        i = i + 1
    }
    -1
}

fn lookup_user_fn_return_is_f64(fn_id: i64) -> bool with Mut {
    var i: i64 = 0
    while i < V2_USER_FN_COUNT {
        if V2_USER_FN_IDS[i as usize] == fn_id {
            return V2_USER_FN_RETURN_IS_F64[i as usize] != 0
        }
        i = i + 1
    }
    false
}

fn lookup_user_fn_returns_value(fn_id: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < V2_USER_FN_COUNT {
        if V2_USER_FN_IDS[i as usize] == fn_id {
            let name_tok = V2_USER_FN_TOKEN_IDX[i as usize]
            var j = name_tok + 1
            while j < V2_TOKEN_COUNT && token_kind(j) != TK_LBRACE && token_kind(j) != TK_FN {
                if token_kind(j) == TK_ARROW { return true }
                j = j + 1
            }
            return false
        }
        i = i + 1
    }
    false
}

fn builtin_fn_returns_value(fn_id: i64) -> bool {
    if fn_id == V2_BUILTIN_PRINT { return false }
    if fn_id == V2_BUILTIN_PRINT_INT { return false }
    if fn_id == V2_BUILTIN_PRINT_CHAR { return false }
    if fn_id == V2_BUILTIN_PRINT_F64 { return false }
    if fn_id == V2_BUILTIN_PRINTLN { return false }
    true
}

fn call_target_returns_value_tok(name_tok: i64) -> bool with Mut, Panic, Div {
    var fn_id = builtin_fn_id_tok(name_tok)
    if fn_id >= 0 { return builtin_fn_returns_value(fn_id) }
    fn_id = lookup_user_fn_id_tok(name_tok)
    if fn_id >= 0 { return lookup_user_fn_returns_value(fn_id) }
    false
}

fn find_struct_idx_tok(name_tok: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < STRUCT_COUNT {
        if toks_ident_eq(STRUCT_NAME_TOKS[i as usize], name_tok) { return i }
        i = i + 1
    }
    -1
}

fn struct_field_offset_tok(sidx: i64, field_tok: i64) -> i64 with Mut, Panic, Div {
    let start = STRUCT_FIELD_START[sidx as usize]
    let count = STRUCT_FIELD_COUNT[sidx as usize]
    var fi: i64 = 0
    while fi < count {
        if toks_ident_eq(STRUCT_FIELDS[(start + fi) as usize], field_tok) {
            return STRUCT_FIELD_FLAT_OFFSET[(start + fi) as usize]
        }
        fi = fi + 1
    }
    -1
}

// Returns the struct sidx of a field at positional index fi within struct sidx (-1 if scalar)
fn struct_field_type_at(sidx: i64, flat_off: i64) -> i64 with Mut {
    let start = STRUCT_FIELD_START[sidx as usize]
    let count = STRUCT_FIELD_COUNT[sidx as usize]
    var fi: i64 = 0
    while fi < count {
        if STRUCT_FIELD_FLAT_OFFSET[(start + fi) as usize] == flat_off {
            return STRUCT_FIELD_STRUCT_IDX[(start + fi) as usize]
        }
        fi = fi + 1
    }
    -1
}

fn struct_field_is_f64_at(sidx: i64, flat_off: i64) -> bool with Mut {
    let start = STRUCT_FIELD_START[sidx as usize]
    let count = STRUCT_FIELD_COUNT[sidx as usize]
    var fi: i64 = 0
    while fi < count {
        if STRUCT_FIELD_FLAT_OFFSET[(start + fi) as usize] == flat_off {
            return STRUCT_FIELD_IS_F64[(start + fi) as usize] != 0
        }
        fi = fi + 1
    }
    false
}

fn struct_field_generic_f64_at(sidx: i64, flat_off: i64) -> bool with Mut {
    let start = STRUCT_FIELD_START[sidx as usize]
    let count = STRUCT_FIELD_COUNT[sidx as usize]
    var fi: i64 = 0
    while fi < count {
        if STRUCT_FIELD_FLAT_OFFSET[(start + fi) as usize] == flat_off {
            return STRUCT_FIELD_GENERIC_F64[(start + fi) as usize] != 0
        }
        fi = fi + 1
    }
    false
}

fn is_cmp_op(k: i64) -> bool {
    k == TK_LT || k == TK_GT || k == TK_LE || k == TK_GE || k == TK_EQEQ || k == TK_BANGEQ
}

fn is_arith_op(k: i64) -> bool {
    k == TK_PLUS || k == TK_MINUS || k == TK_STAR || k == TK_SLASH
}

fn binary_op_from_cmp_kind(kind: i64) -> BinaryOp {
    if kind == TK_LT { return BinaryOp::OpLt }
    if kind == TK_GT { return BinaryOp::OpGt }
    if kind == TK_LE { return BinaryOp::OpLe }
    if kind == TK_GE { return BinaryOp::OpGe }
    if kind == TK_EQEQ { return BinaryOp::OpEq }
    BinaryOp::OpNe
}

fn emit_instr(func: &! IrFunction, instr: IrInstr) with Mut, Panic {
    let idx = (*func).instr_count
    if idx >= 0 && idx < 128 {
        (*func).instrs[idx as usize] = instr
        (*func).instr_count = idx + 1
    }
}

// op_kind → binop code for arith (1=add,2=sub,3=mul,4=div)
fn arith_op_to_code(k: i64) -> i64 {
    if k == TK_PLUS { return 1 }
    if k == TK_MINUS { return 2 }
    if k == TK_STAR { return 3 }
    if k == TK_SLASH { return 4 }
    1
}

// op_kind → binop code for cmp (5=eq,6=ne,7=lt,8=le,9=gt,10=ge)
fn cmp_op_to_code(k: i64) -> i64 {
    if k == TK_EQEQ { return 5 }
    if k == TK_BANGEQ { return 6 }
    if k == TK_LT { return 7 }
    if k == TK_LE { return 8 }
    if k == TK_GT { return 9 }
    if k == TK_GE { return 10 }
    5
}

fn ufn_record_load_imm(dst: i64, value: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 2048 {
        V2_UFN_OPS[idx as usize] = UFN_LOAD_IMM
        V2_UFN_DST[idx as usize] = dst
        V2_UFN_IMM[idx as usize] = value
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_load_string(dst: i64, token_idx: i64) with Mut, Panic {
    let idx = V2_UFN_COUNT
    if idx < 2048 {
        V2_UFN_OPS[idx as usize] = UFN_LOAD_STRING
        V2_UFN_DST[idx as usize] = dst
        V2_UFN_STR_START[idx as usize] = pt_read_start(token_idx)
        V2_UFN_STR_END[idx as usize] = pt_read_end(token_idx)
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_temp_addr(dst: i64, src: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 2048 {
        V2_UFN_OPS[idx as usize] = UFN_TEMP_ADDR
        V2_UFN_DST[idx as usize] = dst
        V2_UFN_SRC1[idx as usize] = src
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_load_ref_field(dst: i64, base_ref: i64, field_offset: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 2048 {
        V2_UFN_OPS[idx as usize] = UFN_LOAD_REF_FIELD
        V2_UFN_DST[idx as usize] = dst
        V2_UFN_SRC1[idx as usize] = base_ref
        V2_UFN_IMM[idx as usize] = field_offset
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_store_ref_field(base_ref: i64, field_offset: i64, src: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 2048 {
        V2_UFN_OPS[idx as usize] = UFN_STORE_REF_FIELD
        V2_UFN_SRC1[idx as usize] = base_ref
        V2_UFN_SRC2[idx as usize] = src
        V2_UFN_IMM[idx as usize] = field_offset
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_global_load(dst: i64, global_id: i64, index_reg: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 2048 {
        V2_UFN_OPS[idx as usize] = UFN_GLOBAL_LOAD
        V2_UFN_DST[idx as usize] = dst
        V2_UFN_SRC1[idx as usize] = index_reg
        V2_UFN_IMM[idx as usize] = global_id
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_global_store(global_id: i64, index_reg: i64, src: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 2048 {
        V2_UFN_OPS[idx as usize] = UFN_GLOBAL_STORE
        V2_UFN_SRC1[idx as usize] = index_reg
        V2_UFN_SRC2[idx as usize] = src
        V2_UFN_IMM[idx as usize] = global_id
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_user_global_load(dst: i64, user_global_idx: i64, index_reg: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 2048 {
        V2_UFN_OPS[idx as usize] = UFN_USER_GLOBAL_LOAD
        V2_UFN_DST[idx as usize] = dst
        V2_UFN_SRC1[idx as usize] = index_reg
        V2_UFN_IMM[idx as usize] = user_global_idx
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_user_global_store(user_global_idx: i64, index_reg: i64, src: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 2048 {
        V2_UFN_OPS[idx as usize] = UFN_USER_GLOBAL_STORE
        V2_UFN_SRC1[idx as usize] = index_reg
        V2_UFN_SRC2[idx as usize] = src
        V2_UFN_IMM[idx as usize] = user_global_idx
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_local_load(dst: i64, base_reg: i64, idx_reg: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 2048 {
        V2_UFN_OPS[idx as usize] = UFN_LOCAL_LOAD
        V2_UFN_DST[idx as usize] = dst
        V2_UFN_SRC1[idx as usize] = base_reg
        V2_UFN_SRC2[idx as usize] = idx_reg
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_local_store(base_reg: i64, idx_reg: i64, src: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 2048 {
        V2_UFN_OPS[idx as usize] = UFN_LOCAL_STORE
        V2_UFN_SRC1[idx as usize] = base_reg
        V2_UFN_SRC2[idx as usize] = idx_reg
        V2_UFN_DST[idx as usize] = src
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_binop(dst: i64, src1: i64, binop_code: i64, src2: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 2048 {
        V2_UFN_OPS[idx as usize] = UFN_BINOP
        V2_UFN_DST[idx as usize] = dst
        V2_UFN_SRC1[idx as usize] = src1
        V2_UFN_SRC2[idx as usize] = src2
        V2_UFN_BINOP_CODE[idx as usize] = binop_code
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_load_f64_scaled(dst: i64, mantissa: i64, scale: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 2048 {
        V2_UFN_OPS[idx as usize] = UFN_LOAD_F64_SCALED
        V2_UFN_DST[idx as usize] = dst
        V2_UFN_IMM[idx as usize] = mantissa
        V2_UFN_FLOAT_SCALE[idx as usize] = scale
        V2_UFN_COUNT = idx + 1
        mark_reg_f64(dst)
    }
}

fn ufn_record_f64_binop(dst: i64, src1: i64, binop_code: i64, src2: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 2048 {
        V2_UFN_OPS[idx as usize] = UFN_F64_BINOP
        V2_UFN_DST[idx as usize] = dst
        V2_UFN_SRC1[idx as usize] = src1
        V2_UFN_SRC2[idx as usize] = src2
        V2_UFN_BINOP_CODE[idx as usize] = binop_code
        V2_UFN_COUNT = idx + 1
        if binop_code >= 1 && binop_code <= 4 {
            mark_reg_f64(dst)
        } else {
            mark_reg_i64(dst)
        }
    }
}

fn ufn_record_label(label_id: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 2048 {
        V2_UFN_OPS[idx as usize] = UFN_LABEL
        V2_UFN_LABEL_ID[idx as usize] = label_id
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_jump(label_id: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 2048 {
        V2_UFN_OPS[idx as usize] = UFN_JUMP
        V2_UFN_LABEL_ID[idx as usize] = label_id
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_branch_false(cond_reg: i64, label_id: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 2048 {
        V2_UFN_OPS[idx as usize] = UFN_BRANCH_FALSE
        V2_UFN_SRC1[idx as usize] = cond_reg
        V2_UFN_LABEL_ID[idx as usize] = label_id
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_return(src: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 2048 {
        V2_UFN_OPS[idx as usize] = UFN_RETURN
        V2_UFN_SRC1[idx as usize] = src
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_call(dst: i64, fn_id_val: i64, arg0: i64, argc: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 2048 {
        V2_UFN_OPS[idx as usize] = UFN_CALL
        V2_UFN_DST[idx as usize] = dst
        V2_UFN_FN_ID[idx as usize] = fn_id_val
        V2_UFN_SRC1[idx as usize] = arg0
        V2_UFN_IMM[idx as usize] = argc
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_copy(dst: i64, src: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 2048 {
        V2_UFN_OPS[idx as usize] = UFN_COPY
        V2_UFN_DST[idx as usize] = dst
        V2_UFN_SRC1[idx as usize] = src
        V2_UFN_COUNT = idx + 1
        if reg_is_f64(src) { mark_reg_f64(dst) } else { mark_reg_i64(dst) }
    }
}

fn ufn_record_return_struct(base_reg: i64, fcount: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 2048 {
        V2_UFN_OPS[idx as usize] = UFN_RETURN_STRUCT
        V2_UFN_SRC1[idx as usize] = base_reg
        V2_UFN_IMM[idx as usize] = fcount
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_call_struct_result(dst: i64, fn_id: i64, arg0: i64, argc: i64, result_fcount: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 2048 {
        V2_UFN_OPS[idx as usize] = UFN_CALL_STRUCT_RESULT
        V2_UFN_DST[idx as usize] = dst
        V2_UFN_FN_ID[idx as usize] = fn_id
        V2_UFN_SRC1[idx as usize] = arg0
        V2_UFN_IMM[idx as usize] = argc
        V2_UFN_RESULT_FCOUNT[idx as usize] = result_fcount
        V2_UFN_COUNT = idx + 1
    }
}

fn builtin_fn_id(name: Name) -> i64 with Mut, Panic, Div {
    if name_eq_text(name, "print") { return V2_BUILTIN_PRINT }
    if name_eq_text(name, "print_int") { return V2_BUILTIN_PRINT_INT }
    if name_eq_text(name, "print_char") { return V2_BUILTIN_PRINT_CHAR }
    if name_eq_text(name, "print_f64") { return V2_BUILTIN_PRINT_F64 }
    if name_eq_text(name, "sqrt_f64") { return V2_BUILTIN_SQRT_F64 }
    if name_eq_text(name, "arg_count") { return V2_BUILTIN_ARG_COUNT }
    if name_eq_text(name, "get_arg_count") { return V2_BUILTIN_ARG_COUNT }
    if name_eq_text(name, "get_arg") { return V2_BUILTIN_GET_ARG }
    if name_eq_text(name, "str_eq") { return V2_BUILTIN_STR_EQ }
    if name_eq_text(name, "str_len") { return V2_BUILTIN_STR_LEN }
    if name_eq_text(name, "str_char_at") { return V2_BUILTIN_STR_CHAR_AT }
    if name_eq_text(name, "pt_read_kind_code") { return V2_BUILTIN_PT_READ_KIND_CODE }
    if name_eq_text(name, "pt_read_start") { return V2_BUILTIN_PT_READ_START }
    if name_eq_text(name, "pt_read_end") { return V2_BUILTIN_PT_READ_END }
    if name_eq_text(name, "pt_read_int_value") { return V2_BUILTIN_PT_READ_INT_VALUE }
    if name_eq_text(name, "empty_name") { return V2_BUILTIN_EMPTY_NAME }
    if name_eq_text(name, "driver_read_file_to_cursor_source") { return V2_BUILTIN_DRIVER_READ_FILE_TO_GLOBALS }
    if name_eq_text(name, "driver_write_elf_to_file") { return V2_BUILTIN_DRIVER_WRITE_ELF }
    if name_eq_text(name, "driver_make_executable") { return V2_BUILTIN_DRIVER_CHMOD }
    if name_eq_text(name, "println") { return V2_BUILTIN_PRINTLN }
    -1
}

fn builtin_fn_id_tok(tok: i64) -> i64 with Mut, Panic, Div {
    if token_text_eq(tok, "print") { return V2_BUILTIN_PRINT }
    if token_text_eq(tok, "print_int") { return V2_BUILTIN_PRINT_INT }
    if token_text_eq(tok, "print_char") { return V2_BUILTIN_PRINT_CHAR }
    if token_text_eq(tok, "print_f64") { return V2_BUILTIN_PRINT_F64 }
    if token_text_eq(tok, "sqrt_f64") { return V2_BUILTIN_SQRT_F64 }
    if token_text_eq(tok, "arg_count") { return V2_BUILTIN_ARG_COUNT }
    if token_text_eq(tok, "get_arg_count") { return V2_BUILTIN_ARG_COUNT }
    if token_text_eq(tok, "get_arg") { return V2_BUILTIN_GET_ARG }
    if token_text_eq(tok, "str_eq") { return V2_BUILTIN_STR_EQ }
    if token_text_eq(tok, "str_len") { return V2_BUILTIN_STR_LEN }
    if token_text_eq(tok, "str_char_at") { return V2_BUILTIN_STR_CHAR_AT }
    if token_text_eq(tok, "pt_read_kind_code") { return V2_BUILTIN_PT_READ_KIND_CODE }
    if token_text_eq(tok, "pt_read_start") { return V2_BUILTIN_PT_READ_START }
    if token_text_eq(tok, "pt_read_end") { return V2_BUILTIN_PT_READ_END }
    if token_text_eq(tok, "pt_read_int_value") { return V2_BUILTIN_PT_READ_INT_VALUE }
    if token_text_eq(tok, "empty_name") { return V2_BUILTIN_EMPTY_NAME }
    if token_text_eq(tok, "driver_read_file_to_cursor_source") { return V2_BUILTIN_DRIVER_READ_FILE_TO_GLOBALS }
    if token_text_eq(tok, "driver_write_elf_to_file") { return V2_BUILTIN_DRIVER_WRITE_ELF }
    if token_text_eq(tok, "driver_make_executable") { return V2_BUILTIN_DRIVER_CHMOD }
    if token_text_eq(tok, "println") { return V2_BUILTIN_PRINTLN }
    -1
}

// ============================================================
// IR-only parse functions (for user-defined functions)
// No V2_CORE side effects; builds IrFunction directly
// ============================================================

fn parse_if_expr_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64) -> ExprParse with Mut, Panic, Div, Alloc {
    // Expression form: `if COND { THEN_EXPR } else { ELSE_EXPR }`.
    // Both arms must be tail-expression blocks (single expression, no statements).
    // Returns ExprParse with reg holding the chosen value and next past the closing `}`.
    let cond = parse_expr_ir(func, ctx, pos + 1)
    if cond.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
    var p = cond.next
    p = skip_trivia(p, V2_TOKEN_COUNT)
    if token_kind(p) != TK_LBRACE { return ExprParse { ok: 0, reg: -1, next: pos} }
    let then_close = find_matching_rbrace(p, V2_TOKEN_COUNT)
    if then_close < 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
    var after_then = skip_trivia(then_close + 1, V2_TOKEN_COUNT)
    if token_kind(after_then) != TK_ELSE { return ExprParse { ok: 0, reg: -1, next: pos} }
    let after_else = skip_trivia(after_then + 1, V2_TOKEN_COUNT)
    if token_kind(after_else) != TK_LBRACE { return ExprParse { ok: 0, reg: -1, next: pos} }
    let else_close = find_matching_rbrace(after_else, V2_TOKEN_COUNT)
    if else_close < 0 { return ExprParse { ok: 0, reg: -1, next: pos} }

    let dst = alloc_reg(ctx)
    let label_else = alloc_label()
    let label_end = alloc_label()
    ufn_record_branch_false(cond.reg, label_else)
    // then arm: parse single tail expression inside the braces.
    let then_start = skip_trivia(p + 1, then_close)
    let then_expr = parse_expr_ir(func, ctx, then_start)
    if then_expr.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
    if then_expr.reg != dst { ufn_record_copy(dst, then_expr.reg) }
    ufn_record_jump(label_end)
    ufn_record_label(label_else)
    let else_start = skip_trivia(after_else + 1, else_close)
    let else_expr = parse_expr_ir(func, ctx, else_start)
    if else_expr.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
    if else_expr.reg != dst { ufn_record_copy(dst, else_expr.reg) }
    ufn_record_label(label_end)
    ExprParse { ok: 1, reg: dst, next: else_close + 1}
}

fn parse_atom_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64) -> ExprParse with Mut, Panic, Div, Alloc {
    let k = token_kind(pos)
    if k == TK_IF {
        return parse_if_expr_ir(func, ctx, pos)
    }
    if k == TK_BANG {
        let inner = parse_atom_ir(func, ctx, pos + 1)
        if inner.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
        let dst = alloc_reg(ctx)
        let zero = alloc_reg(ctx)
        ufn_record_load_imm(zero, 0)
        ufn_record_binop(dst, inner.reg, 5, zero)
        return ExprParse { ok: 1, reg: dst, next: inner.next}
    }
    if k == TK_MINUS && token_kind(pos + 1) == TK_INT {
        if token_kind(pos + 2) == TK_DOT && token_kind(pos + 3) == TK_INT {
            let r = alloc_reg(ctx)
            let frac_digits = token_decimal_digit_count(pos + 3)
            let scale = decimal_scale_for_digits(frac_digits)
            let mantissa = (pt_read_int_value(pos + 1) * scale) + pt_read_int_value(pos + 3)
            ufn_record_load_f64_scaled(r, 0 - mantissa, scale)
            return ExprParse { ok: 1, reg: r, next: pos + 4}
        }
        let r = alloc_reg(ctx)
        ufn_record_load_imm(r, 0 - pt_read_int_value(pos + 1))
        return ExprParse { ok: 1, reg: r, next: pos + 2}
    }
    if k == TK_MINUS && token_kind(pos + 1) == TK_FLOAT {
        let r = alloc_reg(ctx)
        ufn_record_load_f64_scaled(r, 0 - token_float_mantissa(pos + 1), token_float_scale(pos + 1))
        return ExprParse { ok: 1, reg: r, next: pos + 2}
    }
    if k == TK_AMPBANG && token_kind(pos + 1) == TK_IDENT {
        let base_reg = lookup_local_tok(ctx, pos + 1)
        if base_reg >= 0 {
            let dst = alloc_reg(ctx)
            ufn_record_temp_addr(dst, base_reg)
            return ExprParse { ok: 1, reg: dst, next: pos + 2}
        }
        return ExprParse { ok: 0, reg: -1, next: pos}
    }
    if k == TK_LPAREN {
        if token_kind(pos + 1) == TK_STAR && token_kind(pos + 2) == TK_IDENT && token_kind(pos + 3) == TK_RPAREN && token_kind(pos + 4) == TK_DOT && token_kind(pos + 5) == TK_IDENT {
            let base_ref = lookup_local_tok(ctx, pos + 2)
            if base_ref >= 0 && lookup_local_is_ref_tok(ctx, pos + 2) != 0 {
                let sidx = lookup_local_struct_idx_tok(ctx, pos + 2)
                if sidx >= 0 {
                    let foff = struct_field_offset_tok(sidx, pos + 5)
                    if foff >= 0 {
                        let dst = alloc_reg(ctx)
                        ufn_record_load_ref_field(dst, base_ref, foff)
                        let next_sidx = struct_field_type_at(sidx, foff)
                        V2_LAST_STRUCT_IDX = next_sidx
                        return ExprParse { ok: 1, reg: dst, next: pos + 6}
                    }
                }
            }
        }
        let inner = parse_expr_ir(func, ctx, pos + 1)
        if inner.ok != 0 {
            var close_pos = inner.next
            if token_kind(close_pos) == TK_AS {
                close_pos = close_pos + 2
            }
            if token_kind(close_pos) == TK_RPAREN {
                return ExprParse { ok: 1, reg: inner.reg, next: close_pos + 1}
            }
        }
        return ExprParse { ok: 0, reg: -1, next: pos}
    }
    if k == TK_INT {
        if token_kind(pos + 1) == TK_DOT && token_kind(pos + 2) == TK_INT {
            let r = alloc_reg(ctx)
            let frac_digits = token_decimal_digit_count(pos + 2)
            let scale = decimal_scale_for_digits(frac_digits)
            let mantissa = (pt_read_int_value(pos) * scale) + pt_read_int_value(pos + 2)
            ufn_record_load_f64_scaled(r, mantissa, scale)
            return ExprParse { ok: 1, reg: r, next: pos + 3}
        }
        let r = alloc_reg(ctx)
        ufn_record_load_imm(r, pt_read_int_value(pos))
        return ExprParse { ok: 1, reg: r, next: pos + 1}
    }
    if k == TK_FLOAT {
        let r = alloc_reg(ctx)
        ufn_record_load_f64_scaled(r, token_float_mantissa(pos), token_float_scale(pos))
        return ExprParse { ok: 1, reg: r, next: pos + 1}
    }
    if k == TK_TRUE {
        let r = alloc_reg(ctx)
        ufn_record_load_imm(r, 1)
        return ExprParse { ok: 1, reg: r, next: pos + 1}
    }
    if k == TK_FALSE {
        let r = alloc_reg(ctx)
        ufn_record_load_imm(r, 0)
        return ExprParse { ok: 1, reg: r, next: pos + 1}
    }
    if k == TK_STRING {
        let r = alloc_reg(ctx)
        ufn_record_load_string(r, pos)
        return ExprParse { ok: 1, reg: r, next: pos + 1}
    }
    if k == TK_IDENT {
        let cval = driver_const_value_tok(pos)
        if cval != -999999999 {
            let r = alloc_reg(ctx)
            ufn_record_load_imm(r, cval)
            return ExprParse { ok: 1, reg: r, next: pos + 1}
        }
        let gid = driver_global_id_tok(pos)
        if gid >= 0 && token_kind(pos + 1) == TK_LBRACKET {
            let idx_expr = parse_expr_ir(func, ctx, pos + 2)
            if idx_expr.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
            let end_pos = skip_index_cast_end(idx_expr.next)
            if token_kind(end_pos) != TK_RBRACKET { return ExprParse { ok: 0, reg: -1, next: pos} }
            let dst = alloc_reg(ctx)
            ufn_record_global_load(dst, gid, idx_expr.reg)
            return ExprParse { ok: 1, reg: dst, next: end_pos + 1}
        }
        // M1.2 step D — user-declared top-level global array read: `NAME[expr]`.
        // Placed after driver_global_id_tok so driver-internal names continue
        // to resolve through the existing hard-coded path when the driver
        // self-compiles.
        let ugid = user_global_id_tok(pos)
        if ugid >= 0 && token_kind(pos + 1) == TK_LBRACKET {
            let idx_expr = parse_expr_ir(func, ctx, pos + 2)
            if idx_expr.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
            let end_pos = skip_index_cast_end(idx_expr.next)
            if token_kind(end_pos) != TK_RBRACKET { return ExprParse { ok: 0, reg: -1, next: pos} }
            let dst = alloc_reg(ctx)
            ufn_record_user_global_load(dst, ugid, idx_expr.reg)
            if USER_GLOBAL_IS_F64[ugid as usize] != 0 { mark_reg_f64(dst) }
            return ExprParse { ok: 1, reg: dst, next: end_pos + 1}
        }
        if gid >= 0 {
            let sidx = find_struct_idx_tok(pos)
            if sidx >= 0 {
                let flat_size = STRUCT_FLAT_SIZE[sidx as usize]
                let base = alloc_reg(ctx)
                var bi: i64 = 1
                while bi < flat_size { let _ = alloc_reg(ctx); bi = bi + 1 }
                let idx_reg = alloc_reg(ctx)
                var ci: i64 = 0
                while ci < flat_size {
                    ufn_record_load_imm(idx_reg, ci)
                    ufn_record_global_load(base + ci, gid, idx_reg)
                    ci = ci + 1
                }
                mark_struct_regs(base, sidx)
                V2_LAST_STRUCT_IDX = sidx
                return ExprParse { ok: 1, reg: base, next: pos + 1}
            }
            let zero = alloc_reg(ctx)
            let dst = alloc_reg(ctx)
            ufn_record_load_imm(zero, 0)
            ufn_record_global_load(dst, gid, zero)
            return ExprParse { ok: 1, reg: dst, next: pos + 1}
        }
        // enum variant: EnumName::Variant → load discriminant
        if token_kind(pos + 1) == TK_COLONCOLON && token_kind(pos + 2) == TK_IDENT {
            let eidx = find_enum_idx_tok(pos)
            if eidx >= 0 {
                let variant_val = find_enum_variant_value(eidx, pos + 2)
                if variant_val >= 0 {
                    let r = alloc_reg(ctx)
                    ufn_record_load_imm(r, variant_val)
                    return ExprParse { ok: 1, reg: r, next: pos + 3}
                }
            }
        }
        let reg = lookup_local_tok(ctx, pos)
        if reg >= 0 {
            if lookup_local_is_ref_tok(ctx, pos) != 0 {
                return ExprParse { ok: 1, reg: reg, next: pos + 1}
            }
            // local array read: ident[expr] or ident[expr as T]
            if token_kind(pos + 1) == TK_LBRACKET {
                let idx_expr = parse_expr_ir(func, ctx, pos + 2)
                if idx_expr.ok != 0 {
                    let end_pos = skip_index_cast_end(idx_expr.next)
                    if token_kind(end_pos) == TK_RBRACKET {
                        let dst = alloc_reg(ctx)
                        ufn_record_local_load(dst, reg, idx_expr.reg)
                        return ExprParse { ok: 1, reg: dst, next: end_pos + 1}
                    }
                }
            }
            let sidx = lookup_local_struct_idx_tok(ctx, pos)
            if sidx >= 0 {
                V2_LAST_STRUCT_IDX = sidx
                // chain dot access: p.x, p.y.z, etc.
                if token_kind(pos + 1) == TK_DOT && token_kind(pos + 2) == TK_IDENT {
                    var cur_reg = reg
                    var cur_sidx = sidx
                    var cur = pos + 1
                    while cur + 1 < V2_TOKEN_COUNT && token_kind(cur) == TK_DOT && token_kind(cur + 1) == TK_IDENT {
                        let foff = struct_field_offset_tok(cur_sidx, cur + 1)
                        if foff < 0 { break }
                        cur_reg = cur_reg + foff
                        let next_sidx = struct_field_type_at(cur_sidx, foff)
                        if next_sidx >= 0 && struct_field_generic_f64_at(cur_sidx, foff) {
                            mark_struct_scalar_regs_f64(cur_reg, next_sidx)
                        }
                        if next_sidx < 0 && struct_field_is_f64_at(cur_sidx, foff) {
                            mark_reg_f64(cur_reg)
                        }
                        cur = cur + 2
                        if next_sidx < 0 { V2_LAST_STRUCT_IDX = -1; break }
                        cur_sidx = next_sidx
                        V2_LAST_STRUCT_IDX = next_sidx
                    }
                    // struct field array read: local.field[expr]
                    if token_kind(cur) == TK_LBRACKET {
                        let idx_expr = parse_expr_ir(func, ctx, cur + 1)
                        if idx_expr.ok != 0 {
                            let end_pos = skip_index_cast_end(idx_expr.next)
                            if token_kind(end_pos) == TK_RBRACKET {
                                let dst = alloc_reg(ctx)
                                ufn_record_local_load(dst, cur_reg, idx_expr.reg)
                                return ExprParse { ok: 1, reg: dst, next: end_pos + 1}
                            }
                        }
                    }
                    return ExprParse { ok: 1, reg: cur_reg, next: cur}
                }
            }
            return ExprParse { ok: 1, reg: reg, next: pos + 1}
        }
        // struct literal
        if token_kind(pos + 1) == TK_LBRACE {
            let lit = parse_struct_lit_ir(func, ctx, pos, V2_TOKEN_COUNT)
            if lit.ok != 0 { return lit }
        }
        if token_kind(pos + 1) == TK_LT && token_kind(pos + 2) == TK_IDENT && token_kind(pos + 3) == TK_GT && token_kind(pos + 4) == TK_LBRACE {
            let lit = parse_struct_lit_ir(func, ctx, pos, V2_TOKEN_COUNT)
            if lit.ok != 0 { return lit }
        }
        // function call
        if token_kind(pos + 1) == TK_LPAREN {
            return parse_fn_call_ir(func, ctx, pos)
        }
    }
    ExprParse { ok: 0, reg: -1, next: pos}
}

fn parse_struct_lit_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64, token_count: i64) -> ExprParse with Mut, Panic, Div, Alloc {
    let sidx = find_struct_idx_tok(pos)
    if sidx < 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
    var brace_pos = pos + 1
    var generic_f64: i64 = 0
    if token_kind(pos + 1) == TK_LT && token_kind(pos + 2) == TK_IDENT && token_kind(pos + 3) == TK_GT && token_kind(pos + 4) == TK_LBRACE {
        brace_pos = pos + 4
        if token_text_eq(pos + 2, "f64") {
            generic_f64 = 1
        }
    }
    if token_kind(brace_pos) != TK_LBRACE { return ExprParse { ok: 0, reg: -1, next: pos} }
    let flat_size = STRUCT_FLAT_SIZE[sidx as usize]
    let base_reg = V2_NEXT_REG
    V2_NEXT_REG = V2_NEXT_REG + flat_size
    var cur = brace_pos + 1
    while cur < token_count {
        let kk = token_kind(cur)
        if kk == TK_NEWLINE || kk == TK_SEMI || kk == TK_COMMA { cur = cur + 1; continue }
        if kk == TK_RBRACE { break }
        if kk != TK_IDENT { break }
        let field_tok = cur
        let foff = struct_field_offset_tok(sidx, field_tok)
        cur = cur + 1
        if cur < token_count && token_kind(cur) == TK_COLON { cur = cur + 1 }
        V2_LAST_STRUCT_IDX = -1
        let val = parse_expr_ir(func, ctx, cur)
        if val.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
        if foff >= 0 {
            let val_sidx = V2_LAST_STRUCT_IDX
            if val_sidx >= 0 {
                let inner_flat = STRUCT_FLAT_SIZE[val_sidx as usize]
                var ci: i64 = 0
                while ci < inner_flat {
                    ufn_record_copy(base_reg + foff + ci, val.reg + ci)
                    ci = ci + 1
                }
            } else {
                ufn_record_copy(base_reg + foff, val.reg)
            }
        }
        cur = val.next
        if cur < token_count && token_kind(cur) == TK_COMMA { cur = cur + 1 }
    }
    V2_LAST_STRUCT_IDX = sidx
    if generic_f64 != 0 {
        mark_struct_scalar_regs_f64(base_reg, sidx)
    } else {
        mark_struct_regs(base_reg, sidx)
    }
    ExprParse { ok: 1, reg: base_reg, next: cur + 1}
}

fn parse_fn_call_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64) -> ExprParse with Mut, Panic, Div, Alloc {
    var fn_id = builtin_fn_id_tok(pos)
    if fn_id < 0 { fn_id = lookup_user_fn_id_tok(pos) }
    if fn_id < 0 {
        mark_parse_unsupported_call(pos)
        return ExprParse { ok: 0, reg: -1, next: pos}
    }
    if token_kind(pos + 1) != TK_LPAREN { return ExprParse { ok: 0, reg: -1, next: pos} }
    if fn_id == V2_BUILTIN_EMPTY_NAME && token_kind(pos + 2) == TK_RPAREN {
        let sidx = find_name_struct_idx()
        if sidx >= 0 {
            let flat_size = STRUCT_FLAT_SIZE[sidx as usize]
            let base = V2_NEXT_REG
            V2_NEXT_REG = base + flat_size
            let zero = alloc_reg(ctx)
            ufn_record_load_imm(zero, 0)
            var zi: i64 = 0
            while zi < flat_size {
                ufn_record_copy(base + zi, zero)
                zi = zi + 1
            }
            V2_LAST_STRUCT_IDX = sidx
            return ExprParse { ok: 1, reg: base, next: pos + 3}
        }
        return ExprParse { ok: 0, reg: -1, next: pos}
    }
    // M1.2 step 2 (redo): `println` is not a standalone builtin in codegen —
    // it expands at parse time into a typed print call plus a trailing
    // print_char(10). Dispatch is based on the argument's runtime type:
    //   - f64 register (via reg_is_f64) → print_f64 + '\n'
    //   - TK_STRING leading token → print + '\n'
    //   - otherwise → print_int + '\n'
    // Zero-arg form `println()` just emits a newline. Mirrors lean_single's
    // println lowering where the type of the single argument decides between
    // print_cstr, print_int, and print_f64 followed by a linefeed.
    if fn_id == V2_BUILTIN_PRINTLN {
        // Zero-arg: println() → just a newline.
        if token_kind(pos + 2) == TK_RPAREN {
            let nl_reg = alloc_reg(ctx)
            let nl_dst = alloc_reg(ctx)
            ufn_record_load_imm(nl_reg, 10)
            ufn_record_call(nl_dst, V2_BUILTIN_PRINT_CHAR, nl_reg, 1)
            return ExprParse { ok: 1, reg: nl_dst, next: pos + 3}
        }
        // Single-arg: inspect the leading arg token for the cstring heuristic
        // BEFORE parsing (parse_expr_ir consumes the token and reg-type tracking
        // doesn't distinguish cstring pointers from ints).
        let arg_start_kind = token_kind(pos + 2)
        V2_LAST_STRUCT_IDX = -1
        let arg = parse_expr_ir(func, ctx, pos + 2)
        if arg.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
        if token_kind(arg.next) != TK_RPAREN { return ExprParse { ok: 0, reg: -1, next: pos} }
        var inner_fn_id = V2_BUILTIN_PRINT_INT
        if reg_is_f64(arg.reg) {
            inner_fn_id = V2_BUILTIN_PRINT_F64
        } else if arg_start_kind == TK_STRING {
            inner_fn_id = V2_BUILTIN_PRINT
        }
        let inner_dst = alloc_reg(ctx)
        ufn_record_call(inner_dst, inner_fn_id, arg.reg, 1)
        let nl_reg = alloc_reg(ctx)
        let nl_dst = alloc_reg(ctx)
        ufn_record_load_imm(nl_reg, 10)
        ufn_record_call(nl_dst, V2_BUILTIN_PRINT_CHAR, nl_reg, 1)
        return ExprParse { ok: 1, reg: nl_dst, next: arg.next + 1}
    }
    var n_args: i64 = 0
    var total_argc: i64 = 0
    var cur = pos + 2
    while token_kind(cur) != TK_RPAREN && cur < V2_TOKEN_COUNT && n_args < 8 {
        if n_args > 0 {
            if token_kind(cur) == TK_COMMA { cur = cur + 1 }
            else { return ExprParse { ok: 0, reg: -1, next: pos} }
        }
        let saved_arg0 = V2_CALL_ARG_REGS[0]
        let saved_arg1 = V2_CALL_ARG_REGS[1]
        let saved_arg2 = V2_CALL_ARG_REGS[2]
        let saved_arg3 = V2_CALL_ARG_REGS[3]
        let saved_arg4 = V2_CALL_ARG_REGS[4]
        let saved_arg5 = V2_CALL_ARG_REGS[5]
        let saved_arg6 = V2_CALL_ARG_REGS[6]
        let saved_arg7 = V2_CALL_ARG_REGS[7]
        let saved_size0 = V2_CALL_ARG_SIZES[0]
        let saved_size1 = V2_CALL_ARG_SIZES[1]
        let saved_size2 = V2_CALL_ARG_SIZES[2]
        let saved_size3 = V2_CALL_ARG_SIZES[3]
        let saved_size4 = V2_CALL_ARG_SIZES[4]
        let saved_size5 = V2_CALL_ARG_SIZES[5]
        let saved_size6 = V2_CALL_ARG_SIZES[6]
        let saved_size7 = V2_CALL_ARG_SIZES[7]
        V2_LAST_STRUCT_IDX = -1
        let arg = parse_expr_ir(func, ctx, cur)
        let arg_struct_idx = V2_LAST_STRUCT_IDX
        V2_CALL_ARG_REGS[0] = saved_arg0
        V2_CALL_ARG_REGS[1] = saved_arg1
        V2_CALL_ARG_REGS[2] = saved_arg2
        V2_CALL_ARG_REGS[3] = saved_arg3
        V2_CALL_ARG_REGS[4] = saved_arg4
        V2_CALL_ARG_REGS[5] = saved_arg5
        V2_CALL_ARG_REGS[6] = saved_arg6
        V2_CALL_ARG_REGS[7] = saved_arg7
        V2_CALL_ARG_SIZES[0] = saved_size0
        V2_CALL_ARG_SIZES[1] = saved_size1
        V2_CALL_ARG_SIZES[2] = saved_size2
        V2_CALL_ARG_SIZES[3] = saved_size3
        V2_CALL_ARG_SIZES[4] = saved_size4
        V2_CALL_ARG_SIZES[5] = saved_size5
        V2_CALL_ARG_SIZES[6] = saved_size6
        V2_CALL_ARG_SIZES[7] = saved_size7
        V2_LAST_STRUCT_IDX = arg_struct_idx
        if arg.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
        V2_CALL_ARG_REGS[n_args as usize] = arg.reg
        var sz: i64 = 1
        if arg_struct_idx >= 0 {
            sz = STRUCT_FLAT_SIZE[arg_struct_idx as usize]
            V2_LAST_STRUCT_IDX = -1
        }
        V2_CALL_ARG_SIZES[n_args as usize] = sz
        total_argc = total_argc + sz
        n_args = n_args + 1
        cur = arg.next
    }
    if token_kind(cur) != TK_RPAREN { return ExprParse { ok: 0, reg: -1, next: pos} }
    // Determine arg0_reg: use first-arg reg if args are consecutive, else pack
    var arg0_reg: i64 = -1
    if total_argc > 0 {
        arg0_reg = V2_CALL_ARG_REGS[0]
        // Check if all args land in a single consecutive block from arg0_reg
        var consecutive: i64 = 1
        var expected: i64 = arg0_reg
        var ci: i64 = 0
        while ci < n_args {
            if V2_CALL_ARG_REGS[ci as usize] != expected { consecutive = 0 }
            expected = expected + V2_CALL_ARG_SIZES[ci as usize]
            ci = ci + 1
        }
        if consecutive == 0 {
            // Pack into a fresh consecutive block, emit copies
            let base = V2_NEXT_REG
            V2_NEXT_REG = V2_NEXT_REG + total_argc
            var slot: i64 = 0
            var ai: i64 = 0
            while ai < n_args {
                let from = V2_CALL_ARG_REGS[ai as usize]
                let sz = V2_CALL_ARG_SIZES[ai as usize]
                var fi: i64 = 0
                while fi < sz {
                    let dst_slot = base + slot + fi
                    let src_slot = from + fi
                    if dst_slot != src_slot { ufn_record_copy(dst_slot, src_slot) }
                    fi = fi + 1
                }
                slot = slot + sz
                ai = ai + 1
            }
            arg0_reg = base
        }
    }
    // check if callee returns a struct
    let ret_sidx = lookup_user_fn_return_struct_idx(fn_id)
    if ret_sidx >= 0 {
        let ret_flat = STRUCT_FLAT_SIZE[ret_sidx as usize]
        let dst = alloc_reg(ctx)
        var ri: i64 = 1
        while ri < ret_flat { let _ = alloc_reg(ctx); ri = ri + 1 }
        ufn_record_call_struct_result(dst, fn_id, arg0_reg, total_argc, ret_flat)
        V2_LAST_STRUCT_IDX = ret_sidx
        if lookup_user_fn_return_is_f64(fn_id) {
            mark_struct_scalar_regs_f64(dst, ret_sidx)
        } else {
            mark_struct_regs(dst, ret_sidx)
        }
        return ExprParse { ok: 1, reg: dst, next: cur + 1}
    }
    let dst = alloc_reg(ctx)
    ufn_record_call(dst, fn_id, arg0_reg, total_argc)
    if lookup_user_fn_return_is_f64(fn_id) || fn_id == V2_BUILTIN_SQRT_F64 {
        mark_reg_f64(dst)
    }
    ExprParse { ok: 1, reg: dst, next: cur + 1}
}

fn parse_expr_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64) -> ExprParse with Mut, Panic, Div, Alloc {
    let left = parse_atom_ir(func, ctx, pos)
    if left.ok == 0 { return left }
    var result = left
    var op_kind = token_kind(result.next)
    while is_arith_op(op_kind) {
        let right = parse_atom_ir(func, ctx, result.next + 1)
        if right.ok == 0 { return ExprParse { ok: 0, reg: -1, next: result.next} }
        let dst = alloc_reg(ctx)
        if reg_is_f64(result.reg) || reg_is_f64(right.reg) {
            ufn_record_f64_binop(dst, result.reg, arith_op_to_code(op_kind), right.reg)
        } else {
            ufn_record_binop(dst, result.reg, arith_op_to_code(op_kind), right.reg)
        }
        result = ExprParse { ok: 1, reg: dst, next: right.next}
        op_kind = token_kind(result.next)
    }
    if is_cmp_op(op_kind) {
        let right = parse_atom_ir(func, ctx, result.next + 1)
        if right.ok == 0 { return ExprParse { ok: 0, reg: -1, next: result.next} }
        if (op_kind == TK_EQEQ || op_kind == TK_BANGEQ) && token_kind(result.next + 1) == TK_STRING {
            let base = V2_NEXT_REG
            V2_NEXT_REG = base + 2
            ufn_record_copy(base, result.reg)
            ufn_record_copy(base + 1, right.reg)
            let eq_dst = alloc_reg(ctx)
            ufn_record_call(eq_dst, V2_BUILTIN_STR_EQ, base, 2)
            if op_kind == TK_BANGEQ {
                let zero = alloc_reg(ctx)
                let ne_dst = alloc_reg(ctx)
                ufn_record_load_imm(zero, 0)
                ufn_record_binop(ne_dst, eq_dst, 5, zero)
                return ExprParse { ok: 1, reg: ne_dst, next: right.next}
            }
            return ExprParse { ok: 1, reg: eq_dst, next: right.next}
        }
        let dst = alloc_reg(ctx)
        if reg_is_f64(result.reg) || reg_is_f64(right.reg) {
            ufn_record_f64_binop(dst, result.reg, cmp_op_to_code(op_kind), right.reg)
        } else {
            ufn_record_binop(dst, result.reg, cmp_op_to_code(op_kind), right.reg)
        }
        var rn = right.next
        if token_kind(rn) == TK_AS { rn = rn + 2 }
        result = ExprParse { ok: 1, reg: dst, next: rn}
    }
    // skip trailing 'as T' before checking logical operators (e.g. 48 as i8 && ...)
    if token_kind(result.next) == TK_AS {
        result = ExprParse { ok: 1, reg: result.reg, next: result.next + 2}
    }
    // Short-circuit logical operators: && and ||
    let op2 = token_kind(result.next)
    if op2 == TK_ANDAND {
        let right2 = parse_expr_ir(func, ctx, result.next + 1)
        if right2.ok != 0 {
            let dst = alloc_reg(ctx)
            let label_short = alloc_label()
            let label_end = alloc_label()
            ufn_record_branch_false(result.reg, label_short)
            ufn_record_copy(dst, right2.reg)
            ufn_record_jump(label_end)
            ufn_record_label(label_short)
            ufn_record_load_imm(dst, 0)
            ufn_record_label(label_end)
            return ExprParse { ok: 1, reg: dst, next: right2.next}
        }
    }
    if op2 == TK_OROR {
        let right2 = parse_expr_ir(func, ctx, result.next + 1)
        if right2.ok != 0 {
            let dst = alloc_reg(ctx)
            let zero = alloc_reg(ctx)
            let eq_zero = alloc_reg(ctx)
            let one = alloc_reg(ctx)
            let label_true = alloc_label()
            let label_end = alloc_label()
            ufn_record_load_imm(zero, 0)
            ufn_record_binop(eq_zero, result.reg, 5, zero)
            ufn_record_branch_false(eq_zero, label_true)
            ufn_record_copy(dst, right2.reg)
            ufn_record_jump(label_end)
            ufn_record_label(label_true)
            ufn_record_load_imm(one, 1)
            ufn_record_copy(dst, one)
            ufn_record_label(label_end)
            return ExprParse { ok: 1, reg: dst, next: right2.next}
        }
    }
    let cast_next = skip_index_cast_end(result.next)
    if cast_next != result.next {
        return ExprParse { ok: 1, reg: result.reg, next: cast_next}
    }
    result
}

fn emit_label(func: &! i64, label_id: i64) with Mut {
    ufn_record_label(label_id)
}

fn emit_jump(func: &! i64, label_id: i64) with Mut {
    ufn_record_jump(label_id)
}

fn emit_branch_false(func: &! i64, cond_reg: i64, label_id: i64) with Mut {
    ufn_record_branch_false(cond_reg, label_id)
}

fn parse_while_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64, token_count: i64) -> i64 with IO, Mut, Panic, Div, Alloc {
    // while COND { BODY }
    // pos points to token AFTER 'while'
    let label_top = alloc_label()
    let label_end = alloc_label()
    emit_label(func, label_top)

    // parse condition expression
    let cond = parse_expr_ir(func, ctx, pos)
    if cond.ok == 0 { return pos }
    emit_branch_false(func, cond.reg, label_end)

    // find and parse body block
    var p = cond.next
    while p < token_count && token_kind(p) != TK_LBRACE { p = p + 1 }
    if p >= token_count { return pos }
    let body_end = find_matching_rbrace(p, token_count)
    if body_end < 0 { return pos }
    let old_break = V2_BREAK_LABEL
    let old_continue = V2_CONTINUE_LABEL
    V2_BREAK_LABEL = label_end
    V2_CONTINUE_LABEL = label_top
    parse_block_ir(func, ctx, p + 1, body_end, token_count)
    V2_BREAK_LABEL = old_break
    V2_CONTINUE_LABEL = old_continue

    emit_jump(func, label_top)
    emit_label(func, label_end)
    body_end + 1
}

fn parse_if_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64, token_count: i64) -> i64 with IO, Mut, Panic, Div, Alloc {
    // if COND { THEN } [else [if ...] { ELSE }]
    // pos points to token AFTER 'if'
    let label_else = alloc_label()
    let label_end = alloc_label()

    let cond = parse_expr_ir(func, ctx, pos)
    if cond.ok == 0 { return pos }
    emit_branch_false(func, cond.reg, label_else)

    // parse then block
    var p = cond.next
    while p < token_count && token_kind(p) != TK_LBRACE { p = p + 1 }
    if p >= token_count { return pos }
    let then_end = find_matching_rbrace(p, token_count)
    if then_end < 0 { return pos }
    parse_block_ir(func, ctx, p + 1, then_end, token_count)
    emit_jump(func, label_end)
    emit_label(func, label_else)

    // check for else
    var after = skip_trivia(then_end + 1, token_count)
    if after < token_count && token_kind(after) == TK_ELSE {
        let after_else = after + 1
        let next_t = skip_trivia(after_else, token_count)
        if next_t < token_count && token_kind(next_t) == TK_IF {
            let end_pos = parse_if_ir(func, ctx, next_t + 1, token_count)
            emit_label(func, label_end)
            return end_pos
        }
        if next_t < token_count && token_kind(next_t) == TK_LBRACE {
            let else_end = find_matching_rbrace(next_t, token_count)
            if else_end >= 0 {
                parse_block_ir(func, ctx, next_t + 1, else_end, token_count)
                emit_label(func, label_end)
                return else_end + 1
            }
        }
    }
    emit_label(func, label_end)
    then_end + 1
}

fn parse_block_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64, close: i64, token_count: i64) with IO, Mut, Panic, Div, Alloc {
    let saved_local_count = V2_LOCAL_COUNT
    var p = skip_trivia(pos, close)
    while p < close && V2_PARSE_UNSUPPORTED == 0 {
        p = parse_stmt_ir(func, ctx, p, close, token_count)
        p = skip_trivia(p, close)
    }
    V2_LOCAL_COUNT = saved_local_count
}

fn parse_match_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64, token_count: i64) -> i64 with IO, Mut, Panic, Div, Alloc {
    // match expr { Pattern => body, ... }
    V2_LAST_STRUCT_IDX = -1
    let subj = parse_expr_ir(func, ctx, pos)
    if subj.ok == 0 { return pos }
    var p = subj.next
    while p < token_count && token_kind(p) != TK_LBRACE { p = p + 1 }
    if p >= token_count { return pos }
    let close = find_matching_rbrace(p, token_count)
    if close < 0 { return pos }
    let label_end = alloc_label()
    var cur = p + 1
    while cur < close {
        cur = skip_trivia(cur, close)
        if cur >= close { break }
        let arm_k = token_kind(cur)
        var is_wildcard = false
        var arm_val: i64 = -1
        if arm_k == TK_UNDERSCORE {
            is_wildcard = true
            cur = cur + 1
        } else if arm_k == TK_IDENT {
            if token_kind(cur + 1) == TK_COLONCOLON && token_kind(cur + 2) == TK_IDENT {
                let eidx = find_enum_idx_tok(cur)
                if eidx >= 0 { arm_val = find_enum_variant_value(eidx, cur + 2) }
                cur = cur + 3
            } else {
                var ei: i64 = 0
                while ei < ENUM_COUNT {
                    let v = find_enum_variant_value(ei, cur)
                    if v >= 0 { arm_val = v; break }
                    ei = ei + 1
                }
                cur = cur + 1
            }
        } else { cur = cur + 1; continue }
        cur = skip_trivia(cur, close)
        if cur < close && token_kind(cur) == TK_FATARROW { cur = cur + 1 }
        cur = skip_trivia(cur, close)
        if is_wildcard {
            if cur < close && token_kind(cur) == TK_LBRACE {
                let arm_close = find_matching_rbrace(cur, token_count)
                if arm_close >= 0 { parse_block_ir(func, ctx, cur + 1, arm_close, token_count); cur = arm_close + 1 }
            } else {
                V2_LAST_STRUCT_IDX = -1
                let body = parse_expr_ir(func, ctx, cur)
                if body.ok != 0 {
                    if V2_LAST_STRUCT_IDX >= 0 {
                        ufn_record_return_struct(body.reg, STRUCT_FLAT_SIZE[V2_LAST_STRUCT_IDX as usize])
                    } else { ufn_record_return(body.reg) }
                    cur = body.next
                }
            }
            break
        } else if arm_val >= 0 {
            let val_reg = alloc_reg(ctx)
            let cond_reg = alloc_reg(ctx)
            ufn_record_load_imm(val_reg, arm_val)
            ufn_record_binop(cond_reg, subj.reg, 5, val_reg)
            let label_skip = alloc_label()
            ufn_record_branch_false(cond_reg, label_skip)
            if cur < close && token_kind(cur) == TK_LBRACE {
                let arm_close = find_matching_rbrace(cur, token_count)
                if arm_close >= 0 { parse_block_ir(func, ctx, cur + 1, arm_close, token_count); cur = arm_close + 1 }
            } else {
                V2_LAST_STRUCT_IDX = -1
                let body = parse_expr_ir(func, ctx, cur)
                if body.ok != 0 {
                    if V2_LAST_STRUCT_IDX >= 0 {
                        ufn_record_return_struct(body.reg, STRUCT_FLAT_SIZE[V2_LAST_STRUCT_IDX as usize])
                    } else { ufn_record_return(body.reg) }
                    cur = body.next
                }
            }
            ufn_record_jump(label_end)
            ufn_record_label(label_skip)
            if cur < close && token_kind(cur) == TK_COMMA { cur = cur + 1 }
        } else { cur = cur + 1 }
    }
    ufn_record_label(label_end)
    close + 1
}

fn parse_stmt_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64, close: i64, token_count: i64) -> i64 with IO, Mut, Panic, Div, Alloc {
    let p = skip_trivia(pos, close)
    if p >= close { return close }
    let k = token_kind(p)

    if k == TK_IDENT && token_text_eq(p, "break") {
        if V2_BREAK_LABEL >= 0 {
            emit_jump(func, V2_BREAK_LABEL)
            return p + 1
        }
        mark_parse_unsupported(p)
        return close
    }

    if k == TK_IDENT && token_text_eq(p, "continue") {
        if V2_CONTINUE_LABEL >= 0 {
            emit_jump(func, V2_CONTINUE_LABEL)
            return p + 1
        }
        mark_parse_unsupported(p)
        return close
    }

    if k == TK_VAR || k == TK_LET {
        // var/let name : type = expr  OR  var name : type = expr
        if token_kind(p + 1) != TK_IDENT { return p + 1 }
        // Array type declaration: var name: [T; N]  (zero-initialized, no RHS required)
        if token_kind(p + 2) == TK_COLON && token_kind(p + 3) == TK_LBRACKET {
            var j = p + 4
            while j < close && token_kind(j) != TK_SEMI { j = j + 1 }
            if j < close && token_kind(j + 1) == TK_INT {
                let arr_size = pt_read_int_value(j + 1)
                let arr_base = V2_NEXT_REG
                V2_NEXT_REG = arr_base + arr_size
                let zero_reg = alloc_reg(ctx)
                ufn_record_load_imm(zero_reg, 0)
                var ai: i64 = 0
                while ai < arr_size { ufn_record_copy(arr_base + ai, zero_reg); ai = ai + 1 }
                remember_local_tok(ctx, p + 1, arr_base)
                var end = j + 2
                while end < close && token_kind(end) != TK_RBRACKET { end = end + 1 }
                // M1.2 step 4 bisect — tail-literal initializer for
                // `var arr: [T; N] = [v0, v1, ...]` or `= [val; N]`. See
                // artifacts/m1_2_parity_inventory/blockers/m1_2_step4_array_init.md
                // for the history. Bisect 3/N: each element is parsed by
                // parse_expr_ir, so floats, negated literals (`0 - N`), and
                // variable refs all work. The zero-fill above still runs;
                // parsed values are copied into the array slots below.
                if end + 1 < close && token_kind(end + 1) == TK_EQ && token_kind(end + 2) == TK_LBRACKET {
                    let rhs_open = end + 2
                    var rhs_depth: i64 = 1
                    var rhs_scan = rhs_open + 1
                    var rhs_has_semi: i64 = 0
                    var rhs_close: i64 = 0 - 1
                    while rhs_scan < close && rhs_depth > 0 {
                        let rk = token_kind(rhs_scan)
                        if rk == TK_LBRACKET { rhs_depth = rhs_depth + 1 }
                        if rk == TK_RBRACKET {
                            rhs_depth = rhs_depth - 1
                            if rhs_depth == 0 { rhs_close = rhs_scan }
                        }
                        if rk == TK_SEMI && rhs_depth == 1 { rhs_has_semi = 1 }
                        rhs_scan = rhs_scan + 1
                    }
                    if rhs_close < 0 { return end + 1 }
                    let rhs_first = rhs_open + 1
                    if rhs_has_semi != 0 {
                        // [val; N] — parse val once, copy into all slots.
                        V2_LAST_STRUCT_IDX = 0 - 1
                        let fill_parse = parse_expr_ir(func, ctx, rhs_first)
                        V2_LAST_STRUCT_IDX = 0 - 1
                        if fill_parse.ok != 0 {
                            var fi: i64 = 0
                            while fi < arr_size {
                                ufn_record_copy(arr_base + fi, fill_parse.reg)
                                fi = fi + 1
                            }
                        }
                    } else {
                        // [v0, v1, ...] — parse each element as a full expression.
                        var cur_tok = rhs_first
                        var slot_i: i64 = 0
                        while cur_tok < rhs_close && slot_i < arr_size {
                            if token_kind(cur_tok) == TK_COMMA {
                                cur_tok = cur_tok + 1
                            } else {
                                V2_LAST_STRUCT_IDX = 0 - 1
                                let elem_parse = parse_expr_ir(func, ctx, cur_tok)
                                V2_LAST_STRUCT_IDX = 0 - 1
                                if elem_parse.ok == 0 { break }
                                ufn_record_copy(arr_base + slot_i, elem_parse.reg)
                                slot_i = slot_i + 1
                                cur_tok = elem_parse.next
                            }
                        }
                    }
                    return rhs_close + 1
                }
                return end + 1
            }
        }
        var eq_pos = p + 2
        while eq_pos < close && token_kind(eq_pos) != TK_EQ { eq_pos = eq_pos + 1 }
        if eq_pos >= close { return eq_pos }
        V2_LAST_STRUCT_IDX = -1
        let parsed = parse_expr_ir(func, ctx, eq_pos + 1)
        var let_next = parsed.next
        var let_ok = parsed.ok
        var let_reg = parsed.reg
        if let_ok == 0 {
            mark_parse_unsupported(eq_pos + 1)
            return close
        }
        if V2_LAST_STRUCT_IDX >= 0 {
            let bind_sidx = V2_LAST_STRUCT_IDX
            let flat_size = STRUCT_FLAT_SIZE[bind_sidx as usize]
            let bind_base = alloc_reg(ctx)
            var bi: i64 = 1
            while bi < flat_size { let _ = alloc_reg(ctx); bi = bi + 1 }
            var ci: i64 = 0
            while ci < flat_size {
                ufn_record_copy(bind_base + ci, let_reg + ci)
                ci = ci + 1
            }
            remember_struct_local_tok(ctx, p + 1, bind_base, bind_sidx)
            V2_LAST_STRUCT_IDX = -1
            return let_next
        }
        let bind_reg = alloc_reg(ctx)
        ufn_record_copy(bind_reg, let_reg)
        remember_local_tok(ctx, p + 1, bind_reg)
        return let_next
    }

    if k == TK_RETURN {
        let after_return = skip_trivia(p + 1, close)
        if after_return >= close {
            let zero_ret = alloc_reg(ctx)
            ufn_record_load_imm(zero_ret, 0)
            ufn_record_return(zero_ret)
            return p + 1
        }
        V2_LAST_STRUCT_IDX = -1
        let parsed = parse_expr_ir(func, ctx, p + 1)
        if parsed.ok != 0 {
            if V2_LAST_STRUCT_IDX >= 0 {
                ufn_record_return_struct(parsed.reg, STRUCT_FLAT_SIZE[V2_LAST_STRUCT_IDX as usize])
                V2_LAST_STRUCT_IDX = -1
                return parsed.next
            }
            ufn_record_return(parsed.reg)
            return parsed.next
        }
        mark_parse_unsupported(p + 1)
        return close
    }

    if k == TK_WHILE {
        return parse_while_ir(func, ctx, p + 1, token_count)
    }

    if k == TK_IF {
        return parse_if_ir(func, ctx, p + 1, token_count)
    }

    if k == TK_MATCH {
        return parse_match_ir(func, ctx, p + 1, token_count)
    }

    // driver global table/scalar mutation: TABLE[idx] = expr or SCALAR = expr
    if k == TK_IDENT {
        let gid = driver_global_id_tok(p)
        if gid >= 0 && token_kind(p + 1) == TK_LBRACKET {
            let idx_expr = parse_expr_ir(func, ctx, p + 2)
            if idx_expr.ok != 0 {
                let end_pos = skip_index_cast_end(idx_expr.next)
                if token_kind(end_pos) == TK_RBRACKET && token_kind(end_pos + 1) == TK_EQ {
                    let parsed = parse_expr_ir(func, ctx, end_pos + 2)
                    if parsed.ok != 0 {
                        ufn_record_global_store(gid, idx_expr.reg, parsed.reg)
                        return parsed.next
                    }
                    mark_parse_unsupported(end_pos + 2)
                    return close
                }
            }
        }
        if gid >= 0 && token_kind(p + 1) == TK_EQ {
            let parsed = parse_expr_ir(func, ctx, p + 2)
            if parsed.ok != 0 {
                let zero = alloc_reg(ctx)
                ufn_record_load_imm(zero, 0)
                ufn_record_global_store(gid, zero, parsed.reg)
                return parsed.next
            }
            mark_parse_unsupported(p + 2)
            return close
        }
        // M1.2 step D — user-global indexed store: `NAME[expr] = expr`.
        let ugid = user_global_id_tok(p)
        if ugid >= 0 && token_kind(p + 1) == TK_LBRACKET {
            let idx_expr = parse_expr_ir(func, ctx, p + 2)
            if idx_expr.ok != 0 {
                let end_pos = skip_index_cast_end(idx_expr.next)
                if token_kind(end_pos) == TK_RBRACKET && token_kind(end_pos + 1) == TK_EQ {
                    let parsed = parse_expr_ir(func, ctx, end_pos + 2)
                    if parsed.ok != 0 {
                        ufn_record_user_global_store(ugid, idx_expr.reg, parsed.reg)
                        return parsed.next
                    }
                    mark_parse_unsupported(end_pos + 2)
                    return close
                }
            }
        }
    }

    // local array write: ident[expr] = expr
    if k == TK_IDENT && token_kind(p + 1) == TK_LBRACKET {
        let base_reg = lookup_local_tok(ctx, p)
        if base_reg >= 0 && lookup_local_is_ref_tok(ctx, p) == 0 {
            let idx_expr = parse_expr_ir(func, ctx, p + 2)
            if idx_expr.ok != 0 {
                let end_pos = skip_index_cast_end(idx_expr.next)
                if token_kind(end_pos) == TK_RBRACKET && token_kind(end_pos + 1) == TK_EQ {
                    let val = parse_expr_ir(func, ctx, end_pos + 2)
                    if val.ok != 0 {
                        ufn_record_local_store(base_reg, idx_expr.reg, val.reg)
                        return val.next
                    }
                    mark_parse_unsupported(end_pos + 2)
                    return close
                }
            }
        }
    }

    // reference field mutation: (*ctx).field = expr
    if k == TK_LPAREN && token_kind(p + 1) == TK_STAR && token_kind(p + 2) == TK_IDENT && token_kind(p + 3) == TK_RPAREN && token_kind(p + 4) == TK_DOT && token_kind(p + 5) == TK_IDENT && token_kind(p + 6) == TK_EQ {
        let base_ref = lookup_local_tok(ctx, p + 2)
        if base_ref >= 0 && lookup_local_is_ref_tok(ctx, p + 2) != 0 {
            let sidx = lookup_local_struct_idx_tok(ctx, p + 2)
            if sidx >= 0 {
                let foff = struct_field_offset_tok(sidx, p + 5)
                if foff >= 0 {
                    V2_LAST_STRUCT_IDX = -1
                    let parsed = parse_expr_ir(func, ctx, p + 7)
                    if parsed.ok != 0 {
                        ufn_record_store_ref_field(base_ref, foff, parsed.reg)
                        V2_LAST_STRUCT_IDX = -1
                        return parsed.next
                    }
                    mark_parse_unsupported(p + 7)
                    return close
                }
            }
        }
    }

    // field array write: p.buf[idx] = expr
    if k == TK_IDENT && token_kind(p + 1) == TK_DOT && token_kind(p + 2) == TK_IDENT && token_kind(p + 3) == TK_LBRACKET {
        let base_reg = lookup_local_tok(ctx, p)
        if base_reg >= 0 {
            let sidx = lookup_local_struct_idx_tok(ctx, p)
            if sidx >= 0 {
                let foff = struct_field_offset_tok(sidx, p + 2)
                if foff >= 0 {
                    let idx_expr = parse_expr_ir(func, ctx, p + 4)
                    if idx_expr.ok != 0 {
                        let end_pos = skip_index_cast_end(idx_expr.next)
                        if token_kind(end_pos) == TK_RBRACKET && token_kind(end_pos + 1) == TK_EQ {
                            let val = parse_expr_ir(func, ctx, end_pos + 2)
                            if val.ok != 0 {
                                ufn_record_local_store(base_reg + foff, idx_expr.reg, val.reg)
                                return val.next
                            }
                            mark_parse_unsupported(end_pos + 2)
                            return close
                        }
                    }
                }
            }
        }
    }

    // field mutation: p.x = expr
    if k == TK_IDENT && token_kind(p + 1) == TK_DOT && token_kind(p + 2) == TK_IDENT && token_kind(p + 3) == TK_EQ {
        let base_reg = lookup_local_tok(ctx, p)
        if base_reg >= 0 {
            let sidx = lookup_local_struct_idx_tok(ctx, p)
            if sidx >= 0 {
                let foff = struct_field_offset_tok(sidx, p + 2)
                if foff >= 0 {
                    V2_LAST_STRUCT_IDX = -1
                    let parsed = parse_expr_ir(func, ctx, p + 4)
                    if parsed.ok != 0 {
                        if V2_LAST_STRUCT_IDX >= 0 {
                            let inner_flat = STRUCT_FLAT_SIZE[V2_LAST_STRUCT_IDX as usize]
                            var ci: i64 = 0
                            while ci < inner_flat {
                                ufn_record_copy(base_reg + foff + ci, parsed.reg + ci)
                                ci = ci + 1
                            }
                            V2_LAST_STRUCT_IDX = -1
                            return parsed.next
                        }
                        ufn_record_copy(base_reg + foff, parsed.reg)
                        return parsed.next
                    }
                    mark_parse_unsupported(p + 4)
                    return close
                }
            }
        }
    }

    // assignment: name = expr  (name is already a local)
    if k == TK_IDENT && token_kind(p + 1) == TK_EQ {
        let old_reg = lookup_local_tok(ctx, p)
        if old_reg >= 0 {
            V2_LAST_STRUCT_IDX = -1
            let parsed = parse_expr_ir(func, ctx, p + 2)
            if parsed.ok != 0 {
                let asn_sidx = V2_LAST_STRUCT_IDX
                if asn_sidx >= 0 {
                    // struct copy: update all fields
                    let asn_flat = STRUCT_FLAT_SIZE[asn_sidx as usize]
                    var ci: i64 = 0
                    while ci < asn_flat {
                        if parsed.reg + ci != old_reg + ci { ufn_record_copy(old_reg + ci, parsed.reg + ci) }
                        ci = ci + 1
                    }
                    V2_LAST_STRUCT_IDX = -1
                    return parsed.next
                }
                if parsed.reg != old_reg {
                    ufn_record_copy(old_reg, parsed.reg)
                }
                return parsed.next
            }
            mark_parse_unsupported(p + 2)
            return close
        }
    }

    // call statement: name(args)  — for side-effecting calls
    // Skip this path if the call is part of a larger expression (||, &&, binop, cmp, postfix).
    // M1.2 step 4: when a tail-expression-position call is followed by a binary
    // operator (e.g. `fib(n-1) + fib(n-2)` as a block tail), we previously
    // swallowed the call as a statement and then choked on the operator.
    // Now we save UFN/reg state, speculatively parse the call, and roll back
    // if the next token continues the expression — letting the tail-expression
    // branch below re-parse the whole thing via parse_expr_ir.
    if k == TK_IDENT && token_kind(p + 1) == TK_LPAREN {
        let saved_ufn_count = V2_UFN_COUNT
        let saved_next_reg = V2_NEXT_REG
        let saved_last_struct = V2_LAST_STRUCT_IDX
        let call = parse_fn_call_ir(func, ctx, p)
        if call.ok != 0 {
            let next_k = token_kind(call.next)
            let returns_value = call_target_returns_value_tok(p)
            let continues_expr = next_k == TK_OROR || next_k == TK_ANDAND
                || is_arith_op(next_k) || is_cmp_op(next_k)
                || next_k == TK_AS || next_k == TK_DOT || next_k == TK_LBRACKET
            if !continues_expr && (call.next < close || !returns_value) {
                if V2_UFN_COUNT > 0 {
                    let last_op_idx = V2_UFN_COUNT - 1
                    let last_op = V2_UFN_OPS[last_op_idx as usize]
                    if last_op == UFN_CALL || last_op == UFN_CALL_STRUCT_RESULT {
                        V2_UFN_DST[last_op_idx as usize] = -1
                    }
                }
                return call.next
            }
            // Roll back the speculative call so the tail-expression branch
            // below can re-parse from `p` via parse_expr_ir.
            V2_UFN_COUNT = saved_ufn_count
            V2_NEXT_REG = saved_next_reg
            V2_LAST_STRUCT_IDX = saved_last_struct
        }
    }

    // tail expression (implicit return at end of block)
    V2_LAST_STRUCT_IDX = -1
    let tail = parse_expr_ir(func, ctx, p)
    if tail.ok != 0 {
        if V2_LAST_STRUCT_IDX >= 0 {
            ufn_record_return_struct(tail.reg, STRUCT_FLAT_SIZE[V2_LAST_STRUCT_IDX as usize])
            V2_LAST_STRUCT_IDX = -1
            return tail.next
        }
        ufn_record_return(tail.reg)
        return tail.next
    }

    mark_parse_unsupported(p)
    close
}

fn find_fn_lbrace(token_count: i64, name_str_pos: i64) -> i64 with Mut, Panic, Div {
    // Find the opening { of the function whose name token is at name_str_pos
    var j = name_str_pos + 1
    while j < token_count {
        if token_kind(j) == TK_LBRACE { return j }
        if token_kind(j) == TK_FN { return -1 }
        j = j + 1
    }
    -1
}

fn skip_native_v2_driver_helper_fn(name_tok: i64) -> bool with Mut, Panic, Div {
    if token_text_eq(name_tok, "token_name") { return true }
    if token_text_eq(name_tok, "token_string_name") { return true }
    if token_text_eq(name_tok, "name_eq_text") { return true }
    if token_text_eq(name_tok, "fixed_name_print") { return true }
    if token_text_eq(name_tok, "fixed_name_print_int") { return true }
    if token_text_eq(name_tok, "fixed_name_print_char") { return true }
    if token_text_eq(name_tok, "fixed_name_get_arg_count") { return true }
    if token_text_eq(name_tok, "fixed_name_arg_count") { return true }
    if token_text_eq(name_tok, "fixed_name_get_arg") { return true }
    if token_text_eq(name_tok, "fixed_name_str_eq") { return true }
    if token_text_eq(name_tok, "fixed_name_main") { return true }
    if token_text_eq(name_tok, "set_func_name_print") { return true }
    if token_text_eq(name_tok, "set_func_name_print_int") { return true }
    if token_text_eq(name_tok, "set_func_name_print_char") { return true }
    if token_text_eq(name_tok, "set_func_name_get_arg_count") { return true }
    if token_text_eq(name_tok, "set_func_name_get_arg") { return true }
    if token_text_eq(name_tok, "set_func_name_str_eq") { return true }
    if token_text_eq(name_tok, "set_func_name_main") { return true }
    if token_text_eq(name_tok, "lookup_user_fn_id") { return true }
    if token_text_eq(name_tok, "user_fn_name_at") { return true }
    if token_text_eq(name_tok, "builtin_fn_id") { return true }
    if token_text_eq(name_tok, "binary_op_from_cmp_kind") { return true }
    if token_text_eq(name_tok, "emit_instr") { return true }
    if token_text_eq(name_tok, "driver_read_file_to_cursor_source") { return true }
    if token_text_eq(name_tok, "driver_write_elf_to_file") { return true }
    if token_text_eq(name_tok, "driver_make_executable") { return true }
    false
}

// M1.2 step D — identify user-globals by their declaring identifier token.
// Returns the index into USER_GLOBAL_* arrays, or -1 if the token does not
// name a registered user-global. Matching uses the shared ident-equality
// helper so the bound identifier in `NAME[i]` reads/writes matches the
// declaration-site token.
fn user_global_id_tok(tok: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < USER_GLOBAL_COUNT {
        if toks_ident_eq(USER_GLOBAL_NAME_TOK[i as usize], tok) { return i }
        i = i + 1
    }
    0 - 1
}

// M1.2 step D — top-level scan for user-declared globals of the form
// `var NAME: [T; N]` (with or without a trailing `= [...]`). Skips any
// matching name that is already a hard-coded driver global, so the
// self-compile path continues to use drv_emit_driver_global_*. Non-scalar
// element types other than i64/f64 are skipped (handled as unsupported).
fn scan_user_globals(token_count: i64) with Mut, Panic, Div {
    USER_GLOBAL_COUNT = 0
    USER_GLOBAL_DATA_LEN = 0
    var depth: i64 = 0
    var i: i64 = 0
    while i < token_count {
        let k = token_kind(i)
        if k == TK_LBRACE { depth = depth + 1; i = i + 1 }
        else if k == TK_RBRACE { depth = depth - 1; i = i + 1 }
        else if depth == 0 && k == TK_VAR && i + 7 < token_count
                && token_kind(i + 1) == TK_IDENT
                && token_kind(i + 2) == TK_COLON
                && token_kind(i + 3) == TK_LBRACKET {
            // Skip if NAME is already a hard-coded driver global (e.g. DRV_RODATA_BYTES).
            let name_tok = i + 1
            if driver_global_id_tok(name_tok) >= 0 {
                i = i + 4
            } else {
                // Scan to matching `]` at depth 0, noting the `; INT ]` shape.
                var sc = i + 4
                while sc < token_count && token_kind(sc) != TK_SEMI && token_kind(sc) != TK_RBRACKET {
                    sc = sc + 1
                }
                if sc < token_count && token_kind(sc) == TK_SEMI
                        && sc + 2 < token_count && token_kind(sc + 1) == TK_INT
                        && token_kind(sc + 2) == TK_RBRACKET {
                    let elem_count = pt_read_int_value(sc + 1)
                    let elem_type_tok = i + 4
                    var is_f64: i64 = 0
                    if token_text_eq(elem_type_tok, "f64") { is_f64 = 1 }
                    // Accept i64 and f64 element types only. Others (i8, u32, etc.)
                    // are skipped; their references fall through to the unsupported
                    // path, which is the previous behaviour.
                    let accept_type = token_text_eq(elem_type_tok, "i64") || is_f64 != 0
                    if accept_type && USER_GLOBAL_COUNT < 64 {
                        let idx = USER_GLOBAL_COUNT
                        USER_GLOBAL_NAME_TOK[idx as usize] = name_tok
                        USER_GLOBAL_DATA_OFFSET[idx as usize] = USER_GLOBAL_DATA_LEN
                        USER_GLOBAL_ELEM_COUNT[idx as usize] = elem_count
                        USER_GLOBAL_IS_F64[idx as usize] = is_f64
                        USER_GLOBAL_DATA_LEN = USER_GLOBAL_DATA_LEN + elem_count * 8
                        USER_GLOBAL_COUNT = idx + 1
                    }
                    // Advance past the type `]` and an optional `= [...]` initializer.
                    i = sc + 3
                    if i < token_count && token_kind(i) == TK_EQ
                            && i + 1 < token_count && token_kind(i + 1) == TK_LBRACKET {
                        var bd: i64 = 1
                        i = i + 2
                        while i < token_count && bd > 0 {
                            let kk = token_kind(i)
                            if kk == TK_LBRACKET { bd = bd + 1 }
                            if kk == TK_RBRACKET { bd = bd - 1 }
                            i = i + 1
                        }
                    }
                } else {
                    i = i + 1
                }
            }
        } else {
            i = i + 1
        }
    }
}

fn scan_user_fns(token_count: i64, first_fn_id: i64) with Mut, Panic, Div {
    V2_USER_FN_COUNT = 0
    var i: i64 = 0
    var next_id = first_fn_id
    while i + 1 < token_count {
        if token_kind(i) == TK_FN && token_kind(i + 1) == TK_IDENT {
            if !token_text_eq(i + 1, "main") && !skip_native_v2_driver_helper_fn(i + 1) {
                let reg_idx = V2_USER_FN_COUNT
                register_user_fn(i + 1, next_id)
                // scan for -> ReturnType to detect struct return
                var ret_sidx: i64 = -1
                var ret_is_f64: i64 = 0
                var j = i + 2
                while j < token_count && token_kind(j) != TK_LBRACE && token_kind(j) != TK_FN {
                    if token_kind(j) == TK_ARROW {
                        if j + 1 < token_count && token_kind(j + 1) == TK_IDENT {
                            ret_sidx = find_struct_idx_tok(j + 1)
                            if token_text_eq(j + 1, "f64") {
                                ret_is_f64 = 1
                            }
                            if j + 4 < token_count && token_kind(j + 2) == TK_LT && token_kind(j + 3) == TK_IDENT && token_kind(j + 4) == TK_GT && token_text_eq(j + 3, "f64") {
                                ret_is_f64 = 1
                            }
                        }
                        break
                    }
                    j = j + 1
                }
                if reg_idx < 512 {
                    V2_USER_FN_RETURN_STRUCT_IDX[reg_idx as usize] = ret_sidx
                    V2_USER_FN_RETURN_IS_F64[reg_idx as usize] = ret_is_f64
                }
                next_id = next_id + 1
            }
            i = i + 2
        } else {
            i = i + 1
        }
    }
}

fn source_uses_ident(token_count: i64, text: string) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < token_count {
        if token_kind(i) == TK_IDENT && token_text_eq(i, text) {
            return true
        }
        i = i + 1
    }
    false
}

fn source_count_ident(token_count: i64, text: string) -> i64 with Mut, Panic, Div {
    var count: i64 = 0
    var i: i64 = 0
    while i < token_count {
        if token_kind(i) == TK_IDENT && token_text_eq(i, text) {
            count = count + 1
        }
        i = i + 1
    }
    count
}

fn drv_low8(x: i64) -> i64 with Div {
    let q = x / 256
    let n = x - (q * 256)
    if n < 0 {
        n + 256
    } else {
        n
    }
}

fn drv_emit_byte(b: i64) with Mut, Div, Panic {
    let p = DRV_CODE_LEN
    if p >= 0 && p < 262144 {
        DRV_CODE_BYTES[p as usize] = drv_low8(b) as i8
        DRV_CODE_LEN = p + 1
    }
}

fn drv_emit_u32_le(val: i64) with Mut, Div, Panic {
    var v = val
    if v < 0 { v = v + 4294967296 }
    let b0 = drv_low8(v)
    let b1 = drv_low8(v / 256)
    let b2 = drv_low8(v / 65536)
    let b3 = drv_low8(v / 16777216)
    drv_emit_byte(b0)
    drv_emit_byte(b1)
    drv_emit_byte(b2)
    drv_emit_byte(b3)
}

fn drv_emit_u64_le(val: i64) with Mut, Div, Panic {
    var v = val
    if v < 0 { v = v + 9223372036854775807 }
    let lo = v
    let hi = v / 4294967296
    drv_emit_u32_le(lo)
    drv_emit_u32_le(hi)
}

fn drv_patch_u32_le(offset: i64, val: i64) with Mut, Div, Panic {
    if offset >= 0 && offset + 4 <= DRV_CODE_LEN {
        var v = val
        if v < 0 { v = v + 4294967296 }
        let b0 = drv_low8(v)
        let b1 = drv_low8(v / 256)
        let b2 = drv_low8(v / 65536)
        let b3 = drv_low8(v / 16777216)
        DRV_CODE_BYTES[offset as usize] = b0 as i8
        DRV_CODE_BYTES[(offset + 1) as usize] = b1 as i8
        DRV_CODE_BYTES[(offset + 2) as usize] = b2 as i8
        DRV_CODE_BYTES[(offset + 3) as usize] = b3 as i8
    }
}

fn drv_modrm_rr(dst: i64, src: i64) -> i64 { 192 + (src * 8) + dst }
fn drv_modrm_rm_imm(dst: i64) -> i64 { 192 + dst }
fn drv_ir_slot_offset(vreg: i64) -> i64 { 0 - ((vreg + 1) * 8) }

fn drv_patch_frame_size(fn_id: i64, vreg_count: i64) with Mut, Div, Panic {
    if fn_id < 0 || fn_id >= 2048 { return }
    let fn_start = DRV_FN_OFFSETS[fn_id as usize]
    if fn_start < 0 { return }
    let raw = (vreg_count + 1) * 8
    let frame = ((raw + 15) / 16) * 16
    drv_patch_u32_le(fn_start + 7, frame)
}

fn drv_param_reg(idx: i64) -> i64 {
    if idx == 0 { return 7 }
    if idx == 1 { return 6 }
    if idx == 2 { return 2 }
    if idx == 3 { return 1 }
    if idx == 4 { return 8 }
    if idx == 5 { return 9 }
    -1
}

fn drv_align_page(offset: i64) -> i64 with Div {
    let q = offset / 4096
    let r = offset - (q * 4096)
    if r == 0 { return offset }
    offset + (4096 - r)
}

fn drv_global_stride() -> i64 { 262144 }
fn drv_driver_data_len() -> i64 { 22806528 }  // 87 global slots * 262144 stride (81 base + 6 user-global slots 81-86)

fn drv_emit_mov_reg_imm32(reg: i64, val: i64) with Mut, Div, Panic {
    drv_emit_byte(72)
    drv_emit_byte(199)
    drv_emit_byte(drv_modrm_rm_imm(reg))
    drv_emit_u32_le(val)
}

fn drv_emit_mov_reg_imm64(reg: i64, val: i64) with Mut, Div, Panic {
    drv_emit_byte(72)
    drv_emit_byte(184 + reg)
    drv_emit_u64_le(val)
}

fn drv_emit_mov_reg_imm(reg: i64, val: i64) with Mut, Div, Panic {
    if val >= -2147483648 && val <= 2147483647 {
        drv_emit_mov_reg_imm32(reg, val)
    } else {
        drv_emit_mov_reg_imm64(reg, val)
    }
}

fn drv_emit_mov_rax_imm(val: i64) with Mut, Div, Panic { drv_emit_mov_reg_imm(0, val) }

fn drv_emit_mov_reg_reg(dst: i64, src: i64) with Mut, Div, Panic {
    if dst >= 8 || src >= 8 {
        var rex = 72
        if src >= 8 { rex = rex + 4 }
        if dst >= 8 { rex = rex + 1 }
        drv_emit_byte(rex)
        drv_emit_byte(137)
        drv_emit_byte(drv_modrm_rr(dst - ((dst / 8) * 8), src - ((src / 8) * 8)))
    } else {
        drv_emit_byte(72)
        drv_emit_byte(137)
        drv_emit_byte(drv_modrm_rr(dst, src))
    }
}

