fn drv_add_data_reloc(patch_offset: i64, data_off: i64) with Mut, Panic {
    drv_add_reloc(patch_offset, 3, data_off)
}

fn drv_define_label(label_id: i64) with Mut, Panic {
    if label_id >= 0 && label_id < 256 {
        DRV_LABEL_OFFSETS[label_id as usize] = DRV_CODE_LEN
    }
}

fn drv_add_label_patch(patch_offset: i64, label_id: i64) with Mut, Panic {
    let idx = DRV_LABEL_PATCH_COUNT
    if idx >= 0 && idx < 256 {
        DRV_LABEL_PATCH_OFFSETS[idx as usize] = patch_offset
        DRV_LABEL_PATCH_IDS[idx as usize] = label_id
        DRV_LABEL_PATCH_COUNT = idx + 1
    }
}

fn drv_patch_labels() with Mut, Div, Panic {
    var i: i64 = 0
    while i < DRV_LABEL_PATCH_COUNT {
        let off = DRV_LABEL_PATCH_OFFSETS[i as usize]
        let lid = DRV_LABEL_PATCH_IDS[i as usize]
        if lid >= 0 && lid < 256 {
            let target = DRV_LABEL_OFFSETS[lid as usize]
            let rel = target - (off + 4)
            drv_patch_u32_le(off, rel)
        }
        i = i + 1
    }
}

fn drv_reset_function_state() with Mut, Panic {
    DRV_LABEL_PATCH_COUNT = 0
    var i: i64 = 0
    while i < 256 {
        DRV_LABEL_OFFSETS[i as usize] = -1
        i = i + 1
    }
}

fn drv_reset_codegen(fn_count: i64) with Mut, Panic {
    DRV_CODE_LEN = 0
    DRV_RODATA_LEN = 0
    DRV_RELOC_COUNT = 0
    DRV_FN_COUNT = fn_count
    DRV_ENTRY_OFFSET = 0
    DRV_LABEL_PATCH_COUNT = 0
    var i: i64 = 0
    while i < 2048 {
        DRV_FN_OFFSETS[i as usize] = -1
        i = i + 1
    }
    i = 0
    while i < 256 {
        DRV_LABEL_OFFSETS[i as usize] = -1
        i = i + 1
    }
}

fn drv_rodata_append_byte(byte: i64) with Mut, Div, Panic {
    let p = DRV_RODATA_LEN
    if p >= 0 && p < 65536 {
        DRV_RODATA_BYTES[p as usize] = drv_low8(byte) as i8
        DRV_RODATA_LEN = p + 1
    }
}

fn driver_append_ufn_string_literal(idx: i64) -> i64 with Mut, Panic, Div {
    let offset = DRV_RODATA_LEN
    let start = V2_UFN_STR_START[idx as usize] + 1
    let end = V2_UFN_STR_END[idx as usize] - 1
    var i: i64 = start
    while i < end {
        let ch = CURSOR_SOURCE[i as usize]
        if ch == 92 as i8 && i + 1 < end {
            let esc = CURSOR_SOURCE[(i + 1) as usize]
            if esc == 110 as i8 { drv_rodata_append_byte(10) }
            else if esc == 116 as i8 { drv_rodata_append_byte(9) }
            else if esc == 114 as i8 { drv_rodata_append_byte(13) }
            else if esc == 34 as i8 { drv_rodata_append_byte(34) }
            else if esc == 92 as i8 { drv_rodata_append_byte(92) }
            else { drv_rodata_append_byte(esc as i64) }
            i = i + 2
        } else {
            drv_rodata_append_byte(ch as i64)
            i = i + 1
        }
    }
    drv_rodata_append_byte(0)
    offset
}

fn drv_begin_function(fn_id: i64) with Mut, Panic, Div {
    drv_reset_function_state()
    if fn_id >= 0 && fn_id < 2048 {
        DRV_FN_OFFSETS[fn_id as usize] = DRV_CODE_LEN
    }
    drv_emit_push_rbp()
    drv_emit_mov_rbp_rsp()
    drv_emit_sub_rsp_imm32(262144)
    var i: i64 = 0
    while i < V2_CURRENT_PARAM_COUNT && i < 6 {
        let vreg = V2_CURRENT_PARAM_REGS[i as usize]
        let preg = drv_param_reg(i)
        if vreg >= 0 && preg >= 0 {
            drv_emit_store_rbp_disp32_reg(preg, drv_ir_slot_offset(vreg))
        }
        i = i + 1
    }
}

fn drv_emit_load_imm(dst: i64, value: i64) with Mut, Panic, Div {
    drv_emit_mov_rax_imm(value)
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_load_string_offset(dst: i64, ro_off: i64) with Mut, Panic, Div {
    let lea_pos = DRV_CODE_LEN
    drv_emit_lea_rax_rip_disp32(0)
    let reloc_idx = DRV_RELOC_COUNT
    if reloc_idx >= 0 && reloc_idx < 4096 {
        DRV_RELOC_OFFSETS[reloc_idx as usize] = lea_pos + 3
        DRV_RELOC_TARGETS[reloc_idx as usize] = drv_encode_reloc_target(2, ro_off)
        DRV_RELOC_COUNT = reloc_idx + 1
    }
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_any_binop(dst: i64, lhs: i64, op_code: i64, rhs: i64) -> bool with Mut, Panic, Div {
    if op_code == 1 {
        drv_core_load_temp_to_rax(lhs)
        drv_emit_push_rax()
        drv_core_load_temp_to_rax(rhs)
        drv_emit_pop_rbx()
        drv_emit_add_rax_rbx()
        drv_core_store_rax_to_temp(dst)
        return true
    }
    if op_code == 2 {
        drv_core_load_temp_to_rax(rhs)
        drv_emit_push_rax()
        drv_core_load_temp_to_rax(lhs)
        drv_emit_pop_rbx()
        drv_emit_sub_rax_rbx()
        drv_core_store_rax_to_temp(dst)
        return true
    }
    if op_code == 3 {
        drv_core_load_temp_to_rax(lhs)
        drv_emit_push_rax()
        drv_core_load_temp_to_rax(rhs)
        drv_emit_pop_rbx()
        drv_emit_imul_rax_rbx()
        drv_core_store_rax_to_temp(dst)
        return true
    }
    if op_code == 4 {
        drv_core_load_temp_to_rax(rhs)
        drv_emit_mov_reg_reg(1, 0)
        drv_core_load_temp_to_rax(lhs)
        drv_emit_cqo()
        drv_emit_idiv_rcx()
        drv_core_store_rax_to_temp(dst)
        return true
    }
    if op_code >= 5 && op_code <= 10 {
        drv_core_load_temp_to_rax(rhs)
        drv_emit_push_rax()
        drv_core_load_temp_to_rax(lhs)
        drv_emit_pop_rbx()
        drv_emit_cmp_rax_rbx()
        if op_code == 5 { drv_emit_setcc_al(148) }
        else if op_code == 6 { drv_emit_setcc_al(149) }
        else if op_code == 7 { drv_emit_setcc_al(156) }
        else if op_code == 8 { drv_emit_setcc_al(158) }
        else if op_code == 9 { drv_emit_setcc_al(159) }
        else { drv_emit_setcc_al(157) }
        drv_emit_movzx_rax_al()
        drv_core_store_rax_to_temp(dst)
        return true
    }
    false
}

fn drv_emit_load_f64_scaled(dst: i64, mantissa: i64, scale: i64) with Mut, Panic, Div {
    drv_emit_mov_rax_imm(mantissa)
    drv_emit_cvtsi2sd_xmm0_rax()
    drv_emit_mov_rax_imm(scale)
    drv_emit_cvtsi2sd_xmm1_rax()
    drv_emit_sse2_xmm0_xmm1(94)
    drv_emit_store_xmm0_to_temp(dst)
}

fn drv_emit_f64_binop(dst: i64, lhs: i64, op_code: i64, rhs: i64) -> bool with Mut, Panic, Div {
    drv_emit_load_temp_to_xmm0(lhs)
    drv_emit_load_temp_to_xmm1(rhs)
    if op_code == 1 {
        drv_emit_sse2_xmm0_xmm1(88)
        drv_emit_store_xmm0_to_temp(dst)
        return true
    }
    if op_code == 2 {
        drv_emit_sse2_xmm0_xmm1(92)
        drv_emit_store_xmm0_to_temp(dst)
        return true
    }
    if op_code == 3 {
        drv_emit_sse2_xmm0_xmm1(89)
        drv_emit_store_xmm0_to_temp(dst)
        return true
    }
    if op_code == 4 {
        drv_emit_sse2_xmm0_xmm1(94)
        drv_emit_store_xmm0_to_temp(dst)
        return true
    }
    if op_code >= 5 && op_code <= 10 {
        drv_emit_ucomisd_xmm0_xmm1()
        if op_code == 5 { drv_emit_setcc_al(148) }
        else if op_code == 6 { drv_emit_setcc_al(149) }
        else if op_code == 7 { drv_emit_setcc_al(146) }
        else if op_code == 8 { drv_emit_setcc_al(150) }
        else if op_code == 9 { drv_emit_setcc_al(151) }
        else { drv_emit_setcc_al(147) }
        drv_emit_movzx_rax_al()
        drv_core_store_rax_to_temp(dst)
        return true
    }
    false
}

fn drv_emit_sqrt_f64(dst: i64, src: i64) with Mut, Div, Panic {
    drv_emit_load_temp_to_xmm1(src)
    drv_emit_sse2_xmm0_xmm1(81)
    drv_emit_store_xmm0_to_temp(dst)
}

fn drv_emit_call_builtin0(fn_id: i64) with Mut, Panic, Div {
    let call_pos = DRV_CODE_LEN
    drv_emit_call_rel32_placeholder()
    drv_add_call_reloc(call_pos + 1, fn_id)
}

fn drv_emit_print_int_from_rax() with Mut, Panic, Div {
    drv_emit_mov_rdi_rax()
    drv_emit_call_builtin0(V2_BUILTIN_PRINT_INT)
}

fn drv_emit_print_char_imm(ch: i64) with Mut, Panic, Div {
    drv_emit_mov_reg_imm(7, ch)
    drv_emit_call_builtin0(V2_BUILTIN_PRINT_CHAR)
}

fn drv_emit_print_f64_from_xmm0() with Mut, Panic, Div {
    // Scale value by 1000: rax = trunc(value * 1000) as signed i64
    drv_emit_mov_rax_imm(1000)
    drv_emit_cvtsi2sd_xmm1_rax()
    drv_emit_sse2_xmm0_xmm1(89)
    drv_emit_cvttsd2si_rax_xmm0()
    // Handle sign: push/pop preserves rax across print_char call (which clobbers rax)
    // jns_rel8(17) skips: push(1) + print_char(12) + pop(1) + neg(3) = 17 bytes
    drv_emit_test_rax_rax()
    drv_emit_jns_rel8(17)
    drv_emit_push_rax()
    drv_emit_print_char_imm(45)
    drv_emit_pop_rax()
    drv_emit_neg_rax()
    // Unsigned divide: rax(≥0) / 1000 → rax=int part, rdx=frac (0..999)
    drv_emit_mov_reg_imm(1, 1000)
    drv_emit_xor_rdx_rdx()
    drv_emit_div_rcx()
    // Print integer part and '.'
    drv_emit_push_rdx()
    drv_emit_print_int_from_rax()
    drv_emit_print_char_imm(46)
    drv_emit_pop_rax()
    // Print frac as exactly 3 digits — push/pop preserves frac across each print_char call
    // Pattern: push frac; [cmp; jae_rel8(14); pop+push+print_char('0'); ]; pop frac
    // jae_rel8(14) skips: pop(1) + push(1) + print_char(12) = 14 bytes
    drv_emit_push_rax()
    drv_emit_cmp_rax_imm8(100)
    drv_emit_jae_rel8(14)
    drv_emit_pop_rax()
    drv_emit_push_rax()
    drv_emit_print_char_imm(48)
    drv_emit_pop_rax()
    drv_emit_push_rax()
    drv_emit_cmp_rax_imm8(10)
    drv_emit_jae_rel8(14)
    drv_emit_pop_rax()
    drv_emit_push_rax()
    drv_emit_print_char_imm(48)
    drv_emit_pop_rax()
    drv_emit_print_int_from_rax()
}

fn drv_emit_print_f64(arg_reg: i64) with Mut, Panic, Div {
    drv_emit_load_temp_to_xmm0(arg_reg)
    drv_emit_print_f64_from_xmm0()
}

fn drv_emit_call_argc(dst: i64, fn_id: i64, arg0: i64, argc: i64) with Mut, Panic, Div {
    if argc >= 1 { drv_emit_load_rbp_disp32_reg(7, drv_ir_slot_offset(arg0)) }
    if argc >= 2 { drv_emit_load_rbp_disp32_reg(6, drv_ir_slot_offset(arg0 + 1)) }
    if argc >= 3 { drv_emit_load_rbp_disp32_reg(2, drv_ir_slot_offset(arg0 + 2)) }
    if argc >= 4 { drv_emit_load_rbp_disp32_reg(1, drv_ir_slot_offset(arg0 + 3)) }
    if argc >= 5 { drv_emit_load_rbp_disp32_reg(8, drv_ir_slot_offset(arg0 + 4)) }
    if argc >= 6 { drv_emit_load_rbp_disp32_reg(9, drv_ir_slot_offset(arg0 + 5)) }
    let call_pos = DRV_CODE_LEN
    drv_emit_call_rel32_placeholder()
    drv_add_call_reloc(call_pos + 1, fn_id)
    if dst >= 0 { drv_core_store_rax_to_temp(dst) }
}

fn drv_emit_call1(dst: i64, fn_id: i64, arg: i64, argc: i64) with Mut, Panic, Div {
    if argc > 0 {
        drv_core_load_temp_to_rax(arg)
        drv_emit_mov_rdi_rax()
    }
    let call_pos = DRV_CODE_LEN
    drv_emit_call_rel32_placeholder()
    drv_add_call_reloc(call_pos + 1, fn_id)
    if dst >= 0 { drv_core_store_rax_to_temp(dst) }
}

fn drv_emit_return(src: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(src)
    drv_emit_mov_rsp_rbp()
    drv_emit_pop_rbp()
    drv_emit_ret()
}

fn drv_emit_return_struct(base_reg: i64, fcount: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(base_reg)
    if fcount >= 2 { drv_emit_load_rbp_disp32_reg(2, drv_ir_slot_offset(base_reg + 1)) }
    if fcount >= 3 { drv_emit_load_rbp_disp32_reg(1, drv_ir_slot_offset(base_reg + 2)) }
    if fcount >= 4 { drv_emit_load_rbp_disp32_reg(8, drv_ir_slot_offset(base_reg + 3)) }
    if fcount >= 5 { drv_emit_load_rbp_disp32_reg(9, drv_ir_slot_offset(base_reg + 4)) }
    if fcount >= 6 { drv_emit_load_rbp_disp32_reg(10, drv_ir_slot_offset(base_reg + 5)) }
    drv_emit_mov_rsp_rbp()
    drv_emit_pop_rbp()
    drv_emit_ret()
}

fn drv_emit_reg_to_temp(reg: i64, dst: i64) with Mut, Panic, Div {
    if dst >= 0 { drv_emit_store_rbp_disp32_reg(reg, drv_ir_slot_offset(dst)) }
}

fn drv_emit_rdx_to_temp(dst: i64) with Mut, Panic, Div {
    drv_emit_reg_to_temp(2, dst)
}

fn drv_emit_copy(dst: i64, src: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(src)
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_temp_addr(dst: i64, src: i64) with Mut, Panic, Div {
    drv_emit_lea_rax_rbp_disp32(drv_ir_slot_offset(src))
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_load_ref_field(dst: i64, base_ref: i64, field_offset_words: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(base_ref)
    drv_emit_mov_reg_reg(3, 0)
    drv_emit_load_rax_mem_rbx_disp32(field_offset_words * 8)
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_store_ref_field(base_ref: i64, field_offset_words: i64, src: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(base_ref)
    drv_emit_push_rax()
    drv_core_load_temp_to_rax(src)
    drv_emit_pop_rbx()
    drv_emit_store_rax_mem_rbx_disp32(field_offset_words * 8)
}

fn drv_global_is_byte(global_id: i64) -> bool {
    global_id == V2_GLOBAL_CURSOR_SOURCE || global_id == V2_GLOBAL_DRV_CODE_BYTES || global_id == V2_GLOBAL_DRV_RODATA_BYTES || global_id == V2_GLOBAL_DRV_ELF_BYTES
}

fn drv_emit_driver_global_load(dst: i64, global_id: i64, index_reg: i64) with Mut, Panic, Div {
    let load_pos = DRV_CODE_LEN + 3
    drv_emit_lea_rax_rip_disp32(0)
    drv_add_data_reloc(load_pos, 4096 + (global_id * drv_global_stride()))
    drv_emit_mov_reg_reg(2, 0)
    drv_core_load_temp_to_rax(index_reg)
    drv_emit_mov_reg_reg(3, 0)
    if drv_global_is_byte(global_id) { drv_emit_movzx_rax_byte_rdx_rbx() }
    else { drv_emit_load_rax_mem_rdx_rbx8() }
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_driver_global_store(global_id: i64, index_reg: i64, src: i64) with Mut, Panic, Div {
    let load_pos = DRV_CODE_LEN + 3
    drv_emit_lea_rax_rip_disp32(0)
    drv_add_data_reloc(load_pos, 4096 + (global_id * drv_global_stride()))
    drv_emit_mov_reg_reg(2, 0)
    drv_core_load_temp_to_rax(index_reg)
    drv_emit_mov_reg_reg(3, 0)
    drv_core_load_temp_to_rax(src)
    if drv_global_is_byte(global_id) { drv_emit_store_al_mem_rdx_rbx() }
    else { drv_emit_store_rax_mem_rdx_rbx8() }
}

// M1.2 step D — user-global load: `rax = data[user_global_offset + idx*8]`.
// Uses kind=3 relocations (already wired in drv_apply_relocations) which
// patch the rip-relative lea to the .data file offset. The index register
// is loaded into rbx and rdx holds the base; indexed load is 8 bytes.
fn drv_emit_user_global_load(dst: i64, ug_idx: i64, index_reg: i64) with Mut, Panic, Div {
    let data_offset = USER_GLOBAL_DATA_OFFSET[ug_idx as usize]
    let load_pos = DRV_CODE_LEN + 3
    drv_emit_lea_rax_rip_disp32(0)
    drv_add_data_reloc(load_pos, data_offset)
    drv_emit_mov_reg_reg(2, 0)
    drv_core_load_temp_to_rax(index_reg)
    drv_emit_mov_reg_reg(3, 0)
    drv_emit_load_rax_mem_rdx_rbx8()
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_user_global_store(ug_idx: i64, index_reg: i64, src: i64) with Mut, Panic, Div {
    let data_offset = USER_GLOBAL_DATA_OFFSET[ug_idx as usize]
    let load_pos = DRV_CODE_LEN + 3
    drv_emit_lea_rax_rip_disp32(0)
    drv_add_data_reloc(load_pos, data_offset)
    drv_emit_mov_reg_reg(2, 0)
    drv_core_load_temp_to_rax(index_reg)
    drv_emit_mov_reg_reg(3, 0)
    drv_core_load_temp_to_rax(src)
    drv_emit_store_rax_mem_rdx_rbx8()
}

fn drv_emit_local_array_load(dst: i64, base_reg: i64, idx_reg: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(idx_reg)
    drv_emit_neg_rax_only()
    drv_emit_mov_reg_reg(3, 0)
    drv_emit_lea_rax_rbp_disp32(drv_ir_slot_offset(base_reg))
    drv_emit_mov_rax_mem_rax_rbx8()
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_local_array_store(base_reg: i64, idx_reg: i64, src: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(idx_reg)
    drv_emit_neg_rax_only()
    drv_emit_mov_reg_reg(3, 0)
    drv_emit_lea_rax_rbp_disp32(drv_ir_slot_offset(base_reg))
    drv_emit_mov_reg_reg(2, 0)
    drv_core_load_temp_to_rax(src)
    drv_emit_store_rax_mem_rdx_rbx8()
}

fn drv_emit_arg_count(dst: i64) with Mut, Panic, Div {
    drv_emit_byte(73)
    drv_emit_byte(139)
    drv_emit_byte(6)
    drv_emit_byte(72)
    drv_emit_byte(131)
    drv_emit_byte(232)
    drv_emit_byte(1)
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_get_arg(dst: i64, arg_reg: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(arg_reg)
    drv_emit_mov_reg_reg(3, 0)
    drv_emit_byte(73)
    drv_emit_byte(141)
    drv_emit_byte(70)
    drv_emit_byte(16)
    drv_emit_mov_rax_mem_rax_rbx8()
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_str_len(dst: i64, arg_reg: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(arg_reg)
    drv_emit_mov_reg_reg(7, 0)
    drv_emit_xor_rcx_rcx()
    drv_emit_movzx_rax_byte_rdi()
    drv_emit_test_al_al()
    drv_emit_jz_rel8(8)
    drv_emit_inc_rdi()
    drv_emit_inc_rcx()
    drv_emit_jmp_rel8(-16)
    drv_emit_mov_reg_reg(0, 1)
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_str_char_at(dst: i64, arg0_reg: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(arg0_reg)
    drv_emit_mov_reg_reg(7, 0)
    drv_core_load_temp_to_rax(arg0_reg + 1)
    drv_emit_mov_reg_reg(3, 0)
    drv_emit_movzx_rax_byte_rdi_rbx()
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_str_eq(dst: i64, arg0_reg: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(arg0_reg)
    drv_emit_mov_reg_reg(7, 0)
    drv_core_load_temp_to_rax(arg0_reg + 1)
    drv_emit_mov_reg_reg(6, 0)
    drv_emit_movzx_rax_byte_rdi()
    drv_emit_cmp_al_mem_rsi()
    drv_emit_jnz_rel8(12)
    drv_emit_test_al_al()
    drv_emit_jz_rel8(13)
    drv_emit_inc_rdi()
    drv_emit_inc_rsi()
    drv_emit_jmp_rel8(-20)
    drv_emit_xor_rax_rax()
    drv_emit_jmp_rel8(7)
    drv_emit_mov_rax_imm(1)
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_driver_read_file(dst: i64, path_reg: i64, source_global_id: i64, len_global_id: i64, max_len: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(path_reg)
    drv_emit_mov_reg_reg(7, 0)
    drv_emit_mov_rax_imm(2)
    drv_emit_mov_reg_imm(6, 0)
    drv_emit_mov_reg_imm(2, 0)
    drv_emit_syscall()
    drv_emit_mov_reg_reg(12, 0)
    drv_emit_mov_reg_reg(7, 12)
    let source_pos = DRV_CODE_LEN + 3
    drv_emit_lea_rax_rip_disp32(0)
    drv_add_data_reloc(source_pos, 4096 + (source_global_id * drv_global_stride()))
    drv_emit_mov_reg_reg(6, 0)
    drv_emit_mov_reg_imm(2, max_len)
    drv_emit_mov_rax_imm(0)
    drv_emit_syscall()
    drv_core_store_rax_to_temp(dst)
    drv_emit_push_rax()
    let len_pos = DRV_CODE_LEN + 3
    drv_emit_lea_rax_rip_disp32(0)
    drv_add_data_reloc(len_pos, 4096 + (len_global_id * drv_global_stride()))
    drv_emit_mov_reg_reg(2, 0)
    drv_emit_mov_reg_imm(3, 0)
    drv_emit_pop_rax()
    drv_emit_store_rax_mem_rdx_rbx8()
}

fn compile_ufn_from_globals(fn_id: i64) -> bool with IO, Mut, Panic, Div {
    drv_begin_function(fn_id)
    var i: i64 = 0
    while i < V2_UFN_COUNT {
        let op = V2_UFN_OPS[i as usize]
        let src1_val = V2_UFN_SRC1[i as usize]
        if op == UFN_LOAD_IMM {
            drv_emit_load_imm(V2_UFN_DST[i as usize], V2_UFN_IMM[i as usize])
        } else if op == UFN_LOAD_F64_SCALED {
            drv_emit_load_f64_scaled(V2_UFN_DST[i as usize], V2_UFN_IMM[i as usize], V2_UFN_FLOAT_SCALE[i as usize])
        } else if op == UFN_LOAD_STRING {
            let ro_off = driver_append_ufn_string_literal(i)
            drv_emit_load_string_offset(V2_UFN_DST[i as usize], ro_off)
        } else if op == UFN_BINOP {
            if !drv_emit_any_binop(V2_UFN_DST[i as usize], src1_val, V2_UFN_BINOP_CODE[i as usize], V2_UFN_SRC2[i as usize]) {
                return false
            }
        } else if op == UFN_F64_BINOP {
            if !drv_emit_f64_binop(V2_UFN_DST[i as usize], src1_val, V2_UFN_BINOP_CODE[i as usize], V2_UFN_SRC2[i as usize]) {
                return false
            }
        } else if op == UFN_LABEL {
            drv_define_label(V2_UFN_LABEL_ID[i as usize])
        } else if op == UFN_JUMP {
            let jmp_pos = DRV_CODE_LEN
            drv_emit_jmp_rel32()
            drv_add_label_patch(jmp_pos + 1, V2_UFN_LABEL_ID[i as usize])
        } else if op == UFN_BRANCH_FALSE {
            drv_core_load_temp_to_rax(V2_UFN_SRC1[i as usize])
            drv_emit_test_rax_rax()
            let jz_pos = DRV_CODE_LEN
            drv_emit_jz_rel32()
            drv_add_label_patch(jz_pos + 2, V2_UFN_LABEL_ID[i as usize])
        } else if op == UFN_RETURN {
            drv_emit_return(V2_UFN_SRC1[i as usize])
        } else if op == UFN_RETURN_STRUCT {
            drv_emit_return_struct(V2_UFN_SRC1[i as usize], V2_UFN_IMM[i as usize])
        } else if op == UFN_CALL {
            let call_argc = V2_UFN_IMM[i as usize]
            let call_fn_id = V2_UFN_FN_ID[i as usize]
            if call_fn_id == V2_BUILTIN_ARG_COUNT {
                drv_emit_arg_count(V2_UFN_DST[i as usize])
            } else if call_fn_id == V2_BUILTIN_PRINT_F64 {
                drv_emit_print_f64(V2_UFN_SRC1[i as usize])
            } else if call_fn_id == V2_BUILTIN_SQRT_F64 {
                drv_emit_sqrt_f64(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize])
            } else if call_fn_id == V2_BUILTIN_GET_ARG {
                drv_emit_get_arg(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize])
            } else if call_fn_id == V2_BUILTIN_STR_LEN {
                drv_emit_str_len(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize])
            } else if call_fn_id == V2_BUILTIN_STR_CHAR_AT {
                drv_emit_str_char_at(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize])
            } else if call_fn_id == V2_BUILTIN_STR_EQ {
                drv_emit_str_eq(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize])
            } else if call_fn_id == V2_BUILTIN_PT_READ_KIND_CODE {
                drv_emit_driver_global_load(V2_UFN_DST[i as usize], V2_GLOBAL_PT_KIND_CODE, V2_UFN_SRC1[i as usize])
            } else if call_fn_id == V2_BUILTIN_PT_READ_START {
                drv_emit_driver_global_load(V2_UFN_DST[i as usize], V2_GLOBAL_PT_START, V2_UFN_SRC1[i as usize])
            } else if call_fn_id == V2_BUILTIN_PT_READ_END {
                drv_emit_driver_global_load(V2_UFN_DST[i as usize], V2_GLOBAL_PT_END, V2_UFN_SRC1[i as usize])
            } else if call_fn_id == V2_BUILTIN_PT_READ_INT_VALUE {
                drv_emit_driver_global_load(V2_UFN_DST[i as usize], V2_GLOBAL_PT_INT_VALUE, V2_UFN_SRC1[i as usize])
            } else if call_fn_id == V2_BUILTIN_DRIVER_READ_FILE_TO_GLOBALS {
                drv_emit_driver_read_file(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize], V2_GLOBAL_CURSOR_SOURCE, V2_GLOBAL_CURSOR_SOURCE_LEN, drv_global_stride())
            } else if call_argc > 1 {
                drv_emit_call_argc(V2_UFN_DST[i as usize], V2_UFN_FN_ID[i as usize], V2_UFN_SRC1[i as usize], call_argc)
            } else {
                drv_emit_call1(V2_UFN_DST[i as usize], V2_UFN_FN_ID[i as usize], V2_UFN_SRC1[i as usize], call_argc)
            }
        } else if op == UFN_CALL_STRUCT_RESULT {
            drv_emit_call_argc(V2_UFN_DST[i as usize], V2_UFN_FN_ID[i as usize], V2_UFN_SRC1[i as usize], V2_UFN_IMM[i as usize])
            let rf = V2_UFN_RESULT_FCOUNT[i as usize]
            if V2_UFN_DST[i as usize] >= 0 {
                if rf >= 2 { drv_emit_reg_to_temp(2, V2_UFN_DST[i as usize] + 1) }
                if rf >= 3 { drv_emit_reg_to_temp(1, V2_UFN_DST[i as usize] + 2) }
                if rf >= 4 { drv_emit_reg_to_temp(8, V2_UFN_DST[i as usize] + 3) }
                if rf >= 5 { drv_emit_reg_to_temp(9, V2_UFN_DST[i as usize] + 4) }
                if rf >= 6 { drv_emit_reg_to_temp(10, V2_UFN_DST[i as usize] + 5) }
            }
        } else if op == UFN_COPY {
            drv_emit_copy(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize])
        } else if op == UFN_TEMP_ADDR {
            drv_emit_temp_addr(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize])
        } else if op == UFN_LOAD_REF_FIELD {
            drv_emit_load_ref_field(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize], V2_UFN_IMM[i as usize])
        } else if op == UFN_STORE_REF_FIELD {
            drv_emit_store_ref_field(V2_UFN_SRC1[i as usize], V2_UFN_IMM[i as usize], V2_UFN_SRC2[i as usize])
        } else if op == UFN_GLOBAL_LOAD {
            drv_emit_driver_global_load(V2_UFN_DST[i as usize], V2_UFN_IMM[i as usize], V2_UFN_SRC1[i as usize])
        } else if op == UFN_GLOBAL_STORE {
            drv_emit_driver_global_store(V2_UFN_IMM[i as usize], V2_UFN_SRC1[i as usize], V2_UFN_SRC2[i as usize])
        } else if op == UFN_LOCAL_LOAD {
            drv_emit_local_array_load(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize], V2_UFN_SRC2[i as usize])
        } else if op == UFN_LOCAL_STORE {
            drv_emit_local_array_store(V2_UFN_SRC1[i as usize], V2_UFN_SRC2[i as usize], V2_UFN_DST[i as usize])
        } else if op == UFN_USER_GLOBAL_LOAD {
            drv_emit_user_global_load(V2_UFN_DST[i as usize], V2_UFN_IMM[i as usize], V2_UFN_SRC1[i as usize])
        } else if op == UFN_USER_GLOBAL_STORE {
            drv_emit_user_global_store(V2_UFN_IMM[i as usize], V2_UFN_SRC1[i as usize], V2_UFN_SRC2[i as usize])
        }
        i = i + 1
    }
    drv_patch_labels()
    true
}

fn compile_user_fn(fn_name_tok: i64, fn_id: i64, token_count: i64) -> bool with IO, Mut, Panic, Div, Alloc {
    // Find fn name_str_pos
    var name_pos: i64 = -1
    var i: i64 = 0
    while i + 1 < token_count {
        if token_kind(i) == TK_FN && token_kind(i + 1) == TK_IDENT {
            if toks_ident_eq(i + 1, fn_name_tok) {
                name_pos = i + 1
                i = token_count
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    if name_pos < 0 {
        print("native_compile: unsupported_frontend fn=")
        print_token_text(fn_name_tok)
        print(" reason=name_not_found\n")
        return false
    }
    let open_pos = find_fn_lbrace(token_count, name_pos)
    if open_pos < 0 {
        print("native_compile: unsupported_frontend fn=")
        print_token_text(fn_name_tok)
        print(" reason=no_open_brace\n")
        return false
    }
    let close_pos = find_matching_rbrace(open_pos, token_count)
    if close_pos < 0 {
        print("native_compile: unsupported_frontend fn=")
        print_token_text(fn_name_tok)
        print(" reason=unbalanced_braces\n")
        return false
    }

    var ctx = v2_driver_context_new()
    reset_locals(&! ctx)
    reset_user_fn_label_state()
    reset_parse_unsupported()
    V2_CURRENT_PARAM_COUNT = 0
    var func: i64 = 0

    // Parse parameters: fn name(param: type, ...) -> ...
    // params are between '(' and ')'
    var pp = name_pos + 1
    while pp < open_pos && token_kind(pp) != TK_LPAREN { pp = pp + 1 }
    if pp < open_pos && token_kind(pp) == TK_LPAREN {
        var param_idx: i64 = 0
        var ppos = pp + 1
        while ppos < open_pos && token_kind(ppos) != TK_RPAREN {
            if token_kind(ppos) == TK_IDENT {
                let param_name_tok = ppos
                // peek at type: param_name : TypeName
                var param_sidx: i64 = -1
                var param_is_ref: i64 = 0
                var param_generic_f64: i64 = 0
                if ppos + 2 < open_pos && token_kind(ppos + 1) == TK_COLON && token_kind(ppos + 2) == TK_IDENT {
                    param_sidx = find_struct_idx_tok(ppos + 2)
                    if ppos + 5 < open_pos && token_kind(ppos + 3) == TK_LT && token_kind(ppos + 4) == TK_IDENT && token_kind(ppos + 5) == TK_GT && token_text_eq(ppos + 4, "f64") {
                        param_generic_f64 = 1
                    }
                }
                if ppos + 3 < open_pos && token_kind(ppos + 1) == TK_COLON && token_kind(ppos + 2) == TK_AMPBANG && token_kind(ppos + 3) == TK_IDENT {
                    param_sidx = find_struct_idx_tok(ppos + 3)
                    param_is_ref = 1
                }
                if param_sidx >= 0 && param_is_ref != 0 {
                    let vreg = alloc_reg(&! ctx)
                    remember_ref_struct_local_tok(&! ctx, param_name_tok, vreg, param_sidx)
                    if param_idx < 64 {
                        V2_CURRENT_PARAM_REGS[param_idx as usize] = vreg
                    }
                    V2_CURRENT_PARAM_COUNT = param_idx + 1
                    param_idx = param_idx + 1
                } else if param_sidx >= 0 {
                    // struct param: allocate flat_size consecutive vregs
                    let flat_size = STRUCT_FLAT_SIZE[param_sidx as usize]
                    let base_vreg = alloc_reg(&! ctx)
                    var ri: i64 = 1
                    while ri < flat_size { let _ = alloc_reg(&! ctx); ri = ri + 1 }
                    remember_struct_local_tok(&! ctx, param_name_tok, base_vreg, param_sidx)
                    if param_generic_f64 != 0 {
                        mark_struct_scalar_regs_f64(base_vreg, param_sidx)
                    } else {
                        mark_struct_regs(base_vreg, param_sidx)
                    }
                    var pi: i64 = 0
                    while pi < flat_size && param_idx + pi < 64 {
                        V2_CURRENT_PARAM_REGS[(param_idx + pi) as usize] = base_vreg + pi
                        pi = pi + 1
                    }
                    V2_CURRENT_PARAM_COUNT = param_idx + flat_size
                    param_idx = param_idx + flat_size
                } else {
                    // scalar param
                    let vreg = alloc_reg(&! ctx)
                    remember_local_tok(&! ctx, param_name_tok, vreg)
                    if ppos + 2 < open_pos && token_kind(ppos + 1) == TK_COLON && token_kind(ppos + 2) == TK_IDENT && token_text_eq(ppos + 2, "f64") {
                        mark_reg_f64(vreg)
                    }
                    if param_idx < 64 {
                        V2_CURRENT_PARAM_REGS[param_idx as usize] = vreg
                    }
                    V2_CURRENT_PARAM_COUNT = param_idx + 1
                    param_idx = param_idx + 1
                }
                // skip past colon, type, optional comma
                ppos = ppos + 1
                while ppos < open_pos && token_kind(ppos) != TK_COMMA && token_kind(ppos) != TK_RPAREN {
                    ppos = ppos + 1
                }
                if ppos < open_pos && token_kind(ppos) == TK_COMMA { ppos = ppos + 1 }
            } else {
                ppos = ppos + 1
            }
        }
    }

    // Parse body
    V2_UFN_COUNT = 0
    var _unused_func_ref: i64 = 0
    parse_block_ir(&! _unused_func_ref, &! ctx, open_pos + 1, close_pos, token_count)
    let default_ret = alloc_reg(&! ctx)
    ufn_record_load_imm(default_ret, 0)
    ufn_record_return(default_ret)
    if V2_PARSE_UNSUPPORTED != 0 {
        print("native_compile: unsupported_frontend fn=")
        print_token_text(fn_name_tok)
        print(" token=")
        print_int(V2_PARSE_UNSUPPORTED_TOKEN)
        print(" kind=")
        print_int(V2_PARSE_UNSUPPORTED_KIND)
        if V2_PARSE_UNSUPPORTED_REASON == 1 {
            print(" reason=unresolved_call")
        }
        print(" text=")
        print_token_text(V2_PARSE_UNSUPPORTED_TOKEN)
        print("\n")
        return false
    }
    if !compile_ufn_from_globals(fn_id) {
        print("native_compile: user_fn_unsupported fn_id=")
        print_int(fn_id)
        print("\n")
        return false
    }
    drv_patch_frame_size(fn_id, V2_NEXT_REG)
    true
}

fn find_main_lbrace(token_count: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i + 2 < token_count {
        if token_kind(i) == TK_FN && token_kind(i + 1) == TK_IDENT && token_text_eq(i + 1, "main") {
            var j = i + 2
            while j < token_count {
                if token_kind(j) == TK_LBRACE {
                    return j
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    -1
}

fn find_matching_rbrace(open_idx: i64, token_count: i64) -> i64 with Mut, Panic {
    var depth: i64 = 1
    var i = open_idx + 1
    while i < token_count {
        let k = token_kind(i)
        if k == TK_LBRACE { depth = depth + 1 }
        if k == TK_RBRACE {
            depth = depth - 1
            if depth == 0 {
                return i
            }
        }
        i = i + 1
    }
    -1
}

fn drv_begin_builtin(fn_id: i64) with Mut, Panic {
    drv_reset_function_state()
    if fn_id >= 0 && fn_id < 2048 {
        DRV_FN_OFFSETS[fn_id as usize] = DRV_CODE_LEN
    }
}

fn drv_emit_stdout_write() with Mut, Panic, Div {
    drv_emit_mov_reg_imm(7, 1)
    drv_emit_mov_rax_imm(1)
    drv_emit_syscall()
}

fn drv_emit_builtin_print_str(fn_id: i64) with Mut, Panic, Div {
    drv_begin_builtin(fn_id)
    drv_emit_push_rbp()
    drv_emit_mov_rbp_rsp()
    drv_emit_mov_reg_reg(6, 7)
    drv_emit_xor_rcx_rcx()
    drv_emit_movzx_rax_byte_rdi()
    drv_emit_test_al_al()
    drv_emit_jz_rel8(8)
    drv_emit_inc_rdi()
    drv_emit_inc_rcx()
    drv_emit_jmp_rel8(-16)
    drv_emit_mov_reg_reg(2, 1)
    drv_emit_stdout_write()
    drv_emit_pop_rbp()
    drv_emit_ret()
}

fn drv_emit_builtin_print_char(fn_id: i64) with Mut, Panic, Div {
    drv_begin_builtin(fn_id)
    drv_emit_push_rdi()
    drv_emit_mov_rsi_rsp()
    drv_emit_mov_reg_imm(2, 1)
    drv_emit_stdout_write()
    drv_emit_add_rsp_8()
    drv_emit_ret()
}

fn drv_emit_builtin_print_int(fn_id: i64) with Mut, Panic, Div {
    drv_begin_builtin(fn_id)
    drv_emit_push_rbp()
    drv_emit_mov_rbp_rsp()
    drv_emit_sub_rsp_imm32(32)
    drv_emit_xor_r8_r8()
    drv_emit_test_rdi_rdi()
    drv_emit_jns_rel8(6)
    drv_emit_neg_rdi()
    drv_emit_inc_r8()
    drv_emit_mov_reg_reg(0, 7)
    drv_emit_mov_reg_reg(6, 5)
    drv_emit_sub_rsi_imm8(1)
    drv_emit_xor_rcx_rcx()
    drv_emit_xor_rdx_rdx()
    drv_emit_mov_reg_imm(3, 10)
    drv_emit_div_rbx()
    drv_emit_add_rdx_imm8(48)
    drv_emit_mov_byte_mem_rsi_dl()
    drv_emit_dec_rsi()
    drv_emit_inc_rcx()
    drv_emit_test_rax_rax()
    drv_emit_jnz_rel8(-30)
    drv_emit_test_r8_r8()
    drv_emit_jz_rel8(9)
    drv_emit_mov_byte_mem_rsi_imm8(45)
    drv_emit_dec_rsi()
    drv_emit_inc_rcx()
    drv_emit_inc_rsi()
    drv_emit_mov_reg_reg(2, 1)
    drv_emit_stdout_write()
    drv_emit_mov_rsp_rbp()
    drv_emit_pop_rbp()
    drv_emit_ret()
}

fn drv_emit_builtin_write_elf(fn_id: i64) with Mut, Panic, Div {
    drv_begin_builtin(fn_id)
    drv_emit_mov_reg_reg(3, 6)
    drv_emit_mov_rax_imm(2)
    drv_emit_mov_reg_imm(6, 577)
    drv_emit_mov_reg_imm(2, 493)
    drv_emit_syscall()
    drv_emit_mov_reg_reg(7, 0)
    let data_pos = DRV_CODE_LEN + 3
    drv_emit_lea_rax_rip_disp32(0)
    drv_add_data_reloc(data_pos, 4096 + (V2_GLOBAL_DRV_ELF_BYTES * drv_global_stride()))
    drv_emit_mov_reg_reg(6, 0)
    drv_emit_mov_reg_reg(2, 3)
    drv_emit_mov_rax_imm(1)
    drv_emit_syscall()
    drv_emit_ret()
}

fn drv_emit_builtin_chmod(fn_id: i64) with Mut, Panic, Div {
    drv_begin_builtin(fn_id)
    drv_emit_mov_rax_imm(90)
    drv_emit_mov_reg_imm(6, 493)
    drv_emit_syscall()
    drv_emit_mov_rax_imm(1)
    drv_emit_ret()
}

fn drv_emit_entry_trampoline(main_fn_id: i64) with Mut, Panic, Div {
    DRV_ENTRY_OFFSET = DRV_CODE_LEN
    drv_emit_byte(73)
    drv_emit_byte(137)
    drv_emit_byte(230)
    let call_pos = DRV_CODE_LEN
    drv_emit_call_rel32_placeholder()
    drv_add_call_reloc(call_pos + 1, main_fn_id)
    drv_emit_mov_rdi_rax()
    drv_emit_mov_rax_imm(60)
    drv_emit_syscall()
    drv_emit_byte(15)
    drv_emit_byte(11)
}

fn drv_apply_relocations(rodata_file_offset: i64, data_file_offset: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < DRV_RELOC_COUNT {
        let patch_offset = DRV_RELOC_OFFSETS[i as usize]
        let encoded = DRV_RELOC_TARGETS[i as usize]
        let kind = drv_decode_reloc_kind(encoded)
        let target = drv_decode_reloc_target(encoded)
        if kind == 1 {
            if target >= 0 && target < 2048 {
                let target_offset = DRV_FN_OFFSETS[target as usize]
                let rel = target_offset - (patch_offset + 4)
                drv_patch_u32_le(patch_offset, rel)
            }
        } else if kind == 2 {
            let next_ip = 4096 + patch_offset + 4
            let target_va = rodata_file_offset + target
            drv_patch_u32_le(patch_offset, target_va - next_ip)
        } else if kind == 3 {
            let next_ip2 = 4096 + patch_offset + 4
            let target_va2 = data_file_offset + target
            drv_patch_u32_le(patch_offset, target_va2 - next_ip2)
        }
        i = i + 1
    }
}

fn drv_elf_emit_byte(b: i64) with Mut, Panic, Div {
    let p = DRV_ELF_LEN
    if p >= 0 && p < 1048576 {
        DRV_ELF_BYTES[p as usize] = drv_low8(b) as i8
        DRV_ELF_LEN = p + 1
    }
}

fn drv_elf_emit_u16(v: i64) with Mut, Panic, Div {
    let b0 = drv_low8(v)
    let b1 = drv_low8(v / 256)
    drv_elf_emit_byte(b0)
    drv_elf_emit_byte(b1)
}

fn drv_elf_emit_u32(v0: i64) with Mut, Panic, Div {
    var v = v0
    if v < 0 { v = v + 4294967296 }
    let b0 = drv_low8(v)
    let b1 = drv_low8(v / 256)
    let b2 = drv_low8(v / 65536)
    let b3 = drv_low8(v / 16777216)
    drv_elf_emit_byte(b0)
    drv_elf_emit_byte(b1)
    drv_elf_emit_byte(b2)
    drv_elf_emit_byte(b3)
}

fn drv_elf_emit_u64(v: i64) with Mut, Panic, Div {
    let lo = v
    let hi = v / 4294967296
    drv_elf_emit_u32(lo)
    drv_elf_emit_u32(hi)
}

fn drv_elf_patch_u64(off: i64, v: i64) with Mut, Panic, Div {
    if off >= 0 && off + 8 <= DRV_ELF_LEN {
        let b0 = drv_low8(v)
        let b1 = drv_low8(v / 256)
        let b2 = drv_low8(v / 65536)
        let b3 = drv_low8(v / 16777216)
        let b4 = drv_low8(v / 4294967296)
        let b5 = drv_low8(v / 1099511627776)
        let b6 = drv_low8(v / 281474976710656)
        let b7 = drv_low8(v / 72057594037927936)
        DRV_ELF_BYTES[off as usize] = b0 as i8
        DRV_ELF_BYTES[(off + 1) as usize] = b1 as i8
        DRV_ELF_BYTES[(off + 2) as usize] = b2 as i8
        DRV_ELF_BYTES[(off + 3) as usize] = b3 as i8
        DRV_ELF_BYTES[(off + 4) as usize] = b4 as i8
        DRV_ELF_BYTES[(off + 5) as usize] = b5 as i8
        DRV_ELF_BYTES[(off + 6) as usize] = b6 as i8
        DRV_ELF_BYTES[(off + 7) as usize] = b7 as i8
    }
}

fn drv_elf_pad_to(target: i64) with Mut, Panic, Div {
    var p = DRV_ELF_LEN
    while p < target && p < 1048576 {
        DRV_ELF_BYTES[p as usize] = 0 as i8
        p = p + 1
    }
    DRV_ELF_LEN = p
}

fn drv_elf_align8() with Mut, Panic, Div {
    let q = DRV_ELF_LEN / 8
    let r = DRV_ELF_LEN - (q * 8)
    if r != 0 { drv_elf_pad_to(DRV_ELF_LEN + (8 - r)) }
}

fn drv_elf_copy_code() with Mut, Panic, Div {
    var i: i64 = 0
    while i < DRV_CODE_LEN {
        drv_elf_emit_byte(DRV_CODE_BYTES[i as usize] as i64)
        i = i + 1
    }
}

fn drv_elf_copy_rodata() with Mut, Panic, Div {
    var i: i64 = 0
    while i < DRV_RODATA_LEN {
        drv_elf_emit_byte(DRV_RODATA_BYTES[i as usize] as i64)
        i = i + 1
    }
}

fn drv_elf_zero_bytes(count: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < count {
        drv_elf_emit_byte(0)
        i = i + 1
    }
}

fn drv_elf_emit_phdr(ptype: i64, flags: i64, off: i64, vaddr: i64, filesz: i64, memsz: i64) with Mut, Panic, Div {
    drv_elf_emit_u32(ptype)
    drv_elf_emit_u32(flags)
    drv_elf_emit_u64(off)
    drv_elf_emit_u64(vaddr)
    drv_elf_emit_u64(vaddr)
    drv_elf_emit_u64(filesz)
    drv_elf_emit_u64(memsz)
    drv_elf_emit_u64(4096)
}

fn drv_elf_emit_shdr(name: i64, stype: i64, flags: i64, addr: i64, off: i64, size: i64, align: i64) with Mut, Panic, Div {
    drv_elf_emit_u32(name)
    drv_elf_emit_u32(stype)
    drv_elf_emit_u64(flags)
    drv_elf_emit_u64(addr)
    drv_elf_emit_u64(off)
    drv_elf_emit_u64(size)
    drv_elf_emit_u32(0)
    drv_elf_emit_u32(0)
    drv_elf_emit_u64(align)
    drv_elf_emit_u64(0)
}

fn drv_elf_emit_shstrtab() with Mut, Panic, Div {
    drv_elf_emit_byte(0)
    // offset 1: .text\0
    drv_elf_emit_byte(46); drv_elf_emit_byte(116); drv_elf_emit_byte(101); drv_elf_emit_byte(120); drv_elf_emit_byte(116); drv_elf_emit_byte(0)
    // offset 7: .rodata\0
    drv_elf_emit_byte(46); drv_elf_emit_byte(114); drv_elf_emit_byte(111); drv_elf_emit_byte(100); drv_elf_emit_byte(97); drv_elf_emit_byte(116); drv_elf_emit_byte(97); drv_elf_emit_byte(0)
    // offset 15: .data\0
    drv_elf_emit_byte(46); drv_elf_emit_byte(100); drv_elf_emit_byte(97); drv_elf_emit_byte(116); drv_elf_emit_byte(97); drv_elf_emit_byte(0)
    // offset 21: .shstrtab\0
    drv_elf_emit_byte(46); drv_elf_emit_byte(115); drv_elf_emit_byte(104); drv_elf_emit_byte(115); drv_elf_emit_byte(116); drv_elf_emit_byte(114); drv_elf_emit_byte(116); drv_elf_emit_byte(97); drv_elf_emit_byte(98); drv_elf_emit_byte(0)
    // offset 31: .sounio.epistemic\0
    drv_elf_emit_byte(46); drv_elf_emit_byte(115); drv_elf_emit_byte(111); drv_elf_emit_byte(117)
    drv_elf_emit_byte(110); drv_elf_emit_byte(105); drv_elf_emit_byte(111); drv_elf_emit_byte(46)
    drv_elf_emit_byte(101); drv_elf_emit_byte(112); drv_elf_emit_byte(105); drv_elf_emit_byte(115)
    drv_elf_emit_byte(116); drv_elf_emit_byte(101); drv_elf_emit_byte(109); drv_elf_emit_byte(105)
    drv_elf_emit_byte(99); drv_elf_emit_byte(0)
}

fn drv_elf_emit_epistemic() with Mut, Panic, Div {
    // magic "SIEP" (Sounio Informational EPistemic)
    drv_elf_emit_byte(83); drv_elf_emit_byte(73); drv_elf_emit_byte(69); drv_elf_emit_byte(80)
    drv_elf_emit_u32(1)                 // version = 1
    drv_elf_emit_u64(EP_TOTAL_INSTR)    // total micro-IR instructions compiled across all functions
    drv_elf_emit_u64(EP_KNOWLEDGE_COUNT) // count of Knowledge<T> token occurrences in compiled source
}

fn drv_finalize_elf(output_path: string, data_len: i64) -> i64 with IO, Mut, Panic, Div {
    let base = 4194304
    let text_off = 4096
    let rodata_off = drv_align_page(text_off + DRV_CODE_LEN)
    let data_off = drv_align_page(rodata_off + DRV_RODATA_LEN)
    drv_apply_relocations(rodata_off, data_off)
    DRV_ELF_LEN = 0

    drv_elf_emit_byte(127); drv_elf_emit_byte(69); drv_elf_emit_byte(76); drv_elf_emit_byte(70)
    drv_elf_emit_byte(2); drv_elf_emit_byte(1); drv_elf_emit_byte(1); drv_elf_emit_byte(0)
    drv_elf_zero_bytes(8)
    drv_elf_emit_u16(2)
    drv_elf_emit_u16(62)
    drv_elf_emit_u32(1)
    drv_elf_emit_u64(base + text_off + DRV_ENTRY_OFFSET)
    drv_elf_emit_u64(64)
    let shoff_patch = DRV_ELF_LEN
    drv_elf_emit_u64(0)
    drv_elf_emit_u32(0)
    drv_elf_emit_u16(64)
    drv_elf_emit_u16(56)
    drv_elf_emit_u16(3)
    drv_elf_emit_u16(64)
    drv_elf_emit_u16(6)
    drv_elf_emit_u16(4)

    drv_elf_emit_phdr(1, 5, text_off, base + text_off, DRV_CODE_LEN, DRV_CODE_LEN)
    drv_elf_emit_phdr(1, 4, rodata_off, base + rodata_off, DRV_RODATA_LEN, DRV_RODATA_LEN)
    drv_elf_emit_phdr(1, 6, data_off, base + data_off, 0, data_len)

    drv_elf_pad_to(text_off)
    drv_elf_copy_code()
    drv_elf_pad_to(rodata_off)
    drv_elf_copy_rodata()
    drv_elf_pad_to(data_off)
    drv_elf_align8()
    let shstr_off = DRV_ELF_LEN
    drv_elf_emit_shstrtab()
    let shstr_size = DRV_ELF_LEN - shstr_off
    drv_elf_align8()
    let epistemic_off = DRV_ELF_LEN
    drv_elf_emit_epistemic()
    drv_elf_align8()
    let shoff = DRV_ELF_LEN
    drv_elf_patch_u64(shoff_patch, shoff)
    drv_elf_emit_shdr(0, 0, 0, 0, 0, 0, 0)
    drv_elf_emit_shdr(1, 1, 6, base + text_off, text_off, DRV_CODE_LEN, 16)
    drv_elf_emit_shdr(7, 1, 2, base + rodata_off, rodata_off, DRV_RODATA_LEN, 8)
    drv_elf_emit_shdr(15, 8, 3, base + data_off, data_off, data_len, 8)
    drv_elf_emit_shdr(21, 3, 0, 0, shstr_off, shstr_size, 1)
    drv_elf_emit_shdr(31, 1, 0, 0, epistemic_off, 24, 8)

    let wrote = driver_write_elf_to_file(output_path, DRV_ELF_LEN)
    if wrote < 0 { return -1 }
    if !driver_make_executable(output_path) { return -1 }
    DRV_ELF_LEN
}

fn driver_write_elf_to_file(path: string, len: i64) -> i64 with IO, Mut, Panic, Div {
    if io_write_meg_binary(path, DRV_ELF_BYTES, len) { return len }
    -1
}

fn driver_make_executable(path: string) -> bool with IO {
    io_make_executable(path)
}

fn compile_ir_module_to_elf(output_path: string, token_count: i64) -> i64 with IO, Mut, Panic, Div, Alloc {
    let user_fn_count = V2_USER_FN_COUNT
    let main_fn_id = V2_FIRST_USER_FN_ID + user_fn_count
    let total_fn_count = main_fn_id + 1

    drv_reset_codegen(total_fn_count)

    drv_emit_builtin_print_str(V2_BUILTIN_PRINT)
    drv_emit_builtin_print_int(V2_BUILTIN_PRINT_INT)
    drv_emit_builtin_print_char(V2_BUILTIN_PRINT_CHAR)
    if source_uses_ident(token_count, "driver_write_elf_to_file") {
        drv_emit_builtin_write_elf(V2_BUILTIN_DRIVER_WRITE_ELF)
        drv_emit_builtin_chmod(V2_BUILTIN_DRIVER_CHMOD)
    }

    // Compile user-defined functions
    var ui: i64 = 0
    while ui < user_fn_count {
        let ufn_name_tok = V2_USER_FN_TOKEN_IDX[ui as usize]
        let ufn_id = V2_USER_FN_IDS[ui as usize]
        if !compile_user_fn(ufn_name_tok, ufn_id, token_count) {
            print("native_compile: user_fn_failed\n")
            return 3
        }
        EP_TOTAL_INSTR = EP_TOTAL_INSTR + V2_UFN_COUNT
        ui = ui + 1
    }

    let main_tok = find_ident_token_text(token_count, "main")
    if main_tok < 0 {
        print("native_compile: native_v2_unsupported fn=main\n")
        return 3
    }
    let main_ok = compile_user_fn(main_tok, main_fn_id, token_count)
    if !main_ok {
        print("native_compile: native_v2_unsupported fn=main\n")
        return 3
    }
    EP_TOTAL_INSTR = EP_TOTAL_INSTR + V2_UFN_COUNT
    EP_KNOWLEDGE_COUNT = source_count_ident(token_count, "Knowledge")

    drv_emit_entry_trampoline(main_fn_id)
    var data_len = 4096
    if source_uses_ident(token_count, "driver_lex_file_to_globals") {
        data_len = drv_driver_data_len()
    } else if USER_GLOBAL_DATA_LEN > 0 {
        // M1.2 step D — user-globals land in the .data BSS region (file-size
        // 0 in the PHDR, mem-size data_len), so the loader zero-fills all
        // declared slots. Round up to 8 for alignment and keep a minimum of
        // 4096 so very small user programs still get a full page.
        let aligned = (USER_GLOBAL_DATA_LEN + 7) / 8 * 8
        if aligned > data_len { data_len = aligned }
    }
    let elf_len = drv_finalize_elf(output_path, data_len)
    if elf_len < 0 {
        print("native_compile: write_error\n")
        return 5
    }

    print("native_compile: ok written=")
    print(output_path)
    print(" size=")
    print_int(elf_len)
    print("\n")
    0
}

fn driver_read_file_to_cursor_source(path: string) -> i64 with IO, Mut, Panic, Div {
    let size = file_size(path)
    let data = read_file(path)
    var n: i64 = size
    if n < 0 { n = 0 }
    if n > 1048576 { n = 1048576 }
    var i: i64 = 0
    while i < n {
        CURSOR_SOURCE[i as usize] = data[i as usize]
        i = i + 1
    }
    CURSOR_SOURCE_LEN = n
    n
}

fn driver_set_token_flat(idx: i64, kind: i64, start: i64, end: i64, int_value: i64) with Mut, Panic {
    PT_KIND_CODE[idx as usize] = kind
    PT_START[idx as usize] = start
    PT_END[idx as usize] = end
    PT_INT_VALUE[idx as usize] = int_value
}

fn driver_is_digit(ch: i8) -> bool {
    ch >= 48 as i8 && ch <= 57 as i8
}

fn driver_is_ident_start(ch: i8) -> bool {
    (ch >= 65 as i8 && ch <= 90 as i8) || (ch >= 97 as i8 && ch <= 122 as i8) || ch == 95 as i8
}

fn driver_is_ident_continue(ch: i8) -> bool {
    driver_is_ident_start(ch) || driver_is_digit(ch)
}

fn driver_source_slice_eq_lit(start: i64, end: i64, text: string) -> bool with Mut, Panic, Div {
    let len = end - start
    if len != str_len(text) { return false }
    var i: i64 = 0
    while i < len {
        if CURSOR_SOURCE[(start + i) as usize] != (str_char_at(text, i) as i8) { return false }
        i = i + 1
    }
    true
}

fn driver_keyword_code(start: i64, end: i64) -> i64 with Mut, Panic, Div {
    if driver_source_slice_eq_lit(start, end, "use") { return TK_USE }
    if driver_source_slice_eq_lit(start, end, "fn") { return TK_FN }
    if driver_source_slice_eq_lit(start, end, "let") { return TK_LET }
    if driver_source_slice_eq_lit(start, end, "var") { return TK_VAR }
    if driver_source_slice_eq_lit(start, end, "type") { return 12 }
    if driver_source_slice_eq_lit(start, end, "struct") { return TK_STRUCT }
    if driver_source_slice_eq_lit(start, end, "enum") { return TK_ENUM }
    if driver_source_slice_eq_lit(start, end, "if") { return TK_IF }
    if driver_source_slice_eq_lit(start, end, "else") { return TK_ELSE }
    if driver_source_slice_eq_lit(start, end, "match") { return TK_MATCH }
    if driver_source_slice_eq_lit(start, end, "while") { return TK_WHILE }
    if driver_source_slice_eq_lit(start, end, "return") { return TK_RETURN }
    if driver_source_slice_eq_lit(start, end, "as") { return TK_AS }
    if driver_source_slice_eq_lit(start, end, "pub") { return 32 }
    if driver_source_slice_eq_lit(start, end, "true") { return TK_TRUE }
    if driver_source_slice_eq_lit(start, end, "false") { return TK_FALSE }
    if driver_source_slice_eq_lit(start, end, "with") { return 45 }
    TK_IDENT
}

fn driver_punct_kind(ch: i8, c2: i8, c3: i8) -> i64 {
    if ch == 46 as i8 && c2 == 46 as i8 && c3 == 46 as i8 { return 172 }
    if ch == 46 as i8 && c2 == 46 as i8 && c3 == 61 as i8 { return 161 }
    if ch == 60 as i8 && c2 == 60 as i8 && c3 == 61 as i8 { return 166 }
    if ch == 62 as i8 && c2 == 62 as i8 && c3 == 61 as i8 { return 167 }
    if ch == 61 as i8 && c2 == 61 as i8 { return TK_EQEQ }
    if ch == 33 as i8 && c2 == 61 as i8 { return TK_BANGEQ }
    if ch == 60 as i8 && c2 == 61 as i8 { return TK_LE }
    if ch == 62 as i8 && c2 == 61 as i8 { return TK_GE }
    if ch == 38 as i8 && c2 == 38 as i8 { return TK_ANDAND }
    if ch == 124 as i8 && c2 == 124 as i8 { return TK_OROR }
    if ch == 60 as i8 && c2 == 60 as i8 { return 152 }
    if ch == 62 as i8 && c2 == 62 as i8 { return 153 }
    if ch == 43 as i8 && c2 == 61 as i8 { return 154 }
    if ch == 45 as i8 && c2 == 61 as i8 { return 155 }
    if ch == 42 as i8 && c2 == 61 as i8 { return 156 }
    if ch == 47 as i8 && c2 == 61 as i8 { return 157 }
    if ch == 37 as i8 && c2 == 61 as i8 { return 168 }
    if ch == 38 as i8 && c2 == 61 as i8 { return 170 }
    if ch == 124 as i8 && c2 == 61 as i8 { return 165 }
    if ch == 94 as i8 && c2 == 61 as i8 { return 169 }
    if ch == 45 as i8 && c2 == 62 as i8 { return TK_ARROW }
    if ch == 61 as i8 && c2 == 62 as i8 { return TK_FATARROW }
    if ch == 60 as i8 && c2 == 45 as i8 { return 171 }
    if ch == 38 as i8 && c2 == 33 as i8 { return TK_AMPBANG }
    if ch == 58 as i8 && c2 == 58 as i8 { return TK_COLONCOLON }
    if ch == 46 as i8 && c2 == 46 as i8 { return 160 }
    if ch == 43 as i8 && c2 == 43 as i8 { return 164 }
    if ch == 43 as i8 && c2 == 45 as i8 { return 173 }
    if ch == 43 as i8 { return TK_PLUS }
    if ch == 45 as i8 { return TK_MINUS }
    if ch == 42 as i8 { return TK_STAR }
    if ch == 47 as i8 { return TK_SLASH }
    if ch == 37 as i8 { return 136 }
    if ch == 61 as i8 { return TK_EQ }
    if ch == 60 as i8 { return TK_LT }
    if ch == 62 as i8 { return TK_GT }
    if ch == 33 as i8 { return TK_BANG }
    if ch == 38 as i8 { return 141 }
    if ch == 124 as i8 { return 142 }
    if ch == 94 as i8 { return 143 }
    if ch == 126 as i8 { return 144 }
    if ch == 63 as i8 { return 145 }
    if ch == 40 as i8 { return TK_LPAREN }
    if ch == 41 as i8 { return TK_RPAREN }
    if ch == 123 as i8 { return TK_LBRACE }
    if ch == 125 as i8 { return TK_RBRACE }
    if ch == 91 as i8 { return TK_LBRACKET }
    if ch == 93 as i8 { return TK_RBRACKET }
    if ch == 59 as i8 { return TK_SEMI }
    if ch == 58 as i8 { return TK_COLON }
    if ch == 44 as i8 { return TK_COMMA }
    if ch == 46 as i8 { return TK_DOT }
    if ch == 64 as i8 { return 184 }
    if ch == 35 as i8 { return 185 }
    if ch == 95 as i8 { return TK_UNDERSCORE }
    1
}

fn driver_punct_width(kind: i64) -> i64 {
    if kind == 161 || kind == 166 || kind == 167 || kind == 172 { return 3 }
    if kind == TK_EQEQ || kind == TK_BANGEQ || kind == TK_LE || kind == TK_GE { return 2 }
    if kind == TK_ANDAND || kind == TK_OROR || kind == TK_ARROW || kind == TK_FATARROW { return 2 }
    if kind == TK_AMPBANG || kind == TK_COLONCOLON { return 2 }
    if kind >= 152 && kind <= 160 { return 2 }
    if kind >= 164 && kind <= 171 { return 2 }
    if kind == 173 { return 2 }
    1
}

fn driver_lex_source_to_globals(n: i64) -> i64 with Mut, Panic, Div {
    CURSOR_SOURCE_LEN = n
    var pos: i64 = 0
    var tc: i64 = 0
    while pos < n {
        let ch = CURSOR_SOURCE[pos as usize]
        if ch == 32 as i8 || ch == 9 as i8 || ch == 10 as i8 || ch == 13 as i8 {
            pos = pos + 1
        } else if ch == 47 as i8 && pos + 1 < n && CURSOR_SOURCE[(pos + 1) as usize] == 47 as i8 {
            while pos < n && CURSOR_SOURCE[pos as usize] != 10 as i8 {
                pos = pos + 1
            }
        } else if driver_is_ident_start(ch) {
            let start = pos
            pos = pos + 1
            while pos < n && driver_is_ident_continue(CURSOR_SOURCE[pos as usize]) {
                pos = pos + 1
            }
            let kind_val = driver_keyword_code(start, pos)
            PT_KIND_CODE[tc as usize] = kind_val
            PT_START[tc as usize] = start
            PT_END[tc as usize] = pos
            PT_INT_VALUE[tc as usize] = 0
            tc = tc + 1
        } else if driver_is_digit(ch) {
            let start = pos
            var value: i64 = 0
            while pos < n && driver_is_digit(CURSOR_SOURCE[pos as usize]) {
                value = value * 10 + ((CURSOR_SOURCE[pos as usize] - 48 as i8) as i64)
                pos = pos + 1
            }
            PT_KIND_CODE[tc as usize] = TK_INT
            PT_START[tc as usize] = start
            PT_END[tc as usize] = pos
            PT_INT_VALUE[tc as usize] = value
            tc = tc + 1
        } else if ch == 34 as i8 {
            let start = pos
            pos = pos + 1
            while pos < n && CURSOR_SOURCE[pos as usize] != 34 as i8 {
                if CURSOR_SOURCE[pos as usize] == 92 as i8 && pos + 1 < n {
                    pos = pos + 2
                } else {
                    pos = pos + 1
                }
            }
            if pos < n && CURSOR_SOURCE[pos as usize] == 34 as i8 { pos = pos + 1 }
            PT_KIND_CODE[tc as usize] = TK_STRING
            PT_START[tc as usize] = start
            PT_END[tc as usize] = pos
            PT_INT_VALUE[tc as usize] = 0
            tc = tc + 1
        } else {
            let start = pos
            var c2: i8 = 0 as i8
            var c3: i8 = 0 as i8
            if pos + 1 < n { c2 = CURSOR_SOURCE[(pos + 1) as usize] }
            if pos + 2 < n { c3 = CURSOR_SOURCE[(pos + 2) as usize] }
            let kind = driver_punct_kind(ch, c2, c3)
            let width = driver_punct_width(kind)
            PT_KIND_CODE[tc as usize] = kind
            PT_START[tc as usize] = start
            PT_END[tc as usize] = start + width
            PT_INT_VALUE[tc as usize] = 0
            tc = tc + 1
            pos = pos + width
        }
    }
    PT_KIND_CODE[tc as usize] = TK_EOF
    PT_START[tc as usize] = pos
    PT_END[tc as usize] = pos
    PT_INT_VALUE[tc as usize] = 0
    tc
}

fn driver_lex_file_to_globals(path: string) -> i64 with IO, Mut, Panic, Div {
    let n = driver_read_file_to_cursor_source(path)
    if n <= 0 { return 0 }
    driver_lex_source_to_globals(n)
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    if argc < 1 {
        print("native_compile: usage: native_compile_driver.sio <source.sio> [-o <output>]\n")
        print("native_compile: usage: native_compile_driver.sio <source.sio> <output>\n")
        return 1
    }

    let source_path = get_arg(0)
    var output_path = "a.out"
    if argc >= 3 {
        let flag = get_arg(1)
        if flag == "-o" {
            output_path = get_arg(2)
        }
    }
    if argc == 2 {
        let arg1 = get_arg(1)
        if arg1 != "-o" {
            output_path = arg1
        }
    }

    let token_count = driver_lex_file_to_globals(source_path)
    if token_count <= 0 {
        print("native_compile: lex_error\n")
        return 1
    }
    V2_TOKEN_COUNT = token_count
    scan_struct_decls(token_count)
    scan_enum_decls(token_count)
    scan_user_globals(token_count)
    scan_user_fns(token_count, V2_FIRST_USER_FN_ID)
    return compile_ir_module_to_elf(output_path, token_count)
}
