fn drv_encode_reloc_target(kind_code: i64, target: i64) -> i64 {
    return (kind_code * 1000000000) + target
}

fn drv_decode_reloc_kind(encoded: i64) -> i64 with Div {
    encoded / 1000000000
}

fn drv_decode_reloc_target(encoded: i64) -> i64 with Div {
    encoded - (drv_decode_reloc_kind(encoded) * 1000000000)
}

fn drv_emit_cmp_al_mem_rsi() with Mut, Div, Panic {
    drv_emit_byte(58)
    drv_emit_byte(6)
}

fn drv_add_reloc(patch_offset: i64, kind_code: i64, target: i64) with Mut, Panic {
    let idx = DRV_RELOC_COUNT
    if idx >= 0 && idx < 8192 {
        DRV_RELOC_OFFSETS[idx as usize] = patch_offset
        DRV_RELOC_TARGETS[idx as usize] = drv_encode_reloc_target(kind_code, target)
        DRV_RELOC_COUNT = idx + 1
    }
}

fn drv_add_call_reloc(patch_offset: i64, target_fn: i64) with Mut, Panic {
    drv_add_reloc(patch_offset, 1, target_fn)
}

fn drv_add_rodata_reloc(patch_offset: i64, ro_off: i64) with Mut, Panic {
    drv_add_reloc(patch_offset, 2, ro_off)
}

fn drv_add_data_reloc(patch_offset: i64, data_off: i64) with Mut, Panic {
    drv_add_reloc(patch_offset, 3, data_off)
}

fn drv_define_label(label_id: i64) with Mut, Panic {
    if label_id >= 0 && label_id < 1024 {
        DRV_LABEL_OFFSETS[label_id as usize] = DRV_CODE_LEN
    }
}

fn drv_add_label_patch(patch_offset: i64, label_id: i64) with Mut, Panic {
    let idx = DRV_LABEL_PATCH_COUNT
    if idx >= 0 && idx < 1024 {
        DRV_LABEL_PATCH_OFFSETS[idx as usize] = patch_offset
        DRV_LABEL_PATCH_IDS[idx as usize] = label_id
        DRV_LABEL_PATCH_COUNT = idx + 1
    }
}

fn drv_patch_labels() with Mut, Div, Panic {
    var i: i64 = 0
    while i < DRV_LABEL_PATCH_COUNT {
        let off = DRV_LABEL_PATCH_OFFSETS[i as usize]
        let lid = DRV_LABEL_PATCH_IDS[i as usize]
        if lid >= 0 && lid < 1024 {
            let target = DRV_LABEL_OFFSETS[lid as usize]
            let rel = target - (off + 4)
            drv_patch_u32_le(off, rel)
        }
        i = i + 1
    }
}

fn drv_reset_function_state() with Mut, Panic {
    DRV_LABEL_PATCH_COUNT = 0
    var i: i64 = 0
    while i < 1024 {
        DRV_LABEL_OFFSETS[i as usize] = -1
        i = i + 1
    }
}

fn drv_reset_codegen(fn_count: i64) with Mut, Panic {
    DRV_CODE_LEN = 0
    DRV_RODATA_LEN = 0
    DRV_RELOC_COUNT = 0
    DRV_FN_COUNT = fn_count
    DRV_ENTRY_OFFSET = 0
    DRV_LABEL_PATCH_COUNT = 0
    var i: i64 = 0
    while i < 2048 {
        DRV_FN_OFFSETS[i as usize] = -1
        i = i + 1
    }
    i = 0
    while i < 1024 {
        DRV_LABEL_OFFSETS[i as usize] = -1
        i = i + 1
    }
}

fn drv_rodata_append_byte(byte: i64) with Mut, Div, Panic {
    let p = DRV_RODATA_LEN
    if p >= 0 && p < 65536 {
        DRV_RODATA_BYTES[p as usize] = drv_low8(byte) as i8
        DRV_RODATA_LEN = p + 1
    }
}

fn driver_append_ufn_string_literal(idx: i64) -> i64 with Mut, Panic, Div {
    let offset = DRV_RODATA_LEN
    let start = V2_UFN_STR_START[idx as usize] + 1
    let end = V2_UFN_STR_END[idx as usize] - 1
    var i: i64 = start
    while i < end {
        let ch = CURSOR_SOURCE[i as usize]
        if ch == 92 as i8 && i + 1 < end {
            let esc = CURSOR_SOURCE[(i + 1) as usize]
            if esc == 120 as i8 && i + 3 < end {
                let h1 = CURSOR_SOURCE[(i + 2) as usize] as i64
                let h2 = CURSOR_SOURCE[(i + 3) as usize] as i64
                var v1: i64 = 0 - 1
                if h1 >= 48 && h1 <= 57 { v1 = h1 - 48 }
                else if h1 >= 97 && h1 <= 102 { v1 = h1 - 87 }
                else if h1 >= 65 && h1 <= 70 { v1 = h1 - 55 }
                var v2: i64 = 0 - 1
                if h2 >= 48 && h2 <= 57 { v2 = h2 - 48 }
                else if h2 >= 97 && h2 <= 102 { v2 = h2 - 87 }
                else if h2 >= 65 && h2 <= 70 { v2 = h2 - 55 }
                if v1 >= 0 && v2 >= 0 {
                    drv_rodata_append_byte(v1 * 16 + v2)
                    i = i + 4
                } else {
                    drv_rodata_append_byte(esc as i64)
                    i = i + 2
                }
            } else {
                if esc == 110 as i8 { drv_rodata_append_byte(10) }
                else if esc == 116 as i8 { drv_rodata_append_byte(9) }
                else if esc == 114 as i8 { drv_rodata_append_byte(13) }
                else if esc == 34 as i8 { drv_rodata_append_byte(34) }
                else if esc == 92 as i8 { drv_rodata_append_byte(92) }
                else { drv_rodata_append_byte(esc as i64) }
                i = i + 2
            }
        } else {
            drv_rodata_append_byte(ch as i64)
            i = i + 1
        }
    }
    drv_rodata_append_byte(0)
    offset
}

fn drv_begin_function(fn_id: i64) with Mut, Panic, Div {
    drv_reset_function_state()
    if fn_id >= 0 && fn_id < 2048 {
        DRV_FN_OFFSETS[fn_id as usize] = DRV_CODE_LEN
    }
    drv_emit_push_rbp()
    drv_emit_mov_rbp_rsp()
    drv_emit_sub_rsp_imm32(262144)
    if V2_CURRENT_FN_SRET != 0 && V2_CURRENT_FN_SRET_VREG >= 0 {
        // SRET: rdi = hidden pointer to caller's result buffer. Save it, then
        // load actual parameters from rsi, rdx, rcx, r8, r9, r10, r11 (shifted +1).
        drv_emit_store_rbp_disp32_reg(7, drv_ir_slot_offset(V2_CURRENT_FN_SRET_VREG))
        var i: i64 = 0
        while i < V2_CURRENT_PARAM_COUNT && i < 7 {
            let vreg = V2_CURRENT_PARAM_REGS[i as usize]
            let preg = drv_param_reg(i + 1)
            if vreg >= 0 && preg >= 0 {
                drv_emit_store_rbp_disp32_reg(preg, drv_ir_slot_offset(vreg))
            }
            i = i + 1
        }
        // Stack params: arg[7] at [rbp+16], arg[8] at [rbp+24], etc.
        var si: i64 = 7
        while si < V2_CURRENT_PARAM_COUNT {
            let vreg = V2_CURRENT_PARAM_REGS[si as usize]
            if vreg >= 0 {
                let stk_disp = 16 + (si - 7) * 8
                drv_emit_load_rbp_disp32_reg(0, stk_disp)
                drv_emit_store_rbp_disp32_reg(0, drv_ir_slot_offset(vreg))
            }
            si = si + 1
        }
    } else {
        var i: i64 = 0
        while i < V2_CURRENT_PARAM_COUNT && i < 8 {
            let vreg = V2_CURRENT_PARAM_REGS[i as usize]
            let preg = drv_param_reg(i)
            if vreg >= 0 && preg >= 0 {
                drv_emit_store_rbp_disp32_reg(preg, drv_ir_slot_offset(vreg))
            }
            i = i + 1
        }
        // Stack params: arg[8] at [rbp+16], arg[9] at [rbp+24], etc.
        var si: i64 = 8
        while si < V2_CURRENT_PARAM_COUNT {
            let vreg = V2_CURRENT_PARAM_REGS[si as usize]
            if vreg >= 0 {
                let stk_disp = 16 + (si - 8) * 8
                drv_emit_load_rbp_disp32_reg(0, stk_disp)
                drv_emit_store_rbp_disp32_reg(0, drv_ir_slot_offset(vreg))
            }
            si = si + 1
        }
    }
}

fn drv_emit_load_imm(dst: i64, value: i64) with Mut, Panic, Div {
    drv_emit_mov_rax_imm(value)
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_load_string_offset(dst: i64, ro_off: i64) with Mut, Panic, Div {
    let lea_pos = DRV_CODE_LEN
    drv_emit_lea_rax_rip_disp32(0)
    let reloc_idx = DRV_RELOC_COUNT
    if reloc_idx >= 0 && reloc_idx < 8192 {
        DRV_RELOC_OFFSETS[reloc_idx as usize] = lea_pos + 3
        DRV_RELOC_TARGETS[reloc_idx as usize] = drv_encode_reloc_target(2, ro_off)
        DRV_RELOC_COUNT = reloc_idx + 1
    }
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_any_binop(dst: i64, lhs: i64, op_code: i64, rhs: i64) -> bool with Mut, Panic, Div {
    if op_code == 1 {
        drv_core_load_temp_to_rax(lhs)
        drv_emit_push_rax()
        drv_core_load_temp_to_rax(rhs)
        drv_emit_pop_rbx()
        drv_emit_add_rax_rbx()
        drv_core_store_rax_to_temp(dst)
        return true
    }
    if op_code == 2 {
        drv_core_load_temp_to_rax(rhs)
        drv_emit_push_rax()
        drv_core_load_temp_to_rax(lhs)
        drv_emit_pop_rbx()
        drv_emit_sub_rax_rbx()
        drv_core_store_rax_to_temp(dst)
        return true
    }
    if op_code == 3 {
        drv_core_load_temp_to_rax(lhs)
        drv_emit_push_rax()
        drv_core_load_temp_to_rax(rhs)
        drv_emit_pop_rbx()
        drv_emit_imul_rax_rbx()
        drv_core_store_rax_to_temp(dst)
        return true
    }
    if op_code == 4 {
        drv_core_load_temp_to_rax(rhs)
        drv_emit_mov_reg_reg(1, 0)
        drv_core_load_temp_to_rax(lhs)
        drv_emit_cqo()
        drv_emit_idiv_rcx()
        drv_core_store_rax_to_temp(dst)
        return true
    }
    if op_code >= 5 && op_code <= 10 {
        drv_core_load_temp_to_rax(rhs)
        drv_emit_push_rax()
        drv_core_load_temp_to_rax(lhs)
        drv_emit_pop_rbx()
        drv_emit_cmp_rax_rbx()
        if op_code == 5 { drv_emit_setcc_al(148) }
        else if op_code == 6 { drv_emit_setcc_al(149) }
        else if op_code == 7 { drv_emit_setcc_al(156) }
        else if op_code == 8 { drv_emit_setcc_al(158) }
        else if op_code == 9 { drv_emit_setcc_al(159) }
        else { drv_emit_setcc_al(157) }
        drv_emit_movzx_rax_al()
        drv_core_store_rax_to_temp(dst)
        return true
    }
    // 11=and, 12=or, 13=xor
    if op_code == 11 {
        drv_core_load_temp_to_rax(lhs)
        drv_emit_push_rax()
        drv_core_load_temp_to_rax(rhs)
        drv_emit_pop_rbx()
        drv_emit_and_rax_rbx()
        drv_core_store_rax_to_temp(dst)
        return true
    }
    if op_code == 12 {
        drv_core_load_temp_to_rax(lhs)
        drv_emit_push_rax()
        drv_core_load_temp_to_rax(rhs)
        drv_emit_pop_rbx()
        drv_emit_or_rax_rbx()
        drv_core_store_rax_to_temp(dst)
        return true
    }
    if op_code == 13 {
        drv_core_load_temp_to_rax(lhs)
        drv_emit_push_rax()
        drv_core_load_temp_to_rax(rhs)
        drv_emit_pop_rbx()
        drv_emit_xor_rax_rbx_bitwise()
        drv_core_store_rax_to_temp(dst)
        return true
    }
    // 14=shl, 15=shr — shift amount in rcx
    if op_code == 14 {
        drv_core_load_temp_to_rax(rhs)
        drv_emit_mov_rcx_rax()
        drv_core_load_temp_to_rax(lhs)
        drv_emit_sal_rax_cl()
        drv_core_store_rax_to_temp(dst)
        return true
    }
    if op_code == 15 {
        drv_core_load_temp_to_rax(rhs)
        drv_emit_mov_rcx_rax()
        drv_core_load_temp_to_rax(lhs)
        drv_emit_sar_rax_cl()
        drv_core_store_rax_to_temp(dst)
        return true
    }
    // 16=rem — idiv, remainder in rdx
    if op_code == 16 {
        drv_core_load_temp_to_rax(rhs)
        drv_emit_mov_reg_reg(1, 0)
        drv_core_load_temp_to_rax(lhs)
        drv_emit_cqo()
        drv_emit_idiv_rcx()
        drv_emit_rdx_to_temp(dst)
        return true
    }
    false
}

fn drv_emit_load_f64_scaled(dst: i64, mantissa: i64, scale: i64) with Mut, Panic, Div {
    drv_emit_mov_rax_imm(mantissa)
    drv_emit_cvtsi2sd_xmm0_rax()
    drv_emit_mov_rax_imm(scale)
    drv_emit_cvtsi2sd_xmm1_rax()
    drv_emit_sse2_xmm0_xmm1(94)
    drv_emit_store_xmm0_to_temp(dst)
}

fn drv_emit_f64_binop(dst: i64, lhs: i64, op_code: i64, rhs: i64) -> bool with Mut, Panic, Div {
    drv_emit_load_temp_to_xmm0(lhs)
    drv_emit_load_temp_to_xmm1(rhs)
    if op_code == 1 {
        drv_emit_sse2_xmm0_xmm1(88)
        drv_emit_store_xmm0_to_temp(dst)
        return true
    }
    if op_code == 2 {
        drv_emit_sse2_xmm0_xmm1(92)
        drv_emit_store_xmm0_to_temp(dst)
        return true
    }
    if op_code == 3 {
        drv_emit_sse2_xmm0_xmm1(89)
        drv_emit_store_xmm0_to_temp(dst)
        return true
    }
    if op_code == 4 {
        drv_emit_sse2_xmm0_xmm1(94)
        drv_emit_store_xmm0_to_temp(dst)
        return true
    }
    if op_code >= 5 && op_code <= 10 {
        drv_emit_ucomisd_xmm0_xmm1()
        if op_code == 5 {
            drv_emit_setcc_al(148)
            drv_emit_byte(15); drv_emit_byte(155); drv_emit_byte(193)
            drv_emit_byte(32); drv_emit_byte(200)
        }
        else if op_code == 6 {
            drv_emit_setcc_al(149)
            drv_emit_byte(15); drv_emit_byte(154); drv_emit_byte(193)
            drv_emit_byte(8); drv_emit_byte(200)
        }
        else if op_code == 7 {
            drv_emit_setcc_al(146)
            drv_emit_byte(15); drv_emit_byte(155); drv_emit_byte(193)
            drv_emit_byte(32); drv_emit_byte(200)
        }
        else if op_code == 8 {
            drv_emit_setcc_al(150)
            drv_emit_byte(15); drv_emit_byte(155); drv_emit_byte(193)
            drv_emit_byte(32); drv_emit_byte(200)
        }
        else if op_code == 9 { drv_emit_setcc_al(151) }
        else { drv_emit_setcc_al(147) }
        drv_emit_movzx_rax_al()
        drv_core_store_rax_to_temp(dst)
        return true
    }
    false
}

fn drv_emit_sqrt_f64(dst: i64, src: i64) with Mut, Div, Panic {
    drv_emit_load_temp_to_xmm1(src)
    drv_emit_sse2_xmm0_xmm1(81)
    drv_emit_store_xmm0_to_temp(dst)
}

fn drv_emit_call_builtin0(fn_id: i64) with Mut, Panic, Div {
    let call_pos = DRV_CODE_LEN
    drv_emit_call_rel32_placeholder()
    drv_add_call_reloc(call_pos + 1, fn_id)
}

fn drv_emit_print_int_from_rax() with Mut, Panic, Div {
    drv_emit_mov_rdi_rax()
    drv_emit_call_builtin0(V2_BUILTIN_PRINT_INT)
}

fn drv_emit_print_char_imm(ch: i64) with Mut, Panic, Div {
    drv_emit_mov_reg_imm(7, ch)
    drv_emit_call_builtin0(V2_BUILTIN_PRINT_CHAR)
}

fn drv_emit_print_f64_from_xmm0() with Mut, Panic, Div {
    // Scale value by 1000000 then round-to-nearest: rax = round(value * 1000000)
    drv_emit_mov_rax_imm(1000000)
    drv_emit_cvtsi2sd_xmm1_rax()
    drv_emit_sse2_xmm0_xmm1(89)
    drv_emit_cvtsd2si_rounding_rax_xmm0()
    // Handle sign: jns_rel8(17) skips push(1)+print_char(12)+pop(1)+neg(3)=17 bytes
    drv_emit_test_rax_rax()
    drv_emit_jns_rel8(17)
    drv_emit_push_rax()
    drv_emit_print_char_imm(45)
    drv_emit_pop_rax()
    drv_emit_neg_rax()
    // Unsigned divide rax/1000000 → rax=int part, rdx=frac(0..999999)
    drv_emit_mov_reg_imm(1, 1000000)
    drv_emit_xor_rdx_rdx()
    drv_emit_div_rcx()
    // Print integer part and '.'
    drv_emit_push_rdx()
    drv_emit_print_int_from_rax()
    drv_emit_print_char_imm(46)
    drv_emit_pop_rax()
    // Split frac into high3 (rax/1000) and low3 (rax%1000); save low3 on stack
    drv_emit_mov_reg_imm(1, 1000)
    drv_emit_xor_rdx_rdx()
    drv_emit_div_rcx()
    drv_emit_push_rdx()
    // Print high3 (rax, 0..999) as 3 digits with leading zeros.
    // Pattern per digit: push n; cmp n,T; jae_rel8(14); pop+push+print('0'); [TARGET]: pop n
    // jae_rel8(14) skips pop(1)+push(1)+print_char(12)=14 bytes; TARGET is the following pop
    drv_emit_push_rax()
    drv_emit_cmp_rax_imm8(100)
    drv_emit_jae_rel8(14)
    drv_emit_pop_rax()
    drv_emit_push_rax()
    drv_emit_print_char_imm(48)
    drv_emit_pop_rax()
    drv_emit_push_rax()
    drv_emit_cmp_rax_imm8(10)
    drv_emit_jae_rel8(14)
    drv_emit_pop_rax()
    drv_emit_push_rax()
    drv_emit_print_char_imm(48)
    drv_emit_pop_rax()
    drv_emit_print_int_from_rax()
    // Print low3 (stack top, 0..999) as 3 digits with leading zeros
    drv_emit_pop_rax()
    drv_emit_push_rax()
    drv_emit_cmp_rax_imm8(100)
    drv_emit_jae_rel8(14)
    drv_emit_pop_rax()
    drv_emit_push_rax()
    drv_emit_print_char_imm(48)
    drv_emit_pop_rax()
    drv_emit_push_rax()
    drv_emit_cmp_rax_imm8(10)
    drv_emit_jae_rel8(14)
    drv_emit_pop_rax()
    drv_emit_push_rax()
    drv_emit_print_char_imm(48)
    drv_emit_pop_rax()
    drv_emit_print_int_from_rax()
}

fn drv_emit_print_f64(arg_reg: i64) with Mut, Panic, Div {
    drv_emit_load_temp_to_xmm0(arg_reg)
    drv_emit_print_f64_from_xmm0()
}

fn drv_emit_call_argc(dst: i64, fn_id: i64, arg0: i64, argc: i64) with Mut, Panic, Div {
    // Push stack args (beyond reg cap of 8) in reverse order so callee sees
    // arg[8] at [rbp+16], arg[9] at [rbp+24], etc. after its prologue.
    let reg_cap: i64 = 8
    var excess: i64 = argc - reg_cap
    if excess < 0 { excess = 0 }
    var sk: i64 = argc - 1
    while sk >= reg_cap {
        drv_emit_load_rbp_disp32_reg(0, drv_ir_slot_offset(arg0 + sk))
        drv_emit_push_rax()
        sk = sk - 1
    }
    if argc >= 1 { drv_emit_load_rbp_disp32_reg(7, drv_ir_slot_offset(arg0)) }
    if argc >= 2 { drv_emit_load_rbp_disp32_reg(6, drv_ir_slot_offset(arg0 + 1)) }
    if argc >= 3 { drv_emit_load_rbp_disp32_reg(2, drv_ir_slot_offset(arg0 + 2)) }
    if argc >= 4 { drv_emit_load_rbp_disp32_reg(1, drv_ir_slot_offset(arg0 + 3)) }
    if argc >= 5 { drv_emit_load_rbp_disp32_reg(8, drv_ir_slot_offset(arg0 + 4)) }
    if argc >= 6 { drv_emit_load_rbp_disp32_reg(9, drv_ir_slot_offset(arg0 + 5)) }
    if argc >= 7 { drv_emit_load_rbp_disp32_reg(10, drv_ir_slot_offset(arg0 + 6)) }
    if argc >= 8 { drv_emit_load_rbp_disp32_reg(11, drv_ir_slot_offset(arg0 + 7)) }
    let call_pos = DRV_CODE_LEN
    drv_emit_call_rel32_placeholder()
    drv_add_call_reloc(call_pos + 1, fn_id)
    if excess > 0 { drv_emit_add_rsp_imm32(excess * 8) }
    if dst >= 0 { drv_core_store_rax_to_temp(dst) }
}

fn drv_emit_call_fnref_switch(dst: i64, arg0: i64, argc: i64) with Mut, Panic, Div {
    let label_end = alloc_label()
    var i: i64 = 0
    while i < V2_USER_FN_COUNT {
        let target_fn = V2_USER_FN_IDS[i as usize]
        let label_next = alloc_label()
        drv_core_load_temp_to_rax(arg0)
        drv_emit_cmp_rax_imm32(target_fn)
        let jnz_pos = DRV_CODE_LEN
        drv_emit_jnz_rel32()
        drv_add_label_patch(jnz_pos + 2, label_next)
        drv_emit_call_argc(dst, target_fn, arg0 + 1, argc - 1)
        let jmp_end_pos = DRV_CODE_LEN
        drv_emit_jmp_rel32()
        drv_add_label_patch(jmp_end_pos + 1, label_end)
        drv_define_label(label_next)
        i = i + 1
    }
    var ci: i64 = 0
    while ci < V2_CLOSURE_COUNT {
        let closure_fn = V2_CLOSURE_FN_IDS[ci as usize]
        let closure_next = alloc_label()
        drv_core_load_temp_to_rax(arg0)
        drv_emit_cmp_rax_imm32(closure_fn)
        let closure_jnz_pos = DRV_CODE_LEN
        drv_emit_jnz_rel32()
        drv_add_label_patch(closure_jnz_pos + 2, closure_next)
        drv_emit_call_argc(dst, closure_fn, arg0 + 1, argc - 1)
        let closure_jmp_end_pos = DRV_CODE_LEN
        drv_emit_jmp_rel32()
        drv_add_label_patch(closure_jmp_end_pos + 1, label_end)
        drv_define_label(closure_next)
        ci = ci + 1
    }
    if dst >= 0 {
        drv_emit_load_imm(dst, 0)
    }
    drv_define_label(label_end)
}

fn drv_emit_call_argc_sret(dst: i64, fn_id: i64, arg0: i64, argc: i64) with Mut, Panic, Div {
    // SRET call: rdi = pointer to caller's result buffer (dst slot), actual
    // args start at rsi (shifted +1). Excess args beyond reg cap of 7 go on stack.
    let sret_reg_cap: i64 = 7
    var sret_excess: i64 = argc - sret_reg_cap
    if sret_excess < 0 { sret_excess = 0 }
    var ssk: i64 = argc - 1
    while ssk >= sret_reg_cap {
        drv_emit_load_rbp_disp32_reg(0, drv_ir_slot_offset(arg0 + ssk))
        drv_emit_push_rax()
        ssk = ssk - 1
    }
    drv_emit_lea_rdi_rbp_disp32(drv_ir_slot_offset(dst))
    if argc >= 1 { drv_emit_load_rbp_disp32_reg(6, drv_ir_slot_offset(arg0)) }
    if argc >= 2 { drv_emit_load_rbp_disp32_reg(2, drv_ir_slot_offset(arg0 + 1)) }
    if argc >= 3 { drv_emit_load_rbp_disp32_reg(1, drv_ir_slot_offset(arg0 + 2)) }
    if argc >= 4 { drv_emit_load_rbp_disp32_reg(8, drv_ir_slot_offset(arg0 + 3)) }
    if argc >= 5 { drv_emit_load_rbp_disp32_reg(9, drv_ir_slot_offset(arg0 + 4)) }
    if argc >= 6 { drv_emit_load_rbp_disp32_reg(10, drv_ir_slot_offset(arg0 + 5)) }
    if argc >= 7 { drv_emit_load_rbp_disp32_reg(11, drv_ir_slot_offset(arg0 + 6)) }
    let call_pos = DRV_CODE_LEN
    drv_emit_call_rel32_placeholder()
    drv_add_call_reloc(call_pos + 1, fn_id)
    if sret_excess > 0 { drv_emit_add_rsp_imm32(sret_excess * 8) }
}

fn drv_emit_call1(dst: i64, fn_id: i64, arg: i64, argc: i64) with Mut, Panic, Div {
    if argc > 0 {
        drv_core_load_temp_to_rax(arg)
        drv_emit_mov_rdi_rax()
    }
    let call_pos = DRV_CODE_LEN
    drv_emit_call_rel32_placeholder()
    drv_add_call_reloc(call_pos + 1, fn_id)
    if dst >= 0 { drv_core_store_rax_to_temp(dst) }
}

fn drv_emit_return(src: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(src)
    drv_emit_mov_rsp_rbp()
    drv_emit_pop_rbp()
    drv_emit_ret()
}

fn drv_emit_return_struct_sret(base_reg: i64, fcount: i64, sret_vreg: i64) with Mut, Panic, Div {
    // Load SRET pointer (caller's result buffer) into rcx (reg 1).
    drv_emit_load_rbp_disp32_reg(1, drv_ir_slot_offset(sret_vreg))
    // Write all struct fields to caller's buffer: [rcx - k*8] = stack[base_reg+k].
    var k: i64 = 0
    while k < fcount {
        drv_core_load_temp_to_rax(base_reg + k)
        // MOV [rcx - k*8], rax  →  48 89 81 <disp32>  (MOV [rcx + disp32], rax)
        let disp = 0 - (k * 8)
        drv_emit_byte(72)
        drv_emit_byte(137)
        drv_emit_byte(129)
        drv_emit_u32_le(disp)
        k = k + 1
    }
    drv_emit_mov_rsp_rbp()
    drv_emit_pop_rbp()
    drv_emit_ret()
}

fn drv_emit_return_struct(base_reg: i64, fcount: i64) with Mut, Panic, Div {
    if fcount > 6 && V2_CURRENT_FN_SRET != 0 && V2_CURRENT_FN_SRET_VREG >= 0 {
        drv_emit_return_struct_sret(base_reg, fcount, V2_CURRENT_FN_SRET_VREG)
        return
    }
    drv_core_load_temp_to_rax(base_reg)
    if fcount >= 2 { drv_emit_load_rbp_disp32_reg(2, drv_ir_slot_offset(base_reg + 1)) }
    if fcount >= 3 { drv_emit_load_rbp_disp32_reg(1, drv_ir_slot_offset(base_reg + 2)) }
    if fcount >= 4 { drv_emit_load_rbp_disp32_reg(8, drv_ir_slot_offset(base_reg + 3)) }
    if fcount >= 5 { drv_emit_load_rbp_disp32_reg(9, drv_ir_slot_offset(base_reg + 4)) }
    if fcount >= 6 { drv_emit_load_rbp_disp32_reg(10, drv_ir_slot_offset(base_reg + 5)) }
    drv_emit_mov_rsp_rbp()
    drv_emit_pop_rbp()
    drv_emit_ret()
}

fn drv_emit_reg_to_temp(reg: i64, dst: i64) with Mut, Panic, Div {
    if dst >= 0 { drv_emit_store_rbp_disp32_reg(reg, drv_ir_slot_offset(dst)) }
}

fn drv_emit_rdx_to_temp(dst: i64) with Mut, Panic, Div {
    drv_emit_reg_to_temp(2, dst)
}

fn drv_emit_copy(dst: i64, src: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(src)
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_temp_addr(dst: i64, src: i64) with Mut, Panic, Div {
    drv_emit_lea_rax_rbp_disp32(drv_ir_slot_offset(src))
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_load_ref_field(dst: i64, base_ref: i64, field_offset_words: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(base_ref)
    drv_emit_mov_reg_reg(3, 0)
    drv_emit_load_rax_mem_rbx_disp32(0 - (field_offset_words * 8))
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_store_ref_field(base_ref: i64, field_offset_words: i64, src: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(base_ref)
    drv_emit_push_rax()
    drv_core_load_temp_to_rax(src)
    drv_emit_pop_rbx()
    drv_emit_store_rax_mem_rbx_disp32(0 - (field_offset_words * 8))
}

fn drv_global_is_byte(global_id: i64) -> bool {
    global_id == V2_GLOBAL_CURSOR_SOURCE || global_id == V2_GLOBAL_DRV_CODE_BYTES || global_id == V2_GLOBAL_DRV_RODATA_BYTES || global_id == V2_GLOBAL_DRV_ELF_BYTES
}

fn drv_emit_driver_global_load(dst: i64, global_id: i64, index_reg: i64) with Mut, Panic, Div {
    let load_pos = DRV_CODE_LEN + 3
    drv_emit_lea_rax_rip_disp32(0)
    drv_add_data_reloc(load_pos, 4096 + (global_id * drv_global_stride()))
    drv_emit_mov_reg_reg(2, 0)
    drv_core_load_temp_to_rax(index_reg)
    drv_emit_mov_reg_reg(3, 0)
    if drv_global_is_byte(global_id) { drv_emit_movzx_rax_byte_rdx_rbx() }
    else { drv_emit_load_rax_mem_rdx_rbx8() }
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_driver_global_store(global_id: i64, index_reg: i64, src: i64) with Mut, Panic, Div {
    let load_pos = DRV_CODE_LEN + 3
    drv_emit_lea_rax_rip_disp32(0)
    drv_add_data_reloc(load_pos, 4096 + (global_id * drv_global_stride()))
    drv_emit_mov_reg_reg(2, 0)
    if index_reg < 0 {
        drv_emit_mov_reg_imm(3, 0)
    } else {
        drv_core_load_temp_to_rax(index_reg)
        drv_emit_mov_reg_reg(3, 0)
    }
    drv_core_load_temp_to_rax(src)
    if drv_global_is_byte(global_id) { drv_emit_store_al_mem_rdx_rbx() }
    else { drv_emit_store_rax_mem_rdx_rbx8() }
}

// M1.2 step D — user-global load: arr[idx] = *(data_top - idx*8)
// BSS arrays use DESCENDING layout (matching stack arrays) so that &bss_array
// pointers work with drv_emit_ref_array_load unchanged. data_top points at
// arr[0] which is stored at the highest address; arr[i] is at data_top - i*8.
fn drv_emit_user_global_load(dst: i64, ug_idx: i64, index_reg: i64) with Mut, Panic, Div {
    let data_offset = USER_GLOBAL_DATA_OFFSET[ug_idx as usize]
    let n = USER_GLOBAL_ELEM_COUNT[ug_idx as usize]
    let top_offset = data_offset + (n - 1) * 8
    let load_pos = DRV_CODE_LEN + 3
    drv_emit_lea_rax_rip_disp32(0)
    drv_add_data_reloc(load_pos, top_offset)
    drv_emit_mov_reg_reg(2, 0)
    drv_core_load_temp_to_rax(index_reg)
    drv_emit_neg_rax_only()
    drv_emit_mov_reg_reg(3, 0)
    drv_emit_load_rax_mem_rdx_rbx8()
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_user_global_store(ug_idx: i64, index_reg: i64, src: i64) with Mut, Panic, Div {
    let data_offset = USER_GLOBAL_DATA_OFFSET[ug_idx as usize]
    let n = USER_GLOBAL_ELEM_COUNT[ug_idx as usize]
    let top_offset = data_offset + (n - 1) * 8
    let load_pos = DRV_CODE_LEN + 3
    drv_emit_lea_rax_rip_disp32(0)
    drv_add_data_reloc(load_pos, top_offset)
    drv_emit_mov_reg_reg(2, 0)
    drv_core_load_temp_to_rax(index_reg)
    drv_emit_neg_rax_only()
    drv_emit_mov_reg_reg(3, 0)
    drv_core_load_temp_to_rax(src)
    drv_emit_store_rax_mem_rdx_rbx8()
}

fn drv_emit_user_global_base(dst: i64, ug_idx: i64) with Mut, Panic, Div {
    let data_offset = USER_GLOBAL_DATA_OFFSET[ug_idx as usize]
    let n = USER_GLOBAL_ELEM_COUNT[ug_idx as usize]
    let top_offset = data_offset + (n - 1) * 8
    let load_pos = DRV_CODE_LEN + 3
    drv_emit_lea_rax_rip_disp32(0)
    drv_add_data_reloc(load_pos, top_offset)
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_local_array_load(dst: i64, base_reg: i64, idx_reg: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(idx_reg)
    drv_emit_neg_rax_only()
    drv_emit_mov_reg_reg(3, 0)
    drv_emit_lea_rax_rbp_disp32(drv_ir_slot_offset(base_reg))
    drv_emit_mov_rax_mem_rax_rbx8()
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_local_array_store(base_reg: i64, idx_reg: i64, src: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(idx_reg)
    drv_emit_neg_rax_only()
    drv_emit_mov_reg_reg(3, 0)
    drv_emit_lea_rax_rbp_disp32(drv_ir_slot_offset(base_reg))
    drv_emit_mov_reg_reg(2, 0)
    drv_core_load_temp_to_rax(src)
    drv_emit_store_rax_mem_rdx_rbx8()
}

fn drv_emit_array_fill(base_reg: i64, val_reg: i64, count: i64) with Mut, Panic, Div {
    // Fill stack array [base_reg .. base_reg+count-1] with the value in val_reg.
    // Uses rep stosq (DF=0, incrementing): rdi = &arr[count-1] (lowest addr), rcx = count.
    // arr[k] is at rbp - (base_reg+k+1)*8; arr[count-1] at rbp - (base_reg+count)*8.
    if count <= 0 { return }
    drv_core_load_temp_to_rax(val_reg)
    // lea rdi, [rbp + disp_of_arr[count-1]]
    drv_emit_lea_rdi_rbp_disp32(drv_ir_slot_offset(base_reg + count - 1))
    // mov rcx, count  →  48 C7 C1 <count as i32>
    drv_emit_byte(72)
    drv_emit_byte(199)
    drv_emit_byte(193)
    drv_emit_u32_le(count)
    // rep stosq  →  F3 48 AB
    drv_emit_byte(243)
    drv_emit_byte(72)
    drv_emit_byte(171)
}

fn drv_emit_bulk_copy(dst_base: i64, src_base: i64, count: i64) with Mut, Panic, Div {
    // Copy count stack slots from src_base..src_base+count-1 → dst_base..dst_base+count-1.
    // Uses rep movsq (DF=0): rsi = &src[count-1], rdi = &dst[count-1], rcx = count.
    if count <= 0 { return }
    drv_emit_lea_rax_rbp_disp32(drv_ir_slot_offset(src_base + count - 1))
    drv_emit_mov_reg_reg(6, 0)
    drv_emit_lea_rdi_rbp_disp32(drv_ir_slot_offset(dst_base + count - 1))
    drv_emit_byte(72)
    drv_emit_byte(199)
    drv_emit_byte(193)
    drv_emit_u32_le(count)
    // rep movsq  →  F3 48 A5
    drv_emit_byte(243)
    drv_emit_byte(72)
    drv_emit_byte(165)
}

fn drv_emit_ref_array_load(dst: i64, ptr_reg: i64, idx_reg: i64) with Mut, Panic, Div {
    // Stack arrays grow downward: a[i] is at *(ptr - i*8).
    // 1) rcx = -index; 2) rax = ptr value; 3) rax = *(rax + rcx*8) = *(ptr - i*8)
    drv_core_load_temp_to_rax(idx_reg)
    drv_emit_neg_rax_only()
    drv_emit_mov_reg_reg(1, 0)
    drv_core_load_temp_to_rax(ptr_reg)
    // mov rax, [rax + rcx*8]  →  48 8B 04 C8
    drv_emit_byte(72)
    drv_emit_byte(139)
    drv_emit_byte(4)
    drv_emit_byte(200)
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_ref_array_store(ptr_reg: i64, idx_reg: i64, val_reg: i64) with Mut, Panic, Div {
    // Stack arrays grow downward: a[i] is at *(ptr - i*8).
    // 1) rcx = -index; 2) rax = ptr value; 3) rdx = val; 4) [rax + rcx*8] = rdx
    drv_core_load_temp_to_rax(idx_reg)
    drv_emit_neg_rax_only()
    drv_emit_mov_reg_reg(1, 0)
    drv_core_load_temp_to_rax(ptr_reg)
    drv_core_load_temp_to_rdx(val_reg)
    // mov [rax + rcx*8], rdx  →  48 89 14 C8
    drv_emit_byte(72)
    drv_emit_byte(137)
    drv_emit_byte(20)
    drv_emit_byte(200)
}

fn drv_emit_arg_count(dst: i64) with Mut, Panic, Div {
    drv_emit_byte(73)
    drv_emit_byte(139)
    drv_emit_byte(6)
    drv_emit_byte(72)
    drv_emit_byte(131)
    drv_emit_byte(232)
    drv_emit_byte(1)
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_get_arg(dst: i64, arg_reg: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(arg_reg)
    drv_emit_mov_reg_reg(3, 0)
    drv_emit_byte(73)
    drv_emit_byte(141)
    drv_emit_byte(70)
    drv_emit_byte(16)
    drv_emit_mov_rax_mem_rax_rbx8()
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_str_len(dst: i64, arg_reg: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(arg_reg)
    drv_emit_mov_reg_reg(7, 0)
    drv_emit_xor_rcx_rcx()
    drv_emit_movzx_rax_byte_rdi()
    drv_emit_test_al_al()
    drv_emit_jz_rel8(8)
    drv_emit_inc_rdi()
    drv_emit_inc_rcx()
    drv_emit_jmp_rel8(-16)
    drv_emit_mov_reg_reg(0, 1)
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_str_char_at(dst: i64, arg0_reg: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(arg0_reg)
    drv_emit_mov_reg_reg(7, 0)
    drv_core_load_temp_to_rax(arg0_reg + 1)
    drv_emit_mov_reg_reg(3, 0)
    drv_emit_movzx_rax_byte_rdi_rbx()
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_str_eq(dst: i64, arg0_reg: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(arg0_reg)
    drv_emit_mov_reg_reg(7, 0)
    drv_core_load_temp_to_rax(arg0_reg + 1)
    drv_emit_mov_reg_reg(6, 0)
    drv_emit_movzx_rax_byte_rdi()
    drv_emit_cmp_al_mem_rsi()
    drv_emit_jnz_rel8(12)
    drv_emit_test_al_al()
    drv_emit_jz_rel8(13)
    drv_emit_inc_rdi()
    drv_emit_inc_rsi()
    drv_emit_jmp_rel8(-20)
    drv_emit_xor_rax_rax()
    drv_emit_jmp_rel8(7)
    drv_emit_mov_rax_imm(1)
    drv_core_store_rax_to_temp(dst)
}

fn drv_emit_driver_read_file(dst: i64, path_reg: i64, source_global_id: i64, len_global_id: i64, max_len: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(path_reg)
    drv_emit_mov_reg_reg(7, 0)
    drv_emit_mov_rax_imm(2)
    drv_emit_mov_reg_imm(6, 0)
    drv_emit_mov_reg_imm(2, 0)
    drv_emit_syscall()
    drv_emit_mov_reg_reg(12, 0)
    drv_emit_mov_reg_reg(7, 12)
    let source_pos = DRV_CODE_LEN + 3
    drv_emit_lea_rax_rip_disp32(0)
    drv_add_data_reloc(source_pos, 4096 + (source_global_id * drv_global_stride()))
    drv_emit_mov_reg_reg(6, 0)
    drv_emit_mov_reg_imm(2, max_len)
    drv_emit_mov_rax_imm(0)
    drv_emit_syscall()
    drv_core_store_rax_to_temp(dst)
    drv_emit_push_rax()
    let len_pos = DRV_CODE_LEN + 3
    drv_emit_lea_rax_rip_disp32(0)
    drv_add_data_reloc(len_pos, 4096 + (len_global_id * drv_global_stride()))
    drv_emit_mov_reg_reg(2, 0)
    drv_emit_mov_reg_imm(3, 0)
    drv_emit_pop_rax()
    drv_emit_store_rax_mem_rdx_rbx8()
}

// Dedicated helper so new heap-builtin dispatch lives in its own stack frame,
// avoiding stage1's miscompilation of new else-if blocks in large functions.
fn emit_heap_builtin_call(i: i64, call_fn_id: i64) -> bool with Mut, Panic, Div {
    let dst = V2_UFN_DST[i as usize]
    let src = V2_UFN_SRC1[i as usize]
    if call_fn_id == V2_BUILTIN_HEAP_ALLOC {
        drv_emit_heap_alloc(dst, src)
        return true
    }
    if call_fn_id == V2_BUILTIN_HEAP_FREE {
        drv_emit_heap_free(dst, src)
        return true
    }
    if call_fn_id == V2_BUILTIN_READ_I64 {
        drv_emit_read_i64(dst, src)
        return true
    }
    if call_fn_id == V2_BUILTIN_WRITE_I64 {
        drv_emit_write_i64(dst, src)
        return true
    }
    if call_fn_id == V2_BUILTIN_HEAP_REALLOC {
        drv_emit_heap_realloc(dst, src)
        return true
    }
    false
}

fn compile_ufn_from_globals(fn_id: i64) -> bool with IO, Mut, Panic, Div {
    drv_begin_function(fn_id)
    var i: i64 = 0
    while i < V2_UFN_COUNT {
        let op = V2_UFN_OPS[i as usize]
        let src1_val = V2_UFN_SRC1[i as usize]
        if op == UFN_LOAD_IMM {
            drv_emit_load_imm(V2_UFN_DST[i as usize], V2_UFN_IMM[i as usize])
        } else if op == UFN_LOAD_F64_SCALED {
            drv_emit_load_f64_scaled(V2_UFN_DST[i as usize], V2_UFN_IMM[i as usize], V2_UFN_FLOAT_SCALE[i as usize])
        } else if op == UFN_LOAD_STRING {
            let ro_off = driver_append_ufn_string_literal(i)
            drv_emit_load_string_offset(V2_UFN_DST[i as usize], ro_off)
        } else if op == UFN_BINOP {
            if !drv_emit_any_binop(V2_UFN_DST[i as usize], src1_val, V2_UFN_BINOP_CODE[i as usize], V2_UFN_SRC2[i as usize]) {
                // M1.2 — surface which binop opcode tripped us.
                print("native_compile: binop_unsupported op=BINOP code=")
                print_int(V2_UFN_BINOP_CODE[i as usize])
                print(" ufn_idx=")
                print_int(i)
                print("\n")
                return false
            }
        } else if op == UFN_F64_BINOP {
            if !drv_emit_f64_binop(V2_UFN_DST[i as usize], src1_val, V2_UFN_BINOP_CODE[i as usize], V2_UFN_SRC2[i as usize]) {
                print("native_compile: binop_unsupported op=F64_BINOP code=")
                print_int(V2_UFN_BINOP_CODE[i as usize])
                print(" ufn_idx=")
                print_int(i)
                print("\n")
                return false
            }
        } else if op == UFN_LABEL {
            drv_define_label(V2_UFN_LABEL_ID[i as usize])
        } else if op == UFN_JUMP {
            let jmp_pos = DRV_CODE_LEN
            drv_emit_jmp_rel32()
            drv_add_label_patch(jmp_pos + 1, V2_UFN_LABEL_ID[i as usize])
        } else if op == UFN_BRANCH_FALSE {
            drv_core_load_temp_to_rax(V2_UFN_SRC1[i as usize])
            drv_emit_test_rax_rax()
            let jz_pos = DRV_CODE_LEN
            drv_emit_jz_rel32()
            drv_add_label_patch(jz_pos + 2, V2_UFN_LABEL_ID[i as usize])
        } else if op == UFN_RETURN {
            drv_emit_return(V2_UFN_SRC1[i as usize])
        } else if op == UFN_RETURN_STRUCT {
            drv_emit_return_struct(V2_UFN_SRC1[i as usize], V2_UFN_IMM[i as usize])
        } else if op == UFN_CALL {
            let call_argc = V2_UFN_IMM[i as usize]
            let call_fn_id = V2_UFN_FN_ID[i as usize]
            if call_fn_id == V2_BUILTIN_ARG_COUNT {
                drv_emit_arg_count(V2_UFN_DST[i as usize])
            } else if call_fn_id == V2_BUILTIN_PRINT_F64 {
                drv_emit_print_f64(V2_UFN_SRC1[i as usize])
            } else if call_fn_id == V2_BUILTIN_SQRT_F64 {
                drv_emit_sqrt_f64(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize])
            } else if call_fn_id == V2_BUILTIN_GET_ARG {
                drv_emit_get_arg(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize])
            } else if call_fn_id == V2_BUILTIN_STR_LEN {
                drv_emit_str_len(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize])
            } else if call_fn_id == V2_BUILTIN_STR_CHAR_AT {
                drv_emit_str_char_at(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize])
            } else if call_fn_id == V2_BUILTIN_STR_EQ {
                drv_emit_str_eq(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize])
            } else if call_fn_id == V2_BUILTIN_PT_READ_KIND_CODE {
                drv_emit_driver_global_load(V2_UFN_DST[i as usize], V2_GLOBAL_PT_KIND_CODE, V2_UFN_SRC1[i as usize])
            } else if call_fn_id == V2_BUILTIN_PT_READ_START {
                drv_emit_driver_global_load(V2_UFN_DST[i as usize], V2_GLOBAL_PT_START, V2_UFN_SRC1[i as usize])
            } else if call_fn_id == V2_BUILTIN_PT_READ_END {
                drv_emit_driver_global_load(V2_UFN_DST[i as usize], V2_GLOBAL_PT_END, V2_UFN_SRC1[i as usize])
            } else if call_fn_id == V2_BUILTIN_PT_READ_INT_VALUE {
                drv_emit_driver_global_load(V2_UFN_DST[i as usize], V2_GLOBAL_PT_INT_VALUE, V2_UFN_SRC1[i as usize])
            } else if call_fn_id == V2_BUILTIN_DRIVER_READ_FILE_TO_GLOBALS {
                drv_emit_driver_read_file(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize], V2_GLOBAL_CURSOR_SOURCE, V2_GLOBAL_CURSOR_SOURCE_LEN, drv_global_stride())
            } else if call_fn_id == V2_BUILTIN_INDIRECT_CALL {
                drv_emit_call_fnref_switch(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize], call_argc)
            } else if emit_heap_builtin_call(i, call_fn_id) {
                // handled by heap-builtin helper (separate frame avoids stage1 miscompile)
            } else if call_argc > 1 {
                drv_emit_call_argc(V2_UFN_DST[i as usize], V2_UFN_FN_ID[i as usize], V2_UFN_SRC1[i as usize], call_argc)
            } else {
                drv_emit_call1(V2_UFN_DST[i as usize], V2_UFN_FN_ID[i as usize], V2_UFN_SRC1[i as usize], call_argc)
            }
        } else if op == UFN_CALL_STRUCT_RESULT {
            let rf = V2_UFN_RESULT_FCOUNT[i as usize]
            let dst_reg = V2_UFN_DST[i as usize]
            if rf > 6 {
                // Large struct: SRET — callee writes directly to caller's result buffer
                drv_emit_call_argc_sret(dst_reg, V2_UFN_FN_ID[i as usize], V2_UFN_SRC1[i as usize], V2_UFN_IMM[i as usize])
            } else {
                drv_emit_call_argc(dst_reg, V2_UFN_FN_ID[i as usize], V2_UFN_SRC1[i as usize], V2_UFN_IMM[i as usize])
                if dst_reg >= 0 {
                    if rf >= 2 { drv_emit_reg_to_temp(2, dst_reg + 1) }
                    if rf >= 3 { drv_emit_reg_to_temp(1, dst_reg + 2) }
                    if rf >= 4 { drv_emit_reg_to_temp(8, dst_reg + 3) }
                    if rf >= 5 { drv_emit_reg_to_temp(9, dst_reg + 4) }
                    if rf >= 6 { drv_emit_reg_to_temp(10, dst_reg + 5) }
                }
            }
        } else if op == UFN_COPY {
            drv_emit_copy(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize])
        } else if op == UFN_TEMP_ADDR {
            drv_emit_temp_addr(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize])
        } else if op == UFN_LOAD_REF_FIELD {
            drv_emit_load_ref_field(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize], V2_UFN_IMM[i as usize])
        } else if op == UFN_STORE_REF_FIELD {
            drv_emit_store_ref_field(V2_UFN_SRC1[i as usize], V2_UFN_IMM[i as usize], V2_UFN_SRC2[i as usize])
        } else if op == UFN_GLOBAL_LOAD {
            drv_emit_driver_global_load(V2_UFN_DST[i as usize], V2_UFN_IMM[i as usize], V2_UFN_SRC1[i as usize])
        } else if op == UFN_GLOBAL_STORE {
            drv_emit_driver_global_store(V2_UFN_IMM[i as usize], V2_UFN_SRC1[i as usize], V2_UFN_SRC2[i as usize])
        } else if op == UFN_LOCAL_LOAD {
            drv_emit_local_array_load(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize], V2_UFN_SRC2[i as usize])
        } else if op == UFN_LOCAL_STORE {
            drv_emit_local_array_store(V2_UFN_SRC1[i as usize], V2_UFN_SRC2[i as usize], V2_UFN_DST[i as usize])
        } else if op == UFN_USER_GLOBAL_LOAD {
            drv_emit_user_global_load(V2_UFN_DST[i as usize], V2_UFN_IMM[i as usize], V2_UFN_SRC1[i as usize])
        } else if op == UFN_USER_GLOBAL_STORE {
            drv_emit_user_global_store(V2_UFN_IMM[i as usize], V2_UFN_SRC1[i as usize], V2_UFN_SRC2[i as usize])
        } else if op == UFN_REF_ARRAY_LOAD {
            drv_emit_ref_array_load(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize], V2_UFN_SRC2[i as usize])
        } else if op == UFN_REF_ARRAY_STORE {
            drv_emit_ref_array_store(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize], V2_UFN_SRC2[i as usize])
        } else if op == UFN_CVT_I64_TO_F64 {
            drv_emit_cvt_i64_to_f64(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize])
        } else if op == UFN_CVT_F64_TO_I64 {
            drv_emit_cvt_f64_to_i64(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize])
        } else if op == UFN_ARRAY_FILL {
            drv_emit_array_fill(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize], V2_UFN_IMM[i as usize])
        } else if op == UFN_BULK_COPY {
            drv_emit_bulk_copy(V2_UFN_DST[i as usize], V2_UFN_SRC1[i as usize], V2_UFN_IMM[i as usize])
        } else if op == UFN_USER_GLOBAL_BASE {
            drv_emit_user_global_base(V2_UFN_DST[i as usize], V2_UFN_IMM[i as usize])
        }
        i = i + 1
    }
    drv_patch_labels()
    true
}

fn compile_closure_fn(cidx: i64) -> bool with IO, Mut, Panic, Div, Alloc {
    if cidx < 0 || cidx >= V2_CLOSURE_COUNT { return false }
    var ctx = v2_driver_context_new()
    reset_locals(&! ctx)
    reset_user_fn_label_state()
    reset_parse_unsupported()
    V2_CURRENT_PARAM_COUNT = 0
    V2_CURRENT_FN_SRET = 0
    V2_CURRENT_FN_SRET_VREG = -1

    let param_start = V2_CLOSURE_PARAM_START[cidx as usize]
    let param_count = V2_CLOSURE_PARAM_COUNT[cidx as usize]
    var pi: i64 = 0
    while pi < param_count {
        let pslot = param_start + pi
        let vreg = alloc_reg(&! ctx)
        remember_local_tok(&! ctx, V2_CLOSURE_PARAM_NAME_TOK[pslot as usize], vreg)
        if V2_CLOSURE_PARAM_IS_F64[pslot as usize] != 0 { mark_reg_f64(vreg) }
        if pi < 64 { V2_CURRENT_PARAM_REGS[pi as usize] = vreg }
        V2_CURRENT_PARAM_COUNT = pi + 1
        pi = pi + 1
    }

    V2_UFN_COUNT = 0
    var func: i64 = 0
    let body = parse_expr_ir(&! func, &! ctx, V2_CLOSURE_BODY_START[cidx as usize])
    let body_end = V2_CLOSURE_BODY_END[cidx as usize]
    var body_consumed: i64 = 0
    if body.next == body_end { body_consumed = 1 }
    if token_kind(body.next) == TK_RBRACE && body.next + 1 == body_end { body_consumed = 1 }
    if body.ok == 0 || body_consumed == 0 {
        print("native_compile: closure_unsupported token=")
        print_int(V2_CLOSURE_START_TOK[cidx as usize])
        print("\n")
        return false
    }
    ufn_record_return(body.reg)
    if V2_PARSE_UNSUPPORTED != 0 {
        print("native_compile: closure_unsupported token=")
        print_int(V2_PARSE_UNSUPPORTED_TOKEN)
        print(" kind=")
        print_int(V2_PARSE_UNSUPPORTED_KIND)
        print(" text=")
        print_token_text(V2_PARSE_UNSUPPORTED_TOKEN)
        print("\n")
        return false
    }
    let fn_id = V2_CLOSURE_FN_IDS[cidx as usize]
    if !compile_ufn_from_globals(fn_id) {
        print("native_compile: closure_codegen_failed idx=")
        print_int(cidx)
        print(" ufn_ops=")
        print_int(V2_UFN_COUNT)
        print("\n")
        return false
    }
    drv_patch_frame_size(fn_id, V2_NEXT_REG)
    true
}

fn compile_user_fn(fn_name_tok: i64, fn_id: i64, token_count: i64) -> bool with IO, Mut, Panic, Div, Alloc {
    // Find fn name_str_pos
    var name_pos: i64 = -1
    var i: i64 = 0
    while i + 1 < token_count {
        if token_kind(i) == TK_FN && token_kind(i + 1) == TK_IDENT {
            if toks_ident_eq(i + 1, fn_name_tok) {
                name_pos = i + 1
                i = token_count
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    if name_pos < 0 {
        print("native_compile: unsupported_frontend fn=")
        print_token_text(fn_name_tok)
        print(" reason=name_not_found\n")
        return false
    }
    let open_pos = find_fn_lbrace(token_count, name_pos)
    if open_pos < 0 {
        print("native_compile: unsupported_frontend fn=")
        print_token_text(fn_name_tok)
        print(" reason=no_open_brace\n")
        return false
    }
    let close_pos = find_matching_rbrace(open_pos, token_count)
    if close_pos < 0 {
        print("native_compile: unsupported_frontend fn=")
        print_token_text(fn_name_tok)
        print(" reason=unbalanced_braces\n")
        return false
    }

    var ctx = v2_driver_context_new()
    reset_locals(&! ctx)
    reset_user_fn_label_state()
    reset_parse_unsupported()
    V2_CURRENT_PARAM_COUNT = 0
    var func: i64 = 0

    // Detect large-struct return → SRET: allocate a hidden vreg for the caller's
    // result pointer (passed in rdi before regular args).
    V2_CURRENT_FN_SRET = 0
    V2_CURRENT_FN_SRET_VREG = -1
    let fn_ret_sidx = lookup_user_fn_return_struct_idx(fn_id)
    if fn_ret_sidx >= 0 {
        let fn_ret_flat = STRUCT_FLAT_SIZE[fn_ret_sidx as usize]
        if fn_ret_flat > 6 {
            V2_CURRENT_FN_SRET = 1
            V2_CURRENT_FN_SRET_VREG = alloc_reg(&! ctx)
        }
    }
    // Also enable SRET for functions returning large arrays ([T; N] with N > 6)
    if V2_CURRENT_FN_SRET == 0 {
        let fn_ret_arr = lookup_user_fn_return_arr_size(fn_id)
        if fn_ret_arr > 6 {
            V2_CURRENT_FN_SRET = 1
            V2_CURRENT_FN_SRET_VREG = alloc_reg(&! ctx)
        }
    }

    // Parse parameters: fn name(param: type, ...) -> ...
    // params are between '(' and ')'
    var pp = name_pos + 1
    while pp < open_pos && token_kind(pp) != TK_LPAREN { pp = pp + 1 }
    if pp < open_pos && token_kind(pp) == TK_LPAREN {
        var param_idx: i64 = 0
        var ppos = pp + 1
        while ppos < open_pos && token_kind(ppos) != TK_RPAREN {
            if token_kind(ppos) == TK_IDENT {
                let param_name_tok = ppos
                // Refinement type `{ d: T | pred }` in param position. N-v2 does
                // not enforce the predicate here, but the runtime representation is
                // the inner scalar type, matching Track A for these run-pass cases.
                var refinement_skip: i64 = 0
                if ppos + 2 <= open_pos && token_kind(ppos + 1) == TK_COLON && token_kind(ppos + 2) == TK_LBRACE {
                    refinement_skip = 1
                    let refinement_end = find_matching_rbrace(ppos + 2, open_pos)
                    if refinement_end < 0 {
                        mark_parse_unsupported_refinement(ppos + 2)
                        ppos = open_pos
                    } else {
                        var refinement_type_tok: i64 = -1
                        var rtp = ppos + 3
                        while rtp + 2 < refinement_end && refinement_type_tok < 0 && token_kind(rtp) != TK_OR {
                            if token_kind(rtp) == TK_IDENT && token_kind(rtp + 1) == TK_COLON && token_kind(rtp + 2) == TK_IDENT {
                                refinement_type_tok = rtp + 2
                            }
                            rtp = rtp + 1
                        }
                        let refinement_type_ok =
                            refinement_type_tok >= 0 &&
                            (token_text_eq(refinement_type_tok, "i32") ||
                             token_text_eq(refinement_type_tok, "i64") ||
                             token_text_eq(refinement_type_tok, "f64"))
                        if !refinement_type_ok {
                            mark_parse_unsupported_refinement(ppos + 2)
                            ppos = open_pos
                        } else {
                            let vreg = alloc_reg(&! ctx)
                            remember_local_tok(&! ctx, param_name_tok, vreg)
                            if token_text_eq(refinement_type_tok, "f64") {
                                mark_reg_f64(vreg)
                            }
                            if param_idx < 64 {
                                V2_CURRENT_PARAM_REGS[param_idx as usize] = vreg
                            }
                            V2_CURRENT_PARAM_COUNT = param_idx + 1
                            param_idx = param_idx + 1
                            ppos = refinement_end + 1
                            if ppos < open_pos && token_kind(ppos) == TK_COMMA { ppos = ppos + 1 }
                        }
                    }
                }
                if refinement_skip == 0 {
                // peek at type: param_name : TypeName
                var param_sidx: i64 = -1
                var param_is_ref: i64 = 0
                var param_generic_f64: i64 = 0
                var param_is_fnref: i64 = 0
                if ppos + 2 < open_pos && token_kind(ppos + 1) == TK_COLON && token_kind(ppos + 2) == TK_IDENT {
                    param_sidx = find_struct_idx_tok(ppos + 2)
                    if ppos + 5 < open_pos && token_kind(ppos + 3) == TK_LT && token_kind(ppos + 4) == TK_IDENT && token_kind(ppos + 5) == TK_GT && token_text_eq(ppos + 4, "f64") {
                        param_generic_f64 = 1
                    }
                }
                if ppos + 2 < open_pos && token_kind(ppos + 1) == TK_COLON && token_kind(ppos + 2) == TK_FN {
                    param_is_fnref = 1
                }
                if ppos + 3 < open_pos && token_kind(ppos + 1) == TK_COLON && token_kind(ppos + 2) == TK_AMPBANG && token_kind(ppos + 3) == TK_IDENT {
                    param_sidx = find_struct_idx_tok(ppos + 3)
                    param_is_ref = 1
                }
                // M1.2: plain `& TypeName` (immutable ref) — register as ref struct local
                // (TK_AMP = 141; using literal to avoid hoisted-const ambiguity)
                if ppos + 3 < open_pos && token_kind(ppos + 1) == TK_COLON && token_kind(ppos + 2) == 141 && token_kind(ppos + 3) == TK_IDENT {
                    param_sidx = find_struct_idx_tok(ppos + 3)
                    param_is_ref = 1
                }
                // `& [T; N]` — ref-to-array param: IS_REF=1, sidx=-1.
                // (TK_AMP=141, TK_LBRACKET=178; using literals for hoisted-const safety)
                var param_arr_is_f64: i64 = 0
                if ppos + 3 < open_pos && token_kind(ppos + 1) == TK_COLON && token_kind(ppos + 2) == 141 && token_kind(ppos + 3) == 178 {
                    param_is_ref = 1
                    if ppos + 4 < open_pos && token_kind(ppos + 4) == TK_IDENT && token_text_eq(ppos + 4, "f64") { param_arr_is_f64 = 1 }
                }
                // `&! [T; N]` — exclusive ref-to-array param: IS_REF=1, sidx=-1.
                // (TK_AMPBANG=163, TK_LBRACKET=178; using literals for hoisted-const safety)
                if ppos + 3 < open_pos && token_kind(ppos + 1) == TK_COLON && token_kind(ppos + 2) == 163 && token_kind(ppos + 3) == 178 {
                    param_is_ref = 1
                    if ppos + 4 < open_pos && token_kind(ppos + 4) == TK_IDENT && token_text_eq(ppos + 4, "f64") { param_arr_is_f64 = 1 }
                }
                // `[T; N]` — by-value array param: treat as ref (caller passes address, callee uses pointer access)
                // Token sequence: name : [ T ; N ] (TK_LBRACKET=178, TK_SEMI=180)
                if ppos + 5 < open_pos && token_kind(ppos + 1) == TK_COLON && token_kind(ppos + 2) == 178 && token_kind(ppos + 3) == TK_IDENT && token_kind(ppos + 4) == 180 && token_kind(ppos + 5) == TK_INT {
                    param_is_ref = 1
                    if token_text_eq(ppos + 3, "f64") { param_arr_is_f64 = 1 }
                }
                if param_is_fnref != 0 {
                    let vreg = alloc_reg(&! ctx)
                    remember_local_tok(&! ctx, param_name_tok, vreg)
                    mark_reg_fnref(vreg)
                    if param_idx < 64 {
                        V2_CURRENT_PARAM_REGS[param_idx as usize] = vreg
                    }
                    V2_CURRENT_PARAM_COUNT = param_idx + 1
                    param_idx = param_idx + 1
                } else if param_sidx >= 0 && param_is_ref != 0 {
                    let vreg = alloc_reg(&! ctx)
                    remember_ref_struct_local_tok(&! ctx, param_name_tok, vreg, param_sidx)
                    if param_idx < 64 {
                        V2_CURRENT_PARAM_REGS[param_idx as usize] = vreg
                    }
                    V2_CURRENT_PARAM_COUNT = param_idx + 1
                    param_idx = param_idx + 1
                } else if param_sidx >= 0 {
                    let flat_size = STRUCT_FLAT_SIZE[param_sidx as usize]
                    if flat_size > 6 {
                        // Large struct: caller passes pointer (single register)
                        let vreg = alloc_reg(&! ctx)
                        remember_ref_struct_local_tok(&! ctx, param_name_tok, vreg, param_sidx)
                        if param_idx < 64 { V2_CURRENT_PARAM_REGS[param_idx as usize] = vreg }
                        V2_CURRENT_PARAM_COUNT = param_idx + 1
                        param_idx = param_idx + 1
                    } else {
                        // Small struct: allocate flat_size consecutive vregs
                        let base_vreg = alloc_reg(&! ctx)
                        var ri: i64 = 1
                        while ri < flat_size { let _ = alloc_reg(&! ctx); ri = ri + 1 }
                        remember_struct_local_tok(&! ctx, param_name_tok, base_vreg, param_sidx)
                        if param_generic_f64 != 0 {
                            mark_struct_scalar_regs_f64(base_vreg, param_sidx)
                        } else {
                            mark_struct_regs(base_vreg, param_sidx)
                        }
                        var pi: i64 = 0
                        while pi < flat_size && param_idx + pi < 64 {
                            V2_CURRENT_PARAM_REGS[(param_idx + pi) as usize] = base_vreg + pi
                            pi = pi + 1
                        }
                        V2_CURRENT_PARAM_COUNT = param_idx + flat_size
                        param_idx = param_idx + flat_size
                    }
                } else if param_is_ref != 0 {
                    // ref-array param (& [T; N]): IS_REF=1, sidx=-1
                    let vreg = alloc_reg(&! ctx)
                    remember_ref_struct_local_tok(&! ctx, param_name_tok, vreg, -1)
                    if param_arr_is_f64 != 0 { mark_reg_f64(vreg) }
                    if param_idx < 64 {
                        V2_CURRENT_PARAM_REGS[param_idx as usize] = vreg
                    }
                    V2_CURRENT_PARAM_COUNT = param_idx + 1
                    param_idx = param_idx + 1
                } else {
                    // scalar param
                    let vreg = alloc_reg(&! ctx)
                    remember_local_tok(&! ctx, param_name_tok, vreg)
                    if ppos + 2 < open_pos && token_kind(ppos + 1) == TK_COLON && token_kind(ppos + 2) == TK_IDENT && token_text_eq(ppos + 2, "f64") {
                        mark_reg_f64(vreg)
                    }
                    if param_idx < 64 {
                        V2_CURRENT_PARAM_REGS[param_idx as usize] = vreg
                    }
                    V2_CURRENT_PARAM_COUNT = param_idx + 1
                    param_idx = param_idx + 1
                }
                ppos = ppos + 1
                var paren_depth: i64 = 0
                var angle_depth: i64 = 0
                while ppos < open_pos {
                    let tk = token_kind(ppos)
                    if paren_depth == 0 && angle_depth == 0 {
                        if tk == TK_COMMA || tk == TK_RPAREN { break }
                    }
                    if tk == TK_LPAREN { paren_depth = paren_depth + 1 }
                    else if tk == TK_RPAREN { paren_depth = paren_depth - 1 }
                    else if tk == TK_LT { angle_depth = angle_depth + 1 }
                    else if tk == TK_GT { angle_depth = angle_depth - 1 }
                    ppos = ppos + 1
                }
                if ppos < open_pos && token_kind(ppos) == TK_COMMA { ppos = ppos + 1 }
                }
            } else {
                ppos = ppos + 1
            }
        }
    }

    // Parse body
    V2_UFN_COUNT = 0
    var _unused_func_ref: i64 = 0
    parse_block_ir(&! _unused_func_ref, &! ctx, open_pos + 1, close_pos, token_count)
    let default_ret = alloc_reg(&! ctx)
    ufn_record_load_imm(default_ret, 0)
    ufn_record_return(default_ret)
    if V2_PARSE_UNSUPPORTED != 0 {
        print("native_compile: unsupported_frontend fn=")
        print_token_text(fn_name_tok)
        print(" token=")
        print_int(V2_PARSE_UNSUPPORTED_TOKEN)
        print(" kind=")
        print_int(V2_PARSE_UNSUPPORTED_KIND)
        if V2_PARSE_UNSUPPORTED_REASON == 1 {
            print(" reason=unresolved_call")
        }
        if V2_PARSE_UNSUPPORTED_REASON == 2 {
            print(" reason=pathsep_in_expr")
        }
        if V2_PARSE_UNSUPPORTED_REASON == 3 {
            print(" reason=refinement_type")
        }
        print(" text=")
        print_token_text(V2_PARSE_UNSUPPORTED_TOKEN)
        print("\n")
        return false
    }
    if !compile_ufn_from_globals(fn_id) {
        // M1.2 — surface the function name and IR-op count so we can tell
        // which UFN opcode tripped `compile_ufn_from_globals`.
        print("native_compile: user_fn_unsupported fn_id=")
        print_int(fn_id)
        print(" name=")
        print_token_text(fn_name_tok)
        print(" ufn_ops=")
        print_int(V2_UFN_COUNT)
        print("\n")
        return false
    }
    drv_patch_frame_size(fn_id, V2_NEXT_REG)
    true
}

fn find_main_lbrace(token_count: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i + 2 < token_count {
        if token_kind(i) == TK_FN && token_kind(i + 1) == TK_IDENT && token_text_eq(i + 1, "main") {
            var j = i + 2
            while j < token_count {
                if token_kind(j) == TK_LBRACE {
                    return j
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    -1
}

fn find_matching_rbrace(open_idx: i64, token_count: i64) -> i64 with Mut, Panic {
    var depth: i64 = 1
    var i = open_idx + 1
    while i < token_count {
        let k = token_kind(i)
        if k == TK_LBRACE { depth = depth + 1 }
        if k == TK_RBRACE {
            depth = depth - 1
            if depth == 0 {
                return i
            }
        }
        i = i + 1
    }
    -1
}

fn drv_begin_builtin(fn_id: i64) with Mut, Panic {
    drv_reset_function_state()
    if fn_id >= 0 && fn_id < 2048 {
        DRV_FN_OFFSETS[fn_id as usize] = DRV_CODE_LEN
    }
}

fn drv_emit_stdout_write() with Mut, Panic, Div {
    drv_emit_mov_reg_imm(7, 1)
    drv_emit_mov_rax_imm(1)
    drv_emit_syscall()
}

fn drv_emit_builtin_print_str(fn_id: i64) with Mut, Panic, Div {
    drv_begin_builtin(fn_id)
    drv_emit_push_rbp()
    drv_emit_mov_rbp_rsp()
    drv_emit_mov_reg_reg(6, 7)
    // Null-guard: print(0) / print(null) must not dereference address 0.
    // jz +38 skips xor(3)+movzx(4)+test(2)+jz(2)+inc(3)+inc(3)+jmp(2)+mov(3)+write(16)=38.
    drv_emit_test_rdi_rdi()
    drv_emit_jz_rel8(38)
    drv_emit_xor_rcx_rcx()
    drv_emit_movzx_rax_byte_rdi()
    drv_emit_test_al_al()
    drv_emit_jz_rel8(8)
    drv_emit_inc_rdi()
    drv_emit_inc_rcx()
    drv_emit_jmp_rel8(-16)
    drv_emit_mov_reg_reg(2, 1)
    drv_emit_stdout_write()
    drv_emit_pop_rbp()
    drv_emit_ret()
}

fn drv_emit_builtin_print_char(fn_id: i64) with Mut, Panic, Div {
    drv_begin_builtin(fn_id)
    drv_emit_push_rdi()
    drv_emit_mov_rsi_rsp()
    drv_emit_mov_reg_imm(2, 1)
    drv_emit_stdout_write()
    drv_emit_add_rsp_8()
    drv_emit_ret()
}

fn drv_emit_builtin_print_int(fn_id: i64) with Mut, Panic, Div {
    drv_begin_builtin(fn_id)
    drv_emit_push_rbp()
    drv_emit_mov_rbp_rsp()
    drv_emit_sub_rsp_imm32(32)
    drv_emit_xor_r8_r8()
    drv_emit_test_rdi_rdi()
    drv_emit_jns_rel8(6)
    drv_emit_neg_rdi()
    drv_emit_inc_r8()
    drv_emit_mov_reg_reg(0, 7)
    drv_emit_mov_reg_reg(6, 5)
    drv_emit_sub_rsi_imm8(1)
    drv_emit_xor_rcx_rcx()
    drv_emit_xor_rdx_rdx()
    drv_emit_mov_reg_imm(3, 10)
    drv_emit_div_rbx()
    drv_emit_add_rdx_imm8(48)
    drv_emit_mov_byte_mem_rsi_dl()
    drv_emit_dec_rsi()
    drv_emit_inc_rcx()
    drv_emit_test_rax_rax()
    drv_emit_jnz_rel8(-30)
    drv_emit_test_r8_r8()
    drv_emit_jz_rel8(9)
    drv_emit_mov_byte_mem_rsi_imm8(45)
    drv_emit_dec_rsi()
    drv_emit_inc_rcx()
    drv_emit_inc_rsi()
    drv_emit_mov_reg_reg(2, 1)
    drv_emit_stdout_write()
    drv_emit_mov_rsp_rbp()
    drv_emit_pop_rbp()
    drv_emit_ret()
}

fn drv_emit_builtin_write_elf(fn_id: i64) with Mut, Panic, Div {
    drv_begin_builtin(fn_id)
    drv_emit_mov_reg_reg(3, 6)
    drv_emit_mov_rax_imm(2)
    drv_emit_mov_reg_imm(6, 577)
    drv_emit_mov_reg_imm(2, 493)
    drv_emit_syscall()
    drv_emit_mov_reg_reg(7, 0)
    let data_pos = DRV_CODE_LEN + 3
    drv_emit_lea_rax_rip_disp32(0)
    drv_add_data_reloc(data_pos, 4096 + (V2_GLOBAL_DRV_ELF_BYTES * drv_global_stride()))
    drv_emit_mov_reg_reg(6, 0)
    drv_emit_mov_reg_reg(2, 3)
    drv_emit_mov_rax_imm(1)
    drv_emit_syscall()
