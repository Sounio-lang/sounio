        V2_UFN_OPS[idx as usize] = UFN_CVT_I64_TO_F64
        V2_UFN_DST[idx as usize] = dst
        V2_UFN_SRC1[idx as usize] = src
        V2_UFN_COUNT = idx + 1
        mark_reg_f64(dst)
    }
}

fn ufn_record_ref_array_store(ptr_reg: i64, idx_reg: i64, val_reg: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 4096 {
        V2_UFN_OPS[idx as usize] = UFN_REF_ARRAY_STORE
        V2_UFN_DST[idx as usize] = ptr_reg
        V2_UFN_SRC1[idx as usize] = idx_reg
        V2_UFN_SRC2[idx as usize] = val_reg
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_binop(dst: i64, src1: i64, binop_code: i64, src2: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 4096 {
        V2_UFN_OPS[idx as usize] = UFN_BINOP
        V2_UFN_DST[idx as usize] = dst
        V2_UFN_SRC1[idx as usize] = src1
        V2_UFN_SRC2[idx as usize] = src2
        V2_UFN_BINOP_CODE[idx as usize] = binop_code
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_load_f64_scaled(dst: i64, mantissa: i64, scale: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 4096 {
        V2_UFN_OPS[idx as usize] = UFN_LOAD_F64_SCALED
        V2_UFN_DST[idx as usize] = dst
        V2_UFN_IMM[idx as usize] = mantissa
        V2_UFN_FLOAT_SCALE[idx as usize] = scale
        V2_UFN_COUNT = idx + 1
        mark_reg_f64(dst)
    }
}

fn ufn_record_f64_binop(dst: i64, src1: i64, binop_code: i64, src2: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 4096 {
        V2_UFN_OPS[idx as usize] = UFN_F64_BINOP
        V2_UFN_DST[idx as usize] = dst
        V2_UFN_SRC1[idx as usize] = src1
        V2_UFN_SRC2[idx as usize] = src2
        V2_UFN_BINOP_CODE[idx as usize] = binop_code
        V2_UFN_COUNT = idx + 1
        if binop_code >= 1 && binop_code <= 4 {
            mark_reg_f64(dst)
        } else {
            mark_reg_i64(dst)
        }
    }
}

fn ufn_record_label(label_id: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 4096 {
        V2_UFN_OPS[idx as usize] = UFN_LABEL
        V2_UFN_LABEL_ID[idx as usize] = label_id
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_jump(label_id: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 4096 {
        V2_UFN_OPS[idx as usize] = UFN_JUMP
        V2_UFN_LABEL_ID[idx as usize] = label_id
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_branch_false(cond_reg: i64, label_id: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 4096 {
        V2_UFN_OPS[idx as usize] = UFN_BRANCH_FALSE
        V2_UFN_SRC1[idx as usize] = cond_reg
        V2_UFN_LABEL_ID[idx as usize] = label_id
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_return(src: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 4096 {
        V2_UFN_OPS[idx as usize] = UFN_RETURN
        V2_UFN_SRC1[idx as usize] = src
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_call(dst: i64, fn_id_val: i64, arg0: i64, argc: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 4096 {
        V2_UFN_OPS[idx as usize] = UFN_CALL
        V2_UFN_DST[idx as usize] = dst
        V2_UFN_FN_ID[idx as usize] = fn_id_val
        V2_UFN_SRC1[idx as usize] = arg0
        V2_UFN_IMM[idx as usize] = argc
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_emit_direct_knowledge_runtime_guard_values_step_walk(ctx: &! V2DriverContext, base_reg: i64, field_offset: i64, cmp_code: i64, threshold: i64, threshold_scale: i64, threshold_kind: i64, row_idx: i64) with Mut {
    if base_reg < 0 || field_offset < 0 {
        return
    }
    let value_reg = base_reg + field_offset
    var step_count: i64 = 0
    if row_idx >= 0 && row_idx < 256 {
        step_count = V2_ROW_STREAM_ROW_STEP_COUNT[row_idx as usize]
    }
    if step_count > 0 {
        // True step_at(row_idx, j) driven emission: pre-computed op sequence.
        let threshold_reg = alloc_reg(ctx)
        let ratio_reg = alloc_reg(ctx)
        let one_reg = alloc_reg(ctx)
        let cmp_reg = alloc_reg(ctx)
        let zero_reg = alloc_reg(ctx)
        let eq_zero = alloc_reg(ctx)
        let fail_dst = alloc_reg(ctx)
        let label_ok = alloc_label()
        var saw_divide: bool = false
        var j: i64 = 0
        while j < step_count {
            let step_slot = row_idx * 10 + j
            let op_kind = V2_ROW_STREAM_STEP_OP[step_slot as usize]
            if op_kind == 1 {
                if threshold_kind == 3 || threshold_kind == 2 {
                    ufn_record_load_f64_scaled(threshold_reg, threshold, threshold_scale)
                } else {
                    ufn_record_load_imm(threshold_reg, threshold)
                }
            } else if op_kind == 8 {
                ufn_record_f64_binop(ratio_reg, value_reg, 4, threshold_reg)
                saw_divide = true
            } else if op_kind == 9 {
                ufn_record_load_f64_scaled(one_reg, 1, 1)
            } else if op_kind == 2 {
                if saw_divide {
                    ufn_record_f64_binop(cmp_reg, ratio_reg, cmp_code, one_reg)
                } else if threshold_kind == 2 || threshold_kind == 3 {
                    ufn_record_f64_binop(cmp_reg, value_reg, cmp_code, threshold_reg)
                } else {
                    ufn_record_binop(cmp_reg, value_reg, cmp_code, threshold_reg)
                }
            } else if op_kind == 3 {
                ufn_record_load_imm(zero_reg, 0)
            } else if op_kind == 4 {
                ufn_record_binop(eq_zero, cmp_reg, 5, zero_reg)
            } else if op_kind == 5 {
                ufn_record_branch_false(eq_zero, label_ok)
            } else if op_kind == 6 {
                ufn_record_call(fail_dst, V2_BUILTIN_SYS_EXIT_1, 0, 0)
            } else if op_kind == 7 {
                ufn_record_label(label_ok)
            }
            j = j + 1
        }
        V2_DIRECT_KNOWLEDGE_GUARD_EMITTED = V2_DIRECT_KNOWLEDGE_GUARD_EMITTED + 1
        return
    }
    // Fallback: inline emission (used when step data not yet hydrated).
    let cmp_reg2 = alloc_reg(ctx)
    if threshold_kind == 3 && threshold != 0 {
        let threshold_reg2 = alloc_reg(ctx)
        ufn_record_load_f64_scaled(threshold_reg2, threshold, threshold_scale)
        let ratio_reg2 = alloc_reg(ctx)
        ufn_record_f64_binop(ratio_reg2, value_reg, 4, threshold_reg2)
        let one_reg2 = alloc_reg(ctx)
        ufn_record_load_f64_scaled(one_reg2, 1, 1)
        ufn_record_f64_binop(cmp_reg2, ratio_reg2, cmp_code, one_reg2)
    } else if threshold_kind == 2 || threshold_kind == 3 {
        let threshold_reg2 = alloc_reg(ctx)
        ufn_record_load_f64_scaled(threshold_reg2, threshold, threshold_scale)
        ufn_record_f64_binop(cmp_reg2, value_reg, cmp_code, threshold_reg2)
    } else {
        let threshold_reg2 = alloc_reg(ctx)
        ufn_record_load_imm(threshold_reg2, threshold)
        ufn_record_binop(cmp_reg2, value_reg, cmp_code, threshold_reg2)
    }
    let zero_reg2 = alloc_reg(ctx)
    ufn_record_load_imm(zero_reg2, 0)
    let eq_zero2 = alloc_reg(ctx)
    ufn_record_binop(eq_zero2, cmp_reg2, 5, zero_reg2)
    let label_ok2 = alloc_label()
    ufn_record_branch_false(eq_zero2, label_ok2)
    let fail_dst2 = alloc_reg(ctx)
    ufn_record_call(fail_dst2, V2_BUILTIN_SYS_EXIT_1, 0, 0)
    ufn_record_label(label_ok2)
    V2_DIRECT_KNOWLEDGE_GUARD_EMITTED = V2_DIRECT_KNOWLEDGE_GUARD_EMITTED + 1
}

fn drv_precompute_knowledge_guard_step_walk(source_path: string) with IO, Mut, Panic, Div, Alloc {
    let plan = knowledge_runtime_guard_lowering_plan_build(source_path)
    if plan.native_lowering_ready {
        V2_ROW_STREAM_READY = true
        V2_ROW_STREAM_BACKEND_COUNT = plan.backend_guard_count
        print("native_compile: row_stream_step_walk_ready=1 backend_guard_count=")
        print_int(V2_ROW_STREAM_BACKEND_COUNT)
        print("\n")
    }
}

fn drv_hydrate_knowledge_guard_row_stream_payloads(source_path: string) with IO, Mut, Panic, Div, Alloc {
    V2_ROW_STREAM_PAYLOAD_READY = false
    V2_ROW_STREAM_PAYLOAD_COUNT = 0
    V2_ROW_STREAM_PAYLOAD_THRESHOLD_COUNT = 0
    var clear_i: i64 = 0
    while clear_i < 256 {
        V2_ROW_STREAM_ROW_READY[clear_i as usize] = 0
        V2_ROW_STREAM_ROW_THRESHOLD_READY[clear_i as usize] = 0
        V2_ROW_STREAM_ROW_SITE_KIND[clear_i as usize] = 0
        V2_ROW_STREAM_ROW_TYPE_STRUCT_IDX[clear_i as usize] = -1
        V2_ROW_STREAM_ROW_FIELD_OFFSET[clear_i as usize] = -1
        V2_ROW_STREAM_ROW_CMP_CODE[clear_i as usize] = 0
        V2_ROW_STREAM_ROW_THRESHOLD[clear_i as usize] = 0
        V2_ROW_STREAM_ROW_THRESHOLD_SCALE[clear_i as usize] = 1
        V2_ROW_STREAM_ROW_THRESHOLD_KIND[clear_i as usize] = 0
        V2_ROW_STREAM_ROW_STEP_COUNT[clear_i as usize] = 0
        clear_i = clear_i + 1
    }
    if !V2_ROW_STREAM_READY {
        return
    }
    var limit = V2_ROW_STREAM_BACKEND_COUNT
    if limit > 256 { limit = 256 }
    var i: i64 = 0
    while i < limit {
        let row = knowledge_runtime_guard_lowering_plan_row_at(source_path, i)
        if row.row_ready {
            let type_sidx = find_struct_idx_name(row.type_name)
            let field_offset = struct_field_offset_name(type_sidx, row.field_name)
            if type_sidx >= 0 && field_offset >= 0 {
                V2_ROW_STREAM_ROW_READY[i as usize] = 1
                V2_ROW_STREAM_ROW_SITE_KIND[i as usize] = row.site_kind
                V2_ROW_STREAM_ROW_TYPE_STRUCT_IDX[i as usize] = type_sidx
                V2_ROW_STREAM_ROW_FIELD_OFFSET[i as usize] = field_offset
                V2_ROW_STREAM_ROW_CMP_CODE[i as usize] = row.native_cmp_code
                V2_ROW_STREAM_ROW_THRESHOLD_SCALE[i as usize] = row.value_scale
                V2_ROW_STREAM_ROW_THRESHOLD_KIND[i as usize] = row.threshold_kind
                V2_ROW_STREAM_PAYLOAD_COUNT = V2_ROW_STREAM_PAYLOAD_COUNT + 1
                if row.threshold_kind == 1 || row.threshold_kind == 2 || row.threshold_kind == 3 {
                    V2_ROW_STREAM_ROW_THRESHOLD_READY[i as usize] = 1
                    V2_ROW_STREAM_ROW_THRESHOLD[i as usize] = row.scaled_value
                    V2_ROW_STREAM_PAYLOAD_THRESHOLD_COUNT = V2_ROW_STREAM_PAYLOAD_THRESHOLD_COUNT + 1
                }
                // Walk step_at(i, j) to pre-compute op sequence for step-driven emission.
                let emplan = knowledge_runtime_guard_native_emission_plan_at(source_path, i)
                if emplan.plan_ready {
                    var sc = emplan.native_step_count
                    if sc > 10 { sc = 10 }
                    V2_ROW_STREAM_ROW_STEP_COUNT[i as usize] = sc
                    var j: i64 = 0
                    while j < sc {
                        let step = knowledge_runtime_guard_native_emission_step_from_plan(emplan, j)
                        let step_slot = i * 10 + j
                        V2_ROW_STREAM_STEP_OP[step_slot as usize] = step.op_kind
                        j = j + 1
                    }
                }
            }
        }
        i = i + 1
    }
    if V2_ROW_STREAM_PAYLOAD_COUNT > 0 {
        V2_ROW_STREAM_PAYLOAD_READY = true
        print("native_compile: row_stream_payload_ready=1 count=")
        print_int(V2_ROW_STREAM_PAYLOAD_COUNT)
        print(" threshold_payload_count=")
        print_int(V2_ROW_STREAM_PAYLOAD_THRESHOLD_COUNT)
        print("\n")
    }
}

fn row_stream_site_kind_for_user_guard_site(site: i64) -> i64 {
    if site == 1 { return 2 }
    if site == 2 { return 1 }
    0
}

fn row_stream_local_site_matches(site: i64) -> bool {
    return site == 3 || site == 4
}

fn ufn_emit_row_stream_payload_guard(ctx: &! V2DriverContext, base_reg: i64, wanted_site_kind: i64, wanted_type_sidx: i64, guard_count: i64, allow_local_site: i64) -> bool with Mut {
    if !V2_ROW_STREAM_PAYLOAD_READY || wanted_type_sidx < 0 {
        return false
    }
    var max_rows = guard_count
    if max_rows <= 0 { max_rows = 1 }
    if max_rows > 4 { max_rows = 4 }
    var emitted: i64 = 0
    var i: i64 = 0
    var limit = V2_ROW_STREAM_BACKEND_COUNT
    if limit > 256 { limit = 256 }
    while i < limit && emitted < max_rows {
        if V2_ROW_STREAM_ROW_READY[i as usize] != 0 &&
           V2_ROW_STREAM_ROW_THRESHOLD_READY[i as usize] != 0 &&
           V2_ROW_STREAM_ROW_TYPE_STRUCT_IDX[i as usize] == wanted_type_sidx {
            var site_matches = V2_ROW_STREAM_ROW_SITE_KIND[i as usize] == wanted_site_kind
            if allow_local_site != 0 {
                site_matches = row_stream_local_site_matches(V2_ROW_STREAM_ROW_SITE_KIND[i as usize])
            }
            if site_matches {
                ufn_emit_direct_knowledge_runtime_guard_values_step_walk(
                    ctx,
                    base_reg,
                    V2_ROW_STREAM_ROW_FIELD_OFFSET[i as usize],
                    V2_ROW_STREAM_ROW_CMP_CODE[i as usize],
                    V2_ROW_STREAM_ROW_THRESHOLD[i as usize],
                    V2_ROW_STREAM_ROW_THRESHOLD_SCALE[i as usize],
                    V2_ROW_STREAM_ROW_THRESHOLD_KIND[i as usize],
                    i
                )
                V2_ROW_STREAM_PAYLOAD_GUARD_EMITTED = V2_ROW_STREAM_PAYLOAD_GUARD_EMITTED + 1
                emitted = emitted + 1
            }
        }
        i = i + 1
    }
    return emitted > 0
}

fn ufn_emit_direct_knowledge_runtime_guard_values(ctx: &! V2DriverContext, base_reg: i64, field_offset: i64, cmp_code: i64, threshold: i64, threshold_scale: i64, threshold_kind: i64) with Mut {
    if base_reg < 0 || field_offset < 0 {
        return
    }
    if V2_ROW_STREAM_READY && threshold_kind > 0 {
        ufn_emit_direct_knowledge_runtime_guard_values_step_walk(ctx, base_reg, field_offset, cmp_code, threshold, threshold_scale, threshold_kind, 0 - 1)
        return
    }
    let value_reg = base_reg + field_offset
    let cmp_reg = alloc_reg(ctx)
    if threshold_kind == 3 && threshold != 0 {
        let threshold_reg = alloc_reg(ctx)
        ufn_record_load_f64_scaled(threshold_reg, threshold, threshold_scale)
        let ratio_reg = alloc_reg(ctx)
        ufn_record_f64_binop(ratio_reg, value_reg, 4, threshold_reg)
        let one_reg = alloc_reg(ctx)
        ufn_record_load_f64_scaled(one_reg, 1, 1)
        ufn_record_f64_binop(cmp_reg, ratio_reg, cmp_code, one_reg)
    } else if threshold_kind == 2 || threshold_kind == 3 {
        let threshold_reg = alloc_reg(ctx)
        ufn_record_load_f64_scaled(threshold_reg, threshold, threshold_scale)
        ufn_record_f64_binop(cmp_reg, value_reg, cmp_code, threshold_reg)
    } else {
        let threshold_reg = alloc_reg(ctx)
        ufn_record_load_imm(threshold_reg, threshold)
        ufn_record_binop(cmp_reg, value_reg, cmp_code, threshold_reg)
    }
    let zero_reg = alloc_reg(ctx)
    ufn_record_load_imm(zero_reg, 0)
    let eq_zero = alloc_reg(ctx)
    ufn_record_binop(eq_zero, cmp_reg, 5, zero_reg)
    let label_ok = alloc_label()
    ufn_record_branch_false(eq_zero, label_ok)
    let fail_dst = alloc_reg(ctx)
    ufn_record_call(fail_dst, V2_BUILTIN_SYS_EXIT_1, 0, 0)
    ufn_record_label(label_ok)
    V2_DIRECT_KNOWLEDGE_GUARD_EMITTED = V2_DIRECT_KNOWLEDGE_GUARD_EMITTED + 1
}

fn ufn_emit_direct_knowledge_runtime_guard(ctx: &! V2DriverContext, guard_idx: i64, base_reg: i64) with Mut {
    if guard_idx < 0 || guard_idx >= 512 {
        return
    }
    if V2_USER_FN_KNOWLEDGE_GUARD_ENABLED[guard_idx as usize] == 0 {
        return
    }
    var guard_count = V2_USER_FN_KNOWLEDGE_GUARD_COUNT[guard_idx as usize]
    if guard_count <= 0 { guard_count = 1 }
    if guard_count > 4 { guard_count = 4 }
    let row_stream_site = row_stream_site_kind_for_user_guard_site(V2_USER_FN_KNOWLEDGE_GUARD_SITE[guard_idx as usize])
    if ufn_emit_row_stream_payload_guard(
        ctx,
        base_reg,
        row_stream_site,
        V2_USER_FN_KNOWLEDGE_GUARD_TYPE_STRUCT_IDX[guard_idx as usize],
        guard_count,
        0
    ) {
        return
    }
    var slot: i64 = 0
    while slot < guard_count {
        let row = guard_idx * 4 + slot
        ufn_emit_direct_knowledge_runtime_guard_values(
            ctx,
            base_reg,
            V2_USER_FN_KNOWLEDGE_GUARD_ROW_FIELD_OFFSET[row as usize],
            V2_USER_FN_KNOWLEDGE_GUARD_ROW_CMP_CODE[row as usize],
            V2_USER_FN_KNOWLEDGE_GUARD_ROW_THRESHOLD[row as usize],
            V2_USER_FN_KNOWLEDGE_GUARD_ROW_THRESHOLD_SCALE[row as usize],
            V2_USER_FN_KNOWLEDGE_GUARD_ROW_THRESHOLD_KIND[row as usize]
        )
        slot = slot + 1
    }
}

fn ufn_emit_local_knowledge_runtime_guard(ctx: &! V2DriverContext, guard_idx: i64, base_reg: i64) with Mut {
    if guard_idx < 0 || guard_idx >= 64 {
        return
    }
    if V2_LOCAL_KNOWLEDGE_GUARD_ENABLED[guard_idx as usize] == 0 {
        return
    }
    var guard_count = V2_LOCAL_KNOWLEDGE_GUARD_COUNT[guard_idx as usize]
    if guard_count <= 0 { guard_count = 1 }
    if guard_count > 4 { guard_count = 4 }
    if ufn_emit_row_stream_payload_guard(
        ctx,
        base_reg,
        0,
        V2_LOCAL_KNOWLEDGE_GUARD_TYPE_STRUCT_IDX[guard_idx as usize],
        guard_count,
        1
    ) {
        return
    }
    var slot: i64 = 0
    while slot < guard_count {
        let row = guard_idx * 4 + slot
        ufn_emit_direct_knowledge_runtime_guard_values(
            ctx,
            base_reg,
            V2_LOCAL_KNOWLEDGE_GUARD_ROW_FIELD_OFFSET[row as usize],
            V2_LOCAL_KNOWLEDGE_GUARD_ROW_CMP_CODE[row as usize],
            V2_LOCAL_KNOWLEDGE_GUARD_ROW_THRESHOLD[row as usize],
            V2_LOCAL_KNOWLEDGE_GUARD_ROW_THRESHOLD_SCALE[row as usize],
            V2_LOCAL_KNOWLEDGE_GUARD_ROW_THRESHOLD_KIND[row as usize]
        )
        slot = slot + 1
    }
}

fn ufn_record_copy(dst: i64, src: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 4096 {
        V2_UFN_OPS[idx as usize] = UFN_COPY
        V2_UFN_DST[idx as usize] = dst
        V2_UFN_SRC1[idx as usize] = src
        V2_UFN_COUNT = idx + 1
        if reg_is_fnref_f64(src) { mark_reg_fnref_f64(dst) }
        else if reg_is_fnref(src) { mark_reg_fnref(dst) }
        else if reg_is_f64(src) { mark_reg_f64(dst) }
        else { mark_reg_i64(dst) }
    }
}

fn ufn_record_return_struct(base_reg: i64, fcount: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 4096 {
        V2_UFN_OPS[idx as usize] = UFN_RETURN_STRUCT
        V2_UFN_SRC1[idx as usize] = base_reg
        V2_UFN_IMM[idx as usize] = fcount
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_call_struct_result(dst: i64, fn_id: i64, arg0: i64, argc: i64, result_fcount: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 4096 {
        V2_UFN_OPS[idx as usize] = UFN_CALL_STRUCT_RESULT
        V2_UFN_DST[idx as usize] = dst
        V2_UFN_FN_ID[idx as usize] = fn_id
        V2_UFN_SRC1[idx as usize] = arg0
        V2_UFN_IMM[idx as usize] = argc
        V2_UFN_RESULT_FCOUNT[idx as usize] = result_fcount
        V2_UFN_COUNT = idx + 1
    }
}

fn builtin_fn_id(name: Name) -> i64 with Mut, Panic, Div {
    if name_eq_text(name, "print") { return V2_BUILTIN_PRINT }
    if name_eq_text(name, "print_int") { return V2_BUILTIN_PRINT_INT }
    if name_eq_text(name, "print_char") { return V2_BUILTIN_PRINT_CHAR }
    if name_eq_text(name, "print_f64") { return V2_BUILTIN_PRINT_F64 }
    if name_eq_text(name, "sqrt_f64") { return V2_BUILTIN_SQRT_F64 }
    if name_eq_text(name, "sqrt") { return V2_BUILTIN_SQRT_F64 }
    if name_eq_text(name, "f64_to_bits") { return V2_BUILTIN_F64_TO_BITS }
    if name_eq_text(name, "bits_to_f64") { return V2_BUILTIN_BITS_TO_F64 }
    if name_eq_text(name, "arg_count") { return V2_BUILTIN_ARG_COUNT }
    if name_eq_text(name, "get_arg_count") { return V2_BUILTIN_ARG_COUNT }
    if name_eq_text(name, "get_arg") { return V2_BUILTIN_GET_ARG }
    if name_eq_text(name, "str_eq") { return V2_BUILTIN_STR_EQ }
    if name_eq_text(name, "str_len") { return V2_BUILTIN_STR_LEN }
    if name_eq_text(name, "str_char_at") { return V2_BUILTIN_STR_CHAR_AT }
    if name_eq_text(name, "pt_read_kind_code") { return V2_BUILTIN_PT_READ_KIND_CODE }
    if name_eq_text(name, "pt_read_start") { return V2_BUILTIN_PT_READ_START }
    if name_eq_text(name, "pt_read_end") { return V2_BUILTIN_PT_READ_END }
    if name_eq_text(name, "pt_read_int_value") { return V2_BUILTIN_PT_READ_INT_VALUE }
    if name_eq_text(name, "empty_name") { return V2_BUILTIN_EMPTY_NAME }
    if name_eq_text(name, "driver_read_file_to_cursor_source") { return V2_BUILTIN_DRIVER_READ_FILE_TO_GLOBALS }
    if name_eq_text(name, "driver_write_elf_to_file") { return V2_BUILTIN_DRIVER_WRITE_ELF }
    if name_eq_text(name, "driver_make_executable") { return V2_BUILTIN_DRIVER_CHMOD }
    if name_eq_text(name, "println") { return V2_BUILTIN_PRINTLN }
    if name_eq_text(name, "assert") { return V2_BUILTIN_ASSERT }
    if name_eq_text(name, "heap_alloc") { return V2_BUILTIN_HEAP_ALLOC }
    if name_eq_text(name, "heap_free") { return V2_BUILTIN_HEAP_FREE }
    if name_eq_text(name, "read_i64") { return V2_BUILTIN_READ_I64 }
    if name_eq_text(name, "write_i64") { return V2_BUILTIN_WRITE_I64 }
    if name_eq_text(name, "heap_realloc") { return V2_BUILTIN_HEAP_REALLOC }
    if name_eq_text(name, "gpu_thread_id_x") { return V2_BUILTIN_GPU_INTRINSIC }
    if name_eq_text(name, "gpu_thread_id_y") { return V2_BUILTIN_GPU_INTRINSIC }
    if name_eq_text(name, "gpu_thread_id_z") { return V2_BUILTIN_GPU_INTRINSIC }
    if name_eq_text(name, "gpu_block_id_x") { return V2_BUILTIN_GPU_INTRINSIC }
    if name_eq_text(name, "gpu_block_id_y") { return V2_BUILTIN_GPU_INTRINSIC }
    if name_eq_text(name, "gpu_block_id_z") { return V2_BUILTIN_GPU_INTRINSIC }
    if name_eq_text(name, "gpu_block_dim_x") { return V2_BUILTIN_GPU_INTRINSIC }
    if name_eq_text(name, "gpu_block_dim_y") { return V2_BUILTIN_GPU_INTRINSIC }
    if name_eq_text(name, "gpu_block_dim_z") { return V2_BUILTIN_GPU_INTRINSIC }
    if name_eq_text(name, "gpu_barrier") { return V2_BUILTIN_GPU_INTRINSIC }
    if name_eq_text(name, "gpu_barrier_sync") { return V2_BUILTIN_GPU_INTRINSIC }
    if name_eq_text(name, "gpu_sync_threads") { return V2_BUILTIN_GPU_INTRINSIC }
    -1
}

fn builtin_fn_id_tok(tok: i64) -> i64 with Mut, Panic, Div {
    if token_text_eq(tok, "print") { return V2_BUILTIN_PRINT }
    if token_text_eq(tok, "print_int") { return V2_BUILTIN_PRINT_INT }
    if token_text_eq(tok, "print_char") { return V2_BUILTIN_PRINT_CHAR }
    if token_text_eq(tok, "print_f64") { return V2_BUILTIN_PRINT_F64 }
    if token_text_eq(tok, "sqrt_f64") { return V2_BUILTIN_SQRT_F64 }
    if token_text_eq(tok, "sqrt") { return V2_BUILTIN_SQRT_F64 }
    if token_text_eq(tok, "f64_to_bits") { return V2_BUILTIN_F64_TO_BITS }
    if token_text_eq(tok, "bits_to_f64") { return V2_BUILTIN_BITS_TO_F64 }
    if token_text_eq(tok, "measure") { return V2_BUILTIN_MEASURE }
    if token_text_eq(tok, "arg_count") { return V2_BUILTIN_ARG_COUNT }
    if token_text_eq(tok, "get_arg_count") { return V2_BUILTIN_ARG_COUNT }
    if token_text_eq(tok, "get_arg") { return V2_BUILTIN_GET_ARG }
    if token_text_eq(tok, "str_eq") { return V2_BUILTIN_STR_EQ }
    if token_text_eq(tok, "str_len") { return V2_BUILTIN_STR_LEN }
    if token_text_eq(tok, "str_char_at") { return V2_BUILTIN_STR_CHAR_AT }
    if token_text_eq(tok, "pt_read_kind_code") { return V2_BUILTIN_PT_READ_KIND_CODE }
    if token_text_eq(tok, "pt_read_start") { return V2_BUILTIN_PT_READ_START }
    if token_text_eq(tok, "pt_read_end") { return V2_BUILTIN_PT_READ_END }
    if token_text_eq(tok, "pt_read_int_value") { return V2_BUILTIN_PT_READ_INT_VALUE }
    if token_text_eq(tok, "empty_name") { return V2_BUILTIN_EMPTY_NAME }
    if token_text_eq(tok, "driver_read_file_to_cursor_source") { return V2_BUILTIN_DRIVER_READ_FILE_TO_GLOBALS }
    if token_text_eq(tok, "driver_write_elf_to_file") { return V2_BUILTIN_DRIVER_WRITE_ELF }
    if token_text_eq(tok, "driver_make_executable") { return V2_BUILTIN_DRIVER_CHMOD }
    if token_text_eq(tok, "println") { return V2_BUILTIN_PRINTLN }
    if token_text_eq(tok, "assert") { return V2_BUILTIN_ASSERT }
    if token_text_eq(tok, "heap_alloc") { return V2_BUILTIN_HEAP_ALLOC }
    if token_text_eq(tok, "heap_free") { return V2_BUILTIN_HEAP_FREE }
    if token_text_eq(tok, "read_i64") { return V2_BUILTIN_READ_I64 }
    if token_text_eq(tok, "write_i64") { return V2_BUILTIN_WRITE_I64 }
    if token_text_eq(tok, "heap_realloc") { return V2_BUILTIN_HEAP_REALLOC }
    if token_text_eq(tok, "gpu_thread_id_x") { return V2_BUILTIN_GPU_INTRINSIC }
    if token_text_eq(tok, "gpu_thread_id_y") { return V2_BUILTIN_GPU_INTRINSIC }
    if token_text_eq(tok, "gpu_thread_id_z") { return V2_BUILTIN_GPU_INTRINSIC }
    if token_text_eq(tok, "gpu_block_id_x") { return V2_BUILTIN_GPU_INTRINSIC }
    if token_text_eq(tok, "gpu_block_id_y") { return V2_BUILTIN_GPU_INTRINSIC }
    if token_text_eq(tok, "gpu_block_id_z") { return V2_BUILTIN_GPU_INTRINSIC }
    if token_text_eq(tok, "gpu_block_dim_x") { return V2_BUILTIN_GPU_INTRINSIC }
    if token_text_eq(tok, "gpu_block_dim_y") { return V2_BUILTIN_GPU_INTRINSIC }
    if token_text_eq(tok, "gpu_block_dim_z") { return V2_BUILTIN_GPU_INTRINSIC }
    if token_text_eq(tok, "gpu_barrier") { return V2_BUILTIN_GPU_INTRINSIC }
    if token_text_eq(tok, "gpu_barrier_sync") { return V2_BUILTIN_GPU_INTRINSIC }
    if token_text_eq(tok, "gpu_sync_threads") { return V2_BUILTIN_GPU_INTRINSIC }
    -1
}

// ============================================================
// IR-only parse functions (for user-defined functions)
// No V2_CORE side effects; builds IrFunction directly
// ============================================================

fn parse_if_expr_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64) -> ExprParse with Mut, Panic, Div, Alloc {
    // Expression form: `if COND { THEN_EXPR } else { ELSE_EXPR }`.
    // Both arms must be tail-expression blocks (single expression, no statements).
    // Returns ExprParse with reg holding the chosen value and next past the closing `}`.
    let cond = parse_expr_ir(func, ctx, pos + 1)
    if cond.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
    var p = cond.next
    p = skip_trivia(p, V2_TOKEN_COUNT)
    if token_kind(p) != TK_LBRACE { return ExprParse { ok: 0, reg: -1, next: pos} }
    let then_close = find_matching_rbrace(p, V2_TOKEN_COUNT)
    if then_close < 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
    var after_then = skip_trivia(then_close + 1, V2_TOKEN_COUNT)
    if token_kind(after_then) != TK_ELSE { return ExprParse { ok: 0, reg: -1, next: pos} }
    let after_else = skip_trivia(after_then + 1, V2_TOKEN_COUNT)
    if token_kind(after_else) != TK_LBRACE { return ExprParse { ok: 0, reg: -1, next: pos} }
    let else_close = find_matching_rbrace(after_else, V2_TOKEN_COUNT)
    if else_close < 0 { return ExprParse { ok: 0, reg: -1, next: pos} }

    let dst = alloc_reg(ctx)
    let label_else = alloc_label()
    let label_end = alloc_label()
    ufn_record_branch_false(cond.reg, label_else)
    // then arm: parse single tail expression inside the braces.
    let then_start = skip_trivia(p + 1, then_close)
    let then_expr = parse_expr_ir(func, ctx, then_start)
    if then_expr.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
    if then_expr.reg != dst { ufn_record_copy(dst, then_expr.reg) }
    ufn_record_jump(label_end)
    ufn_record_label(label_else)
    let else_start = skip_trivia(after_else + 1, else_close)
    let else_expr = parse_expr_ir(func, ctx, else_start)
    if else_expr.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
    if else_expr.reg != dst { ufn_record_copy(dst, else_expr.reg) }
    ufn_record_label(label_end)
    return ExprParse { ok: 1, reg: dst, next: else_close + 1}
}

fn parse_array_lit_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64) -> ExprParse with Mut, Panic, Div, Alloc {
    let arr_base = V2_NEXT_REG
    var ac = pos + 1
    if token_kind(ac) != TK_RBRACKET {
        var depth2: i64 = 1
        var sc = ac
        var semi_at: i64 = -1
        while sc < V2_TOKEN_COUNT && depth2 > 0 {
            let sk = token_kind(sc)
            if sk == TK_LBRACKET { depth2 = depth2 + 1 }
            else if sk == TK_RBRACKET { depth2 = depth2 - 1 }
            else if sk == TK_SEMI && depth2 == 1 { semi_at = sc; break }
            sc = sc + 1
        }
        if semi_at >= 0 && token_kind(semi_at + 1) == TK_INT {
            let fill_n = pt_read_int_value(semi_at + 1)
            V2_NEXT_REG = arr_base + fill_n
            let fill_val = parse_expr_ir(func, ctx, ac)
            if fill_val.ok != 0 {
                ufn_record_array_fill(arr_base, fill_val.reg, fill_n)
                var ec = semi_at + 2
                while ec < V2_TOKEN_COUNT && token_kind(ec) != TK_RBRACKET { ec = ec + 1 }
                if token_kind(ec) == TK_RBRACKET {
                    V2_LAST_STRUCT_IDX = -1
                    return ExprParse { ok: 1, reg: arr_base, next: ec + 1}
                }
            }
            return ExprParse { ok: 0, reg: -1, next: pos}
        }
    }
    var slot: i64 = 0
    while ac < V2_TOKEN_COUNT && token_kind(ac) != TK_RBRACKET {
        if token_kind(ac) == TK_COMMA { ac = ac + 1; continue }
        let ep = parse_expr_ir(func, ctx, ac)
        if ep.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
        if ep.reg != arr_base + slot {
            ufn_record_copy(arr_base + slot, ep.reg)
        }
        slot = slot + 1
        ac = ep.next
    }
    if token_kind(ac) == TK_RBRACKET {
        V2_LAST_STRUCT_IDX = -1
        return ExprParse { ok: 1, reg: arr_base, next: ac + 1}
    }
    return ExprParse { ok: 0, reg: -1, next: pos}
}

fn parse_atom_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64) -> ExprParse with Mut, Panic, Div, Alloc {
    let k = token_kind(pos)
    if k == TK_IF {
        return parse_if_expr_ir(func, ctx, pos)
    }
    if k == TK_MATCH {
        return parse_match_expr_ir(func, ctx, pos)
    }
    if k == TK_OR || k == TK_OROR {
        return parse_closure_literal_ref_ir(ctx, pos)
    }
    if k == TK_BANG {
        let inner = parse_atom_ir(func, ctx, pos + 1)
        if inner.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
        let dst = alloc_reg(ctx)
        let zero = alloc_reg(ctx)
        ufn_record_load_imm(zero, 0)
        ufn_record_binop(dst, inner.reg, 5, zero)
        return ExprParse { ok: 1, reg: dst, next: inner.next}
    }
    if k == TK_TILDE {
        let inner = parse_atom_ir(func, ctx, pos + 1)
        if inner.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
        let dst = alloc_reg(ctx)
        let neg1 = alloc_reg(ctx)
        ufn_record_load_imm(neg1, -1)
        ufn_record_binop(dst, inner.reg, 13, neg1)
        return ExprParse { ok: 1, reg: dst, next: inner.next}
    }
    if k == TK_MINUS && token_kind(pos + 1) == TK_INT {
        if token_kind(pos + 2) == TK_DOT && token_kind(pos + 3) == TK_INT {
            let r = alloc_reg(ctx)
            let frac_digits = token_decimal_digit_count(pos + 3)
            let scale = decimal_scale_for_digits(frac_digits)
            let mantissa = (pt_read_int_value(pos + 1) * scale) + pt_read_int_value(pos + 3)
            ufn_record_load_f64_scaled(r, 0 - mantissa, scale)
            return ExprParse { ok: 1, reg: r, next: pos + 4}
        }
        let r = alloc_reg(ctx)
        ufn_record_load_imm(r, 0 - pt_read_int_value(pos + 1))
        return ExprParse { ok: 1, reg: r, next: pos + 2}
    }
    if k == TK_MINUS && token_kind(pos + 1) == TK_FLOAT {
        let r = alloc_reg(ctx)
        ufn_record_load_f64_scaled(r, 0 - token_float_mantissa(pos + 1), token_float_scale(pos + 1))
        return ExprParse { ok: 1, reg: r, next: pos + 2}
    }
    if k == TK_MINUS {
        let inner = parse_atom_ir(func, ctx, pos + 1)
        if inner.ok != 0 {
            let zero = alloc_reg(ctx)
            let dst = alloc_reg(ctx)
            if reg_is_f64(inner.reg) {
                ufn_record_load_f64_scaled(zero, 0, 1)
                mark_reg_f64(dst)
                ufn_record_f64_binop(dst, zero, 2, inner.reg)
            } else {
                ufn_record_load_imm(zero, 0)
                ufn_record_binop(dst, zero, 2, inner.reg)
            }
            return ExprParse { ok: 1, reg: dst, next: inner.next}
        }
    }
    if k == TK_STAR && token_kind(pos + 1) == TK_IDENT {
        let reg = lookup_local_tok(ctx, pos + 1)
        if reg >= 0 && lookup_local_is_ref_tok(ctx, pos + 1) != 0 {
            let dst = alloc_reg(ctx)
            ufn_record_load_ref_field(dst, reg, 0)
            return ExprParse { ok: 1, reg: dst, next: pos + 2}
        }
    }
    if k == TK_AMPBANG && token_kind(pos + 1) == TK_IDENT {
        let bss_ref_idx = lookup_local_bss_idx_tok(ctx, pos + 1)
        if bss_ref_idx >= 0 {
            let dst = alloc_reg(ctx)
            ufn_record_user_global_base(dst, bss_ref_idx)
            return ExprParse { ok: 1, reg: dst, next: pos + 2}
        }
        let base_reg = lookup_local_tok(ctx, pos + 1)
        if base_reg >= 0 {
            let dst = alloc_reg(ctx)
            ufn_record_temp_addr(dst, base_reg)
            return ExprParse { ok: 1, reg: dst, next: pos + 2}
        }
        return ExprParse { ok: 0, reg: -1, next: pos}
    }
    // Immutable reference &ident (treated identically to &! for codegen purposes).
    if k == TK_AMP && token_kind(pos + 1) == TK_IDENT {
        let bss_ro_ref_idx = lookup_local_bss_idx_tok(ctx, pos + 1)
        if bss_ro_ref_idx >= 0 {
            let dst = alloc_reg(ctx)
            ufn_record_user_global_base(dst, bss_ro_ref_idx)
            return ExprParse { ok: 1, reg: dst, next: pos + 2}
        }
        let base_reg = lookup_local_tok(ctx, pos + 1)
        if base_reg >= 0 {
            let dst = alloc_reg(ctx)
            ufn_record_temp_addr(dst, base_reg)
            return ExprParse { ok: 1, reg: dst, next: pos + 2}
        }
    }
    if k == TK_LPAREN {
        if token_kind(pos + 1) == TK_STAR && token_kind(pos + 2) == TK_IDENT && token_kind(pos + 3) == TK_RPAREN && token_kind(pos + 4) == TK_DOT && token_kind(pos + 5) == TK_IDENT {
            let base_ref = lookup_local_tok(ctx, pos + 2)
            if base_ref >= 0 && lookup_local_is_ref_tok(ctx, pos + 2) != 0 {
                let sidx = lookup_local_struct_idx_tok(ctx, pos + 2)
                if sidx >= 0 {
                    let foff = struct_field_offset_tok(sidx, pos + 5)
                    if foff >= 0 {
                        let dst = alloc_reg(ctx)
                        ufn_record_load_ref_field(dst, base_ref, foff)
                        let next_sidx = struct_field_type_at(sidx, foff)
                        V2_LAST_STRUCT_IDX = next_sidx
                        return ExprParse { ok: 1, reg: dst, next: pos + 6}
                    }
                }
            }
        }
        let inner = parse_expr_ir(func, ctx, pos + 1)
        if inner.ok != 0 {
            var close_pos = inner.next
            if token_kind(close_pos) == TK_AS {
                close_pos = close_pos + 2
            }
            if token_kind(close_pos) == TK_RPAREN {
                return ExprParse { ok: 1, reg: inner.reg, next: close_pos + 1}
            }
        }
        return ExprParse { ok: 0, reg: -1, next: pos}
    }
    if k == TK_INT {
        if token_kind(pos + 1) == TK_DOT && token_kind(pos + 2) == TK_INT {
            let r = alloc_reg(ctx)
            let frac_digits = token_decimal_digit_count(pos + 2)
            var scale: i64 = decimal_scale_for_digits(frac_digits)
            var mantissa: i64 = (pt_read_int_value(pos) * scale) + pt_read_int_value(pos + 2)
            var next_pos: i64 = pos + 3
            // Optional sci-notation exponent. driver_lex_source_to_globals splits
            // `1.0e10` into INT DOT INT IDENT(e10) and `1.0e-10` into
            // INT DOT INT IDENT(e) MINUS INT. Inline detection (not a helper
            // call) keeps the driver's user fn count below the PT_END/fn-name
            // corruption threshold tracked in issue #71.
            if token_kind(next_pos) == TK_IDENT {
                let exp_start = pt_read_start(next_pos)
                let exp_end = pt_read_end(next_pos)
                if exp_end > exp_start {
                    let first_ch = CURSOR_SOURCE[exp_start as usize]
                    if first_ch == 101 as i8 || first_ch == 69 as i8 {
                        // Walk remaining chars: must be all digits to qualify.
                        var ei: i64 = exp_start + 1
                        var all_digits: i64 = 1
                        var inline_value: i64 = 0
                        while ei < exp_end {
                            let ch = CURSOR_SOURCE[ei as usize]
                            if ch >= 48 as i8 && ch <= 57 as i8 {
                                inline_value = inline_value * 10 + ((ch as i64) - 48)
                                ei = ei + 1
                            } else {
                                all_digits = 0
                                ei = exp_end
                            }
                        }
                        if all_digits != 0 {
                            let inline_digits = exp_end - exp_start - 1
                            if inline_digits > 0 {
                                // `eN` form: positive exponent encoded inline.
                                var pi: i64 = 0
                                while pi < inline_value { mantissa = mantissa * 10; pi = pi + 1 }
                                next_pos = next_pos + 1
                            } else {
                                // bare `e`/`E` followed by [+/-] INT.
                                let sign_tok = next_pos + 1
                                let digits_tok = next_pos + 2
                                if token_kind(sign_tok) == TK_MINUS && token_kind(digits_tok) == TK_INT {
                                    let neg_val = pt_read_int_value(digits_tok)
                                    var pi: i64 = 0
                                    while pi < neg_val { scale = scale * 10; pi = pi + 1 }
                                    next_pos = digits_tok + 1
                                } else if token_kind(sign_tok) == TK_PLUS && token_kind(digits_tok) == TK_INT {
                                    let pos_val = pt_read_int_value(digits_tok)
                                    var pi: i64 = 0
                                    while pi < pos_val { mantissa = mantissa * 10; pi = pi + 1 }
                                    next_pos = digits_tok + 1
                                } else if token_kind(sign_tok) == TK_INT {
                                    let plain_val = pt_read_int_value(sign_tok)
                                    var pi: i64 = 0
                                    while pi < plain_val { mantissa = mantissa * 10; pi = pi + 1 }
                                    next_pos = sign_tok + 1
                                }
                            }
                        }
                    }
                }
            }
            ufn_record_load_f64_scaled(r, mantissa, scale)
            return ExprParse { ok: 1, reg: r, next: next_pos }
        }
        let r = alloc_reg(ctx)
        ufn_record_load_imm(r, pt_read_int_value(pos))
        return ExprParse { ok: 1, reg: r, next: pos + 1}
    }
    if k == TK_FLOAT {
        let r = alloc_reg(ctx)
        ufn_record_load_f64_scaled(r, token_float_mantissa(pos), token_float_scale(pos))
        return ExprParse { ok: 1, reg: r, next: pos + 1}
    }
    if k == TK_TRUE {
        let r = alloc_reg(ctx)
        ufn_record_load_imm(r, 1)
        return ExprParse { ok: 1, reg: r, next: pos + 1}
    }
    if k == TK_FALSE {
        let r = alloc_reg(ctx)
        ufn_record_load_imm(r, 0)
        return ExprParse { ok: 1, reg: r, next: pos + 1}
    }
    if k == TK_STRING {
        let r = alloc_reg(ctx)
        ufn_record_load_string(r, pos)
        return ExprParse { ok: 1, reg: r, next: pos + 1}
    }
    if k == TK_IDENT {
        let cval = driver_const_value_tok(pos)
        if cval != -999999999 {
            let r = alloc_reg(ctx)
            ufn_record_load_imm(r, cval)
            return ExprParse { ok: 1, reg: r, next: pos + 1}
        }
        let gid = driver_global_id_tok(pos)
        if gid >= 0 && token_kind(pos + 1) == TK_LBRACKET {
            let idx_expr = parse_expr_ir(func, ctx, pos + 2)
            if idx_expr.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
            let end_pos = skip_index_cast_end(idx_expr.next)
            if token_kind(end_pos) != TK_RBRACKET { return ExprParse { ok: 0, reg: -1, next: pos} }
            let dst = alloc_reg(ctx)
            ufn_record_global_load(dst, gid, idx_expr.reg)
            return ExprParse { ok: 1, reg: dst, next: end_pos + 1}
        }
        // M1.2 step D — user-declared top-level global array read: `NAME[expr]`.
        // Placed after driver_global_id_tok so driver-internal names continue
        // to resolve through the existing hard-coded path when the driver
        // self-compiles.
        let ugid = user_global_id_tok(pos)
        if ugid >= 0 && token_kind(pos + 1) == TK_LBRACKET {
            let idx_expr = parse_expr_ir(func, ctx, pos + 2)
            if idx_expr.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
            let end_pos = skip_index_cast_end(idx_expr.next)
            if token_kind(end_pos) != TK_RBRACKET { return ExprParse { ok: 0, reg: -1, next: pos} }
            let dst = alloc_reg(ctx)
            ufn_record_user_global_load(dst, ugid, idx_expr.reg)
            if USER_GLOBAL_IS_F64[ugid as usize] != 0 { mark_reg_f64(dst) }
            return ExprParse { ok: 1, reg: dst, next: end_pos + 1}
        }
        if gid >= 0 {
            let sidx = find_struct_idx_tok(pos)
            if sidx >= 0 {
                let flat_size = STRUCT_FLAT_SIZE[sidx as usize]
                let base = alloc_reg(ctx)
                var bi: i64 = 1
                while bi < flat_size { let _ = alloc_reg(ctx); bi = bi + 1 }
                let idx_reg = alloc_reg(ctx)
                var ci: i64 = 0
                while ci < flat_size {
                    ufn_record_load_imm(idx_reg, ci)
                    ufn_record_global_load(base + ci, gid, idx_reg)
                    ci = ci + 1
                }
                mark_struct_regs(base, sidx)
                V2_LAST_STRUCT_IDX = sidx
                return ExprParse { ok: 1, reg: base, next: pos + 1}
            }
            let zero = alloc_reg(ctx)
            let dst = alloc_reg(ctx)
            ufn_record_load_imm(zero, 0)
            ufn_record_global_load(dst, gid, zero)
            return ExprParse { ok: 1, reg: dst, next: pos + 1}
        }
        // enum variant: EnumName::Variant → load discriminant
        if token_kind(pos + 1) == TK_COLONCOLON && token_kind(pos + 2) == TK_IDENT {
            let eidx = find_enum_idx_tok(pos)
            if eidx >= 0 {
                let variant_val = find_enum_variant_value(eidx, pos + 2)
                if variant_val >= 0 {
                    let r = alloc_reg(ctx)
                    ufn_record_load_imm(r, variant_val)
                    return ExprParse { ok: 1, reg: r, next: pos + 3}
                }
            }
        }
        // Call-shaped identifiers should enter call parsing before the bare
        // function-reference path below.
        if token_kind(pos + 1) == TK_LPAREN {
            return parse_fn_call_ir(func, ctx, pos)
        }
        let bare_fn_id = lookup_user_fn_id_tok(pos)
        if bare_fn_id >= 0 && token_kind(pos + 1) != TK_LPAREN && token_kind(pos + 1) != TK_COLONCOLON {
            let dst_fn = alloc_reg(ctx)
            ufn_record_load_imm(dst_fn, bare_fn_id)
            mark_reg_fnref(dst_fn)
            return ExprParse { ok: 1, reg: dst_fn, next: pos + 1}
        }
        if token_kind(pos + 1) == TK_COLONCOLON {
            mark_parse_unsupported_pathsep(pos + 1)
            return ExprParse { ok: 0, reg: -1, next: pos}
        }
        let reg = lookup_local_tok(ctx, pos)
        if reg >= 0 {
            if reg_is_fnref(reg) && token_kind(pos + 1) == TK_LPAREN {
                return parse_fn_call_ir(func, ctx, pos)
            }
            if lookup_local_is_ref_tok(ctx, pos) != 0 {
                // M1.2: ref-local postfix — `r.field` and `r.field[idx]`
                let ref_sidx = lookup_local_struct_idx_tok(ctx, pos)
                if ref_sidx >= 0 && token_kind(pos + 1) == TK_DOT && token_kind(pos + 2) == TK_IDENT {
                    let foff = struct_field_offset_tok(ref_sidx, pos + 2)
                    if foff >= 0 {
                        let field_sidx = struct_field_type_at(ref_sidx, foff)
                        // ref.field[idx] — array element load through struct reference
                        // The struct reference holds the address of field[0]; field 'data'
                        // at flat offset foff has element i at address (ptr - foff*8 - i*8).
                        // Emit: combined = foff + idx, then REF_ARRAY_LOAD(dst, ptr, combined).
                        if token_kind(pos + 3) == TK_LBRACKET {
                            let idx_expr = parse_expr_ir(func, ctx, pos + 4)
                            if idx_expr.ok != 0 {
                                let end_pos = skip_index_cast_end(idx_expr.next)
                                if token_kind(end_pos) == TK_RBRACKET {
                                    let dst = alloc_reg(ctx)
                                    if foff == 0 {
                                        ufn_record_ref_array_load(dst, reg, idx_expr.reg)
                                    } else {
                                        let foff_reg = alloc_reg(ctx)
                                        let combined_reg = alloc_reg(ctx)
                                        ufn_record_load_imm(foff_reg, foff)
                                        ufn_record_binop(combined_reg, idx_expr.reg, 0, foff_reg)
                                        ufn_record_ref_array_load(dst, reg, combined_reg)
                                    }
                                    if struct_field_is_f64_at(ref_sidx, foff) { mark_reg_f64(dst) }
                                    return ExprParse { ok: 1, reg: dst, next: end_pos + 1}
                                }
                            }
                        }
                        let dst = alloc_reg(ctx)
                        ufn_record_load_ref_field(dst, reg, foff)
                        if struct_field_is_f64_at(ref_sidx, foff) { mark_reg_f64(dst) }
                        V2_LAST_STRUCT_IDX = field_sidx
                        return ExprParse { ok: 1, reg: dst, next: pos + 3}
                    }
                }
                // ref-array indexed load: ref[idx] → UFN_REF_ARRAY_LOAD
                if token_kind(pos + 1) == TK_LBRACKET {
                    let idx_expr = parse_expr_ir(func, ctx, pos + 2)
                    if idx_expr.ok != 0 {
                        let end_pos = skip_index_cast_end(idx_expr.next)
                        if token_kind(end_pos) == TK_RBRACKET {
                            let dst = alloc_reg(ctx)
                            ufn_record_ref_array_load(dst, reg, idx_expr.reg)
                            if reg_is_f64(reg) { mark_reg_f64(dst) }
                            return ExprParse { ok: 1, reg: dst, next: end_pos + 1}
                        }
                    }
                }
                return ExprParse { ok: 1, reg: reg, next: pos + 1}
            }
            // arr.len() or str.len() — static array length or runtime str_len
            if token_kind(pos + 1) == TK_DOT && token_kind(pos + 2) == TK_IDENT && token_text_eq(pos + 2, "len") && token_kind(pos + 3) == TK_LPAREN && token_kind(pos + 4) == TK_RPAREN {
                let alen = lookup_local_alen_tok(ctx, pos)
                if alen > 0 {
                    let r = alloc_reg(ctx)
                    ufn_record_load_imm(r, alen)
                    return ExprParse { ok: 1, reg: r, next: pos + 5}
                }
                // fall back to runtime str_len for string locals
                let dst = alloc_reg(ctx)
                ufn_record_call(dst, V2_BUILTIN_STR_LEN, reg, 1)
                return ExprParse { ok: 1, reg: dst, next: pos + 5}
            }
            // local array read: ident[expr] or ident[expr as T]
            if token_kind(pos + 1) == TK_LBRACKET {
                let idx_expr = parse_expr_ir(func, ctx, pos + 2)
                if idx_expr.ok != 0 {
                    let end_pos = skip_index_cast_end(idx_expr.next)
                    if token_kind(end_pos) == TK_RBRACKET {
                        let dst = alloc_reg(ctx)
                        let bss_rd_idx = lookup_local_bss_idx_tok(ctx, pos)
                        if bss_rd_idx >= 0 {
                            ufn_record_user_global_load(dst, bss_rd_idx, idx_expr.reg)
                            if USER_GLOBAL_IS_F64[bss_rd_idx as usize] != 0 { mark_reg_f64(dst) }
                        } else {
                            ufn_record_local_load(dst, reg, idx_expr.reg)
                            if reg_is_f64(reg) { mark_reg_f64(dst) }
                        }
                        return ExprParse { ok: 1, reg: dst, next: end_pos + 1}
                    }
                }
            }
            let sidx = lookup_local_struct_idx_tok(ctx, pos)
            if sidx >= 0 {
                V2_LAST_STRUCT_IDX = sidx
                // Method call: self.method_name(args...) — dispatch before field access
                if token_kind(pos + 1) == TK_DOT && token_kind(pos + 2) == TK_IDENT && token_kind(pos + 3) == TK_LPAREN {
                    // Knowledge.unwrap("reason") → returns value field (reg+0)
                    if token_text_eq(pos + 2, "unwrap") {
                        let k_sidx = find_knowledge_struct_idx()
                        if sidx == k_sidx {
                            // skip past closing ')' of unwrap call
                            var skip_pos = pos + 4
                            var depth_u: i64 = 1
                            while skip_pos < V2_TOKEN_COUNT && depth_u > 0 {
                                let sk = token_kind(skip_pos)
                                if sk == TK_LPAREN { depth_u = depth_u + 1 }
                                else if sk == TK_RPAREN { depth_u = depth_u - 1 }
                                skip_pos = skip_pos + 1
                            }
                            mark_reg_f64(reg)
                            return ExprParse { ok: 1, reg: reg, next: skip_pos}
                        }
                    }
                    let method_res = parse_method_call_ir(func, ctx, pos + 2, reg, sidx)
                    if method_res.ok != 0 { return method_res }
                }
                // chain dot access: p.x, p.y.z, etc.
                if token_kind(pos + 1) == TK_DOT && token_kind(pos + 2) == TK_IDENT {
                    var cur_reg = reg
                    var cur_sidx = sidx
                    var cur = pos + 1
                    while cur + 1 < V2_TOKEN_COUNT && token_kind(cur) == TK_DOT && token_kind(cur + 1) == TK_IDENT {
                        let foff = struct_field_offset_tok(cur_sidx, cur + 1)
                        if foff < 0 { break }
                        cur_reg = cur_reg + foff
                        let next_sidx = struct_field_type_at(cur_sidx, foff)
                        if next_sidx >= 0 && struct_field_generic_f64_at(cur_sidx, foff) {
                            mark_struct_scalar_regs_f64(cur_reg, next_sidx)
                        }
                        if next_sidx < 0 && struct_field_is_f64_at(cur_sidx, foff) {
                            mark_reg_f64(cur_reg)
                        }
                        cur = cur + 2
                        if next_sidx < 0 { V2_LAST_STRUCT_IDX = -1; break }
                        cur_sidx = next_sidx
                        V2_LAST_STRUCT_IDX = next_sidx
                    }
                    // struct field array read: local.field[expr]
                    if token_kind(cur) == TK_LBRACKET {
                        let idx_expr = parse_expr_ir(func, ctx, cur + 1)
                        if idx_expr.ok != 0 {
                            let end_pos = skip_index_cast_end(idx_expr.next)
                            if token_kind(end_pos) == TK_RBRACKET {
                                let dst = alloc_reg(ctx)
                                ufn_record_local_load(dst, cur_reg, idx_expr.reg)
                                return ExprParse { ok: 1, reg: dst, next: end_pos + 1}
                            }
                        }
                    }
                    return ExprParse { ok: 1, reg: cur_reg, next: cur}
                }
            }
            return ExprParse { ok: 1, reg: reg, next: pos + 1}
        }
        // struct literal
        if token_kind(pos + 1) == TK_LBRACE {
            let lit = parse_struct_lit_ir(func, ctx, pos, V2_TOKEN_COUNT)
            if lit.ok != 0 { return lit }
        }
        if token_kind(pos + 1) == TK_LT && token_kind(pos + 2) == TK_IDENT && token_kind(pos + 3) == TK_GT && token_kind(pos + 4) == TK_LBRACE {
            let lit = parse_struct_lit_ir(func, ctx, pos, V2_TOKEN_COUNT)
            if lit.ok != 0 { return lit }
        }
    }
    if k == TK_LBRACKET {
        return parse_array_lit_ir(func, ctx, pos)
    }
    return ExprParse { ok: 0, reg: -1, next: pos}
}

fn parse_struct_lit_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64, token_count: i64) -> ExprParse with Mut, Panic, Div, Alloc {
    let sidx = find_struct_idx_tok(pos)
    if sidx < 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
    var brace_pos = pos + 1
    var generic_f64: i64 = 0
    if token_kind(pos + 1) == TK_LT && token_kind(pos + 2) == TK_IDENT && token_kind(pos + 3) == TK_GT && token_kind(pos + 4) == TK_LBRACE {
        brace_pos = pos + 4
        if token_text_eq(pos + 2, "f64") {
            generic_f64 = 1
        }
    }
    if token_kind(brace_pos) != TK_LBRACE { return ExprParse { ok: 0, reg: -1, next: pos} }
    let flat_size = STRUCT_FLAT_SIZE[sidx as usize]
    let base_reg = V2_NEXT_REG
    V2_NEXT_REG = V2_NEXT_REG + flat_size
    var cur = brace_pos + 1
    while cur < token_count {
        let kk = token_kind(cur)
        if kk == TK_NEWLINE || kk == TK_SEMI || kk == TK_COMMA { cur = cur + 1; continue }
        if kk == TK_RBRACE { break }
        if kk != TK_IDENT { break }
        let field_tok = cur
        let foff = struct_field_offset_tok(sidx, field_tok)
        cur = cur + 1
        if cur < token_count && token_kind(cur) == TK_COLON { cur = cur + 1 }
        V2_LAST_STRUCT_IDX = -1
        let val = parse_expr_ir(func, ctx, cur)
        if val.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
        if foff >= 0 {
            let val_sidx = V2_LAST_STRUCT_IDX
            if val_sidx >= 0 {
                let inner_flat = STRUCT_FLAT_SIZE[val_sidx as usize]
                ufn_record_bulk_copy(base_reg + foff, val.reg, inner_flat)
            } else {
                // scalar or fixed array — use the field's actual flat size
                let fld_flat = struct_field_flat_size(sidx, foff)
                ufn_record_bulk_copy(base_reg + foff, val.reg, fld_flat)
            }
        }
        cur = val.next
        if cur < token_count && token_kind(cur) == TK_COMMA { cur = cur + 1 }
    }
    V2_LAST_STRUCT_IDX = sidx
    if generic_f64 != 0 {
        mark_struct_scalar_regs_f64(base_reg, sidx)
    } else {
        mark_struct_regs(base_reg, sidx)
    }
    return ExprParse { ok: 1, reg: base_reg, next: cur + 1}
}

fn parse_fn_call_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64) -> ExprParse with Mut, Panic, Div, Alloc {
    var fn_id = builtin_fn_id_tok(pos)
    if fn_id < 0 { fn_id = lookup_user_fn_id_tok(pos) }
    var indirect_fn_reg: i64 = -1
    var is_indirect_call: i64 = 0
    if fn_id < 0 {
        let local_reg = lookup_local_tok(ctx, pos)
        if local_reg >= 0 && reg_is_fnref(local_reg) {
            indirect_fn_reg = local_reg
            is_indirect_call = 1
        } else {
            mark_parse_unsupported_call(pos)
            return ExprParse { ok: 0, reg: -1, next: pos}
        }
    }
    if token_kind(pos + 1) != TK_LPAREN { return ExprParse { ok: 0, reg: -1, next: pos} }
    // GPU thread/block intrinsics: zero-arg, parse-time expand to load_imm 0.
    // Kernel fn body becomes dead-but-valid CPU code; runtime skips on no-GPU hosts.
    if is_indirect_call == 0 && fn_id == V2_BUILTIN_GPU_INTRINSIC && token_kind(pos + 2) == TK_RPAREN {
        let stub_reg = alloc_reg(ctx)
        ufn_record_load_imm(stub_reg, 0)
        return ExprParse { ok: 1, reg: stub_reg, next: pos + 3}
    }
    if is_indirect_call == 0 && fn_id == V2_BUILTIN_EMPTY_NAME && token_kind(pos + 2) == TK_RPAREN {
        let sidx = find_name_struct_idx()
        if sidx >= 0 {
            let flat_size = STRUCT_FLAT_SIZE[sidx as usize]
            let base = V2_NEXT_REG
            V2_NEXT_REG = base + flat_size
            let zero = alloc_reg(ctx)
            ufn_record_load_imm(zero, 0)
            ufn_record_array_fill(base, zero, flat_size)
            V2_LAST_STRUCT_IDX = sidx
            return ExprParse { ok: 1, reg: base, next: pos + 3}
        }
        return ExprParse { ok: 0, reg: -1, next: pos}
    }
    // M1.2 step 2 (redo): `println` is not a standalone builtin in codegen —
    // it expands at parse time into a typed print call plus a trailing
    // print_char(10). Dispatch is based on the argument's runtime type:
    //   - f64 register (via reg_is_f64) → print_f64 + '\n'
    //   - TK_STRING leading token → print + '\n'
    //   - otherwise → print_int + '\n'
    // Zero-arg form `println()` just emits a newline. Mirrors lean_single's
    // println lowering where the type of the single argument decides between
    // print_cstr, print_int, and print_f64 followed by a linefeed.
    // print(expr): JIT dispatches on arg type — string→print, int→print_int, f64→print_f64.
    // Match lean_single behaviour exactly so outputs agree. print(0) → print_int(0) = "0\n".
    if is_indirect_call == 0 && fn_id == V2_BUILTIN_PRINT {
        if token_kind(pos + 2) == TK_RPAREN {
            return ExprParse { ok: 1, reg: alloc_reg(ctx), next: pos + 3}
        }
        let print_arg_kind = token_kind(pos + 2)
        V2_LAST_STRUCT_IDX = -1
        let print_arg = parse_expr_ir(func, ctx, pos + 2)
        if print_arg.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
        if token_kind(print_arg.next) != TK_RPAREN { return ExprParse { ok: 0, reg: -1, next: pos} }
        var print_fn_id = V2_BUILTIN_PRINT_INT
        if reg_is_f64(print_arg.reg) {
            print_fn_id = V2_BUILTIN_PRINT_F64
        } else if print_arg_kind == TK_STRING {
            print_fn_id = V2_BUILTIN_PRINT
        }
        let print_dst = alloc_reg(ctx)
        ufn_record_call(print_dst, print_fn_id, print_arg.reg, 1)
        // lean_single print_int bakes '\n'; print_f64 does NOT. For string print, no '\n'.
        if print_fn_id == V2_BUILTIN_PRINT_INT {
            let nl_r = alloc_reg(ctx)
            let nl_d = alloc_reg(ctx)
            ufn_record_load_imm(nl_r, 10)
            ufn_record_call(nl_d, V2_BUILTIN_PRINT_CHAR, nl_r, 1)
            return ExprParse { ok: 1, reg: nl_d, next: print_arg.next + 1}
        }
        return ExprParse { ok: 1, reg: print_dst, next: print_arg.next + 1}
    }
    if is_indirect_call == 0 && fn_id == V2_BUILTIN_PRINTLN {
        // Zero-arg: println() → just a newline.
        if token_kind(pos + 2) == TK_RPAREN {
            let nl_reg = alloc_reg(ctx)
            let nl_dst = alloc_reg(ctx)
            ufn_record_load_imm(nl_reg, 10)
            ufn_record_call(nl_dst, V2_BUILTIN_PRINT_CHAR, nl_reg, 1)
            return ExprParse { ok: 1, reg: nl_dst, next: pos + 3}
        }
        // Single-arg: inspect the leading arg token for the cstring heuristic
        // BEFORE parsing (parse_expr_ir consumes the token and reg-type tracking
        // doesn't distinguish cstring pointers from ints).
        let arg_start_kind = token_kind(pos + 2)
        V2_LAST_STRUCT_IDX = -1
        let arg = parse_expr_ir(func, ctx, pos + 2)
        if arg.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
        if token_kind(arg.next) != TK_RPAREN { return ExprParse { ok: 0, reg: -1, next: pos} }
        var inner_fn_id = V2_BUILTIN_PRINT_INT
        if reg_is_f64(arg.reg) {
            inner_fn_id = V2_BUILTIN_PRINT_F64
        } else if arg_start_kind == TK_STRING {
            inner_fn_id = V2_BUILTIN_PRINT
        }
        let inner_dst = alloc_reg(ctx)
        ufn_record_call(inner_dst, inner_fn_id, arg.reg, 1)
        // lean_single's emit_print_int bakes '\n' into its buffer and
        // println(string) also adds '\n'. But println(f64) in lean_single
        // calls emit_print_f64 with no trailing newline — match that.
        if inner_fn_id != V2_BUILTIN_PRINT_F64 {
            let nl_reg = alloc_reg(ctx)
            let nl_dst = alloc_reg(ctx)
            ufn_record_load_imm(nl_reg, 10)
            ufn_record_call(nl_dst, V2_BUILTIN_PRINT_CHAR, nl_reg, 1)
            return ExprParse { ok: 1, reg: nl_dst, next: arg.next + 1}
        }
        return ExprParse { ok: 1, reg: inner_dst, next: arg.next + 1}
    }
    // assert(cond): inline expansion — branch around a sys_exit(1) call.
    // Semantics: if cond == 0 → exit(1); else → continue.
    // measure(v, uncertainty: u) → Knowledge<f64>{value=v, uncertainty=u}
    // Pre-allocates 2 contiguous f64 registers, then parses positional value
    // and optional named `uncertainty:` argument, copying each into place.
    if is_indirect_call == 0 && fn_id == V2_BUILTIN_MEASURE {
        let k_sidx = find_knowledge_struct_idx()
        // Pre-allocate 2 registers for the Knowledge struct
        let base_reg = V2_NEXT_REG
        V2_NEXT_REG = base_reg + 2
        mark_reg_f64(base_reg)
        mark_reg_f64(base_reg + 1)
        var mc = pos + 2  // skip 'measure' and '('
        // parse value argument
        var val_done: i64 = 0
        if token_kind(mc) != TK_RPAREN {
            let vp = parse_expr_ir(func, ctx, mc)
            if vp.ok != 0 {
                ufn_record_copy(base_reg, vp.reg)
                mc = vp.next
                val_done = 1
            }
        }
        if val_done == 0 {
            let zero_reg = alloc_reg(ctx)
            ufn_record_load_imm(zero_reg, 0)
            ufn_record_copy(base_reg, zero_reg)
        }
        // skip optional comma
        if token_kind(mc) == TK_COMMA { mc = mc + 1 }
        // parse optional named 'uncertainty: u'
        var unc_done: i64 = 0
        if token_kind(mc) == TK_IDENT && token_text_eq(mc, "uncertainty") && token_kind(mc + 1) == TK_COLON {
            mc = mc + 2  // skip 'uncertainty:'
            let up = parse_expr_ir(func, ctx, mc)
            if up.ok != 0 {
                ufn_record_copy(base_reg + 1, up.reg)
                mc = up.next
                unc_done = 1
            }
        } else if token_kind(mc) != TK_RPAREN {
            // positional uncertainty (second arg without label)
            let up = parse_expr_ir(func, ctx, mc)
            if up.ok != 0 {
                ufn_record_copy(base_reg + 1, up.reg)
                mc = up.next
                unc_done = 1
            }
        }
        if unc_done == 0 {
            let zero_reg2 = alloc_reg(ctx)
            ufn_record_load_imm(zero_reg2, 0)
            ufn_record_copy(base_reg + 1, zero_reg2)
        }
        // skip closing ')'
        if token_kind(mc) == TK_RPAREN { mc = mc + 1 }
        if k_sidx >= 0 { V2_LAST_STRUCT_IDX = k_sidx }
        return ExprParse { ok: 1, reg: base_reg, next: mc}
    }
    if is_indirect_call == 0 && fn_id == V2_BUILTIN_ASSERT {
        if token_kind(pos + 2) == TK_RPAREN { return ExprParse { ok: 0, reg: -1, next: pos} }
        let cond = parse_expr_ir(func, ctx, pos + 2)
        if cond.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
        if token_kind(cond.next) != TK_RPAREN { return ExprParse { ok: 0, reg: -1, next: pos} }
        let zero = alloc_reg(ctx)
        ufn_record_load_imm(zero, 0)
        let eq_zero = alloc_reg(ctx)
        ufn_record_binop(eq_zero, cond.reg, 5, zero)
        let label_ok = alloc_label()
        ufn_record_branch_false(eq_zero, label_ok)
        let fail_dst = alloc_reg(ctx)
        ufn_record_call(fail_dst, V2_BUILTIN_SYS_EXIT_1, 0, 0)
        ufn_record_label(label_ok)
        return ExprParse { ok: 1, reg: fail_dst, next: cond.next + 1}
    }
    var n_args: i64 = 0
    var total_argc: i64 = 0
    var cur = pos + 2
    while token_kind(cur) != TK_RPAREN && cur < V2_TOKEN_COUNT && n_args < 8 {
        if n_args > 0 {
            if token_kind(cur) == TK_COMMA { cur = cur + 1 }
            else { return ExprParse { ok: 0, reg: -1, next: pos} }
        }
        let saved_arg0 = V2_CALL_ARG_REGS[0]
        let saved_arg1 = V2_CALL_ARG_REGS[1]
        let saved_arg2 = V2_CALL_ARG_REGS[2]
        let saved_arg3 = V2_CALL_ARG_REGS[3]
        let saved_arg4 = V2_CALL_ARG_REGS[4]
        let saved_arg5 = V2_CALL_ARG_REGS[5]
        let saved_arg6 = V2_CALL_ARG_REGS[6]
        let saved_arg7 = V2_CALL_ARG_REGS[7]
        let saved_size0 = V2_CALL_ARG_SIZES[0]
        let saved_size1 = V2_CALL_ARG_SIZES[1]
        let saved_size2 = V2_CALL_ARG_SIZES[2]
        let saved_size3 = V2_CALL_ARG_SIZES[3]
        let saved_size4 = V2_CALL_ARG_SIZES[4]
        let saved_size5 = V2_CALL_ARG_SIZES[5]
        let saved_size6 = V2_CALL_ARG_SIZES[6]
        let saved_size7 = V2_CALL_ARG_SIZES[7]
        V2_LAST_STRUCT_IDX = -1
        let arg = parse_expr_ir(func, ctx, cur)
        let arg_struct_idx = V2_LAST_STRUCT_IDX
        V2_CALL_ARG_REGS[0] = saved_arg0
        V2_CALL_ARG_REGS[1] = saved_arg1
        V2_CALL_ARG_REGS[2] = saved_arg2
        V2_CALL_ARG_REGS[3] = saved_arg3
        V2_CALL_ARG_REGS[4] = saved_arg4
        V2_CALL_ARG_REGS[5] = saved_arg5
        V2_CALL_ARG_REGS[6] = saved_arg6
        V2_CALL_ARG_REGS[7] = saved_arg7
        V2_CALL_ARG_SIZES[0] = saved_size0
        V2_CALL_ARG_SIZES[1] = saved_size1
        V2_CALL_ARG_SIZES[2] = saved_size2
        V2_CALL_ARG_SIZES[3] = saved_size3
        V2_CALL_ARG_SIZES[4] = saved_size4
        V2_CALL_ARG_SIZES[5] = saved_size5
        V2_CALL_ARG_SIZES[6] = saved_size6
        V2_CALL_ARG_SIZES[7] = saved_size7
        V2_LAST_STRUCT_IDX = arg_struct_idx
        if arg.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
        var sz: i64 = 1
        if arg_struct_idx >= 0 {
            sz = STRUCT_FLAT_SIZE[arg_struct_idx as usize]
            V2_LAST_STRUCT_IDX = -1
            if sz > 6 {
                // Large struct: pass as pointer to first field (single register)
                let addr_vreg = alloc_reg(ctx)
                ufn_record_temp_addr(addr_vreg, arg.reg)
                V2_CALL_ARG_REGS[n_args as usize] = addr_vreg
                sz = 1
            } else {
                V2_CALL_ARG_REGS[n_args as usize] = arg.reg
            }
        } else if lookup_local_alen_by_reg(ctx, arg.reg) > 0 {
            // bare local array: pass address-of first element (pointer)
            let addr_vreg = alloc_reg(ctx)
            ufn_record_temp_addr(addr_vreg, arg.reg)
            V2_CALL_ARG_REGS[n_args as usize] = addr_vreg
        } else {
            V2_CALL_ARG_REGS[n_args as usize] = arg.reg
        }
        V2_CALL_ARG_SIZES[n_args as usize] = sz
        total_argc = total_argc + sz
        n_args = n_args + 1
        cur = arg.next
    }
    if token_kind(cur) != TK_RPAREN { return ExprParse { ok: 0, reg: -1, next: pos} }
    // Determine arg0_reg: use first-arg reg if args are consecutive, else pack
    var arg0_reg: i64 = -1
    if total_argc > 0 {
        arg0_reg = V2_CALL_ARG_REGS[0]
        // Check if all args land in a single consecutive block from arg0_reg
        var consecutive: i64 = 1
        var expected: i64 = arg0_reg
        var ci: i64 = 0
        while ci < n_args {
            if V2_CALL_ARG_REGS[ci as usize] != expected { consecutive = 0 }
            expected = expected + V2_CALL_ARG_SIZES[ci as usize]
            ci = ci + 1
        }
        if consecutive == 0 {
            // Pack into a fresh consecutive block, emit copies
            let base = V2_NEXT_REG
            V2_NEXT_REG = V2_NEXT_REG + total_argc
            var slot: i64 = 0
            var ai: i64 = 0
            while ai < n_args {
                let from = V2_CALL_ARG_REGS[ai as usize]
                let sz = V2_CALL_ARG_SIZES[ai as usize]
                var fi: i64 = 0
                while fi < sz {
                    let dst_slot = base + slot + fi
                    let src_slot = from + fi
                    if dst_slot != src_slot { ufn_record_copy(dst_slot, src_slot) }
                    fi = fi + 1
                }
                slot = slot + sz
                ai = ai + 1
            }
            arg0_reg = base
        }
    }
    if is_indirect_call != 0 {
        let base_ind = V2_NEXT_REG
        V2_NEXT_REG = V2_NEXT_REG + total_argc + 1
        ufn_record_copy(base_ind, indirect_fn_reg)
        var slot_ind: i64 = 0
        var ai_ind: i64 = 0
        while ai_ind < n_args {
            let from_ind = V2_CALL_ARG_REGS[ai_ind as usize]
            let sz_ind = V2_CALL_ARG_SIZES[ai_ind as usize]
            var fi_ind: i64 = 0
            while fi_ind < sz_ind {
                let dst_ind_slot = base_ind + 1 + slot_ind + fi_ind
                let src_ind_slot = from_ind + fi_ind
                if dst_ind_slot != src_ind_slot { ufn_record_copy(dst_ind_slot, src_ind_slot) }
                fi_ind = fi_ind + 1
            }
            slot_ind = slot_ind + sz_ind
            ai_ind = ai_ind + 1
        }
        let dst_ind = alloc_reg(ctx)
        ufn_record_call(dst_ind, V2_BUILTIN_INDIRECT_CALL, base_ind, total_argc + 1)
        if reg_is_fnref_f64(indirect_fn_reg) { mark_reg_f64(dst_ind) }
        return ExprParse { ok: 1, reg: dst_ind, next: cur + 1}
    }
    let knowledge_guard_idx = lookup_user_fn_knowledge_guard_index(fn_id)
    let knowledge_guard_site = user_fn_knowledge_guard_site(knowledge_guard_idx)
    if knowledge_guard_idx >= 0 && knowledge_guard_site == 1 {
        ufn_emit_direct_knowledge_runtime_guard(ctx, knowledge_guard_idx, arg0_reg)
    }
    // check if callee returns a struct
    let ret_sidx = lookup_user_fn_return_struct_idx(fn_id)
    if ret_sidx >= 0 {
        let ret_flat = STRUCT_FLAT_SIZE[ret_sidx as usize]
        let dst = alloc_reg(ctx)
        var ri: i64 = 1
        while ri < ret_flat { let _ = alloc_reg(ctx); ri = ri + 1 }
        ufn_record_call_struct_result(dst, fn_id, arg0_reg, total_argc, ret_flat)
        if knowledge_guard_idx >= 0 && knowledge_guard_site == 2 {
            ufn_emit_direct_knowledge_runtime_guard(ctx, knowledge_guard_idx, dst)
        }
        V2_LAST_STRUCT_IDX = ret_sidx
        if lookup_user_fn_return_is_f64(fn_id) {
            mark_struct_scalar_regs_f64(dst, ret_sidx)
        } else {
            mark_struct_regs(dst, ret_sidx)
        }
        return ExprParse { ok: 1, reg: dst, next: cur + 1}
    }
    // check if callee returns [T; N] array
    let ret_arr_sz = lookup_user_fn_return_arr_size(fn_id)
    if ret_arr_sz > 0 {
        let dst = alloc_reg(ctx)
        var ri: i64 = 1
        while ri < ret_arr_sz { let _ = alloc_reg(ctx); ri = ri + 1 }
        ufn_record_call_struct_result(dst, fn_id, arg0_reg, total_argc, ret_arr_sz)
        V2_LAST_ARR_LEN = ret_arr_sz
        return ExprParse { ok: 1, reg: dst, next: cur + 1}
    }
    let dst = alloc_reg(ctx)
    ufn_record_call(dst, fn_id, arg0_reg, total_argc)
    if lookup_user_fn_return_is_f64(fn_id) || fn_id == V2_BUILTIN_SQRT_F64 || fn_id == V2_BUILTIN_BITS_TO_F64 {
        mark_reg_f64(dst)
    }
    if lookup_user_fn_return_is_fnref(fn_id) {
        mark_reg_fnref(dst)
    }
    return ExprParse { ok: 1, reg: dst, next: cur + 1}
}

// Method call dispatch: self.method_name(extra_args...) where self is a struct local.
// Called from parse_atom_ir when ident.method( is detected and ident has a struct type.
fn parse_method_call_ir(func: &! i64, ctx: &! V2DriverContext, method_tok: i64, self_reg: i64, self_sidx: i64) -> ExprParse with Mut, Panic, Div, Alloc {
    let fn_id = lookup_user_fn_id_tok(method_tok)
    if fn_id < 0 { return ExprParse { ok: 0, reg: -1, next: method_tok} }
    if token_kind(method_tok + 1) != TK_LPAREN { return ExprParse { ok: 0, reg: -1, next: method_tok} }
    let self_flat = STRUCT_FLAT_SIZE[self_sidx as usize]
    var n_args: i64 = 1
    var total_argc: i64 = self_flat
    V2_CALL_ARG_REGS[0] = self_reg
    V2_CALL_ARG_SIZES[0] = self_flat
    var cur = method_tok + 2
    while token_kind(cur) != TK_RPAREN && cur < V2_TOKEN_COUNT && n_args < 8 {
        if n_args > 1 {
            if token_kind(cur) == TK_COMMA { cur = cur + 1 }
            else { return ExprParse { ok: 0, reg: -1, next: method_tok} }
        }
        let marg = parse_expr_ir(func, ctx, cur)
        if marg.ok == 0 { return ExprParse { ok: 0, reg: -1, next: method_tok} }
        V2_CALL_ARG_REGS[n_args as usize] = marg.reg
        V2_CALL_ARG_SIZES[n_args as usize] = 1
        total_argc = total_argc + 1
        n_args = n_args + 1
        cur = marg.next
    }
    if token_kind(cur) != TK_RPAREN { return ExprParse { ok: 0, reg: -1, next: method_tok} }
    var arg0_reg = self_reg
    var consecutive: i64 = 1
    var expected: i64 = self_reg
    var ci: i64 = 0
    while ci < n_args {
        if V2_CALL_ARG_REGS[ci as usize] != expected { consecutive = 0 }
        expected = expected + V2_CALL_ARG_SIZES[ci as usize]
        ci = ci + 1
    }
    if consecutive == 0 {
        let base = V2_NEXT_REG
        V2_NEXT_REG = V2_NEXT_REG + total_argc
        var slot: i64 = 0
        var ai: i64 = 0
        while ai < n_args {
            let from = V2_CALL_ARG_REGS[ai as usize]
            let sz = V2_CALL_ARG_SIZES[ai as usize]
            var fi: i64 = 0
            while fi < sz {
                let ds = base + slot + fi
                let ss = from + fi
                if ds != ss { ufn_record_copy(ds, ss) }
                fi = fi + 1
            }
            slot = slot + sz
            ai = ai + 1
        }
        arg0_reg = base
    }
    let ret_sidx = lookup_user_fn_return_struct_idx(fn_id)
    if ret_sidx >= 0 {
        let ret_flat = STRUCT_FLAT_SIZE[ret_sidx as usize]
        let dst = alloc_reg(ctx)
        var ri: i64 = 1
        while ri < ret_flat { let _ = alloc_reg(ctx); ri = ri + 1 }
        ufn_record_call_struct_result(dst, fn_id, arg0_reg, total_argc, ret_flat)
        V2_LAST_STRUCT_IDX = ret_sidx
        return ExprParse { ok: 1, reg: dst, next: cur + 1}
    }
    // check if callee returns [T; N] array (method call variant)
    let ret_arr_sz2 = lookup_user_fn_return_arr_size(fn_id)
    if ret_arr_sz2 > 0 {
        let dst = alloc_reg(ctx)
        var ri: i64 = 1
        while ri < ret_arr_sz2 { let _ = alloc_reg(ctx); ri = ri + 1 }
        ufn_record_call_struct_result(dst, fn_id, arg0_reg, total_argc, ret_arr_sz2)
        V2_LAST_ARR_LEN = ret_arr_sz2
        return ExprParse { ok: 1, reg: dst, next: cur + 1}
    }
    let dst = alloc_reg(ctx)
    ufn_record_call(dst, fn_id, arg0_reg, total_argc)
    if lookup_user_fn_return_is_f64(fn_id) { mark_reg_f64(dst) }
    return ExprParse { ok: 1, reg: dst, next: cur + 1}
}

fn parse_term_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64) -> ExprParse with Mut, Panic, Div, Alloc {
    let left = parse_atom_ir(func, ctx, pos)
    if left.ok == 0 { return left }
    var result = left
    // Apply `as T` cast before the mul-op loop so that patterns like
    // `(expr) as f32 / divisor` work: the cast promotes the type then the
    // loop sees the `/` and handles it correctly.
    if token_kind(result.next) == TK_AS {
        let ct = result.next + 1
        let is_float = token_kind(ct) == TK_IDENT && (token_text_eq(ct, "f64") || token_text_eq(ct, "f32"))
        if is_float && !reg_is_f64(result.reg) {
            let conv = alloc_reg(ctx)
            ufn_record_cvt_i64_to_f64(conv, result.reg)
            result = ExprParse { ok: 1, reg: conv, next: result.next + 2}
        } else if reg_is_f64(result.reg) && token_kind(ct) == TK_IDENT && !is_float {
            let conv = alloc_reg(ctx)
            ufn_record_cvt_f64_to_i64(conv, result.reg)
            result = ExprParse { ok: 1, reg: conv, next: result.next + 2}
        } else {
            result = ExprParse { ok: 1, reg: result.reg, next: result.next + 2}
        }
    }
    // Postfix .method() chain on any expression result.
    // Handles: expr.sqrt(), expr.method(args) when V2_LAST_STRUCT_IDX is known.
    if token_kind(result.next) == TK_DOT && token_kind(result.next + 1) == TK_IDENT && token_kind(result.next + 2) == TK_LPAREN {
        if token_text_eq(result.next + 1, "sqrt") && token_kind(result.next + 3) == TK_RPAREN {
            let sqrt_dst = alloc_reg(ctx)
            mark_reg_f64(sqrt_dst)
            ufn_record_call(sqrt_dst, V2_BUILTIN_SQRT_F64, result.reg, 1)
            result = ExprParse { ok: 1, reg: sqrt_dst, next: result.next + 4}
        } else if V2_LAST_STRUCT_IDX >= 0 {
            let mres = parse_method_call_ir(func, ctx, result.next + 1, result.reg, V2_LAST_STRUCT_IDX)
            if mres.ok != 0 { result = mres }
        }
    }
    var op_kind = token_kind(result.next)
    while is_mul_op(op_kind) {
        let right = parse_atom_ir(func, ctx, result.next + 1)
        if right.ok == 0 { return ExprParse { ok: 0, reg: -1, next: result.next} }
        let dst = alloc_reg(ctx)
        if reg_is_f64(result.reg) || reg_is_f64(right.reg) {
            ufn_record_f64_binop(dst, result.reg, arith_op_to_code(op_kind), right.reg)
        } else {
            ufn_record_binop(dst, result.reg, arith_op_to_code(op_kind), right.reg)
        }
        result = ExprParse { ok: 1, reg: dst, next: right.next}
        op_kind = token_kind(result.next)
    }
    result
}

// Additive level: handles + and - on top of parse_term_ir.
// Separated from parse_expr_ir so that comparison RHS can use this level,
// making `x == 0 - 1` parse as `x == (0 - 1)` rather than `(x == 0) - 1`.
fn parse_additive_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64) -> ExprParse with Mut, Panic, Div, Alloc {
    let left = parse_term_ir(func, ctx, pos)
    if left.ok == 0 { return left }
    var result = left
    var op_kind = token_kind(result.next)
    while is_additive_op(op_kind) {
        let right = parse_term_ir(func, ctx, result.next + 1)
        if right.ok == 0 { return ExprParse { ok: 0, reg: -1, next: result.next} }
        let dst = alloc_reg(ctx)
        if reg_is_f64(result.reg) || reg_is_f64(right.reg) {
            ufn_record_f64_binop(dst, result.reg, arith_op_to_code(op_kind), right.reg)
        } else {
            ufn_record_binop(dst, result.reg, arith_op_to_code(op_kind), right.reg)
        }
        result = ExprParse { ok: 1, reg: dst, next: right.next}
        op_kind = token_kind(result.next)
    }
    result
}

fn parse_expr_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64) -> ExprParse with Mut, Panic, Div, Alloc {
    let left = parse_additive_ir(func, ctx, pos)
    if left.ok == 0 { return left }
    var result = left
    var op_kind = token_kind(result.next)
    if is_cmp_op(op_kind) {
        let right = parse_additive_ir(func, ctx, result.next + 1)
        if right.ok == 0 { return ExprParse { ok: 0, reg: -1, next: result.next} }
        if (op_kind == TK_EQEQ || op_kind == TK_BANGEQ) && token_kind(result.next + 1) == TK_STRING {
            let base = V2_NEXT_REG
            V2_NEXT_REG = base + 2
            ufn_record_copy(base, result.reg)
            ufn_record_copy(base + 1, right.reg)
            let eq_dst = alloc_reg(ctx)
            ufn_record_call(eq_dst, V2_BUILTIN_STR_EQ, base, 2)
            if op_kind == TK_BANGEQ {
                let zero = alloc_reg(ctx)
                let ne_dst = alloc_reg(ctx)
                ufn_record_load_imm(zero, 0)
                ufn_record_binop(ne_dst, eq_dst, 5, zero)
                return ExprParse { ok: 1, reg: ne_dst, next: right.next}
            }
            return ExprParse { ok: 1, reg: eq_dst, next: right.next}
        }
        let dst = alloc_reg(ctx)
        if reg_is_f64(result.reg) || reg_is_f64(right.reg) {
            ufn_record_f64_binop(dst, result.reg, cmp_op_to_code(op_kind), right.reg)
        } else {
            ufn_record_binop(dst, result.reg, cmp_op_to_code(op_kind), right.reg)
        }
        var rn = right.next
        if token_kind(rn) == TK_AS { rn = rn + 2 }
        result = ExprParse { ok: 1, reg: dst, next: rn}
    }
    // skip trailing 'as T'; emit conversion instructions for f64<->i64 casts
    if token_kind(result.next) == TK_AS {
        let cast_type_tok = result.next + 1
        let cast_is_float_type = token_kind(cast_type_tok) == TK_IDENT && (token_text_eq(cast_type_tok, "f64") || token_text_eq(cast_type_tok, "f32"))
        if cast_is_float_type && !reg_is_f64(result.reg) {
            // integer → float: cvtsi2sd (f32 treated as f64 in native backend)
            let conv_reg = alloc_reg(ctx)
            ufn_record_cvt_i64_to_f64(conv_reg, result.reg)
            result = ExprParse { ok: 1, reg: conv_reg, next: result.next + 2}
        } else if reg_is_f64(result.reg) && token_kind(cast_type_tok) == TK_IDENT && !cast_is_float_type {
            // float → integer: cvttsd2si (truncation)
            let conv_reg = alloc_reg(ctx)
            ufn_record_cvt_f64_to_i64(conv_reg, result.reg)
            result = ExprParse { ok: 1, reg: conv_reg, next: result.next + 2}
        } else {
            result = ExprParse { ok: 1, reg: result.reg, next: result.next + 2}
        }
    }
    // Short-circuit logical operators: && and ||
    let op2 = token_kind(result.next)
    if op2 == TK_ANDAND {
        let right2 = parse_expr_ir(func, ctx, result.next + 1)
        if right2.ok != 0 {
            let dst = alloc_reg(ctx)
            let label_short = alloc_label()
            let label_end = alloc_label()
            ufn_record_branch_false(result.reg, label_short)
            ufn_record_copy(dst, right2.reg)
            ufn_record_jump(label_end)
            ufn_record_label(label_short)
            ufn_record_load_imm(dst, 0)
            ufn_record_label(label_end)
            return ExprParse { ok: 1, reg: dst, next: right2.next}
        }
    }
    if op2 == TK_OROR {
        let right2 = parse_expr_ir(func, ctx, result.next + 1)
        if right2.ok != 0 {
            let dst = alloc_reg(ctx)
            let zero = alloc_reg(ctx)
            let eq_zero = alloc_reg(ctx)
            let one = alloc_reg(ctx)
            let label_true = alloc_label()
            let label_end = alloc_label()
            ufn_record_load_imm(zero, 0)
            ufn_record_binop(eq_zero, result.reg, 5, zero)
            ufn_record_branch_false(eq_zero, label_true)
            ufn_record_copy(dst, right2.reg)
            ufn_record_jump(label_end)
            ufn_record_label(label_true)
            ufn_record_load_imm(one, 1)
            ufn_record_copy(dst, one)
            ufn_record_label(label_end)
            return ExprParse { ok: 1, reg: dst, next: right2.next}
        }
    }
    let cast_next = skip_index_cast_end(result.next)
    if cast_next != result.next {
        return ExprParse { ok: 1, reg: result.reg, next: cast_next}
    }
    result
}

fn emit_label(func: &! i64, label_id: i64) with Mut {
    ufn_record_label(label_id)
}

fn emit_jump(func: &! i64, label_id: i64) with Mut {
    ufn_record_jump(label_id)
}

fn emit_branch_false(func: &! i64, cond_reg: i64, label_id: i64) with Mut {
    ufn_record_branch_false(cond_reg, label_id)
}

fn parse_while_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64, token_count: i64) -> i64 with IO, Mut, Panic, Div, Alloc {
    // while COND { BODY }
    // pos points to token AFTER 'while'
    let label_top = alloc_label()
    let label_end = alloc_label()
    emit_label(func, label_top)

    // parse condition expression
    let cond = parse_expr_ir(func, ctx, pos)
    if cond.ok == 0 { return pos }
    emit_branch_false(func, cond.reg, label_end)

    // find and parse body block
    var p = cond.next
    while p < token_count && token_kind(p) != TK_LBRACE { p = p + 1 }
    if p >= token_count { return pos }
    let body_end = find_matching_rbrace(p, token_count)
    if body_end < 0 { return pos }
    let old_break = V2_BREAK_LABEL
    let old_continue = V2_CONTINUE_LABEL
    V2_BREAK_LABEL = label_end
    V2_CONTINUE_LABEL = label_top
    parse_block_ir(func, ctx, p + 1, body_end, token_count)
    V2_BREAK_LABEL = old_break
    V2_CONTINUE_LABEL = old_continue

    emit_jump(func, label_top)
    emit_label(func, label_end)
    body_end + 1
}

fn parse_for_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64, token_count: i64) -> i64 with IO, Mut, Panic, Div, Alloc {
    // M1.2 Layer B1 — for x in START..END { body } / for x in START..=END { body }
    //                 for x in arr { body }           (array iteration, arr: [T; N])
    // pos points to token AFTER 'for' (i.e. the loop variable name).
    if token_kind(pos) != TK_IDENT { return pos }
    let var_tok = pos
    if token_kind(pos + 1) != TK_IDENT || !token_text_eq(pos + 1, "in") { return pos }
    // Check for array iteration: for x in IDENT { body } where IDENT is a local array
    if token_kind(pos + 2) == TK_IDENT && token_kind(pos + 3) == TK_LBRACE {
        let arr_tok = pos + 2
        let arr_base_reg = lookup_local_tok(ctx, arr_tok)
        let arr_alen = lookup_local_alen_tok(ctx, arr_tok)
        if arr_base_reg >= 0 && arr_alen > 0 {
            // for x in arr { body } — iterate arr[0..arr_alen]
            let body_start = pos + 3
            let body_end = find_matching_rbrace(body_start, token_count)
            if body_end < 0 { return pos }
            let idx_reg = alloc_reg(ctx)
            ufn_record_load_imm(idx_reg, 0)
            let end_reg = alloc_reg(ctx)
            ufn_record_load_imm(end_reg, arr_alen)
            let elem_reg = alloc_reg(ctx)
            remember_local_tok(ctx, var_tok, elem_reg)
            let label_top = alloc_label()
            let label_incr = alloc_label()
            let label_end = alloc_label()
            // cond check at top
            emit_label(func, label_top)
            let cond_reg = alloc_reg(ctx)
            // binop code 7 = lt
            ufn_record_binop(cond_reg, idx_reg, 7, end_reg)
            emit_branch_false(func, cond_reg, label_end)
            // load arr[idx] into elem_reg; BSS arrays use user-global load
            let for_bss_idx = lookup_local_bss_idx_tok(ctx, arr_tok)
            if for_bss_idx >= 0 {
                ufn_record_user_global_load(elem_reg, for_bss_idx, idx_reg)
                if USER_GLOBAL_IS_F64[for_bss_idx as usize] != 0 { mark_reg_f64(elem_reg) }
            } else {
                ufn_record_local_load(elem_reg, arr_base_reg, idx_reg)
            }
            let old_break = V2_BREAK_LABEL
            let old_continue = V2_CONTINUE_LABEL
            V2_BREAK_LABEL = label_end
            V2_CONTINUE_LABEL = label_incr
            parse_block_ir(func, ctx, body_start + 1, body_end, token_count)
            V2_BREAK_LABEL = old_break
            V2_CONTINUE_LABEL = old_continue
            emit_label(func, label_incr)
            let one_reg = alloc_reg(ctx)
            ufn_record_load_imm(one_reg, 1)
            ufn_record_binop(idx_reg, idx_reg, 1, one_reg)  // idx = idx + 1
            emit_jump(func, label_top)
            emit_label(func, label_end)
            return body_end + 1
        }
    }
    let start_parse = parse_expr_ir(func, ctx, pos + 2)
    if start_parse.ok == 0 { return pos }
    // `..` has kind code 160, `..=` has kind code 161 (see parser.sio).
    let range_tok = start_parse.next
    let range_code = pt_read_kind_code(range_tok)
    if range_code != 160 && range_code != 161 { return pos }
    var is_inclusive: i64 = 0
    if range_code == 161 { is_inclusive = 1 }
    let end_parse = parse_expr_ir(func, ctx, range_tok + 1)
    if end_parse.ok == 0 { return pos }
    let iter_reg = alloc_reg(ctx)
    ufn_record_copy(iter_reg, start_parse.reg)
    remember_local_tok(ctx, var_tok, iter_reg)
    let end_reg = alloc_reg(ctx)
    ufn_record_copy(end_reg, end_parse.reg)
    var bp = end_parse.next
    while bp < token_count && token_kind(bp) != TK_LBRACE { bp = bp + 1 }
    if bp >= token_count { return pos }
    let body_end = find_matching_rbrace(bp, token_count)
    if body_end < 0 { return pos }
    let label_top = alloc_label()
    let label_incr = alloc_label()
    let label_end = alloc_label()
    emit_label(func, label_top)
    let cond_reg = alloc_reg(ctx)
    // binop codes: 7=lt, 8=le (see cmp_op_to_code).
    var cmp_code: i64 = 7
    if is_inclusive != 0 { cmp_code = 8 }
    ufn_record_binop(cond_reg, iter_reg, cmp_code, end_reg)
    emit_branch_false(func, cond_reg, label_end)
    let old_break = V2_BREAK_LABEL
    let old_continue = V2_CONTINUE_LABEL
    V2_BREAK_LABEL = label_end
    V2_CONTINUE_LABEL = label_incr
    parse_block_ir(func, ctx, bp + 1, body_end, token_count)
    V2_BREAK_LABEL = old_break
    V2_CONTINUE_LABEL = old_continue
    emit_label(func, label_incr)
    let one_reg = alloc_reg(ctx)
    ufn_record_load_imm(one_reg, 1)
    ufn_record_binop(iter_reg, iter_reg, 1, one_reg)
    emit_jump(func, label_top)
    emit_label(func, label_end)
    body_end + 1
}

fn parse_if_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64, token_count: i64) -> i64 with IO, Mut, Panic, Div, Alloc {
    // if COND { THEN } [else [if ...] { ELSE }]
    // pos points to token AFTER 'if'
    let label_else = alloc_label()
    let label_end = alloc_label()

    let cond = parse_expr_ir(func, ctx, pos)
    if cond.ok == 0 { return pos }
    emit_branch_false(func, cond.reg, label_else)

    // parse then block
    var p = cond.next
    while p < token_count && token_kind(p) != TK_LBRACE { p = p + 1 }
    if p >= token_count { return pos }
    let then_end = find_matching_rbrace(p, token_count)
    if then_end < 0 { return pos }
    parse_block_ir(func, ctx, p + 1, then_end, token_count)
    emit_jump(func, label_end)
    emit_label(func, label_else)

    // check for else
    var after = skip_trivia(then_end + 1, token_count)
    if after < token_count && token_kind(after) == TK_ELSE {
        let after_else = after + 1
        let next_t = skip_trivia(after_else, token_count)
        if next_t < token_count && token_kind(next_t) == TK_IF {
            let end_pos = parse_if_ir(func, ctx, next_t + 1, token_count)
            emit_label(func, label_end)
            return end_pos
        }
        if next_t < token_count && token_kind(next_t) == TK_LBRACE {
            let else_end = find_matching_rbrace(next_t, token_count)
            if else_end >= 0 {
                parse_block_ir(func, ctx, next_t + 1, else_end, token_count)
                emit_label(func, label_end)
                return else_end + 1
            }
        }
    }
    emit_label(func, label_end)
    then_end + 1
}

fn parse_block_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64, close: i64, token_count: i64) with IO, Mut, Panic, Div, Alloc {
    let saved_local_count = V2_LOCAL_COUNT
    var p = skip_trivia(pos, close)
    // M1.2 step D — defensive no-progress guard. See
    // artifacts/m1_2_parity_inventory/blockers/m1_2_step_d_user_globals.md.
    // If parse_stmt_ir returns the same `p` it was given, the loop would
    // spin forever; convert that into a diagnosable unsupported_frontend
    // failure that names the stalling token.
    while p < close && V2_PARSE_UNSUPPORTED == 0 {
        let prev_p = p
        p = parse_stmt_ir(func, ctx, p, close, token_count)
        p = skip_trivia(p, close)
        if p <= prev_p && V2_PARSE_UNSUPPORTED == 0 {
            print("native_compile: parse_block_no_progress p=")
            print_int(prev_p)
            print(" kind=")
            print_int(token_kind(prev_p))
            print(" text=")
            print_token_text(prev_p)
            print("\n")
            mark_parse_unsupported(prev_p)
            p = close
        }
    }
    V2_LOCAL_COUNT = saved_local_count
}

fn parse_match_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64, token_count: i64) -> i64 with IO, Mut, Panic, Div, Alloc {
    // match expr { Pattern => body, ... }
    V2_LAST_STRUCT_IDX = -1
    let subj = parse_expr_ir(func, ctx, pos)
    if subj.ok == 0 { return pos }
    var p = subj.next
    while p < token_count && token_kind(p) != TK_LBRACE { p = p + 1 }
    if p >= token_count { return pos }
    let close = find_matching_rbrace(p, token_count)
    if close < 0 { return pos }
    let label_end = alloc_label()
    var cur = p + 1
    while cur < close {
        cur = skip_trivia(cur, close)
        if cur >= close { break }
        let arm_k = token_kind(cur)
        var is_wildcard = false
        var arm_val: i64 = -1
        if arm_k == TK_UNDERSCORE || (arm_k == TK_IDENT && token_text_eq(cur, "_")) {
            is_wildcard = true
            cur = cur + 1
        } else if arm_k == TK_INT {
            arm_val = pt_read_int_value(cur)
            cur = cur + 1
        } else if arm_k == TK_MINUS && token_kind(cur + 1) == TK_INT {
            arm_val = 0 - pt_read_int_value(cur + 1)
            cur = cur + 2
        } else if arm_k == TK_IDENT {
            if token_kind(cur + 1) == TK_COLONCOLON && token_kind(cur + 2) == TK_IDENT {
                let eidx = find_enum_idx_tok(cur)
                if eidx >= 0 { arm_val = find_enum_variant_value(eidx, cur + 2) }
                cur = cur + 3
            } else {
                var ei: i64 = 0
                while ei < ENUM_COUNT {
                    let v = find_enum_variant_value(ei, cur)
                    if v >= 0 { arm_val = v; break }
                    ei = ei + 1
                }
                cur = cur + 1
            }
        } else { cur = cur + 1; continue }
        cur = skip_trivia(cur, close)
        if cur < close && token_kind(cur) == TK_FATARROW { cur = cur + 1 }
        cur = skip_trivia(cur, close)
        if is_wildcard {
            if cur < close && token_kind(cur) == TK_LBRACE {
                let arm_close = find_matching_rbrace(cur, token_count)
                if arm_close >= 0 { parse_block_ir(func, ctx, cur + 1, arm_close, token_count); cur = arm_close + 1 }
            } else {
                V2_LAST_STRUCT_IDX = -1
                let body = parse_expr_ir(func, ctx, cur)
                if body.ok != 0 {
                    if V2_LAST_STRUCT_IDX >= 0 {
                        ufn_record_return_struct(body.reg, STRUCT_FLAT_SIZE[V2_LAST_STRUCT_IDX as usize])
                    } else { ufn_record_return(body.reg) }
                    cur = body.next
                }
            }
            break
        } else if arm_val >= 0 {
            let val_reg = alloc_reg(ctx)
            let cond_reg = alloc_reg(ctx)
            ufn_record_load_imm(val_reg, arm_val)
            ufn_record_binop(cond_reg, subj.reg, 5, val_reg)
            let label_skip = alloc_label()
            ufn_record_branch_false(cond_reg, label_skip)
            if cur < close && token_kind(cur) == TK_LBRACE {
                let arm_close = find_matching_rbrace(cur, token_count)
                if arm_close >= 0 { parse_block_ir(func, ctx, cur + 1, arm_close, token_count); cur = arm_close + 1 }
            } else {
                V2_LAST_STRUCT_IDX = -1
                let body = parse_expr_ir(func, ctx, cur)
                if body.ok != 0 {
                    if V2_LAST_STRUCT_IDX >= 0 {
                        ufn_record_return_struct(body.reg, STRUCT_FLAT_SIZE[V2_LAST_STRUCT_IDX as usize])
                    } else { ufn_record_return(body.reg) }
                    cur = body.next
                }
            }
            ufn_record_jump(label_end)
            ufn_record_label(label_skip)
            if cur < close && token_kind(cur) == TK_COMMA { cur = cur + 1 }
        } else { cur = cur + 1 }
    }
    ufn_record_label(label_end)
    close + 1
}

// Value-producing match expression: match SUBJ { pat => expr, ... }
// Returns ExprParse with dst register holding the matched arm's value.
// Handles integer literals, enum variants, and _ wildcard arms.
fn parse_match_expr_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64) -> ExprParse with Mut, Panic, Div, Alloc {
    let subj = parse_expr_ir(func, ctx, pos + 1)
    if subj.ok == 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
    var p = subj.next
    while p < V2_TOKEN_COUNT && token_kind(p) != TK_LBRACE { p = p + 1 }
    if p >= V2_TOKEN_COUNT { return ExprParse { ok: 0, reg: -1, next: pos} }
    let close = find_matching_rbrace(p, V2_TOKEN_COUNT)
    if close < 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
    let dst = alloc_reg(ctx)
    let label_end = alloc_label()
    var cur = p + 1
    while cur < close {
        cur = skip_trivia(cur, close)
        if cur >= close { break }
        let arm_k = token_kind(cur)
        var is_wildcard: bool = false
        var arm_const: i64 = -999999999
        if arm_k == TK_UNDERSCORE || (arm_k == TK_IDENT && token_text_eq(cur, "_")) {
            is_wildcard = true
            cur = cur + 1
        } else if arm_k == TK_INT {
            arm_const = pt_read_int_value(cur)
            cur = cur + 1
        } else if arm_k == TK_MINUS && token_kind(cur + 1) == TK_INT {
            arm_const = 0 - pt_read_int_value(cur + 1)
            cur = cur + 2
        } else if arm_k == TK_IDENT {
            if token_kind(cur + 1) == TK_COLONCOLON && token_kind(cur + 2) == TK_IDENT {
                let eidx = find_enum_idx_tok(cur)
                if eidx >= 0 { arm_const = find_enum_variant_value(eidx, cur + 2) }
                cur = cur + 3
            } else {
                var ei: i64 = 0
                while ei < ENUM_COUNT {
                    let v = find_enum_variant_value(ei, cur)
                    if v >= 0 { arm_const = v; break }
                    ei = ei + 1
                }
                cur = cur + 1
            }
        } else { cur = cur + 1; continue }
        cur = skip_trivia(cur, close)
        if cur < close && token_kind(cur) == TK_FATARROW { cur = cur + 1 }
        cur = skip_trivia(cur, close)
        let label_skip = alloc_label()
        if !is_wildcard {
            let val_reg = alloc_reg(ctx)
            let cond_reg = alloc_reg(ctx)
            ufn_record_load_imm(val_reg, arm_const)
            ufn_record_binop(cond_reg, subj.reg, 5, val_reg)
            ufn_record_branch_false(cond_reg, label_skip)
        }
        V2_LAST_STRUCT_IDX = -1
        let arm_expr = parse_expr_ir(func, ctx, cur)
        if arm_expr.ok != 0 {
            if arm_expr.reg != dst { ufn_record_copy(dst, arm_expr.reg) }
            cur = arm_expr.next
        }
        ufn_record_jump(label_end)
        ufn_record_label(label_skip)
        if cur < close && token_kind(cur) == TK_COMMA { cur = cur + 1 }
        if is_wildcard { break }
    }
    ufn_record_label(label_end)
    return ExprParse { ok: 1, reg: dst, next: close + 1}
}

fn parse_stmt_deref_idx_store(func: &! i64, ctx: &! V2DriverContext, p: i64, close: i64) -> i64 with Mut, Panic, Div, Alloc {
    // (*arr)[idx] = expr — ref-array indexed write
    if token_kind(p) == TK_LPAREN && token_kind(p + 1) == TK_STAR && token_kind(p + 2) == TK_IDENT && token_kind(p + 3) == TK_RPAREN && token_kind(p + 4) == TK_LBRACKET {
        let base_ref = lookup_local_tok(ctx, p + 2)
        if base_ref >= 0 && lookup_local_is_ref_tok(ctx, p + 2) != 0 {
            let idx_expr = parse_expr_ir(func, ctx, p + 5)
            if idx_expr.ok != 0 {
                let end_pos = skip_index_cast_end(idx_expr.next)
                if token_kind(end_pos) == TK_RBRACKET && token_kind(end_pos + 1) == TK_EQ {
                    let val = parse_expr_ir(func, ctx, end_pos + 2)
                    if val.ok != 0 {
                        ufn_record_ref_array_store(base_ref, idx_expr.reg, val.reg)
                        return val.next
                    }
                }
            }
        }
    }
    p
}

fn parse_stmt_deref_scalar_store(func: &! i64, ctx: &! V2DriverContext, p: i64, close: i64) -> i64 with Mut, Panic, Div, Alloc {
    // (*ref) = expr — plain scalar deref write
    if token_kind(p) != TK_LPAREN { return p }
    if token_kind(p + 1) != TK_STAR { return p }
    if token_kind(p + 2) != TK_IDENT { return p }
    if token_kind(p + 3) != TK_RPAREN { return p }
    if token_kind(p + 4) != TK_EQ { return p }
    let base_ref = lookup_local_tok(ctx, p + 2)
    if base_ref < 0 { return p }
    if lookup_local_is_ref_tok(ctx, p + 2) == 0 { return p }
    let rhs = parse_expr_ir(func, ctx, p + 5)
    if rhs.ok != 0 {
        ufn_record_store_ref_field(base_ref, 0, rhs.reg)
        return rhs.next
    }
    mark_parse_unsupported(p + 5)
    close
}

fn parse_stmt_struct_tail_ir(func: &! i64, ctx: &! V2DriverContext, p: i64, close: i64) -> i64 with Mut, Panic, Div, Alloc {
    if token_kind(p) != TK_IDENT || token_kind(p + 1) != TK_LBRACE { return p }
    V2_LAST_STRUCT_IDX = -1
    let lit = parse_struct_lit_ir(func, ctx, p, close)
    if lit.ok != 0 {
        let lit_next = skip_trivia(lit.next, close)
        if lit_next >= close && V2_LAST_STRUCT_IDX >= 0 {
            ufn_record_return_struct(lit.reg, STRUCT_FLAT_SIZE[V2_LAST_STRUCT_IDX as usize])
            V2_LAST_STRUCT_IDX = -1
            return lit.next
        }
    }
    V2_LAST_STRUCT_IDX = -1
    p
}

fn refuse_let_array_lit(eq_pos: i64, close: i64) -> i64 with Mut, Panic {
    if eq_pos + 1 < close && token_kind(eq_pos + 1) == TK_LBRACKET {
        mark_parse_unsupported(eq_pos + 1)
        return 1
    }
    return 0
}

fn parse_stmt_ir(func: &! i64, ctx: &! V2DriverContext, pos: i64, close: i64, token_count: i64) -> i64 with IO, Mut, Panic, Div, Alloc {
    let p = skip_trivia(pos, close)
    if p >= close { return close }
    let k = token_kind(p)

    if k == TK_IDENT && token_kind(p + 1) == TK_LT && token_kind(p + 2) == TK_IDENT && token_kind(p + 3) == TK_GT && token_kind(p + 4) == TK_LBRACE {
        let sidx = find_struct_idx_tok(p)
        if sidx >= 0 {
            let flat_size = STRUCT_FLAT_SIZE[sidx as usize]
            let base_reg = V2_NEXT_REG
            V2_NEXT_REG = V2_NEXT_REG + flat_size
            var cur_lit = p + 5
            while cur_lit < close {
                let kk_lit = token_kind(cur_lit)
                if kk_lit == TK_NEWLINE || kk_lit == TK_SEMI || kk_lit == TK_COMMA {
                    cur_lit = cur_lit + 1
                } else if kk_lit == TK_RBRACE {
                    V2_LAST_STRUCT_IDX = sidx
                    if token_text_eq(p + 2, "f64") {
                        mark_struct_scalar_regs_f64(base_reg, sidx)
                    } else {
                        mark_struct_regs(base_reg, sidx)
                    }
                    ufn_record_return_struct(base_reg, flat_size)
                    V2_LAST_STRUCT_IDX = -1
                    return cur_lit + 1
                } else if kk_lit == TK_IDENT {
                    let field_tok = cur_lit
                    let foff = struct_field_offset_tok(sidx, field_tok)
                    cur_lit = cur_lit + 1
                    if cur_lit < close && token_kind(cur_lit) == TK_COLON { cur_lit = cur_lit + 1 }
                    V2_LAST_STRUCT_IDX = -1
                    let val_lit = parse_expr_ir(func, ctx, cur_lit)
                    if val_lit.ok == 0 { mark_parse_unsupported(cur_lit); return close }
                    if foff >= 0 {
                        let val_sidx = V2_LAST_STRUCT_IDX
                        if val_sidx >= 0 {
                            let inner_flat = STRUCT_FLAT_SIZE[val_sidx as usize]
                            ufn_record_bulk_copy(base_reg + foff, val_lit.reg, inner_flat)
                        } else {
                            ufn_record_copy(base_reg + foff, val_lit.reg)
                        }
                    }
                    cur_lit = val_lit.next
                    if cur_lit < close && token_kind(cur_lit) == TK_COMMA { cur_lit = cur_lit + 1 }
                } else {
                    mark_parse_unsupported(cur_lit)
                    return close
                }
            }
        }
    }

    if k == TK_IDENT && token_kind(p + 1) == TK_LBRACE {
        let struct_tail_next = parse_stmt_struct_tail_ir(func, ctx, p, close)
        if struct_tail_next > p { return struct_tail_next }
    }

    if k == TK_IDENT && token_text_eq(p, "break") {
        if V2_BREAK_LABEL >= 0 {
            emit_jump(func, V2_BREAK_LABEL)
            return p + 1
        }
        mark_parse_unsupported(p)
        return close
    }

    if k == TK_IDENT && token_text_eq(p, "continue") {
        if V2_CONTINUE_LABEL >= 0 {
            emit_jump(func, V2_CONTINUE_LABEL)
            return p + 1
        }
        mark_parse_unsupported(p)
        return close
    }

    if k == TK_IDENT && token_text_eq(p, "for") {
        return parse_for_ir(func, ctx, p + 1, token_count)
    }

    if k == TK_VAR || k == TK_LET {
        // var/let name : type = expr  OR  var name : type = expr
        if token_kind(p + 1) != TK_IDENT { return p + 1 }
        // Array type declaration: var name: [T; N]  (zero-initialized, no RHS required)
        if token_kind(p + 2) == TK_COLON && token_kind(p + 3) == TK_LBRACKET {
            var j = p + 4
            while j < close && token_kind(j) != TK_SEMI { j = j + 1 }
            if j < close && token_kind(j + 1) == TK_INT {
                let arr_size = pt_read_int_value(j + 1)
                // BSS path: arr_size elements each need one UFN op at init.
                // V2_UFN_OPS has 4096 entries; cap at 512 to leave slack.
                if arr_size > 512 && USER_GLOBAL_COUNT < 64 {
                    let bss_ug_idx = USER_GLOBAL_COUNT
                    USER_GLOBAL_DATA_OFFSET[bss_ug_idx as usize] = USER_GLOBAL_DATA_LEN
                    USER_GLOBAL_ELEM_COUNT[bss_ug_idx as usize] = arr_size
                    var bss_is_f64: i64 = 0
                    if token_text_eq(p + 4, "f64") { bss_is_f64 = 1 }
                    USER_GLOBAL_IS_F64[bss_ug_idx as usize] = bss_is_f64
                    USER_GLOBAL_DATA_LEN = USER_GLOBAL_DATA_LEN + arr_size * 8
                    USER_GLOBAL_COUNT = bss_ug_idx + 1
                    let bss_dummy = alloc_reg(ctx)
                    remember_local_arr_tok_bss(ctx, p + 1, bss_dummy, arr_size, bss_ug_idx)
                    // ELF loader zero-fills the BSS region; skip [0; N]/[0.0; N] init.
                    var bss_end = j + 2
                    while bss_end < close && token_kind(bss_end) != TK_RBRACKET { bss_end = bss_end + 1 }
                    if bss_end + 1 < close && token_kind(bss_end + 1) == TK_EQ && token_kind(bss_end + 2) == TK_LBRACKET {
                        var bss_d: i64 = 1
                        var bss_s = bss_end + 3
                        while bss_s < close && bss_d > 0 {
                            let bss_k = token_kind(bss_s)
                            if bss_k == TK_LBRACKET { bss_d = bss_d + 1 }
                            if bss_k == TK_RBRACKET { bss_d = bss_d - 1 }
                            bss_s = bss_s + 1
                        }
                        return bss_s
                    }
                    return bss_end + 1
                }
                let arr_base = V2_NEXT_REG
                V2_NEXT_REG = arr_base + arr_size
                remember_local_arr_tok(ctx, p + 1, arr_base, arr_size)
                var end = j + 2
                while end < close && token_kind(end) != TK_RBRACKET { end = end + 1 }
                // Lookahead: detect `= [val; N]` to avoid redundant zero-fill.
                // Without this, a 1024-element array would emit 2048 copies
                // (zero-fill + re-fill), exceeding the UFN buffer limit.
                var has_semi_init: i64 = 0
                if end + 1 < close && token_kind(end + 1) == TK_EQ && token_kind(end + 2) == TK_LBRACKET {
                    var la_depth: i64 = 1
                    var la = end + 3
                    while la < close && la_depth > 0 {
                        let lk = token_kind(la)
                        if lk == TK_LBRACKET { la_depth = la_depth + 1 }
                        if lk == TK_RBRACKET { la_depth = la_depth - 1 }
                        if lk == TK_SEMI && la_depth == 1 { has_semi_init = 1 }
                        la = la + 1
                    }
                }
                // Zero-fill only when no [val; N] initializer covers all slots.
                if has_semi_init == 0 {
                    let zero_reg = alloc_reg(ctx)
                    ufn_record_load_imm(zero_reg, 0)
                    ufn_record_array_fill(arr_base, zero_reg, arr_size)
                }
                // M1.2 step 4 bisect — tail-literal initializer for
                // `var arr: [T; N] = [v0, v1, ...]` or `= [val; N]`. See
                // artifacts/m1_2_parity_inventory/blockers/m1_2_step4_array_init.md
                // for the history. Bisect 3/N: each element is parsed by
                // parse_expr_ir, so floats, negated literals (`0 - N`), and
                // variable refs all work.
                if end + 1 < close && token_kind(end + 1) == TK_EQ && token_kind(end + 2) == TK_LBRACKET {
                    let rhs_open = end + 2
                    var rhs_depth: i64 = 1
                    var rhs_scan = rhs_open + 1
                    var rhs_has_semi: i64 = 0
                    var rhs_close: i64 = 0 - 1
                    while rhs_scan < close && rhs_depth > 0 {
                        let rk = token_kind(rhs_scan)
                        if rk == TK_LBRACKET { rhs_depth = rhs_depth + 1 }
                        if rk == TK_RBRACKET {
                            rhs_depth = rhs_depth - 1
                            if rhs_depth == 0 { rhs_close = rhs_scan }
                        }
                        if rk == TK_SEMI && rhs_depth == 1 { rhs_has_semi = 1 }
                        rhs_scan = rhs_scan + 1
                    }
                    if rhs_close < 0 { return end + 1 }
                    let rhs_first = rhs_open + 1
                    if rhs_has_semi != 0 {
                        // [val; N] — parse val once, copy into all slots.
                        V2_LAST_STRUCT_IDX = 0 - 1
                        let fill_parse = parse_expr_ir(func, ctx, rhs_first)
                        V2_LAST_STRUCT_IDX = 0 - 1
                        if fill_parse.ok != 0 {
                            ufn_record_array_fill(arr_base, fill_parse.reg, arr_size)
                        }
                    } else {
                        // [v0, v1, ...] — parse each element as a full expression.
                        var cur_tok = rhs_first
                        var slot_i: i64 = 0
                        while cur_tok < rhs_close && slot_i < arr_size {
                            if token_kind(cur_tok) == TK_COMMA {
                                cur_tok = cur_tok + 1
                            } else {
                                V2_LAST_STRUCT_IDX = 0 - 1
                                let elem_parse = parse_expr_ir(func, ctx, cur_tok)
                                V2_LAST_STRUCT_IDX = 0 - 1
                                if elem_parse.ok == 0 { break }
                                ufn_record_copy(arr_base + slot_i, elem_parse.reg)
                                slot_i = slot_i + 1
                                cur_tok = elem_parse.next
                            }
                        }
                    }
                    return rhs_close + 1
                }
                return end + 1
            }
        }
        var eq_pos = p + 2
        while eq_pos < close && token_kind(eq_pos) != TK_EQ { eq_pos = eq_pos + 1 }
        if eq_pos >= close { return eq_pos }
        if refuse_let_array_lit(eq_pos, close) > 0 { return close }
        V2_LAST_STRUCT_IDX = -1
        V2_LAST_ARR_LEN = 0
        let parsed = parse_expr_ir(func, ctx, eq_pos + 1)
        var let_next = parsed.next
        var let_ok = parsed.ok
        var let_reg = parsed.reg
        if let_ok == 0 {
            mark_parse_unsupported(eq_pos + 1)
            return close
        }
        if V2_LAST_STRUCT_IDX >= 0 {
            let bind_sidx = V2_LAST_STRUCT_IDX
            let flat_size = STRUCT_FLAT_SIZE[bind_sidx as usize]
            let bind_base = alloc_reg(ctx)
            var bi: i64 = 1
            while bi < flat_size { let _ = alloc_reg(ctx); bi = bi + 1 }
            ufn_record_bulk_copy(bind_base, let_reg, flat_size)
            remember_struct_local_tok(ctx, p + 1, bind_base, bind_sidx)
            let bind_guard_idx = V2_LOCAL_COUNT - 1
            scan_local_knowledge_guard_type(bind_guard_idx, p + 3, eq_pos)
            V2_LAST_STRUCT_IDX = -1
            return let_next
        }
        // let name = fn_returning_array() — register result as local array
        if V2_LAST_ARR_LEN > 0 {
            let arr_len = V2_LAST_ARR_LEN
            V2_LAST_ARR_LEN = 0
            remember_local_arr_tok(ctx, p + 1, let_reg, arr_len)
            return let_next
        }
        let bind_reg = alloc_reg(ctx)
        ufn_record_copy(bind_reg, let_reg)
        remember_local_tok(ctx, p + 1, bind_reg)
        let scalar_bind_guard_idx = V2_LOCAL_COUNT - 1
        scan_local_knowledge_guard_type(scalar_bind_guard_idx, p + 3, eq_pos)
        return let_next
    }

    if k == TK_RETURN {
        let after_return = skip_trivia(p + 1, close)
        if after_return >= close {
            let zero_ret = alloc_reg(ctx)
            ufn_record_load_imm(zero_ret, 0)
            ufn_record_return(zero_ret)
            return p + 1
        }
        if token_kind(after_return) == TK_IDENT {
            let direct_arr_base = lookup_local_tok(ctx, after_return)
            let direct_arr_len = lookup_local_alen_tok(ctx, after_return)
            if direct_arr_base >= 0 && direct_arr_len > 0 && token_kind(after_return + 1) != TK_LBRACKET {
                ufn_record_return_struct(direct_arr_base, direct_arr_len)
                return after_return + 1
            }
        }
        V2_LAST_STRUCT_IDX = -1
        V2_LAST_ARR_LEN = 0
        let parsed = parse_expr_ir(func, ctx, p + 1)
        if parsed.ok != 0 {
            if V2_LAST_STRUCT_IDX >= 0 {
                ufn_record_return_struct(parsed.reg, STRUCT_FLAT_SIZE[V2_LAST_STRUCT_IDX as usize])
                V2_LAST_STRUCT_IDX = -1
                return parsed.next
            }
            // Return of a local [T; N] array — use struct-return path
            let ret_alen = lookup_local_alen_by_reg(ctx, parsed.reg)
            if ret_alen > 0 {
                ufn_record_return_struct(parsed.reg, ret_alen)
                return parsed.next
            }
            ufn_record_return(parsed.reg)
            return parsed.next
        }
        mark_parse_unsupported(p + 1)
        return close
    }

    if k == TK_WHILE {
        return parse_while_ir(func, ctx, p + 1, token_count)
    }

    if k == TK_IF {
        return parse_if_ir(func, ctx, p + 1, token_count)
    }

    if k == TK_MATCH {
        return parse_match_ir(func, ctx, p + 1, token_count)
    }

    if k == TK_OR {
        V2_LAST_STRUCT_IDX = -1
        let early_closure_tail = parse_expr_ir(func, ctx, p)
        if early_closure_tail.ok != 0 {
            if early_closure_tail.next >= close {
                ufn_record_return(early_closure_tail.reg)
                return early_closure_tail.next
            }
        }
    }

    if k == TK_INT || k == TK_FLOAT || k == TK_TRUE || k == TK_FALSE || k == TK_STRING || k == TK_MINUS {
        V2_LAST_STRUCT_IDX = -1
        let early_tail = parse_expr_ir(func, ctx, p)
        if early_tail.ok != 0 {
            ufn_record_return(early_tail.reg)
            return early_tail.next
        }
    }

    if k == TK_IDENT && token_kind(p + 1) == TK_LPAREN {
        var early_call_continues_expr: i64 = 0
        var early_call_scan = p + 2
        var early_call_depth: i64 = 1
        while early_call_scan < close && early_call_depth > 0 {
            let early_call_k = token_kind(early_call_scan)
            if early_call_k == TK_LPAREN { early_call_depth = early_call_depth + 1 }
            if early_call_k == TK_RPAREN { early_call_depth = early_call_depth - 1 }
            early_call_scan = early_call_scan + 1
        }
        if early_call_depth == 0 {
            let early_next = skip_trivia(early_call_scan, close)
            let early_next_k = token_kind(early_next)
            if early_next_k == TK_OROR || early_next_k == TK_ANDAND ||
                is_arith_op(early_next_k) || is_cmp_op(early_next_k) ||
                early_next_k == TK_AS || early_next_k == TK_DOT || early_next_k == TK_LBRACKET {
                early_call_continues_expr = 1
            }
        }
        if early_call_continues_expr != 0 {
            let saved_ufn_count = V2_UFN_COUNT
            let saved_next_reg = V2_NEXT_REG
            let saved_last_struct = V2_LAST_STRUCT_IDX
            V2_LAST_STRUCT_IDX = -1
            let early_tail_expr = parse_expr_ir(func, ctx, p)
            if early_tail_expr.ok != 0 {
                if early_tail_expr.next >= close {
                    if V2_LAST_STRUCT_IDX >= 0 {
                        ufn_record_return_struct(early_tail_expr.reg, STRUCT_FLAT_SIZE[V2_LAST_STRUCT_IDX as usize])
                        V2_LAST_STRUCT_IDX = -1
                        return early_tail_expr.next
                    }
                    if V2_LAST_ARR_LEN > 0 {
                        ufn_record_return_struct(early_tail_expr.reg, V2_LAST_ARR_LEN)
                        V2_LAST_ARR_LEN = 0
                        return early_tail_expr.next
                    }
                    ufn_record_return(early_tail_expr.reg)
                    return early_tail_expr.next
                }
            }
            V2_UFN_COUNT = saved_ufn_count
            V2_NEXT_REG = saved_next_reg
            V2_LAST_STRUCT_IDX = saved_last_struct
        } else {
            let saved_ufn_count = V2_UFN_COUNT
            let saved_next_reg = V2_NEXT_REG
            let saved_last_struct = V2_LAST_STRUCT_IDX
            let call = parse_fn_call_ir(func, ctx, p)
            if call.ok != 0 {
                let next_k = token_kind(call.next)
                let returns_value = call_target_or_fnref_returns_value_tok(ctx, p)
                let continues_expr = next_k == TK_OROR || next_k == TK_ANDAND
                    || is_arith_op(next_k) || is_cmp_op(next_k)
                    || next_k == TK_AS || next_k == TK_DOT || next_k == TK_LBRACKET
                if !continues_expr && call.next >= close && returns_value {
                    if V2_LAST_STRUCT_IDX >= 0 {
                        ufn_record_return_struct(call.reg, STRUCT_FLAT_SIZE[V2_LAST_STRUCT_IDX as usize])
                        V2_LAST_STRUCT_IDX = -1
                        return call.next
                    }
                    if V2_LAST_ARR_LEN > 0 {
                        ufn_record_return_struct(call.reg, V2_LAST_ARR_LEN)
                        V2_LAST_ARR_LEN = 0
                        return call.next
                    }
                    ufn_record_return(call.reg)
                    return call.next
                }
                if !continues_expr && (call.next < close || !returns_value) {
                    if V2_UFN_COUNT > 0 {
                        let last_op_idx = V2_UFN_COUNT - 1
                        let last_op = V2_UFN_OPS[last_op_idx as usize]
                        if last_op == UFN_CALL || last_op == UFN_CALL_STRUCT_RESULT {
                            V2_UFN_DST[last_op_idx as usize] = -1
                        }
                    }
                    return call.next
                }
                V2_UFN_COUNT = saved_ufn_count
                V2_NEXT_REG = saved_next_reg
                V2_LAST_STRUCT_IDX = saved_last_struct
            }
        }
    }

    if k == TK_IDENT {
        let early_local_reg = lookup_local_tok(ctx, p)
        let early_local_next_k = token_kind(p + 1)
        if early_local_reg >= 0 && early_local_next_k != TK_EQ &&
            early_local_next_k != TK_LBRACKET &&
            early_local_next_k != TK_LPAREN {
            let saved_ufn_count = V2_UFN_COUNT
            let saved_next_reg = V2_NEXT_REG
            let saved_last_struct = V2_LAST_STRUCT_IDX
            V2_LAST_STRUCT_IDX = -1
            let early_local_tail = parse_expr_ir(func, ctx, p)
            if early_local_tail.ok != 0 {
                if early_local_tail.next >= close {
                    if V2_LAST_STRUCT_IDX >= 0 {
                        ufn_record_return_struct(early_local_tail.reg, STRUCT_FLAT_SIZE[V2_LAST_STRUCT_IDX as usize])
                        V2_LAST_STRUCT_IDX = -1
                        return early_local_tail.next
                    }
                    let early_local_alen = lookup_local_alen_by_reg(ctx, early_local_tail.reg)
                    if early_local_alen > 0 {
                        ufn_record_return_struct(early_local_tail.reg, early_local_alen)
                        return early_local_tail.next
                    }
                    ufn_record_return(early_local_tail.reg)
                    return early_local_tail.next
                }
            }
            V2_UFN_COUNT = saved_ufn_count
            V2_NEXT_REG = saved_next_reg
            V2_LAST_STRUCT_IDX = saved_last_struct
        }
    }

    if k == TK_IDENT && token_kind(p + 1) == TK_LBRACKET {
        let early_arr_base = lookup_local_tok(ctx, p)
        if early_arr_base >= 0 && lookup_local_is_ref_tok(ctx, p) == 0 {
            let early_idx_expr = parse_expr_ir(func, ctx, p + 2)
            if early_idx_expr.ok != 0 {
                let early_end_pos = skip_index_cast_end(early_idx_expr.next)
                if token_kind(early_end_pos) == TK_RBRACKET && token_kind(early_end_pos + 1) == TK_EQ {
                    let early_val = parse_expr_ir(func, ctx, early_end_pos + 2)
                    if early_val.ok != 0 {
                        let early_bss_idx = lookup_local_bss_idx_tok(ctx, p)
                        if early_bss_idx >= 0 {
                            ufn_record_user_global_store(early_bss_idx, early_idx_expr.reg, early_val.reg)
                        } else {
                            ufn_record_local_store(early_arr_base, early_idx_expr.reg, early_val.reg)
                        }
                        return early_val.next
                    }
                    mark_parse_unsupported(early_end_pos + 2)
                    return close
                }
            }
        }
    }

    if k == TK_IDENT && token_kind(p + 1) == TK_EQ {
        let early_old_reg = lookup_local_tok(ctx, p)
        if early_old_reg >= 0 {
            let early_assignment_guard_idx = lookup_local_knowledge_guard_index(ctx, p)
            V2_LAST_STRUCT_IDX = -1
            let early_asn = parse_expr_ir(func, ctx, p + 2)
            if early_asn.ok != 0 {
                let early_asn_sidx = V2_LAST_STRUCT_IDX
                if early_asn_sidx >= 0 {
                    let early_asn_flat = STRUCT_FLAT_SIZE[early_asn_sidx as usize]
                    if early_asn.reg != early_old_reg {
                        ufn_record_bulk_copy(early_old_reg, early_asn.reg, early_asn_flat)
                    }
                    if early_assignment_guard_idx >= 0 {
                        ufn_emit_local_knowledge_runtime_guard(ctx, early_assignment_guard_idx, early_old_reg)
                    }
                    V2_LAST_STRUCT_IDX = -1
                    return early_asn.next
                }
                if early_asn.reg != early_old_reg {
                    ufn_record_copy(early_old_reg, early_asn.reg)
                }
                if early_assignment_guard_idx >= 0 {
                    ufn_emit_local_knowledge_runtime_guard(ctx, early_assignment_guard_idx, early_old_reg)
                }
                return early_asn.next
            }
            mark_parse_unsupported(p + 2)
            return close
        }
    }

    if k == TK_IDENT && token_kind(p + 1) != TK_LPAREN {
        let early_bare_local_probe = lookup_local_tok(ctx, p)
        if early_bare_local_probe < 0 {
            let early_bare_fn_id = lookup_user_fn_id_tok(p)
            if early_bare_fn_id >= 0 {
                let saved_ufn_count = V2_UFN_COUNT
                let saved_next_reg = V2_NEXT_REG
                let saved_last_struct = V2_LAST_STRUCT_IDX
                V2_LAST_STRUCT_IDX = -1
                let early_bare_tail = parse_expr_ir(func, ctx, p)
                if early_bare_tail.ok != 0 {
                    if early_bare_tail.next >= close {
                        ufn_record_return(early_bare_tail.reg)
                        return early_bare_tail.next
                    }
                }
                V2_UFN_COUNT = saved_ufn_count
                V2_NEXT_REG = saved_next_reg
                V2_LAST_STRUCT_IDX = saved_last_struct
            }
        }
    }

    // driver global table/scalar mutation: TABLE[idx] = expr or SCALAR = expr
    if k == TK_IDENT {
        let global_local_probe = lookup_local_tok(ctx, p)
        if global_local_probe < 0 {
            let gid = driver_global_id_tok(p)
            if gid >= 0 {
                if token_kind(p + 1) == TK_LBRACKET {
                    let idx_expr = parse_expr_ir(func, ctx, p + 2)
                    if idx_expr.ok != 0 {
                        let end_pos = skip_index_cast_end(idx_expr.next)
                        if token_kind(end_pos) == TK_RBRACKET && token_kind(end_pos + 1) == TK_EQ {
                            let parsed = parse_expr_ir(func, ctx, end_pos + 2)
                            if parsed.ok != 0 {
                                ufn_record_global_store(gid, idx_expr.reg, parsed.reg)
                                return parsed.next
                            }
                            mark_parse_unsupported(end_pos + 2)
                            return close
                        }
                    }
                }
                if token_kind(p + 1) == TK_EQ {
                    let parsed = parse_expr_ir(func, ctx, p + 2)
                    if parsed.ok != 0 {
                        ufn_record_global_store(gid, -1, parsed.reg)
                        return parsed.next
                    }
                    mark_parse_unsupported(p + 2)
                    return close
                }
            }
            // M1.2 step D — user-global indexed store: `NAME[expr] = expr`.
            let ugid = user_global_id_tok(p)
            if ugid >= 0 {
                if token_kind(p + 1) == TK_LBRACKET {
                    let idx_expr = parse_expr_ir(func, ctx, p + 2)
                    if idx_expr.ok != 0 {
                        let end_pos = skip_index_cast_end(idx_expr.next)
                        if token_kind(end_pos) == TK_RBRACKET && token_kind(end_pos + 1) == TK_EQ {
                            let parsed = parse_expr_ir(func, ctx, end_pos + 2)
                            if parsed.ok != 0 {
                                ufn_record_user_global_store(ugid, idx_expr.reg, parsed.reg)
                                return parsed.next
                            }
                            mark_parse_unsupported(end_pos + 2)
                            return close
                        }
                    }
                }
            }
        }
    }

    // local array write: ident[expr] = expr
    if k == TK_IDENT && token_kind(p + 1) == TK_LBRACKET {
        let base_reg = lookup_local_tok(ctx, p)
        if base_reg >= 0 && lookup_local_is_ref_tok(ctx, p) == 0 {
            let idx_expr = parse_expr_ir(func, ctx, p + 2)
            if idx_expr.ok != 0 {
                let end_pos = skip_index_cast_end(idx_expr.next)
                if token_kind(end_pos) == TK_RBRACKET && token_kind(end_pos + 1) == TK_EQ {
                    let val = parse_expr_ir(func, ctx, end_pos + 2)
                    if val.ok != 0 {
                        let bss_wr_idx = lookup_local_bss_idx_tok(ctx, p)
                        if bss_wr_idx >= 0 {
                            ufn_record_user_global_store(bss_wr_idx, idx_expr.reg, val.reg)
                        } else {
                            ufn_record_local_store(base_reg, idx_expr.reg, val.reg)
                        }
                        return val.next
                    }
                    mark_parse_unsupported(end_pos + 2)
                    return close
                }
            }
        }
    }

    // ref-array param indexed write: arr[idx] = expr where arr is &![T; N]
    if k == TK_IDENT && token_kind(p + 1) == TK_LBRACKET {
        let base_reg = lookup_local_tok(ctx, p)
        if base_reg >= 0 && lookup_local_is_ref_tok(ctx, p) != 0 && lookup_local_struct_idx_tok(ctx, p) < 0 {
            let idx_expr = parse_expr_ir(func, ctx, p + 2)
            if idx_expr.ok != 0 {
                let end_pos = skip_index_cast_end(idx_expr.next)
                if token_kind(end_pos) == TK_RBRACKET && token_kind(end_pos + 1) == TK_EQ {
                    let val = parse_expr_ir(func, ctx, end_pos + 2)
                    if val.ok != 0 {
                        ufn_record_ref_array_store(base_reg, idx_expr.reg, val.reg)
                        return val.next
                    }
                }
            }
        }
    }

    // (*arr)[idx] = expr — ref-array indexed write via deref-then-index
    if k == TK_LPAREN && token_kind(p + 1) == TK_STAR {
        let deref_idx_next = parse_stmt_deref_idx_store(func, ctx, p, close)
        if deref_idx_next > p { return deref_idx_next }

        // (*ref) = expr — plain scalar deref write
        let deref_scalar_next = parse_stmt_deref_scalar_store(func, ctx, p, close)
        if deref_scalar_next > p { return deref_scalar_next }
    }

    // reference field mutation: (*ctx).field = expr
    if k == TK_LPAREN && token_kind(p + 1) == TK_STAR && token_kind(p + 2) == TK_IDENT && token_kind(p + 3) == TK_RPAREN && token_kind(p + 4) == TK_DOT && token_kind(p + 5) == TK_IDENT && token_kind(p + 6) == TK_EQ {
        let base_ref = lookup_local_tok(ctx, p + 2)
        if base_ref >= 0 && lookup_local_is_ref_tok(ctx, p + 2) != 0 {
            let sidx = lookup_local_struct_idx_tok(ctx, p + 2)
            if sidx >= 0 {
                let foff = struct_field_offset_tok(sidx, p + 5)
                if foff >= 0 {
                    V2_LAST_STRUCT_IDX = -1
                    let parsed = parse_expr_ir(func, ctx, p + 7)
                    if parsed.ok != 0 {
                        ufn_record_store_ref_field(base_ref, foff, parsed.reg)
                        V2_LAST_STRUCT_IDX = -1
                        return parsed.next
                    }
                    mark_parse_unsupported(p + 7)
                    return close
                }
            }
        }
    }

    // field array write: p.buf[idx] = expr
    if k == TK_IDENT && token_kind(p + 1) == TK_DOT && token_kind(p + 2) == TK_IDENT && token_kind(p + 3) == TK_LBRACKET {
        let base_reg = lookup_local_tok(ctx, p)
        if base_reg >= 0 {
            let sidx = lookup_local_struct_idx_tok(ctx, p)
            if sidx >= 0 {
                let foff = struct_field_offset_tok(sidx, p + 2)
                if foff >= 0 {
                    let idx_expr = parse_expr_ir(func, ctx, p + 4)
                    if idx_expr.ok != 0 {
                        let end_pos = skip_index_cast_end(idx_expr.next)
                        if token_kind(end_pos) == TK_RBRACKET && token_kind(end_pos + 1) == TK_EQ {
                            let val = parse_expr_ir(func, ctx, end_pos + 2)
                            if val.ok != 0 {
                                let base_is_ref = lookup_local_is_ref_tok(ctx, p)
                                if base_is_ref != 0 && foff == 0 {
                                    // ref to struct: pointer in base_reg slot; dereference + downward index
                                    ufn_record_ref_array_store(base_reg, idx_expr.reg, val.reg)
                                } else {
                                    ufn_record_local_store(base_reg + foff, idx_expr.reg, val.reg)
                                }
                                return val.next
                            }
                            mark_parse_unsupported(end_pos + 2)
                            return close
                        }
                    }
                }
            }
        }
    }

    // field mutation: p.x = expr  (M1.2: handles ref via store_ref_field)
    if k == TK_IDENT && token_kind(p + 1) == TK_DOT && token_kind(p + 2) == TK_IDENT && token_kind(p + 3) == TK_EQ {
        let base_reg = lookup_local_tok(ctx, p)
        if base_reg >= 0 {
            let sidx = lookup_local_struct_idx_tok(ctx, p)
            if sidx >= 0 {
                let foff = struct_field_offset_tok(sidx, p + 2)
                if foff >= 0 {
                    let base_is_ref = lookup_local_is_ref_tok(ctx, p)
                    V2_LAST_STRUCT_IDX = -1
                    let parsed = parse_expr_ir(func, ctx, p + 4)
                    if parsed.ok != 0 {
                        if base_is_ref != 0 {
                            if V2_LAST_STRUCT_IDX >= 0 {
                                let inner_flat = STRUCT_FLAT_SIZE[V2_LAST_STRUCT_IDX as usize]
                                var ci: i64 = 0
                                while ci < inner_flat {
                                    ufn_record_store_ref_field(base_reg, foff + ci, parsed.reg + ci)
                                    ci = ci + 1
                                }
                                V2_LAST_STRUCT_IDX = -1
                                return parsed.next
                            }
                            ufn_record_store_ref_field(base_reg, foff, parsed.reg)
                            V2_LAST_STRUCT_IDX = -1
                            return parsed.next
                        }
                        if V2_LAST_STRUCT_IDX >= 0 {
                            let inner_flat = STRUCT_FLAT_SIZE[V2_LAST_STRUCT_IDX as usize]
                            ufn_record_bulk_copy(base_reg + foff, parsed.reg, inner_flat)
                            V2_LAST_STRUCT_IDX = -1
                            return parsed.next
                        }
                        ufn_record_copy(base_reg + foff, parsed.reg)
                        V2_LAST_STRUCT_IDX = -1
                        return parsed.next
                    }
                    mark_parse_unsupported(p + 4)
                    return close
                }
            }
        }
    }

    // assignment: name = expr  (name is already a local)
    if k == TK_IDENT && token_kind(p + 1) == TK_EQ {
        let old_reg = lookup_local_tok(ctx, p)
        if old_reg >= 0 {
            let assignment_guard_idx = lookup_local_knowledge_guard_index(ctx, p)
            V2_LAST_STRUCT_IDX = -1
            let parsed = parse_expr_ir(func, ctx, p + 2)
            if parsed.ok != 0 {
                let asn_sidx = V2_LAST_STRUCT_IDX
                if asn_sidx >= 0 {
                    // struct copy: update all fields
                    let asn_flat = STRUCT_FLAT_SIZE[asn_sidx as usize]
                    if parsed.reg != old_reg {
                        ufn_record_bulk_copy(old_reg, parsed.reg, asn_flat)
                    }
                    if assignment_guard_idx >= 0 {
                        ufn_emit_local_knowledge_runtime_guard(ctx, assignment_guard_idx, old_reg)
                    }
                    V2_LAST_STRUCT_IDX = -1
                    return parsed.next
                }
                if parsed.reg != old_reg {
                    ufn_record_copy(old_reg, parsed.reg)
                }
                if assignment_guard_idx >= 0 {
                    ufn_emit_local_knowledge_runtime_guard(ctx, assignment_guard_idx, old_reg)
                }
                return parsed.next
            }
            mark_parse_unsupported(p + 2)
            return close
        }
    }

    // call statement: name(args)  — for side-effecting calls
    // Skip this path if the call is part of a larger expression (||, &&, binop, cmp, postfix).
    // M1.2 step 4: when a tail-expression-position call is followed by a binary
    // operator (e.g. `fib(n-1) + fib(n-2)` as a block tail), we previously
    // swallowed the call as a statement and then choked on the operator.
    // Now we save UFN/reg state, speculatively parse the call, and roll back
    // if the next token continues the expression — letting the tail-expression
    // branch below re-parse the whole thing via parse_expr_ir.
    if k == TK_IDENT && token_kind(p + 1) == TK_LPAREN {
        let saved_ufn_count = V2_UFN_COUNT
        let saved_next_reg = V2_NEXT_REG
        let saved_last_struct = V2_LAST_STRUCT_IDX
        let call = parse_fn_call_ir(func, ctx, p)
        if call.ok != 0 {
            let next_k = token_kind(call.next)
            let returns_value = call_target_or_fnref_returns_value_tok(ctx, p)
            let continues_expr = next_k == TK_OROR || next_k == TK_ANDAND
                || is_arith_op(next_k) || is_cmp_op(next_k)
                || next_k == TK_AS || next_k == TK_DOT || next_k == TK_LBRACKET
            if !continues_expr && (call.next < close || !returns_value) {
                if V2_UFN_COUNT > 0 {
                    let last_op_idx = V2_UFN_COUNT - 1
                    let last_op = V2_UFN_OPS[last_op_idx as usize]
                    if last_op == UFN_CALL || last_op == UFN_CALL_STRUCT_RESULT {
                        V2_UFN_DST[last_op_idx as usize] = -1
                    }
                }
                return call.next
            }
            // Roll back the speculative call so the tail-expression branch
            // below can re-parse from `p` via parse_expr_ir.
            V2_UFN_COUNT = saved_ufn_count
            V2_NEXT_REG = saved_next_reg
            V2_LAST_STRUCT_IDX = saved_last_struct
        }
    }

    // tail expression (implicit return at end of block)
    V2_LAST_STRUCT_IDX = -1
    let tail = parse_expr_ir(func, ctx, p)
    if tail.ok != 0 {
        if V2_LAST_STRUCT_IDX >= 0 {
            ufn_record_return_struct(tail.reg, STRUCT_FLAT_SIZE[V2_LAST_STRUCT_IDX as usize])
            V2_LAST_STRUCT_IDX = -1
            return tail.next
        }
        ufn_record_return(tail.reg)
        return tail.next
    }

    mark_parse_unsupported(p)
    close
}

fn find_fn_lbrace(token_count: i64, name_str_pos: i64) -> i64 with Mut, Panic, Div {
    var j = name_str_pos + 1
    var paren_depth: i64 = 0
    var angle_depth: i64 = 0
    while j < token_count {
        let k = token_kind(j)
        if k == TK_LPAREN {
            paren_depth = paren_depth + 1
        } else if k == TK_RPAREN {
            if paren_depth > 0 { paren_depth = paren_depth - 1 }
        } else if k == TK_LT {
            angle_depth = angle_depth + 1
        } else if k == TK_GT {
            if angle_depth > 0 { angle_depth = angle_depth - 1 }
        } else if k == TK_LBRACE && paren_depth == 0 && angle_depth == 0 {
            return j
        }
        if k == TK_FN && j + 1 < token_count && token_kind(j + 1) == TK_IDENT {
            return -1
        }
        j = j + 1
    }
    -1
}

fn skip_native_v2_driver_helper_fn(name_tok: i64) -> bool with Mut, Panic, Div {
    if token_text_eq(name_tok, "token_name") { return true }
    if token_text_eq(name_tok, "token_string_name") { return true }
    if token_text_eq(name_tok, "name_eq_text") { return true }
    if token_text_eq(name_tok, "fixed_name_print") { return true }
    if token_text_eq(name_tok, "fixed_name_print_int") { return true }
    if token_text_eq(name_tok, "fixed_name_print_char") { return true }
    if token_text_eq(name_tok, "fixed_name_get_arg_count") { return true }
    if token_text_eq(name_tok, "fixed_name_arg_count") { return true }
    if token_text_eq(name_tok, "fixed_name_get_arg") { return true }
    if token_text_eq(name_tok, "fixed_name_str_eq") { return true }
    if token_text_eq(name_tok, "fixed_name_main") { return true }
    if token_text_eq(name_tok, "set_func_name_print") { return true }
    if token_text_eq(name_tok, "set_func_name_print_int") { return true }
    if token_text_eq(name_tok, "set_func_name_print_char") { return true }
    if token_text_eq(name_tok, "set_func_name_get_arg_count") { return true }
    if token_text_eq(name_tok, "set_func_name_get_arg") { return true }
    if token_text_eq(name_tok, "set_func_name_str_eq") { return true }
    if token_text_eq(name_tok, "set_func_name_main") { return true }
    if token_text_eq(name_tok, "lookup_user_fn_id") { return true }
    if token_text_eq(name_tok, "user_fn_name_at") { return true }
    if token_text_eq(name_tok, "builtin_fn_id") { return true }
    if token_text_eq(name_tok, "binary_op_from_cmp_kind") { return true }
    if token_text_eq(name_tok, "emit_instr") { return true }
    if token_text_eq(name_tok, "driver_read_file_to_cursor_source") { return true }
    if token_text_eq(name_tok, "driver_write_elf_to_file") { return true }
    if token_text_eq(name_tok, "driver_make_executable") { return true }
    false
}

// M1.2 step D — identify user-globals by their declaring identifier token.
// Returns the index into USER_GLOBAL_* arrays, or -1 if the token does not
// name a registered user-global. Matching uses the shared ident-equality
// helper so the bound identifier in `NAME[i]` reads/writes matches the
// declaration-site token.
fn user_global_id_tok(tok: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < USER_GLOBAL_COUNT {
        if toks_ident_eq(USER_GLOBAL_NAME_TOK[i as usize], tok) { return i }
        i = i + 1
    }
    0 - 1
}

// M1.2 step D — top-level scan for user-declared globals of the form
// `var NAME: [T; N]` (with or without a trailing `= [...]`). Skips any
// matching name that is already a hard-coded driver global, so the
// self-compile path continues to use drv_emit_driver_global_*. Non-scalar
// element types other than i64/f64 are skipped (handled as unsupported).
fn scan_user_globals(token_count: i64) with Mut, Panic, Div {
    USER_GLOBAL_COUNT = 0
    USER_GLOBAL_DATA_LEN = 0
    var depth: i64 = 0
    var i: i64 = 0
    while i < token_count {
        let k = token_kind(i)
        if k == TK_LBRACE { depth = depth + 1; i = i + 1 }
        else if k == TK_RBRACE { depth = depth - 1; i = i + 1 }
        else if depth == 0 && k == TK_VAR && i + 7 < token_count
                && token_kind(i + 1) == TK_IDENT
                && token_kind(i + 2) == TK_COLON
                && token_kind(i + 3) == TK_LBRACKET {
            // Skip if NAME is already a hard-coded driver global (e.g. DRV_RODATA_BYTES).
            let name_tok = i + 1
            if driver_global_id_tok(name_tok) >= 0 {
                i = i + 4
            } else {
                // Scan to matching `]` at depth 0, noting the `; INT ]` shape.
                var sc = i + 4
                while sc < token_count && token_kind(sc) != TK_SEMI && token_kind(sc) != TK_RBRACKET {
                    sc = sc + 1
                }
                if sc < token_count && token_kind(sc) == TK_SEMI
                        && sc + 2 < token_count && token_kind(sc + 1) == TK_INT
                        && token_kind(sc + 2) == TK_RBRACKET {
                    let elem_count = pt_read_int_value(sc + 1)
                    let elem_type_tok = i + 4
                    var is_f64: i64 = 0
                    if token_text_eq(elem_type_tok, "f64") { is_f64 = 1 }
                    // Accept i64 and f64 element types only. Others (i8, u32, etc.)
                    // are skipped; their references fall through to the unsupported
                    // path, which is the previous behaviour.
                    let accept_type = token_text_eq(elem_type_tok, "i64") || is_f64 != 0
                    if accept_type && USER_GLOBAL_COUNT < 64 {
                        let idx = USER_GLOBAL_COUNT
                        USER_GLOBAL_NAME_TOK[idx as usize] = name_tok
                        USER_GLOBAL_DATA_OFFSET[idx as usize] = USER_GLOBAL_DATA_LEN
                        USER_GLOBAL_ELEM_COUNT[idx as usize] = elem_count
                        USER_GLOBAL_IS_F64[idx as usize] = is_f64
                        USER_GLOBAL_DATA_LEN = USER_GLOBAL_DATA_LEN + elem_count * 8
                        USER_GLOBAL_COUNT = idx + 1
                    }
                    // Advance past the type `]` and an optional `= [...]` initializer.
                    i = sc + 3
                    if i < token_count && token_kind(i) == TK_EQ
                            && i + 1 < token_count && token_kind(i + 1) == TK_LBRACKET {
                        var bd: i64 = 1
                        i = i + 2
                        while i < token_count && bd > 0 {
                            let kk = token_kind(i)
                            if kk == TK_LBRACKET { bd = bd + 1 }
                            if kk == TK_RBRACKET { bd = bd - 1 }
                            i = i + 1
                        }
                    }
                } else {
                    i = i + 1
                }
            }
        } else {
            i = i + 1
        }
    }
}

fn scan_user_fn_knowledge_guard_signature(reg_idx: i64, sig_start: i64, sig_end: i64) with Mut, Panic, Div {
    if reg_idx < 0 || reg_idx >= 512 {
        return
    }
    var p = sig_start
    var seen_arrow: i64 = 0
    while p + 9 < sig_end {
        if token_kind(p) == TK_ARROW {
            seen_arrow = 1
        }
        if token_kind(p) == TK_IDENT && token_text_eq(p, "Knowledge") &&
           token_kind(p + 1) == TK_LT &&
           token_kind(p + 2) == TK_IDENT &&
           token_kind(p + 3) == TK_IDENT && token_text_eq(p + 3, "where") &&
           token_kind(p + 4) == TK_LBRACE {
            let value_sidx = find_struct_idx_tok(p + 2)
            var guard_count: i64 = 0
            var q = p + 5
            while value_sidx >= 0 && q + 2 < sig_end && token_kind(q) != TK_RBRACE && guard_count < 4 {
                if token_kind(q) == TK_IDENT &&
                   is_cmp_op(token_kind(q + 1)) &&
                   (token_kind(q + 2) == TK_INT || token_kind(q + 2) == TK_FLOAT) {
                    let field_offset = struct_field_offset_tok(value_sidx, q)
                    if field_offset >= 0 {
                        var threshold_value: i64 = 0
                        var threshold_scale: i64 = 1
                        var threshold_kind: i64 = 0
                        if token_kind(q + 2) == TK_FLOAT {
                            threshold_value = token_float_mantissa(q + 2)
                            threshold_scale = token_float_scale(q + 2)
                            threshold_kind = 2
                        } else {
                            threshold_value = pt_read_int_value(q + 2)
                        }
                        var unit_suffix_pos = q + 3
                        if token_kind(q + 2) == TK_INT &&
                           q + 4 < sig_end &&
                           token_kind(q + 3) == TK_DOT &&
                           token_kind(q + 4) == TK_INT {
                            threshold_scale = decimal_scale_for_digits(token_decimal_digit_count(q + 4))
                            threshold_value = (pt_read_int_value(q + 2) * threshold_scale) + pt_read_int_value(q + 4)
                            threshold_kind = 2
                            unit_suffix_pos = q + 5
                        }
                        if unit_suffix_pos + 2 < sig_end &&
                           token_kind(unit_suffix_pos) == TK_LT &&
                           token_kind(unit_suffix_pos + 1) == TK_IDENT &&
                           token_kind(unit_suffix_pos + 2) == TK_GT {
                            threshold_kind = 3
                        }
                        let row = reg_idx * 4 + guard_count
                        V2_USER_FN_KNOWLEDGE_GUARD_ROW_FIELD_OFFSET[row as usize] = field_offset
                        V2_USER_FN_KNOWLEDGE_GUARD_ROW_CMP_CODE[row as usize] = cmp_op_to_code(token_kind(q + 1))
                        V2_USER_FN_KNOWLEDGE_GUARD_ROW_THRESHOLD[row as usize] = threshold_value
                        V2_USER_FN_KNOWLEDGE_GUARD_ROW_THRESHOLD_SCALE[row as usize] = threshold_scale
                        V2_USER_FN_KNOWLEDGE_GUARD_ROW_THRESHOLD_KIND[row as usize] = threshold_kind
                        if guard_count == 0 {
                            V2_USER_FN_KNOWLEDGE_GUARD_FIELD_TOK[reg_idx as usize] = q
                            V2_USER_FN_KNOWLEDGE_GUARD_FIELD_OFFSET[reg_idx as usize] = field_offset
                            V2_USER_FN_KNOWLEDGE_GUARD_CMP_CODE[reg_idx as usize] = cmp_op_to_code(token_kind(q + 1))
                            V2_USER_FN_KNOWLEDGE_GUARD_THRESHOLD[reg_idx as usize] = threshold_value
                        }
                        guard_count = guard_count + 1
                    }
                }
                q = q + 1
            }
            if guard_count > 0 {
                V2_USER_FN_KNOWLEDGE_GUARD_ENABLED[reg_idx as usize] = 1
                V2_USER_FN_KNOWLEDGE_GUARD_COUNT[reg_idx as usize] = guard_count
                V2_USER_FN_KNOWLEDGE_GUARD_TYPE_STRUCT_IDX[reg_idx as usize] = value_sidx
                if seen_arrow != 0 { V2_USER_FN_KNOWLEDGE_GUARD_SITE[reg_idx as usize] = 2 }
                else { V2_USER_FN_KNOWLEDGE_GUARD_SITE[reg_idx as usize] = 1 }
                return
            }
        }
        p = p + 1
    }
}

fn scan_local_knowledge_guard_type(local_idx: i64, type_start: i64, type_end: i64) with Mut, Panic, Div {
    if local_idx < 0 || local_idx >= 64 {
        return
    }
    var p = type_start
    while p + 9 < type_end {
        if token_kind(p) == TK_IDENT && token_text_eq(p, "Knowledge") &&
           token_kind(p + 1) == TK_LT &&
           token_kind(p + 2) == TK_IDENT &&
           token_kind(p + 3) == TK_IDENT && token_text_eq(p + 3, "where") &&
           token_kind(p + 4) == TK_LBRACE {
            let value_sidx = find_struct_idx_tok(p + 2)
            var guard_count: i64 = 0
            var q = p + 5
            while value_sidx >= 0 && q + 2 < type_end && token_kind(q) != TK_RBRACE && guard_count < 4 {
                if token_kind(q) == TK_IDENT &&
                   is_cmp_op(token_kind(q + 1)) &&
                   (token_kind(q + 2) == TK_INT || token_kind(q + 2) == TK_FLOAT) {
                    let field_offset = struct_field_offset_tok(value_sidx, q)
                    if field_offset >= 0 {
                        var threshold_value: i64 = 0
                        var threshold_scale: i64 = 1
                        var threshold_kind: i64 = 0
                        if token_kind(q + 2) == TK_FLOAT {
                            threshold_value = token_float_mantissa(q + 2)
                            threshold_scale = token_float_scale(q + 2)
                            threshold_kind = 2
                        } else {
                            threshold_value = pt_read_int_value(q + 2)
                        }
                        var unit_suffix_pos = q + 3
                        if token_kind(q + 2) == TK_INT &&
                           q + 4 < type_end &&
                           token_kind(q + 3) == TK_DOT &&
                           token_kind(q + 4) == TK_INT {
                            threshold_scale = decimal_scale_for_digits(token_decimal_digit_count(q + 4))
                            threshold_value = (pt_read_int_value(q + 2) * threshold_scale) + pt_read_int_value(q + 4)
                            threshold_kind = 2
                            unit_suffix_pos = q + 5
                        }
                        if unit_suffix_pos + 2 < type_end &&
                           token_kind(unit_suffix_pos) == TK_LT &&
                           token_kind(unit_suffix_pos + 1) == TK_IDENT &&
                           token_kind(unit_suffix_pos + 2) == TK_GT {
                            threshold_kind = 3
                        }
                        let row = local_idx * 4 + guard_count
                        V2_LOCAL_KNOWLEDGE_GUARD_ROW_FIELD_OFFSET[row as usize] = field_offset
                        V2_LOCAL_KNOWLEDGE_GUARD_ROW_CMP_CODE[row as usize] = cmp_op_to_code(token_kind(q + 1))
                        V2_LOCAL_KNOWLEDGE_GUARD_ROW_THRESHOLD[row as usize] = threshold_value
                        V2_LOCAL_KNOWLEDGE_GUARD_ROW_THRESHOLD_SCALE[row as usize] = threshold_scale
                        V2_LOCAL_KNOWLEDGE_GUARD_ROW_THRESHOLD_KIND[row as usize] = threshold_kind
                        if guard_count == 0 {
                            V2_LOCAL_KNOWLEDGE_GUARD_FIELD_OFFSET[local_idx as usize] = field_offset
                            V2_LOCAL_KNOWLEDGE_GUARD_CMP_CODE[local_idx as usize] = cmp_op_to_code(token_kind(q + 1))
                            V2_LOCAL_KNOWLEDGE_GUARD_THRESHOLD[local_idx as usize] = threshold_value
                        }
                        guard_count = guard_count + 1
                    }
                }
                q = q + 1
            }
            if guard_count > 0 {
                V2_LOCAL_KNOWLEDGE_GUARD_ENABLED[local_idx as usize] = 1
                V2_LOCAL_KNOWLEDGE_GUARD_COUNT[local_idx as usize] = guard_count
                V2_LOCAL_KNOWLEDGE_GUARD_TYPE_STRUCT_IDX[local_idx as usize] = value_sidx
                return
            }
        }
        p = p + 1
    }
}

fn scan_user_fns(token_count: i64, first_fn_id: i64) with Mut, Panic, Div {
    V2_USER_FN_COUNT = 0
    var reset_i: i64 = 0
    while reset_i < 512 {
        V2_USER_FN_KNOWLEDGE_GUARD_ENABLED[reset_i as usize] = 0
        V2_USER_FN_KNOWLEDGE_GUARD_SITE[reset_i as usize] = 0
        V2_USER_FN_KNOWLEDGE_GUARD_COUNT[reset_i as usize] = 0
        V2_USER_FN_KNOWLEDGE_GUARD_FIELD_TOK[reset_i as usize] = 0
        V2_USER_FN_KNOWLEDGE_GUARD_FIELD_OFFSET[reset_i as usize] = 0
        V2_USER_FN_KNOWLEDGE_GUARD_CMP_CODE[reset_i as usize] = 0
        V2_USER_FN_KNOWLEDGE_GUARD_THRESHOLD[reset_i as usize] = 0
        V2_USER_FN_KNOWLEDGE_GUARD_TYPE_STRUCT_IDX[reset_i as usize] = -1
        reset_i = reset_i + 1
    }
    var i: i64 = 0
    var next_id = first_fn_id
    while i + 1 < token_count {
        if token_kind(i) == TK_FN && token_kind(i + 1) == TK_IDENT {
            // Skip extern fn declarations (no body — terminated by ; at depth 0).
            // Must track bracket depth to avoid mistaking the `;` in `[T; N]`
            // parameter types for a declaration terminator.
            var has_body: bool = false
            var kb: i64 = i + 2
            var kb_depth: i64 = 0
            var kb_angle_depth: i64 = 0
            while kb < token_count {
                let kbk = token_kind(kb)
                if kbk == TK_LPAREN || kbk == TK_LBRACKET { kb_depth = kb_depth + 1 }
                else if kbk == TK_RPAREN || kbk == TK_RBRACKET { if kb_depth > 0 { kb_depth = kb_depth - 1 } }
                else if kbk == TK_LT { kb_angle_depth = kb_angle_depth + 1 }
                else if kbk == TK_GT { if kb_angle_depth > 0 { kb_angle_depth = kb_angle_depth - 1 } }
                else if kbk == TK_LBRACE && kb_depth == 0 && kb_angle_depth == 0 { has_body = true; break }
                else if kbk == TK_SEMI && kb_depth == 0 && kb_angle_depth == 0 { break }
                else if kbk == TK_RBRACE && kb_depth == 0 && kb_angle_depth == 0 { break }
                else if kbk == TK_FN && kb_depth == 0 && kb_angle_depth == 0 && token_kind(kb + 1) == TK_IDENT { break }
                kb = kb + 1
            }
            if !has_body { i = i + 2; continue }
            if !token_text_eq(i + 1, "main") && !skip_native_v2_driver_helper_fn(i + 1) {
                let reg_idx = V2_USER_FN_COUNT
                register_user_fn(i + 1, next_id)
                scan_user_fn_knowledge_guard_signature(reg_idx, i + 2, kb)
                // scan for -> ReturnType to detect struct/array return
                var ret_sidx: i64 = -1
                var ret_is_f64: i64 = 0
                var ret_arr_size: i64 = 0
                var ret_is_fnref: i64 = 0
                var j = i + 2
                while j < token_count && token_kind(j) != TK_LBRACE && token_kind(j) != TK_FN {
                    if token_kind(j) == TK_ARROW {
                        if j + 1 < token_count && token_kind(j + 1) == TK_FN {
                            ret_is_fnref = 1
                        }
                        if j + 1 < token_count && token_kind(j + 1) == TK_IDENT {
                            ret_sidx = find_struct_idx_tok(j + 1)
                            if token_text_eq(j + 1, "f64") || token_text_eq(j + 1, "f32") {
                                ret_is_f64 = 1
                            }
                            if j + 4 < token_count && token_kind(j + 2) == TK_LT && token_kind(j + 3) == TK_IDENT && token_kind(j + 4) == TK_GT && token_text_eq(j + 3, "f64") {
                                ret_is_f64 = 1
                            }
                        }
                        // Detect -> [T; N] array return. Scan to the body
                        // opener instead of relying on exact offsets; imported
                        // stdlib signatures may carry trivia/effects nearby.
                        var ret_scan = j + 1
                        while ret_scan + 3 < token_count && token_kind(ret_scan) != TK_LBRACE && token_kind(ret_scan) != TK_FN {
                            if token_kind(ret_scan) == TK_LBRACKET {
                                var ret_semi = ret_scan + 1
                                while ret_semi < token_count && token_kind(ret_semi) != TK_SEMI && token_kind(ret_semi) != TK_RBRACKET && token_kind(ret_semi) != TK_LBRACE {
                                    ret_semi = ret_semi + 1
                                }
                                if ret_semi + 1 < token_count && token_kind(ret_semi) == TK_SEMI && token_kind(ret_semi + 1) == TK_INT {
                                    ret_arr_size = pt_read_int_value(ret_semi + 1)
                                }
                            }
                            ret_scan = ret_scan + 1
                        }
                        break
                    }
                    j = j + 1
                }
                if reg_idx < 512 {
                    V2_USER_FN_RETURN_STRUCT_IDX[reg_idx as usize] = ret_sidx
                    if ret_is_fnref != 0 {
                        V2_USER_FN_RETURN_IS_F64[reg_idx as usize] = 2
                    } else {
                        V2_USER_FN_RETURN_IS_F64[reg_idx as usize] = ret_is_f64
                    }
                    V2_USER_FN_RETURN_ARR_SIZE[reg_idx as usize] = ret_arr_size
                }
                next_id = next_id + 1
            }
            i = i + 2
        } else {
            i = i + 1
        }
    }
}

fn source_uses_ident(token_count: i64, text: string) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < token_count {
        if token_kind(i) == TK_IDENT && token_text_eq(i, text) {
            return true
        }
        i = i + 1
    }
    false
}

fn source_count_ident(token_count: i64, text: string) -> i64 with Mut, Panic, Div {
    var count: i64 = 0
    var i: i64 = 0
    while i < token_count {
        if token_kind(i) == TK_IDENT && token_text_eq(i, text) {
            count = count + 1
        }
        i = i + 1
    }
    count
}

fn drv_low8(x: i64) -> i64 with Div {
    let q = x / 256
    let n = x - (q * 256)
    if n < 0 {
        n + 256
    } else {
        n
    }
}

fn drv_emit_byte(b: i64) with Mut, Div, Panic {
    let p = DRV_CODE_LEN
    if p >= 0 && p < 524288 {
        DRV_CODE_BYTES[p as usize] = drv_low8(b) as i8
        DRV_CODE_LEN = p + 1
    }
}

fn drv_emit_u32_le(val: i64) with Mut, Div, Panic {
    var v = val
    if v < 0 { v = v + 4294967296 }
    let b0 = drv_low8(v)
    let b1 = drv_low8(v / 256)
    let b2 = drv_low8(v / 65536)
    let b3 = drv_low8(v / 16777216)
    drv_emit_byte(b0)
    drv_emit_byte(b1)
    drv_emit_byte(b2)
    drv_emit_byte(b3)
}

fn drv_emit_u64_le(val: i64) with Mut, Div, Panic {
    var lo = val % 4294967296
    if lo < 0 { lo = lo + 4294967296 }
    var hi = val / 4294967296
    if val < 0 && (val % 4294967296) != 0 { hi = hi - 1 }
    drv_emit_u32_le(lo)
    drv_emit_u32_le(hi)
}

fn drv_patch_u32_le(offset: i64, val: i64) with Mut, Div, Panic {
    if offset >= 0 && offset + 4 <= DRV_CODE_LEN {
        var v = val
        if v < 0 { v = v + 4294967296 }
        let b0 = drv_low8(v)
        let b1 = drv_low8(v / 256)
        let b2 = drv_low8(v / 65536)
        let b3 = drv_low8(v / 16777216)
        DRV_CODE_BYTES[offset as usize] = b0 as i8
        DRV_CODE_BYTES[(offset + 1) as usize] = b1 as i8
        DRV_CODE_BYTES[(offset + 2) as usize] = b2 as i8
        DRV_CODE_BYTES[(offset + 3) as usize] = b3 as i8
    }
}

fn drv_modrm_rr(dst: i64, src: i64) -> i64 { 192 + (src * 8) + dst }
fn drv_modrm_rm_imm(dst: i64) -> i64 { 192 + dst }
fn drv_ir_slot_offset(vreg: i64) -> i64 { 0 - ((vreg + 1) * 8) }

fn drv_patch_frame_size(fn_id: i64, vreg_count: i64) with Mut, Div, Panic {
    if fn_id < 0 || fn_id >= 2048 { return }
    let fn_start = DRV_FN_OFFSETS[fn_id as usize]
    if fn_start < 0 { return }
    let raw = (vreg_count + 1) * 8
    let frame = ((raw + 15) / 16) * 16
    drv_patch_u32_le(fn_start + 7, frame)
}

fn drv_param_reg(idx: i64) -> i64 {
    if idx == 0 { return 7 }
    if idx == 1 { return 6 }
    if idx == 2 { return 2 }
    if idx == 3 { return 1 }
    if idx == 4 { return 8 }
    if idx == 5 { return 9 }
    if idx == 6 { return 10 }
    if idx == 7 { return 11 }
    -1
}

fn drv_align_page(offset: i64) -> i64 with Div {
    let q = offset / 4096
    let r = offset - (q * 4096)
    if r == 0 { return offset }
    offset + (4096 - r)
}

fn drv_global_stride() -> i64 { 1048576 }
fn drv_driver_data_len() -> i64 { 111153152 }  // 4096 base + 106 global slots * 1MiB stride (0-105)

fn drv_emit_mov_reg_imm32(reg: i64, val: i64) with Mut, Div, Panic {
    drv_emit_byte(72)
    drv_emit_byte(199)
    drv_emit_byte(drv_modrm_rm_imm(reg))
    drv_emit_u32_le(val)
}

fn drv_emit_mov_reg_imm64(reg: i64, val: i64) with Mut, Div, Panic {
    if reg >= 8 {
        drv_emit_byte(73)
    } else {
        drv_emit_byte(72)
    }
    drv_emit_byte(184 + (reg & 7))
    drv_emit_u64_le(val)
}

fn drv_emit_mov_reg_imm(reg: i64, val: i64) with Mut, Div, Panic {
    if val >= -2147483648 && val <= 2147483647 {
        drv_emit_mov_reg_imm32(reg, val)
    } else {
        drv_emit_mov_reg_imm64(reg, val)
    }
}

fn drv_emit_mov_rax_imm(val: i64) with Mut, Div, Panic { drv_emit_mov_reg_imm(0, val) }

fn drv_emit_mov_reg_reg(dst: i64, src: i64) with Mut, Div, Panic {
    if dst >= 8 || src >= 8 {
        var rex = 72
        if src >= 8 { rex = rex + 4 }
        if dst >= 8 { rex = rex + 1 }
        drv_emit_byte(rex)
        drv_emit_byte(137)
        drv_emit_byte(drv_modrm_rr(dst - ((dst / 8) * 8), src - ((src / 8) * 8)))
    } else {
        drv_emit_byte(72)
        drv_emit_byte(137)
        drv_emit_byte(drv_modrm_rr(dst, src))
    }
}

fn drv_emit_mov_rdi_rax() with Mut, Div, Panic { drv_emit_mov_reg_reg(7, 0) }

