}

// rep movsb  (F3 A4)
fn drv_emit_rep_movsb() with Mut, Div, Panic {
    drv_emit_byte(243)
    drv_emit_byte(164)
}

// heap_alloc(n_bytes) — inline mmap syscall
// arg0_reg = n_bytes vreg; dst = result vreg
fn drv_emit_heap_alloc(dst: i64, arg0_reg: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(arg0_reg)
    drv_emit_mov_reg_reg(6, 0)    // mov rsi, rax  (size)
    drv_emit_xor_rdi_rdi()        // mov rdi, 0    (addr=NULL)
    drv_emit_mov_reg_imm(2, 3)    // mov rdx, 3    (PROT_READ|PROT_WRITE)
    drv_emit_mov_r10_imm8(34)     // mov r10, 0x22 (MAP_PRIVATE|MAP_ANON)
    drv_emit_mov_r8_neg1()        // mov r8, -1    (fd=-1)
    drv_emit_xor_r9_r9()          // xor r9, r9    (offset=0)
    drv_emit_mov_rax_imm(9)       // mov rax, 9    (SYS_mmap)
    drv_emit_syscall()
    if dst >= 0 { drv_core_store_rax_to_temp(dst) }
}

// heap_free(ptr) — no-op, return 0
fn drv_emit_heap_free(dst: i64, arg0_reg: i64) with Mut, Panic, Div {
    drv_emit_xor_rax_rax()
    if dst >= 0 { drv_core_store_rax_to_temp(dst) }
}

// read_i64(ptr, idx) — load ptr[idx]
fn drv_emit_read_i64(dst: i64, arg0_reg: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(arg0_reg)
    drv_emit_mov_reg_reg(7, 0)    // mov rdi, rax  (ptr)
    drv_core_load_temp_to_rax(arg0_reg + 1)
    drv_emit_mov_reg_reg(6, 0)    // mov rsi, rax  (idx)
    drv_emit_shl_rsi_3()          // shl rsi, 3    (idx * 8)
    drv_emit_add_rdi_rsi()        // add rdi, rsi  (ptr + idx*8)
    drv_emit_load_rax_from_rdi()  // mov rax, [rdi]
    if dst >= 0 { drv_core_store_rax_to_temp(dst) }
}

// write_i64(ptr, idx, val) — store val to ptr[idx]
fn drv_emit_write_i64(dst: i64, arg0_reg: i64) with Mut, Panic, Div {
    drv_core_load_temp_to_rax(arg0_reg)
    drv_emit_mov_reg_reg(7, 0)    // mov rdi, rax  (ptr)
    drv_core_load_temp_to_rax(arg0_reg + 1)
    drv_emit_mov_reg_reg(6, 0)    // mov rsi, rax  (idx)
    drv_emit_shl_rsi_3()          // shl rsi, 3    (idx * 8)
    drv_emit_add_rdi_rsi()        // add rdi, rsi  (ptr + idx*8)
    drv_core_load_temp_to_rax(arg0_reg + 2)   // val
    drv_emit_store_rax_to_rdi()   // mov [rdi], rax
    drv_emit_xor_rax_rax()
    if dst >= 0 { drv_core_store_rax_to_temp(dst) }
}

// heap_realloc(old_ptr, new_size) — mmap new region, copy old_ptr content, return new_ptr
fn drv_emit_heap_realloc(dst: i64, arg0_reg: i64) with Mut, Panic, Div {
    // mmap(NULL, new_size, PROT_RW, MAP_PRIVATE|MAP_ANON, -1, 0)
    drv_core_load_temp_to_rax(arg0_reg + 1)
    drv_emit_mov_reg_reg(6, 0)    // mov rsi, rax  (new_size)
    drv_emit_xor_rdi_rdi()
    drv_emit_mov_reg_imm(2, 3)
    drv_emit_mov_r10_imm8(34)
    drv_emit_mov_r8_neg1()
    drv_emit_xor_r9_r9()
    drv_emit_mov_rax_imm(9)
    drv_emit_syscall()             // rax = new_ptr
    // save new_ptr; set up for rep movsb (rdi=new_ptr, rsi=old_ptr, rcx=new_size)
    drv_emit_mov_reg_reg(7, 0)    // mov rdi, rax  (new_ptr = dest)
    drv_emit_byte(87)             // push rdi      (save new_ptr)
    drv_core_load_temp_to_rax(arg0_reg)
    drv_emit_mov_reg_reg(6, 0)    // mov rsi, rax  (old_ptr = source)
    drv_core_load_temp_to_rax(arg0_reg + 1)
    drv_emit_mov_reg_reg(1, 0)    // mov rcx, rax  (new_size = count)
    drv_emit_rep_movsb()          // rep movsb
    drv_emit_byte(88)             // pop rax       (new_ptr)
    if dst >= 0 { drv_core_store_rax_to_temp(dst) }
}

fn drv_emit_entry_trampoline(main_fn_id: i64) with Mut, Panic, Div {
    DRV_ENTRY_OFFSET = DRV_CODE_LEN
    drv_emit_byte(73)
    drv_emit_byte(137)
    drv_emit_byte(230)
    let call_pos = DRV_CODE_LEN
    drv_emit_call_rel32_placeholder()
    drv_add_call_reloc(call_pos + 1, main_fn_id)
    drv_emit_mov_rdi_rax()
    drv_emit_mov_rax_imm(60)
    drv_emit_syscall()
    drv_emit_byte(15)
    drv_emit_byte(11)
}

fn drv_apply_relocations(rodata_file_offset: i64, data_file_offset: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < DRV_RELOC_COUNT {
        let patch_offset = DRV_RELOC_OFFSETS[i as usize]
        let encoded = DRV_RELOC_TARGETS[i as usize]
        let kind = drv_decode_reloc_kind(encoded)
        let target = drv_decode_reloc_target(encoded)
        if kind == 1 {
            if target >= 0 && target < 2048 {
                let target_offset = DRV_FN_OFFSETS[target as usize]
                let rel = target_offset - (patch_offset + 4)
                drv_patch_u32_le(patch_offset, rel)
            }
        } else if kind == 2 {
            let next_ip = 4096 + patch_offset + 4
            let target_va = rodata_file_offset + target
            drv_patch_u32_le(patch_offset, target_va - next_ip)
        } else if kind == 3 {
            let next_ip2 = 4096 + patch_offset + 4
            let target_va2 = data_file_offset + target
            drv_patch_u32_le(patch_offset, target_va2 - next_ip2)
        }
        i = i + 1
    }
}

fn drv_elf_emit_byte(b: i64) with Mut, Panic, Div {
    let p = DRV_ELF_LEN
    if p >= 0 && p < 1048576 {
        DRV_ELF_BYTES[p as usize] = drv_low8(b) as i8
        DRV_ELF_LEN = p + 1
    }
}

fn drv_elf_emit_u16(v: i64) with Mut, Panic, Div {
    let b0 = drv_low8(v)
    let b1 = drv_low8(v / 256)
    drv_elf_emit_byte(b0)
    drv_elf_emit_byte(b1)
}

fn drv_elf_emit_u32(v0: i64) with Mut, Panic, Div {
    var v = v0
    if v < 0 { v = v + 4294967296 }
    let b0 = drv_low8(v)
    let b1 = drv_low8(v / 256)
    let b2 = drv_low8(v / 65536)
    let b3 = drv_low8(v / 16777216)
    drv_elf_emit_byte(b0)
    drv_elf_emit_byte(b1)
    drv_elf_emit_byte(b2)
    drv_elf_emit_byte(b3)
}

fn drv_elf_emit_u64(v: i64) with Mut, Panic, Div {
    let lo = v
    let hi = v / 4294967296
    drv_elf_emit_u32(lo)
    drv_elf_emit_u32(hi)
}

fn drv_elf_patch_u64(off: i64, v: i64) with Mut, Panic, Div {
    if off >= 0 && off + 8 <= DRV_ELF_LEN {
        let b0 = drv_low8(v)
        let b1 = drv_low8(v / 256)
        let b2 = drv_low8(v / 65536)
        let b3 = drv_low8(v / 16777216)
        let b4 = drv_low8(v / 4294967296)
        let b5 = drv_low8(v / 1099511627776)
        let b6 = drv_low8(v / 281474976710656)
        let b7 = drv_low8(v / 72057594037927936)
        DRV_ELF_BYTES[off as usize] = b0 as i8
        DRV_ELF_BYTES[(off + 1) as usize] = b1 as i8
        DRV_ELF_BYTES[(off + 2) as usize] = b2 as i8
        DRV_ELF_BYTES[(off + 3) as usize] = b3 as i8
        DRV_ELF_BYTES[(off + 4) as usize] = b4 as i8
        DRV_ELF_BYTES[(off + 5) as usize] = b5 as i8
        DRV_ELF_BYTES[(off + 6) as usize] = b6 as i8
        DRV_ELF_BYTES[(off + 7) as usize] = b7 as i8
    }
}

fn drv_elf_pad_to(target: i64) with Mut, Panic, Div {
    var p = DRV_ELF_LEN
    while p < target && p < 1048576 {
        DRV_ELF_BYTES[p as usize] = 0 as i8
        p = p + 1
    }
    DRV_ELF_LEN = p
}

fn drv_elf_align8() with Mut, Panic, Div {
    let q = DRV_ELF_LEN / 8
    let r = DRV_ELF_LEN - (q * 8)
    if r != 0 { drv_elf_pad_to(DRV_ELF_LEN + (8 - r)) }
}

fn drv_elf_copy_code() with Mut, Panic, Div {
    var i: i64 = 0
    while i < DRV_CODE_LEN {
        drv_elf_emit_byte(DRV_CODE_BYTES[i as usize] as i64)
        i = i + 1
    }
}

fn drv_elf_copy_rodata() with Mut, Panic, Div {
    var i: i64 = 0
    while i < DRV_RODATA_LEN {
        drv_elf_emit_byte(DRV_RODATA_BYTES[i as usize] as i64)
        i = i + 1
    }
}

fn drv_elf_zero_bytes(count: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < count {
        drv_elf_emit_byte(0)
        i = i + 1
    }
}

fn drv_elf_emit_phdr(ptype: i64, flags: i64, off: i64, vaddr: i64, filesz: i64, memsz: i64) with Mut, Panic, Div {
    drv_elf_emit_u32(ptype)
    drv_elf_emit_u32(flags)
    drv_elf_emit_u64(off)
    drv_elf_emit_u64(vaddr)
    drv_elf_emit_u64(vaddr)
    drv_elf_emit_u64(filesz)
    drv_elf_emit_u64(memsz)
    drv_elf_emit_u64(4096)
}

fn drv_elf_emit_shdr(name: i64, stype: i64, flags: i64, addr: i64, off: i64, size: i64, align: i64) with Mut, Panic, Div {
    drv_elf_emit_u32(name)
    drv_elf_emit_u32(stype)
    drv_elf_emit_u64(flags)
    drv_elf_emit_u64(addr)
    drv_elf_emit_u64(off)
    drv_elf_emit_u64(size)
    drv_elf_emit_u32(0)
    drv_elf_emit_u32(0)
    drv_elf_emit_u64(align)
    drv_elf_emit_u64(0)
}

fn drv_elf_emit_shstrtab() with Mut, Panic, Div {
    drv_elf_emit_byte(0)
    // offset 1: .text\0
    drv_elf_emit_byte(46); drv_elf_emit_byte(116); drv_elf_emit_byte(101); drv_elf_emit_byte(120); drv_elf_emit_byte(116); drv_elf_emit_byte(0)
    // offset 7: .rodata\0
    drv_elf_emit_byte(46); drv_elf_emit_byte(114); drv_elf_emit_byte(111); drv_elf_emit_byte(100); drv_elf_emit_byte(97); drv_elf_emit_byte(116); drv_elf_emit_byte(97); drv_elf_emit_byte(0)
    // offset 15: .data\0
    drv_elf_emit_byte(46); drv_elf_emit_byte(100); drv_elf_emit_byte(97); drv_elf_emit_byte(116); drv_elf_emit_byte(97); drv_elf_emit_byte(0)
    // offset 21: .shstrtab\0
    drv_elf_emit_byte(46); drv_elf_emit_byte(115); drv_elf_emit_byte(104); drv_elf_emit_byte(115); drv_elf_emit_byte(116); drv_elf_emit_byte(114); drv_elf_emit_byte(116); drv_elf_emit_byte(97); drv_elf_emit_byte(98); drv_elf_emit_byte(0)
    // offset 31: .sounio.epistemic\0
    drv_elf_emit_byte(46); drv_elf_emit_byte(115); drv_elf_emit_byte(111); drv_elf_emit_byte(117)
    drv_elf_emit_byte(110); drv_elf_emit_byte(105); drv_elf_emit_byte(111); drv_elf_emit_byte(46)
    drv_elf_emit_byte(101); drv_elf_emit_byte(112); drv_elf_emit_byte(105); drv_elf_emit_byte(115)
    drv_elf_emit_byte(116); drv_elf_emit_byte(101); drv_elf_emit_byte(109); drv_elf_emit_byte(105)
    drv_elf_emit_byte(99); drv_elf_emit_byte(0)
}

fn drv_elf_emit_epistemic() with Mut, Panic, Div {
    // magic "SIEP" (Sounio Informational EPistemic)
    drv_elf_emit_byte(83); drv_elf_emit_byte(73); drv_elf_emit_byte(69); drv_elf_emit_byte(80)
    drv_elf_emit_u32(1)                 // version = 1
    drv_elf_emit_u64(EP_TOTAL_INSTR)    // total micro-IR instructions compiled across all functions
    drv_elf_emit_u64(EP_KNOWLEDGE_COUNT) // count of Knowledge<T> token occurrences in compiled source
}

fn drv_finalize_elf(output_path: string, data_len: i64) -> i64 with IO, Mut, Panic, Div {
    let base = 4194304
    let text_off = 4096
    let rodata_off = drv_align_page(text_off + DRV_CODE_LEN)
    let data_off = drv_align_page(rodata_off + DRV_RODATA_LEN)
    drv_apply_relocations(rodata_off, data_off)
    DRV_ELF_LEN = 0

    drv_elf_emit_byte(127); drv_elf_emit_byte(69); drv_elf_emit_byte(76); drv_elf_emit_byte(70)
    drv_elf_emit_byte(2); drv_elf_emit_byte(1); drv_elf_emit_byte(1); drv_elf_emit_byte(0)
    drv_elf_zero_bytes(8)
    drv_elf_emit_u16(2)
    drv_elf_emit_u16(62)
    drv_elf_emit_u32(1)
    drv_elf_emit_u64(base + text_off + DRV_ENTRY_OFFSET)
    drv_elf_emit_u64(64)
    let shoff_patch = DRV_ELF_LEN
    drv_elf_emit_u64(0)
    drv_elf_emit_u32(0)
    drv_elf_emit_u16(64)
    drv_elf_emit_u16(56)
    drv_elf_emit_u16(3)
    drv_elf_emit_u16(64)
    drv_elf_emit_u16(6)
    drv_elf_emit_u16(4)

    drv_elf_emit_phdr(1, 5, text_off, base + text_off, DRV_CODE_LEN, DRV_CODE_LEN)
    drv_elf_emit_phdr(1, 4, rodata_off, base + rodata_off, DRV_RODATA_LEN, DRV_RODATA_LEN)
    drv_elf_emit_phdr(1, 6, data_off, base + data_off, 0, data_len)

    drv_elf_pad_to(text_off)
    drv_elf_copy_code()
    drv_elf_pad_to(rodata_off)
    drv_elf_copy_rodata()
    drv_elf_pad_to(data_off)
    drv_elf_align8()
    let shstr_off = DRV_ELF_LEN
    drv_elf_emit_shstrtab()
    let shstr_size = DRV_ELF_LEN - shstr_off
    drv_elf_align8()
    let epistemic_off = DRV_ELF_LEN
    drv_elf_emit_epistemic()
    drv_elf_align8()
    let shoff = DRV_ELF_LEN
    drv_elf_patch_u64(shoff_patch, shoff)
    drv_elf_emit_shdr(0, 0, 0, 0, 0, 0, 0)
    drv_elf_emit_shdr(1, 1, 6, base + text_off, text_off, DRV_CODE_LEN, 16)
    drv_elf_emit_shdr(7, 1, 2, base + rodata_off, rodata_off, DRV_RODATA_LEN, 8)
    drv_elf_emit_shdr(15, 8, 3, base + data_off, data_off, data_len, 8)
    drv_elf_emit_shdr(21, 3, 0, 0, shstr_off, shstr_size, 1)
    drv_elf_emit_shdr(31, 1, 0, 0, epistemic_off, 24, 8)

    let wrote = driver_write_elf_to_file(output_path, DRV_ELF_LEN)
    if wrote < 0 { return -1 }
    if !driver_make_executable(output_path) { return -1 }
    return DRV_ELF_LEN
}

fn driver_write_elf_to_file(path: string, len: i64) -> i64 with IO, Mut, Panic, Div {
    if io_write_meg_binary(path, DRV_ELF_BYTES, len) { return len }
    return -1
}

fn driver_make_executable(path: string) -> bool with IO {
    return io_make_executable(path)
}

fn compile_ir_module_to_elf(output_path: string, token_count: i64) -> i64 with IO, Mut, Panic, Div, Alloc {
    let user_fn_count = V2_USER_FN_COUNT
    let main_fn_id = V2_FIRST_USER_FN_ID + user_fn_count
    let total_fn_count = main_fn_id + 1 + V2_CLOSURE_COUNT
    V2_DIRECT_KNOWLEDGE_GUARD_EMITTED = 0
    V2_ROW_STREAM_PAYLOAD_GUARD_EMITTED = 0

    drv_reset_codegen(total_fn_count)

    drv_emit_builtin_print_str(V2_BUILTIN_PRINT)
    drv_emit_builtin_print_int(V2_BUILTIN_PRINT_INT)
    drv_emit_builtin_print_char(V2_BUILTIN_PRINT_CHAR)
    if source_uses_ident(token_count, "driver_write_elf_to_file") {
        drv_emit_builtin_write_elf(V2_BUILTIN_DRIVER_WRITE_ELF)
        drv_emit_builtin_chmod(V2_BUILTIN_DRIVER_CHMOD)
    }
    let direct_knowledge_guard_count = native_v2_direct_knowledge_guard_count()
    let source_may_need_knowledge_guard = source_uses_ident(token_count, "Knowledge") && source_uses_ident(token_count, "where")
    if source_uses_ident(token_count, "assert") || direct_knowledge_guard_count > 0 || source_may_need_knowledge_guard {
        drv_emit_builtin_sys_exit_1(V2_BUILTIN_SYS_EXIT_1)
    }

    // Compile user-defined functions
    var ui: i64 = 0
    while ui < user_fn_count {
        let ufn_name_tok = V2_USER_FN_TOKEN_IDX[ui as usize]
        let ufn_id = V2_USER_FN_IDS[ui as usize]
        if !compile_user_fn(ufn_name_tok, ufn_id, token_count) {
            // M1.2 — surface the inner error behind user_fn_failed so the
            // parity-inventory cluster for this message is no longer opaque.
            print("native_compile: user_fn_failed fn_id=")
            print_int(ufn_id)
            print(" name=")
            print_token_text(ufn_name_tok)
            print(" index=")
            print_int(ui)
            print(" of=")
            print_int(user_fn_count)
            print("\n")
            return 3
        }
        EP_TOTAL_INSTR = EP_TOTAL_INSTR + V2_UFN_COUNT
        ui = ui + 1
    }

    var ci: i64 = 0
    while ci < V2_CLOSURE_COUNT {
        if !compile_closure_fn(ci) {
            print("native_compile: closure_failed index=")
            print_int(ci)
            print(" of=")
            print_int(V2_CLOSURE_COUNT)
            print("\n")
            return 3
        }
        EP_TOTAL_INSTR = EP_TOTAL_INSTR + V2_UFN_COUNT
        ci = ci + 1
    }

    let main_tok = find_ident_token_text(token_count, "main")
    if main_tok < 0 {
        print("native_compile: native_v2_unsupported fn=main\n")
        return 3
    }
    let main_ok = compile_user_fn(main_tok, main_fn_id, token_count)
    if !main_ok {
        print("native_compile: native_v2_unsupported fn=main\n")
        return 3
    }
    EP_TOTAL_INSTR = EP_TOTAL_INSTR + V2_UFN_COUNT
    EP_KNOWLEDGE_COUNT = source_count_ident(token_count, "Knowledge")

    drv_emit_entry_trampoline(main_fn_id)
    var data_len = 4096
    if source_uses_ident(token_count, "driver_lex_file_to_globals") {
        data_len = drv_driver_data_len()
    } else if USER_GLOBAL_DATA_LEN > 0 {
        // M1.2 step D — user-globals land in the .data BSS region (file-size
        // 0 in the PHDR, mem-size data_len), so the loader zero-fills all
        // declared slots. Round up to 8 for alignment and keep a minimum of
        // 4096 so very small user programs still get a full page.
        let aligned = (USER_GLOBAL_DATA_LEN + 7) / 8 * 8
        if aligned > data_len { data_len = aligned }
    }
    let elf_len = drv_finalize_elf(output_path, data_len)
    if elf_len < 0 {
        print("native_compile: write_error\n")
        return 5
    }

    print("native_compile: ok written=")
    print(output_path)
    print(" size=")
    print_int(elf_len)
    print("\n")
    if V2_DIRECT_KNOWLEDGE_GUARD_EMITTED > 0 {
        print("native_compile: knowledge_runtime_guards_direct=1 count=")
        print_int(V2_DIRECT_KNOWLEDGE_GUARD_EMITTED)
        print("\n")
    }
    if V2_ROW_STREAM_PAYLOAD_GUARD_EMITTED > 0 {
        print("native_compile: row_stream_payload_guards=1 count=")
        print_int(V2_ROW_STREAM_PAYLOAD_GUARD_EMITTED)
        print("\n")
    }
    0
}

fn driver_read_file_to_cursor_source(path: string) -> i64 with IO, Mut, Panic, Div {
    let size = file_size(path)
    let data = read_file(path)
    var n: i64 = size
    if n < 0 { n = 0 }
    if n > 1048576 { n = 1048576 }
    var i: i64 = 0
    while i < n {
        CURSOR_SOURCE[i as usize] = data[i as usize]
        i = i + 1
    }
    CURSOR_SOURCE_LEN = n
    n
}

fn driver_set_token_flat(idx: i64, kind: i64, start: i64, end: i64, int_value: i64) with Mut, Panic {
    PT_KIND_CODE[idx as usize] = kind
    PT_START[idx as usize] = start
    PT_END[idx as usize] = end
    PT_INT_VALUE[idx as usize] = int_value
}

fn driver_is_digit(ch: i8) -> bool {
    ch >= 48 as i8 && ch <= 57 as i8
}

fn driver_is_ident_start(ch: i8) -> bool {
    return (ch >= 65 as i8 && ch <= 90 as i8) || (ch >= 97 as i8 && ch <= 122 as i8) || ch == 95 as i8
}

fn driver_is_ident_continue(ch: i8) -> bool {
    driver_is_ident_start(ch) || driver_is_digit(ch)
}

fn driver_source_slice_eq_lit(start: i64, end: i64, text: string) -> bool with Mut, Panic, Div {
    let len = end - start
    if len != str_len(text) { return false }
    var i: i64 = 0
    while i < len {
        if CURSOR_SOURCE[(start + i) as usize] != (str_char_at(text, i) as i8) { return false }
        i = i + 1
    }
    true
}

fn driver_keyword_code(start: i64, end: i64) -> i64 with Mut, Panic, Div {
    if driver_source_slice_eq_lit(start, end, "use") { return TK_USE }
    if driver_source_slice_eq_lit(start, end, "fn") { return TK_FN }
    if driver_source_slice_eq_lit(start, end, "let") { return TK_LET }
    if driver_source_slice_eq_lit(start, end, "var") { return TK_VAR }
    if driver_source_slice_eq_lit(start, end, "type") { return 12 }
    if driver_source_slice_eq_lit(start, end, "struct") { return TK_STRUCT }
    if driver_source_slice_eq_lit(start, end, "enum") { return TK_ENUM }
    if driver_source_slice_eq_lit(start, end, "if") { return TK_IF }
    if driver_source_slice_eq_lit(start, end, "else") { return TK_ELSE }
    if driver_source_slice_eq_lit(start, end, "match") { return TK_MATCH }
    if driver_source_slice_eq_lit(start, end, "while") { return TK_WHILE }
    if driver_source_slice_eq_lit(start, end, "return") { return TK_RETURN }
    if driver_source_slice_eq_lit(start, end, "as") { return TK_AS }
    if driver_source_slice_eq_lit(start, end, "pub") { return 32 }
    if driver_source_slice_eq_lit(start, end, "true") { return TK_TRUE }
    if driver_source_slice_eq_lit(start, end, "false") { return TK_FALSE }
    if driver_source_slice_eq_lit(start, end, "with") { return 45 }
    return TK_IDENT
}

fn driver_punct_kind(ch: i8, c2: i8, c3: i8) -> i64 {
    if ch == 46 as i8 && c2 == 46 as i8 && c3 == 46 as i8 { return 172 }
    if ch == 46 as i8 && c2 == 46 as i8 && c3 == 61 as i8 { return 161 }
    if ch == 60 as i8 && c2 == 60 as i8 && c3 == 61 as i8 { return 166 }
    if ch == 62 as i8 && c2 == 62 as i8 && c3 == 61 as i8 { return 167 }
    if ch == 61 as i8 && c2 == 61 as i8 { return TK_EQEQ }
    if ch == 33 as i8 && c2 == 61 as i8 { return TK_BANGEQ }
    if ch == 60 as i8 && c2 == 61 as i8 { return TK_LE }
    if ch == 62 as i8 && c2 == 61 as i8 { return TK_GE }
    if ch == 38 as i8 && c2 == 38 as i8 { return TK_ANDAND }
    if ch == 124 as i8 && c2 == 124 as i8 { return TK_OROR }
    if ch == 60 as i8 && c2 == 60 as i8 { return 152 }
    if ch == 62 as i8 && c2 == 62 as i8 { return 153 }
    if ch == 43 as i8 && c2 == 61 as i8 { return 154 }
    if ch == 45 as i8 && c2 == 61 as i8 { return 155 }
    if ch == 42 as i8 && c2 == 61 as i8 { return 156 }
    if ch == 47 as i8 && c2 == 61 as i8 { return 157 }
    if ch == 37 as i8 && c2 == 61 as i8 { return 168 }
    if ch == 38 as i8 && c2 == 61 as i8 { return 170 }
    if ch == 124 as i8 && c2 == 61 as i8 { return 165 }
    if ch == 94 as i8 && c2 == 61 as i8 { return 169 }
    if ch == 45 as i8 && c2 == 62 as i8 { return TK_ARROW }
    if ch == 61 as i8 && c2 == 62 as i8 { return TK_FATARROW }
    if ch == 60 as i8 && c2 == 45 as i8 { return 171 }
    if ch == 38 as i8 && c2 == 33 as i8 { return TK_AMPBANG }
    if ch == 58 as i8 && c2 == 58 as i8 { return TK_COLONCOLON }
    if ch == 46 as i8 && c2 == 46 as i8 { return 160 }
    if ch == 43 as i8 && c2 == 43 as i8 { return 164 }
    if ch == 43 as i8 && c2 == 45 as i8 { return 173 }
    if ch == 43 as i8 { return TK_PLUS }
    if ch == 45 as i8 { return TK_MINUS }
    if ch == 42 as i8 { return TK_STAR }
    if ch == 47 as i8 { return TK_SLASH }
    if ch == 37 as i8 { return 136 }
    if ch == 61 as i8 { return TK_EQ }
    if ch == 60 as i8 { return TK_LT }
    if ch == 62 as i8 { return TK_GT }
    if ch == 33 as i8 { return TK_BANG }
    if ch == 38 as i8 { return 141 }
    if ch == 124 as i8 { return 142 }
    if ch == 94 as i8 { return 143 }
    if ch == 126 as i8 { return 144 }
    if ch == 63 as i8 { return 145 }
    if ch == 40 as i8 { return TK_LPAREN }
    if ch == 41 as i8 { return TK_RPAREN }
    if ch == 123 as i8 { return TK_LBRACE }
    if ch == 125 as i8 { return TK_RBRACE }
    if ch == 91 as i8 { return TK_LBRACKET }
    if ch == 93 as i8 { return TK_RBRACKET }
    if ch == 59 as i8 { return TK_SEMI }
    if ch == 58 as i8 { return TK_COLON }
    if ch == 44 as i8 { return TK_COMMA }
    if ch == 46 as i8 { return TK_DOT }
    if ch == 64 as i8 { return 184 }
    if ch == 35 as i8 { return 185 }
    if ch == 95 as i8 { return TK_UNDERSCORE }
    1
}

fn driver_punct_width(kind: i64) -> i64 {
    if kind == 161 || kind == 166 || kind == 167 || kind == 172 { return 3 }
    if kind == TK_EQEQ || kind == TK_BANGEQ || kind == TK_LE || kind == TK_GE { return 2 }
    if kind == TK_ANDAND || kind == TK_OROR || kind == TK_ARROW || kind == TK_FATARROW { return 2 }
    if kind == TK_AMPBANG || kind == TK_COLONCOLON { return 2 }
    if kind >= 152 && kind <= 160 { return 2 }
    if kind >= 164 && kind <= 171 { return 2 }
    if kind == 173 { return 2 }
    1
}

fn driver_lex_source_to_globals(n: i64) -> i64 with Mut, Panic, Div {
    CURSOR_SOURCE_LEN = n
    var pos: i64 = 0
    var tc: i64 = 0
    while pos < n {
        let ch = CURSOR_SOURCE[pos as usize]
        if ch == 32 as i8 || ch == 9 as i8 || ch == 10 as i8 || ch == 13 as i8 {
            pos = pos + 1
        } else if ch == 47 as i8 && pos + 1 < n && CURSOR_SOURCE[(pos + 1) as usize] == 47 as i8 {
            while pos < n && CURSOR_SOURCE[pos as usize] != 10 as i8 {
                pos = pos + 1
            }
        } else if driver_is_ident_start(ch) {
            let start = pos
            pos = pos + 1
            while pos < n && driver_is_ident_continue(CURSOR_SOURCE[pos as usize]) {
                pos = pos + 1
            }
            let kind_val = driver_keyword_code(start, pos)
            PT_KIND_CODE[tc as usize] = kind_val
            PT_START[tc as usize] = start
            PT_END[tc as usize] = pos
            PT_INT_VALUE[tc as usize] = 0
            tc = tc + 1
        } else if driver_is_digit(ch) {
            let start = pos
            var value: i64 = 0
            while pos < n && driver_is_digit(CURSOR_SOURCE[pos as usize]) {
                value = value * 10 + ((CURSOR_SOURCE[pos as usize] - 48 as i8) as i64)
                pos = pos + 1
            }
            PT_KIND_CODE[tc as usize] = TK_INT
            PT_START[tc as usize] = start
            PT_END[tc as usize] = pos
            PT_INT_VALUE[tc as usize] = value
            tc = tc + 1
        } else if ch == 34 as i8 {
            let start = pos
            pos = pos + 1
            while pos < n && CURSOR_SOURCE[pos as usize] != 34 as i8 {
                if CURSOR_SOURCE[pos as usize] == 92 as i8 && pos + 1 < n {
                    pos = pos + 2
                } else {
                    pos = pos + 1
                }
            }
            if pos < n && CURSOR_SOURCE[pos as usize] == 34 as i8 { pos = pos + 1 }
            PT_KIND_CODE[tc as usize] = TK_STRING
            PT_START[tc as usize] = start
            PT_END[tc as usize] = pos
            PT_INT_VALUE[tc as usize] = 0
            tc = tc + 1
        } else {
            let start = pos
            var c2: i8 = 0 as i8
            var c3: i8 = 0 as i8
            if pos + 1 < n { c2 = CURSOR_SOURCE[(pos + 1) as usize] }
            if pos + 2 < n { c3 = CURSOR_SOURCE[(pos + 2) as usize] }
            let kind = driver_punct_kind(ch, c2, c3)
            let width = driver_punct_width(kind)
            PT_KIND_CODE[tc as usize] = kind
            PT_START[tc as usize] = start
            PT_END[tc as usize] = start + width
            PT_INT_VALUE[tc as usize] = 0
            tc = tc + 1
            pos = pos + width
        }
    }
    PT_KIND_CODE[tc as usize] = TK_EOF
    PT_START[tc as usize] = pos
    PT_END[tc as usize] = pos
    PT_INT_VALUE[tc as usize] = 0
    return tc
}

fn driver_lex_file_to_globals(path: string) -> i64 with IO, Mut, Panic, Div {
    let n = driver_read_file_to_cursor_source(path)
    if n <= 0 { return 0 }
    return driver_lex_source_to_globals(n)
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    if argc < 1 {
        print("native_compile: usage: native_compile_driver.sio <source.sio> [-o <output>]\n")
        print("native_compile: usage: native_compile_driver.sio <source.sio> <output>\n")
        return 1
    }

    let source_path = get_arg(0)
    var output_path = "a.out"
    if argc >= 3 {
        let flag = get_arg(1)
        if flag == "-o" {
            output_path = get_arg(2)
        }
    }
    if argc == 2 {
        let arg1 = get_arg(1)
        if arg1 != "-o" {
            output_path = arg1
        }
    }

    drv_precompute_knowledge_guard_step_walk(source_path)
    var token_count = driver_lex_file_to_globals(source_path)
    if token_count <= 0 {
        print("native_compile: lex_error\n")
        return 1
    }
    V2_TOKEN_COUNT = token_count
    scan_struct_decls(token_count)
    drv_hydrate_knowledge_guard_row_stream_payloads(source_path)
    token_count = driver_lex_file_to_globals(source_path)
    if token_count <= 0 {
        print("native_compile: lex_error\n")
        return 1
    }
    V2_TOKEN_COUNT = token_count
    scan_struct_decls(token_count)
    scan_enum_decls(token_count)
    scan_user_globals(token_count)
    scan_user_fns(token_count, V2_FIRST_USER_FN_ID)
    scan_closure_literals(token_count)
    return compile_ir_module_to_elf(output_path, token_count)
}
