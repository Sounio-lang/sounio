// self-hosted::compiler::native_compile_driver
//
// Native-v2 scalar compiler driver for the serious self-hosted path.
// This driver owns the fragile generated front-end boundary: it lexes through
// lexer::mod, reads token kind codes from parser scalar storage, builds core IR
// directly, then feeds the existing native-v2 Machine IR and ELF pipeline.
//
// Usage:
//   souc run self-hosted/compiler/native_compile_driver.sio -- <source.sio> [-o <output>]
//   souc run self-hosted/compiler/native_compile_driver.sio -- <source.sio> <output>

use lexer::mod::{lex_file_to_globals}
use lexer::cursor::*
use knowledge_runtime_guard_lowering_plan::{
    knowledge_runtime_guard_lowering_plan_build,
    knowledge_runtime_guard_lowering_plan_row_at,
    knowledge_runtime_guard_native_emission_plan_at,
    knowledge_runtime_guard_native_emission_step_from_plan,
}
use parser::ast::{Name, BinaryOp, make_name, empty_name, name_eq}
use parser::parser::{pt_read_kind_code, pt_read_start, pt_read_end, pt_read_int_value}
use ir::ir::*
use io::file_write::*
use native::elf::{string_table_new}
use native::elf_bulk::*
use native::frame::*
use native::machine_ir::*
use native::runtime_context::*
use native::codegen_x86_linux::{
    compile_ir_function_v2_from_ir_into,
    compile_ir_function_v2_core_ir_into,
    compile_module_streaming_begin_count_into,
    compile_module_streaming_finish_main_rodata_len_into,
    native_v2_core_begin_function_from_ir_into,
    native_v2_core_emit_load_imm_into,
    native_v2_core_emit_load_string_offset_into,
    native_v2_rodata_append_byte_into,
    native_v2_rodata_len_into,
    native_v2_core_emit_binop_code_into,
    native_v2_core_emit_call1_into,
    native_v2_core_emit_return_into,
    native_v2_core_begin_fn_spill_into,
    native_v2_core_emit_any_binop_into,
    native_v2_core_define_label_into,
    native_v2_core_emit_jump_to_label_into,
    native_v2_core_emit_branch_false_to_label_into,
    native_v2_core_patch_labels_into,
    native_v2_core_emit_copy_into,
    native_v2_core_emit_call_argc_into,
    native_v2_core_emit_return_struct_into,
    native_v2_core_emit_rdx_to_temp_into,
    native_v2_emit_get_arg_count_function_into,
    native_v2_emit_get_arg_function_into,
    native_v2_emit_print_function_into,
    native_v2_emit_print_int_function_into,
    native_v2_emit_print_char_function_into,
    native_v2_core_emit_arg_count_into,
    native_v2_core_emit_get_arg_into,
    native_v2_core_emit_str_len_into,
    native_v2_core_emit_str_char_at_into,
    native_v2_core_emit_str_eq_into,
    native_v2_core_emit_driver_read_file_to_globals_into,
    native_v2_core_emit_temp_addr_into,
    native_v2_core_emit_load_ref_field_into,
    native_v2_core_emit_store_ref_field_into,
    native_v2_core_emit_driver_global_load_into,
    native_v2_core_emit_driver_global_store_into,
    native_v2_driver_state_data_len,
}

let TK_EOF: i64 = 0
let TK_FN: i64 = 7
let TK_LET: i64 = 8
let TK_VAR: i64 = 9
let TK_IF: i64 = 20
let TK_ELSE: i64 = 21
let TK_WHILE: i64 = 24
let TK_RETURN: i64 = 28
let TK_NEWLINE: i64 = 2
let TK_IDENT: i64 = 123
let TK_INT: i64 = 124
let TK_FLOAT: i64 = 125
let TK_STRING: i64 = 126
let TK_PLUS: i64 = 132
let TK_MINUS: i64 = 133
let TK_STAR: i64 = 134
let TK_SLASH: i64 = 135
let TK_EQ: i64 = 137
let TK_AMP: i64 = 141
let TK_AMPBANG: i64 = 163
let TK_LT: i64 = 138
let TK_GT: i64 = 139
let TK_SHL: i64 = 152
let TK_SHR: i64 = 153
let TK_DOTDOT: i64 = 160
let TK_PLUSPLUS: i64 = 164
let TK_OREQ: i64 = 165
let TK_PCTEQ: i64 = 168
let TK_XOREQ: i64 = 169
let TK_AMPEQ: i64 = 170
let TK_LARROW: i64 = 171
let TK_EQEQ: i64 = 146
let TK_BANGEQ: i64 = 147
let TK_LE: i64 = 148
let TK_GE: i64 = 149
let TK_ANDAND: i64 = 150
let TK_OROR: i64 = 151
let TK_BANG: i64 = 140
let TK_ARROW: i64 = 158
let TK_LPAREN: i64 = 174
let TK_RPAREN: i64 = 175
let TK_LBRACE: i64 = 176
let TK_RBRACE: i64 = 177
let TK_LBRACKET: i64 = 178
let TK_RBRACKET: i64 = 179
let TK_SEMI: i64 = 180
let TK_COLON: i64 = 181
let TK_COMMA: i64 = 182
let TK_DOT: i64 = 183
let TK_USE: i64 = 5
let TK_STRUCT: i64 = 13
let TK_ENUM: i64 = 14
let TK_AS: i64 = 30
let TK_TRUE: i64 = 35
let TK_FALSE: i64 = 36
let TK_COLONCOLON: i64 = 162
let TK_MATCH: i64 = 22
let TK_FATARROW: i64 = 159
let TK_UNDERSCORE: i64 = 186
let TK_PCT: i64 = 136
let TK_OR: i64 = 142
let TK_XOR: i64 = 143
let TK_TILDE: i64 = 144

var V2_LOCAL_TOK_IDX: [i64; 64] = [0; 64]
var V2_LOCAL_REGS: [i64; 64] = [0; 64]
var V2_LOCAL_STRUCT_IDX: [i64; 64] = [0; 64]
var V2_LOCAL_IS_REF: [i64; 64] = [0; 64]
var V2_LOCAL_ALEN: [i64; 64] = [0; 64]
var V2_LOCAL_IS_BSS: [i64; 64] = [0; 64]
var V2_LOCAL_BSS_IDX: [i64; 64] = [0; 64]
var V2_LOCAL_KNOWLEDGE_GUARD_ENABLED: [i64; 64] = [0; 64]
var V2_LOCAL_KNOWLEDGE_GUARD_COUNT: [i64; 64] = [0; 64]
var V2_LOCAL_KNOWLEDGE_GUARD_FIELD_OFFSET: [i64; 64] = [0; 64]
var V2_LOCAL_KNOWLEDGE_GUARD_CMP_CODE: [i64; 64] = [0; 64]
var V2_LOCAL_KNOWLEDGE_GUARD_THRESHOLD: [i64; 64] = [0; 64]
var V2_LOCAL_KNOWLEDGE_GUARD_TYPE_STRUCT_IDX: [i64; 64] = [0; 64]
var V2_LOCAL_KNOWLEDGE_GUARD_ROW_FIELD_OFFSET: [i64; 256] = [0; 256]
var V2_LOCAL_KNOWLEDGE_GUARD_ROW_CMP_CODE: [i64; 256] = [0; 256]
var V2_LOCAL_KNOWLEDGE_GUARD_ROW_THRESHOLD: [i64; 256] = [0; 256]
var V2_LOCAL_KNOWLEDGE_GUARD_ROW_THRESHOLD_SCALE: [i64; 256] = [0; 256]
var V2_LOCAL_KNOWLEDGE_GUARD_ROW_THRESHOLD_KIND: [i64; 256] = [0; 256]
var V2_LOCAL_COUNT: i64 = 0
var V2_NEXT_REG: i64 = 0
var V2_BREAK_LABEL: i64 = -1
var V2_CONTINUE_LABEL: i64 = -1

// User function registry: names → fn_ids, for resolving calls
// Store token indices (not Name structs) because JIT can't write structs to global arrays
var V2_USER_FN_TOKEN_IDX: [i64; 512] = [0; 512]
var V2_USER_FN_IDS: [i64; 512] = [0; 512]
var V2_USER_FN_COUNT: i64 = 0

// Per-function label counter (reset per user function)
var V2_NEXT_LABEL: i64 = 0

let V2_BUILTIN_PRINT: i64 = 0
let V2_BUILTIN_PRINT_INT: i64 = 1
let V2_BUILTIN_PRINT_CHAR: i64 = 2
let V2_BUILTIN_ARG_COUNT: i64 = 3
let V2_BUILTIN_GET_ARG: i64 = 4
let V2_BUILTIN_STR_EQ: i64 = 5
let V2_BUILTIN_STR_LEN: i64 = 6
let V2_BUILTIN_STR_CHAR_AT: i64 = 7
let V2_BUILTIN_PT_READ_KIND_CODE: i64 = 8
let V2_BUILTIN_PT_READ_START: i64 = 9
let V2_BUILTIN_PT_READ_END: i64 = 10
let V2_BUILTIN_PT_READ_INT_VALUE: i64 = 11
let V2_BUILTIN_EMPTY_NAME: i64 = 12
let V2_BUILTIN_DRIVER_READ_FILE_TO_GLOBALS: i64 = 13
let V2_BUILTIN_DRIVER_WRITE_ELF: i64 = 14
let V2_BUILTIN_DRIVER_CHMOD: i64 = 15
let V2_BUILTIN_PRINT_F64: i64 = 16
let V2_BUILTIN_SQRT_F64: i64 = 17
// println is expanded at parse time into the appropriate typed print + a
// trailing print_char(10). See parse_fn_call_ir and M1.2 step 2 (redo).
let V2_BUILTIN_PRINTLN: i64 = 18
// assert is expanded inline: if cond==0, call sys_exit_1 (id 20); else skip.
let V2_BUILTIN_ASSERT: i64 = 19
let V2_BUILTIN_SYS_EXIT_1: i64 = 20
// measure(v, uncertainty: u) → Knowledge<f64>{value, uncertainty}
// Handled entirely at parse time: allocates 2 contiguous f64 registers.
let V2_BUILTIN_MEASURE: i64 = 21
let V2_BUILTIN_HEAP_ALLOC: i64 = 22
let V2_BUILTIN_HEAP_FREE: i64 = 23
let V2_BUILTIN_READ_I64: i64 = 24
let V2_BUILTIN_WRITE_I64: i64 = 25
let V2_BUILTIN_HEAP_REALLOC: i64 = 26
let V2_BUILTIN_INDIRECT_CALL: i64 = 27
// gpu_thread_id_x() / gpu_block_dim_x() / gpu_barrier() / etc. are GPU thread
// intrinsics that lean_single emits as x86 stub instructions. On the N-v2 CPU
// path, kernel fn bodies are compiled but never executed (runtime skips when
// no GPU). Treat all 12 GPU intrinsics as a single zero-arg builtin that
// parse-time expands to load_imm 0 — the kernel body becomes dead-but-valid
// code, and the runtime never runs it on CPU-only hosts.
let V2_BUILTIN_GPU_INTRINSIC: i64 = 28
// IEEE-754 reinterprets — identity at the machine level (see
// emit_builtin_f64_bits_identity). Registered so their calls resolve to the
// builtin stub instead of defaulting to fn 0 (the runtime entry) and crashing.
let V2_BUILTIN_F64_TO_BITS: i64 = 29
let V2_BUILTIN_BITS_TO_F64: i64 = 30
let V2_FIRST_USER_FN_ID: i64 = 32

// V2_UFN_* — user fn instruction recording (scalar, bypasses broken IrInstr struct writes)
let UFN_LOAD_IMM: i64 = 1
let UFN_BINOP: i64 = 2
let UFN_LABEL: i64 = 3
let UFN_JUMP: i64 = 4
let UFN_BRANCH_FALSE: i64 = 5
let UFN_RETURN: i64 = 6
let UFN_CALL: i64 = 7
let UFN_COPY: i64 = 8
let UFN_RETURN_STRUCT: i64 = 9
let UFN_CALL_STRUCT_RESULT: i64 = 10
let UFN_LOAD_STRING: i64 = 11
let UFN_TEMP_ADDR: i64 = 12
let UFN_LOAD_REF_FIELD: i64 = 13
let UFN_STORE_REF_FIELD: i64 = 14
let UFN_GLOBAL_LOAD: i64 = 15
let UFN_GLOBAL_STORE: i64 = 16
let UFN_LOCAL_LOAD: i64 = 17
let UFN_LOCAL_STORE: i64 = 18
let UFN_LOAD_F64_SCALED: i64 = 19
let UFN_F64_BINOP: i64 = 20
// M1.2 step D — user-global array access (top-level `var NAME: [T; N]`).
// Reads/writes are lowered via a rip-relative lea into .data + rbx*8 index.
let UFN_USER_GLOBAL_LOAD: i64 = 21
let UFN_USER_GLOBAL_STORE: i64 = 22
// Pointer-based array element load: dst = *(ptr_reg_value + idx * 8)
let UFN_REF_ARRAY_LOAD: i64 = 23
// Pointer-based array element store: *(ptr_reg_value - idx * 8) = val
let UFN_REF_ARRAY_STORE: i64 = 24
// Integer-to-float conversion: cvtsi2sd xmm0, rax; store to dst
let UFN_CVT_I64_TO_F64: i64 = 25
// Float-to-integer conversion (truncation): cvttsd2si rax, xmm0; store to dst
let UFN_CVT_F64_TO_I64: i64 = 26
// Array fill: rep stosq loop; DST=base_reg, SRC1=val_reg, IMM=count
let UFN_ARRAY_FILL: i64 = 27
// Bulk copy: rep movsq loop; DST=dst_base, SRC1=src_base, IMM=count
let UFN_BULK_COPY: i64 = 28
// User-global base address: lea rax, [rip + bss_offset]; DST=dst_reg, IMM=ug_idx
let UFN_USER_GLOBAL_BASE: i64 = 29

var V2_UFN_OPS: [i64; 4096] = [0; 4096]
var V2_UFN_DST: [i64; 4096] = [0; 4096]
var V2_UFN_SRC1: [i64; 4096] = [0; 4096]
var V2_UFN_SRC2: [i64; 4096] = [0; 4096]
var V2_UFN_IMM: [i64; 4096] = [0; 4096]
var V2_UFN_LABEL_ID: [i64; 4096] = [0; 4096]
var V2_UFN_BINOP_CODE: [i64; 4096] = [0; 4096]
var V2_UFN_FN_ID: [i64; 4096] = [0; 4096]
var V2_UFN_RESULT_FCOUNT: [i64; 4096] = [0; 4096]
var V2_UFN_STR_START: [i64; 4096] = [0; 4096]
var V2_UFN_STR_END: [i64; 4096] = [0; 4096]
var V2_UFN_FLOAT_SCALE: [i64; 4096] = [0; 4096]
var V2_UFN_COUNT: i64 = 0
var V2_PARSE_UNSUPPORTED: i64 = 0
var V2_PARSE_UNSUPPORTED_TOKEN: i64 = -1
var V2_PARSE_UNSUPPORTED_KIND: i64 = -1
var V2_PARSE_UNSUPPORTED_REASON: i64 = 0

// Token count of the current source file — needed by struct-literal parser
var V2_TOKEN_COUNT: i64 = 0

// Temporary storage for multi-arg call parsing (up to 8 args)
var V2_CALL_ARG_REGS: [i64; 8] = [0; 8]
var V2_CALL_ARG_SIZES: [i64; 8] = [0; 8]
var V2_CURRENT_PARAM_REGS: [i64; 64] = [0; 64]
var V2_CURRENT_PARAM_COUNT: i64 = 0
var V2_REG_IS_F64: [i64; 4096] = [0; 4096]
// SRET: when the current function returns a struct with > 6 flat registers,
// rdi holds a hidden pointer to the caller's result buffer. V2_CURRENT_FN_SRET
// is set before drv_begin_function is called; V2_CURRENT_FN_SRET_VREG is the
// virtual register that holds the saved SRET pointer in the callee.
var V2_CURRENT_FN_SRET: i64 = 0
var V2_CURRENT_FN_SRET_VREG: i64 = -1

// M1.2 step D — user-global registry. Top-level `var NAME: [T; N]` decls
// (NAME not in the driver's hard-coded global table) land here. Each slot
// records the identifier token, the byte offset into .data, the element
// count, and whether the element type is f64.
var USER_GLOBAL_NAME_TOK: [i64; 64] = [0; 64]
var USER_GLOBAL_DATA_OFFSET: [i64; 64] = [0; 64]
var USER_GLOBAL_ELEM_COUNT: [i64; 64] = [0; 64]
var USER_GLOBAL_IS_F64: [i64; 64] = [0; 64]
var USER_GLOBAL_COUNT: i64 = 0
var USER_GLOBAL_DATA_LEN: i64 = 0

// Native-v2 driver code buffer. The #78/#79/#80 compiler feature stack now
// emits slightly more than the old 256 KiB ceiling when self-compiling the
// driver, so keep the text buffer inside the existing 1 MiB global slot but
// leave real headroom for composed frontend work.
var DRV_CODE_BYTES: [i8; 524288] = [0; 524288]
var DRV_CODE_LEN: i64 = 0
var DRV_RODATA_BYTES: [i8; 65536] = [0; 65536]
var DRV_RODATA_LEN: i64 = 0
var DRV_RELOC_OFFSETS: [i64; 8192] = [0; 8192]
var DRV_RELOC_KIND: [i64; 8192] = [0; 8192]
var DRV_RELOC_TARGETS: [i64; 8192] = [0; 8192]
var DRV_RELOC_COUNT: i64 = 0
var DRV_FN_OFFSETS: [i64; 2048] = [0; 2048]
var DRV_FN_COUNT: i64 = 0
var DRV_ENTRY_OFFSET: i64 = 0
// M1.2 R2.2 — bumped from 256 to 1024. The 10 new TK_* resolver
// entries added in this commit-set push driver_const_value_tok past
// the 256-label threshold; the original tables silently dropped
// patches and stage1 mis-compiled hello.sio (42 → 76/78). Same root
// cause as PR #53's `21+21=78` bug. Bumping these arrays is the
// surgical fix; the rest of PR #53 (USER_GLOBAL_* slots,
// scan_user_globals scaffold) stays reverted pending separate
// diagnosis of the BSS-corruption bug it introduced.
var DRV_LABEL_OFFSETS: [i64; 1024] = [0; 1024]
var DRV_LABEL_PATCH_OFFSETS: [i64; 1024] = [0; 1024]
var DRV_LABEL_PATCH_IDS: [i64; 1024] = [0; 1024]
var DRV_LABEL_PATCH_COUNT: i64 = 0
var DRV_ELF_LEN: i64 = 0
var DRV_ELF_BYTES: [i8; 1048576] = [0; 1048576]
var EP_TOTAL_INSTR: i64 = 0
var EP_KNOWLEDGE_COUNT: i64 = 0   // count of Knowledge<T> token occurrences in compiled source

// Struct layout table (flat parallel arrays, capacity 16 structs / 128 total fields)
var STRUCT_NAME_TOKS: [i64; 16] = [0; 16]
var STRUCT_FIELD_START: [i64; 16] = [0; 16]
var STRUCT_FIELD_COUNT: [i64; 16] = [0; 16]
var STRUCT_FLAT_SIZE: [i64; 16] = [0; 16]       // flattened register count per struct
var STRUCT_COUNT: i64 = 0
var STRUCT_FIELDS: [i64; 128] = [0; 128]
var STRUCT_FIELD_TOTAL: i64 = 0
var STRUCT_FIELD_STRUCT_IDX: [i64; 128] = [0; 128]   // struct type of each field (-1 = scalar)
var STRUCT_FIELD_ARRAY_SIZE: [i64; 128] = [0; 128]   // N for [T; N] array fields (0 = not array)
var STRUCT_FIELD_FLAT_OFFSET: [i64; 128] = [0; 128]  // flat vreg offset of each field
var STRUCT_FIELD_IS_F64: [i64; 128] = [0; 128]
var STRUCT_FIELD_GENERIC_F64: [i64; 128] = [0; 128]

// Enum layout table (capacity 16 enums / 128 total variants)
var ENUM_NAME_TOKS: [i64; 16] = [0; 16]
var ENUM_VARIANT_START: [i64; 16] = [0; 16]
var ENUM_VARIANT_COUNT: [i64; 16] = [0; 16]
var ENUM_COUNT: i64 = 0
var ENUM_VARIANTS: [i64; 128] = [0; 128]
var ENUM_VARIANT_TOTAL: i64 = 0

// User fn return struct index (-1 = scalar return)
var V2_USER_FN_RETURN_STRUCT_IDX: [i64; 512] = [0; 512]
var V2_USER_FN_RETURN_IS_F64: [i64; 512] = [0; 512]
var V2_USER_FN_RETURN_ARR_SIZE: [i64; 512] = [0; 512]
// First direct native Knowledge<T> guard slice: integer proof-context guards
// at call boundaries and returned values, with up to four conjunctive rows.
// Assignment-site local guards use the parallel V2_LOCAL_KNOWLEDGE_GUARD_* table above.
var V2_USER_FN_KNOWLEDGE_GUARD_ENABLED: [i64; 512] = [0; 512]
var V2_USER_FN_KNOWLEDGE_GUARD_SITE: [i64; 512] = [0; 512]
var V2_USER_FN_KNOWLEDGE_GUARD_COUNT: [i64; 512] = [0; 512]
var V2_USER_FN_KNOWLEDGE_GUARD_FIELD_TOK: [i64; 512] = [0; 512]
var V2_USER_FN_KNOWLEDGE_GUARD_FIELD_OFFSET: [i64; 512] = [0; 512]
var V2_USER_FN_KNOWLEDGE_GUARD_CMP_CODE: [i64; 512] = [0; 512]
var V2_USER_FN_KNOWLEDGE_GUARD_THRESHOLD: [i64; 512] = [0; 512]
var V2_USER_FN_KNOWLEDGE_GUARD_TYPE_STRUCT_IDX: [i64; 512] = [0; 512]
var V2_USER_FN_KNOWLEDGE_GUARD_ROW_FIELD_OFFSET: [i64; 2048] = [0; 2048]
var V2_USER_FN_KNOWLEDGE_GUARD_ROW_CMP_CODE: [i64; 2048] = [0; 2048]
var V2_USER_FN_KNOWLEDGE_GUARD_ROW_THRESHOLD: [i64; 2048] = [0; 2048]
var V2_USER_FN_KNOWLEDGE_GUARD_ROW_THRESHOLD_SCALE: [i64; 2048] = [0; 2048]
var V2_USER_FN_KNOWLEDGE_GUARD_ROW_THRESHOLD_KIND: [i64; 2048] = [0; 2048]
var V2_DIRECT_KNOWLEDGE_GUARD_EMITTED: i64 = 0

// Row-stream step-walk backend: set by drv_precompute_knowledge_guard_step_walk before
// driver_lex_file_to_globals. When true, all Knowledge<T> guard emissions use the
// 7-step sequence driven by the lowering plan's native emission API.
var V2_ROW_STREAM_READY: bool = false
var V2_ROW_STREAM_BACKEND_COUNT: i64 = 0
var V2_ROW_STREAM_PAYLOAD_READY: bool = false
var V2_ROW_STREAM_PAYLOAD_COUNT: i64 = 0
var V2_ROW_STREAM_PAYLOAD_THRESHOLD_COUNT: i64 = 0
var V2_ROW_STREAM_PAYLOAD_GUARD_EMITTED: i64 = 0
var V2_ROW_STREAM_ROW_READY: [i64; 256] = [0; 256]
var V2_ROW_STREAM_ROW_THRESHOLD_READY: [i64; 256] = [0; 256]
var V2_ROW_STREAM_ROW_SITE_KIND: [i64; 256] = [0; 256]
var V2_ROW_STREAM_ROW_TYPE_STRUCT_IDX: [i64; 256] = [0; 256]
var V2_ROW_STREAM_ROW_FIELD_OFFSET: [i64; 256] = [0; 256]
var V2_ROW_STREAM_ROW_CMP_CODE: [i64; 256] = [0; 256]
var V2_ROW_STREAM_ROW_THRESHOLD: [i64; 256] = [0; 256]
var V2_ROW_STREAM_ROW_THRESHOLD_SCALE: [i64; 256] = [0; 256]
var V2_ROW_STREAM_ROW_THRESHOLD_KIND: [i64; 256] = [0; 256]
// Step-op pre-computed from step_at(i,j): op_kind for each of up to 10 steps per row.
// Flat layout: slot = row_idx * 10 + step_idx. Populated during hydration.
var V2_ROW_STREAM_ROW_STEP_COUNT: [i64; 256] = [0; 256]
var V2_ROW_STREAM_STEP_OP: [i64; 2560] = [0; 2560]

// Non-capturing closure literals are lowered to generated native-v2 functions.
var V2_CLOSURE_START_TOK: [i64; 128] = [0; 128]
var V2_CLOSURE_BODY_START: [i64; 128] = [0; 128]
var V2_CLOSURE_BODY_END: [i64; 128] = [0; 128]
var V2_CLOSURE_PARAM_START: [i64; 128] = [0; 128]
var V2_CLOSURE_PARAM_COUNT: [i64; 128] = [0; 128]
var V2_CLOSURE_FN_IDS: [i64; 128] = [0; 128]
var V2_CLOSURE_RETURN_IS_F64: [i64; 128] = [0; 128]
var V2_CLOSURE_PARAM_NAME_TOK: [i64; 512] = [0; 512]
var V2_CLOSURE_PARAM_IS_F64: [i64; 512] = [0; 512]
var V2_CLOSURE_PARAM_TOTAL: i64 = 0
var V2_CLOSURE_COUNT: i64 = 0

// Sideband written by parse_struct_lit/parse_struct_lit_ir so callers can record struct type
var V2_LAST_STRUCT_IDX: i64 = -1
// Sideband set when a fn-call returns [T; N] — consumed by let-binding
var V2_LAST_ARR_LEN: i64 = 0

let V2_GLOBAL_PT_KIND_CODE: i64 = 43
let V2_GLOBAL_PT_START: i64 = 44
let V2_GLOBAL_PT_END: i64 = 45
let V2_GLOBAL_PT_INT_VALUE: i64 = 46
let V2_GLOBAL_CURSOR_SOURCE: i64 = 47
let V2_GLOBAL_CURSOR_SOURCE_LEN: i64 = 48
let V2_GLOBAL_TOKEN_COUNT: i64 = 49
let V2_GLOBAL_PARSE_UNSUPPORTED_REASON: i64 = 50
let V2_GLOBAL_CURRENT_PARAM_REGS: i64 = 51
let V2_GLOBAL_CURRENT_PARAM_COUNT: i64 = 52
let V2_GLOBAL_DRV_CODE_BYTES: i64 = 53
let V2_GLOBAL_DRV_CODE_LEN: i64 = 54
let V2_GLOBAL_DRV_RODATA_BYTES: i64 = 55
let V2_GLOBAL_DRV_RODATA_LEN: i64 = 56
let V2_GLOBAL_DRV_RELOC_OFFSETS: i64 = 57
let V2_GLOBAL_DRV_RELOC_KIND: i64 = 58
let V2_GLOBAL_DRV_RELOC_TARGETS: i64 = 59
let V2_GLOBAL_DRV_RELOC_COUNT: i64 = 60
let V2_GLOBAL_DRV_FN_OFFSETS: i64 = 61
let V2_GLOBAL_DRV_FN_COUNT: i64 = 62
let V2_GLOBAL_DRV_ENTRY_OFFSET: i64 = 63
let V2_GLOBAL_DRV_LABEL_OFFSETS: i64 = 64
let V2_GLOBAL_DRV_LABEL_PATCH_OFFSETS: i64 = 65
let V2_GLOBAL_DRV_LABEL_PATCH_IDS: i64 = 66
let V2_GLOBAL_DRV_LABEL_PATCH_COUNT: i64 = 67
let V2_GLOBAL_DRV_ELF_BYTES: i64 = 68
let V2_GLOBAL_DRV_ELF_LEN: i64 = 69
let V2_GLOBAL_UFN_FLOAT_SCALE: i64 = 74
let V2_GLOBAL_REG_IS_F64: i64 = 75
let V2_GLOBAL_STRUCT_FIELD_IS_F64: i64 = 76
let V2_GLOBAL_USER_FN_RETURN_IS_F64: i64 = 77
let V2_GLOBAL_STRUCT_FIELD_GENERIC_F64: i64 = 78
let V2_GLOBAL_EP_TOTAL_INSTR: i64 = 79
let V2_GLOBAL_EP_KNOWLEDGE_COUNT: i64 = 80
// M1.2 step D — USER_GLOBAL_* driver-internal registry. Hard-coded here so
// that when the driver self-compiles, references to USER_GLOBAL_NAME_TOK /
// USER_GLOBAL_COUNT / etc. inside scan_user_globals + user_global_id_tok
// resolve through the existing drv_emit_driver_global_{load,store} path
// rather than mis-routing as user-program globals. User programs do not
// use these slots.
let V2_GLOBAL_USER_GLOBAL_NAME_TOK: i64 = 81
let V2_GLOBAL_USER_GLOBAL_DATA_OFFSET: i64 = 82
let V2_GLOBAL_USER_GLOBAL_ELEM_COUNT: i64 = 83
let V2_GLOBAL_USER_GLOBAL_IS_F64: i64 = 84
let V2_GLOBAL_USER_GLOBAL_COUNT: i64 = 85
let V2_GLOBAL_USER_GLOBAL_DATA_LEN: i64 = 86
let V2_GLOBAL_STRUCT_FIELD_ARRAY_SIZE: i64 = 87
let V2_GLOBAL_CURRENT_FN_SRET: i64 = 88
let V2_GLOBAL_CURRENT_FN_SRET_VREG: i64 = 89
let V2_GLOBAL_LAST_ARR_LEN: i64 = 90
let V2_GLOBAL_CLOSURE_START_TOK: i64 = 91
let V2_GLOBAL_CLOSURE_BODY_START: i64 = 92
let V2_GLOBAL_CLOSURE_BODY_END: i64 = 93
let V2_GLOBAL_CLOSURE_PARAM_START: i64 = 94
let V2_GLOBAL_CLOSURE_PARAM_COUNT: i64 = 95
let V2_GLOBAL_CLOSURE_FN_IDS: i64 = 96
let V2_GLOBAL_CLOSURE_RETURN_IS_F64: i64 = 97
let V2_GLOBAL_CLOSURE_PARAM_NAME_TOK: i64 = 98
let V2_GLOBAL_CLOSURE_PARAM_IS_F64: i64 = 99
let V2_GLOBAL_CLOSURE_PARAM_TOTAL: i64 = 100
let V2_GLOBAL_CLOSURE_COUNT: i64 = 101
let V2_GLOBAL_LOCAL_ALEN: i64 = 102
let V2_GLOBAL_USER_FN_RETURN_ARR_SIZE: i64 = 103
let V2_GLOBAL_LOCAL_IS_BSS: i64 = 104
let V2_GLOBAL_LOCAL_BSS_IDX: i64 = 105

struct ExprParse {
    ok: i64,
    reg: i64,
    next: i64,
}

struct V2DriverContext {
    local_count: i64,
    next_reg: i64,
    break_label: i64,
    continue_label: i64,
}

fn v2_driver_context_new() -> V2DriverContext with Mut {
    V2_LOCAL_COUNT = 0
    V2_NEXT_REG = 0
    V2_BREAK_LABEL = -1
    V2_CONTINUE_LABEL = -1
    let ctx = V2DriverContext { local_count: 0, next_reg: 0, break_label: -1, continue_label: -1 }
    ctx
}

fn reset_locals(ctx: &! V2DriverContext) with Mut {
    V2_LOCAL_COUNT = 0
    V2_NEXT_REG = 0
    V2_BREAK_LABEL = -1
    V2_CONTINUE_LABEL = -1
    var i: i64 = 0
    while i < 4096 {
        V2_REG_IS_F64[i as usize] = 0
        i = i + 1
    }
}

fn mark_reg_f64(reg: i64) with Mut {
    if reg >= 0 && reg < 4096 {
        V2_REG_IS_F64[reg as usize] = 1
    }
}

fn mark_reg_i64(reg: i64) with Mut {
    if reg >= 0 && reg < 4096 {
        V2_REG_IS_F64[reg as usize] = 0
    }
}

fn reg_is_f64(reg: i64) -> bool {
    if reg >= 0 && reg < 4096 {
        return V2_REG_IS_F64[reg as usize] == 1
    }
    false
}

fn mark_reg_fnref(reg: i64) with Mut {
    if reg >= 0 && reg < 4096 {
        V2_REG_IS_F64[reg as usize] = 2
    }
}

fn mark_reg_fnref_f64(reg: i64) with Mut {
    if reg >= 0 && reg < 4096 {
        V2_REG_IS_F64[reg as usize] = 3
    }
}

fn reg_is_fnref(reg: i64) -> bool {
    if reg >= 0 && reg < 4096 {
        return V2_REG_IS_F64[reg as usize] == 2 || V2_REG_IS_F64[reg as usize] == 3
    }
    false
}

fn reg_is_fnref_f64(reg: i64) -> bool {
    if reg >= 0 && reg < 4096 {
        return V2_REG_IS_F64[reg as usize] == 3
    }
    false
}

fn mark_struct_regs(base: i64, sidx: i64) with Mut {
    if sidx < 0 { return }
    let start = STRUCT_FIELD_START[sidx as usize]
    let count = STRUCT_FIELD_COUNT[sidx as usize]
    var fi: i64 = 0
    while fi < count {
        let abs_fi = start + fi
        let flat_off = STRUCT_FIELD_FLAT_OFFSET[abs_fi as usize]
        let child = STRUCT_FIELD_STRUCT_IDX[abs_fi as usize]
        if child >= 0 {
            if STRUCT_FIELD_GENERIC_F64[abs_fi as usize] != 0 {
                mark_struct_scalar_regs_f64(base + flat_off, child)
            } else {
                mark_struct_regs(base + flat_off, child)
            }
        } else if STRUCT_FIELD_IS_F64[abs_fi as usize] != 0 {
            mark_reg_f64(base + flat_off)
        } else {
            mark_reg_i64(base + flat_off)
        }
        fi = fi + 1
    }
}

fn mark_struct_scalar_regs_f64(base: i64, sidx: i64) with Mut {
    if sidx < 0 { return }
    let start = STRUCT_FIELD_START[sidx as usize]
    let count = STRUCT_FIELD_COUNT[sidx as usize]
    var fi: i64 = 0
    while fi < count {
        let abs_fi = start + fi
        let flat_off = STRUCT_FIELD_FLAT_OFFSET[abs_fi as usize]
        let child = STRUCT_FIELD_STRUCT_IDX[abs_fi as usize]
        if child >= 0 {
            mark_struct_scalar_regs_f64(base + flat_off, child)
        } else {
            mark_reg_f64(base + flat_off)
        }
        fi = fi + 1
    }
}

fn remember_local_tok(ctx: &! V2DriverContext, tok_idx: i64, reg: i64) with Mut, Panic {
    let idx = V2_LOCAL_COUNT
    if idx < 64 {
        V2_LOCAL_TOK_IDX[idx as usize] = tok_idx
        V2_LOCAL_REGS[idx as usize] = reg
        V2_LOCAL_STRUCT_IDX[idx as usize] = -1
        V2_LOCAL_IS_REF[idx as usize] = 0
        V2_LOCAL_ALEN[idx as usize] = 0
        V2_LOCAL_IS_BSS[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_ENABLED[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_COUNT[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_FIELD_OFFSET[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_CMP_CODE[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_THRESHOLD[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_TYPE_STRUCT_IDX[idx as usize] = -1
        V2_LOCAL_COUNT = idx + 1
    }
}

fn remember_local_arr_tok(ctx: &! V2DriverContext, tok_idx: i64, base_reg: i64, alen: i64) with Mut, Panic {
    let idx = V2_LOCAL_COUNT
    if idx < 64 {
        V2_LOCAL_TOK_IDX[idx as usize] = tok_idx
        V2_LOCAL_REGS[idx as usize] = base_reg
        V2_LOCAL_STRUCT_IDX[idx as usize] = -1
        V2_LOCAL_IS_REF[idx as usize] = 0
        V2_LOCAL_ALEN[idx as usize] = alen
        V2_LOCAL_IS_BSS[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_ENABLED[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_COUNT[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_FIELD_OFFSET[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_CMP_CODE[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_THRESHOLD[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_TYPE_STRUCT_IDX[idx as usize] = -1
        V2_LOCAL_COUNT = idx + 1
    }
}

fn remember_local_arr_tok_bss(ctx: &! V2DriverContext, tok_idx: i64, dummy_reg: i64, alen: i64, bss_idx: i64) with Mut, Panic {
    let idx = V2_LOCAL_COUNT
    if idx < 64 {
        V2_LOCAL_TOK_IDX[idx as usize] = tok_idx
        V2_LOCAL_REGS[idx as usize] = dummy_reg
        V2_LOCAL_STRUCT_IDX[idx as usize] = -1
        V2_LOCAL_IS_REF[idx as usize] = 0
        V2_LOCAL_ALEN[idx as usize] = alen
        V2_LOCAL_IS_BSS[idx as usize] = 1
        V2_LOCAL_BSS_IDX[idx as usize] = bss_idx
        V2_LOCAL_KNOWLEDGE_GUARD_ENABLED[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_COUNT[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_FIELD_OFFSET[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_CMP_CODE[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_THRESHOLD[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_TYPE_STRUCT_IDX[idx as usize] = -1
        V2_LOCAL_COUNT = idx + 1
    }
}

fn lookup_local_alen_tok(ctx: &! V2DriverContext, tok_idx: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = V2_LOCAL_COUNT - 1
    while i >= 0 {
        if toks_ident_eq(V2_LOCAL_TOK_IDX[i as usize], tok_idx) {
            return V2_LOCAL_ALEN[i as usize]
        }
        i = i - 1
    }
    0
}

fn lookup_local_alen_by_reg(ctx: &! V2DriverContext, reg: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < V2_LOCAL_COUNT {
        if V2_LOCAL_REGS[i as usize] == reg {
            return V2_LOCAL_ALEN[i as usize]
        }
        i = i + 1
    }
    0
}

fn lookup_local_bss_idx_tok(ctx: &! V2DriverContext, tok_idx: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = V2_LOCAL_COUNT - 1
    while i >= 0 {
        if toks_ident_eq(V2_LOCAL_TOK_IDX[i as usize], tok_idx) {
            if V2_LOCAL_IS_BSS[i as usize] != 0 {
                return V2_LOCAL_BSS_IDX[i as usize]
            }
            return -1
        }
        i = i - 1
    }
    -1
}

fn remember_struct_local_tok(ctx: &! V2DriverContext, tok_idx: i64, base_reg: i64, sidx: i64) with Mut, Panic {
    let idx = V2_LOCAL_COUNT
    if idx < 64 {
        V2_LOCAL_TOK_IDX[idx as usize] = tok_idx
        V2_LOCAL_REGS[idx as usize] = base_reg
        V2_LOCAL_STRUCT_IDX[idx as usize] = sidx
        V2_LOCAL_IS_REF[idx as usize] = 0
        V2_LOCAL_IS_BSS[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_ENABLED[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_COUNT[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_FIELD_OFFSET[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_CMP_CODE[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_THRESHOLD[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_TYPE_STRUCT_IDX[idx as usize] = -1
        V2_LOCAL_COUNT = idx + 1
    }
}

fn remember_ref_struct_local_tok(ctx: &! V2DriverContext, tok_idx: i64, reg: i64, sidx: i64) with Mut, Panic {
    let idx = V2_LOCAL_COUNT
    if idx < 64 {
        V2_LOCAL_TOK_IDX[idx as usize] = tok_idx
        V2_LOCAL_REGS[idx as usize] = reg
        V2_LOCAL_STRUCT_IDX[idx as usize] = sidx
        V2_LOCAL_IS_REF[idx as usize] = 1
        V2_LOCAL_IS_BSS[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_ENABLED[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_COUNT[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_FIELD_OFFSET[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_CMP_CODE[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_THRESHOLD[idx as usize] = 0
        V2_LOCAL_KNOWLEDGE_GUARD_TYPE_STRUCT_IDX[idx as usize] = -1
        V2_LOCAL_COUNT = idx + 1
    }
}

fn lookup_local_struct_idx_tok(ctx: &! V2DriverContext, tok_idx: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = V2_LOCAL_COUNT - 1
    while i >= 0 {
        if toks_ident_eq(V2_LOCAL_TOK_IDX[i as usize], tok_idx) {
            return V2_LOCAL_STRUCT_IDX[i as usize]
        }
        i = i - 1
    }
    -1
}

fn lookup_local_is_ref_tok(ctx: &! V2DriverContext, tok_idx: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = V2_LOCAL_COUNT - 1
    while i >= 0 {
        if toks_ident_eq(V2_LOCAL_TOK_IDX[i as usize], tok_idx) {
            return V2_LOCAL_IS_REF[i as usize]
        }
        i = i - 1
    }
    0
}

fn lookup_local_knowledge_guard_index(ctx: &! V2DriverContext, tok_idx: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = V2_LOCAL_COUNT - 1
    while i >= 0 {
        if toks_ident_eq(V2_LOCAL_TOK_IDX[i as usize], tok_idx) {
            if V2_LOCAL_KNOWLEDGE_GUARD_ENABLED[i as usize] != 0 {
                return i
            }
            return -1
        }
        i = i - 1
    }
    -1
}

fn toks_ident_eq(a: i64, b: i64) -> bool with Mut, Panic, Div {
    let a_start = pt_read_start(a)
    let a_end = pt_read_end(a)
    let b_start = pt_read_start(b)
    let b_end = pt_read_end(b)
    let a_len = a_end - a_start
    let b_len = b_end - b_start
    if a_len != b_len { return false }
    var i: i64 = 0
    while i < a_len {
        if CURSOR_SOURCE[(a_start + i) as usize] != CURSOR_SOURCE[(b_start + i) as usize] { return false }
        i = i + 1
    }
    return true
}

fn lookup_local_tok(ctx: &! V2DriverContext, tok_idx: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = V2_LOCAL_COUNT - 1
    while i >= 0 {
        if toks_ident_eq(V2_LOCAL_TOK_IDX[i as usize], tok_idx) {
            return V2_LOCAL_REGS[i as usize]
        }
        i = i - 1
    }
    -1
}

fn token_kind(idx: i64) -> i64 with Panic {
    pt_read_kind_code(idx)
}

fn token_name(idx: i64) -> Name with Mut, Panic, Div {
    var n = empty_name()
    let start = pt_read_start(idx)
    let end = pt_read_end(idx)
    var i: i64 = start
    while i < end && n.len < 128 {
        n.buf[n.len as usize] = CURSOR_SOURCE[i as usize]
        n.len = n.len + 1
        i = i + 1
    }
    n
}

fn token_text_eq(idx: i64, text: string) -> bool with Mut, Panic, Div {
    let start = pt_read_start(idx)
    let end = pt_read_end(idx)
    let len = end - start
    if len != str_len(text) {
        return false
    }
    var i: i64 = 0
    while i < len {
        if CURSOR_SOURCE[(start + i) as usize] != (str_char_at(text, i) as i8) {
            return false
        }
        i = i + 1
    }
    true
}

fn token_float_mantissa(idx: i64) -> i64 with Mut, Panic, Div {
    let start = pt_read_start(idx)
    let end = pt_read_end(idx)
    var i: i64 = start
    var mantissa: i64 = 0
    while i < end {
        let ch = CURSOR_SOURCE[i as usize]
        if ch == 95 as i8 {
            i = i + 1
        } else if ch == 46 as i8 {
            i = i + 1
        } else if ch == 102 as i8 || ch == 70 as i8 {
            return mantissa
        } else if ch >= 48 as i8 && ch <= 57 as i8 {
            mantissa = (mantissa * 10) + ((ch as i64) - 48)
            i = i + 1
        } else {
            return mantissa
        }
    }
    mantissa
}

fn token_float_scale(idx: i64) -> i64 with Mut, Panic, Div {
    let start = pt_read_start(idx)
    let end = pt_read_end(idx)
    var i: i64 = start
    var seen_dot: i64 = 0
    var scale: i64 = 1
    while i < end {
        let ch = CURSOR_SOURCE[i as usize]
        if ch == 46 as i8 {
            seen_dot = 1
        } else if ch == 102 as i8 || ch == 70 as i8 {
            return scale
        } else if seen_dot != 0 && ch >= 48 as i8 && ch <= 57 as i8 {
            scale = scale * 10
        }
        i = i + 1
    }
    scale
}

fn token_decimal_digit_count(idx: i64) -> i64 with Mut, Panic, Div {
    let start = pt_read_start(idx)
    let end = pt_read_end(idx)
    var i: i64 = start
    var count: i64 = 0
    while i < end {
        let ch = CURSOR_SOURCE[i as usize]
        if ch >= 48 as i8 && ch <= 57 as i8 { count = count + 1 }
        i = i + 1
    }
    count
}

fn decimal_scale_for_digits(digits: i64) -> i64 with Mut {
    var scale: i64 = 1
    var i: i64 = 0
    while i < digits {
        scale = scale * 10
        i = i + 1
    }
    scale
}

fn name_eq_text(name: Name, text: string) -> bool with Mut, Panic, Div {
    let len = str_len(text)
    if name.len != len {
        return false
    }
    var i: i64 = 0
    while i < len {
        if name.buf[i as usize] != (str_char_at(text, i) as i8) {
            return false
        }
        i = i + 1
    }
    true
}

fn print_token_text(idx: i64) with IO, Mut, Panic, Div {
    let start = pt_read_start(idx)
    let end = pt_read_end(idx)
    var i: i64 = start
    while i < end {
        print_char(CURSOR_SOURCE[i as usize] as i64)
        i = i + 1
    }
}

fn fixed_name_print() -> Name with Mut {
    var n = empty_name()
    n.len = 5
    n.buf[0] = 112 as i8
    n.buf[1] = 114 as i8
    n.buf[2] = 105 as i8
    n.buf[3] = 110 as i8
    n.buf[4] = 116 as i8
    return n
}

