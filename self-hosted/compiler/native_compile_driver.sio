    if token_text_eq(tok, "V2_GLOBAL_EP_TOTAL_INSTR") { return 79 }
    if token_text_eq(tok, "V2_GLOBAL_EP_KNOWLEDGE_COUNT") { return 80 }
    if token_text_eq(tok, "V2_GLOBAL_STRUCT_FIELD_ARRAY_SIZE") { return 87 }
    if token_text_eq(tok, "V2_GLOBAL_CURRENT_FN_SRET") { return 88 }
    if token_text_eq(tok, "V2_GLOBAL_CURRENT_FN_SRET_VREG") { return 89 }
    if token_text_eq(tok, "V2_GLOBAL_LAST_ARR_LEN") { return 90 }
    if token_text_eq(tok, "V2_GLOBAL_CLOSURE_START_TOK") { return 91 }
    if token_text_eq(tok, "V2_GLOBAL_CLOSURE_BODY_START") { return 92 }
    if token_text_eq(tok, "V2_GLOBAL_CLOSURE_BODY_END") { return 93 }
    if token_text_eq(tok, "V2_GLOBAL_CLOSURE_PARAM_START") { return 94 }
    if token_text_eq(tok, "V2_GLOBAL_CLOSURE_PARAM_COUNT") { return 95 }
    if token_text_eq(tok, "V2_GLOBAL_CLOSURE_FN_IDS") { return 96 }
    if token_text_eq(tok, "V2_GLOBAL_CLOSURE_RETURN_IS_F64") { return 97 }
    if token_text_eq(tok, "V2_GLOBAL_CLOSURE_PARAM_NAME_TOK") { return 98 }
    if token_text_eq(tok, "V2_GLOBAL_CLOSURE_PARAM_IS_F64") { return 99 }
    if token_text_eq(tok, "V2_GLOBAL_CLOSURE_PARAM_TOTAL") { return 100 }
    if token_text_eq(tok, "V2_GLOBAL_CLOSURE_COUNT") { return 101 }
    if token_text_eq(tok, "V2_GLOBAL_LOCAL_ALEN") { return 102 }
    if token_text_eq(tok, "V2_GLOBAL_USER_FN_RETURN_ARR_SIZE") { return 103 }
    if token_text_eq(tok, "V2_GLOBAL_LOCAL_IS_BSS") { return 104 }
    if token_text_eq(tok, "V2_GLOBAL_LOCAL_BSS_IDX") { return 105 }
    -999999999
}

fn skip_index_cast_end(pos: i64) -> i64 with Panic {
    if token_kind(pos) == TK_AS {
        return pos + 2
    }
    pos
}

fn token_string_name(idx: i64) -> Name with Mut, Panic, Div {
    var n = empty_name()
    var i = pt_read_start(idx) + 1
    let end = pt_read_end(idx) - 1
    while i < end && n.len < 128 {
        let ch = CURSOR_SOURCE[i as usize]
        if ch == 92 as i8 && i + 1 < end {
            let esc = CURSOR_SOURCE[(i + 1) as usize]
            if esc == 110 as i8 { n.buf[n.len as usize] = 10 as i8 }
            else if esc == 116 as i8 { n.buf[n.len as usize] = 9 as i8 }
            else if esc == 114 as i8 { n.buf[n.len as usize] = 13 as i8 }
            else if esc == 34 as i8 { n.buf[n.len as usize] = 34 as i8 }
            else if esc == 92 as i8 { n.buf[n.len as usize] = 92 as i8 }
            else { n.buf[n.len as usize] = esc }
            n.len = n.len + 1
            i = i + 2
        } else {
            n.buf[n.len as usize] = ch
            n.len = n.len + 1
            i = i + 1
        }
    }
    n
}

fn alloc_reg(ctx: &! V2DriverContext) -> i64 with Mut {
    let r = V2_NEXT_REG
    V2_NEXT_REG = r + 1
    r
}

fn alloc_label() -> i64 with Mut {
    let l = V2_NEXT_LABEL
    V2_NEXT_LABEL = l + 1
    l
}

fn reset_closure_registry() with Mut {
    V2_CLOSURE_COUNT = 0
    V2_CLOSURE_PARAM_TOTAL = 0
}

fn reset_user_fn_label_state() with Mut {
    V2_NEXT_LABEL = 0
}

fn reset_parse_unsupported() with Mut {
    V2_PARSE_UNSUPPORTED = 0
    V2_PARSE_UNSUPPORTED_TOKEN = -1
    V2_PARSE_UNSUPPORTED_KIND = -1
    V2_PARSE_UNSUPPORTED_REASON = 0
}

fn mark_parse_unsupported(pos: i64) with Mut, Panic {
    if V2_PARSE_UNSUPPORTED == 0 {
        V2_PARSE_UNSUPPORTED = 1
        V2_PARSE_UNSUPPORTED_TOKEN = pos
        V2_PARSE_UNSUPPORTED_KIND = token_kind(pos)
    }
}

fn mark_parse_unsupported_call(pos: i64) with Mut, Panic {
    if V2_PARSE_UNSUPPORTED == 0 {
        V2_PARSE_UNSUPPORTED_REASON = 1
        mark_parse_unsupported(pos)
    }
}

fn mark_parse_unsupported_pathsep(pos: i64) with Mut, Panic {
    if V2_PARSE_UNSUPPORTED == 0 {
        V2_PARSE_UNSUPPORTED_REASON = 2
        mark_parse_unsupported(pos)
    }
}

fn mark_parse_unsupported_refinement(pos: i64) with Mut, Panic {
    if V2_PARSE_UNSUPPORTED == 0 {
        V2_PARSE_UNSUPPORTED_REASON = 3
        mark_parse_unsupported(pos)
    }
}

fn register_user_fn(token_idx: i64, fn_id: i64) with Mut, Panic {
    let idx = V2_USER_FN_COUNT
    if idx < 512 {
        V2_USER_FN_TOKEN_IDX[idx as usize] = token_idx
        V2_USER_FN_IDS[idx as usize] = fn_id
        V2_USER_FN_COUNT = idx + 1
    }
}

fn lookup_user_fn_id(name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < V2_USER_FN_COUNT {
        let tok = V2_USER_FN_TOKEN_IDX[i as usize]
        if name_eq(token_name(tok), name) {
            return V2_USER_FN_IDS[i as usize]
        }
        i = i + 1
    }
    -1
}

fn lookup_user_fn_id_tok(name_tok: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < V2_USER_FN_COUNT {
        let tok = V2_USER_FN_TOKEN_IDX[i as usize]
        if toks_ident_eq(tok, name_tok) {
            return V2_USER_FN_IDS[i as usize]
        }
        i = i + 1
    }
    -1
}

fn user_fn_name_at(idx: i64) -> Name with Mut, Panic, Div {
    token_name(V2_USER_FN_TOKEN_IDX[idx as usize])
}

fn skip_trivia(pos: i64, close: i64) -> i64 with Mut, Panic {
    var p = pos
    while p < close {
        let k = token_kind(p)
        if k == TK_NEWLINE || k == TK_SEMI { p = p + 1 }
        else { break }
    }
    p
}

// ============================================================
// Struct layout pre-scanner
// ============================================================

fn find_ident_token_text(token_count: i64, text: string) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < token_count {
        if token_kind(i) == TK_IDENT && token_text_eq(i, text) {
            return i
        }
        i = i + 1
    }
    -1
}

fn find_name_struct_idx() -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < STRUCT_COUNT {
        if token_text_eq(STRUCT_NAME_TOKS[i as usize], "Name") {
            return i
        }
        i = i + 1
    }
    -1
}

fn register_builtin_name_struct(token_count: i64) with Mut, Panic, Div {
    if find_name_struct_idx() >= 0 { return }
    let name_tok = find_ident_token_text(token_count, "Name")
    let buf_tok = find_ident_token_text(token_count, "buf")
    let len_tok = find_ident_token_text(token_count, "len")
    if name_tok < 0 || buf_tok < 0 || len_tok < 0 { return }
    if STRUCT_COUNT >= 16 || STRUCT_FIELD_TOTAL + 2 >= 128 { return }
    let sidx = STRUCT_COUNT
    let fstart = STRUCT_FIELD_TOTAL
    STRUCT_NAME_TOKS[sidx as usize] = name_tok
    STRUCT_FIELD_START[sidx as usize] = fstart
    STRUCT_FIELD_COUNT[sidx as usize] = 2
    STRUCT_FLAT_SIZE[sidx as usize] = 129
    STRUCT_FIELDS[fstart as usize] = buf_tok
    STRUCT_FIELD_STRUCT_IDX[fstart as usize] = -1
    STRUCT_FIELD_FLAT_OFFSET[fstart as usize] = 0
    STRUCT_FIELDS[(fstart + 1) as usize] = len_tok
    STRUCT_FIELD_STRUCT_IDX[(fstart + 1) as usize] = -1
    STRUCT_FIELD_FLAT_OFFSET[(fstart + 1) as usize] = 128
    STRUCT_FIELD_TOTAL = fstart + 2
    STRUCT_COUNT = sidx + 1
}

fn find_knowledge_struct_idx() -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < STRUCT_COUNT {
        if token_text_eq(STRUCT_NAME_TOKS[i as usize], "Knowledge") { return i }
        // Synthetic registration: name tok is "value" when "Knowledge" not in source
        if STRUCT_FLAT_SIZE[i as usize] == 2 && STRUCT_FIELD_COUNT[i as usize] >= 1 {
            let fstart = STRUCT_FIELD_START[i as usize]
            if token_text_eq(STRUCT_FIELDS[fstart as usize], "value") && token_text_eq(STRUCT_NAME_TOKS[i as usize], "value") { return i }
        }
        i = i + 1
    }
    -1
}

// Register Knowledge<T> as a synthetic 2-field struct {value: f64, uncertainty: f64}.
// Registers if "value" token exists in the source. "Knowledge" and "uncertainty" are optional.
fn register_builtin_knowledge_struct(token_count: i64) with Mut, Panic, Div {
    if find_knowledge_struct_idx() >= 0 { return }
    let v_tok = find_ident_token_text(token_count, "value")
    if v_tok < 0 { return }
    let u_tok = find_ident_token_text(token_count, "uncertainty")
    let k_tok = find_ident_token_text(token_count, "Knowledge")
    if STRUCT_COUNT >= 16 || STRUCT_FIELD_TOTAL + 2 >= 128 { return }
    let sidx = STRUCT_COUNT
    let fstart = STRUCT_FIELD_TOTAL
    // Use k_tok for name when available; otherwise use v_tok so find_knowledge_struct_idx can detect it
    var name_tok = v_tok
    if k_tok >= 0 { name_tok = k_tok }
    STRUCT_NAME_TOKS[sidx as usize] = name_tok
    STRUCT_FIELD_START[sidx as usize] = fstart
    STRUCT_FLAT_SIZE[sidx as usize] = 2
    STRUCT_FIELDS[fstart as usize] = v_tok
    STRUCT_FIELD_STRUCT_IDX[fstart as usize] = -1
    STRUCT_FIELD_IS_F64[fstart as usize] = 1
    STRUCT_FIELD_FLAT_OFFSET[fstart as usize] = 0
    if u_tok >= 0 {
        STRUCT_FIELD_COUNT[sidx as usize] = 2
        STRUCT_FIELDS[(fstart + 1) as usize] = u_tok
        STRUCT_FIELD_STRUCT_IDX[(fstart + 1) as usize] = -1
        STRUCT_FIELD_IS_F64[(fstart + 1) as usize] = 1
        STRUCT_FIELD_FLAT_OFFSET[(fstart + 1) as usize] = 1
        STRUCT_FIELD_TOTAL = fstart + 2
    } else {
        STRUCT_FIELD_COUNT[sidx as usize] = 1
        STRUCT_FIELD_TOTAL = fstart + 1
    }
    STRUCT_COUNT = sidx + 1
}

fn scan_struct_decls(token_count: i64) with Mut, Panic, Div {
    STRUCT_COUNT = 0
    STRUCT_FIELD_TOTAL = 0
    var i: i64 = 0
    while i + 1 < token_count {
        if token_kind(i) == TK_STRUCT && token_kind(i + 1) == TK_IDENT {
            let sidx = STRUCT_COUNT
            if sidx < 16 {
                STRUCT_NAME_TOKS[sidx as usize] = i + 1
                STRUCT_FIELD_START[sidx as usize] = STRUCT_FIELD_TOTAL
                STRUCT_FIELD_COUNT[sidx as usize] = 0
                STRUCT_COUNT = sidx + 1
                var j = i + 2
                while j < token_count && token_kind(j) != TK_LBRACE { j = j + 1 }
                j = j + 1
                while j < token_count && token_kind(j) != TK_RBRACE {
                    let kj = token_kind(j)
                    if kj == TK_IDENT && STRUCT_FIELD_TOTAL < 128 {
                        STRUCT_FIELDS[STRUCT_FIELD_TOTAL as usize] = j
                        STRUCT_FIELD_TOTAL = STRUCT_FIELD_TOTAL + 1
                        STRUCT_FIELD_COUNT[sidx as usize] = STRUCT_FIELD_COUNT[sidx as usize] + 1
                        j = j + 1
                        while j < token_count && token_kind(j) != TK_COMMA && token_kind(j) != TK_RBRACE { j = j + 1 }
                        if j < token_count && token_kind(j) == TK_COMMA { j = j + 1 }
                    } else if kj == TK_NEWLINE || kj == TK_SEMI {
                        j = j + 1
                    } else {
                        j = j + 1
                    }
                }
                i = j + 1
            } else {
                i = i + 1
            }
        } else if token_kind(i) == TK_IDENT && token_text_eq(i, "algebra") && token_kind(i + 1) == TK_IDENT {
            // algebra NAME over TYPE { basis: x, y, ... } — register as struct with f64 fields
            let sidx = STRUCT_COUNT
            if sidx < 16 {
                STRUCT_NAME_TOKS[sidx as usize] = i + 1
                STRUCT_FIELD_START[sidx as usize] = STRUCT_FIELD_TOTAL
                STRUCT_FIELD_COUNT[sidx as usize] = 0
                STRUCT_COUNT = sidx + 1
                var j = i + 2
                while j < token_count && token_kind(j) != TK_LBRACE { j = j + 1 }
                j = j + 1
                while j < token_count && token_kind(j) != TK_RBRACE {
                    let kj = token_kind(j)
                    if kj == TK_IDENT && token_text_eq(j, "basis") && token_kind(j + 1) == TK_COLON {
                        j = j + 2
                        while j < token_count && token_kind(j) != TK_RBRACE {
                            if token_kind(j) == TK_IDENT && STRUCT_FIELD_TOTAL < 128 {
                                STRUCT_FIELDS[STRUCT_FIELD_TOTAL as usize] = j
                                STRUCT_FIELD_TOTAL = STRUCT_FIELD_TOTAL + 1
                                STRUCT_FIELD_COUNT[sidx as usize] = STRUCT_FIELD_COUNT[sidx as usize] + 1
                                j = j + 1
                                if j < token_count && token_kind(j) == TK_COMMA { j = j + 1 }
                            } else if token_kind(j) == TK_NEWLINE || token_kind(j) == TK_SEMI {
                                j = j + 1
                            } else {
                                j = j + 1
                            }
                        }
                    } else if kj == TK_NEWLINE || kj == TK_SEMI {
                        j = j + 1
                    } else {
                        j = j + 1
                    }
                }
                i = j + 1
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    scan_struct_field_types(token_count)
    compute_struct_flat_sizes()
    register_builtin_name_struct(token_count)
    register_builtin_knowledge_struct(token_count)
}

// Second pass: determine each field's type (struct or scalar) and flat offsets
fn scan_struct_field_types(token_count: i64) with Mut, Panic, Div {
    var fi: i64 = 0
    while fi < STRUCT_FIELD_TOTAL {
        let name_tok = STRUCT_FIELDS[fi as usize]
        var type_sidx: i64 = -1
        STRUCT_FIELD_IS_F64[fi as usize] = 0
        STRUCT_FIELD_GENERIC_F64[fi as usize] = 0
        STRUCT_FIELD_ARRAY_SIZE[fi as usize] = 0
        if name_tok + 2 < token_count {
            if token_kind(name_tok + 1) == TK_COLON && token_kind(name_tok + 2) == TK_IDENT {
                type_sidx = find_struct_idx_tok(name_tok + 2)
                if token_text_eq(name_tok + 2, "f64") || token_text_eq(name_tok + 2, "f32") {
                    STRUCT_FIELD_IS_F64[fi as usize] = 1
                }
                if name_tok + 5 < token_count && token_kind(name_tok + 3) == TK_LT && token_kind(name_tok + 4) == TK_IDENT && token_kind(name_tok + 5) == TK_GT && token_text_eq(name_tok + 4, "f64") {
                    STRUCT_FIELD_GENERIC_F64[fi as usize] = 1
                }
            }
            // Detect array field: name: [T; N]
            // tokens: name, :, [, T, ;, N, ]
            if token_kind(name_tok + 1) == TK_COLON && token_kind(name_tok + 2) == TK_LBRACKET {
                var semi_pos: i64 = name_tok + 3
                while semi_pos < token_count && token_kind(semi_pos) != TK_SEMI && token_kind(semi_pos) != TK_RBRACKET { semi_pos = semi_pos + 1 }
                if semi_pos < token_count && token_kind(semi_pos) == TK_SEMI && token_kind(semi_pos + 1) == TK_INT {
                    STRUCT_FIELD_ARRAY_SIZE[fi as usize] = pt_read_int_value(semi_pos + 1)
                }
                // Mark element type as f64 when array element type is f64
                if token_kind(name_tok + 3) == TK_IDENT && (token_text_eq(name_tok + 3, "f64") || token_text_eq(name_tok + 3, "f32")) {
                    STRUCT_FIELD_IS_F64[fi as usize] = 1
                }
            }
        }
        // Algebra basis fields have no type annotation (e.g. `basis: x, y`).
        // These fields are not followed by TK_COLON, so no type was resolved above.
        // By convention, all algebra basis elements are f64.
        if type_sidx < 0 && STRUCT_FIELD_IS_F64[fi as usize] == 0 && token_kind(name_tok + 1) != TK_COLON && token_kind(name_tok + 1) != TK_LBRACKET {
            STRUCT_FIELD_IS_F64[fi as usize] = 1
        }
        STRUCT_FIELD_STRUCT_IDX[fi as usize] = type_sidx
        fi = fi + 1
    }
}

// Compute flattened register counts and offsets (iterate to handle forward refs)
fn compute_struct_flat_sizes() with Mut {
    var si: i64 = 0
    while si < STRUCT_COUNT {
        STRUCT_FLAT_SIZE[si as usize] = STRUCT_FIELD_COUNT[si as usize]
        si = si + 1
    }
    var iter: i64 = 0
    while iter < STRUCT_COUNT {
        si = 0
        while si < STRUCT_COUNT {
            let start = STRUCT_FIELD_START[si as usize]
            let count = STRUCT_FIELD_COUNT[si as usize]
            var flat: i64 = 0
            var fi: i64 = 0
            while fi < count {
                let abs_fi = start + fi
                STRUCT_FIELD_FLAT_OFFSET[abs_fi as usize] = flat
                let fsidx = STRUCT_FIELD_STRUCT_IDX[abs_fi as usize]
                if fsidx >= 0 {
                    flat = flat + STRUCT_FLAT_SIZE[fsidx as usize]
                } else {
                    let farray = STRUCT_FIELD_ARRAY_SIZE[abs_fi as usize]
                    if farray > 0 {
                        flat = flat + farray
                    } else {
                        flat = flat + 1
                    }
                }
                fi = fi + 1
            }
            STRUCT_FLAT_SIZE[si as usize] = flat
            si = si + 1
        }
        iter = iter + 1
    }
}

// Enum pre-scanner
fn scan_enum_decls(token_count: i64) with Mut, Panic {
    ENUM_COUNT = 0
    ENUM_VARIANT_TOTAL = 0
    var i: i64 = 0
    while i + 1 < token_count {
        if token_kind(i) == TK_ENUM && token_kind(i + 1) == TK_IDENT {
            let eidx = ENUM_COUNT
            if eidx < 16 {
                ENUM_NAME_TOKS[eidx as usize] = i + 1
                ENUM_VARIANT_START[eidx as usize] = ENUM_VARIANT_TOTAL
                ENUM_VARIANT_COUNT[eidx as usize] = 0
                ENUM_COUNT = eidx + 1
                var j = i + 2
                while j < token_count && token_kind(j) != TK_LBRACE { j = j + 1 }
                j = j + 1
                while j < token_count && token_kind(j) != TK_RBRACE {
                    let kj = token_kind(j)
                    if kj == TK_IDENT && ENUM_VARIANT_TOTAL < 128 {
                        ENUM_VARIANTS[ENUM_VARIANT_TOTAL as usize] = j
                        ENUM_VARIANT_TOTAL = ENUM_VARIANT_TOTAL + 1
                        ENUM_VARIANT_COUNT[eidx as usize] = ENUM_VARIANT_COUNT[eidx as usize] + 1
                        j = j + 1
                        while j < token_count && token_kind(j) != TK_COMMA && token_kind(j) != TK_RBRACE { j = j + 1 }
                        if j < token_count && token_kind(j) == TK_COMMA { j = j + 1 }
                    } else if kj == TK_NEWLINE || kj == TK_SEMI { j = j + 1
                    } else { j = j + 1 }
                }
                i = j + 1
            } else { i = i + 1 }
        } else { i = i + 1 }
    }
}

fn find_enum_idx_tok(name_tok: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < ENUM_COUNT {
        if toks_ident_eq(ENUM_NAME_TOKS[i as usize], name_tok) { return i }
        i = i + 1
    }
    -1
}

fn find_enum_variant_value(eidx: i64, variant_tok: i64) -> i64 with Mut, Panic, Div {
    let start = ENUM_VARIANT_START[eidx as usize]
    let count = ENUM_VARIANT_COUNT[eidx as usize]
    var vi: i64 = 0
    while vi < count {
        if toks_ident_eq(ENUM_VARIANTS[(start + vi) as usize], variant_tok) { return vi }
        vi = vi + 1
    }
    -1
}

fn lookup_user_fn_return_struct_idx(fn_id: i64) -> i64 with Mut {
    var i: i64 = 0
    while i < V2_USER_FN_COUNT {
        if V2_USER_FN_IDS[i as usize] == fn_id {
            return V2_USER_FN_RETURN_STRUCT_IDX[i as usize]
        }
        i = i + 1
    }
    -1
}

fn lookup_user_fn_return_is_f64(fn_id: i64) -> bool with Mut {
    var i: i64 = 0
    while i < V2_USER_FN_COUNT {
        if V2_USER_FN_IDS[i as usize] == fn_id {
            return V2_USER_FN_RETURN_IS_F64[i as usize] == 1
        }
        i = i + 1
    }
    false
}

fn lookup_user_fn_return_arr_size(fn_id: i64) -> i64 with Mut {
    var i: i64 = 0
    while i < V2_USER_FN_COUNT {
        if V2_USER_FN_IDS[i as usize] == fn_id {
            return V2_USER_FN_RETURN_ARR_SIZE[i as usize]
        }
        i = i + 1
    }
    0
}

fn lookup_user_fn_knowledge_guard_index(fn_id: i64) -> i64 with Mut {
    var i: i64 = 0
    while i < V2_USER_FN_COUNT {
        if V2_USER_FN_IDS[i as usize] == fn_id {
            if V2_USER_FN_KNOWLEDGE_GUARD_ENABLED[i as usize] != 0 {
                return i
            }
            return -1
        }
        i = i + 1
    }
    -1
}

fn user_fn_knowledge_guard_site(guard_idx: i64) -> i64 {
    if guard_idx < 0 || guard_idx >= 512 {
        return 0
    }
    return V2_USER_FN_KNOWLEDGE_GUARD_SITE[guard_idx as usize]
}

fn native_v2_direct_knowledge_guard_count() -> i64 {
    var count: i64 = 0
    var i: i64 = 0
    while i < V2_USER_FN_COUNT {
        if V2_USER_FN_KNOWLEDGE_GUARD_ENABLED[i as usize] != 0 {
            count = count + 1
        }
        i = i + 1
    }
    count
}

fn lookup_user_fn_return_is_fnref(fn_id: i64) -> bool with Mut {
    var i: i64 = 0
    while i < V2_USER_FN_COUNT {
        if V2_USER_FN_IDS[i as usize] == fn_id {
            return V2_USER_FN_RETURN_IS_F64[i as usize] == 2
        }
        i = i + 1
    }
    false
}

fn lookup_user_fn_returns_value(fn_id: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < V2_USER_FN_COUNT {
        if V2_USER_FN_IDS[i as usize] == fn_id {
            let name_tok = V2_USER_FN_TOKEN_IDX[i as usize]
            var j = name_tok + 1
            while j < V2_TOKEN_COUNT && token_kind(j) != TK_LBRACE && token_kind(j) != TK_FN {
                if token_kind(j) == TK_ARROW { return true }
                j = j + 1
            }
            return false
        }
        i = i + 1
    }
    false
}

fn builtin_fn_returns_value(fn_id: i64) -> bool {
    if fn_id == V2_BUILTIN_PRINT { return false }
    if fn_id == V2_BUILTIN_PRINT_INT { return false }
    if fn_id == V2_BUILTIN_PRINT_CHAR { return false }
    if fn_id == V2_BUILTIN_PRINT_F64 { return false }
    if fn_id == V2_BUILTIN_PRINTLN { return false }
    if fn_id == V2_BUILTIN_ASSERT { return false }
    true
}

fn call_target_returns_value_tok(name_tok: i64) -> bool with Mut, Panic, Div {
    var fn_id = builtin_fn_id_tok(name_tok)
    if fn_id >= 0 { return builtin_fn_returns_value(fn_id) }
    fn_id = lookup_user_fn_id_tok(name_tok)
    if fn_id >= 0 { return lookup_user_fn_returns_value(fn_id) }
    false
}

fn call_target_or_fnref_returns_value_tok(ctx: &! V2DriverContext, name_tok: i64) -> bool with Mut, Panic, Div {
    if call_target_returns_value_tok(name_tok) { return true }
    let local_call_reg = lookup_local_tok(ctx, name_tok)
    if local_call_reg >= 0 {
        return reg_is_fnref(local_call_reg)
    }
    false
}

fn lookup_closure_idx_by_start(pos: i64) -> i64 with Mut {
    var i: i64 = 0
    while i < V2_CLOSURE_COUNT {
        if V2_CLOSURE_START_TOK[i as usize] == pos { return i }
        i = i + 1
    }
    -1
}

fn parse_closure_literal_ref_ir(ctx: &! V2DriverContext, pos: i64) -> ExprParse with Mut, Panic {
    let cidx = lookup_closure_idx_by_start(pos)
    if cidx < 0 { return ExprParse { ok: 0, reg: -1, next: pos} }
    let dst = alloc_reg(ctx)
    ufn_record_load_imm(dst, V2_CLOSURE_FN_IDS[cidx as usize])
    if V2_CLOSURE_RETURN_IS_F64[cidx as usize] != 0 {
        mark_reg_fnref_f64(dst)
    } else {
        mark_reg_fnref(dst)
    }
    return ExprParse { ok: 1, reg: dst, next: V2_CLOSURE_BODY_END[cidx as usize]}
}

fn probe_closure_body_expr(body_start: i64, param_start: i64, param_count: i64) -> ExprParse with Mut, Panic, Div, Alloc {
    let saved_ufn_count = V2_UFN_COUNT
    let saved_next_reg = V2_NEXT_REG
    let saved_next_label = V2_NEXT_LABEL
    let saved_last_struct = V2_LAST_STRUCT_IDX
    let saved_local_count = V2_LOCAL_COUNT
    let saved_parse_unsupported = V2_PARSE_UNSUPPORTED
    let saved_parse_token = V2_PARSE_UNSUPPORTED_TOKEN
    let saved_parse_kind = V2_PARSE_UNSUPPORTED_KIND
    let saved_parse_reason = V2_PARSE_UNSUPPORTED_REASON

    var ctx = v2_driver_context_new()
    reset_locals(&! ctx)
    reset_parse_unsupported()
    V2_NEXT_REG = 3000
    V2_NEXT_LABEL = 900
    V2_LAST_STRUCT_IDX = -1

    var pi: i64 = 0
    while pi < param_count {
        let pslot = param_start + pi
        let vreg = alloc_reg(&! ctx)
        remember_local_tok(&! ctx, V2_CLOSURE_PARAM_NAME_TOK[pslot as usize], vreg)
        if V2_CLOSURE_PARAM_IS_F64[pslot as usize] != 0 { mark_reg_f64(vreg) }
        pi = pi + 1
    }

    var func: i64 = 0
    let parsed = parse_expr_ir(&! func, &! ctx, body_start)
    var ret_is_f64: i64 = 0
    if parsed.ok != 0 && reg_is_f64(parsed.reg) { ret_is_f64 = 1 }

    V2_UFN_COUNT = saved_ufn_count
    V2_NEXT_REG = saved_next_reg
    V2_NEXT_LABEL = saved_next_label
    V2_LAST_STRUCT_IDX = saved_last_struct
    V2_LOCAL_COUNT = saved_local_count
    V2_PARSE_UNSUPPORTED = saved_parse_unsupported
    V2_PARSE_UNSUPPORTED_TOKEN = saved_parse_token
    V2_PARSE_UNSUPPORTED_KIND = saved_parse_kind
    V2_PARSE_UNSUPPORTED_REASON = saved_parse_reason

    return ExprParse { ok: parsed.ok, reg: ret_is_f64, next: parsed.next}
}

fn try_scan_closure_literal(pos: i64, token_count: i64) -> i64 with Mut, Panic, Div, Alloc {
    let start_kind = token_kind(pos)
    if start_kind != TK_OR && start_kind != TK_OROR { return pos + 1 }
    let param_start = V2_CLOSURE_PARAM_TOTAL
    var param_count: i64 = 0
    var p = pos + 1
    if start_kind == TK_OROR {
        if pos > 0 {
            let prev_kind = token_kind(pos - 1)
            if prev_kind != TK_EQ && prev_kind != TK_LPAREN && prev_kind != TK_COMMA && prev_kind != TK_RETURN && prev_kind != TK_LBRACE {
                return pos + 1
            }
        }
        p = pos
    } else {
        while p < token_count && token_kind(p) != TK_OR {
            if param_start + param_count >= 512 {
                V2_CLOSURE_PARAM_TOTAL = param_start
                return pos + 1
            }
            if token_kind(p) != TK_IDENT {
                V2_CLOSURE_PARAM_TOTAL = param_start
                return pos + 1
            }
            let param_name_tok = p
            var param_is_f64: i64 = 0
            if token_kind(p + 1) == TK_COLON {
                if token_kind(p + 2) != TK_IDENT {
                    V2_CLOSURE_PARAM_TOTAL = param_start
                    return pos + 1
                }
                if !token_text_eq(p + 2, "i64") && !token_text_eq(p + 2, "f64") {
                    V2_CLOSURE_PARAM_TOTAL = param_start
                    return pos + 1
                }
                if token_text_eq(p + 2, "f64") { param_is_f64 = 1 }
                p = p + 3
            } else {
                p = p + 1
            }
            let pslot = param_start + param_count
            V2_CLOSURE_PARAM_NAME_TOK[pslot as usize] = param_name_tok
            if param_is_f64 != 0 {
                V2_CLOSURE_PARAM_IS_F64[pslot as usize] = 1
            } else {
                V2_CLOSURE_PARAM_IS_F64[pslot as usize] = 0
            }
            param_count = param_count + 1
            if token_kind(p) == TK_COMMA { p = p + 1 }
            else if token_kind(p) != TK_OR {
                V2_CLOSURE_PARAM_TOTAL = param_start
                return pos + 1
            }
        }
        if p >= token_count || token_kind(p) != TK_OR || param_count <= 0 {
            V2_CLOSURE_PARAM_TOTAL = param_start
            return pos + 1
        }
    }
    var body_start = p + 1
    var literal_end: i64 = -1
    if token_kind(body_start) == TK_ARROW {
        body_start = body_start + 1
        if token_kind(body_start) != TK_IDENT {
            V2_CLOSURE_PARAM_TOTAL = param_start
            return pos + 1
        }
        body_start = body_start + 1
        while body_start < token_count && token_kind(body_start) != TK_LBRACE {
            body_start = body_start + 1
        }
        if body_start >= token_count || token_kind(body_start) != TK_LBRACE {
            V2_CLOSURE_PARAM_TOTAL = param_start
            return pos + 1
        }
        var brace_depth: i64 = 1
        var body_close = body_start + 1
        while body_close < token_count && brace_depth > 0 {
            let bk = token_kind(body_close)
            if bk == TK_LBRACE { brace_depth = brace_depth + 1 }
            if bk == TK_RBRACE { brace_depth = brace_depth - 1 }
            if brace_depth > 0 { body_close = body_close + 1 }
        }
        if body_close >= token_count || token_kind(body_close) != TK_RBRACE {
            V2_CLOSURE_PARAM_TOTAL = param_start
            return pos + 1
        }
        body_start = body_start + 1
        literal_end = body_close + 1
    }
    let probe = probe_closure_body_expr(body_start, param_start, param_count)
    if probe.ok == 0 || probe.next <= body_start {
        V2_CLOSURE_PARAM_TOTAL = param_start
        return pos + 1
    }
    if literal_end >= 0 && probe.next != literal_end - 1 {
        V2_CLOSURE_PARAM_TOTAL = param_start
        return pos + 1
    }
    if literal_end < 0 { literal_end = probe.next }
    let cidx = V2_CLOSURE_COUNT
    if cidx >= 128 {
        V2_CLOSURE_PARAM_TOTAL = param_start
        return pos + 1
    }
    V2_CLOSURE_START_TOK[cidx as usize] = pos
    V2_CLOSURE_BODY_START[cidx as usize] = body_start
    V2_CLOSURE_BODY_END[cidx as usize] = literal_end
    V2_CLOSURE_PARAM_START[cidx as usize] = param_start
    V2_CLOSURE_PARAM_COUNT[cidx as usize] = param_count
    V2_CLOSURE_FN_IDS[cidx as usize] = V2_FIRST_USER_FN_ID + V2_USER_FN_COUNT + 1 + cidx
    V2_CLOSURE_RETURN_IS_F64[cidx as usize] = probe.reg
    V2_CLOSURE_PARAM_TOTAL = param_start + param_count
    V2_CLOSURE_COUNT = cidx + 1
    return literal_end
}

fn scan_closure_literals(token_count: i64) with Mut, Panic, Div, Alloc {
    reset_closure_registry()
    var i: i64 = 0
    while i < token_count {
        let next_i = try_scan_closure_literal(i, token_count)
        if next_i > i { i = next_i }
        else { i = i + 1 }
    }
}

fn find_struct_idx_tok(name_tok: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < STRUCT_COUNT {
        if toks_ident_eq(STRUCT_NAME_TOKS[i as usize], name_tok) { return i }
        i = i + 1
    }
    -1
}

fn find_struct_idx_name(name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < STRUCT_COUNT {
        if name_eq(token_name(STRUCT_NAME_TOKS[i as usize]), name) { return i }
        i = i + 1
    }
    -1
}

fn struct_field_offset_tok(sidx: i64, field_tok: i64) -> i64 with Mut, Panic, Div {
    let start = STRUCT_FIELD_START[sidx as usize]
    let count = STRUCT_FIELD_COUNT[sidx as usize]
    var fi: i64 = 0
    while fi < count {
        if toks_ident_eq(STRUCT_FIELDS[(start + fi) as usize], field_tok) {
            return STRUCT_FIELD_FLAT_OFFSET[(start + fi) as usize]
        }
        fi = fi + 1
    }
    -1
}

fn struct_field_offset_name(sidx: i64, field_name: Name) -> i64 with Mut, Panic, Div {
    if sidx < 0 || sidx >= STRUCT_COUNT { return -1 }
    let start = STRUCT_FIELD_START[sidx as usize]
    let count = STRUCT_FIELD_COUNT[sidx as usize]
    var fi: i64 = 0
    while fi < count {
        if name_eq(token_name(STRUCT_FIELDS[(start + fi) as usize]), field_name) {
            return STRUCT_FIELD_FLAT_OFFSET[(start + fi) as usize]
        }
        fi = fi + 1
    }
    -1
}

// Returns the struct sidx of a field at positional index fi within struct sidx (-1 if scalar)
fn struct_field_type_at(sidx: i64, flat_off: i64) -> i64 with Mut {
    let start = STRUCT_FIELD_START[sidx as usize]
    let count = STRUCT_FIELD_COUNT[sidx as usize]
    var fi: i64 = 0
    while fi < count {
        if STRUCT_FIELD_FLAT_OFFSET[(start + fi) as usize] == flat_off {
            return STRUCT_FIELD_STRUCT_IDX[(start + fi) as usize]
        }
        fi = fi + 1
    }
    -1
}

fn struct_field_is_f64_at(sidx: i64, flat_off: i64) -> bool with Mut {
    let start = STRUCT_FIELD_START[sidx as usize]
    let count = STRUCT_FIELD_COUNT[sidx as usize]
    var fi: i64 = 0
    while fi < count {
        if STRUCT_FIELD_FLAT_OFFSET[(start + fi) as usize] == flat_off {
            return STRUCT_FIELD_IS_F64[(start + fi) as usize] != 0
        }
        fi = fi + 1
    }
    false
}

fn struct_field_generic_f64_at(sidx: i64, flat_off: i64) -> bool with Mut {
    let start = STRUCT_FIELD_START[sidx as usize]
    let count = STRUCT_FIELD_COUNT[sidx as usize]
    var fi: i64 = 0
    while fi < count {
        if STRUCT_FIELD_FLAT_OFFSET[(start + fi) as usize] == flat_off {
            return STRUCT_FIELD_GENERIC_F64[(start + fi) as usize] != 0
        }
        fi = fi + 1
    }
    false
}

// Flat register count for a field at flat_offset foff inside struct sidx.
// For scalar fields this is 1; for array/nested-struct fields it is the
// number of contiguous registers that field occupies.
fn struct_field_flat_size(sidx: i64, foff: i64) -> i64 with Mut {
    let start = STRUCT_FIELD_START[sidx as usize]
    let count = STRUCT_FIELD_COUNT[sidx as usize]
    var fi: i64 = 0
    while fi < count {
        if STRUCT_FIELD_FLAT_OFFSET[(start + fi) as usize] == foff {
            if fi + 1 < count {
                return STRUCT_FIELD_FLAT_OFFSET[(start + fi + 1) as usize] - foff
            }
            return STRUCT_FLAT_SIZE[sidx as usize] - foff
        }
        fi = fi + 1
    }
    1
}

fn is_cmp_op(k: i64) -> bool {
    k == TK_LT || k == TK_GT || k == TK_LE || k == TK_GE || k == TK_EQEQ || k == TK_BANGEQ
}

fn is_arith_op(k: i64) -> bool {
    k == TK_PLUS || k == TK_MINUS || k == TK_STAR || k == TK_SLASH ||
    k == TK_AMP || k == TK_OR || k == TK_XOR || k == TK_PCT ||
    k == TK_SHL || k == TK_SHR
}
fn is_mul_op(k: i64) -> bool {
    k == TK_STAR || k == TK_SLASH || k == TK_PCT
}
fn is_additive_op(k: i64) -> bool {
    k == TK_PLUS || k == TK_MINUS ||
    k == TK_AMP || k == TK_OR || k == TK_XOR || k == TK_SHL || k == TK_SHR
}

fn binary_op_from_cmp_kind(kind: i64) -> BinaryOp {
    if kind == TK_LT { return BinaryOp::OpLt }
    if kind == TK_GT { return BinaryOp::OpGt }
    if kind == TK_LE { return BinaryOp::OpLe }
    if kind == TK_GE { return BinaryOp::OpGe }
    if kind == TK_EQEQ { return BinaryOp::OpEq }
    BinaryOp::OpNe
}

fn emit_instr(func: &! IrFunction, instr: IrInstr) with Mut, Panic {
    let idx = (*func).instr_count
    if idx >= 0 && idx < 128 {
        ir_arena_store(ir_region_slot_w((*func).region, (idx)), instr)
        (*func).instr_count = idx + 1
    }
}

// op_kind → binop code for arith (1=add,2=sub,3=mul,4=div,11=and,12=or,13=xor,14=shl,15=shr,16=rem)
fn arith_op_to_code(k: i64) -> i64 {
    if k == TK_PLUS { return 1 }
    if k == TK_MINUS { return 2 }
    if k == TK_STAR { return 3 }
    if k == TK_SLASH { return 4 }
    if k == TK_AMP { return 11 }
    if k == TK_OR { return 12 }
    if k == TK_XOR { return 13 }
    if k == TK_SHL { return 14 }
    if k == TK_SHR { return 15 }
    if k == TK_PCT { return 16 }
    1
}

// op_kind → binop code for cmp (5=eq,6=ne,7=lt,8=le,9=gt,10=ge)
fn cmp_op_to_code(k: i64) -> i64 {
    if k == TK_EQEQ { return 5 }
    if k == TK_BANGEQ { return 6 }
    if k == TK_LT { return 7 }
    if k == TK_LE { return 8 }
    if k == TK_GT { return 9 }
    if k == TK_GE { return 10 }
    5
}

fn ufn_record_load_imm(dst: i64, value: i64) with Mut {
    let idx = V2_UFN_COUNT
    if idx < 4096 {
        V2_UFN_OPS[idx as usize] = UFN_LOAD_IMM
        V2_UFN_DST[idx as usize] = dst
        V2_UFN_IMM[idx as usize] = value
        V2_UFN_COUNT = idx + 1
    }
}

fn ufn_record_load_string(dst: i64, token_idx: i64) with Mut, Panic {
    let idx = V2_UFN_COUNT
    if idx < 4096 {
        V2_UFN_OPS[idx as usize] = UFN_LOAD_STRING
        V2_UFN_DST[idx as usize] = dst
        V2_UFN_STR_START[idx as usize] = pt_read_start(token_idx)
        V2_UFN_STR_END[idx as usize] = pt_read_end(token_idx)
        V2_UFN_COUNT = idx + 1
    }
}

