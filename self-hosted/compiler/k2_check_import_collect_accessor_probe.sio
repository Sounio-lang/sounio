use parser::ast::{ItemList}
use parser::parser::{parser_last_error_count}
use lexer::mod::{lex_file_parse_items}
use check::check::{
    Checker,
    checker_collect_items_mut,
    checker_error_count_scalar,
    checker_fn_sig_count_scalar,
    checker_init_in_place
}

fn k2_count_items(items: Option<Box<ItemList>>) -> i64 with Mut, Panic, Div, Alloc {
    match items {
        Some(list) => 1 + k2_count_items((*list).tail)
        None => 0
    }
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    print("k2_check_import_collect_accessor_probe=start\n")
    let argc = arg_count()
    if argc < 1 {
        print("usage: k2_check_import_collect_accessor_probe <source>\n")
        return 2
    }
    let source_path = get_arg(0)
    print("k2_check_import_collect_accessor_probe=parse_enter\n")
    let items = lex_file_parse_items(source_path)
    print("k2_check_import_collect_accessor_probe=parse_ok\n")
    if parser_last_error_count() > 0 {
        print("k2_check_import_collect_accessor_probe=parse_error\n")
        return 2
    }
    print("k2_check_import_collect_accessor_probe=item_count=")
    print_int(k2_count_items(items))
    print("\n")
    print("k2_check_import_collect_accessor_probe=alloc_enter\n")
    let checker = heap_alloc(8388608) as *mut Checker
    print("k2_check_import_collect_accessor_probe=alloc_ok\n")
    checker_init_in_place(checker)
    print("k2_check_import_collect_accessor_probe=init_ok\n")
    checker_collect_items_mut(checker, items)
    print("k2_check_import_collect_accessor_probe=collect_ok\n")
    let errors = checker_error_count_scalar(checker)
    let fn_sigs = checker_fn_sig_count_scalar(checker)
    print("k2_check_import_collect_accessor_probe=errors=")
    print_int(errors)
    print(" fn_sigs=")
    print_int(fn_sigs)
    print("\n")
    if fn_sigs > 0 {
        print("k2_check_import_collect_accessor_probe=ok\n")
        return 0
    }
    print("k2_check_import_collect_accessor_probe=bad\n")
    1
}
