// Focused E2 frontend probe. Runtime differential execution lives in the E2
// gate; this probe keeps module closure and lowering contracts checkable.

use enir::mod::*

fn main() with IO, Mut, Panic, Div, Alloc {
    let source = "epistemic fn probe() {\nlet a = 0.5\nlet b = 7.25\nlet c = a * b\ngate c\nstore [dose] <- c\n}\n"
    let lowered = enir_lower_source(source)
    assert(lowered.ok)
    assert(lowered.module.stage == ENIR_STAGE_LOWERED)
    assert(lowered.module.program_count == 1)
    assert(lowered.module.observation_count == 1)
    assert(lowered.module.op_count == 5)
    assert(enir_verify(lowered.module) == 0)
    let canonical = enir_print_canonical(lowered.module)
    let parsed = enir_parse(canonical)
    assert(parsed.ok)
    assert(enir_print_canonical(parsed.module) == canonical)
    println("ENIR_E2_LOWERING_PROBE_PASS")
}
