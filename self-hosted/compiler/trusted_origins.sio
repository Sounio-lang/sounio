// Compiler-owned physical origin registry. Source module names confer no authority.
module compiler::trusted_origins
use io::env::{read_env}
var TRUSTED_MODULE_FLAGS:[i64;256]=[0;256]
var TRUSTED_HOST_ABI:i64=0
var TRUSTED_WORKER_DEV:i64=0
var TRUSTED_WORKER_INO:i64=0
var TRUSTED_STORAGE_DEV:i64=0
var TRUSTED_STORAGE_INO:i64=0
var TRUSTED_READ_DEV:i64=0
var TRUSTED_READ_INO:i64=0
fn trusted_c_string(text:string)->i64 with Alloc,Mut,Div {
 let n=str_len(text)
 if n<=0 || n>1048576 {return 0}
 let p=heap_alloc(n+1) as *mut i8
 if (p as i64)<=0 {return 0}
 var i:i64=0
 while i<n {
  let ch=str_char_at(text,i)
  if ch==0 {heap_free(p);return 0}
  let cell=((p as i64)+i) as *mut i8
  *cell=ch as i8
  i=i+1
 }
 let last=((p as i64)+n) as *mut i8
 *last=0
 p as i64
}
// The graph is loaded serially. Scalar scratch avoids returning an allocated
// aggregate and avoids mutable global strings in the bootstrap compiler.
fn trusted_read_identity(path:string)->bool with IO,Alloc,Mut,Div,Panic {
 TRUSTED_READ_DEV=0
 TRUSTED_READ_INO=0
 if TRUSTED_HOST_ABI!=1 {return false}
 let name=trusted_c_string(path)
 let buf=heap_alloc(256) as *mut i8
 if name==0 || (buf as i64)<=0 {
  if name!=0 {heap_free(name as *mut i8)}
  if (buf as i64)>0 {heap_free(buf)}
  return false
 }
 // Linux x86-64 newfstatat(AT_FDCWD,path,buf,0), following links. The host
 // process ABI was checked before this branch; no guessed syscall on other ABIs.
 let rc=syscall6(262,0-100,name,buf as i64,0,0,0)
 if rc==0 {
  TRUSTED_READ_DEV=read_i64(buf as i64,0)
  TRUSTED_READ_INO=read_i64(buf as i64,1)
 }
 heap_free(name as *mut i8)
 heap_free(buf)
 rc==0 && TRUSTED_READ_INO!=0
}
pub fn trusted_origins_reset() with IO,Alloc,Mut,Div,Panic {
 var i:i64=0
 while i<256 {TRUSTED_MODULE_FLAGS[i as usize]=0;i=i+1}
 TRUSTED_HOST_ABI=0
 TRUSTED_WORKER_DEV=0
 TRUSTED_WORKER_INO=0
 TRUSTED_STORAGE_DEV=0
 TRUSTED_STORAGE_INO=0
 // The admitted ABI belongs to the running compiler, not its output target.
 if file_size("/proc/self/exe")<64 {return}
 let image=read_file("/proc/self/exe")
 if image[0 as usize]!=127 || image[1 as usize]!=69 || image[2 as usize]!=76 || image[3 as usize]!=70 {return}
 if image[4 as usize]!=2 || image[5 as usize]!=1 || image[18 as usize]!=62 || image[19 as usize]!=0 {return}
 var root=read_env("SOUNIO_STDLIB_PATH")
 if str_len(root)>=512 {return}
 if str_len(root)==0 {root="stdlib"}
 TRUSTED_HOST_ABI=1
 if trusted_read_identity(str_concat(root,"/ffi/worker.sio")) {
  TRUSTED_WORKER_DEV=TRUSTED_READ_DEV
  TRUSTED_WORKER_INO=TRUSTED_READ_INO
 }
 if trusted_read_identity(str_concat(root,"/mem/typed_storage.sio")) {
  TRUSTED_STORAGE_DEV=TRUSTED_READ_DEV
  TRUSTED_STORAGE_INO=TRUSTED_READ_INO
 }
}
pub fn trusted_origins_note(module_id:i64,path:string) with IO,Alloc,Mut,Div,Panic {
 if module_id<0 || module_id>=256 || !trusted_read_identity(path) {return}
 if TRUSTED_WORKER_INO!=0 && TRUSTED_READ_DEV==TRUSTED_WORKER_DEV && TRUSTED_READ_INO==TRUSTED_WORKER_INO {
  TRUSTED_MODULE_FLAGS[module_id as usize]=TRUSTED_MODULE_FLAGS[module_id as usize]|1
 }
 if TRUSTED_STORAGE_INO!=0 && TRUSTED_READ_DEV==TRUSTED_STORAGE_DEV && TRUSTED_READ_INO==TRUSTED_STORAGE_INO {
  TRUSTED_MODULE_FLAGS[module_id as usize]=TRUSTED_MODULE_FLAGS[module_id as usize]|2
 }
}
pub fn trusted_origin_is_worker(module_id:i64)->bool with Mut {
 if module_id<0 || module_id>=256 {return false}
 (TRUSTED_MODULE_FLAGS[module_id as usize]&1)!=0
}
pub fn trusted_origin_is_storage(module_id:i64)->bool with Mut {
 if module_id<0 || module_id>=256 {return false}
 (TRUSTED_MODULE_FLAGS[module_id as usize]&2)!=0
}
