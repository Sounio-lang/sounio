use knowledge_runtime_guard_lowering_plan::{knowledge_runtime_guard_native_emission_step_at}

fn print_bool_digit(value: bool) with IO {
    if value {
        print("1")
    } else {
        print("0")
    }
}

fn parse_dec_arg(s: string) -> i64 with Mut, Panic, Div {
    var v: i64 = 0
    var i: i64 = 0
    let n = str_len(s)
    while i < n {
        let c = str_char_at(s, i)
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48)
        }
        i = i + 1
    }
    v
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    var path = "tests/frontend/knowledge_runtime_guard_directive_positive.sio"
    if argc >= 1 {
        path = get_arg(0)
    }
    var row_index: i64 = 0
    if argc >= 2 {
        row_index = parse_dec_arg(get_arg(1))
    }
    var step_index: i64 = 0
    if argc >= 3 {
        step_index = parse_dec_arg(get_arg(2))
    }

    let step = knowledge_runtime_guard_native_emission_step_at(path, row_index, step_index)
    print("knowledge_runtime_guard_native_emission_step_row_index=")
    print_int(step.row_index)
    print(" step_index=")
    print_int(step.step_index)
    print(" step_ready=")
    print_bool_digit(step.step_ready)
    print(" plan_ready=")
    print_bool_digit(step.plan_ready)
    print(" source_valid=")
    print_bool_digit(step.source_valid)
    print(" in_bounds=")
    print_bool_digit(step.in_bounds)
    print(" total_step_count=")
    print_int(step.total_step_count)
    print(" op_kind=")
    print_int(step.op_kind)
    print(" dst_role=")
    print_int(step.dst_role)
    print(" src1_role=")
    print_int(step.src1_role)
    print(" src2_role=")
    print_int(step.src2_role)
    print(" threshold_kind=")
    print_int(step.threshold_kind)
    print(" threshold_int_value=")
    print_int(step.threshold_int_value)
    print(" threshold_float_value=")
    print_f64(step.threshold_float_value)
    print(" threshold_scaled_value=")
    print_int(step.threshold_scaled_value)
    print(" threshold_scale=")
    print_int(step.threshold_scale)
    print(" native_cmp_code=")
    print_int(step.native_cmp_code)
    print(" native_trap_builtin_id=")
    print_int(step.native_trap_builtin_id)
    print(" label_role=")
    print_int(step.label_role)
    print("\n")
    0
}
