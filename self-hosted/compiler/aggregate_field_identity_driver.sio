//@ ignore
// Reduced current-source compiler driver for aggregate_field_identity_main.sio.
// This avoids the unrelated monolithic main.sio bootstrap wall while executing
// the same modular frontend, IR lowerer, and native backend used by Madaros.

// The first four imports fix the order in which the lean_single seed meets
// same-named items, as main.sio does (for example parser::ast's `Name` before
// gpu/kernel_ir.sio's, and codegen_x86_linux.sio's private
// `finalize_elf64_shared` before native/codegen.sio's). Without them the seed
// reported three errors here (check.sio:18295, normalize.sio:271,
// codegen_x86_linux.sio:19147), which are fatal since imported-module errors are.
use lexer::mod::*
use parser::ast::*
use ir::ir::*
use native::codegen_x86_linux::*
use module_native_driver::{compile_multimodule_native}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    compile_multimodule_native(
        "tests/diagnose/aggregate_field_identity_main.sio",
        "/tmp/sounio-aggregate-field-identity-current-source",
        "x86_64-linux",
        "",
        false,
        "",
        "",
        false,
    ) as i64
}
