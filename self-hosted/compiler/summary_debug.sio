use parser::ast::*
use parser::parser::{parser_last_error_count}
use ir::ir::*
use check::mod::{check_program_epistemic_into}
use module_parse::{load_module_file}
use ir::lower::{lower_program_to_ir_summary_with_epistemic_ref, lower_program_to_ir_summary_box_with_epistemic_ref}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let prog = load_module_file("tests/frontend/lowering_stability_min_main.sio")
    var epistemic = ir_empty_epistemic_section()
    if !check_program_epistemic_into(prog, &! epistemic) {
        print("summary_debug: typecheck_fail\n")
        return 1
    }
    let parse_errors = parser_last_error_count()
    print("summary_debug: parser_errors=")
    print_int(parse_errors)
    print("\n")

    let summary_result = lower_program_to_ir_summary_with_epistemic_ref(&prog, epistemic)
    print("summary_debug: flat had_error=")
    if summary_result.had_error { print("true") } else { print("false") }
    print(" error_count=")
    print_int(summary_result.error_count)
    print(" fn_count=")
    print_int((*summary_result.summary.module).fn_count)
    print("\n")

    let boxed_result = lower_program_to_ir_summary_box_with_epistemic_ref(&prog, epistemic)
    print("summary_debug: boxed had_error=")
    if boxed_result.had_error { print("true") } else { print("false") }
    print(" error_count=")
    print_int(boxed_result.error_count)
    print(" fn_count=")
    print_int((*(*boxed_result.summary).module).fn_count)
    print("\n")
    0
}
