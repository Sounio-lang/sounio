// Focused E1 probe: compiler-owned ENIR only, with no lowering/codegen import.

use enir::mod::*

fn main() with IO, Mut, Panic, Div, Alloc {
    let module = enir_shadow_fixture()
    assert(enir_verify(module) == 0)

    let canonical = enir_print_canonical(module)
    let parsed = enir_parse(canonical)
    assert(parsed.ok)
    assert(enir_verify(parsed.module) == 0)
    assert(enir_print_canonical(parsed.module) == canonical)
    assert(parsed.module.program_count == 30)
    assert(parsed.module.observation_count == 39)

    print("ENIR_SHADOW_PROBE_PASS hash=")
    print_int(enir_canonical_hash_l64(canonical))
    print(" programs=30 observations=39\n")
}
