// self-hosted::compiler::module_loader
//
// Multi-module compilation with resolve_modules integration.
// Pipeline: parse main → extract imports → load deps → resolve_modules
//           → check all → lower all → merge IR → serialize

// Horizon 2: wire parser/ast types via use import.
// Cross-directory resolution works via the parent-dir fallback in the souc resolver.
// Symbols from modules that still have unresolved deps are left as forward refs
// (accepted by the self-hosted runtime's flat-bundle approach).
use parser::ast::*
use lexer::mod::*
use ir::ir::*
use check::types::*
use check::mod::{check_program_ok, check_program_epistemic_into}
use resolve::mod::{resolve_modules, ResolveBatchResult}
use resolve::resolve::*
use resolve::imports::*
use resolve::symbol::*
use resolve::scope::*
use parser::mod::{parse_program, count_items}
use io::file_write::*
use ir::lower::{lower_program_to_ir, lower_program_to_ir_with_epistemic}
use ir::serialize::{serialize_ir_module}
use native::encode::*
use native::elf::*
use native::reloc::*
use native::frame::*
use wasm::core::*
use wasm::encode::*
use wasm::lower::*
use native::codegen::*

// ============================================================
// Path conversion: AstPath segments → string
// ============================================================

fn string_list_seg_to_buf(sl: StringList, out: [i8; 512], pos: i64) -> ([i8; 512], i64) with Mut, Panic, Div {
    var buf = out
    var p = pos
    // Copy this segment's bytes
    var i: i64 = 0
    while i < sl.head_len && p < 500 {
        buf[p] = sl.head_buf[i]
        p = p + 1
        i = i + 1
    }
    (buf, p)
}

fn string_list_to_path_buf(sl: StringList, sep_a: i8, sep_b: i8, out: [i8; 512], pos: i64) -> ([i8; 512], i64) with Mut, Panic, Div, Alloc {
    // Copy head segment
    let (buf1, p1) = string_list_seg_to_buf(sl, out, pos)
    // If there is a tail, add separator and recurse
    match sl.tail {
        None => (buf1, p1)
        Some(next) => {
            var buf2 = buf1
            var p2 = p1
            if p2 < 500 {
                buf2[p2] = sep_a
                p2 = p2 + 1
            }
            if sep_b != (0 as i8) && p2 < 500 {
                buf2[p2] = sep_b
                p2 = p2 + 1
            }
            string_list_to_path_buf(*next, sep_a, sep_b, buf2, p2)
        }
    }
}

fn use_path_to_string(path: AstPath) -> string with Mut, Panic, Div, Alloc {
    // Convert AstPath to "seg1::seg2::seg3" string
    if path.seg_count == 0 {
        return ""
    }
    var buf: [i8; 512] = [0; 512]
    // Use :: as separator (58 = ':', 58 = ':')
    let (result_buf, result_len) = string_list_to_path_buf(path.segments, 58 as i8, 58 as i8, buf, 0)
    // Convert [i8; 512] to string via byte printing
    buf_to_string(result_buf, result_len)
}

// Check if a StringList head segment is exactly "super" (115,117,112,101,114)
fn seg_is_super(sl: StringList) -> bool {
    if sl.head_len != 5 { return false }
    sl.head_buf[0] == (115 as i8) &&
    sl.head_buf[1] == (117 as i8) &&
    sl.head_buf[2] == (112 as i8) &&
    sl.head_buf[3] == (101 as i8) &&
    sl.head_buf[4] == (114 as i8)
}

// Strip the last directory component from a path buffer.
// "/a/b/c" -> "/a/b" (returns index of last '/')
fn buf_strip_last_dir(buf: [i8; 512], len: i64) -> ([i8; 512], i64) with Mut, Panic, Div {
    var i = len - 1
    while i > 0 {
        if buf[i as usize] == (47 as i8) {
            return (buf, i)
        }
        i = i - 1
    }
    (buf, len)
}

// Process path segments into buf, handling "super" as parent-dir navigation.
// Each non-super segment is appended as "/seg"; "super" strips the last dir component.
fn use_path_segs_to_buf(sl: StringList, out: [i8; 512], pos: i64) -> ([i8; 512], i64) with Mut, Panic, Div, Alloc {
    if seg_is_super(sl) {
        let (stripped, new_pos) = buf_strip_last_dir(out, pos)
        match sl.tail {
            None => (stripped, new_pos)
            Some(next) => use_path_segs_to_buf(*next, stripped, new_pos)
        }
    } else {
        var buf2 = out
        var p2 = pos
        if p2 < 500 {
            buf2[p2] = 47 as i8  // '/'
            p2 = p2 + 1
        }
        let (buf3, p3) = string_list_seg_to_buf(sl, buf2, p2)
        match sl.tail {
            None => (buf3, p3)
            Some(next) => use_path_segs_to_buf(*next, buf3, p3)
        }
    }
}

fn use_path_to_file_path(path: AstPath, prefix: string) -> string with Mut, Panic, Div, Alloc {
    // Convert AstPath to "prefix/seg1/seg2/seg3.sio" file path.
    // "super" segments navigate up one directory level.
    if path.seg_count == 0 {
        return ""
    }
    var buf: [i8; 512] = [0; 512]
    var pos: i64 = 0
    // Write prefix bytes (no trailing slash — segments add their own leading slash)
    let prefix_len = str_len(prefix)
    var pi: i64 = 0
    while pi < prefix_len && pos < 490 {
        buf[pos] = str_char_at(prefix, pi) as i8
        pos = pos + 1
        pi = pi + 1
    }
    // Process all segments (super-aware)
    let (result_buf, result_len) = use_path_segs_to_buf(path.segments, buf, pos)
    // Append ".sio"
    var final_buf = result_buf
    var fp = result_len
    if fp < 508 {
        final_buf[fp] = 46 as i8      // '.'
        final_buf[fp + 1] = 115 as i8 // 's'
        final_buf[fp + 2] = 105 as i8 // 'i'
        final_buf[fp + 3] = 111 as i8 // 'o'
        fp = fp + 4
    }
    buf_to_string(final_buf, fp)
}

// Convert byte buffer to VM string using str_from_bytes builtin
fn buf_to_string(buf: [i8; 512], len: i64) -> string with Mut, Panic, Div {
    str_from_bytes(buf, len)
}

// ============================================================
// Import extraction
// ============================================================

struct ImportList {
    paths: [AstPath; 64],
    count: i64,
}

fn extract_imports_from_ast(prog: Program) -> ImportList with Mut, Panic, Div, Alloc {
    var imports = ImportList {
        paths: [empty_path(); 64],
        count: 0,
    }

    match prog.items {
        None => imports
        Some(items) => {
            extract_imports_walk(*items, imports)
        }
    }
}

fn extract_imports_walk(list: ItemList, acc: ImportList) -> ImportList with Mut, Panic, Div, Alloc {
    var imports = acc
    if list.head.kind == ItemKind::ItemUse {
        if imports.count < 64 {
            imports.paths[imports.count] = list.head.use_path
            imports.count = imports.count + 1
        }
    }
    match list.tail {
        None => imports
        Some(next) => extract_imports_walk(*next, imports)
    }
}

// ============================================================
// Module loading
// ============================================================

fn file_exists(path: string) -> bool with IO {
    file_size(path) > 0
}

fn empty_program() -> Program {
    Program {
        module_path: empty_path(),
        items: None,
    }
}

fn load_module_file(path: string) -> Program with IO, Mut, Div, Panic, Alloc {
    let state = io_read_source_file(path)
    var prog = parse_program(state.tokens, state.token_count)
    prog.module_path = file_path_to_module_path(path)
    prog
}

fn file_path_to_module_path(path: string) -> AstPath with Mut, Panic, Div {
    var seg_buf: [i8; 128] = [0; 128]
    var seg_len: i64 = 0
    var segs = StringList { head_buf: [0; 128], head_len: 0, tail: None }
    var seg_count: i64 = 0
    var path_len = str_len(path)
    var i: i64 = 0
    var last_slash: i64 = 0 - 1
    var dot_pos: i64 = path_len
    while i < path_len {
        let ch = str_char_at(path, i)
        if ch == 47 {
            last_slash = i
        }
        if ch == 46 {
            dot_pos = i
        }
        i = i + 1
    }
    var start = last_slash + 1
    var end = dot_pos
    if end <= start {
        end = path_len
    }
    seg_len = 0
    i = start
    while i < end && seg_len < 128 {
        seg_buf[seg_len] = str_char_at(path, i) as i8
        seg_len = seg_len + 1
        i = i + 1
    }
    segs.head_buf = seg_buf
    segs.head_len = seg_len
    AstPath { segments: segs, seg_count: 1 }
}

fn path_directory(path: string) -> string with Mut, Panic, Div {
    var path_len = str_len(path)
    var last_slash: i64 = 0 - 1
    var i: i64 = 0
    while i < path_len {
        if str_char_at(path, i) == 47 {
            last_slash = i
        }
        i = i + 1
    }
    if last_slash < 0 {
        return "."
    }
    var buf: [i8; 512] = [0; 512]
    i = 0
    while i <= last_slash && i < 511 {
        buf[i] = str_char_at(path, i) as i8
        i = i + 1
    }
    str_from_bytes(buf, last_slash)
}

fn ir_epistemic_offset_id(id: i64, offset: i64) -> i64 {
    if id >= 0 { id + offset } else { id }
}

fn ir_merge_adjust_epistemic_instr(
    instr: IrInstr,
    contest_offset: i64,
    robust_offset: i64,
    decision_offset: i64,
    deferred_offset: i64,
    validated_offset: i64,
    acquisition_plan_offset: i64,
    recourse_plan_offset: i64,
    alternative_set_offset: i64
) -> IrInstr {
    var out = instr
    if out.op == IrOpcode::IrContest || out.op == IrOpcode::IrLiftKnowledge {
        out.label_id = ir_epistemic_offset_id(out.label_id, contest_offset)
    } else if out.op == IrOpcode::IrProveRobust {
        out.label_id = ir_epistemic_offset_id(out.label_id, robust_offset)
    } else if out.op == IrOpcode::IrAdmitAction {
        out.label_id = ir_epistemic_offset_id(out.label_id, decision_offset)
    } else if out.op == IrOpcode::IrDeferAction {
        out.label_id = ir_epistemic_offset_id(out.label_id, deferred_offset)
    } else if out.op == IrOpcode::IrValidated {
        out.label_id = ir_epistemic_offset_id(out.label_id, validated_offset)
    } else if out.op == IrOpcode::IrPlanAcquisition {
        out.label_id = ir_epistemic_offset_id(out.label_id, acquisition_plan_offset)
    } else if out.op == IrOpcode::IrPlanRecourse {
        out.label_id = ir_epistemic_offset_id(out.label_id, recourse_plan_offset)
    } else if out.op == IrOpcode::IrProposeAlternatives {
        out.label_id = ir_epistemic_offset_id(out.label_id, alternative_set_offset)
    }
    out
}

fn ir_merge_epistemic_sections(dst: IrEpistemicSection, src: IrEpistemicSection) -> IrEpistemicSection with Mut, Panic, Div {
    var merged = dst
    let family_offset = dst.model_family_count
    let policy_offset = dst.policy_count
    let decision_policy_offset = dst.decision_policy_count
    let deferral_policy_offset = dst.deferral_policy_count
    let acquisition_policy_offset = dst.acquisition_policy_count
    let recourse_policy_offset = dst.recourse_policy_count
    let validation_offset = dst.validation_count
    let mechanistic_offset = dst.mechanistic_report_count
    let posterior_weights_offset = dst.posterior_weights_count
    let counterexample_offset = dst.counterexample_count
    let audit_offset = dst.audit_count
    let contest_offset = dst.contest_count
    let contest_witness_offset = dst.contest_witness_count
    let robust_offset = dst.robust_proof_count
    let decision_certificate_offset = dst.decision_certificate_count
    let deferred_certificate_offset = dst.deferred_certificate_count
    let deferred_reason_witness_offset = dst.deferred_reason_witness_count
    let acquisition_plan_offset = dst.acquisition_plan_count
    let acquisition_reason_witness_offset = dst.acquisition_reason_witness_count
    let recourse_plan_offset = dst.recourse_plan_count
    let recourse_reason_witness_offset = dst.recourse_reason_witness_count
    let alternative_policy_offset = dst.alternative_policy_count
    let alternative_frontier_offset = dst.alternative_frontier_count
    let alternative_candidate_offset = dst.alternative_candidate_count
    let alternative_set_offset = dst.alternative_set_count
    let alternative_reason_witness_offset = dst.alternative_reason_witness_count
    let validated_offset = dst.validated_manifest_count

    var i: i64 = 0
    while i < src.model_family_count && merged.model_family_count < IR_MAX_EPI_MODEL_FAMILIES {
        var info = src.model_families[i]
        info.id = merged.model_family_count
        merged.model_families[merged.model_family_count as usize] = info
        merged.model_family_count = merged.model_family_count + 1
        i = i + 1
    }

    i = 0
    while i < src.policy_count && merged.policy_count < IR_MAX_EPI_POLICIES {
        var info = src.policies[i]
        info.id = merged.policy_count
        merged.policies[merged.policy_count as usize] = info
        merged.policy_count = merged.policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.decision_policy_count && merged.decision_policy_count < IR_MAX_EPI_DECISION_POLICIES {
        var info = src.decision_policies[i]
        info.id = merged.decision_policy_count
        merged.decision_policies[merged.decision_policy_count as usize] = info
        merged.decision_policy_count = merged.decision_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.deferral_policy_count && merged.deferral_policy_count < IR_MAX_EPI_DEFERRAL_POLICIES {
        var info = src.deferral_policies[i]
        info.id = merged.deferral_policy_count
        merged.deferral_policies[merged.deferral_policy_count as usize] = info
        merged.deferral_policy_count = merged.deferral_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.acquisition_policy_count && merged.acquisition_policy_count < IR_MAX_EPI_ACQUISITION_POLICIES {
        var info = src.acquisition_policies[i]
        info.id = merged.acquisition_policy_count
        merged.acquisition_policies[merged.acquisition_policy_count as usize] = info
        merged.acquisition_policy_count = merged.acquisition_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.recourse_policy_count && merged.recourse_policy_count < IR_MAX_EPI_RECOURSE_POLICIES {
        var info = src.recourse_policies[i]
        info.id = merged.recourse_policy_count
        merged.recourse_policies[merged.recourse_policy_count as usize] = info
        merged.recourse_policy_count = merged.recourse_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.validation_count && merged.validation_count < IR_MAX_EPI_VALIDATIONS {
        var info = src.validations[i]
        info.id = merged.validation_count
        merged.validations[merged.validation_count as usize] = info
        merged.validation_count = merged.validation_count + 1
        i = i + 1
    }

    i = 0
    while i < src.mechanistic_report_count && merged.mechanistic_report_count < IR_MAX_EPI_MECHANISTIC_REPORTS {
        var info = src.mechanistic_reports[i]
        info.id = merged.mechanistic_report_count
        merged.mechanistic_reports[merged.mechanistic_report_count as usize] = info
        merged.mechanistic_report_count = merged.mechanistic_report_count + 1
        i = i + 1
    }

    i = 0
    while i < src.posterior_weights_count && merged.posterior_weights_count < IR_MAX_EPI_POSTERIOR_WEIGHTS {
        var info = src.posterior_weights[i]
        info.id = merged.posterior_weights_count
        merged.posterior_weights[merged.posterior_weights_count as usize] = info
        merged.posterior_weights_count = merged.posterior_weights_count + 1
        i = i + 1
    }

    i = 0
    while i < src.counterexample_count && merged.counterexample_count < IR_MAX_EPI_COUNTEREXAMPLES {
        var info = src.counterexamples[i]
        info.id = merged.counterexample_count
        merged.counterexamples[merged.counterexample_count as usize] = info
        merged.counterexample_count = merged.counterexample_count + 1
        i = i + 1
    }

    i = 0
    while i < src.audit_count && merged.audit_count < IR_MAX_EPI_AUDITS {
        var info = src.audits[i]
        info.id = merged.audit_count
        info.family_id = ir_epistemic_offset_id(info.family_id, family_offset)
        info.policy_id = ir_epistemic_offset_id(info.policy_id, policy_offset)
        info.mechanistic_report_id = ir_epistemic_offset_id(info.mechanistic_report_id, mechanistic_offset)
        info.posterior_weights_id = ir_epistemic_offset_id(info.posterior_weights_id, posterior_weights_offset)
        info.counterexample_id = ir_epistemic_offset_id(info.counterexample_id, counterexample_offset)
        merged.audits[merged.audit_count as usize] = info
        merged.audit_count = merged.audit_count + 1
        i = i + 1
    }

    i = 0
    while i < src.contest_count && merged.contest_count < IR_MAX_EPI_CONTESTS {
        var info = src.contests[i]
        info.id = merged.contest_count
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.family_id = ir_epistemic_offset_id(info.family_id, family_offset)
        info.policy_id = ir_epistemic_offset_id(info.policy_id, policy_offset)
        info.mechanistic_report_id = ir_epistemic_offset_id(info.mechanistic_report_id, mechanistic_offset)
        info.posterior_weights_id = ir_epistemic_offset_id(info.posterior_weights_id, posterior_weights_offset)
        info.counterexample_id = ir_epistemic_offset_id(info.counterexample_id, counterexample_offset)
        merged.contests[merged.contest_count as usize] = info
        merged.contest_count = merged.contest_count + 1
        i = i + 1
    }

    i = 0
    while i < src.contest_witness_count && merged.contest_witness_count < IR_MAX_EPI_CONTEST_WITNESSES {
        var info = src.contest_witnesses[i]
        info.id = merged.contest_witness_count
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        merged.contest_witnesses[merged.contest_witness_count as usize] = info
        merged.contest_witness_count = merged.contest_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < src.robust_proof_count && merged.robust_proof_count < IR_MAX_EPI_ROBUST_PROOFS {
        var info = src.robust_proofs[i]
        info.id = merged.robust_proof_count
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        info.policy_id = ir_epistemic_offset_id(info.policy_id, policy_offset)
        merged.robust_proofs[merged.robust_proof_count as usize] = info
        merged.robust_proof_count = merged.robust_proof_count + 1
        i = i + 1
    }

    i = 0
    while i < src.validated_manifest_count && merged.validated_manifest_count < IR_MAX_EPI_VALIDATED_MANIFESTS {
        var info = src.validated_manifests[i]
        info.id = merged.validated_manifest_count
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.robust_proof_id = ir_epistemic_offset_id(info.robust_proof_id, robust_offset)
        info.validation_id = ir_epistemic_offset_id(info.validation_id, validation_offset)
        merged.validated_manifests[merged.validated_manifest_count as usize] = info
        merged.validated_manifest_count = merged.validated_manifest_count + 1
        i = i + 1
    }

    i = 0
    while i < src.decision_certificate_count && merged.decision_certificate_count < IR_MAX_EPI_DECISION_CERTIFICATES {
        var info = src.decision_certificates[i]
        info.id = merged.decision_certificate_count
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.robust_proof_id = ir_epistemic_offset_id(info.robust_proof_id, robust_offset)
        info.decision_policy_id = ir_epistemic_offset_id(info.decision_policy_id, decision_policy_offset)
        merged.decision_certificates[merged.decision_certificate_count as usize] = info
        merged.decision_certificate_count = merged.decision_certificate_count + 1
        i = i + 1
    }

    i = 0
    while i < src.deferred_certificate_count && merged.deferred_certificate_count < IR_MAX_EPI_DEFERRED_CERTIFICATES {
        var info = src.deferred_certificates[i]
        info.id = merged.deferred_certificate_count
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        info.robust_proof_id = ir_epistemic_offset_id(info.robust_proof_id, robust_offset)
        info.deferral_policy_id = ir_epistemic_offset_id(info.deferral_policy_id, deferral_policy_offset)
        merged.deferred_certificates[merged.deferred_certificate_count as usize] = info
        merged.deferred_certificate_count = merged.deferred_certificate_count + 1
        i = i + 1
    }

    i = 0
    while i < src.deferred_reason_witness_count && merged.deferred_reason_witness_count < IR_MAX_EPI_DEFERRED_REASON_WITNESSES {
        var info = src.deferred_reason_witnesses[i]
        info.id = merged.deferred_reason_witness_count
        info.deferred_certificate_id = ir_epistemic_offset_id(info.deferred_certificate_id, deferred_certificate_offset)
        merged.deferred_reason_witnesses[merged.deferred_reason_witness_count as usize] = info
        merged.deferred_reason_witness_count = merged.deferred_reason_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < src.acquisition_plan_count && merged.acquisition_plan_count < IR_MAX_EPI_ACQUISITION_PLANS {
        var info = src.acquisition_plans[i]
        info.id = merged.acquisition_plan_count
        info.deferred_certificate_id = ir_epistemic_offset_id(info.deferred_certificate_id, deferred_certificate_offset)
        info.acquisition_policy_id = ir_epistemic_offset_id(info.acquisition_policy_id, acquisition_policy_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        merged.acquisition_plans[merged.acquisition_plan_count as usize] = info
        merged.acquisition_plan_count = merged.acquisition_plan_count + 1
        i = i + 1
    }

    i = 0
    while i < src.acquisition_reason_witness_count && merged.acquisition_reason_witness_count < IR_MAX_EPI_ACQUISITION_REASON_WITNESSES {
        var info = src.acquisition_reason_witnesses[i]
        info.id = merged.acquisition_reason_witness_count
        info.acquisition_plan_id = ir_epistemic_offset_id(info.acquisition_plan_id, acquisition_plan_offset)
        merged.acquisition_reason_witnesses[merged.acquisition_reason_witness_count as usize] = info
        merged.acquisition_reason_witness_count = merged.acquisition_reason_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < src.recourse_plan_count && merged.recourse_plan_count < IR_MAX_EPI_RECOURSE_PLANS {
        var info = src.recourse_plans[i]
        info.id = merged.recourse_plan_count
        info.deferred_certificate_id = ir_epistemic_offset_id(info.deferred_certificate_id, deferred_certificate_offset)
        info.recourse_policy_id = ir_epistemic_offset_id(info.recourse_policy_id, recourse_policy_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        merged.recourse_plans[merged.recourse_plan_count as usize] = info
        merged.recourse_plan_count = merged.recourse_plan_count + 1
        i = i + 1
    }

    i = 0
    while i < src.recourse_reason_witness_count && merged.recourse_reason_witness_count < IR_MAX_EPI_RECOURSE_REASON_WITNESSES {
        var info = src.recourse_reason_witnesses[i]
        info.id = merged.recourse_reason_witness_count
        info.recourse_plan_id = ir_epistemic_offset_id(info.recourse_plan_id, recourse_plan_offset)
        merged.recourse_reason_witnesses[merged.recourse_reason_witness_count as usize] = info
        merged.recourse_reason_witness_count = merged.recourse_reason_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < src.alternative_policy_count && merged.alternative_policy_count < IR_MAX_EPI_ALTERNATIVE_POLICIES {
        var info = src.alternative_policies[i]
        info.id = merged.alternative_policy_count
        merged.alternative_policies[merged.alternative_policy_count as usize] = info
        merged.alternative_policy_count = merged.alternative_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.alternative_frontier_count && merged.alternative_frontier_count < IR_MAX_EPI_ALTERNATIVE_FRONTIERS {
        var info = src.alternative_frontiers[i]
        info.id = merged.alternative_frontier_count
        info.alternative_policy_id = ir_epistemic_offset_id(info.alternative_policy_id, alternative_policy_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        info.source_policy_id = ir_epistemic_offset_id(info.source_policy_id, recourse_policy_offset)
        info.source_plan_id = ir_epistemic_offset_id(info.source_plan_id, recourse_plan_offset)
        info.candidate_start = ir_epistemic_offset_id(info.candidate_start, alternative_candidate_offset)
        merged.alternative_frontiers[merged.alternative_frontier_count as usize] = info
        merged.alternative_frontier_count = merged.alternative_frontier_count + 1
        i = i + 1
    }

    i = 0
    while i < src.alternative_candidate_count && merged.alternative_candidate_count < IR_MAX_EPI_ALTERNATIVE_CANDIDATES {
        var info = src.alternative_candidates[i]
        info.id = merged.alternative_candidate_count
        info.frontier_id = ir_epistemic_offset_id(info.frontier_id, alternative_frontier_offset)
        info.source_policy_id = ir_epistemic_offset_id(info.source_policy_id, recourse_policy_offset)
        info.source_plan_id = ir_epistemic_offset_id(info.source_plan_id, recourse_plan_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        merged.alternative_candidates[merged.alternative_candidate_count as usize] = info
        merged.alternative_candidate_count = merged.alternative_candidate_count + 1
        i = i + 1
    }

    i = 0
    while i < src.alternative_set_count && merged.alternative_set_count < IR_MAX_EPI_ALTERNATIVE_SETS {
        var info = src.alternative_sets[i]
        info.id = merged.alternative_set_count
        info.frontier_id = ir_epistemic_offset_id(info.frontier_id, alternative_frontier_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        info.candidate_start = ir_epistemic_offset_id(info.candidate_start, alternative_candidate_offset)
        merged.alternative_sets[merged.alternative_set_count as usize] = info
        merged.alternative_set_count = merged.alternative_set_count + 1
        i = i + 1
    }

    i = 0
    while i < src.alternative_reason_witness_count && merged.alternative_reason_witness_count < IR_MAX_EPI_ALTERNATIVE_REASON_WITNESSES {
        var info = src.alternative_reason_witnesses[i]
        info.id = merged.alternative_reason_witness_count
        info.alternative_set_id = ir_epistemic_offset_id(info.alternative_set_id, alternative_set_offset)
        info.candidate_id = ir_epistemic_offset_id(info.candidate_id, alternative_candidate_offset)
        merged.alternative_reason_witnesses[merged.alternative_reason_witness_count as usize] = info
        merged.alternative_reason_witness_count = merged.alternative_reason_witness_count + 1
        i = i + 1
    }

    merged
}

// ============================================================
// IR module merging
// ============================================================

fn ir_merge_modules(dst: IrModule, src: IrModule) -> IrModule with Mut, Panic, Div {
    // Merge src functions into dst, adjusting fn_ids in call instructions
    var merged = dst
    let fn_offset = dst.fn_count  // src function IDs shift by this amount
    let contest_offset = dst.epistemic.contest_count
    let robust_offset = dst.epistemic.robust_proof_count
    let decision_offset = dst.epistemic.decision_certificate_count
    let deferred_offset = dst.epistemic.deferred_certificate_count
    let validated_offset = dst.epistemic.validated_manifest_count
    let acquisition_plan_offset = dst.epistemic.acquisition_plan_count
    let recourse_plan_offset = dst.epistemic.recourse_plan_count
    let alternative_set_offset = dst.epistemic.alternative_set_count

    // Copy functions
    var fi: i64 = 0
    while fi < src.fn_count && merged.fn_count < IR_MAX_FUNCS {
        var func = src.functions[fi]
        // Adjust call targets: shift fn_id by fn_offset
        var ii: i64 = 0
        while ii < func.instr_count {
            if func.instrs[ii].op == IrOpcode::IrCall {
                if func.instrs[ii].fn_id >= 0 {
                    func.instrs[ii].fn_id = func.instrs[ii].fn_id + fn_offset
                }
            }
            func.instrs[ii] = ir_merge_adjust_epistemic_instr(
                func.instrs[ii],
                contest_offset,
                robust_offset,
                decision_offset,
                deferred_offset,
                validated_offset,
                acquisition_plan_offset,
                recourse_plan_offset,
                alternative_set_offset
            )
            ii = ii + 1
        }
        merged.functions[merged.fn_count] = func
        merged.fn_count = merged.fn_count + 1
        fi = fi + 1
    }

    // Merge string tables (simple append, no dedup for now)
    var si: i64 = 0
    while si < src.string_count && merged.string_count < IR_MAX_STRINGS {
        merged.string_table[merged.string_count] = src.string_table[si]
        merged.string_count = merged.string_count + 1
        si = si + 1
    }

    merged.epistemic = ir_merge_epistemic_sections(merged.epistemic, src.epistemic)

    merged
}

// ============================================================
// Visited-set helpers for transitive import resolution
// ============================================================

fn visited_contains(visited: [string; 64], count: i64, path: string) -> bool with Mut, Panic, Div {
    var j: i64 = 0
    while j < count {
        if str_eq(visited[j], path) {
            return true
        }
        j = j + 1
    }
    false
}

// ============================================================
// Multi-module IR loading (shared by bytecode + native paths)
// ============================================================

struct MultiModuleIrResult {
    ok: bool,
    module: IrModule,
    error_msg: string,
}

struct MultiModuleFrontendResult {
    ok: bool,
    error_msg: string,
}

fn multimodule_ir_ok(m: IrModule) -> MultiModuleIrResult {
    MultiModuleIrResult { ok: true, module: m, error_msg: "" }
}

fn multimodule_ir_error(msg: string) -> MultiModuleIrResult {
    MultiModuleIrResult { ok: false, module: ir_empty_module(), error_msg: msg }
}

fn multimodule_frontend_ok() -> MultiModuleFrontendResult {
    MultiModuleFrontendResult { ok: true, error_msg: "" }
}

fn multimodule_frontend_error(msg: string) -> MultiModuleFrontendResult {
    MultiModuleFrontendResult { ok: false, error_msg: msg }
}

fn preflight_multimodule_frontend(main_path: string) -> MultiModuleFrontendResult with IO, Mut, Div, Panic, Alloc {
    let main_prog = load_module_file(main_path)
    let main_items = count_items(main_prog)

    print("Main file: ")
    print_int(main_items)
    print(" items\n")

    var programs: [Program; 64] = [empty_program(); 64]
    var file_paths: [string; 64] = [""; 64]
    programs[0] = main_prog
    file_paths[0] = main_path
    var loaded: i64 = 1

    var visited_paths: [string; 64] = [""; 64]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1

    var work_front: i64 = 0
    var i: i64 = 0

    while work_front < loaded && loaded < 64 {
        let cur_dir = path_directory(file_paths[work_front])
        let work_imports = extract_imports_from_ast(programs[work_front])
        work_front = work_front + 1

        i = 0
        while i < work_imports.count && loaded < 64 {
            let file_path_local = use_path_to_file_path(work_imports.paths[i], cur_dir)
            let file_path_stdlib = use_path_to_file_path(work_imports.paths[i], "stdlib")
            var file_path = file_path_local
            if !file_exists(file_path_local) {
                file_path = file_path_stdlib
            }
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    print("Loading module: ")
                    print(file_path)
                    print("\n")
                    programs[loaded] = load_module_file(file_path)
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                } else {
                    print("Warning: module not found: ")
                    let path_str = use_path_to_string(work_imports.paths[i])
                    print(path_str)
                    print("\n")
                }
            }
            i = i + 1
        }
    }

    print("Loaded ")
    print_int(loaded)
    print(" modules\n")

    let main_imports = extract_imports_from_ast(programs[0])
    let needs_resolution = loaded > 1 || main_imports.count > 0
    if needs_resolution {
        let resolve_result = resolve_modules(programs, loaded)
        if resolve_result.had_error {
            print("Module resolution failed: ")
            print_int(resolve_result.error_count)
            print(" errors\n")
            return multimodule_frontend_error("module_resolution_failed")
        }
    } else {
        print("Resolve skip: single module with no imports\n")
    }

    i = 0
    while i < loaded {
        print("Type checking module ")
        print_int(i)
        print("\n")
        var epistemic = ir_empty_epistemic_section()
        if !check_program_epistemic_into(programs[i], &!epistemic) {
            print("Type check failed for module ")
            print_int(i)
            print("\n")
            return multimodule_frontend_error("type_check_failed")
        }
        print("Type check complete for module ")
        print_int(i)
        print("\n")
        i = i + 1
    }

    multimodule_frontend_ok()
}

fn load_multimodule_ir(main_path: string) -> MultiModuleIrResult with IO, Mut, Div, Panic, Alloc {
    let main_prog = load_module_file(main_path)
    var programs: [Program; 64] = [empty_program(); 64]
    var file_paths: [string; 64] = [""; 64]
    programs[0] = main_prog
    file_paths[0] = main_path
    var loaded: i64 = 1
    var visited_paths: [string; 64] = [""; 64]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1
    var work_front: i64 = 0
    var i: i64 = 0

    while work_front < loaded && loaded < 64 {
        let cur_dir = path_directory(file_paths[work_front])
        let work_imports = extract_imports_from_ast(programs[work_front])
        work_front = work_front + 1
        i = 0
        while i < work_imports.count && loaded < 64 {
            let file_path_local = use_path_to_file_path(work_imports.paths[i], cur_dir)
            let file_path_stdlib = use_path_to_file_path(work_imports.paths[i], "stdlib")
            var file_path = file_path_local
            if !file_exists(file_path_local) {
                file_path = file_path_stdlib
            }
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    programs[loaded] = load_module_file(file_path)
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                }
            }
            i = i + 1
        }
    }

    let main_imports = extract_imports_from_ast(programs[0])
    let needs_resolution = loaded > 1 || main_imports.count > 0
    if needs_resolution {
        let resolve_result = resolve_modules(programs, loaded)
        if resolve_result.had_error {
            return multimodule_ir_error("module_resolution_failed")
        }
    }

    // Step 6: Lower ALL modules to IR and merge.
    // Seed the merge with module 0 to avoid expensive empty-module initialization.
    if loaded <= 0 {
        return multimodule_ir_error("no_modules_loaded")
    }

    var seed_epistemic = ir_empty_epistemic_section()
    if !check_program_epistemic_into(programs[0], &!seed_epistemic) {
        print("Type check failed during IR lowering for module 0\n")
        return multimodule_ir_error("type_check_failed")
    }
    let seed_lower_result = lower_program_to_ir_with_epistemic(programs[0], seed_epistemic)
    if seed_lower_result.had_error {
        print("IR lowering failed for module 0\n")
        return multimodule_ir_error("ir_lowering_failed")
    }
    var merged_module = seed_lower_result.module

    i = 1
    while i < loaded {
        var epistemic = ir_empty_epistemic_section()
        if !check_program_epistemic_into(programs[i], &!epistemic) {
            print("Type check failed during IR lowering for module ")
            print_int(i)
            print("\n")
            return multimodule_ir_error("type_check_failed")
        }
        let lower_result = lower_program_to_ir_with_epistemic(programs[i], epistemic)
        if lower_result.had_error {
            print("IR lowering failed for module ")
            print_int(i)
            print("\n")
            return multimodule_ir_error("ir_lowering_failed")
        }
        merged_module = ir_merge_modules(merged_module, lower_result.module)
        i = i + 1
    }

    print("Merged IR: ")
    print_int(merged_module.fn_count)
    print(" functions\n")

    if merged_module.fn_count <= 0 {
        print("IR lowering produced empty module\n")
        return multimodule_ir_error("ir_lowering_empty_module")
    }

    multimodule_ir_ok(merged_module)
}

fn load_multimodule_epistemic_into(main_path: string, out: &! IrEpistemicSection) -> MultiModuleFrontendResult with IO, Mut, Div, Panic, Alloc {
    let main_prog = load_module_file(main_path)
    var programs: [Program; 64] = [empty_program(); 64]
    var file_paths: [string; 64] = [""; 64]
    programs[0] = main_prog
    file_paths[0] = main_path
    var loaded: i64 = 1
    var visited_paths: [string; 64] = [""; 64]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1
    var work_front: i64 = 0
    var i: i64 = 0

    while work_front < loaded && loaded < 64 {
        let cur_dir = path_directory(file_paths[work_front])
        let work_imports = extract_imports_from_ast(programs[work_front])
        work_front = work_front + 1
        i = 0
        while i < work_imports.count && loaded < 64 {
            let file_path_local = use_path_to_file_path(work_imports.paths[i], cur_dir)
            let file_path_stdlib = use_path_to_file_path(work_imports.paths[i], "stdlib")
            var file_path = file_path_local
            if !file_exists(file_path_local) {
                file_path = file_path_stdlib
            }
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    programs[loaded] = load_module_file(file_path)
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                }
            }
            i = i + 1
        }
    }

    let main_imports = extract_imports_from_ast(programs[0])
    let needs_resolution = loaded > 1 || main_imports.count > 0
    if needs_resolution {
        let resolve_result = resolve_modules(programs, loaded)
        if resolve_result.had_error {
            return multimodule_frontend_error("module_resolution_failed")
        }
    }

    if loaded == 1 {
        if !check_program_epistemic_into(programs[0], out) {
            return multimodule_frontend_error("type_check_failed")
        }
        return multimodule_frontend_ok()
    }

    var merged_epistemic = ir_empty_epistemic_section()
    i = 0
    while i < loaded {
        var epistemic = ir_empty_epistemic_section()
        if !check_program_epistemic_into(programs[i], &!epistemic) {
            return multimodule_frontend_error("type_check_failed")
        }
        merged_epistemic = ir_merge_epistemic_sections(merged_epistemic, epistemic)
        i = i + 1
    }

    (*out) = merged_epistemic
    multimodule_frontend_ok()
}

// ============================================================
// Multi-module compilation pipeline (bytecode output)
// ============================================================

fn compile_multimodule_program(main_path: string) -> BytecodeResult with IO, Mut, Div, Panic, Alloc {
    let ir_result = load_multimodule_ir(main_path)
    if !ir_result.ok {
        return bytecode_result_error(ir_result.error_msg)
    }

    let serialized = serialize_ir_module(ir_result.module)
    bytecode_result_ok(serialized.0, serialized.1)
}

// ============================================================
// Multi-module native compilation pipeline (ELF output)
// ============================================================

fn multimodule_native_trace_output_path() -> string {
    let override_path = read_env("SOUNIO_NATIVE_DECISION_TRACE_PATH")
    if str_len(override_path) > 0 {
        override_path
    } else {
        "artifacts/omega/native_decision_trace.v1.json"
    }
}

fn compile_multimodule_native_with_ir(
    main_path: string,
    preloaded_ir: IrModule,
    output_path: string,
    requested_target: string,
    requested_matrix: string,
    explicit_target: bool,
    gpu_target: string,
    gpu_binary_format: string,
    gpu_strict_parity: bool
) -> i32 with IO, Mut, Div, Panic, Alloc {
    if preloaded_ir.fn_count <= 0 {
        print("Error: IR module has no functions (ir_lowering_empty_module)\n")
        return 1
    }

    // WASM backend short-circuit — bypass native ELF path entirely
    if str_eq(requested_target, "wasm") {
        print("WASM dispatch: source=")
        print(main_path)
        print(" output=")
        print(output_path)
        print("\n")
        let wasm_result = wasm_lower_module(preloaded_ir)
        if wasm_result.error_count > 0 {
            print("WASM lowering failed: ")
            print_int(wasm_result.error_count)
            print(" error(s)\n")
            return 1
        }
        // Copy WasmBuf (262144 bytes) into 4MB staging buffer for io_write_native_binary
        var stage: [i8; 65536] = [0; 65536]
        var ci: i64 = 0
        while ci < wasm_result.buf.len && ci < 65536 {
            stage[ci as usize] = wasm_result.buf.data[ci as usize]
            ci = ci + 1
        }
        let write_ok = io_write_native_binary(output_path, stage, wasm_result.buf.len)
        if !write_ok {
            print("Error: Failed to write WASM binary to ")
            print(output_path)
            print("\n")
            return 1
        }
        print("WASM binary size: ")
        print_int(wasm_result.buf.len)
        print(" bytes\n")
        print("Written to ")
        print(output_path)
        print("\n")
        return 0
    }

    let target_spec = native_resolve_target(requested_target, requested_matrix, explicit_target)
    print("Native dispatch: requested=")
    print(target_spec.requested_target)
    print(" resolved=")
    print(target_spec.resolved_target)
    print(" matrix=")
    print(native_matrix_mode_string(target_spec.matrix_mode))
    print(" source=")
    print(native_target_source_string(target_spec.source_id))
    if str_len(target_spec.fallback_reason) > 0 {
        print(" fallback=")
        print(target_spec.fallback_reason)
    }
    if str_len(gpu_target) > 0 {
        print(" gpu_target=")
        print(gpu_target)
    }
    if str_len(gpu_binary_format) > 0 {
        print(" gpu_binary_format=")
        print(gpu_binary_format)
    }
    print(" gpu_strict_parity=")
    if gpu_strict_parity {
        print("true")
    } else {
        print("false")
    }
    print("\n")

    let native_result = compile_native(&preloaded_ir, target_spec)
    if !native_result.ok {
        let trace_ok = io_write_native_decision_trace(
            multimodule_native_trace_output_path(),
            target_spec.requested_target,
            target_spec.resolved_target,
            native_matrix_mode_string(target_spec.matrix_mode),
            native_target_source_string(target_spec.source_id),
            target_spec.fallback_reason,
            "native",
            false,
            native_result.error_code
        )
        if !trace_ok {
            print("Error: Failed to write native decision trace to ")
            print(multimodule_native_trace_output_path())
            print("\n")
            return 1
        }
        print("Native compilation failed: ")
        print(native_result.error_msg)
        print("\n")
        return 1
    }

    print("Native binary size: ")
    print_int(native_result.len)
    print(" bytes\n")

    let write_ok = io_write_native_binary(output_path, native_result.bytes, native_result.len)
    if !write_ok {
        let trace_ok = io_write_native_decision_trace(
            multimodule_native_trace_output_path(),
            target_spec.requested_target,
            target_spec.resolved_target,
            native_matrix_mode_string(target_spec.matrix_mode),
            native_target_source_string(target_spec.source_id),
            target_spec.fallback_reason,
            "native",
            false,
            ERR_OK()
        )
        if !trace_ok {
            print("Error: Failed to write native decision trace to ")
            print(multimodule_native_trace_output_path())
            print("\n")
            return 1
        }
        print("Error: Failed to write native binary to ")
        print(output_path)
        print("\n")
        return 1
    }

    let trace_ok = io_write_native_decision_trace(
        multimodule_native_trace_output_path(),
        target_spec.requested_target,
        target_spec.resolved_target,
        native_matrix_mode_string(target_spec.matrix_mode),
        native_target_source_string(target_spec.source_id),
        target_spec.fallback_reason,
        "native",
        true,
        ERR_OK()
    )
    if !trace_ok {
        print("Error: Failed to write native decision trace to ")
        print(multimodule_native_trace_output_path())
        print("\n")
        return 1
    }

    print("Written to ")
    print(output_path)
    print("\n")
    return 0
}

fn compile_multimodule_native(
    main_path: string,
    output_path: string,
    requested_target: string,
    requested_matrix: string,
    explicit_target: bool,
    gpu_target: string,
    gpu_binary_format: string,
    gpu_strict_parity: bool
) -> i32 with IO, Mut, Div, Panic, Alloc {
    // WASM backend short-circuit — bypass native ELF path entirely
    if str_eq(requested_target, "wasm") {
        let wir = load_multimodule_ir(main_path)
        if !wir.ok {
            print("Multi-module IR failed: ")
            print(wir.error_msg)
            print("\n")
            return 1
        }
        return compile_multimodule_native_with_ir(
            main_path,
            wir.module,
            output_path,
            requested_target,
            requested_matrix,
            explicit_target,
            gpu_target,
            gpu_binary_format,
            gpu_strict_parity
        )
    }

    let target_spec = native_resolve_target(requested_target, requested_matrix, explicit_target)
    print("Native dispatch: requested=")
    print(target_spec.requested_target)
    print(" resolved=")
    print(target_spec.resolved_target)
    print(" matrix=")
    print(native_matrix_mode_string(target_spec.matrix_mode))
    print(" source=")
    print(native_target_source_string(target_spec.source_id))
    if str_len(target_spec.fallback_reason) > 0 {
        print(" fallback=")
        print(target_spec.fallback_reason)
    }
    if str_len(gpu_target) > 0 {
        print(" gpu_target=")
        print(gpu_target)
    }
    if str_len(gpu_binary_format) > 0 {
        print(" gpu_binary_format=")
        print(gpu_binary_format)
    }
    print(" gpu_strict_parity=")
    if gpu_strict_parity {
        print("true")
    } else {
        print("false")
    }
    print("\n")

    let ir_result = load_multimodule_ir(main_path)
    if !ir_result.ok {
        print("Multi-module IR failed: ")
        print(ir_result.error_msg)
        print("\n")
        let trace_ok = io_write_native_decision_trace(
            multimodule_native_trace_output_path(),
            target_spec.requested_target,
            target_spec.resolved_target,
            native_matrix_mode_string(target_spec.matrix_mode),
            native_target_source_string(target_spec.source_id),
            target_spec.fallback_reason,
            "native",
            false,
            ERR_OK()
        )
        if !trace_ok {
            print("Error: Failed to write native decision trace to ")
            print(multimodule_native_trace_output_path())
            print("\n")
            return 1
        }
        return 1
    }

    let native_result = compile_native(&ir_result.module, target_spec)
    if !native_result.ok {
        let trace_ok = io_write_native_decision_trace(
            multimodule_native_trace_output_path(),
            target_spec.requested_target,
            target_spec.resolved_target,
            native_matrix_mode_string(target_spec.matrix_mode),
            native_target_source_string(target_spec.source_id),
            target_spec.fallback_reason,
            "native",
            false,
            native_result.error_code
        )
        if !trace_ok {
            print("Error: Failed to write native decision trace to ")
            print(multimodule_native_trace_output_path())
            print("\n")
            return 1
        }
        print("Native compilation failed: ")
        print(native_result.error_msg)
        print("\n")
        return 1
    }

    print("Native binary size: ")
    print_int(native_result.len)
    print(" bytes\n")

    let write_ok = io_write_native_binary(output_path, native_result.bytes, native_result.len)
    if !write_ok {
        let trace_ok = io_write_native_decision_trace(
            multimodule_native_trace_output_path(),
            target_spec.requested_target,
            target_spec.resolved_target,
            native_matrix_mode_string(target_spec.matrix_mode),
            native_target_source_string(target_spec.source_id),
            target_spec.fallback_reason,
            "native",
            false,
            ERR_OK()
        )
        if !trace_ok {
            print("Error: Failed to write native decision trace to ")
            print(multimodule_native_trace_output_path())
            print("\n")
            return 1
        }
        print("Error: Failed to write native binary to ")
        print(output_path)
        print("\n")
        return 1
    }

    let trace_ok = io_write_native_decision_trace(
        multimodule_native_trace_output_path(),
        target_spec.requested_target,
        target_spec.resolved_target,
        native_matrix_mode_string(target_spec.matrix_mode),
        native_target_source_string(target_spec.source_id),
        target_spec.fallback_reason,
        "native",
        true,
        ERR_OK()
    )
    if !trace_ok {
        print("Error: Failed to write native decision trace to ")
        print(multimodule_native_trace_output_path())
        print("\n")
        return 1
    }

    print("Written to ")
    print(output_path)
    print("\n")
    return 0
}

// ============================================================
// Result types
// ============================================================

struct BytecodeResult {
    ok: bool,
    bytecode: [i8; 131072],
    bytecode_len: i64,
    error_msg: string,
}

fn bytecode_result_ok(bytecode: [i8; 131072], len: i64) -> BytecodeResult {
    BytecodeResult {
        ok: true,
        bytecode: bytecode,
        bytecode_len: len,
        error_msg: "",
    }
}

fn bytecode_result_error(msg: string) -> BytecodeResult {
    BytecodeResult {
        ok: false,
        bytecode: [0; 131072],
        bytecode_len: 0,
        error_msg: msg,
    }
}
