// ============================================================
// Path conversion: AstPath segments → string
// ============================================================

fn compiler_ontology_home() -> string {
    ontology_default_home()
}

fn compiler_ontology_mode() -> string {
    ontology_default_mode()
}

fn compiler_ontology_cache_dir() -> string {
    ontology_default_cache_dir()
}

fn string_list_seg_to_buf(sl: StringList, out: [i8; 512], pos: i64) -> ([i8; 512], i64) with Mut, Panic, Div {
    var buf = out
    var p = pos
    // Copy this segment's bytes
    var i: i64 = 0
    while i < sl.head_len && p < 500 {
        buf[p] = sl.head_buf[i]
        p = p + 1
        i = i + 1
    }
    (buf, p)
}

fn string_list_to_path_buf(sl: StringList, sep_a: i8, sep_b: i8, out: [i8; 512], pos: i64) -> ([i8; 512], i64) with Mut, Panic, Div, Alloc {
    // Copy head segment
    let head_pair = string_list_seg_to_buf(sl, out, pos)
    // If there is a tail, add separator and recurse
    match sl.tail {
        None => head_pair
        Some(next) => {
            var buf2 = head_pair.0
            var p2 = head_pair.1
            if p2 < 500 {
                buf2[p2] = sep_a
                p2 = p2 + 1
            }
            if sep_b != (0 as i8) && p2 < 500 {
                buf2[p2] = sep_b
                p2 = p2 + 1
            }
            string_list_to_path_buf(*next, sep_a, sep_b, buf2, p2)
        }
    }
}

fn use_path_to_string(path: AstPath) -> string with Mut, Panic, Div, Alloc {
    // Convert AstPath to "seg1::seg2::seg3" string
    if path.seg_count == 0 {
        return ""
    }
    var buf: [i8; 512] = [0; 512]
    // Use :: as separator (58 = ':', 58 = ':')
    let path_pair = string_list_to_path_buf(path.segments, 58 as i8, 58 as i8, buf, 0)
    // Convert [i8; 512] to string via byte printing
    buf_to_string(path_pair.0, path_pair.1)
}

// Check if a StringList head segment is exactly "super" (115,117,112,101,114)
fn seg_is_super(sl: StringList) -> bool {
    if sl.head_len != 5 { return false }
    sl.head_buf[0] == (115 as i8) &&
    sl.head_buf[1] == (117 as i8) &&
    sl.head_buf[2] == (112 as i8) &&
    sl.head_buf[3] == (101 as i8) &&
    sl.head_buf[4] == (114 as i8)
}

// Strip the last directory component from a path buffer.
// "/a/b/c" -> "/a/b" (returns index of last '/')
fn buf_strip_last_dir(buf: [i8; 512], len: i64) -> ([i8; 512], i64) with Mut, Panic, Div {
    var i = len - 1
    while i > 0 {
        if buf[i as usize] == (47 as i8) {
            return (buf, i)
        }
        i = i - 1
    }
    (buf, len)
}

// Process path segments into buf, handling "super" as parent-dir navigation.
// Each non-super segment is appended as "/seg"; "super" strips the last dir component.
fn use_path_segs_to_buf(sl: StringList, out: [i8; 512], pos: i64) -> ([i8; 512], i64) with Mut, Panic, Div, Alloc {
    if seg_is_super(sl) {
        let strip_pair = buf_strip_last_dir(out, pos)
        match sl.tail {
            None => strip_pair
            Some(next) => use_path_segs_to_buf(*next, strip_pair.0, strip_pair.1)
        }
    } else {
        var buf2 = out
        var p2 = pos
        if p2 < 500 {
            buf2[p2] = 47 as i8  // '/'
            p2 = p2 + 1
        }
        let seg_pair = string_list_seg_to_buf(sl, buf2, p2)
        match sl.tail {
            None => seg_pair
            Some(next) => use_path_segs_to_buf(*next, seg_pair.0, seg_pair.1)
        }
    }
}

fn use_path_to_file_path(path: AstPath, prefix: string) -> string with Mut, Panic, Div, Alloc {
    // Convert AstPath to "prefix/seg1/seg2/seg3.sio" file path.
    // "super" segments navigate up one directory level.
    if path.seg_count == 0 {
        return ""
    }
    var buf: [i8; 512] = [0; 512]
    var pos: i64 = 0
    // Write prefix bytes (no trailing slash — segments add their own leading slash)
    let prefix_len = str_len(prefix)
    var pi: i64 = 0
    while pi < prefix_len && pos < 490 {
        buf[pos] = str_char_at(prefix, pi) as i8
        pos = pos + 1
        pi = pi + 1
    }
    // Process all segments (super-aware)
    let path_pair = use_path_segs_to_buf(path.segments, buf, pos)
    // Append ".sio"
    var final_buf = path_pair.0
    var fp = path_pair.1
    if fp < 508 {
        final_buf[fp] = 46 as i8      // '.'
        final_buf[fp + 1] = 115 as i8 // 's'
        final_buf[fp + 2] = 105 as i8 // 'i'
        final_buf[fp + 3] = 111 as i8 // 'o'
        fp = fp + 4
    }
    buf_to_string(final_buf, fp)
}

fn buf_append_lit(buf: [i8; 512], pos: i64, lit: string) -> ([i8; 512], i64) with Mut, Panic, Div {
    let n = str_len(lit)
    var i: i64 = 0
    var p = pos
    var out = buf
    while i < n && p < 500 {
        out[p] = str_char_at(lit, i) as i8
        p = p + 1
        i = i + 1
    }
    (out, p)
}

fn string_list_seg_to_buf_mapped(sl: StringList, out: [i8; 512], pos: i64, map_underscore: bool) -> ([i8; 512], i64) with Mut, Panic, Div {
    var buf = out
    var p = pos
    var i: i64 = 0
    while i < sl.head_len && p < 500 {
        var c = sl.head_buf[i]
        if map_underscore && c == (95 as i8) {
            c = 45 as i8
        }
        buf[p] = c
        p = p + 1
        i = i + 1
    }
    (buf, p)
}

fn use_path_to_package_file_path(path: AstPath) -> string with Mut, Panic, Div, Alloc {
    if path.seg_count == 0 {
        return ""
    }
    var buf: [i8; 512] = [0; 512]
    var pos: i64 = 0
    let p1 = buf_append_lit(buf, pos, "packages/")
    buf = p1.0
    pos = p1.1
    let root_pair = string_list_seg_to_buf_mapped(path.segments, buf, pos, true)
    buf = root_pair.0
    pos = root_pair.1
    let p2 = buf_append_lit(buf, pos, "/src")
    buf = p2.0
    pos = p2.1
    match path.segments.tail {
        None => {
            let p3 = buf_append_lit(buf, pos, "/lib.sio")
            buf_to_string(p3.0, p3.1)
        }
        Some(rest) => {
            let path_pair = use_path_segs_to_buf(*rest, buf, pos)
            var final_buf = path_pair.0
            var fp = path_pair.1
            if fp < 508 {
                final_buf[fp] = 46 as i8
                final_buf[fp + 1] = 115 as i8
                final_buf[fp + 2] = 105 as i8
                final_buf[fp + 3] = 111 as i8
                fp = fp + 4
            }
            buf_to_string(final_buf, fp)
        }
    }
}

fn file_path_mod_fallback(path: string) -> string with Mut, Panic, Div {
    let path_len = str_len(path)
    if path_len < 5 {
        return path
    }
    if str_char_at(path, path_len - 4) != 46 {
        return path
    }
    let base = str_slice(path, 0, path_len - 4)
    str_concat(str_concat(base, "/mod"), ".sio")
}

// Drop the last segment of an AstPath. Returns (parent_path, true) when a
// parent exists (original had >= 2 segments).
fn ast_path_drop_last_segment(path: AstPath) -> (AstPath, bool) with Mut, Panic, Div, Alloc {
    if path.seg_count < 2 {
        return (path, false)
    }
    let segs = path.segments
    match segs.tail {
        None => (path, false)
        Some(rest1) => {
            match (*rest1).tail {
                None => {
                    // path was [head, last] → parent is [head]
                    let parent = AstPath {
                        segments: StringList {
                            head_buf: segs.head_buf,
                            head_len: segs.head_len,
                            tail: None,
                        },
                        seg_count: 1,
                    }
                    (parent, true)
                }
                Some(_) => {
                    // path was [head, ..., last] with >= 3 segments.
                    let nested = AstPath {
                        segments: *rest1,
                        seg_count: path.seg_count - 1,
                    }
                    let nested_pair = ast_path_drop_last_segment(nested)
                    if !nested_pair.1 {
                        return (path, false)
                    }
                    let parent_tail = nested_pair.0.segments
                    let parent = AstPath {
                        segments: StringList {
                            head_buf: segs.head_buf,
                            head_len: segs.head_len,
                            tail: Some(Box::new(parent_tail)),
                        },
                        seg_count: path.seg_count - 1,
                    }
                    (parent, true)
                }
            }
        }
    }
}

fn resolve_import_file_path(path: AstPath, cur_dir: string) -> string with IO, Mut, Panic, Div, Alloc {
    let local = use_path_to_file_path(path, cur_dir)
    if file_exists(local) {
        return local
    }
    let stdlib = use_path_to_file_path(path, "stdlib")
    if file_exists(stdlib) {
        return stdlib
    }
    let pkg = use_path_to_package_file_path(path)
    if file_exists(pkg) {
        return pkg
    }
    let pkg_mod = file_path_mod_fallback(pkg)
    if file_exists(pkg_mod) {
        return pkg_mod
    }
    // Named-import fallback (see module_frontend.resolve_import_file_path):
    // bare `use mod::symbol` when `mod/symbol.sio` is missing → load `mod.sio`.
    if path.seg_count >= 2 {
        let parent_pair = ast_path_drop_last_segment(path)
        if parent_pair.1 {
            let parent = parent_pair.0
            let parent_local = use_path_to_file_path(parent, cur_dir)
            if file_exists(parent_local) {
                return parent_local
            }
            let parent_stdlib = use_path_to_file_path(parent, "stdlib")
            if file_exists(parent_stdlib) {
                return parent_stdlib
            }
            let parent_pkg = use_path_to_package_file_path(parent)
            if file_exists(parent_pkg) {
                return parent_pkg
            }
            let parent_pkg_mod = file_path_mod_fallback(parent_pkg)
            if file_exists(parent_pkg_mod) {
                return parent_pkg_mod
            }
        }
    }
    local
}

// Convert byte buffer to VM string using str_from_bytes builtin
fn buf_to_string(buf: [i8; 512], len: i64) -> string with Mut, Panic, Div {
    str_from_bytes(buf, len)
}

// ============================================================
// Import extraction
// ============================================================

pub struct ImportList {
    paths: [AstPath; 64],
    count: i64,
}

pub fn extract_imports_from_ast(prog: Program) -> ImportList with Mut, Panic, Div, Alloc {
    var imports = ImportList {
        paths: [empty_path(); 64],
        count: 0,
    }

    match prog.items {
        None => imports
        Some(items) => {
            extract_imports_walk(*items, imports)
        }
    }
}

fn extract_imports_walk(list: ItemList, acc: ImportList) -> ImportList with Mut, Panic, Div, Alloc {
    var imports = acc
    if list.head.kind == ItemKind::ItemUse {
        if imports.count < 64 {
            imports.paths[imports.count] = list.head.use_path
            imports.count = imports.count + 1
        }
    }
    match list.tail {
        None => imports
        Some(next) => extract_imports_walk(*next, imports)
    }
}

// ============================================================
// Module loading
// ============================================================

fn file_exists(path: string) -> bool with IO {
    file_size(path) > 0
}

fn empty_program() -> Program {
    Program {
        module_path: empty_path(),
        items: None,
    }
}

pub fn load_module_file(path: string) -> Program with IO, Mut, Div, Panic, Alloc {
    let status = sourcefile_load(path)
    if !sourcefile_status_ok() {
        return empty_program()
    }
    let keep = status
    var prog = sourcefile_parse_program_loaded(0)
    prog.module_path = file_path_to_module_path(path)
    prog
}

// Module identity. This is what `visibility_allows_access` compares (check/check.sio:90 via
// ast_path_eq, its ONLY call site), so it decides which accesses count as "same module".
//
// It used to be the file BASENAME alone, which made every same-named file in a different
// directory THE SAME MODULE. In compiler/main.sio's 105-file closure that merged 20 files
// across 8 basenames — encode, env, ir, layout, lower, mod, opt_strategy, types — so
// visibility was really "basename-private", and on those pairs the predicate either no-op'd
// or reached a live crash: with a colliding basename and a private callee, ast_path_eq falls
// through to string_list_eq_sl (check/check.sio:42-52), whose tail walk reads
// Option<Box<StringList>> — the Box-typed-field read Madaros miscompiles — and the compiler
// SIGSEGVs with zero diagnostics. The comment at check/check.sio:49 is a warning left by
// whoever hit it.
//
// Identity is now the PARENT DIRECTORY plus the basename, which distinguishes all 8 colliding
// groups. Two properties are deliberate:
//  - It stays a SINGLE segment (seg_count 1, tail None). Uniqueness is all this needs, and a
//    multi-segment path would make string_list_eq_sl walk `tail` on EVERY comparison instead
//    of only on collisions — i.e. it would turn a rare crash into a universal one. Widening
//    identity therefore does NOT depend on the Box-field read being fixed first.
//  - It uses the last two components rather than the whole path, so the same file reached by
//    different spellings (absolute vs relative, different cwd) still gets one identity. An
//    absolute prefix in the key would split one module in two.
// The in-file `module a::b` declaration is still not consulted; 42 of those 105 files, including
// the two largest, carry none, so it cannot serve as identity without authoring them first.
fn file_path_to_module_path(path: string) -> AstPath with Mut, Panic, Div {
    var seg_buf: [i8; 384] = [0; 384]
    var seg_len: i64 = 0
    var segs = StringList { head_buf: [0; 384], head_len: 0, tail: None }
    var seg_count: i64 = 0
    var path_len = str_len(path)
    var i: i64 = 0
    var last_slash: i64 = 0 - 1
    var prev_slash: i64 = 0 - 1
    var dot_pos: i64 = path_len
    while i < path_len {
        let ch = str_char_at(path, i)
        if ch == 47 {
            prev_slash = last_slash
            last_slash = i
        }
        if ch == 46 {
            dot_pos = i
        }
        i = i + 1
    }
    // Start one byte after the SECOND-to-last slash so the parent directory is included;
    // fall back to the old basename-only behaviour when the path has fewer components.
    var start = prev_slash + 1
    if prev_slash < 0 {
        start = last_slash + 1
    }
    var end = dot_pos
    if end <= start {
        end = path_len
    }
    seg_len = 0
    i = start
    while i < end && seg_len < 384 {
        seg_buf[seg_len] = str_char_at(path, i) as i8
        seg_len = seg_len + 1
        i = i + 1
    }
    segs.head_buf = seg_buf
    segs.head_len = seg_len
    AstPath { segments: segs, seg_count: 1 }
}

fn path_directory(path: string) -> string with Mut, Panic, Div {
    var path_len = str_len(path)
    var last_slash: i64 = 0 - 1
    var i: i64 = 0
    while i < path_len {
        if str_char_at(path, i) == 47 {
            last_slash = i
        }
        i = i + 1
    }
    if last_slash < 0 {
        return "."
    }
    var buf: [i8; 512] = [0; 512]
    i = 0
    while i <= last_slash && i < 511 {
        buf[i] = str_char_at(path, i) as i8
        i = i + 1
    }
    str_from_bytes(buf, last_slash)
}

fn ir_epistemic_offset_id(id: i64, offset: i64) -> i64 {
    if id >= 0 { id + offset } else { id }
}

fn ir_merge_adjust_epistemic_instr(
    instr: IrInstr,
    contest_offset: i64,
    robust_offset: i64,
    decision_offset: i64,
    deferred_offset: i64,
    validated_offset: i64,
    acquisition_plan_offset: i64,
    recourse_plan_offset: i64,
    alternative_set_offset: i64,
    transition_plan_offset: i64,
    observed_transition_offset: i64,
    rollback_certificate_offset: i64
) -> IrInstr with Mut {
    var out = instr
    if out.op == IrOpcode::IrContest || out.op == IrOpcode::IrLiftKnowledge {
        out.label_id = ir_epistemic_offset_id(out.label_id, contest_offset)
    } else if out.op == IrOpcode::IrProveRobust {
        out.label_id = ir_epistemic_offset_id(out.label_id, robust_offset)
    } else if out.op == IrOpcode::IrAdmitAction {
        out.label_id = ir_epistemic_offset_id(out.label_id, decision_offset)
    } else if out.op == IrOpcode::IrDeferAction {
        out.label_id = ir_epistemic_offset_id(out.label_id, deferred_offset)
    } else if out.op == IrOpcode::IrValidated {
        out.label_id = ir_epistemic_offset_id(out.label_id, validated_offset)
    } else if out.op == IrOpcode::IrPlanAcquisition {
        out.label_id = ir_epistemic_offset_id(out.label_id, acquisition_plan_offset)
    } else if out.op == IrOpcode::IrPlanRecourse {
        out.label_id = ir_epistemic_offset_id(out.label_id, recourse_plan_offset)
    } else if out.op == IrOpcode::IrProposeAlternatives {
        out.label_id = ir_epistemic_offset_id(out.label_id, alternative_set_offset)
    } else if out.op == IrOpcode::IrCommitAlternative {
        out.label_id = ir_epistemic_offset_id(out.label_id, transition_plan_offset)
    } else if out.op == IrOpcode::IrObserveTransition {
        out.label_id = ir_epistemic_offset_id(out.label_id, observed_transition_offset)
    } else if out.op == IrOpcode::IrRollbackTransition {
        out.label_id = ir_epistemic_offset_id(out.label_id, rollback_certificate_offset)
    }
    out
}

fn ir_merge_epistemic_sections(dst: IrEpistemicSection, src: IrEpistemicSection) -> IrEpistemicSection with Mut, Panic, Div {
    var merged = dst
    let family_offset = dst.model_family_count
    let policy_offset = dst.policy_count
    let decision_policy_offset = dst.decision_policy_count
    let deferral_policy_offset = dst.deferral_policy_count
    let acquisition_policy_offset = dst.acquisition_policy_count
    let recourse_policy_offset = dst.recourse_policy_count
    let validation_offset = dst.validation_count
    let mechanistic_offset = dst.mechanistic_report_count
    let posterior_weights_offset = dst.posterior_weights_count
    let counterexample_offset = dst.counterexample_count
    let audit_offset = dst.audit_count
    let contest_offset = dst.contest_count
    let contest_witness_offset = dst.contest_witness_count
    let robust_offset = dst.robust_proof_count
    let decision_certificate_offset = dst.decision_certificate_count
    let deferred_certificate_offset = dst.deferred_certificate_count
    let deferred_reason_witness_offset = dst.deferred_reason_witness_count
    let acquisition_plan_offset = dst.acquisition_plan_count
    let acquisition_reason_witness_offset = dst.acquisition_reason_witness_count
    let recourse_plan_offset = dst.recourse_plan_count
    let recourse_reason_witness_offset = dst.recourse_reason_witness_count
    let alternative_policy_offset = dst.alternative_policy_count
    let alternative_frontier_offset = dst.alternative_frontier_count
    let alternative_candidate_offset = dst.alternative_candidate_count
    let alternative_set_offset = dst.alternative_set_count
    let alternative_reason_witness_offset = dst.alternative_reason_witness_count
    let transition_policy_offset = dst.transition_policy_count
    let transition_step_offset = dst.transition_step_count
    let transition_protocol_offset = dst.transition_protocol_count
    let transition_plan_offset = dst.transition_plan_count
    let transition_reason_witness_offset = dst.transition_reason_witness_count
    let monitoring_policy_offset = dst.monitoring_policy_count
    let observed_transition_offset = dst.observed_transition_count
    let rollback_certificate_offset = dst.rollback_certificate_count
    let validated_offset = dst.validated_manifest_count

    var i: i64 = 0
    while i < src.model_family_count && merged.model_family_count < IR_MAX_EPI_MODEL_FAMILIES {
        var info = src.model_families[i]
        info.id = merged.model_family_count
        merged.model_families[merged.model_family_count as usize] = info
        merged.model_family_count = merged.model_family_count + 1
        i = i + 1
    }

    i = 0
    while i < src.policy_count && merged.policy_count < IR_MAX_EPI_POLICIES {
        var info = src.policies[i]
        info.id = merged.policy_count
        merged.policies[merged.policy_count as usize] = info
        merged.policy_count = merged.policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.decision_policy_count && merged.decision_policy_count < IR_MAX_EPI_DECISION_POLICIES {
        var info = src.decision_policies[i]
        info.id = merged.decision_policy_count
        merged.decision_policies[merged.decision_policy_count as usize] = info
        merged.decision_policy_count = merged.decision_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.deferral_policy_count && merged.deferral_policy_count < IR_MAX_EPI_DEFERRAL_POLICIES {
        var info = src.deferral_policies[i]
        info.id = merged.deferral_policy_count
        merged.deferral_policies[merged.deferral_policy_count as usize] = info
        merged.deferral_policy_count = merged.deferral_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.acquisition_policy_count && merged.acquisition_policy_count < IR_MAX_EPI_ACQUISITION_POLICIES {
        var info = src.acquisition_policies[i]
        info.id = merged.acquisition_policy_count
        merged.acquisition_policies[merged.acquisition_policy_count as usize] = info
        merged.acquisition_policy_count = merged.acquisition_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.recourse_policy_count && merged.recourse_policy_count < IR_MAX_EPI_RECOURSE_POLICIES {
        var info = src.recourse_policies[i]
        info.id = merged.recourse_policy_count
        merged.recourse_policies[merged.recourse_policy_count as usize] = info
        merged.recourse_policy_count = merged.recourse_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.validation_count && merged.validation_count < IR_MAX_EPI_VALIDATIONS {
        var info = src.validations[i]
        info.id = merged.validation_count
        merged.validations[merged.validation_count as usize] = info
        merged.validation_count = merged.validation_count + 1
        i = i + 1
    }

    i = 0
    while i < src.mechanistic_report_count && merged.mechanistic_report_count < IR_MAX_EPI_MECHANISTIC_REPORTS {
        var info = src.mechanistic_reports[i]
        info.id = merged.mechanistic_report_count
        merged.mechanistic_reports[merged.mechanistic_report_count as usize] = info
        merged.mechanistic_report_count = merged.mechanistic_report_count + 1
        i = i + 1
    }

    i = 0
    while i < src.posterior_weights_count && merged.posterior_weights_count < IR_MAX_EPI_POSTERIOR_WEIGHTS {
        var info = src.posterior_weights[i]
        info.id = merged.posterior_weights_count
        merged.posterior_weights[merged.posterior_weights_count as usize] = info
        merged.posterior_weights_count = merged.posterior_weights_count + 1
        i = i + 1
    }

    i = 0
    while i < src.counterexample_count && merged.counterexample_count < IR_MAX_EPI_COUNTEREXAMPLES {
        var info = src.counterexamples[i]
        info.id = merged.counterexample_count
        merged.counterexamples[merged.counterexample_count as usize] = info
        merged.counterexample_count = merged.counterexample_count + 1
        i = i + 1
    }

    i = 0
    while i < src.audit_count && merged.audit_count < IR_MAX_EPI_AUDITS {
        var info = src.audits[i]
        info.id = merged.audit_count
        info.family_id = ir_epistemic_offset_id(info.family_id, family_offset)
        info.policy_id = ir_epistemic_offset_id(info.policy_id, policy_offset)
        info.mechanistic_report_id = ir_epistemic_offset_id(info.mechanistic_report_id, mechanistic_offset)
        info.posterior_weights_id = ir_epistemic_offset_id(info.posterior_weights_id, posterior_weights_offset)
        info.counterexample_id = ir_epistemic_offset_id(info.counterexample_id, counterexample_offset)
        merged.audits[merged.audit_count as usize] = info
        merged.audit_count = merged.audit_count + 1
        i = i + 1
    }

    i = 0
    while i < src.contest_count && merged.contest_count < IR_MAX_EPI_CONTESTS {
        var info = src.contests[i]
        info.id = merged.contest_count
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.family_id = ir_epistemic_offset_id(info.family_id, family_offset)
        info.policy_id = ir_epistemic_offset_id(info.policy_id, policy_offset)
        info.mechanistic_report_id = ir_epistemic_offset_id(info.mechanistic_report_id, mechanistic_offset)
        info.posterior_weights_id = ir_epistemic_offset_id(info.posterior_weights_id, posterior_weights_offset)
        info.counterexample_id = ir_epistemic_offset_id(info.counterexample_id, counterexample_offset)
        merged.contests[merged.contest_count as usize] = info
        merged.contest_count = merged.contest_count + 1
        i = i + 1
    }

    i = 0
    while i < src.contest_witness_count && merged.contest_witness_count < IR_MAX_EPI_CONTEST_WITNESSES {
        var info = src.contest_witnesses[i]
        info.id = merged.contest_witness_count
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        merged.contest_witnesses[merged.contest_witness_count as usize] = info
        merged.contest_witness_count = merged.contest_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < src.robust_proof_count && merged.robust_proof_count < IR_MAX_EPI_ROBUST_PROOFS {
        var info = src.robust_proofs[i]
        info.id = merged.robust_proof_count
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        info.policy_id = ir_epistemic_offset_id(info.policy_id, policy_offset)
        merged.robust_proofs[merged.robust_proof_count as usize] = info
        merged.robust_proof_count = merged.robust_proof_count + 1
        i = i + 1
    }

    i = 0
    while i < src.validated_manifest_count && merged.validated_manifest_count < IR_MAX_EPI_VALIDATED_MANIFESTS {
        let src_info = src.validated_manifests[i]
        merged.validated_manifests[merged.validated_manifest_count as usize] = IrValidatedManifestInfo {
            id: merged.validated_manifest_count,
            span_start: src_info.span_start,
            span_end: src_info.span_end,
            audit_id: ir_epistemic_offset_id(src_info.audit_id, audit_offset),
            robust_proof_id: ir_epistemic_offset_id(src_info.robust_proof_id, robust_offset),
            validation_id: if src_info.validation_id >= 0 {
                src_info.validation_id + validation_offset
            } else {
                src_info.validation_id
            },
            inner_ty: src_info.inner_ty,
        }
        merged.validated_manifest_count = merged.validated_manifest_count + 1
        i = i + 1
    }

    i = 0
    while i < src.decision_certificate_count && merged.decision_certificate_count < IR_MAX_EPI_DECISION_CERTIFICATES {
        var info = src.decision_certificates[i]
        info.id = merged.decision_certificate_count
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.robust_proof_id = ir_epistemic_offset_id(info.robust_proof_id, robust_offset)
        info.decision_policy_id = ir_epistemic_offset_id(info.decision_policy_id, decision_policy_offset)
        merged.decision_certificates[merged.decision_certificate_count as usize] = info
        merged.decision_certificate_count = merged.decision_certificate_count + 1
        i = i + 1
    }

    i = 0
    while i < src.deferred_certificate_count && merged.deferred_certificate_count < IR_MAX_EPI_DEFERRED_CERTIFICATES {
        var info = src.deferred_certificates[i]
        info.id = merged.deferred_certificate_count
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        info.robust_proof_id = ir_epistemic_offset_id(info.robust_proof_id, robust_offset)
        info.deferral_policy_id = ir_epistemic_offset_id(info.deferral_policy_id, deferral_policy_offset)
        merged.deferred_certificates[merged.deferred_certificate_count as usize] = info
        merged.deferred_certificate_count = merged.deferred_certificate_count + 1
        i = i + 1
    }

    i = 0
    while i < src.deferred_reason_witness_count && merged.deferred_reason_witness_count < IR_MAX_EPI_DEFERRED_REASON_WITNESSES {
        var info = src.deferred_reason_witnesses[i]
        info.id = merged.deferred_reason_witness_count
        info.deferred_certificate_id = ir_epistemic_offset_id(info.deferred_certificate_id, deferred_certificate_offset)
        merged.deferred_reason_witnesses[merged.deferred_reason_witness_count as usize] = info
        merged.deferred_reason_witness_count = merged.deferred_reason_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < src.acquisition_plan_count && merged.acquisition_plan_count < IR_MAX_EPI_ACQUISITION_PLANS {
        var info = src.acquisition_plans[i]
        info.id = merged.acquisition_plan_count
        info.deferred_certificate_id = ir_epistemic_offset_id(info.deferred_certificate_id, deferred_certificate_offset)
        info.acquisition_policy_id = ir_epistemic_offset_id(info.acquisition_policy_id, acquisition_policy_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        merged.acquisition_plans[merged.acquisition_plan_count as usize] = info
        merged.acquisition_plan_count = merged.acquisition_plan_count + 1
        i = i + 1
    }

    i = 0
    while i < src.acquisition_reason_witness_count && merged.acquisition_reason_witness_count < IR_MAX_EPI_ACQUISITION_REASON_WITNESSES {
        let src_info = src.acquisition_reason_witnesses[i]
        merged.acquisition_reason_witnesses[merged.acquisition_reason_witness_count as usize] = IrAcquisitionReasonWitnessInfo {
            id: merged.acquisition_reason_witness_count,
            span_start: src_info.span_start,
            span_end: src_info.span_end,
            acquisition_plan_id: if src_info.acquisition_plan_id >= 0 {
                src_info.acquisition_plan_id + acquisition_plan_offset
            } else {
                src_info.acquisition_plan_id
            },
        }
        merged.acquisition_reason_witness_count = merged.acquisition_reason_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < src.recourse_plan_count && merged.recourse_plan_count < IR_MAX_EPI_RECOURSE_PLANS {
        var info = src.recourse_plans[i]
        info.id = merged.recourse_plan_count
        info.deferred_certificate_id = ir_epistemic_offset_id(info.deferred_certificate_id, deferred_certificate_offset)
        info.recourse_policy_id = ir_epistemic_offset_id(info.recourse_policy_id, recourse_policy_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        merged.recourse_plans[merged.recourse_plan_count as usize] = info
        merged.recourse_plan_count = merged.recourse_plan_count + 1
        i = i + 1
    }

    i = 0
    while i < src.recourse_reason_witness_count && merged.recourse_reason_witness_count < IR_MAX_EPI_RECOURSE_REASON_WITNESSES {
        var info = src.recourse_reason_witnesses[i]
        info.id = merged.recourse_reason_witness_count
        info.recourse_plan_id = ir_epistemic_offset_id(info.recourse_plan_id, recourse_plan_offset)
        merged.recourse_reason_witnesses[merged.recourse_reason_witness_count as usize] = info
        merged.recourse_reason_witness_count = merged.recourse_reason_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < src.alternative_policy_count && merged.alternative_policy_count < IR_MAX_EPI_ALTERNATIVE_POLICIES {
        var info = src.alternative_policies[i]
        info.id = merged.alternative_policy_count
        merged.alternative_policies[merged.alternative_policy_count as usize] = info
        merged.alternative_policy_count = merged.alternative_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.alternative_frontier_count && merged.alternative_frontier_count < IR_MAX_EPI_ALTERNATIVE_FRONTIERS {
        var info = src.alternative_frontiers[i]
        info.id = merged.alternative_frontier_count
        info.alternative_policy_id = ir_epistemic_offset_id(info.alternative_policy_id, alternative_policy_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        info.source_policy_id = ir_epistemic_offset_id(info.source_policy_id, recourse_policy_offset)
        info.source_plan_id = ir_epistemic_offset_id(info.source_plan_id, recourse_plan_offset)
        info.candidate_start = ir_epistemic_offset_id(info.candidate_start, alternative_candidate_offset)
        merged.alternative_frontiers[merged.alternative_frontier_count as usize] = info
        merged.alternative_frontier_count = merged.alternative_frontier_count + 1
        i = i + 1
    }

    i = 0
    while i < src.alternative_candidate_count && merged.alternative_candidate_count < IR_MAX_EPI_ALTERNATIVE_CANDIDATES {
        var info = src.alternative_candidates[i]
        info.id = merged.alternative_candidate_count
        info.frontier_id = ir_epistemic_offset_id(info.frontier_id, alternative_frontier_offset)
        info.source_policy_id = ir_epistemic_offset_id(info.source_policy_id, recourse_policy_offset)
        info.source_plan_id = ir_epistemic_offset_id(info.source_plan_id, recourse_plan_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        merged.alternative_candidates[merged.alternative_candidate_count as usize] = info
        merged.alternative_candidate_count = merged.alternative_candidate_count + 1
        i = i + 1
    }

    i = 0
    while i < src.alternative_set_count && merged.alternative_set_count < IR_MAX_EPI_ALTERNATIVE_SETS {
        var info = src.alternative_sets[i]
        info.id = merged.alternative_set_count
        info.frontier_id = ir_epistemic_offset_id(info.frontier_id, alternative_frontier_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        info.candidate_start = ir_epistemic_offset_id(info.candidate_start, alternative_candidate_offset)
        merged.alternative_sets[merged.alternative_set_count as usize] = info
        merged.alternative_set_count = merged.alternative_set_count + 1
        i = i + 1
    }

    i = 0
    while i < src.alternative_reason_witness_count && merged.alternative_reason_witness_count < IR_MAX_EPI_ALTERNATIVE_REASON_WITNESSES {
        var info = src.alternative_reason_witnesses[i]
        info.id = merged.alternative_reason_witness_count
        info.alternative_set_id = ir_epistemic_offset_id(info.alternative_set_id, alternative_set_offset)
        info.candidate_id = ir_epistemic_offset_id(info.candidate_id, alternative_candidate_offset)
        merged.alternative_reason_witnesses[merged.alternative_reason_witness_count as usize] = info
        merged.alternative_reason_witness_count = merged.alternative_reason_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < src.transition_policy_count && merged.transition_policy_count < IR_MAX_EPI_TRANSITION_POLICIES {
        var info = src.transition_policies[i]
        info.id = merged.transition_policy_count
        merged.transition_policies[merged.transition_policy_count as usize] = info
        merged.transition_policy_count = merged.transition_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.transition_step_count && merged.transition_step_count < IR_MAX_EPI_TRANSITION_STEPS {
        var info = src.transition_steps[i]
        info.id = merged.transition_step_count
        info.protocol_id = ir_epistemic_offset_id(info.protocol_id, transition_protocol_offset)
        merged.transition_steps[merged.transition_step_count as usize] = info
        merged.transition_step_count = merged.transition_step_count + 1
        i = i + 1
    }

    i = 0
    while i < src.transition_protocol_count && merged.transition_protocol_count < IR_MAX_EPI_TRANSITION_PROTOCOLS {
        var info = src.transition_protocols[i]
        info.id = merged.transition_protocol_count
        info.transition_policy_id = ir_epistemic_offset_id(info.transition_policy_id, transition_policy_offset)
        info.step_start = ir_epistemic_offset_id(info.step_start, transition_step_offset)
        merged.transition_protocols[merged.transition_protocol_count as usize] = info
        merged.transition_protocol_count = merged.transition_protocol_count + 1
        i = i + 1
    }

    i = 0
    while i < src.transition_plan_count && merged.transition_plan_count < IR_MAX_EPI_TRANSITION_PLANS {
        var info = src.transition_plans[i]
        info.id = merged.transition_plan_count
        info.transition_policy_id = ir_epistemic_offset_id(info.transition_policy_id, transition_policy_offset)
        info.transition_protocol_id = ir_epistemic_offset_id(info.transition_protocol_id, transition_protocol_offset)
        info.alternative_option_id = ir_epistemic_offset_id(info.alternative_option_id, alternative_candidate_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        merged.transition_plans[merged.transition_plan_count as usize] = info
        merged.transition_plan_count = merged.transition_plan_count + 1
        i = i + 1
    }

    i = 0
    while i < src.transition_reason_witness_count && merged.transition_reason_witness_count < IR_MAX_EPI_TRANSITION_REASON_WITNESSES {
        var info = src.transition_reason_witnesses[i]
        info.id = merged.transition_reason_witness_count
        info.transition_plan_id = ir_epistemic_offset_id(info.transition_plan_id, transition_plan_offset)
        merged.transition_reason_witnesses[merged.transition_reason_witness_count as usize] = info
        merged.transition_reason_witness_count = merged.transition_reason_witness_count + 1
        i = i + 1
    }

    i = 0
    while i < src.monitoring_policy_count && merged.monitoring_policy_count < IR_MAX_EPI_MONITORING_POLICIES {
        var info = src.monitoring_policies[i]
        info.id = merged.monitoring_policy_count
        merged.monitoring_policies[merged.monitoring_policy_count as usize] = info
        merged.monitoring_policy_count = merged.monitoring_policy_count + 1
        i = i + 1
    }

    i = 0
    while i < src.observed_transition_count && merged.observed_transition_count < IR_MAX_EPI_OBSERVED_TRANSITIONS {
        var info = src.observed_transitions[i]
        info.id = merged.observed_transition_count
        info.transition_plan_id = ir_epistemic_offset_id(info.transition_plan_id, transition_plan_offset)
        info.monitoring_policy_id = ir_epistemic_offset_id(info.monitoring_policy_id, monitoring_policy_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        merged.observed_transitions[merged.observed_transition_count as usize] = info
        merged.observed_transition_count = merged.observed_transition_count + 1
        i = i + 1
    }

    i = 0
    while i < src.rollback_certificate_count && merged.rollback_certificate_count < IR_MAX_EPI_ROLLBACK_CERTIFICATES {
        var info = src.rollback_certificates[i]
        info.id = merged.rollback_certificate_count
        info.transition_plan_id = ir_epistemic_offset_id(info.transition_plan_id, transition_plan_offset)
        info.monitoring_policy_id = ir_epistemic_offset_id(info.monitoring_policy_id, monitoring_policy_offset)
        info.audit_id = ir_epistemic_offset_id(info.audit_id, audit_offset)
        info.contest_id = ir_epistemic_offset_id(info.contest_id, contest_offset)
        merged.rollback_certificates[merged.rollback_certificate_count as usize] = info
        merged.rollback_certificate_count = merged.rollback_certificate_count + 1
        i = i + 1
    }

    merged
}

// ============================================================
// IR module merging
// ============================================================

fn ir_merge_modules(dst: IrModule, src: IrModule) -> IrModule with Alloc, Mut, Panic, Div {
    // Merge src functions into dst, adjusting fn_ids in call instructions
    var merged = dst
    let fn_offset = dst.fn_count  // src function IDs shift by this amount
    let contest_offset = dst.epistemic.contest_count
    let robust_offset = dst.epistemic.robust_proof_count
    let decision_offset = dst.epistemic.decision_certificate_count
    let deferred_offset = dst.epistemic.deferred_certificate_count
    let validated_offset = dst.epistemic.validated_manifest_count
    let acquisition_plan_offset = dst.epistemic.acquisition_plan_count
    let recourse_plan_offset = dst.epistemic.recourse_plan_count
    let alternative_set_offset = dst.epistemic.alternative_set_count
    let transition_plan_offset = dst.epistemic.transition_plan_count
    let observed_transition_offset = dst.epistemic.observed_transition_count
    let rollback_certificate_offset = dst.epistemic.rollback_certificate_count

    // Copy functions
    var fi: i64 = 0
    while fi < src.fn_count && merged.fn_count < IR_MAX_FUNCS {
        var func = ir_fn_get(&src, fi)
        // Preserve per-function strategy metadata across multimodule IR merges.
        func.compile_strategy = ir_fn_get(&src, fi).compile_strategy
        // Adjust call targets: shift fn_id by fn_offset
        var ii: i64 = 0
        while ii < func.instr_count {
            if (IR_A_OP[(ir_region_slot_r(func.region, (ii))) as usize] as IrOpcode) == IrOpcode::IrCall {
                if IR_A_FN_ID[(ir_region_slot_r(func.region, (ii))) as usize] >= 0 {
                    IR_A_FN_ID[(ir_region_slot_w(func.region, (ii))) as usize] = IR_A_FN_ID[(ir_region_slot_r(func.region, (ii))) as usize] + fn_offset
                }
            }
            ir_arena_store(ir_region_slot_w(func.region, (ii)), ir_merge_adjust_epistemic_instr(
                ir_arena_load(ir_region_slot_r(func.region, (ii))),
                contest_offset,
                robust_offset,
                decision_offset,
                deferred_offset,
                validated_offset,
                acquisition_plan_offset,
                recourse_plan_offset,
                alternative_set_offset,
                transition_plan_offset,
                observed_transition_offset,
                rollback_certificate_offset
            ))
            ii = ii + 1
        }
        func.compile_strategy = ir_fn_get(&src, fi).compile_strategy
        ir_fn_set(&! merged, merged.fn_count, func)
        merged.fn_count = merged.fn_count + 1
        fi = fi + 1
    }

    // Merge string tables (simple append, no dedup for now)
    var si: i64 = 0
    while si < src.string_count && merged.string_count < IR_MAX_STRINGS {
        merged.string_table[merged.string_count] = src.string_table[si]
        merged.string_count = merged.string_count + 1
        si = si + 1
    }

    merged.epistemic = ir_merge_epistemic_sections(merged.epistemic, src.epistemic)
    merged.algebras = ir_merge_algebra_tables(merged.algebras, src.algebras)

    merged
}

fn ir_merge_algebra_tables(dst: IrAlgebraTable, src: IrAlgebraTable) -> IrAlgebraTable with Mut, Panic, Div {
    var merged = dst
    var si: i64 = 0
    while si < src.count && merged.count < 32 {
        let candidate = src.entries[si]
        if candidate.is_valid {
            var exists: bool = false
            var di: i64 = 0
            while di < merged.count {
                let entry = merged.entries[di]
                if entry.is_valid && entry.algebra_tag == candidate.algebra_tag && ir_name_eq(entry.name, candidate.name) {
                    exists = true
                    di = merged.count
                } else {
                    di = di + 1
                }
            }
            if exists == false {
                merged.entries[merged.count as usize] = candidate
                merged.count = merged.count + 1
            }
        }
        si = si + 1
    }
    merged
}

fn ir_epistemic_section_is_empty(epistemic: IrEpistemicSection) -> bool {
    epistemic.model_family_count == 0 &&
    epistemic.policy_count == 0 &&
    epistemic.decision_policy_count == 0 &&
    epistemic.deferral_policy_count == 0 &&
    epistemic.acquisition_policy_count == 0 &&
    epistemic.recourse_policy_count == 0 &&
    epistemic.validation_count == 0 &&
    epistemic.mechanistic_report_count == 0 &&
    epistemic.posterior_weights_count == 0 &&
    epistemic.counterexample_count == 0 &&
    epistemic.audit_count == 0 &&
    epistemic.contest_count == 0 &&
    epistemic.contest_witness_count == 0 &&
    epistemic.robust_proof_count == 0 &&
    epistemic.decision_certificate_count == 0 &&
    epistemic.deferred_certificate_count == 0 &&
    epistemic.deferred_reason_witness_count == 0 &&
    epistemic.acquisition_plan_count == 0 &&
    epistemic.acquisition_reason_witness_count == 0 &&
    epistemic.recourse_plan_count == 0 &&
    epistemic.recourse_reason_witness_count == 0 &&
    epistemic.alternative_policy_count == 0 &&
    epistemic.alternative_frontier_count == 0 &&
    epistemic.alternative_candidate_count == 0 &&
    epistemic.alternative_set_count == 0 &&
    epistemic.alternative_reason_witness_count == 0 &&
    epistemic.transition_policy_count == 0 &&
    epistemic.transition_protocol_count == 0 &&
    epistemic.transition_step_count == 0 &&
    epistemic.transition_plan_count == 0 &&
    epistemic.transition_reason_witness_count == 0 &&
    epistemic.monitoring_policy_count == 0 &&
    epistemic.observed_transition_count == 0 &&
    epistemic.rollback_certificate_count == 0 &&
    epistemic.validated_manifest_count == 0
}

// ============================================================
// Visited-set helpers for transitive import resolution
// ============================================================

fn visited_contains(visited: [string; 64], count: i64, path: string) -> bool with Mut, Panic, Div {
    var j: i64 = 0
    while j < count {
        if str_eq(visited[j], path) {
            return true
        }
        j = j + 1
    }
    false
}

// ============================================================
// Multi-module IR loading (shared by bytecode + native paths)
// ============================================================

pub struct MultiModuleIrResult {
    ok: bool,
    module: IrModule,
    error_msg: string,
}

pub struct MultiModuleFrontendResult {
    ok: bool,
    error_msg: string,
}

pub struct LoadMultimoduleIrTrace {
    loaded_modules: i64,
    resolved_modules: i64,
    typechecked_modules: i64,
    summary_seeded_modules: i64,
    body_lowered_modules: i64,
    lowered_modules: i64,
    merged_modules: i64,
    last_stage: string,
    last_module_index: i64,
    patched_functions: i64,
    patched_calls: i64,
    fallback_insertions: i64,
}

pub fn empty_load_multimodule_ir_trace() -> LoadMultimoduleIrTrace {
    LoadMultimoduleIrTrace {
        loaded_modules: 0,
        resolved_modules: 0,
        typechecked_modules: 0,
        summary_seeded_modules: 0,
        body_lowered_modules: 0,
        lowered_modules: 0,
        merged_modules: 0,
        last_stage: "init",
        last_module_index: -1,
        patched_functions: 0,
        patched_calls: 0,
        fallback_insertions: 0,
    }
}

fn multimodule_ir_ok(m: IrModule) -> MultiModuleIrResult {
    MultiModuleIrResult { ok: true, module: m, error_msg: "" }
}

fn multimodule_ir_error(msg: string) -> MultiModuleIrResult with Alloc, Panic, Div {
    MultiModuleIrResult { ok: false, module: ir_empty_module(), error_msg: msg }
}

fn load_multimodule_lower_program_traced(
    program: Program,
    epistemic: IrEpistemicSection,
    module_index: i64,
    trace: &! LoadMultimoduleIrTrace
) -> IrLowerResult with IO, Mut, Div, Panic, Alloc {
    var patch_stats = ir_empty_validated_patch_stats()
    trace.last_stage = "lower_summary"
    trace.last_module_index = module_index
    let lower_result = if ir_epistemic_section_is_empty(epistemic) {
        lower_program_to_ir_trace(program, &! patch_stats)
    } else {
        lower_program_to_ir_with_epistemic_trace(program, epistemic, &! patch_stats)
    }
    if !lower_result.had_error {
        trace.summary_seeded_modules = trace.summary_seeded_modules + 1
        trace.last_stage = "lower_bodies"
        trace.body_lowered_modules = trace.body_lowered_modules + 1
        trace.lowered_modules = trace.lowered_modules + 1
        trace.patched_functions = trace.patched_functions + patch_stats.patched_functions
        trace.patched_calls = trace.patched_calls + patch_stats.patched_calls
        trace.fallback_insertions = trace.fallback_insertions + patch_stats.fallback_insertions
    }
    lower_result
}

fn multimodule_frontend_ok() -> MultiModuleFrontendResult {
    MultiModuleFrontendResult { ok: true, error_msg: "" }
}

fn multimodule_frontend_error(msg: string) -> MultiModuleFrontendResult {
    MultiModuleFrontendResult { ok: false, error_msg: msg }
}

pub fn preflight_multimodule_frontend(main_path: string) -> MultiModuleFrontendResult with IO, Mut, Div, Panic, Alloc {
    // One compilation = one fresh global-init table, then accumulate every module.
    // Preflight is the first thing every compile path runs and it loads main + all
    // imports, so resetting once here and suppressing the per-parse reset lets an
    // imported module's f64 constants survive to lowering (they were previously
    // wiped when the next module was parsed). See ast_record_global_var_init.
    ast_reset_global_var_inits()
    GLOBAL_VAR_INIT_SUPPRESS_RESET = 1
    let main_prog = load_module_file(main_path)
    let main_items = count_items(main_prog)

    print("Main file: ")
    print_int(main_items)
    print(" items\n")

    var programs: [Program; 64] = [empty_program(); 64]
    var file_paths: [string; 64] = [""; 64]
    programs[0] = main_prog
    file_paths[0] = main_path
    var loaded: i64 = 1

    var visited_paths: [string; 64] = [""; 64]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1

    var work_front: i64 = 0
    var i: i64 = 0

    while work_front < loaded && loaded < 64 {
        let cur_dir = path_directory(file_paths[work_front])
        let work_imports = extract_imports_from_ast(programs[work_front])
        work_front = work_front + 1

        i = 0
        while i < work_imports.count && loaded < 64 {
            let file_path = resolve_import_file_path(work_imports.paths[i], cur_dir)
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    print("Loading module: ")
                    print(file_path)
                    print("\n")
                    programs[loaded] = load_module_file(file_path)
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                } else {
                    print("Warning: module not found: ")
                    let path_str = use_path_to_string(work_imports.paths[i])
                    print(path_str)
                    print("\n")
                }
            }
            i = i + 1
        }
    }

    print("Loaded ")
    print_int(loaded)
    print(" modules\n")

    let main_imports = extract_imports_from_ast(programs[0])
    let needs_resolution = loaded > 1 || main_imports.count > 0
    if needs_resolution {
        let resolve_result = resolve_modules(programs, loaded)
        if resolve_result.had_error {
            print("Module resolution failed: ")
            print_int(resolve_result.error_count)
            print(" errors\n")
            return multimodule_frontend_error("module_resolution_failed")
        }
    } else {
        print("Resolve skip: single module with no imports\n")
    }

    i = 0
    while i < loaded {
        print("Type checking module ")
        print_int(i)
        print("\n")
        var epistemic = ir_empty_epistemic_section()
        if !check_program_epistemic_into(programs[i], &!epistemic) {
            print("Type check failed for module ")
            print_int(i)
            print("\n")
            return multimodule_frontend_error("type_check_failed")
        }
        print("Type check complete for module ")
        print_int(i)
        print("\n")
        i = i + 1
    }

    multimodule_frontend_ok()
}

pub fn load_multimodule_ir_traced(main_path: string, trace: &! LoadMultimoduleIrTrace) -> MultiModuleIrResult with IO, Mut, Div, Panic, Alloc {
    let main_prog = load_module_file(main_path)
    var programs: [Program; 64] = [empty_program(); 64]
    var file_paths: [string; 64] = [""; 64]
    programs[0] = main_prog
    file_paths[0] = main_path
    var loaded: i64 = 1
    var visited_paths: [string; 64] = [""; 64]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1
    var work_front: i64 = 0
    var i: i64 = 0
    trace.loaded_modules = 1
    trace.last_stage = "load_main"
    trace.last_module_index = 0

    while work_front < loaded && loaded < 64 {
        let cur_dir = path_directory(file_paths[work_front])
        let work_imports = extract_imports_from_ast(programs[work_front])
        work_front = work_front + 1
        i = 0
        while i < work_imports.count && loaded < 64 {
            let file_path = resolve_import_file_path(work_imports.paths[i], cur_dir)
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    programs[loaded] = load_module_file(file_path)
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                    trace.loaded_modules = loaded
                    trace.last_stage = "load_deps"
                    trace.last_module_index = loaded - 1
                }
            }
            i = i + 1
        }
    }

    let main_imports = extract_imports_from_ast(programs[0])
    let needs_resolution = loaded > 1 || main_imports.count > 0
    if needs_resolution {
        trace.last_stage = "resolve"
        trace.last_module_index = loaded - 1
        let resolve_result = resolve_modules(programs, loaded)
        if resolve_result.had_error {
            trace.resolved_modules = 0
            return multimodule_ir_error("module_resolution_failed")
        }
        trace.resolved_modules = loaded
    } else {
        trace.resolved_modules = loaded
    }

    // Step 6: Lower ALL modules to IR and merge.
    // Seed the merge with module 0 to avoid expensive empty-module initialization.
    if loaded <= 0 {
        trace.last_stage = "empty"
        return multimodule_ir_error("no_modules_loaded")
    }

    var seed_epistemic = ir_empty_epistemic_section()
    trace.last_stage = "typecheck"
    trace.last_module_index = 0
    let seed_artifacts = check_program_with_artifacts(programs[0])
    if seed_artifacts.had_error {
        print("Type check failed during IR lowering for module 0\n")
        return multimodule_ir_error("type_check_failed")
    }
    checker_to_ir_epistemic_into(&seed_artifacts.checker, &! seed_epistemic)
    trace.typechecked_modules = 1
    var seed_lower_had_error = false
    var merged_module = ir_empty_module()
    {
        var seed_lower_result = load_multimodule_lower_program_traced(programs[0], seed_epistemic, 0, trace)
        seed_lower_had_error = seed_lower_result.had_error
        if !seed_lower_had_error {
            checker_apply_ir_metadata(&seed_artifacts.checker, &! (*seed_lower_result.module))
            merged_module = seed_lower_result.module
        }
    }
    if seed_lower_had_error {
        print("IR lowering failed for module 0\n")
        return multimodule_ir_error("ir_lowering_failed")
    }
    trace.merged_modules = 1

    i = 1
    while i < loaded {
        var epistemic = ir_empty_epistemic_section()
        trace.last_stage = "typecheck"
        trace.last_module_index = i
        let artifacts = check_program_with_artifacts(programs[i])
        if artifacts.had_error {
            print("Type check failed during IR lowering for module ")
            print_int(i)
            print("\n")
            return multimodule_ir_error("type_check_failed")
        }
        checker_to_ir_epistemic_into(&artifacts.checker, &! epistemic)
        trace.typechecked_modules = trace.typechecked_modules + 1
        var lower_had_error = false
        var lowered_module = ir_empty_module()
        {
            var lower_result = load_multimodule_lower_program_traced(programs[i], epistemic, i, trace)
            lower_had_error = lower_result.had_error
            if !lower_had_error {
                checker_apply_ir_metadata(&artifacts.checker, &! (*lower_result.module))
                lowered_module = lower_result.module
            }
        }
        if lower_had_error {
            print("IR lowering failed for module ")
            print_int(i)
            print("\n")
            return multimodule_ir_error("ir_lowering_failed")
        }
        trace.last_stage = "merge"
        merged_module = ir_merge_modules(merged_module, lowered_module)
        trace.merged_modules = trace.merged_modules + 1
        i = i + 1
    }

    trace.last_stage = "done"
    trace.last_module_index = loaded - 1
    print("Merged IR: ")
    print_int(merged_module.fn_count)
    print(" functions\n")

    if merged_module.fn_count <= 0 {
        print("IR lowering produced empty module\n")
        return multimodule_ir_error("ir_lowering_empty_module")
    }

    multimodule_ir_ok(merged_module)
}

pub fn load_multimodule_ir(main_path: string) -> MultiModuleIrResult with IO, Mut, Div, Panic, Alloc {
    var trace = empty_load_multimodule_ir_trace()
    load_multimodule_ir_traced(main_path, &! trace)
}

pub fn load_multimodule_ir_probe_summary_traced(main_path: string, trace: &! LoadMultimoduleIrTrace) -> MultiModuleIrResult with IO, Mut, Div, Panic, Alloc {
    let main_prog = load_module_file(main_path)
    var programs: [Program; 64] = [empty_program(); 64]
    var file_paths: [string; 64] = [""; 64]
    programs[0] = main_prog
    file_paths[0] = main_path
    var loaded: i64 = 1
    var visited_paths: [string; 64] = [""; 64]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1
    var work_front: i64 = 0
    var i: i64 = 0
    trace.loaded_modules = 1
    trace.last_stage = "load_main"
    trace.last_module_index = 0

    while work_front < loaded && loaded < 64 {
        let cur_dir = path_directory(file_paths[work_front])
        let work_imports = extract_imports_from_ast(programs[work_front])
        work_front = work_front + 1
        i = 0
        while i < work_imports.count && loaded < 64 {
            let file_path = resolve_import_file_path(work_imports.paths[i], cur_dir)
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    programs[loaded] = load_module_file(file_path)
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                    trace.loaded_modules = loaded
                    trace.last_stage = "load_deps"
                    trace.last_module_index = loaded - 1
                }
            }
            i = i + 1
        }
    }

    let main_imports = extract_imports_from_ast(programs[0])
    let needs_resolution = loaded > 1 || main_imports.count > 0
    if needs_resolution {
        trace.last_stage = "resolve"
        trace.last_module_index = loaded - 1
        let resolve_result = resolve_modules(programs, loaded)
        if resolve_result.had_error {
            trace.resolved_modules = 0
            return multimodule_ir_error("module_resolution_failed")
        }
        trace.resolved_modules = loaded
    } else {
        trace.resolved_modules = loaded
    }

    if loaded <= 0 {
        trace.last_stage = "empty"
        return multimodule_ir_error("no_modules_loaded")
    }

    var seed_epistemic = ir_empty_epistemic_section()
    trace.last_stage = "typecheck"
    trace.last_module_index = 0
    let seed_artifacts = check_program_with_artifacts(programs[0])
    if seed_artifacts.had_error {
        print("Type check failed during IR lowering for module 0\n")
        return multimodule_ir_error("type_check_failed")
    }
    checker_to_ir_epistemic_into(&seed_artifacts.checker, &! seed_epistemic)
    trace.typechecked_modules = 1
    trace.last_stage = "lower"
    var seed_lower_result = lower_program_to_ir_probe_summary(programs[0])
    if seed_lower_result.had_error {
        print("IR lowering failed for module 0\n")
        return multimodule_ir_error("ir_lowering_failed")
    }
    checker_apply_ir_metadata(&seed_artifacts.checker, &! (*seed_lower_result.module))
    trace.lowered_modules = 1
    trace.merged_modules = 1
    var merged_module = seed_lower_result.module

    i = 1
    while i < loaded {
        var epistemic = ir_empty_epistemic_section()
        trace.last_stage = "typecheck"
        trace.last_module_index = i
        let artifacts = check_program_with_artifacts(programs[i])
        if artifacts.had_error {
            print("Type check failed during IR lowering for module ")
            print_int(i)
            print("\n")
            return multimodule_ir_error("type_check_failed")
        }
        checker_to_ir_epistemic_into(&artifacts.checker, &! epistemic)
        trace.typechecked_modules = trace.typechecked_modules + 1
        trace.last_stage = "lower"
        var lower_result = lower_program_to_ir_probe_summary(programs[i])
        if lower_result.had_error {
            print("IR lowering failed for module ")
            print_int(i)
            print("\n")
            return multimodule_ir_error("ir_lowering_failed")
        }
        checker_apply_ir_metadata(&artifacts.checker, &! (*lower_result.module))
        trace.lowered_modules = trace.lowered_modules + 1
        trace.last_stage = "merge"
        merged_module = ir_merge_modules(merged_module, lower_result.module)
        trace.merged_modules = trace.merged_modules + 1
        i = i + 1
    }

    trace.last_stage = "done"
    trace.last_module_index = loaded - 1
    print("Merged IR: ")
    print_int(merged_module.fn_count)
    print(" functions\n")

    if merged_module.fn_count <= 0 {
        print("IR lowering produced empty module\n")
        return multimodule_ir_error("ir_lowering_empty_module")
    }

    multimodule_ir_ok(merged_module)
}

pub fn load_multimodule_ir_probe_summary(main_path: string) -> MultiModuleIrResult with IO, Mut, Div, Panic, Alloc {
    var trace = empty_load_multimodule_ir_trace()
    load_multimodule_ir_probe_summary_traced(main_path, &! trace)
}

pub fn load_multimodule_epistemic_into(main_path: string, out: &! IrEpistemicSection) -> MultiModuleFrontendResult with IO, Mut, Div, Panic, Alloc {
    let main_prog = load_module_file(main_path)
    var programs: [Program; 64] = [empty_program(); 64]
    var file_paths: [string; 64] = [""; 64]
    programs[0] = main_prog
    file_paths[0] = main_path
    var loaded: i64 = 1
    var visited_paths: [string; 64] = [""; 64]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1
    var work_front: i64 = 0
    var i: i64 = 0

    while work_front < loaded && loaded < 64 {
        let cur_dir = path_directory(file_paths[work_front])
        let work_imports = extract_imports_from_ast(programs[work_front])
        work_front = work_front + 1
        i = 0
        while i < work_imports.count && loaded < 64 {
            let file_path = resolve_import_file_path(work_imports.paths[i], cur_dir)
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    programs[loaded] = load_module_file(file_path)
                    file_paths[loaded] = file_path
                    loaded = loaded + 1
                }
            }
            i = i + 1
        }
    }

    let main_imports = extract_imports_from_ast(programs[0])
    let needs_resolution = loaded > 1 || main_imports.count > 0
    if needs_resolution {
        let resolve_result = resolve_modules(programs, loaded)
        if resolve_result.had_error {
            return multimodule_frontend_error("module_resolution_failed")
        }
    }

    if loaded == 1 {
        if !check_program_epistemic_into(programs[0], out) {
            return multimodule_frontend_error("type_check_failed")
        }
        return multimodule_frontend_ok()
    }

    var merged_epistemic = ir_empty_epistemic_section()
    i = 0
    while i < loaded {
        var epistemic = ir_empty_epistemic_section()
        if !check_program_epistemic_into(programs[i], &!epistemic) {
            return multimodule_frontend_error("type_check_failed")
        }
        merged_epistemic = ir_merge_epistemic_sections(merged_epistemic, epistemic)
        i = i + 1
    }

    (*out) = merged_epistemic
    multimodule_frontend_ok()
}

// ============================================================
// Multi-module compilation pipeline (bytecode output)
// ============================================================

fn compile_multimodule_program(main_path: string) -> BytecodeResult with IO, Mut, Div, Panic, Alloc {
    let ir_result = load_multimodule_ir(main_path)
    if !ir_result.ok {
        return bytecode_result_error(ir_result.error_msg)
    }

    let serialized = serialize_ir_module(ir_result.module)
    bytecode_result_ok(serialized.0, serialized.1)
}

pub fn compile_multimodule_llvm(main_path: string, output_path: string, optimize: bool) -> i32 with IO, Mut, Div, Panic, Alloc {
    print("LLVM multimodule backend is unavailable in this build: ")
    print(main_path)
    print(" -> ")
    print(output_path)
    if optimize {
        print(" (opt)")
    }
    print("\n")
    1
}

fn program_has_imports(prog: Program) -> bool with Mut, Panic, Div, Alloc {
    extract_imports_from_ast(prog).count > 0
}

// ============================================================
// Multi-module native compilation pipeline (ELF output)
// ============================================================

fn multimodule_native_trace_output_path() -> string with IO, Mut, Div, Panic {
    let override_path = read_env("SOUNIO_NATIVE_DECISION_TRACE_PATH")
    if str_len(override_path) > 0 {
        override_path
    } else {
        "artifacts/omega/native_decision_trace.v1.json"
    }
}

fn native_streaming_can_skip_checker(main_path: string, prog: &Program) -> bool with Mut, Panic, Div, Alloc {
    starts_with(main_path, "examples/render/") && extract_imports_from_ast(*prog).count == 0
}

// Memoised: read_env allocates and the runtime allocator never reclaims,
// so a gate evaluated at every call site leaks on every call. CHECKED is
// separate from the value because "off" and "not yet read" are different.
var NATIVE_STREAMING_DIAG_ENABLED_ON: i64 = 0
var NATIVE_STREAMING_DIAG_ENABLED_CHECKED: i64 = 0

fn native_streaming_diag_enabled() -> bool with IO, Mut, Panic, Div {
    if NATIVE_STREAMING_DIAG_ENABLED_CHECKED == 0 {
        NATIVE_STREAMING_DIAG_ENABLED_CHECKED = 1
        if str_eq(read_env("SOUNIO_NATIVE_STREAM_DIAG"), "1") {
            NATIVE_STREAMING_DIAG_ENABLED_ON = 1
        }
    }
    NATIVE_STREAMING_DIAG_ENABLED_ON == 1
}

fn thin_copy_huge_to_small(src: [i8; 16777216], len: i64) -> [i8; 131072] with Mut, Panic, Div {
    var out: [i8; 131072] = [0; 131072]
    var i: i64 = 0
    while i < len && i < 131072 {
        out[i as usize] = src[i as usize]
        i = i + 1
    }
    out
}

fn thin_copy_elf_to_small(src: [i8; 1048576], len: i64) -> [i8; 131072] with Mut, Panic, Div {
    var out: [i8; 131072] = [0; 131072]
    var i: i64 = 0
    while i < len && i < 131072 {
        out[i as usize] = src[i as usize]
        i = i + 1
    }
    out
}

fn thin_read_small_file(path: string) -> (bool, [i8; 131072], i64) with IO, Mut, Panic, Div {
    let len = file_size(path)
    if len <= 0 || len > 131072 || !file_exists(path) {
        return (false, [0; 131072], 0)
    }
    let wide: [i8; 16777216] = read_file(path)
    let narrow = thin_copy_huge_to_small(wide, len)
    (true, narrow, len)
}

fn thin_native_compile_result_from_wide(bytes: [i8; 16777216], len: i64, format_id: i64) -> NativeCompileResult with Mut, Panic, Div {
    if len <= 0 || len > 131072 {
        return native_compile_result_error(ERR_BACKEND_NOT_IMPLEMENTED(), "streaming_native_binary_too_large")
    }
    let narrow = thin_copy_huge_to_small(bytes, len)
    native_compile_result_ok(narrow, len, format_id)
}

fn thin_native_compile_result_from_elf(bytes: [i8; 1048576], len: i64, format_id: i64) -> NativeCompileResult with Mut, Panic, Div {
    if len <= 0 || len > 131072 {
        return native_compile_result_error(ERR_BACKEND_NOT_IMPLEMENTED(), "streaming_native_binary_too_large")
    }
    let narrow = thin_copy_elf_to_small(bytes, len)
    native_compile_result_ok(narrow, len, format_id)
}

fn compile_singlemodule_native_streaming_result_from_program(
    main_path: string,
    prog: &Program,
    target_spec: NativeTargetSpec
) -> NativeCompileResult with IO, Mut, Div, Panic, Alloc {
    if target_spec.arch_id != ARCH_X86_64() || target_spec.os_id != OS_LINUX() {
        return native_compile_result_error(ERR_BACKEND_NOT_IMPLEMENTED(), "streaming_backend_not_implemented")
    }

    var epistemic = ir_empty_epistemic_section()
    let skip_checker = native_streaming_can_skip_checker(main_path, prog)
    if native_streaming_diag_enabled() {
        print("native_streaming: source=")
        print(main_path)
        print(" skip_checker=")
        if skip_checker { print("true") } else { print("false") }
        print("\n")
    }
    if !skip_checker {
        if native_streaming_diag_enabled() {
            print("native_streaming: typecheck_begin\n")
        }
        if !check_program_epistemic_into(*prog, &! epistemic) {
            return native_compile_result_error(ERR_BACKEND_NOT_IMPLEMENTED(), "type_check_failed")
        }
        if native_streaming_diag_enabled() {
            print("native_streaming: typecheck_ok\n")
        }
    }

    // Full body lowering (boxed, ~34 MB heap) includes both user functions AND builtins
    // (print, print_int, etc.) with consistent fn_ids throughout. This is required because
    // per-function streaming body lowering adds builtins with fn_ids > user_fn_count that
    // don't match the summary module's fn_count, breaking CALL relocations.
    if native_streaming_diag_enabled() {
        print("native_streaming: full_lower_begin\n")
    }
    var patch_stats = ir_empty_validated_patch_stats()
    let full_result = lower_program_to_ir_ordered_with_epistemic_boxed_trace_ref(prog, epistemic, &! patch_stats)
    if full_result.had_error {
        return native_compile_result_error(ERR_BACKEND_NOT_IMPLEMENTED(), "ir_lowering_failed")
    }
    let full_module: &IrModule = &(*full_result.module)
    if (*full_module).fn_count <= 0 {
        return native_compile_result_error(ERR_BACKEND_NOT_IMPLEMENTED(), "ir_lowering_empty")
    }
    if native_streaming_diag_enabled() {
        print("native_streaming: full_lower_ok fn_count=")
        print_int((*full_module).fn_count)
        print("\n")
    }

    var nc: NativeCompiler = compiler_new()
    compile_module_streaming_begin_into(&!nc, full_module)
    var fi: i64 = 0
    while fi < (*full_module).fn_count {
        let fn_body = ir_fn_get(&(*full_module), fi as usize)
        if native_streaming_diag_enabled() {
            print("native_streaming: compile_fn fn=")
            print(str_from_bytes(fn_body.name.buf, fn_body.name.len))
            print("\n")
        }
        let lowered: MachineFunction = native_v2_lower_function_to_machine(fn_body)
        let legal: MachineFunction = native_v2_legalize_function(lowered)
        if !legal.supported {
            return native_compile_result_error(
                ERR_BACKEND_NOT_IMPLEMENTED(),
                "streaming_native_v2_unsupported:" + legal.unsupported_detail
            )
        }
        compile_ir_function_v2_into(&!nc, &fn_body, &legal, fi)
        fi = fi + 1
    }

    compile_module_streaming_finish_into(&!nc, full_module)
    let elf: Elf64Binary = finalize_compiled_elf(nc, 4194304)
    thin_native_compile_result_from_elf(elf.bytes, elf.len, FORMAT_ELF64())
}

pub fn compile_multimodule_native_maybe_streaming(main_path: string, target_spec: NativeTargetSpec) -> (bool, NativeCompileResult) with IO, Mut, Div, Panic, Alloc {
    if target_spec.arch_id != ARCH_X86_64() || target_spec.os_id != OS_LINUX() {
        return (false, native_compile_result_error(ERR_BACKEND_NOT_IMPLEMENTED(), "streaming_fallback_target"))
    }
    let prog = load_module_file(main_path)
    if program_has_imports(prog) {
        return (false, native_compile_result_error(ERR_BACKEND_NOT_IMPLEMENTED(), "streaming_fallback_imports"))
    }
    let result = compile_singlemodule_native_streaming_result_from_program(main_path, &prog, target_spec)
    if !result.ok && starts_with(result.error_msg, "streaming_native_v2_unsupported:") {
        return (false, result)
    }
    (true, result)
}

struct ModuleVariantKey {
    normalized_path: string,
    target: string,
    optimize: bool,
    schema_version: i64,
    digest: i64,
}

struct ModuleSummary {
    module_index: i64,
    variant_digest: i64,
    source_hash: i64,
    local_fn_count: i64,
    fn_names: [Name; 256],
    fn_param_counts: [i64; 256],
    fn_strategies: [i64; 256],
}

struct ThinModuleGraphNode {
    file_path: string,
    source_hash: i64,
}

struct ThinModuleGraph {
    nodes: [ThinModuleGraphNode; 64],
    count: i64,
    registry: ModuleRegistry,
    had_error: bool,
    error_msg: string,
}

struct CombinedSummaryIndex {
    module_count: i64,
    exported_count: i64,
    combined_digest: i64,
    global_names: [Name; 1024],
    global_modules: [i64; 1024],
    global_local_ids: [i64; 1024],
}

struct ImportPlan {
    owner_module: i64,
    local_name: Name,
    callee_module: i64,
    export_name: Name,
    selected: bool,
}

struct CompiledUnit {
    module_index: i64,
    key_digest: i64,
    imported_body_count: i64,
    optimized: bool,
    local_fn_count: i64,
    fn_count: i64,
    slot_names: [Name; 256],
    slot_kinds: [i64; 256],
    object_cache_path: string,
    global_ids: [i64; 256],
}

struct CacheActionRecord {
    kind: string,
    digest: i64,
    hit: bool,
}

struct ThinCacheStats {
    summary_hits: i64,
    summary_misses: i64,
    body_hits: i64,
    body_misses: i64,
    object_hits: i64,
    object_misses: i64,
    link_hits: i64,
    link_misses: i64,
    persistent_bytes: i64,
}

fn thin_empty_module_summary() -> ModuleSummary {
    ModuleSummary {
        module_index: -1,
        variant_digest: 0,
        source_hash: 0,
        local_fn_count: 0,
        fn_names: [ir_empty_name(); 256],
        fn_param_counts: [0; 256],
        fn_strategies: [IR_STRATEGY_STANDARD; 256],
    }
}

fn thin_empty_module_graph_node() -> ThinModuleGraphNode {
    ThinModuleGraphNode {
        file_path: "",
        source_hash: 0,
    }
}

fn thin_empty_module_graph() -> ThinModuleGraph {
    ThinModuleGraph {
        nodes: [thin_empty_module_graph_node(); 64],
        count: 0,
        registry: module_registry_new(),
        had_error: false,
        error_msg: "",
    }
}

fn thin_empty_combined_summary_index() -> CombinedSummaryIndex {
    CombinedSummaryIndex {
        module_count: 0,
        exported_count: 0,
        combined_digest: 0,
        global_names: [ir_empty_name(); 1024],
        global_modules: [-1; 1024],
        global_local_ids: [-1; 1024],
    }
}

fn thin_empty_import_plan() -> ImportPlan {
    ImportPlan {
        owner_module: -1,
        local_name: ir_empty_name(),
        callee_module: -1,
        export_name: ir_empty_name(),
        selected: false,
    }
}

fn thin_empty_compiled_unit() -> CompiledUnit {
    CompiledUnit {
        module_index: -1,
        key_digest: 0,
        imported_body_count: 0,
        optimized: false,
        local_fn_count: 0,
        fn_count: 0,
        slot_names: [ir_empty_name(); 256],
        slot_kinds: [0; 256],
        object_cache_path: "",
        global_ids: [-1; 256],
    }
}

fn thin_empty_cache_action_record() -> CacheActionRecord {
    CacheActionRecord { kind: "", digest: 0, hit: false }
}

fn thin_empty_cache_stats() -> ThinCacheStats {
    ThinCacheStats {
        summary_hits: 0,
        summary_misses: 0,
        body_hits: 0,
        body_misses: 0,
        object_hits: 0,
        object_misses: 0,
        link_hits: 0,
        link_misses: 0,
        persistent_bytes: 0,
    }
}

fn thin_module_summary_from_ir_module(
    module_idx: i64,
    variant_digest: i64,
    source_hash: i64,
    module: &IrModule
) -> ModuleSummary with Mut, Panic, Div {
    var summary = thin_empty_module_summary()
    summary.module_index = module_idx
    summary.variant_digest = variant_digest
    summary.source_hash = source_hash
    summary.local_fn_count = (*module).fn_count
    var i: i64 = 0
    while i < (*module).fn_count && i < 256 {
        summary.fn_names[i as usize] = ir_fn_get(&(*module), i as usize).name
        summary.fn_param_counts[i as usize] = ir_fn_get(&(*module), i as usize).param_count
        summary.fn_strategies[i as usize] = ir_fn_get(&(*module), i as usize).compile_strategy
        i = i + 1
    }
    summary
}

fn THIN_HASH_SEED() -> i64 { 1000003 }
fn THIN_CACHE_SCHEMA_VERSION() -> i64 { 1 }

fn thin_hash_mix(base: i64, value: i64) -> i64 with Mut, Panic, Div {
    ((base * 131) + value + 97) % 2147483647
}

fn thin_hash_name(n: Name) -> i64 with Mut, Panic, Div {
    var h = THIN_HASH_SEED()
    var i: i64 = 0
    while i < n.len && i < 384 {
        h = thin_hash_mix(h, n.buf[i as usize] as i64)
        i = i + 1
    }
    h
}

fn thin_hash_string(s: string) -> i64 with Mut, Panic, Div {
    var h = THIN_HASH_SEED()
    var i: i64 = 0
    let n = str_len(s)
    while i < n {
        h = thin_hash_mix(h, str_char_at(s, i))
        i = i + 1
    }
    h
}

fn thin_hash_file(path: string) -> i64 with IO, Mut, Panic, Div {
    let len = file_size(path)
    if len <= 0 {
        return 0
    }
    let data = read_file(path)
    var h = THIN_HASH_SEED()
    var i: i64 = 0
    while i < len && i < 65536 {
        h = thin_hash_mix(h, data[i as usize] as i64)
        i = i + 1
    }
    h
}

fn thin_variant_key_for(path: string, target_spec: NativeTargetSpec, optimize: bool) -> ModuleVariantKey with Mut, Panic, Div {
    let normalized = path
    var digest = thin_hash_string(normalized)
    digest = thin_hash_mix(digest, target_spec.arch_id)
    digest = thin_hash_mix(digest, target_spec.os_id)
    digest = thin_hash_mix(digest, target_spec.matrix_mode)
    digest = thin_hash_mix(digest, if optimize { 1 } else { 0 })
    digest = thin_hash_mix(digest, THIN_CACHE_SCHEMA_VERSION())
    ModuleVariantKey {
        normalized_path: normalized,
        target: target_spec.resolved_target,
        optimize: optimize,
        schema_version: THIN_CACHE_SCHEMA_VERSION(),
        digest: digest,
    }
}

fn thin_cache_mode_can_read(cache_mode: string) -> bool with Mut, Panic, Div {
    str_eq(cache_mode, "read") || str_eq(cache_mode, "rw")
}

fn thin_cache_mode_can_write(cache_mode: string) -> bool with Mut, Panic, Div {
    str_eq(cache_mode, "write") || str_eq(cache_mode, "rw")
}

fn thin_cache_path(cache_dir: string, kind: string, digest: i64, ext: string) -> string with Mut, Panic, Div {
    cache_dir + "/" + kind + "_" + io_trace_i64_string(digest) + ext
}

fn thin_try_write_ir_cache(path: string, module: &IrModule, stats: &! ThinCacheStats) -> bool with IO, Mut, Panic, Div, Alloc {
    let pair = serialize_ir_module(*module)
    if pair.1 <= 0 || pair.1 > 131072 {
        return false
    }
    let ok = write_file(path, pair.0, pair.1) == 0
    if ok {
        (*stats).persistent_bytes = (*stats).persistent_bytes + pair.1
    }
    ok
}

fn thin_try_read_ir_cache(path: string, stats: &! ThinCacheStats) -> (bool, IrModule) with IO, Mut, Panic, Div, Alloc {
    let read_pair = thin_read_small_file(path)
    if read_pair.0 == 0 {
        return (false, ir_empty_module())
    }
    (*stats).persistent_bytes = (*stats).persistent_bytes + read_pair.2
    let restored = deserialize_ir_module(read_pair.1, read_pair.2)
    if restored.fn_count <= 0 {
        return (false, ir_empty_module())
    }
    (true, restored)
}

fn thin_try_read_ir_cache_no_stats(path: string) -> (bool, IrModule) with IO, Mut, Panic, Div, Alloc {
    let read_pair = thin_read_small_file(path)
    if read_pair.0 == 0 {
        return (false, ir_empty_module())
    }
    let restored = deserialize_ir_module(read_pair.1, read_pair.2)
    if restored.fn_count <= 0 {
        return (false, ir_empty_module())
    }
    (true, restored)
}

fn thin_try_write_binary_cache(path: string, bytes: [i8; 16777216], len: i64, stats: &! ThinCacheStats) -> bool with IO, Mut {
    if len <= 0 {
        return false
    }
    let ok = io_write_huge_binary(path, bytes, len)
    if ok {
        (*stats).persistent_bytes = (*stats).persistent_bytes + len
    }
    ok
}

fn thin_try_read_binary_cache(path: string, stats: &! ThinCacheStats) -> (bool, [i8; 131072], i64) with IO, Mut, Panic, Div {
    let read_pair = thin_read_small_file(path)
    if read_pair.0 == 0 {
        return (false, [0; 131072], 0)
    }
    (*stats).persistent_bytes = (*stats).persistent_bytes + read_pair.2
    (true, read_pair.1, read_pair.2)
}

fn thin_cache_skip_ws(buf: [i8; 131072], len: i64, pos: i64) -> i64 with Mut, Panic, Div {
    var p = pos
    while p < len {
        let ch = buf[p as usize] as i64
        if ch == 32 || ch == 10 || ch == 13 || ch == 9 {
            p = p + 1
        } else {
            return p
        }
    }
    p
}

fn thin_cache_read_token(buf: [i8; 131072], len: i64, pos: i64) -> (string, i64) with Mut, Panic, Div {
    var p = thin_cache_skip_ws(buf, len, pos)
    var out: [i8; 256] = [0; 256]
    var out_len: i64 = 0
    while p < len && out_len < 255 {
        let ch = buf[p as usize] as i64
        if ch == 32 || ch == 10 || ch == 13 || ch == 9 {
            break
        }
        out[out_len as usize] = buf[p as usize]
        out_len = out_len + 1
        p = p + 1
    }
    (str_from_bytes(out, out_len), p)
}

fn thin_try_write_summary_cache(path: string, summary: ModuleSummary, stats: &! ThinCacheStats) -> bool with IO, Mut, Panic, Div {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0
    let h0 = io_trace_append_string(buf, p, io_trace_i64_string(summary.local_fn_count))
    buf = h0.0; p = h0.1
    let h1 = io_trace_append_byte(buf, p, 10)
    buf = h1.0; p = h1.1
    var i: i64 = 0
    while i < summary.local_fn_count && i < 256 {
        let a0 = io_trace_append_string(buf, p, thin_name_to_string(summary.fn_names[i as usize]))
        buf = a0.0; p = a0.1
        let a1 = io_trace_append_byte(buf, p, 32)
        buf = a1.0; p = a1.1
        let a2 = io_trace_append_string(buf, p, io_trace_i64_string(summary.fn_param_counts[i as usize]))
        buf = a2.0; p = a2.1
        let a3 = io_trace_append_byte(buf, p, 32)
        buf = a3.0; p = a3.1
        let a4 = io_trace_append_string(buf, p, io_trace_i64_string(summary.fn_strategies[i as usize]))
        buf = a4.0; p = a4.1
        let a5 = io_trace_append_byte(buf, p, 10)
        buf = a5.0; p = a5.1
        i = i + 1
    }
    let ok = io_write_native_binary(path, buf, p)
    if ok {
        (*stats).persistent_bytes = (*stats).persistent_bytes + p
    }
    ok
}

// parse_i64: thin wrapper — parse a decimal string to i64, returning 0 on failure.
// Used by thin-cache readers that write/read integer tokens as plain decimal strings.
fn parse_i64(s: string) -> i64 with Mut, Div {
    let len = str_len(s)
    if len <= 0 {
        return 0
    }

    var idx: i64 = 0
    var sign: i64 = 1
    if str_char_at(s, 0) == 45 {
        sign = 0 - 1
        idx = 1
        if len == 1 {
            return 0
        }
    }

    var value: i64 = 0
    while idx < len {
        let ch = str_char_at(s, idx) as i64
        if ch < 48 || ch > 57 {
            return 0
        }
        value = value * 10 + (ch - 48)
        idx = idx + 1
    }

    if sign < 0 { 0 - value } else { value }
}

fn thin_try_read_summary_cache(
    path: string,
    module_idx: i64,
    variant_digest: i64,
    source_hash: i64,
    stats: &! ThinCacheStats
) -> (bool, ModuleSummary) with IO, Mut, Panic, Div {
    let read_pair = thin_read_small_file(path)
    if read_pair.0 == 0 {
        return (false, thin_empty_module_summary())
    }
    let bytes = read_pair.1
    let len = read_pair.2
    (*stats).persistent_bytes = (*stats).persistent_bytes + len
    var pos: i64 = 0
    let count_tok = thin_cache_read_token(bytes, len, pos)
    let fn_count = parse_i64(count_tok.0)
    pos = count_tok.1
    var summary = thin_empty_module_summary()
    summary.module_index = module_idx
    summary.variant_digest = variant_digest
    summary.source_hash = source_hash
    summary.local_fn_count = fn_count
    var i: i64 = 0
    while i < fn_count && i < 256 {
        let name_tok = thin_cache_read_token(bytes, len, pos)
        pos = name_tok.1
        let param_tok = thin_cache_read_token(bytes, len, pos)
        pos = param_tok.1
        let strat_tok = thin_cache_read_token(bytes, len, pos)
        pos = strat_tok.1
        summary.fn_names[i as usize] = make_name(name_tok.0)
        summary.fn_param_counts[i as usize] = parse_i64(param_tok.0)
        summary.fn_strategies[i as usize] = parse_i64(strat_tok.0)
        i = i + 1
    }
    (true, summary)
}

fn thin_try_write_unit_cache(path: string, unit: CompiledUnit, stats: &! ThinCacheStats) -> bool with IO, Mut, Panic, Div {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0
    let h0 = io_trace_append_string(buf, p, io_trace_i64_string(unit.module_index))
    buf = h0.0; p = h0.1
    let h1 = io_trace_append_byte(buf, p, 32)
    buf = h1.0; p = h1.1
    let h2 = io_trace_append_string(buf, p, io_trace_i64_string(unit.key_digest))
    buf = h2.0; p = h2.1
    let h3 = io_trace_append_byte(buf, p, 32)
    buf = h3.0; p = h3.1
    let h4 = io_trace_append_string(buf, p, io_trace_i64_string(unit.imported_body_count))
    buf = h4.0; p = h4.1
    let h5 = io_trace_append_byte(buf, p, 32)
    buf = h5.0; p = h5.1
    let h6 = io_trace_append_string(buf, p, io_trace_i64_string(if unit.optimized { 1 } else { 0 }))
    buf = h6.0; p = h6.1
    let h7 = io_trace_append_byte(buf, p, 32)
    buf = h7.0; p = h7.1
    let h8 = io_trace_append_string(buf, p, io_trace_i64_string(unit.local_fn_count))
    buf = h8.0; p = h8.1
    let h9 = io_trace_append_byte(buf, p, 32)
    buf = h9.0; p = h9.1
    let h10 = io_trace_append_string(buf, p, io_trace_i64_string(unit.fn_count))
    buf = h10.0; p = h10.1
    let h11 = io_trace_append_byte(buf, p, 10)
    buf = h11.0; p = h11.1
    var i: i64 = 0
    while i < unit.fn_count && i < 256 {
        let a0 = io_trace_append_string(buf, p, thin_name_to_string(unit.slot_names[i as usize]))
        buf = a0.0; p = a0.1
        let a1 = io_trace_append_byte(buf, p, 32)
        buf = a1.0; p = a1.1
        let a2 = io_trace_append_string(buf, p, io_trace_i64_string(unit.slot_kinds[i as usize]))
        buf = a2.0; p = a2.1
        let a3 = io_trace_append_byte(buf, p, 10)
        buf = a3.0; p = a3.1
        i = i + 1
    }
    let ok = io_write_native_binary(path, buf, p)
    if ok {
        (*stats).persistent_bytes = (*stats).persistent_bytes + p
    }
    ok
}

fn thin_try_read_unit_cache(path: string, stats: &! ThinCacheStats) -> (bool, CompiledUnit) with IO, Mut, Panic, Div {
    let read_pair = thin_read_small_file(path)
    if read_pair.0 == 0 {
        return (false, thin_empty_compiled_unit())
    }
    let bytes = read_pair.1
    let len = read_pair.2
    (*stats).persistent_bytes = (*stats).persistent_bytes + len
    var pos: i64 = 0
    let m0 = thin_cache_read_token(bytes, len, pos)
    pos = m0.1
    let m1 = thin_cache_read_token(bytes, len, pos)
    pos = m1.1
    let m2 = thin_cache_read_token(bytes, len, pos)
    pos = m2.1
    let m3 = thin_cache_read_token(bytes, len, pos)
    pos = m3.1
    let m4 = thin_cache_read_token(bytes, len, pos)
    pos = m4.1
    let m5 = thin_cache_read_token(bytes, len, pos)
    pos = m5.1
    var unit = thin_empty_compiled_unit()
    unit.module_index = parse_i64(m0.0)
    unit.key_digest = parse_i64(m1.0)
    unit.imported_body_count = parse_i64(m2.0)
    unit.optimized = parse_i64(m3.0) != 0
    unit.local_fn_count = parse_i64(m4.0)
    unit.fn_count = parse_i64(m5.0)
    var i: i64 = 0
    while i < unit.fn_count && i < 256 {
        let name_tok = thin_cache_read_token(bytes, len, pos)
        pos = name_tok.1
        let kind_tok = thin_cache_read_token(bytes, len, pos)
        pos = kind_tok.1
        unit.slot_names[i as usize] = make_name(name_tok.0)
        unit.slot_kinds[i as usize] = parse_i64(kind_tok.0)
        i = i + 1
    }
    (true, unit)
}

struct ThinImportMap {
    names: [Name; 256],
    module_indices: [i64; 256],
    export_names: [Name; 256],
    count: i64,
}

fn thin_empty_import_map() -> ThinImportMap {
    ThinImportMap {
        names: [ir_empty_name(); 256],
        module_indices: [-1; 256],
        export_names: [ir_empty_name(); 256],
        count: 0,
    }
}

fn thin_import_map_add(map: ThinImportMap, name: Name, module_idx: i64, export_name: Name) -> ThinImportMap with Mut, Panic, Div {
    var out = map
    var i: i64 = 0
    while i < out.count {
        if ir_name_eq(out.names[i as usize], name) {
            out.module_indices[i as usize] = module_idx
            out.export_names[i as usize] = export_name
            return out
        }
        i = i + 1
    }
    if out.count < 256 {
        out.names[out.count as usize] = name
        out.module_indices[out.count as usize] = module_idx
        out.export_names[out.count as usize] = export_name
        out.count = out.count + 1
    }
    out
}

fn thin_import_map_find(map: ThinImportMap, name: Name) -> (bool, i64, Name) with Mut, Panic, Div {
    var i: i64 = 0
    while i < map.count {
        if ir_name_eq(map.names[i as usize], name) {
            return (true, map.module_indices[i as usize], map.export_names[i as usize])
        }
        i = i + 1
    }
    (false, -1, ir_empty_name())
}

fn thin_collect_selective_imports(
    map: ThinImportMap,
    module_idx: i64,
    items: Option<Box<ImportItemList>>
) -> ThinImportMap with Mut, Panic, Div, Alloc {
    match items {
        None => map
        Some(list) => {
            let out = thin_import_map_add(map, (*list).head, module_idx, (*list).head)
            thin_collect_selective_imports(out, module_idx, (*list).tail)
        }
    }
}

fn thin_collect_glob_imports_from_entry(map: ThinImportMap, module_idx: i64, entry: ModuleEntry) -> ThinImportMap with Mut, Panic, Div {
    var out = map
    var i: i64 = 0
    while i < entry.export_count {
        // #1689: pool-backed exports; the old `&& i < 1024` was a silent cap.
        let at = entry.export_base + i
        if modreg_export_kind_at(at) == SymbolKind::SymFunction {
            let nm = modreg_export_name_at(at)
            out = thin_import_map_add(out, nm, module_idx, nm)
        }
        i = i + 1
    }
    out
}

fn thin_collect_imports_from_items(
    items: Option<Box<ItemList>>,
    registry: ModuleRegistry,
    map: ThinImportMap
) -> ThinImportMap with Mut, Panic, Div, Alloc {
    match items {
        None => map
        Some(list) => {
            let item = (*list).head
            var out = map
            if item.kind == ItemKind::ItemUse {
                let idx = module_registry_find(registry, item.use_path)
                if idx >= 0 && idx < registry.count {
                    let entry = registry.modules[idx as usize]
                    if item.use_glob {
                        out = thin_collect_glob_imports_from_entry(out, idx, entry)
                    } else if item.use_items != None {
                        out = thin_collect_selective_imports(out, idx, item.use_items)
                    }
                }
            }
            thin_collect_imports_from_items((*list).tail, registry, out)
        }
    }
}

fn thin_load_module_graph(main_path: string) -> ThinModuleGraph with IO, Mut, Panic, Div, Alloc {
    print("[thinlink] graph:start ")
    print(main_path)
    print("\n")
    let main_prog = load_module_file(main_path)
    println("[thinlink] graph:main_loaded")
    var graph = thin_empty_module_graph()
    graph.nodes[0].file_path = main_path
    graph.count = 1

    var visited_paths: [string; 64] = [""; 64]
    var visited_count: i64 = 0
    visited_paths[0] = main_path
    visited_count = 1
    var work_front: i64 = 0
    while work_front < graph.count && graph.count < 64 {
        let cur_dir = path_directory(graph.nodes[work_front as usize].file_path)
        let work_prog = load_module_file(graph.nodes[work_front as usize].file_path)
        let imports = extract_imports_from_ast(work_prog)
        work_front = work_front + 1
        var i: i64 = 0
        while i < imports.count && graph.count < 64 {
            let file_path = resolve_import_file_path(imports.paths[i], cur_dir)
            if !visited_contains(visited_paths, visited_count, file_path) {
                visited_paths[visited_count] = file_path
                visited_count = visited_count + 1
                if file_exists(file_path) {
                    print("[thinlink] graph:load_dep ")
                    print(file_path)
                    print("\n")
                    graph.nodes[graph.count as usize].file_path = file_path
                    println("[thinlink] graph:dep_loaded")
                    graph.count = graph.count + 1
                }
            }
            i = i + 1
        }
    }
    println("[thinlink] graph:loaded=" + io_trace_i64_string(graph.count))

    graph.registry = module_registry_new()
    var pi: i64 = 0
    while pi < graph.count {
        let prog = load_module_file(graph.nodes[pi as usize].file_path)
        let exports = collect_module_exports(prog.items)
        graph.registry = module_registry_put(graph.registry, prog.module_path, exports.0, exports.1)
        graph.nodes[pi as usize].source_hash = thin_hash_file(graph.nodes[pi as usize].file_path)
        pi = pi + 1
    }
    // #1689: ASK. The overflow flag was written and never read, so a dropped
    // module surfaced as E137 on innocent call sites.
    let _ovf = module_registry_report_overflow(graph.registry)
    println("[thinlink] graph:registry_ready")

    graph
}

fn thin_module_summary_lookup_local(summary: ModuleSummary, fn_name: Name) -> (bool, i64, IrFunction) with Mut, Panic, Div {
    var i: i64 = 0
    while i < summary.local_fn_count && i < 256 {
        if ir_name_eq(summary.fn_names[i as usize], fn_name) {
            var func = ir_empty_function()
            func.name = summary.fn_names[i as usize]
            func.param_count = summary.fn_param_counts[i as usize]
            func.compile_strategy = summary.fn_strategies[i as usize]
            return (true, i, func)
        }
        i = i + 1
    }
    (false, -1, ir_empty_function())
}

fn thin_module_summary_lookup_any(summary: ModuleSummary, fn_name: Name) -> (bool, i64, IrFunction) with Mut, Panic, Div {
    thin_module_summary_lookup_local(summary, fn_name)
}

fn thin_load_or_build_module_summary(
    graph: ThinModuleGraph,
    module_idx: i64,
    target_spec: NativeTargetSpec,
    optimize: bool,
    cache_dir: string,
    cache_mode: string,
    stats: &! ThinCacheStats
) -> (bool, ModuleSummary, IrProgramSummary) with IO, Mut, Panic, Div, Alloc {
    let node = graph.nodes[module_idx as usize]
    let variant = thin_variant_key_for(node.file_path, target_spec, optimize)
    let summary_digest = thin_hash_mix(variant.digest, node.source_hash)
    let cache_path = thin_cache_path(cache_dir, "summary", summary_digest, ".soir")
    if str_len(cache_dir) > 0 && thin_cache_mode_can_read(cache_mode) {
        let cached = thin_try_read_ir_cache(cache_path, &! stats)
        if cached.0 != 0 {
            (*stats).summary_hits = (*stats).summary_hits + 1
            let cached_module = cached.1
            let summary = thin_module_summary_from_ir_module(module_idx, variant.digest, node.source_hash, &cached_module)
            return (true, summary, ir_empty_program_summary())
        }
    }

    (*stats).summary_misses = (*stats).summary_misses + 1
    let lower_summary = lower_program_to_ir_summary_with_epistemic(load_module_file(node.file_path), ir_empty_epistemic_section())
    if lower_summary.had_error {
        return (false, thin_empty_module_summary(), ir_empty_program_summary())
    }
    let lower_summary_module = &(*lower_summary.summary.module)
    if (*lower_summary_module).fn_count <= 0 {
        return (false, thin_empty_module_summary(), ir_empty_program_summary())
    }
    let summary = thin_module_summary_from_ir_module(module_idx, variant.digest, node.source_hash, lower_summary_module)
    if str_len(cache_dir) > 0 && thin_cache_mode_can_write(cache_mode) {
        let _ = thin_try_write_ir_cache(cache_path, lower_summary_module, &! stats)
    }
    (true, summary, lower_summary.summary)
}

fn thin_name_to_string(name: Name) -> string with Mut, Panic, Div {
    var buf: [i8; 512] = [0; 512]
    var i: i64 = 0
    while i < name.len && i < 128 {
        buf[i as usize] = name.buf[i as usize]
        i = i + 1
    }
    buf_to_string(buf, i)
}

fn thin_is_builtin_name(name: Name) -> bool with Mut, Panic, Div {
    name_is_print_int(name) ||
    name_is_print_char(name) ||
    name_is_print(name) ||
    name_is_get_arg_count(name) ||
    name_is_get_arg(name) ||
    name_is_str_len(name) ||
    name_is_str_eq(name) ||
    name_is_str_slice(name) ||
    name_is_str_slice3(name) ||
    name_is_starts_with(name) ||
    name_is_str_concat(name) ||
    name_is_read_file(name) ||
    name_is_write_file(name) ||
    name_is_file_size(name)
}

fn thin_emit_public_name(module_idx: i64, name: Name) -> Name with Mut, Panic, Div {
    if name_is_main(name) || thin_is_builtin_name(name) {
        return name
    }
    make_name("thin_m" + io_trace_i64_string(module_idx) + "_" + thin_name_to_string(name))
}

fn thin_emit_private_import_name(module_idx: i64, name: Name) -> Name with Mut, Panic, Div {
    if thin_is_builtin_name(name) {
        return name
    }
    make_name("thin_imp" + io_trace_i64_string(module_idx) + "_" + thin_name_to_string(name))
}

fn thin_find_fn_slot(module: IrModule, name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < module.fn_count {
        if ir_name_eq(ir_fn_get(&module, i as usize).name, name) {
            return i
        }
        i = i + 1
    }
    -1
}

fn thin_make_stub_from_func(func: IrFunction, stub_name: Name) -> IrFunction with Mut, Panic, Div {
    var out = func
    out.name = stub_name
    out.instr_count = 0
    out.reg_count = 0
    out.label_count = 0
    out.prof_counter_id = -1
    out
}

fn thin_append_stub_if_missing(module: IrModule, func: IrFunction, stub_name: Name) -> (IrModule, i64) with Alloc, Mut, Panic, Div {
    let found = thin_find_fn_slot(module, stub_name)
    if found >= 0 {
        return (module, found)
    }
    var out = module
    if out.fn_count >= IR_MAX_FUNCS {
        return (out, -1)
    }
    let idx = out.fn_count
    ir_fn_set(&! out, idx as usize, thin_make_stub_from_func(func, stub_name))
    out.fn_count = idx + 1
    (out, idx)
}

fn thin_build_combined_summary_index(
    summaries: [ModuleSummary; 64],
    module_count: i64
) -> CombinedSummaryIndex with Mut, Panic, Div {
    var out = thin_empty_combined_summary_index()
    out.module_count = module_count
    var digest = THIN_HASH_SEED()
    var mi: i64 = 0
    while mi < module_count {
        let summary = summaries[mi as usize]
        digest = thin_hash_mix(digest, summary.variant_digest)
        digest = thin_hash_mix(digest, summary.source_hash)
        digest = thin_hash_mix(digest, summary.local_fn_count)
        var fi: i64 = 0
        while fi < summary.local_fn_count && out.exported_count < 1024 {
            let func_name = summary.fn_names[fi as usize]
            out.global_names[out.exported_count as usize] = func_name
            out.global_modules[out.exported_count as usize] = mi
            out.global_local_ids[out.exported_count as usize] = fi
            out.exported_count = out.exported_count + 1
            digest = thin_hash_mix(digest, thin_hash_name(func_name))
            digest = thin_hash_mix(digest, summary.fn_param_counts[fi as usize])
            digest = thin_hash_mix(digest, summary.fn_strategies[fi as usize])
            fi = fi + 1
        }
        mi = mi + 1
    }
    out.combined_digest = digest
    out
}

fn thin_function_importable(func: IrFunction) -> bool with Mut, Panic, Div {
    if func.instr_count <= 0 || func.instr_count > 16 {
        return false
    }
    var i: i64 = 0
    while i < func.instr_count {
        let op = (IR_A_OP[(ir_region_slot_r(func.region, (i))) as usize] as IrOpcode)
        if op == IrOpcode::IrCall ||
           op == IrOpcode::IrJump ||
           op == IrOpcode::IrBranchTrue ||
           op == IrOpcode::IrBranchFalse ||
           op == IrOpcode::IrLabel ||
           op == IrOpcode::IrFieldSet ||
           op == IrOpcode::IrIndexSet ||
           op == IrOpcode::IrProfCounter {
            return false
        }
        i = i + 1
    }
    true
}

fn thin_load_profile_if_requested(
    use_profile: bool,
    use_profile_path: string
) -> (bool, SprofProfile, i64) with IO, Mut, Panic, Div {
    if !use_profile || str_len(use_profile_path) <= 0 {
        return (false, sprof_empty_profile(), 0)
    }
    let prof_size = file_size(use_profile_path)
    if prof_size <= 0 {
        return (false, sprof_empty_profile(), 0)
    }
    let prof_bytes = read_file(use_profile_path)
    var prof_buf: [i8; 4096] = [0; 4096]
    var pi: i64 = 0
    while pi < prof_size && pi < 4096 {
        prof_buf[pi as usize] = prof_bytes[pi as usize]
        pi = pi + 1
    }
    (true, sprof_parse(prof_buf, prof_size), thin_hash_file(use_profile_path))
}

fn thin_build_import_plans(
    graph: ThinModuleGraph,
    summaries: [ModuleSummary; 64],
    owner_module: i64,
    import_map: ThinImportMap,
    optimize: bool
) -> ([ImportPlan; 256], i64) with IO, Mut, Panic, Div, Alloc {
    var plans: [ImportPlan; 256] = [thin_empty_import_plan(); 256]
    var count: i64 = 0
    var i: i64 = 0
    while i < import_map.count && count < 256 {
        var plan = thin_empty_import_plan()
        plan.owner_module = owner_module
        plan.local_name = import_map.names[i as usize]
        plan.callee_module = import_map.module_indices[i as usize]
        plan.export_name = import_map.export_names[i as usize]
        plan.selected = false
        if optimize && plan.callee_module >= 0 && plan.callee_module < graph.count {
            let callee_summary = lower_program_to_ir_summary_with_epistemic(
                load_module_file(graph.nodes[plan.callee_module as usize].file_path),
                ir_empty_epistemic_section()
            )
            if callee_summary.had_error {
                plans[count as usize] = plan
                count = count + 1
                i = i + 1
                continue
            }
            let body = lower_program_function_body_from_summary_with_epistemic(
                load_module_file(graph.nodes[plan.callee_module as usize].file_path),
                callee_summary.summary,
                ir_empty_epistemic_section(),
                plan.export_name
            )
            if !body.had_error && thin_function_importable(body.func) {
                plan.selected = true
            }
        }
        plans[count as usize] = plan
        count = count + 1
        i = i + 1
    }
    (plans, count)
}

fn thin_build_compiled_unit(
    graph: ThinModuleGraph,
    summaries: [ModuleSummary; 64],
    module_idx: i64,
    import_map: ThinImportMap,
    combined_digest: i64,
    optimize: bool,
    profile_loaded: bool,
    profile: SprofProfile,
    profile_hash: i64,
    cache_dir: string,
    cache_mode: string,
    stats: &! ThinCacheStats
) -> (bool, CompiledUnit, IrModule, i64, i64, i64, i64, i64) with IO, Mut, Panic, Div, Alloc {
    print("[thinlink] unit:start ")
    print_int(module_idx)
    print("\n")
    let owner_prog = load_module_file(graph.nodes[module_idx as usize].file_path)
    let owner_summary_pair = lower_program_to_ir_summary_with_epistemic(owner_prog, ir_empty_epistemic_section())
    if owner_summary_pair.had_error {
        return (false, thin_empty_compiled_unit(), ir_empty_module(), 0, 0, 0, 0, 0)
    }
    println("[thinlink] unit:summary_ready")
    let owner_summary = owner_summary_pair.summary
    if (*owner_summary.module).fn_count <= 0 {
        return (false, thin_empty_compiled_unit(), ir_empty_module(), 0, 0, 0, 0, 0)
    }
    let plan_pair = thin_build_import_plans(graph, summaries, module_idx, import_map, optimize)
    let plans = plan_pair.0
    let plan_count = plan_pair.1
    println("[thinlink] unit:plans=" + io_trace_i64_string(plan_count))

    var imported_body_count: i64 = 0
    var body_digest = THIN_HASH_SEED()
    body_digest = thin_hash_mix(body_digest, summaries[module_idx as usize].variant_digest)
    body_digest = thin_hash_mix(body_digest, summaries[module_idx as usize].source_hash)
    body_digest = thin_hash_mix(body_digest, combined_digest)
    body_digest = thin_hash_mix(body_digest, if optimize { 1 } else { 0 })
    body_digest = thin_hash_mix(body_digest, if profile_loaded { profile_hash } else { 0 })

    var pi: i64 = 0
    while pi < plan_count {
        let plan = plans[pi as usize]
        body_digest = thin_hash_mix(body_digest, thin_hash_name(plan.local_name))
        body_digest = thin_hash_mix(body_digest, thin_hash_name(plan.export_name))
        body_digest = thin_hash_mix(body_digest, plan.callee_module)
        if plan.callee_module >= 0 && plan.callee_module < graph.count {
            body_digest = thin_hash_mix(body_digest, summaries[plan.callee_module as usize].source_hash)
        }
        if plan.selected {
            imported_body_count = imported_body_count + 1
            body_digest = thin_hash_mix(body_digest, 1)
        } else {
            body_digest = thin_hash_mix(body_digest, 0)
        }
        pi = pi + 1
    }

    let body_cache_path = thin_cache_path(cache_dir, "body", body_digest, ".soir")
    var body_module = ir_empty_module()
    if str_len(cache_dir) > 0 && thin_cache_mode_can_read(cache_mode) {
        let cached_body = thin_try_read_ir_cache(body_cache_path, &! stats)
        if cached_body.0 != 0 {
            (*stats).body_hits = (*stats).body_hits + 1
            body_module = cached_body.1
        }
    }

    if body_module.fn_count <= 0 {
        (*stats).body_misses = (*stats).body_misses + 1
        var working_summary = owner_summary
        println("[thinlink] unit:body_build")
        var map_i: i64 = 0
        while map_i < import_map.count {
            let callee_module = import_map.module_indices[map_i as usize]
            let export_name = import_map.export_names[map_i as usize]
            let local_name = import_map.names[map_i as usize]
            if callee_module >= 0 && callee_module < graph.count {
                let export_lookup = thin_module_summary_lookup_local(summaries[callee_module as usize], export_name)
                if export_lookup.0 != 0 {
                    let pair = thin_append_stub_if_missing(*working_summary.module, export_lookup.2, local_name)
                    working_summary.module = Box::new(pair.0)
                }
            }
            map_i = map_i + 1
        }

        body_module = *working_summary.module
        var li: i64 = 0
        while li < summaries[module_idx as usize].local_fn_count {
            let local_name = summaries[module_idx as usize].fn_names[li as usize]
            print("[thinlink] unit:body_fn ")
            print(thin_name_to_string(local_name))
            print("\n")
            let body = lower_program_function_body_from_summary_with_epistemic(
                owner_prog,
                working_summary,
                ir_empty_epistemic_section(),
                local_name
            )
            if body.had_error {
                return (false, thin_empty_compiled_unit(), ir_empty_module(), 0, 0, 0, 0, 0)
            }
            let slot = thin_find_fn_slot(body_module, local_name)
            if slot < 0 {
                return (false, thin_empty_compiled_unit(), ir_empty_module(), 0, 0, 0, 0, 0)
            }
            ir_fn_set(&! body_module, slot as usize, body.func)
            li = li + 1
        }
        println("[thinlink] unit:locals_done")

        pi = 0
        while pi < plan_count {
            let plan = plans[pi as usize]
            if plan.selected && plan.callee_module >= 0 && plan.callee_module < graph.count {
                let callee_summary = lower_program_to_ir_summary_with_epistemic(
                    load_module_file(graph.nodes[plan.callee_module as usize].file_path),
                    ir_empty_epistemic_section()
                )
                if callee_summary.had_error || (*callee_summary.summary.module).fn_count <= 0 {
                    return (false, thin_empty_compiled_unit(), ir_empty_module(), 0, 0, 0, 0, 0)
                }
                let imported_body = lower_program_function_body_from_summary_with_epistemic(
                    load_module_file(graph.nodes[plan.callee_module as usize].file_path),
                    callee_summary.summary,
                    ir_empty_epistemic_section(),
                    plan.export_name
                )
                if imported_body.had_error {
                    return (false, thin_empty_compiled_unit(), ir_empty_module(), 0, 0, 0, 0, 0)
                }
                let slot = thin_find_fn_slot(body_module, plan.local_name)
                if slot < 0 {
                    return (false, thin_empty_compiled_unit(), ir_empty_module(), 0, 0, 0, 0, 0)
                }
                var imported_func = imported_body.func
                imported_func.name = plan.local_name
                ir_fn_set(&! body_module, slot as usize, imported_func)
            }
            pi = pi + 1
        }

        let _ = thin_try_write_ir_cache(body_cache_path, &body_module, &! stats)
    }

    let object_digest = thin_hash_mix(body_digest, 17)
    let object_cache_path = thin_cache_path(cache_dir, "object", object_digest, ".soir")
    var object_module = ir_empty_module()
    if str_len(cache_dir) > 0 && thin_cache_mode_can_read(cache_mode) {
        let cached_object = thin_try_read_ir_cache(object_cache_path, &! stats)
        if cached_object.0 != 0 {
            (*stats).object_hits = (*stats).object_hits + 1
            object_module = cached_object.1
        }
    }

    var inline_count: i64 = 0
    var loop_hoists: i64 = 0
    var tco_count: i64 = 0
    if object_module.fn_count <= 0 {
        (*stats).object_misses = (*stats).object_misses + 1
        object_module = body_module
        if profile_loaded {
            sprof_apply_promotion(&! object_module, &profile)
        }
        if optimize {
            inline_count = object_module.fn_count
            object_module = inl_run_pass(object_module)
            object_module = opt_cleanup_module(object_module)
            let loop_result = lopt_optimize_module(object_module)
            object_module = loop_result.module
            loop_hoists = loop_result.invariants_hoisted
            object_module = opt_cleanup_module(object_module)
            let tco_result = tco_run_pass(object_module)
            object_module = tco_result.0
            tco_count = tco_result.1.stats.transformed
        }
        let _ = thin_try_write_ir_cache(object_cache_path, &object_module, &! stats)
    } else if optimize {
        inline_count = object_module.fn_count
    }

    var unit = thin_empty_compiled_unit()
    unit.module_index = module_idx
    unit.key_digest = object_digest
    unit.imported_body_count = imported_body_count
    unit.optimized = optimize
    unit.local_fn_count = summaries[module_idx as usize].local_fn_count
    unit.fn_count = object_module.fn_count
    unit.object_cache_path = object_cache_path
    var si: i64 = 0
    while si < object_module.fn_count && si < 256 {
        unit.slot_names[si as usize] = ir_fn_get(&object_module, si as usize).name
        if si < unit.local_fn_count {
            unit.slot_kinds[si as usize] = 0
        } else {
            let imported = thin_import_map_find(import_map, ir_fn_get(&object_module, si as usize).name)
            if thin_is_builtin_name(ir_fn_get(&object_module, si as usize).name) {
                unit.slot_kinds[si as usize] = 1
            } else if imported.0 && ir_fn_get(&object_module, si as usize).instr_count > 0 {
                unit.slot_kinds[si as usize] = 2
            } else {
                unit.slot_kinds[si as usize] = 3
            }
        }
        si = si + 1
    }
    (true, unit, object_module, body_digest, object_digest, imported_body_count, inline_count, loop_hoists + tco_count)
}

fn thin_map_target_to_global(
    owner_module: i64,
    owner_import_map: ThinImportMap,
    units: [CompiledUnit; 64],
    summaries: [ModuleSummary; 64],
    target_idx: i64,
    target_name: Name
) -> (bool, i64) with Mut, Panic, Div {
    let owner_unit = units[owner_module as usize]
    if target_idx < 0 || target_idx >= owner_unit.fn_count {
        return (false, -1)
    }
    if owner_unit.global_ids[target_idx as usize] >= 0 {
        return (true, owner_unit.global_ids[target_idx as usize])
    }
    let imported = thin_import_map_find(owner_import_map, target_name)
    if imported.0 && imported.1 >= 0 {
        let lookup = thin_module_summary_lookup_local(summaries[imported.1 as usize], imported.2)
        if lookup.0 != 0 {
            let global_id = units[imported.1 as usize].global_ids[lookup.1 as usize]
            if global_id >= 0 {
                return (true, global_id)
            }
        }
    }
    (false, -1)
}

fn thin_remap_prof_counter(func: IrFunction, new_counter_id: i64) -> IrFunction with Mut, Panic, Div {
    var out = ir_function_clone(&func)
    out.prof_counter_id = new_counter_id
    var i: i64 = 0
    while i < out.instr_count {
        if (IR_A_OP[(ir_region_slot_r(out.region, (i))) as usize] as IrOpcode) == IrOpcode::IrProfCounter {
            var instr = ir_arena_load(ir_region_slot_r(out.region, (i)))
            instr.imm_i64 = new_counter_id
            ir_arena_store(ir_region_slot_w(out.region, (i)), instr)
        }
        i = i + 1
    }
    out
}

fn thin_write_native_decision_trace_extended(
    path: string,
    requested_target: string,
    resolved_target: string,
    matrix_mode: string,
    source: string,
    fallback_reason: string,
    backend: string,
    pipeline: string,
    module_count: i64,
    imported_body_count: i64,
    stats: ThinCacheStats,
    root_digest: i64,
    ok: bool,
    error_code: i64
) -> bool with IO, Mut, Panic, Div {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0

    let p0 = io_trace_append_byte(buf, p, 123)
    buf = p0.0; p = p0.1
    let p1 = io_trace_append_string(buf, p, "\"requested_target\":\"")
    buf = p1.0; p = p1.1
    let p2 = io_trace_append_json_string(buf, p, requested_target)
    buf = p2.0; p = p2.1
    let p3 = io_trace_append_string(buf, p, "\",")
    buf = p3.0; p = p3.1
    let p4 = io_trace_append_string(buf, p, "\"resolved_target\":\"")
    buf = p4.0; p = p4.1
    let p5 = io_trace_append_json_string(buf, p, resolved_target)
    buf = p5.0; p = p5.1
    let p6 = io_trace_append_string(buf, p, "\",")
    buf = p6.0; p = p6.1
    let p7 = io_trace_append_string(buf, p, "\"matrix_mode\":\"")
    buf = p7.0; p = p7.1
    let p8 = io_trace_append_json_string(buf, p, matrix_mode)
    buf = p8.0; p = p8.1
    let p9 = io_trace_append_string(buf, p, "\",")
    buf = p9.0; p = p9.1
    let p10 = io_trace_append_string(buf, p, "\"source\":\"")
    buf = p10.0; p = p10.1
    let p11 = io_trace_append_json_string(buf, p, source)
    buf = p11.0; p = p11.1
    let p12 = io_trace_append_string(buf, p, "\",")
    buf = p12.0; p = p12.1
    let p13 = io_trace_append_string(buf, p, "\"fallback_reason\":\"")
    buf = p13.0; p = p13.1
    let p14 = io_trace_append_json_string(buf, p, fallback_reason)
    buf = p14.0; p = p14.1
    let p15 = io_trace_append_string(buf, p, "\",")
    buf = p15.0; p = p15.1
    let p16 = io_trace_append_string(buf, p, "\"backend\":\"")
    buf = p16.0; p = p16.1
    let p17 = io_trace_append_json_string(buf, p, backend)
    buf = p17.0; p = p17.1
    let p18 = io_trace_append_string(buf, p, "\",")
    buf = p18.0; p = p18.1
    let p19 = io_trace_append_string(buf, p, "\"pipeline\":\"")
    buf = p19.0; p = p19.1
    let p20 = io_trace_append_json_string(buf, p, pipeline)
    buf = p20.0; p = p20.1
    let p21 = io_trace_append_string(buf, p, "\",")
    buf = p21.0; p = p21.1
    let p22 = io_trace_append_string(buf, p, "\"module_count\":")
    buf = p22.0; p = p22.1
    let p23 = io_trace_append_string(buf, p, io_trace_i64_string(module_count))
    buf = p23.0; p = p23.1
    let p24 = io_trace_append_string(buf, p, ",\"imported_body_count\":")
    buf = p24.0; p = p24.1
    let p25 = io_trace_append_string(buf, p, io_trace_i64_string(imported_body_count))
    buf = p25.0; p = p25.1
    let p26 = io_trace_append_string(buf, p, ",\"cache\":{\"summary_hits\":")
    buf = p26.0; p = p26.1
    let p27 = io_trace_append_string(buf, p, io_trace_i64_string(stats.summary_hits))
    buf = p27.0; p = p27.1
    let p28 = io_trace_append_string(buf, p, ",\"summary_misses\":")
    buf = p28.0; p = p28.1
    let p29 = io_trace_append_string(buf, p, io_trace_i64_string(stats.summary_misses))
    buf = p29.0; p = p29.1
    let p30 = io_trace_append_string(buf, p, ",\"body_hits\":")
    buf = p30.0; p = p30.1
    let p31 = io_trace_append_string(buf, p, io_trace_i64_string(stats.body_hits))
    buf = p31.0; p = p31.1
    let p32 = io_trace_append_string(buf, p, ",\"body_misses\":")
    buf = p32.0; p = p32.1
    let p33 = io_trace_append_string(buf, p, io_trace_i64_string(stats.body_misses))
    buf = p33.0; p = p33.1
    let p34 = io_trace_append_string(buf, p, ",\"object_hits\":")
    buf = p34.0; p = p34.1
    let p35 = io_trace_append_string(buf, p, io_trace_i64_string(stats.object_hits))
    buf = p35.0; p = p35.1
    let p36 = io_trace_append_string(buf, p, ",\"object_misses\":")
    buf = p36.0; p = p36.1
    let p37 = io_trace_append_string(buf, p, io_trace_i64_string(stats.object_misses))
    buf = p37.0; p = p37.1
    let p38 = io_trace_append_string(buf, p, ",\"link_hits\":")
    buf = p38.0; p = p38.1
    let p39 = io_trace_append_string(buf, p, io_trace_i64_string(stats.link_hits))
    buf = p39.0; p = p39.1
    let p40 = io_trace_append_string(buf, p, ",\"link_misses\":")
    buf = p40.0; p = p40.1
    let p41 = io_trace_append_string(buf, p, io_trace_i64_string(stats.link_misses))
    buf = p41.0; p = p41.1
    let p42 = io_trace_append_string(buf, p, ",\"persistent_bytes\":")
    buf = p42.0; p = p42.1
    let p43 = io_trace_append_string(buf, p, io_trace_i64_string(stats.persistent_bytes))
    buf = p43.0; p = p43.1
    let p44 = io_trace_append_string(buf, p, "},\"root_digest\":")
    buf = p44.0; p = p44.1
    let p45 = io_trace_append_string(buf, p, io_trace_i64_string(root_digest))
    buf = p45.0; p = p45.1
    let p46 = io_trace_append_string(buf, p, ",\"ok\":")
    buf = p46.0; p = p46.1
    let p47 = io_trace_append_string(buf, p, io_trace_bool_string(ok))
    buf = p47.0; p = p47.1
    let p48 = io_trace_append_string(buf, p, ",\"error_code\":")
    buf = p48.0; p = p48.1
    let p49 = io_trace_append_string(buf, p, io_trace_i64_string(error_code))
    buf = p49.0; p = p49.1
    let p50 = io_trace_append_byte(buf, p, 125)
    buf = p50.0; p = p50.1
    let p51 = io_trace_append_byte(buf, p, 10)
    buf = p51.0; p = p51.1
    io_write_bytes_to_file(path, buf, p)
}

pub fn compile_multimodule_native_advanced(
    main_path: string,
    output_path: string,
    requested_target: string,
    requested_matrix: string,
    explicit_target: bool,
    gpu_target: string,
    gpu_binary_format: string,
    gpu_strict_parity: bool,
    optimize: bool,
    use_profile: bool,
    use_profile_path: string,
    cache_dir: string,
    cache_mode: string,
    cache_stats: bool
) -> i32 with IO, Mut, Div, Panic, Alloc {
    if str_eq(requested_target, "wasm") {
        let wir = load_multimodule_ir(main_path)
        if !wir.ok {
            print("Multi-module IR failed: ")
            print(wir.error_msg)
            print("\n")
            return 1
        }
        return compile_multimodule_native_with_ir(
            main_path,
            wir.module,
            output_path,
            requested_target,
            requested_matrix,
            explicit_target,
            gpu_target,
            gpu_binary_format,
            gpu_strict_parity
        )
    }

    let target_spec = native_resolve_target(requested_target, requested_matrix, explicit_target)
    print("Native dispatch: requested=")
    print(target_spec.requested_target)
    print(" resolved=")
    print(target_spec.resolved_target)
    print(" matrix=")
    print(native_matrix_mode_string(target_spec.matrix_mode))
    print(" source=")
    print(native_target_source_string(target_spec.source_id))
    if str_len(target_spec.fallback_reason) > 0 {
        print(" fallback=")
        print(target_spec.fallback_reason)
    }
    if str_len(gpu_target) > 0 {
        print(" gpu_target=")
        print(gpu_target)
    }
    if str_len(gpu_binary_format) > 0 {
        print(" gpu_binary_format=")
        print(gpu_binary_format)
    }
    print(" gpu_strict_parity=")
    if gpu_strict_parity {
        print("true")
    } else {
        print("false")
    }
    print("\n")
    if cache_stats {
        println("[thinlink] start")
    }

    let main_prog = load_module_file(main_path)

    let render_fixture_fast = target_spec.arch_id == ARCH_X86_64() &&
        target_spec.os_id == OS_LINUX() &&
        starts_with(main_path, "examples/render/")
    if render_fixture_fast {
        print("native_advanced: streaming_direct\n")
        let render_result = compile_singlemodule_native_streaming_result_from_program(
            main_path,
            &main_prog,
            target_spec
        )
        if !render_result.ok {
            print("Native compile failed: ")
            print(render_result.error_msg)
            print("\n")
            return 1
        }
        let render_write_ok = write_file(output_path, render_result.bytes, render_result.len) == 0
        if !render_write_ok {
            print("Error: Failed to write native binary to ")
            print(output_path)
            print("\n")
            return 1
        }
        print("Written to ")
        print(output_path)
        print("\n")
        return 0
    }

    if target_spec.arch_id != ARCH_X86_64() || target_spec.os_id != OS_LINUX() || !program_has_imports(main_prog) {
        let stream_pair = compile_multimodule_native_maybe_streaming(main_path, target_spec)
        var fallback_result = native_compile_result_error(ERR_OK(), "")
        if stream_pair.0 != 0 {
            fallback_result = stream_pair.1
        } else {
            let ir_result = load_multimodule_ir(main_path)
            if !ir_result.ok {
                print("Multi-module IR failed: ")
                print(ir_result.error_msg)
                print("\n")
                return 1
            }
            fallback_result = compile_native(&ir_result.module, target_spec)
        }
        if !fallback_result.ok {
            let _ = thin_write_native_decision_trace_extended(
                multimodule_native_trace_output_path(),
                target_spec.requested_target,
                target_spec.resolved_target,
                native_matrix_mode_string(target_spec.matrix_mode),
                native_target_source_string(target_spec.source_id),
                target_spec.fallback_reason,
                "native",
                "legacy-fallback",
                1,
                0,
                thin_empty_cache_stats(),
                0,
                false,
                fallback_result.error_code
            )
            print("Native compilation failed: ")
            print(fallback_result.error_msg)
            print("\n")
            return 1
        }
        if !(write_file(output_path, fallback_result.bytes, fallback_result.len) == 0) {
            print("Error: Failed to write native binary to ")
            print(output_path)
            print("\n")
            return 1
        }
        let _ = thin_write_native_decision_trace_extended(
            multimodule_native_trace_output_path(),
            target_spec.requested_target,
            target_spec.resolved_target,
            native_matrix_mode_string(target_spec.matrix_mode),
            native_target_source_string(target_spec.source_id),
            target_spec.fallback_reason,
            "native",
            "legacy-fallback",
            1,
            0,
            thin_empty_cache_stats(),
            0,
            true,
            ERR_OK()
        )
        print("Native binary size: ")
        print_int(fallback_result.len)
        print(" bytes\n")
        print("Written to ")
        print(output_path)
        print("\n")
        return 0
    }

    var cache_stats_accum = thin_empty_cache_stats()
    let graph = thin_load_module_graph(main_path)
    if graph.had_error {
        let _ = thin_write_native_decision_trace_extended(
            multimodule_native_trace_output_path(),
            target_spec.requested_target,
            target_spec.resolved_target,
            native_matrix_mode_string(target_spec.matrix_mode),
            native_target_source_string(target_spec.source_id),
            target_spec.fallback_reason,
            "native",
            "thinlink-cas",
            0,
            0,
            cache_stats_accum,
            0,
            false,
            ERR_BACKEND_NOT_IMPLEMENTED()
        )
        print("Multi-module frontend failed: ")
        print(graph.error_msg)
        print("\n")
        return 1
    }
    if cache_stats {
        println("[thinlink] graph modules=" + io_trace_i64_string(graph.count))
    }

    let profile_pair = thin_load_profile_if_requested(use_profile, use_profile_path)
    let profile_loaded = profile_pair.0
    let profile = profile_pair.1
    let profile_hash = profile_pair.2

    var summaries: [ModuleSummary; 64] = [thin_empty_module_summary(); 64]
    var import_maps: [ThinImportMap; 64] = [thin_empty_import_map(); 64]
    var mi: i64 = 0
    while mi < graph.count {
        let summary_pair = thin_load_or_build_module_summary(
            graph,
            mi,
            target_spec,
            optimize,
            cache_dir,
            cache_mode,
            &! cache_stats_accum
        )
        if summary_pair.0 == 0 {
            let _ = thin_write_native_decision_trace_extended(
                multimodule_native_trace_output_path(),
                target_spec.requested_target,
                target_spec.resolved_target,
                native_matrix_mode_string(target_spec.matrix_mode),
                native_target_source_string(target_spec.source_id),
                target_spec.fallback_reason,
                "native",
                "thinlink-cas",
                graph.count,
                0,
                cache_stats_accum,
                0,
                false,
                ERR_BACKEND_NOT_IMPLEMENTED()
            )
            print("IR summary lowering failed: ")
            print(graph.nodes[mi as usize].file_path)
            print("\n")
            return 1
        }
        summaries[mi as usize] = summary_pair.1
        import_maps[mi as usize] = thin_collect_imports_from_items(
            load_module_file(graph.nodes[mi as usize].file_path).items,
            graph.registry,
            thin_empty_import_map()
        )
        mi = mi + 1
    }
    if cache_stats {
        println("[thinlink] summaries ready")
    }

    let combined_index = thin_build_combined_summary_index(summaries, graph.count)
    var units: [CompiledUnit; 64] = [thin_empty_compiled_unit(); 64]
    var total_imported_bodies: i64 = 0
    var total_inline_processed: i64 = 0
    var total_loop_tco_signal: i64 = 0

    mi = 0
    while mi < graph.count {
        let unit_pair = thin_build_compiled_unit(
            graph,
            summaries,
            mi,
            import_maps[mi as usize],
            combined_index.combined_digest,
            optimize,
            profile_loaded,
            profile,
            profile_hash,
            cache_dir,
            cache_mode,
            &! cache_stats_accum
        )
        if unit_pair.0 == 0 {
            let _ = thin_write_native_decision_trace_extended(
                multimodule_native_trace_output_path(),
                target_spec.requested_target,
                target_spec.resolved_target,
                native_matrix_mode_string(target_spec.matrix_mode),
                native_target_source_string(target_spec.source_id),
                target_spec.fallback_reason,
                "native",
                "thinlink-cas",
                graph.count,
                total_imported_bodies,
                cache_stats_accum,
                combined_index.combined_digest,
                false,
                ERR_BACKEND_NOT_IMPLEMENTED()
            )
            print("Thin-link unit build failed: ")
            print(graph.nodes[mi as usize].file_path)
            print("\n")
            return 1
        }
        units[mi as usize] = unit_pair.1
        total_imported_bodies = total_imported_bodies + unit_pair.5
        total_inline_processed = total_inline_processed + unit_pair.6
        total_loop_tco_signal = total_loop_tco_signal + unit_pair.7
        mi = mi + 1
    }
    if cache_stats {
        println("[thinlink] units ready imported=" + io_trace_i64_string(total_imported_bodies))
    }

    if optimize {
        print("[inline] pass complete: ")
        print_int(total_inline_processed)
        print(" functions processed\n")
        print("[opt] const_prop + dce applied to ")
        print_int(total_inline_processed)
        print(" functions\n")
        if total_loop_tco_signal > 0 {
            print("[loop] hoisted/trimmed signal=")
            print_int(total_loop_tco_signal)
            print("\n")
        }
    }

    var final_module = ir_empty_module()
    var emitted_owner_module: [i64; 256] = [-1; 256]
    var emitted_owner_slot: [i64; 256] = [-1; 256]
    var emitted_names: [Name; 256] = [ir_empty_name(); 256]
    var next_global_id: i64 = 0

    mi = 0
    while mi < graph.count && next_global_id < 256 {
        var li: i64 = 0
        while li < units[mi as usize].local_fn_count && next_global_id < 256 {
            units[mi as usize].global_ids[li as usize] = next_global_id
            emitted_owner_module[next_global_id as usize] = mi
            emitted_owner_slot[next_global_id as usize] = li
            emitted_names[next_global_id as usize] = thin_emit_public_name(mi, units[mi as usize].slot_names[li as usize])
            ir_fn_set(&! final_module, next_global_id as usize, thin_make_stub_from_func(
                thin_module_summary_lookup_local(summaries[mi as usize], units[mi as usize].slot_names[li as usize]).2,
                emitted_names[next_global_id as usize]
            ))
            next_global_id = next_global_id + 1
            li = li + 1
        }
        mi = mi + 1
    }

    mi = 0
    while mi < graph.count && next_global_id < 256 {
        var fi: i64 = units[mi as usize].local_fn_count
        while fi < units[mi as usize].fn_count && next_global_id < 256 {
            let func_name = units[mi as usize].slot_names[fi as usize]
            if units[mi as usize].slot_kinds[fi as usize] == 1 {
                let existing = thin_find_fn_slot(final_module, func_name)
                if existing >= 0 {
                    units[mi as usize].global_ids[fi as usize] = existing
                } else {
                    units[mi as usize].global_ids[fi as usize] = next_global_id
                    emitted_owner_module[next_global_id as usize] = mi
                    emitted_owner_slot[next_global_id as usize] = fi
                    emitted_names[next_global_id as usize] = func_name
                    ir_fn_set(&! final_module, next_global_id as usize, thin_make_stub_from_func(ir_empty_function(), func_name))
                    next_global_id = next_global_id + 1
                }
            } else if units[mi as usize].slot_kinds[fi as usize] == 2 {
                units[mi as usize].global_ids[fi as usize] = next_global_id
                emitted_owner_module[next_global_id as usize] = mi
                emitted_owner_slot[next_global_id as usize] = fi
                emitted_names[next_global_id as usize] = thin_emit_private_import_name(mi, func_name)
                ir_fn_set(&! final_module, next_global_id as usize, thin_make_stub_from_func(
                    ir_empty_function(),
                    emitted_names[next_global_id as usize]
                ))
                next_global_id = next_global_id + 1
            }
            fi = fi + 1
        }
        mi = mi + 1
    }
    final_module.fn_count = next_global_id
    if cache_stats {
        println("[thinlink] final plan functions=" + io_trace_i64_string(final_module.fn_count))
    }

    if next_global_id <= 0 {
        let _ = thin_write_native_decision_trace_extended(
            multimodule_native_trace_output_path(),
            target_spec.requested_target,
            target_spec.resolved_target,
            native_matrix_mode_string(target_spec.matrix_mode),
            native_target_source_string(target_spec.source_id),
            target_spec.fallback_reason,
            "native",
            "thinlink-cas",
            graph.count,
            total_imported_bodies,
            cache_stats_accum,
            combined_index.combined_digest,
            false,
            ERR_BACKEND_NOT_IMPLEMENTED()
        )
        print("Thin-link final plan is empty\n")
        return 1
    }

    var built_functions: [IrFunction; 256] = [ir_empty_function(); 256]
    var gi: i64 = 0
    while gi < final_module.fn_count {
        let owner_module = emitted_owner_module[gi as usize]
        let owner_slot = emitted_owner_slot[gi as usize]
        if owner_module < 0 || owner_slot < 0 {
            let _ = thin_write_native_decision_trace_extended(
                multimodule_native_trace_output_path(),
                target_spec.requested_target,
                target_spec.resolved_target,
                native_matrix_mode_string(target_spec.matrix_mode),
                native_target_source_string(target_spec.source_id),
                target_spec.fallback_reason,
                "native",
                "thinlink-cas",
                graph.count,
                total_imported_bodies,
                cache_stats_accum,
                combined_index.combined_digest,
                false,
                ERR_BACKEND_NOT_IMPLEMENTED()
            )
            print("Thin-link emitted source mapping failed\n")
            return 1
        }
        let remat_pair = thin_build_compiled_unit(
            graph,
            summaries,
            owner_module,
            import_maps[owner_module as usize],
            combined_index.combined_digest,
            optimize,
            profile_loaded,
            profile,
            profile_hash,
            cache_dir,
            cache_mode,
            &! cache_stats_accum
        )
        if remat_pair.0 == 0 || owner_slot >= remat_pair.2.fn_count {
            let _ = thin_write_native_decision_trace_extended(
                multimodule_native_trace_output_path(),
                target_spec.requested_target,
                target_spec.resolved_target,
                native_matrix_mode_string(target_spec.matrix_mode),
                native_target_source_string(target_spec.source_id),
                target_spec.fallback_reason,
                "native",
                "thinlink-cas",
                graph.count,
                total_imported_bodies,
                cache_stats_accum,
                combined_index.combined_digest,
                false,
                ERR_BACKEND_NOT_IMPLEMENTED()
            )
            print("Thin-link unit materialization failed\n")
            return 1
        }
        var func = ir_fn_get(&remat_pair.2, owner_slot as usize)
        func.name = emitted_names[gi as usize]

        var ii: i64 = 0
        while ii < func.instr_count {
            if (IR_A_OP[(ir_region_slot_r(func.region, (ii))) as usize] as IrOpcode) == IrOpcode::IrCall {
                var instr = ir_arena_load(ir_region_slot_r(func.region, (ii)))
                let mapped = thin_map_target_to_global(
                    owner_module,
                    import_maps[owner_module as usize],
                    units,
                    summaries,
                    instr.fn_id,
                    instr.name
                )
                if mapped.0 == 0 {
                    let _ = thin_write_native_decision_trace_extended(
                        multimodule_native_trace_output_path(),
                        target_spec.requested_target,
                        target_spec.resolved_target,
                        native_matrix_mode_string(target_spec.matrix_mode),
                        native_target_source_string(target_spec.source_id),
                        target_spec.fallback_reason,
                        "native",
                        "thinlink-cas",
                        graph.count,
                        total_imported_bodies,
                        cache_stats_accum,
                        combined_index.combined_digest,
                        false,
                        ERR_BACKEND_NOT_IMPLEMENTED()
                    )
                    print("Thin-link call mapping failed in ")
                    print(thin_name_to_string(func.name))
                    print("\n")
                    return 1
                }
                instr.fn_id = mapped.1
                ir_arena_store(ir_region_slot_w(func.region, (ii)), instr)
            }
            ii = ii + 1
        }

        if func.prof_counter_id >= 0 && final_module.prof_counter_count < 64 {
            let new_counter_id = final_module.prof_counter_count
            func = thin_remap_prof_counter(func, new_counter_id)
            final_module.prof_counters[new_counter_id as usize] = IrProfCounterInfo {
                fn_id: gi,
                fn_name: func.name,
                counter_id: new_counter_id,
            }
            final_module.prof_counter_count = new_counter_id + 1
        } else {
            func.prof_counter_id = -1
        }

        built_functions[gi as usize] = func
        ir_fn_set(&! final_module, gi as usize, thin_make_stub_from_func(func, func.name))
        gi = gi + 1
    }
    if cache_stats {
        println("[thinlink] calls remapped profs=" + io_trace_i64_string(final_module.prof_counter_count))
    }

    var link_digest = THIN_HASH_SEED()
    link_digest = thin_hash_mix(link_digest, combined_index.combined_digest)
    link_digest = thin_hash_mix(link_digest, if optimize { 1 } else { 0 })
    link_digest = thin_hash_mix(link_digest, if profile_loaded { profile_hash } else { 0 })
    gi = 0
    while gi < graph.count {
        link_digest = thin_hash_mix(link_digest, units[gi as usize].key_digest)
        gi = gi + 1
    }

    let link_cache_path = thin_cache_path(cache_dir, "link", link_digest, ".elf")
    var final_result = native_compile_result_error(ERR_OK(), "")
    if str_len(cache_dir) > 0 && thin_cache_mode_can_read(cache_mode) {
        let cached_link = thin_try_read_binary_cache(link_cache_path, &! cache_stats_accum)
        if cached_link.0 != 0 {
            cache_stats_accum.link_hits = cache_stats_accum.link_hits + 1
            final_result = native_compile_result_ok(cached_link.1, cached_link.2, FORMAT_ELF64())
        }
    }

    if !final_result.ok {
        cache_stats_accum.link_misses = cache_stats_accum.link_misses + 1
        if cache_stats {
            println("[thinlink] codegen start")
        }
        var nc = compiler_new()
        compile_module_streaming_begin_into(&!nc, &final_module)
        gi = 0
        while gi < final_module.fn_count {
            let lowered = native_v2_lower_function_to_machine(built_functions[gi as usize])
            let legal = native_v2_legalize_function(lowered)
            if legal.supported {
                compile_ir_function_v2_into(&!nc, &built_functions[gi as usize], &legal, gi)
            } else {
                nc = compile_ir_function(nc, built_functions[gi as usize], gi)
            }
            gi = gi + 1
        }
        compile_module_streaming_finish_into(&!nc, &final_module)
        let elf = finalize_compiled_elf(nc, 4194304)
        final_result = thin_native_compile_result_from_wide(elf.bytes, elf.len, FORMAT_ELF64())
        if str_len(cache_dir) > 0 && thin_cache_mode_can_write(cache_mode) {
            let _ = thin_try_write_binary_cache(link_cache_path, elf.bytes, elf.len, &! cache_stats_accum)
        }
    }

    if !final_result.ok {
        let _ = thin_write_native_decision_trace_extended(
            multimodule_native_trace_output_path(),
            target_spec.requested_target,
            target_spec.resolved_target,
            native_matrix_mode_string(target_spec.matrix_mode),
            native_target_source_string(target_spec.source_id),
            target_spec.fallback_reason,
            "native",
            "thinlink-cas",
            graph.count,
            total_imported_bodies,
            cache_stats_accum,
            link_digest,
            false,
            final_result.error_code
        )
        print("Native compilation failed: ")
        print(final_result.error_msg)
        print("\n")
        return 1
    }

    if !(write_file(output_path, final_result.bytes, final_result.len) == 0) {
        let _ = thin_write_native_decision_trace_extended(
            multimodule_native_trace_output_path(),
            target_spec.requested_target,
            target_spec.resolved_target,
            native_matrix_mode_string(target_spec.matrix_mode),
            native_target_source_string(target_spec.source_id),
            target_spec.fallback_reason,
            "native",
            "thinlink-cas",
            graph.count,
            total_imported_bodies,
            cache_stats_accum,
            link_digest,
            false,
            ERR_OK()
        )
        print("Error: Failed to write native binary to ")
        print(output_path)
        print("\n")
        return 1
    }

    let _ = thin_write_native_decision_trace_extended(
        multimodule_native_trace_output_path(),
        target_spec.requested_target,
        target_spec.resolved_target,
        native_matrix_mode_string(target_spec.matrix_mode),
        native_target_source_string(target_spec.source_id),
        target_spec.fallback_reason,
        "native",
        "thinlink-cas",
        graph.count,
        total_imported_bodies,
        cache_stats_accum,
        link_digest,
        true,
        ERR_OK()
    )

    print("Native binary size: ")
    print_int(final_result.len)
    print(" bytes\n")
    if cache_stats {
        println(
            "[cache] summary h/m=" + io_trace_i64_string(cache_stats_accum.summary_hits) + "/" + io_trace_i64_string(cache_stats_accum.summary_misses) +
            " body h/m=" + io_trace_i64_string(cache_stats_accum.body_hits) + "/" + io_trace_i64_string(cache_stats_accum.body_misses) +
            " object h/m=" + io_trace_i64_string(cache_stats_accum.object_hits) + "/" + io_trace_i64_string(cache_stats_accum.object_misses) +
            " link h/m=" + io_trace_i64_string(cache_stats_accum.link_hits) + "/" + io_trace_i64_string(cache_stats_accum.link_misses) +
            " bytes=" + io_trace_i64_string(cache_stats_accum.persistent_bytes) +
            " imported=" + io_trace_i64_string(total_imported_bodies)
        )
    }
    print("Written to ")
    print(output_path)
    print("\n")
    return 0
}

pub fn compile_multimodule_native_with_ir(
    main_path: string,
    preloaded_ir: IrModule,
    output_path: string,
    requested_target: string,
    requested_matrix: string,
    explicit_target: bool,
    gpu_target: string,
    gpu_binary_format: string,
    gpu_strict_parity: bool
) -> i32 with IO, Mut, Div, Panic, Alloc {
    if preloaded_ir.fn_count <= 0 {
        print("Error: IR module has no functions (ir_lowering_empty_module)\n")
        return 1
    }

    // WASM backend short-circuit — bypass native ELF path entirely
    if str_eq(requested_target, "wasm") {
        print("WASM dispatch: source=")
        print(main_path)
        print(" output=")
        print(output_path)
        print("\n")
        let wasm_result = wasm_lower_module(preloaded_ir)
        if wasm_result.error_count > 0 {
            print("WASM lowering failed: ")
            print_int(wasm_result.error_count)
            print(" error(s)\n")
            return 1
        }
        // Copy WasmBuf (262144 bytes) into 4MB staging buffer for io_write_native_binary
        var stage: [i8; 65536] = [0; 65536]
        var ci: i64 = 0
        while ci < wasm_result.buf.len && ci < 65536 {
            stage[ci as usize] = wasm_result.buf.data[ci as usize]
            ci = ci + 1
        }
        let write_ok = io_write_native_binary(output_path, stage, wasm_result.buf.len)
        if !write_ok {
            print("Error: Failed to write WASM binary to ")
            print(output_path)
            print("\n")
            return 1
        }
        print("WASM binary size: ")
        print_int(wasm_result.buf.len)
        print(" bytes\n")
        print("Written to ")
        print(output_path)
        print("\n")
        return 0
    }

    let target_spec = native_resolve_target(requested_target, requested_matrix, explicit_target)
    print("Native dispatch: requested=")
    print(target_spec.requested_target)
    print(" resolved=")
    print(target_spec.resolved_target)
    print(" matrix=")
    print(native_matrix_mode_string(target_spec.matrix_mode))
    print(" source=")
    print(native_target_source_string(target_spec.source_id))
    if str_len(target_spec.fallback_reason) > 0 {
        print(" fallback=")
        print(target_spec.fallback_reason)
    }
    if str_len(gpu_target) > 0 {
        print(" gpu_target=")
        print(gpu_target)
    }
    if str_len(gpu_binary_format) > 0 {
        print(" gpu_binary_format=")
        print(gpu_binary_format)
    }
    print(" gpu_strict_parity=")
    if gpu_strict_parity {
        print("true")
    } else {
        print("false")
    }
    print("\n")

    let native_result = compile_native(&preloaded_ir, target_spec)
    if !native_result.ok {
        let trace_ok = io_write_native_decision_trace(
            multimodule_native_trace_output_path(),
            target_spec.requested_target,
            target_spec.resolved_target,
            native_matrix_mode_string(target_spec.matrix_mode),
            native_target_source_string(target_spec.source_id),
            target_spec.fallback_reason,
            "native",
            false,
            native_result.error_code
        )
        if !trace_ok {
            print("Error: Failed to write native decision trace to ")
            print(multimodule_native_trace_output_path())
            print("\n")
            return 1
        }
        print("Native compilation failed: ")
        print(native_result.error_msg)
        print("\n")
        return 1
    }

    print("Native binary size: ")
    print_int(native_result.len)
    print(" bytes\n")

    let write_ok = write_file(output_path, native_result.bytes, native_result.len) == 0
    if !write_ok {
        let trace_ok = io_write_native_decision_trace(
            multimodule_native_trace_output_path(),
            target_spec.requested_target,
            target_spec.resolved_target,
            native_matrix_mode_string(target_spec.matrix_mode),
            native_target_source_string(target_spec.source_id),
            target_spec.fallback_reason,
            "native",
            false,
            ERR_OK()
        )
        if !trace_ok {
            print("Error: Failed to write native decision trace to ")
            print(multimodule_native_trace_output_path())
            print("\n")
            return 1
        }
        print("Error: Failed to write native binary to ")
        print(output_path)
        print("\n")
        return 1
    }

    let trace_ok = io_write_native_decision_trace(
        multimodule_native_trace_output_path(),
        target_spec.requested_target,
        target_spec.resolved_target,
        native_matrix_mode_string(target_spec.matrix_mode),
        native_target_source_string(target_spec.source_id),
        target_spec.fallback_reason,
        "native",
        true,
        ERR_OK()
    )
    if !trace_ok {
        print("Error: Failed to write native decision trace to ")
        print(multimodule_native_trace_output_path())
        print("\n")
        return 1
    }

    print("Written to ")
    print(output_path)
    print("\n")
    return 0
}

pub fn compile_multimodule_native(
    main_path: string,
    output_path: string,
    requested_target: string,
    requested_matrix: string,
    explicit_target: bool,
    gpu_target: string,
    gpu_binary_format: string,
    gpu_strict_parity: bool
) -> i32 with IO, Mut, Div, Panic, Alloc {
    let main_prog = load_module_file(main_path)
    let target_spec = native_resolve_target(requested_target, requested_matrix, explicit_target)
    if !str_eq(requested_target, "wasm") &&
       target_spec.arch_id == ARCH_X86_64() &&
       target_spec.os_id == OS_LINUX() &&
       program_has_imports(main_prog) {
        return compile_multimodule_native_advanced(
            main_path,
            output_path,
            requested_target,
            requested_matrix,
            explicit_target,
            gpu_target,
            gpu_binary_format,
            gpu_strict_parity,
            false,
            false,
            "",
            "",
            "off",
            false
        )
    }

    // WASM backend short-circuit — bypass native ELF path entirely
    if str_eq(requested_target, "wasm") {
        let wir = load_multimodule_ir(main_path)
        if !wir.ok {
            print("Multi-module IR failed: ")
            print(wir.error_msg)
            print("\n")
            return 1
        }
        return compile_multimodule_native_with_ir(
            main_path,
            wir.module,
            output_path,
            requested_target,
            requested_matrix,
            explicit_target,
            gpu_target,
            gpu_binary_format,
            gpu_strict_parity
        )
    }

    print("Native dispatch: requested=")
    print(target_spec.requested_target)
    print(" resolved=")
    print(target_spec.resolved_target)
    print(" matrix=")
    print(native_matrix_mode_string(target_spec.matrix_mode))
    print(" source=")
    print(native_target_source_string(target_spec.source_id))
    if str_len(target_spec.fallback_reason) > 0 {
        print(" fallback=")
        print(target_spec.fallback_reason)
    }
    if str_len(gpu_target) > 0 {
        print(" gpu_target=")
        print(gpu_target)
    }
    if str_len(gpu_binary_format) > 0 {
        print(" gpu_binary_format=")
        print(gpu_binary_format)
    }
    print(" gpu_strict_parity=")
    if gpu_strict_parity {
        print("true")
    } else {
        print("false")
    }
    print("\n")

    var native_result = native_compile_result_error(ERR_OK(), "")
    let stream_pair = compile_multimodule_native_maybe_streaming(main_path, target_spec)
    if stream_pair.0 != 0 {
        native_result = stream_pair.1
    } else {
        let ir_result = load_multimodule_ir(main_path)
        if !ir_result.ok {
            print("Multi-module IR failed: ")
            print(ir_result.error_msg)
            print("\n")
            let trace_ok = io_write_native_decision_trace(
                multimodule_native_trace_output_path(),
                target_spec.requested_target,
                target_spec.resolved_target,
                native_matrix_mode_string(target_spec.matrix_mode),
                native_target_source_string(target_spec.source_id),
                target_spec.fallback_reason,
                "native",
                false,
                ERR_OK()
            )
            if !trace_ok {
                print("Error: Failed to write native decision trace to ")
                print(multimodule_native_trace_output_path())
                print("\n")
                return 1
            }
            return 1
        }
        native_result = compile_native(&ir_result.module, target_spec)
    }

    if !native_result.ok {
        let trace_ok = io_write_native_decision_trace(
            multimodule_native_trace_output_path(),
            target_spec.requested_target,
            target_spec.resolved_target,
            native_matrix_mode_string(target_spec.matrix_mode),
            native_target_source_string(target_spec.source_id),
            target_spec.fallback_reason,
            "native",
            false,
            native_result.error_code
        )
        if !trace_ok {
            print("Error: Failed to write native decision trace to ")
            print(multimodule_native_trace_output_path())
            print("\n")
            return 1
        }
        print("Native compilation failed: ")
        print(native_result.error_msg)
        print("\n")
        return 1
    }

    print("Native binary size: ")
    print_int(native_result.len)
    print(" bytes\n")

    let write_ok = write_file(output_path, native_result.bytes, native_result.len) == 0
    if !write_ok {
        let trace_ok = io_write_native_decision_trace(
            multimodule_native_trace_output_path(),
            target_spec.requested_target,
            target_spec.resolved_target,
            native_matrix_mode_string(target_spec.matrix_mode),
            native_target_source_string(target_spec.source_id),
            target_spec.fallback_reason,
            "native",
            false,
            ERR_OK()
        )
        if !trace_ok {
            print("Error: Failed to write native decision trace to ")
            print(multimodule_native_trace_output_path())
            print("\n")
            return 1
        }
        print("Error: Failed to write native binary to ")
        print(output_path)
        print("\n")
        return 1
    }

    let trace_ok = io_write_native_decision_trace(
        multimodule_native_trace_output_path(),
        target_spec.requested_target,
        target_spec.resolved_target,
        native_matrix_mode_string(target_spec.matrix_mode),
        native_target_source_string(target_spec.source_id),
        target_spec.fallback_reason,
        "native",
        true,
        ERR_OK()
    )
    if !trace_ok {
        print("Error: Failed to write native decision trace to ")
        print(multimodule_native_trace_output_path())
        print("\n")
        return 1
    }

    print("Written to ")
    print(output_path)
    print("\n")
    return 0
}

// ============================================================
// Result types
// ============================================================

struct BytecodeResult {
    ok: bool,
    bytecode: [i8; 131072],
    bytecode_len: i64,
    error_msg: string,
}

fn bytecode_result_ok(bytecode: [i8; 131072], len: i64) -> BytecodeResult {
    BytecodeResult {
        ok: true,
        bytecode: bytecode,
        bytecode_len: len,
        error_msg: "",
    }
}

fn bytecode_result_error(msg: string) -> BytecodeResult {
    BytecodeResult {
        ok: false,
        bytecode: [0; 131072],
