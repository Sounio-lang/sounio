use check::mod::{check_ontology_side_table_cache_same_checker_kernel_subclass_verdict_v1_probe}
use lexer::mod::{lex_file_parse_items}
use parser::parser::{parser_last_error_count}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    print("k2_check_mod_same_checker_ontology_cache_kernel_classifier_probe=start\n")
    let argc = arg_count()
    if argc < 1 {
        print("usage: k2_check_mod_same_checker_ontology_cache_kernel_classifier_probe <cache-consumer-source>\n")
        return 2
    }

    let source_path = get_arg(0)
    print("k2_check_mod_same_checker_ontology_cache_kernel_classifier_probe=parse_enter\n")
    let items = lex_file_parse_items(source_path)
    print("k2_check_mod_same_checker_ontology_cache_kernel_classifier_probe=parse_ok\n")
    if parser_last_error_count() > 0 {
        print("k2_check_mod_same_checker_ontology_cache_kernel_classifier_probe=parse_error\n")
        return 2
    }

    print("k2_check_mod_same_checker_ontology_cache_kernel_classifier_probe=sourcecheck_enter\n")
    let verdict = check_ontology_side_table_cache_same_checker_kernel_subclass_verdict_v1_probe(items, source_path, 73211009, 138875005)
    print("k2_check_mod_same_checker_ontology_cache_kernel_classifier_probe=verdict=")
    print_int(verdict)
    print("\n")
    if verdict == 0 {
        print("k2_check_mod_same_checker_ontology_cache_kernel_classifier_probe=ok\n")
        return 0
    }
    print("k2_check_mod_same_checker_ontology_cache_kernel_classifier_probe=rejected\n")
    1
}
