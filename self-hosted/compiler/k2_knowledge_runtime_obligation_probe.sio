use lexer::mod::{lex_file_parse_items}
use parser::parser::{parser_last_error_count}
use check::knowledge_context::{knowledge_context_validate_items, knowledge_context_count_runtime_obligations_items}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    var path = "tests/frontend/knowledge_static_value_dynamic_gap.sio"
    if argc >= 1 {
        path = get_arg(0)
    }

    let items = lex_file_parse_items(path)
    if parser_last_error_count() > 0 {
        print("parse_errors=")
        print_int(parser_last_error_count())
        print("\n")
        return 2
    }

    let verdict = knowledge_context_validate_items(items)
    print("knowledge_runtime_obligation_verdict=")
    print_int(verdict)
    print("\n")

    let count = knowledge_context_count_runtime_obligations_items(items)
    print("knowledge_runtime_obligation_count=")
    print_int(count)
    print("\n")
    return 0
}
