// Probe: verify wasm::types can be imported quickly by the JIT
// (was: use wasm::mod::{WASM_TYPE_I32} — caused 35s stack overflow)
// Speed target: < 5s  (wasm::types is ~50L constants-only module)
use wasm::types::*

fn main() with IO {
    // The diagnostic goal is fast type-checking, not constant value verification.
    // JIT has a pre-existing issue with module-level let constants in expressions.
    // Importing wasm::types::* here exercises the split module's import path.
    println("jit_wasm_mod_const_ok")
}
