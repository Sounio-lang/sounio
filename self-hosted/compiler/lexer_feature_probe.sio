use lexer::{lex_buffer, LexerState, TokenKind}

struct ProbeSource {
    data: [i8; 1048576],
    len: i64,
}

fn src_from_string(input: string) -> ProbeSource with Mut, Panic, Div {
    var out: [i8; 1048576] = [0; 1048576]
    var i: i64 = 0
    let n = str_len(input)
    while i < n {
        out[i as usize] = str_char_at(input, i) as i8
        i = i + 1
    }
    ProbeSource { data: out, len: n }
}

fn run_legacy_lex(input: string) -> LexerState with Mut, Panic, Div {
    let src = src_from_string(input)
    lex_buffer(src.data, src.len, 0)
}

fn has_kind(state: LexerState, kind: TokenKind) -> bool {
    var i: i64 = 0
    while i < state.token_count {
        if state.tokens[i as usize].kind == kind {
            return true
        }
        i = i + 1
    }
    false
}

fn check_numeric_literals() -> i64 with Mut, Panic, Div {
    let state = run_legacy_lex("0xFF 0b101 0o17 3.14e2 42")
    if !has_kind(state, TokenKind::HexLit) { return 11 }
    if !has_kind(state, TokenKind::BinLit) { return 12 }
    if !has_kind(state, TokenKind::OctLit) { return 13 }
    if !has_kind(state, TokenKind::FloatLit) { return 14 }
    if !has_kind(state, TokenKind::IntLit) { return 15 }
    0
}

fn check_operator_surface() -> i64 with Mut, Panic, Div {
    let state = run_legacy_lex("+- .. ..= ... |= <<= &! ~ :: ==")
    if !has_kind(state, TokenKind::PlusMinus) { return 21 }
    if !has_kind(state, TokenKind::DotDot) { return 22 }
    if !has_kind(state, TokenKind::DotDotEq) { return 23 }
    if !has_kind(state, TokenKind::DotDotDot) { return 24 }
    if !has_kind(state, TokenKind::PipeEq) { return 25 }
    if !has_kind(state, TokenKind::ShlEq) { return 26 }
    if !has_kind(state, TokenKind::AmpBang) { return 27 }
    if !has_kind(state, TokenKind::Tilde) { return 28 }
    if !has_kind(state, TokenKind::ColonColon) { return 29 }
    if !has_kind(state, TokenKind::EqEq) { return 30 }
    0
}

fn check_comments_epistemic_and_char() -> i64 with Mut, Panic, Div {
    let state = run_legacy_lex("/// doc\\nuncertain belief posterior 'x' /* /* inner */ */ 42")
    if !has_kind(state, TokenKind::DocOuter) { return 31 }
    if !has_kind(state, TokenKind::Uncertain) { return 32 }
    if !has_kind(state, TokenKind::Belief) { return 33 }
    if !has_kind(state, TokenKind::Posterior) { return 34 }
    if !has_kind(state, TokenKind::CharLit) { return 35 }
    if !has_kind(state, TokenKind::IntLit) { return 36 }
    if state.error_count != 0 { return 37 }
    0
}

fn check_unterminated_string_error() -> i64 with Mut, Panic, Div {
    let state = run_legacy_lex("\"hi")
    if state.error_count <= 0 { return 41 }
    0
}

fn main() -> i64 with IO, Mut, Panic, Div {
    let c1 = check_numeric_literals()
    if c1 != 0 { return c1 }

    let c2 = check_operator_surface()
    if c2 != 0 { return c2 }

    let c3 = check_comments_epistemic_and_char()
    if c3 != 0 { return c3 }

    let c4 = check_unterminated_string_error()
    if c4 != 0 { return c4 }

    0
}
