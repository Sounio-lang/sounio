use check::check::{
    checker_ontology_side_table_cache_kernel_disjoint_verdict,
    checker_ontology_side_table_cache_kernel_subclass_verdict,
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    print("k2_check_import_ontology_cache_kernel_probe=start\n")
    let argc = arg_count()
    if argc < 1 {
        print("usage: k2_check_import_ontology_cache_kernel_probe <cache-consumer-source>\n")
        return 2
    }

    let source_path = get_arg(0)
    print("k2_check_import_ontology_cache_kernel_probe=live_direct_enter\n")
    let snomed_ok = checker_ontology_side_table_cache_kernel_subclass_verdict(source_path, 73211009, 138875005)
    let snomed_reject = checker_ontology_side_table_cache_kernel_subclass_verdict(source_path, 138875005, 73211009)
    let part_subclass_ok = checker_ontology_side_table_cache_kernel_subclass_verdict(source_path, 4, 2)
    let part_subclass_reject = checker_ontology_side_table_cache_kernel_subclass_verdict(source_path, 2, 4)
    let part_disjoint_ok = checker_ontology_side_table_cache_kernel_disjoint_verdict(source_path, 3, 12)
    let part_disjoint_reject = checker_ontology_side_table_cache_kernel_disjoint_verdict(source_path, 2, 4)

    print("live_kernel_cache_verdict_snomed_73211009_subclass_138875005=")
    print_int(snomed_ok)
    print("\n")
    print("live_kernel_cache_verdict_snomed_138875005_subclass_73211009=")
    print_int(snomed_reject)
    print("\n")
    print("live_kernel_cache_verdict_part_4_subclass_2=")
    print_int(part_subclass_ok)
    print("\n")
    print("live_kernel_cache_verdict_part_2_subclass_4=")
    print_int(part_subclass_reject)
    print("\n")
    print("live_kernel_cache_verdict_part_3_disjoint_12=")
    print_int(part_disjoint_ok)
    print("\n")
    print("live_kernel_cache_verdict_part_2_disjoint_4=")
    print_int(part_disjoint_reject)
    print("\n")

    print("k2_check_import_ontology_cache_kernel_probe=ok\n")
    0
}
