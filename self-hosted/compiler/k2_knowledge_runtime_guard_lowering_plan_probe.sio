use knowledge_runtime_guard_lowering_plan::{knowledge_runtime_guard_lowering_plan_build}
use parser::ast::{Name}

fn print_bool_digit(value: bool) with IO {
    if value {
        print("1")
    } else {
        print("0")
    }
}

fn print_probe_name(name: Name) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < name.len {
        print_char(name.buf[i as usize] as i64)
        i = i + 1
    }
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    var path = "tests/frontend/knowledge_runtime_guard_directive_positive.sio"
    if argc >= 1 {
        path = get_arg(0)
    }

    let plan = knowledge_runtime_guard_lowering_plan_build(path)
    print("knowledge_runtime_guard_lowering_plan_directive_found=")
    print_bool_digit(plan.directive_found)
    print(" directive_count=")
    print_int(plan.directive_count)
    print(" directive_malformed=")
    print_bool_digit(plan.directive_malformed)
    print(" parse_errors=")
    print_int(plan.parse_errors)
    print(" semantic_verdict=")
    print_int(plan.semantic_verdict)
    print(" runtime_obligation_count=")
    print_int(plan.runtime_obligation_count)
    print(" needs_runtime_guards=")
    print_bool_digit(plan.needs_runtime_guards)
    print(" pre_native_guard_expansion_requested=")
    print_bool_digit(plan.pre_native_guard_expansion_requested)
    print(" pre_native_guard_plan_ready=")
    print_bool_digit(plan.pre_native_guard_plan_ready)
    print(" native_lowering_ready=")
    print_bool_digit(plan.native_lowering_ready)
    print(" backend_guard_count=")
    print_int(plan.backend_guard_count)
    print(" first_obligation_found=")
    print_bool_digit(plan.first_obligation_found)
    print(" first_obligation_site_kind=")
    print_int(plan.first_obligation_site_kind)
    print(" first_obligation_type=")
    print_probe_name(plan.first_obligation_type_name)
    print(" first_obligation_field=")
    print_probe_name(plan.first_obligation_field_name)
    print(" first_obligation_constraint_kind=")
    print_int(plan.first_obligation_constraint_kind)
    print(" first_obligation_value_kind=")
    print_int(plan.first_obligation_value_kind)
    print(" first_obligation_int_value=")
    print_int(plan.first_obligation_int_value)
    print(" first_obligation_float_value=")
    print_f64(plan.first_obligation_float_value)
    print(" first_obligation_unit=")
    print_probe_name(plan.first_obligation_unit_name)
    print(" first_obligation_dynamic_expr_kind=")
    print_int(plan.first_obligation_dynamic_expr_kind)
    print(" first_backend_guard_row_ready=")
    print_bool_digit(plan.first_backend_guard_row_ready)
    print(" first_backend_guard_compare_opcode=")
    print_int(plan.first_backend_guard_compare_opcode)
    print(" first_backend_guard_threshold_kind=")
    print_int(plan.first_backend_guard_threshold_kind)
    print(" first_backend_guard_trap_exit_code=")
    print_int(plan.first_backend_guard_trap_exit_code)
    print(" second_obligation_found=")
    print_bool_digit(plan.second_obligation_found)
    print(" second_obligation_site_kind=")
    print_int(plan.second_obligation_site_kind)
    print(" second_obligation_type=")
    print_probe_name(plan.second_obligation_type_name)
    print(" second_obligation_field=")
    print_probe_name(plan.second_obligation_field_name)
    print(" second_obligation_constraint_kind=")
    print_int(plan.second_obligation_constraint_kind)
    print(" second_obligation_value_kind=")
    print_int(plan.second_obligation_value_kind)
    print(" second_obligation_int_value=")
    print_int(plan.second_obligation_int_value)
    print(" second_obligation_float_value=")
    print_f64(plan.second_obligation_float_value)
    print(" second_obligation_unit=")
    print_probe_name(plan.second_obligation_unit_name)
    print(" second_obligation_dynamic_expr_kind=")
    print_int(plan.second_obligation_dynamic_expr_kind)
    print(" second_backend_guard_row_ready=")
    print_bool_digit(plan.second_backend_guard_row_ready)
    print(" second_backend_guard_compare_opcode=")
    print_int(plan.second_backend_guard_compare_opcode)
    print(" second_backend_guard_threshold_kind=")
    print_int(plan.second_backend_guard_threshold_kind)
    print(" second_backend_guard_trap_exit_code=")
    print_int(plan.second_backend_guard_trap_exit_code)
    print(" staged_backend_guard_row_count=")
    print_int(plan.staged_backend_guard_row_count)
    print("\n")

    if plan.directive_malformed || plan.parse_errors > 0 || plan.semantic_verdict != 0 {
        return 1
    }
    0
}
