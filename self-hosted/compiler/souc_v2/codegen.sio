            ci = ci + 1
        }
        // Emit jmp over closure body
        em(0xe9)
        let jmp_patch = CL
        em32(0)
        // Emit closure function body
        let cl_start = CL
        // Prologue: push rbp; mov rbp, rsp; sub rsp, 4096
