    // Closure function receives hidden first param (env_ptr) in rdi.
    // User args shift to rsi, rdx, rcx, r8, r9 (max 5 user args).
    if k == 45 {
        EP = EP + 1  // skip opening |
        // Save outer function state
        let save_vc = VAR_COUNT
        let save_ns2 = NEXT_SLOT
        let save_ld = LOOP_DEPTH
        let save_bc = BREAK_COUNT
        var svi: i64 = 0
        while svi < save_vc {
            CL_SAVE_NS[svi as usize] = VAR_NS[svi as usize]
            CL_SAVE_NE[svi as usize] = VAR_NE[svi as usize]
            CL_SAVE_SL[svi as usize] = VAR_SLOT[svi as usize]
            CL_SAVE_AL[svi as usize] = VAR_ALEN[svi as usize]
            CL_SAVE_ES[svi as usize] = VAR_ESIZ[svi as usize]
            CL_SAVE_F64[svi as usize] = VAR_IS_F64[svi as usize]
            CL_SAVE_ISCL[svi as usize] = VAR_IS_CLOSURE[svi as usize]
            svi = svi + 1
        }
        // Reset state for closure body
        VAR_COUNT = 0
        NEXT_SLOT = 2  // slot 1 reserved for env_ptr (hidden rdi param)
        LOOP_DEPTH = 0
        BREAK_COUNT = 0
        CL_CAP_COUNT = 0
        // Parse closure parameters (between | ... |)
        // User params get slots 2, 3, ... (registers rsi, rdx, rcx, r8, r9)
        while TK[EP as usize] != 45 && TK[EP as usize] != 0 {
            if TK[EP as usize] == 3 {
                let pns = TS[EP as usize]
                let pne = TE[EP as usize]
                var_add(pns, pne)
                EP = EP + 1
                if TK[EP as usize] == 43 { EP = EP + 1; EP = EP + 1 }
            }
            if TK[EP as usize] == 28 { EP = EP + 1 }
