            if bl == 7 && bh == 14456679815 { EP = EP + 1; compile_or(); em(0x50); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or(); em(0x59); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8); em(0xf2); em(0x0f); em(0x58); em(0xc1); em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 1; return }
            if bl == 7 && bh == 121920845326 { EP = EP + 1; compile_or(); em(0x50); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or(); em(0x59); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8); em(0xf2); em(0x0f); em(0x5c); em(0xc1); em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 1; return }
            if bl == 7 && bh == 47722337034 { EP = EP + 1; compile_or(); em(0x50); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or(); em(0x59); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8); em(0xf2); em(0x0f); em(0x59); em(0xc1); em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 1; return }
            if bl == 7 && bh == 17692084031 { EP = EP + 1; compile_or(); em(0x50); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or(); em(0x59); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8); em(0xf2); em(0x0f); em(0x5e); em(0xc1); em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 1; return }
            // f64_neg: 7 chars
            if bl == 7 && bh == 92612984778 { EP = EP + 1; compile_or(); em(0x48); em(0x0f); em(0xba); em(0xf8); em(63); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 1; return }
            // f64_lt/le/eq/gt/ge: 6 chars
            if bl == 6 && bh == 8815569132 { EP = EP + 1; compile_or(); em(0x50); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or(); em(0x59); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8); em(0x66); em(0x0f); em(0x2e); em(0xc1); em(0x0f); em(0x92); em(0xc0); em(0x48); em(0x0f); em(0xb6); em(0xc0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 0; return }
            if bl == 6 && bh == 9100788655 { EP = EP + 1; compile_or(); em(0x50); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or(); em(0x59); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8); em(0x66); em(0x0f); em(0x2e); em(0xc1); em(0x0f); em(0x96); em(0xc0); em(0x48); em(0x0f); em(0xb6); em(0xc0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 0; return }
            if bl == 6 && bh == 129361299966 { EP = EP + 1; compile_or(); em(0x50); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or(); em(0x59); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8); em(0x66); em(0x0f); em(0x2e); em(0xc1); em(0x0f); em(0x94); em(0xc0); em(0x48); em(0x0f); em(0xb6); em(0xc0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 0; return }
            if bl == 6 && bh == 17440780175 { EP = EP + 1; compile_or(); em(0x50); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or(); em(0x59); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8); em(0x66); em(0x0f); em(0x2e); em(0xc1); em(0x0f); em(0x97); em(0xc0); em(0x48); em(0x0f); em(0xb6); em(0xc0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 0; return }
            if bl == 6 && bh == 17155560652 { EP = EP + 1; compile_or(); em(0x50); if TK[EP as usize] == 28 { EP = EP + 1 }; compile_or(); em(0x59); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8); em(0x66); em(0x0f); em(0x2e); em(0xc1); em(0x0f); em(0x93); em(0xc0); em(0x48); em(0x0f); em(0xb6); em(0xc0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 0; return }
            // f64_to_i64 / i64_to_f64: 10 chars
            if bl == 10 && bh == 5531541079 { EP = EP + 1; compile_or(); em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc0); em(0xf2); em(0x48); em(0x0f); em(0x2c); em(0xc0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 0; return }
            if bl == 10 && bh == 86668110853 { EP = EP + 1; compile_or(); em(0xf2); em(0x48); em(0x0f); em(0x2a); em(0xc0); em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0); if TK[EP as usize] == 7 { EP = EP + 1 }; EXPR_IS_F64 = 1; return }
            // User function call
            let fi = fn_find(ns, ne)
            let call_vslot = var_find(ns, ne)
            EP = EP + 1
            var argc: i64 = 0
            while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
                compile_or()
                em(0x50)
                argc = argc + 1
                if TK[EP as usize] == 28 { EP = EP + 1 }
            }
            if TK[EP as usize] == 7 { EP = EP + 1 }
            if fi >= 0 {
                // Effects check: callee effects must be subset of caller effects
                let callee_eff = FN_EFFECTS[fi as usize]
                let caller_eff = FN_EFFECTS[CURRENT_FN as usize]
                if bitset_is_subset(callee_eff, caller_eff) == false {
                    print("warning: effect violation: fn#")
                    print_int(fi)
                    print("(eff=")
                    print_int(callee_eff)
                    print(") called from fn#")
                    print_int(CURRENT_FN)
                    print("(eff=")
                    print_int(caller_eff)
                    print(")\n")
                }
                // Direct call: pop args into rdi,rsi,rdx,rcx,r8,r9
                if argc >= 6 { em(0x41); em(0x59) }
                if argc >= 5 { em(0x41); em(0x58) }
                if argc >= 4 { em(0x59) }
                if argc >= 3 { em(0x5a) }
                if argc >= 2 { em(0x5e) }
                if argc >= 1 { em(0x5f) }
                em(0xe8)
                PATCH_OFF[PATCH_COUNT as usize] = CL
                PATCH_FN[PATCH_COUNT as usize] = fi
                PATCH_COUNT = PATCH_COUNT + 1
                em32(0)
            } else {
                // Indirect call through variable — uniform closure convention:
                // All callable values are closure struct pointers [fn_ptr, cap_0, ...]
                // Pop user args into shifted regs (rsi,rdx,rcx,r8,r9), max 5 user args
                // rdi = closure struct ptr (env), fn_ptr loaded from [env]
                if argc >= 5 { em(0x41); em(0x59) }  // pop r9
                if argc >= 4 { em(0x41); em(0x58) }  // pop r8
                if argc >= 3 { em(0x59) }              // pop rcx
                if argc >= 2 { em(0x5a) }              // pop rdx
                if argc >= 1 { em(0x5e) }              // pop rsi
                if call_vslot >= 0 {
                    emit_load_var(call_vslot)           // rax = closure struct ptr
                    em(0x48); em(0x89); em(0xc7)        // mov rdi, rax (env_ptr)
                    em(0x48); em(0x8b); em(0x00)        // mov rax, [rax] (fn_ptr)
                    em(0xff); em(0xd0)                  // call rax
                } else {
                    print("warning: unknown function at line ")
                    print_int(TL[EP as usize])
                    print("\n")
                    em(0x31); em(0xc0)  // unknown fn
                }
            }
            EXPR_IS_F64 = 0
            return
        }
        // Struct literal: StructName { field: val, ... }
        if TK[EP as usize] == 8 {
            let sh = gl_name_hash(ns, ne)
            let si = st_find(sh)
            if si >= 0 {
                EP = EP + 1  // skip {
                let fc = ST[(si * 66 + 1) as usize]
                // Allocate fc consecutive stack slots for struct fields
                let base_slot = NEXT_SLOT
                NEXT_SLOT = NEXT_SLOT + fc
                // Parse field: value pairs
                while TK[EP as usize] != 9 && TK[EP as usize] != 0 {
                    if TK[EP as usize] == 3 {
                        let fns = TS[EP as usize]
                        let fne = TE[EP as usize]
                        let fh = gl_name_hash(fns, fne)
                        EP = EP + 1  // skip field name
                        if TK[EP as usize] == 43 { EP = EP + 1 }  // skip :
                        compile_or()  // value in rax
                        let foff = st_field_offset(si, fh)
                        if foff >= 0 {
                            emit_store_var(base_slot + fc - 1 - foff / 8)
                        }
                    }
                    if TK[EP as usize] == 28 { EP = EP + 1 }  // skip comma
                }
                if TK[EP as usize] == 9 { EP = EP + 1 }  // skip }
                // lea rax, [rbp - (base_slot+fc-1)*8] — pointer to struct data (lowest addr)
                em(0x48); em(0x8d); em(0x85)
                em32(0 - (base_slot + fc - 1) * 8)
                EXPR_IS_F64 = 0
                // Track if this struct is linear
                LAST_EXPR_IS_LINEAR = ST_LINEAR[si as usize]
                return
            }
        }
        // Array subscript: IDENT[expr]
        if TK[EP as usize] == 41 {
            EP = EP + 1  // skip [
            compile_or()  // index in rax
            if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }  // skip 'as usize'
            if TK[EP as usize] == 42 { EP = EP + 1 }  // skip ]
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                let base = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                let esz = GL[(gi * 4 + 2) as usize]
                if esz == 8 {
                    // mov rcx, rax; mov rax, base; mov rax, [rax + rcx*8]
                    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (index)
                    em(0x48); em(0xb8); em64(base)  // mov rax, base
                    em(0x48); em(0x8b); em(0x04); em(0xc8)  // mov rax, [rax + rcx*8]
                } else {
                    // i8 array: movsx rax, byte [rax + rcx]
                    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax
                    em(0x48); em(0xb8); em64(base)  // mov rax, base
                    em(0x48); em(0x0f); em(0xbe); em(0x04); em(0x08)  // movsx rax, byte [rax + rcx]
                }
            } else {
                // Local pointer subscript: ptr[idx] → load ptr from stack, add index
                let slot = var_find(ns, ne)
                if slot >= 0 {
                    let lalen = var_find_alen(ns, ne)
                    let lesiz = var_find_esiz(ns, ne)
                    em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (index)
                    emit_load_var(slot)  // load ptr into rax
                    if lalen > 0 && lesiz == 8 {
                        em(0x48); em(0x8b); em(0x04); em(0xc8)  // mov rax, [rax + rcx*8]
                    } else if lalen > 0 && lesiz == 1 {
                        em(0x48); em(0x0f); em(0xbe); em(0x04); em(0x08)  // movsx rax, byte [rax + rcx]
                    } else {
                        // Non-array local pointer (e.g. read_file result): byte access
                        em(0x48); em(0x0f); em(0xbe); em(0x04); em(0x08)  // movsx rax, byte [rax + rcx]
                    }
                }
            }
            EXPR_IS_F64 = 0
            return
        }
        // Variable load (local first, then global)
        let slot = var_find(ns, ne)
        if slot >= 0 {
            emit_load_var(slot)
            EXPR_IS_F64 = var_find_is_f64(ns, ne)
            var_mark_used(ns, ne)
        }
        else {
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                let alen = GL[(gi * 4 + 3) as usize]
                em(0x48); em(0xb8); em64(addr)  // mov rax, addr
                if alen == 0 {
                    em(0x48); em(0x8b); em(0x00)  // scalar: mov rax, [rax] (dereference)
                }
                // array: rax = address (no dereference — used as pointer)
            } else {
                // Function reference: let f = some_fn (no parens)
                // Wrap in closure struct so indirect calls use uniform convention.
                // Emit a wrapper fn that converts closure convention → normal convention:
                //   rdi=env(ignored), rsi=arg0, rdx=arg1, ... → rdi=arg0, rsi=arg1, ...
                // Then build a 1-slot struct [wrapper_addr] on the outer stack.
                let fri = fn_find(ns, ne)
                if fri >= 0 {
                    // Emit jmp over wrapper
                    em(0xe9)
                    let wr_jmp_patch = CL
                    em32(0)
                    let wr_start = CL
                    // Wrapper: shift args back (rsi→rdi, rdx→rsi, rcx→rdx, r8→rcx, r9→r8)
                    em(0x48); em(0x89); em(0xf7)  // mov rdi, rsi
                    em(0x48); em(0x89); em(0xd6)  // mov rsi, rdx
                    em(0x48); em(0x89); em(0xca)  // mov rdx, rcx
                    em(0x49); em(0x89); em(0xc0)  // mov r8, rax — save rax temporarily
                    em(0x4c); em(0x89); em(0xc1)  // mov rcx, r8 (original r8 value is lost, use r10)
                    // Actually we need: rcx = r8_old, r8 = r9_old
                    // The registers at entry: rdi=env, rsi=a0, rdx=a1, rcx=a2, r8=a3, r9=a4
                    // Target: rdi=a0, rsi=a1, rdx=a2, rcx=a3, r8=a4, r9=unused
                    // Careful ordering to avoid clobbering:
                    // 1. mov rdi, rsi (rdi clobbered, but we don't need env anymore)
                    // 2. mov rsi, rdx
                    // 3. mov rdx, rcx
                    // 4. mov rcx, r8
                    // 5. mov r8, r9
                    // Each reads from a register before it's overwritten. Safe order. Let me redo:
                    CL = wr_start  // rewind
                    em(0x48); em(0x89); em(0xf7)        // mov rdi, rsi
                    em(0x48); em(0x89); em(0xd6)        // mov rsi, rdx
                    em(0x48); em(0x89); em(0xca)        // mov rdx, rcx
                    em(0x4c); em(0x89); em(0xc1)        // mov rcx, r8
                    em(0x4d); em(0x89); em(0xc8)        // mov r8, r9
                    // jmp to real function (rel32, patched later)
                    em(0xe9)
                    PATCH_OFF[PATCH_COUNT as usize] = CL
                    PATCH_FN[PATCH_COUNT as usize] = fri
                    PATCH_COUNT = PATCH_COUNT + 1
                    em32(0)
                    // Patch jmp over wrapper
                    patch32(wr_jmp_patch, CL)
                    // Build 1-slot closure struct on stack: [wrapper_addr]
                    let fn_struct_slot = NEXT_SLOT
                    NEXT_SLOT = NEXT_SLOT + 1
                    em(0x48); em(0x8d); em(0x05)
                    em32(wr_start - (CL + 4))  // lea rax, [rip + offset_to_wrapper]
                    emit_store_var(fn_struct_slot)
                    // lea rax, [rbp - fn_struct_slot*8] — pointer to struct
                    em(0x48); em(0x8d); em(0x85)
                    em32(0 - fn_struct_slot * 8)
                    LAST_EXPR_IS_CLOSURE = 1
                } else {
                    print("warning: unknown identifier at line ")
                    print_int(TL[(EP - 1) as usize])
                    print("\n")
                    em(0x31); em(0xc0)
                }
            }
            EXPR_IS_F64 = 0
        }
        return
    }
    EP = EP + 1
    em(0x31); em(0xc0)
    EXPR_IS_F64 = 0
}

// Postfix: `as` type casts, `.field` access
fn compile_postfix() with IO, Mut, Panic, Div {
    compile_primary()
    var more: i64 = 1
    while more == 1 {
        if TK[EP as usize] == 37 {
            EP = EP + 1  // skip 'as'
            let tns = TS[EP as usize]
            let tne = TE[EP as usize]
            if tne - tns == 2 && sb(tns) == 105 && sb(tns+1) == 56 {
                em(0x48); em(0x0f); em(0xbe); em(0xc0)  // as i8: movsx rax, al
            }
            EP = EP + 1
            continue
        }
        if TK[EP as usize] == 50 {
            EP = EP + 1  // skip '.'
            let fns = TS[EP as usize]
            let fne = TE[EP as usize]
            let fh = gl_name_hash(fns, fne)
            // Method call: obj.method(args) → method(obj, args)
            if TK[(EP + 1) as usize] == 6 {
                let mfi = fn_find(fns, fne)
                if mfi >= 0 {
                    EP = EP + 1  // skip method name
                    EP = EP + 1  // skip (
                    // rax = self pointer. Push as first arg.
                    em(0x50)  // push self
                    var margc: i64 = 1
                    while TK[EP as usize] != 7 && TK[EP as usize] != 0 {
                        compile_or()
                        em(0x50)
                        margc = margc + 1
                        if TK[EP as usize] == 28 { EP = EP + 1 }
                    }
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                    // Pop args into registers (reverse order)
                    if margc >= 6 { em(0x41); em(0x59) }
                    if margc >= 5 { em(0x41); em(0x58) }
                    if margc >= 4 { em(0x59) }
                    if margc >= 3 { em(0x5a) }
                    if margc >= 2 { em(0x5e) }
                    if margc >= 1 { em(0x5f) }
                    em(0xe8)
                    PATCH_OFF[PATCH_COUNT as usize] = CL
                    PATCH_FN[PATCH_COUNT as usize] = mfi
                    PATCH_COUNT = PATCH_COUNT + 1
                    em32(0)
                    continue
                }
            }
            // Field access: rax = struct pointer, load field
            EP = EP + 1
            var found: i64 = 0
            var si: i64 = 0
            while si < ST_COUNT && found == 0 {
                let off = st_field_offset(si, fh)
                if off >= 0 {
                    if off == 0 {
                        em(0x48); em(0x8b); em(0x00)  // mov rax, [rax]
                    } else {
                        em(0x48); em(0x8b); em(0x80); em32(off)  // mov rax, [rax+off]
                    }
                    found = 1
                }
                si = si + 1
            }
            continue
        }
        more = 0
    }
}

fn compile_multiplicative() with IO, Mut, Panic, Div {
    compile_postfix()
    while TK[EP as usize] == 19 || TK[EP as usize] == 20 || TK[EP as usize] == 29 {
        let op = TK[EP as usize]
        EP = EP + 1
        let left_f64 = EXPR_IS_F64
        emit_push()
        compile_postfix()
        em(0x59)  // pop rcx (lhs)
        if left_f64 == 1 {
            // f64: movq xmm0, rcx; movq xmm1, rax; SSE2 op; movq rax, xmm0
            em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1)  // movq xmm0, rcx
            em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)  // movq xmm1, rax
            if op == 19 { em(0xf2); em(0x0f); em(0x59); em(0xc1) }  // mulsd xmm0, xmm1
            if op == 20 { em(0xf2); em(0x0f); em(0x5e); em(0xc1) }  // divsd xmm0, xmm1
            if op == 29 {
                // modulo: no f64 path, fall back to integer
                em(0x48); em(0x87); em(0xc1); em(0x48); em(0x99); em(0x48); em(0xf7); em(0xf9); em(0x48); em(0x89); em(0xd0)
            }
            em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)  // movq rax, xmm0
            EXPR_IS_F64 = 1
        } else {
            em(0x48); em(0x87); em(0xc1)  // xchg rax, rcx — rax=lhs, rcx=rhs
            if op == 19 { em(0x48); em(0x0f); em(0xaf); em(0xc1) }  // imul rax, rcx
            if op == 20 { em(0x48); em(0x99); em(0x48); em(0xf7); em(0xf9) }  // cqo; idiv rcx
            if op == 29 { em(0x48); em(0x99); em(0x48); em(0xf7); em(0xf9); em(0x48); em(0x89); em(0xd0) }  // cqo; idiv rcx; mov rax, rdx
        }
    }
}

fn compile_additive() with IO, Mut, Panic, Div {
    compile_multiplicative()
    while TK[EP as usize] == 17 || TK[EP as usize] == 18 {
        let op = TK[EP as usize]
        EP = EP + 1
        let left_f64 = EXPR_IS_F64
        emit_push()
        compile_multiplicative()
        em(0x59)  // pop rcx (lhs)
        if left_f64 == 1 {
            // f64: movq xmm0, rcx; movq xmm1, rax; SSE2 op; movq rax, xmm0
            em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1)  // movq xmm0, rcx
            em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)  // movq xmm1, rax
            if op == 17 { em(0xf2); em(0x0f); em(0x58); em(0xc1) }  // addsd xmm0, xmm1
            if op == 18 { em(0xf2); em(0x0f); em(0x5c); em(0xc1) }  // subsd xmm0, xmm1
            em(0x66); em(0x48); em(0x0f); em(0x7e); em(0xc0)  // movq rax, xmm0
            EXPR_IS_F64 = 1
        } else {
            if op == 17 { em(0x48); em(0x01); em(0xc8) }  // add rax, rcx (commutative: rcx+rax = ok)
            if op == 18 { em(0x48); em(0x87); em(0xc1); em(0x48); em(0x29); em(0xc8) }  // xchg; sub rax, rcx
        }
    }
}

// Shift: << (40), >> (39)
fn compile_shift() with IO, Mut, Panic, Div {
    compile_additive()
    while TK[EP as usize] == 39 || TK[EP as usize] == 40 {
        let op = TK[EP as usize]
        EP = EP + 1
        emit_push()
        compile_additive()
        // rax=rhs (shift amount), stack=lhs
        em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (shift amount in cl)
        em(0x58)  // pop rax (lhs)
        if op == 40 { em(0x48); em(0xd3); em(0xe0) }  // shl rax, cl
        if op == 39 { em(0x48); em(0xd3); em(0xf8) }  // sar rax, cl
    }
}

// Bitwise AND: & (44)
fn compile_bitand() with IO, Mut, Panic, Div {
    compile_shift()
    while TK[EP as usize] == 44 {
        EP = EP + 1; emit_push(); compile_shift()
        em(0x59); em(0x48); em(0x21); em(0xc8)  // pop rcx; and rax, rcx
    }
}

// Bitwise XOR: ^ (56)
fn compile_bitxor() with IO, Mut, Panic, Div {
    compile_bitand()
    while TK[EP as usize] == 56 {
        EP = EP + 1; emit_push(); compile_bitand()
        em(0x59); em(0x48); em(0x31); em(0xc8)  // pop rcx; xor rax, rcx
    }
}

// Bitwise OR: | (45)
fn compile_bitor() with IO, Mut, Panic, Div {
    compile_bitxor()
    while TK[EP as usize] == 45 {
        EP = EP + 1; emit_push(); compile_bitxor()
        em(0x59); em(0x48); em(0x09); em(0xc8)  // pop rcx; or rax, rcx
    }
}

fn compile_comparison() with IO, Mut, Panic, Div {
    compile_bitor()
    let op = TK[EP as usize]
    if op == 21 || op == 22 || op == 23 || op == 24 || op == 25 || op == 26 {
        let left_f64 = EXPR_IS_F64
        EP = EP + 1
        emit_push()
        compile_bitor()
        em(0x59)  // pop rcx (lhs)
        if left_f64 == 1 {
            // f64: movq xmm0, rcx (lhs); movq xmm1, rax (rhs); ucomisd xmm0, xmm1
            em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc1)  // movq xmm0, rcx
            em(0x66); em(0x48); em(0x0f); em(0x6e); em(0xc8)  // movq xmm1, rax
            em(0x66); em(0x0f); em(0x2e); em(0xc1)            // ucomisd xmm0, xmm1
            // Use unsigned conditional sets for FP comparison
            if op == 21 { em(0x0f); em(0x94); em(0xc0) }  // sete al -- EqEq
            if op == 22 { em(0x0f); em(0x95); em(0xc0) }  // setne al -- Neq
            if op == 23 { em(0x0f); em(0x92); em(0xc0) }  // setb al -- Lt
            if op == 24 { em(0x0f); em(0x97); em(0xc0) }  // seta al -- Gt
            if op == 25 { em(0x0f); em(0x96); em(0xc0) }  // setbe al -- LtEq
            if op == 26 { em(0x0f); em(0x93); em(0xc0) }  // setae al -- GtEq
        } else {
            em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
            if op == 21 { em(0x0f); em(0x94); em(0xc0) }  // sete al
            if op == 22 { em(0x0f); em(0x95); em(0xc0) }  // setne al
            if op == 23 { em(0x0f); em(0x9c); em(0xc0) }  // setl al
            if op == 24 { em(0x0f); em(0x9f); em(0xc0) }  // setg al
            if op == 25 { em(0x0f); em(0x9e); em(0xc0) }  // setle al
            if op == 26 { em(0x0f); em(0x9d); em(0xc0) }  // setge al
        }
        em(0x48); em(0x0f); em(0xb6); em(0xc0)  // movzx rax, al
        EXPR_IS_F64 = 0
    }
}

// Logical AND: && (30) — short-circuit
fn compile_and() with IO, Mut, Panic, Div {
    compile_comparison()
    while TK[EP as usize] == 30 {
        EP = EP + 1
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x0f); em(0x84)             // je short_false (rel32)
        let patch = CL; em32(0)
        compile_comparison()
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x0f); em(0x95); em(0xc0)  // setne al
        em(0x48); em(0x0f); em(0xb6); em(0xc0)  // movzx rax, al
        em(0xe9); let end_patch = CL; em32(0)  // jmp end
        // short_false: rax already 0
        let here = CL
        CD[patch as usize] = ((here - patch - 4) & 0xFF) as i8
        CD[(patch+1) as usize] = (((here - patch - 4) >> 8) & 0xFF) as i8
        CD[(patch+2) as usize] = (((here - patch - 4) >> 16) & 0xFF) as i8
        CD[(patch+3) as usize] = (((here - patch - 4) >> 24) & 0xFF) as i8
        em(0x31); em(0xc0)  // xor eax, eax
        let end = CL
        CD[end_patch as usize] = ((end - end_patch - 4) & 0xFF) as i8
        CD[(end_patch+1) as usize] = (((end - end_patch - 4) >> 8) & 0xFF) as i8
        CD[(end_patch+2) as usize] = (((end - end_patch - 4) >> 16) & 0xFF) as i8
        CD[(end_patch+3) as usize] = (((end - end_patch - 4) >> 24) & 0xFF) as i8
    }
}

// Logical OR: || (31) — short-circuit
fn compile_or() with IO, Mut, Panic, Div {
    compile_and()
    while TK[EP as usize] == 31 {
        EP = EP + 1
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x0f); em(0x85)             // jne short_true (rel32)
        let patch = CL; em32(0)
        compile_and()
        em(0xe9); let end_patch = CL; em32(0)  // jmp end
        // short_true: result = 1
        let here = CL
        CD[patch as usize] = ((here - patch - 4) & 0xFF) as i8
        CD[(patch+1) as usize] = (((here - patch - 4) >> 8) & 0xFF) as i8
        CD[(patch+2) as usize] = (((here - patch - 4) >> 16) & 0xFF) as i8
        CD[(patch+3) as usize] = (((here - patch - 4) >> 24) & 0xFF) as i8
        em(0x48); em(0xb8); em64(1)
        let end = CL
        CD[end_patch as usize] = ((end - end_patch - 4) & 0xFF) as i8
        CD[(end_patch+1) as usize] = (((end - end_patch - 4) >> 8) & 0xFF) as i8
        CD[(end_patch+2) as usize] = (((end - end_patch - 4) >> 16) & 0xFF) as i8
        CD[(end_patch+3) as usize] = (((end - end_patch - 4) >> 24) & 0xFF) as i8
    }
}

// ─── Patch helper ───
fn patch32(off: i64, target: i64) with Mut, Panic {
    let rel = target - off - 4
    CD[off as usize] = (rel & 0xFF) as i8
    CD[(off+1) as usize] = ((rel >> 8) & 0xFF) as i8
    CD[(off+2) as usize] = ((rel >> 16) & 0xFF) as i8
    CD[(off+3) as usize] = ((rel >> 24) & 0xFF) as i8
}

// ─── Statement compiler ───
fn compile_stmt() with IO, Mut, Panic, Div {
    let k = TK[EP as usize]

    // Skip semicolons
    if k == 27 { EP = EP + 1; return }

    // let x = expr / var x = expr (with optional : type)
    if k == 11 || k == 12 {
        EP = EP + 1
        let ns = TS[EP as usize]
        let ne = TE[EP as usize]
        EP = EP + 1
        // Check for : type annotation
        var is_arr: i64 = 0
        var arr_len: i64 = 0
        var arr_esiz: i64 = 8
        var decl_is_f64: i64 = -1
        if TK[EP as usize] == 43 {
            EP = EP + 1  // skip :
            // Skip & or &!
            if TK[EP as usize] == 44 { EP = EP + 1 }
            if TK[EP as usize] == 32 { EP = EP + 1 }
            // Array type: [T; N] — detect and extract element type + length
            if TK[EP as usize] == 41 {
                EP = EP + 1  // skip [
                // Element type
                let etns = TS[EP as usize]
                let etne = TE[EP as usize]
                if src_match(etns, etne - etns, "i8") { arr_esiz = 1 }
                EP = EP + 1  // skip element type
                if TK[EP as usize] == 27 { EP = EP + 1 }  // skip ;
                arr_len = TV[EP as usize]
                EP = EP + 1  // skip N
                if TK[EP as usize] == 42 { EP = EP + 1 }  // skip ]
                is_arr = 1
                decl_is_f64 = 0
            } else {
                // Check if type is "f64"
                let tns = TS[EP as usize]
                let tne = TE[EP as usize]
                if tne - tns == 3 && sb(tns) == 102 && sb(tns+1) == 54 && sb(tns+2) == 52 { decl_is_f64 = 1 }
                else { decl_is_f64 = 0 }
                EP = EP + 1  // skip type name
            }
        }
        // Skip = sign
        if TK[EP as usize] == 16 { EP = EP + 1 }
        if is_arr == 1 && arr_len > 0 {
            // Local array: allocate slots, skip initializer [0; N], store lea
            // Skip [0; N] or [val; N] initializer
            if TK[EP as usize] == 41 {
                EP = EP + 1  // skip [
                while TK[EP as usize] != 42 && TK[EP as usize] != 0 { EP = EP + 1 }
                if TK[EP as usize] == 42 { EP = EP + 1 }  // skip ]
            }
            var nslots = arr_len
            if arr_esiz == 1 { nslots = (arr_len + 7) / 8 }
            let ptr_slot = var_add_arr(ns, ne, nslots, arr_esiz)
            // Zero-init the array slots
            let base = ptr_slot - nslots
            var zi: i64 = 0
            while zi < nslots {
                em(0x48); em(0x31); em(0xc0)  // xor rax, rax
                emit_store_var(base + zi)
                zi = zi + 1
            }
            // Store lea (pointer to array start) in ptr_slot
            // Array slots are base..base+nslots-1, addresses [rbp-base*8]..[rbp-(base+nslots-1)*8]
            // Pointer must point to lowest address so arr[i] = [ptr + i*8] addresses upward
            em(0x48); em(0x8d); em(0x85)  // lea rax, [rbp + disp32]
            em32(0 - (base + nslots - 1) * 8)
            emit_store_var(ptr_slot)
        } else {
            compile_or()
            let slot = var_add(ns, ne)
            emit_store_var(slot)
            // Set f64 flag: explicit type annotation takes priority, else infer from RHS
            if decl_is_f64 == 1 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 1 }
            else if decl_is_f64 == 0 { VAR_IS_F64[(VAR_COUNT - 1) as usize] = 0 }
            else { VAR_IS_F64[(VAR_COUNT - 1) as usize] = EXPR_IS_F64 }
            // Set closure flag if RHS was a closure expression
            VAR_IS_CLOSURE[(VAR_COUNT - 1) as usize] = LAST_EXPR_IS_CLOSURE
            // Set linear flag if RHS was a linear struct literal
            VAR_LINEAR[(VAR_COUNT - 1) as usize] = LAST_EXPR_IS_LINEAR
        }
        return
    }

    // x.field = expr (struct field write)
    if k == 3 && TK[(EP + 1) as usize] == 50 && TK[(EP + 3) as usize] == 16 {
        let ns = TS[EP as usize]
        let ne = TE[EP as usize]
        EP = EP + 2  // skip name and .
        let fns = TS[EP as usize]
        let fne = TE[EP as usize]
        let fh = gl_name_hash(fns, fne)
        EP = EP + 1  // skip field name
        if TK[EP as usize] == 16 { EP = EP + 1 }  // skip =
        compile_or()  // value in rax
        em(0x50)  // push value
        // Load struct base pointer
        let slot = var_find(ns, ne)
        if slot >= 0 { emit_load_var(slot) }
        else {
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                em(0x48); em(0xb8); em64(addr)
            }
        }
        // rax = struct pointer. Find field offset and store.
        em(0x59)  // pop rcx (value)
        var si: i64 = 0
        while si < ST_COUNT {
            let off = st_field_offset(si, fh)
            if off >= 0 {
                if off == 0 { em(0x48); em(0x89); em(0x08) }  // mov [rax], rcx
                else { em(0x48); em(0x89); em(0x88); em32(off) }  // mov [rax+off], rcx
                si = ST_COUNT  // break
            }
            si = si + 1
        }
        return
    }

    // x = expr (local or global scalar assignment)
    if k == 3 && TK[(EP + 1) as usize] == 16 {
        let ns = TS[EP as usize]
        let ne = TE[EP as usize]
        EP = EP + 2
        compile_or()
        let slot = var_find(ns, ne)
        if slot >= 0 {
            emit_store_var(slot)
            // Update closure flag on reassignment
            var vi: i64 = VAR_COUNT - 1
            while vi >= 0 {
                if name_eq(VAR_NS[vi as usize], VAR_NE[vi as usize], ns, ne) {
                    VAR_IS_CLOSURE[vi as usize] = LAST_EXPR_IS_CLOSURE
                    vi = -1  // break
                }
                vi = vi - 1
            }
        }
        else {
            let gi = gl_find(ns, ne)
            if gi >= 0 {
                let addr = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
                // mov rcx, rax; mov rax, addr; mov [rax], rcx
                em(0x48); em(0x89); em(0xc1)  // mov rcx, rax (value)
                em(0x48); em(0xb8); em64(addr)  // mov rax, addr
                em(0x48); em(0x89); em(0x08)    // mov [rax], rcx
            }
        }
        return
    }
    // ARRAY[idx] = expr (global array write)
    if k == 3 && TK[(EP + 1) as usize] == 41 {
        let ns = TS[EP as usize]
        let ne = TE[EP as usize]
        EP = EP + 2  // skip name and [
        compile_or()  // index in rax
        if TK[EP as usize] == 37 { EP = EP + 1; EP = EP + 1 }  // skip 'as usize'
        if TK[EP as usize] == 42 { EP = EP + 1 }  // skip ]
        if TK[EP as usize] == 16 { EP = EP + 1 }  // skip =
        em(0x50)  // push index
        compile_or()  // value in rax
        let gi = gl_find(ns, ne)
        if gi >= 0 {
            let base = GL_BSS_BASE + GL[(gi * 4 + 1) as usize]
            let esz = GL[(gi * 4 + 2) as usize]
            // rax = value, stack = index
            em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (value)
            em(0x59)  // pop rcx (index)
            em(0x48); em(0xb8); em64(base)  // mov rax, base
            if esz == 8 {
                em(0x48); em(0x89); em(0x14); em(0xc8)  // mov [rax + rcx*8], rdx
            } else {
                em(0x88); em(0x14); em(0x08)  // mov [rax + rcx], dl (byte store)
            }
        } else {
            // Local array store: ptr[idx] = val
            let lslot = var_find(ns, ne)
            if lslot >= 0 {
                let llalen = var_find_alen(ns, ne)
                let lesiz = var_find_esiz(ns, ne)
                em(0x48); em(0x89); em(0xc2)  // mov rdx, rax (value)
                em(0x59)  // pop rcx (index)
                emit_load_var(lslot)  // load base ptr into rax
                if llalen > 0 && lesiz == 8 {
                    em(0x48); em(0x89); em(0x14); em(0xc8)  // mov [rax + rcx*8], rdx
                } else if llalen > 0 && lesiz == 1 {
                    em(0x88); em(0x14); em(0x08)  // mov [rax + rcx], dl
                } else {
                    // Non-array local pointer: byte store
                    em(0x88); em(0x14); em(0x08)  // mov [rax + rcx], dl
                }
            }
        }
        return
    }

    // return expr
    if k == 2 {
        EP = EP + 1
        if TK[EP as usize] != 9 { compile_or() }
        else { em(0x31); em(0xc0) }
        em(0x48); em(0x81); em(0xc4); em32(4096)
        em(0x5d); em(0xc3)
        return
    }

    // continue (33)
    if k == 33 {
        EP = EP + 1
        if LOOP_DEPTH > 0 {
            em(0xe9)
            let rel = LOOP_TOP[(LOOP_DEPTH - 1) as usize] - (CL + 4)
            em32(rel)
        }
        return
    }

    // break (34) — emit jmp rel32 placeholder, patched when while loop ends
    if k == 34 {
        EP = EP + 1
        em(0xe9)  // jmp rel32
        BREAK_PATCH[BREAK_COUNT as usize] = CL
        BREAK_COUNT = BREAK_COUNT + 1
        em32(0)  // placeholder — patched by while handler
        return
    }

    // if expr { stmts } else if ... / else { stmts }
    if k == 13 {
        EP = EP + 1
        compile_or()
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x0f); em(0x84)
        let je_off = CL; em32(0)
        if TK[EP as usize] == 8 { EP = EP + 1 }
        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
        if TK[EP as usize] == 9 { EP = EP + 1 }
        if TK[EP as usize] == 14 {
            EP = EP + 1
            em(0xe9)
            let jmp_off = CL; em32(0)
            patch32(je_off, CL)
            // else if: recurse into compile_stmt which handles 'if'
            if TK[EP as usize] == 13 {
                compile_stmt()
            } else {
                if TK[EP as usize] == 8 { EP = EP + 1 }
                while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
                if TK[EP as usize] == 9 { EP = EP + 1 }
            }
            patch32(jmp_off, CL)
        } else {
            patch32(je_off, CL)
        }
        return
    }

    // while expr { stmts }
    if k == 15 {
        EP = EP + 1
        let loop_top = CL
        LOOP_TOP[LOOP_DEPTH as usize] = loop_top
        LOOP_DEPTH = LOOP_DEPTH + 1
        let saved_bc = BREAK_COUNT
        compile_or()
        em(0x48); em(0x85); em(0xc0)
        em(0x0f); em(0x84)
        let je_off = CL; em32(0)
        if TK[EP as usize] == 8 { EP = EP + 1 }
        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
        if TK[EP as usize] == 9 { EP = EP + 1 }
        em(0xe9)
        em32(loop_top - (CL + 4))
        patch32(je_off, CL)
        // Patch all break jumps from this loop to point here
        var bi: i64 = saved_bc
        while bi < BREAK_COUNT { patch32(BREAK_PATCH[bi as usize], CL); bi = bi + 1 }
        BREAK_COUNT = saved_bc
        LOOP_DEPTH = LOOP_DEPTH - 1
        return
    }

    // for IDENT in range(START, END) { body }
    // Desugars to: var IDENT = START; while IDENT < END { body; IDENT = IDENT + 1 }
    if k == 54 {
        EP = EP + 1  // skip 'for'
        let vns = TS[EP as usize]
        let vne = TE[EP as usize]
        EP = EP + 1  // skip loop var name
        EP = EP + 1  // skip 'in'
        EP = EP + 1  // skip 'range'
        if TK[EP as usize] == 6 { EP = EP + 1 }  // skip (
        compile_or()  // START in rax
        let iter_slot = var_add(vns, vne)
        emit_store_var(iter_slot)
        if TK[EP as usize] == 28 { EP = EP + 1 }  // skip comma
        compile_or()  // END in rax
        let end_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        emit_store_var(end_slot)
        if TK[EP as usize] == 7 { EP = EP + 1 }  // skip )
        // while iter < end
        let loop_top = CL
        LOOP_TOP[LOOP_DEPTH as usize] = loop_top
        LOOP_DEPTH = LOOP_DEPTH + 1
        let saved_bc = BREAK_COUNT
        emit_load_var(iter_slot)
        em(0x50)  // push iter
        emit_load_var(end_slot)
        em(0x59)  // pop rcx (iter)
        em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
        em(0x0f); em(0x9c); em(0xc0)  // setl al
        em(0x48); em(0x0f); em(0xb6); em(0xc0)  // movzx rax, al
        em(0x48); em(0x85); em(0xc0)  // test rax, rax
        em(0x0f); em(0x84)
        let je_off = CL; em32(0)
        if TK[EP as usize] == 8 { EP = EP + 1 }  // skip {
        while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
        if TK[EP as usize] == 9 { EP = EP + 1 }  // skip }
        // iter = iter + 1
        emit_load_var(iter_slot)
        em(0x48); em(0x83); em(0xc0); em(1)  // add rax, 1
        emit_store_var(iter_slot)
        em(0xe9)
        em32(loop_top - (CL + 4))
        patch32(je_off, CL)
        var bi: i64 = saved_bc
        while bi < BREAK_COUNT { patch32(BREAK_PATCH[bi as usize], CL); bi = bi + 1 }
        BREAK_COUNT = saved_bc
        LOOP_DEPTH = LOOP_DEPTH - 1
        return
    }

    // match expr { pattern => body, ... }
    // 48 = match keyword
    if k == 48 {
        EP = EP + 1
        compile_or()  // scrutinee in rax
        // Store scrutinee in a local var (not stack — return inside arm would break stack)
        let match_slot = NEXT_SLOT
        NEXT_SLOT = NEXT_SLOT + 1
        emit_store_var(match_slot)
        if TK[EP as usize] == 8 { EP = EP + 1 }  // skip {
        var arm_count: i64 = 0
        while TK[EP as usize] != 9 && TK[EP as usize] != 0 {
            var is_wildcard: i64 = 0
            var disc: i64 = -1
            var arm_is_tagged: i64 = 0
            var bind_ns: i64 = 0
            var bind_ne: i64 = 0
            var has_binding: i64 = 0
            let arm_tk = TK[EP as usize]
            // Some(v) pattern — tag=1, bind inner value
            if arm_tk == 57 {
                EP = EP + 1
                disc = 1
                arm_is_tagged = 1
                if TK[EP as usize] == 6 {
                    EP = EP + 1
                    bind_ns = TS[EP as usize]
                    bind_ne = TE[EP as usize]
                    has_binding = 1
                    EP = EP + 1
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                }
            }
            // None pattern — tag=0
            if arm_tk == 58 {
                EP = EP + 1
                disc = 0
                arm_is_tagged = 1
            }
            // Ok(v) pattern — tag=0, bind payload
            if arm_tk == 59 {
                EP = EP + 1
                disc = 0
                arm_is_tagged = 1
                if TK[EP as usize] == 6 {
                    EP = EP + 1
                    bind_ns = TS[EP as usize]
                    bind_ne = TE[EP as usize]
                    has_binding = 1
                    EP = EP + 1
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                }
            }
            // Err(e) pattern — tag=1, bind payload
            if arm_tk == 60 {
                EP = EP + 1
                disc = 1
                arm_is_tagged = 1
                if TK[EP as usize] == 6 {
                    EP = EP + 1
                    bind_ns = TS[EP as usize]
                    bind_ne = TE[EP as usize]
                    has_binding = 1
                    EP = EP + 1
                    if TK[EP as usize] == 7 { EP = EP + 1 }
                }
            }
            if arm_tk == 3 {
                let pns = TS[EP as usize]
                let pne = TE[EP as usize]
                if pne - pns == 1 && sb(pns) == 95 {
                    is_wildcard = 1; EP = EP + 1
                } else if TK[(EP + 1) as usize] == 51 {
                    let eh = gl_name_hash(pns, pne)
                    EP = EP + 2
                    let vh = gl_name_hash(TS[EP as usize], TE[EP as usize])
                    EP = EP + 1
                    disc = en_variant_value(eh, vh)
                } else { EP = EP + 1 }
            }
            if arm_tk == 4 {
                disc = TV[EP as usize]; EP = EP + 1
            }
            if arm_tk != 57 && arm_tk != 58 && arm_tk != 59 && arm_tk != 60 && arm_tk != 3 && arm_tk != 4 { EP = EP + 1 }
            if disc >= 0 {
                if arm_is_tagged == 1 {
                    // Tagged union match: load tag from [scrutinee + 0]
                    emit_load_var(match_slot)
                    em(0x48); em(0x8b); em(0x00)  // mov rax, [rax] (tag)
                    em(0x50)  // push tag
                    em(0x48); em(0xb8); em64(disc)
                    em(0x59)  // pop rcx (tag)
                    em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
                    em(0x0f); em(0x85); let skip_patch = CL; em32(0)  // jne skip
                    // Bind inner value if pattern has binding
                    if has_binding == 1 {
                        emit_load_var(match_slot)
                        em(0x48); em(0x8b); em(0x40); em(0x08)  // mov rax, [rax + 8] (value)
                        let bslot = var_add(bind_ns, bind_ne)
                        emit_store_var(bslot)
                    }
                    if TK[EP as usize] == 52 { EP = EP + 1 }  // skip =>
                    if TK[EP as usize] == 8 { EP = EP + 1 }
                    while TK[EP as usize] != 9 && TK[EP as usize] != 28 && TK[EP as usize] != 0 { compile_stmt() }
                    if TK[EP as usize] == 9 { EP = EP + 1 }
                    em(0xe9); MATCH_ENDS[arm_count as usize] = CL; em32(0)
                    arm_count = arm_count + 1
                    patch32(skip_patch, CL)
                } else {
                    // Plain enum/integer match: compare scrutinee directly
                    emit_load_var(match_slot)
                    em(0x50)
                    em(0x48); em(0xb8); em64(disc)
                    em(0x59)
                    em(0x48); em(0x39); em(0xc1)  // cmp rcx, rax
                    em(0x0f); em(0x85); let skip_patch = CL; em32(0)  // jne skip
                    if TK[EP as usize] == 52 { EP = EP + 1 }  // skip =>
                    if TK[EP as usize] == 8 { EP = EP + 1 }
                    while TK[EP as usize] != 9 && TK[EP as usize] != 28 && TK[EP as usize] != 0 { compile_stmt() }
                    if TK[EP as usize] == 9 { EP = EP + 1 }
                    em(0xe9); MATCH_ENDS[arm_count as usize] = CL; em32(0)
                    arm_count = arm_count + 1
                    patch32(skip_patch, CL)
                }
            }
            if is_wildcard == 1 {
                if TK[EP as usize] == 52 { EP = EP + 1 }
                if TK[EP as usize] == 8 { EP = EP + 1 }
                while TK[EP as usize] != 9 && TK[EP as usize] != 0 { compile_stmt() }
                if TK[EP as usize] == 9 { EP = EP + 1 }
            }
            if TK[EP as usize] == 28 { EP = EP + 1 }
        }
        if TK[EP as usize] == 9 { EP = EP + 1 }
        var ai: i64 = 0
        while ai < arm_count { patch32(MATCH_ENDS[ai as usize], CL); ai = ai + 1 }
        return
    }

    // Expression statement
    compile_or()
}

// ─── Top-level compiler ───
// ─── Monomorphization pass ───
// Scans for generic fn/struct declarations, finds instantiation sites,
// generates specialized token copies. Separate function to limit stack usage.
fn mono_pass() with IO, Mut, Panic, Div {
    GEN_FN_COUNT = 0
    GEN_ST_COUNT = 0
    MONO_COUNT = 0
    // Pass 0c: scan generic function and struct declarations
    var p: i64 = 0
    while p < TC {
        // fn NAME < TPARAM > (
        if TK[p as usize] == 1 && p + 4 < TC && TK[(p + 2) as usize] == 23 && TK[(p + 4) as usize] == 24 {
            let gi = GEN_FN_COUNT
            GEN_FN_NS[gi as usize] = TS[(p + 1) as usize]
            GEN_FN_NE[gi as usize] = TE[(p + 1) as usize]
            GEN_FN_TP_S[gi as usize] = TS[(p + 3) as usize]
            GEN_FN_TP_E[gi as usize] = TE[(p + 3) as usize]
            GEN_FN_BDY_S[gi as usize] = p
            var q: i64 = p + 5
            while q < TC && TK[q as usize] != 8 { q = q + 1 }
            var bd: i64 = 1
            q = q + 1
            while q < TC && bd > 0 { if TK[q as usize] == 8 { bd = bd + 1 }; if TK[q as usize] == 9 { bd = bd - 1 }; q = q + 1 }
            GEN_FN_BDY_E[gi as usize] = q
            GEN_FN_COUNT = GEN_FN_COUNT + 1
            p = q
            continue
        }
        // struct NAME < TPARAM > {
        if TK[p as usize] == 46 && p + 4 < TC && TK[(p + 2) as usize] == 23 && TK[(p + 4) as usize] == 24 {
            let gi = GEN_ST_COUNT
            GEN_ST_NS[gi as usize] = TS[(p + 1) as usize]
            GEN_ST_NE[gi as usize] = TE[(p + 1) as usize]
            GEN_ST_TP_S[gi as usize] = TS[(p + 3) as usize]
            GEN_ST_TP_E[gi as usize] = TE[(p + 3) as usize]
            GEN_ST_BDY_S[gi as usize] = p
            var q: i64 = p + 5
            while q < TC && TK[q as usize] != 9 { q = q + 1 }
            q = q + 1
            GEN_ST_BDY_E[gi as usize] = q
            GEN_ST_COUNT = GEN_ST_COUNT + 1
            p = q
            continue
        }
        // pub/linear struct generics
        if (TK[p as usize] == 49 || TK[p as usize] == 62) && p + 5 < TC && TK[(p + 1) as usize] == 46 && TK[(p + 3) as usize] == 23 && TK[(p + 5) as usize] == 24 {
            let gi = GEN_ST_COUNT
            GEN_ST_NS[gi as usize] = TS[(p + 2) as usize]
            GEN_ST_NE[gi as usize] = TE[(p + 2) as usize]
            GEN_ST_TP_S[gi as usize] = TS[(p + 4) as usize]
            GEN_ST_TP_E[gi as usize] = TE[(p + 4) as usize]
            GEN_ST_BDY_S[gi as usize] = p
            var q: i64 = p + 6
            while q < TC && TK[q as usize] != 9 { q = q + 1 }
            q = q + 1
            GEN_ST_BDY_E[gi as usize] = q
            GEN_ST_COUNT = GEN_ST_COUNT + 1
            p = q
            continue
        }
        p = p + 1
    }
    if GEN_FN_COUNT > 0 || GEN_ST_COUNT > 0 {
        print("generics: fns="); print_int(GEN_FN_COUNT); print(" structs="); print_int(GEN_ST_COUNT); print("\n")
    }
    if GEN_FN_COUNT == 0 && GEN_ST_COUNT == 0 { return }
    // Pass 0d: find instantiation sites
    p = 0
    var in_gen: i64 = 0
    var ig: i64 = 0
    var d_gi: i64 = 0
    var d_cns: i64 = 0
    var d_cne: i64 = 0
    var d_tys: i64 = 0
    var d_tye: i64 = 0
    var d_mi: i64 = 0
    var d_ms: i64 = 0
    while p < TC {
        in_gen = 0
        ig = 0
        while ig < GEN_FN_COUNT { if p >= GEN_FN_BDY_S[ig as usize] && p < GEN_FN_BDY_E[ig as usize] { in_gen = 1 }; ig = ig + 1 }
        ig = 0
        while ig < GEN_ST_COUNT { if p >= GEN_ST_BDY_S[ig as usize] && p < GEN_ST_BDY_E[ig as usize] { in_gen = 1 }; ig = ig + 1 }
        if in_gen == 1 { p = p + 1; continue }
        if TK[p as usize] == 3 && p + 3 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 3) as usize] == 24 {
            d_cns = TS[p as usize]
            d_cne = TE[p as usize]
            d_tys = TS[(p + 2) as usize]
            d_tye = TE[(p + 2) as usize]
            d_gi = 0
            while d_gi < GEN_FN_COUNT {
                if name_eq(d_cns, d_cne, GEN_FN_NS[d_gi as usize], GEN_FN_NE[d_gi as usize]) {
                    if mono_find_inst(d_gi, 0, d_tys, d_tye) < 0 {
                        d_mi = MONO_COUNT
                        MONO_GEN[d_mi as usize] = d_gi
                        MONO_TY_S[d_mi as usize] = d_tys
                        MONO_TY_E[d_mi as usize] = d_tye
                        MONO_IS_ST[d_mi as usize] = 0
                        d_ms = mono_mangle(GEN_FN_NS[d_gi as usize], GEN_FN_NE[d_gi as usize], d_tys, d_tye)
                        MAN_BUF_S[d_mi as usize] = d_ms
                        MAN_BUF_E[d_mi as usize] = SRC_LEN
                        MONO_COUNT = MONO_COUNT + 1
                    }
                    d_gi = GEN_FN_COUNT
                }
                d_gi = d_gi + 1
            }
            d_gi = 0
            while d_gi < GEN_ST_COUNT {
                if name_eq(d_cns, d_cne, GEN_ST_NS[d_gi as usize], GEN_ST_NE[d_gi as usize]) {
                    if mono_find_inst(d_gi, 1, d_tys, d_tye) < 0 {
                        d_mi = MONO_COUNT
                        MONO_GEN[d_mi as usize] = d_gi
                        MONO_TY_S[d_mi as usize] = d_tys
                        MONO_TY_E[d_mi as usize] = d_tye
                        MONO_IS_ST[d_mi as usize] = 1
                        d_ms = mono_mangle(GEN_ST_NS[d_gi as usize], GEN_ST_NE[d_gi as usize], d_tys, d_tye)
                        MAN_BUF_S[d_mi as usize] = d_ms
                        MAN_BUF_E[d_mi as usize] = SRC_LEN
                        MONO_COUNT = MONO_COUNT + 1
                    }
                    d_gi = GEN_ST_COUNT
                }
                d_gi = d_gi + 1
            }
        }
        p = p + 1
    }
    // Generate specialized token copies
    var m_i: i64 = 0
    var m_gi: i64 = 0
    var m_is_st: i64 = 0
    var m_tys: i64 = 0
    var m_tye: i64 = 0
    var m_mns: i64 = 0
    var m_mne: i64 = 0
    var m_bs: i64 = 0
    var m_be: i64 = 0
    var m_tps: i64 = 0
    var m_tpe: i64 = 0
    var m_gns: i64 = 0
    var m_gne: i64 = 0
    var m_ti: i64 = 0
    var m_skip: i64 = 0
    var m_tk: i64 = 0
    var m_tts: i64 = 0
    var m_tte: i64 = 0
    while m_i < MONO_COUNT {
        m_gi = MONO_GEN[m_i as usize]
        m_is_st = MONO_IS_ST[m_i as usize]
        m_tys = MONO_TY_S[m_i as usize]
        m_tye = MONO_TY_E[m_i as usize]
        m_mns = MAN_BUF_S[m_i as usize]
        m_mne = MAN_BUF_E[m_i as usize]
        m_bs = 0
        m_be = 0
        m_tps = 0
        m_tpe = 0
        m_gns = 0
        m_gne = 0
        if m_is_st == 0 {
            m_bs = GEN_FN_BDY_S[m_gi as usize]
            m_be = GEN_FN_BDY_E[m_gi as usize]
            m_tps = GEN_FN_TP_S[m_gi as usize]
            m_tpe = GEN_FN_TP_E[m_gi as usize]
            m_gns = GEN_FN_NS[m_gi as usize]
            m_gne = GEN_FN_NE[m_gi as usize]
        } else {
            m_bs = GEN_ST_BDY_S[m_gi as usize]
            m_be = GEN_ST_BDY_E[m_gi as usize]
            m_tps = GEN_ST_TP_S[m_gi as usize]
            m_tpe = GEN_ST_TP_E[m_gi as usize]
            m_gns = GEN_ST_NS[m_gi as usize]
            m_gne = GEN_ST_NE[m_gi as usize]
        }
        m_ti = m_bs
        m_skip = 0
        while m_ti < m_be && TC < 32760 {
            m_tk = TK[m_ti as usize]
            m_tts = TS[m_ti as usize]
            m_tte = TE[m_ti as usize]
            if m_skip == 0 && m_tk == 23 && m_ti > m_bs && name_eq(TS[(m_ti - 1) as usize], TE[(m_ti - 1) as usize], m_gns, m_gne) {
                m_ti = m_ti + 3
                m_skip = 1
                continue
            }
            if m_tk == 3 && name_eq(m_tts, m_tte, m_gns, m_gne) {
                TK[TC as usize] = 3
                TS[TC as usize] = m_mns
                TE[TC as usize] = m_mne
                TV[TC as usize] = 0
                TL[TC as usize] = TL[m_ti as usize]
                TC = TC + 1
                m_ti = m_ti + 1
                continue
            }
            if m_tk == 3 && name_eq(m_tts, m_tte, m_tps, m_tpe) {
                TK[TC as usize] = 3
                TS[TC as usize] = m_tys
                TE[TC as usize] = m_tye
                TV[TC as usize] = 0
                TL[TC as usize] = TL[m_ti as usize]
                TC = TC + 1
                m_ti = m_ti + 1
                continue
            }
            TK[TC as usize] = m_tk
            TS[TC as usize] = m_tts
            TE[TC as usize] = m_tte
            TV[TC as usize] = TV[m_ti as usize]
            TF[TC as usize] = TF[m_ti as usize]
            TD[TC as usize] = TD[m_ti as usize]
            TL[TC as usize] = TL[m_ti as usize]
            TC = TC + 1
            m_ti = m_ti + 1
        }
        m_i = m_i + 1
    }
    // Re-add EOF token and re-scan monomorphized structs
    if MONO_COUNT > 0 {
        TK[TC as usize] = 0
        TC = TC + 1
        print("mono: "); print_int(MONO_COUNT); print(" specializations, tokens="); print_int(TC); print("\n")
        // Re-scan for monomorphized struct declarations
        p = 0
        while p < TC {
            if TK[p as usize] == 46 || TK[p as usize] == 49 || TK[p as usize] == 62 {
                if TK[p as usize] == 49 || TK[p as usize] == 62 { p = p + 1 }
                if TK[p as usize] == 46 {
                    p = p + 1
                    let rsn_ns = TS[p as usize]
                    let rsn_ne = TE[p as usize]
                    let rsh = gl_name_hash(rsn_ns, rsn_ne)
                    if st_find(rsh) < 0 {
                        let rsi = ST_COUNT
                        let rbase = rsi * 66
                        ST[rbase as usize] = rsh
                        p = p + 1
                        if TK[p as usize] == 23 { p = p + 1; while TK[p as usize] != 9 && TK[p as usize] != 0 { p = p + 1 }; if TK[p as usize] == 9 { p = p + 1 }; ST[(rbase + 1) as usize] = 0; ST_COUNT = ST_COUNT + 1; continue }
                        if TK[p as usize] == 8 { p = p + 1 }
                        var rfc: i64 = 0
                        while TK[p as usize] != 9 && TK[p as usize] != 0 {
                            if TK[p as usize] == 3 {
                                let rfh = gl_name_hash(TS[p as usize], TE[p as usize])
                                ST[(rbase + 2 + rfc) as usize] = rfh
                                rfc = rfc + 1
                                p = p + 1
                                if TK[p as usize] == 43 { p = p + 1; p = p + 1 }
                                if TK[p as usize] == 28 { p = p + 1 }
                                continue
                            }
                            p = p + 1
                        }
                        ST[(rbase + 1) as usize] = rfc
                        ST_COUNT = ST_COUNT + 1
                    }
                    if TK[p as usize] == 9 { p = p + 1 }
                    continue
                }
            }
            p = p + 1
        }
    }
}

pub fn compile_all() -> i64 with IO, Mut, Panic, Div {
    CL = 0
    FN_COUNT = 0
    PATCH_COUNT = 0
    GL_COUNT = 0
    GL_BSS_SIZE = 0
    var p: i64 = 0

    // Pass 0a: register structs
    ST_COUNT = 0
    while p < TC {
        if TK[p as usize] == 46 || TK[p as usize] == 49 || TK[p as usize] == 62 {
            // struct or pub/linear keyword — skip pub/linear prefix, track linear
            var is_linear_decl: i64 = 0
            if TK[p as usize] == 62 { is_linear_decl = 1 }
            if TK[p as usize] == 49 || TK[p as usize] == 62 { p = p + 1 }
            if TK[p as usize] == 46 {
                p = p + 1  // skip 'struct'
                let sn_ns = TS[p as usize]
                let sn_ne = TE[p as usize]
                p = p + 1  // skip name
                // Skip generic struct templates
                if TK[p as usize] == 23 { while TK[p as usize] != 9 && TK[p as usize] != 0 { p = p + 1 }; if TK[p as usize] == 9 { p = p + 1 }; continue }
                let sh = gl_name_hash(sn_ns, sn_ne)
                let si = ST_COUNT
                let base = si * 66
                ST[base as usize] = sh
                if TK[p as usize] == 8 { p = p + 1 }  // skip {
                var fc: i64 = 0
                while TK[p as usize] != 9 && TK[p as usize] != 0 {
                    if TK[p as usize] == 3 {
                        let fh = gl_name_hash(TS[p as usize], TE[p as usize])
                        ST[(base + 2 + fc) as usize] = fh
                        fc = fc + 1
                        p = p + 1
                        // Skip : type
                        if TK[p as usize] == 43 { p = p + 1; p = p + 1 }
                        // Skip comma
                        if TK[p as usize] == 28 { p = p + 1 }
                        continue
                    }
                    p = p + 1
                }
                ST[(base + 1) as usize] = fc
                ST_LINEAR[si as usize] = is_linear_decl
                ST_COUNT = ST_COUNT + 1
                if TK[p as usize] == 9 { p = p + 1 }
                continue
            }
        }
        p = p + 1
    }
    // Also scan enums in the same pass
    p = 0
    EN_COUNT = 0
    while p < TC {
        if TK[p as usize] == 47 {
            p = p + 1  // skip 'enum'
            let en_ns = TS[p as usize]
            let en_ne = TE[p as usize]
            let eh = gl_name_hash(en_ns, en_ne)
            let ei = EN_COUNT
            let base = ei * 34
            EN[base as usize] = eh
            p = p + 1  // skip name
            if TK[p as usize] == 8 { p = p + 1 }  // skip {
            var vc: i64 = 0
            while TK[p as usize] != 9 && TK[p as usize] != 0 {
                if TK[p as usize] == 3 {
                    let vh = gl_name_hash(TS[p as usize], TE[p as usize])
                    EN[(base + 2 + vc) as usize] = vh
                    vc = vc + 1
                }
                p = p + 1
            }
            EN[(base + 1) as usize] = vc
            EN_COUNT = EN_COUNT + 1
            if TK[p as usize] == 9 { p = p + 1 }
            continue
        }
        p = p + 1
    }
    p = 0

    // Pass 0c+0d: monomorphization (in separate function to limit stack usage)
    mono_pass()
    p = 0
    // Pass 0b: register global variables
    var depth: i64 = 0
    while p < TC {
        let tk = TK[p as usize]
        if tk == 8 { depth = depth + 1; p = p + 1; continue }
        if tk == 9 { depth = depth - 1; p = p + 1; continue }
        if depth > 0 { p = p + 1; continue }
        // Top-level var
        if tk == 12 {
            p = p + 1
            let gns = TS[p as usize]
            let gne = TE[p as usize]
            p = p + 1
            // Expect : type
            if TK[p as usize] == 43 {
                p = p + 1
                let tns = TS[p as usize]
                let tne = TE[p as usize]
                // Check if [TYPE; N] array
                if TK[p as usize] == 41 {
                    // [TYPE; N]
                    p = p + 1
                    let etns = TS[p as usize]
                    let etne = TE[p as usize]
                    var esiz: i64 = 8
                    if src_match(etns, etne - etns, "i8") { esiz = 1 }
                    p = p + 1
                    // Skip ;
                    if TK[p as usize] == 27 { p = p + 1 }
                    // Array length
                    let alen = TV[p as usize]
                    p = p + 1
                    // Skip ]
                    if TK[p as usize] == 42 { p = p + 1 }
                    gl_add(gns, gne, esiz, alen)
                } else {
                    // Scalar: i64, i32, bool, string
                    gl_add(gns, gne, 8, 0)
                    p = p + 1
                }
            }
            // Skip = initializer until next var or fn or EOF
            while p < TC && TK[p as usize] != 12 && TK[p as usize] != 1 && TK[p as usize] != 0 { p = p + 1 }
            continue
        }
        p = p + 1
    }
    p = 0

    // BSS layout: [argc(8)] [argv(8)] [globals...]
    // Add 16 to BSS_BASE so globals start at BSS+16, but argc/argv at BSS+0
    GL_BSS_BASE = 0x600000 + 16
    GL_BSS_SIZE = GL_BSS_SIZE + 16

    print("globals: "); print_int(GL_COUNT); print(" bss="); print_int(GL_BSS_SIZE); print("\n")

    // Pass 1: register all function names (skip generic templates)
    while p < TC {
        if TK[p as usize] == 1 {
            p = p + 1
            if p + 2 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 3) as usize] == 24 { p = p + 1; continue }
            FN_NS[FN_COUNT as usize] = TS[p as usize]
            FN_NE[FN_COUNT as usize] = TE[p as usize]
            FN_OFF[FN_COUNT as usize] = -1
            FN_COUNT = FN_COUNT + 1
        }
        p = p + 1
    }

    // Pass 1b: scan effects clauses for each function
    // For each fn at index fi, scan forward from its name token to find 'with' (38)
    // and record effect bitmask: IO=1, Mut=2, Panic=4, Div=8, Alloc=16
    p = 0
    var eff_fi: i64 = 0
    while p < TC {
        if TK[p as usize] == 1 {
            p = p + 1
            // Skip generic templates
            if p + 2 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 3) as usize] == 24 { p = p + 1; continue }
            // Scan forward to find { (start of body) — effects are between ) -> type with ... {
            var eq: i64 = p + 1
            while eq < TC && TK[eq as usize] != 8 { eq = eq + 1 }
            // Now scan from p to eq for 'with' token (38)
            var ew: i64 = p
            while ew < eq {
                if TK[ew as usize] == 38 {
                    ew = ew + 1
                    while ew < eq && (TK[ew as usize] == 3 || TK[ew as usize] == 28) {
                        if TK[ew as usize] == 3 {
                            let ens = TS[ew as usize]
                            let ene = TE[ew as usize]
                            if src_match(ens, ene - ens, "IO") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 1 }
                            if src_match(ens, ene - ens, "Mut") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 2 }
                            if src_match(ens, ene - ens, "Panic") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 4 }
                            if src_match(ens, ene - ens, "Div") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 8 }
                            if src_match(ens, ene - ens, "Alloc") { FN_EFFECTS[eff_fi as usize] = FN_EFFECTS[eff_fi as usize] | 16 }
                        }
                        ew = ew + 1
                    }
                    ew = eq  // done scanning
                }
                ew = ew + 1
            }
            if eff_fi < FN_COUNT { eff_fi = eff_fi + 1 }
        }
        p = p + 1
    }
    print("effects: scanned "); print_int(eff_fi); print(" functions\n")

    // Pass 1c: scan top-level type aliases (token 61)
    p = 0
    var tdepth: i64 = 0
    while p < TC {
        let ttk = TK[p as usize]
        if ttk == 8 { tdepth = tdepth + 1; p = p + 1; continue }
        if ttk == 9 { tdepth = tdepth - 1; p = p + 1; continue }
        if tdepth > 0 { p = p + 1; continue }
        if ttk == 61 {
            // type NAME = ...
            p = p + 1
            if p < TC && TK[p as usize] == 3 {
                let tnh = gl_name_hash(TS[p as usize], TE[p as usize])
                if REF_TYPE_COUNT < 32 {
                    REF_TYPE_HASH[REF_TYPE_COUNT as usize] = tnh
                    REF_TYPE_COUNT = REF_TYPE_COUNT + 1
                }
                p = p + 1
            }
            // Skip = and everything to next top-level declaration
            while p < TC && TK[p as usize] != 1 && TK[p as usize] != 12 && TK[p as usize] != 46 && TK[p as usize] != 47 && TK[p as usize] != 61 && TK[p as usize] != 0 { p = p + 1 }
            continue
        }
        p = p + 1
    }
    if REF_TYPE_COUNT > 0 { print("types: "); print_int(REF_TYPE_COUNT); print(" aliases\n") }

    // Pass 2: compile each function
    p = 0
    var fn_idx: i64 = 0
    while p < TC {
        if TK[p as usize] != 1 { p = p + 1; continue }
        p = p + 1  // skip 'fn'

        // Skip generic function templates
        if p + 2 < TC && TK[(p + 1) as usize] == 23 && TK[(p + 3) as usize] == 24 {
            while p < TC && TK[p as usize] != 8 { p = p + 1 }
            var gd: i64 = 1
            p = p + 1
            while p < TC && gd > 0 { if TK[p as usize] == 8 { gd = gd + 1 }; if TK[p as usize] == 9 { gd = gd - 1 }; p = p + 1 }
            continue
        }

        // Record code offset + set current function for effects checking
        FN_OFF[fn_idx as usize] = CL
        CURRENT_FN = fn_idx

        // Reset local vars
        VAR_COUNT = 0
        NEXT_SLOT = 1
        BREAK_COUNT = 0

        // Register parameters
        p = p + 1  // skip name
        if TK[p as usize] == 6 { p = p + 1 }
        while TK[p as usize] != 7 && TK[p as usize] != 0 {
            if TK[p as usize] == 3 {
                let pns = TS[p as usize]
                let pne = TE[p as usize]
                let pslot = var_add(pns, pne)
                p = p + 1
                // Skip : type annotation (handles &T, &!T, [T; N], simple T)
                if TK[p as usize] == 43 {
                    p = p + 1  // skip :
                    if TK[p as usize] == 44 { p = p + 1 }  // skip &
                    if TK[p as usize] == 32 { p = p + 1 }  // skip !
                    if TK[p as usize] == 41 {
                        // [T; N]
                        p = p + 1
                        while TK[p as usize] != 42 && TK[p as usize] != 0 { p = p + 1 }
                        if TK[p as usize] == 42 { p = p + 1 }
                    } else {
                        p = p + 1  // skip type name
                    }
                }
            }
            if TK[p as usize] == 28 { p = p + 1 }
        }
        if TK[p as usize] == 7 { p = p + 1 }
        // Skip -> type
        if TK[p as usize] == 10 { p = p + 1; p = p + 1 }
        // Skip 'with' effects clause (with=38, ident=3, comma=28)
        if TK[p as usize] == 38 { p = p + 1; while TK[p as usize] == 3 || TK[p as usize] == 28 { p = p + 1 } }
        if TK[p as usize] == 8 { p = p + 1 }

        // Emit prologue: push rbp; mov rbp, rsp; sub rsp, 512
        print_int(fn_idx)
        print(" ")
        em(0x55); em(0x48); em(0x89); em(0xe5)
        em(0x48); em(0x81); em(0xec); em32(4096)

        // Store parameters from registers to stack slots (System V ABI: rdi,rsi,rdx,rcx,r8,r9)
        if VAR_COUNT >= 1 { em(0x48); em(0x89); em(0x7d); em(0xf8 as i64 & 0xFF) }    // mov [rbp-8], rdi
        if VAR_COUNT >= 2 { em(0x48); em(0x89); em(0x75); em(0xf0 as i64 & 0xFF) }    // mov [rbp-16], rsi
        if VAR_COUNT >= 3 { em(0x48); em(0x89); em(0x55); em(0xe8 as i64 & 0xFF) }    // mov [rbp-24], rdx
        if VAR_COUNT >= 4 { em(0x48); em(0x89); em(0x4d); em(0xe0 as i64 & 0xFF) }    // mov [rbp-32], rcx
        if VAR_COUNT >= 5 { em(0x4c); em(0x89); em(0x45); em(0xd8 as i64 & 0xFF) }    // mov [rbp-40], r8
        if VAR_COUNT >= 6 { em(0x4c); em(0x89); em(0x4d); em(0xd0 as i64 & 0xFF) }    // mov [rbp-48], r9

        // Compile body
        EP = p
        var depth: i64 = 1
        while EP < TC && depth > 0 {
            if TK[EP as usize] == 9 { depth = depth - 1; if depth == 0 { EP = EP + 1; continue } else { EP = EP + 1; continue } }
            compile_stmt()
        }
        p = EP

        // Linear type check: warn if any linear variable was not used exactly once
        var lci: i64 = 0
        while lci < VAR_COUNT {
            if VAR_LINEAR[lci as usize] == 1 {
                if VAR_USED[lci as usize] == 0 {
                    print("warning: linear var#")
                    print_int(lci)
                    print(" in fn#")
                    print_int(fn_idx)
                    print(" never used (must use exactly once)\n")
                }
                if VAR_USED[lci as usize] > 1 {
                    print("warning: linear var#")
                    print_int(lci)
                    print(" in fn#")
                    print_int(fn_idx)
                    print(" used ")
                    print_int(VAR_USED[lci as usize])
                    print(" times (must use exactly once)\n")
                }
            }
            lci = lci + 1
        }

        // Implicit return 0
        if CL > 0 && CD[(CL - 1) as usize] != 0xc3 as i8 {
            em(0x31); em(0xc0)
            em(0x48); em(0x81); em(0xc4); em32(4096)
            em(0x5d); em(0xc3)
        }
        fn_idx = fn_idx + 1
    }

    // Patch function calls
    var pi: i64 = 0
    while pi < PATCH_COUNT {
        let off = PATCH_OFF[pi as usize]
        let fi = PATCH_FN[pi as usize]
        if fi >= 0 && fi < FN_COUNT {
            let target = FN_OFF[fi as usize]
            let rel = target - (off + 4)
            CD[(off) as usize] = (rel & 0xFF) as i8
            CD[(off + 1) as usize] = ((rel >> 8) & 0xFF) as i8
            CD[(off + 2) as usize] = ((rel >> 16) & 0xFF) as i8
            CD[(off + 3) as usize] = ((rel >> 24) & 0xFF) as i8
        }
        pi = pi + 1
    }

    // Find main
    var main_fn: i64 = -1
    var mi: i64 = 0
    while mi < FN_COUNT {
        let ms = FN_NS[mi as usize]
        let me = FN_NE[mi as usize]
        if me - ms == 4 && sb(ms) == 109 && sb(ms+1) == 97 && sb(ms+2) == 105 && sb(ms+3) == 110 { main_fn = mi }
        mi = mi + 1
    }
    if main_fn < 0 { print("error: no main\n"); return 1 }

    // Trampoline: save argc/argv, call main, exit
    TRAMP_OFF = CL
    let tramp = CL
    // At entry: [rsp]=argc, [rsp+8]=argv[0], [rsp+16]=argv[1], ...
    // Save argc at BSS+0, argv pointer at BSS+8
    let argc_addr = 0x600000
    let argv_addr = 0x600000 + 8
    em(0x48); em(0x8b); em(0x04); em(0x24)  // mov rax, [rsp] (argc)
    em(0x48); em(0x83); em(0xe8); em(0x01)  // sub rax, 1 (skip program name)
    em(0x48); em(0xb9); em64(argc_addr)
    em(0x48); em(0x89); em(0x01)  // mov [rcx], rax (save argc-1)
    em(0x48); em(0x8d); em(0x44); em(0x24); em(16)  // lea rax, [rsp+16] (argv+1)
    em(0x48); em(0xb9); em64(argv_addr)
    em(0x48); em(0x89); em(0x01)  // mov [rcx], rax (save argv ptr)
    // call main
    em(0xe8)
    let rel = FN_OFF[main_fn as usize] - (CL + 4)
    em32(rel)
    // exit(rax)
    em(0x89); em(0xc7)
    em(0xb8); em32(60)
    em(0x0f); em(0x05)

    print("compile: fns="); print_int(FN_COUNT); print(" code="); print_int(CL)
    print(" main=fn"); print_int(main_fn); print(" patches="); print_int(PATCH_COUNT); print("\n")
    0
}

// ─── ELF byte writer helpers ───
