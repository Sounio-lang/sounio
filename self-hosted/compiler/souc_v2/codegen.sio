        NEXT_SLOT = save_ns2
        LOOP_DEPTH = save_ld
        BREAK_COUNT = save_bc
        svi = 0
        while svi < save_vc {
            VAR_NS[svi as usize] = CL_SAVE_NS[svi as usize]
            VAR_NE[svi as usize] = CL_SAVE_NE[svi as usize]
            VAR_SLOT[svi as usize] = CL_SAVE_SL[svi as usize]
            VAR_ALEN[svi as usize] = CL_SAVE_AL[svi as usize]
            VAR_ESIZ[svi as usize] = CL_SAVE_ES[svi as usize]
            VAR_IS_F64[svi as usize] = CL_SAVE_F64[svi as usize]
            VAR_IS_CLOSURE[svi as usize] = CL_SAVE_ISCL[svi as usize]
