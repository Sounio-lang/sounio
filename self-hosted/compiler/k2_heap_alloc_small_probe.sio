use mem::box::{heap_alloc}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    print("k2_heap_alloc_small_probe=start\n")
    print("k2_heap_alloc_small_probe=alloc_enter\n")
    let ptr = heap_alloc(8) as *mut i64
    print("k2_heap_alloc_small_probe=alloc_ok\n")
    (*ptr) = 42
    print("k2_heap_alloc_small_probe=value=")
    print_int(*ptr)
    print("\n")
    if *ptr == 42 {
        print("k2_heap_alloc_small_probe=ok\n")
        return 0
    }
    print("k2_heap_alloc_small_probe=bad\n")
    1
}
