use lexer::mod::{lex_file_parse_items}
use parser::ast::{ItemKind, ItemList, Name, TypeExpr, TypeExprKind, make_name, name_eq}
use parser::parser::{parser_last_error_count}

fn unit_expr_factor_count(ty: TypeExpr) -> i64 with Mut, Panic, Div, Alloc {
    if ty.kind == TypeExprKind::TypeReference || ty.kind == TypeExprKind::TypeRefMut {
        var left_count: i64 = 1
        match ty.type_args {
            Some(args) => {
                left_count = unit_expr_factor_count((*args).head)
            }
            None => {}
        }
        match ty.inner {
            Some(inner) => left_count + unit_expr_factor_count(*inner)
            None => left_count
        }
    } else {
        1
    }
}

fn unit_expr_binary_count(ty: TypeExpr) -> i64 with Mut, Panic, Div, Alloc {
    if ty.kind == TypeExprKind::TypeReference || ty.kind == TypeExprKind::TypeRefMut {
        var left_count: i64 = 0
        match ty.type_args {
            Some(args) => {
                left_count = unit_expr_binary_count((*args).head)
            }
            None => {}
        }
        var right_count: i64 = 0
        match ty.inner {
            Some(inner) => {
                right_count = unit_expr_binary_count(*inner)
            }
            None => {}
        }
        1 + left_count + right_count
    } else {
        0
    }
}

fn unit_expr_has_left_payload(ty: TypeExpr) -> bool with Mut, Panic, Div, Alloc {
    if ty.kind == TypeExprKind::TypeReference || ty.kind == TypeExprKind::TypeRefMut {
        match ty.type_args {
            Some(args) => unit_expr_has_left_payload((*args).head)
            None => false
        }
    } else {
        true
    }
}

fn probe_items(items: Option<Box<ItemList> >, target: Name) -> i64 with IO, Mut, Panic, Div, Alloc {
    match items {
        None => -1
        Some(list) => {
            let item = (*list).head
            if item.kind == ItemKind::ItemUnit && name_eq(item.name, target) {
                match item.type_alias_ty {
                    None => -2
                    Some(expr) => {
                        let factors = unit_expr_factor_count(*expr)
                        let binaries = unit_expr_binary_count(*expr)
                        let has_left = unit_expr_has_left_payload(*expr)
                        print("unit_expr_factors=")
                        print_int(factors)
                        print(" unit_expr_binaries=")
                        print_int(binaries)
                        print(" unit_expr_has_left=")
                        if has_left {
                            print("1\n")
                        } else {
                            print("0\n")
                        }
                        if factors == 3 && binaries == 2 && has_left {
                            return 0
                        }
                        return 1
                    }
                }
            }
            probe_items((*list).tail, target)
        }
    }
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    var path = "tests/frontend/unit_derived_acceleration_chain_current_source.sio"
    if argc >= 1 {
        path = get_arg(0)
    }
    let items = lex_file_parse_items(path)
    if parser_last_error_count() > 0 {
        print("parse_errors=")
        print_int(parser_last_error_count())
        print("\n")
        return 2
    }
    let verdict = probe_items(items, make_name("acceleration"))
    print("unit_derived_ast_verdict=")
    print_int(verdict)
    print("\n")
    verdict
}
