use check::check::{Checker}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    print("k2_check_import_heap_checker_probe=start\n")
    print("k2_check_import_heap_checker_probe=alloc_enter\n")
    let checker = heap_alloc(262144) as *mut Checker
    print("k2_check_import_heap_checker_probe=alloc_ok\n")
    print("k2_check_import_heap_checker_probe=ok\n")
    return 0
}
