use knowledge_runtime_guard_directive::{
    knowledge_runtime_guard_directive_build_intent,
}

fn print_bool_digit(value: bool) with IO {
    if value {
        print("1")
    } else {
        print("0")
    }
}

fn main() -> i64 with IO, Mut, Panic, Div {
    let argc = arg_count()
    var path = "tests/frontend/knowledge_runtime_guard_directive_positive.sio"
    if argc >= 1 {
        path = get_arg(0)
    }

    let intent = knowledge_runtime_guard_directive_build_intent(path)
    print("knowledge_runtime_guard_directive_found=")
    print_bool_digit(intent.found)
    print(" count=")
    print_int(intent.count)
    print(" malformed=")
    print_bool_digit(intent.malformed)
    print(" malformed_count=")
    print_int(intent.malformed_count)
    print(" first_offset=")
    print_int(intent.first_offset)
    print(" pre_native_guard_expansion=")
    print_bool_digit(intent.enable_pre_native_guard_expansion)
    print(" native_lowering_ready=")
    print_bool_digit(intent.native_lowering_ready)
    print("\n")

    if intent.malformed {
        return 1
    }
    0
}
