// Madaros v2 S2 receipt contract fingerprints.
//
// S2 is the typed-HIR/effect declaration boundary. The current compiler does
// not yet expose a native typed HIR serializer, so this contract intentionally
// represents a scaffold: deterministic S1 linkage plus source-scan public
// symbol, import, effect, refinement, epistemic-declaration, and structured
// diagnostics tables.

pub fn madaros_v2_s2_schema_family() -> i64 {
    2201
}

pub fn madaros_v2_s2_schema_version() -> i64 {
    1
}

pub fn madaros_v2_s2_boundary_kind() -> i64 {
    21
}

pub fn madaros_v2_s2_mix(a: i64, b: i64) -> i64 with Mod {
    ((a * 1000003) + b) % 1000000007
}

pub fn madaros_v2_s2_contract_fingerprint() -> i64 with Mod {
    var fp = madaros_v2_s2_schema_family()
    fp = madaros_v2_s2_mix(fp, madaros_v2_s2_schema_version())
    fp = madaros_v2_s2_mix(fp, madaros_v2_s2_boundary_kind())
    fp = madaros_v2_s2_mix(fp, 128)
    fp
}

pub fn madaros_v2_s2_contract_accepts_l1(
    observed_modules: i64,
    public_symbols: i64,
    diagnostic_count: i64,
    compiler_check_rc: i64
) -> bool {
    observed_modules > 0
        && public_symbols >= 0
        && diagnostic_count >= 0
        && compiler_check_rc == 0
}
