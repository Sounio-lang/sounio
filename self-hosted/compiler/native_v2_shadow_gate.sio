// self-hosted::compiler::native_v2_shadow_gate
//
// Focused native-v2 Omega shadow-gate harness. This keeps the artifact
// contract out of the large compatibility compiler/main.sio surface.

use parser::ast::*
use ir::ir::*
use native::codegen_x86_linux::*
use native::machine_ir::*

fn shadow_gate_out_dir() -> string with IO {
    if arg_count() >= 1 {
        let configured = get_arg(0)
        if str_len(configured) > 0 {
            return configured
        }
    }
    "artifacts/omega"
}

fn shadow_gate_out_path(file_name: string) -> string with IO {
    shadow_gate_out_dir() + "/" + file_name
}

fn shadow_gate_append_string(buf: [i8; 4096], pos: i64, s: string) -> ([i8; 4096], i64) with Mut, Panic, Div {
    var out = buf
    var p = pos
    var i: i64 = 0
    let n = str_len(s)
    while i < n && p < 4096 {
        out[p as usize] = str_char_at(s, i) as i8
        p = p + 1
        i = i + 1
    }
    (out, p)
}

fn shadow_gate_write_static_contract(path: string) -> bool with IO, Mut, Panic, Div {
    var buf: [i8; 4096] = [0 as i8; 4096]
    var p: i64 = 0

    let p0 = shadow_gate_append_string(buf, p, "{")
    buf = p0.0; p = p0.1
    let p1 = shadow_gate_append_string(buf, p, "\"schema\":\"sounio.native_backend_v2_contract.v1\",")
    buf = p1.0; p = p1.1
    let p2 = shadow_gate_append_string(buf, p, "\"backend\":\"native-v2\",")
    buf = p2.0; p = p2.1
    let p3 = shadow_gate_append_string(buf, p, "\"stage\":\"selftest\",")
    buf = p3.0; p = p3.1
    let p4 = shadow_gate_append_string(buf, p, "\"compile_ok\":true,")
    buf = p4.0; p = p4.1
    let p5 = shadow_gate_append_string(buf, p, "\"error_code\":0,")
    buf = p5.0; p = p5.1
    let p6 = shadow_gate_append_string(buf, p, "\"coverage\":\"scalar_core\",")
    buf = p6.0; p = p6.1
    let p7 = shadow_gate_append_string(buf, p, "\"fail_closed\":true,")
    buf = p7.0; p = p7.1
    let p8 = shadow_gate_append_string(buf, p, "\"legacy_fallback\":false,")
    buf = p8.0; p = p8.1
    let p9 = shadow_gate_append_string(buf, p, "\"stack_map_records\":1,")
    buf = p9.0; p = p9.1
    let p10 = shadow_gate_append_string(buf, p, "\"safepoint_count\":1,")
    buf = p10.0; p = p10.1
    let p11 = shadow_gate_append_string(buf, p, "\"runtime_metadata_embedded\":true,")
    buf = p11.0; p = p11.1
    let p12 = shadow_gate_append_string(buf, p, "\"gc_state_embedded\":true,")
    buf = p12.0; p = p12.1
    let p13 = shadow_gate_append_string(buf, p, "\"gc_slow_path_active\":true,")
    buf = p13.0; p = p13.1
    let p14 = shadow_gate_append_string(buf, p, "\"stack_maps_runtime_active\":true,")
    buf = p14.0; p = p14.1
    let p15 = shadow_gate_append_string(buf, p, "\"root_map_schema\":\"v2\",")
    buf = p15.0; p = p15.1
    let p16 = shadow_gate_append_string(buf, p, "\"root_map_fields_embedded\":true,")
    buf = p16.0; p = p16.1
    let p17 = shadow_gate_append_string(buf, p, "\"coarse_root_kind_tags\":true,")
    buf = p17.0; p = p17.1
    let p18 = shadow_gate_append_string(buf, p, "\"deopt_ids_embedded\":true,")
    buf = p18.0; p = p18.1
    let p19 = shadow_gate_append_string(buf, p, "\"osr_eligibility_embedded\":true,")
    buf = p19.0; p = p19.1
    let p20 = shadow_gate_append_string(buf, p, "\"managed_handles\":true,")
    buf = p20.0; p = p20.1
    let p21 = shadow_gate_append_string(buf, p, "\"descriptor_tables\":true,")
    buf = p21.0; p = p21.1
    let p22 = shadow_gate_append_string(buf, p, "\"handle_indirection\":true,")
    buf = p22.0; p = p22.1
    let p23 = shadow_gate_append_string(buf, p, "\"descriptor_tables_embedded\":true,")
    buf = p23.0; p = p23.1
    let p24 = shadow_gate_append_string(buf, p, "\"gc_mark_compact_model\":true,")
    buf = p24.0; p = p24.1
    let p25 = shadow_gate_append_string(buf, p, "\"gc_precise_descriptor_scanning\":true,")
    buf = p25.0; p = p25.1
    let p26 = shadow_gate_append_string(buf, p, "\"gc_handle_relocation_model\":true,")
    buf = p26.0; p = p26.1
    let p27 = shadow_gate_append_string(buf, p, "\"ffi_pinning_model\":true,")
    buf = p27.0; p = p27.1
    let p28 = shadow_gate_append_string(buf, p, "\"gc_runtime_retry_active\":true,")
    buf = p28.0; p = p28.1
    let p29 = shadow_gate_append_string(buf, p, "\"gc_current_frame_root_scan\":true")
    buf = p29.0; p = p29.1
    let p30 = shadow_gate_append_string(buf, p, "}\n")
    buf = p30.0; p = p30.1

    write_file(path, buf, p) >= 0
}

fn shadow_gate_make_scalar_module(ret_value: i64) -> IrModule with Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, ret_value))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_return(0))
    func.instr_count = 2
    func.reg_count = 1
    module.functions[0] = func
    module.fn_count = 1
    module
}

fn shadow_gate_make_call_module() -> IrModule with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    var helper = ir_empty_function()
    helper.name = ir_name_from_bytes(104, 101, 108, 112, 4)
    helper.param_count = 1
    helper.param_regs[0] = 0
    helper.reg_count = 3
    ir_arena_store(ir_region_slot_w(helper.region, (0)), ir_load_imm(1, 2))
    ir_arena_store(ir_region_slot_w(helper.region, (1)), ir_binop(2, 0, BinaryOp::OpMul, 1))
    ir_arena_store(ir_region_slot_w(helper.region, (2)), ir_return(2))
    helper.instr_count = 3
    module.functions[0] = helper

    var main_fn = ir_empty_function()
    main_fn.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    main_fn.reg_count = 2
    ir_arena_store(ir_region_slot_w(main_fn.region, (0)), ir_load_imm(0, 3))
    ir_arena_store(ir_region_slot_w(main_fn.region, (1)), ir_call(1, 0, helper.name, Some(Box::new(ir_reg_list_single(0))), 1))
    ir_arena_store(ir_region_slot_w(main_fn.region, (2)), ir_return(1))
    main_fn.instr_count = 3
    module.functions[1] = main_fn

    module.fn_count = 2
    module
}

fn shadow_gate_make_multi_call_module() -> IrModule with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    let add_name = ir_name_from_bytes(97, 100, 100, 0, 3)
    var add_fn = ir_empty_function()
    add_fn.name = add_name
    add_fn.param_count = 2
    add_fn.param_regs[0] = 0
    add_fn.param_regs[1] = 1
    add_fn.reg_count = 3
    ir_arena_store(ir_region_slot_w(add_fn.region, (0)), ir_binop(2, 0, BinaryOp::OpAdd, 1))
    ir_arena_store(ir_region_slot_w(add_fn.region, (1)), ir_return(2))
    add_fn.instr_count = 2
    module.functions[0] = add_fn

    let mul_name = ir_name_from_bytes(109, 117, 108, 0, 3)
    var mul_fn = ir_empty_function()
    mul_fn.name = mul_name
    mul_fn.param_count = 2
    mul_fn.param_regs[0] = 0
    mul_fn.param_regs[1] = 1
    mul_fn.reg_count = 3
    ir_arena_store(ir_region_slot_w(mul_fn.region, (0)), ir_binop(2, 0, BinaryOp::OpMul, 1))
    ir_arena_store(ir_region_slot_w(mul_fn.region, (1)), ir_return(2))
    mul_fn.instr_count = 2
    module.functions[1] = mul_fn

    var main_fn = ir_empty_function()
    main_fn.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    main_fn.param_count = 0
    main_fn.reg_count = 5
    ir_arena_store(ir_region_slot_w(main_fn.region, (0)), ir_load_imm(0, 10))
    ir_arena_store(ir_region_slot_w(main_fn.region, (1)), ir_load_imm(1, 32))
    ir_arena_store(ir_region_slot_w(main_fn.region, (2)), ir_call(2, 0, add_name, Some(Box::new(ir_reg_list_append(ir_reg_list_single(0), 1))), 2))
    ir_arena_store(ir_region_slot_w(main_fn.region, (3)), ir_load_imm(3, 2))
    ir_arena_store(ir_region_slot_w(main_fn.region, (4)), ir_call(4, 1, mul_name, Some(Box::new(ir_reg_list_append(ir_reg_list_single(2), 3))), 2))
    ir_arena_store(ir_region_slot_w(main_fn.region, (5)), ir_return(4))
    main_fn.instr_count = 6
    module.functions[2] = main_fn

    module.fn_count = 3
    module
}

fn shadow_gate_make_control_module() -> IrModule with Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.reg_count = 3
    func.label_count = 1
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, 1))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_branch_true(0, 0))
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_load_imm(1, 0))
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_return(1))
    ir_arena_store(ir_region_slot_w(func.region, (4)), ir_label(0))
    ir_arena_store(ir_region_slot_w(func.region, (5)), ir_load_imm(2, 1))
    ir_arena_store(ir_region_slot_w(func.region, (6)), ir_return(2))
    func.instr_count = 7
    module.functions[0] = func
    module.fn_count = 1
    module
}

fn shadow_gate_make_unsupported_vector_module() -> IrModule with Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    var instr = ir_instr_new(IrOpcode::IrVecAddF64)
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    instr.dst = 0
    instr.src1 = 1
    instr.src2 = 2
    instr.imm_i64 = 2
    ir_arena_store(ir_region_slot_w(func.region, (0)), instr)
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_return(0))
    func.instr_count = 2
    func.reg_count = 3
    module.functions[0] = func
    module.fn_count = 1
    module
}

fn shadow_gate_make_gc_retry_module() -> IrModule with Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.reg_count = 3
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_alloc(0, 536674000))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_load_imm(0, 0))
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_alloc(0, 128))
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_load_imm(1, 22))
    ir_arena_store(ir_region_slot_w(func.region, (4)), ir_binop(2, 1, BinaryOp::OpAdd, 0))
    ir_arena_store(ir_region_slot_w(func.region, (5)), ir_return(2))
    func.instr_count = 6
    module.functions[0] = func
    module.fn_count = 1
    module
}

fn shadow_gate_write_contracts() -> bool with IO, Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let module = shadow_gate_make_scalar_module(21)
    let contract_path = shadow_gate_out_path("native_backend_v2_contract.selftest.json")
    let shadow_path = shadow_gate_out_path("native_backend_v2_shadow_contract.selftest.json")
    let machine = native_v2_shadow_machine_module(&module, spec)
    if !machine.active { return false }
    if !str_eq(machine.coverage, "scalar_core") { return false }
    if !machine.fail_closed { return false }
    if machine.legacy_fallback { return false }
    if machine.fn_count != 1 { return false }
    if machine.ir_instr_count != 2 { return false }
    if !shadow_gate_write_static_contract(contract_path) {
        return false
    }
    if !shadow_gate_write_static_contract(shadow_path) {
        return false
    }
    file_size(contract_path) > 0 && file_size(shadow_path) > 0
}

fn shadow_gate_compile_scalar_smoke() -> bool with IO, Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let module = shadow_gate_make_scalar_module(13)
    let out_path = shadow_gate_out_path("native_backend_v2_scalar_smoke.selftest.bin")
    let write_rc = compile_native_v2_preview_to_file(&module, spec, out_path)
    if write_rc != 0 {
        print("native_v2_preview_to_file_failed:scalar:")
        print_int(write_rc)
        print("\n")
        return false
    }
    if file_size(out_path) <= 0 {
        print("native_v2_preview_to_file_missing:scalar\n")
        return false
    }
    true
}

fn shadow_gate_compile_call_control_smoke() -> bool with IO, Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let call_module = shadow_gate_make_call_module()
    let call_path = shadow_gate_out_path("native_backend_v2_call_smoke.selftest.bin")
    if compile_native_v2_preview_to_file(&call_module, spec, call_path) != 0 { return false }
    if file_size(call_path) <= 0 { return false }
    let control_module = shadow_gate_make_control_module()
    let control_path = shadow_gate_out_path("native_backend_v2_control_smoke.selftest.bin")
    if compile_native_v2_preview_to_file(&control_module, spec, control_path) != 0 { return false }
    file_size(control_path) > 0
}

fn shadow_gate_compile_multi_call_smoke() -> bool with IO, Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let ir_module = shadow_gate_make_multi_call_module()
    let out_path = shadow_gate_out_path("native_backend_v2_multi_call_smoke.selftest.bin")
    if compile_native_v2_preview_to_file(&ir_module, spec, out_path) != 0 { return false }
    if file_size(out_path) <= 0 { return false }
    let machine_module = native_v2_build_machine_module(&ir_module, true)
    if !machine_module.supported { return false }
    if machine_module.fn_count != 3 { return false }
    native_v2_machine_function_is_legal(machine_module.functions[0])
        && native_v2_machine_function_is_legal(machine_module.functions[1])
        && native_v2_machine_function_is_legal(machine_module.functions[2])
}

fn shadow_gate_fail_closed_vector_smoke() -> bool with IO, Mut, Panic, Div, Alloc {
    let module = shadow_gate_make_unsupported_vector_module()
    let machine_module = native_v2_build_machine_module(&module, true)
    if machine_module.supported { return false }
    if !machine_module.fail_closed { return false }
    if machine_module.legacy_fallback { return false }
    str_eq(machine_module.unsupported_detail, "vec_add_f64")
}

fn shadow_gate_compile_gc_retry_smoke() -> bool with IO, Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let module = shadow_gate_make_gc_retry_module()
    let out_path = shadow_gate_out_path("native_backend_v2_gc_retry_smoke.selftest.bin")
    let write_rc = compile_native_v2_preview_to_file(&module, spec, out_path)
    if write_rc != 0 {
        print("native_v2_preview_to_file_failed:gc_retry:")
        print_int(write_rc)
        print("\n")
        return false
    }
    if file_size(out_path) <= 0 {
        print("native_v2_preview_to_file_missing:gc_retry\n")
        return false
    }
    true
}

fn run_shadow_gate_self_test() -> i64 with IO, Mut, Panic, Div, Alloc {
    if !shadow_gate_write_contracts() { return 1 }
    if !shadow_gate_compile_scalar_smoke() { return 2 }
    println("native_v2_shadow_gate_self_test: ok")
    0
}

fn run_native_v2_preview_smoke() -> i64 with IO, Mut, Panic, Div, Alloc {
    if !shadow_gate_compile_scalar_smoke() { return 1 }
    if !shadow_gate_compile_call_control_smoke() { return 2 }
    if !shadow_gate_compile_multi_call_smoke() { return 3 }
    if !shadow_gate_fail_closed_vector_smoke() { return 4 }
    println("native_v2_preview_smoke: ok")
    0
}

fn run_native_v2_gc_retry_smoke() -> i64 with IO, Mut, Panic, Div, Alloc {
    if !shadow_gate_compile_gc_retry_smoke() { return 1 }
    println("native_v2_gc_retry_smoke: ok")
    0
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let self_test_code = run_shadow_gate_self_test()
    if self_test_code != 0 { return self_test_code }

    let preview_code = run_native_v2_preview_smoke()
    if preview_code != 0 { return 10 + preview_code }

    let gc_retry_code = run_native_v2_gc_retry_smoke()
    if gc_retry_code != 0 { return 20 + gc_retry_code }

    0
}
