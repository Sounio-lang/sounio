fn shadow_gate_make_call9_module() -> IrModule with Mut, Panic, Div, Alloc {
    var module = shadow_gate_make_call8_module()
    let add8_name = module.functions[0].name
    var main_fn = module.functions[1]
    main_fn.reg_count = 10
    main_fn.instrs[8] = ir_load_imm(8, 1)
    let args9 = Some(Box::new(ir_reg_list_append(ir_reg_list_append(ir_reg_list_append(ir_reg_list_append(ir_reg_list_append(ir_reg_list_append(ir_reg_list_append(ir_reg_list_append(ir_reg_list_single(0), 1), 2), 3), 4), 5), 6), 7), 8)))
    main_fn.instrs[9] = ir_call(9, 0, add8_name, args9, 9)
    main_fn.instrs[10] = ir_return(9)
    main_fn.instr_count = 11
    module.functions[1] = main_fn
    module
}

fn shadow_gate_make_control_module() -> IrModule with Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.reg_count = 3
    func.label_count = 1
    func.instrs[0] = ir_load_imm(0, 1)
    func.instrs[1] = ir_branch_true(0, 0)
    func.instrs[2] = ir_load_imm(1, 0)
    func.instrs[3] = ir_return(1)
    func.instrs[4] = ir_label(0)
    func.instrs[5] = ir_load_imm(2, 1)
    func.instrs[6] = ir_return(2)
    func.instr_count = 7
    module.functions[0] = func
    module.fn_count = 1
    module
}

fn shadow_gate_make_unsupported_vector_module() -> IrModule with Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    var instr = ir_instr_new(IrOpcode::IrVecAddF64)
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    instr.dst = 0
    instr.src1 = 1
    instr.src2 = 2
    instr.imm_i64 = 2
    func.instrs[0] = instr
    func.instrs[1] = ir_return(0)
    func.instr_count = 2
    func.reg_count = 3
    module.functions[0] = func
    module.fn_count = 1
    module
}

fn shadow_gate_make_gc_retry_module() -> IrModule with Mut, Panic, Div {
    var module = ir_empty_module()
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    func.reg_count = 3
    func.instrs[0] = ir_alloc(0, 536674000)
    func.instrs[1] = ir_load_imm(0, 0)
    func.instrs[2] = ir_alloc(0, 128)
    func.instrs[3] = ir_load_imm(1, 22)
    func.instrs[4] = ir_binop(2, 1, BinaryOp::OpAdd, 0)
    func.instrs[5] = ir_return(2)
    func.instr_count = 6
    module.functions[0] = func
    module.fn_count = 1
    module
}

fn shadow_gate_write_contracts() -> bool with IO, Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let module = shadow_gate_make_scalar_module(21)
    let contract_path = shadow_gate_out_path("native_backend_v2_contract.selftest.json")
    let shadow_path = shadow_gate_out_path("native_backend_v2_shadow_contract.selftest.json")
    let machine = native_v2_shadow_machine_module(&module, spec)
    if !machine.active { return false }
    if !str_eq(machine.coverage, "scalar_core") { return false }
    if !machine.fail_closed { return false }
    if machine.legacy_fallback { return false }
    if machine.fn_count != 1 { return false }
    if machine.ir_instr_count != 2 { return false }
    if !shadow_gate_write_static_contract(contract_path) {
        return false
    }
    if !shadow_gate_write_static_contract(shadow_path) {
        return false
    }
    file_size(contract_path) > 0 && file_size(shadow_path) > 0
}

fn shadow_gate_compile_scalar_smoke() -> bool with IO, Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let module = shadow_gate_make_scalar_module(13)
    let out_path = shadow_gate_out_path("native_backend_v2_scalar_smoke.selftest.bin")
    let write_rc = compile_native_v2_preview_to_file(&module, spec, out_path)
    if write_rc != 0 {
        print("native_v2_preview_to_file_failed:scalar:")
        print_int(write_rc)
        print("\n")
        return false
    }
    if file_size(out_path) <= 0 {
        print("native_v2_preview_to_file_missing:scalar\n")
        return false
    }
    true
}

fn shadow_gate_compile_call_control_smoke() -> bool with IO, Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let call_module = shadow_gate_make_call_module()
    let call_path = shadow_gate_out_path("native_backend_v2_call_smoke.selftest.bin")
    if compile_native_v2_preview_to_file(&call_module, spec, call_path) != 0 { return false }
    if file_size(call_path) <= 0 { return false }
    let control_module = shadow_gate_make_control_module()
    let control_path = shadow_gate_out_path("native_backend_v2_control_smoke.selftest.bin")
    if compile_native_v2_preview_to_file(&control_module, spec, control_path) != 0 { return false }
    file_size(control_path) > 0
}

fn shadow_gate_compile_multi_call_smoke() -> bool with IO, Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let ir_module = shadow_gate_make_multi_call_module()
    let out_path = shadow_gate_out_path("native_backend_v2_multi_call_smoke.selftest.bin")
    if compile_native_v2_preview_to_file(&ir_module, spec, out_path) != 0 { return false }
    if file_size(out_path) <= 0 { return false }
    let machine_module = native_v2_build_machine_module(&ir_module, true)
    if !machine_module.supported { return false }
    if machine_module.fn_count != 3 { return false }
    native_v2_machine_function_is_legal(machine_module.functions[0])
        && native_v2_machine_function_is_legal(machine_module.functions[1])
        && native_v2_machine_function_is_legal(machine_module.functions[2])
}

fn shadow_gate_machine_function_is_legal_at(module: &MachineModule, fn_index: i64) -> bool with Mut, Panic, Div {
    if fn_index < 0 || fn_index >= (*module).fn_count { return false }
    (*module).functions[fn_index as usize].supported && (*module).functions[fn_index as usize].legal_instr_count > 0
}

fn shadow_gate_stack_arg_shape_ok(module: &MachineModule, fn_index: i64, push_count: i64, first_arg: i64, last_arg: i64, argc: i64) -> bool with Mut, Panic, Div {
    if fn_index < 0 || fn_index >= (*module).fn_count { return false }
    (*module).functions[fn_index as usize].stack_arg_push_count == push_count &&
        (*module).functions[fn_index as usize].first_stack_arg_index == first_arg &&
        (*module).functions[fn_index as usize].last_stack_arg_index == last_arg &&
        (*module).functions[fn_index as usize].max_call_arg_count == argc
}

fn shadow_gate_print_stack_arg_shape(module: &MachineModule, fn_index: i64) with IO, Mut, Panic, Div {
    if fn_index < 0 || fn_index >= (*module).fn_count { return }
    print(" pushes=")
    print_int((*module).functions[fn_index as usize].stack_arg_push_count)
    print(" first=")
    print_int((*module).functions[fn_index as usize].first_stack_arg_index)
    print(" last=")
    print_int((*module).functions[fn_index as usize].last_stack_arg_index)
    print(" max_argc=")
    print_int((*module).functions[fn_index as usize].max_call_arg_count)
    print(" legal=")
    print_int((*module).functions[fn_index as usize].legal_instr_count)
    print("\n")
}

fn shadow_gate_machine_ir_stack_arg_smoke() -> bool with IO, Mut, Panic, Div, Alloc {
    let call7_module = shadow_gate_make_call7_module()
    let call7_machine = native_v2_build_machine_module(&call7_module, true)
    if !call7_machine.supported { print("native_v2_machine_ir_stack_args: fail call7 unsupported "); print(call7_machine.unsupported_detail); print("\n"); return false }
    if call7_machine.fn_count != 2 { print("native_v2_machine_ir_stack_args: fail call7 fn_count\n"); return false }
    if !shadow_gate_machine_function_is_legal_at(&call7_machine, 0) { print("native_v2_machine_ir_stack_args: fail call7 callee illegal\n"); return false }
    if !shadow_gate_machine_function_is_legal_at(&call7_machine, 1) { print("native_v2_machine_ir_stack_args: fail call7 caller illegal\n"); return false }
    if !shadow_gate_stack_arg_shape_ok(&call7_machine, 1, 1, 6, 6, 7) { print("native_v2_machine_ir_stack_args: fail call7 stack push"); shadow_gate_print_stack_arg_shape(&call7_machine, 1); return false }

    let sparse_module = shadow_gate_make_call7_sparse_module()
    let sparse_machine = native_v2_build_machine_module(&sparse_module, true)
    if !sparse_machine.supported { print("native_v2_machine_ir_stack_args: fail sparse unsupported "); print(sparse_machine.unsupported_detail); print("\n"); return false }
    if sparse_machine.fn_count != 2 { print("native_v2_machine_ir_stack_args: fail sparse fn_count\n"); return false }
    if !shadow_gate_machine_function_is_legal_at(&sparse_machine, 0) { print("native_v2_machine_ir_stack_args: fail sparse callee illegal\n"); return false }
    if !shadow_gate_machine_function_is_legal_at(&sparse_machine, 1) { print("native_v2_machine_ir_stack_args: fail sparse caller illegal\n"); return false }
    if !shadow_gate_stack_arg_shape_ok(&sparse_machine, 1, 1, 6, 6, 7) { print("native_v2_machine_ir_stack_args: fail sparse stack push\n"); return false }

    let call8_module = shadow_gate_make_call8_module()
    let call8_machine = native_v2_build_machine_module(&call8_module, true)
    if !call8_machine.supported { print("native_v2_machine_ir_stack_args: fail call8 unsupported "); print(call8_machine.unsupported_detail); print("\n"); return false }
    if call8_machine.fn_count != 2 { print("native_v2_machine_ir_stack_args: fail call8 fn_count\n"); return false }
    if !shadow_gate_machine_function_is_legal_at(&call8_machine, 0) { print("native_v2_machine_ir_stack_args: fail call8 callee illegal\n"); return false }
    if !shadow_gate_machine_function_is_legal_at(&call8_machine, 1) { print("native_v2_machine_ir_stack_args: fail call8 caller illegal\n"); return false }
    if !shadow_gate_stack_arg_shape_ok(&call8_machine, 1, 2, 7, 6, 8) { print("native_v2_machine_ir_stack_args: fail call8 stack push order\n"); return false }

    let call9_module = shadow_gate_make_call9_module()
    let call9_machine = native_v2_build_machine_module(&call9_module, true)
    if call9_machine.supported { print("native_v2_machine_ir_stack_args: fail call9 supported\n"); return false }
    if !call9_machine.fail_closed { print("native_v2_machine_ir_stack_args: fail call9 not fail_closed\n"); return false }
    if call9_machine.legacy_fallback { print("native_v2_machine_ir_stack_args: fail call9 fallback\n"); return false }
    str_eq(call9_machine.unsupported_detail, "call_arity_gt_8")
}

fn shadow_gate_fail_closed_vector_smoke() -> bool with IO, Mut, Panic, Div, Alloc {
    let module = shadow_gate_make_unsupported_vector_module()
    let machine_module = native_v2_build_machine_module(&module, true)
    if machine_module.supported { return false }
    if !machine_module.fail_closed { return false }
    if machine_module.legacy_fallback { return false }
    str_eq(machine_module.unsupported_detail, "vec_add_f64")
}

fn shadow_gate_compile_gc_retry_smoke() -> bool with IO, Mut, Panic, Div, Alloc {
    let spec = native_resolve_target("x86_64-linux", "auto", true)
    let module = shadow_gate_make_gc_retry_module()
    let out_path = shadow_gate_out_path("native_backend_v2_gc_retry_smoke.selftest.bin")
    let write_rc = compile_native_v2_preview_to_file(&module, spec, out_path)
    if write_rc != 0 {
        print("native_v2_preview_to_file_failed:gc_retry:")
        print_int(write_rc)
        print("\n")
        return false
    }
    if file_size(out_path) <= 0 {
        print("native_v2_preview_to_file_missing:gc_retry\n")
        return false
    }
    true
}

fn run_shadow_gate_self_test() -> i64 with IO, Mut, Panic, Div, Alloc {
    if !shadow_gate_write_contracts() { return 1 }
    if !shadow_gate_compile_scalar_smoke() { return 2 }
    if !shadow_gate_machine_ir_stack_arg_smoke() { return 3 }
    println("native_v2_machine_ir_stack_args: ok")
    println("native_v2_shadow_gate_self_test: ok")
    0
}

fn run_native_v2_preview_smoke() -> i64 with IO, Mut, Panic, Div, Alloc {
    if !shadow_gate_compile_scalar_smoke() { return 1 }
    if !shadow_gate_compile_call_control_smoke() { return 2 }
    if !shadow_gate_compile_multi_call_smoke() { return 3 }
    if !shadow_gate_fail_closed_vector_smoke() { return 4 }
    println("native_v2_preview_smoke: ok")
    0
}

fn run_native_v2_gc_retry_smoke() -> i64 with IO, Mut, Panic, Div, Alloc {
    if !shadow_gate_compile_gc_retry_smoke() { return 1 }
    println("native_v2_gc_retry_smoke: ok")
    0
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let self_test_code = run_shadow_gate_self_test()
    if self_test_code != 0 { return self_test_code }

    let preview_code = run_native_v2_preview_smoke()
    if preview_code != 0 { return 10 + preview_code }

    let gc_retry_code = run_native_v2_gc_retry_smoke()
    if gc_retry_code != 0 { return 20 + gc_retry_code }

    0
}
