    add7_fn.instrs[1] = ir_binop(8, 7, BinaryOp::OpAdd, 2)
    add7_fn.instrs[2] = ir_binop(9, 8, BinaryOp::OpAdd, 3)
    add7_fn.instrs[3] = ir_binop(10, 9, BinaryOp::OpAdd, 4)
