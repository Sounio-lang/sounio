// self-hosted/compiler/pkg/lock.sio
//
// sounio.lock — Lock file do Sounio Package Manager.
//
// Garante builds reproduzíveis: cada dependência tem versão exata
// + digest SHA-256. Legacy epistemic fields remain read-compatible only.
//
// Formato (TOML-like, gerado automaticamente):
//
//   # sounio.lock — generated by souc pkg build, do not edit manually
//   # generated: 2026-04-20T12:00:00Z
//   # souc: 0.1.0
//
//   [[package]]
//   name = "epistemic-core"
//   version = "0.1.0"
//   source = "registry+https://registry.sounio.org"
//   sha256 = "a1b2c3..."
// Referências:
//   - Cargo.lock (Rust) — formato de referência para reproducibilidade
//   - SLSA Provenance L2 — SHA-256 + source URL
//   - W3C PROV-DM — provenance records are separate from assurance

// ============================================================================
// CONSTANTES
// ============================================================================

let LOCK_MAX_ENTRIES: i64   = 64
let LOCK_NAME_LEN: i64      = 64
let LOCK_VER_LEN: i64       = 32
let LOCK_SHA256_LEN: i64    = 64
let LOCK_SOURCE_LEN: i64    = 128
let LOCK_FILE_NAME: &str    = "sounio.lock"
let LOCK_VERSION: &str      = "1"

// Source types
let LOCK_SOURCE_REGISTRY: i64 = 0   // registry+https://...
let LOCK_SOURCE_GIT:      i64 = 1   // git+https://...
let LOCK_SOURCE_PATH:     i64 = 2   // path+../local

// ============================================================================
// TIPOS
// ============================================================================

struct LockEntry {
    name:              [i8; 64],
    name_len:          i64,
    version:           [i8; 32],
    version_len:       i64,
    sha256:            [i8; 64],
    sha256_len:        i64,
    source:            [i8; 128],
    source_len:        i64,
    source_type:       i64,
    epistemic_score:   f64,     // 0.0–1.0
    gum_compliant:     bool,
    regulatory_ready:  bool,
}

struct SouniuLock {
    entries:       [LockEntry; 64],
    entry_count:   i64,
    souc_version:  [i8; 32],
    souc_ver_len:  i64,
    lock_version:  i64,         // format version
    valid:         bool,
}

fn lock_entry_zero() -> LockEntry {
    LockEntry {
        name:             [0; 64],
        name_len:         0,
        version:          [0; 32],
        version_len:      0,
        sha256:           [0; 64],
        sha256_len:       0,
        source:           [0; 128],
        source_len:       0,
        source_type:      LOCK_SOURCE_REGISTRY,
        epistemic_score:  0.0,
        gum_compliant:    false,
        regulatory_ready: false,
    }
}

pub fn sounio_lock_new() -> SouniuLock {
    SouniuLock {
        entries:      [lock_entry_zero(); 64],
        entry_count:  0,
        souc_version: [0; 32],
        souc_ver_len: 0,
        lock_version: 1,
        valid:        true,
    }
}

// ============================================================================
// HELPERS: escreve buffer i8 como string em stdout
// ============================================================================

fn lock_print_buf64(buf: &[i8; 64], len: i64) with IO, Mut, Panic {
    var i: i64 = 0
    while i < len {
        print_char((*buf)[i as usize] as i64)
        i = i + 1
    }
}

fn lock_print_buf32(buf: &[i8; 32], len: i64) with IO, Mut, Panic {
    var i: i64 = 0
    while i < len {
        print_char((*buf)[i as usize] as i64)
        i = i + 1
    }
}

fn lock_print_buf128(buf: &[i8; 128], len: i64) with IO, Mut, Panic {
    var i: i64 = 0
    while i < len {
        print_char((*buf)[i as usize] as i64)
        i = i + 1
    }
}

// Escreve f64 com 2 casas decimais inline
fn lock_print_f64_2(x: f64) with IO, Mut, Panic, Div {
    let int_part = x as i64
    let frac = ((x - int_part as f64) * 100.0) as i64
    print_int(int_part)
    print(".")
    if frac < 10 { print("0") }
    print_int(frac)
}

// ============================================================================
// ADICIONAR ENTRADA
// ============================================================================

pub fn lock_add_from_manifest_dep(
    lock:          &!SouniuLock,
    name:          &str,
    version:       &str,
    sha256:        &str,
    epistemic_pct: i64,     // 0–100
    gum_compliant: bool,
    regulatory:    bool,
    use_registry:  bool
) with Mut, Panic {
    if (*lock).entry_count >= LOCK_MAX_ENTRIES - 1 { return }

    let idx = (*lock).entry_count as usize
    var entry = lock_entry_zero()

    // name
    let nn = str_len(*name)
    var ni: i64 = 0
    while ni < nn && ni < 63 {
        entry.name[ni as usize] = str_char_at(*name, ni) as i8
        ni = ni + 1
    }
    entry.name_len = ni

    // version
    let vn = str_len(*version)
    var vi: i64 = 0
    while vi < vn && vi < 31 {
        entry.version[vi as usize] = str_char_at(*version, vi) as i8
        vi = vi + 1
    }
    entry.version_len = vi

    // sha256
    let sn = str_len(*sha256)
    var si: i64 = 0
    while si < sn && si < 63 {
        entry.sha256[si as usize] = str_char_at(*sha256, si) as i8
        si = si + 1
    }
    entry.sha256_len = si

    // source
    let src = if use_registry {
        "registry+https://registry.sounio.org"
    } else {
        "path+local"
    }
    let srcn = str_len(*src)
    var sri: i64 = 0
    while sri < srcn && sri < 127 {
        entry.source[sri as usize] = str_char_at(*src, sri) as i8
        sri = sri + 1
    }
    entry.source_len = sri
    entry.source_type = if use_registry { LOCK_SOURCE_REGISTRY } else { LOCK_SOURCE_PATH }

    entry.epistemic_score  = epistemic_pct as f64 / 100.0
    entry.gum_compliant    = gum_compliant
    entry.regulatory_ready = regulatory

    (*lock).entries[idx] = entry
    (*lock).entry_count = (*lock).entry_count + 1
}

// ============================================================================
// SERIALIZAÇÃO → sounio.lock (stdout)
// ============================================================================

// Emite o conteúdo de sounio.lock para stdout.
// Em produção: redirecionar para write_file quando disponível.
pub fn lock_emit(lock: &SouniuLock) with IO, Mut, Panic, Div {
    println("# sounio.lock — generated by souc pkg build, do not edit manually")
    println("# lock-version = \"" + *LOCK_VERSION + "\"")
    println("")

    var i: i64 = 0
    while i < (*lock).entry_count {
        let e = &(*lock).entries[i as usize]
        println("[[package]]")

        print("name = \"")
        lock_print_buf64(&(*e).name, (*e).name_len)
        println("\"")

        print("version = \"")
        lock_print_buf32(&(*e).version, (*e).version_len)
        println("\"")

        print("source = \"")
        lock_print_buf128(&(*e).source, (*e).source_len)
        println("\"")

        print("sha256 = \"")
        lock_print_buf64(&(*e).sha256, (*e).sha256_len)
        println("\"")

        println("")
        i = i + 1
    }
}

// ============================================================================
// PARSER DE sounio.lock
// ============================================================================

// Parseia conteúdo de sounio.lock lido do disco.
pub fn lock_parse(content: &str) -> SouniuLock with Panic, Div, Mut {
    var lock = sounio_lock_new()
    lock.entry_count = 0

    let total = str_len(*content)
    var pos: i64 = 0
    var in_pkg: bool = false

    while pos < total {
        var eol = pos
        while eol < total && str_char_at(*content, eol) as i64 != 10 { eol = eol + 1 }

        let line = str_slice(*content, pos, eol)
        pos = eol + 1

        let ln = str_len(*line)
        if ln == 0 { continue }
        let fc = str_char_at(*line, 0) as i64
        if fc == 35 { continue }   // '#' comment

        // Detecta [[package]]
        if ln >= 11 && fc == 91 {
            if str_char_at(*line, 1) as i64 == 91 {
                if lock.entry_count < LOCK_MAX_ENTRIES - 1 {
                    lock.entry_count = lock.entry_count + 1
                }
                in_pkg = true
            }
            continue
        }

        if !in_pkg || lock.entry_count == 0 { continue }

        let idx = (lock.entry_count - 1) as usize

        // Parse "key = value" / "key = \"value\""
        var ep = 0
        while ep < ln && str_char_at(*line, ep) as i64 != 61 { ep = ep + 1 }
        if ep >= ln { continue }

        var ke = ep
        while ke > 0 && (str_char_at(*line, ke - 1) as i64 == 32 || str_char_at(*line, ke - 1) as i64 == 9) { ke = ke - 1 }

        var vs = ep + 1
        while vs < ln && (str_char_at(*line, vs) as i64 == 32 || str_char_at(*line, vs) as i64 == 9) { vs = vs + 1 }

        var ve = ln
        let quoted = vs < ln && str_char_at(*line, vs) as i64 == 34
        if quoted {
            vs = vs + 1
            ve = vs
            while ve < ln && str_char_at(*line, ve) as i64 != 34 { ve = ve + 1 }
        } else {
            while ve > vs && (str_char_at(*line, ve - 1) as i64 == 32 || str_char_at(*line, ve - 1) as i64 == 9) { ve = ve - 1 }
        }

        // key discriminant
        if ke - 0 == 4 && str_char_at(*line, 0) as i64 == 110 {  // "name"
            var ni: i64 = 0
            while ni < ve - vs && ni < 63 {
                lock.entries[idx].name[ni as usize] = str_char_at(*line, vs + ni) as i8
                ni = ni + 1
            }
            lock.entries[idx].name_len = ni
        } else if ke - 0 == 7 && str_char_at(*line, 0) as i64 == 118 {  // "version"
            var vi: i64 = 0
            while vi < ve - vs && vi < 31 {
                lock.entries[idx].version[vi as usize] = str_char_at(*line, vs + vi) as i8
                vi = vi + 1
            }
            lock.entries[idx].version_len = vi
        } else if ke - 0 == 6 && str_char_at(*line, 0) as i64 == 115 {  // "sha256"
            var si: i64 = 0
            while si < ve - vs && si < 63 {
                lock.entries[idx].sha256[si as usize] = str_char_at(*line, vs + si) as i8
                si = si + 1
            }
            lock.entries[idx].sha256_len = si
        } else if ke - 0 == 16 && str_char_at(*line, 0) as i64 == 101 {  // "epistemic-score"
            let val_s = str_slice(*line, vs, ve)
            var sc: f64 = 0.0
            var fi: i64 = 0
            var in_frac = false
            var div: f64 = 1.0
            while fi < str_len(*val_s) {
                let c = str_char_at(*val_s, fi) as i64
                if c >= 48 && c <= 57 {
                    if in_frac {
                        sc = sc + (c - 48) as f64 / (div * 10.0)
                        div = div * 10.0
                    } else {
                        sc = sc * 10.0 + (c - 48) as f64
                    }
                } else if c == 46 { in_frac = true }
                fi = fi + 1
            }
            lock.entries[idx].epistemic_score = sc
        } else if ke - 0 == 13 && str_char_at(*line, 0) as i64 == 103 {  // "gum-compliant"
            lock.entries[idx].gum_compliant = str_char_at(*line, vs) as i64 == 116
        } else if ke - 0 == 16 && str_char_at(*line, 0) as i64 == 114 {  // "regulatory-ready"
            lock.entries[idx].regulatory_ready = str_char_at(*line, vs) as i64 == 116
        }
    }

    lock
}

// ============================================================================
// ESCRITA PARA ARQUIVO (via write_file builtin quando disponível)
// ============================================================================

// Constrói string do lock file para escrita
fn lock_build_string(lock: &SouniuLock) -> string with Mut, Panic, Div {
    var out = "# sounio.lock — generated by souc pkg build, do not edit manually\n"
    out = out + "# lock-version = \"" + *LOCK_VERSION + "\"\n\n"

    var i: i64 = 0
    while i < (*lock).entry_count {
        let e = &(*lock).entries[i as usize]

        out = out + "[[package]]\n"

        // name
        var name_s = ""
        var ni: i64 = 0
        while ni < (*e).name_len {
            name_s = name_s + str_slice(*" ", 0, 0)  // placeholder — concatenation workaround
            // Direct char append not available; use int_to_string for each char
            // For now, emit numeric repr in a simple way
            ni = ni + 1
        }
        // Simplified: emit all key=value via print helpers at emit time
        // Full string build requires char-by-char concat which is expensive.
        // For now, build string with available primitives.
        out = out + "name = \"" + lock_buf64_to_str(&(*e).name, (*e).name_len) + "\"\n"
        out = out + "version = \"" + lock_buf32_to_str(&(*e).version, (*e).version_len) + "\"\n"
        out = out + "sha256 = \"" + lock_buf64_to_str(&(*e).sha256, (*e).sha256_len) + "\"\n"
        out = out + "source = \"" + lock_buf128_to_str(&(*e).source, (*e).source_len) + "\"\n"
        out = out + "\n"

        i = i + 1
    }
    out
}

fn lock_buf64_to_str(buf: &[i8; 64], len: i64) -> string with Panic {
    str_slice_from_i8_64(buf, len)
}

fn lock_buf32_to_str(buf: &[i8; 32], len: i64) -> string with Panic {
    str_slice_from_i8_32(buf, len)
}

fn lock_buf128_to_str(buf: &[i8; 128], len: i64) -> string with Panic {
    str_slice_from_i8_128(buf, len)
}

// Converte buffer i8 para string usando str_char_at
fn str_slice_from_i8_64(buf: &[i8; 64], len: i64) -> string with Panic {
    var out = ""
    var i: i64 = 0
    while i < len {
        let c = (*buf)[i as usize] as i64
        out = out + str_from_char(c)
        i = i + 1
    }
    out
}

fn str_slice_from_i8_32(buf: &[i8; 32], len: i64) -> string with Panic {
    var out = ""
    var i: i64 = 0
    while i < len {
        let c = (*buf)[i as usize] as i64
        out = out + str_from_char(c)
        i = i + 1
    }
    out
}

fn str_slice_from_i8_128(buf: &[i8; 128], len: i64) -> string with Panic {
    var out = ""
    var i: i64 = 0
    while i < len {
        let c = (*buf)[i as usize] as i64
        out = out + str_from_char(c)
        i = i + 1
    }
    out
}

// Converte inteiro (char code) para string de 1 char
fn str_from_char(c: i64) -> string with Panic {
    // chars 32–126 (printable ASCII)
    let chars = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    if c >= 32 && c <= 126 {
        return str_slice(*chars, c - 32, c - 31)
    }
    "?"
}

fn lock_f64_to_str(x: f64) -> string with Mut, Panic, Div {
    let int_part = x as i64
    let frac = ((x - int_part as f64) * 100.0) as i64
    let frac_str = if frac < 10 { "0" + int_to_string(frac) } else { int_to_string(frac) }
    int_to_string(int_part) + "." + frac_str
}

// Escreve sounio.lock para arquivo (usa write_file builtin)
// Assinatura do builtin: write_file(path: string, data: string, len: i64) -> i32
pub fn lock_write(lock: &SouniuLock, path: &str) -> bool with IO, Mut, Panic, Div {
    let content = lock_build_string(lock)
    let n = str_len(*content)
    let ret = write_file(*path, *content, n)
    ret == 0
}

// ============================================================================
// SELF-TEST
// ============================================================================

pub fn lock_self_test() -> bool with IO, Mut, Panic, Div {
    var lock = sounio_lock_new()

    lock_add_from_manifest_dep(
        &!lock,
        &"epistemic-core", &"0.1.0",
        &"a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2",
        97, true, true, true
    )
    lock_add_from_manifest_dep(
        &!lock,
        &"stdlib-stats", &"0.3.1",
        &"beef0011beef0011beef0011beef0011beef0011beef0011beef0011beef0011",
        82, true, false, true
    )

    if lock.entry_count != 2 { return false }
    if !lock.entries[0].gum_compliant { return false }
    if lock.entries[1].regulatory_ready { return false }

    true
}
