// self-hosted/compiler/pkg/reader.sio
//
// File I/O para o Sounio Package Manager.
// Usa os builtins read_file / file_size disponíveis no compilador.

// ============================================================================
// TIPOS
// ============================================================================

struct PkgReadResult {
    content: string,  // conteúdo bruto do arquivo
    size:    i64,     // bytes lidos (0 = falhou)
    ok:      bool,
    error:   i64,     // 0=ok 1=not_found 2=too_large 3=empty
}

let PKG_READ_OK:        i64 = 0
let PKG_READ_NOT_FOUND: i64 = 1
let PKG_READ_TOO_LARGE: i64 = 2
let PKG_READ_EMPTY:     i64 = 3
let PKG_READ_MAX_SIZE:  i64 = 65536

fn pkg_read_result_empty() -> PkgReadResult {
    PkgReadResult { content: "", size: 0, ok: false, error: PKG_READ_NOT_FOUND }
}

// ============================================================================
// LEITURA REAL DE ARQUIVO (builtins: file_size, read_file)
// ============================================================================

pub fn pkg_read_file(path: &str) -> PkgReadResult with IO, Panic {
    var r = pkg_read_result_empty()

    let sz = file_size(*path)
    if sz <= 0 {
        r.error = PKG_READ_NOT_FOUND
        return r
    }
    if sz > PKG_READ_MAX_SIZE {
        r.error = PKG_READ_TOO_LARGE
        return r
    }

    let content = read_file(*path)
    let n = str_len(*content)
    if n == 0 {
        r.error = PKG_READ_EMPTY
        return r
    }

    r.content = *content
    r.size    = n
    r.ok      = true
    r.error   = PKG_READ_OK
    r
}

// ============================================================================
// HELPERS DE CAMINHO
// ============================================================================

// Resolve caminho para sounio.toml:
//   ""        → "sounio.toml"
//   "dir/"    → "dir/sounio.toml"
//   "foo.toml" → "foo.toml"
pub fn pkg_resolve_manifest_path(path: &str) -> string with Panic {
    let n = str_len(*path)
    if n == 0 { return "sounio.toml" }
    let last = str_char_at(*path, n - 1) as i64
    if last == 47 {   // '/'
        return *path + "sounio.toml"
    }
    *path
}

// ============================================================================
// SELF-TEST (sem IO real — testa apenas lógica de path)
// ============================================================================

pub fn pkg_reader_self_test() -> bool with Panic {
    let p1 = pkg_resolve_manifest_path(&"")
    if p1 != "sounio.toml" { return false }

    let p2 = pkg_resolve_manifest_path(&"my-pkg/")
    if p2 != "my-pkg/sounio.toml" { return false }

    let p3 = pkg_resolve_manifest_path(&"custom.toml")
    if p3 != "custom.toml" { return false }

    true
}
