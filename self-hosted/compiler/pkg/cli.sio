}

// ============================================================================
// DISPATCHER PRINCIPAL
// ============================================================================

pub fn run_pkg_cli(subcommand: &str, args: &str, extra: &str) with IO, Mut, Panic, Div {
    if *subcommand == "init" {
        let epistemic = *args == "--epistemic"
        run_pkg_init(epistemic)
        return
    }
    if *subcommand == "build" {
        let path = if str_len(*args) > 0 { *args } else { "sounio.toml" }
        run_pkg_build(&path)
        return
    }
    if *subcommand == "audit" {
        let path = if str_len(*args) > 0 { *args } else { "sounio.toml" }
        run_pkg_audit(&path)
        return
    }
    if *subcommand == "install" {
        run_pkg_install(args, extra)
        return
    }
    if *subcommand == "publish" {
        let dry = *args == "--dry-run"
        run_pkg_publish(dry)
        return
    }
    if *subcommand == "info" {
        run_pkg_info(args)
        return
    }
    if *subcommand == "self-test" {
        var all_ok = true

        let scorer_ok = pkg_scorer_self_test()
        print("[pkg] scorer: ")
        if scorer_ok { println("PASS") } else { println("FAIL"); all_ok = false }

        let reader_ok = pkg_reader_self_test()
        print("[pkg] reader: ")
        if reader_ok { println("PASS") } else { println("FAIL"); all_ok = false }

        let lock_ok = lock_self_test()
        print("[pkg] lock:   ")
        if lock_ok { println("PASS") } else { println("FAIL"); all_ok = false }

        let reg_ok = registry_client_self_test()
        print("[pkg] registry_client (offline): ")
        if reg_ok { println("PASS") } else { println("FAIL"); all_ok = false }

        println("")
        if all_ok {
            println("[pkg] ALL SELF-TESTS: PASS")
        } else {
            println("[pkg] SOME SELF-TESTS FAILED")
        }
        return
    }
    if *subcommand == "help" || *subcommand == "--help" || *subcommand == "-h" {
        pkg_print_usage()
        return
    }

    println("souc pkg: unknown subcommand: " + *subcommand)
    println("")
    pkg_print_usage()
}
