// self-hosted::compiler::knowledge_runtime_guard_expander
//
// Sounio-native replacement for scripts/ontology/expand_knowledge_runtime_guards.sh.
// Reads a source file, builds the knowledge-runtime-guard lowering plan, emits
// expanded source (helper function prepended + type annotation lowered + constructors
// wrapped) to stdout. Handles up to 2 conjunctive numeric constraints per type.
//
// Usage: bin/souc run self-hosted/compiler/knowledge_runtime_guard_expander.sio <src.sio>
// Output: expanded source on stdout

use knowledge_runtime_guard_lowering_plan::{
    knowledge_runtime_guard_lowering_plan_build,
    KnowledgeRuntimeGuardLoweringPlan
}
use parser::ast::{Name}

var KNG_EXP_SRC: [i8; 1048576] = [0; 1048576]
var KNG_EXP_INT_DIGITS: [i8; 20] = [0; 20]

fn kng_exp_print_i64(n: i64) with IO, Mut, Panic, Div {
    if n < 0 {
        print("-")
        kng_exp_print_i64(0 - n)
        return
    }
    if n == 0 {
        print_char(48)
        return
    }
    var v = n
    var count: i64 = 0
    while v > 0 {
        KNG_EXP_INT_DIGITS[count as usize] = (48 + (v % 10)) as i8
        count = count + 1
        v = v / 10
    }
    var i = count - 1
    while i >= 0 {
        print_char(KNG_EXP_INT_DIGITS[i as usize] as i64)
        i = i - 1
    }
}

fn kng_exp_load(path: string) -> i64 with IO, Mut, Panic, Div {
    let size = file_size(path)
    if size <= 0 { return 0 }
    let n = if size > 1048576 { 1048576 } else { size }
    let raw = read_file(path)
    var i: i64 = 0
    while i < n {
        KNG_EXP_SRC[i as usize] = raw[i as usize]
        i = i + 1
    }
    n
}

fn kng_exp_str_at(s: string, pos: i64, src_len: i64) -> bool with Mut, Panic, Div {
    let slen = str_len(s)
    if pos < 0 || pos + slen > src_len { return false }
    var i: i64 = 0
    while i < slen {
        if KNG_EXP_SRC[(pos + i) as usize] != (str_char_at(s, i) as i8) {
            return false
        }
        i = i + 1
    }
    true
}

fn kng_exp_name_at(name: Name, pos: i64, src_len: i64) -> bool with Mut, Panic, Div {
    if pos < 0 || pos + name.len > src_len { return false }
    var i: i64 = 0
    while i < name.len {
        if KNG_EXP_SRC[(pos + i) as usize] != name.buf[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

fn kng_exp_print_name(name: Name) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < name.len {
        print_char(name.buf[i as usize] as i64)
        i = i + 1
    }
}

fn kng_exp_skip_spaces(pos: i64, src_len: i64) -> i64 with Mut, Panic, Div {
    var p = pos
    while p < src_len && KNG_EXP_SRC[p as usize] == (32 as i8) {
        p = p + 1
    }
    p
}

fn kng_exp_print_op_name(constraint_kind: i64) with IO {
    if constraint_kind == 1 { print("eq"); return }
    if constraint_kind == 2 { print("ge"); return }
    if constraint_kind == 3 { print("gt"); return }
    if constraint_kind == 4 { print("le"); return }
    if constraint_kind == 5 { print("lt"); return }
}

fn kng_exp_print_op_sym(constraint_kind: i64) with IO {
    if constraint_kind == 1 { print("=="); return }
    if constraint_kind == 2 { print(">="); return }
    if constraint_kind == 3 { print(">"); return }
    if constraint_kind == 4 { print("<="); return }
    if constraint_kind == 5 { print("<"); return }
}

fn kng_exp_print_threshold_in_name(vkind: i64, ival: i64, fval: f64) with IO, Mut, Panic, Div {
    if vkind == 2 {
        kng_exp_print_i64(ival)
    } else {
        let ipart = fval as i64
        let frac = fval - (ipart as f64)
        kng_exp_print_i64(ipart)
        if frac >= 0.001 {
            print("_")
            let d = (frac * 10.0) as i64
            kng_exp_print_i64(d)
        }
    }
}

fn kng_exp_print_threshold_value(vkind: i64, ival: i64, fval: f64) with IO, Mut, Panic, Div {
    if vkind == 2 {
        kng_exp_print_i64(ival)
    } else {
        print_f64(fval)
    }
}

// Check if source at pos matches "Knowledge<TypeName where"
fn kng_exp_at_knowledge_where(pos: i64, src_len: i64, type_name: Name) -> bool with Mut, Panic, Div {
    if !kng_exp_str_at("Knowledge<", pos, src_len) { return false }
    let after_k = pos + 10
    if !kng_exp_name_at(type_name, after_k, src_len) { return false }
    let p = kng_exp_skip_spaces(after_k + type_name.len, src_len)
    kng_exp_str_at("where", p, src_len)
}

// Check if source at pos matches "value:" + spaces + TypeName + spaces + "{"
fn kng_exp_at_value_type_brace(pos: i64, src_len: i64, type_name: Name) -> bool with Mut, Panic, Div {
    if !kng_exp_str_at("value:", pos, src_len) { return false }
    let p = kng_exp_skip_spaces(pos + 6, src_len)
    if !kng_exp_name_at(type_name, p, src_len) { return false }
    let q = kng_exp_skip_spaces(p + type_name.len, src_len)
    if q >= src_len { return false }
    KNG_EXP_SRC[q as usize] == (123 as i8)
}

// Advance pos past "value:" + spaces + TypeName + spaces, return index of "{"
fn kng_exp_value_type_brace_pos(pos: i64, src_len: i64, type_name: Name) -> i64 with Mut, Panic, Div {
    let p = kng_exp_skip_spaces(pos + 6, src_len)
    let q = kng_exp_skip_spaces(p + type_name.len, src_len)
    q
}

// Print the guard helper function name suffix for one obligation
fn kng_exp_print_obligation_suffix(field: Name, ckind: i64, vkind: i64, ival: i64, fval: f64, unit: Name) with IO, Mut, Panic, Div {
    print("_")
    kng_exp_print_name(field)
    print("_")
    kng_exp_print_op_name(ckind)
    print("_")
    kng_exp_print_threshold_in_name(vkind, ival, fval)
    if unit.len > 0 {
        print("_")
        kng_exp_print_name(unit)
    }
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    if argc < 1 {
        print("error: usage: knowledge_runtime_guard_expander <source.sio>\n")
        return 2
    }
    let path = get_arg(0)
    let src_len = kng_exp_load(path)
    if src_len <= 0 {
        print("error: cannot read source: ")
        print(path)
        print("\n")
        return 2
    }

    let plan = knowledge_runtime_guard_lowering_plan_build(path)

    // No obligations or plan not ready → output source unchanged
    if !plan.first_obligation_found || !plan.first_backend_guard_row_ready {
        var i: i64 = 0
        while i < src_len {
            print_char(KNG_EXP_SRC[i as usize] as i64)
            i = i + 1
        }
        return 0
    }

    // Extract obligation fields to avoid passing large struct to helpers
    let type_name  = plan.first_obligation_type_name
    let field1     = plan.first_obligation_field_name
    let ckind1     = plan.first_obligation_constraint_kind
    let vkind1     = plan.first_obligation_value_kind
    let ival1      = plan.first_obligation_int_value
    let fval1      = plan.first_obligation_float_value
    let unit1      = plan.first_obligation_unit_name
    let second     = plan.second_obligation_found
    let field2     = plan.second_obligation_field_name
    let ckind2     = plan.second_obligation_constraint_kind
    let vkind2     = plan.second_obligation_value_kind
    let ival2      = plan.second_obligation_int_value
    let fval2      = plan.second_obligation_float_value
    let unit2      = plan.second_obligation_unit_name

    // ── Helper function ──────────────────────────────────────────────────────
    print("fn __sounio_knowledge_guard_")
    kng_exp_print_name(type_name)
    kng_exp_print_obligation_suffix(field1, ckind1, vkind1, ival1, fval1, unit1)
    if second {
        kng_exp_print_obligation_suffix(field2, ckind2, vkind2, ival2, fval2, unit2)
    }
    print("(value: ")
    kng_exp_print_name(type_name)
    print(") -> ")
    kng_exp_print_name(type_name)
    print(" with Panic {\n")
    print("    assert(value.")
    kng_exp_print_name(field1)
    print(" ")
    kng_exp_print_op_sym(ckind1)
    print(" ")
    kng_exp_print_threshold_value(vkind1, ival1, fval1)
    print(")\n")
    if second {
        print("    assert(value.")
        kng_exp_print_name(field2)
        print(" ")
        kng_exp_print_op_sym(ckind2)
        print(" ")
        kng_exp_print_threshold_value(vkind2, ival2, fval2)
        print(")\n")
    }
    print("    return value\n")
    print("}\n\n")

    // ── Modified source ──────────────────────────────────────────────────────
    // State machine:
    //   0 = NORMAL: copy bytes, watch for patterns
    //   1 = SUPPRESS_WHERE: suppress until "}" followed immediately by ">"
    //   2 = TRACK_CONSTRUCTOR: copy, tracking brace depth; append ")" at depth=0

    var pos: i64 = 0
    var state: i64 = 0
    var depth: i64 = 0

    while pos < src_len {
        let ch = KNG_EXP_SRC[pos as usize]

        if state == 0 {
            if kng_exp_at_knowledge_where(pos, src_len, type_name) {
                print("Knowledge<")
                kng_exp_print_name(type_name)
                print(">")
                state = 1
                pos = pos + 1
            } else if kng_exp_at_value_type_brace(pos, src_len, type_name) {
                let brace_pos = kng_exp_value_type_brace_pos(pos, src_len, type_name)
                print("value: __sounio_knowledge_guard_")
                kng_exp_print_name(type_name)
                kng_exp_print_obligation_suffix(field1, ckind1, vkind1, ival1, fval1, unit1)
                if second {
                    kng_exp_print_obligation_suffix(field2, ckind2, vkind2, ival2, fval2, unit2)
                }
                print("(")
                kng_exp_print_name(type_name)
                print(" {")
                pos = brace_pos + 1
                state = 2
                depth = 1
            } else {
                print_char(ch as i64)
                pos = pos + 1
            }
        } else if state == 1 {
            if ch == (125 as i8) && pos + 1 < src_len && KNG_EXP_SRC[(pos + 1) as usize] == (62 as i8) {
                pos = pos + 2
                state = 0
            } else {
                pos = pos + 1
            }
        } else if state == 2 {
            if ch == (123 as i8) {
                depth = depth + 1
                print_char(ch as i64)
                pos = pos + 1
            } else if ch == (125 as i8) {
                depth = depth - 1
                if depth == 0 {
                    print("})")
                    state = 0
                } else {
                    print_char(ch as i64)
                }
                pos = pos + 1
            } else {
                print_char(ch as i64)
                pos = pos + 1
            }
        } else {
            print_char(ch as i64)
            pos = pos + 1
        }
    }

    0
}
