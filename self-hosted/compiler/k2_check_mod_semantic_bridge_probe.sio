use parser::parser::{parser_last_error_count}
use lexer::mod::{lex_file_parse_items}
use check::mod::{check_items_semantic_only_verdict_probe}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    print("k2_check_mod_semantic_bridge_probe=start\n")
    let argc = arg_count()
    if argc < 1 {
        print("usage: k2_check_mod_semantic_bridge_probe <source>\n")
        return 2
    }
    let source_path = get_arg(0)
    print("k2_check_mod_semantic_bridge_probe=parse_enter\n")
    let items = lex_file_parse_items(source_path)
    print("k2_check_mod_semantic_bridge_probe=parse_ok\n")
    if parser_last_error_count() > 0 {
        print("k2_check_mod_semantic_bridge_probe=parse_error\n")
        return 2
    }
    let verdict = check_items_semantic_only_verdict_probe(items)
    print("k2_check_mod_semantic_bridge_probe=verdict=")
    print_int(verdict)
    print("\n")
    if verdict == 0 {
        print("k2_check_mod_semantic_bridge_probe=ok\n")
        return 0
    }
    print("k2_check_mod_semantic_bridge_probe=rejected\n")
    1
}
