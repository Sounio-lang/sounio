use check::check::{checker_check_items_with_ontology_cache_subclass_verdict}
use lexer::mod::{lex_file_parse_items}
use parser::parser::{parser_last_error_count}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    print("k2_check_import_ontology_cache_sourcecheck_classifier_probe=start\n")
    let argc = arg_count()
    if argc < 1 {
        print("usage: k2_check_import_ontology_cache_sourcecheck_classifier_probe <cache-consumer-source>\n")
        return 2
    }

    let source_path = get_arg(0)
    print("k2_check_import_ontology_cache_sourcecheck_classifier_probe=parse_enter\n")
    let items = lex_file_parse_items(source_path)
    print("k2_check_import_ontology_cache_sourcecheck_classifier_probe=parse_ok\n")
    if parser_last_error_count() > 0 {
        print("k2_check_import_ontology_cache_sourcecheck_classifier_probe=parse_error\n")
        return 2
    }

    print("k2_check_import_ontology_cache_sourcecheck_classifier_probe=sourcecheck_enter\n")
    let verdict = checker_check_items_with_ontology_cache_subclass_verdict(items, source_path, 73211009, 138875005)
    print("k2_check_import_ontology_cache_sourcecheck_classifier_probe=verdict=")
    print_int(verdict)
    print("\n")
    if verdict == 0 {
        print("k2_check_import_ontology_cache_sourcecheck_classifier_probe=ok\n")
        return 0
    }
    print("k2_check_import_ontology_cache_sourcecheck_classifier_probe=rejected\n")
    1
}
