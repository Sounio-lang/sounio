use knowledge_runtime_guard_lowering_plan::{knowledge_runtime_guard_lowering_plan_row_at}
use parser::ast::{Name}

fn print_bool_digit(value: bool) with IO {
    if value {
        print("1")
    } else {
        print("0")
    }
}

fn print_probe_name(name: Name) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < name.len {
        print_char(name.buf[i as usize] as i64)
        i = i + 1
    }
}

fn parse_dec_arg(s: string) -> i64 with Mut, Panic, Div {
    var v: i64 = 0
    var i: i64 = 0
    let n = str_len(s)
    while i < n {
        let c = str_char_at(s, i)
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48)
        }
        i = i + 1
    }
    v
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    var path = "tests/frontend/knowledge_runtime_guard_directive_positive.sio"
    if argc >= 1 {
        path = get_arg(0)
    }
    var row_index: i64 = 0
    if argc >= 2 {
        row_index = parse_dec_arg(get_arg(1))
    }

    let row = knowledge_runtime_guard_lowering_plan_row_at(path, row_index)
    print("knowledge_runtime_guard_backend_row_index=")
    print_int(row.row_index)
    print(" source_valid=")
    print_bool_digit(row.source_valid)
    print(" parse_errors=")
    print_int(row.parse_errors)
    print(" semantic_verdict=")
    print_int(row.semantic_verdict)
    print(" runtime_obligation_count=")
    print_int(row.runtime_obligation_count)
    print(" in_bounds=")
    print_bool_digit(row.in_bounds)
    print(" obligation_found=")
    print_bool_digit(row.obligation_found)
    print(" site_kind=")
    print_int(row.site_kind)
    print(" type=")
    print_probe_name(row.type_name)
    print(" field=")
    print_probe_name(row.field_name)
    print(" constraint_kind=")
    print_int(row.constraint_kind)
    print(" value_kind=")
    print_int(row.value_kind)
    print(" int_value=")
    print_int(row.int_value)
    print(" float_value=")
    print_f64(row.float_value)
    print(" scaled_value=")
    print_int(row.scaled_value)
    print(" value_scale=")
    print_int(row.value_scale)
    print(" unit=")
    print_probe_name(row.unit_name)
    print(" dynamic_expr_kind=")
    print_int(row.dynamic_expr_kind)
    print(" row_ready=")
    print_bool_digit(row.row_ready)
    print(" compare_opcode=")
    print_int(row.compare_opcode)
    print(" native_cmp_code=")
    print_int(row.native_cmp_code)
    print(" native_trap_builtin_id=")
    print_int(row.native_trap_builtin_id)
    print(" native_trap_on_false=")
    print_bool_digit(row.native_trap_on_false)
    print(" threshold_kind=")
    print_int(row.threshold_kind)
    print(" trap_exit_code=")
    print_int(row.trap_exit_code)
    print("\n")
    0
}
