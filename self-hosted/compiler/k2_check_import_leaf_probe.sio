use check::check::{checker_import_bridge_leaf_probe_value}

fn main() -> i64 with IO {
    print("k2_check_import_leaf_probe=start\n")
    let value = checker_import_bridge_leaf_probe_value()
    print("k2_check_import_leaf_probe=value=")
    print_int(value)
    print("\n")
    if value == 424242 {
        print("k2_check_import_leaf_probe=ok\n")
        return 0
    }
    print("k2_check_import_leaf_probe=bad\n")
    1
}
