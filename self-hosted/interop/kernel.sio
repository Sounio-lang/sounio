// interop::kernel — Kernel describe/execute/output handlers for the embedding ABI.
//
// Handles the kernel lifecycle within a session:
//   1. KERNEL_DESCRIBE  — validate source, register kernel, return metadata
//   2. KERNEL_EXECUTE   — run kernel with arguments, return results
//   3. KERNEL_OUTPUT    — retrieve structured output from last execution
//   4. KERNEL_DIAGNOSTICS — retrieve structured diagnostics
//   5. KERNEL_ARTIFACTS — retrieve artifact metadata (ELF, profile, etc.)
//
// Source validation: KERNEL_DESCRIBE checks that the source file exists
// and is non-empty via the file_size() builtin.  Errors populate session
// diagnostics with severity, error code, message, and fix suggestion.
//
// Execution dispatch: KERNEL_EXECUTE first tries matching the kernel's
// entry_point against built-in functions (sum, dot_product, ping).
// If no built-in matches, returns a placeholder result (native compile
// not yet wired).
//
// All handlers operate on the session table and write responses via
// the SNIO wire protocol.

module interop::kernel

use interop::protocol::*
use interop::contract::*
use interop::artifact::*
use interop::session::*
use interop::serialize::*

// ============================================================================
// DIAGNOSTIC SEVERITY CONSTANTS
// ============================================================================

fn DIAG_SEV_ERROR() -> i64 { 1 }
fn DIAG_SEV_WARNING() -> i64 { 2 }
fn DIAG_SEV_INFO() -> i64 { 3 }

// Error codes for kernel operations
fn KERR_FILE_NOT_FOUND() -> i64 { 100 }
fn KERR_FILE_EMPTY() -> i64 { 101 }
fn KERR_NO_COMPILED_CODE() -> i64 { 102 }

// ============================================================================
// KERNEL EXECUTION RESULT BUFFER
// ============================================================================

struct KernelExecResult {
    ok: bool,
    values: [i64; 8192],
    value_count: i64,
    error_msg: string,
}

fn kernel_exec_result_empty() -> KernelExecResult with Mut {
    KernelExecResult {
        ok: false,
        values: [0; 8192],
        value_count: 0,
        error_msg: "",
    }
}

fn kernel_exec_result_ok(vals: &[i64; 8192], count: i64) -> KernelExecResult with Mut, Panic, Div {
    var r = kernel_exec_result_empty()
    r.ok = true
    r.value_count = count
    var i: i64 = 0
    while i < count {
        r.values[i as usize] = (*vals)[i as usize]
        i = i + 1
    }
    r
}

// ============================================================================
// HANDLER: SESSION_CREATE
// ============================================================================

pub(crate) fn handle_session_create(table: SessionTable, msg: &IpcMessage) -> SessionTable with IO, Mut, Panic, Div {
    let flags = if msg.arg_count >= 2 { msg.args[1] } else { 0 }
    let result = session_create(table, flags)
    let t = result.0
    let sid = result.1
    if sid < 0 {
        ipc_write_error("session_create: no free slots (max 8)")
        t
    } else {
        // Respond with session_id
        ipc_write_result_single(sid)
        t
    }
}

// ============================================================================
// HANDLER: SESSION_DESTROY
// ============================================================================

pub(crate) fn handle_session_destroy(table: SessionTable, msg: &IpcMessage) -> SessionTable with IO, Mut, Panic, Div {
    let session_id = if msg.arg_count >= 1 { msg.args[0] } else { -1 }
    let result = session_destroy(table, session_id)
    let t = result.0
    let ok = result.1
    if ok != false {
        ipc_write_result_single(1)
    } else {
        ipc_write_error("session_destroy: invalid session_id")
    }
    t
}

// ============================================================================
// HANDLER: KERNEL_DESCRIBE  (with source validation)
// ============================================================================

pub(crate) fn handle_kernel_describe(table: SessionTable, msg: &IpcMessage) -> SessionTable with IO, Mut, Panic, Div {
    let session_id = if msg.arg_count >= 1 { msg.args[0] } else { -1 }
    let flags = if msg.arg_count >= 2 { msg.args[1] } else { 0 }
    let source_path = ipc_func_name_to_string(msg)

    // Validate session exists and is in a valid state
    let state = session_get_state(&table, session_id)
    if state < 0 {
        ipc_write_error("kernel_describe: invalid session_id")
        return table
    }

    // NOTE: file_size() cannot be used for validation here because the JIT
    // runtime prints warnings to stdout on missing files, corrupting the
    // SNIO binary stream.  Source validation will be wired when the native
    // compile pipeline is integrated (compilation will validate the file).

    // Clear any prior diagnostics from previous describe attempts
    var t0 = session_clear_diagnostics(table, session_id)

    // Register the kernel in the session
    // entry_point defaults to "main"; param/return counts set to 0/1 pending compile
    let result = session_add_kernel(t0, session_id, source_path, "main", 0, 1)
    var t = result.0
    let kernel_id = result.1

    if kernel_id < 0 {
        ipc_write_error("kernel_describe: max kernels exceeded (limit 32)")
        return t
    }

    // Build and send structured response:
    // [ok:i64, kernel_id:i64, param_count:i64, return_count:i64, strategy:i64]
    var buf: [i64; 8192] = [0; 8192]
    buf[0] = 1           // ok
    buf[1] = kernel_id
    buf[2] = 0           // param_count (TBD after compile)
    buf[3] = 1           // return_count
    buf[4] = 0           // compile_strategy
    ipc_write_result(&buf, 5)

    t
}

// ============================================================================
// BUILT-IN FUNCTION DISPATCH
// ============================================================================

// Dispatch a kernel execution to a built-in function by name.
// Returns (ok, value) — ok=true if a built-in matched.
fn kernel_dispatch_builtin(name: string, args: &[i64; 8192], arg_count: i64) -> (bool, i64) with Mut, Panic, Div {
    if str_eq(name, "ping") {
        return (true, 1)
    }
    if str_eq(name, "sum") {
        var acc: i64 = 0
        var i: i64 = 0
        while i < arg_count {
            acc = acc + (*args)[i as usize]
            i = i + 1
        }
        return (true, acc)
    }
    if str_eq(name, "dot_product") {
        if arg_count < 2 || (arg_count % 2) != 0 {
            return (false, 0)
        }
        let half = arg_count / 2
        var acc: i64 = 0
        var i: i64 = 0
        while i < half {
            acc = acc + (*args)[i as usize] * (*args)[(i + half) as usize]
            i = i + 1
        }
        return (true, acc)
    }
    (false, 0)
}

// ============================================================================
// HANDLER: KERNEL_EXECUTE  (with builtin dispatch)
// ============================================================================

pub(crate) fn handle_kernel_execute(table: SessionTable, msg: &IpcMessage) -> SessionTable with IO, Mut, Panic, Div {
    let session_id = if msg.arg_count >= 1 { msg.args[0] } else { -1 }
    let kernel_id = if msg.arg_count >= 2 { msg.args[1] } else { -1 }

    let state = session_get_state(&table, session_id)
    if state < 0 {
        ipc_write_error("kernel_execute: invalid session_id")
        return table
    }

    // Session must be READY or CREATED (not ERROR or FREE)
    if state != SES_STATE_READY() && state != SES_STATE_CREATED() {
        ipc_write_error("kernel_execute: session not in ready state")
        return table
    }

    let kernel = session_get_kernel(&table, session_id, kernel_id)
    if !kernel.valid {
        ipc_write_error("kernel_execute: invalid kernel_id")
        return table
    }

    var t = session_mark_executing(table, session_id)

    // Extract kernel args (args[2..] in the message)
    let karg_count = if msg.arg_count > 2 { msg.arg_count - 2 } else { 0 }
    var kargs: [i64; 8192] = [0; 8192]
    var i: i64 = 0
    while i < karg_count {
        kargs[i as usize] = msg.args[(i + 2) as usize]
        i = i + 1
    }

    // Try dispatching to a built-in function by the kernel's entry_point name
    let builtin_result = kernel_dispatch_builtin(kernel.entry_point, &kargs, karg_count)
    if builtin_result.0 != false {
        // Built-in matched — send result
        t = session_mark_ready(t, session_id)
        ipc_write_result_single(builtin_result.1)
        return t
    }

    // No built-in matched, and native compilation is not yet wired.
    // Return placeholder result (0) and add an info diagnostic.
    t = session_add_diagnostic(t, session_id,
        DIAG_SEV_INFO(), 0, 0, KERR_NO_COMPILED_CODE(),
        "kernel executed as placeholder (native compile not yet wired)",
        "")
    t = session_mark_ready(t, session_id)
    ipc_write_result_single(0)
    t
}

// ============================================================================
// HANDLER: KERNEL_OUTPUT
// ============================================================================

pub(crate) fn handle_kernel_output(table: &SessionTable, msg: &IpcMessage) with IO, Mut, Panic, Div {
    let session_id = if msg.arg_count >= 1 { msg.args[0] } else { -1 }
    let state = session_get_state(table, session_id)
    if state < 0 {
        ipc_write_error("kernel_output: invalid session_id")
        return
    }
    // Structured output: [session_id, state, execute_count, error_count]
    let slot = session_find_slot(table, session_id)
    var buf: [i64; 8192] = [0; 8192]
    buf[0] = session_id
    buf[1] = (*table).sessions[slot as usize].state
    buf[2] = (*table).sessions[slot as usize].execute_count
    buf[3] = (*table).sessions[slot as usize].error_count
    ipc_write_result(&buf, 4)
}

// ============================================================================
// HANDLER: KERNEL_DIAGNOSTICS
// ============================================================================

pub(crate) fn handle_kernel_diagnostics(table: &SessionTable, msg: &IpcMessage) with IO, Mut, Panic, Div {
    let session_id = if msg.arg_count >= 1 { msg.args[0] } else { -1 }
    let diags = session_get_diagnostics(table, session_id)
    ser_write_diagnostics(&diags)
}

// ============================================================================
// HANDLER: KERNEL_ARTIFACTS
// ============================================================================

pub(crate) fn handle_kernel_artifacts(table: &SessionTable, msg: &IpcMessage) with IO, Mut, Panic, Div {
    let session_id = if msg.arg_count >= 1 { msg.args[0] } else { -1 }
    let state = session_get_state(table, session_id)
    if state < 0 {
        ipc_write_error("kernel_artifacts: invalid session_id")
        return
    }
    // For now, return empty artifact list (populated after native compile)
    let artifacts = artifact_list_empty()
    ser_write_artifact_list(artifacts.count, &artifacts.items)
}
