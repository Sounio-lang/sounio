// interop::serve_entry — Minimal entry point for the SNIO embedding server.
//
// This is a lightweight alternative to compiler/main.sio --serve that only
// loads the interop modules.  JIT-compiles in seconds instead of minutes.
//
// Usage:
//   souc run self-hosted/interop/serve_entry.sio

use interop::protocol::*
use interop::contract::*
use interop::artifact::*
use interop::session::*
use interop::kernel::*
use interop::serialize::*
use interop::server::*

fn main() with IO, Mut, Panic, Div {
    ipc_serve()
}
