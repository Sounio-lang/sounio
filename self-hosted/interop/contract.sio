// interop::contract — Kernel contract schema for structured compile requests/responses.
//
// Defines KernelRequest and KernelResponse structs for the --kernel-compile mode.
// All structured output flows through these types.

module interop::contract

// ============================================================================
// KERNEL REQUEST
// ============================================================================

struct KernelRequest {
    source_path: string,
    output_format: string,
    output_path: string,
    optimize: bool,
    target: string,
    trace_path: string,
}

fn kernel_request_empty() -> KernelRequest with Mut {
    KernelRequest {
        source_path: "",
        output_format: "obj",
        output_path: "output.o",
        optimize: false,
        target: "x86-64-linux",
        trace_path: "",
    }
}

// ============================================================================
// KERNEL RESPONSE
// ============================================================================

struct KernelResponse {
    ok: bool,
    artifact_path: string,
    artifact_size: i64,
    diagnostics_count: i64,
    error_code: i64,
    error_msg: string,
    abi_version: i64,
    function_count: i64,
}

fn kernel_response_empty() -> KernelResponse with Mut {
    KernelResponse {
        ok: false,
        artifact_path: "",
        artifact_size: 0,
        diagnostics_count: 0,
        error_code: 0,
        error_msg: "",
        abi_version: 0,
        function_count: 0,
    }
}

fn kernel_response_ok(path: string, size: i64, fn_count: i64, abi_ver: i64) -> KernelResponse with Mut {
    KernelResponse {
        ok: true,
        artifact_path: path,
        artifact_size: size,
        diagnostics_count: 0,
        error_code: 0,
        error_msg: "",
        abi_version: abi_ver,
        function_count: fn_count,
    }
}

fn kernel_response_error(code: i64, msg: string) -> KernelResponse with Mut {
    KernelResponse {
        ok: false,
        artifact_path: "",
        artifact_size: 0,
        diagnostics_count: 0,
        error_code: code,
        error_msg: msg,
        abi_version: 0,
        function_count: 0,
    }
}


// ============================================================================
// EXPORT METADATA
// ============================================================================

struct ExportMetadata {
    names: [string; 64],
    strategies: [i64; 64],
    count: i64,
}

fn export_metadata_empty() -> ExportMetadata with Mut {
    ExportMetadata {
        names: [""; 64],
        strategies: [0; 64],
        count: 0,
    }
}

fn export_metadata_add(meta: ExportMetadata, name: string, strategy: i64) -> ExportMetadata with Mut, Panic {
    var out = meta
    if out.count < 64 {
        out.names[out.count as usize] = name
        out.strategies[out.count as usize] = strategy
        out.count = out.count + 1
    }
    out
}


// ============================================================================
// KERNEL PROVENANCE
// ============================================================================

struct KernelProvenance {
    source_hash: i64,
    abi_version: i64,
    optimize: bool,
    function_count: i64,
    ir_instruction_count: i64,
}

fn kernel_provenance_empty() -> KernelProvenance with Mut {
    KernelProvenance {
        source_hash: 0,
        abi_version: 0,
        optimize: false,
        function_count: 0,
        ir_instruction_count: 0,
    }
}



// ============================================================================
// KERNEL DIAGNOSTICS
// ============================================================================

struct KernelDiagnostic {
    severity: i64,
    line: i64,
    col: i64,
    code: i64,
    message: string,
}

struct KernelDiagnostics {
    items: [KernelDiagnostic; 64],
    count: i64,
}

fn kernel_diagnostic_empty() -> KernelDiagnostic with Mut {
    KernelDiagnostic {
        severity: 0,
        line: 0,
        col: 0,
        code: 0,
        message: "",
    }
}

fn kernel_diagnostics_empty() -> KernelDiagnostics with Mut {
    var items: [KernelDiagnostic; 64] = [KernelDiagnostic { severity: 0, line: 0, col: 0, code: 0, message: "" }; 64]
    KernelDiagnostics {
        items: items,
        count: 0,
    }
}

fn kernel_diagnostics_add(diags: KernelDiagnostics, severity: i64, line: i64, col: i64, code: i64, msg: string) -> KernelDiagnostics with Mut, Panic {
    var result = diags
    let idx = result.count
    if idx >= 64 {
        return result
    }
    result.items[idx as usize] = KernelDiagnostic {
        severity: severity,
        line: line,
        col: col,
        code: code,
        message: msg,
    }
    result.count = idx + 1
    result
}

// ============================================================================
// FNV-1a HASH
// ============================================================================

fn fnv1a_hash_string(s: string) -> i64 with Mut, Panic, Div {
    var hash: i64 = 2166136261
    var i: i64 = 0
    let n = str_len(s)
    while i < n {
        let ch = str_char_at(s, i)
        hash = hash ^ ch
        hash = hash * 16777619
        if hash < 0 { hash = 0 - hash }
        i = i + 1
    }
    hash
}
