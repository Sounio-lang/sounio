// interop::contract — Kernel contract schema for structured compile requests/responses.
//
// Defines KernelRequest and KernelResponse structs for the --kernel-compile mode.
// All structured output flows through these types.

module interop::contract

// ============================================================================
// KERNEL REQUEST
// ============================================================================

struct KernelRequest {
    source_path: string,
    output_format: string,
    output_path: string,
    optimize: bool,
    target: string,
    trace_path: string,
}

fn kernel_request_empty() -> KernelRequest with Mut {
    KernelRequest {
        source_path: "",
        output_format: "obj",
        output_path: "output.o",
        optimize: false,
        target: "x86-64-linux",
        trace_path: "",
    }
}

// ============================================================================
// KERNEL RESPONSE
// ============================================================================

pub struct KernelResponse {
    ok: bool,
    artifact_path: string,
    artifact_size: i64,
    diagnostics_count: i64,
    error_code: i64,
    error_msg: string,
    abi_version: i64,
    function_count: i64,
}

fn kernel_response_empty() -> KernelResponse with Mut {
    KernelResponse {
        ok: false,
        artifact_path: "",
        artifact_size: 0,
        diagnostics_count: 0,
        error_code: 0,
        error_msg: "",
        abi_version: 0,
        function_count: 0,
    }
}

pub(crate) fn kernel_response_ok(path: string, size: i64, fn_count: i64, abi_ver: i64) -> KernelResponse with Mut {
    KernelResponse {
        ok: true,
        artifact_path: path,
        artifact_size: size,
        diagnostics_count: 0,
        error_code: 0,
        error_msg: "",
        abi_version: abi_ver,
        function_count: fn_count,
    }
}

pub(crate) fn kernel_response_error(code: i64, msg: string) -> KernelResponse with Mut {
    KernelResponse {
        ok: false,
        artifact_path: "",
        artifact_size: 0,
        diagnostics_count: 0,
        error_code: code,
        error_msg: msg,
        abi_version: 0,
        function_count: 0,
    }
}


// ============================================================================
// EXPORT METADATA
// ============================================================================

pub struct ExportMetadata {
    names: [string; 64],
    strategies: [i64; 64],
    count: i64,
}

fn export_metadata_empty() -> ExportMetadata with Mut {
    ExportMetadata {
        names: [""; 64],
        strategies: [0; 64],
        count: 0,
    }
}

fn export_metadata_add(meta: ExportMetadata, name: string, strategy: i64) -> ExportMetadata with Mut, Panic {
    var out = meta
    if out.count < 64 {
        out.names[out.count as usize] = name
        out.strategies[out.count as usize] = strategy
        out.count = out.count + 1
    }
    out
}


// ============================================================================
// KERNEL PROVENANCE
// ============================================================================

pub struct KernelProvenance {
    source_hash: i64,
    abi_version: i64,
    optimize: bool,
    function_count: i64,
    ir_instruction_count: i64,
    stdlib_hash: i64,
}

pub(crate) fn kernel_provenance_empty() -> KernelProvenance with Mut {
    KernelProvenance {
        source_hash: 0,
        abi_version: 0,
        optimize: false,
        function_count: 0,
        ir_instruction_count: 0,
        stdlib_hash: 0,
    }
}





// ============================================================================
// PROMOTION RECORDS
// ============================================================================

pub struct PromotionRecord {
    func_name: string,
    call_count: i64,
    old_strategy: i64,
    new_strategy: i64,
}

fn promotion_record_empty() -> PromotionRecord with Mut {
    PromotionRecord {
        func_name: "",
        call_count: 0,
        old_strategy: 0,
        new_strategy: 0,
    }
}

pub struct PromotionSummary {
    records: [PromotionRecord; 64],
    count: i64,
}

fn promotion_summary_empty() -> PromotionSummary with Mut {
    PromotionSummary {
        records: [PromotionRecord { func_name: "", call_count: 0, old_strategy: 0, new_strategy: 0 }; 64],
        count: 0,
    }
}

fn promotion_summary_add(summary: PromotionSummary, name: string, count: i64, old_strat: i64, new_strat: i64) -> PromotionSummary with Mut, Panic {
    var out = summary
    if out.count < 64 {
        out.records[out.count as usize] = PromotionRecord {
            func_name: name,
            call_count: count,
            old_strategy: old_strat,
            new_strategy: new_strat,
        }
        out.count = out.count + 1
    }
    out
}

// ============================================================================
// GPU CAPABILITY
// ============================================================================

pub struct GpuCapability {
    has_gpu: bool,
    device_name: string,
    compute_units: i64,
    max_workgroup_size: i64,
    local_memory_bytes: i64,
    global_memory_bytes: i64,
    supports_f64: bool,
    driver_version: string,
}

fn gpu_capability_empty() -> GpuCapability with Mut {
    GpuCapability {
        has_gpu: false,
        device_name: "none",
        compute_units: 0,
        max_workgroup_size: 0,
        local_memory_bytes: 0,
        global_memory_bytes: 0,
        supports_f64: false,
        driver_version: "0.0.0",
    }
}

// ============================================================================
// KERNEL DIAGNOSTICS
// ============================================================================

pub struct KernelDiagnostic {
    severity: i64,
    line: i64,
    col: i64,
    code: i64,
    message: string,
    fix_suggestion: string,
}

pub struct KernelDiagnostics {
    items: [KernelDiagnostic; 64],
    count: i64,
}

fn kernel_diagnostic_empty() -> KernelDiagnostic with Mut {
    KernelDiagnostic {
        severity: 0,
        line: 0,
        col: 0,
        code: 0,
        message: "",
        fix_suggestion: "",
    }
}

pub(crate) fn kernel_diagnostics_empty() -> KernelDiagnostics with Mut {
    var items: [KernelDiagnostic; 64] = [KernelDiagnostic { severity: 0, line: 0, col: 0, code: 0, message: "", fix_suggestion: "" }; 64]
    KernelDiagnostics {
        items: items,
        count: 0,
    }
}

pub(crate) fn kernel_diagnostics_add(diags: KernelDiagnostics, severity: i64, line: i64, col: i64, code: i64, msg: string, fix: string) -> KernelDiagnostics with Mut, Panic {
    var result = diags
    let idx = result.count
    if idx >= 64 {
        return result
    }
    result.items[idx as usize] = KernelDiagnostic {
        severity: severity,
        line: line,
        col: col,
        code: code,
        message: msg,
        fix_suggestion: fix,
    }
    result.count = idx + 1
    result
}


// ============================================================================
// ERROR CODES
// ============================================================================

let DIAG_E001_UNDEFINED_VAR: i64 = 1
let DIAG_E002_TYPE_MISMATCH: i64 = 2
let DIAG_E003_MISSING_RETURN: i64 = 3
let DIAG_E004_UNUSED_VAR: i64 = 4
let DIAG_E005_UNREACHABLE: i64 = 5
let DIAG_E006_MISSING_IMPORT: i64 = 6
let DIAG_E007_DUPLICATE_DEF: i64 = 7
let DIAG_E008_INVALID_TYPE: i64 = 8
let DIAG_E009_ARITY_MISMATCH: i64 = 9
let DIAG_E010_EFFECT_MISSING: i64 = 10

fn diag_suggest_fix(code: i64) -> string {
    if code == DIAG_E001_UNDEFINED_VAR { "Check spelling or add a `use` import" }
    else if code == DIAG_E002_TYPE_MISMATCH { "Ensure the expression type matches the expected type" }
    else if code == DIAG_E003_MISSING_RETURN { "Add a return expression at the end of the function body" }
    else if code == DIAG_E004_UNUSED_VAR { "Prefix with _ to suppress, or remove the binding" }
    else if code == DIAG_E005_UNREACHABLE { "Remove unreachable code after return/panic" }
    else if code == DIAG_E006_MISSING_IMPORT { "Add `use module::*` at the top of the file" }
    else if code == DIAG_E007_DUPLICATE_DEF { "Rename one of the duplicate definitions" }
    else if code == DIAG_E008_INVALID_TYPE { "Check that the type name is spelled correctly and imported" }
    else if code == DIAG_E009_ARITY_MISMATCH { "Check the function signature for the correct number of parameters" }
    else if code == DIAG_E010_EFFECT_MISSING { "Add the required effect to the function's `with` clause" }
    else { "" }
}

// ============================================================================
// FNV-1a HASH
// ============================================================================

fn fnv1a_hash_string(s: string) -> i64 with Mut, Panic, Div {
    var hash: i64 = 2166136261
    var i: i64 = 0
    let n = str_len(s)
    while i < n {
        let ch = str_char_at(s, i)
        hash = hash ^ ch
        hash = hash * 16777619
        if hash < 0 { hash = 0 - hash }
        i = i + 1
    }
    hash
}

fn compute_stdlib_hash() -> i64 with Mut, Panic, Div {
    fnv1a_hash_string("sounio-stdlib-v1.0.0-beta.5")
}
