// interop::artifact — Artifact descriptors for the embedding ABI.
//
// Defines structured artifact metadata returned by KERNEL_ARTIFACTS.

module interop::artifact

// ============================================================================
// ARTIFACT DESCRIPTORS
// ============================================================================

pub struct ArtifactDescriptor {
    kind: i64,
    path: string,
    size_bytes: i64,
    hash: i64,
}

fn artifact_descriptor_empty() -> ArtifactDescriptor with Mut {
    ArtifactDescriptor {
        kind: 0,
        path: "",
        size_bytes: 0,
        hash: 0,
    }
}

// Artifact kinds (match .snpkg entry kinds)
fn ARTIFACT_KIND_SOURCE() -> i64 { 1 }
fn ARTIFACT_KIND_OBJECT() -> i64 { 2 }
fn ARTIFACT_KIND_PROFILE() -> i64 { 3 }
fn ARTIFACT_KIND_PROVENANCE() -> i64 { 4 }
fn ARTIFACT_KIND_ELF() -> i64 { 5 }
fn ARTIFACT_KIND_SHARED_LIB() -> i64 { 6 }

pub struct ArtifactList {
    items: [ArtifactDescriptor; 16],
    count: i64,
}

pub(crate) fn artifact_list_empty() -> ArtifactList with Mut {
    ArtifactList {
        items: [ArtifactDescriptor { kind: 0, path: "", size_bytes: 0, hash: 0 }; 16],
        count: 0,
    }
}

fn artifact_list_add(list: ArtifactList, kind: i64, path: string, size_bytes: i64, hash: i64) -> ArtifactList with Mut, Panic {
    var out = list
    if out.count >= 16 { return out }
    out.items[out.count as usize] = ArtifactDescriptor {
        kind: kind,
        path: path,
        size_bytes: size_bytes,
        hash: hash,
    }
    out.count = out.count + 1
    out
}
