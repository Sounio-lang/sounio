// Parser — Pratt expression parser
//
// Precedence-climbing for binary operators, prefix/postfix handling,
// and all expression forms (literals, calls, field access, if, match, etc).

impl Parser {
    // ============================================================
    // Expression entry point (dispatches to Pratt parser)
    // ============================================================

    fn parse_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        self.parse_expr_bp(0)
    }

    // ============================================================
    // Pratt parser: parse expression with minimum binding power
    // ============================================================

    fn parse_expr_bp(self, min_bp: i64) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        // Parse prefix / atom
        let pair = self.parse_prefix()
        var p = pair.0
        var lhs = pair.1

        // Parse infix operators
        while !p.at_eof() {
            let op_kind = p.peek()
            let prec = tk_precedence(op_kind)

            // Stop if current operator has lower or equal precedence
            if prec <= min_bp { break }

            // Postfix: function call, method call, field access, index
            // A `(` after a newline is NOT a call — it starts a new expression.
            // e.g. `v\n    (*b)[0]` must not be parsed as `v((*b)[0])`.
            if op_kind == TokenKind::LParen {
                if p.had_newline_before() { break }
                let pair2 = p.parse_call_expr(lhs)
                p = pair2.0
                lhs = pair2.1
                continue
            }

            if op_kind == TokenKind::LBracket {
                let pair2 = p.parse_index_expr(lhs)
                p = pair2.0
                lhs = pair2.1
                continue
            }

            if op_kind == TokenKind::Dot {
                let pair2 = p.parse_dot_expr(lhs)
                p = pair2.0
                lhs = pair2.1
                continue
            }

            if op_kind == TokenKind::AuditLower {
                p = p.advance()
                let audit_name = p.current_name()
                p = p.expect_ident()
                let span = p.span_from(lhs.span)
                var audit_e = mk_expr(ExprKind::ExprAuditAttach, span)
                audit_e.left = Some(Box::new(lhs))
                audit_e.name = audit_name
                lhs = audit_e
                continue
            }

            // Range operators (non-associative)
            if op_kind == TokenKind::DotDot || op_kind == TokenKind::DotDotEq {
                let bin_op = if op_kind == TokenKind::DotDot { BinaryOp::OpRange } else { BinaryOp::OpRangeInclusive }
                p = p.advance()
                if p.at_expr_start() {
                    let pair2 = p.parse_expr_bp(prec)
                    p = pair2.0
                    let rhs = pair2.1
                    let span = p.span_from(lhs.span)
                    lhs = Expr {
                        kind: ExprKind::ExprRange,
                        span: span,
                        int_val: 0,
                        float_val: 0.0,
                        name: empty_name(),
                        path: empty_path(),
                        bin_op: bin_op,
                        un_op: UnaryOp::OpNeg,
                        left: Some(Box::new(lhs)),
                        right: Some(Box::new(rhs)),
                        block: None,
                        else_expr: None,
                        args: None,
                        arms: None,
                        fields: None,
                        cast_type: None,
                        handler_block: None,
                        closure_params: None,
                        closure_return: None,
                        closure_effects: None,
                        closure_body: None,
                    }
                } else {
                    // Half-open range: expr..
                    let span = p.span_from(lhs.span)
                    lhs = Expr {
                        kind: ExprKind::ExprRange,
                        span: span,
                        int_val: 0,
                        float_val: 0.0,
                        name: empty_name(),
                        path: empty_path(),
                        bin_op: bin_op,
                        un_op: UnaryOp::OpNeg,
                        left: Some(Box::new(lhs)),
                        right: None,
                        block: None,
                        else_expr: None,
                        args: None,
                        arms: None,
                        fields: None,
                        cast_type: None,
                        handler_block: None,
                        closure_params: None,
                        closure_return: None,
                        closure_effects: None,
                        closure_body: None,
                    }
                }
                continue
            }

            // Type cast: expr as Type
            if op_kind == TokenKind::As {
                p = p.advance()  // skip 'as'
                let pair2 = p.parse_type()
                p = pair2.0
                let target_ty = pair2.1
                let span = p.span_from(lhs.span)
                var cast_e = mk_expr(ExprKind::ExprCast, span)
                cast_e.left = Some(Box::new(lhs))
                cast_e.cast_type = Some(Box::new(target_ty))
                lhs = cast_e
                continue
            }

            // Standard binary operator
            if prec == 0 { break }

            let bin_op = token_to_binop(op_kind)
            p = p.advance()

            // Right-hand side: use prec for left-associativity
            let pair2 = p.parse_expr_bp(prec)
            p = pair2.0
            let rhs = pair2.1
            let span = p.span_from(lhs.span)

            var bin_e = mk_expr(ExprKind::ExprBinary, span)
            bin_e.bin_op = bin_op
            bin_e.left = Some(Box::new(lhs))
            bin_e.right = Some(Box::new(rhs))
            lhs = bin_e
        }

        (p, lhs)
    }

    // ============================================================
    // Prefix / atom expressions
    // ============================================================

    fn parse_prefix(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let k = self.peek()

        // Unary operators
        if k == TokenKind::Minus {
            self.parse_unary(UnaryOp::OpNeg)
        } else if k == TokenKind::Bang {
            self.parse_unary(UnaryOp::OpNot)
        } else if k == TokenKind::Amp {
            self.parse_unary(UnaryOp::OpRef)
        } else if k == TokenKind::AmpBang {
            self.parse_unary(UnaryOp::OpRefMut)
        } else if k == TokenKind::Star {
            self.parse_unary(UnaryOp::OpDeref)
        }
        // Literals
        else if k == TokenKind::IntLit || k == TokenKind::HexLit || k == TokenKind::BinLit || k == TokenKind::OctLit {
            self.parse_int_literal()
        } else if k == TokenKind::FloatLit {
            self.parse_float_literal()
        } else if k == TokenKind::StringLit {
            self.parse_string_literal()
        } else if k == TokenKind::CharLit {
            self.parse_char_literal()
        } else if k == TokenKind::True {
            let span = self.current_span()
            let p = self.advance()
            (p, mk_expr(ExprKind::ExprBoolTrue, span))
        } else if k == TokenKind::False {
            let span = self.current_span()
            let p = self.advance()
            (p, mk_expr(ExprKind::ExprBoolFalse, span))
        }
        // Grouping / tuple
        else if k == TokenKind::LParen {
            self.parse_paren_expr()
        }
        // Array literal
        else if k == TokenKind::LBracket {
            self.parse_array_literal()
        }
        // Block expression
        else if k == TokenKind::LBrace {
            self.parse_block_expr()
        }
        // Control flow
        else if k == TokenKind::If {
            self.parse_if_expr()
        } else if k == TokenKind::Match {
            self.parse_match_expr()
        } else if k == TokenKind::While {
            self.parse_while_expr()
        } else if k == TokenKind::Loop {
            self.parse_loop_expr()
        } else if k == TokenKind::For {
            self.parse_for_in_expr()
        } else if k == TokenKind::Return {
            self.parse_return_expr()
        } else if k == TokenKind::Break {
            self.parse_break_expr()
        } else if k == TokenKind::Continue {
            let span = self.current_span()
            let p = self.advance()
            (p, mk_expr(ExprKind::ExprContinue, span))
        }
        // Self
        else if k == TokenKind::SelfLower {
            let span = self.current_span()
            let name = self.current_name()
            let p = self.advance()
            var e = mk_expr(ExprKind::ExprIdent, span)
            e.name = name
            (p, e)
        }
        // Effect handler: handle<Effect> { body } with { handlers }
        else if k == TokenKind::Handle {
            self.parse_handle_expr()
        }
        // Closure: |params| body  or  || body
        else if k == TokenKind::Pipe {
            self.parse_closure_expr()
        } else if k == TokenKind::PipePipe {
            self.parse_closure_no_params()
        } else if k == TokenKind::ContestLower {
            self.parse_contest_expr()
        }
        // Identifier (variable, function name, enum path, struct literal)
        else if k == TokenKind::Ident {
            self.parse_ident_expr()
        }
        // Error recovery: advance past unrecognized token to avoid infinite loops
        else {
            let span = self.current_span()
            var p = self
            p.had_error = true
            p.error_count = p.error_count + 1
            p = p.advance()
            (p, error_expr(span))
        }
    }

    // ============================================================
    // Unary expression: -x, !x, &x, &!x, *x
    // ============================================================

    fn parse_unary(self, op: UnaryOp) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip operator
        let pair = p.parse_expr_bp(13)  // unary precedence
        p = pair.0
        let operand = pair.1
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprUnary, span)
        e.un_op = op
        e.left = Some(Box::new(operand))
        (p, e)
    }

    // ============================================================
    // Integer literal
    // ============================================================

    fn parse_int_literal(self) -> (Parser, Expr) with Mut, IO, Panic, Div {
        let span = self.current_span()
        let tok = self.current()
        let p = self.advance()
        var e = mk_expr(ExprKind::ExprIntLit, span)
        e.int_val = tok.int_value
        (p, e)
    }

    // ============================================================
    // Float literal
    // ============================================================

    fn parse_float_literal(self) -> (Parser, Expr) with Mut, IO, Panic, Div {
        let span = self.current_span()
        let tok = self.current()
        let p = self.advance()
        var e = mk_expr(ExprKind::ExprFloatLit, span)
        e.float_val = tok.float_value
        (p, e)
    }

    // ============================================================
    // String literal
    // ============================================================

    fn parse_string_literal(self) -> (Parser, Expr) with Mut, IO, Panic, Div {
        let span = self.current_span()
        let name = self.current_name()
        let p = self.advance()
        var e = mk_expr(ExprKind::ExprStringLit, span)
        e.name = name
        (p, e)
    }

    // ============================================================
    // Char literal
    // ============================================================

    fn parse_char_literal(self) -> (Parser, Expr) with Mut, IO, Panic, Div {
        let span = self.current_span()
        let tok = self.current()
        let p = self.advance()
        var e = mk_expr(ExprKind::ExprCharLit, span)
        e.int_val = tok.int_value
        (p, e)
    }

    fn parse_contest_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip contest
        p = p.expect(TokenKind::LBracket)

        var rev_models_opt: Option<Box<ExprList>> = None
        if p.peek() != TokenKind::RBracket {
            let first_pair = p.parse_contest_model_expr()
            p = first_pair.0
            rev_models_opt = Some(Box::new(ExprList { label: empty_name(), head: first_pair.1, tail: None }))

            while p.peek() == TokenKind::Comma {
                p = p.advance()
                let next_pair = p.parse_contest_model_expr()
                p = next_pair.0
                rev_models_opt = Some(Box::new(ExprList { label: empty_name(), head: next_pair.1, tail: rev_models_opt }))
            }
        }

        p = p.expect(TokenKind::RBracket)
        p = p.expect(TokenKind::On)
        let subject_pair = p.parse_expr()
        p = subject_pair.0

        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprContest, span)
        e.args = reverse_expr_list_opt(rev_models_opt)
        e.left = Some(Box::new(subject_pair.1))
        (p, e)
    }

    fn parse_contest_model_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div {
        let start = self.current_span()
        let pair = self.parse_type_path()
        let span = pair.0.span_from(start)
        var e = mk_expr(ExprKind::ExprPath, span)
        e.path = pair.1
        (pair.0, e)
    }

    // ============================================================
    // Parenthesized expression or tuple: (expr) or (a, b, c)
    // ============================================================

    fn parse_paren_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip (

        if p.peek() == TokenKind::RParen {
            // Unit value ()
            p = p.advance()
            let span = p.span_from(start)
            (p, mk_expr(ExprKind::ExprTupleLit, span))
        } else {
            let pair = p.parse_expr()
            p = pair.0
            let first = pair.1

            if p.peek() == TokenKind::Comma {
                // Tuple literal
                p = p.advance()
                var rev_list_opt: Option<Box<ExprList>> = Some(Box::new(ExprList { label: empty_name(), head: first, tail: None }))
                while p.peek() != TokenKind::RParen && p.peek() != TokenKind::Eof {
                    let pair2 = p.parse_expr()
                    p = pair2.0
                    let next = pair2.1
                    rev_list_opt = Some(Box::new(ExprList { label: empty_name(), head: next, tail: rev_list_opt }))
                    if p.peek() == TokenKind::Comma {
                        p = p.advance()
                    }
                }
                p = p.expect(TokenKind::RParen)
                let span = p.span_from(start)
                var e = mk_expr(ExprKind::ExprTupleLit, span)
                e.args = reverse_expr_list_opt(rev_list_opt)
                (p, e)
            } else {
                // Just grouping
                p = p.expect(TokenKind::RParen)
                (p, first)
            }
        }
    }

    // ============================================================
    // Array literal: [a, b, c] or [val; count]
    // ============================================================

    fn parse_array_literal(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip [

        if p.peek() == TokenKind::RBracket {
            // Empty array
            p = p.advance()
            let span = p.span_from(start)
            (p, mk_expr(ExprKind::ExprArrayLit, span))
        } else {
            let pair = p.parse_expr()
            p = pair.0
            let first = pair.1

            if p.peek() == TokenKind::Semi {
                // Array repeat: [val; count]
                p = p.advance()  // skip ;
                let pair2 = p.parse_expr()
                p = pair2.0.expect(TokenKind::RBracket)
                let count = pair2.1
                let span = p.span_from(start)
                var e = mk_expr(ExprKind::ExprArrayLit, span)
                e.left = Some(Box::new(first))
                e.right = Some(Box::new(count))
                (p, e)
            } else {
                // Array elements: [a, b, c]
                var rev_list_opt: Option<Box<ExprList>> = Some(Box::new(ExprList { label: empty_name(), head: first, tail: None }))
                while p.peek() == TokenKind::Comma {
                    p = p.advance()
                    if p.peek() == TokenKind::RBracket { break }
                    let pair2 = p.parse_expr()
                    p = pair2.0
                    let next = pair2.1
                    rev_list_opt = Some(Box::new(ExprList { label: empty_name(), head: next, tail: rev_list_opt }))
                }
                p = p.expect(TokenKind::RBracket)
                let span = p.span_from(start)
                var e = mk_expr(ExprKind::ExprArrayLit, span)
                e.args = reverse_expr_list_opt(rev_list_opt)
                (p, e)
            }
        }
    }

    // ============================================================
    // Block expression: { ... }
    // ============================================================

    fn parse_block_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        let pair = self.parse_block()
        let p = pair.0
        let blk = pair.1
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprBlock, span)
        e.block = Some(Box::new(blk))
        (p, e)
    }

    // ============================================================
    // Handle expression: handle<Effect> { body } with { handlers }
    // ============================================================

    fn parse_handle_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'handle'

        // Parse effect name: handle<Effect>
        p = p.expect(TokenKind::Lt)
        let effect_name = p.current_name()
        p = p.advance()  // skip effect ident
        p = p.expect(TokenKind::Gt)

        // Parse body block: { ... }
        let body_pair = p.parse_block()
        p = body_pair.0
        let body = body_pair.1

        // Parse optional handler: with { ... }
        var handler_opt: Option<Box<Block>> = None
        if p.peek() == TokenKind::With {
            p = p.advance()  // skip 'with'
            let handler_pair = p.parse_block()
            p = handler_pair.0
            handler_opt = Some(Box::new(handler_pair.1))
        }

        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprHandle, span)
        e.name = effect_name
        e.block = Some(Box::new(body))
        e.handler_block = handler_opt
        (p, e)
    }

    // ============================================================
    // Closure expression: |x: T, y: U| body  or  |x: T| -> R with E { body }
    // ============================================================

    fn parse_closure_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip opening '|'

        // Parse params until closing '|'
        var params: Option<Box<ClosureParamList>> = None
        if p.peek() != TokenKind::Pipe {
            let params_pair = p.parse_closure_params()
            p = params_pair.0
            params = params_pair.1
        }
        p = p.expect(TokenKind::Pipe)  // skip closing '|'

        // Parse optional return type: -> T
        var ret_type: Option<Box<TypeExpr>> = None
        if p.peek() == TokenKind::Arrow {
            p = p.advance()  // skip '->'
            let ty_pair = p.parse_type()
            p = ty_pair.0
            ret_type = Some(Box::new(ty_pair.1))
        }

        // Parse optional effects: with IO, Mut
        var effects: Option<Box<EffectList>> = None
        if p.peek() == TokenKind::With {
            let eff_pair = p.parse_effect_list()
            p = eff_pair.0
            effects = Some(Box::new(eff_pair.1))
        }

        // Parse body: block { ... } or single expression
        let body_pair = if p.peek() == TokenKind::LBrace {
            let blk_pair = p.parse_block()
            let blk_p = blk_pair.0
            let blk = blk_pair.1
            let blk_span = blk_p.span_from(start)
            var blk_expr = mk_expr(ExprKind::ExprBlock, blk_span)
            blk_expr.block = Some(Box::new(blk))
            (blk_p, blk_expr)
        } else {
            p.parse_expr()
        }
        p = body_pair.0
        let body = body_pair.1

        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprClosure, span)
        e.closure_params = params
        e.closure_return = ret_type
        e.closure_effects = effects
        e.closure_body = Some(Box::new(body))
        (p, e)
    }

    // Zero-param closure: || body  (PipePipe token)
    fn parse_closure_no_params(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip '||'

        // Parse optional return type: -> T
        var ret_type: Option<Box<TypeExpr>> = None
        if p.peek() == TokenKind::Arrow {
            p = p.advance()
            let ty_pair = p.parse_type()
            p = ty_pair.0
            ret_type = Some(Box::new(ty_pair.1))
        }

        // Parse optional effects: with IO, Mut
        var effects: Option<Box<EffectList>> = None
        if p.peek() == TokenKind::With {
            let eff_pair = p.parse_effect_list()
            p = eff_pair.0
            effects = Some(Box::new(eff_pair.1))
        }

        // Parse body
        let body_pair = if p.peek() == TokenKind::LBrace {
            let blk_pair = p.parse_block()
            let blk_p = blk_pair.0
            let blk = blk_pair.1
            let blk_span = blk_p.span_from(start)
            var blk_expr = mk_expr(ExprKind::ExprBlock, blk_span)
            blk_expr.block = Some(Box::new(blk))
            (blk_p, blk_expr)
        } else {
            p.parse_expr()
        }
        p = body_pair.0
        let body = body_pair.1

        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprClosure, span)
        e.closure_params = None
        e.closure_return = ret_type
        e.closure_effects = effects
        e.closure_body = Some(Box::new(body))
        (p, e)
    }

    // Parse comma-separated closure params: name: Type, name: Type
    fn parse_closure_params(self) -> (Parser, Option<Box<ClosureParamList>>) with Mut, IO, Panic, Div, Alloc {
        let pair = self.parse_closure_param()
        var p = pair.0
        let head = pair.1

        var tail: Option<Box<ClosureParamList>> = None
        if p.peek() == TokenKind::Comma {
            p = p.advance()  // skip ','
            if p.peek() != TokenKind::Pipe {
                let rest_pair = p.parse_closure_params()
                p = rest_pair.0
                tail = rest_pair.1
            }
        }

        let node = ClosureParamList { head: head, tail: tail }
        (p, Some(Box::new(node)))
    }

    // Parse single closure param: name: Type
    fn parse_closure_param(self) -> (Parser, ClosureParam) with Mut, IO, Panic, Div {
        let span = self.current_span()
        let name = self.current_name()
        var p = self.advance()  // skip param name
        p = p.expect(TokenKind::Colon)
        let ty_pair = p.parse_type()
        p = ty_pair.0
        let ty = ty_pair.1
        (p, ClosureParam { name: name, ty: ty, span: span })
    }

    // ============================================================
    // If expression: if cond { ... } [else { ... }]
    // ============================================================

    fn parse_if_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'if'
        // Restrict struct literals in condition to avoid { ambiguity
        p.no_struct_lit = true
        let pair = p.parse_expr()
        p = pair.0
        let cond = pair.1
        p.no_struct_lit = false
        let pair2 = p.parse_block()
        p = pair2.0
        let then_block = pair2.1

        var else_opt: Option<Box<Expr>> = None
        if p.peek() == TokenKind::Else {
            p = p.advance()  // skip 'else'
            if p.peek() == TokenKind::If {
                // else if
                let pair3 = p.parse_if_expr()
                p = pair3.0
                else_opt = Some(Box::new(pair3.1))
            } else {
                // else { ... }
                let pair3 = p.parse_block()
                p = pair3.0
                let else_block = pair3.1
                let else_span = p.span_from(start)
                var else_expr = mk_expr(ExprKind::ExprBlock, else_span)
                else_expr.block = Some(Box::new(else_block))
                else_opt = Some(Box::new(else_expr))
            }
        }

        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprIf, span)
        e.left = Some(Box::new(cond))
        e.block = Some(Box::new(then_block))
        e.else_expr = else_opt
        (p, e)
    }

    // ============================================================
    // Match expression: match expr { pat => body, ... }
    // ============================================================

    fn parse_match_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'match'
        // Restrict struct literals in scrutinee to avoid { ambiguity
        p.no_struct_lit = true
        let pair = p.parse_expr()
        p = pair.0
        let scrutinee = pair.1
        p.no_struct_lit = false
        p = p.expect(TokenKind::LBrace)

        // Parse arms
        var rev_arms_opt: Option<Box<MatchArmList>> = None

        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            let arm_start = p.current_span()
            let pair2 = p.parse_pattern()
            p = pair2.0
            let pattern = pair2.1
            p = p.expect(TokenKind::FatArrow)

            let pair3 = if p.peek() == TokenKind::LBrace {
                // Block body
                let pair4 = p.parse_block()
                let pb = pair4.0
                let blk = pair4.1
                let blk_span = pb.span_from(arm_start)
                var be = mk_expr(ExprKind::ExprBlock, blk_span)
                be.block = Some(Box::new(blk))
                (pb, be)
            } else {
                p.parse_expr()
            }
            p = pair3.0
            let body = pair3.1

            let arm = MatchArm { pattern: pattern, body: body, span: p.span_from(arm_start) }
            rev_arms_opt = Some(Box::new(MatchArmList { head: arm, tail: rev_arms_opt }))

            // Skip comma between arms
            if p.peek() == TokenKind::Comma {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprMatch, span)
        e.left = Some(Box::new(scrutinee))
        e.arms = reverse_match_arm_list_opt(rev_arms_opt)
        (p, e)
    }

    // ============================================================
    // While expression: while cond { ... }
    // ============================================================

    fn parse_while_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'while'
        // Restrict struct literals in condition to avoid { ambiguity
        p.no_struct_lit = true
        let pair = p.parse_expr()
        p = pair.0
        let cond = pair.1
        p.no_struct_lit = false
        let pair2 = p.parse_block()
        p = pair2.0
        let body = pair2.1
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprWhile, span)
        e.left = Some(Box::new(cond))
        e.block = Some(Box::new(body))
        (p, e)
    }

    // ============================================================
    // Loop expression: loop { ... }
    // ============================================================

    fn parse_loop_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'loop'
        let pair = p.parse_block()
        p = pair.0
        let body = pair.1
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprLoop, span)
        e.block = Some(Box::new(body))
        (p, e)
    }

    // ============================================================
    // For-in expression: for x in iter_expr { body }
    // ============================================================

    fn parse_for_in_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'for'

        // Parse binding name
        let binding_name = p.current_name()
        p = p.advance()  // skip ident

        // Expect 'in'
        p = p.expect(TokenKind::In)

        // Parse iterator expression (restrict struct lits to avoid { ambiguity)
        p.no_struct_lit = true
        let pair = p.parse_expr()
        p = pair.0
        let iter_expr = pair.1
        p.no_struct_lit = false

        // Parse body block
        let pair2 = p.parse_block()
        p = pair2.0
        let body = pair2.1

        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprForIn, span)
        e.name = binding_name
        e.left = Some(Box::new(iter_expr))
        e.block = Some(Box::new(body))
        (p, e)
    }

    // ============================================================
    // Return expression: return [expr]
    // ============================================================

    fn parse_return_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'return'
        var e = mk_expr(ExprKind::ExprReturn, start)
        if p.at_expr_start() {
            let pair = p.parse_expr()
            p = pair.0
            e.left = Some(Box::new(pair.1))
            e.span = p.span_from(start)
        }
        (p, e)
    }

    // ============================================================
    // Break expression: break [expr]
    // ============================================================

    fn parse_break_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'break'
        var e = mk_expr(ExprKind::ExprBreak, start)
        if p.at_expr_start() {
            let pair = p.parse_expr()
            p = pair.0
            e.left = Some(Box::new(pair.1))
            e.span = p.span_from(start)
        }
        (p, e)
    }

    // ============================================================
    // Identifier expression (variable, path, struct literal, call)
    // ============================================================

    fn parse_ident_expr(self) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        let name = self.current_name()

        // Check for path: Foo::Bar::baz or turbofish: foo::<T>(args)
        if self.peek_ahead(1) == TokenKind::ColonColon {
            let pair = self.parse_type_path()
            var p1 = pair.0
            let path = pair.1

            // Turbofish: ident_or_path followed by ::<T, U>
            // parse_type_path stops when :: is not followed by Ident,
            // so ::<T> leaves us at the :: token.
            var turbofish_args: Option<Box<TypeExprList>> = None
            if p1.peek() == TokenKind::ColonColon && p1.peek_ahead(1) == TokenKind::Lt {
                p1 = p1.advance()  // skip ::
                let ta_pair = p1.parse_type_args()
                p1 = ta_pair.0
                turbofish_args = Some(Box::new(ta_pair.1))
            }

            if !p1.no_struct_lit && p1.peek() == TokenKind::LBrace {
                // Struct literal: Foo { x: 1, y: 2 }
                p1.parse_struct_literal(path, start)
            } else {
                // Path expression: Foo::Bar or turbofish path
                let span = p1.span_from(start)
                var e = mk_expr(ExprKind::ExprPath, span)
                e.path = path
                e.type_args = turbofish_args
                (p1, e)
            }
        } else if !self.no_struct_lit && self.peek_ahead(1) == TokenKind::LBrace {
            // Struct literal with simple name: Point { x: 1, y: 2 }
            var p = self.advance()
            let path = AstPath {
                segments: StringList { head_buf: name.buf, head_len: name.len, tail: None },
                seg_count: 1,
            }
            p.parse_struct_literal(path, start)
        } else {
            // Simple identifier
            let span = self.current_span()
            let p = self.advance()
            var e = mk_expr(ExprKind::ExprIdent, span)
            e.name = name
            (p, e)
        }
    }

    // ============================================================
    // Struct literal: Path { field: expr, ... }
    // ============================================================

    fn parse_struct_literal(self, path: AstPath, start: Span) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        var p = self.advance()  // skip {

        var rev_fields_opt: Option<Box<StructFieldList>> = None

        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            let field_name = p.current_name()
            p = p.expect_ident()
            p = p.expect(TokenKind::Colon)
            let pair = p.parse_expr()
            p = pair.0
            let field_val = pair.1

            let field = StructFieldInit { name: field_name, value: field_val }
            rev_fields_opt = Some(Box::new(StructFieldList { head: field, tail: rev_fields_opt }))

            if p.peek() == TokenKind::Comma {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprStructLit, span)
        e.path = path
        e.fields = reverse_struct_field_list_opt(rev_fields_opt)
        (p, e)
    }

    // ============================================================
    // Call expression: callee(arg1, arg2)
    // ============================================================

    fn parse_call_arg_expr(self) -> (Parser, ExprList) with Mut, IO, Panic, Div, Alloc {
        var p = self
        var label = empty_name()

        if p.peek() == TokenKind::Ident && p.peek_ahead(1) == TokenKind::Colon {
            label = p.current_name()
            p = p.advance()
            p = p.expect(TokenKind::Colon)
        }
        let pair = p.parse_expr()
        (pair.0, ExprList { label: label, head: pair.1, tail: None })
    }

    fn parse_call_expr(self, callee: Expr) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = callee.span
        var p = self.advance()  // skip (

        var args_opt: Option<Box<ExprList>> = None

        if p.peek() != TokenKind::RParen {
            let pair = p.parse_call_arg_expr()
            p = pair.0
            let first = pair.1
            var rev_list_opt: Option<Box<ExprList>> = Some(Box::new(first))

            while p.peek() == TokenKind::Comma {
                p = p.advance()
                if p.peek() == TokenKind::RParen { break }
                let pair2 = p.parse_call_arg_expr()
                p = pair2.0
                let next = pair2.1
                rev_list_opt = Some(Box::new(ExprList { label: next.label, head: next.head, tail: rev_list_opt }))
            }

            args_opt = reverse_expr_list_opt(rev_list_opt)
        }

        p = p.expect(TokenKind::RParen)
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprCall, span)
        // Propagate turbofish type args from callee path to call expression
        // (callee.type_args is set by parse_ident_expr for foo::<T>(...) syntax)
        e.type_args = callee.type_args
        e.left = Some(Box::new(callee))
        e.args = args_opt
        e = rewrite_hardware_publish_call(e)
        (p, e)
    }

    // ============================================================
    // Index expression: base[index]
    // ============================================================

    fn parse_index_expr(self, base: Expr) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = base.span
        var p = self.advance()  // skip [
        let pair = p.parse_expr()
        p = pair.0.expect(TokenKind::RBracket)
        let index = pair.1
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprIndex, span)
        e.left = Some(Box::new(base))
        e.right = Some(Box::new(index))
        (p, e)
    }

    // ============================================================
    // Dot expression: field access or method call
    // ============================================================

    fn parse_dot_expr(self, base: Expr) -> (Parser, Expr) with Mut, IO, Panic, Div, Alloc {
        let start = base.span
        var p = self.advance()  // skip .
        let name = p.current_name()
        p = p.advance()  // skip field/method name

        if p.peek() == TokenKind::LParen {
            // Method call: base.method(args)
            p = p.advance()  // skip (
            var args_opt: Option<Box<ExprList>> = None

            if p.peek() != TokenKind::RParen {
                let pair = p.parse_call_arg_expr()
                p = pair.0
                let first = pair.1
                var rev_list_opt: Option<Box<ExprList>> = Some(Box::new(first))

                while p.peek() == TokenKind::Comma {
                    p = p.advance()
                    if p.peek() == TokenKind::RParen { break }
                    let pair2 = p.parse_call_arg_expr()
                    p = pair2.0
                    let next = pair2.1
                    rev_list_opt = Some(Box::new(ExprList { label: next.label, head: next.head, tail: rev_list_opt }))
                }
                args_opt = reverse_expr_list_opt(rev_list_opt)
            }

            p = p.expect(TokenKind::RParen)
            let span = p.span_from(start)
            var e = mk_expr(ExprKind::ExprMethodCall, span)
            e.name = name
            e.left = Some(Box::new(base))
            e.args = args_opt
            (p, e)
        } else {
            // Field access: base.field
            let span = p.span_from(start)
            var e = mk_expr(ExprKind::ExprFieldAccess, span)
            e.name = name
            e.left = Some(Box::new(base))
            (p, e)
        }
    }
}

// ============================================================
// hardware_publish canonicalization helpers
// ============================================================

fn rewrite_hardware_publish_call(call_expr: Expr) -> Expr with Mut, Panic, Div, Alloc {
    if call_expr.kind != ExprKind::ExprCall {
        return call_expr
    }

    match call_expr.left {
        Some(callee_box) => {
            let callee = *callee_box
            if callee.kind != ExprKind::ExprIdent || !exprs_name_is_hardware_publish(callee.name) {
                return call_expr
            }

            let args_pair = rewrite_hardware_publish_args(call_expr.args)
            let rewritten_args = args_pair.0
            let op_kind = args_pair.1
            if op_kind < 0 {
                return call_expr
            }

            var rewritten = call_expr
            var intrinsic = callee
            intrinsic.name = exprs_name_knowledge_kaxi_publish()
            rewritten.left = Some(Box::new(intrinsic))
            rewritten.args = rewritten_args
            rewritten
        }
        _ => call_expr,
    }
}

fn rewrite_hardware_publish_args(
    args: Option<Box<ExprList>>
) -> (Option<Box<ExprList>>, i64) with Mut, Panic, Div, Alloc {
    match args {
        Some(list) => {
            let arg0 = (*list).head
            match (*list).tail {
                Some(tail1) => {
                    let arg1 = (*tail1).head
                    let arg_rest = (*tail1).tail
                    let op_kind = kaxi_op_kind_from_expr(arg1)
                    if op_kind < 0 {
                        let original_tail = Some(Box::new(ExprList { label: empty_name(), head: arg1, tail: arg_rest }))
                        (Some(Box::new(ExprList { label: empty_name(), head: arg0, tail: original_tail })), -1)
                    } else {
                        let op_lit = expr_int_lit(arg1.span, op_kind)
                        let rewritten_tail = Some(Box::new(ExprList { label: empty_name(), head: op_lit, tail: arg_rest }))
                        (Some(Box::new(ExprList { label: empty_name(), head: arg0, tail: rewritten_tail })), op_kind)
                    }
                }
                _ => (Some(Box::new(ExprList { label: empty_name(), head: arg0, tail: None })), -1),
            }
        }
        _ => (None, -1),
    }
}

fn kaxi_op_kind_from_expr(e: Expr) -> i64 with Mut, Panic, Div, Alloc {
    if e.kind != ExprKind::ExprPath {
        return -1
    }
    if e.path.seg_count < 2 {
        return -1
    }
    if !path_first_is_kaxi(e.path) {
        return -1
    }

    let op = path_last_name(e.path)
    if name_eq3(op, 97 as i8, 100 as i8, 100 as i8) { return 1 }               // add
    if name_eq3(op, 109 as i8, 117 as i8, 108 as i8) { return 2 }              // mul
    if name_eq3(op, 100 as i8, 105 as i8, 118 as i8) { return 3 }              // div
    if name_eq3(op, 102 as i8, 109 as i8, 97 as i8) { return 4 }               // fma
    if name_eq4(op, 112 as i8, 97 as i8, 115 as i8, 115 as i8) { return 0 }    // pass
    if name_eq8(op,
        112 as i8, 114 as i8, 111 as i8, 112 as i8,
        95 as i8, 118 as i8, 97 as i8, 114 as i8) { return 5 }                 // prop_var
    -1
}

fn expr_int_lit(span: Span, value: i64) -> Expr {
    var e = mk_expr(ExprKind::ExprIntLit, span)
    e.int_val = value
    e
}

fn exprs_name_is_hardware_publish(n: Name) -> bool {
    name_eq16(n,
        104 as i8, 97 as i8, 114 as i8, 100 as i8,
        119 as i8, 97 as i8, 114 as i8, 101 as i8,
        95 as i8, 112 as i8, 117 as i8, 98 as i8,
        108 as i8, 105 as i8, 115 as i8, 104 as i8
    )
}

fn exprs_name_knowledge_kaxi_publish() -> Name with Mut, Panic {
    var n = Name { buf: [0; 128], len: 24 }
    // "__knowledge_kaxi_publish"
    n.buf[0] = 95 as i8
    n.buf[1] = 95 as i8
    n.buf[2] = 107 as i8
    n.buf[3] = 110 as i8
    n.buf[4] = 111 as i8
    n.buf[5] = 119 as i8
    n.buf[6] = 108 as i8
    n.buf[7] = 101 as i8
    n.buf[8] = 100 as i8
    n.buf[9] = 103 as i8
    n.buf[10] = 101 as i8
    n.buf[11] = 95 as i8
    n.buf[12] = 107 as i8
    n.buf[13] = 97 as i8
    n.buf[14] = 120 as i8
    n.buf[15] = 105 as i8
    n.buf[16] = 95 as i8
    n.buf[17] = 112 as i8
    n.buf[18] = 117 as i8
    n.buf[19] = 98 as i8
    n.buf[20] = 108 as i8
    n.buf[21] = 105 as i8
    n.buf[22] = 115 as i8
    n.buf[23] = 104 as i8
    n
}

fn path_first_is_kaxi(path: AstPath) -> bool {
    if path.seg_count < 2 {
        return false
    }
    let seg = path.segments
    seg.head_len == 4 &&
    seg.head_buf[0] == 75 as i8 &&  // K
    seg.head_buf[1] == 65 as i8 &&  // A
    seg.head_buf[2] == 88 as i8 &&  // X
    seg.head_buf[3] == 73 as i8     // I
}

fn exprs_copy_string_list_to_name(seg: StringList) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: seg.head_len }
    var i: i64 = 0
    while i < seg.head_len && i < 128 {
        n.buf[i] = seg.head_buf[i]
        i = i + 1
    }
    n
}

fn path_last_name(path: AstPath) -> Name with Mut, Panic, Div, Alloc {
    if path.seg_count <= 0 {
        return empty_name()
    }
    if path.seg_count == 1 {
        return exprs_copy_string_list_to_name(path.segments)
    }
    string_list_last_name(path.segments)
}

fn string_list_last_name(list: StringList) -> Name with Mut, Panic, Div, Alloc {
    match list.tail {
        Some(rest) => string_list_last_name(*rest),
        _ => exprs_copy_string_list_to_name(list),
    }
}

fn name_eq3(n: Name, a: i8, b: i8, c: i8) -> bool {
    n.len == 3 && n.buf[0] == a && n.buf[1] == b && n.buf[2] == c
}

fn name_eq4(n: Name, a: i8, b: i8, c: i8, d: i8) -> bool {
    n.len == 4 && n.buf[0] == a && n.buf[1] == b && n.buf[2] == c && n.buf[3] == d
}

fn name_eq8(
    n: Name,
    a0: i8, a1: i8, a2: i8, a3: i8,
    a4: i8, a5: i8, a6: i8, a7: i8
) -> bool {
    n.len == 8 &&
    n.buf[0] == a0 && n.buf[1] == a1 && n.buf[2] == a2 && n.buf[3] == a3 &&
    n.buf[4] == a4 && n.buf[5] == a5 && n.buf[6] == a6 && n.buf[7] == a7
}

fn name_eq16(
    n: Name,
    a0: i8, a1: i8, a2: i8, a3: i8,
    a4: i8, a5: i8, a6: i8, a7: i8,
    a8: i8, a9: i8, a10: i8, a11: i8,
    a12: i8, a13: i8, a14: i8, a15: i8
) -> bool {
    n.len == 16 &&
    n.buf[0] == a0 && n.buf[1] == a1 && n.buf[2] == a2 && n.buf[3] == a3 &&
    n.buf[4] == a4 && n.buf[5] == a5 && n.buf[6] == a6 && n.buf[7] == a7 &&
    n.buf[8] == a8 && n.buf[9] == a9 && n.buf[10] == a10 && n.buf[11] == a11 &&
    n.buf[12] == a12 && n.buf[13] == a13 && n.buf[14] == a14 && n.buf[15] == a15
}

// ============================================================
// Token to binary operator mapping
// ============================================================

fn token_to_binop(kind: TokenKind) -> BinaryOp {
    match kind {
        TokenKind::Plus => BinaryOp::OpAdd,
        TokenKind::Minus => BinaryOp::OpSub,
        TokenKind::Star => BinaryOp::OpMul,
        TokenKind::Slash => BinaryOp::OpDiv,
        TokenKind::Percent => BinaryOp::OpRem,
        TokenKind::EqEq => BinaryOp::OpEq,
        TokenKind::BangEq => BinaryOp::OpNe,
        TokenKind::Lt => BinaryOp::OpLt,
        TokenKind::LtEq => BinaryOp::OpLe,
        TokenKind::Gt => BinaryOp::OpGt,
        TokenKind::GtEq => BinaryOp::OpGe,
        TokenKind::AmpAmp => BinaryOp::OpAnd,
        TokenKind::PipePipe => BinaryOp::OpOr,
        TokenKind::Amp => BinaryOp::OpBitAnd,
        TokenKind::Pipe => BinaryOp::OpBitOr,
        TokenKind::Caret => BinaryOp::OpBitXor,
        TokenKind::Shl => BinaryOp::OpShl,
        TokenKind::Shr => BinaryOp::OpShr,
        TokenKind::PlusPlus => BinaryOp::OpConcat,
        TokenKind::DotDot => BinaryOp::OpRange,
        TokenKind::DotDotEq => BinaryOp::OpRangeInclusive,
        _ => BinaryOp::OpAdd,
    }
}

// ============================================================
// Linked-list helpers for expression parsing
// ============================================================

fn reverse_expr_list_opt(list: Option<Box<ExprList>>) -> Option<Box<ExprList>> with Mut, Alloc {
    reverse_expr_list_loop(list, None)
}

fn reverse_expr_list_loop(
    current: Option<Box<ExprList>>,
    acc: Option<Box<ExprList>>,
) -> Option<Box<ExprList>> with Mut, Alloc {
    match current {
        None => acc,
        Some(node) => {
            let next = (*node).tail
            let rev_node = ExprList { label: (*node).label, head: (*node).head, tail: acc }
            reverse_expr_list_loop(next, Some(Box::new(rev_node)))
        },
    }
}

fn reverse_match_arm_list_opt(list: Option<Box<MatchArmList>>) -> Option<Box<MatchArmList>> with Mut, Alloc {
    reverse_match_arm_list_loop(list, None)
}

fn reverse_match_arm_list_loop(
    current: Option<Box<MatchArmList>>,
    acc: Option<Box<MatchArmList>>,
) -> Option<Box<MatchArmList>> with Mut, Alloc {
    match current {
        None => acc,
        Some(node) => {
            let next = (*node).tail
            let rev_node = MatchArmList { head: (*node).head, tail: acc }
            reverse_match_arm_list_loop(next, Some(Box::new(rev_node)))
        },
    }
}

fn reverse_struct_field_list_opt(list: Option<Box<StructFieldList>>) -> Option<Box<StructFieldList>> with Mut, Alloc {
    reverse_struct_field_list_loop(list, None)
}

fn reverse_struct_field_list_loop(
    current: Option<Box<StructFieldList>>,
    acc: Option<Box<StructFieldList>>,
) -> Option<Box<StructFieldList>> with Mut, Alloc {
    match current {
        None => acc,
        Some(node) => {
            let next = (*node).tail
            let rev_node = StructFieldList { head: (*node).head, tail: acc }
            reverse_struct_field_list_loop(next, Some(Box::new(rev_node)))
        },
    }
}
