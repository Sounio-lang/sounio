// Parser — Pratt expression parser
//
// Precedence-climbing for binary operators, prefix/postfix handling,
// and all expression forms (literals, calls, field access, if, match, etc).
//
// LEAN-COMPILER NOTE: All functions that previously returned (Parser, Expr)
// now return Parser only.  The Expr result is stored in the LAST_EXPR global
// (parser_store_expr_box / parser_take_expr_box).  This eliminates the 74-slot
// (Parser, Expr) SRET which corrupts rdi in the lean compiler.

use parser::ast::*
use lexer::token::*
use parser::parser::{parser_peek, parser_at_eof, pt_read_kind, pt_read_kind_code, parser_peek_ahead, parser_assign_op_code, parser_advance, mk_expr, error_expr, dummy_type_expr, parser_store_expr_box, parser_take_expr_box}
use parser::types::*
use parser::stmts::*
use parser::patterns::*

fn expr_kind_ends_line_stmt(kind: ExprKind) -> bool {
    kind == ExprKind::ExprIf
        || kind == ExprKind::ExprMatch
        || kind == ExprKind::ExprWhile
        || kind == ExprKind::ExprLoop
        || kind == ExprKind::ExprBlock
        || kind == ExprKind::ExprForIn
}

impl Parser {
    // ============================================================
    // Expression entry point (dispatches to Pratt parser)
    // ============================================================

    fn parse_expr(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        self.parse_expr_bp(0)
    }

    // ============================================================
    // Pratt parser: parse expression with minimum binding power
    // ============================================================

    fn parse_expr_bp(self, min_bp: i64) -> Parser with Mut, IO, Panic, Div, Alloc {
        // Parse prefix / atom; result stored in LAST_EXPR
        var p = self.parse_prefix()
        var lhs = parser_take_expr_box()

        // Parse infix operators
        while !parser_at_eof(p) {
            if parser_assign_op_code(p) >= 0 { break }
            let op_kind = parser_peek(p)
            let op_code = pt_read_kind_code(p.pos)
            if op_code == 175 || op_code == 177 || op_code == 179 || op_code == 180 || op_code == 182 {
                break
            }

            // Postfix: function call, method call, field access, index
            // A `(` after a newline is NOT a call — it starts a new expression.
            if op_kind == TokenKind::LParen || op_code == 174 {
                if p.had_newline_before() { break }
                p = p.parse_call_expr_box(lhs)
                lhs = parser_take_expr_box()
                continue
            }

            // A `[` after a newline is NOT an index -- it starts a new expression
            // statement (array literal), mirroring the LParen guard above. Without
            // this, `let x = foo\n[a, b]` glues into `foo[a, b]`.
            if op_kind == TokenKind::LBracket || op_code == 178 {
                if p.had_newline_before() { break }
                p = p.parse_index_expr_box(lhs)
                lhs = parser_take_expr_box()
                continue
            }

            if op_kind == TokenKind::Dot || op_code == 183 {
                p = p.parse_dot_expr_box(lhs)
                lhs = parser_take_expr_box()
                continue
            }

            if op_kind == TokenKind::AuditLower {
                p = p.advance()
                let audit_name = p.current_name()
                p = p.expect_ident()
                let lhs_span = lhs.span
                let span = p.span_from(lhs_span)
                var audit_e = mk_expr(ExprKind::ExprAuditAttach, span)
                audit_e.left = Some(lhs)
                audit_e.name = audit_name
                lhs = Box::new(audit_e)
                continue
            }

            // A control/block expression followed by a newline starts a new
            // statement. Without this, `while { ... }\n-1` becomes
            // `(while { ... }) - 1` and type-checks as `() - i64`.
            if p.had_newline_before() && expr_kind_ends_line_stmt((*lhs).kind) {
                break
            }

            // `*`/`&`/`&!` are both infix (mul/bitand) and prefix (deref/ref).
            // At the start of a line, a *tight* one (no space before its
            // operand: `*b`, `&x`) is a prefix expression beginning a NEW
            // statement -- without this `let b = Box::new(7)\n*b` glues into
            // `Box::new(7) * b`. A *spaced* one (`* energy_accurate`) is a
            // multiply/bitand continuation and must keep flowing (mirrors
            // Swift's whitespace-asymmetry rule: left space + no right space =
            // prefix). Trailing continuations (`a *\n b`) are unaffected: the
            // newline sits before the rhs, not before the operator.
            if p.had_newline_before()
                && (op_kind == TokenKind::Star || op_kind == TokenKind::Amp || op_kind == TokenKind::AmpBang)
                && p.pos + 1 < p.token_count
                && PT_END[p.pos as usize] == PT_START[(p.pos + 1) as usize] {
                break
            }

            // `!`/`~` carry a postfix precedence (13) but are also prefix operators
            // (logical-not / bitwise-not). At the start of a line, a *tight* one
            // (`!b`, `~x`: no space before its operand) begins a NEW statement -- without
            // this `let b = x\n!b` glues into `x ! b`, which references `b` inside its own
            // initializer (E137 undeclared). A real postfix `x!` has the newline AFTER the
            // operand, so `had_newline_before` at the operator is false and is unaffected.
            if p.had_newline_before()
                && (op_kind == TokenKind::Bang || op_kind == TokenKind::Tilde)
                && p.pos + 1 < p.token_count
                && PT_END[p.pos as usize] == PT_START[(p.pos + 1) as usize] {
                break
            }

            let prec = tk_precedence(op_kind)

            // Stop if current operator has lower or equal precedence
            if prec <= min_bp { break }

            // Range operators (non-associative)
            if op_kind == TokenKind::DotDot || op_kind == TokenKind::DotDotEq {
                let bin_op = if op_kind == TokenKind::DotDot { BinaryOp::OpRange } else { BinaryOp::OpRangeInclusive }
                p = p.advance()
                if p.at_expr_start() {
                    p = p.parse_expr_bp(prec)
                    let rhs = parser_take_expr_box()
                    let lhs_span = lhs.span
                    let span = p.span_from(lhs_span)
                    var range_e = mk_expr(ExprKind::ExprRange, span)
                    range_e.bin_op = bin_op
                    range_e.left = Some(lhs)
                    range_e.right = Some(rhs)
                    lhs = Box::new(range_e)
                } else {
                    // Half-open range: expr..
                    let lhs_span = lhs.span
                    let span = p.span_from(lhs_span)
                    var range_e = mk_expr(ExprKind::ExprRange, span)
                    range_e.bin_op = bin_op
                    range_e.left = Some(lhs)
                    range_e.right = None
                    lhs = Box::new(range_e)
                }
                continue
            }

            // Type cast: expr as Type
            if op_kind == TokenKind::As {
                p = p.advance()  // skip 'as'
                let pair2 = p.parse_type()
                p = pair2.0
                let target_ty = pair2.1
                let lhs_span = lhs.span
                let span = p.span_from(lhs_span)
                var cast_e = mk_expr(ExprKind::ExprCast, span)
                cast_e.left = Some(lhs)
                cast_e.cast_type = Some(Box::new(target_ty))
                lhs = Box::new(cast_e)
                continue
            }

            // Standard binary operator
            if prec == 0 { break }

            let bin_op = token_to_binop(op_kind)
            p = p.advance()

            // Right-hand side: use prec for left-associativity
            p = p.parse_expr_bp(prec)
            let rhs = parser_take_expr_box()
            let lhs_span = lhs.span
            let span = p.span_from(lhs_span)

            var bin_e = mk_expr(ExprKind::ExprBinary, span)
            bin_e.bin_op = bin_op
            bin_e.left = Some(lhs)
            bin_e.right = Some(rhs)
            lhs = Box::new(bin_e)
        }

        parser_store_expr_box(lhs)
        p
    }

    // ============================================================
    // Prefix / atom expressions
    // ============================================================

    fn parse_prefix(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        let k = self.peek()

        // Unary operators
        if k == TokenKind::Minus {
            self.parse_unary(UnaryOp::OpNeg)
        } else if k == TokenKind::Bang {
            self.parse_unary(UnaryOp::OpNot)
        } else if k == TokenKind::Tilde {
            self.parse_unary(UnaryOp::OpNot)
        } else if k == TokenKind::Amp {
            self.parse_unary(UnaryOp::OpRef)
        } else if k == TokenKind::AmpBang {
            self.parse_unary(UnaryOp::OpRefMut)
        } else if k == TokenKind::Star {
            self.parse_unary(UnaryOp::OpDeref)
        }
        // Literals
        else if k == TokenKind::IntLit || k == TokenKind::HexLit || k == TokenKind::BinLit || k == TokenKind::OctLit {
            self.parse_int_literal()
        } else if k == TokenKind::FloatLit {
            self.parse_float_literal()
        } else if k == TokenKind::StringLit {
            self.parse_string_literal()
        } else if k == TokenKind::CharLit {
            self.parse_char_literal()
        } else if k == TokenKind::True {
            let span = self.current_span()
            let p = self.advance()
            parser_store_expr_box(Box::new(mk_expr(ExprKind::ExprBoolTrue, span)))
            p
        } else if k == TokenKind::False {
            let span = self.current_span()
            let p = self.advance()
            parser_store_expr_box(Box::new(mk_expr(ExprKind::ExprBoolFalse, span)))
            p
        }
        // Grouping / tuple
        else if k == TokenKind::LParen {
            self.parse_paren_expr()
        }
        // Array literal
        else if k == TokenKind::LBracket {
            self.parse_array_literal()
        }
        // Block expression
        else if k == TokenKind::LBrace {
            self.parse_block_expr()
        }
        // Control flow
        else if k == TokenKind::If {
            self.parse_if_expr()
        } else if k == TokenKind::Match {
            self.parse_match_expr()
        } else if k == TokenKind::While {
            self.parse_while_expr()
        } else if k == TokenKind::Loop {
            self.parse_loop_expr()
        } else if k == TokenKind::For {
            self.parse_for_in_expr()
        } else if k == TokenKind::Return {
            self.parse_return_expr()
        } else if k == TokenKind::Break {
            self.parse_break_expr()
        } else if k == TokenKind::Continue {
            let span = self.current_span()
            let p = self.advance()
            parser_store_expr_box(Box::new(mk_expr(ExprKind::ExprContinue, span)))
            p
        }
        // Self
        else if k == TokenKind::SelfLower {
            let span = self.current_span()
            let name = self.current_name()
            let p = self.advance()
            var e = mk_expr(ExprKind::ExprIdent, span)
            e.name = name
            parser_store_expr_box(Box::new(e))
            p
        }
        // Effect handler: handle<Effect> { body } with { handlers }
        else if k == TokenKind::Handle {
            if parser_peek_ahead(self, 1) == TokenKind::Lt {
                self.parse_handle_expr()
            } else {
                self.parse_ident_expr()
            }
        }
        // Effect operation: perform E.op(args)
        else if k == TokenKind::Perform {
            self.parse_perform_expr()
        }
        // Async/spawn blocks are parsed conservatively as block-shaped
        // expressions; async runtime lowering is handled outside this layer.
        else if k == TokenKind::Async {
            self.parse_async_like_block_expr()
        } else if k == TokenKind::Spawn {
            self.parse_async_like_block_expr()
        }
        // Closure: |params| body  or  || body
        else if k == TokenKind::Pipe {
            self.parse_closure_expr()
        } else if k == TokenKind::PipePipe {
            self.parse_closure_no_params()
        } else if k == TokenKind::ContestLower {
            self.parse_contest_expr()
        }
        // Identifier (variable, function name, enum path, struct literal).
        // TokenKind::Var is included so bare `var` works as a binding *use*
        // after `let var = ...` (contextual keyword; see patterns.sio).
        // Statement `var x = ...` is dispatched from parse_stmt, not here.
        else if k == TokenKind::Ident || k == TokenKind::Knowledge || k == TokenKind::Close || k == TokenKind::Unit || k == TokenKind::Kernel || k == TokenKind::Var || tk_is_contextual_ident(k) {
            self.parse_ident_expr()
        }
        // Error recovery: advance past unrecognized token to avoid infinite loops
        else {
            let span = self.current_span()
            var p = self
            p.had_error = true
            p.error_count = p.error_count + 1
            p = p.advance()
            parser_store_expr_box(Box::new(error_expr(span)))
            p
        }
    }

    // ============================================================
    // Unary expression: -x, !x, ~x, &x, &!x, *x
    // ============================================================

    fn parse_unary(self, op: UnaryOp) -> Parser with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip operator
        p = p.parse_expr_bp(13)  // unary precedence
        let operand = parser_take_expr_box()
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprUnary, span)
        e.un_op = op
        e.left = Some(operand)
        parser_store_expr_box(Box::new(e))
        p
    }

    // ============================================================
    // Integer literal
    // ============================================================

    fn parse_int_literal(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        let span = self.current_span()
        let tok = self.current()
        let p = self.advance()
        var e = mk_expr(ExprKind::ExprIntLit, span)
        e.int_val = tok.int_value
        parser_store_expr_box(Box::new(e))
        p
    }

    // ============================================================
    // Float literal
    // ============================================================

    fn parse_float_literal(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        let span = self.current_span()
        let tok = self.current()
        let p = self.advance()
        var e = mk_expr(ExprKind::ExprFloatLit, span)
        e.float_val = tok.float_value
        parser_store_expr_box(Box::new(e))
        p
    }

    // ============================================================
    // String literal
    // ============================================================

    fn parse_string_literal(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        let span = self.current_span()
        let name = self.current_name()
        let p = self.advance()
        var e = mk_expr(ExprKind::ExprStringLit, span)
        e.name = name
        parser_store_expr_box(Box::new(e))
        p
    }

    // ============================================================
    // Char literal
    // ============================================================

    fn parse_char_literal(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        let span = self.current_span()
        let tok = self.current()
        let p = self.advance()
        var e = mk_expr(ExprKind::ExprCharLit, span)
        e.int_val = tok.int_value
        parser_store_expr_box(Box::new(e))
        p
    }

    fn parse_contest_expr(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip contest
        p = p.expect(TokenKind::LBracket)

        var rev_models_opt: Option<Box<ExprList>> = None
        if parser_peek(p) != TokenKind::RBracket {
            p = p.parse_contest_model_expr()
            let first_box = parser_take_expr_box()
            rev_models_opt = Some(Box::new(ExprList { label: empty_name(), head: *first_box, tail: None }))

            while parser_peek(p) == TokenKind::Comma {
                p = p.advance()
                p = p.parse_contest_model_expr()
                let next_box = parser_take_expr_box()
                rev_models_opt = Some(Box::new(ExprList { label: empty_name(), head: *next_box, tail: rev_models_opt }))
            }
        }

        p = p.expect(TokenKind::RBracket)
        p = p.expect(TokenKind::On)
        p = p.parse_expr()
        let subject_box = parser_take_expr_box()

        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprContest, span)
        e.args = reverse_expr_list_opt(rev_models_opt)
        e.left = Some(subject_box)
        parser_store_expr_box(Box::new(e))
        p
    }

    fn parse_contest_model_expr(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self
        var path = empty_path()
        p = p.parse_type_path_into(&! path)
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprPath, span)
        e.path = path
        parser_store_expr_box(Box::new(e))
        p
    }

    // ============================================================
    // Parenthesized expression or tuple: (expr) or (a, b, c)
    // ============================================================

    fn parse_paren_expr(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip (

        if parser_peek(p) == TokenKind::RParen {
            // Unit value ()
            p = p.advance()
            let span = p.span_from(start)
            parser_store_expr_box(Box::new(mk_expr(ExprKind::ExprTupleLit, span)))
            p
        } else {
            p = p.parse_expr()
            let first_box = parser_take_expr_box()

            if parser_peek(p) == TokenKind::Comma {
                // Tuple literal
                p = p.advance()
                let first_node = ExprList { label: empty_name(), head: *first_box, tail: None }
                var rev_list_opt: Option<Box<ExprList>> = Some(Box::new(first_node))
                while parser_peek(p) != TokenKind::RParen && parser_peek(p) != TokenKind::Eof {
                    p = p.parse_expr()
                    let next_box = parser_take_expr_box()
                    let next_node = ExprList { label: empty_name(), head: *next_box, tail: rev_list_opt }
                    rev_list_opt = Some(Box::new(next_node))
                    if parser_peek(p) == TokenKind::Comma {
                        p = p.advance()
                    }
                }
                p = p.expect(TokenKind::RParen)
                let span = p.span_from(start)
                var e = mk_expr(ExprKind::ExprTupleLit, span)
                e.args = reverse_expr_list_opt(rev_list_opt)
                parser_store_expr_box(Box::new(e))
                p
            } else {
                // Just grouping
                p = p.expect(TokenKind::RParen)
                parser_store_expr_box(first_box)
                p
            }
        }
    }

    // ============================================================
    // Array literal: [a, b, c] or [val; count]
    // ============================================================

    fn parse_array_literal(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip [

        if parser_peek(p) == TokenKind::RBracket {
            // Empty array
            p = p.advance()
            let span = p.span_from(start)
            parser_store_expr_box(Box::new(mk_expr(ExprKind::ExprArrayLit, span)))
            p
        } else {
            p = p.parse_expr()
            let first_box = parser_take_expr_box()

            if parser_peek(p) == TokenKind::Semi {
                // Array repeat: [val; count]
                p = p.advance()  // skip ;
                p = p.parse_expr()
                let count_box = parser_take_expr_box()
                p = p.expect(TokenKind::RBracket)
                let span = p.span_from(start)
                var e = mk_expr(ExprKind::ExprArrayLit, span)
                e.left = Some(first_box)
                e.right = Some(count_box)
                parser_store_expr_box(Box::new(e))
                p
            } else {
                // Array elements: [a, b, c]
                let first_node = ExprList { label: empty_name(), head: *first_box, tail: None }
                var rev_list_opt: Option<Box<ExprList>> = Some(Box::new(first_node))
                while parser_peek(p) == TokenKind::Comma {
                    p = p.advance()
                    if parser_peek(p) == TokenKind::RBracket { break }
                    p = p.parse_expr()
                    let next_box = parser_take_expr_box()
                    let next_node = ExprList { label: empty_name(), head: *next_box, tail: rev_list_opt }
                    rev_list_opt = Some(Box::new(next_node))
                }
                p = p.expect(TokenKind::RBracket)
                let span = p.span_from(start)
                var e = mk_expr(ExprKind::ExprArrayLit, span)
                e.args = reverse_expr_list_opt(rev_list_opt)
                parser_store_expr_box(Box::new(e))
                p
            }
        }
    }

    // ============================================================
    // Block expression: { ... }
    // ============================================================

    fn parse_block_expr(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        let pair = self.parse_block()
        let p = pair.0
        let blk = pair.1
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprBlock, span)
        e.block = Some(Box::new(blk))
        parser_store_expr_box(Box::new(e))
        p
    }

    // ============================================================
    // Handle expression: handle<Effect> { body } with { handlers }
    // ============================================================

    fn parse_handle_expr(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'handle'

        // Parse effect name: handle<Effect>
        p = p.expect(TokenKind::Lt)
        let effect_name = p.current_name()
        p = p.advance()  // skip effect ident
        p = p.expect(TokenKind::Gt)

        // Parse body block: { ... }
        let body_pair = p.parse_block()
        p = body_pair.0
        let body = body_pair.1

        // Parse optional handler: with { ... }
        var handler_opt: Option<Box<Block>> = None
        if parser_peek(p) == TokenKind::With {
            p = p.advance()  // skip 'with'
            let handler_pair = p.parse_block()
            p = handler_pair.0
            handler_opt = Some(Box::new(handler_pair.1))
        }

        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprHandle, span)
        e.name = effect_name
        e.block = Some(Box::new(body))
        e.handler_block = handler_opt
        parser_store_expr_box(Box::new(e))
        p
    }

    fn parse_perform_expr(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        var p = self.advance()  // skip 'perform'
        p = p.parse_expr()
        // The performed operation expression remains in LAST_EXPR.
        p
    }

    fn parse_async_like_block_expr(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        let marker_name = self.current_name()
        var p = self.advance()  // skip 'async' or 'spawn'

        if parser_peek(p) == TokenKind::LBrace {
            let pair = p.parse_block()
            p = pair.0
            let blk = pair.1
            let span = p.span_from(start)
            var e = mk_expr(ExprKind::ExprBlock, span)
            e.name = marker_name
            e.block = Some(Box::new(blk))
            parser_store_expr_box(Box::new(e))
            p
        } else {
            p.had_error = true
            p.error_count = p.error_count + 1
            let span = p.span_from(start)
            var e = error_expr(span)
            e.name = marker_name
            parser_store_expr_box(Box::new(e))
            p
        }
    }

    // ============================================================
    // Closure expression: |x: T, y: U| body  or  |x: T| -> R with E { body }
    // ============================================================

    fn parse_closure_expr(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip opening '|'

        // Parse params until closing '|'
        var params: Option<Box<ClosureParamList>> = None
        if parser_peek(p) != TokenKind::Pipe {
            let params_pair = p.parse_closure_params()
            p = params_pair.0
            params = params_pair.1
        }
        p = p.expect(TokenKind::Pipe)  // skip closing '|'

        // Parse optional return type: -> T
        var ret_type: Option<Box<TypeExpr>> = None
        if parser_peek(p) == TokenKind::Arrow {
            p = p.advance()  // skip '->'
            let ty_pair = p.parse_type()
            p = ty_pair.0
            ret_type = Some(Box::new(ty_pair.1))
        }

        // Parse optional effects: with IO, Mut
        var effects: Option<Box<EffectList>> = None
        if parser_peek(p) == TokenKind::With {
            let eff_pair = p.parse_effect_list()
            p = eff_pair.0
            effects = Some(Box::new(eff_pair.1))
        }

        // Parse body: block { ... } or single expression
        if parser_peek(p) == TokenKind::LBrace {
            let blk_pair = p.parse_block()
            let blk_p = blk_pair.0
            let blk = blk_pair.1
            let blk_span = blk_p.span_from(start)
            var blk_expr = mk_expr(ExprKind::ExprBlock, blk_span)
            blk_expr.block = Some(Box::new(blk))
            parser_store_expr_box(Box::new(blk_expr))
            p = blk_p
        } else {
            p = p.parse_expr()
            // body is in LAST_EXPR
        }
        let body_box = parser_take_expr_box()

        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprClosure, span)
        e.closure_params = params
        e.closure_return = ret_type
        e.closure_effects = effects
        e.closure_body = Some(body_box)
        parser_store_expr_box(Box::new(e))
        p
    }

    // Zero-param closure: || body  (PipePipe token)
    fn parse_closure_no_params(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip '||'

        // Parse optional return type: -> T
        var ret_type: Option<Box<TypeExpr>> = None
        if parser_peek(p) == TokenKind::Arrow {
            p = p.advance()
            let ty_pair = p.parse_type()
            p = ty_pair.0
            ret_type = Some(Box::new(ty_pair.1))
        }

        // Parse optional effects: with IO, Mut
        var effects: Option<Box<EffectList>> = None
        if parser_peek(p) == TokenKind::With {
            let eff_pair = p.parse_effect_list()
            p = eff_pair.0
            effects = Some(Box::new(eff_pair.1))
        }

        // Parse body
        if parser_peek(p) == TokenKind::LBrace {
            let blk_pair = p.parse_block()
            let blk_p = blk_pair.0
            let blk = blk_pair.1
            let blk_span = blk_p.span_from(start)
            var blk_expr = mk_expr(ExprKind::ExprBlock, blk_span)
            blk_expr.block = Some(Box::new(blk))
            parser_store_expr_box(Box::new(blk_expr))
            p = blk_p
        } else {
            p = p.parse_expr()
            // body in LAST_EXPR
        }
        let body_box = parser_take_expr_box()

        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprClosure, span)
        e.closure_params = None
        e.closure_return = ret_type
        e.closure_effects = effects
        e.closure_body = Some(body_box)
        parser_store_expr_box(Box::new(e))
        p
    }

    // Parse comma-separated closure params: name: Type, name: Type
    fn parse_closure_params(self) -> (Parser, Option<Box<ClosureParamList>>) with Mut, IO, Panic, Div, Alloc {
        let pair = self.parse_closure_param()
        var p = pair.0
        let head = pair.1

        var tail: Option<Box<ClosureParamList>> = None
        if parser_peek(p) == TokenKind::Comma {
            p = p.advance()  // skip ','
            if parser_peek(p) != TokenKind::Pipe {
                let rest_pair = p.parse_closure_params()
                p = rest_pair.0
                tail = rest_pair.1
            }
        }

        let node = ClosureParamList { head: head, tail: tail }
        (p, Some(Box::new(node)))
    }

    // Parse single closure param: name: Type
    fn parse_closure_param(self) -> (Parser, ClosureParam) with Mut, IO, Panic, Div, Alloc {
        let span = self.current_span()
        let name = self.current_name()
        var p = self.advance()  // skip param name
        var ty = dummy_type_expr()
        if parser_peek(p) == TokenKind::Colon {
            p = p.advance()
            let ty_pair = p.parse_type()
            p = ty_pair.0
            ty = ty_pair.1
        }
        (p, ClosureParam { name: name, ty: ty, span: span })
    }

    // ============================================================
    // If expression: if cond { ... } [else { ... }]
    // ============================================================

    fn parse_if_expr(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'if'
        var cond_box: Box<Expr> = Box::new(error_expr(start))
        if parser_peek(p) == TokenKind::Let {
            p = p.advance()
            let pat_pair = p.parse_pattern()
            p = pat_pair.0
            p = p.expect(TokenKind::Eq)
            p.no_struct_lit = true
            p = p.parse_expr()
            cond_box = parser_take_expr_box()
            p.no_struct_lit = false
        } else {
            // Restrict struct literals in condition to avoid { ambiguity
            p.no_struct_lit = true
            p = p.parse_expr()
            cond_box = parser_take_expr_box()
            p.no_struct_lit = false
        }
        let pair2 = p.parse_block()
        p = pair2.0
        let then_block = pair2.1

        var else_opt: Option<Box<Expr>> = None
        if parser_peek(p) == TokenKind::Else {
            p = p.advance()  // skip 'else'
            if parser_peek(p) == TokenKind::If {
                // else if — recursively parses and stores to LAST_EXPR
                p = p.parse_if_expr()
                let else_if_box = parser_take_expr_box()
                else_opt = Some(else_if_box)
            } else {
                // else { ... }
                let pair3 = p.parse_block()
                p = pair3.0
                let else_block = pair3.1
                let else_span = p.span_from(start)
                var else_expr = mk_expr(ExprKind::ExprBlock, else_span)
                else_expr.block = Some(Box::new(else_block))
                else_opt = Some(Box::new(else_expr))
            }
        }

        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprIf, span)
        e.left = Some(cond_box)
        e.block = Some(Box::new(then_block))
        e.else_expr = else_opt
        parser_store_expr_box(Box::new(e))
        p
    }

    // ============================================================
    // Match expression: match expr { pat => body, ... }
    // ============================================================

    fn parse_match_expr(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'match'
        // Restrict struct literals in scrutinee to avoid { ambiguity
        p.no_struct_lit = true
        p = p.parse_expr()
        let scrutinee_box = parser_take_expr_box()
        p.no_struct_lit = false
        p = p.expect(TokenKind::LBrace)

        // Parse arms
        var rev_arms_opt: Option<Box<MatchArmList>> = None

        while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
            let arm_start = p.current_span()
            let pair2 = p.parse_pattern()
            p = pair2.0
            let pattern = pair2.1
            var guard_opt: Option<Box<Expr> > = None
            if parser_peek(p) == TokenKind::If {
                p = p.advance()
                p.no_struct_lit = true
                p = p.parse_expr()
                guard_opt = Some(parser_take_expr_box())
                p.no_struct_lit = false
            }
            p = p.expect(TokenKind::FatArrow)

            if parser_peek(p) == TokenKind::LBrace {
                // Block body
                let pair4 = p.parse_block()
                let pb = pair4.0
                let blk = pair4.1
                let blk_span = pb.span_from(arm_start)
                var be = mk_expr(ExprKind::ExprBlock, blk_span)
                be.block = Some(Box::new(blk))
                parser_store_expr_box(Box::new(be))
                p = pb
            } else {
                p = p.parse_expr()
                // Un-braced assignment as a match arm body: `Pat => c = expr`.
                // parse_expr stops at the assignment operator (assignments are
                // statements, not expressions in the Pratt grammar), leaving only
                // the lvalue in LAST_EXPR. Parse the rest as an assignment and wrap
                // it in an implicit block — mirroring the braced `{ c = expr }` case
                // that parse_block already handles.
                if parser_assign_op_code(p) >= 0 {
                    let assign_target = parser_take_expr_box()
                    let assign_op_c = parser_assign_op_code(p)
                    p = p.advance()  // skip the assignment operator
                    p = p.parse_expr()
                    let assign_rhs = parser_take_expr_box()
                    let assign_span = p.span_from(arm_start)
                    let assign_stmt = Stmt {
                        kind: StmtKind::StmtAssign,
                        span: assign_span,
                        name: empty_name(),
                        ty: None,
                        expr: Some(assign_rhs),
                        target: Some(assign_target),
                        assign_op: assign_op_from_code(assign_op_c),
                    }
                    let assign_blk = Block {
                        stmts: Some(Box::new(StmtList { head: assign_stmt, tail: None })),
                        span: assign_span,
                    }
                    var abe = mk_expr(ExprKind::ExprBlock, assign_span)
                    abe.block = Some(Box::new(assign_blk))
                    parser_store_expr_box(Box::new(abe))
                }
                // body in LAST_EXPR (plain expr, or the wrapped assignment block)
            }
            let body_box = parser_take_expr_box()
            let arm = MatchArm { pattern: pattern, guard: guard_opt, body: *body_box, span: p.span_from(arm_start) }
            rev_arms_opt = Some(Box::new(MatchArmList { head: arm, tail: rev_arms_opt }))

            // Skip comma between arms
            if parser_peek(p) == TokenKind::Comma {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprMatch, span)
        e.left = Some(scrutinee_box)
        e.arms = reverse_match_arm_list_opt(rev_arms_opt)
        parser_store_expr_box(Box::new(e))
        p
    }

    // ============================================================
    // While expression: while cond { ... }
    // ============================================================

    fn parse_while_expr(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'while'
        if parser_peek(p) == TokenKind::Let {
            return p.parse_while_let_expr(start)
        }
        // Restrict struct literals in condition to avoid { ambiguity
        p.no_struct_lit = true
        p = p.parse_expr()
        let cond_box = parser_take_expr_box()
        p.no_struct_lit = false
        let pair2 = p.parse_block()
        p = pair2.0
        let body = pair2.1
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprWhile, span)
        e.left = Some(cond_box)
        e.block = Some(Box::new(body))
        parser_store_expr_box(Box::new(e))
        p
    }

    fn parse_while_let_expr(self, start: Span) -> Parser with Mut, IO, Panic, Div, Alloc {
        var p = self.advance()  // skip 'let'
        let pat_pair = p.parse_pattern()
        p = pat_pair.0
        let success_pattern = pat_pair.1
        p = p.expect(TokenKind::Eq)

        p.no_struct_lit = true
        p = p.parse_expr()
        let scrutinee_box = parser_take_expr_box()
        p.no_struct_lit = false

        let body_pair = p.parse_block()
        p = body_pair.0
        let success_block = body_pair.1

        let span = p.span_from(start)
        var success_expr = mk_expr(ExprKind::ExprBlock, success_block.span)
        success_expr.block = Some(Box::new(success_block))
        let success_arm = MatchArm {
            pattern: success_pattern,
            guard: None,
            body: success_expr,
            span: success_block.span,
        }

        var wildcard_pattern = Pattern {
            kind: PatternKind::PatWildcard,
            span: span,
            name: empty_name(),
            int_val: 0,
            path: empty_path(),
            sub_patterns: None,
            pat_fields: None,
            is_mut: false,
        }
        var break_expr = mk_expr(ExprKind::ExprBreak, span)
        let break_arm = MatchArm {
            pattern: wildcard_pattern,
            guard: None,
            body: break_expr,
            span: span,
        }

        let arms = MatchArmList {
            head: success_arm,
            tail: Some(Box::new(MatchArmList { head: break_arm, tail: None })),
        }
        var match_expr = mk_expr(ExprKind::ExprMatch, span)
        match_expr.left = Some(scrutinee_box)
        match_expr.arms = Some(Box::new(arms))

        let match_stmt = Stmt {
            kind: StmtKind::StmtExpr,
            span: span,
            name: empty_name(),
            ty: None,
            expr: Some(Box::new(match_expr)),
            target: None,
            assign_op: AssignOp::AssignEq,
        }
        let loop_block = Block {
            stmts: Some(Box::new(StmtList { head: match_stmt, tail: None })),
            span: span,
        }
        var loop_expr = mk_expr(ExprKind::ExprLoop, span)
        loop_expr.block = Some(Box::new(loop_block))
        parser_store_expr_box(Box::new(loop_expr))
        p
    }

    // ============================================================
    // Loop expression: loop { ... }
    // ============================================================

    fn parse_loop_expr(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'loop'
        let pair = p.parse_block()
        p = pair.0
        let body = pair.1
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprLoop, span)
        e.block = Some(Box::new(body))
        parser_store_expr_box(Box::new(e))
        p
    }

    // ============================================================
    // For-in expression: for x in iter_expr { body }
    // ============================================================

    fn parse_for_in_expr(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'for'

        // Parse binding name
        let binding_name = p.current_name()
        p = p.advance()  // skip ident

        // Expect 'in'
        p = p.expect(TokenKind::In)

        // Parse iterator expression (restrict struct lits to avoid { ambiguity)
        p.no_struct_lit = true
        p = p.parse_expr()
        let iter_box = parser_take_expr_box()
        p.no_struct_lit = false

        // Parse body block
        let pair2 = p.parse_block()
        p = pair2.0
        let body = pair2.1

        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprForIn, span)
        e.name = binding_name
        e.left = Some(iter_box)
        e.block = Some(Box::new(body))
        parser_store_expr_box(Box::new(e))
        p
    }

    // ============================================================
    // Return expression: return [expr]
    // ============================================================

    fn parse_return_expr(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'return'
        var e = mk_expr(ExprKind::ExprReturn, start)
        if p.at_expr_start() {
            p = p.parse_expr()
            let val_box = parser_take_expr_box()
            e.left = Some(val_box)
            e.span = p.span_from(start)
        }
        parser_store_expr_box(Box::new(e))
        p
    }

    // ============================================================
    // Break expression: break [expr]
    // ============================================================

    fn parse_break_expr(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'break'
        var e = mk_expr(ExprKind::ExprBreak, start)
        if p.at_expr_start() {
            p = p.parse_expr()
            let val_box = parser_take_expr_box()
            e.left = Some(val_box)
            e.span = p.span_from(start)
        }
        parser_store_expr_box(Box::new(e))
        p
    }

    // ============================================================
    // Identifier expression (variable, path, struct literal, call)
    // ============================================================

    fn parse_ident_expr(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        let name = self.current_name()

        // Check for path: Foo::Bar::baz or turbofish: foo::<T>(args)
        if parser_peek_ahead(self, 1) == TokenKind::ColonColon {
            let pair = self.parse_type_path()
            var p1 = pair.0
            let path = pair.1

            // Turbofish: ident_or_path followed by ::<T, U>
            var turbofish_args: Option<Box<TypeExprList>> = None
            if parser_peek(p1) == TokenKind::ColonColon && parser_peek_ahead(p1, 1) == TokenKind::Lt {
                p1 = p1.advance()  // skip ::
                let ta_pair = p1.parse_type_args()
                p1 = ta_pair.0
                turbofish_args = Some(Box::new(ta_pair.1))
            }

            // E043, path-qualified: `foo::bar!(...)`. Same lexical-adjacency
            // rule as the bare-identifier site below -- `!` must touch BOTH the
            // preceding segment and the following `(`. Whitespace on either
            // side keeps the existing operator expression valid, exactly as for
            // `x! (y)` / `x !(y)`.
            //
            // Without this arm E043 meant "bare identifier followed by a tight
            // bang-call" rather than "Rust macro syntax", so the namespaced
            // shape most Rust code actually writes -- `std::println!(..)`,
            // `vec!`-style paths -- fell through to E004 and the message on the
            // diagnostic was wider than the rule that produced it.
            //
            // The left boundary here is p1.pos - 1 (the last path segment),
            // not self.pos: the path consumed several tokens to get here.
            if parser_peek(p1) == TokenKind::Bang
                && p1.pos > 0
                && p1.pos + 1 < p1.token_count
                && (parser_peek_ahead(p1, 1) == TokenKind::LParen || pt_read_kind_code(p1.pos + 1) == 174)
                && PT_END[(p1.pos - 1) as usize] == PT_START[p1.pos as usize]
                && PT_END[p1.pos as usize] == PT_START[(p1.pos + 1) as usize] {
                p1.had_error = true
                p1.error_count = p1.error_count + 1
                if p1.error_count <= 20 {
                    print("error[E043]: Sounio does not use Rust macros (`ident!(...)`)\n")
                    print("  help: use a regular function call instead of macro syntax\n")
                }
                p1 = parser_advance(p1)  // skip `!`; recover as a regular call
            }

            if !p1.no_struct_lit && parser_peek(p1) == TokenKind::LBrace {
                // Struct literal: Foo { x: 1, y: 2 }
                p1.parse_struct_literal(path, start)
            } else {
                // Path expression: Foo::Bar or turbofish path
                let span = p1.span_from(start)
                var e = mk_expr(ExprKind::ExprPath, span)
                e.path = path
                e.type_args = turbofish_args
                parser_store_expr_box(Box::new(e))
                p1
            }
        } else if !self.no_struct_lit && parser_peek_ahead(self, 1) == TokenKind::LBrace {
            // Struct literal with simple name: Point { x: 1, y: 2 }
            var p = self.advance()
            let path = AstPath {
                segments: StringList { head_buf: name.buf, head_len: name.len, tail: None },
                seg_count: 1,
            }
            p.parse_struct_literal(path, start)
        } else {
            // Simple identifier — may still carry turbofish: vec_new::<f64>()
            let span = self.current_span()
            var p = parser_advance(self)

            // E043: reject only the tightly-adjacent Rust macro shape
            // `ident!(...)`. Whitespace on either side of `!` preserves the
            // existing operator expression, for example `x! (y)`.
            if parser_peek(p) == TokenKind::Bang
                && p.pos + 1 < p.token_count
                && (parser_peek_ahead(p, 1) == TokenKind::LParen || pt_read_kind_code(p.pos + 1) == 174)
                && PT_END[self.pos as usize] == PT_START[p.pos as usize]
                && PT_END[p.pos as usize] == PT_START[(p.pos + 1) as usize] {
                p.had_error = true
                p.error_count = p.error_count + 1
                if p.error_count <= 20 {
                    print("error[E043]: Sounio does not use Rust macros (`ident!(...)`)\n")
                    print("  help: use a regular function call instead of macro syntax\n")
                }
                p = parser_advance(p)  // skip `!`; recover as a regular call
            }

            var e = mk_expr(ExprKind::ExprIdent, span)
            e.name = name
            if parser_peek(p) == TokenKind::ColonColon && parser_peek_ahead(p, 1) == TokenKind::Lt {
                p = parser_advance(p)  // skip ::
                let ta_pair = p.parse_type_args()
                p = ta_pair.0
                e.type_args = Some(Box::new(ta_pair.1))
            }
            var lhs = Box::new(e)
            while !parser_at_eof(p) {
                let post_code = pt_read_kind_code(p.pos)
                if parser_peek(p) == TokenKind::LParen || post_code == 174 {
                    if p.had_newline_before() { break }
                    p = p.parse_call_expr_box(lhs)
                    lhs = parser_take_expr_box()
                } else if parser_peek(p) == TokenKind::LBracket || post_code == 178 {
                    if p.had_newline_before() { break }
                    p = p.parse_index_expr_box(lhs)
                    lhs = parser_take_expr_box()
                } else if parser_peek(p) == TokenKind::Dot || post_code == 183 {
                    p = p.parse_dot_expr_box(lhs)
                    lhs = parser_take_expr_box()
                } else {
                    break
                }
            }
            parser_store_expr_box(lhs)
            p
        }
    }

    // ============================================================
    // Struct literal: Path { field: expr, ... }
    // ============================================================

    fn parse_struct_literal(self, path: AstPath, start: Span) -> Parser with Mut, IO, Panic, Div, Alloc {
        var p = self.advance()  // skip {

        var rev_fields_opt: Option<Box<StructFieldList>> = None

        while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
            let field_span = p.current_span()
            let field_name = p.current_name()
            p = p.expect_ident()
            var field_value = mk_expr(ExprKind::ExprIdent, field_span)
            if parser_peek(p) == TokenKind::Colon {
                p = p.advance()
                p = p.parse_expr()
                let field_val_box = parser_take_expr_box()
                field_value = *field_val_box
            } else {
                field_value.name = field_name
            }

            let field = StructFieldInit { name: field_name, value: field_value }
            rev_fields_opt = Some(Box::new(StructFieldList { head: field, tail: rev_fields_opt }))

            if parser_peek(p) == TokenKind::Comma {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprStructLit, span)
        e.path = path
        e.fields = reverse_struct_field_list_opt(rev_fields_opt)
        parser_store_expr_box(Box::new(e))
        p
    }

    // ============================================================
    // Call expression: callee(arg1, arg2)
    // ============================================================

    fn parse_call_arg_expr(self) -> (Parser, Box<ExprList>) with Mut, IO, Panic, Div, Alloc {
        var p = self
        var label = empty_name()

        if parser_peek(p) == TokenKind::Ident && parser_peek_ahead(p, 1) == TokenKind::Colon {
            label = p.current_name()
            p = parser_advance(p)
            p = p.expect(TokenKind::Colon)
        } else if parser_peek(p) == TokenKind::Ident && parser_peek_ahead(p, 1) == TokenKind::Eq {
            label = p.current_name()
            p = parser_advance(p)
            p = p.expect(TokenKind::Eq)
        } else if parser_peek(p) == TokenKind::Error {
            label = p.current_name()
            p = parser_advance(p)
            while parser_peek(p) == TokenKind::Error {
                p = parser_advance(p)
            }
            if parser_peek(p) == TokenKind::Eq || parser_assign_op_code(p) == 0 {
                p = parser_advance(p)
            }
        }
        p = p.parse_expr()
        let expr_box = parser_take_expr_box()
        let node = ExprList { label: label, head: *expr_box, tail: None }
        (p, Box::new(node))
    }

    fn parse_call_expr_box(self, callee: Box<Expr>) -> Parser with Mut, IO, Panic, Div, Alloc {
        let start = callee.span
        var p = parser_advance(self)  // skip (

        var args_opt: Option<Box<ExprList>> = None

        if parser_peek(p) != TokenKind::RParen {
            let pair = p.parse_call_arg_expr()
            p = pair.0
            let first = pair.1  // Box<ExprList>
            var rev_list_opt: Option<Box<ExprList>> = Some(Box::new(*first))

            while parser_peek(p) == TokenKind::Comma {
                p = p.advance()
                if parser_peek(p) == TokenKind::RParen { break }
                let pair2 = p.parse_call_arg_expr()
                p = pair2.0
                let next = pair2.1  // Box<ExprList>
                let new_node = ExprList { label: next.label, head: next.head, tail: rev_list_opt }
                rev_list_opt = Some(Box::new(new_node))
            }

            args_opt = reverse_expr_list_opt(rev_list_opt)
        }

        if parser_peek(p) == TokenKind::RParen || pt_read_kind_code(p.pos) == 175 {
            p = parser_advance(p)
        } else {
            p = p.expect(TokenKind::RParen)
        }
        let span = p.span_from(start)

        // d_separated(A, B) / d_separated(A, B | Z): the only way to obtain a
        // proven independence witness. A, B and Z name nodes of the declared
        // causal graph, not variables, so the call is recorded for the checker
        // to verify and replaced here by the proof token -- the literal 1, which
        // is what indep_dsep consumes. See ast_record_dsep.
        if callee.kind == ExprKind::ExprIdent
            && callee.name.len == 11
            && callee.name.buf[0] == (100 as i8)
            && callee.name.buf[1] == (95 as i8)
            && callee.name.buf[2] == (115 as i8)
            && callee.name.buf[3] == (101 as i8)
            && callee.name.buf[4] == (112 as i8)
            && callee.name.buf[5] == (97 as i8)
            && callee.name.buf[6] == (114 as i8)
            && callee.name.buf[7] == (97 as i8)
            && callee.name.buf[8] == (116 as i8)
            && callee.name.buf[9] == (101 as i8)
            && callee.name.buf[10] == (100 as i8) {
            var d_a: i64 = 0
            var d_b: i64 = 0
            var d_z: i64 = 0 - 1
            var form_ok: i64 = 0
            match args_opt {
                None => {}
                Some(l1) => {
                    let a_e = (*l1).head
                    match (*l1).tail {
                        None => {}
                        Some(l2) => {
                            let b_e = (*l2).head
                            // Exactly two arguments; a third is not the form.
                            match (*l2).tail {
                                Some(_) => {}
                                None => {
                                    if a_e.kind == ExprKind::ExprIdent {
                                        d_a = ast_indep_name_hash(a_e.name)
                                        if b_e.kind == ExprKind::ExprIdent {
                                            d_b = ast_indep_name_hash(b_e.name)
                                            form_ok = 1
                                        } else if b_e.kind == ExprKind::ExprBinary && b_e.bin_op == BinaryOp::OpBitOr {
                                            // `B | Z` parses as a bitwise-or; the
                                            // bar is the conditioning bar of
                                            // P(A ⊥ B | Z), and both sides must
                                            // still be plain names.
                                            match b_e.left {
                                                None => {}
                                                Some(bl) => {
                                                    match b_e.right {
                                                        None => {}
                                                        Some(br) => {
                                                            if (*bl).kind == ExprKind::ExprIdent && (*br).kind == ExprKind::ExprIdent {
                                                                d_b = ast_indep_name_hash((*bl).name)
                                                                d_z = ast_indep_name_hash((*br).name)
                                                                form_ok = 1
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            ast_record_dsep(d_a, d_b, d_z, form_ok, span.file_id as i64, span.start, span.end)
            // ExprDsepProof, not ExprIntLit: a hand-typed i64 literal `1` at
            // indep_dsep's call site used to be accepted identically to this
            // rewrite's output, because both were the SAME node kind carrying
            // the SAME value -- nothing was left to tell them apart. This node
            // kind exists so indep_dsep's declared `proof: DsepProof` parameter
            // can require the one thing a bare literal is not: this specific,
            // unforgeable expression shape. int_val stays 1 for codegen -- the
            // opacity is a compile-time property, not a runtime one.
            var proof = mk_expr(ExprKind::ExprDsepProof, span)
            proof.int_val = 1
            parser_store_expr_box(Box::new(proof))
            return p
        }

        var e = mk_expr(ExprKind::ExprCall, span)
        e.type_args = callee.type_args
        e.left = Some(callee)
        e.args = args_opt
        // Note: hardware_publish rewriting skipped (IS_SPTR issue with Expr params, TODO)
        parser_store_expr_box(Box::new(e))
        p
    }

    // ============================================================
    // Index expression: base[index]
    // ============================================================

    fn parse_index_expr_box(self, base: Box<Expr>) -> Parser with Mut, IO, Panic, Div, Alloc {
        let start = base.span
        var p = self.advance()  // skip [
        p = p.parse_expr()
        var index_box = parser_take_expr_box()
        if parser_peek(p) == TokenKind::As {
            p = p.advance()
            let ty_pair = p.parse_type()
            p = ty_pair.0
            let span_cast = p.span_from(index_box.span)
            var cast_e = mk_expr(ExprKind::ExprCast, span_cast)
            cast_e.left = Some(index_box)
            cast_e.cast_type = Some(Box::new(ty_pair.1))
            index_box = Box::new(cast_e)
        }
        p = p.expect(TokenKind::RBracket)
        let span = p.span_from(start)
        var e = mk_expr(ExprKind::ExprIndex, span)
        e.left = Some(base)
        e.right = Some(index_box)
        parser_store_expr_box(Box::new(e))
        p
    }

    // ============================================================
    // Dot expression: field access or method call
    // ============================================================

    fn parse_dot_expr_box(self, base: Box<Expr>) -> Parser with Mut, IO, Panic, Div, Alloc {
        let start = base.span
        var p = parser_advance(self)  // skip .
        let name = p.current_name()
        p = parser_advance(p)  // skip field/method name

        // Turbofish on method: base.method::<T>(args)
        var method_type_args: Option<Box<TypeExprList>> = None
        if parser_peek(p) == TokenKind::ColonColon && parser_peek_ahead(p, 1) == TokenKind::Lt {
            p = parser_advance(p)  // skip ::
            let ta_pair = p.parse_type_args()
            p = ta_pair.0
            method_type_args = Some(Box::new(ta_pair.1))
        }

        // A `(` after a newline is NOT method-call args -- it starts a new
        // expression statement (mirrors the infix-loop LParen guard). Without this,
        // `let after_len = nc.code.len\n(after_len - before_len) > 50` glues into
        // `nc.code.len(after_len - before_len)`, referencing after_len before it is
        // bound (E137 undeclared).
        if parser_peek(p) == TokenKind::LParen && !p.had_newline_before() {
            // Method call: base.method(args) or base.method::<T>(args)
            p = parser_advance(p)  // skip (
            var args_opt: Option<Box<ExprList>> = None

            if parser_peek(p) != TokenKind::RParen {
                let pair = p.parse_call_arg_expr()
                p = pair.0
                let first = pair.1  // Box<ExprList>
                var rev_list_opt: Option<Box<ExprList>> = Some(Box::new(*first))

                while parser_peek(p) == TokenKind::Comma {
                    p = parser_advance(p)
                    if parser_peek(p) == TokenKind::RParen { break }
                    let pair2 = p.parse_call_arg_expr()
                    p = pair2.0
                    let next = pair2.1
                    let new_node = ExprList { label: next.label, head: next.head, tail: rev_list_opt }
                    rev_list_opt = Some(Box::new(new_node))
                }
                args_opt = reverse_expr_list_opt(rev_list_opt)
            }

            p = p.expect(TokenKind::RParen)
            let span = p.span_from(start)
            var e = mk_expr(ExprKind::ExprMethodCall, span)
            e.name = name
            e.left = Some(base)
            e.args = args_opt
            e.type_args = method_type_args
            parser_store_expr_box(Box::new(e))
            p
        } else {
            // Field access: base.field
            let span = p.span_from(start)
            var e = mk_expr(ExprKind::ExprFieldAccess, span)
            e.name = name
            e.left = Some(base)
            parser_store_expr_box(Box::new(e))
            p
        }
    }
}

// ============================================================
// hardware_publish canonicalization helpers
// Note: rewrite_hardware_publish_call disabled in parse_call_expr_box due to IS_SPTR.
// The functions below remain for future use but are not currently called from parsing.
// ============================================================

fn rewrite_hardware_publish_call(call_expr: Expr) -> Expr with Mut, Panic, Div, Alloc {
    if call_expr.kind != ExprKind::ExprCall {
        return call_expr
    }

    match call_expr.left {
        Some(callee_box) => {
            let callee = *callee_box
            if callee.kind != ExprKind::ExprIdent || !exprs_name_is_hardware_publish(callee.name) {
                return call_expr
            }

            let args_pair = rewrite_hardware_publish_args(call_expr.args)
            let rewritten_args = args_pair.0
            let op_kind = args_pair.1
            if op_kind < 0 {
                return call_expr
            }

            var rewritten = call_expr
            var intrinsic = callee
            intrinsic.name = exprs_name_knowledge_kaxi_publish()
            rewritten.left = Some(Box::new(intrinsic))
            rewritten.args = rewritten_args
            rewritten
        }
        _ => call_expr,
    }
}

fn rewrite_hardware_publish_args(
    args: Option<Box<ExprList>>
) -> (Option<Box<ExprList>>, i64) with Mut, Panic, Div, Alloc {
    match args {
        Some(list) => {
            let arg0 = (*list).head
            match (*list).tail {
                Some(tail1) => {
                    let arg1 = (*tail1).head
                    let arg_rest = (*tail1).tail
                    let op_kind = kaxi_op_kind_from_expr(arg1)
                    if op_kind < 0 {
                        let original_tail = Some(Box::new(ExprList { label: empty_name(), head: arg1, tail: arg_rest }))
                        (Some(Box::new(ExprList { label: empty_name(), head: arg0, tail: original_tail })), -1)
                    } else {
                        let op_lit = expr_int_lit(arg1.span, op_kind)
                        let rewritten_tail = Some(Box::new(ExprList { label: empty_name(), head: op_lit, tail: arg_rest }))
                        (Some(Box::new(ExprList { label: empty_name(), head: arg0, tail: rewritten_tail })), op_kind)
                    }
                }
                _ => (Some(Box::new(ExprList { label: empty_name(), head: arg0, tail: None })), -1),
            }
        }
        _ => (None, -1),
    }
}

fn kaxi_op_kind_from_expr(e: Expr) -> i64 with Mut, Panic, Div, Alloc {
    if e.kind != ExprKind::ExprPath {
        return -1
    }
    if e.path.seg_count < 2 {
        return -1
    }
    if !path_first_is_kaxi(e.path) {
        return -1
    }

    let op = path_last_name(e.path)
    if name_eq3(op, 97 as i8, 100 as i8, 100 as i8) { return 1 }               // add
    if name_eq3(op, 109 as i8, 117 as i8, 108 as i8) { return 2 }              // mul
    if name_eq3(op, 100 as i8, 105 as i8, 118 as i8) { return 3 }              // div
    if name_eq3(op, 102 as i8, 109 as i8, 97 as i8) { return 4 }               // fma
    if name_eq4(op, 112 as i8, 97 as i8, 115 as i8, 115 as i8) { return 0 }    // pass
    if name_eq8(op,
        112 as i8, 114 as i8, 111 as i8, 112 as i8,
        95 as i8, 118 as i8, 97 as i8, 114 as i8) { return 5 }                 // prop_var
    -1
}

fn expr_int_lit(span: Span, value: i64) -> Expr with Mut {
    var e = mk_expr(ExprKind::ExprIntLit, span)
    e.int_val = value
    e
}

fn exprs_name_is_hardware_publish(n: Name) -> bool {
    name_eq16(n,
        104 as i8, 97 as i8, 114 as i8, 100 as i8,
        119 as i8, 97 as i8, 114 as i8, 101 as i8,
        95 as i8, 112 as i8, 117 as i8, 98 as i8,
        108 as i8, 105 as i8, 115 as i8, 104 as i8
    )
}

fn exprs_name_knowledge_kaxi_publish() -> Name with Mut, Panic {
    var n = Name { buf: [0; 384], len: 24 }
    // "__knowledge_kaxi_publish"
    n.buf[0] = 95 as i8
    n.buf[1] = 95 as i8
    n.buf[2] = 107 as i8
    n.buf[3] = 110 as i8
    n.buf[4] = 111 as i8
    n.buf[5] = 119 as i8
    n.buf[6] = 108 as i8
    n.buf[7] = 101 as i8
    n.buf[8] = 100 as i8
    n.buf[9] = 103 as i8
    n.buf[10] = 101 as i8
    n.buf[11] = 95 as i8
    n.buf[12] = 107 as i8
    n.buf[13] = 97 as i8
    n.buf[14] = 120 as i8
    n.buf[15] = 105 as i8
    n.buf[16] = 95 as i8
    n.buf[17] = 112 as i8
    n.buf[18] = 117 as i8
    n.buf[19] = 98 as i8
    n.buf[20] = 108 as i8
    n.buf[21] = 105 as i8
    n.buf[22] = 115 as i8
    n.buf[23] = 104 as i8
    n
}

fn path_first_is_kaxi(path: AstPath) -> bool {
    if path.seg_count < 2 {
        return false
    }
    let seg = path.segments
    seg.head_len == 4 &&
    seg.head_buf[0] == 75 as i8 &&  // K
    seg.head_buf[1] == 65 as i8 &&  // A
    seg.head_buf[2] == 88 as i8 &&  // X
    seg.head_buf[3] == 73 as i8     // I
}

fn exprs_copy_string_list_to_name(seg: StringList) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 384], len: seg.head_len }
    var i: i64 = 0
    while i < seg.head_len && i < 384 {
        n.buf[i] = seg.head_buf[i]
        i = i + 1
    }
    n
}

fn path_last_name(path: AstPath) -> Name with Mut, Panic, Div, Alloc {
    if path.seg_count <= 0 {
        return empty_name()
    }
    if path.seg_count == 1 {
        return exprs_copy_string_list_to_name(path.segments)
    }
    string_list_last_name(path.segments)
}

pub fn parse_expr_entry(p: Parser) -> Parser with Mut, IO, Panic, Div, Alloc {
    p.parse_expr()
}

fn string_list_last_name(list: StringList) -> Name with Mut, Panic, Div, Alloc {
    match list.tail {
        Some(rest) => string_list_last_name(*rest),
        _ => exprs_copy_string_list_to_name(list),
    }
}

fn name_eq3(n: Name, a: i8, b: i8, c: i8) -> bool {
    n.len == 3 && n.buf[0] == a && n.buf[1] == b && n.buf[2] == c
}

fn name_eq4(n: Name, a: i8, b: i8, c: i8, d: i8) -> bool {
    n.len == 4 && n.buf[0] == a && n.buf[1] == b && n.buf[2] == c && n.buf[3] == d
}

fn name_eq8(
    n: Name,
    a0: i8, a1: i8, a2: i8, a3: i8,
    a4: i8, a5: i8, a6: i8, a7: i8
) -> bool {
    n.len == 8 &&
    n.buf[0] == a0 && n.buf[1] == a1 && n.buf[2] == a2 && n.buf[3] == a3 &&
    n.buf[4] == a4 && n.buf[5] == a5 && n.buf[6] == a6 && n.buf[7] == a7
}

fn name_eq16(
    n: Name,
    a0: i8, a1: i8, a2: i8, a3: i8,
    a4: i8, a5: i8, a6: i8, a7: i8,
    a8: i8, a9: i8, a10: i8, a11: i8,
    a12: i8, a13: i8, a14: i8, a15: i8
) -> bool {
    n.len == 16 &&
    n.buf[0] == a0 && n.buf[1] == a1 && n.buf[2] == a2 && n.buf[3] == a3 &&
    n.buf[4] == a4 && n.buf[5] == a5 && n.buf[6] == a6 && n.buf[7] == a7 &&
    n.buf[8] == a8 && n.buf[9] == a9 && n.buf[10] == a10 && n.buf[11] == a11 &&
    n.buf[12] == a12 && n.buf[13] == a13 && n.buf[14] == a14 && n.buf[15] == a15
}

// ============================================================
// Token to binary operator mapping
// ============================================================

fn token_to_binop(kind: TokenKind) -> BinaryOp {
    match kind {
        TokenKind::Plus => BinaryOp::OpAdd,
        TokenKind::Minus => BinaryOp::OpSub,
        TokenKind::Star => BinaryOp::OpMul,
        TokenKind::Slash => BinaryOp::OpDiv,
        TokenKind::Percent => BinaryOp::OpRem,
        TokenKind::EqEq => BinaryOp::OpEq,
        TokenKind::BangEq => BinaryOp::OpNe,
        TokenKind::Lt => BinaryOp::OpLt,
        TokenKind::LtEq => BinaryOp::OpLe,
        TokenKind::Gt => BinaryOp::OpGt,
        TokenKind::GtEq => BinaryOp::OpGe,
        TokenKind::AmpAmp => BinaryOp::OpAnd,
        TokenKind::PipePipe => BinaryOp::OpOr,
        TokenKind::Amp => BinaryOp::OpBitAnd,
        TokenKind::Pipe => BinaryOp::OpBitOr,
        TokenKind::Caret => BinaryOp::OpBitXor,
        TokenKind::Shl => BinaryOp::OpShl,
        TokenKind::Shr => BinaryOp::OpShr,
        TokenKind::PlusPlus => BinaryOp::OpConcat,
        TokenKind::DotDot => BinaryOp::OpRange,
        TokenKind::DotDotEq => BinaryOp::OpRangeInclusive,
        _ => BinaryOp::OpAdd,
    }
}

// ============================================================
// Linked-list helpers for expression parsing
// ============================================================

fn reverse_expr_list_opt(list: Option<Box<ExprList>>) -> Option<Box<ExprList>> with Mut, Alloc {
    reverse_expr_list_loop(list, None)
}

fn reverse_expr_list_loop(
    current: Option<Box<ExprList>>,
    acc: Option<Box<ExprList>>,
) -> Option<Box<ExprList>> with Mut, Alloc {
    match current {
        None => acc,
        Some(node) => {
            let next = (*node).tail
            let rev_node = ExprList { label: (*node).label, head: (*node).head, tail: acc }
            reverse_expr_list_loop(next, Some(Box::new(rev_node)))
        },
    }
}

fn reverse_match_arm_list_opt(list: Option<Box<MatchArmList>>) -> Option<Box<MatchArmList>> with Mut, Alloc {
    reverse_match_arm_list_loop(list, None)
}

fn reverse_match_arm_list_loop(
    current: Option<Box<MatchArmList>>,
    acc: Option<Box<MatchArmList>>,
) -> Option<Box<MatchArmList>> with Mut, Alloc {
    match current {
        None => acc,
        Some(node) => {
            let next = (*node).tail
            let rev_node = MatchArmList { head: (*node).head, tail: acc }
            reverse_match_arm_list_loop(next, Some(Box::new(rev_node)))
        },
    }
}

fn reverse_struct_field_list_opt(list: Option<Box<StructFieldList>>) -> Option<Box<StructFieldList>> with Mut, Alloc {
    reverse_struct_field_list_loop(list, None)
}

fn reverse_struct_field_list_loop(
    current: Option<Box<StructFieldList>>,
    acc: Option<Box<StructFieldList>>,
) -> Option<Box<StructFieldList>> with Mut, Alloc {
    match current {
        None => acc,
        Some(node) => {
            let next = (*node).tail
            let rev_node = StructFieldList { head: (*node).head, tail: acc }
            reverse_struct_field_list_loop(next, Some(Box::new(rev_node)))
        },
    }
}
