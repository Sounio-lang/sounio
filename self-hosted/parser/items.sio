    fn parse_audit_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'audit'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::For)

        let target_pair = p.parse_type()
        p = target_pair.0
        let target_ty = target_pair.1

        p = p.expect(TokenKind::LBrace)
        var rev_sections_opt: Option<Box<AuditSectionList>> = None

        while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
            while parser_peek(p) == TokenKind::Semi || parser_peek(p) == TokenKind::Newline {
                p = p.advance()
            }
            if parser_peek(p) == TokenKind::RBrace || parser_peek(p) == TokenKind::Eof {
                break
            }
            let section_pair = p.parse_audit_section()
            p = section_pair.0
            rev_sections_opt = Some(Box::new(AuditSectionList {
                head: section_pair.1,
                tail: rev_sections_opt,
            }))
            while parser_peek(p) == TokenKind::Semi {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)

        let span = p.span_from(start)
        let adef = AuditDef {
            name: name,
            target_type: target_ty,
            sections: reverse_audit_section_list_opt(rev_sections_opt),
            span: span,
        }

        (p, Item {
            kind: ItemKind::ItemAudit,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: Some(Box::new(adef)),
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    fn parse_audit_section(self) -> (Parser, AuditSection) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        let section_name = self.current_name()
        var p = self.expect_ident()
        p = p.expect(TokenKind::LBrace)

        var rev_fields_opt: Option<Box<AuditFieldEntryList>> = None
        while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
            while parser_peek(p) == TokenKind::Comma || parser_peek(p) == TokenKind::Semi || parser_peek(p) == TokenKind::Newline {
                p = p.advance()
            }
            if parser_peek(p) == TokenKind::RBrace || parser_peek(p) == TokenKind::Eof {
                break
            }
            let field_pair = p.parse_audit_field_entry()
            p = field_pair.0
            rev_fields_opt = Some(Box::new(AuditFieldEntryList {
                head: field_pair.1,
                tail: rev_fields_opt,
            }))
            while parser_peek(p) == TokenKind::Comma || parser_peek(p) == TokenKind::Semi {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)
        let span = p.span_from(start)
        (p, AuditSection {
            kind: audit_section_kind_from_name(section_name),
            name: section_name,
            fields: reverse_audit_field_entry_list_opt(rev_fields_opt),
            span: span,
        })
    }

    fn parse_audit_field_entry(self) -> (Parser, AuditFieldEntry) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        let field_name = self.current_name()
        var p = self.expect_ident()
        p = p.expect(TokenKind::Colon)

        var value_name = empty_name()
        var value_f64: f64 = 0.0
        var value_kind = AuditValueKind::AuditValueName
        if parser_peek(p) == TokenKind::IntLit {
            value_kind = AuditValueKind::AuditValueFloat
            value_f64 = p.current().int_value as f64
            p = p.advance()
        } else if parser_peek(p) == TokenKind::FloatLit {
            value_kind = AuditValueKind::AuditValueFloat
            value_f64 = p.current().float_value
            p = p.advance()
        } else {
            let name_pair = p.parse_audit_name_value()
            p = name_pair.0
            value_name = name_pair.1
        }

        let span = p.span_from(start)
        (p, AuditFieldEntry {
            name: field_name,
            value_name: value_name,
            value_f64: value_f64,
            value_kind: value_kind,
            span: span,
        })
    }

    fn parse_audit_name_value(self) -> (Parser, Name) with Mut, IO, Panic, Div, Alloc {
        if self.peek() == TokenKind::StringLit {
            let name = self.current_name()
            (self.advance(), name)
        } else if self.peek() == TokenKind::Ident {
            if parser_peek_ahead(self, 1) == TokenKind::ColonColon {
                let pair = self.parse_type_path()
                (pair.0, copy_string_list_tail_to_name(pair.1.segments))
            } else {
                let name = self.current_name()
                (self.expect_ident(), name)
            }
        } else {
            var p = self
            p.had_error = true
            p.error_count = p.error_count + 1
            (p.advance(), empty_name())
        }
    }

    fn parse_policy_compare_op(self) -> (Parser, CompareOp) with Mut, IO, Panic, Div {
        let op_tok = self.peek()
        if op_tok == TokenKind::Lt {
            (self.advance(), CompareOp::CmpLt)
        } else if op_tok == TokenKind::LtEq {
            (self.advance(), CompareOp::CmpLe)
        } else if op_tok == TokenKind::Gt {
            (self.advance(), CompareOp::CmpGt)
        } else if op_tok == TokenKind::GtEq {
            (self.advance(), CompareOp::CmpGe)
        } else if op_tok == TokenKind::EqEq {
            (self.advance(), CompareOp::CmpEq)
        } else {
            var p = self
            p.had_error = true
            p.error_count = p.error_count + 1
            (p.advance(), CompareOp::CmpEq)
        }
    }

    fn parse_policy_requirement(self) -> (Parser, PolicyRequirement) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.expect(TokenKind::Require)

        let metric_name = p.current_name()
        p = p.expect_ident()

        var cmp_op: CompareOp = CompareOp::CmpEq
        let op_tok = parser_peek(p)
        if op_tok == TokenKind::Lt {
            cmp_op = CompareOp::CmpLt
            p = p.advance()
        } else if op_tok == TokenKind::LtEq {
            cmp_op = CompareOp::CmpLe
            p = p.advance()
        } else if op_tok == TokenKind::Gt {
            cmp_op = CompareOp::CmpGt
            p = p.advance()
        } else if op_tok == TokenKind::GtEq {
            cmp_op = CompareOp::CmpGe
            p = p.advance()
        } else if op_tok == TokenKind::EqEq {
            cmp_op = CompareOp::CmpEq
            p = p.advance()
        } else {
            p.had_error = true
            p.error_count = p.error_count + 1
            p = p.advance()
        }

        var threshold: f64 = 0.0
        var threshold_kind: i64 = 0
        var bool_threshold = false
        var name_threshold = empty_name()
        if parser_peek(p) == TokenKind::IntLit {
            threshold = p.current().int_value as f64
            p = p.advance()
        } else if parser_peek(p) == TokenKind::FloatLit {
            threshold = p.current().float_value
            p = p.advance()
        } else if parser_peek(p) == TokenKind::True {
            threshold = 1.0
            threshold_kind = 1
            bool_threshold = true
            p = p.advance()
        } else if parser_peek(p) == TokenKind::False {
            threshold = 0.0
            threshold_kind = 1
            bool_threshold = false
            p = p.advance()
        } else if parser_peek(p) == TokenKind::Ident {
            threshold_kind = 2
            name_threshold = p.current_name()
            p = p.advance()
        } else {
            p.had_error = true
            p.error_count = p.error_count + 1
            p = p.advance()
        }

        let span = p.span_from(start)
        (p, PolicyRequirement {
            metric_name: metric_name,
            op: cmp_op,
            threshold: threshold,
            threshold_kind: threshold_kind,
            bool_threshold: bool_threshold,
            name_threshold: name_threshold,
            span: span,
        })
    }

    // ============================================================
    // Refinement type: { var: Type | var op value }
    // ============================================================

    // ============================================================
    // Use declaration: use path::to::module [::*]
    // ============================================================

    fn parse_use_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = parser_advance(self)  // skip 'use'

        let pair = p.parse_type_path()
        p = pair.0
        let path = pair.1

        var is_glob = false
        var use_items_opt: Option<Box<ImportItemList>> = None

        if (parser_peek(p) == TokenKind::ColonColon || pt_read_kind_code(p.pos) == 162) && (parser_peek_ahead(p, 1) == TokenKind::Star || pt_read_kind_code(p.pos + 1) == 134) {
            // Glob import: use path::*
            p = parser_advance(p)  // skip ::
            p = parser_advance(p)  // skip *
            is_glob = true
        } else if (parser_peek(p) == TokenKind::ColonColon || pt_read_kind_code(p.pos) == 162) && (parser_peek_ahead(p, 1) == TokenKind::LBrace || pt_read_kind_code(p.pos + 1) == 176) {
            // Selective import: use path::{A, B, C}
            p = parser_advance(p)  // skip ::
            p = parser_advance(p)  // skip {

            // Parse comma-separated identifiers
            var rev_items: Option<Box<ImportItemList>> = None
            if parser_peek(p) != TokenKind::RBrace {
                let first_name = p.current_name()
                p = parser_advance(p)  // skip ident
                rev_items = Some(Box::new(ImportItemList { head: first_name, tail: None }))

                while parser_peek(p) == TokenKind::Comma {
                    p = parser_advance(p)  // skip ,
                    if parser_peek(p) == TokenKind::RBrace { break }
                    let next_name = p.current_name()
                    p = parser_advance(p)  // skip ident
                    rev_items = Some(Box::new(ImportItemList { head: next_name, tail: rev_items }))
                }
            }

            p = p.expect(TokenKind::RBrace)
            use_items_opt = reverse_import_item_list_opt(rev_items)
        }
        // Else: whole-module import (use path) — no glob, no items

        if parser_peek(p) == TokenKind::Semi {
            p = parser_advance(p)
        }

        let span = p.span_from(start)
        (p, Item {
            kind: ItemKind::ItemUse,
            span: span,
            visibility: visibility,
            name: empty_name(),
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: path,
            use_glob: is_glob,
            use_items: use_items_opt,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    // ============================================================
    // Unit declaration: unit mg; | unit velocity = m / s;
    // ============================================================

    // ============================================================
    // Effect declaration: effect Fail { fn fail(msg: string) -> ! }
    // ============================================================

    fn parse_effect_op_def(self) -> (Parser, EffectOpDef) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'fn'

        let name = p.current_name()
        p = p.expect_ident()

        p = p.expect(TokenKind::LParen)
        let pair = p.parse_param_list()
        p = pair.0
        let params_opt = pair.1
        p = p.expect(TokenKind::RParen)

        let pair2 = p.parse_optional_return_type()
        p = pair2.0
        let ret_ty = pair2.1

        let span = p.span_from(start)
        (p, EffectOpDef {
            name: name,
            params: params_opt,
            ret_ty: ret_ty,
            span: span,
        })
    }

    fn parse_effect_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'effect'

        let name = p.current_name()
        p = p.expect_ident()

        p = p.expect(TokenKind::LBrace)
        var rev_ops_opt: Option<Box<EffectOpDefList>> = None
        var op_count: i64 = 0

        while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
            while parser_peek(p) == TokenKind::Semi || parser_peek(p) == TokenKind::Newline {
                p = p.advance()
            }
            if parser_peek(p) == TokenKind::RBrace || parser_peek(p) == TokenKind::Eof {
                break
            }
            if parser_peek(p) == TokenKind::Fn {
                let op_pair = p.parse_effect_op_def()
                p = op_pair.0
                rev_ops_opt = Some(Box::new(EffectOpDefList {
                    head: op_pair.1,
                    tail: rev_ops_opt,
                }))
                op_count = op_count + 1
            } else {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)
        let span = p.span_from(start)
        let edef = EffectDef {
            name: name,
            ops: reverse_effect_op_def_list_opt(rev_ops_opt),
            op_count: op_count,
            span: span,
        }

        (p, Item {
            kind: ItemKind::ItemEffect,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: Some(Box::new(edef)),
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    fn parse_unit_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()   // consume 'unit'

        // Expect unit name
        let name = p.current_name()
        p = p.advance()

        // Optional derived unit expression: = m / s / s ;
        var conv_ty: Option<Box<TypeExpr>> = None
        if parser_peek(p) == TokenKind::Eq {
            p = p.advance()          // consume '='
            let first_pair = p.parse_type()
            p = first_pair.0
            var unit_ty = first_pair.1

            while parser_peek(p) == TokenKind::Slash || parser_peek(p) == TokenKind::Star {
                let op = parser_peek(p)
                p = p.advance()
                let rhs_pair = p.parse_type()
                p = rhs_pair.0
                let rhs_ty = rhs_pair.1
                let unit_kind = if op == TokenKind::Slash {
                    TypeExprKind::TypeReference
                } else {
                    TypeExprKind::TypeRefMut
                }
                let op_span = p.span_from(start)
                unit_ty = TypeExpr {
                    kind: unit_kind,
                    span: op_span,
                    path: empty_path(),
                    type_args: Some(Box::new(TypeExprList {
                        head: unit_ty,
                        tail: None,
                    })),
                    inner: Some(Box::new(rhs_ty)),
                    array_size: None,
                    effects: None,
                    knowledge_info: None,
                    refinement_info: None,
                }
            }
            conv_ty = Some(Box::new(unit_ty))
        }

        // Expect semicolon
        if parser_peek(p) == TokenKind::Semi {
            p = p.advance()
        }

        let span = p.span_from(start)
        (p, Item {
            kind: ItemKind::ItemUnit,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: conv_ty,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    // ============================================================
    // Session declaration: session Name { send T, recv T, close }
    // ============================================================

    fn parse_session_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'session'

        let name = p.current_name()
        p = p.expect_ident()

        p = p.expect(TokenKind::LBrace)

        var steps: [SessionStep; 16] = [SessionStep {
            kind: SessionStepKind::StepClose,
            msg_type: TypeExpr {
                kind: TypeExprKind::TypeUnit,
                span: start,
                path: empty_path(),
                type_args: None,
                inner: None,
                array_size: None,
                effects: None,
                knowledge_info: None,
                refinement_info: None,
            },
            span: start,
        }; 16]
        var step_count: i64 = 0

        while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
            // skip newlines/semis between steps
            while parser_peek(p) == TokenKind::Semi || parser_peek(p) == TokenKind::Newline {
                p = p.advance()
            }
            if parser_peek(p) == TokenKind::RBrace || parser_peek(p) == TokenKind::Eof {
                break
            }

            let step_start = p.current_span()

            if parser_peek(p) == TokenKind::Send {
                p = p.advance()  // skip 'send'
                let ty_pair = p.parse_type()
                p = ty_pair.0
                let msg_ty = ty_pair.1
                if step_count < 16 {
                    steps[step_count as usize] = SessionStep {
                        kind: SessionStepKind::StepSend,
                        msg_type: msg_ty,
                        span: p.span_from(step_start),
                    }
                    step_count = step_count + 1
                }
            } else if parser_peek(p) == TokenKind::Recv {
                p = p.advance()  // skip 'recv'
                let ty_pair = p.parse_type()
                p = ty_pair.0
                let msg_ty = ty_pair.1
                if step_count < 16 {
                    steps[step_count as usize] = SessionStep {
                        kind: SessionStepKind::StepRecv,
                        msg_type: msg_ty,
                        span: p.span_from(step_start),
                    }
                    step_count = step_count + 1
                }
            } else if parser_peek(p) == TokenKind::Close {
                p = p.advance()  // skip 'close'
                if step_count < 16 {
                    steps[step_count as usize] = SessionStep {
                        kind: SessionStepKind::StepClose,
                        msg_type: TypeExpr {
                            kind: TypeExprKind::TypeUnit,
                            span: p.span_from(step_start),
                            path: empty_path(),
                            type_args: None,
                            inner: None,
                            array_size: None,
                            effects: None,
                            knowledge_info: None,
                            refinement_info: None,
                        },
                        span: p.span_from(step_start),
                    }
                    step_count = step_count + 1
                }
            } else {
                // skip unknown token
                p = p.advance()
            }

            // optional comma separator
            if parser_peek(p) == TokenKind::Comma {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)

        let span = p.span_from(start)
        let sdecl = SessionDecl {
            name: name,
            steps: steps,
            step_count: step_count,
            span: span,
        }
        (p, Item {
            kind: ItemKind::ItemSession,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: Some(Box::new(sdecl)),
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    // One extern-"C"-block declaration per call (re-entrant; see the
    // EXTERN_BLOCK_ACTIVE note above). Emits the next declaration as an
    // ffi-forwarding wrapper when that intrinsic exists and as a bodyless
    // extern declaration otherwise; on '}' closes the block and returns an
    // empty filler item (the same shape an empty extern block always
    // produced).
    fn parse_extern_block_decl(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self
        while parser_peek(p) == TokenKind::Newline || parser_peek(p) == TokenKind::Semi || tk_is_doc_comment(parser_peek(p)) {
            p = p.advance()
        }
        if parser_peek(p) == TokenKind::RBrace || parser_peek(p) == TokenKind::Eof {
            p = p.expect(TokenKind::RBrace)
            parser_reset_extern_block_state()
            let span = p.span_from(start)
            return (p, Item { kind: ItemKind::ItemFn, span: span, visibility: visibility, name: empty_name(), fn_def: None, struct_def: None, enum_def: None, impl_def: None, type_alias_ty: None, policy_def: None, acquisition_policy_def: None, recourse_policy_def: None, decision_policy_def: None, deferral_policy_def: None, transition_policy_def: None, transition_protocol_def: None, monitoring_policy_def: None, alternative_policy_def: None, alternative_frontier_def: None, models_def: None, validation_def: None, audit_def: None, use_path: empty_path(), use_glob: false, use_items: None, effect_def: None, session_decl: None, trait_def: None, algebra_def: None, study_def: None, ontology_def: None })
        }
        if parser_peek(p) != TokenKind::Fn {
            p.had_error = true
            p.error_count = p.error_count + 1
            if p.error_count <= 20 {
                print("parse error: expected fn declaration in extern block [items.sio extern-block]\n")
            }
            p = p.advance()
            let span = p.span_from(start)
            return (p, Item { kind: ItemKind::ItemFn, span: span, visibility: visibility, name: empty_name(), fn_def: None, struct_def: None, enum_def: None, impl_def: None, type_alias_ty: None, policy_def: None, acquisition_policy_def: None, recourse_policy_def: None, decision_policy_def: None, deferral_policy_def: None, transition_policy_def: None, transition_protocol_def: None, monitoring_policy_def: None, alternative_policy_def: None, alternative_frontier_def: None, models_def: None, validation_def: None, audit_def: None, use_path: empty_path(), use_glob: false, use_items: None, effect_def: None, session_decl: None, trait_def: None, algebra_def: None, study_def: None, ontology_def: None })
        }
        p = p.advance()  // skip 'fn'
        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::LParen)
        let pair = p.parse_param_list()
        p = pair.0
        let params_opt = pair.1
        p = p.expect(TokenKind::RParen)
        let pair2 = p.parse_optional_return_type()
        p = pair2.0
        let ret_ty = pair2.1
        while parser_peek(p) == TokenKind::Newline || parser_peek(p) == TokenKind::Semi {
            p = p.advance()
        }
        if parser_peek(p) == TokenKind::RBrace {
            p = p.advance()
            parser_reset_extern_block_state()
        }
        let span = p.span_from(start)
        // Track A: a declaration whose ffi_<name> intrinsic exists becomes an
        // ffi-forwarding wrapper, because the bodyless FnDef lowered as a
        // shadow fn whose body returned a fabricated 0. Every other name keeps
        // the bodyless declaration — see extern_name_has_ffi_intrinsic for why
        // wrapping it would refuse the DECLARATION instead of the call.
        let fn_def = extern_decl_or_wrapper_fn_def(name, params_opt, ret_ty, span)
        return (p, Item { kind: ItemKind::ItemFn, span: span, visibility: visibility, name: name, fn_def: Some(Box::new(fn_def)), struct_def: None, enum_def: None, impl_def: None, type_alias_ty: None, policy_def: None, acquisition_policy_def: None, recourse_policy_def: None, decision_policy_def: None, deferral_policy_def: None, transition_policy_def: None, transition_protocol_def: None, monitoring_policy_def: None, alternative_policy_def: None, alternative_frontier_def: None, models_def: None, validation_def: None, audit_def: None, use_path: empty_path(), use_glob: false, use_items: None, effect_def: None, session_decl: None, trait_def: None, algebra_def: None, study_def: None, ontology_def: None })
    }

    // Sprint 108: extern "C" fn name(params) -> RetType (no body)
    // Also accept brace-form extern blocks. Brace-form blocks are handled
    // re-entrantly, one declaration per parse_item() call, so nothing is
    // dropped (dispatch M1) and no aggregate crosses a module-global queue;
    // each of those declarations goes through the Track A rewrite decision
    // (extern_decl_or_wrapper_fn_def). The bare form below does NOT go
    // through it: it emits the bodyless declaration unconditionally, which is
    // main's representation for every extern and already resolves by name in
    // the native builtin registry.
    fn parse_extern_fn_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'extern'
        if parser_peek(p) == TokenKind::StringLit { p = p.advance() }
        if parser_peek(p) == TokenKind::LBrace {
            // Re-entrant brace form: consume '{', arm the block state, and
            // return the FIRST declaration's wrapper via the shared
            // continuation. The item loop's subsequent parse_item() calls
            // re-enter the continuation for the remaining declarations (M1:
            // they used to be silently dropped here).
            p = p.advance()
            EXTERN_BLOCK_ACTIVE = 1
            EXTERN_BLOCK_VIS_KIND = visibility.kind
            return p.parse_extern_block_decl(visibility)
        }
        if parser_peek(p) != TokenKind::Fn {
            let span = p.current_span()
            p.had_error = true
            p.error_count = p.error_count + 1
            p = p.advance()
            return (p, Item { kind: ItemKind::ItemFn, span: span, visibility: visibility, name: empty_name(), fn_def: None, struct_def: None, enum_def: None, impl_def: None, type_alias_ty: None, policy_def: None, acquisition_policy_def: None, recourse_policy_def: None, decision_policy_def: None, deferral_policy_def: None, transition_policy_def: None, transition_protocol_def: None, monitoring_policy_def: None, alternative_policy_def: None, alternative_frontier_def: None, models_def: None, validation_def: None, audit_def: None, use_path: empty_path(), use_glob: false, use_items: None, effect_def: None, session_decl: None, trait_def: None, algebra_def: None, study_def: None, ontology_def: None })
        }
        p = p.advance()  // skip 'fn'
        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::LParen)
        let pair = p.parse_param_list()
        p = pair.0
        let params_opt = pair.1
        p = p.expect(TokenKind::RParen)
        let pair2 = p.parse_optional_return_type()
        p = pair2.0
        let ret_ty = pair2.1
        while parser_peek(p) == TokenKind::Semi {
            p = p.advance()
        }
        let span = p.span_from(start)
        let fn_def = FnDef { name: name, params: params_opt, return_type: ret_ty, effects: None, body: Block { stmts: None, span: span }, span: span, is_kernel: false, is_extern: true }
        (p, Item { kind: ItemKind::ItemFn, span: span, visibility: visibility, name: name, fn_def: Some(Box::new(fn_def)), struct_def: None, enum_def: None, impl_def: None, type_alias_ty: None, policy_def: None, acquisition_policy_def: None, recourse_policy_def: None, decision_policy_def: None, deferral_policy_def: None, transition_policy_def: None, transition_protocol_def: None, monitoring_policy_def: None, alternative_policy_def: None, alternative_frontier_def: None, models_def: None, validation_def: None, audit_def: None, use_path: empty_path(), use_glob: false, use_items: None, effect_def: None, session_decl: None, trait_def: None, algebra_def: None, study_def: None, ontology_def: None })
    }

    // Sprint 109: export "C" fn
    fn parse_export_fn_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        var p = self.advance()  // skip 'export'
        if parser_peek(p) == TokenKind::Extern {
            return p.parse_extern_fn_item(visibility)
        }
        if parser_peek(p) == TokenKind::StringLit {
            p = p.advance()
            if parser_peek(p) == TokenKind::Extern {
                return p.parse_extern_fn_item(visibility)
            }
        }
        p.parse_fn_item(visibility, false)
    }

}

// ============================================================
// Linked-list helpers for item parsing
// ============================================================

fn reverse_param_list_opt(list: Option<Box<ParamList>>) -> Option<Box<ParamList>> with Mut, Alloc {
    reverse_param_list_loop(list, None)
}

fn reverse_param_list_loop(
    current: Option<Box<ParamList>>,
    acc: Option<Box<ParamList>>,
) -> Option<Box<ParamList>> with Mut, Alloc {
    match current {
        None => acc,
        Some(node) => {
            let next = (*node).tail
            let head = (*node).head
            let rev_node = ParamList { head: head, tail: acc }
            reverse_param_list_loop(next, Some(Box::new(rev_node)))
        },
    }
}

