    fn parse_alternative_objective_def(self) -> (Parser, AlternativeObjectiveDef) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip objective

        var direction = AlternativeObjectiveDirection::AlternativeObjectiveMinimize
        if parser_peek(p) == TokenKind::Ident && parser_name_is_maximize(p.current_name()) {
            direction = AlternativeObjectiveDirection::AlternativeObjectiveMaximize
            p = p.advance()
        } else if parser_peek(p) == TokenKind::Ident && parser_name_is_minimize(p.current_name()) {
            p = p.advance()
        } else {
            p.had_error = true
            p.error_count = p.error_count + 1
        }

        let metric_name = p.current_name()
        p = p.expect_ident()

        let span = p.span_from(start)
        (p, AlternativeObjectiveDef {
            direction: direction,
            metric_name: metric_name,
            span: span,
        })
    }

    fn parse_alternative_candidate_def(self) -> (Parser, AlternativeCandidateDef) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        let head_name = self.current_name()
        var p = self.expect_ident()
        let uses_via = parser_name_is_candidate(head_name)

        let name = p.current_name()
        p = p.expect_ident()

        var via_name = empty_name()
        if uses_via {
            if parser_peek(p) == TokenKind::Ident && parser_name_is_via(p.current_name()) {
                p = p.advance()
                via_name = p.current_name()
                p = p.expect_ident()
            } else {
                p.had_error = true
                p.error_count = p.error_count + 1
            }
        }

        p = p.expect(TokenKind::LBrace)

        var have_value = false
        var value_expr = mk_expr(ExprKind::ExprError, Span { file_id: 0, start: 0, end: 0 })
        var rev_metrics_opt: Option<Box<AuditFieldEntryList>> = None

        while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
            while parser_peek(p) == TokenKind::Semi || parser_peek(p) == TokenKind::Newline || parser_peek(p) == TokenKind::Comma {
                p = p.advance()
            }
            if parser_peek(p) == TokenKind::RBrace || parser_peek(p) == TokenKind::Eof {
                break
            }

            if parser_peek(p) == TokenKind::Ident && parser_name_is_value(p.current_name()) {
                p = p.advance()
                p = p.expect(TokenKind::Colon)
                p = p.parse_expr()
                let value_box = parser_take_expr_box()
                value_expr = *value_box
                have_value = true
            } else if parser_peek(p) == TokenKind::Ident && parser_name_is_metrics(p.current_name()) {
                p = p.advance()
                p = p.expect(TokenKind::LBrace)
                while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
                    while parser_peek(p) == TokenKind::Semi || parser_peek(p) == TokenKind::Newline || parser_peek(p) == TokenKind::Comma {
                        p = p.advance()
                    }
                    if parser_peek(p) == TokenKind::RBrace || parser_peek(p) == TokenKind::Eof {
                        break
                    }
                    let metric_pair = p.parse_audit_field_entry()
                    p = metric_pair.0
                    rev_metrics_opt = Some(Box::new(AuditFieldEntryList {
                        head: metric_pair.1,
                        tail: rev_metrics_opt,
                    }))
                    while parser_peek(p) == TokenKind::Semi || parser_peek(p) == TokenKind::Comma {
                        p = p.advance()
                    }
                }
                p = p.expect(TokenKind::RBrace)
            } else {
                p.had_error = true
                p.error_count = p.error_count + 1
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)
        let span = p.span_from(start)
        if !have_value {
            value_expr = mk_expr(ExprKind::ExprError, span)
        }
        (p, AlternativeCandidateDef {
            name: name,
            via_name: via_name,
            value_expr: value_expr,
            metrics: reverse_audit_field_entry_list_opt(rev_metrics_opt),
            uses_via: uses_via,
            span: span,
        })
    }

    fn parse_transition_step_def(self) -> (Parser, TransitionStepDef) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self
        if parser_peek(p) == TokenKind::Step {
            p = p.advance()
        } else {
            p.had_error = true
            p.error_count = p.error_count + 1
        }

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::LBrace)

        var have_value = false
        var value_expr = mk_expr(ExprKind::ExprError, Span { file_id: 0, start: 0, end: 0 })
        var rev_requirements_opt: Option<Box<PolicyRequirementList>> = None

        while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
            while parser_peek(p) == TokenKind::Semi || parser_peek(p) == TokenKind::Newline || parser_peek(p) == TokenKind::Comma {
                p = p.advance()
            }
            if parser_peek(p) == TokenKind::RBrace || parser_peek(p) == TokenKind::Eof {
                break
            }

            if parser_peek(p) == TokenKind::Ident && parser_name_is_value(p.current_name()) {
                p = p.advance()
                p = p.expect(TokenKind::Colon)
                p = p.parse_expr()
                let value_box = parser_take_expr_box()
                value_expr = *value_box
                have_value = true
            } else if parser_peek(p) == TokenKind::Require {
                let req_pair = p.parse_policy_requirement()
                p = req_pair.0
                rev_requirements_opt = Some(Box::new(PolicyRequirementList {
                    head: req_pair.1,
                    tail: rev_requirements_opt,
                }))
            } else {
                p.had_error = true
                p.error_count = p.error_count + 1
                p = p.advance()
            }

            while parser_peek(p) == TokenKind::Semi || parser_peek(p) == TokenKind::Comma {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)
        let span = p.span_from(start)
        if !have_value {
            value_expr = mk_expr(ExprKind::ExprError, span)
        }

        (p, TransitionStepDef {
            name: name,
            value_expr: value_expr,
            requirements: reverse_policy_requirement_list_opt(rev_requirements_opt),
            span: span,
        })
    }

    // ============================================================
    // Decision policy: decision_policy Name for Type { require metric >= value }
    // ============================================================

    fn parse_decision_policy_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'decision_policy'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::For)

        let target_pair = p.parse_type()
        p = target_pair.0
        let target_ty = target_pair.1

        p = p.expect(TokenKind::LBrace)
        var rev_requirements_opt: Option<Box<PolicyRequirementList>> = None

        while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
            while parser_peek(p) == TokenKind::Semi || parser_peek(p) == TokenKind::Newline {
                p = p.advance()
            }
            if parser_peek(p) == TokenKind::RBrace || parser_peek(p) == TokenKind::Eof {
                break
            }

            let req_pair = p.parse_policy_requirement()
            p = req_pair.0
            rev_requirements_opt = Some(Box::new(PolicyRequirementList {
                head: req_pair.1,
                tail: rev_requirements_opt,
            }))

            while parser_peek(p) == TokenKind::Semi {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)

        let span = p.span_from(start)
        let ddef = DecisionPolicyDef {
            name: name,
            target_type: target_ty,
            requirements: reverse_policy_requirement_list_opt(rev_requirements_opt),
            span: span,
        }

        (p, Item {
            kind: ItemKind::ItemDecisionPolicy,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: Some(Box::new(ddef)),
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    fn parse_deferral_policy_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'deferral_policy'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::For)

        let target_pair = p.parse_type()
        p = target_pair.0
        let target_ty = target_pair.1

        var route_name = empty_name()
        if parser_peek(p) == TokenKind::Route {
            p = p.advance()
            route_name = p.current_name()
            p = p.expect_ident()
        }

        p = p.expect(TokenKind::LBrace)
        var rev_requirements_opt: Option<Box<PolicyRequirementList>> = None

        while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
            while parser_peek(p) == TokenKind::Semi || parser_peek(p) == TokenKind::Newline {
                p = p.advance()
            }
            if parser_peek(p) == TokenKind::RBrace || parser_peek(p) == TokenKind::Eof {
                break
            }

            let req_pair = p.parse_policy_requirement()
            p = req_pair.0
            rev_requirements_opt = Some(Box::new(PolicyRequirementList {
                head: req_pair.1,
                tail: rev_requirements_opt,
            }))

            while parser_peek(p) == TokenKind::Semi {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)

        let span = p.span_from(start)
        let ddef = DeferralPolicyDef {
            name: name,
            target_type: target_ty,
            route_name: route_name,
            requirements: reverse_policy_requirement_list_opt(rev_requirements_opt),
            span: span,
        }

        (p, Item {
            kind: ItemKind::ItemDeferralPolicy,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: Some(Box::new(ddef)),
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    fn parse_models_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'models'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::Eq)
        p = p.expect(TokenKind::LBracket)

        var rev_models_opt: Option<Box<AstPathList>> = None
        var model_count: i64 = 0

        if parser_peek(p) != TokenKind::RBracket {
            let pair = p.parse_type_path()
            p = pair.0
            rev_models_opt = Some(Box::new(AstPathList { head: pair.1, tail: None }))
            model_count = 1

            while parser_peek(p) == TokenKind::Comma {
                p = p.advance()
                if parser_peek(p) == TokenKind::RBracket { break }
                let pair2 = p.parse_type_path()
                p = pair2.0
                rev_models_opt = Some(Box::new(AstPathList { head: pair2.1, tail: rev_models_opt }))
                model_count = model_count + 1
            }
        }

        p = p.expect(TokenKind::RBracket)
        let span = p.span_from(start)
        let mdef = ModelsDef {
            name: name,
            models: reverse_ast_path_list_opt(rev_models_opt),
            model_count: model_count,
            span: span,
        }

        (p, Item {
            kind: ItemKind::ItemModels,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
                impl_def: None,
                type_alias_ty: None,
                policy_def: None,
                acquisition_policy_def: None,
                recourse_policy_def: None,
                decision_policy_def: None,
                deferral_policy_def: None,
                transition_policy_def: None,
                transition_protocol_def: None,
                monitoring_policy_def: None,
                alternative_policy_def: None,
                alternative_frontier_def: None,
            models_def: Some(Box::new(mdef)),
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

