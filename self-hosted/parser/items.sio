// Parser — top-level item parsing
//
// Handles: fn, struct, enum, impl, type alias, use declarations.

impl Parser {
    // ============================================================
    // Parse a single item
    // ============================================================

    fn parse_item(self) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let k = self.peek()

        // Handle optional 'pub' visibility
        var is_pub = false
        var p = self
        if k == TokenKind::Pub {
            is_pub = true
            p = p.advance()
        }

        // Handle optional 'linear' modifier
        var is_linear = false
        if p.peek() == TokenKind::Linear {
            is_linear = true
            p = p.advance()
        }

        let item_kind = p.peek()

        if item_kind == TokenKind::Fn {
            p.parse_fn_item()
        } else if item_kind == TokenKind::Struct {
            p.parse_struct_item(is_linear)
        } else if item_kind == TokenKind::Enum {
            p.parse_enum_item()
        } else if item_kind == TokenKind::Impl {
            p.parse_impl_item()
        } else if item_kind == TokenKind::Type {
            p.parse_type_alias_item()
        } else if item_kind == TokenKind::Use {
            p.parse_use_item()
        } else if item_kind == TokenKind::Let {
            p.parse_global_let_item()
        } else if item_kind == TokenKind::Var {
            p.parse_global_var_item()
        } else {
            // Error recovery: skip token
            let span = p.current_span()
            p.had_error = true
            p.error_count = p.error_count + 1
            let pa = p.advance()
            (pa, Item {
                kind: ItemKind::ItemFn,
                span: span,
                name: empty_name(),
                fn_def: None,
                struct_def: None,
                enum_def: None,
                impl_def: None,
                type_alias_ty: None,
                use_path: empty_path(),
                use_glob: false,
            })
        }
    }

    // ============================================================
    // Global bindings (top-level): let/var NAME [: Type] = expr
    // ============================================================

    fn parse_global_let_item(self) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'let'

        let name = p.current_name()
        p = p.expect_ident()

        // Optional type annotation
        let ty_pair = p.parse_optional_type()
        p = ty_pair.0

        // = expr
        p = p.expect(TokenKind::Eq)
        let expr_pair = p.parse_expr()
        p = expr_pair.0

        let span = p.span_from(start)
        (p, Item {
            kind: ItemKind::ItemFn,
            span: span,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            use_path: empty_path(),
            use_glob: false,
        })
    }

    fn parse_global_var_item(self) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'var'

        let name = p.current_name()
        p = p.expect_ident()

        // Optional type annotation
        let ty_pair = p.parse_optional_type()
        p = ty_pair.0

        // = expr
        p = p.expect(TokenKind::Eq)
        let expr_pair = p.parse_expr()
        p = expr_pair.0

        let span = p.span_from(start)
        (p, Item {
            kind: ItemKind::ItemFn,
            span: span,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            use_path: empty_path(),
            use_glob: false,
        })
    }

    // ============================================================
    // Function: fn name(params) -> RetType with Effects { body }
    // ============================================================

    fn parse_fn_item(self) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        if self.peek() != TokenKind::Fn {
            // Recovery: consume one token so callers never stall.
            let span = self.current_span()
            var p_bad = self
            p_bad.had_error = true
            p_bad.error_count = p_bad.error_count + 1
            p_bad = p_bad.advance()
            return (p_bad, Item {
                kind: ItemKind::ItemFn,
                span: span,
                name: empty_name(),
                fn_def: None,
                struct_def: None,
                enum_def: None,
                impl_def: None,
                type_alias_ty: None,
                use_path: empty_path(),
                use_glob: false,
            })
        }

        let start = self.current_span()
        var p = self.advance()  // skip 'fn'

        let name = p.current_name()
        p = p.expect_ident()

        // Parameters
        p = p.expect(TokenKind::LParen)
        let pair = p.parse_param_list()
        p = pair.0
        let params_opt = pair.1
        p = p.expect(TokenKind::RParen)

        // Return type
        let pair2 = p.parse_optional_return_type()
        p = pair2.0
        let ret_ty = pair2.1

        // Effects
        var effects_opt: Option<Box<EffectList>> = None
        if p.peek() == TokenKind::With {
            let pair3 = p.parse_effect_list()
            p = pair3.0
            effects_opt = Some(Box::new(pair3.1))
        }

        // Body
        let pair4 = p.parse_block()
        p = pair4.0
        let body = pair4.1

        let span = p.span_from(start)
        let fn_def = FnDef {
            name: name,
            params: params_opt,
            return_type: ret_ty,
            effects: effects_opt,
            body: body,
            span: span,
        }

        (p, Item {
            kind: ItemKind::ItemFn,
            span: span,
            name: name,
            fn_def: Some(Box::new(fn_def)),
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            use_path: empty_path(),
            use_glob: false,
        })
    }

    // ============================================================
    // Parameter list
    // ============================================================

    fn parse_param_list(self) -> (Parser, Option<Box<ParamList>>) with Mut, IO, Panic, Div, Alloc {
        if self.peek() == TokenKind::RParen {
            return (self, None)
        }

        let pair = self.parse_param()
        var p = pair.0
        let first = pair.1
        var rev_params_opt: Option<Box<ParamList>> = Some(Box::new(ParamList { head: first, tail: None }))

        while p.peek() == TokenKind::Comma {
            p = p.advance()
            if p.peek() == TokenKind::RParen { break }
            let pair2 = p.parse_param()
            p = pair2.0
            let next = pair2.1
            rev_params_opt = Some(Box::new(ParamList { head: next, tail: rev_params_opt }))
        }

        (p, reverse_param_list_opt(rev_params_opt))
    }

    // ============================================================
    // Single parameter: name: Type  or  self
    // ============================================================

    fn parse_param(self) -> (Parser, Param) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()

        if self.peek() == TokenKind::SelfLower {
            // self parameter
            let name = self.current_name()
            let p = self.advance()
            let span = p.span_from(start)
            (p, Param {
                name: name,
                ty: dummy_type_expr(),
                is_self: true,
                is_self_mut: false,
                span: span,
            })
        } else {
            let name = self.current_name()
            var p = self.expect_ident()
            p = p.expect(TokenKind::Colon)
            let pair = p.parse_type()
            p = pair.0
            let ty = pair.1
            let span = p.span_from(start)
            (p, Param {
                name: name,
                ty: ty,
                is_self: false,
                is_self_mut: false,
                span: span,
            })
        }
    }

    // ============================================================
    // Struct: struct Name { field: Type, ... }
    // ============================================================

    fn parse_struct_item(self, is_linear: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'struct'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::LBrace)

        // Parse fields
        var rev_fields_opt: Option<Box<FieldDefList>> = None

        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            let field_start = p.current_span()
            let field_name = p.current_name()
            p = p.expect_ident()
            p = p.expect(TokenKind::Colon)
            let pair = p.parse_type()
            p = pair.0
            let field_ty = pair.1

            let field = FieldDef { name: field_name, ty: field_ty, span: p.span_from(field_start) }

            rev_fields_opt = Some(Box::new(FieldDefList { head: field, tail: rev_fields_opt }))

            if p.peek() == TokenKind::Comma {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)
        let fields_opt = reverse_field_def_list_opt(rev_fields_opt)
        let span = p.span_from(start)
        let sdef = StructDef { name: name, fields: fields_opt, is_linear: is_linear, span: span }

        (p, Item {
            kind: ItemKind::ItemStruct,
            span: span,
            name: name,
            fn_def: None,
            struct_def: Some(Box::new(sdef)),
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            use_path: empty_path(),
            use_glob: false,
        })
    }

    // ============================================================
    // Enum: enum Name { Variant1, Variant2, ... }
    // ============================================================

    fn parse_enum_item(self) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'enum'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::LBrace)

        var rev_variants_opt: Option<Box<VariantDefList>> = None

        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            let v_start = p.current_span()
            let v_name = p.current_name()
            p = p.expect_ident()
            let v_span = p.span_from(v_start)

            let variant = VariantDef { name: v_name, span: v_span }

            rev_variants_opt = Some(Box::new(VariantDefList { head: variant, tail: rev_variants_opt }))

            if p.peek() == TokenKind::Comma {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)
        let variants_opt = reverse_variant_def_list_opt(rev_variants_opt)
        let span = p.span_from(start)
        let edef = EnumDef { name: name, variants: variants_opt, span: span }

        (p, Item {
            kind: ItemKind::ItemEnum,
            span: span,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: Some(Box::new(edef)),
            impl_def: None,
            type_alias_ty: None,
            use_path: empty_path(),
            use_glob: false,
        })
    }

    // ============================================================
    // Impl: impl Type { fn method() { } ... }
    // ============================================================

    fn parse_impl_item(self) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'impl'

        let pair = p.parse_type()
        p = pair.0
        let target_ty = pair.1
        p = p.expect(TokenKind::LBrace)

        // Build methods in reverse for O(1) cons, reverse once at the end.
        var rev_methods_opt: Option<Box<ItemList>> = None

        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            // Ignore trivia and doc comments between methods.
            while p.peek() == TokenKind::Newline || p.peek() == TokenKind::Semi || tk_is_doc_comment(p.peek()) {
                p = p.advance()
            }

            if p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
                if p.peek() == TokenKind::Fn {
                    let pair2 = p.parse_fn_item()
                    p = pair2.0
                    let method = pair2.1
                    rev_methods_opt = Some(Box::new(ItemList { head: method, tail: rev_methods_opt }))
                } else {
                    // Recovery: consume one unexpected token inside impl body.
                    p.had_error = true
                    p.error_count = p.error_count + 1
                    p = p.advance()
                }
            }
        }

        p = p.expect(TokenKind::RBrace)
        let span = p.span_from(start)
        let methods_opt = reverse_item_list_opt(rev_methods_opt)

        // Extract name from target type path
        let impl_name = extract_impl_name(target_ty)

        let idef = ImplDef { target_type: target_ty, methods: methods_opt, span: span }

        (p, Item {
            kind: ItemKind::ItemImpl,
            span: span,
            name: impl_name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: Some(Box::new(idef)),
            type_alias_ty: None,
            use_path: empty_path(),
            use_glob: false,
        })
    }

    // ============================================================
    // Type alias: type Name = Type
    // ============================================================

    fn parse_type_alias_item(self) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'type'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::Eq)

        let pair = p.parse_type()
        p = pair.0
        let ty = pair.1

        let span = p.span_from(start)
        (p, Item {
            kind: ItemKind::ItemTypeAlias,
            span: span,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: Some(Box::new(ty)),
            use_path: empty_path(),
            use_glob: false,
        })
    }

    // ============================================================
    // Use declaration: use path::to::module [::*]
    // ============================================================

    fn parse_use_item(self) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'use'

        let pair = p.parse_type_path()
        p = pair.0
        let path = pair.1

        var is_glob = false
        if p.peek() == TokenKind::ColonColon && p.peek_ahead(1) == TokenKind::Star {
            p = p.advance()  // skip ::
            p = p.advance()  // skip *
            is_glob = true
        }

        let span = p.span_from(start)
        (p, Item {
            kind: ItemKind::ItemUse,
            span: span,
            name: empty_name(),
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            use_path: path,
            use_glob: is_glob,
        })
    }
}

// ============================================================
// Linked-list helpers for item parsing
// ============================================================

fn reverse_param_list_opt(list: Option<Box<ParamList>>) -> Option<Box<ParamList>> with Mut, Alloc {
    reverse_param_list_loop(list, None)
}

fn reverse_param_list_loop(
    current: Option<Box<ParamList>>,
    acc: Option<Box<ParamList>>,
) -> Option<Box<ParamList>> with Mut, Alloc {
    match current {
        None => acc,
        Some(node) => {
            let next = (*node).tail
            let rev_node = ParamList { head: (*node).head, tail: acc }
            reverse_param_list_loop(next, Some(Box::new(rev_node)))
        },
    }
}

fn reverse_field_def_list_opt(list: Option<Box<FieldDefList>>) -> Option<Box<FieldDefList>> with Mut, Alloc {
    reverse_field_def_list_loop(list, None)
}

fn reverse_field_def_list_loop(
    current: Option<Box<FieldDefList>>,
    acc: Option<Box<FieldDefList>>,
) -> Option<Box<FieldDefList>> with Mut, Alloc {
    match current {
        None => acc,
        Some(node) => {
            let next = (*node).tail
            let rev_node = FieldDefList { head: (*node).head, tail: acc }
            reverse_field_def_list_loop(next, Some(Box::new(rev_node)))
        },
    }
}

fn reverse_variant_def_list_opt(list: Option<Box<VariantDefList>>) -> Option<Box<VariantDefList>> with Mut, Alloc {
    reverse_variant_def_list_loop(list, None)
}

fn reverse_variant_def_list_loop(
    current: Option<Box<VariantDefList>>,
    acc: Option<Box<VariantDefList>>,
) -> Option<Box<VariantDefList>> with Mut, Alloc {
    match current {
        None => acc,
        Some(node) => {
            let next = (*node).tail
            let rev_node = VariantDefList { head: (*node).head, tail: acc }
            reverse_variant_def_list_loop(next, Some(Box::new(rev_node)))
        },
    }
}

fn extract_impl_name(ty: TypeExpr) -> Name with Mut, Panic, Div, Alloc {
    if ty.kind == TypeExprKind::TypeNamed && ty.path.seg_count > 0 {
        copy_string_list_tail_to_name(ty.path.segments)
    } else {
        empty_name()
    }
}

fn copy_string_list_to_name(seg: StringList) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: seg.head_len }
    var i: i64 = 0
    while i < seg.head_len && i < 128 {
        n.buf[i] = seg.head_buf[i]
        i = i + 1
    }
    n
}

fn copy_string_list_tail_to_name(seg: StringList) -> Name with Mut, Panic, Div, Alloc {
    match seg.tail {
        Some(rest) => copy_string_list_tail_to_name(*rest)
        None => copy_string_list_to_name(seg)
    }
}
