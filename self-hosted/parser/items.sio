// Parser — top-level item parsing
//
// Handles: fn, struct, enum, impl, type alias, use declarations.

use parser::ast::*
use lexer::token::*

impl Parser {
    // ============================================================
    // Parse a single item
    // ============================================================

    fn parse_item(self) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let k = self.peek()

        // Handle optional 'pub' visibility
        var is_pub = false
        var p = self
        if k == TokenKind::Pub {
            is_pub = true
            p = p.advance()
        }

        // Handle optional 'linear' or 'affine' modifier
        var is_linear = false
        var is_affine = false
        if p.peek() == TokenKind::Linear {
            is_linear = true
            p = p.advance()
        } else if p.peek() == TokenKind::Affine {
            is_affine = true
            p = p.advance()
        }

        // Handle optional 'kernel' modifier for GPU kernel functions
        var is_kernel = false
        if p.peek() == TokenKind::Kernel {
            is_kernel = true
            p = p.advance()
        }

        let item_kind = p.peek()

        if item_kind == TokenKind::Fn {
            p.parse_fn_item(is_pub, is_kernel)
        } else if item_kind == TokenKind::Struct {
            p.parse_struct_item(is_linear, is_affine, is_pub)
        } else if item_kind == TokenKind::Enum {
            p.parse_enum_item(is_pub)
        } else if item_kind == TokenKind::Impl {
            p.parse_impl_item(is_pub)
        } else if item_kind == TokenKind::Type {
            p.parse_type_alias_item(is_pub)
        } else if item_kind == TokenKind::ModelsLower {
            p.parse_models_item(is_pub)
        } else if item_kind == TokenKind::PolicyLower {
            p.parse_policy_item(is_pub)
        } else if item_kind == TokenKind::AcquisitionPolicyLower {
            p.parse_acquisition_policy_item(is_pub)
        } else if item_kind == TokenKind::RecoursePolicyLower {
            p.parse_recourse_policy_item(is_pub)
        } else if item_kind == TokenKind::MonitoringPolicyLower {
            p.parse_monitoring_policy_item(is_pub)
        } else if item_kind == TokenKind::TransitionPolicyLower {
            p.parse_transition_policy_item(is_pub)
        } else if item_kind == TokenKind::TransitionProtocolLower {
            p.parse_transition_protocol_item(is_pub)
        } else if item_kind == TokenKind::AlternativePolicyLower {
            p.parse_alternative_policy_item(is_pub)
        } else if item_kind == TokenKind::AlternativeFrontierLower {
            p.parse_alternative_frontier_item(is_pub)
        } else if item_kind == TokenKind::DecisionPolicyLower {
            p.parse_decision_policy_item(is_pub)
        } else if item_kind == TokenKind::DeferralPolicyLower {
            p.parse_deferral_policy_item(is_pub)
        } else if item_kind == TokenKind::ValidationLower {
            p.parse_validation_item(is_pub)
        } else if item_kind == TokenKind::AuditLower {
            p.parse_audit_item(is_pub)
        } else if item_kind == TokenKind::Use {
            p.parse_use_item(is_pub)
        } else if item_kind == TokenKind::Import {
            p.parse_use_item(is_pub)
        } else if item_kind == TokenKind::Let {
            p.parse_global_let_item(is_pub)
        } else if item_kind == TokenKind::Var {
            p.parse_global_var_item(is_pub)
        } else if item_kind == TokenKind::Unit {
            p.parse_unit_item(is_pub)
        } else if item_kind == TokenKind::Effect {
            p.parse_effect_item(is_pub)
        } else if item_kind == TokenKind::Session {
            p.parse_session_item(is_pub)
        } else if item_kind == TokenKind::Extern {
            p.parse_extern_fn_item(is_pub)
        } else if item_kind == TokenKind::Export {
            p.parse_export_fn_item(is_pub)
        } else {
            // Error recovery: skip token
            let span = p.current_span()
            p.had_error = true
            p.error_count = p.error_count + 1
            let pa = p.advance()
            (pa, Item {
                kind: ItemKind::ItemFn,
                span: span,
                is_pub: is_pub,
                name: empty_name(),
                fn_def: None,
                struct_def: None,
                enum_def: None,
                impl_def: None,
                type_alias_ty: None,
                policy_def: None,
                acquisition_policy_def: None,
                recourse_policy_def: None,
                decision_policy_def: None,
                deferral_policy_def: None,
                transition_policy_def: None,
                transition_protocol_def: None,
                monitoring_policy_def: None,
                alternative_policy_def: None,
                alternative_frontier_def: None,
                models_def: None,
                validation_def: None,
                audit_def: None,
                use_path: empty_path(),
                use_glob: false,
                use_items: None,
                effect_def: None,
                session_decl: None,
            })
        }
    }

    // ============================================================
    // Global bindings (top-level): let/var NAME [: Type] = expr
    // ============================================================

    fn parse_global_let_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'let'

        let name = p.current_name()
        p = p.expect_ident()

        // Optional type annotation
        let ty_pair = p.parse_optional_type()
        p = ty_pair.0

        // = expr
        p = p.expect(TokenKind::Eq)
        let expr_pair = p.parse_expr()
        p = expr_pair.0

        let span = p.span_from(start)
        (p, Item {
            kind: ItemKind::ItemFn,
            span: span,
            is_pub: is_pub,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
        })
    }

    fn parse_global_var_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'var'

        let name = p.current_name()
        p = p.expect_ident()

        // Optional type annotation
        let ty_pair = p.parse_optional_type()
        p = ty_pair.0

        // = expr
        p = p.expect(TokenKind::Eq)
        let expr_pair = p.parse_expr()
        p = expr_pair.0

        let span = p.span_from(start)
        (p, Item {
            kind: ItemKind::ItemFn,
            span: span,
            is_pub: is_pub,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
        })
    }

    // ============================================================
    // Function: fn name(params) -> RetType with Effects { body }
    // ============================================================

    fn parse_fn_item(self, is_pub: bool, is_kernel: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        if self.peek() != TokenKind::Fn {
            // Recovery: consume one token so callers never stall.
            let span = self.current_span()
            var p_bad = self
            p_bad.had_error = true
            p_bad.error_count = p_bad.error_count + 1
            p_bad = p_bad.advance()
            return (p_bad, Item {
                kind: ItemKind::ItemFn,
                span: span,
                is_pub: is_pub,
                name: empty_name(),
                fn_def: None,
                struct_def: None,
                enum_def: None,
                impl_def: None,
                type_alias_ty: None,
                policy_def: None,
                acquisition_policy_def: None,
                recourse_policy_def: None,
                decision_policy_def: None,
                deferral_policy_def: None,
                transition_policy_def: None,
                transition_protocol_def: None,
                monitoring_policy_def: None,
                alternative_policy_def: None,
                alternative_frontier_def: None,
                models_def: None,
                validation_def: None,
                audit_def: None,
                use_path: empty_path(),
                use_glob: false,
                use_items: None,
                effect_def: None,
                session_decl: None,
            })
        }

        let start = self.current_span()
        var p = self.advance()  // skip 'fn'

        let name = p.current_name()
        p = p.expect_ident()

        // Parameters
        p = p.expect(TokenKind::LParen)
        let pair = p.parse_param_list()
        p = pair.0
        let params_opt = pair.1
        p = p.expect(TokenKind::RParen)

        // Return type
        let pair2 = p.parse_optional_return_type()
        p = pair2.0
        let ret_ty = pair2.1

        // Effects
        var effects_opt: Option<Box<EffectList>> = None
        if p.peek() == TokenKind::With {
            let pair3 = p.parse_effect_list()
            p = pair3.0
            effects_opt = Some(Box::new(pair3.1))
        }

        // Body
        let pair4 = p.parse_block()
        p = pair4.0
        let body = pair4.1

        let span = p.span_from(start)
        let fn_def = FnDef {
            name: name,
            params: params_opt,
            return_type: ret_ty,
            effects: effects_opt,
            body: body,
            span: span,
            is_kernel: is_kernel,
        }

        (p, Item {
            kind: ItemKind::ItemFn,
            span: span,
            is_pub: is_pub,
            name: name,
            fn_def: Some(Box::new(fn_def)),
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
        })
    }

    // ============================================================
    // Parameter list
    // ============================================================

    fn parse_param_list(self) -> (Parser, Option<Box<ParamList>>) with Mut, IO, Panic, Div, Alloc {
        if self.peek() == TokenKind::RParen {
            return (self, None)
        }

        let pair = self.parse_param()
        var p = pair.0
        let first = pair.1
        var rev_params_opt: Option<Box<ParamList>> = Some(Box::new(ParamList { head: first, tail: None }))

        while p.peek() == TokenKind::Comma {
            p = p.advance()
            if p.peek() == TokenKind::RParen { break }
            let pair2 = p.parse_param()
            p = pair2.0
            let next = pair2.1
            rev_params_opt = Some(Box::new(ParamList { head: next, tail: rev_params_opt }))
        }

        (p, reverse_param_list_opt(rev_params_opt))
    }

    // ============================================================
    // Single parameter: name: Type  or  self
    // ============================================================

    fn parse_param(self) -> (Parser, Param) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()

        if self.peek() == TokenKind::SelfLower {
            // self parameter
            let name = self.current_name()
            let p = self.advance()
            let span = p.span_from(start)
            (p, Param {
                name: name,
                ty: dummy_type_expr(),
                is_self: true,
                is_self_mut: false,
                span: span,
            })
        } else {
            let name = self.current_name()
            var p = self.expect_ident()
            p = p.expect(TokenKind::Colon)
            let pair = p.parse_type()
            p = pair.0
            let ty = pair.1
            let span = p.span_from(start)
            (p, Param {
                name: name,
                ty: ty,
                is_self: false,
                is_self_mut: false,
                span: span,
            })
        }
    }

    // ============================================================
    // Struct: struct Name { field: Type, ... }
    // ============================================================

    fn parse_struct_item(self, is_linear: bool, is_affine: bool, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'struct'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::LBrace)

        // Parse fields
        var rev_fields_opt: Option<Box<FieldDefList>> = None

        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            let field_start = p.current_span()
            let field_name = p.current_name()
            p = p.expect_ident()
            p = p.expect(TokenKind::Colon)
            let pair = p.parse_type()
            p = pair.0
            let field_ty = pair.1

            let field = FieldDef { name: field_name, ty: field_ty, span: p.span_from(field_start) }

            rev_fields_opt = Some(Box::new(FieldDefList { head: field, tail: rev_fields_opt }))

            if p.peek() == TokenKind::Comma {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)
        let fields_opt = reverse_field_def_list_opt(rev_fields_opt)
        let span = p.span_from(start)
        let sdef = StructDef { name: name, fields: fields_opt, is_linear: is_linear, is_affine: is_affine, span: span }

        (p, Item {
            kind: ItemKind::ItemStruct,
            span: span,
            is_pub: is_pub,
            name: name,
            fn_def: None,
            struct_def: Some(Box::new(sdef)),
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
        })
    }

    // ============================================================
    // Enum: enum Name { Variant1, Variant2, ... }
    // ============================================================

    fn parse_enum_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'enum'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::LBrace)

        var rev_variants_opt: Option<Box<VariantDefList>> = None

        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            let v_start = p.current_span()
            let v_name = p.current_name()
            p = p.expect_ident()
            let v_span = p.span_from(v_start)

            let variant = VariantDef { name: v_name, span: v_span }

            rev_variants_opt = Some(Box::new(VariantDefList { head: variant, tail: rev_variants_opt }))

            if p.peek() == TokenKind::Comma {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)
        let variants_opt = reverse_variant_def_list_opt(rev_variants_opt)
        let span = p.span_from(start)
        let edef = EnumDef { name: name, variants: variants_opt, span: span }

        (p, Item {
            kind: ItemKind::ItemEnum,
            span: span,
            is_pub: is_pub,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: Some(Box::new(edef)),
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
        })
    }

    // ============================================================
    // Impl: impl Type { fn method() { } ... }
    // ============================================================

    fn parse_impl_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'impl'

        let pair = p.parse_type()
        p = pair.0
        let target_ty = pair.1
        p = p.expect(TokenKind::LBrace)

        // Build methods in reverse for O(1) cons, reverse once at the end.
        var rev_methods_opt: Option<Box<ItemList>> = None

        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            // Ignore trivia and doc comments between methods.
            while p.peek() == TokenKind::Newline || p.peek() == TokenKind::Semi || tk_is_doc_comment(p.peek()) {
                p = p.advance()
            }

            if p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
                if p.peek() == TokenKind::Fn {
                    let pair2 = p.parse_fn_item(false, false)
                    p = pair2.0
                    let method = pair2.1
                    rev_methods_opt = Some(Box::new(ItemList { head: method, tail: rev_methods_opt }))
                } else {
                    // Recovery: consume one unexpected token inside impl body.
                    p.had_error = true
                    p.error_count = p.error_count + 1
                    p = p.advance()
                }
            }
        }

        p = p.expect(TokenKind::RBrace)
        let span = p.span_from(start)
        let methods_opt = reverse_item_list_opt(rev_methods_opt)

        // Extract name from target type path
        let impl_name = extract_impl_name(target_ty)

        let idef = ImplDef { target_type: target_ty, methods: methods_opt, span: span }

        (p, Item {
            kind: ItemKind::ItemImpl,
            span: span,
            is_pub: is_pub,
            name: impl_name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: Some(Box::new(idef)),
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
        })
    }

    // ============================================================
    // Type alias: type Name = Type
    // ============================================================

    fn parse_type_alias_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'type'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::Eq)

        // Check for refinement type: { var: Type | predicate }
        if p.peek() == TokenKind::LBrace {
            let ref_pair = p.parse_refinement_type()
            p = ref_pair.0
            let ref_ty = ref_pair.1
            let span = p.span_from(start)
            return (p, Item {
                kind: ItemKind::ItemTypeAlias,
                span: span,
                is_pub: is_pub,
                name: name,
                fn_def: None,
                struct_def: None,
                enum_def: None,
                impl_def: None,
                type_alias_ty: Some(Box::new(ref_ty)),
                policy_def: None,
                acquisition_policy_def: None,
                recourse_policy_def: None,
                decision_policy_def: None,
                deferral_policy_def: None,
                transition_policy_def: None,
                transition_protocol_def: None,
                monitoring_policy_def: None,
                alternative_policy_def: None,
                alternative_frontier_def: None,
                models_def: None,
                validation_def: None,
                audit_def: None,
                use_path: empty_path(),
                use_glob: false,
                use_items: None,
                effect_def: None,
                session_decl: None,
            })
        }

        let pair = p.parse_type()
        p = pair.0
        let ty = pair.1

        let span = p.span_from(start)
        (p, Item {
            kind: ItemKind::ItemTypeAlias,
            span: span,
            is_pub: is_pub,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: Some(Box::new(ty)),
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
        })
    }

    // ============================================================
    // Policy: policy Name for Type { require metric >= value }
    // ============================================================

    fn parse_policy_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'policy'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::For)

        let target_pair = p.parse_type()
        p = target_pair.0
        let target_ty = target_pair.1

        var level_name = empty_name()
        var scope_name = empty_name()
        if p.peek() == TokenKind::Level {
            p = p.advance()
            level_name = p.current_name()
            p = p.expect_ident()
        }
        if p.peek() == TokenKind::Scope {
            p = p.advance()
            scope_name = p.current_name()
            p = p.expect_ident()
        }

        p = p.expect(TokenKind::LBrace)
        var rev_requirements_opt: Option<Box<PolicyRequirementList>> = None

        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            while p.peek() == TokenKind::Semi || p.peek() == TokenKind::Newline {
                p = p.advance()
            }
            if p.peek() == TokenKind::RBrace || p.peek() == TokenKind::Eof {
                break
            }

            let req_pair = p.parse_policy_requirement()
            p = req_pair.0
            rev_requirements_opt = Some(Box::new(PolicyRequirementList {
                head: req_pair.1,
                tail: rev_requirements_opt,
            }))

            while p.peek() == TokenKind::Semi {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)

        let span = p.span_from(start)
        let pdef = PolicyDef {
            name: name,
            target_type: target_ty,
            level_name: level_name,
