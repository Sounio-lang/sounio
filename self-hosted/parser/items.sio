fn audit_section_kind_from_name(name: Name) -> AuditSectionKind with Panic, Div {
    if name.len == 7
        && name.buf[0] == 109 as i8 && name.buf[1] == 101 as i8 && name.buf[2] == 116 as i8
        && name.buf[3] == 114 as i8 && name.buf[4] == 105 as i8 && name.buf[5] == 99 as i8
        && name.buf[6] == 115 as i8 {
        return AuditSectionKind::AuditSectionMetrics
    }
    if name.len == 11
        && name.buf[0] == 109 as i8 && name.buf[1] == 101 as i8 && name.buf[2] == 99 as i8
        && name.buf[3] == 104 as i8 && name.buf[4] == 97 as i8 && name.buf[5] == 110 as i8
        && name.buf[6] == 105 as i8 && name.buf[7] == 115 as i8 && name.buf[8] == 116 as i8
        && name.buf[9] == 105 as i8 && name.buf[10] == 99 as i8 {
        return AuditSectionKind::AuditSectionMechanistic
    }
    if name.len == 14
        && name.buf[0] == 99 as i8 && name.buf[1] == 111 as i8 && name.buf[2] == 117 as i8
        && name.buf[3] == 110 as i8 && name.buf[4] == 116 as i8 && name.buf[5] == 101 as i8
        && name.buf[6] == 114 as i8 && name.buf[7] == 101 as i8 && name.buf[8] == 120 as i8
        && name.buf[9] == 97 as i8 && name.buf[10] == 109 as i8 && name.buf[11] == 112 as i8
        && name.buf[12] == 108 as i8 && name.buf[13] == 101 as i8 {
        return AuditSectionKind::AuditSectionCounterexample
    }
    if name.len == 17
        && name.buf[0] == 112 as i8 && name.buf[1] == 111 as i8 && name.buf[2] == 115 as i8
        && name.buf[3] == 116 as i8 && name.buf[4] == 101 as i8 && name.buf[5] == 114 as i8
        && name.buf[6] == 105 as i8 && name.buf[7] == 111 as i8 && name.buf[8] == 114 as i8
        && name.buf[9] == 95 as i8 && name.buf[10] == 119 as i8 && name.buf[11] == 101 as i8
        && name.buf[12] == 105 as i8 && name.buf[13] == 103 as i8 && name.buf[14] == 104 as i8
        && name.buf[15] == 116 as i8 && name.buf[16] == 115 as i8 {
        return AuditSectionKind::AuditSectionPosteriorWeights
    }
    AuditSectionKind::AuditSectionUnknown
}

fn extract_impl_name(ty: TypeExpr) -> Name with Mut, Panic, Div, Alloc {
    if ty.kind == TypeExprKind::TypeNamed && ty.path.seg_count > 0 {
        copy_string_list_tail_to_name(ty.path.segments)
    } else {
        empty_name()
    }
}

fn parser_name_is_frontier(name: Name) -> bool with Panic, Div {
    name.len == 8
        && name.buf[0] == 102 as i8 && name.buf[1] == 114 as i8 && name.buf[2] == 111 as i8
        && name.buf[3] == 110 as i8 && name.buf[4] == 116 as i8 && name.buf[5] == 105 as i8
        && name.buf[6] == 101 as i8 && name.buf[7] == 114 as i8
}

fn parser_name_is_max_options(name: Name) -> bool with Panic, Div {
    name.len == 11
        && name.buf[0] == 109 as i8 && name.buf[1] == 97 as i8 && name.buf[2] == 120 as i8
        && name.buf[3] == 95 as i8 && name.buf[4] == 111 as i8 && name.buf[5] == 112 as i8
        && name.buf[6] == 116 as i8 && name.buf[7] == 105 as i8 && name.buf[8] == 111 as i8
        && name.buf[9] == 110 as i8 && name.buf[10] == 115 as i8
}

fn parser_name_is_under(name: Name) -> bool with Panic, Div {
    name.len == 5
        && name.buf[0] == 117 as i8 && name.buf[1] == 110 as i8 && name.buf[2] == 100 as i8
        && name.buf[3] == 101 as i8 && name.buf[4] == 114 as i8
}

fn parser_name_is_maximize(name: Name) -> bool with Panic, Div {
    name.len == 8
        && name.buf[0] == 109 as i8 && name.buf[1] == 97 as i8 && name.buf[2] == 120 as i8
        && name.buf[3] == 105 as i8 && name.buf[4] == 109 as i8 && name.buf[5] == 105 as i8
        && name.buf[6] == 122 as i8 && name.buf[7] == 101 as i8
}

fn parser_name_is_minimize(name: Name) -> bool with Panic, Div {
    name.len == 8
        && name.buf[0] == 109 as i8 && name.buf[1] == 105 as i8 && name.buf[2] == 110 as i8
        && name.buf[3] == 105 as i8 && name.buf[4] == 109 as i8 && name.buf[5] == 105 as i8
        && name.buf[6] == 122 as i8 && name.buf[7] == 101 as i8
}

fn parser_name_is_candidate(name: Name) -> bool with Panic, Div {
    name.len == 9
        && name.buf[0] == 99 as i8 && name.buf[1] == 97 as i8 && name.buf[2] == 110 as i8
        && name.buf[3] == 100 as i8 && name.buf[4] == 105 as i8 && name.buf[5] == 100 as i8
        && name.buf[6] == 97 as i8 && name.buf[7] == 116 as i8 && name.buf[8] == 101 as i8
}

fn parser_name_is_via(name: Name) -> bool with Panic, Div {
    name.len == 3
        && name.buf[0] == 118 as i8 && name.buf[1] == 105 as i8 && name.buf[2] == 97 as i8
}

fn parser_name_is_value(name: Name) -> bool with Panic, Div {
    name.len == 5
        && name.buf[0] == 118 as i8 && name.buf[1] == 97 as i8 && name.buf[2] == 108 as i8
        && name.buf[3] == 117 as i8 && name.buf[4] == 101 as i8
}

fn parser_name_is_metrics(name: Name) -> bool with Panic, Div {
    name.len == 7
        && name.buf[0] == 109 as i8 && name.buf[1] == 101 as i8 && name.buf[2] == 116 as i8
        && name.buf[3] == 114 as i8 && name.buf[4] == 105 as i8 && name.buf[5] == 99 as i8
        && name.buf[6] == 115 as i8
}

fn copy_string_list_to_name(seg: StringList) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: seg.head_len }
    var i: i64 = 0
    while i < seg.head_len && i < 128 {
        n.buf[i] = seg.head_buf[i]
        i = i + 1
    }
    n
}

fn copy_string_list_tail_to_name(seg: StringList) -> Name with Mut, Panic, Div, Alloc {
    match seg.tail {
        Some(rest) => copy_string_list_tail_to_name(*rest)
        None => copy_string_list_to_name(seg)
    }
}
