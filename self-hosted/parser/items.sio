    fn parse_transition_policy_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'transition_policy'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::For)

        let target_pair = p.parse_type()
        p = target_pair.0
        let target_ty = target_pair.1

        var route_name = empty_name()
        if parser_peek(p) == TokenKind::Route {
            p = p.advance()
            route_name = p.current_name()
            p = p.expect_ident()
        }

        p = p.expect(TokenKind::LBrace)
        var rev_requirements_opt: Option<Box<PolicyRequirementList>> = None
        var max_steps: i64 = -1
        var rollback_route_name = empty_name()

        while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
            while parser_peek(p) == TokenKind::Semi || parser_peek(p) == TokenKind::Newline {
                p = p.advance()
            }
            if parser_peek(p) == TokenKind::RBrace || parser_peek(p) == TokenKind::Eof {
                break
            }

            if parser_peek(p) == TokenKind::Require {
                let req_pair = p.parse_policy_requirement()
                p = req_pair.0
                rev_requirements_opt = Some(Box::new(PolicyRequirementList {
                    head: req_pair.1,
                    tail: rev_requirements_opt,
                }))
            } else if parser_peek(p) == TokenKind::MaxSteps {
                p = p.advance()
                if parser_peek(p) == TokenKind::IntLit {
                    max_steps = p.current().int_value
                    p = p.advance()
                } else {
                    p.had_error = true
                    p.error_count = p.error_count + 1
                    p = p.advance()
                }
            } else if parser_peek(p) == TokenKind::RollbackRoute {
                p = p.advance()
                rollback_route_name = p.current_name()
                p = p.expect_ident()
            } else {
                p.had_error = true
                p.error_count = p.error_count + 1
                p = p.advance()
            }

            while parser_peek(p) == TokenKind::Semi {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)

        let span = p.span_from(start)
        let tdef = TransitionPolicyDef {
            name: name,
            target_type: target_ty,
            route_name: route_name,
            requirements: reverse_policy_requirement_list_opt(rev_requirements_opt),
            max_steps: max_steps,
            rollback_route_name: rollback_route_name,
            span: span,
        }

        (p, Item {
            kind: ItemKind::ItemTransitionPolicy,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: Some(Box::new(tdef)),
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

