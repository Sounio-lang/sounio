// Parser — top-level item parsing
//
// Handles: fn, struct, enum, impl, type alias, use declarations.

use parser::ast::*
use lexer::token::*
use parser::parser::{parser_peek, parser_at_eof, pt_read_kind, pt_read_kind_code, parser_peek_ahead, parser_advance, mk_expr, error_expr, dummy_type_expr, parser_take_expr_box}
use parser::types::*
use parser::exprs::*
use parser::stmts::*

impl Parser {
    // ============================================================
    // Parse a single item
    // ============================================================

    fn parse_item(self) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let k = self.peek()

        // Handle optional 'pub' visibility
        var visibility = visibility_private()
        var p = self
        if k == TokenKind::Pub {
            let vis_pair = p.parse_pub_visibility()
            p = vis_pair.0
            visibility = vis_pair.1
        }

        // Handle optional 'linear' or 'affine' modifier
        var is_linear = false
        var is_affine = false
        if parser_peek(p) == TokenKind::Linear {
            is_linear = true
            p = p.advance()
        } else if parser_peek(p) == TokenKind::Affine {
            is_affine = true
            p = p.advance()
        }
        if parser_peek(p) == TokenKind::Ident {
            let mod_name = p.current_name()
            if mod_name.len == 8
                && mod_name.buf[0] == (114 as i8)
                && mod_name.buf[1] == (101 as i8)
                && mod_name.buf[2] == (108 as i8)
                && mod_name.buf[3] == (101 as i8)
                && mod_name.buf[4] == (118 as i8)
                && mod_name.buf[5] == (97 as i8)
                && mod_name.buf[6] == (110 as i8)
                && mod_name.buf[7] == (116 as i8)
                && parser_peek_ahead(p, 1) == TokenKind::Struct {
                p = p.advance()
            }
        }

        // Handle optional 'kernel' modifier for GPU kernel functions
        var is_kernel = false
        if parser_peek(p) == TokenKind::Kernel {
            is_kernel = true
            p = p.advance()
        }

        if parser_peek(p) == TokenKind::Const && parser_peek_ahead(p, 1) == TokenKind::Fn {
            p = p.advance()
        }
        if parser_peek(p) == TokenKind::Async && parser_peek_ahead(p, 1) == TokenKind::Fn {
            p = p.advance()
        }

        let item_kind = parser_peek(p)

        // Detect "module NAME" declarations when module is treated as an identifier
        // (the boot4-safe lexer returns Ident for "module" to avoid keyword conflicts).
        var is_module_decl = false
        if item_kind == TokenKind::Ident {
            let probe_name = p.current_name()
            if probe_name.len == 6
                && probe_name.buf[0] == (109 as i8)
                && probe_name.buf[1] == (111 as i8)
                && probe_name.buf[2] == (100 as i8)
                && probe_name.buf[3] == (117 as i8)
                && probe_name.buf[4] == (108 as i8)
                && probe_name.buf[5] == (101 as i8) {
                let next_kind = parser_peek_ahead(p, 1)
                if next_kind == TokenKind::ColonColon || next_kind == TokenKind::Ident || next_kind == TokenKind::Ontology {
                    is_module_decl = true
                }
            }
        }

        if is_module_decl {
            p.parse_module_item(visibility)
        } else if item_kind == TokenKind::Fn {
            p.parse_fn_item(visibility, is_kernel)
        } else if item_kind == TokenKind::Struct {
            p.parse_struct_item(is_linear, is_affine, visibility)
        } else if item_kind == TokenKind::Enum {
            p.parse_enum_item(visibility)
        } else if item_kind == TokenKind::Impl {
            p.parse_impl_item(visibility)
        } else if item_kind == TokenKind::Type {
            p.parse_type_alias_item(visibility)
        } else if item_kind == TokenKind::Const {
            p.parse_global_let_item(visibility)
        } else if item_kind == TokenKind::ModelsLower {
            p.parse_models_item(visibility)
        } else if item_kind == TokenKind::PolicyLower {
            p.parse_policy_item(visibility)
        } else if item_kind == TokenKind::AcquisitionPolicyLower {
            p.parse_acquisition_policy_item(visibility)
        } else if item_kind == TokenKind::RecoursePolicyLower {
            p.parse_recourse_policy_item(visibility)
        } else if item_kind == TokenKind::MonitoringPolicyLower {
            p.parse_monitoring_policy_item(visibility)
        } else if item_kind == TokenKind::TransitionPolicyLower {
            p.parse_transition_policy_item(visibility)
        } else if item_kind == TokenKind::TransitionProtocolLower {
            p.parse_transition_protocol_item(visibility)
        } else if item_kind == TokenKind::AlternativePolicyLower {
            p.parse_alternative_policy_item(visibility)
        } else if item_kind == TokenKind::AlternativeFrontierLower {
            p.parse_alternative_frontier_item(visibility)
        } else if item_kind == TokenKind::DecisionPolicyLower {
            p.parse_decision_policy_item(visibility)
        } else if item_kind == TokenKind::DeferralPolicyLower {
            p.parse_deferral_policy_item(visibility)
        } else if item_kind == TokenKind::ValidationLower {
            p.parse_validation_item(visibility)
        } else if item_kind == TokenKind::AuditLower {
            p.parse_audit_item(visibility)
        } else if item_kind == TokenKind::Use {
            p.parse_use_item(visibility)
        } else if item_kind == TokenKind::Import {
            p.parse_use_item(visibility)
        } else if item_kind == TokenKind::Module {
            p.parse_module_item(visibility)
        } else if item_kind == TokenKind::Let {
            p.parse_global_let_item(visibility)
        } else if item_kind == TokenKind::Var {
            p.parse_global_var_item(visibility)
        } else if item_kind == TokenKind::Unit {
            p.parse_unit_item(visibility)
        } else if item_kind == TokenKind::Effect {
            p.parse_effect_item(visibility)
        } else if item_kind == TokenKind::Session {
            p.parse_session_item(visibility)
        } else if item_kind == TokenKind::Trait {
            p.parse_trait_item(visibility)
        } else if item_kind == TokenKind::Algebra {
            p.parse_algebra_item(visibility)
        } else if item_kind == TokenKind::Study {
            p.parse_study_item(visibility)
        } else if item_kind == TokenKind::Ontology {
            p.parse_ontology_item(visibility)
        } else if item_kind == TokenKind::Extern {
            p.parse_extern_fn_item(visibility)
        } else if item_kind == TokenKind::Export {
            p.parse_export_fn_item(visibility)
        } else {
            // Error recovery: skip token
            let span = p.current_span()
            p.had_error = true
            p.error_count = p.error_count + 1
            let pa = p.advance()
            let en = empty_name()
            let ep2 = empty_path()
            let result_item = Item {
                kind: ItemKind::ItemFn,
                span: span,
                visibility: visibility,
                name: en,
                fn_def: None,
                struct_def: None,
                enum_def: None,
                impl_def: None,
                type_alias_ty: None,
                policy_def: None,
                acquisition_policy_def: None,
                recourse_policy_def: None,
                decision_policy_def: None,
                deferral_policy_def: None,
                transition_policy_def: None,
                transition_protocol_def: None,
                monitoring_policy_def: None,
                alternative_policy_def: None,
                alternative_frontier_def: None,
                models_def: None,
                validation_def: None,
                audit_def: None,
                use_path: ep2,
                use_glob: false,
                use_items: None,
                effect_def: None,
                session_decl: None,
                trait_def: None,
                algebra_def: None,
                study_def: None,
                ontology_def: None,
            }
            (pa, result_item)
        }
    }

    // ============================================================
    // Visibility modifier: pub, pub(crate), pub(super), pub(path)
    // ============================================================

    fn parse_pub_visibility(self) -> (Parser, Visibility) with Mut, IO, Panic, Div, Alloc {
        var p = self.advance()  // skip 'pub'
        if parser_peek(p) == TokenKind::LParen {
            p = p.advance()  // skip '('
            let k = parser_peek(p)
            if k == TokenKind::Crate {
                p = p.advance()  // skip 'crate'
                p = p.expect(TokenKind::RParen)
                (p, visibility_pub_crate())
            } else if k == TokenKind::Super {
                p = p.advance()  // skip 'super'
                p = p.expect(TokenKind::RParen)
                (p, visibility_pub_super())
            } else {
                // pub(path::to)
                let path_pair = p.parse_type_path()
                p = path_pair.0
                let path = path_pair.1
                p = p.expect(TokenKind::RParen)
                (p, visibility_pub_in(path))
            }
        } else {
            (p, visibility_pub())
        }
    }

    // ============================================================
    // Module declaration: module foo::bar
    // ============================================================

    fn parse_module_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'module'

        // Consume the module path (Ident (:: Ident)*) directly. The boot4-safe lexer
        // (lex_source_to_globals) does NOT emit Newline tokens, so the previous
        // "consume until Newline" loop ran to EOF and swallowed the entire file as a
        // single item — leaving every subsequent fn/struct unparsed in multi-module
        // compilation (the imported typecheck then saw 0 functions for these modules).
        while parser_peek(p) == TokenKind::Ident
            || parser_peek(p) == TokenKind::ColonColon
            || parser_peek(p) == TokenKind::Ontology {
            p = p.advance_raw()
        }
        if parser_peek(p) == TokenKind::Newline {
            p = p.advance_raw()
        }

        let span = p.span_from(start)
        (p, Item {
            kind: ItemKind::ItemUnit,
            span: span,
            visibility: visibility,
            name: empty_name(),
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    // ============================================================
    // Global bindings (top-level): let/const NAME [: Type] = expr; var NAME [: Type] [= expr]
    // ============================================================

    fn parse_global_let_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'let'

        let name = p.current_name()
        p = p.expect_ident()

        // Optional type annotation
        let ty_pair = p.parse_optional_type()
        p = ty_pair.0

        p = p.expect(TokenKind::Eq)
        p = p.parse_expr()
        let init_let_box = parser_take_expr_box()
        if (*init_let_box).kind == ExprKind::ExprIntLit {
            ast_record_global_var_init(name, (*init_let_box).int_val)
        } else if (*init_let_box).kind == ExprKind::ExprUnary && (*init_let_box).un_op == UnaryOp::OpNeg {
            match (*init_let_box).left {
                Some(operand) => {
                    if (*operand).kind == ExprKind::ExprIntLit {
                        ast_record_global_var_init(name, 0 - (*operand).int_val)
                    }
                }
                _ => {}
            }
        }
        if parser_peek(p) == TokenKind::Semi {
            p = p.advance()
        }

        let span = p.span_from(start)
        (p, Item {
            kind: ItemKind::ItemFn,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    fn parse_global_var_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'var'

        let name = p.current_name()
        p = p.expect_ident()

        // Optional type annotation
        let ty_pair = p.parse_optional_type()
        p = ty_pair.0
        let global_ty: Option<Box<TypeExpr>> = ty_pair.1

        if parser_peek(p) == TokenKind::Eq {
            p = p.advance()
            p = p.parse_expr()
            let init_var_box = parser_take_expr_box()
            if (*init_var_box).kind == ExprKind::ExprIntLit {
                ast_record_global_var_init(name, (*init_var_box).int_val)
            } else if (*init_var_box).kind == ExprKind::ExprUnary && (*init_var_box).un_op == UnaryOp::OpNeg {
                match (*init_var_box).left {
                    Some(operand) => {
                        if (*operand).kind == ExprKind::ExprIntLit {
                            ast_record_global_var_init(name, 0 - (*operand).int_val)
                        }
                    }
                    _ => {}
                }
            }
        }
        if parser_peek(p) == TokenKind::Semi {
            p = p.advance()
        }

        let span = p.span_from(start)
        (p, Item {
            kind: ItemKind::ItemFn,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: global_ty,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    // ============================================================
    // Function: fn name(params) -> RetType with Effects { body }
    // ============================================================

    fn parse_fn_item(self, visibility: Visibility, is_kernel: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let pfi_k = self.peek()
        if pfi_k != TokenKind::Fn {
            // Recovery: consume one token so callers never stall.
            let span = self.current_span()
            var p_bad = self
            p_bad.had_error = true
            p_bad.error_count = p_bad.error_count + 1
            p_bad = p_bad.advance()
            return (p_bad, Item {
                kind: ItemKind::ItemFn,
                span: span,
                visibility: visibility,
                name: empty_name(),
                fn_def: None,
                struct_def: None,
                enum_def: None,
                impl_def: None,
                type_alias_ty: None,
                policy_def: None,
                acquisition_policy_def: None,
                recourse_policy_def: None,
                decision_policy_def: None,
                deferral_policy_def: None,
                transition_policy_def: None,
                transition_protocol_def: None,
                monitoring_policy_def: None,
                alternative_policy_def: None,
                alternative_frontier_def: None,
                models_def: None,
                validation_def: None,
                audit_def: None,
                use_path: empty_path(),
                use_glob: false,
                use_items: None,
                effect_def: None,
                session_decl: None,
                algebra_def: None,
                study_def: None,
                ontology_def: None,
                trait_def: None,
            })
        }

        let start = self.current_span()
        var p = self.advance()  // skip 'fn'
        let name = p.current_name()
        p = p.expect_ident()
        if parser_peek(p) == TokenKind::Lt {
            p = p.parse_type_param_header()
        }
        // Parameters
        p = p.expect(TokenKind::LParen)
        let pair = p.parse_param_list()
        p = pair.0
        let params_opt = pair.1
        p = p.expect(TokenKind::RParen)
        // Return type
        let pair2 = p.parse_optional_return_type()
        p = pair2.0
        let ret_ty = pair2.1
        // Effects
        // p came from pair2.0 (SIZE_HINT type) — use parser_peek free fn
        var effects_opt: Option<Box<EffectList>> = None
        if parser_peek(p) == TokenKind::With {
            let pair3 = p.parse_effect_list()
            p = pair3.0
            effects_opt = Some(Box::new(pair3.1))
        }
        // Body
        let pair4 = p.parse_block()
        p = pair4.0
        let body = pair4.1
        if parser_peek(p) == TokenKind::With {
            let pair5 = p.parse_effect_list()
            p = pair5.0
            match effects_opt {
                None => {
                    effects_opt = Some(Box::new(pair5.1))
                },
                Some(_) => {},
            }
        }

        let span = p.span_from(start)
        let fn_def = FnDef {
            name: name,
            params: params_opt,
            return_type: ret_ty,
            effects: effects_opt,
            body: body,
            span: span,
            is_kernel: is_kernel,
            is_extern: false,
        }

        (p, Item {
            kind: ItemKind::ItemFn,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: Some(Box::new(fn_def)),
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    // ============================================================
    // Parameter list
    // ============================================================

    fn parse_param_list(self) -> (Parser, Option<Box<ParamList>>) with Mut, IO, Panic, Div, Alloc {
        if self.peek() == TokenKind::RParen {
            let none_params: Option<Box<ParamList>> = None
            return (self, none_params)
        }
        let pair = self.parse_param()
        var p = pair.0
        let first = pair.1
        var rev_params_opt: Option<Box<ParamList>> = Some(Box::new(ParamList { head: first, tail: None }))

        while parser_peek(p) == TokenKind::Comma {
            p = p.advance()
            if parser_peek(p) == TokenKind::RParen { break }
            let pair2 = p.parse_param()
            p = pair2.0
            let next = pair2.1
            rev_params_opt = Some(Box::new(ParamList { head: next, tail: rev_params_opt }))
        }
        let rp = reverse_param_list_opt(rev_params_opt)
        (p, rp)
    }

    // ============================================================
    // Single parameter: name: Type  or  self
    // ============================================================

    fn parse_param(self) -> (Parser, Param) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()

        if self.peek() == TokenKind::SelfLower {
            // self parameter
            let name = self.current_name()
            var p = self.advance()
            var ty = dummy_type_expr()
            if parser_peek(p) == TokenKind::Colon {
                p = p.advance()
                let pair = p.parse_type()
                p = pair.0
                ty = pair.1
            }
            let span = p.span_from(start)
            (p, Param {
                name: name,
                ty: ty,
                is_self: true,
                is_self_mut: false,
                span: span,
            })
        } else {
            let name = self.current_name()
            var p = self.expect_ident()
            p = p.expect(TokenKind::Colon)
            let pair = p.parse_type()
            p = pair.0
            let ty = pair.1
            let span = p.span_from(start)
            (p, Param {
                name: name,
                ty: ty,
                is_self: false,
                is_self_mut: false,
                span: span,
            })
        }
    }

    // ============================================================
    // Struct: struct Name { field: Type, ... }
    // ============================================================

    fn parse_struct_item(self, is_linear: bool, is_affine: bool, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'struct'

        let name = p.current_name()
        p = p.expect_ident()

        // Parse optional type parameters: struct Foo<T, U> { ... }
        var type_params_opt: Option<Box<TypeParamDefList>> = None
        if parser_peek(p) == TokenKind::Lt {
            p = p.advance()  // skip '<'
            var rev_tparams: Option<Box<TypeParamDefList>> = None
            while parser_peek(p) != TokenKind::Gt && parser_peek(p) != TokenKind::Eof {
                let tp_span = p.current_span()
                if parser_peek(p) == TokenKind::Const {
                    p = p.advance()
                }
                let tp_name = p.current_name()
                p = p.expect_ident()
                if parser_peek(p) == TokenKind::Colon {
                    p = p.advance()
                    let ann_pair = p.parse_type()
                    p = ann_pair.0
                }
                let tpd = TypeParamDef { name: tp_name, span: p.span_from(tp_span) }
                rev_tparams = Some(Box::new(TypeParamDefList { head: tpd, tail: rev_tparams }))
                if parser_peek(p) == TokenKind::Comma {
                    p = p.advance()
                } else if parser_peek(p) != TokenKind::Gt {
                    p = p.advance()
                }
            }
            p = p.expect(TokenKind::Gt)
            type_params_opt = reverse_type_param_def_list_opt(rev_tparams)
        }

        p = p.expect(TokenKind::LBrace)

        // Parse fields
        var rev_fields_opt: Option<Box<FieldDefList>> = None

        while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
            let field_start = p.current_span()
            if parser_peek(p) == TokenKind::Pub {
                p = p.advance()
            }
            let field_name = p.current_name()
            p = p.expect_ident()
            p = p.expect(TokenKind::Colon)
            let pair = p.parse_type()
            p = pair.0
            let field_ty = pair.1

            let field = FieldDef { name: field_name, ty: field_ty, span: p.span_from(field_start) }

            rev_fields_opt = Some(Box::new(FieldDefList { head: field, tail: rev_fields_opt }))

            if parser_peek(p) == TokenKind::Comma {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)
        let fields_opt = reverse_field_def_list_opt(rev_fields_opt)
        let span = p.span_from(start)
        let sdef = StructDef { name: name, type_params: type_params_opt, fields: fields_opt, is_linear: is_linear, is_affine: is_affine, span: span }

        (p, Item {
            kind: ItemKind::ItemStruct,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: Some(Box::new(sdef)),
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    fn parse_type_param_header(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        var p = self.expect(TokenKind::Lt)
        while parser_peek(p) != TokenKind::Gt && parser_peek(p) != TokenKind::Eof {
            if parser_peek(p) == TokenKind::Const {
                p = p.advance()
            }
            p = p.expect_ident()
            if parser_peek(p) == TokenKind::Colon {
                p = p.advance()
                let ann_pair = p.parse_type()
                p = ann_pair.0
            }
            if parser_peek(p) == TokenKind::Comma {
                p = p.advance()
            } else if parser_peek(p) != TokenKind::Gt {
                p = p.advance()
            }
        }
        p.expect(TokenKind::Gt)
    }

    // ============================================================
    // Enum: enum Name { Variant1, Variant2, ... }
    // ============================================================

    fn parse_enum_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'enum'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::LBrace)

        var rev_variants_opt: Option<Box<VariantDefList>> = None

        while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
            let v_start = p.current_span()
            let v_name = p.current_name()
            p = p.expect_ident()

            // Parse optional variant fields: Variant { field1: Type1, field2: Type2 }
            var v_fields: Option<Box<FieldDefList>> = None
            if parser_peek(p) == TokenKind::LBrace {
                p = p.advance()  // skip {
                var rev_fields: Option<Box<FieldDefList>> = None
                while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
                    if parser_peek(p) == TokenKind::Pub {
                        p = p.advance()
                    }
                    let f_name = p.current_name()
                    p = p.expect_ident()
                    p = p.expect(TokenKind::Colon)
                    let ty_pair = p.parse_type()
                    p = ty_pair.0
                    let f_ty = ty_pair.1
                    let f_span = p.span_from(v_start)
                    let fdef = FieldDef { name: f_name, ty: f_ty, span: f_span }
                    rev_fields = Some(Box::new(FieldDefList { head: fdef, tail: rev_fields }))
                    if parser_peek(p) == TokenKind::Comma {
                        p = p.advance()
                    }
                }
                p = p.expect(TokenKind::RBrace)
                v_fields = reverse_field_def_list_opt(rev_fields)
            }

            let v_span = p.span_from(v_start)
            let variant = VariantDef { name: v_name, fields: v_fields, span: v_span }

            rev_variants_opt = Some(Box::new(VariantDefList { head: variant, tail: rev_variants_opt }))

            if parser_peek(p) == TokenKind::Comma {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)
        let variants_opt = reverse_variant_def_list_opt(rev_variants_opt)
        let span = p.span_from(start)
        let edef = EnumDef { name: name, variants: variants_opt, span: span }

        (p, Item {
            kind: ItemKind::ItemEnum,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: Some(Box::new(edef)),
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    // ============================================================
    // Impl: impl Type { fn method() { } ... }
    // ============================================================

    fn parse_impl_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'impl'

        let pair = p.parse_type()
        p = pair.0
        let target_ty = pair.1
        p = p.expect(TokenKind::LBrace)

        // Build methods in reverse for O(1) cons, reverse once at the end.
        var rev_methods_opt: Option<Box<ItemList>> = None

        while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
            // Ignore trivia and doc comments between methods.
            while parser_peek(p) == TokenKind::Newline || parser_peek(p) == TokenKind::Semi || tk_is_doc_comment(parser_peek(p)) {
                p = p.advance()
            }

            if parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
                if parser_peek(p) == TokenKind::Fn {
                    // First arg is `visibility: Visibility` (a struct), NOT a bool. Passing
                    // `false` here was an ABI mismatch (bool bits read as a Visibility) that
                    // corrupted the call and SIGSEGV'd on every impl method; it built only
                    // because the type error is a non-fatal warning. Methods default private.
                    let pair2 = p.parse_fn_item(visibility_private(), false)
                    p = pair2.0
                    let method = pair2.1
                    rev_methods_opt = Some(Box::new(ItemList { head: method, tail: rev_methods_opt }))
                } else {
                    // Recovery: consume one unexpected token inside impl body.
                    p.had_error = true
                    p.error_count = p.error_count + 1
                    p = p.advance()
                }
            }
        }

        p = p.expect(TokenKind::RBrace)
        let span = p.span_from(start)
        let methods_opt = reverse_item_list_opt(rev_methods_opt)

        // Extract name from target type path
        let impl_name = extract_impl_name(target_ty)

        let idef = ImplDef { target_type: target_ty, methods: methods_opt, span: span, trait_name: empty_name() }

        (p, Item {
            kind: ItemKind::ItemImpl,
            span: span,
            visibility: visibility,
            name: impl_name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: Some(Box::new(idef)),
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
            trait_def: None,
        })
    }

    // ============================================================
    // Trait definition: trait Name { fn method(); ... }
    // ============================================================

    fn parse_trait_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'trait'
        let name = p.current_name()
        p = p.advance()  // skip name

        // Parse trait body: { fn m1(); fn m2(x: i64) -> i64; ... }
        p = p.expect(TokenKind::LBrace)
        var rev_methods_opt: Option<Box<ItemList>> = None
        while parser_peek(p) != TokenKind::RBrace && !parser_at_eof(p) {
            let method_pair = p.parse_item()
            p = method_pair.0
            let method_item = method_pair.1
            rev_methods_opt = Some(Box::new(ItemList { head: method_item, tail: rev_methods_opt }))
        }
        p = p.expect(TokenKind::RBrace)
        let methods_opt = reverse_item_list_opt(rev_methods_opt)

        let span = p.span_from(start)
        let tdef = TraitItemDef { name: name, methods: methods_opt, supertraits: None, span: span }

        (p, Item {
            kind: ItemKind::ItemTrait,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
            trait_def: Some(Box::new(tdef)),
        })
    }

    // ============================================================
    // Type alias: type Name = Type
    // ============================================================

    fn parse_type_alias_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'type'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::Eq)

        // Check for refinement type: { var: Type | predicate }
        if parser_peek(p) == TokenKind::LBrace {
            let ref_pair = p.parse_refinement_type()
            p = ref_pair.0
            let ref_ty = ref_pair.1
            if parser_peek(p) == TokenKind::Semi {
                p = p.advance()
            }
            let span = p.span_from(start)
            return (p, Item {
                kind: ItemKind::ItemTypeAlias,
                span: span,
                visibility: visibility,
                name: name,
                fn_def: None,
                struct_def: None,
                enum_def: None,
                impl_def: None,
                type_alias_ty: Some(Box::new(ref_ty)),
                policy_def: None,
                acquisition_policy_def: None,
                recourse_policy_def: None,
                decision_policy_def: None,
                deferral_policy_def: None,
                transition_policy_def: None,
                transition_protocol_def: None,
                monitoring_policy_def: None,
                alternative_policy_def: None,
                alternative_frontier_def: None,
                models_def: None,
                validation_def: None,
                audit_def: None,
                use_path: empty_path(),
                use_glob: false,
                use_items: None,
                effect_def: None,
                session_decl: None,
                algebra_def: None,
                study_def: None,
                ontology_def: None,
                trait_def: None,
            })
        }

        let pair = p.parse_type()
        p = pair.0
        let ty = pair.1
        if parser_peek(p) == TokenKind::Semi {
            p = p.advance()
        }

        let span = p.span_from(start)
        (p, Item {
            kind: ItemKind::ItemTypeAlias,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: Some(Box::new(ty)),
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    // ============================================================
    // Policy: policy Name for Type { require metric >= value }
    // ============================================================

    fn parse_policy_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'policy'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::For)

        let target_pair = p.parse_type()
        p = target_pair.0
        let target_ty = target_pair.1

        var level_name = empty_name()
        var scope_name = empty_name()
        if parser_peek(p) == TokenKind::Level {
            p = p.advance()
            level_name = p.current_name()
            p = p.expect_ident()
        }
        if parser_peek(p) == TokenKind::Scope {
            p = p.advance()
            scope_name = p.current_name()
            p = p.expect_ident()
        }

        p = p.expect(TokenKind::LBrace)
        var rev_requirements_opt: Option<Box<PolicyRequirementList>> = None

        while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
            while parser_peek(p) == TokenKind::Semi || parser_peek(p) == TokenKind::Newline {
                p = p.advance()
            }
            if parser_peek(p) == TokenKind::RBrace || parser_peek(p) == TokenKind::Eof {
                break
            }

            let req_pair = p.parse_policy_requirement()
            p = req_pair.0
            rev_requirements_opt = Some(Box::new(PolicyRequirementList {
                head: req_pair.1,
                tail: rev_requirements_opt,
            }))

            while parser_peek(p) == TokenKind::Semi {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)

        let span = p.span_from(start)
        let pdef = PolicyDef {
            name: name,
            target_type: target_ty,
            level_name: level_name,
            scope_name: scope_name,
            requirements: reverse_policy_requirement_list_opt(rev_requirements_opt),
            span: span,
        }

        (p, Item {
            kind: ItemKind::ItemPolicy,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: Some(Box::new(pdef)),
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

