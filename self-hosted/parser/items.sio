// Parser — top-level item parsing
//
// Handles: fn, struct, enum, impl, type alias, use declarations.

use parser::ast::*
use lexer::token::*
use parser::parser::{parser_peek, parser_at_eof, pt_read_kind, pt_read_kind_code, pt_read_start, pt_read_end, parser_peek_ahead, parser_advance, mk_expr, error_expr, dummy_type_expr, parser_take_expr_box, parser_name_at}
use parser::types::*
use parser::exprs::*
use parser::stmts::*

fn items_reverse_item_list_opt(items: Option<Box<ItemList>>) -> Option<Box<ItemList>> with Mut, Alloc {
    items_reverse_item_list_loop(items, None)
}

// Scratch env for pure-fn multi-stmt body fold (`let x = 10; x`).
// Active only while items_maybe_record_pure_fn_const walks a body; never
// published into GLOBAL_VAR_INIT (avoids local/global name collisions).
// Wave13e: also binds const call-site args for pure paramful callees.
var PURE_FN_LOCAL_N: i64 = 0
var PURE_FN_LOCAL_H: [i64; 32] = [0; 32]
var PURE_FN_LOCAL_V: [i64; 32] = [0; 32]

// Pure paramful registry (Wave13e / Wave15a) — call-site scratch +
// GLOBAL_VAR_INIT multi-word descriptors (seed-safe append-only table).
//   KIND 1 = binary of two Idents → OP + ARG_V0/1
//   KIND 2 = bare Ident 1-param → ARG_V0
//   KIND 3 = multi-stmt / general pure return chain → body walker
// Wave13e residual: a `[*mut StmtList; N]` body-pointer table poisoned
// same-module KIND 1/2 when a multi-stmt paramful was merely defined.
// Wave15a stores StmtList pointer bits as i64 inside GLOBAL_VAR_INIT
// (same pattern as check/specializer SPEC_*_PTRS) — no raw-pointer array.
var PURE_FN_REG_N: i64 = 0
var PURE_FN_REG_HASH: [i64; 128] = [0; 128]
var PURE_FN_REG_PC: [i64; 128] = [0; 128]
var PURE_FN_REG_KIND: [i64; 128] = [0; 128]
var PURE_FN_REG_OP: [i64; 128] = [0; 128]
var PURE_FN_REG_PH0: [i64; 128] = [0; 128]
var PURE_FN_REG_PH1: [i64; 128] = [0; 128]
var PURE_FN_REG_PH2: [i64; 128] = [0; 128]
var PURE_FN_REG_PH3: [i64; 128] = [0; 128]
var PURE_FN_CALL_DEPTH: i64 = 0
var PURE_FN_ACTIVE_SLOT: i64 = 0 - 1
var PURE_FN_ARG_V0: i64 = 0
var PURE_FN_ARG_V1: i64 = 0
var PURE_FN_ARG_V2: i64 = 0
var PURE_FN_ARG_V3: i64 = 0

fn pure_fn_local_reset() with Mut {
    PURE_FN_LOCAL_N = 0
}

pub fn items_reset_pure_fn_reg() with Mut {
    PURE_FN_REG_N = 0
    PURE_FN_CALL_DEPTH = 0
    PURE_FN_ACTIVE_SLOT = 0 - 1
    pure_fn_local_reset()
}

// The extern-block pending queue (#1547) was REMOVED here, 2026-08-23, in the
// same change that deleted its last caller.
//
// It queued declarations 2..N of an `extern "C" { .. }` block on a
// module-global side channel for parse_program_loop to drain. The re-entrant
// parser in this file replaces it: one wrapper item per parse_item() call, so
// nothing is dropped and no aggregate crosses a module-global queue -- which
// is the defect that motivated the rewrite, since the gen seed corrupts large
// Item aggregates stored in module globals.
//
// Deleting the definition and not only the callers is deliberate. A `pub fn`
// with zero callers is an inert surface, and this repository landed a ratchet
// against exactly that on the same day: a thing that exists must mean
// something or be refused. Leaving a dead queue behind would have been the
// disease the rewrite was curing.

fn pure_fn_local_bind(name: Name, value: i64) with Mut, Div {
    if PURE_FN_LOCAL_N < 32 {
        PURE_FN_LOCAL_H[PURE_FN_LOCAL_N as usize] = ast_name_hash(name)
        PURE_FN_LOCAL_V[PURE_FN_LOCAL_N as usize] = value
        PURE_FN_LOCAL_N = PURE_FN_LOCAL_N + 1
    }
}

fn pure_fn_local_bind_hash(h: i64, value: i64) with Mut {
    if PURE_FN_LOCAL_N < 32 {
        PURE_FN_LOCAL_H[PURE_FN_LOCAL_N as usize] = h
        PURE_FN_LOCAL_V[PURE_FN_LOCAL_N as usize] = value
        PURE_FN_LOCAL_N = PURE_FN_LOCAL_N + 1
    }
}

fn pure_fn_local_lookup(name: Name) -> (bool, i64) with Div {
    let h = ast_name_hash(name)
    // Positional param values for the active pure call first (by registered
    // param name-hash). Prefer these over the local-env hash table so two
    // short params cannot shadow each other if their djb2 hashes collide or
    // the hash table store is lossy under the seed.
    if PURE_FN_ACTIVE_SLOT >= 0 {
        let slot = PURE_FN_ACTIVE_SLOT
        let pc = PURE_FN_REG_PC[slot as usize]
        if pc >= 1 && PURE_FN_REG_PH0[slot as usize] == h {
            return (true, PURE_FN_ARG_V0)
        }
        if pc >= 2 && PURE_FN_REG_PH1[slot as usize] == h {
            return (true, PURE_FN_ARG_V1)
        }
        if pc >= 3 && PURE_FN_REG_PH2[slot as usize] == h {
            return (true, PURE_FN_ARG_V2)
        }
        if pc >= 4 && PURE_FN_REG_PH3[slot as usize] == h {
            return (true, PURE_FN_ARG_V3)
        }
    }
    // Multi-stmt pure bodies: immutable `let` binders (most-recent wins).
    var i = PURE_FN_LOCAL_N
    while i > 0 {
        i = i - 1
        if PURE_FN_LOCAL_H[i as usize] == h {
            return (true, PURE_FN_LOCAL_V[i as usize])
        }
    }
    (false, 0)
}

// Fold a binary op over two already-bound pure-call arg words.
fn pure_fn_fold_binop(op: BinaryOp, a: i64, b: i64) -> (bool, i64) with Div {
    if op == BinaryOp::OpAdd {
        return (true, a + b)
    }
    if op == BinaryOp::OpSub {
        return (true, a - b)
    }
    if op == BinaryOp::OpMul {
        return (true, a * b)
    }
    if op == BinaryOp::OpDiv {
        if b == 0 {
            return (false, 0)
        }
        return (true, a / b)
    }
    if op == BinaryOp::OpRem {
        if b == 0 {
            return (false, 0)
        }
        return (true, a % b)
    }
    if op == BinaryOp::OpBitAnd {
        return (true, a & b)
    }
    if op == BinaryOp::OpBitOr {
        return (true, a | b)
    }
    if op == BinaryOp::OpBitXor {
        return (true, a ^ b)
    }
    (false, 0)
}

// Fast path: 2-param pure body is a single binary of two Idents → ARG_V0 op ARG_V1.
fn pure_fn_try_binary_ident_body(body_ptr: *mut StmtList) -> (bool, i64) with Div {
    match (*body_ptr).tail {
        Some(_) => {
            return (false, 0)
        }
        None => {}
    }
    if (*body_ptr).head.kind != StmtKind::StmtExpr {
        return (false, 0)
    }
    match (*body_ptr).head.expr {
        Some(ex) => {
            if (*ex).kind != ExprKind::ExprBinary {
                return (false, 0)
            }
            match (*ex).left {
                Some(lhs) => {
                    match (*ex).right {
                        Some(rhs) => {
                            if (*lhs).kind != ExprKind::ExprIdent {
                                return (false, 0)
                            }
                            if (*rhs).kind != ExprKind::ExprIdent {
                                return (false, 0)
                            }
                            pure_fn_fold_binop((*ex).bin_op, PURE_FN_ARG_V0, PURE_FN_ARG_V1)
                        }
                        None => {
                            (false, 0)
                        }
                    }
                }
                None => {
                    (false, 0)
                }
            }
        }
        None => {
            (false, 0)
        }
    }
}

fn pure_fn_reg_find(name: Name) -> (bool, i64) with Div {
    let h = ast_name_hash(name)
    var i: i64 = 0
    while i < PURE_FN_REG_N {
        if PURE_FN_REG_HASH[i as usize] == h {
            return (true, i)
        }
        i = i + 1
    }
    (false, 0)
}

// Classify pure body shape for registry. Returns (kind, op_as_i64).
// kind 1 = binary two Idents, kind 2 = bare Ident, kind 3 = general.
fn pure_fn_classify_body(body: &Block, nparams: i64) -> (i64, i64) with Div {
    match (*body).stmts {
        None => {
            return (0, 0)
        }
        Some(list) => {
            match (*list).tail {
                Some(_) => {
                    // multi-stmt
                    return (3, 0)
                }
                None => {
                    if (*list).head.kind != StmtKind::StmtExpr {
                        return (3, 0)
                    }
                    match (*list).head.expr {
                        Some(ex) => {
                            if (*ex).kind == ExprKind::ExprBinary && nparams == 2 {
                                match (*ex).left {
                                    Some(lhs) => {
                                        match (*ex).right {
                                            Some(rhs) => {
                                                if (*lhs).kind == ExprKind::ExprIdent && (*rhs).kind == ExprKind::ExprIdent {
                                                    return (1, (*ex).bin_op as i64)
                                                }
                                            }
                                            None => {}
                                        }
                                    }
                                    None => {}
                                }
                            }
                            if (*ex).kind == ExprKind::ExprIdent && nparams == 1 {
                                return (2, 0)
                            }
                            return (3, 0)
                        }
                        None => {
                            return (0, 0)
                        }
                    }
                }
            }
        }
    }
}

// Magic words stored as the first GLOBAL_VAR_INIT entry under a pure paramful
// function name. Zero-arg pure stores a single ordinary value (count==1);
// paramful stores a multi-word descriptor (count>=3) beginning with a magic.
// Uses the proven GLOBAL_VAR_INIT_* side-table (append works for many entries).
//   MAGIC_BINOP   = -900001 → words: magic, op, pc, ph0, ph1
//   MAGIC_IDENT   = -900002 → words: magic, pc, ph0
//   MAGIC_GENERAL = -900003 → words: magic, pc, body_bits, ph0..ph3
//     body_bits = StmtList* cast to i64 (seed-safe; not a REG slot index)

// Structural accept for KIND 3: zero-or-more immutable `let`, then a final
// StmtExpr (`x` / `return x` / binary / …). Rejects `var`/assign/control.
// Foldability of expressions is deferred to the call site (params bound).
fn pure_fn_is_pure_return_chain_shape(list: &StmtList) -> bool with Div {
    match (*list).tail {
        Some(rest) => {
            if (*list).head.kind != StmtKind::StmtLet {
                return false
            }
            match (*list).head.expr {
                Some(_) => {
                    pure_fn_is_pure_return_chain_shape(&(*rest))
                }
                None => {
                    false
                }
            }
        }
        None => {
            if (*list).head.kind != StmtKind::StmtExpr {
                return false
            }
            match (*list).head.expr {
                Some(_) => {
                    true
                }
                None => {
                    false
                }
            }
        }
    }
}

// Record pure paramful body into GLOBAL_VAR_INIT multi-word form. ≤4 params.
fn pure_fn_reg_record(
    name: Name,
    params: &Option<Box<ParamList>>,
    body: &Block
) with Mut, Div {
    // Already has any init words under this name — do not clobber.
    if ast_global_var_init_count(name) != 0 {
        return
    }
    var ph0: i64 = 0
    var ph1: i64 = 0
    var ph2: i64 = 0
    var ph3: i64 = 0
    var n: i64 = 0
    var cur = *params
    while true {
        match cur {
            Some(node) => {
                let hh = ast_name_hash((*node).head.name)
                if n == 0 {
                    ph0 = hh
                } else if n == 1 {
                    ph1 = hh
                } else if n == 2 {
                    ph2 = hh
                } else if n == 3 {
                    ph3 = hh
                }
                n = n + 1
                cur = (*node).tail
            }
            None => {
                break
            }
        }
    }
    if n < 1 || n > 4 {
        return
    }
    let cls = pure_fn_classify_body(body, n)
    if cls.0 == 0 {
        return
    }
    if cls.0 == 1 {
        // magic, op, pc, ph0, ph1
        ast_record_global_var_init(name, 0 - 900001)
        ast_record_global_var_init(name, cls.1)
        ast_record_global_var_init(name, n)
        ast_record_global_var_init(name, ph0)
        ast_record_global_var_init(name, ph1)
        return
    }
    if cls.0 == 2 {
        // magic, pc, ph0
        ast_record_global_var_init(name, 0 - 900002)
        ast_record_global_var_init(name, n)
        ast_record_global_var_init(name, ph0)
        return
    }
    // kind 3 (multi-stmt / general pure return chain) — Wave15a.
    // Store StmtList pointer bits as i64 inside GLOBAL_VAR_INIT multi-word.
    // Wave13e residual path wrote a fixed `[*mut StmtList; N]` table and
    // poisoned same-module kind-1/2; this design never touches that table.
    match (*body).stmts {
        Some(list) => {
            if !pure_fn_is_pure_return_chain_shape(&(*list)) {
                return
            }
            let body_ptr = list as *mut StmtList
            let body_bits = body_ptr as i64
            if body_bits == 0 {
                return
            }
            // magic, pc, body_bits, ph0, ph1, ph2, ph3
            ast_record_global_var_init(name, 0 - 900003)
            ast_record_global_var_init(name, n)
            ast_record_global_var_init(name, body_bits)
            ast_record_global_var_init(name, ph0)
            ast_record_global_var_init(name, ph1)
            ast_record_global_var_init(name, ph2)
            ast_record_global_var_init(name, ph3)
        }
        None => {}
    }
}

// Const-fold a global-init expression to one i64 word (int value or f64 bits).
// Returns (ok, word). Covers the Sounio negative idiom `0 - n` (no unary-minus
// in the style guide) so element-list packing does not silently drop slots and
// collapse into a wrong array-repeat fill of the remaining literal.
//
// Wave9: also folds `as T` casts of const words, and Ident referring to a
// previously recorded *scalar* global init (`var X: i64 = 7; [X, 20, 30]`).
// Wave10: zero-arg pure function calls fold when the callee was recorded as a
// pure const (`fn ten() -> i64 { 10 }; [ten(), 20, 30]` → real values, not
// BSS zeros).
// Wave12: pure multi-stmt return chains (`let x = 10; x`) fold via the
// pure-fn local env.
// Wave13e: pure paramful single-stmt calls with const args
//   (`fn add(a,b){a+b}; [add(10,20),1,2]`).
// Wave15a: pure paramful multi-stmt pure return chains
//   (`fn f(a){ let x = a + 1; x }; [f(9), 2]` → `10 2`).
// Non-foldable residual (effects, mutation, non-const, >4 params) still returns
// ok=false — element-list recording is fail-closed (all slots or none).
fn items_eval_global_init_word(e: &Expr) -> (bool, i64) with Mut, Div {
    if (*e).kind == ExprKind::ExprIntLit {
        return (true, (*e).int_val)
    }
    if (*e).kind == ExprKind::ExprFloatLit {
        return (true, f64_to_bits((*e).float_val))
    }
    if (*e).kind == ExprKind::ExprBoolTrue {
        return (true, 1)
    }
    if (*e).kind == ExprKind::ExprBoolFalse {
        return (true, 0)
    }
    // Cast of a const word keeps the init word (identity on BSS fill bits).
    // Unblocks `[1 as i64, 2 as i64]` which wave8 still dropped entirely.
    if (*e).kind == ExprKind::ExprCast {
        match (*e).left {
            Some(operand) => {
                let pair = items_eval_global_init_word(&(*operand))
                if pair.0 {
                    return (true, pair.1)
                }
            }
            _ => {}
        }
        return (false, 0)
    }
    // `return <const>` as a bare statement expression (function body form).
    if (*e).kind == ExprKind::ExprReturn {
        match (*e).left {
            Some(operand) => {
                return items_eval_global_init_word(&(*operand))
            }
            _ => {
                return (false, 0)
            }
        }
    }
    // Pure function call:
    //   - zero-arg: body pre-folded into GLOBAL_VAR_INIT (Wave10/12)
    //   - with const args: bind params from PURE_FN_REG and fold body (Wave13e)
    // Callee must be a simple Ident. Effects / non-const / arity mismatch → fail.
    if (*e).kind == ExprKind::ExprCall {
        match (*e).left {
            Some(callee) => {
                if (*callee).kind != ExprKind::ExprIdent {
                    return (false, 0)
                }
                match (*e).args {
                    None => {
                        // Zero-arg pure word under the function name.
                        let c = ast_global_var_init_count((*callee).name)
                        if c == 1 {
                            return (true, ast_global_var_init_nth((*callee).name, 0))
                        }
                        return (false, 0)
                    }
                    Some(_) => {
                        // Paramful pure: descriptor lives in GLOBAL_VAR_INIT multi-word.
                        let c = ast_global_var_init_count((*callee).name)
                        if c < 3 {
                            return (false, 0)
                        }
                        if PURE_FN_CALL_DEPTH >= 8 {
                            return (false, 0)
                        }
                        let magic = ast_global_var_init_nth((*callee).name, 0)
                        // Decode descriptor.
                        var kind: i64 = 0
                        var op_i: i64 = 0
                        var pc: i64 = 0
                        var ph0: i64 = 0
                        var ph1: i64 = 0
                        var ph2: i64 = 0
                        var ph3: i64 = 0
                        var body_bits: i64 = 0
                        if magic == 0 - 900001 {
                            // binop: magic, op, pc, ph0, ph1
                            if c < 5 {
                                return (false, 0)
                            }
                            kind = 1
                            op_i = ast_global_var_init_nth((*callee).name, 1)
                            pc = ast_global_var_init_nth((*callee).name, 2)
                            ph0 = ast_global_var_init_nth((*callee).name, 3)
                            ph1 = ast_global_var_init_nth((*callee).name, 4)
                        } else if magic == 0 - 900002 {
                            // ident: magic, pc, ph0
                            if c < 3 {
                                return (false, 0)
                            }
                            kind = 2
                            pc = ast_global_var_init_nth((*callee).name, 1)
                            ph0 = ast_global_var_init_nth((*callee).name, 2)
                        } else if magic == 0 - 900003 {
                            // general: magic, pc, body_bits, ph0..ph3
                            // body_bits = StmtList* as i64 (Wave15a; not a REG index)
                            if c < 7 {
                                return (false, 0)
                            }
                            kind = 3
                            pc = ast_global_var_init_nth((*callee).name, 1)
                            body_bits = ast_global_var_init_nth((*callee).name, 2)
                            ph0 = ast_global_var_init_nth((*callee).name, 3)
                            ph1 = ast_global_var_init_nth((*callee).name, 4)
                            ph2 = ast_global_var_init_nth((*callee).name, 5)
                            ph3 = ast_global_var_init_nth((*callee).name, 6)
                        } else {
                            return (false, 0)
                        }
                        // Save outer local env.
                        var saved_n = PURE_FN_LOCAL_N
                        var saved_h: [i64; 32] = [0; 32]
                        var saved_v: [i64; 32] = [0; 32]
                        var si: i64 = 0
                        while si < saved_n {
                            saved_h[si as usize] = PURE_FN_LOCAL_H[si as usize]
                            saved_v[si as usize] = PURE_FN_LOCAL_V[si as usize]
                            si = si + 1
                        }
                        pure_fn_local_reset()
                        PURE_FN_CALL_DEPTH = PURE_FN_CALL_DEPTH + 1
                        // Stash ph* into REG slot 0 temporarily for lookup (ACTIVE uses 0).
                        // For kind 1/2 we don't need REG; set PH scratch via ARG path only.
                        PURE_FN_ACTIVE_SLOT = 0
                        PURE_FN_REG_PC[0] = pc
                        PURE_FN_REG_PH0[0] = ph0
                        PURE_FN_REG_PH1[0] = ph1
                        PURE_FN_REG_PH2[0] = ph2
                        PURE_FN_REG_PH3[0] = ph3
                        PURE_FN_ARG_V0 = 0
                        PURE_FN_ARG_V1 = 0
                        PURE_FN_ARG_V2 = 0
                        PURE_FN_ARG_V3 = 0
                        var bound = true
                        var an: i64 = 0
                        var acur = (*e).args
                        while true {
                            match acur {
                                Some(anode) => {
                                    if an >= pc {
                                        bound = false
                                        break
                                    }
                                    let ap = items_eval_global_init_word(&(*anode).head)
                                    if !ap.0 {
                                        bound = false
                                        break
                                    }
                                    if an == 0 {
                                        PURE_FN_ARG_V0 = ap.1
                                        pure_fn_local_bind_hash(ph0, ap.1)
                                    } else if an == 1 {
                                        PURE_FN_ARG_V1 = ap.1
                                        pure_fn_local_bind_hash(ph1, ap.1)
                                    } else if an == 2 {
                                        PURE_FN_ARG_V2 = ap.1
                                        pure_fn_local_bind_hash(ph2, ap.1)
                                    } else {
                                        PURE_FN_ARG_V3 = ap.1
                                        pure_fn_local_bind_hash(ph3, ap.1)
                                    }
                                    an = an + 1
                                    acur = (*anode).tail
                                }
                                None => {
                                    break
                                }
                            }
                        }
                        if an != pc {
                            bound = false
                        }
                        var result_ok = false
                        var result_word: i64 = 0
                        if bound {
                            if kind == 1 {
                                let op = op_i as BinaryOp
                                let folded = pure_fn_fold_binop(op, PURE_FN_ARG_V0, PURE_FN_ARG_V1)
                                result_ok = folded.0
                                result_word = folded.1
                            } else if kind == 2 {
                                result_ok = true
                                result_word = PURE_FN_ARG_V0
                            } else if kind == 3 {
                                // Wave15a: body_bits is StmtList* stored as i64 in
                                // GLOBAL_VAR_INIT (seed-safe). Walk pure return chain:
                                // let-binders then final StmtExpr, with params bound.
                                let body_ptr = body_bits as *mut StmtList
                                if body_ptr != 0 as *mut StmtList {
                                    var bcur: *mut StmtList = body_ptr
                                    while bcur != 0 as *mut StmtList {
                                        var has_tail = false
                                        match (*bcur).tail {
                                            Some(_) => { has_tail = true }
                                            None => { has_tail = false }
                                        }
                                        if has_tail {
                                            if (*bcur).head.kind != StmtKind::StmtLet {
                                                result_ok = false
                                                break
                                            }
                                            match (*bcur).head.expr {
                                                Some(ex) => {
                                                    let bp = items_eval_global_init_word(&(*ex))
                                                    if !bp.0 {
                                                        result_ok = false
                                                        break
                                                    }
                                                    pure_fn_local_bind((*bcur).head.name, bp.1)
                                                }
                                                None => {
                                                    result_ok = false
                                                    break
                                                }
                                            }
                                            match (*bcur).tail {
                                                Some(next) => { bcur = next as *mut StmtList }
                                                None => { bcur = 0 as *mut StmtList }
                                            }
                                        } else {
                                            if (*bcur).head.kind != StmtKind::StmtExpr {
                                                result_ok = false
                                                break
                                            }
                                            match (*bcur).head.expr {
                                                Some(ex) => {
                                                    let bp = items_eval_global_init_word(&(*ex))
                                                    result_ok = bp.0
                                                    result_word = bp.1
                                                }
                                                None => { result_ok = false }
                                            }
                                            break
                                        }
                                    }
                                }
                            }
                        }
                        PURE_FN_CALL_DEPTH = PURE_FN_CALL_DEPTH - 1
                        PURE_FN_ACTIVE_SLOT = 0 - 1
                        pure_fn_local_reset()
                        var ri: i64 = 0
                        while ri < saved_n {
                            pure_fn_local_bind_hash(saved_h[ri as usize], saved_v[ri as usize])
                            ri = ri + 1
                        }
                        if result_ok {
                            return (true, result_word)
                        }
                        return (false, 0)
                    }
                }
            }
            _ => {
                return (false, 0)
            }
        }
    }
    // Scalar global already recorded earlier in the same compile unit.
    // Only count==1 (scalar / array-repeat fill word) is safe to re-use.
    // (Also pure zero-arg fns recorded by items_maybe_record_pure_fn_const.)
    // Wave12: pure-fn locals shadow globals during multi-stmt body fold.
    if (*e).kind == ExprKind::ExprIdent {
        let lp = pure_fn_local_lookup((*e).name)
        if lp.0 {
            return (true, lp.1)
        }
        let c = ast_global_var_init_count((*e).name)
        if c == 1 {
            return (true, ast_global_var_init_nth((*e).name, 0))
        }
        return (false, 0)
    }
    if (*e).kind == ExprKind::ExprUnary && (*e).un_op == UnaryOp::OpNeg {
        match (*e).left {
            Some(operand) => {
                let pair = items_eval_global_init_word(&(*operand))
                if pair.0 {
                    // Integers: arithmetic negate. Floats: re-negate via bits
                    // only when the operand was a float lit (bits path above).
                    if (*operand).kind == ExprKind::ExprFloatLit {
                        return (true, f64_to_bits(0.0 - (*operand).float_val))
                    }
                    return (true, 0 - pair.1)
                }
            }
            _ => {}
        }
        return (false, 0)
    }
    if (*e).kind == ExprKind::ExprBinary {
        match (*e).left {
            Some(lhs) => {
                match (*e).right {
                    Some(rhs) => {
                        let lp = items_eval_global_init_word(&(*lhs))
                        let rp = items_eval_global_init_word(&(*rhs))
                        if !lp.0 || !rp.0 {
                            return (false, 0)
                        }
                        // Float binary: both sides float lits → fold bits.
                        if (*lhs).kind == ExprKind::ExprFloatLit && (*rhs).kind == ExprKind::ExprFloatLit {
                            let a = (*lhs).float_val
                            let b = (*rhs).float_val
                            if (*e).bin_op == BinaryOp::OpAdd {
                                return (true, f64_to_bits(a + b))
                            }
                            if (*e).bin_op == BinaryOp::OpSub {
                                return (true, f64_to_bits(a - b))
                            }
                            if (*e).bin_op == BinaryOp::OpMul {
                                return (true, f64_to_bits(a * b))
                            }
                            if (*e).bin_op == BinaryOp::OpDiv {
                                return (true, f64_to_bits(a / b))
                            }
                            return (false, 0)
                        }
                        // Integer / mixed-folded int words.
                        let a = lp.1
                        let b = rp.1
                        if (*e).bin_op == BinaryOp::OpAdd {
                            return (true, a + b)
                        }
                        if (*e).bin_op == BinaryOp::OpSub {
                            return (true, a - b)
                        }
                        if (*e).bin_op == BinaryOp::OpMul {
                            return (true, a * b)
                        }
                        if (*e).bin_op == BinaryOp::OpDiv {
                            if b == 0 {
                                return (false, 0)
                            }
                            return (true, a / b)
                        }
                        if (*e).bin_op == BinaryOp::OpRem {
                            if b == 0 {
                                return (false, 0)
                            }
                            return (true, a % b)
                        }
                        if (*e).bin_op == BinaryOp::OpBitAnd {
                            return (true, a & b)
                        }
                        if (*e).bin_op == BinaryOp::OpBitOr {
                            return (true, a | b)
                        }
                        if (*e).bin_op == BinaryOp::OpBitXor {
                            return (true, a ^ b)
                        }
                        // Shifts were missing: `let E: i64 = 1 << 3` folded to (false, 0) and the
                        // global read as BSS zero. Out-of-range counts stay unfoldable (fail-closed).
                        if (*e).bin_op == BinaryOp::OpShl {
                            if b < 0 || b > 63 {
                                return (false, 0)
                            }
                            return (true, a << b)
                        }
                        if (*e).bin_op == BinaryOp::OpShr {
                            if b < 0 || b > 63 {
                                return (false, 0)
                            }
                            return (true, a >> b)
                        }
                        return (false, 0)
                    }
                    None => { return (false, 0) }
                }
            }
            None => { return (false, 0) }
        }
    }
    (false, 0)
}

// Const-eval a pure function body as a return-only chain:
//   zero or more `let name = <const-expr>` binders, then a final `StmtExpr`
//   (`<const-expr>` or `return <const-expr>`).
// Locals bind into PURE_FN_LOCAL_*; caller resets the table.
// Rejects mut (`var`/`=`), control flow, and non-foldable exprs → ok=false.
fn items_eval_pure_stmt_list(list: &StmtList) -> (bool, i64) with Mut, Div {
    match (*list).tail {
        Some(rest) => {
            // Non-final: must be immutable `let` with a foldable initializer.
            if (*list).head.kind != StmtKind::StmtLet {
                return (false, 0)
            }
            match (*list).head.expr {
                Some(e) => {
                    let pair = items_eval_global_init_word(&(*e))
                    if !pair.0 {
                        return (false, 0)
                    }
                    pure_fn_local_bind((*list).head.name, pair.1)
                    items_eval_pure_stmt_list(&(*rest))
                }
                None => {
                    (false, 0)
                }
            }
        }
        None => {
            // Final statement: expression (incl. bare `return <const>`).
            if (*list).head.kind != StmtKind::StmtExpr {
                return (false, 0)
            }
            match (*list).head.expr {
                Some(e) => {
                    items_eval_global_init_word(&(*e))
                }
                None => {
                    (false, 0)
                }
            }
        }
    }
}

// If `fn name(...) -> T { ... }` is effect-free and its body is a pure const
// return chain, register it for global element-list call fold:
//
//   zero-param (Wave10/12): fold body now → GLOBAL_VAR_INIT word under `name`
//     so later `[ten(), 20, 30]` / `[multi(), 20, 30]` read real values.
//   paramful ≤4 (Wave13e): register body+param hashes so later
//     `[add2(10, 20), 1, 2]` binds const args and folds the body at the call site.
//
// Accepted bodies:
//   { 10 }
//   { return 10 }
//   { let x = 10; x }
//   { let x = 10; let y = x + 1; y }
//   { a + b }          // params as Idents
//   { let x = a + 1; x }
// Intermediate statements must be immutable `let`. Mutation / effects /
// non-const / >4 params remain residual fail-closed zeros (no left-shift).
fn items_maybe_record_pure_fn_const(
    name: Name,
    params: &Option<Box<ParamList>>,
    effects: &Option<Box<EffectList>>,
    body: &Block
) with Mut, Div {
    match *effects {
        Some(_) => {
            return
        }
        None => {}
    }
    // Already has init words (prior global of same name) — do not overwrite/extend.
    if ast_global_var_init_count(name) != 0 {
        return
    }
    match *params {
        Some(_) => {
            // Wave13e: pure paramful → body registry (call-site fold).
            pure_fn_reg_record(name, params, body)
            return
        }
        None => {}
    }
    // Zero-param: fold now into GLOBAL_VAR_INIT (Wave10/12).
    match (*body).stmts {
        Some(list) => {
            pure_fn_local_reset()
            let pair = items_eval_pure_stmt_list(&(*list))
            pure_fn_local_reset()
            if pair.0 {
                ast_record_global_var_init(name, pair.1)
            }
        }
        None => {}
    }
}

// Record a compile-time integer/float/bool global initializer for native BSS fill.
// Covers:
//   - scalar `42` / `-42` / `0 - n` / `1.5` / unary-neg floats / true|false
//   - array-repeat `[V; N]`  → one fill word (i64 value or f64 bits)
//   - element-list `[a, b, c]` → one word per element, same name hash, source order
//   - cast/ident of the above (wave9)
//   - zero-arg pure calls of the above (wave10), when callee body was recorded
//   - multi-stmt pure return chains (wave12): `let x = c; x` / nested pure lets
//   - pure paramful calls with const args (wave13e): `add2(10, 20)` etc.
//   - pure paramful multi-stmt return chains (wave15a): `f(9)` with `{ let x = a+1; x }`
//   - string literal scalars (wave15e): `let S: string = "hi"` → GLOBAL_STR_INIT_*
// Element-list is fail-closed: every slot must const-fold or *none* are recorded.
// (Wave8 partial skip shifted remaining words left — `[f(),20,30]` → `20 30 0`.)
// Residual: effects / mutation / non-const / >4-param / recursion → BSS zero, no silent shift.
fn items_record_global_int_init(name: Name, init: &Expr) with Mut, Div {
    // Wave15e: module-level string literal init cannot be an i64 BSS fill word —
    // the pointer lives in rodata and must be LEA'd at entry. Side-table only.
    if (*init).kind == ExprKind::ExprStringLit {
        ast_record_global_str_init(name, (*init).name)
        return
    }
    if (*init).kind == ExprKind::ExprArrayLit {
        // Repeat form: left = fill value, right = count → single fill word
        match (*init).left {
            Some(repeat_val) => {
                items_record_global_int_init(name, &(*repeat_val))
            }
            None => {
                // Element-list form: [a, b, c] — evaluate all slots first.
                // (args is already reversed into source order by parse_array_literal).
                var cur = (*init).args
                var words: [i64; 128] = [0; 128]
                var n: i64 = 0
                var all_ok = true
                while true {
                    match cur {
                        Some(node) => {
                            let pair = items_eval_global_init_word(&(*node).head)
                            if !pair.0 {
                                all_ok = false
                                break
                            }
                            if n < 128 {
                                words[n as usize] = pair.1
                                n = n + 1
                            } else {
                                all_ok = false
                                break
                            }
                            cur = (*node).tail
                        }
                        None => { break }
                    }
                }
                if all_ok {
                    var i: i64 = 0
                    while i < n {
                        ast_record_global_var_init(name, words[i as usize])
                        i = i + 1
                    }
                }
            }
        }
        return
    }
    let pair = items_eval_global_init_word(init)
    if pair.0 {
        ast_record_global_var_init(name, pair.1)
    }
}

fn items_reverse_item_list_loop(
    current: Option<Box<ItemList>>,
    acc: Option<Box<ItemList>>,
) -> Option<Box<ItemList>> with Mut, Alloc {
    match current {
        None => acc,
        Some(node) => {
            let next = (*node).tail
            let rev_node = ItemList { head: (*node).head, tail: acc }
            items_reverse_item_list_loop(next, Some(Box::new(rev_node)))
        },
    }
}

// ── Track A: some extern "C" declarations become wrapper fns ───────
// MADAROS_EXTERN_C_BUILTIN_PORT_DISPATCH_2026-08-16: the bodyless FnDef
// this parser used to emit for an `extern "C"` declaration lowers (under
// Madaros) as a real function whose body returns 0, shadowing the by-name
// builtin resolution — proven with extern-declared str_len/sqrt returning
// 0 while the undeclared calls resolve and work. lean_single solves the
// same problem with strip_extern_blocks() stub-rewriting; the Madaros
// equivalent lives here: the declaration becomes an ordinary Sounio fn
// (declared signature preserved for callers) whose body forwards to a
// ffi_<name> intrinsic, resolved by the checker's runtime builtin table
// and emitted by the native builtin registry.
//
// The rewrite applies ONLY to the names that have such an intrinsic —
// extern_name_has_ffi_intrinsic below. An earlier draft rewrote every
// declaration, which silently moved the refusal of an unimplemented extern
// from the call to the DECLARATION: the wrapper body called an unbound
// ffi_<name> and tripped E137 before E250 was ever consulted, so declaring
// a binding without calling it stopped compiling. That property is what a
// bindings module depends on and it now has a fixture,
// tests/run-pass/ffi_declared_never_called_is_legal.sio.

// Brace-form extern "C" blocks yield ONE item per parse_item() call:
// parse_extern_fn_item consumes only the first declaration and leaves the
// parser positioned inside the block with EXTERN_BLOCK_ACTIVE set; the item
// loops' next parse_item() call re-enters via parse_extern_block_decl until
// the closing brace. Every item therefore flows through the ordinary
// parse_item return path, and no aggregate is ever stored in a global.
// (Earlier Track A drafts queued built Items — or their small components —
// through a module-global list and rebuilt them at drain time; every variant
// of that heap round-trip corrupted the stored aggregate under the gen seed:
// name.len read back as 0x0100000000000000, E017 on the wrapper body, or a
// native-checker segfault. Only scalar flags survive in globals here.)
var EXTERN_BLOCK_ACTIVE: i64 = 0
var EXTERN_BLOCK_VIS_KIND: i64 = 0

fn ffi_name_path(name: Name, span: Span) -> Expr with Mut, Panic {
    // ExprIdent, NOT ExprPath: only ident-shaped callees go through the
    // checker's normal name resolution, so only they E137 on unknown names.
    // A path-shaped callee silently escaped checking, and an unimplemented
    // ffi_<name> intrinsic compiled to a no-op call returning 0 — the exact
    // fail-open behavior this dispatch exists to close (Fase 3.4).
    var n = empty_name()
    n.buf[0] = 102 as i8   // 'f'
    n.buf[1] = 102 as i8   // 'f'
    n.buf[2] = 105 as i8   // 'i'
    n.buf[3] = 95 as i8    // '_'
    var bi: i64 = 0
    while bi < name.len && bi < 123 {
        n.buf[(4 + bi) as usize] = name.buf[bi as usize]
        bi = bi + 1
    }
    n.len = 4 + bi
    var e = mk_expr(ExprKind::ExprIdent, span)
    e.name = n
    e
}

fn param_name_path(pl: ParamList, span: Span) -> Expr with Mut, Panic {
    // Ident-shaped for the same reason as ffi_name_path: parameter
    // references must resolve through the ordinary local-variable path.
    var n = empty_name()
    var bi: i64 = 0
    while bi < pl.head.name.len && bi < 128 {
        n.buf[bi as usize] = pl.head.name.buf[bi as usize]
        bi = bi + 1
    }
    n.len = pl.head.name.len
    var e = mk_expr(ExprKind::ExprIdent, span)
    e.name = n
    e
}

fn extern_forward_args_list(pl: ParamList, span: Span) -> ExprList with Panic, Alloc, Mut {
    ExprList {
        label: empty_name(),
        head: param_name_path(pl, span),
        tail: match pl.tail {
            None => None
            Some(rest) => Some(Box::new(extern_forward_args_list(*rest, span)))
        }
    }
}

// The `extern "C"` names for which an ffi_<name> forwarding target actually
// exists. Three lists have to agree and scripts/ci/extern_builtin_mirror_gate.sh
// diffs them: this one, the ffi_* arms of native_v2_builtin_id_for_func_ref
// (self-hosted/native/codegen_x86_linux.sio, ids 39..50), and the
// checker_bind_import_unknown_inplace("ffi_*") block in
// check/check.sio::checker_collect_runtime_builtins_inplace.
//
// A name that is NOT here keeps the bodyless declaration, which is what main
// emits for every extern, and main's pipeline handles it: ir/lower.sio flushes
// it as an instr_count == 0 stub, native_v2_builtin_id_for_func_ref maps it to
// a plain builtin id where one exists (exp, log, sin, cos, str_len, read_i64,
// ...), codegen traps it via nc_emit_unimplemented_extern_trap_into where none
// does (guarded by native_v2_empty_stub_would_fabricate), and E250 refuses the
// CALL. Forwarding such a name to a ffi_<name> that does not exist is what
// broke declaration-without-call: the wrapper body tripped E137 on the unbound
// intrinsic at the DECLARATION, before any call-site rule was reached.
fn extern_name_has_ffi_intrinsic(n: Name) -> bool with Mut, Panic, Div {
    if name_eq(n, make_name("getpid")) { return true }   // ffi_getpid,  id 39
    if name_eq(n, make_name("getppid")) { return true }  // ffi_getppid, id 40
    if name_eq(n, make_name("exit")) { return true }     // ffi_exit,    id 41
    if name_eq(n, make_name("abort")) { return true }    // ffi_abort,   id 42
    if name_eq(n, make_name("malloc")) { return true }   // ffi_malloc,  id 43
    if name_eq(n, make_name("free")) { return true }     // ffi_free,    id 44
    if name_eq(n, make_name("system")) { return true }   // ffi_system,  id 45
    if name_eq(n, make_name("sqrt")) { return true }     // ffi_sqrt,    id 46
    if name_eq(n, make_name("floor")) { return true }    // ffi_floor,   id 47
    if name_eq(n, make_name("ceil")) { return true }     // ffi_ceil,    id 48
    if name_eq(n, make_name("pow")) { return true }      // ffi_pow,     id 49
    if name_eq(n, make_name("tgamma")) { return true }   // ffi_tgamma,  id 50
    false
}

// The bodyless FnDef an `extern "C"` declaration has always produced on main.
// Kept for every name the forwarding rewrite cannot serve.
fn extern_decl_fn_def(name: Name, params_opt: Option<Box<ParamList>>, ret_ty: Option<Box<TypeExpr>>, span: Span) -> FnDef with Mut, Panic, Alloc {
    FnDef { name: name, params: params_opt, return_type: ret_ty, effects: None, body: Block { stmts: None, span: span }, span: span, is_kernel: false, is_extern: true }
}

fn extern_wrapper_fn_def(name: Name, params_opt: Option<Box<ParamList>>, ret_ty: Option<Box<TypeExpr>>, span: Span) -> FnDef with Mut, Panic, Alloc {
    var call = mk_expr(ExprKind::ExprCall, span)
    call.left = Some(Box::new(ffi_name_path(name, span)))
    // Rebind the params list instead of reusing params_opt after the match
    // consumed it — the old use-after-move was latent only because the
    // getpid/getppid wrappers have no parameters.
    var params_kept: Option<Box<ParamList>> = None
    match params_opt {
        None => {}
        Some(first) => {
            call.args = Some(Box::new(extern_forward_args_list(*first, span)))
            params_kept = Some(first)
        }
    }
    let stmt = Stmt { kind: StmtKind::StmtExpr, span: span, name: empty_name(), ty: None, expr: Some(Box::new(call)), target: None, assign_op: AssignOp::AssignEq }
    FnDef { name: name, params: params_kept, return_type: ret_ty, effects: None, body: Block { stmts: Some(Box::new(StmtList { head: stmt, tail: None })), span: span }, span: span, is_kernel: false,
        // is_extern is FALSE deliberately: main added this field via #1547 after
        // the branch forked, and the wrapper is an ordinary Sounio fn forwarding
        // to ffi_<name>, not a bodyless extern declaration. Marking it true would
        // restore the very stub this change exists to stop emitting.
        is_extern: false }
}

// The single decision point: forward to ffi_<name> when that intrinsic exists,
// otherwise leave the declaration a declaration.
fn extern_decl_or_wrapper_fn_def(name: Name, params_opt: Option<Box<ParamList>>, ret_ty: Option<Box<TypeExpr>>, span: Span) -> FnDef with Mut, Panic, Div, Alloc {
    if extern_name_has_ffi_intrinsic(name) {
        return extern_wrapper_fn_def(name, params_opt, ret_ty, span)
    }
    extern_decl_fn_def(name, params_opt, ret_ty, span)
}

// No caller today (the re-entrant block path builds its own Item literal), kept
// so a second construction site cannot diverge from the decision above.
fn extern_wrapper_item(visibility: Visibility, name: Name, params_opt: Option<Box<ParamList>>, ret_ty: Option<Box<TypeExpr>>, span: Span) -> Item with Panic, Alloc, Mut, Div {
    let fn_def = extern_decl_or_wrapper_fn_def(name, params_opt, ret_ty, span)
    Item { kind: ItemKind::ItemFn, span: span, visibility: visibility, name: name, fn_def: Some(Box::new(fn_def)), struct_def: None, enum_def: None, impl_def: None, type_alias_ty: None, policy_def: None, acquisition_policy_def: None, recourse_policy_def: None, decision_policy_def: None, deferral_policy_def: None, transition_policy_def: None, transition_protocol_def: None, monitoring_policy_def: None, alternative_policy_def: None, alternative_frontier_def: None, models_def: None, validation_def: None, audit_def: None, use_path: empty_path(), use_glob: false, use_items: None, effect_def: None, session_decl: None, trait_def: None, algebra_def: None, study_def: None, ontology_def: None }
}

// Called at the top of each item-collection loop in parser::mod so an
// unterminated extern block in one file can never leak into the next parse.
pub fn parser_reset_extern_block_state() with Mut {
    EXTERN_BLOCK_ACTIVE = 0
    EXTERN_BLOCK_VIS_KIND = 0
}


impl Parser {
    // ============================================================
    // Parse a single item
    // ============================================================

    fn parse_item(self) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        // Re-entry: mid-extern-block, every call yields the next declaration's
        // ffi wrapper (or closes the block). See EXTERN_BLOCK_ACTIVE above.
        if EXTERN_BLOCK_ACTIVE == 1 {
            return self.parse_extern_block_decl(Visibility { kind: EXTERN_BLOCK_VIS_KIND, path: empty_path() })
        }
        let k = self.peek()

        // Handle optional 'pub' visibility
        var visibility = visibility_private()
        var p = self
        if k == TokenKind::Pub {
            let vis_pair = p.parse_pub_visibility()
            p = vis_pair.0
            visibility = vis_pair.1
        }

        // `causal graph <name> { ... }` -- contextual, so it is matched by
        // bytes rather than by keyword, and only when BOTH words are present.
        // A variable or function named `causal` keeps working.
        if parser_peek(p) == TokenKind::Ident {
            let cg_w1 = p.current_name()
            if cg_w1.len == 6
                && cg_w1.buf[0] == (99 as i8)
                && cg_w1.buf[1] == (97 as i8)
                && cg_w1.buf[2] == (117 as i8)
                && cg_w1.buf[3] == (115 as i8)
                && cg_w1.buf[4] == (97 as i8)
                && cg_w1.buf[5] == (108 as i8)
                && parser_peek_ahead(p, 1) == TokenKind::Ident {
                let cg_w2 = parser_name_at(p, p.pos + 1)
                if cg_w2.len == 5
                    && cg_w2.buf[0] == (103 as i8)
                    && cg_w2.buf[1] == (114 as i8)
                    && cg_w2.buf[2] == (97 as i8)
                    && cg_w2.buf[3] == (112 as i8)
                    && cg_w2.buf[4] == (104 as i8) {
                    return parse_causal_graph_item(p, visibility)
                }
            }
        }

        // Handle optional 'linear' or 'affine' modifier
        var is_linear = false
        var is_affine = false
        if parser_peek(p) == TokenKind::Linear {
            is_linear = true
            p = p.advance()
        } else if parser_peek(p) == TokenKind::Affine {
            is_affine = true
            p = p.advance()
        }
        if parser_peek(p) == TokenKind::Ident {
            let mod_name = p.current_name()
            if mod_name.len == 8
                && mod_name.buf[0] == (114 as i8)
                && mod_name.buf[1] == (101 as i8)
                && mod_name.buf[2] == (108 as i8)
                && mod_name.buf[3] == (101 as i8)
                && mod_name.buf[4] == (118 as i8)
                && mod_name.buf[5] == (97 as i8)
                && mod_name.buf[6] == (110 as i8)
                && mod_name.buf[7] == (116 as i8)
                && parser_peek_ahead(p, 1) == TokenKind::Struct {
                p = p.advance()
            }
        }

        // Handle optional 'kernel' modifier for GPU kernel functions
        var is_kernel = false
        if parser_peek(p) == TokenKind::Kernel {
            is_kernel = true
            p = p.advance()
        }

        if parser_peek(p) == TokenKind::Const && parser_peek_ahead(p, 1) == TokenKind::Fn {
            p = p.advance()
        }
        if parser_peek(p) == TokenKind::Async && parser_peek_ahead(p, 1) == TokenKind::Fn {
            p = p.advance()
        }

        let item_kind = parser_peek(p)

        // Detect "module NAME" declarations when module is treated as an identifier
        // (the boot4-safe lexer returns Ident for "module" to avoid keyword conflicts).
        var is_module_decl = false
        if item_kind == TokenKind::Ident {
            let probe_name = p.current_name()
            if probe_name.len == 6
                && probe_name.buf[0] == (109 as i8)
                && probe_name.buf[1] == (111 as i8)
                && probe_name.buf[2] == (100 as i8)
                && probe_name.buf[3] == (117 as i8)
                && probe_name.buf[4] == (108 as i8)
                && probe_name.buf[5] == (101 as i8) {
                let next_kind = parser_peek_ahead(p, 1)
                if next_kind == TokenKind::ColonColon || next_kind == TokenKind::Ident || next_kind == TokenKind::Ontology {
                    is_module_decl = true
                }
            }
        }

        // Detect "claim NAME {" declarations when claim is treated as an
        // identifier (the boot4-safe lexer returns Ident for "claim", same as
        // "module"). Requires both the name and the opening brace so ordinary
        // uses of `claim` as an identifier fall through to error recovery.
        var is_claim_decl = false
        if item_kind == TokenKind::Ident {
            let claim_probe = p.current_name()
            if claim_probe.len == 5
                && claim_probe.buf[0] == (99 as i8)
                && claim_probe.buf[1] == (108 as i8)
                && claim_probe.buf[2] == (97 as i8)
                && claim_probe.buf[3] == (105 as i8)
                && claim_probe.buf[4] == (109 as i8) {
                if parser_peek_ahead(p, 1) == TokenKind::Ident
                    && parser_peek_ahead(p, 2) == TokenKind::LBrace {
                    is_claim_decl = true
                }
            }
        }

        if is_module_decl {
            p.parse_module_item(visibility)
        } else if is_claim_decl {
            parse_claim_item(p, visibility)
        } else if item_kind == TokenKind::Fn {
            p.parse_fn_item(visibility, is_kernel)
        } else if item_kind == TokenKind::Struct {
            p.parse_struct_item(is_linear, is_affine, visibility)
        } else if item_kind == TokenKind::Enum {
            p.parse_enum_item(visibility)
        } else if item_kind == TokenKind::Impl {
            p.parse_impl_item(visibility)
        } else if item_kind == TokenKind::Type {
            p.parse_type_alias_item(visibility)
        } else if item_kind == TokenKind::Const {
            p.parse_global_let_item(visibility)
        } else if item_kind == TokenKind::ModelsLower {
            p.parse_models_item(visibility)
        } else if item_kind == TokenKind::PolicyLower {
            p.parse_policy_item(visibility)
        } else if item_kind == TokenKind::AcquisitionPolicyLower {
            p.parse_acquisition_policy_item(visibility)
        } else if item_kind == TokenKind::RecoursePolicyLower {
            p.parse_recourse_policy_item(visibility)
        } else if item_kind == TokenKind::MonitoringPolicyLower {
            p.parse_monitoring_policy_item(visibility)
        } else if item_kind == TokenKind::TransitionPolicyLower {
            p.parse_transition_policy_item(visibility)
        } else if item_kind == TokenKind::TransitionProtocolLower {
            p.parse_transition_protocol_item(visibility)
        } else if item_kind == TokenKind::AlternativePolicyLower {
            p.parse_alternative_policy_item(visibility)
        } else if item_kind == TokenKind::AlternativeFrontierLower {
            p.parse_alternative_frontier_item(visibility)
        } else if item_kind == TokenKind::DecisionPolicyLower {
            p.parse_decision_policy_item(visibility)
        } else if item_kind == TokenKind::DeferralPolicyLower {
            p.parse_deferral_policy_item(visibility)
        } else if item_kind == TokenKind::ValidationLower {
            p.parse_validation_item(visibility)
        } else if item_kind == TokenKind::AuditLower {
            p.parse_audit_item(visibility)
        } else if item_kind == TokenKind::Use {
            p.parse_use_item(visibility)
        } else if item_kind == TokenKind::Import {
            p.parse_use_item(visibility)
        } else if item_kind == TokenKind::Module {
            p.parse_module_item(visibility)
        } else if item_kind == TokenKind::Let {
            p.parse_global_let_item(visibility)
        } else if item_kind == TokenKind::Var {
            p.parse_global_var_item(visibility)
        } else if item_kind == TokenKind::Unit {
            p.parse_unit_item(visibility)
        } else if item_kind == TokenKind::Effect {
            p.parse_effect_item(visibility)
        } else if item_kind == TokenKind::Session {
            p.parse_session_item(visibility)
        } else if item_kind == TokenKind::Trait {
            p.parse_trait_item(visibility)
        } else if item_kind == TokenKind::Algebra {
            parse_algebra_item(p, visibility)
        } else if item_kind == TokenKind::Study {
            parse_study_item(p, visibility)
        } else if item_kind == TokenKind::Ontology {
            parse_ontology_item(p, visibility)
        } else if item_kind == TokenKind::Extern {
            p.parse_extern_fn_item(visibility)
        } else if item_kind == TokenKind::Export {
            p.parse_export_fn_item(visibility)
        } else {
            // Error recovery: skip token
            let span = p.current_span()
            p.had_error = true
            p.error_count = p.error_count + 1
            let pa = p.advance()
            let en = empty_name()
            let ep2 = empty_path()
            let result_item = Item {
                kind: ItemKind::ItemFn,
                span: span,
                visibility: visibility,
                name: en,
                fn_def: None,
                struct_def: None,
                enum_def: None,
                impl_def: None,
                type_alias_ty: None,
                policy_def: None,
                acquisition_policy_def: None,
                recourse_policy_def: None,
                decision_policy_def: None,
                deferral_policy_def: None,
                transition_policy_def: None,
                transition_protocol_def: None,
                monitoring_policy_def: None,
                alternative_policy_def: None,
                alternative_frontier_def: None,
                models_def: None,
                validation_def: None,
                audit_def: None,
                use_path: ep2,
                use_glob: false,
                use_items: None,
                effect_def: None,
                session_decl: None,
                trait_def: None,
                algebra_def: None,
                study_def: None,
                ontology_def: None,
            }
            (pa, result_item)
        }
    }

    // ============================================================
    // Visibility modifier: pub, pub(crate), pub(super), pub(path)
    // ============================================================

    fn parse_pub_visibility(self) -> (Parser, Visibility) with Mut, IO, Panic, Div, Alloc {
        var p = self.advance()  // skip 'pub'
        if parser_peek(p) == TokenKind::LParen {
            p = p.advance()  // skip '('
            let k = parser_peek(p)
            if k == TokenKind::Crate {
                p = p.advance()  // skip 'crate'
                p = p.expect(TokenKind::RParen)
                (p, visibility_pub_crate())
            } else if k == TokenKind::Super {
                p = p.advance()  // skip 'super'
                p = p.expect(TokenKind::RParen)
                (p, visibility_pub_super())
            } else {
                // pub(path::to)
                let path_pair = p.parse_type_path()
                p = path_pair.0
                let path = path_pair.1
                p = p.expect(TokenKind::RParen)
                (p, visibility_pub_in(path))
            }
        } else {
            (p, visibility_pub())
        }
    }

    // ============================================================
    // Module declaration: module foo::bar
    // ============================================================

    fn parse_module_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'module'

        // Consume the module path (Ident (:: Ident)*) directly. The boot4-safe lexer
        // (lex_source_to_globals) does NOT emit Newline tokens, so the previous
        // "consume until Newline" loop ran to EOF and swallowed the entire file as a
        // single item — leaving every subsequent fn/struct unparsed in multi-module
        // compilation (the imported typecheck then saw 0 functions for these modules).
        // Consumed STRUCTURALLY -- one segment, then (:: segment)* -- rather than
        // by a flat "keep taking tokens of these kinds" loop. A segment may be a
        // keyword: `module resolve::scope` and `module interop::kernel` are real
        // declarations in this tree, and the flat loop rejected them, stopping
        // after `resolve::` so the item dispatch met `scope` where an item should
        // start (items.sio:1115). The old loop had already been patched once with
        // TokenKind::Ontology for exactly this reason, one word at a time.
        //
        // Blanket-accepting keywords in the FLAT loop would have been wrong: the
        // token after the last segment is usually `struct` or `fn`, themselves
        // keywords, and the loop would swallow the rest of the file -- the very
        // failure the comment above records. Structure stops it: after the last
        // segment the next token is not `::`, so the loop ends.
        if parser_peek(p) == TokenKind::Ident || tk_is_keyword(parser_peek(p)) {
            p = p.advance_raw()
            while parser_peek(p) == TokenKind::ColonColon {
                p = p.advance_raw()
                if parser_peek(p) == TokenKind::Ident || tk_is_keyword(parser_peek(p)) {
                    p = p.advance_raw()
                }
            }
        }
        if parser_peek(p) == TokenKind::Newline {
            p = p.advance_raw()
        }

        let span = p.span_from(start)
        (p, Item {
            kind: ItemKind::ItemUnit,
            span: span,
            visibility: visibility,
            name: empty_name(),
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    // ============================================================
    // Global bindings (top-level): let/const NAME [: Type] = expr; var NAME [: Type] [= expr]
    // ============================================================

    fn parse_global_let_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'let'

        let name = p.current_name()
        p = p.expect_ident()

        // Optional type annotation
        let ty_pair = p.parse_optional_type()
        p = ty_pair.0
        let global_ty: Option<Box<TypeExpr>> = ty_pair.1

        p = p.expect(TokenKind::Eq)
        p = p.parse_expr()
        let init_let_box = parser_take_expr_box()
        items_record_global_int_init(name, &(*init_let_box))
        if parser_peek(p) == TokenKind::Semi {
            p = p.advance()
        }

        let span = p.span_from(start)
        (p, Item {
            kind: ItemKind::ItemFn,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: global_ty,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    fn parse_global_var_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'var'

        let name = p.current_name()
        p = p.expect_ident()

        // Optional type annotation
        let ty_pair = p.parse_optional_type()
        p = ty_pair.0
        let global_ty: Option<Box<TypeExpr>> = ty_pair.1

        if parser_peek(p) == TokenKind::Eq {
            p = p.advance()
            p = p.parse_expr()
            let init_var_box = parser_take_expr_box()
            items_record_global_int_init(name, &(*init_var_box))
        }
        if parser_peek(p) == TokenKind::Semi {
            p = p.advance()
        }

        let span = p.span_from(start)
        (p, Item {
            kind: ItemKind::ItemFn,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: global_ty,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    // ============================================================
    // Function: fn name(params) -> RetType with Effects { body }
    // ============================================================

    fn parse_fn_item(self, visibility: Visibility, is_kernel: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let pfi_k = self.peek()
        if pfi_k != TokenKind::Fn {
            // Recovery: consume one token so callers never stall.
            let span = self.current_span()
            var p_bad = self
            p_bad.had_error = true
            p_bad.error_count = p_bad.error_count + 1
            p_bad = p_bad.advance()
            return (p_bad, Item {
                kind: ItemKind::ItemFn,
                span: span,
                visibility: visibility,
                name: empty_name(),
                fn_def: None,
                struct_def: None,
                enum_def: None,
                impl_def: None,
                type_alias_ty: None,
                policy_def: None,
                acquisition_policy_def: None,
                recourse_policy_def: None,
                decision_policy_def: None,
                deferral_policy_def: None,
                transition_policy_def: None,
                transition_protocol_def: None,
                monitoring_policy_def: None,
                alternative_policy_def: None,
                alternative_frontier_def: None,
                models_def: None,
                validation_def: None,
                audit_def: None,
                use_path: empty_path(),
                use_glob: false,
                use_items: None,
                effect_def: None,
                session_decl: None,
                algebra_def: None,
                study_def: None,
                ontology_def: None,
                trait_def: None,
            })
        }

        let start = self.current_span()
        var p = self.advance()  // skip 'fn'
        let name = p.current_name()
        p = p.expect_ident()
        if parser_peek(p) == TokenKind::Lt {
            p = p.parse_type_param_header()
        }
        // Parameters
        p = p.expect(TokenKind::LParen)
        let pair = p.parse_param_list()
        p = pair.0
        let params_opt = pair.1
        p = p.expect(TokenKind::RParen)
        // Return type
        let pair2 = p.parse_optional_return_type()
        p = pair2.0
        let ret_ty = pair2.1
        // Effects
        // p came from pair2.0 (SIZE_HINT type) — use parser_peek free fn
        var effects_opt: Option<Box<EffectList>> = None
        if parser_peek(p) == TokenKind::With {
            let pair3 = p.parse_effect_list()
            p = pair3.0
            effects_opt = Some(Box::new(pair3.1))
        }
        // Body
        let pair4 = p.parse_block()
        p = pair4.0
        let body = pair4.1
        if parser_peek(p) == TokenKind::With {
            let pair5 = p.parse_effect_list()
            p = pair5.0
            match effects_opt {
                None => {
                    effects_opt = Some(Box::new(pair5.1))
                },
                Some(_) => {},
            }
        }

        let span = p.span_from(start)
        // Wave10: register pure zero-arg const bodies for global element-list calls.
        items_maybe_record_pure_fn_const(name, &params_opt, &effects_opt, &body)
        let fn_def = FnDef {
            name: name,
            params: params_opt,
            return_type: ret_ty,
            effects: effects_opt,
            body: body,
            span: span,
            is_kernel: is_kernel,
            is_extern: false,
        }

        (p, Item {
            kind: ItemKind::ItemFn,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: Some(Box::new(fn_def)),
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    // ============================================================
    // Parameter list
    // ============================================================

    fn parse_param_list(self) -> (Parser, Option<Box<ParamList>>) with Mut, IO, Panic, Div, Alloc {
        if self.peek() == TokenKind::RParen {
            let none_params: Option<Box<ParamList>> = None
            return (self, none_params)
        }
        let pair = self.parse_param()
        var p = pair.0
        let first = pair.1
        var rev_params_opt: Option<Box<ParamList>> = Some(Box::new(ParamList { head: first, tail: None }))

        while parser_peek(p) == TokenKind::Comma {
            p = p.advance()
            if parser_peek(p) == TokenKind::RParen { break }
            let pair2 = p.parse_param()
            p = pair2.0
            let next = pair2.1
            rev_params_opt = Some(Box::new(ParamList { head: next, tail: rev_params_opt }))
        }
        let rp = reverse_param_list_opt(rev_params_opt)
        (p, rp)
    }

    // ============================================================
    // Single parameter: name: Type  or  self
    // ============================================================

    fn parse_param(self) -> (Parser, Param) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()

        if self.peek() == TokenKind::SelfLower {
            // self parameter
            let name = self.current_name()
            var p = self.advance()
            var ty = dummy_type_expr()
            if parser_peek(p) == TokenKind::Colon {
                p = p.advance()
                let pair = p.parse_type()
                p = pair.0
                ty = pair.1
            }
            let span = p.span_from(start)
            (p, Param {
                name: name,
                ty: ty,
                is_self: true,
                is_self_mut: false,
                span: span,
            })
        } else {
            let name = self.current_name()
            var p = self.expect_ident()
            p = p.expect(TokenKind::Colon)
            let pair = p.parse_type()
            p = pair.0
            let ty = pair.1
            let span = p.span_from(start)
            (p, Param {
                name: name,
                ty: ty,
                is_self: false,
                is_self_mut: false,
                span: span,
            })
        }
    }

    // ============================================================
    // Struct: struct Name { field: Type, ... }
    // ============================================================

    fn parse_struct_item(self, is_linear: bool, is_affine: bool, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'struct'

        let name = p.current_name()
        p = p.expect_ident()

        // Parse optional type parameters: struct Foo<T, U> { ... }
        var type_params_opt: Option<Box<TypeParamDefList>> = None
        if parser_peek(p) == TokenKind::Lt {
            p = p.advance()  // skip '<'
            var rev_tparams: Option<Box<TypeParamDefList>> = None
            while parser_peek(p) != TokenKind::Gt && parser_peek(p) != TokenKind::Eof {
                let tp_span = p.current_span()
                if parser_peek(p) == TokenKind::Const {
                    p = p.advance()
                }
                let tp_name = p.current_name()
                p = p.expect_ident()
                if parser_peek(p) == TokenKind::Colon {
                    p = p.advance()
                    let ann_pair = p.parse_type()
                    p = ann_pair.0
                }
                let tpd = TypeParamDef { name: tp_name, span: p.span_from(tp_span) }
                rev_tparams = Some(Box::new(TypeParamDefList { head: tpd, tail: rev_tparams }))
                if parser_peek(p) == TokenKind::Comma {
                    p = p.advance()
                } else if parser_peek(p) != TokenKind::Gt {
                    p = p.advance()
                }
            }
            p = p.expect(TokenKind::Gt)
            type_params_opt = reverse_type_param_def_list_opt(rev_tparams)
        }

        p = p.expect(TokenKind::LBrace)

        // Parse fields
        var rev_fields_opt: Option<Box<FieldDefList>> = None

        while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
            let field_start = p.current_span()
            if parser_peek(p) == TokenKind::Pub {
                p = p.advance()
            }
            let field_name = p.current_name()
            p = p.expect_ident()
            p = p.expect(TokenKind::Colon)
            let pair = p.parse_type()
            p = pair.0
            let field_ty = pair.1

            let field = FieldDef { name: field_name, ty: field_ty, span: p.span_from(field_start) }

            rev_fields_opt = Some(Box::new(FieldDefList { head: field, tail: rev_fields_opt }))

            if parser_peek(p) == TokenKind::Comma {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)
        let fields_opt = reverse_field_def_list_opt(rev_fields_opt)
        let span = p.span_from(start)
        let sdef = StructDef { name: name, type_params: type_params_opt, fields: fields_opt, is_linear: is_linear, is_affine: is_affine, span: span }

        (p, Item {
            kind: ItemKind::ItemStruct,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: Some(Box::new(sdef)),
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    fn parse_type_param_header(self) -> Parser with Mut, IO, Panic, Div, Alloc {
        var p = self.expect(TokenKind::Lt)
        while parser_peek(p) != TokenKind::Gt && parser_peek(p) != TokenKind::Eof {
            if parser_peek(p) == TokenKind::Const {
                p = p.advance()
            }
            p = p.expect_ident()
            if parser_peek(p) == TokenKind::Colon {
                p = p.advance()
                let ann_pair = p.parse_type()
                p = ann_pair.0
            }
            if parser_peek(p) == TokenKind::Comma {
                p = p.advance()
            } else if parser_peek(p) != TokenKind::Gt {
                p = p.advance()
            }
        }
        p.expect(TokenKind::Gt)
    }

    // ============================================================
    // Enum: enum Name { Variant1, Variant2, ... }
    // ============================================================

    fn parse_enum_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'enum'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::LBrace)

        var rev_variants_opt: Option<Box<VariantDefList>> = None

        while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
            let v_start = p.current_span()
            let v_name = p.current_name()
            p = p.expect_ident()

            // Parse optional variant fields: Variant { field1: Type1, field2: Type2 }
            var v_fields: Option<Box<FieldDefList>> = None
            if parser_peek(p) == TokenKind::LBrace {
                p = p.advance()  // skip {
                var rev_fields: Option<Box<FieldDefList>> = None
                while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
                    if parser_peek(p) == TokenKind::Pub {
                        p = p.advance()
                    }
                    let f_name = p.current_name()
                    p = p.expect_ident()
                    p = p.expect(TokenKind::Colon)
                    let ty_pair = p.parse_type()
                    p = ty_pair.0
                    let f_ty = ty_pair.1
                    let f_span = p.span_from(v_start)
                    let fdef = FieldDef { name: f_name, ty: f_ty, span: f_span }
                    rev_fields = Some(Box::new(FieldDefList { head: fdef, tail: rev_fields }))
                    if parser_peek(p) == TokenKind::Comma {
                        p = p.advance()
                    }
                }
                p = p.expect(TokenKind::RBrace)
                v_fields = reverse_field_def_list_opt(rev_fields)
            }

            let v_span = p.span_from(v_start)
            let variant = VariantDef { name: v_name, fields: v_fields, span: v_span }

            rev_variants_opt = Some(Box::new(VariantDefList { head: variant, tail: rev_variants_opt }))

            if parser_peek(p) == TokenKind::Comma {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)
        let variants_opt = reverse_variant_def_list_opt(rev_variants_opt)
        let span = p.span_from(start)
        let edef = EnumDef { name: name, variants: variants_opt, span: span }

        (p, Item {
            kind: ItemKind::ItemEnum,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: Some(Box::new(edef)),
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    // ============================================================
    // Impl: impl Type { fn method() { } ... }
    // ============================================================

    fn parse_impl_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'impl'

        let pair = p.parse_type()
        p = pair.0
        var target_ty = pair.1
        var trait_name = empty_name()

        // `impl TraitName for Type { ... }` — the first type parsed above is
        // actually the trait name; re-parse the real target type after `for`.
        if parser_peek(p) == TokenKind::For {
            p = p.advance()  // skip 'for'
            trait_name = extract_impl_name(target_ty)
            let pair_target = p.parse_type()
            p = pair_target.0
            target_ty = pair_target.1
        }

        p = p.expect(TokenKind::LBrace)

        // Build methods in reverse for O(1) cons, reverse once at the end.
        var rev_methods_opt: Option<Box<ItemList>> = None

        while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
            // Ignore trivia and doc comments between methods.
            while parser_peek(p) == TokenKind::Newline || parser_peek(p) == TokenKind::Semi || tk_is_doc_comment(parser_peek(p)) {
                p = p.advance()
            }

            if parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
                var method_visibility = visibility_private()
                if parser_peek(p) == TokenKind::Pub {
                    let visibility_pair = p.parse_pub_visibility()
                    p = visibility_pair.0
                    method_visibility = visibility_pair.1
                }

                if parser_peek(p) == TokenKind::Fn {
                    // First arg is `visibility: Visibility` (a struct), NOT a bool. Passing
                    // `false` here was an ABI mismatch (bool bits read as a Visibility) that
                    // corrupted the call and SIGSEGV'd on every impl method; it built only
                    // because the type error is a non-fatal warning. Methods default private.
                    let pair2 = p.parse_fn_item(method_visibility, false)
                    p = pair2.0
                    let method = pair2.1
                    rev_methods_opt = Some(Box::new(ItemList { head: method, tail: rev_methods_opt }))
                } else {
                    // Record unexpected input, but preserve the impl boundary after incomplete visibility.
                    p.had_error = true
                    p.error_count = p.error_count + 1
                    if parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
                        p = p.advance()
                    }
                }
            }
        }

        p = p.expect(TokenKind::RBrace)
        let span = p.span_from(start)
        let methods_opt = items_reverse_item_list_opt(rev_methods_opt)

        // Extract name from target type path
        let impl_name = extract_impl_name(target_ty)

        let idef = ImplDef { target_type: target_ty, methods: methods_opt, span: span, trait_name: trait_name }

        (p, Item {
            kind: ItemKind::ItemImpl,
            span: span,
            visibility: visibility,
            name: impl_name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: Some(Box::new(idef)),
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
            trait_def: None,
        })
    }

    // ============================================================
    // Trait definition: trait Name { fn method(); ... }
    // ============================================================

    fn parse_trait_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'trait'
        let name = p.current_name()
        p = p.advance()  // skip name

        // Parse trait body: { fn m1(self, o: Self) -> Self  fn m2(x: i64) -> i64 { ... } ... }
        // Trait methods may be bodyless signatures (no `{ ... }`) or carry a default
        // implementation body; parse_trait_method_sig handles both.
        p = p.expect(TokenKind::LBrace)
        var rev_methods_opt: Option<Box<ItemList>> = None
        while parser_peek(p) != TokenKind::RBrace && !parser_at_eof(p) {
            // Ignore trivia and doc comments between method signatures.
            while parser_peek(p) == TokenKind::Newline || parser_peek(p) == TokenKind::Semi || tk_is_doc_comment(parser_peek(p)) {
                p = p.advance()
            }
            if parser_peek(p) == TokenKind::RBrace || parser_at_eof(p) {
                break
            }
            if parser_peek(p) == TokenKind::Fn {
                let method_pair = p.parse_trait_method_sig()
                p = method_pair.0
                let method_item = method_pair.1
                rev_methods_opt = Some(Box::new(ItemList { head: method_item, tail: rev_methods_opt }))
            } else {
                // Recovery: consume one unexpected token inside trait body.
                p.had_error = true
                p.error_count = p.error_count + 1
                p = p.advance()
            }
        }
        p = p.expect(TokenKind::RBrace)
        let methods_opt = items_reverse_item_list_opt(rev_methods_opt)

        let span = p.span_from(start)
        let tdef = TraitItemDef { name: name, methods: methods_opt, supertraits: None, span: span }

        (p, Item {
            kind: ItemKind::ItemTrait,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
            trait_def: Some(Box::new(tdef)),
        })
    }

    // Trait method signature: `fn name(self, o: Self) -> Self` optionally followed
    // by a `{ ... }` default body. When no body follows, an empty Block is stored
    // (v1: bodyless signatures are parsed and carried, not semantically dispatched).
    fn parse_trait_method_sig(self) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'fn'
        let name = p.current_name()
        p = p.expect_ident()
        if parser_peek(p) == TokenKind::Lt {
            p = p.parse_type_param_header()
        }
        p = p.expect(TokenKind::LParen)
        let pair = p.parse_param_list()
        p = pair.0
        let params_opt = pair.1
        p = p.expect(TokenKind::RParen)
        let pair2 = p.parse_optional_return_type()
        p = pair2.0
        let ret_ty = pair2.1
        var effects_opt: Option<Box<EffectList>> = None
        if parser_peek(p) == TokenKind::With {
            let pair3 = p.parse_effect_list()
            p = pair3.0
            effects_opt = Some(Box::new(pair3.1))
        }
        var body = Block { stmts: None, span: p.current_span() }
        if parser_peek(p) == TokenKind::LBrace {
            let pair4 = p.parse_block()
            p = pair4.0
            body = pair4.1
        }
        let span = p.span_from(start)
        let fn_def = FnDef {
            name: name,
            params: params_opt,
            return_type: ret_ty,
            effects: effects_opt,
            body: body,
            span: span,
            is_kernel: false,
            is_extern: false,
        }

        (p, Item {
            kind: ItemKind::ItemFn,
            span: span,
            visibility: visibility_private(),
            name: name,
            fn_def: Some(Box::new(fn_def)),
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    // ============================================================
    // Type alias: type Name = Type
    // ============================================================

    fn parse_type_alias_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'type'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::Eq)

        // Check for refinement type: { var: Type | predicate }
        if parser_peek(p) == TokenKind::LBrace {
            let ref_pair = p.parse_refinement_type()
            p = ref_pair.0
            let ref_ty = ref_pair.1
            if parser_peek(p) == TokenKind::Semi {
                p = p.advance()
            }
            let span = p.span_from(start)
            return (p, Item {
                kind: ItemKind::ItemTypeAlias,
                span: span,
                visibility: visibility,
                name: name,
                fn_def: None,
                struct_def: None,
                enum_def: None,
                impl_def: None,
                type_alias_ty: Some(Box::new(ref_ty)),
                policy_def: None,
                acquisition_policy_def: None,
                recourse_policy_def: None,
                decision_policy_def: None,
                deferral_policy_def: None,
                transition_policy_def: None,
                transition_protocol_def: None,
                monitoring_policy_def: None,
                alternative_policy_def: None,
                alternative_frontier_def: None,
                models_def: None,
                validation_def: None,
                audit_def: None,
                use_path: empty_path(),
                use_glob: false,
                use_items: None,
                effect_def: None,
                session_decl: None,
                algebra_def: None,
                study_def: None,
                ontology_def: None,
                trait_def: None,
            })
        }

        let pair = p.parse_type()
        p = pair.0
        let ty = pair.1
        if parser_peek(p) == TokenKind::Semi {
            p = p.advance()
        }

        let span = p.span_from(start)
        (p, Item {
            kind: ItemKind::ItemTypeAlias,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: Some(Box::new(ty)),
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    // ============================================================
    // Policy: policy Name for Type { require metric >= value }
    // ============================================================

    fn parse_policy_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'policy'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::For)

        let target_pair = p.parse_type()
        p = target_pair.0
        let target_ty = target_pair.1

        var level_name = empty_name()
        var scope_name = empty_name()
        if parser_peek(p) == TokenKind::Level {
            p = p.advance()
            level_name = p.current_name()
            p = p.expect_ident()
        }
        if parser_peek(p) == TokenKind::Scope {
            p = p.advance()
            scope_name = p.current_name()
            p = p.expect_ident()
        }

        p = p.expect(TokenKind::LBrace)
        var rev_requirements_opt: Option<Box<PolicyRequirementList>> = None

        while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
            while parser_peek(p) == TokenKind::Semi || parser_peek(p) == TokenKind::Newline {
                p = p.advance()
            }
            if parser_peek(p) == TokenKind::RBrace || parser_peek(p) == TokenKind::Eof {
                break
            }

            let req_pair = p.parse_policy_requirement()
            p = req_pair.0
            rev_requirements_opt = Some(Box::new(PolicyRequirementList {
                head: req_pair.1,
                tail: rev_requirements_opt,
            }))

            while parser_peek(p) == TokenKind::Semi {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)

        let span = p.span_from(start)
        let pdef = PolicyDef {
            name: name,
            target_type: target_ty,
            level_name: level_name,
            scope_name: scope_name,
            requirements: reverse_policy_requirement_list_opt(rev_requirements_opt),
            span: span,
        }

        (p, Item {
            kind: ItemKind::ItemPolicy,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: Some(Box::new(pdef)),
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    fn parse_acquisition_policy_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'acquisition_policy'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::For)

        let target_pair = p.parse_type()
        p = target_pair.0
        let target_ty = target_pair.1

        var objective_name = empty_name()
        if parser_peek(p) == TokenKind::Objective {
            p = p.advance()
            objective_name = p.current_name()
            p = p.expect_ident()
        }

        var route_name = empty_name()
        if parser_peek(p) == TokenKind::Route {
            p = p.advance()
            route_name = p.current_name()
            p = p.expect_ident()
        }

        p = p.expect(TokenKind::LBrace)
        var rev_requirements_opt: Option<Box<PolicyRequirementList>> = None

        while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
            while parser_peek(p) == TokenKind::Semi || parser_peek(p) == TokenKind::Newline {
                p = p.advance()
            }
            if parser_peek(p) == TokenKind::RBrace || parser_peek(p) == TokenKind::Eof {
                break
            }

            let req_pair = p.parse_policy_requirement()
            p = req_pair.0
            rev_requirements_opt = Some(Box::new(PolicyRequirementList {
                head: req_pair.1,
                tail: rev_requirements_opt,
            }))

            while parser_peek(p) == TokenKind::Semi {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)

        let span = p.span_from(start)
        let apdef = AcquisitionPolicyDef {
            name: name,
            target_type: target_ty,
            objective_name: objective_name,
            route_name: route_name,
            requirements: reverse_policy_requirement_list_opt(rev_requirements_opt),
            span: span,
        }

        (p, Item {
            kind: ItemKind::ItemAcquisitionPolicy,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: Some(Box::new(apdef)),
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

    fn parse_recourse_policy_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'recourse_policy'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::For)

        let target_pair = p.parse_type()
        p = target_pair.0
        let target_ty = target_pair.1

        var strategy_name = empty_name()
        if parser_peek(p) == TokenKind::Strategy {
            p = p.advance()
            strategy_name = p.current_name()
            p = p.expect_ident()
        }

        var route_name = empty_name()
        if parser_peek(p) == TokenKind::Route {
            p = p.advance()
            route_name = p.current_name()
            p = p.expect_ident()
        }

        p = p.expect(TokenKind::LBrace)
        var rev_requirements_opt: Option<Box<PolicyRequirementList>> = None

        while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
            while parser_peek(p) == TokenKind::Semi || parser_peek(p) == TokenKind::Newline {
                p = p.advance()
            }
            if parser_peek(p) == TokenKind::RBrace || parser_peek(p) == TokenKind::Eof {
                break
            }

            let req_pair = p.parse_policy_requirement()
            p = req_pair.0
            rev_requirements_opt = Some(Box::new(PolicyRequirementList {
                head: req_pair.1,
                tail: rev_requirements_opt,
            }))

            while parser_peek(p) == TokenKind::Semi {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)

        let span = p.span_from(start)
        let rpdef = RecoursePolicyDef {
            name: name,
            target_type: target_ty,
            strategy_name: strategy_name,
            route_name: route_name,
            requirements: reverse_policy_requirement_list_opt(rev_requirements_opt),
            span: span,
        }

        (p, Item {
            kind: ItemKind::ItemRecoursePolicy,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
