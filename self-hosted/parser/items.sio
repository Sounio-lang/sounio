    fn parse_alternative_policy_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'alternative_policy'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::For)

        let target_pair = p.parse_type()
        p = target_pair.0
        let target_ty = target_pair.1

        var frontier_name = empty_name()
        if p.peek() == TokenKind::Ident && parser_name_is_frontier(p.current_name()) {
            p = p.advance()
            frontier_name = p.current_name()
            p = p.expect_ident()
        }

        p = p.expect(TokenKind::LBrace)
        var rev_objectives_opt: Option<Box<AlternativeObjectiveDefList>> = None
        var max_options: i64 = -1

        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            while p.peek() == TokenKind::Semi || p.peek() == TokenKind::Newline {
                p = p.advance()
            }
            if p.peek() == TokenKind::RBrace || p.peek() == TokenKind::Eof {
                break
            }

            if p.peek() == TokenKind::Objective {
                let obj_pair = p.parse_alternative_objective_def()
                p = obj_pair.0
                rev_objectives_opt = Some(Box::new(AlternativeObjectiveDefList {
                    head: obj_pair.1,
                    tail: rev_objectives_opt,
                }))
            } else if p.peek() == TokenKind::Ident && parser_name_is_max_options(p.current_name()) {
                p = p.advance()
                if p.peek() == TokenKind::IntLit {
                    max_options = p.current().int_value
                    p = p.advance()
                } else {
                    p.had_error = true
                    p.error_count = p.error_count + 1
                    p = p.advance()
                }
            } else {
                p.had_error = true
                p.error_count = p.error_count + 1
                p = p.advance()
            }

            while p.peek() == TokenKind::Semi {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)

        let span = p.span_from(start)
        let apdef = AlternativePolicyDef {
            name: name,
            target_type: target_ty,
            frontier_name: frontier_name,
            objectives: reverse_alternative_objective_def_list_opt(rev_objectives_opt),
            max_options: max_options,
            span: span,
        }

        (p, Item {
            kind: ItemKind::ItemAlternativePolicy,
            span: span,
            is_pub: is_pub,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
