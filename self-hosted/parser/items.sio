    fn parse_alternative_objective_def(self) -> (Parser, AlternativeObjectiveDef) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip objective

        var direction = AlternativeObjectiveDirection::AlternativeObjectiveMinimize
        if p.peek() == TokenKind::Ident && parser_name_is_maximize(p.current_name()) {
            direction = AlternativeObjectiveDirection::AlternativeObjectiveMaximize
            p = p.advance()
        } else if p.peek() == TokenKind::Ident && parser_name_is_minimize(p.current_name()) {
            p = p.advance()
        } else {
            p.had_error = true
            p.error_count = p.error_count + 1
        }

        let metric_name = p.current_name()
        p = p.expect_ident()

        let span = p.span_from(start)
        (p, AlternativeObjectiveDef {
            direction: direction,
            metric_name: metric_name,
            span: span,
        })
    }

    fn parse_alternative_candidate_def(self) -> (Parser, AlternativeCandidateDef) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        let head_name = self.current_name()
        var p = self.expect_ident()
        let uses_via = parser_name_is_candidate(head_name)

        let name = p.current_name()
        p = p.expect_ident()

        var via_name = empty_name()
        if uses_via {
            if p.peek() == TokenKind::Ident && parser_name_is_via(p.current_name()) {
                p = p.advance()
                via_name = p.current_name()
                p = p.expect_ident()
            } else {
                p.had_error = true
                p.error_count = p.error_count + 1
            }
        }

        p = p.expect(TokenKind::LBrace)

        var have_value = false
        var value_expr = mk_expr(ExprKind::ExprError, Span { file_id: 0, start: 0, end: 0 })
        var rev_metrics_opt: Option<Box<AuditFieldEntryList>> = None

        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            while p.peek() == TokenKind::Semi || p.peek() == TokenKind::Newline || p.peek() == TokenKind::Comma {
                p = p.advance()
            }
            if p.peek() == TokenKind::RBrace || p.peek() == TokenKind::Eof {
                break
            }

            if p.peek() == TokenKind::Ident && parser_name_is_value(p.current_name()) {
                p = p.advance()
                p = p.expect(TokenKind::Colon)
                let value_pair = p.parse_expr()
                p = value_pair.0
                value_expr = value_pair.1
                have_value = true
            } else if p.peek() == TokenKind::Ident && parser_name_is_metrics(p.current_name()) {
                p = p.advance()
                p = p.expect(TokenKind::LBrace)
                while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
                    while p.peek() == TokenKind::Semi || p.peek() == TokenKind::Newline || p.peek() == TokenKind::Comma {
                        p = p.advance()
                    }
                    if p.peek() == TokenKind::RBrace || p.peek() == TokenKind::Eof {
                        break
                    }
                    let metric_pair = p.parse_audit_field_entry()
                    p = metric_pair.0
                    rev_metrics_opt = Some(Box::new(AuditFieldEntryList {
                        head: metric_pair.1,
                        tail: rev_metrics_opt,
                    }))
                    while p.peek() == TokenKind::Semi || p.peek() == TokenKind::Comma {
                        p = p.advance()
                    }
                }
                p = p.expect(TokenKind::RBrace)
            } else {
                p.had_error = true
                p.error_count = p.error_count + 1
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)
        let span = p.span_from(start)
        if !have_value {
            value_expr = mk_expr(ExprKind::ExprError, span)
        }
        (p, AlternativeCandidateDef {
            name: name,
            via_name: via_name,
            value_expr: value_expr,
            metrics: reverse_audit_field_entry_list_opt(rev_metrics_opt),
            uses_via: uses_via,
            span: span,
        })
    }

    fn parse_transition_step_def(self) -> (Parser, TransitionStepDef) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self
        if p.peek() == TokenKind::Step {
            p = p.advance()
        } else {
            p.had_error = true
            p.error_count = p.error_count + 1
        }

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::LBrace)

        var have_value = false
        var value_expr = mk_expr(ExprKind::ExprError, Span { file_id: 0, start: 0, end: 0 })
        var rev_requirements_opt: Option<Box<PolicyRequirementList>> = None

        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            while p.peek() == TokenKind::Semi || p.peek() == TokenKind::Newline || p.peek() == TokenKind::Comma {
                p = p.advance()
            }
            if p.peek() == TokenKind::RBrace || p.peek() == TokenKind::Eof {
                break
            }

            if p.peek() == TokenKind::Ident && parser_name_is_value(p.current_name()) {
                p = p.advance()
                p = p.expect(TokenKind::Colon)
                let value_pair = p.parse_expr()
                p = value_pair.0
                value_expr = value_pair.1
                have_value = true
            } else if p.peek() == TokenKind::Require {
                let req_pair = p.parse_policy_requirement()
                p = req_pair.0
                rev_requirements_opt = Some(Box::new(PolicyRequirementList {
                    head: req_pair.1,
                    tail: rev_requirements_opt,
                }))
            } else {
                p.had_error = true
                p.error_count = p.error_count + 1
                p = p.advance()
            }

            while p.peek() == TokenKind::Semi || p.peek() == TokenKind::Comma {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)
        let span = p.span_from(start)
        if !have_value {
            value_expr = mk_expr(ExprKind::ExprError, span)
        }

        (p, TransitionStepDef {
            name: name,
            value_expr: value_expr,
            requirements: reverse_policy_requirement_list_opt(rev_requirements_opt),
            span: span,
        })
    }

    // ============================================================
    // Decision policy: decision_policy Name for Type { require metric >= value }
    // ============================================================

    fn parse_decision_policy_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'decision_policy'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::For)

        let target_pair = p.parse_type()
        p = target_pair.0
        let target_ty = target_pair.1

        p = p.expect(TokenKind::LBrace)
        var rev_requirements_opt: Option<Box<PolicyRequirementList>> = None

        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            while p.peek() == TokenKind::Semi || p.peek() == TokenKind::Newline {
                p = p.advance()
            }
            if p.peek() == TokenKind::RBrace || p.peek() == TokenKind::Eof {
                break
            }

            let req_pair = p.parse_policy_requirement()
            p = req_pair.0
            rev_requirements_opt = Some(Box::new(PolicyRequirementList {
                head: req_pair.1,
                tail: rev_requirements_opt,
            }))

            while p.peek() == TokenKind::Semi {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)

        let span = p.span_from(start)
        let ddef = DecisionPolicyDef {
            name: name,
            target_type: target_ty,
            requirements: reverse_policy_requirement_list_opt(rev_requirements_opt),
            span: span,
        }

        (p, Item {
            kind: ItemKind::ItemDecisionPolicy,
            span: span,
            is_pub: is_pub,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: Some(Box::new(ddef)),
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
        })
    }

    fn parse_deferral_policy_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'deferral_policy'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::For)

        let target_pair = p.parse_type()
        p = target_pair.0
        let target_ty = target_pair.1

        var route_name = empty_name()
        if p.peek() == TokenKind::Route {
            p = p.advance()
            route_name = p.current_name()
            p = p.expect_ident()
        }

        p = p.expect(TokenKind::LBrace)
        var rev_requirements_opt: Option<Box<PolicyRequirementList>> = None

        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            while p.peek() == TokenKind::Semi || p.peek() == TokenKind::Newline {
                p = p.advance()
            }
            if p.peek() == TokenKind::RBrace || p.peek() == TokenKind::Eof {
                break
            }

            let req_pair = p.parse_policy_requirement()
            p = req_pair.0
            rev_requirements_opt = Some(Box::new(PolicyRequirementList {
                head: req_pair.1,
                tail: rev_requirements_opt,
            }))

            while p.peek() == TokenKind::Semi {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)

        let span = p.span_from(start)
        let ddef = DeferralPolicyDef {
            name: name,
            target_type: target_ty,
            route_name: route_name,
            requirements: reverse_policy_requirement_list_opt(rev_requirements_opt),
            span: span,
        }

        (p, Item {
            kind: ItemKind::ItemDeferralPolicy,
            span: span,
            is_pub: is_pub,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: Some(Box::new(ddef)),
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
        })
    }

    fn parse_models_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'models'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::Eq)
        p = p.expect(TokenKind::LBracket)

        var rev_models_opt: Option<Box<AstPathList>> = None
        var model_count: i64 = 0

        if p.peek() != TokenKind::RBracket {
            let pair = p.parse_type_path()
            p = pair.0
            rev_models_opt = Some(Box::new(AstPathList { head: pair.1, tail: None }))
            model_count = 1

            while p.peek() == TokenKind::Comma {
                p = p.advance()
                if p.peek() == TokenKind::RBracket { break }
                let pair2 = p.parse_type_path()
                p = pair2.0
                rev_models_opt = Some(Box::new(AstPathList { head: pair2.1, tail: rev_models_opt }))
                model_count = model_count + 1
            }
        }

        p = p.expect(TokenKind::RBracket)
        let span = p.span_from(start)
        let mdef = ModelsDef {
            name: name,
            models: reverse_ast_path_list_opt(rev_models_opt),
            model_count: model_count,
            span: span,
        }

        (p, Item {
            kind: ItemKind::ItemModels,
            span: span,
            is_pub: is_pub,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
                impl_def: None,
                type_alias_ty: None,
                policy_def: None,
                acquisition_policy_def: None,
                recourse_policy_def: None,
                decision_policy_def: None,
                deferral_policy_def: None,
                transition_policy_def: None,
                transition_protocol_def: None,
                monitoring_policy_def: None,
                alternative_policy_def: None,
                alternative_frontier_def: None,
            models_def: Some(Box::new(mdef)),
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
        })
    }

    fn parse_validation_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'validation'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::For)

        let target_pair = p.parse_type()
        p = target_pair.0
        let target_ty = target_pair.1

        p = p.expect(TokenKind::LBrace)
        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            p = p.advance()
        }
        p = p.expect(TokenKind::RBrace)

        let span = p.span_from(start)
        let vdef = ValidationDef {
            name: name,
            target_type: target_ty,
            span: span,
        }

        (p, Item {
            kind: ItemKind::ItemValidation,
            span: span,
            is_pub: is_pub,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: Some(Box::new(vdef)),
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
        })
    }

    fn parse_audit_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'audit'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::For)

        let target_pair = p.parse_type()
        p = target_pair.0
        let target_ty = target_pair.1

        p = p.expect(TokenKind::LBrace)
        var rev_sections_opt: Option<Box<AuditSectionList>> = None

        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            while p.peek() == TokenKind::Semi || p.peek() == TokenKind::Newline {
                p = p.advance()
            }
            if p.peek() == TokenKind::RBrace || p.peek() == TokenKind::Eof {
                break
            }
            let section_pair = p.parse_audit_section()
            p = section_pair.0
            rev_sections_opt = Some(Box::new(AuditSectionList {
                head: section_pair.1,
                tail: rev_sections_opt,
            }))
            while p.peek() == TokenKind::Semi {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)

        let span = p.span_from(start)
        let adef = AuditDef {
            name: name,
            target_type: target_ty,
            sections: reverse_audit_section_list_opt(rev_sections_opt),
            span: span,
        }

        (p, Item {
            kind: ItemKind::ItemAudit,
            span: span,
            is_pub: is_pub,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: Some(Box::new(adef)),
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
        })
    }

    fn parse_audit_section(self) -> (Parser, AuditSection) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        let section_name = self.current_name()
        var p = self.expect_ident()
        p = p.expect(TokenKind::LBrace)

        var rev_fields_opt: Option<Box<AuditFieldEntryList>> = None
        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            while p.peek() == TokenKind::Comma || p.peek() == TokenKind::Semi || p.peek() == TokenKind::Newline {
                p = p.advance()
            }
            if p.peek() == TokenKind::RBrace || p.peek() == TokenKind::Eof {
                break
            }
            let field_pair = p.parse_audit_field_entry()
            p = field_pair.0
            rev_fields_opt = Some(Box::new(AuditFieldEntryList {
                head: field_pair.1,
                tail: rev_fields_opt,
            }))
            while p.peek() == TokenKind::Comma || p.peek() == TokenKind::Semi {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)
        let span = p.span_from(start)
        (p, AuditSection {
            kind: audit_section_kind_from_name(section_name),
            name: section_name,
            fields: reverse_audit_field_entry_list_opt(rev_fields_opt),
            span: span,
        })
    }

    fn parse_audit_field_entry(self) -> (Parser, AuditFieldEntry) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        let field_name = self.current_name()
        var p = self.expect_ident()
        p = p.expect(TokenKind::Colon)

        var value_name = empty_name()
        var value_f64: f64 = 0.0
        var value_kind = AuditValueKind::AuditValueName
        if p.peek() == TokenKind::IntLit {
            value_kind = AuditValueKind::AuditValueFloat
            value_f64 = p.current().int_value as f64
            p = p.advance()
        } else if p.peek() == TokenKind::FloatLit {
            value_kind = AuditValueKind::AuditValueFloat
            value_f64 = p.current().float_value
            p = p.advance()
        } else {
            let name_pair = p.parse_audit_name_value()
            p = name_pair.0
            value_name = name_pair.1
        }

        let span = p.span_from(start)
        (p, AuditFieldEntry {
            name: field_name,
            value_name: value_name,
            value_f64: value_f64,
            value_kind: value_kind,
            span: span,
        })
    }

    fn parse_audit_name_value(self) -> (Parser, Name) with Mut, IO, Panic, Div, Alloc {
        if self.peek() == TokenKind::StringLit {
            let name = self.current_name()
            (self.advance(), name)
        } else if self.peek() == TokenKind::Ident {
            if self.peek_ahead(1) == TokenKind::ColonColon {
                let pair = self.parse_type_path()
                (pair.0, copy_string_list_tail_to_name(pair.1.segments))
            } else {
                let name = self.current_name()
                (self.expect_ident(), name)
            }
        } else {
            var p = self
            p.had_error = true
            p.error_count = p.error_count + 1
            (p.advance(), empty_name())
        }
    }

    fn parse_policy_requirement(self) -> (Parser, PolicyRequirement) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.expect(TokenKind::Require)

        let metric_name = p.current_name()
        p = p.expect_ident()

        let cmp_pair = p.parse_policy_compare_op()
        p = cmp_pair.0
        let cmp_op = cmp_pair.1

        var threshold: f64 = 0.0
        var threshold_kind: i64 = 0
        var bool_threshold = false
        var name_threshold = empty_name()
        if p.peek() == TokenKind::IntLit {
            threshold = p.current().int_value as f64
            p = p.advance()
        } else if p.peek() == TokenKind::FloatLit {
            threshold = p.current().float_value
            p = p.advance()
        } else if p.peek() == TokenKind::True {
            threshold = 1.0
            threshold_kind = 1
            bool_threshold = true
            p = p.advance()
        } else if p.peek() == TokenKind::False {
            threshold = 0.0
            threshold_kind = 1
            bool_threshold = false
            p = p.advance()
        } else if p.peek() == TokenKind::Ident {
            threshold_kind = 2
            name_threshold = p.current_name()
            p = p.advance()
        } else {
            p.had_error = true
            p.error_count = p.error_count + 1
            p = p.advance()
        }

        let span = p.span_from(start)
        (p, PolicyRequirement {
            metric_name: metric_name,
            op: cmp_op,
            threshold: threshold,
            threshold_kind: threshold_kind,
            bool_threshold: bool_threshold,
            name_threshold: name_threshold,
            span: span,
        })
    }

    fn parse_policy_compare_op(self) -> (Parser, CompareOp) with Mut, IO, Panic, Div {
        let op_tok = self.peek()
        if op_tok == TokenKind::Lt {
            (self.advance(), CompareOp::CmpLt)
        } else if op_tok == TokenKind::LtEq {
            (self.advance(), CompareOp::CmpLe)
        } else if op_tok == TokenKind::Gt {
            (self.advance(), CompareOp::CmpGt)
        } else if op_tok == TokenKind::GtEq {
            (self.advance(), CompareOp::CmpGe)
        } else if op_tok == TokenKind::EqEq {
            (self.advance(), CompareOp::CmpEq)
        } else {
            var p = self
            p.had_error = true
            p.error_count = p.error_count + 1
            (p.advance(), CompareOp::CmpEq)
        }
    }

    // ============================================================
    // Refinement type: { var: Type | var op value }
    // ============================================================

    fn parse_refinement_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip '{'

        // Parse: var_name : BaseType
        let var_name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::Colon)
        let type_pair = p.parse_type()
        p = type_pair.0
        let base_ty = type_pair.1

        // Expect '|'
        p = p.expect(TokenKind::Pipe)

        // Parse predicate: var_name op literal_value
        // Skip the variable reference (should match var_name)
        p = p.advance()  // skip var ident in predicate

        // Parse comparison operator
        var pred_op: i64 = 0
        let op_tok = p.peek()
        if op_tok == TokenKind::Gt {
            pred_op = 1  // refinement_op_gt
            p = p.advance()
        } else if op_tok == TokenKind::GtEq {
            pred_op = 2  // refinement_op_gt_eq
            p = p.advance()
        } else if op_tok == TokenKind::Lt {
            pred_op = 3  // refinement_op_lt
            p = p.advance()
        } else if op_tok == TokenKind::LtEq {
            pred_op = 4  // refinement_op_lt_eq
            p = p.advance()
        } else if op_tok == TokenKind::EqEq {
            pred_op = 5  // refinement_op_eq
            p = p.advance()
        } else if op_tok == TokenKind::BangEq {
            pred_op = 6  // refinement_op_neq
            p = p.advance()
        } else {
            // Unexpected token — flag error and continue
            p.had_error = true
            p.error_count = p.error_count + 1
            p = p.advance()
        }

        // Parse literal value (int or float)
        var pred_int_val: i64 = 0
        var pred_float_val: f64 = 0.0
        var pred_is_float = false
        let val_tok = p.peek()
        if val_tok == TokenKind::IntLit {
            let tok = p.current()
            pred_int_val = tok.int_value
            pred_float_val = pred_int_val as f64
            p = p.advance()
        } else if val_tok == TokenKind::FloatLit {
            let tok = p.current()
            pred_float_val = tok.float_value
            pred_int_val = pred_float_val as i64
            pred_is_float = true
            p = p.advance()
        } else {
            p.had_error = true
            p.error_count = p.error_count + 1
            p = p.advance()
        }

        // Expect '}'
        p = p.expect(TokenKind::RBrace)

        let span = p.span_from(start)
        let ri = RefinementInfo {
            var_name: var_name,
            base_type: Some(Box::new(base_ty)),
            pred_op: pred_op,
            pred_int_val: pred_int_val,
            pred_float_val: pred_float_val,
            pred_is_float: pred_is_float,
        }
        (p, TypeExpr {
            kind: TypeExprKind::TypeRefinement,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: None,
            array_size: None,
            effects: None,
            knowledge_info: None,
            refinement_info: Some(Box::new(ri)),
        })
    }

    // ============================================================
    // Use declaration: use path::to::module [::*]
    // ============================================================

    fn parse_use_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'use'

        let pair = p.parse_type_path()
        p = pair.0
        let path = pair.1

        var is_glob = false
        var use_items_opt: Option<Box<ImportItemList>> = None

        if p.peek() == TokenKind::ColonColon && p.peek_ahead(1) == TokenKind::Star {
            // Glob import: use path::*
            p = p.advance()  // skip ::
            p = p.advance()  // skip *
            is_glob = true
        } else if p.peek() == TokenKind::ColonColon && p.peek_ahead(1) == TokenKind::LBrace {
            // Selective import: use path::{A, B, C}
            p = p.advance()  // skip ::
            p = p.advance()  // skip {

            // Parse comma-separated identifiers
            var rev_items: Option<Box<ImportItemList>> = None
            if p.peek() != TokenKind::RBrace {
                let first_name = p.current_name()
                p = p.advance()  // skip ident
                rev_items = Some(Box::new(ImportItemList { head: first_name, tail: None }))

                while p.peek() == TokenKind::Comma {
                    p = p.advance()  // skip ,
                    if p.peek() == TokenKind::RBrace { break }
                    let next_name = p.current_name()
                    p = p.advance()  // skip ident
                    rev_items = Some(Box::new(ImportItemList { head: next_name, tail: rev_items }))
                }
            }

            p = p.expect(TokenKind::RBrace)
            use_items_opt = reverse_import_item_list_opt(rev_items)
        }
        // Else: whole-module import (use path) — no glob, no items

        let span = p.span_from(start)
        (p, Item {
            kind: ItemKind::ItemUse,
            span: span,
            is_pub: is_pub,
            name: empty_name(),
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: path,
            use_glob: is_glob,
            use_items: use_items_opt,
            effect_def: None,
            session_decl: None,
        })
    }

    // ============================================================
    // Unit declaration: unit mg; | unit kg = 1000 * mg;
    // ============================================================

    // ============================================================
    // Effect declaration: effect Fail { fn fail(msg: string) -> ! }
    // ============================================================

    fn parse_effect_op_def(self) -> (Parser, EffectOpDef) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'fn'

        let name = p.current_name()
        p = p.expect_ident()

        p = p.expect(TokenKind::LParen)
        let pair = p.parse_param_list()
        p = pair.0
        let params_opt = pair.1
        p = p.expect(TokenKind::RParen)

        let pair2 = p.parse_optional_return_type()
        p = pair2.0
        let ret_ty = pair2.1

        let span = p.span_from(start)
        (p, EffectOpDef {
            name: name,
            params: params_opt,
            ret_ty: ret_ty,
            span: span,
        })
    }

    fn parse_effect_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'effect'

        let name = p.current_name()
        p = p.expect_ident()

        p = p.expect(TokenKind::LBrace)
        var rev_ops_opt: Option<Box<EffectOpDefList>> = None
        var op_count: i64 = 0

        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            while p.peek() == TokenKind::Semi || p.peek() == TokenKind::Newline {
                p = p.advance()
            }
            if p.peek() == TokenKind::RBrace || p.peek() == TokenKind::Eof {
                break
            }
            if p.peek() == TokenKind::Fn {
                let op_pair = p.parse_effect_op_def()
                p = op_pair.0
                rev_ops_opt = Some(Box::new(EffectOpDefList {
                    head: op_pair.1,
                    tail: rev_ops_opt,
                }))
                op_count = op_count + 1
            } else {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)
        let span = p.span_from(start)
        let edef = EffectDef {
            name: name,
            ops: reverse_effect_op_def_list_opt(rev_ops_opt),
            op_count: op_count,
            span: span,
        }

        (p, Item {
            kind: ItemKind::ItemEffect,
            span: span,
            is_pub: is_pub,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: Some(Box::new(edef)),
            session_decl: None,
        })
    }

    fn parse_unit_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()   // consume 'unit'

        // Expect unit name
        let name = p.current_name()
        p = p.advance()

        // Optional conversion: = expr ;
        var conv_ty: Option<Box<TypeExpr>> = None
        if p.peek() == TokenKind::Eq {
            p = p.advance()          // consume '='
            // Parse the conversion expression as a type expression
            // (for now, skip to semicolon — conversion is stored but not evaluated)
        }

        // Expect semicolon
        if p.peek() == TokenKind::Semi {
            p = p.advance()
        }

        let span = p.span_from(start)
        (p, Item {
            kind: ItemKind::ItemUnit,
            span: span,
            is_pub: is_pub,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
        })
    }

    // ============================================================
    // Session declaration: session Name { send T, recv T, close }
    // ============================================================

    fn parse_session_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'session'

        let name = p.current_name()
        p = p.expect_ident()

        p = p.expect(TokenKind::LBrace)

        var steps: [SessionStep; 16] = [SessionStep {
            kind: SessionStepKind::StepClose,
            msg_type: TypeExpr {
                kind: TypeExprKind::TypeUnit,
                span: start,
                path: empty_path(),
                type_args: None,
                inner: None,
                array_size: None,
                effects: None,
                knowledge_info: None,
                refinement_info: None,
            },
            span: start,
        }; 16]
        var step_count: i64 = 0

        while p.peek() != TokenKind::RBrace && p.peek() != TokenKind::Eof {
            // skip newlines/semis between steps
            while p.peek() == TokenKind::Semi || p.peek() == TokenKind::Newline {
                p = p.advance()
            }
            if p.peek() == TokenKind::RBrace || p.peek() == TokenKind::Eof {
                break
            }

            let step_start = p.current_span()

            if p.peek() == TokenKind::Send {
                p = p.advance()  // skip 'send'
                let ty_pair = p.parse_type()
                p = ty_pair.0
                let msg_ty = ty_pair.1
                if step_count < 16 {
                    steps[step_count as usize] = SessionStep {
                        kind: SessionStepKind::StepSend,
                        msg_type: msg_ty,
                        span: p.span_from(step_start),
                    }
                    step_count = step_count + 1
                }
            } else if p.peek() == TokenKind::Recv {
                p = p.advance()  // skip 'recv'
                let ty_pair = p.parse_type()
                p = ty_pair.0
                let msg_ty = ty_pair.1
                if step_count < 16 {
                    steps[step_count as usize] = SessionStep {
                        kind: SessionStepKind::StepRecv,
                        msg_type: msg_ty,
                        span: p.span_from(step_start),
                    }
                    step_count = step_count + 1
                }
            } else if p.peek() == TokenKind::Close {
                p = p.advance()  // skip 'close'
                if step_count < 16 {
                    steps[step_count as usize] = SessionStep {
                        kind: SessionStepKind::StepClose,
                        msg_type: TypeExpr {
                            kind: TypeExprKind::TypeUnit,
                            span: p.span_from(step_start),
                            path: empty_path(),
                            type_args: None,
                            inner: None,
                            array_size: None,
                            effects: None,
                            knowledge_info: None,
                            refinement_info: None,
                        },
                        span: p.span_from(step_start),
                    }
                    step_count = step_count + 1
                }
            } else {
                // skip unknown token
                p = p.advance()
            }

            // optional comma separator
            if p.peek() == TokenKind::Comma {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)

        let span = p.span_from(start)
        let sdecl = SessionDecl {
            name: name,
            steps: steps,
            step_count: step_count,
            span: span,
        }
        (p, Item {
            kind: ItemKind::ItemSession,
            span: span,
            is_pub: is_pub,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: None,
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: Some(Box::new(sdecl)),
        })
    }

    // Sprint 108: extern "C" fn name(params) -> RetType (no body)
    fn parse_extern_fn_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'extern'
        if p.peek() == TokenKind::StringLit { p = p.advance() }
        if p.peek() != TokenKind::Fn {
            let span = p.current_span()
            p.had_error = true
            p.error_count = p.error_count + 1
            p = p.advance()
            return (p, Item { kind: ItemKind::ItemFn, span: span, is_pub: is_pub, name: empty_name(), fn_def: None, struct_def: None, enum_def: None, impl_def: None, type_alias_ty: None, policy_def: None, acquisition_policy_def: None, recourse_policy_def: None, decision_policy_def: None, deferral_policy_def: None, transition_policy_def: None, transition_protocol_def: None, monitoring_policy_def: None, alternative_policy_def: None, alternative_frontier_def: None, models_def: None, validation_def: None, audit_def: None, use_path: empty_path(), use_glob: false, use_items: None, effect_def: None, session_decl: None })
        }
        p = p.advance()  // skip 'fn'
        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::LParen)
        let pair = p.parse_param_list()
        p = pair.0
        let params_opt = pair.1
        p = p.expect(TokenKind::RParen)
        let pair2 = p.parse_optional_return_type()
        p = pair2.0
        let ret_ty = pair2.1
        let span = p.span_from(start)
        let fn_def = FnDef { name: name, params: params_opt, return_type: ret_ty, effects: None, body: Block { stmts: None, span: span }, span: span, is_kernel: true }
        (p, Item { kind: ItemKind::ItemFn, span: span, is_pub: is_pub, name: name, fn_def: Some(Box::new(fn_def)), struct_def: None, enum_def: None, impl_def: None, type_alias_ty: None, policy_def: None, acquisition_policy_def: None, recourse_policy_def: None, decision_policy_def: None, deferral_policy_def: None, transition_policy_def: None, transition_protocol_def: None, monitoring_policy_def: None, alternative_policy_def: None, alternative_frontier_def: None, models_def: None, validation_def: None, audit_def: None, use_path: empty_path(), use_glob: false, use_items: None, effect_def: None, session_decl: None })
    }

    // Sprint 109: export "C" fn
    fn parse_export_fn_item(self, is_pub: bool) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        var p = self.advance()  // skip 'export'
        if p.peek() == TokenKind::StringLit { p = p.advance() }
        p.parse_fn_item(true, false)
    }

}

// ============================================================
// Linked-list helpers for item parsing
// ============================================================

fn reverse_param_list_opt(list: Option<Box<ParamList>>) -> Option<Box<ParamList>> with Mut, Alloc {
    reverse_param_list_loop(list, None)
}

fn reverse_param_list_loop(
    current: Option<Box<ParamList>>,
    acc: Option<Box<ParamList>>,
) -> Option<Box<ParamList>> with Mut, Alloc {
    match current {
        None => acc,
        Some(node) => {
            let next = (*node).tail
            let rev_node = ParamList { head: (*node).head, tail: acc }
            reverse_param_list_loop(next, Some(Box::new(rev_node)))
        },
    }
}

fn reverse_field_def_list_opt(list: Option<Box<FieldDefList>>) -> Option<Box<FieldDefList>> with Mut, Alloc {
