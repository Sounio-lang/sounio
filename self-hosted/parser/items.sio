    fn parse_alternative_policy_item(self, visibility: Visibility) -> (Parser, Item) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'alternative_policy'

        let name = p.current_name()
        p = p.expect_ident()
        p = p.expect(TokenKind::For)

        let target_pair = p.parse_type()
        p = target_pair.0
        let target_ty = target_pair.1

        var frontier_name = empty_name()
        if parser_peek(p) == TokenKind::Ident && parser_name_is_frontier(p.current_name()) {
            p = p.advance()
            frontier_name = p.current_name()
            p = p.expect_ident()
        }

        p = p.expect(TokenKind::LBrace)
        var rev_objectives_opt: Option<Box<AlternativeObjectiveDefList>> = None
        var max_options: i64 = -1

        while parser_peek(p) != TokenKind::RBrace && parser_peek(p) != TokenKind::Eof {
            while parser_peek(p) == TokenKind::Semi || parser_peek(p) == TokenKind::Newline {
                p = p.advance()
            }
            if parser_peek(p) == TokenKind::RBrace || parser_peek(p) == TokenKind::Eof {
                break
            }

            if parser_peek(p) == TokenKind::Objective {
                let obj_pair = p.parse_alternative_objective_def()
                p = obj_pair.0
                rev_objectives_opt = Some(Box::new(AlternativeObjectiveDefList {
                    head: obj_pair.1,
                    tail: rev_objectives_opt,
                }))
            } else if parser_peek(p) == TokenKind::Ident && parser_name_is_max_options(p.current_name()) {
                p = p.advance()
                if parser_peek(p) == TokenKind::IntLit {
                    max_options = p.current().int_value
                    p = p.advance()
                } else {
                    p.had_error = true
                    p.error_count = p.error_count + 1
                    p = p.advance()
                }
            } else {
                p.had_error = true
                p.error_count = p.error_count + 1
                p = p.advance()
            }

            while parser_peek(p) == TokenKind::Semi {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)

        let span = p.span_from(start)
        let apdef = AlternativePolicyDef {
            name: name,
            target_type: target_ty,
            frontier_name: frontier_name,
            objectives: reverse_alternative_objective_def_list_opt(rev_objectives_opt),
            max_options: max_options,
            span: span,
        }

        (p, Item {
            kind: ItemKind::ItemAlternativePolicy,
            span: span,
            visibility: visibility,
            name: name,
            fn_def: None,
            struct_def: None,
            enum_def: None,
            impl_def: None,
            type_alias_ty: None,
            policy_def: None,
            acquisition_policy_def: None,
            recourse_policy_def: None,
            decision_policy_def: None,
            deferral_policy_def: None,
            transition_policy_def: None,
            transition_protocol_def: None,
            monitoring_policy_def: None,
            alternative_policy_def: Some(Box::new(apdef)),
            alternative_frontier_def: None,
            models_def: None,
            validation_def: None,
            audit_def: None,
            use_path: empty_path(),
            use_glob: false,
            use_items: None,
            effect_def: None,
            session_decl: None,
            trait_def: None,
            algebra_def: None,
            study_def: None,
            ontology_def: None,
        })
    }

