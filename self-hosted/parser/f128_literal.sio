// self-hosted::parser::f128_literal — exact binary128 identity of a float literal
//
// V0-E.5.9. A float literal in an `f128` position must mean exactly what its
// source text says, or the compiler must refuse it. Before this module the
// lowerer decided that from the literal's binary64 value against an 8-entry
// table (0, ±1, 2, 3, 0.5, 1.5, 0.25) — `4.0` was refused, and a C99 hex-float
// (`0x1.8p+0`) reached the table as the parser's placeholder magnitude and was
// silently lowered as that placeholder.
//
// This module reads the literal's SOURCE BYTES once, in the parser, and produces
// the binary128 limbs directly:
//   decimal  d.ddd e±N  → value = D · 10^dexp with D the exact digit string
//   hex      0xh.hhh p±N → value = H · 2^bexp
// The value is exact iff it is a dyadic rational whose odd part fits 113 bits
// and whose binary exponent lands in the finite binary128 range (subnormals
// included when no bit is lost). Everything else — 0.1, 2.5e-3, a 29-hex-digit
// mantissa, an exponent past 16383 — comes back `exact = false`, and every f128
// consumer fails closed on that flag. No f64 is read or produced on this path.
//
// The identity is carried on `Expr.f128_lit_lo / f128_lit_hi / f128_lit_exact`
// (parser/ast.sio), never in a side table keyed by value or name.
//
// Arithmetic is on four 32-bit words held in i64 (w0 = least significant),
// the same idiom as stdlib/math/softfloat_f128.sio, so no operation relies on
// unsigned i64 semantics. Helpers take scalars only (lean_single seed: struct
// arguments are not safe in this tier).
module parser::f128_literal

use lexer::cursor::*

pub struct F128Lit {
    lo: i64,
    hi: i64,
    exact: bool,
}

// 128-bit unsigned integer as four 32-bit words (w0 least significant).
pub struct F128LitWords {
    w0: i64,
    w1: i64,
    w2: i64,
    w3: i64,
    overflow: bool,
}

fn f128lit_inexact() -> F128Lit {
    F128Lit { lo: 0, hi: 0, exact: false }
}

fn f128lit_zero() -> F128Lit {
    F128Lit { lo: 0, hi: 0, exact: true }
}

fn f128lit_mask32(x: i64) -> i64 {
    x & 4294967295
}

// W * m + add, m and add small (m <= 16, add < 16). overflow = carry out of bit 127.
fn f128lit_words_mul_small(w0: i64, w1: i64, w2: i64, w3: i64, m: i64, add: i64) -> F128LitWords {
    let p0 = w0 * m + add
    let r0 = f128lit_mask32(p0)
    let c0 = p0 >> 32
    let p1 = w1 * m + c0
    let r1 = f128lit_mask32(p1)
    let c1 = p1 >> 32
    let p2 = w2 * m + c1
    let r2 = f128lit_mask32(p2)
    let c2 = p2 >> 32
    let p3 = w3 * m + c2
    let r3 = f128lit_mask32(p3)
    let c3 = p3 >> 32
    F128LitWords { w0: r0, w1: r1, w2: r2, w3: r3, overflow: c3 != 0 }
}

// W / 5 with remainder; overflow field carries `remainder != 0`.
fn f128lit_words_div5(w0: i64, w1: i64, w2: i64, w3: i64) -> F128LitWords with Div {
    var r: i64 = 0
    let n3 = r * 4294967296 + w3
    let q3 = n3 / 5
    r = n3 - q3 * 5
    let n2 = r * 4294967296 + w2
    let q2 = n2 / 5
    r = n2 - q2 * 5
    let n1 = r * 4294967296 + w1
    let q1 = n1 / 5
    r = n1 - q1 * 5
    let n0 = r * 4294967296 + w0
    let q0 = n0 / 5
    r = n0 - q0 * 5
    F128LitWords { w0: q0, w1: q1, w2: q2, w3: q3, overflow: r != 0 }
}

// W >> 1 (logical). overflow carries the bit shifted out.
fn f128lit_words_shr1(w0: i64, w1: i64, w2: i64, w3: i64) -> F128LitWords {
    let out = w0 & 1
    let r0 = (w0 >> 1) | ((w1 & 1) << 31)
    let r1 = (w1 >> 1) | ((w2 & 1) << 31)
    let r2 = (w2 >> 1) | ((w3 & 1) << 31)
    let r3 = w3 >> 1
    F128LitWords { w0: r0, w1: r1, w2: r2, w3: r3, overflow: out != 0 }
}

// W << 1. overflow carries the bit shifted out of bit 127.
fn f128lit_words_shl1(w0: i64, w1: i64, w2: i64, w3: i64) -> F128LitWords {
    let out = (w3 >> 31) & 1
    let r3 = f128lit_mask32((w3 << 1) | ((w2 >> 31) & 1))
    let r2 = f128lit_mask32((w2 << 1) | ((w1 >> 31) & 1))
    let r1 = f128lit_mask32((w1 << 1) | ((w0 >> 31) & 1))
    let r0 = f128lit_mask32(w0 << 1)
    F128LitWords { w0: r0, w1: r1, w2: r2, w3: r3, overflow: out != 0 }
}

fn f128lit_word_bit_length(w: i64) -> i64 {
    var n: i64 = 0
    var x = w
    while x != 0 {
        x = x >> 1
        n = n + 1
    }
    n
}

// Number of significant bits of W (0 for zero).
fn f128lit_words_bit_length(w0: i64, w1: i64, w2: i64, w3: i64) -> i64 {
    if w3 != 0 { return 96 + f128lit_word_bit_length(w3) }
    if w2 != 0 { return 64 + f128lit_word_bit_length(w2) }
    if w1 != 0 { return 32 + f128lit_word_bit_length(w1) }
    f128lit_word_bit_length(w0)
}

// value = W · 2^bexp, W != 0. Produces the exact binary128 encoding or
// `exact = false` when the value would need rounding (odd part wider than
// 113 bits, exponent past the finite range, or subnormal bits lost).
fn f128lit_pack(w0_in: i64, w1_in: i64, w2_in: i64, w3_in: i64, bexp_in: i64) -> F128Lit with Mut, Panic, Div {
    var w0 = w0_in
    var w1 = w1_in
    var w2 = w2_in
    var w3 = w3_in
    var bexp = bexp_in
    if w0 == 0 && w1 == 0 && w2 == 0 && w3 == 0 {
        return f128lit_zero()
    }
    // Strip factors of two: W = odd · 2^t.
    while (w0 & 1) == 0 {
        let s = f128lit_words_shr1(w0, w1, w2, w3)
        w0 = s.w0
        w1 = s.w1
        w2 = s.w2
        w3 = s.w3
        bexp = bexp + 1
    }
    let len = f128lit_words_bit_length(w0, w1, w2, w3)
    if len > 113 {
        return f128lit_inexact()
    }
    // Normalise: msb to bit 112. value = 1.f · 2^(bexp + len - 1).
    var shifts = 113 - len
    while shifts > 0 {
        let s = f128lit_words_shl1(w0, w1, w2, w3)
        w0 = s.w0
        w1 = s.w1
        w2 = s.w2
        w3 = s.w3
        shifts = shifts - 1
    }
    let unbiased = bexp + len - 1
    var biased = unbiased + 16383
    if biased >= 32767 {
        return f128lit_inexact()
    }
    if biased <= 0 {
        // Subnormal: exponent field 0, mantissa = value · 2^16494. Shift the
        // 113-bit significand right by (1 - biased); every bit shifted out
        // must be zero or the literal is not exactly representable.
        var down = 1 - biased
        if down > 113 {
            return f128lit_inexact()
        }
        while down > 0 {
            let s = f128lit_words_shr1(w0, w1, w2, w3)
            if s.overflow {
                return f128lit_inexact()
            }
            w0 = s.w0
            w1 = s.w1
            w2 = s.w2
            w3 = s.w3
            down = down - 1
        }
        biased = 0
    }
    // Pack: bits 0..63 → lo; bits 64..111 → hi[0..48); implicit bit 112 dropped.
    let lo = w0 | (w1 << 32)
    let hi_mant = w2 | ((w3 & 65535) << 32)
    let hi = hi_mant | (biased << 48)
    F128Lit { lo: lo, hi: hi, exact: true }
}

fn f128lit_is_digit(ch: i8) -> bool {
    ch >= (48 as i8) && ch <= (57 as i8)
}

fn f128lit_hex_digit_value(ch: i8) -> i64 {
    if ch >= (48 as i8) && ch <= (57 as i8) { return (ch - (48 as i8)) as i64 }
    if ch >= (97 as i8) && ch <= (102 as i8) { return (ch - (97 as i8)) as i64 + 10 }
    if ch >= (65 as i8) && ch <= (70 as i8) { return (ch - (65 as i8)) as i64 + 10 }
    0 - 1
}

// Decimal literal text [start, end): digits [. digits] [e|E [+|-] digits].
// Underscores are separators. Parsing stops at the first byte that is not
// part of the number (a type suffix, for instance).
fn f128lit_from_decimal(start: i64, end: i64) -> F128Lit with Mut, Panic, Div {
    var w0: i64 = 0
    var w1: i64 = 0
    var w2: i64 = 0
    var w3: i64 = 0
    var dexp: i64 = 0
    var seen_dot = false
    var any_digit = false
    var i = start
    while i < end {
        let ch = cursor_source_byte(i)
        if ch == (95 as i8) {
            i = i + 1
            continue
        }
        if ch == (46 as i8) && !seen_dot {
            seen_dot = true
            i = i + 1
            continue
        }
        if f128lit_is_digit(ch) {
            any_digit = true
            let d = (ch - (48 as i8)) as i64
            let m = f128lit_words_mul_small(w0, w1, w2, w3, 10, d)
            if m.overflow {
                // The digit string is wider than 128 bits. A zero digit before
                // the point is an exact power-of-ten shift; a zero after the
                // point adds nothing; any other digit is information we cannot
                // hold, so the literal is not exactly representable here.
                if d != 0 {
                    return f128lit_inexact()
                }
                if !seen_dot { dexp = dexp + 1 }
            } else {
                w0 = m.w0
                w1 = m.w1
                w2 = m.w2
                w3 = m.w3
                if seen_dot { dexp = dexp - 1 }
            }
            i = i + 1
            continue
        }
        break
    }
    if !any_digit {
        return f128lit_inexact()
    }
    if i < end && (cursor_source_byte(i) == (101 as i8) || cursor_source_byte(i) == (69 as i8)) {
        i = i + 1
        var neg = false
        if i < end && cursor_source_byte(i) == (45 as i8) {
            neg = true
            i = i + 1
        } else if i < end && cursor_source_byte(i) == (43 as i8) {
            i = i + 1
        }
        var ev: i64 = 0
        var exp_digits = false
        while i < end {
            let ch2 = cursor_source_byte(i)
            if ch2 == (95 as i8) {
                i = i + 1
                continue
            }
            if !f128lit_is_digit(ch2) { break }
            exp_digits = true
            if ev < 100000 {
                ev = ev * 10 + ((ch2 - (48 as i8)) as i64)
            }
            i = i + 1
        }
        if !exp_digits {
            return f128lit_inexact()
        }
        if neg { dexp = dexp - ev } else { dexp = dexp + ev }
    }
    if w0 == 0 && w1 == 0 && w2 == 0 && w3 == 0 {
        return f128lit_zero()
    }
    // value = W · 10^dexp = W · 5^dexp · 2^dexp.
    var bexp: i64 = dexp
    if dexp < 0 {
        var d = 0 - dexp
        while d > 0 {
            let q = f128lit_words_div5(w0, w1, w2, w3)
            if q.overflow {
                // 5 does not divide W: the value is not a dyadic rational.
                return f128lit_inexact()
            }
            w0 = q.w0
            w1 = q.w1
            w2 = q.w2
            w3 = q.w3
            d = d - 1
        }
    } else {
        var u = dexp
        while u > 0 {
            let m = f128lit_words_mul_small(w0, w1, w2, w3, 5, 0)
            if m.overflow {
                // Odd part already past 128 bits (> 113 either way).
                return f128lit_inexact()
            }
            w0 = m.w0
            w1 = m.w1
            w2 = m.w2
            w3 = m.w3
            u = u - 1
        }
    }
    f128lit_pack(w0, w1, w2, w3, bexp)
}

// C99 hex-float text [start, end): 0x|0X hexdigits [. hexdigits] p|P [+|-] digits.
// Underscores are separators. Stops at the first byte after the exponent digits.
fn f128lit_from_hex(start: i64, end: i64) -> F128Lit with Mut, Panic, Div {
    var i = start + 2
    var w0: i64 = 0
    var w1: i64 = 0
    var w2: i64 = 0
    var w3: i64 = 0
    var bexp: i64 = 0
    var seen_dot = false
    var any_digit = false
    while i < end {
        let ch = cursor_source_byte(i)
        if ch == (95 as i8) {
            i = i + 1
            continue
        }
        if ch == (46 as i8) && !seen_dot {
            seen_dot = true
            i = i + 1
            continue
        }
        let hv = f128lit_hex_digit_value(ch)
        if hv < 0 { break }
        any_digit = true
        let m = f128lit_words_mul_small(w0, w1, w2, w3, 16, hv)
        if m.overflow {
            if hv != 0 {
                return f128lit_inexact()
            }
            if !seen_dot { bexp = bexp + 4 }
        } else {
            w0 = m.w0
            w1 = m.w1
            w2 = m.w2
            w3 = m.w3
            if seen_dot { bexp = bexp - 4 }
        }
        i = i + 1
    }
    if !any_digit {
        return f128lit_inexact()
    }
    if i < end && (cursor_source_byte(i) == (112 as i8) || cursor_source_byte(i) == (80 as i8)) {
        i = i + 1
        var neg = false
        if i < end && cursor_source_byte(i) == (45 as i8) {
            neg = true
            i = i + 1
        } else if i < end && cursor_source_byte(i) == (43 as i8) {
            i = i + 1
        }
        var ev: i64 = 0
        var exp_digits = false
        while i < end {
            let ch2 = cursor_source_byte(i)
            if ch2 == (95 as i8) {
                i = i + 1
                continue
            }
            if !f128lit_is_digit(ch2) { break }
            exp_digits = true
            if ev < 100000 {
                ev = ev * 10 + ((ch2 - (48 as i8)) as i64)
            }
            i = i + 1
        }
        if !exp_digits {
            return f128lit_inexact()
        }
        if neg { bexp = bexp - ev } else { bexp = bexp + ev }
    } else {
        // A hex-float without a binary exponent is not a float literal we
        // recognise; refuse rather than guess.
        return f128lit_inexact()
    }
    if w0 == 0 && w1 == 0 && w2 == 0 && w3 == 0 {
        return f128lit_zero()
    }
    f128lit_pack(w0, w1, w2, w3, bexp)
}

// Exact binary128 identity of the float literal whose source text is
// [start, end). Dispatches on a `0x`/`0X` prefix.
pub fn f128_literal_from_source(start: i64, end: i64) -> F128Lit with Mut, Panic, Div {
    if end <= start {
        return f128lit_inexact()
    }
    if end > start + 1 {
        let b0 = cursor_source_byte(start)
        let b1 = cursor_source_byte(start + 1)
        if b0 == (48 as i8) && (b1 == (120 as i8) || b1 == (88 as i8)) {
            return f128lit_from_hex(start, end)
        }
    }
    f128lit_from_decimal(start, end)
}
