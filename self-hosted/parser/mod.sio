// Parser — entry point
//
// Top-level parse function: tokens -> Program (list of items).
// Orchestrates the full parsing pipeline.

fn parse_program(tokens: [Token; 65536], token_count: i64) -> Program with Mut, IO, Panic, Div, Alloc {
    var p = parser_new()

    // Copy tokens into parser
    var i: i64 = 0
    while i < token_count && i < 65536 {
        p.tokens[i] = tokens[i]
        i = i + 1
    }
    p.token_count = token_count

    // Skip leading newlines
    while p.pos < p.token_count && p.tokens[p.pos].kind == TokenKind::Newline {
        p.pos = p.pos + 1
    }

    // Parse items until EOF
    var items_opt: Option<Box<ItemList>> = None
    var first_item = true

    while !p.at_eof() {
        // Skip doc comments for now (attach to next item in future)
        while tk_is_doc_comment(p.peek()) {
            p = p.advance()
        }

        if p.at_eof() { break }

        let (p2, item) = p.parse_item()
        p = p2

        if first_item {
            items_opt = Some(Box::new(ItemList { head: item, tail: None }))
            first_item = false
        } else {
            match items_opt {
                Some(list) => {
                    let new_node = ItemList { head: item, tail: None }
                    items_opt = Some(Box::new(item_list_append(*list, new_node)))
                },
                None => {
                    items_opt = Some(Box::new(ItemList { head: item, tail: None }))
                },
            }
        }
    }

    Program { items: items_opt }
}

// ============================================================
// Utility: count items in a program
// ============================================================

fn count_items(prog: Program) -> i64 {
    match prog.items {
        None => 0,
        Some(list) => count_item_list(*list),
    }
}

fn count_item_list(list: ItemList) -> i64 {
    match list.tail {
        None => 1,
        Some(rest) => 1 + count_item_list(*rest),
    }
}
