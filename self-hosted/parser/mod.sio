// Parser — entry point
//
// Top-level parse function: tokens -> Program (list of items).
// Orchestrates the full parsing pipeline.

module parser::mod

use parser::ast::*
use lexer::token::*
use parser::parser::{parser_peek, parser_at_eof, pt_read_kind, parser_new, parser_reset_last_errors, parser_reset_truncated_literals, parser_set_last_errors, parser_set_tokens, parser_truncated_literal_count, parser_truncated_literal_first_line, parser_truncated_literal_longest}
use parser::types::*
use parser::exprs::*
use parser::stmts::*
use parser::items::*

fn parse_program_loop(mut_p: Parser) -> Program with Mut, IO, Panic, Div, Alloc {
    var p = mut_p
    var rev_items_opt: Option<Box<ItemList>> = None
    parser_reset_extern_block_state()

    while !parser_at_eof(p) {
        // Skip leading trivia (newlines, semicolons, doc comments)
        while parser_peek(p) == TokenKind::Newline || parser_peek(p) == TokenKind::Semi { p = p.advance() }
        while tk_is_doc_comment(parser_peek(p)) { p = p.advance() }
        if parser_at_eof(p) { break }

        let before_pos = p.pos
        let result = p.parse_item()
        let p2 = result.0
        let item = result.1

        // Hard progress guard: a parser error must never stall the top-level loop.
        if p2.pos <= before_pos {
            p = p2.advance()
        } else {
            p = p2
        }
        // Claims are compile-time metadata: parse_claim_item already recorded
        // them in the AST claim registry, so drop them from the item stream.
        // Resolve/check/lower/codegen never observe ItemKind::ItemClaim.
        if item.kind != ItemKind::ItemClaim {
            rev_items_opt = Some(Box::new(ItemList { head: item, tail: rev_items_opt }))
        }
    }

    parser_set_last_errors(p.had_error, p.error_count)
    // Silent data loss, said out loud. A string literal past Name's 128-byte
    // buffer is cut at current_name() and the program runs on with the short
    // one; before this the only way to notice was to compare the output by hand.
    Program { module_path: empty_path(), items: reverse_item_list_opt(rev_items_opt) }
}

fn parse_program(tokens: [Token; 2097152], token_count: i64) -> Program with Mut, IO, Panic, Div, Alloc {
    parser_reset_last_errors()
    parser_reset_truncated_literals()
    var p = parser_new()

    // Load tokens into module-global parser storage.
    parser_set_tokens(tokens, token_count)
    p.token_count = token_count
    parse_program_loop(p)
}

pub fn parse_program_preloaded(token_count: i64) -> Program with Mut, IO, Panic, Div, Alloc {
    parser_reset_last_errors()
    parser_reset_truncated_literals()
    var p = parser_new()
    p.token_count = token_count
    let prog = parse_program_loop(p)
    prog
}

// boot4-safe entry point: returns Option<Box<ItemList>> directly (≤2 slots).
// Avoids constructing the full Program struct (134+ slots → IS_SPTR=4 hang).
fn parse_items_loop(mut_p: Parser) -> Option<Box<ItemList>> with Mut, IO, Panic, Div, Alloc {
    var p = mut_p
    var rev_items_opt: Option<Box<ItemList>> = None
    parser_reset_extern_block_state()
    while !parser_at_eof(p) {
        while parser_peek(p) == TokenKind::Newline || parser_peek(p) == TokenKind::Semi { p = p.advance() }
        while tk_is_doc_comment(parser_peek(p)) { p = p.advance() }
        if parser_at_eof(p) { break }
        let before_pos = p.pos
        let result = p.parse_item()
        let p2 = result.0
        let item = result.1
        if p2.pos <= before_pos { p = p2.advance() } else { p = p2 }
        // See parse_program_loop: claims are metadata, dropped from the stream.
        if item.kind != ItemKind::ItemClaim {
            rev_items_opt = Some(Box::new(ItemList { head: item, tail: rev_items_opt }))
        }
    }
    parser_set_last_errors(p.had_error, p.error_count)
    if parser_truncated_literal_count() > 0 {
        print("warning: ")
        print_int(parser_truncated_literal_count())
        print(" string literal(s) TRUNCATED; first at line ")
        print_int(parser_truncated_literal_first_line())
        print(", longest ")
        print_int(parser_truncated_literal_longest())
        print(" bytes. Name holds 128 including quotes, so the text past 126\n")
        print("         characters is gone -- silently, at run time.\n")
    }
    // Silent data loss, said out loud. A string literal past Name's 128-byte
    // buffer is cut at current_name() and the program runs on with the short
    // one; before this the only way to notice was to compare the output by hand.
    reverse_item_list_opt(rev_items_opt)
}

pub fn parse_items_preloaded(token_count: i64) -> Option<Box<ItemList>> with Mut, IO, Panic, Div, Alloc {
    parser_reset_last_errors()
    parser_reset_truncated_literals()
    if GLOBAL_VAR_INIT_SUPPRESS_RESET == 0 {
        ast_reset_global_var_inits()
        items_reset_pure_fn_reg()
        ast_reset_claims()
    }
    var p = parser_new()
    p.token_count = token_count
    parse_items_loop(p)
}

// ============================================================
// Utility: count items in a program
// ============================================================

pub fn count_items(prog: Program) -> i64 {
    match prog.items {
        None => 0,
        Some(list) => count_item_list(*list),
    }
}

fn count_item_list(list: ItemList) -> i64 {
    match list.tail {
        None => 1,
        Some(rest) => 1 + count_item_list(*rest),
    }
}

// ============================================================
// Internal list helpers
// ============================================================

fn reverse_item_list_opt(items: Option<Box<ItemList>>) -> Option<Box<ItemList>> with Mut, Alloc {
    reverse_item_list_loop(items, None)
}

fn reverse_item_list_loop(
    current: Option<Box<ItemList>>,
    acc: Option<Box<ItemList>>,
) -> Option<Box<ItemList>> with Mut, Alloc {
    match current {
        None => acc,
        Some(node) => {
            let next = (*node).tail
            let rev_node = ItemList { head: (*node).head, tail: acc }
            reverse_item_list_loop(next, Some(Box::new(rev_node)))
        },
    }
}
