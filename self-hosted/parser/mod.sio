// Parser — entry point
//
// Top-level parse function: tokens -> Program (list of items).
// Orchestrates the full parsing pipeline.

module parser::mod

use parser::ast::*
use lexer::token::*

fn parse_program_loop(mut_p: Parser) -> Program with Mut, IO, Panic, Div, Alloc {
    var p = mut_p

    // Parse items until EOF
    // Build item list in reverse (O(1) cons), then reverse once at the end.
    var rev_items_opt: Option<Box<ItemList>> = None

    while !p.at_eof() {
        // Skip trivia between items.
        while p.peek() == TokenKind::Newline || p.peek() == TokenKind::Semi {
            p = p.advance()
        }

        // Skip doc comments for now (attach to next item in future)
        while tk_is_doc_comment(p.peek()) {
            p = p.advance()
        }

        if p.at_eof() { break }

        let before_pos = p.pos
        let result = p.parse_item()
        let p2 = result.0
        let item = result.1

        // Hard progress guard: a parser error must never stall the top-level loop.
        if p2.pos <= before_pos {
            p = p2.advance()
        } else {
            p = p2
        }

        rev_items_opt = Some(Box::new(ItemList { head: item, tail: rev_items_opt }))
    }

    parser_set_last_errors(p.had_error, p.error_count)
    Program { module_path: empty_path(), items: reverse_item_list_opt(rev_items_opt) }
}

fn parse_program(tokens: [Token; 65536], token_count: i64) -> Program with Mut, IO, Panic, Div, Alloc {
    parser_reset_last_errors()
    var p = parser_new()

    // Load tokens into module-global parser storage.
    parser_set_tokens(tokens, token_count)
    p.token_count = token_count
    parse_program_loop(p)
}

fn parse_program_preloaded(token_count: i64) -> Program with Mut, IO, Panic, Div, Alloc {
    parser_reset_last_errors()
    var p = parser_new()
    p.token_count = token_count
    parse_program_loop(p)
}

// ============================================================
// Utility: count items in a program
// ============================================================

fn count_items(prog: Program) -> i64 {
    match prog.items {
        None => 0,
        Some(list) => count_item_list(*list),
    }
}

fn count_item_list(list: ItemList) -> i64 {
    match list.tail {
        None => 1,
        Some(rest) => 1 + count_item_list(*rest),
    }
}

// ============================================================
// Internal list helpers
// ============================================================

fn reverse_item_list_opt(items: Option<Box<ItemList>>) -> Option<Box<ItemList>> with Mut, Alloc {
    reverse_item_list_loop(items, None)
}

fn reverse_item_list_loop(
    current: Option<Box<ItemList>>,
    acc: Option<Box<ItemList>>,
) -> Option<Box<ItemList>> with Mut, Alloc {
    match current {
        None => acc,
        Some(node) => {
            let next = (*node).tail
            let rev_node = ItemList { head: (*node).head, tail: acc }
            reverse_item_list_loop(next, Some(Box::new(rev_node)))
        },
    }
}
