// Parser — type expression parsing
//
// Handles: named types, references, arrays, tuples, function types,
// generic arguments, and effect lists.

use parser::ast::*
use lexer::token::*
use parser::parser::{parser_peek, parser_at_eof, pt_read_kind, parser_peek_ahead, mk_expr, error_expr, dummy_type_expr, parser_take_expr_box}
use parser::exprs::{parse_expr_entry}

impl Parser {
    // ============================================================
    // Type expression entry point
    // ============================================================

    fn parse_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div {
        let k = self.peek()

        if k == TokenKind::Amp {
            self.parse_ref_type()
        } else if k == TokenKind::AmpBang {
            self.parse_ref_mut_type()
        } else if k == TokenKind::LBracket {
            self.parse_array_type()
        } else if k == TokenKind::LBrace {
            self.parse_refinement_type()
        } else if k == TokenKind::LParen {
            self.parse_tuple_or_fn_type()
        } else if k == TokenKind::Bang {
            let span = self.current_span()
            let p = self.advance()
            (p, TypeExpr {
                kind: TypeExprKind::TypeNever,
                span: span,
                path: empty_path(),
                type_args: None,
                inner: None,
                array_size: None,
                effects: None,
                knowledge_info: None,
                refinement_info: None,
            })
        } else if k == TokenKind::SelfUpper {
            let span = self.current_span()
            let p = self.advance()
            (p, TypeExpr {
                kind: TypeExprKind::TypeSelfUpper,
                span: span,
                path: empty_path(),
                type_args: None,
                inner: None,
                array_size: None,
                effects: None,
                knowledge_info: None,
                refinement_info: None,
            })
        } else if k == TokenKind::Underscore {
            let span = self.current_span()
            let p = self.advance()
            (p, TypeExpr {
                kind: TypeExprKind::TypeInfer,
                span: span,
                path: empty_path(),
                type_args: None,
                inner: None,
                array_size: None,
                effects: None,
                knowledge_info: None,
                refinement_info: None,
            })
        } else if k == TokenKind::Fn {
            self.parse_fn_type()
        } else if k == TokenKind::Knowledge {
            self.parse_knowledge_type()
        } else if k == TokenKind::Forgettable {
            self.parse_forgettable_type()
        } else if k == TokenKind::ExactlyPrivate {
            self.parse_exactly_private_type()
        } else if k == TokenKind::Editable {
            self.parse_editable_type()
        } else if k == TokenKind::CapabilityGated {
            self.parse_capability_gated_type()
        } else if k == TokenKind::Composable {
            self.parse_composable_type()
        } else if k == TokenKind::Audited {
            self.parse_audited_type()
        } else if k == TokenKind::Revivable {
            self.parse_revivable_type()
        } else if k == TokenKind::Interpretable {
            self.parse_interpretable_type()
        } else if k == TokenKind::Model {
            self.parse_generic_wrapper_type(TypeExprKind::TypeModel)
        } else if k == TokenKind::Policy {
            self.parse_generic_wrapper_type(TypeExprKind::TypePolicy)
        } else if k == TokenKind::AcquisitionPolicy {
            self.parse_generic_wrapper_type(TypeExprKind::TypeAcquisitionPolicy)
        } else if k == TokenKind::AcquisitionPlan {
            self.parse_generic_wrapper_type(TypeExprKind::TypeAcquisitionPlan)
        } else if k == TokenKind::AlternativePolicy {
            self.parse_generic_wrapper_type(TypeExprKind::TypeAlternativePolicy)
        } else if k == TokenKind::AlternativeSet {
            self.parse_generic_wrapper_type(TypeExprKind::TypeAlternativeSet)
        } else if k == TokenKind::AlternativeOption {
            self.parse_generic_wrapper_type(TypeExprKind::TypeAlternativeOption)
        } else if k == TokenKind::RecoursePolicy {
            self.parse_generic_wrapper_type(TypeExprKind::TypeRecoursePolicy)
        } else if k == TokenKind::RecoursePlan {
            self.parse_generic_wrapper_type(TypeExprKind::TypeRecoursePlan)
        } else if k == TokenKind::TransitionPolicy {
            self.parse_generic_wrapper_type(TypeExprKind::TypeTransitionPolicy)
        } else if k == TokenKind::TransitionPlan {
            self.parse_generic_wrapper_type(TypeExprKind::TypeTransitionPlan)
        } else if k == TokenKind::MonitoringPolicy {
            self.parse_generic_wrapper_type(TypeExprKind::TypeMonitoringPolicy)
        } else if k == TokenKind::ObservedTransition {
            self.parse_generic_wrapper_type(TypeExprKind::TypeObservedTransition)
        } else if k == TokenKind::RollbackCertificate {
            self.parse_generic_wrapper_type(TypeExprKind::TypeRollbackCertificate)
        } else if k == TokenKind::DecisionPolicy {
            self.parse_generic_wrapper_type(TypeExprKind::TypeDecisionPolicy)
        } else if k == TokenKind::DeferralPolicy {
            self.parse_generic_wrapper_type(TypeExprKind::TypeDeferralPolicy)
        } else if k == TokenKind::Contest {
            self.parse_generic_wrapper_type(TypeExprKind::TypeContest)
        } else if k == TokenKind::Robust {
            self.parse_generic_wrapper_type(TypeExprKind::TypeRobust)
        } else if k == TokenKind::Intervention {
            self.parse_epistemic_wrapper_type(TypeExprKind::TypeIntervention)
        } else if k == TokenKind::Counterfactual {
            self.parse_epistemic_wrapper_type(TypeExprKind::TypeCounterfactual)
        } else if k == TokenKind::Validated {
            self.parse_validated_type()
        } else if k == TokenKind::Admissible {
            self.parse_generic_wrapper_type(TypeExprKind::TypeAdmissible)
        } else if k == TokenKind::Deferred {
            self.parse_generic_wrapper_type(TypeExprKind::TypeDeferred)
        } else if k == TokenKind::Chan {
            self.parse_chan_type()
        // Sprint 27: Annotation syntax for epistemic types
        } else if k == TokenKind::DiffPrivate {
            self.parse_generic_wrapper_type(TypeExprKind::TypeDiffPrivate)
        } else if k == TokenKind::DPBudget {
            self.parse_generic_wrapper_type(TypeExprKind::TypeDPBudget)
        } else if k == TokenKind::CausalEffect {
            self.parse_generic_wrapper_type(TypeExprKind::TypeCausalEffect)
        } else if k == TokenKind::Aleatoric {
            self.parse_generic_wrapper_type(TypeExprKind::TypeAleatoric)
        } else if k == TokenKind::PotentialOutcome {
            self.parse_generic_wrapper_type(TypeExprKind::TypePotentialOutcome)
        } else if k == TokenKind::Proof {
            self.parse_generic_wrapper_type(TypeExprKind::TypeProof)
        } else if k == TokenKind::Lemma {
            self.parse_generic_wrapper_type(TypeExprKind::TypeLemma)
        } else if k == TokenKind::Axiom {
            self.parse_generic_wrapper_type(TypeExprKind::TypeAxiom)
        } else {
            // Named type (possibly with :: path and <> generic args)
            self.parse_named_type()
        }
    }

    // ============================================================
    // Named type: Foo, Foo::Bar, Option<Box<T>>
    // ============================================================

    fn parse_named_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div {
        let start = self.current_span()
        let pair = self.parse_type_path()
        let p1 = pair.0
        let path = pair.1

        // Inline peek() logic to avoid method-call codegen issues on SIZE_HINT-typed p1.
        // pair.0 loses the Parser type hash (SIZE_HINT_SENTINEL), so p1.peek() dispatches
        // incorrectly. Use field accesses + pt_read_kind (free fn) instead.
        let p1_peek_kind: TokenKind = if p1.pending_gt > 0 {
            TokenKind::Gt
        } else if p1.pos < p1.token_count {
            pt_read_kind(p1.pos)
        } else {
            TokenKind::Eof
        }

        // Check for generic arguments <T, U>
        if p1_peek_kind == TokenKind::Lt {
            let pair2 = p1.parse_type_args()
            // Inline span_from to avoid SIZE_HINT method-call issues on pair2.0
            let p2 = pair2.0
            let p2_end: i64 = if p2.pos < p2.token_count { PT_END[p2.pos as usize] } else { start.end }
            let span = Span { file_id: start.file_id, start: start.start, end: p2_end }
            (pair2.0, TypeExpr {
                kind: TypeExprKind::TypeNamed,
                span: span,
                path: path,
                type_args: Some(Box::new(pair2.1)),
                inner: None,
                array_size: None,
                effects: None,
                knowledge_info: None,
                refinement_info: None,
            })
        } else {
            // Inline span_from to avoid SIZE_HINT method-call issues on p1
            let p1_end: i64 = if p1.pos < p1.token_count { PT_END[p1.pos as usize] } else { start.end }
            let span = Span { file_id: start.file_id, start: start.start, end: p1_end }
            (p1, TypeExpr {
                kind: TypeExprKind::TypeNamed,
                span: span,
                path: path,
                type_args: None,
                inner: None,
                array_size: None,
                effects: None,
                knowledge_info: None,
                refinement_info: None,
            })
        }
    }

    // ============================================================
    // Type path: Foo or Foo::Bar::Baz
    // ============================================================

    fn parse_type_path(self) -> (Parser, AstPath) with Mut, IO, Panic, Div, Alloc {
        let name = self.current_name()
        var p = self.advance()
        var rev_segs = StringList { head_buf: name.buf, head_len: name.len, tail: None }
        var count: i64 = 1
        // Avoid p.peek_ahead() method call — use free fn parser_peek_ahead.
        // Also restructure: check first part of && without calling peek_ahead in condition.
        while parser_peek(p) == TokenKind::ColonColon {
            let next_k = parser_peek_ahead(p, 1)
            if !(next_k == TokenKind::Ident || tk_is_keyword(next_k)) { break }
            p = p.advance()  // skip ::
            let seg_name = p.current_name()
            rev_segs = StringList {
                head_buf: seg_name.buf,
                head_len: seg_name.len,
                tail: Some(Box::new(rev_segs)),
            }
            count = count + 1
            p = p.advance()  // skip ident
        }

        // For single-segment paths (common case), skip reversal entirely
        // to avoid passing large StringList structs by value (IS_SPTR issue).
        if count == 1 {
            (p, AstPath { segments: rev_segs, seg_count: count })
        } else {
            let segs = reverse_string_list(rev_segs)
            (p, AstPath { segments: segs, seg_count: count })
        }
    }

    // ============================================================
    // Generic arguments: <T, U, V>
    // ============================================================

    fn parse_type_args(self) -> (Parser, TypeExprList) with Mut, IO, Panic, Div, Alloc {
        var p = self.advance()  // skip <
        let pair = p.parse_type()
        p = pair.0
        let first_ty = pair.1
        var rev_list = TypeExprList { head: first_ty, tail: None }

        while parser_peek(p) == TokenKind::Comma {
            p = p.advance()  // skip ,
            let pair2 = p.parse_type()
            p = pair2.0
            let next_ty = pair2.1
            rev_list = TypeExprList { head: next_ty, tail: Some(Box::new(rev_list)) }
        }

        p = p.expect(TokenKind::Gt)
        (p, reverse_type_expr_list(rev_list))
    }

    // ============================================================
    // Reference type: &T
    // ============================================================

    fn parse_ref_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div {
        let start = self.current_span()
        var p = self.advance()  // skip &
        let pair = p.parse_type()
        p = pair.0
        let inner_ty = pair.1
        let span = p.span_from(start)
        (p, TypeExpr {
            kind: TypeExprKind::TypeReference,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: Some(Box::new(inner_ty)),
            array_size: None,
            effects: None,
            knowledge_info: None,
            refinement_info: None,
        })
    }

    // ============================================================
    // Exclusive reference type: &!T
    // ============================================================

    fn parse_ref_mut_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div {
        let start = self.current_span()
        var p = self.advance()  // skip &!
        let pair = p.parse_type()
        p = pair.0
        let inner_ty = pair.1
        let span = p.span_from(start)
        (p, TypeExpr {
            kind: TypeExprKind::TypeRefMut,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: Some(Box::new(inner_ty)),
            array_size: None,
            effects: None,
            knowledge_info: None,
            refinement_info: None,
        })
    }

    // ============================================================
    // Refinement type: { v: T | v >= literal }
    // ============================================================

    fn parse_refinement_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()
        var var_name = empty_name()
        if parser_peek(p) == TokenKind::Ident {
            var_name = p.current_name()
            p = p.advance()
        }
        p = p.expect(TokenKind::Colon)
        let base_pair = p.parse_type()
        p = base_pair.0
        let base_ty = base_pair.1
        p = p.expect(TokenKind::Pipe)

        if parser_peek(p) == TokenKind::Ident {
            p = p.advance()
        }

        var pred_op: i64 = 5
        let op = parser_peek(p)
        if op == TokenKind::Gt {
            pred_op = 1
            p = p.advance()
        } else if op == TokenKind::GtEq {
            pred_op = 2
            p = p.advance()
        } else if op == TokenKind::Lt {
            pred_op = 3
            p = p.advance()
        } else if op == TokenKind::LtEq {
            pred_op = 4
            p = p.advance()
        } else if op == TokenKind::EqEq || op == TokenKind::Eq {
            pred_op = 5
            p = p.advance()
        } else if op == TokenKind::BangEq {
            pred_op = 6
            p = p.advance()
        }

        var pred_int_val: i64 = 0
        var pred_float_val: f64 = 0.0
        var pred_is_float = false
        if parser_peek(p) == TokenKind::FloatLit {
            pred_float_val = p.current().float_value
            pred_is_float = true
            p = p.advance()
        } else if parser_peek(p) == TokenKind::IntLit {
            pred_int_val = p.current().int_value
            pred_float_val = p.current().int_value as f64
            pred_is_float = false
            p = p.advance()
        }

        p = p.expect(TokenKind::RBrace)
        let span = p.span_from(start)
        let info = RefinementInfo {
            var_name: var_name,
            base_type: Some(Box::new(base_ty)),
            pred_op: pred_op,
            pred_int_val: pred_int_val,
            pred_float_val: pred_float_val,
            pred_is_float: pred_is_float,
        }
        (p, TypeExpr {
            kind: TypeExprKind::TypeRefinement,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: None,
            array_size: None,
            effects: None,
            knowledge_info: None,
            refinement_info: Some(Box::new(info)),
        })
    }

    // ============================================================
    // Array or slice element type: [T; N] or [T]
    // ============================================================

    fn parse_array_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip [
        let pair = p.parse_type()
        let elem_ty = pair.1
        p = pair.0
        var size_expr: Option<Box<Expr>> = None
        if parser_peek(p) == TokenKind::Semi {
            p = p.advance()
            p = parse_expr_entry(p)
            size_expr = Some(parser_take_expr_box())
        }
        p = p.expect(TokenKind::RBracket)
        let span = p.span_from(start)
        (p, TypeExpr {
            kind: TypeExprKind::TypeArray,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: Some(Box::new(elem_ty)),
            array_size: size_expr,
            effects: None,
            knowledge_info: None,
            refinement_info: None,
        })
    }

    // ============================================================
    // Tuple type: (T, U) or unit type: ()
    // ============================================================

    fn parse_tuple_or_fn_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip (

        // Unit type ()
        if parser_peek(p) == TokenKind::RParen {
            p = p.advance()
            let span = p.span_from(start)
            (p, TypeExpr {
                kind: TypeExprKind::TypeUnit,
                span: span,
                path: empty_path(),
                type_args: None,
                inner: None,
                array_size: None,
                effects: None,
                knowledge_info: None,
                refinement_info: None,
            })
        } else {
            // Parse first type
            let pair = p.parse_type()
            p = pair.0
            let first_ty = pair.1

            if parser_peek(p) == TokenKind::Comma {
                // Tuple type
                p = p.advance()  // skip ,
                var rev_list = TypeExprList { head: first_ty, tail: None }
                while parser_peek(p) != TokenKind::RParen && parser_peek(p) != TokenKind::Eof {
                    let pair2 = p.parse_type()
                    p = pair2.0
                    let next_ty = pair2.1
                    rev_list = TypeExprList { head: next_ty, tail: Some(Box::new(rev_list)) }
                    if parser_peek(p) == TokenKind::Comma {
                        p = p.advance()
                    }
                }
                p = p.expect(TokenKind::RParen)
                let span = p.span_from(start)
                (p, TypeExpr {
                    kind: TypeExprKind::TypeTuple,
                    span: span,
                    path: empty_path(),
                    type_args: Some(Box::new(reverse_type_expr_list(rev_list))),
                    inner: None,
                    array_size: None,
                    effects: None,
                    knowledge_info: None,
                    refinement_info: None,
                })
            } else {
                // Parenthesized single type
                p = p.expect(TokenKind::RParen)
                (p, first_ty)
            }
        }
    }

    // ============================================================
    // Function type: fn(T, U) -> V with E1, E2
    // ============================================================

    fn parse_fn_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip fn
        p = p.expect(TokenKind::LParen)

        // Parse parameter types
        var has_params = false
        var param_list = TypeExprList { head: dummy_type_expr(), tail: None }

        if parser_peek(p) != TokenKind::RParen {
            let pair = p.parse_type()
            p = pair.0
            var rev_param_list = TypeExprList { head: pair.1, tail: None }
            has_params = true

            while parser_peek(p) == TokenKind::Comma {
                p = p.advance()
                let pair2 = p.parse_type()
                p = pair2.0
                rev_param_list = TypeExprList { head: pair2.1, tail: Some(Box::new(rev_param_list)) }
            }

            param_list = reverse_type_expr_list(rev_param_list)
        }

        p = p.expect(TokenKind::RParen)

        // Parse return type
        var ret_ty = dummy_type_expr()
        var has_ret = false
        if parser_peek(p) == TokenKind::Arrow {
            p = p.advance()
            let pair = p.parse_type()
            p = pair.0
            ret_ty = pair.1
            has_ret = true
        }

        // Parse effects
        var effs: Option<Box<EffectList>> = None
        if parser_peek(p) == TokenKind::With {
            let pair2 = p.parse_effect_list()
            p = pair2.0
            effs = Some(Box::new(pair2.1))
        }

        let span = p.span_from(start)
        (p, TypeExpr {
            kind: TypeExprKind::TypeFn,
            span: span,
            path: empty_path(),
            type_args: if has_params { Some(Box::new(param_list)) } else { None },
            inner: if has_ret { Some(Box::new(ret_ty)) } else { None },
            array_size: None,
            effects: effs,
            knowledge_info: None,
            refinement_info: None,
        })
    }

    // ============================================================
    // Effect list: with IO, Mut, Alloc
    // ============================================================

    fn parse_effect_list(self) -> (Parser, EffectList) with Mut, IO, Panic, Div, Alloc {
        var p = self.advance()  // skip 'with'
        let first_name = p.current_name()
        let first_eff = EffectRef { name_buf: [0; 64], name_len: first_name.len }
        var first = copy_name_to_effect(first_name, first_eff)
        p = p.advance()  // skip effect name

        var rev_list = EffectList { head: first, tail: None }

        while parser_peek(p) == TokenKind::Comma {
            // A comma followed by `ident :` begins the NEXT parameter (`name: type`),
            // not another effect. This happens when a `fn(T)->U with Eff,...` type is a
            // parameter and more parameters follow. Without this, the effect-list loop
            // greedily swallows the next param name as an effect and the signature
            // fails to parse. peek_ahead(2) is the token after the comma's next ident.
            if parser_peek_ahead(p, 2) == TokenKind::Colon { break }
            p = p.advance()  // skip ,
            let eff_name = p.current_name()
            let eff = EffectRef { name_buf: [0; 64], name_len: eff_name.len }
            var e = copy_name_to_effect(eff_name, eff)
            rev_list = EffectList { head: e, tail: Some(Box::new(rev_list)) }
            p = p.advance()  // skip effect name
        }

        (p, reverse_effect_list(rev_list))
    }

    // ============================================================
    // Optional type annotation: ': Type'
    // ============================================================

    fn parse_optional_type(self) -> (Parser, Option<Box<TypeExpr>>) with Mut, IO, Panic, Div {
        if self.peek() == TokenKind::Colon {
            var p = self.advance()  // skip :
            let pair = p.parse_type()
            let p2: Parser = pair.0
            let ty: TypeExpr = pair.1
            (p2, Some(Box::new(ty)))
        } else {
            let none: Option<Box<TypeExpr>> = None
            (self, none)
        }
    }

    // ============================================================
    // Optional return type: '-> Type'
    // ============================================================

    fn parse_optional_return_type(self) -> (Parser, Option<Box<TypeExpr>>) with Mut, IO, Panic, Div {
        if self.peek() == TokenKind::Arrow {
            var p = self.advance()  // skip ->
            let pair = p.parse_type()
            let port_p: Parser = pair.0
            let port_ty: TypeExpr = pair.1
            (port_p, Some(Box::new(port_ty)))
        } else {
            let none: Option<Box<TypeExpr>> = None
            (self, none)
        }
    }

    // ============================================================
    // Knowledge type: Knowledge<T> or Knowledge[T, ε < 0.05, Valid(...), Derived]
    // ============================================================

    fn parse_knowledge_constraint(self) -> (Parser, KnowledgeConstraint) with Mut, IO, Panic, Div, Alloc {
        var p = self
        var constraint = KnowledgeConstraint {
            field: empty_name(),
            kind: KnowledgeConstraintKind::KnowledgeConstraintEq,
            target_name: empty_name(),
            unit_name: empty_name(),
            int_value: 0,
            float_value: 0.0,
            value_kind: KnowledgeConstraintValueKind::KnowledgeConstraintValueNone,
        }

        if parser_peek(p) == TokenKind::Ident {
            constraint.field = p.current_name()
            p = p.advance()
        }

        if parser_peek(p) == TokenKind::Ident && name_eq(p.current_name(), make_name("subclass_of")) {
            constraint.kind = KnowledgeConstraintKind::KnowledgeConstraintSubclassOf
            p = p.advance()
            if parser_peek(p) == TokenKind::Ident {
                constraint.target_name = p.current_name()
                constraint.value_kind = KnowledgeConstraintValueKind::KnowledgeConstraintValueName
                p = p.advance()
            }
            return (p, constraint)
        }

        let op = parser_peek(p)
        if op == TokenKind::GtEq {
            constraint.kind = KnowledgeConstraintKind::KnowledgeConstraintGe
            p = p.advance()
        } else if op == TokenKind::Gt {
            constraint.kind = KnowledgeConstraintKind::KnowledgeConstraintGt
            p = p.advance()
        } else if op == TokenKind::LtEq {
            constraint.kind = KnowledgeConstraintKind::KnowledgeConstraintLe
            p = p.advance()
        } else if op == TokenKind::Lt {
            constraint.kind = KnowledgeConstraintKind::KnowledgeConstraintLt
            p = p.advance()
        } else if op == TokenKind::EqEq || op == TokenKind::Eq {
            constraint.kind = KnowledgeConstraintKind::KnowledgeConstraintEq
            p = p.advance()
        }

        if parser_peek(p) == TokenKind::IntLit {
            constraint.int_value = p.current().int_value
            constraint.float_value = p.current().int_value as f64
            constraint.value_kind = KnowledgeConstraintValueKind::KnowledgeConstraintValueInt
            p = p.advance()
        } else if parser_peek(p) == TokenKind::FloatLit {
            constraint.float_value = p.current().float_value
            constraint.value_kind = KnowledgeConstraintValueKind::KnowledgeConstraintValueFloat
            p = p.advance()
        } else if parser_peek(p) == TokenKind::Ident {
            constraint.target_name = p.current_name()
            constraint.value_kind = KnowledgeConstraintValueKind::KnowledgeConstraintValueName
            p = p.advance()
        }

        if parser_peek(p) == TokenKind::Lt {
            p = p.advance()
            if parser_peek(p) == TokenKind::Ident {
                constraint.unit_name = p.current_name()
                p = p.advance()
            }
            p = p.expect(TokenKind::Gt)
        }

        (p, constraint)
    }

    fn parse_knowledge_constraint_list(self) -> (Parser, Option<Box<KnowledgeConstraintList> >) with Mut, IO, Panic, Div, Alloc {
        var p = self.expect(TokenKind::LBrace)
        var out: Option<Box<KnowledgeConstraintList> > = None

        while parser_peek(p) != TokenKind::RBrace && !parser_at_eof(p) {
            let parsed = p.parse_knowledge_constraint()
            p = parsed.0
            out = Some(Box::new(KnowledgeConstraintList { head: parsed.1, tail: out }))
            if parser_peek(p) == TokenKind::Comma {
                p = p.advance()
            } else if parser_peek(p) == TokenKind::Semi {
                p = p.advance()
            }
        }

        p = p.expect(TokenKind::RBrace)
        (p, out)
    }

    fn parse_knowledge_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'Knowledge'

        // Determine delimiter: < (shorthand) or [ (extended)
        let delim = parser_peek(p)
        var use_bracket = false
        if delim == TokenKind::LBracket {
            use_bracket = true
            p = p.advance()  // skip [
        } else {
            p = p.expect(TokenKind::Lt)  // skip <
        }

        // Parse inner type T
        let pair = p.parse_type()
        p = pair.0
        let inner_ty = pair.1

        // Parse optional comma-separated components (only in bracket form)
        var epsilon_opt: Option<Box<EpsilonBound>> = None
        var validity_opt: Option<Box<ValidityCondition>> = None
        var provenance_opt: Option<Box<AstProvenanceKind>> = None
        var proof_constraints_opt: Option<Box<KnowledgeConstraintList> > = None

        if parser_peek(p) == TokenKind::Where {
            p = p.advance()
            let constraint_pair = p.parse_knowledge_constraint_list()
            p = constraint_pair.0
            proof_constraints_opt = constraint_pair.1
        }

        if use_bracket {
            while parser_peek(p) == TokenKind::Comma {
                p = p.advance()  // skip ,

                let ck = parser_peek(p)

                // Check for epsilon bound: identifier followed by comparison op
                if ck == TokenKind::Ident {
                    // Assume epsilon identifier: parse op + value
                    p = p.advance()  // skip epsilon identifier
                    var cmp_op = CompareOp::CmpLt
                    if parser_peek(p) == TokenKind::Lt {
                        cmp_op = CompareOp::CmpLt
                        p = p.advance()
                    } else if parser_peek(p) == TokenKind::LtEq {
                        cmp_op = CompareOp::CmpLe
                        p = p.advance()
                    } else if parser_peek(p) == TokenKind::Gt {
                        cmp_op = CompareOp::CmpGt
                        p = p.advance()
                    } else if parser_peek(p) == TokenKind::GtEq {
                        cmp_op = CompareOp::CmpGe
                        p = p.advance()
                    } else if parser_peek(p) == TokenKind::EqEq {
                        cmp_op = CompareOp::CmpEq
                        p = p.advance()
                    }
                    // Parse float value
                    let eps_tok = p.current()
                    let eps_val = eps_tok.float_value
                    p = p.advance()  // skip float literal
                    epsilon_opt = Some(Box::new(EpsilonBound { op: cmp_op, value: eps_val }))
                } else if ck == TokenKind::Valid {
                    p = p.advance()  // skip 'Valid'
                    let vkind = AstValidityKind::ValidDuration
                    var vexpr: Option<Box<Expr>> = None
                    if parser_peek(p) == TokenKind::LParen {
                        p = p.advance()  // skip (
                        p = parse_expr_entry(p)
                        vexpr = Some(parser_take_expr_box())
                        p = p.expect(TokenKind::RParen)
                    }
                    validity_opt = Some(Box::new(ValidityCondition { kind: vkind, expr: vexpr }))
                } else if ck == TokenKind::ValidUntil {
                    p = p.advance()  // skip 'ValidUntil'
                    let vkind = AstValidityKind::ValidUntilTime
                    var vexpr: Option<Box<Expr>> = None
                    if parser_peek(p) == TokenKind::LParen {
                        p = p.advance()
                        p = parse_expr_entry(p)
                        vexpr = Some(parser_take_expr_box())
                        p = p.expect(TokenKind::RParen)
                    }
                    validity_opt = Some(Box::new(ValidityCondition { kind: vkind, expr: vexpr }))
                } else if ck == TokenKind::ValidWhile {
                    p = p.advance()  // skip 'ValidWhile'
                    let vkind = AstValidityKind::ValidWhileCond
                    var vexpr: Option<Box<Expr>> = None
                    if parser_peek(p) == TokenKind::LParen {
                        p = p.advance()
                        p = parse_expr_entry(p)
                        vexpr = Some(parser_take_expr_box())
                        p = p.expect(TokenKind::RParen)
                    }
                    validity_opt = Some(Box::new(ValidityCondition { kind: vkind, expr: vexpr }))
                } else if ck == TokenKind::Derived {
                    p = p.advance()
                    provenance_opt = Some(Box::new(AstProvenanceKind::AstProvDerived))
                } else if ck == TokenKind::Computed {
                    p = p.advance()
                    provenance_opt = Some(Box::new(AstProvenanceKind::AstProvComputed))
                } else if ck == TokenKind::Measured {
                    p = p.advance()
                    provenance_opt = Some(Box::new(AstProvenanceKind::AstProvMeasured))
                } else {
                    // Unknown component — skip
                    p = p.advance()
                }
            }
        }

        // Expect closing delimiter
        if use_bracket {
            p = p.expect(TokenKind::RBracket)
        } else {
            p = p.expect(TokenKind::Gt)
        }

        let span = p.span_from(start)
        let info = KnowledgeTypeInfo {
            inner_type: Box::new(inner_ty),
            epsilon: epsilon_opt,
            validity: validity_opt,
            provenance: provenance_opt,
            proof_constraints: proof_constraints_opt,
        }
        (p, TypeExpr {
            kind: TypeExprKind::TypeKnowledge,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: None,
            array_size: None,
            effects: None,
            knowledge_info: Some(Box::new(info)),
            refinement_info: None,
        })
    }

    // Forgettable<T> — ZD-annihilable type.
    // Syntax: Forgettable<T> or Forgettable<T, "e3e10"> (with optional ZD locus name)
    // Inner type stored in `inner` field; functions that use Forgettable<T>
    // must declare the `ZD` effect so the compiler can verify exact erasure.
    fn parse_forgettable_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()   // skip 'Forgettable'
        p = p.expect(TokenKind::Lt)
        let pair = p.parse_type()
        p = pair.0
        let inner_ty = pair.1
        p = p.expect(TokenKind::Gt)
        let span = p.span_from(start)
        (p, TypeExpr {
            kind: TypeExprKind::TypeForgettable,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: Some(Box::new(inner_ty)),
            array_size: None,
            effects: None,
            knowledge_info: None,
            refinement_info: None,
        })
    }

    // ExactlyPrivate<T> — exact-privacy wrapper: contribution to a trained model
    // is algebraically zero in the ZD kernel (G3/G4). Stronger than DP.
    // Requires `with ZD`.
    fn parse_exactly_private_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()
        p = p.expect(TokenKind::Lt)
        let pair = p.parse_type()
        p = pair.0
        let inner_ty = pair.1
        p = p.expect(TokenKind::Gt)
        let span = p.span_from(start)
        (p, TypeExpr {
            kind: TypeExprKind::TypeExactlyPrivate,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: Some(Box::new(inner_ty)),
            array_size: None,
            effects: None,
            knowledge_info: None,
            refinement_info: None,
        })
    }

    // Editable<T> — locality-bounded model editing wrapper (G5).
    // Edits via ZD are confined to the 4D kernel of the ZD operator.
    fn parse_editable_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()
        p = p.expect(TokenKind::Lt)
        let pair = p.parse_type()
        p = pair.0
        let inner_ty = pair.1
        p = p.expect(TokenKind::Gt)
        let span = p.span_from(start)
        (p, TypeExpr {
            kind: TypeExprKind::TypeEditable,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: Some(Box::new(inner_ty)),
            array_size: None,
            effects: None,
            knowledge_info: None,
            refinement_info: None,
        })
    }

    // CapabilityGated<T> — capability containment (G7): value lives in a ZD-gated
    // subspace; can be exactly annihilated without touching orthogonal capabilities.
    fn parse_capability_gated_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()
        p = p.expect(TokenKind::Lt)
        let pair = p.parse_type()
        p = pair.0
        let inner_ty = pair.1
        p = p.expect(TokenKind::Gt)
        let span = p.span_from(start)
        (p, TypeExpr {
            kind: TypeExprKind::TypeCapabilityGated,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: Some(Box::new(inner_ty)),
            array_size: None,
            effects: None,
            knowledge_info: None,
            refinement_info: None,
        })
    }

    // Composable<T> — ZD-orthogonal model merge (G8). Two Composable values
    // combine along ZD-orthogonal complements without mutual perturbation.
    fn parse_composable_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()
        p = p.expect(TokenKind::Lt)
        let pair = p.parse_type()
        p = pair.0
        let inner_ty = pair.1
        p = p.expect(TokenKind::Gt)
        let span = p.span_from(start)
        (p, TypeExpr {
            kind: TypeExprKind::TypeComposable,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: Some(Box::new(inner_ty)),
            array_size: None,
            effects: None,
            knowledge_info: None,
            refinement_info: None,
        })
    }

    // Audited<T> — witness-bearing surgery (G9). Every surgical operation
    // emits a machine-checkable Lean derivation.
    fn parse_audited_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()
        p = p.expect(TokenKind::Lt)
        let pair = p.parse_type()
        p = pair.0
        let inner_ty = pair.1
        p = p.expect(TokenKind::Gt)
        let span = p.span_from(start)
        (p, TypeExpr {
            kind: TypeExprKind::TypeAudited,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: Some(Box::new(inner_ty)),
            array_size: None,
            effects: None,
            knowledge_info: None,
            refinement_info: None,
        })
    }

    // Revivable<T> — time-bounded reversible surgery (G10). Surgical ops
    // can be inverted within a Temporal window, irrevocable afterward.
    fn parse_revivable_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()
        p = p.expect(TokenKind::Lt)
        let pair = p.parse_type()
        p = pair.0
        let inner_ty = pair.1
        p = p.expect(TokenKind::Gt)
        let span = p.span_from(start)
        (p, TypeExpr {
            kind: TypeExprKind::TypeRevivable,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: Some(Box::new(inner_ty)),
            array_size: None,
            effects: None,
            knowledge_info: None,
            refinement_info: None,
        })
    }

    // Interpretable<T> — AMI canonical-basis marker. T's internal
    // representation admits a unique decomposition onto the 168 ZD classes.
    fn parse_interpretable_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()
        p = p.expect(TokenKind::Lt)
        let pair = p.parse_type()
        p = pair.0
        let inner_ty = pair.1
        p = p.expect(TokenKind::Gt)
        let span = p.span_from(start)
        (p, TypeExpr {
            kind: TypeExprKind::TypeInterpretable,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: Some(Box::new(inner_ty)),
            array_size: None,
            effects: None,
            knowledge_info: None,
            refinement_info: None,
        })
    }

    fn parse_epistemic_wrapper_type(self, wrapper_kind: TypeExprKind) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()

        let delim = parser_peek(p)
        var use_bracket = false
        if delim == TokenKind::LBracket {
            use_bracket = true
            p = p.advance()
        } else {
            p = p.expect(TokenKind::Lt)
        }

        let pair = p.parse_type()
        p = pair.0
        let inner_ty = pair.1

        var epsilon_opt: Option<Box<EpsilonBound>> = None
        var validity_opt: Option<Box<ValidityCondition>> = None
        var provenance_opt: Option<Box<AstProvenanceKind>> = None

        if use_bracket {
            while parser_peek(p) == TokenKind::Comma {
                p = p.advance()
                let component_tok = parser_peek(p)

                if component_tok == TokenKind::Valid {
                    p = p.advance()
                    p = p.expect(TokenKind::LParen)
                    p = parse_expr_entry(p)
                    let expr_box = parser_take_expr_box()
                    p = p.expect(TokenKind::RParen)
                    validity_opt = Some(Box::new(ValidityCondition { kind: AstValidityKind::ValidDuration, expr: Some(expr_box) }))
                } else if component_tok == TokenKind::Derived {
                    p = p.advance()
                    provenance_opt = Some(Box::new(AstProvenanceKind::AstProvDerived))
                } else if component_tok == TokenKind::Computed {
                    p = p.advance()
                    provenance_opt = Some(Box::new(AstProvenanceKind::AstProvComputed))
                } else if component_tok == TokenKind::Measured {
                    p = p.advance()
                    provenance_opt = Some(Box::new(AstProvenanceKind::AstProvMeasured))
                } else {
                    p = p.advance()
                }
            }
            p = p.expect(TokenKind::RBracket)
        } else {
            p = p.expect(TokenKind::Gt)
        }

        let span = p.span_from(start)
        let info = KnowledgeTypeInfo {
            inner_type: Box::new(inner_ty),
            epsilon: epsilon_opt,
            validity: validity_opt,
            provenance: provenance_opt,
            proof_constraints: None,
        }
        (p, TypeExpr {
            kind: wrapper_kind,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: None,
            array_size: None,
            effects: None,
            knowledge_info: Some(Box::new(info)),
            refinement_info: None,
        })
    }

    fn parse_validated_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let after_keyword = parser_peek_ahead(self, 1)
        if after_keyword == TokenKind::LBracket {
            self.parse_epistemic_wrapper_type(TypeExprKind::TypeValidated)
        } else {
            self.parse_generic_wrapper_type(TypeExprKind::TypeValidated)
        }
    }

    fn parse_generic_wrapper_type(self, wrapper_kind: TypeExprKind) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()
        p = p.expect(TokenKind::Lt)
        let args_pair = p.parse_type_args_after_lt()
        p = args_pair.0
        let span = p.span_from(start)
        (p, TypeExpr {
            kind: wrapper_kind,
            span: span,
            path: empty_path(),
            type_args: Some(Box::new(args_pair.1)),
            inner: None,
            array_size: None,
            effects: None,
            knowledge_info: None,
            refinement_info: None,
        })
    }

    fn parse_type_args_after_lt(self) -> (Parser, TypeExprList) with Mut, IO, Panic, Div, Alloc {
        let pair = self.parse_type()
        var p = pair.0
        let first_ty = pair.1
        var rev_list = TypeExprList { head: first_ty, tail: None }

        while parser_peek(p) == TokenKind::Comma {
            p = p.advance()
            let pair2 = p.parse_type()
            p = pair2.0
            let next_ty = pair2.1
            rev_list = TypeExprList { head: next_ty, tail: Some(Box::new(rev_list)) }
        }

        p = p.expect(TokenKind::Gt)
        (p, reverse_type_expr_list(rev_list))
    }

    // ============================================================
    // chan T — session channel type carrying protocol T
    // ============================================================

    fn parse_chan_type(self) -> (Parser, TypeExpr) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip 'chan'
        let inner_pair = p.parse_type()
        p = inner_pair.0
        let inner_ty = inner_pair.1
        let span = p.span_from(start)
        (p, TypeExpr {
            kind: TypeExprKind::TypeChan,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: Some(Box::new(inner_ty)),
            array_size: None,
            effects: None,
            knowledge_info: None,
            refinement_info: None,
        })
    }
}

// ============================================================
// Linked-list helpers for type parsing
// ============================================================

fn reverse_type_expr_list(list: TypeExprList) -> TypeExprList with Mut, Alloc {
    reverse_type_expr_list_loop(list, None)
}

fn reverse_type_expr_list_loop(current: TypeExprList, acc: Option<Box<TypeExprList>>) -> TypeExprList with Mut, Alloc {
    let next = current.tail
    let rev_node = TypeExprList { head: current.head, tail: acc }
    match next {
        None => rev_node,
        Some(rest) => reverse_type_expr_list_loop(*rest, Some(Box::new(rev_node))),
    }
}

fn reverse_effect_list(list: EffectList) -> EffectList with Mut, Alloc {
    reverse_effect_list_loop(list, None)
}

fn reverse_effect_list_loop(current: EffectList, acc: Option<Box<EffectList>>) -> EffectList with Mut, Alloc {
    let next = current.tail
    let rev_node = EffectList { head: current.head, tail: acc }
    match next {
        None => rev_node,
        Some(rest) => reverse_effect_list_loop(*rest, Some(Box::new(rev_node))),
    }
}

fn reverse_string_list(list: StringList) -> StringList with Mut, Alloc {
    reverse_string_list_loop(list, None)
}

fn reverse_string_list_loop(current: StringList, acc: Option<Box<StringList>>) -> StringList with Mut, Alloc {
    let next = current.tail
    let rev_node = StringList { head_buf: current.head_buf, head_len: current.head_len, tail: acc }
    match next {
        None => rev_node,
        Some(rest) => reverse_string_list_loop(*rest, Some(Box::new(rev_node))),
    }
}

fn copy_name_to_effect(name: Name, eff: EffectRef) -> EffectRef with Mut, Panic, Div {
    var result = eff
    var i: i64 = 0
    while i < name.len && i < 64 {
        result.name_buf[i] = name.buf[i]
        i = i + 1
    }
    result.name_len = name.len
    result
}
