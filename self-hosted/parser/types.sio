            kind: TypeExprKind::TypeRevivable,
            span: span,
            path: empty_path(),
            type_args: None,
            inner: Some(Box::new(inner_ty)),
            array_size: None,
            effects: None,
            knowledge_info: None,
            refinement_info: None,
