// Self-hosted Sounio AST types
// Uses tagged structs with Option<Box<T>> for recursive children
// and linked lists for sequences (Vec<T> unavailable for user types).

module parser::ast

use lexer::span::{Span}

// ============================================================
// Node ID
// ============================================================

struct NodeId { id: i64 }

fn next_node_id(current: i64) -> NodeId {
    NodeId { id: current + 1 }
}

// ============================================================
// Linked-list containers for AST node sequences
// ============================================================

struct ExprList {
    label: Name,
    head: Expr,
    tail: Option<Box<ExprList>>,
}

struct StmtList {
    head: Stmt,
    tail: Option<Box<StmtList>>,
}

struct ItemList {
    head: Item,
    tail: Option<Box<ItemList>>,
}

struct ParamList {
    head: Param,
    tail: Option<Box<ParamList>>,
}

struct ClosureParam {
    name: Name,
    ty: TypeExpr,
    span: Span,
}

struct ClosureParamList {
    head: ClosureParam,
    tail: Option<Box<ClosureParamList>>,
}

struct TypeParamDef {
    name: Name,
    span: Span,
}

struct TypeParamDefList {
    head: TypeParamDef,
    tail: Option<Box<TypeParamDefList>>,
}

struct FieldDefList {
    head: FieldDef,
    tail: Option<Box<FieldDefList>>,
}

struct VariantDefList {
    head: VariantDef,
    tail: Option<Box<VariantDefList>>,
}

struct MatchArmList {
    head: MatchArm,
    tail: Option<Box<MatchArmList>>,
}

struct StructFieldList {
    head: StructFieldInit,
    tail: Option<Box<StructFieldList>>,
}

struct EffectList {
    head: EffectRef,
    tail: Option<Box<EffectList>>,
}

struct TypeExprList {
    head: TypeExpr,
    tail: Option<Box<TypeExprList>>,
}

struct StringList {
    head_buf: [i8; 128],
    head_len: i64,
    tail: Option<Box<StringList>>,
}

struct PatternList {
    head: Pattern,
    tail: Option<Box<PatternList>>,
}

struct PatFieldList {
    head: PatField,
    tail: Option<Box<PatFieldList>>,
}

// ============================================================
// String buffer helper (for identifiers, paths)
// ============================================================

struct Name {
    buf: [i8; 128],
    len: i64,
}

// ============================================================
// Path: qualified name like Foo::Bar::baz
// ============================================================

struct AstPath {
    segments: StringList,
    seg_count: i64,
}

struct AstPathList {
    head: AstPath,
    tail: Option<Box<AstPathList>>,
}

// ============================================================
// Effect reference: IO, Mut, Alloc, Panic, Div, GPU, Prob, Async
// ============================================================

struct EffectRef {
    name_buf: [i8; 64],
    name_len: i64,
}

// ============================================================
// Expressions
// ============================================================

enum ExprKind {
    // Literals
    ExprIntLit,
    ExprFloatLit,
    ExprBoolTrue,
    ExprBoolFalse,
    ExprStringLit,
    ExprCharLit,

    // Names
    ExprIdent,
    ExprPath,

    // Operators
    ExprBinary,
    ExprUnary,

    // Access
    ExprFieldAccess,
    ExprIndex,
    ExprMethodCall,

    // Calls
    ExprCall,

    // Control flow
    ExprIf,
    ExprMatch,
    ExprWhile,
    ExprLoop,
    ExprBlock,
    ExprReturn,
    ExprBreak,
    ExprContinue,

    // Constructors
    ExprStructLit,
    ExprArrayLit,
    ExprTupleLit,
    ExprContest,
    ExprAuditAttach,

    // Range
    ExprRange,

    // Type cast
    ExprCast,

    // Effect handler: handle<Effect> { body } { handlers }
    ExprHandle,

    // Closure: |params| body
    ExprClosure,

    // For-in: for x in iter { body }
    ExprForIn,

    // Error placeholder
    ExprError,
}

enum UnaryOp {
    OpNeg,
    OpNot,
    OpRef,
    OpRefMut,
    OpDeref,
}

enum BinaryOp {
    OpAdd,
    OpSub,
    OpMul,
    OpDiv,
    OpRem,
    OpEq,
    OpNe,
    OpLt,
    OpLe,
    OpGt,
    OpGe,
    OpAnd,
    OpOr,
    OpBitAnd,
    OpBitOr,
    OpBitXor,
    OpShl,
    OpShr,
    OpConcat,
    OpRange,
    OpRangeInclusive,
}

struct Expr {
    kind: ExprKind,
    span: Span,

    // For IntLit, CharLit
    int_val: i64,

    // For FloatLit
    float_val: f64,

    // For StringLit, Ident, FieldAccess (field name), MethodCall (method name)
    name: Name,

    // For Path, StructLit
    path: AstPath,

    // For Binary
    bin_op: BinaryOp,

    // For Unary
    un_op: UnaryOp,

    // For Binary(left,right), Unary(operand), FieldAccess(base),
    // Index(base), MethodCall(base), Call(callee), If(condition),
    // Match(scrutinee), While(condition), Return(value), Break(value)
    left: Option<Box<Expr>>,

    // For Binary(right), Index(index)
    right: Option<Box<Expr>>,

    // For If(then), While(body), Loop(body), Block
    block: Option<Box<Block>>,

    // For If(else)
    else_expr: Option<Box<Expr>>,

    // For Call(args), MethodCall(args), ArrayLit(elements), TupleLit(elements)
    args: Option<Box<ExprList>>,

    // For Match
    arms: Option<Box<MatchArmList>>,

    // For StructLit
    fields: Option<Box<StructFieldList>>,

    // For Cast (as)
    cast_type: Option<Box<TypeExpr>>,

    // For Handle: handler implementation block (with { ... })
    handler_block: Option<Box<Block>>,

    // For Closure:
    closure_params: Option<Box<ClosureParamList>>,
    closure_return: Option<Box<TypeExpr>>,
    closure_effects: Option<Box<EffectList>>,
    closure_body: Option<Box<Expr>>,

    // For Call with turbofish: func::<T, U>(args)
    type_args: Option<Box<TypeExprList>>,
}

// ============================================================
// Blocks
// ============================================================

struct Block {
    stmts: Option<Box<StmtList>>,
    span: Span,
}

// ============================================================
// Statements
// ============================================================

enum StmtKind {
    StmtLet,
    StmtVar,
    StmtExpr,
    StmtAssign,
}

enum AssignOp {
    AssignEq,
    AssignAdd,
    AssignSub,
    AssignMul,
    AssignDiv,
    AssignRem,
}

struct Stmt {
    kind: StmtKind,
    span: Span,

    // For Let/Var: binding name
    name: Name,

    // For Let/Var: optional type annotation
    ty: Option<Box<TypeExpr>>,

    // For Let/Var: initializer; Expr: the expression; Assign: RHS
    expr: Option<Box<Expr>>,

    // For Assign: target (LHS)
    target: Option<Box<Expr>>,

    // For Assign: operator
    assign_op: AssignOp,
}

// ============================================================
// Match arms
// ============================================================

struct MatchArm {
    pattern: Pattern,
    body: Expr,
    span: Span,
}

// ============================================================
// Struct field initializer (in struct literals)
// ============================================================

struct StructFieldInit {
    name: Name,
    value: Expr,
}

// ============================================================
// Patterns
// ============================================================

enum PatternKind {
    PatWildcard,
    PatBinding,
    PatIntLit,
    PatBoolTrue,
    PatBoolFalse,
    PatStringLit,
    PatEnum,
    PatStruct,
    PatTuple,
    PatOr,
}

struct Pattern {
    kind: PatternKind,
    span: Span,

    // For Binding, IntLit, StringLit
    name: Name,

    // For IntLit
    int_val: i64,

    // For Enum: variant path
    path: AstPath,

    // For Enum: inner patterns; Tuple: elements; Or: alternatives
    sub_patterns: Option<Box<PatternList>>,

    // For Struct: field patterns
    pat_fields: Option<Box<PatFieldList>>,

    // For Binding: mutable?
    is_mut: bool,
}

struct PatField {
    name: Name,
    pattern: Pattern,
}

// ============================================================
// Import item list (for selective imports: use path::{A, B})
// ============================================================

struct ImportItemList {
    head: Name,
    tail: Option<Box<ImportItemList>>,
}

// ============================================================
// Epistemic types: Knowledge[T, ε, δ, Φ]
// ============================================================

enum CompareOp {
    CmpLt,
    CmpLe,
    CmpEq,
    CmpGe,
    CmpGt,
}

struct EpsilonBound {
    op: CompareOp,
    value: f64,
}

enum AstValidityKind {
    ValidDuration,
    ValidUntilTime,
    ValidWhileCond,
}

struct ValidityCondition {
    kind: AstValidityKind,
    expr: Option<Box<Expr>>,
}

enum AstProvenanceKind {
    AstProvDerived,
    AstProvSource,
    AstProvComputed,
    AstProvLiterature,
    AstProvMeasured,
    AstProvInput,
}

struct KnowledgeTypeInfo {
    inner_type: Box<TypeExpr>,
    epsilon: Option<Box<EpsilonBound>>,
    validity: Option<Box<ValidityCondition>>,
    provenance: Option<Box<AstProvenanceKind>>,
}

struct PolicyRequirement {
    metric_name: Name,
    op: CompareOp,
    threshold: f64,
    threshold_kind: i64,
    bool_threshold: bool,
    name_threshold: Name,
    span: Span,
}

struct PolicyRequirementList {
    head: PolicyRequirement,
    tail: Option<Box<PolicyRequirementList>>,
}

struct PolicyDef {
    name: Name,
    target_type: TypeExpr,
    level_name: Name,
    scope_name: Name,
    requirements: Option<Box<PolicyRequirementList>>,
    span: Span,
}

struct ModelsDef {
    name: Name,
    models: Option<Box<AstPathList>>,
    model_count: i64,
    span: Span,
}

struct ValidationDef {
    name: Name,
    target_type: TypeExpr,
    span: Span,
}

struct DecisionPolicyDef {
    name: Name,
    target_type: TypeExpr,
    requirements: Option<Box<PolicyRequirementList>>,
    span: Span,
}

struct AcquisitionPolicyDef {
    name: Name,
    target_type: TypeExpr,
    objective_name: Name,
    route_name: Name,
    requirements: Option<Box<PolicyRequirementList>>,
    span: Span,
}

struct RecoursePolicyDef {
    name: Name,
    target_type: TypeExpr,
    strategy_name: Name,
    route_name: Name,
    requirements: Option<Box<PolicyRequirementList>>,
    span: Span,
}

struct DeferralPolicyDef {
    name: Name,
    target_type: TypeExpr,
    route_name: Name,
    requirements: Option<Box<PolicyRequirementList>>,
    span: Span,
}

enum AlternativeObjectiveDirection {
    AlternativeObjectiveMinimize,
    AlternativeObjectiveMaximize,
}

struct AlternativeObjectiveDef {
    direction: AlternativeObjectiveDirection,
    metric_name: Name,
    span: Span,
}

struct AlternativeObjectiveDefList {
    head: AlternativeObjectiveDef,
    tail: Option<Box<AlternativeObjectiveDefList>>,
}

struct AlternativePolicyDef {
    name: Name,
    target_type: TypeExpr,
    frontier_name: Name,
    objectives: Option<Box<AlternativeObjectiveDefList>>,
    max_options: i64,
    span: Span,
}

enum AuditValueKind {
    AuditValueName,
    AuditValueFloat,
}

struct AuditFieldEntry {
    name: Name,
    value_name: Name,
    value_f64: f64,
    value_kind: AuditValueKind,
    span: Span,
}

struct AuditFieldEntryList {
    head: AuditFieldEntry,
    tail: Option<Box<AuditFieldEntryList>>,
}

struct AlternativeCandidateDef {
    name: Name,
    via_name: Name,
    value_expr: Expr,
    metrics: Option<Box<AuditFieldEntryList>>,
    uses_via: bool,
    span: Span,
}

struct AlternativeCandidateDefList {
    head: AlternativeCandidateDef,
    tail: Option<Box<AlternativeCandidateDefList>>,
}

struct AlternativeFrontierDef {
    name: Name,
    target_type: TypeExpr,
    policy_name: Name,
    candidates: Option<Box<AlternativeCandidateDefList>>,
    span: Span,
}

struct TransitionPolicyDef {
    name: Name,
    target_type: TypeExpr,
    route_name: Name,
    requirements: Option<Box<PolicyRequirementList>>,
    max_steps: i64,
    rollback_route_name: Name,
    span: Span,
}

struct MonitoringPolicyDef {
    name: Name,
    target_type: TypeExpr,
    route_name: Name,
    requirements: Option<Box<PolicyRequirementList>>,
    rollback_route_name: Name,
    span: Span,
}

struct TransitionStepDef {
    name: Name,
    value_expr: Expr,
    requirements: Option<Box<PolicyRequirementList>>,
    span: Span,
}

struct TransitionStepDefList {
    head: TransitionStepDef,
    tail: Option<Box<TransitionStepDefList>>,
}

struct TransitionProtocolDef {
    name: Name,
    target_type: TypeExpr,
    policy_name: Name,
    steps: Option<Box<TransitionStepDefList>>,
    span: Span,
}

enum AuditSectionKind {
    AuditSectionUnknown,
    AuditSectionMetrics,
    AuditSectionMechanistic,
    AuditSectionCounterexample,
    AuditSectionPosteriorWeights,
}

struct AuditSection {
    kind: AuditSectionKind,
    name: Name,
    fields: Option<Box<AuditFieldEntryList>>,
    span: Span,
}

struct AuditSectionList {
    head: AuditSection,
    tail: Option<Box<AuditSectionList>>,
}

struct AuditDef {
    name: Name,
    target_type: TypeExpr,
    sections: Option<Box<AuditSectionList>>,
    span: Span,
}

// ============================================================
// Session type definitions: session Ping { send i64, recv i64, close }
// ============================================================

enum SessionStepKind {
    StepSend,
    StepRecv,
    StepClose,
}

struct SessionStep {
    kind: SessionStepKind,
    msg_type: TypeExpr,
    span: Span,
}

struct SessionStepList {
    head: SessionStep,
    tail: Option<Box<SessionStepList>>,
}

struct SessionDecl {
    name: Name,
    steps: [SessionStep; 16],
    step_count: i64,
    span: Span,
}

// ============================================================
// Effect definitions: effect Foo { fn op(params) -> RetTy }
// ============================================================

struct EffectOpDef {
    name: Name,
    params: Option<Box<ParamList>>,
    ret_ty: Option<Box<TypeExpr>>,
    span: Span,
}

struct EffectOpDefList {
    head: EffectOpDef,
    tail: Option<Box<EffectOpDefList>>,
}

struct EffectDef {
    name: Name,
    ops: Option<Box<EffectOpDefList>>,
    op_count: i64,
    span: Span,
}

// ============================================================
// Type expressions
// ============================================================

enum TypeExprKind {
    TypeNamed,
    TypeReference,
    TypeRefMut,
    TypeArray,
    TypeTuple,
    TypeFn,
    TypeUnit,
    TypeNever,
    TypeSelfUpper,
    TypeInfer,
    TypeKnowledge,
    TypeModel,
    TypePolicy,
    TypeAcquisitionPolicy,
    TypeAcquisitionPlan,
    TypeRecoursePolicy,
    TypeRecoursePlan,
    TypeTransitionPolicy,
    TypeTransitionPlan,
    TypeMonitoringPolicy,
    TypeObservedTransition,
    TypeRollbackCertificate,
    TypeDecisionPolicy,
    TypeDeferralPolicy,
    TypeAlternativePolicy,
    TypeAlternativeSet,
    TypeAlternativeOption,
    TypeContest,
    TypeRobust,
    TypeIntervention,
    TypeCounterfactual,
    TypeValidated,
    TypeAdmissible,
    TypeDeferred,
    TypeRefinement,
    TypeChan,
    TypeSession,
    // Sprint 27: Annotation syntax
    TypeDiffPrivate,
    TypeDPBudget,
    TypeCausalEffect,
    TypeAleatoric,
    TypePotentialOutcome,
    TypeProof,
    TypeLemma,
    TypeAxiom,
}

// Refinement predicate — parsed from `{ x: T | x > 0 }`
// pred_op: 1=Gt, 2=GtEq, 3=Lt, 4=LtEq, 5=Eq, 6=NotEq
struct RefinementInfo {
    var_name: Name,
    base_type: Option<Box<TypeExpr>>,
    pred_op: i64,
    pred_int_val: i64,
    pred_float_val: f64,
    pred_is_float: bool,
}

struct TypeExpr {
    kind: TypeExprKind,
    span: Span,

    // For Named: type path (e.g. Vec, Option, Foo::Bar)
    path: AstPath,

    // For Named: generic args; Tuple: elements; Fn: params
    type_args: Option<Box<TypeExprList>>,

    // For Reference, RefMut, Array: inner type; Fn: return type
    inner: Option<Box<TypeExpr>>,

    // For Array: size expression
    array_size: Option<Box<Expr>>,

    // For Fn: effect list
    effects: Option<Box<EffectList>>,

    // For Knowledge: full epistemic type info
    knowledge_info: Option<Box<KnowledgeTypeInfo>>,

    // For Refinement: { var: Type | predicate }
    refinement_info: Option<Box<RefinementInfo>>,
}

// ============================================================
// Items (top-level declarations)
// ============================================================

enum ItemKind {
    ItemFn,
    ItemStruct,
    ItemEnum,
    ItemImpl,
    ItemTypeAlias,
    ItemModels,
    ItemPolicy,
    ItemAcquisitionPolicy,
    ItemRecoursePolicy,
    ItemTransitionPolicy,
    ItemTransitionProtocol,
    ItemMonitoringPolicy,
    ItemDecisionPolicy,
    ItemDeferralPolicy,
    ItemAlternativePolicy,
    ItemAlternativeFrontier,
    ItemValidation,
    ItemAudit,
    ItemUse,
    ItemUnit,
    ItemEffect,
    ItemSession,
    ItemTrait,
    ItemAlgebra,
    ItemStudy,
    ItemOntology,
}

struct Item {
    kind: ItemKind,
    span: Span,

    // True if declared with `pub`.
    // (Visibility is not fully enforced yet; this is used for module exports.)
    is_pub: bool,

    // For all: item name
    name: Name,

    // For Fn
    fn_def: Option<Box<FnDef>>,

    // For Struct
    struct_def: Option<Box<StructDef>>,

    // For Enum
    enum_def: Option<Box<EnumDef>>,

    // For Impl
    impl_def: Option<Box<ImplDef>>,

    // For TypeAlias
    type_alias_ty: Option<Box<TypeExpr>>,

    // For Policy
    policy_def: Option<Box<PolicyDef>>,

    // For AcquisitionPolicy
    acquisition_policy_def: Option<Box<AcquisitionPolicyDef>>,

    // For RecoursePolicy
    recourse_policy_def: Option<Box<RecoursePolicyDef>>,

    // For DecisionPolicy
    decision_policy_def: Option<Box<DecisionPolicyDef>>,

    // For DeferralPolicy
    deferral_policy_def: Option<Box<DeferralPolicyDef>>,

    // For TransitionPolicy
    transition_policy_def: Option<Box<TransitionPolicyDef>>,

    // For TransitionProtocol
    transition_protocol_def: Option<Box<TransitionProtocolDef>>,

    // For MonitoringPolicy
    monitoring_policy_def: Option<Box<MonitoringPolicyDef>>,

    // For AlternativePolicy
    alternative_policy_def: Option<Box<AlternativePolicyDef>>,

    // For AlternativeFrontier
    alternative_frontier_def: Option<Box<AlternativeFrontierDef>>,

    // For Models
    models_def: Option<Box<ModelsDef>>,

    // For Validation
    validation_def: Option<Box<ValidationDef>>,

    // For Audit
    audit_def: Option<Box<AuditDef>>,

    // For Use
    use_path: AstPath,
    use_glob: bool,
    use_items: Option<Box<ImportItemList>>,

    // For Effect
    effect_def: Option<Box<EffectDef>>,

    // For Session
    session_decl: Option<Box<SessionDecl>>,

    // For Trait
    trait_def: Option<Box<TraitDef>>,

    // For Algebra
    algebra_def: Option<Box<AlgebraDef>>,

    // For Study
    study_def: Option<Box<StudyDef>>,

    // For Ontology
    ontology_def: Option<Box<OntologyDef>>,
}

// ============================================================
// Function definition
// ============================================================

struct FnDef {
    name: Name,
    params: Option<Box<ParamList>>,
    return_type: Option<Box<TypeExpr>>,
    effects: Option<Box<EffectList>>,
    body: Block,
    span: Span,
    is_kernel: bool,
}

struct Param {
    name: Name,
    ty: TypeExpr,
    is_self: bool,
    is_self_mut: bool,
    span: Span,
}

// ============================================================
// Struct definition
// ============================================================

struct StructDef {
    name: Name,
    type_params: Option<Box<TypeParamDefList>>,
    fields: Option<Box<FieldDefList>>,
    is_linear: bool,
    is_affine: bool,
    span: Span,
}

struct FieldDef {
    name: Name,
    ty: TypeExpr,
    span: Span,
}

// ============================================================
// Enum definition
// ============================================================

struct EnumDef {
    name: Name,
    variants: Option<Box<VariantDefList>>,
    span: Span,
}

struct VariantDef {
    name: Name,
    fields: Option<Box<FieldDefList>>,
    span: Span,
}

// ============================================================
// Impl definition
// ============================================================

struct ImplDef {
    target_type: TypeExpr,
    methods: Option<Box<ItemList>>,
    span: Span,
    // For `impl TraitName for Type { }` — trait_name.len > 0 when present
    trait_name: Name,
}

// Trait definition: trait Name { fn method1(); fn method2(); ... }
struct TraitDef {
    name: Name,
    methods: Option<Box<ItemList>>,
    supertraits: Option<Box<TypeExprList>>,
    span: Span,
}

// ============================================================
// Algebra declaration
// ============================================================

// Algebraic properties for an operation (stored as boolean flags)
struct AlgebraOpDecl {
    op_name: Name,           // "add" or "mul"
    is_commutative: bool,
    is_associative: bool,
    is_alternative: bool,    // Artin's theorem: (aa)b = a(ab), (ba)a = b(aa)
    span: Span,
}

struct AlgebraOpDeclList {
    head: AlgebraOpDecl,
    tail: Option<Box<AlgebraOpDeclList>>,
}

struct AlgebraDef {
    name: Name,
    over_type: Option<Box<TypeExpr>>,
    ops: Option<Box<AlgebraOpDeclList>>,
    reassoc_strategy: i64,   // 0=free, 1=blocked, 2=fano_selective
    span: Span,
}

struct StudyHypothesis {
    name: Name,
    outcome: Name,
    direction: i32,      // 0=greater, 1=less, 2=not_equal
    effect_size: f64,
}

struct StudyOutcome {
    name: Name,
    is_primary: bool,
}

struct StudyDef {
    name: Name,
    title: Name,
    registration: Name,
    design: i32,          // 0=parallel_rct, 1=crossover, 2=cohort, 3=case_control
    sample_size: i64,
    power: f64,
    alpha: f64,
    correction: i32,      // 0=none, 1=bonferroni, 2=benjamini_hochberg
    hypotheses: [StudyHypothesis; 8],
    n_hypotheses: i32,
    outcomes: [StudyOutcome; 16],
    n_outcomes: i32,
}

fn empty_study_hypothesis() -> StudyHypothesis {
    StudyHypothesis {
        name: Name { buf: [0; 128], len: 0 },
        outcome: Name { buf: [0; 128], len: 0 },
        direction: 0,
        effect_size: 0.0,
    }
}

fn empty_study_outcome() -> StudyOutcome {
    StudyOutcome {
        name: Name { buf: [0; 128], len: 0 },
        is_primary: false,
    }
}

// ============================================================
// Ontology declaration
// ============================================================

// Ontology property: `property name: type where name op value`
// op: 1=Gt, 2=GtEq, 3=Lt, 4=LtEq, 5=Eq, 6=NotEq (matches RefinementPred ops)
struct OntologyPropertyDecl {
    name: Name,
    type_name: Name,       // "f64" or "i64"
    pred_op: i64,          // comparison operator (1-6, 0=none)
    pred_rhs_int: i64,
    pred_rhs_float: f64,
    is_float: bool,
    span: Span,
}

struct OntologyClassDecl {
    name: Name,
    superclass_names: [Name; 8],
    superclass_count: i64,
    properties: [OntologyPropertyDecl; 8],
    property_count: i64,
    span: Span,
}

fn empty_ontology_property_decl() -> OntologyPropertyDecl {
    OntologyPropertyDecl {
        name: Name { buf: [0; 128], len: 0 },
        type_name: Name { buf: [0; 128], len: 0 },
        pred_op: 0,
        pred_rhs_int: 0,
        pred_rhs_float: 0.0,
        is_float: false,
        span: Span { start: 0, end: 0 },
    }
}

struct OntologyClassDeclList {
    head: OntologyClassDecl,
    tail: Option<Box<OntologyClassDeclList>>,
}

struct OntologyDisjointDecl {
    name_a: Name,
    name_b: Name,
    span: Span,
}

struct OntologyDisjointDeclList {
    head: OntologyDisjointDecl,
    tail: Option<Box<OntologyDisjointDeclList>>,
}

struct OntologyRoleDecl {
    name: Name,
    domain_name: Name,
    range_name: Name,
    inverse_name: Name,
    has_domain: bool,
    has_range: bool,
    has_inverse: bool,
    is_transitive: bool,
    is_functional: bool,
    is_symmetric: bool,
    duplicate_modifier_bits: i64,
    span: Span,
}

struct OntologyRoleDeclList {
    head: OntologyRoleDecl,
    tail: Option<Box<OntologyRoleDeclList>>,
}

struct OntologyDef {
    name: Name,
    classes: Option<Box<OntologyClassDeclList>>,
    disjoints: Option<Box<OntologyDisjointDeclList>>,
    roles: Option<Box<OntologyRoleDeclList>>,
    span: Span,
}

// ============================================================
// Top-level program
// ============================================================

struct Program {
    // Identity of this program when treated as a module.
    // For flat compilation (single unit), this is typically empty.
    module_path: AstPath,
    items: Option<Box<ItemList>>,
}

// Construct an empty AstPath (used by module_loader and other consumers)
fn empty_path() -> AstPath {
    AstPath { segments: StringList { head_buf: [0; 128], head_len: 0, tail: None }, seg_count: 0 }
}

// Check if a Name is empty (zero-length)
fn name_is_empty(n: Name) -> bool {
    n.len == 0
}

// Construct an empty Name
fn empty_name() -> Name {
    Name { buf: [0; 128], len: 0 }
}

// Name comparison — byte-by-byte equality
fn name_eq(a: Name, b: Name) -> bool with Mut, Panic, Div {
    if a.len != b.len { return false }
    var i: i64 = 0
    while i < a.len {
        if a.buf[i as usize] != b.buf[i as usize] { return false }
        i = i + 1
    }
    true
}
