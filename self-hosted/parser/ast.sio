// ============================================================================
// Visibility hierarchy
// ============================================================================
// Sounio does not yet support enum variants with payloads, so visibility is
// represented as a tagged struct.  The parser accepts:
//   (omitted)      -> Private
//   pub            -> Pub
//   pub(crate)     -> PubCrate
//   pub(super)     -> PubSuper
//   pub(path::to)  -> PubIn(path::to)

pub struct Visibility {
    pub kind: i64,
    pub path: AstPath,
}

let VISIBILITY_PRIVATE: i64 = 0
let VISIBILITY_PUB: i64 = 1
let VISIBILITY_PUB_CRATE: i64 = 2
let VISIBILITY_PUB_SUPER: i64 = 3
let VISIBILITY_PUB_IN: i64 = 4

pub fn visibility_private() -> Visibility {
    Visibility { kind: VISIBILITY_PRIVATE, path: empty_path() }
}

pub fn visibility_pub() -> Visibility {
    Visibility { kind: VISIBILITY_PUB, path: empty_path() }
}

pub fn visibility_pub_crate() -> Visibility {
    Visibility { kind: VISIBILITY_PUB_CRATE, path: empty_path() }
}

pub fn visibility_pub_super() -> Visibility {
    Visibility { kind: VISIBILITY_PUB_SUPER, path: empty_path() }
}

pub fn visibility_pub_in(path: AstPath) -> Visibility {
    Visibility { kind: VISIBILITY_PUB_IN, path: path }
}

pub fn visibility_is_pub(v: Visibility) -> bool {
    v.kind == VISIBILITY_PUB
}

pub fn visibility_to_bool(v: Visibility) -> bool {
    v.kind != VISIBILITY_PRIVATE
}

pub struct Item {
    pub kind: ItemKind,
    pub span: Span,

    // Visibility of this item.  The parser produces this from `pub`,
    // `pub(crate)`, `pub(super)`, or `pub(path)`.  Private by default.
    pub visibility: Visibility,

    // For all: item name
    pub name: Name,

    // For Fn
    pub fn_def: Option<Box<FnDef> >,

    // For Struct
    pub struct_def: Option<Box<StructDef> >,

    // For Enum
    pub enum_def: Option<Box<EnumDef> >,

    // For Impl
    pub impl_def: Option<Box<ImplDef> >,

    // For TypeAlias
    pub type_alias_ty: Option<Box<TypeExpr> >,

    // For Policy
    pub policy_def: Option<Box<PolicyDef> >,

    // For AcquisitionPolicy
    pub acquisition_policy_def: Option<Box<AcquisitionPolicyDef> >,

    // For RecoursePolicy
    pub recourse_policy_def: Option<Box<RecoursePolicyDef> >,

    // For DecisionPolicy
    pub decision_policy_def: Option<Box<DecisionPolicyDef> >,

    // For DeferralPolicy
    pub deferral_policy_def: Option<Box<DeferralPolicyDef> >,

    // For TransitionPolicy
    pub transition_policy_def: Option<Box<TransitionPolicyDef> >,

    // For TransitionProtocol
    pub transition_protocol_def: Option<Box<TransitionProtocolDef> >,

    // For MonitoringPolicy
    pub monitoring_policy_def: Option<Box<MonitoringPolicyDef> >,

    // For AlternativePolicy
    pub alternative_policy_def: Option<Box<AlternativePolicyDef> >,

    // For AlternativeFrontier
    pub alternative_frontier_def: Option<Box<AlternativeFrontierDef> >,

    // For Models
    pub models_def: Option<Box<ModelsDef> >,

    // For Validation
    pub validation_def: Option<Box<ValidationDef> >,

    // For Audit
    pub audit_def: Option<Box<AuditDef> >,

    // For Use
    pub use_path: AstPath,
    pub use_glob: bool,
    pub use_items: Option<Box<ImportItemList> >,

    // For Effect
    pub effect_def: Option<Box<EffectDef> >,

    // For Session
    pub session_decl: Option<Box<SessionDecl> >,

    // For Trait
    pub trait_def: Option<Box<TraitItemDef> >,

    // For Algebra
    pub algebra_def: Option<Box<AlgebraDef> >,

    // For Study
    pub study_def: Option<Box<StudyDef> >,

    // For Ontology
    pub ontology_def: Option<Box<OntologyDef> >,
}

// ============================================================
// Function definition
// ============================================================

pub struct FnDef {
    pub name: Name,
    pub params: Option<Box<ParamList> >,
    pub return_type: Option<Box<TypeExpr> >,
    pub effects: Option<Box<EffectList> >,
    pub body: Block,
    pub span: Span,
    pub is_kernel: bool,
    // #1547: true for `extern "C" fn` declarations (no body; lowered as an
    // instr_count == 0 stub so builtin dispatch applies). Distinct from
    // is_kernel, which the checker treats as a GPU kernel (E070/E253).
    pub is_extern: bool,
}

pub struct Param {
    pub name: Name,
    pub ty: TypeExpr,
    pub is_self: bool,
    pub is_self_mut: bool,
    pub span: Span,
}

// ============================================================
// Struct definition
// ============================================================

pub struct StructDef {
    pub name: Name,
    pub type_params: Option<Box<TypeParamDefList> >,
    pub fields: Option<Box<FieldDefList> >,
    pub is_linear: bool,
    pub is_affine: bool,
    pub span: Span,
}

pub struct FieldDef {
    pub name: Name,
    pub ty: TypeExpr,
    pub is_pub: bool,
    pub span: Span,
}

// ============================================================
// Enum definition
// ============================================================

pub struct EnumDef {
    pub name: Name,
    pub variants: Option<Box<VariantDefList> >,
    pub span: Span,
}

pub struct VariantDef {
    pub name: Name,
    pub fields: Option<Box<FieldDefList> >,
    pub span: Span,
}

// Scalar accessor for bootstrap-sensitive consumers. Returning the Box payload
// through Option from a nested ItemList field path is miscompiled by lean_single.
pub fn item_enum_def_ptr(item: &Item) -> *mut EnumDef {
    match (*item).enum_def {
        Some(ed) => ed as *mut EnumDef,
        None => 0 as *mut EnumDef,
    }
}

pub fn item_struct_def_ptr(item: &Item) -> *mut StructDef {
    match (*item).struct_def {
        Some(sd) => sd as *mut StructDef,
        None => 0 as *mut StructDef,
    }
}

// ============================================================
// Impl definition
// ============================================================

pub struct ImplDef {
    pub target_type: TypeExpr,
    pub methods: Option<Box<ItemList> >,
    pub span: Span,
    // For `impl TraitName for Type { }` — trait_name.len > 0 when present
    pub trait_name: Name,
}

// Trait definition: trait Name { fn method1(); fn method2(); ... }
pub struct TraitItemDef {
    pub name: Name,
    pub methods: Option<Box<ItemList> >,
    pub supertraits: Option<Box<TypeExprList> >,
    pub span: Span,
}

// ============================================================
// Algebra declaration
// ============================================================

// Algebraic properties for an operation (stored as boolean flags)
pub struct AlgebraOpDecl {
    pub op_name: Name,           // "add" or "mul"
    pub is_commutative: bool,
    pub is_associative: bool,
    pub is_alternative: bool,    // Artin's theorem: (aa)b = a(ab), (ba)a = b(aa)
    pub span: Span,
}

pub struct AlgebraOpDeclList {
    pub head: AlgebraOpDecl,
    pub tail: Option<Box<AlgebraOpDeclList> >,
}

pub struct AlgebraDef {
    pub name: Name,
    pub over_type: Option<Box<TypeExpr> >,
    pub ops: Option<Box<AlgebraOpDeclList> >,
    pub reassoc_strategy: i64,   // 0=free, 1=blocked, 2=fano_selective
    pub span: Span,
}

pub struct StudyHypothesis {
    pub name: Name,
    pub outcome: Name,
    pub direction: i32,      // 0=greater, 1=less, 2=not_equal
    pub effect_size: f64,
}

pub struct StudyOutcome {
    pub name: Name,
    pub is_primary: bool,
}

pub struct StudyDef {
    pub name: Name,
    pub title: Name,
    pub registration: Name,
    pub design: i32,          // 0=parallel_rct, 1=crossover, 2=cohort, 3=case_control
    pub sample_size: i64,
    pub power: f64,
    pub alpha: f64,
    pub correction: i32,      // 0=none, 1=bonferroni, 2=benjamini_hochberg
    pub hypotheses: [StudyHypothesis; 8],
    pub n_hypotheses: i32,
    pub outcomes: [StudyOutcome; 16],
    pub n_outcomes: i32,
}

pub fn empty_study_hypothesis() -> StudyHypothesis {
    StudyHypothesis {
        name: Name { buf: [0; 384], len: 0 },
        outcome: Name { buf: [0; 384], len: 0 },
        direction: 0,
        effect_size: 0.0,
    }
}

pub fn empty_study_outcome() -> StudyOutcome {
    StudyOutcome {
        name: Name { buf: [0; 384], len: 0 },
        is_primary: false,
    }
}

// ============================================================
// Ontology declaration
// ============================================================

// Ontology property: `property name: type where name op value`
// op: 1=Gt, 2=GtEq, 3=Lt, 4=LtEq, 5=Eq, 6=NotEq (matches RefinementPred ops)
pub struct OntologyPropertyDecl {
    pub name: Name,
    pub type_name: Name,       // "f64" or "i64"
    pub pred_op: i64,          // comparison operator (1-6, 0=none)
    pub pred_rhs_int: i64,
    pub pred_rhs_float: f64,
    pub is_float: bool,
    pub span: Span,
}

pub struct OntologyClassDecl {
    pub name: Name,
    pub superclass_names: [Name; 8],
    pub superclass_count: i64,
    pub properties: [OntologyPropertyDecl; 8],
    pub property_count: i64,
    pub span: Span,
}

pub fn empty_ontology_property_decl() -> OntologyPropertyDecl {
    OntologyPropertyDecl {
        name: Name { buf: [0; 384], len: 0 },
        type_name: Name { buf: [0; 384], len: 0 },
        pred_op: 0,
        pred_rhs_int: 0,
        pred_rhs_float: 0.0,
        is_float: false,
        span: Span { file_id: 0, start: 0, end: 0 },
    }
}

pub struct OntologyClassDeclList {
    pub head: OntologyClassDecl,
    pub tail: Option<Box<OntologyClassDeclList> >,
}

pub struct OntologyDisjointDecl {
    pub name_a: Name,
    pub name_b: Name,
    pub span: Span,
}

pub struct OntologyDisjointDeclList {
    pub head: OntologyDisjointDecl,
    pub tail: Option<Box<OntologyDisjointDeclList> >,
}

pub struct OntologyRoleDecl {
    pub name: Name,
    pub domain_name: Name,
    pub range_name: Name,
    pub inverse_name: Name,
    pub has_domain: bool,
    pub has_range: bool,
    pub has_inverse: bool,
    pub is_transitive: bool,
    pub is_functional: bool,
    pub is_symmetric: bool,
    pub duplicate_modifier_bits: i64,
    pub span: Span,
}

pub struct OntologyRoleDeclList {
    pub head: OntologyRoleDecl,
    pub tail: Option<Box<OntologyRoleDeclList> >,
}

pub struct OntologyDef {
    pub name: Name,
    pub classes: Option<Box<OntologyClassDeclList> >,
    pub disjoints: Option<Box<OntologyDisjointDeclList> >,
    pub roles: Option<Box<OntologyRoleDeclList> >,
    pub span: Span,
}

// ============================================================
// Top-level program
// ============================================================

pub struct Program {
    // Identity of this program when treated as a module.
    // For flat compilation (single unit), this is typically empty.
    pub module_path: AstPath,
    pub items: Option<Box<ItemList> >,
}

// Construct an empty AstPath (used by module_loader and other consumers)
pub fn empty_path() -> AstPath {
    AstPath { segments: StringList { head_buf: [0; 384], head_len: 0, tail: None }, seg_count: 0 }
}

// Check if a Name is empty (zero-length)
pub fn name_is_empty(n: Name) -> bool {
    n.len == 0
}

// Construct an empty Name
pub fn empty_name() -> Name {
    Name { buf: [0; 384], len: 0 }
}

// Construct a Name from a string literal
pub fn make_name(s: string) -> Name with Mut, Panic, Div {
    let len = str_len(s)
    var n = Name { buf: [0; 384], len: len }
    var i: i64 = 0
    while i < len && i < 384 {
        n.buf[i as usize] = str_char_at(s, i) as i8
        i = i + 1
    }
    n
}

// Name comparison — byte-by-byte equality
pub fn name_eq(a: Name, b: Name) -> bool with Mut, Panic, Div {
    if a.len != b.len { return false }
    var i: i64 = 0
    while i < a.len {
        if a.buf[i as usize] != b.buf[i as usize] { return false }
        i = i + 1
    }
    true
}

// ============================================================
// Global variable initializer side table
// ============================================================

pub var GLOBAL_VAR_INIT_COUNT: i64 = 0
// Cap: 8192 init words (was 128). The table accumulates every module's global
// initializers in a multi-module build (scalar = 1 word, element-list = N
// words, string literal = 2 + ceil(len/8) words). At 128, large programs (e.g.
// lsp/server.sio with 231 own globals + stdlib) silently dropped every
// initializer past the cap, leaving those globals BSS-zero — including
// cross-module `pub let` constants such as ir.sio's BSS_INIT_STRING_MAGIC.
// Overflow past 8192 is still a silent drop (record fns return unit).
pub var GLOBAL_VAR_INIT_HASHES: [i64; 8192] = [0; 8192]
pub var GLOBAL_VAR_INIT_VALUES: [i64; 8192] = [0; 8192]
// When 1, parse_items_preloaded does NOT reset the global-init table, so a
// multi-module compilation accumulates every module's f64 global initializers
// (main is parsed first, then each import). The multimodule lower entry sets it
// after resetting once; single-module and per-program-test parses leave it 0 and
// keep the per-parse reset (isolation between independent programs).
pub var GLOBAL_VAR_INIT_SUPPRESS_RESET: i64 = 0

// Wave15e string-literal global encoding inside GLOBAL_VAR_INIT_* (same table
// as i64/f64 words so the seed-proven accumulate path is reused):
//   word[0] = AST_BSS_INIT_STRING_MAGIC
//   word[1] = payload_len (quotes stripped, escapes not expanded here)
//   word[2..] = little-endian packed payload bytes (8 per word)
// lower reconstructs a Name for codegen LEA+BSS store.
pub let AST_BSS_INIT_STRING_MAGIC: i64 = 0 - 800001

pub fn ast_name_hash(n: Name) -> i64 with Div {
    var hash: i64 = 5381
    var i = 0
    while i < n.len {
        hash = hash * 33 + (n.buf[i as usize] as i64)
        i = i + 1
    }
    if hash < 0 { 0 - hash } else { hash }
}

pub fn ast_reset_global_var_inits() with Mut {
    GLOBAL_VAR_INIT_COUNT = 0
}

pub fn ast_record_global_var_init(name: Name, value: i64) with Mut, Div {
    if GLOBAL_VAR_INIT_COUNT < 8192 {
        GLOBAL_VAR_INIT_HASHES[GLOBAL_VAR_INIT_COUNT as usize] = ast_name_hash(name)
        GLOBAL_VAR_INIT_VALUES[GLOBAL_VAR_INIT_COUNT as usize] = value
        GLOBAL_VAR_INIT_COUNT = GLOBAL_VAR_INIT_COUNT + 1
    }
}

// Strip surrounding `"` from a string-literal Name (token text form).
// Escape expansion is applied later by ir_normalize_string_literal_name when
// the payload is reconstructed as a Name that still has no surrounding quotes.
pub fn ast_string_lit_payload(lit: Name) -> Name {
    var out = empty_name()
    var start: i64 = 0
    var end = lit.len
    if lit.len >= 2 && lit.buf[0] == 34 as i8 && lit.buf[(lit.len - 1) as usize] == 34 as i8 {
        start = 1
        end = lit.len - 1
    }
    var i = start
    while i < end && out.len < 384 {
        out.buf[out.len as usize] = lit.buf[i as usize]
        out.len = out.len + 1
        i = i + 1
    }
    out
}

// Pack a string-literal global into GLOBAL_VAR_INIT_* as magic+len+bytes.
// Reuses the integer-word side table (proven under multi-mod suppress-reset).
pub fn ast_record_global_str_init(name: Name, lit: Name) with Mut, Div {
    let payload = ast_string_lit_payload(lit)
    // Budget: magic + len + ceil(len/8) words must fit remaining table slots.
    let words_needed = 2 + (payload.len + 7) / 8
    if GLOBAL_VAR_INIT_COUNT + words_needed > 8192 {
        return
    }
    ast_record_global_var_init(name, AST_BSS_INIT_STRING_MAGIC)
    ast_record_global_var_init(name, payload.len)
    var off: i64 = 0
    while off < payload.len {
        var word: i64 = 0
        var place: i64 = 1
        var b: i64 = 0
        while b < 8 && off + b < payload.len {
            let byte = payload.buf[(off + b) as usize] as i64
            // little-endian pack without relying on variable shift amounts
            if byte < 0 {
                word = word + ((byte + 256) * place)
            } else {
                word = word + (byte * place)
            }
            place = place * 256
            b = b + 1
        }
        ast_record_global_var_init(name, word)
        off = off + 8
    }
}

pub fn ast_lookup_global_var_init(name: Name) -> i64 with Div {
    let h = ast_name_hash(name)
    var i: i64 = 0
    while i < GLOBAL_VAR_INIT_COUNT {
        if GLOBAL_VAR_INIT_HASHES[i as usize] == h {
            return GLOBAL_VAR_INIT_VALUES[i as usize]
        }
        i = i + 1
    }
    0
}

// Count of recorded init words for `name`. Scalar / array-repeat → 1;
// element-list `[a,b,c]` → N. Zero means "no recorded initializer".
// Distinct from lookup(value)==0: a recorded zero fill still counts as present.
pub fn ast_global_var_init_count(name: Name) -> i64 with Div {
    let h = ast_name_hash(name)
    var n: i64 = 0
    var i: i64 = 0
    while i < GLOBAL_VAR_INIT_COUNT {
        if GLOBAL_VAR_INIT_HASHES[i as usize] == h {
            n = n + 1
        }
        i = i + 1
    }
    n
}

// Nth recorded init word for `name` (0-based, source order). Returns 0 if out of range.
pub fn ast_global_var_init_nth(name: Name, index: i64) -> i64 with Div {
    let h = ast_name_hash(name)
    var seen: i64 = 0
    var i: i64 = 0
    while i < GLOBAL_VAR_INIT_COUNT {
        if GLOBAL_VAR_INIT_HASHES[i as usize] == h {
            if seen == index {
                return GLOBAL_VAR_INIT_VALUES[i as usize]
            }
            seen = seen + 1
        }
        i = i + 1
    }
    0
}

// 1 if GLOBAL_VAR_INIT words for `name` encode a string literal (Wave15e).
// Defined after count/nth — no forward references.
pub fn ast_global_str_init_present(name: Name) -> i64 with Div {
    let c = ast_global_var_init_count(name)
    if c < 2 {
        return 0
    }
    if ast_global_var_init_nth(name, 0) == AST_BSS_INIT_STRING_MAGIC {
        return 1
    }
    0
}

// Reconstruct payload Name from packed GLOBAL_VAR_INIT words (no surrounding quotes).
pub fn ast_global_str_init_name(name: Name) -> Name with Div {
    if ast_global_str_init_present(name) == 0 {
        return empty_name()
    }
    let plen = ast_global_var_init_nth(name, 1)
    var out = empty_name()
    if plen <= 0 {
        return out
    }
    var wi: i64 = 0
    let nwords = (plen + 7) / 8
    while wi < nwords {
        var word = ast_global_var_init_nth(name, 2 + wi)
        var b: i64 = 0
        while b < 8 && out.len < plen && out.len < 384 {
            let byte = word - (word / 256) * 256
            if byte < 0 {
                out.buf[out.len as usize] = (byte + 256) as i8
            } else {
                out.buf[out.len as usize] = byte as i8
            }
            out.len = out.len + 1
            word = word / 256
            b = b + 1
        }
        wi = wi + 1
    }
    out
}

// ============================================================
// Claim declaration (AST-native falsification claims)
// ============================================================
//
// Syntax: `claim name { field = value, ... }` where each value is a string
// literal, an integer/float literal, or a path such as
// `Evidence::InstrumentControlled`. Claims are compile-time metadata for the
// falsification ledger (docs/research/ast_native_claims_spec_2026-07-25.md,
// future rung 1): they carry no runtime semantics and never reach resolve,
// check, or codegen — the parse driver (parser::mod) drops ItemKind::ItemClaim
// items from the item stream after parse_claim_item records them here.
//
// The registry uses flat primitive arrays (same pattern as GLOBAL_VAR_INIT_*)
// because global struct-array initializers are not supported. Field text is
// stored as ast_name_hash digests; recovering source text from a claim is a
// future rung (the comment ledger and the claim_ast preprocessor remain the
// text-preserving extraction paths).

pub let CLAIM_VALUE_NONE: i64 = 0
pub let CLAIM_VALUE_STRING: i64 = 1
pub let CLAIM_VALUE_INT: i64 = 2
pub let CLAIM_VALUE_FLOAT: i64 = 3
pub let CLAIM_VALUE_PATH: i64 = 4

pub struct ClaimField {
    pub name: Name,
    pub value: Name,      // token text (string literals keep their quotes)
    pub kind: i64,        // CLAIM_VALUE_*
}

pub struct ClaimDecl {
    pub name: Name,
    pub fields: [ClaimField; 16],
    pub n_fields: i32,
}

pub fn empty_claim_field() -> ClaimField {
    ClaimField { name: empty_name(), value: empty_name(), kind: CLAIM_VALUE_NONE }
}

pub fn empty_claim_decl() -> ClaimDecl {
    ClaimDecl {
        name: empty_name(),
        fields: [empty_claim_field(); 16],
        n_fields: 0,
    }
}

// Flat claim registry: up to 64 claims, up to 16 fields each (row-major).
pub var CLAIM_COUNT: i64 = 0
pub var CLAIM_NAME_HASHES: [i64; 64] = [0; 64]
pub var CLAIM_FIELD_COUNTS: [i64; 64] = [0; 64]
pub var CLAIM_FIELD_NAME_HASHES: [i64; 1024] = [0; 1024]
pub var CLAIM_FIELD_VALUE_HASHES: [i64; 1024] = [0; 1024]
pub var CLAIM_FIELD_KINDS: [i64; 1024] = [0; 1024]

// Text-preserving claim registry extension (self-falsifying compiler rung,
// docs/research/self_falsifying_compiler_spec_2026-07-25.md). The hash arrays
// above cannot be inverted, so gate paths and verdicts would be unrecoverable.
// Claim and field NAMES are stored as flat byte arrays (128 bytes per entry,
// row-major: claim name at slot*128, field name at (slot*16+field)*128).
// Field VALUES are stored as byte-offset spans into the source file: Names
// returned by current_name() do not survive the parse path for StringLit
// tokens (struct-return/store limitations), so the value text is recovered by
// slicing the source between CLAIM_FIELD_VALUE_START/END instead. All of this
// is fed directly from parse_claim_item (the note functions below); the
// hash-based lookup API is unchanged.
pub var CLAIM_NAME_TEXT_LENS: [i64; 64] = [0; 64]
pub var CLAIM_NAME_TEXT: [i8; 8192] = [0; 8192]
pub var CLAIM_FIELD_NAME_TEXT_LENS: [i64; 1024] = [0; 1024]
pub var CLAIM_FIELD_NAME_TEXT: [i8; 131072] = [0; 131072]
pub var CLAIM_FIELD_VALUE_START: [i64; 1024] = [0; 1024]
pub var CLAIM_FIELD_VALUE_END: [i64; 1024] = [0; 1024]

pub fn ast_reset_claims() with Mut {
    CLAIM_COUNT = 0
}

// ============================================================
// Causal graph declared in source (Madaros side of Sprint 20 Track CI)
// ============================================================
//
// Flat, compile-unit-global, and dropped from the item stream exactly like a
// claim: the graph is metadata about the whole unit, not a definition anything
// resolves against, so it never reaches resolve/.
//
// Nodes are identified by the SAME FNV-1a hash the checker's indep_var_id
// computes over a variable name, so a claim's ids are already node ids and no
// second resolution step can drift from the first.
//
// Capacity mirrors CausalGraph in check/causal.sio: 16 nodes, 32 edges. Both
// are hard caps and both fail closed -- an edge past the cap is refused loudly
// by the parser rather than dropped, because a graph silently missing an edge
// would d-separate pairs that the author's graph does not.
pub var CG_DECLARED: i64 = 0
pub var CG_NODE_COUNT: i64 = 0
pub var CG_NODE_HASHES: [i64; 16] = [0; 16]
pub var CG_EDGE_COUNT: i64 = 0
pub var CG_EDGE_FROM: [i64; 32] = [0; 32]
pub var CG_EDGE_TO: [i64; 32] = [0; 32]
pub var CG_EDGE_DIRECTED: [i64; 32] = [0; 32]
pub var CG_OVERFLOW: i64 = 0

pub fn ast_reset_causal_graph() with Mut {
    CG_DECLARED = 0
    CG_NODE_COUNT = 0
    CG_EDGE_COUNT = 0
    CG_OVERFLOW = 0
    DSEP_COUNT = 0
    DSEP_OVERFLOW = 0
}

// Intern a node by hash. Returns its index, or -1 when the 16-node cap is full.
pub fn ast_cg_intern_node(h: i64) -> i64 with Mut {
    var i: i64 = 0
    while i < CG_NODE_COUNT {
        if CG_NODE_HASHES[i as usize] == h { return i }
        i = i + 1
    }
    if CG_NODE_COUNT >= 16 {
        CG_OVERFLOW = 1
        return 0 - 1
    }
    CG_NODE_HASHES[CG_NODE_COUNT as usize] = h
    CG_NODE_COUNT = CG_NODE_COUNT + 1
    CG_NODE_COUNT - 1
}

// Look a node up WITHOUT interning: a claim naming a variable the graph does
// not declare must be rejected, not silently added to the graph.
pub fn ast_cg_find_node(h: i64) -> i64 {
    var i: i64 = 0
    while i < CG_NODE_COUNT {
        if CG_NODE_HASHES[i as usize] == h { return i }
        i = i + 1
    }
    0 - 1
}

// The name hash shared by the graph registry, the checker's indep_var_id and the
// d_separated rewrite. One definition, so the three cannot drift apart.
pub fn ast_indep_name_hash(n: Name) -> i64 with Mut, Panic, Div {
    var h: i64 = 2166136261
    var i: i64 = 0
    while i < n.len && i < 128 {
        h = h ^ (n.buf[i as usize] as i64)
        h = (h * 16777619) % 1073741789
        i = i + 1
    }
    if h < 0 { h = 0 - h }
    h
}

// ============================================================
// d_separated(A, B | Z) claims pending verification
// ============================================================
//
// The arguments exist to be VERIFIED, not evaluated: A, B and Z name graph
// nodes, not variables in scope. The parser records the claim here and rewrites
// the call to the literal 1 -- the proof token -- so nothing downstream ever
// sees identifiers that do not resolve.
//
// Verification is deferred to the checker rather than done here, so a graph
// declared BELOW its use still counts; the parser has no complete graph yet.
//
// Rewriting to a literal, rather than to a zero-argument d_separated() as the
// lean_single pass does, removes the forgeable surface entirely: there is no
// function a human could call to mint a proof.
pub var DSEP_COUNT: i64 = 0
pub var DSEP_A: [i64; 64] = [0; 64]
pub var DSEP_B: [i64; 64] = [0; 64]
pub var DSEP_Z: [i64; 64] = [0; 64]
pub var DSEP_FORM_OK: [i64; 64] = [0; 64]
pub var DSEP_SPAN_FILE: [i64; 64] = [0; 64]
pub var DSEP_SPAN_START: [i64; 64] = [0; 64]
pub var DSEP_SPAN_END: [i64; 64] = [0; 64]
pub var DSEP_DONE: [i64; 64] = [0; 64]
pub var DSEP_OVERFLOW: i64 = 0

pub fn ast_reset_dsep_claims() with Mut {
    DSEP_COUNT = 0
    DSEP_OVERFLOW = 0
}

pub fn ast_record_dsep(a: i64, b: i64, z: i64, form_ok: i64, fid: i64, st: i64, en: i64) with Mut {
    if DSEP_COUNT >= 64 { DSEP_OVERFLOW = 1; return }
    let i = DSEP_COUNT
    DSEP_A[i as usize] = a
    DSEP_B[i as usize] = b
    DSEP_Z[i as usize] = z
    DSEP_FORM_OK[i as usize] = form_ok
    DSEP_DONE[i as usize] = 0
    DSEP_SPAN_FILE[i as usize] = fid
    DSEP_SPAN_START[i as usize] = st
    DSEP_SPAN_END[i as usize] = en
    DSEP_COUNT = DSEP_COUNT + 1
}

pub fn ast_cg_add_edge(from: i64, to: i64, directed: i64) with Mut {
    if from < 0 || to < 0 { CG_OVERFLOW = 1; return }
    if CG_EDGE_COUNT >= 32 { CG_OVERFLOW = 1; return }
    CG_EDGE_FROM[CG_EDGE_COUNT as usize] = from
    CG_EDGE_TO[CG_EDGE_COUNT as usize] = to
    CG_EDGE_DIRECTED[CG_EDGE_COUNT as usize] = directed
    CG_EDGE_COUNT = CG_EDGE_COUNT + 1
}

pub fn ast_record_claim(decl: ClaimDecl) with Mut, Div {
    if CLAIM_COUNT >= 64 {
        return
    }
    let slot = CLAIM_COUNT
    CLAIM_NAME_HASHES[slot as usize] = ast_name_hash(decl.name)
    var nf = decl.n_fields as i64
    if nf > 16 {
        nf = 16
    }
    CLAIM_FIELD_COUNTS[slot as usize] = nf
    var i: i64 = 0
    while i < nf {
        let base = slot * 16 + i
        CLAIM_FIELD_NAME_HASHES[base as usize] = ast_name_hash(decl.fields[i as usize].name)
        CLAIM_FIELD_VALUE_HASHES[base as usize] = ast_name_hash(decl.fields[i as usize].value)
        CLAIM_FIELD_KINDS[base as usize] = decl.fields[i as usize].kind
        i = i + 1
    }
    CLAIM_COUNT = CLAIM_COUNT + 1
}

// Text-preserving recording (self-falsifying compiler rung).
//
// Names stored inside a ClaimDecl do not survive the parse -> registry path
// intact: field values arrive truncated (struct store / struct-return
// limitations; rung 1 documented text recovery as future work for this
// reason). parse_claim_item therefore feeds the text/span arrays DIRECTLY
// from parser locals and token spans via the functions below, bypassing the
// lossy path. Ordering contract: the note functions are called while the
// claim is parsed, i.e. BEFORE ast_record_claim increments CLAIM_COUNT, so
// the pending slot is CLAIM_COUNT.
pub fn ast_claim_note_name_text(name: Name) with Mut, Div {
    if CLAIM_COUNT >= 64 {
        return
    }
    let slot = CLAIM_COUNT
    var name_len = name.len
    if name_len > 384 {
        name_len = 384
    }
    CLAIM_NAME_TEXT_LENS[slot as usize] = name_len
    var c: i64 = 0
    while c < name_len {
        CLAIM_NAME_TEXT[(slot * 128 + c) as usize] = name.buf[c as usize]
        c = c + 1
    }
}

pub fn ast_claim_note_field_name(field_idx: i64, fname: Name) with Mut, Div {
    if CLAIM_COUNT >= 64 {
        return
    }
    if field_idx < 0 || field_idx >= 16 {
        return
    }
    let base = CLAIM_COUNT * 16 + field_idx
    var fn_len = fname.len
    if fn_len > 384 {
        fn_len = 384
    }
    CLAIM_FIELD_NAME_TEXT_LENS[base as usize] = fn_len
    var fi: i64 = 0
    while fi < fn_len {
        CLAIM_FIELD_NAME_TEXT[(base * 128 + fi) as usize] = fname.buf[fi as usize]
        fi = fi + 1
    }
}

// Record the source byte-offset span of a claim field's value token(s). For
// paths (Evidence::InstrumentControlled) the span covers the whole path; for
// string literals it includes the surrounding quotes.
pub fn ast_claim_note_field_span(field_idx: i64, vstart: i64, vend: i64) with Mut, Div {
    if CLAIM_COUNT >= 64 {
        return
    }
    if field_idx < 0 || field_idx >= 16 {
        return
    }
    let base = CLAIM_COUNT * 16 + field_idx
    CLAIM_FIELD_VALUE_START[base as usize] = vstart
    CLAIM_FIELD_VALUE_END[base as usize] = vend
}

// Number of claims recorded since the last ast_reset_claims.
pub fn ast_claim_count() -> i64 {
    CLAIM_COUNT
}

// Field count for the claim named `name`, or 0 when absent. Distinct from a
// claim with zero fields only in that ast_claim_present disambiguates.
pub fn ast_claim_present(name: Name) -> i64 with Div {
    let h = ast_name_hash(name)
    var i: i64 = 0
    while i < CLAIM_COUNT {
        if CLAIM_NAME_HASHES[i as usize] == h {
            return 1
        }
        i = i + 1
    }
    0
}

pub fn ast_claim_field_count(name: Name) -> i64 with Div {
    let h = ast_name_hash(name)
    var i: i64 = 0
    while i < CLAIM_COUNT {
        if CLAIM_NAME_HASHES[i as usize] == h {
            return CLAIM_FIELD_COUNTS[i as usize]
        }
        i = i + 1
    }
    0
}

// Value kind (CLAIM_VALUE_*) of field `field` on claim `name`, or
// CLAIM_VALUE_NONE when either is absent.
pub fn ast_claim_field_kind(name: Name, field: Name) -> i64 with Div {
    let h = ast_name_hash(name)
    let fh = ast_name_hash(field)
    var i: i64 = 0
    while i < CLAIM_COUNT {
        if CLAIM_NAME_HASHES[i as usize] == h {
            let nf = CLAIM_FIELD_COUNTS[i as usize]
            var j: i64 = 0
            while j < nf {
                let base = i * 16 + j
                if CLAIM_FIELD_NAME_HASHES[base as usize] == fh {
                    return CLAIM_FIELD_KINDS[base as usize]
                }
                j = j + 1
            }
            return CLAIM_VALUE_NONE
        }
        i = i + 1
    }
    CLAIM_VALUE_NONE
}

// ============================================================
// Slot-based text accessors (self-falsifying compiler rung)
// ============================================================
// Unlike the hash-based lookups above, these rebuild the recorded source text
// so tooling (the claim executor) can enumerate claims without knowing their
// names in advance. Out-of-range indices yield empty names/fields.

// Rebuild the name of the claim recorded at `slot`
// (0 <= slot < ast_claim_count()).
pub fn ast_claim_slot_name(slot: i64) -> Name with Mut, Div {
    var n = empty_name()
    if slot < 0 || slot >= CLAIM_COUNT {
        return n
    }
    let len = CLAIM_NAME_TEXT_LENS[slot as usize]
    var i: i64 = 0
    while i < len && i < 384 {
        n.buf[i as usize] = CLAIM_NAME_TEXT[(slot * 128 + i) as usize]
        i = i + 1
    }
    n.len = len
    n
}

// Field count of the claim recorded at `slot`, or 0 when out of range.
pub fn ast_claim_slot_field_count(slot: i64) -> i64 {
    if slot < 0 || slot >= CLAIM_COUNT {
        return 0
    }
    CLAIM_FIELD_COUNTS[slot as usize]
}

// Rebuild field `field_idx` (name and CLAIM_VALUE_* kind) of the claim
// recorded at `slot`. The value Name is always empty: value text is recovered
// from the source file via ast_claim_slot_value_start/end instead.
pub fn ast_claim_slot_field(slot: i64, field_idx: i64) -> ClaimField with Mut, Div {
    var f = empty_claim_field()
    if slot < 0 || slot >= CLAIM_COUNT {
        return f
    }
    if field_idx < 0 || field_idx >= CLAIM_FIELD_COUNTS[slot as usize] {
        return f
    }
    let base = slot * 16 + field_idx
    f.kind = CLAIM_FIELD_KINDS[base as usize]
    let nlen = CLAIM_FIELD_NAME_TEXT_LENS[base as usize]
    var i: i64 = 0
    while i < nlen && i < 128 {
        f.name.buf[i as usize] = CLAIM_FIELD_NAME_TEXT[(base * 128 + i) as usize]
        i = i + 1
    }
    f.name.len = nlen
    f
}

// Source byte-offset span of field `field_idx`'s value on the claim at
// `slot`, or 0 when out of range. Slice the compiled source file between
// start (inclusive) and end (exclusive) to recover the value text.
pub fn ast_claim_slot_value_start(slot: i64, field_idx: i64) -> i64 {
    if slot < 0 || slot >= CLAIM_COUNT {
        return 0
    }
    if field_idx < 0 || field_idx >= CLAIM_FIELD_COUNTS[slot as usize] {
        return 0
    }
    CLAIM_FIELD_VALUE_START[(slot * 16 + field_idx) as usize]
}

pub fn ast_claim_slot_value_end(slot: i64, field_idx: i64) -> i64 {
    if slot < 0 || slot >= CLAIM_COUNT {
        return 0
    }
    if field_idx < 0 || field_idx >= CLAIM_FIELD_COUNTS[slot as usize] {
        return 0
    }
    CLAIM_FIELD_VALUE_END[(slot * 16 + field_idx) as usize]
}
