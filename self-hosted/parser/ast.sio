// Self-hosted Sounio AST types
// Uses tagged structs with Option<Box<T>> for recursive children
// and linked lists for sequences (Vec<T> unavailable for user types).

// ============================================================
// Node ID
// ============================================================

struct NodeId { id: i64 }

fn next_node_id(current: i64) -> NodeId {
    NodeId { id: current + 1 }
}

// ============================================================
// Linked-list containers for AST node sequences
// ============================================================

struct ExprList {
    head: Expr,
    tail: Option<Box<ExprList>>,
}

struct StmtList {
    head: Stmt,
    tail: Option<Box<StmtList>>,
}

struct ItemList {
    head: Item,
    tail: Option<Box<ItemList>>,
}

struct ParamList {
    head: Param,
    tail: Option<Box<ParamList>>,
}

struct FieldDefList {
    head: FieldDef,
    tail: Option<Box<FieldDefList>>,
}

struct VariantDefList {
    head: VariantDef,
    tail: Option<Box<VariantDefList>>,
}

struct MatchArmList {
    head: MatchArm,
    tail: Option<Box<MatchArmList>>,
}

struct StructFieldList {
    head: StructFieldInit,
    tail: Option<Box<StructFieldList>>,
}

struct EffectList {
    head: EffectRef,
    tail: Option<Box<EffectList>>,
}

struct TypeExprList {
    head: TypeExpr,
    tail: Option<Box<TypeExprList>>,
}

struct StringList {
    head_buf: [i8; 128],
    head_len: i64,
    tail: Option<Box<StringList>>,
}

struct PatternList {
    head: Pattern,
    tail: Option<Box<PatternList>>,
}

struct PatFieldList {
    head: PatField,
    tail: Option<Box<PatFieldList>>,
}

// ============================================================
// String buffer helper (for identifiers, paths)
// ============================================================

struct Name {
    buf: [i8; 128],
    len: i64,
}

// ============================================================
// Path: qualified name like Foo::Bar::baz
// ============================================================

struct AstPath {
    segments: StringList,
    seg_count: i64,
}

// ============================================================
// Effect reference: IO, Mut, Alloc, Panic, Div, GPU, Prob, Async
// ============================================================

struct EffectRef {
    name_buf: [i8; 64],
    name_len: i64,
}

// ============================================================
// Expressions
// ============================================================

enum ExprKind {
    // Literals
    ExprIntLit,
    ExprFloatLit,
    ExprBoolTrue,
    ExprBoolFalse,
    ExprStringLit,
    ExprCharLit,

    // Names
    ExprIdent,
    ExprPath,

    // Operators
    ExprBinary,
    ExprUnary,

    // Access
    ExprFieldAccess,
    ExprIndex,
    ExprMethodCall,

    // Calls
    ExprCall,

    // Control flow
    ExprIf,
    ExprMatch,
    ExprWhile,
    ExprLoop,
    ExprBlock,
    ExprReturn,
    ExprBreak,
    ExprContinue,

    // Constructors
    ExprStructLit,
    ExprArrayLit,
    ExprTupleLit,

    // Range
    ExprRange,

    // Type cast
    ExprCast,

    // Error placeholder
    ExprError,
}

enum UnaryOp {
    OpNeg,
    OpNot,
    OpRef,
    OpRefMut,
    OpDeref,
}

enum BinaryOp {
    OpAdd,
    OpSub,
    OpMul,
    OpDiv,
    OpRem,
    OpEq,
    OpNe,
    OpLt,
    OpLe,
    OpGt,
    OpGe,
    OpAnd,
    OpOr,
    OpBitAnd,
    OpBitOr,
    OpBitXor,
    OpShl,
    OpShr,
    OpConcat,
    OpRange,
    OpRangeInclusive,
}

struct Expr {
    kind: ExprKind,
    span: Span,

    // For IntLit, CharLit
    int_val: i64,

    // For FloatLit
    float_val: f64,

    // For StringLit, Ident, FieldAccess (field name), MethodCall (method name)
    name: Name,

    // For Path, StructLit
    path: AstPath,

    // For Binary
    bin_op: BinaryOp,

    // For Unary
    un_op: UnaryOp,

    // For Binary(left,right), Unary(operand), FieldAccess(base),
    // Index(base), MethodCall(base), Call(callee), If(condition),
    // Match(scrutinee), While(condition), Return(value), Break(value)
    left: Option<Box<Expr>>,

    // For Binary(right), Index(index)
    right: Option<Box<Expr>>,

    // For If(then), While(body), Loop(body), Block
    block: Option<Box<Block>>,

    // For If(else)
    else_expr: Option<Box<Expr>>,

    // For Call(args), MethodCall(args), ArrayLit(elements), TupleLit(elements)
    args: Option<Box<ExprList>>,

    // For Match
    arms: Option<Box<MatchArmList>>,

    // For StructLit
    fields: Option<Box<StructFieldList>>,

    // For Cast (as)
    cast_type: Option<Box<TypeExpr>>,
}

// ============================================================
// Blocks
// ============================================================

struct Block {
    stmts: Option<Box<StmtList>>,
    span: Span,
}

// ============================================================
// Statements
// ============================================================

enum StmtKind {
    StmtLet,
    StmtVar,
    StmtExpr,
    StmtAssign,
}

enum AssignOp {
    AssignEq,
    AssignAdd,
    AssignSub,
    AssignMul,
    AssignDiv,
    AssignRem,
}

struct Stmt {
    kind: StmtKind,
    span: Span,

    // For Let/Var: binding name
    name: Name,

    // For Let/Var: optional type annotation
    ty: Option<Box<TypeExpr>>,

    // For Let/Var: initializer; Expr: the expression; Assign: RHS
    expr: Option<Box<Expr>>,

    // For Assign: target (LHS)
    target: Option<Box<Expr>>,

    // For Assign: operator
    assign_op: AssignOp,
}

// ============================================================
// Match arms
// ============================================================

struct MatchArm {
    pattern: Pattern,
    body: Expr,
    span: Span,
}

// ============================================================
// Struct field initializer (in struct literals)
// ============================================================

struct StructFieldInit {
    name: Name,
    value: Expr,
}

// ============================================================
// Patterns
// ============================================================

enum PatternKind {
    PatWildcard,
    PatBinding,
    PatIntLit,
    PatBoolTrue,
    PatBoolFalse,
    PatStringLit,
    PatEnum,
    PatStruct,
    PatTuple,
    PatOr,
}

struct Pattern {
    kind: PatternKind,
    span: Span,

    // For Binding, IntLit, StringLit
    name: Name,

    // For IntLit
    int_val: i64,

    // For Enum: variant path
    path: AstPath,

    // For Enum: inner patterns; Tuple: elements; Or: alternatives
    sub_patterns: Option<Box<PatternList>>,

    // For Struct: field patterns
    pat_fields: Option<Box<PatFieldList>>,

    // For Binding: mutable?
    is_mut: bool,
}

struct PatField {
    name: Name,
    pattern: Pattern,
}

// ============================================================
// Import item list (for selective imports: use path::{A, B})
// ============================================================

struct ImportItemList {
    head: Name,
    tail: Option<Box<ImportItemList>>,
}

// ============================================================
// Epistemic types: Knowledge[T, ε, δ, Φ]
// ============================================================

enum CompareOp {
    CmpLt,
    CmpLe,
    CmpEq,
    CmpGe,
    CmpGt,
}

struct EpsilonBound {
    op: CompareOp,
    value: f64,
}

enum ValidityKind {
    ValidDuration,
    ValidUntilTime,
    ValidWhileCond,
}

struct ValidityCondition {
    kind: ValidityKind,
    expr: Option<Box<Expr>>,
}

enum ProvenanceKind {
    ProvDerived,
    ProvSource,
    ProvComputed,
    ProvLiterature,
    ProvMeasured,
    ProvInput,
}

struct KnowledgeTypeInfo {
    inner_type: Box<TypeExpr>,
    epsilon: Option<Box<EpsilonBound>>,
    validity: Option<Box<ValidityCondition>>,
    provenance: Option<Box<ProvenanceKind>>,
}

// ============================================================
// Type expressions
// ============================================================

enum TypeExprKind {
    TypeNamed,
    TypeReference,
    TypeRefMut,
    TypeArray,
    TypeTuple,
    TypeFn,
    TypeUnit,
    TypeNever,
    TypeSelfUpper,
    TypeInfer,
    TypeKnowledge,
}

struct TypeExpr {
    kind: TypeExprKind,
    span: Span,

    // For Named: type path (e.g. Vec, Option, Foo::Bar)
    path: AstPath,

    // For Named: generic args; Tuple: elements; Fn: params
    type_args: Option<Box<TypeExprList>>,

    // For Reference, RefMut, Array: inner type; Fn: return type
    inner: Option<Box<TypeExpr>>,

    // For Array: size expression
    array_size: Option<Box<Expr>>,

    // For Fn: effect list
    effects: Option<Box<EffectList>>,

    // For Knowledge: full epistemic type info
    knowledge_info: Option<Box<KnowledgeTypeInfo>>,
}

// ============================================================
// Items (top-level declarations)
// ============================================================

enum ItemKind {
    ItemFn,
    ItemStruct,
    ItemEnum,
    ItemImpl,
    ItemTypeAlias,
    ItemUse,
    ItemUnit,
}

struct Item {
    kind: ItemKind,
    span: Span,

    // True if declared with `pub`.
    // (Visibility is not fully enforced yet; this is used for module exports.)
    is_pub: bool,

    // For all: item name
    name: Name,

    // For Fn
    fn_def: Option<Box<FnDef>>,

    // For Struct
    struct_def: Option<Box<StructDef>>,

    // For Enum
    enum_def: Option<Box<EnumDef>>,

    // For Impl
    impl_def: Option<Box<ImplDef>>,

    // For TypeAlias
    type_alias_ty: Option<Box<TypeExpr>>,

    // For Use
    use_path: AstPath,
    use_glob: bool,
    use_items: Option<Box<ImportItemList>>,
}

// ============================================================
// Function definition
// ============================================================

struct FnDef {
    name: Name,
    params: Option<Box<ParamList>>,
    return_type: Option<Box<TypeExpr>>,
    effects: Option<Box<EffectList>>,
    body: Block,
    span: Span,
}

struct Param {
    name: Name,
    ty: TypeExpr,
    is_self: bool,
    is_self_mut: bool,
    span: Span,
}

// ============================================================
// Struct definition
// ============================================================

struct StructDef {
    name: Name,
    fields: Option<Box<FieldDefList>>,
    is_linear: bool,
    span: Span,
}

struct FieldDef {
    name: Name,
    ty: TypeExpr,
    span: Span,
}

// ============================================================
// Enum definition
// ============================================================

struct EnumDef {
    name: Name,
    variants: Option<Box<VariantDefList>>,
    span: Span,
}

struct VariantDef {
    name: Name,
    span: Span,
}

// ============================================================
// Impl definition
// ============================================================

struct ImplDef {
    target_type: TypeExpr,
    methods: Option<Box<ItemList>>,
    span: Span,
}

// ============================================================
// Top-level program
// ============================================================

struct Program {
    // Identity of this program when treated as a module.
    // For flat compilation (single unit), this is typically empty.
    module_path: AstPath,
    items: Option<Box<ItemList>>,
}
