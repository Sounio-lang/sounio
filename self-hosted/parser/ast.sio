// Self-hosted Sounio AST types
// Uses tagged structs with Option<Box<T> > for recursive children
// and linked lists for sequences (Vec<T> unavailable for user types).

module parser::ast

use lexer::span::{Span}

// ============================================================
// Node ID
// ============================================================

pub struct NodeId { id: i64 }

fn next_node_id(current: i64) -> NodeId {
    NodeId { id: current + 1 }
}

// ============================================================
// Linked-list containers for AST node sequences
// ============================================================

pub struct ExprList {
    label: Name,
    head: Expr,
    tail: Option<Box<ExprList> >,
}

pub struct StmtList {
    head: Stmt,
    tail: Option<Box<StmtList> >,
}

pub struct ItemList {
    head: Item,
    tail: Option<Box<ItemList> >,
}

pub struct ParamList {
    head: Param,
    tail: Option<Box<ParamList> >,
}

pub struct ClosureParam {
    name: Name,
    ty: TypeExpr,
    span: Span,
}

pub struct ClosureParamList {
    head: ClosureParam,
    tail: Option<Box<ClosureParamList> >,
}

pub struct TypeParamDef {
    name: Name,
    span: Span,
}

pub struct TypeParamDefList {
    head: TypeParamDef,
    tail: Option<Box<TypeParamDefList> >,
}

pub struct FieldDefList {
    head: FieldDef,
    tail: Option<Box<FieldDefList> >,
}

pub struct VariantDefList {
    head: VariantDef,
    tail: Option<Box<VariantDefList> >,
}

pub struct MatchArmList {
    head: MatchArm,
    tail: Option<Box<MatchArmList> >,
}

pub struct StructFieldList {
    head: StructFieldInit,
    tail: Option<Box<StructFieldList> >,
}

pub struct EffectList {
    head: EffectRef,
    tail: Option<Box<EffectList> >,
}

pub struct TypeExprList {
    head: TypeExpr,
    tail: Option<Box<TypeExprList> >,
}

pub struct StringList {
    head_buf: [i8; 128],
    head_len: i64,
    tail: Option<Box<StringList> >,
}

pub struct PatternList {
    head: Pattern,
    tail: Option<Box<PatternList> >,
}

pub struct PatFieldList {
    head: PatField,
    tail: Option<Box<PatFieldList> >,
}

// ============================================================
// String buffer helper (for identifiers, paths)
// ============================================================

pub struct Name {
    pub buf: [i8; 128],
    pub len: i64,
}

// ============================================================
// Path: qualified name like Foo::Bar::baz
// ============================================================

pub struct AstPath {
    segments: StringList,
    seg_count: i64,
}

pub struct AstPathList {
    head: AstPath,
    tail: Option<Box<AstPathList> >,
}

// ============================================================
// Effect reference: IO, Mut, Alloc, Panic, Div, GPU, Prob, Async
// ============================================================

pub struct EffectRef {
    name_buf: [i8; 64],
    name_len: i64,
}

// ============================================================
// Expressions
// ============================================================

pub enum ExprKind {
    // Literals
    ExprIntLit,
    ExprFloatLit,
    ExprBoolTrue,
    ExprBoolFalse,
    ExprStringLit,
    ExprCharLit,

    // Names
    ExprIdent,
    ExprPath,

    // Operators
    ExprBinary,
    ExprUnary,

    // Access
    ExprFieldAccess,
    ExprIndex,
    ExprMethodCall,

    // Calls
    ExprCall,

    // Control flow
    ExprIf,
    ExprMatch,
    ExprWhile,
    ExprLoop,
    ExprBlock,
    ExprReturn,
    ExprBreak,
    ExprContinue,

    // Constructors
    ExprStructLit,
    ExprArrayLit,
    ExprTupleLit,
    ExprContest,
    ExprAuditAttach,

    // Range
    ExprRange,

    // Type cast
    ExprCast,

    // Effect handler: handle<Effect> { body } { handlers }
    ExprHandle,

    // Closure: |params| body
    ExprClosure,

    // For-in: for x in iter { body }
    ExprForIn,

    // Error placeholder
    ExprError,
}

pub enum UnaryOp {
    OpNeg,
    OpNot,
    OpRef,
    OpRefMut,
    OpDeref,
}

pub enum BinaryOp {
    OpAdd,
    OpSub,
    OpMul,
    OpDiv,
    OpRem,
    OpEq,
    OpNe,
    OpLt,
    OpLe,
    OpGt,
    OpGe,
    OpAnd,
    OpOr,
    OpBitAnd,
    OpBitOr,
    OpBitXor,
    OpShl,
    OpShr,
    OpConcat,
    OpRange,
    OpRangeInclusive,
}

pub struct Expr {
    kind: ExprKind,
    span: Span,

    // For IntLit, CharLit
    int_val: i64,

    // For FloatLit
    float_val: f64,

    // For StringLit, Ident, FieldAccess (field name), MethodCall (method name)
    name: Name,

    // For Path, StructLit
    path: AstPath,

    // For Binary
    bin_op: BinaryOp,

    // For Unary
    un_op: UnaryOp,

    // For Binary(left,right), Unary(operand), FieldAccess(base),
    // Index(base), MethodCall(base), Call(callee), If(condition),
    // Match(scrutinee), While(condition), Return(value), Break(value)
    left: Option<Box<Expr> >,

    // For Binary(right), Index(index)
    right: Option<Box<Expr> >,

    // For If(then), While(body), Loop(body), Block
    block: Option<Box<Block> >,

    // For If(else)
    else_expr: Option<Box<Expr> >,

    // For Call(args), MethodCall(args), ArrayLit(elements), TupleLit(elements)
    args: Option<Box<ExprList> >,

    // For Match
    arms: Option<Box<MatchArmList> >,

    // For StructLit
    fields: Option<Box<StructFieldList> >,

    // For Cast (as)
    cast_type: Option<Box<TypeExpr> >,

    // For Handle: handler implementation block (with { ... })
    handler_block: Option<Box<Block> >,

    // For Closure:
    closure_params: Option<Box<ClosureParamList> >,
    closure_return: Option<Box<TypeExpr> >,
    closure_effects: Option<Box<EffectList> >,
    closure_body: Option<Box<Expr> >,

    // For Call with turbofish: func::<T, U>(args)
    type_args: Option<Box<TypeExprList> >,
}

// ============================================================
// Blocks
// ============================================================

pub struct Block {
    stmts: Option<Box<StmtList> >,
    span: Span,
}

// ============================================================
// Statements
// ============================================================

pub enum StmtKind {
    StmtLet,
    StmtVar,
    StmtExpr,
    StmtAssign,
}

pub enum AssignOp {
    AssignEq,
    AssignAdd,
    AssignSub,
    AssignMul,
    AssignDiv,
    AssignRem,
}

pub struct Stmt {
    kind: StmtKind,
    span: Span,

    // For Let/Var: binding name
    name: Name,

    // For Let/Var: optional type annotation
    ty: Option<Box<TypeExpr> >,

    // For Let/Var: initializer; Expr: the expression; Assign: RHS
    expr: Option<Box<Expr> >,

    // For Assign: target (LHS)
    target: Option<Box<Expr> >,

    // For Assign: operator
    assign_op: AssignOp,
}

// ============================================================
// Match arms
// ============================================================

pub struct MatchArm {
    pattern: Pattern,
    guard: Option<Box<Expr> >,
    body: Expr,
    span: Span,
}

// ============================================================
// Struct field initializer (in struct literals)
// ============================================================

pub struct StructFieldInit {
    name: Name,
    value: Expr,
}

// ============================================================
// Patterns
// ============================================================

pub enum PatternKind {
    PatWildcard,
    PatBinding,
    PatIntLit,
    PatBoolTrue,
    PatBoolFalse,
    PatStringLit,
    PatEnum,
    PatStruct,
    PatTuple,
    PatOr,
}

pub struct Pattern {
    kind: PatternKind,
    span: Span,

    // For Binding, IntLit, StringLit
    name: Name,

    // For IntLit
    int_val: i64,

    // For Enum: variant path
    path: AstPath,

    // For Enum: inner patterns; Tuple: elements; Or: alternatives
    sub_patterns: Option<Box<PatternList> >,

    // For Struct: field patterns
    pat_fields: Option<Box<PatFieldList> >,

    // For Binding: mutable?
    is_mut: bool,
}

pub struct PatField {
    name: Name,
    pattern: Pattern,
}

// ============================================================
// Import item list (for selective imports: use path::{A, B})
// ============================================================

pub struct ImportItemList {
    head: Name,
    tail: Option<Box<ImportItemList> >,
}

// ============================================================
// Epistemic types: Knowledge[T, ε, δ, Φ]
// ============================================================

pub enum CompareOp {
    CmpLt,
    CmpLe,
    CmpEq,
    CmpGe,
    CmpGt,
}

pub struct EpsilonBound {
    op: CompareOp,
    value: f64,
}

pub enum AstValidityKind {
    ValidDuration,
    ValidUntilTime,
    ValidWhileCond,
}

pub struct ValidityCondition {
    kind: AstValidityKind,
    expr: Option<Box<Expr> >,
}

pub enum AstProvenanceKind {
    AstProvDerived,
    AstProvSource,
    AstProvComputed,
    AstProvLiterature,
    AstProvMeasured,
    AstProvInput,
}

pub enum KnowledgeConstraintKind {
    KnowledgeConstraintSubclassOf,
    KnowledgeConstraintEq,
    KnowledgeConstraintGe,
    KnowledgeConstraintGt,
    KnowledgeConstraintLe,
    KnowledgeConstraintLt,
}

pub enum KnowledgeConstraintValueKind {
    KnowledgeConstraintValueNone,
    KnowledgeConstraintValueName,
    KnowledgeConstraintValueInt,
    KnowledgeConstraintValueFloat,
}

pub struct KnowledgeConstraint {
    field: Name,
    kind: KnowledgeConstraintKind,
    target_name: Name,
    unit_name: Name,
    int_value: i64,
    float_value: f64,
    value_kind: KnowledgeConstraintValueKind,
}

pub struct KnowledgeConstraintList {
    head: KnowledgeConstraint,
    tail: Option<Box<KnowledgeConstraintList> >,
}

pub struct KnowledgeTypeInfo {
    inner_type: Box<TypeExpr>,
    epsilon: Option<Box<EpsilonBound> >,
    validity: Option<Box<ValidityCondition> >,
    provenance: Option<Box<AstProvenanceKind> >,
    proof_constraints: Option<Box<KnowledgeConstraintList> >,
}

// Forgettable<T> — a type whose value can be exactly annihilated by a ZD element.
// Semantics: values of type Forgettable<T> must be consumed by a ZD operation
// before escaping a `with ZD` function context.
pub struct ForgettableTypeInfo {
    inner_type: Box<TypeExpr>,
    zd_locus: Option<Name>,   // optional: specific ZD element, e.g. "e3e10"
}

// ExactlyPrivate<T> — exact-privacy (G3/G4) stronger than DP: contribution is
// algebraically zero in the ZD kernel, not epsilon-close. Requires `with ZD`.
pub struct ExactlyPrivateTypeInfo {
    inner_type: Box<TypeExpr>,
}

// Editable<T> — locality-bounded model editing (G5). Edits are confined to
// the 4D ZD kernel; complementary 12D subspace is provably intact. Requires `with ZD`.
pub struct EditableTypeInfo {
    inner_type: Box<TypeExpr>,
}

// CapabilityGated<T> — capability containment (G7): values live in a ZD-gated
// subspace and can be exactly annihilated without touching orthogonal
// capabilities. Requires `with ZD`.
pub struct CapabilityGatedTypeInfo {
    inner_type: Box<TypeExpr>,
}

// Composable<T> — ZD-orthogonal model composition (G8). Two Composable
// values merge into one by taking the direct sum along ZD-orthogonal
// complements; neither component's capabilities are perturbed by the other.
// Requires `with ZD`.
pub struct ComposableTypeInfo {
    inner_type: Box<TypeExpr>,
}

// Audited<T> — witness-bearing surgical operation (G9). Every produced value
// carries a machine-checkable derivation in the ZD annihilator kernel, emittable
// as a Lean term. Requires `with ZD, Witness`.
pub struct AuditedTypeInfo {
    inner_type: Box<TypeExpr>,
}

// Revivable<T> — time-bounded reversible surgery (G10). Any surgical
// operation on a Revivable<T> can be inverted within a bounded Temporal
// window, after which the surgery becomes irrevocable. Requires `with ZD, Temporal`.
pub struct RevivableTypeInfo {
    inner_type: Box<TypeExpr>,
}

// Interpretable<T> — AMI (Algebraic Mechanistic Interpretability). A T
// tagged Interpretable declares that its internal representation has a
// canonical decomposition onto the 168-class ZD basis; every activation
// can be written uniquely as a weighted sum of the 168 fixed annihilator-
// equivalence classes, giving a deterministic alternative to
// SAE/transcoder-based interpretability. Requires `with ZD`.
pub struct InterpretableTypeInfo {
    inner_type: Box<TypeExpr>,
}

