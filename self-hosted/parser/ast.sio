// Self-hosted Sounio AST types
// Uses tagged structs with Option<Box<T> > for recursive children
// and linked lists for sequences (Vec<T> unavailable for user types).

module parser::ast

use lexer::span::{Span}

// ============================================================
// Node ID
// ============================================================

pub struct NodeId { pub id: i64 }

fn next_node_id(current: i64) -> NodeId {
    NodeId { id: current + 1 }
}

// ============================================================
// Linked-list containers for AST node sequences
// ============================================================

pub struct ExprList {
    pub label: Name,
    pub head: Expr,
    pub tail: Option<Box<ExprList> >,
}

pub struct StmtList {
    pub head: Stmt,
    pub tail: Option<Box<StmtList> >,
}

pub struct ItemList {
    pub head: Item,
    pub tail: Option<Box<ItemList> >,
}

pub struct ParamList {
    pub head: Param,
    pub tail: Option<Box<ParamList> >,
}

pub struct ClosureParam {
    pub name: Name,
    pub ty: TypeExpr,
    pub span: Span,
}

pub struct ClosureParamList {
    pub head: ClosureParam,
    pub tail: Option<Box<ClosureParamList> >,
}

pub struct TypeParamDef {
    pub name: Name,
    pub span: Span,
}

pub struct TypeParamDefList {
    pub head: TypeParamDef,
    pub tail: Option<Box<TypeParamDefList> >,
}

pub struct FieldDefList {
    pub head: FieldDef,
    pub tail: Option<Box<FieldDefList> >,
}

pub struct VariantDefList {
    pub head: VariantDef,
    pub tail: Option<Box<VariantDefList> >,
}

pub struct MatchArmList {
    pub head: MatchArm,
    pub tail: Option<Box<MatchArmList> >,
}

pub struct StructFieldList {
    pub head: StructFieldInit,
    pub tail: Option<Box<StructFieldList> >,
}

pub struct EffectList {
    pub head: EffectRef,
    pub tail: Option<Box<EffectList> >,
}

pub struct TypeExprList {
    pub head: TypeExpr,
    pub tail: Option<Box<TypeExprList> >,
}

pub struct StringList {
    // Width matches Name.buf (384). Path segments and Name round-trip without
    // a silent narrow at the field boundary.
    pub head_buf: [i8; 384],
    pub head_len: i64,
    pub tail: Option<Box<StringList> >,
}

pub struct PatternList {
    pub head: Pattern,
    pub tail: Option<Box<PatternList> >,
}

pub struct PatFieldList {
    pub head: PatField,
    pub tail: Option<Box<PatFieldList> >,
}

// ============================================================
// String buffer helper (for identifiers, paths)
// ============================================================

pub struct Name {
    pub buf: [i8; 384],
    pub len: i64,
}

// ============================================================
// Path: qualified name like Foo::Bar::baz
// ============================================================

pub struct AstPath {
    pub segments: StringList,
    pub seg_count: i64,
}

pub struct AstPathList {
    pub head: AstPath,
    pub tail: Option<Box<AstPathList> >,
}

// ============================================================
// Effect reference: IO, Mut, Alloc, Panic, Div, GPU, Prob, Async
// ============================================================

pub struct EffectRef {
    pub name_buf: [i8; 64],
    pub name_len: i64,
    // Payload of a parameterised effect, e.g. the 950 in `with Epistemic(950)`.
// `has_payload` distinguishes an absent payload from every numeric value.
    // Before payload existed the value was parsed and discarded, so
    // Epistemic(950) and Epistemic(400) were the same effect to the compiler.
    pub payload: i64,
    pub has_payload: bool,
}

// ============================================================
// Expressions
// ============================================================

pub enum ExprKind {
    // Literals
    ExprIntLit,
    ExprFloatLit,
    ExprBoolTrue,
    ExprBoolFalse,
    ExprStringLit,
    ExprCharLit,

    // Names
    ExprIdent,
    ExprPath,

    // Operators
    ExprBinary,
    ExprUnary,

    // Access
    ExprFieldAccess,
    ExprIndex,
    ExprMethodCall,

    // Calls
    ExprCall,

    // Control flow
    ExprIf,
    ExprMatch,
    ExprWhile,
    ExprLoop,
    ExprBlock,
    ExprReturn,
    ExprBreak,
    ExprContinue,

    // Constructors
    ExprStructLit,
    ExprArrayLit,
    ExprTupleLit,
    ExprContest,
    ExprAuditAttach,

    // Range
    ExprRange,

    // Type cast
    ExprCast,

    // Effect handler: handle<Effect> { body } { handlers }
    ExprHandle,

    // Closure: |params| body
    ExprClosure,

    // For-in: for x in iter { body }
    ExprForIn,

    // The discharged-d-separation credential. Produced ONLY by the parser's
    // rewrite of a `d_separated(A, B | Z)` call (see parser/exprs.sio); no
    // grammar production writes this node directly, so it cannot appear in
    // source text a human typed. Its static type is TyDsepProof.
    ExprDsepProof,

    // Error placeholder
    ExprError,
}

pub enum UnaryOp {
    OpNeg,
    OpNot,
    OpRef,
    OpRefMut,
    OpDeref,
    OpBitNot,
}

pub enum BinaryOp {
    OpAdd,
    OpSub,
    OpMul,
    OpDiv,
    OpRem,
    OpEq,
    OpNe,
    OpLt,
    OpLe,
    OpGt,
    OpGe,
    OpAnd,
    OpOr,
    OpBitAnd,
    OpBitOr,
    OpBitXor,
    OpShl,
    OpShr,
    OpConcat,
    OpRange,
    OpRangeInclusive,
    // Unsigned variants: chosen by the type checker for u8/u16/u32/u64 operands.
    // On x86_64 these route to `div r/m64` / `shr rax, cl`; on aarch64 to
    // `udiv`/`msub` / `lsr`. Only the three ops whose x86 encoding actually
    // differs between signed and unsigned semantics need a distinct variant.
    // (Shifts left, and bitwise ops, are signedness-agnostic at the ISA level.)
    OpUDiv,
    OpURem,
    OpUShr,
}

pub struct Expr {
    pub kind: ExprKind,
    pub span: Span,

    // For IntLit, CharLit
    pub int_val: i64,

    // For FloatLit
    pub float_val: f64,

    // For FloatLit (V0-E.5.9): exact binary128 identity of the literal's
    // SOURCE TEXT, computed once by the parser (parser/f128_literal.sio) with
    // no f64 on the path. `f128_lit_exact == false` means the text is not
    // exactly representable in binary128 (0.1, 2.5e-3, a 29-hex-digit
    // mantissa, an out-of-range exponent) and every f128 consumer must fail
    // closed. Carried here, on the node — never in a side table.
    pub f128_lit_lo: i64,
    pub f128_lit_hi: i64,
    pub f128_lit_exact: bool,

    // For StringLit, Ident, FieldAccess (field name), MethodCall (method name)
    pub name: Name,

    // For Path, StructLit
    pub path: AstPath,

    // For Binary
    pub bin_op: BinaryOp,

    // For Unary
    pub un_op: UnaryOp,

    // For Binary(left,right), Unary(operand), FieldAccess(base),
    // Index(base), MethodCall(base), Call(callee), If(condition),
    // Match(scrutinee), While(condition), Return(value), Break(value)
    pub left: Option<Box<Expr> >,

    // For Binary(right), Index(index)
    pub right: Option<Box<Expr> >,

    // For If(then), While(body), Loop(body), Block
    pub block: Option<Box<Block> >,

    // For If(else)
    pub else_expr: Option<Box<Expr> >,

    // For Call(args), MethodCall(args), ArrayLit(elements), TupleLit(elements)
    pub args: Option<Box<ExprList> >,

    // For Match
    pub arms: Option<Box<MatchArmList> >,

    // For StructLit
    pub fields: Option<Box<StructFieldList> >,

    // For Cast (as)
    pub cast_type: Option<Box<TypeExpr> >,

    // For Handle: handler implementation block (with { ... })
    pub handler_block: Option<Box<Block> >,

    // For Closure:
    pub closure_params: Option<Box<ClosureParamList> >,
    pub closure_return: Option<Box<TypeExpr> >,
    pub closure_effects: Option<Box<EffectList> >,
    pub closure_body: Option<Box<Expr> >,

    // For Call with turbofish: func::<T, U>(args)
    pub type_args: Option<Box<TypeExprList> >,
}

// ============================================================
// Blocks
// ============================================================

pub struct Block {
    pub stmts: Option<Box<StmtList> >,
    pub span: Span,
}

// ============================================================
// Statements
// ============================================================

pub enum StmtKind {
    StmtLet,
    StmtVar,
    StmtExpr,
    StmtAssign,
}

pub enum AssignOp {
    AssignEq,
    AssignAdd,
    AssignSub,
    AssignMul,
    AssignDiv,
    AssignRem,
}

pub struct Stmt {
    pub kind: StmtKind,
    pub span: Span,

    // For Let/Var: binding name
    pub name: Name,

    // For Let/Var: optional type annotation
    pub ty: Option<Box<TypeExpr> >,

    // For Let/Var: initializer; Expr: the expression; Assign: RHS
    pub expr: Option<Box<Expr> >,

    // For Assign: target (LHS)
    pub target: Option<Box<Expr> >,

    // For Assign: operator
    pub assign_op: AssignOp,
}

// ============================================================
// Match arms
// ============================================================

pub struct MatchArm {
    pub pattern: Pattern,
    pub guard: Option<Box<Expr> >,
    pub body: Expr,
    pub span: Span,
}

// ============================================================
// Struct field initializer (in struct literals)
// ============================================================

pub struct StructFieldInit {
    pub name: Name,
    pub value: Expr,
}

// ============================================================
// Patterns
// ============================================================

pub enum PatternKind {
    PatWildcard,
    PatBinding,
    PatIntLit,
    PatBoolTrue,
    PatBoolFalse,
    PatStringLit,
    PatEnum,
    PatStruct,
    PatTuple,
    PatOr,
}

pub struct Pattern {
    pub kind: PatternKind,
    pub span: Span,

    // For Binding, IntLit, StringLit
    pub name: Name,

    // For IntLit
    pub int_val: i64,

    // For Enum: variant path
    pub path: AstPath,

    // For Enum: inner patterns; Tuple: elements; Or: alternatives
    pub sub_patterns: Option<Box<PatternList> >,

    // For Struct: field patterns
    pub pat_fields: Option<Box<PatFieldList> >,

    // For Binding: mutable?
    pub is_mut: bool,
}

pub struct PatField {
    pub name: Name,
    pub pattern: Pattern,
}

// ============================================================
// Import item list (for selective imports: use path::{A, B})
// ============================================================

pub struct ImportItemList {
    pub head: Name,
    pub tail: Option<Box<ImportItemList> >,
}

// ============================================================
// Epistemic types: Knowledge[T, ε, δ, Φ]
// ============================================================

pub enum CompareOp {
    CmpLt,
    CmpLe,
    CmpEq,
    CmpGe,
    CmpGt,
}

pub struct EpsilonBound {
    pub op: CompareOp,
    pub value: f64,
}

pub enum AstValidityKind {
    ValidDuration,
    ValidUntilTime,
    ValidWhileCond,
}

pub struct ValidityCondition {
    pub kind: AstValidityKind,
    pub expr: Option<Box<Expr> >,
}

pub enum AstProvenanceKind {
    AstProvDerived,
    AstProvSource,
    AstProvComputed,
    AstProvLiterature,
    AstProvMeasured,
    AstProvInput,
}

pub enum KnowledgeConstraintKind {
    KnowledgeConstraintSubclassOf,
    KnowledgeConstraintEq,
    KnowledgeConstraintGe,
    KnowledgeConstraintGt,
    KnowledgeConstraintLe,
    KnowledgeConstraintLt,
}

pub enum KnowledgeConstraintValueKind {
    KnowledgeConstraintValueNone,
    KnowledgeConstraintValueName,
    KnowledgeConstraintValueInt,
    KnowledgeConstraintValueFloat,
}

pub struct KnowledgeConstraint {
    pub field: Name,
    pub kind: KnowledgeConstraintKind,
    pub target_name: Name,
    pub unit_name: Name,
    pub int_value: i64,
    pub float_value: f64,
    pub value_kind: KnowledgeConstraintValueKind,
}

pub struct KnowledgeConstraintList {
    pub head: KnowledgeConstraint,
    pub tail: Option<Box<KnowledgeConstraintList> >,
}

pub struct KnowledgeTypeInfo {
    pub inner_type: Box<TypeExpr>,
    pub epsilon: Option<Box<EpsilonBound> >,
    pub validity: Option<Box<ValidityCondition> >,
    pub provenance: Option<Box<AstProvenanceKind> >,
    pub proof_constraints: Option<Box<KnowledgeConstraintList> >,
}

// Forgettable<T> — a type whose value can be exactly annihilated by a ZD element.
// Semantics: values of type Forgettable<T> must be consumed by a ZD operation
// before escaping a `with ZD` function context.
pub struct ForgettableTypeInfo {
    pub inner_type: Box<TypeExpr>,
    pub zd_locus: Option<Name>,   // optional: specific ZD element, e.g. "e3e10"
}

// ExactlyPrivate<T> — exact-privacy (G3/G4) stronger than DP: contribution is
// algebraically zero in the ZD kernel, not epsilon-close. Requires `with ZD`.
pub struct ExactlyPrivateTypeInfo {
    pub inner_type: Box<TypeExpr>,
}

// Editable<T> — locality-bounded model editing (G5). Edits are confined to
// the 4D ZD kernel; complementary 12D subspace is provably intact. Requires `with ZD`.
pub struct EditableTypeInfo {
    pub inner_type: Box<TypeExpr>,
}

// CapabilityGated<T> — capability containment (G7): values live in a ZD-gated
// subspace and can be exactly annihilated without touching orthogonal
// capabilities. Requires `with ZD`.
pub struct CapabilityGatedTypeInfo {
    pub inner_type: Box<TypeExpr>,
}

// Composable<T> — ZD-orthogonal model composition (G8). Two Composable
// values merge into one by taking the direct sum along ZD-orthogonal
// complements; neither component's capabilities are perturbed by the other.
// Requires `with ZD`.
pub struct ComposableTypeInfo {
    pub inner_type: Box<TypeExpr>,
}

// Audited<T> — witness-bearing surgical operation (G9). Every produced value
// carries a machine-checkable derivation in the ZD annihilator kernel, emittable
// as a Lean term. Requires `with ZD, Witness`.
pub struct AuditedTypeInfo {
    pub inner_type: Box<TypeExpr>,
}

// Revivable<T> — time-bounded reversible surgery (G10). Any surgical
// operation on a Revivable<T> can be inverted within a bounded Temporal
// window, after which the surgery becomes irrevocable. Requires `with ZD, Temporal`.
pub struct RevivableTypeInfo {
    pub inner_type: Box<TypeExpr>,
}

// Interpretable<T> — AMI (Algebraic Mechanistic Interpretability). A T
// tagged Interpretable declares that its internal representation has a
// canonical decomposition onto the 168-class ZD basis; every activation
// can be written uniquely as a weighted sum of the 168 fixed annihilator-
// equivalence classes, giving a deterministic alternative to
// SAE/transcoder-based interpretability. Requires `with ZD`.
pub struct InterpretableTypeInfo {
    pub inner_type: Box<TypeExpr>,
}

