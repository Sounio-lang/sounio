// ============================================================================
// Visibility hierarchy
// ============================================================================
// Sounio does not yet support enum variants with payloads, so visibility is
// represented as a tagged struct.  The parser accepts:
//   (omitted)      -> Private
//   pub            -> Pub
//   pub(crate)     -> PubCrate
//   pub(super)     -> PubSuper
//   pub(path::to)  -> PubIn(path::to)

pub struct Visibility {
    kind: i64,
    path: AstPath,
}

let VISIBILITY_PRIVATE: i64 = 0
let VISIBILITY_PUB: i64 = 1
let VISIBILITY_PUB_CRATE: i64 = 2
let VISIBILITY_PUB_SUPER: i64 = 3
let VISIBILITY_PUB_IN: i64 = 4

pub fn visibility_private() -> Visibility {
    Visibility { kind: VISIBILITY_PRIVATE, path: empty_path() }
}

pub fn visibility_pub() -> Visibility {
    Visibility { kind: VISIBILITY_PUB, path: empty_path() }
}

pub fn visibility_pub_crate() -> Visibility {
    Visibility { kind: VISIBILITY_PUB_CRATE, path: empty_path() }
}

pub fn visibility_pub_super() -> Visibility {
    Visibility { kind: VISIBILITY_PUB_SUPER, path: empty_path() }
}

pub fn visibility_pub_in(path: AstPath) -> Visibility {
    Visibility { kind: VISIBILITY_PUB_IN, path: path }
}

pub fn visibility_is_pub(v: Visibility) -> bool {
    v.kind == VISIBILITY_PUB
}

pub fn visibility_to_bool(v: Visibility) -> bool {
    v.kind != VISIBILITY_PRIVATE
}

pub struct Item {
    kind: ItemKind,
    span: Span,

    // Visibility of this item.  The parser produces this from `pub`,
    // `pub(crate)`, `pub(super)`, or `pub(path)`.  Private by default.
    visibility: Visibility,

    // For all: item name
    name: Name,

    // For Fn
    fn_def: Option<Box<FnDef> >,

    // For Struct
    struct_def: Option<Box<StructDef> >,

    // For Enum
    enum_def: Option<Box<EnumDef> >,

    // For Impl
    impl_def: Option<Box<ImplDef> >,

    // For TypeAlias
    type_alias_ty: Option<Box<TypeExpr> >,

    // For Policy
    policy_def: Option<Box<PolicyDef> >,

    // For AcquisitionPolicy
    acquisition_policy_def: Option<Box<AcquisitionPolicyDef> >,

    // For RecoursePolicy
    recourse_policy_def: Option<Box<RecoursePolicyDef> >,

    // For DecisionPolicy
    decision_policy_def: Option<Box<DecisionPolicyDef> >,

    // For DeferralPolicy
    deferral_policy_def: Option<Box<DeferralPolicyDef> >,

    // For TransitionPolicy
    transition_policy_def: Option<Box<TransitionPolicyDef> >,

    // For TransitionProtocol
    transition_protocol_def: Option<Box<TransitionProtocolDef> >,

    // For MonitoringPolicy
    monitoring_policy_def: Option<Box<MonitoringPolicyDef> >,

    // For AlternativePolicy
    alternative_policy_def: Option<Box<AlternativePolicyDef> >,

    // For AlternativeFrontier
    alternative_frontier_def: Option<Box<AlternativeFrontierDef> >,

    // For Models
    models_def: Option<Box<ModelsDef> >,

    // For Validation
    validation_def: Option<Box<ValidationDef> >,

    // For Audit
    audit_def: Option<Box<AuditDef> >,

    // For Use
    use_path: AstPath,
    use_glob: bool,
    use_items: Option<Box<ImportItemList> >,

    // For Effect
    effect_def: Option<Box<EffectDef> >,

    // For Session
    session_decl: Option<Box<SessionDecl> >,

    // For Trait
    trait_def: Option<Box<TraitItemDef> >,

    // For Algebra
    algebra_def: Option<Box<AlgebraDef> >,

    // For Study
    study_def: Option<Box<StudyDef> >,

    // For Ontology
    ontology_def: Option<Box<OntologyDef> >,
}

// ============================================================
// Function definition
// ============================================================

pub struct FnDef {
    name: Name,
    params: Option<Box<ParamList> >,
    return_type: Option<Box<TypeExpr> >,
    effects: Option<Box<EffectList> >,
    body: Block,
    span: Span,
    is_kernel: bool,
}

pub struct Param {
    name: Name,
    ty: TypeExpr,
    is_self: bool,
    is_self_mut: bool,
    span: Span,
}

// ============================================================
// Struct definition
// ============================================================

pub struct StructDef {
    name: Name,
    type_params: Option<Box<TypeParamDefList> >,
    fields: Option<Box<FieldDefList> >,
    is_linear: bool,
    is_affine: bool,
    span: Span,
}

pub struct FieldDef {
    name: Name,
    ty: TypeExpr,
    span: Span,
}

// ============================================================
// Enum definition
// ============================================================

pub struct EnumDef {
    name: Name,
    variants: Option<Box<VariantDefList> >,
    span: Span,
}

pub struct VariantDef {
    name: Name,
    fields: Option<Box<FieldDefList> >,
    span: Span,
}

// ============================================================
// Impl definition
// ============================================================

pub struct ImplDef {
    target_type: TypeExpr,
    methods: Option<Box<ItemList> >,
    span: Span,
    // For `impl TraitName for Type { }` — trait_name.len > 0 when present
    trait_name: Name,
}

// Trait definition: trait Name { fn method1(); fn method2(); ... }
pub struct TraitItemDef {
    name: Name,
    methods: Option<Box<ItemList> >,
    supertraits: Option<Box<TypeExprList> >,
    span: Span,
}

// ============================================================
// Algebra declaration
// ============================================================

// Algebraic properties for an operation (stored as boolean flags)
pub struct AlgebraOpDecl {
    op_name: Name,           // "add" or "mul"
    is_commutative: bool,
    is_associative: bool,
    is_alternative: bool,    // Artin's theorem: (aa)b = a(ab), (ba)a = b(aa)
    span: Span,
}

pub struct AlgebraOpDeclList {
    head: AlgebraOpDecl,
    tail: Option<Box<AlgebraOpDeclList> >,
}

pub struct AlgebraDef {
    name: Name,
    over_type: Option<Box<TypeExpr> >,
    ops: Option<Box<AlgebraOpDeclList> >,
    reassoc_strategy: i64,   // 0=free, 1=blocked, 2=fano_selective
    span: Span,
}

pub struct StudyHypothesis {
    name: Name,
    outcome: Name,
    direction: i32,      // 0=greater, 1=less, 2=not_equal
    effect_size: f64,
}

pub struct StudyOutcome {
    name: Name,
    is_primary: bool,
}

pub struct StudyDef {
    name: Name,
    title: Name,
    registration: Name,
    design: i32,          // 0=parallel_rct, 1=crossover, 2=cohort, 3=case_control
    sample_size: i64,
    power: f64,
    alpha: f64,
    correction: i32,      // 0=none, 1=bonferroni, 2=benjamini_hochberg
    hypotheses: [StudyHypothesis; 8],
    n_hypotheses: i32,
    outcomes: [StudyOutcome; 16],
    n_outcomes: i32,
}

pub fn empty_study_hypothesis() -> StudyHypothesis {
    StudyHypothesis {
        name: Name { buf: [0; 128], len: 0 },
        outcome: Name { buf: [0; 128], len: 0 },
        direction: 0,
        effect_size: 0.0,
    }
}

pub fn empty_study_outcome() -> StudyOutcome {
    StudyOutcome {
        name: Name { buf: [0; 128], len: 0 },
        is_primary: false,
    }
}

// ============================================================
// Ontology declaration
// ============================================================

// Ontology property: `property name: type where name op value`
// op: 1=Gt, 2=GtEq, 3=Lt, 4=LtEq, 5=Eq, 6=NotEq (matches RefinementPred ops)
pub struct OntologyPropertyDecl {
    name: Name,
    type_name: Name,       // "f64" or "i64"
    pred_op: i64,          // comparison operator (1-6, 0=none)
    pred_rhs_int: i64,
    pred_rhs_float: f64,
    is_float: bool,
    span: Span,
}

pub struct OntologyClassDecl {
    name: Name,
    superclass_names: [Name; 8],
    superclass_count: i64,
    properties: [OntologyPropertyDecl; 8],
    property_count: i64,
    span: Span,
}

pub fn empty_ontology_property_decl() -> OntologyPropertyDecl {
    OntologyPropertyDecl {
        name: Name { buf: [0; 128], len: 0 },
        type_name: Name { buf: [0; 128], len: 0 },
        pred_op: 0,
        pred_rhs_int: 0,
        pred_rhs_float: 0.0,
        is_float: false,
        span: Span { file_id: 0, start: 0, end: 0 },
    }
}

pub struct OntologyClassDeclList {
    head: OntologyClassDecl,
    tail: Option<Box<OntologyClassDeclList> >,
}

pub struct OntologyDisjointDecl {
    name_a: Name,
    name_b: Name,
    span: Span,
}

pub struct OntologyDisjointDeclList {
    head: OntologyDisjointDecl,
    tail: Option<Box<OntologyDisjointDeclList> >,
}

pub struct OntologyRoleDecl {
    name: Name,
    domain_name: Name,
    range_name: Name,
    inverse_name: Name,
    has_domain: bool,
    has_range: bool,
    has_inverse: bool,
    is_transitive: bool,
    is_functional: bool,
    is_symmetric: bool,
    duplicate_modifier_bits: i64,
    span: Span,
}

pub struct OntologyRoleDeclList {
    head: OntologyRoleDecl,
    tail: Option<Box<OntologyRoleDeclList> >,
}

pub struct OntologyDef {
    name: Name,
    classes: Option<Box<OntologyClassDeclList> >,
    disjoints: Option<Box<OntologyDisjointDeclList> >,
    roles: Option<Box<OntologyRoleDeclList> >,
    span: Span,
}

// ============================================================
// Top-level program
// ============================================================

pub struct Program {
    // Identity of this program when treated as a module.
    // For flat compilation (single unit), this is typically empty.
    module_path: AstPath,
    items: Option<Box<ItemList> >,
}

// Construct an empty AstPath (used by module_loader and other consumers)
pub fn empty_path() -> AstPath {
    AstPath { segments: StringList { head_buf: [0; 128], head_len: 0, tail: None }, seg_count: 0 }
}

// Check if a Name is empty (zero-length)
pub fn name_is_empty(n: Name) -> bool {
    n.len == 0
}

// Construct an empty Name
pub fn empty_name() -> Name {
    Name { buf: [0; 128], len: 0 }
}

// Construct a Name from a string literal
pub fn make_name(s: string) -> Name with Mut, Panic, Div {
    let len = str_len(s)
    var n = Name { buf: [0; 128], len: len }
    var i: i64 = 0
    while i < len && i < 128 {
        n.buf[i as usize] = str_char_at(s, i) as i8
        i = i + 1
    }
    n
}

// Name comparison — byte-by-byte equality
pub fn name_eq(a: Name, b: Name) -> bool with Mut, Panic, Div {
    if a.len != b.len { return false }
    var i: i64 = 0
    while i < a.len {
        if a.buf[i as usize] != b.buf[i as usize] { return false }
        i = i + 1
    }
    true
}

// ============================================================
// Global variable initializer side table
// ============================================================

pub var GLOBAL_VAR_INIT_COUNT: i64 = 0
pub var GLOBAL_VAR_INIT_HASHES: [i64; 128] = [0; 128]
pub var GLOBAL_VAR_INIT_VALUES: [i64; 128] = [0; 128]
// When 1, parse_items_preloaded does NOT reset the global-init table, so a
// multi-module compilation accumulates every module's f64 global initializers
// (main is parsed first, then each import). The multimodule lower entry sets it
// after resetting once; single-module and per-program-test parses leave it 0 and
// keep the per-parse reset (isolation between independent programs).
pub var GLOBAL_VAR_INIT_SUPPRESS_RESET: i64 = 0

// Wave15e string-literal global encoding inside GLOBAL_VAR_INIT_* (same table
// as i64/f64 words so the seed-proven accumulate path is reused):
//   word[0] = AST_BSS_INIT_STRING_MAGIC
//   word[1] = payload_len (quotes stripped, escapes not expanded here)
//   word[2..] = little-endian packed payload bytes (8 per word)
// lower reconstructs a Name for codegen LEA+BSS store.
pub let AST_BSS_INIT_STRING_MAGIC: i64 = 0 - 800001

pub fn ast_name_hash(n: Name) -> i64 with Div {
    var hash: i64 = 5381
    var i = 0
    while i < n.len {
        hash = hash * 33 + (n.buf[i as usize] as i64)
        i = i + 1
    }
    if hash < 0 { 0 - hash } else { hash }
}

pub fn ast_reset_global_var_inits() with Mut {
    GLOBAL_VAR_INIT_COUNT = 0
}

pub fn ast_record_global_var_init(name: Name, value: i64) with Mut, Div {
    if GLOBAL_VAR_INIT_COUNT < 128 {
        GLOBAL_VAR_INIT_HASHES[GLOBAL_VAR_INIT_COUNT as usize] = ast_name_hash(name)
        GLOBAL_VAR_INIT_VALUES[GLOBAL_VAR_INIT_COUNT as usize] = value
        GLOBAL_VAR_INIT_COUNT = GLOBAL_VAR_INIT_COUNT + 1
    }
}

// Strip surrounding `"` from a string-literal Name (token text form).
// Escape expansion is applied later by ir_normalize_string_literal_name when
// the payload is reconstructed as a Name that still has no surrounding quotes.
pub fn ast_string_lit_payload(lit: Name) -> Name {
    var out = empty_name()
    var start: i64 = 0
    var end = lit.len
    if lit.len >= 2 && lit.buf[0] == 34 as i8 && lit.buf[(lit.len - 1) as usize] == 34 as i8 {
        start = 1
        end = lit.len - 1
    }
    var i = start
    while i < end && out.len < 128 {
        out.buf[out.len as usize] = lit.buf[i as usize]
        out.len = out.len + 1
        i = i + 1
    }
    out
}

// Pack a string-literal global into GLOBAL_VAR_INIT_* as magic+len+bytes.
// Reuses the integer-word side table (proven under multi-mod suppress-reset).
pub fn ast_record_global_str_init(name: Name, lit: Name) with Mut, Div {
    let payload = ast_string_lit_payload(lit)
    // Budget: magic + len + ceil(len/8) words must fit remaining table slots.
    let words_needed = 2 + (payload.len + 7) / 8
    if GLOBAL_VAR_INIT_COUNT + words_needed > 128 {
        return
    }
    ast_record_global_var_init(name, AST_BSS_INIT_STRING_MAGIC)
    ast_record_global_var_init(name, payload.len)
    var off: i64 = 0
    while off < payload.len {
        var word: i64 = 0
        var place: i64 = 1
        var b: i64 = 0
        while b < 8 && off + b < payload.len {
            let byte = payload.buf[(off + b) as usize] as i64
            // little-endian pack without relying on variable shift amounts
            if byte < 0 {
                word = word + ((byte + 256) * place)
            } else {
                word = word + (byte * place)
            }
            place = place * 256
            b = b + 1
        }
        ast_record_global_var_init(name, word)
        off = off + 8
    }
}

pub fn ast_lookup_global_var_init(name: Name) -> i64 with Div {
    let h = ast_name_hash(name)
    var i: i64 = 0
    while i < GLOBAL_VAR_INIT_COUNT {
        if GLOBAL_VAR_INIT_HASHES[i as usize] == h {
            return GLOBAL_VAR_INIT_VALUES[i as usize]
        }
        i = i + 1
    }
    0
}

// Count of recorded init words for `name`. Scalar / array-repeat → 1;
// element-list `[a,b,c]` → N. Zero means "no recorded initializer".
// Distinct from lookup(value)==0: a recorded zero fill still counts as present.
pub fn ast_global_var_init_count(name: Name) -> i64 with Div {
    let h = ast_name_hash(name)
    var n: i64 = 0
    var i: i64 = 0
    while i < GLOBAL_VAR_INIT_COUNT {
        if GLOBAL_VAR_INIT_HASHES[i as usize] == h {
            n = n + 1
        }
        i = i + 1
    }
    n
}

// Nth recorded init word for `name` (0-based, source order). Returns 0 if out of range.
pub fn ast_global_var_init_nth(name: Name, index: i64) -> i64 with Div {
    let h = ast_name_hash(name)
    var seen: i64 = 0
    var i: i64 = 0
    while i < GLOBAL_VAR_INIT_COUNT {
        if GLOBAL_VAR_INIT_HASHES[i as usize] == h {
            if seen == index {
                return GLOBAL_VAR_INIT_VALUES[i as usize]
            }
            seen = seen + 1
        }
        i = i + 1
    }
    0
}

// 1 if GLOBAL_VAR_INIT words for `name` encode a string literal (Wave15e).
// Defined after count/nth — no forward references.
pub fn ast_global_str_init_present(name: Name) -> i64 with Div {
    let c = ast_global_var_init_count(name)
    if c < 2 {
        return 0
    }
    if ast_global_var_init_nth(name, 0) == AST_BSS_INIT_STRING_MAGIC {
        return 1
    }
    0
}

// Reconstruct payload Name from packed GLOBAL_VAR_INIT words (no surrounding quotes).
pub fn ast_global_str_init_name(name: Name) -> Name with Div {
    if ast_global_str_init_present(name) == 0 {
        return empty_name()
    }
    let plen = ast_global_var_init_nth(name, 1)
    var out = empty_name()
    if plen <= 0 {
        return out
    }
    var wi: i64 = 0
    let nwords = (plen + 7) / 8
    while wi < nwords {
        var word = ast_global_var_init_nth(name, 2 + wi)
        var b: i64 = 0
        while b < 8 && out.len < plen && out.len < 128 {
            let byte = word - (word / 256) * 256
            if byte < 0 {
                out.buf[out.len as usize] = (byte + 256) as i8
            } else {
                out.buf[out.len as usize] = byte as i8
            }
            out.len = out.len + 1
            word = word / 256
            b = b + 1
        }
        wi = wi + 1
    }
    out
}
