pub enum TypeExprKind {
    TypeNamed,
    TypeReference,
    TypeRefMut,
    TypeRawPtr,
    TypeArray,
    TypeTuple,
    TypeFn,
    TypeUnit,
    TypeNever,
    TypeSelfUpper,
    TypeInfer,
    TypeKnowledge,
    TypeForgettable,       // Forgettable<T>      — ZD-annihilable wrapper type
    TypeExactlyPrivate,    // ExactlyPrivate<T>   — exact privacy via ZD (G3/G4)
    TypeEditable,          // Editable<T>         — ZD-local model editing (G5)
    TypeCapabilityGated,   // CapabilityGated<T>  — ZD-gated capability (G7)
    TypeComposable,        // Composable<T>       — ZD-orthogonal model merge (G8)
    TypeAudited,           // Audited<T>          — witness-bearing surgery (G9)
    TypeRevivable,         // Revivable<T>        — time-bounded reversible surgery (G10)
    TypeInterpretable,     // Interpretable<T>    — 168-ZD-basis AMI decomposition
    TypeModel,
    TypePolicy,
    TypeAcquisitionPolicy,
    TypeAcquisitionPlan,
    TypeRecoursePolicy,
    TypeRecoursePlan,
    TypeTransitionPolicy,
    TypeTransitionPlan,
    TypeMonitoringPolicy,
    TypeObservedTransition,
    TypeRollbackCertificate,
    TypeDecisionPolicy,
    TypeDeferralPolicy,
    TypeAlternativePolicy,
    TypeAlternativeSet,
    TypeAlternativeOption,
    TypeContest,
    TypeRobust,
    TypeIntervention,
    TypeCounterfactual,
    TypeValidated,
    TypeAdmissible,
    TypeDeferred,
    TypeRefinement,
    TypeChan,
    TypeSession,
    // Sprint 27: Annotation syntax
    TypeDiffPrivate,
    TypeDPBudget,
    TypeCausalEffect,
    TypeAleatoric,
    TypePotentialOutcome,
    TypeProof,
    TypeLemma,
    TypeAxiom,
}

// Refinement predicate — parsed from `{ x: T | x > 0 }`
// pred_op: 1=Gt, 2=GtEq, 3=Lt, 4=LtEq, 5=Eq, 6=NotEq
pub struct RefinementInfo {
    pub var_name: Name,
    pub base_type: Option<Box<TypeExpr> >,
    pub pred_op: i64,
    pub pred_int_val: i64,
    pub pred_float_val: f64,
    pub pred_is_float: bool,
    pub compound_op: i64,
    pub pred2_op: i64,
    pub pred2_int_val: i64,
    pub pred2_float_val: f64,
    pub pred2_is_float: bool,
}

pub struct TypeExpr {
    pub kind: TypeExprKind,
    pub span: Span,

    // For Named: type path (e.g. Vec, Option, Foo::Bar)
    pub path: AstPath,

    // For Named: generic args; Tuple: elements; Fn: params
    pub type_args: Option<Box<TypeExprList> >,

    // For Reference, RefMut, Array: inner type; Fn: return type
    pub inner: Option<Box<TypeExpr> >,

    // For Array: size expression
    pub array_size: Option<Box<Expr> >,

    // For Fn: effect list
    pub effects: Option<Box<EffectList> >,

    // For Knowledge: full epistemic type info
    pub knowledge_info: Option<Box<KnowledgeTypeInfo> >,

    // For Refinement: { var: Type | predicate }
    pub refinement_info: Option<Box<RefinementInfo> >,
}

