        if len > 0 {
            let ch0 = CURSOR_SOURCE[start as usize]
            if (ch0 >= (97 as i8) && ch0 <= (122 as i8)) ||
               (ch0 >= (65 as i8) && ch0 <= (90 as i8)) ||
               ch0 == (95 as i8) {
                return TokenKind::Ident
            }
        }
        if code == 185 {
            if len == 1 && CURSOR_SOURCE[start as usize] == (35 as i8) {
                return TokenKind::Hash
            }
            return TokenKind::Ident
        }
        if code == 123 {
            return TokenKind::Ident
        }
        if len == 2 &&
           CURSOR_SOURCE[start as usize] == (102 as i8) &&
           CURSOR_SOURCE[(start + 1) as usize] == (110 as i8) {
            return TokenKind::Fn
        }
        token_kind_from_flat_code(code)
    } else {
        TokenKind::Eof
    }
}

pub fn pt_read_kind_code(idx: i64) -> i64 with Panic {
    if idx >= 0 && idx < 2097152 {
        PT_KIND_CODE[idx as usize]
    } else {
        0
    }
}

// The Name of an arbitrary token, for two-word contextual keywords where the
// second word must be inspected before committing. current_name only reads the
// CURRENT token, and a lookahead that has to advance first cannot back out.
// Identifiers only: no string-literal truncation handling, because a literal is
// never a contextual keyword.
pub fn parser_name_at(p: Parser, idx: i64) -> Name with Mut, Panic, Div {
    if idx < 0 || idx >= p.token_count { return Name { buf: [0; 384], len: 0 } }
    let s = PT_START[idx as usize]
    let e = PT_END[idx as usize]
    var nlen = e - s
    if nlen > 128 { nlen = 128 }
    if nlen < 0 { return Name { buf: [0; 384], len: 0 } }
    var name = Name { buf: [0; 384], len: nlen }
    var i: i64 = 0
    while i < nlen {
        name.buf[i as usize] = CURSOR_SOURCE[(s + i) as usize]
        i = i + 1
    }
    name
}

pub fn pt_read_start(idx: i64) -> i64 with Panic {
    if idx >= 0 && idx < 2097152 { PT_START[idx as usize] } else { 0 }
}

pub fn pt_read_end(idx: i64) -> i64 with Panic {
    if idx >= 0 && idx < 2097152 { PT_END[idx as usize] } else { 0 }
}

pub fn pt_read_int_value(idx: i64) -> i64 with Panic {
    if idx >= 0 && idx < 2097152 { PT_INT_VALUE[idx as usize] } else { 0 }
}

pub fn parser_assign_op_code(p: Parser) -> i64 with Panic {
    if p.pending_gt > 0 { return -1 }
    if p.pos < 0 || p.pos >= p.token_count { return -1 }
    let code = PT_KIND_CODE[p.pos as usize]
    if code == 137 { return 0 }
    if code == 154 { return 1 }
    if code == 155 { return 2 }
    if code == 156 { return 3 }
    if code == 157 { return 4 }
    if code == 168 { return 5 }
    let start = PT_START[p.pos as usize]
    let end = PT_END[p.pos as usize]
    let len = end - start
    if len == 0 {
        if code == 61 { return 0 }
    }
    if len == 1 {
        if CURSOR_SOURCE[start as usize] == (61 as i8) { return 0 }
    }
    if len == 2 {
        let a = CURSOR_SOURCE[start as usize]
        let b = CURSOR_SOURCE[(start + 1) as usize]
        if b == (61 as i8) {
            if a == (43 as i8) { return 1 }
            if a == (45 as i8) { return 2 }
            if a == (42 as i8) { return 3 }
            if a == (47 as i8) { return 4 }
            if a == (37 as i8) { return 5 }
        }
    }
    -1
}

// Free-function equivalents of Parser::peek / Parser::at_eof.
// Use these when `p` is SIZE_HINT-typed (came from a tuple .0 field access)
// to avoid the SIZE_HINT method-dispatch bug in the lean compiler.
pub fn parser_peek(p: Parser) -> TokenKind with Mut, Panic, Div {
    if p.pending_gt > 0 {
        TokenKind::Gt
    } else if p.pos < p.token_count {
        pt_read_kind(p.pos)
    } else {
        TokenKind::Eof
    }
}

pub fn parser_at_eof(p: Parser) -> bool with Mut, Panic, Div {
    if p.pending_gt > 0 { return false }
    if p.pos < 0 { return false }
    if p.pos >= p.token_count { return true }
    pt_read_kind(p.pos) == TokenKind::Eof
}

pub fn parser_advance(p_in: Parser) -> Parser with Mut, Panic, Div {
    var p = p_in
    if p.pending_gt > 0 {
        p.pending_gt = p.pending_gt - 1
        if p.pending_gt > 0 {
            return p
        }
        if p.pos < p.token_count {
            p.pos = p.pos + 1
        }
    } else if p.pos < p.token_count {
        p.pos = p.pos + 1
    }
    while p.pos < p.token_count && pt_read_kind(p.pos) == TokenKind::Newline {
        p.pos = p.pos + 1
    }
    p
}

// ---------------------------------------------------------------------------
// Correctly-rounded decimal -> binary64, slow path (#1626).
//
// The fast paths below are exact only while the significand fits 53 bits and
// |dexp| <= 22. Outside that window they cost one to two roundings, which left
// four of 91 realistic literals one ULP out: two with 17 significant digits,
// 1.602176634e-19, and 1e+300. Getting those right needs the exact quotient,
// which needs integers wider than i64 -- so this is Clinger's AlgorithmM on a
// small bignum.
//
// Base 2^31 limbs so that limb*10 + carry stays far inside i64. 64 limbs is
// 1984 bits, against 1329 for 10^400, which is the clamp applied to dexp.
//
// Module-level rather than local arrays on purpose: boot4 corrupts
// struct-by-value and large local aggregates, and the rest of this file
// already uses the scalar-globals idiom for the same reason.
var PFL_N: [i64; 64] = [0; 64]
var PFL_NL: i64 = 0
var PFL_D: [i64; 64] = [0; 64]
var PFL_DL: i64 = 0

fn pfl_set(is_num: bool, v: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < 64 {
        if is_num { PFL_N[i as usize] = 0 } else { PFL_D[i as usize] = 0 }
        i = i + 1
    }
    var x = v
    var n: i64 = 0
    while x > 0 {
        if is_num { PFL_N[n as usize] = x % 2147483648 } else { PFL_D[n as usize] = x % 2147483648 }
        x = x / 2147483648
        n = n + 1
    }
    if is_num { PFL_NL = n } else { PFL_DL = n }
}

fn pfl_mul_small(is_num: bool, m: i64) with Mut, Panic, Div {
    var len = if is_num { PFL_NL } else { PFL_DL }
    var carry: i64 = 0
    var i: i64 = 0
    while i < len {
        let cur = if is_num { PFL_N[i as usize] } else { PFL_D[i as usize] }
        let prod = cur * m + carry
        if is_num { PFL_N[i as usize] = prod % 2147483648 } else { PFL_D[i as usize] = prod % 2147483648 }
        carry = prod / 2147483648
        i = i + 1
    }
    while carry > 0 && len < 64 {
        if is_num { PFL_N[len as usize] = carry % 2147483648 } else { PFL_D[len as usize] = carry % 2147483648 }
        carry = carry / 2147483648
        len = len + 1
    }
    if is_num { PFL_NL = len } else { PFL_DL = len }
}

fn pfl_bits(is_num: bool) -> i64 with Mut, Panic, Div {
    let len = if is_num { PFL_NL } else { PFL_DL }
    if len == 0 { return 0 }
    let top = if is_num { PFL_N[(len - 1) as usize] } else { PFL_D[(len - 1) as usize] }
    var b: i64 = 0
    var t = top
    while t > 0 { b = b + 1  t = t / 2 }
    (len - 1) * 31 + b
}

fn pfl_cmp() -> i64 with Mut, Panic, Div {
    if PFL_NL != PFL_DL {
        if PFL_NL > PFL_DL { return 1 }
        return 0 - 1
    }
    var i = PFL_NL - 1
    while i >= 0 {
        let a = PFL_N[i as usize]
        let b = PFL_D[i as usize]
        if a != b {
            if a > b { return 1 }
            return 0 - 1
        }
        i = i - 1
    }
    0
}

// PFL_N -= PFL_D, assuming PFL_N >= PFL_D
fn pfl_sub() with Mut, Panic, Div {
    var borrow: i64 = 0
    var i: i64 = 0
    while i < PFL_NL {
        var d = PFL_N[i as usize] - borrow
        if i < PFL_DL { d = d - PFL_D[i as usize] }
        if d < 0 { d = d + 2147483648  borrow = 1 } else { borrow = 0 }
        PFL_N[i as usize] = d
        i = i + 1
    }
    while PFL_NL > 0 && PFL_N[(PFL_NL - 1) as usize] == 0 { PFL_NL = PFL_NL - 1 }
}

fn pfl_shl(is_num: bool, k: i64) with Mut, Panic, Div {
    var j: i64 = 0
    while j < k {
        pfl_mul_small(is_num, 2)
        j = j + 1
    }
}

fn pfl_is_zero(is_num: bool) -> bool with Mut, Panic, Div {
    if is_num { return PFL_NL == 0 }
    PFL_DL == 0
}

// Multiply x by 2^k exactly, in two halves so a large negative k does not
// underflow an intermediate on the way to a representable result.
fn pfl_scale2(x: f64, k: i64) -> f64 with Mut, Panic, Div {
    var v = x
    var a = k / 2
    var b = k - a
    var n = a
    while n > 0 { v = v * 2.0  n = n - 1 }
    while n < 0 { v = v / 2.0  n = n + 1 }
    n = b
    while n > 0 { v = v * 2.0  n = n - 1 }
    while n < 0 { v = v / 2.0  n = n + 1 }
    v
}

// sig * 10^dexp, correctly rounded. Only called when the exact fast paths
// cannot answer.
fn pfl_slow(sig: i64, dexp: i64) -> f64 with Mut, Panic, Div {
    pfl_set(true, sig)
    pfl_set(false, 1)
    var k: i64 = 0
    if dexp > 0 {
        while k < dexp { pfl_mul_small(true, 10)  k = k + 1 }
    } else {
        while k < 0 - dexp { pfl_mul_small(false, 10)  k = k + 1 }
    }

    // Normalise to 1 <= N/D < 2, tracking the binary exponent.
    var e: i64 = 0
    let diff = pfl_bits(true) - pfl_bits(false)
    if diff > 0 { pfl_shl(false, diff)  e = e + diff }
    if diff < 0 { pfl_shl(true, 0 - diff)  e = e + diff }
    if pfl_cmp() < 0 { pfl_shl(true, 1)  e = e - 1 }

    // How many significand bits this exponent can actually hold. 53 when the
    // result is normal; fewer in the subnormal range, where binary64 loses
    // precision gradually. Extracting 53 and then scaling down would round
    // twice -- which is what left 610e-315 (6.1e-313, subnormal) one ULP out
    // while every normal value was already exact.
    var want: i64 = 53
    if e < 0 - 1022 { want = e + 1075 }
    if want < 1 { return 0.0 }
    if want > 53 { want = 53 }

    var q: i64 = 1
    pfl_sub()
    var i: i64 = 1
    while i < want {
        pfl_shl(true, 1)
        q = q * 2
        if pfl_cmp() >= 0 { pfl_sub()  q = q + 1 }
        i = i + 1
    }

    // Round to nearest, ties to even.
    pfl_shl(true, 1)
    var round_up = false
    if pfl_cmp() >= 0 {
        pfl_sub()
        if !pfl_is_zero(true) { round_up = true }
        else { if q % 2 == 1 { round_up = true } }
    }
    if round_up { q = q + 1 }

    // A carry out of the top bit renormalises; the extra bit comes for free
    // from the exponent.
    var qmax: i64 = 1
    var z: i64 = 0
    while z < want { qmax = qmax * 2  z = z + 1 }
    if q >= qmax { q = q / 2  e = e + 1 }

    // Every intermediate on the way down is representable because the target
    // is, so the halving chain in pfl_scale2 is exact rather than repeatedly
    // rounding.
    pfl_scale2(q as f64, e - (want - 1))
}

// Exact powers of ten, built by multiplication rather than written out:
// lean_single, which compiles this file, parses 10^19 as a NEGATIVE number, so
// a literal table arrives poisoned. 10^k is exactly representable for k <= 22
// and each 10^(k-1)*10 is an exact product, so this loop is exact. Clamped at
// 22 because past that the result is no longer exact and callers rely on it.
fn parser_pow10_exact(k: i64) -> f64 with Mut, Panic, Div {
    var n = k
    if n > 22 { n = 22 }
    if n < 0 { n = 0 }
    var v: f64 = 1.0
    while n > 0 {
        v = v * 10.0
        n = n - 1
    }
    v
}

// Decimal -> binary64 (#1626). Exact significand + decimal exponent, scaled in
// as few roundings as possible.
//
// The old code accumulated `frac = frac * 0.1`; 0.1 is not representable, so
// every digit compounded a rounding and 32 of 91 realistic literals were wrong.
// `0.99999999` came out one ULP high, which made the rebuilt log (#1626) look
// as though it had a 2^-53 residual -- ulp(1.0)/1.0 IS 2^-53.
//
// `sig * 10 + digit` in f64 is exact while sig < 2^53, and 10^k is exact for
// k <= 22, so within that window the single multiply or divide below is
// CORRECTLY ROUNDED (Clinger 1990). Outside it, the two paths after the window
// exist to keep the number of roundings small rather than let them accumulate:
// a plain 10^|dexp| built by repeated multiplication costs up to 308 roundings
// and is what put 1e-300 one ULP out.
//
// The significand is accumulated in i64, not f64. An f64 accumulator has to
// stop at 2^53 and DISCARD the remaining digits, which costs up to 4 ULP on
// ordinary 16-digit literals like 944.6810951079374. i64 absorbs 18 digits and
// pays a single rounding at `as f64`. (I had this in f64 for a while on the
// theory that the i64 cast was miscompiled -- that was the stray-brace
// misdiagnosis, not a real defect.)
fn parser_parse_float_token(start: i64, end: i64) -> f64 with Mut, Panic, Div {
    var sig: i64 = 0
    var dexp: i64 = 0
    var seen_dot = false
    var i = start
    while i < end {
        let ch = CURSOR_SOURCE[i as usize]
        if ch == (95 as i8) {
            i = i + 1
            continue
        }
        if ch == (46 as i8) {
            if seen_dot {
                break
            }
            seen_dot = true
            i = i + 1
            continue
        }
        if ch >= (48 as i8) && ch <= (57 as i8) {
            // 922337203685477580 is i64 max / 10: room for one more digit.
            if sig < 922337203685477580 {
                sig = sig * 10 + ((ch - (48 as i8)) as i64)
                if seen_dot {
                    dexp = dexp - 1
                }
            } else {
                if !seen_dot {
                    dexp = dexp + 1
                }
            }
            i = i + 1
            continue
        }
        break
    }
    if i < end && (CURSOR_SOURCE[i as usize] == (101 as i8) || CURSOR_SOURCE[i as usize] == (69 as i8)) {
        i = i + 1
        var exp_sign: i64 = 1
        if i < end && CURSOR_SOURCE[i as usize] == (45 as i8) {
            exp_sign = 0 - 1
            i = i + 1
        } else if i < end && CURSOR_SOURCE[i as usize] == (43 as i8) {
            i = i + 1
        }
        var exp_value: i64 = 0
        while i < end {
            let ch2 = CURSOR_SOURCE[i as usize]
            if ch2 == (95 as i8) {
                i = i + 1
                continue
            }
            if ch2 >= (48 as i8) && ch2 <= (57 as i8) {
                exp_value = exp_value * 10 + ((ch2 - (48 as i8)) as i64)
            } else {
                break
            }
            i = i + 1
        }
        if exp_sign < 0 {
            dexp = dexp - exp_value
        } else {
            dexp = dexp + exp_value
        }
    }
    if sig == 0 {
        return 0.0
    }
    let sf = sig as f64
    // Past +-400 the answer is infinity or zero either way; clamping keeps a
    // pathological literal from spinning the loops below.
    if dexp > 400 { dexp = 400 }
    if dexp < 0 - 400 { dexp = 0 - 400 }

    // Correctly rounded window: significand exact in f64 AND an exact power of
    // ten, so the single operation below is the only rounding.
    if sig <= 9007199254740992 {
        if dexp >= 0 && dexp <= 22 {
            return sf * parser_pow10_exact(dexp)
        }
        if dexp < 0 && dexp >= 0 - 22 {
            return sf / parser_pow10_exact(0 - dexp)
        }
    }

    // Extended: walk the exponent DOWN into the exact window by growing the
    // significand. Growing sig by 10 multiplies the value, so dexp drops by 1 to
    // compensate -- every step exact while sig stays under 2^53, and one
    // rounding overall once the window is reached.
    //
    // There is deliberately no mirror of this for dexp < -22. The same move
    // there would need dexp to RISE toward the window while sig grows, and the
    // algebra runs the other way: growing sig forces dexp down, i.e. further
    // from the window. I wrote that mirror, measured it, and it turned
    // 1.602176634e-19 from one ULP out into six orders of magnitude out.
    if dexp > 22 && sig <= 9007199254740992 {
        var s2 = sf
        var e2 = dexp
        while e2 > 22 && s2 <= 900719925474099.0 {
            s2 = s2 * 10.0
            e2 = e2 - 1
        }
        if e2 <= 22 {
            return s2 * parser_pow10_exact(e2)
        }
    }

    // Everything the exact windows cannot answer goes to the bignum path, which
    // is correctly rounded by construction. It replaces a chunked 10^22 scaling
    // that cost one rounding per chunk and left 1e300 and 1.602176634e-19 an ULP
    // out.
    pfl_slow(sig, dexp)
}

pub fn parser_peek_ahead(p: Parser, offset: i64) -> TokenKind with Mut, Panic, Div {
    if p.pending_gt > 0 {
        if offset < p.pending_gt {
            TokenKind::Gt
        } else {
            let idx = p.pos + 1 + (offset - p.pending_gt)
            if idx < p.token_count { pt_read_kind(idx) } else { TokenKind::Eof }
        }
    } else {
        let idx = p.pos + offset
        if idx < p.token_count { pt_read_kind(idx) } else { TokenKind::Eof }
    }
}

// V0-B: true when token at p.pos+offset is the single-letter ident `p`/`P`
// (C99 hex-float binary exponent). Uses CURSOR_SOURCE span, not PT_KIND.
pub fn parser_ahead_is_p_ident(p: Parser, offset: i64) -> bool with Mut, Panic, Div {
    if p.pending_gt > 0 {
        return false
    }
    let idx = p.pos + offset
    if idx < 0 || idx >= p.token_count {
        return false
    }
    if pt_read_kind(idx) != TokenKind::Ident {
        return false
    }
    let s = PT_START[idx as usize]
    let e = PT_END[idx as usize]
    if e - s != 1 {
        return false
    }
    if s < 0 || s >= CURSOR_SOURCE_LEN {
        return false
    }
    let ch = CURSOR_SOURCE[s as usize]
    ch == 112 as i8 || ch == 80 as i8
}

// V0-B: Ident that is hex-digits ending in `p`/`P` (fraction+exponent letter fused),
// e.g. `ffffffffffffffffffffffffffffp` after `0x1.`.
pub fn parser_ahead_is_hex_frac_p_ident(p: Parser, offset: i64) -> bool with Mut, Panic, Div {
    if p.pending_gt > 0 {
        return false
    }
    let idx = p.pos + offset
    if idx < 0 || idx >= p.token_count {
        return false
    }
    if pt_read_kind(idx) != TokenKind::Ident {
        return false
    }
    let s = PT_START[idx as usize]
    let e = PT_END[idx as usize]
    let nlen = e - s
    if nlen < 2 || s < 0 || e > CURSOR_SOURCE_LEN {
        return false
    }
    let last = CURSOR_SOURCE[(e - 1) as usize]
    if last != 112 as i8 && last != 80 as i8 {
        return false
    }
    var i: i64 = s
    while i < e - 1 {
        let ch = CURSOR_SOURCE[i as usize]
        let is_hex = (ch >= 48 as i8 && ch <= 57 as i8)
            || (ch >= 97 as i8 && ch <= 102 as i8)
            || (ch >= 65 as i8 && ch <= 70 as i8)
        if !is_hex {
            return false
        }
        i = i + 1
    }
    true
}

impl Parser {
    fn current(self: Parser) -> Token with Panic, Div, Mut {
        // Construct from parallel scalar arrays (boot4-compatible)
        var tok = Token::new()
        if self.pos < self.token_count {
            tok.kind = PT_KIND[self.pos as usize]
            tok.start = PT_START[self.pos as usize]
            tok.int_value = PT_INT_VALUE[self.pos as usize]
            if pt_read_kind(self.pos) == TokenKind::FloatLit {
                tok.float_value = parser_parse_float_token(PT_START[self.pos as usize], PT_END[self.pos as usize])
            }
            tok.text_len = PT_TEXT_LEN[self.pos as usize]
        }
        tok
    }

    fn current_int_value(self: Parser) -> i64 with Panic {
        if self.pos >= 0 && self.pos < 2097152 { PT_INT_VALUE[self.pos as usize] } else { 0 }
    }

    fn peek(self: Parser) -> TokenKind with Mut, Panic, Div {
        if self.pending_gt > 0 {
            TokenKind::Gt
        } else {
            if self.pos < self.token_count {
                pt_read_kind(self.pos)
            } else {
                TokenKind::Eof
            }
        }
    }

    fn peek_ahead(self: Parser, offset: i64) -> TokenKind with Mut, Panic, Div {
        if self.pending_gt > 0 {
            if offset < self.pending_gt {
                TokenKind::Gt
            } else {
                let idx = self.pos + 1 + (offset - self.pending_gt)
                if idx < self.token_count {
                    pt_read_kind(idx)
                } else {
                    TokenKind::Eof
                }
            }
        } else {
            let idx = self.pos + offset
            if idx < self.token_count {
                pt_read_kind(idx)
            } else {
                TokenKind::Eof
            }
        }
    }

    fn at(self: Parser, kind: TokenKind) -> bool with Mut, Panic, Div {
        self.peek() == kind
    }

    fn at_eof(self: Parser) -> bool with Mut, Panic, Div {
        self.peek() == TokenKind::Eof
    }

    // Returns true if the current token is on a later line than the previous token.
    // Used by the Pratt parser to prevent `ident\n(` from being parsed as a call.
    // The self-hosted lexer discards newline tokens, so we compare line numbers.
    fn had_newline_before(self: Parser) -> bool with Panic, Div {
        if self.pos <= 0 { return false }
        let prev_line = PT_LINE[(self.pos - 1) as usize]
        let cur_line = PT_LINE[self.pos as usize]
        prev_line < cur_line
    }

    // ============================================================
    // Advance
    // ============================================================

    fn advance(self: Parser) -> Parser with Mut, Panic, Div {
        var p = self
        if p.pending_gt > 0 {
            p.pending_gt = p.pending_gt - 1
            if p.pending_gt > 0 {
                return p
            }
            // Consumed the last synthetic `>`; now consume the underlying token.
            if p.pos < p.token_count {
                p.pos = p.pos + 1
            }
        } else if p.pos < p.token_count {
            p.pos = p.pos + 1
        }
        // Skip newlines automatically (they're insignificant in most contexts)
        while p.pos < p.token_count && pt_read_kind(p.pos) == TokenKind::Newline {
            p.pos = p.pos + 1
        }
        p
    }

    fn advance_raw(self: Parser) -> Parser with Mut, Panic, Div {
        var p = self
        if p.pending_gt > 0 {
            p.pending_gt = p.pending_gt - 1
            if p.pending_gt == 0 && p.pos < p.token_count {
                p.pos = p.pos + 1
            }
            p
        } else {
            if p.pos < p.token_count {
                p.pos = p.pos + 1
            }
            p
        }
    }

    // ============================================================
    // Expect
    // ============================================================

    fn expect(self: Parser, kind: TokenKind) -> Parser with Mut, IO, Panic, Div {
        // In type contexts, allow `>>` to act as two consecutive `>` tokens.
        if kind == TokenKind::Gt && self.pending_gt == 0 && self.peek() == TokenKind::Shr {
            var p = self
            p.pending_gt = 2
            return p.advance()
        }
        if self.peek() == kind {
            return self.advance()
        }
        // Error recovery — simplified to avoid struct corruption in error path
        var p = self
        p.had_error = true
        p.error_count = p.error_count + 1
        if p.error_count <= 20 {
            print("parse error: expected token at line ")
            if p.pos >= 0 && p.pos < 2097152 {
                print_int(PT_LINE[p.pos as usize])
                print(":")
                print_int(PT_COL[p.pos as usize])
                print(" expected=")
                print_int(kind as i64)
                print(" actual=")
                print_int(PT_KIND_CODE[p.pos as usize])
                print("\n")
            } else {
                print("unknown\n")
            }
        } else if p.error_count == 21 {
            print("parse error: additional errors suppressed\n")
        }
        p
    }

    fn expect_ident(self: Parser) -> Parser with Mut, IO, Panic, Div {
        let k = self.peek()
        if k == TokenKind::Ident || tk_is_keyword(k) {
            self.advance()
        } else {
            // Avoid infinite loops on identifier mismatches by consuming a token.
            var p = self
            p = p.expect(TokenKind::Ident)
            p.advance()
        }
    }

    // ============================================================
    // Node ID allocation
    // ============================================================

    fn alloc_id(self: Parser) -> Parser with Mut {
        var p = self
        p.next_id = p.next_id + 1
        p
    }

    fn current_id(self: Parser) -> NodeId {
        NodeId { id: self.next_id }
    }

    // ============================================================
    // Span helpers
    // ============================================================

    fn current_span(self: Parser) -> Span with Panic, Div {
        if self.pos < self.token_count {
            Span::new(
                0,
                PT_START[self.pos as usize],
                PT_END[self.pos as usize]
            )
        } else {
            Span::new(0, 0, 0)
        }
    }

    fn span_from(self: Parser, start: Span) -> Span with Panic, Div {
        if self.pos < self.token_count {
            Span::new(start.file_id, start.start, PT_END[self.pos as usize])
        } else {
            Span::new(start.file_id, start.start, start.end)
        }
    }

    // ============================================================
    // Name extraction from current token
    // ============================================================

    fn current_name(self: Parser) -> Name with Mut, Panic, Div {
        if self.pos < self.token_count {
            // Read from source buffer using parallel start/end arrays (boot4-compatible)
            let s = PT_START[self.pos as usize]
            let e = PT_END[self.pos as usize]
            var nlen = e - s
            if nlen > 384 {
                // Ask pt_read_kind, do NOT compare PT_KIND_CODE against a
                // TokenKind cast. They are two different numberings: the enum's
                // source order (StringLit is the 134th variant) and the flat
                // scalar code the token tables actually store (a string literal
                // carries 126, which in the code scheme means something else
                // entirely — pt_read_kind:509-516 decodes 132..139 as
                // Plus/Minus/Star/... and the header there records why the raw
                // enum array cannot be trusted for high variants).
                //
                // A first attempt compared the raw code against
                // `TokenKind::StringLit as i64` and therefore never matched, in
                // silence. A probe that counted every truncation and PRINTED the
                // kind is what found it: calls=5 trunc=1 firstkind=126 with
                // longest=n+2, i.e. the site was reached, the condition was true,
                // and only the comparison was wrong.
                // nlen counts both quotes. Name holds 384 bytes (raised 2026-08-17).
                // Content past 382 characters cannot fit with both quotes.
                // Truncation of StringLit is a HARD ERROR (refuse), not a warning.
                if nlen > 384 && pt_read_kind(self.pos) == TokenKind::StringLit {
                    PARSER_TRUNCATED_LITERALS = PARSER_TRUNCATED_LITERALS + 1
                    if PARSER_TRUNCATED_FIRST_LINE == 0 {
                        PARSER_TRUNCATED_FIRST_LINE = PT_LINE[self.pos as usize]
                    }
                    // nlen counts the quotes; the text lost is nlen - 2 - 382.
                    if nlen > PARSER_TRUNCATED_LONGEST { PARSER_TRUNCATED_LONGEST = nlen }
                }
                nlen = 384
            }
            if nlen < 0 { nlen = 0 }
            var name = Name { buf: [0; 384], len: nlen }
            var i: i64 = 0
            while i < nlen {
                name.buf[i as usize] = CURSOR_SOURCE[(s + i) as usize]
                i = i + 1
            }
            name
        } else {
            Name { buf: [0; 384], len: 0 }
        }
    }

    // ============================================================
    // Utility: check if current token starts an expression
    // ============================================================

    fn at_expr_start(self: Parser) -> bool with Mut, Panic, Div {
        let k = self.peek()
        k == TokenKind::IntLit
            || k == TokenKind::FloatLit
            || k == TokenKind::StringLit
            || k == TokenKind::CharLit
            || k == TokenKind::True
            || k == TokenKind::False
            || k == TokenKind::Ident
            || k == TokenKind::Knowledge
            || k == TokenKind::Close
            || k == TokenKind::Unit
            || k == TokenKind::Kernel
            || k == TokenKind::LParen
            || k == TokenKind::LBracket
            || k == TokenKind::LBrace
            || k == TokenKind::Minus
            || k == TokenKind::Bang
            || k == TokenKind::Amp
            || k == TokenKind::AmpBang
            || k == TokenKind::Star
            || k == TokenKind::If
            || k == TokenKind::Match
            || k == TokenKind::While
            || k == TokenKind::Loop
            || k == TokenKind::Return
            || k == TokenKind::Break
            || k == TokenKind::Continue
            || k == TokenKind::SelfLower
            || k == TokenKind::ContestLower
            || k == TokenKind::Handle
            || k == TokenKind::Async
            || k == TokenKind::Spawn
            || k == TokenKind::Perform
            // Expression position and "does an expression follow" must admit the
            // same identifiers, and only one list should say which. Without this
            // call `return policy.count` parsed as a BARE return: the expression
            // was discarded in silence, the return typed as (), and the failure
            // surfaced as "expected i64, found ()" at a span pointing to the word
            // `return`. A parser that REFUSES an identifier is found in one run;
            // one that drops the expression is not.
            || tk_is_contextual_ident(k)
    }

    // ============================================================
    // Utility: check if current token starts an item
    // ============================================================

    fn at_item_start(self: Parser) -> bool with Mut, Panic, Div {
        let k = self.peek()
        k == TokenKind::Fn
            || k == TokenKind::Struct
            || k == TokenKind::Enum
            || k == TokenKind::Impl
            || k == TokenKind::Type
            || k == TokenKind::PolicyLower
            || k == TokenKind::Use
            || k == TokenKind::Import
            || k == TokenKind::Linear
            || k == TokenKind::Affine
            || k == TokenKind::Pub
            || k == TokenKind::Async
    }
}

// ============================================================
// Default constructors for AST nodes (all fields zeroed/None)
// ============================================================

pub fn dummy_type_expr() -> TypeExpr {
    TypeExpr {
        kind: TypeExprKind::TypeUnit,
        span: Span::dummy(),
        path: empty_path(),
        type_args: None,
        inner: None,
        array_size: None,
        effects: None,
        knowledge_info: None,
        refinement_info: None,
    }
}

pub fn error_expr(span: Span) -> Expr {
    Expr {
        kind: ExprKind::ExprError,
        span: span,
        int_val: 0,
        float_val: 0.0,
        name: empty_name(),
        path: empty_path(),
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        left: None,
        right: None,
        block: None,
        else_expr: None,
        args: None,
        arms: None,
        fields: None,
        cast_type: None,
        handler_block: None,
        closure_params: None,
        closure_return: None,
        closure_effects: None,
        closure_body: None,
        type_args: None,
    }
}

pub fn mk_expr(kind: ExprKind, span: Span) -> Expr {
    Expr {
        kind: kind,
        span: span,
        int_val: 0,
        float_val: 0.0,
        name: empty_name(),
        path: empty_path(),
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        left: None,
        right: None,
        block: None,
        else_expr: None,
        args: None,
        arms: None,
        fields: None,
        cast_type: None,
        handler_block: None,
        closure_params: None,
        closure_return: None,
        closure_effects: None,
        closure_body: None,
        type_args: None,
    }
}
