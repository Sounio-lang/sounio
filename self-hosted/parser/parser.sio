// Parser core: token stream navigation, error recovery, node construction helpers.

struct Parser {
    tokens: [Token; 65536],
    token_count: i64,
    pos: i64,
    next_id: i64,
    had_error: bool,
    error_count: i64,
}

// ============================================================
// Construction
// ============================================================

fn parser_new() -> Parser {
    Parser {
        tokens: [Token::new(); 65536],
        token_count: 0,
        pos: 0,
        next_id: 1,
        had_error: false,
        error_count: 0,
    }
}

// ============================================================
// Token access
// ============================================================

impl Parser {
    fn current(self) -> Token with Panic, Div {
        if self.pos < self.token_count {
            self.tokens[self.pos]
        } else {
            Token::eof(0, 0, 0)
        }
    }

    fn peek(self) -> TokenKind with Panic, Div {
        self.current().kind
    }

    fn peek_ahead(self, offset: i64) -> TokenKind with Panic, Div {
        let idx = self.pos + offset
        if idx < self.token_count {
            self.tokens[idx].kind
        } else {
            TokenKind::Eof
        }
    }

    fn at(self, kind: TokenKind) -> bool with Panic, Div {
        self.peek() == kind
    }

    fn at_eof(self) -> bool with Panic, Div {
        self.peek() == TokenKind::Eof
    }

    // ============================================================
    // Advance
    // ============================================================

    fn advance(self) -> Parser with Mut, Panic, Div {
        var p = self
        if p.pos < p.token_count {
            p.pos = p.pos + 1
        }
        // Skip newlines automatically (they're insignificant in most contexts)
        while p.pos < p.token_count && p.tokens[p.pos].kind == TokenKind::Newline {
            p.pos = p.pos + 1
        }
        p
    }

    fn advance_raw(self) -> Parser with Mut, Panic, Div {
        var p = self
        if p.pos < p.token_count {
            p.pos = p.pos + 1
        }
        p
    }

    // ============================================================
    // Expect
    // ============================================================

    fn expect(self, kind: TokenKind) -> Parser with Mut, IO, Panic, Div {
        if self.peek() == kind {
            self.advance()
        } else {
            var p = self
            p.had_error = true
            p.error_count = p.error_count + 1
            // TODO: report error with span
            p
        }
    }

    fn expect_ident(self) -> Parser with Mut, IO, Panic, Div {
        self.expect(TokenKind::Ident)
    }

    // ============================================================
    // Node ID allocation
    // ============================================================

    fn alloc_id(self) -> Parser with Mut {
        var p = self
        p.next_id = p.next_id + 1
        p
    }

    fn current_id(self) -> NodeId {
        NodeId { id: self.next_id }
    }

    // ============================================================
    // Span helpers
    // ============================================================

    fn current_span(self) -> Span with Panic, Div {
        let tok = self.current()
        Span::new(0, tok.start, tok.end)
    }

    fn span_from(self, start: Span) -> Span with Panic, Div {
        let end_tok = self.current()
        Span::new(start.file_id, start.start, end_tok.end)
    }

    // ============================================================
    // Name extraction from current token
    // ============================================================

    fn current_name(self) -> Name with Panic, Div {
        let tok = self.current()
        Name { buf: tok.text, len: tok.text_len }
    }

    // ============================================================
    // Utility: check if current token starts an expression
    // ============================================================

    fn at_expr_start(self) -> bool with Panic, Div {
        let k = self.peek()
        k == TokenKind::IntLit
            || k == TokenKind::FloatLit
            || k == TokenKind::StringLit
            || k == TokenKind::CharLit
            || k == TokenKind::True
            || k == TokenKind::False
            || k == TokenKind::Ident
            || k == TokenKind::LParen
            || k == TokenKind::LBracket
            || k == TokenKind::LBrace
            || k == TokenKind::Minus
            || k == TokenKind::Bang
            || k == TokenKind::Amp
            || k == TokenKind::AmpBang
            || k == TokenKind::Star
            || k == TokenKind::If
            || k == TokenKind::Match
            || k == TokenKind::While
            || k == TokenKind::Loop
            || k == TokenKind::Return
            || k == TokenKind::Break
            || k == TokenKind::Continue
            || k == TokenKind::SelfLower
    }

    // ============================================================
    // Utility: check if current token starts an item
    // ============================================================

    fn at_item_start(self) -> bool with Panic, Div {
        let k = self.peek()
        k == TokenKind::Fn
            || k == TokenKind::Struct
            || k == TokenKind::Enum
            || k == TokenKind::Impl
            || k == TokenKind::Type
            || k == TokenKind::Use
            || k == TokenKind::Import
            || k == TokenKind::Linear
            || k == TokenKind::Pub
    }
}

// ============================================================
// Default constructors for AST nodes (all fields zeroed/None)
// ============================================================

fn empty_name() -> Name {
    Name { buf: [0; 128], len: 0 }
}

fn empty_path() -> AstPath {
    AstPath { segments: StringList { head_buf: [0; 128], head_len: 0, tail: None }, seg_count: 0 }
}

fn dummy_type_expr() -> TypeExpr {
    TypeExpr {
        kind: TypeExprKind::TypeUnit,
        span: Span::dummy(),
        path: empty_path(),
        type_args: None,
        inner: None,
        array_size: None,
        effects: None,
    }
}

fn error_expr(span: Span) -> Expr {
    Expr {
        kind: ExprKind::ExprError,
        span: span,
        int_val: 0,
        float_val: 0.0,
        name: empty_name(),
        path: empty_path(),
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        left: None,
        right: None,
        block: None,
        else_expr: None,
        args: None,
        arms: None,
        fields: None,
    }
}

fn mk_expr(kind: ExprKind, span: Span) -> Expr {
    Expr {
        kind: kind,
        span: span,
        int_val: 0,
        float_val: 0.0,
        name: empty_name(),
        path: empty_path(),
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        left: None,
        right: None,
        block: None,
        else_expr: None,
        args: None,
        arms: None,
        fields: None,
    }
}
