// Parser core: token stream navigation, error recovery, node construction helpers.

module parser::parser

use parser::ast::*
use lexer::token::*
use lexer::cursor::*

// Keep token storage out of Parser state so Parser method calls don't
// repeatedly copy a 65k token array by value.
var PARSER_TOKENS: [Token; 1048576] = [Token::new(); 1048576]
// Boot4-compatible parallel scalar arrays (boot4 can't index struct-typed global arrays)
var PT_KIND: [TokenKind; 1048576] = [TokenKind::Eof; 1048576]
var PT_START: [i64; 1048576] = [0; 1048576]
var PT_END: [i64; 1048576] = [0; 1048576]
var PT_LINE: [i64; 1048576] = [0; 1048576]
var PT_COL: [i64; 1048576] = [0; 1048576]
var PT_TEXT_LEN: [i64; 1048576] = [0; 1048576]
var PT_INT_VALUE: [i64; 1048576] = [0; 1048576]
// Boot4-safe: parse_item stores its result here instead of returning (Parser, Item)
// which is 314+ slots and triggers IS_SPTR=4 hang. The caller reads this after parse_item returns.
var LAST_PARSED_ITEM: Option<Box<Item> > = None
// Boot4-safe: scalar globals mirroring Parser struct fields.
// boot4 corrupts struct-by-value field access, so the parser loop
// reads/writes these globals instead of Parser.field.
var GP_TOKEN_COUNT: i64 = 0
var GP_POS: i64 = 0
var GP_NEXT_ID: i64 = 1
var GP_HAD_ERROR: i64 = 0
var GP_ERROR_COUNT: i64 = 0
var GP_NO_STRUCT_LIT: i64 = 0
var GP_PENDING_GT: i64 = 0
var PARSER_FAST_SKIP_BLOCKS: bool = false
var PARSER_LAST_HAD_ERROR: bool = false
var PARSER_LAST_ERROR_COUNT: i64 = 0

struct Parser {
    token_count: i64,
    pos: i64,
    next_id: i64,
    had_error: bool,
    error_count: i64,
    no_struct_lit: bool,
    // When parsing nested generic type args like `Option<Box<T>>`, the lexer
    // produces a single `>>` token. In type contexts we need to treat that as
    // two consecutive `>` tokens. This counter tracks pending synthetic `>`
    // tokens to emit before consuming the underlying `>>`.
    pending_gt: i64,
}

// ============================================================
// Construction
// ============================================================

fn parser_new() -> Parser {
    Parser {
        token_count: 0,
        pos: 0,
        next_id: 1,
        had_error: false,
        error_count: 0,
        no_struct_lit: false,
        pending_gt: 0,
    }
}

fn parser_set_tokens(tokens: [Token; 1048576], token_count: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < token_count && i < 1048576 {
        // Write to parallel scalar arrays (boot4-compatible)
        PT_KIND[i as usize] = tokens[i as usize].kind
        PT_START[i as usize] = tokens[i as usize].start
        PT_END[i as usize] = tokens[i as usize].end
        PT_LINE[i as usize] = tokens[i as usize].line
        PT_COL[i as usize] = tokens[i as usize].col
        PT_INT_VALUE[i as usize] = tokens[i as usize].int_value
        PT_TEXT_LEN[i as usize] = tokens[i as usize].text_len
        i = i + 1
    }
}

fn parser_set_token_at(idx: i64, tok: Token) with Mut, Panic {
    if idx >= 0 && idx < 1048576 {
        // Write to parallel scalar arrays (boot4-compatible, avoids struct-typed global array write)
        PT_KIND[idx as usize] = tok.kind
        PT_START[idx as usize] = tok.start
        PT_END[idx as usize] = tok.end
        PT_LINE[idx as usize] = tok.line
        PT_COL[idx as usize] = tok.col
        PT_INT_VALUE[idx as usize] = tok.int_value
        PT_TEXT_LEN[idx as usize] = tok.text_len
    }
}

fn parser_get_token_at(idx: i64) -> Token with Panic {
    if idx >= 0 && idx < 1048576 {
        PARSER_TOKENS[idx as usize]
    } else {
        Token::with_kind(TokenKind::Eof, 0, 0, 0, 0)
    }
}

// Boot4-safe: write token fields directly into PARSER_TOKENS without creating Token local
// Avoids boot4's 4MB stack frame for functions with IS_SPTR=4 locals
fn parser_set_token_scalar(idx: i64, kind: TokenKind, start: i64, end: i64, line: i64, col: i64) with Mut, Panic {
    if idx >= 0 && idx < 1048576 {
        // Parallel scalar arrays (boot4/stage0 compatible)
        PT_KIND[idx as usize] = kind
        PT_START[idx as usize] = start
        PT_END[idx as usize] = end
        PT_LINE[idx as usize] = line
        PT_COL[idx as usize] = col
        PT_TEXT_LEN[idx as usize] = 0
        PT_INT_VALUE[idx as usize] = 0
    }
}

fn parser_set_token_int_value(idx: i64, val: i64) with Mut, Panic {
    if idx >= 0 && idx < 1048576 {
        PT_INT_VALUE[idx as usize] = val
    }
}

fn parser_set_token_float_value(idx: i64, val: f64) with Mut, Panic {
    if idx >= 0 && idx < 1048576 {
        // float_value not in PT_* arrays yet — skip for boot4 compatibility
        let dummy = val
    }
}

fn parser_set_token_text_byte(idx: i64, byte_idx: i64, val: i8) with Mut, Panic {
    // PARSER_TOKENS struct write skipped for stage0 compatibility
    // Token text is stored in PT_TEXT_* parallel arrays instead
    if idx >= 0 && idx < 1048576 && byte_idx >= 0 && byte_idx < 256 {
        // Skip: PARSER_TOKENS[idx as usize].text[byte_idx as usize] = val
        let dummy = val
    }
}

fn parser_set_token_text_len(idx: i64, len: i64) with Mut, Panic {
    if idx >= 0 && idx < 1048576 {
        PT_TEXT_LEN[idx as usize] = len
    }
}

// Flat token setters for lexers that can't construct TokenKind/Token.
// Sets all scalar fields at once using integer kind discriminant.
pub fn parser_set_token_flat(idx: i64, kind: i64, start: i64, end: i64, line: i64, col: i64, int_value: i64) with Mut, Panic {
    if idx >= 0 && idx < 1048576 {
        // TokenKind enum discriminant table — lean compiler stores enums as i64
        // We construct the TokenKind via a dispatch to avoid needing enum literals
        // Discriminants match TokenKind enum order in lexer/token.sio
        if kind == 0 { PT_KIND[idx as usize] = TokenKind::Eof }
        else if kind == 2 { PT_KIND[idx as usize] = TokenKind::Newline }
        else if kind == 5 { PT_KIND[idx as usize] = TokenKind::Use }
        else if kind == 7 { PT_KIND[idx as usize] = TokenKind::Fn }
        else if kind == 8 { PT_KIND[idx as usize] = TokenKind::Let }
        else if kind == 9 { PT_KIND[idx as usize] = TokenKind::Var }
        else if kind == 12 { PT_KIND[idx as usize] = TokenKind::Type }
        else if kind == 13 { PT_KIND[idx as usize] = TokenKind::Struct }
        else if kind == 14 { PT_KIND[idx as usize] = TokenKind::Enum }
        else if kind == 20 { PT_KIND[idx as usize] = TokenKind::If }
        else if kind == 21 { PT_KIND[idx as usize] = TokenKind::Else }
        else if kind == 24 { PT_KIND[idx as usize] = TokenKind::While }
        else if kind == 28 { PT_KIND[idx as usize] = TokenKind::Return }
        else if kind == 30 { PT_KIND[idx as usize] = TokenKind::As }
        else if kind == 32 { PT_KIND[idx as usize] = TokenKind::Pub }
        else if kind == 35 { PT_KIND[idx as usize] = TokenKind::True }
        else if kind == 36 { PT_KIND[idx as usize] = TokenKind::False }
        else if kind == 45 { PT_KIND[idx as usize] = TokenKind::With }
        else if kind == 123 { PT_KIND[idx as usize] = TokenKind::Ident }
        else if kind == 124 { PT_KIND[idx as usize] = TokenKind::IntLit }
        else if kind == 126 { PT_KIND[idx as usize] = TokenKind::StringLit }
        else if kind == 132 { PT_KIND[idx as usize] = TokenKind::Plus }
        else if kind == 133 { PT_KIND[idx as usize] = TokenKind::Minus }
        else if kind == 134 { PT_KIND[idx as usize] = TokenKind::Star }
        else if kind == 135 { PT_KIND[idx as usize] = TokenKind::Slash }
        else if kind == 136 { PT_KIND[idx as usize] = TokenKind::Percent }
        else if kind == 137 { PT_KIND[idx as usize] = TokenKind::Eq }
        else if kind == 138 { PT_KIND[idx as usize] = TokenKind::Lt }
        else if kind == 139 { PT_KIND[idx as usize] = TokenKind::Gt }
        else if kind == 140 { PT_KIND[idx as usize] = TokenKind::Bang }
        else if kind == 141 { PT_KIND[idx as usize] = TokenKind::Amp }
        else if kind == 142 { PT_KIND[idx as usize] = TokenKind::Pipe }
        else if kind == 146 { PT_KIND[idx as usize] = TokenKind::EqEq }
        else if kind == 147 { PT_KIND[idx as usize] = TokenKind::BangEq }
        else if kind == 148 { PT_KIND[idx as usize] = TokenKind::LtEq }
        else if kind == 149 { PT_KIND[idx as usize] = TokenKind::GtEq }
        else if kind == 150 { PT_KIND[idx as usize] = TokenKind::AmpAmp }
        else if kind == 151 { PT_KIND[idx as usize] = TokenKind::PipePipe }
        else if kind == 158 { PT_KIND[idx as usize] = TokenKind::Arrow }
        else if kind == 162 { PT_KIND[idx as usize] = TokenKind::ColonColon }
        else if kind == 163 { PT_KIND[idx as usize] = TokenKind::AmpBang }
        else if kind == 174 { PT_KIND[idx as usize] = TokenKind::LParen }
        else if kind == 175 { PT_KIND[idx as usize] = TokenKind::RParen }
        else if kind == 176 { PT_KIND[idx as usize] = TokenKind::LBrace }
        else if kind == 177 { PT_KIND[idx as usize] = TokenKind::RBrace }
        else if kind == 178 { PT_KIND[idx as usize] = TokenKind::LBracket }
        else if kind == 179 { PT_KIND[idx as usize] = TokenKind::RBracket }
        else if kind == 180 { PT_KIND[idx as usize] = TokenKind::Semi }
        else if kind == 181 { PT_KIND[idx as usize] = TokenKind::Colon }
        else if kind == 182 { PT_KIND[idx as usize] = TokenKind::Comma }
        else if kind == 183 { PT_KIND[idx as usize] = TokenKind::Dot }
        else { PT_KIND[idx as usize] = TokenKind::Error }
        PT_START[idx as usize] = start
        PT_END[idx as usize] = end
        PT_LINE[idx as usize] = line
        PT_COL[idx as usize] = col
        PT_INT_VALUE[idx as usize] = int_value
        PT_TEXT_LEN[idx as usize] = 0
    }
}

fn parser_set_fast_skip_blocks(enabled: bool) with Mut {
    PARSER_FAST_SKIP_BLOCKS = enabled
}

fn parser_reset_last_errors() with Mut {
    PARSER_LAST_HAD_ERROR = false
    PARSER_LAST_ERROR_COUNT = 0
}

pub fn parser_set_last_errors(had_error: bool, error_count: i64) with Mut {
    PARSER_LAST_HAD_ERROR = had_error
    PARSER_LAST_ERROR_COUNT = error_count
}

pub fn parser_last_had_error() -> bool {
    PARSER_LAST_HAD_ERROR
}

pub fn parser_last_error_count() -> i64 {
    PARSER_LAST_ERROR_COUNT
}

// ============================================================
// Boot4-safe parser operations using GP_* globals (no struct passing)
// ============================================================

fn gp_init(token_count: i64) with Mut {
    GP_TOKEN_COUNT = token_count
    GP_POS = 0
    GP_NEXT_ID = 1
    GP_HAD_ERROR = 0
    GP_ERROR_COUNT = 0
    GP_NO_STRUCT_LIT = 0
    GP_PENDING_GT = 0
}

fn gp_at_eof() -> bool with Panic {
    gp_peek_kind() == TokenKind::Eof
}

fn gp_peek_kind() -> TokenKind with Panic {
    if GP_PENDING_GT > 0 {
        TokenKind::Gt
    } else {
        if GP_POS < GP_TOKEN_COUNT {
            pt_read_kind(GP_POS)
        } else {
            TokenKind::Eof
        }
    }
}

fn gp_advance() with Mut, Panic {
    if GP_PENDING_GT > 0 {
        GP_PENDING_GT = GP_PENDING_GT - 1
        if GP_PENDING_GT > 0 { return }
        if GP_POS < GP_TOKEN_COUNT { GP_POS = GP_POS + 1 }
    } else if GP_POS < GP_TOKEN_COUNT {
        GP_POS = GP_POS + 1
    }
    // Skip newlines
    while GP_POS < GP_TOKEN_COUNT && pt_read_kind(GP_POS) == TokenKind::Newline {
        GP_POS = GP_POS + 1
    }
}

fn gp_current_span_start() -> i64 with Panic {
    if GP_POS < GP_TOKEN_COUNT { PT_START[GP_POS as usize] } else { 0 }
}

fn gp_current_span_end() -> i64 with Panic {
    if GP_POS < GP_TOKEN_COUNT { PT_END[GP_POS as usize] } else { 0 }
}

fn gp_current_line() -> i64 with Panic {
    if GP_POS < GP_TOKEN_COUNT { PT_LINE[GP_POS as usize] } else { 0 }
}

// ============================================================
// Token access
// ============================================================

// Read token kind from parallel scalar array (boot4-compatible)
fn pt_read_kind(idx: i64) -> TokenKind with Panic {
    if idx >= 0 && idx < 1048576 {
        PT_KIND[idx as usize]
    } else {
        TokenKind::Eof
    }
}

impl Parser {
    fn current(self: Parser) -> Token with Panic, Div {
        // Construct from parallel scalar arrays (boot4-compatible)
        var tok = Token::new()
        if self.pos < self.token_count {
            tok.kind = PT_KIND[self.pos as usize]
            tok.start = PT_START[self.pos as usize]
            tok.int_value = PT_INT_VALUE[self.pos as usize]
            tok.text_len = PT_TEXT_LEN[self.pos as usize]
        }
        tok
    }

    fn current_int_value(self: Parser) -> i64 with Panic {
        if self.pos >= 0 && self.pos < 1048576 { PT_INT_VALUE[self.pos as usize] } else { 0 }
    }

    fn peek(self: Parser) -> TokenKind with Panic, Div {
        if self.pending_gt > 0 {
            TokenKind::Gt
        } else {
            if self.pos < self.token_count {
                pt_read_kind(self.pos)
            } else {
                TokenKind::Eof
            }
        }
    }

    fn peek_ahead(self: Parser, offset: i64) -> TokenKind with Panic, Div {
        if self.pending_gt > 0 {
            if offset < self.pending_gt {
                TokenKind::Gt
            } else {
                let idx = self.pos + 1 + (offset - self.pending_gt)
                if idx < self.token_count {
                    pt_read_kind(idx)
                } else {
                    TokenKind::Eof
                }
            }
        } else {
            let idx = self.pos + offset
            if idx < self.token_count {
                pt_read_kind(idx)
            } else {
                TokenKind::Eof
            }
        }
    }

    fn at(self: Parser, kind: TokenKind) -> bool with Panic, Div {
        self.peek() == kind
    }

    fn at_eof(self: Parser) -> bool with Panic, Div {
        self.peek() == TokenKind::Eof
    }

    // Returns true if the current token is on a later line than the previous token.
    // Used by the Pratt parser to prevent `ident\n(` from being parsed as a call.
    // The self-hosted lexer discards newline tokens, so we compare line numbers.
    fn had_newline_before(self: Parser) -> bool with Panic, Div {
        if self.pos <= 0 { return false }
        let prev_line = PT_LINE[(self.pos - 1) as usize]
        let cur_line = PT_LINE[self.pos as usize]
        prev_line < cur_line
    }

    // ============================================================
    // Advance
    // ============================================================

    fn advance(self: Parser) -> Parser with Mut, Panic, Div {
        var p = self
        if p.pending_gt > 0 {
            p.pending_gt = p.pending_gt - 1
            if p.pending_gt > 0 {
                return p
            }
            // Consumed the last synthetic `>`; now consume the underlying token.
            if p.pos < p.token_count {
                p.pos = p.pos + 1
            }
        } else if p.pos < p.token_count {
            p.pos = p.pos + 1
        }
        // Skip newlines automatically (they're insignificant in most contexts)
        while p.pos < p.token_count && pt_read_kind(p.pos) == TokenKind::Newline {
            p.pos = p.pos + 1
        }
        p
    }

    fn advance_raw(self: Parser) -> Parser with Mut, Panic, Div {
        var p = self
        if p.pending_gt > 0 {
            p.pending_gt = p.pending_gt - 1
            if p.pending_gt == 0 && p.pos < p.token_count {
                p.pos = p.pos + 1
            }
            p
        } else {
            if p.pos < p.token_count {
                p.pos = p.pos + 1
            }
            p
        }
    }

    // ============================================================
    // Expect
    // ============================================================

    fn expect(self: Parser, kind: TokenKind) -> Parser with Mut, IO, Panic, Div {
        // In type contexts, allow `>>` to act as two consecutive `>` tokens.
        if kind == TokenKind::Gt && self.pending_gt == 0 && self.peek() == TokenKind::Shr {
            var p = self
            p.pending_gt = 2
            return p.advance()
        }
        if self.peek() == kind {
            return self.advance()
        }
        // Error recovery
        var p = self
        p.had_error = true
        p.error_count = p.error_count + 1
        print("parse error: expected token at line ")
        print_int(PT_LINE[p.pos as usize])
        print(", col ")
        print_int(PT_COL[p.pos as usize])
        print(" (span ")
        print_int(PT_START[p.pos as usize])
        print("..")
        print_int(PT_END[p.pos as usize])
        print(")\n")
        p
    }

    fn expect_ident(self: Parser) -> Parser with Mut, IO, Panic, Div {
        let k = self.peek()
        if k == TokenKind::Ident || tk_is_keyword(k) {
            self.advance()
        } else {
            // Avoid infinite loops on identifier mismatches by consuming a token.
            var p = self
            p = p.expect(TokenKind::Ident)
            p.advance()
        }
    }

    // ============================================================
    // Node ID allocation
    // ============================================================

    fn alloc_id(self: Parser) -> Parser with Mut {
        var p = self
        p.next_id = p.next_id + 1
        p
    }

    fn current_id(self: Parser) -> NodeId {
        NodeId { id: self.next_id }
    }

    // ============================================================
    // Span helpers
    // ============================================================

    fn current_span(self: Parser) -> Span with Panic, Div {
        if self.pos < self.token_count {
            Span::new(
                0,
                PT_START[self.pos as usize],
                PT_END[self.pos as usize]
            )
        } else {
            Span::new(0, 0, 0)
        }
    }

    fn span_from(self: Parser, start: Span) -> Span with Panic, Div {
        if self.pos < self.token_count {
            Span::new(start.file_id, start.start, PT_END[self.pos as usize])
        } else {
            Span::new(start.file_id, start.start, start.end)
        }
    }

    // ============================================================
    // Name extraction from current token
    // ============================================================

    fn current_name(self: Parser) -> Name with Mut, Panic, Div {
        if self.pos < self.token_count {
            // Read from source buffer using parallel start/end arrays (boot4-compatible)
            let s = PT_START[self.pos as usize]
            let e = PT_END[self.pos as usize]
            var nlen = e - s
            if nlen > 128 { nlen = 128 }
            if nlen < 0 { nlen = 0 }
            var name = Name { buf: [0; 128], len: nlen }
            var i: i64 = 0
            while i < nlen {
                name.buf[i as usize] = CURSOR_SOURCE[(s + i) as usize]
                i = i + 1
            }
            name
        } else {
            Name { buf: [0; 128], len: 0 }
        }
    }

    // ============================================================
    // Utility: check if current token starts an expression
    // ============================================================

    fn at_expr_start(self: Parser) -> bool with Panic, Div {
        let k = self.peek()
        k == TokenKind::IntLit
            || k == TokenKind::FloatLit
            || k == TokenKind::StringLit
            || k == TokenKind::CharLit
            || k == TokenKind::True
            || k == TokenKind::False
            || k == TokenKind::Ident
            || k == TokenKind::LParen
            || k == TokenKind::LBracket
            || k == TokenKind::LBrace
            || k == TokenKind::Minus
            || k == TokenKind::Bang
            || k == TokenKind::Amp
            || k == TokenKind::AmpBang
            || k == TokenKind::Star
            || k == TokenKind::If
            || k == TokenKind::Match
            || k == TokenKind::While
            || k == TokenKind::Loop
            || k == TokenKind::Return
            || k == TokenKind::Break
            || k == TokenKind::Continue
            || k == TokenKind::SelfLower
            || k == TokenKind::ContestLower
    }

    // ============================================================
    // Utility: check if current token starts an item
    // ============================================================

    fn at_item_start(self: Parser) -> bool with Panic, Div {
        let k = self.peek()
        k == TokenKind::Fn
            || k == TokenKind::Struct
            || k == TokenKind::Enum
            || k == TokenKind::Impl
            || k == TokenKind::Type
            || k == TokenKind::PolicyLower
            || k == TokenKind::Use
            || k == TokenKind::Import
            || k == TokenKind::Linear
            || k == TokenKind::Pub
    }
}

// ============================================================
// Default constructors for AST nodes (all fields zeroed/None)
// ============================================================

fn dummy_type_expr() -> TypeExpr {
    TypeExpr {
        kind: TypeExprKind::TypeUnit,
        span: Span::dummy(),
        path: empty_path(),
        type_args: None,
        inner: None,
        array_size: None,
        effects: None,
        knowledge_info: None,
        refinement_info: None,
    }
}

fn error_expr(span: Span) -> Expr {
    Expr {
        kind: ExprKind::ExprError,
        span: span,
        int_val: 0,
        float_val: 0.0,
        name: empty_name(),
        path: empty_path(),
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        left: None,
        right: None,
        block: None,
        else_expr: None,
        args: None,
        arms: None,
        fields: None,
        cast_type: None,
        handler_block: None,
        closure_params: None,
        closure_return: None,
        closure_effects: None,
        closure_body: None,
        type_args: None,
    }
}

fn mk_expr(kind: ExprKind, span: Span) -> Expr {
    Expr {
        kind: kind,
        span: span,
        int_val: 0,
        float_val: 0.0,
        name: empty_name(),
        path: empty_path(),
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        left: None,
        right: None,
        block: None,
        else_expr: None,
        args: None,
        arms: None,
        fields: None,
        cast_type: None,
        handler_block: None,
        closure_params: None,
        closure_return: None,
        closure_effects: None,
        closure_body: None,
        type_args: None,
    }
}
