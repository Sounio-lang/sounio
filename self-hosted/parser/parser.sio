// Parser core: token stream navigation, error recovery, node construction helpers.

module parser::parser

use parser::ast::*
use lexer::token::*
use lexer::cursor::*

// Keep token storage out of Parser state so Parser method calls don't
// repeatedly copy a 65k token array by value.
var PARSER_TOKENS: [Token; 2097152] = [Token::new(); 2097152]
// Boot4-compatible parallel scalar arrays (boot4 can't index struct-typed global arrays)
var PT_KIND: [TokenKind; 2097152] = [TokenKind::Eof; 2097152]
var PT_KIND_CODE: [i64; 2097152] = [0; 2097152]
var PT_START: [i64; 2097152] = [0; 2097152]
var PT_END: [i64; 2097152] = [0; 2097152]
var PT_LINE: [i64; 2097152] = [0; 2097152]
var PT_COL: [i64; 2097152] = [0; 2097152]
var PT_TEXT_LEN: [i64; 2097152] = [0; 2097152]
var PT_INT_VALUE: [i64; 2097152] = [0; 2097152]
// Boot4-safe: parse_item stores its result here instead of returning (Parser, Item)
// which is 314+ slots and triggers IS_SPTR=4 hang. The caller reads this after parse_item returns.
var LAST_PARSED_ITEM: Option<Box<Item> > = None
// Boot4-safe: expr functions return Parser only; Expr stored here to avoid
// (Parser, Expr) = 74-slot SRET which corrupts rdi in the lean compiler.
var LAST_EXPR: Option<Box<Expr> > = None

pub fn parser_store_expr_box(b: Box<Expr>) with Mut {
    LAST_EXPR = Some(b)
}

pub fn parser_take_expr_box() -> Box<Expr> with Mut, Panic, Alloc {
    match LAST_EXPR {
        Some(b) => {
            LAST_EXPR = None
            b
        },
        None => {
            LAST_EXPR = None
            panic("parser_take_expr_box: missing expr")
        },
    }
}

// Boot4-safe: scalar globals mirroring Parser struct fields.
// boot4 corrupts struct-by-value field access, so the parser loop
// reads/writes these globals instead of Parser.field.
var GP_TOKEN_COUNT: i64 = 0
var GP_POS: i64 = 0
var GP_NEXT_ID: i64 = 1
var GP_HAD_ERROR: i64 = 0
var GP_ERROR_COUNT: i64 = 0
var GP_NO_STRUCT_LIT: i64 = 0
var GP_PENDING_GT: i64 = 0
var PARSER_FAST_SKIP_BLOCKS: bool = false
var PARSER_LAST_HAD_ERROR: bool = false
var PARSER_LAST_ERROR_COUNT: i64 = 0

// String literals longer than Name's 128-byte buffer are CUT at current_name(),
// and until now nothing said so. Measured 2026-08-04: the boundary is exactly
// 128 — a 127-char literal prints whole, a 128-char one prints 127 and the
// program carries on as if nothing happened. 324 literals in 14 files under
// self-hosted/ and stdlib/ are over it, the longest 335 chars in
// self-hosted/check/check.sio, so the compiler's own diagnostics are among the
// text being silently shortened.
//
// The cut cannot simply be removed: Name is embedded in 88 fixed-size arrays,
// some [Name; 4096], so widening the buffer to 512 would take Name storage from
// 6.5 MB to 26 MB in a build that already emits 152 "stack frame too large"
// warnings. So the cut stays and the SILENCE goes.
//
// Recorded in globals rather than printed on the spot because current_name()
// carries only Mut/Panic/Div; giving it IO would push that effect onto every
// caller. Same shape as PARSER_LAST_ERROR_COUNT above, reported once where IO
// already exists.
var PARSER_TRUNCATED_LITERALS: i64 = 0
var PARSER_TRUNCATED_FIRST_LINE: i64 = 0
var PARSER_TRUNCATED_LONGEST: i64 = 0

pub struct Parser {
    token_count: i64,
    pos: i64,
    next_id: i64,
    had_error: bool,
    error_count: i64,
    no_struct_lit: bool,
    // When parsing nested generic type args like `Option<Box<T>>`, the lexer
    // produces a single `>>` token. In type contexts we need to treat that as
    // two consecutive `>` tokens. This counter tracks pending synthetic `>`
    // tokens to emit before consuming the underlying `>>`.
    pending_gt: i64,
}

// ============================================================
// Construction
// ============================================================

pub fn parser_new() -> Parser {
    Parser {
        token_count: 0,
        pos: 0,
        next_id: 1,
        had_error: false,
        error_count: 0,
        no_struct_lit: false,
        pending_gt: 0,
    }
}

pub fn parser_set_tokens(tokens: [Token; 2097152], token_count: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < token_count && i < 2097152 {
        // Write to parallel scalar arrays (boot4-compatible)
        PT_KIND[i as usize] = tokens[i as usize].kind
        PT_KIND_CODE[i as usize] = tokens[i as usize].kind as i64
        PT_START[i as usize] = tokens[i as usize].start
        PT_END[i as usize] = tokens[i as usize].end
        PT_LINE[i as usize] = tokens[i as usize].line
        PT_COL[i as usize] = tokens[i as usize].col
        PT_INT_VALUE[i as usize] = tokens[i as usize].int_value
        PT_TEXT_LEN[i as usize] = tokens[i as usize].text_len
        i = i + 1
    }
}

pub fn parser_set_token_at(idx: i64, tok: Token) with Mut, Panic {
    if idx >= 0 && idx < 2097152 {
        // Write to parallel scalar arrays (boot4-compatible, avoids struct-typed global array write)
        PT_KIND[idx as usize] = tok.kind
        PT_KIND_CODE[idx as usize] = tok.kind as i64
        PT_START[idx as usize] = tok.start
        PT_END[idx as usize] = tok.end
        PT_LINE[idx as usize] = tok.line
        PT_COL[idx as usize] = tok.col
        PT_INT_VALUE[idx as usize] = tok.int_value
        PT_TEXT_LEN[idx as usize] = tok.text_len
    }
}

fn parser_get_token_at(idx: i64) -> Token with Panic {
    if idx >= 0 && idx < 2097152 {
        PARSER_TOKENS[idx as usize]
    } else {
        Token::with_kind(TokenKind::Eof, 0, 0, 0, 0)
    }
}

// Boot4-safe: write token fields directly into PARSER_TOKENS without creating Token local
// Avoids boot4's 4MB stack frame for functions with IS_SPTR=4 locals
pub fn parser_set_token_scalar(idx: i64, kind: TokenKind, start: i64, end: i64, line: i64, col: i64) with Mut, Panic {
    if idx >= 0 && idx < 2097152 {
        // Parallel scalar arrays (boot4/stage0 compatible)
        PT_KIND[idx as usize] = kind
        PT_KIND_CODE[idx as usize] = kind as i64
        PT_START[idx as usize] = start
        PT_END[idx as usize] = end
        PT_LINE[idx as usize] = line
        PT_COL[idx as usize] = col
        PT_TEXT_LEN[idx as usize] = 0
        PT_INT_VALUE[idx as usize] = 0
    }
}

pub fn parser_set_token_int_value(idx: i64, val: i64) with Mut, Panic {
    if idx >= 0 && idx < 2097152 {
        PT_INT_VALUE[idx as usize] = val
    }
}

fn parser_set_token_float_value(idx: i64, val: f64) with Mut, Panic {
    if idx >= 0 && idx < 2097152 {
        // float_value not in PT_* arrays yet — skip for boot4 compatibility
        let dummy = val
    }
}

fn parser_set_token_text_byte(idx: i64, byte_idx: i64, val: i8) with Mut, Panic {
    // PARSER_TOKENS struct write skipped for stage0 compatibility
    // Token text is stored in PT_TEXT_* parallel arrays instead
    if idx >= 0 && idx < 2097152 && byte_idx >= 0 && byte_idx < 256 {
        // Skip: PARSER_TOKENS[idx as usize].text[byte_idx as usize] = val
        let dummy = val
    }
}

fn parser_set_token_text_len(idx: i64, len: i64) with Mut, Panic {
    if idx >= 0 && idx < 2097152 {
        PT_TEXT_LEN[idx as usize] = len
    }
}

// Flat token setters for lexers that can't construct TokenKind/Token.
// Sets all scalar fields at once using integer kind discriminant.
pub fn parser_set_token_flat(idx: i64, kind: i64, start: i64, end: i64, line: i64, col: i64, int_value: i64) with Mut, Panic {
    if idx >= 0 && idx < 2097152 {
        PT_KIND_CODE[idx as usize] = kind
        // TokenKind enum discriminant table — lean compiler stores enums as i64
        // We construct the TokenKind via a dispatch to avoid needing enum literals
        // Discriminants match TokenKind enum order in lexer/token.sio
        if kind == 0 { PT_KIND[idx as usize] = TokenKind::Eof }
        else if kind == 2 { PT_KIND[idx as usize] = TokenKind::Newline }
        else if kind == 5 { PT_KIND[idx as usize] = TokenKind::Use }
        else if kind == 7 { PT_KIND[idx as usize] = TokenKind::Fn }
        else if kind == 8 { PT_KIND[idx as usize] = TokenKind::Let }
        else if kind == 9 { PT_KIND[idx as usize] = TokenKind::Var }
        else if kind == 12 { PT_KIND[idx as usize] = TokenKind::Type }
        else if kind == 13 { PT_KIND[idx as usize] = TokenKind::Struct }
        else if kind == 14 { PT_KIND[idx as usize] = TokenKind::Enum }
        else if kind == 19 { PT_KIND[idx as usize] = TokenKind::Ontology }
        else if kind == 20 { PT_KIND[idx as usize] = TokenKind::If }
        else if kind == 21 { PT_KIND[idx as usize] = TokenKind::Else }
        else if kind == 24 { PT_KIND[idx as usize] = TokenKind::While }
        else if kind == 28 { PT_KIND[idx as usize] = TokenKind::Return }
        else if kind == 30 { PT_KIND[idx as usize] = TokenKind::As }
        else if kind == 31 { PT_KIND[idx as usize] = TokenKind::Where }
        else if kind == 32 { PT_KIND[idx as usize] = TokenKind::Pub }
        else if kind == 35 { PT_KIND[idx as usize] = TokenKind::True }
        else if kind == 36 { PT_KIND[idx as usize] = TokenKind::False }
        else if kind == 45 { PT_KIND[idx as usize] = TokenKind::With }
        else if kind == 71 { PT_KIND[idx as usize] = TokenKind::Knowledge }
        else if kind == 123 { PT_KIND[idx as usize] = TokenKind::Ident }
        else if kind == 124 { PT_KIND[idx as usize] = TokenKind::IntLit }
        else if kind == 125 { PT_KIND[idx as usize] = TokenKind::FloatLit }
        else if kind == 126 { PT_KIND[idx as usize] = TokenKind::StringLit }
        else if kind == 127 { PT_KIND[idx as usize] = TokenKind::CharLit }
        else if kind == 128 { PT_KIND[idx as usize] = TokenKind::BoolLit }
        else if kind == 129 { PT_KIND[idx as usize] = TokenKind::HexLit }
        else if kind == 130 { PT_KIND[idx as usize] = TokenKind::BinLit }
        else if kind == 131 { PT_KIND[idx as usize] = TokenKind::OctLit }
        else if kind == 132 { PT_KIND[idx as usize] = TokenKind::Plus }
        else if kind == 133 { PT_KIND[idx as usize] = TokenKind::Minus }
        else if kind == 134 { PT_KIND[idx as usize] = TokenKind::Star }
        else if kind == 135 { PT_KIND[idx as usize] = TokenKind::Slash }
        else if kind == 136 { PT_KIND[idx as usize] = TokenKind::Percent }
        else if kind == 137 { PT_KIND[idx as usize] = TokenKind::Eq }
        else if kind == 138 { PT_KIND[idx as usize] = TokenKind::Lt }
        else if kind == 139 { PT_KIND[idx as usize] = TokenKind::Gt }
        else if kind == 140 { PT_KIND[idx as usize] = TokenKind::Bang }
        else if kind == 141 { PT_KIND[idx as usize] = TokenKind::Amp }
        else if kind == 142 { PT_KIND[idx as usize] = TokenKind::Pipe }
        else if kind == 143 { PT_KIND[idx as usize] = TokenKind::Caret }
        else if kind == 144 { PT_KIND[idx as usize] = TokenKind::Tilde }
        else if kind == 145 { PT_KIND[idx as usize] = TokenKind::Question }
        else if kind == 146 { PT_KIND[idx as usize] = TokenKind::EqEq }
        else if kind == 147 { PT_KIND[idx as usize] = TokenKind::BangEq }
        else if kind == 148 { PT_KIND[idx as usize] = TokenKind::LtEq }
        else if kind == 149 { PT_KIND[idx as usize] = TokenKind::GtEq }
        else if kind == 150 { PT_KIND[idx as usize] = TokenKind::AmpAmp }
        else if kind == 151 { PT_KIND[idx as usize] = TokenKind::PipePipe }
        else if kind == 152 { PT_KIND[idx as usize] = TokenKind::Shl }
        else if kind == 153 { PT_KIND[idx as usize] = TokenKind::Shr }
        else if kind == 154 { PT_KIND[idx as usize] = TokenKind::PlusEq }
        else if kind == 155 { PT_KIND[idx as usize] = TokenKind::MinusEq }
        else if kind == 156 { PT_KIND[idx as usize] = TokenKind::StarEq }
        else if kind == 157 { PT_KIND[idx as usize] = TokenKind::SlashEq }
        else if kind == 158 { PT_KIND[idx as usize] = TokenKind::Arrow }
        else if kind == 159 { PT_KIND[idx as usize] = TokenKind::FatArrow }
        else if kind == 160 { PT_KIND[idx as usize] = TokenKind::DotDot }
        else if kind == 161 { PT_KIND[idx as usize] = TokenKind::DotDotEq }
        else if kind == 162 { PT_KIND[idx as usize] = TokenKind::ColonColon }
        else if kind == 163 { PT_KIND[idx as usize] = TokenKind::AmpBang }
        else if kind == 164 { PT_KIND[idx as usize] = TokenKind::PlusPlus }
        else if kind == 165 { PT_KIND[idx as usize] = TokenKind::PipeEq }
        else if kind == 166 { PT_KIND[idx as usize] = TokenKind::ShlEq }
        else if kind == 167 { PT_KIND[idx as usize] = TokenKind::ShrEq }
        else if kind == 168 { PT_KIND[idx as usize] = TokenKind::PercentEq }
        else if kind == 169 { PT_KIND[idx as usize] = TokenKind::CaretEq }
        else if kind == 170 { PT_KIND[idx as usize] = TokenKind::AmpEq }
        else if kind == 171 { PT_KIND[idx as usize] = TokenKind::LeftArrow }
        else if kind == 172 { PT_KIND[idx as usize] = TokenKind::DotDotDot }
        else if kind == 173 { PT_KIND[idx as usize] = TokenKind::PlusMinus }
        else if kind == 174 { PT_KIND[idx as usize] = TokenKind::LParen }
        else if kind == 175 { PT_KIND[idx as usize] = TokenKind::RParen }
        else if kind == 176 { PT_KIND[idx as usize] = TokenKind::LBrace }
        else if kind == 177 { PT_KIND[idx as usize] = TokenKind::RBrace }
        else if kind == 178 { PT_KIND[idx as usize] = TokenKind::LBracket }
        else if kind == 179 { PT_KIND[idx as usize] = TokenKind::RBracket }
        else if kind == 180 { PT_KIND[idx as usize] = TokenKind::Semi }
        else if kind == 181 { PT_KIND[idx as usize] = TokenKind::Colon }
        else if kind == 182 { PT_KIND[idx as usize] = TokenKind::Comma }
        else if kind == 183 { PT_KIND[idx as usize] = TokenKind::Dot }
        else if kind == 184 { PT_KIND[idx as usize] = TokenKind::At }
        else if kind == 185 { PT_KIND[idx as usize] = TokenKind::Hash }
        else if kind == 186 { PT_KIND[idx as usize] = TokenKind::Underscore }
        else { PT_KIND[idx as usize] = TokenKind::Error }
        PT_KIND_CODE[idx as usize] = kind
        PT_START[idx as usize] = start
        PT_END[idx as usize] = end
        PT_LINE[idx as usize] = line
        PT_COL[idx as usize] = col
        PT_INT_VALUE[idx as usize] = int_value
        PT_TEXT_LEN[idx as usize] = 0
    }
}

fn parser_set_fast_skip_blocks(enabled: bool) with Mut {
    PARSER_FAST_SKIP_BLOCKS = enabled
}

pub fn parser_reset_last_errors() with Mut {
    PARSER_LAST_HAD_ERROR = false
    PARSER_LAST_ERROR_COUNT = 0
}

pub fn parser_set_last_errors(had_error: bool, error_count: i64) with Mut {
    PARSER_LAST_HAD_ERROR = had_error
    PARSER_LAST_ERROR_COUNT = error_count
}

pub fn parser_last_had_error() -> bool {
    PARSER_LAST_HAD_ERROR
}

pub fn parser_last_error_count() -> i64 {
    PARSER_LAST_ERROR_COUNT
}

pub fn parser_reset_truncated_literals() with Mut {
    PARSER_TRUNCATED_LITERALS = 0
    PARSER_TRUNCATED_FIRST_LINE = 0
    PARSER_TRUNCATED_LONGEST = 0
}


pub fn parser_truncated_literal_count() -> i64 {
    PARSER_TRUNCATED_LITERALS
}

pub fn parser_truncated_literal_first_line() -> i64 {
    PARSER_TRUNCATED_FIRST_LINE
}

pub fn parser_truncated_literal_longest() -> i64 {
    PARSER_TRUNCATED_LONGEST
}

// ============================================================
// Boot4-safe parser operations using GP_* globals (no struct passing)
// ============================================================

fn gp_init(token_count: i64) with Mut {
    GP_TOKEN_COUNT = token_count
    GP_POS = 0
    GP_NEXT_ID = 1
    GP_HAD_ERROR = 0
    GP_ERROR_COUNT = 0
    GP_NO_STRUCT_LIT = 0
    GP_PENDING_GT = 0
}

fn gp_at_eof() -> bool with Mut, Panic, Div {
    gp_peek_kind() == TokenKind::Eof
}

fn gp_peek_kind() -> TokenKind with Mut, Panic, Div {
    if GP_PENDING_GT > 0 {
        TokenKind::Gt
    } else {
        if GP_POS < GP_TOKEN_COUNT {
            pt_read_kind(GP_POS)
        } else {
            TokenKind::Eof
        }
    }
}

fn gp_advance() with Mut, Panic, Div {
    if GP_PENDING_GT > 0 {
        GP_PENDING_GT = GP_PENDING_GT - 1
        if GP_PENDING_GT > 0 { return }
        if GP_POS < GP_TOKEN_COUNT { GP_POS = GP_POS + 1 }
    } else if GP_POS < GP_TOKEN_COUNT {
        GP_POS = GP_POS + 1
    }
    // Skip newlines
    while GP_POS < GP_TOKEN_COUNT && pt_read_kind(GP_POS) == TokenKind::Newline {
        GP_POS = GP_POS + 1
    }
}

fn gp_current_span_start() -> i64 with Panic {
    if GP_POS < GP_TOKEN_COUNT { PT_START[GP_POS as usize] } else { 0 }
}

fn gp_current_span_end() -> i64 with Panic {
    if GP_POS < GP_TOKEN_COUNT { PT_END[GP_POS as usize] } else { 0 }
}

fn gp_current_line() -> i64 with Panic {
    if GP_POS < GP_TOKEN_COUNT { PT_LINE[GP_POS as usize] } else { 0 }
}

// ============================================================
// Token access
// ============================================================

fn token_kind_from_flat_code(kind: i64) -> TokenKind {
    if kind == 0 { return TokenKind::Eof }
    if kind == 2 { return TokenKind::Newline }
    if kind == 5 { return TokenKind::Use }
    if kind == 7 { return TokenKind::Fn }
    if kind == 8 { return TokenKind::Let }
    if kind == 9 { return TokenKind::Var }
    if kind == 12 { return TokenKind::Type }
    if kind == 13 { return TokenKind::Struct }
    if kind == 14 { return TokenKind::Enum }
    if kind == 19 { return TokenKind::Ontology }
    if kind == 20 { return TokenKind::If }
    if kind == 21 { return TokenKind::Else }
    if kind == 24 { return TokenKind::While }
    if kind == 28 { return TokenKind::Return }
    if kind == 30 { return TokenKind::As }
    if kind == 31 { return TokenKind::Where }
    if kind == 32 { return TokenKind::Pub }
    if kind == 35 { return TokenKind::True }
    if kind == 36 { return TokenKind::False }
    if kind == 45 { return TokenKind::With }
    if kind == 71 { return TokenKind::Knowledge }
    if kind == 123 { return TokenKind::Ident }
    if kind == 124 { return TokenKind::IntLit }
    if kind == 125 { return TokenKind::FloatLit }
    if kind == 126 { return TokenKind::StringLit }
    if kind == 127 { return TokenKind::CharLit }
    if kind == 128 { return TokenKind::BoolLit }
    if kind == 129 { return TokenKind::HexLit }
    if kind == 130 { return TokenKind::BinLit }
    if kind == 131 { return TokenKind::OctLit }
    if kind == 132 { return TokenKind::Plus }
    if kind == 133 { return TokenKind::Minus }
    if kind == 134 { return TokenKind::Star }
    if kind == 135 { return TokenKind::Slash }
    if kind == 136 { return TokenKind::Percent }
    if kind == 137 { return TokenKind::Eq }
    if kind == 138 { return TokenKind::Lt }
    if kind == 139 { return TokenKind::Gt }
    if kind == 140 { return TokenKind::Bang }
    if kind == 141 { return TokenKind::Amp }
    if kind == 142 { return TokenKind::Pipe }
    if kind == 143 { return TokenKind::Caret }
    if kind == 144 { return TokenKind::Tilde }
    if kind == 145 { return TokenKind::Question }
    if kind == 146 { return TokenKind::EqEq }
    if kind == 147 { return TokenKind::BangEq }
    if kind == 148 { return TokenKind::LtEq }
    if kind == 149 { return TokenKind::GtEq }
    if kind == 150 { return TokenKind::AmpAmp }
    if kind == 151 { return TokenKind::PipePipe }
    if kind == 152 { return TokenKind::Shl }
    if kind == 153 { return TokenKind::Shr }
    if kind == 154 { return TokenKind::PlusEq }
    if kind == 155 { return TokenKind::MinusEq }
    if kind == 156 { return TokenKind::StarEq }
    if kind == 157 { return TokenKind::SlashEq }
    if kind == 158 { return TokenKind::Arrow }
    if kind == 159 { return TokenKind::FatArrow }
    if kind == 160 { return TokenKind::DotDot }
    if kind == 161 { return TokenKind::DotDotEq }
    if kind == 162 { return TokenKind::ColonColon }
    if kind == 163 { return TokenKind::AmpBang }
    if kind == 164 { return TokenKind::PlusPlus }
    if kind == 165 { return TokenKind::PipeEq }
    if kind == 166 { return TokenKind::ShlEq }
    if kind == 167 { return TokenKind::ShrEq }
    if kind == 168 { return TokenKind::PercentEq }
    if kind == 169 { return TokenKind::CaretEq }
    if kind == 170 { return TokenKind::AmpEq }
    if kind == 171 { return TokenKind::LeftArrow }
    if kind == 172 { return TokenKind::DotDotDot }
    if kind == 173 { return TokenKind::PlusMinus }
    if kind == 174 { return TokenKind::LParen }
    if kind == 175 { return TokenKind::RParen }
    if kind == 176 { return TokenKind::LBrace }
    if kind == 177 { return TokenKind::RBrace }
    if kind == 178 { return TokenKind::LBracket }
    if kind == 179 { return TokenKind::RBracket }
    if kind == 180 { return TokenKind::Semi }
    if kind == 181 { return TokenKind::Colon }
    if kind == 182 { return TokenKind::Comma }
    if kind == 183 { return TokenKind::Dot }
    if kind == 184 { return TokenKind::At }
    if kind == 185 { return TokenKind::Hash }
    if kind == 186 { return TokenKind::Underscore }
    TokenKind::Error
}

// Read token kind from parallel scalar code array. Avoid reading PT_KIND for
// high-valued variants because the boot4 global enum array corrupts them.
pub fn pt_read_kind(idx: i64) -> TokenKind with Mut, Panic, Div {
    if idx >= 0 && idx < 2097152 {
        let code = PT_KIND_CODE[idx as usize]
        let start = PT_START[idx as usize]
        let end = PT_END[idx as usize]
        let len = end - start
        if code == 0 && len == 0 {
            return TokenKind::Eof
        }
        if len == 0 {
            if code == 132 { return TokenKind::Plus }
            if code == 133 { return TokenKind::Minus }
            if code == 134 { return TokenKind::Star }
            if code == 135 { return TokenKind::Slash }
            if code == 136 { return TokenKind::Percent }
            if code == 137 { return TokenKind::Eq }
            if code == 138 { return TokenKind::Lt }
            if code == 139 { return TokenKind::Gt }
            if code == 140 { return TokenKind::Bang }
            if code == 141 { return TokenKind::Amp }
            if code == 142 { return TokenKind::Pipe }
            if code == 143 { return TokenKind::Caret }
            if code == 144 { return TokenKind::Tilde }
            if code == 145 { return TokenKind::Question }
            if code == 146 { return TokenKind::EqEq }
            if code == 147 { return TokenKind::BangEq }
            if code == 148 { return TokenKind::LtEq }
            if code == 149 { return TokenKind::GtEq }
            if code == 150 { return TokenKind::AmpAmp }
            if code == 151 { return TokenKind::PipePipe }
            if code == 152 { return TokenKind::Shl }
            if code == 153 { return TokenKind::Shr }
            if code == 154 { return TokenKind::PlusEq }
            if code == 155 { return TokenKind::MinusEq }
            if code == 156 { return TokenKind::StarEq }
            if code == 157 { return TokenKind::SlashEq }
            if code == 158 { return TokenKind::Arrow }
            if code == 159 { return TokenKind::FatArrow }
            if code == 160 { return TokenKind::DotDot }
            if code == 161 { return TokenKind::DotDotEq }
            if code == 162 { return TokenKind::ColonColon }
            if code == 163 { return TokenKind::AmpBang }
            if code == 164 { return TokenKind::PlusPlus }
            if code == 165 { return TokenKind::PipeEq }
            if code == 166 { return TokenKind::ShlEq }
            if code == 167 { return TokenKind::ShrEq }
            if code == 168 { return TokenKind::PercentEq }
