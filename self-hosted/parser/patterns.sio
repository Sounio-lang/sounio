// Parser — pattern parsing
//
// Handles: wildcard, binding, literal, enum variant, struct, tuple, or-patterns.

use parser::ast::*
use lexer::token::*
use parser::parser::{parser_peek, parser_at_eof, pt_read_kind, parser_peek_ahead, parser_advance}

fn empty_pattern(span: Span) -> Pattern {
    Pattern {
        kind: PatternKind::PatWildcard,
        span: span,
        name: empty_name(),
        int_val: 0,
        path: empty_path(),
        sub_patterns: None,
        pat_fields: None,
        is_mut: false,
    }
}

impl Parser {
    // ============================================================
    // Pattern entry point
    // ============================================================

    fn parse_pattern(self) -> (Parser, Pattern) with Mut, IO, Panic, Div, Alloc {
        let pair = self.parse_pattern_atom()
        let p1 = pair.0
        let first = pair.1

        // Check for or-pattern: pat1 | pat2 | pat3
        if p1.peek() == TokenKind::Pipe {
            var p = p1
            var rev_list_opt: Option<Box<PatternList>> = Some(Box::new(PatternList { head: first, tail: None }))
            while parser_peek(p) == TokenKind::Pipe {
                p = p.advance()  // skip |
                let pair2 = p.parse_pattern_atom()
                p = pair2.0
                let next_pat = pair2.1
                rev_list_opt = Some(Box::new(PatternList { head: next_pat, tail: rev_list_opt }))
            }
            let span = p.span_from(first.span)
            (p, Pattern {
                kind: PatternKind::PatOr,
                span: span,
                name: empty_name(),
                int_val: 0,
                path: empty_path(),
                sub_patterns: reverse_pattern_list_opt(rev_list_opt),
                pat_fields: None,
                is_mut: false,
            })
        } else {
            (p1, first)
        }
    }

    // ============================================================
    // Pattern atom (no or-pattern at this level)
    // ============================================================

    fn parse_pattern_atom(self) -> (Parser, Pattern) with Mut, IO, Panic, Div, Alloc {
        let k = self.peek()

        if k == TokenKind::Underscore {
            self.parse_wildcard_pattern()
        } else if k == TokenKind::True {
            let span = self.current_span()
            let p = self.advance()
            (p, Pattern {
                kind: PatternKind::PatBoolTrue,
                span: span,
                name: empty_name(),
                int_val: 0,
                path: empty_path(),
                sub_patterns: None,
                pat_fields: None,
                is_mut: false,
            })
        } else if k == TokenKind::False {
            let span = self.current_span()
            let p = self.advance()
            (p, Pattern {
                kind: PatternKind::PatBoolFalse,
                span: span,
                name: empty_name(),
                int_val: 0,
                path: empty_path(),
                sub_patterns: None,
                pat_fields: None,
                is_mut: false,
            })
        } else if k == TokenKind::IntLit || k == TokenKind::HexLit || k == TokenKind::BinLit || k == TokenKind::OctLit {
            self.parse_int_pattern()
        } else if k == TokenKind::Minus {
            // Negative int pattern
            self.parse_neg_int_pattern()
        } else if k == TokenKind::StringLit {
            self.parse_string_pattern()
        } else if k == TokenKind::LParen {
            self.parse_tuple_pattern()
        } else if k == TokenKind::Ident || k == TokenKind::Handle || k == TokenKind::Unit || k == TokenKind::Kernel || tk_is_contextual_ident(k) {
            self.parse_ident_or_enum_pattern()
        } else if k == TokenKind::Var {
            // Contextual keyword: `var name` is a mutable binding pattern, but bare
            // `var` followed by `=` / `:` / pattern terminators is an identifier
            // named "var". Scientific code (knightian p-box, stats variance) uses
            // `let var = ...`; treating every `var` as mut-introducer made Madaros
            // reject those modules (expected `=`, got the next keyword/ident token).
            // lean_single already accepted bare `var` bindings.
            let next = parser_peek_ahead(self, 1)
            if next == TokenKind::Eq
                || next == TokenKind::Colon
                || next == TokenKind::Comma
                || next == TokenKind::RParen
                || next == TokenKind::RBrace
                || next == TokenKind::Pipe
                || next == TokenKind::FatArrow
            {
                self.parse_var_as_ident_binding_pattern()
            } else {
                self.parse_mut_binding_pattern()
            }
        } else {
            // Error recovery: advance past unrecognized token to avoid infinite loops
            let span = self.current_span()
            var p = self
            p.had_error = true
            p.error_count = p.error_count + 1
            p = p.advance()
            (p, empty_pattern(span))
        }
    }

    // ============================================================
    // Wildcard: _
    // ============================================================

    fn parse_wildcard_pattern(self) -> (Parser, Pattern) with Mut, IO, Panic, Div {
        let span = self.current_span()
        let p = self.advance()
        (p, Pattern {
            kind: PatternKind::PatWildcard,
            span: span,
            name: empty_name(),
            int_val: 0,
            path: empty_path(),
            sub_patterns: None,
            pat_fields: None,
            is_mut: false,
        })
    }

    // ============================================================
    // Integer literal pattern
    // ============================================================

    fn parse_int_pattern(self) -> (Parser, Pattern) with Mut, IO, Panic, Div {
        let span = self.current_span()
        let tok = self.current()
        let p = self.advance()
        (p, Pattern {
            kind: PatternKind::PatIntLit,
            span: span,
            name: empty_name(),
            int_val: tok.int_value,
            path: empty_path(),
            sub_patterns: None,
            pat_fields: None,
            is_mut: false,
        })
    }

    // ============================================================
    // Negative integer pattern: -42
    // ============================================================

    fn parse_neg_int_pattern(self) -> (Parser, Pattern) with Mut, IO, Panic, Div {
        let start = self.current_span()
        var p = self.advance()  // skip -
        let tok = p.current()
        let span = p.span_from(start)
        p = p.advance()
        (p, Pattern {
            kind: PatternKind::PatIntLit,
            span: span,
            name: empty_name(),
            int_val: 0 - tok.int_value,
            path: empty_path(),
            sub_patterns: None,
            pat_fields: None,
            is_mut: false,
        })
    }

    // ============================================================
    // String literal pattern
    // ============================================================

    fn parse_string_pattern(self) -> (Parser, Pattern) with Mut, IO, Panic, Div {
        let span = self.current_span()
        let name = self.current_name()
        let p = self.advance()
        (p, Pattern {
            kind: PatternKind::PatStringLit,
            span: span,
            name: name,
            int_val: 0,
            path: empty_path(),
            sub_patterns: None,
            pat_fields: None,
            is_mut: false,
        })
    }

    // ============================================================
    // Tuple pattern: (a, b, c)
    // ============================================================

    fn parse_tuple_pattern(self) -> (Parser, Pattern) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        var p = self.advance()  // skip (

        if parser_peek(p) == TokenKind::RParen {
            // Empty tuple pattern
            p = p.advance()
            let span = p.span_from(start)
            (p, Pattern {
                kind: PatternKind::PatTuple,
                span: span,
                name: empty_name(),
                int_val: 0,
                path: empty_path(),
                sub_patterns: None,
                pat_fields: None,
                is_mut: false,
            })
        } else {
            let pair = p.parse_pattern()
            p = pair.0
            let first = pair.1
            var rev_list_opt: Option<Box<PatternList>> = Some(Box::new(PatternList { head: first, tail: None }))

            while parser_peek(p) == TokenKind::Comma {
                p = p.advance()
                if parser_peek(p) == TokenKind::RParen { break }
                let pair2 = p.parse_pattern()
                p = pair2.0
                let next_pat = pair2.1
                rev_list_opt = Some(Box::new(PatternList { head: next_pat, tail: rev_list_opt }))
            }

            p = p.expect(TokenKind::RParen)
            let span = p.span_from(start)
            (p, Pattern {
                kind: PatternKind::PatTuple,
                span: span,
                name: empty_name(),
                int_val: 0,
                path: empty_path(),
                sub_patterns: reverse_pattern_list_opt(rev_list_opt),
                pat_fields: None,
                is_mut: false,
            })
        }
    }

    // ============================================================
    // Identifier-leading: binding, enum variant, struct pattern
    // ============================================================

    fn parse_ident_or_enum_pattern(self) -> (Parser, Pattern) with Mut, IO, Panic, Div, Alloc {
        let start = self.current_span()
        let name = self.current_name()

        // Check for :: => enum variant path
        if parser_peek_ahead(self, 1) == TokenKind::ColonColon {
            let pair = self.parse_type_path()
            let p1 = pair.0
            let path = pair.1

            if p1.peek() == TokenKind::LParen {
                // Enum variant with sub-patterns: Some(x), Ok(v)
                var p = p1.advance()  // skip (
                var rev_list_opt: Option<Box<PatternList>> = None

                if parser_peek(p) != TokenKind::RParen {
                    let pair2 = p.parse_pattern()
                    p = pair2.0
                    let first = pair2.1
                    rev_list_opt = Some(Box::new(PatternList { head: first, tail: None }))
                    while parser_peek(p) == TokenKind::Comma {
                        p = p.advance()
                        let pair3 = p.parse_pattern()
                        p = pair3.0
                        let next_pat = pair3.1
                        rev_list_opt = Some(Box::new(PatternList { head: next_pat, tail: rev_list_opt }))
                    }
                }

                p = p.expect(TokenKind::RParen)
                let span = p.span_from(start)
                (p, Pattern {
                    kind: PatternKind::PatEnum,
                    span: span,
                    name: empty_name(),
                    int_val: 0,
                    path: path,
                    sub_patterns: reverse_pattern_list_opt(rev_list_opt),
                    pat_fields: None,
                    is_mut: false,
                })
            } else if p1.peek() == TokenKind::LBrace {
                // Struct pattern: Foo { x, y: pat }
                self.parse_struct_pattern_body(p1, path, start)
            } else {
                // Enum unit variant: None, MyEnum::Variant
                let span = p1.span_from(start)
                (p1, Pattern {
                    kind: PatternKind::PatEnum,
                    span: span,
                    name: empty_name(),
                    int_val: 0,
                    path: path,
                    sub_patterns: None,
                    pat_fields: None,
                    is_mut: false,
                })
            }
        } else if parser_peek_ahead(self, 1) == TokenKind::LParen {
            // Bare name with parens: Some(x), None is handled below
            // Build single-segment path
            var p = self.advance()  // skip ident
            let path = AstPath {
                segments: StringList { head_buf: name.buf, head_len: name.len, tail: None },
                seg_count: 1,
            }

            // Enum variant with sub-patterns
            p = p.advance()  // skip (
            var rev_list_opt: Option<Box<PatternList>> = None

            if parser_peek(p) != TokenKind::RParen {
                let pair = p.parse_pattern()
                p = pair.0
                let first = pair.1
                rev_list_opt = Some(Box::new(PatternList { head: first, tail: None }))
                while parser_peek(p) == TokenKind::Comma {
                    p = p.advance()
                    let pair2 = p.parse_pattern()
                    p = pair2.0
                    let next_pat = pair2.1
                    rev_list_opt = Some(Box::new(PatternList { head: next_pat, tail: rev_list_opt }))
                }
            }

            p = p.expect(TokenKind::RParen)
            let span = p.span_from(start)
            (p, Pattern {
                kind: PatternKind::PatEnum,
                span: span,
                name: empty_name(),
                int_val: 0,
                path: path,
                sub_patterns: reverse_pattern_list_opt(rev_list_opt),
                pat_fields: None,
                is_mut: false,
            })
        } else if parser_peek_ahead(self, 1) == TokenKind::LBrace {
            // Struct pattern: MyStruct { field: pat }
            var p = self.advance()
            let path = AstPath {
                segments: StringList { head_buf: name.buf, head_len: name.len, tail: None },
                seg_count: 1,
            }
            self.parse_struct_pattern_body(p, path, start)
        } else {
            // Simple binding
            let span = self.current_span()
            let p = parser_advance(self)
            (p, Pattern {
                kind: PatternKind::PatBinding,
                span: span,
                name: name,
                int_val: 0,
                path: empty_path(),
                sub_patterns: None,
                pat_fields: None,
                is_mut: false,
            })
        }
    }

    // ============================================================
    // Struct pattern body: { field1: pat1, field2: pat2 }
    // ============================================================

    fn parse_struct_pattern_body(self, p: Parser, path: AstPath, start: Span) -> (Parser, Pattern) with Mut, IO, Panic, Div, Alloc {
        var parser = p.advance()  // skip {
        var rev_fields_opt: Option<Box<PatFieldList>> = None

        if parser.peek() != TokenKind::RBrace {
            let pair = parser.parse_pat_field()
            parser = pair.0
            let first_field = pair.1
            rev_fields_opt = Some(Box::new(PatFieldList { head: first_field, tail: None }))

            while parser.peek() == TokenKind::Comma {
                parser = parser.advance()
                if parser.peek() == TokenKind::RBrace { break }
                let pair2 = parser.parse_pat_field()
                parser = pair2.0
                let next_field = pair2.1
                rev_fields_opt = Some(Box::new(PatFieldList { head: next_field, tail: rev_fields_opt }))
            }
        }

        parser = parser.expect(TokenKind::RBrace)
        let span = parser.span_from(start)
        (parser, Pattern {
            kind: PatternKind::PatStruct,
            span: span,
            name: empty_name(),
            int_val: 0,
            path: path,
            sub_patterns: None,
            pat_fields: reverse_pat_field_list_opt(rev_fields_opt),
            is_mut: false,
        })
    }

    // ============================================================
    // Pattern field: name: pattern  OR  name (shorthand binding)
    // ============================================================

    fn parse_pat_field(self) -> (Parser, PatField) with Mut, IO, Panic, Div, Alloc {
        let name = self.current_name()
        var p = self.advance()  // skip field name

        if parser_peek(p) == TokenKind::Colon {
            p = p.advance()  // skip :
            let pair = p.parse_pattern()
            (pair.0, PatField { name: name, pattern: pair.1 })
        } else {
            // Shorthand: field name is also binding name
            let span = self.current_span()
            (p, PatField {
                name: name,
                pattern: Pattern {
                    kind: PatternKind::PatBinding,
                    span: span,
                    name: name,
                    int_val: 0,
                    path: empty_path(),
                    sub_patterns: None,
                    pat_fields: None,
                    is_mut: false,
                },
            })
        }
    }

    // ============================================================
    // Mutable binding: var x
    // ============================================================

    fn parse_mut_binding_pattern(self) -> (Parser, Pattern) with Mut, IO, Panic, Div {
        let start = self.current_span()
        var p = self.advance()  // skip var
        let name = p.current_name()
        let span = p.span_from(start)
        p = p.advance()
        (p, Pattern {
            kind: PatternKind::PatBinding,
            span: span,
            name: name,
            int_val: 0,
            path: empty_path(),
            sub_patterns: None,
            pat_fields: None,
            is_mut: true,
        })
    }

    // Bare `var` as a binding name (not mut-introducer). Source span of the
    // TokenKind::Var token yields name "var" via current_name().
    fn parse_var_as_ident_binding_pattern(self) -> (Parser, Pattern) with Mut, IO, Panic, Div {
        let start = self.current_span()
        let name = self.current_name()
        var p = self.advance()  // consume `var` as the binding name
        let span = p.span_from(start)
        (p, Pattern {
            kind: PatternKind::PatBinding,
            span: span,
            name: name,
            int_val: 0,
            path: empty_path(),
            sub_patterns: None,
            pat_fields: None,
            is_mut: false,
        })
    }
}

// ============================================================
// Linked-list helpers for pattern parsing
// ============================================================

fn reverse_pattern_list_opt(list: Option<Box<PatternList>>) -> Option<Box<PatternList>> with Mut, Alloc {
    reverse_pattern_list_loop(list, None)
}

fn reverse_pattern_list_loop(
    current: Option<Box<PatternList>>,
    acc: Option<Box<PatternList>>,
) -> Option<Box<PatternList>> with Mut, Alloc {
    match current {
        None => acc,
        Some(node) => {
            let next = (*node).tail
            let rev_node = PatternList { head: (*node).head, tail: acc }
            reverse_pattern_list_loop(next, Some(Box::new(rev_node)))
        },
    }
}

fn reverse_pat_field_list_opt(list: Option<Box<PatFieldList>>) -> Option<Box<PatFieldList>> with Mut, Alloc {
    reverse_pat_field_list_loop(list, None)
}

fn reverse_pat_field_list_loop(
    current: Option<Box<PatFieldList>>,
    acc: Option<Box<PatFieldList>>,
) -> Option<Box<PatFieldList>> with Mut, Alloc {
    match current {
        None => acc,
        Some(node) => {
            let next = (*node).tail
            let rev_node = PatFieldList { head: (*node).head, tail: acc }
            reverse_pat_field_list_loop(next, Some(Box::new(rev_node)))
        },
    }
}
