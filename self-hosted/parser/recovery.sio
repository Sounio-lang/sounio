// T19: Suggest deletion records RECV_ERR_EXTRA
fn recv_test_suggest_deletion() -> bool with IO, Mut, Panic, Div {
    var s = recv_state_new()
    var msg: [i8; 128] = [0; 128]
    s = recv_suggest_deletion(s, 3, 9, 55, msg, 0)
