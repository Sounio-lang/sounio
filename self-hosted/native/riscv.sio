// T13: LI for small immediate — should produce single addi
fn rv_test_li_small() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = rv_emit_li(buf, RV_A0, 42)
    // Should be one instruction: addi a0, x0, 42
    if !(buf.len == 4) { return false }
    let b0 = rv_byte_u8(buf.bytes[0])
    let b1 = rv_byte_u8(buf.bytes[1])
    let b2 = rv_byte_u8(buf.bytes[2])
    let b3 = rv_byte_u8(buf.bytes[3])
    let word = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
    // addi x10, x0, 42 = 0x02A00513
    if !(word == 0x02A00513) { return false }
    true
}

// T14: LI for large immediate — should produce lui + addi (2 instructions)
fn rv_test_li_large() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    // Load 0x12345000 into a0: lui a0, 0x12345; no addi needed (lower12=0)
    buf = rv_emit_li(buf, RV_A0, 0x12345000)
    // Should be lui only (lower 12 bits are 0)
    if !(buf.len == 4) { return false }
    true
}

