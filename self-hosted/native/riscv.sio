// T18: Prologue/epilogue round-trip emits correct instruction count
fn rv_test_prologue_epilogue() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = rv_emit_prologue(buf, 32)
    buf = rv_emit_epilogue(buf, 32)
    // Prologue: 4 instructions (addi sp, sd ra, sd s0, addi s0) = 16 bytes
    // Epilogue: 4 instructions (ld ra, ld s0, addi sp, ret) = 16 bytes
    if !(buf.len == 32) { return false }
    true
}

// ============================================================================
// Test runner
// ============================================================================

fn rv_test_main() -> i32 with IO, Mut, Panic, Div {
    var passed: i64 = 0
    let total: i64 = 18

    print("=== RISC-V RV64I Encoder Tests ===\n")

    if rv_test_add_encoding()    { passed = passed + 1; print("  T01 OK (ADD)\n")   } else { print("  FAIL: T01 ADD\n") }
    if rv_test_sub_encoding()    { passed = passed + 1; print("  T02 OK (SUB)\n")   } else { print("  FAIL: T02 SUB\n") }
    if rv_test_addi_encoding()   { passed = passed + 1; print("  T03 OK (ADDI)\n")  } else { print("  FAIL: T03 ADDI\n") }
    if rv_test_ld_encoding()     { passed = passed + 1; print("  T04 OK (LD)\n")    } else { print("  FAIL: T04 LD\n") }
    if rv_test_sd_encoding()     { passed = passed + 1; print("  T05 OK (SD)\n")    } else { print("  FAIL: T05 SD\n") }
    if rv_test_lui_encoding()    { passed = passed + 1; print("  T06 OK (LUI)\n")   } else { print("  FAIL: T06 LUI\n") }
    if rv_test_nop_encoding()    { passed = passed + 1; print("  T07 OK (NOP)\n")   } else { print("  FAIL: T07 NOP\n") }
    if rv_test_ret_encoding()    { passed = passed + 1; print("  T08 OK (RET)\n")   } else { print("  FAIL: T08 RET\n") }
    if rv_test_mv_encoding()     { passed = passed + 1; print("  T09 OK (MV)\n")    } else { print("  FAIL: T09 MV\n") }
    if rv_test_mul_encoding()    { passed = passed + 1; print("  T10 OK (MUL)\n")   } else { print("  FAIL: T10 MUL\n") }
    if rv_test_beq_encoding()    { passed = passed + 1; print("  T11 OK (BEQ)\n")   } else { print("  FAIL: T11 BEQ\n") }
    if rv_test_jal_encoding()    { passed = passed + 1; print("  T12 OK (JAL)\n")   } else { print("  FAIL: T12 JAL\n") }
    if rv_test_li_small()        { passed = passed + 1; print("  T13 OK (LI small)\n") } else { print("  FAIL: T13 LI small\n") }
    if rv_test_li_large()        { passed = passed + 1; print("  T14 OK (LI large)\n") } else { print("  FAIL: T14 LI large\n") }
    if rv_test_ecall_encoding()  { passed = passed + 1; print("  T15 OK (ECALL)\n") } else { print("  FAIL: T15 ECALL\n") }
    if rv_test_div_encoding()    { passed = passed + 1; print("  T16 OK (DIV)\n")   } else { print("  FAIL: T16 DIV\n") }
    if rv_test_sll_encoding()    { passed = passed + 1; print("  T17 OK (SLL)\n")   } else { print("  FAIL: T17 SLL\n") }
    if rv_test_prologue_epilogue() { passed = passed + 1; print("  T18 OK (prologue/epilogue)\n") } else { print("  FAIL: T18 prologue/epilogue\n") }

    print("\nRISC-V tests: ")
    print_int(passed)
    print("/")
    print_int(total)
    print(" passed\n")

    if passed == total { 0 } else { 1 }
}
