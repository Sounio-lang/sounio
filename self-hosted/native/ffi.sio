// ---------- T33: Callback find ----------
fn test_ffi_callback_find() -> bool with Mut, Panic, Div {
    var ctx = ffi_context_new()
    let cb1 = ffi_make_callback(10, 2, 0, FFI_CC_SYSV)
    let cb2 = ffi_make_callback(20, 3, 0, FFI_CC_SYSV)
    ctx = ffi_register_callback(ctx, cb1)
    ctx = ffi_register_callback(ctx, cb2)
    if ffi_find_callback(ctx, 20) != 1 { return false }
    if ffi_find_callback(ctx, 99) != (0 - 1) { return false }
