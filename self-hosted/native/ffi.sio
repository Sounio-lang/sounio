    ctx = ffi_register_callback(ctx, cb)
    if ctx.callback_count != 1 { return false }
    if ctx.callbacks[0 as usize].sounio_fn_idx != 5 { return false }
    if ctx.callbacks[0 as usize].param_count != 3 { return false }
