    if test_ffi_trampoline_size() { passed = passed + 1; print("  T38 OK (trampoline size)\n") } else { print("  FAIL: T38 trampoline size\n") }
    if test_ffi_struct_field_offset() { passed = passed + 1; print("  T39 OK (struct field offset)\n") } else { print("  FAIL: T39 struct field offset\n") }
    if test_ffi_struct_reg_count() { passed = passed + 1; print("  T40 OK (struct reg count)\n") } else { print("  FAIL: T40 struct reg count\n") }
    if test_ffi_type_compat() { passed = passed + 1; print("  T41 OK (type compat)\n") } else { print("  FAIL: T41 type compat\n") }
    if test_ffi_call_site_construct() { passed = passed + 1; print("  T42 OK (call site construct)\n") } else { print("  FAIL: T42 call site construct\n") }
    if test_ffi_count_stack_params() { passed = passed + 1; print("  T43 OK (count stack params)\n") } else { print("  FAIL: T43 count stack params\n") }
    if test_ffi_validate_all() { passed = passed + 1; print("  T44 OK (validate all)\n") } else { print("  FAIL: T44 validate all\n") }
    if test_ffi_validate_variadic_ok() { passed = passed + 1; print("  T45 OK (variadic OK)\n") } else { print("  FAIL: T45 variadic OK\n") }
    if test_ffi_validate_variadic_too_few() { passed = passed + 1; print("  T46 OK (variadic too few)\n") } else { print("  FAIL: T46 variadic too few\n") }
    if test_ffi_register_array_type() { passed = passed + 1; print("  T47 OK (array type)\n") } else { print("  FAIL: T47 array type\n") }
    if test_ffi_stack_arg_space() { passed = passed + 1; print("  T48 OK (stack arg space)\n") } else { print("  FAIL: T48 stack arg space\n") }
    if test_ffi_hash_name() { passed = passed + 1; print("  T49 OK (hash name)\n") } else { print("  FAIL: T49 hash name\n") }
    if test_ffi_context_queries() { passed = passed + 1; print("  T50 OK (context queries)\n") } else { print("  FAIL: T50 context queries\n") }

    print("\nFFI tests: ")
    print_int(passed)
    print("/")
    print_int(total)
    print(" passed\n")

    if passed == total { 0 } else { 1 }
}
