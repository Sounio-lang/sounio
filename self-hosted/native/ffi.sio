// Test runner
// ============================================================================

fn run_ffi_tests() -> i32 with IO, Mut, Panic, Div {
    var passed: i64 = 0
    let total: i64 = 50

    print("=== FFI Bridge Tests ===\n")

    if test_ffi_type_void_size() { passed = passed + 1; print("  T01 OK (type void size)\n") } else { print("  FAIL: T01 type void size\n") }
    if test_ffi_type_i32_size() { passed = passed + 1; print("  T02 OK (type i32 size)\n") } else { print("  FAIL: T02 type i32 size\n") }
    if test_ffi_type_f64_size() { passed = passed + 1; print("  T03 OK (type f64 size)\n") } else { print("  FAIL: T03 type f64 size\n") }
    if test_ffi_type_ptr_size() { passed = passed + 1; print("  T04 OK (type ptr size)\n") } else { print("  FAIL: T04 type ptr size\n") }
    if test_ffi_type_size_helper() { passed = passed + 1; print("  T05 OK (type size helper)\n") } else { print("  FAIL: T05 type size helper\n") }
    if test_ffi_type_align_helper() { passed = passed + 1; print("  T06 OK (type align helper)\n") } else { print("  FAIL: T06 type align helper\n") }
    if test_ffi_register_primitives() { passed = passed + 1; print("  T07 OK (register primitives)\n") } else { print("  FAIL: T07 register primitives\n") }
    if test_ffi_register_struct() { passed = passed + 1; print("  T08 OK (register struct)\n") } else { print("  FAIL: T08 register struct\n") }
    if test_ffi_register_decl() { passed = passed + 1; print("  T09 OK (register decl)\n") } else { print("  FAIL: T09 register decl\n") }
    if test_ffi_variadic_decl() { passed = passed + 1; print("  T10 OK (variadic decl)\n") } else { print("  FAIL: T10 variadic decl\n") }
    if test_ffi_find_decl() { passed = passed + 1; print("  T11 OK (find decl)\n") } else { print("  FAIL: T11 find decl\n") }
    if test_ffi_type_mapping() { passed = passed + 1; print("  T12 OK (type mapping)\n") } else { print("  FAIL: T12 type mapping\n") }
