// ---------- T34: Trampoline size calculation ----------
fn test_ffi_trampoline_size() -> bool {
    let cb0 = ffi_make_callback(0, 0, 0, FFI_CC_SYSV)
    let sz0 = ffi_trampoline_size(cb0)
    // 12 + 0*8 = 12, aligned to 16 => 16
    if sz0 != 16 { return false }

    let cb2 = ffi_make_callback(0, 2, 0, FFI_CC_SYSV)
    let sz2 = ffi_trampoline_size(cb2)
    // 12 + 2*8 = 28, aligned to 16 => 32
    if sz2 != 32 { return false }

    let cb4 = ffi_make_callback(0, 4, 0, FFI_CC_SYSV)
    let sz4 = ffi_trampoline_size(cb4)
    // 12 + 4*8 = 44, aligned to 16 => 48
    if sz4 != 48 { return false }
    true
}

// ---------- T35: Struct field offset calculation ----------
fn test_ffi_struct_field_offset() -> bool with Mut, Panic, Div {
    var ctx = ffi_context_new()
    ctx = ffi_register_primitives(ctx)
    // struct { i8(1), i32(3), i64(4) } -> index 8
    var fields: [i64; 16] = [0; 16]
    fields[0 as usize] = 1   // i8
    fields[1 as usize] = 3   // i32
    fields[2 as usize] = 4   // i64
    ctx = ffi_register_struct_type(ctx, fields, 3)

    // field 0 (i8): offset 0
    let off0 = ffi_struct_field_offset(ctx, 8, 0)
    if off0 != 0 { return false }
    // field 1 (i32): offset = align(0+1, 4) = 4
    let off1 = ffi_struct_field_offset(ctx, 8, 1)
    if off1 != 4 { return false }
    // field 2 (i64): offset = align(4+4, 8) = 8
    let off2 = ffi_struct_field_offset(ctx, 8, 2)
    if off2 != 8 { return false }
    true
}

// ---------- T36: Struct register count ----------
fn test_ffi_struct_reg_count() -> bool with Mut, Panic, Div {
    var ctx = ffi_context_new()
    ctx = ffi_register_primitives(ctx)
    // Small struct (8 bytes): { i32, i32 }
    var f1: [i64; 16] = [0; 16]
    f1[0 as usize] = 3
    f1[1 as usize] = 3
    ctx = ffi_register_struct_type(ctx, f1, 2)  // index 8, size 8
    let rc1 = ffi_struct_reg_count(ctx, 8)
    if rc1 != 1 { return false }

    // Medium struct (16 bytes): { i64, i64 }
    var f2: [i64; 16] = [0; 16]
    f2[0 as usize] = 4
    f2[1 as usize] = 4
    ctx = ffi_register_struct_type(ctx, f2, 2)  // index 9, size 16
    let rc2 = ffi_struct_reg_count(ctx, 9)
    if rc2 != 2 { return false }
    true
}

// ---------- T37: Type compatibility checking ----------
fn test_ffi_type_compat() -> bool with Mut, Panic, Div {
    var ctx = ffi_context_new()
    ctx = ffi_register_primitives(ctx)
    // i32 Sounio -> i32 C: OK
    if ffi_check_type_compat(FFI_SOUNIO_I32, 3, ctx) != FFI_SAFE_OK { return false }
    // f64 Sounio -> f64 C: OK
    if ffi_check_type_compat(FFI_SOUNIO_F64, 6, ctx) != FFI_SAFE_OK { return false }
    // i32 Sounio -> f64 C: mismatch
    if ffi_check_type_compat(FFI_SOUNIO_I32, 6, ctx) != FFI_SAFE_TYPE_MISMATCH { return false }
    // i32 C -> i64 Sounio: OK (widening)
    if ffi_check_type_compat(FFI_SOUNIO_I64, 3, ctx) != FFI_SAFE_OK { return false }
    true
}

// ---------- T38: Call site construction ----------
fn test_ffi_call_site_construct() -> bool with Mut, Panic, Div {
    var args: [i64; 16] = [0; 16]
    args[0 as usize] = 1
    args[1 as usize] = 2
    args[2 as usize] = 3
    let cs = ffi_make_call_site(7, args, 3, 99)
    if cs.decl_idx != 7 { return false }
    if cs.arg_count != 3 { return false }
    if cs.result_reg != 99 { return false }
    if cs.arg_regs[0 as usize] != 1 { return false }
    if cs.arg_regs[2 as usize] != 3 { return false }
    true
}

// ---------- T39: Stack param counting ----------
fn test_ffi_count_stack_params() -> bool with Mut, Panic, Div {
    var ctx = ffi_context_new()
    ctx = ffi_register_primitives(ctx)
    // 8 i64 params -> 6 in regs, 2 on stack
    var params: [i64; 16] = [0; 16]
    var i: i64 = 0
    while i < 8 {
        params[i as usize] = 4
        i = i + 1
    }
    let decl = ffi_make_decl(9000, params, 8, 0, FFI_CC_SYSV, 0)
    ctx = ffi_register_decl(ctx, decl)
    let assigns = ffi_assign_regs(ctx, 0)
    let on_stack = ffi_count_stack_params(assigns, 8)
    on_stack == 2
}

// ---------- T40: Validate all calls ----------
fn test_ffi_validate_all() -> bool with Mut, Panic, Div {
    var ctx = ffi_context_new()
    ctx = ffi_register_primitives(ctx)
    // Valid decl
    var params: [i64; 16] = [0; 16]
    params[0 as usize] = 3
    let decl = ffi_make_decl(8000, params, 1, 0, FFI_CC_SYSV, 0)
    ctx = ffi_register_decl(ctx, decl)
    // Two valid calls
    var args: [i64; 16] = [0; 16]
    let c1 = ffi_make_call_site(0, args, 1, 10)
    let c2 = ffi_make_call_site(0, args, 1, 11)
    ctx = ffi_register_call(ctx, c1)
    ctx = ffi_register_call(ctx, c2)
    let err_count = ffi_validate_all_calls(ctx)
    err_count == 0
}

// ---------- T41: Variadic call validation — enough fixed args ----------
fn test_ffi_validate_variadic_ok() -> bool with Mut, Panic, Div {
    var ctx = ffi_context_new()
    ctx = ffi_register_primitives(ctx)
    var params: [i64; 16] = [0; 16]
    params[0 as usize] = 7   // ptr
    let decl = ffi_make_variadic_decl(4444, params, 1, 3, FFI_CC_SYSV, 0)
    ctx = ffi_register_decl(ctx, decl)
    // Call with 3 args (>= 1 fixed) — valid
    var args: [i64; 16] = [0; 16]
    let call = ffi_make_call_site(0, args, 3, 10)
    ctx = ffi_register_call(ctx, call)
    let result = ffi_validate_call(ctx, 0)
    result == FFI_SAFE_OK
}

// ---------- T42: Variadic call validation — too few args ----------
fn test_ffi_validate_variadic_too_few() -> bool with Mut, Panic, Div {
    var ctx = ffi_context_new()
    ctx = ffi_register_primitives(ctx)
    var params: [i64; 16] = [0; 16]
    params[0 as usize] = 7
    params[1 as usize] = 3
    let decl = ffi_make_variadic_decl(5555, params, 2, 3, FFI_CC_SYSV, 0)
    ctx = ffi_register_decl(ctx, decl)
    // Call with 1 arg (< 2 fixed) — invalid
    var args: [i64; 16] = [0; 16]
    let call = ffi_make_call_site(0, args, 1, 10)
    ctx = ffi_register_call(ctx, call)
    let result = ffi_validate_call(ctx, 0)
    result == FFI_SAFE_PARAM_COUNT
}

// ---------- T43: Array type registration ----------
fn test_ffi_register_array_type() -> bool with Mut, Panic, Div {
    var ctx = ffi_context_new()
    ctx = ffi_register_primitives(ctx)
    // Array of 10 i32
    ctx = ffi_register_array_type(ctx, 3, 10)
    if ctx.type_count != 9 { return false }
    let aty = ctx.types[8 as usize]
    if aty.kind != FFI_TYPE_ARRAY { return false }
    if aty.size != 40 { return false }   // 10 * 4
    if aty.alignment != 4 { return false }
    if aty.field_count != 10 { return false }
    true
}

// ---------- T44: Stack argument space calculation ----------
fn test_ffi_stack_arg_space() -> bool with Mut, Panic, Div {
    var ctx = ffi_context_new()
    ctx = ffi_register_primitives(ctx)
    // 9 params -> 3 on stack = 24 bytes, aligned to 16 => 32
    var params: [i64; 16] = [0; 16]
    var i: i64 = 0
    while i < 9 {
        params[i as usize] = 4
        i = i + 1
    }
    let decl = ffi_make_decl(10000, params, 9, 0, FFI_CC_SYSV, 0)
    ctx = ffi_register_decl(ctx, decl)
    let assigns = ffi_assign_regs(ctx, 0)
    let space = ffi_stack_arg_space(assigns, 9)
    space == 32
}

// ---------- T45: Hash name function ----------
fn test_ffi_hash_name() -> bool with Mut, Panic {
    // "puts" = 112, 117, 116, 115
    let h1 = ffi_hash_name4(112, 117, 116, 115)
    let h2 = ffi_hash_name4(112, 117, 116, 115)
    if h1 != h2 { return false }
    // Different name should give different hash
    let h3 = ffi_hash_name4(109, 97, 108, 108)  // "mall"
    if h1 == h3 { return false }
    // Hash should be positive
    if h1 <= 0 { return false }
    true
}

// ---------- T46: Context queries ----------
fn test_ffi_context_queries() -> bool with Mut, Panic, Div {
    var ctx = ffi_context_new()
    if ffi_decl_count(ctx) != 0 { return false }
    if ffi_call_count(ctx) != 0 { return false }
    if ffi_marshal_count(ctx) != 0 { return false }
    if ffi_type_count(ctx) != 0 { return false }
    if ffi_lib_count(ctx) != 0 { return false }
    if ffi_callback_count(ctx) != 0 { return false }
    ctx = ffi_register_primitives(ctx)
    if ffi_type_count(ctx) != 8 { return false }
    true
}

// ---------- T47: Safety — unresolved symbol ----------
fn test_ffi_validate_unresolved() -> bool with Mut, Panic, Div {
    var ctx = ffi_context_new()
    ctx = ffi_register_primitives(ctx)
    var params: [i64; 16] = [0; 16]
    // lib_name_hash != 0 but no library registered
    let decl = ffi_make_decl(6666, params, 0, 0, FFI_CC_SYSV, 999)
    ctx = ffi_register_decl(ctx, decl)
    var args: [i64; 16] = [0; 16]
    let call = ffi_make_call_site(0, args, 0, 10)
    ctx = ffi_register_call(ctx, call)
    let result = ffi_validate_call(ctx, 0)
    result == FFI_SAFE_UNRESOLVED_SYM
}

// ---------- T48: AAPCS register assignment ----------
fn test_ffi_aapcs_regs() -> bool with Mut, Panic, Div {
    var ctx = ffi_context_new()
    ctx = ffi_register_primitives(ctx)
    var params: [i64; 16] = [0; 16]
    var i: i64 = 0
    while i < 10 {
        params[i as usize] = 4
        i = i + 1
    }
    let decl = ffi_make_decl(11000, params, 10, 0, FFI_CC_AAPCS, 0)
    ctx = ffi_register_decl(ctx, decl)
    let assigns = ffi_assign_regs(ctx, 0)
    // First 8 in x0..x7
    if assigns[0 as usize].reg != 0 { return false }
    if assigns[7 as usize].reg != 7 { return false }
    // Param 8 on stack
    if assigns[8 as usize].reg != FFI_REG_NONE { return false }
    if assigns[8 as usize].stack_offset != 0 { return false }
    // Param 9 on stack at offset 8
    if assigns[9 as usize].reg != FFI_REG_NONE { return false }
    if assigns[9 as usize].stack_offset != 8 { return false }
    true
}

// ---------- T49: Align-up helper ----------
fn test_ffi_align_up() -> bool with Mut, Panic {
    if ffi_align_up(0, 16) != 0 { return false }
    if ffi_align_up(1, 16) != 16 { return false }
    if ffi_align_up(15, 16) != 16 { return false }
    if ffi_align_up(16, 16) != 16 { return false }
    if ffi_align_up(17, 16) != 32 { return false }
    if ffi_align_up(7, 8) != 8 { return false }
    if ffi_align_up(8, 8) != 8 { return false }
    true
}

// ---------- T50: Sounio type C size ----------
fn test_ffi_sounio_type_c_size() -> bool {
    if ffi_sounio_type_c_size(FFI_SOUNIO_I32) != 4 { return false }
    if ffi_sounio_type_c_size(FFI_SOUNIO_I64) != 8 { return false }
    if ffi_sounio_type_c_size(FFI_SOUNIO_F64) != 8 { return false }
    if ffi_sounio_type_c_size(FFI_SOUNIO_BOOL) != 1 { return false }
    if ffi_sounio_type_c_size(FFI_SOUNIO_PTR) != 8 { return false }
    if ffi_sounio_type_c_size(FFI_SOUNIO_VOID) != 0 { return false }
    true
}

