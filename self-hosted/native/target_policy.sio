// self-hosted::native::target_policy — Shared target register policy contract
//
// This module is the single source of truth for reserved, allocatable, scratch,
// argument, return, and allocation-order policy across the active native backend
// and the native-v2 preview contract.

module native::target_policy

pub struct NativeTargetPolicy {
    pub arch_id: i64,
    pub os_id: i64,
    pub reserved_count: i64,
    pub allocatable_count: i64,
    pub allocation_order_count: i64,
    pub scratch_count: i64,
    pub arg_count: i64,
    pub ret_count: i64,
    pub frame_has_gc_area: bool,
    pub frame_has_deopt_area: bool,
    pub frame_has_unwind: bool,
    pub frame_has_vector_align: bool,
    pub emitter_ready: bool,
}

pub fn native_policy_arch_unknown() -> i64 { 0 }
pub fn native_policy_arch_x86_64() -> i64 { 1 }
pub fn native_policy_arch_aarch64() -> i64 { 2 }
pub fn native_policy_arch_riscv64() -> i64 { 3 }

pub fn native_policy_os_unknown() -> i64 { 0 }
pub fn native_policy_os_linux() -> i64 { 1 }
pub fn native_policy_os_macos() -> i64 { 2 }
pub fn native_policy_os_windows() -> i64 { 3 }

pub fn native_policy_group_reserved() -> i64 { 0 }
pub fn native_policy_group_allocatable() -> i64 { 1 }
pub fn native_policy_group_allocation_order() -> i64 { 2 }
pub fn native_policy_group_scratch() -> i64 { 3 }
pub fn native_policy_group_args() -> i64 { 4 }
pub fn native_policy_group_returns() -> i64 { 5 }

pub fn native_target_policy_empty() -> NativeTargetPolicy {
    NativeTargetPolicy {
        arch_id: native_policy_arch_unknown(),
        os_id: native_policy_os_unknown(),
        reserved_count: 0,
        allocatable_count: 0,
        allocation_order_count: 0,
        scratch_count: 0,
        arg_count: 0,
        ret_count: 0,
        frame_has_gc_area: true,
        frame_has_deopt_area: true,
        frame_has_unwind: true,
        frame_has_vector_align: true,
        emitter_ready: false,
    }
}

pub fn native_target_policy_x86_64_linux() -> NativeTargetPolicy {
    NativeTargetPolicy {
        arch_id: native_policy_arch_x86_64(),
        os_id: native_policy_os_linux(),
        reserved_count: 3,
        allocatable_count: 4,
        allocation_order_count: 4,
        scratch_count: 5,
        arg_count: 6,
        ret_count: 1,
        frame_has_gc_area: true,
        frame_has_deopt_area: true,
        frame_has_unwind: true,
        frame_has_vector_align: true,
        emitter_ready: true,
    }
}

pub fn native_target_policy_x86_64_macos() -> NativeTargetPolicy {
    NativeTargetPolicy {
        arch_id: native_policy_arch_x86_64(),
        os_id: native_policy_os_macos(),
        reserved_count: 3,
        allocatable_count: 4,
        allocation_order_count: 4,
        scratch_count: 5,
        arg_count: 6,
        ret_count: 1,
        frame_has_gc_area: true,
        frame_has_deopt_area: true,
        frame_has_unwind: true,
        frame_has_vector_align: true,
        emitter_ready: true,
    }
}

pub fn native_target_policy_aarch64_macos() -> NativeTargetPolicy {
    NativeTargetPolicy {
        arch_id: native_policy_arch_aarch64(),
        os_id: native_policy_os_macos(),
        reserved_count: 4,
        allocatable_count: 10,
        allocation_order_count: 10,
        scratch_count: 7,
        arg_count: 8,
        ret_count: 1,
        frame_has_gc_area: true,
        frame_has_deopt_area: true,
        frame_has_unwind: true,
        frame_has_vector_align: true,
        emitter_ready: true,
    }
}

pub fn native_target_policy_aarch64_linux() -> NativeTargetPolicy {
    NativeTargetPolicy {
        arch_id: native_policy_arch_aarch64(),
        os_id: native_policy_os_linux(),
        reserved_count: 4,
        allocatable_count: 10,
        allocation_order_count: 10,
        scratch_count: 7,
        arg_count: 8,
        ret_count: 1,
        frame_has_gc_area: true,
        frame_has_deopt_area: true,
        frame_has_unwind: true,
        frame_has_vector_align: true,
        emitter_ready: true,
    }
}

pub fn native_target_policy_x86_64_windows() -> NativeTargetPolicy {
    // Internal calling convention is System V (same as Linux/macOS).
    // Win64 ABI translation happens only at FFI boundary (see ffi.sio, abi_lower.sio).
    NativeTargetPolicy {
        arch_id: native_policy_arch_x86_64(),
        os_id: native_policy_os_windows(),
        reserved_count: 3,
        allocatable_count: 4,
        allocation_order_count: 4,
        scratch_count: 5,
        arg_count: 6,
        ret_count: 1,
        frame_has_gc_area: true,
        frame_has_deopt_area: true,
        frame_has_unwind: true,
        frame_has_vector_align: true,
        emitter_ready: true,
    }
}

pub fn native_target_policy_aarch64_windows() -> NativeTargetPolicy {
    NativeTargetPolicy {
        arch_id: native_policy_arch_aarch64(),
        os_id: native_policy_os_windows(),
        reserved_count: 4,
        allocatable_count: 10,
        allocation_order_count: 10,
        scratch_count: 7,
        arg_count: 8,
        ret_count: 1,
        frame_has_gc_area: true,
        frame_has_deopt_area: true,
        frame_has_unwind: true,
        frame_has_vector_align: true,
        emitter_ready: true,
    }
}

pub fn native_target_policy_for(arch_id: i64, os_id: i64) -> NativeTargetPolicy {
    if arch_id == native_policy_arch_x86_64() && os_id == native_policy_os_linux() {
        return native_target_policy_x86_64_linux()
    }
    if arch_id == native_policy_arch_x86_64() && os_id == native_policy_os_macos() {
        return native_target_policy_x86_64_macos()
    }
    if arch_id == native_policy_arch_aarch64() && os_id == native_policy_os_linux() {
        return native_target_policy_aarch64_linux()
    }
    if arch_id == native_policy_arch_aarch64() && os_id == native_policy_os_macos() {
        return native_target_policy_aarch64_macos()
    }
    if arch_id == native_policy_arch_x86_64() && os_id == native_policy_os_windows() {
        return native_target_policy_x86_64_windows()
    }
    if arch_id == native_policy_arch_aarch64() && os_id == native_policy_os_windows() {
        return native_target_policy_aarch64_windows()
    }
    native_target_policy_empty()
}

// Soft-keyword: Madaros parser rejects param name `policy`.
pub fn native_target_policy_group_count(tgt_policy: NativeTargetPolicy, group: i64) -> i64 {
    if group == native_policy_group_reserved() { return tgt_policy.reserved_count }
    if group == native_policy_group_allocatable() { return tgt_policy.allocatable_count }
    if group == native_policy_group_allocation_order() { return tgt_policy.allocation_order_count }
    if group == native_policy_group_scratch() { return tgt_policy.scratch_count }
    if group == native_policy_group_args() { return tgt_policy.arg_count }
    if group == native_policy_group_returns() { return tgt_policy.ret_count }
    0
}

pub fn native_target_policy_group_name(tgt_policy: NativeTargetPolicy, group: i64, idx: i64) -> string {
    if tgt_policy.arch_id == native_policy_arch_x86_64() &&
       (tgt_policy.os_id == native_policy_os_linux() || tgt_policy.os_id == native_policy_os_macos() || tgt_policy.os_id == native_policy_os_windows()) {
        if group == native_policy_group_reserved() {
            if idx == 0 { return "rsp" }
            if idx == 1 { return "rbp" }
            if idx == 2 { return "rbx" }
        }
        if group == native_policy_group_allocatable() {
            if idx == 0 { return "r12" }
            if idx == 1 { return "r13" }
            if idx == 2 { return "r14" }
            if idx == 3 { return "r15" }
        }
        if group == native_policy_group_allocation_order() {
            if idx == 0 { return "r15" }
            if idx == 1 { return "r14" }
            if idx == 2 { return "r13" }
            if idx == 3 { return "r12" }
        }
        if group == native_policy_group_scratch() {
            if idx == 0 { return "rax" }
            if idx == 1 { return "rcx" }
            if idx == 2 { return "rdx" }
            if idx == 3 { return "r10" }
            if idx == 4 { return "r11" }
        }
        if group == native_policy_group_args() {
            if idx == 0 { return "rdi" }
            if idx == 1 { return "rsi" }
            if idx == 2 { return "rdx" }
            if idx == 3 { return "rcx" }
            if idx == 4 { return "r8" }
            if idx == 5 { return "r9" }
        }
        if group == native_policy_group_returns() {
            if idx == 0 { return "rax" }
        }
    }
    if tgt_policy.arch_id == native_policy_arch_aarch64() &&
       (tgt_policy.os_id == native_policy_os_macos() || tgt_policy.os_id == native_policy_os_linux() || tgt_policy.os_id == native_policy_os_windows()) {
        if group == native_policy_group_reserved() {
            if idx == 0 { return "sp" }
            if idx == 1 { return "fp" }
            if idx == 2 { return "lr" }
            if idx == 3 { return "x18" }
        }
        if group == native_policy_group_allocatable() {
            if idx == 0 { return "x19" }
            if idx == 1 { return "x20" }
            if idx == 2 { return "x21" }
            if idx == 3 { return "x22" }
            if idx == 4 { return "x23" }
            if idx == 5 { return "x24" }
            if idx == 6 { return "x25" }
            if idx == 7 { return "x26" }
            if idx == 8 { return "x27" }
            if idx == 9 { return "x28" }
        }
        if group == native_policy_group_allocation_order() {
            if idx == 0 { return "x28" }
            if idx == 1 { return "x27" }
            if idx == 2 { return "x26" }
            if idx == 3 { return "x25" }
            if idx == 4 { return "x24" }
            if idx == 5 { return "x23" }
            if idx == 6 { return "x22" }
            if idx == 7 { return "x21" }
            if idx == 8 { return "x20" }
            if idx == 9 { return "x19" }
        }
        if group == native_policy_group_scratch() {
            if idx == 0 { return "x9" }
            if idx == 1 { return "x10" }
            if idx == 2 { return "x11" }
            if idx == 3 { return "x12" }
            if idx == 4 { return "x13" }
            if idx == 5 { return "x14" }
            if idx == 6 { return "x15" }
        }
        if group == native_policy_group_args() {
            if idx == 0 { return "x0" }
            if idx == 1 { return "x1" }
            if idx == 2 { return "x2" }
            if idx == 3 { return "x3" }
            if idx == 4 { return "x4" }
            if idx == 5 { return "x5" }
            if idx == 6 { return "x6" }
            if idx == 7 { return "x7" }
        }
        if group == native_policy_group_returns() {
            if idx == 0 { return "x0" }
        }
    }
    "unknown"
}

pub fn native_target_policy_x86_allocation_order_count() -> i64 {
    native_target_policy_group_count(native_target_policy_x86_64_linux(), native_policy_group_allocation_order())
}

pub fn native_target_policy_x86_allocation_order_reg_id(idx: i64) -> i64 {
    if idx == 0 { return 15 }
    if idx == 1 { return 14 }
    if idx == 2 { return 13 }
    if idx == 3 { return 12 }
    -1
}

pub fn native_target_policy_x86_allocatable_mask_for_reg(reg: i64) -> i64 {
    if reg == 12 { return 1 }
    if reg == 13 { return 2 }
    if reg == 14 { return 4 }
    if reg == 15 { return 8 }
    0
}

pub struct MicroarchLatency {
    pub load_cycles: i64,
    pub store_cycles: i64,
    pub int_add_cycles: i64,
    pub int_mul_cycles: i64,
    pub fp_add_cycles: i64,
    pub fp_mul_cycles: i64,
    pub call_cycles: i64,
}

pub fn skylake_microarch_latency() -> MicroarchLatency {
    MicroarchLatency {
        load_cycles: 4,
        store_cycles: 1,
        int_add_cycles: 1,
        int_mul_cycles: 3,
        fp_add_cycles: 4,
        fp_mul_cycles: 5,
        call_cycles: 5,
    }
}

// ============================================================================
// Epistemic latency model
//
// Each op's cost is a distribution, not a point estimate.  variance is in
// cycles² (independent variances add along a chain).  This is what the
// scheduler needs to (a) propagate uncertainty through critical-path priority
// computation, (b) make schedule choices based on upper quantile of makespan
// rather than the mean, and (c) gate emission on a per-function confidence
// budget.
//
// All variances here are integer cycles² — the scheduler uses isqrt to recover
// sigma when forming the upper-quantile priority.
//
// Variance budget rationale (Skylake reference):
//   load     : L1=4, L2=12, L3=40, mem≈200.  Even with a perfect predictor,
//              the realised latency depends on the access pattern → big sigma.
//   store    : pipelined; minimal jitter.
//   int_add  : extremely stable.
//   int_mul  : stable (no division).
//   fp_add   : depends on SSE2 vs AVX2 vs AVX-512; ±1 cycle envelope.
//   fp_mul   : same envelope.
//   call     : branch prediction + I$ miss exposure; ±10 cycle envelope.
//
// "cross" profile = the envelope across Skylake / Sunny-Cove / Zen 4.  Used
// when the compiler is asked to schedule for "x86_64 in general" without
// pinning a specific µarch.
// ============================================================================

pub struct LatencyDist {
    pub mean: i64,        // cycles
    pub variance: i64,    // cycles² — independent variances add along a chain
}

pub fn latency_dist(mean: i64, variance: i64) -> LatencyDist {
    LatencyDist { mean: mean, variance: variance }
}

pub fn latency_certain(cycles: i64) -> LatencyDist {
    LatencyDist { mean: cycles, variance: 0 }
}

// Convenience: variance from a sigma in cycles (cleaner reading than squaring).
pub fn latency_from_sigma(mean: i64, sigma: i64) -> LatencyDist {
    LatencyDist { mean: mean, variance: sigma * sigma }
}

pub struct MicroarchLatencyEpistemic {
    pub load_cycles: LatencyDist,
    pub store_cycles: LatencyDist,
    pub int_add_cycles: LatencyDist,
    pub int_mul_cycles: LatencyDist,
    pub fp_add_cycles: LatencyDist,
    pub fp_mul_cycles: LatencyDist,
    pub call_cycles: LatencyDist,
}

pub fn skylake_microarch_epistemic() -> MicroarchLatencyEpistemic {
    MicroarchLatencyEpistemic {
        load_cycles:    latency_from_sigma(4, 8),    // L1 hit ± cache-tail dispersion
        store_cycles:   latency_from_sigma(1, 1),
        int_add_cycles: latency_certain(1),
        int_mul_cycles: latency_certain(3),
        fp_add_cycles:  latency_from_sigma(4, 1),    // SSE2/AVX2 envelope
        fp_mul_cycles:  latency_from_sigma(5, 1),
        call_cycles:    latency_from_sigma(5, 10),   // branch predictor / I$ jitter
    }
}

pub fn sunny_cove_microarch_epistemic() -> MicroarchLatencyEpistemic {
    MicroarchLatencyEpistemic {
        load_cycles:    latency_from_sigma(5, 9),    // 5-cycle L1 vs Skylake's 4
        store_cycles:   latency_from_sigma(1, 1),
        int_add_cycles: latency_certain(1),
        int_mul_cycles: latency_certain(3),
        fp_add_cycles:  latency_from_sigma(4, 1),
        fp_mul_cycles:  latency_from_sigma(4, 1),    // 4 (vs Skylake 5)
        call_cycles:    latency_from_sigma(5, 10),
    }
}

pub fn zen4_microarch_epistemic() -> MicroarchLatencyEpistemic {
    MicroarchLatencyEpistemic {
        load_cycles:    latency_from_sigma(4, 9),
        store_cycles:   latency_from_sigma(1, 1),
        int_add_cycles: latency_certain(1),
        int_mul_cycles: latency_certain(3),
        fp_add_cycles:  latency_from_sigma(3, 1),    // Zen4 FADD = 3
        fp_mul_cycles:  latency_from_sigma(3, 1),
        call_cycles:    latency_from_sigma(5, 12),
    }
}

// Cross-µarch envelope: when the compiler must produce code that works
// across Skylake / Sunny Cove / Zen 4, every op's variance widens to cover
// the spread.  Schedule chosen under this profile is the most conservative.
pub fn cross_microarch_epistemic() -> MicroarchLatencyEpistemic {
    MicroarchLatencyEpistemic {
        load_cycles:    latency_from_sigma(4, 10),
        store_cycles:   latency_from_sigma(1, 2),
        int_add_cycles: latency_from_sigma(1, 1),
        int_mul_cycles: latency_from_sigma(3, 2),
        fp_add_cycles:  latency_from_sigma(4, 2),
        fp_mul_cycles:  latency_from_sigma(4, 2),
        call_cycles:    latency_from_sigma(5, 15),
    }
}
