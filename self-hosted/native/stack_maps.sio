// self-hosted::native::stack_maps — Runtime metadata decoding for native-v2
//
// Decodes the stack-map blob emitted into .data so self-tests and runtime
// substrate code can reason about concrete safepoint records instead of raw bytes.

module native::stack_maps

use native::elf::{StringTable}

fn native_v2_stack_map_version() -> i64 { 2 }
fn native_v2_stack_map_record_size() -> i64 { 112 }
fn native_v2_stack_map_root_kind_mixed() -> i64 { 0 }
fn native_v2_stack_map_root_kind_handles_only() -> i64 { 1 }
fn native_v2_stack_map_tier_baseline() -> i64 { 0 }
fn native_v2_stack_map_osr_ineligible() -> i64 { 0 }
fn native_v2_stack_map_osr_eligible() -> i64 { 1 }

struct NativeV2StackMapRecord {
    fn_index: i64,
    kind: i64,
    machine_instr_index: i64,
    code_offset: i64,
    frame_size: i64,
    temp_count: i64,
    spill_count: i64,
    root_temp_count: i64,
    root_spill_count: i64,
    callee_saved_root_mask: i64,
    root_kind_mask: i64,
    deopt_id: i64,
    tier_id: i64,
    osr_eligible: i64,
}

struct NativeV2StackMapBlob {
    valid: bool,
    version: i64,
    record_count: i64,
    safepoint_count: i64,
    deopt_point_count: i64,
    records: [NativeV2StackMapRecord; 256],
}

fn native_v2_stack_map_record_empty() -> NativeV2StackMapRecord {
    NativeV2StackMapRecord {
        fn_index: 0,
        kind: 0,
        machine_instr_index: 0,
        code_offset: 0,
        frame_size: 0,
        temp_count: 0,
        spill_count: 0,
        root_temp_count: 0,
        root_spill_count: 0,
        callee_saved_root_mask: 0,
        root_kind_mask: 0,
        deopt_id: 0,
        tier_id: 0,
        osr_eligible: 0,
    }
}

fn native_v2_stack_map_blob_empty() -> NativeV2StackMapBlob {
    NativeV2StackMapBlob {
        valid: false,
        version: 0,
        record_count: 0,
        safepoint_count: 0,
        deopt_point_count: 0,
        records: [native_v2_stack_map_record_empty(); 256],
    }
}

fn native_v2_data_byte(st: StringTable, idx: i64) -> i64 with Panic {
    if idx < 0 || idx >= st.len {
        return 0
    }
    let raw = st.bytes[idx as usize] as i64
    if raw < 0 { raw + 256 } else { raw }
}

fn native_v2_data_read_u64(st: StringTable, offset: i64) -> i64 with Mut, Panic, Div {
    if offset < 0 || (offset + 7) >= st.len {
        return 0
    }
    var out: i64 = 0
    var i: i64 = 0
    while i < 8 {
        out = out | (native_v2_data_byte(st, offset + i) << (i * 8))
        i = i + 1
    }
    out
}

fn native_v2_stack_map_blob_decode(data: StringTable, offset: i64) -> NativeV2StackMapBlob with Mut, Panic, Div {
    var blob = native_v2_stack_map_blob_empty()
    if offset < 0 || (offset + 23) >= data.len {
        return blob
    }

    blob.version = native_v2_data_read_u64(data, offset)
    blob.record_count = native_v2_data_read_u64(data, offset + 8)
    blob.safepoint_count = native_v2_data_read_u64(data, offset + 16)
    blob.deopt_point_count = native_v2_data_read_u64(data, offset + 24)

    var cursor = offset + 32
    var i: i64 = 0
    while i < blob.record_count && i < 256 && (cursor + native_v2_stack_map_record_size() - 1) < data.len {
        var record = native_v2_stack_map_record_empty()
        record.fn_index = native_v2_data_read_u64(data, cursor)
        record.kind = native_v2_data_read_u64(data, cursor + 8)
        record.machine_instr_index = native_v2_data_read_u64(data, cursor + 16)
        record.code_offset = native_v2_data_read_u64(data, cursor + 24)
        record.frame_size = native_v2_data_read_u64(data, cursor + 32)
        record.temp_count = native_v2_data_read_u64(data, cursor + 40)
        record.spill_count = native_v2_data_read_u64(data, cursor + 48)
        record.root_temp_count = native_v2_data_read_u64(data, cursor + 56)
        record.root_spill_count = native_v2_data_read_u64(data, cursor + 64)
        record.callee_saved_root_mask = native_v2_data_read_u64(data, cursor + 72)
        record.root_kind_mask = native_v2_data_read_u64(data, cursor + 80)
        record.deopt_id = native_v2_data_read_u64(data, cursor + 88)
        record.tier_id = native_v2_data_read_u64(data, cursor + 96)
        record.osr_eligible = native_v2_data_read_u64(data, cursor + 104)
        blob.records[i as usize] = record
        cursor = cursor + native_v2_stack_map_record_size()
        i = i + 1
    }

    blob.valid = blob.version == native_v2_stack_map_version() && blob.record_count >= 0 && blob.safepoint_count >= 0 && blob.deopt_point_count >= 0
    blob
}
