// Off-default target data-layout authority shadow.
//
// Semantic-Lane-ID: SOUNIO-TARGET-DATA-LAYOUT-AUTHORITY-SHADOW
// Claims-Allowed: generational target identity, closed registered profiles,
// target policy lookup, and fail-closed wide-float ABI availability.
// Claims-Forbidden: field layout, Place binding, complete ABI lowering,
// backend integration, or compiler-wide target selection.

module native::target_data_layout_registry_shadow

use native::target_policy::*

pub fn target_data_layout_registry_shadow_capacity() -> i64 { 2 }

pub let TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK: i64 = 0
pub let TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_INVALID_STORE: i64 = -60
pub let TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_INVALID_ID: i64 = -61
pub let TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_STALE_ID: i64 = -62
pub let TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_CAPACITY: i64 = -63
pub let TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_OUTPUT_NOT_CLEAR: i64 = -64
pub let TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_UNSUPPORTED_PROFILE: i64 = -65
pub let TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_DUPLICATE_PROFILE: i64 = -66
pub let TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_UNREGISTERED_POLICY: i64 = -67
pub let TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_WIDE_FLOAT_UNSUPPORTED: i64 = -68
pub let TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_STORE_ALREADY_INITIALIZED: i64 = -69
pub let TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_STORE_IDENTITY_EXHAUSTED: i64 = -70

// Profiles are closed compiler policy identities, never caller-derived tokens.
// Arch and OS members reuse native::target_policy's public authority.
pub fn target_data_layout_profile_x86_64_linux_sysv_v1() -> i64 { 1 }
pub fn target_data_layout_profile_x86_64_macos_darwin_v1() -> i64 { 2 }
pub fn target_data_layout_profile_aarch64_linux_aapcs64_v1() -> i64 { 3 }

pub fn target_os_abi_sysv_amd64_v1() -> i64 { 1 }
pub fn target_os_abi_darwin_amd64_v1() -> i64 { 2 }
pub fn target_os_abi_aapcs64_elf_v1() -> i64 { 3 }

pub fn target_endian_little_v1() -> i64 { 1 }
pub fn target_scalar_alignment_natural_cap_16_v1() -> i64 { 1 }
pub fn target_vector_alignment_baseline_16_v1() -> i64 { 1 }

// No current registered profile declares a physical f128/f256 ABI. A future
// policy must be registered as a new closed profile before it can be observed.
pub fn target_wide_float_abi_undeclared() -> i64 { 0 }

pub fn target_managed_object_layout_v1() -> i64 { 1 }
pub fn target_layout_algorithm_v1() -> i64 { 1 }

let TARGET_DATA_LAYOUT_SLOT_FREE: i64 = 0
let TARGET_DATA_LAYOUT_SLOT_LIVE: i64 = 1
let TARGET_DATA_LAYOUT_SLOT_RELEASED: i64 = 2

pub struct TargetDataLayoutId {
    store_identity: i64,
    slot: i64,
    generation: i64,
}

var TARGET_DATA_LAYOUT_STORE_IDENTITY: i64 = 0
var TARGET_DATA_LAYOUT_LIVE_COUNT: i64 = 0

var TARGET_DATA_LAYOUT_STATE_0: i64 = TARGET_DATA_LAYOUT_SLOT_FREE
var TARGET_DATA_LAYOUT_STATE_1: i64 = TARGET_DATA_LAYOUT_SLOT_FREE
var TARGET_DATA_LAYOUT_GENERATION_0: i64 = 1
var TARGET_DATA_LAYOUT_GENERATION_1: i64 = 1

// Private scalar columns are the executable store. No aggregate or caller-
// supplied target policy crosses the registry boundary.
var TARGET_DATA_LAYOUT_PROFILE_0: i64 = 0
var TARGET_DATA_LAYOUT_PROFILE_1: i64 = 0
var TARGET_DATA_LAYOUT_ARCH_0: i64 = 0
var TARGET_DATA_LAYOUT_ARCH_1: i64 = 0
var TARGET_DATA_LAYOUT_OS_0: i64 = 0
var TARGET_DATA_LAYOUT_OS_1: i64 = 0
var TARGET_DATA_LAYOUT_OS_ABI_0: i64 = 0
var TARGET_DATA_LAYOUT_OS_ABI_1: i64 = 0
var TARGET_DATA_LAYOUT_ENDIAN_0: i64 = 0
var TARGET_DATA_LAYOUT_ENDIAN_1: i64 = 0
var TARGET_DATA_LAYOUT_POINTER_SIZE_0: i64 = 0
var TARGET_DATA_LAYOUT_POINTER_SIZE_1: i64 = 0
var TARGET_DATA_LAYOUT_POINTER_ALIGNMENT_0: i64 = 0
var TARGET_DATA_LAYOUT_POINTER_ALIGNMENT_1: i64 = 0
var TARGET_DATA_LAYOUT_SCALAR_ALIGNMENT_POLICY_0: i64 = 0
var TARGET_DATA_LAYOUT_SCALAR_ALIGNMENT_POLICY_1: i64 = 0
var TARGET_DATA_LAYOUT_VECTOR_ALIGNMENT_POLICY_0: i64 = 0
var TARGET_DATA_LAYOUT_VECTOR_ALIGNMENT_POLICY_1: i64 = 0
var TARGET_DATA_LAYOUT_WIDE_FLOAT_ABI_POLICY_0: i64 = 0
var TARGET_DATA_LAYOUT_WIDE_FLOAT_ABI_POLICY_1: i64 = 0
var TARGET_DATA_LAYOUT_MANAGED_OBJECT_LAYOUT_VERSION_0: i64 = 0
var TARGET_DATA_LAYOUT_MANAGED_OBJECT_LAYOUT_VERSION_1: i64 = 0
var TARGET_DATA_LAYOUT_ALGORITHM_VERSION_0: i64 = 0
var TARGET_DATA_LAYOUT_ALGORITHM_VERSION_1: i64 = 0

pub fn target_data_layout_registry_shadow_invalid_id() -> TargetDataLayoutId {
    TargetDataLayoutId { store_identity: 0, slot: -1, generation: 0 }
}

pub fn target_data_layout_registry_shadow_id_store_identity(id: &TargetDataLayoutId) -> i64 {
    (*id).store_identity
}

pub fn target_data_layout_registry_shadow_id_slot(id: &TargetDataLayoutId) -> i64 {
    (*id).slot
}

pub fn target_data_layout_registry_shadow_id_generation(id: &TargetDataLayoutId) -> i64 {
    (*id).generation
}

pub fn target_data_layout_registry_shadow_clear_id(out: &! TargetDataLayoutId) with Mut {
    (*out).store_identity = 0
    (*out).slot = -1
    (*out).generation = 0
}

fn target_data_layout_id_is_clear(id: &TargetDataLayoutId) -> bool {
    (*id).store_identity == 0 && (*id).slot == -1 && (*id).generation == 0
}

fn target_data_layout_state(slot: i64) -> i64 {
    if slot == 0 { TARGET_DATA_LAYOUT_STATE_0 } else { TARGET_DATA_LAYOUT_STATE_1 }
}

fn target_data_layout_generation(slot: i64) -> i64 {
    if slot == 0 { TARGET_DATA_LAYOUT_GENERATION_0 } else { TARGET_DATA_LAYOUT_GENERATION_1 }
}

fn target_data_layout_profile(slot: i64) -> i64 {
    if slot == 0 { TARGET_DATA_LAYOUT_PROFILE_0 } else { TARGET_DATA_LAYOUT_PROFILE_1 }
}

fn target_data_layout_arch(slot: i64) -> i64 {
    if slot == 0 { TARGET_DATA_LAYOUT_ARCH_0 } else { TARGET_DATA_LAYOUT_ARCH_1 }
}

fn target_data_layout_os(slot: i64) -> i64 {
    if slot == 0 { TARGET_DATA_LAYOUT_OS_0 } else { TARGET_DATA_LAYOUT_OS_1 }
}

fn target_data_layout_os_abi(slot: i64) -> i64 {
    if slot == 0 { TARGET_DATA_LAYOUT_OS_ABI_0 } else { TARGET_DATA_LAYOUT_OS_ABI_1 }
}

fn target_data_layout_endian(slot: i64) -> i64 {
    if slot == 0 { TARGET_DATA_LAYOUT_ENDIAN_0 } else { TARGET_DATA_LAYOUT_ENDIAN_1 }
}

fn target_data_layout_pointer_size(slot: i64) -> i64 {
    if slot == 0 { TARGET_DATA_LAYOUT_POINTER_SIZE_0 } else { TARGET_DATA_LAYOUT_POINTER_SIZE_1 }
}

fn target_data_layout_pointer_alignment(slot: i64) -> i64 {
    if slot == 0 { TARGET_DATA_LAYOUT_POINTER_ALIGNMENT_0 } else { TARGET_DATA_LAYOUT_POINTER_ALIGNMENT_1 }
}

fn target_data_layout_scalar_alignment_policy(slot: i64) -> i64 {
    if slot == 0 { TARGET_DATA_LAYOUT_SCALAR_ALIGNMENT_POLICY_0 } else { TARGET_DATA_LAYOUT_SCALAR_ALIGNMENT_POLICY_1 }
}

fn target_data_layout_vector_alignment_policy(slot: i64) -> i64 {
    if slot == 0 { TARGET_DATA_LAYOUT_VECTOR_ALIGNMENT_POLICY_0 } else { TARGET_DATA_LAYOUT_VECTOR_ALIGNMENT_POLICY_1 }
}

fn target_data_layout_wide_float_abi_policy(slot: i64) -> i64 {
    if slot == 0 { TARGET_DATA_LAYOUT_WIDE_FLOAT_ABI_POLICY_0 } else { TARGET_DATA_LAYOUT_WIDE_FLOAT_ABI_POLICY_1 }
}

fn target_data_layout_managed_object_layout_version(slot: i64) -> i64 {
    if slot == 0 { TARGET_DATA_LAYOUT_MANAGED_OBJECT_LAYOUT_VERSION_0 } else { TARGET_DATA_LAYOUT_MANAGED_OBJECT_LAYOUT_VERSION_1 }
}

fn target_data_layout_algorithm_version(slot: i64) -> i64 {
    if slot == 0 { TARGET_DATA_LAYOUT_ALGORITHM_VERSION_0 } else { TARGET_DATA_LAYOUT_ALGORITHM_VERSION_1 }
}

fn set_target_data_layout_state(slot: i64, value: i64) with Mut {
    if slot == 0 { TARGET_DATA_LAYOUT_STATE_0 = value } else { TARGET_DATA_LAYOUT_STATE_1 = value }
}

fn set_target_data_layout_generation(slot: i64, value: i64) with Mut {
    if slot == 0 { TARGET_DATA_LAYOUT_GENERATION_0 = value } else { TARGET_DATA_LAYOUT_GENERATION_1 = value }
}

fn bump_target_data_layout_generation(slot: i64) with Mut {
    set_target_data_layout_generation(slot, target_data_layout_generation(slot) + 1)
}

fn clear_target_data_layout_payload(slot: i64) with Mut {
    if slot == 0 {
        TARGET_DATA_LAYOUT_PROFILE_0 = 0
        TARGET_DATA_LAYOUT_ARCH_0 = 0
        TARGET_DATA_LAYOUT_OS_0 = 0
        TARGET_DATA_LAYOUT_OS_ABI_0 = 0
        TARGET_DATA_LAYOUT_ENDIAN_0 = 0
        TARGET_DATA_LAYOUT_POINTER_SIZE_0 = 0
        TARGET_DATA_LAYOUT_POINTER_ALIGNMENT_0 = 0
        TARGET_DATA_LAYOUT_SCALAR_ALIGNMENT_POLICY_0 = 0
        TARGET_DATA_LAYOUT_VECTOR_ALIGNMENT_POLICY_0 = 0
        TARGET_DATA_LAYOUT_WIDE_FLOAT_ABI_POLICY_0 = 0
        TARGET_DATA_LAYOUT_MANAGED_OBJECT_LAYOUT_VERSION_0 = 0
        TARGET_DATA_LAYOUT_ALGORITHM_VERSION_0 = 0
    } else {
        TARGET_DATA_LAYOUT_PROFILE_1 = 0
        TARGET_DATA_LAYOUT_ARCH_1 = 0
        TARGET_DATA_LAYOUT_OS_1 = 0
        TARGET_DATA_LAYOUT_OS_ABI_1 = 0
        TARGET_DATA_LAYOUT_ENDIAN_1 = 0
        TARGET_DATA_LAYOUT_POINTER_SIZE_1 = 0
        TARGET_DATA_LAYOUT_POINTER_ALIGNMENT_1 = 0
        TARGET_DATA_LAYOUT_SCALAR_ALIGNMENT_POLICY_1 = 0
        TARGET_DATA_LAYOUT_VECTOR_ALIGNMENT_POLICY_1 = 0
        TARGET_DATA_LAYOUT_WIDE_FLOAT_ABI_POLICY_1 = 0
        TARGET_DATA_LAYOUT_MANAGED_OBJECT_LAYOUT_VERSION_1 = 0
        TARGET_DATA_LAYOUT_ALGORITHM_VERSION_1 = 0
    }
}

pub fn target_data_layout_registry_shadow_profile_is_registered(profile: i64) -> bool {
    profile == target_data_layout_profile_x86_64_linux_sysv_v1() ||
    profile == target_data_layout_profile_x86_64_macos_darwin_v1() ||
    profile == target_data_layout_profile_aarch64_linux_aapcs64_v1()
}

fn write_target_data_layout_profile(slot: i64, profile: i64) with Mut {
    var arch = native_policy_arch_x86_64()
    var os = native_policy_os_linux()
    var os_abi = target_os_abi_sysv_amd64_v1()
    if profile == target_data_layout_profile_x86_64_macos_darwin_v1() {
        os = native_policy_os_macos()
        os_abi = target_os_abi_darwin_amd64_v1()
    } else if profile == target_data_layout_profile_aarch64_linux_aapcs64_v1() {
        arch = native_policy_arch_aarch64()
        os_abi = target_os_abi_aapcs64_elf_v1()
    }

    if slot == 0 {
        TARGET_DATA_LAYOUT_PROFILE_0 = profile
        TARGET_DATA_LAYOUT_ARCH_0 = arch
        TARGET_DATA_LAYOUT_OS_0 = os
        TARGET_DATA_LAYOUT_OS_ABI_0 = os_abi
        TARGET_DATA_LAYOUT_ENDIAN_0 = target_endian_little_v1()
        TARGET_DATA_LAYOUT_POINTER_SIZE_0 = 8
        TARGET_DATA_LAYOUT_POINTER_ALIGNMENT_0 = 8
        TARGET_DATA_LAYOUT_SCALAR_ALIGNMENT_POLICY_0 = target_scalar_alignment_natural_cap_16_v1()
        TARGET_DATA_LAYOUT_VECTOR_ALIGNMENT_POLICY_0 = target_vector_alignment_baseline_16_v1()
        TARGET_DATA_LAYOUT_WIDE_FLOAT_ABI_POLICY_0 = target_wide_float_abi_undeclared()
        TARGET_DATA_LAYOUT_MANAGED_OBJECT_LAYOUT_VERSION_0 = target_managed_object_layout_v1()
        TARGET_DATA_LAYOUT_ALGORITHM_VERSION_0 = target_layout_algorithm_v1()
    } else {
        TARGET_DATA_LAYOUT_PROFILE_1 = profile
        TARGET_DATA_LAYOUT_ARCH_1 = arch
        TARGET_DATA_LAYOUT_OS_1 = os
        TARGET_DATA_LAYOUT_OS_ABI_1 = os_abi
        TARGET_DATA_LAYOUT_ENDIAN_1 = target_endian_little_v1()
        TARGET_DATA_LAYOUT_POINTER_SIZE_1 = 8
        TARGET_DATA_LAYOUT_POINTER_ALIGNMENT_1 = 8
        TARGET_DATA_LAYOUT_SCALAR_ALIGNMENT_POLICY_1 = target_scalar_alignment_natural_cap_16_v1()
        TARGET_DATA_LAYOUT_VECTOR_ALIGNMENT_POLICY_1 = target_vector_alignment_baseline_16_v1()
        TARGET_DATA_LAYOUT_WIDE_FLOAT_ABI_POLICY_1 = target_wide_float_abi_undeclared()
        TARGET_DATA_LAYOUT_MANAGED_OBJECT_LAYOUT_VERSION_1 = target_managed_object_layout_v1()
        TARGET_DATA_LAYOUT_ALGORITHM_VERSION_1 = target_layout_algorithm_v1()
    }
}

fn target_data_layout_slot_profile_integrity_code(slot: i64) -> i64 {
    let profile = target_data_layout_profile(slot)
    var expected_arch = native_policy_arch_x86_64()
    var expected_os = native_policy_os_linux()
    var expected_os_abi = target_os_abi_sysv_amd64_v1()
    if profile == target_data_layout_profile_x86_64_linux_sysv_v1() {
        expected_arch = native_policy_arch_x86_64()
    } else if profile == target_data_layout_profile_x86_64_macos_darwin_v1() {
        expected_os = native_policy_os_macos()
        expected_os_abi = target_os_abi_darwin_amd64_v1()
    } else if profile == target_data_layout_profile_aarch64_linux_aapcs64_v1() {
        expected_arch = native_policy_arch_aarch64()
        expected_os_abi = target_os_abi_aapcs64_elf_v1()
    } else {
        return 100 + profile
    }

    if target_data_layout_arch(slot) != expected_arch { return 2 }
    if target_data_layout_os(slot) != expected_os { return 3 }
    if target_data_layout_os_abi(slot) != expected_os_abi { return 4 }
    if target_data_layout_endian(slot) != target_endian_little_v1() { return 5 }
    if target_data_layout_pointer_size(slot) != 8 { return 6 }
    if target_data_layout_pointer_alignment(slot) != 8 { return 7 }
    if target_data_layout_scalar_alignment_policy(slot) !=
       target_scalar_alignment_natural_cap_16_v1() { return 8 }
    if target_data_layout_vector_alignment_policy(slot) !=
       target_vector_alignment_baseline_16_v1() { return 9 }
    if target_data_layout_wide_float_abi_policy(slot) !=
       target_wide_float_abi_undeclared() { return 10 }
    if target_data_layout_managed_object_layout_version(slot) !=
       target_managed_object_layout_v1() { return 11 }
    if target_data_layout_algorithm_version(slot) != target_layout_algorithm_v1() { return 12 }
    0
}

fn validate_target_data_layout_handle(id: &TargetDataLayoutId) -> i64 {
    if TARGET_DATA_LAYOUT_STORE_IDENTITY <= 0 {
        return TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_INVALID_STORE
    }
    let slot = (*id).slot
    if (*id).store_identity <= 0 || slot < 0 ||
       slot >= target_data_layout_registry_shadow_capacity() || (*id).generation <= 0 {
        return TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_INVALID_ID
    }
    if (*id).store_identity != TARGET_DATA_LAYOUT_STORE_IDENTITY ||
       target_data_layout_state(slot) != TARGET_DATA_LAYOUT_SLOT_LIVE ||
       target_data_layout_generation(slot) != (*id).generation {
        return TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_STALE_ID
    }
    TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK
}

fn validate_target_data_layout_id(id: &TargetDataLayoutId) -> i64 {
    let status = validate_target_data_layout_handle(id)
    if status != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK { return status }
    if target_data_layout_slot_profile_integrity_code((*id).slot) != 0 {
        return TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_UNREGISTERED_POLICY
    }
    TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK
}

fn clear_target_data_layout_store_slots() with Mut {
    var slot: i64 = 0
    while slot < target_data_layout_registry_shadow_capacity() {
        bump_target_data_layout_generation(slot)
        clear_target_data_layout_payload(slot)
        set_target_data_layout_state(slot, TARGET_DATA_LAYOUT_SLOT_FREE)
        slot = slot + 1
    }
    TARGET_DATA_LAYOUT_LIVE_COUNT = 0
}

fn advance_target_data_layout_store_identity() -> i64 with Mut {
    if TARGET_DATA_LAYOUT_STORE_IDENTITY == 9223372036854775807 {
        return TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_STORE_IDENTITY_EXHAUSTED
    }
    TARGET_DATA_LAYOUT_STORE_IDENTITY = TARGET_DATA_LAYOUT_STORE_IDENTITY + 1
    TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK
}

// Store identities are compiler-minted and monotonic. Callers can neither
// choose an identity nor recreate an old one after reset.
pub fn target_data_layout_registry_shadow_store_init() -> i64 with Mut {
    if TARGET_DATA_LAYOUT_STORE_IDENTITY != 0 {
        return TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_STORE_ALREADY_INITIALIZED
    }
    let status = advance_target_data_layout_store_identity()
    if status != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK { return status }
    clear_target_data_layout_store_slots()
    TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK
}

pub fn target_data_layout_registry_shadow_store_reset() -> i64 with Mut {
    if TARGET_DATA_LAYOUT_STORE_IDENTITY <= 0 {
        return TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_INVALID_STORE
    }
    let status = advance_target_data_layout_store_identity()
    if status != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK { return status }
    clear_target_data_layout_store_slots()
    TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK
}

pub fn target_data_layout_registry_shadow_live_count() -> i64 {
    TARGET_DATA_LAYOUT_LIVE_COUNT
}

pub fn target_data_layout_registry_shadow_id_status(id: &TargetDataLayoutId) -> i64 {
    validate_target_data_layout_id(id)
}

// Diagnostic only: zero means the live slot exactly matches its registered
// profile; positive values identify the first closed-policy column that drifted.
pub fn target_data_layout_registry_shadow_profile_integrity_code(id: &TargetDataLayoutId) -> i64 {
    let status = validate_target_data_layout_handle(id)
    if status != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK { return status }
    target_data_layout_slot_profile_integrity_code((*id).slot)
}

pub fn target_data_layout_registry_shadow_id_is_live(id: &TargetDataLayoutId) -> bool {
    validate_target_data_layout_id(id) == TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK
}

pub fn target_data_layout_registry_shadow_alloc_profile(
    profile: i64,
    out: &! TargetDataLayoutId,
) -> i64 with Mut {
    if TARGET_DATA_LAYOUT_STORE_IDENTITY <= 0 {
        return TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_INVALID_STORE
    }
    if !target_data_layout_id_is_clear(out) {
        return TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_OUTPUT_NOT_CLEAR
    }
    if !target_data_layout_registry_shadow_profile_is_registered(profile) {
        return TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_UNSUPPORTED_PROFILE
    }

    var occupied: i64 = 0
    while occupied < target_data_layout_registry_shadow_capacity() {
        if target_data_layout_state(occupied) == TARGET_DATA_LAYOUT_SLOT_LIVE &&
           target_data_layout_profile(occupied) == profile {
            return TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_DUPLICATE_PROFILE
        }
        occupied = occupied + 1
    }

    var slot: i64 = 0
    while slot < target_data_layout_registry_shadow_capacity() {
        if target_data_layout_state(slot) != TARGET_DATA_LAYOUT_SLOT_LIVE {
            clear_target_data_layout_payload(slot)
            write_target_data_layout_profile(slot, profile)
            set_target_data_layout_state(slot, TARGET_DATA_LAYOUT_SLOT_LIVE)
            TARGET_DATA_LAYOUT_LIVE_COUNT = TARGET_DATA_LAYOUT_LIVE_COUNT + 1
            (*out).store_identity = TARGET_DATA_LAYOUT_STORE_IDENTITY
            (*out).slot = slot
            (*out).generation = target_data_layout_generation(slot)
            return TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK
        }
        slot = slot + 1
    }
    TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_CAPACITY
}

pub fn target_data_layout_registry_shadow_release(id: &TargetDataLayoutId) -> i64 with Mut {
    let status = validate_target_data_layout_id(id)
    if status != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK { return status }
    let slot = (*id).slot
    clear_target_data_layout_payload(slot)
    bump_target_data_layout_generation(slot)
    set_target_data_layout_state(slot, TARGET_DATA_LAYOUT_SLOT_RELEASED)
    TARGET_DATA_LAYOUT_LIVE_COUNT = TARGET_DATA_LAYOUT_LIVE_COUNT - 1
    TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK
}

pub fn target_data_layout_registry_shadow_profile_id(id: &TargetDataLayoutId) -> i64 {
    let status = validate_target_data_layout_id(id)
    if status != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK { return status }
    target_data_layout_profile((*id).slot)
}

pub fn target_data_layout_registry_shadow_arch_id(id: &TargetDataLayoutId) -> i64 {
    let status = validate_target_data_layout_id(id)
    if status != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK { return status }
    target_data_layout_arch((*id).slot)
}

pub fn target_data_layout_registry_shadow_os_id(id: &TargetDataLayoutId) -> i64 {
    let status = validate_target_data_layout_id(id)
    if status != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK { return status }
    target_data_layout_os((*id).slot)
}

pub fn target_data_layout_registry_shadow_os_abi_id(id: &TargetDataLayoutId) -> i64 {
    let status = validate_target_data_layout_id(id)
    if status != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK { return status }
    target_data_layout_os_abi((*id).slot)
}

pub fn target_data_layout_registry_shadow_endianness_id(id: &TargetDataLayoutId) -> i64 {
    let status = validate_target_data_layout_id(id)
    if status != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK { return status }
    target_data_layout_endian((*id).slot)
}

pub fn target_data_layout_registry_shadow_pointer_size_bytes(id: &TargetDataLayoutId) -> i64 {
    let status = validate_target_data_layout_id(id)
    if status != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK { return status }
    target_data_layout_pointer_size((*id).slot)
}

pub fn target_data_layout_registry_shadow_pointer_alignment_bytes(id: &TargetDataLayoutId) -> i64 {
    let status = validate_target_data_layout_id(id)
    if status != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK { return status }
    target_data_layout_pointer_alignment((*id).slot)
}

pub fn target_data_layout_registry_shadow_scalar_alignment_policy(id: &TargetDataLayoutId) -> i64 {
    let status = validate_target_data_layout_id(id)
    if status != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK { return status }
    target_data_layout_scalar_alignment_policy((*id).slot)
}

pub fn target_data_layout_registry_shadow_vector_alignment_policy(id: &TargetDataLayoutId) -> i64 {
    let status = validate_target_data_layout_id(id)
    if status != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK { return status }
    target_data_layout_vector_alignment_policy((*id).slot)
}

pub fn target_data_layout_registry_shadow_wide_float_abi_policy(id: &TargetDataLayoutId) -> i64 {
    let status = validate_target_data_layout_id(id)
    if status != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK { return status }
    target_data_layout_wide_float_abi_policy((*id).slot)
}

pub fn target_data_layout_registry_shadow_managed_object_layout_version(id: &TargetDataLayoutId) -> i64 {
    let status = validate_target_data_layout_id(id)
    if status != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK { return status }
    target_data_layout_managed_object_layout_version((*id).slot)
}

pub fn target_data_layout_registry_shadow_layout_algorithm_version(id: &TargetDataLayoutId) -> i64 {
    let status = validate_target_data_layout_id(id)
    if status != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK { return status }
    target_data_layout_algorithm_version((*id).slot)
}

pub fn target_data_layout_registry_shadow_id_equal(
    left: &TargetDataLayoutId,
    right: &TargetDataLayoutId,
) -> bool {
    if validate_target_data_layout_id(left) != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK ||
       validate_target_data_layout_id(right) != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK {
        return false
    }
    (*left).store_identity == (*right).store_identity &&
    (*left).slot == (*right).slot &&
    (*left).generation == (*right).generation
}

// ABI-policy equality is deliberately separate from storage-policy equality.
pub fn target_data_layout_registry_shadow_abi_policy_equal(
    left: &TargetDataLayoutId,
    right: &TargetDataLayoutId,
) -> bool {
    if validate_target_data_layout_id(left) != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK ||
       validate_target_data_layout_id(right) != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK {
        return false
    }
    let a = (*left).slot
    let b = (*right).slot
    target_data_layout_os_abi(a) == target_data_layout_os_abi(b) &&
    target_data_layout_wide_float_abi_policy(a) == target_data_layout_wide_float_abi_policy(b)
}

// This compares declared base-storage facts without claiming a field layout or
// a wide-float representation. It never collapses target or ABI identity.
pub fn target_data_layout_registry_shadow_declared_storage_policy_equal(
    left: &TargetDataLayoutId,
    right: &TargetDataLayoutId,
) -> bool {
    if validate_target_data_layout_id(left) != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK ||
       validate_target_data_layout_id(right) != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK {
        return false
    }
    let a = (*left).slot
    let b = (*right).slot
    target_data_layout_endian(a) == target_data_layout_endian(b) &&
    target_data_layout_pointer_size(a) == target_data_layout_pointer_size(b) &&
    target_data_layout_pointer_alignment(a) == target_data_layout_pointer_alignment(b) &&
    target_data_layout_scalar_alignment_policy(a) == target_data_layout_scalar_alignment_policy(b) &&
    target_data_layout_vector_alignment_policy(a) == target_data_layout_vector_alignment_policy(b) &&
    target_data_layout_managed_object_layout_version(a) == target_data_layout_managed_object_layout_version(b) &&
    target_data_layout_algorithm_version(a) == target_data_layout_algorithm_version(b)
}

pub fn target_data_layout_registry_shadow_f128_abi_status(id: &TargetDataLayoutId) -> i64 {
    let status = validate_target_data_layout_id(id)
    if status != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK { return status }
    if target_data_layout_wide_float_abi_policy((*id).slot) != target_wide_float_abi_undeclared() {
        return TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_UNREGISTERED_POLICY
    }
    TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_WIDE_FLOAT_UNSUPPORTED
}

pub fn target_data_layout_registry_shadow_f256_abi_status(id: &TargetDataLayoutId) -> i64 {
    let status = validate_target_data_layout_id(id)
    if status != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK { return status }
    if target_data_layout_wide_float_abi_policy((*id).slot) != target_wide_float_abi_undeclared() {
        return TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_UNREGISTERED_POLICY
    }
    TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_WIDE_FLOAT_UNSUPPORTED
}
