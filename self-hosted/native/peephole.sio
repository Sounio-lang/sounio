// self-hosted::native::peephole — Peephole optimizer for x86-64 instruction sequences
//
// Performs local optimizations on short instruction windows:
//   - mov rX, rX  -> NOP (remove no-op self-move)
//   - add rX, 0   -> NOP (identity add)
//   - sub rX, 0   -> NOP (identity sub)
//   - xor rX, rX  -> mov rX, 0 (zero idiom)
//   - redundant push/pop pairs (push rX; pop rX) -> NOP
//   - mov then immediate load fusion (mov dst, src where src is imm 0)
//   - cmp rX, 0 after xor rX, rX -> remove (flags already set)
//
// All opcodes are i64 constants. All prefixes ph_.

module native::peephole

use ir::ir::{IrInstr, IrFunction, IrOpcode, ir_nop}

// ============================================================================
// Opcode constants
// ============================================================================

pub fn PH_MOV()  -> i64 { 0 }
pub fn PH_ADD()  -> i64 { 1 }
pub fn PH_SUB()  -> i64 { 2 }
pub fn PH_PUSH() -> i64 { 3 }
pub fn PH_POP()  -> i64 { 4 }
pub fn PH_RET()  -> i64 { 5 }
pub fn PH_CMP()  -> i64 { 6 }
pub fn PH_JMP()  -> i64 { 7 }
pub fn PH_CALL() -> i64 { 8 }
pub fn PH_XOR()  -> i64 { 9 }
pub fn PH_MUL()  -> i64 { 10 }
pub fn PH_DIV()  -> i64 { 11 }
pub fn PH_NOP()  -> i64 { 12 }

// Sentinel for "no register"
pub fn PH_NO_REG() -> i64 { 0 - 1 }

// Flag bits in PhInstr.flags
pub fn PH_FLAG_USE_IMM()  -> i64 { 1 }   // src is an immediate value
pub fn PH_FLAG_USE_MEM()  -> i64 { 2 }   // src is a memory operand
pub fn PH_FLAG_REMOVED()  -> i64 { 4 }   // instruction was removed by optimizer

// ============================================================================
// Data structures
// ============================================================================

pub struct PhInstr {
    pub opcode: i64,    // PH_MOV etc.
    pub dst:    i64,    // destination register (0-15), or PH_NO_REG
    pub src:    i64,    // source register, or PH_NO_REG
    pub imm:    i64,    // immediate value (used when PH_FLAG_USE_IMM set in flags)
    pub flags:  i64,    // flag bits
}

pub struct PhWindow {
    pub instrs: [PhInstr; 64],
    pub count:  i64,
}

pub struct PhResult {
    pub instrs:    [PhInstr; 64],
    pub count:     i64,
    pub optimized: i64,   // number of instructions removed / transformed
}

// ============================================================================
// Constructors
// ============================================================================

pub fn ph_instr_new(opcode: i64, dst: i64, src: i64, imm: i64) -> PhInstr {
    PhInstr { opcode: opcode, dst: dst, src: src, imm: imm, flags: 0 }
}

pub fn ph_instr_imm(opcode: i64, dst: i64, imm: i64) -> PhInstr {
    PhInstr { opcode: opcode, dst: dst, src: PH_NO_REG(), imm: imm, flags: PH_FLAG_USE_IMM() }
}

pub fn ph_nop_instr() -> PhInstr {
    PhInstr { opcode: PH_NOP(), dst: PH_NO_REG(), src: PH_NO_REG(), imm: 0, flags: PH_FLAG_REMOVED() }
}

pub fn ph_empty_instr() -> PhInstr {
    PhInstr { opcode: PH_NOP(), dst: PH_NO_REG(), src: PH_NO_REG(), imm: 0, flags: 0 }
}

pub fn ph_window_new() -> PhWindow {
    PhWindow { instrs: [ph_empty_instr(); 64], count: 0 }
}

pub fn ph_result_empty() -> PhResult {
    PhResult { instrs: [ph_empty_instr(); 64], count: 0, optimized: 0 }
}

// ============================================================================
// Window population
// ============================================================================

pub fn ph_add_instr(w: &! PhWindow, opcode: i64, dst: i64, src: i64, imm: i64) with Mut, Panic {
    let idx = (*w).count
    if idx < 64 {
        (*w).instrs[idx as usize] = ph_instr_new(opcode, dst, src, imm)
        (*w).count = idx + 1
    }
}

pub fn ph_add_imm_instr(w: &! PhWindow, opcode: i64, dst: i64, imm: i64) with Mut, Panic {
    let idx = (*w).count
    if idx < 64 {
        (*w).instrs[idx as usize] = ph_instr_imm(opcode, dst, imm)
        (*w).count = idx + 1
    }
}

// ============================================================================
// Single-instruction predicates
// ============================================================================

// True if instr is a no-op self-move: mov rX, rX
pub fn ph_is_nop_move(i: &PhInstr) -> bool {
    if (*i).opcode != PH_MOV() { return false }
    if (*i).dst == PH_NO_REG() { return false }
    if (*i).src == PH_NO_REG() { return false }
    (*i).dst == (*i).src
}

// True if instr is add/sub rX, 0 (identity op)
pub fn ph_is_identity_add(i: &PhInstr) -> bool {
    if (*i).opcode != PH_ADD() { return false }
    if (*i).flags & PH_FLAG_USE_IMM() == 0 { return false }
    (*i).imm == 0
}

pub fn ph_is_identity_sub(i: &PhInstr) -> bool {
    if (*i).opcode != PH_SUB() { return false }
    if (*i).flags & PH_FLAG_USE_IMM() == 0 { return false }
    (*i).imm == 0
}

// True if instr is xor rX, rX (zero-register idiom)
pub fn ph_is_xor_zero(i: &PhInstr) -> bool {
    if (*i).opcode != PH_XOR() { return false }
    if (*i).dst == PH_NO_REG() { return false }
    if (*i).src == PH_NO_REG() { return false }
    (*i).dst == (*i).src
}

// True if instr is a NOP (already marked as removed)
pub fn ph_is_nop(i: &PhInstr) -> bool {
    (*i).opcode == PH_NOP()
}

// True if instr is a push
pub fn ph_is_push(i: &PhInstr) -> bool {
    (*i).opcode == PH_PUSH()
}

// True if instr is a pop
pub fn ph_is_pop(i: &PhInstr) -> bool {
    (*i).opcode == PH_POP()
}

// True if two instructions are push/pop of same register
pub fn ph_is_push_pop_pair(a: &PhInstr, b: &PhInstr) -> bool {
    if !ph_is_push(a) { return false }
    if !ph_is_pop(b)  { return false }
    (*a).dst == (*b).dst
}

// True if instr is: cmp rX, 0
pub fn ph_is_cmp_zero(i: &PhInstr) -> bool {
    if (*i).opcode != PH_CMP() { return false }
    if (*i).flags & PH_FLAG_USE_IMM() == 0 { return false }
    (*i).imm == 0
}

// True if instr is mov rX, 0 (immediate zero)
pub fn ph_is_mov_imm_zero(i: &PhInstr) -> bool {
    if (*i).opcode != PH_MOV() { return false }
    if (*i).flags & PH_FLAG_USE_IMM() == 0 { return false }
    (*i).imm == 0
}

// ============================================================================
// Single-pass window optimizer
// ============================================================================

// Optimize a single instruction in isolation
pub fn ph_opt_single(instr: PhInstr) -> PhInstr {
    var i = instr
    // nop-move: mov rX, rX -> NOP
    if ph_is_nop_move(&i) {
        return ph_nop_instr()
    }
    // identity add: add rX, 0 -> NOP
    if ph_is_identity_add(&i) {
        return ph_nop_instr()
    }
    // identity sub: sub rX, 0 -> NOP
    if ph_is_identity_sub(&i) {
        return ph_nop_instr()
    }
    i
}

// Optimize a pair of consecutive instructions.
// Returns (new_a, new_b, changed).
// Encodes changed as: 0=no change, 1=changed
pub fn ph_opt_pair(a: PhInstr, b: PhInstr) -> PhResult {
    var result = ph_result_empty()
    result.instrs[0] = a
    result.instrs[1] = b
    result.count = 2
    result.optimized = 0

    // push rX; pop rX -> NOP NOP (redundant save/restore)
    if ph_is_push_pop_pair(&a, &b) {
        result.instrs[0] = ph_nop_instr()
        result.instrs[1] = ph_nop_instr()
        result.optimized = 2
        return result
    }

    // xor rX, rX; cmp rX, 0 -> xor rX, rX; NOP (flags already set)
    if ph_is_xor_zero(&a) && ph_is_cmp_zero(&b) {
        if a.dst == b.dst {
            result.instrs[1] = ph_nop_instr()
            result.optimized = 1
            return result
        }
    }

    // mov rX, imm; mov rX, imm (same dst twice) -> keep only second
    if a.opcode == PH_MOV() && b.opcode == PH_MOV() {
        if a.dst == b.dst && a.dst != PH_NO_REG() {
            result.instrs[0] = ph_nop_instr()
            result.optimized = 1
            return result
        }
    }

    result
}

// ============================================================================
// Main optimiser: apply all peephole rules to a window
// ============================================================================

pub fn ph_optimize(w: &PhWindow) -> PhResult {
    var out = ph_result_empty()
    var n = (*w).count
    if n <= 0 {
        return out
    }

    // Copy instructions into a working buffer
    var work: [PhInstr; 64] = [ph_empty_instr(); 64]
    var i: i64 = 0
    while i < n {
        work[i as usize] = (*w).instrs[i as usize]
        i = i + 1
    }

    // Pass 1: single-instruction optimisations
    var opt_count: i64 = 0
    i = 0
    while i < n {
        let orig = work[i as usize]
        let optimized = ph_opt_single(work[i as usize])
        if optimized.opcode != orig.opcode {
            opt_count = opt_count + 1
        }
        work[i as usize] = optimized
        i = i + 1
    }

    // Pass 2: pair optimisations (sliding window of 2)
    i = 0
    while i < n - 1 {
        if work[i as usize].opcode != PH_NOP() && work[(i + 1) as usize].opcode != PH_NOP() {
            let pair_result = ph_opt_pair(work[i as usize], work[(i + 1) as usize])
            if pair_result.optimized > 0 {
                work[i as usize]       = pair_result.instrs[0]
                work[(i + 1) as usize] = pair_result.instrs[1]
                opt_count = opt_count + pair_result.optimized
            }
        }
        i = i + 1
    }

    // Compact: remove NOP instructions
    var out_count: i64 = 0
    i = 0
    while i < n {
        if work[i as usize].opcode != PH_NOP() {
            out.instrs[out_count as usize] = work[i as usize]
            out_count = out_count + 1
        }
        i = i + 1
    }
    out.count     = out_count
    out.optimized = opt_count
    out
}

// ============================================================================
// Utility query functions
// ============================================================================

// Count instructions with a given opcode in a result
pub fn ph_result_count_opcode(r: &PhResult, op: i64) -> i64 {
    var n: i64 = 0
    var i: i64 = 0
    while i < (*r).count {
        if (*r).instrs[i as usize].opcode == op {
            n = n + 1
        }
        i = i + 1
    }
    n
}

// True if result contains any NOP (should not after compaction)
pub fn ph_result_has_nop(r: &PhResult) -> bool {
    var i: i64 = 0
    while i < (*r).count {
        if (*r).instrs[i as usize].opcode == PH_NOP() {
            return true
        }
        i = i + 1
    }
    false
}

// ============================================================================
// Helpers to build test windows
// ============================================================================

pub fn ph_build_nop_move(reg: i64) -> PhWindow with Mut, Panic {
    var w = ph_window_new()
    ph_add_instr(&! w, PH_MOV(), reg, reg, 0)
    w
}

pub fn ph_build_identity_add(reg: i64) -> PhWindow with Mut, Panic {
    var w = ph_window_new()
    ph_add_imm_instr(&! w, PH_ADD(), reg, 0)
    w
}

pub fn ph_build_identity_sub(reg: i64) -> PhWindow with Mut, Panic {
    var w = ph_window_new()
    ph_add_imm_instr(&! w, PH_SUB(), reg, 0)
    w
}

pub fn ph_build_push_pop(reg: i64) -> PhWindow with Mut, Panic {
    var w = ph_window_new()
    ph_add_instr(&! w, PH_PUSH(), reg, PH_NO_REG(), 0)
    ph_add_instr(&! w, PH_POP(),  reg, PH_NO_REG(), 0)
    w
}

pub fn ph_build_xor_cmp(reg: i64) -> PhWindow with Mut, Panic {
    var w = ph_window_new()
    ph_add_instr(&! w, PH_XOR(), reg, reg, 0)
    ph_add_imm_instr(&! w, PH_CMP(), reg, 0)
    w
}

pub fn ph_build_double_mov(dst: i64, imm1: i64, imm2: i64) -> PhWindow with Mut, Panic {
    var w = ph_window_new()
    ph_add_imm_instr(&! w, PH_MOV(), dst, imm1)
    ph_add_imm_instr(&! w, PH_MOV(), dst, imm2)
    w
}

pub fn ph_build_real_move(dst: i64, src: i64) -> PhWindow with Mut, Panic {
    var w = ph_window_new()
    ph_add_instr(&! w, PH_MOV(), dst, src, 0)
    w
}

pub fn ph_build_real_add(dst: i64, imm: i64) -> PhWindow with Mut, Panic {
    var w = ph_window_new()
    ph_add_imm_instr(&! w, PH_ADD(), dst, imm)
    w
}

// ============================================================================
// Tests
// ============================================================================

pub fn ph_test_opcode_constants_distinct() -> bool {
    PH_MOV() != PH_ADD() && PH_ADD() != PH_SUB() && PH_NOP() != PH_MOV()
}

pub fn ph_test_window_new_empty() -> bool {
    let w = ph_window_new()
    w.count == 0
}

pub fn ph_test_add_instr_increments_count() -> bool with Mut, Panic {
    var w = ph_window_new()
    ph_add_instr(&! w, PH_MOV(), 0, 1, 0)
    w.count == 1
}

pub fn ph_test_add_two_instrs() -> bool with Mut, Panic {
    var w = ph_window_new()
    ph_add_instr(&! w, PH_MOV(), 0, 1, 0)
    ph_add_instr(&! w, PH_ADD(), 0, 1, 0)
    w.count == 2
}

pub fn ph_test_is_nop_move_true() -> bool {
    let i = ph_instr_new(PH_MOV(), 3, 3, 0)
    ph_is_nop_move(&i)
}

pub fn ph_test_is_nop_move_false_diff_regs() -> bool {
    let i = ph_instr_new(PH_MOV(), 0, 1, 0)
    !ph_is_nop_move(&i)
}

pub fn ph_test_is_nop_move_false_wrong_opcode() -> bool {
    let i = ph_instr_new(PH_ADD(), 3, 3, 0)
    !ph_is_nop_move(&i)
}

pub fn ph_test_is_identity_add_true() -> bool {
    let i = ph_instr_imm(PH_ADD(), 0, 0)
    ph_is_identity_add(&i)
}

pub fn ph_test_is_identity_add_false_nonzero() -> bool {
    let i = ph_instr_imm(PH_ADD(), 0, 5)
    !ph_is_identity_add(&i)
}

pub fn ph_test_is_identity_sub_true() -> bool {
    let i = ph_instr_imm(PH_SUB(), 2, 0)
    ph_is_identity_sub(&i)
}

pub fn ph_test_is_identity_sub_false_nonzero() -> bool {
    let i = ph_instr_imm(PH_SUB(), 2, 3)
    !ph_is_identity_sub(&i)
}

pub fn ph_test_is_xor_zero_true() -> bool {
    let i = ph_instr_new(PH_XOR(), 4, 4, 0)
    ph_is_xor_zero(&i)
}

pub fn ph_test_is_xor_zero_false_diff_regs() -> bool {
    let i = ph_instr_new(PH_XOR(), 0, 1, 0)
    !ph_is_xor_zero(&i)
}

pub fn ph_test_is_push_true() -> bool {
    let i = ph_instr_new(PH_PUSH(), 7, PH_NO_REG(), 0)
    ph_is_push(&i)
}

pub fn ph_test_is_pop_true() -> bool {
    let i = ph_instr_new(PH_POP(), 7, PH_NO_REG(), 0)
    ph_is_pop(&i)
}

pub fn ph_test_is_push_pop_pair_true() -> bool {
    let a = ph_instr_new(PH_PUSH(), 5, PH_NO_REG(), 0)
    let b = ph_instr_new(PH_POP(),  5, PH_NO_REG(), 0)
    ph_is_push_pop_pair(&a, &b)
}

pub fn ph_test_is_push_pop_pair_false_diff_reg() -> bool {
    let a = ph_instr_new(PH_PUSH(), 5, PH_NO_REG(), 0)
    let b = ph_instr_new(PH_POP(),  6, PH_NO_REG(), 0)
    !ph_is_push_pop_pair(&a, &b)
}

pub fn ph_test_is_cmp_zero_true() -> bool {
    let i = ph_instr_imm(PH_CMP(), 0, 0)
    ph_is_cmp_zero(&i)
}

pub fn ph_test_is_cmp_zero_false() -> bool {
    let i = ph_instr_imm(PH_CMP(), 0, 1)
    !ph_is_cmp_zero(&i)
}

pub fn ph_test_nop_move_removed() -> bool with Mut, Panic {
    var w = ph_build_nop_move(3)
    let r = ph_optimize(&w)
    r.count == 0 && r.optimized >= 1
}

pub fn ph_test_identity_add_removed() -> bool with Mut, Panic {
    var w = ph_build_identity_add(1)
    let r = ph_optimize(&w)
    r.count == 0 && r.optimized >= 1
}

pub fn ph_test_identity_sub_removed() -> bool with Mut, Panic {
    var w = ph_build_identity_sub(2)
    let r = ph_optimize(&w)
    r.count == 0 && r.optimized >= 1
}

pub fn ph_test_push_pop_removed() -> bool with Mut, Panic {
    var w = ph_build_push_pop(7)
    let r = ph_optimize(&w)
    r.count == 0 && r.optimized == 2
}

pub fn ph_test_xor_cmp_removes_cmp() -> bool with Mut, Panic {
    var w = ph_build_xor_cmp(0)
    let r = ph_optimize(&w)
    // xor remains, cmp removed
    r.count == 1 && r.instrs[0].opcode == PH_XOR()
}

pub fn ph_test_double_mov_removes_first() -> bool with Mut, Panic {
    var w = ph_build_double_mov(0, 1, 2)
    let r = ph_optimize(&w)
    // First mov removed, second remains
    r.count == 1 && r.optimized >= 1
}

pub fn ph_test_real_move_not_removed() -> bool with Mut, Panic {
    var w = ph_build_real_move(0, 1)
    let r = ph_optimize(&w)
    r.count == 1
}

pub fn ph_test_real_add_nonzero_not_removed() -> bool with Mut, Panic {
    var w = ph_build_real_add(0, 5)
    let r = ph_optimize(&w)
    r.count == 1
}

pub fn ph_test_result_no_nop_after_optimize() -> bool with Mut, Panic {
    var w = ph_build_nop_move(0)
    let r = ph_optimize(&w)
    !ph_result_has_nop(&r)
}

pub fn ph_test_empty_window_gives_empty_result() -> bool {
    var w = ph_window_new()
    let r = ph_optimize(&w)
    r.count == 0 && r.optimized == 0
}

pub fn ph_test_ret_not_removed() -> bool with Mut, Panic {
    var w = ph_window_new()
    ph_add_instr(&! w, PH_RET(), PH_NO_REG(), PH_NO_REG(), 0)
    let r = ph_optimize(&w)
    r.count == 1 && r.instrs[0].opcode == PH_RET()
}

pub fn ph_test_call_not_removed() -> bool with Mut, Panic {
    var w = ph_window_new()
    ph_add_instr(&! w, PH_CALL(), PH_NO_REG(), 0, 0)
    let r = ph_optimize(&w)
    r.count == 1 && r.instrs[0].opcode == PH_CALL()
}

pub fn ph_test_jmp_not_removed() -> bool with Mut, Panic {
    var w = ph_window_new()
    ph_add_instr(&! w, PH_JMP(), PH_NO_REG(), PH_NO_REG(), 0)
    let r = ph_optimize(&w)
    r.count == 1 && r.instrs[0].opcode == PH_JMP()
}

pub fn ph_test_count_opcode_in_result() -> bool with Mut, Panic {
    var w = ph_window_new()
    ph_add_instr(&! w, PH_RET(), PH_NO_REG(), PH_NO_REG(), 0)
    ph_add_instr(&! w, PH_RET(), PH_NO_REG(), PH_NO_REG(), 0)
    let r = ph_optimize(&w)
    ph_result_count_opcode(&r, PH_RET()) == 2
}

pub fn ph_test_multiple_nop_moves_all_removed() -> bool with Mut, Panic {
    var w = ph_window_new()
    ph_add_instr(&! w, PH_MOV(), 0, 0, 0)
    ph_add_instr(&! w, PH_MOV(), 1, 1, 0)
    ph_add_instr(&! w, PH_MOV(), 2, 2, 0)
    let r = ph_optimize(&w)
    r.count == 0
}

pub fn ph_test_mixed_nop_and_real() -> bool with Mut, Panic {
    var w = ph_window_new()
    ph_add_instr(&! w, PH_MOV(), 0, 0, 0)   // nop
    ph_add_instr(&! w, PH_ADD(), 1, 2, 0)   // real
    ph_add_instr(&! w, PH_MOV(), 3, 3, 0)   // nop
    ph_add_instr(&! w, PH_RET(), PH_NO_REG(), PH_NO_REG(), 0) // real
    let r = ph_optimize(&w)
    r.count == 2
}

pub fn ph_test_push_pop_diff_regs_not_removed() -> bool with Mut, Panic {
    var w = ph_window_new()
    ph_add_instr(&! w, PH_PUSH(), 0, PH_NO_REG(), 0)
    ph_add_instr(&! w, PH_POP(),  1, PH_NO_REG(), 0)
    let r = ph_optimize(&w)
    r.count == 2
}

pub fn ph_test_opt_single_nop_move() -> bool {
    let i = ph_instr_new(PH_MOV(), 5, 5, 0)
    let o = ph_opt_single(i)
    o.opcode == PH_NOP()
}

pub fn ph_test_opt_single_real_unchanged() -> bool {
    let i = ph_instr_new(PH_MOV(), 0, 1, 0)
    let o = ph_opt_single(i)
    o.opcode == PH_MOV()
}

pub fn ph_test_opt_pair_push_pop() -> bool {
    let a = ph_instr_new(PH_PUSH(), 3, PH_NO_REG(), 0)
    let b = ph_instr_new(PH_POP(),  3, PH_NO_REG(), 0)
    let r = ph_opt_pair(a, b)
    r.optimized == 2
}

pub fn ph_test_opt_pair_xor_cmp() -> bool {
    let a = ph_instr_new(PH_XOR(), 0, 0, 0)
    let b = ph_instr_imm(PH_CMP(), 0, 0)
    let r = ph_opt_pair(a, b)
    r.optimized == 1
}

pub fn ph_test_opt_pair_no_opt() -> bool {
    let a = ph_instr_new(PH_ADD(), 0, 1, 0)
    let b = ph_instr_new(PH_SUB(), 2, 3, 0)
    let r = ph_opt_pair(a, b)
    r.optimized == 0
}

pub fn ph_test_instr_imm_flag_set() -> bool {
    let i = ph_instr_imm(PH_ADD(), 0, 5)
    i.flags & PH_FLAG_USE_IMM() != 0
}

pub fn ph_test_instr_new_no_imm_flag() -> bool {
    let i = ph_instr_new(PH_ADD(), 0, 1, 0)
    i.flags & PH_FLAG_USE_IMM() == 0
}

pub fn ph_test_nop_instr_is_nop() -> bool {
    let n = ph_nop_instr()
    n.opcode == PH_NOP()
}

pub fn ph_test_nop_instr_removed_flag() -> bool {
    let n = ph_nop_instr()
    n.flags & PH_FLAG_REMOVED() != 0
}

pub fn ph_test_window_max_64() -> bool with Mut, Panic, Div {
    var w = ph_window_new()
    var i: i64 = 0
    while i < 64 {
        ph_add_instr(&! w, PH_NOP(), PH_NO_REG(), PH_NO_REG(), 0)
        i = i + 1
    }
    w.count == 64
}

pub fn ph_test_optimize_single_xor() -> bool with Mut, Panic {
    var w = ph_window_new()
    ph_add_instr(&! w, PH_XOR(), 0, 0, 0)
    let r = ph_optimize(&w)
    // xor rX, rX is NOT removed by single-opt; only cmp after it
    r.count == 1
}

pub fn ph_test_no_reg_constant_is_minus1() -> bool {
    PH_NO_REG() == 0 - 1
}

pub fn ph_test_result_count_zero_initial() -> bool {
    let r = ph_result_empty()
    r.count == 0
}

pub fn ph_test_result_optimized_zero_initial() -> bool {
    let r = ph_result_empty()
    r.optimized == 0
}

pub fn ph_test_sequence_no_opts() -> bool with Mut, Panic {
    var w = ph_window_new()
    ph_add_instr(&! w, PH_MOV(), 0, 1, 0)
    ph_add_instr(&! w, PH_ADD(), 0, 2, 0)
    ph_add_instr(&! w, PH_RET(), PH_NO_REG(), PH_NO_REG(), 0)
    let r = ph_optimize(&w)
    r.count == 3 && r.optimized == 0
}

pub fn ph_test_xor_cmp_diff_reg_not_removed() -> bool with Mut, Panic {
    var w = ph_window_new()
    ph_add_instr(&! w, PH_XOR(), 0, 0, 0)
    ph_add_imm_instr(&! w, PH_CMP(), 1, 0)  // different reg
    let r = ph_optimize(&w)
    r.count == 2
}

pub fn ph_test_double_mov_same_imm() -> bool with Mut, Panic {
    var w = ph_build_double_mov(5, 42, 42)
    let r = ph_optimize(&w)
    // Both to same dst: first removed
    r.count == 1
}

pub fn ph_test_double_mov_diff_dst() -> bool with Mut, Panic {
    var w = ph_window_new()
    ph_add_imm_instr(&! w, PH_MOV(), 0, 10)
    ph_add_imm_instr(&! w, PH_MOV(), 1, 20)
    let r = ph_optimize(&w)
    // Different dst: no optimization
    r.count == 2
}

pub fn ph_test_is_mov_imm_zero_true() -> bool {
    let i = ph_instr_imm(PH_MOV(), 0, 0)
    ph_is_mov_imm_zero(&i)
}

pub fn ph_test_is_mov_imm_zero_false() -> bool {
    let i = ph_instr_imm(PH_MOV(), 0, 1)
    !ph_is_mov_imm_zero(&i)
}

pub fn ph_test_result_has_nop_false_after_opt() -> bool with Mut, Panic {
    var w = ph_build_push_pop(0)
    let r = ph_optimize(&w)
    !ph_result_has_nop(&r)
}

pub fn ph_test_mul_not_removed() -> bool with Mut, Panic {
    var w = ph_window_new()
    ph_add_instr(&! w, PH_MUL(), 0, 1, 0)
    let r = ph_optimize(&w)
    r.count == 1
}

pub fn ph_test_div_not_removed() -> bool with Mut, Panic {
    var w = ph_window_new()
    ph_add_instr(&! w, PH_DIV(), 0, 1, 0)
    let r = ph_optimize(&w)
    r.count == 1
}

pub fn ph_test_many_identity_adds() -> bool with Mut, Panic {
    var w = ph_window_new()
    var i: i64 = 0
    while i < 10 {
        ph_add_imm_instr(&! w, PH_ADD(), i, 0)
        i = i + 1
    }
    let r = ph_optimize(&w)
    r.count == 0
}

pub fn ph_test_is_identity_add_not_reg() -> bool {
    // add with src register (not imm) should not count as identity
    let i = ph_instr_new(PH_ADD(), 0, 1, 0)  // no PH_FLAG_USE_IMM
    !ph_is_identity_add(&i)
}

pub fn ph_test_add_imm_instr_stores_imm() -> bool with Mut, Panic {
    var w = ph_window_new()
    ph_add_imm_instr(&! w, PH_ADD(), 0, 42)
    w.instrs[0].imm == 42
}

pub fn ph_test_push_pop_five_regs() -> bool with Mut, Panic {
    var w = ph_window_new()
    ph_add_instr(&! w, PH_PUSH(), 0, PH_NO_REG(), 0)
    ph_add_instr(&! w, PH_POP(),  0, PH_NO_REG(), 0)
    ph_add_instr(&! w, PH_PUSH(), 1, PH_NO_REG(), 0)
    ph_add_instr(&! w, PH_POP(),  1, PH_NO_REG(), 0)
    let r = ph_optimize(&w)
    r.count == 0 && r.optimized == 4
}

pub fn ph_test_opcode_ph_nop_is_12() -> bool {
    PH_NOP() == 12
}

pub fn ph_test_opcode_ph_mov_is_0() -> bool {
    PH_MOV() == 0
}

pub fn ph_test_opcode_ph_ret_is_5() -> bool {
    PH_RET() == 5
}

pub fn ph_test_flag_use_imm_is_1() -> bool {
    PH_FLAG_USE_IMM() == 1
}

pub fn ph_test_flag_removed_is_4() -> bool {
    PH_FLAG_REMOVED() == 4
}

// ============================================================================
// Test runner
// ============================================================================

pub fn ph_run_all_tests() -> i64 with Mut, Panic, Div {
    var pass: i64 = 0
    var fail: i64 = 0

    if ph_test_opcode_constants_distinct() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_window_new_empty() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_add_instr_increments_count() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_add_two_instrs() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_is_nop_move_true() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_is_nop_move_false_diff_regs() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_is_nop_move_false_wrong_opcode() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_is_identity_add_true() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_is_identity_add_false_nonzero() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_is_identity_sub_true() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_is_identity_sub_false_nonzero() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_is_xor_zero_true() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_is_xor_zero_false_diff_regs() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_is_push_true() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_is_pop_true() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_is_push_pop_pair_true() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_is_push_pop_pair_false_diff_reg() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_is_cmp_zero_true() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_is_cmp_zero_false() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_nop_move_removed() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_identity_add_removed() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_identity_sub_removed() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_push_pop_removed() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_xor_cmp_removes_cmp() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_double_mov_removes_first() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_real_move_not_removed() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_real_add_nonzero_not_removed() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_result_no_nop_after_optimize() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_empty_window_gives_empty_result() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_ret_not_removed() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_call_not_removed() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_jmp_not_removed() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_count_opcode_in_result() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_multiple_nop_moves_all_removed() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_mixed_nop_and_real() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_push_pop_diff_regs_not_removed() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_opt_single_nop_move() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_opt_single_real_unchanged() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_opt_pair_push_pop() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_opt_pair_xor_cmp() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_opt_pair_no_opt() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_instr_imm_flag_set() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_instr_new_no_imm_flag() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_nop_instr_is_nop() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_nop_instr_removed_flag() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_window_max_64() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_optimize_single_xor() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_no_reg_constant_is_minus1() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_result_count_zero_initial() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_result_optimized_zero_initial() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_sequence_no_opts() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_xor_cmp_diff_reg_not_removed() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_double_mov_same_imm() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_double_mov_diff_dst() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_is_mov_imm_zero_true() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_is_mov_imm_zero_false() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_result_has_nop_false_after_opt() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_mul_not_removed() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_div_not_removed() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_many_identity_adds() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_is_identity_add_not_reg() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_add_imm_instr_stores_imm() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_push_pop_five_regs() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_opcode_ph_nop_is_12() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_opcode_ph_mov_is_0() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_opcode_ph_ret_is_5() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_flag_use_imm_is_1() { pass = pass + 1 } else { fail = fail + 1 }
    if ph_test_flag_removed_is_4() { pass = pass + 1 } else { fail = fail + 1 }

    pass
}

// ============================================================================
// IR↔PhInstr translation layer (Sprint 65 wiring)
// ============================================================================

// Map one IrInstr to a PhInstr for peephole analysis.
// IrCopy and IrLoadImm map to PH_MOV so self-move and duplicate-load patterns fire.
// IrNop maps to ph_nop_instr (already eliminated).
// All other opcodes map to PH_JMP (opaque pass-through — no rule touches it).
pub fn ir_instr_to_ph(instr: IrInstr) -> PhInstr {
    if instr.op == IrOpcode::IrCopy {
        return ph_instr_new(PH_MOV(), instr.dst, instr.src1, 0)
    }
    if instr.op == IrOpcode::IrLoadImm {
        return ph_instr_imm(PH_MOV(), instr.dst, instr.imm_i64)
    }
    if instr.op == IrOpcode::IrNop {
        return ph_nop_instr()
    }
    ph_instr_new(PH_JMP(), PH_NO_REG(), PH_NO_REG(), 0)
}

// Run the peephole optimizer over an IR function.
// Returns a new IrFunction with eliminated instructions replaced by IrNop.
// Integration point: call after regalloc, before instruction lowering.
//
// Patterns caught at the IR level:
//   IrCopy(r, r)          → IrNop  (self-move; arises when regalloc assigns same preg to both)
//   IrLoadImm(r, _) twice → first IrNop  (duplicate immediate load to same register)
pub fn ph_run_on_func(func: IrFunction) -> IrFunction with Mut, Panic, Div {
    var ph_work: [PhInstr; 128] = [ph_empty_instr(); 128]
    var i: i64 = 0
    while i < func.instr_count {
        ph_work[i as usize] = ir_instr_to_ph(ir_arena_load(ir_region_slot_r(func.region, (i))))
        i = i + 1
    }

    // Pass 1: single-instruction optimizations (identity moves, identity add/sub)
    i = 0
    while i < func.instr_count {
        ph_work[i as usize] = ph_opt_single(ph_work[i as usize])
        i = i + 1
    }

    // Pass 2: pair optimizations (duplicate loads, push/pop pairs, xor/cmp)
    i = 0
    while i < func.instr_count - 1 {
        let a = ph_work[i as usize]
        let b = ph_work[(i + 1) as usize]
        if a.opcode != PH_NOP() && b.opcode != PH_NOP() {
            let pair_result = ph_opt_pair(a, b)
            if pair_result.optimized > 0 {
                ph_work[i as usize]       = pair_result.instrs[0]
                ph_work[(i + 1) as usize] = pair_result.instrs[1]
            }
        }
        i = i + 1
    }

    // Write back: positions optimized to PH_NOP → IrNop
    var out_func = ir_function_clone(&func)
    i = 0
    while i < func.instr_count {
        if ph_work[i as usize].opcode == PH_NOP() {
            ir_arena_store(ir_region_slot_w(out_func.region, (i)), ir_nop())
        }
        i = i + 1
    }
    out_func
}
