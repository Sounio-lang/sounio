// self-hosted::native::codegen — Native x86-64 code generator orchestrator
//
// Phase 1: Full function compilation pipeline.
// Takes an IrModule, compiles each function with proper stack frames,
// emits an entry trampoline, applies relocations, and produces an ELF64 binary.

// ============================================================================
// Label patching for intra-function control flow
// ============================================================================

struct LabelPatch {
    code_offset: i64,       // Position of the rel32 operand to patch
    label_id: i64,          // Target label
}

fn empty_label_patch() -> LabelPatch {
    LabelPatch { code_offset: 0, label_id: -1 }
}

// ============================================================================
// Compiler state
// ============================================================================

struct NativeCompiler {
    code: CodeBuffer,
    relocs: RelocationTable,
    rodata: StringTable,            // String literals for .rodata

    // Module-level: function layout
    fn_offsets: [i64; 64],          // function index -> code buffer offset
    fn_count: i64,

    // Per-function: return jump patching
    return_jumps: [i64; 64],        // positions of jmp rel32 operands
    return_jump_count: i64,

    // Per-function: label tracking for branches
    label_offsets: [i64; 256],      // label_id -> code offset (-1 = undefined)
    label_patches: [LabelPatch; 256],
    label_patch_count: i64,

    // Per-function: frame info
    current_frame_size: i64,
}

fn compiler_new() -> NativeCompiler {
    NativeCompiler {
        code: code_buffer_new(),
        relocs: reloc_table_new(),
        rodata: string_table_new(),
        fn_offsets: [-1; 64],
        fn_count: 0,
        return_jumps: [0; 64],
        return_jump_count: 0,
        label_offsets: [-1; 256],
        label_patches: [empty_label_patch(); 256],
        label_patch_count: 0,
        current_frame_size: 0,
    }
}

// Reset per-function state before compiling a new function
fn reset_function_state(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.return_jump_count = 0
    var i = 0
    while i < 256 {
        c.label_offsets[i as usize] = -1
        i = i + 1
    }
    c.label_patch_count = 0
    c.current_frame_size = 0
    c
}

// ============================================================================
// Stack slot mapping: IR virtual register -> rbp-relative offset
// ============================================================================

// IR virtual register N lives at rbp - (N+1)*8
fn ir_slot_offset(vreg: i64) -> i64 {
    -(vreg + 1) * 8
}

// ============================================================================
// Name comparison helpers
// ============================================================================

fn name_is_main(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 4 { return false }
    if n.buf[0] != 109 { return false }     // 'm'
    if n.buf[1] != 97 { return false }      // 'a'
    if n.buf[2] != 105 { return false }     // 'i'
    if n.buf[3] != 110 { return false }     // 'n'
    true
}

// ============================================================================
// Module compilation
// ============================================================================

fn compile_module(nc: NativeCompiler, module: IrModule) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.fn_count = module.fn_count

    // Pass 1: Compile all functions
    var fi = 0
    while fi < module.fn_count {
        c = compile_ir_function(c, module.functions[fi as usize], fi)
        fi = fi + 1
    }

    // Pass 2: Emit entry trampoline (_start: call main; sys_exit)
    let main_idx = find_main_index(module)
    if main_idx >= 0 {
        c = emit_entry_trampoline(c, main_idx)
    }

    // Pass 3: Apply relocations (function calls + RIP-relative data)
    let text_file_offset = 4096
    let rodata_file_offset = align_page(text_file_offset + c.code.len)
    c.code = apply_relocations(c.relocs, c.code, c.fn_offsets, c.fn_count, rodata_file_offset)

    c
}

// Find the function index for "main"
fn find_main_index(module: IrModule) -> i64 with Mut, Panic, Div {
    var i = 0
    while i < module.fn_count {
        if name_is_main(module.functions[i as usize].name) {
            return i
        }
        i = i + 1
    }
    -1
}

// ============================================================================
// Single function compilation
// ============================================================================

fn compile_ir_function(nc: NativeCompiler, func: IrFunction, fn_index: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = reset_function_state(nc)

    // Record this function's code offset
    c.fn_offsets[fn_index as usize] = c.code.len

    // Compute frame size from virtual register count
    let frame_size = align16(func.reg_count * 8)
    c.current_frame_size = frame_size

    // Emit prologue
    c.code = emit_prologue(c.code, frame_size)

    // Spill parameters from ABI registers to their stack slots
    c = spill_ir_params(c, func)

    // Lower each IR instruction
    var ip = 0
    while ip < func.instr_count {
        c = lower_instr(c, func.instrs[ip as usize])
        ip = ip + 1
    }

    // Record epilogue offset, emit epilogue
    let epilogue_offset = c.code.len
    c.code = emit_epilogue(c.code)

    // Patch all return jumps to point to the epilogue
    c = patch_return_jumps(c, epilogue_offset)

    // Patch all label forward references
    c = patch_label_forwards(c)

    c
}

// Spill parameter registers to their IR-assigned stack slots
fn spill_ir_params(nc: NativeCompiler, func: IrFunction) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    var i = 0
    while i < func.param_count && i < 6 {
        let vreg = func.param_regs[i as usize]
        if vreg >= 0 {
            let preg = param_reg(i)
            let offset = ir_slot_offset(vreg)
            c.code = emit_store_reg_rbp_disp32(c.code, offset, preg)
        }
        i = i + 1
    }
    c
}

// ============================================================================
// Return jump patching
// ============================================================================

fn record_return_jump(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // Emit jmp rel32 placeholder
    let jmp_pos = c.code.len
    c.code = emit_jmp_rel32(c.code)
    // Record the position of the rel32 operand (jmp_pos + 1)
    if c.return_jump_count < 64 {
        c.return_jumps[c.return_jump_count as usize] = jmp_pos + 1
        c.return_jump_count = c.return_jump_count + 1
    }
    c
}

fn patch_return_jumps(nc: NativeCompiler, epilogue_offset: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    var i = 0
    while i < c.return_jump_count {
        let imm_offset = c.return_jumps[i as usize]
        let next_ip = imm_offset + 4
        let rel = epilogue_offset - next_ip
        c.code = patch_u32_le(c.code, imm_offset, rel)
        i = i + 1
    }
    c
}

// ============================================================================
// Label tracking for intra-function control flow
// ============================================================================

fn record_label(nc: NativeCompiler, label_id: i64) -> NativeCompiler with Mut, Panic {
    var c = nc
    if label_id >= 0 && label_id < 256 {
        c.label_offsets[label_id as usize] = c.code.len
    }
    c
}

// Record a forward reference to a label (the rel32 operand position)
fn record_label_patch(nc: NativeCompiler, label_id: i64, rel32_offset: i64) -> NativeCompiler with Mut, Panic {
    var c = nc
    if c.label_patch_count < 256 {
        c.label_patches[c.label_patch_count as usize] = LabelPatch {
            code_offset: rel32_offset,
            label_id: label_id,
        }
        c.label_patch_count = c.label_patch_count + 1
    }
    c
}

fn patch_label_forwards(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    var i = 0
    while i < c.label_patch_count {
        let patch = c.label_patches[i as usize]
        let target = c.label_offsets[patch.label_id as usize]
        if target >= 0 {
            let next_ip = patch.code_offset + 4
            let rel = target - next_ip
            c.code = patch_u32_le(c.code, patch.code_offset, rel)
        }
        i = i + 1
    }
    c
}

// ============================================================================
// Entry trampoline: _start calls main, then sys_exit(rax)
// ============================================================================

fn emit_entry_trampoline(nc: NativeCompiler, main_fn_index: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc

    // Record trampoline offset (this is the ELF entry point)
    let entry_offset = c.code.len

    // call main (placeholder, will be relocated)
    let call_pos = c.code.len
    c.code = emit_call_rel32_placeholder(c.code)
    c.relocs = add_call_reloc(c.relocs, call_pos + 1, main_fn_index)

    // mov rdi, rax (exit code = main's return value)
    c.code = emit_mov_rdi_rax(c.code)

    // mov rax, 60 (sys_exit)
    c.code = emit_mov_rax_imm(c.code, 60)

    // syscall
    c.code = emit_syscall(c.code)

    // ud2 (should never reach here)
    c.code = emit_ud2(c.code)

    c
}

// Get the entry trampoline offset (last function's end = where trampoline starts)
fn trampoline_offset(nc: NativeCompiler, module: IrModule) -> i64 with Mut, Panic, Div {
    // The trampoline is emitted after all functions.
    // We recorded fn_offsets, so the trampoline is at the end of the last function.
    // Actually, it was appended by emit_entry_trampoline, so its offset is
    // the code length minus the trampoline size.
    // For ELF finalization, we need the entry point = start of trampoline.
    // The trampoline is: call(5) + mov(3) + mov_imm(7) + syscall(2) + ud2(2) = 19 bytes
    let tramp_size = 5 + 3 + 7 + 2 + 2
    nc.code.len - tramp_size
}

// ============================================================================
// Full pipeline: IrModule -> ELF64 binary
// ============================================================================

fn compile_to_elf(module: IrModule, base_addr: i64) -> Elf64Binary with Mut, Panic, Div {
    var nc = compiler_new()
    nc = compile_module(nc, module)

    let entry = trampoline_offset(nc, module)
    finalize_elf64(nc.code, nc.rodata, entry, base_addr)
}
