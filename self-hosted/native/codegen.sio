// ============================================================================
// Builtin runtime function emitters (hand-coded x86-64)
// ============================================================================

fn emit_builtin_print_int(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_push_rbp(c.code)
    c.code = emit_mov_rbp_rsp(c.code)
    c.code = emit_sub_rsp_imm32(c.code, 32)

    // --- Negative number handling ---
    // test rdi, rdi; jns +27 (skip negative block to positive preamble)
    c.code = emit_test_rdi_rdi(c.code)                 // 3 bytes
    c.code = emit_jns_rel8(c.code, 27)                 // 2 bytes

    // Negative path: negate rdi, set up buffer with '-', then jump past positive preamble
    c.code = emit_neg_rdi(c.code)                      // 3 bytes
    c.code = emit_mov_reg_reg(c.code, 6, 5)           // mov rsi, rbp  (3)
    c.code = emit_sub_rsi_imm8(c.code, 1)             // sub rsi, 1    (4)
    c.code = emit_xor_rcx_rcx(c.code)                 // xor rcx, rcx  (3)
    c.code = emit_mov_byte_mem_rsi_imm8(c.code, 45)   // '-' at [rsi]  (3)
    c.code = emit_dec_rsi(c.code)                      //               (3)
    c.code = emit_inc_rcx(c.code)                      // count '-'     (3)
    c.code = emit_mov_reg_reg(c.code, 0, 7)           // mov rax, rdi  (3)
    c.code = emit_jmp_rel8(c.code, 13)                 // skip positive preamble (2)
    // negative block total = 3+3+4+3+3+3+3+3+2 = 27 bytes

    // Positive path: standard preamble (13 bytes)
    c.code = emit_mov_reg_reg(c.code, 0, 7)           // mov rax, rdi  (3)
    c.code = emit_mov_reg_reg(c.code, 6, 5)           // mov rsi, rbp  (3)
    c.code = emit_sub_rsi_imm8(c.code, 1)             // sub rsi, 1    (4)
    c.code = emit_xor_rcx_rcx(c.code)                 // xor rcx, rcx  (3)

    // digit loop: 28 bytes body + 2 bytes jnz = 30 bytes total
    c.code = emit_xor_rdx_rdx(c.code)                 // 3
    c.code = emit_mov_reg_imm(c.code, 3, 10)          // 7
    c.code = emit_div_rbx(c.code)                      // 3
    c.code = emit_add_rdx_imm8(c.code, 48)            // 4
    c.code = emit_mov_byte_mem_rsi_dl(c.code)          // 2
    c.code = emit_dec_rsi(c.code)                      // 3
    c.code = emit_inc_rcx(c.code)                      // 3
    c.code = emit_test_rax_rax(c.code)                 // 3
    c.code = emit_jnz_rel8(c.code, -30)               // 75 e2
    c.code = emit_inc_rsi(c.code)
    c.code = emit_mov_reg_reg(c.code, 2, 1)           // mov rdx, rcx
    c.code = emit_mov_rdi_imm(c.code, 1)
    c.code = emit_mov_rax_imm(c.code, 1)
    c.code = emit_syscall(c.code)
    c.code = emit_mov_rsp_rbp(c.code)
    c.code = emit_pop_rbp(c.code)
    c.code = emit_ret(c.code)
    c
}

fn emit_builtin_print_char(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_push_rdi(c.code)
    c.code = emit_mov_rsi_rsp(c.code)
    c.code = emit_mov_reg_imm(c.code, 2, 1)           // mov rdx, 1
    c.code = emit_mov_rdi_imm(c.code, 1)              // mov rdi, 1
    c.code = emit_mov_rax_imm(c.code, 1)              // mov rax, 1
    c.code = emit_syscall(c.code)
    c.code = emit_add_rsp_8(c.code)
    c.code = emit_ret(c.code)
    c
}

fn emit_builtin_print_str(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_push_rbp(c.code)
    c.code = emit_mov_rbp_rsp(c.code)
    c.code = emit_mov_reg_reg(c.code, 6, 7)           // mov rsi, rdi
    c.code = emit_xor_rcx_rcx(c.code)
    // strlen loop: 16 bytes body
    c.code = emit_movzx_rax_byte_rdi(c.code)          // 4
    c.code = emit_test_al_al(c.code)                   // 2
    c.code = emit_jz_rel8(c.code, 8)                   // 2 (skip 3+3+2)
    c.code = emit_inc_rdi(c.code)                      // 3
    c.code = emit_inc_rcx(c.code)                      // 3
    c.code = emit_jmp_rel8(c.code, -16)                // 2
    // done_scan:
    c.code = emit_mov_reg_reg(c.code, 2, 1)           // mov rdx, rcx
    c.code = emit_mov_rdi_imm(c.code, 1)
    c.code = emit_mov_rax_imm(c.code, 1)
    c.code = emit_syscall(c.code)
    c.code = emit_pop_rbp(c.code)
    c.code = emit_ret(c.code)
    c
}

// ============================================================================
// M4: argv access builtins
// ============================================================================

// get_arg_count() -> i64
// Returns argc stored at [r12] (saved by entry trampoline)
fn emit_builtin_get_arg_count(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // mov rax, [r12]  — argc was stored at heap base
    c.code = emit_mov_rax_mem_r12(c.code)
    c.code = emit_ret(c.code)
    c
}

// get_arg(n: i64) -> *u8
// Returns argv[n], where argv base pointer is stored at [r12 + 8]
fn emit_builtin_get_arg(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // rdi = n (index into argv)
    // Load argv base from [r12 + 8]
    c.code = emit_mov_rax_mem_r12_disp8(c.code, 8)
    // Now rax = argv pointer, rdi = n
    // We need rax = [rax + rdi*8]
    c.code = emit_mov_reg_reg(c.code, 3, 7)       // mov rbx, rdi (index n)
    c.code = emit_mov_rax_mem_rax_rbx8(c.code)    // mov rax, [rax + rbx*8]
    c.code = emit_ret(c.code)
    c
}

// str_len(s: *u8) -> i64
// Counts bytes until null terminator
fn emit_builtin_str_len(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // rdi = string pointer
    c.code = emit_xor_rcx_rcx(c.code)             // rcx = 0 (counter)
    // loop body: cmp byte [rdi], 0 (3) + jz +8 (2) + inc rdi (3) + inc rcx (3) + jmp -13 (2) = 13 bytes
    c.code = emit_cmp_byte_rdi_zero(c.code)        // 3 bytes
    c.code = emit_jz_rel8(c.code, 8)               // 2 bytes, skip 3+3+2
    c.code = emit_inc_rdi(c.code)                  // 3 bytes
    c.code = emit_inc_rcx(c.code)                  // 3 bytes
    c.code = emit_jmp_rel8(c.code, -13)            // 2 bytes, jump back to cmp
    // done:
    c.code = emit_mov_reg_reg(c.code, 0, 1)       // mov rax, rcx
    c.code = emit_ret(c.code)
    c
}

// str_eq(a: *u8, b: *u8) -> i64 (1 if equal, 0 if not)
// Byte-by-byte comparison until mismatch or both reach null
fn emit_builtin_str_eq(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // rdi = a, rsi = b
    // loop: load byte from [rdi], compare with byte from [rsi]
    // if mismatch -> return 0
    // if both null -> return 1
    // loop body:
    //   movzx rax, byte [rdi]    — 4 bytes
    //   cmp al, [rsi]            — 2 bytes (3a 06, but we use rsi not rdi)
    //   jne not_equal             — 2 bytes (jnz +offset)
    //   test al, al              — 2 bytes
    //   jz equal                  — 2 bytes (both null -> equal)
    //   inc rdi                  — 3 bytes
    //   inc rsi                  — 3 bytes
    //   jmp loop                 — 2 bytes
    // not_equal:
    //   xor rax, rax; ret
    // equal:
    //   mov rax, 1; ret

    // Layout (byte offsets from loop start):
    //   0:  movzx rax, byte [rdi]  — 4 bytes
    //   4:  cmp al, [rsi]          — 2 bytes
    //   6:  jnz not_equal           — 2 bytes (rel8 = 12, target = 8+12 = 20)
    //   8:  test al, al             — 2 bytes
    //   10: jz equal                — 2 bytes (rel8 = 12, target = 12+12 = 24)
    //   12: inc rdi                 — 3 bytes
    //   15: inc rsi                 — 3 bytes
    //   18: jmp loop                — 2 bytes (rel8 = -20, target = 20-20 = 0)
    //   20: xor rax, rax            — 3 bytes  [not_equal]
    //   23: ret                     — 1 byte
    //   24: mov rax, 1              — 7 bytes  [equal]
    //   31: ret                     — 1 byte

    // loop start:
    c.code = emit_movzx_rax_byte_rdi(c.code)      // 4: movzx rax, byte [rdi]
    // cmp al, [rsi] — 3a 06
    var cb = c.code
    cb = emit_byte(cb, 0x3a)
    cb = emit_byte(cb, 0x06)                       // 2: cmp al, [rsi]
    c.code = cb
    c.code = emit_jnz_rel8(c.code, 12)            // 2: jne not_equal
    c.code = emit_test_al_al(c.code)              // 2: test al, al
    c.code = emit_jz_rel8(c.code, 12)             // 2: jz equal
    c.code = emit_inc_rdi(c.code)                  // 3: inc rdi
    c.code = emit_inc_rsi(c.code)                  // 3: inc rsi
    c.code = emit_jmp_rel8(c.code, -20)            // 2: jmp loop
    // not_equal: xor rax, rax; ret
    c.code = emit_xor_rax_rax(c.code)             // 3
    c.code = emit_ret(c.code)                      // 1
    // equal: mov rax, 1; ret
    c.code = emit_mov_rax_imm(c.code, 1)          // 7
    c.code = emit_ret(c.code)                      // 1
    c
}

// str_slice(s: *u8, start: i64) -> *u8
// Returns s + start (pointer arithmetic — string is null-terminated)
fn emit_builtin_str_slice(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // rdi = string pointer, rsi = start offset
    // result = rdi + rsi
    c.code = emit_add_reg_reg(c.code, 7, 6)  // add rdi, rsi
    c.code = emit_mov_reg_reg(c.code, 0, 7)  // mov rax, rdi
    c.code = emit_ret(c.code)
    c
}

// starts_with(s: *u8, prefix: *u8) -> i64 (1 if starts with, 0 if not)
// Compares prefix against beginning of s until prefix reaches null.
fn emit_builtin_starts_with(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // rdi = s, rsi = prefix
    // Layout:
    //   0:  movzx rax, byte [rsi]    — 4 bytes  (load prefix char)
    //   4:  test al, al               — 2 bytes  (end of prefix?)
    //   6:  jz match                  — 2 bytes  (rel8 = 12, target = 20)
    //   8:  cmp al, [rdi]             — 2 bytes  (compare with s)
    //   10: jnz no_match              — 2 bytes  (rel8 = 16, target = 28)
    //   12: inc rdi                   — 3 bytes
    //   15: inc rsi                   — 3 bytes
    //   18: jmp loop                  — 2 bytes  (rel8 = -20, target = 0)
    //   20: mov rax, 1                — 7 bytes  [match]
    //   27: ret                       — 1 byte
    //   28: xor rax, rax              — 3 bytes  [no_match]
    //   31: ret                       — 1 byte

    // loop:
    c.code = emit_movzx_rax_byte_rsi(c.code)      // 4: movzx rax, byte [rsi]
    c.code = emit_test_al_al(c.code)               // 2: test al, al
    c.code = emit_jz_rel8(c.code, 12)              // 2: jz match (skip 2+2+3+3+2 = 12)
    c.code = emit_cmp_al_mem_rdi(c.code)           // 2: cmp al, [rdi]
    c.code = emit_jnz_rel8(c.code, 16)             // 2: jnz no_match (skip 3+3+2+7+1 = 16)
    c.code = emit_inc_rdi(c.code)                   // 3: inc rdi
    c.code = emit_inc_rsi(c.code)                   // 3: inc rsi
    c.code = emit_jmp_rel8(c.code, -20)             // 2: jmp loop (-20 back to offset 0)
    // match:
    c.code = emit_mov_rax_imm(c.code, 1)           // 7: mov rax, 1
    c.code = emit_ret(c.code)                       // 1
    // no_match:
    c.code = emit_xor_rax_rax(c.code)              // 3
    c.code = emit_ret(c.code)                       // 1
    c
}

// str_concat(a: *u8, b: *u8) -> *u8
// Allocates len_a + len_b + 1 bytes from heap bump pointer (r13),
// copies a then b, null-terminates, returns pointer to new string.
fn emit_builtin_str_concat(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // rdi = a, rsi = b

    // Phase 0: Prologue + save inputs
    c.code = emit_push_rbp(c.code)                     // 1
    c.code = emit_mov_rbp_rsp(c.code)                  // 3
    c.code = emit_sub_rsp_imm32(c.code, 48)            // 7
    c.code = emit_mov_reg_reg(c.code, 0, 7)            // 3: mov rax, rdi
    c.code = emit_store_rax_rbp_disp32(c.code, -8)     // 7: save a at [rbp-8]
    c.code = emit_mov_reg_reg(c.code, 0, 6)            // 3: mov rax, rsi
    c.code = emit_store_rax_rbp_disp32(c.code, -16)    // 7: save b at [rbp-16]

    // Phase 1: Compute len_a (rdi still = a)
    c.code = emit_xor_rcx_rcx(c.code)                  // 3: rcx = 0
    // loop_a:
    c.code = emit_cmp_byte_rdi_zero(c.code)             // 3: cmp byte [rdi], 0
    c.code = emit_jz_rel8(c.code, 8)                    // 2: jz done_a (skip 3+3+2)
    c.code = emit_inc_rdi(c.code)                       // 3
    c.code = emit_inc_rcx(c.code)                       // 3
    c.code = emit_jmp_rel8(c.code, -13)                 // 2: jmp loop_a
    // done_a: rcx = len_a
    c.code = emit_mov_reg_reg(c.code, 0, 1)             // 3: mov rax, rcx
    c.code = emit_store_rax_rbp_disp32(c.code, -24)     // 7: save len_a at [rbp-24]

    // Phase 2: Compute len_b
    c.code = emit_load_rbp_disp32_rax(c.code, -16)      // 7: rax = b
    c.code = emit_mov_rdi_rax(c.code)                    // 3: rdi = b
    c.code = emit_xor_rcx_rcx(c.code)                   // 3: rcx = 0
    // loop_b:
    c.code = emit_cmp_byte_rdi_zero(c.code)              // 3: cmp byte [rdi], 0
    c.code = emit_jz_rel8(c.code, 8)                     // 2: jz done_b
    c.code = emit_inc_rdi(c.code)                        // 3
    c.code = emit_inc_rcx(c.code)                        // 3
    c.code = emit_jmp_rel8(c.code, -13)                  // 2: jmp loop_b
    // done_b: rcx = len_b

    // Phase 3: Allocate from heap (r13 = bump pointer)
    c.code = emit_mov_rax_r13(c.code)                    // 3: rax = current heap ptr (= result)
    c.code = emit_store_rax_rbp_disp32(c.code, -40)      // 7: save result at [rbp-40]
    c.code = emit_load_rbp_disp32_rax(c.code, -24)       // 7: rax = len_a
    c.code = emit_add_reg_reg(c.code, 0, 1)              // 3: rax += rcx (len_b)
    // add rax, 1 — raw: 48 83 c0 01
    var ab = c.code
    ab = emit_byte(ab, 0x48)
    ab = emit_byte(ab, 0x83)
    ab = emit_byte(ab, 0xc0)
    ab = emit_byte(ab, 0x01)
    c.code = ab                                           // 4: rax = total
    c.code = emit_mov_rcx_rax(c.code)                    // 3: rcx = total
    c.code = emit_mov_rax_r13(c.code)                    // 3: rax = old r13
    c.code = emit_add_reg_reg(c.code, 0, 1)              // 3: rax = new r13
    c.code = emit_mov_r13_rax(c.code)                    // 3: r13 = new r13

    // Phase 4: Copy a → result
    c.code = emit_load_rbp_disp32_rax(c.code, -8)        // 7: rax = a
    c.code = emit_mov_rdi_rax(c.code)                     // 3: rdi = a (source)
    c.code = emit_load_rbp_disp32_rax(c.code, -40)       // 7: rax = result
    c.code = emit_mov_rsi_rax(c.code)                     // 3: rsi = result (dest)
    // copy_loop_a:
    c.code = emit_movzx_rax_byte_rdi(c.code)             // 4: movzx rax, byte [rdi]
    c.code = emit_test_al_al(c.code)                      // 2: test al, al
    c.code = emit_jz_rel8(c.code, 13)                     // 2: jz done_copy_a (skip 3+2+3+3+2)
    c.code = emit_mov_reg_reg(c.code, 2, 0)              // 3: mov rdx, rax (dl = byte)
    c.code = emit_mov_byte_mem_rsi_dl(c.code)             // 2: mov [rsi], dl
    c.code = emit_inc_rdi(c.code)                         // 3
    c.code = emit_inc_rsi(c.code)                         // 3
    c.code = emit_jmp_rel8(c.code, -21)                   // 2: jmp copy_loop_a
    // done_copy_a: rsi points past last copied byte

    // Phase 5: Copy b → result (rsi continues from end of a)
    c.code = emit_load_rbp_disp32_rax(c.code, -16)       // 7: rax = b
    c.code = emit_mov_rdi_rax(c.code)                     // 3: rdi = b (source)
    // copy_loop_b:
    c.code = emit_movzx_rax_byte_rdi(c.code)             // 4: movzx rax, byte [rdi]
    c.code = emit_test_al_al(c.code)                      // 2: test al, al
    c.code = emit_jz_rel8(c.code, 13)                     // 2: jz done_copy_b
    c.code = emit_mov_reg_reg(c.code, 2, 0)              // 3: mov rdx, rax
    c.code = emit_mov_byte_mem_rsi_dl(c.code)             // 2: mov [rsi], dl
    c.code = emit_inc_rdi(c.code)                         // 3
    c.code = emit_inc_rsi(c.code)                         // 3
    c.code = emit_jmp_rel8(c.code, -21)                   // 2: jmp copy_loop_b
    // done_copy_b:

    // Phase 6: Null terminate + return
    c.code = emit_mov_byte_mem_rsi_imm8(c.code, 0)       // 3: mov byte [rsi], 0
    c.code = emit_load_rbp_disp32_rax(c.code, -40)       // 7: rax = result ptr
    c.code = emit_mov_rsp_rbp(c.code)                     // 3: epilogue
    c.code = emit_pop_rbp(c.code)                         // 1
    c.code = emit_ret(c.code)                              // 1
    c
}

// ============================================================================
// M5: File I/O builtins
// ============================================================================

// read_file(path: *u8, buf: *u8, max_len: i64) -> i64 (bytes read)
// Uses sys_open, sys_read, sys_close
fn emit_builtin_read_file(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_push_rbp(c.code)
    c.code = emit_mov_rbp_rsp(c.code)
    c.code = emit_sub_rsp_imm32(c.code, 32)

    // Save args: rdi=path, rsi=buf, rdx=max_len
    // Store buf and max_len on stack for later
    c.code = emit_store_reg_rbp_disp32(c.code, -8, 6)    // [rbp-8] = rsi (buf)
    c.code = emit_store_reg_rbp_disp32(c.code, -16, 2)   // [rbp-16] = rdx (max_len)

    // sys_open(path, O_RDONLY=0, 0)
    // rdi already = path
    c.code = emit_mov_reg_imm(c.code, 6, 0)              // rsi = O_RDONLY (0)
    c.code = emit_mov_reg_imm(c.code, 2, 0)              // rdx = mode (0)
    c.code = emit_mov_rax_imm(c.code, 2)                 // sys_open = 2
    c.code = emit_syscall(c.code)

    // Save fd (if open fails, rax < 0, but read will also fail, returning error)
    c.code = emit_store_rax_rbp_disp32(c.code, -24)      // [rbp-24] = fd

    // sys_read(fd, buf, max_len)
    c.code = emit_mov_rdi_rax(c.code)                    // rdi = fd
    c.code = emit_load_rbp_disp32_rax(c.code, -8)        // rax = buf
    c.code = emit_mov_rsi_rax(c.code)                    // rsi = buf
    c.code = emit_load_rbp_disp32_rax(c.code, -16)       // rax = max_len
    c.code = emit_mov_rdx_rax(c.code)                    // rdx = max_len
    c.code = emit_mov_rax_imm(c.code, 0)                 // sys_read = 0
    c.code = emit_syscall(c.code)

    // Save bytes_read
    c.code = emit_store_rax_rbp_disp32(c.code, -32)      // [rbp-32] = bytes_read

    // sys_close(fd)
    c.code = emit_load_rbp_disp32_rax(c.code, -24)       // rax = fd
    c.code = emit_mov_rdi_rax(c.code)                    // rdi = fd
    c.code = emit_mov_rax_imm(c.code, 3)                 // sys_close = 3
    c.code = emit_syscall(c.code)

    // Return bytes_read
    c.code = emit_load_rbp_disp32_rax(c.code, -32)

    c.code = emit_mov_rsp_rbp(c.code)
    c.code = emit_pop_rbp(c.code)
    c.code = emit_ret(c.code)
    c
}

// write_file(path: *u8, buf: *u8, len: i64) -> i64 (bytes written)
// Uses sys_open (O_WRONLY|O_CREAT|O_TRUNC=577), sys_write, sys_close
fn emit_builtin_write_file(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_push_rbp(c.code)
    c.code = emit_mov_rbp_rsp(c.code)
    c.code = emit_sub_rsp_imm32(c.code, 32)

    // Save args: rdi=path, rsi=buf, rdx=len
    c.code = emit_store_reg_rbp_disp32(c.code, -8, 6)    // [rbp-8] = rsi (buf)
    c.code = emit_store_reg_rbp_disp32(c.code, -16, 2)   // [rbp-16] = rdx (len)

    // sys_open(path, O_WRONLY|O_CREAT|O_TRUNC=577, 0644=420)
    // rdi already = path
    c.code = emit_mov_reg_imm(c.code, 6, 577)            // rsi = flags
    c.code = emit_mov_reg_imm(c.code, 2, 493)            // rdx = mode 0755 (executable)
    c.code = emit_mov_rax_imm(c.code, 2)                 // sys_open = 2
    c.code = emit_syscall(c.code)

    // Save fd
    c.code = emit_store_rax_rbp_disp32(c.code, -24)      // [rbp-24] = fd

    // sys_write(fd, buf, len)
    c.code = emit_mov_rdi_rax(c.code)                    // rdi = fd
    c.code = emit_load_rbp_disp32_rax(c.code, -8)        // rax = buf
    c.code = emit_mov_rsi_rax(c.code)                    // rsi = buf
    c.code = emit_load_rbp_disp32_rax(c.code, -16)       // rax = len
    c.code = emit_mov_rdx_rax(c.code)                    // rdx = len
    c.code = emit_mov_rax_imm(c.code, 1)                 // sys_write = 1
    c.code = emit_syscall(c.code)

    // Save bytes_written
    c.code = emit_store_rax_rbp_disp32(c.code, -32)      // [rbp-32] = bytes_written

    // sys_close(fd)
    c.code = emit_load_rbp_disp32_rax(c.code, -24)       // rax = fd
    c.code = emit_mov_rdi_rax(c.code)                    // rdi = fd
    c.code = emit_mov_rax_imm(c.code, 3)                 // sys_close = 3
    c.code = emit_syscall(c.code)

    // Return bytes_written
    c.code = emit_load_rbp_disp32_rax(c.code, -32)

    c.code = emit_mov_rsp_rbp(c.code)
    c.code = emit_pop_rbp(c.code)
    c.code = emit_ret(c.code)
    c
}

// file_size(path: *u8) -> i64
// Uses sys_stat (syscall 4) with 144-byte stat buffer on stack
// st_size is at offset 48 in struct stat
fn emit_builtin_file_size(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_push_rbp(c.code)
    c.code = emit_mov_rbp_rsp(c.code)
    // Allocate 160 bytes for stat buffer (144 + padding for alignment)
    c.code = emit_sub_rsp_imm32(c.code, 160)

    // sys_stat(path, statbuf)
    // rdi already = path
    c.code = emit_lea_rsi_rsp(c.code)                    // rsi = rsp (stat buffer)
    c.code = emit_mov_rax_imm(c.code, 4)                 // sys_stat = 4
    c.code = emit_syscall(c.code)

    // Check for error
    c.code = emit_test_rax_rax(c.code)
    // If error (rax < 0), return -1
    // For simplicity: load st_size regardless, on error it'll be garbage
    // but we can check: if rax != 0, return rax (the error code)
    c.code = emit_jnz_rel8(c.code, 5)                    // if error, skip to return rax
    // Load st_size from [rsp + 48]
    c.code = emit_mov_rax_rsp_disp8(c.code, 48)          // rax = st_size

    c.code = emit_mov_rsp_rbp(c.code)
    c.code = emit_pop_rbp(c.code)
    c.code = emit_ret(c.code)
    c
}

// ============================================================================
// Module compilation
// ============================================================================

fn compile_module(nc: NativeCompiler, module: &IrModule) -> NativeCompiler with Mut, Panic, Div, Alloc {
    var c = nc
    c.fn_count = module.fn_count

    // Pass 1: Compile all functions
    var fi = 0
    while fi < module.fn_count {
        c = compile_ir_function(c, module.functions[fi as usize], fi)
        fi = fi + 1
    }

    // Sprint 45: pre-allocate counter storage in .data (8 bytes per counter)
    // StringTable.bytes is zero-initialized, so counters start at 0
    if module.prof_counter_count > 0 {
        c.data.len = module.prof_counter_count * 8
    }

    // Sprint 46: store profiling counter function names in .rodata
    if module.prof_counter_count > 0 {
        var pi = 0
        while pi < module.prof_counter_count {
            let pc = module.prof_counters[pi as usize]
            c.rodata = string_table_add(c.rodata, pc.fn_name.buf, pc.fn_name.len)
            c.prof_counter_names[pi as usize] = c.rodata.last_offset
            pi = pi + 1
        }
        c.prof_counter_count = module.prof_counter_count

        // Sprint 47: store "profile.sprof" filename in .rodata
        let sprof_name = make_sprof_filename()
        c.rodata = string_table_add(c.rodata, sprof_name.buf, sprof_name.len)
        c.prof_sprof_name_offset = c.rodata.last_offset
    }

    // Sprint 46: emit __prof_dump function (if counters exist)
    if c.prof_counter_count > 0 {
        c.prof_dump_fn_index = c.fn_count
        c.fn_offsets[c.fn_count as usize] = c.code.len
        c.fn_count = c.fn_count + 1
        c = emit_prof_dump_function(c, module)
    }

    // Pass 2: Emit entry trampoline (_start: call main; sys_exit)
    let main_idx = find_main_index(module)
    if main_idx >= 0 {
        c = emit_entry_trampoline(c, main_idx)
    }

    // Pass 3: Apply relocations (function calls + RIP-relative data + .data counters)
    let text_file_offset = 4096
    let rodata_file_offset = align_page(text_file_offset + c.code.len)
    let data_file_offset = if c.data.len > 0 {
        align_page(rodata_file_offset + c.rodata.len)
    } else { 0 }
    c.code = apply_relocations(c.relocs, c.code, c.fn_offsets, c.fn_count, rodata_file_offset, data_file_offset)

    c
}

// Find the function index for "main"
fn find_main_index(module: &IrModule) -> i64 with Mut, Panic, Div {
    var i = 0
    while i < module.fn_count {
        if name_is_main(module.functions[i as usize].name) {
            return i
        }
        i = i + 1
    }
    -1
}

// ============================================================================
// Single function compilation
// ============================================================================

fn compile_ir_function(nc: NativeCompiler, func: IrFunction, fn_index: i64) -> NativeCompiler with Mut, Panic, Div, Alloc {
    var c = reset_function_state(nc)

    // Record this function's code offset and name (for .symtab)
    c.fn_offsets[fn_index as usize] = c.code.len
    c.symbols = symbol_data_add_name(c.symbols, fn_index, func.name.buf, func.name.len)

    // Builtin dispatch — emit hand-coded assembly, skip normal IR lowering
    // M3: print builtins
    if name_is_print_int(func.name) { return emit_builtin_print_int(c) }
    if name_is_print_char(func.name) { return emit_builtin_print_char(c) }
    if name_is_print(func.name) { return emit_builtin_print_str(c) }
    // M4: argv + string builtins
    if name_is_get_arg_count(func.name) { return emit_builtin_get_arg_count(c) }
    if name_is_get_arg(func.name) { return emit_builtin_get_arg(c) }
    if name_is_str_len(func.name) { return emit_builtin_str_len(c) }
    if name_is_str_eq(func.name) { return emit_builtin_str_eq(c) }
    if name_is_str_slice(func.name) { return emit_builtin_str_slice(c) }
    if name_is_starts_with(func.name) { return emit_builtin_starts_with(c) }
    if name_is_str_concat(func.name) { return emit_builtin_str_concat(c) }
    // M5: file I/O builtins
    if name_is_read_file(func.name) { return emit_builtin_read_file(c) }
    if name_is_write_file(func.name) { return emit_builtin_write_file(c) }
    if name_is_file_size(func.name) { return emit_builtin_file_size(c) }

    // Sprint 38: Set compile strategy from IR function metadata
    c.current_strategy = func.compile_strategy

    // Sprint 40: Apply dual-path transformation for Instrumented strategy (Contest<T>/Robust<T>)
    // IR_STRATEGY_INSTRUMENTED (3) triggers ir_opt_apply_strategy(), which rewrites the flat
    // instruction array into a 4-block diamond: dispatch_block → fast_path | instrumented_path → merge_block
    var effective_func = func
    if func.compile_strategy == IR_STRATEGY_INSTRUMENTED {
        effective_func = ir_opt_apply_strategy(func)
    }

    // Compute frame size from virtual register count (expanded by dual-path if applied)
    let frame_size = align16(effective_func.reg_count * 8)
    c.current_frame_size = frame_size

    // Emit prologue
    c.code = emit_prologue(c.code, frame_size)

    // Spill parameters from ABI registers to their stack slots
    c = spill_ir_params(c, effective_func)

    // Lower each IR instruction
    var ip = 0
    while ip < effective_func.instr_count {
        c = lower_instr(c, effective_func.instrs[ip as usize])
        ip = ip + 1
    }

    // Record epilogue offset, emit epilogue
    let epilogue_offset = c.code.len
    c.code = emit_epilogue(c.code)

    // Patch all return jumps to point to the epilogue
    c = patch_return_jumps(c, epilogue_offset)

    // Patch all label forward references
    c = patch_label_forwards(c)

    c
}

// Spill parameter registers to their IR-assigned stack slots
fn spill_ir_params(nc: NativeCompiler, func: IrFunction) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    var i = 0
    while i < func.param_count && i < 6 {
        let vreg = func.param_regs[i as usize]
        if vreg >= 0 {
            let preg = param_reg(i)
            let offset = ir_slot_offset(vreg)
            c.code = emit_store_reg_rbp_disp32(c.code, offset, preg)
        }
        i = i + 1
    }
    c
}

// ============================================================================
// Sprint 46: Profiling counter dump helpers
// ============================================================================

// Write "[prof] " (7 bytes) to stderr via immediate stack construction
fn emit_prof_write_prefix(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // mov dword [rsp], 0x6f72705b  — "[pro" in little-endian
    // C7 44 24 00 5b 70 72 6f
    c.code = emit_byte(c.code, 0xC7)
    c.code = emit_byte(c.code, 0x44)
    c.code = emit_byte(c.code, 0x24)
    c.code = emit_byte(c.code, 0x00)
    c.code = emit_byte(c.code, 0x5B)   // '['
    c.code = emit_byte(c.code, 0x70)   // 'p'
    c.code = emit_byte(c.code, 0x72)   // 'r'
    c.code = emit_byte(c.code, 0x6F)   // 'o'
    // mov word [rsp+4], 0x5d66  — "f]" in little-endian
    // 66 C7 44 24 04 66 5d
    c.code = emit_byte(c.code, 0x66)
    c.code = emit_byte(c.code, 0xC7)
    c.code = emit_byte(c.code, 0x44)
    c.code = emit_byte(c.code, 0x24)
    c.code = emit_byte(c.code, 0x04)
    c.code = emit_byte(c.code, 0x66)   // 'f'
    c.code = emit_byte(c.code, 0x5D)   // ']'
    // mov byte [rsp+6], 0x20  — " "
    // C6 44 24 06 20
    c.code = emit_byte(c.code, 0xC6)
    c.code = emit_byte(c.code, 0x44)
    c.code = emit_byte(c.code, 0x24)
    c.code = emit_byte(c.code, 0x06)
    c.code = emit_byte(c.code, 0x20)   // ' '
    // sys_write(2, rsp, 7)
    c.code = emit_mov_rsi_rsp(c.code)        // rsi = rsp (buffer)
    c.code = emit_mov_reg_imm(c.code, 2, 7)  // rdx = 7
    c.code = emit_mov_rdi_imm(c.code, 2)     // rdi = 2 (stderr)
    c.code = emit_mov_rax_imm(c.code, 1)     // rax = 1 (sys_write)
    c.code = emit_syscall(c.code)
    c
}

// Write ": " (2 bytes) to stderr via immediate stack construction
fn emit_prof_write_colon_sep(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // mov word [rsp], 0x203a  — ": " in little-endian
    // 66 C7 44 24 00 3a 20
    c.code = emit_byte(c.code, 0x66)
    c.code = emit_byte(c.code, 0xC7)
    c.code = emit_byte(c.code, 0x44)
    c.code = emit_byte(c.code, 0x24)
    c.code = emit_byte(c.code, 0x00)
    c.code = emit_byte(c.code, 0x3A)   // ':'
    c.code = emit_byte(c.code, 0x20)   // ' '
    // sys_write(2, rsp, 2)
    c.code = emit_mov_rsi_rsp(c.code)
    c.code = emit_mov_reg_imm(c.code, 2, 2)  // rdx = 2
    c.code = emit_mov_rdi_imm(c.code, 2)     // rdi = stderr
    c.code = emit_mov_rax_imm(c.code, 1)     // sys_write
    c.code = emit_syscall(c.code)
    c
}

// Write "\n" (1 byte) to stderr via immediate stack construction
fn emit_prof_write_newline(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // mov byte [rsp], 0x0a  — "\n"
    // C6 44 24 00 0a
    c.code = emit_byte(c.code, 0xC6)
    c.code = emit_byte(c.code, 0x44)
    c.code = emit_byte(c.code, 0x24)
    c.code = emit_byte(c.code, 0x00)
    c.code = emit_byte(c.code, 0x0A)   // '\n'
    // sys_write(2, rsp, 1)
    c.code = emit_mov_rsi_rsp(c.code)
    c.code = emit_mov_reg_imm(c.code, 2, 1)  // rdx = 1
    c.code = emit_mov_rdi_imm(c.code, 2)     // rdi = stderr
    c.code = emit_mov_rax_imm(c.code, 1)     // sys_write
    c.code = emit_syscall(c.code)
    c
}

// Inline strlen: rsi = string pointer, sets rcx = length (preserves rsi)
fn emit_inline_strlen(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_mov_reg_reg(c.code, 7, 6)     // mov rdi, rsi (work on rdi, preserve rsi)
    c.code = emit_xor_rcx_rcx(c.code)            // rcx = 0
    // loop body: 16 bytes total
    c.code = emit_movzx_rax_byte_rdi(c.code)     // 4: movzx rax, byte [rdi]
    c.code = emit_test_al_al(c.code)              // 2: test al, al
    c.code = emit_jz_rel8(c.code, 8)              // 2: jz +8 (skip inc+inc+jmp = 3+3+2)
    c.code = emit_inc_rdi(c.code)                 // 3: inc rdi
    c.code = emit_inc_rcx(c.code)                 // 3: inc rcx
    c.code = emit_jmp_rel8(c.code, -16)           // 2: jmp -16 (back to movzx)
    c
}

// Inline itoa + sys_write to stderr: rdi = value (non-negative i64)
// Uses rbp-relative stack buffer (sub rsp, 48 assumed by caller)
// Same div-by-10 algorithm as emit_builtin_print_int but fd=2 and no negative handling
fn emit_inline_itoa_stderr(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // rdi = value to print
    c.code = emit_mov_reg_reg(c.code, 0, 7)      // mov rax, rdi
    // rsi = rbp - 1 (buffer end, within the 48-byte stack frame)
    c.code = emit_mov_reg_reg(c.code, 6, 5)      // mov rsi, rbp
    c.code = emit_sub_rsi_imm8(c.code, 1)         // sub rsi, 1
    c.code = emit_xor_rcx_rcx(c.code)             // rcx = 0 (digit count)

    // Handle zero case: if rax == 0, emit single '0'
    c.code = emit_test_rax_rax(c.code)             // 3 bytes
    // jnz +15 (skip zero path: mov_byte(3) + mov_rcx_1(10) + jmp(2) = 15)
    c.code = emit_jnz_rel8(c.code, 15)            // 2 bytes
    // Zero path
    c.code = emit_mov_byte_mem_rsi_imm8(c.code, 48)  // [rsi] = '0'  — 3 bytes
    c.code = emit_mov_reg_imm(c.code, 1, 1)          // rcx = 1      — 10 bytes
    c.code = emit_jmp_rel8(c.code, 28)                // skip digit loop — 2 bytes
    // jmp target: 28 bytes ahead = the digit loop body (30 bytes) minus the 2-byte jnz at end

    // Digit loop: 30 bytes body
    let loop_top = c.code.len
    c.code = emit_xor_rdx_rdx(c.code)                // 3: xor rdx, rdx
    c.code = emit_mov_reg_imm(c.code, 3, 10)         // 10: mov rbx, 10
    c.code = emit_div_rbx(c.code)                     // 3: div rbx (rax=quot, rdx=rem)
    c.code = emit_add_rdx_imm8(c.code, 48)           // 4: add rdx, '0'
    c.code = emit_mov_byte_mem_rsi_dl(c.code)         // 2: mov [rsi], dl
    c.code = emit_dec_rsi(c.code)                     // 3: dec rsi
    c.code = emit_inc_rcx(c.code)                     // 3: inc rcx
    c.code = emit_test_rax_rax(c.code)                // 3: test rax, rax
    let loop_end = c.code.len
    let loop_body_size = loop_end - loop_top          // should be ~31 bytes
    c.code = emit_jnz_rel8(c.code, -(loop_body_size + 2))  // 2: jnz back (body + 2 for jnz itself)
    // After loop: rsi points one before first digit
    c.code = emit_inc_rsi(c.code)                     // 3: inc rsi (point to first digit)

    // sys_write(2, rsi, rcx)
    c.code = emit_mov_reg_reg(c.code, 2, 1)      // mov rdx, rcx (length)
    c.code = emit_mov_rdi_imm(c.code, 2)          // rdi = 2 (stderr)
    c.code = emit_mov_rax_imm(c.code, 1)          // rax = 1 (sys_write)
    c.code = emit_syscall(c.code)
    c
}

// ============================================================================
// Sprint 47: .sprof file output helpers
// ============================================================================

// Build a Name containing "profile.sprof" (13 bytes)
fn make_sprof_filename() -> Name with Mut, Panic, Div {
    var n = empty_name()
    // p=112 r=114 o=111 f=102 i=105 l=108 e=101 .=46 s=115 p=112 r=114 o=111 f=102
    n.buf[0] = 112 as i8     // 'p'
    n.buf[1] = 114 as i8     // 'r'
    n.buf[2] = 111 as i8     // 'o'
    n.buf[3] = 102 as i8     // 'f'
    n.buf[4] = 105 as i8     // 'i'
    n.buf[5] = 108 as i8     // 'l'
    n.buf[6] = 101 as i8     // 'e'
    n.buf[7] = 46 as i8      // '.'
    n.buf[8] = 115 as i8     // 's'
    n.buf[9] = 112 as i8     // 'p'
    n.buf[10] = 114 as i8    // 'r'
    n.buf[11] = 111 as i8    // 'o'
    n.buf[12] = 102 as i8    // 'f'
    n.len = 13
    n
}

// Write "[sprof]\n" header (8 bytes) to fd via immediate stack construction
// fd is in r12
fn emit_prof_write_sprof_header(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // mov dword [rsp], 0x7270735b  — "[spr" in little-endian
    // C7 44 24 00 5b 73 70 72
    c.code = emit_byte(c.code, 0xC7)
    c.code = emit_byte(c.code, 0x44)
    c.code = emit_byte(c.code, 0x24)
    c.code = emit_byte(c.code, 0x00)
    c.code = emit_byte(c.code, 0x5B)   // '['
    c.code = emit_byte(c.code, 0x73)   // 's'
    c.code = emit_byte(c.code, 0x70)   // 'p'
    c.code = emit_byte(c.code, 0x72)   // 'r'
    // mov dword [rsp+4], 0x0a5d666f  — "of]\n" in little-endian
    // C7 44 24 04 6f 66 5d 0a
    c.code = emit_byte(c.code, 0xC7)
    c.code = emit_byte(c.code, 0x44)
    c.code = emit_byte(c.code, 0x24)
    c.code = emit_byte(c.code, 0x04)
    c.code = emit_byte(c.code, 0x6F)   // 'o'
    c.code = emit_byte(c.code, 0x66)   // 'f'
    c.code = emit_byte(c.code, 0x5D)   // ']'
    c.code = emit_byte(c.code, 0x0A)   // '\n'
    // sys_write(r12, rsp, 8)
    c.code = emit_mov_rsi_rsp(c.code)        // rsi = rsp (buffer)
    c.code = emit_mov_reg_imm(c.code, 2, 8)  // rdx = 8
    c.code = emit_mov_rdi_r12(c.code)         // rdi = r12 (fd)
    c.code = emit_mov_rax_imm(c.code, 1)     // rax = 1 (sys_write)
    c.code = emit_syscall(c.code)
    c
}

// Write " " (1 byte, space separator) to fd in r12 via immediate stack construction
fn emit_prof_write_space_to_fd(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // mov byte [rsp], 0x20  — " "
    c.code = emit_byte(c.code, 0xC6)
    c.code = emit_byte(c.code, 0x44)
    c.code = emit_byte(c.code, 0x24)
    c.code = emit_byte(c.code, 0x00)
    c.code = emit_byte(c.code, 0x20)   // ' '
    // sys_write(r12, rsp, 1)
    c.code = emit_mov_rsi_rsp(c.code)
    c.code = emit_mov_reg_imm(c.code, 2, 1)  // rdx = 1
    c.code = emit_mov_rdi_r12(c.code)         // rdi = r12 (fd)
    c.code = emit_mov_rax_imm(c.code, 1)     // sys_write
    c.code = emit_syscall(c.code)
    c
}

// Write "\n" (1 byte) to fd in r12 via immediate stack construction
fn emit_prof_write_newline_to_fd(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // mov byte [rsp], 0x0a  — "\n"
    c.code = emit_byte(c.code, 0xC6)
    c.code = emit_byte(c.code, 0x44)
    c.code = emit_byte(c.code, 0x24)
    c.code = emit_byte(c.code, 0x00)
    c.code = emit_byte(c.code, 0x0A)   // '\n'
    // sys_write(r12, rsp, 1)
    c.code = emit_mov_rsi_rsp(c.code)
    c.code = emit_mov_reg_imm(c.code, 2, 1)  // rdx = 1
    c.code = emit_mov_rdi_r12(c.code)         // rdi = r12 (fd)
    c.code = emit_mov_rax_imm(c.code, 1)     // sys_write
    c.code = emit_syscall(c.code)
    c
}

// itoa (rdi = value) + sys_write to fd in r12 (same algorithm as emit_inline_itoa_stderr but fd=r12)
fn emit_inline_itoa_fd(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // rdi = value to print
    c.code = emit_mov_reg_reg(c.code, 0, 7)      // mov rax, rdi
    // rsi = rbp - 1 (buffer end, within the 48-byte stack frame)
    c.code = emit_mov_reg_reg(c.code, 6, 5)      // mov rsi, rbp
    c.code = emit_sub_rsi_imm8(c.code, 1)         // sub rsi, 1
    c.code = emit_xor_rcx_rcx(c.code)             // rcx = 0 (digit count)

    // Handle zero case: if rax == 0, emit single '0'
    c.code = emit_test_rax_rax(c.code)             // 3 bytes
    // jnz +15 (skip zero path: mov_byte(3) + mov_rcx_1(10) + jmp(2) = 15)
    c.code = emit_jnz_rel8(c.code, 15)            // 2 bytes
    // Zero path
    c.code = emit_mov_byte_mem_rsi_imm8(c.code, 48)  // [rsi] = '0'  — 3 bytes
    c.code = emit_mov_reg_imm(c.code, 1, 1)          // rcx = 1      — 10 bytes
    c.code = emit_jmp_rel8(c.code, 28)                // skip digit loop — 2 bytes

    // Digit loop
    let loop_top = c.code.len
    c.code = emit_xor_rdx_rdx(c.code)                // 3: xor rdx, rdx
    c.code = emit_mov_reg_imm(c.code, 3, 10)         // 10: mov rbx, 10
    c.code = emit_div_rbx(c.code)                     // 3: div rbx (rax=quot, rdx=rem)
    c.code = emit_add_rdx_imm8(c.code, 48)           // 4: add rdx, '0'
    c.code = emit_mov_byte_mem_rsi_dl(c.code)         // 2: mov [rsi], dl
    c.code = emit_dec_rsi(c.code)                     // 3: dec rsi
    c.code = emit_inc_rcx(c.code)                     // 3: inc rcx
    c.code = emit_test_rax_rax(c.code)                // 3: test rax, rax
    let loop_end = c.code.len
    let loop_body_size = loop_end - loop_top
    c.code = emit_jnz_rel8(c.code, -(loop_body_size + 2))  // 2: jnz back
    // After loop: rsi points one before first digit
    c.code = emit_inc_rsi(c.code)                     // 3: inc rsi

    // sys_write(r12, rsi, rcx)
    c.code = emit_mov_reg_reg(c.code, 2, 1)      // mov rdx, rcx (length)
    c.code = emit_mov_rdi_r12(c.code)              // rdi = r12 (fd)
    c.code = emit_mov_rax_imm(c.code, 1)          // rax = 1 (sys_write)
    c.code = emit_syscall(c.code)
    c
}

// Emit the __prof_dump function: reads counters from .data, writes summary to stderr
// Unrolled: one block per counter, no runtime loop variable needed
fn emit_prof_dump_function(nc: NativeCompiler, module: &IrModule) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_push_rbp(c.code)
    c.code = emit_mov_rbp_rsp(c.code)
    c.code = emit_sub_rsp_imm32(c.code, 48)    // stack buffer for itoa + immediate strings

    var ci = 0
    while ci < c.prof_counter_count {
        // --- Write "[prof] " (7 bytes) from immediate stack construction ---
        c = emit_prof_write_prefix(c)

        // --- Write function name from .rodata ---
        let name_rodata_offset = c.prof_counter_names[ci as usize]
        let lea_pos = c.code.len + 3     // disp32 is at byte 3 of LEA instruction
        c.code = emit_lea_rax_rip_disp32(c.code, 0)  // placeholder disp32
        c.relocs = add_rip_reloc(c.relocs, lea_pos, name_rodata_offset)
        // rax = pointer to name string in .rodata
        c.code = emit_mov_reg_reg(c.code, 6, 0)      // mov rsi, rax
        c = emit_inline_strlen(c)                      // rcx = length, rsi preserved
        // sys_write(2, rsi, rcx)
        c.code = emit_mov_reg_reg(c.code, 2, 1)      // mov rdx, rcx
        c.code = emit_mov_rdi_imm(c.code, 2)          // fd = stderr
        c.code = emit_mov_rax_imm(c.code, 1)          // sys_write
        c.code = emit_syscall(c.code)

        // --- Write ": " (2 bytes) from immediate stack construction ---
        c = emit_prof_write_colon_sep(c)

        // --- Load counter value from .data, itoa, write ---
        let counter_id = module.prof_counters[ci as usize].counter_id
        let load_disp_pos = c.code.len + 3  // disp32 at byte 3 of MOV [rip+disp32]
        c.code = emit_mov_rax_rip_disp32(c.code, 0)   // placeholder disp32
        c.relocs = add_data_section_reloc(c.relocs, load_disp_pos, counter_id * 8)
        // rax = counter value
        c.code = emit_mov_rdi_rax(c.code)              // rdi = counter value
        c = emit_inline_itoa_stderr(c)                  // itoa + sys_write(2, ...)

        // --- Write "\n" (1 byte) ---
        c = emit_prof_write_newline(c)

        ci = ci + 1
    }

    // Sprint 47: write .sprof file (persistent profile output)
    // Save r12 (callee-saved, holds heap base from trampoline)
    c.code = emit_push_r12(c.code)

    // sys_open("profile.sprof", O_WRONLY|O_CREAT|O_TRUNC=577, 0644=420)
    let sprof_lea_pos = c.code.len + 3
    c.code = emit_lea_rax_rip_disp32(c.code, 0)     // placeholder → .rodata "profile.sprof"
    c.relocs = add_rip_reloc(c.relocs, sprof_lea_pos, c.prof_sprof_name_offset)
    c.code = emit_mov_rdi_rax(c.code)                // rdi = filename pointer
    c.code = emit_mov_reg_imm(c.code, 6, 577)        // rsi = O_WRONLY|O_CREAT|O_TRUNC
    c.code = emit_mov_reg_imm(c.code, 2, 420)        // rdx = 0644
    c.code = emit_mov_rax_imm(c.code, 2)             // rax = sys_open
    c.code = emit_syscall(c.code)
    c.code = emit_mov_r12_rax(c.code)                // r12 = file fd

    // Write "[sprof]\n" header to file
    c = emit_prof_write_sprof_header(c)

    // Write per-counter lines: "fn_name count\n" to file
    var fi = 0
    while fi < c.prof_counter_count {
        // --- Write function name from .rodata to file ---
        let fn_rodata_offset = c.prof_counter_names[fi as usize]
        let fn_lea_pos = c.code.len + 3
        c.code = emit_lea_rax_rip_disp32(c.code, 0)  // placeholder
        c.relocs = add_rip_reloc(c.relocs, fn_lea_pos, fn_rodata_offset)
        c.code = emit_mov_reg_reg(c.code, 6, 0)      // mov rsi, rax
        c = emit_inline_strlen(c)                      // rcx = length
        c.code = emit_mov_reg_reg(c.code, 2, 1)      // mov rdx, rcx
        c.code = emit_mov_rdi_r12(c.code)              // rdi = r12 (file fd)
        c.code = emit_mov_rax_imm(c.code, 1)          // sys_write
        c.code = emit_syscall(c.code)

        // --- Write " " (space separator) to file ---
        c = emit_prof_write_space_to_fd(c)

        // --- Load counter value, itoa, write to file ---
        let file_counter_id = module.prof_counters[fi as usize].counter_id
        let file_load_pos = c.code.len + 3
        c.code = emit_mov_rax_rip_disp32(c.code, 0)   // placeholder
        c.relocs = add_data_section_reloc(c.relocs, file_load_pos, file_counter_id * 8)
        c.code = emit_mov_rdi_rax(c.code)              // rdi = counter value
        c = emit_inline_itoa_fd(c)                      // itoa + sys_write(r12, ...)

        // --- Write "\n" to file ---
        c = emit_prof_write_newline_to_fd(c)

        fi = fi + 1
    }

    // sys_close(r12)
    c.code = emit_mov_rdi_r12(c.code)                 // rdi = fd
    c.code = emit_mov_rax_imm(c.code, 3)              // rax = sys_close
    c.code = emit_syscall(c.code)

    // Restore r12 (heap base)
    c.code = emit_pop_r12(c.code)

    c.code = emit_mov_rsp_rbp(c.code)
    c.code = emit_pop_rbp(c.code)
    c.code = emit_ret(c.code)
    c
}

// ============================================================================
// Entry trampoline: _start calls main, then sys_exit(rax)
// ============================================================================

fn emit_entry_trampoline(nc: NativeCompiler, main_fn_index: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc

    // Record trampoline offset (this is the ELF entry point)
    c.entry_offset = c.code.len

    // M4: Save original stack pointer for argc/argv access BEFORE mmap
    // At _start, [rsp] = argc, [rsp+8] = argv[0], [rsp+16] = argv[1], ...
    c.code = emit_mov_r14_rsp(c.code)             // mov r14, rsp (save original rsp)

    // mmap anonymous heap: sys_mmap(NULL, 512MB, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0)
    // 512MB is sufficient for full self-hosted compiler runs with large IR data structures
    c.code = emit_mov_rax_imm(c.code, 9)           // sys_mmap = 9
    c.code = emit_mov_rdi_imm(c.code, 0)           // addr = NULL
    c.code = emit_mov_reg_imm(c.code, 6, 536870912) // len = 512MB
    c.code = emit_mov_reg_imm(c.code, 2, 3)       // prot = PROT_READ|PROT_WRITE
    // syscall ABI uses: rdi, rsi, rdx, r10, r8, r9 (NOT rcx for arg4)
    c.code = emit_mov_r10_imm32(c.code, 34)       // r10 = flags = MAP_PRIVATE|MAP_ANONYMOUS (0x22)
    c.code = emit_mov_r8_imm32(c.code, -1)        // r8 = fd = -1
    c.code = emit_mov_r9_imm32(c.code, 0)         // r9 = offset = 0
    c.code = emit_syscall(c.code)

    // rax = heap base pointer
    c.code = emit_mov_r12_rax(c.code)             // r12 = heap base
    c.code = emit_mov_r13_rax(c.code)             // r13 = heap bump pointer (starts at base)

    // M4: Store argc and argv at heap[0] and heap[8]
    c.code = emit_mov_rax_mem_r14(c.code)          // rax = [r14] = argc
    c.code = emit_mov_mem_r12_rax(c.code)          // [r12] = argc
    c.code = emit_lea_rax_r14_disp8(c.code, 8)    // rax = r14 + 8 = argv pointer
    c.code = emit_mov_mem_r12_disp8_rax(c.code, 8) // [r12 + 8] = argv
    c.code = emit_add_r13_imm8(c.code, 16)        // r13 += 16 (bump past argc/argv)

    // AVX10.2-aware capability guard: abort (exit 200) if CPU lacks any vector support.
    // emit_avx10_detect probes leaf 7.1 EDX[19] for AVX10, falls back to leaf 7.0
    // EBX[16] for legacy AVX-512F CPUs.  Sets r15 = VL capability mask:
    //   bit0=128-bit, bit1=256-bit, bit2=512-bit (persistent across call to main).
    // Returns rax = 1 if any vector support detected, 0 otherwise.
    c.code = emit_avx10_detect(c.code)
    c.code = emit_test_rax_rax(c.code)
    let avx_jnz = c.code.len
    c.code = emit_jnz_rel32(c.code)           // JNZ past the no-vector abort block
    c.code = emit_mov_rdi_imm(c.code, 200)    // exit code 200 = no vector support
    c.code = emit_mov_rax_imm(c.code, 60)     // sys_exit
    c.code = emit_syscall(c.code)
    let avx_ok = c.code.len
    c.code = patch_u32_le(c.code, avx_jnz + 2, avx_ok - (avx_jnz + 6))

    // call main (placeholder, will be relocated)
    let call_pos = c.code.len
    c.code = emit_call_rel32_placeholder(c.code)
    c.relocs = add_call_reloc(c.relocs, call_pos + 1, main_fn_index)

    // mov rdi, rax (exit code = main's return value)
    c.code = emit_mov_rdi_rax(c.code)

    // Sprint 46: call __prof_dump if counters exist (preserves rdi = exit code)
    if c.prof_counter_count > 0 {
        c.code = emit_push_rdi(c.code)       // save exit code
        let dump_call_pos = c.code.len
        c.code = emit_call_rel32_placeholder(c.code)
        c.relocs = add_call_reloc(c.relocs, dump_call_pos + 1, c.prof_dump_fn_index)
        c.code = emit_pop_rdi(c.code)        // restore exit code
    }

    // mov rax, 60 (sys_exit)
    c.code = emit_mov_rax_imm(c.code, 60)

    // syscall
    c.code = emit_syscall(c.code)

    // ud2 (should never reach here)
    c.code = emit_ud2(c.code)

    c
}

// Get the entry trampoline offset (recorded during emit_entry_trampoline)
fn trampoline_offset(nc: NativeCompiler) -> i64 {
    nc.entry_offset
}

// ============================================================================
// Full pipeline: IrModule -> ELF64 binary
// ============================================================================

fn compile_to_macho_arm64_placeholder(module: &IrModule, target_spec: NativeTargetSpec) -> NativeCompileResult {
    let _module = module
    let _target = target_spec
    native_compile_result_error(ERR_BACKEND_NOT_IMPLEMENTED(), "backend_not_implemented:aarch64-macos")
}

fn compile_to_elf_riscv_placeholder(module: &IrModule, target_spec: NativeTargetSpec) -> NativeCompileResult {
    let _module = module
    let _target = target_spec
    native_compile_result_error(ERR_BACKEND_NOT_IMPLEMENTED(), "backend_not_implemented:riscv64-linux")
}

fn compile_native(module: &IrModule, target_spec: NativeTargetSpec) -> NativeCompileResult with Mut, Panic, Div, Alloc {
    if target_spec.matrix_mode < 0 {
        return native_compile_result_error(ERR_INVALID_MATRIX(), "invalid_matrix")
    }

    if target_spec.arch_id == ARCH_X86_64() && target_spec.os_id == OS_LINUX() {
        let base_addr: i64 = 4194304  // 0x400000
        let elf = compile_to_elf(module, base_addr)
        return native_compile_result_ok(elf.bytes, elf.len, FORMAT_ELF64())
    }

    if target_spec.arch_id == ARCH_AARCH64() && target_spec.os_id == OS_MACOS() {
        return compile_to_macho_arm64_placeholder(module, target_spec)
    }

    if target_spec.arch_id == ARCH_RISCV64() && target_spec.os_id == OS_LINUX() {
        return compile_to_elf_riscv_placeholder(module, target_spec)
    }

    native_compile_result_error(ERR_INVALID_TARGET(), "invalid_target")
}

fn compile_to_elf(module: &IrModule, base_addr: i64) -> Elf64Binary with Mut, Panic, Div, Alloc {
    var nc = compiler_new()
    nc = compile_module(nc, module)

    let entry = trampoline_offset(nc)
    finalize_elf64(nc.code, nc.rodata, nc.data, entry, base_addr, nc.symbols, nc.fn_offsets, nc.fn_count)
}
