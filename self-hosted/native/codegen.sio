// self-hosted::native::codegen — Native x86-64 code generator orchestrator
//
// Phase 1: Full function compilation pipeline.
// Takes an IrModule, compiles each function with proper stack frames,
// emits an entry trampoline, applies relocations, and produces an ELF64 binary.

module native::codegen

use parser::ast::{Name}
use ir::ir::{IrModule, IrFunction, IrInstr, IrOpcode, IR_MAX_FUNCS, IR_MAX_STRINGS, BSS_BASE_LINUX, IR_STRATEGY_BSS_GLOBAL}
use native::encode::*
use native::aarch64::*
use native::elf::*
use native::macho::*
use native::pe_coff::*
use native::reloc::*
use native::frame::*
use native::lower_ir::{lower_instr, nc_run_regalloc, nc_min_frame_size, emit_binop_code, emit_float_binop_code}
use native::machine_ir::*
use native::peephole::{ph_run_on_func}
use native::regalloc::*
use native::regs::{param_reg}
use native::gc::*
use native::runtime_context::*
use native::stack_maps::*
use native::target_policy::*
// Sprint 40: IR-level dual-path transformation for Instrumented strategy
use ir::opt_strategy::{ir_opt_apply_strategy}
// io::trace is a lightweight extraction of io::file_write's trace helpers.
// Importing io::file_write directly causes type-checker stack overflow due to
// its transitive imports (parser::ast::*, lexer::*, native::encode::*) combined
// with the 18 native:: module imports already present here (~2000+ symbols).
use io::trace::{io_trace_append_byte, io_trace_append_string, io_trace_append_json_string, io_trace_bool_string, io_trace_i64_string, io_write_bytes_to_file}
use io::env::{read_env}
// Note: native::avx512 EVEX emitters are available in native/avx512.sio.
// They will be wired into the lowering pass in Horizon 3.2 (vector IR ops).

// ============================================================================
// Native dispatcher contracts (Sprint 1)
// ============================================================================

fn ARCH_UNKNOWN() -> i64 { native_policy_arch_unknown() }
pub fn ARCH_X86_64() -> i64 { native_policy_arch_x86_64() }
fn ARCH_AARCH64() -> i64 { native_policy_arch_aarch64() }
fn ARCH_RISCV64() -> i64 { native_policy_arch_riscv64() }

fn OS_UNKNOWN() -> i64 { native_policy_os_unknown() }
pub fn OS_LINUX() -> i64 { native_policy_os_linux() }
fn OS_MACOS() -> i64 { native_policy_os_macos() }
fn OS_WINDOWS() -> i64 { native_policy_os_windows() }

fn MATRIX_AUTO() -> i64 { 0 }
fn MATRIX_OFF() -> i64 { 1 }
fn MATRIX_APPLE_AMX() -> i64 { 2 }
fn MATRIX_INTEL_AMX() -> i64 { 3 }
fn MATRIX_IME() -> i64 { 4 }
fn MATRIX_VME() -> i64 { 5 }
fn MATRIX_AME() -> i64 { 6 }

fn FORMAT_NONE() -> i64 { 0 }
pub fn FORMAT_ELF64() -> i64 { 1 }
fn FORMAT_MACHO64() -> i64 { 2 }
fn FORMAT_PE64() -> i64 { 3 }

pub fn ERR_OK() -> i64 { 0 }
pub fn ERR_BACKEND_NOT_IMPLEMENTED() -> i64 { 1 }
fn ERR_INVALID_TARGET() -> i64 { 2 }
fn ERR_INVALID_MATRIX() -> i64 { 3 }

fn TARGET_SOURCE_UNKNOWN() -> i64 { 0 }
fn TARGET_SOURCE_EXPLICIT() -> i64 { 1 }
fn TARGET_SOURCE_HOST_PROBE() -> i64 { 2 }
fn TARGET_SOURCE_ENV_OVERRIDE() -> i64 { 3 }
fn TARGET_SOURCE_FALLBACK() -> i64 { 4 }

pub struct NativeTargetSpec {
    arch_id: i64,
    os_id: i64,
    matrix_mode: i64,
    source_id: i64,
    requested_target: string,
    resolved_target: string,
    fallback_reason: string,
}

pub struct NativeCompileResult {
    ok: bool,
    bytes: [i8; 131072],
    len: i64,
    format_id: i64,
    error_code: i64,
    error_msg: string,
}

struct NativeV2RuntimeContextLayout {
    language_visible: bool,
    tracing_gc: bool,
    precise_stack_maps: bool,
    safepoints: bool,
    deopt_enabled: bool,
    osr_enabled: bool,
    unified_jit_aot: bool,
    heterogeneous_shared: bool,
    gc_field_count: i64,
    io_field_count: i64,
    instrumentation_field_count: i64,
    deopt_field_count: i64,
    capability_field_count: i64,
    heterogeneous_field_count: i64,
    provenance_field_count: i64,
}

struct NativeV2MachineModule {
    target_arch_id: i64,
    fn_count: i64,
    ir_instr_count: i64,
    machine_instr_count: i64,
    stack_map_record_count: i64,
    safepoint_count: i64,
    deopt_point_count: i64,
    active: bool,
    target_count: i64,
    coverage: string,
    fail_closed: bool,
    legacy_fallback: bool,
    has_runtime_context: bool,
    supports_stack_maps: bool,
    supports_safepoints: bool,
    supports_deopt: bool,
    supports_osr: bool,
    unified_jit_aot: bool,
    heterogeneous_shared: bool,
    optimized_tier_count: i64,
}

struct NativeV2TargetPolicySummary {
    reserved_count: i64,
    allocatable_count: i64,
    allocation_order_count: i64,
    scratch_count: i64,
    arg_count: i64,
    ret_count: i64,
    frame_has_gc_area: bool,
    frame_has_deopt_area: bool,
    frame_has_unwind: bool,
    frame_has_vector_align: bool,
    emitter_ready: bool,
}

fn native_v2_backend_name() -> string {
    "native-v2"
}

fn native_v2_backend_stage() -> string {
    "preview-v2"
}

fn NATIVE_V2_POLICY_GROUP_RESERVED() -> i64 { native_policy_group_reserved() }
fn NATIVE_V2_POLICY_GROUP_ALLOCATABLE() -> i64 { native_policy_group_allocatable() }
fn NATIVE_V2_POLICY_GROUP_ALLOCATION_ORDER() -> i64 { native_policy_group_allocation_order() }
fn NATIVE_V2_POLICY_GROUP_SCRATCH() -> i64 { native_policy_group_scratch() }
fn NATIVE_V2_POLICY_GROUP_ARGS() -> i64 { native_policy_group_args() }
fn NATIVE_V2_POLICY_GROUP_RETURNS() -> i64 { native_policy_group_returns() }
fn NATIVE_V2_SAFEPOINT_CALL() -> i64 { 1 }
fn NATIVE_V2_SAFEPOINT_RET() -> i64 { 2 }

fn native_v2_runtime_context_layout() -> NativeV2RuntimeContextLayout {
    NativeV2RuntimeContextLayout {
        language_visible: true,
        tracing_gc: false,  // UNWIRED: no tracing collector on live path
        // Conservative, not precise: root_temp_counts == temp_count below treats
        // every live temp as a GC root instead of deriving the live root set from
        // the regalloc's actual liveness. See scripts/ci/precise_stack_maps_honesty_gate.sh.
        precise_stack_maps: false,
        safepoints: true,
        deopt_enabled: true,
        osr_enabled: true,
        unified_jit_aot: true,
        heterogeneous_shared: true,
        gc_field_count: 10,
        io_field_count: 4,
        instrumentation_field_count: 1,
        deopt_field_count: 3,
        capability_field_count: 3,
        heterogeneous_field_count: 2,
        provenance_field_count: 1,
    }
}

fn native_v2_runtime_context_total_fields(layout: NativeV2RuntimeContextLayout) -> i64 {
    layout.gc_field_count +
    layout.io_field_count +
    layout.instrumentation_field_count +
    layout.deopt_field_count +
    layout.capability_field_count +
    layout.heterogeneous_field_count +
    layout.provenance_field_count
}

fn native_v2_runtime_context_group_count() -> i64 {
    7
}

fn native_v2_runtime_context_group_name(idx: i64) -> string {
    if idx == 0 { return "gc_heap" }
    if idx == 1 { return "process_io" }
    if idx == 2 { return "instrumentation" }
    if idx == 3 { return "deopt_osr" }
    if idx == 4 { return "capabilities" }
    if idx == 5 { return "gpu_render" }
    if idx == 6 { return "provenance" }
    "unknown"
}

fn native_v2_target_contract_supported(spec: NativeTargetSpec) -> bool {
    let tgt_policy = native_target_policy_for(spec.arch_id, spec.os_id)
    tgt_policy.arch_id != native_policy_arch_unknown()
}

fn native_v2_target_policy_summary(spec: NativeTargetSpec) -> NativeV2TargetPolicySummary {
    let tgt_policy = native_target_policy_for(spec.arch_id, spec.os_id)
    NativeV2TargetPolicySummary {
        reserved_count: tgt_policy.reserved_count,
        allocatable_count: tgt_policy.allocatable_count,
        allocation_order_count: tgt_policy.allocation_order_count,
        scratch_count: tgt_policy.scratch_count,
        arg_count: tgt_policy.arg_count,
        ret_count: tgt_policy.ret_count,
        frame_has_gc_area: tgt_policy.frame_has_gc_area,
        frame_has_deopt_area: tgt_policy.frame_has_deopt_area,
        frame_has_unwind: tgt_policy.frame_has_unwind,
        frame_has_vector_align: tgt_policy.frame_has_vector_align,
        emitter_ready: tgt_policy.emitter_ready,
    }
}

fn native_v2_target_policy_group_count(spec: NativeTargetSpec, group: i64) -> i64 {
    let tgt_policy = native_target_policy_for(spec.arch_id, spec.os_id)
    native_target_policy_group_count(tgt_policy, group)
}

fn native_v2_target_policy_group_name(spec: NativeTargetSpec, group: i64, idx: i64) -> string {
    let tgt_policy = native_target_policy_for(spec.arch_id, spec.os_id)
    native_target_policy_group_name(tgt_policy, group, idx)
}

fn native_v2_target_has_attested_runtime_data(spec: NativeTargetSpec) -> bool {
    if spec.arch_id == ARCH_X86_64() && spec.os_id == OS_LINUX() {
        return true
    }
    false
}

fn native_v2_target_runtime_metadata_active(spec: NativeTargetSpec, compile_ok: bool) -> bool {
    let tgt_policy = native_target_policy_for(spec.arch_id, spec.os_id)
    compile_ok && tgt_policy.emitter_ready && native_v2_target_has_attested_runtime_data(spec)
}

fn native_v2_target_emitter_mode(spec: NativeTargetSpec) -> string {
    if spec.arch_id == ARCH_X86_64() && spec.os_id == OS_LINUX() {
        return "machine-ir-scalar-core"
    }
    if spec.arch_id == ARCH_AARCH64() && spec.os_id == OS_LINUX() {
        return "machine-ir-scalar-core"
    }
    if spec.arch_id == ARCH_AARCH64() && spec.os_id == OS_MACOS() {
        return "machine-ir-scalar-core"
    }
    "unsupported"
}

fn native_v2_count_ir_instrs(module: &IrModule) -> i64 with Mut, Panic, Div {
    var total: i64 = 0
    var i: i64 = 0
    while i < module.fn_count {
        total = total + module.functions[i as usize].instr_count
        i = i + 1
    }
    total
}

fn native_v2_machine_instr_is_safepoint(instr: MachineInstr) -> bool {
    instr.opcode == MIR_OP_CALL || instr.opcode == MIR_OP_RET
}

fn native_v2_count_machine_function_safepoints(func: MachineFunction) -> i64 with Mut, Panic, Div {
    var total: i64 = 0
    var i: i64 = 0
    while i < func.blocks[0].instr_count {
        if native_v2_machine_instr_is_safepoint(func.blocks[0].instrs[i as usize]) {
            total = total + 1
        }
        i = i + 1
    }
    total
}

fn native_v2_count_machine_module_safepoints(module: MachineModule) -> i64 with Mut, Panic, Div {
    var total: i64 = 0
    var i: i64 = 0
    while i < module.fn_count {
        total = total + native_v2_count_machine_function_safepoints(module.functions[i as usize])
        i = i + 1
    }
    total
}

fn native_v2_shadow_machine_module(module: &IrModule, spec: NativeTargetSpec) -> NativeV2MachineModule with Mut, Panic, Div, Alloc {
    let enable_preview = (spec.arch_id == ARCH_X86_64() && spec.os_id == OS_LINUX())
        || (spec.arch_id == ARCH_AARCH64() && spec.os_id == OS_MACOS())
    let built = native_v2_build_machine_module(module, enable_preview)
    let safepoint_count = native_v2_count_machine_module_safepoints(built)
    NativeV2MachineModule {
        target_arch_id: spec.arch_id,
        fn_count: module.fn_count,
        ir_instr_count: built.total_ir_instr_count,
        machine_instr_count: built.total_machine_instr_count,
        stack_map_record_count: safepoint_count,
        safepoint_count: safepoint_count,
        deopt_point_count: safepoint_count,
        active: enable_preview,
        target_count: if enable_preview { 1 } else { 0 },
        coverage: built.coverage,
        fail_closed: built.fail_closed,
        legacy_fallback: built.legacy_fallback,
        has_runtime_context: true,
        supports_stack_maps: true,
        supports_safepoints: true,
        supports_deopt: true,
        supports_osr: true,
        unified_jit_aot: true,
        heterogeneous_shared: true,
        optimized_tier_count: 2,
    }
}

fn native_v2_append_named_json_string(buf: [i8; 65536], pos: i64, key: string, value: string, comma: bool) -> ([i8; 65536], i64) with Mut, Panic, Div {
    var out = buf
    var p = pos
    let p0 = io_trace_append_byte(out, p, 34)
    out = p0.0; p = p0.1
    let p1 = io_trace_append_string(out, p, key)
    out = p1.0; p = p1.1
    let p2 = io_trace_append_string(out, p, "\":\"")
    out = p2.0; p = p2.1
    let p3 = io_trace_append_json_string(out, p, value)
    out = p3.0; p = p3.1
    let p4 = io_trace_append_byte(out, p, 34)
    out = p4.0; p = p4.1
    if comma {
        let p5 = io_trace_append_byte(out, p, 44)
        out = p5.0; p = p5.1
    }
    (out, p)
}

fn native_v2_append_named_json_bool(buf: [i8; 65536], pos: i64, key: string, value: bool, comma: bool) -> ([i8; 65536], i64) with Mut, Panic, Div {
    var out = buf
    var p = pos
    let p0 = io_trace_append_byte(out, p, 34)
    out = p0.0; p = p0.1
    let p1 = io_trace_append_string(out, p, key)
    out = p1.0; p = p1.1
    let p2 = io_trace_append_string(out, p, "\":")
    out = p2.0; p = p2.1
    let p3 = io_trace_append_string(out, p, io_trace_bool_string(value))
    out = p3.0; p = p3.1
    if comma {
        let p4 = io_trace_append_byte(out, p, 44)
        out = p4.0; p = p4.1
    }
    (out, p)
}

fn native_v2_append_named_json_i64(buf: [i8; 65536], pos: i64, key: string, value: i64, comma: bool) -> ([i8; 65536], i64) with Mut, Panic, Div {
    var out = buf
    var p = pos
    let p0 = io_trace_append_byte(out, p, 34)
    out = p0.0; p = p0.1
    let p1 = io_trace_append_string(out, p, key)
    out = p1.0; p = p1.1
    let p2 = io_trace_append_string(out, p, "\":")
    out = p2.0; p = p2.1
    let p3 = io_trace_append_string(out, p, io_trace_i64_string(value))
    out = p3.0; p = p3.1
    if comma {
        let p4 = io_trace_append_byte(out, p, 44)
        out = p4.0; p = p4.1
    }
    (out, p)
}

fn native_v2_append_runtime_group_array(buf: [i8; 65536], pos: i64) -> ([i8; 65536], i64) with Mut, Panic, Div {
    var out = buf
    var p = pos
    let p0 = io_trace_append_string(out, p, "\"field_groups\":[")
    out = p0.0; p = p0.1
    var i: i64 = 0
    while i < native_v2_runtime_context_group_count() {
        let p1 = io_trace_append_byte(out, p, 34)
        out = p1.0; p = p1.1
        let p2 = io_trace_append_json_string(out, p, native_v2_runtime_context_group_name(i))
        out = p2.0; p = p2.1
        let p3 = io_trace_append_byte(out, p, 34)
        out = p3.0; p = p3.1
        if i + 1 < native_v2_runtime_context_group_count() {
            let p4 = io_trace_append_byte(out, p, 44)
            out = p4.0; p = p4.1
        }
        i = i + 1
    }
    let p5 = io_trace_append_byte(out, p, 93)
    out = p5.0; p = p5.1
    (out, p)
}

fn native_v2_append_policy_group_array(buf: [i8; 65536], pos: i64, key: string, spec: NativeTargetSpec, group: i64) -> ([i8; 65536], i64) with Mut, Panic, Div {
    var out = buf
    var p = pos
    let p0 = io_trace_append_byte(out, p, 34)
    out = p0.0; p = p0.1
    let p1 = io_trace_append_string(out, p, key)
    out = p1.0; p = p1.1
    let p2 = io_trace_append_string(out, p, "\":[")
    out = p2.0; p = p2.1
    let count = native_v2_target_policy_group_count(spec, group)
    var i: i64 = 0
    while i < count {
        let p3 = io_trace_append_byte(out, p, 34)
        out = p3.0; p = p3.1
        let p4 = io_trace_append_json_string(out, p, native_v2_target_policy_group_name(spec, group, i))
        out = p4.0; p = p4.1
        let p5 = io_trace_append_byte(out, p, 34)
        out = p5.0; p = p5.1
        if i + 1 < count {
            let p6 = io_trace_append_byte(out, p, 44)
            out = p6.0; p = p6.1
        }
        i = i + 1
    }
    let p7 = io_trace_append_byte(out, p, 93)
    out = p7.0; p = p7.1
    (out, p)
}

fn native_v2_write_contract(path: string, module: &IrModule, target_spec: NativeTargetSpec, compile_ok: bool, error_code: i64, output_path: string) -> bool with IO, Mut, Panic, Div, Alloc {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0
    let runtime = native_v2_runtime_context_layout()
    let machine = native_v2_shadow_machine_module(module, target_spec)
    let tgt_policy = native_v2_target_policy_summary(target_spec)
    let runtime_metadata_active = native_v2_target_runtime_metadata_active(target_spec, compile_ok)

    let p0 = io_trace_append_byte(buf, p, 123)
    buf = p0.0; p = p0.1

    let p1 = native_v2_append_named_json_string(buf, p, "schema", "sounio.native_backend_v2_contract.v1", true)
    buf = p1.0; p = p1.1
    let p2 = native_v2_append_named_json_string(buf, p, "backend", native_v2_backend_name(), true)
    buf = p2.0; p = p2.1
    let p3 = native_v2_append_named_json_string(buf, p, "stage", native_v2_backend_stage(), true)
    buf = p3.0; p = p3.1
    let p4 = native_v2_append_named_json_string(buf, p, "requested_target", target_spec.requested_target, true)
    buf = p4.0; p = p4.1
    let p5 = native_v2_append_named_json_string(buf, p, "resolved_target", target_spec.resolved_target, true)
    buf = p5.0; p = p5.1
    let p6 = native_v2_append_named_json_string(buf, p, "matrix_mode", native_matrix_mode_string(target_spec.matrix_mode), true)
    buf = p6.0; p = p6.1
    let p7 = native_v2_append_named_json_bool(buf, p, "public_shell_preserved", true, true)
    buf = p7.0; p = p7.1
    let p8 = native_v2_append_named_json_bool(buf, p, "compile_ok", compile_ok, true)
    buf = p8.0; p = p8.1
    let p9 = native_v2_append_named_json_i64(buf, p, "error_code", error_code, true)
    buf = p9.0; p = p9.1
    let p10 = native_v2_append_named_json_string(buf, p, "output_path", output_path, true)
    buf = p10.0; p = p10.1

    let p11 = io_trace_append_string(buf, p, "\"runtime_context\":{")
    buf = p11.0; p = p11.1
    let p12 = native_v2_append_named_json_bool(buf, p, "language_visible", runtime.language_visible, true)
    buf = p12.0; p = p12.1
    let p13 = native_v2_append_named_json_bool(buf, p, "tracing_gc", runtime.tracing_gc, true)
    buf = p13.0; p = p13.1
    let p14 = native_v2_append_named_json_bool(buf, p, "precise_stack_maps", runtime.precise_stack_maps, true)
    buf = p14.0; p = p14.1
    let p15 = native_v2_append_named_json_bool(buf, p, "safepoints", runtime.safepoints, true)
    buf = p15.0; p = p15.1
    let p16 = native_v2_append_named_json_bool(buf, p, "deopt_enabled", runtime.deopt_enabled, true)
    buf = p16.0; p = p16.1
    let p17 = native_v2_append_named_json_bool(buf, p, "osr_enabled", runtime.osr_enabled, true)
    buf = p17.0; p = p17.1
    let p18 = native_v2_append_named_json_i64(buf, p, "total_fields", native_v2_runtime_context_total_fields(runtime), true)
    buf = p18.0; p = p18.1
    let p18a = native_v2_append_named_json_bool(buf, p, "managed_handles", true, true)
    buf = p18a.0; p = p18a.1
    let p18b = native_v2_append_named_json_bool(buf, p, "descriptor_tables", true, true)
    buf = p18b.0; p = p18b.1
    let p18c = native_v2_append_named_json_bool(buf, p, "pin_registry_ready", false, true)
    buf = p18c.0; p = p18c.1
    let p19 = native_v2_append_runtime_group_array(buf, p)
    buf = p19.0; p = p19.1
    let p20 = io_trace_append_byte(buf, p, 125)
    buf = p20.0; p = p20.1
    let p21 = io_trace_append_byte(buf, p, 44)
    buf = p21.0; p = p21.1

    let p22 = io_trace_append_string(buf, p, "\"machine_ir\":{")
    buf = p22.0; p = p22.1
    let p23 = native_v2_append_named_json_bool(buf, p, "active", machine.active, true)
    buf = p23.0; p = p23.1
    let p24 = native_v2_append_named_json_i64(buf, p, "functions", machine.fn_count, true)
    buf = p24.0; p = p24.1
    let p25 = native_v2_append_named_json_i64(buf, p, "ir_instructions", machine.ir_instr_count, true)
    buf = p25.0; p = p25.1
    let p26 = native_v2_append_named_json_i64(buf, p, "machine_instructions", machine.machine_instr_count, true)
    buf = p26.0; p = p26.1
    let p27 = native_v2_append_named_json_string(buf, p, "coverage", machine.coverage, true)
    buf = p27.0; p = p27.1
    let p28 = native_v2_append_named_json_bool(buf, p, "fail_closed", machine.fail_closed, true)
    buf = p28.0; p = p28.1
    let p29 = native_v2_append_named_json_bool(buf, p, "legacy_fallback", machine.legacy_fallback, true)
    buf = p29.0; p = p29.1
    let p30 = io_trace_append_string(buf, p, "\"targets\":[")
    buf = p30.0; p = p30.1
    if machine.target_count > 0 {
        let p30a = io_trace_append_byte(buf, p, 34)
        buf = p30a.0; p = p30a.1
        let p30b = io_trace_append_json_string(buf, p, target_spec.resolved_target)
        buf = p30b.0; p = p30b.1
        let p30c = io_trace_append_byte(buf, p, 34)
        buf = p30c.0; p = p30c.1
    }
    let p30e = io_trace_append_byte(buf, p, 93)
    buf = p30e.0; p = p30e.1
    let p30f = io_trace_append_byte(buf, p, 44)
    buf = p30f.0; p = p30f.1
    let p31 = native_v2_append_named_json_i64(buf, p, "optimized_tiers", machine.optimized_tier_count, true)
    buf = p31.0; p = p31.1
    let p32 = native_v2_append_named_json_bool(buf, p, "supports_stack_maps", machine.supports_stack_maps, true)
    buf = p32.0; p = p32.1
    let p33a = native_v2_append_named_json_bool(buf, p, "supports_safepoints", machine.supports_safepoints, true)
    buf = p33a.0; p = p33a.1
    let p33b = native_v2_append_named_json_bool(buf, p, "supports_deopt", machine.supports_deopt, true)
    buf = p33b.0; p = p33b.1
    let p33c = native_v2_append_named_json_bool(buf, p, "supports_osr", machine.supports_osr, true)
    buf = p33c.0; p = p33c.1
    let p33d = native_v2_append_named_json_i64(buf, p, "stack_map_records", machine.stack_map_record_count, true)
    buf = p33d.0; p = p33d.1
    let p33e = native_v2_append_named_json_i64(buf, p, "safepoint_count", machine.safepoint_count, true)
    buf = p33e.0; p = p33e.1
    let p33f = native_v2_append_named_json_i64(buf, p, "deopt_point_count", machine.deopt_point_count, true)
    buf = p33f.0; p = p33f.1
    let p33g = native_v2_append_named_json_bool(buf, p, "runtime_metadata_embedded", runtime_metadata_active, true)
    buf = p33g.0; p = p33g.1
    let p33ga = native_v2_append_named_json_bool(buf, p, "gc_state_embedded", runtime_metadata_active, true)
    buf = p33ga.0; p = p33ga.1
    let p33gb = native_v2_append_named_json_bool(buf, p, "gc_slow_path_active", runtime_metadata_active, true)
    buf = p33gb.0; p = p33gb.1
    let p33gc = native_v2_append_named_json_bool(buf, p, "stack_maps_runtime_active", runtime_metadata_active, true)
    buf = p33gc.0; p = p33gc.1
    let p33gc0 = native_v2_append_named_json_string(buf, p, "root_map_schema", "v2", true)
    buf = p33gc0.0; p = p33gc0.1
    let p33gc1 = native_v2_append_named_json_bool(buf, p, "root_map_fields_embedded", runtime_metadata_active, true)
    buf = p33gc1.0; p = p33gc1.1
    let p33gc2 = native_v2_append_named_json_bool(buf, p, "coarse_root_kind_tags", runtime_metadata_active, true)
    buf = p33gc2.0; p = p33gc2.1
    let p33gc3 = native_v2_append_named_json_bool(buf, p, "deopt_ids_embedded", runtime_metadata_active, true)
    buf = p33gc3.0; p = p33gc3.1
    let p33gc4 = native_v2_append_named_json_bool(buf, p, "osr_eligibility_embedded", runtime_metadata_active, true)
    buf = p33gc4.0; p = p33gc4.1
    let p33gd = native_v2_append_named_json_bool(buf, p, "handle_indirection", runtime_metadata_active, true)
    buf = p33gd.0; p = p33gd.1
    let p33ge = native_v2_append_named_json_bool(buf, p, "descriptor_tables_embedded", runtime_metadata_active, true)
    buf = p33ge.0; p = p33ge.1
    let p33gf = native_v2_append_named_json_bool(buf, p, "pin_registry_ready", false, true)
    buf = p33gf.0; p = p33gf.1
    let p33gg = native_v2_append_named_json_bool(buf, p, "gc_mark_compact_model", false, true)
    buf = p33gg.0; p = p33gg.1
    let p33gh = native_v2_append_named_json_bool(buf, p, "gc_precise_descriptor_scanning", false, true)
    buf = p33gh.0; p = p33gh.1
    let p33gi = native_v2_append_named_json_bool(buf, p, "gc_handle_relocation_model", false, true)
    buf = p33gi.0; p = p33gi.1
    let p33gj = native_v2_append_named_json_bool(buf, p, "ffi_pinning_model", false, true)
    buf = p33gj.0; p = p33gj.1
