    let p33ge = native_v2_append_named_json_bool(buf, p, "descriptor_tables_embedded", runtime_metadata_active, true)
    buf = p33ge.0; p = p33ge.1
    let p33gf = native_v2_append_named_json_bool(buf, p, "pin_registry_ready", true, true)
    buf = p33gf.0; p = p33gf.1
    let p33gg = native_v2_append_named_json_bool(buf, p, "gc_mark_compact_model", true, true)
    buf = p33gg.0; p = p33gg.1
    let p33gh = native_v2_append_named_json_bool(buf, p, "gc_precise_descriptor_scanning", true, true)
