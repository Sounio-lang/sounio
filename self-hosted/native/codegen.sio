    nc_emit_byte(nc, 0xc1)
    nc_emit_u32_le(nc, val)
}

fn nc_emit_syscall(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_byte(nc, 0x0f)
    nc_emit_byte(nc, 0x05)
}

fn nc_emit_mov_rip_disp32_rax(nc: &! NativeCompiler, disp: i64) with Mut, Panic, Div {
