    let p33 = io_trace_append_string(buf, p, "},\"target_policy\":{")
    buf = p33.0; p = p33.1
    let p34 = native_v2_append_named_json_bool(buf, p, "contract_supported", native_v2_target_contract_supported(target_spec), true)
    buf = p34.0; p = p34.1
    let p35 = native_v2_append_named_json_string(buf, p, "emitter_mode", native_v2_target_emitter_mode(target_spec), true)
    buf = p35.0; p = p35.1
    let p36 = native_v2_append_policy_group_array(buf, p, "reserved_regs", target_spec, NATIVE_V2_POLICY_GROUP_RESERVED())
    buf = p36.0; p = p36.1
    let p37 = io_trace_append_byte(buf, p, 44)
    buf = p37.0; p = p37.1
    let p38 = native_v2_append_policy_group_array(buf, p, "allocatable_regs", target_spec, NATIVE_V2_POLICY_GROUP_ALLOCATABLE())
    buf = p38.0; p = p38.1
    let p39 = io_trace_append_byte(buf, p, 44)
    buf = p39.0; p = p39.1
    let p40 = native_v2_append_policy_group_array(buf, p, "allocation_order", target_spec, NATIVE_V2_POLICY_GROUP_ALLOCATION_ORDER())
