    let p33f = native_v2_append_named_json_i64(buf, p, "deopt_point_count", machine.deopt_point_count, true)
    buf = p33f.0; p = p33f.1
    let p33g = native_v2_append_named_json_bool(buf, p, "runtime_metadata_embedded", runtime_metadata_active, true)
    buf = p33g.0; p = p33g.1
    let p33ga = native_v2_append_named_json_bool(buf, p, "gc_state_embedded", runtime_metadata_active, true)
