// self-hosted::native::codegen — Native x86-64 code generator orchestrator
//
// This module coordinates the full native compilation pipeline:
// HIR → x86-64 machine code → ELF64 binary

// Placeholder for HIR types (will import from self-hosted HIR once available)
struct HirFunction {
    name: i64,        // Name index (string table)
    params: i64,      // Param count
    locals: i64,      // Local count
    body_start: i64,  // Block index
}

struct HirBlock {
    id: i64,
    instrs: i64,      // Instruction count (placeholder)
}

// Codegen state
struct Codegen {
    code: CodeBuffer,                    // Instruction bytes
    fn_count: i64,                       // Number of functions compiled
    current_offset: i64,                 // Current code buffer position
}

fn codegen_new() -> Codegen {
    Codegen {
        code: code_buffer_new(),
        fn_count: 0,
        current_offset: 0,
    }
}

// Main compilation entry point
fn compile_hir_module(cg: Codegen, funcs: i64) -> Codegen with Mut, Alloc, Panic {
    // TODO: Iterate through HIR functions
    // For now, just stub
    cg
}

// Compile a single function
fn compile_function(cg: Codegen, func: HirFunction) -> Codegen with Mut, Alloc, Panic {
    // TODO: Phase 1 will implement stack frames here
    cg
}
