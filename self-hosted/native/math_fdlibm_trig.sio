// sin(x) -- the native sin builtin. The f64 argument arrives in rdi as raw bits
// and the result leaves in rax the same way, like every scalar builtin here.
// Frame: [rbp-8] x, [rbp-16] the result, 1280 bytes in all.
pub fn emit_builtin_fdlibm_sin(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.rodata = data_section_add_f64(c.rodata, 0x0000000000000000)   // [0] ZERO
    let k = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FE0000000000000)   // [1] HALF
    c.rodata = data_section_add_f64(c.rodata, 0x3FF0000000000000)   // [2] ONE
    c.rodata = data_section_add_f64(c.rodata, 0x4000000000000000)   // [3] TWO
    c.rodata = data_section_add_f64(c.rodata, 0x4008000000000000)   // [4] THREE
    c.rodata = data_section_add_f64(c.rodata, 0x4010000000000000)   // [5] FOUR
    c.rodata = data_section_add_f64(c.rodata, 0x4020000000000000)   // [6] EIGHT
    c.rodata = data_section_add_f64(c.rodata, 0x3FC0000000000000)   // [7] EIGHTH
    c.rodata = data_section_add_f64(c.rodata, 0xBFF0000000000000)   // [8] MONE
    c.rodata = data_section_add_f64(c.rodata, 0x4170000000000000)   // [9] TWO24
    c.rodata = data_section_add_f64(c.rodata, 0x3E70000000000000)   // [10] TWON24
    c.rodata = data_section_add_f64(c.rodata, 0x4338000000000000)   // [11] P52X15
    c.rodata = data_section_add_f64(c.rodata, 0xBFC5555555555549)   // [12] S1
    c.rodata = data_section_add_f64(c.rodata, 0x3F8111111110F8A6)   // [13] S2
    c.rodata = data_section_add_f64(c.rodata, 0xBF2A01A019C161D5)   // [14] S3
    c.rodata = data_section_add_f64(c.rodata, 0x3EC71DE357B1FE7D)   // [15] S4
    c.rodata = data_section_add_f64(c.rodata, 0xBE5AE5E68A2B9CEB)   // [16] S5
    c.rodata = data_section_add_f64(c.rodata, 0x3DE5D93A5ACFD57C)   // [17] S6
    c.rodata = data_section_add_f64(c.rodata, 0x3FA555555555554C)   // [18] C1
    c.rodata = data_section_add_f64(c.rodata, 0xBF56C16C16C15177)   // [19] C2
    c.rodata = data_section_add_f64(c.rodata, 0x3EFA01A019CB1590)   // [20] C3
    c.rodata = data_section_add_f64(c.rodata, 0xBE927E4F809C52AD)   // [21] C4
    c.rodata = data_section_add_f64(c.rodata, 0x3E21EE9EBDB4B1C4)   // [22] C5
    c.rodata = data_section_add_f64(c.rodata, 0xBDA8FAE9BE8838D4)   // [23] C6
    c.rodata = data_section_add_f64(c.rodata, 0x3FE45F306DC9C883)   // [24] INVPIO2
    c.rodata = data_section_add_f64(c.rodata, 0x3FF921FB54400000)   // [25] PIO2_1
    c.rodata = data_section_add_f64(c.rodata, 0x3DD0B4611A626331)   // [26] PIO2_1T
    c.rodata = data_section_add_f64(c.rodata, 0x3DD0B4611A600000)   // [27] PIO2_2
