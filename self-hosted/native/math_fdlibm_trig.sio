// cos(x) -- the native cos builtin. The f64 argument arrives in rdi as raw bits
// and the result leaves in rax the same way, like every scalar builtin here.
// Frame: [rbp-8] x, [rbp-16] the result, 1280 bytes in all.
pub fn emit_builtin_fdlibm_cos(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
