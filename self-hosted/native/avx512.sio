// T38: Octonion multiply produces substantial instruction sequence
fn test_avx_octonion_mul_length() -> bool with Mut, Panic, Div {
    var e = avx_emitter_new()
    let start = e.pos
    e = avx512_octonion_mul(e)
    let len = e.pos - start
    // Expect > 500 bytes (many FMA + mul + sub instructions)
    // 1 xorpd(6) + 16 permpd(7) + ~70 arith(6) > 500 bytes
    len > 500
}

// T39: Octonion multiply starts with vxorpd (zeroing result)
fn test_avx_octonion_mul_starts_xor() -> bool with Mut, Panic, Div {
    var e = avx_emitter_new()
    e = avx512_octonion_mul(e)
    // First instruction: EVEX prefix
    if avx_check_byte(e, 0, 0x62) == false { return false }
    // Opcode of vxorpd is 0x57
    avx_check_byte(e, 4, 0x57)
}

// T40: Quaternion multiply emits instructions
fn test_avx_quat_mul_length() -> bool with Mut, Panic, Div {
    var e = avx_emitter_new()
    let start = e.pos
    e = avx512_quat_mul(e)
    let len = e.pos - start
    // 4 broadcasts(7) + 1 mov(6) + 3 permpd(7) + 4 mul(6) + 3 add/sub(6) > 80 bytes
    len > 80
}

// T41: Quaternion conjugate emits a single vxorpd (6 bytes)
fn test_avx_quat_conj_length() -> bool with Mut, Panic, Div {
    var e = avx_emitter_new()
    let start = e.pos
    e = avx512_quat_conj(e)
    let len = e.pos - start
    len == 6
}

// T42: Rounding mode encoded in EVEX byte 3
fn test_avx_rounding_mode_encoding() -> bool with Mut, Panic, Div {
    var e = avx_emitter_new()
    let z0 = avx_reg_zmm(0)
    let z1 = avx_reg_zmm(1)
    let z2 = avx_reg_zmm(2)
    e = avx_vaddpd_zmm_rn(e, z0, z1, z2, AVX_ROUND_DOWN)
    let b3 = avx_read_byte(e, 3)
    // b-bit should be 1 (bit 4)
    let b_bit = (b3 >> 4) & 1
    // L'L should encode rounding mode 1 = round down (bits 6:5)
    let ll = (b3 >> 5) & 3
    if b_bit == 1 { ll == AVX_ROUND_DOWN } else { false }
}

// T43: Rounding mode TRUNC encoding
fn test_avx_rounding_trunc() -> bool with Mut, Panic, Div {
    var e = avx_emitter_new()
    let z0 = avx_reg_zmm(0)
    let z1 = avx_reg_zmm(1)
    let z2 = avx_reg_zmm(2)
    e = avx_vaddpd_zmm_rn(e, z0, z1, z2, AVX_ROUND_TRUNC)
    let b3 = avx_read_byte(e, 3)
    let b_bit = (b3 >> 4) & 1
    let ll = (b3 >> 5) & 3
    if b_bit == 1 { ll == AVX_ROUND_TRUNC } else { false }
}

// T44: Two consecutive instructions have correct positions
fn test_avx_consecutive_instrs() -> bool with Mut, Panic, Div {
    var e = avx_emitter_new()
    let z0 = avx_reg_zmm(0)
    let z1 = avx_reg_zmm(1)
    let z2 = avx_reg_zmm(2)
    e = avx_vaddpd_zmm(e, z0, z1, z2)
    let pos1 = e.pos
    e = avx_vmulpd_zmm(e, z0, z1, z2)
    let pos2 = e.pos
    // Each reg-reg is 6 bytes
    if pos1 == 6 { pos2 == 12 } else { false }
}

// T45: vvvv field encodes src1 register (inverted)
fn test_avx_vvvv_encoding() -> bool with Mut, Panic, Div {
    var e = avx_emitter_new()
    let z0 = avx_reg_zmm(0)
    let z5 = avx_reg_zmm(5)
    let z1 = avx_reg_zmm(1)
    e = avx_vaddpd_zmm(e, z0, z5, z1)
    let b2 = avx_read_byte(e, 2)
    // vvvv = inverted low 4 bits of src1 (zmm5 = 5, inverted = 10)
    // vvvv is bits 6:3 of byte 2
    let vvvv = (b2 >> 3) & 15
    vvvv == (5 ^ 15)  // 10
}

// T46: Map select for 0F instructions (mm=01)
fn test_avx_map_0f() -> bool with Mut, Panic, Div {
    var e = avx_emitter_new()
    let z0 = avx_reg_zmm(0)
    let z1 = avx_reg_zmm(1)
    e = avx_vaddpd_zmm(e, z0, z1, z0)
    let b1 = avx_read_byte(e, 1)
    (b1 & 3) == 1
}

// T47: vcvtpd2ps uses W=1
