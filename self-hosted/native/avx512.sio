    e = avx_vcmppd_zmm(e, k1, z0, z1, AVX_CMP_EQ)
    // opcode should be 0xC2
    if avx_check_byte(e, 4, 0xC2) == false { return false }
    // imm8 (predicate) should be 0
    avx_check_byte(e, 6, 0)
}

