// self-hosted::native::suite — native backend tests for the self-hosted suite
//
// This file is NOT prefixed with test_ so it is loaded in the flat namespace.
// It provides run_native_tests() called by test_all.sio.

use native::encode::*
use native::frame::*
use native::elf::*
use native::reloc::*
use native::codegen::*
use native::lower_ir::*
use native::codegen_plan::*
use ir::ir::*
use parser::ast::*

// Helper: read byte as unsigned (i8 -> 0..255)
fn native_byte_u8(b: i8) -> i64 {
    let x = b as i64
    if x < 0 { x + 256 } else { x }
}

fn native_code_eq(a: CodeBuffer, b: CodeBuffer) -> bool {
    if a.len != b.len { return false }
    var i = 0
    while i < a.len {
        if native_byte_u8(a.bytes[i as usize]) != native_byte_u8(b.bytes[i as usize]) {
            return false
        }
        i = i + 1
    }
    true
}

// ============================================================================
// T01: emit_exit produces correct syscall bytes
// ============================================================================
fn native_test_emit_exit_bytes() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = emit_exit(buf, 0)

    // Expected: 48 c7 c0 3c 00 00 00 48 c7 c7 00 00 00 00 0f 05
    if !(buf.len == 16) { return false }
    if !(native_byte_u8(buf.bytes[0]) == 0x48) { return false }
    if !(native_byte_u8(buf.bytes[1]) == 0xc7) { return false }
    if !(native_byte_u8(buf.bytes[2]) == 0xc0) { return false }
    if !(native_byte_u8(buf.bytes[3]) == 60) { return false }
    if !(native_byte_u8(buf.bytes[14]) == 0x0f) { return false }
    if !(native_byte_u8(buf.bytes[15]) == 0x05) { return false }
    true
}

// ============================================================================
// T02: Compile fn main() -> i64 { 42 } and verify ELF structure
// ============================================================================
fn native_test_compile_simple() -> i64 with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)  // "main"
    func.param_count = 0
    func.reg_count = 1
    func.instr_count = 2
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, 42))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_return(0))

    module.functions[0] = func
    module.fn_count = 1

    let elf = compile_to_elf(&module, 4194304)

    // Verify ELF magic: 0x7F 'E' 'L' 'F'
    if elf.len < 64 { return 1 }
    if native_byte_u8(elf.bytes[0]) != 0x7f { return 2 }
    if native_byte_u8(elf.bytes[1]) != 69 { return 3 }    // 'E'
    if native_byte_u8(elf.bytes[2]) != 76 { return 4 }    // 'L'
    if native_byte_u8(elf.bytes[3]) != 70 { return 5 }    // 'F'

    // ELF class: 64-bit (byte 4 = 2)
    if native_byte_u8(elf.bytes[4]) != 2 { return 6 }
    // Data encoding: little-endian (byte 5 = 1)
    if native_byte_u8(elf.bytes[5]) != 1 { return 7 }
    // e_type: ET_EXEC (offset 16, value 2)
    if native_byte_u8(elf.bytes[16]) != 2 { return 9 }
    // e_machine: EM_X86_64 (offset 18, value 62)
    if native_byte_u8(elf.bytes[18]) != 62 { return 10 }

    if elf.len < 128 { return 11 }

    0
}

// ============================================================================
// T03: Compile function with arithmetic and verify code section exists
// ============================================================================
fn native_test_compile_arithmetic() -> i64 with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)  // "main"
    func.param_count = 0
    func.reg_count = 3
    func.instr_count = 4
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_imm(0, 10))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_load_imm(1, 32))
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_binop(2, 0, BinaryOp::OpAdd, 1))
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_return(2))

    module.functions[0] = func
    module.fn_count = 1

    let elf = compile_to_elf(&module, 4194304)

    if elf.len < 64 { return 1 }
    if native_byte_u8(elf.bytes[0]) != 0x7f { return 2 }
    if elf.len < 256 { return 3 }

    0
}

// ============================================================================
// T04: Compile two functions with call and verify relocations
// ============================================================================
fn native_test_compile_call() -> i64 with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    // Function 0: add(a, b) -> a + b
    var fn_add = ir_empty_function()
    fn_add.name = ir_name_from_bytes(97, 100, 100, 0, 3)  // "add"
    fn_add.param_count = 2
    fn_add.reg_count = 3
    fn_add.instr_count = 2
    ir_arena_store(ir_region_slot_w(fn_add.region, (0)), ir_binop(2, 0, BinaryOp::OpAdd, 1))
    ir_arena_store(ir_region_slot_w(fn_add.region, (1)), ir_return(2))

    module.functions[0] = fn_add

    // Function 1: main() -> call add(21, 21)
    var fn_main = ir_empty_function()
    fn_main.name = ir_name_from_bytes(109, 97, 105, 110, 4)  // "main"
    fn_main.param_count = 0
    fn_main.reg_count = 3
    fn_main.instr_count = 4
    ir_arena_store(ir_region_slot_w(fn_main.region, (0)), ir_load_imm(0, 21))
    ir_arena_store(ir_region_slot_w(fn_main.region, (1)), ir_load_imm(1, 21))

    // r2 = call fn0(r0, r1) — build call instruction manually
    var ic = ir_instr_new(IrOpcode::IrCall)
    ic = IrInstr {
        op: ic.op, dst: 2, src1: 0, src2: 1,
        imm_i64: ic.imm_i64, imm_f64: ic.imm_f64,
        label_id: ic.label_id, fn_id: 0,
        field_idx: ic.field_idx, imm_flags: 0, bin_op: ic.bin_op, un_op: ic.un_op,
        name_id: ic.name_id, call_args: ic.call_args, arg_count: 2,
    }
    ir_arena_store(ir_region_slot_w(fn_main.region, (2)), ic)
    ir_arena_store(ir_region_slot_w(fn_main.region, (3)), ir_return(2))

    module.functions[1] = fn_main
    module.fn_count = 2

    let elf = compile_to_elf(&module, 4194304)

    if elf.len < 64 { return 1 }
    if native_byte_u8(elf.bytes[0]) != 0x7f { return 2 }
    if elf.len < 512 { return 3 }

    0
}

// ============================================================================
// T05: Compile struct alloc + field set + field get
// Equivalent to: struct P { x, y }; let p = P { x: 10, y: 32 }; p.x + p.y
// ============================================================================
fn native_test_compile_struct() -> i64 with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)  // "main"
    func.param_count = 0
    func.reg_count = 5
    func.instr_count = 9

    // field_idx: "x" = 120 % 64 = 56, "y" = 121 % 64 = 57
    let fx_name = ir_name_from_bytes(120, 0, 0, 0, 1)  // "x"
    let fy_name = ir_name_from_bytes(121, 0, 0, 0, 1)  // "y"

    // r0 = alloc (struct)
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_alloc(0, 0))

    // r1 = 10
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_load_imm(1, 10))

    // r0.x = r1  (field_set: base=r0, field_idx=56, src=r1)
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_field_set(0, 56, 1, fx_name))

    // r1 = 32
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_load_imm(1, 32))

    // r0.y = r1  (field_set: base=r0, field_idx=57, src=r1)
    ir_arena_store(ir_region_slot_w(func.region, (4)), ir_field_set(0, 57, 1, fy_name))

    // r2 = r0.x  (field_get: dst=r2, base=r0, field_idx=56)
    ir_arena_store(ir_region_slot_w(func.region, (5)), ir_field_get(2, 0, 56, fx_name))

    // r3 = r0.y  (field_get: dst=r3, base=r0, field_idx=57)
    ir_arena_store(ir_region_slot_w(func.region, (6)), ir_field_get(3, 0, 57, fy_name))

    // r4 = r2 + r3
    ir_arena_store(ir_region_slot_w(func.region, (7)), ir_binop(4, 2, BinaryOp::OpAdd, 3))

    // return r4
    ir_arena_store(ir_region_slot_w(func.region, (8)), ir_return(4))

    module.functions[0] = func
    module.fn_count = 1

    let elf = compile_to_elf(&module, 4194304)

    if elf.len < 64 { return 1 }
    if native_byte_u8(elf.bytes[0]) != 0x7f { return 2 }
    if native_byte_u8(elf.bytes[1]) != 69 { return 3 }
    if elf.len < 256 { return 4 }

    0
}

// ============================================================================
// T06: Compile array alloc + index set + index get
// Equivalent to: var arr = [10, 32]; arr[0] + arr[1]
// ============================================================================
fn native_test_compile_array() -> i64 with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)  // "main"
    func.param_count = 0
    func.reg_count = 7
    func.instr_count = 11

    // r0 = alloc (array, type_id=1)
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_alloc(0, 1))

    // r1 = 10
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_load_imm(1, 10))

    // r2 = 0 (index)
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_load_imm(2, 0))

    // arr[0] = r1  (index_set: base=r0, idx=r2, src=r1)
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_index_set(0, 2, 1))

    // r1 = 32
    ir_arena_store(ir_region_slot_w(func.region, (4)), ir_load_imm(1, 32))

    // r5 = 1 (index)
    ir_arena_store(ir_region_slot_w(func.region, (5)), ir_load_imm(5, 1))

    // arr[1] = r1  (index_set: base=r0, idx=r5, src=r1)
    ir_arena_store(ir_region_slot_w(func.region, (6)), ir_index_set(0, 5, 1))

    // r3 = arr[0]  (index_get: dst=r3, base=r0, idx=r2)
    ir_arena_store(ir_region_slot_w(func.region, (7)), ir_index_get(3, 0, 2))

    // r4 = arr[1]  (index_get: dst=r4, base=r0, idx=r5)
    ir_arena_store(ir_region_slot_w(func.region, (8)), ir_index_get(4, 0, 5))

    // r6 = r3 + r4
    ir_arena_store(ir_region_slot_w(func.region, (9)), ir_binop(6, 3, BinaryOp::OpAdd, 4))

    // return r6
    ir_arena_store(ir_region_slot_w(func.region, (10)), ir_return(6))

    module.functions[0] = func
    module.fn_count = 1

    let elf = compile_to_elf(&module, 4194304)

    if elf.len < 64 { return 1 }
    if native_byte_u8(elf.bytes[0]) != 0x7f { return 2 }
    if elf.len < 256 { return 3 }

    0
}

// ============================================================================
// T07: Compile get_arg_count builtin -> ELF
// ============================================================================
fn native_test_compile_get_arg_count() -> i64 with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    // fn get_arg_count() -> i64 (builtin)
    var fn_gac = ir_empty_function()
    var gac_name = ir_empty_name()
    // "get_arg_count"
    gac_name.len = 13
    gac_name.buf[0] = 103
    gac_name.buf[1] = 101
    gac_name.buf[2] = 116
    gac_name.buf[3] = 95
    gac_name.buf[4] = 97
    gac_name.buf[5] = 114
    gac_name.buf[6] = 103
    gac_name.buf[7] = 95
    gac_name.buf[8] = 99
    gac_name.buf[9] = 111
    gac_name.buf[10] = 117
    gac_name.buf[11] = 110
    gac_name.buf[12] = 116
    fn_gac.name = gac_name
    fn_gac.param_count = 0
    fn_gac.reg_count = 0
    fn_gac.instr_count = 0
    module.functions[0] = fn_gac

    // fn main() -> i64 { return get_arg_count() }
    var fn_main = ir_empty_function()
    fn_main.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    fn_main.param_count = 0
    fn_main.reg_count = 2
    fn_main.instr_count = 2
    ir_arena_store(ir_region_slot_w(fn_main.region, (0)), ir_call(0, 0, gac_name, ir_empty_reg_list(), 0))
    ir_arena_store(ir_region_slot_w(fn_main.region, (1)), ir_return(0))

    module.functions[1] = fn_main
    module.fn_count = 2

    let elf = compile_to_elf(&module, 4194304)

    if elf.len < 64 { return 1 }
    if native_byte_u8(elf.bytes[0]) != 0x7f { return 2 }
    if native_byte_u8(elf.bytes[1]) != 69 { return 3 }
    if elf.len < 256 { return 4 }
    0
}

