// ============================================================================
// T10: Explicit unimplemented target fails closed with backend_not_implemented
// ============================================================================
fn native_test_dispatch_explicit_unimplemented() -> i64 with IO, Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    var fn_main = ir_empty_function()
    fn_main.name = ir_name_from_bytes(109, 97, 105, 110, 4)  // "main"
    fn_main.param_count = 0
    fn_main.reg_count = 1
    fn_main.instr_count = 2
    ir_arena_store(ir_region_slot_w(fn_main.region, (0)), ir_load_imm(0, 0))
    ir_arena_store(ir_region_slot_w(fn_main.region, (1)), ir_return(0))
    module.functions[0] = fn_main
    module.fn_count = 1

    let spec = native_resolve_target("aarch64-macos", "auto", true)
    let result = compile_native(&module, spec)
    if result.ok { return 1 }
    if result.error_code != ERR_BACKEND_NOT_IMPLEMENTED() { return 2 }
    0
}

// ============================================================================
// T11: native-auto resolves to a concrete target
// ============================================================================
fn native_test_dispatch_native_auto_resolves() -> i64 with IO, Mut, Panic, Div {
    let spec = native_resolve_target("native-auto", "auto", false)
    if str_len(spec.resolved_target) == 0 { return 1 }
    if spec.arch_id == ARCH_UNKNOWN() { return 2 }
    if spec.os_id == OS_UNKNOWN() { return 3 }
    0
}

// ============================================================================
// T12: Matrix parse normalization
// ============================================================================
fn native_test_dispatch_matrix_normalization() -> i64 with Mut, Panic, Div {
    if native_matrix_mode_parse("auto") != MATRIX_AUTO() { return 1 }
    if native_matrix_mode_parse("off") != MATRIX_OFF() { return 2 }
    if native_matrix_mode_parse("apple-amx") != MATRIX_APPLE_AMX() { return 3 }
    if native_matrix_mode_parse("intel-amx") != MATRIX_INTEL_AMX() { return 4 }
    if native_matrix_mode_parse("ime") != MATRIX_IME() { return 5 }
    if native_matrix_mode_parse("vme") != MATRIX_VME() { return 6 }
    if native_matrix_mode_parse("ame") != MATRIX_AME() { return 7 }
    if native_matrix_mode_parse("bad-mode") >= 0 { return 8 }
    if !str_eq(native_matrix_mode_string(MATRIX_VME()), "vme") { return 9 }
    0
}

// ============================================================================
// T13: compile_strategy metadata reaches native function codegen
// ============================================================================
fn native_test_compile_strategy_propagates_to_codegen() -> i64 with Mut, Panic, Div, Alloc {
    var func = ir_empty_function()
    func.name = ir_name_from_bytes(109, 97, 105, 110, 4)  // "main"
    func.reg_count = 3
    func.instr_count = 4
    func.compile_strategy = IR_STRATEGY_AGGRESSIVE
    ir_arena_store(ir_region_slot_w(func.region, (0)), ir_load_float(0, 1.5))
    ir_arena_store(ir_region_slot_w(func.region, (1)), ir_load_float(1, 2.5))
    ir_arena_store(ir_region_slot_w(func.region, (2)), ir_binop(2, 0, BinaryOp::OpAdd, 1))
    ir_arena_store(ir_region_slot_w(func.region, (3)), ir_return(2))

    var nc = compiler_new()
    nc = compile_ir_function(nc, func, 0)

    if nc.current_strategy != IR_STRATEGY_AGGRESSIVE { return 1 }
    if nc.code.len <= 0 { return 2 }
    if nc.rodata.len <= 0 { return 3 }
    0
}

// ============================================================================
// T14: strict FP modes keep source order; aggressive may commute float add/mul
// ============================================================================
fn native_test_float_strategy_changes_lowering() -> i64 with Mut, Panic, Div {
    let instr = ir_binop(2, 0, BinaryOp::OpAdd, 1)

    var standard = compiler_new()
    standard.current_strategy = IR_STRATEGY_STANDARD
    standard.is_float_reg[0] = 1
    standard.is_float_reg[1] = 1
    lower_ir_binop(&!standard, instr)

    var precision = compiler_new()
    precision.current_strategy = IR_STRATEGY_PRECISION_PRESERVING
    precision.is_float_reg[0] = 1
    precision.is_float_reg[1] = 1
    lower_ir_binop(&!precision, instr)

    var aggressive = compiler_new()
    aggressive.current_strategy = IR_STRATEGY_AGGRESSIVE
    aggressive.is_float_reg[0] = 1
    aggressive.is_float_reg[1] = 1
    lower_ir_binop(&!aggressive, instr)

    if standard.is_float_reg[2] != 1 { return 1 }
    if precision.is_float_reg[2] != 1 { return 2 }
    if aggressive.is_float_reg[2] != 1 { return 3 }
    if !native_code_eq(standard.code, precision.code) { return 4 }
    if native_code_eq(standard.code, aggressive.code) { return 5 }
    if standard.code.len < 19 || aggressive.code.len < 19 { return 6 }

    // strict/standard path: first load uses src1 (rbp-8), second load uses src2 (rbp-16)
    if native_byte_u8(standard.code.bytes[3]) != 0xf8 { return 7 }
    if native_byte_u8(standard.code.bytes[15]) != 0xf0 { return 8 }
    // aggressive path: commuted add loads src2 first, then src1
    if native_byte_u8(aggressive.code.bytes[3]) != 0xf0 { return 9 }
    if native_byte_u8(aggressive.code.bytes[15]) != 0xf8 { return 10 }
    0
}

// ============================================================================
// Test runner
// ============================================================================
fn run_native_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    let total: i64 = 15

    print("=== Native Backend Tests ===\n")

    if native_test_emit_exit_bytes() { passed = passed + 1; print("  T01 OK (emit_exit bytes)\n") } else { print("  FAIL: T01 emit_exit bytes\n") }

    if native_test_compile_simple() == 0 { passed = passed + 1; print("  T02 OK (simple function -> ELF)\n") } else { print("  FAIL: T02 compile simple function\n") }

    if native_test_compile_arithmetic() == 0 { passed = passed + 1; print("  T03 OK (arithmetic -> ELF)\n") } else { print("  FAIL: T03 compile with arithmetic\n") }

    if native_test_compile_call() == 0 { passed = passed + 1; print("  T04 OK (function calls -> ELF)\n") } else { print("  FAIL: T04 compile with function call\n") }

    if native_test_compile_struct() == 0 { passed = passed + 1; print("  T05 OK (struct alloc+field -> ELF)\n") } else { print("  FAIL: T05 compile with struct\n") }

    if native_test_compile_array() == 0 { passed = passed + 1; print("  T06 OK (array alloc+index -> ELF)\n") } else { print("  FAIL: T06 compile with array\n") }

    if native_test_compile_get_arg_count() == 0 { passed = passed + 1; print("  T07 OK (get_arg_count -> ELF)\n") } else { print("  FAIL: T07 compile with get_arg_count\n") }

    if native_test_compile_str_len() == 0 { passed = passed + 1; print("  T08 OK (str_len -> ELF)\n") } else { print("  FAIL: T08 compile with str_len\n") }

    if native_test_compile_file_size() == 0 { passed = passed + 1; print("  T09 OK (file_size -> ELF)\n") } else { print("  FAIL: T09 compile with file_size\n") }

    if native_test_dispatch_explicit_unimplemented() == 0 { passed = passed + 1; print("  T10 OK (explicit target fail-closed)\n") } else { print("  FAIL: T10 explicit target fail-closed\n") }

    if native_test_dispatch_native_auto_resolves() == 0 { passed = passed + 1; print("  T11 OK (native-auto resolves)\n") } else { print("  FAIL: T11 native-auto resolves\n") }

    if native_test_dispatch_matrix_normalization() == 0 { passed = passed + 1; print("  T12 OK (matrix normalization)\n") } else { print("  FAIL: T12 matrix normalization\n") }

    if native_test_compile_strategy_propagates_to_codegen() == 0 { passed = passed + 1; print("  T13 OK (compile strategy reaches codegen)\n") } else { print("  FAIL: T13 compile strategy reaches codegen\n") }

    if native_test_float_strategy_changes_lowering() == 0 { passed = passed + 1; print("  T14 OK (float strategy changes lowering)\n") } else { print("  FAIL: T14 float strategy changes lowering\n") }

    if cgplan_run_tests() == 0 { passed = passed + 1; print("  T15 OK (codegen plan multiblock)\n") } else { print("  FAIL: T15 codegen plan multiblock\n") }

    print("\nNative tests: ")
    print_int(passed)
    print("/")
    print_int(total)
    print(" passed\n")

    if passed == total { 0 } else { 1 }
}
