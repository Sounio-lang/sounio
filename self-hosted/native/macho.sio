// Test runner
// ============================================================================

pub fn test_macho_main() -> i64 with Mut, Panic, Div {
    var failed = 0

    if test_macho_header_magic() != 0 { failed = failed + 1 }
    if test_macho_header_x86_64() != 0 { failed = failed + 1 }
    if test_macho_header_arm64() != 0 { failed = failed + 1 }
