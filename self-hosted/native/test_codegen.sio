// self-hosted::native::test_codegen — Integration tests for native codegen
//
// Tests each phase incrementally.

use native::encode::*
use native::frame::*
use native::elf::*
use native::reloc::*
use native::codegen::*
use native::regs::*
use native::regalloc::*
use ir::ir::*
use parser::ast::*

// Phase 0: Basic setup tests
fn tc_test_codegen_init() -> i64 {
    let cg = codegen_new()
    if cg.fn_count != 0 { return 1 }
    if cg.current_offset != 0 { return 2 }
    0
}

fn tc_test_stack_frame_allocation() -> i64 {
    let frame = prepare_frame(2, 3)  // 2 params, 3 locals

    // Total vars: 5, each 8 bytes = 40 bytes
    // Aligned to 16: 48 bytes
    if frame.frame_size != 48 { return 1 }
    if frame.param_count != 2 { return 2 }
    if frame.local_count != 3 { return 3 }

    0
}

fn tc_test_align16() -> i64 {
    if align16(0) != 0 { return 1 }
    if align16(1) != 16 { return 2 }
    if align16(16) != 16 { return 3 }
    if align16(17) != 32 { return 4 }
    if align16(32) != 32 { return 5 }
    0
}

fn tc_test_param_offset() -> i64 {
    // Params: rbp-8, rbp-16, rbp-24
    if param_offset(0) != -8 { return 1 }
    if param_offset(1) != -16 { return 2 }
    if param_offset(2) != -24 { return 3 }
    0
}

fn tc_test_local_offset_calculation() -> i64 {
    let frame = prepare_frame(2, 3)  // 2 params, 3 locals

    // Locals come after params
    // Local 0: rbp-24 (after 2 params at rbp-8, rbp-16)
    let offset0 = local_offset(frame, 0)
    if offset0 != -24 { return 1 }

    let offset1 = local_offset(frame, 1)
    if offset1 != -32 { return 2 }

    0
}

fn tc_test_reloc_table_creation() -> i64 {
    let table = reloc_table_new()
    if table.count != 0 { return 1 }
    0
}

fn tc_test_add_call_relocation() -> i64 {
    var table = reloc_table_new()
    table = add_call_reloc(table, 100, 5)  // offset=100, target_func=5

    if table.count != 1 { return 1 }

    let reloc = table.entries[0]
    if reloc.offset != 100 { return 2 }
    if reloc.target.target_index != 5 { return 3 }

    0
}

fn tc_test_reg_alloc() -> i64 {
    let allocator = reg_alloc_new()
    if allocator.next_reg != 0 { return 1 }
    0
}

fn tc_test_param_reg_mapping() -> i64 {
    if param_reg(0) != reg_rdi() { return 1 }
    if param_reg(1) != reg_rsi() { return 2 }
    if param_reg(2) != reg_rdx() { return 3 }
    if param_reg(3) != reg_rcx() { return 4 }
    if param_reg(4) != reg_r8() { return 5 }
    if param_reg(5) != reg_r9() { return 6 }
    if param_reg(6) != -1 { return 7 }  // No more param regs
    0
}

// Phase 1 tests (will expand in next phase)
fn tc_test_emit_prologue() -> i64 {
    var buf = code_buffer_new()
    buf = emit_prologue(buf, 16)

    // Should emit: push rbp; mov rbp, rsp; sub rsp, 16
    // Verify first few bytes
    if buf.len < 8 { return 1 }
    if buf.bytes[0] != 0x55 { return 2 }  // push rbp

    0
}

fn tc_test_emit_epilogue() -> i64 {
    var buf = code_buffer_new()
    buf = emit_epilogue(buf)

    // Should emit: mov rsp, rbp; pop rbp; ret
    if buf.len < 4 { return 1 }
    if buf.bytes[buf.len - 1] != 0xc3 { return 2 }  // ret

    0
}

// Test runner
fn test_codegen_main() -> i64 with Mut, Panic, Div {
    var failed = 0

    if tc_test_codegen_init() != 0 { failed = failed + 1 }
    if tc_test_stack_frame_allocation() != 0 { failed = failed + 1 }
    if tc_test_align16() != 0 { failed = failed + 1 }
    if tc_test_param_offset() != 0 { failed = failed + 1 }
    if tc_test_local_offset_calculation() != 0 { failed = failed + 1 }
    if tc_test_reloc_table_creation() != 0 { failed = failed + 1 }
    if tc_test_add_call_relocation() != 0 { failed = failed + 1 }
    if tc_test_reg_alloc() != 0 { failed = failed + 1 }
    if tc_test_param_reg_mapping() != 0 { failed = failed + 1 }
    if tc_test_emit_prologue() != 0 { failed = failed + 1 }
    if tc_test_emit_epilogue() != 0 { failed = failed + 1 }

    failed
}
