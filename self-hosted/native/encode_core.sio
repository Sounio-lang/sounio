// self-hosted::native::encode_core — CodeBuffer infrastructure
//
// Base byte-buffer type and primitive emitters used by native::encode.
// Split out to allow lightweight imports (probes, tests) without pulling in
// the full x86-64 instruction encoder (~1568 lines, 160 functions).
//
// Consumers that need the full encoder: use native::encode::*

module native::encode_core

struct CodeBuffer {
    bytes: [i8; 2097152],
    len: i64,
}

fn code_buffer_new() -> CodeBuffer {
    var out: CodeBuffer
    out.len = 0
    out
}

fn low8(x: i64) -> i64 with Mut, Panic, Div {
    var n = x % 256
    if n < 0 { n = n + 256 }
    n
}

fn emit_byte(buf: CodeBuffer, b: i64) -> CodeBuffer with Mut, Panic, Div {
    var out = buf
    if out.len >= 0 {
        if out.len < 2097152 {
            out.bytes[out.len as usize] = low8(b) as i8
            out.len = out.len + 1
        }
    }
    out
}

fn emit_u32_le(buf: CodeBuffer, val: i64) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, low8(val))
    b = emit_byte(b, low8(val >> 8))
    b = emit_byte(b, low8(val >> 16))
    b = emit_byte(b, low8(val >> 24))
    b
}

fn emit_u64_le(buf: CodeBuffer, val: i64) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_u32_le(b, val)
    b = emit_u32_le(b, val >> 32)
    b
}

fn modrm_rr(dst: i64, src: i64) -> i64 {
    192 + src * 8 + dst
}

fn modrm_rm_imm(dst: i64) -> i64 {
    192 + dst
}
