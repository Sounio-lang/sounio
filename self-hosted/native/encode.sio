pub fn emit_load_rax_mem_rdx_rbx8(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 8b 04 da — mov rax, [rdx + rbx*8]
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x8b)
    b = emit_byte(b, 0x04)
    b = emit_byte(b, 0xda)
    b
}

pub fn emit_store_rax_mem_rdx_rbx8(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 89 04 da — mov [rdx + rbx*8], rax
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0x04)
    b = emit_byte(b, 0xda)
    b
}

// mov rbx, rdi — save first arg to rbx
pub fn emit_mov_rbx_rdi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 89 fb — mov rbx, rdi
    emit_mov_reg_reg(buf, 3, 7)
}

// mov rdi, rsi — move second arg to first arg register
pub fn emit_mov_rdi_rsi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_mov_reg_reg(buf, 7, 6)
}

// mov rsi, rdx — move third arg to second arg register
pub fn emit_mov_rsi_rdx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_mov_reg_reg(buf, 6, 2)
}

// mov rdx, rcx — move fourth arg to third arg register
pub fn emit_mov_rdx_rcx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_mov_reg_reg(buf, 2, 1)
}

// cmp byte [rdi], 0 — compare byte at rdi with zero
pub fn emit_cmp_byte_rdi_zero(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 80 3f 00 — cmp byte [rdi], 0
    var b = buf
    b = emit_byte(b, 0x80)
    b = emit_byte(b, 0x3f)
    b = emit_byte(b, 0x00)
    b
}

// movzx rax, byte [rsi] — zero-extend byte at rsi into rax
pub fn emit_movzx_rax_byte_rsi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 0f b6 06 — movzx rax, byte [rsi]
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0xb6)
    b = emit_byte(b, 0x06)
    b
}

// inc rsi — increment rsi
pub fn emit_inc_rsi_bare(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 ff c6 — inc rsi
    emit_inc_rsi(buf)
}

// cmp al, [rdi] — compare al with byte at rdi
pub fn emit_cmp_al_mem_rdi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 3a 07 — cmp al, [rdi]
    var b = buf
    b = emit_byte(b, 0x3a)
    b = emit_byte(b, 0x07)
    b
}

// push rsi — save rsi on stack
pub fn emit_push_rsi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x56)
}

// push rdx — save rdx on stack
pub fn emit_push_rdx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x52)
}

// push rcx — save rcx on stack
pub fn emit_push_rcx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
