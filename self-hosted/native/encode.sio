// --- Arithmetic helpers ---

pub fn emit_xor_rax_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 31 c0 — xor rax, rax
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x31)
    b = emit_byte(b, 0xc0)
    b
}

pub fn emit_neg_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 f7 d8 — neg rax
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xf7)
    b = emit_byte(b, 0xd8)
    b
}

pub fn emit_not_bool_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // test rax, rax; sete al; movzx rax, al
    var b = buf
    b = emit_test_rax_rax(b)
    b = emit_sete_al(b)
    b = emit_movzx_rax_al(b)
    b
}

// --- Division support ---

pub fn emit_cqo(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 99 — cqo (sign-extend rax into rdx:rax)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x99)
    b
}

pub fn emit_idiv_rcx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 f7 f9 — idiv rcx
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xf7)
    b = emit_byte(b, 0xf9)
    b
}

// --- disp32 memory operations (stack locals) ---

pub fn emit_store_rax_rbp_disp32(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 89 85 <disp32> — mov [rbp + disp32], rax
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0x85)
    b = emit_u32_le(b, disp)
    b
}

pub fn emit_load_rbp_disp32_rax(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 8b 85 <disp32> — mov rax, [rbp + disp32]
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x8b)
    b = emit_byte(b, 0x85)
    b = emit_u32_le(b, disp)
    b
}

pub fn emit_store_reg_rbp_disp32(buf: CodeBuffer, disp: i64, reg: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 89 <85+reg*8> <disp32> — mov [rbp + disp32], reg
    // Only works for registers 0..7 (no REX.B)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0x85 + reg * 8)
    b = emit_u32_le(b, disp)
    b
}

// --- Call and trap ---

pub fn emit_call_rel32_placeholder(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // e8 <rel32> — call rel32 (placeholder 0)
    var b = buf
    b = emit_byte(b, 0xe8)
    b = emit_u32_le(b, 0)
    b
}

pub fn emit_call_mem_rip_disp32(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // ff 15 <disp32> — call qword [rip+disp32] (indirect call through RIP-relative memory)
    // Used for Windows IAT calls (ExitProcess, VirtualAlloc via import address table)
    var b = buf
    b = emit_byte(b, 0xff)
    b = emit_byte(b, 0x15)
    b = emit_u32_le(b, disp)
    b
}

pub fn emit_ud2(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 0f 0b — ud2 (undefined instruction trap)
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x0b)
    b
}

// --- Convenience register moves ---

pub fn emit_mov_rdi_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // mov rdi, rax
    emit_mov_reg_reg(buf, 7, 0)
}

pub fn emit_mov_rcx_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // mov rcx, rax
    emit_mov_reg_reg(buf, 1, 0)
}

pub fn emit_mov_rax_rbx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // mov rax, rbx
    emit_mov_reg_reg(buf, 0, 3)
}

pub fn emit_mov_rax_rdx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // mov rax, rdx
    emit_mov_reg_reg(buf, 0, 2)
}

// LEA rax, [rip + disp32] — load effective address (for string literals)
pub fn emit_lea_rax_rip_disp32(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 8d 05 <disp32> — lea rax, [rip + disp32]
    var b = buf
    b = emit_byte(b, 0x48)        // REX.W
    b = emit_byte(b, 0x8d)        // lea r64, m
    b = emit_byte(b, 0x05)        // ModRM: [rip + disp32], rax
    b = emit_u32_le(b, disp)
    b
}

// MOV rax, [rip + disp32] — load qword from RIP-relative address (for .data counters)
pub fn emit_mov_rax_rip_disp32(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 8b 05 <disp32> — mov rax, [rip + disp32]
    var b = buf
    b = emit_byte(b, 0x48)        // REX.W
    b = emit_byte(b, 0x8B)        // MOV r64, r/m64
    b = emit_byte(b, 0x05)        // ModRM: [rip + disp32], rax
    b = emit_u32_le(b, disp)
    b
}

// MOV rbx, [rip + disp32] — load qword from RIP-relative address
pub fn emit_mov_rbx_rip_disp32(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 8b 1d <disp32> — mov rbx, [rip + disp32]
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x8B)
    b = emit_byte(b, 0x1D)
    b = emit_u32_le(b, disp)
    b
}

// MOV [rip + disp32], rax — store qword to RIP-relative address
pub fn emit_mov_rip_disp32_rax(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 89 05 <disp32> — mov [rip + disp32], rax
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0x05)
    b = emit_u32_le(b, disp)
    b
}

