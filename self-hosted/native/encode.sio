// mov rsi, rax — move rax to rsi
fn emit_mov_rsi_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_mov_reg_reg(buf, 6, 0)
}

// mov rdx, rax — move rax to rdx
