fn emit_movzx_rax_byte_rdi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 0f b6 07 — movzx rax, byte [rdi]
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0xb6)
    b = emit_byte(b, 0x07)
