// ============================================================================
// Bitwise and shift operations
// ============================================================================

// and rax, rbx — 48 21 d8
pub fn emit_and_rax_rbx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x21)
    b = emit_byte(b, 0xd8)
    b
}

// or rax, rbx — 48 09 d8
pub fn emit_or_rax_rbx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x09)
    b = emit_byte(b, 0xd8)
    b
}

// xor rax, rbx — 48 31 d8
pub fn emit_xor_rax_rbx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x31)
    b = emit_byte(b, 0xd8)
    b
}

// shl rax, cl — 48 d3 e0
// Shift rax left by cl bits (cl holds the shift count)
pub fn emit_shl_rax_cl(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xd3)
    b = emit_byte(b, 0xe0)
    b
}

// sar rax, cl — 48 d3 f8
// Arithmetic shift rax right by cl bits (SIGNED; preserves sign bit)
pub fn emit_sar_rax_cl(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xd3)
    b = emit_byte(b, 0xf8)
    b
}

// SHR rax, cl — LOGICAL right shift. The one this file was missing.
//
// Verified against as(1): `shr rax, cl` assembles to 48 D3 E8, `sar` to
// 48 D3 F8, `shl` to 48 D3 E0. Only the last two had encoders, so anyone
// needing a logical shift either hand-wrote the bytes -- codegen.sio does
// exactly that when extracting a biased exponent, with the comment
// "shr rax, cl: 48 D3 E8" -- or reached for emit_sar_rax_cl and relied on the
// sign bit being clear. The second habit is the dangerous one: it is correct
// until the value it shifts can go negative, and then it is wrong by 2^64
// with nothing to notice.
pub fn emit_shr_rax_cl(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 D3 E8
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xD3)
    b = emit_byte(b, 0xE8)
    b
}

// mov rcx, rbx — 48 89 d9
pub fn emit_mov_rcx_rbx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0xd9)
    b
}

// not rax — 48 f7 d0
pub fn emit_not_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xf7)
    b = emit_byte(b, 0xd0)
    b
}

// test rax, rax; setne al; movzx rax, al — logical AND short-circuit result (rax = rax && rbx)
// For OpAnd: result = (lhs != 0) & (rhs != 0)
pub fn emit_and_bool_rax_rbx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    // test rbx, rbx; setne cl
    emit_byte_mut(&!b, 0x48)   // test rbx, rbx
    emit_byte_mut(&!b, 0x85)
    emit_byte_mut(&!b, 0xdb)
    emit_byte_mut(&!b, 0x0f)   // setne cl
    emit_byte_mut(&!b, 0x95)
    emit_byte_mut(&!b, 0xc1)
    // test rax, rax; setne al
    emit_byte_mut(&!b, 0x48)   // test rax, rax
    emit_byte_mut(&!b, 0x85)
    emit_byte_mut(&!b, 0xc0)
    emit_byte_mut(&!b, 0x0f)   // setne al
    emit_byte_mut(&!b, 0x95)
    emit_byte_mut(&!b, 0xc0)
    // and al, cl
    emit_byte_mut(&!b, 0x20)
    emit_byte_mut(&!b, 0xc8)
    // movzx rax, al
    emit_byte_mut(&!b, 0x48)
    emit_byte_mut(&!b, 0x0f)
    emit_byte_mut(&!b, 0xb6)
    emit_byte_mut(&!b, 0xc0)
    b
}

// For OpOr: result = (lhs != 0) | (rhs != 0)
pub fn emit_or_bool_rax_rbx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    // test rbx, rbx; setne cl
    emit_byte_mut(&!b, 0x48)
    emit_byte_mut(&!b, 0x85)
    emit_byte_mut(&!b, 0xdb)
    emit_byte_mut(&!b, 0x0f)
    emit_byte_mut(&!b, 0x95)
    emit_byte_mut(&!b, 0xc1)
    // test rax, rax; setne al
    emit_byte_mut(&!b, 0x48)
    emit_byte_mut(&!b, 0x85)
    emit_byte_mut(&!b, 0xc0)
    emit_byte_mut(&!b, 0x0f)
    emit_byte_mut(&!b, 0x95)
    emit_byte_mut(&!b, 0xc0)
    // or al, cl
    emit_byte_mut(&!b, 0x08)
    emit_byte_mut(&!b, 0xc8)
    // movzx rax, al
    emit_byte_mut(&!b, 0x48)
    emit_byte_mut(&!b, 0x0f)
    emit_byte_mut(&!b, 0xb6)
    emit_byte_mut(&!b, 0xc0)
    b
}

// store rax to rbp-relative slot, used for misc spills
pub fn emit_store_rax_rbp_disp8(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // mov [rbp + disp8], rax — 48 89 45 <disp>
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0x45)
    b = emit_byte(b, low8(disp))
    b
}

// load rax from rbp-relative slot (disp8 short form — 4 bytes vs disp32's 7)
pub fn emit_load_rbp_disp8_rax(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // mov rax, [rbp + disp8] — 48 8B 45 <disp>
    // REX.W=0x48, opcode MOV r64,rm64=0x8B, ModRM=0x45 (mod=01 reg=rax=0 rm=rbp=5), disp8
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x8b)
    b = emit_byte(b, 0x45)
    b = emit_byte(b, low8(disp))
    b
}


// CPUID leaf-7 AVX-512F probe
//
// Emits 22 bytes that detect AVX-512F support at runtime:
//   B8 07 00 00 00       MOV eax, 7      (leaf 7: Extended Features)
//   31 C9                XOR ecx, ecx    (sub-leaf 0)
//   0F A2                CPUID
//   F7 C3 00 00 01 00    TEST ebx, 0x10000  (bit 16 = AVX-512F)
//   0F 94 C0             SETE al
//   48 0F B6 C0          MOVZX rax, al  (result: 1 = AVX-512F present, 0 = absent)
//
// Intended for use in a dedicated startup probe function whose return value
// gates AVX-512 vs scalar code paths (Horizon 3.2 runtime dispatch).
pub fn emit_cpuid_avx512_check(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    // MOV eax, 7  — B8 07 00 00 00
    b = emit_byte(b, 0xB8)
    b = emit_byte(b, 7)
    b = emit_byte(b, 0)
    b = emit_byte(b, 0)
    b = emit_byte(b, 0)
    // XOR ecx, ecx  — 31 C9
    b = emit_byte(b, 0x31)
    b = emit_byte(b, 0xC9)
    // CPUID  — 0F A2
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0xA2)
    // TEST ebx, 0x10000  — F7 C3 00 00 01 00
    b = emit_byte(b, 0xF7)
    b = emit_byte(b, 0xC3)
    b = emit_byte(b, 0)
    b = emit_byte(b, 0)
    b = emit_byte(b, 1)
    b = emit_byte(b, 0)
    // SETE al  — 0F 94 C0
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x94)
    b = emit_byte(b, 0xC0)
    // MOVZX rax, al  — 48 0F B6 C0
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0xB6)
    b = emit_byte(b, 0xC0)
    b
}

// lea rax, [rbp + disp32] — compute address of stack slot into rax
// 48 8d 85 <disp32>
pub fn emit_lea_rax_rbp_disp32(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x8d)
    b = emit_byte(b, 0x85)
    b = emit_u32_le(b, disp)
    b
}

// Win64 ABI helpers — register moves involving R8-R15 (need REX.B/REX.R)

pub fn emit_call_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // FF D0 — call rax
    var b = buf
    b = emit_byte(b, 0xFF)
    b = emit_byte(b, 0xD0)
    b
}

pub fn emit_mov_r8_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 49 89 C0 — mov r8, rax (REX.WB=0x49, 0x89, ModRM=0xC0)
    var b = buf
    b = emit_byte(b, 0x49)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0xC0)
    b
}

pub fn emit_mov_rax_mem_rsp_disp8(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 8B 44 24 <disp8> — mov rax, [rsp+disp8]
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x8B)
    b = emit_byte(b, 0x44)
    b = emit_byte(b, 0x24)
    b = emit_byte(b, disp & 0xFF)
    b
}

pub fn emit_lea_r9_rsp_disp8(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 4C 8D 4C 24 <disp8> — lea r9, [rsp+disp8]
    var b = buf
    b = emit_byte(b, 0x4C)
    b = emit_byte(b, 0x8D)
    b = emit_byte(b, 0x4C)
    b = emit_byte(b, 0x24)
    b = emit_byte(b, disp & 0xFF)
    b
}

pub fn emit_lea_r8_rsp_disp8(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 4C 8D 44 24 <disp8> — lea r8, [rsp+disp8]
    var b = buf
    b = emit_byte(b, 0x4C)
    b = emit_byte(b, 0x8D)
    b = emit_byte(b, 0x44)
    b = emit_byte(b, 0x24)
    b = emit_byte(b, disp & 0xFF)
    b
}

pub fn emit_mov_qword_rsp_disp8_zero(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 C7 44 24 <disp8> 00 00 00 00 — mov qword [rsp+disp8], 0
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xC7)
    b = emit_byte(b, 0x44)
    b = emit_byte(b, 0x24)
    b = emit_byte(b, disp & 0xFF)
    b = emit_u32_le(b, 0)
    b
}

// AVX10.2 dual-probe capability detection — 77 bytes.
//
// Probe 1 (CPUID leaf 7, subleaf 1, EDX[19]):  checks AVX10 base.
// Probe 2 (CPUID leaf 0x24, subleaf 0):         extracts VL mask + version.
//   EBX[7:0]  = version (1=AVX10.1, 2=AVX10.2)
//   EBX[18]   = AVX10_512  EBX[17] = AVX10_256  EBX[16] = AVX10_128
// Fallback:   leaf 7.0 EBX[16] for legacy AVX-512F CPUs.
//
// Postconditions:
//   r15  = VL capability mask: bit0=128, bit1=256, bit2=512 (preserved across main)
//   rax  = 1 if any vector support, 0 otherwise
//
// Fixed control-flow layout (byte offsets from function start):
//   0x00  probe1 (18 bytes: MOV eax,7 / MOV ecx,1 / CPUID / TEST edx,0x80000)
//   0x12  JZ rel8=20  → .no_avx10 at 0x28
//   0x14  probe2 (18 bytes: MOV eax,0x24 / XOR ecx,ecx / CPUID / SHR / AND / MOV r15d,ebx)
//   0x26  JMP rel8=27 → .done at 0x43
//   0x28  .no_avx10 (27 bytes: leaf 7.0 / SETE / SHL / MOV r15d,eax)
//   0x43  .done (10 bytes: TEST r15d,r15d / SETNE al / MOVZX rax,al)
pub fn emit_avx10_detect(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf

    // --- Probe 1: CPUID(7, 1) — EDX[19] = AVX10 base ---
    // MOV eax, 7
    b = emit_byte(b, 0xB8); b = emit_byte(b, 7); b = emit_byte(b, 0); b = emit_byte(b, 0); b = emit_byte(b, 0)
    // MOV ecx, 1  (subleaf 1)
    b = emit_byte(b, 0xB9); b = emit_byte(b, 1); b = emit_byte(b, 0); b = emit_byte(b, 0); b = emit_byte(b, 0)
    // CPUID
    b = emit_byte(b, 0x0F); b = emit_byte(b, 0xA2)
    // TEST edx, 0x80000  (bit 19 = 0x00080000 LE: 00 00 08 00)
    b = emit_byte(b, 0xF7); b = emit_byte(b, 0xC2); b = emit_byte(b, 0); b = emit_byte(b, 0); b = emit_byte(b, 0x08); b = emit_byte(b, 0)
    // JZ .no_avx10  (rel8 = 20: skip 18-byte probe2 + 2-byte JMP)
    b = emit_byte(b, 0x74); b = emit_byte(b, 20)

    // --- Probe 2 (AVX10 confirmed): CPUID(0x24, 0) — VL mask into r15 ---
    // MOV eax, 0x24
    b = emit_byte(b, 0xB8); b = emit_byte(b, 0x24); b = emit_byte(b, 0); b = emit_byte(b, 0); b = emit_byte(b, 0)
    // XOR ecx, ecx
    b = emit_byte(b, 0x31); b = emit_byte(b, 0xC9)
    // CPUID
    b = emit_byte(b, 0x0F); b = emit_byte(b, 0xA2)
    // SHR ebx, 16  (C1 EB 10): shift VL bits [18:16] down to [2:0]
    b = emit_byte(b, 0xC1); b = emit_byte(b, 0xEB); b = emit_byte(b, 16)
    // AND ebx, 7  (83 E3 07): mask to VL bits only
    b = emit_byte(b, 0x83); b = emit_byte(b, 0xE3); b = emit_byte(b, 7)
    // MOV r15d, ebx  (41 89 DF): store VL mask; zero-extends r15
    b = emit_byte(b, 0x41); b = emit_byte(b, 0x89); b = emit_byte(b, 0xDF)
    // JMP .done  (EB 1A, rel8 = 26: skip 26-byte .no_avx10 block)
    b = emit_byte(b, 0xEB); b = emit_byte(b, 26)

    // --- .no_avx10: legacy AVX-512F fallback (CPUID leaf 7.0 EBX[16]) ---
    // MOV eax, 7
    b = emit_byte(b, 0xB8); b = emit_byte(b, 7); b = emit_byte(b, 0); b = emit_byte(b, 0); b = emit_byte(b, 0)
    // XOR ecx, ecx  (subleaf 0)
    b = emit_byte(b, 0x31); b = emit_byte(b, 0xC9)
    // CPUID
    b = emit_byte(b, 0x0F); b = emit_byte(b, 0xA2)
    // XOR r15d, r15d  (45 31 FF): default to no vector support
    b = emit_byte(b, 0x45); b = emit_byte(b, 0x31); b = emit_byte(b, 0xFF)
    // TEST ebx, 0x10000  (F7 C3 00 00 01 00)
    b = emit_byte(b, 0xF7); b = emit_byte(b, 0xC3); b = emit_byte(b, 0); b = emit_byte(b, 0); b = emit_byte(b, 1); b = emit_byte(b, 0)
    // JZ .done  (74 06): skip MOV r15d,4 if no AVX-512F
    b = emit_byte(b, 0x74); b = emit_byte(b, 6)
    // MOV r15d, 4  (41 BF 04 00 00 00): bit2 = 512-bit VL
    b = emit_byte(b, 0x41); b = emit_byte(b, 0xBF); b = emit_byte(b, 4); b = emit_byte(b, 0); b = emit_byte(b, 0); b = emit_byte(b, 0)

    // --- .done: rax = 1 if any vector support (r15 != 0) ---
    // TEST r15d, r15d  (45 85 FF)
    b = emit_byte(b, 0x45); b = emit_byte(b, 0x85); b = emit_byte(b, 0xFF)
    // SETNE al  (0F 95 C0)
    b = emit_byte(b, 0x0F); b = emit_byte(b, 0x95); b = emit_byte(b, 0xC0)
    // MOVZX rax, al  (48 0F B6 C0)
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x0F); b = emit_byte(b, 0xB6); b = emit_byte(b, 0xC0)
    b
}

// ============================================================================
// SSE2 scalar double-precision instruction encoders
// ============================================================================

// MOVSD xmm0, [rip + disp32] — load f64 from .rodata
pub fn emit_movsd_xmm0_rip_disp32(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // F2 0F 10 05 <disp32>
    var b = buf
    b = emit_byte(b, 0xF2)
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x10)
    b = emit_byte(b, 0x05)   // ModRM: mod=00 reg=xmm0 r/m=101 (RIP)
    b = emit_u32_le(b, disp)
    b
}

// MOVSD xmm1, [rip + disp32] — load f64 from .rodata into xmm1
pub fn emit_movsd_xmm1_rip_disp32(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // F2 0F 10 0D <disp32>
    var b = buf
    b = emit_byte(b, 0xF2)
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x10)
    b = emit_byte(b, 0x0D)   // ModRM: mod=00 reg=xmm1 r/m=101 (RIP)
    b = emit_u32_le(b, disp)
    b
}

// MOVQ xmm0, rax — transfer GPR to XMM (for stack-spilled f64)
pub fn emit_movq_xmm0_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 66 48 0F 6E C0
    var b = buf
    b = emit_byte(b, 0x66)
    b = emit_byte(b, 0x48)   // REX.W
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x6E)
    b = emit_byte(b, 0xC0)   // ModRM: xmm0, rax
    b
}

// MOVQ xmm1, rax — transfer GPR to XMM
pub fn emit_movq_xmm1_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 66 48 0F 6E C8
    var b = buf
    b = emit_byte(b, 0x66)
    b = emit_byte(b, 0x48)   // REX.W
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x6E)
    b = emit_byte(b, 0xC8)   // ModRM: xmm1, rax
    b
}

// MOVQ rax, xmm0 — transfer XMM to GPR (for stack spill)
pub fn emit_movq_rax_xmm0(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 66 48 0F 7E C0
    var b = buf
    b = emit_byte(b, 0x66)
    b = emit_byte(b, 0x48)   // REX.W
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x7E)
    b = emit_byte(b, 0xC0)   // ModRM: xmm0, rax
    b
}

// ADDSD xmm0, xmm1 — scalar double add
pub fn emit_addsd_xmm0_xmm1(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // F2 0F 58 C1
    var b = buf
    b = emit_byte(b, 0xF2)
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x58)
    b = emit_byte(b, 0xC1)   // ModRM: xmm0, xmm1
    b
}

// SUBSD xmm0, xmm1 — scalar double subtract
pub fn emit_subsd_xmm0_xmm1(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // F2 0F 5C C1
    var b = buf
    b = emit_byte(b, 0xF2)
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x5C)
    b = emit_byte(b, 0xC1)
    b
}

// MULSD xmm0, xmm1 — scalar double multiply
pub fn emit_mulsd_xmm0_xmm1(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // F2 0F 59 C1
    var b = buf
    b = emit_byte(b, 0xF2)
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x59)
    b = emit_byte(b, 0xC1)
    b
}

// DIVSD xmm0, xmm1 — scalar double divide
pub fn emit_divsd_xmm0_xmm1(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // F2 0F 5E C1
    var b = buf
    b = emit_byte(b, 0xF2)
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x5E)
    b = emit_byte(b, 0xC1)
    b
}


// SQRTSD xmm0, xmm0 — square root of scalar double in xmm0
pub fn emit_sqrtsd_xmm0_xmm0(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // F2 0F 51 C0
    var b = buf
    b = emit_byte(b, 0xF2)
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x51)
    b = emit_byte(b, 0xC0)
    b
}

// MOVSD xmm0/xmm1 <-> [rbp+disp32] — the disp32 forms of the four disp8 slot
// moves above.
//
// Added because disp8 caps the frame at 15 double slots below rbp, and that
// cap is a code limit masquerading as a numerical one. The comment on
// emit_horner_step already records this failure mode once: the exp and log
// emitters open-coded their Horner steps and stopped at degree 6 and degree 4
// because the code, not the mathematics, set the accuracy. A double-double
// pow needs more live intermediates than 15, so the same wall was waiting.
//
// Encoding differs from the disp8 form only in ModRM.mod (10 instead of 01)
// and a 4-byte little-endian displacement: 0x85 for xmm0, 0x8D for xmm1.

pub fn emit_movsd_xmm0_rbp_disp32(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0xF2)
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x10)
    b = emit_byte(b, 0x85)   // ModRM: mod=10 reg=xmm0 r/m=rbp
    b = emit_u32_le(b, disp)
    b
}

pub fn emit_movsd_xmm1_rbp_disp32(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0xF2)
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x10)
    b = emit_byte(b, 0x8D)   // ModRM: mod=10 reg=xmm1 r/m=rbp
    b = emit_u32_le(b, disp)
    b
}

pub fn emit_movsd_rbp_disp32_xmm0(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0xF2)
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x11)
    b = emit_byte(b, 0x85)   // ModRM: mod=10 reg=xmm0 r/m=rbp
    b = emit_u32_le(b, disp)
    b
}

pub fn emit_movsd_rbp_disp32_xmm1(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0xF2)
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x11)
    b = emit_byte(b, 0x8D)   // ModRM: mod=10 reg=xmm1 r/m=rbp
    b = emit_u32_le(b, disp)
    b
}

// ROUNDSD xmm0, xmm0, imm8 — round scalar double under an explicit mode.
//
// SSE4.1 (66 0F 3A 0B /r ib). imm8 low two bits select the mode when bit 2 is
// clear: 0 = nearest-even, 1 = toward -inf (floor), 2 = toward +inf (ceil),
// 3 = toward zero (trunc). Bit 3 (0x08) suppresses the inexact exception,
// which is what libm's floor/ceil do, so callers pass 0x09 / 0x0A.
//
// This is one instruction where the alternative is a branch sequence around
// cvttsd2si, and the branch version is not merely longer: cvttsd2si saturates
// on |x| >= 2^63 and has no defined answer for NaN, so the emulation needs a
// magnitude guard and a NaN guard to stay IEEE-correct. ROUNDSD is correct on
// -0.0, on both infinities, and on NaN by construction.
//
// SSE4.1 has been present on every x86-64 part since Penryn (2007); this
// backend already targets Linux x86-64 only.
pub fn emit_roundsd_xmm0_xmm0_imm8(buf: CodeBuffer, mode: i64) -> CodeBuffer with Mut, Panic, Div {
    // 66 0F 3A 0B C0 ib
    var b = buf
    b = emit_byte(b, 0x66)
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x3A)
    b = emit_byte(b, 0x0B)
    b = emit_byte(b, 0xC0)
    b = emit_byte(b, mode)
    b
}

// UCOMISD xmm0, xmm1 — unordered compare scalar doubles (sets EFLAGS)
pub fn emit_ucomisd_xmm0_xmm1(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 66 0F 2E C1
    var b = buf
    b = emit_byte(b, 0x66)
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x2E)
    b = emit_byte(b, 0xC1)
    b
}

// SETA al — set al if above (CF=0 and ZF=0), for float >
pub fn emit_seta_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 0F 97 C0
    var b = buf
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x97)
    b = emit_byte(b, 0xC0)
    b
}

// SETAE al — set al if above or equal (CF=0), for float >=
pub fn emit_setae_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 0F 93 C0
    var b = buf
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x93)
    b = emit_byte(b, 0xC0)
    b
}

// SETB al — set al if below (CF=1), for float <
pub fn emit_setb_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 0F 92 C0
    var b = buf
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x92)
    b = emit_byte(b, 0xC0)
    b
}

// SETBE al — set al if below or equal (CF=1 or ZF=1), for float <=
pub fn emit_setbe_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 0F 96 C0
    var b = buf
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x96)
    b = emit_byte(b, 0xC0)
    b
}

// CVTSI2SD xmm0, rax — convert i64 to f64 (Sprint 87: int-to-float)
pub fn emit_cvtsi2sd_xmm0_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // F2 REX.W 0F 2A C0
    var b = buf
    b = emit_byte(b, 0xF2)  // REPNE prefix (SSE2 scalar)
    b = emit_byte(b, 0x48)  // REX.W (64-bit operand)
    b = emit_byte(b, 0x0F)  // escape
    b = emit_byte(b, 0x2A)  // CVTSI2SD opcode
    b = emit_byte(b, 0xC0)  // ModRM: xmm0 ← rax
    b
}

// CVTTSD2SI rax, xmm0 — truncate f64 to i64 (Sprint 87: float-to-int)
pub fn emit_sub_rax_rbx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 29 D8 — sub rax, rbx
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x29)
    b = emit_byte(b, 0xD8)
    b
}

pub fn emit_cvttsd2si_rax_xmm0(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // F2 REX.W 0F 2C C0
    var b = buf
    b = emit_byte(b, 0xF2)  // REPNE prefix (SSE2 scalar)
    b = emit_byte(b, 0x48)  // REX.W (64-bit operand)
    b = emit_byte(b, 0x0F)  // escape
    b = emit_byte(b, 0x2C)  // CVTTSD2SI opcode
    b = emit_byte(b, 0xC0)  // ModRM: rax ← xmm0
    b
}

// ============================================================================
// Sprint 52: r15 register helpers for register allocation
// ============================================================================

// push r15 — save r15 (callee-saved)
pub fn emit_push_r15(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 41 57 — push r15
    var b = buf
    b = emit_byte(b, 0x41)
    b = emit_byte(b, 0x57)
    b
}

// pop r15 — restore r15 (callee-saved)
pub fn emit_pop_r15(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 41 5F — pop r15
    var b = buf
    b = emit_byte(b, 0x41)
    b = emit_byte(b, 0x5F)
    b
}

// mov rax, r15 — load r15 into rax
pub fn emit_mov_rax_r15(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 4C 89 F8 — MOV rax, r15  (REX.W+REX.R, opcode 89, ModRM 11 111 000)
    var b = buf
    b = emit_byte(b, 0x4c)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0xf8)
    b
}

// mov r15, rax — store rax into r15
pub fn emit_mov_r15_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 49 89 C7 — MOV r15, rax  (REX.W+REX.B, opcode 89, ModRM 11 000 111)
    var b = buf
    b = emit_byte(b, 0x49)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0xc7)
    b
}

// mov rax, preg — load physical register (by x86 reg number) into rax
// Supports: rbx(3), r12(12), r13(13), r14(14), r15(15)
pub fn emit_mov_rax_preg(buf: CodeBuffer, x86reg: i64) -> CodeBuffer with Mut, Panic, Div {
    if x86reg == 15 {
        emit_mov_rax_r15(buf)
    } else if x86reg == 14 {
        // 4C 89 F0 — MOV rax, r14
        var b = buf
        b = emit_byte(b, 0x4c)
        b = emit_byte(b, 0x89)
        b = emit_byte(b, 0xf0)
        b
    } else if x86reg == 13 {
        emit_mov_rax_r13(buf)
    } else if x86reg == 12 {
        // 4C 89 E0 — MOV rax, r12
        var b = buf
        b = emit_byte(b, 0x4c)
        b = emit_byte(b, 0x89)
        b = emit_byte(b, 0xe0)
        b
    } else {
        // Registers 0-7: use standard MOV rax, reg (48 89 ModRM)
        emit_mov_reg_reg(buf, 0, x86reg)
    }
}

// mov preg, rax — store rax into physical register (by x86 reg number)
// Supports: rbx(3), r12(12), r13(13), r14(14), r15(15)
pub fn emit_mov_preg_rax(buf: CodeBuffer, x86reg: i64) -> CodeBuffer with Mut, Panic, Div {
    if x86reg == 15 {
        emit_mov_r15_rax(buf)
    } else if x86reg == 14 {
        // 49 89 C6 — MOV r14, rax
        var b = buf
        b = emit_byte(b, 0x49)
        b = emit_byte(b, 0x89)
        b = emit_byte(b, 0xc6)
        b
    } else if x86reg == 13 {
        emit_mov_r13_rax(buf)
    } else if x86reg == 12 {
        emit_mov_r12_rax(buf)
    } else {
        // Registers 0-7: use standard MOV reg, rax (48 89 ModRM)
        emit_mov_reg_reg(buf, x86reg, 0)
    }
}

// ============================================================================
// Sprint 119: f64 stack temp helpers for exp/log builtins
// ============================================================================

// MOVSD [rbp+disp8], xmm0 — store xmm0 to stack (F2 0F 11 45 <disp8>)
pub fn emit_movsd_rbp_disp8_xmm0(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0xF2)
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x11)
    b = emit_byte(b, 0x45)   // ModRM: mod=01 reg=xmm0 r/m=rbp
    b = emit_byte(b, low8(disp))
    b
}

// MOVSD xmm0, [rbp+disp8] — load xmm0 from stack (F2 0F 10 45 <disp8>)
pub fn emit_movsd_xmm0_rbp_disp8(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0xF2)
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x10)
    b = emit_byte(b, 0x45)   // ModRM: mod=01 reg=xmm0 r/m=rbp
    b = emit_byte(b, low8(disp))
    b
}

// MOVSD [rbp+disp8], xmm1 — store xmm1 to stack (F2 0F 11 4D <disp8>)
pub fn emit_movsd_rbp_disp8_xmm1(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0xF2)
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x11)
    b = emit_byte(b, 0x4D)   // ModRM: mod=01 reg=xmm1 r/m=rbp
    b = emit_byte(b, low8(disp))
    b
}

// MOVSD xmm1, [rbp+disp8] — load xmm1 from stack (F2 0F 10 4D <disp8>)
pub fn emit_movsd_xmm1_rbp_disp8(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0xF2)
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x10)
    b = emit_byte(b, 0x4D)   // ModRM: mod=01 reg=xmm1 r/m=rbp
    b = emit_byte(b, low8(disp))
    b
}

// Sprint 121: CVTSD2SI rax, xmm0 — round f64 to i64 (nearest) (F2 48 0F 2D C0)
pub fn emit_cvtsd2si_rax_xmm0(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0xF2)
    b = emit_byte(b, 0x48)   // REX.W
    b = emit_byte(b, 0x0F)
    b = emit_byte(b, 0x2D)
    b = emit_byte(b, 0xC0)   // ModRM: rax, xmm0
    b
}

// Sprint 121: emit_cvtsi2sd_xmm0_rax already defined above (Sprint 87)
