// self-hosted::native::encode — Minimal x86-64 instruction encoder (skeleton)
//
// This module builds up a raw .text byte buffer. The Rust-side NativeEmitter
// (ELF/Mach-O) will wrap these bytes into an executable later.

module native::encode

// Lane B residual (2026-08-13): `.bytes` is vestigial on the Linux native_v2 path.
// Real machine code lives in NC_BIG_CODE; `.len` is the only live field threaded
// through by-value emit_* and by-ref nc_emit_*. Keeping a multi-256 KiB array here
// forced every `var out = buf` / `nc: NativeCompiler` copy to pay ~256 KiB per
// stack frame (and nested emit_u64 → emit_u32 → emit_byte chains stacked several).
// The 64-byte stub preserves a non-empty array type for the few macho/pe readers
// that still mention `.bytes`; those paths must read NC_BIG_CODE for payload.
pub struct CodeBuffer {
    pub bytes: [i8; 64],
    pub len: i64,
}

// Off-stack machine-code buffer for the native_v2 x86 Linux path. The .text bytes
// used to live inline in CodeBuffer.bytes (embedded by value in NativeCompiler on
// the 8MB stack); growing that past ~640KB miscompiles (large stack frame). This
// module-global BSS array holds the emitted code so NativeCompiler stays small on
// the stack, while `.len` (a scalar, threaded through BOTH the by-ref nc_emit_byte
// path and the by-value emit_byte path) stays the authoritative length. Both emit
// paths write NC_BIG_CODE[.len]; the struct .bytes field is now a 64-byte stub (see
// struct comment). Because .len is threaded consistently, the by-value builtin
// emitters (which emit into a copy of nc) append to the same global at the shared
// offset, so no persist/call-site changes are needed. Accessed INLINE only —
// never via a returning helper (miscompiles under the seed).
pub var NC_BIG_CODE: [i8; 134217728] = [0; 134217728]

// Single source of truth for the NC_BIG_CODE bound. The DECLARATION above must
// stay a literal (Sounio array sizes are not expressions), but every bound CHECK
// across the backend calls this accessor, so the next capacity bump is one edit
// here plus the declaration. Companions: nc_flat_reloc_capacity() in
// native::frame, nc_elf_capacity_bytes() in native::codegen_x86_linux.
// Declaration/accessor coherence is pinned by
// scripts/ci/native_capacity_tiers_gate.sh.
pub fn nc_code_capacity_bytes() -> i64 { 134217728 }

// Materialise NC_BIG_CODE into fixed arrays expected by legacy macho/pe assemblers
// that still take by-value `[i8; N]`. Linux ELF writers read NC_BIG_CODE directly.
pub fn nc_code_copy_to_262144(code_len: i64) -> [i8; 262144] with Mut, Panic, Div {
    var out: [i8; 262144] = [0; 262144]
    var i: i64 = 0
    let n = if code_len < 262144 { code_len } else { 262144 }
    let cap = nc_code_capacity_bytes()
    let lim = if n < cap { n } else { cap }
    while i < lim {
        out[i as usize] = NC_BIG_CODE[i as usize]
        i = i + 1
    }
    out
}

pub fn nc_code_copy_to_65536(code_len: i64) -> [i8; 65536] with Mut, Panic, Div {
    var out: [i8; 65536] = [0; 65536]
    var i: i64 = 0
    let n = if code_len < 65536 { code_len } else { 65536 }
    let cap = nc_code_capacity_bytes()
    let lim = if n < cap { n } else { cap }
    while i < lim {
        out[i as usize] = NC_BIG_CODE[i as usize]
        i = i + 1
    }
    out
}

pub fn code_buffer_new() -> CodeBuffer {
    var out: CodeBuffer
    out.len = 0
    out
}

// Read materialized Linux native-v2 code without exposing the vestigial
// CodeBuffer.bytes stub to byte-level backend gates.
pub fn code_buffer_read_byte(buf: CodeBuffer, idx: i64) -> i64 with Mut, Panic, Div {
    if idx < 0 || idx >= buf.len || idx >= nc_code_capacity_bytes() { return -1 }
    let x = NC_BIG_CODE[idx as usize] as i64
    if x < 0 { x + 256 } else { x }
}

pub fn low8(x: i64) -> i64 with Mut, Panic, Div {
    var n = x % 256
    if n < 0 { n = n + 256 }
    n
}


// Wide variant for large modules (256KB capacity)
pub struct WideCodeBuffer {
    pub bytes: [i8; 262144],
    pub len: i64,
}

pub fn wide_code_buffer_new() -> WideCodeBuffer with Mut {
    var out: WideCodeBuffer
    out.len = 0
    out
}

pub fn wide_emit_byte(buf: WideCodeBuffer, b: i64) -> WideCodeBuffer with Mut, Panic {
    var out = buf
    if out.len < 262144 {
        out.bytes[out.len as usize] = b as i8
        out.len = out.len + 1
    }
    out
}

pub fn wide_copy_from_code_buffer(dst: WideCodeBuffer, src: CodeBuffer) -> WideCodeBuffer with Mut, Panic, Div {
    // Payload is in NC_BIG_CODE keyed by src.len — not the vestigial src.bytes stub.
    var out = dst
    var i: i64 = 0
    while i < src.len && out.len < 262144 && i < nc_code_capacity_bytes() {
        out.bytes[out.len as usize] = NC_BIG_CODE[i as usize]
        out.len = out.len + 1
        i = i + 1
    }
    out
}

pub fn emit_byte(buf: CodeBuffer, b: i64) -> CodeBuffer with Mut, Panic, Div {
    var out = buf
    if out.len >= 0 {
        if out.len < nc_code_capacity_bytes() {
            NC_BIG_CODE[out.len as usize] = low8(b) as i8
            out.len = out.len + 1
        }
    }
    out
}

pub fn emit_byte_mut(buf: &! CodeBuffer, b: i64) with Mut, Panic, Div {
    if (*buf).len >= 0 {
        if (*buf).len < nc_code_capacity_bytes() {
            NC_BIG_CODE[(*buf).len as usize] = low8(b) as i8
            (*buf).len = (*buf).len + 1
        }
    }
}

pub fn emit_u32_le(buf: CodeBuffer, val: i64) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, low8(val))
    b = emit_byte(b, low8(val >> 8))
    b = emit_byte(b, low8(val >> 16))
    b = emit_byte(b, low8(val >> 24))
    b
}

pub fn emit_u32_le_mut(buf: &! CodeBuffer, val: i64) with Mut, Panic, Div {
    emit_byte_mut(buf, low8(val))
    emit_byte_mut(buf, low8(val >> 8))
    emit_byte_mut(buf, low8(val >> 16))
    emit_byte_mut(buf, low8(val >> 24))
}

pub fn emit_u64_le(buf: CodeBuffer, val: i64) -> CodeBuffer with Mut, Panic, Div {
    // Write as 2x u32 to avoid depending on bitwise ops.
    var b = buf
    b = emit_u32_le(b, val)
    b = emit_u32_le(b, val >> 32)
    b
}

pub fn emit_u64_le_mut(buf: &! CodeBuffer, val: i64) with Mut, Panic, Div {
    emit_u32_le_mut(buf, val)
    emit_u32_le_mut(buf, val >> 32)
}

pub fn modrm_rr(dst: i64, src: i64) -> i64 {
    // Register-direct ModRM: 11 rrr bbb
    // where rrr = src, bbb = dst.
    192 + src * 8 + dst
}

pub fn modrm_rm_imm(dst: i64) -> i64 {
    // mov r/m64, imm32 uses /0, so ModRM is 11 000 bbb.
    192 + dst
}

// ============================================================================
// x86-64 instruction snippets (not exhaustive)
// ============================================================================

pub fn emit_mov_rax_imm(buf: CodeBuffer, val: i64) -> CodeBuffer with Mut, Panic, Div {
    var result = emit_mov_reg_imm(buf, 0, val)
    result
}

pub fn emit_mov_rdi_imm(buf: CodeBuffer, val: i64) -> CodeBuffer with Mut, Panic, Div {
    var result = emit_mov_reg_imm(buf, 7, val)
    result
}

pub fn emit_mov_reg_imm32(buf: CodeBuffer, reg: i64, val: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 c7 /0 <imm32>  — mov r/m64, imm32
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xc7)
    b = emit_byte(b, modrm_rm_imm(reg))
    b = emit_u32_le(b, val)
    b
}

pub fn emit_mov_reg_imm64(buf: CodeBuffer, reg: i64, val: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 b8+rd <imm64>  — mov r64, imm64
    // Note: only supports registers 0..7 (no REX.B extension).
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xb8 + reg)
    b = emit_u64_le(b, val)
    b
}

pub fn emit_mov_reg_imm(buf: CodeBuffer, reg: i64, val: i64) -> CodeBuffer with Mut, Panic, Div {
    if val >= -2147483648 && val <= 2147483647 {
        var r32 = emit_mov_reg_imm32(buf, reg, val)
        r32
    } else {
        var r64 = emit_mov_reg_imm64(buf, reg, val)
        r64
    }
}

pub fn emit_mov_reg_reg(buf: CodeBuffer, dst: i64, src: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 89 /r — mov r/m64, r64  (dst <- src)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, modrm_rr(dst, src))
    b
}

pub fn emit_add_reg_reg(buf: CodeBuffer, dst: i64, src: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 01 /r — add r/m64, r64  (dst += src)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x01)
    b = emit_byte(b, modrm_rr(dst, src))
    b
}

pub fn emit_sub_reg_reg(buf: CodeBuffer, dst: i64, src: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 29 /r — sub r/m64, r64  (dst -= src)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x29)
    b = emit_byte(b, modrm_rr(dst, src))
    b
}

pub fn emit_imul_reg_reg(buf: CodeBuffer, dst: i64, src: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 0f af /r — imul r64, r/m64 (dst *= src)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0xaf)
    // For imul, dst is encoded in the ModRM 'reg' field.
    b = emit_byte(b, 192 + dst * 8 + src)
    b
}

// Wide-int carry-arithmetic emitters (N-limb integers).
pub fn emit_adc_reg_reg(buf: CodeBuffer, dst: i64, src: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 11 /r — adc r/m64, r64  (dst += src + CF)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x11)
    b = emit_byte(b, modrm_rr(dst, src))
    b
}

pub fn emit_sbb_reg_reg(buf: CodeBuffer, dst: i64, src: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 19 /r — sbb r/m64, r64  (dst -= src + CF)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x19)
    b = emit_byte(b, modrm_rr(dst, src))
    b
}

pub fn emit_mul_reg(buf: CodeBuffer, src: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 f7 /4 — mul r/m64  (rdx:rax = rax * src)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xf7)
    b = emit_byte(b, 0xe0 + src)
    b
}

pub fn emit_div_reg(buf: CodeBuffer, src: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 f7 /6 — div r/m64  (rax = rdx:rax / src, rdx = rem)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xf7)
    b = emit_byte(b, 0xf0 + src)
    b
}

pub fn emit_syscall(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x05)
    b
}

pub fn emit_ret(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0xc3)
    b
}

pub fn emit_exit(buf: CodeBuffer, code: i64) -> CodeBuffer with Mut, Panic, Div {
    // sys_exit(code)
    var b = buf
    b = emit_mov_rax_imm(b, 60)
    b = emit_mov_rdi_imm(b, code)
    b = emit_syscall(b)
    b
}

// emit_write_stdout removed: the codegen pipeline uses lower_load_string
// (RIP-relative LEA + relocation) + emit_builtin_print_str instead.

// ============================================================================
// Stack frame management instructions (Phase 1)
// ============================================================================

pub fn emit_push_rbp(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x55)  // push rbp
    b
}

pub fn emit_pop_rbp(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x5d)  // pop rbp
}

pub fn emit_mov_rbp_rsp(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 89 e5 — mov rbp, rsp
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0xe5)
    b
}

pub fn emit_mov_rsp_rbp(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 89 ec — mov rsp, rbp
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0xec)
    b
}

// Touch [rsp] so the current page is faulted in (stack growth frontier).
pub fn emit_touch_rsp(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // or qword ptr [rsp], 0  — 48 83 0c 24 00
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x83)
    b = emit_byte(b, 0x0c)
    b = emit_byte(b, 0x24)
    b = emit_byte(b, 0x00)
    b
}

// Post-sub page walk: mov rax,rbp; loop sub rax,0x1000 / cmp rax,rsp / jbe / or [rax],0.
// No-op when (rbp-rsp) < 4 KiB. Matches lean_single emit_stack_probe_x86.
pub fn emit_stack_probe(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x89); b = emit_byte(b, 0xe8)
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x2d); b = emit_u32_le(b, 0x1000)
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x39); b = emit_byte(b, 0xe0)
    b = emit_byte(b, 0x76); b = emit_byte(b, 0x05)
    b = emit_byte(b, 0x80); b = emit_byte(b, 0x08); b = emit_byte(b, 0x00)
    b = emit_byte(b, 0xeb); b = emit_byte(b, 0xf0)
    b
}

pub fn emit_sub_rsp_imm32(buf: CodeBuffer, val: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 81 ec <imm32> — sub rsp, imm32, with stack growth probes for large frames.
    // See nc_emit_sub_rsp_imm32 (codegen_x86_linux.sio) for the live Madaros path.
    var b = buf
    if val <= 0 {
        return b
    }
    if val < 4096 {
        b = emit_byte(b, 0x48)
        b = emit_byte(b, 0x81)
        b = emit_byte(b, 0xec)
        b = emit_u32_le(b, val)
        b = emit_stack_probe(b)
        return b
    }
    // Page-by-page sub+touch (clobbers r11). Encoding mirrors nc_emit_sub_rsp_imm32.
    b = emit_byte(b, 0x49); b = emit_byte(b, 0xc7); b = emit_byte(b, 0xc3)
    b = emit_u32_le(b, val)
    b = emit_byte(b, 0x49); b = emit_byte(b, 0x81); b = emit_byte(b, 0xfb)
    b = emit_u32_le(b, 0x1000)
    b = emit_byte(b, 0x72); b = emit_byte(b, 0x15)
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x81); b = emit_byte(b, 0xec)
    b = emit_u32_le(b, 0x1000)
    b = emit_touch_rsp(b)
    b = emit_byte(b, 0x49); b = emit_byte(b, 0x81); b = emit_byte(b, 0xeb)
    b = emit_u32_le(b, 0x1000)
    b = emit_byte(b, 0xeb); b = emit_byte(b, 0xe2)
    b = emit_byte(b, 0x4c); b = emit_byte(b, 0x29); b = emit_byte(b, 0xdc)
    b = emit_byte(b, 0x4d); b = emit_byte(b, 0x85); b = emit_byte(b, 0xdb)
    b = emit_byte(b, 0x74); b = emit_byte(b, 0x05)
    b = emit_touch_rsp(b)
    b
}

pub fn emit_add_rsp_imm32(buf: CodeBuffer, val: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 81 c4 <imm32> — add rsp, imm32
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x81)
    b = emit_byte(b, 0xc4)
    b = emit_u32_le(b, val)
    b
}

// ============================================================================
// Phase 1: Evaluation stack, jumps, comparisons, memory (disp32)
// ============================================================================

// --- Push / Pop for expression evaluation ---

pub fn emit_push_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x50)
}

pub fn emit_pop_rbx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x5b)
}

pub fn emit_pop_rdi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x5f)
}

pub fn emit_pop_rsi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x5e)
}

pub fn emit_pop_rdx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x5a)
}

pub fn emit_pop_rcx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x59)
}

pub fn emit_pop_r8(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x41)
    b = emit_byte(b, 0x58)
    b
}

pub fn emit_pop_r9(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x41)
    b = emit_byte(b, 0x59)
    b
}

// Pop to System V ABI argument register by index (0=rdi, 1=rsi, ...)
pub fn emit_pop_arg_reg(buf: CodeBuffer, index: i64) -> CodeBuffer with Mut, Panic, Div {
    if index == 0 { emit_pop_rdi(buf) }
    else if index == 1 { emit_pop_rsi(buf) }
    else if index == 2 { emit_pop_rdx(buf) }
    else if index == 3 { emit_pop_rcx(buf) }
    else if index == 4 { emit_pop_r8(buf) }
    else if index == 5 { emit_pop_r9(buf) }
    else { buf }
}

// --- Stack alignment helpers (for call ABI) ---

pub fn emit_sub_rsp_8(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 83 ec 08 — sub rsp, 8
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x83)
    b = emit_byte(b, 0xec)
    b = emit_byte(b, 0x08)
    b
}

pub fn emit_add_rsp_8(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 83 c4 08 — add rsp, 8
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x83)
    b = emit_byte(b, 0xc4)
    b = emit_byte(b, 0x08)
    b
}

// --- Unconditional / Conditional jumps (rel32 placeholder) ---

pub fn emit_jmp_rel32(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // e9 <rel32> — jmp rel32 (placeholder 0)
    var b = buf
    b = emit_byte(b, 0xe9)
    b = emit_u32_le(b, 0)
    b
}

pub fn emit_jz_rel32(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 0f 84 <rel32> — jz rel32 (placeholder 0)
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x84)
    b = emit_u32_le(b, 0)
    b
}

pub fn emit_jnz_rel32(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 0f 85 <rel32> — jnz rel32 (placeholder 0)
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x85)
    b = emit_u32_le(b, 0)
    b
}

// --- Test, Compare, Setcc ---

pub fn emit_test_rax_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 85 c0 — test rax, rax
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x85)
    b = emit_byte(b, 0xc0)
    b
}

pub fn emit_cmp_rbx_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 39 c3 — cmp rbx, rax
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x39)
    b = emit_byte(b, 0xc3)
    b
}

pub fn emit_sete_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x94)
    b = emit_byte(b, 0xc0)
    b
}

pub fn emit_setne_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x95)
    b = emit_byte(b, 0xc0)
    b
}

pub fn emit_setl_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x9c)
    b = emit_byte(b, 0xc0)
    b
}

pub fn emit_setle_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x9e)
    b = emit_byte(b, 0xc0)
    b
}

pub fn emit_setg_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x9f)
    b = emit_byte(b, 0xc0)
    b
