}

// mov rsi, rax — move rax to rsi
pub fn emit_mov_rsi_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_mov_reg_reg(buf, 6, 0)
}

// mov rdx, rax — move rax to rdx
pub fn emit_mov_rdx_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_mov_reg_reg(buf, 2, 0)
}

// mov rax, rdi — move rdi to rax (for syscall setup)
pub fn emit_mov_rax_rdi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_mov_reg_reg(buf, 0, 7)
}

// mov rbx, rax — save rax in rbx
pub fn emit_mov_rbx_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_mov_reg_reg(buf, 3, 0)
}

// mov rdi, rbx — restore rbx to rdi
pub fn emit_mov_rdi_rbx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_mov_reg_reg(buf, 7, 3)
}

// lea rsi, [rsp] — load stack pointer into rsi (for stat buffer)
pub fn emit_lea_rsi_rsp(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 89 e6 — mov rsi, rsp (equivalent for our purposes)
    emit_mov_rsi_rsp(buf)
}

// mov rax, [rsp + disp8] — load from stack at small displacement
pub fn emit_mov_rax_rsp_disp8(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 8b 44 24 <disp8> — mov rax, [rsp + disp8]
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x8b)
    b = emit_byte(b, 0x44)
    b = emit_byte(b, 0x24)
    b = emit_byte(b, low8(disp))
    b
}

// ============================================================================
// Phase 6.2: Negative-number and float support helpers
// ============================================================================

// test rdi, rdi — set SF if rdi is negative
pub fn emit_test_rdi_rdi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 85 ff — test rdi, rdi
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x85)
    b = emit_byte(b, 0xff)
    b
}

// jns rel8 — jump if not sign (SF=0, i.e. non-negative)
pub fn emit_jns_rel8(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 79 <disp8>
    var b = buf
    b = emit_byte(b, 0x79)
    b = emit_byte(b, low8(disp))
    b
}


// JS rel8 — jump if sign flag set
pub fn emit_js_rel8(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 78 <disp8>
    var b = buf
    b = emit_byte(b, 0x78)
    b = emit_byte(b, low8(disp))
    b
}

// neg rdi — negate rdi (two's complement)
pub fn emit_neg_rdi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 f7 df — neg rdi
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xf7)
    b = emit_byte(b, 0xdf)
    b
