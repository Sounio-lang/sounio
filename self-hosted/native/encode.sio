fn emit_jnz_rel8(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 75 <rel8> — jnz rel8
    var b = buf
    b = emit_byte(b, 0x75)
    b = emit_byte(b, low8(disp))
    b
}

fn emit_jz_rel8(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 74 <rel8> — jz rel8
    var b = buf
    b = emit_byte(b, 0x74)
    b = emit_byte(b, low8(disp))
    b
