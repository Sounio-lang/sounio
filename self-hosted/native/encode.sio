// ============================================================================
// Phase 6 M4/M5: Extended register and memory encoders
// ============================================================================

// mov r14, rsp — save stack pointer for argv access
pub fn emit_mov_r14_rsp(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 49 89 e6 — mov r14, rsp
    var b = buf
    b = emit_byte(b, 0x49)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0xe6)
    b
}

// mov rax, [r14] — load from saved stack pointer
pub fn emit_mov_rax_mem_r14(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 49 8b 06 — mov rax, [r14]
    var b = buf
    b = emit_byte(b, 0x49)
    b = emit_byte(b, 0x8b)
    b = emit_byte(b, 0x06)
    b
}

// lea rax, [r14 + disp8] — load effective address relative to r14
pub fn emit_lea_rax_r14_disp8(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 49 8d 46 <disp8> — lea rax, [r14 + disp8]
    var b = buf
    b = emit_byte(b, 0x49)
    b = emit_byte(b, 0x8d)
    b = emit_byte(b, 0x46)
    b = emit_byte(b, low8(disp))
    b
}

// mov [r12], rax — store to heap base
pub fn emit_mov_mem_r12_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 49 89 04 24 — mov [r12], rax
    var b = buf
    b = emit_byte(b, 0x49)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0x04)
    b = emit_byte(b, 0x24)
    b
}

// mov [r12 + disp8], rax — store to heap base + offset
pub fn emit_mov_mem_r12_disp8_rax(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 49 89 44 24 <disp8> — mov [r12 + disp8], rax
    var b = buf
    b = emit_byte(b, 0x49)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0x44)
    b = emit_byte(b, 0x24)
    b = emit_byte(b, low8(disp))
    b
}

// mov rax, [r12] — load from heap base
pub fn emit_mov_rax_mem_r12(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 49 8b 04 24 — mov rax, [r12]
    var b = buf
    b = emit_byte(b, 0x49)
    b = emit_byte(b, 0x8b)
    b = emit_byte(b, 0x04)
    b = emit_byte(b, 0x24)
    b
}

// mov rax, [r12 + disp8] — load from heap base + offset
pub fn emit_mov_rax_mem_r12_disp8(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 49 8b 44 24 <disp8> — mov rax, [r12 + disp8]
