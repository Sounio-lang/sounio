fn emit_test_al_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 84 c0 — test al, al
    var b = buf
    b = emit_byte(b, 0x84)
    b = emit_byte(b, 0xc0)
