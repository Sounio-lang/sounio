fn emit_jmp_rel8(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // eb <rel8> — jmp rel8
    var b = buf
    b = emit_byte(b, 0xeb)
    b = emit_byte(b, low8(disp))
    b
}

// ============================================================================
// Phase 2: Heap allocation and struct/array access encoders
// ============================================================================

fn emit_pop_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x58)
    b
