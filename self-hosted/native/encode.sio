// mov rax, [rax + rbx*8] — indexed load (for argv[n])
pub fn emit_mov_rax_mem_rax_rbx8(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 8b 04 d8 — mov rax, [rax + rbx*8]
    var b = buf
