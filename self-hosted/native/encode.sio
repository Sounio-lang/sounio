    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xff)
    b = emit_byte(b, 0xc7)
    b
}

fn emit_push_rdi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x57)
}

fn emit_mov_rsi_rsp(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 89 e6 — mov rsi, rsp
    var b = buf
    b = emit_byte(b, 0x48)
