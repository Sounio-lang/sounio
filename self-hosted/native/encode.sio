pub fn emit_setge_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x9d)
    b = emit_byte(b, 0xc0)
    b
