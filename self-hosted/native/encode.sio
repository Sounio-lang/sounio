// self-hosted::native::encode — Minimal x86-64 instruction encoder (skeleton)
//
// This module builds up a raw .text byte buffer. The Rust-side NativeEmitter
// (ELF/Mach-O) will wrap these bytes into an executable later.

struct CodeBuffer {
    bytes: [i8; 2097152],
    len: i64,
}

fn code_buffer_new() -> CodeBuffer {
    CodeBuffer { bytes: [0; 2097152], len: 0 }
}

fn low8(x: i64) -> i64 with Mut, Panic, Div {
    var n = x % 256
    if n < 0 { n = n + 256 }
    n
}

fn emit_byte(buf: CodeBuffer, b: i64) -> CodeBuffer with Mut, Panic, Div {
    var out = buf
    if out.len >= 0 {
        if out.len < 2097152 {
            out.bytes[out.len as usize] = low8(b) as i8
            out.len = out.len + 1
        }
    }
    out
}

fn emit_u32_le(buf: CodeBuffer, val: i64) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, low8(val))
    b = emit_byte(b, low8(val >> 8))
    b = emit_byte(b, low8(val >> 16))
    b = emit_byte(b, low8(val >> 24))
    b
}

fn emit_u64_le(buf: CodeBuffer, val: i64) -> CodeBuffer with Mut, Panic, Div {
    // Write as 2x u32 to avoid depending on bitwise ops.
    var b = buf
    b = emit_u32_le(b, val)
    b = emit_u32_le(b, val >> 32)
    b
}

fn modrm_rr(dst: i64, src: i64) -> i64 {
    // Register-direct ModRM: 11 rrr bbb
    // where rrr = src, bbb = dst.
    192 + src * 8 + dst
}

fn modrm_rm_imm(dst: i64) -> i64 {
    // mov r/m64, imm32 uses /0, so ModRM is 11 000 bbb.
    192 + dst
}

// ============================================================================
// x86-64 instruction snippets (not exhaustive)
// ============================================================================

fn emit_mov_rax_imm(buf: CodeBuffer, val: i64) -> CodeBuffer with Mut, Panic, Div {
    emit_mov_reg_imm(buf, 0, val)
}

fn emit_mov_rdi_imm(buf: CodeBuffer, val: i64) -> CodeBuffer with Mut, Panic, Div {
    emit_mov_reg_imm(buf, 7, val)
}

fn emit_mov_reg_imm32(buf: CodeBuffer, reg: i64, val: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 c7 /0 <imm32>  — mov r/m64, imm32
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xc7)
    b = emit_byte(b, modrm_rm_imm(reg))
    b = emit_u32_le(b, val)
    b
}

fn emit_mov_reg_imm64(buf: CodeBuffer, reg: i64, val: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 b8+rd <imm64>  — mov r64, imm64
    // Note: only supports registers 0..7 (no REX.B extension).
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xb8 + reg)
    b = emit_u64_le(b, val)
    b
}

fn emit_mov_reg_imm(buf: CodeBuffer, reg: i64, val: i64) -> CodeBuffer with Mut, Panic, Div {
    // Prefer the shorter imm32 encoding when possible (it sign-extends to 64-bit),
    // otherwise fall back to imm64 to avoid truncation.
    if val >= -2147483648 && val <= 2147483647 {
        emit_mov_reg_imm32(buf, reg, val)
    } else {
        emit_mov_reg_imm64(buf, reg, val)
    }
}

fn emit_mov_reg_reg(buf: CodeBuffer, dst: i64, src: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 89 /r — mov r/m64, r64  (dst <- src)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, modrm_rr(dst, src))
    b
}

fn emit_add_reg_reg(buf: CodeBuffer, dst: i64, src: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 01 /r — add r/m64, r64  (dst += src)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x01)
    b = emit_byte(b, modrm_rr(dst, src))
    b
}

fn emit_sub_reg_reg(buf: CodeBuffer, dst: i64, src: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 29 /r — sub r/m64, r64  (dst -= src)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x29)
    b = emit_byte(b, modrm_rr(dst, src))
    b
}

fn emit_imul_reg_reg(buf: CodeBuffer, dst: i64, src: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 0f af /r — imul r64, r/m64 (dst *= src)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0xaf)
    // For imul, dst is encoded in the ModRM 'reg' field.
    b = emit_byte(b, 192 + dst * 8 + src)
    b
}

fn emit_syscall(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x05)
    b
}

fn emit_ret(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0xc3)
}

fn emit_exit(buf: CodeBuffer, code: i64) -> CodeBuffer with Mut, Panic, Div {
    // sys_exit(code)
    var b = buf
    b = emit_mov_rax_imm(b, 60)
    b = emit_mov_rdi_imm(b, code)
    b = emit_syscall(b)
    b
}

fn emit_write_stdout(buf: CodeBuffer, data_offset: i64, data_len: i64) -> CodeBuffer with Mut, Panic, Div {
    // sys_write(1, data, len) — placeholder encoding.
    // TODO: RIP-relative addressing + relocations.
    var b = buf
    b = emit_mov_rax_imm(b, 1)   // sys_write
    b = emit_mov_rdi_imm(b, 1)   // fd = stdout

    // mov rsi, imm64 (48 be <imm64>)
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xbe)
    b = emit_u64_le(b, data_offset)

    // mov rdx, imm32 (48 c7 c2 <imm32>)
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xc7)
    b = emit_byte(b, 0xc2)
    b = emit_u32_le(b, data_len)

    b = emit_syscall(b)
    b
}

// ============================================================================
// Stack frame management instructions (Phase 1)
// ============================================================================

fn emit_push_rbp(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x55)  // push rbp
}

fn emit_pop_rbp(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x5d)  // pop rbp
}

fn emit_mov_rbp_rsp(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 89 e5 — mov rbp, rsp
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0xe5)
    b
}

fn emit_mov_rsp_rbp(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 89 ec — mov rsp, rbp
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0xec)
    b
}

fn emit_sub_rsp_imm32(buf: CodeBuffer, val: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 81 ec <imm32> — sub rsp, imm32
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x81)
    b = emit_byte(b, 0xec)
    b = emit_u32_le(b, val)
    b
}

fn emit_add_rsp_imm32(buf: CodeBuffer, val: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 81 c4 <imm32> — add rsp, imm32
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x81)
    b = emit_byte(b, 0xc4)
    b = emit_u32_le(b, val)
    b
}

// ============================================================================
// Phase 1: Evaluation stack, jumps, comparisons, memory (disp32)
// ============================================================================

// --- Push / Pop for expression evaluation ---

fn emit_push_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x50)
}

fn emit_pop_rbx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x5b)
}

fn emit_pop_rdi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x5f)
}

fn emit_pop_rsi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x5e)
}

fn emit_pop_rdx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x5a)
}

fn emit_pop_rcx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x59)
}

fn emit_pop_r8(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x41)
    b = emit_byte(b, 0x58)
    b
}

fn emit_pop_r9(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x41)
    b = emit_byte(b, 0x59)
    b
}

// Pop to System V ABI argument register by index (0=rdi, 1=rsi, ...)
fn emit_pop_arg_reg(buf: CodeBuffer, index: i64) -> CodeBuffer with Mut, Panic, Div {
    if index == 0 { emit_pop_rdi(buf) }
    else if index == 1 { emit_pop_rsi(buf) }
    else if index == 2 { emit_pop_rdx(buf) }
    else if index == 3 { emit_pop_rcx(buf) }
    else if index == 4 { emit_pop_r8(buf) }
    else if index == 5 { emit_pop_r9(buf) }
    else { buf }
}

// --- Stack alignment helpers (for call ABI) ---

fn emit_sub_rsp_8(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 83 ec 08 — sub rsp, 8
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x83)
    b = emit_byte(b, 0xec)
    b = emit_byte(b, 0x08)
    b
}

fn emit_add_rsp_8(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 83 c4 08 — add rsp, 8
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x83)
    b = emit_byte(b, 0xc4)
    b = emit_byte(b, 0x08)
    b
}

// --- Unconditional / Conditional jumps (rel32 placeholder) ---

fn emit_jmp_rel32(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // e9 <rel32> — jmp rel32 (placeholder 0)
    var b = buf
    b = emit_byte(b, 0xe9)
    b = emit_u32_le(b, 0)
    b
}

fn emit_jz_rel32(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 0f 84 <rel32> — jz rel32 (placeholder 0)
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x84)
    b = emit_u32_le(b, 0)
    b
}

fn emit_jnz_rel32(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 0f 85 <rel32> — jnz rel32 (placeholder 0)
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x85)
    b = emit_u32_le(b, 0)
    b
}

// --- Test, Compare, Setcc ---

fn emit_test_rax_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 85 c0 — test rax, rax
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x85)
    b = emit_byte(b, 0xc0)
    b
}

fn emit_cmp_rbx_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 39 c3 — cmp rbx, rax
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x39)
    b = emit_byte(b, 0xc3)
    b
}

fn emit_sete_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x94)
    b = emit_byte(b, 0xc0)
    b
}

fn emit_setne_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x95)
    b = emit_byte(b, 0xc0)
    b
}

fn emit_setl_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x9c)
    b = emit_byte(b, 0xc0)
    b
}

fn emit_setle_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x9e)
    b = emit_byte(b, 0xc0)
    b
}

fn emit_setg_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x9f)
    b = emit_byte(b, 0xc0)
    b
}

fn emit_setge_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x9d)
    b = emit_byte(b, 0xc0)
    b
}

fn emit_movzx_rax_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 0f b6 c0 — movzx rax, al
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0xb6)
    b = emit_byte(b, 0xc0)
    b
}

// --- Arithmetic helpers ---

fn emit_xor_rax_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 31 c0 — xor rax, rax
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x31)
    b = emit_byte(b, 0xc0)
    b
}

fn emit_neg_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 f7 d8 — neg rax
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xf7)
    b = emit_byte(b, 0xd8)
    b
}

fn emit_not_bool_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // test rax, rax; sete al; movzx rax, al
    var b = buf
    b = emit_test_rax_rax(b)
    b = emit_sete_al(b)
    b = emit_movzx_rax_al(b)
    b
}

// --- Division support ---

fn emit_cqo(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 99 — cqo (sign-extend rax into rdx:rax)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x99)
    b
}

fn emit_idiv_rcx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 f7 f9 — idiv rcx
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xf7)
    b = emit_byte(b, 0xf9)
    b
}

// --- disp32 memory operations (stack locals) ---

fn emit_store_rax_rbp_disp32(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 89 85 <disp32> — mov [rbp + disp32], rax
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0x85)
    b = emit_u32_le(b, disp)
    b
}

fn emit_load_rbp_disp32_rax(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 8b 85 <disp32> — mov rax, [rbp + disp32]
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x8b)
    b = emit_byte(b, 0x85)
    b = emit_u32_le(b, disp)
    b
}

fn emit_store_reg_rbp_disp32(buf: CodeBuffer, disp: i64, reg: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 89 <85+reg*8> <disp32> — mov [rbp + disp32], reg
    // Only works for registers 0..7 (no REX.B)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0x85 + reg * 8)
    b = emit_u32_le(b, disp)
    b
}

// --- Call and trap ---

fn emit_call_rel32_placeholder(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // e8 <rel32> — call rel32 (placeholder 0)
    var b = buf
    b = emit_byte(b, 0xe8)
    b = emit_u32_le(b, 0)
    b
}

fn emit_ud2(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 0f 0b — ud2 (undefined instruction trap)
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x0b)
    b
}

// --- Convenience register moves ---

fn emit_mov_rdi_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // mov rdi, rax
    emit_mov_reg_reg(buf, 7, 0)
}

fn emit_mov_rcx_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // mov rcx, rax
    emit_mov_reg_reg(buf, 1, 0)
}

fn emit_mov_rax_rbx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // mov rax, rbx
    emit_mov_reg_reg(buf, 0, 3)
}

fn emit_mov_rax_rdx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // mov rax, rdx
    emit_mov_reg_reg(buf, 0, 2)
}

// LEA rax, [rip + disp32] — load effective address (for string literals)
fn emit_lea_rax_rip_disp32(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 8d 05 <disp32> — lea rax, [rip + disp32]
    var b = buf
    b = emit_byte(b, 0x48)        // REX.W
    b = emit_byte(b, 0x8d)        // lea r64, m
    b = emit_byte(b, 0x05)        // ModRM: [rip + disp32], rax
    b = emit_u32_le(b, disp)
    b
}

// ============================================================================
// Phase 6 M3: Builtin runtime function instruction encoders
// ============================================================================

fn emit_xor_rdx_rdx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 31 d2 — xor rdx, rdx
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x31)
    b = emit_byte(b, 0xd2)
    b
}

fn emit_xor_rcx_rcx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 31 c9 — xor rcx, rcx
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x31)
    b = emit_byte(b, 0xc9)
    b
}

fn emit_div_rbx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 f7 f3 — div rbx (unsigned: rdx:rax / rbx -> rax=quot, rdx=rem)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xf7)
    b = emit_byte(b, 0xf3)
    b
}

fn emit_add_rdx_imm8(buf: CodeBuffer, imm: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 83 c2 <imm8> — add rdx, imm8
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x83)
    b = emit_byte(b, 0xc2)
    b = emit_byte(b, low8(imm))
    b
}

fn emit_sub_rsi_imm8(buf: CodeBuffer, imm: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 83 ee <imm8> — sub rsi, imm8
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x83)
    b = emit_byte(b, 0xee)
    b = emit_byte(b, low8(imm))
    b
}

fn emit_mov_byte_mem_rsi_dl(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 88 16 — mov [rsi], dl
    var b = buf
    b = emit_byte(b, 0x88)
    b = emit_byte(b, 0x16)
    b
}

fn emit_dec_rsi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 ff ce — dec rsi
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xff)
    b = emit_byte(b, 0xce)
    b
}

fn emit_inc_rsi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 ff c6 — inc rsi
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xff)
    b = emit_byte(b, 0xc6)
    b
}

fn emit_inc_rcx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 ff c1 — inc rcx
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xff)
    b = emit_byte(b, 0xc1)
    b
}

fn emit_inc_rdi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
