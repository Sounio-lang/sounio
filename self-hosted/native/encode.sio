// mov byte [rsi], imm8 — store immediate byte at [rsi]
pub fn emit_mov_byte_mem_rsi_imm8(buf: CodeBuffer, imm: i64) -> CodeBuffer with Mut, Panic, Div {
    // c6 06 <imm8>
