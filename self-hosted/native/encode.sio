}

// sub rsp, imm8 — subtract small value from rsp
pub fn emit_sub_rsp_imm8(buf: CodeBuffer, imm: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 83 ec <imm8> — sub rsp, imm8
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x83)
    b = emit_byte(b, 0xec)
    b = emit_byte(b, low8(imm))
    b
}

// add rsp, imm8 — add small value to rsp
pub fn emit_add_rsp_imm8(buf: CodeBuffer, imm: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 83 c4 <imm8> — add rsp, imm8
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x83)
    b = emit_byte(b, 0xc4)
    b = emit_byte(b, low8(imm))
