    b = emit_byte(b, 0x49)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0x04)
    b = emit_byte(b, 0x24)
    b
}

// mov [r12 + disp8], rax — store to heap base + offset
fn emit_mov_mem_r12_disp8_rax(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 49 89 44 24 <disp8> — mov [r12 + disp8], rax
    var b = buf
    b = emit_byte(b, 0x49)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0x44)
    b = emit_byte(b, 0x24)
    b = emit_byte(b, low8(disp))
    b
}

// mov rax, [r12] — load from heap base
fn emit_mov_rax_mem_r12(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 49 8b 04 24 — mov rax, [r12]
    var b = buf
    b = emit_byte(b, 0x49)
    b = emit_byte(b, 0x8b)
    b = emit_byte(b, 0x04)
    b = emit_byte(b, 0x24)
