pub fn emit_movzx_rax_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 0f b6 c0 — movzx rax, al
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0xb6)
    b = emit_byte(b, 0xc0)
