    let word = a64_read_word(buf, 0)
    if !(word == 0xCB020020) { return false }
    true
}

// T03: ADD X0, X1, #42 => 0x9100A820
// imm12=42=0x2A, Rn=1, Rd=0
pub fn a64_test_add_imm() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = a64_emit_add_imm(buf, A64_X0, A64_X1, 42)
    if !(buf.len == 4) { return false }
    let word = a64_read_word(buf, 0)
    if !(word == 0x9100A820) { return false }
    true
}

