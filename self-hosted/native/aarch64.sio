// T10: B.EQ +8 => 0x54000040
// imm19 = 8/4 = 2, cond = 0x0
pub fn a64_test_b_eq() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = a64_emit_b_eq(buf, 8)
    if !(buf.len == 4) { return false }
    let word = a64_read_word(buf, 0)
    if !(word == 0x54000040) { return false }
    true
}

