// T15: SVC #0 => 0xD4000001
pub fn a64_test_svc() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = a64_emit_svc(buf, 0)
    if !(buf.len == 4) { return false }
    let word = a64_read_word(buf, 0)
    if !(word == 0xD4000001) { return false }
    true
}

// T16: CBZ X0, +12 => 0xB4000060
// imm19 = 12/4 = 3, Rt = 0
pub fn a64_test_cbz() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = a64_emit_cbz(buf, A64_X0, 12)
    if !(buf.len == 4) { return false }
    let word = a64_read_word(buf, 0)
    if !(word == 0xB4000060) { return false }
    true
}

// T17: Prologue/epilogue produces correct instruction count
pub fn a64_test_prologue_epilogue() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = a64_emit_prologue(buf, 16)
    buf = a64_emit_epilogue(buf, 16)
    // Prologue: stp (1) + mov (1) = 2 instructions = 8 bytes
    // Epilogue: ldp (1) + ret (1) = 2 instructions = 8 bytes
    if !(buf.len == 16) { return false }
    true
}

// T18: AND X0, X1, X2 => 0x8A020020
pub fn a64_test_and_reg() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = a64_emit_and(buf, A64_X0, A64_X1, A64_X2)
    if !(buf.len == 4) { return false }
    let word = a64_read_word(buf, 0)
    if !(word == 0x8A020020) { return false }
    true
}

// ============================================================================
// Test runner
// ============================================================================

pub fn a64_test_main() -> i32 with IO, Mut, Panic, Div {
    var passed: i64 = 0
    let total: i64 = 18

    print("=== AArch64 Encoder Tests ===\n")

    if a64_test_add_reg()   { passed = passed + 1; print("  T01 OK (ADD reg)\n")  } else { print("  FAIL: T01 ADD reg\n") }
    if a64_test_sub_reg()   { passed = passed + 1; print("  T02 OK (SUB reg)\n")  } else { print("  FAIL: T02 SUB reg\n") }
    if a64_test_add_imm()   { passed = passed + 1; print("  T03 OK (ADD imm)\n")  } else { print("  FAIL: T03 ADD imm\n") }
    if a64_test_nop()       { passed = passed + 1; print("  T04 OK (NOP)\n")      } else { print("  FAIL: T04 NOP\n") }
    if a64_test_ret()       { passed = passed + 1; print("  T05 OK (RET)\n")      } else { print("  FAIL: T05 RET\n") }
    if a64_test_mov_reg()   { passed = passed + 1; print("  T06 OK (MOV reg)\n")  } else { print("  FAIL: T06 MOV reg\n") }
    if a64_test_blr()       { passed = passed + 1; print("  T07 OK (BLR)\n")      } else { print("  FAIL: T07 BLR\n") }
    if a64_test_cmp_reg()   { passed = passed + 1; print("  T08 OK (CMP reg)\n")  } else { print("  FAIL: T08 CMP reg\n") }
    if a64_test_mul()       { passed = passed + 1; print("  T09 OK (MUL)\n")      } else { print("  FAIL: T09 MUL\n") }
    if a64_test_b_eq()      { passed = passed + 1; print("  T10 OK (B.EQ)\n")     } else { print("  FAIL: T10 B.EQ\n") }
    if a64_test_movz()      { passed = passed + 1; print("  T11 OK (MOVZ)\n")     } else { print("  FAIL: T11 MOVZ\n") }
    if a64_test_str()       { passed = passed + 1; print("  T12 OK (STR)\n")      } else { print("  FAIL: T12 STR\n") }
    if a64_test_ldr()       { passed = passed + 1; print("  T13 OK (LDR)\n")      } else { print("  FAIL: T13 LDR\n") }
    if a64_test_sdiv()      { passed = passed + 1; print("  T14 OK (SDIV)\n")     } else { print("  FAIL: T14 SDIV\n") }
    if a64_test_svc()       { passed = passed + 1; print("  T15 OK (SVC)\n")      } else { print("  FAIL: T15 SVC\n") }
    if a64_test_cbz()       { passed = passed + 1; print("  T16 OK (CBZ)\n")      } else { print("  FAIL: T16 CBZ\n") }
    if a64_test_prologue_epilogue() { passed = passed + 1; print("  T17 OK (prologue/epilogue)\n") } else { print("  FAIL: T17 prologue/epilogue\n") }
    if a64_test_and_reg()   { passed = passed + 1; print("  T18 OK (AND reg)\n")  } else { print("  FAIL: T18 AND reg\n") }

    print("\nAArch64 tests: ")
    print_int(passed)
    print("/")
    print_int(total)
    print(" passed\n")

    if passed == total { 0 } else { 1 }
}
