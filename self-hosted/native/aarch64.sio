    var buf = code_buffer_new()
    buf = a64_emit_movz(buf, A64_X0, 0x1234, 0)
    if !(buf.len == 4) { return false }
    let word = a64_read_word(buf, 0)
    if !(word == 0xD2824680) { return false }
    true
}

// T12: STR X0, [X1, #8] => 0xF9000420
// imm12 = 8/8 = 1
pub fn a64_test_str() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = a64_emit_str(buf, A64_X0, A64_X1, 8)
    if !(buf.len == 4) { return false }
    let word = a64_read_word(buf, 0)
    if !(word == 0xF9000420) { return false }
    true
}

// T13: LDR X0, [X1, #16] => 0xF9400820
// imm12 = 16/8 = 2
pub fn a64_test_ldr() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = a64_emit_ldr(buf, A64_X0, A64_X1, 16)
