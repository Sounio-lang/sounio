    if r1 != 0 { return r1 }

    let prologues = dbg_count_prologue_ends(b)
    let r2 = dbg_assert_true(prologues == 1, 2)
    if r2 != 0 { return r2 }
    0
}

// T23: scope_kind and scope_fn_id return correct values
fn test_dbg_scope_kind_fn_id() -> i64 with Mut, Div, Panic {
    var b = dbg_info_new()
    b = dbg_add_scope(b, DBG_NO_PARENT, DBG_SCOPE_FILE, 1, 100, DBG_NO_FN)
    b = dbg_add_scope(b, 0, DBG_SCOPE_FN, 5, 50, 42)
    b = dbg_add_scope(b, 1, DBG_SCOPE_LOOP, 10, 20, 42)

    let k0 = dbg_scope_kind(b, 0)
    let r1 = dbg_assert_true(k0 == DBG_SCOPE_FILE, 1)
    if r1 != 0 { return r1 }

    let k1 = dbg_scope_kind(b, 1)
    let r2 = dbg_assert_true(k1 == DBG_SCOPE_FN, 2)
    if r2 != 0 { return r2 }

    let k2 = dbg_scope_kind(b, 2)
    let r3 = dbg_assert_true(k2 == DBG_SCOPE_LOOP, 3)
    if r3 != 0 { return r3 }

    let f0 = dbg_scope_fn_id(b, 0)
    let r4 = dbg_assert_true(f0 == DBG_NO_FN, 4)
    if r4 != 0 { return r4 }

    let f1 = dbg_scope_fn_id(b, 1)
    let r5 = dbg_assert_true(f1 == 42, 5)
    if r5 != 0 { return r5 }
    0
}

// T24: direct var count in scope (no ancestor walk)
fn test_dbg_count_vars_direct() -> i64 with Mut, Div, Panic {
    var b = dbg_info_new()
    b = dbg_add_scope(b, DBG_NO_PARENT, DBG_SCOPE_FILE, 1, 100, DBG_NO_FN)
    b = dbg_add_scope(b, 0, DBG_SCOPE_FN, 5, 50, 0)
    let loc = dbg_loc_new(6, 1, 0, 1)

    // 3 vars in fn scope
    let va = dbg_make_var_name1(97)   // 'a'
    let vb = dbg_make_var_name1(98)   // 'b'
    let vc = dbg_make_var_name1(99)   // 'c'
    b = dbg_add_var(b, va, 1, 1, 1, loc, true, 0)
    b = dbg_add_var(b, vb, 1, 1, 1, loc, true, 1)
    b = dbg_add_var(b, vc, 1, 1, 1, loc, false, 2)

    // 1 var in file scope
    let vd = dbg_make_var_name1(100)  // 'd'
    let loc2 = dbg_loc_new(2, 1, 0, 0)
    b = dbg_add_var(b, vd, 1, 1, 0, loc2, false, 3)

    let c_fn = dbg_count_vars_in_scope_direct(b, 1)
    let r1 = dbg_assert_true(c_fn == 3, 1)
    if r1 != 0 { return r1 }

    let c_file = dbg_count_vars_in_scope_direct(b, 0)
    let r2 = dbg_assert_true(c_file == 1, 2)
    if r2 != 0 { return r2 }
    0
}

// T25: line delta encoding with negative line deltas
fn test_dbg_line_deltas_negative() -> i64 with Mut, Div, Panic {
    var b = dbg_info_new()
    b = dbg_add_line(b, 0x1000, 20, 1, 0, true)
    b = dbg_add_line(b, 0x1010, 15, 1, 0, true)   // Line goes backward
    b = dbg_add_line(b, 0x1020, 25, 1, 0, true)
    var deltas: [DebugLineDelta; 4096] = [dbg_empty_line_delta(); 4096]
    deltas = dbg_compute_line_deltas(b, deltas)

    // Second entry has negative line delta: 15 - 20 = -5
    let r1 = dbg_assert_true(deltas[1 as usize].delta_line == 0 - 5, 1)
    if r1 != 0 { return r1 }
    // Third entry: 25 - 15 = 10
    let r2 = dbg_assert_true(deltas[2 as usize].delta_line == 10, 2)
    if r2 != 0 { return r2 }
    0
}

// T26: scope_children_ids collects correct ids
fn test_dbg_scope_children_ids() -> i64 with Mut, Div, Panic {
    var b = dbg_info_new()
    b = dbg_add_scope(b, DBG_NO_PARENT, DBG_SCOPE_FILE, 1, 100, DBG_NO_FN)
    b = dbg_add_scope(b, 0, DBG_SCOPE_FN, 5, 40, 0)
    b = dbg_add_scope(b, 0, DBG_SCOPE_FN, 45, 80, 1)
    b = dbg_add_scope(b, 0, DBG_SCOPE_FN, 85, 95, 2)

    var ids: [i64; 512] = [0 - 1; 512]
    ids = dbg_scope_children_ids(b, 0, ids)

    let r1 = dbg_assert_true(ids[0 as usize] == 1, 1)
    if r1 != 0 { return r1 }
    let r2 = dbg_assert_true(ids[1 as usize] == 2, 2)
    if r2 != 0 { return r2 }
    let r3 = dbg_assert_true(ids[2 as usize] == 3, 3)
    if r3 != 0 { return r3 }

    let child_count = dbg_scope_children(b, 0)
    let r4 = dbg_assert_true(child_count == 3, 4)
    if r4 != 0 { return r4 }
    0
}

// T27: integrated test — build a small function's debug info
fn test_dbg_integrated_function() -> i64 with Mut, Div, Panic {
    var b = dbg_info_new()

    // Add source file
    let fname = dbg_make_name4(109, 97, 105, 110)  // "main"
    b = dbg_add_file(b, fname, 4)

    // Add file scope (scope 0)
    b = dbg_add_scope(b, DBG_NO_PARENT, DBG_SCOPE_FILE, 1, 50, DBG_NO_FN)
    b = dbg_enter_scope(b)

    // Add function scope (scope 1)
    b = dbg_add_scope(b, 0, DBG_SCOPE_FN, 3, 20, 0)
    b = dbg_enter_scope(b)

    // Add parameter
    let px = dbg_make_var_name1(120)  // 'x'
    let ploc = dbg_loc_new(3, 10, 0, 1)
    b = dbg_add_var(b, px, 1, 1, 1, ploc, true, 0)

    // Add prologue line entries
    b = dbg_add_line(b, 0x1000, 3, 1, 0, true)
    b = dbg_add_line(b, 0x1008, 3, 10, 0, false)
    b = dbg_mark_prologue_end(b)

    // Add block scope (scope 2) for the body
    b = dbg_add_scope(b, 1, DBG_SCOPE_BLOCK, 4, 19, 0)
    b = dbg_enter_scope(b)

    // Add local variable
    let vy = dbg_make_var_name1(121)  // 'y'
    let vloc = dbg_loc_new(5, 5, 0, 2)
    b = dbg_add_var(b, vy, 1, 1, 2, vloc, false, 1)

    // Add body line entries
    b = dbg_add_line(b, 0x1010, 5, 5, 0, true)
    b = dbg_add_line(b, 0x1020, 10, 1, 0, true)
    b = dbg_add_line(b, 0x1030, 19, 1, 0, true)

    // Leave block, leave function
    b = dbg_leave_scope(b)
    b = dbg_leave_scope(b)

    // Sort line table
    b = dbg_line_table_sort(b)

    // Verify
    let r1 = dbg_assert_true(b.file_count == 1, 1)
    if r1 != 0 { return r1 }
    let r2 = dbg_assert_true(b.scope_count == 3, 2)
    if r2 != 0 { return r2 }
    let r3 = dbg_assert_true(b.var_count == 2, 3)
    if r3 != 0 { return r3 }
    let r4 = dbg_assert_true(b.line_count == 5, 4)
    if r4 != 0 { return r4 }

    // current_scope should be back at file scope (0)
    let r5 = dbg_assert_true(b.current_scope == 0, 5)
    if r5 != 0 { return r5 }

    // Line table should be sorted
    let r6 = dbg_assert_true(b.line_table[0 as usize].address == 0x1000, 6)
    if r6 != 0 { return r6 }
    let r7 = dbg_assert_true(b.line_table[4 as usize].address == 0x1030, 7)
    if r7 != 0 { return r7 }

    // Prologue end should be on the right entry
    let r8 = dbg_assert_true(b.line_table[1 as usize].is_prologue_end == true, 8)
    if r8 != 0 { return r8 }

    // Scope depth check
    let d = dbg_scope_depth(b, 2)
    let r9 = dbg_assert_true(d == 2, 9)
    if r9 != 0 { return r9 }

    // Enclosing fn of block scope 2 should be scope 1
    let fn_s = dbg_enclosing_fn_scope(b, 2)
    let r10 = dbg_assert_true(fn_s == 1, 10)
    if r10 != 0 { return r10 }
    0
}

// T28: empty line table produces empty deltas
fn test_dbg_empty_line_deltas() -> i64 with Mut, Div, Panic {
    let b = dbg_info_new()
    var deltas: [DebugLineDelta; 4096] = [dbg_empty_line_delta(); 4096]
    deltas = dbg_compute_line_deltas(b, deltas)
    // With zero entries, deltas should remain zeroed
    let r1 = dbg_assert_true(deltas[0 as usize].delta_address == 0, 1)
    if r1 != 0 { return r1 }
    let r2 = dbg_assert_true(deltas[0 as usize].delta_line == 0, 2)
    if r2 != 0 { return r2 }
    0
}

// T29: sort preserves entry data integrity
fn test_dbg_sort_preserves_data() -> i64 with Mut, Div, Panic {
    var b = dbg_info_new()
    b = dbg_add_line(b, 0x3000, 30, 3, 2, false)
    b = dbg_add_line(b, 0x1000, 10, 1, 0, true)
    b = dbg_add_line(b, 0x2000, 20, 2, 1, true)
    b = dbg_line_table_sort(b)

    // After sort: addresses should be in order
    let r1 = dbg_assert_true(b.line_table[0 as usize].address == 0x1000, 1)
    if r1 != 0 { return r1 }
    // Check that file_id moved correctly
    let r2 = dbg_assert_true(b.line_table[0 as usize].file_id == 0, 2)
    if r2 != 0 { return r2 }
    let r3 = dbg_assert_true(b.line_table[1 as usize].file_id == 1, 3)
    if r3 != 0 { return r3 }
    let r4 = dbg_assert_true(b.line_table[2 as usize].file_id == 2, 4)
    if r4 != 0 { return r4 }
    // Check that column moved correctly
    let r5 = dbg_assert_true(b.line_table[0 as usize].column == 1, 5)
    if r5 != 0 { return r5 }
    let r6 = dbg_assert_true(b.line_table[2 as usize].column == 3, 6)
    if r6 != 0 { return r6 }
    0
}

// T30: scope out-of-range returns safe defaults
fn test_dbg_scope_out_of_range() -> i64 with Mut, Div, Panic {
    let b = dbg_info_new()
    // Query on empty builder
    let k = dbg_scope_kind(b, 99)
    let r1 = dbg_assert_true(k == 0, 1)
    if r1 != 0 { return r1 }

    let f = dbg_scope_fn_id(b, 99)
    let r2 = dbg_assert_true(f == DBG_NO_FN, 2)
    if r2 != 0 { return r2 }

    let d = dbg_scope_depth(b, 99)
    let r3 = dbg_assert_true(d == 0, 3)
    if r3 != 0 { return r3 }

    let c = dbg_scope_children(b, 99)
    let r4 = dbg_assert_true(c == 0, 4)
    if r4 != 0 { return r4 }

    let s = dbg_find_scope_for_line(b, 50)
    let r5 = dbg_assert_true(s == DBG_NO_SCOPE, 5)
    if r5 != 0 { return r5 }
    0
}

