    b = dbg_add_var(b, lname, 1, 1, 0, loc, false, 1)

    let r1 = dbg_assert_true(b.vars[0 as usize].is_param == true, 1)
    if r1 != 0 { return r1 }
    let r2 = dbg_assert_true(b.vars[1 as usize].is_param == false, 2)
    if r2 != 0 { return r2 }
    let r3 = dbg_assert_true(b.vars[0 as usize].slot == 0, 3)
    if r3 != 0 { return r3 }
    let r4 = dbg_assert_true(b.vars[1 as usize].slot == 1, 4)
    if r4 != 0 { return r4 }
    0
}

// T19: scope_is_ancestor correctly walks the chain
fn test_dbg_scope_is_ancestor() -> i64 with Mut, Div, Panic {
    var b = dbg_info_new()
    // Scope 0 (file) -> Scope 1 (fn) -> Scope 2 (block) -> Scope 3 (loop)
    b = dbg_add_scope(b, DBG_NO_PARENT, DBG_SCOPE_FILE, 1, 100, DBG_NO_FN)
    b = dbg_add_scope(b, 0, DBG_SCOPE_FN, 5, 50, 0)
    b = dbg_add_scope(b, 1, DBG_SCOPE_BLOCK, 10, 30, 0)
    b = dbg_add_scope(b, 2, DBG_SCOPE_LOOP, 15, 25, 0)

    // 0 is ancestor of 3
    let r1 = dbg_assert_true(dbg_scope_is_ancestor(b, 0, 3) == true, 1)
    if r1 != 0 { return r1 }
    // 1 is ancestor of 3
    let r2 = dbg_assert_true(dbg_scope_is_ancestor(b, 1, 3) == true, 2)
    if r2 != 0 { return r2 }
    // 3 is ancestor of itself (trivially yes, since we check current == ancestor first)
    let r3 = dbg_assert_true(dbg_scope_is_ancestor(b, 3, 3) == true, 3)
    if r3 != 0 { return r3 }
    // 3 is NOT ancestor of 0
    let r4 = dbg_assert_true(dbg_scope_is_ancestor(b, 3, 0) == false, 4)
    if r4 != 0 { return r4 }
    // 2 is NOT ancestor of 1
    let r5 = dbg_assert_true(dbg_scope_is_ancestor(b, 2, 1) == false, 5)
    if r5 != 0 { return r5 }
    0
}

// T20: find_line_for_address on sorted table
fn test_dbg_find_line_for_address() -> i64 with Mut, Div, Panic {
    var b = dbg_info_new()
    b = dbg_add_line(b, 0x1000, 10, 1, 0, true)
    b = dbg_add_line(b, 0x1010, 20, 1, 0, true)
    b = dbg_add_line(b, 0x1020, 30, 1, 0, true)
    b = dbg_line_table_sort(b)

    // Exact match at 0x1010 -> index 1
    let i1 = dbg_find_line_for_address(b, 0x1010)
    let r1 = dbg_assert_true(i1 == 1, 1)
    if r1 != 0 { return r1 }

    // Address 0x1018 -> between entry 1 and 2, should return 1
    let i2 = dbg_find_line_for_address(b, 0x1018)
    let r2 = dbg_assert_true(i2 == 1, 2)
    if r2 != 0 { return r2 }

    // Address before first entry
    let i3 = dbg_find_line_for_address(b, 0x0500)
    let r3 = dbg_assert_true(i3 == 0 - 1, 3)
    if r3 != 0 { return r3 }

    // Address after last entry -> should return last
    let i4 = dbg_find_line_for_address(b, 0x2000)
    let r4 = dbg_assert_true(i4 == 2, 4)
    if r4 != 0 { return r4 }
    0
}

// T21: enclosing_fn_scope walks up to function scope
fn test_dbg_enclosing_fn_scope() -> i64 with Mut, Div, Panic {
    var b = dbg_info_new()
    b = dbg_add_scope(b, DBG_NO_PARENT, DBG_SCOPE_FILE, 1, 100, DBG_NO_FN)
    b = dbg_add_scope(b, 0, DBG_SCOPE_FN, 5, 50, 0)
    b = dbg_add_scope(b, 1, DBG_SCOPE_BLOCK, 10, 30, 0)
    b = dbg_add_scope(b, 2, DBG_SCOPE_LOOP, 15, 25, 0)

    // From loop scope (3), enclosing fn is scope 1
    let fn1 = dbg_enclosing_fn_scope(b, 3)
    let r1 = dbg_assert_true(fn1 == 1, 1)
    if r1 != 0 { return r1 }

    // From fn scope (1), enclosing fn is itself
    let fn2 = dbg_enclosing_fn_scope(b, 1)
    let r2 = dbg_assert_true(fn2 == 1, 2)
    if r2 != 0 { return r2 }

    // From file scope (0), no enclosing fn
    let fn3 = dbg_enclosing_fn_scope(b, 0)
    let r3 = dbg_assert_true(fn3 == DBG_NO_SCOPE, 3)
    if r3 != 0 { return r3 }
    0
}

// T22: count_stmts and count_prologue_ends
fn test_dbg_line_table_counts() -> i64 with Mut, Div, Panic {
    var b = dbg_info_new()
    b = dbg_add_line(b, 0x1000, 5, 1, 0, true)
    b = dbg_add_line(b, 0x1004, 5, 5, 0, false)
