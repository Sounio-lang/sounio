    let r5 = dbg_assert_true(b.line_table[1 as usize].address == 0x1008, 5)
    if r5 != 0 { return r5 }
    let r6 = dbg_assert_true(b.line_table[1 as usize].is_stmt == false, 6)
    if r6 != 0 { return r6 }
