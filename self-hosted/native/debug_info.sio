// T17: multiple files can be added
fn test_dbg_multiple_files() -> i64 with Mut, Div, Panic {
    var b = dbg_info_new()
    let f1 = dbg_make_name4(109, 97, 105, 110)  // "main"
    let f2 = dbg_make_name4(108, 105, 98, 46)   // "lib."
    let f3 = dbg_make_name4(117, 116, 105, 108)  // "util"
    b = dbg_add_file(b, f1, 4)
    b = dbg_add_file(b, f2, 4)
    b = dbg_add_file(b, f3, 4)
    let r1 = dbg_assert_true(b.file_count == 3, 1)
    if r1 != 0 { return r1 }
    // First file starts with 'm' = 109
    let r2 = dbg_assert_true(b.files[0 as usize][0 as usize] == 109, 2)
    if r2 != 0 { return r2 }
    // Second file starts with 'l' = 108
    let r3 = dbg_assert_true(b.files[1 as usize][0 as usize] == 108, 3)
    if r3 != 0 { return r3 }
    // Third file starts with 'u' = 117
    let r4 = dbg_assert_true(b.files[2 as usize][0 as usize] == 117, 4)
    if r4 != 0 { return r4 }
    // last_file_id should be 2
    let r5 = dbg_assert_true(dbg_last_file_id(b) == 2, 5)
    if r5 != 0 { return r5 }
    0
}

// T18: DebugVar tracks parameter flag correctly
fn test_dbg_var_param_flag() -> i64 with Mut, Div, Panic {
    var b = dbg_info_new()
    b = dbg_add_scope(b, DBG_NO_PARENT, DBG_SCOPE_FN, 1, 50, 0)
    let loc = dbg_loc_new(1, 5, 0, 0)

    // Add a parameter
    let pname = dbg_make_var_name1(112)  // 'p'
    b = dbg_add_var(b, pname, 1, 1, 0, loc, true, 0)

    // Add a local
