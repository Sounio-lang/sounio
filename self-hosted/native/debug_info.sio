    if r2 != 0 { return r2 }
    0
}

// T10: line_table_sort orders by address
fn test_dbg_line_table_sort() -> i64 with Mut, Div, Panic {
    var b = dbg_info_new()
    // Insert out of order
    b = dbg_add_line(b, 0x2000, 20, 1, 0, true)
    b = dbg_add_line(b, 0x1000, 10, 1, 0, true)
    b = dbg_add_line(b, 0x1800, 15, 1, 0, true)
    b = dbg_line_table_sort(b)
    let r1 = dbg_assert_true(b.line_table[0 as usize].address == 0x1000, 1)
    if r1 != 0 { return r1 }
    let r2 = dbg_assert_true(b.line_table[1 as usize].address == 0x1800, 2)
    if r2 != 0 { return r2 }
    let r3 = dbg_assert_true(b.line_table[2 as usize].address == 0x2000, 3)
    if r3 != 0 { return r3 }
    // Check that line numbers followed the sort
    let r4 = dbg_assert_true(b.line_table[0 as usize].line == 10, 4)
    if r4 != 0 { return r4 }
    let r5 = dbg_assert_true(b.line_table[1 as usize].line == 15, 5)
    if r5 != 0 { return r5 }
    let r6 = dbg_assert_true(b.line_table[2 as usize].line == 20, 6)
    if r6 != 0 { return r6 }
    0
}

// T11: compute_line_deltas produces correct delta encoding
fn test_dbg_compute_line_deltas() -> i64 with Mut, Div, Panic {
    var b = dbg_info_new()
    b = dbg_add_line(b, 0x1000, 10, 1, 0, true)
    b = dbg_add_line(b, 0x1010, 13, 5, 0, false)
    b = dbg_add_line(b, 0x1020, 14, 1, 0, true)
    var deltas: [DebugLineDelta; 4096] = [dbg_empty_line_delta(); 4096]
    deltas = dbg_compute_line_deltas(b, deltas)
    // First entry: absolute values
    let r1 = dbg_assert_true(deltas[0 as usize].delta_address == 0x1000, 1)
    if r1 != 0 { return r1 }
    let r2 = dbg_assert_true(deltas[0 as usize].delta_line == 10, 2)
    if r2 != 0 { return r2 }
    // Second entry: delta from first
    let r3 = dbg_assert_true(deltas[1 as usize].delta_address == 0x10, 3)
    if r3 != 0 { return r3 }
    let r4 = dbg_assert_true(deltas[1 as usize].delta_line == 3, 4)
    if r4 != 0 { return r4 }
    // Third entry: delta from second
    let r5 = dbg_assert_true(deltas[2 as usize].delta_address == 0x10, 5)
    if r5 != 0 { return r5 }
    let r6 = dbg_assert_true(deltas[2 as usize].delta_line == 1, 6)
    if r6 != 0 { return r6 }
    0
}

// T12: find_scope_for_line returns innermost scope
fn test_dbg_find_scope_for_line() -> i64 with Mut, Div, Panic {
    var b = dbg_info_new()
    // File scope: lines 1-100
    b = dbg_add_scope(b, DBG_NO_PARENT, DBG_SCOPE_FILE, 1, 100, DBG_NO_FN)
    // Function scope: lines 5-50
    b = dbg_add_scope(b, 0, DBG_SCOPE_FN, 5, 50, 0)
    // Block scope: lines 10-20
    b = dbg_add_scope(b, 1, DBG_SCOPE_BLOCK, 10, 20, 0)

    // Line 15 should be in block scope (id=2, narrowest)
    let s1 = dbg_find_scope_for_line(b, 15)
    let r1 = dbg_assert_true(s1 == 2, 1)
    if r1 != 0 { return r1 }

    // Line 30 should be in function scope (id=1)
    let s2 = dbg_find_scope_for_line(b, 30)
    let r2 = dbg_assert_true(s2 == 1, 2)
    if r2 != 0 { return r2 }

    // Line 80 should be in file scope (id=0)
    let s3 = dbg_find_scope_for_line(b, 80)
    let r3 = dbg_assert_true(s3 == 0, 3)
    if r3 != 0 { return r3 }

    // Line 200 should be not found
    let s4 = dbg_find_scope_for_line(b, 200)
    let r4 = dbg_assert_true(s4 == DBG_NO_SCOPE, 4)
    if r4 != 0 { return r4 }
    0
}

// T13: scope_depth computes correct nesting
fn test_dbg_scope_depth() -> i64 with Mut, Div, Panic {
    var b = dbg_info_new()
    b = dbg_add_scope(b, DBG_NO_PARENT, DBG_SCOPE_FILE, 1, 100, DBG_NO_FN)
    b = dbg_add_scope(b, 0, DBG_SCOPE_FN, 5, 50, 0)
    b = dbg_add_scope(b, 1, DBG_SCOPE_BLOCK, 10, 20, 0)
    b = dbg_add_scope(b, 2, DBG_SCOPE_LOOP, 12, 18, 0)

    let d0 = dbg_scope_depth(b, 0)
    let r1 = dbg_assert_true(d0 == 0, 1)
    if r1 != 0 { return r1 }

    let d1 = dbg_scope_depth(b, 1)
    let r2 = dbg_assert_true(d1 == 1, 2)
    if r2 != 0 { return r2 }

    let d2 = dbg_scope_depth(b, 2)
    let r3 = dbg_assert_true(d2 == 2, 3)
    if r3 != 0 { return r3 }

    let d3 = dbg_scope_depth(b, 3)
    let r4 = dbg_assert_true(d3 == 3, 4)
    if r4 != 0 { return r4 }
    0
}

// T14: scope_children counts direct children
fn test_dbg_scope_children() -> i64 with Mut, Div, Panic {
    var b = dbg_info_new()
    // Scope 0: file (root)
    b = dbg_add_scope(b, DBG_NO_PARENT, DBG_SCOPE_FILE, 1, 100, DBG_NO_FN)
    // Scope 1: fn, child of 0
    b = dbg_add_scope(b, 0, DBG_SCOPE_FN, 5, 50, 0)
    // Scope 2: fn, child of 0
    b = dbg_add_scope(b, 0, DBG_SCOPE_FN, 55, 90, 1)
    // Scope 3: block, child of 1
    b = dbg_add_scope(b, 1, DBG_SCOPE_BLOCK, 10, 20, 0)

    let c0 = dbg_scope_children(b, 0)
    let r1 = dbg_assert_true(c0 == 2, 1)  // scopes 1 and 2
    if r1 != 0 { return r1 }

    let c1 = dbg_scope_children(b, 1)
    let r2 = dbg_assert_true(c1 == 1, 2)  // scope 3
    if r2 != 0 { return r2 }

    let c2 = dbg_scope_children(b, 2)
    let r3 = dbg_assert_true(c2 == 0, 3)  // no children
    if r3 != 0 { return r3 }
    0
}

// T15: vars_in_scope collects variables from scope chain
fn test_dbg_vars_in_scope() -> i64 with Mut, Div, Panic {
    var b = dbg_info_new()
    b = dbg_add_scope(b, DBG_NO_PARENT, DBG_SCOPE_FILE, 1, 100, DBG_NO_FN)
    b = dbg_add_scope(b, 0, DBG_SCOPE_FN, 5, 50, 0)
    b = dbg_add_scope(b, 1, DBG_SCOPE_BLOCK, 10, 20, 0)

    let loc0 = dbg_loc_new(2, 1, 0, 0)
    let loc1 = dbg_loc_new(6, 1, 0, 1)
    let loc2 = dbg_loc_new(12, 1, 0, 2)

    // Var in file scope (scope 0)
    let vg = dbg_make_var_name1(103)  // 'g'
    b = dbg_add_var(b, vg, 1, 1, 0, loc0, false, 0)
    // Var in fn scope (scope 1)
    let vx = dbg_make_var_name1(120)  // 'x'
    b = dbg_add_var(b, vx, 1, 1, 1, loc1, true, 1)
    // Var in block scope (scope 2)
    let vy = dbg_make_var_name1(121)  // 'y'
    b = dbg_add_var(b, vy, 1, 1, 2, loc2, false, 2)

    // From block scope (2): should see g, x, y (3 total)
    let total = dbg_count_vars_in_scope(b, 2)
    let r1 = dbg_assert_true(total == 3, 1)
    if r1 != 0 { return r1 }

    // From fn scope (1): should see g, x (2 total)
    let total_fn = dbg_count_vars_in_scope(b, 1)
    let r2 = dbg_assert_true(total_fn == 2, 2)
    if r2 != 0 { return r2 }

    // From file scope (0): should see g only (1 total)
    let total_file = dbg_count_vars_in_scope(b, 0)
    let r3 = dbg_assert_true(total_file == 1, 3)
    if r3 != 0 { return r3 }
    0
}

