// self-hosted::native::debug_info — Source-level debug information generation
//
// Builds and manages source-level debug information for the compiler backend.
// Tracks source locations, scopes, variables, and line tables needed for
// debugger support.  Data is stored in flat fixed-size arrays (arena pattern)
// suitable for the bootstrap self-hosted compiler.
//
// The line table uses delta encoding for compact representation, matching
// the DWARF .debug_line state machine model.  Scopes form a tree via
// parent_id links; scope lookup walks the tree to find the innermost
// scope containing a given source line.

// ============================================================================
// Constants
// ============================================================================

let DBG_SCOPE_FILE: i64 = 1
let DBG_SCOPE_FN: i64 = 2
let DBG_SCOPE_BLOCK: i64 = 3
let DBG_SCOPE_LOOP: i64 = 4

let DBG_MAX_FILES: i64 = 64
let DBG_MAX_SCOPES: i64 = 512
let DBG_MAX_VARS: i64 = 1024
let DBG_MAX_LINES: i64 = 4096
let DBG_FILE_NAME_LEN: i64 = 128
let DBG_VAR_NAME_LEN: i64 = 64

// Sentinel for "no parent" / "no scope"
let DBG_NO_PARENT: i64 = 0 - 1
let DBG_NO_SCOPE: i64 = 0 - 1
let DBG_NO_FN: i64 = 0 - 1

// ============================================================================
// Core data structures
// ============================================================================

// A source location: file, line, column, enclosing scope.
struct DebugLoc {
    line: i64,
    column: i64,
    file_id: i64,
    scope_id: i64,
}

// A debug variable: name, type, scope, location, and whether it is a parameter.
struct DebugVar {
    name: [i8; 64],
    name_len: i64,
    type_id: i64,
    scope_id: i64,
    loc: DebugLoc,
    is_param: bool,
    slot: i64,
}

// A lexical scope in the scope tree.
struct DebugScope {
    id: i64,
    parent_id: i64,
    kind: i64,
    start_line: i64,
    end_line: i64,
    fn_id: i64,
}

// A single entry in the line number table.
struct DebugLineEntry {
    address: i64,
    line: i64,
    column: i64,
    file_id: i64,
    is_stmt: bool,
    is_prologue_end: bool,
}

// A delta-encoded line program entry (output of dbg_compute_line_deltas).
struct DebugLineDelta {
    delta_address: i64,
    delta_line: i64,
    column: i64,
    file_id: i64,
    is_stmt: bool,
    is_prologue_end: bool,
}

// The main builder: collects files, scopes, variables, and line entries.
struct DebugInfoBuilder {
    files: [[i8; 128]; 64],
    file_lens: [i64; 64],
    file_count: i64,
    scopes: [DebugScope; 512],
    scope_count: i64,
    vars: [DebugVar; 1024],
    var_count: i64,
    line_table: [DebugLineEntry; 4096],
    line_count: i64,
    current_scope: i64,
}

// ============================================================================
// Constructors
// ============================================================================

fn dbg_loc_new(line: i64, column: i64, file_id: i64, scope_id: i64) -> DebugLoc {
    DebugLoc {
        line: line,
        column: column,
        file_id: file_id,
        scope_id: scope_id,
    }
}

fn dbg_var_new(
    name: [i8; 64], name_len: i64, type_id: i64, scope_id: i64,
    loc: DebugLoc, is_param: bool, slot: i64
) -> DebugVar {
    DebugVar {
        name: name,
        name_len: name_len,
        type_id: type_id,
        scope_id: scope_id,
        loc: loc,
        is_param: is_param,
        slot: slot,
    }
}

fn dbg_scope_new(
    id: i64, parent_id: i64, kind: i64, start_line: i64, end_line: i64, fn_id: i64
) -> DebugScope {
    DebugScope {
        id: id,
        parent_id: parent_id,
        kind: kind,
        start_line: start_line,
        end_line: end_line,
        fn_id: fn_id,
    }
}

fn dbg_line_entry_new(
    address: i64, line: i64, column: i64, file_id: i64,
    is_stmt: bool, is_prologue_end: bool
) -> DebugLineEntry {
    DebugLineEntry {
        address: address,
        line: line,
        column: column,
        file_id: file_id,
        is_stmt: is_stmt,
        is_prologue_end: is_prologue_end,
    }
}

fn dbg_line_delta_new(
    delta_address: i64, delta_line: i64, column: i64, file_id: i64,
    is_stmt: bool, is_prologue_end: bool
) -> DebugLineDelta {
    DebugLineDelta {
        delta_address: delta_address,
        delta_line: delta_line,
        column: column,
        file_id: file_id,
        is_stmt: is_stmt,
        is_prologue_end: is_prologue_end,
    }
}

fn dbg_empty_scope() -> DebugScope {
    DebugScope {
        id: 0,
        parent_id: DBG_NO_PARENT,
        kind: DBG_SCOPE_FILE,
        start_line: 0,
        end_line: 0,
        fn_id: DBG_NO_FN,
    }
}

fn dbg_empty_var() -> DebugVar {
    DebugVar {
        name: [0; 64],
        name_len: 0,
        type_id: 0,
        scope_id: 0,
        loc: dbg_loc_new(0, 0, 0, 0),
        is_param: false,
        slot: 0,
    }
}

fn dbg_empty_line_entry() -> DebugLineEntry {
    DebugLineEntry {
        address: 0,
        line: 0,
        column: 0,
        file_id: 0,
        is_stmt: false,
        is_prologue_end: false,
    }
}

fn dbg_empty_line_delta() -> DebugLineDelta {
    DebugLineDelta {
        delta_address: 0,
        delta_line: 0,
        column: 0,
        file_id: 0,
        is_stmt: false,
        is_prologue_end: false,
    }
}

fn dbg_info_new() -> DebugInfoBuilder with Mut, Panic {
    var builder = DebugInfoBuilder {
        files: [[0; 128]; 64],
        file_lens: [0; 64],
        file_count: 0,
        scopes: [dbg_empty_scope(); 512],
        scope_count: 0,
        vars: [dbg_empty_var(); 1024],
        var_count: 0,
        line_table: [dbg_empty_line_entry(); 4096],
        line_count: 0,
        current_scope: DBG_NO_SCOPE,
    }
    builder
}

// ============================================================================
// File management
// ============================================================================

// Add a source file and return its file_id (index).
// The file name is stored as a fixed-size byte array with length.
fn dbg_add_file(
    builder: DebugInfoBuilder, name: [i8; 128], name_len: i64
) -> DebugInfoBuilder with Mut, Div, Panic {
    var b = builder
    if b.file_count < DBG_MAX_FILES {
        let idx = b.file_count
        // Copy name bytes into the files array
        var fi: i64 = 0
        while fi < name_len {
            if fi < DBG_FILE_NAME_LEN {
                b.files[idx as usize][fi as usize] = name[fi as usize]
            }
            fi = fi + 1
        }
        b.file_lens[idx as usize] = name_len
        b.file_count = b.file_count + 1
    }
    b
}

// Retrieve the file_id of the most recently added file.
fn dbg_last_file_id(builder: DebugInfoBuilder) -> i64 {
    if builder.file_count > 0 {
        builder.file_count - 1
    } else {
        0 - 1
    }
}

// ============================================================================
// Scope management
// ============================================================================

// Add a scope and return the builder.  The scope id is auto-assigned as scope_count.
fn dbg_add_scope(
    builder: DebugInfoBuilder, parent_id: i64, kind: i64,
    start_line: i64, end_line: i64, fn_id: i64
) -> DebugInfoBuilder with Mut, Div, Panic {
    var b = builder
    if b.scope_count < DBG_MAX_SCOPES {
        let idx = b.scope_count
        b.scopes[idx as usize] = dbg_scope_new(idx, parent_id, kind, start_line, end_line, fn_id)
        b.scope_count = b.scope_count + 1
    }
    b
}

// Enter a scope: set current_scope to the most recently added scope.
fn dbg_enter_scope(builder: DebugInfoBuilder) -> DebugInfoBuilder with Mut, Panic {
    var b = builder
    if b.scope_count > 0 {
        b.current_scope = b.scope_count - 1
    }
    b
}

// Leave a scope: set current_scope to the parent of the current scope.
fn dbg_leave_scope(builder: DebugInfoBuilder) -> DebugInfoBuilder with Mut, Div, Panic {
    var b = builder
    if b.current_scope >= 0 && b.current_scope < b.scope_count {
        b.current_scope = b.scopes[b.current_scope as usize].parent_id
    }
    b
}

// Get the current scope id.
fn dbg_current_scope(builder: DebugInfoBuilder) -> i64 {
    builder.current_scope
}

// ============================================================================
// Variable management
// ============================================================================

// Add a debug variable entry.
fn dbg_add_var(
    builder: DebugInfoBuilder, name: [i8; 64], name_len: i64,
    type_id: i64, scope_id: i64, loc: DebugLoc, is_param: bool, slot: i64
) -> DebugInfoBuilder with Mut, Div, Panic {
    var b = builder
    if b.var_count < DBG_MAX_VARS {
        let idx = b.var_count
        b.vars[idx as usize] = dbg_var_new(name, name_len, type_id, scope_id, loc, is_param, slot)
        b.var_count = b.var_count + 1
    }
    b
}

// Count variables in a given scope (direct members only, not inherited).
fn dbg_count_vars_in_scope_direct(builder: DebugInfoBuilder, scope_id: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < builder.var_count {
        if builder.vars[i as usize].scope_id == scope_id {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Collect variable indices visible in a scope.
// Walks up the scope tree and collects variables from each ancestor scope.
// Returns the count of collected indices; indices are written into out_indices.
fn dbg_vars_in_scope(
    builder: DebugInfoBuilder, scope_id: i64,
    out_indices: [i64; 1024]
) -> [i64; 1024] with Mut, Div, Panic {
    var result = out_indices
    var count: i64 = 0
    var current = scope_id

    // Walk up the scope chain (with depth limit to avoid infinite loops).
    var depth: i64 = 0
    let max_depth: i64 = 512
    while current >= 0 && depth < max_depth {
        // Scan all vars for those in this scope.
        var i: i64 = 0
        while i < builder.var_count {
            if builder.vars[i as usize].scope_id == current {
                if count < 1024 {
                    result[count as usize] = i
                    count = count + 1
                }
            }
            i = i + 1
        }
        // Move to parent scope.
        if current >= 0 && current < builder.scope_count {
            current = builder.scopes[current as usize].parent_id
        } else {
            current = 0 - 1
        }
        depth = depth + 1
    }
    result
}

// Count total visible variables in a scope (including ancestors).
fn dbg_count_vars_in_scope(
    builder: DebugInfoBuilder, scope_id: i64
) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var current = scope_id
    var depth: i64 = 0
    let max_depth: i64 = 512
    while current >= 0 && depth < max_depth {
        var i: i64 = 0
        while i < builder.var_count {
            if builder.vars[i as usize].scope_id == current {
                count = count + 1
            }
            i = i + 1
        }
        if current >= 0 && current < builder.scope_count {
            current = builder.scopes[current as usize].parent_id
        } else {
            current = 0 - 1
        }
        depth = depth + 1
    }
    count
}

// ============================================================================
// Line table management
// ============================================================================

// Add a line table entry.
fn dbg_add_line(
    builder: DebugInfoBuilder, address: i64, line: i64, column: i64,
    file_id: i64, is_stmt: bool
) -> DebugInfoBuilder with Mut, Div, Panic {
    var b = builder
    if b.line_count < DBG_MAX_LINES {
        let idx = b.line_count
        b.line_table[idx as usize] = dbg_line_entry_new(
            address, line, column, file_id, is_stmt, false
        )
        b.line_count = b.line_count + 1
    }
    b
}

// Mark the last line table entry as a prologue end.
fn dbg_mark_prologue_end(builder: DebugInfoBuilder) -> DebugInfoBuilder with Mut, Div, Panic {
    var b = builder
    if b.line_count > 0 {
        let idx = b.line_count - 1
        b.line_table[idx as usize].is_prologue_end = true
    }
    b
}

// Sort the line table by address using insertion sort.
fn dbg_line_table_sort(builder: DebugInfoBuilder) -> DebugInfoBuilder with Mut, Div, Panic {
    var b = builder
    var i: i64 = 1
    while i < b.line_count {
        let key = b.line_table[i as usize]
        var j = i - 1
        var done = false
        while j >= 0 && !done {
            if b.line_table[j as usize].address > key.address {
                b.line_table[(j + 1) as usize] = b.line_table[j as usize]
                j = j - 1
            } else {
                done = true
            }
        }
        b.line_table[(j + 1) as usize] = key
        i = i + 1
    }
    b
}

// Compute delta-encoded line program from the sorted line table.
// The first entry has absolute values; subsequent entries have deltas.
// Returns the count of entries written to the output array.
fn dbg_compute_line_deltas(
    builder: DebugInfoBuilder, out: [DebugLineDelta; 4096]
) -> [DebugLineDelta; 4096] with Mut, Div, Panic {
    var result = out
    if builder.line_count == 0 {
        return result
    }

    // First entry: absolute (delta from 0)
    let first = builder.line_table[0 as usize]
    result[0 as usize] = dbg_line_delta_new(
        first.address, first.line, first.column,
        first.file_id, first.is_stmt, first.is_prologue_end
    )

    // Subsequent entries: deltas from previous
    var i: i64 = 1
    while i < builder.line_count {
        let prev = builder.line_table[(i - 1) as usize]
        let cur = builder.line_table[i as usize]
        result[i as usize] = dbg_line_delta_new(
            cur.address - prev.address,
            cur.line - prev.line,
            cur.column,
            cur.file_id,
            cur.is_stmt,
            cur.is_prologue_end
        )
        i = i + 1
    }
    result
}

// Return the number of line table entries.
fn dbg_line_count(builder: DebugInfoBuilder) -> i64 {
    builder.line_count
}

// ============================================================================
// Scope queries
// ============================================================================

// Find the innermost scope containing a given line number.
// Searches all scopes and returns the one with the smallest range that
// still contains the line.  Returns DBG_NO_SCOPE if none found.
fn dbg_find_scope_for_line(
    builder: DebugInfoBuilder, line: i64
) -> i64 with Mut, Div, Panic {
    var best_id: i64 = DBG_NO_SCOPE
    var best_range: i64 = 0x7FFFFFFFFFFFFFFF

    var i: i64 = 0
    while i < builder.scope_count {
        // Soft-keyword: Madaros parser rejects `let scope`.
        let scope_frame = builder.scopes[i as usize]
        if line >= scope_frame.start_line && line <= scope_frame.end_line {
            let range = scope_frame.end_line - scope_frame.start_line
            if range < best_range {
                best_range = range
                best_id = scope_frame.id
            }
        }
        i = i + 1
    }
    best_id
}

// Compute the nesting depth of a scope.
// The file-level scope (no parent) has depth 0, its children depth 1, etc.
fn dbg_scope_depth(
    builder: DebugInfoBuilder, scope_id: i64
) -> i64 with Mut, Div, Panic {
    var depth: i64 = 0
    var current = scope_id
    var limit: i64 = 0
    let max_limit: i64 = 512
    while current >= 0 && limit < max_limit {
        if current >= 0 && current < builder.scope_count {
            let parent = builder.scopes[current as usize].parent_id
            if parent < 0 {
                // Reached root
                current = 0 - 1
            } else {
                depth = depth + 1
                current = parent
            }
        } else {
            current = 0 - 1
        }
        limit = limit + 1
    }
    depth
}

// Count direct children of a scope.
fn dbg_scope_children(
    builder: DebugInfoBuilder, scope_id: i64
) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < builder.scope_count {
        if builder.scopes[i as usize].parent_id == scope_id {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Collect child scope ids into an output array.  Returns the array.
fn dbg_scope_children_ids(
    builder: DebugInfoBuilder, scope_id: i64, out: [i64; 512]
) -> [i64; 512] with Mut, Div, Panic {
    var result = out
    var count: i64 = 0
    var i: i64 = 0
    while i < builder.scope_count {
        if builder.scopes[i as usize].parent_id == scope_id {
            if count < 512 {
                result[count as usize] = builder.scopes[i as usize].id
                count = count + 1
            }
        }
        i = i + 1
    }
    result
}

// Check whether a scope is an ancestor of another scope.
fn dbg_scope_is_ancestor(
    builder: DebugInfoBuilder, ancestor_id: i64, descendant_id: i64
) -> bool with Mut, Div, Panic {
    var current = descendant_id
    var limit: i64 = 0
    let max_limit: i64 = 512
    while current >= 0 && limit < max_limit {
        if current == ancestor_id {
            return true
        }
        if current >= 0 && current < builder.scope_count {
            current = builder.scopes[current as usize].parent_id
        } else {
            current = 0 - 1
        }
        limit = limit + 1
    }
    false
}

// Return the scope kind for a given scope id.
fn dbg_scope_kind(builder: DebugInfoBuilder, scope_id: i64) -> i64 with Mut, Div, Panic {
    if scope_id >= 0 && scope_id < builder.scope_count {
        builder.scopes[scope_id as usize].kind
    } else {
        0
    }
}

// Return the fn_id associated with a scope, or DBG_NO_FN if none.
fn dbg_scope_fn_id(builder: DebugInfoBuilder, scope_id: i64) -> i64 with Mut, Div, Panic {
    if scope_id >= 0 && scope_id < builder.scope_count {
        builder.scopes[scope_id as usize].fn_id
    } else {
        DBG_NO_FN
    }
}

// Find the nearest enclosing function scope from a given scope.
fn dbg_enclosing_fn_scope(
    builder: DebugInfoBuilder, scope_id: i64
) -> i64 with Mut, Div, Panic {
    var current = scope_id
    var limit: i64 = 0
    let max_limit: i64 = 512
    while current >= 0 && limit < max_limit {
        if current >= 0 && current < builder.scope_count {
            if builder.scopes[current as usize].kind == DBG_SCOPE_FN {
                return current
            }
            current = builder.scopes[current as usize].parent_id
        } else {
            current = 0 - 1
        }
        limit = limit + 1
    }
    DBG_NO_SCOPE
}

// ============================================================================
// Line table queries
// ============================================================================

// Find the line entry for a given address (linear search on sorted table).
// Returns the index, or -1 if not found.
fn dbg_find_line_for_address(
    builder: DebugInfoBuilder, address: i64
) -> i64 with Mut, Div, Panic {
    // Find the last entry with address <= target (assumes sorted).
    var best: i64 = 0 - 1
    var i: i64 = 0
    while i < builder.line_count {
        if builder.line_table[i as usize].address <= address {
            best = i
        }
        i = i + 1
    }
    best
}

// Count line entries that are marked as statements.
fn dbg_count_stmts(builder: DebugInfoBuilder) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < builder.line_count {
        if builder.line_table[i as usize].is_stmt {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Count line entries marked as prologue end.
fn dbg_count_prologue_ends(builder: DebugInfoBuilder) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < builder.line_count {
        if builder.line_table[i as usize].is_prologue_end {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// ============================================================================
// Helpers for building test file names
// ============================================================================

// Build a file name buffer from 4 ASCII codes (for short test names).
fn dbg_make_name4(a: i64, b: i64, c: i64, d: i64) -> [i8; 128] with Mut, Div, Panic {
    var buf: [i8; 128] = [0; 128]
    buf[0] = a as i8
    buf[1] = b as i8
    buf[2] = c as i8
    buf[3] = d as i8
    buf
}

// Build a var name buffer from 3 ASCII codes.
fn dbg_make_var_name3(a: i64, b: i64, c: i64) -> [i8; 64] with Mut, Div, Panic {
    var buf: [i8; 64] = [0; 64]
    buf[0] = a as i8
    buf[1] = b as i8
    buf[2] = c as i8
    buf
}

// Build a var name buffer from a single ASCII code.
fn dbg_make_var_name1(a: i64) -> [i8; 64] with Mut, Div, Panic {
    var buf: [i8; 64] = [0; 64]
    buf[0] = a as i8
    buf
}

// ============================================================================
// Tests
// ============================================================================

fn dbg_assert_true(condition: bool, test_number: i64) -> i64 {
    if condition { 0 } else { test_number }
}

// T01: empty builder has zero counts
fn test_dbg_empty_builder() -> i64 with Mut, Div, Panic {
    let b = dbg_info_new()
    let r1 = dbg_assert_true(b.file_count == 0, 1)
    if r1 != 0 { return r1 }
    let r2 = dbg_assert_true(b.scope_count == 0, 2)
    if r2 != 0 { return r2 }
    let r3 = dbg_assert_true(b.var_count == 0, 3)
    if r3 != 0 { return r3 }
    let r4 = dbg_assert_true(b.line_count == 0, 4)
    if r4 != 0 { return r4 }
    let r5 = dbg_assert_true(b.current_scope == DBG_NO_SCOPE, 5)
    if r5 != 0 { return r5 }
    0
}

// T02: DebugLoc constructor populates all fields
fn test_dbg_loc_new() -> i64 with Mut, Div, Panic {
    let loc = dbg_loc_new(10, 5, 0, 3)
    let r1 = dbg_assert_true(loc.line == 10, 1)
    if r1 != 0 { return r1 }
    let r2 = dbg_assert_true(loc.column == 5, 2)
    if r2 != 0 { return r2 }
    let r3 = dbg_assert_true(loc.file_id == 0, 3)
    if r3 != 0 { return r3 }
    let r4 = dbg_assert_true(loc.scope_id == 3, 4)
    if r4 != 0 { return r4 }
    0
}

// T03: DebugScope constructor populates all fields
fn test_dbg_scope_new() -> i64 with Mut, Div, Panic {
    let s = dbg_scope_new(7, 2, DBG_SCOPE_BLOCK, 100, 200, 5)
    let r1 = dbg_assert_true(s.id == 7, 1)
    if r1 != 0 { return r1 }
    let r2 = dbg_assert_true(s.parent_id == 2, 2)
    if r2 != 0 { return r2 }
    let r3 = dbg_assert_true(s.kind == DBG_SCOPE_BLOCK, 3)
    if r3 != 0 { return r3 }
    let r4 = dbg_assert_true(s.start_line == 100, 4)
    if r4 != 0 { return r4 }
    let r5 = dbg_assert_true(s.end_line == 200, 5)
    if r5 != 0 { return r5 }
    let r6 = dbg_assert_true(s.fn_id == 5, 6)
    if r6 != 0 { return r6 }
    0
}

// T04: add_file increments file_count and stores name
fn test_dbg_add_file() -> i64 with Mut, Div, Panic {
    var b = dbg_info_new()
    // "main.sio" = [109, 97, 105, 110, 46, 115, 105, 111]
    let fname = dbg_make_name4(109, 97, 105, 110)  // "main"
    b = dbg_add_file(b, fname, 4)
    let r1 = dbg_assert_true(b.file_count == 1, 1)
    if r1 != 0 { return r1 }
    let r2 = dbg_assert_true(b.file_lens[0 as usize] == 4, 2)
    if r2 != 0 { return r2 }
    let r3 = dbg_assert_true(b.files[0 as usize][0 as usize] == 109, 3)  // 'm'
    if r3 != 0 { return r3 }
    let r4 = dbg_assert_true(dbg_last_file_id(b) == 0, 4)
    if r4 != 0 { return r4 }
    0
}

// T05: add_scope auto-assigns ids and stores scope data
fn test_dbg_add_scope() -> i64 with Mut, Div, Panic {
    var b = dbg_info_new()
    b = dbg_add_scope(b, DBG_NO_PARENT, DBG_SCOPE_FILE, 1, 100, DBG_NO_FN)
    b = dbg_add_scope(b, 0, DBG_SCOPE_FN, 5, 50, 0)
    let r1 = dbg_assert_true(b.scope_count == 2, 1)
    if r1 != 0 { return r1 }
    let r2 = dbg_assert_true(b.scopes[0 as usize].id == 0, 2)
    if r2 != 0 { return r2 }
    let r3 = dbg_assert_true(b.scopes[0 as usize].kind == DBG_SCOPE_FILE, 3)
    if r3 != 0 { return r3 }
    let r4 = dbg_assert_true(b.scopes[1 as usize].id == 1, 4)
    if r4 != 0 { return r4 }
    let r5 = dbg_assert_true(b.scopes[1 as usize].parent_id == 0, 5)
    if r5 != 0 { return r5 }
    let r6 = dbg_assert_true(b.scopes[1 as usize].kind == DBG_SCOPE_FN, 6)
    if r6 != 0 { return r6 }
    0
}

// T06: enter_scope / leave_scope track current_scope correctly
fn test_dbg_enter_leave_scope() -> i64 with Mut, Div, Panic {
    var b = dbg_info_new()
    b = dbg_add_scope(b, DBG_NO_PARENT, DBG_SCOPE_FILE, 1, 100, DBG_NO_FN)
    b = dbg_enter_scope(b)
    let r1 = dbg_assert_true(dbg_current_scope(b) == 0, 1)
    if r1 != 0 { return r1 }

    b = dbg_add_scope(b, 0, DBG_SCOPE_FN, 5, 50, 0)
    b = dbg_enter_scope(b)
    let r2 = dbg_assert_true(dbg_current_scope(b) == 1, 2)
    if r2 != 0 { return r2 }

    b = dbg_leave_scope(b)
    let r3 = dbg_assert_true(dbg_current_scope(b) == 0, 3)
    if r3 != 0 { return r3 }

    b = dbg_leave_scope(b)
    // Parent of scope 0 is DBG_NO_PARENT (-1)
    let r4 = dbg_assert_true(dbg_current_scope(b) == DBG_NO_PARENT, 4)
    if r4 != 0 { return r4 }
    0
}

