// self-hosted::native::gc — Native-v2 GC state layout and decoding helpers
//
// This is the first executable slice of runtime activation: native-v2 now emits
// and publishes a GC-state block, and the allocation slow path records heap
// pressure events into that block.

module native::gc

use native::elf::{StringTable}
use native::stack_maps::{native_v2_data_read_u64}

pub fn native_v2_gc_magic() -> i64 { 0x32434753 } // "SGC2"
pub fn native_v2_gc_version() -> i64 { 1 }

pub fn native_v2_gc_flag_ready() -> i64 { 1 }
pub fn native_v2_gc_flag_slowpath_requested() -> i64 { 2 }
pub fn native_v2_gc_flag_managed_handles() -> i64 { 4 }

pub fn native_v2_gc_reason_none() -> i64 { 0 }
pub fn native_v2_gc_reason_heap_limit() -> i64 { 1 }
pub fn native_v2_gc_reason_handle_table_full() -> i64 { 2 }

pub fn native_v2_object_header_field_descriptor_id() -> i64 { 0 }
pub fn native_v2_object_header_field_payload_size() -> i64 { 8 }
pub fn native_v2_object_header_field_flags() -> i64 { 16 }
pub fn native_v2_object_header_field_handle_id() -> i64 { 24 }
pub fn native_v2_object_header_size() -> i64 { 32 }

pub fn native_v2_handle_entry_field_object_base() -> i64 { 0 }
pub fn native_v2_handle_entry_field_object_size() -> i64 { 8 }
pub fn native_v2_handle_entry_field_descriptor_id() -> i64 { 16 }
pub fn native_v2_handle_entry_field_pin_count() -> i64 { 24 }
pub fn native_v2_handle_entry_field_flags() -> i64 { 32 }
pub fn native_v2_handle_entry_field_epoch() -> i64 { 40 }
pub fn native_v2_handle_entry_size() -> i64 { 48 }
// Managed-handle ceiling for one native-v2 process. Handles are allocated by a
// MONOTONIC bump of RuntimeContext.handle_count and are NEVER reclaimed: the
// only reset emitter (native_v2_emit_gc_empty_frame_reset) is deliberately
// unwired on this backend because stack maps carry slot COUNTS, not a root
// bitmap, so no safe liveness point exists (see the "Fail closed" comment at the
// exit-182 site in native/codegen_x86_linux.sio). This number is therefore a
// hard per-process allocation budget, not a working-set size.
//
// 2^24 (2^20 -> 2^22 on 2026-07-26; 2^22 -> 2^24 on 2026-08-26 together with
// the arena growth below). This MOVES the wall; it does not remove it. The
// lifetime problem is unchanged and still open.
//
// Cost is zero-sum against the heap, not against the ELF. The table is carved
// out of the single fixed anonymous mmap taken in the entry trampoline:
//   handle_table_base = mmap_base + runtime_context_size()
//   heap_base         = handle_table_base + native_v2_handle_table_bytes()
//   heap_limit        = heap_base + (native_v2_arena_bytes() - ctx - handle_table_bytes)
// so ELF FileSiz/MemSiz are unchanged, the virtual mapping is whatever
// native_v2_arena_bytes() says, and RSS grows only for handle-table pages a
// program actually touches (demand-paged MAP_ANONYMOUS). What it does spend is
// heap budget: 48 B/slot, so 2^24 hands 768 MiB of the arena to the table.
//
// Headroom check at this capacity: the smallest MANAGED object is 56 B (32 B
// header + a 24 B three-field aggregate; <=16 B structs are unboxed and take no
// slot, see native_v2_is_small_value_struct_tag). Filling the table therefore
// needs >= 56 * 2^24 = 939 MiB of heap against a 768 MiB table -- ~1.7 GiB of
// the 8 GiB arena, so the handle table stays the FIRST wall reached (the
// invariant this number exists to preserve) and the heap is not starved.
//
// WHY IT MOVED IN LOCKSTEP WITH THE ARENA: leaving it at 2^22 while the arena
// grew 4x would have made small-object programs hit the handle wall (exit 182)
// at exactly the same 4.19M objects as before, with ~7.7 GiB of heap sitting
// unused underneath. The two walls have to stay proportionate or growing one
// buys nothing for half the workloads.
pub fn native_v2_handle_table_capacity_default() -> i64 { 16777216 }

// Size of the single fixed anonymous mapping every native-v2 process takes at
// entry. Raised 2 GiB -> 8 GiB on 2026-08-26; see
// docs/audit/ARENA_EXHAUSTION_TLS_HANDSHAKE_CHAIN_VERIFICATION_DISPATCH_2026-08-26.md.
//
// This is the WHOLE per-process allocation budget, because nothing in it is
// ever reclaimed (see the handle-table comment above and Finding 12 of
// docs/audit/TLS_PREREQ_WIDE_INT_AND_RAW_BUFFERS_2026-08-23.md). Real-CA TLS
// certificate-chain verification spends ~30 MB per verification and ~11.5 MB
// per certificate parsed, so the 2 GiB arena capped a process at a single-digit
// number of HTTPS requests.
//
// LINUX ONLY. The mapping is MAP_PRIVATE|MAP_ANONYMOUS (r10 = 0x22), so the
// kernel backs pages lazily: an 8 GiB mapping costs 8 GiB of ADDRESS SPACE and
// only as much RSS as the program actually touches. The Windows entry path uses
// VirtualAlloc with MEM_COMMIT, which is NOT lazy in the same way, and the
// macOS path is untested at this size -- both deliberately stay at 2 GiB, so
// this constant is referenced only from the two Linux emitters.
//
// The worst case is real, though: a program that runs to arena exhaustion has
// touched everything, so it now reaches ~8 GiB RSS before aborting instead of
// ~2 GiB. That is the deliberate trade -- a runaway costs 4x more memory before
// it dies, in exchange for real workloads not dying at all.
pub fn native_v2_arena_bytes() -> i64 { 8589934592 }
pub fn native_v2_handle_table_bytes() -> i64 { native_v2_handle_entry_size() * native_v2_handle_table_capacity_default() }

// Values stored in struct-base slots may be either a managed handle id
// (1 .. capacity-1) or a raw object-base pointer returned by an unboxed
// small-value allocation. Raw pointers from the native heap always sit
// strictly above the handle-id range.
pub fn native_v2_handle_raw_ptr_threshold() -> i64 { native_v2_handle_table_capacity_default() }

// SysV x86-64 register-pair threshold: ≤16 B value structs must not consume
// a GC handle (issue #919). IR lowering emits aggregate_storage_bytes = n*8
// for n-field struct literals; tag 8 is the Box special case (16 B payload).
// Large fixed buckets (tag 0/1/2) stay managed.
pub fn native_v2_is_small_value_struct_tag(tag: i64) -> bool {
    if tag == 0 { return false }
    if tag == 1 { return false }
    if tag == 2 { return false }
    if tag == 8 { return true }
    if tag > 0 && tag <= 16 { return true }
    false
}

pub fn native_v2_descriptor_magic() -> i64 { 0x32445353 } // "SSD2"
pub fn native_v2_descriptor_version() -> i64 { 1 }

pub fn native_v2_descriptor_kind_struct() -> i64 { 1 }
pub fn native_v2_descriptor_kind_array() -> i64 { 2 }
pub fn native_v2_descriptor_kind_tuple() -> i64 { 3 }
pub fn native_v2_descriptor_kind_box() -> i64 { 4 }
pub fn native_v2_descriptor_kind_opaque() -> i64 { 5 }

pub fn native_v2_descriptor_table_field_magic() -> i64 { 0 }
pub fn native_v2_descriptor_table_field_version() -> i64 { 8 }
pub fn native_v2_descriptor_table_field_count() -> i64 { 16 }
pub fn native_v2_descriptor_table_header_size() -> i64 { 24 }

pub fn native_v2_descriptor_entry_field_id() -> i64 { 0 }
pub fn native_v2_descriptor_entry_field_kind() -> i64 { 8 }
pub fn native_v2_descriptor_entry_field_payload_bytes() -> i64 { 16 }
pub fn native_v2_descriptor_entry_field_payload_slots() -> i64 { 24 }
pub fn native_v2_descriptor_entry_field_pointer_bitmap() -> i64 { 32 }
pub fn native_v2_descriptor_entry_size() -> i64 { 40 }

pub fn native_v2_gc_state_field_magic() -> i64 { 0 }
pub fn native_v2_gc_state_field_version() -> i64 { 8 }
pub fn native_v2_gc_state_field_flags() -> i64 { 16 }
pub fn native_v2_gc_state_field_collection_requests() -> i64 { 24 }
pub fn native_v2_gc_state_field_collections_completed() -> i64 { 32 }
pub fn native_v2_gc_state_field_last_request_size() -> i64 { 40 }
pub fn native_v2_gc_state_field_last_heap_cursor() -> i64 { 48 }
pub fn native_v2_gc_state_field_last_heap_limit() -> i64 { 56 }
pub fn native_v2_gc_state_field_stack_maps_offset() -> i64 { 64 }
pub fn native_v2_gc_state_field_deopt_state_offset() -> i64 { 72 }
pub fn native_v2_gc_state_field_last_reason() -> i64 { 80 }
pub fn native_v2_gc_state_field_last_safepoint_kind() -> i64 { 88 }
pub fn native_v2_gc_state_field_last_code_offset() -> i64 { 96 }
pub fn native_v2_gc_state_field_handle_count() -> i64 { 104 }
pub fn native_v2_gc_state_field_handle_capacity() -> i64 { 112 }
pub fn native_v2_gc_state_field_descriptor_table_offset() -> i64 { 120 }
pub fn native_v2_gc_state_field_descriptor_count() -> i64 { 128 }
pub fn native_v2_gc_state_field_pin_registry_offset() -> i64 { 136 }
pub fn native_v2_gc_state_field_pin_count() -> i64 { 144 }
pub fn native_v2_gc_state_field_collector_epoch() -> i64 { 152 }
pub fn native_v2_gc_state_field_compaction_count() -> i64 { 160 }

pub fn native_v2_gc_state_size() -> i64 { 168 }

pub struct NativeV2GcState {
    pub valid: bool,
    pub magic: i64,
    pub version: i64,
    pub flags: i64,
    pub collection_requests: i64,
    pub collections_completed: i64,
    pub last_request_size: i64,
    pub last_heap_cursor: i64,
    pub last_heap_limit: i64,
    pub stack_maps_offset: i64,
    pub deopt_state_offset: i64,
    pub last_reason: i64,
    pub last_safepoint_kind: i64,
    pub last_code_offset: i64,
    pub handle_count: i64,
    pub handle_capacity: i64,
    pub descriptor_table_offset: i64,
    pub descriptor_count: i64,
    pub pin_registry_offset: i64,
    pub pin_count: i64,
    pub collector_epoch: i64,
    pub compaction_count: i64,
}

pub struct NativeV2DescriptorEntry {
    pub id: i64,
    pub kind: i64,
    pub payload_bytes: i64,
    pub payload_slots: i64,
    pub pointer_bitmap: i64,
}

pub struct NativeV2DescriptorTable {
    pub valid: bool,
    pub magic: i64,
    pub version: i64,
    pub count: i64,
    pub entries: [NativeV2DescriptorEntry; 16],
}

pub fn native_v2_descriptor_entry_empty() -> NativeV2DescriptorEntry {
    NativeV2DescriptorEntry {
        id: 0,
        kind: 0,
        payload_bytes: 0,
        payload_slots: 0,
        pointer_bitmap: 0,
    }
}

pub fn native_v2_descriptor_table_empty() -> NativeV2DescriptorTable {
    NativeV2DescriptorTable {
        valid: false,
        magic: 0,
        version: 0,
        count: 0,
        entries: [native_v2_descriptor_entry_empty(); 16],
    }
}

pub fn native_v2_gc_state_empty() -> NativeV2GcState {
    NativeV2GcState {
        valid: false,
        magic: 0,
        version: 0,
        flags: 0,
        collection_requests: 0,
        collections_completed: 0,
        last_request_size: 0,
        last_heap_cursor: 0,
        last_heap_limit: 0,
        stack_maps_offset: 0,
        deopt_state_offset: 0,
        last_reason: 0,
        last_safepoint_kind: 0,
        last_code_offset: 0,
        handle_count: 0,
        handle_capacity: 0,
        descriptor_table_offset: 0,
        descriptor_count: 0,
        pin_registry_offset: 0,
        pin_count: 0,
        collector_epoch: 0,
        compaction_count: 0,
    }
}

pub fn native_v2_gc_state_decode(data: StringTable, offset: i64) -> NativeV2GcState with Mut, Panic, Div {
    var state = native_v2_gc_state_empty()
    if offset < 0 || (offset + native_v2_gc_state_size() - 1) >= data.len {
        return state
    }
    state.magic = native_v2_data_read_u64(data, offset + native_v2_gc_state_field_magic())
    state.version = native_v2_data_read_u64(data, offset + native_v2_gc_state_field_version())
    state.flags = native_v2_data_read_u64(data, offset + native_v2_gc_state_field_flags())
    state.collection_requests = native_v2_data_read_u64(data, offset + native_v2_gc_state_field_collection_requests())
    state.collections_completed = native_v2_data_read_u64(data, offset + native_v2_gc_state_field_collections_completed())
    state.last_request_size = native_v2_data_read_u64(data, offset + native_v2_gc_state_field_last_request_size())
    state.last_heap_cursor = native_v2_data_read_u64(data, offset + native_v2_gc_state_field_last_heap_cursor())
    state.last_heap_limit = native_v2_data_read_u64(data, offset + native_v2_gc_state_field_last_heap_limit())
    state.stack_maps_offset = native_v2_data_read_u64(data, offset + native_v2_gc_state_field_stack_maps_offset())
    state.deopt_state_offset = native_v2_data_read_u64(data, offset + native_v2_gc_state_field_deopt_state_offset())
    state.last_reason = native_v2_data_read_u64(data, offset + native_v2_gc_state_field_last_reason())
    state.last_safepoint_kind = native_v2_data_read_u64(data, offset + native_v2_gc_state_field_last_safepoint_kind())
    state.last_code_offset = native_v2_data_read_u64(data, offset + native_v2_gc_state_field_last_code_offset())
    state.handle_count = native_v2_data_read_u64(data, offset + native_v2_gc_state_field_handle_count())
    state.handle_capacity = native_v2_data_read_u64(data, offset + native_v2_gc_state_field_handle_capacity())
    state.descriptor_table_offset = native_v2_data_read_u64(data, offset + native_v2_gc_state_field_descriptor_table_offset())
    state.descriptor_count = native_v2_data_read_u64(data, offset + native_v2_gc_state_field_descriptor_count())
    state.pin_registry_offset = native_v2_data_read_u64(data, offset + native_v2_gc_state_field_pin_registry_offset())
    state.pin_count = native_v2_data_read_u64(data, offset + native_v2_gc_state_field_pin_count())
    state.collector_epoch = native_v2_data_read_u64(data, offset + native_v2_gc_state_field_collector_epoch())
    state.compaction_count = native_v2_data_read_u64(data, offset + native_v2_gc_state_field_compaction_count())
    state.valid = state.magic == native_v2_gc_magic() && state.version == native_v2_gc_version()
    state
}

pub fn native_v2_descriptor_table_decode(data: StringTable, offset: i64) -> NativeV2DescriptorTable with Mut, Panic, Div {
    var table = native_v2_descriptor_table_empty()
    if offset < 0 || (offset + native_v2_descriptor_table_header_size() - 1) >= data.len {
        return table
    }
    table.magic = native_v2_data_read_u64(data, offset + native_v2_descriptor_table_field_magic())
    table.version = native_v2_data_read_u64(data, offset + native_v2_descriptor_table_field_version())
    table.count = native_v2_data_read_u64(data, offset + native_v2_descriptor_table_field_count())

    var cursor = offset + native_v2_descriptor_table_header_size()
    var i: i64 = 0
    while i < table.count && i < 16 && (cursor + native_v2_descriptor_entry_size() - 1) < data.len {
        var entry = native_v2_descriptor_entry_empty()
        entry.id = native_v2_data_read_u64(data, cursor + native_v2_descriptor_entry_field_id())
        entry.kind = native_v2_data_read_u64(data, cursor + native_v2_descriptor_entry_field_kind())
        entry.payload_bytes = native_v2_data_read_u64(data, cursor + native_v2_descriptor_entry_field_payload_bytes())
        entry.payload_slots = native_v2_data_read_u64(data, cursor + native_v2_descriptor_entry_field_payload_slots())
        entry.pointer_bitmap = native_v2_data_read_u64(data, cursor + native_v2_descriptor_entry_field_pointer_bitmap())
        table.entries[i as usize] = entry
        cursor = cursor + native_v2_descriptor_entry_size()
        i = i + 1
    }

    table.valid = table.magic == native_v2_descriptor_magic() && table.version == native_v2_descriptor_version()
    table
}

pub let NATIVE_V2_GC_MODEL_MAX_HANDLES: i64 = 32
pub let NATIVE_V2_GC_MODEL_MAX_ROOTS: i64 = 64
pub let NATIVE_V2_GC_MODEL_MAX_SLOTS: i64 = 16

pub fn native_v2_gc_handle_flag_live() -> i64 { 1 }
pub fn native_v2_gc_handle_flag_marked() -> i64 { 2 }
pub fn native_v2_gc_handle_flag_pinned() -> i64 { 4 }
pub fn native_v2_gc_handle_flag_moved() -> i64 { 8 }

pub struct NativeV2GcModelHandle {
    pub in_use: bool,
    pub object_base: i64,
    pub object_size: i64,
    pub descriptor_id: i64,
    pub pin_count: i64,
    pub flags: i64,
    pub epoch: i64,
    pub slots: [i64; 16],
}

pub struct NativeV2GcModel {
    pub state: NativeV2GcState,
    pub descriptor_table: NativeV2DescriptorTable,
    pub heap_base: i64,
    pub handles: [NativeV2GcModelHandle; 32],
    pub handle_count: i64,
    pub roots: [i64; 64],
    pub root_count: i64,
    pub live_count: i64,
    pub freed_count: i64,
    pub moved_count: i64,
    pub pinned_live_count: i64,
}

pub fn native_v2_gc_model_handle_empty() -> NativeV2GcModelHandle {
    NativeV2GcModelHandle {
        in_use: false,
        object_base: 0,
        object_size: 0,
        descriptor_id: 0,
        pin_count: 0,
        flags: 0,
        epoch: 0,
        slots: [0; 16],
    }
}

pub fn native_v2_gc_model_empty() -> NativeV2GcModel {
    var state = native_v2_gc_state_empty()
    state.valid = true
    state.magic = native_v2_gc_magic()
    state.version = native_v2_gc_version()
    state.flags = native_v2_gc_flag_ready() + native_v2_gc_flag_managed_handles()
    state.handle_capacity = NATIVE_V2_GC_MODEL_MAX_HANDLES
    NativeV2GcModel {
        state: state,
        descriptor_table: native_v2_descriptor_table_empty(),
        heap_base: 0,
        handles: [native_v2_gc_model_handle_empty(); 32],
        handle_count: 0,
        roots: [0; 64],
        root_count: 0,
        live_count: 0,
        freed_count: 0,
        moved_count: 0,
        pinned_live_count: 0,
    }
}

pub fn native_v2_descriptor_entry_make(id: i64, kind: i64, payload_bytes: i64, payload_slots: i64, pointer_bitmap: i64) -> NativeV2DescriptorEntry {
    NativeV2DescriptorEntry {
        id: id,
        kind: kind,
        payload_bytes: payload_bytes,
        payload_slots: payload_slots,
        pointer_bitmap: pointer_bitmap,
    }
}

pub fn native_v2_descriptor_table_add_entry(table: NativeV2DescriptorTable, entry: NativeV2DescriptorEntry) -> NativeV2DescriptorTable with Mut, Panic, Div {
    var next = table
    if next.count >= 0 && next.count < 16 {
        next.entries[next.count as usize] = entry
        next.count = next.count + 1
        next.magic = native_v2_descriptor_magic()
        next.version = native_v2_descriptor_version()
        next.valid = true
    }
    next
}

pub fn native_v2_descriptor_table_lookup(table: NativeV2DescriptorTable, descriptor_id: i64) -> NativeV2DescriptorEntry with Mut, Panic, Div {
    var i: i64 = 0
    while i < table.count && i < 16 {
        let entry = table.entries[i as usize]
        if entry.id == descriptor_id {
            return entry
        }
        i = i + 1
    }
    native_v2_descriptor_entry_empty()
}

pub fn native_v2_gc_model_active_handle_count(model: NativeV2GcModel) -> i64 with Mut, Panic, Div {
    var count: i64 = 0
    var i: i64 = 1
    while i < NATIVE_V2_GC_MODEL_MAX_HANDLES {
        if model.handles[i as usize].in_use {
            count = count + 1
        }
        i = i + 1
    }
    count
}

pub fn native_v2_gc_model_add_descriptor(
    model: NativeV2GcModel,
    id: i64,
    kind: i64,
    payload_bytes: i64,
    payload_slots: i64,
    pointer_bitmap: i64
) -> NativeV2GcModel with Mut, Panic, Div {
    var next = model
    next.descriptor_table = native_v2_descriptor_table_add_entry(
        next.descriptor_table,
        native_v2_descriptor_entry_make(id, kind, payload_bytes, payload_slots, pointer_bitmap)
    )
    next.state.descriptor_count = next.descriptor_table.count
    next
}

pub fn native_v2_gc_model_define_handle(
    model: NativeV2GcModel,
    handle_id: i64,
    object_base: i64,
    object_size: i64,
    descriptor_id: i64,
    pin_count: i64
) -> NativeV2GcModel with Mut, Panic, Div {
    var next = model
    if handle_id <= 0 || handle_id >= NATIVE_V2_GC_MODEL_MAX_HANDLES {
        return next
    }
    var handle = native_v2_gc_model_handle_empty()
    handle.in_use = true
    handle.object_base = object_base
    handle.object_size = object_size
    handle.descriptor_id = descriptor_id
    handle.pin_count = pin_count
    handle.flags = if pin_count > 0 { native_v2_gc_handle_flag_pinned() } else { 0 }
    handle.epoch = next.state.collector_epoch
    next.handles[handle_id as usize] = handle
    next.handle_count = native_v2_gc_model_active_handle_count(next)
    next.state.handle_count = next.handle_count
    next.state.handle_capacity = NATIVE_V2_GC_MODEL_MAX_HANDLES
    next
}

pub fn native_v2_gc_model_set_slot(model: NativeV2GcModel, handle_id: i64, slot_idx: i64, child_handle_id: i64) -> NativeV2GcModel with Mut, Panic, Div {
    var next = model
    if handle_id <= 0 || handle_id >= NATIVE_V2_GC_MODEL_MAX_HANDLES {
        return next
    }
    if slot_idx < 0 || slot_idx >= NATIVE_V2_GC_MODEL_MAX_SLOTS {
        return next
    }
    var handle = next.handles[handle_id as usize]
    if !handle.in_use {
        return next
    }
    handle.slots[slot_idx as usize] = child_handle_id
    next.handles[handle_id as usize] = handle
    next
}

pub fn native_v2_gc_model_add_root(model: NativeV2GcModel, handle_id: i64) -> NativeV2GcModel with Mut, Panic, Div {
    var next = model
    if handle_id <= 0 || handle_id >= NATIVE_V2_GC_MODEL_MAX_HANDLES {
        return next
    }
    if next.root_count >= 0 && next.root_count < NATIVE_V2_GC_MODEL_MAX_ROOTS {
        next.roots[next.root_count as usize] = handle_id
        next.root_count = next.root_count + 1
    }
    next
}

pub fn native_v2_gc_model_collect(model: NativeV2GcModel) -> NativeV2GcModel with Mut, Panic, Div {
    var next = model
    var marks: [i64; 32] = [0; 32]
    var worklist: [i64; 64] = [0; 64]
    var work_count: i64 = 0
    var i: i64 = 0

    while i < next.root_count && i < NATIVE_V2_GC_MODEL_MAX_ROOTS {
        let handle_id = next.roots[i as usize]
        if handle_id > 0 && handle_id < NATIVE_V2_GC_MODEL_MAX_HANDLES && next.handles[handle_id as usize].in_use && marks[handle_id as usize] == 0 {
            marks[handle_id as usize] = 1
            worklist[work_count as usize] = handle_id
            work_count = work_count + 1
        }
        i = i + 1
    }

    i = 1
    while i < NATIVE_V2_GC_MODEL_MAX_HANDLES {
        let handle = next.handles[i as usize]
        if handle.in_use && handle.pin_count > 0 && marks[i as usize] == 0 && work_count < NATIVE_V2_GC_MODEL_MAX_ROOTS {
            marks[i as usize] = 1
            worklist[work_count as usize] = i
            work_count = work_count + 1
        }
        i = i + 1
    }

    var work_idx: i64 = 0
    while work_idx < work_count {
        let handle_id = worklist[work_idx as usize]
        let handle = next.handles[handle_id as usize]
        let descriptor = native_v2_descriptor_table_lookup(next.descriptor_table, handle.descriptor_id)
        var slot_idx: i64 = 0
        while slot_idx < descriptor.payload_slots && slot_idx < NATIVE_V2_GC_MODEL_MAX_SLOTS {
            if (descriptor.pointer_bitmap & (1 << slot_idx)) != 0 {
                let child_handle_id = handle.slots[slot_idx as usize]
                if child_handle_id > 0 && child_handle_id < NATIVE_V2_GC_MODEL_MAX_HANDLES && next.handles[child_handle_id as usize].in_use && marks[child_handle_id as usize] == 0 && work_count < NATIVE_V2_GC_MODEL_MAX_ROOTS {
                    marks[child_handle_id as usize] = 1
                    worklist[work_count as usize] = child_handle_id
                    work_count = work_count + 1
                }
            }
            slot_idx = slot_idx + 1
        }
        work_idx = work_idx + 1
    }

    var cursor = next.heap_base
    var live_count: i64 = 0
    var freed_count: i64 = 0
    var moved_count: i64 = 0
    var pinned_live_count: i64 = 0
    i = 1
    while i < NATIVE_V2_GC_MODEL_MAX_HANDLES {
        var handle = next.handles[i as usize]
        if handle.in_use {
            if marks[i as usize] != 0 {
                live_count = live_count + 1
                handle.flags = native_v2_gc_handle_flag_live() | native_v2_gc_handle_flag_marked()
                if handle.pin_count > 0 {
                    handle.flags = handle.flags | native_v2_gc_handle_flag_pinned()
                    pinned_live_count = pinned_live_count + 1
                    if (handle.object_base + handle.object_size) > cursor {
                        cursor = handle.object_base + handle.object_size
                    }
                } else {
                    let old_base = handle.object_base
                    if old_base != cursor {
                        moved_count = moved_count + 1
                        handle.flags = handle.flags | native_v2_gc_handle_flag_moved()
                    }
                    handle.object_base = cursor
                    cursor = cursor + handle.object_size
                }
                handle.epoch = next.state.collector_epoch + 1
                next.handles[i as usize] = handle
            } else {
                freed_count = freed_count + 1
                next.handles[i as usize] = native_v2_gc_model_handle_empty()
            }
        }
        i = i + 1
    }

    next.live_count = live_count
    next.freed_count = freed_count
    next.moved_count = moved_count
    next.pinned_live_count = pinned_live_count
    next.handle_count = live_count

    next.state.flags = native_v2_gc_flag_ready() + native_v2_gc_flag_managed_handles()
    next.state.collection_requests = next.state.collection_requests + 1
    next.state.collections_completed = next.state.collections_completed + 1
    next.state.last_reason = native_v2_gc_reason_heap_limit()
    next.state.last_heap_cursor = cursor
    next.state.handle_count = live_count
    next.state.handle_capacity = NATIVE_V2_GC_MODEL_MAX_HANDLES
    next.state.descriptor_count = next.descriptor_table.count
    next.state.pin_count = pinned_live_count
    next.state.collector_epoch = next.state.collector_epoch + 1
    next.state.compaction_count = next.state.compaction_count + 1
    next
}
