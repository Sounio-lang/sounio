fn test_sigh_pop_frame_inner(table: &! SighTable) -> bool with Mut, Div, Panic {
    let ok = sigh_push_frame(table, 0x1000, 0x2000, 0x3000, SIGH_INT)
    let frame = sigh_pop_frame(table)
