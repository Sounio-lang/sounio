    if r1 != 0 { return false }
    let r2 = sigh_assert(frame.saved_sp == 0x2000, 2)
    if r2 != 0 { return false }
    let r3 = sigh_assert(frame.saved_bp == 0x3000, 3)
    if r3 != 0 { return false }
    let r4 = sigh_assert(frame.signal_num == SIGH_INT, 4)
    if r4 != 0 { return false }
    let r5 = sigh_assert(sigh_in_handler(table) == false, 5)
    if r5 != 0 { return false }
    true
}
