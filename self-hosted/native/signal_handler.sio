// --- Code emission (5 tests) ---

fn test_sigh_encode_sigaction_inner(table: &! SighTable) -> bool with Mut, Div, Panic {
    let buf = sigh_encode_sigaction_syscall(SIGH_INT, 0x1000)
    // First byte should be 0x48 (REX.W prefix for mov rax, imm32)
    let r1 = sigh_assert(buf[0 as usize] == 0x48 as i8, 1)
    if r1 != 0 { return false }
    // Second byte should be 0xc7 (mov r/m64, imm32)
    let r2 = sigh_assert(buf[1 as usize] == 0xc7 as i8, 2)
    if r2 != 0 { return false }
    // Third byte should be 0xc0 (ModRM: rax)
    let r3 = sigh_assert(buf[2 as usize] == 0xc0 as i8, 3)
    if r3 != 0 { return false }
    // imm32 should be 13 (rt_sigaction syscall number) in LE
    let r4 = sigh_assert(buf[3 as usize] == 13 as i8, 4)
    if r4 != 0 { return false }
    true
}
fn test_sigh_encode_sigaction() -> bool with Mut, Div, Panic {
    var table = sigh_table_new()
    test_sigh_encode_sigaction_inner(&! table)
}

fn test_sigh_encode_sigreturn_inner(table: &! SighTable) -> bool with Mut, Div, Panic {
    let buf = sigh_encode_sigreturn()
    // mov rax, 15 -> 48 c7 c0 0f 00 00 00
    let r1 = sigh_assert(buf[0 as usize] == 0x48 as i8, 1)
    if r1 != 0 { return false }
    let r2 = sigh_assert(buf[1 as usize] == 0xc7 as i8, 2)
    if r2 != 0 { return false }
    let r3 = sigh_assert(buf[2 as usize] == 0xc0 as i8, 3)
    if r3 != 0 { return false }
    let r4 = sigh_assert(buf[3 as usize] == 0x0f as i8, 4)
    if r4 != 0 { return false }
    // syscall -> 0f 05
    let r5 = sigh_assert(buf[7 as usize] == 0x0f as i8, 5)
    if r5 != 0 { return false }
    true
}
fn test_sigh_encode_sigreturn() -> bool with Mut, Div, Panic {
    var table = sigh_table_new()
    test_sigh_encode_sigreturn_inner(&! table)
}

fn test_sigh_encode_trampoline_inner(table: &! SighTable) -> bool with Mut, Div, Panic {
    let buf = sigh_encode_signal_trampoline(0x100)
    // First byte should be push rbp (0x55)
    let r1 = sigh_assert(buf[0 as usize] == 0x55 as i8, 1)
    if r1 != 0 { return false }
    // mov rbp, rsp starts at offset 1: 48 89 e5
    let r2 = sigh_assert(buf[1 as usize] == 0x48 as i8, 2)
    if r2 != 0 { return false }
    let r3 = sigh_assert(buf[2 as usize] == 0x89 as i8, 3)
    if r3 != 0 { return false }
    let r4 = sigh_assert(buf[3 as usize] == 0xe5 as i8, 4)
    if r4 != 0 { return false }
    true
}
fn test_sigh_encode_trampoline() -> bool with Mut, Div, Panic {
    var table = sigh_table_new()
    test_sigh_encode_trampoline_inner(&! table)
}

fn test_sigh_trampoline_size_inner(table: &! SighTable) -> bool with Mut, Div, Panic {
    let size = sigh_trampoline_size()
    let r1 = sigh_assert(size == 43, 1)
    if r1 != 0 { return false }
    let r2 = sigh_assert(size > 0, 2)
    if r2 != 0 { return false }
    true
}
fn test_sigh_trampoline_size() -> bool with Mut, Div, Panic {
    var table = sigh_table_new()
    test_sigh_trampoline_size_inner(&! table)
}

fn test_sigh_sigreturn_syscall_bytes_inner(table: &! SighTable) -> bool with Mut, Div, Panic {
    let buf = sigh_encode_sigreturn()
    // Verify the syscall instruction at offset 7-8
    let r1 = sigh_assert(buf[8 as usize] == 0x05 as i8, 1)
    if r1 != 0 { return false }
    // Verify remaining bytes are zero-padded
    let r2 = sigh_assert(buf[9 as usize] == 0 as i8, 2)
    if r2 != 0 { return false }
    let r3 = sigh_assert(buf[15 as usize] == 0 as i8, 3)
    if r3 != 0 { return false }
    true
}
fn test_sigh_sigreturn_syscall_bytes() -> bool with Mut, Div, Panic {
    var table = sigh_table_new()
    test_sigh_sigreturn_syscall_bytes_inner(&! table)
}

