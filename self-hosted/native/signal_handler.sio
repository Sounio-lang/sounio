fn test_sigh_nested_frames_inner(table: &! SighTable) -> bool with Mut, Div, Panic {
    let ok1 = sigh_push_frame(table, 0x10, 0x20, 0x30, SIGH_INT)
    let ok2 = sigh_push_frame(table, 0x40, 0x50, 0x60, SIGH_TERM)
    let ok3 = sigh_push_frame(table, 0x70, 0x80, 0x90, SIGH_SEGV)
    let r1 = sigh_assert(sigh_handler_depth(table) == 3, 1)
    if r1 != 0 { return false }
    let f3 = sigh_pop_frame(table)
    let r2 = sigh_assert(f3.signal_num == SIGH_SEGV, 2)
    if r2 != 0 { return false }
    let f2 = sigh_pop_frame(table)
    let r3 = sigh_assert(f2.signal_num == SIGH_TERM, 3)
    if r3 != 0 { return false }
    let f1 = sigh_pop_frame(table)
    let r4 = sigh_assert(f1.signal_num == SIGH_INT, 4)
    if r4 != 0 { return false }
    let r5 = sigh_assert(sigh_in_handler(table) == false, 5)
    if r5 != 0 { return false }
    true
}
fn test_sigh_nested_frames() -> bool with Mut, Div, Panic {
    var table = sigh_table_new()
    test_sigh_nested_frames_inner(&! table)
}

