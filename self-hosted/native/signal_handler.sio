fn test_sigh_platform_roundtrip_inner(table: &! SighTable) -> bool with Mut, Div, Panic {
    // Verify roundtrip: to_platform(from_platform(x)) == x for valid signals
    let r1 = sigh_assert(sigh_to_platform(sigh_from_platform(1)) == 1, 1)
    if r1 != 0 { return false }
    let r2 = sigh_assert(sigh_to_platform(sigh_from_platform(15)) == 15, 2)
    if r2 != 0 { return false }
    let r3 = sigh_assert(sigh_to_platform(sigh_from_platform(31)) == 31, 3)
    if r3 != 0 { return false }
    // Invalid roundtrip
    let r4 = sigh_assert(sigh_from_platform(0) == SIGH_INVALID, 4)
    if r4 != 0 { return false }
    true
}
