// --- Edge cases (5 tests) ---

fn test_sigh_empty_table_inner(table: &! SighTable) -> bool with Mut, Div, Panic {
    // All actions should be default
    let act = sigh_get_action(table, SIGH_INT)
    let r1 = sigh_assert(act.disposition == SIGH_DFL, 1)
    if r1 != 0 { return false }
    let r2 = sigh_assert(sigh_in_handler(table) == false, 2)
    if r2 != 0 { return false }
    let r3 = sigh_assert(sigh_handler_depth(table) == 0, 3)
    if r3 != 0 { return false }
    true
}
fn test_sigh_empty_table() -> bool with Mut, Div, Panic {
    var table = sigh_table_new()
    test_sigh_empty_table_inner(&! table)
}

fn test_sigh_kill_not_catchable_inner(table: &! SighTable) -> bool with Mut, Div, Panic {
    // Cannot set handler for KILL
    let ok1 = sigh_set_handler(table, SIGH_KILL, 0x9999, false)
    let r1 = sigh_assert(ok1 == false, 1)
    if r1 != 0 { return false }
    // Cannot ignore KILL
    let ok2 = sigh_set_ignore(table, SIGH_KILL)
    let r2 = sigh_assert(ok2 == false, 2)
    if r2 != 0 { return false }
    // Cannot block KILL
    let ok3 = sigh_block(table, SIGH_KILL)
    let r3 = sigh_assert(ok3 == false, 3)
    if r3 != 0 { return false }
    // Can still set KILL to SIGH_DFL (no-op since already default)
    let ok4 = sigh_set_default(table, SIGH_KILL)
    let r4 = sigh_assert(ok4, 4)
    if r4 != 0 { return false }
    true
}
fn test_sigh_kill_not_catchable() -> bool with Mut, Div, Panic {
    var table = sigh_table_new()
    test_sigh_kill_not_catchable_inner(&! table)
}

fn test_sigh_stop_not_catchable_inner(table: &! SighTable) -> bool with Mut, Div, Panic {
    let ok1 = sigh_set_handler(table, SIGH_STOP, 0x8888, false)
    let r1 = sigh_assert(ok1 == false, 1)
    if r1 != 0 { return false }
    let ok2 = sigh_set_ignore(table, SIGH_STOP)
    let r2 = sigh_assert(ok2 == false, 2)
    if r2 != 0 { return false }
    let ok3 = sigh_block(table, SIGH_STOP)
    let r3 = sigh_assert(ok3 == false, 3)
    if r3 != 0 { return false }
    true
}
fn test_sigh_stop_not_catchable() -> bool with Mut, Div, Panic {
    var table = sigh_table_new()
    test_sigh_stop_not_catchable_inner(&! table)
}

fn test_sigh_multiple_raise_deliver_inner(table: &! SighTable) -> bool with Mut, Div, Panic {
    let ok1 = sigh_set_handler(table, SIGH_INT, 0x1000, false)
    let ok2 = sigh_set_handler(table, SIGH_TERM, 0x2000, false)
    // Raise multiple signals
    let ok3 = sigh_raise(table, SIGH_INT)
    let ok4 = sigh_raise(table, SIGH_TERM)
    let ok5 = sigh_raise(table, SIGH_INT)
    let r1 = sigh_assert(sigh_pending_count(table) == 3, 1)
    if r1 != 0 { return false }
    let delivered = sigh_deliver_pending(table)
    let r2 = sigh_assert(delivered == 3, 2)
    if r2 != 0 { return false }
    let r3 = sigh_assert(table.total_caught == 3, 3)
    if r3 != 0 { return false }
    let r4 = sigh_assert(sigh_pending_count(table) == 0, 4)
    if r4 != 0 { return false }
    true
}
fn test_sigh_multiple_raise_deliver() -> bool with Mut, Div, Panic {
    var table = sigh_table_new()
    test_sigh_multiple_raise_deliver_inner(&! table)
}

fn test_sigh_set_mask_inner(table: &! SighTable) -> bool with Mut, Div, Panic {
    var new_mask: [bool; 32] = [false; 32]
    new_mask[SIGH_INT as usize] = true
    new_mask[SIGH_TERM as usize] = true
    new_mask[SIGH_KILL as usize] = true   // Should be silently ignored
    new_mask[SIGH_STOP as usize] = true   // Should be silently ignored
    let r = sigh_set_mask(table, new_mask)
    let r1 = sigh_assert(r == 0, 1)
    if r1 != 0 { return false }
    let r2 = sigh_assert(sigh_is_blocked(table, SIGH_INT), 2)
    if r2 != 0 { return false }
    let r3 = sigh_assert(sigh_is_blocked(table, SIGH_TERM), 3)
    if r3 != 0 { return false }
    // KILL and STOP must not be blocked
    let r4 = sigh_assert(sigh_is_blocked(table, SIGH_KILL) == false, 4)
    if r4 != 0 { return false }
    let r5 = sigh_assert(sigh_is_blocked(table, SIGH_STOP) == false, 5)
    if r5 != 0 { return false }
    true
}
fn test_sigh_set_mask() -> bool with Mut, Div, Panic {
    var table = sigh_table_new()
    test_sigh_set_mask_inner(&! table)
}

// ============================================================================
// Test Runner
// ============================================================================

fn sigh_run_tests() -> i64 with Mut, Div, Panic {
    var passed: i64 = 0

    // Signal constants / validity (5 tests)
    if test_sigh_constants() { passed = passed + 1 }
    if test_sigh_valid_signals() { passed = passed + 1 }
    if test_sigh_catchable() { passed = passed + 1 }
    if test_sigh_fatal() { passed = passed + 1 }
    if test_sigh_name_lookup() { passed = passed + 1 }

    // Disposition management (5 tests)
    if test_sigh_set_action() { passed = passed + 1 }
    if test_sigh_set_default() { passed = passed + 1 }
    if test_sigh_set_ignore() { passed = passed + 1 }
    if test_sigh_set_handler() { passed = passed + 1 }
    if test_sigh_reset_all() { passed = passed + 1 }

    // Signal masking (5 tests)
    if test_sigh_block() { passed = passed + 1 }
    if test_sigh_unblock() { passed = passed + 1 }
    if test_sigh_block_all() { passed = passed + 1 }
    if test_sigh_unblock_all() { passed = passed + 1 }
    if test_sigh_save_restore_mask() { passed = passed + 1 }

    // Signal delivery (5 tests)
    if test_sigh_raise_basic() { passed = passed + 1 }
    if test_sigh_raise_ignored() { passed = passed + 1 }
    if test_sigh_deliver_pending() { passed = passed + 1 }
    if test_sigh_deliver_blocked() { passed = passed + 1 }
    if test_sigh_raise_invalid() { passed = passed + 1 }

    // Pending signals (5 tests)
    if test_sigh_has_pending_empty() { passed = passed + 1 }
    if test_sigh_next_pending() { passed = passed + 1 }
    if test_sigh_next_pending_blocked() { passed = passed + 1 }
    if test_sigh_clear_pending() { passed = passed + 1 }
    if test_sigh_next_pending_none() { passed = passed + 1 }

    // Frame management (5 tests)
    if test_sigh_push_frame() { passed = passed + 1 }
    if test_sigh_pop_frame() { passed = passed + 1 }
    if test_sigh_current_frame() { passed = passed + 1 }
    if test_sigh_nested_frames() { passed = passed + 1 }
    if test_sigh_pop_empty_frame() { passed = passed + 1 }

    // Code emission (5 tests)
    if test_sigh_encode_sigaction() { passed = passed + 1 }
    if test_sigh_encode_sigreturn() { passed = passed + 1 }
    if test_sigh_encode_trampoline() { passed = passed + 1 }
    if test_sigh_trampoline_size() { passed = passed + 1 }
    if test_sigh_sigreturn_syscall_bytes() { passed = passed + 1 }

    // Platform mapping (5 tests)
    if test_sigh_to_platform() { passed = passed + 1 }
    if test_sigh_from_platform() { passed = passed + 1 }
    if test_sigh_default_action() { passed = passed + 1 }
    if test_sigh_coredump_signals() { passed = passed + 1 }
    if test_sigh_platform_roundtrip() { passed = passed + 1 }

    // Statistics (5 tests)
    if test_sigh_stats_empty() { passed = passed + 1 }
    if test_sigh_stats_after_handlers() { passed = passed + 1 }
    if test_sigh_stats_after_block() { passed = passed + 1 }
    if test_sigh_handlers_installed() { passed = passed + 1 }
    if test_sigh_signals_blocked() { passed = passed + 1 }

    // Edge cases (5 tests)
    if test_sigh_empty_table() { passed = passed + 1 }
    if test_sigh_kill_not_catchable() { passed = passed + 1 }
    if test_sigh_stop_not_catchable() { passed = passed + 1 }
    if test_sigh_multiple_raise_deliver() { passed = passed + 1 }
    if test_sigh_set_mask() { passed = passed + 1 }

    passed
}
