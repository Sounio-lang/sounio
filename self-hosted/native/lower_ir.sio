// self-hosted::native::lower_ir — IR-to-x86-64 lowering (stack-slot model)

use parser::ast::{BinaryOp, UnaryOp}
use ir::ir::{IrInstr, IrOpcode, IrRegList, IR_MAX_FUNCS}
use native::encode::*
use native::reloc::{RelocationTable, add_call_reloc, add_rip_reloc, patch_u32_le}
use native::elf::{StringTable, string_table_add}
use native::regs::{param_reg}
use native::frame::*
//
// Phase 1: Full instruction lowering.
//
// Evaluation model: every IR virtual register lives in a stack slot at
// rbp - (vreg+1)*8.  Expressions evaluate through rax (and rbx for
// binary RHS).  This avoids register allocation entirely.

// ============================================================================
// Instruction dispatch
// ============================================================================

fn lower_instr(nc: NativeCompiler, instr: IrInstr) -> NativeCompiler with Mut, Panic, Div, Alloc {
    if instr.op == IrOpcode::IrLoadImm {
        lower_load_imm(nc, instr)
    } else if instr.op == IrOpcode::IrLoadBool {
        lower_load_bool(nc, instr)
    } else if instr.op == IrOpcode::IrLoadString {
        lower_load_string(nc, instr)
    } else if instr.op == IrOpcode::IrLoadFloat {
        lower_load_float(nc, instr)
    } else if instr.op == IrOpcode::IrAlloc {
        lower_alloc(nc, instr)
    } else if instr.op == IrOpcode::IrFieldGet {
        lower_field_get(nc, instr)
    } else if instr.op == IrOpcode::IrFieldSet {
        lower_field_set(nc, instr)
    } else if instr.op == IrOpcode::IrIndexGet {
        lower_index_get(nc, instr)
    } else if instr.op == IrOpcode::IrIndexSet {
        lower_index_set(nc, instr)
    } else if instr.op == IrOpcode::IrCopy {
        lower_copy(nc, instr)
    } else if instr.op == IrOpcode::IrBinOp {
        lower_ir_binop(nc, instr)
    } else if instr.op == IrOpcode::IrUnaryOp {
        lower_unaryop(nc, instr)
    } else if instr.op == IrOpcode::IrReturn {
        lower_return(nc, instr)
    } else if instr.op == IrOpcode::IrCall {
        lower_call(nc, instr)
    } else if instr.op == IrOpcode::IrLabel {
        lower_label(nc, instr)
    } else if instr.op == IrOpcode::IrJump {
        lower_jump(nc, instr)
    } else if instr.op == IrOpcode::IrBranchTrue {
        lower_branch_true(nc, instr)
    } else if instr.op == IrOpcode::IrBranchFalse {
        lower_branch_false(nc, instr)
    } else if instr.op == IrOpcode::IrNop {
        nc
    } else if instr.op == IrOpcode::IrVecAddF64 {
        lower_vec_add(nc, instr)
    } else if instr.op == IrOpcode::IrVecMulF64 {
        lower_vec_mul(nc, instr)
    } else if instr.op == IrOpcode::IrVecFmaF64 {
        lower_vec_fma(nc, instr)
    } else {
        // Unsupported opcode — skip silently for bootstrap
        nc
    }
}

// ============================================================================
// Heap allocation
// ============================================================================

fn lower_alloc(nc: NativeCompiler, instr: IrInstr) -> NativeCompiler with Mut, Panic, Div {
    var c = nc

    // Return pointer to start of newly allocated object in dst slot.
    // Heap objects are backed by a monotonic bump allocator starting at r13.
    //
    // imm_i64 carries a type tag from IR lowering:
    //   0 = struct  → 512 bytes (64 slots * 8B, covers hash-based field_idx up to 63)
    //   1 = array   → 512 bytes (same layout as struct for indexed access)
    //   2 = tuple   → 128 bytes (16 slots * 8B, tuples are small)
    //   8 = Box     →  16 bytes (single value, aligned)
    //   other       → treat as byte size, minimum 64, aligned to 8
    let tag = instr.imm_i64
    let alloc_size = if tag == 0 { 512 }
        else if tag == 1 { 512 }
        else if tag == 2 { 128 }
        else if tag == 8 { 16 }
        else if tag < 64 { 64 }
        else { ((tag + 7) / 8) * 8 }
    c.code = emit_mov_rax_r13(c.code)                // rax = current heap pointer
    if instr.dst >= 0 {
        c.code = emit_store_rax_rbp_disp32(c.code, ir_slot_offset(instr.dst))
    }
    c.code = emit_add_r13_imm32(c.code, alloc_size)  // bump pointer
    c
}

// ============================================================================
// Struct fields
// ============================================================================

fn lower_field_get(nc: NativeCompiler, instr: IrInstr) -> NativeCompiler with Mut, Panic, Div {
    var c = nc

    // Compute address: base + field_idx * 8, load value to rax
    c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(instr.src1))   // rax = base
    c.code = emit_mov_reg_imm(c.code, 3, instr.field_idx)                  // rbx = field_idx
    c.code = emit_mov_rax_mem_rax_rbx8(c.code)                             // rax = [rax + rbx*8]

    if instr.dst >= 0 {
        c.code = emit_store_rax_rbp_disp32(c.code, ir_slot_offset(instr.dst))
    }
    c
}

fn lower_field_set(nc: NativeCompiler, instr: IrInstr) -> NativeCompiler with Mut, Panic, Div {
    var c = nc

    // Store source value into [base + field_idx * 8]
    c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(instr.src1))  // rax = base
    c.code = emit_mov_rdx_rax(c.code)                                     // rdx = base

    c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(instr.src2))  // rax = src value
    c.code = emit_mov_reg_imm(c.code, 3, instr.field_idx)                 // rbx = field_idx
    c.code = emit_store_rax_mem_rdx_rbx8(c.code)                           // [rdx + rbx*8] = rax
    c
}

// ============================================================================
// Arrays and indexing
// ============================================================================

fn lower_index_get(nc: NativeCompiler, instr: IrInstr) -> NativeCompiler with Mut, Panic, Div {
    var c = nc

    // Compute address: base + idx*8, load element into rax
    c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(instr.src1))  // rax = base
    c.code = emit_mov_rdx_rax(c.code)                                     // rdx = base
    c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(instr.src2))  // rax = idx
    c.code = emit_mov_rbx_rax(c.code)                                     // rbx = idx
    c.code = emit_load_rax_mem_rdx_rbx8(c.code)                            // rax = [rdx + rbx*8]

    if instr.dst >= 0 {
        c.code = emit_store_rax_rbp_disp32(c.code, ir_slot_offset(instr.dst))
    }
    c
}

fn lower_index_set(nc: NativeCompiler, instr: IrInstr) -> NativeCompiler with Mut, Panic, Div {
    var c = nc

    // Store source value into array element at idx: [base + idx*8] = value
    c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(instr.src1))  // rax = base
    c.code = emit_mov_rdx_rax(c.code)                                     // rdx = base
    c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(instr.src2))  // rax = idx
    c.code = emit_mov_rbx_rax(c.code)                                     // rbx = idx
    c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(instr.imm_i64)) // rax = src
    c.code = emit_store_rax_mem_rdx_rbx8(c.code)                           // [rdx + rbx*8] = rax
    c
}

// ============================================================================
// Load immediate / boolean
// ============================================================================

fn lower_load_imm(nc: NativeCompiler, instr: IrInstr) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_mov_rax_imm(c.code, instr.imm_i64)
    if instr.dst >= 0 {
        c.code = emit_store_rax_rbp_disp32(c.code, ir_slot_offset(instr.dst))
    }
    c
}

fn lower_load_bool(nc: NativeCompiler, instr: IrInstr) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    let val = instr.imm_i64   // 1 for true, 0 for false
    c.code = emit_mov_rax_imm(c.code, val)
    if instr.dst >= 0 {
        c.code = emit_store_rax_rbp_disp32(c.code, ir_slot_offset(instr.dst))
    }
    c
}

fn lower_load_float(nc: NativeCompiler, instr: IrInstr) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // Reinterpret f64 bit pattern as i64 (IEEE 754 preserving).
    let bits = f64_to_bits(instr.imm_f64)
    c.code = emit_mov_rax_imm(c.code, bits)
    if instr.dst >= 0 {
        c.code = emit_store_rax_rbp_disp32(c.code, ir_slot_offset(instr.dst))
    }
    c
}

// ============================================================================
// Load string literal (RIP-relative addressing)
// ============================================================================

fn lower_load_string(nc: NativeCompiler, instr: IrInstr) -> NativeCompiler with Mut, Panic, Div {
    var c = nc

    // Add string to .rodata, get offset
    let (new_rodata, str_offset) = string_table_add(c.rodata, instr.name.buf, instr.name.len)
    c.rodata = new_rodata

    // Emit LEA rax, [rip + disp32] with placeholder
    // The LEA is 7 bytes: 48 8d 05 <disp32>
    let lea_pos = c.code.len
    c.code = emit_lea_rax_rip_disp32(c.code, 0)

    // Record RIP-relative data relocation for post-processing
    // During finalization, we'll patch the disp32 at (lea_pos + 3) to:
    // disp32 = (rodata_va + str_offset) - (text_va + lea_pos + 7)
    //        = (rodata_file_off - text_file_off) + str_offset - lea_pos - 7
    // Where text_file_off = 4096, rodata_file_off = align_page(4096 + code.len)
    c.relocs = add_rip_reloc(c.relocs, lea_pos + 3, str_offset)

    // Store string pointer to dst slot
    if instr.dst >= 0 {
        c.code = emit_store_rax_rbp_disp32(c.code, ir_slot_offset(instr.dst))
    }

    c
}

// ============================================================================
// Copy
// ============================================================================

fn lower_copy(nc: NativeCompiler, instr: IrInstr) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(instr.src1))
    if instr.dst >= 0 {
        c.code = emit_store_rax_rbp_disp32(c.code, ir_slot_offset(instr.dst))
    }
    c
}

// ============================================================================
// Binary operations
// ============================================================================

fn lower_ir_binop(nc: NativeCompiler, instr: IrInstr) -> NativeCompiler with Mut, Panic, Div {
    var c = nc

    // Load LHS to rax, push; load RHS to rax; pop LHS to rbx
    // After: rbx = LHS, rax = RHS
    c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(instr.src1))
    c.code = emit_push_rax(c.code)
    c.code = emit_sub_rsp_8(c.code)      // maintain 16-byte alignment
    c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(instr.src2))
    c.code = emit_add_rsp_8(c.code)
    c.code = emit_pop_rbx(c.code)

    // Now rbx = LHS, rax = RHS
    c = emit_binop_code(c, instr.bin_op)

    // Store result (in rax) to dst slot
    if instr.dst >= 0 {
        c.code = emit_store_rax_rbp_disp32(c.code, ir_slot_offset(instr.dst))
    }
    c
}

fn emit_binop_code(nc: NativeCompiler, op: BinaryOp) -> NativeCompiler with Mut, Panic, Div {
    var c = nc

    if op == BinaryOp::OpAdd {
        // rax = rbx + rax
        c.code = emit_add_reg_reg(c.code, 0, 3)    // add rax, rbx
    } else if op == BinaryOp::OpSub {
        // rax = rbx - rax
        c.code = emit_sub_reg_reg(c.code, 3, 0)    // sub rbx, rax
        c.code = emit_mov_rax_rbx(c.code)           // mov rax, rbx
    } else if op == BinaryOp::OpMul {
        // rax = rbx * rax
        c.code = emit_imul_reg_reg(c.code, 0, 3)   // imul rax, rbx
    } else if op == BinaryOp::OpDiv {
        // rax = rbx / rax (signed)
        c.code = emit_mov_rcx_rax(c.code)           // save divisor in rcx
        c.code = emit_mov_rax_rbx(c.code)           // dividend in rax
        c.code = emit_cqo(c.code)                   // sign-extend to rdx:rax
        c.code = emit_idiv_rcx(c.code)              // rax = quotient
    } else if op == BinaryOp::OpRem {
        // rax = rbx % rax (signed remainder)
        c.code = emit_mov_rcx_rax(c.code)
        c.code = emit_mov_rax_rbx(c.code)
        c.code = emit_cqo(c.code)
        c.code = emit_idiv_rcx(c.code)
        c.code = emit_mov_rax_rdx(c.code)           // remainder is in rdx
    } else if op == BinaryOp::OpEq {
        c.code = emit_cmp_rbx_rax(c.code)
        c.code = emit_sete_al(c.code)
        c.code = emit_movzx_rax_al(c.code)
    } else if op == BinaryOp::OpNe {
        c.code = emit_cmp_rbx_rax(c.code)
        c.code = emit_setne_al(c.code)
        c.code = emit_movzx_rax_al(c.code)
    } else if op == BinaryOp::OpLt {
        c.code = emit_cmp_rbx_rax(c.code)
        c.code = emit_setl_al(c.code)
        c.code = emit_movzx_rax_al(c.code)
    } else if op == BinaryOp::OpLe {
        c.code = emit_cmp_rbx_rax(c.code)
        c.code = emit_setle_al(c.code)
        c.code = emit_movzx_rax_al(c.code)
    } else if op == BinaryOp::OpGt {
        c.code = emit_cmp_rbx_rax(c.code)
        c.code = emit_setg_al(c.code)
        c.code = emit_movzx_rax_al(c.code)
    } else if op == BinaryOp::OpGe {
        c.code = emit_cmp_rbx_rax(c.code)
        c.code = emit_setge_al(c.code)
        c.code = emit_movzx_rax_al(c.code)
    } else if op == BinaryOp::OpAnd {
        c.code = emit_and_bool_rax_rbx(c.code)
    } else if op == BinaryOp::OpOr {
        c.code = emit_or_bool_rax_rbx(c.code)
    } else if op == BinaryOp::OpBitAnd {
        c.code = emit_and_rax_rbx(c.code)
    } else if op == BinaryOp::OpBitOr {
        c.code = emit_or_rax_rbx(c.code)
    } else if op == BinaryOp::OpBitXor {
        c.code = emit_xor_rax_rbx(c.code)
    } else if op == BinaryOp::OpShl {
        c.code = emit_mov_rcx_rax(c.code)
        c.code = emit_mov_rax_rbx(c.code)
        c.code = emit_shl_rax_cl(c.code)
    } else if op == BinaryOp::OpShr {
        c.code = emit_mov_rcx_rax(c.code)
        c.code = emit_mov_rax_rbx(c.code)
        c.code = emit_sar_rax_cl(c.code)
    }

    c
}

// ============================================================================
// Unary operations
// ============================================================================

fn lower_unaryop(nc: NativeCompiler, instr: IrInstr) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(instr.src1))

    if instr.un_op == UnaryOp::OpNeg {
        c.code = emit_neg_rax(c.code)
    } else if instr.un_op == UnaryOp::OpNot {
        c.code = emit_not_bool_rax(c.code)
    } else if instr.un_op == UnaryOp::OpDeref {
        // Dereference: rax = [rax] (load qword at pointer address)
        c.code = emit_load_rax_mem_rax(c.code)
    } else if instr.un_op == UnaryOp::OpRef || instr.un_op == UnaryOp::OpRefMut {
        // Reference: produce pointer to the src1 stack slot
        // rax already holds the value; reload as address using LEA
        let slot_off = ir_slot_offset(instr.src1)
        c.code = emit_lea_rax_rbp_disp32(c.code, slot_off)
    }

    if instr.dst >= 0 {
        c.code = emit_store_rax_rbp_disp32(c.code, ir_slot_offset(instr.dst))
    }
    c
}

// ============================================================================
// Return
// ============================================================================

fn lower_return(nc: NativeCompiler, instr: IrInstr) -> NativeCompiler with Mut, Panic, Div {
    var c = nc

    // Load return value into rax
    if instr.src1 >= 0 {
        c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(instr.src1))
    } else {
        c.code = emit_xor_rax_rax(c.code)
    }

    // Jump to epilogue (will be patched)
    c = record_return_jump(c)

    c
}

// ============================================================================
// Function calls (up to 6 args via System V ABI)
// ============================================================================

// Helper: recursively push all arguments from IrRegList onto the stack
fn push_arg_list(c: NativeCompiler, args: Option<Box<IrRegList>>) -> NativeCompiler with Mut, Panic, Div, Alloc {
    match args {
        Some(list) => {
            // Push head argument
            let vreg = (*list).head
            var c2 = c
            if vreg >= 0 {
                c2.code = emit_load_rbp_disp32_rax(c2.code, ir_slot_offset(vreg))
                c2.code = emit_push_rax(c2.code)
            }
            // Recurse on tail
            push_arg_list(c2, (*list).tail)
        }
        _ => c,
    }
}

fn lower_call(nc: NativeCompiler, instr: IrInstr) -> NativeCompiler with Mut, Panic, Div, Alloc {
    var c = nc
    let argc = instr.arg_count

    // Push all arguments left-to-right onto the stack by walking call_args
    c = push_arg_list(c, instr.call_args)

    // Pop to parameter registers in reverse order (up to 6 args per System V ABI)
    var i = argc - 1
    if i >= 6 { i = 5 }     // clamp to max 6 register params
    while i >= 0 {
        c.code = emit_pop_arg_reg(c.code, i)
        i = i - 1
    }

    // Emit call with placeholder rel32
    let call_pos = c.code.len
    c.code = emit_call_rel32_placeholder(c.code)

    // Record relocation for this call
    if instr.fn_id >= 0 {
        c.relocs = add_call_reloc(c.relocs, call_pos + 1, instr.fn_id)
    }

    // Store return value (rax) to destination slot
    if instr.dst >= 0 {
        c.code = emit_store_rax_rbp_disp32(c.code, ir_slot_offset(instr.dst))
    }

    c
}

// ============================================================================
// Labels and branches
// ============================================================================

fn lower_label(nc: NativeCompiler, instr: IrInstr) -> NativeCompiler with Mut, Panic, Div {
    record_label(nc, instr.label_id)
}

fn lower_jump(nc: NativeCompiler, instr: IrInstr) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    let label_id = instr.label_id

    // Check if label is already defined (backward jump)
    if label_id >= 0 && label_id < 256 {
        let target = c.label_offsets[label_id as usize]
        if target >= 0 {
            // Backward jump: patch immediately
            let jmp_pos = c.code.len
            c.code = emit_jmp_rel32(c.code)
            let next_ip = jmp_pos + 5
            let rel = target - next_ip
            c.code = patch_u32_le(c.code, jmp_pos + 1, rel)
        } else {
            // Forward jump: emit placeholder, record patch
            let jmp_pos = c.code.len
            c.code = emit_jmp_rel32(c.code)
            c = record_label_patch(c, label_id, jmp_pos + 1)
        }
    }
    c
}

fn lower_branch_true(nc: NativeCompiler, instr: IrInstr) -> NativeCompiler with Mut, Panic, Div {
    var c = nc

    // Load condition into rax, test it
    c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(instr.src1))
    c.code = emit_test_rax_rax(c.code)

    let label_id = instr.label_id
    if label_id >= 0 && label_id < 256 {
        let target = c.label_offsets[label_id as usize]
        if target >= 0 {
            // Backward branch
            let jnz_pos = c.code.len
            c.code = emit_jnz_rel32(c.code)
            let next_ip = jnz_pos + 6
            let rel = target - next_ip
            c.code = patch_u32_le(c.code, jnz_pos + 2, rel)
        } else {
            // Forward branch
            let jnz_pos = c.code.len
            c.code = emit_jnz_rel32(c.code)
            c = record_label_patch(c, label_id, jnz_pos + 2)
        }
    }
    c
}

fn lower_branch_false(nc: NativeCompiler, instr: IrInstr) -> NativeCompiler with Mut, Panic, Div {
    var c = nc

    // Load condition into rax, test it
    c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(instr.src1))
    c.code = emit_test_rax_rax(c.code)

    let label_id = instr.label_id
    if label_id >= 0 && label_id < 256 {
        let target = c.label_offsets[label_id as usize]
        if target >= 0 {
            // Backward branch
            let jz_pos = c.code.len
            c.code = emit_jz_rel32(c.code)
            let next_ip = jz_pos + 6
            let rel = target - next_ip
            c.code = patch_u32_le(c.code, jz_pos + 2, rel)
        } else {
            // Forward branch
            let jz_pos = c.code.len
            c.code = emit_jz_rel32(c.code)
            c = record_label_patch(c, label_id, jz_pos + 2)
        }
    }
    c
}

// Simplified lowering: CodeBuffer-only API for test harnesses
fn lower_ir_instr(buf: CodeBuffer, instr: IrInstr) -> CodeBuffer with Mut, Panic, Div, Alloc {
    var c = compiler_new()
    c.code = buf
    c = lower_instr(c, instr)
    c.code
}

// ============================================================================
// EVEX encoding helpers — packed-f64 ZMM register-register form.
//
// Inlined from the avx512 module encoding to keep lower_ir.sio self-contained
// and avoid pushing the transitive module count over the 64-module BFS limit.
// Reference: Intel SDM Vol.2 §2.6, EVEX prefix layout.
//
// Byte layout:
//   P0 = 0x62
//   P1 = R X B R' 0 0 m m   (R/X/B/R' are inverted extension bits; mm = map)
//   P2 = W vvvv4..1 1 pp1pp0 (W=1=f64; vvvv = inverted src1; pp=01=66-prefix)
//   P3 = z L'L b V' aaa      (L'L=10=512-bit; V' = inv(src1[4]); rest=0)
//   opcode byte
//   ModRM = 11 dst_lo3 src2_lo3
// ============================================================================

fn evex_bit(val: i64, n: i64) -> i64 { (val >> n) & 1 }
fn evex_inv(b: i64) -> i64 { if b == 0 { 1 } else { 0 } }
fn evex_lo3(id: i64) -> i64 { id & 7 }

// P1: R=~dst[3], X=1 (no index), B=~src2[3], R'=~dst[4], map
fn evex_p1(dst_id: i64, src2_id: i64, map: i64) -> i64 {
    let r_inv  = evex_inv(evex_bit(dst_id,  3))
    let b_inv  = evex_inv(evex_bit(src2_id, 3))
    let rp_inv = evex_inv(evex_bit(dst_id,  4))
    (r_inv << 7) | (1 << 6) | (b_inv << 5) | (rp_inv << 4) | (map & 0xF)
}

// P2: W=1 (f64), vvvv=bitwise-NOT of src1 low-4, prefix=01 (66h)
fn evex_p2_pd(src1_id: i64) -> i64 {
    let vvvv_inv = (0 - src1_id - 1) & 0xF
    0x80 | (vvvv_inv << 3) | 0x4 | 0x1
}

// P3: L'L=10 (512-bit), V'=~src1[4], zeroing/mask/broadcast all zero
fn evex_p3_zmm(src1_id: i64) -> i64 {
    let vp_inv = evex_inv(evex_bit(src1_id, 4))
    (0b10 << 5) | (vp_inv << 3)
}

// Emit a complete EVEX packed-f64 ZMM reg-reg instruction into a CodeBuffer.
//   map:    1 = 0F  (vaddpd=0x58, vmulpd=0x59)
//           2 = 0F38 (vfmadd231pd=0xB8)
//   opcode: instruction opcode byte
//   dst/src1/src2: ZMM register indices 0-31
fn emit_evex_pd_zmm_rr(buf: CodeBuffer, map: i64, opcode: i64, dst: i64, src1: i64, src2: i64) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x62)
    b = emit_byte(b, evex_p1(dst, src2, map))
    b = emit_byte(b, evex_p2_pd(src1))
    b = emit_byte(b, evex_p3_zmm(src1))
    b = emit_byte(b, opcode)
    b = emit_byte(b, 0xC0 | (evex_lo3(dst) << 3) | evex_lo3(src2))
    b
}

// ============================================================================
// Vector IR lowering — ZMM packed-f64
//
// IrInstr encoding for vector ops:
//   dst  = ZMM destination register index (0-31)
//   src1 = ZMM source-1 register index
//   src2 = ZMM source-2 register index
// ============================================================================

// IrVecAddF64 → EVEX VADDPD zmm_dst, zmm_src1, zmm_src2
fn lower_vec_add(nc: NativeCompiler, instr: IrInstr) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_evex_pd_zmm_rr(c.code, 1, 0x58, instr.dst, instr.src1, instr.src2)
    c
}

// IrVecMulF64 → EVEX VMULPD zmm_dst, zmm_src1, zmm_src2
fn lower_vec_mul(nc: NativeCompiler, instr: IrInstr) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_evex_pd_zmm_rr(c.code, 1, 0x59, instr.dst, instr.src1, instr.src2)
    c
}

// IrVecFmaF64 → EVEX VFMADD231PD zmm_dst, zmm_src1, zmm_src2
//   Semantics: zmm_dst = zmm_src1 * zmm_src2 + zmm_dst  (form 231)
fn lower_vec_fma(nc: NativeCompiler, instr: IrInstr) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_evex_pd_zmm_rr(c.code, 2, 0xB8, instr.dst, instr.src1, instr.src2)
    c
}
