// self-hosted::native::lower_ir — IR-to-x86-64 lowering sketch (skeleton)
//
// This is intentionally incomplete: it documents the intended direction for
// translating self-hosted IR instructions into raw machine code bytes.

fn ir_reg_to_x86(reg: i64) -> i64 {
    // Very small fixed register map for the bootstrap native backend:
    //   IR 0 -> rax
    //   IR 1 -> rbx
    //   IR 2 -> rcx
    //   IR 3 -> rdx
    if reg == 0 { 0 }
    else if reg == 1 { 3 }
    else if reg == 2 { 1 }
    else if reg == 3 { 2 }
    else { -1 }
}

fn lower_ir_instr(buf: CodeBuffer, instr: IrInstr) -> CodeBuffer with Mut, Panic, Div {
    if instr.op == IrOpcode::IrLoadImm {
        let dst = ir_reg_to_x86(instr.dst)
        if dst >= 0 { emit_mov_reg_imm(buf, dst, instr.imm_i64) } else { buf }
    } else if instr.op == IrOpcode::IrBinOp {
        // Bootstrap lowering: two-register ops in a tiny fixed map.
        // For now we only support integer ops (+,-,*).
        let dst = ir_reg_to_x86(instr.dst)
        let lhs = ir_reg_to_x86(instr.src1)
        let rhs = ir_reg_to_x86(instr.src2)
        if dst < 0 || lhs < 0 || rhs < 0 {
            return buf
        }

        var b = buf
        if dst != lhs {
            b = emit_mov_reg_reg(b, dst, lhs)
        }

        if instr.bin_op == BinaryOp::OpAdd {
            emit_add_reg_reg(b, dst, rhs)
        } else if instr.bin_op == BinaryOp::OpSub {
            emit_sub_reg_reg(b, dst, rhs)
        } else if instr.bin_op == BinaryOp::OpMul {
            emit_imul_reg_reg(b, dst, rhs)
        } else {
            b
        }
    } else if instr.op == IrOpcode::IrReturn {
        // Ensure the return value is in rax.
        let src = ir_reg_to_x86(instr.src1)
        var b = buf
        if src >= 0 && src != 0 {
            b = emit_mov_reg_reg(b, 0, src)
        }
        emit_ret(b)
    } else {
        // TODO: IrCall, branches, loads/stores, alloc, etc.
        buf
    }
}
