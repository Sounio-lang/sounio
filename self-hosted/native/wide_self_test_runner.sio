// Runner for wide.sio self-tests.

use native::wide::*
use native::encode::*
use native::elf::*
use native::reloc::*

fn main() -> i32 with IO, Mut, Panic, Div {
    println("Running wide.sio self-tests...")
    let failures = run_wide_self_tests()
    if failures == 0 {
        println("ALL PASS")
    } else {
        println("FAILURES DETECTED")
    }
    failures as i32
}
