// native::wide — Wide buffer types for large module native compilation.
//
// These types provide 256KB code buffers (vs 64KB standard) and 1024-entry
// relocation tables (vs 256) for compiling modules with 400+ functions.
//
// The standard path (CodeBuffer, Elf64Binary, RelocationTable) remains for
// small programs. Use the wide path when total code size exceeds 64KB.

module native::wide

use native::encode::*
use native::elf::*
use native::reloc::*

// ============================================================================
// WIDE CODE BUFFER (256KB)
// ============================================================================

struct WideCodeBuffer {
    bytes: [i8; 262144],
    len: i64,
}

fn wide_code_buffer_new() -> WideCodeBuffer with Mut {
    WideCodeBuffer { bytes: [0; 262144], len: 0 }
}

fn wide_emit_byte(buf: WideCodeBuffer, b: i64) -> WideCodeBuffer with Mut, Panic {
    var out = buf
    if out.len < 262144 {
        out.bytes[out.len as usize] = b as i8
        out.len = out.len + 1
    }
    out
}

fn wide_copy_from_code_buffer(dst: WideCodeBuffer, src: CodeBuffer) -> WideCodeBuffer with Mut, Panic, Div {
    var out = dst
    var i: i64 = 0
    while i < src.len && out.len < 262144 {
        out.bytes[out.len as usize] = src.bytes[i as usize]
        out.len = out.len + 1
        i = i + 1
    }
    out
}

// ============================================================================
// WIDE ELF BINARY (256KB)
// ============================================================================

struct WideElf64Binary {
    bytes: [i8; 262144],
    len: i64,
}

fn wide_elf64_new() -> WideElf64Binary with Mut {
    WideElf64Binary { bytes: [0; 262144], len: 0 }
}

fn wide_elf_write_byte(bin: WideElf64Binary, b: i64) -> WideElf64Binary with Mut, Panic {
    var out = bin
    if out.len < 262144 {
        out.bytes[out.len as usize] = b as i8
        out.len = out.len + 1
    }
    out
}

fn wide_elf_write_u16(bin: WideElf64Binary, v: i64) -> WideElf64Binary with Mut, Panic, Div {
    var out = bin
    out = wide_elf_write_byte(out, v & 255)
    out = wide_elf_write_byte(out, (v / 256) & 255)
    out
}

fn wide_elf_write_u32(bin: WideElf64Binary, v: i64) -> WideElf64Binary with Mut, Panic, Div {
    var out = bin
    out = wide_elf_write_byte(out, v & 255)
    out = wide_elf_write_byte(out, (v / 256) & 255)
    out = wide_elf_write_byte(out, (v / 65536) & 255)
    out = wide_elf_write_byte(out, (v / 16777216) & 255)
    out
}

fn wide_elf_write_u64(bin: WideElf64Binary, v: i64) -> WideElf64Binary with Mut, Panic, Div {
    var out = bin
    out = wide_elf_write_u32(out, v & 4294967295)
    out = wide_elf_write_u32(out, v / 4294967296)
    out
}

fn wide_elf_pad_to(bin: WideElf64Binary, target: i64) -> WideElf64Binary with Mut, Panic {
    var out = bin
    while out.len < target && out.len < 262144 {
        out.bytes[out.len as usize] = 0 as i8
        out.len = out.len + 1
    }
    out
}

fn wide_elf_copy_code(bin: WideElf64Binary, src: CodeBuffer) -> WideElf64Binary with Mut, Panic {
    var out = bin
    var i: i64 = 0
    while i < src.len && out.len < 262144 {
        out.bytes[out.len as usize] = src.bytes[i as usize]
        out.len = out.len + 1
        i = i + 1
    }
    out
}

fn wide_elf_copy_strtab(bin: WideElf64Binary, st: StringTable) -> WideElf64Binary with Mut, Panic {
    var out = bin
    var i: i64 = 0
    while i < st.len && out.len < 262144 {
        out.bytes[out.len as usize] = st.bytes[i as usize]
        out.len = out.len + 1
        i = i + 1
    }
    out
}

fn io_write_wide_elf(path: string, elf: WideElf64Binary) -> bool with IO {
    let result = write_file(path, elf.bytes, elf.len)
    result == 0
}

// ============================================================================
// WIDE RELOCATION TABLE (1024 entries)
// ============================================================================

struct WideRelocationTable {
    entries: [Relocation; 1024],
    count: i64,
}

fn wide_relocation_table_new() -> WideRelocationTable with Mut {
    WideRelocationTable {
        entries: [empty_reloc; 1024],
        count: 0,
    }
}

fn wide_add_relocation(table: WideRelocationTable, offset: i64, target: i64, kind: i64) -> WideRelocationTable with Mut, Panic {
    var out = table
    if out.count < 1024 {
        out.entries[out.count as usize] = Relocation { offset: offset, target: target, kind_code: kind }
        out.count = out.count + 1
    }
    out
}

// ============================================================================
// WIDE SYMBOL DATA (1024 functions, 8KB strtab)
// ============================================================================

struct WideSymbolData {
    strtab: [i8; 8192],
    strtab_len: i64,
    name_offsets: [i64; 1024],
    fn_offsets: [i64; 1024],
    count: i64,
}

fn wide_symbol_data_new() -> WideSymbolData with Mut {
    WideSymbolData {
        strtab: [0; 8192],
        strtab_len: 1,
        name_offsets: [0; 1024],
        fn_offsets: [0; 1024],
        count: 0,
    }
}

fn wide_add_symbol(s: WideSymbolData, name: string, offset: i64) -> WideSymbolData with Mut, Panic {
    var out = s
    if out.count < 1024 {
        out.name_offsets[out.count as usize] = out.strtab_len
        out.fn_offsets[out.count as usize] = offset
        var i: i64 = 0
        let n = str_len(name)
        while i < n && out.strtab_len < 8192 {
            out.strtab[out.strtab_len as usize] = str_char_at(name, i) as i8
            out.strtab_len = out.strtab_len + 1
            i = i + 1
        }
        if out.strtab_len < 8192 {
            out.strtab[out.strtab_len as usize] = 0 as i8
            out.strtab_len = out.strtab_len + 1
        }
        out.count = out.count + 1
    }
    out
}
