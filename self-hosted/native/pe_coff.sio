        number_of_linenumbers: 0,
        characteristics: PE_SCN_CNT_INITIALIZED_DATA + PE_SCN_MEM_READ,
    }
    pe_add_section(w, sec)
}

fn pe_add_rsrc_section(w: PeWriter, vaddr: i64, vsize: i64, raw_offset: i64, raw_size: i64) -> PeWriter with Mut, Panic, Div {
    let sec = PeSectionHeader {
        name_id: PE_SECT_RSRC,
        virtual_size: vsize,
        virtual_address: vaddr,
        size_of_raw_data: raw_size,
        pointer_to_raw_data: raw_offset,
        pointer_to_relocations: 0,
        pointer_to_linenumbers: 0,
        number_of_relocations: 0,
        number_of_linenumbers: 0,
        characteristics: PE_SCN_CNT_INITIALIZED_DATA + PE_SCN_MEM_READ,
    }
    pe_add_section(w, sec)
}

fn pe_add_reloc_section(w: PeWriter, vaddr: i64, vsize: i64, raw_offset: i64, raw_size: i64) -> PeWriter with Mut, Panic, Div {
    let sec = PeSectionHeader {
        name_id: PE_SECT_RELOC,
        virtual_size: vsize,
        virtual_address: vaddr,
        size_of_raw_data: raw_size,
        pointer_to_raw_data: raw_offset,
        pointer_to_relocations: 0,
        pointer_to_linenumbers: 0,
        number_of_relocations: 0,
        number_of_linenumbers: 0,
        characteristics: PE_SCN_CNT_INITIALIZED_DATA + PE_SCN_MEM_DISCARDABLE + PE_SCN_MEM_READ,
    }
    pe_add_section(w, sec)
}

// Get the section characteristics for a section by name_id
fn pe_section_chars_for(name_id: i64) -> i64 {
    if name_id == PE_SECT_TEXT {
        PE_SCN_CNT_CODE + PE_SCN_MEM_EXECUTE + PE_SCN_MEM_READ
    } else if name_id == PE_SECT_DATA {
        PE_SCN_CNT_INITIALIZED_DATA + PE_SCN_MEM_READ + PE_SCN_MEM_WRITE
    } else if name_id == PE_SECT_RDATA {
        PE_SCN_CNT_INITIALIZED_DATA + PE_SCN_MEM_READ
    } else if name_id == PE_SECT_BSS {
        PE_SCN_CNT_UNINITIALIZED_DATA + PE_SCN_MEM_READ + PE_SCN_MEM_WRITE
    } else if name_id == PE_SECT_IDATA {
        PE_SCN_CNT_INITIALIZED_DATA + PE_SCN_MEM_READ
    } else if name_id == PE_SECT_EDATA {
        PE_SCN_CNT_INITIALIZED_DATA + PE_SCN_MEM_READ
    } else if name_id == PE_SECT_RSRC {
        PE_SCN_CNT_INITIALIZED_DATA + PE_SCN_MEM_READ
    } else if name_id == PE_SECT_RELOC {
        PE_SCN_CNT_INITIALIZED_DATA + PE_SCN_MEM_DISCARDABLE + PE_SCN_MEM_READ
    } else {
        PE_SCN_CNT_INITIALIZED_DATA + PE_SCN_MEM_READ
    }
}

// ============================================================================
// Section name emission (8-byte fixed fields)
// ============================================================================

// Emit the 8-byte section name field from encoded section name ID
fn pe_emit_section_name(w: PeWriter, name_id: i64) -> PeWriter with Mut, Panic, Div {
    var out = w
    if name_id == PE_SECT_TEXT {
        // ".text\0\0\0"
        out = pe_emit_byte(out, 46)   // '.'
        out = pe_emit_byte(out, 116)  // 't'
        out = pe_emit_byte(out, 101)  // 'e'
        out = pe_emit_byte(out, 120)  // 'x'
        out = pe_emit_byte(out, 116)  // 't'
        out = pe_emit_zeros(out, 3)
    } else if name_id == PE_SECT_DATA {
        // ".data\0\0\0"
        out = pe_emit_byte(out, 46)   // '.'
        out = pe_emit_byte(out, 100)  // 'd'
        out = pe_emit_byte(out, 97)   // 'a'
        out = pe_emit_byte(out, 116)  // 't'
        out = pe_emit_byte(out, 97)   // 'a'
        out = pe_emit_zeros(out, 3)
    } else if name_id == PE_SECT_RDATA {
        // ".rdata\0\0"
        out = pe_emit_byte(out, 46)   // '.'
        out = pe_emit_byte(out, 114)  // 'r'
        out = pe_emit_byte(out, 100)  // 'd'
        out = pe_emit_byte(out, 97)   // 'a'
        out = pe_emit_byte(out, 116)  // 't'
        out = pe_emit_byte(out, 97)   // 'a'
        out = pe_emit_zeros(out, 2)
    } else if name_id == PE_SECT_BSS {
        // ".bss\0\0\0\0"
        out = pe_emit_byte(out, 46)   // '.'
        out = pe_emit_byte(out, 98)   // 'b'
        out = pe_emit_byte(out, 115)  // 's'
        out = pe_emit_byte(out, 115)  // 's'
        out = pe_emit_zeros(out, 4)
    } else if name_id == PE_SECT_IDATA {
        // ".idata\0\0"
        out = pe_emit_byte(out, 46)   // '.'
        out = pe_emit_byte(out, 105)  // 'i'
        out = pe_emit_byte(out, 100)  // 'd'
        out = pe_emit_byte(out, 97)   // 'a'
        out = pe_emit_byte(out, 116)  // 't'
        out = pe_emit_byte(out, 97)   // 'a'
        out = pe_emit_zeros(out, 2)
    } else if name_id == PE_SECT_EDATA {
        // ".edata\0\0"
        out = pe_emit_byte(out, 46)   // '.'
        out = pe_emit_byte(out, 101)  // 'e'
        out = pe_emit_byte(out, 100)  // 'd'
        out = pe_emit_byte(out, 97)   // 'a'
        out = pe_emit_byte(out, 116)  // 't'
        out = pe_emit_byte(out, 97)   // 'a'
        out = pe_emit_zeros(out, 2)
    } else if name_id == PE_SECT_RSRC {
        // ".rsrc\0\0\0"
        out = pe_emit_byte(out, 46)   // '.'
        out = pe_emit_byte(out, 114)  // 'r'
        out = pe_emit_byte(out, 115)  // 's'
        out = pe_emit_byte(out, 114)  // 'r'
        out = pe_emit_byte(out, 99)   // 'c'
        out = pe_emit_zeros(out, 3)
    } else if name_id == PE_SECT_RELOC {
        // ".reloc\0\0"
        out = pe_emit_byte(out, 46)   // '.'
        out = pe_emit_byte(out, 114)  // 'r'
        out = pe_emit_byte(out, 101)  // 'e'
        out = pe_emit_byte(out, 108)  // 'l'
        out = pe_emit_byte(out, 111)  // 'o'
        out = pe_emit_byte(out, 99)   // 'c'
        out = pe_emit_zeros(out, 2)
    } else if name_id == PE_SECT_PDATA {
        // ".pdata\0\0"
        out = pe_emit_byte(out, 46)   // '.'
        out = pe_emit_byte(out, 112)  // 'p'
        out = pe_emit_byte(out, 100)  // 'd'
        out = pe_emit_byte(out, 97)   // 'a'
        out = pe_emit_byte(out, 116)  // 't'
        out = pe_emit_byte(out, 97)   // 'a'
        out = pe_emit_zeros(out, 2)
    } else if name_id == PE_SECT_DEBUG {
        // ".debug\0\0"
        out = pe_emit_byte(out, 46)   // '.'
        out = pe_emit_byte(out, 100)  // 'd'
        out = pe_emit_byte(out, 101)  // 'e'
        out = pe_emit_byte(out, 98)   // 'b'
        out = pe_emit_byte(out, 117)  // 'u'
        out = pe_emit_byte(out, 103)  // 'g'
        out = pe_emit_zeros(out, 2)
    } else {
        out = pe_emit_zeros(out, 8)
    }
    out
}

// ============================================================================
// Header emission — DOS stub
// ============================================================================

// Write the 64-byte DOS header
fn pe_write_dos_stub(w: PeWriter, hdr: PeDosHeader) -> PeWriter with Mut, Panic, Div {
    var out = w
    out = pe_emit_u16(out, hdr.e_magic)
    out = pe_emit_u16(out, hdr.e_cblp)
    out = pe_emit_u16(out, hdr.e_cp)
    out = pe_emit_u16(out, hdr.e_crlc)
    out = pe_emit_u16(out, hdr.e_cparhdr)
    out = pe_emit_u16(out, hdr.e_minalloc)
    out = pe_emit_u16(out, hdr.e_maxalloc)
    out = pe_emit_u16(out, hdr.e_ss)
    out = pe_emit_u16(out, hdr.e_sp)
    out = pe_emit_u16(out, hdr.e_csum)
    out = pe_emit_u16(out, hdr.e_ip)
    out = pe_emit_u16(out, hdr.e_cs)
    out = pe_emit_u16(out, hdr.e_lfarlc)
    out = pe_emit_u16(out, hdr.e_ovno)
    // Reserved words (4 x u16 = 8 bytes)
    out = pe_emit_zeros(out, 8)
    // OEM id and info (2 x u16 = 4 bytes)
    out = pe_emit_zeros(out, 4)
    // Reserved words 2 (10 x u16 = 20 bytes)
    out = pe_emit_zeros(out, 20)
    // e_lfanew at offset 60
    out = pe_emit_u32(out, hdr.e_lfanew)
    out
}

// Write the DOS stub program (a small real-mode program that prints
// "This program cannot be run in DOS mode." and exits).
// In practice we emit a minimal stub: just the header.
fn pe_write_dos_program(w: PeWriter) -> PeWriter with Mut, Panic, Div {
    var out = w
    // Stub message bytes (simplified): 14 bytes of x86-16 instructions
    // push cs / pop ds / mov dx, offset msg / mov ah, 9 / int 21h / mov ax, 4C01h / int 21h
    out = pe_emit_byte(out, 0x0E)    // push cs
    out = pe_emit_byte(out, 0x1F)    // pop ds
    out = pe_emit_byte(out, 0xBA)    // mov dx, offset
    out = pe_emit_u16(out, 14)       // offset to message
    out = pe_emit_byte(out, 0xB4)    // mov ah, 9
    out = pe_emit_byte(out, 0x09)
    out = pe_emit_byte(out, 0xCD)    // int 21h
    out = pe_emit_byte(out, 0x21)
    out = pe_emit_byte(out, 0xB8)    // mov ax, 4C01h
    out = pe_emit_u16(out, 0x4C01)
    out = pe_emit_byte(out, 0xCD)    // int 21h
    out = pe_emit_byte(out, 0x21)
    // Message: "This program cannot be run in DOS mode.\r\n$"
    // 'T'=84 'h'=104 'i'=105 's'=115 ' '=32 'p'=112 'r'=114 'o'=111
    // 'g'=103 'r'=114 'a'=97 'm'=109 ...
    out = pe_emit_byte(out, 84)   // T
    out = pe_emit_byte(out, 104)  // h
    out = pe_emit_byte(out, 105)  // i
    out = pe_emit_byte(out, 115)  // s
    out = pe_emit_byte(out, 32)   // (space)
    out = pe_emit_byte(out, 112)  // p
    out = pe_emit_byte(out, 114)  // r
    out = pe_emit_byte(out, 111)  // o
    out = pe_emit_byte(out, 103)  // g
    out = pe_emit_byte(out, 114)  // r
    out = pe_emit_byte(out, 97)   // a
    out = pe_emit_byte(out, 109)  // m
    out = pe_emit_byte(out, 32)   // (space)
    out = pe_emit_byte(out, 99)   // c
    out = pe_emit_byte(out, 97)   // a
    out = pe_emit_byte(out, 110)  // n
    out = pe_emit_byte(out, 110)  // n
    out = pe_emit_byte(out, 111)  // o
    out = pe_emit_byte(out, 116)  // t
    out = pe_emit_byte(out, 32)   // (space)
    out = pe_emit_byte(out, 98)   // b
    out = pe_emit_byte(out, 101)  // e
    out = pe_emit_byte(out, 32)   // (space)
    out = pe_emit_byte(out, 114)  // r
    out = pe_emit_byte(out, 117)  // u
    out = pe_emit_byte(out, 110)  // n
    out = pe_emit_byte(out, 32)   // (space)
    out = pe_emit_byte(out, 105)  // i
    out = pe_emit_byte(out, 110)  // n
    out = pe_emit_byte(out, 32)   // (space)
    out = pe_emit_byte(out, 68)   // D
    out = pe_emit_byte(out, 79)   // O
    out = pe_emit_byte(out, 83)   // S
    out = pe_emit_byte(out, 32)   // (space)
    out = pe_emit_byte(out, 109)  // m
    out = pe_emit_byte(out, 111)  // o
    out = pe_emit_byte(out, 100)  // d
    out = pe_emit_byte(out, 101)  // e
    out = pe_emit_byte(out, 46)   // .
    out = pe_emit_byte(out, 13)   // \r
    out = pe_emit_byte(out, 10)   // \n
    out = pe_emit_byte(out, 36)   // $
    out
}

// ============================================================================
// Header emission — COFF header
// ============================================================================

fn pe_write_coff_header(w: PeWriter, hdr: PeCoffHeader) -> PeWriter with Mut, Panic, Div {
    var out = w
    // PE signature
    out = pe_emit_u32(out, PE_SIGNATURE)
    // COFF header fields
    out = pe_emit_u16(out, hdr.machine)
    out = pe_emit_u16(out, hdr.number_of_sections)
    out = pe_emit_u32(out, hdr.time_date_stamp)
    out = pe_emit_u32(out, hdr.pointer_to_symbol_table)
    out = pe_emit_u32(out, hdr.number_of_symbols)
    out = pe_emit_u16(out, hdr.size_of_optional_header)
    out = pe_emit_u16(out, hdr.characteristics)
    out
}

// ============================================================================
// Header emission — PE32+ optional header
// ============================================================================

fn pe_write_optional_header(w: PeWriter, opt: PeOptionalHeader, data_dirs: [PeDataDirectory; 16]) -> PeWriter with Mut, Panic, Div {
    var out = w
    // Standard fields (28 bytes for PE32+)
    out = pe_emit_u16(out, opt.magic)
    out = pe_emit_byte(out, opt.major_linker_version)
    out = pe_emit_byte(out, opt.minor_linker_version)
    out = pe_emit_u32(out, opt.size_of_code)
    out = pe_emit_u32(out, opt.size_of_initialized_data)
    out = pe_emit_u32(out, opt.size_of_uninitialized_data)
    out = pe_emit_u32(out, opt.address_of_entry_point)
    out = pe_emit_u32(out, opt.base_of_code)
    // Windows-specific fields (88 bytes for PE32+)
    out = pe_emit_u64(out, opt.image_base)
    out = pe_emit_u32(out, opt.section_alignment)
    out = pe_emit_u32(out, opt.file_alignment)
    out = pe_emit_u16(out, opt.major_os_version)
    out = pe_emit_u16(out, opt.minor_os_version)
    out = pe_emit_u16(out, opt.major_image_version)
    out = pe_emit_u16(out, opt.minor_image_version)
    out = pe_emit_u16(out, opt.major_subsystem_version)
    out = pe_emit_u16(out, opt.minor_subsystem_version)
    out = pe_emit_u32(out, opt.win32_version_value)
    out = pe_emit_u32(out, opt.size_of_image)
    out = pe_emit_u32(out, opt.size_of_headers)
    out = pe_emit_u32(out, opt.checksum)
    out = pe_emit_u16(out, opt.subsystem)
    out = pe_emit_u16(out, opt.dll_characteristics)
    out = pe_emit_u64(out, opt.size_of_stack_reserve)
    out = pe_emit_u64(out, opt.size_of_stack_commit)
    out = pe_emit_u64(out, opt.size_of_heap_reserve)
    out = pe_emit_u64(out, opt.size_of_heap_commit)
    out = pe_emit_u32(out, opt.loader_flags)
    out = pe_emit_u32(out, opt.number_of_rva_and_sizes)
    // Data directories (16 entries x 8 bytes = 128 bytes)
    var i = 0
    while i < PE_NUM_DATA_DIRS {
        out = pe_emit_u32(out, data_dirs[i as usize].virtual_address)
        out = pe_emit_u32(out, data_dirs[i as usize].size)
        i = i + 1
    }
    out
}

// ============================================================================
// Section header emission
// ============================================================================

fn pe_write_section_header(w: PeWriter, sec: PeSectionHeader) -> PeWriter with Mut, Panic, Div {
    var out = w
    // Name (8 bytes)
    out = pe_emit_section_name(out, sec.name_id)
    // VirtualSize
    out = pe_emit_u32(out, sec.virtual_size)
    // VirtualAddress
    out = pe_emit_u32(out, sec.virtual_address)
    // SizeOfRawData
    out = pe_emit_u32(out, sec.size_of_raw_data)
    // PointerToRawData
    out = pe_emit_u32(out, sec.pointer_to_raw_data)
    // PointerToRelocations
    out = pe_emit_u32(out, sec.pointer_to_relocations)
    // PointerToLinenumbers
    out = pe_emit_u32(out, sec.pointer_to_linenumbers)
    // NumberOfRelocations
    out = pe_emit_u16(out, sec.number_of_relocations)
    // NumberOfLinenumbers
    out = pe_emit_u16(out, sec.number_of_linenumbers)
    // Characteristics
    out = pe_emit_u32(out, sec.characteristics)
    out
}

fn pe_write_section_headers(w: PeWriter) -> PeWriter with Mut, Panic, Div {
    var out = w
    var i = 0
    while i < out.section_count {
        out = pe_write_section_header(out, out.sections[i as usize])
        i = i + 1
    }
    out
}

// ============================================================================
// Symbol management
// ============================================================================

fn pe_add_symbol(w: PeWriter, sym: PeSymbol) -> PeWriter with Mut, Panic, Div {
    var out = w
    if out.symbol_count < 2048 {
        out.symbols[out.symbol_count as usize] = sym
        out.symbol_count = out.symbol_count + 1
    }
    out
}

fn pe_make_external_symbol(name_offset: i64, section: i64, value: i64) -> PeSymbol {
    PeSymbol {
        name_offset: name_offset,
        name_short: 0,
        value: value,
        section_number: section,
        sym_type: PE_SYM_TYPE_FUNCTION,
        storage_class: PE_SYM_CLASS_EXTERNAL,
        number_of_aux_symbols: 0,
    }
}

fn pe_make_static_symbol(name_offset: i64, section: i64, value: i64) -> PeSymbol {
    PeSymbol {
        name_offset: name_offset,
        name_short: 0,
        value: value,
        section_number: section,
        sym_type: PE_SYM_TYPE_NULL,
        storage_class: PE_SYM_CLASS_STATIC,
        number_of_aux_symbols: 0,
    }
}

fn pe_make_section_symbol(section: i64) -> PeSymbol {
    PeSymbol {
        name_offset: 0,
        name_short: 0,
        value: 0,
        section_number: section,
        sym_type: PE_SYM_TYPE_NULL,
        storage_class: PE_SYM_CLASS_SECTION,
        number_of_aux_symbols: 0,
    }
}

fn pe_make_undef_symbol(name_offset: i64) -> PeSymbol {
    PeSymbol {
        name_offset: name_offset,
        name_short: 0,
        value: 0,
        section_number: 0,
        sym_type: PE_SYM_TYPE_NULL,
        storage_class: PE_SYM_CLASS_EXTERNAL,
        number_of_aux_symbols: 0,
    }
}

// Write a COFF symbol entry (18 bytes)
fn pe_emit_symbol(w: PeWriter, sym: PeSymbol) -> PeWriter with Mut, Panic, Div {
    var out = w
    if sym.name_short != 0 {
        // Short name: stored inline (8 bytes)
        out = pe_emit_u64(out, sym.name_short)
    } else {
        // Long name: first 4 bytes = 0, next 4 bytes = string table offset
        out = pe_emit_u32(out, 0)
        out = pe_emit_u32(out, sym.name_offset)
    }
    // Value
    out = pe_emit_u32(out, sym.value)
    // SectionNumber (1-based, i16)
    out = pe_emit_u16(out, sym.section_number)
    // Type
    out = pe_emit_u16(out, sym.sym_type)
    // StorageClass
    out = pe_emit_byte(out, sym.storage_class)
    // NumberOfAuxSymbols
    out = pe_emit_byte(out, sym.number_of_aux_symbols)
    out
}

// ============================================================================
// Relocation management
// ============================================================================

fn pe_add_relocation(w: PeWriter, rel: PeRelocation) -> PeWriter with Mut, Panic, Div {
    var out = w
    if out.reloc_count < 4096 {
        out.relocs[out.reloc_count as usize] = rel
        out.reloc_count = out.reloc_count + 1
    }
    out
}

fn pe_make_rel32_reloc(vaddr: i64, sym_idx: i64) -> PeRelocation {
    PeRelocation {
        virtual_address: vaddr,
        symbol_table_index: sym_idx,
        rel_type: PE_REL_AMD64_REL32,
    }
}

fn pe_make_addr64_reloc(vaddr: i64, sym_idx: i64) -> PeRelocation {
    PeRelocation {
        virtual_address: vaddr,
        symbol_table_index: sym_idx,
        rel_type: PE_REL_AMD64_ADDR64,
    }
}

fn pe_make_addr32nb_reloc(vaddr: i64, sym_idx: i64) -> PeRelocation {
    PeRelocation {
        virtual_address: vaddr,
        symbol_table_index: sym_idx,
        rel_type: PE_REL_AMD64_ADDR32NB,
    }
}

fn pe_make_secrel_reloc(vaddr: i64, sym_idx: i64) -> PeRelocation {
    PeRelocation {
        virtual_address: vaddr,
        symbol_table_index: sym_idx,
        rel_type: PE_REL_AMD64_SECREL,
    }
}

fn pe_make_section_reloc(vaddr: i64, sym_idx: i64) -> PeRelocation {
    PeRelocation {
        virtual_address: vaddr,
        symbol_table_index: sym_idx,
        rel_type: PE_REL_AMD64_SECTION,
    }
}

fn pe_make_arm64_branch26_reloc(vaddr: i64, sym_idx: i64) -> PeRelocation {
    PeRelocation {
        virtual_address: vaddr,
        symbol_table_index: sym_idx,
        rel_type: PE_REL_ARM64_BRANCH26,
    }
}

fn pe_make_arm64_pagebase_reloc(vaddr: i64, sym_idx: i64) -> PeRelocation {
    PeRelocation {
        virtual_address: vaddr,
        symbol_table_index: sym_idx,
        rel_type: PE_REL_ARM64_PAGEBASE_REL21,
    }
}

fn pe_make_arm64_pageoff12a_reloc(vaddr: i64, sym_idx: i64) -> PeRelocation {
    PeRelocation {
        virtual_address: vaddr,
        symbol_table_index: sym_idx,
        rel_type: PE_REL_ARM64_PAGEOFFSET_12A,
    }
}

// Write a COFF relocation entry (10 bytes)
fn pe_emit_relocation(w: PeWriter, rel: PeRelocation) -> PeWriter with Mut, Panic, Div {
    var out = w
    out = pe_emit_u32(out, rel.virtual_address)
    out = pe_emit_u32(out, rel.symbol_table_index)
    out = pe_emit_u16(out, rel.rel_type)
    out
}

// Apply a relocation: compute and patch the target value
fn pe_apply_relocation(
    w: PeWriter,
    rel: PeRelocation,
    sym_value: i64,
    section_rva: i64
) -> PeWriter with Mut, Panic, Div {
    var out = w
    let patch_offset = rel.virtual_address
    if rel.rel_type == PE_REL_AMD64_REL32 {
        // rel32 = target - (patch_addr + 4)
        let target = sym_value
        let patch_addr = section_rva + patch_offset
        let rel32 = target - (patch_addr + 4)
        out = pe_patch_u32(out, patch_offset, rel32)
    } else if rel.rel_type == PE_REL_AMD64_ADDR64 {
        out = pe_patch_u64(out, patch_offset, sym_value)
    } else if rel.rel_type == PE_REL_AMD64_ADDR32 {
        out = pe_patch_u32(out, patch_offset, sym_value)
    } else if rel.rel_type == PE_REL_AMD64_ADDR32NB {
        // RVA (no base)
        out = pe_patch_u32(out, patch_offset, sym_value)
    } else if rel.rel_type == PE_REL_AMD64_SECREL {
        // Section-relative offset
        out = pe_patch_u32(out, patch_offset, sym_value)
    } else if rel.rel_type == PE_REL_AMD64_SECTION {
        // Section index
        out = pe_patch_u16(out, patch_offset, sym_value)
    }
    out
}

// Process all relocations using symbol values and section RVAs
fn pe_process_relocations(
    w: PeWriter,
    sym_values: [i64; 2048],
    section_rvas: [i64; 16]
) -> PeWriter with Mut, Panic, Div {
    var out = w
    var i = 0
    while i < out.reloc_count {
        let rel = out.relocs[i as usize]
        let sym_idx = rel.symbol_table_index
        var sym_val = 0
        if sym_idx >= 0 && sym_idx < 2048 {
            sym_val = sym_values[sym_idx as usize]
        }
        // Determine section RVA (use section 0 by default for simplicity)
        let sec_rva = section_rvas[0]
        out = pe_apply_relocation(out, rel, sym_val, sec_rva)
        i = i + 1
    }
    out
}

// ============================================================================
// Base relocation table (.reloc section)
// ============================================================================

fn pe_add_base_reloc(w: PeWriter, entry_type: i64, offset: i64) -> PeWriter with Mut, Panic, Div {
    var out = w
    if out.base_reloc_count < 4096 {
        out.base_relocs[out.base_reloc_count as usize] = PeBaseRelocEntry {
            entry_type: entry_type,
            offset: offset,
        }
        out.base_reloc_count = out.base_reloc_count + 1
    }
    out
}

fn pe_add_base_reloc_dir64(w: PeWriter, rva: i64) -> PeWriter with Mut, Panic, Div {
    let page_rva = (rva / PE_PAGE_SIZE) * PE_PAGE_SIZE
    let offset = rva - page_rva
    pe_add_base_reloc(w, PE_BASE_RELOC_DIR64, offset)
}

fn pe_add_base_reloc_highlow(w: PeWriter, rva: i64) -> PeWriter with Mut, Panic, Div {
    let page_rva = (rva / PE_PAGE_SIZE) * PE_PAGE_SIZE
    let offset = rva - page_rva
    pe_add_base_reloc(w, PE_BASE_RELOC_HIGHLOW, offset)
}

// Encode a base relocation entry as a u16: type in top 4 bits, offset in bottom 12 bits
fn pe_encode_base_reloc_entry(entry: PeBaseRelocEntry) -> i64 {
    let type_bits = (entry.entry_type & 15) * 4096
    let offset_bits = entry.offset & 4095
    type_bits + offset_bits
}

// Build the .reloc section data
// Groups entries by page RVA and emits block headers + entries
fn pe_build_reloc_table(w: PeWriter, page_rva: i64) -> PeWriter with Mut, Panic, Div {
    var out = w
    if out.base_reloc_count == 0 {
        return out
    }
    // Emit block header: page RVA (u32) + block size (u32)
    let entry_count = out.base_reloc_count
    // Each entry is 2 bytes, header is 8 bytes
    var block_size = PE_BASE_RELOC_BLOCK_HEADER_SIZE + entry_count * 2
    // Pad to 4-byte alignment
    if block_size % 4 != 0 {
        block_size = block_size + (4 - (block_size % 4))
    }
    out = pe_emit_u32(out, page_rva)
    out = pe_emit_u32(out, block_size)
    // Emit entries
    var i = 0
    while i < entry_count {
        let encoded = pe_encode_base_reloc_entry(out.base_relocs[i as usize])
        out = pe_emit_u16(out, encoded)
        i = i + 1
    }
    // Pad to 4-byte alignment
    if (entry_count * 2) % 4 != 0 {
        out = pe_emit_u16(out, 0)
    }
    out
}

// ============================================================================
// Import table (.idata)
// ============================================================================

fn pe_add_import(w: PeWriter, desc: PeImportDescriptor) -> PeWriter with Mut, Panic, Div {
    var out = w
    if out.import_count < 64 {
        out.imports[out.import_count as usize] = desc
        out.import_count = out.import_count + 1
    }
    out
}

fn pe_make_import_descriptor(
    int_rva: i64,
    name_rva: i64,
    iat_rva: i64
) -> PeImportDescriptor {
    PeImportDescriptor {
        original_first_thunk: int_rva,
        time_date_stamp: 0,
        forwarder_chain: 0,
        name_rva: name_rva,
        first_thunk: iat_rva,
    }
}

// Emit a single import descriptor (20 bytes)
fn pe_emit_import_descriptor(w: PeWriter, desc: PeImportDescriptor) -> PeWriter with Mut, Panic, Div {
    var out = w
    out = pe_emit_u32(out, desc.original_first_thunk)
    out = pe_emit_u32(out, desc.time_date_stamp)
    out = pe_emit_u32(out, desc.forwarder_chain)
    out = pe_emit_u32(out, desc.name_rva)
    out = pe_emit_u32(out, desc.first_thunk)
    out
}

// Build import table: emit all descriptors plus null terminator
fn pe_build_import_table(w: PeWriter) -> PeWriter with Mut, Panic, Div {
    var out = w
    var i = 0
    while i < out.import_count {
        out = pe_emit_import_descriptor(out, out.imports[i as usize])
        i = i + 1
    }
    // Null terminator descriptor (20 bytes of zeros)
    out = pe_emit_zeros(out, PE_IMPORT_DESC_SIZE)
    out
}

// Resolve imports: set up the IAT with hint/name table entries
fn pe_resolve_imports(w: PeWriter, iat_rva: i64) -> PeWriter with Mut, Panic, Div {
    var out = w
    // For each import, record the IAT entry RVA
    var i = 0
    while i < out.import_count {
        var desc = out.imports[i as usize]
        desc.first_thunk = iat_rva + i * 8
        out.imports[i as usize] = desc
        i = i + 1
    }
    out
}

// Emit a hint/name entry: 2-byte hint + null-terminated name
fn pe_emit_hint_name(w: PeWriter, hint: i64, name: [i8; 128], name_len: i64) -> PeWriter with Mut, Panic, Div {
    var out = w
    out = pe_emit_u16(out, hint)
    var i = 0
    while i < name_len {
        out = pe_emit_byte(out, name[i as usize] as i64)
        i = i + 1
    }
    out = pe_emit_byte(out, 0)  // null terminator
    // Pad to 2-byte alignment
    let total = 2 + name_len + 1
    if total % 2 != 0 {
        out = pe_emit_byte(out, 0)
    }
    out
}

// ============================================================================
// Export table (.edata)
// ============================================================================

fn pe_set_exports(w: PeWriter, exp: PeExportDirectory) -> PeWriter with Mut, Panic, Div {
    var out = w
    out.exports = exp
    out.has_exports = 1
    out
}

// Emit the export directory (40 bytes)
fn pe_emit_export_directory(w: PeWriter, exp: PeExportDirectory) -> PeWriter with Mut, Panic, Div {
    var out = w
    out = pe_emit_u32(out, exp.export_flags)
    out = pe_emit_u32(out, exp.time_date_stamp)
    out = pe_emit_u16(out, exp.major_version)
    out = pe_emit_u16(out, exp.minor_version)
    out = pe_emit_u32(out, exp.name_rva)
    out = pe_emit_u32(out, exp.ordinal_base)
    out = pe_emit_u32(out, exp.number_of_functions)
    out = pe_emit_u32(out, exp.number_of_names)
    out = pe_emit_u32(out, exp.address_of_functions)
    out = pe_emit_u32(out, exp.address_of_names)
    out = pe_emit_u32(out, exp.address_of_name_ordinals)
    out
}

// Build export table: emit directory + address table + name pointer table + ordinal table
fn pe_build_export_table(w: PeWriter, func_rvas: [i64; 256], name_rvas: [i64; 256], ordinals: [i64; 256]) -> PeWriter with Mut, Panic, Div {
    var out = w
    // Emit export directory
    out = pe_emit_export_directory(out, out.exports)
    // Emit export address table (function RVAs)
    var i = 0
    while i < out.exports.number_of_functions {
        out = pe_emit_u32(out, func_rvas[i as usize])
        i = i + 1
    }
    // Emit name pointer table
    var j = 0
    while j < out.exports.number_of_names {
        out = pe_emit_u32(out, name_rvas[j as usize])
        j = j + 1
    }
    // Emit ordinal table
    var k = 0
    while k < out.exports.number_of_names {
        out = pe_emit_u16(out, ordinals[k as usize])
        k = k + 1
    }
    out
}

// ============================================================================
// Resource handling
// ============================================================================

fn pe_add_resource(w: PeWriter, entry: PeResourceEntry) -> PeWriter with Mut, Panic, Div {
    var out = w
    if out.resource_count < 128 {
        out.resources[out.resource_count as usize] = entry
        out.resource_count = out.resource_count + 1
    }
    out
}

fn pe_make_resource(res_type: i64, name_id: i64, data_rva: i64, data_size: i64) -> PeResourceEntry {
    PeResourceEntry {
        res_type: res_type,
        name_id: name_id,
        data_rva: data_rva,
        data_size: data_size,
        codepage: 0,
    }
}

// Build a simplified resource tree
// A real resource tree has 3 levels (type -> name -> language).
// For bootstrap, we emit a flat structure: root directory with N type entries.
fn pe_build_resource_tree(w: PeWriter) -> PeWriter with Mut, Panic, Div {
    var out = w
    if out.resource_count == 0 {
        return out
    }
    // Resource directory table header (16 bytes):
    // Characteristics(4) + TimeDateStamp(4) + MajorVersion(2) +
    // MinorVersion(2) + NumberOfNameEntries(2) + NumberOfIdEntries(2)
    out = pe_emit_u32(out, 0)         // Characteristics
    out = pe_emit_u32(out, 0)         // TimeDateStamp
    out = pe_emit_u16(out, 0)         // MajorVersion
    out = pe_emit_u16(out, 0)         // MinorVersion
    out = pe_emit_u16(out, 0)         // NumberOfNameEntries
    out = pe_emit_u16(out, out.resource_count) // NumberOfIdEntries

    // Emit directory entries (8 bytes each: ID + Offset)
    // In a full implementation these would point to subdirectories.
    // For bootstrap we emit leaf pointers directly.
    var i = 0
    while i < out.resource_count {
        let res = out.resources[i as usize]
        out = pe_emit_u32(out, res.res_type)
        // Offset to resource data entry (simplified: relative offset)
        let data_entry_offset = 16 + out.resource_count * 8 + i * 16
        out = pe_emit_u32(out, data_entry_offset)
        i = i + 1
    }

    // Emit resource data entries (16 bytes each)
    var j = 0
    while j < out.resource_count {
        let res = out.resources[j as usize]
        out = pe_emit_u32(out, res.data_rva)
        out = pe_emit_u32(out, res.data_size)
        out = pe_emit_u32(out, res.codepage)
        out = pe_emit_u32(out, 0)     // Reserved
        j = j + 1
    }
    out
}

// ============================================================================
// DLL support and configuration
// ============================================================================

fn pe_mark_as_dll(w: PeWriter) -> PeWriter with Mut, Panic, Div {
    var out = w
    out.is_dll = 1
    out.characteristics = out.characteristics + PE_COFF_DLL
    out.image_base = PE_DLL_IMAGE_BASE
    out
}

fn pe_set_entry_point(w: PeWriter, rva: i64) -> PeWriter with Mut, Panic, Div {
    var out = w
    out.entry_point_rva = rva
    out
}

fn pe_set_subsystem(w: PeWriter, subsystem: i64) -> PeWriter with Mut, Panic, Div {
    var out = w
    out.subsystem = subsystem
    out
}

fn pe_set_image_base(w: PeWriter, base: i64) -> PeWriter with Mut, Panic, Div {
    var out = w
    out.image_base = base
    out
}

fn pe_set_stack_sizes(w: PeWriter, reserve: i64, commit: i64) -> PeWriter with Mut, Panic, Div {
    var out = w
    out.stack_reserve = reserve
    out.stack_commit = commit
    out
}

fn pe_set_heap_sizes(w: PeWriter, reserve: i64, commit: i64) -> PeWriter with Mut, Panic, Div {
    var out = w
    out.heap_reserve = reserve
    out.heap_commit = commit
    out
}

fn pe_set_machine(w: PeWriter, machine: i64) -> PeWriter with Mut, Panic, Div {
    var out = w
    out.machine = machine
    out
}

fn pe_set_data_directory(w: PeWriter, index: i64, rva: i64, size: i64) -> PeWriter with Mut, Panic, Div {
    var out = w
    if index >= 0 && index < PE_NUM_DATA_DIRS {
        out.data_dirs[index as usize] = PeDataDirectory {
            virtual_address: rva,
            size: size,
        }
    }
    out
}

// ============================================================================
// Layout computation
// ============================================================================

// Compute the size of all headers (DOS + PE sig + COFF + optional + section headers)
fn pe_compute_headers_size(nsections: i64) -> i64 with Mut, Panic {
    let raw = PE_DOS_HEADER_SIZE + PE_SIGNATURE_SIZE + PE_COFF_HEADER_SIZE +
              PE_OPTIONAL_HEADER_SIZE_PE32PLUS + nsections * PE_SECTION_HEADER_SIZE
    pe_file_align(raw)
}

// Compute total code size across all .text sections
fn pe_compute_code_size(w: PeWriter) -> i64 with Mut, Panic, Div {
    var total = 0
    var i = 0
    while i < w.section_count {
        if w.sections[i as usize].name_id == PE_SECT_TEXT {
            total = total + w.sections[i as usize].size_of_raw_data
        }
        i = i + 1
    }
    total
}

// Compute total initialized data size
fn pe_compute_init_data_size(w: PeWriter) -> i64 with Mut, Panic, Div {
    var total = 0
    var i = 0
    while i < w.section_count {
        let chars = w.sections[i as usize].characteristics
        // Check CNT_INITIALIZED_DATA flag
        if (chars & PE_SCN_CNT_INITIALIZED_DATA) != 0 {
            total = total + w.sections[i as usize].size_of_raw_data
        }
        i = i + 1
    }
    total
}

// Compute total uninitialized data size
fn pe_compute_uninit_data_size(w: PeWriter) -> i64 with Mut, Panic, Div {
    var total = 0
    var i = 0
    while i < w.section_count {
        let chars = w.sections[i as usize].characteristics
        if (chars & PE_SCN_CNT_UNINITIALIZED_DATA) != 0 {
            total = total + w.sections[i as usize].virtual_size
        }
        i = i + 1
    }
    total
}

// Compute size_of_image: highest section VA + aligned section size
fn pe_compute_image_size(w: PeWriter) -> i64 with Mut, Panic, Div {
    var max_end = 0
    var i = 0
    while i < w.section_count {
        let sec = w.sections[i as usize]
        let vsize = if sec.virtual_size > sec.size_of_raw_data { sec.virtual_size } else { sec.size_of_raw_data }
        let end = pe_section_align(sec.virtual_address + vsize)
        if end > max_end {
            max_end = end
        }
        i = i + 1
    }
    if max_end == 0 {
        // No sections — just headers
        pe_section_align(pe_compute_headers_size(0))
    } else {
        max_end
    }
}

// Find the RVA of the first .text section
fn pe_find_code_base(w: PeWriter) -> i64 with Mut, Panic, Div {
    var i = 0
    while i < w.section_count {
        if w.sections[i as usize].name_id == PE_SECT_TEXT {
            return w.sections[i as usize].virtual_address
        }
        i = i + 1
    }
    0
}

// ============================================================================
// Full PE builder — executable
// ============================================================================

fn pe_build_executable(w: PeWriter, code_bytes: [i8; 65536], code_len: i64) -> PeWriter with Mut, Panic, Div {
    var out = w
    let headers_size = pe_compute_headers_size(out.section_count)
    // Update layout fields
    out.size_of_headers = headers_size
    out.size_of_code = pe_compute_code_size(out)
    out.size_of_init_data = pe_compute_init_data_size(out)
    out.size_of_uninit_data = pe_compute_uninit_data_size(out)
    out.base_of_code = pe_find_code_base(out)
    out.size_of_image = pe_compute_image_size(out)

    // Build DOS header (e_lfanew points just past the DOS header at offset 64)
    let dos = pe_dos_header_new(PE_DOS_HEADER_SIZE)
    out = pe_write_dos_stub(out, dos)

    // Build COFF header
    var coff_chars = out.characteristics
    if out.is_dll == 1 {
        // Ensure DLL flag is set
        if (coff_chars & PE_COFF_DLL) == 0 {
            coff_chars = coff_chars + PE_COFF_DLL
        }
    }
    let coff = pe_coff_header_new(out.machine, out.section_count, coff_chars)
    out = pe_write_coff_header(out, coff)

    // Build optional header
    var opt = pe_optional_header_new()
    opt.address_of_entry_point = out.entry_point_rva
    opt.image_base = out.image_base
    opt.section_alignment = out.section_alignment
    opt.file_alignment = out.file_alignment
    opt.subsystem = out.subsystem
    opt.dll_characteristics = out.dll_characteristics
    opt.size_of_code = out.size_of_code
    opt.size_of_initialized_data = out.size_of_init_data
    opt.size_of_uninitialized_data = out.size_of_uninit_data
    opt.base_of_code = out.base_of_code
    opt.size_of_image = out.size_of_image
    opt.size_of_headers = out.size_of_headers
    opt.size_of_stack_reserve = out.stack_reserve
    opt.size_of_stack_commit = out.stack_commit
    opt.size_of_heap_reserve = out.heap_reserve
    opt.size_of_heap_commit = out.heap_commit
    out = pe_write_optional_header(out, opt, out.data_dirs)

    // Write section headers
    out = pe_write_section_headers(out)

    // Pad to headers_size
    while out.buf_len < headers_size {
        out = pe_emit_byte(out, 0)
    }

    // Write code (.text section data)
    var ci = 0
    while ci < code_len && ci < 65536 {
        out = pe_emit_byte(out, code_bytes[ci as usize] as i64)
        ci = ci + 1
    }

    // Pad to file alignment
    out = pe_emit_pad_to(out, PE_FILE_ALIGNMENT)

    out
}

// ============================================================================
// Full PE builder — DLL
// ============================================================================

fn pe_build_dll(w: PeWriter, code_bytes: [i8; 65536], code_len: i64) -> PeWriter with Mut, Panic, Div {
    var out = pe_mark_as_dll(w)
    out = pe_build_executable(out, code_bytes, code_len)
    out
}

// ============================================================================
// Link COFF objects — simplified object file linker
// ============================================================================

// Merge relocations from an object file into the writer
fn pe_merge_object_relocs(
    w: PeWriter,
    obj_relocs: [PeRelocation; 4096],
    obj_reloc_count: i64,
    sym_base: i64
) -> PeWriter with Mut, Panic, Div {
    var out = w
    var i = 0
    while i < obj_reloc_count {
        var rel = obj_relocs[i as usize]
        // Adjust symbol index by the base of merged symbols
        rel.symbol_table_index = rel.symbol_table_index + sym_base
        out = pe_add_relocation(out, rel)
        i = i + 1
    }
    out
}

// Merge symbols from an object file
fn pe_merge_object_symbols(
    w: PeWriter,
    obj_symbols: [PeSymbol; 2048],
    obj_symbol_count: i64,
    section_base: i64
) -> PeWriter with Mut, Panic, Div {
    var out = w
    var i = 0
    while i < obj_symbol_count {
        var sym = obj_symbols[i as usize]
        // Adjust section number
        if sym.section_number > 0 {
            sym.section_number = sym.section_number + section_base
        }
        out = pe_add_symbol(out, sym)
        i = i + 1
    }
    out
}

// Link multiple COFF object sections into one PE
fn pe_link_objects(
    w: PeWriter,
    obj_sections: [PeSectionHeader; 16],
    obj_section_count: i64,
    base_rva: i64
) -> PeWriter with Mut, Panic, Div {
    var out = w
    var current_rva = base_rva
    var i = 0
    while i < obj_section_count {
        var sec = obj_sections[i as usize]
        sec.virtual_address = current_rva
        out = pe_add_section(out, sec)
        let aligned_size = pe_section_align(sec.virtual_size)
        current_rva = current_rva + aligned_size
        i = i + 1
    }
    out
}

// ============================================================================
// Utility — compute PE checksum (simplified)
// ============================================================================

// Simplified PE checksum (sum of all u16 words, folded to u16, plus file length)
fn pe_compute_checksum(w: PeWriter) -> i64 with Mut, Panic, Div {
    var sum = 0
    var i = 0
    let word_count = w.buf_len / 2
    while i < word_count {
        let word = pe_read_u16_le(w, i * 2)
        sum = sum + word
        // Fold carry
        if sum > 65535 {
            sum = (sum & 65535) + (sum >> 16)
        }
        i = i + 1
    }
    // Handle odd byte
    if w.buf_len % 2 != 0 {
        sum = sum + pe_read_u8(w, w.buf_len - 1)
        if sum > 65535 {
            sum = (sum & 65535) + (sum >> 16)
        }
    }
    sum + w.buf_len
}

// ============================================================================
// Utility — count sections by type
// ============================================================================

fn pe_count_sections_by_type(w: PeWriter, name_id: i64) -> i64 with Mut, Panic, Div {
    var count = 0
    var i = 0
    while i < w.section_count {
        if w.sections[i as usize].name_id == name_id {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// ============================================================================
// Utility — find section by name_id
// ============================================================================

fn pe_find_section(w: PeWriter, name_id: i64) -> i64 with Mut, Panic, Div {
    var i = 0
    while i < w.section_count {
        if w.sections[i as usize].name_id == name_id {
            return i
        }
        i = i + 1
    }
    0 - 1
}

