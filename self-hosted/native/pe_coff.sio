// T14: Verify writer defaults
fn test_pe_writer_defaults() -> i64 with IO, Mut, Div, Panic {
    let w = pe_writer_new()
    if w.machine != PE_MACHINE_AMD64 { return 1 }
    if w.subsystem != PE_SUBSYSTEM_WINDOWS_CUI { return 2 }
    if w.image_base != PE_IMAGE_BASE { return 3 }
    if w.section_count != 0 { return 4 }
    if w.symbol_count != 0 { return 5 }
    if w.reloc_count != 0 { return 6 }
    if w.import_count != 0 { return 7 }
    if w.is_dll != 0 { return 8 }
    if w.buf_len != 0 { return 9 }
    if w.entry_point_rva != 0 { return 10 }
    0
}

// T15: Verify ARM64 writer
fn test_pe_writer_arm64() -> i64 with IO, Mut, Div, Panic {
    let w = pe_writer_new_arm64()
    if w.machine != PE_MACHINE_ARM64 { return 1 }
    if w.subsystem != PE_SUBSYSTEM_WINDOWS_CUI { return 2 }
    0
}

// T16: Verify DLL writer
fn test_pe_writer_dll() -> i64 with IO, Mut, Div, Panic {
    let w = pe_writer_new_dll()
    if w.is_dll != 1 { return 1 }
    if w.image_base != PE_DLL_IMAGE_BASE { return 2 }
    // Should have DLL flag set
    if (w.characteristics & PE_COFF_DLL) == 0 { return 3 }
    0
}

// T17: Verify object writer
fn test_pe_writer_object() -> i64 with IO, Mut, Div, Panic {
    let w = pe_writer_new_object()
    if w.characteristics != 0 { return 1 }
    if w.image_base != 0 { return 2 }
    0
}

// T18: Verify byte emission
fn test_pe_emit_byte() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_emit_byte(w, 0x4D)
    w = pe_emit_byte(w, 0x5A)
    if w.buf_len != 2 { return 1 }
    if pe_read_u8(w, 0) != 0x4D { return 2 }
    if pe_read_u8(w, 1) != 0x5A { return 3 }
    0
}

// T19: Verify u16 emission and reading
fn test_pe_emit_u16() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_emit_u16(w, 23117)  // 0x5A4D
    if w.buf_len != 2 { return 1 }
    if pe_read_u16_le(w, 0) != 23117 { return 2 }
    // Check individual bytes: 0x4D, 0x5A
    if pe_read_u8(w, 0) != 0x4D { return 3 }
    if pe_read_u8(w, 1) != 0x5A { return 4 }
    0
}

// T20: Verify u32 emission and reading
fn test_pe_emit_u32() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_emit_u32(w, PE_SIGNATURE)  // 0x00004550
    if w.buf_len != 4 { return 1 }
    if pe_read_u32_le(w, 0) != PE_SIGNATURE { return 2 }
    // Check bytes: 50 45 00 00
    if pe_read_u8(w, 0) != 0x50 { return 3 }
    if pe_read_u8(w, 1) != 0x45 { return 4 }
    if pe_read_u8(w, 2) != 0x00 { return 5 }
    if pe_read_u8(w, 3) != 0x00 { return 6 }
    0
}

// T21: Verify u64 emission and reading
fn test_pe_emit_u64() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_emit_u64(w, PE_IMAGE_BASE)  // 0x400000
    if w.buf_len != 8 { return 1 }
    if pe_read_u64_le(w, 0) != PE_IMAGE_BASE { return 2 }
    0
}

// T22: Verify padding
fn test_pe_emit_zeros() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_emit_byte(w, 0xFF)
    w = pe_emit_zeros(w, 7)
    if w.buf_len != 8 { return 1 }
    if pe_read_u8(w, 0) != 0xFF { return 2 }
    if pe_read_u8(w, 1) != 0 { return 3 }
    if pe_read_u8(w, 7) != 0 { return 4 }
    0
}

// T23: Verify pad_to alignment
fn test_pe_emit_pad_to() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_emit_byte(w, 0xCC)
    w = pe_emit_pad_to(w, 8)
    if w.buf_len != 8 { return 1 }
    // Already aligned should be a no-op
    w = pe_emit_pad_to(w, 8)
    if w.buf_len != 8 { return 2 }
    0
}

// T24: Verify patch_u32
fn test_pe_patch_u32() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_emit_u32(w, 0)
    w = pe_emit_u32(w, 0)
    w = pe_patch_u32(w, 0, 12345678)
    if pe_read_u32_le(w, 0) != 12345678 { return 1 }
    if pe_read_u32_le(w, 4) != 0 { return 2 }
    w = pe_patch_u32(w, 4, 87654321)
    if pe_read_u32_le(w, 4) != 87654321 { return 3 }
    0
}

// T25: Verify patch_u64
fn test_pe_patch_u64() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_emit_u64(w, 0)
    w = pe_patch_u64(w, 0, 4294967296)  // 0x100000000
    if pe_read_u64_le(w, 0) != 4294967296 { return 1 }
    0
}

// T26: Verify alignment math
fn test_pe_alignment() -> i64 with IO, Mut, Div, Panic {
    if pe_align_to(0, 512) != 0 { return 1 }
    if pe_align_to(1, 512) != 512 { return 2 }
    if pe_align_to(512, 512) != 512 { return 3 }
    if pe_align_to(513, 512) != 1024 { return 4 }
    if pe_file_align(100) != 512 { return 5 }
    if pe_section_align(100) != 4096 { return 6 }
    if pe_page_align(4097) != 8192 { return 7 }
    if pe_section_align(0) != 0 { return 8 }
    0
}

// T27: Verify DOS header emission size
fn test_pe_dos_header_size() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    let dos = pe_dos_header_new(PE_DOS_HEADER_SIZE)
    w = pe_write_dos_stub(w, dos)
    if w.buf_len != PE_DOS_HEADER_SIZE { return 1 }
    // Check magic bytes
    if pe_read_u16_le(w, 0) != PE_DOS_MAGIC { return 2 }
    // Check e_lfanew at offset 60
    if pe_read_u32_le(w, 60) != 64 { return 3 }
    0
}

// T28: Verify COFF header emission
fn test_pe_coff_header_emission() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    let coff = pe_coff_header_new(PE_MACHINE_AMD64, 3, PE_COFF_EXECUTABLE_IMAGE + PE_COFF_LARGE_ADDRESS_AWARE)
    w = pe_write_coff_header(w, coff)
    // PE sig (4) + COFF header (20) = 24 bytes
    if w.buf_len != PE_SIGNATURE_SIZE + PE_COFF_HEADER_SIZE { return 1 }
    // Check PE signature
    if pe_read_u32_le(w, 0) != PE_SIGNATURE { return 2 }
    // Check machine type at offset 4
    if pe_read_u16_le(w, 4) != PE_MACHINE_AMD64 { return 3 }
    // Check number of sections at offset 6
    if pe_read_u16_le(w, 6) != 3 { return 4 }
    // Check optional header size at offset 20
    if pe_read_u16_le(w, 20) != PE_OPTIONAL_HEADER_SIZE_PE32PLUS { return 5 }
    // Check characteristics at offset 22
    if pe_read_u16_le(w, 22) != 34 { return 6 }  // 2 + 32
    0
}

// T29: Verify optional header emission
fn test_pe_optional_header_emission() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    let opt = pe_optional_header_new()
    let dirs = [pe_empty_data_dir(); 16]
    w = pe_write_optional_header(w, opt, dirs)
    if w.buf_len != PE_OPTIONAL_HEADER_SIZE_PE32PLUS { return 1 }
    // Check magic at offset 0
    if pe_read_u16_le(w, 0) != PE_OPT_MAGIC_PE32PLUS { return 2 }
    // Check linker version
    if pe_read_u8(w, 2) != 14 { return 3 }  // major
    if pe_read_u8(w, 3) != 0 { return 4 }   // minor
    // Check image_base at offset 24 (after 24 bytes of standard fields)
    if pe_read_u64_le(w, 24) != PE_IMAGE_BASE { return 5 }
    // Check section_alignment at offset 32
    if pe_read_u32_le(w, 32) != PE_SECTION_ALIGNMENT { return 6 }
    // Check file_alignment at offset 36
    if pe_read_u32_le(w, 36) != PE_FILE_ALIGNMENT { return 7 }
    0
}

// T30: Verify section name emission — .text
fn test_pe_section_name_text() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_emit_section_name(w, PE_SECT_TEXT)
    if w.buf_len != 8 { return 1 }
    // ".text" = 46, 116, 101, 120, 116
    if pe_read_u8(w, 0) != 46 { return 2 }    // '.'
    if pe_read_u8(w, 1) != 116 { return 3 }   // 't'
    if pe_read_u8(w, 2) != 101 { return 4 }   // 'e'
    if pe_read_u8(w, 3) != 120 { return 5 }   // 'x'
    if pe_read_u8(w, 4) != 116 { return 6 }   // 't'
    if pe_read_u8(w, 5) != 0 { return 7 }
    0
}

// T31: Verify section name emission — .data
fn test_pe_section_name_data() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_emit_section_name(w, PE_SECT_DATA)
    if w.buf_len != 8 { return 1 }
    if pe_read_u8(w, 0) != 46 { return 2 }    // '.'
    if pe_read_u8(w, 1) != 100 { return 3 }   // 'd'
    if pe_read_u8(w, 2) != 97 { return 4 }    // 'a'
    if pe_read_u8(w, 3) != 116 { return 5 }   // 't'
    if pe_read_u8(w, 4) != 97 { return 6 }    // 'a'
    0
}

// T32: Verify section name emission — .rdata
fn test_pe_section_name_rdata() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_emit_section_name(w, PE_SECT_RDATA)
    if w.buf_len != 8 { return 1 }
    if pe_read_u8(w, 0) != 46 { return 2 }     // '.'
    if pe_read_u8(w, 1) != 114 { return 3 }    // 'r'
    if pe_read_u8(w, 2) != 100 { return 4 }    // 'd'
    if pe_read_u8(w, 3) != 97 { return 5 }     // 'a'
    if pe_read_u8(w, 4) != 116 { return 6 }    // 't'
    if pe_read_u8(w, 5) != 97 { return 7 }     // 'a'
    0
}

// T33: Verify section name emission — .bss
fn test_pe_section_name_bss() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_emit_section_name(w, PE_SECT_BSS)
    if w.buf_len != 8 { return 1 }
    if pe_read_u8(w, 0) != 46 { return 2 }     // '.'
    if pe_read_u8(w, 1) != 98 { return 3 }     // 'b'
    if pe_read_u8(w, 2) != 115 { return 4 }    // 's'
    if pe_read_u8(w, 3) != 115 { return 5 }    // 's'
    0
}

// T34: Verify section name emission — .reloc
fn test_pe_section_name_reloc() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_emit_section_name(w, PE_SECT_RELOC)
    if w.buf_len != 8 { return 1 }
    if pe_read_u8(w, 0) != 46 { return 2 }     // '.'
    if pe_read_u8(w, 1) != 114 { return 3 }    // 'r'
    if pe_read_u8(w, 2) != 101 { return 4 }    // 'e'
    if pe_read_u8(w, 3) != 108 { return 5 }    // 'l'
    if pe_read_u8(w, 4) != 111 { return 6 }    // 'o'
    if pe_read_u8(w, 5) != 99 { return 7 }     // 'c'
    0
}

// T35: Verify section header emission
fn test_pe_section_header_emission() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    let sec = PeSectionHeader {
        name_id: PE_SECT_TEXT,
        virtual_size: 256,
        virtual_address: 4096,
        size_of_raw_data: 512,
        pointer_to_raw_data: 512,
        pointer_to_relocations: 0,
        pointer_to_linenumbers: 0,
        number_of_relocations: 0,
        number_of_linenumbers: 0,
        characteristics: PE_SCN_CNT_CODE + PE_SCN_MEM_EXECUTE + PE_SCN_MEM_READ,
    }
    w = pe_write_section_header(w, sec)
    if w.buf_len != PE_SECTION_HEADER_SIZE { return 1 }
    // VirtualSize at offset 8
    if pe_read_u32_le(w, 8) != 256 { return 2 }
    // VirtualAddress at offset 12
    if pe_read_u32_le(w, 12) != 4096 { return 3 }
    // SizeOfRawData at offset 16
    if pe_read_u32_le(w, 16) != 512 { return 4 }
    // PointerToRawData at offset 20
    if pe_read_u32_le(w, 20) != 512 { return 5 }
    // Characteristics at offset 36
    let chars = pe_read_u32_le(w, 36)
    if (chars & PE_SCN_CNT_CODE) == 0 { return 6 }
    0
}

// T36: Verify adding text section
fn test_pe_add_text_section() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_add_text_section(w, 4096, 256, 512, 512)
    if w.section_count != 1 { return 1 }
    if w.sections[0].name_id != PE_SECT_TEXT { return 2 }
    if w.sections[0].virtual_address != 4096 { return 3 }
    if w.sections[0].virtual_size != 256 { return 4 }
    if w.sections[0].size_of_raw_data != 512 { return 5 }
    // Check code flags
    if (w.sections[0].characteristics & PE_SCN_CNT_CODE) == 0 { return 6 }
    if (w.sections[0].characteristics & PE_SCN_MEM_EXECUTE) == 0 { return 7 }
    0
}

// T37: Verify adding data section
fn test_pe_add_data_section() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_add_data_section(w, 8192, 128, 1024, 512)
    if w.section_count != 1 { return 1 }
    if w.sections[0].name_id != PE_SECT_DATA { return 2 }
    if (w.sections[0].characteristics & PE_SCN_CNT_INITIALIZED_DATA) == 0 { return 3 }
    if (w.sections[0].characteristics & PE_SCN_MEM_WRITE) == 0 { return 4 }
    0
}

// T38: Verify adding rdata section
fn test_pe_add_rdata_section() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_add_rdata_section(w, 12288, 64, 1536, 512)
    if w.section_count != 1 { return 1 }
    if w.sections[0].name_id != PE_SECT_RDATA { return 2 }
    if (w.sections[0].characteristics & PE_SCN_MEM_READ) == 0 { return 3 }
    // rdata should NOT be writable
    if (w.sections[0].characteristics & PE_SCN_MEM_WRITE) != 0 { return 4 }
    0
}

// T39: Verify adding BSS section
fn test_pe_add_bss_section() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_add_bss_section(w, 16384, 4096)
    if w.section_count != 1 { return 1 }
    if w.sections[0].name_id != PE_SECT_BSS { return 2 }
    if w.sections[0].pointer_to_raw_data != 0 { return 3 }
    if w.sections[0].size_of_raw_data != 0 { return 4 }
    if (w.sections[0].characteristics & PE_SCN_CNT_UNINITIALIZED_DATA) == 0 { return 5 }
    0
}

// T40: Verify adding multiple sections
fn test_pe_add_multiple_sections() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_add_text_section(w, 4096, 100, 512, 512)
    w = pe_add_rdata_section(w, 8192, 50, 1024, 512)
    w = pe_add_data_section(w, 12288, 80, 1536, 512)
    w = pe_add_bss_section(w, 16384, 200)
    if w.section_count != 4 { return 1 }
    if w.sections[0].name_id != PE_SECT_TEXT { return 2 }
    if w.sections[1].name_id != PE_SECT_RDATA { return 3 }
    if w.sections[2].name_id != PE_SECT_DATA { return 4 }
    if w.sections[3].name_id != PE_SECT_BSS { return 5 }
    0
}

// T41: Verify symbol creation — external
fn test_pe_external_symbol() -> i64 with IO, Mut, Div, Panic {
    let sym = pe_make_external_symbol(10, 1, 4096)
    if sym.name_offset != 10 { return 1 }
    if sym.section_number != 1 { return 2 }
    if sym.value != 4096 { return 3 }
    if sym.storage_class != PE_SYM_CLASS_EXTERNAL { return 4 }
    if sym.sym_type != PE_SYM_TYPE_FUNCTION { return 5 }
    0
}

// T42: Verify symbol creation — static
fn test_pe_static_symbol() -> i64 with IO, Mut, Div, Panic {
    let sym = pe_make_static_symbol(20, 2, 0)
    if sym.name_offset != 20 { return 1 }
    if sym.section_number != 2 { return 2 }
    if sym.storage_class != PE_SYM_CLASS_STATIC { return 3 }
    if sym.sym_type != PE_SYM_TYPE_NULL { return 4 }
    0
}

// T43: Verify symbol creation — section
fn test_pe_section_symbol() -> i64 with IO, Mut, Div, Panic {
    let sym = pe_make_section_symbol(3)
    if sym.section_number != 3 { return 1 }
    if sym.storage_class != PE_SYM_CLASS_SECTION { return 2 }
    if sym.value != 0 { return 3 }
    0
}

// T44: Verify symbol creation — undefined
fn test_pe_undef_symbol() -> i64 with IO, Mut, Div, Panic {
    let sym = pe_make_undef_symbol(50)
    if sym.name_offset != 50 { return 1 }
    if sym.section_number != 0 { return 2 }
    if sym.storage_class != PE_SYM_CLASS_EXTERNAL { return 3 }
    0
}

// T45: Verify adding symbols to writer
fn test_pe_add_symbol() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_add_symbol(w, pe_make_external_symbol(4, 1, 100))
    if w.symbol_count != 1 { return 1 }
    w = pe_add_symbol(w, pe_make_undef_symbol(8))
    if w.symbol_count != 2 { return 2 }
    if w.symbols[0].value != 100 { return 3 }
    if w.symbols[1].section_number != 0 { return 4 }
    0
}

// T46: Verify symbol emission
fn test_pe_emit_symbol() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    let sym = pe_make_external_symbol(100, 1, 4096)
    w = pe_emit_symbol(w, sym)
    if w.buf_len != PE_SYMBOL_SIZE { return 1 }
    // First 4 bytes should be 0 (long name indicator)
    if pe_read_u32_le(w, 0) != 0 { return 2 }
    // Next 4 bytes: string table offset
    if pe_read_u32_le(w, 4) != 100 { return 3 }
    // Value at offset 8
    if pe_read_u32_le(w, 8) != 4096 { return 4 }
    // Section number at offset 12
    if pe_read_u16_le(w, 12) != 1 { return 5 }
    // Type at offset 14
    if pe_read_u16_le(w, 14) != PE_SYM_TYPE_FUNCTION { return 6 }
    // Storage class at offset 16
    if pe_read_u8(w, 16) != PE_SYM_CLASS_EXTERNAL { return 7 }
    0
}

// T47: Verify relocation creation
fn test_pe_make_relocs() -> i64 with IO, Mut, Div, Panic {
    let rel32 = pe_make_rel32_reloc(100, 5)
    if rel32.virtual_address != 100 { return 1 }
    if rel32.symbol_table_index != 5 { return 2 }
    if rel32.rel_type != PE_REL_AMD64_REL32 { return 3 }

    let addr64 = pe_make_addr64_reloc(200, 10)
    if addr64.rel_type != PE_REL_AMD64_ADDR64 { return 4 }

    let rva = pe_make_addr32nb_reloc(300, 15)
    if rva.rel_type != PE_REL_AMD64_ADDR32NB { return 5 }

    let secrel = pe_make_secrel_reloc(400, 20)
    if secrel.rel_type != PE_REL_AMD64_SECREL { return 6 }
    0
}

// T48: Verify adding relocations
fn test_pe_add_relocation() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_add_relocation(w, pe_make_rel32_reloc(0, 0))
    w = pe_add_relocation(w, pe_make_addr64_reloc(8, 1))
    if w.reloc_count != 2 { return 1 }
    if w.relocs[0].rel_type != PE_REL_AMD64_REL32 { return 2 }
    if w.relocs[1].rel_type != PE_REL_AMD64_ADDR64 { return 3 }
    0
}

// T49: Verify relocation emission
fn test_pe_emit_relocation() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    let rel = pe_make_rel32_reloc(0x100, 7)
    w = pe_emit_relocation(w, rel)
    if w.buf_len != PE_RELOCATION_SIZE { return 1 }
    // VirtualAddress at offset 0
    if pe_read_u32_le(w, 0) != 256 { return 2 }  // 0x100
    // SymbolTableIndex at offset 4
    if pe_read_u32_le(w, 4) != 7 { return 3 }
    // Type at offset 8
    if pe_read_u16_le(w, 8) != PE_REL_AMD64_REL32 { return 4 }
    0
}

// T50: Verify ARM64 relocations
fn test_pe_arm64_relocs() -> i64 with IO, Mut, Div, Panic {
    let br = pe_make_arm64_branch26_reloc(100, 5)
    if br.rel_type != PE_REL_ARM64_BRANCH26 { return 1 }

    let pg = pe_make_arm64_pagebase_reloc(200, 10)
    if pg.rel_type != PE_REL_ARM64_PAGEBASE_REL21 { return 2 }

    let po = pe_make_arm64_pageoff12a_reloc(300, 15)
    if po.rel_type != PE_REL_ARM64_PAGEOFFSET_12A { return 3 }
    0
}

// T51: Verify base relocation encoding
fn test_pe_base_reloc_encoding() -> i64 with IO, Mut, Div, Panic {
    // DIR64 = type 10, offset 0x100 = 256
    let entry = PeBaseRelocEntry { entry_type: PE_BASE_RELOC_DIR64, offset: 256 }
    let encoded = pe_encode_base_reloc_entry(entry)
    // type 10 in top 4 bits: 10 * 4096 = 40960
    // offset 256 in bottom 12 bits: 256
    // total: 41216
    if encoded != 41216 { return 1 }

    // ABSOLUTE = type 0, offset 0
    let pad = PeBaseRelocEntry { entry_type: PE_BASE_RELOC_ABSOLUTE, offset: 0 }
    if pe_encode_base_reloc_entry(pad) != 0 { return 2 }

    // HIGHLOW = type 3, offset 0x500 = 1280
    let hl = PeBaseRelocEntry { entry_type: PE_BASE_RELOC_HIGHLOW, offset: 1280 }
    let hl_enc = pe_encode_base_reloc_entry(hl)
    // 3 * 4096 + 1280 = 12288 + 1280 = 13568
    if hl_enc != 13568 { return 3 }
    0
}

// T52: Verify import descriptor creation
fn test_pe_import_descriptor() -> i64 with IO, Mut, Div, Panic {
    let desc = pe_make_import_descriptor(1000, 2000, 3000)
    if desc.original_first_thunk != 1000 { return 1 }
    if desc.name_rva != 2000 { return 2 }
    if desc.first_thunk != 3000 { return 3 }
    if desc.time_date_stamp != 0 { return 4 }
    if desc.forwarder_chain != 0 { return 5 }
    0
}

// T53: Verify import descriptor emission
fn test_pe_emit_import_descriptor() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    let desc = pe_make_import_descriptor(0x1000, 0x2000, 0x3000)
    w = pe_emit_import_descriptor(w, desc)
    if w.buf_len != PE_IMPORT_DESC_SIZE { return 1 }
    if pe_read_u32_le(w, 0) != 0x1000 { return 2 }
    if pe_read_u32_le(w, 12) != 0x2000 { return 3 }
    if pe_read_u32_le(w, 16) != 0x3000 { return 4 }
    0
}

// T54: Verify adding imports
fn test_pe_add_import() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_add_import(w, pe_make_import_descriptor(100, 200, 300))
    w = pe_add_import(w, pe_make_import_descriptor(400, 500, 600))
    if w.import_count != 2 { return 1 }
    if w.imports[0].name_rva != 200 { return 2 }
    if w.imports[1].name_rva != 500 { return 3 }
    0
}

// T55: Verify export directory
fn test_pe_export_directory() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    var exp = pe_empty_export()
    exp.name_rva = 5000
    exp.number_of_functions = 3
    exp.number_of_names = 3
    exp.ordinal_base = 1
    w = pe_set_exports(w, exp)
    if w.has_exports != 1 { return 1 }
    if w.exports.name_rva != 5000 { return 2 }
    if w.exports.number_of_functions != 3 { return 3 }
    0
}

// T56: Verify export directory emission
fn test_pe_emit_export_directory() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    var exp = pe_empty_export()
    exp.name_rva = 0x4000
    exp.ordinal_base = 1
    exp.number_of_functions = 2
    exp.number_of_names = 2
    w = pe_emit_export_directory(w, exp)
    if w.buf_len != PE_EXPORT_DIR_SIZE { return 1 }
    // name_rva at offset 12
    if pe_read_u32_le(w, 12) != 0x4000 { return 2 }
    // ordinal_base at offset 16
    if pe_read_u32_le(w, 16) != 1 { return 3 }
    // number_of_functions at offset 20
    if pe_read_u32_le(w, 20) != 2 { return 4 }
    0
}

// T57: Verify string table init
fn test_pe_strtab_init() -> i64 with IO, Mut, Div, Panic {
    let st = pe_strtab_init()
    if st.len != 4 { return 1 }
    // First 4 bytes are the size (initially all zeros, set on build)
    0
}

// T58: Verify string table add
fn test_pe_strtab_add() -> i64 with IO, Mut, Div, Panic {
    var st = pe_strtab_init()
    // Add "main"
    var name: [i8; 128] = [0; 128]
    name[0] = 109  // 'm'
    name[1] = 97   // 'a'
    name[2] = 105  // 'i'
    name[3] = 110  // 'n'
    st = pe_add_string(st, name, 4)
    // String should be at offset 4, length 4 + null = 5, so len = 9
    if st.len != 9 { return 1 }
    // Verify the string bytes
    if st.bytes[4] != 109 { return 2 }  // 'm'
    if st.bytes[5] != 97 { return 3 }   // 'a'
    if st.bytes[6] != 105 { return 4 }  // 'i'
    if st.bytes[7] != 110 { return 5 }  // 'n'
    if st.bytes[8] != 0 { return 6 }    // null
    0
}

// T59: Verify string table find
fn test_pe_strtab_find() -> i64 with IO, Mut, Div, Panic {
    var st = pe_strtab_init()
    var name: [i8; 128] = [0; 128]
    name[0] = 102  // 'f'
    name[1] = 111  // 'o'
    name[2] = 111  // 'o'
    st = pe_add_string(st, name, 3)
    let offset = pe_strtab_find(st, name, 3)
    if offset != 4 { return 1 }
    // Search for non-existent string
    var other: [i8; 128] = [0; 128]
    other[0] = 98   // 'b'
    other[1] = 97   // 'a'
    other[2] = 114  // 'r'
    let not_found = pe_strtab_find(st, other, 3)
    if not_found != (0 - 1) { return 2 }
    0
}

// T60: Verify building string table (size field)
fn test_pe_build_string_table() -> i64 with IO, Mut, Div, Panic {
    var st = pe_strtab_init()
    var name: [i8; 128] = [0; 128]
    name[0] = 120  // 'x'
    st = pe_add_string(st, name, 1)
    st = pe_build_string_table(st)
    // len should be 6 (4 header + 'x' + null)
    if st.len != 6 { return 1 }
    // First 4 bytes = size = 6
    let size = (st.bytes[0] as i64 & 255) + (st.bytes[1] as i64 & 255) * 256
    if size != 6 { return 2 }
    0
}

// T61: Verify headers size computation
fn test_pe_headers_size() -> i64 with IO, Mut, Div, Panic {
    // 0 sections: 64 + 4 + 20 + 240 = 328 -> file_align(328) = 512
    let sz0 = pe_compute_headers_size(0)
    if sz0 != 512 { return 1 }
    // 3 sections: 328 + 3*40 = 448 -> file_align(448) = 512
    let sz3 = pe_compute_headers_size(3)
    if sz3 != 512 { return 2 }
    // 5 sections: 328 + 5*40 = 528 -> file_align(528) = 1024
    let sz5 = pe_compute_headers_size(5)
    if sz5 != 1024 { return 3 }
    0
}

// T62: Verify code size computation
fn test_pe_compute_code_size() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_add_text_section(w, 4096, 256, 512, 512)
    let sz = pe_compute_code_size(w)
    if sz != 512 { return 1 }
    // Add another text section
    w = pe_add_text_section(w, 8192, 128, 1024, 512)
    let sz2 = pe_compute_code_size(w)
    if sz2 != 1024 { return 2 }
    0
}

// T63: Verify image size computation
fn test_pe_compute_image_size() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_add_text_section(w, 4096, 256, 512, 512)
    let img = pe_compute_image_size(w)
    // 4096 + section_align(max(256, 512)) = 4096 + 4096 = 8192
    if img != 8192 { return 1 }
    0
}

// T64: Verify code base detection
fn test_pe_find_code_base() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_add_rdata_section(w, 4096, 64, 512, 512)
    w = pe_add_text_section(w, 8192, 256, 1024, 512)
    let base = pe_find_code_base(w)
    if base != 8192 { return 1 }
    0
}

// T65: Verify DLL marking
fn test_pe_mark_as_dll() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_mark_as_dll(w)
    if w.is_dll != 1 { return 1 }
    if (w.characteristics & PE_COFF_DLL) == 0 { return 2 }
    if w.image_base != PE_DLL_IMAGE_BASE { return 3 }
    0
}

// T66: Verify setting entry point
fn test_pe_set_entry_point() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_set_entry_point(w, 4096)
    if w.entry_point_rva != 4096 { return 1 }
    0
}

// T67: Verify setting subsystem
fn test_pe_set_subsystem() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_set_subsystem(w, PE_SUBSYSTEM_WINDOWS_GUI)
    if w.subsystem != PE_SUBSYSTEM_WINDOWS_GUI { return 1 }
    w = pe_set_subsystem(w, PE_SUBSYSTEM_NATIVE)
    if w.subsystem != PE_SUBSYSTEM_NATIVE { return 2 }
    0
}

// T68: Verify setting image base
fn test_pe_set_image_base() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_set_image_base(w, 0x10000000)
    if w.image_base != 268435456 { return 1 }
    0
}

// T69: Verify stack/heap sizes
fn test_pe_set_stack_heap() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_set_stack_sizes(w, 2097152, 8192)
    if w.stack_reserve != 2097152 { return 1 }
    if w.stack_commit != 8192 { return 2 }
    w = pe_set_heap_sizes(w, 4194304, 16384)
    if w.heap_reserve != 4194304 { return 3 }
    if w.heap_commit != 16384 { return 4 }
    0
}

// T70: Verify data directory setting
fn test_pe_set_data_directory() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_set_data_directory(w, PE_DIR_IMPORT, 8192, 100)
    if w.data_dirs[1].virtual_address != 8192 { return 1 }
    if w.data_dirs[1].size != 100 { return 2 }
    w = pe_set_data_directory(w, PE_DIR_EXPORT, 4096, 200)
    if w.data_dirs[0].virtual_address != 4096 { return 3 }
    if w.data_dirs[0].size != 200 { return 4 }
    0
}

// T71: Verify section characteristics lookup
fn test_pe_section_chars_for() -> i64 with IO, Mut, Div, Panic {
    let text_c = pe_section_chars_for(PE_SECT_TEXT)
    if (text_c & PE_SCN_CNT_CODE) == 0 { return 1 }
    if (text_c & PE_SCN_MEM_EXECUTE) == 0 { return 2 }

    let data_c = pe_section_chars_for(PE_SECT_DATA)
    if (data_c & PE_SCN_MEM_WRITE) == 0 { return 3 }

    let rdata_c = pe_section_chars_for(PE_SECT_RDATA)
    if (rdata_c & PE_SCN_MEM_WRITE) != 0 { return 4 }

    let reloc_c = pe_section_chars_for(PE_SECT_RELOC)
    if (reloc_c & PE_SCN_MEM_DISCARDABLE) == 0 { return 5 }
    0
}

// T72: Verify resource entry creation
fn test_pe_make_resource() -> i64 with IO, Mut, Div, Panic {
    let res = pe_make_resource(PE_RT_MANIFEST, 1, 0x5000, 256)
    if res.res_type != PE_RT_MANIFEST { return 1 }
    if res.name_id != 1 { return 2 }
    if res.data_rva != 0x5000 { return 3 }
    if res.data_size != 256 { return 4 }
    if res.codepage != 0 { return 5 }
    0
}

// T73: Verify adding resources
fn test_pe_add_resource() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_add_resource(w, pe_make_resource(PE_RT_ICON, 1, 0x6000, 128))
    w = pe_add_resource(w, pe_make_resource(PE_RT_VERSION, 1, 0x6100, 64))
    if w.resource_count != 2 { return 1 }
    if w.resources[0].res_type != PE_RT_ICON { return 2 }
    if w.resources[1].res_type != PE_RT_VERSION { return 3 }
    0
}

// T74: Verify find section utility
fn test_pe_find_section() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_add_text_section(w, 4096, 256, 512, 512)
    w = pe_add_data_section(w, 8192, 128, 1024, 512)
    w = pe_add_rdata_section(w, 12288, 64, 1536, 512)
    let text_idx = pe_find_section(w, PE_SECT_TEXT)
    if text_idx != 0 { return 1 }
    let data_idx = pe_find_section(w, PE_SECT_DATA)
    if data_idx != 1 { return 2 }
    let rdata_idx = pe_find_section(w, PE_SECT_RDATA)
    if rdata_idx != 2 { return 3 }
    let bss_idx = pe_find_section(w, PE_SECT_BSS)
    if bss_idx != (0 - 1) { return 4 }
    0
}

// T75: Verify count sections by type
fn test_pe_count_sections() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_add_text_section(w, 4096, 100, 512, 512)
    w = pe_add_text_section(w, 8192, 200, 1024, 512)
    w = pe_add_data_section(w, 12288, 50, 1536, 512)
    if pe_count_sections_by_type(w, PE_SECT_TEXT) != 2 { return 1 }
    if pe_count_sections_by_type(w, PE_SECT_DATA) != 1 { return 2 }
    if pe_count_sections_by_type(w, PE_SECT_BSS) != 0 { return 3 }
    0
}

// T76: Verify initialized data size computation
fn test_pe_compute_init_data() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_add_data_section(w, 4096, 100, 512, 512)
    w = pe_add_rdata_section(w, 8192, 64, 1024, 512)
    let total = pe_compute_init_data_size(w)
    if total != 1024 { return 1 }
    0
}

// T77: Verify uninitialized data size computation
fn test_pe_compute_uninit_data() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_add_bss_section(w, 4096, 2048)
    let total = pe_compute_uninit_data_size(w)
    if total != 2048 { return 1 }
