// Test functions
// ============================================================================

// T01: Verify DOS magic
fn test_pe_dos_magic() -> i64 with IO, Mut, Div, Panic {
    if PE_DOS_MAGIC != 23117 { return 1 }
    let dos = pe_dos_header_new(128)
    if dos.e_magic != PE_DOS_MAGIC { return 2 }
    if dos.e_lfanew != 128 { return 3 }
    0
}

// T02: Verify PE signature constant
fn test_pe_signature() -> i64 with IO, Mut, Div, Panic {
    if PE_SIGNATURE != 17744 { return 1 }
    // 'P' = 0x50, 'E' = 0x45, then two nulls: 0x00004550
    0
}

// T03: Verify machine type constants
fn test_pe_machine_types() -> i64 with IO, Mut, Div, Panic {
    if PE_MACHINE_AMD64 != 34404 { return 1 }
    if PE_MACHINE_ARM64 != 43620 { return 2 }
    if PE_MACHINE_I386 != 332 { return 3 }
    if PE_MACHINE_UNKNOWN != 0 { return 4 }
    0
}

// T04: Verify optional header magic
fn test_pe_opt_magic() -> i64 with IO, Mut, Div, Panic {
    if PE_OPT_MAGIC_PE32 != 267 { return 1 }
    if PE_OPT_MAGIC_PE32PLUS != 523 { return 2 }
    0
}

// T05: Verify subsystem constants
fn test_pe_subsystem_constants() -> i64 with IO, Mut, Div, Panic {
    if PE_SUBSYSTEM_WINDOWS_CUI != 3 { return 1 }
    if PE_SUBSYSTEM_WINDOWS_GUI != 2 { return 2 }
