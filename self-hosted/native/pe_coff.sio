// T94: Verify resolve imports adjusts IAT RVAs
fn test_pe_resolve_imports() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_add_import(w, pe_make_import_descriptor(100, 200, 0))
    w = pe_add_import(w, pe_make_import_descriptor(108, 300, 0))
    w = pe_resolve_imports(w, 0x3000)
    // First import's IAT should be at 0x3000
    if w.imports[0].first_thunk != 0x3000 { return 1 }
    // Second import's IAT should be at 0x3008
    if w.imports[1].first_thunk != 0x3008 { return 2 }
    0
}

// T95: Verify section name .pdata
fn test_pe_section_name_pdata() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_emit_section_name(w, PE_SECT_PDATA)
    if w.buf_len != 8 { return 1 }
    if pe_read_u8(w, 0) != 46 { return 2 }     // '.'
    if pe_read_u8(w, 1) != 112 { return 3 }    // 'p'
    if pe_read_u8(w, 2) != 100 { return 4 }    // 'd'
    0
}

