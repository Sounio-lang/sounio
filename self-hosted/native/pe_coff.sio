}

// T06: Verify section characteristics
fn test_pe_section_chars() -> i64 with IO, Mut, Div, Panic {
    if PE_SCN_CNT_CODE != 32 { return 1 }
    if PE_SCN_CNT_INITIALIZED_DATA != 64 { return 2 }
    if PE_SCN_CNT_UNINITIALIZED_DATA != 128 { return 3 }
    if PE_SCN_MEM_EXECUTE != 536870912 { return 4 }
    if PE_SCN_MEM_READ != 1073741824 { return 5 }
    if PE_SCN_MEM_WRITE != 2147483648 { return 6 }
    0
}

