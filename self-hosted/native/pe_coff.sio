// self-hosted::native::pe_coff — PE/COFF Windows binary format writer
//
// Generates PE32+ (64-bit) executables and DLLs for Windows (x86-64 and ARM64).
// Implements DOS stub, COFF header, optional header, section layout,
// import/export tables, relocation processing, resource handling,
// string table management, and final binary assembly.

// ============================================================================
// Constants — PE/COFF magic numbers, machine types, and flags
// ============================================================================

// DOS header magic
let PE_DOS_MAGIC: i64 = 23117                   // 0x5A4D ("MZ")

// PE signature
let PE_SIGNATURE: i64 = 17744                   // 0x00004550 ("PE\0\0")

// Machine types
let PE_MACHINE_UNKNOWN: i64 = 0
let PE_MACHINE_AMD64: i64 = 34404               // 0x8664
let PE_MACHINE_ARM64: i64 = 43620               // 0xAA64
let PE_MACHINE_I386: i64 = 332                  // 0x014C

// Optional header magic
let PE_OPT_MAGIC_PE32: i64 = 267                // 0x010B (PE32)
let PE_OPT_MAGIC_PE32PLUS: i64 = 523            // 0x020B (PE32+)

// Subsystem types
let PE_SUBSYSTEM_UNKNOWN: i64 = 0
let PE_SUBSYSTEM_NATIVE: i64 = 1
let PE_SUBSYSTEM_WINDOWS_GUI: i64 = 2
let PE_SUBSYSTEM_WINDOWS_CUI: i64 = 3           // Console application
let PE_SUBSYSTEM_EFI_APPLICATION: i64 = 10
let PE_SUBSYSTEM_EFI_BOOT_SERVICE: i64 = 11

// DLL characteristics flags
let PE_DLLCHAR_HIGH_ENTROPY_VA: i64 = 32        // 0x0020
let PE_DLLCHAR_DYNAMIC_BASE: i64 = 64           // 0x0040 (ASLR)
let PE_DLLCHAR_NX_COMPAT: i64 = 256             // 0x0100 (DEP)
let PE_DLLCHAR_NO_SEH: i64 = 1024               // 0x0400
let PE_DLLCHAR_TERMINAL_SERVER: i64 = 32768     // 0x8000

// COFF characteristics (file header flags)
let PE_COFF_RELOCS_STRIPPED: i64 = 1             // 0x0001
let PE_COFF_EXECUTABLE_IMAGE: i64 = 2           // 0x0002
let PE_COFF_LINE_NUMS_STRIPPED: i64 = 4          // 0x0004
let PE_COFF_LOCAL_SYMS_STRIPPED: i64 = 8         // 0x0008
let PE_COFF_LARGE_ADDRESS_AWARE: i64 = 32       // 0x0020
let PE_COFF_32BIT_MACHINE: i64 = 256            // 0x0100
let PE_COFF_DEBUG_STRIPPED: i64 = 512            // 0x0200
let PE_COFF_DLL: i64 = 8192                     // 0x2000

// Section characteristics (flags)
let PE_SCN_CNT_CODE: i64 = 32                   // 0x00000020
let PE_SCN_CNT_INITIALIZED_DATA: i64 = 64       // 0x00000040
let PE_SCN_CNT_UNINITIALIZED_DATA: i64 = 128    // 0x00000080
let PE_SCN_LNK_INFO: i64 = 512                  // 0x00000200
let PE_SCN_LNK_COMDAT: i64 = 4096               // 0x00001000
let PE_SCN_ALIGN_1BYTES: i64 = 1048576           // 0x00100000
let PE_SCN_ALIGN_2BYTES: i64 = 2097152           // 0x00200000
let PE_SCN_ALIGN_4BYTES: i64 = 3145728           // 0x00300000
let PE_SCN_ALIGN_8BYTES: i64 = 4194304           // 0x00400000
let PE_SCN_ALIGN_16BYTES: i64 = 5242880          // 0x00500000
let PE_SCN_ALIGN_32BYTES: i64 = 6291456          // 0x00600000
let PE_SCN_ALIGN_64BYTES: i64 = 7340032          // 0x00700000
let PE_SCN_MEM_DISCARDABLE: i64 = 33554432       // 0x02000000
let PE_SCN_MEM_NOT_CACHED: i64 = 67108864        // 0x04000000
let PE_SCN_MEM_NOT_PAGED: i64 = 134217728        // 0x08000000
let PE_SCN_MEM_SHARED: i64 = 268435456           // 0x10000000
let PE_SCN_MEM_EXECUTE: i64 = 536870912          // 0x20000000
let PE_SCN_MEM_READ: i64 = 1073741824            // 0x40000000
let PE_SCN_MEM_WRITE: i64 = 2147483648           // 0x80000000 (as i64)

// Relocation types (x86-64 / AMD64)
let PE_REL_AMD64_ABSOLUTE: i64 = 0
let PE_REL_AMD64_ADDR64: i64 = 1
let PE_REL_AMD64_ADDR32: i64 = 2
let PE_REL_AMD64_ADDR32NB: i64 = 3              // RVA
let PE_REL_AMD64_REL32: i64 = 4
let PE_REL_AMD64_REL32_1: i64 = 5
let PE_REL_AMD64_REL32_2: i64 = 6
let PE_REL_AMD64_REL32_3: i64 = 7
let PE_REL_AMD64_REL32_4: i64 = 8
let PE_REL_AMD64_REL32_5: i64 = 9
let PE_REL_AMD64_SECTION: i64 = 10
let PE_REL_AMD64_SECREL: i64 = 11

// Relocation types (ARM64)
let PE_REL_ARM64_ABSOLUTE: i64 = 0
let PE_REL_ARM64_ADDR32: i64 = 1
let PE_REL_ARM64_ADDR32NB: i64 = 2
let PE_REL_ARM64_BRANCH26: i64 = 3
let PE_REL_ARM64_PAGEBASE_REL21: i64 = 4
let PE_REL_ARM64_REL21: i64 = 5
let PE_REL_ARM64_PAGEOFFSET_12A: i64 = 6
let PE_REL_ARM64_PAGEOFFSET_12L: i64 = 7
let PE_REL_ARM64_SECREL: i64 = 8
let PE_REL_ARM64_SECREL_LOW12A: i64 = 9
let PE_REL_ARM64_SECREL_HIGH12A: i64 = 10
let PE_REL_ARM64_SECREL_LOW12L: i64 = 11
let PE_REL_ARM64_ADDR64: i64 = 14

// Base relocation types (for .reloc section)
let PE_BASE_RELOC_ABSOLUTE: i64 = 0             // padding / skip
let PE_BASE_RELOC_HIGH: i64 = 1
let PE_BASE_RELOC_LOW: i64 = 2
let PE_BASE_RELOC_HIGHLOW: i64 = 3              // 32-bit
let PE_BASE_RELOC_DIR64: i64 = 10               // 64-bit

// Data directory indices
let PE_DIR_EXPORT: i64 = 0
let PE_DIR_IMPORT: i64 = 1
let PE_DIR_RESOURCE: i64 = 2
let PE_DIR_EXCEPTION: i64 = 3
let PE_DIR_SECURITY: i64 = 4
let PE_DIR_BASERELOC: i64 = 5
let PE_DIR_DEBUG: i64 = 6
let PE_DIR_TLS: i64 = 9
let PE_DIR_LOAD_CONFIG: i64 = 10
let PE_DIR_BOUND_IMPORT: i64 = 11
let PE_DIR_IAT: i64 = 12
let PE_DIR_DELAY_IMPORT: i64 = 13
let PE_DIR_CLR_RUNTIME: i64 = 14

// Number of data directory entries in PE32+
let PE_NUM_DATA_DIRS: i64 = 16

// Fixed sizes
let PE_DOS_HEADER_SIZE: i64 = 64
let PE_SIGNATURE_SIZE: i64 = 4
let PE_COFF_HEADER_SIZE: i64 = 20
let PE_OPTIONAL_HEADER_SIZE_PE32PLUS: i64 = 240  // 112 + 16*8
let PE_SECTION_HEADER_SIZE: i64 = 40
let PE_RELOCATION_SIZE: i64 = 10                 // COFF reloc entry
let PE_SYMBOL_SIZE: i64 = 18                     // COFF symbol entry
let PE_IMPORT_DESC_SIZE: i64 = 20                // IMAGE_IMPORT_DESCRIPTOR
let PE_EXPORT_DIR_SIZE: i64 = 40                 // IMAGE_EXPORT_DIRECTORY
let PE_BASE_RELOC_BLOCK_HEADER_SIZE: i64 = 8     // page RVA + block size

// Default values
let PE_FILE_ALIGNMENT: i64 = 512                 // 0x200
let PE_SECTION_ALIGNMENT: i64 = 4096             // 0x1000
let PE_IMAGE_BASE: i64 = 4194304                 // 0x400000
let PE_DLL_IMAGE_BASE: i64 = 268435456           // 0x10000000
let PE_STACK_RESERVE: i64 = 1048576              // 0x100000 (1 MB)
let PE_STACK_COMMIT: i64 = 4096                  // 0x1000
let PE_HEAP_RESERVE: i64 = 1048576               // 0x100000
let PE_HEAP_COMMIT: i64 = 4096                   // 0x1000

// Page size
let PE_PAGE_SIZE: i64 = 4096

// Section name encodings (integer identifiers for dispatch)
let PE_SECT_TEXT: i64 = 1
let PE_SECT_DATA: i64 = 2
let PE_SECT_RDATA: i64 = 3
let PE_SECT_BSS: i64 = 4
let PE_SECT_IDATA: i64 = 5
let PE_SECT_EDATA: i64 = 6
let PE_SECT_RSRC: i64 = 7
let PE_SECT_RELOC: i64 = 8
let PE_SECT_PDATA: i64 = 9
let PE_SECT_DEBUG: i64 = 10

// Symbol storage classes
let PE_SYM_CLASS_EXTERNAL: i64 = 2
let PE_SYM_CLASS_STATIC: i64 = 3
let PE_SYM_CLASS_FUNCTION: i64 = 101
let PE_SYM_CLASS_FILE: i64 = 103
let PE_SYM_CLASS_SECTION: i64 = 104

// Symbol type
let PE_SYM_TYPE_NULL: i64 = 0
let PE_SYM_TYPE_FUNCTION: i64 = 32               // 0x20

// Resource types
let PE_RT_CURSOR: i64 = 1
let PE_RT_BITMAP: i64 = 2
let PE_RT_ICON: i64 = 3
let PE_RT_MENU: i64 = 4
let PE_RT_DIALOG: i64 = 5
let PE_RT_STRING: i64 = 6
let PE_RT_ACCELERATOR: i64 = 9
let PE_RT_VERSION: i64 = 16
let PE_RT_MANIFEST: i64 = 24

// ============================================================================
// Structs — PE/COFF data structures
// ============================================================================

// DOS header (64 bytes)
struct PeDosHeader {
    e_magic: i64,             // "MZ"
    e_cblp: i64,
    e_cp: i64,
    e_crlc: i64,
    e_cparhdr: i64,
    e_minalloc: i64,
    e_maxalloc: i64,
    e_ss: i64,
    e_sp: i64,
    e_csum: i64,
    e_ip: i64,
    e_cs: i64,
    e_lfarlc: i64,
    e_ovno: i64,
    e_lfanew: i64,            // offset to PE signature
}

// COFF file header (20 bytes)
struct PeCoffHeader {
    machine: i64,
    number_of_sections: i64,
    time_date_stamp: i64,
    pointer_to_symbol_table: i64,
    number_of_symbols: i64,
    size_of_optional_header: i64,
    characteristics: i64,
}

// PE32+ optional header
struct PeOptionalHeader {
    magic: i64,                     // PE32+ = 0x020B
    major_linker_version: i64,
    minor_linker_version: i64,
    size_of_code: i64,
    size_of_initialized_data: i64,
    size_of_uninitialized_data: i64,
    address_of_entry_point: i64,
    base_of_code: i64,
    image_base: i64,
    section_alignment: i64,
    file_alignment: i64,
    major_os_version: i64,
    minor_os_version: i64,
    major_image_version: i64,
    minor_image_version: i64,
    major_subsystem_version: i64,
    minor_subsystem_version: i64,
    win32_version_value: i64,
    size_of_image: i64,
    size_of_headers: i64,
    checksum: i64,
    subsystem: i64,
    dll_characteristics: i64,
    size_of_stack_reserve: i64,
    size_of_stack_commit: i64,
    size_of_heap_reserve: i64,
    size_of_heap_commit: i64,
    loader_flags: i64,
    number_of_rva_and_sizes: i64,
}

// Section header (40 bytes)
struct PeSectionHeader {
    name_id: i64,               // encoded section name identifier
    virtual_size: i64,
    virtual_address: i64,
    size_of_raw_data: i64,
    pointer_to_raw_data: i64,
    pointer_to_relocations: i64,
    pointer_to_linenumbers: i64,
    number_of_relocations: i64,
    number_of_linenumbers: i64,
    characteristics: i64,
}

// COFF relocation entry (10 bytes)
struct PeRelocation {
    virtual_address: i64,       // offset within section
    symbol_table_index: i64,
    rel_type: i64,              // relocation type (arch-dependent)
}

// COFF symbol entry (18 bytes)
struct PeSymbol {
    name_offset: i64,           // offset into string table (if > 8 chars)
    name_short: i64,            // short name packed value (up to 8 chars)
    value: i64,                 // value (depends on storage class)
    section_number: i64,        // 1-based section index, 0=external
    sym_type: i64,              // symbol type
    storage_class: i64,
    number_of_aux_symbols: i64,
}

// Import descriptor (20 bytes)
struct PeImportDescriptor {
    original_first_thunk: i64,  // RVA to INT (Import Name Table)
    time_date_stamp: i64,
    forwarder_chain: i64,
    name_rva: i64,              // RVA to DLL name string
    first_thunk: i64,           // RVA to IAT (Import Address Table)
}

// Export directory (40 bytes)
struct PeExportDirectory {
    export_flags: i64,
    time_date_stamp: i64,
    major_version: i64,
    minor_version: i64,
    name_rva: i64,              // RVA to DLL name
    ordinal_base: i64,
    number_of_functions: i64,
    number_of_names: i64,
    address_of_functions: i64,  // RVA to export address table
    address_of_names: i64,      // RVA to name pointer table
    address_of_name_ordinals: i64, // RVA to ordinal table
}

// Data directory entry (8 bytes each)
struct PeDataDirectory {
    virtual_address: i64,
    size: i64,
}

// Base relocation entry (within .reloc section)
struct PeBaseRelocEntry {
    entry_type: i64,            // top 4 bits
    offset: i64,                // bottom 12 bits
}

// Resource directory entry
struct PeResourceEntry {
    res_type: i64,
    name_id: i64,
    data_rva: i64,
    data_size: i64,
    codepage: i64,
}

// String table for COFF symbols
struct PeStringTable {
    bytes: [i8; 65536],
    len: i64,
}

// ============================================================================
// Main PE writer context
// ============================================================================

struct PeWriter {
    buf: [i8; 131072],        // output byte buffer (128KB)
    buf_len: i64,
    // Section headers (max 16)
    sections: [PeSectionHeader; 16],
    section_count: i64,
    // Section raw data storage (indices into section data arrays)
    section_data_offsets: [i64; 16],
    section_data_sizes: [i64; 16],
    // Symbols (max 2048)
    symbols: [PeSymbol; 2048],
    symbol_count: i64,
    // Relocations (max 4096)
    relocs: [PeRelocation; 4096],
    reloc_count: i64,
    // Import descriptors (max 64)
    imports: [PeImportDescriptor; 64],
    import_count: i64,
    // Export directory
    exports: PeExportDirectory,
    has_exports: i64,
    // Data directories
    data_dirs: [PeDataDirectory; 16],
    // String table
    strtab: PeStringTable,
    // Base relocations (max 4096)
    base_relocs: [PeBaseRelocEntry; 4096],
    base_reloc_count: i64,
    // Resource entries (max 128)
    resources: [PeResourceEntry; 128],
    resource_count: i64,
    // Configuration
    machine: i64,
    characteristics: i64,
    subsystem: i64,
    dll_characteristics: i64,
    image_base: i64,
    section_alignment: i64,
    file_alignment: i64,
    entry_point_rva: i64,
    is_dll: i64,
    // Stack / heap sizes
    stack_reserve: i64,
    stack_commit: i64,
    heap_reserve: i64,
    heap_commit: i64,
    // Layout tracking
    size_of_code: i64,
    size_of_init_data: i64,
    size_of_uninit_data: i64,
    base_of_code: i64,
    size_of_headers: i64,
    size_of_image: i64,
}

// ============================================================================
// Constructors
// ============================================================================

fn pe_empty_section() -> PeSectionHeader {
    PeSectionHeader {
        name_id: 0,
        virtual_size: 0,
        virtual_address: 0,
        size_of_raw_data: 0,
        pointer_to_raw_data: 0,
        pointer_to_relocations: 0,
        pointer_to_linenumbers: 0,
        number_of_relocations: 0,
        number_of_linenumbers: 0,
        characteristics: 0,
    }
}

fn pe_empty_symbol() -> PeSymbol {
    PeSymbol {
        name_offset: 0,
        name_short: 0,
        value: 0,
        section_number: 0,
        sym_type: PE_SYM_TYPE_NULL,
        storage_class: PE_SYM_CLASS_EXTERNAL,
        number_of_aux_symbols: 0,
    }
}

fn pe_empty_reloc() -> PeRelocation {
    PeRelocation {
        virtual_address: 0,
        symbol_table_index: 0,
        rel_type: PE_REL_AMD64_ABSOLUTE,
    }
}

fn pe_empty_import() -> PeImportDescriptor {
    PeImportDescriptor {
        original_first_thunk: 0,
        time_date_stamp: 0,
        forwarder_chain: 0,
        name_rva: 0,
        first_thunk: 0,
    }
}

fn pe_empty_export() -> PeExportDirectory {
    PeExportDirectory {
        export_flags: 0,
        time_date_stamp: 0,
        major_version: 0,
        minor_version: 0,
        name_rva: 0,
        ordinal_base: 1,
        number_of_functions: 0,
        number_of_names: 0,
        address_of_functions: 0,
        address_of_names: 0,
        address_of_name_ordinals: 0,
    }
}

fn pe_empty_data_dir() -> PeDataDirectory {
    PeDataDirectory {
        virtual_address: 0,
        size: 0,
    }
}

fn pe_empty_base_reloc() -> PeBaseRelocEntry {
    PeBaseRelocEntry {
        entry_type: PE_BASE_RELOC_ABSOLUTE,
        offset: 0,
    }
}

fn pe_empty_resource() -> PeResourceEntry {
    PeResourceEntry {
        res_type: 0,
        name_id: 0,
        data_rva: 0,
        data_size: 0,
        codepage: 0,
    }
}

fn pe_strtab_new() -> PeStringTable {
    PeStringTable {
        bytes: [0; 65536],
        len: 0,
    }
}

fn pe_dos_header_new(lfanew: i64) -> PeDosHeader {
    PeDosHeader {
        e_magic: PE_DOS_MAGIC,
        e_cblp: 144,
        e_cp: 3,
        e_crlc: 0,
        e_cparhdr: 4,
        e_minalloc: 0,
        e_maxalloc: 65535,
        e_ss: 0,
        e_sp: 184,
        e_csum: 0,
        e_ip: 0,
        e_cs: 0,
        e_lfarlc: 64,
        e_ovno: 0,
        e_lfanew: lfanew,
    }
}

fn pe_coff_header_new(machine: i64, nsections: i64, characteristics: i64) -> PeCoffHeader {
    PeCoffHeader {
        machine: machine,
        number_of_sections: nsections,
        time_date_stamp: 0,
        pointer_to_symbol_table: 0,
        number_of_symbols: 0,
        size_of_optional_header: PE_OPTIONAL_HEADER_SIZE_PE32PLUS,
        characteristics: characteristics,
    }
}

fn pe_optional_header_new() -> PeOptionalHeader {
    PeOptionalHeader {
        magic: PE_OPT_MAGIC_PE32PLUS,
        major_linker_version: 14,
        minor_linker_version: 0,
        size_of_code: 0,
        size_of_initialized_data: 0,
        size_of_uninitialized_data: 0,
        address_of_entry_point: 0,
        base_of_code: 0,
        image_base: PE_IMAGE_BASE,
        section_alignment: PE_SECTION_ALIGNMENT,
        file_alignment: PE_FILE_ALIGNMENT,
        major_os_version: 6,
        minor_os_version: 0,
        major_image_version: 0,
        minor_image_version: 0,
        major_subsystem_version: 6,
        minor_subsystem_version: 0,
        win32_version_value: 0,
        size_of_image: 0,
        size_of_headers: 0,
        checksum: 0,
        subsystem: PE_SUBSYSTEM_WINDOWS_CUI,
        dll_characteristics: PE_DLLCHAR_DYNAMIC_BASE + PE_DLLCHAR_NX_COMPAT + PE_DLLCHAR_HIGH_ENTROPY_VA + PE_DLLCHAR_TERMINAL_SERVER,
        size_of_stack_reserve: PE_STACK_RESERVE,
        size_of_stack_commit: PE_STACK_COMMIT,
        size_of_heap_reserve: PE_HEAP_RESERVE,
        size_of_heap_commit: PE_HEAP_COMMIT,
        loader_flags: 0,
        number_of_rva_and_sizes: PE_NUM_DATA_DIRS,
    }
}

fn pe_writer_new() -> PeWriter {
    PeWriter {
        buf: [0; 131072],
        buf_len: 0,
        sections: [pe_empty_section(); 16],
        section_count: 0,
        section_data_offsets: [0; 16],
        section_data_sizes: [0; 16],
        symbols: [pe_empty_symbol(); 2048],
        symbol_count: 0,
        relocs: [pe_empty_reloc(); 4096],
        reloc_count: 0,
        imports: [pe_empty_import(); 64],
        import_count: 0,
        exports: pe_empty_export(),
        has_exports: 0,
        data_dirs: [pe_empty_data_dir(); 16],
        strtab: pe_strtab_new(),
        base_relocs: [pe_empty_base_reloc(); 4096],
        base_reloc_count: 0,
        resources: [pe_empty_resource(); 128],
        resource_count: 0,
        machine: PE_MACHINE_AMD64,
        characteristics: PE_COFF_EXECUTABLE_IMAGE + PE_COFF_LARGE_ADDRESS_AWARE,
        subsystem: PE_SUBSYSTEM_WINDOWS_CUI,
        dll_characteristics: PE_DLLCHAR_DYNAMIC_BASE + PE_DLLCHAR_NX_COMPAT + PE_DLLCHAR_HIGH_ENTROPY_VA + PE_DLLCHAR_TERMINAL_SERVER,
        image_base: PE_IMAGE_BASE,
        section_alignment: PE_SECTION_ALIGNMENT,
        file_alignment: PE_FILE_ALIGNMENT,
        entry_point_rva: 0,
        is_dll: 0,
        stack_reserve: PE_STACK_RESERVE,
        stack_commit: PE_STACK_COMMIT,
        heap_reserve: PE_HEAP_RESERVE,
        heap_commit: PE_HEAP_COMMIT,
        size_of_code: 0,
        size_of_init_data: 0,
        size_of_uninit_data: 0,
        base_of_code: 0,
        size_of_headers: 0,
        size_of_image: 0,
    }
}

fn pe_writer_new_arm64() -> PeWriter with Mut, Panic, Div {
    var w = pe_writer_new()
    w.machine = PE_MACHINE_ARM64
    w
}

fn pe_writer_new_dll() -> PeWriter with Mut, Panic, Div {
    var w = pe_writer_new()
    w.is_dll = 1
    w.characteristics = PE_COFF_EXECUTABLE_IMAGE + PE_COFF_LARGE_ADDRESS_AWARE + PE_COFF_DLL
    w.image_base = PE_DLL_IMAGE_BASE
    w
}

fn pe_writer_new_object() -> PeWriter with Mut, Panic, Div {
    var w = pe_writer_new()
    w.characteristics = 0
    w.image_base = 0
    w
}

// ============================================================================
// Low-level byte emission helpers
// ============================================================================

fn pe_low8(x: i64) -> i64 with Mut, Panic, Div {
    var n = x % 256
    if n < 0 { n = n + 256 }
    n
}

fn pe_emit_byte(w: PeWriter, b: i64) -> PeWriter with Mut, Panic, Div {
    var out = w
    if out.buf_len >= 0 && out.buf_len < 131072 {
        out.buf[out.buf_len as usize] = pe_low8(b) as i8
        out.buf_len = out.buf_len + 1
    }
    out
}

fn pe_emit_u16(w: PeWriter, val: i64) -> PeWriter with Mut, Panic, Div {
    var out = w
    out = pe_emit_byte(out, pe_low8(val))
    out = pe_emit_byte(out, pe_low8(val >> 8))
    out
}

fn pe_emit_u32(w: PeWriter, val: i64) -> PeWriter with Mut, Panic, Div {
    var out = w
    out = pe_emit_byte(out, pe_low8(val))
    out = pe_emit_byte(out, pe_low8(val >> 8))
    out = pe_emit_byte(out, pe_low8(val >> 16))
    out = pe_emit_byte(out, pe_low8(val >> 24))
    out
}

fn pe_emit_u64(w: PeWriter, val: i64) -> PeWriter with Mut, Panic, Div {
    var out = w
    out = pe_emit_u32(out, val)
    out = pe_emit_u32(out, val >> 32)
    out
}

fn pe_emit_zeros(w: PeWriter, count: i64) -> PeWriter with Mut, Panic, Div {
    var out = w
    var i = 0
    while i < count {
        out = pe_emit_byte(out, 0)
        i = i + 1
    }
    out
}

fn pe_emit_pad_to(w: PeWriter, alignment: i64) -> PeWriter with Mut, Panic, Div {
    var out = w
    let remainder = out.buf_len % alignment
    if remainder != 0 {
        let pad = alignment - remainder
        out = pe_emit_zeros(out, pad)
    }
    out
}

// Patch a u16 at a specific offset
fn pe_patch_u16(w: PeWriter, offset: i64, val: i64) -> PeWriter with Mut, Panic, Div {
    var out = w
    if offset >= 0 && offset + 2 <= out.buf_len {
        out.buf[offset as usize] = pe_low8(val) as i8
        out.buf[(offset + 1) as usize] = pe_low8(val >> 8) as i8
    }
    out
}

// Patch a u32 at a specific offset in the buffer
fn pe_patch_u32(w: PeWriter, offset: i64, val: i64) -> PeWriter with Mut, Panic, Div {
    var out = w
    if offset >= 0 && offset + 4 <= out.buf_len {
        out.buf[offset as usize] = pe_low8(val) as i8
        out.buf[(offset + 1) as usize] = pe_low8(val >> 8) as i8
        out.buf[(offset + 2) as usize] = pe_low8(val >> 16) as i8
        out.buf[(offset + 3) as usize] = pe_low8(val >> 24) as i8
    }
    out
}

// Patch a u64 at a specific offset
fn pe_patch_u64(w: PeWriter, offset: i64, val: i64) -> PeWriter with Mut, Panic, Div {
    var out = w
    out = pe_patch_u32(out, offset, val)
    out = pe_patch_u32(out, offset + 4, val >> 32)
    out
}

// Read a byte from the buffer (unsigned)
fn pe_read_u8(w: PeWriter, offset: i64) -> i64 with Mut, Panic, Div {
    if offset < 0 { return 0 }
    if offset >= w.buf_len { return 0 }
    let val = w.buf[offset as usize] as i64
    if val < 0 { val + 256 } else { val }
}

// Read a u16 little-endian
fn pe_read_u16_le(w: PeWriter, offset: i64) -> i64 with Mut, Panic, Div {
    let b0 = pe_read_u8(w, offset)
    let b1 = pe_read_u8(w, offset + 1)
    b0 + b1 * 256
}

// Read a u32 little-endian
fn pe_read_u32_le(w: PeWriter, offset: i64) -> i64 with Mut, Panic, Div {
    let b0 = pe_read_u8(w, offset)
    let b1 = pe_read_u8(w, offset + 1)
    let b2 = pe_read_u8(w, offset + 2)
    let b3 = pe_read_u8(w, offset + 3)
    b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
}

// Read a u64 little-endian
fn pe_read_u64_le(w: PeWriter, offset: i64) -> i64 with Mut, Panic, Div {
    let lo = pe_read_u32_le(w, offset)
    let hi = pe_read_u32_le(w, offset + 4)
    lo + hi * 4294967296
}

// ============================================================================
// Alignment and page utilities
// ============================================================================

fn pe_align_to(val: i64, alignment: i64) -> i64 with Mut, Panic {
    var aligned = val
    if alignment > 0 {
        let remainder = val % alignment
        if remainder != 0 {
            aligned = val + (alignment - remainder)
        }
    }
    aligned
}

fn pe_file_align(val: i64) -> i64 with Mut, Panic {
    pe_align_to(val, PE_FILE_ALIGNMENT)
}

fn pe_section_align(val: i64) -> i64 with Mut, Panic {
    pe_align_to(val, PE_SECTION_ALIGNMENT)
}

fn pe_page_align(val: i64) -> i64 with Mut, Panic {
    pe_align_to(val, PE_PAGE_SIZE)
}

// ============================================================================
// String table operations
// ============================================================================

// Initialize string table: first 4 bytes are the table size (u32)
fn pe_strtab_init() -> PeStringTable with Mut, Panic, Div {
    var st = pe_strtab_new()
    // Reserve first 4 bytes for size field
    st.bytes[0] = 0
    st.bytes[1] = 0
    st.bytes[2] = 0
    st.bytes[3] = 0
    st.len = 4
    st
}

// Add a string to the string table, return its offset
fn pe_add_string(st: PeStringTable, name: [i8; 128], name_len: i64) -> PeStringTable with Mut, Panic, Div {
    var t = st
    let offset = t.len
    var i = 0
    while i < name_len && t.len < 65535 {
        t.bytes[t.len as usize] = name[i as usize]
        t.len = t.len + 1
        i = i + 1
    }
    // Null terminator
    if t.len < 65536 {
        t.bytes[t.len as usize] = 0
        t.len = t.len + 1
    }
    t
}

// Get offset of the last added string
fn pe_strtab_last_offset(st: PeStringTable, name_len: i64) -> i64 {
    st.len - name_len - 1
}

// Search for a string in the table, return offset or -1
fn pe_strtab_find(st: PeStringTable, name: [i8; 128], name_len: i64) -> i64 with Mut, Panic, Div {
    var offset = 4
    while offset < st.len {
        var matches = 1
        var j = 0
        while j < name_len {
            let idx = offset + j
            if idx >= st.len {
                matches = 0
                j = name_len
            } else if st.bytes[idx as usize] != name[j as usize] {
                matches = 0
                j = name_len
            } else {
                j = j + 1
            }
        }
        if matches == 1 {
            let term_idx = offset + name_len
            if term_idx < st.len {
                if st.bytes[term_idx as usize] != 0 {
                    matches = 0
                }
            } else {
                matches = 0
            }
        }
        if matches == 1 {
            return offset
        }
        // Advance past current string
        var k = offset
        while k < st.len && st.bytes[k as usize] != 0 {
            k = k + 1
        }
        offset = k + 1
    }
    0 - 1
}

// Build the final string table bytes (patches the size u32 at offset 0)
fn pe_build_string_table(st: PeStringTable) -> PeStringTable with Mut, Panic, Div {
    var t = st
    // Patch size at offset 0 (4-byte LE)
    t.bytes[0] = pe_low8(t.len) as i8
    t.bytes[1] = pe_low8(t.len >> 8) as i8
    t.bytes[2] = pe_low8(t.len >> 16) as i8
    t.bytes[3] = pe_low8(t.len >> 24) as i8
    t
}

// ============================================================================
// Section management
// ============================================================================

fn pe_add_section(w: PeWriter, sec: PeSectionHeader) -> PeWriter with Mut, Panic, Div {
    var out = w
    if out.section_count < 16 {
        out.sections[out.section_count as usize] = sec
        out.section_count = out.section_count + 1
    }
    out
}

fn pe_add_text_section(w: PeWriter, vaddr: i64, vsize: i64, raw_offset: i64, raw_size: i64) -> PeWriter with Mut, Panic, Div {
    let sec = PeSectionHeader {
        name_id: PE_SECT_TEXT,
        virtual_size: vsize,
        virtual_address: vaddr,
        size_of_raw_data: raw_size,
        pointer_to_raw_data: raw_offset,
        pointer_to_relocations: 0,
        pointer_to_linenumbers: 0,
        number_of_relocations: 0,
        number_of_linenumbers: 0,
        characteristics: PE_SCN_CNT_CODE + PE_SCN_MEM_EXECUTE + PE_SCN_MEM_READ,
    }
    pe_add_section(w, sec)
}

fn pe_add_data_section(w: PeWriter, vaddr: i64, vsize: i64, raw_offset: i64, raw_size: i64) -> PeWriter with Mut, Panic, Div {
    let sec = PeSectionHeader {
        name_id: PE_SECT_DATA,
        virtual_size: vsize,
        virtual_address: vaddr,
        size_of_raw_data: raw_size,
        pointer_to_raw_data: raw_offset,
        pointer_to_relocations: 0,
        pointer_to_linenumbers: 0,
        number_of_relocations: 0,
        number_of_linenumbers: 0,
        characteristics: PE_SCN_CNT_INITIALIZED_DATA + PE_SCN_MEM_READ + PE_SCN_MEM_WRITE,
    }
    pe_add_section(w, sec)
}

fn pe_add_rdata_section(w: PeWriter, vaddr: i64, vsize: i64, raw_offset: i64, raw_size: i64) -> PeWriter with Mut, Panic, Div {
    let sec = PeSectionHeader {
        name_id: PE_SECT_RDATA,
        virtual_size: vsize,
        virtual_address: vaddr,
        size_of_raw_data: raw_size,
        pointer_to_raw_data: raw_offset,
        pointer_to_relocations: 0,
        pointer_to_linenumbers: 0,
        number_of_relocations: 0,
        number_of_linenumbers: 0,
        characteristics: PE_SCN_CNT_INITIALIZED_DATA + PE_SCN_MEM_READ,
    }
    pe_add_section(w, sec)
}

fn pe_add_bss_section(w: PeWriter, vaddr: i64, vsize: i64) -> PeWriter with Mut, Panic, Div {
    let sec = PeSectionHeader {
        name_id: PE_SECT_BSS,
        virtual_size: vsize,
        virtual_address: vaddr,
        size_of_raw_data: 0,
        pointer_to_raw_data: 0,
        pointer_to_relocations: 0,
        pointer_to_linenumbers: 0,
        number_of_relocations: 0,
        number_of_linenumbers: 0,
        characteristics: PE_SCN_CNT_UNINITIALIZED_DATA + PE_SCN_MEM_READ + PE_SCN_MEM_WRITE,
    }
    pe_add_section(w, sec)
}

fn pe_add_idata_section(w: PeWriter, vaddr: i64, vsize: i64, raw_offset: i64, raw_size: i64) -> PeWriter with Mut, Panic, Div {
    let sec = PeSectionHeader {
        name_id: PE_SECT_IDATA,
        virtual_size: vsize,
        virtual_address: vaddr,
        size_of_raw_data: raw_size,
        pointer_to_raw_data: raw_offset,
