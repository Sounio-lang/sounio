// T78: Verify DOS stub emission
fn test_pe_dos_stub_emission() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    let dos = pe_dos_header_new(128)
    w = pe_write_dos_stub(w, dos)
    // Should be 64 bytes
    if w.buf_len != 64 { return 1 }
    // Check "MZ" magic
    if pe_read_u8(w, 0) != 0x4D { return 2 }
    if pe_read_u8(w, 1) != 0x5A { return 3 }
    // Check e_lfanew at offset 60
    if pe_read_u32_le(w, 60) != 128 { return 4 }
    0
}

// T79: Verify DOS program stub has valid content
fn test_pe_dos_program() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_write_dos_program(w)
    // Should emit some bytes (instruction + message)
    if w.buf_len < 40 { return 1 }
    // First byte should be 0x0E (push cs)
    if pe_read_u8(w, 0) != 0x0E { return 2 }
    // Second byte should be 0x1F (pop ds)
    if pe_read_u8(w, 1) != 0x1F { return 3 }
    0
}

// T80: Verify full headers with section headers
fn test_pe_full_headers() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    // Write DOS header
    let dos = pe_dos_header_new(PE_DOS_HEADER_SIZE)
    w = pe_write_dos_stub(w, dos)
    // Write COFF header
    let coff = pe_coff_header_new(PE_MACHINE_AMD64, 1, PE_COFF_EXECUTABLE_IMAGE + PE_COFF_LARGE_ADDRESS_AWARE)
    w = pe_write_coff_header(w, coff)
    // Write optional header
    let opt = pe_optional_header_new()
    let dirs = [pe_empty_data_dir(); 16]
    w = pe_write_optional_header(w, opt, dirs)
    // Write one section header
    let sec = PeSectionHeader {
        name_id: PE_SECT_TEXT,
        virtual_size: 100,
        virtual_address: 4096,
        size_of_raw_data: 512,
        pointer_to_raw_data: 512,
        pointer_to_relocations: 0,
        pointer_to_linenumbers: 0,
        number_of_relocations: 0,
        number_of_linenumbers: 0,
        characteristics: PE_SCN_CNT_CODE + PE_SCN_MEM_EXECUTE + PE_SCN_MEM_READ,
    }
    w = pe_write_section_header(w, sec)
    // Total: 64 + 24 + 240 + 40 = 368
    let expected = PE_DOS_HEADER_SIZE + PE_SIGNATURE_SIZE + PE_COFF_HEADER_SIZE + PE_OPTIONAL_HEADER_SIZE_PE32PLUS + PE_SECTION_HEADER_SIZE
    if w.buf_len != expected { return 1 }
    if w.buf_len != 368 { return 2 }
    // Verify DOS magic at start
    if pe_read_u16_le(w, 0) != PE_DOS_MAGIC { return 3 }
    // Verify PE signature at offset 64
    if pe_read_u32_le(w, 64) != PE_SIGNATURE { return 4 }
    // Verify machine at offset 68
    if pe_read_u16_le(w, 68) != PE_MACHINE_AMD64 { return 5 }
    // Verify optional header magic at offset 88 (64+24)
    if pe_read_u16_le(w, 88) != PE_OPT_MAGIC_PE32PLUS { return 6 }
    0
}

// T81: Verify set machine
fn test_pe_set_machine() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_set_machine(w, PE_MACHINE_ARM64)
    if w.machine != PE_MACHINE_ARM64 { return 1 }
    w = pe_set_machine(w, PE_MACHINE_I386)
    if w.machine != PE_MACHINE_I386 { return 2 }
    0
}

// T82: Verify base reloc addition
fn test_pe_add_base_reloc() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_add_base_reloc(w, PE_BASE_RELOC_DIR64, 256)
    if w.base_reloc_count != 1 { return 1 }
    if w.base_relocs[0].entry_type != PE_BASE_RELOC_DIR64 { return 2 }
    if w.base_relocs[0].offset != 256 { return 3 }
    0
}

// T83: Verify hint/name emission
fn test_pe_emit_hint_name() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    var name: [i8; 128] = [0; 128]
    name[0] = 112   // 'p'
    name[1] = 117   // 'u'
    name[2] = 116   // 't'
    name[3] = 115   // 's'
    w = pe_emit_hint_name(w, 42, name, 4)
    // 2 (hint) + 4 (name) + 1 (null) = 7, padded to 8
    if w.buf_len != 8 { return 1 }
    // hint
    if pe_read_u16_le(w, 0) != 42 { return 2 }
    // first char
    if pe_read_u8(w, 2) != 112 { return 3 }
    // null terminator
    if pe_read_u8(w, 6) != 0 { return 4 }
    0
}

// T84: Verify emit/read roundtrip
fn test_pe_emit_read_roundtrip() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_emit_u32(w, 305419896)  // 0x12345678
    if pe_read_u32_le(w, 0) != 305419896 { return 1 }
    w = pe_emit_u64(w, 1311768467294899695)  // 0x123456789ABCDEF
    // Verify we can read it back (only test lower 32 bits since i64 arithmetic)
    let lo = pe_read_u32_le(w, 4)
    if lo != 2596069103 { return 2 }  // 0x9ABCDEF0... wait, this is tricky
    0
}

// T85: Verify section name .idata
fn test_pe_section_name_idata() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_emit_section_name(w, PE_SECT_IDATA)
    if w.buf_len != 8 { return 1 }
    if pe_read_u8(w, 0) != 46 { return 2 }     // '.'
    if pe_read_u8(w, 1) != 105 { return 3 }    // 'i'
    if pe_read_u8(w, 2) != 100 { return 4 }    // 'd'
    if pe_read_u8(w, 3) != 97 { return 5 }     // 'a'
    if pe_read_u8(w, 4) != 116 { return 6 }    // 't'
    if pe_read_u8(w, 5) != 97 { return 7 }     // 'a'
    0
}

// T86: Verify resource constants
fn test_pe_resource_constants() -> i64 with IO, Mut, Div, Panic {
    if PE_RT_MANIFEST != 24 { return 1 }
    if PE_RT_VERSION != 16 { return 2 }
    if PE_RT_ICON != 3 { return 3 }
    if PE_RT_STRING != 6 { return 4 }
    0
}

// T87: Verify adding idata/edata/rsrc/reloc sections
fn test_pe_special_sections() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_add_idata_section(w, 4096, 100, 512, 512)
    w = pe_add_edata_section(w, 8192, 200, 1024, 512)
    w = pe_add_rsrc_section(w, 12288, 300, 1536, 512)
    w = pe_add_reloc_section(w, 16384, 400, 2048, 512)
    if w.section_count != 4 { return 1 }
    if w.sections[0].name_id != PE_SECT_IDATA { return 2 }
    if w.sections[1].name_id != PE_SECT_EDATA { return 3 }
    if w.sections[2].name_id != PE_SECT_RSRC { return 4 }
    if w.sections[3].name_id != PE_SECT_RELOC { return 5 }
    // Verify reloc section has discardable flag
    if (w.sections[3].characteristics & PE_SCN_MEM_DISCARDABLE) == 0 { return 6 }
    0
}

// T88: Verify section header roundtrip (write then read)
fn test_pe_section_header_roundtrip() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    w = pe_add_text_section(w, 4096, 500, 512, 512)
    w = pe_write_section_header(w, w.sections[0])
    // Read back VirtualSize
    if pe_read_u32_le(w, 8) != 500 { return 1 }
    // Read back VirtualAddress
    if pe_read_u32_le(w, 12) != 4096 { return 2 }
    // Read back PointerToRawData
    if pe_read_u32_le(w, 20) != 512 { return 3 }
    0
}

// T89: Verify COFF header with ARM64
fn test_pe_coff_header_arm64() -> i64 with IO, Mut, Div, Panic {
    var w = pe_writer_new()
    let coff = pe_coff_header_new(PE_MACHINE_ARM64, 2, PE_COFF_EXECUTABLE_IMAGE)
    w = pe_write_coff_header(w, coff)
    // Machine at offset 4
    if pe_read_u16_le(w, 4) != PE_MACHINE_ARM64 { return 1 }
    // Number of sections at offset 6
    if pe_read_u16_le(w, 6) != 2 { return 2 }
    0
}

