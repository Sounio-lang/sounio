// self-hosted::native::test_phase0 — Phase 0 comprehensive test
//
// Aggregates all Phase 0 modules to test compilation and basic functionality

// ============================================================================
// From encode.sio
// ============================================================================

struct Ph0CodeBuffer {
    bytes: [i8; 65536],
    len: i64,
}

fn ph0_code_buffer_new() -> Ph0CodeBuffer {
    Ph0CodeBuffer { bytes: [0; 65536], len: 0 }
}

fn ph0_low8(x: i64) -> i64 with Mut, Panic, Div {
    var n = x % 256
    if n < 0 { n = n + 256 }
    n
}

fn ph0_emit_byte(buf: Ph0CodeBuffer, b: i64) -> Ph0CodeBuffer with Mut, Panic, Div {
    var out = buf
    if out.len >= 0 {
        if out.len < 65536 {
            out.bytes[out.len as usize] = ph0_low8(b) as i8
            out.len = out.len + 1
        }
    }
    out
}

fn ph0_emit_u32_le(buf: Ph0CodeBuffer, val: i64) -> Ph0CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = ph0_emit_byte(b, ph0_low8(val))
    b = ph0_emit_byte(b, ph0_low8(val >> 8))
    b = ph0_emit_byte(b, ph0_low8(val >> 16))
    b = ph0_emit_byte(b, ph0_low8(val >> 24))
    b
}

fn ph0_emit_push_rbp(buf: Ph0CodeBuffer) -> Ph0CodeBuffer with Mut, Panic, Div {
    ph0_emit_byte(buf, 0x55)
}

fn ph0_emit_pop_rbp(buf: Ph0CodeBuffer) -> Ph0CodeBuffer with Mut, Panic, Div {
    ph0_emit_byte(buf, 0x5d)
}

fn ph0_emit_mov_rbp_rsp(buf: Ph0CodeBuffer) -> Ph0CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = ph0_emit_byte(b, 0x48)
    b = ph0_emit_byte(b, 0x89)
    b = ph0_emit_byte(b, 0xe5)
    b
}

fn ph0_emit_mov_rsp_rbp(buf: Ph0CodeBuffer) -> Ph0CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = ph0_emit_byte(b, 0x48)
    b = ph0_emit_byte(b, 0x89)
    b = ph0_emit_byte(b, 0xec)
    b
}

fn ph0_emit_sub_rsp_imm32(buf: Ph0CodeBuffer, val: i64) -> Ph0CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = ph0_emit_byte(b, 0x48)
    b = ph0_emit_byte(b, 0x81)
    b = ph0_emit_byte(b, 0xec)
    b = ph0_emit_u32_le(b, val)
    b
}

fn ph0_emit_ret(buf: Ph0CodeBuffer) -> Ph0CodeBuffer with Mut, Panic, Div {
    ph0_emit_byte(buf, 0xc3)
}

// ============================================================================
// From frame.sio
// ============================================================================

struct Ph0StackFrame {
    frame_size: i64,
    local_count: i64,
    param_count: i64,
    return_jump_count: i64,
}

fn ph0_stack_frame_new() -> Ph0StackFrame {
    Ph0StackFrame {
        frame_size: 0,
        local_count: 0,
        param_count: 0,
        return_jump_count: 0,
    }
}

fn ph0_align16(size: i64) -> i64 with Mut, Panic {
    var aligned = size
    let remainder = size % 16
    if remainder != 0 {
        aligned = size + (16 - remainder)
    }
    aligned
}

fn ph0_prepare_frame(params: i64, locals: i64) -> Ph0StackFrame with Mut, Panic {
    var frame = ph0_stack_frame_new()
    frame.param_count = params
    frame.local_count = locals

    let total_vars = params + locals
    let raw_size = total_vars * 8

    frame.frame_size = ph0_align16(raw_size)
    frame
}

fn ph0_emit_prologue(buf: Ph0CodeBuffer, frame_size: i64) -> Ph0CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = ph0_emit_push_rbp(b)
    b = ph0_emit_mov_rbp_rsp(b)

    if frame_size > 0 {
        b = ph0_emit_sub_rsp_imm32(b, frame_size)
    }
    b
}

fn ph0_emit_epilogue(buf: Ph0CodeBuffer) -> Ph0CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = ph0_emit_mov_rsp_rbp(b)
    b = ph0_emit_pop_rbp(b)
    b = ph0_emit_ret(b)
    b
}

fn ph0_param_offset(param_index: i64) -> i64 {
    -(param_index + 1) * 8
}

fn ph0_local_offset(frame: Ph0StackFrame, local_index: i64) -> i64 {
    -(frame.param_count + local_index + 1) * 8
}

// ============================================================================
// From regs.sio
// ============================================================================

fn ph0_reg_rax() -> i64 { 0 }
fn ph0_reg_rcx() -> i64 { 1 }
fn ph0_reg_rdx() -> i64 { 2 }
fn ph0_reg_rbx() -> i64 { 3 }
fn ph0_reg_rsp() -> i64 { 4 }
fn ph0_reg_rbp() -> i64 { 5 }
fn ph0_reg_rsi() -> i64 { 6 }
fn ph0_reg_rdi() -> i64 { 7 }
fn ph0_reg_r8() -> i64  { 8 }
fn ph0_reg_r9() -> i64  { 9 }

fn ph0_param_reg(index: i64) -> i64 {
    if index == 0 { ph0_reg_rdi() }
    else if index == 1 { ph0_reg_rsi() }
    else if index == 2 { ph0_reg_rdx() }
    else if index == 3 { ph0_reg_rcx() }
    else if index == 4 { ph0_reg_r8() }
    else if index == 5 { ph0_reg_r9() }
    else { -1 }
}

fn ph0_return_reg() -> i64 {
    ph0_reg_rax()
}

// ============================================================================
// Tests
// ============================================================================

fn ph0_test_align16() -> i64 with Mut, Panic {
    if ph0_align16(0) != 0 { return 1 }
    if ph0_align16(1) != 16 { return 2 }
    if ph0_align16(16) != 16 { return 3 }
    if ph0_align16(17) != 32 { return 4 }
    if ph0_align16(32) != 32 { return 5 }
    0
}

fn ph0_test_stack_frame_allocation() -> i64 with Mut, Panic {
    let frame = ph0_prepare_frame(2, 3)

    if frame.frame_size != 48 { return 1 }
    if frame.param_count != 2 { return 2 }
    if frame.local_count != 3 { return 3 }

    0
}

fn ph0_test_param_offset() -> i64 {
    if ph0_param_offset(0) != -8 { return 1 }
    if ph0_param_offset(1) != -16 { return 2 }
    if ph0_param_offset(2) != -24 { return 3 }
    0
}

fn ph0_test_local_offset_calculation() -> i64 with Mut, Panic {
    let frame = ph0_prepare_frame(2, 3)

    let offset0 = ph0_local_offset(frame, 0)
    if offset0 != -24 { return 1 }

    let offset1 = ph0_local_offset(frame, 1)
    if offset1 != -32 { return 2 }

    0
}

fn ph0_test_param_reg_mapping() -> i64 {
    if ph0_param_reg(0) != ph0_reg_rdi() { return 1 }
    if ph0_param_reg(1) != ph0_reg_rsi() { return 2 }
    if ph0_param_reg(2) != ph0_reg_rdx() { return 3 }
    if ph0_param_reg(3) != ph0_reg_rcx() { return 4 }
    if ph0_param_reg(4) != ph0_reg_r8() { return 5 }
    if ph0_param_reg(5) != ph0_reg_r9() { return 6 }
    if ph0_param_reg(6) != -1 { return 7 }
    0
}

fn ph0_test_emit_prologue() -> i64 with Mut, Panic, Div {
    var buf = ph0_code_buffer_new()
    buf = ph0_emit_prologue(buf, 16)

    if buf.len < 8 { return 1 }
    if buf.bytes[0] != 0x55 { return 2 }

    0
}

fn ph0_test_emit_epilogue() -> i64 with Mut, Panic, Div {
    var buf = ph0_code_buffer_new()
    buf = ph0_emit_epilogue(buf)

    if buf.len < 4 { return 1 }
    let last_idx = buf.len - 1
    if buf.bytes[last_idx as usize] != 0xc3 { return 2 }

    0
}

// Main test runner
fn test_phase0_main() -> i64 with Mut, Panic, Div {
    var failed = 0

    if ph0_test_align16() != 0 { failed = failed + 1 }
    if ph0_test_stack_frame_allocation() != 0 { failed = failed + 1 }
    if ph0_test_param_offset() != 0 { failed = failed + 1 }
    if ph0_test_local_offset_calculation() != 0 { failed = failed + 1 }
    if ph0_test_param_reg_mapping() != 0 { failed = failed + 1 }
    if ph0_test_emit_prologue() != 0 { failed = failed + 1 }
    if ph0_test_emit_epilogue() != 0 { failed = failed + 1 }

    if failed == 0 {
        // All tests passed
        0
    } else {
        // Some tests failed
        1
    }
}
