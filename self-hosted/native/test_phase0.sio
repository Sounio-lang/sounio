// self-hosted::native::test_phase0 — Phase 0 comprehensive test
//
// Aggregates all Phase 0 modules to test compilation and basic functionality

// ============================================================================
// From encode.sio
// ============================================================================

struct Ph0CodeBuffer {
    bytes: [i8; 65536],
    len: i64,
}

fn code_buffer_new() -> Ph0CodeBuffer {
    Ph0CodeBuffer { bytes: [0; 65536], len: 0 }
}

fn low8(x: i64) -> i64 with Mut, Panic, Div {
    var n = x % 256
    if n < 0 { n = n + 256 }
    n
}

fn emit_byte(buf: Ph0CodeBuffer, b: i64) -> Ph0CodeBuffer with Mut, Panic, Div {
    var out = buf
    if out.len >= 0 {
        if out.len < 65536 {
            out.bytes[out.len as usize] = low8(b) as i8
            out.len = out.len + 1
        }
    }
    out
}

fn emit_u32_le(buf: Ph0CodeBuffer, val: i64) -> Ph0CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, low8(val))
    b = emit_byte(b, low8(val >> 8))
    b = emit_byte(b, low8(val >> 16))
    b = emit_byte(b, low8(val >> 24))
    b
}

fn emit_push_rbp(buf: Ph0CodeBuffer) -> Ph0CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x55)
}

fn emit_pop_rbp(buf: Ph0CodeBuffer) -> Ph0CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x5d)
}

fn emit_mov_rbp_rsp(buf: Ph0CodeBuffer) -> Ph0CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0xe5)
    b
}

fn emit_mov_rsp_rbp(buf: Ph0CodeBuffer) -> Ph0CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0xec)
    b
}

fn emit_sub_rsp_imm32(buf: Ph0CodeBuffer, val: i64) -> Ph0CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x81)
    b = emit_byte(b, 0xec)
    b = emit_u32_le(b, val)
    b
}

fn emit_ret(buf: Ph0CodeBuffer) -> Ph0CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0xc3)
}

// ============================================================================
// From frame.sio
// ============================================================================

struct Ph0StackFrame {
    frame_size: i64,
    local_count: i64,
    param_count: i64,
    return_jump_count: i64,
}

fn stack_frame_new() -> Ph0StackFrame {
    Ph0StackFrame {
        frame_size: 0,
        local_count: 0,
        param_count: 0,
        return_jump_count: 0,
    }
}

fn align16(size: i64) -> i64 with Mut, Panic {
    var aligned = size
    let remainder = size % 16
    if remainder != 0 {
        aligned = size + (16 - remainder)
    }
    aligned
}

fn prepare_frame(params: i64, locals: i64) -> Ph0StackFrame with Mut, Panic {
    var frame = stack_frame_new()
    frame.param_count = params
    frame.local_count = locals

    let total_vars = params + locals
    let raw_size = total_vars * 8

    frame.frame_size = align16(raw_size)
    frame
}

fn emit_prologue(buf: Ph0CodeBuffer, frame_size: i64) -> Ph0CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_push_rbp(b)
    b = emit_mov_rbp_rsp(b)

    if frame_size > 0 {
        b = emit_sub_rsp_imm32(b, frame_size)
    }
    b
}

fn emit_epilogue(buf: Ph0CodeBuffer) -> Ph0CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_mov_rsp_rbp(b)
    b = emit_pop_rbp(b)
    b = emit_ret(b)
    b
}

fn param_offset(param_index: i64) -> i64 {
    -(param_index + 1) * 8
}

fn local_offset(frame: Ph0StackFrame, local_index: i64) -> i64 {
    -(frame.param_count + local_index + 1) * 8
}

// ============================================================================
// From regs.sio
// ============================================================================

fn reg_rax() -> i64 { 0 }
fn reg_rcx() -> i64 { 1 }
fn reg_rdx() -> i64 { 2 }
fn reg_rbx() -> i64 { 3 }
fn reg_rsp() -> i64 { 4 }
fn reg_rbp() -> i64 { 5 }
fn reg_rsi() -> i64 { 6 }
fn reg_rdi() -> i64 { 7 }
fn reg_r8() -> i64  { 8 }
fn reg_r9() -> i64  { 9 }

fn param_reg(index: i64) -> i64 {
    if index == 0 { reg_rdi() }
    else if index == 1 { reg_rsi() }
    else if index == 2 { reg_rdx() }
    else if index == 3 { reg_rcx() }
    else if index == 4 { reg_r8() }
    else if index == 5 { reg_r9() }
    else { -1 }
}

fn return_reg() -> i64 {
    reg_rax()
}

// ============================================================================
// Tests
// ============================================================================

fn test_align16() -> i64 with Mut, Panic {
    if align16(0) != 0 { return 1 }
    if align16(1) != 16 { return 2 }
    if align16(16) != 16 { return 3 }
    if align16(17) != 32 { return 4 }
    if align16(32) != 32 { return 5 }
    0
}

fn test_stack_frame_allocation() -> i64 with Mut, Panic {
    let frame = prepare_frame(2, 3)

    if frame.frame_size != 48 { return 1 }
    if frame.param_count != 2 { return 2 }
    if frame.local_count != 3 { return 3 }

    0
}

fn test_param_offset() -> i64 {
    if param_offset(0) != -8 { return 1 }
    if param_offset(1) != -16 { return 2 }
    if param_offset(2) != -24 { return 3 }
    0
}

fn test_local_offset_calculation() -> i64 with Mut, Panic {
    let frame = prepare_frame(2, 3)

    let offset0 = local_offset(frame, 0)
    if offset0 != -24 { return 1 }

    let offset1 = local_offset(frame, 1)
    if offset1 != -32 { return 2 }

    0
}

fn test_param_reg_mapping() -> i64 {
    if param_reg(0) != reg_rdi() { return 1 }
    if param_reg(1) != reg_rsi() { return 2 }
    if param_reg(2) != reg_rdx() { return 3 }
    if param_reg(3) != reg_rcx() { return 4 }
    if param_reg(4) != reg_r8() { return 5 }
    if param_reg(5) != reg_r9() { return 6 }
    if param_reg(6) != -1 { return 7 }
    0
}

fn test_emit_prologue() -> i64 with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = emit_prologue(buf, 16)

    if buf.len < 8 { return 1 }
    if buf.bytes[0] != 0x55 { return 2 }

    0
}

fn test_emit_epilogue() -> i64 with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = emit_epilogue(buf)

    if buf.len < 4 { return 1 }
    let last_idx = buf.len - 1
    if buf.bytes[last_idx as usize] != 0xc3 { return 2 }

    0
}

// Main test runner
fn main() -> i64 with Mut, Panic, Div {
    var failed = 0

    if test_align16() != 0 { failed = failed + 1 }
    if test_stack_frame_allocation() != 0 { failed = failed + 1 }
    if test_param_offset() != 0 { failed = failed + 1 }
    if test_local_offset_calculation() != 0 { failed = failed + 1 }
    if test_param_reg_mapping() != 0 { failed = failed + 1 }
    if test_emit_prologue() != 0 { failed = failed + 1 }
    if test_emit_epilogue() != 0 { failed = failed + 1 }

    if failed == 0 {
        // All tests passed
        0
    } else {
        // Some tests failed
        1
    }
}
