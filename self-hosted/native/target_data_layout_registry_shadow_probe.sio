use native::target_data_layout_registry_shadow::*
use native::target_policy::*

fn target_data_layout_shadow_fail(code: i64) -> i64 with IO {
    print("TARGET_DATA_LAYOUT_REGISTRY_SHADOW_FAIL code=")
    print_int(code)
    print("\n")
    code
}

fn target_data_layout_shadow_fail_value(code: i64, value: i64) -> i64 with IO {
    print("TARGET_DATA_LAYOUT_REGISTRY_SHADOW_FAIL code=")
    print_int(code)
    print(" value=")
    print_int(value)
    print("\n")
    code
}

fn main() -> i64 with IO, Mut {
    var before_init = target_data_layout_registry_shadow_invalid_id()
    if target_data_layout_registry_shadow_id_status(&before_init) !=
       TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_INVALID_STORE {
        return target_data_layout_shadow_fail(101)
    }
    if target_data_layout_registry_shadow_store_init() !=
       TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK {
        return target_data_layout_shadow_fail(102)
    }
    if target_data_layout_registry_shadow_store_init() !=
       TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_STORE_ALREADY_INITIALIZED {
        return target_data_layout_shadow_fail(103)
    }

    var linux = target_data_layout_registry_shadow_invalid_id()
    if target_data_layout_registry_shadow_alloc_profile(
        target_data_layout_profile_x86_64_linux_sysv_v1(),
        &! linux,
    ) != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK {
        return target_data_layout_shadow_fail(110)
    }
    let first_store_identity = target_data_layout_registry_shadow_id_store_identity(&linux)
    if first_store_identity <= 0 { return target_data_layout_shadow_fail(109) }
    let linux_integrity = target_data_layout_registry_shadow_profile_integrity_code(&linux)
    if linux_integrity != 0 {
        return target_data_layout_shadow_fail_value(108, linux_integrity)
    }
    if target_data_layout_registry_shadow_alloc_profile(
        target_data_layout_profile_x86_64_linux_sysv_v1(),
        &! linux,
    ) != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_OUTPUT_NOT_CLEAR {
        return target_data_layout_shadow_fail(111)
    }
    if target_data_layout_registry_shadow_arch_id(&linux) != native_policy_arch_x86_64() {
        return target_data_layout_shadow_fail_value(112, target_data_layout_registry_shadow_arch_id(&linux))
    }
    if target_data_layout_registry_shadow_os_id(&linux) != native_policy_os_linux() {
        return target_data_layout_shadow_fail(113)
    }
    if target_data_layout_registry_shadow_os_abi_id(&linux) != target_os_abi_sysv_amd64_v1() {
        return target_data_layout_shadow_fail(114)
    }
    if target_data_layout_registry_shadow_endianness_id(&linux) != target_endian_little_v1() {
        return target_data_layout_shadow_fail(115)
    }
    if target_data_layout_registry_shadow_pointer_size_bytes(&linux) != 8 {
        return target_data_layout_shadow_fail(116)
    }
    if target_data_layout_registry_shadow_pointer_alignment_bytes(&linux) != 8 {
        return target_data_layout_shadow_fail(117)
    }
    if target_data_layout_registry_shadow_scalar_alignment_policy(&linux) !=
       target_scalar_alignment_natural_cap_16_v1() {
        return target_data_layout_shadow_fail(118)
    }
    if target_data_layout_registry_shadow_vector_alignment_policy(&linux) !=
       target_vector_alignment_baseline_16_v1() {
        return target_data_layout_shadow_fail(119)
    }
    if target_data_layout_registry_shadow_wide_float_abi_policy(&linux) !=
       target_wide_float_abi_undeclared() {
        return target_data_layout_shadow_fail(122)
    }
    if target_data_layout_registry_shadow_managed_object_layout_version(&linux) !=
       target_managed_object_layout_v1() {
        return target_data_layout_shadow_fail(123)
    }
    if target_data_layout_registry_shadow_layout_algorithm_version(&linux) !=
       target_layout_algorithm_v1() {
        return target_data_layout_shadow_fail(124)
    }
    if target_data_layout_registry_shadow_f128_abi_status(&linux) !=
           TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_WIDE_FLOAT_UNSUPPORTED ||
       target_data_layout_registry_shadow_f256_abi_status(&linux) !=
           TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_WIDE_FLOAT_UNSUPPORTED {
        return target_data_layout_shadow_fail(125)
    }

    var macos = target_data_layout_registry_shadow_invalid_id()
    if target_data_layout_registry_shadow_alloc_profile(
        target_data_layout_profile_x86_64_macos_darwin_v1(),
        &! macos,
    ) != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK {
        return target_data_layout_shadow_fail(120)
    }
    if target_data_layout_registry_shadow_id_equal(&linux, &macos) ||
       !target_data_layout_registry_shadow_declared_storage_policy_equal(&linux, &macos) ||
       target_data_layout_registry_shadow_abi_policy_equal(&linux, &macos) ||
       target_data_layout_registry_shadow_profile_id(&linux) ==
           target_data_layout_registry_shadow_profile_id(&macos) ||
       target_data_layout_registry_shadow_os_id(&linux) ==
           target_data_layout_registry_shadow_os_id(&macos) ||
       target_data_layout_registry_shadow_os_abi_id(&macos) !=
           target_os_abi_darwin_amd64_v1() {
        return target_data_layout_shadow_fail(121)
    }

    var over = target_data_layout_registry_shadow_invalid_id()
    if target_data_layout_registry_shadow_alloc_profile(
        target_data_layout_profile_aarch64_linux_aapcs64_v1(),
        &! over,
    ) != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_CAPACITY {
        return target_data_layout_shadow_fail(130)
    }
    if target_data_layout_registry_shadow_id_slot(&over) != -1 ||
       target_data_layout_registry_shadow_live_count() != 2 {
        return target_data_layout_shadow_fail(131)
    }
    if target_data_layout_registry_shadow_alloc_profile(999, &! over) !=
       TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_UNSUPPORTED_PROFILE {
        return target_data_layout_shadow_fail(132)
    }
    var duplicate = target_data_layout_registry_shadow_invalid_id()
    if target_data_layout_registry_shadow_alloc_profile(
        target_data_layout_profile_x86_64_linux_sysv_v1(),
        &! duplicate,
    ) != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_DUPLICATE_PROFILE {
        return target_data_layout_shadow_fail(133)
    }

    let old_linux_slot = target_data_layout_registry_shadow_id_slot(&linux)
    let old_linux_generation = target_data_layout_registry_shadow_id_generation(&linux)
    if target_data_layout_registry_shadow_release(&linux) !=
       TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK {
        return target_data_layout_shadow_fail(140)
    }
    if target_data_layout_registry_shadow_id_status(&linux) !=
       TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_STALE_ID {
        return target_data_layout_shadow_fail(141)
    }

    var reused = target_data_layout_registry_shadow_invalid_id()
    if target_data_layout_registry_shadow_alloc_profile(
        target_data_layout_profile_aarch64_linux_aapcs64_v1(),
        &! reused,
    ) != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK {
        return target_data_layout_shadow_fail(142)
    }
    if target_data_layout_registry_shadow_id_slot(&reused) != old_linux_slot ||
       target_data_layout_registry_shadow_id_generation(&reused) == old_linux_generation ||
       target_data_layout_registry_shadow_id_is_live(&linux) ||
       target_data_layout_registry_shadow_arch_id(&reused) != native_policy_arch_aarch64() ||
       target_data_layout_registry_shadow_os_id(&reused) != native_policy_os_linux() ||
       target_data_layout_registry_shadow_os_abi_id(&reused) !=
           target_os_abi_aapcs64_elf_v1() ||
       target_data_layout_registry_shadow_f128_abi_status(&reused) !=
           TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_WIDE_FLOAT_UNSUPPORTED ||
       target_data_layout_registry_shadow_f256_abi_status(&reused) !=
           TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_WIDE_FLOAT_UNSUPPORTED {
        return target_data_layout_shadow_fail(143)
    }

    // Reset mints a new store identity and invalidates every old handle.
    if target_data_layout_registry_shadow_store_reset() !=
       TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK {
        return target_data_layout_shadow_fail(150)
    }
    if target_data_layout_registry_shadow_id_status(&macos) !=
           TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_STALE_ID ||
       target_data_layout_registry_shadow_id_status(&reused) !=
           TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_STALE_ID ||
       target_data_layout_registry_shadow_live_count() != 0 {
        return target_data_layout_shadow_fail(151)
    }

    var fresh = target_data_layout_registry_shadow_invalid_id()
    if target_data_layout_registry_shadow_store_reset() !=
           TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK ||
       target_data_layout_registry_shadow_alloc_profile(
           target_data_layout_profile_x86_64_linux_sysv_v1(),
           &! fresh,
       ) != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK ||
       target_data_layout_registry_shadow_id_store_identity(&fresh) <= first_store_identity {
        return target_data_layout_shadow_fail(160)
    }
    if target_data_layout_registry_shadow_id_status(&linux) !=
       TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_STALE_ID {
        return target_data_layout_shadow_fail(161)
    }
    if target_data_layout_registry_shadow_release(&fresh) !=
           TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK ||
       target_data_layout_registry_shadow_live_count() != 0 ||
       target_data_layout_registry_shadow_id_status(&fresh) !=
           TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_STALE_ID {
        return target_data_layout_shadow_fail(162)
    }

    target_data_layout_registry_shadow_clear_id(&! fresh)
    if target_data_layout_registry_shadow_id_status(&fresh) !=
       TARGET_DATA_LAYOUT_REGISTRY_SHADOW_ERR_INVALID_ID {
        return target_data_layout_shadow_fail(163)
    }

    // Registered-profile traversal: every closed branch must allocate, match
    // its exact identity, pass integrity, release, and leave no hidden default.
    var walk = target_data_layout_registry_shadow_invalid_id()
    if target_data_layout_registry_shadow_alloc_profile(
        target_data_layout_profile_x86_64_linux_sysv_v1(),
        &! walk,
    ) != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK ||
       target_data_layout_registry_shadow_profile_integrity_code(&walk) != 0 ||
       target_data_layout_registry_shadow_profile_id(&walk) !=
           target_data_layout_profile_x86_64_linux_sysv_v1() {
        return target_data_layout_shadow_fail(170)
    }
    if target_data_layout_registry_shadow_release(&walk) !=
       TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK {
        return target_data_layout_shadow_fail(171)
    }
    target_data_layout_registry_shadow_clear_id(&! walk)

    if target_data_layout_registry_shadow_alloc_profile(
        target_data_layout_profile_x86_64_macos_darwin_v1(),
        &! walk,
    ) != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK ||
       target_data_layout_registry_shadow_profile_integrity_code(&walk) != 0 ||
       target_data_layout_registry_shadow_profile_id(&walk) !=
           target_data_layout_profile_x86_64_macos_darwin_v1() {
        return target_data_layout_shadow_fail(172)
    }
    if target_data_layout_registry_shadow_release(&walk) !=
       TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK {
        return target_data_layout_shadow_fail(173)
    }
    target_data_layout_registry_shadow_clear_id(&! walk)

    if target_data_layout_registry_shadow_alloc_profile(
        target_data_layout_profile_aarch64_linux_aapcs64_v1(),
        &! walk,
    ) != TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK ||
       target_data_layout_registry_shadow_profile_integrity_code(&walk) != 0 ||
       target_data_layout_registry_shadow_profile_id(&walk) !=
           target_data_layout_profile_aarch64_linux_aapcs64_v1() {
        return target_data_layout_shadow_fail(174)
    }
    if target_data_layout_registry_shadow_release(&walk) !=
           TARGET_DATA_LAYOUT_REGISTRY_SHADOW_OK ||
       target_data_layout_registry_shadow_live_count() != 0 {
        return target_data_layout_shadow_fail(175)
    }

    print("TARGET_DATA_LAYOUT_REGISTRY_SHADOW_PASS classification=target_authority_shadow_not_field_layout\n")
    0
}
