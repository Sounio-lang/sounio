// self-hosted::native::apple_arm64_preview
//
// Tiny Apple Silicon preview emitter for the native-v2 aarch64-macos proof
// lane. This intentionally does not import native::macho or native::aarch64:
// those generic helpers copy large writer structs through the self-hosted
// runtime. The proof surface only needs a scalar exit executable, so emit that
// Mach-O image directly into one 64KB buffer.

module native::apple_arm64_preview

fn apple_arm64_low8(x: i64) -> i64 with Mut, Panic, Div {
    var n = x % 256
    if n < 0 { n = n + 256 }
    n
}

fn apple_arm64_put_byte(buf: [i8; 65536], pos: i64, b: i64) -> [i8; 65536] with Mut, Panic, Div {
    var out = buf
    if pos >= 0 && pos < 65536 {
        out[pos as usize] = apple_arm64_low8(b) as i8
    }
    out
}

fn apple_arm64_put_u32(buf: [i8; 65536], pos: i64, val: i64) -> [i8; 65536] with Mut, Panic, Div {
    var out = buf
    out = apple_arm64_put_byte(out, pos, val)
    out = apple_arm64_put_byte(out, pos + 1, val >> 8)
    out = apple_arm64_put_byte(out, pos + 2, val >> 16)
    out = apple_arm64_put_byte(out, pos + 3, val >> 24)
    out
}

fn apple_arm64_put_u64(buf: [i8; 65536], pos: i64, val: i64) -> [i8; 65536] with Mut, Panic, Div {
    var out = buf
    out = apple_arm64_put_u32(out, pos, val)
    out = apple_arm64_put_u32(out, pos + 4, val >> 32)
    out
}

fn apple_arm64_append_u32(buf: [i8; 65536], pos: i64, val: i64) -> ([i8; 65536], i64) with Mut, Panic, Div {
    (apple_arm64_put_u32(buf, pos, val), pos + 4)
}

fn apple_arm64_append_u64(buf: [i8; 65536], pos: i64, val: i64) -> ([i8; 65536], i64) with Mut, Panic, Div {
    (apple_arm64_put_u64(buf, pos, val), pos + 8)
}

fn apple_arm64_append_cstr_byte(buf: [i8; 65536], pos: i64, b: i64) -> ([i8; 65536], i64) with Mut, Panic, Div {
    (apple_arm64_put_byte(buf, pos, b), pos + 1)
}

fn apple_arm64_append_zeros(buf: [i8; 65536], pos: i64, count: i64) -> ([i8; 65536], i64) {
    (buf, pos + count)
}

fn apple_arm64_append_seg_pagezero(buf: [i8; 65536], pos: i64) -> ([i8; 65536], i64) with Mut, Panic, Div {
    var out = buf
    var p = pos
    let a0 = apple_arm64_append_cstr_byte(out, p, 95); out = a0.0; p = a0.1
    let a1 = apple_arm64_append_cstr_byte(out, p, 95); out = a1.0; p = a1.1
    let a2 = apple_arm64_append_cstr_byte(out, p, 80); out = a2.0; p = a2.1
    let a3 = apple_arm64_append_cstr_byte(out, p, 65); out = a3.0; p = a3.1
    let a4 = apple_arm64_append_cstr_byte(out, p, 71); out = a4.0; p = a4.1
    let a5 = apple_arm64_append_cstr_byte(out, p, 69); out = a5.0; p = a5.1
    let a6 = apple_arm64_append_cstr_byte(out, p, 90); out = a6.0; p = a6.1
    let a7 = apple_arm64_append_cstr_byte(out, p, 69); out = a7.0; p = a7.1
    let a8 = apple_arm64_append_cstr_byte(out, p, 82); out = a8.0; p = a8.1
    let a9 = apple_arm64_append_cstr_byte(out, p, 79); out = a9.0; p = a9.1
    let z = apple_arm64_append_zeros(out, p, 6)
    z
}

fn apple_arm64_append_seg_text(buf: [i8; 65536], pos: i64) -> ([i8; 65536], i64) with Mut, Panic, Div {
    var out = buf
    var p = pos
    let a0 = apple_arm64_append_cstr_byte(out, p, 95); out = a0.0; p = a0.1
    let a1 = apple_arm64_append_cstr_byte(out, p, 95); out = a1.0; p = a1.1
    let a2 = apple_arm64_append_cstr_byte(out, p, 84); out = a2.0; p = a2.1
    let a3 = apple_arm64_append_cstr_byte(out, p, 69); out = a3.0; p = a3.1
    let a4 = apple_arm64_append_cstr_byte(out, p, 88); out = a4.0; p = a4.1
    let a5 = apple_arm64_append_cstr_byte(out, p, 84); out = a5.0; p = a5.1
    let z = apple_arm64_append_zeros(out, p, 10)
    z
}

fn apple_arm64_append_seg_linkedit(buf: [i8; 65536], pos: i64) -> ([i8; 65536], i64) with Mut, Panic, Div {
    var out = buf
    var p = pos
    let a0 = apple_arm64_append_cstr_byte(out, p, 95); out = a0.0; p = a0.1
    let a1 = apple_arm64_append_cstr_byte(out, p, 95); out = a1.0; p = a1.1
    let a2 = apple_arm64_append_cstr_byte(out, p, 76); out = a2.0; p = a2.1
    let a3 = apple_arm64_append_cstr_byte(out, p, 73); out = a3.0; p = a3.1
    let a4 = apple_arm64_append_cstr_byte(out, p, 78); out = a4.0; p = a4.1
    let a5 = apple_arm64_append_cstr_byte(out, p, 75); out = a5.0; p = a5.1
    let a6 = apple_arm64_append_cstr_byte(out, p, 69); out = a6.0; p = a6.1
    let a7 = apple_arm64_append_cstr_byte(out, p, 68); out = a7.0; p = a7.1
    let a8 = apple_arm64_append_cstr_byte(out, p, 73); out = a8.0; p = a8.1
    let a9 = apple_arm64_append_cstr_byte(out, p, 84); out = a9.0; p = a9.1
    let z = apple_arm64_append_zeros(out, p, 6)
    z
}

fn apple_arm64_append_sect_text(buf: [i8; 65536], pos: i64) -> ([i8; 65536], i64) with Mut, Panic, Div {
    var out = buf
    var p = pos
    let a0 = apple_arm64_append_cstr_byte(out, p, 95); out = a0.0; p = a0.1
    let a1 = apple_arm64_append_cstr_byte(out, p, 95); out = a1.0; p = a1.1
    let a2 = apple_arm64_append_cstr_byte(out, p, 116); out = a2.0; p = a2.1
    let a3 = apple_arm64_append_cstr_byte(out, p, 101); out = a3.0; p = a3.1
    let a4 = apple_arm64_append_cstr_byte(out, p, 120); out = a4.0; p = a4.1
    let a5 = apple_arm64_append_cstr_byte(out, p, 116); out = a5.0; p = a5.1
    let z = apple_arm64_append_zeros(out, p, 10)
    z
}

fn apple_arm64_emit_segment(buf: [i8; 65536], pos: i64, seg_kind: i64, cmdsize: i64, vmaddr: i64, vmsize: i64, fileoff: i64, filesize: i64, maxprot: i64, initprot: i64, nsects: i64) -> ([i8; 65536], i64) with Mut, Panic, Div {
    var out = buf
    var p = pos
    let a0 = apple_arm64_append_u32(out, p, 25); out = a0.0; p = a0.1
    let a1 = apple_arm64_append_u32(out, p, cmdsize); out = a1.0; p = a1.1
    let name = if seg_kind == 1 {
        apple_arm64_append_seg_pagezero(out, p)
    } else if seg_kind == 2 {
        apple_arm64_append_seg_text(out, p)
    } else {
        apple_arm64_append_seg_linkedit(out, p)
    }
    out = name.0; p = name.1
    let a2 = apple_arm64_append_u64(out, p, vmaddr); out = a2.0; p = a2.1
    let a3 = apple_arm64_append_u64(out, p, vmsize); out = a3.0; p = a3.1
    let a4 = apple_arm64_append_u64(out, p, fileoff); out = a4.0; p = a4.1
    let a5 = apple_arm64_append_u64(out, p, filesize); out = a5.0; p = a5.1
    let a6 = apple_arm64_append_u32(out, p, maxprot); out = a6.0; p = a6.1
    let a7 = apple_arm64_append_u32(out, p, initprot); out = a7.0; p = a7.1
    let a8 = apple_arm64_append_u32(out, p, nsects); out = a8.0; p = a8.1
    let a9 = apple_arm64_append_u32(out, p, 0); out = a9.0; p = a9.1
    (out, p)
}

fn apple_arm64_emit_text_section(buf: [i8; 65536], pos: i64, addr: i64, size: i64, offset: i64) -> ([i8; 65536], i64) with Mut, Panic, Div {
    var out = buf
    var p = pos
    let s0 = apple_arm64_append_sect_text(out, p); out = s0.0; p = s0.1
    let s1 = apple_arm64_append_seg_text(out, p); out = s1.0; p = s1.1
    let a0 = apple_arm64_append_u64(out, p, addr); out = a0.0; p = a0.1
    let a1 = apple_arm64_append_u64(out, p, size); out = a1.0; p = a1.1
    let a2 = apple_arm64_append_u32(out, p, offset); out = a2.0; p = a2.1
    let a3 = apple_arm64_append_u32(out, p, 4); out = a3.0; p = a3.1
    let a4 = apple_arm64_append_u32(out, p, 0); out = a4.0; p = a4.1
    let a5 = apple_arm64_append_u32(out, p, 0); out = a5.0; p = a5.1
    let a6 = apple_arm64_append_u32(out, p, 2147484672); out = a6.0; p = a6.1
    let a7 = apple_arm64_append_u32(out, p, 0); out = a7.0; p = a7.1
    let a8 = apple_arm64_append_u32(out, p, 0); out = a8.0; p = a8.1
    (out, p)
}

fn apple_arm64_emit_dylinker(buf: [i8; 65536], pos: i64) -> ([i8; 65536], i64) with Mut, Panic, Div {
    var out = buf
    var p = pos
    let a0 = apple_arm64_append_u32(out, p, 14); out = a0.0; p = a0.1
    let a1 = apple_arm64_append_u32(out, p, 32); out = a1.0; p = a1.1
    let a2 = apple_arm64_append_u32(out, p, 12); out = a2.0; p = a2.1
    let b0 = apple_arm64_append_cstr_byte(out, p, 47); out = b0.0; p = b0.1
    let b1 = apple_arm64_append_cstr_byte(out, p, 117); out = b1.0; p = b1.1
    let b2 = apple_arm64_append_cstr_byte(out, p, 115); out = b2.0; p = b2.1
    let b3 = apple_arm64_append_cstr_byte(out, p, 114); out = b3.0; p = b3.1
    let b4 = apple_arm64_append_cstr_byte(out, p, 47); out = b4.0; p = b4.1
    let b5 = apple_arm64_append_cstr_byte(out, p, 108); out = b5.0; p = b5.1
    let b6 = apple_arm64_append_cstr_byte(out, p, 105); out = b6.0; p = b6.1
    let b7 = apple_arm64_append_cstr_byte(out, p, 98); out = b7.0; p = b7.1
    let b8 = apple_arm64_append_cstr_byte(out, p, 47); out = b8.0; p = b8.1
    let b9 = apple_arm64_append_cstr_byte(out, p, 100); out = b9.0; p = b9.1
    let b10 = apple_arm64_append_cstr_byte(out, p, 121); out = b10.0; p = b10.1
    let b11 = apple_arm64_append_cstr_byte(out, p, 108); out = b11.0; p = b11.1
    let b12 = apple_arm64_append_cstr_byte(out, p, 100); out = b12.0; p = b12.1
    let b13 = apple_arm64_append_cstr_byte(out, p, 0); out = b13.0; p = b13.1
    let z = apple_arm64_append_zeros(out, p, 6)
    z
}

fn apple_arm64_emit_uuid(buf: [i8; 65536], pos: i64, code_len: i64) -> ([i8; 65536], i64) with Mut, Panic, Div {
    var out = buf
    var p = pos
    let a0 = apple_arm64_append_u32(out, p, 27); out = a0.0; p = a0.1
    let a1 = apple_arm64_append_u32(out, p, 24); out = a1.0; p = a1.1
    let b0 = apple_arm64_append_cstr_byte(out, p, 83); out = b0.0; p = b0.1
    let b1 = apple_arm64_append_cstr_byte(out, p, 79); out = b1.0; p = b1.1
    let b2 = apple_arm64_append_cstr_byte(out, p, 85); out = b2.0; p = b2.1
    let b3 = apple_arm64_append_cstr_byte(out, p, 78); out = b3.0; p = b3.1
    let b4 = apple_arm64_append_cstr_byte(out, p, 73); out = b4.0; p = b4.1
    let b5 = apple_arm64_append_cstr_byte(out, p, 79); out = b5.0; p = b5.1
    let b6 = apple_arm64_append_cstr_byte(out, p, 12); out = b6.0; p = b6.1
    let b7 = apple_arm64_append_cstr_byte(out, p, 2); out = b7.0; p = b7.1
    let a2 = apple_arm64_append_u32(out, p, code_len); out = a2.0; p = a2.1
    let b8 = apple_arm64_append_cstr_byte(out, p, 1); out = b8.0; p = b8.1
    let b9 = apple_arm64_append_cstr_byte(out, p, 0); out = b9.0; p = b9.1
    let b10 = apple_arm64_append_cstr_byte(out, p, 0); out = b10.0; p = b10.1
    let b11 = apple_arm64_append_cstr_byte(out, p, 0); out = b11.0; p = b11.1
    (out, p)
}

fn apple_arm64_emit_code(buf: [i8; 65536], text_offset: i64, exit_code: i64) -> [i8; 65536] with Mut, Panic, Div {
    var out = buf
    out = apple_arm64_put_u32(out, text_offset, 2483027971)
    out = apple_arm64_put_u32(out, text_offset + 4, 3531604016)
    out = apple_arm64_put_u32(out, text_offset + 8, 3556777985)
    out = apple_arm64_put_u32(out, text_offset + 12, 3531603968 + exit_code * 32)
    out = apple_arm64_put_u32(out, text_offset + 16, 3596551104)
    out
}

pub fn apple_arm64_preview_write_scalar_exit(path: string, exit_code: i64) -> i64 with IO, Mut, Panic, Div {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0

    let text_offset: i64 = 16384
    let text_filesize: i64 = 32768
    let code_len: i64 = 20
    let base_vmaddr: i64 = 4294967296
    let text_addr: i64 = base_vmaddr + text_offset
    let sizeofcmds: i64 = 504
    let linkedit_offset: i64 = text_filesize
    let flags: i64 = 2097285
    let macos_11: i64 = 720896

    let h0 = apple_arm64_append_u32(buf, p, 4277009103); buf = h0.0; p = h0.1
    let h1 = apple_arm64_append_u32(buf, p, 16777228); buf = h1.0; p = h1.1
    let h2 = apple_arm64_append_u32(buf, p, 0); buf = h2.0; p = h2.1
    let h3 = apple_arm64_append_u32(buf, p, 2); buf = h3.0; p = h3.1
    let h4 = apple_arm64_append_u32(buf, p, 9); buf = h4.0; p = h4.1
    let h5 = apple_arm64_append_u32(buf, p, sizeofcmds); buf = h5.0; p = h5.1
    let h6 = apple_arm64_append_u32(buf, p, flags); buf = h6.0; p = h6.1
    let h7 = apple_arm64_append_u32(buf, p, 0); buf = h7.0; p = h7.1

    let s0 = apple_arm64_emit_segment(buf, p, 1, 72, 0, base_vmaddr, 0, 0, 0, 0, 0); buf = s0.0; p = s0.1
    let s1 = apple_arm64_emit_segment(buf, p, 2, 152, base_vmaddr, text_filesize, 0, text_filesize, 5, 5, 1); buf = s1.0; p = s1.1
    let sec = apple_arm64_emit_text_section(buf, p, text_addr, code_len, text_offset); buf = sec.0; p = sec.1
    let s2 = apple_arm64_emit_segment(buf, p, 3, 72, base_vmaddr + text_filesize, 0, linkedit_offset, 0, 1, 1, 0); buf = s2.0; p = s2.1
    let dy = apple_arm64_emit_dylinker(buf, p); buf = dy.0; p = dy.1
    let uuid = apple_arm64_emit_uuid(buf, p, code_len); buf = uuid.0; p = uuid.1

    let bv0 = apple_arm64_append_u32(buf, p, 50); buf = bv0.0; p = bv0.1
    let bv1 = apple_arm64_append_u32(buf, p, 24); buf = bv1.0; p = bv1.1
    let bv2 = apple_arm64_append_u32(buf, p, 1); buf = bv2.0; p = bv2.1
    let bv3 = apple_arm64_append_u32(buf, p, macos_11); buf = bv3.0; p = bv3.1
    let bv4 = apple_arm64_append_u32(buf, p, macos_11); buf = bv4.0; p = bv4.1
    let bv5 = apple_arm64_append_u32(buf, p, 0); buf = bv5.0; p = bv5.1

    let st0 = apple_arm64_append_u32(buf, p, 2); buf = st0.0; p = st0.1
    let st1 = apple_arm64_append_u32(buf, p, 24); buf = st1.0; p = st1.1
    let st2 = apple_arm64_append_u32(buf, p, linkedit_offset); buf = st2.0; p = st2.1
    let st3 = apple_arm64_append_u32(buf, p, 0); buf = st3.0; p = st3.1
    let st4 = apple_arm64_append_u32(buf, p, linkedit_offset); buf = st4.0; p = st4.1
    let st5 = apple_arm64_append_u32(buf, p, 0); buf = st5.0; p = st5.1

    let ds0 = apple_arm64_append_u32(buf, p, 11); buf = ds0.0; p = ds0.1
    let ds1 = apple_arm64_append_u32(buf, p, 80); buf = ds1.0; p = ds1.1
    let dz = apple_arm64_append_zeros(buf, p, 72); buf = dz.0; p = dz.1

    let m0 = apple_arm64_append_u32(buf, p, 2147483688); buf = m0.0; p = m0.1
    let m1 = apple_arm64_append_u32(buf, p, 24); buf = m1.0; p = m1.1
    let m2 = apple_arm64_append_u64(buf, p, text_offset); buf = m2.0; p = m2.1
    let m3 = apple_arm64_append_u64(buf, p, 0); buf = m3.0; p = m3.1

    buf = apple_arm64_emit_code(buf, text_offset, exit_code)

    let wrote = write_file(path, buf, text_filesize)
    if wrote < 0 {
        return -1
    }
    text_filesize
}
