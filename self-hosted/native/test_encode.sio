// self-hosted::native::test_encode — unit tests for the native encoder

fn byte_u8(b: i8) -> i64 {
    let x = b as i64
    if x < 0 { x + 256 } else { x }
}

fn test_emit_exit_bytes() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = emit_exit(buf, 0)

    // Expected bytes:
    // 48 c7 c0 3c 00 00 00 48 c7 c7 00 00 00 00 0f 05
    if !(buf.len == 16) { return false }
    if !(byte_u8(buf.bytes[0]) == 0x48) { return false }
    if !(byte_u8(buf.bytes[1]) == 0xc7) { return false }
    if !(byte_u8(buf.bytes[2]) == 0xc0) { return false }
    if !(byte_u8(buf.bytes[3]) == 60) { return false }
    if !(byte_u8(buf.bytes[14]) == 0x0f) { return false }
    if !(byte_u8(buf.bytes[15]) == 0x05) { return false }
    true
}

fn test_lower_ir_add_emits_expected_bytes() -> bool with Mut, Panic, Div {
    // Build a tiny IR fragment:
    //   r0 = 10
    //   r1 = 32
    //   r0 = r0 + r1
    //   return r0
    var buf = code_buffer_new()
    buf = lower_ir_instr(buf, ir_load_imm(0, 10))
    buf = lower_ir_instr(buf, ir_load_imm(1, 32))
    buf = lower_ir_instr(buf, ir_binop(0, 0, BinaryOp::OpAdd, 1))
    buf = lower_ir_instr(buf, ir_return(0))

    // Expected bytes:
    // mov rax, 10: 48 c7 c0 0a 00 00 00
    // mov rbx, 32: 48 c7 c3 20 00 00 00
    // add rax, rbx: 48 01 d8
    // ret: c3
    if !(buf.len == 18) { return false }
    if !(byte_u8(buf.bytes[0]) == 0x48) { return false }
    if !(byte_u8(buf.bytes[2]) == 0xc0) { return false }
    if !(byte_u8(buf.bytes[3]) == 10) { return false }
    if !(byte_u8(buf.bytes[7]) == 0x48) { return false }
    if !(byte_u8(buf.bytes[9]) == 0xc3) { return false }
    if !(byte_u8(buf.bytes[10]) == 32) { return false }
    if !(byte_u8(buf.bytes[14]) == 0x48) { return false }
    if !(byte_u8(buf.bytes[15]) == 0x01) { return false }
    if !(byte_u8(buf.bytes[16]) == 0xd8) { return false }
    if !(byte_u8(buf.bytes[17]) == 0xc3) { return false }
    true
}

fn test_lower_ir_large_imm_uses_mov_imm64() -> bool with Mut, Panic, Div {
    // Ensure we don't truncate large constants: use mov r64, imm64 (48 b8+rd imm64).
    //
    // Pick a constant that does not fit in signed 32-bit:
    //   0x1122334455667788 = 1234605616436508552
    var buf = code_buffer_new()
    buf = lower_ir_instr(buf, ir_load_imm(0, 1234605616436508552))
    buf = lower_ir_instr(buf, ir_return(0))

    // Expected bytes:
    // 48 b8 88 77 66 55 44 33 22 11 c3
    if !(buf.len == 11) { return false }
    if !(byte_u8(buf.bytes[0]) == 0x48) { return false }
    if !(byte_u8(buf.bytes[1]) == 0xb8) { return false }
    if !(byte_u8(buf.bytes[2]) == 0x88) { return false }
    if !(byte_u8(buf.bytes[3]) == 0x77) { return false }
    if !(byte_u8(buf.bytes[4]) == 0x66) { return false }
    if !(byte_u8(buf.bytes[5]) == 0x55) { return false }
    if !(byte_u8(buf.bytes[6]) == 0x44) { return false }
    if !(byte_u8(buf.bytes[7]) == 0x33) { return false }
    if !(byte_u8(buf.bytes[8]) == 0x22) { return false }
    if !(byte_u8(buf.bytes[9]) == 0x11) { return false }
    if !(byte_u8(buf.bytes[10]) == 0xc3) { return false }
    true
}

fn run_native_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    let total: i64 = 3

    print("=== Native Encode Tests ===\n")

    if test_emit_exit_bytes() { passed = passed + 1; print("  T01 OK\n") } else { print("  FAIL: T01 emit_exit bytes\n") }

    if test_lower_ir_add_emits_expected_bytes() { passed = passed + 1; print("  T02 OK\n") } else { print("  FAIL: T02 lower_ir add bytes\n") }

    if test_lower_ir_large_imm_uses_mov_imm64() { passed = passed + 1; print("  T03 OK\n") } else { print("  FAIL: T03 lower_ir imm64 bytes\n") }

    print("\nNative tests: ")
    print_int(passed)
    print("/")
    print_int(total)
    print(" passed\n")

    if passed == total { 0 } else { 1 }
}
