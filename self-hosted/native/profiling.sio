fn test_prof_pass_multiple_invocations_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    let pid = prof_register_pass(ctx, prof_pass_optimize(), prof_name_optimize())
    // First invocation.
    prof_start_pass(ctx, pid, 0, 1000)
    prof_end_pass(ctx, pid, 200, 1500)
    // Second invocation.
    prof_start_pass(ctx, pid, 300, 1500)
    prof_end_pass(ctx, pid, 600, 2000)
    let inv = prof_pass_count(ctx, pid)
    if inv != 2 { return false }
    let delta = prof_pass_mem_delta(ctx, pid)
    // (1500-1000) + (2000-1500) = 500 + 500 = 1000
    if delta != 1000 { return false }
    true
}

fn test_prof_pass_multiple_invocations() -> bool with Mut, Div, Panic {
    var ctx = prof_context_new()
    test_prof_pass_multiple_invocations_inner(&! ctx)
}

fn test_prof_pass_timer_auto_alloc_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    // Registering a pass should auto-allocate a timer.
    let pid = prof_register_pass(ctx, prof_pass_ir(), prof_name_ir())
    // Timer count should be 1 (auto-allocated).
    if ctx.timer_count != 1 { return false }
    // The pass's timer_id should be 0.
    let tid = ctx.passes[pid as usize].timer_id
    if tid != 0 { return false }
    true
}

