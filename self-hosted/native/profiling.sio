fn test_prof_timer_invalid_id_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    // Negative ID should be handled gracefully.
    let ok = prof_start_timer(ctx, 0 - 1, 100)
    if ok == true { return false }
    let elapsed = prof_timer_elapsed(ctx, 0 - 1)
    if elapsed != 0 { return false }
    // Out-of-range ID.
    let ok2 = prof_start_timer(ctx, 999, 100)
    if ok2 == true { return false }
    true
}

