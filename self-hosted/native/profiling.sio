fn test_prof_find_function_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    prof_record_function(ctx, 100, 50, prof_pass_lexer())
    prof_record_function(ctx, 200, 75, prof_pass_parser())
    prof_record_function(ctx, 300, 25, prof_pass_check())
    let idx = prof_find_function(ctx, 200)
    if idx != 1 { return false }
    let missing = prof_find_function(ctx, 999)
    if missing != (0 - 1) { return false }
    true
}

fn test_prof_find_function() -> bool with Mut, Div, Panic {
    var ctx = prof_context_new()
    test_prof_find_function_inner(&! ctx)
}

