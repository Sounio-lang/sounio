fn test_prof_sort_by_time_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    let pid0 = prof_register_pass(ctx, prof_pass_lexer(), prof_name_lexer())
    let pid1 = prof_register_pass(ctx, prof_pass_parser(), prof_name_parser())
    let pid2 = prof_register_pass(ctx, prof_pass_check(), prof_name_check())
    prof_start_pass(ctx, pid0, 0, 0)
    prof_end_pass(ctx, pid0, 100, 0)
    prof_start_pass(ctx, pid1, 100, 0)
    prof_end_pass(ctx, pid1, 400, 0)
    prof_start_pass(ctx, pid2, 400, 0)
    prof_end_pass(ctx, pid2, 600, 0)
    prof_format_report(ctx)
    prof_sort_passes_by(ctx, prof_sort_by_time())
    // After sorting by time desc: parser(300), check(200), lexer(100).
    let t0 = prof_report_line_ticks(ctx, 0)
    let t1 = prof_report_line_ticks(ctx, 1)
    let t2 = prof_report_line_ticks(ctx, 2)
    if t0 != 300 { return false }
    if t1 != 200 { return false }
    if t2 != 100 { return false }
    true
}

