fn test_prof_mem_delta_negative_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    let pid = prof_register_pass(ctx, prof_pass_optimize(), prof_name_optimize())
    // Optimization frees memory: after < before.
    prof_start_pass(ctx, pid, 0, 8000)
    prof_end_pass(ctx, pid, 100, 5000)
    let delta = prof_pass_mem_delta(ctx, pid)
    // 5000 - 8000 = -3000
    delta == (0 - 3000)
}

