fn test_prof_name_eq_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    let a = prof_name_from_bytes(65 as i8, 66 as i8, 67 as i8, 0 as i8, 0 as i8, 0 as i8, 0 as i8, 0 as i8, 3)
    let b = prof_name_from_bytes(65 as i8, 66 as i8, 67 as i8, 0 as i8, 0 as i8, 0 as i8, 0 as i8, 0 as i8, 3)
    let c = prof_name_from_bytes(88 as i8, 89 as i8, 90 as i8, 0 as i8, 0 as i8, 0 as i8, 0 as i8, 0 as i8, 3)
    if prof_name_eq(&a, &b) == false { return false }
    if prof_name_eq(&a, &c) == true { return false }
    true
}

