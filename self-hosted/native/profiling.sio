fn test_prof_mark_hot_all_equal_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    // When all functions have the same ticks, marking at 50% threshold
    // should mark about half.
    prof_record_function(ctx, 1, 100, prof_pass_check())
    prof_record_function(ctx, 2, 100, prof_pass_check())
    prof_record_function(ctx, 3, 100, prof_pass_check())
    prof_record_function(ctx, 4, 100, prof_pass_check())
    // Total = 400. 50% = 200. Each is 100, so need 2 to reach 200.
    prof_mark_hot_functions(ctx, 50)
    let hot = prof_count_hot_functions(ctx)
    hot == 2
}

