fn test_prof_name_cmp_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    let a = prof_name_from_bytes(65 as i8, 66 as i8, 67 as i8, 0 as i8, 0 as i8, 0 as i8, 0 as i8, 0 as i8, 3)
    let b = prof_name_from_bytes(65 as i8, 66 as i8, 68 as i8, 0 as i8, 0 as i8, 0 as i8, 0 as i8, 0 as i8, 3)
    let cmp = prof_name_cmp(&a, &b)
    // 'C' (67) < 'D' (68), so cmp should be negative.
    if cmp >= 0 { return false }
    let cmp2 = prof_name_cmp(&a, &a)
    if cmp2 != 0 { return false }
    true
}

