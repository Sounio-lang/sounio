// ============================================================================
// Tests — 1. Timer operations (8 tests)
// ============================================================================

fn test_prof_timer_alloc_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    let id = prof_alloc_timer(ctx)
    if id != 0 { return false }
    if ctx.timer_count != 1 { return false }
    let state = prof_timer_state(ctx, id)
    if state != prof_timer_idle() { return false }
    true
}

fn test_prof_timer_alloc() -> bool with Mut, Div, Panic {
    var ctx = prof_context_new()
    test_prof_timer_alloc_inner(&! ctx)
}

fn test_prof_timer_start_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    let id = prof_alloc_timer(ctx)
    let ok = prof_start_timer(ctx, id, 1000)
    if ok == false { return false }
    let state = prof_timer_state(ctx, id)
    if state != prof_timer_running() { return false }
    true
}

fn test_prof_timer_start() -> bool with Mut, Div, Panic {
    var ctx = prof_context_new()
    test_prof_timer_start_inner(&! ctx)
}

fn test_prof_timer_stop_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    let id = prof_alloc_timer(ctx)
    let _s = prof_start_timer(ctx, id, 1000)
    let ok = prof_stop_timer(ctx, id, 1500)
    if ok == false { return false }
    let state = prof_timer_state(ctx, id)
    if state != prof_timer_stopped() { return false }
    let elapsed = prof_timer_elapsed(ctx, id)
    if elapsed != 500 { return false }
    true
}

fn test_prof_timer_stop() -> bool with Mut, Div, Panic {
    var ctx = prof_context_new()
    test_prof_timer_stop_inner(&! ctx)
}

fn test_prof_timer_elapsed_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    let id = prof_alloc_timer(ctx)
    let _s = prof_start_timer(ctx, id, 100)
    let _t = prof_stop_timer(ctx, id, 350)
    let elapsed = prof_timer_elapsed(ctx, id)
    elapsed == 250
}

fn test_prof_timer_elapsed() -> bool with Mut, Div, Panic {
    var ctx = prof_context_new()
    test_prof_timer_elapsed_inner(&! ctx)
}

fn test_prof_timer_multiple_invocations_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    let id = prof_alloc_timer(ctx)
    // First invocation: 100 ticks
    let _s1 = prof_start_timer(ctx, id, 0)
    let _t1 = prof_stop_timer(ctx, id, 100)
    // Second invocation: 200 ticks
    let _r1 = prof_restart_timer(ctx, id, 200)
    let _t2 = prof_stop_timer(ctx, id, 400)
    let elapsed = prof_timer_elapsed(ctx, id)
    if elapsed != 300 { return false }
    let inv = prof_timer_invocations(ctx, id)
    if inv != 2 { return false }
    true
}

fn test_prof_timer_multiple_invocations() -> bool with Mut, Div, Panic {
    var ctx = prof_context_new()
    test_prof_timer_multiple_invocations_inner(&! ctx)
}

fn test_prof_timer_alloc_multiple_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    let id0 = prof_alloc_timer(ctx)
    let id1 = prof_alloc_timer(ctx)
    let id2 = prof_alloc_timer(ctx)
    if id0 != 0 { return false }
    if id1 != 1 { return false }
    if id2 != 2 { return false }
    if ctx.timer_count != 3 { return false }
    true
}

fn test_prof_timer_alloc_multiple() -> bool with Mut, Div, Panic {
    var ctx = prof_context_new()
    test_prof_timer_alloc_multiple_inner(&! ctx)
}

fn test_prof_timer_double_start_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    let id = prof_alloc_timer(ctx)
    let ok1 = prof_start_timer(ctx, id, 100)
    if ok1 == false { return false }
    // Starting again while running should return false.
    let ok2 = prof_start_timer(ctx, id, 200)
    if ok2 == true { return false }
    true
}

fn test_prof_timer_double_start() -> bool with Mut, Div, Panic {
    var ctx = prof_context_new()
    test_prof_timer_double_start_inner(&! ctx)
}

fn test_prof_timer_reset_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    let id = prof_alloc_timer(ctx)
    let _s = prof_start_timer(ctx, id, 0)
    let _t = prof_stop_timer(ctx, id, 500)
    prof_reset_timer(ctx, id)
    let elapsed = prof_timer_elapsed(ctx, id)
    if elapsed != 0 { return false }
    let inv = prof_timer_invocations(ctx, id)
    if inv != 0 { return false }
    let state = prof_timer_state(ctx, id)
    if state != prof_timer_idle() { return false }
    true
}

fn test_prof_timer_reset() -> bool with Mut, Div, Panic {
    var ctx = prof_context_new()
    test_prof_timer_reset_inner(&! ctx)
}

