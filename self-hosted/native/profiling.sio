fn test_prof_reset_and_reuse_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    // First use.
    let pid = prof_register_pass(ctx, prof_pass_lexer(), prof_name_lexer())
    prof_start_pass(ctx, pid, 0, 0)
    prof_end_pass(ctx, pid, 500, 1000)
    prof_record_function(ctx, 42, 250, prof_pass_lexer())
    // Reset.
    prof_reset(ctx)
    // Second use: everything should work fresh.
    let pid2 = prof_register_pass(ctx, prof_pass_parser(), prof_name_parser())
    if pid2 != 0 { return false }
    prof_start_pass(ctx, pid2, 0, 0)
    prof_end_pass(ctx, pid2, 100, 500)
    let time = prof_pass_time(ctx, pid2)
    if time != 100 { return false }
    if ctx.pass_count != 1 { return false }
    if ctx.fn_count != 0 { return false }
    true
}

