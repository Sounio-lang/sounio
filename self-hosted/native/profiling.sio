fn test_prof_name_from_bytes_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    let name = prof_name_from_bytes(65 as i8, 66 as i8, 67 as i8, 0 as i8, 0 as i8, 0 as i8, 0 as i8, 0 as i8, 3)
    if name.len != 3 { return false }
    if name.buf[0 as usize] != (65 as i8) { return false }
    if name.buf[1 as usize] != (66 as i8) { return false }
    if name.buf[2 as usize] != (67 as i8) { return false }
    true
}

