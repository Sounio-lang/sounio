    var ctx = prof_context_new()
    test_prof_reset_and_reuse_inner(&! ctx)
}

// ============================================================================
// Tests — 8. Integration (6 tests)
// ============================================================================

fn test_prof_full_pipeline_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    // Simulate a full compilation profiling session.
    let pid_lex = prof_register_pass(ctx, prof_pass_lexer(), prof_name_lexer())
    let pid_parse = prof_register_pass(ctx, prof_pass_parser(), prof_name_parser())
    let pid_check = prof_register_pass(ctx, prof_pass_check(), prof_name_check())
    let pid_cg = prof_register_pass(ctx, prof_pass_codegen(), prof_name_codegen())

    // Lexer pass.
    prof_start_pass(ctx, pid_lex, 0, 0)
    prof_record_function(ctx, 1, 30, prof_pass_lexer())
    prof_record_function(ctx, 2, 20, prof_pass_lexer())
    prof_pass_add_function(ctx, pid_lex)
    prof_pass_add_function(ctx, pid_lex)
    prof_end_pass(ctx, pid_lex, 100, 500)

    // Parser pass.
    prof_start_pass(ctx, pid_parse, 100, 500)
    prof_record_function(ctx, 1, 50, prof_pass_parser())
    prof_record_function(ctx, 3, 80, prof_pass_parser())
    prof_pass_add_function(ctx, pid_parse)
    prof_pass_add_function(ctx, pid_parse)
    prof_end_pass(ctx, pid_parse, 400, 2000)

    // Check pass.
    prof_start_pass(ctx, pid_check, 400, 2000)
    prof_record_function(ctx, 1, 100, prof_pass_check())
    prof_record_function(ctx, 2, 60, prof_pass_check())
    prof_record_function(ctx, 3, 40, prof_pass_check())
    prof_pass_add_function(ctx, pid_check)
    prof_pass_add_function(ctx, pid_check)
    prof_pass_add_function(ctx, pid_check)
    prof_end_pass(ctx, pid_check, 700, 4000)

    // Codegen pass.
    prof_start_pass(ctx, pid_cg, 700, 4000)
    prof_record_function(ctx, 1, 80, prof_pass_codegen())
    prof_record_function(ctx, 2, 50, prof_pass_codegen())
    prof_pass_add_function(ctx, pid_cg)
    prof_pass_add_function(ctx, pid_cg)
    prof_end_pass(ctx, pid_cg, 1000, 5000)

    // Verify pass stats.
    if ctx.pass_count != 4 { return false }
    if prof_pass_functions_processed(ctx, pid_lex) != 2 { return false }
    if prof_pass_functions_processed(ctx, pid_parse) != 2 { return false }
    if prof_pass_functions_processed(ctx, pid_check) != 3 { return false }
    if prof_pass_functions_processed(ctx, pid_cg) != 2 { return false }

    // Verify function heat: function 1 appeared in all 4 passes.
    let idx1 = prof_find_function(ctx, 1)
    if idx1 < 0 { return false }
    let pc1 = prof_function_pass_count(ctx, idx1)
    if pc1 != 4 { return false }

    // Verify total ticks accumulated.
    let tt = prof_total_time(ctx)
    if tt == 0 { return false }

    true
}

fn test_prof_full_pipeline() -> bool with Mut, Div, Panic {
    var ctx = prof_context_new()
    test_prof_full_pipeline_inner(&! ctx)
}

fn test_prof_pipeline_with_sampling_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    let pid = prof_register_pass(ctx, prof_pass_lexer(), prof_name_lexer())
    prof_start_pass(ctx, pid, 0, 0)
    prof_add_sample(ctx, 0, 50, prof_pass_lexer())
    prof_add_sample(ctx, 0, 80, prof_pass_lexer())
    prof_add_sample(ctx, 0, 70, prof_pass_lexer())
    prof_end_pass(ctx, pid, 200, 1000)
    let avg = prof_average_sample(ctx, prof_pass_lexer())
    // (50 + 80 + 70) / 3 = 66
    if avg != 66 { return false }
    let mx = prof_max_sample(ctx, prof_pass_lexer())
    if mx != 80 { return false }
    true
}

fn test_prof_pipeline_with_sampling() -> bool with Mut, Div, Panic {
    var ctx = prof_context_new()
    test_prof_pipeline_with_sampling_inner(&! ctx)
}

fn test_prof_pipeline_report_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    let pid0 = prof_register_pass(ctx, prof_pass_lexer(), prof_name_lexer())
    let pid1 = prof_register_pass(ctx, prof_pass_parser(), prof_name_parser())
    let pid2 = prof_register_pass(ctx, prof_pass_codegen(), prof_name_codegen())
    prof_start_pass(ctx, pid0, 0, 0)
    prof_end_pass(ctx, pid0, 200, 500)
    prof_start_pass(ctx, pid1, 200, 500)
    prof_end_pass(ctx, pid1, 500, 1500)
    prof_start_pass(ctx, pid2, 500, 1500)
    prof_end_pass(ctx, pid2, 1000, 3000)
    prof_format_report(ctx)
    if prof_report_line_count(ctx) != 3 { return false }
    prof_sort_passes_by(ctx, prof_sort_by_time())
    // Codegen(500), parser(300), lexer(200).
    let t0 = prof_report_line_ticks(ctx, 0)
    if t0 != 500 { return false }
    true
}

fn test_prof_pipeline_report() -> bool with Mut, Div, Panic {
    var ctx = prof_context_new()
    test_prof_pipeline_report_inner(&! ctx)
}

fn test_prof_pipeline_hot_functions_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    // Create 5 functions with varying heat.
    prof_record_function(ctx, 10, 500, prof_pass_check())
    prof_record_function(ctx, 20, 200, prof_pass_check())
    prof_record_function(ctx, 30, 100, prof_pass_check())
    prof_record_function(ctx, 40, 50, prof_pass_check())
    prof_record_function(ctx, 50, 10, prof_pass_check())
    // Total = 860. Top 80% = 688.
    // Cumulative: 500, 700, 800 -> 3 functions needed.
    prof_mark_hot_functions(ctx, 80)
    let hot = prof_count_hot_functions(ctx)
    if hot != 3 { return false }
    // Top-N sort.
    let top = prof_top_hot_functions(ctx, 3)
    if top != 3 { return false }
    // After sort, index 0 should have hash 10 (500 ticks).
    if ctx.functions[0 as usize].fn_name_hash != 10 { return false }
    true
}

fn test_prof_pipeline_hot_functions() -> bool with Mut, Div, Panic {
    var ctx = prof_context_new()
    test_prof_pipeline_hot_functions_inner(&! ctx)
}

fn test_prof_pipeline_reset_cycle_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    // First compilation unit.
    let pid = prof_register_pass(ctx, prof_pass_lexer(), prof_name_lexer())
    prof_start_pass(ctx, pid, 0, 0)
    prof_end_pass(ctx, pid, 100, 1000)
    prof_record_function(ctx, 1, 80, prof_pass_lexer())
    prof_add_sample(ctx, 0, 90, prof_pass_lexer())
    // Reset for second unit.
    prof_reset(ctx)
    if ctx.pass_count != 0 { return false }
    if ctx.fn_count != 0 { return false }
    if ctx.sample_count != 0 { return false }
    if ctx.timer_count != 0 { return false }
    // Second compilation unit should work.
    let pid2 = prof_register_pass(ctx, prof_pass_parser(), prof_name_parser())
    prof_start_pass(ctx, pid2, 0, 0)
    prof_end_pass(ctx, pid2, 200, 500)
    let time = prof_pass_time(ctx, pid2)
    time == 200
}

fn test_prof_pipeline_reset_cycle() -> bool with Mut, Div, Panic {
    var ctx = prof_context_new()
    test_prof_pipeline_reset_cycle_inner(&! ctx)
}

fn test_prof_slowest_pass_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    let pid0 = prof_register_pass(ctx, prof_pass_lexer(), prof_name_lexer())
    let pid1 = prof_register_pass(ctx, prof_pass_parser(), prof_name_parser())
    let pid2 = prof_register_pass(ctx, prof_pass_check(), prof_name_check())
    prof_start_pass(ctx, pid0, 0, 0)
    prof_end_pass(ctx, pid0, 100, 0)
    prof_start_pass(ctx, pid1, 100, 0)
    prof_end_pass(ctx, pid1, 500, 0)
    prof_start_pass(ctx, pid2, 500, 0)
    prof_end_pass(ctx, pid2, 700, 0)
    let slowest = prof_slowest_pass(ctx)
    // Parser: 400, check: 200, lexer: 100
    slowest == 1
}

fn test_prof_slowest_pass() -> bool with Mut, Div, Panic {
    var ctx = prof_context_new()
    test_prof_slowest_pass_inner(&! ctx)
}

