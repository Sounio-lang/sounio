fn test_prof_pass_functions_processed_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    let pid = prof_register_pass(ctx, prof_pass_check(), prof_name_check())
    prof_pass_add_function(ctx, pid)
    prof_pass_add_function(ctx, pid)
    prof_pass_add_function(ctx, pid)
    let count = prof_pass_functions_processed(ctx, pid)
