    var ctx = prof_context_new()
    test_prof_sort_by_time_inner(&! ctx)
}

fn test_prof_sort_by_count_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    let pid0 = prof_register_pass(ctx, prof_pass_lexer(), prof_name_lexer())
    let pid1 = prof_register_pass(ctx, prof_pass_parser(), prof_name_parser())
    // lexer: 1 invocation, parser: 3 invocations.
    prof_start_pass(ctx, pid0, 0, 0)
    prof_end_pass(ctx, pid0, 100, 0)
    prof_start_pass(ctx, pid1, 100, 0)
    prof_end_pass(ctx, pid1, 200, 0)
    prof_start_pass(ctx, pid1, 200, 0)
    prof_end_pass(ctx, pid1, 300, 0)
    prof_start_pass(ctx, pid1, 300, 0)
    prof_end_pass(ctx, pid1, 400, 0)
    prof_format_report(ctx)
    prof_sort_passes_by(ctx, prof_sort_by_count())
    // Parser (3) should come before lexer (1).
    let inv0 = prof_report_line_invocations(ctx, 0)
    let inv1 = prof_report_line_invocations(ctx, 1)
    if inv0 != 3 { return false }
    if inv1 != 1 { return false }
    true
}

