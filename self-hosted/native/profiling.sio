    if test_prof_name_copy() == false { failures = failures + 1 }
    if test_prof_mark_hot_all_equal() == false { failures = failures + 1 }
    if test_prof_total_sample_count() == false { failures = failures + 1 }

    failures
}

// main removed — called from bootstrap main.sio via prof_run_all_tests()
