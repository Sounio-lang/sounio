// self-hosted::native::profiling — Compiler pass profiling
//
// Provides timing, memory tracking, hot function identification, sampling,
// and pass-level statistics for the Sounio compiler pipeline.  All state
// lives in flat fixed-size arrays (arena pattern) suitable for the bootstrap
// self-hosted compiler.
//
// Every struct and function uses the `prof_` prefix to avoid global
// namespace collisions with other self-hosted modules.
//
// Key capabilities:
//   - Timer allocation, start/stop, multi-invocation tracking
//   - Pass registration with kind/name, per-pass timing & memory
//   - Function heat tracking (hash-based), hot-function marking
//   - Sample collection per timer/pass kind, average computation
//   - Report generation with percentage and sorting
//   - Full reset for profiler reuse across compilation units

// ============================================================================
// Constants
// ============================================================================

let PROF_MAX_PASSES: i64 = 128
let PROF_MAX_FUNCTIONS: i64 = 2048
let PROF_MAX_TIMERS: i64 = 256
let PROF_MAX_SAMPLES: i64 = 1024
let PROF_MAX_NAME_LEN: i64 = 64
let PROF_TOP_N: i64 = 20
let PROF_NO_TIMER: i64 = 0 - 1
let PROF_NO_PASS: i64 = 0 - 1

// ============================================================================
// Enums — encoded as i64 tags
// ============================================================================

// ProfPassKind tags
fn prof_pass_lexer() -> i64 { 0 }
fn prof_pass_parser() -> i64 { 1 }
fn prof_pass_resolve() -> i64 { 2 }
fn prof_pass_check() -> i64 { 3 }
fn prof_pass_effects() -> i64 { 4 }
fn prof_pass_ir() -> i64 { 5 }
fn prof_pass_optimize() -> i64 { 6 }
fn prof_pass_codegen() -> i64 { 7 }
fn prof_pass_link() -> i64 { 8 }
fn prof_pass_lsp() -> i64 { 9 }
fn prof_pass_custom() -> i64 { 10 }

// ProfTimerState tags
fn prof_timer_idle() -> i64 { 0 }
fn prof_timer_running() -> i64 { 1 }
fn prof_timer_stopped() -> i64 { 2 }

// ProfSortBy tags
fn prof_sort_by_time() -> i64 { 0 }
fn prof_sort_by_count() -> i64 { 1 }
fn prof_sort_by_memory() -> i64 { 2 }
fn prof_sort_by_name() -> i64 { 3 }

// ============================================================================
// Data structures
// ============================================================================

// A fixed-length name buffer for pass/function names.
struct ProfNameBuf {
    buf: [i8; 64],
    len: i64,
}

// A single timer — tracks start tick, accumulated elapsed, invocations.
struct ProfTimer {
    id: i64,
    state: i64,
    start_tick: i64,
    elapsed_ticks: i64,
    invocations: i64,
}

// Per-pass statistics: kind, name, timing, memory, function count.
struct ProfPassStats {
    pass_kind: i64,
    name: ProfNameBuf,
    timer_id: i64,
    total_ticks: i64,
    invocations: i64,
    mem_before: i64,
    mem_after: i64,
    mem_delta: i64,
    functions_processed: i64,
}

// Per-function heat tracking: hash-keyed, accumulated timing, hot flag.
struct ProfFunctionHeat {
    fn_name_hash: i64,
    total_ticks: i64,
    pass_count: i64,
    max_single_pass: i64,
    is_hot: bool,
}

// A single timing sample associated with a timer and pass kind.
struct ProfSample {
    timer_id: i64,
    ticks: i64,
    pass_kind: i64,
}

// A single line of the profiling report.
struct ProfReportLine {
    name: ProfNameBuf,
    ticks: i64,
    pct_of_total: i64,
    invocations: i64,
    mem_delta: i64,
}

// The full profiling context — flat arena with all arrays.
struct ProfContext {
    passes: [ProfPassStats; 128],
    pass_count: i64,
    functions: [ProfFunctionHeat; 2048],
    fn_count: i64,
    timers: [ProfTimer; 256],
    timer_count: i64,
    samples: [ProfSample; 1024],
    sample_count: i64,
    report: [ProfReportLine; 128],
    report_count: i64,
    total_ticks: i64,
    total_mem_delta: i64,
    current_pass: i64,
    current_timer: i64,
}

// ============================================================================
// Constructors — element defaults
// ============================================================================

fn prof_name_buf_empty() -> ProfNameBuf {
    ProfNameBuf {
        buf: [0; 64],
        len: 0,
    }
}

fn prof_timer_empty() -> ProfTimer {
    ProfTimer {
        id: 0,
        state: prof_timer_idle(),
        start_tick: 0,
        elapsed_ticks: 0,
        invocations: 0,
    }
}

fn prof_pass_stats_empty() -> ProfPassStats {
    ProfPassStats {
        pass_kind: prof_pass_custom(),
        name: prof_name_buf_empty(),
        timer_id: PROF_NO_TIMER,
        total_ticks: 0,
        invocations: 0,
        mem_before: 0,
        mem_after: 0,
        mem_delta: 0,
        functions_processed: 0,
    }
}

fn prof_function_heat_empty() -> ProfFunctionHeat {
    ProfFunctionHeat {
        fn_name_hash: 0,
        total_ticks: 0,
        pass_count: 0,
        max_single_pass: 0,
        is_hot: false,
    }
}

fn prof_sample_empty() -> ProfSample {
    ProfSample {
        timer_id: 0,
        ticks: 0,
        pass_kind: 0,
    }
}

fn prof_report_line_empty() -> ProfReportLine {
    ProfReportLine {
        name: prof_name_buf_empty(),
        ticks: 0,
        pct_of_total: 0,
        invocations: 0,
        mem_delta: 0,
    }
}

// ============================================================================
// Context constructor
// ============================================================================

fn prof_context_new() -> ProfContext {
    ProfContext {
        passes: [prof_pass_stats_empty(); 128],
        pass_count: 0,
        functions: [prof_function_heat_empty(); 2048],
        fn_count: 0,
        timers: [prof_timer_empty(); 256],
        timer_count: 0,
        samples: [prof_sample_empty(); 1024],
        sample_count: 0,
        report: [prof_report_line_empty(); 128],
        report_count: 0,
        total_ticks: 0,
        total_mem_delta: 0,
        current_pass: PROF_NO_PASS,
        current_timer: PROF_NO_TIMER,
    }
}

// ============================================================================
// ProfNameBuf helpers (must precede callers)
// ============================================================================

// Create a name buffer from up to 8 individual bytes plus a count.
// count must be in [0, 8]; bytes beyond count are ignored.
fn prof_name_from_bytes(
    a: i8, b: i8, c: i8, d: i8,
    e: i8, f: i8, g: i8, h: i8,
    count: i64
) -> ProfNameBuf with Mut, Div, Panic {
    var name = prof_name_buf_empty()
    if count > PROF_MAX_NAME_LEN { return name }
    if count >= 1 { name.buf[0 as usize] = a }
    if count >= 2 { name.buf[1 as usize] = b }
    if count >= 3 { name.buf[2 as usize] = c }
    if count >= 4 { name.buf[3 as usize] = d }
    if count >= 5 { name.buf[4 as usize] = e }
    if count >= 6 { name.buf[5 as usize] = f }
    if count >= 7 { name.buf[6 as usize] = g }
    if count >= 8 { name.buf[7 as usize] = h }
    name.len = count
    name
}

// Compare two name buffers byte-by-byte.
fn prof_name_eq(a: &ProfNameBuf, b: &ProfNameBuf) -> bool with Mut, Div, Panic {
    if a.len != b.len { return false }
    var i: i64 = 0
    while i < a.len {
        if a.buf[i as usize] != b.buf[i as usize] { return false }
        i = i + 1
    }
    true
}

// Copy a name buffer (value semantics).
fn prof_name_copy(src: &ProfNameBuf) -> ProfNameBuf with Mut, Div, Panic {
    var dst = prof_name_buf_empty()
    var i: i64 = 0
    while i < src.len {
        dst.buf[i as usize] = src.buf[i as usize]
        i = i + 1
    }
    dst.len = src.len
    dst
}

// Return the first byte of a name, or 0 if empty.
fn prof_name_first_byte(name: &ProfNameBuf) -> i8 with Div, Panic {
    if name.len > 0 { name.buf[0 as usize] } else { 0 as i8 }
}

// Lexicographic comparison: returns negative if a < b, 0 if equal, positive if a > b.
fn prof_name_cmp(a: &ProfNameBuf, b: &ProfNameBuf) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    var min_len = a.len
    if b.len < min_len { min_len = b.len }
    while i < min_len {
        let diff = (a.buf[i as usize] as i64) - (b.buf[i as usize] as i64)
        if diff != 0 { return diff }
        i = i + 1
    }
    a.len - b.len
}

// ============================================================================
// Absolute value helper (must precede callers)
// ============================================================================

fn prof_abs(x: i64) -> i64 {
    if x < 0 { 0 - x } else { x }
}

// Min/Max helpers
fn prof_min(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

fn prof_max(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

// ============================================================================
// Timer operations
// ============================================================================

// Allocate a new timer, returning its ID. Returns -1 if full.
fn prof_alloc_timer(ctx: &! ProfContext) -> i64 with Mut, Div, Panic {
    if ctx.timer_count >= PROF_MAX_TIMERS { return 0 - 1 }
    let id = ctx.timer_count
    ctx.timers[id as usize] = ProfTimer {
        id: id,
        state: prof_timer_idle(),
        start_tick: 0,
        elapsed_ticks: 0,
        invocations: 0,
    }
    ctx.timer_count = ctx.timer_count + 1
    id
}

// Start the timer at the given tick. If already running, does nothing.
fn prof_start_timer(ctx: &! ProfContext, timer_id: i64, tick: i64) -> bool with Mut, Div, Panic {
    if timer_id < 0 { return false }
    if timer_id >= ctx.timer_count { return false }
    if ctx.timers[timer_id as usize].state == prof_timer_running() { return false }
    ctx.timers[timer_id as usize].state = prof_timer_running()
    ctx.timers[timer_id as usize].start_tick = tick
    true
}

// Stop the timer at the given tick. Accumulates elapsed ticks.
fn prof_stop_timer(ctx: &! ProfContext, timer_id: i64, tick: i64) -> bool with Mut, Div, Panic {
    if timer_id < 0 { return false }
    if timer_id >= ctx.timer_count { return false }
    if ctx.timers[timer_id as usize].state != prof_timer_running() { return false }
    let elapsed = tick - ctx.timers[timer_id as usize].start_tick
    ctx.timers[timer_id as usize].elapsed_ticks = ctx.timers[timer_id as usize].elapsed_ticks + elapsed
    ctx.timers[timer_id as usize].invocations = ctx.timers[timer_id as usize].invocations + 1
    ctx.timers[timer_id as usize].state = prof_timer_stopped()
    true
}

// Query the total elapsed ticks for a timer.
fn prof_timer_elapsed(ctx: &ProfContext, timer_id: i64) -> i64 with Div, Panic {
    if timer_id < 0 { return 0 }
    if timer_id >= ctx.timer_count { return 0 }
    ctx.timers[timer_id as usize].elapsed_ticks
}

// Query invocation count for a timer.
fn prof_timer_invocations(ctx: &ProfContext, timer_id: i64) -> i64 with Div, Panic {
    if timer_id < 0 { return 0 }
    if timer_id >= ctx.timer_count { return 0 }
    ctx.timers[timer_id as usize].invocations
}

// Query the state of a timer.
fn prof_timer_state(ctx: &ProfContext, timer_id: i64) -> i64 with Div, Panic {
    if timer_id < 0 { return prof_timer_idle() }
    if timer_id >= ctx.timer_count { return prof_timer_idle() }
    ctx.timers[timer_id as usize].state
}

// Reset a single timer to idle.
fn prof_reset_timer(ctx: &! ProfContext, timer_id: i64) with Mut, Div, Panic {
    if timer_id < 0 { return }
    if timer_id >= ctx.timer_count { return }
    ctx.timers[timer_id as usize].state = prof_timer_idle()
    ctx.timers[timer_id as usize].start_tick = 0
    ctx.timers[timer_id as usize].elapsed_ticks = 0
    ctx.timers[timer_id as usize].invocations = 0
}

// Restart a stopped timer (allows multiple invocations without re-allocating).
fn prof_restart_timer(ctx: &! ProfContext, timer_id: i64, tick: i64) -> bool with Mut, Div, Panic {
    if timer_id < 0 { return false }
    if timer_id >= ctx.timer_count { return false }
    // Only restart if stopped or idle
    let state = ctx.timers[timer_id as usize].state
    if state == prof_timer_running() { return false }
    ctx.timers[timer_id as usize].state = prof_timer_running()
    ctx.timers[timer_id as usize].start_tick = tick
    true
}

// ============================================================================
// Pass registration and tracking
// ============================================================================

// Register a new compiler pass. Returns the pass ID, or -1 if full.
fn prof_register_pass(ctx: &! ProfContext, kind: i64, name: ProfNameBuf) -> i64 with Mut, Div, Panic {
    if ctx.pass_count >= PROF_MAX_PASSES { return 0 - 1 }
    let id = ctx.pass_count
    let timer_id = prof_alloc_timer(ctx)
    ctx.passes[id as usize] = ProfPassStats {
        pass_kind: kind,
        name: name,
        timer_id: timer_id,
        total_ticks: 0,
        invocations: 0,
        mem_before: 0,
        mem_after: 0,
        mem_delta: 0,
        functions_processed: 0,
    }
    ctx.pass_count = ctx.pass_count + 1
    id
}

// Begin a pass invocation: record start tick, memory before, start timer.
fn prof_start_pass(ctx: &! ProfContext, pass_id: i64, tick: i64, mem: i64) with Mut, Div, Panic {
    if pass_id < 0 { return }
    if pass_id >= ctx.pass_count { return }
    ctx.passes[pass_id as usize].mem_before = mem
    ctx.current_pass = pass_id
    let tid = ctx.passes[pass_id as usize].timer_id
    // Restart (not just start) so timer accumulates across invocations.
    let _ok = prof_restart_timer(ctx, tid, tick)
}

// End a pass invocation: record end tick, memory after, stop timer, compute delta.
fn prof_end_pass(ctx: &! ProfContext, pass_id: i64, tick: i64, mem: i64) with Mut, Div, Panic {
    if pass_id < 0 { return }
    if pass_id >= ctx.pass_count { return }
    let tid = ctx.passes[pass_id as usize].timer_id
    let _ok = prof_stop_timer(ctx, tid, tick)
    let elapsed = prof_timer_elapsed(ctx, tid)
    ctx.passes[pass_id as usize].total_ticks = elapsed
    ctx.passes[pass_id as usize].mem_after = mem
    let delta = mem - ctx.passes[pass_id as usize].mem_before
    ctx.passes[pass_id as usize].mem_delta = ctx.passes[pass_id as usize].mem_delta + delta
    ctx.passes[pass_id as usize].invocations = ctx.passes[pass_id as usize].invocations + 1
    // Accumulate into total ticks and memory delta.
    ctx.total_ticks = ctx.total_ticks + (tick - ctx.timers[tid as usize].start_tick)
    ctx.total_mem_delta = ctx.total_mem_delta + delta
    ctx.current_pass = PROF_NO_PASS
}

// Record that a pass processed one more function.
fn prof_pass_add_function(ctx: &! ProfContext, pass_id: i64) with Mut, Div, Panic {
    if pass_id < 0 { return }
    if pass_id >= ctx.pass_count { return }
    ctx.passes[pass_id as usize].functions_processed = ctx.passes[pass_id as usize].functions_processed + 1
}

// Query total ticks for a pass.
fn prof_pass_time(ctx: &ProfContext, pass_id: i64) -> i64 with Div, Panic {
    if pass_id < 0 { return 0 }
    if pass_id >= ctx.pass_count { return 0 }
    ctx.passes[pass_id as usize].total_ticks
}

// Query invocation count for a pass.
fn prof_pass_count(ctx: &ProfContext, pass_id: i64) -> i64 with Div, Panic {
    if pass_id < 0 { return 0 }
    if pass_id >= ctx.pass_count { return 0 }
    ctx.passes[pass_id as usize].invocations
}

// Query memory delta for a pass.
fn prof_pass_mem_delta(ctx: &ProfContext, pass_id: i64) -> i64 with Div, Panic {
    if pass_id < 0 { return 0 }
    if pass_id >= ctx.pass_count { return 0 }
    ctx.passes[pass_id as usize].mem_delta
}

// Query the pass kind.
fn prof_pass_kind(ctx: &ProfContext, pass_id: i64) -> i64 with Div, Panic {
    if pass_id < 0 { return prof_pass_custom() }
    if pass_id >= ctx.pass_count { return prof_pass_custom() }
    ctx.passes[pass_id as usize].pass_kind
}

// Query functions processed by a pass.
fn prof_pass_functions_processed(ctx: &ProfContext, pass_id: i64) -> i64 with Div, Panic {
    if pass_id < 0 { return 0 }
    if pass_id >= ctx.pass_count { return 0 }
    ctx.passes[pass_id as usize].functions_processed
}

// ============================================================================
// Function heat tracking
// ============================================================================

// Find a function by hash. Returns the index, or -1 if not found.
fn prof_find_function(ctx: &ProfContext, fn_hash: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.fn_count {
        if ctx.functions[i as usize].fn_name_hash == fn_hash {
            return i
        }
        i = i + 1
    }
    0 - 1
}

// Record a function timing event. Creates a new entry if the hash is unseen.
fn prof_record_function(ctx: &! ProfContext, fn_hash: i64, ticks: i64, pass_kind: i64) with Mut, Div, Panic {
    // Try to find existing entry.
    var idx: i64 = 0 - 1
    var i: i64 = 0
    while i < ctx.fn_count {
        if ctx.functions[i as usize].fn_name_hash == fn_hash {
            idx = i
            // break: set i to fn_count to exit loop
            i = ctx.fn_count
        } else {
            i = i + 1
        }
    }
    if idx < 0 {
        // Allocate new slot.
        if ctx.fn_count >= PROF_MAX_FUNCTIONS { return }
        idx = ctx.fn_count
        ctx.functions[idx as usize] = ProfFunctionHeat {
            fn_name_hash: fn_hash,
            total_ticks: 0,
            pass_count: 0,
            max_single_pass: 0,
            is_hot: false,
        }
        ctx.fn_count = ctx.fn_count + 1
    }
    ctx.functions[idx as usize].total_ticks = ctx.functions[idx as usize].total_ticks + ticks
    ctx.functions[idx as usize].pass_count = ctx.functions[idx as usize].pass_count + 1
    if ticks > ctx.functions[idx as usize].max_single_pass {
        ctx.functions[idx as usize].max_single_pass = ticks
    }
}

// Query function heat by index.
fn prof_function_ticks(ctx: &ProfContext, idx: i64) -> i64 with Div, Panic {
    if idx < 0 { return 0 }
    if idx >= ctx.fn_count { return 0 }
    ctx.functions[idx as usize].total_ticks
}

// Query function pass count by index.
fn prof_function_pass_count(ctx: &ProfContext, idx: i64) -> i64 with Div, Panic {
    if idx < 0 { return 0 }
    if idx >= ctx.fn_count { return 0 }
    ctx.functions[idx as usize].pass_count
}

// Query if a function is hot.
fn prof_function_is_hot(ctx: &ProfContext, idx: i64) -> bool with Div, Panic {
    if idx < 0 { return false }
    if idx >= ctx.fn_count { return false }
    ctx.functions[idx as usize].is_hot
}

// Query the max single pass for a function.
fn prof_function_max_pass(ctx: &ProfContext, idx: i64) -> i64 with Div, Panic {
    if idx < 0 { return 0 }
    if idx >= ctx.fn_count { return 0 }
    ctx.functions[idx as usize].max_single_pass
}

// Compute the sum of all function ticks (for threshold calculations).
fn prof_total_function_ticks(ctx: &ProfContext) -> i64 with Mut, Div, Panic {
    var total: i64 = 0
    var i: i64 = 0
    while i < ctx.fn_count {
        total = total + ctx.functions[i as usize].total_ticks
        i = i + 1
    }
    total
}

// Mark functions whose cumulative ticks exceed threshold_pct of total as hot.
// threshold_pct is an integer percentage (e.g. 80 means top 80%).
fn prof_mark_hot_functions(ctx: &! ProfContext, threshold_pct: i64) with Mut, Div, Panic {
    let total = prof_total_function_ticks(ctx)
    if total == 0 { return }
    // First, clear all hot flags.
    var i: i64 = 0
    while i < ctx.fn_count {
        ctx.functions[i as usize].is_hot = false
        i = i + 1
    }
    // Sort indices by total_ticks descending via simple selection.
    // We use a temporary ordering array approach with in-place marking.
    // Since we cannot return arrays, we do a multi-pass scan:
    //   on each pass, find the largest unmarked entry, mark it hot,
    //   and accumulate until we hit threshold_pct of total.
    let threshold = total * threshold_pct / 100
    var accumulated: i64 = 0
    var marked: i64 = 0
    while accumulated < threshold {
        if marked >= ctx.fn_count { return }
        // Find the entry with the largest total_ticks that is not yet hot.
        var best_idx: i64 = 0 - 1
        var best_ticks: i64 = 0 - 1
        var j: i64 = 0
        while j < ctx.fn_count {
            if ctx.functions[j as usize].is_hot == false {
                if ctx.functions[j as usize].total_ticks > best_ticks {
                    best_ticks = ctx.functions[j as usize].total_ticks
                    best_idx = j
                }
            }
            j = j + 1
        }
        if best_idx < 0 { return }
        ctx.functions[best_idx as usize].is_hot = true
        accumulated = accumulated + best_ticks
        marked = marked + 1
    }
}

// Sort functions by total_ticks descending (insertion sort) and return
// the count of hot functions (up to n).
fn prof_top_hot_functions(ctx: &! ProfContext, n: i64) -> i64 with Mut, Div, Panic {
    // Insertion sort functions by total_ticks descending.
    var i: i64 = 1
    while i < ctx.fn_count {
        let key = ctx.functions[i as usize]
        var j = i - 1
        while j >= 0 {
            if ctx.functions[j as usize].total_ticks < key.total_ticks {
                ctx.functions[(j + 1) as usize] = ctx.functions[j as usize]
                j = j - 1
            } else {
                // break
                j = 0 - 1
            }
        }
        ctx.functions[(j + 1) as usize] = key
        i = i + 1
    }
    // Return min(n, fn_count).
    if n < ctx.fn_count { n } else { ctx.fn_count }
}

// Count how many functions are currently marked hot.
fn prof_count_hot_functions(ctx: &ProfContext) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.fn_count {
        if ctx.functions[i as usize].is_hot { count = count + 1 }
        i = i + 1
    }
    count
}

// ============================================================================
// Aggregate queries
// ============================================================================

// Total accumulated ticks across all passes.
fn prof_total_time(ctx: &ProfContext) -> i64 {
    ctx.total_ticks
}

// Total accumulated memory delta across all passes.
fn prof_total_memory_delta(ctx: &ProfContext) -> i64 {
    ctx.total_mem_delta
}

// Compute total ticks by summing all pass total_ticks (alternative to incremental).
fn prof_compute_total_time(ctx: &ProfContext) -> i64 with Mut, Div, Panic {
    var total: i64 = 0
    var i: i64 = 0
    while i < ctx.pass_count {
        total = total + ctx.passes[i as usize].total_ticks
        i = i + 1
    }
    total
}

// Compute total memory delta by summing all pass mem_deltas.
fn prof_compute_total_mem_delta(ctx: &ProfContext) -> i64 with Mut, Div, Panic {
    var total: i64 = 0
    var i: i64 = 0
    while i < ctx.pass_count {
        total = total + ctx.passes[i as usize].mem_delta
        i = i + 1
    }
    total
}

// Find the pass with the highest total_ticks. Returns pass_id or -1.
fn prof_slowest_pass(ctx: &ProfContext) -> i64 with Mut, Div, Panic {
    if ctx.pass_count == 0 { return 0 - 1 }
    var best_id: i64 = 0
    var best_ticks: i64 = ctx.passes[0 as usize].total_ticks
    var i: i64 = 1
    while i < ctx.pass_count {
        if ctx.passes[i as usize].total_ticks > best_ticks {
            best_ticks = ctx.passes[i as usize].total_ticks
            best_id = i
        }
        i = i + 1
    }
    best_id
}

// Find the pass with the largest memory delta. Returns pass_id or -1.
fn prof_largest_mem_pass(ctx: &ProfContext) -> i64 with Mut, Div, Panic {
    if ctx.pass_count == 0 { return 0 - 1 }
    var best_id: i64 = 0
    var best_delta: i64 = prof_abs(ctx.passes[0 as usize].mem_delta)
    var i: i64 = 1
    while i < ctx.pass_count {
        let d = prof_abs(ctx.passes[i as usize].mem_delta)
        if d > best_delta {
            best_delta = d
            best_id = i
        }
        i = i + 1
    }
    best_id
}

// ============================================================================
// Sampling
// ============================================================================

// Add a timing sample.
fn prof_add_sample(ctx: &! ProfContext, timer_id: i64, ticks: i64, kind: i64) with Mut, Div, Panic {
    if ctx.sample_count >= PROF_MAX_SAMPLES { return }
    ctx.samples[ctx.sample_count as usize] = ProfSample {
        timer_id: timer_id,
        ticks: ticks,
        pass_kind: kind,
    }
    ctx.sample_count = ctx.sample_count + 1
}

// Compute the average sample ticks for a given pass kind.
// Returns 0 if no samples match.
fn prof_average_sample(ctx: &ProfContext, pass_kind: i64) -> i64 with Mut, Div, Panic {
    var sum: i64 = 0
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.sample_count {
        if ctx.samples[i as usize].pass_kind == pass_kind {
            sum = sum + ctx.samples[i as usize].ticks
            count = count + 1
        }
        i = i + 1
    }
    if count == 0 { return 0 }
    sum / count
}

// Compute the max sample ticks for a given pass kind.
fn prof_max_sample(ctx: &ProfContext, pass_kind: i64) -> i64 with Mut, Div, Panic {
    var mx: i64 = 0
    var i: i64 = 0
    while i < ctx.sample_count {
        if ctx.samples[i as usize].pass_kind == pass_kind {
            if ctx.samples[i as usize].ticks > mx {
                mx = ctx.samples[i as usize].ticks
            }
        }
        i = i + 1
    }
    mx
}

// Compute the min sample ticks for a given pass kind (returns 0 if none).
fn prof_min_sample(ctx: &ProfContext, pass_kind: i64) -> i64 with Mut, Div, Panic {
    var mn: i64 = 0
    var found: bool = false
    var i: i64 = 0
    while i < ctx.sample_count {
        if ctx.samples[i as usize].pass_kind == pass_kind {
            if found == false {
                mn = ctx.samples[i as usize].ticks
                found = true
            } else {
                if ctx.samples[i as usize].ticks < mn {
                    mn = ctx.samples[i as usize].ticks
                }
            }
        }
        i = i + 1
    }
    mn
}

// Count samples for a given pass kind.
fn prof_count_samples(ctx: &ProfContext, pass_kind: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.sample_count {
        if ctx.samples[i as usize].pass_kind == pass_kind {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Count total samples.
fn prof_total_sample_count(ctx: &ProfContext) -> i64 {
    ctx.sample_count
}

// ============================================================================
// Reporting
// ============================================================================

// Build report lines from the current pass stats.
fn prof_format_report(ctx: &! ProfContext) with Mut, Div, Panic {
    ctx.report_count = 0
    // Compute total ticks for percentage.
    var total: i64 = 0
    var i: i64 = 0
    while i < ctx.pass_count {
        total = total + ctx.passes[i as usize].total_ticks
        i = i + 1
    }
    // Build one report line per pass.
    i = 0
    while i < ctx.pass_count {
        if ctx.report_count >= PROF_MAX_PASSES { return }
        var pct: i64 = 0
        if total > 0 {
            pct = ctx.passes[i as usize].total_ticks * 100 / total
        }
        ctx.report[ctx.report_count as usize] = ProfReportLine {
            name: ctx.passes[i as usize].name,
            ticks: ctx.passes[i as usize].total_ticks,
            pct_of_total: pct,
            invocations: ctx.passes[i as usize].invocations,
            mem_delta: ctx.passes[i as usize].mem_delta,
        }
        ctx.report_count = ctx.report_count + 1
        i = i + 1
    }
}

// Query the number of report lines.
fn prof_report_line_count(ctx: &ProfContext) -> i64 {
    ctx.report_count
}

// Query a specific report line's ticks.
fn prof_report_line_ticks(ctx: &ProfContext, idx: i64) -> i64 with Div, Panic {
    if idx < 0 { return 0 }
    if idx >= ctx.report_count { return 0 }
    ctx.report[idx as usize].ticks
}

// Query a specific report line's percentage.
fn prof_report_line_pct(ctx: &ProfContext, idx: i64) -> i64 with Div, Panic {
    if idx < 0 { return 0 }
    if idx >= ctx.report_count { return 0 }
    ctx.report[idx as usize].pct_of_total
}

// Query a specific report line's invocation count.
fn prof_report_line_invocations(ctx: &ProfContext, idx: i64) -> i64 with Div, Panic {
    if idx < 0 { return 0 }
    if idx >= ctx.report_count { return 0 }
    ctx.report[idx as usize].invocations
}

// Query a specific report line's memory delta.
fn prof_report_line_mem_delta(ctx: &ProfContext, idx: i64) -> i64 with Div, Panic {
    if idx < 0 { return 0 }
    if idx >= ctx.report_count { return 0 }
    ctx.report[idx as usize].mem_delta
}

// ============================================================================
// Report sorting
// ============================================================================

// Swap two report lines by index.
fn prof_swap_report_lines(ctx: &! ProfContext, a: i64, b: i64) with Mut, Div, Panic {
    if a < 0 { return }
    if b < 0 { return }
    if a >= ctx.report_count { return }
    if b >= ctx.report_count { return }
    let tmp = ctx.report[a as usize]
    ctx.report[a as usize] = ctx.report[b as usize]
    ctx.report[b as usize] = tmp
}

// Compare two report lines for the given sort criterion.
// Returns true if the line at index a should come before line at index b.
fn prof_report_less(ctx: &ProfContext, a: i64, b: i64, sort_by: i64) -> bool with Mut, Div, Panic {
    if sort_by == prof_sort_by_time() {
        // Sort descending by ticks.
        return ctx.report[a as usize].ticks > ctx.report[b as usize].ticks
    }
    if sort_by == prof_sort_by_count() {
        // Sort descending by invocations.
        return ctx.report[a as usize].invocations > ctx.report[b as usize].invocations
    }
    if sort_by == prof_sort_by_memory() {
        // Sort descending by absolute memory delta.
        return prof_abs(ctx.report[a as usize].mem_delta) > prof_abs(ctx.report[b as usize].mem_delta)
    }
    if sort_by == prof_sort_by_name() {
        // Sort ascending by name (lexicographic).
        let cmp = prof_name_cmp(&ctx.report[a as usize].name, &ctx.report[b as usize].name)
        return cmp < 0
    }
    false
}

// Sort report lines by the given criterion (insertion sort).
fn prof_sort_passes_by(ctx: &! ProfContext, sort_by: i64) with Mut, Div, Panic {
    var i: i64 = 1
    while i < ctx.report_count {
        let key = ctx.report[i as usize]
        var j = i - 1
        while j >= 0 {
            if prof_report_less(ctx, i, j, sort_by) == false {
                // key should not precede j, break
                j = 0 - 1
            } else {
                j = j - 1
            }
        }
        // Actually sort: use insertion sort with value threading.
        // Re-do with standard insertion sort pattern.
        j = i - 1
        var inserted: bool = false
        while j >= 0 {
            if inserted == false {
                // Compare key against element at j.
                var should_shift: bool = false
                if sort_by == prof_sort_by_time() {
                    should_shift = ctx.report[j as usize].ticks < key.ticks
                } else if sort_by == prof_sort_by_count() {
                    should_shift = ctx.report[j as usize].invocations < key.invocations
                } else if sort_by == prof_sort_by_memory() {
                    should_shift = prof_abs(ctx.report[j as usize].mem_delta) < prof_abs(key.mem_delta)
                } else if sort_by == prof_sort_by_name() {
                    let cmp = prof_name_cmp(&ctx.report[j as usize].name, &key.name)
                    should_shift = cmp > 0
                }
                if should_shift {
                    ctx.report[(j + 1) as usize] = ctx.report[j as usize]
                    j = j - 1
                } else {
                    ctx.report[(j + 1) as usize] = key
                    inserted = true
                    j = 0 - 1
                }
            } else {
                j = 0 - 1
            }
        }
        if inserted == false {
            ctx.report[0 as usize] = key
        }
        i = i + 1
    }
}

// ============================================================================
// Reset
// ============================================================================

// Reset the entire profiling context for reuse.
fn prof_reset(ctx: &! ProfContext) with Mut, Div, Panic {
    // Clear passes.
    var i: i64 = 0
    while i < ctx.pass_count {
        ctx.passes[i as usize] = prof_pass_stats_empty()
        i = i + 1
    }
    ctx.pass_count = 0
    // Clear functions.
    i = 0
    while i < ctx.fn_count {
        ctx.functions[i as usize] = prof_function_heat_empty()
        i = i + 1
    }
    ctx.fn_count = 0
    // Clear timers.
    i = 0
    while i < ctx.timer_count {
        ctx.timers[i as usize] = prof_timer_empty()
        i = i + 1
    }
    ctx.timer_count = 0
    // Clear samples.
    i = 0
    while i < ctx.sample_count {
        ctx.samples[i as usize] = prof_sample_empty()
        i = i + 1
    }
    ctx.sample_count = 0
    // Clear report.
    i = 0
    while i < ctx.report_count {
        ctx.report[i as usize] = prof_report_line_empty()
        i = i + 1
    }
    ctx.report_count = 0
    // Reset totals.
    ctx.total_ticks = 0
    ctx.total_mem_delta = 0
    ctx.current_pass = PROF_NO_PASS
    ctx.current_timer = PROF_NO_TIMER
}

