fn test_prof_sort_by_name_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    // Register in reverse alphabetical order.
    let pid0 = prof_register_pass(ctx, prof_pass_parser(), prof_name_parser())
    let pid1 = prof_register_pass(ctx, prof_pass_lexer(), prof_name_lexer())
    let pid2 = prof_register_pass(ctx, prof_pass_check(), prof_name_check())
    prof_start_pass(ctx, pid0, 0, 0)
    prof_end_pass(ctx, pid0, 100, 0)
    prof_start_pass(ctx, pid1, 100, 0)
    prof_end_pass(ctx, pid1, 200, 0)
    prof_start_pass(ctx, pid2, 200, 0)
    prof_end_pass(ctx, pid2, 300, 0)
    prof_format_report(ctx)
    prof_sort_passes_by(ctx, prof_sort_by_name())
    // Alphabetical: check, lexer, parser.
    // 'c' < 'l' < 'p'.
    let name0_byte = prof_name_first_byte(&ctx.report[0 as usize].name)
    let name1_byte = prof_name_first_byte(&ctx.report[1 as usize].name)
    let name2_byte = prof_name_first_byte(&ctx.report[2 as usize].name)
    // 'c' = 99, 'l' = 108, 'p' = 112
    if (name0_byte as i64) != 99 { return false }
    if (name1_byte as i64) != 108 { return false }
    if (name2_byte as i64) != 112 { return false }
    true
}

fn test_prof_sort_by_name() -> bool with Mut, Div, Panic {
    var ctx = prof_context_new()
    test_prof_sort_by_name_inner(&! ctx)
}

