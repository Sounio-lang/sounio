fn test_prof_mark_hot_functions_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    // Create functions with distinct tick counts.
    // Total = 100 + 50 + 30 + 20 = 200
    // Top 80% threshold = 160 ticks. Need to mark top functions until >= 160.
    // Sorted desc: 100, 50, 30, 20
    // Cumulative: 100 (50%), 150 (75%), 180 (90%)  -> 3 functions marked at 80%.
    prof_record_function(ctx, 1, 100, prof_pass_check())
    prof_record_function(ctx, 2, 50, prof_pass_check())
    prof_record_function(ctx, 3, 30, prof_pass_check())
    prof_record_function(ctx, 4, 20, prof_pass_check())
    prof_mark_hot_functions(ctx, 80)
    let hot_count = prof_count_hot_functions(ctx)
    // Should be 3 (100+50+30=180 >= 160)
    if hot_count != 3 { return false }
    // The function with 20 ticks should NOT be hot.
    let idx_4 = prof_find_function(ctx, 4)
    let is_hot_4 = prof_function_is_hot(ctx, idx_4)
    if is_hot_4 == true { return false }
    true
}

fn test_prof_mark_hot_functions() -> bool with Mut, Div, Panic {
    var ctx = prof_context_new()
    test_prof_mark_hot_functions_inner(&! ctx)
}

fn test_prof_top_hot_functions_inner(ctx: &! ProfContext) -> bool with Mut, Div, Panic {
    prof_record_function(ctx, 10, 50, prof_pass_lexer())
    prof_record_function(ctx, 20, 300, prof_pass_parser())
    prof_record_function(ctx, 30, 100, prof_pass_check())
    let top = prof_top_hot_functions(ctx, 2)
    if top != 2 { return false }
    // After sorting, index 0 should have the highest ticks (300).
    let t0 = prof_function_ticks(ctx, 0)
    if t0 != 300 { return false }
    // Index 1 should have 100.
    let t1 = prof_function_ticks(ctx, 1)
    if t1 != 100 { return false }
    true
}

fn test_prof_top_hot_functions() -> bool with Mut, Div, Panic {
    var ctx = prof_context_new()
    test_prof_top_hot_functions_inner(&! ctx)
}

