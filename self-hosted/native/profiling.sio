// ============================================================================
// Main — run all tests
// ============================================================================

fn prof_run_all_tests() -> i64 with Mut, Div, Panic {
    var failures: i64 = 0

    // Timer operations (8 tests)
    if test_prof_timer_alloc() == false { failures = failures + 1 }
    if test_prof_timer_start() == false { failures = failures + 1 }
    if test_prof_timer_stop() == false { failures = failures + 1 }
    if test_prof_timer_elapsed() == false { failures = failures + 1 }
    if test_prof_timer_multiple_invocations() == false { failures = failures + 1 }
    if test_prof_timer_alloc_multiple() == false { failures = failures + 1 }
    if test_prof_timer_double_start() == false { failures = failures + 1 }
    if test_prof_timer_reset() == false { failures = failures + 1 }

    // Pass registration (8 tests)
    if test_prof_register_pass() == false { failures = failures + 1 }
    if test_prof_register_multiple_passes() == false { failures = failures + 1 }
    if test_prof_pass_start_end() == false { failures = failures + 1 }
    if test_prof_pass_mem_delta() == false { failures = failures + 1 }
    if test_prof_pass_kind_query() == false { failures = failures + 1 }
    if test_prof_pass_functions_processed() == false { failures = failures + 1 }
    if test_prof_pass_multiple_invocations() == false { failures = failures + 1 }
    if test_prof_pass_timer_auto_alloc() == false { failures = failures + 1 }

    // Function heat (8 tests)
    if test_prof_record_function() == false { failures = failures + 1 }
    if test_prof_record_function_accumulate() == false { failures = failures + 1 }
    if test_prof_find_function() == false { failures = failures + 1 }
    if test_prof_function_max_pass() == false { failures = failures + 1 }
    if test_prof_mark_hot_functions() == false { failures = failures + 1 }
    if test_prof_top_hot_functions() == false { failures = failures + 1 }
    if test_prof_function_not_hot_by_default() == false { failures = failures + 1 }
    if test_prof_total_function_ticks() == false { failures = failures + 1 }

    // Sampling (6 tests)
    if test_prof_add_sample() == false { failures = failures + 1 }
    if test_prof_add_multiple_samples() == false { failures = failures + 1 }
    if test_prof_average_sample() == false { failures = failures + 1 }
    if test_prof_average_sample_by_kind() == false { failures = failures + 1 }
    if test_prof_max_sample() == false { failures = failures + 1 }
    if test_prof_count_samples() == false { failures = failures + 1 }

    // Reporting (8 tests)
    if test_prof_format_report() == false { failures = failures + 1 }
    if test_prof_report_percentages() == false { failures = failures + 1 }
    if test_prof_report_ticks() == false { failures = failures + 1 }
    if test_prof_report_invocations() == false { failures = failures + 1 }
    if test_prof_report_mem_delta() == false { failures = failures + 1 }
    if test_prof_sort_by_time() == false { failures = failures + 1 }
    if test_prof_sort_by_count() == false { failures = failures + 1 }
    if test_prof_sort_by_memory() == false { failures = failures + 1 }

    // Memory tracking (6 tests)
    if test_prof_mem_delta_positive() == false { failures = failures + 1 }
    if test_prof_mem_delta_negative() == false { failures = failures + 1 }
    if test_prof_mem_delta_zero() == false { failures = failures + 1 }
    if test_prof_total_mem_delta() == false { failures = failures + 1 }
    if test_prof_per_pass_mem_independent() == false { failures = failures + 1 }
    if test_prof_largest_mem_pass() == false { failures = failures + 1 }

    // Reset/reuse (5 tests)
    if test_prof_reset_clears_passes() == false { failures = failures + 1 }
    if test_prof_reset_clears_timers() == false { failures = failures + 1 }
    if test_prof_reset_clears_functions() == false { failures = failures + 1 }
    if test_prof_reset_clears_samples() == false { failures = failures + 1 }
    if test_prof_reset_and_reuse() == false { failures = failures + 1 }

    // Integration (6 tests)
