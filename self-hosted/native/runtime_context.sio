// self-hosted::native::runtime_context — Native runtime context layout
//
// Long-lived runtime state lives in a memory-backed context block at the front
// of the mmap'd runtime region. Native code reaches that block through a
// relocatable global slot stored in .data.

module native::runtime_context

fn runtime_context_field_heap_base() -> i64 { 0 }
fn runtime_context_field_heap_cursor() -> i64 { 8 }
fn runtime_context_field_heap_limit() -> i64 { 16 }
fn runtime_context_field_handle_table_base() -> i64 { 24 }
fn runtime_context_field_handle_count() -> i64 { 32 }
fn runtime_context_field_handle_capacity() -> i64 { 40 }
fn runtime_context_field_descriptor_table() -> i64 { 48 }
fn runtime_context_field_descriptor_count() -> i64 { 56 }
fn runtime_context_field_pin_registry() -> i64 { 64 }
fn runtime_context_field_pin_count() -> i64 { 72 }
fn runtime_context_field_argc() -> i64 { 80 }
fn runtime_context_field_argv_ptr() -> i64 { 88 }
fn runtime_context_field_stdout_fd() -> i64 { 96 }
fn runtime_context_field_stderr_fd() -> i64 { 104 }
fn runtime_context_field_simd_capability_mask() -> i64 { 112 }
fn runtime_context_field_gc_state() -> i64 { 120 }
fn runtime_context_field_stack_maps() -> i64 { 128 }
fn runtime_context_field_deopt_state() -> i64 { 136 }
fn runtime_context_field_gpu_ctx() -> i64 { 144 }
fn runtime_context_field_render_ctx() -> i64 { 152 }
fn runtime_context_field_provenance() -> i64 { 160 }
fn runtime_context_field_collector_epoch() -> i64 { 168 }
fn runtime_context_field_last_gc_stats() -> i64 { 176 }

// Windows-specific fields (set by Windows entry trampoline, zero on Linux/macOS)
fn runtime_context_field_os_id() -> i64 { 184 }           // 1=Linux, 2=macOS, 3=Windows
fn runtime_context_field_win_stdout_handle() -> i64 { 192 } // HANDLE from GetStdHandle(-11)
fn runtime_context_field_win_stderr_handle() -> i64 { 200 } // HANDLE from GetStdHandle(-12)
fn runtime_context_field_win_write_fn_ptr() -> i64 { 208 }  // WriteFile function pointer
fn runtime_context_field_win_read_fn_ptr() -> i64 { 216 }   // ReadFile function pointer
fn runtime_context_field_win_create_file_fn_ptr() -> i64 { 224 }  // CreateFileA function pointer
fn runtime_context_field_win_close_handle_fn_ptr() -> i64 { 232 } // CloseHandle function pointer
fn runtime_context_field_win_get_file_attrs_fn_ptr() -> i64 { 240 } // GetFileAttributesExA function pointer

fn runtime_context_size() -> i64 { 248 }
fn runtime_context_global_slot_size() -> i64 { 8 }
