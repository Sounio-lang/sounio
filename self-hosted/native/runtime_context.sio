// self-hosted::native::runtime_context — Native runtime context layout
//
// Long-lived runtime state lives in a memory-backed context block at the front
// of the mmap'd runtime region. Native code reaches that block through a
// relocatable global slot stored in .data.

module native::runtime_context

pub fn runtime_context_field_heap_base() -> i64 { 0 }
pub fn runtime_context_field_heap_cursor() -> i64 { 8 }
pub fn runtime_context_field_heap_limit() -> i64 { 16 }
pub fn runtime_context_field_handle_table_base() -> i64 { 24 }
pub fn runtime_context_field_handle_count() -> i64 { 32 }
pub fn runtime_context_field_handle_capacity() -> i64 { 40 }
pub fn runtime_context_field_descriptor_table() -> i64 { 48 }
pub fn runtime_context_field_descriptor_count() -> i64 { 56 }
pub fn runtime_context_field_pin_registry() -> i64 { 64 }
pub fn runtime_context_field_pin_count() -> i64 { 72 }

// Pinning was sketched in Sprint 90 (gc model + codegen.sio reclaim probe) but
// is UNWIRED on the live Madaros emitter (`codegen_x86_linux.sio`): nothing
// increments this field after trampoline init. A literal 0 here used to be
// read by external probes as "zero live pins" — indistinguishable from
// "never measured" (same honesty class as silent GUM var=0.000000 / #1792).
// Until a reclaim lane wires real pinning, init with the UNWIRED sentinel
// and advertise `pin_registry_ready: false` in the native-v2 contract JSON.
pub fn runtime_context_pin_count_unwired() -> i64 { 0 - 1 }

// pin_registry pointer: never populated on x86_linux (always left null). A
// literal 0 reads as "no registry" which is plausible — same silent-absence
// class. Use the same UNWIRED sentinel so probes cannot mistake null-init
// for an empty-but-real registry base.
pub fn runtime_context_pin_registry_unwired() -> i64 { 0 - 1 }
pub fn runtime_context_field_argc() -> i64 { 80 }
pub fn runtime_context_field_argv_ptr() -> i64 { 88 }
pub fn runtime_context_field_stdout_fd() -> i64 { 96 }
pub fn runtime_context_field_stderr_fd() -> i64 { 104 }
pub fn runtime_context_field_simd_capability_mask() -> i64 { 112 }
pub fn runtime_context_field_gc_state() -> i64 { 120 }
pub fn runtime_context_field_stack_maps() -> i64 { 128 }
pub fn runtime_context_field_deopt_state() -> i64 { 136 }
pub fn runtime_context_field_gpu_ctx() -> i64 { 144 }
pub fn runtime_context_field_render_ctx() -> i64 { 152 }
pub fn runtime_context_field_provenance() -> i64 { 160 }
pub fn runtime_context_field_collector_epoch() -> i64 { 168 }
pub fn runtime_context_field_last_gc_stats() -> i64 { 176 }

// Windows-specific fields (set by Windows entry trampoline, zero on Linux/macOS)
pub fn runtime_context_field_os_id() -> i64 { 184 }           // 1=Linux, 2=macOS, 3=Windows
pub fn runtime_context_field_win_stdout_handle() -> i64 { 192 } // HANDLE from GetStdHandle(-11)
pub fn runtime_context_field_win_stderr_handle() -> i64 { 200 } // HANDLE from GetStdHandle(-12)
pub fn runtime_context_field_win_write_fn_ptr() -> i64 { 208 }  // WriteFile function pointer
pub fn runtime_context_field_win_read_fn_ptr() -> i64 { 216 }   // ReadFile function pointer
pub fn runtime_context_field_win_create_file_fn_ptr() -> i64 { 224 }  // CreateFileA function pointer
pub fn runtime_context_field_win_close_handle_fn_ptr() -> i64 { 232 } // CloseHandle function pointer
pub fn runtime_context_field_win_get_file_attrs_fn_ptr() -> i64 { 240 } // GetFileAttributesExA function pointer

pub fn runtime_context_size() -> i64 { 248 }
pub fn runtime_context_global_slot_size() -> i64 { 8 }
