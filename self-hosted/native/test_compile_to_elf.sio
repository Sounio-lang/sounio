fn make_name_print_int() -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 384], len: 9 }
    n.buf[0] = 112
    n.buf[1] = 114
    n.buf[2] = 105
    n.buf[3] = 110
    n.buf[4] = 116
    n.buf[5] = 95
    n.buf[6] = 105
    n.buf[7] = 110
    n.buf[8] = 116
    n
}

fn make_name_print_char() -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 384], len: 10 }
    n.buf[0] = 112
    n.buf[1] = 114
    n.buf[2] = 105
    n.buf[3] = 110
    n.buf[4] = 116
    n.buf[5] = 95
    n.buf[6] = 99
    n.buf[7] = 104
    n.buf[8] = 97
    n.buf[9] = 114
    n
}

fn make_name_print() -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 384], len: 5 }
    n.buf[0] = 112
    n.buf[1] = 114
    n.buf[2] = 105
    n.buf[3] = 110
    n.buf[4] = 116
    n
}

// T6: print_int builtin produces valid ELF
fn test_compile_with_print_int() -> i64 with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    var fn_pi = ir_empty_function()
    fn_pi.name = make_name_print_int()
    fn_pi.param_count = 1
    fn_pi.reg_count = 1
    fn_pi.instr_count = 0
    ir_fn_set(&! module, 0, fn_pi)

    var fn_main = ir_empty_function()
    fn_main.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    fn_main.param_count = 0
    fn_main.reg_count = 3
    fn_main.instr_count = 4

    ir_arena_store(ir_region_slot_w(fn_main.region, (0)), ir_load_imm(0, 42))
    let args6 = Some(Box::new(IrRegList { head: 0, tail: None }))
    ir_arena_store(ir_region_slot_w(fn_main.region, (1)), ir_call(1, 0, make_name_print_int(), args6, 1))
    ir_arena_store(ir_region_slot_w(fn_main.region, (2)), ir_load_imm(2, 0))
    ir_arena_store(ir_region_slot_w(fn_main.region, (3)), ir_return(2))

    ir_fn_set(&! module, 1, fn_main)
    module.fn_count = 2

    let elf = compile_to_elf(&module, 4194304)

    if elf.len < 64 { return 1 }
    if byte_u8(elf.bytes[0]) != 0x7f { return 2 }
    if byte_u8(elf.bytes[1]) != 69 { return 3 }
    if elf.len < 256 { return 4 }
    0
}

