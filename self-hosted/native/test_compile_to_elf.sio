// T9: get_arg_count builtin produces valid ELF
fn test_compile_with_get_arg_count() -> i64 with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    // fn get_arg_count() -> i64 (builtin stub)
    var fn_gac = ir_empty_function()
    fn_gac.name = make_name_get_arg_count()
    fn_gac.param_count = 0
    fn_gac.reg_count = 0
    fn_gac.instr_count = 0
    ir_fn_set(&! module, 0, fn_gac)

    // fn main() -> i64 { return get_arg_count() }
    var fn_main = ir_empty_function()
    fn_main.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    fn_main.param_count = 0
    fn_main.reg_count = 2
    fn_main.instr_count = 2

    let args9 = Some(Box::new(IrRegList { head: -1, tail: None }))
    ir_arena_store(ir_region_slot_w(fn_main.region, (0)), ir_call(0, 0, make_name_get_arg_count(), None, 0))
    ir_arena_store(ir_region_slot_w(fn_main.region, (1)), ir_return(0))

    ir_fn_set(&! module, 1, fn_main)
    module.fn_count = 2

    let elf = compile_to_elf(&module, 4194304)

    if elf.len < 64 { return 1 }
    if byte_u8(elf.bytes[0]) != 0x7f { return 2 }
    if byte_u8(elf.bytes[1]) != 69 { return 3 }
    if elf.len < 256 { return 4 }
    0
}

// T10: str_len builtin produces valid ELF
fn test_compile_with_str_len() -> i64 with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    var fn_sl = ir_empty_function()
    fn_sl.name = make_name_str_len()
    fn_sl.param_count = 1
    fn_sl.reg_count = 1
    fn_sl.instr_count = 0
    ir_fn_set(&! module, 0, fn_sl)

    var fn_main = ir_empty_function()
    fn_main.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    fn_main.param_count = 0
    fn_main.reg_count = 3
    fn_main.instr_count = 4

    // Load a string literal
    var i0 = ir_instr_new(IrOpcode::IrLoadString)
    i0.dst = 0
    i0.name = ir_name_from_bytes(104, 105, 0, 0, 2)  // "hi"
    ir_arena_store(ir_region_slot_w(fn_main.region, (0)), i0)

    let args10 = Some(Box::new(IrRegList { head: 0, tail: None }))
    ir_arena_store(ir_region_slot_w(fn_main.region, (1)), ir_call(1, 0, make_name_str_len(), args10, 1))
    ir_arena_store(ir_region_slot_w(fn_main.region, (2)), ir_load_imm(2, 0))
    ir_arena_store(ir_region_slot_w(fn_main.region, (3)), ir_return(1))

    ir_fn_set(&! module, 1, fn_main)
    module.fn_count = 2

    let elf = compile_to_elf(&module, 4194304)

    if elf.len < 64 { return 1 }
    if byte_u8(elf.bytes[0]) != 0x7f { return 2 }
    if byte_u8(elf.bytes[1]) != 69 { return 3 }
    if elf.len < 256 { return 4 }
    0
}

// T11: write_file + read_file builtins produce valid ELF
fn test_compile_with_file_io() -> i64 with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    // fn write_file(path, buf, len) -> i64 (builtin stub)
    var fn_wf = ir_empty_function()
    fn_wf.name = make_name_write_file()
    fn_wf.param_count = 3
    fn_wf.reg_count = 3
    fn_wf.instr_count = 0
    ir_fn_set(&! module, 0, fn_wf)

    // fn read_file(path, buf, max_len) -> i64 (builtin stub)
    var fn_rf = ir_empty_function()
    fn_rf.name = make_name_read_file()
    fn_rf.param_count = 3
    fn_rf.reg_count = 3
    fn_rf.instr_count = 0
    ir_fn_set(&! module, 1, fn_rf)

    // fn file_size(path) -> i64 (builtin stub)
    var fn_fs = ir_empty_function()
    fn_fs.name = make_name_file_size()
    fn_fs.param_count = 1
    fn_fs.reg_count = 1
    fn_fs.instr_count = 0
    ir_fn_set(&! module, 2, fn_fs)

    // fn main() -> i64 { return 0 }
    var fn_main = ir_empty_function()
    fn_main.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    fn_main.param_count = 0
    fn_main.reg_count = 1
    fn_main.instr_count = 2
    ir_arena_store(ir_region_slot_w(fn_main.region, (0)), ir_load_imm(0, 0))
    ir_arena_store(ir_region_slot_w(fn_main.region, (1)), ir_return(0))

    ir_fn_set(&! module, 3, fn_main)
    module.fn_count = 4

    let elf = compile_to_elf(&module, 4194304)

    if elf.len < 64 { return 1 }
    if byte_u8(elf.bytes[0]) != 0x7f { return 2 }
    if byte_u8(elf.bytes[1]) != 69 { return 3 }
    if elf.len < 512 { return 4 }
    0
}

// Helper: read byte as unsigned
fn byte_u8(b: i8) -> i64 {
    let x = b as i64
    if x < 0 { x + 256 } else { x }
}

fn test_compile_to_elf_main() -> i64 with Mut, Panic, Div, Alloc {
    var failed = 0

    if test_compile_simple_function() != 0 {
        failed = failed + 1
    }

    if test_compile_with_arithmetic() != 0 {
        failed = failed + 1
    }

    if test_compile_with_function_call() != 0 {
        failed = failed + 1
    }

    if test_compile_with_print_int() != 0 {
        failed = failed + 1
    }

    if test_compile_with_print_char() != 0 {
        failed = failed + 1
    }

    if test_compile_with_print_str() != 0 {
        failed = failed + 1
    }

    if test_compile_with_get_arg_count() != 0 {
        failed = failed + 1
    }

    if test_compile_with_str_len() != 0 {
        failed = failed + 1
    }

    if test_compile_with_file_io() != 0 {
        failed = failed + 1
    }

    if failed == 0 { 0 } else { 1 }
}
