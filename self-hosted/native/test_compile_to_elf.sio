    if elf.len < 256 { return 4 }
    0
}

// T8: print (string) builtin produces valid ELF
fn test_compile_with_print_str() -> i64 with Mut, Panic, Div, Alloc {
    var module = ir_empty_module()

    var fn_p = ir_empty_function()
    fn_p.name = make_name_print()
    fn_p.param_count = 1
    fn_p.reg_count = 1
    fn_p.instr_count = 0
    module.functions[0] = fn_p

    var fn_main = ir_empty_function()
    fn_main.name = ir_name_from_bytes(109, 97, 105, 110, 4)
    fn_main.param_count = 0
    fn_main.reg_count = 3
    fn_main.instr_count = 4

    var i0 = ir_empty_instr()
    i0.op = IrOpcode::IrLoadString
    i0.dst = 0
    i0.name = ir_name_from_bytes(104, 105, 10, 0, 3)
    fn_main.instrs[0] = i0

    let args8 = Some(Box::new(IrRegList { head: 0, tail: None }))
    fn_main.instrs[1] = ir_call(1, 0, make_name_print(), args8, 1)
    fn_main.instrs[2] = ir_load_imm(2, 0)
    fn_main.instrs[3] = ir_return(2)

    module.functions[1] = fn_main
    module.fn_count = 2

    let elf = compile_to_elf(module, 4194304)

    if elf.len < 64 { return 1 }
    if byte_u8(elf.bytes[0]) != 0x7f { return 2 }
    if byte_u8(elf.bytes[1]) != 69 { return 3 }
    if elf.len < 256 { return 4 }
    0
}

// Helper: read byte as unsigned
fn byte_u8(b: i8) -> i64 {
    let x = b as i64
    if x < 0 { x + 256 } else { x }
}

fn main() -> i64 with Mut, Panic, Div, Alloc {
    var failed = 0

    if test_compile_simple_function() != 0 {
        failed = failed + 1
    }

    if test_compile_with_arithmetic() != 0 {
        failed = failed + 1
    }

    if test_compile_with_function_call() != 0 {
        failed = failed + 1
    }

    if test_compile_with_print_int() != 0 {
        failed = failed + 1
    }

    if test_compile_with_print_char() != 0 {
        failed = failed + 1
    }

    if test_compile_with_print_str() != 0 {
        failed = failed + 1
    }

    if failed == 0 { 0 } else { 1 }
}
