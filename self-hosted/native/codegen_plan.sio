// T22: build_deps on independent instructions produces no deps
fn test_cgplan_build_deps_none() -> i64 with Mut, Div, Panic {
    var p = codegen_plan_new()
    // Two instructions with completely disjoint registers
    p = cgplan_add_instr(p, codegen_instr_new(0, CGOP_ADD, 1, 2, 3, 1))
    p = cgplan_add_instr(p, codegen_instr_new(1, CGOP_ADD, 4, 5, 6, 1))
    p = cgplan_build_deps(p)
    let r1 = cgplan_assert_true(p.blocks[0 as usize].dep_count == 0, 1)
    if r1 != 0 { return r1 }
    0
}

// T23: schedule a longer chain and verify total cycle count
fn test_cgplan_schedule_long_chain() -> i64 with Mut, Div, Panic {
    var p = codegen_plan_new()
    // Chain of 5 instructions each depending on the previous
    // r1 = LOAD (lat 3)
    p = cgplan_add_instr(p, codegen_instr_new(0, CGOP_LOAD, 1, REG_NONE, REG_NONE, 3))
    // r2 = ADD r1, r0 (lat 1)
    p = cgplan_add_instr(p, codegen_instr_new(1, CGOP_ADD, 2, 1, 0, 1))
    // r3 = MUL r2, r0 (lat 2)
    p = cgplan_add_instr(p, codegen_instr_new(2, CGOP_MUL, 3, 2, 0, 2))
    // r4 = SUB r3, r0 (lat 1)
    p = cgplan_add_instr(p, codegen_instr_new(3, CGOP_SUB, 4, 3, 0, 1))
    // r5 = STORE r4 (lat 1)
    p = cgplan_add_instr(p, codegen_instr_new(4, CGOP_STORE, REG_NONE, 4, REG_NONE, 1))
    p = cgplan_build_deps(p)
    p = cgplan_list_schedule(p)
    let r1 = cgplan_assert_true(p.blocks[0 as usize].schedule_len == 5, 1)
    if r1 != 0 { return r1 }
    let valid = cgplan_validate_deps(p)
    let r2 = cgplan_assert_true(valid, 2)
    if r2 != 0 { return r2 }
    // Cycle count should be at least 5 (one per instruction in a chain)
    let r3 = cgplan_assert_true(p.blocks[0 as usize].cycle_count >= 5, 3)
    if r3 != 0 { return r3 }
    0
}

// T24: add_instr_to_block stores in correct block
fn test_cgplan_add_to_block() -> i64 with Mut, Div, Panic {
    var p = codegen_plan_new()
    let i0 = codegen_instr_new(0, CGOP_ADD, 1, 2, 3, 1)
    p = cgplan_add_instr_to_block(p, 2, i0)
    let r1 = cgplan_assert_true(p.block_count == 3, 1)
    if r1 != 0 { return r1 }
    let r2 = cgplan_assert_true(p.blocks[2 as usize].instr_count == 1, 2)
    if r2 != 0 { return r2 }
    let r3 = cgplan_assert_true(p.blocks[0 as usize].instr_count == 0, 3)
    if r3 != 0 { return r3 }
    0
}

// T25: pressure with no spills needed
fn test_cgplan_no_spill() -> i64 with Mut, Div, Panic {
    var p = codegen_plan_new()
    p = cgplan_add_instr(p, codegen_instr_new(0, CGOP_LOAD, 1, REG_NONE, REG_NONE, 1))
    p = cgplan_add_instr(p, codegen_instr_new(1, CGOP_ADD, 2, 1, 3, 1))
    p = cgplan_build_deps(p)
    p = cgplan_list_schedule(p)
    p = cgplan_estimate_pressure(p)
    // With 16 registers, no spills needed for 2 live regs
    let spills = cgplan_detect_spills(p, 16)
    let r1 = cgplan_assert_true(spills == 0, 1)
    if r1 != 0 { return r1 }
    0
}

// T26: count_deps_of_kind works correctly
fn test_cgplan_count_dep_kinds() -> i64 with Mut, Div, Panic {
    var p = codegen_plan_new()
    // Create a scenario with multiple dep types:
    // i0: LOAD r1 (defines r1)
    p = cgplan_add_instr(p, codegen_instr_new(0, CGOP_LOAD, 1, REG_NONE, REG_NONE, 3))
    // i1: ADD r2, r1, r3 (uses r1 -> DATA from i0)
    p = cgplan_add_instr(p, codegen_instr_new(1, CGOP_ADD, 2, 1, 3, 1))
    // i2: LOAD r1 (re-defines r1 -> ANTI from i1, OUTPUT from i0)
    p = cgplan_add_instr(p, codegen_instr_new(2, CGOP_LOAD, 1, REG_NONE, REG_NONE, 3))
    p = cgplan_build_deps(p)
    let data_count = cgplan_count_deps_of_kind(p, 0, DEP_DATA)
    let anti_count = cgplan_count_deps_of_kind(p, 0, DEP_ANTI)
    let output_count = cgplan_count_deps_of_kind(p, 0, DEP_OUTPUT)
    let r1 = cgplan_assert_true(data_count >= 1, 1)
    if r1 != 0 { return r1 }
    let r2 = cgplan_assert_true(anti_count >= 1, 2)
    if r2 != 0 { return r2 }
    let r3 = cgplan_assert_true(output_count >= 1, 3)
    if r3 != 0 { return r3 }
    0
}

// T27: reorder_for_pressure produces valid schedule
fn test_cgplan_reorder_pressure() -> i64 with Mut, Div, Panic {
    var p = codegen_plan_new()
    // Independent instructions: reorder should not break anything
    p = cgplan_add_instr(p, codegen_instr_new(0, CGOP_LOAD, 1, REG_NONE, REG_NONE, 1))
    p = cgplan_add_instr(p, codegen_instr_new(1, CGOP_LOAD, 2, REG_NONE, REG_NONE, 1))
    p = cgplan_add_instr(p, codegen_instr_new(2, CGOP_ADD, 3, 1, 2, 1))
    p = cgplan_build_deps(p)
    p = cgplan_list_schedule(p)
    p = cgplan_estimate_pressure(p)
    p = cgplan_reorder_for_pressure(p, 8)
    // Schedule should still be valid after reordering
    let valid = cgplan_validate_schedule(p)
    let r1 = cgplan_assert_true(valid, 1)
    if r1 != 0 { return r1 }
    0
}

// T28: count_successors and count_predecessors
fn test_cgplan_succ_pred_count() -> i64 with Mut, Div, Panic {
    var p = codegen_plan_new()
    p = cgplan_add_instr(p, codegen_instr_new(0, CGOP_LOAD, 1, REG_NONE, REG_NONE, 1))
    p = cgplan_add_instr(p, codegen_instr_new(1, CGOP_ADD, 2, 1, 3, 1))
    p = cgplan_add_instr(p, codegen_instr_new(2, CGOP_MUL, 4, 1, 5, 1))
    p = cgplan_build_deps(p)
    // Instruction 0 defines r1, used by instructions 1 and 2
    let succs = cgplan_count_successors(p.blocks[0 as usize], 0)
    let r1 = cgplan_assert_true(succs >= 2, 1)
    if r1 != 0 { return r1 }
    let preds = cgplan_count_predecessors(p.blocks[0 as usize], 1)
    let r2 = cgplan_assert_true(preds >= 1, 2)
    if r2 != 0 { return r2 }
    0
}

// T29: compute_total_cycles sums across blocks
fn test_cgplan_total_cycles() -> i64 with Mut, Div, Panic {
    var p = codegen_plan_new()
    // Add instrs to block 0
    p = cgplan_add_instr_to_block(p, 0, codegen_instr_new(0, CGOP_ADD, 1, 2, 3, 1))
    p.blocks[0 as usize].cycle_count = 5
    p = cgplan_add_instr_to_block(p, 1, codegen_instr_new(0, CGOP_ADD, 1, 2, 3, 1))
    p.blocks[1 as usize].cycle_count = 3
    let total = cgplan_compute_total_cycles(p)
    let r1 = cgplan_assert_true(total == 8, 1)
    if r1 != 0 { return r1 }
    0
}

// T30: schedule with diamond dependency pattern
fn test_cgplan_diamond_deps() -> i64 with Mut, Div, Panic {
    var p = codegen_plan_new()
    // Diamond:  i0 -> i1
    //           i0 -> i2
    //           i1 -> i3
    //           i2 -> i3
    p = cgplan_add_instr(p, codegen_instr_new(0, CGOP_LOAD, 1, REG_NONE, REG_NONE, 1))
    p = cgplan_add_instr(p, codegen_instr_new(1, CGOP_ADD, 2, 1, 10, 1))
    p = cgplan_add_instr(p, codegen_instr_new(2, CGOP_ADD, 3, 1, 11, 1))
    p = cgplan_add_instr(p, codegen_instr_new(3, CGOP_ADD, 4, 2, 3, 1))
    p = cgplan_build_deps(p)
    p = cgplan_list_schedule(p)
    let r1 = cgplan_assert_true(p.blocks[0 as usize].schedule_len == 4, 1)
    if r1 != 0 { return r1 }
    let valid = cgplan_validate_deps(p)
    let r2 = cgplan_assert_true(valid, 2)
    if r2 != 0 { return r2 }
    // i0 must be first, i3 must be last
    let r3 = cgplan_assert_true(p.blocks[0 as usize].schedule[0 as usize] == 0, 3)
    if r3 != 0 { return r3 }
    let r4 = cgplan_assert_true(p.blocks[0 as usize].schedule[3 as usize] == 3, 4)
    if r4 != 0 { return r4 }
    0
}

fn test_cgplan_schedule_all_blocks_multiblock() -> i64 with Mut, Div, Panic {
    var p = codegen_plan_new()
    p = cgplan_add_instr_to_block(p, 0, codegen_instr_new(0, CGOP_ADD, 1, 2, 3, 1))
    p = cgplan_add_instr_to_block(p, 1, codegen_instr_new(0, CGOP_MUL, 4, 5, 6, 2))
    p = cgplan_build_deps(p)
    p = cgplan_schedule_all_blocks(p)

    let r1 = cgplan_assert_true(p.blocks[0 as usize].schedule_len == 1, 1)
    if r1 != 0 { return r1 }
    let r2 = cgplan_assert_true(p.blocks[1 as usize].schedule_len == 1, 2)
    if r2 != 0 { return r2 }
    let r3 = cgplan_assert_true(p.total_cycles == 2, 3)
    if r3 != 0 { return r3 }
    0
}

fn test_cgplan_validate_multiblock() -> i64 with Mut, Div, Panic {
    var p = codegen_plan_new()
    p = cgplan_add_instr_to_block(p, 0, codegen_instr_new(0, CGOP_LOAD, 1, REG_NONE, REG_NONE, 1))
    p = cgplan_add_instr_to_block(p, 0, codegen_instr_new(1, CGOP_ADD, 2, 1, 3, 1))
    p = cgplan_add_instr_to_block(p, 1, codegen_instr_new(0, CGOP_LOAD, 4, REG_NONE, REG_NONE, 1))
    p = cgplan_add_instr_to_block(p, 1, codegen_instr_new(1, CGOP_SUB, 5, 4, 6, 1))
    p = cgplan_build_deps(p)
    p = cgplan_schedule_all_blocks(p)

    let r1 = cgplan_assert_true(cgplan_validate_schedule(p), 1)
    if r1 != 0 { return r1 }
    let r2 = cgplan_assert_true(cgplan_validate_deps(p), 2)
    if r2 != 0 { return r2 }
    let r3 = cgplan_assert_true(cgplan_count_scheduled(p) == 4, 3)
    if r3 != 0 { return r3 }
    0
}

