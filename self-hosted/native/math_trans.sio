// self-hosted::native::math_trans -- native x86-64 kernels for tan, atan, atan2,
// asin, acos and tanh (f64), plus the name recogniser that gives them builtin ids.
//
// WHY THIS FILE EXISTS. The checker bound `tan atan tanh asin acos` and refused
// every call to them with E221 because the backend had no code to emit; `ln`
// and `atan2` were not bound at all. Everything here is straight-line f64
// arithmetic on rbp-relative slots plus integer tests on the BIT PATTERN of the
// operand, in the same style as native::math_ffi (whose slot moves and
// error-free transformations it reuses). `ln` needs no kernel: it is `log`.
//
// CALLING SHAPE (identical to every scalar builtin in this backend, see
// emit_builtin_ffi_pow): the f64 argument(s) arrive as raw BITS in rdi (and
// rsi for the second), the result leaves as bits in rax. rbx, rcx, rdx and rsi
// are clobbered. All constants live in .rodata and are generated by
// scripts/dev/gen_math_trans_consts.sh (bc, 900 digits); the only literals typed
// by hand in this file are integer bit-pattern THRESHOLDS for comparisons.
//
// BRANCHING. Float compares are done on |bits| as signed integers, which is
// order-preserving for non-negative doubles, so a NaN is excluded first by
// `|bits| > 0x7FF0000000000000` and nothing here ever consults EFLAGS from a
// float compare. A branch is a jcc/jmp rel32 placeholder patched once the target
// is known: jz/jnz are 6 bytes (patch at +2, relative to +6), jmp is 5 bytes
// (patch at +1, relative to +5).
//
// ACCURACY is measured, not asserted: see tests/run-pass/math_trans_ulp_*.sio and
// docs in changelog.d/. The algorithms are fdlibm's atan range reduction with a
// 24-term Taylor polynomial, tan as sin/cos of a double-double-reduced argument,
// and tanh through a Cody-Waite expm1.

use native::encode::*
use native::elf::{data_section_add_f64}
use native::reloc::{patch_u32_le}
use native::codegen_x86_linux::{NativeCompiler}
use native::math_ffi::{mf_ld0, mf_ld1, mf_st0, mf_ld0c, mf_ld1c, mf_mov_slot, mf_two_diff, mf_two_prod, mf_fabs_slot, mf_fneg_slot, mf_fneg_slot_if, mf_abs_bits_rbx, mf_sign_bit_rax, mf_pow2_slot}
use native::math_trans_consts::{mt_reg_atan_consts, mt_reg_tan_consts, mt_reg_tanh_consts}
use parser::ast::{Name}

// ---------------------------------------------------------------------------
// Builtin ids. 1..85 are taken. ln is NOT here: it resolves to log's id 17.
// ---------------------------------------------------------------------------
pub fn mt_id_tan() -> i64 { 86 }
pub fn mt_id_atan() -> i64 { 87 }
pub fn mt_id_tanh() -> i64 { 88 }
pub fn mt_id_asin() -> i64 { 89 }
pub fn mt_id_acos() -> i64 { 90 }
pub fn mt_id_atan2() -> i64 { 91 }

fn mt_nm(n: Name, i: i64, ch: i64) -> bool with Mut, Panic, Div {
    n.buf[i] == (ch as i8)
}

// One predicate per name, spelled name_is_<builtin> because
// scripts/ci/extern_builtin_mirror_gate.sh derives the backend's name list from
// the predicate names in native_v2_builtin_id_for_func_ref.
pub fn name_is_ln(n: Name) -> bool with Mut, Panic, Div {
    n.len == 2 && mt_nm(n, 0, 108) && mt_nm(n, 1, 110)
}
pub fn name_is_tan(n: Name) -> bool with Mut, Panic, Div {
    n.len == 3 && mt_nm(n, 0, 116) && mt_nm(n, 1, 97) && mt_nm(n, 2, 110)
}
pub fn name_is_atan(n: Name) -> bool with Mut, Panic, Div {
    n.len == 4 && mt_nm(n, 0, 97) && mt_nm(n, 1, 116) && mt_nm(n, 2, 97) && mt_nm(n, 3, 110)
}
pub fn name_is_tanh(n: Name) -> bool with Mut, Panic, Div {
    n.len == 4 && mt_nm(n, 0, 116) && mt_nm(n, 1, 97) && mt_nm(n, 2, 110) && mt_nm(n, 3, 104)
}
pub fn name_is_asin(n: Name) -> bool with Mut, Panic, Div {
    n.len == 4 && mt_nm(n, 0, 97) && mt_nm(n, 1, 115) && mt_nm(n, 2, 105) && mt_nm(n, 3, 110)
}
pub fn name_is_acos(n: Name) -> bool with Mut, Panic, Div {
    n.len == 4 && mt_nm(n, 0, 97) && mt_nm(n, 1, 99) && mt_nm(n, 2, 111) && mt_nm(n, 3, 115)
}
pub fn name_is_atan2(n: Name) -> bool with Mut, Panic, Div {
    n.len == 5 && mt_nm(n, 0, 97) && mt_nm(n, 1, 116) && mt_nm(n, 2, 97) && mt_nm(n, 3, 110) && mt_nm(n, 4, 50)
}

// ---------------------------------------------------------------------------
// Slot DSL. Slot i is [rbp - 8*(i+1)]. A kernel documents which slot indices it
// uses; nothing else may touch them.
// ---------------------------------------------------------------------------
pub fn mt_s(i: i64) -> i64 { 0 - 8 * (i + 1) }

// xmm0 = xmm0 <op> xmm1.  op: 0 add, 1 sub, 2 mul, 3 div.
fn mt_apply(nc: NativeCompiler, op: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    if op == 0 { c.code = emit_addsd_xmm0_xmm1(c.code); return c }
    if op == 1 { c.code = emit_subsd_xmm0_xmm1(c.code); return c }
    if op == 2 { c.code = emit_mulsd_xmm0_xmm1(c.code); return c }
    c.code = emit_divsd_xmm0_xmm1(c.code)
    c
}

// dst = a <op> b
fn mt_f(nc: NativeCompiler, op: i64, dst: i64, a: i64, b: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c = mf_ld0(c, a)
    c = mf_ld1(c, b)
    c = mt_apply(c, op)
    c = mf_st0(c, dst)
    c
}

// dst = a <op> K[off]
fn mt_fc(nc: NativeCompiler, op: i64, dst: i64, a: i64, off: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c = mf_ld0(c, a)
    c = mf_ld1c(c, off)
    c = mt_apply(c, op)
    c = mf_st0(c, dst)
    c
}

// dst = K[off] <op> b
fn mt_cf(nc: NativeCompiler, op: i64, dst: i64, off: i64, b: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c = mf_ld0c(c, off)
    c = mf_ld1(c, b)
    c = mt_apply(c, op)
    c = mf_st0(c, dst)
    c
}

// dst = K[off]
fn mt_lc(nc: NativeCompiler, dst: i64, off: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c = mf_ld0c(c, off)
    c = mf_st0(c, dst)
    c
}

// dst = K[a] <op> K[b]
fn mt_cc(nc: NativeCompiler, op: i64, dst: i64, a: i64, b: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c = mf_ld0c(c, a)
    c = mf_ld1c(c, b)
    c = mt_apply(c, op)
    c = mf_st0(c, dst)
    c
}

fn mt_sqrt(nc: NativeCompiler, dst: i64, a: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c = mf_ld0(c, a)
    c.code = emit_sqrtsd_xmm0_xmm0(c.code)
    c = mf_st0(c, dst)
    c
}

// Horner step: dst = dst * x + K[off].
fn mt_horner(nc: NativeCompiler, dst: i64, x: i64, off: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c = mf_ld0(c, dst)
    c = mf_ld1(c, x)
    c.code = emit_mulsd_xmm0_xmm1(c.code)
    c = mf_ld1c(c, off)
    c.code = emit_addsd_xmm0_xmm1(c.code)
    c = mf_st0(c, dst)
    c
}

// [dst] (integer slot) = imm
fn mt_seti(nc: NativeCompiler, dst: i64, imm: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_mov_reg_imm(c.code, 0, imm)
    c.code = emit_store_rax_rbp_disp32(c.code, dst)
    c
}

// [dst] (integer slot) = sign bit (0/1) of the double in slot s.
fn mt_sign_to(nc: NativeCompiler, dst: i64, s: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c = mf_sign_bit_rax(c, s)
    c.code = emit_store_rax_rbp_disp32(c.code, dst)
    c
}

// ---- jumps ----------------------------------------------------------------
// Each mt_j* emits a conditional or unconditional forward jump with a rel32
// placeholder. The caller records the position BEFORE emitting (c.code.len for
// an unconditional jump) or, for the conditional ones, as c.code.len - 6 AFTER.

// jump if |bits(s)| <op> imm.  kind 0: >=, 1: <, 2: >
fn mt_jabs(nc: NativeCompiler, s: i64, imm: i64, kind: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c = mf_abs_bits_rbx(c, s)
    c.code = emit_mov_reg_imm(c.code, 0, imm)
    c.code = emit_cmp_rbx_rax(c.code)
    if kind == 0 { c.code = emit_setge_al(c.code) }
    if kind == 1 { c.code = emit_setl_al(c.code) }
    if kind == 2 { c.code = emit_setg_al(c.code) }
    c.code = emit_test_al_al(c.code)
    c.code = emit_jnz_rel32(c.code)
    c
}

// jump if the INTEGER slot f is nonzero (want 1) or zero (want 0).
fn mt_jflag(nc: NativeCompiler, f: i64, want: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_load_rbp_disp32_rax(c.code, f)
    c.code = emit_test_rax_rax(c.code)
    if want == 1 { c.code = emit_jnz_rel32(c.code) }
    if want == 0 { c.code = emit_jz_rel32(c.code) }
    c
}

fn mt_jmp(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_jmp_rel32(c.code)
    c
}

// Position of the 6-byte jcc just emitted.
fn mt_jcc_pos(nc: NativeCompiler) -> i64 with Mut, Panic, Div { nc.code.len - 6 }
// Position of the 5-byte jmp just emitted.
fn mt_jmp_pos(nc: NativeCompiler) -> i64 with Mut, Panic, Div { nc.code.len - 5 }

fn mt_patch6(nc: NativeCompiler, pos: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = patch_u32_le(c.code, pos + 2, c.code.len - (pos + 6))
    c
}

fn mt_patch5(nc: NativeCompiler, pos: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = patch_u32_le(c.code, pos + 1, c.code.len - (pos + 5))
    c
}

// ---------------------------------------------------------------------------
// atan core.
//
// Input slot a (any double), output slot out. Uses slots tb .. tb+7 and the
// atan constant block at rodata offset k (layout fixed by gen_math_trans_consts):
//   k+0 1.0, k+8 2.0, k+16 1.5, k+24 0.0, hi[i] = k+32+8i, lo[i] = k+64+8i,
//   T[i] = k+96+8i (i = 0..23), pi_hi k+288, pi_lo k+296, pi/4 k+304, 3pi/4 k+312.
//
// fdlibm's reduction: |x| < 7/16 uses x itself; otherwise atan(x) =
// atan(c) + atan((x-c)/(1+xc)) for c in {1/2, 1, 3/2, inf}, with atan(c) carried
// as a hi+lo pair. atan(xr) = xr - xr*z*T(z), z = xr^2, T = sum (-1)^k z^k/(2k+3).
//
//   NaN        -> a + a            |a| >= 2^66 -> +-pi/2
//   |a| < 2^-29 -> a
// ---------------------------------------------------------------------------
fn mt_atan_core(nc: NativeCompiler, out: i64, a: i64, k: i64, tb: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    let ab = mt_s(tb)
    let sg = mt_s(tb + 1)
    let xr = mt_s(tb + 2)
    let z = mt_s(tb + 3)
    let tt = mt_s(tb + 4)
    let hh = mt_s(tb + 5)
    let ll = mt_s(tb + 6)
    let qq = mt_s(tb + 7)
    let one = k
    let two = k + 8
    let onep5 = k + 16
    let zero = k + 24
    let hi = k + 32
    let lo = k + 64
    let tcf = k + 96

    c = mf_fabs_slot(c, ab, a)
    c = mt_sign_to(c, sg, a)
    c = mt_jabs(c, a, 0x7FF0000000000000, 2)
    let p_nan = mt_jcc_pos(c)
    c = mt_jabs(c, a, 0x4410000000000000, 0)
    let p_big = mt_jcc_pos(c)
    c = mt_jabs(c, a, 0x3E20000000000000, 1)
    let p_tiny = mt_jcc_pos(c)
    c = mt_jabs(c, a, 0x3FDC000000000000, 1)
    let p_m1 = mt_jcc_pos(c)
    c = mt_jabs(c, a, 0x3FE6000000000000, 1)
    let p_0 = mt_jcc_pos(c)
    c = mt_jabs(c, a, 0x3FF3000000000000, 1)
    let p_1 = mt_jcc_pos(c)
    c = mt_jabs(c, a, 0x4003800000000000, 1)
    let p_2 = mt_jcc_pos(c)

    // id 3: xr = -1/|a|, atan(inf) = pi/2
    c = mt_cf(c, 3, xr, one, ab)
    c = mf_fneg_slot(c, xr, xr)
    c = mt_lc(c, hh, hi + 24)
    c = mt_lc(c, ll, lo + 24)
    c = mt_jmp(c)
    let j3 = mt_jmp_pos(c)

    // id 2: xr = (|a|-1.5)/(1+1.5|a|), atan(1.5)
    c = mt_patch6(c, p_2)
    c = mt_fc(c, 1, tt, ab, onep5)           // num
    c = mt_fc(c, 2, qq, ab, onep5)           // 1.5*|a|
    c = mt_cf(c, 0, qq, one, qq)             // den = 1 + 1.5|a|
    c = mt_f(c, 3, xr, tt, qq)
    c = mt_lc(c, hh, hi + 16)
    c = mt_lc(c, ll, lo + 16)
    c = mt_jmp(c)
    let j2 = mt_jmp_pos(c)

    // id 1: xr = (|a|-1)/(|a|+1), atan(1)
    c = mt_patch6(c, p_1)
    c = mt_fc(c, 1, tt, ab, one)
    c = mt_fc(c, 0, qq, ab, one)
    c = mt_f(c, 3, xr, tt, qq)
    c = mt_lc(c, hh, hi + 8)
    c = mt_lc(c, ll, lo + 8)
    c = mt_jmp(c)
    let j1 = mt_jmp_pos(c)

    // id 0: xr = (2|a|-1)/(2+|a|), atan(0.5)
    c = mt_patch6(c, p_0)
    c = mt_fc(c, 2, tt, ab, two)
    c = mt_fc(c, 1, tt, tt, one)
    c = mt_cf(c, 0, qq, two, ab)
    c = mt_f(c, 3, xr, tt, qq)
    c = mt_lc(c, hh, hi)
    c = mt_lc(c, ll, lo)
    c = mt_jmp(c)
    let j0 = mt_jmp_pos(c)

    // id -1: |a| < 7/16, xr = a itself (signed), no sign fix-up afterwards.
    c = mt_patch6(c, p_m1)
    c = mf_mov_slot(c, xr, a)
    c = mt_lc(c, hh, zero)
    c = mt_lc(c, ll, zero)
    c = mt_seti(c, sg, 0)

    // poly: R = hi - ((xr*z*T - lo) - xr)
    c = mt_patch5(c, j3)
    c = mt_patch5(c, j2)
    c = mt_patch5(c, j1)
    c = mt_patch5(c, j0)
    c = mt_f(c, 2, z, xr, xr)
    c = mt_lc(c, tt, tcf + 8 * 23)
    var kk = 22
    while kk >= 0 {
        c = mt_horner(c, tt, z, tcf + 8 * kk)
        kk = kk - 1
    }
    c = mt_f(c, 2, qq, xr, z)
    c = mt_f(c, 2, qq, qq, tt)
    c = mt_f(c, 1, qq, qq, ll)
    c = mt_f(c, 1, qq, qq, xr)
    c = mt_f(c, 1, out, hh, qq)
    c = mf_fneg_slot_if(c, out, sg)
    c = mt_jmp(c)
    let e1 = mt_jmp_pos(c)

    // NaN
    c = mt_patch6(c, p_nan)
    c = mt_f(c, 0, out, a, a)
    c = mt_jmp(c)
    let e2 = mt_jmp_pos(c)

    // |a| >= 2^66
    c = mt_patch6(c, p_big)
    c = mt_cc(c, 0, out, hi + 24, lo + 24)
    c = mf_fneg_slot_if(c, out, sg)
    c = mt_jmp(c)
    let e3 = mt_jmp_pos(c)

    // tiny
    c = mt_patch6(c, p_tiny)
    c = mf_mov_slot(c, out, a)

    c = mt_patch5(c, e1)
    c = mt_patch5(c, e2)
    c = mt_patch5(c, e3)
    c
}

// ---- prologue / epilogue ----------------------------------------------------
fn mt_prologue(nc: NativeCompiler, nslots: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_push_rbp(c.code)
    c.code = emit_mov_rbp_rsp(c.code)
    c.code = emit_sub_rsp_imm32(c.code, 8 * nslots + 64)
    c
}

fn mt_epilogue(nc: NativeCompiler, out: i64, nslots: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c = mf_ld0(c, out)
    c.code = emit_movq_rax_xmm0(c.code)
    c.code = emit_add_rsp_imm32(c.code, 8 * nslots + 64)
    c.code = emit_pop_rbp(c.code)
    c.code = emit_ret(c.code)
    c
}

// rdi -> slot, rsi -> slot
fn mt_spill_rdi(nc: NativeCompiler, s: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_mov_reg_reg(c.code, 0, 7)
    c.code = emit_store_rax_rbp_disp32(c.code, s)
    c
}

fn mt_spill_rsi(nc: NativeCompiler, s: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_mov_reg_reg(c.code, 0, 6)
    c.code = emit_store_rax_rbp_disp32(c.code, s)
    c
}

// ---------------------------------------------------------------------------
// atan(x).  Slots: 0 x, 1 out, 2.. atan core temps.
// ---------------------------------------------------------------------------
pub fn emit_builtin_mt_atan(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c = mt_reg_atan_consts(c)
    let k = c.rodata.last_offset - 8 * 39
    c = mt_prologue(c, 16)
    c = mt_spill_rdi(c, mt_s(0))
    c = mt_atan_core(c, mt_s(1), mt_s(0), k, 2)
    c = mt_epilogue(c, mt_s(1), 16)
    c
}

// ---------------------------------------------------------------------------
// atan2(y, x).  Slots: 0 y, 1 x, 2 out, 3 ys, 4 xs, 5 t, 6 z, 7 scratch,
// 8.. atan core temps (8..15).
//
// C99 Annex F: NaN in either -> NaN; y = +-0 with x > 0 or +0 -> +-0, with x < 0
// or -0 -> +-pi; x = +-0 with y != 0 -> +-pi/2; infinities give +-pi/4, +-3pi/4,
// +-0, +-pi, +-pi/2 by quadrant. t = |y|/|x| is NaN exactly for 0/0 and inf/inf
// and >= 2^66 (incl. inf) exactly for x = 0, y = inf or |y/x| huge, where the
// answer is +-pi/2 regardless of the sign of x.
// ---------------------------------------------------------------------------
pub fn emit_builtin_mt_atan2(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c = mt_reg_atan_consts(c)
    let k = c.rodata.last_offset - 8 * 39
    let one = k
    let zero = k + 24
    let hi3 = k + 32 + 24
    let pi_hi = k + 288
    let pi_lo = k + 296
    let pio4 = k + 304
    let p3o4 = k + 312
    let y = mt_s(0)
    let x = mt_s(1)
    let out = mt_s(2)
    let ys = mt_s(3)
    let xs = mt_s(4)
    let t = mt_s(5)
    let z = mt_s(6)
    let sc = mt_s(7)

    c = mt_prologue(c, 16)
    c = mt_spill_rdi(c, y)
    c = mt_spill_rsi(c, x)
    c = mt_jabs(c, y, 0x7FF0000000000000, 2)
    let p_nan1 = mt_jcc_pos(c)
    c = mt_jabs(c, x, 0x7FF0000000000000, 2)
    let p_nan2 = mt_jcc_pos(c)
    c = mt_sign_to(c, ys, y)
    c = mt_sign_to(c, xs, x)
    c = mf_fabs_slot(c, t, y)
    c = mf_fabs_slot(c, sc, x)
    c = mt_f(c, 3, t, t, sc)                          // t = |y| / |x|
    c = mt_jabs(c, t, 0x7FF0000000000001, 0)
    let p_t_nan = mt_jcc_pos(c)
    c = mt_jabs(c, t, 0x4410000000000000, 0)
    let p_half = mt_jcc_pos(c)

    c = mt_atan_core(c, z, t, k, 8)
    c = mt_jmp(c)
    let j_quad = mt_jmp_pos(c)

    // t is NaN: 0/0 -> z = 0, then the quadrant rule; inf/inf -> +-pi/4, +-3pi/4.
    c = mt_patch6(c, p_t_nan)
    c = mt_jabs(c, x, 0x7FF0000000000000, 0)
    let p_infinf = mt_jcc_pos(c)
    c = mt_lc(c, z, zero)

    // quadrant: x > 0 (or +0): z.  x < 0 (or -0): pi - (z - pi_lo).
    c = mt_patch5(c, j_quad)
    c = mt_jflag(c, xs, 0)
    let p_xpos = mt_jcc_pos(c)
    c = mt_cf(c, 1, sc, pi_lo, z)                     // wrong order guard below
    // sc = pi_lo - z, so z - pi_lo = -sc and pi - (z - pi_lo) = pi + sc
    c = mt_cf(c, 0, out, pi_hi, sc)
    c = mt_jmp(c)
    let j_q1 = mt_jmp_pos(c)
    c = mt_patch6(c, p_xpos)
    c = mf_mov_slot(c, out, z)
    c = mt_patch5(c, j_q1)
    c = mf_fneg_slot_if(c, out, ys)
    c = mt_jmp(c)
    let e1 = mt_jmp_pos(c)

    // inf/inf
    c = mt_patch6(c, p_infinf)
    c = mt_lc(c, out, pio4)
    c = mt_jflag(c, xs, 0)
    let p_ip = mt_jcc_pos(c)
    c = mt_lc(c, out, p3o4)
    c = mt_patch6(c, p_ip)
    c = mf_fneg_slot_if(c, out, ys)
    c = mt_jmp(c)
    let e2 = mt_jmp_pos(c)

    // |y/x| >= 2^66 (x = 0, y = inf, or overflow): +-pi/2
    c = mt_patch6(c, p_half)
    c = mt_lc(c, out, hi3)
    c = mf_fneg_slot_if(c, out, ys)
    c = mt_jmp(c)
    let e3 = mt_jmp_pos(c)

    // NaN operand
    c = mt_patch6(c, p_nan1)
    c = mt_patch6(c, p_nan2)
    c = mt_f(c, 0, out, y, x)

    c = mt_patch5(c, e1)
    c = mt_patch5(c, e2)
    c = mt_patch5(c, e3)
    c = mt_epilogue(c, out, 16)
    c
}

// ---------------------------------------------------------------------------
// asin(x) = sign(x) * atan(|x| / sqrt((1-|x|)(1+|x|))).  Slots: 0 x, 1 out,
// 2 sg, 3 ab, 4 s, 5 t, 6 z, 7 scratch, 8..15 atan core temps.
// |x| > 1 -> NaN; |x| = 1 -> s = 0, t = inf, atan core returns pi/2.
// ---------------------------------------------------------------------------
pub fn emit_builtin_mt_asin(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c = mt_reg_atan_consts(c)
    let k = c.rodata.last_offset - 8 * 39
    let one = k
    let zero = k + 24
    let x = mt_s(0)
    let out = mt_s(1)
    let sg = mt_s(2)
    let ab = mt_s(3)
    let s = mt_s(4)
    let t = mt_s(5)
    let z = mt_s(6)
    let sc = mt_s(7)

    c = mt_prologue(c, 16)
    c = mt_spill_rdi(c, x)
    c = mt_jabs(c, x, 0x7FF0000000000000, 2)
    let p_nan = mt_jcc_pos(c)
    c = mt_jabs(c, x, 0x3FF0000000000001, 0)
    let p_dom = mt_jcc_pos(c)
    c = mt_jabs(c, x, 0x3E20000000000000, 1)
    let p_tiny = mt_jcc_pos(c)
    c = mt_sign_to(c, sg, x)
    c = mf_fabs_slot(c, ab, x)
    c = mt_cf(c, 1, s, one, ab)                       // 1 - |x|   (exact for |x| >= 1/2)
    c = mt_cf(c, 0, sc, one, ab)                      // 1 + |x|
    c = mt_f(c, 2, s, s, sc)
    c = mt_sqrt(c, s, s)
    c = mt_f(c, 3, t, ab, s)
    c = mt_atan_core(c, z, t, k, 8)
    c = mf_mov_slot(c, out, z)
    c = mf_fneg_slot_if(c, out, sg)
    c = mt_jmp(c)
    let e1 = mt_jmp_pos(c)

    c = mt_patch6(c, p_nan)
    c = mt_f(c, 0, out, x, x)
    c = mt_jmp(c)
    let e2 = mt_jmp_pos(c)

    c = mt_patch6(c, p_dom)
    c = mt_cc(c, 3, out, zero, zero)                  // 0/0 = NaN
    c = mt_jmp(c)
    let e3 = mt_jmp_pos(c)

    c = mt_patch6(c, p_tiny)
    c = mf_mov_slot(c, out, x)

    c = mt_patch5(c, e1)
    c = mt_patch5(c, e2)
    c = mt_patch5(c, e3)
    c = mt_epilogue(c, out, 16)
    c
}

// ---------------------------------------------------------------------------
// acos(x) = atan(sqrt((1-|x|)(1+|x|)) / |x|) for x > 0, pi - that for x < 0.
// Same slots as asin. |x| tiny (t >= 2^66, incl. x = +-0): pi/2.
// ---------------------------------------------------------------------------
pub fn emit_builtin_mt_acos(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c = mt_reg_atan_consts(c)
    let k = c.rodata.last_offset - 8 * 39
    let one = k
    let zero = k + 24
    let hi3 = k + 32 + 24
    let pi_hi = k + 288
    let pi_lo = k + 296
    let x = mt_s(0)
    let out = mt_s(1)
    let sg = mt_s(2)
    let ab = mt_s(3)
    let s = mt_s(4)
    let t = mt_s(5)
    let z = mt_s(6)
    let sc = mt_s(7)

    c = mt_prologue(c, 16)
    c = mt_spill_rdi(c, x)
    c = mt_jabs(c, x, 0x7FF0000000000000, 2)
    let p_nan = mt_jcc_pos(c)
    c = mt_jabs(c, x, 0x3FF0000000000001, 0)
    let p_dom = mt_jcc_pos(c)
    c = mt_sign_to(c, sg, x)
    c = mf_fabs_slot(c, ab, x)
    c = mt_cf(c, 1, s, one, ab)
    c = mt_cf(c, 0, sc, one, ab)
    c = mt_f(c, 2, s, s, sc)
    c = mt_sqrt(c, s, s)
    c = mt_f(c, 3, t, s, ab)                          // inf when x = +-0
    c = mt_jabs(c, t, 0x4410000000000000, 0)
    let p_half = mt_jcc_pos(c)
    c = mt_atan_core(c, z, t, k, 8)
    c = mt_jflag(c, sg, 0)
    let p_pos = mt_jcc_pos(c)
    c = mt_cf(c, 1, sc, pi_lo, z)                     // pi_lo - z
    c = mt_cf(c, 0, out, pi_hi, sc)                   // pi - (z - pi_lo)
    c = mt_jmp(c)
    let e1 = mt_jmp_pos(c)
    c = mt_patch6(c, p_pos)
    c = mf_mov_slot(c, out, z)
    c = mt_jmp(c)
    let e2 = mt_jmp_pos(c)

    c = mt_patch6(c, p_half)
    c = mt_lc(c, out, hi3)
    c = mt_jmp(c)
    let e3 = mt_jmp_pos(c)

    c = mt_patch6(c, p_nan)
    c = mt_f(c, 0, out, x, x)
    c = mt_jmp(c)
    let e4 = mt_jmp_pos(c)

    c = mt_patch6(c, p_dom)
    c = mt_cc(c, 3, out, zero, zero)

    c = mt_patch5(c, e1)
    c = mt_patch5(c, e2)
    c = mt_patch5(c, e3)
    c = mt_patch5(c, e4)
    c = mt_epilogue(c, out, 16)
    c
}

// ---------------------------------------------------------------------------
// tan(x).
//
// Reduction: n = round(|x| * 2/pi); r = |x| - n*pi/2 where pi/2 is carried as
// FOUR doubles (212 bits) and each n*part is an exact TwoProd. The nine terms are
// summed with a TwoSum cascade, so the only rounding is in the running
// correction, ~2^-106 of the intermediate. Then sin r and cos r by Taylor on
// |r| <= ~pi/4 and tan = sin/cos (n even) or -cos/sin (n odd). tan is odd.
//
// |x| >= 2^50 (n would not fit the 212-bit pi/2) returns NaN: NO Payne-Hanek
// reduction here. NaN/inf -> NaN. |x| < 2^-27 -> x.
//
// Slots: 0 x, 1 out, 2 sg(int), 3 ab, 4 nd, 5 ni(int), 6 S, 7 C, 8 E, 9 term,
// 10 p, 11 e, 12..19 TwoProd/TwoDiff temps, 20 rh, 21 rl, 22 u, 23 sinr, 24 cosr,
// 25 poly, 26 scratch, 27 scratch2.
// Constants (k): 2/pi k, pi/2 parts k+8..k+32, SPLIT k+40, 1.0 k+48, 0.5 k+56,
// 0.0 k+64, S[i] k+72+8i (i<10), Q[i] k+152+8i (i<9).
// ---------------------------------------------------------------------------
fn mt_tan_acc(nc: NativeCompiler, term: i64, k: i64) -> NativeCompiler with Mut, Panic, Div {
    // (S, E) = two_diff(S, term); C = C + E
    var c = nc
    let sS = mt_s(6)
    let sC = mt_s(7)
    let sE = mt_s(8)
    c = mf_two_diff(c, sS, sE, sS, term, mt_s(12), mt_s(13), mt_s(14))
    c = mt_f(c, 0, sC, sC, sE)
    c
}

pub fn emit_builtin_mt_tan(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c = mt_reg_tan_consts(c)
    let k = c.rodata.last_offset - 8 * 27
    let inv_pio2 = k
    let split = k + 40
    let one = k + 48
    let half = k + 56
    let zero = k + 64
    let scf = k + 72
    let qcf = k + 152
    let x = mt_s(0)
    let out = mt_s(1)
    let sg = mt_s(2)
    let ab = mt_s(3)
    let nd = mt_s(4)
    let ni = mt_s(5)
    let sS = mt_s(6)
    let sC = mt_s(7)
    let sE = mt_s(8)
    let sp = mt_s(10)
    let se = mt_s(11)
    let rh = mt_s(20)
    let rl = mt_s(21)
    let u = mt_s(22)
    let sinr = mt_s(23)
    let cosr = mt_s(24)
    let pl = mt_s(25)
    let sc = mt_s(26)
    let sc2 = mt_s(27)

    c = mt_prologue(c, 32)
    c = mt_spill_rdi(c, x)
    c = mt_jabs(c, x, 0x7FF0000000000000, 0)
    let p_nonfin = mt_jcc_pos(c)
    c = mt_jabs(c, x, 0x4310000000000000, 0)
    let p_huge = mt_jcc_pos(c)
    c = mt_jabs(c, x, 0x3E40000000000000, 1)
    let p_tiny = mt_jcc_pos(c)
    c = mt_sign_to(c, sg, x)
    c = mf_fabs_slot(c, ab, x)

    // n = round(|x| * 2/pi)
    c = mt_fc(c, 2, nd, ab, inv_pio2)
    c = mf_ld0(c, nd)
    c.code = emit_roundsd_xmm0_xmm0_imm8(c.code, 8)
    c = mf_st0(c, nd)
    c = mf_ld0(c, nd)
    c.code = emit_cvttsd2si_rax_xmm0(c.code)
    c.code = emit_mov_reg_imm(c.code, 3, 1)
    c.code = emit_and_rax_rbx(c.code)
    c.code = emit_store_rax_rbp_disp32(c.code, ni)    // parity of n

    // S = |x|; C = 0; subtract n*(p1+p2+p3+p4) exactly.
    c = mf_mov_slot(c, sS, ab)
    c = mt_lc(c, sC, zero)
    var part = 0
    while part < 4 {
        c = mf_ld0c(c, k + 8 + 8 * part)
        c = mf_st0(c, sc)                              // the part, as a slot
        c = mf_two_prod(c, sp, se, nd, sc, split, mt_s(12), mt_s(13), mt_s(14), mt_s(15), mt_s(16), mt_s(17), mt_s(18))
        c = mt_tan_acc(c, sp, k)
        c = mt_tan_acc(c, se, k)
        part = part + 1
    }
    // r = S + C as (rh, rl)
    c = mt_f(c, 0, rh, sS, sC)
    c = mt_f(c, 1, sc, rh, sS)
    c = mt_f(c, 1, rl, sC, sc)

    // u = rh^2
    c = mt_f(c, 2, u, rh, rh)
    // cos: (1 - u/2) + u^2 * Q(u)
    c = mt_lc(c, pl, qcf + 8 * 8)
    var qi = 7
    while qi >= 0 {
        c = mt_horner(c, pl, u, qcf + 8 * qi)
        qi = qi - 1
    }
    c = mt_f(c, 2, sc, u, u)
    c = mt_f(c, 2, sc, sc, pl)                         // u^2 Q
    c = mt_fc(c, 2, sc2, u, half)                      // u/2
    c = mt_cf(c, 1, cosr, one, sc2)                    // 1 - u/2
    c = mt_f(c, 0, cosr, cosr, sc)
    // sin: rh + (rh*u*S(u) + rl*cos)
    c = mt_lc(c, pl, scf + 8 * 9)
    var si = 8
    while si >= 0 {
        c = mt_horner(c, pl, u, scf + 8 * si)
        si = si - 1
    }
    c = mt_f(c, 2, sc, rh, u)
    c = mt_f(c, 2, sc, sc, pl)                         // rh*u*S
    c = mt_f(c, 2, sc2, rl, cosr)
    c = mt_f(c, 0, sc, sc, sc2)
    c = mt_f(c, 0, sinr, rh, sc)
    // cos correction: cos(rh + rl) = cos rh - rl * sin
    c = mt_f(c, 2, sc, rl, sinr)
    c = mt_f(c, 1, cosr, cosr, sc)

    // n even: sin/cos; n odd: -cos/sin
    c = mt_jflag(c, ni, 1)
    let p_odd = mt_jcc_pos(c)
    c = mt_f(c, 3, out, sinr, cosr)
    c = mt_jmp(c)
    let j_even = mt_jmp_pos(c)
    c = mt_patch6(c, p_odd)
    c = mt_f(c, 3, out, cosr, sinr)
    c = mf_fneg_slot(c, out, out)
    c = mt_patch5(c, j_even)
    c = mf_fneg_slot_if(c, out, sg)
    c = mt_jmp(c)
    let e1 = mt_jmp_pos(c)

    // NaN / +-inf -> NaN
    c = mt_patch6(c, p_nonfin)
    c = mt_f(c, 1, out, x, x)
    c = mt_jmp(c)
    let e2 = mt_jmp_pos(c)

    // |x| >= 2^50: refused as NaN (no Payne-Hanek)
    c = mt_patch6(c, p_huge)
    c = mt_cc(c, 3, out, zero, zero)
    c = mt_jmp(c)
    let e3 = mt_jmp_pos(c)

    // tiny
    c = mt_patch6(c, p_tiny)
    c = mf_mov_slot(c, out, x)

    c = mt_patch5(c, e1)
    c = mt_patch5(c, e2)
    c = mt_patch5(c, e3)
    c = mt_epilogue(c, out, 32)
    c
}

// ---------------------------------------------------------------------------
// tanh(x) = sign * E / (E + 2), E = expm1(2|x|).
//
// |x| >= 22 -> +-1; |x| < 2^-28 -> x; NaN -> NaN.
// expm1(y): y < 0.7: y + y^2 * E(y) with 16 Taylor terms. Otherwise n = round(y/ln2),
// r = (y - n*ln2_hi) - n*ln2_lo with ln2_hi 40 bits (n*ln2_hi exact), p = expm1(r),
// expm1(y) = (2^n - 1) + 2^n * p.
//
// Slots: 0 x, 1 out, 2 sg(int), 3 ab, 4 y, 5 nd, 6 ni(int), 7 r, 8 p, 9 ex, 10 twon,
// 11 t1, 12 t2.
// Constants (k): 1.0 k, 2.0 k+8, 1/ln2 k+16, ln2_hi k+24, ln2_lo k+32, E[i] k+40+8i.
// ---------------------------------------------------------------------------
pub fn emit_builtin_mt_tanh(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c = mt_reg_tanh_consts(c)
    let k = c.rodata.last_offset - 8 * 20
    let one = k
    let two = k + 8
    let inv_ln2 = k + 16
    let ln2_hi = k + 24
    let ln2_lo = k + 32
    let ecf = k + 40
    let x = mt_s(0)
    let out = mt_s(1)
    let sg = mt_s(2)
    let ab = mt_s(3)
    let y = mt_s(4)
    let nd = mt_s(5)
    let ni = mt_s(6)
    let r = mt_s(7)
    let p = mt_s(8)
    let ex = mt_s(9)
    let twon = mt_s(10)
    let t1 = mt_s(11)
    let t2 = mt_s(12)

    c = mt_prologue(c, 16)
    c = mt_spill_rdi(c, x)
    c = mt_jabs(c, x, 0x7FF0000000000000, 2)
    let p_nan = mt_jcc_pos(c)
    c = mt_sign_to(c, sg, x)
    c = mt_jabs(c, x, 0x4036000000000000, 0)
    let p_one = mt_jcc_pos(c)
    c = mt_jabs(c, x, 0x3E30000000000000, 1)
    let p_tiny = mt_jcc_pos(c)
    c = mf_fabs_slot(c, ab, x)
    c = mt_fc(c, 2, y, ab, two)                        // y = 2|x|
    c = mt_jabs(c, y, 0x3FE6666666666666, 1)
    let p_small = mt_jcc_pos(c)

    // y >= 0.7
    c = mt_fc(c, 2, nd, y, inv_ln2)
    c = mf_ld0(c, nd)
    c.code = emit_roundsd_xmm0_xmm0_imm8(c.code, 8)
    c = mf_st0(c, nd)
    c = mf_ld0(c, nd)
    c.code = emit_cvttsd2si_rax_xmm0(c.code)
    c.code = emit_store_rax_rbp_disp32(c.code, ni)
    c = mt_fc(c, 2, t1, nd, ln2_hi)
    c = mt_f(c, 1, r, y, t1)
    c = mt_fc(c, 2, t2, nd, ln2_lo)
    c = mt_f(c, 1, r, r, t2)
    c = mt_lc(c, p, ecf + 8 * 15)
    var ei = 14
    while ei >= 0 {
        c = mt_horner(c, p, r, ecf + 8 * ei)
        ei = ei - 1
    }
    c = mt_f(c, 2, t1, r, r)
    c = mt_f(c, 2, t1, t1, p)
    c = mt_f(c, 0, p, r, t1)                           // p = expm1(r)
    c = mf_pow2_slot(c, twon, ni, 0)
    c = mt_fc(c, 1, t1, twon, one)                     // 2^n - 1
    c = mt_f(c, 2, t2, twon, p)
    c = mt_f(c, 0, ex, t1, t2)
    c = mt_jmp(c)
    let j_fin = mt_jmp_pos(c)

    // y < 0.7: expm1(y) directly
    c = mt_patch6(c, p_small)
    c = mt_lc(c, p, ecf + 8 * 15)
    var di = 14
    while di >= 0 {
        c = mt_horner(c, p, y, ecf + 8 * di)
        di = di - 1
    }
    c = mt_f(c, 2, t1, y, y)
    c = mt_f(c, 2, t1, t1, p)
    c = mt_f(c, 0, ex, y, t1)

    c = mt_patch5(c, j_fin)
    c = mt_fc(c, 0, t1, ex, two)
    c = mt_f(c, 3, out, ex, t1)
    c = mf_fneg_slot_if(c, out, sg)
    c = mt_jmp(c)
    let e1 = mt_jmp_pos(c)

    c = mt_patch6(c, p_nan)
    c = mt_f(c, 0, out, x, x)
    c = mt_jmp(c)
    let e2 = mt_jmp_pos(c)

    c = mt_patch6(c, p_one)
    c = mt_lc(c, out, one)
    c = mf_fneg_slot_if(c, out, sg)
    c = mt_jmp(c)
    let e3 = mt_jmp_pos(c)

    c = mt_patch6(c, p_tiny)
    c = mf_mov_slot(c, out, x)

    c = mt_patch5(c, e1)
    c = mt_patch5(c, e2)
    c = mt_patch5(c, e3)
    c = mt_epilogue(c, out, 16)
    c
}
