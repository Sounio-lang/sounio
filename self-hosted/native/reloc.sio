// self-hosted::native::reloc — Relocation tracking and patching
//
// Handles forward references and code patching for function calls and jumps.

module native::reloc

use native::encode::{CodeBuffer, low8, NC_BIG_CODE}

// Relocation kinds
pub struct RelocKind {
    pub kind_code: i64,   // 1=rel32 function call, 2=RIP-relative rodata, 3=RIP-relative .data
}

pub fn reloc_rel32() -> RelocKind {
    RelocKind { kind_code: 1 }
}

pub fn reloc_rip_rel32() -> RelocKind {
    RelocKind { kind_code: 2 }
}

pub fn reloc_data_rel32() -> RelocKind {
    RelocKind { kind_code: 3 }
}

// Relocation target types
pub struct RelocTarget {
    pub is_function: i64,     // 1 if function, 0 if data label
    pub target_index: i64,    // Function index or data offset
}

pub fn reloc_target_function(func_index: i64) -> RelocTarget {
    RelocTarget { is_function: 1, target_index: func_index }
}

pub fn reloc_target_data(data_offset: i64) -> RelocTarget {
    RelocTarget { is_function: 0, target_index: data_offset }
}

// Single relocation entry
pub struct Relocation {
    pub offset: i64,          // Code buffer position to patch
    pub target: RelocTarget,  // What to patch
    pub kind: RelocKind,      // How to encode the patch
    pub flat_kind_code: i64,
    pub flat_is_function: i64,
    pub flat_target_index: i64,
}

// Relocation table (fixed-size array for bootstrap)
pub struct RelocationTable {
    pub entries: [Relocation; 4096],
    pub count: i64,
    // Set when an add_* was called with the table already full. Without it the
    // drop is invisible: the entry vanishes, the function returns normally, the
    // unpatched site keeps the displacement it was emitted with -- zero for
    // every rip-relative load here -- and the program reads the start of
    // .rodata instead of its constant. It assembles, it links, it runs.
    //
    // Mirrors NativeCompiler.reloc_overflow and code_overflow, which the ELF
    // writer already refuses on with rc=20 and rc=19. Raising the guard from
    // 256 to the declared 4096 moved the cliff; this makes falling off it
    // detectable, which is the part that actually matters.
    pub overflow: bool,
}

// Single source of truth for the RelocationTable bound, same contract as
// nc_flat_reloc_capacity() in frame.sio: the DECLARATION above must stay a
// literal (Sounio array sizes are not expressions); every bound CHECK calls
// this instead of repeating the number.
//
// It has to exist because the two had already drifted. entries was declared
// [Relocation; 4096] while all four add_* functions guarded with `count < 256`
// -- so from the 257th relocation onward the entry was DROPPED and the function
// returned normally. No flag, no error, no diagnostic anywhere downstream. The
// unpatched site keeps the displacement it was emitted with, which for every
// rip-relative load in this backend is zero, and the program reads whatever
// sits at the start of .rodata. It assembles, it links, it runs.
//
// Measured 2026-08-23 while wiring the libm intrinsics: a single
// emit_builtin_ffi_tgamma needs about 560 rip-relative relocations and
// emit_builtin_ffi_pow about 162. Either one alone is over the old guard. But
// the defect is not new and is not confined to them -- any program crossing 256
// was already affected.
//
// 4096 is the declared array size, not a new guess. Raising the guard to it
// does not make overflow impossible, only 16x further away; a relocation past
// 4096 is still dropped silently, and fixing THAT needs an overflow flag on the
// table, which means a field on a struct this backend passes by value with a
// 4096-element array inside it. That is a change to make deliberately, not as a
// side effect of an FFI branch.
pub fn reloc_table_capacity() -> i64 { 4096 }

pub fn reloc_table_new() -> RelocationTable with Mut {
    var out: RelocationTable
    out.count = 0
    out.overflow = false
    out
}

// Add a call relocation (rel32)
pub fn add_call_reloc(table: RelocationTable, offset: i64, target_func: i64) -> RelocationTable with Mut, Panic {
    var t = table
    if t.count < reloc_table_capacity() {
        t.entries[t.count as usize] = Relocation {
            offset: offset,
            target: reloc_target_function(target_func),
            kind: reloc_rel32(),
            flat_kind_code: 1,
            flat_is_function: 1,
            flat_target_index: target_func,
        }
        t.count = t.count + 1
    } else {
        t.overflow = true
    }
    t
}

// Add a data relocation (rip-relative)
pub fn add_data_reloc(table: RelocationTable, offset: i64, data_offset: i64) -> RelocationTable with Mut, Panic {
    var t = table
    if t.count < reloc_table_capacity() {
        t.entries[t.count as usize] = Relocation {
            offset: offset,
            target: reloc_target_data(data_offset),
            kind: reloc_rip_rel32(),
            flat_kind_code: 2,
            flat_is_function: 0,
            flat_target_index: data_offset,
        }
        t.count = t.count + 1
    } else {
        t.overflow = true
    }
    t
}

// Add RIP-relative relocation for string literals
pub fn add_rip_reloc(table: RelocationTable, lea_disp_offset: i64, rodata_offset: i64) -> RelocationTable with Mut, Panic {
    var t = table
    if t.count < reloc_table_capacity() {
        t.entries[t.count as usize] = Relocation {
            offset: lea_disp_offset,
            target: reloc_target_data(rodata_offset),
            kind: reloc_rip_rel32(),
            flat_kind_code: 2,
            flat_is_function: 0,
            flat_target_index: rodata_offset,
        }
        t.count = t.count + 1
    } else {
        t.overflow = true
    }
    t
}

// Add RIP-relative relocation targeting .data section (profiling counters)
pub fn add_data_section_reloc(table: RelocationTable, disp_offset: i64, data_offset: i64) -> RelocationTable with Mut, Panic {
    var t = table
    if t.count < reloc_table_capacity() {
        t.entries[t.count as usize] = Relocation {
            offset: disp_offset,
            target: reloc_target_data(data_offset),
            kind: reloc_data_rel32(),
            flat_kind_code: 3,
            flat_is_function: 0,
            flat_target_index: data_offset,
        }
        t.count = t.count + 1
    } else {
        t.overflow = true
    }
    t
}

// Apply all relocations (patch code buffer)
pub fn apply_relocations(
    table: RelocationTable,
    buf: CodeBuffer,
    fn_offsets: [i64; 16384],
    fn_count: i64,
    rodata_file_offset: i64,
    data_file_offset: i64
) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    var i = 0

    while i < table.count {
        let reloc = table.entries[i as usize]
        let patch_offset = reloc.offset

        if reloc.kind.kind_code == 1 {
            // Function call: rel32 = target_offset - (patch_offset + 4)
            if reloc.target.is_function == 1 {
                let target_idx = reloc.target.target_index
                if target_idx < fn_count {
                    let target_offset = fn_offsets[target_idx as usize]
                    let rel32 = target_offset - (patch_offset + 4)
                    b = patch_u32_le(b, patch_offset, rel32)
                }
            }
        } else if reloc.kind.kind_code == 2 {
            // RIP-relative data: disp32 = (rodata_file_offset + str_offset) - (lea_next_ip)
            let str_offset = reloc.target.target_index
            let text_file_offset = 4096
            let lea_next_ip = text_file_offset + patch_offset + 4
            let string_va = rodata_file_offset + str_offset
            let disp32 = string_va - lea_next_ip
            b = patch_u32_le(b, patch_offset, disp32)
        } else if reloc.kind.kind_code == 3 {
            // .data RIP-relative: same formula as rodata but with data_file_offset
            let data_off = reloc.target.target_index
            let text_file_offset2 = 4096
            let next_ip = text_file_offset2 + patch_offset + 4
            let counter_va = data_file_offset + data_off
            let disp32_data = counter_va - next_ip
            b = patch_u32_le(b, patch_offset, disp32_data)
        }

        i = i + 1
    }
    b
}

// ============================================================================
// RELA SECTION — ET_REL object file support
// ============================================================================

// Raw byte buffer for .rela.text — 256 Elf64_Rela entries max (24 bytes each = 6144 bytes)
pub struct RelaSection {
    pub bytes: [i8; 8192],
    pub len: i64,
}

pub fn rela_section_new() -> RelaSection with Mut {
    var out: RelaSection
    out.len = 0
    out
}

pub fn rela_emit_byte(rs: RelaSection, b: i64) -> RelaSection with Mut, Panic, Div {
    var r = rs
    if r.len < 8192 {
        r.bytes[r.len as usize] = low8(b) as i8
        r.len = r.len + 1
    }
    r
}

pub fn rela_emit_i64_le(rs: RelaSection, v: i64) -> RelaSection with Mut, Panic, Div {
    var r = rs
    r = rela_emit_byte(r, low8(v))
    r = rela_emit_byte(r, low8(v >> 8))
    r = rela_emit_byte(r, low8(v >> 16))
    r = rela_emit_byte(r, low8(v >> 24))
    r = rela_emit_byte(r, low8(v >> 32))
    r = rela_emit_byte(r, low8(v >> 40))
    r = rela_emit_byte(r, low8(v >> 48))
    r = rela_emit_byte(r, low8(v >> 56))
    r
}

// Collect Elf64_Rela entries for .rela.text (ET_REL output).
// Does NOT patch the code buffer — relocations remain unresolved for the linker.
//
// sym_first_fn : symbol index of the first function symbol in .symtab
// sym_rodata   : symbol index of .rodata section symbol (0 if no rodata)
// sym_data     : symbol index of .data section symbol (0 if no data)
//
// R_X86_64_PLT32=4 for function calls (addend=-4)
// R_X86_64_PC32=2  for RIP-relative data refs (addend=target_offset-4)
pub fn collect_rela_section(
    table: RelocationTable,
    sym_first_fn: i64,
    sym_rodata: i64,
    sym_data: i64
) -> RelaSection with Mut, Panic, Div {
    var rela = rela_section_new()
    var i = 0
    while i < table.count {
        let reloc = table.entries[i as usize]
        let r_offset = reloc.offset
        var r_type: i64 = 0
        var r_sym: i64 = 0
        var r_addend: i64 = 0
        if reloc.kind.kind_code == 1 {
            // Function call: R_X86_64_PLT32
            r_type = 4
            r_sym = sym_first_fn + reloc.target.target_index
            r_addend = -4
        } else if reloc.kind.kind_code == 2 {
            // RIP-relative .rodata ref: R_X86_64_PC32
            r_type = 2
            r_sym = sym_rodata
            r_addend = reloc.target.target_index - 4
        } else {
            // RIP-relative .data ref: R_X86_64_PC32
            r_type = 2
            r_sym = sym_data
            r_addend = reloc.target.target_index - 4
        }
        // r_info = (r_sym << 32) | r_type
        let r_info = r_sym * 4294967296 + r_type
        rela = rela_emit_i64_le(rela, r_offset)
        rela = rela_emit_i64_le(rela, r_info)
        rela = rela_emit_i64_le(rela, r_addend)
        i = i + 1
    }
    rela
}

// Patch a u32 at the given offset
pub fn patch_u32_le(buf: CodeBuffer, offset: i64, val: i64) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    if offset >= 0 && offset + 4 <= b.len {
        NC_BIG_CODE[offset as usize] = low8(val) as i8
        NC_BIG_CODE[(offset + 1) as usize] = low8(val >> 8) as i8
        NC_BIG_CODE[(offset + 2) as usize] = low8(val >> 16) as i8
        NC_BIG_CODE[(offset + 3) as usize] = low8(val >> 24) as i8
    }
    b
}

// Sprint 108: extern "C" fn call relocations
// sym_buf width matches Name.buf (384) so IR names pass without a silent narrow.
pub struct ExternReloc {
    pub offset: i64,
    pub sym_buf: [i8; 384],
    pub sym_len: i64,
}

pub struct ExternRelocTable {
    pub entries: [ExternReloc; 128],
    pub count: i64,
}

pub fn extern_reloc_empty_entry() -> ExternReloc {
    ExternReloc { offset: 0, sym_buf: [0; 384], sym_len: 0 }
}

pub fn extern_reloc_table_new() -> ExternRelocTable with Mut {
    var out: ExternRelocTable
    out.count = 0
    out
}

pub fn add_extern_reloc(table: &! ExternRelocTable, offset: i64, name_buf: [i8; 384], name_len: i64) with Mut, Panic {
    if (*table).count < 128 {
        let idx = (*table).count
        (*table).entries[idx as usize] = ExternReloc { offset: offset, sym_buf: name_buf, sym_len: name_len }
        (*table).count = idx + 1
    }
}
