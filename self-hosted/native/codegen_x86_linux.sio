    nc_core_store_rax_to_temp(nc, dst)
}

pub fn native_v2_core_emit_load_ref_field_into(nc: &! NativeCompiler, dst: i64, base_ref: i64, field_offset_words: i64) with Mut, Panic, Div {
    nc_core_load_temp_to_rax(nc, base_ref)
    nc_emit_load_rax_mem_rax(nc)
    native_v2_resolve_handle_to_object_base_rax_into(nc)
    nc_emit_mov_reg_imm(nc, 3, field_offset_words + native_v2_object_header_size() / 8)
    nc_emit_mov_rax_mem_rax_rbx8(nc)
    nc_core_store_rax_to_temp(nc, dst)
}

pub fn native_v2_core_emit_store_ref_field_into(nc: &! NativeCompiler, base_ref: i64, field_offset_words: i64, src: i64) with Mut, Panic, Div {
    nc_core_load_temp_to_rax(nc, base_ref)
    nc_emit_load_rax_mem_rax(nc)
    native_v2_resolve_handle_to_object_base_rax_into(nc)
    nc_emit_mov_rdx_rax(nc)
    nc_core_load_temp_to_rax(nc, src)
    nc_emit_mov_reg_imm(nc, 3, field_offset_words + native_v2_object_header_size() / 8)
    nc_emit_store_rax_mem_rdx_rbx8(nc)
}

pub fn native_v2_driver_state_base_offset() -> i64 { 4096 }

pub fn native_v2_driver_state_data_len() -> i64 { 262144 }

pub fn native_v2_core_emit_driver_global_load_into(nc: &! NativeCompiler, dst: i64, global_id: i64, index_reg: i64) with Mut, Panic, Div {
    let load_pos = (*nc).code.len + 3
    nc_emit_lea_rax_rip_disp32(nc, 0)
    nc_add_data_section_reloc(nc, load_pos, native_v2_driver_state_base_offset() + (global_id * 4096))
    nc_emit_mov_reg_reg(nc, 2, 0)
    nc_core_load_temp_to_rax(nc, index_reg)
    nc_emit_mov_reg_reg(nc, 3, 0)
    if global_id == 47 {
        nc_emit_movzx_rax_byte_rdx_rbx(nc)
    } else {
        nc_emit_load_rax_mem_rdx_rbx8(nc)
    }
    nc_core_store_rax_to_temp(nc, dst)
}

pub fn native_v2_core_emit_driver_global_store_into(nc: &! NativeCompiler, global_id: i64, index_reg: i64, src: i64) with Mut, Panic, Div {
    let load_pos = (*nc).code.len + 3
    nc_emit_lea_rax_rip_disp32(nc, 0)
    nc_add_data_section_reloc(nc, load_pos, native_v2_driver_state_base_offset() + (global_id * 4096))
    nc_emit_mov_reg_reg(nc, 2, 0)
    nc_core_load_temp_to_rax(nc, index_reg)
    nc_emit_mov_reg_reg(nc, 3, 0)
    nc_core_load_temp_to_rax(nc, src)
    if global_id == 47 {
        nc_emit_store_al_mem_rdx_rbx(nc)
    } else {
        nc_emit_store_rax_mem_rdx_rbx8(nc)
    }
}

pub fn native_v2_core_emit_local_array_load_into(nc: &! NativeCompiler, dst: i64, base_reg: i64, idx_reg: i64) with Mut, Panic, Div {
    // dst = arr[idx_runtime]; arrays are heap objects, base_reg stores a handle.
    nc_core_load_temp_to_rax(nc, base_reg)
    native_v2_resolve_handle_to_object_base_rax_into(nc)
    nc_emit_mov_reg_reg(nc, 2, 0)
