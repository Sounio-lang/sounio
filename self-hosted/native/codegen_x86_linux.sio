pub fn ARCH_AARCH64() -> i64 { native_policy_arch_aarch64() }
fn ARCH_RISCV64() -> i64 { native_policy_arch_riscv64() }

fn OS_UNKNOWN() -> i64 { native_policy_os_unknown() }
pub fn OS_LINUX() -> i64 { native_policy_os_linux() }
pub fn OS_MACOS() -> i64 { native_policy_os_macos() }
fn OS_WINDOWS() -> i64 { native_policy_os_windows() }

fn MATRIX_AUTO() -> i64 { 0 }
fn MATRIX_OFF() -> i64 { 1 }
fn MATRIX_APPLE_AMX() -> i64 { 2 }
fn MATRIX_INTEL_AMX() -> i64 { 3 }
fn MATRIX_IME() -> i64 { 4 }
fn MATRIX_VME() -> i64 { 5 }
fn MATRIX_AME() -> i64 { 6 }

fn FORMAT_NONE() -> i64 { 0 }
pub fn FORMAT_ELF64() -> i64 { 1 }
fn FORMAT_MACHO64() -> i64 { 2 }

pub fn ERR_OK() -> i64 { 0 }
pub fn ERR_BACKEND_NOT_IMPLEMENTED() -> i64 { 1 }
fn ERR_INVALID_TARGET() -> i64 { 2 }
fn ERR_INVALID_MATRIX() -> i64 { 3 }

fn TARGET_SOURCE_UNKNOWN() -> i64 { 0 }
pub(crate) fn TARGET_SOURCE_EXPLICIT() -> i64 { 1 }
fn TARGET_SOURCE_HOST_PROBE() -> i64 { 2 }
fn TARGET_SOURCE_ENV_OVERRIDE() -> i64 { 3 }
fn TARGET_SOURCE_FALLBACK() -> i64 { 4 }

