pub fn name_is_f64_to_bits(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 11 { return false }
    if n.buf[0] != 102 as i8 { return false }     // 'f'
    if n.buf[1] != 54 as i8 { return false }      // '6'
    if n.buf[2] != 52 as i8 { return false }      // '4'
    if n.buf[3] != 95 as i8 { return false }      // '_'
    if n.buf[4] != 116 as i8 { return false }     // 't'
    if n.buf[5] != 111 as i8 { return false }     // 'o'
    if n.buf[6] != 95 as i8 { return false }      // '_'
    if n.buf[7] != 98 as i8 { return false }      // 'b'
    if n.buf[8] != 105 as i8 { return false }     // 'i'
    if n.buf[9] != 116 as i8 { return false }     // 't'
    if n.buf[10] != 115 as i8 { return false }    // 's'
    true
}

pub fn name_is_bits_to_f64(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 11 { return false }
    if n.buf[0] != 98 as i8 { return false }      // 'b'
    if n.buf[1] != 105 as i8 { return false }     // 'i'
    if n.buf[2] != 116 as i8 { return false }     // 't'
    if n.buf[3] != 115 as i8 { return false }     // 's'
    if n.buf[4] != 95 as i8 { return false }      // '_'
    if n.buf[5] != 116 as i8 { return false }     // 't'
    if n.buf[6] != 111 as i8 { return false }     // 'o'
    if n.buf[7] != 95 as i8 { return false }      // '_'
    if n.buf[8] != 102 as i8 { return false }     // 'f'
    if n.buf[9] != 54 as i8 { return false }      // '6'
    if n.buf[10] != 52 as i8 { return false }     // '4'
    true
}

pub fn name_is_print_f64(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 9 { return false }
    if n.buf[0] != 112 as i8 { return false }     // 'p'
    if n.buf[1] != 114 as i8 { return false }     // 'r'
    if n.buf[2] != 105 as i8 { return false }     // 'i'
    if n.buf[3] != 110 as i8 { return false }     // 'n'
    if n.buf[4] != 116 as i8 { return false }     // 't'
    if n.buf[5] != 95 as i8 { return false }      // '_'
    if n.buf[6] != 102 as i8 { return false }     // 'f'
    if n.buf[7] != 54 as i8 { return false }      // '6'
    if n.buf[8] != 52 as i8 { return false }      // '4'
    true
}

pub fn name_is_exp(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 3 { return false }
    if n.buf[0] != 101 as i8 { return false }   // 'e'
    if n.buf[1] != 120 as i8 { return false }   // 'x'
    if n.buf[2] != 112 as i8 { return false }   // 'p'
    true
}

pub fn name_is_log(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 3 { return false }
    if n.buf[0] != 108 as i8 { return false }   // 'l'
    if n.buf[1] != 111 as i8 { return false }   // 'o'
    if n.buf[2] != 103 as i8 { return false }   // 'g'
    true
}

// Sprint 121: sin builtin name recognizer
pub fn name_is_sin(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 3 { return false }
    if n.buf[0] != 115 as i8 { return false }   // 's'
    if n.buf[1] != 105 as i8 { return false }   // 'i'
    if n.buf[2] != 110 as i8 { return false }   // 'n'
    true
}

// Sprint 121: cos builtin name recognizer
pub fn name_is_cos(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 3 { return false }
    if n.buf[0] != 99 as i8 { return false }    // 'c'
    if n.buf[1] != 111 as i8 { return false }   // 'o'
    if n.buf[2] != 115 as i8 { return false }   // 's'
    true
}


// ============================================================================
// Builtin runtime function emitters (hand-coded x86-64)
// ============================================================================

fn emit_load_runtime_context_field_rdi(nc: NativeCompiler, field_offset: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = emit_load_runtime_context_field_rax(nc, field_offset)
    c.code = emit_mov_rdi_rax(c.code)
    c
}

fn emit_load_runtime_context_field_r12(nc: NativeCompiler, field_offset: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = emit_load_runtime_context_field_rax(nc, field_offset)
    c.code = emit_mov_r12_rax(c.code)
    c
}

fn emit_store_runtime_context_imm(nc: NativeCompiler, field_offset: i64, value: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = emit_load_runtime_context_ptr_rbx(nc)
    c.code = emit_mov_rax_imm(c.code, value)
    c.code = emit_store_rax_mem_rbx_disp32(c.code, field_offset)
    c
}

fn nc_emit_byte(nc: &! NativeCompiler, b: i64) with Mut, Panic, Div {
    let len = (*nc).code.len
    if len >= 0 && len < nc_code_capacity_bytes() {
        NC_BIG_CODE[len as usize] = low8(b) as i8
        (*nc).code.len = len + 1
    } else {
        (*nc).code_overflow = true
    }
}

fn nc_emit_unimplemented_extern_trap_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_byte(nc, 0x0f)
    nc_emit_byte(nc, 0x0b)
}

fn nc_emit_u32_le(nc: &! NativeCompiler, val: i64) with Mut, Panic, Div {
    nc_emit_byte(nc, low8(val))
    nc_emit_byte(nc, low8(val >> 8))
    nc_emit_byte(nc, low8(val >> 16))
    nc_emit_byte(nc, low8(val >> 24))
}

fn nc_emit_u64_le(nc: &! NativeCompiler, val: i64) with Mut, Panic, Div {
    nc_emit_u32_le(nc, val)
    nc_emit_u32_le(nc, val >> 32)
}

fn nc_emit_mov_reg_imm32(nc: &! NativeCompiler, reg: i64, val: i64) with Mut, Panic, Div {
    if reg >= 8 {
        nc_emit_byte(nc, 0x49)
    } else {
        nc_emit_byte(nc, 0x48)
    }
    nc_emit_byte(nc, 0xc7)
    nc_emit_byte(nc, modrm_rm_imm(reg & 7))
    nc_emit_u32_le(nc, val)
}

fn nc_emit_mov_reg_imm64(nc: &! NativeCompiler, reg: i64, val: i64) with Mut, Panic, Div {
    if reg >= 8 {
        nc_emit_byte(nc, 0x49)
    } else {
        nc_emit_byte(nc, 0x48)
    }
    nc_emit_byte(nc, 0xb8 + (reg & 7))
    nc_emit_u64_le(nc, val)
}

fn nc_emit_mov_reg_imm(nc: &! NativeCompiler, reg: i64, val: i64) with Mut, Panic, Div {
    if val >= -2147483648 && val <= 2147483647 {
        nc_emit_mov_reg_imm32(nc, reg, val)
    } else {
        nc_emit_mov_reg_imm64(nc, reg, val)
    }
}

fn nc_emit_mov_rax_imm(nc: &! NativeCompiler, val: i64) with Mut, Panic, Div {
    nc_emit_mov_reg_imm(nc, 0, val)
}

fn nc_emit_mov_rdi_imm(nc: &! NativeCompiler, val: i64) with Mut, Panic, Div {
    nc_emit_mov_reg_imm(nc, 7, val)
}

