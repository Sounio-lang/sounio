fn native_v2_builtin_id_for_func_ref(func: &IrFunction) -> i64 with Mut, Panic, Div {
    // Empty stubs (instr_count == 0) from ir_module_ensure_builtin_call_targets
    // still map to hand-coded float/string/IO intrinsics. User/stdlib free
    // functions that share a name (e.g. epistemic::propagate::exp/cos) keep
    // their lowered IR body — name-only hijack used the float intrinsic ABI
    // on non-f64 args and SEGVd under multi-module Madaros (#1287 / Wave6 C).
    if (*func).instr_count > 0 {
        return 0
    }
    if native_v2_func_name_is_print_int(func) { return 1 }
    if native_v2_func_name_is_print_char(func) { return 2 }
    if native_v2_func_name_is_print(func) { return 3 }
    if name_is_get_arg_count((*func).name) { return 4 }
    if name_is_get_arg((*func).name) { return 5 }
    if name_is_str_len((*func).name) { return 6 }
    if name_is_str_char_at((*func).name) { return 20 }
    if name_is_str_eq((*func).name) { return 7 }
    if name_is_str_slice((*func).name) { return 8 }
    if name_is_starts_with((*func).name) { return 9 }
    if name_is_str_concat((*func).name) { return 10 }
    if name_is_read_file((*func).name) { return 11 }
    if name_is_write_file((*func).name) { return 12 }
    if name_is_file_size((*func).name) { return 13 }
    if name_is_sqrt((*func).name) { return 14 }
    if name_is_print_f64((*func).name) { return 15 }
    if name_is_exp((*func).name) { return 16 }
    if name_is_log((*func).name) { return 17 }
    if name_is_sin((*func).name) { return 18 }
    if name_is_cos((*func).name) { return 19 }
    if name_is_f64_to_bits((*func).name) { return 25 }
    if name_is_bits_to_f64((*func).name) { return 26 }
    if name_is_assert((*func).name) { return 21 }
    if name_is_str_from_bytes((*func).name) { return 22 }
    if name_is_heap_alloc((*func).name) { return 23 }
    if name_is_heap_free((*func).name) { return 24 }
    if name_is_syscall6((*func).name) { return 27 }
    if name_is_malloc((*func).name) { return 23 }
    if name_is_free((*func).name) { return 24 }
    if name_is_getpid((*func).name) { return 28 }
    if name_is_getppid((*func).name) { return 29 }
    if name_is_exit((*func).name) { return 30 }
    if name_is_abort((*func).name) { return 31 }
    if name_is_system((*func).name) { return 32 }
    if name_is_read_i64((*func).name) { return 33 }
    if name_is_write_i64((*func).name) { return 34 }
    if name_is_read_f64((*func).name) { return 35 }
    if name_is_write_f64((*func).name) { return 36 }
    if name_is_acknowledge((*func).name) { return 37 }
    if name_is_require_confidence((*func).name) { return 38 }
    0
}

// An empty IR body that is not a BSS slot and not a known builtin. The
// historical backend compiled these as prologue+ret, so a call read rax
// (usually 0). That is fabrication. Declaration-without-call still needs
// a callable symbol — emit ud2 so a missed E219 cannot return a value.
fn native_v2_empty_stub_would_fabricate(func: &IrFunction) -> bool with Mut, Panic, Div {
    if (*func).compile_strategy == IR_STRATEGY_BSS_GLOBAL { return false }
    if (*func).instr_count > 0 { return false }
    native_v2_builtin_id_for_func_ref(func) == 0
}

// M4: argv and string builtins

// syscall6(nr, a1..a6) raw Linux syscall builtin (id 27). Checker arm:
// call_expr_is_syscall6 in check/check.sio; lowering arm in ir/lower.sio.
fn name_is_syscall6(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 8 { return false }
    if n.buf[0] != 115 as i8 { return false }     // 's'
    if n.buf[1] != 121 as i8 { return false }     // 'y'
    if n.buf[2] != 115 as i8 { return false }     // 's'
    if n.buf[3] != 99 as i8 { return false }      // 'c'
    if n.buf[4] != 97 as i8 { return false }      // 'a'
    if n.buf[5] != 108 as i8 { return false }     // 'l'
    if n.buf[6] != 108 as i8 { return false }     // 'l'
    if n.buf[7] != 54 as i8 { return false }      // '6'
    true
}

fn name_is_get_arg_count(n: Name) -> bool with Mut, Panic, Div {
    // Source-level spelling is "arg_count"; retain the older
    // "get_arg_count" backend alias for hand-built IR witnesses.
    if n.len == 9 {
        if n.buf[0] != 97 as i8 { return false }      // 'a'
        if n.buf[1] != 114 as i8 { return false }     // 'r'
        if n.buf[2] != 103 as i8 { return false }     // 'g'
        if n.buf[3] != 95 as i8 { return false }      // '_'
        if n.buf[4] != 99 as i8 { return false }      // 'c'
        if n.buf[5] != 111 as i8 { return false }     // 'o'
        if n.buf[6] != 117 as i8 { return false }     // 'u'
        if n.buf[7] != 110 as i8 { return false }     // 'n'
        if n.buf[8] != 116 as i8 { return false }     // 't'
        return true
    }
    if n.len != 13 { return false }
    if n.buf[0] != 103 as i8 { return false }     // 'g'
    if n.buf[1] != 101 as i8 { return false }     // 'e'
    if n.buf[2] != 116 as i8 { return false }     // 't'
    if n.buf[3] != 95 as i8 { return false }      // '_'
    if n.buf[4] != 97 as i8 { return false }      // 'a'
    if n.buf[5] != 114 as i8 { return false }     // 'r'
    if n.buf[6] != 103 as i8 { return false }     // 'g'
    if n.buf[7] != 95 as i8 { return false }      // '_'
    if n.buf[8] != 99 as i8 { return false }      // 'c'
    if n.buf[9] != 111 as i8 { return false }     // 'o'
    if n.buf[10] != 117 as i8 { return false }    // 'u'
    if n.buf[11] != 110 as i8 { return false }    // 'n'
    if n.buf[12] != 116 as i8 { return false }    // 't'
    true
}

