// adc rax, rbx  (rax += rbx + CF). 48 11 d8. MOV-class ops between limbs preserve CF.
fn nc_emit_adc_rax_rbx(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_byte(nc, 0x48)
    nc_emit_byte(nc, 0x11)
    nc_emit_byte(nc, 0xd8)
}

// Unrolled N-limb carry-chain add: dst[k] = lhs[k] + rhs[k] (+carry) for k in 0..L-1.
// Limb k of base vreg v lives in vreg slot v+k (consecutive vregs at decreasing rbp
// addresses). Only flag-neutral mov loads/stores between add(limb0) and the adc steps,
// so the carry propagates correctly.
fn nc_wide_add_into(nc: &! NativeCompiler, lhs_vreg: i64, rhs_vreg: i64, dst_vreg: i64, limbs: i64) with Mut, Panic, Div {
    var k: i64 = 0
    while k < limbs {
        nc_emit_load_rbp_disp32_reg(nc, 3, ir_slot_offset(rhs_vreg + k))   // rbx = rhs limb k
        nc_emit_load_rbp_disp32_rax(nc, ir_slot_offset(lhs_vreg + k))      // rax = lhs limb k
        if k == 0 {
            nc_emit_add_rax_rbx(nc)
        } else {
            nc_emit_adc_rax_rbx(nc)
        }
        nc_emit_store_rax_rbp_disp32(nc, ir_slot_offset(dst_vreg + k))     // dst limb k = rax
        k = k + 1
    }
}

fn nc_emit_sub_rax_rbx(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_byte(nc, 0x48)
    nc_emit_byte(nc, 0x29)
    nc_emit_byte(nc, 0xd8)
}

// sbb rax, rbx  (rax -= rbx - CF). 48 19 d8.
fn nc_emit_sbb_rax_rbx(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_byte(nc, 0x48)
    nc_emit_byte(nc, 0x19)
    nc_emit_byte(nc, 0xd8)
}

// Unrolled N-limb borrow-chain subtract: dst[k] = lhs[k] - rhs[k] (-borrow).
fn nc_wide_sub_into(nc: &! NativeCompiler, lhs_vreg: i64, rhs_vreg: i64, dst_vreg: i64, limbs: i64) with Mut, Panic, Div {
    var k: i64 = 0
    while k < limbs {
        nc_emit_load_rbp_disp32_reg(nc, 3, ir_slot_offset(rhs_vreg + k))
        nc_emit_load_rbp_disp32_rax(nc, ir_slot_offset(lhs_vreg + k))
        if k == 0 {
            nc_emit_sub_rax_rbx(nc)
        } else {
            nc_emit_sbb_rax_rbx(nc)
        }
        nc_emit_store_rax_rbp_disp32(nc, ir_slot_offset(dst_vreg + k))
        k = k + 1
    }
}

