fn nc_v2_reset_label_state() with Mut, Panic {
    var i: i64 = 0
    while i < nc_v2_label_capacity() {
        NC_V2_LABEL_OFFSETS[i as usize] = -1
        i = i + 1
    }
    NC_V2_LABEL_PATCH_COUNT = 0
    NC_V2_NEXT_CMP_LABEL = 210
}


fn nc_add_label_patch(nc: &! NativeCompiler, patch_offset: i64, label_id: i64) with Mut, Panic {
    let idx = NC_V2_LABEL_PATCH_COUNT
    if idx >= 0 && idx < nc_v2_label_capacity() {
        NC_V2_LABEL_PATCH_OFFSETS[idx as usize] = patch_offset
        NC_V2_LABEL_PATCH_IDS[idx as usize] = label_id
        NC_V2_LABEL_PATCH_COUNT = idx + 1
    } else {
        // Dropping a patch leaves this branch's rel32 operand at the placeholder
        // 0, so it falls through instead of jumping: wrong answer, rc=0, silence.
        // Fail closed instead -- see nc_v2_label_capacity() in frame.sio.
        nc_note_label_overflow(nc)
    }
}

fn nc_define_label(nc: &! NativeCompiler, label_id: i64) with Mut, Panic {
    if label_id >= 0 && label_id < nc_v2_label_capacity() {
        NC_V2_LABEL_OFFSETS[label_id as usize] = (*nc).code.len
    } else {
        // An undefined label means every patch aimed at it stays at 0, so this is
        // the same silent miscompile from the other end.
        nc_note_label_overflow(nc)
    }
}

