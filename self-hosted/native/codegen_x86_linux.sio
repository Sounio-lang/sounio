fn native_v2_write_shadow_contract(path: string, module: &IrModule, target_spec: NativeTargetSpec, compile_ok: bool, error_code: i64, output_path: string) -> bool with IO, Mut, Panic, Div, Alloc {
    native_v2_write_contract(path, module, target_spec, compile_ok, error_code, output_path)
}

pub struct NativeTargetParse {
    ok: bool,
    arch_id: i64,
    os_id: i64,
    canonical: string,
}

fn native_target_parse_invalid() -> NativeTargetParse {
    NativeTargetParse {
        ok: false,
        arch_id: ARCH_UNKNOWN(),
        os_id: OS_UNKNOWN(),
        canonical: "",
    }
}

fn native_target_parse(raw: string) -> NativeTargetParse {
    if str_eq(raw, "x86_64-linux") {
        return NativeTargetParse { ok: true, arch_id: ARCH_X86_64(), os_id: OS_LINUX(), canonical: "x86_64-linux" }
    }
    if str_eq(raw, "aarch64-linux") {
        return NativeTargetParse { ok: true, arch_id: ARCH_AARCH64(), os_id: OS_LINUX(), canonical: "aarch64-linux" }
    }
    if str_eq(raw, "x86_64-macos") {
        return NativeTargetParse { ok: true, arch_id: ARCH_X86_64(), os_id: OS_MACOS(), canonical: "x86_64-macos" }
    }
    if str_eq(raw, "aarch64-macos") {
        return NativeTargetParse { ok: true, arch_id: ARCH_AARCH64(), os_id: OS_MACOS(), canonical: "aarch64-macos" }
    }
    if str_eq(raw, "riscv64-linux") {
        return NativeTargetParse { ok: true, arch_id: ARCH_RISCV64(), os_id: OS_LINUX(), canonical: "riscv64-linux" }
    }
    if str_eq(raw, "x86_64-windows") {
        return NativeTargetParse { ok: true, arch_id: ARCH_X86_64(), os_id: OS_WINDOWS(), canonical: "x86_64-windows" }
    }
    if str_eq(raw, "aarch64-windows") {
        return NativeTargetParse { ok: true, arch_id: ARCH_AARCH64(), os_id: OS_WINDOWS(), canonical: "aarch64-windows" }
    }
    native_target_parse_invalid()
}

fn native_target_spec_default(requested_target: string) -> NativeTargetSpec {
    NativeTargetSpec {
        arch_id: ARCH_UNKNOWN(),
        os_id: OS_UNKNOWN(),
        matrix_mode: MATRIX_AUTO(),
        source_id: TARGET_SOURCE_UNKNOWN(),
        requested_target: requested_target,
        resolved_target: "",
        fallback_reason: "",
    }
}

fn native_matrix_mode_parse(raw: string) -> i64 {
    if str_len(raw) == 0 { return MATRIX_AUTO() }
    if str_eq(raw, "auto") { return MATRIX_AUTO() }
    if str_eq(raw, "off") { return MATRIX_OFF() }
    if str_eq(raw, "apple-amx") { return MATRIX_APPLE_AMX() }
    if str_eq(raw, "intel-amx") { return MATRIX_INTEL_AMX() }
    if str_eq(raw, "ime") { return MATRIX_IME() }
    if str_eq(raw, "vme") { return MATRIX_VME() }
    if str_eq(raw, "ame") { return MATRIX_AME() }
    -1
}

pub fn native_matrix_mode_string(mode: i64) -> string {
    if mode == MATRIX_AUTO() { return "auto" }
    if mode == MATRIX_OFF() { return "off" }
    if mode == MATRIX_APPLE_AMX() { return "apple-amx" }
    if mode == MATRIX_INTEL_AMX() { return "intel-amx" }
    if mode == MATRIX_IME() { return "ime" }
    if mode == MATRIX_VME() { return "vme" }
    if mode == MATRIX_AME() { return "ame" }
    "invalid"
}

pub fn native_target_source_string(source_id: i64) -> string {
    if source_id == TARGET_SOURCE_EXPLICIT() { return "explicit_cli" }
    if source_id == TARGET_SOURCE_HOST_PROBE() { return "host_probe" }
    if source_id == TARGET_SOURCE_ENV_OVERRIDE() { return "env_override" }
    if source_id == TARGET_SOURCE_FALLBACK() { return "fallback" }
    "unknown"
}

fn native_host_probe_target() -> string with IO, Mut, Panic, Div {
    let host_type = read_env("HOSTTYPE")
    let os_type = read_env("OSTYPE")

    let is_linux = starts_with(os_type, "linux")
    let is_macos = starts_with(os_type, "darwin") || starts_with(os_type, "mac")

    if (starts_with(host_type, "x86_64") || starts_with(host_type, "amd64")) && is_linux {
        return "x86_64-linux"
    }
    if (starts_with(host_type, "arm64") || starts_with(host_type, "aarch64")) && is_linux {
        return "aarch64-linux"
    }
    if (starts_with(host_type, "x86_64") || starts_with(host_type, "amd64")) && is_macos {
        return "x86_64-macos"
    }
    if (starts_with(host_type, "arm64") || starts_with(host_type, "aarch64")) && is_macos {
        return "aarch64-macos"
    }
    if starts_with(host_type, "riscv64") && is_linux {
        return "riscv64-linux"
    }
    ""
}

pub fn native_resolve_target(requested_target: string, requested_matrix: string, explicit_target: bool) -> NativeTargetSpec with IO, Mut, Panic, Div {
    var req_target = requested_target
    if str_len(req_target) == 0 {
        req_target = "native-auto"
    }

    var spec = native_target_spec_default(req_target)

    let req_matrix_mode = native_matrix_mode_parse(requested_matrix)
    if req_matrix_mode < 0 {
        spec.matrix_mode = -1
        spec.fallback_reason = "invalid_matrix_mode"
        return spec
    }
    spec.matrix_mode = req_matrix_mode

    if explicit_target && !str_eq(req_target, "native-auto") {
        let parsed = native_target_parse(req_target)
        if parsed.ok {
            spec.arch_id = parsed.arch_id
            spec.os_id = parsed.os_id
            spec.resolved_target = parsed.canonical
            spec.source_id = TARGET_SOURCE_EXPLICIT()
        } else {
            spec.arch_id = ARCH_UNKNOWN()
            spec.os_id = OS_UNKNOWN()
            spec.resolved_target = req_target
            spec.source_id = TARGET_SOURCE_EXPLICIT()
            spec.fallback_reason = "invalid_target"
        }
        return spec
    }

    var resolved = native_host_probe_target()
    if str_len(resolved) > 0 {
        spec.source_id = TARGET_SOURCE_HOST_PROBE()
    } else {
        spec.source_id = TARGET_SOURCE_FALLBACK()
    }

    let target_override = read_env("SOUNIO_TARGET_OVERRIDE")
    if str_len(target_override) > 0 {
        let parsed_override = native_target_parse(target_override)
        if parsed_override.ok {
            resolved = parsed_override.canonical
            spec.source_id = TARGET_SOURCE_ENV_OVERRIDE()
        }
    }

    if spec.matrix_mode == MATRIX_AUTO() {
        let matrix_override = read_env("SOUNIO_MATRIX_OVERRIDE")
        if str_len(matrix_override) > 0 {
            let matrix_override_mode = native_matrix_mode_parse(matrix_override)
            if matrix_override_mode >= 0 {
                spec.matrix_mode = matrix_override_mode
            }
        }
    }

    if str_len(resolved) == 0 {
        resolved = "x86_64-linux"
        spec.source_id = TARGET_SOURCE_FALLBACK()
        spec.fallback_reason = "unresolved_default_x86_64_linux"
    }

    let parsed = native_target_parse(resolved)
    if parsed.ok {
        spec.arch_id = parsed.arch_id
        spec.os_id = parsed.os_id
        spec.resolved_target = parsed.canonical
    } else {
        spec.arch_id = ARCH_UNKNOWN()
        spec.os_id = OS_UNKNOWN()
        spec.resolved_target = resolved
        if str_len(spec.fallback_reason) == 0 {
            spec.fallback_reason = "invalid_target"
        }
    }

    spec
}

pub(crate) fn native_compile_result_error(code: i64, msg: string) -> NativeCompileResult {
    NativeCompileResult {
        ok: false,
        bytes: [0; 131072],
        len: 0,
        format_id: FORMAT_NONE(),
        error_code: code,
        error_msg: msg,
    }
}

pub(crate) fn native_compile_result_ok(bytes: [i8; 131072], len: i64, format_id: i64) -> NativeCompileResult {
    NativeCompileResult {
        ok: true,
        bytes: bytes,
        len: len,
        format_id: format_id,
        error_code: ERR_OK(),
        error_msg: "",
    }
}

fn native_compile_result_ok_narrow(bytes: [i8; 65536], len: i64, format_id: i64) -> NativeCompileResult with Mut, Panic, Div {
    var wide: [i8; 131072] = [0; 131072]
    var i: i64 = 0
    while i < len && i < 65536 {
        wide[i as usize] = bytes[i as usize]
        i = i + 1
    }
    native_compile_result_ok(wide, len, format_id)
}

fn native_compile_result_ok_wide(bytes: [i8; 16777216], len: i64, format_id: i64) -> NativeCompileResult with Mut, Panic, Div {
    var narrow: [i8; 131072] = [0; 131072]
    var i: i64 = 0
    while i < len && i < 131072 {
        narrow[i as usize] = bytes[i as usize]
        i = i + 1
    }
    native_compile_result_ok(narrow, len, format_id)
}

fn native_compile_result_ok_elf(bytes: [i8; 1048576], len: i64, format_id: i64) -> NativeCompileResult with Mut, Panic, Div {
    var narrow: [i8; 131072] = [0; 131072]
    var i: i64 = 0
    while i < len && i < 131072 {
        narrow[i as usize] = bytes[i as usize]
        i = i + 1
    }
    native_compile_result_ok(narrow, len, format_id)
}

// ============================================================================
// Name comparison helpers
// ============================================================================

fn name_is_main(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 4 { return false }
    if n.buf[0] != 109 as i8 { return false }     // 'm'
    if n.buf[1] != 97 as i8 { return false }      // 'a'
    if n.buf[2] != 105 as i8 { return false }     // 'i'
    if n.buf[3] != 110 as i8 { return false }     // 'n'
    true
}

fn name_is_print_int(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 9 { return false }
    if n.buf[0] != 112 as i8 { return false }     // 'p'
    if n.buf[1] != 114 as i8 { return false }     // 'r'
    if n.buf[2] != 105 as i8 { return false }     // 'i'
    if n.buf[3] != 110 as i8 { return false }     // 'n'
    if n.buf[4] != 116 as i8 { return false }     // 't'
    if n.buf[5] != 95 as i8 { return false }      // '_'
    if n.buf[6] != 105 as i8 { return false }     // 'i'
    if n.buf[7] != 110 as i8 { return false }     // 'n'
    if n.buf[8] != 116 as i8 { return false }     // 't'
    true
}

fn name_is_print_char(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 10 { return false }
    if n.buf[0] != 112 as i8 { return false }     // 'p'
    if n.buf[1] != 114 as i8 { return false }     // 'r'
    if n.buf[2] != 105 as i8 { return false }     // 'i'
    if n.buf[3] != 110 as i8 { return false }     // 'n'
    if n.buf[4] != 116 as i8 { return false }     // 't'
