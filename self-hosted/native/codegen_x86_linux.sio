fn nc_refresh_wide_mul_sabotage() with IO, Mut, Panic, Div {
    if str_eq(read_env("SOUNIO_WIDE_MUL_SABOTAGE"), "1") {
        NC_WIDE_MUL_SABOTAGE = 1
    } else {
        NC_WIDE_MUL_SABOTAGE = 0
    }
}

// Schoolbook N-limb unsigned multiply: dst[0..L-1] = lower L limbs of lhs * rhs.
// Uses rcx as temp, scratch slots at dst_vreg+L and dst_vreg+L+1.
fn nc_wide_mul_into(nc: &! NativeCompiler, lhs_vreg: i64, rhs_vreg: i64, dst_vreg: i64, limbs: i64) with Mut, Panic, Div {
    // Positive-control hook: a witness that never fails is not a witness.
    // SOUNIO_WIDE_MUL_SABOTAGE=1 leaves the product zero so the Lorenz-peak
    // tests must fail. Ordinary compiles leave this unset. The env is read
    // once per function in nc_refresh_wide_mul_sabotage (IO) so this helper
    // does not declare IO.
    if NC_WIDE_MUL_SABOTAGE == 1 {
        nc_emit_xor_rax_rax(nc)
        var sk: i64 = 0
        while sk < limbs {
            nc_emit_store_rax_rbp_disp32(nc, ir_slot_offset(dst_vreg + sk))
            sk = sk + 1
        }
        return
    }
    let scratch_carry = dst_vreg + limbs
    let scratch_rdx = dst_vreg + limbs + 1

    // Zero dst[0..L-1]
    nc_emit_xor_rax_rax(nc)
    var k: i64 = 0
    while k < limbs {
        nc_emit_store_rax_rbp_disp32(nc, ir_slot_offset(dst_vreg + k))
        k = k + 1
    }
    // Zero scratch_carry
    nc_emit_store_rax_rbp_disp32(nc, ir_slot_offset(scratch_carry))

    var i: i64 = 0
    while i < limbs {
        // Zero carry for this row
        nc_emit_xor_rax_rax(nc)
        nc_emit_store_rax_rbp_disp32(nc, ir_slot_offset(scratch_carry))

        var j: i64 = 0
        while j < limbs {
            if i + j >= limbs {
                break
            }

            // rax = lhs[i], rbx = rhs[j]
            nc_emit_load_rbp_disp32_rax(nc, ir_slot_offset(lhs_vreg + i))
            nc_emit_load_rbp_disp32_reg(nc, 3, ir_slot_offset(rhs_vreg + j))
            // rdx:rax = rax * rbx (unsigned)
            nc_emit_mul_rbx(nc)
            // Save rdx to scratch_rdx
            nc_emit_store_rbp_disp32_reg(nc, 2, ir_slot_offset(scratch_rdx))

            // rax += dst[i+j]
            nc_emit_load_rbp_disp32_reg(nc, 1, ir_slot_offset(dst_vreg + i + j))
            nc_emit_add_rax_rcx(nc)
            // Propagate CF → scratch_rdx
            nc_emit_load_rbp_disp32_reg(nc, 1, ir_slot_offset(scratch_rdx))
            nc_emit_adc_rcx_0(nc)
            nc_emit_store_rbp_disp32_reg(nc, 1, ir_slot_offset(scratch_rdx))

            // rax += scratch_carry
            nc_emit_load_rbp_disp32_reg(nc, 1, ir_slot_offset(scratch_carry))
            nc_emit_add_rax_rcx(nc)
            // Propagate CF → scratch_rdx
            nc_emit_load_rbp_disp32_reg(nc, 1, ir_slot_offset(scratch_rdx))
            nc_emit_adc_rcx_0(nc)
            nc_emit_store_rbp_disp32_reg(nc, 1, ir_slot_offset(scratch_rdx))

            // dst[i+j] = rax
            nc_emit_store_rax_rbp_disp32(nc, ir_slot_offset(dst_vreg + i + j))
            // scratch_carry = scratch_rdx
            nc_emit_load_rbp_disp32_reg(nc, 1, ir_slot_offset(scratch_rdx))
            nc_emit_store_rbp_disp32_reg(nc, 1, ir_slot_offset(scratch_carry))

            j = j + 1
        }
        i = i + 1
    }
}

fn nc_wide_cmp_equal_default(cmp_op: i64) -> i64 {
    if cmp_op == 0 { return 1 }  // Eq
    if cmp_op == 3 { return 1 }  // Le
    if cmp_op == 5 { return 1 }  // Ge
    0
}

fn nc_wide_cmp_emit_unequal_result(nc: &! NativeCompiler, cmp_op: i64) with Mut, Panic, Div {
    if cmp_op == 0 {
        nc_emit_mov_rax_imm(nc, 0)
    } else if cmp_op == 1 {
        nc_emit_mov_rax_imm(nc, 1)
    } else if cmp_op == 2 {
        nc_emit_setb_al(nc)
        nc_emit_movzx_rax_al(nc)
    } else if cmp_op == 3 {
        nc_emit_setbe_al(nc)
        nc_emit_movzx_rax_al(nc)
    } else if cmp_op == 4 {
        nc_emit_seta_al(nc)
        nc_emit_movzx_rax_al(nc)
    } else if cmp_op == 5 {
        nc_emit_setae_al(nc)
        nc_emit_movzx_rax_al(nc)
    } else {
        nc_emit_mov_rax_imm(nc, 0)
    }
}

fn nc_wide_cmp_into(nc: &! NativeCompiler, lhs_vreg: i64, rhs_vreg: i64, dst_vreg: i64, limbs: i64, cmp_op: i64) with Mut, Panic, Div {
    nc_emit_mov_rax_imm(nc, nc_wide_cmp_equal_default(cmp_op))
    nc_emit_store_rax_rbp_disp32(nc, ir_slot_offset(dst_vreg))

    var done_patches: [i64; 64] = [0; 64]
    var done_patch_count: i64 = 0
    var k: i64 = limbs
    while k > 0 {
        let limb = k - 1
        nc_emit_load_rbp_disp32_rax(nc, ir_slot_offset(lhs_vreg + limb))
        nc_emit_load_rbp_disp32_reg(nc, 3, ir_slot_offset(rhs_vreg + limb))
        nc_emit_cmp_rax_rbx(nc)

        let jz_pos = (*nc).code.len
        nc_emit_jz_rel32(nc)

        nc_wide_cmp_emit_unequal_result(nc, cmp_op)
        nc_emit_store_rax_rbp_disp32(nc, ir_slot_offset(dst_vreg))

        let jmp_done_pos = (*nc).code.len
        nc_emit_jmp_rel32(nc)
        done_patches[done_patch_count as usize] = jmp_done_pos + 1
        done_patch_count = done_patch_count + 1

        let next_limb_pos = (*nc).code.len
        nc_patch_u32_le(nc, jz_pos + 2, next_limb_pos - (jz_pos + 6))
        k = k - 1
    }

    let done_pos = (*nc).code.len
    var p: i64 = 0
    while p < done_patch_count {
        let patch_offset = done_patches[p as usize]
        nc_patch_u32_le(nc, patch_offset, done_pos - (patch_offset + 4))
        p = p + 1
    }
}

// --- Wide shift right by whole limbs ---
// dst[k] = src[k + shift_limbs] for k + shift_limbs < limbs, else 0.
fn nc_wide_shr_limb_into(nc: &! NativeCompiler, src_vreg: i64, dst_vreg: i64, limbs: i64, shift_limbs: i64) with Mut, Panic, Div {
    var k: i64 = 0
    while k < limbs {
        if k + shift_limbs < limbs {
            nc_emit_load_rbp_disp32_rax(nc, ir_slot_offset(src_vreg + k + shift_limbs))
        } else {
            nc_emit_xor_rax_rax(nc)
        }
        nc_emit_store_rax_rbp_disp32(nc, ir_slot_offset(dst_vreg + k))
        k = k + 1
    }
}

// --- Wide shift right by arbitrary bits ---
// shift_bits = q*64 + r. dst[k] = (src[k+q] >> r) | (src[k+q+1] << (64-r)).
fn nc_wide_shr_into(nc: &! NativeCompiler, src_vreg: i64, dst_vreg: i64, limbs: i64, shift_bits: i64) with Mut, Panic, Div {
    let q = shift_bits / 64
    let r = shift_bits % 64
    var k: i64 = 0
    while k < limbs {
        if k + q >= limbs {
            nc_emit_xor_rax_rax(nc)
            nc_emit_store_rax_rbp_disp32(nc, ir_slot_offset(dst_vreg + k))
        } else if r == 0 {
            nc_emit_load_rbp_disp32_rax(nc, ir_slot_offset(src_vreg + k + q))
            nc_emit_store_rax_rbp_disp32(nc, ir_slot_offset(dst_vreg + k))
        } else {
            nc_emit_load_rbp_disp32_rax(nc, ir_slot_offset(src_vreg + k + q))
            nc_emit_shr_rax_imm8(nc, r)
            if k + q + 1 < limbs {
                nc_emit_load_rbp_disp32_reg(nc, 2, ir_slot_offset(src_vreg + k + q + 1))
                nc_emit_shl_rdx_imm8(nc, 64 - r)
                nc_emit_or_rax_rdx(nc)
            }
            nc_emit_store_rax_rbp_disp32(nc, ir_slot_offset(dst_vreg + k))
        }
        k = k + 1
    }
}

// --- Wide unsigned division by single-limb divisor ---
// Schoolbook: hi->lo, using hardware DIV. Quotient -> dst, remainder discarded.
fn nc_wide_div_single_into(nc: &! NativeCompiler, dividend_vreg: i64, divisor_vreg: i64, dst_vreg: i64, limbs: i64) with Mut, Panic, Div {
    nc_emit_load_rbp_disp32_reg(nc, 3, ir_slot_offset(divisor_vreg))
    nc_emit_xor_rdx_rdx(nc)
    var k: i64 = limbs - 1
    while k >= 0 {
        nc_emit_load_rbp_disp32_rax(nc, ir_slot_offset(dividend_vreg + k))
        nc_emit_div_rbx(nc)
        nc_emit_store_rax_rbp_disp32(nc, ir_slot_offset(dst_vreg + k))
        k = k - 1
    }
}

// --- Wide unsigned modulo by single-limb divisor ---
// Same as div but return remainder in all dst limbs.
fn nc_wide_mod_single_into(nc: &! NativeCompiler, dividend_vreg: i64, divisor_vreg: i64, dst_vreg: i64, limbs: i64) with Mut, Panic, Div {
    nc_emit_load_rbp_disp32_reg(nc, 3, ir_slot_offset(divisor_vreg))
    nc_emit_xor_rdx_rdx(nc)
    var k: i64 = limbs - 1
    while k >= 0 {
        nc_emit_load_rbp_disp32_rax(nc, ir_slot_offset(dividend_vreg + k))
        nc_emit_div_rbx(nc)
        k = k - 1
    }
    nc_emit_store_rbp_disp32_reg(nc, 2, ir_slot_offset(dst_vreg))
    nc_emit_xor_rax_rax(nc)
    var j: i64 = 1
    while j < limbs {
        nc_emit_store_rax_rbp_disp32(nc, ir_slot_offset(dst_vreg + j))
        j = j + 1
    }
}

// --- Binary long division (fully unrolled, branchless) ---
// For DivFull: Q = N/D. For ModFull: R = N%D.
// Scratch: R at quotient_vreg+limbs (L limbs), trial at quotient_vreg+2*limbs (L limbs).
fn nc_wide_longdiv_into(nc: &! NativeCompiler, dividend_vreg: i64, divisor_vreg: i64, quotient_vreg: i64, limbs: i64, produce_remainder: i64) with Mut, Panic, Div {
    let r_base = quotient_vreg + limbs
    let trial_base = quotient_vreg + 2 * limbs

    nc_emit_xor_rax_rax(nc)
    var zi: i64 = 0
    while zi < limbs {
        nc_emit_store_rax_rbp_disp32(nc, ir_slot_offset(quotient_vreg + zi))
        zi = zi + 1
    }
    var zr: i64 = 0
    while zr < limbs {
        nc_emit_store_rax_rbp_disp32(nc, ir_slot_offset(r_base + zr))
        zr = zr + 1
    }

    var bit: i64 = limbs * 64 - 1
    while bit >= 0 {
        let src_limb = bit / 64
        let bit_pos = bit % 64

        nc_emit_load_rbp_disp32_rax(nc, ir_slot_offset(dividend_vreg + src_limb))
        nc_emit_bt_rax_imm8(nc, bit_pos)

        var ri: i64 = 0
        while ri < limbs {
            nc_emit_rcl_rbp_disp32(nc, ir_slot_offset(r_base + ri))
            ri = ri + 1
        }

        var ti: i64 = 0
        while ti < limbs {
            nc_emit_load_rbp_disp32_rax(nc, ir_slot_offset(r_base + ti))
            nc_emit_load_rbp_disp32_reg(nc, 3, ir_slot_offset(divisor_vreg + ti))
            if ti == 0 {
                nc_emit_sub_rax_rbx(nc)
            } else {
                nc_emit_sbb_rax_rbx(nc)
            }
            nc_emit_store_rax_rbp_disp32(nc, ir_slot_offset(trial_base + ti))
            ti = ti + 1
        }

        var ci: i64 = 0
        while ci < limbs {
            nc_emit_load_rbp_disp32_rax(nc, ir_slot_offset(trial_base + ci))
            nc_emit_load_rbp_disp32_reg(nc, 2, ir_slot_offset(r_base + ci))
            nc_emit_cmovc_rax_rdx(nc)
            nc_emit_store_rax_rbp_disp32(nc, ir_slot_offset(r_base + ci))
            ci = ci + 1
        }

        nc_emit_sbb_rcx_rcx(nc)
        nc_emit_not_rcx(nc)
        nc_emit_mov_rax_imm(nc, 1 << bit_pos)
        nc_emit_and_rax_rcx(nc)
        nc_emit_load_rbp_disp32_reg(nc, 3, ir_slot_offset(quotient_vreg + src_limb))
        nc_emit_or_rax_rbx(nc)
        nc_emit_store_rax_rbp_disp32(nc, ir_slot_offset(quotient_vreg + src_limb))

        bit = bit - 1
    }

    if produce_remainder != 0 {
        var mi: i64 = 0
        while mi < limbs {
            nc_emit_load_rbp_disp32_rax(nc, ir_slot_offset(r_base + mi))
            nc_emit_store_rax_rbp_disp32(nc, ir_slot_offset(quotient_vreg + mi))
            mi = mi + 1
        }
    }
}

fn nc_emit_imul_rbx_rbx_imm8(nc: &! NativeCompiler, imm: i64) with Mut, Panic, Div {
    nc_emit_byte(nc, 0x48)
    nc_emit_byte(nc, 0x6b)
    nc_emit_byte(nc, 0xdb)
    nc_emit_byte(nc, low8(imm))
}

fn nc_emit_cqo(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_byte(nc, 0x48)
    nc_emit_byte(nc, 0x99)
}

fn nc_emit_idiv_rcx(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_byte(nc, 0x48)
    nc_emit_byte(nc, 0xf7)
    nc_emit_byte(nc, 0xf9)
}

fn nc_emit_ud2(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_byte(nc, 0x0f)
    nc_emit_byte(nc, 0x0b)
}

fn nc_emit_exit_code(nc: &! NativeCompiler, code: i64) with Mut, Panic, Div {
    nc_emit_mov_rax_imm(nc, 60)
    nc_emit_mov_rdi_imm(nc, code)
    nc_emit_syscall(nc)
}

fn nc_emit_avx10_detect(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_byte(nc, 0xB8); nc_emit_byte(nc, 7); nc_emit_byte(nc, 0); nc_emit_byte(nc, 0); nc_emit_byte(nc, 0)
    nc_emit_byte(nc, 0xB9); nc_emit_byte(nc, 1); nc_emit_byte(nc, 0); nc_emit_byte(nc, 0); nc_emit_byte(nc, 0)
    nc_emit_byte(nc, 0x0F); nc_emit_byte(nc, 0xA2)
    nc_emit_byte(nc, 0xF7); nc_emit_byte(nc, 0xC2); nc_emit_byte(nc, 0); nc_emit_byte(nc, 0); nc_emit_byte(nc, 0x08); nc_emit_byte(nc, 0)
    nc_emit_byte(nc, 0x74); nc_emit_byte(nc, 20)
    nc_emit_byte(nc, 0xB8); nc_emit_byte(nc, 0x24); nc_emit_byte(nc, 0); nc_emit_byte(nc, 0); nc_emit_byte(nc, 0)
    nc_emit_byte(nc, 0x31); nc_emit_byte(nc, 0xC9)
    nc_emit_byte(nc, 0x0F); nc_emit_byte(nc, 0xA2)
    nc_emit_byte(nc, 0xC1); nc_emit_byte(nc, 0xEB); nc_emit_byte(nc, 16)
    nc_emit_byte(nc, 0x83); nc_emit_byte(nc, 0xE3); nc_emit_byte(nc, 7)
    nc_emit_byte(nc, 0x41); nc_emit_byte(nc, 0x89); nc_emit_byte(nc, 0xDF)
    nc_emit_byte(nc, 0xEB); nc_emit_byte(nc, 26)
    nc_emit_byte(nc, 0xB8); nc_emit_byte(nc, 7); nc_emit_byte(nc, 0); nc_emit_byte(nc, 0); nc_emit_byte(nc, 0)
    nc_emit_byte(nc, 0x31); nc_emit_byte(nc, 0xC9)
    nc_emit_byte(nc, 0x0F); nc_emit_byte(nc, 0xA2)
    nc_emit_byte(nc, 0x45); nc_emit_byte(nc, 0x31); nc_emit_byte(nc, 0xFF)
    nc_emit_byte(nc, 0xF7); nc_emit_byte(nc, 0xC3); nc_emit_byte(nc, 0); nc_emit_byte(nc, 0); nc_emit_byte(nc, 1); nc_emit_byte(nc, 0)
    nc_emit_byte(nc, 0x74); nc_emit_byte(nc, 6)
    nc_emit_byte(nc, 0x41); nc_emit_byte(nc, 0xBF); nc_emit_byte(nc, 4); nc_emit_byte(nc, 0); nc_emit_byte(nc, 0); nc_emit_byte(nc, 0)
    nc_emit_byte(nc, 0x45); nc_emit_byte(nc, 0x85); nc_emit_byte(nc, 0xFF)
    nc_emit_byte(nc, 0x0F); nc_emit_byte(nc, 0x95); nc_emit_byte(nc, 0xC0)
    nc_emit_byte(nc, 0x48); nc_emit_byte(nc, 0x0F); nc_emit_byte(nc, 0xB6); nc_emit_byte(nc, 0xC0)
}

fn emit_store_runtime_context_imm_into(nc: &! NativeCompiler, field_offset: i64, value: i64) with Mut, Panic, Div {
    emit_load_runtime_context_ptr_rbx_into(nc)
    nc_emit_mov_rax_imm(nc, value)
    nc_emit_store_rax_mem_rbx_disp32(nc, field_offset)
}

fn emit_store_runtime_context_data_ptr(nc: NativeCompiler, field_offset: i64, data_offset: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    let load_disp_pos = c.code.len + 3
    c.code = emit_lea_rax_rip_disp32(c.code, 0)
    c.relocs = add_data_section_reloc(c.relocs, load_disp_pos, data_offset)
    c = emit_store_rax_runtime_context_field(c, field_offset)
    c
}

fn emit_store_runtime_context_data_ptr_into(nc: &! NativeCompiler, field_offset: i64, data_offset: i64) with Mut, Panic, Div {
    let load_disp_pos = (*nc).code.len + 3
    nc_emit_lea_rax_rip_disp32(nc, 0)
    nc_add_data_section_reloc(nc, load_disp_pos, data_offset)
    emit_store_rax_runtime_context_field_into(nc, field_offset)
}

fn emit_load_runtime_context_field_rax_into(nc: &! NativeCompiler, field_offset: i64) with Mut, Panic, Div {
    emit_load_runtime_context_ptr_rbx_into(nc)
    nc_emit_load_rax_mem_rbx_disp32(nc, field_offset)
}

fn emit_store_rax_runtime_context_field_into(nc: &! NativeCompiler, field_offset: i64) with Mut, Panic, Div {
    emit_load_runtime_context_ptr_rbx_into(nc)
    nc_emit_store_rax_mem_rbx_disp32(nc, field_offset)
}

fn emit_load_runtime_context_ptr_rbx_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    let disp_pos = (*nc).code.len + 3
    nc_emit_mov_rbx_rip_disp32(nc, 0)
    nc_add_data_section_reloc(nc, disp_pos, (*nc).runtime_context_slot_offset)
}

fn emit_load_gc_state_ptr_rbx(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = emit_load_runtime_context_field_rax(nc, runtime_context_field_gc_state())
    c.code = emit_mov_rbx_rax(c.code)
    c
}

fn emit_load_gc_state_field_rax(nc: NativeCompiler, field_offset: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = emit_load_gc_state_ptr_rbx(nc)
    c.code = emit_load_rax_mem_rbx_disp32(c.code, field_offset)
    c
}

fn emit_store_rax_gc_state_field(nc: NativeCompiler, field_offset: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = emit_load_gc_state_ptr_rbx(nc)
    c.code = emit_store_rax_mem_rbx_disp32(c.code, field_offset)
    c
}

fn emit_store_gc_state_imm(nc: NativeCompiler, field_offset: i64, value: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = emit_load_gc_state_ptr_rbx(nc)
    c.code = emit_mov_rax_imm(c.code, value)
    c.code = emit_store_rax_mem_rbx_disp32(c.code, field_offset)
    c
}

fn emit_increment_gc_state_field(nc: NativeCompiler, field_offset: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = emit_load_gc_state_field_rax(nc, field_offset)
    c.code = emit_mov_reg_imm(c.code, 1, 1)
    c.code = emit_add_reg_reg(c.code, 0, 1)
    c = emit_store_rax_gc_state_field(c, field_offset)
    c
}

fn emit_store_runtime_context_field_to_gc_state(nc: NativeCompiler, runtime_field_offset: i64, gc_field_offset: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = emit_load_runtime_context_field_rax(nc, runtime_field_offset)
    c.code = emit_push_rax(c.code)
    c = emit_load_gc_state_ptr_rbx(c)
    c.code = emit_pop_rax(c.code)
    c.code = emit_store_rax_mem_rbx_disp32(c.code, gc_field_offset)
    c
}

fn native_v2_emit_gc_request_metadata(nc: NativeCompiler, total_size: i64, reason: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c = emit_increment_gc_state_field(c, native_v2_gc_state_field_collection_requests())
    c = emit_store_gc_state_imm(c, native_v2_gc_state_field_flags(), native_v2_gc_flag_ready() + native_v2_gc_flag_slowpath_requested())
    c = emit_store_gc_state_imm(c, native_v2_gc_state_field_last_request_size(), total_size)
    c = emit_store_gc_state_imm(c, native_v2_gc_state_field_last_reason(), reason)
    c = emit_store_gc_state_imm(c, native_v2_gc_state_field_last_code_offset(), c.code.len)
    c = emit_store_runtime_context_field_to_gc_state(c, runtime_context_field_heap_cursor(), native_v2_gc_state_field_last_heap_cursor())
    c = emit_store_runtime_context_field_to_gc_state(c, runtime_context_field_heap_limit(), native_v2_gc_state_field_last_heap_limit())
    c = emit_store_runtime_context_field_to_gc_state(c, runtime_context_field_handle_count(), native_v2_gc_state_field_handle_count())
    c = emit_store_runtime_context_field_to_gc_state(c, runtime_context_field_handle_capacity(), native_v2_gc_state_field_handle_capacity())
    c = emit_store_runtime_context_field_to_gc_state(c, runtime_context_field_descriptor_table(), native_v2_gc_state_field_descriptor_table_offset())
    c = emit_store_runtime_context_field_to_gc_state(c, runtime_context_field_descriptor_count(), native_v2_gc_state_field_descriptor_count())
    c = emit_store_runtime_context_field_to_gc_state(c, runtime_context_field_pin_registry(), native_v2_gc_state_field_pin_registry_offset())
    c = emit_store_runtime_context_field_to_gc_state(c, runtime_context_field_pin_count(), native_v2_gc_state_field_pin_count())
    c = emit_store_runtime_context_field_to_gc_state(c, runtime_context_field_collector_epoch(), native_v2_gc_state_field_collector_epoch())
    c = emit_store_runtime_context_field_to_gc_state(c, runtime_context_field_stack_maps(), native_v2_gc_state_field_stack_maps_offset())
    c = emit_store_runtime_context_field_to_gc_state(c, runtime_context_field_deopt_state(), native_v2_gc_state_field_deopt_state_offset())
    c
}

fn native_v2_emit_current_frame_live_probe(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    var live_patch_offsets: [i64; 1024] = [0; 1024]
    var live_patch_count: i64 = 0

    var temp: i64 = 0
    while temp < c.current_machine_base_slots && live_patch_count < 1024 {
        c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(temp))
        c.code = emit_test_rax_rax(c.code)
        live_patch_offsets[live_patch_count as usize] = c.code.len
        c.code = emit_jnz_rel32(c.code)
        live_patch_count = live_patch_count + 1
        temp = temp + 1
    }

    var spill: i64 = 0
    while spill < c.current_machine_spill_count && live_patch_count < 1024 {
        c.code = emit_load_rbp_disp32_rax(c.code, native_v2_spill_slot_offset(c.current_machine_base_slots, spill))
        c.code = emit_test_rax_rax(c.code)
        live_patch_offsets[live_patch_count as usize] = c.code.len
        c.code = emit_jnz_rel32(c.code)
        live_patch_count = live_patch_count + 1
        spill = spill + 1
    }

    c.code = emit_xor_rax_rax(c.code)
    let done_jmp = c.code.len
    c.code = emit_jmp_rel32(c.code)

    let live_target = c.code.len
    c.code = emit_mov_rax_imm(c.code, 1)

    let done_target = c.code.len
    c.code = patch_u32_le(c.code, done_jmp + 1, done_target - (done_jmp + 5))

    var i: i64 = 0
    while i < live_patch_count {
        let patch = live_patch_offsets[i as usize]
        c.code = patch_u32_le(c.code, patch + 2, live_target - (patch + 6))
        i = i + 1
    }
    c
}

fn native_v2_emit_gc_empty_frame_reset(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c = emit_load_runtime_context_field_rax(c, runtime_context_field_heap_base())
    c = emit_store_rax_runtime_context_field(c, runtime_context_field_heap_cursor())
    c = emit_store_rax_gc_state_field(c, native_v2_gc_state_field_last_heap_cursor())
    c = emit_store_runtime_context_imm(c, runtime_context_field_handle_count(), 0)
    c = emit_store_gc_state_imm(c, native_v2_gc_state_field_handle_count(), 0)
    c = emit_increment_gc_state_field(c, native_v2_gc_state_field_collections_completed())
    c = emit_increment_gc_state_field(c, native_v2_gc_state_field_compaction_count())
    c = emit_load_gc_state_field_rax(c, native_v2_gc_state_field_collector_epoch())
    c.code = emit_mov_reg_imm(c.code, 1, 1)
    c.code = emit_add_reg_reg(c.code, 0, 1)
    c = emit_store_rax_gc_state_field(c, native_v2_gc_state_field_collector_epoch())
    c = emit_store_rax_runtime_context_field(c, runtime_context_field_collector_epoch())
    c = emit_store_gc_state_imm(c, native_v2_gc_state_field_flags(), native_v2_gc_flag_ready() + native_v2_gc_flag_managed_handles())
    c = emit_store_runtime_context_imm(c, runtime_context_field_last_gc_stats(), 1)
    c
}

// Hybrid base resolution (issue #919):
//   handle id  ∈ [1, capacity)  → table lookup → object base
//   raw pointer ≥ capacity      → already an object base (unboxed small value)
// Unboxed ≤16 B value structs return the raw object base so they never consume
// a handle-table slot; field load/store must accept both encodings.
fn native_v2_resolve_handle_to_object_base_rax(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_mov_rbx_rax(c.code)
    c.code = emit_mov_rax_imm(c.code, native_v2_handle_raw_ptr_threshold())
    c.code = emit_cmp_rbx_rax(c.code)
    c.code = emit_setae_al(c.code)
    c.code = emit_movzx_rax_al(c.code)
    c.code = emit_test_rax_rax(c.code)
    let raw_jnz = c.code.len
    c.code = emit_jnz_rel32(c.code)

    c.code = emit_mov_rax_rbx(c.code)
    c.code = emit_imul_rbx_rbx_imm8(c.code, native_v2_handle_entry_size())
    c.code = emit_mov_reg_reg(c.code, 7, 3)
    c = emit_load_runtime_context_field_rax(c, runtime_context_field_handle_table_base())
    c.code = emit_mov_reg_reg(c.code, 3, 7)
    c.code = emit_add_rax_rbx(c.code)
    c.code = emit_load_rax_mem_rax_disp32(c.code, native_v2_handle_entry_field_object_base())
    let done_jmp = c.code.len
    c.code = emit_jmp_rel32(c.code)

    let raw_target = c.code.len
    c.code = patch_u32_le(c.code, raw_jnz + 2, raw_target - (raw_jnz + 6))
    c.code = emit_mov_rax_rbx(c.code)
    let done_target = c.code.len
    c.code = patch_u32_le(c.code, done_jmp + 1, done_target - (done_jmp + 5))
    c
}

fn native_v2_resolve_handle_to_object_base_rax_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_mov_rbx_rax(nc)
    nc_emit_mov_rax_imm(nc, native_v2_handle_raw_ptr_threshold())
    nc_emit_cmp_rbx_rax(nc)
    nc_emit_setae_al(nc)
    nc_emit_movzx_rax_al(nc)
    nc_emit_test_rax_rax(nc)
    let raw_jnz = (*nc).code.len
    nc_emit_jnz_rel32(nc)

    nc_emit_mov_rax_rbx(nc)
    nc_emit_imul_rbx_rbx_imm8(nc, native_v2_handle_entry_size())
    nc_emit_mov_reg_reg(nc, 7, 3)
    emit_load_runtime_context_field_rax_into(nc, runtime_context_field_handle_table_base())
    nc_emit_mov_reg_reg(nc, 3, 7)
    nc_emit_add_rax_rbx(nc)
    nc_emit_load_rax_mem_rax_disp32(nc, native_v2_handle_entry_field_object_base())
    let done_jmp = (*nc).code.len
    nc_emit_jmp_rel32(nc)

    let raw_target = (*nc).code.len
    nc_patch_u32_le(nc, raw_jnz + 2, raw_target - (raw_jnz + 6))
    nc_emit_mov_rax_rbx(nc)
    let done_target = (*nc).code.len
    nc_patch_u32_le(nc, done_jmp + 1, done_target - (done_jmp + 5))
}

fn nc_flat_data_prepare_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    if (*nc).flat_data_len > 0 { return }
    var i: i64 = 0
    while i < (*nc).data.len && i < nc_flat_data_capacity() {
        NC_BIG_DATA[i as usize] = (*nc).data.bytes[i as usize]
        i = i + 1
    }
    if i < (*nc).data.len {
        (*nc).data_overflow = true
    }
    (*nc).flat_data_len = i
}

fn nc_flat_data_append_byte_into(nc: &! NativeCompiler, value: i64) with Mut, Panic, Div {
    nc_flat_data_prepare_into(nc)
    let offset = (*nc).flat_data_len
    if offset < nc_flat_data_capacity() {
        NC_BIG_DATA[offset as usize] = (value & 0xFF) as i8
        (*nc).flat_data_len = offset + 1
    } else {
        (*nc).data_overflow = true
    }
    // Preserve the legacy prefix so existing decoders remain useful for small
    // blobs. The full emitter always selects NC_BIG_DATA once it is active.
    if (*nc).data.len < 8192 {
        (*nc).data.bytes[(*nc).data.len as usize] = (value & 0xFF) as i8
        (*nc).data.len = (*nc).data.len + 1
    }
}

fn nc_flat_data_align_into(nc: &! NativeCompiler, alignment: i64) with Mut, Panic, Div {
    nc_flat_data_prepare_into(nc)
    while alignment > 0 && ((*nc).flat_data_len % alignment) != 0 {
        nc_flat_data_append_byte_into(nc, 0)
    }
}

fn nc_flat_data_add_u64_into(nc: &! NativeCompiler, value: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < 8 {
        nc_flat_data_append_byte_into(nc, (value >> (i * 8)) & 0xFF)
        i = i + 1
    }
}

pub fn native_v2_flat_data_read_u64(data_len: i64, offset: i64) -> i64 with Mut, Panic, Div {
    if offset < 0 || (offset + 7) >= data_len { return 0 }
    var out: i64 = 0
    var i: i64 = 0
    while i < 8 {
        let raw = NC_BIG_DATA[(offset + i) as usize] as i64
        let byte = if raw < 0 { raw + 256 } else { raw }
        out = out | (byte << (i * 8))
        i = i + 1
    }
    out
}

fn native_v2_alloc_descriptor_id(tag: i64) -> i64 {
    if tag == 0 { return 0 }
    if tag == 1 { return 1 }
    if tag == 2 { return 2 }
    if tag == 8 { return 8 }
    255
}

fn native_v2_emit_descriptor_entry_into(nc: &! NativeCompiler, id: i64, kind: i64, payload_bytes: i64, payload_slots: i64, pointer_bitmap: i64) with Mut, Panic, Div {
    nc_flat_data_add_u64_into(nc, id)
    nc_flat_data_add_u64_into(nc, kind)
    nc_flat_data_add_u64_into(nc, payload_bytes)
    nc_flat_data_add_u64_into(nc, payload_slots)
    nc_flat_data_add_u64_into(nc, pointer_bitmap)
}

fn native_v2_emit_descriptor_table_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_flat_data_align_into(nc, 8)
    (*nc).descriptor_data_offset = (*nc).flat_data_len
    (*nc).descriptor_count = 5
    nc_flat_data_add_u64_into(nc, native_v2_descriptor_magic())
    nc_flat_data_add_u64_into(nc, native_v2_descriptor_version())
    nc_flat_data_add_u64_into(nc, (*nc).descriptor_count)
    native_v2_emit_descriptor_entry_into(nc, 0, native_v2_descriptor_kind_struct(), 512, 64, -1)
    native_v2_emit_descriptor_entry_into(nc, 1, native_v2_descriptor_kind_array(), 512, 64, -1)
    native_v2_emit_descriptor_entry_into(nc, 2, native_v2_descriptor_kind_tuple(), 128, 16, -1)
    native_v2_emit_descriptor_entry_into(nc, 8, native_v2_descriptor_kind_box(), 16, 2, 1)
    native_v2_emit_descriptor_entry_into(nc, 255, native_v2_descriptor_kind_opaque(), 64, 8, 0)
}

fn native_v2_record_safepoint(
    nc: NativeCompiler,
    fn_index: i64,
    kind: i64,
    machine_instr_index: i64,
    code_offset: i64,
    temp_count: i64,
    spill_count: i64
) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    if c.stack_map_record_count < 256 {
        let idx = c.stack_map_record_count
        let deopt_id = c.deopt_point_count
        c.stack_map_fn_indices[idx as usize] = fn_index
        c.stack_map_kinds[idx as usize] = kind
        c.stack_map_machine_instr_indices[idx as usize] = machine_instr_index
        c.stack_map_code_offsets[idx as usize] = code_offset
        c.stack_map_frame_sizes[idx as usize] = c.current_frame_size
        c.stack_map_temp_counts[idx as usize] = temp_count
        c.stack_map_spill_counts[idx as usize] = spill_count
        c.stack_map_root_temp_counts[idx as usize] = temp_count
        c.stack_map_root_spill_counts[idx as usize] = spill_count
        c.stack_map_callee_saved_root_masks[idx as usize] = 0
        c.stack_map_root_kind_masks[idx as usize] = native_v2_stack_map_root_kind_mixed()
        c.stack_map_deopt_ids[idx as usize] = deopt_id
        c.stack_map_tier_ids[idx as usize] = native_v2_stack_map_tier_baseline()
        c.stack_map_osr_eligibility[idx as usize] = if kind == NATIVE_V2_SAFEPOINT_CALL() { native_v2_stack_map_osr_eligible() } else { native_v2_stack_map_osr_ineligible() }
        c.stack_map_record_count = idx + 1
    }
    c.safepoint_count = c.safepoint_count + 1
    c.deopt_point_count = c.deopt_point_count + 1
    c
}

fn native_v2_record_safepoint_mut(
    nc: &! NativeCompiler,
    fn_index: i64,
    kind: i64,
    machine_instr_index: i64,
    code_offset: i64,
    temp_count: i64,
    spill_count: i64
) with Mut, Panic, Div {
    if (*nc).stack_map_record_count < 256 {
        let idx = (*nc).stack_map_record_count
        let deopt_id = (*nc).deopt_point_count
        (*nc).stack_map_fn_indices[idx as usize] = fn_index
        (*nc).stack_map_kinds[idx as usize] = kind
        (*nc).stack_map_machine_instr_indices[idx as usize] = machine_instr_index
        (*nc).stack_map_code_offsets[idx as usize] = code_offset
        (*nc).stack_map_frame_sizes[idx as usize] = (*nc).current_frame_size
        (*nc).stack_map_temp_counts[idx as usize] = temp_count
        (*nc).stack_map_spill_counts[idx as usize] = spill_count
        (*nc).stack_map_root_temp_counts[idx as usize] = temp_count
        (*nc).stack_map_root_spill_counts[idx as usize] = spill_count
        (*nc).stack_map_callee_saved_root_masks[idx as usize] = 0
        (*nc).stack_map_root_kind_masks[idx as usize] = native_v2_stack_map_root_kind_mixed()
        (*nc).stack_map_deopt_ids[idx as usize] = deopt_id
        (*nc).stack_map_tier_ids[idx as usize] = native_v2_stack_map_tier_baseline()
        (*nc).stack_map_osr_eligibility[idx as usize] = if kind == NATIVE_V2_SAFEPOINT_CALL() { native_v2_stack_map_osr_eligible() } else { native_v2_stack_map_osr_ineligible() }
        (*nc).stack_map_record_count = idx + 1
    }
    (*nc).safepoint_count = (*nc).safepoint_count + 1
    (*nc).deopt_point_count = (*nc).deopt_point_count + 1
}

pub fn native_v2_emit_runtime_metadata_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    native_v2_emit_descriptor_table_into(nc)
    nc_flat_data_align_into(nc, 8)
    (*nc).stack_map_data_offset = (*nc).flat_data_len
    nc_flat_data_add_u64_into(nc, native_v2_stack_map_version())
    nc_flat_data_add_u64_into(nc, (*nc).stack_map_record_count)
    nc_flat_data_add_u64_into(nc, (*nc).safepoint_count)
    nc_flat_data_add_u64_into(nc, (*nc).deopt_point_count)
    var i: i64 = 0
    while i < (*nc).stack_map_record_count {
        nc_flat_data_add_u64_into(nc, (*nc).stack_map_fn_indices[i as usize])
        nc_flat_data_add_u64_into(nc, (*nc).stack_map_kinds[i as usize])
        nc_flat_data_add_u64_into(nc, (*nc).stack_map_machine_instr_indices[i as usize])
        nc_flat_data_add_u64_into(nc, (*nc).stack_map_code_offsets[i as usize])
        nc_flat_data_add_u64_into(nc, (*nc).stack_map_frame_sizes[i as usize])
        nc_flat_data_add_u64_into(nc, (*nc).stack_map_temp_counts[i as usize])
        nc_flat_data_add_u64_into(nc, (*nc).stack_map_spill_counts[i as usize])
        nc_flat_data_add_u64_into(nc, (*nc).stack_map_root_temp_counts[i as usize])
        nc_flat_data_add_u64_into(nc, (*nc).stack_map_root_spill_counts[i as usize])
        nc_flat_data_add_u64_into(nc, (*nc).stack_map_callee_saved_root_masks[i as usize])
        nc_flat_data_add_u64_into(nc, (*nc).stack_map_root_kind_masks[i as usize])
        nc_flat_data_add_u64_into(nc, (*nc).stack_map_deopt_ids[i as usize])
        nc_flat_data_add_u64_into(nc, (*nc).stack_map_tier_ids[i as usize])
        nc_flat_data_add_u64_into(nc, (*nc).stack_map_osr_eligibility[i as usize])
        i = i + 1
    }

    nc_flat_data_align_into(nc, 8)
    (*nc).deopt_state_data_offset = (*nc).flat_data_len
    nc_flat_data_add_u64_into(nc, 1)
    nc_flat_data_add_u64_into(nc, (*nc).deopt_point_count)
    nc_flat_data_add_u64_into(nc, (*nc).stack_map_data_offset)
    i = 0
    while i < (*nc).stack_map_record_count {
        nc_flat_data_add_u64_into(nc, (*nc).stack_map_fn_indices[i as usize])
        nc_flat_data_add_u64_into(nc, (*nc).stack_map_code_offsets[i as usize])
        nc_flat_data_add_u64_into(nc, (*nc).stack_map_kinds[i as usize])
        i = i + 1
    }

    nc_flat_data_align_into(nc, 8)
    (*nc).gc_state_data_offset = (*nc).flat_data_len
    nc_flat_data_add_u64_into(nc, native_v2_gc_magic())
    nc_flat_data_add_u64_into(nc, native_v2_gc_version())
    nc_flat_data_add_u64_into(nc, native_v2_gc_flag_ready() + native_v2_gc_flag_managed_handles())
    nc_flat_data_add_u64_into(nc, 0)
    nc_flat_data_add_u64_into(nc, 0)
    nc_flat_data_add_u64_into(nc, 0)
    nc_flat_data_add_u64_into(nc, 0)
    nc_flat_data_add_u64_into(nc, 0)
    nc_flat_data_add_u64_into(nc, (*nc).stack_map_data_offset)
    nc_flat_data_add_u64_into(nc, (*nc).deopt_state_data_offset)
    nc_flat_data_add_u64_into(nc, native_v2_gc_reason_none())
    nc_flat_data_add_u64_into(nc, 0)
    nc_flat_data_add_u64_into(nc, 0)
    nc_flat_data_add_u64_into(nc, 0)
    nc_flat_data_add_u64_into(nc, native_v2_handle_table_capacity_default())
    nc_flat_data_add_u64_into(nc, (*nc).descriptor_data_offset)
    nc_flat_data_add_u64_into(nc, (*nc).descriptor_count)
    nc_flat_data_add_u64_into(nc, 0)
    nc_flat_data_add_u64_into(nc, 0)
    nc_flat_data_add_u64_into(nc, 0)
    nc_flat_data_add_u64_into(nc, 0)
}

// OS-dispatch helper: replaces the pattern "mov rax, 1; syscall" for sys_write.
// Precondition: RDI=fd (ignored on Windows), RSI=buffer, RDX=length.
// On Linux/macOS: emits mov rax,1; syscall (or macOS syscall number).
// On Windows: emits Win64 WriteFile call using function pointer from RuntimeContext.
//
// The dispatch is done at code-generation time based on target OS, not at runtime.
// For the v2 pipeline, builtins are always compiled for the target OS.
// This helper is used by all write-based builtins (print_int, print_char, print_str, etc.)
fn emit_write_syscall_for_target(nc: NativeCompiler, os_id: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    if os_id == 3 {
        // Windows: WriteFile(hFile, lpBuffer, nBytes, lpWritten, lpOverlapped)
        // On entry: RDI=fd (ignored), RSI=buffer, RDX=length
        // Win64 ABI: RCX=hFile, RDX=lpBuffer, R8=nBytes, R9=&written, [rsp+32]=NULL
        c.code = emit_push_rsi(c.code)
        c.code = emit_push_rdx(c.code)
        c.code = emit_sub_rsp_imm32(c.code, 56)  // 32 shadow + 8 written + 8 overlapped + 8 align

        // R8 = length (save from RDX before it's overwritten)
        c.code = emit_mov_rax_mem_rsp_disp8(c.code, 56)  // rax = saved RDX (length)
        c.code = emit_mov_r8_rax(c.code)                  // r8 = length

        // RDX = buffer (saved RSI)
        c.code = emit_mov_rax_mem_rsp_disp8(c.code, 64)  // rax = saved RSI (buffer)
        c.code = emit_mov_rdx_rax(c.code)                 // rdx = buffer

        // RCX = stdout handle from RuntimeContext
        c = emit_load_runtime_context_field_rax(c, runtime_context_field_win_stdout_handle())
        c.code = emit_mov_rcx_rax(c.code)

        // R9 = &lpNumberOfBytesWritten (use stack at rsp+32)
        c.code = emit_lea_r9_rsp_disp8(c.code, 32)

        // [rsp+40] = lpOverlapped = NULL
        c.code = emit_mov_qword_rsp_disp8_zero(c.code, 40)

        // Call WriteFile through RuntimeContext function pointer
        c = emit_load_runtime_context_field_rax(c, runtime_context_field_win_write_fn_ptr())
        c.code = emit_call_rax(c.code)

        c.code = emit_add_rsp_imm32(c.code, 56)
        c.code = emit_pop_rdx(c.code)
        c.code = emit_pop_rsi(c.code)
        return c
    }
    // Linux/macOS: standard syscall (rdi=fd, rsi=buf, rdx=len, rax=1)
    c.code = emit_mov_rax_imm(c.code, 1)
    c.code = emit_syscall(c.code)
    c
}

// OS-conditional open: SysV(rdi=path, rsi=flags, rdx=mode) → fd in rax
// Windows: CreateFileA via IAT (rcx=path, rdx=access, r8=share, r9=secattr, [rsp+32]=creation, [rsp+40]=flags)
// OS-conditional open: SysV(rdi=path, rsi=flags, rdx=mode) → fd in rax
// Windows: CreateFileA via RuntimeContext fn ptr
// On entry for Windows path: rax=path (caller must set), flags/mode used to pick access+creation
// OS-conditional open: SysV(rdi=path) → fd in rax
// Windows: CreateFileA via RuntimeContext fn ptr
// Caller must set rdi=path before calling. flags: 0=read, nonzero=write.
fn emit_open_syscall_for_target(nc: NativeCompiler, os_id: i64, flags: i64, mode: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    if os_id == 3 {
        // Win64: CreateFileA(rcx=path, rdx=access, r8=share, r9=secattr, [+32]=creation, [+40]=flags, [+48]=template)
        c.code = emit_sub_rsp_imm32(c.code, 64)
        c.code = emit_mov_rcx_rax(c.code)                     // rcx = path
        if flags == 0 {
            c.code = emit_mov_reg_imm(c.code, 2, 0x80000000)  // rdx = GENERIC_READ
            c.code = emit_mov_r8_imm32(c.code, 1)             // r8 = FILE_SHARE_READ
            c.code = emit_mov_r9_imm32(c.code, 0)             // r9 = NULL
            c.code = emit_mov_qword_rsp_disp8_zero(c.code, 32)
            // Patch [rsp+32] = OPEN_EXISTING (3)
            c.code = emit_mov_rax_imm(c.code, 3)
            c.code = emit_store_rax_rbp_disp32(c.code, -64 + 32)
        } else {
            c.code = emit_mov_reg_imm(c.code, 2, 0x40000000)  // rdx = GENERIC_WRITE
            c.code = emit_mov_r8_imm32(c.code, 0)             // r8 = no sharing
            c.code = emit_mov_r9_imm32(c.code, 0)             // r9 = NULL
            c.code = emit_mov_qword_rsp_disp8_zero(c.code, 32)
            c.code = emit_mov_rax_imm(c.code, 2)
            c.code = emit_store_rax_rbp_disp32(c.code, -64 + 32)
        }
        c.code = emit_mov_qword_rsp_disp8_zero(c.code, 40)
        c.code = emit_mov_qword_rsp_disp8_zero(c.code, 48)
        c = emit_load_runtime_context_field_rax(c, runtime_context_field_win_create_file_fn_ptr())
        c.code = emit_call_rax(c.code)
        c.code = emit_add_rsp_imm32(c.code, 64)
        return c
    }
    c.code = emit_mov_reg_imm(c.code, 6, flags)
    c.code = emit_mov_reg_imm(c.code, 2, mode)
    c.code = emit_mov_rax_imm(c.code, 2)
    c.code = emit_syscall(c.code)
    c
}

// OS-conditional read: SysV(rdi=fd, rsi=buf, rdx=len) → bytes_read in rax
fn emit_read_syscall_for_target(nc: NativeCompiler, os_id: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    if os_id == 3 {
        // Win64: ReadFile(hFile=rcx, lpBuffer=rdx, nBytes=r8, lpBytesRead=r9, lpOverlapped=[+32])
        c.code = emit_push_rdi(c.code)
        c.code = emit_push_rsi(c.code)
        c.code = emit_push_rdx(c.code)
        c.code = emit_sub_rsp_imm32(c.code, 48)
        // rcx = handle (was rdi)
        c.code = emit_mov_rax_mem_rsp_disp8(c.code, 72)  // saved rdi
        c.code = emit_mov_rcx_rax(c.code)
        // rdx = buffer (was rsi)
        c.code = emit_mov_rax_mem_rsp_disp8(c.code, 64)  // saved rsi
        c.code = emit_mov_rdx_rax(c.code)
        // r8 = length (was rdx)
        c.code = emit_mov_rax_mem_rsp_disp8(c.code, 56)  // saved rdx
        c.code = emit_mov_r8_rax(c.code)
        // r9 = &bytesRead (stack)
        c.code = emit_lea_r9_rsp_disp8(c.code, 32)
        // [rsp+40] = lpOverlapped = NULL
        c.code = emit_mov_qword_rsp_disp8_zero(c.code, 40)
        c = emit_load_runtime_context_field_rax(c, runtime_context_field_win_read_fn_ptr())
        c.code = emit_call_rax(c.code)
        c.code = emit_mov_rax_mem_rsp_disp8(c.code, 32)  // rax = bytesRead
        c.code = emit_add_rsp_imm32(c.code, 48)
        c.code = emit_pop_rdx(c.code)
        c.code = emit_pop_rsi(c.code)
        c.code = emit_pop_rdi(c.code)
        return c
    }
    c.code = emit_mov_rax_imm(c.code, 0)
    c.code = emit_syscall(c.code)
    c
}

// OS-conditional close: SysV(rdi=fd)
fn emit_close_syscall_for_target(nc: NativeCompiler, os_id: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    if os_id == 3 {
        // Win64: CloseHandle(hObject=rcx)
        c.code = emit_sub_rsp_imm32(c.code, 32)
        c.code = emit_mov_rcx_rax(c.code)  // rcx = handle (rdi)
        c = emit_load_runtime_context_field_rax(c, runtime_context_field_win_close_handle_fn_ptr())
        c.code = emit_call_rax(c.code)
        c.code = emit_add_rsp_imm32(c.code, 32)
        return c
    }
    c.code = emit_mov_rax_imm(c.code, 3)
    c.code = emit_syscall(c.code)
    c
}

// OS-conditional stat: SysV(rdi=path, rsi=stat_buf) → 0 on success; size at stat_buf+48
fn emit_stat_syscall_for_target(nc: NativeCompiler, os_id: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    if os_id == 3 {
        // Win64: GetFileAttributesExA(lpFileName=rcx, fInfoLevelId=rdx, lpFileInformation=r8)
        c.code = emit_sub_rsp_imm32(c.code, 80)
        c.code = emit_mov_rcx_rax(c.code)          // rcx = path (rdi)
        c.code = emit_mov_reg_imm(c.code, 2, 0)    // rdx = GetFileExInfoStandard
        c.code = emit_lea_r8_rsp_disp8(c.code, 32) // r8 = &WIN32_FILE_ATTRIBUTE_DATA
        c = emit_load_runtime_context_field_rax(c, runtime_context_field_win_get_file_attrs_fn_ptr())
        c.code = emit_call_rax(c.code)
        // nFileSizeLow at offset 32 in struct, struct at rsp+32 → rsp+64
        c.code = emit_mov_rax_mem_rsp_disp8(c.code, 64)
        c.code = emit_add_rsp_imm32(c.code, 80)
        // rax = file size (low 32 bits, sufficient for files < 4GB)
        return c
    }
    c.code = emit_mov_rax_imm(c.code, 4)
    c.code = emit_syscall(c.code)
    c
}

fn emit_builtin_print_int(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_push_rbp(c.code)
    c.code = emit_mov_rbp_rsp(c.code)
    c.code = emit_sub_rsp_imm32(c.code, 32)

    // --- Negative number handling ---
    // test rdi, rdi; jns +27 (skip negative block to positive preamble)
    c.code = emit_test_rdi_rdi(c.code)                 // 3 bytes
    c.code = emit_jns_rel8(c.code, 27)                 // 2 bytes

    // Negative path: negate rdi, set up buffer with '-', then jump past positive preamble
    c.code = emit_neg_rdi(c.code)                      // 3 bytes
    c.code = emit_mov_reg_reg(c.code, 6, 5)           // mov rsi, rbp  (3)
    c.code = emit_sub_rsi_imm8(c.code, 1)             // sub rsi, 1    (4)
    c.code = emit_xor_rcx_rcx(c.code)                 // xor rcx, rcx  (3)
    c.code = emit_mov_byte_mem_rsi_imm8(c.code, 45)   // '-' at [rsi]  (3)
    c.code = emit_dec_rsi(c.code)                      //               (3)
    c.code = emit_inc_rcx(c.code)                      // count '-'     (3)
    c.code = emit_mov_reg_reg(c.code, 0, 7)           // mov rax, rdi  (3)
    c.code = emit_jmp_rel8(c.code, 13)                 // skip positive preamble (2)
    // negative block total = 3+3+4+3+3+3+3+3+2 = 27 bytes

    // Positive path: standard preamble (13 bytes)
    c.code = emit_mov_reg_reg(c.code, 0, 7)           // mov rax, rdi  (3)
    c.code = emit_mov_reg_reg(c.code, 6, 5)           // mov rsi, rbp  (3)
    c.code = emit_sub_rsi_imm8(c.code, 1)             // sub rsi, 1    (4)
    c.code = emit_xor_rcx_rcx(c.code)                 // xor rcx, rcx  (3)

    // digit loop: 28 bytes body + 2 bytes jnz = 30 bytes total
    c.code = emit_xor_rdx_rdx(c.code)                 // 3
    c.code = emit_mov_reg_imm(c.code, 3, 10)          // 7
    c.code = emit_div_rbx(c.code)                      // 3
    c.code = emit_add_rdx_imm8(c.code, 48)            // 4
    c.code = emit_mov_byte_mem_rsi_dl(c.code)          // 2
    c.code = emit_dec_rsi(c.code)                      // 3
    c.code = emit_inc_rcx(c.code)                      // 3
    c.code = emit_test_rax_rax(c.code)                 // 3
    c.code = emit_jnz_rel8(c.code, -30)               // 75 e2
    c.code = emit_inc_rsi(c.code)
    c.code = emit_mov_reg_reg(c.code, 2, 1)           // mov rdx, rcx
    c = emit_load_runtime_context_field_rdi(c, runtime_context_field_stdout_fd())
    c = emit_write_syscall_for_target(c, c.target_os_id)
    c.code = emit_mov_rsp_rbp(c.code)
    c.code = emit_pop_rbp(c.code)
    c.code = emit_ret(c.code)
    c
}

fn emit_builtin_print_char(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_push_rdi(c.code)
    c.code = emit_mov_rsi_rsp(c.code)
    c.code = emit_mov_reg_imm(c.code, 2, 1)           // mov rdx, 1
    c = emit_load_runtime_context_field_rdi(c, runtime_context_field_stdout_fd())
    c = emit_write_syscall_for_target(c, c.target_os_id)
    c.code = emit_add_rsp_8(c.code)
    c.code = emit_ret(c.code)
    c
}

fn emit_builtin_print_str(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_push_rbp(c.code)
    c.code = emit_mov_rbp_rsp(c.code)
    c.code = emit_mov_reg_reg(c.code, 6, 7)           // mov rsi, rdi
    c.code = emit_xor_rcx_rcx(c.code)
    // strlen loop: 16 bytes body
    c.code = emit_movzx_rax_byte_rdi(c.code)          // 4
    c.code = emit_test_al_al(c.code)                   // 2
    c.code = emit_jz_rel8(c.code, 8)                   // 2 (skip 3+3+2)
    c.code = emit_inc_rdi(c.code)                      // 3
    c.code = emit_inc_rcx(c.code)                      // 3
    c.code = emit_jmp_rel8(c.code, -16)                // 2
    // done_scan:
    c.code = emit_mov_reg_reg(c.code, 2, 1)           // mov rdx, rcx
    c = emit_load_runtime_context_field_rdi(c, runtime_context_field_stdout_fd())
    c = emit_write_syscall_for_target(c, c.target_os_id)
    c.code = emit_pop_rbp(c.code)
    c.code = emit_ret(c.code)
    c
}

fn emit_stdout_write_syscall_linux_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    emit_load_runtime_context_field_rax_into(nc, runtime_context_field_stdout_fd())
    nc_emit_mov_rdi_rax(nc)
    nc_emit_mov_rax_imm(nc, 1)
    nc_emit_syscall(nc)
}

fn emit_builtin_print_int_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_push_rbp(nc)
    nc_emit_mov_rbp_rsp(nc)
    nc_emit_sub_rsp_imm32(nc, 32)
    nc_emit_xor_r8_r8(nc)                   // r8 = 0 (neg flag)
    nc_emit_test_rdi_rdi(nc)
    nc_emit_jns_rel8(nc, 6)                  // if >= 0, skip neg path (6 bytes)
    nc_emit_neg_rdi(nc)                       // negate (3 bytes)
    nc_emit_inc_r8(nc)                        // r8 = 1 (3 bytes) → [positive_path]
    nc_emit_mov_reg_reg(nc, 0, 7)            // rax = rdi (abs value)
    nc_emit_mov_reg_reg(nc, 6, 5)            // rsi = rbp
    nc_emit_sub_rsi_imm8(nc, 1)              // rsi = rbp-1
    nc_emit_xor_rcx_rcx(nc)                  // rcx = 0
    // [digit_loop:]
    nc_emit_xor_rdx_rdx(nc)
    nc_emit_mov_reg_imm(nc, 3, 10)           // rbx = 10
    nc_emit_div_rbx(nc)
    nc_emit_add_rdx_imm8(nc, 48)
    nc_emit_mov_byte_mem_rsi_dl(nc)
    nc_emit_dec_rsi(nc)
    nc_emit_inc_rcx(nc)
    nc_emit_test_rax_rax(nc)
    nc_emit_jnz_rel8(nc, -30)               // loop (same digit loop size as before)
    // [after_loop:] store '-' after digits at current rsi (lowest address = leftmost)
    nc_emit_test_r8_r8(nc)                   // test neg flag
    nc_emit_jz_rel8(nc, 9)                   // if not neg, skip 9 bytes
    nc_emit_mov_byte_mem_rsi_imm8(nc, 45)   // [rsi] = '-' (3 bytes)
    nc_emit_dec_rsi(nc)                      // dec so inc rsi below lands on '-' (3 bytes)
    nc_emit_inc_rcx(nc)                      // rcx += 1 (3 bytes) → [no_sign]
    nc_emit_inc_rsi(nc)                      // rsi = start of buffer
    nc_emit_mov_reg_reg(nc, 2, 1)            // rdx = rcx (length)
    emit_stdout_write_syscall_linux_into(nc)
    nc_emit_mov_rsp_rbp(nc)
    nc_emit_pop_rbp(nc)
    nc_emit_ret(nc)
}

fn emit_builtin_print_char_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_push_rdi(nc)
    nc_emit_mov_rsi_rsp(nc)
    nc_emit_mov_reg_imm(nc, 2, 1)
    emit_stdout_write_syscall_linux_into(nc)
    nc_emit_add_rsp_8(nc)
    nc_emit_ret(nc)
}

fn emit_builtin_print_str_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_push_rbp(nc)
    nc_emit_mov_rbp_rsp(nc)
    nc_emit_mov_reg_reg(nc, 6, 7)
    nc_emit_xor_rcx_rcx(nc)
    nc_emit_movzx_rax_byte_rdi(nc)
    nc_emit_test_al_al(nc)
    nc_emit_jz_rel8(nc, 8)
    nc_emit_inc_rdi(nc)
    nc_emit_inc_rcx(nc)
    nc_emit_jmp_rel8(nc, -16)
    nc_emit_mov_reg_reg(nc, 2, 1)
    emit_stdout_write_syscall_linux_into(nc)
    nc_emit_pop_rbp(nc)
    nc_emit_ret(nc)
}

fn emit_builtin_assert(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_test_rdi_rdi(c.code)
    c.code = emit_jnz_rel8(c.code, 16)
    c.code = emit_exit(c.code, 1)
    c.code = emit_mov_rax_imm(c.code, 0)
    c.code = emit_ret(c.code)
    c
}

fn emit_builtin_assert_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_test_rdi_rdi(nc)
    nc_emit_jnz_rel8(nc, 16)
    nc_emit_exit_code(nc, 1)
    nc_emit_mov_rax_imm(nc, 0)
    nc_emit_ret(nc)
}

// heap_alloc(n) -> zeroed payload. The historical heap ABI stores the
// page-rounded mapping length at ptr-8 so heap_free/heap_realloc can recover it.
fn emit_builtin_heap_alloc_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    // Reject n <= 0.
    nc_emit_test_rdi_rdi(nc)
    let nonpositive_patch = (*nc).code.len + 2
    nc_emit_byte(nc, 0x0f)
    nc_emit_byte(nc, 0x8e)
    nc_emit_u32_le(nc, 0) // jle fail

    // rsi = page_round_up(n + 8). Adding 8 + 4095 in one step lets the
    // signed test reject every overflow from a positive source value.
    nc_emit_mov_reg_reg(nc, 6, 7)
    nc_emit_byte(nc, 0x48)
    nc_emit_byte(nc, 0x81)
    nc_emit_byte(nc, 0xc6)
    nc_emit_u32_le(nc, 4103)
    nc_emit_byte(nc, 0x48)
    nc_emit_byte(nc, 0x85)
    nc_emit_byte(nc, 0xf6) // test rsi,rsi
    let overflow_patch = (*nc).code.len + 2
    nc_emit_byte(nc, 0x0f)
    nc_emit_byte(nc, 0x8e)
    nc_emit_u32_le(nc, 0) // jle fail
    nc_emit_byte(nc, 0x48)
    nc_emit_byte(nc, 0x81)
    nc_emit_byte(nc, 0xe6)
    nc_emit_u32_le(nc, -4096)

    // mmap(NULL, rsi, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0)
    nc_emit_byte(nc, 0x48)
    nc_emit_byte(nc, 0x31)
    nc_emit_byte(nc, 0xff) // xor rdi,rdi
    nc_emit_mov_reg_imm(nc, 2, 3)
    nc_emit_mov_r10_imm32(nc, 34)
    nc_emit_mov_reg_imm(nc, 8, -1)
    nc_emit_byte(nc, 0x4d)
    nc_emit_byte(nc, 0x31)
    nc_emit_byte(nc, 0xc9) // xor r9,r9
    nc_emit_mov_rax_imm(nc, 9)
    nc_emit_syscall(nc)

    // Linux syscall errors are negative. User mappings never occupy the
    // negative canonical half, so a sign test is sufficient here.
    nc_emit_test_rax_rax(nc)
    let mmap_error_patch = (*nc).code.len + 2
    nc_emit_byte(nc, 0x0f)
    nc_emit_byte(nc, 0x88)
    nc_emit_u32_le(nc, 0) // js fail

    nc_emit_byte(nc, 0x48)
    nc_emit_byte(nc, 0x89)
    nc_emit_byte(nc, 0x30) // mov [rax],rsi
    nc_emit_byte(nc, 0x48)
    nc_emit_byte(nc, 0x83)
    nc_emit_byte(nc, 0xc0)
    nc_emit_byte(nc, 8)
    nc_emit_ret(nc)

    let fail_offset = (*nc).code.len
    nc_emit_xor_rax_rax(nc)
    nc_emit_ret(nc)
    nc_patch_u32_le(nc, nonpositive_patch, fail_offset - (nonpositive_patch + 4))
    nc_patch_u32_le(nc, overflow_patch, fail_offset - (overflow_patch + 4))
    nc_patch_u32_le(nc, mmap_error_patch, fail_offset - (mmap_error_patch + 4))
}

// heap_free(NULL) is a no-op. Non-null pointers must come from heap_alloc.
fn emit_builtin_heap_free_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_test_rdi_rdi(nc)
    let null_patch = (*nc).code.len + 2
    nc_emit_byte(nc, 0x0f)
    nc_emit_byte(nc, 0x84)
    nc_emit_u32_le(nc, 0) // jz done
    nc_emit_byte(nc, 0x48)
    nc_emit_byte(nc, 0x83)
    nc_emit_byte(nc, 0xef)
    nc_emit_byte(nc, 8)
    nc_emit_byte(nc, 0x48)
    nc_emit_byte(nc, 0x8b)
    nc_emit_byte(nc, 0x37) // mov rsi,[rdi]
    nc_emit_mov_rax_imm(nc, 11)
    nc_emit_syscall(nc)
    let done_offset = (*nc).code.len
    nc_emit_xor_rax_rax(nc)
    nc_emit_ret(nc)
    nc_patch_u32_le(nc, null_patch, done_offset - (null_patch + 4))
}

// syscall6(nr, a1, a2, a3, a4, a5, a6) -> i64 — raw Linux syscall escape
// hatch (builtin id 27), the Madaros twin of lean_single's emit_syscall6_x86
// (self-hosted/compiler/lean_single.sio:9709). Args arrive per the IrCall
// SysV marshalling: rdi=nr, rsi=a1, rdx=a2, rcx=a3, r8=a4, r9=a5, a6 on the
// stack at [rsp+8] (return address at [rsp]; nc_core_push_call_stack_args
// pads to 16B BEFORE pushing stack args, so a6 is always the first slot).
// The kernel ABI wants rax=nr, rdi=a1, rsi=a2, rdx=a3, r10=a4 (NOT rcx),
// r8=a5, r9=a6, so the body shuffles registers in destructive-safe order
// (each move frees its own source before the next read) and loads a6 last,
// before any push would shift the stack slots. Return value stays in rax.
fn emit_builtin_syscall6_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_mov_reg_reg(nc, 0, 7)   // mov rax, rdi  (nr)
    nc_emit_mov_reg_reg(nc, 7, 6)   // mov rdi, rsi  (a1)
    nc_emit_mov_reg_reg(nc, 6, 2)   // mov rsi, rdx  (a2)
    nc_emit_mov_reg_reg(nc, 2, 1)   // mov rdx, rcx  (a3)
    nc_emit_byte(nc, 0x4d)          // mov r10, r8   (a4; kernel arg4 reg)
    nc_emit_byte(nc, 0x89)
    nc_emit_byte(nc, 0xc2)
    nc_emit_byte(nc, 0x4d)          // mov r8, r9    (a5)
    nc_emit_byte(nc, 0x89)
    nc_emit_byte(nc, 0xc8)
    nc_emit_byte(nc, 0x4c)          // mov r9, [rsp+8]  (a6)
    nc_emit_byte(nc, 0x8b)
    nc_emit_byte(nc, 0x4c)
    nc_emit_byte(nc, 0x24)
    nc_emit_byte(nc, 0x08)
    nc_emit_syscall(nc)
    nc_emit_ret(nc)
}

// ============================================================================
// P0-F: allowlisted extern "C" POSIX builtins (getpid/getppid/exit/abort/
// malloc/free/system). Each name added to name_is_native_backend_builtin
// (check.sio) turns OFF the E219 fail-closed guard for that name, so each MUST
// have a working emitter here or it silently returns a fabricated 0. Per-name
// EXECUTION witnesses (not just "no longer E219") gate this in CI.
// ============================================================================

fn name_is_getpid(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 6 { return false }
    if n.buf[0] != 103 as i8 { return false }  // 'g'
    if n.buf[1] != 101 as i8 { return false }  // 'e'
    if n.buf[2] != 116 as i8 { return false }  // 't'
    if n.buf[3] != 112 as i8 { return false }  // 'p'
    if n.buf[4] != 105 as i8 { return false }  // 'i'
    if n.buf[5] != 100 as i8 { return false }  // 'd'
    true
}

fn name_is_getppid(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 7 { return false }
    if n.buf[0] != 103 as i8 { return false }  // 'g'
    if n.buf[1] != 101 as i8 { return false }  // 'e'
    if n.buf[2] != 116 as i8 { return false }  // 't'
    if n.buf[3] != 112 as i8 { return false }  // 'p'
    if n.buf[4] != 112 as i8 { return false }  // 'p'
    if n.buf[5] != 105 as i8 { return false }  // 'i'
    if n.buf[6] != 100 as i8 { return false }  // 'd'
    true
}

fn name_is_exit(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 4 { return false }
    if n.buf[0] != 101 as i8 { return false }  // 'e'
    if n.buf[1] != 120 as i8 { return false }  // 'x'
    if n.buf[2] != 105 as i8 { return false }  // 'i'
    if n.buf[3] != 116 as i8 { return false }  // 't'
    true
}

fn name_is_abort(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 5 { return false }
    if n.buf[0] != 97 as i8 { return false }   // 'a'
    if n.buf[1] != 98 as i8 { return false }   // 'b'
    if n.buf[2] != 111 as i8 { return false }  // 'o'
    if n.buf[3] != 114 as i8 { return false }  // 'r'
    if n.buf[4] != 116 as i8 { return false }  // 't'
    true
}

fn name_is_malloc(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 6 { return false }
    if n.buf[0] != 109 as i8 { return false }  // 'm'
    if n.buf[1] != 97 as i8 { return false }   // 'a'
    if n.buf[2] != 108 as i8 { return false }  // 'l'
    if n.buf[3] != 108 as i8 { return false }  // 'l'
    if n.buf[4] != 111 as i8 { return false }  // 'o'
    if n.buf[5] != 99 as i8 { return false }   // 'c'
    true
}

fn name_is_free(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 4 { return false }
    if n.buf[0] != 102 as i8 { return false }  // 'f'
    if n.buf[1] != 114 as i8 { return false }  // 'r'
    if n.buf[2] != 101 as i8 { return false }  // 'e'
    if n.buf[3] != 101 as i8 { return false }  // 'e'
    true
}

fn name_is_system(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 6 { return false }
    if n.buf[0] != 115 as i8 { return false }  // 's'
    if n.buf[1] != 121 as i8 { return false }  // 'y'
    if n.buf[2] != 115 as i8 { return false }  // 's'
    if n.buf[3] != 116 as i8 { return false }  // 't'
    if n.buf[4] != 101 as i8 { return false }  // 'e'
    if n.buf[5] != 109 as i8 { return false }  // 'm'
    true
}

// Defect A (docs/audit/MADAROS_PBPK28_NN_TENSOR_COMPILE_RUNTIME_DIVERGENCE_2026-08-17.md):
// read_i64/write_i64/read_f64/write_f64 are the lean_single-only raw
// pointer-indexed accessor family (self-hosted/compiler/lean_single.sio
// emit_read_f64/emit_write_f64 etc.), used throughout stdlib/data/bigframe*,
// stdlib/collections/heap_vec.sio, stdlib/nn/optimizer.sio, stdlib/tensor/tape.sio
// on `*mut f64`/`*mut i64` pointers obtained from heap_alloc (a real mmap'd
// address, never a handle-table index — see heap_alloc's own emitter). Callers
// use `buf[idx]`-style element indexing (8-byte stride), matching lean_single's
// `[reg + idx*8]` addressing exactly.
fn name_is_read_i64(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 8 { return false }
    if n.buf[0] != 114 as i8 { return false }  // 'r'
    if n.buf[1] != 101 as i8 { return false }  // 'e'
    if n.buf[2] != 97 as i8 { return false }   // 'a'
    if n.buf[3] != 100 as i8 { return false }  // 'd'
    if n.buf[4] != 95 as i8 { return false }   // '_'
    if n.buf[5] != 105 as i8 { return false }  // 'i'
    if n.buf[6] != 54 as i8 { return false }   // '6'
    if n.buf[7] != 52 as i8 { return false }   // '4'
    true
}

fn name_is_write_i64(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 9 { return false }
    if n.buf[0] != 119 as i8 { return false }  // 'w'
    if n.buf[1] != 114 as i8 { return false }  // 'r'
    if n.buf[2] != 105 as i8 { return false }  // 'i'
    if n.buf[3] != 116 as i8 { return false }  // 't'
    if n.buf[4] != 101 as i8 { return false }  // 'e'
    if n.buf[5] != 95 as i8 { return false }   // '_'
    if n.buf[6] != 105 as i8 { return false }  // 'i'
    if n.buf[7] != 54 as i8 { return false }   // '6'
    if n.buf[8] != 52 as i8 { return false }   // '4'
    true
}

fn name_is_read_f64(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 8 { return false }
    if n.buf[0] != 114 as i8 { return false }  // 'r'
    if n.buf[1] != 101 as i8 { return false }  // 'e'
    if n.buf[2] != 97 as i8 { return false }   // 'a'
    if n.buf[3] != 100 as i8 { return false }  // 'd'
    if n.buf[4] != 95 as i8 { return false }   // '_'
    if n.buf[5] != 102 as i8 { return false }  // 'f'
    if n.buf[6] != 54 as i8 { return false }   // '6'
    if n.buf[7] != 52 as i8 { return false }   // '4'
    true
}

fn name_is_write_f64(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 9 { return false }
    if n.buf[0] != 119 as i8 { return false }  // 'w'
    if n.buf[1] != 114 as i8 { return false }  // 'r'
    if n.buf[2] != 105 as i8 { return false }  // 'i'
    if n.buf[3] != 116 as i8 { return false }  // 't'
    if n.buf[4] != 101 as i8 { return false }  // 'e'
    if n.buf[5] != 95 as i8 { return false }   // '_'
    if n.buf[6] != 102 as i8 { return false }  // 'f'
    if n.buf[7] != 54 as i8 { return false }   // '6'
    if n.buf[8] != 52 as i8 { return false }   // '4'
    true
}

fn name_is_acknowledge(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 11 { return false }
    if n.buf[0] != 97 as i8 { return false }
    if n.buf[1] != 99 as i8 { return false }
    if n.buf[2] != 107 as i8 { return false }
    if n.buf[3] != 110 as i8 { return false }
    if n.buf[4] != 111 as i8 { return false }
    if n.buf[5] != 119 as i8 { return false }
    if n.buf[6] != 108 as i8 { return false }
    if n.buf[7] != 101 as i8 { return false }
    if n.buf[8] != 100 as i8 { return false }
    if n.buf[9] != 103 as i8 { return false }
    if n.buf[10] != 101 as i8 { return false }
    true
}

fn name_is_require_confidence(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 18 { return false }
    let expected: [i64; 18] = [114, 101, 113, 117, 105, 114, 101, 95, 99, 111, 110, 102, 105, 100, 101, 110, 99, 101]
    var i: i64 = 0
    while i < 18 {
        if n.buf[i as usize] != expected[i as usize] as i8 { return false }
        i = i + 1
    }
    true
}

// read_i64(buf: *mut i64, idx: i64) -> i64 / read_f64(buf: *mut f64, idx: i64) -> f64.
// Sounio's internal call ABI passes ALL argument and return values as raw
// 64-bit values through the general-purpose registers (confirmed against
// emit_builtin_sqrt: its f64 arg arrives in rdi as bits and its f64 result
// leaves in rax as bits, never touching xmm0 at the call boundary) -- so the
// i64 and f64 forms are byte-identical: this one body serves both ids.
// args: rdi=buf, rsi=idx (element index, 8-byte stride). result: rax.
fn emit_builtin_read_offset64_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_byte(nc, 0x48)  // REX.W
    nc_emit_byte(nc, 0x8b)  // MOV r64, r/m64
    nc_emit_byte(nc, 0x04)  // ModRM: mod=00 reg=rax(000) rm=100(SIB follows)
    nc_emit_byte(nc, 0xf7)  // SIB: scale=8(11) index=rsi(110) base=rdi(111)
    nc_emit_ret(nc)
}

// write_i64(buf: *mut i64, idx: i64, val: i64) / write_f64(buf: *mut f64, idx: i64, val: f64) -> void.
// Same ABI note as read_offset64: val arrives in rdx (third GP arg slot) as
// raw bits regardless of i64/f64, so one body serves both ids.
// args: rdi=buf, rsi=idx, rdx=val. no return value.
fn emit_builtin_write_offset64_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_byte(nc, 0x48)  // REX.W
    nc_emit_byte(nc, 0x89)  // MOV r/m64, r64
    nc_emit_byte(nc, 0x14)  // ModRM: mod=00 reg=rdx(010) rm=100(SIB follows)
    nc_emit_byte(nc, 0xf7)  // SIB: scale=8(11) index=rsi(110) base=rdi(111)
    nc_emit_ret(nc)
}

// getpid()/getppid(): raw syscalls 39/110; result in rax per the Sounio
// integer-return convention.
fn emit_builtin_getpid_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_mov_rax_imm(nc, 39)
    nc_emit_syscall(nc)
    nc_emit_ret(nc)
}

fn emit_builtin_getppid_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_mov_rax_imm(nc, 110)
    nc_emit_syscall(nc)
    nc_emit_ret(nc)
}

// exit(code): exit_group(231) so every thread dies; rdi already carries code.
fn emit_builtin_exit_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_mov_rax_imm(nc, 231)
    nc_emit_syscall(nc)
    nc_emit_ret(nc)
}

// abort(): exit_group(134) — 128+SIGABRT, the status a shell reports for an
// aborted process (no signal machinery exists in this runtime to raise it).
fn emit_builtin_abort_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_mov_reg_imm(nc, 7, 134)
    nc_emit_mov_rax_imm(nc, 231)
    nc_emit_syscall(nc)
    nc_emit_ret(nc)
}

// system(cmd): fork/execve("/bin/sh","-c",cmd)/wait4, returning the raw wait
// status in rax. cmd arrives in rdi already NUL-terminated (Sounio strings are
// C strings), so no data reloc is needed; "/bin/sh\0" and "-c\0" fit single
// 64-bit immediates pushed to the stack. Only the parent branch returns to
// Sounio and it touches only caller-saved regs; cmd is held in rdx (a low
// register) through the child; the status slot is reserved with a push rather
// than `sub rsp,imm` to avoid the stack-clash probe that reads an unset rbp.
fn emit_builtin_system_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_mov_rax_imm(nc, 57)            // fork
    nc_emit_syscall(nc)
    nc_emit_test_rax_rax(nc)
    let child_patch = (*nc).code.len + 2
    nc_emit_jz_rel32(nc)
    // --- parent: rax = child pid; wait4(pid, &status, 0, 0) ---
    nc_emit_mov_reg_reg(nc, 7, 0)          // mov rdi, rax  (pid)
    nc_emit_xor_rax_rax(nc)
    nc_emit_push_rax(nc)                   // status slot (zeroed)
    nc_emit_mov_reg_reg(nc, 6, 4)          // mov rsi, rsp
    nc_emit_xor_rdx_rdx(nc)                // options = 0
    nc_emit_byte(nc, 0x4d)                 // xor r10, r10  (rusage = NULL)
    nc_emit_byte(nc, 0x31)
    nc_emit_byte(nc, 0xd2)
    nc_emit_mov_rax_imm(nc, 61)            // wait4
    nc_emit_syscall(nc)
    nc_emit_byte(nc, 0x48)                 // mov rax, [rsp]  (status)
    nc_emit_byte(nc, 0x8b)
    nc_emit_byte(nc, 0x04)
    nc_emit_byte(nc, 0x24)
    nc_emit_add_rsp_8(nc)
    nc_emit_ret(nc)
    // --- child ---
    let child_offset = (*nc).code.len
    nc_patch_u32_le(nc, child_patch, child_offset - (child_patch + 4))
    nc_emit_mov_reg_reg(nc, 2, 7)          // mov rdx, rdi  (cmd held to argv)
    nc_emit_mov_reg_imm64(nc, 0, 29400045130965551)  // "/bin/sh\0"
    nc_emit_push_rax(nc)
    nc_emit_mov_reg_reg(nc, 3, 4)          // mov rbx, rsp  (path)
    nc_emit_mov_reg_imm64(nc, 0, 25389)    // "-c\0"
    nc_emit_push_rax(nc)
    nc_emit_mov_reg_reg(nc, 1, 4)          // mov rcx, rsp  ("-c")
    nc_emit_xor_rax_rax(nc)
    nc_emit_push_rax(nc)                   // NULL
    nc_emit_byte(nc, 0x52)                 // push rdx  (cmd)
    nc_emit_byte(nc, 0x51)                 // push rcx  ("-c")
    nc_emit_byte(nc, 0x53)                 // push rbx  (path)
    nc_emit_mov_reg_reg(nc, 6, 4)          // mov rsi, rsp  (argv)
    nc_emit_mov_reg_reg(nc, 7, 3)          // mov rdi, rbx  (path)
    nc_emit_xor_rdx_rdx(nc)                // envp = NULL
    nc_emit_mov_rax_imm(nc, 59)            // execve
    nc_emit_syscall(nc)
    nc_emit_mov_reg_imm(nc, 7, 127)        // execve failed -> exit(127)
    nc_emit_mov_rax_imm(nc, 60)
    nc_emit_syscall(nc)
    nc_emit_ret(nc)
}

// ============================================================================
// M4: argv access builtins
// ============================================================================

// get_arg_count() -> i64
// Returns argc stored in RuntimeContext memory.
fn emit_builtin_get_arg_count(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c = emit_load_runtime_context_field_rax(c, runtime_context_field_argc())
    c.code = emit_ret(c.code)
    c
}

// get_arg(n: i64) -> *u8
// Returns argv[n], where argv base pointer is stored in RuntimeContext.
fn emit_builtin_get_arg(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // rdi = n (index into argv)
    c = emit_load_runtime_context_field_rax(c, runtime_context_field_argv_ptr())
    // Now rax = argv pointer, rdi = n
    // We need rax = [rax + rdi*8]
    c.code = emit_mov_reg_reg(c.code, 3, 7)       // mov rbx, rdi (index n)
    c.code = emit_mov_rax_mem_rax_rbx8(c.code)    // mov rax, [rax + rbx*8]
    c.code = emit_ret(c.code)
    c
}

fn emit_builtin_get_arg_count_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    emit_load_runtime_context_field_rax_into(nc, runtime_context_field_argc())
    nc_emit_ret(nc)
}

fn emit_builtin_get_arg_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    emit_load_runtime_context_field_rax_into(nc, runtime_context_field_argv_ptr())
    nc_emit_mov_reg_reg(nc, 3, 7)
    nc_emit_mov_rax_mem_rax_rbx8(nc)
    nc_emit_ret(nc)
}

pub fn native_v2_emit_get_arg_count_function_into(nc: &! NativeCompiler, fn_index: i64) with Mut, Panic, Div {
    reset_function_state_mut(nc)
    native_compiler_set_fn_offset(nc, fn_index, (*nc).code.len)
    emit_builtin_get_arg_count_into(nc)
}

pub fn native_v2_emit_get_arg_function_into(nc: &! NativeCompiler, fn_index: i64) with Mut, Panic, Div {
    reset_function_state_mut(nc)
    native_compiler_set_fn_offset(nc, fn_index, (*nc).code.len)
    emit_builtin_get_arg_into(nc)
}

pub fn native_v2_emit_print_function_into(nc: &! NativeCompiler, fn_index: i64) with Mut, Panic, Div {
    reset_function_state_mut(nc)
    native_compiler_set_fn_offset(nc, fn_index, (*nc).code.len)
    emit_builtin_print_str_into(nc)
}

pub fn native_v2_emit_print_int_function_into(nc: &! NativeCompiler, fn_index: i64) with Mut, Panic, Div {
    reset_function_state_mut(nc)
    native_compiler_set_fn_offset(nc, fn_index, (*nc).code.len)
    emit_builtin_print_int_into(nc)
}

pub fn native_v2_emit_print_char_function_into(nc: &! NativeCompiler, fn_index: i64) with Mut, Panic, Div {
    reset_function_state_mut(nc)
    native_compiler_set_fn_offset(nc, fn_index, (*nc).code.len)
    emit_builtin_print_char_into(nc)
}

pub fn native_v2_core_emit_arg_count_into(nc: &! NativeCompiler, dst: i64) with Mut, Panic, Div {
    emit_load_runtime_context_field_rax_into(nc, runtime_context_field_argc())
    nc_core_store_rax_to_temp(nc, dst)
}

pub fn native_v2_core_emit_get_arg_into(nc: &! NativeCompiler, dst: i64, arg_reg: i64) with Mut, Panic, Div {
    nc_core_load_temp_to_rax(nc, arg_reg)
    nc_emit_mov_rdi_rax(nc)
    emit_load_runtime_context_field_rax_into(nc, runtime_context_field_argv_ptr())
    nc_emit_mov_reg_reg(nc, 3, 7)
    nc_emit_mov_rax_mem_rax_rbx8(nc)
    nc_core_store_rax_to_temp(nc, dst)
}

pub fn native_v2_core_emit_str_len_into(nc: &! NativeCompiler, dst: i64, arg_reg: i64) with Mut, Panic, Div {
    nc_core_load_temp_to_rax(nc, arg_reg)
    nc_emit_mov_rdi_rax(nc)
    nc_emit_xor_rcx_rcx(nc)
    nc_emit_movzx_rax_byte_rdi(nc)
    nc_emit_test_al_al(nc)
    nc_emit_jz_rel8(nc, 8)
    nc_emit_inc_rdi(nc)
    nc_emit_inc_rcx(nc)
    nc_emit_jmp_rel8(nc, -16)
    nc_emit_mov_reg_reg(nc, 0, 1)
    nc_core_store_rax_to_temp(nc, dst)
}

pub fn native_v2_core_emit_str_char_at_into(nc: &! NativeCompiler, dst: i64, arg0_reg: i64) with Mut, Panic, Div {
    nc_core_load_temp_to_rax(nc, arg0_reg)
    nc_emit_mov_rdi_rax(nc)
    nc_core_load_temp_to_rax(nc, arg0_reg + 1)
    nc_emit_mov_reg_reg(nc, 3, 0)
    nc_emit_movzx_rax_byte_rdi_rbx(nc)
    nc_core_store_rax_to_temp(nc, dst)
}

pub fn native_v2_core_emit_str_eq_into(nc: &! NativeCompiler, dst: i64, arg0_reg: i64) with Mut, Panic, Div {
    nc_core_load_temp_to_rax(nc, arg0_reg)
    nc_emit_mov_rdi_rax(nc)
    nc_core_load_temp_to_rax(nc, arg0_reg + 1)
    nc_emit_mov_reg_reg(nc, 6, 0)
    nc_emit_movzx_rax_byte_rdi(nc)
    nc_emit_cmp_al_mem_rsi(nc)
    nc_emit_jnz_rel8(nc, 12)
    nc_emit_test_al_al(nc)
    nc_emit_jz_rel8(nc, 13)
    nc_emit_inc_rdi(nc)
    nc_emit_inc_rsi(nc)
    nc_emit_jmp_rel8(nc, -20)
    nc_emit_xor_rax_rax(nc)
    nc_emit_jmp_rel8(nc, 7)
    nc_emit_mov_rax_imm(nc, 1)
    nc_core_store_rax_to_temp(nc, dst)
}

pub fn native_v2_core_emit_driver_read_file_to_globals_into(nc: &! NativeCompiler, dst: i64, path_reg: i64, source_global_id: i64, len_global_id: i64, max_len: i64) with Mut, Panic, Div {
    // push r12 (41 54)
    nc_emit_byte(nc, 0x41)
    nc_emit_byte(nc, 0x54)
    nc_core_load_temp_to_rax(nc, path_reg)
    nc_emit_mov_rdi_rax(nc)
    nc_emit_mov_rax_imm(nc, 2)
    nc_emit_mov_reg_imm(nc, 6, 0)
    nc_emit_mov_reg_imm(nc, 2, 0)
    nc_emit_syscall(nc)
    // mov r12, rax (49 89 c4)
    nc_emit_byte(nc, 0x49)
    nc_emit_byte(nc, 0x89)
    nc_emit_byte(nc, 0xc4)

    // mov rdi, r12 (4c 89 e7)
    nc_emit_byte(nc, 0x4c)
    nc_emit_byte(nc, 0xe9)
    nc_emit_byte(nc, 0xe7)
    let source_pos = (*nc).code.len + 3
    nc_emit_lea_rax_rip_disp32(nc, 0)
    nc_add_data_section_reloc(nc, source_pos, native_v2_driver_state_base_offset() + (source_global_id * 4096))
    nc_emit_mov_reg_reg(nc, 6, 0)
    nc_emit_mov_reg_imm(nc, 2, max_len)
    nc_emit_mov_rax_imm(nc, 0)
    nc_emit_syscall(nc)
    nc_core_store_rax_to_temp(nc, dst)

    nc_emit_push_rax(nc)
    let len_pos = (*nc).code.len + 3
    nc_emit_lea_rax_rip_disp32(nc, 0)
    nc_add_data_section_reloc(nc, len_pos, native_v2_driver_state_base_offset() + (len_global_id * 4096))
    nc_emit_mov_reg_reg(nc, 2, 0)
    nc_emit_mov_reg_imm(nc, 3, 0)
    nc_emit_pop_rax(nc)
    nc_emit_store_rax_mem_rdx_rbx8(nc)

    // mov rdi, r12 (4c 89 e7)
    nc_emit_byte(nc, 0x4c)
    nc_emit_byte(nc, 0xe9)
    nc_emit_byte(nc, 0xe7)
    nc_emit_mov_rax_imm(nc, 3)
    nc_emit_syscall(nc)
    // pop r12 (41 5c)
    nc_emit_byte(nc, 0x41)
    nc_emit_byte(nc, 0x5c)
}

// str_len(s: *u8) -> i64
// Counts bytes until null terminator
fn emit_builtin_str_len(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // rdi = string pointer
    c.code = emit_xor_rcx_rcx(c.code)             // rcx = 0 (counter)
    // loop body: cmp byte [rdi], 0 (3) + jz +8 (2) + inc rdi (3) + inc rcx (3) + jmp -13 (2) = 13 bytes
    c.code = emit_cmp_byte_rdi_zero(c.code)        // 3 bytes
    c.code = emit_jz_rel8(c.code, 8)               // 2 bytes, skip 3+3+2
    c.code = emit_inc_rdi(c.code)                  // 3 bytes
    c.code = emit_inc_rcx(c.code)                  // 3 bytes
    c.code = emit_jmp_rel8(c.code, -13)            // 2 bytes, jump back to cmp
    // done:
    c.code = emit_mov_reg_reg(c.code, 0, 1)       // mov rax, rcx
    c.code = emit_ret(c.code)
    c
}

// str_char_at(s: *u8, idx: i64) -> i64
// Returns the byte at s[idx] zero-extended to i64.
fn emit_builtin_str_char_at(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // rdi = string pointer, rsi = byte index
    c.code = emit_mov_reg_reg(c.code, 3, 6)        // mov rbx, rsi
    c.code = emit_movzx_rax_byte_rdi_rbx(c.code)   // movzx rax, byte [rdi + rbx]
    c.code = emit_ret(c.code)
    c
}

// str_eq(a: *u8, b: *u8) -> i64 (1 if equal, 0 if not)
// Byte-by-byte comparison until mismatch or both reach null
fn emit_builtin_str_eq(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // rdi = a, rsi = b
    // loop: load byte from [rdi], compare with byte from [rsi]
    // if mismatch -> return 0
    // if both null -> return 1
    // loop body:
    //   movzx rax, byte [rdi]    — 4 bytes
    //   cmp al, [rsi]            — 2 bytes (3a 06, but we use rsi not rdi)
    //   jne not_equal             — 2 bytes (jnz +offset)
    //   test al, al              — 2 bytes
    //   jz equal                  — 2 bytes (both null -> equal)
    //   inc rdi                  — 3 bytes
    //   inc rsi                  — 3 bytes
    //   jmp loop                 — 2 bytes
    // not_equal:
    //   xor rax, rax; ret
    // equal:
    //   mov rax, 1; ret

    // Layout (byte offsets from loop start):
    //   0:  movzx rax, byte [rdi]  — 4 bytes
    //   4:  cmp al, [rsi]          — 2 bytes
    //   6:  jnz not_equal           — 2 bytes (rel8 = 12, target = 8+12 = 20)
    //   8:  test al, al             — 2 bytes
    //   10: jz equal                — 2 bytes (rel8 = 12, target = 12+12 = 24)
    //   12: inc rdi                 — 3 bytes
    //   15: inc rsi                 — 3 bytes
    //   18: jmp loop                — 2 bytes (rel8 = -20, target = 20-20 = 0)
    //   20: xor rax, rax            — 3 bytes  [not_equal]
    //   23: ret                     — 1 byte
    //   24: mov rax, 1              — 7 bytes  [equal]
    //   31: ret                     — 1 byte

    // loop start:
    c.code = emit_movzx_rax_byte_rdi(c.code)      // 4: movzx rax, byte [rdi]
    // cmp al, [rsi] — 3a 06
    var cb = c.code
    cb = emit_byte(cb, 0x3a)
    cb = emit_byte(cb, 0x06)                       // 2: cmp al, [rsi]
    c.code = cb
    c.code = emit_jnz_rel8(c.code, 12)            // 2: jne not_equal
    c.code = emit_test_al_al(c.code)              // 2: test al, al
    c.code = emit_jz_rel8(c.code, 12)             // 2: jz equal
    c.code = emit_inc_rdi(c.code)                  // 3: inc rdi
    c.code = emit_inc_rsi(c.code)                  // 3: inc rsi
    c.code = emit_jmp_rel8(c.code, -20)            // 2: jmp loop
    // not_equal: xor rax, rax; ret
    c.code = emit_xor_rax_rax(c.code)             // 3
    c.code = emit_ret(c.code)                      // 1
    // equal: mov rax, 1; ret
    c.code = emit_mov_rax_imm(c.code, 1)          // 7
    c.code = emit_ret(c.code)                      // 1
    c
}

// str_slice(s: *u8, start: i64) -> *u8
// Returns s + start (pointer arithmetic — string is null-terminated)
fn emit_builtin_str_slice(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // rdi = string pointer, rsi = start offset
    // result = rdi + rsi
    c.code = emit_add_reg_reg(c.code, 7, 6)  // add rdi, rsi
    c.code = emit_mov_reg_reg(c.code, 0, 7)  // mov rax, rdi
    c.code = emit_ret(c.code)
    c
}

// str_from_bytes(buf, len) -> string. Matches lean_single semantics
// (lean_single.sio: "Returns the address of the byte buffer as a string pointer").
//
// rdi = buf: a native-v2 local/param [i8;N] array, passed as a HANDLE (slot index
// into the handle table, stride native_v2_handle_entry_size()), not a raw pointer —
// same representation ordinary arr[i] reads resolve via
// native_v2_resolve_handle_to_object_base_rax. The object's data is a
// native_v2_object_header_size()-byte header followed by one 8-byte-boxed slot per
// element (uniform representation, even for i8) — same layout
// native_v2_core_emit_local_array_load_into reads with resolve + mov rax,[rdx+rbx*8].
// rsi = len (element count).
//
// This allocates len+1 bytes from the heap (mirroring emit_builtin_str_concat),
// unpacks the low byte of each boxed element into the packed buffer, and
// null-terminates it — producing a real *u8 the caller can dereference directly.
fn emit_builtin_str_from_bytes(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc

    // Prologue
    c.code = emit_push_rbp(c.code)
    c.code = emit_mov_rbp_rsp(c.code)
    c.code = emit_sub_rsp_imm32(c.code, 32)

    // Save len at [rbp-8]
    c.code = emit_mov_reg_reg(c.code, 0, 6)             // rax = rsi (len)
    c.code = emit_store_rax_rbp_disp32(c.code, -8)

    // Resolve buf handle (rdi) -> object base pointer, save at [rbp-16]
    c.code = emit_mov_reg_reg(c.code, 0, 7)             // rax = rdi (handle)
    c = native_v2_resolve_handle_to_object_base_rax(c)   // rax = object base
    c.code = emit_store_rax_rbp_disp32(c.code, -16)

    // Allocate len+1 bytes from RuntimeContext.heap_cursor; result = old cursor
    c = emit_load_runtime_context_field_rax(c, runtime_context_field_heap_cursor())
    c.code = emit_store_rax_rbp_disp32(c.code, -24)     // save result ptr at [rbp-24]
    c.code = emit_load_rbp_disp32_rax(c.code, -8)       // rax = len
    // add rax, 1 — raw: 48 83 c0 01 (mirrors emit_builtin_str_concat)
    var ab = c.code
    ab = emit_byte(ab, 0x48)
    ab = emit_byte(ab, 0x83)
    ab = emit_byte(ab, 0xc0)
    ab = emit_byte(ab, 0x01)
    c.code = ab                                          // rax = len + 1
    c.code = emit_mov_rcx_rax(c.code)                   // rcx = total
    c = emit_load_runtime_context_field_rax(c, runtime_context_field_heap_cursor())
    c.code = emit_add_reg_reg(c.code, 0, 1)             // rax = cursor + total
    c = emit_store_rax_runtime_context_field(c, runtime_context_field_heap_cursor())

    // Copy-loop setup:
    //   rdx = object base (fixed)
    //   rbx = element index, starts at header_words (native_v2_object_header_size()/8)
    //   rsi = dest ptr (result), running
    //   rcx = remaining element count (countdown from len)
    c.code = emit_load_rbp_disp32_rax(c.code, -16)      // rax = object base
    c.code = emit_mov_reg_reg(c.code, 2, 0)             // rdx = object base
    c.code = emit_mov_reg_imm(c.code, 3, native_v2_object_header_size() / 8)  // rbx = header_words
    c.code = emit_load_rbp_disp32_rax(c.code, -24)      // rax = result ptr
    c.code = emit_mov_reg_reg(c.code, 6, 0)             // rsi = result ptr
    c.code = emit_load_rbp_disp32_rax(c.code, -8)       // rax = len
    c.code = emit_mov_reg_reg(c.code, 1, 0)             // rcx = len

    // copy_loop: (byte offsets from loop top)
    //   0:  test rcx, rcx           — 3 bytes (48 85 c9)
    //   3:  jz done_copy            — 2 bytes (rel8, skip 4+2+3+3+3+2 = 17)
    //   5:  mov rax, [rdx+rbx*8]    — 4 bytes (48 8b 04 da) — unpack boxed element
    //   9:  mov [rsi], al          — 2 bytes (88 06)         — store its low byte
    //   11: inc rbx                — 3 bytes (48 ff c3)
    //   14: inc rsi                — 3 bytes (48 ff c6)
    //   17: dec rcx                — 3 bytes (48 ff c9)
    //   20: jmp copy_loop          — 2 bytes (rel8, back 22 bytes to offset 0)
    //   22: done_copy:
    var lb = c.code
    lb = emit_byte(lb, 0x48)
    lb = emit_byte(lb, 0x85)
    lb = emit_byte(lb, 0xc9)                             // test rcx, rcx
    c.code = lb
    c.code = emit_jz_rel8(c.code, 17)                    // jz done_copy

    lb = c.code
    lb = emit_byte(lb, 0x48)
    lb = emit_byte(lb, 0x8b)
    lb = emit_byte(lb, 0x04)
    lb = emit_byte(lb, 0xda)                             // mov rax, [rdx+rbx*8]
    lb = emit_byte(lb, 0x88)
    lb = emit_byte(lb, 0x06)                             // mov [rsi], al
    lb = emit_byte(lb, 0x48)
    lb = emit_byte(lb, 0xff)
    lb = emit_byte(lb, 0xc3)                             // inc rbx
    lb = emit_byte(lb, 0x48)
    lb = emit_byte(lb, 0xff)
    lb = emit_byte(lb, 0xc6)                             // inc rsi
    lb = emit_byte(lb, 0x48)
    lb = emit_byte(lb, 0xff)
    lb = emit_byte(lb, 0xc9)                             // dec rcx
    c.code = lb
    c.code = emit_jmp_rel8(c.code, -22)                  // jmp copy_loop
    // done_copy:

    // Null-terminate + return result pointer
    c.code = emit_mov_byte_mem_rsi_imm8(c.code, 0)      // mov byte [rsi], 0
    c.code = emit_load_rbp_disp32_rax(c.code, -24)      // rax = result ptr
    c.code = emit_mov_rsp_rbp(c.code)
    c.code = emit_pop_rbp(c.code)
    c.code = emit_ret(c.code)
    c
}

// "str_from_bytes" = 14 chars
fn name_is_str_from_bytes(n: Name) -> bool with Mut, Panic, Div {
    if n.len != 14 { return false }
    if n.buf[0] != 115 as i8 { return false }    // 's'
    if n.buf[1] != 116 as i8 { return false }    // 't'
    if n.buf[2] != 114 as i8 { return false }    // 'r'
    if n.buf[3] != 95 as i8 { return false }     // '_'
    if n.buf[4] != 102 as i8 { return false }    // 'f'
    if n.buf[5] != 114 as i8 { return false }    // 'r'
    if n.buf[6] != 111 as i8 { return false }    // 'o'
    if n.buf[7] != 109 as i8 { return false }    // 'm'
    if n.buf[8] != 95 as i8 { return false }     // '_'
    if n.buf[9] != 98 as i8 { return false }     // 'b'
    if n.buf[10] != 121 as i8 { return false }   // 'y'
    if n.buf[11] != 116 as i8 { return false }   // 't'
    if n.buf[12] != 101 as i8 { return false }   // 'e'
    if n.buf[13] != 115 as i8 { return false }   // 's'
    true
}

// starts_with(s: *u8, prefix: *u8) -> i64 (1 if starts with, 0 if not)
// Compares prefix against beginning of s until prefix reaches null.
fn emit_builtin_starts_with(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // rdi = s, rsi = prefix
    // Layout:
    //   0:  movzx rax, byte [rsi]    — 4 bytes  (load prefix char)
    //   4:  test al, al               — 2 bytes  (end of prefix?)
    //   6:  jz match                  — 2 bytes  (rel8 = 12, target = 20)
    //   8:  cmp al, [rdi]             — 2 bytes  (compare with s)
    //   10: jnz no_match              — 2 bytes  (rel8 = 16, target = 28)
    //   12: inc rdi                   — 3 bytes
    //   15: inc rsi                   — 3 bytes
    //   18: jmp loop                  — 2 bytes  (rel8 = -20, target = 0)
    //   20: mov rax, 1                — 7 bytes  [match]
    //   27: ret                       — 1 byte
    //   28: xor rax, rax              — 3 bytes  [no_match]
    //   31: ret                       — 1 byte

    // loop:
    c.code = emit_movzx_rax_byte_rsi(c.code)      // 4: movzx rax, byte [rsi]
    c.code = emit_test_al_al(c.code)               // 2: test al, al
    c.code = emit_jz_rel8(c.code, 12)              // 2: jz match (skip 2+2+3+3+2 = 12)
    c.code = emit_cmp_al_mem_rdi(c.code)           // 2: cmp al, [rdi]
    c.code = emit_jnz_rel8(c.code, 16)             // 2: jnz no_match (skip 3+3+2+7+1 = 16)
    c.code = emit_inc_rdi(c.code)                   // 3: inc rdi
    c.code = emit_inc_rsi(c.code)                   // 3: inc rsi
    c.code = emit_jmp_rel8(c.code, -20)             // 2: jmp loop (-20 back to offset 0)
    // match:
    c.code = emit_mov_rax_imm(c.code, 1)           // 7: mov rax, 1
    c.code = emit_ret(c.code)                       // 1
    // no_match:
    c.code = emit_xor_rax_rax(c.code)              // 3
    c.code = emit_ret(c.code)                       // 1
    c
}

// str_concat(a: *u8, b: *u8) -> *u8
// Allocates len_a + len_b + 1 bytes from RuntimeContext.heap_cursor,
// copies a then b, null-terminates, returns pointer to new string.
fn emit_builtin_str_concat(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    // rdi = a, rsi = b

    // Phase 0: Prologue + save inputs
    c.code = emit_push_rbp(c.code)                     // 1
    c.code = emit_mov_rbp_rsp(c.code)                  // 3
    c.code = emit_sub_rsp_imm32(c.code, 48)            // 7
    c.code = emit_mov_reg_reg(c.code, 0, 7)            // 3: mov rax, rdi
    c.code = emit_store_rax_rbp_disp32(c.code, -8)     // 7: save a at [rbp-8]
    c.code = emit_mov_reg_reg(c.code, 0, 6)            // 3: mov rax, rsi
    c.code = emit_store_rax_rbp_disp32(c.code, -16)    // 7: save b at [rbp-16]

    // Phase 1: Compute len_a (rdi still = a)
    c.code = emit_xor_rcx_rcx(c.code)                  // 3: rcx = 0
    // loop_a:
    c.code = emit_cmp_byte_rdi_zero(c.code)             // 3: cmp byte [rdi], 0
    c.code = emit_jz_rel8(c.code, 8)                    // 2: jz done_a (skip 3+3+2)
    c.code = emit_inc_rdi(c.code)                       // 3
    c.code = emit_inc_rcx(c.code)                       // 3
    c.code = emit_jmp_rel8(c.code, -13)                 // 2: jmp loop_a
    // done_a: rcx = len_a
    c.code = emit_mov_reg_reg(c.code, 0, 1)             // 3: mov rax, rcx
    c.code = emit_store_rax_rbp_disp32(c.code, -24)     // 7: save len_a at [rbp-24]

    // Phase 2: Compute len_b
    c.code = emit_load_rbp_disp32_rax(c.code, -16)      // 7: rax = b
    c.code = emit_mov_rdi_rax(c.code)                    // 3: rdi = b
    c.code = emit_xor_rcx_rcx(c.code)                   // 3: rcx = 0
    // loop_b:
    c.code = emit_cmp_byte_rdi_zero(c.code)              // 3: cmp byte [rdi], 0
    c.code = emit_jz_rel8(c.code, 8)                     // 2: jz done_b
    c.code = emit_inc_rdi(c.code)                        // 3
    c.code = emit_inc_rcx(c.code)                        // 3
    c.code = emit_jmp_rel8(c.code, -13)                  // 2: jmp loop_b
    // done_b: rcx = len_b

    // Phase 3: Allocate from RuntimeContext.heap_cursor
    c = emit_load_runtime_context_field_rax(c, runtime_context_field_heap_cursor())
    c.code = emit_store_rax_rbp_disp32(c.code, -40)      // 7: save result at [rbp-40]
    c.code = emit_load_rbp_disp32_rax(c.code, -24)       // 7: rax = len_a
    c.code = emit_add_reg_reg(c.code, 0, 1)              // 3: rax += rcx (len_b)
    // add rax, 1 — raw: 48 83 c0 01
    var ab = c.code
    ab = emit_byte(ab, 0x48)
    ab = emit_byte(ab, 0x83)
    ab = emit_byte(ab, 0xc0)
    ab = emit_byte(ab, 0x01)
    c.code = ab                                           // 4: rax = total
    c.code = emit_mov_rcx_rax(c.code)                    // 3: rcx = total
    c = emit_load_runtime_context_field_rax(c, runtime_context_field_heap_cursor())
    c.code = emit_add_reg_reg(c.code, 0, 1)              // 3: rax = new r13
    c = emit_store_rax_runtime_context_field(c, runtime_context_field_heap_cursor())

    // Phase 4: Copy a → result
    c.code = emit_load_rbp_disp32_rax(c.code, -8)        // 7: rax = a
    c.code = emit_mov_rdi_rax(c.code)                     // 3: rdi = a (source)
    c.code = emit_load_rbp_disp32_rax(c.code, -40)       // 7: rax = result
    c.code = emit_mov_rsi_rax(c.code)                     // 3: rsi = result (dest)
    // copy_loop_a:
    c.code = emit_movzx_rax_byte_rdi(c.code)             // 4: movzx rax, byte [rdi]
    c.code = emit_test_al_al(c.code)                      // 2: test al, al
    c.code = emit_jz_rel8(c.code, 13)                     // 2: jz done_copy_a (skip 3+2+3+3+2)
    c.code = emit_mov_reg_reg(c.code, 2, 0)              // 3: mov rdx, rax (dl = byte)
    c.code = emit_mov_byte_mem_rsi_dl(c.code)             // 2: mov [rsi], dl
    c.code = emit_inc_rdi(c.code)                         // 3
    c.code = emit_inc_rsi(c.code)                         // 3
    c.code = emit_jmp_rel8(c.code, -21)                   // 2: jmp copy_loop_a
    // done_copy_a: rsi points past last copied byte

    // Phase 5: Copy b → result (rsi continues from end of a)
    c.code = emit_load_rbp_disp32_rax(c.code, -16)       // 7: rax = b
    c.code = emit_mov_rdi_rax(c.code)                     // 3: rdi = b (source)
    // copy_loop_b:
    c.code = emit_movzx_rax_byte_rdi(c.code)             // 4: movzx rax, byte [rdi]
    c.code = emit_test_al_al(c.code)                      // 2: test al, al
    c.code = emit_jz_rel8(c.code, 13)                     // 2: jz done_copy_b
    c.code = emit_mov_reg_reg(c.code, 2, 0)              // 3: mov rdx, rax
    c.code = emit_mov_byte_mem_rsi_dl(c.code)             // 2: mov [rsi], dl
    c.code = emit_inc_rdi(c.code)                         // 3
    c.code = emit_inc_rsi(c.code)                         // 3
    c.code = emit_jmp_rel8(c.code, -21)                   // 2: jmp copy_loop_b
    // done_copy_b:

    // Phase 6: Null terminate + return
    c.code = emit_mov_byte_mem_rsi_imm8(c.code, 0)       // 3: mov byte [rsi], 0
    c.code = emit_load_rbp_disp32_rax(c.code, -40)       // 7: rax = result ptr
    c.code = emit_mov_rsp_rbp(c.code)                     // 3: epilogue
    c.code = emit_pop_rbp(c.code)                         // 1
    c.code = emit_ret(c.code)                              // 1
    c
}

fn native_v2_rodata_append_updated_tail(nc: &! NativeCompiler, updated: NativeCompiler, src_start: i64) -> i64 with Mut, Panic, Div {
    // #1547: always append into the flat rodata (NC_BIG_RODATA), never the inline
    // nc.rodata. Every other rodata producer reachable from the lanes that use this
    // funnel (compile_ir_function_v2_from_ir_into: strings via
    // nc_rodata_add_ir_instr_name / nc_rodata_add_name_value, f64 literals as
    // immediates) writes ONLY to the flat buffer, and the final ELF writers emit
    // the flat buffer exclusively whenever flat_rodata_len > 0 — inline bytes are
    // dropped without merging. A builtin emitted before the first flat byte (e.g.
    // an extern "C" sqrt/exp/log stub in an early fn slot, retained multi-decl
    // extern blocks) previously landed in the inline buffer here; its constants
    // were then silently lost and its RIP-relative relocations aliased whatever
    // flat bytes later occupied those offsets (exp/log returning string garbage
    // in multi-module stdlib compiles). Single store => emission-order independent.
    let append_base = (*nc).flat_rodata_len
    var src = src_start
    var len = (*nc).flat_rodata_len
    while src < updated.rodata.len && len < 262144 {
        NC_BIG_RODATA[len as usize] = updated.rodata.bytes[src as usize]
        len = len + 1
        src = src + 1
    }
    (*nc).flat_rodata_len = len
    append_base
}

fn native_v2_persist_builtin_emit_into(nc: &! NativeCompiler, updated: NativeCompiler) with Mut, Panic, Div {
    let nc_rodata_len_before = (*nc).rodata.len
    (*nc).code = updated.code
    let rodata_append_base = native_v2_rodata_append_updated_tail(nc, updated, nc_rodata_len_before)
    var ri = 0
    while ri < updated.relocs.count && ri < 4096 {
        let entry = updated.relocs.entries[ri as usize]
        if entry.kind.kind_code == 2 {
            let adjusted = rodata_append_base + (entry.target.target_index - nc_rodata_len_before)
            nc_add_rodata_reloc(nc, entry.offset, adjusted)
        } else if entry.kind.kind_code == 3 {
            nc_add_data_section_reloc(nc, entry.offset, entry.target.target_index)
        }
        ri = ri + 1
    }
}

fn emit_builtin_str_len_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_xor_rcx_rcx(nc)
    (*nc).code = emit_cmp_byte_rdi_zero((*nc).code)
    nc_emit_jz_rel8(nc, 8)
    nc_emit_inc_rdi(nc)
    nc_emit_inc_rcx(nc)
    nc_emit_jmp_rel8(nc, -13)
    nc_emit_mov_reg_reg(nc, 0, 1)
    nc_emit_ret(nc)
}

fn emit_builtin_str_char_at_into(nc: &! NativeCompiler) with Mut, Panic, Div {
    // rdi = string pointer, rsi = byte index
    nc_emit_mov_reg_reg(nc, 3, 6)
    (*nc).code = emit_movzx_rax_byte_rdi_rbx((*nc).code)
    nc_emit_ret(nc)
}

// ============================================================================
// M5: File I/O builtins
// ============================================================================

// read_file(path: string) -> string  (1-arg): mmap a 1 MiB buffer, open/read/close,
// return the buffer POINTER (rax). Byte-for-byte mirror of the bootstrap emitter
// self-hosted/bootstrap/bootstrap_v0.sio:15028-15087 — the form the running compiler
// (and all 54 self-hosted callers + the LSP contract) uses. The previous native-v2 body
// implemented a DIFFERENT 3-arg read_file(path,buf,max_len)->bytes_read and returned an
// INTEGER, so 1-arg callers dereferenced a non-pointer -> SIGSEGV on raw[i]/str_len/
// str_char_at. (The only 3-arg caller, examples/cognitive_ossm/run_ossm_native_reference.sio,
// self-documents that it does not native-compile, so no working native 3-arg contract exists.)
// NUL-termination relies on anonymous-mmap zero-fill: OK for text/CSV < 1 MiB with no embedded
// NUL; larger/binary files are a known limit. The mmap is intentionally leaked (matches the
// bootstrap reference). Linux x86-64 only (raw syscalls), per CLAUDE.md.
fn emit_builtin_read_file(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    var b = c.code
    b = emit_byte(b, 0x55)                                                       // push rbp
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x89); b = emit_byte(b, 0xe5)       // mov rbp,rsp
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x81); b = emit_byte(b, 0xec); b = emit_byte(b, 0xc0); b = emit_byte(b, 0x00); b = emit_byte(b, 0x00); b = emit_byte(b, 0x00)  // sub rsp,192 (locals + 144B statbuf)
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x89); b = emit_byte(b, 0x7d); b = emit_byte(b, 0xf8)  // mov [rbp-8],rdi (path)
    // sys_open(path, O_RDONLY=0, 0)
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x8b); b = emit_byte(b, 0x7d); b = emit_byte(b, 0xf8)  // mov rdi,[rbp-8]
    b = emit_byte(b, 0xb8); b = emit_byte(b, 0x02); b = emit_byte(b, 0x00); b = emit_byte(b, 0x00); b = emit_byte(b, 0x00)  // mov eax,2 (open)
    b = emit_byte(b, 0x31); b = emit_byte(b, 0xf6)                               // xor esi,esi
    b = emit_byte(b, 0x31); b = emit_byte(b, 0xd2)                               // xor edx,edx
    b = emit_byte(b, 0x0f); b = emit_byte(b, 0x05)                               // syscall
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x89); b = emit_byte(b, 0x45); b = emit_byte(b, 0xf0)  // mov [rbp-16],rax (fd)
    // zero-init st_size slot [rbp-144] (guards fstat-fail / procfs size-0)
    b = emit_byte(b, 0x48); b = emit_byte(b, 0xc7); b = emit_byte(b, 0x85); b = emit_byte(b, 0x70); b = emit_byte(b, 0xff); b = emit_byte(b, 0xff); b = emit_byte(b, 0xff); b = emit_byte(b, 0x00); b = emit_byte(b, 0x00); b = emit_byte(b, 0x00); b = emit_byte(b, 0x00)  // mov qword [rbp-144],0
    // sys_fstat(fd, statbuf @ rbp-192) -> st_size at [rbp-144]
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x89); b = emit_byte(b, 0xc7)       // mov rdi,rax (fd)
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x8d); b = emit_byte(b, 0xb5); b = emit_byte(b, 0x40); b = emit_byte(b, 0xff); b = emit_byte(b, 0xff); b = emit_byte(b, 0xff)  // lea rsi,[rbp-192]
    b = emit_byte(b, 0xb8); b = emit_byte(b, 0x05); b = emit_byte(b, 0x00); b = emit_byte(b, 0x00); b = emit_byte(b, 0x00)  // mov eax,5 (fstat)
    b = emit_byte(b, 0x0f); b = emit_byte(b, 0x05)                               // syscall
    // size = st_size; fall back to 1 MiB if <= 0 (empty/procfs/fstat-fail)
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x8b); b = emit_byte(b, 0x85); b = emit_byte(b, 0x70); b = emit_byte(b, 0xff); b = emit_byte(b, 0xff); b = emit_byte(b, 0xff)  // mov rax,[rbp-144]
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x85); b = emit_byte(b, 0xc0)       // test rax,rax
    b = emit_byte(b, 0x7f); b = emit_byte(b, 0x05)                               // jg +5 (skip fallback)
    b = emit_byte(b, 0xb8); b = emit_byte(b, 0x00); b = emit_byte(b, 0x00); b = emit_byte(b, 0x10); b = emit_byte(b, 0x00)  // mov eax,0x100000 (1 MiB fallback)
    // mmap_len = (size + 64 + 4095) & ~4095  (>=64B zero tail guarantees NUL past content)
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x05); b = emit_byte(b, 0x3f); b = emit_byte(b, 0x10); b = emit_byte(b, 0x00); b = emit_byte(b, 0x00)  // add rax,0x103F
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x25); b = emit_byte(b, 0x00); b = emit_byte(b, 0xf0); b = emit_byte(b, 0xff); b = emit_byte(b, 0xff)  // and rax,~0xFFF (page align)
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x89); b = emit_byte(b, 0x45); b = emit_byte(b, 0xe0)  // mov [rbp-32],rax (mmap_len)
    // sys_mmap(NULL, mmap_len, PROT_READ|PROT_WRITE=3, MAP_PRIVATE|MAP_ANONYMOUS=0x22, -1, 0)
    b = emit_byte(b, 0x31); b = emit_byte(b, 0xff)                               // xor edi,edi
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x8b); b = emit_byte(b, 0x75); b = emit_byte(b, 0xe0)  // mov rsi,[rbp-32] (mmap_len)
    b = emit_byte(b, 0xba); b = emit_byte(b, 0x03); b = emit_byte(b, 0x00); b = emit_byte(b, 0x00); b = emit_byte(b, 0x00)  // mov edx,3
    b = emit_byte(b, 0x41); b = emit_byte(b, 0xba); b = emit_byte(b, 0x22); b = emit_byte(b, 0x00); b = emit_byte(b, 0x00); b = emit_byte(b, 0x00)  // mov r10d,0x22
    b = emit_byte(b, 0x41); b = emit_byte(b, 0xb8); b = emit_byte(b, 0xff); b = emit_byte(b, 0xff); b = emit_byte(b, 0xff); b = emit_byte(b, 0xff)  // mov r8d,-1
    b = emit_byte(b, 0x45); b = emit_byte(b, 0x31); b = emit_byte(b, 0xc9)       // xor r9d,r9d
    b = emit_byte(b, 0xb8); b = emit_byte(b, 0x09); b = emit_byte(b, 0x00); b = emit_byte(b, 0x00); b = emit_byte(b, 0x00)  // mov eax,9 (mmap)
    b = emit_byte(b, 0x0f); b = emit_byte(b, 0x05)                               // syscall
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x89); b = emit_byte(b, 0x45); b = emit_byte(b, 0xe8)  // mov [rbp-24],rax (buf ptr)
    // sys_read(fd, buf, mmap_len - 1)  -- leaves the final zero byte as NUL terminator
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x8b); b = emit_byte(b, 0x7d); b = emit_byte(b, 0xf0)  // mov rdi,[rbp-16] (fd)
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x89); b = emit_byte(b, 0xc6)       // mov rsi,rax (buf)
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x8b); b = emit_byte(b, 0x55); b = emit_byte(b, 0xe0)  // mov rdx,[rbp-32] (mmap_len)
    b = emit_byte(b, 0x48); b = emit_byte(b, 0xff); b = emit_byte(b, 0xca)       // dec rdx (mmap_len-1)
    b = emit_byte(b, 0x31); b = emit_byte(b, 0xc0)                               // xor eax,eax (read)
    b = emit_byte(b, 0x0f); b = emit_byte(b, 0x05)                               // syscall
    // sys_close(fd)
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x8b); b = emit_byte(b, 0x7d); b = emit_byte(b, 0xf0)  // mov rdi,[rbp-16] (fd)
    b = emit_byte(b, 0xb8); b = emit_byte(b, 0x03); b = emit_byte(b, 0x00); b = emit_byte(b, 0x00); b = emit_byte(b, 0x00)  // mov eax,3 (close)
    b = emit_byte(b, 0x0f); b = emit_byte(b, 0x05)                               // syscall
    b = emit_byte(b, 0x48); b = emit_byte(b, 0x8b); b = emit_byte(b, 0x45); b = emit_byte(b, 0xe8)  // mov rax,[rbp-24] (return buf ptr)
    b = emit_byte(b, 0xc9)                                                       // leave
    b = emit_byte(b, 0xc3)                                                       // ret
    c.code = b
    c
}

// write_file(path: *u8, buf_handle, len: i64) -> i64 (bytes written)
// Native-v2 arrays are GC handles with 8-byte boxed element slots after a 32-byte
// object header (same ABI as emit_builtin_str_from_bytes). The call shape is
// write_file(path, buf, n) — handle by value, NOT &buf. We resolve the handle,
// unpack low bytes into a packed contiguous buffer, then open/write/close.
// Uses sys_open (O_WRONLY|O_CREAT|O_TRUNC=577), sys_write, sys_close.
fn emit_builtin_write_file(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_push_rbp(c.code)
    c.code = emit_mov_rbp_rsp(c.code)
    c.code = emit_sub_rsp_imm32(c.code, 64)

    // Save args: rdi=path, rsi=buf_handle, rdx=len
    // Stack:
    //   [rbp-8]  path
    //   [rbp-16] buf_handle
    //   [rbp-24] len
    //   [rbp-32] object base
    //   [rbp-40] packed buffer ptr
    //   [rbp-48] fd
    //   [rbp-56] bytes_written
    c.code = emit_store_reg_rbp_disp32(c.code, -8, 7)    // [rbp-8] = rdi (path)
    c.code = emit_store_reg_rbp_disp32(c.code, -16, 6)   // [rbp-16] = rsi (buf_handle)
    c.code = emit_store_reg_rbp_disp32(c.code, -24, 2)   // [rbp-24] = rdx (len)

    // Resolve buf_handle (rsi) -> object base pointer, save at [rbp-32]
    c.code = emit_mov_reg_reg(c.code, 0, 6)             // rax = rsi (handle)
    c = native_v2_resolve_handle_to_object_base_rax(c)   // rax = object base
    c.code = emit_store_rax_rbp_disp32(c.code, -32)

    // Bump-allocate len packed bytes from RuntimeContext.heap_cursor
    c = emit_load_runtime_context_field_rax(c, runtime_context_field_heap_cursor())
    c.code = emit_store_rax_rbp_disp32(c.code, -40)     // packed ptr = old cursor
    c.code = emit_load_rbp_disp32_rax(c.code, -24)      // rax = len
    c.code = emit_mov_rcx_rax(c.code)                   // rcx = len
    c = emit_load_runtime_context_field_rax(c, runtime_context_field_heap_cursor())
    c.code = emit_add_reg_reg(c.code, 0, 1)             // rax = cursor + len
    c = emit_store_rax_runtime_context_field(c, runtime_context_field_heap_cursor())

    // Copy-loop setup (mirrors emit_builtin_str_from_bytes):
    //   rdx = object base (fixed)
    //   rbx = element index, starts at header_words (native_v2_object_header_size()/8)
    //   rsi = dest ptr (packed), running
    //   rcx = remaining element count (countdown from len)
    c.code = emit_load_rbp_disp32_rax(c.code, -32)      // rax = object base
    c.code = emit_mov_reg_reg(c.code, 2, 0)             // rdx = object base
    c.code = emit_mov_reg_imm(c.code, 3, native_v2_object_header_size() / 8)  // rbx = header_words
    c.code = emit_load_rbp_disp32_rax(c.code, -40)      // rax = packed ptr
    c.code = emit_mov_reg_reg(c.code, 6, 0)             // rsi = packed ptr
    c.code = emit_load_rbp_disp32_rax(c.code, -24)      // rax = len
    c.code = emit_mov_reg_reg(c.code, 1, 0)             // rcx = len

    // copy_loop: (byte offsets from loop top) — identical body to str_from_bytes
    //   0:  test rcx, rcx           — 3 bytes
    //   3:  jz done_copy            — 2 bytes (rel8 +17)
    //   5:  mov rax, [rdx+rbx*8]    — 4 bytes (unpack boxed element)
    //   9:  mov [rsi], al          — 2 bytes (store low byte)
    //   11: inc rbx                — 3 bytes
    //   14: inc rsi                — 3 bytes
    //   17: dec rcx                — 3 bytes
    //   20: jmp copy_loop          — 2 bytes (rel8 -22)
    //   22: done_copy:
    var lb = c.code
    lb = emit_byte(lb, 0x48)
    lb = emit_byte(lb, 0x85)
    lb = emit_byte(lb, 0xc9)                             // test rcx, rcx
    c.code = lb
    c.code = emit_jz_rel8(c.code, 17)                    // jz done_copy

    lb = c.code
    lb = emit_byte(lb, 0x48)
    lb = emit_byte(lb, 0x8b)
    lb = emit_byte(lb, 0x04)
    lb = emit_byte(lb, 0xda)                             // mov rax, [rdx+rbx*8]
    lb = emit_byte(lb, 0x88)
    lb = emit_byte(lb, 0x06)                             // mov [rsi], al
    lb = emit_byte(lb, 0x48)
    lb = emit_byte(lb, 0xff)
    lb = emit_byte(lb, 0xc3)                             // inc rbx
    lb = emit_byte(lb, 0x48)
    lb = emit_byte(lb, 0xff)
    lb = emit_byte(lb, 0xc6)                             // inc rsi
    lb = emit_byte(lb, 0x48)
    lb = emit_byte(lb, 0xff)
    lb = emit_byte(lb, 0xc9)                             // dec rcx
    c.code = lb
    c.code = emit_jmp_rel8(c.code, -22)                  // jmp copy_loop
    // done_copy:

    // open(path, O_WRONLY|O_CREAT|O_TRUNC=577, 0755=493)
    c.code = emit_load_rbp_disp32_rax(c.code, -8)        // rax = path
    c.code = emit_mov_reg_reg(c.code, 7, 0)             // rdi = path
    c = emit_open_syscall_for_target(c, c.target_os_id, 577, 493)

    // Save fd
    c.code = emit_store_rax_rbp_disp32(c.code, -48)      // [rbp-48] = fd

    // write(fd, packed, len)
    c.code = emit_mov_rdi_rax(c.code)                    // rdi = fd
    c.code = emit_load_rbp_disp32_rax(c.code, -40)       // rax = packed
    c.code = emit_mov_rsi_rax(c.code)                    // rsi = packed
    c.code = emit_load_rbp_disp32_rax(c.code, -24)       // rax = len
    c.code = emit_mov_rdx_rax(c.code)                    // rdx = len
    c = emit_write_syscall_for_target(c, c.target_os_id)

    // Save bytes_written
    c.code = emit_store_rax_rbp_disp32(c.code, -56)      // [rbp-56] = bytes_written

    // close(fd)
    c.code = emit_load_rbp_disp32_rax(c.code, -48)       // rax = fd
    c.code = emit_mov_rdi_rax(c.code)                    // rdi = fd
    c = emit_close_syscall_for_target(c, c.target_os_id)

    // Return bytes_written
    c.code = emit_load_rbp_disp32_rax(c.code, -56)

    c.code = emit_mov_rsp_rbp(c.code)
    c.code = emit_pop_rbp(c.code)
    c.code = emit_ret(c.code)
    c
}

// file_size(path: *u8) -> i64
// Uses sys_stat (syscall 4) with 144-byte stat buffer on stack
// st_size is at offset 48 in struct stat
// Sprint 115: sqrt builtin — hardware SQRTSD
fn emit_builtin_sqrt(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_push_rbp(c.code)
    c.code = emit_mov_rbp_rsp(c.code)
    c.code = emit_mov_reg_reg(c.code, 0, 7)           // mov rax, rdi
    c.code = emit_movq_xmm0_rax(c.code)               // movq xmm0, rax
    c.code = emit_sqrtsd_xmm0_xmm0(c.code)            // sqrtsd xmm0, xmm0
    c.code = emit_movq_rax_xmm0(c.code)               // movq rax, xmm0
    c.code = emit_pop_rbp(c.code)
    c.code = emit_ret(c.code)
    c
}

// f64_to_bits / bits_to_f64 — pure IEEE-754 reinterpret. The 64-bit value is
// identical whether read as f64 or i64, and this backend passes the argument in
// rdi and returns in rax (same convention as emit_builtin_sqrt), so the body is
// just `rax = rdi`. Without this the call defaults to fn 0 (the runtime entry)
// and segfaults.
fn emit_builtin_f64_bits_identity(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_push_rbp(c.code)
    c.code = emit_mov_rbp_rsp(c.code)
    c.code = emit_mov_reg_reg(c.code, 0, 7)           // mov rax, rdi
    c.code = emit_pop_rbp(c.code)
    c.code = emit_ret(c.code)
    c
}

// acknowledge / require_confidence receive the Knowledge object handle in rdi
// and return its field-0 payload. They must not be empty stubs: the fail-closed
// backend deliberately emits ud2 for an unimplemented declaration.
fn emit_builtin_knowledge_value(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_push_rbp(c.code)
    c.code = emit_mov_rbp_rsp(c.code)
    c.code = emit_mov_reg_reg(c.code, 0, 7) // rax = Knowledge handle
    c = native_v2_resolve_handle_to_object_base_rax(c)
    c.code = emit_mov_reg_imm(c.code, 3, native_v2_object_header_size() / 8)
    c.code = emit_mov_rax_mem_rax_rbx8(c.code)
    c.code = emit_pop_rbp(c.code)
    c.code = emit_ret(c.code)
    c
}
// Sprint 119: exp builtin — range-reduction + degree-6 minimax polynomial
// Algorithm: x = n*ln(2) + r, exp(r) via Horner, scale by 2^n
// Stack layout: [rbp-8]=input x, [rbp-16]=r, [rbp-24]=n_float, [rbp-32]=result
// Uses only xmm0/xmm1 with stack temps for intermediates
// Shared Horner step for the exp/log polynomial chains (#1626).
//
// acc = coeff + v * acc, with `v` and `acc` in rbp-relative slots and `coeff`
// in .rodata. Factored out because the previous emitters open-coded one copy of
// these five instructions per term -- which is why they stopped at degree 6 and
// degree 4. The code, not the mathematics, was setting the accuracy.
fn emit_horner_step(nc: NativeCompiler, v_slot: i64, acc_slot: i64, coeff_off: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_movsd_xmm0_rbp_disp8(c.code, v_slot)     // xmm0 = v
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, acc_slot)   // xmm1 = acc
    c.code = emit_mulsd_xmm0_xmm1(c.code)                  // xmm0 = v * acc
    let pos = c.code.len
    c.code = emit_movsd_xmm1_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, pos + 4, coeff_off)
    c.code = emit_addsd_xmm0_xmm1(c.code)                  // xmm0 = coeff + v*acc
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, acc_slot)
    c
}

// exp builtin (#1626).
//
// Was: n = TRUNCATE(x/ln2), r = x - n*ln2 with a single-double ln2, degree-6
// Taylor. Three independent errors, each dominant somewhere:
//
//   truncate     |r| < ln2 = 0.693 rather than ln2/2, so the r^7/5040
//                truncation term ran to 1.5e-5 instead of 7.6e-8 -- 128x
//   single ln2   n*ln2 for x = 1000 (n = 1443) rounds at ~1e-13 absolute, and
//                that lands directly in r, hence RELATIVELY in the result
//   degree 6     7.6e-8 even at the smaller |r|
//
// Now: n = ROUND(x/ln2), so |r| <= ln2/2 = 0.3466; Cody-Waite two-part ln2 with
// 40 significant bits in the high half, so n*ln2_hi is exact for |n| < 2^13
// (x out past the whole binary64 exponent range); degree 13, whose truncation
// term r^14/14! is 4.1e-18 -- under half an ULP.
//
// Constants are generated, not typed. Hand-typing is how a constant ends up
// right to 15 digits and wrong in the 16th.
//
// UNCHANGED, and still wrong at the edges: the 2^n scaling is a raw
// `bits + (n << 52)`, which neither produces a denormal on underflow nor
// saturates to infinity on overflow.
//
// Stack: [rbp-8]=x  [rbp-16]=r  [rbp-24]=n_f64  [rbp-32]=n  [rbp-40]=acc
//        [rbp-48]=scratch  [rbp-56]=result bits
pub(crate) fn emit_builtin_exp(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc

    c.rodata = data_section_add_f64(c.rodata, 0x3FF71547652B82FE)   // 1/ln2
    let inv_ln2_off = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FE62E42FEFA3000)   // ln2, high 40 bits
    let ln2_hi_off = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3D53DE6AF278ECE6)   // ln2 - ln2_hi
    let ln2_lo_off = c.rodata.last_offset

    // 1/k! for k = 0..13, indexed by k.
    var cf: [i64; 14] = [0; 14]
    c.rodata = data_section_add_f64(c.rodata, 0x3FF0000000000000)   // 1/0!
    cf[0] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FF0000000000000)   // 1/1!
    cf[1] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FE0000000000000)   // 1/2!
    cf[2] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FC5555555555555)   // 1/3!
    cf[3] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FA5555555555555)   // 1/4!
    cf[4] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3F81111111111111)   // 1/5!
    cf[5] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3F56C16C16C16C17)   // 1/6!
    cf[6] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3F2A01A01A01A01A)   // 1/7!
    cf[7] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3EFA01A01A01A01A)   // 1/8!
    cf[8] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3EC71DE3A556C734)   // 1/9!
    cf[9] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3E927E4FB7789F5C)   // 1/10!
    cf[10] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3E5AE64567F544E4)   // 1/11!
    cf[11] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3E21EED8EFF8D898)   // 1/12!
    cf[12] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3DE6124613A86D09)   // 1/13!
    cf[13] = c.rodata.last_offset

    c.code = emit_push_rbp(c.code)
    c.code = emit_mov_rbp_rsp(c.code)
    c.code = emit_sub_rsp_imm32(c.code, 128)

    c.code = emit_mov_reg_reg(c.code, 0, 7)          // rax = rdi = bits(x)
    c.code = emit_movq_xmm0_rax(c.code)
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, 0 - 8)

    // n = round(x / ln2) -- ROUND, not truncate: this alone halves |r|.
    let p_inv = c.code.len
    c.code = emit_movsd_xmm1_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, p_inv + 4, inv_ln2_off)
    c.code = emit_mulsd_xmm0_xmm1(c.code)
    c.code = emit_cvtsd2si_rax_xmm0(c.code)
    c.code = emit_store_rax_rbp_disp32(c.code, 0 - 32)
    c.code = emit_cvtsi2sd_xmm0_rax(c.code)
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, 0 - 24)   // n_f64

    // r = (x - n*ln2_hi) - n*ln2_lo    (Cody-Waite)
    let p_hi = c.code.len
    c.code = emit_movsd_xmm1_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, p_hi + 4, ln2_hi_off)
    c.code = emit_mulsd_xmm0_xmm1(c.code)                // n * ln2_hi, exact
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, 0 - 48)
    c.code = emit_movsd_xmm0_rbp_disp8(c.code, 0 - 8)
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, 0 - 48)
    c.code = emit_subsd_xmm0_xmm1(c.code)                // x - n*ln2_hi
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, 0 - 16)
    c.code = emit_movsd_xmm0_rbp_disp8(c.code, 0 - 24)
    let p_lo = c.code.len
    c.code = emit_movsd_xmm1_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, p_lo + 4, ln2_lo_off)
    c.code = emit_mulsd_xmm0_xmm1(c.code)                // n * ln2_lo
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, 0 - 48)
    c.code = emit_movsd_xmm0_rbp_disp8(c.code, 0 - 16)
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, 0 - 48)
    c.code = emit_subsd_xmm0_xmm1(c.code)                // r
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, 0 - 16)

    // Horner from the top coefficient down: acc = 1/13!, then acc = 1/k! + r*acc
    let p_top = c.code.len
    c.code = emit_movsd_xmm0_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, p_top + 4, cf[13])
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, 0 - 40)
    var k: i64 = 12
    while k >= 0 {
        c = emit_horner_step(c, 0 - 16, 0 - 40, cf[k as usize])
        k = k - 1
    }

    // result = poly * 2^n, by adding n to the exponent field
    c.code = emit_movsd_xmm0_rbp_disp8(c.code, 0 - 40)
    c.code = emit_movq_rax_xmm0(c.code)
    c.code = emit_store_rax_rbp_disp32(c.code, 0 - 56)
    c.code = emit_load_rbp_disp32_rax(c.code, 0 - 32)
    c.code = emit_mov_reg_imm(c.code, 1, 52)
    c.code = emit_shl_rax_cl(c.code)
    c.code = emit_mov_reg_reg(c.code, 3, 0)
    c.code = emit_load_rbp_disp32_rax(c.code, 0 - 56)
    c.code = emit_add_rax_rbx(c.code)
    c.code = emit_add_rsp_imm32(c.code, 128)
    c.code = emit_pop_rbp(c.code)
    c.code = emit_ret(c.code)
    c
}

// Sprint 119: log builtin — exponent extraction + series approximation
// Algorithm: log(x) = e*ln(2) + 2*f*(1 + f^2/3 + f^4/5 + f^6/7)
// where e = exponent, m = mantissa in [1,2), f = (m-1)/(m+1)
// Stack layout: [rbp-8]=input bits, [rbp-16]=e_f64, [rbp-24]=f, [rbp-32]=f^2
// log builtin (#1626).
//
// Was: m in [1,2), f = (m-1)/(m+1), and the atanh series truncated after f^6/7.
// Two errors:
//
//   truncation    |f| <= 1/3, so the omitted 2*f^9/9 term is 1.1e-5
//   CANCELLATION  x just below 1 lands at e = -1 with m ~ 2, and the result
//                 e*ln2 + log(m) subtracts two values of magnitude 0.693 down
//                 to ~1e-6. log(0.999999) came out as -1.3423e-5 against
//                 -1.0000005e-6 -- thirteen times too large, and no number of
//                 series terms recovers digits cancellation has destroyed.
//
// Now: branch-free centering on 1.5, then 13 terms.
//
//   t = bit 51 of m_bits, i.e. 1 exactly when m >= 1.5
//   m_bits -= t << 52    decrements m's exponent field, so m in [0.75, 1.5)
//   e      += t
//
// f then lies in [-1/7, 1/5] rather than [0, 1/3], u = f^2 <= 0.04, and the
// omitted 2*f*u^13/27 term is 1e-20. Crucially x near 1 now has e = 0 and there
// is no cancellation at all. Cody-Waite on ln2 as well, so e up to 1024 does
// not multiply ln2's own rounding error into the answer.
//
// Stack: [rbp-8]=input bits  [rbp-16]=e_f64  [rbp-24]=f  [rbp-32]=u
//        [rbp-40]=m  [rbp-48]=m-1  [rbp-56]=m+1  [rbp-64]=e  [rbp-72]=m_bits
//        [rbp-80]=t  [rbp-88]=acc  [rbp-96]=log(m)
pub(crate) fn emit_builtin_log(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc

    c.rodata = data_section_add_f64(c.rodata, 0x3FE62E42FEFA3000)   // ln2, high 40 bits
    let ln2_hi_off = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3D53DE6AF278ECE6)   // ln2 - ln2_hi
    let ln2_lo_off = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FF0000000000000)   // 1.0
    let one_off = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x4000000000000000)   // 2.0
    let two_off = c.rodata.last_offset

    // 1/(2k+1) for k = 0..12, indexed by k.
    var dc: [i64; 13] = [0; 13]
    c.rodata = data_section_add_f64(c.rodata, 0x3FF0000000000000)   // 1/1
    dc[0] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FD5555555555555)   // 1/3
    dc[1] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FC999999999999A)   // 1/5
    dc[2] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FC2492492492492)   // 1/7
    dc[3] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FBC71C71C71C71C)   // 1/9
    dc[4] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FB745D1745D1746)   // 1/11
    dc[5] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FB3B13B13B13B14)   // 1/13
    dc[6] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FB1111111111111)   // 1/15
    dc[7] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FAE1E1E1E1E1E1E)   // 1/17
    dc[8] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FAAF286BCA1AF28)   // 1/19
    dc[9] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FA8618618618618)   // 1/21
    dc[10] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FA642C8590B2164)   // 1/23
    dc[11] = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FA47AE147AE147B)   // 1/25
    dc[12] = c.rodata.last_offset

    c.code = emit_push_rbp(c.code)
    c.code = emit_mov_rbp_rsp(c.code)
    c.code = emit_sub_rsp_imm32(c.code, 128)

    c.code = emit_mov_reg_reg(c.code, 0, 7)
    c.code = emit_store_rax_rbp_disp32(c.code, 0 - 8)     // input bits

    // e = ((bits >> 52) & 0x7FF) - 1023
    c.code = emit_mov_reg_imm(c.code, 1, 52)
    var sh1 = c.code
    sh1 = emit_byte(sh1, 0x48)
    sh1 = emit_byte(sh1, 0xD3)
    sh1 = emit_byte(sh1, 0xE8)                            // shr rax, cl
    c.code = sh1
    c.code = emit_mov_reg_imm(c.code, 3, 0x7FF)
    c.code = emit_and_rax_rbx(c.code)
    c.code = emit_mov_reg_imm(c.code, 3, 1023)
    c.code = emit_sub_rax_rbx(c.code)
    c.code = emit_store_rax_rbp_disp32(c.code, 0 - 64)    // e

    // m_bits = (bits & mantissa_mask) | 0x3FF0000000000000  ->  m in [1, 2)
    c.code = emit_load_rbp_disp32_rax(c.code, 0 - 8)
    c.code = emit_mov_reg_imm(c.code, 3, 0x000FFFFFFFFFFFFF)
    c.code = emit_and_rax_rbx(c.code)
    c.code = emit_mov_reg_imm(c.code, 3, 0x3FF0000000000000)
    c.code = emit_or_rax_rbx(c.code)
    c.code = emit_store_rax_rbp_disp32(c.code, 0 - 72)    // m_bits

    // Branch-free centering on 1.5 -- see the header note.
    c.code = emit_mov_reg_imm(c.code, 1, 51)
    var sh2 = c.code
    sh2 = emit_byte(sh2, 0x48)
    sh2 = emit_byte(sh2, 0xD3)
    sh2 = emit_byte(sh2, 0xE8)                            // shr rax, cl
    c.code = sh2
    c.code = emit_mov_reg_imm(c.code, 3, 1)
    c.code = emit_and_rax_rbx(c.code)                     // rax = t
    c.code = emit_store_rax_rbp_disp32(c.code, 0 - 80)
    c.code = emit_mov_reg_imm(c.code, 1, 52)
    c.code = emit_shl_rax_cl(c.code)                      // t << 52
    c.code = emit_mov_reg_reg(c.code, 3, 0)
    c.code = emit_load_rbp_disp32_rax(c.code, 0 - 72)
    c.code = emit_sub_rax_rbx(c.code)                     // m_bits - (t << 52)
    c.code = emit_movq_xmm0_rax(c.code)
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, 0 - 40)    // m in [0.75, 1.5)

    // e_f64 = (e + t) as f64
    c.code = emit_load_rbp_disp32_rax(c.code, 0 - 80)
    c.code = emit_mov_reg_reg(c.code, 3, 0)
    c.code = emit_load_rbp_disp32_rax(c.code, 0 - 64)
    c.code = emit_add_rax_rbx(c.code)
    c.code = emit_cvtsi2sd_xmm0_rax(c.code)
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, 0 - 16)    // e_f64

    // f = (m - 1) / (m + 1)
    c.code = emit_movsd_xmm0_rbp_disp8(c.code, 0 - 40)
    let p_one1 = c.code.len
    c.code = emit_movsd_xmm1_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, p_one1 + 4, one_off)
    c.code = emit_subsd_xmm0_xmm1(c.code)
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, 0 - 48)    // m - 1
    c.code = emit_movsd_xmm0_rbp_disp8(c.code, 0 - 40)
    let p_one2 = c.code.len
    c.code = emit_movsd_xmm1_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, p_one2 + 4, one_off)
    c.code = emit_addsd_xmm0_xmm1(c.code)
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, 0 - 56)    // m + 1
    c.code = emit_movsd_xmm0_rbp_disp8(c.code, 0 - 48)
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, 0 - 56)
    c.code = emit_divsd_xmm0_xmm1(c.code)
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, 0 - 24)    // f

    // u = f*f, then Horner over 1/(2k+1) in u
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, 0 - 24)
    c.code = emit_mulsd_xmm0_xmm1(c.code)
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, 0 - 32)    // u
    let p_top = c.code.len
    c.code = emit_movsd_xmm0_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, p_top + 4, dc[12])
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, 0 - 88)    // acc
    var k: i64 = 11
    while k >= 0 {
        c = emit_horner_step(c, 0 - 32, 0 - 88, dc[k as usize])
        k = k - 1
    }

    // log(m) = 2 * f * P(u)
    c.code = emit_movsd_xmm0_rbp_disp8(c.code, 0 - 88)
    let p_two = c.code.len
    c.code = emit_movsd_xmm1_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, p_two + 4, two_off)
    c.code = emit_mulsd_xmm0_xmm1(c.code)
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, 0 - 24)
    c.code = emit_mulsd_xmm0_xmm1(c.code)
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, 0 - 96)    // log(m)

    // result = e*ln2_hi + (e*ln2_lo + log(m))
    c.code = emit_movsd_xmm0_rbp_disp8(c.code, 0 - 16)
    let p_lo = c.code.len
    c.code = emit_movsd_xmm1_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, p_lo + 4, ln2_lo_off)
    c.code = emit_mulsd_xmm0_xmm1(c.code)
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, 0 - 96)
    c.code = emit_addsd_xmm0_xmm1(c.code)
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, 0 - 96)
    c.code = emit_movsd_xmm0_rbp_disp8(c.code, 0 - 16)
    let p_hi = c.code.len
    c.code = emit_movsd_xmm1_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, p_hi + 4, ln2_hi_off)
    c.code = emit_mulsd_xmm0_xmm1(c.code)
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, 0 - 96)
    c.code = emit_addsd_xmm0_xmm1(c.code)

    c.code = emit_movq_rax_xmm0(c.code)
    c.code = emit_add_rsp_imm32(c.code, 128)
    c.code = emit_pop_rbp(c.code)
    c.code = emit_ret(c.code)
    c
}

// Sprint 121: sin builtin — range reduction + degree-7 minimax polynomial
// Algorithm: sin(x) ≈ x(1 - x²(1/6 - x²(1/120 - x²/5040)))
// Range reduction: n = round(x/(2π)), r = x - n*2π
// Stack layout: [rbp-8]=r, [rbp-16]=r², [rbp-24]=scratch
pub(crate) fn emit_builtin_sin(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc

    // .rodata constants
    c.rodata = data_section_add_f64(c.rodata, 0x401921FB54442D18)   // 2π
    let two_pi_off = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FC45F306DC9C883)   // 1/(2π)
    let inv_two_pi_off = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FF0000000000000)   // 1.0
    let one_off = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FC5555555555555)   // 1/6
    let c3_off = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3F81111111111111)   // 1/120
    let c5_off = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3F2A01A01A01A01A)   // 1/5040
    let c7_off = c.rodata.last_offset
    // Terms through x^13. The series previously stopped at x^7, which is accurate
    // near zero and badly wrong at the ends of the reduced range: after reduction
    // r lies in [-pi, pi], and at r = pi the x^7 truncation error is 7.5e-2. That
    // is what made cos(3.0) return -1.1375 — outside [-1, 1] — and sin(3.0) return
    // 0.091071 against a truth of 0.141120 (#1551).
    //
    // Worst-case truncation error at r = pi, by order: x^7 7.5e-2, x^9 6.9e-3,
    // x^11 4.5e-4, x^13 2.1e-5. Three more terms buy three and a half decimal
    // digits across the whole reduced range and cost three multiply-adds.
    c.rodata = data_section_add_f64(c.rodata, 0x3EC71DE3A556C734)   // 1/362880   (9!)
    let c9_off = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3E5AE64567F544E4)   // 1/39916800 (11!)
    let c11_off = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3DE6124613A86D09)   // 1/6227020800 (13!)
    let c13_off = c.rodata.last_offset

    c.code = emit_push_rbp(c.code)
    c.code = emit_mov_rbp_rsp(c.code)
    c.code = emit_sub_rsp_imm32(c.code, 48)

    // rdi = f64 bit pattern of x
    c.code = emit_mov_reg_reg(c.code, 0, 7)           // mov rax, rdi
    c.code = emit_movq_xmm0_rax(c.code)               // xmm0 = x

    // Step 1: Range reduction — n = round(x/(2π)), r = x - n*2π
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, -24)   // [rbp-24] = x (save)
    let sin_inv2pi = c.code.len
    c.code = emit_movsd_xmm1_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, sin_inv2pi + 4, inv_two_pi_off)
    c.code = emit_mulsd_xmm0_xmm1(c.code)             // xmm0 = x/(2π)
    c.code = emit_cvtsd2si_rax_xmm0(c.code)           // rax = round(x/(2π))
    c.code = emit_cvtsi2sd_xmm0_rax(c.code)           // xmm0 = n (as f64)
    let sin_2pi = c.code.len
    c.code = emit_movsd_xmm1_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, sin_2pi + 4, two_pi_off)
    c.code = emit_mulsd_xmm0_xmm1(c.code)             // xmm0 = n*2π
    // r = x - n*2π
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, -32)   // [rbp-32] = n*2π
    c.code = emit_movsd_xmm0_rbp_disp8(c.code, -24)   // xmm0 = x
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -32)   // xmm1 = n*2π
    c.code = emit_subsd_xmm0_xmm1(c.code)             // xmm0 = r = x - n*2π

    // Store r and compute r²
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, -8)    // [rbp-8] = r
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, -24)   // [rbp-24] = r (copy for mul)
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -24)   // xmm1 = r
    c.code = emit_mulsd_xmm0_xmm1(c.code)             // xmm0 = r²
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, -16)   // [rbp-16] = r²

    // Step 2: Horner —
    //   sin(x) = r(1 - r²(1/6 - r²(1/120 - r²(1/5040 - r²(1/9!
    //                - r²(1/11! - r²/13!))))))
    // Innermost: s = 1/13!
    let sin_c13 = c.code.len
    c.code = emit_movsd_xmm0_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, sin_c13 + 4, c13_off)
    // s = 1/11! - r² * s
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -16)   // xmm1 = r²
    c.code = emit_mulsd_xmm0_xmm1(c.code)
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, -24)   // save
    let sin_c11 = c.code.len
    c.code = emit_movsd_xmm0_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, sin_c11 + 4, c11_off)
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -24)
    c.code = emit_subsd_xmm0_xmm1(c.code)
    // s = 1/9! - r² * s
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -16)   // xmm1 = r²
    c.code = emit_mulsd_xmm0_xmm1(c.code)
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, -24)   // save
    let sin_c9 = c.code.len
    c.code = emit_movsd_xmm0_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, sin_c9 + 4, c9_off)
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -24)
    c.code = emit_subsd_xmm0_xmm1(c.code)
    // s = 1/5040 - r² * s
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -16)   // xmm1 = r²
    c.code = emit_mulsd_xmm0_xmm1(c.code)
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, -24)   // save
    let sin_c7 = c.code.len
    c.code = emit_movsd_xmm0_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, sin_c7 + 4, c7_off)
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -24)
    c.code = emit_subsd_xmm0_xmm1(c.code)
    // s = 1/120 - r² * s
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -16)   // xmm1 = r²
    c.code = emit_mulsd_xmm0_xmm1(c.code)             // xmm0 = r²/5040
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, -24)   // save
    let sin_c5 = c.code.len
    c.code = emit_movsd_xmm0_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, sin_c5 + 4, c5_off)
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -24)   // xmm1 = r²/5040
    c.code = emit_subsd_xmm0_xmm1(c.code)             // xmm0 = 1/120 - r²/5040
    // s = 1/6 - r² * s
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -16)   // xmm1 = r²
    c.code = emit_mulsd_xmm0_xmm1(c.code)             // xmm0 = r²*(1/120 - r²/5040)
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, -24)   // save
    let sin_c3 = c.code.len
    c.code = emit_movsd_xmm0_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, sin_c3 + 4, c3_off)
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -24)   // xmm1 = r²*(...)
    c.code = emit_subsd_xmm0_xmm1(c.code)             // xmm0 = 1/6 - r²*(...)
    // s = 1 - r² * s
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -16)   // xmm1 = r²
    c.code = emit_mulsd_xmm0_xmm1(c.code)             // xmm0 = r²*(1/6 - ...)
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, -24)   // save
    let sin_one = c.code.len
    c.code = emit_movsd_xmm0_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, sin_one + 4, one_off)
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -24)   // xmm1 = r²*(...)
    c.code = emit_subsd_xmm0_xmm1(c.code)             // xmm0 = 1 - r²*(...)
    // result = r * s
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -8)    // xmm1 = r
    c.code = emit_mulsd_xmm0_xmm1(c.code)             // xmm0 = sin(x)

    // Return as bit pattern in rax
    c.code = emit_movq_rax_xmm0(c.code)
    c.code = emit_add_rsp_imm32(c.code, 48)
    c.code = emit_pop_rbp(c.code)
    c.code = emit_ret(c.code)
    c
}

// Sprint 121: cos builtin — range reduction + degree-6 minimax polynomial
// Algorithm: cos(x) ≈ 1 - x²(1/2 - x²(1/24 - x²/720))
// Same range reduction as sin, same stack layout
pub(crate) fn emit_builtin_cos(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc

    // .rodata constants
    c.rodata = data_section_add_f64(c.rodata, 0x401921FB54442D18)   // 2π
    let cos_two_pi_off = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FC45F306DC9C883)   // 1/(2π)
    let cos_inv_two_pi_off = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FF0000000000000)   // 1.0
    let cos_one_off = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FE0000000000000)   // 1/2
    let cos_c2_off = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3FA5555555555555)   // 1/24
    let cos_c4_off = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3F56C16C16C16C17)   // 1/720
    let cos_c6_off = c.rodata.last_offset
    // Terms through x^12, for the same reason as sin: the series stopped at x^6,
    // whose truncation error at the end of the reduced range (r = pi) is 2.1e-1.
    // That is what made cos(3.0) return -1.1375 — outside [-1, 1] (#1551).
    // By order at r = pi: x^6 2.1e-1, x^8 2.4e-2, x^10 1.8e-3, x^12 1.0e-4.
    c.rodata = data_section_add_f64(c.rodata, 0x3EFA01A01A01A01A)   // 1/40320      (8!)
    let cos_c8_off = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3E927E4FB7789F5C)   // 1/3628800    (10!)
    let cos_c10_off = c.rodata.last_offset
    c.rodata = data_section_add_f64(c.rodata, 0x3E21EED8EFF8D898)   // 1/479001600  (12!)
    let cos_c12_off = c.rodata.last_offset

    c.code = emit_push_rbp(c.code)
    c.code = emit_mov_rbp_rsp(c.code)
    c.code = emit_sub_rsp_imm32(c.code, 48)

    // rdi = f64 bit pattern of x
    c.code = emit_mov_reg_reg(c.code, 0, 7)           // mov rax, rdi
    c.code = emit_movq_xmm0_rax(c.code)               // xmm0 = x

    // Step 1: Range reduction (same as sin)
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, -24)   // [rbp-24] = x
    let cos_inv2pi = c.code.len
    c.code = emit_movsd_xmm1_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, cos_inv2pi + 4, cos_inv_two_pi_off)
    c.code = emit_mulsd_xmm0_xmm1(c.code)             // xmm0 = x/(2π)
    c.code = emit_cvtsd2si_rax_xmm0(c.code)           // rax = round(x/(2π))
    c.code = emit_cvtsi2sd_xmm0_rax(c.code)           // xmm0 = n
    let cos_2pi = c.code.len
    c.code = emit_movsd_xmm1_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, cos_2pi + 4, cos_two_pi_off)
    c.code = emit_mulsd_xmm0_xmm1(c.code)             // xmm0 = n*2π
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, -32)   // [rbp-32] = n*2π
    c.code = emit_movsd_xmm0_rbp_disp8(c.code, -24)   // xmm0 = x
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -32)   // xmm1 = n*2π
    c.code = emit_subsd_xmm0_xmm1(c.code)             // xmm0 = r

    // Compute r²
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, -8)    // [rbp-8] = r
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, -24)   // copy for mul
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -24)   // xmm1 = r
    c.code = emit_mulsd_xmm0_xmm1(c.code)             // xmm0 = r²
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, -16)   // [rbp-16] = r²

    // Step 2: Horner —
    //   cos(x) = 1 - r²(1/2 - r²(1/24 - r²(1/720 - r²(1/8! - r²(1/10! - r²/12!)))))
    // Innermost: s = 1/12!
    let cos_c12 = c.code.len
    c.code = emit_movsd_xmm0_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, cos_c12 + 4, cos_c12_off)
    // s = 1/10! - r² * s
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -16)   // xmm1 = r²
    c.code = emit_mulsd_xmm0_xmm1(c.code)
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, -24)   // save
    let cos_c10 = c.code.len
    c.code = emit_movsd_xmm0_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, cos_c10 + 4, cos_c10_off)
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -24)
    c.code = emit_subsd_xmm0_xmm1(c.code)
    // s = 1/8! - r² * s
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -16)   // xmm1 = r²
    c.code = emit_mulsd_xmm0_xmm1(c.code)
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, -24)   // save
    let cos_c8 = c.code.len
    c.code = emit_movsd_xmm0_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, cos_c8 + 4, cos_c8_off)
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -24)
    c.code = emit_subsd_xmm0_xmm1(c.code)
    // s = 1/720 - r² * s
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -16)   // xmm1 = r²
    c.code = emit_mulsd_xmm0_xmm1(c.code)
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, -24)   // save
    let cos_c6 = c.code.len
    c.code = emit_movsd_xmm0_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, cos_c6 + 4, cos_c6_off)
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -24)
    c.code = emit_subsd_xmm0_xmm1(c.code)
    // s = 1/24 - r² * s
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -16)   // xmm1 = r²
    c.code = emit_mulsd_xmm0_xmm1(c.code)             // xmm0 = r²/720
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, -24)   // save
    let cos_c4 = c.code.len
    c.code = emit_movsd_xmm0_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, cos_c4 + 4, cos_c4_off)
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -24)
    c.code = emit_subsd_xmm0_xmm1(c.code)             // xmm0 = 1/24 - r²/720
    // s = 1/2 - r² * s
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -16)   // xmm1 = r²
    c.code = emit_mulsd_xmm0_xmm1(c.code)             // xmm0 = r²*(1/24 - r²/720)
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, -24)   // save
    let cos_c2 = c.code.len
    c.code = emit_movsd_xmm0_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, cos_c2 + 4, cos_c2_off)
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -24)
    c.code = emit_subsd_xmm0_xmm1(c.code)             // xmm0 = 1/2 - r²*(...)
    // result = 1 - r² * s
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -16)   // xmm1 = r²
    c.code = emit_mulsd_xmm0_xmm1(c.code)             // xmm0 = r²*(1/2 - ...)
    c.code = emit_movsd_rbp_disp8_xmm0(c.code, -24)   // save
    let cos_one = c.code.len
    c.code = emit_movsd_xmm0_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, cos_one + 4, cos_one_off)
    c.code = emit_movsd_xmm1_rbp_disp8(c.code, -24)
    c.code = emit_subsd_xmm0_xmm1(c.code)             // xmm0 = cos(x)

    // Return as bit pattern in rax
    c.code = emit_movq_rax_xmm0(c.code)
    c.code = emit_add_rsp_imm32(c.code, 48)
    c.code = emit_pop_rbp(c.code)
    c.code = emit_ret(c.code)
    c
}

// Sprint 118: print_f64 builtin — f64 → stdout, fraction rounded (#1573)
pub(crate) fn emit_builtin_print_f64(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc

    // Store 1e6 constant in .rodata
    c.rodata = data_section_add_f64(c.rodata, 0x412E848000000000)
    let rodata_1e6_offset = c.rodata.last_offset

    c.code = emit_push_rbp(c.code)
    c.code = emit_mov_rbp_rsp(c.code)
    c.code = emit_sub_rsp_imm32(c.code, 64)

    // rdi = f64 bit pattern
    c.code = emit_mov_reg_reg(c.code, 0, 7)           // mov rax, rdi
    c.code = emit_movq_xmm0_rax(c.code)               // movq xmm0, rax

    // Sign check: test rdi, rdi; jns skip_neg
    c.code = emit_test_rdi_rdi(c.code)
    let jns_pos = c.code.len
    c.code = emit_jns_rel8(c.code, 0)                 // placeholder

    // Negative path: emit '-'
    var cb1 = c.code
    cb1 = emit_byte(cb1, 0xc6)                         // mov byte [rbp-33], '-'
    cb1 = emit_byte(cb1, 0x45)
    cb1 = emit_byte(cb1, 0xdf)
    cb1 = emit_byte(cb1, 0x2d)
    c.code = cb1
    var cb2 = c.code
    cb2 = emit_byte(cb2, 0x48)                         // lea rsi, [rbp-33]
    cb2 = emit_byte(cb2, 0x8d)
    cb2 = emit_byte(cb2, 0x75)
    cb2 = emit_byte(cb2, 0xdf)
    c.code = cb2
    c.code = emit_mov_reg_imm(c.code, 2, 1)           // mov rdx, 1
    c = emit_load_runtime_context_field_rdi(c, runtime_context_field_stdout_fd())
    c = emit_write_syscall_for_target(c, c.target_os_id)

    // Clear sign bit. rdi was overwritten with stdout fd for the '-' write;
    // xmm0 still holds the original f64 bits across the syscall.
    // Reloading from rdi zeroed every negative magnitude → printed "-0.000000".
    c.code = emit_movq_rax_xmm0(c.code)               // movq rax, xmm0
    c.code = emit_mov_reg_imm(c.code, 3, 0x7FFFFFFFFFFFFFFF)
    c.code = emit_and_rax_rbx(c.code)
    c.code = emit_mov_reg_reg(c.code, 7, 0)           // mov rdi, rax
    c.code = emit_movq_xmm0_rax(c.code)

    // Patch jns displacement
    let neg_block_len = c.code.len - (jns_pos + 2)
    if jns_pos + 1 < nc_code_capacity_bytes() {
        NC_BIG_CODE[(jns_pos + 1) as usize] = low8(neg_block_len) as i8
    }

    // Integer part: cvttsd2si
    c.code = emit_movq_rax_xmm0(c.code)
    c.code = emit_store_rax_rbp_disp32(c.code, -48)   // save f64 bits
    c.code = emit_movq_xmm0_rax(c.code)
    c.code = emit_cvttsd2si_rax_xmm0(c.code)
    c.code = emit_store_rax_rbp_disp32(c.code, -56)   // save int_part

    // Fractional part
    c.code = emit_load_rbp_disp32_rax(c.code, -48)
    c.code = emit_movq_xmm0_rax(c.code)
    c.code = emit_load_rbp_disp32_rax(c.code, -56)
    // cvtsi2sd xmm1, rax (F2 48 0F 2A C8)
    var cb5 = c.code
    cb5 = emit_byte(cb5, 0xF2)
    cb5 = emit_byte(cb5, 0x48)
    cb5 = emit_byte(cb5, 0x0F)
    cb5 = emit_byte(cb5, 0x2A)
    cb5 = emit_byte(cb5, 0xC8)
    c.code = cb5

    c.code = emit_subsd_xmm0_xmm1(c.code)

    // Load 1e6 from .rodata
    let movsd1_pos = c.code.len
    c.code = emit_movsd_xmm1_rip_disp32(c.code, 0)
    c.relocs = add_rip_reloc(c.relocs, movsd1_pos + 4, rodata_1e6_offset)

    c.code = emit_mulsd_xmm0_xmm1(c.code)
    // Round, do not truncate. cvttsd2si biases every printed value downward by
    // up to one unit in the last digit: 5.76 printed 5.759999, 2.675 printed
    // 2.674999 (#1573). The integer part above still uses the truncating form,
    // which is correct there and preserves the printable range (values up to
    // ~9.2e18 still print; scaling the WHOLE number by 1e6 first would have
    // capped it at ~9.2e12 and regressed 1e13 and 1e15, which print exactly
    // today).
    c.code = emit_cvtsd2si_rax_xmm0(c.code)

    // Ensure non-negative
    c.code = emit_test_rax_rax(c.code)
    c.code = emit_jns_rel8(c.code, 3)
    c.code = emit_xor_rax_rax(c.code)

    // Carry. Rounding can lift the fraction to exactly 1000000 -- 0.9999995
    // is the smallest case. The 6-digit itoa below emits only six digits, so
    // an un-carried 1000000 would print as 0.000000: strictly worse than the
    // truncation this replaces. Subtract the decade and bump the integer part,
    // which has NOT been written yet -- that is why the integer itoa and the
    // '.' now follow this block instead of preceding it.
    c.code = emit_mov_reg_imm(c.code, 3, 1000000)     // mov rbx, 1000000
    c.code = emit_sub_rax_rbx(c.code)                 // rax -= 1000000
    c.code = emit_test_rax_rax(c.code)
    let carry_jns_pos = c.code.len
    c.code = emit_jns_rel8(c.code, 0)                 // >= 0 means it carried
    c.code = emit_add_rax_rbx(c.code)                 // no carry: restore
    let carry_jmp_pos = c.code.len
    c.code = emit_jmp_rel8(c.code, 0)
    let carry_target = c.code.len
    var cbc = c.code                                  // inc qword [rbp-56]
    cbc = emit_byte(cbc, 0x48)
    cbc = emit_byte(cbc, 0xFF)
    cbc = emit_byte(cbc, 0x45)
    cbc = emit_byte(cbc, 0xC8)
    c.code = cbc
    if carry_jns_pos + 1 < nc_code_capacity_bytes() {
        NC_BIG_CODE[(carry_jns_pos + 1) as usize] = low8(carry_target - (carry_jns_pos + 2)) as i8
    }
    if carry_jmp_pos + 1 < nc_code_capacity_bytes() {
        NC_BIG_CODE[(carry_jmp_pos + 1) as usize] = low8(c.code.len - (carry_jmp_pos + 2)) as i8
    }

    // Park the fraction; the integer itoa below needs rax.
    c.code = emit_store_rax_rbp_disp32(c.code, -64)

    // itoa for integer part. Reloaded because the fraction computation above
    // now runs first and leaves its own result in rax.
    c.code = emit_load_rbp_disp32_rax(c.code, -56)
    c.code = emit_mov_reg_reg(c.code, 6, 5)           // mov rsi, rbp
    c.code = emit_sub_rsi_imm8(c.code, 1)
    c.code = emit_xor_rcx_rcx(c.code)

    c.code = emit_xor_rdx_rdx(c.code)
    c.code = emit_mov_reg_imm(c.code, 3, 10)
    c.code = emit_div_rbx(c.code)
    c.code = emit_add_rdx_imm8(c.code, 48)
    c.code = emit_mov_byte_mem_rsi_dl(c.code)
    c.code = emit_dec_rsi(c.code)
    c.code = emit_inc_rcx(c.code)
    c.code = emit_test_rax_rax(c.code)
    c.code = emit_jnz_rel8(c.code, -30)

    c.code = emit_inc_rsi(c.code)
    c.code = emit_mov_reg_reg(c.code, 2, 1)           // mov rdx, rcx
    c = emit_load_runtime_context_field_rdi(c, runtime_context_field_stdout_fd())
    c = emit_write_syscall_for_target(c, c.target_os_id)

    // Print '.'
    var cb3 = c.code
    cb3 = emit_byte(cb3, 0xc6)
    cb3 = emit_byte(cb3, 0x45)
    cb3 = emit_byte(cb3, 0xdf)
    cb3 = emit_byte(cb3, 0x2e)
    c.code = cb3
    var cb4 = c.code
    cb4 = emit_byte(cb4, 0x48)
    cb4 = emit_byte(cb4, 0x8d)
    cb4 = emit_byte(cb4, 0x75)
    cb4 = emit_byte(cb4, 0xdf)
    c.code = cb4
    c.code = emit_mov_reg_imm(c.code, 2, 1)
    c = emit_load_runtime_context_field_rdi(c, runtime_context_field_stdout_fd())
    c = emit_write_syscall_for_target(c, c.target_os_id)

    // 6-digit fixed-width itoa (unrolled), reading the parked fraction.
    c.code = emit_load_rbp_disp32_rax(c.code, -64)
    c.code = emit_mov_reg_reg(c.code, 6, 5)           // mov rsi, rbp
    c.code = emit_sub_rsi_imm8(c.code, 3)

    // iter 1
    c.code = emit_xor_rdx_rdx(c.code)
    c.code = emit_mov_reg_imm(c.code, 3, 10)
    c.code = emit_div_rbx(c.code)
    c.code = emit_add_rdx_imm8(c.code, 48)
    c.code = emit_mov_byte_mem_rsi_dl(c.code)
    c.code = emit_dec_rsi(c.code)
    // iter 2
    c.code = emit_xor_rdx_rdx(c.code)
    c.code = emit_mov_reg_imm(c.code, 3, 10)
    c.code = emit_div_rbx(c.code)
    c.code = emit_add_rdx_imm8(c.code, 48)
    c.code = emit_mov_byte_mem_rsi_dl(c.code)
    c.code = emit_dec_rsi(c.code)
    // iter 3
    c.code = emit_xor_rdx_rdx(c.code)
    c.code = emit_mov_reg_imm(c.code, 3, 10)
    c.code = emit_div_rbx(c.code)
    c.code = emit_add_rdx_imm8(c.code, 48)
    c.code = emit_mov_byte_mem_rsi_dl(c.code)
    c.code = emit_dec_rsi(c.code)
    // iter 4
    c.code = emit_xor_rdx_rdx(c.code)
    c.code = emit_mov_reg_imm(c.code, 3, 10)
    c.code = emit_div_rbx(c.code)
    c.code = emit_add_rdx_imm8(c.code, 48)
    c.code = emit_mov_byte_mem_rsi_dl(c.code)
    c.code = emit_dec_rsi(c.code)
    // iter 5
    c.code = emit_xor_rdx_rdx(c.code)
    c.code = emit_mov_reg_imm(c.code, 3, 10)
    c.code = emit_div_rbx(c.code)
    c.code = emit_add_rdx_imm8(c.code, 48)
    c.code = emit_mov_byte_mem_rsi_dl(c.code)
    c.code = emit_dec_rsi(c.code)
    // iter 6
    c.code = emit_xor_rdx_rdx(c.code)
    c.code = emit_mov_reg_imm(c.code, 3, 10)
    c.code = emit_div_rbx(c.code)
    c.code = emit_add_rdx_imm8(c.code, 48)
    c.code = emit_mov_byte_mem_rsi_dl(c.code)

    // sys_write 6 fractional digits
    c.code = emit_mov_reg_reg(c.code, 6, 5)           // mov rsi, rbp
    c.code = emit_sub_rsi_imm8(c.code, 8)
    c.code = emit_mov_reg_imm(c.code, 2, 6)
    c = emit_load_runtime_context_field_rdi(c, runtime_context_field_stdout_fd())
    c = emit_write_syscall_for_target(c, c.target_os_id)

    // Epilogue
    c.code = emit_mov_rsp_rbp(c.code)
    c.code = emit_pop_rbp(c.code)
    c.code = emit_ret(c.code)
    c
}

fn emit_builtin_file_size(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    c.code = emit_push_rbp(c.code)
    c.code = emit_mov_rbp_rsp(c.code)
    // Allocate 160 bytes for stat buffer (144 + padding for alignment)
    c.code = emit_sub_rsp_imm32(c.code, 160)

    // stat(path, statbuf)
    // rdi already = path
    c.code = emit_lea_rsi_rsp(c.code)                    // rsi = rsp (stat buffer)
    c = emit_stat_syscall_for_target(c, c.target_os_id)

    // Check for error
    c.code = emit_test_rax_rax(c.code)
    // stat error (rax != 0) → return rax (negative errno). Directory (st_mode
    // S_IFDIR at offset 24) → -1 so file_exists()==false (a directory is never a
    // valid source/import file). Otherwise load st_size at offset 48. Mirrors the
    // lean_single emit_file_size directory guard. Fixed-size block, hand-computed
    // relative jumps (block spans 32 bytes; targets: err/done = +32, dir = the
    // `mov rax,-1`). Verified byte-exact vs a reference assembler.
    c.code = emit_byte(c.code, 0x75); c.code = emit_byte(c.code, 0x1e)  // jnz +30 (stat error → return rax)
    c.code = emit_byte(c.code, 0x8b); c.code = emit_byte(c.code, 0x44); c.code = emit_byte(c.code, 0x24); c.code = emit_byte(c.code, 0x18)  // mov eax,[rsp+24] (st_mode)
    c.code = emit_byte(c.code, 0x25); c.code = emit_byte(c.code, 0x00); c.code = emit_byte(c.code, 0xf0); c.code = emit_byte(c.code, 0x00); c.code = emit_byte(c.code, 0x00)  // and eax,0xF000 (S_IFMT)
    c.code = emit_byte(c.code, 0x3d); c.code = emit_byte(c.code, 0x00); c.code = emit_byte(c.code, 0x40); c.code = emit_byte(c.code, 0x00); c.code = emit_byte(c.code, 0x00)  // cmp eax,0x4000 (S_IFDIR)
    c.code = emit_byte(c.code, 0x74); c.code = emit_byte(c.code, 0x07)  // je +7 (directory → -1)
    c.code = emit_byte(c.code, 0x48); c.code = emit_byte(c.code, 0x8b); c.code = emit_byte(c.code, 0x44); c.code = emit_byte(c.code, 0x24); c.code = emit_byte(c.code, 0x30)  // mov rax,[rsp+48] (st_size)
    c.code = emit_byte(c.code, 0xeb); c.code = emit_byte(c.code, 0x07)  // jmp +7 (done)
    c.code = emit_byte(c.code, 0x48); c.code = emit_byte(c.code, 0xc7); c.code = emit_byte(c.code, 0xc0); c.code = emit_byte(c.code, 0xff); c.code = emit_byte(c.code, 0xff); c.code = emit_byte(c.code, 0xff); c.code = emit_byte(c.code, 0xff)  // mov rax,-1 (directory)

    c.code = emit_mov_rsp_rbp(c.code)
    c.code = emit_pop_rbp(c.code)
    c.code = emit_ret(c.code)
    c
}

// ============================================================================
// Module compilation
// ============================================================================

pub fn compile_module_streaming_begin_into(nc: &! NativeCompiler, module: &IrModule) with Mut, Panic, Div, Alloc {
    (*nc).fn_count = module.fn_count
    (*nc).runtime_context_slot_offset = 0
    let runtime_slot_size = runtime_context_global_slot_size()
    (*nc).prof_counter_data_base = runtime_slot_size
    (*nc).descriptor_data_offset = -1
    (*nc).descriptor_count = 0
    (*nc).gc_state_data_offset = -1
    (*nc).stack_map_data_offset = -1
    (*nc).deopt_state_data_offset = -1
    (*nc).stack_map_record_count = 0
    (*nc).safepoint_count = 0
    (*nc).deopt_point_count = 0
    var module_data = (*nc).data
    module_data.len = runtime_slot_size + (module.prof_counter_count * 8)
    (*nc).data = module_data
}

pub fn compile_module_streaming_begin_count_into(nc: &! NativeCompiler, fn_count: i64) with Mut, Panic, Div, Alloc {
    (*nc).fn_count = fn_count
    (*nc).runtime_context_slot_offset = 0
    let runtime_slot_size = runtime_context_global_slot_size()
    (*nc).prof_counter_data_base = runtime_slot_size
    (*nc).prof_counter_count = 0
    (*nc).descriptor_data_offset = -1
    (*nc).descriptor_count = 0
    (*nc).gc_state_data_offset = -1
    (*nc).stack_map_data_offset = -1
    (*nc).deopt_state_data_offset = -1
    (*nc).stack_map_record_count = 0
    (*nc).safepoint_count = 0
    (*nc).deopt_point_count = 0
    var module_data = (*nc).data
    module_data.len = runtime_slot_size
    (*nc).data = module_data
}

pub fn compile_module_streaming_begin(nc: NativeCompiler, module: &IrModule) -> NativeCompiler with Mut, Panic, Div, Alloc {
    var c = nc
    compile_module_streaming_begin_into(&! c, module)
    c
}

pub fn compile_module_streaming_finish_into(nc: &! NativeCompiler, module: &IrModule) with Mut, Panic, Div, Alloc {
    if module.prof_counter_count > 0 {
        // #1547: keep profiler names in the same rodata store the rest of the
        // compile used. String literals and persisted builtin constants in this
        // lane live in the flat rodata (NC_BIG_RODATA), and the final ELF writer
        // emits the flat buffer exclusively whenever flat_rodata_len > 0 — inline
        // bytes written here would be dropped and their relocs would alias flat
        // content. Fall back to the inline table only when flat is still empty.
        let use_flat_rodata = (*nc).flat_rodata_len > 0
        var pi = 0
        while pi < module.prof_counter_count {
            let pc = module.prof_counters[pi as usize]
            if use_flat_rodata {
                (*nc).prof_counter_names[pi as usize] = nc_rodata_add_name_value(nc, pc.fn_name)
            } else {
                (*nc).rodata = string_table_add((*nc).rodata, pc.fn_name.buf, pc.fn_name.len)
                (*nc).prof_counter_names[pi as usize] = (*nc).rodata.last_offset
            }
            pi = pi + 1
        }
        (*nc).prof_counter_count = module.prof_counter_count

        // Sprint 47: store "profile.sprof" filename in .rodata
        let sprof_name = make_sprof_filename()
        if use_flat_rodata {
            (*nc).prof_sprof_name_offset = nc_rodata_add_name_value(nc, sprof_name)
        } else {
            (*nc).rodata = string_table_add((*nc).rodata, sprof_name.buf, sprof_name.len)
            (*nc).prof_sprof_name_offset = (*nc).rodata.last_offset
        }
    }

    // Sprint 46: emit __prof_dump function (if counters exist)
    if (*nc).prof_counter_count > 0 {
        (*nc).prof_dump_fn_index = (*nc).fn_count
        native_compiler_set_fn_offset(nc, (*nc).fn_count, (*nc).code.len)
        (*nc).fn_count = (*nc).fn_count + 1
        (*nc) = emit_prof_dump_function((*nc), module)
    }

    // The streaming Core-IR path has no precise root locations yet, so its
    // stack-map record count remains zero. It must still publish descriptors
    // and GC-state storage through the same persistent .data path used by the
    // Machine-IR pipeline; a future Core collector can then consume real
    // runtime metadata instead of a private compiler-only blob.
    native_v2_emit_runtime_metadata_into(nc)

    // Pass 2: Emit entry trampoline (_start: call main; sys_exit)
    let main_idx = find_main_index(module)
    if main_idx >= 0 {
        emit_entry_trampoline_split_into(nc, main_idx)
    }

    // Pass 3: Apply relocations (function calls + RIP-relative data + .data counters)
    let text_file_offset = 4096
    let rodata_file_offset = align_page(text_file_offset + (*nc).code.len)
    let min_data_len = (*nc).prof_counter_data_base + ((*nc).prof_counter_count * 8)
    let effective_data_len = if (*nc).data.len < min_data_len { min_data_len } else { (*nc).data.len }
    let effective_rodata_len = if (*nc).flat_rodata_len > 0 { (*nc).flat_rodata_len } else { (*nc).rodata.len }
    let data_file_offset = if effective_data_len > 0 {
        align_page(rodata_file_offset + effective_rodata_len)
    } else { 0 }
    (*nc).code = apply_relocations((*nc).relocs, (*nc).code, (*nc).fn_offsets, (*nc).fn_count, rodata_file_offset, data_file_offset)
}

fn native_v2_reloc_is_call_patch(nc: &NativeCompiler, patch_offset: i64) -> bool with Panic, Div {
    patch_offset > 0 && patch_offset + 4 <= (*nc).code.len
        && NC_BIG_CODE[(patch_offset - 1) as usize] == (0xe8 as i8)
}

fn native_v2_reloc_is_rip_disp_patch(nc: &NativeCompiler, patch_offset: i64) -> bool with Panic, Div {
    if !(patch_offset >= 3 && patch_offset + 4 <= (*nc).code.len) { return false }
    if patch_offset >= 4
        && NC_BIG_CODE[(patch_offset - 4) as usize] == (0xf2 as i8)
        && NC_BIG_CODE[(patch_offset - 3) as usize] == (0x0f as i8)
        && NC_BIG_CODE[(patch_offset - 2) as usize] == (0x10 as i8) {
        let sse_modrm = NC_BIG_CODE[(patch_offset - 1) as usize]
        if sse_modrm == (0x05 as i8) || sse_modrm == (0x0d as i8) {
            return true
        }
    }
    if NC_BIG_CODE[(patch_offset - 3) as usize] != (0x48 as i8) { return false }
    let op = NC_BIG_CODE[(patch_offset - 2) as usize]
    let modrm = NC_BIG_CODE[(patch_offset - 1) as usize]
    (op == (0x8d as i8) && modrm == (0x05 as i8))
        || (op == (0x8b as i8) && modrm == (0x1d as i8))
        || (op == (0x89 as i8) && modrm == (0x05 as i8))
}

fn apply_relocations_into(nc: &! NativeCompiler, rodata_file_offset: i64, data_file_offset: i64) with Mut, Panic, Div {
    var i = 0
    while i < (*nc).flat_reloc_count && i < nc_flat_reloc_capacity() {
        let patch_offset = NC_FLAT_RELOC_OFFSETS[i as usize]
        let kind_code = NC_FLAT_RELOC_KIND_CODES[i as usize]
        let is_function = NC_FLAT_RELOC_IS_FUNCTIONS[i as usize]
        let target_index = NC_FLAT_RELOC_TARGET_INDICES[i as usize]

        if kind_code == 1 && native_v2_reloc_is_call_patch(nc, patch_offset) {
            if is_function == 1 {
                let target_idx = target_index
                if target_idx >= 0 && target_idx < (*nc).fn_count {
                    let target_offset = (*nc).fn_offsets[target_idx as usize]
                    let rel32 = target_offset - (patch_offset + 4)
                    nc_patch_u32_le(nc, patch_offset, rel32)
                }
            }
        } else if kind_code == 2 && native_v2_reloc_is_rip_disp_patch(nc, patch_offset) {
            let str_offset = target_index
            let text_file_offset = 4096
            let lea_next_ip = text_file_offset + patch_offset + 4
            let string_va = rodata_file_offset + str_offset
            let disp32 = string_va - lea_next_ip
            nc_patch_u32_le(nc, patch_offset, disp32)
        } else if kind_code == 3 && native_v2_reloc_is_rip_disp_patch(nc, patch_offset) {
            let data_off = target_index
            let text_file_offset2 = 4096
            let next_ip = text_file_offset2 + patch_offset + 4
            let counter_va = data_file_offset + data_off
            let disp32_data = counter_va - next_ip
            nc_patch_u32_le(nc, patch_offset, disp32_data)
        } else if kind_code == 4 && native_v2_reloc_is_rip_disp_patch(nc, patch_offset) {
            let target_idx = target_index
            if target_idx >= 0 && target_idx < (*nc).fn_count {
                let fn_off = (*nc).fn_offsets[target_idx as usize]
                let disp32_fn = fn_off - (patch_offset + 4)
                nc_patch_u32_le(nc, patch_offset, disp32_fn)
            }
        }

        i = i + 1
    }
}

pub fn compile_module_streaming_finish_main_into(nc: &! NativeCompiler, main_fn_index: i64) with Mut, Panic, Div, Alloc {
    if main_fn_index >= 0 {
        emit_entry_trampoline_split_into(nc, main_fn_index)
    }

    let text_file_offset = 4096
    let rodata_file_offset = align_page(text_file_offset + (*nc).code.len)
    let min_data_len = (*nc).prof_counter_data_base + ((*nc).prof_counter_count * 8)
    let effective_data_len = if (*nc).data.len < min_data_len { min_data_len } else { (*nc).data.len }
    let data_file_offset = if effective_data_len > 0 {
        align_page(rodata_file_offset + (*nc).rodata.len)
    } else { 0 }
    apply_relocations_into(nc, rodata_file_offset, data_file_offset)
}

pub fn compile_module_streaming_finish_main_rodata_len_into(nc: &! NativeCompiler, main_fn_index: i64, rodata_len: i64) with Mut, Panic, Div, Alloc {
    if main_fn_index >= 0 {
        emit_entry_trampoline_split_into(nc, main_fn_index)
    }

    let text_file_offset = 4096
    let rodata_file_offset = align_page(text_file_offset + (*nc).code.len)
    let min_data_len = (*nc).prof_counter_data_base + ((*nc).prof_counter_count * 8)
    let effective_data_len = if (*nc).data.len < min_data_len { min_data_len } else { (*nc).data.len }
    let data_file_offset = if effective_data_len > 0 {
        align_page(rodata_file_offset + rodata_len)
    } else { 0 }
    apply_relocations_into(nc, rodata_file_offset, data_file_offset)
}

pub fn compile_module_streaming_finish(nc: NativeCompiler, module: &IrModule) -> NativeCompiler with Mut, Panic, Div, Alloc {
    var c = nc
    compile_module_streaming_finish_into(&! c, module)
    c
}

fn compile_module(nc: NativeCompiler, module: &IrModule) -> NativeCompiler with Mut, Panic, Div, Alloc {
    var c = compile_module_streaming_begin(nc, module)

    var fi = 0
    while fi < module.fn_count {
        let fn_slot = module.functions[fi as usize]
        if fn_slot.compile_strategy == 99 {
            c.bss_total_size = c.bss_total_size + 8
        }
        c = compile_ir_function(c, fn_slot, fi)
        fi = fi + 1
    }

    compile_module_streaming_finish(c, module)
}

// Find the function index for "main"
fn find_main_index(module: &IrModule) -> i64 with Mut, Panic, Div {
    var i = 0
    while i < module.fn_count {
        if name_is_main(module.functions[i as usize].name) {
            return i
        }
        i = i + 1
    }
    -1
}

fn native_func_has_control_flow(func: IrFunction) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < func.instr_count {
        let op = (IR_A_OP[(ir_region_slot_r(func.region, (i))) as usize] as IrOpcode)
        if op == IrOpcode::IrLabel { return true }
        if op == IrOpcode::IrJump { return true }
        if op == IrOpcode::IrBranchTrue { return true }
        if op == IrOpcode::IrBranchFalse { return true }
        i = i + 1
    }
    false
}

// ============================================================================
// Single function compilation
// ============================================================================

pub fn compile_ir_function(nc: NativeCompiler, func: IrFunction, fn_index: i64) -> NativeCompiler with Mut, Panic, Div, Alloc {
    var c = reset_function_state(nc)

    // Record this function's code offset and name (for .symtab)
    c.fn_offsets[fn_index as usize] = c.code.len
    c.symbols = symbol_data_add_name(c.symbols, fn_index, func.name.buf, func.name.len)

    // Builtin dispatch — empty stubs only. User/stdlib bodies that share a
    // builtin name (exp/cos/sin/log/sqrt/print_f64/…) compile as ordinary IR.
    if func.instr_count == 0 {
        // M3: print builtins
        if name_is_print_int(func.name) { return emit_builtin_print_int(c) }
        if name_is_print_char(func.name) { return emit_builtin_print_char(c) }
        if name_is_print(func.name) { return emit_builtin_print_str(c) }
        // M4: argv + string builtins
        if name_is_get_arg_count(func.name) { return emit_builtin_get_arg_count(c) }
        if name_is_get_arg(func.name) { return emit_builtin_get_arg(c) }
        if name_is_str_len(func.name) { return emit_builtin_str_len(c) }
        if name_is_str_char_at(func.name) { return emit_builtin_str_char_at(c) }
        if name_is_str_eq(func.name) { return emit_builtin_str_eq(c) }
        if name_is_str_slice(func.name) { return emit_builtin_str_slice(c) }
        if name_is_starts_with(func.name) { return emit_builtin_starts_with(c) }
        if name_is_str_concat(func.name) { return emit_builtin_str_concat(c) }
        if name_is_str_from_bytes(func.name) { return emit_builtin_str_from_bytes(c) }
        // M5: file I/O builtins
        if name_is_read_file(func.name) { return emit_builtin_read_file(c) }
        if name_is_write_file(func.name) { return emit_builtin_write_file(c) }
        if name_is_file_size(func.name) { return emit_builtin_file_size(c) }
        if name_is_sqrt(func.name) { return emit_builtin_sqrt(c) }
        if name_is_f64_to_bits(func.name) { return emit_builtin_f64_bits_identity(c) }
        if name_is_bits_to_f64(func.name) { return emit_builtin_f64_bits_identity(c) }
        if name_is_print_f64(func.name) { return emit_builtin_print_f64(c) }
        if name_is_exp(func.name) { return emit_builtin_exp(c) }
        if name_is_log(func.name) { return emit_builtin_log(c) }
        if name_is_sin(func.name) { return emit_builtin_sin(c) }
        if name_is_cos(func.name) { return emit_builtin_cos(c) }
        if name_is_assert(func.name) { return emit_builtin_assert(c) }
        if name_is_acknowledge(func.name) { return emit_builtin_knowledge_value(c) }
        if name_is_require_confidence(func.name) { return emit_builtin_knowledge_value(c) }
        if native_v2_empty_stub_would_fabricate(&func) {
            nc_emit_unimplemented_extern_trap_into(&! c)
            return c
        }
    }

    // Sprint 38: Set compile strategy from IR function metadata
    c.current_strategy = func.compile_strategy

    // Sprint 40: Apply dual-path transformation for Instrumented strategy (Contest<T>/Robust<T>)
    // IR_STRATEGY_INSTRUMENTED (3) triggers ir_opt_apply_strategy(), which rewrites the flat
    // instruction array into a 4-block diamond: dispatch_block → fast_path | instrumented_path → merge_block
    var effective_func = func
    if func.compile_strategy == IR_STRATEGY_INSTRUMENTED {
        effective_func = ir_opt_apply_strategy(func)
    }

    let has_control_flow = native_func_has_control_flow(effective_func)

    // Keep the original stack-slot path for control-flow-heavy functions until
    // the newer regalloc/peephole lane is proven stable on loops.
    if !has_control_flow {
        c = nc_run_regalloc(c, effective_func)
        effective_func = ph_run_on_func(effective_func)
    }

    // Frame size now combines actual spill pressure with the allocatable preg save set.
    let preg_mask = nc_used_allocatable_preg_mask(c, effective_func.reg_count)
    let frame_size = x86_align_frame_size_for_calls(nc_min_frame_size(c, effective_func), preg_mask)
    c.current_frame_size = frame_size

    // Emit prologue
    c.code = emit_prologue_with_preg_mask(c.code, frame_size, preg_mask)

    // Spill parameters from ABI registers to their stack slots
    c = spill_ir_params(c, effective_func)

    // Lower each IR instruction
    var ip = 0
    while ip < effective_func.instr_count {
        lower_instr(&!c, ir_arena_load(ir_region_slot_r(effective_func.region, (ip))))
        ip = ip + 1
    }

    // Record epilogue offset, emit epilogue
    let epilogue_offset = c.code.len
    c.code = emit_epilogue_with_preg_mask(c.code, preg_mask)

    // Patch all return jumps to point to the epilogue
    c = patch_return_jumps(c, epilogue_offset)

    // Patch all label forward references
    c = patch_label_forwards(c)

    c
}

fn native_v2_spill_slot_offset(stack_slots: i64, spill_slot: i64) -> i64 {
    -((stack_slots + spill_slot + 1) * 8)
}

fn native_v2_local_frame_size(stack_slots: i64, spill_count: i64) -> i64 with Mut, Panic {
    let total_slots = stack_slots + spill_count
    if total_slots <= 0 { 0 } else { align16(total_slots * 8) }
}

fn native_v2_load_temp_to_rax(nc: NativeCompiler, temp: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    if temp < 0 || temp >= NC_MAX_VREGS {
        c.code = emit_xor_rax_rax(c.code)
        return c
    }
    let preg = c.vreg_to_preg[temp as usize]
    if preg >= 0 {
        c.code = emit_mov_rax_preg(c.code, preg)
        return c
    }
    let spill = c.vreg_spill_slots[temp as usize]
    if spill >= 0 {
        c.code = emit_load_rbp_disp32_rax(c.code, native_v2_spill_slot_offset(c.current_machine_base_slots, spill))
        return c
    }
    c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(temp))
    c
}

fn native_v2_store_rax_to_temp(nc: NativeCompiler, temp: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    if temp < 0 || temp >= NC_MAX_VREGS {
        return c
    }
    let preg = c.vreg_to_preg[temp as usize]
    if preg >= 0 {
        c.code = emit_mov_preg_rax(c.code, preg)
        return c
    }
    let spill = c.vreg_spill_slots[temp as usize]
    if spill >= 0 {
        c.code = emit_store_rax_rbp_disp32(c.code, native_v2_spill_slot_offset(c.current_machine_base_slots, spill))
        return c
    }
    c.code = emit_store_rax_rbp_disp32(c.code, ir_slot_offset(temp))
    c
}

fn native_v2_store_rax_to_stack_slot(nc: NativeCompiler, slot: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    if slot >= 0 {
        c.code = emit_store_rax_rbp_disp32(c.code, ir_slot_offset(slot))
    }
    c
}

fn native_v2_ra_simple(dst: i64, src1: i64, src2: i64) -> RaSimpleInstr {
    RaSimpleInstr { dst: dst, src1: src1, src2: src2 }
}

fn native_v2_machine_ra_instrs_into_ref(func: &MachineFunction, out: &! [RaSimpleInstr; 4096], out_count: &! i64) with Mut, Panic, Div {
    var count: i64 = 0
    var i: i64 = 0
    while i < (*func).blocks[0].instr_count && count < RA_MAX_SIMPLE_INSTRS {
        let instr = (*func).blocks[0].instrs[i as usize]
        if instr.opcode == MIR_OP_LOAD_STACK || instr.opcode == MIR_OP_MOV_IMM || instr.opcode == MIR_OP_LOAD_DATA_ADDR ||
           instr.opcode == MIR_OP_CAPTURE_RET || instr.opcode == MIR_OP_ALLOC || instr.opcode == MIR_OP_LEA_STACK {
            out[count as usize] = native_v2_ra_simple(machine_instr_dst_value(instr), 0 - 1, 0 - 1)
            count = count + 1
        } else if instr.opcode == MIR_OP_STORE_STACK || instr.opcode == MIR_OP_CMP_ZERO || instr.opcode == MIR_OP_ARG_MOVE ||
                   instr.opcode == MIR_OP_RET || instr.opcode == MIR_OP_STORE_ABS {
                   out[count as usize] = native_v2_ra_simple(0 - 1, machine_instr_src1_value(instr), 0 - 1)
                   count = count + 1
        } else if instr.opcode == MIR_OP_MOVE || instr.opcode == MIR_OP_UNARY || instr.opcode == MIR_OP_LOAD_ABS {
            out[count as usize] = native_v2_ra_simple(machine_instr_dst_value(instr), machine_instr_src1_value(instr), 0 - 1)
            count = count + 1
        } else if instr.opcode == MIR_OP_BINOP {
            out[count as usize] = native_v2_ra_simple(machine_instr_dst_value(instr), machine_instr_dst_value(instr), machine_instr_src1_value(instr))
            count = count + 1
        } else if instr.opcode == MIR_OP_FIELD_LOAD {
            out[count as usize] = native_v2_ra_simple(machine_instr_dst_value(instr), machine_instr_src1_value(instr), 0 - 1)
            count = count + 1
        } else if instr.opcode == MIR_OP_FIELD_STORE {
            out[count as usize] = native_v2_ra_simple(0 - 1, machine_instr_src1_value(instr), machine_instr_src2_value(instr))
            count = count + 1
        } else if instr.opcode == MIR_OP_INDEX_LOAD {
            out[count as usize] = native_v2_ra_simple(machine_instr_dst_value(instr), machine_instr_src1_value(instr), machine_instr_src2_value(instr))
            count = count + 1
        } else if instr.opcode == MIR_OP_INDEX_STORE {
            out[count as usize] = native_v2_ra_simple(0 - 1, machine_instr_src1_value(instr), machine_instr_src2_value(instr))
            count = count + 1
            if count < RA_MAX_SIMPLE_INSTRS {
                out[count as usize] = native_v2_ra_simple(0 - 1, machine_instr_aux_value(instr), 0 - 1)
                count = count + 1
            }
        }
        i = i + 1
    }
    *out_count = count
}

pub(crate) fn native_v2_machine_ra_instrs(func: MachineFunction) -> ([RaSimpleInstr; 4096], i64) with Mut, Panic, Div {
    var out: [RaSimpleInstr; 4096] = [ra_empty_simple_instr(); 4096]
    var count: i64 = 0
    native_v2_machine_ra_instrs_into_ref(&func, &! out, &! count)
    (out, count)
}

fn native_v2_run_machine_regalloc(nc: NativeCompiler, func: MachineFunction) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    native_v2_run_machine_regalloc_mut(&! c, func)
    c
}

fn native_v2_run_machine_regalloc_mut(nc: &! NativeCompiler, func: MachineFunction) with Mut, Panic, Div {
    let pair = native_v2_machine_ra_instrs(func)
    var state = liveness_compute_intervals(pair.0, pair.1)
    state = regalloc_linear_scan(state, native_target_policy_x86_allocation_order_count())

    var i: i64 = 0
    while i < NC_MAX_VREGS {
        (*nc).vreg_to_preg[i as usize] = -2
        (*nc).vreg_spill_slots[i as usize] = -1
        i = i + 1
    }

    var v: i64 = 0
    while v < state.count {
        let interval = state.intervals[v as usize]
        let vreg = interval.vreg
        if vreg >= 0 && vreg < NC_MAX_VREGS {
            if interval.assigned_preg >= 0 {
                (*nc).vreg_to_preg[vreg as usize] = native_target_policy_x86_allocation_order_reg_id(interval.assigned_preg)
            } else {
                (*nc).vreg_to_preg[vreg as usize] = interval.assigned_preg
            }
            (*nc).vreg_spill_slots[vreg as usize] = interval.spill_slot
        }
        v = v + 1
    }
    (*nc).current_machine_base_slots = func.temp_count
    (*nc).current_machine_spill_count = state.spill_count
}

fn native_v2_run_machine_regalloc_ref_mut(nc: &! NativeCompiler, func: &MachineFunction) with Mut, Panic, Div {
    var instrs: [RaSimpleInstr; 4096] = [ra_empty_simple_instr(); 4096]
    var instr_count: i64 = 0
    native_v2_machine_ra_instrs_into_ref(func, &! instrs, &! instr_count)
    var state = liveness_compute_intervals(instrs, instr_count)
    state = regalloc_linear_scan(state, native_target_policy_x86_allocation_order_count())

    var i: i64 = 0
    while i < NC_MAX_VREGS {
        (*nc).vreg_to_preg[i as usize] = -2
        (*nc).vreg_spill_slots[i as usize] = -1
        i = i + 1
    }

    var v: i64 = 0
    while v < state.count {
        let interval = state.intervals[v as usize]
        let vreg = interval.vreg
        if vreg >= 0 && vreg < NC_MAX_VREGS {
            if interval.assigned_preg >= 0 {
                (*nc).vreg_to_preg[vreg as usize] = native_target_policy_x86_allocation_order_reg_id(interval.assigned_preg)
            } else {
                (*nc).vreg_to_preg[vreg as usize] = interval.assigned_preg
            }
            (*nc).vreg_spill_slots[vreg as usize] = interval.spill_slot
        }
        v = v + 1
    }
    (*nc).current_machine_base_slots = (*func).temp_count
    (*nc).current_machine_spill_count = state.spill_count
}

fn native_v2_used_allocatable_preg_mask_ref(nc: &NativeCompiler, reg_count: i64) -> i64 with Mut, Panic, Div {
    var mask: i64 = 0
    var v: i64 = 0
    while v < reg_count {
        mask = mask | x86_allocatable_mask_for_reg((*nc).vreg_to_preg[v as usize])
        v = v + 1
    }
    mask
}

fn native_compiler_set_fn_offset(nc: &! NativeCompiler, fn_index: i64, offset: i64) with Mut, Panic, Div {
    var offsets = (*nc).fn_offsets
    if fn_index >= 0 && fn_index < IR_MAX_FUNCS {
        offsets[fn_index as usize] = offset
    }
    (*nc).fn_offsets = offsets
}

fn native_compiler_add_symbol_name_ref(nc: &! NativeCompiler, fn_index: i64, name: &Name) with Mut, Panic, Div {
    if fn_index >= 0 && fn_index < IR_MAX_FUNCS {
        (*nc).symbols.name_offsets[fn_index as usize] = (*nc).symbols.strtab_len
        var ni = 0
        while ni < (*name).len && (*nc).symbols.strtab_len < 32767 {
            (*nc).symbols.strtab[(*nc).symbols.strtab_len as usize] = (*name).buf[ni as usize]
            (*nc).symbols.strtab_len = (*nc).symbols.strtab_len + 1
            ni = ni + 1
        }
        if (*nc).symbols.strtab_len < 32767 {
            (*nc).symbols.strtab[(*nc).symbols.strtab_len as usize] = 0
            (*nc).symbols.strtab_len = (*nc).symbols.strtab_len + 1
        }
    }
}

fn native_compiler_add_symbol_func_ref(nc: &! NativeCompiler, fn_index: i64, func: &IrFunction) with Mut, Panic, Div {
    if fn_index >= 0 && fn_index < IR_MAX_FUNCS {
        (*nc).symbols.name_offsets[fn_index as usize] = (*nc).symbols.strtab_len
        var ni = 0
        while ni < (*func).name.len && (*nc).symbols.strtab_len < 32767 {
            (*nc).symbols.strtab[(*nc).symbols.strtab_len as usize] = (*func).name.buf[ni as usize]
            (*nc).symbols.strtab_len = (*nc).symbols.strtab_len + 1
            ni = ni + 1
        }
        if (*nc).symbols.strtab_len < 32767 {
            (*nc).symbols.strtab[(*nc).symbols.strtab_len as usize] = 0
            (*nc).symbols.strtab_len = (*nc).symbols.strtab_len + 1
        }
    }
}

fn native_v2_emit_unary_code(nc: NativeCompiler, op: UnaryOp) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    if op == UnaryOp::OpNeg {
        c.code = emit_neg_rax(c.code)
    } else if op == UnaryOp::OpNot {
        c.code = emit_not_bool_rax(c.code)
    } else if op == UnaryOp::OpDeref {
        c.code = emit_load_rax_mem_rax(c.code)
    }
    c
}

fn native_v2_emit_machine_instr(nc: NativeCompiler, instr: MachineInstr) -> NativeCompiler with Mut, Panic, Div {
    var c = nc

    if instr.opcode == MIR_OP_LOAD_STACK {
        c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(instr.src1.value))
        return native_v2_store_rax_to_temp(c, instr.dst.value)
    }

    if instr.opcode == MIR_OP_STORE_STACK {
        c = native_v2_load_temp_to_rax(c, instr.src1.value)
        return native_v2_store_rax_to_stack_slot(c, instr.dst.value)
    }

    if instr.opcode == MIR_OP_LOAD_ABS {
        c = native_v2_load_temp_to_rax(c, instr.src1.value)
        c.code = emit_load_rax_mem_rax(c.code)
        return native_v2_store_rax_to_temp(c, instr.dst.value)
    }

    if instr.opcode == MIR_OP_STORE_ABS {
        c = native_v2_load_temp_to_rax(c, instr.src1.value)
        c.code = emit_mov_reg_imm(c.code, 3, instr.src2.value)
        c.code = emit_store_rax_mem_rbx_disp32(c.code, 0)
        return c
    }

    if instr.opcode == MIR_OP_MOV_IMM {
        c.code = emit_mov_rax_imm(c.code, instr.src1.value)
        return native_v2_store_rax_to_temp(c, instr.dst.value)
    }

    if instr.opcode == MIR_OP_LOAD_DATA_ADDR {
        c.rodata = string_table_add(c.rodata, instr.name.buf, instr.name.len)
        let str_offset = c.rodata.last_offset
        let lea_pos = c.code.len
        c.code = emit_lea_rax_rip_disp32(c.code, 0)
        c.relocs = add_rip_reloc(c.relocs, lea_pos + 3, str_offset)
        return native_v2_store_rax_to_temp(c, instr.dst.value)
    }

    if instr.opcode == MIR_OP_MOVE {
        c = native_v2_load_temp_to_rax(c, instr.src1.value)
        return native_v2_store_rax_to_temp(c, instr.dst.value)
    }

    if instr.opcode == MIR_OP_BINOP {
        c = native_v2_load_temp_to_rax(c, instr.dst.value)
        c.code = emit_push_rax(c.code)
        c.code = emit_sub_rsp_8(c.code)
        c = native_v2_load_temp_to_rax(c, instr.src1.value)
        c.code = emit_add_rsp_8(c.code)
        c.code = emit_pop_rbx(c.code)
        emit_binop_code(&!c, instr.bin_op)
        return native_v2_store_rax_to_temp(c, instr.dst.value)
    }

    if instr.opcode == MIR_OP_UNARY {
        c = native_v2_load_temp_to_rax(c, instr.src1.value)
        c = native_v2_emit_unary_code(c, instr.un_op)
        return native_v2_store_rax_to_temp(c, instr.dst.value)
    }

    if instr.opcode == MIR_OP_CMP_ZERO {
        c = native_v2_load_temp_to_rax(c, instr.src1.value)
        c.code = emit_test_rax_rax(c.code)
        return c
    }

    if instr.opcode == MIR_OP_JMP {
        let label_id = instr.dst.value
        if label_id >= 0 && label_id < 256 {
            let target = c.label_offsets[label_id as usize]
            if target >= 0 {
                let jmp_pos = c.code.len
                c.code = emit_jmp_rel32(c.code)
                let next_ip = jmp_pos + 5
                let rel = target - next_ip
                c.code = patch_u32_le(c.code, jmp_pos + 1, rel)
            } else {
                let jmp_pos = c.code.len
                c.code = emit_jmp_rel32(c.code)
                if c.label_patch_count < 256 {
                    c.label_patch_code_offsets[c.label_patch_count as usize] = jmp_pos + 1
                    c.label_patch_label_ids[c.label_patch_count as usize] = label_id
                    c.label_patch_count = c.label_patch_count + 1
                }
            }
        }
        return c
    }

    if instr.opcode == MIR_OP_JCC {
        let label_id = instr.dst.value
        if label_id >= 0 && label_id < 256 {
            let target = c.label_offsets[label_id as usize]
            if instr.cond == MIR_CC_Z {
                if target >= 0 {
                    let jz_pos = c.code.len
                    c.code = emit_jz_rel32(c.code)
                    let next_ip = jz_pos + 6
                    let rel = target - next_ip
                    c.code = patch_u32_le(c.code, jz_pos + 2, rel)
                } else {
                    let jz_pos = c.code.len
                    c.code = emit_jz_rel32(c.code)
                    if c.label_patch_count < 256 {
                        c.label_patch_code_offsets[c.label_patch_count as usize] = jz_pos + 2
                        c.label_patch_label_ids[c.label_patch_count as usize] = label_id
                        c.label_patch_count = c.label_patch_count + 1
                    }
                }
            } else if instr.cond == MIR_CC_NZ {
                if target >= 0 {
                    let jnz_pos = c.code.len
                    c.code = emit_jnz_rel32(c.code)
                    let next_ip = jnz_pos + 6
                    let rel = target - next_ip
                    c.code = patch_u32_le(c.code, jnz_pos + 2, rel)
                } else {
                    let jnz_pos = c.code.len
                    c.code = emit_jnz_rel32(c.code)
                    if c.label_patch_count < 256 {
                        c.label_patch_code_offsets[c.label_patch_count as usize] = jnz_pos + 2
                        c.label_patch_label_ids[c.label_patch_count as usize] = label_id
                        c.label_patch_count = c.label_patch_count + 1
                    }
                }
            }
        }
        return c
    }

    if instr.opcode == MIR_OP_LABEL {
        if instr.dst.value >= 0 && instr.dst.value < 256 {
            c.label_offsets[instr.dst.value as usize] = c.code.len
        }
        return c
    }

    if instr.opcode == MIR_OP_ARG_MOVE {
        c = native_v2_load_temp_to_rax(c, instr.src1.value)
        c.code = emit_push_rax(c.code)
        c.code = emit_pop_arg_reg(c.code, instr.arg_index)
        return c
    }

    if instr.opcode == MIR_OP_CALL {
        let call_pos = c.code.len
        c.code = emit_call_rel32_placeholder(c.code)
        if instr.src1.value >= 0 {
            c.relocs = add_call_reloc(c.relocs, call_pos + 1, instr.src1.value)
        }
        return c
    }

    if instr.opcode == MIR_OP_CAPTURE_RET {
        return native_v2_store_rax_to_temp(c, instr.dst.value)
    }

    if instr.opcode == MIR_OP_RET {
        if instr.src1.kind == MIR_OPERAND_GPR64 {
            c = native_v2_load_temp_to_rax(c, instr.src1.value)
        } else {
            c.code = emit_xor_rax_rax(c.code)
        }
        let rj_pos = c.code.len
        c.code = emit_jmp_rel32(c.code)
        if c.return_jump_count < 16 {
            c.return_jumps[c.return_jump_count as usize] = rj_pos + 1
            c.return_jump_count = c.return_jump_count + 1
        }
        return c
    }

    if instr.opcode == MIR_OP_ALLOC {
        let payload_size = instr.src1.value
        let total_size = payload_size + native_v2_object_header_size()
        // MIR already carries the resolved payload size; ≤16 B means a SysV
        // register-pair value struct (Rational/Box). Unbox: no handle slot.
        let unboxed = payload_size > 0 && payload_size <= 16
        c = emit_load_runtime_context_field_rax(c, runtime_context_field_heap_cursor())
        c.code = emit_mov_rdx_rax(c.code)
        c.code = emit_mov_reg_imm(c.code, 1, total_size)
        c.code = emit_add_reg_reg(c.code, 0, 1)
        c.code = emit_mov_reg_reg(c.code, 1, 0)
        c = emit_load_runtime_context_field_rax(c, runtime_context_field_heap_limit())
        c.code = emit_mov_rbx_rax(c.code)
        c.code = emit_mov_reg_reg(c.code, 0, 1)
        c.code = emit_cmp_rbx_rax(c.code)
        c.code = emit_setb_al(c.code)
        c.code = emit_movzx_rax_al(c.code)
        c.code = emit_test_rax_rax(c.code)
        let heap_slow_jnz = c.code.len
        c.code = emit_jnz_rel32(c.code)

        if unboxed {
            c.code = emit_mov_reg_reg(c.code, 0, 1)
            c = emit_store_rax_runtime_context_field(c, runtime_context_field_heap_cursor())
            c.code = emit_mov_rax_rdx(c.code)
            c.code = emit_mov_rbx_rax(c.code)
            c.code = emit_mov_rax_imm(c.code, instr.aux.value)
            c.code = emit_store_rax_mem_rbx_disp32(c.code, native_v2_object_header_field_descriptor_id())
            c.code = emit_mov_rax_imm(c.code, payload_size)
            c.code = emit_store_rax_mem_rbx_disp32(c.code, native_v2_object_header_field_payload_size())
            c.code = emit_xor_rax_rax(c.code)
            c.code = emit_store_rax_mem_rbx_disp32(c.code, native_v2_object_header_field_flags())
            c.code = emit_store_rax_mem_rbx_disp32(c.code, native_v2_object_header_field_handle_id())
            c.code = emit_mov_rax_rdx(c.code)
            let done_jmp_u = c.code.len
            c.code = emit_jmp_rel32(c.code)

            let heap_slow_path_u = c.code.len
            c.code = patch_u32_le(c.code, heap_slow_jnz + 2, heap_slow_path_u - (heap_slow_jnz + 6))
            c = native_v2_emit_gc_request_metadata(c, total_size, native_v2_gc_reason_heap_limit())
            c.code = emit_exit(c.code, 181)

            let done_target_u = c.code.len
            c.code = patch_u32_le(c.code, done_jmp_u + 1, done_target_u - (done_jmp_u + 5))
            return native_v2_store_rax_to_temp(c, instr.dst.value)
        }

        c = emit_load_runtime_context_field_rax(c, runtime_context_field_handle_count())
        c.code = emit_mov_rbx_rax(c.code)
        c.code = emit_mov_reg_imm(c.code, 1, 1)
        c.code = emit_add_reg_reg(c.code, 3, 1)
        c = emit_load_runtime_context_field_rax(c, runtime_context_field_handle_capacity())
        c.code = emit_cmp_rbx_rax(c.code)
        c.code = emit_setae_al(c.code)
        c.code = emit_movzx_rax_al(c.code)
        c.code = emit_test_rax_rax(c.code)
        let handle_slow_jnz = c.code.len
        c.code = emit_jnz_rel32(c.code)

        c.code = emit_mov_rax_rbx(c.code)
        c.code = emit_push_rax(c.code)
        c.code = emit_mov_reg_reg(c.code, 0, 1)
        c = emit_store_rax_runtime_context_field(c, runtime_context_field_heap_cursor())

        c.code = emit_mov_rax_rdx(c.code)
        c.code = emit_mov_rbx_rax(c.code)
        c.code = emit_mov_rax_imm(c.code, instr.aux.value)
        c.code = emit_store_rax_mem_rbx_disp32(c.code, native_v2_object_header_field_descriptor_id())
        c.code = emit_mov_rax_imm(c.code, payload_size)
        c.code = emit_store_rax_mem_rbx_disp32(c.code, native_v2_object_header_field_payload_size())
        c.code = emit_xor_rax_rax(c.code)
        c.code = emit_store_rax_mem_rbx_disp32(c.code, native_v2_object_header_field_flags())
        c.code = emit_pop_rax(c.code)
        c.code = emit_store_rax_mem_rbx_disp32(c.code, native_v2_object_header_field_handle_id())
        c.code = emit_push_rax(c.code)

        c.code = emit_mov_rbx_rax(c.code)
        c.code = emit_imul_rbx_rbx_imm8(c.code, native_v2_handle_entry_size())
        c = emit_load_runtime_context_field_rax(c, runtime_context_field_handle_table_base())
        c.code = emit_add_rax_rbx(c.code)
        c.code = emit_mov_rbx_rax(c.code)
        c.code = emit_mov_rax_rdx(c.code)
        c.code = emit_store_rax_mem_rbx_disp32(c.code, native_v2_handle_entry_field_object_base())
        c.code = emit_mov_rax_imm(c.code, total_size)
        c.code = emit_store_rax_mem_rbx_disp32(c.code, native_v2_handle_entry_field_object_size())
        c.code = emit_mov_rax_imm(c.code, instr.aux.value)
        c.code = emit_store_rax_mem_rbx_disp32(c.code, native_v2_handle_entry_field_descriptor_id())
        c.code = emit_xor_rax_rax(c.code)
        c.code = emit_store_rax_mem_rbx_disp32(c.code, native_v2_handle_entry_field_pin_count())
        c.code = emit_store_rax_mem_rbx_disp32(c.code, native_v2_handle_entry_field_flags())
        c.code = emit_store_rax_mem_rbx_disp32(c.code, native_v2_handle_entry_field_epoch())

        c.code = emit_pop_rax(c.code)
        c = emit_store_rax_runtime_context_field(c, runtime_context_field_handle_count())
        let done_jmp = c.code.len
        c.code = emit_jmp_rel32(c.code)

        // Fail closed: no empty-frame reset (live roots not precisely mapped).
        let heap_slow_path = c.code.len
        c.code = patch_u32_le(c.code, heap_slow_jnz + 2, heap_slow_path - (heap_slow_jnz + 6))
        c = native_v2_emit_gc_request_metadata(c, total_size, native_v2_gc_reason_heap_limit())
        c.code = emit_exit(c.code, 181)

        let handle_slow_path = c.code.len
        c.code = patch_u32_le(c.code, handle_slow_jnz + 2, handle_slow_path - (handle_slow_jnz + 6))
        c = native_v2_emit_gc_request_metadata(c, total_size, native_v2_gc_reason_handle_table_full())
        c.code = emit_exit(c.code, 182)

        let done_target = c.code.len
        c.code = patch_u32_le(c.code, done_jmp + 1, done_target - (done_jmp + 5))
        return native_v2_store_rax_to_temp(c, instr.dst.value)
    }

    if instr.opcode == MIR_OP_FIELD_LOAD {
        c = native_v2_load_temp_to_rax(c, instr.src1.value)
        c = native_v2_resolve_handle_to_object_base_rax(c)
        c.code = emit_mov_reg_imm(c.code, 3, instr.aux.value + (native_v2_object_header_size() / 8))
        c.code = emit_mov_rax_mem_rax_rbx8(c.code)
        return native_v2_store_rax_to_temp(c, instr.dst.value)
    }

    if instr.opcode == MIR_OP_FIELD_STORE {
        c = native_v2_load_temp_to_rax(c, instr.src1.value)
        c = native_v2_resolve_handle_to_object_base_rax(c)
        c.code = emit_mov_rdx_rax(c.code)
        c = native_v2_load_temp_to_rax(c, instr.src2.value)
        c.code = emit_mov_reg_imm(c.code, 3, instr.aux.value + (native_v2_object_header_size() / 8))
        c.code = emit_store_rax_mem_rdx_rbx8(c.code)
        return c
    }

    if instr.opcode == MIR_OP_INDEX_LOAD {
        c = native_v2_load_temp_to_rax(c, instr.src1.value)
        c = native_v2_resolve_handle_to_object_base_rax(c)
        c.code = emit_mov_rdx_rax(c.code)
        c = native_v2_load_temp_to_rax(c, instr.src2.value)
        c.code = emit_mov_rbx_rax(c.code)
        c.code = emit_mov_reg_imm(c.code, 1, native_v2_object_header_size() / 8)
        c.code = emit_add_reg_reg(c.code, 3, 1)
        c.code = emit_load_rax_mem_rdx_rbx8(c.code)
        return native_v2_store_rax_to_temp(c, instr.dst.value)
    }

    if instr.opcode == MIR_OP_INDEX_STORE {
        c = native_v2_load_temp_to_rax(c, instr.src1.value)
        c = native_v2_resolve_handle_to_object_base_rax(c)
        c.code = emit_mov_rdx_rax(c.code)
        c = native_v2_load_temp_to_rax(c, instr.src2.value)
        c.code = emit_mov_rbx_rax(c.code)
        c.code = emit_mov_reg_imm(c.code, 1, native_v2_object_header_size() / 8)
        c.code = emit_add_reg_reg(c.code, 3, 1)
        c = native_v2_load_temp_to_rax(c, instr.aux.value)
        c.code = emit_store_rax_mem_rdx_rbx8(c.code)
        return c
    }

    if instr.opcode == MIR_OP_LEA_STACK {
        c.code = emit_lea_rax_rbp_disp32(c.code, ir_slot_offset(instr.src1.value))
        return native_v2_store_rax_to_temp(c, instr.dst.value)
    }

    // Sprint 87: float MIR instruction emission
    if instr.opcode == MIR_OP_LOAD_FLOAT_RIP {
        // Load f64 constant (bits in src1.value) from rodata via MOVSD xmm0,[rip+disp32]
        c.rodata = data_section_add_f64(c.rodata, instr.src1.value)
        let data_offset = c.rodata.last_offset
        let movsd_pos = c.code.len
        c.code = emit_movsd_xmm0_rip_disp32(c.code, 0)
        c.relocs = add_rip_reloc(c.relocs, movsd_pos + 4, data_offset)
        c.code = emit_movq_rax_xmm0(c.code)
        return native_v2_store_rax_to_stack_slot(c, instr.dst.value)
    }

    if instr.opcode == MIR_OP_INT_TO_FLOAT {
        // CVTSI2SD xmm0, [rbp+src1_slot] → store bits to dst slot
        c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(instr.src1.value))
        c.code = emit_cvtsi2sd_xmm0_rax(c.code)
        c.code = emit_movq_rax_xmm0(c.code)
        return native_v2_store_rax_to_stack_slot(c, instr.dst.value)
    }

    if instr.opcode == MIR_OP_FLOAT_TO_INT {
        // CVTTSD2SI rax, xmm0 ← [rbp+src1_slot] → store to dst slot
        c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(instr.src1.value))
        c.code = emit_movq_xmm0_rax(c.code)
        c.code = emit_cvttsd2si_rax_xmm0(c.code)
        return native_v2_store_rax_to_stack_slot(c, instr.dst.value)
    }

    if instr.opcode == MIR_OP_FLOAT_MOVE {
        // Float stack slot copy: load bits as i64 → store bits (no conversion needed)
        c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(instr.src1.value))
        return native_v2_store_rax_to_stack_slot(c, instr.dst.value)
    }

    if instr.opcode == MIR_OP_FLOAT_BINOP {
        // Load src1 into xmm0 (with int→float conversion if needed)
        let s1_is_float = instr.aux.value & 1
        let s2_is_float = (instr.aux.value / 2) & 1
        c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(instr.src1.value))
        if s1_is_float == 1 {
            c.code = emit_movq_xmm0_rax(c.code)
        } else {
            c.code = emit_cvtsi2sd_xmm0_rax(c.code)
        }
        // Load src2 into xmm1 (with int→float conversion if needed)
        c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(instr.src2.value))
        if s2_is_float == 1 {
            c.code = emit_movq_xmm1_rax(c.code)
        } else {
            // cvtsi2sd → rax has f64 bits → xmm1
            c.code = emit_cvtsi2sd_xmm0_rax(c.code)
            c.code = emit_movq_rax_xmm0(c.code)
            c.code = emit_movq_xmm1_rax(c.code)
            // restore xmm0 from src1
            c.code = emit_load_rbp_disp32_rax(c.code, ir_slot_offset(instr.src1.value))
            if s1_is_float == 1 {
                c.code = emit_movq_xmm0_rax(c.code)
            } else {
                c.code = emit_cvtsi2sd_xmm0_rax(c.code)
            }
        }
        emit_float_binop_code(&!c, instr.bin_op)
        return native_v2_store_rax_to_stack_slot(c, instr.dst.value)
    }

    c
}

fn native_v2_emit_machine_function(nc: NativeCompiler, func: MachineFunction, fn_index: i64, fn_offset: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    native_v2_emit_machine_function_mut(&! c, func, fn_index, fn_offset)
    c
}

fn native_v2_emit_machine_function_mut(nc: &! NativeCompiler, func: MachineFunction, fn_index: i64, fn_offset: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < func.blocks[0].instr_count {
        let instr = func.blocks[0].instrs[i as usize]
        if native_v2_machine_instr_is_safepoint(instr) {
            let kind = if instr.opcode == MIR_OP_CALL { NATIVE_V2_SAFEPOINT_CALL() } else { NATIVE_V2_SAFEPOINT_RET() }
            native_v2_record_safepoint_mut(nc, fn_index, kind, i, (*nc).code.len - fn_offset, func.temp_count, (*nc).current_machine_spill_count)
        }
        (*nc) = native_v2_emit_machine_instr((*nc), instr)
        i = i + 1
    }
}

fn native_v2_emit_machine_function_ref_mut(nc: &! NativeCompiler, func: &MachineFunction, fn_index: i64, fn_offset: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < (*func).blocks[0].instr_count {
        let instr = (*func).blocks[0].instrs[i as usize]
        if native_v2_machine_instr_is_safepoint(instr) {
            let kind = if instr.opcode == MIR_OP_CALL { NATIVE_V2_SAFEPOINT_CALL() } else { NATIVE_V2_SAFEPOINT_RET() }
            native_v2_record_safepoint_mut(nc, fn_index, kind, i, (*nc).code.len - fn_offset, (*func).temp_count, (*nc).current_machine_spill_count)
        }
        (*nc) = native_v2_emit_machine_instr((*nc), instr)
        i = i + 1
    }
}

pub fn native_v2_builtin_id_for_name(name: Name) -> i64 with Mut, Panic, Div {
    if name_is_print_int(name) { return 1 }
    if name_is_print_char(name) { return 2 }
    if name_is_print(name) { return 3 }
    if name_is_get_arg_count(name) { return 4 }
    if name_is_get_arg(name) { return 5 }
    if name_is_str_len(name) { return 6 }
    if name_is_str_char_at(name) { return 20 }
    if name_is_str_eq(name) { return 7 }
    if name_is_str_slice(name) { return 8 }
    if name_is_starts_with(name) { return 9 }
    if name_is_str_concat(name) { return 10 }
    if name_is_read_file(name) { return 11 }
    if name_is_write_file(name) { return 12 }
    if name_is_file_size(name) { return 13 }
    if name_is_sqrt(name) { return 14 }
    if name_is_print_f64(name) { return 15 }
    if name_is_exp(name) { return 16 }
    if name_is_log(name) { return 17 }
    if name_is_sin(name) { return 18 }
    if name_is_cos(name) { return 19 }
    if name_is_assert(name) { return 21 }
    if name_is_str_from_bytes(name) { return 22 }
    if name_is_heap_alloc(name) { return 23 }
    if name_is_heap_free(name) { return 24 }
    if name_is_syscall6(name) { return 27 }
    // P0-F allowlisted POSIX externs. malloc/free alias the heap ids so they
    // reuse the mmap emitters; getpid/getppid/exit/abort/system get 28-32.
    if name_is_malloc(name) { return 23 }
    if name_is_free(name) { return 24 }
    if name_is_getpid(name) { return 28 }
    if name_is_getppid(name) { return 29 }
    if name_is_exit(name) { return 30 }
    if name_is_abort(name) { return 31 }
    if name_is_system(name) { return 32 }
    // Defect A: read_i64/write_i64/read_f64/write_f64 raw pointer accessor family.
    if name_is_read_i64(name) { return 33 }
    if name_is_write_i64(name) { return 34 }
    if name_is_read_f64(name) { return 35 }
    if name_is_write_f64(name) { return 36 }
    0
}

// Wave14e: empty float-intrinsic stubs must advertise scalar f64 returns.
// Without returns_float=1, call sites omit IR_FLOAT_REG_MARKER_FLAG, the
// native core marks the result INT, and subsequent f64 arithmetic does
// cvtsi2sd on the IEEE bit pattern (cos(0)*1000 → ~4.6e21).
// Float-returning builtins: sqrt=14, exp=16, log=17, sin=18, cos=19,
// bits_to_f64=26 (id 26 only via func_ref path today).
pub fn native_v2_builtin_returns_float(builtin_id: i64) -> bool {
    if builtin_id == 14 { return true }
    if builtin_id == 16 { return true }
    if builtin_id == 17 { return true }
    if builtin_id == 18 { return true }
    if builtin_id == 19 { return true }
    if builtin_id == 26 { return true }
    if builtin_id == 35 { return true }  // read_f64 (Defect A)
    if builtin_id == 37 { return true }  // acknowledge(Knowledge<f64>, reason)
    if builtin_id == 38 { return true }  // require_confidence(Knowledge<f64>, min)
    false
}

fn native_v2_emit_builtin_by_id_into(nc: &! NativeCompiler, builtin_id: i64) with Mut, Panic, Div {
    if builtin_id == 1 { emit_builtin_print_int_into(nc); return }
    if builtin_id == 2 { emit_builtin_print_char_into(nc); return }
    if builtin_id == 3 {
        emit_builtin_print_str_into(nc)
        return
    }
    if builtin_id == 4 { emit_builtin_get_arg_count_into(nc); return }
    if builtin_id == 5 { emit_builtin_get_arg_into(nc); return }
    // Each builtin is emitted via native_v2_persist_builtin_emit_into (copies the appended
    // code + data relocs onto the existing nc), NOT `(*nc) = emit_builtin_X((*nc))`: the
    // full by-value NativeCompiler replacement is hit by the large-aggregate miscompile and
    // corrupts fn_offsets, so the function's recorded offset was wrong and every call to it
    // jumped to a bad address (str_slice/sqrt/print_f64/… all crashed). Same root + fix as
    // str_concat/str_eq.
    if builtin_id == 6 { native_v2_persist_builtin_emit_into(nc, emit_builtin_str_len((*nc))); return }
    if builtin_id == 20 { native_v2_persist_builtin_emit_into(nc, emit_builtin_str_char_at((*nc))); return }
    if builtin_id == 7 { native_v2_persist_builtin_emit_into(nc, emit_builtin_str_eq((*nc))); return }
    if builtin_id == 8 { native_v2_persist_builtin_emit_into(nc, emit_builtin_str_slice((*nc))); return }
    if builtin_id == 9 { native_v2_persist_builtin_emit_into(nc, emit_builtin_starts_with((*nc))); return }
    if builtin_id == 10 { native_v2_persist_builtin_emit_into(nc, emit_builtin_str_concat((*nc))); return }
    if builtin_id == 11 { native_v2_persist_builtin_emit_into(nc, emit_builtin_read_file((*nc))); return }
    if builtin_id == 12 { native_v2_persist_builtin_emit_into(nc, emit_builtin_write_file((*nc))); return }
    if builtin_id == 13 { native_v2_persist_builtin_emit_into(nc, emit_builtin_file_size((*nc))); return }
    if builtin_id == 14 { native_v2_persist_builtin_emit_into(nc, emit_builtin_sqrt((*nc))); return }
    if builtin_id == 15 { native_v2_persist_builtin_emit_into(nc, emit_builtin_print_f64((*nc))); return }
    if builtin_id == 16 { native_v2_persist_builtin_emit_into(nc, emit_builtin_exp((*nc))); return }
    if builtin_id == 17 { native_v2_persist_builtin_emit_into(nc, emit_builtin_log((*nc))); return }
    if builtin_id == 18 { native_v2_persist_builtin_emit_into(nc, emit_builtin_sin((*nc))); return }
    if builtin_id == 19 { native_v2_persist_builtin_emit_into(nc, emit_builtin_cos((*nc))); return }
    if builtin_id == 21 { emit_builtin_assert_into(nc); return }
    if builtin_id == 22 { native_v2_persist_builtin_emit_into(nc, emit_builtin_str_from_bytes((*nc))); return }
    if builtin_id == 23 { emit_builtin_heap_alloc_into(nc); return }
    if builtin_id == 24 { emit_builtin_heap_free_into(nc); return }
    if builtin_id == 25 { native_v2_persist_builtin_emit_into(nc, emit_builtin_f64_bits_identity((*nc))); return }
    if builtin_id == 26 { native_v2_persist_builtin_emit_into(nc, emit_builtin_f64_bits_identity((*nc))); return }
    if builtin_id == 27 { emit_builtin_syscall6_into(nc); return }
    if builtin_id == 28 { emit_builtin_getpid_into(nc); return }
    if builtin_id == 29 { emit_builtin_getppid_into(nc); return }
    if builtin_id == 30 { emit_builtin_exit_into(nc); return }
    if builtin_id == 31 { emit_builtin_abort_into(nc); return }
    if builtin_id == 32 { emit_builtin_system_into(nc); return }
    if builtin_id == 33 { emit_builtin_read_offset64_into(nc); return }
    if builtin_id == 34 { emit_builtin_write_offset64_into(nc); return }
    if builtin_id == 35 { emit_builtin_read_offset64_into(nc); return }
    if builtin_id == 36 { emit_builtin_write_offset64_into(nc); return }
    if builtin_id == 37 { native_v2_persist_builtin_emit_into(nc, emit_builtin_knowledge_value((*nc))); return }
    if builtin_id == 38 { native_v2_persist_builtin_emit_into(nc, emit_builtin_knowledge_value((*nc))); return }
}

pub fn compile_ir_function_v2(nc: NativeCompiler, func: IrFunction, machine_func: MachineFunction, fn_index: i64) -> NativeCompiler with Mut, Panic, Div, Alloc {
    var c = nc

    // --- reset_function_state (inlined, no &!) ---
    c.return_jump_count = 0
    var rst_i = 0
    while rst_i < 256 {
        c.label_offsets[rst_i as usize] = -1
        rst_i = rst_i + 1
    }
    c.label_patch_count = 0
    c.current_frame_size = 0
    var rst_j = 0
    while rst_j < NC_MAX_VREGS {
        c.is_float_reg[rst_j as usize] = 0
        rst_j = rst_j + 1
    }
    c.current_strategy = 0
    var rst_ra = 0
    while rst_ra < NC_MAX_VREGS {
        c.vreg_to_preg[rst_ra as usize] = -2
        c.vreg_spill_slots[rst_ra as usize] = -1
        rst_ra = rst_ra + 1
    }
    c.current_machine_base_slots = 0
    c.current_machine_spill_count = 0

    c.fn_offsets[fn_index as usize] = c.code.len
    c.symbols = symbol_data_add_name(c.symbols, fn_index, func.name.buf, func.name.len)

    // Empty-stub builtins only — see native_v2_builtin_id_for_func_ref.
    if func.instr_count == 0 {
        if name_is_print_int(func.name) { return emit_builtin_print_int(c) }
        if name_is_print_char(func.name) { return emit_builtin_print_char(c) }
        if name_is_print(func.name) { return emit_builtin_print_str(c) }
        if name_is_get_arg_count(func.name) { return emit_builtin_get_arg_count(c) }
        if name_is_get_arg(func.name) { return emit_builtin_get_arg(c) }
        if name_is_str_len(func.name) { return emit_builtin_str_len(c) }
        if name_is_str_char_at(func.name) { return emit_builtin_str_char_at(c) }
        if name_is_str_eq(func.name) { return emit_builtin_str_eq(c) }
        if name_is_str_slice(func.name) { return emit_builtin_str_slice(c) }
        if name_is_starts_with(func.name) { return emit_builtin_starts_with(c) }
        if name_is_str_concat(func.name) { return emit_builtin_str_concat(c) }
        if name_is_read_file(func.name) { return emit_builtin_read_file(c) }
        if name_is_write_file(func.name) { return emit_builtin_write_file(c) }
        if name_is_file_size(func.name) { return emit_builtin_file_size(c) }
        if name_is_sqrt(func.name) { return emit_builtin_sqrt(c) }
        if name_is_f64_to_bits(func.name) { return emit_builtin_f64_bits_identity(c) }
        if name_is_bits_to_f64(func.name) { return emit_builtin_f64_bits_identity(c) }
        if name_is_print_f64(func.name) { return emit_builtin_print_f64(c) }
        if name_is_exp(func.name) { return emit_builtin_exp(c) }
        if name_is_log(func.name) { return emit_builtin_log(c) }
        if name_is_sin(func.name) { return emit_builtin_sin(c) }
        if name_is_cos(func.name) { return emit_builtin_cos(c) }
        if name_is_assert(func.name) { return emit_builtin_assert(c) }
        if name_is_heap_alloc(func.name) { emit_builtin_heap_alloc_into(&! c); return c }
        if name_is_heap_free(func.name) { emit_builtin_heap_free_into(&! c); return c }
        if name_is_malloc(func.name) { emit_builtin_heap_alloc_into(&! c); return c }
        if name_is_free(func.name) { emit_builtin_heap_free_into(&! c); return c }
        if name_is_getpid(func.name) { emit_builtin_getpid_into(&! c); return c }
        if name_is_getppid(func.name) { emit_builtin_getppid_into(&! c); return c }
        if name_is_exit(func.name) { emit_builtin_exit_into(&! c); return c }
        if name_is_abort(func.name) { emit_builtin_abort_into(&! c); return c }
        if name_is_system(func.name) { emit_builtin_system_into(&! c); return c }
        if name_is_read_i64(func.name) { emit_builtin_read_offset64_into(&! c); return c }
        if name_is_write_i64(func.name) { emit_builtin_write_offset64_into(&! c); return c }
        if name_is_read_f64(func.name) { emit_builtin_read_offset64_into(&! c); return c }
        if name_is_write_f64(func.name) { emit_builtin_write_offset64_into(&! c); return c }
        if name_is_acknowledge(func.name) { return emit_builtin_knowledge_value(c) }
        if name_is_require_confidence(func.name) { return emit_builtin_knowledge_value(c) }
        if native_v2_empty_stub_would_fabricate(&func) {
            nc_emit_unimplemented_extern_trap_into(&! c)
            return c
        }
    }

    c.current_strategy = func.compile_strategy

    // --- native_v2_run_machine_regalloc (inlined, no &!) ---
    let ra_pair = native_v2_machine_ra_instrs(machine_func)
    var ra_state = liveness_compute_intervals(ra_pair.0, ra_pair.1)
    ra_state = regalloc_linear_scan(ra_state, native_target_policy_x86_allocation_order_count())

    var ra_v: i64 = 0
    while ra_v < ra_state.count {
        let ra_interval = ra_state.intervals[ra_v as usize]
        let ra_vreg = ra_interval.vreg
        if ra_vreg >= 0 && ra_vreg < NC_MAX_VREGS {
            if ra_interval.assigned_preg >= 0 {
                c.vreg_to_preg[ra_vreg as usize] = native_target_policy_x86_allocation_order_reg_id(ra_interval.assigned_preg)
            } else {
                c.vreg_to_preg[ra_vreg as usize] = ra_interval.assigned_preg
            }
            c.vreg_spill_slots[ra_vreg as usize] = ra_interval.spill_slot
        }
        ra_v = ra_v + 1
    }
    c.current_machine_base_slots = machine_func.temp_count
    c.current_machine_spill_count = ra_state.spill_count

    let preg_mask = nc_used_allocatable_preg_mask(c, machine_func.temp_count)
    let frame_size = x86_align_frame_size_for_calls(native_v2_local_frame_size(machine_func.temp_count, c.current_machine_spill_count), preg_mask)
    c.current_frame_size = frame_size

    c.code = emit_prologue_with_preg_mask(c.code, frame_size, preg_mask)

    // --- spill_ir_params (inlined, no &!) ---
    var sp_i = 0
    let sp_sret_shift = if func.is_sret == 1 { 1 } else { 0 }
    if sp_sret_shift == 1 {
        let sp_dest_reg = func.sret_dest_reg
        if sp_dest_reg >= 0 {
            c.code = emit_store_reg_rbp_disp32(c.code, ir_slot_offset(sp_dest_reg), param_reg(0))
        }
    }
    while sp_i < func.param_count && (sp_i + sp_sret_shift) < 6 {
        let sp_vreg = func.param_regs[sp_i as usize]
        if sp_vreg >= 0 {
            let sp_preg = param_reg(sp_i + sp_sret_shift)
            let sp_offset = ir_slot_offset(sp_vreg)
            c.code = emit_store_reg_rbp_disp32(c.code, sp_offset, sp_preg)
        }
        sp_i = sp_i + 1
    }
    while sp_i < func.param_count {
        let sp_vreg = func.param_regs[sp_i as usize]
        if sp_vreg >= 0 {
            let sp_in_offset = 16 + ((sp_i + sp_sret_shift - 6) * 8)
            let sp_out_offset = ir_slot_offset(sp_vreg)
            c.code = emit_load_rbp_disp32_rax(c.code, sp_in_offset)
            c.code = emit_store_reg_rbp_disp32(c.code, sp_out_offset, 0)
        }
        sp_i = sp_i + 1
    }

    // --- native_v2_emit_machine_function (inlined, no &!) ---
    let fn_offset = c.fn_offsets[fn_index as usize]
    var mi: i64 = 0
    while mi < machine_func.blocks[0].instr_count {
        let em_instr = machine_func.blocks[0].instrs[mi as usize]
        if native_v2_machine_instr_is_safepoint(em_instr) {
            let sp_kind = if em_instr.opcode == MIR_OP_CALL { NATIVE_V2_SAFEPOINT_CALL() } else { NATIVE_V2_SAFEPOINT_RET() }
            c = native_v2_record_safepoint(c, fn_index, sp_kind, mi, c.code.len - fn_offset, machine_func.temp_count, c.current_machine_spill_count)
        }
        c = native_v2_emit_machine_instr(c, em_instr)
        mi = mi + 1
    }

    let epilogue_offset = c.code.len
    c.code = emit_epilogue_with_preg_mask(c.code, preg_mask)

    // --- patch_return_jumps (inlined, no &!) ---
    var rj_i = 0
    while rj_i < c.return_jump_count {
        let rj_imm_offset = c.return_jumps[rj_i as usize]
        let rj_next_ip = rj_imm_offset + 4
        let rj_rel = epilogue_offset - rj_next_ip
        c.code = patch_u32_le(c.code, rj_imm_offset, rj_rel)
        rj_i = rj_i + 1
    }

    // --- patch_label_forwards (inlined, no &!) ---
    var lf_i = 0
    while lf_i < c.label_patch_count {
        let lf_off = c.label_patch_code_offsets[lf_i as usize]
        let lf_lid = c.label_patch_label_ids[lf_i as usize]
        let lf_target = c.label_offsets[lf_lid as usize]
        if lf_target >= 0 {
            let lf_rel = lf_target - (lf_off + 4)
            c.code = patch_u32_le(c.code, lf_off, lf_rel)
        }
        lf_i = lf_i + 1
    }

    c
}

pub fn compile_ir_function_v2_into(nc: &! NativeCompiler, func: &IrFunction, machine_func: &MachineFunction, fn_index: i64) with Mut, Panic, Div, Alloc {
    reset_function_state_mut(nc)

    let function_offset = (*nc).code.len
    native_compiler_set_fn_offset(nc, fn_index, function_offset)
    native_compiler_add_symbol_func_ref(nc, fn_index, func)

    var builtin_id = native_v2_builtin_id_for_func_ref(func)
    if builtin_id != 0 {
        if builtin_id == 1 {
            emit_builtin_print_int_into(nc)
            return
        }
        if builtin_id == 2 {
            emit_builtin_print_char_into(nc)
            return
        }
        if builtin_id == 3 {
            emit_builtin_print_str_into(nc)
            return
        }
        if builtin_id == 23 {
            emit_builtin_heap_alloc_into(nc)
            return
        }
        if builtin_id == 24 {
            emit_builtin_heap_free_into(nc)
            return
        }
        return
    }
    if native_v2_empty_stub_would_fabricate(func) {
        nc_emit_unimplemented_extern_trap_into(nc)
        return
    }

    (*nc).current_strategy = (*func).compile_strategy
    native_v2_run_machine_regalloc_ref_mut(nc, machine_func)

    let preg_mask = native_v2_used_allocatable_preg_mask_ref(nc, (*machine_func).temp_count)
    let frame_size = x86_align_frame_size_for_calls(native_v2_local_frame_size((*machine_func).temp_count, (*nc).current_machine_spill_count), preg_mask)
    (*nc).current_frame_size = frame_size

    (*nc).code = emit_prologue_with_preg_mask((*nc).code, frame_size, preg_mask)
    spill_ir_params_ref_mut(nc, func)
    native_v2_emit_machine_function_ref_mut(nc, machine_func, fn_index, function_offset)

    let epilogue_offset = (*nc).code.len
    (*nc).code = emit_epilogue_with_preg_mask((*nc).code, preg_mask)
    patch_return_jumps_mut(nc, epilogue_offset)
    patch_label_forwards_mut(nc)
}

fn nc_core_load_temp_to_rax(nc: &! NativeCompiler, temp: i64) with Mut, Panic, Div {
    if temp < 0 {
        nc_emit_xor_rax_rax(nc)
        return
    }
    nc_emit_load_rbp_disp32_rax(nc, ir_slot_offset(temp))
}

fn nc_core_store_rax_to_temp(nc: &! NativeCompiler, temp: i64) with Mut, Panic, Div {
    if temp >= 0 {
        nc_emit_store_rax_rbp_disp32(nc, ir_slot_offset(temp))
    }
}

fn nc_core_mark_float_reg(nc: &! NativeCompiler, reg: i64) with Mut, Panic, Div {
    if reg >= 0 && reg < NC_MAX_VREGS {
        (*nc).is_float_reg[reg as usize] = 1
    }
}

fn nc_core_mark_int_reg(nc: &! NativeCompiler, reg: i64) with Mut, Panic, Div {
    if reg >= 0 && reg < NC_MAX_VREGS {
        (*nc).is_float_reg[reg as usize] = 2
    }
}

fn nc_core_mark_float_field(nc: &! NativeCompiler, base_reg: i64, field_idx: i64) with Mut, Panic, Div {
    if base_reg < 0 || field_idx < 0 { return }
    var i: i64 = 0
    while i < (*nc).field_float_count && i < 256 {
        if (*nc).field_float_base_regs[i as usize] == base_reg && (*nc).field_float_indices[i as usize] == field_idx {
            return
        }
        i = i + 1
    }
    if (*nc).field_float_count < 256 {
        let slot = (*nc).field_float_count
        (*nc).field_float_base_regs[slot as usize] = base_reg
        (*nc).field_float_indices[slot as usize] = field_idx
        (*nc).field_float_count = slot + 1
    }
}

fn nc_core_field_is_float(nc: &NativeCompiler, base_reg: i64, field_idx: i64) -> bool {
    if base_reg < 0 || field_idx < 0 { return false }
    var i: i64 = 0
    while i < (*nc).field_float_count && i < 256 {
        if (*nc).field_float_base_regs[i as usize] == base_reg && (*nc).field_float_indices[i as usize] == field_idx {
            return true
        }
        i = i + 1
    }
    false
}

fn nc_emit_mov_rcx_rax(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_mov_reg_reg(nc, 1, 0)
}

fn nc_emit_and_rax_rbx(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_byte(nc, 0x48); nc_emit_byte(nc, 0x21); nc_emit_byte(nc, 0xd8)
}

fn nc_emit_xor_rax_rbx(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_byte(nc, 0x48); nc_emit_byte(nc, 0x31); nc_emit_byte(nc, 0xd8)
}

fn nc_emit_shl_rax_cl(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_byte(nc, 0x48); nc_emit_byte(nc, 0xd3); nc_emit_byte(nc, 0xe0)
}

fn nc_emit_sar_rax_cl(nc: &! NativeCompiler) with Mut, Panic, Div {
    nc_emit_byte(nc, 0x48); nc_emit_byte(nc, 0xd3); nc_emit_byte(nc, 0xf8)
}

fn nc_emit_and_bool_rax_rbx(nc: &! NativeCompiler) with Mut, Panic, Div {
    // test rbx, rbx; setne cl; test rax, rax; setne al; and al, cl; movzx rax, al
    nc_emit_byte(nc, 0x48); nc_emit_byte(nc, 0x85); nc_emit_byte(nc, 0xdb)
    nc_emit_byte(nc, 0x0f); nc_emit_byte(nc, 0x95); nc_emit_byte(nc, 0xc1)
    nc_emit_byte(nc, 0x48); nc_emit_byte(nc, 0x85); nc_emit_byte(nc, 0xc0)
    nc_emit_byte(nc, 0x0f); nc_emit_byte(nc, 0x95); nc_emit_byte(nc, 0xc0)
    nc_emit_byte(nc, 0x20); nc_emit_byte(nc, 0xc8)
    nc_emit_byte(nc, 0x48); nc_emit_byte(nc, 0x0f); nc_emit_byte(nc, 0xb6); nc_emit_byte(nc, 0xc0)
}

fn nc_emit_or_bool_rax_rbx(nc: &! NativeCompiler) with Mut, Panic, Div {
    // test rbx, rbx; setne cl; test rax, rax; setne al; or al, cl; movzx rax, al
    nc_emit_byte(nc, 0x48); nc_emit_byte(nc, 0x85); nc_emit_byte(nc, 0xdb)
    nc_emit_byte(nc, 0x0f); nc_emit_byte(nc, 0x95); nc_emit_byte(nc, 0xc1)
    nc_emit_byte(nc, 0x48); nc_emit_byte(nc, 0x85); nc_emit_byte(nc, 0xc0)
    nc_emit_byte(nc, 0x0f); nc_emit_byte(nc, 0x95); nc_emit_byte(nc, 0xc0)
    nc_emit_byte(nc, 0x08); nc_emit_byte(nc, 0xc8)
    nc_emit_byte(nc, 0x48); nc_emit_byte(nc, 0x0f); nc_emit_byte(nc, 0xb6); nc_emit_byte(nc, 0xc0)
}

