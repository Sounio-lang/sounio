    nc_emit_byte(nc, 0x48); nc_emit_byte(nc, 0x89); nc_emit_byte(nc, 0x18)
}

fn nc_emit_addsd_xmm0_xmm1(nc: &! NativeCompiler) with Mut, Panic, Div {
    // F2 0F 58 C1
    nc_emit_byte(nc, 0xF2); nc_emit_byte(nc, 0x0F); nc_emit_byte(nc, 0x58); nc_emit_byte(nc, 0xC1)
}

fn nc_emit_subsd_xmm0_xmm1(nc: &! NativeCompiler) with Mut, Panic, Div {
    // F2 0F 5C C1
    nc_emit_byte(nc, 0xF2); nc_emit_byte(nc, 0x0F); nc_emit_byte(nc, 0x5C); nc_emit_byte(nc, 0xC1)
}

fn nc_emit_mulsd_xmm0_xmm1(nc: &! NativeCompiler) with Mut, Panic, Div {
    // F2 0F 59 C1
    nc_emit_byte(nc, 0xF2); nc_emit_byte(nc, 0x0F); nc_emit_byte(nc, 0x59); nc_emit_byte(nc, 0xC1)
}

fn nc_emit_divsd_xmm0_xmm1(nc: &! NativeCompiler) with Mut, Panic, Div {
    // F2 0F 5E C1
    nc_emit_byte(nc, 0xF2); nc_emit_byte(nc, 0x0F); nc_emit_byte(nc, 0x5E); nc_emit_byte(nc, 0xC1)
}

fn nc_emit_ucomisd_xmm0_xmm1(nc: &! NativeCompiler) with Mut, Panic, Div {
    // 66 0F 2E C1
    nc_emit_byte(nc, 0x66); nc_emit_byte(nc, 0x0F); nc_emit_byte(nc, 0x2E); nc_emit_byte(nc, 0xC1)
}

fn nc_emit_core_float_binop_into(nc: &! NativeCompiler, op: BinaryOp) -> bool with Mut, Panic, Div {
    if op == BinaryOp::OpAdd {
        nc_emit_addsd_xmm0_xmm1(nc)
        nc_emit_movq_rax_xmm0(nc)
        return true
    } else if op == BinaryOp::OpSub {
        nc_emit_subsd_xmm0_xmm1(nc)
        nc_emit_movq_rax_xmm0(nc)
        return true
    } else if op == BinaryOp::OpMul {
        nc_emit_mulsd_xmm0_xmm1(nc)
        nc_emit_movq_rax_xmm0(nc)
        return true
    } else if op == BinaryOp::OpDiv {
        nc_emit_divsd_xmm0_xmm1(nc)
        nc_emit_movq_rax_xmm0(nc)
        return true
    } else if op == BinaryOp::OpEq {
        nc_emit_ucomisd_xmm0_xmm1(nc)
        nc_emit_sete_al(nc)
        nc_emit_movzx_rax_al(nc)
        return true
    } else if op == BinaryOp::OpNe {
        nc_emit_ucomisd_xmm0_xmm1(nc)
        nc_emit_setne_al(nc)
        nc_emit_movzx_rax_al(nc)
        return true
    } else if op == BinaryOp::OpLt {
        nc_emit_ucomisd_xmm0_xmm1(nc)
        nc_emit_setb_al(nc)
        nc_emit_movzx_rax_al(nc)
        return true
    } else if op == BinaryOp::OpLe {
        nc_emit_ucomisd_xmm0_xmm1(nc)
        nc_emit_setbe_al(nc)
        nc_emit_movzx_rax_al(nc)
        return true
    } else if op == BinaryOp::OpGt {
        nc_emit_ucomisd_xmm0_xmm1(nc)
        nc_emit_seta_al(nc)
        nc_emit_movzx_rax_al(nc)
        return true
    } else if op == BinaryOp::OpGe {
        nc_emit_ucomisd_xmm0_xmm1(nc)
        nc_emit_setae_al(nc)
        nc_emit_movzx_rax_al(nc)
        return true
    }
    false
}

// Fail closed on allocation exhaustion (issue #919).
// Core-IR frames do not publish precise live-root maps. Recycling the monotonic
// arena / handle table under a false "empty frame" probe retargets handles that
// remain live in callers (silent wrong values / SEGV). Until a collector can
// prove every live root is traced, STOP with a dedicated exit code.
fn nc_core_emit_alloc_failure_diagnostic_into(nc: &! NativeCompiler, fail_code: i64) with Mut, Panic, Div {
    let rodata_offset = native_v2_rodata_len_into(nc)
    // Keep this byte-oriented: String lowering in this failure path is not yet
    // reliable enough to use while reporting a runtime allocation exhaustion.
    native_v2_rodata_append_byte_into(nc, 109) // m
    native_v2_rodata_append_byte_into(nc, 97)  // a
    native_v2_rodata_append_byte_into(nc, 100) // d
    native_v2_rodata_append_byte_into(nc, 97)  // a
    native_v2_rodata_append_byte_into(nc, 114) // r
    native_v2_rodata_append_byte_into(nc, 111) // o
    native_v2_rodata_append_byte_into(nc, 115) // s
    native_v2_rodata_append_byte_into(nc, 58)  // :
    native_v2_rodata_append_byte_into(nc, 32)  // space
    if fail_code == 181 {
        native_v2_rodata_append_byte_into(nc, 97)  // a
        native_v2_rodata_append_byte_into(nc, 114) // r
        native_v2_rodata_append_byte_into(nc, 101) // e
        native_v2_rodata_append_byte_into(nc, 110) // n
        native_v2_rodata_append_byte_into(nc, 97)  // a
    } else {
        native_v2_rodata_append_byte_into(nc, 104) // h
        native_v2_rodata_append_byte_into(nc, 97)  // a
        native_v2_rodata_append_byte_into(nc, 110) // n
        native_v2_rodata_append_byte_into(nc, 100) // d
        native_v2_rodata_append_byte_into(nc, 108) // l
        native_v2_rodata_append_byte_into(nc, 101) // e
        native_v2_rodata_append_byte_into(nc, 115) // s
    }
    native_v2_rodata_append_byte_into(nc, 32)  // space
    native_v2_rodata_append_byte_into(nc, 102) // f
    native_v2_rodata_append_byte_into(nc, 117) // u
    native_v2_rodata_append_byte_into(nc, 108) // l
    native_v2_rodata_append_byte_into(nc, 108) // l
    native_v2_rodata_append_byte_into(nc, 10)  // newline

    let write_len = native_v2_rodata_len_into(nc) - rodata_offset
    let lea_pos = (*nc).code.len
    nc_emit_lea_rax_rip_disp32(nc, 0)
    nc_add_rodata_reloc(nc, lea_pos + 3, rodata_offset)
    nc_emit_mov_reg_reg(nc, 6, 0)
    nc_emit_mov_rdi_imm(nc, 2)
    nc_emit_mov_reg_imm(nc, 2, write_len)
    nc_emit_mov_rax_imm(nc, 1)
    nc_emit_syscall(nc)
}

fn nc_core_emit_alloc_fail_into(nc: &! NativeCompiler, slow_jnz: i64, fail_code: i64) with Mut, Panic, Div {
    let slow_path = (*nc).code.len
    nc_patch_u32_le(nc, slow_jnz + 2, slow_path - (slow_jnz + 6))
    nc_core_emit_alloc_failure_diagnostic_into(nc, fail_code)
    nc_emit_exit_code(nc, fail_code)
}

fn nc_core_emit_alloc_into(nc: &! NativeCompiler, dst: i64, type_tag: i64, elem_count: i64) -> bool with Mut, Panic, Div {
    let payload_size = native_v2_alloc_size_from_tag(type_tag)
    let total_size = payload_size + native_v2_object_header_size()
    let descriptor_id = native_v2_alloc_descriptor_from_tag(type_tag)
    let max_heap_payload = native_v2_arena_bytes() - runtime_context_size() - native_v2_handle_table_bytes()
    if dst < 0 || total_size <= 0 || total_size > max_heap_payload {
        return false
    }

    // ≤16 B value structs (SysV two-register return): heap-bump only, return the
    // raw object base. No handle-table slot — eliminates the 2^20 wrap trigger
    // for Rational / Box / other two-int value returns (issue #919 root fix).
    let unboxed = elem_count == 0 && native_v2_is_small_value_struct_tag(type_tag)

    emit_load_runtime_context_field_rax_into(nc, runtime_context_field_heap_cursor())
    nc_emit_mov_rdx_rax(nc)
    nc_emit_mov_reg_imm(nc, 1, total_size)
    nc_emit_add_reg_reg(nc, 0, 1)
    nc_emit_mov_reg_reg(nc, 6, 0)
    emit_load_runtime_context_field_rax_into(nc, runtime_context_field_heap_limit())
    nc_emit_mov_rbx_rax(nc)
    nc_emit_mov_reg_reg(nc, 0, 6)
    nc_emit_cmp_rbx_rax(nc)
    nc_emit_setb_al(nc)
    nc_emit_movzx_rax_al(nc)
    nc_emit_test_rax_rax(nc)
    let heap_slow_jnz = (*nc).code.len
    nc_emit_jnz_rel32(nc)

    if unboxed {
        // Fast path: bump cursor, stamp header with handle_id=0, return object base.
        nc_emit_mov_reg_reg(nc, 0, 6)
        emit_store_rax_runtime_context_field_into(nc, runtime_context_field_heap_cursor())

        nc_emit_mov_rax_rdx(nc)
        nc_emit_mov_rbx_rax(nc)
        nc_emit_mov_rax_imm(nc, descriptor_id)
        nc_emit_store_rax_mem_rbx_disp32(nc, native_v2_object_header_field_descriptor_id())
        nc_emit_mov_rax_imm(nc, payload_size)
        nc_emit_store_rax_mem_rbx_disp32(nc, native_v2_object_header_field_payload_size())
        nc_emit_xor_rax_rax(nc)
        nc_emit_store_rax_mem_rbx_disp32(nc, native_v2_object_header_field_flags())
        nc_emit_store_rax_mem_rbx_disp32(nc, native_v2_object_header_field_handle_id())
        // rax = object base (raw pointer encoding for hybrid resolve)
        nc_emit_mov_rax_rdx(nc)
        let done_jmp_u = (*nc).code.len
        nc_emit_jmp_rel32(nc)

        nc_core_emit_alloc_fail_into(nc, heap_slow_jnz, 181)

        let done_target_u = (*nc).code.len
        nc_patch_u32_le(nc, done_jmp_u + 1, done_target_u - (done_jmp_u + 5))
        nc_core_store_rax_to_temp(nc, dst)
        return true
    }

    emit_load_runtime_context_field_rax_into(nc, runtime_context_field_handle_count())
    nc_emit_mov_rbx_rax(nc)
    nc_emit_mov_reg_imm(nc, 1, 1)
    nc_emit_add_reg_reg(nc, 3, 1)
    nc_emit_mov_reg_reg(nc, 7, 3)
    emit_load_runtime_context_field_rax_into(nc, runtime_context_field_handle_capacity())
    nc_emit_mov_reg_reg(nc, 3, 7)
    nc_emit_cmp_rbx_rax(nc)
    nc_emit_setae_al(nc)
    nc_emit_movzx_rax_al(nc)
    nc_emit_test_rax_rax(nc)
    let handle_slow_jnz = (*nc).code.len
    nc_emit_jnz_rel32(nc)

    nc_emit_mov_rax_rbx(nc)
    nc_emit_push_rax(nc)
    nc_emit_mov_reg_reg(nc, 0, 6)
    emit_store_rax_runtime_context_field_into(nc, runtime_context_field_heap_cursor())

    nc_emit_mov_rax_rdx(nc)
    nc_emit_mov_rbx_rax(nc)
    nc_emit_mov_rax_imm(nc, descriptor_id)
    nc_emit_store_rax_mem_rbx_disp32(nc, native_v2_object_header_field_descriptor_id())
    nc_emit_mov_rax_imm(nc, payload_size)
    nc_emit_store_rax_mem_rbx_disp32(nc, native_v2_object_header_field_payload_size())
    // Object-header `flags` slot carries the LOGICAL element count for array
    // allocations (0 for struct/tuple/scalar). The payload_size above is a
    // size-BUCKET capacity in bytes, not the logical N, so IrArrayLen reads this
    // slot instead. Non-array allocs pass elem_count = 0 → flags stays 0.
    nc_emit_mov_rax_imm(nc, elem_count)
    nc_emit_store_rax_mem_rbx_disp32(nc, native_v2_object_header_field_flags())
    nc_emit_pop_rax(nc)
    nc_emit_store_rax_mem_rbx_disp32(nc, native_v2_object_header_field_handle_id())
    nc_emit_push_rax(nc)

    nc_emit_mov_rbx_rax(nc)
    nc_emit_imul_rbx_rbx_imm8(nc, native_v2_handle_entry_size())
    nc_emit_mov_reg_reg(nc, 7, 3)
    emit_load_runtime_context_field_rax_into(nc, runtime_context_field_handle_table_base())
    nc_emit_mov_reg_reg(nc, 3, 7)
    nc_emit_add_rax_rbx(nc)
    nc_emit_mov_rbx_rax(nc)
    nc_emit_mov_rax_rdx(nc)
    nc_emit_store_rax_mem_rbx_disp32(nc, native_v2_handle_entry_field_object_base())
    nc_emit_mov_rax_imm(nc, total_size)
    nc_emit_store_rax_mem_rbx_disp32(nc, native_v2_handle_entry_field_object_size())
    nc_emit_mov_rax_imm(nc, descriptor_id)
    nc_emit_store_rax_mem_rbx_disp32(nc, native_v2_handle_entry_field_descriptor_id())
    nc_emit_xor_rax_rax(nc)
    nc_emit_store_rax_mem_rbx_disp32(nc, native_v2_handle_entry_field_pin_count())
    nc_emit_store_rax_mem_rbx_disp32(nc, native_v2_handle_entry_field_flags())
    nc_emit_store_rax_mem_rbx_disp32(nc, native_v2_handle_entry_field_epoch())

    nc_emit_pop_rax(nc)
    emit_store_rax_runtime_context_field_into(nc, runtime_context_field_handle_count())
    let done_jmp = (*nc).code.len
    nc_emit_jmp_rel32(nc)

    nc_core_emit_alloc_fail_into(nc, heap_slow_jnz, 181)
    nc_core_emit_alloc_fail_into(nc, handle_slow_jnz, 182)

    let done_target = (*nc).code.len
    nc_patch_u32_le(nc, done_jmp + 1, done_target - (done_jmp + 5))
    nc_core_store_rax_to_temp(nc, dst)
    true
}

fn nc_rodata_add_ir_instr_name(nc: &! NativeCompiler, func: &IrFunction, instr_index: i64) -> i64 with Mut, Panic, Div {
    var len = (*nc).flat_rodata_len
    let offset = len
    var i = 0
    let name_len = ir_arena_name(ir_region_slot_r((*func).region, (instr_index))).len
    while i < name_len && len < 262144 {
        NC_BIG_RODATA[len as usize] = ir_arena_name(ir_region_slot_r((*func).region, (instr_index))).buf[i as usize]
        len = len + 1
        i = i + 1
    }
    if len < 262144 {
        NC_BIG_RODATA[len as usize] = 0
        len = len + 1
    }
    (*nc).flat_rodata_len = len
    offset
}

fn nc_rodata_add_name_value(nc: &! NativeCompiler, name: Name) -> i64 with Mut, Panic, Div {
    var len = (*nc).flat_rodata_len
    let offset = len
    var i = 0
    while i < name.len && len < 262144 {
        NC_BIG_RODATA[len as usize] = name.buf[i as usize]
        len = len + 1
        i = i + 1
    }
    if len < 262144 {
        NC_BIG_RODATA[len as usize] = 0
        len = len + 1
    }
    (*nc).flat_rodata_len = len
    offset
}

fn nc_emit_core_binop(nc: &! NativeCompiler, func: &IrFunction, instr_index: i64) -> bool with Mut, Panic, Div {
    let lhs = IR_A_SRC1[(ir_region_slot_r((*func).region, (instr_index))) as usize]
    let rhs = IR_A_SRC2[(ir_region_slot_r((*func).region, (instr_index))) as usize]
    let dst = IR_A_DST[(ir_region_slot_r((*func).region, (instr_index))) as usize]
    let op = (IR_A_BIN_OP[(ir_region_slot_r((*func).region, (instr_index))) as usize] as BinaryOp)

    let flags = IR_A_IMM_FLAGS[(ir_region_slot_r((*func).region, (instr_index))) as usize]
    let lhs_float_marked = (flags / 2) & 1
    let rhs_float_marked = (flags / 4) & 1
    let lhs_known_int = if lhs >= 0 && lhs < NC_MAX_VREGS && (*nc).is_float_reg[lhs as usize] == 2 { 1 } else { 0 }
    let rhs_known_int = if rhs >= 0 && rhs < NC_MAX_VREGS && (*nc).is_float_reg[rhs as usize] == 2 { 1 } else { 0 }
    // Path-sound float override: for arithmetic AND comparison ops, also count an
    // operand as float when the fixpoint typing (nc_compute_float_types) proved its
    // register is a pure FLOAT — every reaching definition is float. This rescues
    // f64 params / f64-derived intermediates that the lowering imm_flags bits miss
    // (their idents classify via scalar_kind, unset for f64 params). Comparisons
    // MUST be included: an f64 compare left on the integer path mis-orders negatives
    // (the sign bit makes -2.0's bits compare ABOVE -1.0's) and mishandles
    // `param == literal`. Bitwise/shift never override; they stay marker-only.
    let op_is_arith = if op == BinaryOp::OpAdd || op == BinaryOp::OpSub || op == BinaryOp::OpMul || op == BinaryOp::OpDiv { 1 } else { 0 }
    let op_is_compare = if op == BinaryOp::OpLt || op == BinaryOp::OpLe || op == BinaryOp::OpGt || op == BinaryOp::OpGe || op == BinaryOp::OpEq || op == BinaryOp::OpNe { 1 } else { 0 }
    let op_wants_float_typing = if op_is_arith == 1 || op_is_compare == 1 { 1 } else { 0 }
    let lhs_typed_float = if op_wants_float_typing == 1 && lhs >= 0 && lhs < NC_MAX_VREGS && (*nc).reg_type[lhs as usize] == 1 { 1 } else { 0 }
    let rhs_typed_float = if op_wants_float_typing == 1 && rhs >= 0 && rhs < NC_MAX_VREGS && (*nc).reg_type[rhs as usize] == 1 { 1 } else { 0 }
    let lhs_is_float = if (lhs_float_marked == 1 || lhs_typed_float == 1) && lhs_known_int == 0 { 1 } else { 0 }
    let rhs_is_float = if (rhs_float_marked == 1 || rhs_typed_float == 1) && rhs_known_int == 0 { 1 } else { 0 }
    if lhs_is_float == 1 || rhs_is_float == 1 {
        nc_core_load_temp_to_rax(nc, lhs)
        if lhs_is_float == 1 {
            nc_emit_movq_xmm0_rax(nc)
        } else {
            nc_emit_cvtsi2sd_xmm0_rax(nc)
        }

        nc_core_load_temp_to_rax(nc, rhs)
        if rhs_is_float == 1 {
            nc_emit_movq_xmm1_rax(nc)
        } else {
            nc_emit_cvtsi2sd_xmm0_rax(nc)
            nc_emit_movq_rax_xmm0(nc)
            nc_emit_movq_xmm1_rax(nc)
            nc_core_load_temp_to_rax(nc, lhs)
            if lhs_is_float == 1 {
                nc_emit_movq_xmm0_rax(nc)
            } else {
                nc_emit_cvtsi2sd_xmm0_rax(nc)
            }
        }

        if !nc_emit_core_float_binop_into(nc, op) {
            return false
        }
        nc_core_store_rax_to_temp(nc, dst)
        if op == BinaryOp::OpLt || op == BinaryOp::OpLe || op == BinaryOp::OpGt || op == BinaryOp::OpGe || op == BinaryOp::OpEq || op == BinaryOp::OpNe {
            nc_core_mark_int_reg(nc, dst)
        } else {
            nc_core_mark_float_reg(nc, dst)
        }
        return true
    }

    if op == BinaryOp::OpAdd {
        nc_core_load_temp_to_rax(nc, lhs)
        nc_emit_push_rax(nc)
        nc_core_load_temp_to_rax(nc, rhs)
        nc_emit_pop_rbx(nc)
        nc_emit_add_rax_rbx(nc)
        nc_core_store_rax_to_temp(nc, dst)
        nc_core_mark_int_reg(nc, dst)
        return true
    }
    if op == BinaryOp::OpSub {
        nc_core_load_temp_to_rax(nc, rhs)
        nc_emit_push_rax(nc)
        nc_core_load_temp_to_rax(nc, lhs)
        nc_emit_pop_rbx(nc)
        nc_emit_sub_rax_rbx(nc)
        nc_core_store_rax_to_temp(nc, dst)
        nc_core_mark_int_reg(nc, dst)
        return true
    }
    if op == BinaryOp::OpMul {
        nc_core_load_temp_to_rax(nc, lhs)
        nc_emit_push_rax(nc)
        nc_core_load_temp_to_rax(nc, rhs)
        nc_emit_pop_rbx(nc)
        nc_emit_imul_rax_rbx(nc)
        nc_core_store_rax_to_temp(nc, dst)
        nc_core_mark_int_reg(nc, dst)
        return true
    }
    if op == BinaryOp::OpDiv {
        nc_core_load_temp_to_rax(nc, rhs)
        nc_emit_mov_reg_reg(nc, 1, 0)
        nc_core_load_temp_to_rax(nc, lhs)
        nc_emit_cqo(nc)
        nc_emit_idiv_rcx(nc)
        nc_core_store_rax_to_temp(nc, dst)
        nc_core_mark_int_reg(nc, dst)
        return true
    }
    if op == BinaryOp::OpRem {
        nc_core_load_temp_to_rax(nc, rhs)
        nc_emit_mov_reg_reg(nc, 1, 0)
        nc_core_load_temp_to_rax(nc, lhs)
        nc_emit_cqo(nc)
        nc_emit_idiv_rcx(nc)
        nc_emit_mov_rax_rdx(nc)
        nc_core_store_rax_to_temp(nc, dst)
        nc_core_mark_int_reg(nc, dst)
        return true
    }
    if op == BinaryOp::OpAnd || op == BinaryOp::OpOr || op == BinaryOp::OpBitAnd || op == BinaryOp::OpBitOr || op == BinaryOp::OpBitXor {
        nc_core_load_temp_to_rax(nc, lhs)
        nc_emit_push_rax(nc)
        nc_core_load_temp_to_rax(nc, rhs)
        nc_emit_pop_rbx(nc)
        if op == BinaryOp::OpAnd {
            nc_emit_and_bool_rax_rbx(nc)
        } else if op == BinaryOp::OpOr {
            nc_emit_or_bool_rax_rbx(nc)
        } else if op == BinaryOp::OpBitAnd {
            nc_emit_and_rax_rbx(nc)
        } else if op == BinaryOp::OpBitOr {
            nc_emit_or_rax_rbx(nc)
        } else {
            nc_emit_xor_rax_rbx(nc)
        }
        nc_core_store_rax_to_temp(nc, dst)
        nc_core_mark_int_reg(nc, dst)
        return true
    }
    if op == BinaryOp::OpShl || op == BinaryOp::OpShr {
        nc_core_load_temp_to_rax(nc, lhs)
        nc_emit_push_rax(nc)
        nc_core_load_temp_to_rax(nc, rhs)
        nc_emit_pop_rbx(nc)
        nc_emit_mov_rcx_rax(nc)
        nc_emit_mov_rax_rbx(nc)
        if op == BinaryOp::OpShl {
            nc_emit_shl_rax_cl(nc)
        } else {
            nc_emit_sar_rax_cl(nc)
        }
        nc_core_store_rax_to_temp(nc, dst)
        nc_core_mark_int_reg(nc, dst)
        return true
    }
    // Comparison ops: push lhs, load rhs into rax, pop lhs into rbx
    // CMP RAX, RBX = rhs - lhs; setXX conditions are flipped vs intuition
    if op == BinaryOp::OpLt || op == BinaryOp::OpLe || op == BinaryOp::OpGt || op == BinaryOp::OpGe || op == BinaryOp::OpEq || op == BinaryOp::OpNe {
        nc_core_load_temp_to_rax(nc, lhs)
        nc_emit_push_rax(nc)
        nc_core_load_temp_to_rax(nc, rhs)
        nc_emit_pop_rbx(nc)
        // rax=rhs, rbx=lhs; CMP RAX,RBX = rhs-lhs
        nc_emit_cmp_rax_rbx(nc)
        // setg: rhs>lhs, i.e. lhs<rhs; setle: rhs<=lhs, i.e. lhs>=rhs; etc.
        if op == BinaryOp::OpLt { nc_emit_setg_al(nc) }
        else if op == BinaryOp::OpLe { nc_emit_setge_al(nc) }
        else if op == BinaryOp::OpGt { nc_emit_setl_al(nc) }
        else if op == BinaryOp::OpGe { nc_emit_setle_al(nc) }
        else if op == BinaryOp::OpEq { nc_emit_sete_al(nc) }
        else { nc_emit_setne_al(nc) }
        nc_emit_movzx_rax_al(nc)
        nc_core_store_rax_to_temp(nc, dst)
        nc_core_mark_int_reg(nc, dst)
        return true
    }
    false
}

fn nc_core_call_arg_at(args: Option<Box<IrRegList>>, index: i64) -> i64 with Mut, Panic, Div {
    if index < 0 {
        return -1
    }
    match args {
        Some(list) => {
            if index == 0 {
                return (*list).head
            }
            nc_core_call_arg_at((*list).tail, index - 1)
        }
        _ => -1,
    }
}

fn nc_core_func_param_index(func: &IrFunction, reg: i64) -> i64 with Mut, Panic, Div {
    var i = 0
    while i < (*func).param_count && i < 64 {
        if (*func).param_regs[i as usize] == reg {
            return i
        }
        i = i + 1
    }
    -1
}

fn nc_core_load_call_arg_into(nc: &! NativeCompiler, func: &IrFunction, instr_index: i64, arg_index: i64, preg: i64) -> bool with IO, Mut, Panic, Div {
    let arg = ir_arena_arg_at(ir_region_slot_r((*func).region, (instr_index)), arg_index)
    if arg < 0 {
        if native_v2_ir_trace_enabled() {
            print("NV2_IR missing_call_arg fn=")
            print(str_from_bytes((*func).name.buf, (*func).name.len))
            print(" i=")
            print_int(instr_index)
            print(" arg_index=")
            print_int(arg_index)
            print(" arg_count=")
            print_int(IR_A_ARG_COUNT[(ir_region_slot_r((*func).region, (instr_index))) as usize])
            print(" src1=")
            print_int(IR_A_SRC1[(ir_region_slot_r((*func).region, (instr_index))) as usize])
            print(" src2=")
            print_int(IR_A_SRC2[(ir_region_slot_r((*func).region, (instr_index))) as usize])
            print("\n")
        }
        return false
    }
    nc_emit_load_rbp_disp32_reg(nc, preg, ir_slot_offset(arg))
    true
}

fn nc_core_load_call_arg_to_rax(nc: &! NativeCompiler, func: &IrFunction, instr_index: i64, arg_index: i64) -> bool with Mut, Panic, Div {
    let arg = ir_arena_arg_at(ir_region_slot_r((*func).region, (instr_index)), arg_index)
    if arg < 0 {
        return false
    }
    nc_core_load_temp_to_rax(nc, arg)
    true
}

fn nc_core_stack_call_cleanup_bytes(argc: i64, reg_arg_limit: i64) -> i64 with Div {
    if argc <= reg_arg_limit {
        return 0
    }
    let stack_count = argc - reg_arg_limit
    var bytes = stack_count * 8
    if (stack_count % 2) != 0 {
        bytes = bytes + 8
    }
    bytes
}

fn nc_core_push_call_stack_args(nc: &! NativeCompiler, func: &IrFunction, instr_index: i64, argc: i64) -> bool with Mut, Panic, Div {
    if argc <= 6 {
        return true
    }
    let stack_count = argc - 6
    if (stack_count % 2) != 0 {
        nc_emit_sub_rsp_imm32(nc, 8)
    }
    var idx = argc - 1
    while idx >= 6 {
        if !nc_core_load_call_arg_to_rax(nc, func, instr_index, idx) {
            return false
        }
        nc_emit_push_rax(nc)
        idx = idx - 1
    }
    true
}

fn nc_core_push_sret_stack_args(nc: &! NativeCompiler, first_arg: i64, argc: i64) -> bool with Mut, Panic, Div {
    if argc <= 5 {
        return true
    }
    if first_arg < 0 {
        return false
    }
    let stack_count = argc - 5
    if (stack_count % 2) != 0 {
        nc_emit_sub_rsp_imm32(nc, 8)
    }
    var idx = argc - 1
    while idx >= 5 {
        nc_core_load_temp_to_rax(nc, first_arg + idx)
        nc_emit_push_rax(nc)
        idx = idx - 1
    }
    true
}

fn nc_core_emit_println_i64_literal_sentinel_into(nc: &! NativeCompiler, value: i64) -> bool with Mut, Panic, Div {
    if value < 0 || value > 999 {
        return false
    }

    let rodata_offset = native_v2_rodata_len_into(nc)
    if value >= 100 {
        native_v2_rodata_append_byte_into(nc, 48 + ((value / 100) % 10))
    }
    if value >= 10 {
        native_v2_rodata_append_byte_into(nc, 48 + ((value / 10) % 10))
    }
    native_v2_rodata_append_byte_into(nc, 48 + (value % 10))
    native_v2_rodata_append_byte_into(nc, 10)

    let write_len = native_v2_rodata_len_into(nc) - rodata_offset
    let lea_pos = (*nc).code.len
    nc_emit_lea_rax_rip_disp32(nc, 0)
    nc_add_rodata_reloc(nc, lea_pos + 3, rodata_offset)
    nc_emit_mov_reg_reg(nc, 6, 0)
    nc_emit_mov_rdi_imm(nc, 1)
    nc_emit_mov_reg_imm(nc, 2, write_len)
    nc_emit_mov_rax_imm(nc, 1)
    nc_emit_syscall(nc)
    true
}

// Path-sound register float typing: a fixpoint over the IR that classifies every
// register as UNKNOWN(0) / FLOAT(1) / INT(2) / CONFLICT(3). Each register's type
// is the JOIN over all its definitions of that definition's computed type, and the
// type of an ARITHMETIC result is derived from its OPERANDS' types (propagated) —
// so `a*a` over f64 params is FLOAT while `i+1` over an int counter is INT, and a
// register reused for both float and int across branches/loops becomes CONFLICT.
// Iterating to a fixpoint (the lattice only moves up, so it converges) makes this
// correct for loop-carried and merge values, unlike the linear is_float_reg scan.
// nc_emit_core_binop treats an operand as float via this typing ONLY when it is a
// pure FLOAT(1) — never when INT or CONFLICT — which is sound because FLOAT means
// every reaching definition is float. f64 float literals still reach SSE via the
// lowering imm_flags bits (their loadimm+marker pair makes them CONFLICT here).
fn nc_compute_float_types(nc: &! NativeCompiler, func: &IrFunction) with Mut, Panic, Div {
    var ty: [i64; 2048] = [0; 2048]
    // #1669: seed the lattice from the function-scoped float bits before the
    // fixpoint. Equivalent to today's marker-as-definition join -- join(UNKNOWN,
    // FLOAT) = FLOAT -- and a later int def still drives the reg to CONFLICT.
    var fb: i64 = 0
    while fb < ir_float_bits_capacity() && IR_FLOAT_BITS_TRUSTED == 1 {
        if ir_float_bits_get(func, fb) { ty[fb as usize] = 1 }
        fb = fb + 1
    }
    var changed = true
    var iters = 0
    while changed && iters < 24 {
        changed = false
        var i = 0
        while i < (*func).instr_count && i < IR_MAX_INSTRS {
            let op = (IR_A_OP[(ir_region_slot_r((*func).region, (i))) as usize] as IrOpcode)
            let d = IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize]
            let s1 = IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize]
            let s2 = IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize]
            let fl = IR_A_IMM_FLAGS[(ir_region_slot_r((*func).region, (i))) as usize]
            // def: type produced by this instruction (-1 = produces no recorded def)
            var def = -1
            if op == IrOpcode::IrNop {
                if fl == IR_FLOAT_REG_MARKER_FLAG { def = 1 }
            } else if op == IrOpcode::IrLoadImm {
                def = 2
            } else if op == IrOpcode::IrUnaryOp {
                let uop = (IR_A_UN_OP[(ir_region_slot_r((*func).region, (i))) as usize] as UnaryOp)
                if uop == UnaryOp::OpNeg {
                    let t1 = if s1 >= 0 && s1 < NC_MAX_VREGS { ty[s1 as usize] } else { 0 }
                    if t1 == 1 {
                        def = 1
                    } else if t1 == 2 {
                        def = 2
                    } else {
                        def = 0
                    }
                } else {
                    def = 2
                }
            } else if op == IrOpcode::IrCopy {
                if s1 >= 0 && s1 < NC_MAX_VREGS { def = ty[s1 as usize] }
            } else if op == IrOpcode::IrCall || op == IrOpcode::IrFieldGet || op == IrOpcode::IrIndexGet {
                if fl == IR_FLOAT_REG_MARKER_FLAG { def = 1 } else { def = 2 }
            } else if op == IrOpcode::IrBinOp {
                let bop = (IR_A_BIN_OP[(ir_region_slot_r((*func).region, (i))) as usize] as BinaryOp)
                if bop == BinaryOp::OpAdd || bop == BinaryOp::OpSub || bop == BinaryOp::OpMul || bop == BinaryOp::OpDiv {
                    let lf = ((fl / 2) & 1) == 1
                    let rf = ((fl / 4) & 1) == 1
                    let t1 = if s1 >= 0 && s1 < NC_MAX_VREGS { ty[s1 as usize] } else { 0 }
                    let t2 = if s2 >= 0 && s2 < NC_MAX_VREGS { ty[s2 as usize] } else { 0 }
                    if lf || rf || t1 == 1 || t2 == 1 {
                        def = 1
                    } else if t1 == 2 && t2 == 2 {
                        def = 2
                    } else {
                        def = 0
                    }
                } else {
                    def = 2
                }
            }
            if d >= 0 && d < NC_MAX_VREGS && def >= 0 {
                let cur = ty[d as usize]
                var nv = cur
                if cur == 0 {
                    nv = def
                } else if def == 0 {
                    nv = cur
                } else if cur == def {
                    nv = cur
                } else {
                    nv = 3
                }
                if nv != cur {
                    ty[d as usize] = nv
                    changed = true
                }
            }
            i = i + 1
        }
        iters = iters + 1
    }
    var r = 0
    while r < NC_MAX_VREGS {
        (*nc).reg_type[r as usize] = ty[r as usize]
        r = r + 1
    }
}

pub fn compile_ir_function_v2_core_ir_into(nc: &! NativeCompiler, func: &IrFunction, fn_index: i64) -> bool with IO, Mut, Panic, Div, Alloc {
    nc_refresh_wide_mul_sabotage()
    nc_v2_reset_label_state()
    NC_V2_CURRENT_FN_INDEX = fn_index
    reset_function_state_mut(nc)
    nc_compute_float_types(nc, func)
    let function_offset = (*nc).code.len
    native_compiler_set_fn_offset(nc, fn_index, function_offset)
    native_compiler_add_symbol_func_ref(nc, fn_index, func)

    nc_emit_push_rbp(nc)
    nc_emit_mov_rbp_rsp(nc)
    let frame_sz = align16((*func).reg_count * 8)
    if frame_sz > 0 {
        nc_emit_sub_rsp_imm32(nc, frame_sz)
    }
    spill_ir_params_ref_mut(nc, func)

    // saw_return: defense against truncated IR (pre-4096 IR_MAX_INSTRS wall dropped
    // IrReturn on unsplit oct_mul → fallthrough into the next function / main
    // re-entry storm). Always close the frame if no IrReturn/IrReturnSret was seen.
    var saw_return = false
    // #1669: pre-mark from the function-scoped bits. The in-stream arm below stays
    // during the soak; this is the channel that survives a pass deleting the nop.
    var pfb: i64 = 0
    while pfb < ir_float_bits_capacity() && IR_FLOAT_BITS_TRUSTED == 1 {
        if ir_float_bits_get(func, pfb) { nc_core_mark_float_reg(nc, pfb) }
        pfb = pfb + 1
    }
    // #1669 AGREEMENT PROBE, diagnostic only, off unless SOUNIO_FLOAT_AGREE=1.
    // Before trusting the bitset we have to know what trusting it would CHANGE.
    // bits_only is the whole point -- a register the bitset knows about and the
    // in-stream marker does not, i.e. a marker some pass deleted. markers_only
    // is the danger: information the bitset LOST.
    //
    // No scratch array on purpose. A [i64; 2048] here is 16 KB inside a function
    // whose frame the compiler already warns about, and the first version of this
    // probe killed the build with it. Set bits are few, so scanning per bit is
    // cheaper than the table.
    if str_eq(read_env("SOUNIO_FLOAT_AGREE"), "1") {
        var n_bits: i64 = 0
        var n_mark: i64 = 0
        var n_bits_only: i64 = 0
        var n_mark_only: i64 = 0

        var mi: i64 = 0
        while mi < (*func).instr_count && mi < IR_MAX_INSTRS {
            let mslot = ir_region_slot_r((*func).region, (mi))
            if (IR_A_OP[mslot as usize] as IrOpcode) == IrOpcode::IrNop
                && IR_A_IMM_FLAGS[mslot as usize] == IR_FLOAT_REG_MARKER_FLAG {
                let mr = IR_A_DST[mslot as usize]
                n_mark = n_mark + 1
                if mr >= 0 && !ir_float_bits_get(func, mr) { n_mark_only = n_mark_only + 1 }
            }
            mi = mi + 1
        }

        var r: i64 = 0
        while r < ir_float_bits_capacity() {
            if ir_float_bits_get(func, r) {
                n_bits = n_bits + 1
                var seen = false
                var si: i64 = 0
                while si < (*func).instr_count && si < IR_MAX_INSTRS {
                    let sslot = ir_region_slot_r((*func).region, (si))
                    if (IR_A_OP[sslot as usize] as IrOpcode) == IrOpcode::IrNop
                        && IR_A_IMM_FLAGS[sslot as usize] == IR_FLOAT_REG_MARKER_FLAG
                        && IR_A_DST[sslot as usize] == r {
                        seen = true
                        si = (*func).instr_count
                    } else {
                        si = si + 1
                    }
                }
                if !seen { n_bits_only = n_bits_only + 1 }
            }
            r = r + 1
        }

        print("[float-agree] fn=")
        print_int(fn_index)
        print(" bits=")
        print_int(n_bits)
        print(" markers=")
        print_int(n_mark)
        print(" bits_only=")
        print_int(n_bits_only)
        print(" markers_only=")
        print_int(n_mark_only)
        print("\n")
    }
    var i = 0
    while i < (*func).instr_count && i < IR_MAX_INSTRS {
        // #1669 ORDERING FIX, under test. The up-front pre-mark above is applied
        // BEFORE any instruction is processed, so anything that marks a register
        // int later in the stream clobbers it -- which is precisely why the
        // in-stream marker works and the bits do not: the marker is honoured at
        // its position, the seed is not. Re-asserting the bits each step makes
        // them positional too. Only registers whose bit is set are touched, and
        // those are float by construction.
        if IR_FLOAT_BITS_TRUSTED == 1 {
            var rfb: i64 = 0
            while rfb < ir_float_bits_capacity() {
                if ir_float_bits_get(func, rfb) { nc_core_mark_float_reg(nc, rfb) }
                rfb = rfb + 1
            }
        }
        let instr_op = (IR_A_OP[(ir_region_slot_r((*func).region, (i))) as usize] as IrOpcode)
        if instr_op == IrOpcode::IrNop && IR_A_IMM_FLAGS[(ir_region_slot_r((*func).region, (i))) as usize] == IR_FLOAT_REG_MARKER_FLAG
 {
            let mark_reg = IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize]
            // Always honor an explicit float-marker IrNop. The previous guard
            // skipped marking when is_float_reg[mark_reg]==2 (int), but a preceding
            // IrLoadImm sets =2 on f64 literals, so the guard vetoed the float mark
            // for `0.1 * 0.1` etc. → the literal kept int regs and took integer imul
            // on the IEEE bit-patterns (result 0). The guard was a stale #478
            // neutralizer; #478 is now fixed at source in lower.sio, so this marker
            // is only emitted for genuinely-float values. nc_core_mark_float_reg
            // bounds-checks internally.
            //
            // The IR_FLOAT_NO_MARKERS switch belongs HERE, not on the arm's
            // condition. Guarding the condition made a marker nop fall through
            // to the following `else if` arms, changing emission rather than
            // just withholding the mark -- so the first version of this
            // experiment measured the fallthrough and I nearly reported it as
            // "the bits do not carry it".
            if IR_FLOAT_NO_MARKERS == 0 {
                nc_core_mark_float_reg(nc, mark_reg)
            }
        } else if instr_op == IrOpcode::IrLoadImm {
            let imm_value = IR_A_IMM_I64[(ir_region_slot_r((*func).region, (i))) as usize]
            if imm_value == (0 - 4242) {
                if i < 1 {
                    return false
                }
                let prev_instr = ir_arena_load(ir_region_slot_r((*func).region, ((i - 1))))
                if prev_instr.op != IrOpcode::IrLoadImm {
                    return false
                }
                if !nc_core_emit_println_i64_literal_sentinel_into(nc, prev_instr.imm_i64) {
                    return false
                }
                nc_emit_mov_rax_imm(nc, 0)
                nc_core_store_rax_to_temp(nc, prev_instr.dst)
            } else {
                nc_emit_mov_rax_imm(nc, imm_value)
                nc_core_store_rax_to_temp(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
                nc_core_mark_int_reg(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
            }
        } else if instr_op == IrOpcode::IrLoadBool {
            nc_emit_mov_rax_imm(nc, IR_A_IMM_I64[(ir_region_slot_r((*func).region, (i))) as usize])
            nc_core_store_rax_to_temp(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
            nc_core_mark_int_reg(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
        } else if instr_op == IrOpcode::IrLoadFloat {
            nc_emit_mov_rax_imm(nc, f64_to_bits(IR_A_IMM_F64[(ir_region_slot_r((*func).region, (i))) as usize]))
            nc_core_store_rax_to_temp(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
            nc_core_mark_float_reg(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
        } else if instr_op == IrOpcode::IrIntToFloat {
            nc_core_load_temp_to_rax(nc, IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize])
            nc_emit_cvtsi2sd_xmm0_rax(nc)
            nc_emit_movq_rax_xmm0(nc)
            nc_core_store_rax_to_temp(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
            nc_core_mark_float_reg(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
        } else if instr_op == IrOpcode::IrFloatToInt {
            nc_core_load_temp_to_rax(nc, IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize])
            nc_emit_movq_xmm0_rax(nc)
            nc_emit_cvttsd2si_rax_xmm0(nc)
            nc_core_store_rax_to_temp(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
            nc_core_mark_int_reg(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
        } else if instr_op == IrOpcode::IrLoadString {
            let str_offset = nc_rodata_add_ir_instr_name(nc, func, i)
            let lea_pos = (*nc).code.len
            nc_emit_lea_rax_rip_disp32(nc, 0)
            nc_add_rodata_reloc(nc, lea_pos + 3, str_offset)
            nc_core_store_rax_to_temp(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
        } else if instr_op == IrOpcode::IrFieldGet {
            if IR_A_LABEL_ID[(ir_region_slot_r((*func).region, (i))) as usize] == 1 {
                native_v2_core_emit_load_ref_field_into(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize], IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize], IR_A_FIELD_IDX[(ir_region_slot_r((*func).region, (i))) as usize])
            } else {
                nc_core_load_temp_to_rax(nc, IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize])
                native_v2_resolve_handle_to_object_base_rax_into(nc)
                nc_emit_mov_reg_imm(nc, 3, IR_A_FIELD_IDX[(ir_region_slot_r((*func).region, (i))) as usize] + native_v2_object_header_size() / 8)
                nc_emit_mov_rax_mem_rax_rbx8(nc)
                nc_core_store_rax_to_temp(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
            }
            if IR_A_IMM_FLAGS[(ir_region_slot_r((*func).region, (i))) as usize] == IR_FLOAT_REG_MARKER_FLAG || nc_core_field_is_float(nc, IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize], IR_A_FIELD_IDX[(ir_region_slot_r((*func).region, (i))) as usize]) {
                nc_core_mark_float_reg(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
            } else {
                nc_core_mark_int_reg(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
            }
        } else if instr_op == IrOpcode::IrFieldSet {
            if IR_A_LABEL_ID[(ir_region_slot_r((*func).region, (i))) as usize] == 1 {
                native_v2_core_emit_store_ref_field_into(nc, IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize], IR_A_FIELD_IDX[(ir_region_slot_r((*func).region, (i))) as usize], IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize])
            } else {
                nc_core_load_temp_to_rax(nc, IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize])
                native_v2_resolve_handle_to_object_base_rax_into(nc)
                nc_emit_mov_rdx_rax(nc)
                nc_core_load_temp_to_rax(nc, IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize])
                nc_emit_mov_reg_imm(nc, 3, IR_A_FIELD_IDX[(ir_region_slot_r((*func).region, (i))) as usize] + native_v2_object_header_size() / 8)
                nc_emit_store_rax_mem_rdx_rbx8(nc)
            }
            if IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize] >= 0 && IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize] < NC_MAX_VREGS {
                if (*nc).is_float_reg[IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize] as usize] == 1 {
                    nc_core_mark_float_field(nc, IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize], IR_A_FIELD_IDX[(ir_region_slot_r((*func).region, (i))) as usize])
                }
            }
        } else if instr_op == IrOpcode::IrIndexGet {
            let base_reg = IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize]
            if IR_A_LABEL_ID[(ir_region_slot_r((*func).region, (i))) as usize] == 4 {
                // BSS i8: sign-extend packed byte (parity with local [i8;N] box path).
                native_v2_core_emit_raw_signed_byte_array_load_into(
                    nc,
                    IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize],
                    base_reg,
                    IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize],
                )
            } else if IR_A_LABEL_ID[(ir_region_slot_r((*func).region, (i))) as usize] == 3 {
                native_v2_core_emit_raw_byte_array_load_into(
                    nc,
                    IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize],
                    base_reg,
                    IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize],
                )
            } else if IR_A_LABEL_ID[(ir_region_slot_r((*func).region, (i))) as usize] == 2 {
                native_v2_core_emit_raw_array_load_into(
                    nc,
                    IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize],
                    base_reg,
                    IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize],
                )
            } else if IR_A_LABEL_ID[(ir_region_slot_r((*func).region, (i))) as usize] == 1 {
                native_v2_core_emit_ref_array_load_into(
                    nc,
                    IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize],
                    base_reg,
                    IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize],
                )
            } else if nc_core_func_param_index(func, base_reg) >= 0 {
                native_v2_core_emit_param_array_load_into(
                    nc,
                    IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize],
                    base_reg,
                    IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize],
                )
            } else {
                native_v2_core_emit_local_array_load_into(
                    nc,
                    IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize],
                    base_reg,
                    IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize],
                )
            }
            let index_base_is_float_array = if base_reg >= 0 && base_reg < NC_MAX_VREGS { (*nc).is_float_reg[base_reg as usize] == 1 } else { false }
            if IR_A_IMM_FLAGS[(ir_region_slot_r((*func).region, (i))) as usize] == IR_FLOAT_REG_MARKER_FLAG || index_base_is_float_array {
                nc_core_mark_float_reg(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
            } else {
                nc_core_mark_int_reg(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
            }
        } else if instr_op == IrOpcode::IrIndexSet {
            let base_reg = IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize]
            if IR_A_LABEL_ID[(ir_region_slot_r((*func).region, (i))) as usize] == 3 {
                native_v2_core_emit_raw_byte_array_store_into(
                    nc,
                    base_reg,
                    IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize],
                    IR_A_IMM_I64[(ir_region_slot_r((*func).region, (i))) as usize],
                )
            } else if IR_A_LABEL_ID[(ir_region_slot_r((*func).region, (i))) as usize] == 2 {
                native_v2_core_emit_raw_array_store_into(
                    nc,
                    base_reg,
                    IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize],
                    IR_A_IMM_I64[(ir_region_slot_r((*func).region, (i))) as usize],
                )
            } else if IR_A_LABEL_ID[(ir_region_slot_r((*func).region, (i))) as usize] == 1 {
                native_v2_core_emit_ref_array_store_into(
                    nc,
                    base_reg,
                    IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize],
                    IR_A_IMM_I64[(ir_region_slot_r((*func).region, (i))) as usize],
                )
            } else if nc_core_func_param_index(func, base_reg) >= 0 {
                native_v2_core_emit_param_array_store_into(
                    nc,
                    base_reg,
                    IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize],
                    IR_A_IMM_I64[(ir_region_slot_r((*func).region, (i))) as usize],
                )
            } else {
                native_v2_core_emit_local_array_store_into(
                    nc,
                    base_reg,
                    IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize],
                    IR_A_IMM_I64[(ir_region_slot_r((*func).region, (i))) as usize],
                )
            }
        } else if instr_op == IrOpcode::IrArrayLen {
            // dst = LOGICAL element COUNT of the aggregate handle in src1.
            // Resolve handle -> object base, then load the object-header `flags`
            // slot, which the alloc emitter stamped with the logical N recorded at
            // the array-literal site. This is exact for any element width and any
            // size bucket (payload_size is the over-allocated bucket capacity in
            // BYTES, not N — using payload_size>>3 over-iterated for small arrays).
            // main's #1681 aggregate-element-ref path, ported to the SoA arena.
            // Dropping the label_id==1 branch reintroduces #1678: the base of an
            // aggregate element ref is loaded as a plain temp and the wrong
            // address is dereferenced.
            if IR_A_LABEL_ID[(ir_region_slot_r((*func).region, (i))) as usize] == 1 {
                native_v2_ref_array_resolve_base_rax_into(nc, IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize])
            } else {
                nc_core_load_temp_to_rax(nc, IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize])
                native_v2_resolve_handle_to_object_base_rax_into(nc)
            }
            nc_emit_load_rax_mem_rax_disp32(nc, native_v2_object_header_field_flags())
            nc_core_store_rax_to_temp(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
            nc_core_mark_int_reg(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
        } else if instr_op == IrOpcode::IrBinOp {
            if !nc_emit_core_binop(nc, func, i) {
                return false
            }
        } else if instr_op == IrOpcode::IrCopy {
            nc_core_load_temp_to_rax(nc, IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize])
            nc_core_store_rax_to_temp(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
            if IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize] >= 0 && IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize] < NC_MAX_VREGS {
                if (*nc).is_float_reg[IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize] as usize] == 1 {
                    nc_core_mark_float_reg(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
                } else {
                    nc_core_mark_int_reg(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
                }
            }
        } else if instr_op == IrOpcode::IrUnaryOp {
            // IrUnaryOp had no case in the core_ir loop, so *b / &x / !b / neg all
            // returned false -> native_driver_function_codegen_failed. Box deref is
            // now lowered to IrFieldGet(0) (the lowerer marks Box locals), so here we
            // only see neg / not / and raw references. neg and not are pure value ops;
            // raw references (&x / &!x / *raw_ptr of a true &T) are NOT yet supported
            // in native_v2 — emitting lea/load for them produces code that crashes,
            // so fail LOUDLY (codegen error) rather than ship a silent miscompile.
            let uop = (IR_A_UN_OP[(ir_region_slot_r((*func).region, (i))) as usize] as UnaryOp)
            if uop == UnaryOp::OpNeg {
                let src1 = IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize]
                let src1_marked_float = if src1 >= 0 && src1 < NC_MAX_VREGS && (*nc).is_float_reg[src1 as usize] == 1 { 1 } else { 0 }
                let src1_typed_float = if src1 >= 0 && src1 < NC_MAX_VREGS && (*nc).reg_type[src1 as usize] == 1 { 1 } else { 0 }
                if src1_marked_float == 1 || src1_typed_float == 1 {
                    nc_core_load_temp_to_rax(nc, src1)
                    nc_emit_movq_xmm1_rax(nc)
                    nc_emit_mov_rax_imm(nc, 0)
                    nc_emit_movq_xmm0_rax(nc)
                    nc_emit_subsd_xmm0_xmm1(nc)
                    nc_emit_movq_rax_xmm0(nc)
                    nc_core_store_rax_to_temp(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
                    nc_core_mark_float_reg(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
                } else {
                    nc_core_load_temp_to_rax(nc, src1)
                    nc_emit_neg_rax(nc)
                    nc_core_store_rax_to_temp(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
                    nc_core_mark_int_reg(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
                }
            } else if uop == UnaryOp::OpNot {
                nc_core_load_temp_to_rax(nc, IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize])
                (*nc).code = emit_not_bool_rax((*nc).code)
                nc_core_store_rax_to_temp(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
                nc_core_mark_int_reg(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
            } else if uop == UnaryOp::OpDeref {
                // *p of a true reference: load the pointer value, then load from [p].
                // (Box deref is lowered to IrFieldGet(0) earlier, so this is a raw ref.)
                nc_core_load_temp_to_rax(nc, IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize])
                nc_emit_load_rax_mem_rax(nc)
                nc_core_store_rax_to_temp(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
                nc_core_mark_int_reg(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
            } else if uop == UnaryOp::OpRef || uop == UnaryOp::OpRefMut {
                // &x / &!x : address of x's stack slot. Escape safety (returning/leaking a
                // ref to a frame-local) is enforced by the checker's escape analysis (E091);
                // the common param-rooted case (&n passed to a fn) is sound.
                nc_emit_lea_rax_rbp_disp32(nc, ir_slot_offset(IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize]))
                nc_core_store_rax_to_temp(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
                nc_core_mark_int_reg(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
            } else {
                return false
            }
        } else if instr_op == IrOpcode::IrStorePtr {
            // [src1] = src2 : store val through a raw pointer. val -> rbx, ptr -> rax, [rax]=rbx.
            nc_core_load_temp_to_rax(nc, IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize])
            nc_emit_mov_rbx_rax(nc)
            nc_core_load_temp_to_rax(nc, IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize])
            nc_emit_store_rbx_to_mem_rax(nc)
        } else if instr_op == IrOpcode::IrAlloc {
            // field_idx carries the LOGICAL element count for array-literal allocs
            // (set by ir_alloc_array); every other alloc (ir_alloc) leaves it at the
            // -1 default, which we clamp to 0 so non-array objects keep flags = 0.
            let alloc_elem_count_raw = IR_A_FIELD_IDX[(ir_region_slot_r((*func).region, (i))) as usize]
            let alloc_elem_count = if alloc_elem_count_raw < 0 { 0 } else { alloc_elem_count_raw }
            if !nc_core_emit_alloc_into(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize], IR_A_IMM_I64[(ir_region_slot_r((*func).region, (i))) as usize], alloc_elem_count) {
                return false
            }
        } else if instr_op == IrOpcode::IrCall {
            let argc = IR_A_ARG_COUNT[(ir_region_slot_r((*func).region, (i))) as usize]
            if !nc_core_push_call_stack_args(nc, func, i, argc) { return false }
            if argc > 0 {
                if !nc_core_load_call_arg_into(nc, func, i, 0, 7) { return false }
            }
            if argc > 1 {
                if !nc_core_load_call_arg_into(nc, func, i, 1, 6) { return false }
            }
            if argc > 2 {
                if !nc_core_load_call_arg_into(nc, func, i, 2, 2) { return false }
            }
            if argc > 3 {
                if !nc_core_load_call_arg_into(nc, func, i, 3, 1) { return false }
            }
            if argc > 4 {
                if !nc_core_load_call_arg_into(nc, func, i, 4, 8) { return false }
            }
            if argc > 5 {
                if !nc_core_load_call_arg_into(nc, func, i, 5, 9) { return false }
            }
            let call_pos = (*nc).code.len
            nc_emit_call_rel32_placeholder(nc)
            nc_add_call_reloc(nc, call_pos + 1, IR_A_FN_ID[(ir_region_slot_r((*func).region, (i))) as usize])
            let cleanup_bytes = nc_core_stack_call_cleanup_bytes(argc, 6)
            if cleanup_bytes > 0 {
                nc_emit_add_rsp_imm32(nc, cleanup_bytes)
            }
            if IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize] >= 0 {
                nc_core_store_rax_to_temp(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
                if IR_A_IMM_FLAGS[(ir_region_slot_r((*func).region, (i))) as usize] == IR_FLOAT_REG_MARKER_FLAG {
                    nc_core_mark_float_reg(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
                } else {
                    nc_core_mark_int_reg(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
                }
            }
        } else if instr_op == IrOpcode::IrCallSret {
            let argc = IR_A_ARG_COUNT[(ir_region_slot_r((*func).region, (i))) as usize]
            let dest_reg = IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize]
            if dest_reg < 0 { return false }
            let first_arg = IR_A_FIELD_IDX[(ir_region_slot_r((*func).region, (i))) as usize]
            if !nc_core_push_sret_stack_args(nc, first_arg, argc) { return false }
            nc_emit_load_rbp_disp32_reg(nc, 7, ir_slot_offset(dest_reg))
            if argc > 0 {
                if first_arg < 0 { return false }
                nc_emit_load_rbp_disp32_reg(nc, 6, ir_slot_offset(first_arg))
            }
            if argc > 1 {
                nc_emit_load_rbp_disp32_reg(nc, 2, ir_slot_offset(first_arg + 1))
            }
            if argc > 2 {
                nc_emit_load_rbp_disp32_reg(nc, 1, ir_slot_offset(first_arg + 2))
            }
            if argc > 3 {
                nc_emit_load_rbp_disp32_reg(nc, 8, ir_slot_offset(first_arg + 3))
            }
            if argc > 4 {
                nc_emit_load_rbp_disp32_reg(nc, 9, ir_slot_offset(first_arg + 4))
            }
            let call_pos = (*nc).code.len
            nc_emit_call_rel32_placeholder(nc)
            nc_add_call_reloc(nc, call_pos + 1, IR_A_FN_ID[(ir_region_slot_r((*func).region, (i))) as usize])
            let cleanup_bytes = nc_core_stack_call_cleanup_bytes(argc, 5)
            if cleanup_bytes > 0 {
                nc_emit_add_rsp_imm32(nc, cleanup_bytes)
            }
            if IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize] >= 0 {
                nc_core_store_rax_to_temp(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
            }
        } else if instr_op == IrOpcode::IrReturn {
            nc_core_load_temp_to_rax(nc, IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize])
            nc_emit_mov_rsp_rbp(nc)
            nc_emit_pop_rbp(nc)
            nc_emit_ret(nc)
            saw_return = true
        } else if instr_op == IrOpcode::IrReturnSret {
            nc_core_load_temp_to_rax(nc, IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize])
            nc_emit_mov_rsp_rbp(nc)
            nc_emit_pop_rbp(nc)
            nc_emit_ret(nc)
            saw_return = true
        } else if instr_op == IrOpcode::IrLabel {
            nc_define_label(nc, IR_A_LABEL_ID[(ir_region_slot_r((*func).region, (i))) as usize])
        } else if instr_op == IrOpcode::IrJump {
            let jmp_pos = (*nc).code.len
            nc_emit_jmp_rel32(nc)
            nc_add_label_patch(nc, jmp_pos + 1, IR_A_LABEL_ID[(ir_region_slot_r((*func).region, (i))) as usize])
        } else if instr_op == IrOpcode::IrBranchFalse {
            nc_core_load_temp_to_rax(nc, IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize])
            nc_emit_test_rax_rax(nc)
            let jz_pos = (*nc).code.len
            nc_emit_jz_rel32(nc)
            nc_add_label_patch(nc, jz_pos + 2, IR_A_LABEL_ID[(ir_region_slot_r((*func).region, (i))) as usize])
        } else if instr_op == IrOpcode::IrBranchTrue {
            nc_core_load_temp_to_rax(nc, IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize])
            nc_emit_test_rax_rax(nc)
            let jnz_pos = (*nc).code.len
            nc_emit_jnz_rel32(nc)
            nc_add_label_patch(nc, jnz_pos + 2, IR_A_LABEL_ID[(ir_region_slot_r((*func).region, (i))) as usize])
        } else if instr_op == IrOpcode::IrLoadFnRef {
            let lea_pos = (*nc).code.len
            nc_emit_lea_rax_rip_disp32(nc, 0)
            nc_add_flat_reloc(nc, lea_pos + 3, 4, 1, IR_A_FN_ID[(ir_region_slot_r((*func).region, (i))) as usize])
            if IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize] >= 0 {
                nc_core_store_rax_to_temp(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
            }
        } else if instr_op == IrOpcode::IrCallIndirect {
            // Marshal up to 6 args into the SysV GP arg registers (args 6+ go on
            // the stack), mirroring the direct IrCall arm. The old code capped at
            // 2 args (`if argc > 2 { return false }` -> "native-v2 bridge failed"),
            // which silently blocked every indirect call (by-value closures, fn
            // pointers) with >=3 arguments. The fnref (call target) is loaded into
            // rax LAST so the arg-register loads cannot clobber it; rax is not a
            // SysV arg register.
            let argc = IR_A_ARG_COUNT[(ir_region_slot_r((*func).region, (i))) as usize]
            let fnref_reg = IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize]
            if fnref_reg < 0 { return false }
            if !nc_core_push_call_stack_args(nc, func, i, argc) { return false }
            if argc > 0 {
                if !nc_core_load_call_arg_into(nc, func, i, 0, 7) { return false }
            }
            if argc > 1 {
                if !nc_core_load_call_arg_into(nc, func, i, 1, 6) { return false }
            }
            if argc > 2 {
                if !nc_core_load_call_arg_into(nc, func, i, 2, 2) { return false }
            }
            if argc > 3 {
                if !nc_core_load_call_arg_into(nc, func, i, 3, 1) { return false }
            }
            if argc > 4 {
                if !nc_core_load_call_arg_into(nc, func, i, 4, 8) { return false }
            }
            if argc > 5 {
                if !nc_core_load_call_arg_into(nc, func, i, 5, 9) { return false }
            }
            nc_core_load_temp_to_rax(nc, fnref_reg)
            nc_emit_call_rax(nc)
            let cleanup_bytes = nc_core_stack_call_cleanup_bytes(argc, 6)
            if cleanup_bytes > 0 {
                nc_emit_add_rsp_imm32(nc, cleanup_bytes)
            }
            if IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize] >= 0 {
                nc_core_store_rax_to_temp(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
            }
        } else if instr_op == IrOpcode::IrNop {
            // no-op
        } else if instr_op == IrOpcode::IrWideAdd {
            let dst_v = IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize]
            let lhs_v = IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize]
            let rhs_v = IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize]
            let limbs = IR_A_IMM_I64[(ir_region_slot_r((*func).region, (i))) as usize]
            if dst_v < 0 || lhs_v < 0 || rhs_v < 0 || limbs < 1 {
                return false
            }
            nc_wide_add_into(nc, lhs_v, rhs_v, dst_v, limbs)
        } else if instr_op == IrOpcode::IrWideSub {
            let dst_v = IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize]
            let lhs_v = IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize]
            let rhs_v = IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize]
            let limbs = IR_A_IMM_I64[(ir_region_slot_r((*func).region, (i))) as usize]
            if dst_v < 0 || lhs_v < 0 || rhs_v < 0 || limbs < 1 {
                return false
            }
            nc_wide_sub_into(nc, lhs_v, rhs_v, dst_v, limbs)
        } else if instr_op == IrOpcode::IrWideMul {
            let dst_v = IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize]
            let lhs_v = IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize]
            let rhs_v = IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize]
            let limbs = IR_A_IMM_I64[(ir_region_slot_r((*func).region, (i))) as usize]
            if dst_v < 0 || lhs_v < 0 || rhs_v < 0 || limbs < 1 {
                return false
            }
            nc_wide_mul_into(nc, lhs_v, rhs_v, dst_v, limbs)
        } else if instr_op == IrOpcode::IrWideCmp {
            let dst_v = IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize]
            let lhs_v = IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize]
            let rhs_v = IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize]
            let limbs = IR_A_IMM_I64[(ir_region_slot_r((*func).region, (i))) as usize]
            let cmp_op = IR_A_FIELD_IDX[(ir_region_slot_r((*func).region, (i))) as usize]
            if dst_v < 0 || lhs_v < 0 || rhs_v < 0 || limbs < 1 || limbs > 64 || cmp_op < 0 || cmp_op > 5 {
                return false
            }
            nc_wide_cmp_into(nc, lhs_v, rhs_v, dst_v, limbs, cmp_op)
        } else if instr_op == IrOpcode::IrWideShrLimb {
            let dst_v = IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize]
            let src_v = IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize]
            let shift = IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize]
            let limbs = IR_A_IMM_I64[(ir_region_slot_r((*func).region, (i))) as usize]
            if dst_v < 0 || src_v < 0 || limbs < 1 || shift < 0 {
                return false
            }
            nc_wide_shr_limb_into(nc, src_v, dst_v, limbs, shift)
        } else if instr_op == IrOpcode::IrWideShr {
            let dst_v = IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize]
            let src_v = IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize]
            let shift = IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize]
            let limbs = IR_A_IMM_I64[(ir_region_slot_r((*func).region, (i))) as usize]
            if dst_v < 0 || src_v < 0 || limbs < 1 || shift < 0 {
                return false
            }
            nc_wide_shr_into(nc, src_v, dst_v, limbs, shift)
        } else if instr_op == IrOpcode::IrWideDiv {
            let dst_v = IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize]
            let lhs_v = IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize]
            let rhs_v = IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize]
            let limbs = IR_A_IMM_I64[(ir_region_slot_r((*func).region, (i))) as usize]
            if dst_v < 0 || lhs_v < 0 || rhs_v < 0 || limbs < 1 {
                return false
            }
            nc_wide_div_single_into(nc, lhs_v, rhs_v, dst_v, limbs)
        } else if instr_op == IrOpcode::IrWideMod {
            let dst_v = IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize]
            let lhs_v = IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize]
            let rhs_v = IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize]
            let limbs = IR_A_IMM_I64[(ir_region_slot_r((*func).region, (i))) as usize]
            if dst_v < 0 || lhs_v < 0 || rhs_v < 0 || limbs < 1 {
                return false
            }
            nc_wide_mod_single_into(nc, lhs_v, rhs_v, dst_v, limbs)
        } else if instr_op == IrOpcode::IrWideDivFull {
            let dst_v = IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize]
            let lhs_v = IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize]
            let rhs_v = IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize]
            let limbs = IR_A_IMM_I64[(ir_region_slot_r((*func).region, (i))) as usize]
            if dst_v < 0 || lhs_v < 0 || rhs_v < 0 || limbs < 1 {
                return false
            }
            nc_wide_longdiv_into(nc, lhs_v, rhs_v, dst_v, limbs, 0)
        } else if instr_op == IrOpcode::IrWideModFull {
            let dst_v = IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize]
            let lhs_v = IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize]
            let rhs_v = IR_A_SRC2[(ir_region_slot_r((*func).region, (i))) as usize]
            let limbs = IR_A_IMM_I64[(ir_region_slot_r((*func).region, (i))) as usize]
            if dst_v < 0 || lhs_v < 0 || rhs_v < 0 || limbs < 1 {
                return false
            }
            nc_wide_longdiv_into(nc, lhs_v, rhs_v, dst_v, limbs, 1)
        } else if instr_op == IrOpcode::IrLoadGlobal {
            let bss_off = IR_A_IMM_I64[(ir_region_slot_r((*func).region, (i))) as usize]
            let abs_addr = BSS_BASE_LINUX + bss_off
            nc_emit_mov_rax_imm(nc, abs_addr)
            nc_emit_load_rax_mem_rax(nc)
            nc_core_store_rax_to_temp(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
            nc_core_mark_int_reg(nc, IR_A_DST[(ir_region_slot_r((*func).region, (i))) as usize])
        } else if instr_op == IrOpcode::IrStoreGlobal {
            let bss_off = IR_A_IMM_I64[(ir_region_slot_r((*func).region, (i))) as usize]
            let abs_addr = BSS_BASE_LINUX + bss_off
            nc_core_load_temp_to_rax(nc, IR_A_SRC1[(ir_region_slot_r((*func).region, (i))) as usize])
            nc_emit_mov_reg_imm(nc, 3, abs_addr)
            nc_emit_store_rax_mem_rbx_disp32(nc, 0)
        } else {
            return false
        }
        i = i + 1
    }

    // Fallthrough defense: if IR was truncated past IR_MAX_INSTRS (or a void body
    // never received IrReturn), emit a synthetic epilogue so control cannot walk
    // into the next function body (re-entry through main / wrong call target
    // appearance). Correctness of the truncated body is not claimed — callers
    // that hit this path still need a larger IR_MAX_INSTRS for full semantics.
    if !saw_return {
        nc_emit_mov_rax_imm(nc, 0)
        nc_emit_mov_rsp_rbp(nc)
        nc_emit_pop_rbp(nc)
        nc_emit_ret(nc)
    }

    patch_label_forwards_mut(nc)
    if native_v2_capacity_trace_enabled() {
        print("nv2cap fn=")
        print_int(fn_index)
        print(" labels=")
        print_int((*func).label_count)
        print(" patches=")
        print_int(NC_V2_LABEL_PATCH_COUNT)
        print(" instrs=")
        print_int((*func).instr_count)
        print(" returns=")
        print_int((*nc).return_jump_count)
        print("\n")
    }
    true
}

pub fn native_v2_core_begin_function_from_ir_into(nc: &! NativeCompiler, func: &IrFunction, fn_index: i64) with Mut, Panic, Div, Alloc {
    reset_function_state_mut(nc)
    let function_offset = (*nc).code.len
    native_compiler_set_fn_offset(nc, fn_index, function_offset)
    native_compiler_add_symbol_func_ref(nc, fn_index, func)
    nc_emit_push_rbp(nc)
    nc_emit_mov_rbp_rsp(nc)
    nc_emit_sub_rsp_imm32(nc, 512)
}

pub fn native_v2_core_emit_load_imm_into(nc: &! NativeCompiler, dst: i64, value: i64) with Mut, Panic, Div {
    nc_emit_mov_rax_imm(nc, value)
    nc_core_store_rax_to_temp(nc, dst)
}

pub fn native_v2_rodata_len_into(nc: &! NativeCompiler) -> i64 {
    (*nc).flat_rodata_len
}

pub fn native_v2_rodata_append_byte_into(nc: &! NativeCompiler, byte: i64) with Mut, Panic, Div {
    var len = (*nc).flat_rodata_len
    if len >= 0 && len < 262144 {
        NC_BIG_RODATA[len as usize] = byte as i8
        len = len + 1
        (*nc).flat_rodata_len = len
    }
}

pub fn native_v2_core_emit_load_string_into(nc: &! NativeCompiler, dst: i64, name: Name) with Mut, Panic, Div {
    let str_offset = nc_rodata_add_name_value(nc, name)
    let lea_pos = (*nc).code.len
    nc_emit_lea_rax_rip_disp32(nc, 0)
    nc_add_rodata_reloc(nc, lea_pos + 3, str_offset)
    nc_core_store_rax_to_temp(nc, dst)
}

pub fn native_v2_core_emit_load_string_offset_into(nc: &! NativeCompiler, dst: i64, rodata_offset: i64) with Mut, Panic, Div {
    let lea_pos = (*nc).code.len
    nc_emit_lea_rax_rip_disp32(nc, 0)
    nc_add_rodata_reloc(nc, lea_pos + 3, rodata_offset)
    nc_core_store_rax_to_temp(nc, dst)
}

pub fn native_v2_core_emit_binop_code_into(nc: &! NativeCompiler, dst: i64, lhs: i64, op_code: i64, rhs: i64) -> bool with Mut, Panic, Div {
    if op_code == 1 {
        nc_core_load_temp_to_rax(nc, lhs)
        nc_emit_push_rax(nc)
        nc_core_load_temp_to_rax(nc, rhs)
        nc_emit_pop_rbx(nc)
        nc_emit_add_rax_rbx(nc)
        nc_core_store_rax_to_temp(nc, dst)
        return true
    }
    if op_code == 2 {
        nc_core_load_temp_to_rax(nc, rhs)
        nc_emit_push_rax(nc)
        nc_core_load_temp_to_rax(nc, lhs)
        nc_emit_pop_rbx(nc)
        nc_emit_sub_rax_rbx(nc)
        nc_core_store_rax_to_temp(nc, dst)
        return true
    }
    if op_code == 3 {
        nc_core_load_temp_to_rax(nc, lhs)
        nc_emit_push_rax(nc)
        nc_core_load_temp_to_rax(nc, rhs)
        nc_emit_pop_rbx(nc)
        nc_emit_imul_rax_rbx(nc)
        nc_core_store_rax_to_temp(nc, dst)
        return true
    }
    if op_code == 4 {
        nc_core_load_temp_to_rax(nc, rhs)
        nc_emit_mov_reg_reg(nc, 1, 0)
        nc_core_load_temp_to_rax(nc, lhs)
        nc_emit_cqo(nc)
        nc_emit_idiv_rcx(nc)
        nc_core_store_rax_to_temp(nc, dst)
        return true
    }
    false
}

pub fn native_v2_core_emit_call1_into(nc: &! NativeCompiler, dst: i64, fn_id: i64, arg: i64, arg_count: i64) with Mut, Panic, Div {
    if arg_count > 0 {
        nc_core_load_temp_to_rax(nc, arg)
        nc_emit_mov_rdi_rax(nc)
    }
    let call_pos = (*nc).code.len
    nc_emit_call_rel32_placeholder(nc)
    nc_add_call_reloc(nc, call_pos + 1, fn_id)
    if dst >= 0 {
        nc_core_store_rax_to_temp(nc, dst)
    }
}

pub fn native_v2_core_emit_return_into(nc: &! NativeCompiler, src: i64) with Mut, Panic, Div {
    nc_core_load_temp_to_rax(nc, src)
    nc_emit_mov_rsp_rbp(nc)
    nc_emit_pop_rbp(nc)
    nc_emit_ret(nc)
}

fn nc_emit_load_rbp_disp32_reg(nc: &! NativeCompiler, reg: i64, disp: i64) with Mut, Panic, Div {
    if reg >= 8 {
        nc_emit_byte(nc, 0x4c)
    } else {
        nc_emit_byte(nc, 0x48)
    }
    nc_emit_byte(nc, 0x8b)
    nc_emit_byte(nc, 0x80 | ((reg % 8) * 8) | 5)
    nc_emit_u32_le(nc, disp)
}

fn nc_emit_store_rbp_disp32_reg(nc: &! NativeCompiler, reg: i64, disp: i64) with Mut, Panic, Div {
    if reg >= 8 {
        nc_emit_byte(nc, 0x4c)
    } else {
        nc_emit_byte(nc, 0x48)
    }
    nc_emit_byte(nc, 0x89)
    nc_emit_byte(nc, 0x80 | ((reg % 8) * 8) | 5)
    nc_emit_u32_le(nc, disp)
}

// Pass up to 4 args from consecutive vregs into SysV param regs (rdi/rsi/rdx/rcx)
pub fn native_v2_core_emit_call_argc_into(nc: &! NativeCompiler, dst: i64, fn_id: i64, arg0: i64, argc: i64) with Mut, Panic, Div {
    if argc >= 1 { nc_emit_load_rbp_disp32_reg(nc, 7, ir_slot_offset(arg0)) }
    if argc >= 2 { nc_emit_load_rbp_disp32_reg(nc, 6, ir_slot_offset(arg0 + 1)) }
    if argc >= 3 { nc_emit_load_rbp_disp32_reg(nc, 2, ir_slot_offset(arg0 + 2)) }
    if argc >= 4 { nc_emit_load_rbp_disp32_reg(nc, 1, ir_slot_offset(arg0 + 3)) }
    let call_pos = (*nc).code.len
    nc_emit_call_rel32_placeholder(nc)
    nc_add_call_reloc(nc, call_pos + 1, fn_id)
    if dst >= 0 {
        nc_core_store_rax_to_temp(nc, dst)
    }
}

// Return a struct: field[0] in rax, field[1] in rdx (if fcount >= 2), then epilogue
pub fn native_v2_core_emit_return_struct_into(nc: &! NativeCompiler, base_reg: i64, fcount: i64) with Mut, Panic, Div {
    nc_core_load_temp_to_rax(nc, base_reg)
    if fcount >= 2 {
        nc_emit_load_rbp_disp32_reg(nc, 2, ir_slot_offset(base_reg + 1))
    }
    nc_emit_mov_rsp_rbp(nc)
    nc_emit_pop_rbp(nc)
    nc_emit_ret(nc)
}

// Save rdx (second return reg) into a vreg stack slot
pub fn native_v2_core_emit_rdx_to_temp_into(nc: &! NativeCompiler, dst: i64) with Mut, Panic, Div {
    if dst >= 0 {
        nc_emit_store_rbp_disp32_reg(nc, 2, ir_slot_offset(dst))
    }
}

pub fn compile_ir_function_v2_from_ir_into(nc: &! NativeCompiler, func: &IrFunction, fn_index: i64) -> bool with IO, Mut, Panic, Div, Alloc {
    // BSS globals occupy IrFunction slots so global-address instructions can
    // refer to stable module indices, but they have no executable body.
    // Compiling their empty slots as ordinary functions reads non-function
    // frame metadata and can fill the machine-code buffer with bogus output.
    if (*func).compile_strategy == IR_STRATEGY_BSS_GLOBAL {
        native_compiler_set_fn_offset(nc, fn_index, (*nc).code.len)
        native_compiler_add_symbol_func_ref(nc, fn_index, func)
        return true
    }
    let builtin_id = native_v2_builtin_id_for_func_ref(func)
    if builtin_id != 0 {
        if builtin_id <= 3 {
            reset_function_state_mut(nc)
            let function_offset = (*nc).code.len
            native_compiler_set_fn_offset(nc, fn_index, function_offset)
            native_compiler_add_symbol_func_ref(nc, fn_index, func)
            if builtin_id == 1 {
                emit_builtin_print_int_into(nc)
                return true
            }
            if builtin_id == 2 {
                emit_builtin_print_char_into(nc)
                return true
            }
            if builtin_id == 3 {
                emit_builtin_print_str_into(nc)
                return true
            }
            return true
        }
        reset_function_state_mut(nc)
        let function_offset = (*nc).code.len
        native_compiler_set_fn_offset(nc, fn_index, function_offset)
        native_compiler_add_symbol_func_ref(nc, fn_index, func)
        if builtin_id == 6 {
            emit_builtin_str_len_into(nc)
            return true
        }
        if builtin_id == 20 {
            emit_builtin_str_char_at_into(nc)
            return true
        }
        if builtin_id == 7 {
            native_v2_persist_builtin_emit_into(nc, emit_builtin_str_eq((*nc)))
            return true
        }
        if builtin_id == 10 {
            // str_concat: route through persist (selectively copies code + relocs), like
            // str_eq, instead of `(*nc) = emit_builtin_str_concat((*nc))` — the full
            // by-value NativeCompiler replacement is hit by the large-aggregate miscompile
            // and corrupts fn_offsets, so the call to str_concat resolved to a bad address.
            native_v2_persist_builtin_emit_into(nc, emit_builtin_str_concat((*nc)))
            return true
        }
        native_v2_emit_builtin_by_id_into(nc, builtin_id)
        return true
    }
    if native_v2_empty_stub_would_fabricate(func) {
        reset_function_state_mut(nc)
        let function_offset = (*nc).code.len
        native_compiler_set_fn_offset(nc, fn_index, function_offset)
        native_compiler_add_symbol_func_ref(nc, fn_index, func)
        nc_emit_unimplemented_extern_trap_into(nc)
        return true
    }
    compile_ir_function_v2_core_ir_into(nc, func, fn_index)
}

// compile_ir_function_v2_ref deleted 2026-08-18: zero external callers across
// the entire repo including tests (census: `grep -rn compile_ir_function_v2_ref
// --include='*.sio' .` returns only the two definitions and the single
// internal call inside the body itself). Mirror of the codegen.sio deletion
// in the same commit; the x86_linux backend exposes compile_ir_function_v2_into
// directly to module_native_streaming.sio via `use native::codegen_x86_linux::*`
// and the v2_ref wrapper had no remaining surface.

fn native_v2_ir_alloc(dst: i64, type_id: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrAlloc)
    IrInstr {
        op: base.op,
        dst: dst,
        src1: base.src1,
        src2: base.src2,
        imm_i64: type_id,
        imm_f64: base.imm_f64,
        label_id: base.label_id,
        fn_id: base.fn_id,
        field_idx: base.field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name_id: base.name_id,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

fn native_v2_ir_field_get(dst: i64, base_reg: i64, field_idx: i64, field_name: Name) -> IrInstr with Div, Mut, Panic {
    let base = ir_instr_new(IrOpcode::IrFieldGet)
    IrInstr {
        op: base.op,
        dst: dst,
        src1: base_reg,
        src2: base.src2,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: base.label_id,
        fn_id: base.fn_id,
        field_idx: field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name_id: ir_intern_name(field_name),
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

fn native_v2_ir_field_set(base_reg: i64, field_idx: i64, src: i64, field_name: Name) -> IrInstr with Div, Mut, Panic {
    let base = ir_instr_new(IrOpcode::IrFieldSet)
    IrInstr {
        op: base.op,
        dst: base.dst,
        src1: base_reg,
        src2: src,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: base.label_id,
        fn_id: base.fn_id,
        field_idx: field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name_id: ir_intern_name(field_name),
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

fn native_v2_ir_return_sret(src: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrReturnSret)
    IrInstr {
        op: base.op,
        dst: base.dst,
        src1: src,
        src2: base.src2,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: base.label_id,
        fn_id: base.fn_id,
        field_idx: base.field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name_id: base.name_id,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

fn native_v2_ir_call_sret(dst: i64, dest_reg: i64, fn_name: Name, fn_id: i64, arg0: i64, explicit_arg_count: i64) -> IrInstr with Div, Mut, Panic {
    let base = ir_instr_new(IrOpcode::IrCallSret)
    IrInstr {
        op: base.op,
        dst: dst,
        src1: dest_reg,
        src2: base.src2,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: base.label_id,
        fn_id: fn_id,
        field_idx: arg0,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name_id: ir_intern_name(fn_name),
        call_args: base.call_args,
        arg_count: explicit_arg_count,
    }
}

fn native_v2_fill_sret_main_fn(main_fn: &! IrFunction, plain_call: bool) with Mut, Panic, Div, Alloc {
    (*main_fn).name.len = 4
    (*main_fn).name.buf[0] = 109 as i8
    (*main_fn).name.buf[1] = 97 as i8
    (*main_fn).name.buf[2] = 105 as i8
    (*main_fn).name.buf[3] = 110 as i8
    (*main_fn).reg_count = 4
    ir_arena_store(ir_region_slot_w((*main_fn).region, (0)), native_v2_ir_alloc(0, 64))
    ir_arena_store(ir_region_slot_w((*main_fn).region, (1)), ir_load_imm(1, 7))
    if plain_call {
        ir_arena_store(ir_region_slot_w((*main_fn).region, (2)), ir_call(2, 1, ir_name_from_bytes(109, 97, 107, 101, 4), Some(Box::new(ir_reg_list_single(0))), 1))
        ir_arena_store(ir_region_slot_w((*main_fn).region, (3)), native_v2_ir_field_get(3, 0, 1, ir_name_from_bytes(102, 49, 0, 0, 2)))
    } else {
        ir_arena_store(ir_region_slot_w((*main_fn).region, (2)), native_v2_ir_call_sret(2, 0, ir_name_from_bytes(109, 97, 107, 101, 4), 1, 1, 1))
        ir_arena_store(ir_region_slot_w((*main_fn).region, (3)), native_v2_ir_field_get(3, 2, 1, ir_name_from_bytes(102, 49, 0, 0, 2)))
    }
    ir_arena_store(ir_region_slot_w((*main_fn).region, (4)), ir_return(3))
    (*main_fn).instr_count = 5
}

fn native_v2_fill_sret_make_fn(make_fn: &! IrFunction) with Mut, Panic, Div {
    (*make_fn).name.len = 4
    (*make_fn).name.buf[0] = 109 as i8
    (*make_fn).name.buf[1] = 97 as i8
    (*make_fn).name.buf[2] = 107 as i8
    (*make_fn).name.buf[3] = 101 as i8
    (*make_fn).is_sret = 1
    (*make_fn).sret_dest_reg = 0
    (*make_fn).param_count = 1
    (*make_fn).param_regs[0] = 1
    (*make_fn).reg_count = 6
    ir_arena_store(ir_region_slot_w((*make_fn).region, (0)), native_v2_ir_field_set(0, 0, 1, ir_name_from_bytes(102, 48, 0, 0, 2)))
    ir_arena_store(ir_region_slot_w((*make_fn).region, (1)), ir_load_imm(2, 2))
    ir_arena_store(ir_region_slot_w((*make_fn).region, (2)), ir_binop(3, 1, BinaryOp::OpMul, 2))
    ir_arena_store(ir_region_slot_w((*make_fn).region, (3)), native_v2_ir_field_set(0, 1, 3, ir_name_from_bytes(102, 49, 0, 0, 2)))
    ir_arena_store(ir_region_slot_w((*make_fn).region, (4)), ir_load_imm(4, 1))
    ir_arena_store(ir_region_slot_w((*make_fn).region, (5)), ir_binop(5, 1, BinaryOp::OpAdd, 4))
    ir_arena_store(ir_region_slot_w((*make_fn).region, (6)), native_v2_ir_field_set(0, 2, 5, ir_name_from_bytes(102, 50, 0, 0, 2)))
    ir_arena_store(ir_region_slot_w((*make_fn).region, (7)), native_v2_ir_return_sret(0))
    (*make_fn).instr_count = 8
}

fn native_v2_emit_sret_witness_main_into(nc: &! NativeCompiler, plain_call: bool) -> bool with Mut, Panic, Div {
    reset_function_state_mut(nc)
    let function_offset = (*nc).code.len
    native_compiler_set_fn_offset(nc, 0, function_offset)
    let main_name = ir_name_from_bytes(109, 97, 105, 110, 4)
    native_compiler_add_symbol_name_ref(nc, 0, &main_name)

    nc_emit_push_rbp(nc)
    nc_emit_mov_rbp_rsp(nc)
    nc_emit_sub_rsp_imm32(nc, 512)

    if !nc_core_emit_alloc_into(nc, 0, 64, 0) { return false }
    native_v2_core_emit_load_imm_into(nc, 1, 7)

    if plain_call {
        nc_core_load_temp_to_rax(nc, 0)
        nc_emit_mov_rdi_rax(nc)
    } else {
        nc_core_load_temp_to_rax(nc, 0)
        nc_emit_mov_rdi_rax(nc)
        nc_core_load_temp_to_rax(nc, 1)
        nc_emit_mov_reg_reg(nc, 6, 0)
    }

    let call_pos = (*nc).code.len
    nc_emit_call_rel32_placeholder(nc)
    nc_add_call_reloc(nc, call_pos + 1, 1)
    if !plain_call {
        nc_core_store_rax_to_temp(nc, 2)
        nc_core_load_temp_to_rax(nc, 2)
    } else {
        nc_core_load_temp_to_rax(nc, 0)
    }
    native_v2_resolve_handle_to_object_base_rax_into(nc)
    nc_emit_mov_reg_imm(nc, 3, 1 + native_v2_object_header_size() / 8)
    nc_emit_mov_rax_mem_rax_rbx8(nc)
    nc_core_store_rax_to_temp(nc, 3)
    native_v2_core_emit_return_into(nc, 3)
    true
}

fn native_v2_emit_sret_witness_make_into(nc: &! NativeCompiler) -> bool with Mut, Panic, Div {
    reset_function_state_mut(nc)
    let function_offset = (*nc).code.len
    native_compiler_set_fn_offset(nc, 1, function_offset)
    let make_name = ir_name_from_bytes(109, 97, 107, 101, 4)
    native_compiler_add_symbol_name_ref(nc, 1, &make_name)

    nc_emit_push_rbp(nc)
    nc_emit_mov_rbp_rsp(nc)
    nc_emit_sub_rsp_imm32(nc, 512)
    nc_emit_store_rbp_disp32_reg(nc, 7, ir_slot_offset(0))
    nc_emit_store_rbp_disp32_reg(nc, 6, ir_slot_offset(1))

    nc_core_load_temp_to_rax(nc, 0)
    native_v2_resolve_handle_to_object_base_rax_into(nc)
    nc_emit_mov_rdx_rax(nc)
    nc_core_load_temp_to_rax(nc, 1)
    nc_emit_mov_reg_imm(nc, 3, 0 + native_v2_object_header_size() / 8)
    nc_emit_store_rax_mem_rdx_rbx8(nc)

    native_v2_core_emit_load_imm_into(nc, 2, 2)
    if !native_v2_core_emit_binop_code_into(nc, 3, 1, 3, 2) { return false }

    nc_core_load_temp_to_rax(nc, 0)
    native_v2_resolve_handle_to_object_base_rax_into(nc)
    nc_emit_mov_rdx_rax(nc)
    nc_core_load_temp_to_rax(nc, 3)
    nc_emit_mov_reg_imm(nc, 3, 1 + native_v2_object_header_size() / 8)
    nc_emit_store_rax_mem_rdx_rbx8(nc)

    native_v2_core_emit_load_imm_into(nc, 4, 1)
    if !native_v2_core_emit_binop_code_into(nc, 5, 1, 1, 4) { return false }

    nc_core_load_temp_to_rax(nc, 0)
    native_v2_resolve_handle_to_object_base_rax_into(nc)
    nc_emit_mov_rdx_rax(nc)
    nc_core_load_temp_to_rax(nc, 5)
    nc_emit_mov_reg_imm(nc, 3, 2 + native_v2_object_header_size() / 8)
    nc_emit_store_rax_mem_rdx_rbx8(nc)

    native_v2_core_emit_return_into(nc, 0)
    true
}

pub fn compile_native_v2_sret_witness_to_file(output_path: string, plain_call: bool) -> i32 with IO, Mut, Panic, Div, Alloc {
    var nc = compiler_new()
    compile_module_streaming_begin_count_into(&! nc, 2)

    if !native_v2_emit_sret_witness_main_into(&! nc, plain_call) { return 12 }
    if !native_v2_emit_sret_witness_make_into(&! nc) { return 12 }

    var final_data = nc.data
    if final_data.len < runtime_context_global_slot_size() {
        final_data.len = runtime_context_global_slot_size()
        nc.data = final_data
    }
    emit_entry_trampoline_split_into(&! nc, 0)
    let text_file_offset = 4096
    let reloc_rodata_off = align_page(text_file_offset + nc.code.len)
    let reloc_eff_rodata = if nc.flat_rodata_len > 0 { nc.flat_rodata_len } else { nc.rodata.len }
    let reloc_data_off = align_page(reloc_rodata_off + reloc_eff_rodata)
    apply_relocations_into(&! nc, reloc_rodata_off, reloc_data_off)
    native_v2_write_min_elf64_to_file(output_path, &! nc, nc.entry_offset, 4194304)
}

// Map MachineOperand to a scheduler register ID for dependency tracking.
// GPR64 → vreg directly; STACK_SLOT → 2000+slot; FLAGS → 4000; else REG_NONE.
fn mir_operand_to_sched_reg(op: MachineOperand) -> i64 {
    if op.kind == MIR_OPERAND_GPR64 { op.value }
    else if op.kind == MIR_OPERAND_STACK_SLOT { 2000 + op.value }
    else if op.kind == MIR_OPERAND_FLAGS { 4000 }
    else { REG_NONE }
}

fn mir_opcode_to_cgop(opcode: i64) -> i64 {
    if opcode == MIR_OP_LOAD_STACK || opcode == MIR_OP_FIELD_LOAD || opcode == MIR_OP_INDEX_LOAD
       || opcode == MIR_OP_LOAD_FLOAT_RIP { CGOP_LOAD }
    else if opcode == MIR_OP_STORE_STACK || opcode == MIR_OP_FIELD_STORE
            || opcode == MIR_OP_INDEX_STORE { CGOP_STORE }
    else if opcode == MIR_OP_BINOP || opcode == MIR_OP_FLOAT_BINOP { CGOP_MUL }
    else if opcode == MIR_OP_CALL { CGOP_CALL }
    else if opcode == MIR_OP_RET { CGOP_RET }
    else if opcode == MIR_OP_JMP || opcode == MIR_OP_JCC { CGOP_BRANCH }
    else { CGOP_MOV }
}

fn mir_opcode_latency(opcode: i64) -> i64 {
    if opcode == MIR_OP_LOAD_STACK || opcode == MIR_OP_FIELD_LOAD
       || opcode == MIR_OP_INDEX_LOAD || opcode == MIR_OP_LOAD_FLOAT_RIP { 4 }
    else if opcode == MIR_OP_FLOAT_BINOP { 5 }
    else if opcode == MIR_OP_BINOP { 3 }
    else if opcode == MIR_OP_CALL || opcode == MIR_OP_RET { 5 }
    else { 1 }
}

// Skylake execution port bitmask per MIR opcode.
// Bit 0=P0, 1=P1, 2=P2, 3=P3, 4=P4, 5=P5, 6=P6, 7=P7.
fn mir_opcode_port_mask(opcode: i64) -> i64 {
    if opcode == MIR_OP_LOAD_STACK || opcode == MIR_OP_FIELD_LOAD
       || opcode == MIR_OP_INDEX_LOAD || opcode == MIR_OP_LOAD_FLOAT_RIP { 12 }   // P2,P3
    else if opcode == MIR_OP_STORE_STACK || opcode == MIR_OP_FIELD_STORE
            || opcode == MIR_OP_INDEX_STORE { 144 }                                // P4,P7
    else if opcode == MIR_OP_FLOAT_BINOP { 1 }                                    // P0 (FP MUL)
    else if opcode == MIR_OP_CALL || opcode == MIR_OP_RET
            || opcode == MIR_OP_JMP || opcode == MIR_OP_JCC { 64 }                // P6
    else { 99 }                                                                    // P0,P1,P5,P6
}

// Scheduler runtime gate.  Drives compile_ir_function_v2_mut to
// either go through the legacy linear emitter or the basic-block
// list scheduler (CGPLAN_GLOBAL_BLOCK + cgplan_global_*).
fn native_v2_scheduler_enabled() -> bool { true }

fn compile_ir_function_v2_mut(nc: &! NativeCompiler, func: IrFunction, machine_func: MachineFunction, fn_index: i64) with Mut, Panic, Div, Alloc {
    reset_function_state_mut(nc)

    let function_offset = (*nc).code.len
    native_compiler_set_fn_offset(nc, fn_index, function_offset)
    (*nc).symbols = symbol_data_add_name((*nc).symbols, fn_index, func.name.buf, func.name.len)

    // Empty-stub builtins only — see native_v2_builtin_id_for_func_ref.
    if func.instr_count == 0 {
        if name_is_print_int(func.name) { (*nc) = emit_builtin_print_int((*nc)); return }
        if name_is_print_char(func.name) { (*nc) = emit_builtin_print_char((*nc)); return }
        if name_is_print(func.name) { (*nc) = emit_builtin_print_str((*nc)); return }
        if name_is_get_arg_count(func.name) { (*nc) = emit_builtin_get_arg_count((*nc)); return }
        if name_is_get_arg(func.name) { (*nc) = emit_builtin_get_arg((*nc)); return }
        if name_is_str_len(func.name) { (*nc) = emit_builtin_str_len((*nc)); return }
        if name_is_str_eq(func.name) { (*nc) = emit_builtin_str_eq((*nc)); return }
        if name_is_str_slice(func.name) { (*nc) = emit_builtin_str_slice((*nc)); return }
        if name_is_starts_with(func.name) { (*nc) = emit_builtin_starts_with((*nc)); return }
        if name_is_str_concat(func.name) { (*nc) = emit_builtin_str_concat((*nc)); return }
        if name_is_read_file(func.name) { (*nc) = emit_builtin_read_file((*nc)); return }
        if name_is_write_file(func.name) { (*nc) = emit_builtin_write_file((*nc)); return }
        if name_is_file_size(func.name) { (*nc) = emit_builtin_file_size((*nc)); return }
        if name_is_sqrt(func.name) { (*nc) = emit_builtin_sqrt((*nc)); return }
        if name_is_f64_to_bits(func.name) { (*nc) = emit_builtin_f64_bits_identity((*nc)); return }
        if name_is_bits_to_f64(func.name) { (*nc) = emit_builtin_f64_bits_identity((*nc)); return }
        if name_is_print_f64(func.name) { (*nc) = emit_builtin_print_f64((*nc)); return }
        if name_is_exp(func.name) { (*nc) = emit_builtin_exp((*nc)); return }
        if name_is_log(func.name) { (*nc) = emit_builtin_log((*nc)); return }
        if name_is_sin(func.name) { (*nc) = emit_builtin_sin((*nc)); return }
        if name_is_cos(func.name) { (*nc) = emit_builtin_cos((*nc)); return }
        if name_is_assert(func.name) { (*nc) = emit_builtin_assert((*nc)); return }
        if name_is_heap_alloc(func.name) { emit_builtin_heap_alloc_into(nc); return }
        if name_is_heap_free(func.name) { emit_builtin_heap_free_into(nc); return }
        if name_is_malloc(func.name) { emit_builtin_heap_alloc_into(nc); return }
        if name_is_free(func.name) { emit_builtin_heap_free_into(nc); return }
        if name_is_getpid(func.name) { emit_builtin_getpid_into(nc); return }
        if name_is_getppid(func.name) { emit_builtin_getppid_into(nc); return }
        if name_is_exit(func.name) { emit_builtin_exit_into(nc); return }
        if name_is_abort(func.name) { emit_builtin_abort_into(nc); return }
        if name_is_system(func.name) { emit_builtin_system_into(nc); return }
        if name_is_read_i64(func.name) { emit_builtin_read_offset64_into(nc); return }
        if name_is_write_i64(func.name) { emit_builtin_write_offset64_into(nc); return }
        if name_is_read_f64(func.name) { emit_builtin_read_offset64_into(nc); return }
        if name_is_write_f64(func.name) { emit_builtin_write_offset64_into(nc); return }
        if name_is_acknowledge(func.name) { (*nc) = emit_builtin_knowledge_value((*nc)); return }
        if name_is_require_confidence(func.name) { (*nc) = emit_builtin_knowledge_value((*nc)); return }
        if native_v2_empty_stub_would_fabricate(&func) {
            nc_emit_unimplemented_extern_trap_into(nc)
            return
        }
    }

    (*nc).current_strategy = func.compile_strategy
    native_v2_run_machine_regalloc_mut(nc, machine_func)

    let preg_mask = nc_used_allocatable_preg_mask((*nc), machine_func.temp_count)
    let frame_size = x86_align_frame_size_for_calls(native_v2_local_frame_size(machine_func.temp_count, (*nc).current_machine_spill_count), preg_mask)
    (*nc).current_frame_size = frame_size

    (*nc).code = emit_prologue_with_preg_mask((*nc).code, frame_size, preg_mask)
    spill_ir_params_mut(nc, func)
    if !native_v2_scheduler_enabled() {
        native_v2_emit_machine_function_mut(nc, machine_func, fn_index, function_offset)
    } else {
        // Per-basic-block scheduling: chop the MIR stream at labels,
        // jumps, rets, and calls; schedule each chunk through
        // CGPLAN_GLOBAL_BLOCK; emit terminators in original order
        // (preserves control-flow + safepoint positions).
        let n = machine_func.blocks[0].instr_count
        var block_start: i64 = 0
        var mi: i64 = 0
        while mi <= n {
            var is_terminator: bool = false
            if mi < n {
                let op = machine_func.blocks[0].instrs[mi as usize].opcode
                if op == MIR_OP_LABEL || op == MIR_OP_JMP || op == MIR_OP_JCC
                   || op == MIR_OP_RET || op == MIR_OP_CALL {
                    is_terminator = true
                }
            }
            if is_terminator || mi == n {
                if block_start < mi {
                    cgplan_global_reset()
                    var pi: i64 = block_start
                    while pi < mi {
                        let m = machine_func.blocks[0].instrs[pi as usize]
                        let cg = codegen_instr_with_port(
                            pi - block_start,
                            mir_opcode_to_cgop(m.opcode),
                            mir_operand_to_sched_reg(m.dst),
                            mir_operand_to_sched_reg(m.src1),
                            mir_operand_to_sched_reg(m.src2),
                            mir_opcode_latency(m.opcode),
                            mir_opcode_port_mask(m.opcode),
                            2
                        )
                        cgplan_global_add(cg)
                        pi = pi + 1
                    }
                    cgplan_global_build_deps()
                    cgplan_global_schedule()
                    let slen = cgplan_get_schedule_len()
                    var si: i64 = 0
                    while si < slen {
                        let local_idx = cgplan_get_schedule_slot(si)
                        let real_idx = block_start + local_idx
                        let em_instr = machine_func.blocks[0].instrs[real_idx as usize]
                        (*nc) = native_v2_emit_machine_instr((*nc), em_instr)
                        si = si + 1
                    }
                }
                if is_terminator {
                    let term_instr = machine_func.blocks[0].instrs[mi as usize]
                    if native_v2_machine_instr_is_safepoint(term_instr) {
                        let sp_kind = if term_instr.opcode == MIR_OP_CALL { NATIVE_V2_SAFEPOINT_CALL() } else { NATIVE_V2_SAFEPOINT_RET() }
                        native_v2_record_safepoint_mut(nc, fn_index, sp_kind, mi, (*nc).code.len - function_offset, machine_func.temp_count, (*nc).current_machine_spill_count)
                    }
                    (*nc) = native_v2_emit_machine_instr((*nc), term_instr)
                }
                block_start = mi + 1
            }
            mi = mi + 1
        }
    }

    let epilogue_offset = (*nc).code.len
    (*nc).code = emit_epilogue_with_preg_mask((*nc).code, preg_mask)
    patch_return_jumps_mut(nc, epilogue_offset)
    patch_label_forwards_mut(nc)
}

fn compile_module_v2(nc: NativeCompiler, module: &IrModule) -> (NativeCompiler, string) with Mut, Panic, Div, Alloc {
    var c = nc
    let err = compile_module_v2_mut(&! c, module)
    (c, err)
}

pub fn compile_module_v2_mut(nc: &! NativeCompiler, module: &IrModule) -> string with Mut, Panic, Div, Alloc {
    (*nc).fn_count = module.fn_count
    (*nc).runtime_context_slot_offset = 0
    let runtime_slot_size = runtime_context_global_slot_size()
    (*nc).prof_counter_data_base = runtime_slot_size
    (*nc).descriptor_data_offset = -1
    (*nc).descriptor_count = 0
    (*nc).gc_state_data_offset = -1
    (*nc).stack_map_data_offset = -1
    (*nc).deopt_state_data_offset = -1
    (*nc).stack_map_record_count = 0
    (*nc).safepoint_count = 0
    (*nc).deopt_point_count = 0
    var module_data = (*nc).data
    module_data.len = runtime_slot_size + (module.prof_counter_count * 8)
    (*nc).data = module_data

    let built = native_v2_build_machine_module(module, true)
    if !built.supported {
        return built.unsupported_detail
    }

    var fi: i64 = 0
    while fi < module.fn_count {
        compile_ir_function_v2_mut(nc, module.functions[fi as usize], built.functions[fi as usize], fi)
        fi = fi + 1
    }

    if module.prof_counter_count > 0 {
        var pi: i64 = 0
        while pi < module.prof_counter_count {
            let pc = module.prof_counters[pi as usize]
            (*nc).rodata = string_table_add((*nc).rodata, pc.fn_name.buf, pc.fn_name.len)
            (*nc).prof_counter_names[pi as usize] = (*nc).rodata.last_offset
            pi = pi + 1
        }
        (*nc).prof_counter_count = module.prof_counter_count
        let sprof_name = make_sprof_filename()
        (*nc).rodata = string_table_add((*nc).rodata, sprof_name.buf, sprof_name.len)
        (*nc).prof_sprof_name_offset = (*nc).rodata.last_offset
    }

    if (*nc).prof_counter_count > 0 {
        (*nc).prof_dump_fn_index = (*nc).fn_count
        native_compiler_set_fn_offset(nc, (*nc).fn_count, (*nc).code.len)
        (*nc).fn_count = (*nc).fn_count + 1
        (*nc) = emit_prof_dump_function((*nc), module)
    }

    native_v2_emit_runtime_metadata_into(nc)

    let main_idx = find_main_index(module)
    if main_idx >= 0 {
        emit_entry_trampoline_split_into(nc, main_idx)
    }

    let text_file_offset = 4096
    let rodata_file_offset = align_page(text_file_offset + (*nc).code.len)
    let min_data_len = (*nc).prof_counter_data_base + ((*nc).prof_counter_count * 8)
    let emitted_data_len = if (*nc).flat_data_len > 0 { (*nc).flat_data_len } else { (*nc).data.len }
    let effective_data_len = if emitted_data_len < min_data_len { min_data_len } else { emitted_data_len }
    let data_file_offset = if effective_data_len > 0 {
        align_page(rodata_file_offset + (*nc).rodata.len)
    } else { 0 }
    (*nc).code = apply_relocations((*nc).relocs, (*nc).code, (*nc).fn_offsets, (*nc).fn_count, rodata_file_offset, data_file_offset)

    ""
}

// Spill parameter registers to their IR-assigned stack slots
fn spill_ir_params(nc: NativeCompiler, func: IrFunction) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    spill_ir_params_mut(&! c, func)
    c
}

fn spill_ir_params_mut(nc: &! NativeCompiler, func: IrFunction) with Mut, Panic, Div {
    var i = 0
    let sret_shift = if func.is_sret == 1 { 1 } else { 0 }
    if sret_shift == 1 {
        let dest_reg = func.sret_dest_reg
        if dest_reg >= 0 {
            nc_emit_store_rbp_disp32_reg(nc, param_reg(0), ir_slot_offset(dest_reg))
        }
    }
    while i < func.param_count && (i + sret_shift) < 6 {
        let vreg = func.param_regs[i as usize]
        if vreg >= 0 {
            let preg = param_reg(i + sret_shift)
            let offset = ir_slot_offset(vreg)
            nc_emit_store_rbp_disp32_reg(nc, preg, offset)
        }
        i = i + 1
    }
    while i < func.param_count {
        let vreg = func.param_regs[i as usize]
        if vreg >= 0 {
            let in_offset = 16 + ((i + sret_shift - 6) * 8)
            let out_offset = ir_slot_offset(vreg)
            nc_emit_load_rbp_disp32_reg(nc, 0, in_offset)
            nc_emit_store_rbp_disp32_reg(nc, 0, out_offset)
        }
        i = i + 1
    }
}

fn spill_ir_params_ref_mut(nc: &! NativeCompiler, func: &IrFunction) with Mut, Panic, Div {
    var i = 0
    let sret_shift = if (*func).is_sret == 1 { 1 } else { 0 }
    if sret_shift == 1 {
        let dest_reg = (*func).sret_dest_reg
        if dest_reg >= 0 {
            nc_emit_store_rbp_disp32_reg(nc, param_reg(0), ir_slot_offset(dest_reg))
        }
    }
    while i < (*func).param_count && (i + sret_shift) < 6 {
        let vreg = (*func).param_regs[i as usize]
        if vreg >= 0 {
            let preg = param_reg(i + sret_shift)
            let offset = ir_slot_offset(vreg)
            nc_emit_store_rbp_disp32_reg(nc, preg, offset)
        }
        i = i + 1
    }
    while i < (*func).param_count {
        let vreg = (*func).param_regs[i as usize]
        if vreg >= 0 {
            let in_offset = 16 + ((i + sret_shift - 6) * 8)
            let out_offset = ir_slot_offset(vreg)
            nc_emit_load_rbp_disp32_reg(nc, 0, in_offset)
            nc_emit_store_rbp_disp32_reg(nc, 0, out_offset)
        }
        i = i + 1
    }
}

// ============================================================================
// V2_UFN_* pub helpers — used by native_compile_driver user-fn path
// ============================================================================

pub fn native_v2_core_begin_fn_spill_into(nc: &! NativeCompiler, func: &IrFunction, fn_index: i64) with Mut, Panic, Div {
    nc_v2_reset_label_state()
    reset_function_state_mut(nc)
    let function_offset = (*nc).code.len
    native_compiler_set_fn_offset(nc, fn_index, function_offset)
    native_compiler_add_symbol_func_ref(nc, fn_index, func)
    nc_emit_push_rbp(nc)
    nc_emit_mov_rbp_rsp(nc)
    let frame_sz = align16((*func).reg_count * 8)
    if frame_sz > 0 {
        nc_emit_sub_rsp_imm32(nc, frame_sz)
    }
    spill_ir_params_ref_mut(nc, func)
}

pub fn native_v2_core_emit_any_binop_into(nc: &! NativeCompiler, dst: i64, lhs: i64, op_code: i64, rhs: i64) -> bool with Mut, Panic, Div {
    if op_code == 1 {
        nc_core_load_temp_to_rax(nc, lhs)
        nc_emit_push_rax(nc)
        nc_core_load_temp_to_rax(nc, rhs)
        nc_emit_pop_rbx(nc)
        nc_emit_add_rax_rbx(nc)
        nc_core_store_rax_to_temp(nc, dst)
        return true
    }
    if op_code == 2 {
        nc_core_load_temp_to_rax(nc, rhs)
        nc_emit_push_rax(nc)
        nc_core_load_temp_to_rax(nc, lhs)
        nc_emit_pop_rbx(nc)
        nc_emit_sub_rax_rbx(nc)
        nc_core_store_rax_to_temp(nc, dst)
        return true
    }
    if op_code == 3 {
        nc_core_load_temp_to_rax(nc, lhs)
        nc_emit_push_rax(nc)
        nc_core_load_temp_to_rax(nc, rhs)
        nc_emit_pop_rbx(nc)
        nc_emit_imul_rax_rbx(nc)
        nc_core_store_rax_to_temp(nc, dst)
        return true
    }
    if op_code == 4 {
        nc_core_load_temp_to_rax(nc, rhs)
        nc_emit_mov_reg_reg(nc, 1, 0)
        nc_core_load_temp_to_rax(nc, lhs)
        nc_emit_cqo(nc)
        nc_emit_idiv_rcx(nc)
        nc_core_store_rax_to_temp(nc, dst)
        return true
    }
    // Comparison: 5=eq,6=ne,7=lt,8=le,9=gt,10=ge
    // Load rhs first (push), then lhs into rax, pop rbx=rhs
    // cmp rax(lhs), rbx(rhs): setg=lhs>rhs, setge=lhs>=rhs, setl=lhs<rhs, setle=lhs<=rhs
    if op_code >= 5 && op_code <= 10 {
        nc_core_load_temp_to_rax(nc, rhs)
        nc_emit_push_rax(nc)
        nc_core_load_temp_to_rax(nc, lhs)
        nc_emit_pop_rbx(nc)
        nc_emit_cmp_rax_rbx(nc)
        if op_code == 5 { nc_emit_sete_al(nc) }
        else if op_code == 6 { nc_emit_setne_al(nc) }
        else if op_code == 7 { nc_emit_setl_al(nc) }
        else if op_code == 8 { nc_emit_setle_al(nc) }
        else if op_code == 9 { nc_emit_setg_al(nc) }
        else { nc_emit_setge_al(nc) }
        nc_emit_movzx_rax_al(nc)
        nc_core_store_rax_to_temp(nc, dst)
        return true
    }
    false
}

pub fn native_v2_core_define_label_into(nc: &! NativeCompiler, label_id: i64) with Mut, Panic {
    nc_define_label(nc, label_id)
}

pub fn native_v2_core_emit_jump_to_label_into(nc: &! NativeCompiler, label_id: i64) with Mut, Panic, Div {
