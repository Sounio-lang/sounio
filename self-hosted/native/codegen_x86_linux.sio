// self-hosted::native::codegen — Native x86-64 code generator orchestrator
//
// Phase 1: Full function compilation pipeline.
// Takes an IrModule, compiles each function with proper stack frames,
// emits an entry trampoline, applies relocations, and produces an ELF64 binary.

module native::codegen_x86_linux

use parser::ast::{Name}
use ir::ir::{IrModule, IrFunction, IrInstr, IrOpcode, IR_MAX_FUNCS, IR_MAX_STRINGS, IR_FLOAT_REG_MARKER_FLAG, ir_name_eq, BSS_BASE_LINUX, IR_STRATEGY_BSS_GLOBAL, BSS_INIT_STRING_MAGIC}
use native::encode::*
use native::elf::*
use native::aarch64::*
use native::macho::*
use native::reloc::*
use native::frame::*
use native::lower_ir::{lower_instr, nc_run_regalloc, nc_min_frame_size, emit_binop_code, emit_float_binop_code}
use native::machine_ir::*
use native::peephole::{ph_run_on_func}
use native::regalloc::*
use native::regs::{param_reg}
use native::gc::*
use native::runtime_context::*
use native::stack_maps::*
use native::target_policy::*
use native::codegen_plan::*
// Sprint 40: IR-level dual-path transformation for Instrumented strategy
use ir::opt_strategy::{ir_opt_apply_strategy}
// io::trace is a lightweight extraction of io::file_write's trace helpers.
// Importing io::file_write directly causes type-checker stack overflow due to
// its transitive imports (parser::ast::*, lexer::*, native::encode::*) combined
// with the 18 native:: module imports already present here (~2000+ symbols).
use io::trace::{io_trace_append_byte, io_trace_append_string, io_trace_append_json_string, io_trace_bool_string, io_trace_i64_string, io_write_bytes_to_file}
use io::env::{read_env}
// Note: native::avx512 EVEX emitters are available in native/avx512.sio.
// They will be wired into the lowering pass in Horizon 3.2 (vector IR ops).

// BSS buffer for ELF output — module-scope so it is NOT stack-allocated.
// 16MB handles the largest expected self-hosted compiler binary (~2-4MB).
var NATIVE_ELF_BUF: [i8; 16777216] = [0; 16777216]
// Write cursor — module-scope avoids &! i64 ref mutation issues in helper fns.
var NATIVE_ELF_OFF: i64 = 0
// Set when nc_elf_put_u8 is asked to store past native_elf_buf_capacity_bytes().
// The legacy writer (compile_native_finalize_and_write_ref) used to have NO bound
// check at all; with NC_BIG_CODE raised to 8 MiB a large module can now push the
// assembled image at this 16 MiB buffer, so the store is bounded and the writer
// refuses to emit rather than shipping a truncated ELF. i64 (0/1) rather than
// bool: module-global bool init is not exercised elsewhere in this backend.
var NATIVE_ELF_OVERFLOW: i64 = 0
// Which function is being emitted right now, so nc_note_label_overflow can name
// it. Per-function state, set beside nc_v2_reset_label_state; the surviving
// record lives in NC_V2_LABEL_OVERFLOW_FN (frame.sio), which is reset per COMPILE.
var NC_V2_CURRENT_FN_INDEX: i64 = -1
// Cached SOUNIO_WIDE_MUL_SABOTAGE. i64 (0/1) rather than bool: module-global
// bool init is not exercised elsewhere in this backend. Refreshed from the
// IO compile entry so nc_wide_mul_into does not take IO — its emit-loop
// helper must stay Mut/Panic/Div or the effect walks the core_ir graph.
var NC_WIDE_MUL_SABOTAGE: i64 = 0

fn nc_note_label_overflow(nc: &! NativeCompiler) with Mut, Panic {
    (*nc).label_overflow = true
    if NC_V2_LABEL_OVERFLOW_FN < 0 {
        NC_V2_LABEL_OVERFLOW_FN = NC_V2_CURRENT_FN_INDEX
    }
}
// Off-stack ELF-image output buffer for native_v2_write_min_elf64_to_file. Its
// image used to be built into a `var bytes: [i8; 262144]` STACK local — too small
// for large programs (isa ELF ~700KB, evm ~2.1MB) and itself a large-stack-frame
// hazard. This module-global BSS array (demand-paged, ~0 RSS until touched) holds
// the assembled ELF image. Written INLINE only (direct NC_BIG_ELF[i]).
var NC_BIG_ELF: [i8; 16777216] = [0; 16777216]
// Single source of truth for the NC_BIG_ELF bound. The DECLARATION above must
// stay a literal; every bound CHECK calls this accessor. NOTE: this value must
// never be confused with the ELF LOAD BASE ADDRESS 0x400000 (4194304), which is
// passed as the `base_addr` argument at several call sites and is unrelated to
// buffer capacity. Pinned by scripts/ci/native_capacity_tiers_gate.sh.
fn nc_elf_capacity_bytes() -> i64 { 16777216 }
// Scratch IR functions for the sret witness. These are module-scope to avoid
// putting IrFunction-sized temporaries on the Madaros runtime stack.
var NV2_SRET_MAIN_FN: IrFunction = ir_empty_function()
var NV2_SRET_MAKE_FN: IrFunction = ir_empty_function()

