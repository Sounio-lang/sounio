    // F2 48 0F 2C C0  (cvttsd2si rax, xmm0)
    nc_emit_byte(nc, 0xF2); nc_emit_byte(nc, 0x48); nc_emit_byte(nc, 0x0F)
    nc_emit_byte(nc, 0x2C); nc_emit_byte(nc, 0xC0)
}

