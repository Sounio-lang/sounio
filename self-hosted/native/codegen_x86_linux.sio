    nc_emit_jmp_rel32(nc)
    nc_add_label_patch(nc, jmp_pos + 1, label_id)
}

pub fn native_v2_core_emit_branch_false_to_label_into(nc: &! NativeCompiler, cond_reg: i64, label_id: i64) with Mut, Panic, Div {
