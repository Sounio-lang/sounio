// Worker capability identities. Native admission remains closed until the
// final-IR closure, capability-flow and isolated-clone proofs are available.
module native::worker_proof
use parser::ast::{Name,make_name,name_eq,empty_name}
pub fn worker_intrinsic_op(name:Name)->i64 with Mut,Panic,Div {
    if name_eq(name,make_name("worker_fn_i64")) {return 1}
    if name_eq(name,make_name("worker_fn_f64")) {return 2}
    if name_eq(name,make_name("worker_fn_i64_raw")) {return 17}
    if name_eq(name,make_name("worker_fn_f64_raw")) {return 18}
    0
}
pub fn worker_protected_name(op:i64)->Name with Mut,Panic,Div {
    if op==1 {return make_name("@worker:cap_i64")}
    if op==2 {return make_name("@worker:cap_f64")}
    if op==17 {return make_name("@worker:raw_i64")}
    if op==18 {return make_name("@worker:raw_f64")}
    empty_name()
}
pub fn worker_protected_id(name:Name)->i64 with Mut,Panic,Div {
    if name_eq(name,make_name("@worker:cap_i64")) {return 2001}
    if name_eq(name,make_name("@worker:cap_f64")) {return 2002}
    if name_eq(name,make_name("@worker:raw_i64")) {return 2017}
    if name_eq(name,make_name("@worker:raw_f64")) {return 2018}
    0
}

pub fn worker_type_name(name:Name)->bool with Mut,Panic,Div {
    name_eq(name,make_name("WorkerFnI64")) || name_eq(name,make_name("WorkerFnF64"))
}
