// self-hosted::native::regs — Register allocation and mapping
//
// Simple fixed register allocation for bootstrap (no spilling).

// x86-64 register indices (hardware encoding)
fn reg_rax() -> i64 { 0 }
fn reg_rcx() -> i64 { 1 }
fn reg_rdx() -> i64 { 2 }
fn reg_rbx() -> i64 { 3 }
fn reg_rsp() -> i64 { 4 }
fn reg_rbp() -> i64 { 5 }
fn reg_rsi() -> i64 { 6 }
fn reg_rdi() -> i64 { 7 }
fn reg_r8() -> i64  { 8 }
fn reg_r9() -> i64  { 9 }
fn reg_r10() -> i64 { 10 }
fn reg_r11() -> i64 { 11 }
fn reg_r12() -> i64 { 12 }
fn reg_r13() -> i64 { 13 }
fn reg_r14() -> i64 { 14 }
fn reg_r15() -> i64 { 15 }

// System V ABI parameter registers (in order)
fn param_reg(index: i64) -> i64 {
    if index == 0 { reg_rdi() }
    else if index == 1 { reg_rsi() }
    else if index == 2 { reg_rdx() }
    else if index == 3 { reg_rcx() }
    else if index == 4 { reg_r8() }
    else if index == 5 { reg_r9() }
    else { -1 }  // Stack args not yet supported
}

// Return value register
fn return_reg() -> i64 {
    reg_rax()
}

// Caller-saved registers (can be clobbered by function calls)
fn is_caller_saved(reg: i64) -> i64 {
    if reg == reg_rax() { 1 }
    else if reg == reg_rcx() { 1 }
    else if reg == reg_rdx() { 1 }
    else if reg == reg_rsi() { 1 }
    else if reg == reg_rdi() { 1 }
    else if reg == reg_r8() { 1 }
    else if reg == reg_r9() { 1 }
    else if reg == reg_r10() { 1 }
    else if reg == reg_r11() { 1 }
    else { 0 }
}

// Callee-saved registers (must be preserved across calls)
fn is_callee_saved(reg: i64) -> i64 {
    if reg == reg_rbx() { 1 }
    else if reg == reg_r12() { 1 }
    else if reg == reg_r13() { 1 }
    else if reg == reg_r14() { 1 }
    else if reg == reg_r15() { 1 }
    else { 0 }
}

// SIMD register accessors (ZMM0–31 / YMM0–15 / XMM0–15 / opmask k0–k7)
// ZMM, YMM and XMM share the same 5-bit hardware encoding (0–31);
// the register width is encoded in the EVEX L'L field, not the register number.
fn reg_zmm(n: i64) -> i64 { n }
fn reg_ymm(n: i64) -> i64 { n }
fn reg_xmm(n: i64) -> i64 { n }
fn reg_opmask(n: i64) -> i64 { n }  // k0–k7 (opmask registers for predicated ops)

// Simple register allocator: map HIR values to x86-64 registers
// For bootstrap, use a fixed mapping (no spilling)
struct RegAlloc {
    next_reg: i64,        // Next available register
}

fn reg_alloc_new() -> RegAlloc {
    RegAlloc { next_reg: 0 }
}

fn alloc_reg(allocator: RegAlloc) -> RegAlloc with Mut, Panic {
    var a = allocator
    // Skip rsp (4) and rbp (5) - they're reserved for stack
    if a.next_reg == 4 {
        a.next_reg = 6
    }

    let allocated = a.next_reg
    a.next_reg = a.next_reg + 1

    if a.next_reg >= 16 {
        // Out of registers - would need spilling
        // For bootstrap, just wrap around (unsafe but simple)
        a.next_reg = 0
    }
    a
}
