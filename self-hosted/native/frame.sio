// self-hosted::native::frame — Stack frame management for x86-64 System V ABI
//
// Handles function prologue/epilogue, local variable allocation, and frame layout.
// Also owns NativeCompiler state (shared between codegen and lower_ir to break
// the mutual dependency between those two modules).

module native::frame

use native::encode::*
use native::reloc::{RelocationTable, reloc_table_new, patch_u32_le, ExternRelocTable, extern_reloc_table_new}
use native::elf::{StringTable, string_table_new, SymbolData, symbol_data_new}
use native::runtime_context::{runtime_context_global_slot_size}
use native::target_policy::{native_target_policy_x86_allocatable_mask_for_reg}

// Per-function virtual-register table capacity for NativeCompiler.
// Must stay in sync with regalloc / codegen vreg index guards.
// Historical silent wall was 512 (loads zeroed / stores dropped past it).
pub let NC_MAX_VREGS: i64 = 2048

// Stack frame state for a single function
pub struct StackFrame {
    pub frame_size: i64,              // Total frame size (16-byte aligned)
    pub local_count: i64,             // Number of local variables
    pub param_count: i64,             // Number of parameters
    pub return_jump_count: i64,       // Number of pending return jumps to patch
}

pub fn stack_frame_new() -> StackFrame {
    StackFrame {
        frame_size: 0,
        local_count: 0,
        param_count: 0,
        return_jump_count: 0,
    }
}

// Prepare frame layout: allocate space for params + locals
pub fn prepare_frame(params: i64, locals: i64) -> StackFrame with Mut, Panic {
    var frame = stack_frame_new()
    frame.param_count = params
    frame.local_count = locals

    // Each param/local gets 8 bytes (i64)
    let total_vars = params + locals
    let raw_size = total_vars * 8

    // Align to 16 bytes (System V ABI requirement)
    frame.frame_size = align16(raw_size)
    frame
}

// Align size up to next 16-byte boundary
pub fn align16(size: i64) -> i64 with Mut, Panic {
    var aligned = size
    let remainder = size % 16
    if remainder != 0 {
        aligned = size + (16 - remainder)
    }
    aligned
}

// Align size up to next 64-byte boundary (required for ZMM vmovapd loads/stores)
pub fn align64(size: i64) -> i64 with Mut, Panic {
    var aligned = size
    let remainder = size % 64
    if remainder != 0 {
        aligned = size + (64 - remainder)
    }
    aligned
}

// Allocate a ZMM stack slot (64 bytes) in the current frame.
// Returns the rbp-relative offset (negative) of the slot's low address.
// The caller must ensure prepare_frame was called with sufficient space;
// this helper computes the offset for slot_index (0-based) below the
// first 64-byte-aligned boundary below rbp.
//
// Layout (growing downward from rbp):
//   rbp - 64*(slot_index+1)  →  slot_index=0 at rbp-64, slot 1 at rbp-128, …
//
// Callers must also ensure frame_size is passed through align64() so that
// rsp ends up 64-byte aligned before the first vmovapd.
pub fn zmm_stack_slot_offset(slot_index: i64) -> i64 {
    -(slot_index + 1) * 64
}

pub fn X86_ALLOCATABLE_R12_MASK() -> i64 { native_target_policy_x86_allocatable_mask_for_reg(12) }
pub fn X86_ALLOCATABLE_R13_MASK() -> i64 { native_target_policy_x86_allocatable_mask_for_reg(13) }
pub fn X86_ALLOCATABLE_R14_MASK() -> i64 { native_target_policy_x86_allocatable_mask_for_reg(14) }
pub fn X86_ALLOCATABLE_R15_MASK() -> i64 { native_target_policy_x86_allocatable_mask_for_reg(15) }

pub fn x86_allocatable_mask_for_reg(reg: i64) -> i64 {
    native_target_policy_x86_allocatable_mask_for_reg(reg)
}

pub fn x86_allocatable_preg_count(mask: i64) -> i64 {
    var count: i64 = 0
    if (mask & X86_ALLOCATABLE_R12_MASK()) != 0 { count = count + 1 }
    if (mask & X86_ALLOCATABLE_R13_MASK()) != 0 { count = count + 1 }
    if (mask & X86_ALLOCATABLE_R14_MASK()) != 0 { count = count + 1 }
    if (mask & X86_ALLOCATABLE_R15_MASK()) != 0 { count = count + 1 }
    count
}

pub fn nc_used_allocatable_preg_mask(nc: NativeCompiler, reg_count: i64) -> i64 {
    var mask: i64 = 0
    var v: i64 = 0
    // vreg_to_preg has NC_MAX_VREGS entries. Higher vregs are stack-only.
    while v < reg_count && v < NC_MAX_VREGS {
        mask = mask | x86_allocatable_mask_for_reg(NC_VREG_TO_PREG[v as usize])
        v = v + 1
    }
    mask
}

// SysV x86-64 requires rsp%16==0 before an internal CALL.
// With push rbp always present, odd numbers of saved allocatable regs need an extra 8-byte pad.
pub fn x86_align_frame_size_for_calls(frame_size: i64, preg_mask: i64) -> i64 with Mut, Panic {
    if (x86_allocatable_preg_count(preg_mask) % 2) == 0 {
        frame_size
    } else {
        frame_size + 8
    }
}

// Emit function prologue for the allocatable preg subset actually used by the lowered function.
pub fn emit_prologue_with_preg_mask(buf: CodeBuffer, frame_size: i64, preg_mask: i64) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    if (preg_mask & X86_ALLOCATABLE_R15_MASK()) != 0 { b = emit_push_r15(b) }
    if (preg_mask & X86_ALLOCATABLE_R14_MASK()) != 0 { b = emit_push_r14(b) }
    if (preg_mask & X86_ALLOCATABLE_R13_MASK()) != 0 { b = emit_push_r13(b) }
    if (preg_mask & X86_ALLOCATABLE_R12_MASK()) != 0 { b = emit_push_r12(b) }
    b = emit_push_rbp(b)
    b = emit_mov_rbp_rsp(b)
    if frame_size > 0 {
        // emit_sub_rsp_imm32 probes page-by-page for frames ≥ 4 KiB and always
        // emits the lean post-sub probe for smaller frames (see encode.sio).
        b = emit_sub_rsp_imm32(b, frame_size)
    }
    b
}

pub fn emit_epilogue_with_preg_mask(buf: CodeBuffer, preg_mask: i64) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_mov_rsp_rbp(b)
    b = emit_pop_rbp(b)
    if (preg_mask & X86_ALLOCATABLE_R12_MASK()) != 0 { b = emit_pop_r12(b) }
    if (preg_mask & X86_ALLOCATABLE_R13_MASK()) != 0 { b = emit_pop_r13(b) }
    if (preg_mask & X86_ALLOCATABLE_R14_MASK()) != 0 { b = emit_pop_r14(b) }
    if (preg_mask & X86_ALLOCATABLE_R15_MASK()) != 0 { b = emit_pop_r15(b) }
    b = emit_ret(b)
    b
}

// Compatibility wrappers for the existing low-level encoder tests.
pub fn emit_prologue(buf: CodeBuffer, frame_size: i64) -> CodeBuffer with Mut, Panic, Div {
    emit_prologue_with_preg_mask(
        buf,
        frame_size,
        X86_ALLOCATABLE_R12_MASK() |
        X86_ALLOCATABLE_R13_MASK() |
        X86_ALLOCATABLE_R14_MASK() |
        X86_ALLOCATABLE_R15_MASK()
    )
}

pub fn emit_epilogue(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_epilogue_with_preg_mask(
        buf,
        X86_ALLOCATABLE_R12_MASK() |
        X86_ALLOCATABLE_R13_MASK() |
        X86_ALLOCATABLE_R14_MASK() |
        X86_ALLOCATABLE_R15_MASK()
    )
}

// Get local variable offset from rbp (negative offsets)
pub fn local_offset(frame: StackFrame, local_index: i64) -> i64 {
    // Locals: rbp-8, rbp-16, rbp-24, ...
    // Params come first, then locals
    -(frame.param_count + local_index + 1) * 8
}

// Get parameter offset from rbp (negative offsets)
pub fn param_offset(param_index: i64) -> i64 {
    // Params: rbp-8, rbp-16, rbp-24, ...
    -(param_index + 1) * 8
}

// ============================================================================
// Label patching for intra-function control flow
// (Defined here to break codegen <-> lower_ir mutual dependency)
// ============================================================================

pub struct LabelPatch {
    pub code_offset: i64,       // Position of the rel32 operand to patch
    pub label_id: i64,          // Target label
}

pub fn empty_label_patch() -> LabelPatch {
    LabelPatch { code_offset: 0, label_id: -1 }
}

// Global label-tracking arrays for native_v2 path.
// Array element writes through &! NativeCompiler fail for large struct offsets,
// so label state lives in module-level globals instead.
//
// These were [i64; 256] and BOTH bounds were silent (no else, no sentinel), which
// made every function with more than ~128 `if`s miscompile at rc=0 with no
// diagnostic: a dropped patch leaves the jz/jmp rel32 operand at its placeholder
// 0, so the branch falls through instead of jumping. Measured on a flat chain of
// N comparisons, the number of WRONG answers was exactly N-128, and past ~160 the
// program printed nothing at all -- still rc=0. That is the shape reported in
// #1586/#1570/#1577, and it is why the documented workaround in all three ("move
// the code into a helper function") worked: nc_v2_reset_label_state runs per
// function, so a helper gets a fresh 256.
pub var NC_V2_LABEL_OFFSETS: [i64; 16384] = [0; 16384]
pub var NC_V2_LABEL_PATCH_OFFSETS: [i64; 16384] = [0; 16384]
pub var NC_V2_LABEL_PATCH_IDS: [i64; 16384] = [0; 16384]
pub var NC_V2_LABEL_PATCH_COUNT: i64 = 0
pub var NC_V2_NEXT_CMP_LABEL: i64 = 210
// Which function tripped the capacity FIRST, so the rc=22 message can name it.
// NativeCompiler.label_overflow is only checked after the whole per-function loop
// has run, by which point the identity is gone, and nc_define_label /
// nc_add_label_patch have no fn_index in scope. Threading one down would mean
// changing three hot signatures on the very path whose &!-with-large-offsets
// miscompile is what pushed this state into globals to begin with, so it is
// recorded here instead. -1 = none. Reset per COMPILE in compiler_new, beside
// label_overflow itself -- not per function, or it would forget the offender it
// exists to remember.
pub var NC_V2_LABEL_OVERFLOW_FN: i64 = -1

// Single source of truth for the NC_V2_LABEL_* bound, same contract as
// nc_flat_reloc_capacity() below: the three DECLARATIONS above must stay literals
// (Sounio array sizes are not expressions); every bound CHECK calls this instead.
//
// 16384 is not a guess. Every label id reaching codegen came from a fresh_label in
// the SAME function and is materialised by an IrLabel; every patch comes from an
// IrJump/IrBranchFalse/IrBranchTrue. All of them are read by the one emit loop in
// compile_ir_function_v2_core_ir_into, which is bounded by IR_MAX_INSTRS. So
//
//     nc_v2_label_capacity() >= IR_MAX_INSTRS  =>  this tier cannot overflow.
//
// scripts/ci/native_capacity_tiers_gate.sh pins that inequality (>=, not ==, so a
// later IR_MAX_INSTRS bump is caught rather than silently invalidating the proof).
// Overflowing it anyway is NOT silent any more: nc_define_label/nc_add_label_patch
// set NativeCompiler.label_overflow and both writers return rc=22 (distinct from
// the code-buffer rc=19, the reloc rc=20 and the ELF rc=21).
//
// The reset stays FULL (0..capacity). A reset bounded by the function's label_count
// was considered and rejected: it leaves real code offsets from the PREVIOUS
// function live above the bound, which is the same wrong-target bug wearing a
// different hat. At 4096 the full reset cost ~1.8M stores for a 449-function
// compile -- immaterial. If this tier ever goes past 65536, revisit with a dirty-
// length cursor; the gate fails if it does without one.
//
// Raised 4096 -> 16384 on 2026-08-28, because IR_MAX_INSTRS had been raised
// 4096 -> 16384 and the tier had not followed. The gate caught it exactly as its
// author intended -- native_capacity_tiers_gate.sh was RED on main with
// label_tier_4096_below_ir_max_instrs_16384, which is the >= clause doing its
// job rather than a new defect. The full reset now costs ~4x what the note above
// measured; still immaterial, and still below the 65536 line where a dirty-length
// cursor becomes worth it.
pub fn nc_v2_label_capacity() -> i64 { 16384 }

// Off-stack flat relocation table for the native_v2 x86 Linux path. This is
// module-WIDE (accumulates across ALL functions of a compile, reset via
// flat_reloc_count=0 in compiler_new). It used to be four [i64; 4096] arrays
// inline in NativeCompiler — but a large multi-function program overflows 4096
// (e.g. the EISA isa suite emits ~9700 relocations across its 467 functions),
// silently dropping every reloc past 4096, so calls/rodata refs (incl. the entry
// trampoline's call to main) stay unpatched → jump to garbage → SIGSEGV. Raising
// the inline arrays would add ~2MB to NativeCompiler's stack frame (rc=14 zone),
// so they live off-stack here (BSS, demand-paged). flat_reloc_count stays a scalar
// in NativeCompiler and indexes these. Accessed INLINE only (never a returning
// helper — that miscompiles under the seed).
pub var NC_FLAT_RELOC_OFFSETS: [i64; 2097152] = [0; 2097152]
pub var NC_FLAT_RELOC_KIND_CODES: [i64; 2097152] = [0; 2097152]
pub var NC_FLAT_RELOC_IS_FUNCTIONS: [i64; 2097152] = [0; 2097152]
pub var NC_FLAT_RELOC_TARGET_INDICES: [i64; 2097152] = [0; 2097152]

// Single source of truth for the NC_FLAT_RELOC_* bound. The four DECLARATIONS
// above must stay literals (Sounio array sizes are not expressions); every bound
// CHECK (nc_add_flat_reloc, apply_relocations_into) calls this accessor instead.
// Overflowing this tier is NOT silent any more: nc_add_flat_reloc sets
// NativeCompiler.reloc_overflow and compile_native_v2_preview_to_file returns
// rc=20 (distinct from the code-buffer rc=19). Pinned by
// scripts/ci/native_capacity_tiers_gate.sh.
pub fn nc_flat_reloc_capacity() -> i64 { 2097152 }

// A relocation whose kind_code apply_relocations_into does not know (anything
// but 1 call, 2 rodata, 3 data, 4 fn-address) used to fall through the kind
// chain and leave its rel32 site unpatched: the ELF wrote, and the program
// jumped through the placeholder at run time. It now latches reloc_overflow
// (so every writer that already refuses on rc=20 refuses here too) and counts
// here so the refusal names the real cause instead of "raise capacity".
// compiler_new resets both.
pub var NC_RELOC_UNKNOWN_KIND_COUNT: i64 = 0
pub var NC_RELOC_UNKNOWN_KIND_FIRST: i64 = 0

// The kinds apply_relocations_into (codegen_x86_linux.sio) can patch: 1 call
// rel32, 2 .rodata RIP-disp, 3 .data RIP-disp, 4 function-address RIP-disp.
// Kept here, not in codegen_x86_linux.sio, so a test can pin the predicate and
// the recorder by importing native::frame alone instead of the whole x86
// backend (whose import closure takes longer to compile than a run-pass budget).
pub fn native_v2_reloc_kind_is_known(kind_code: i64) -> bool {
    kind_code >= 1 && kind_code <= 4
}

// Records an unknown-kind relocation. native_reloc_refuse_if_invalid (below,
// after NativeCompiler) refuses (rc=20) whenever NC_RELOC_UNKNOWN_KIND_COUNT > 0,
// independently of reloc_overflow, and every writer of a relocated image calls it.
pub fn nc_reloc_note_unknown_kind(kind_code: i64) with Mut {
    if NC_RELOC_UNKNOWN_KIND_COUNT == 0 {
        NC_RELOC_UNKNOWN_KIND_FIRST = kind_code
    }
    NC_RELOC_UNKNOWN_KIND_COUNT = NC_RELOC_UNKNOWN_KIND_COUNT + 1
}

// Flat .rodata payload storage (string literals et al). Moved off the
// NativeCompiler struct for the same reason as NC_FLAT_RELOC_* above:
// keeping it in the struct capped .rodata at 8192 bytes (struct-copy cost
// forbids growth), which silently truncated every literal past the cap —
// programs with more than ~8KB of string data (e.g. the pure LSP server)
// miscompiled. The 256 KiB bump this comment used to describe had the exact
// same defect at a new scale: append sites bound-checked the write but never
// set a fail-closed flag, so self-hosted/compiler/main.sio (measured
// 2026-09-03: needs 963,478 bytes at 13,140 functions) silently truncated
// past 256 KiB with no error — the ELF still wrote and still ran (badly:
// pointers into the never-written tail read stale/zero BSS). Raised to 2 MiB
// with real headroom and a real rc=23 refusal (compile_native_v2_preview_to_file).
// Accessed INLINE only; flat_rodata_len stays in the struct as the cursor.
pub var NC_BIG_RODATA: [i8; 2097152] = [0; 2097152]

// Single source of truth for the NC_BIG_RODATA bound. The DECLARATION above
// must stay a literal (Sounio array sizes are not expressions); every bound
// CHECK calls this accessor. Pinned by scripts/ci/native_capacity_tiers_gate.sh.
pub fn nc_flat_rodata_capacity() -> i64 { 2097152 }

// Runtime metadata is also emitted into .data.  Keeping that payload in the
// inline StringTable truncated stack maps after 8 KiB, even though the compiler
// records up to 256 safepoints.  Use the same off-stack pattern as rodata so the
// compiler state remains cheap to copy while the emitted ELF keeps all bytes.
pub var NC_BIG_DATA: [i8; 262144] = [0; 262144]

pub fn nc_flat_data_capacity() -> i64 { 262144 }

// ============================================================================
// Compiler state
// ============================================================================
// Function index -> code offset. BSS, not a field of NativeCompiler.
// compiler_new fills every slot with -1 (unset). 0 would be a real offset.
pub var NC_FN_OFFSETS: [i64; 16384] = [0; 16384]


// Indexed arrays that used to live in NativeCompiler. Element stores at
// large struct offsets SIGSEGV in the seed compiler (the label_offsets
// loop in compiler_new was enough). BSS, one live compile. compiler_new
// resets them. Not safe for two simultaneously live NativeCompilers.
pub var NC_RETURN_JUMPS: [i64; 16] = [0; 16]
pub var NC_LABEL_OFFSETS: [i64; 256] = [0; 256]
pub var NC_LABEL_PATCH_CODE_OFFSETS: [i64; 256] = [0; 256]
pub var NC_LABEL_PATCH_LABEL_IDS: [i64; 256] = [0; 256]
pub var NC_IS_FLOAT_REG: [i64; 2048] = [0; 2048]
pub var NC_REG_TYPE: [i64; 2048] = [0; 2048]
pub var NC_FIELD_FLOAT_BASE_REGS: [i64; 256] = [0; 256]
pub var NC_FIELD_FLOAT_INDICES: [i64; 256] = [0; 256]
pub var NC_PROF_COUNTER_NAMES: [i64; 256] = [0; 256]
pub var NC_STACK_MAP_FN_INDICES: [i64; 256] = [0; 256]
pub var NC_STACK_MAP_KINDS: [i64; 256] = [0; 256]
pub var NC_STACK_MAP_MACHINE_INSTR_INDICES: [i64; 256] = [0; 256]
pub var NC_STACK_MAP_CODE_OFFSETS: [i64; 256] = [0; 256]
pub var NC_STACK_MAP_FRAME_SIZES: [i64; 256] = [0; 256]
pub var NC_STACK_MAP_TEMP_COUNTS: [i64; 256] = [0; 256]
pub var NC_STACK_MAP_SPILL_COUNTS: [i64; 256] = [0; 256]
pub var NC_STACK_MAP_ROOT_TEMP_COUNTS: [i64; 256] = [0; 256]
pub var NC_STACK_MAP_ROOT_SPILL_COUNTS: [i64; 256] = [0; 256]
pub var NC_STACK_MAP_CALLEE_SAVED_ROOT_MASKS: [i64; 256] = [0; 256]
pub var NC_STACK_MAP_ROOT_KIND_MASKS: [i64; 256] = [0; 256]
pub var NC_STACK_MAP_DEOPT_IDS: [i64; 256] = [0; 256]
pub var NC_STACK_MAP_TIER_IDS: [i64; 256] = [0; 256]
pub var NC_STACK_MAP_OSR_ELIGIBILITY: [i64; 256] = [0; 256]
pub var NC_VREG_TO_PREG: [i64; 2048] = [0; 2048]
pub var NC_VREG_SPILL_SLOTS: [i64; 2048] = [0; 2048]

pub struct NativeCompiler {
    pub code: CodeBuffer,
    // Final IR validation failure. This is distinct from an emitter capacity
    // overflow: no ELF may be finalized after an invalid register count.
    pub ir_vreg_overflow: bool,
    pub ir_vreg_overflow_needed: i64,
    pub ir_vreg_overflow_limit: i64,
    // A structurally invalid register reference is not a capacity overflow.
    // Keep the refusal separate so diagnostics never claim that increasing
    // IR_MAX_VREGS would repair malformed IR.
    pub ir_validation_failed: bool,
    pub ir_validation_reg_count: i64,
    pub code_overflow: bool,
    // Total bytes nc_emit_byte was ever asked to emit, counted unconditionally
    // (including bytes dropped once code_overflow latches). Equals code.len
    // while under capacity; keeps counting past it, so on overflow this is the
    // true total code size the module needed -- the number a capacity bump
    // must be sized against, not a guess.
    pub code_overflow_bytes_attempted: i64,
    // Total bytes ever attempted into the flat rodata buffer (NC_BIG_RODATA),
    // counted unconditionally -- including bytes silently dropped once
    // flat_rodata_len saturates at nc_flat_rodata_capacity(). Unlike
    // code_overflow/reloc_overflow, the append sites here (native_v2_rodata_
    // append_updated_tail, native_v2_rodata_append_byte_into) bound-check the
    // write but do NOT set a fail-closed flag or refuse -- they just stop
    // writing, silently truncating string/constant data with no error. This
    // counter is what makes that overflow detectable at all.
    pub rodata_overflow_bytes_attempted: i64,
    // Set when nc_add_flat_reloc is asked to record a relocation past
    // nc_flat_reloc_capacity(). Mirrors code_overflow: the emitter drops the
    // entry, so the ELF would ship unpatched call/rodata sites (jump to garbage
    // -> SIGSEGV). Checked beside code_overflow before the ELF is written.
    pub reloc_overflow: bool,
    // Total relocations nc_add_flat_reloc was ever asked to record, counted
    // unconditionally (including ones dropped once reloc_overflow latches).
    // Same pattern as code_overflow_bytes_attempted above: on overflow this is
    // the true count a capacity bump must be sized against.
    pub reloc_overflow_count_attempted: i64,
    // Set when nc_define_label / nc_add_label_patch is asked to record a label or
    // a jump patch past nc_v2_label_capacity(). Mirrors reloc_overflow: the
    // emitter drops the entry, so the ELF would ship a jz/jmp whose rel32 operand
    // is still the placeholder 0 -- the branch falls through and the program
    // computes the wrong answer at rc=0. Checked beside the other two before the
    // ELF is written; the offending function index is in NC_V2_LABEL_OVERFLOW_FN.
    pub label_overflow: bool,
    pub relocs: RelocationTable,
    // flat_reloc storage moved off-stack to module globals NC_FLAT_RELOC_* (above);
    // only the count remains here (module-wide, indexes the globals).
    pub flat_reloc_count: i64,
    // flat_rodata payload moved off-struct to NC_BIG_RODATA (above);
    // only the length cursor remains here.
    pub flat_rodata_len: i64,
    // Writable .data beyond the legacy 8 KiB StringTable lives in NC_BIG_DATA.
    // The inline table mirrors its prefix for existing small-blob decoders.
    pub flat_data_len: i64,
    // Refuse to write an ELF with a truncated flat .data payload.
    pub data_overflow: bool,
    pub rodata: StringTable,            // String literals for .rodata
    pub data: StringTable,              // Writable .data section (profiling counters)
    pub symbols: SymbolData,            // Function name symbol table for .symtab/.strtab

    // Module-level: function layout.
    // fn_offsets used to be [i64; 16384] inline (128 KiB). By-value copies
    // of that array — including native_compiler_set_fn_offset, which copied
    // the whole array out and back because &! element stores at large
    // offsets miscompile — sat inside the same frame as SymbolData and
    // RelocationTable. That is the compiler_new SIGSEGV. The offsets now
    // live in NC_FN_OFFSETS. fn_count stays here.
    pub fn_count: i64,

    // Per-function: return jump patching

    pub return_jump_count: i64,

    // Per-function: label tracking for branches



    pub label_patch_count: i64,

    // Per-function: frame info
    pub current_frame_size: i64,

    // Entry trampoline offset (recorded during emit_entry_trampoline)
    pub entry_offset: i64,

    // Per-function: float register tracking (vreg index -> 1 if f64, 0 if i64)

    // Per-function: path-sound register float typing computed by a fixpoint over
    // the IR (nc_compute_float_types). Lattice: 0 UNKNOWN, 1 FLOAT, 2 INT, 3
    // CONFLICT. A register is 1 (FLOAT) only if EVERY definition reaching it is
    // float — so the codegen binop override may treat it as float without the
    // path-insensitivity hazard of the linear is_float_reg scan.



    pub field_float_count: i64,

    // Per-function: compile strategy (Sprint 38)
    // 0=standard, 1=aggressive, 2=precision_preserving, 3=instrumented,
    // 4=gpu_kernel, 5=probabilistic
    pub current_strategy: i64,

    // Sprint 46: profiling counter metadata for exit-time dump

    pub prof_counter_count: i64,           // number of profiling counters
    pub prof_dump_fn_index: i64,           // fn_offsets index for __prof_dump function

    // Sprint 47: .sprof file output metadata
    pub prof_sprof_name_offset: i64,       // .rodata offset for "profile.sprof" filename

    // RuntimeContext metadata (.data slot + counter base)
    pub runtime_context_slot_offset: i64,
    pub prof_counter_data_base: i64,
    pub descriptor_data_offset: i64,
    pub descriptor_count: i64,
    pub gc_state_data_offset: i64,
    pub stack_map_data_offset: i64,
    pub deopt_state_data_offset: i64,

    // Native-v2 runtime metadata publication
    pub stack_map_record_count: i64,
    pub safepoint_count: i64,
    pub deopt_point_count: i64,















    // Sprint 52: register allocation — vreg → physical register mapping
    // RA_UNASSIGNED(-2) = not processed, RA_SPILLED(-1) = on stack, >=0 = x86 reg number



    // Native-v2 Machine IR frame metadata
    pub current_machine_base_slots: i64,
    pub current_machine_spill_count: i64,

    // Sprint 108: extern "C" fn relocations
    pub extern_relocs: ExternRelocTable,

    // Target OS for conditional builtin code generation (0=unknown, 1=Linux, 2=macOS, 3=Windows)
    pub target_os_id: i64,

    // BSS segment size (copied from IrModule before ELF write)
    pub bss_total_size: i64,
}


// One class per vreg id, up to the lowerer's ceiling.
// 0 unknown, 1 float, 2 int, 3 conflict.
// NC_VREG_LIMIT must equal IR_MAX_VREGS in ir/ir.sio.
// BSS on purpose: a [i64; 16384] local, or the same array as a field of
// NativeCompiler, is the compiler_new frame cliff. The 2048-slot
// is_float_reg and reg_type fields stay for the readers that already index
// them. OpNeg reads this table, plus the flag the lowerer stamps on a
// float unary op. There is no second ceiling past 2048.
pub let NC_VREG_LIMIT: i64 = 16384
pub var NC_REG_CLASS: [i64; 16384] = [0; 16384]
pub var NC_REG_CLASS_DROPPED: i64 = 0
// Exclusive upper bound of entries touched since the previous reset. Tiny
// functions should not pay an unconditional 16,384-entry clear.
pub var NC_REG_CLASS_HIGH_WATER: i64 = 0
pub var NC_HIGH_SEEN: [i64; 512] = [0; 512]

fn nc_reg_bit_mask(bit: i64) -> i64 {
    var m: i64 = 1
    var k: i64 = 0
    while k < bit {
        m = m * 2
        k = k + 1
    }
    m
}

pub fn nc_reg_class_reset() with Mut {
    var i: i64 = 0
    while i < NC_REG_CLASS_HIGH_WATER {
        NC_REG_CLASS[i as usize] = 0
        i = i + 1
    }
    NC_REG_CLASS_HIGH_WATER = 0
    i = 0
    while i < 512 {
        NC_HIGH_SEEN[i as usize] = 0
        i = i + 1
    }
    NC_REG_CLASS_DROPPED = 0
}

pub fn nc_reg_class_get(reg: i64) -> i64 with Mut, Panic, Div {
    if reg < 0 || reg >= NC_VREG_LIMIT { return 0 }
    NC_REG_CLASS[reg as usize]
}

pub fn nc_reg_class_set(reg: i64, cls: i64) with Mut, Panic, Div {
    if reg < 0 || reg >= NC_VREG_LIMIT {
        NC_REG_CLASS_DROPPED = NC_REG_CLASS_DROPPED + 1
        return
    }
    NC_REG_CLASS[reg as usize] = cls
    if reg + 1 > NC_REG_CLASS_HIGH_WATER {
        NC_REG_CLASS_HIGH_WATER = reg + 1
    }
}

// A float marker whose vreg does not fit the 2048-bit set. Idempotent.
// Record it directly in the full-size class table: keeping a second compact
// list introduced an accidental 4096-entry ceiling below NC_VREG_LIMIT.
pub fn nc_high_float_note(reg: i64) with Mut, Panic, Div {
    if reg < NC_MAX_VREGS || reg >= NC_VREG_LIMIT { return }
    let word = reg / 32
    let bit = reg % 32
    if word < 0 || word >= 512 { return }
    let mask = nc_reg_bit_mask(bit)
    let w = NC_HIGH_SEEN[word as usize]
    if (w / mask) % 2 == 1 { return }
    NC_HIGH_SEEN[word as usize] = w | mask
    nc_reg_class_set(reg, 1)
}

pub fn compiler_new() -> NativeCompiler with Mut {
    var out: NativeCompiler
    out.code = code_buffer_new()
    out.ir_vreg_overflow = false
    out.ir_vreg_overflow_needed = 0
    out.ir_vreg_overflow_limit = NC_VREG_LIMIT
    out.ir_validation_failed = false
    out.ir_validation_reg_count = 0
    out.code_overflow = false
    out.code_overflow_bytes_attempted = 0
    out.rodata_overflow_bytes_attempted = 0
    out.reloc_overflow = false
    out.reloc_overflow_count_attempted = 0
    NC_RELOC_UNKNOWN_KIND_COUNT = 0
    NC_RELOC_UNKNOWN_KIND_FIRST = 0
    out.label_overflow = false
    NC_V2_LABEL_OVERFLOW_FN = -1
    out.relocs = reloc_table_new()
    out.flat_reloc_count = 0
    out.flat_rodata_len = 0
    out.flat_data_len = 0
    out.data_overflow = false
    out.rodata = string_table_new()
    out.data = string_table_new()
    out.symbols = symbol_data_new()
    out.fn_count = 0
    out.return_jump_count = 0
    out.label_patch_count = 0
    out.current_frame_size = 0
    out.entry_offset = 0
    out.current_strategy = 0
    out.prof_counter_count = 0
    out.prof_dump_fn_index = -1
    out.prof_sprof_name_offset = 0
    out.runtime_context_slot_offset = 0
    out.prof_counter_data_base = runtime_context_global_slot_size()
    out.descriptor_data_offset = -1
    out.descriptor_count = 0
    out.gc_state_data_offset = -1
    out.stack_map_data_offset = -1
    out.deopt_state_data_offset = -1
    out.stack_map_record_count = 0
    out.safepoint_count = 0
    out.deopt_point_count = 0
    out.current_machine_base_slots = 0
    out.current_machine_spill_count = 0
    out.extern_relocs = extern_reloc_table_new()
    out.target_os_id = 0
    out.bss_total_size = 0
    out.field_float_count = 0
    // Do not call reset_function_state_mut here: it is Panic+Div and
    // compiler_new's signature is Mut only. Same stores, inlined.
    var i: i64 = 0
    while i < 256 {
        NC_LABEL_OFFSETS[i as usize] = -1
        NC_LABEL_PATCH_CODE_OFFSETS[i as usize] = 0
        NC_LABEL_PATCH_LABEL_IDS[i as usize] = -1
        NC_FIELD_FLOAT_BASE_REGS[i as usize] = -1
        NC_FIELD_FLOAT_INDICES[i as usize] = -1
        if i < 16 {
            NC_RETURN_JUMPS[i as usize] = 0
        }
        i = i + 1
    }
    i = 0
    while i < 16384 {
        NC_FN_OFFSETS[i as usize] = -1
        i = i + 1
    }
    i = 0
    while i < NC_MAX_VREGS {
        NC_VREG_TO_PREG[i as usize] = -2
        NC_VREG_SPILL_SLOTS[i as usize] = -1
        NC_IS_FLOAT_REG[i as usize] = 0
        NC_REG_TYPE[i as usize] = 0
        i = i + 1
    }
    nc_reg_class_reset()
    out
}

// THE relocation refusal point. Every function that writes an image patched by
// apply_relocations_into (codegen_x86_linux.sio) calls this immediately before
// its first write and returns the rc it gives when that rc is nonzero:
//   20  a relocation of unknown kind was met (NC_RELOC_UNKNOWN_KIND_COUNT > 0,
//       its site is still the rel32 placeholder), or
//   20  the flat relocation table overflowed (reloc_overflow, entries dropped).
//   0   nothing to refuse.
// It used to be three copies (the preview route, the common v2 writer and the
// legacy NATIVE_ELF_BUF writer) with a fixed list of writers pinned by the gate,
// and the sret witness route reached a write without passing any of them (fixed
// in #2803 by a fourth copy). scripts/ci/native_reloc_unknown_kind_gate.sh now
// derives the routes from the callers of apply_relocations_into and fails if
// any of them reaches a write without passing through here.
pub fn native_reloc_refuse_if_invalid(nc: &NativeCompiler) -> i32 with IO {
    if NC_RELOC_UNKNOWN_KIND_COUNT > 0 {
        print("Error: native relocation of unknown kind ")
        print_int(NC_RELOC_UNKNOWN_KIND_FIRST)
        print(" at ")
        print_int(NC_RELOC_UNKNOWN_KIND_COUNT)
        print(" site(s) -- refusing to emit an ELF with unpatched sites\n")
        return 20
    }
    if (*nc).reloc_overflow {
        print("Error: native relocation table overflow -- relocs_needed=")
        print_int((*nc).reloc_overflow_count_attempted)
        print(" capacity=")
        print_int(nc_flat_reloc_capacity())
        print(" (raise nc_flat_reloc_capacity)\n")
        return 20
    }
    0
}

pub fn codegen_new() -> NativeCompiler with Mut {
    compiler_new()
}

pub fn reset_function_state_mut(nc: &! NativeCompiler) with Mut, Panic, Div {
    (*nc).return_jump_count = 0
    var i = 0
    while i < 256 {
        NC_LABEL_OFFSETS[i as usize] = -1
        NC_LABEL_PATCH_CODE_OFFSETS[i as usize] = 0
        NC_LABEL_PATCH_LABEL_IDS[i as usize] = -1
        if i < 16 {
            NC_RETURN_JUMPS[i as usize] = 0
        }
        i = i + 1
    }
    (*nc).label_patch_count = 0
    (*nc).current_frame_size = 0
    var j = 0
    while j < NC_MAX_VREGS {
        NC_IS_FLOAT_REG[j as usize] = 0
        NC_REG_TYPE[j as usize] = 0
        j = j + 1
    }
    nc_reg_class_reset()
    (*nc).field_float_count = 0
    var fj = 0
    while fj < 256 {
        NC_FIELD_FLOAT_BASE_REGS[fj as usize] = -1
        NC_FIELD_FLOAT_INDICES[fj as usize] = -1
        fj = fj + 1
    }
    (*nc).current_strategy = 0
    var ra = 0
    while ra < NC_MAX_VREGS {
        NC_VREG_TO_PREG[ra as usize] = -2
        NC_VREG_SPILL_SLOTS[ra as usize] = -1
        ra = ra + 1
    }
    (*nc).current_machine_base_slots = 0
    (*nc).current_machine_spill_count = 0
}

// Reset per-function state before compiling a new function
pub fn reset_function_state(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    reset_function_state_mut(&! c)
    c
}

pub fn emit_load_runtime_context_ptr_rbx(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    let disp_pos = c.code.len + 3
    c.code = emit_mov_rbx_rip_disp32(c.code, 0)
    c.relocs = add_data_section_reloc(c.relocs, disp_pos, c.runtime_context_slot_offset)
    c
}

pub fn emit_load_runtime_context_field_rax(nc: NativeCompiler, field_offset: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = emit_load_runtime_context_ptr_rbx(nc)
    c.code = emit_load_rax_mem_rbx_disp32(c.code, field_offset)
    c
}

pub fn emit_store_rax_runtime_context_field(nc: NativeCompiler, field_offset: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = emit_load_runtime_context_ptr_rbx(nc)
    c.code = emit_store_rax_mem_rbx_disp32(c.code, field_offset)
    c
}

// ============================================================================
// Stack slot mapping: IR virtual register -> rbp-relative offset
// ============================================================================

// IR virtual register N lives at rbp - (N+1)*8
pub fn ir_slot_offset(vreg: i64) -> i64 {
    -(vreg + 1) * 8
}

// ============================================================================
// Return jump patching
// ============================================================================

pub fn record_return_jump(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    record_return_jump_mut(&! c)
    c
}

pub fn record_return_jump_mut(nc: &! NativeCompiler) with Mut, Panic, Div {
    let jmp_pos = (*nc).code.len
    (*nc).code = emit_jmp_rel32((*nc).code)
    if (*nc).return_jump_count < 16 {
        NC_RETURN_JUMPS[(*nc).return_jump_count as usize] = jmp_pos + 1
        (*nc).return_jump_count = (*nc).return_jump_count + 1
    }
}

pub fn patch_return_jumps(nc: NativeCompiler, epilogue_offset: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    patch_return_jumps_mut(&! c, epilogue_offset)
    c
}

pub fn patch_return_jumps_mut(nc: &! NativeCompiler, epilogue_offset: i64) with Mut, Panic, Div {
    var i = 0
    while i < (*nc).return_jump_count && i < 16 {
        let imm_offset = NC_RETURN_JUMPS[i as usize]
        if imm_offset > 0 && imm_offset + 4 <= (*nc).code.len
            && NC_BIG_CODE[(imm_offset - 1) as usize] == (0xe9 as i8) {
            let next_ip = imm_offset + 4
            let rel = epilogue_offset - next_ip
            NC_BIG_CODE[imm_offset as usize] = low8(rel) as i8
            NC_BIG_CODE[(imm_offset + 1) as usize] = low8(rel >> 8) as i8
            NC_BIG_CODE[(imm_offset + 2) as usize] = low8(rel >> 16) as i8
            NC_BIG_CODE[(imm_offset + 3) as usize] = low8(rel >> 24) as i8
        }
        i = i + 1
    }
}

pub fn record_label(nc: NativeCompiler, label_id: i64) -> NativeCompiler with Mut, Panic {
    var c = nc
    record_label_mut(&! c, label_id)
    c
}

pub fn record_label_mut(nc: &! NativeCompiler, label_id: i64) with Mut, Panic {
    if label_id >= 0 && label_id < 256 {
        NC_LABEL_OFFSETS[label_id as usize] = (*nc).code.len
    }
}

pub fn record_label_patch(nc: NativeCompiler, label_id: i64, rel32_offset: i64) -> NativeCompiler with Mut, Panic {
    var c = nc
    record_label_patch_mut(&! c, label_id, rel32_offset)
    c
}

pub fn record_label_patch_mut(nc: &! NativeCompiler, label_id: i64, rel32_offset: i64) with Mut, Panic {
    let idx = (*nc).label_patch_count
    if idx < 256 {
        NC_LABEL_PATCH_CODE_OFFSETS[idx as usize] = rel32_offset
        NC_LABEL_PATCH_LABEL_IDS[idx as usize] = label_id
        (*nc).label_patch_count = idx + 1
    }
}

fn label_patch_is_rel32_branch(nc: &NativeCompiler, patch_off: i64) -> bool with Panic, Div {
    if patch_off > 0 && patch_off + 4 <= (*nc).code.len
        && NC_BIG_CODE[(patch_off - 1) as usize] == (0xe9 as i8) {
        return true
    }
    if patch_off >= 2 && patch_off + 4 <= (*nc).code.len
        && NC_BIG_CODE[(patch_off - 2) as usize] == (0x0f as i8) {
        let op = NC_BIG_CODE[(patch_off - 1) as usize]
        return op == (0x84 as i8) || op == (0x85 as i8)
    }
    false
}

// patch_label_forwards_mut: reads label patch info from the NC_V2_LABEL_* globals
// (written by nc_add_label_patch / nc_define_label in codegen_x86_linux.sio).
// Direct array element writes through &! NativeCompiler fail for large struct offsets,
// so label state lives in globals instead.
pub fn patch_label_forwards_mut(nc: &! NativeCompiler) with Mut, Panic, Div {
    var i = 0
    while i < NC_V2_LABEL_PATCH_COUNT && i < nc_v2_label_capacity() {
        let patch_off = NC_V2_LABEL_PATCH_OFFSETS[i as usize]
        let patch_lid = NC_V2_LABEL_PATCH_IDS[i as usize]
        // patch_lid MUST be bounded before it indexes NC_V2_LABEL_OFFSETS.
        // It used to be read unchecked: nc_add_label_patch bounds the patch INDEX
        // but never the label id, so an out-of-range id read past the end of a
        // [i64; N] into whatever global follows it -- NC_V2_LABEL_PATCH_OFFSETS,
        // i.e. code offsets, always >= 0, so the `target >= 0` guard below let it
        // through and it patched a plausible-looking WRONG branch target. An OOB
        // read must not depend on some other bound being correct, so this is
        // checked here independently of the capacity check at the recording sites.
        var target: i64 = -1
        if patch_lid >= 0 && patch_lid < nc_v2_label_capacity() {
            target = NC_V2_LABEL_OFFSETS[patch_lid as usize]
        }
        if target >= 0 && patch_off >= 0 && label_patch_is_rel32_branch(nc, patch_off) {
            let rel = target - (patch_off + 4)
            NC_BIG_CODE[patch_off as usize] = low8(rel) as i8
            NC_BIG_CODE[(patch_off + 1) as usize] = low8(rel >> 8) as i8
            NC_BIG_CODE[(patch_off + 2) as usize] = low8(rel >> 16) as i8
            NC_BIG_CODE[(patch_off + 3) as usize] = low8(rel >> 24) as i8
        }
        i = i + 1
    }
}

pub fn patch_label_forwards(nc: NativeCompiler) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    patch_label_forwards_mut(&! c)
    c
}
