// Test: Build IR and return Elf64Binary for native execution testing
//
// This is used by the Rust test harness to execute self-hosted ELF binaries.
// The Rust test extracts the bytes, writes them to disk, and executes them.

use native::encode::*
use native::frame::*
use native::elf::*
use native::reloc::*
use native::codegen::*
use io::file_write::*
use lexer::mod::*
use ir::ir::*
use parser::ast::*

fn build_return_42_binary() -> Elf64Binary with Mut, Panic, Div, Alloc {
    // Build IR: fn main() -> i64 { r0 = 42; return r0 }
    var module = ir_empty_module()

    var func = ir_empty_function()
    func.name = make_name("main")
    func.param_count = 0
    func.reg_count = 1  // r0
    func.instr_count = 2

    // r0 = 42
    var i0 = ir_empty_instr()
    i0.op = IrOpcode::IrLoadImm
    i0.dst = 0
    i0.imm_i64 = 42
    ir_arena_store(ir_region_slot_w(func.region, (0)), i0)

    // return r0
    var i1 = ir_empty_instr()
    i1.op = IrOpcode::IrReturn
    i1.src1 = 0
    ir_arena_store(ir_region_slot_w(func.region, (1)), i1)

    ir_fn_set(&! module, 0, func)
    module.fn_count = 1

    compile_to_elf(&module, 4194304)  // 0x400000
}

fn build_arithmetic_binary() -> Elf64Binary with Mut, Panic, Div, Alloc {
    // Build IR: fn main() -> i64 { r0 = 21; r1 = 21; r2 = r0 + r1; return r2 }
    var module = ir_empty_module()

    var func = ir_empty_function()
    func.name = make_name("main")
    func.param_count = 0
    func.reg_count = 3
    func.instr_count = 4

    // r0 = 21
    var i0 = ir_empty_instr()
    i0.op = IrOpcode::IrLoadImm
    i0.dst = 0
    i0.imm_i64 = 21
    ir_arena_store(ir_region_slot_w(func.region, (0)), i0)

    // r1 = 21
    var i1 = ir_empty_instr()
    i1.op = IrOpcode::IrLoadImm
    i1.dst = 1
    i1.imm_i64 = 21
    ir_arena_store(ir_region_slot_w(func.region, (1)), i1)

    // r2 = r0 + r1
    var i2 = ir_empty_instr()
    i2.op = IrOpcode::IrBinOp
    i2.dst = 2
    i2.src1 = 0
    i2.src2 = 1
    i2.bin_op = BinaryOp::OpAdd
    ir_arena_store(ir_region_slot_w(func.region, (2)), i2)

    // return r2
    var i3 = ir_empty_instr()
    i3.op = IrOpcode::IrReturn
    i3.src1 = 2
    ir_arena_store(ir_region_slot_w(func.region, (3)), i3)

    ir_fn_set(&! module, 0, func)
    module.fn_count = 1

    compile_to_elf(&module, 4194304)
}

fn build_struct_field_binary() -> Elf64Binary with Mut, Panic, Div, Alloc {
    // Build IR: alloc r0; r1=17; field_set r0[5]=r1; field_get r2=r0[5]; return r2
    // Expected exit code: 17
    var module = ir_empty_module()

    var func = ir_empty_function()
    func.name = make_name("main")
    func.param_count = 0
    func.reg_count = 3  // r0=struct, r1=value, r2=result
    func.instr_count = 5

    // r0 = alloc (struct, type_id=0)
    var i0 = ir_empty_instr()
    i0.op = IrOpcode::IrAlloc
    i0.dst = 0
    i0.imm_i64 = 0
    ir_arena_store(ir_region_slot_w(func.region, (0)), i0)

    // r1 = 17
    var i1 = ir_empty_instr()
    i1.op = IrOpcode::IrLoadImm
    i1.dst = 1
    i1.imm_i64 = 17
    ir_arena_store(ir_region_slot_w(func.region, (1)), i1)

    // field_set r0[5] = r1
    var i2 = ir_empty_instr()
    i2.op = IrOpcode::IrFieldSet
    i2.src1 = 0       // base = r0
    i2.src2 = 1       // value = r1
    i2.field_idx = 5   // field index 5
    ir_arena_store(ir_region_slot_w(func.region, (2)), i2)

    // r2 = field_get r0[5]
    var i3 = ir_empty_instr()
    i3.op = IrOpcode::IrFieldGet
    i3.dst = 2         // result = r2
    i3.src1 = 0        // base = r0
    i3.field_idx = 5   // field index 5
    ir_arena_store(ir_region_slot_w(func.region, (3)), i3)

    // return r2
    var i4 = ir_empty_instr()
    i4.op = IrOpcode::IrReturn
    i4.src1 = 2
    ir_arena_store(ir_region_slot_w(func.region, (4)), i4)

    ir_fn_set(&! module, 0, func)
    module.fn_count = 1

    compile_to_elf(&module, 4194304)
}

fn build_array_index_binary() -> Elf64Binary with Mut, Panic, Div, Alloc {
    // Build IR: alloc r0; r1=0; r2=10; index_set r0[r1]=r2;
    //           r3=1; r4=20; index_set r0[r3]=r4;
    //           r5=index_get r0[r1]; r6=index_get r0[r3];
    //           r7=r5+r6; return r7
    // Expected exit code: 30
    var module = ir_empty_module()

    var func = ir_empty_function()
    func.name = make_name("main")
    func.param_count = 0
    func.reg_count = 8  // r0..r7
    func.instr_count = 11

    // r0 = alloc (array, type_id=1)
    var i0 = ir_empty_instr()
    i0.op = IrOpcode::IrAlloc
    i0.dst = 0
    i0.imm_i64 = 1
    ir_arena_store(ir_region_slot_w(func.region, (0)), i0)

    // r1 = 0 (index 0)
    var i1 = ir_empty_instr()
    i1.op = IrOpcode::IrLoadImm
    i1.dst = 1
    i1.imm_i64 = 0
    ir_arena_store(ir_region_slot_w(func.region, (1)), i1)

    // r2 = 10 (value)
    var i2 = ir_empty_instr()
    i2.op = IrOpcode::IrLoadImm
    i2.dst = 2
    i2.imm_i64 = 10
    ir_arena_store(ir_region_slot_w(func.region, (2)), i2)

    // index_set r0[r1] = r2
    var i3 = ir_empty_instr()
    i3.op = IrOpcode::IrIndexSet
    i3.src1 = 0       // base = r0
    i3.src2 = 1       // idx = r1
    i3.imm_i64 = 2    // value reg = r2
    ir_arena_store(ir_region_slot_w(func.region, (3)), i3)

    // r3 = 1 (index 1)
    var i4 = ir_empty_instr()
    i4.op = IrOpcode::IrLoadImm
    i4.dst = 3
    i4.imm_i64 = 1
    ir_arena_store(ir_region_slot_w(func.region, (4)), i4)

    // r4 = 20 (value)
    var i5 = ir_empty_instr()
    i5.op = IrOpcode::IrLoadImm
    i5.dst = 4
    i5.imm_i64 = 20
    ir_arena_store(ir_region_slot_w(func.region, (5)), i5)

    // index_set r0[r3] = r4
    var i6 = ir_empty_instr()
    i6.op = IrOpcode::IrIndexSet
    i6.src1 = 0       // base = r0
    i6.src2 = 3       // idx = r3
    i6.imm_i64 = 4    // value reg = r4
    ir_arena_store(ir_region_slot_w(func.region, (6)), i6)

    // r5 = index_get r0[r1]
    var i7 = ir_empty_instr()
    i7.op = IrOpcode::IrIndexGet
    i7.dst = 5
    i7.src1 = 0       // base = r0
    i7.src2 = 1       // idx = r1
    ir_arena_store(ir_region_slot_w(func.region, (7)), i7)

    // r6 = index_get r0[r3]
    var i8 = ir_empty_instr()
    i8.op = IrOpcode::IrIndexGet
    i8.dst = 6
    i8.src1 = 0       // base = r0
    i8.src2 = 3       // idx = r3
    ir_arena_store(ir_region_slot_w(func.region, (8)), i8)

    // r7 = r5 + r6
    var i9 = ir_empty_instr()
    i9.op = IrOpcode::IrBinOp
    i9.dst = 7
    i9.src1 = 5
    i9.src2 = 6
    i9.bin_op = BinaryOp::OpAdd
    ir_arena_store(ir_region_slot_w(func.region, (9)), i9)

    // return r7
    var i10 = ir_empty_instr()
    i10.op = IrOpcode::IrReturn
    i10.src1 = 7
    ir_arena_store(ir_region_slot_w(func.region, (10)), i10)

    ir_fn_set(&! module, 0, func)
    module.fn_count = 1

    compile_to_elf(&module, 4194304)
}

// Main: build all ELF binaries and write to /tmp for E2E verification
fn test_native_execution_main() -> i64 with IO, Mut, Panic, Div, Alloc {
    // Build and write return-42 binary
    let elf42 = build_return_42_binary()
    let ok1 = io_write_elf_to_file("/tmp/sounio_test_42.elf", elf42)
    if !ok1 {
        print("FAIL: write return-42 binary\n")
        return 1
    }
    print("OK: /tmp/sounio_test_42.elf (exit 42)\n")

    // Build and write struct field test binary
    let elf_struct = build_struct_field_binary()
    let ok2 = io_write_elf_to_file("/tmp/sounio_test_struct.elf", elf_struct)
    if !ok2 {
        print("FAIL: write struct binary\n")
        return 1
    }
    print("OK: /tmp/sounio_test_struct.elf (exit 17)\n")

    // Build and write array index test binary
    let elf_array = build_array_index_binary()
    let ok3 = io_write_elf_to_file("/tmp/sounio_test_array.elf", elf_array)
    if !ok3 {
        print("FAIL: write array binary\n")
        return 1
    }
    print("OK: /tmp/sounio_test_array.elf (exit 30)\n")

    print("All native ELF binaries written successfully\n")
    0
}
