// Test: Build IR and return Elf64Binary for native execution testing
//
// This is used by the Rust test harness to execute self-hosted ELF binaries.
// The Rust test extracts the bytes, writes them to disk, and executes them.

fn build_return_42_binary() -> Elf64Binary with Mut, Panic, Div {
    // Build IR: fn main() -> i64 { r0 = 42; return r0 }
    var module = ir_empty_module()

    var func = ir_empty_function()
    func.name = make_name("main")
    func.param_count = 0
    func.max_reg = 1  // r0
    func.instr_count = 2

    // r0 = 42
    var i0 = ir_empty_instr()
    i0.op = IrOpcode::IrLoadImm
    i0.dst = 0
    i0.imm_i64 = 42
    func.instrs[0] = i0

    // return r0
    var i1 = ir_empty_instr()
    i1.op = IrOpcode::IrReturn
    i1.src1 = 0
    func.instrs[1] = i1

    module.functions[0] = func
    module.fn_count = 1

    compile_to_elf(module, 4194304)  // 0x400000
}

fn build_arithmetic_binary() -> Elf64Binary with Mut, Panic, Div {
    // Build IR: fn main() -> i64 { r0 = 21; r1 = 21; r2 = r0 + r1; return r2 }
    var module = ir_empty_module()

    var func = ir_empty_function()
    func.name = make_name("main")
    func.param_count = 0
    func.max_reg = 3
    func.instr_count = 4

    // r0 = 21
    var i0 = ir_empty_instr()
    i0.op = IrOpcode::IrLoadImm
    i0.dst = 0
    i0.imm_i64 = 21
    func.instrs[0] = i0

    // r1 = 21
    var i1 = ir_empty_instr()
    i1.op = IrOpcode::IrLoadImm
    i1.dst = 1
    i1.imm_i64 = 21
    func.instrs[1] = i1

    // r2 = r0 + r1
    var i2 = ir_empty_instr()
    i2.op = IrOpcode::IrBinOp
    i2.dst = 2
    i2.src1 = 0
    i2.src2 = 1
    i2.bin_op = IrBinOp::IrAdd
    func.instrs[2] = i2

    // return r2
    var i3 = ir_empty_instr()
    i3.op = IrOpcode::IrReturn
    i3.src1 = 2
    func.instrs[3] = i3

    module.functions[0] = func
    module.fn_count = 1

    compile_to_elf(module, 4194304)
}

// Main: return the simple return-42 binary
// The Rust test harness will execute it and verify the exit code
fn main() -> Elf64Binary with Mut, Panic, Div {
    build_return_42_binary()
}
