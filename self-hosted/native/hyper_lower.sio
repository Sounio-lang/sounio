// self-hosted/native/hyper_lower.sio
// Native x86-64 lowering for Hyper<Algebra, T> operations
//
// Strategy:
//   - Cayley-Dickson tower (R, C, H, O, S): scalar/packed f64 in stack slots
//   - Clifford(p,q): 2^(p+q) component multivectors in stack slots
//   - AVX-512 path for Cl(1,3): future (requires EVEX prefix emit support)
//   - Current: scalar loop over components via GPR stack-slot model
//
// This module extends lower_ir.sio with Hyper-aware instruction lowering.
// Pattern follows: lower_ir.sio dispatch + encode.sio emit helpers
//
// STATUS: Compilable Sounio. Origin: Grok 4.2 spec, manually translated.
//   Uses NativeCompiler from codegen.sio
//   Uses emit_* helpers from encode.sio
//   Register conventions: rax = primary, rbx = secondary, rcx = temp

// ============================================================
// Algebra dimension lookup (must match ir/algebra.sio)
// ============================================================

let ALG_REAL: i64 = 0
let ALG_COMPLEX: i64 = 1
let ALG_QUATERNION: i64 = 2
let ALG_OCTONION: i64 = 3
let ALG_SEDENION: i64 = 4
let ALG_CLIFFORD: i64 = 5

fn hyper_dimension(alg: i64, cl_p: i64, cl_q: i64) -> i64 {
    if alg == 0 { return 1 }
    if alg == 1 { return 2 }
    if alg == 2 { return 4 }
    if alg == 3 { return 8 }
    if alg == 4 { return 16 }
    if alg == 5 {
        var result = 1
        var i = 0
        while i < cl_p + cl_q {
            result = result * 2
            i = i + 1
        }
        return result
    }
    return 0
}

// ============================================================
// Stack slot layout for Hyper values
// ============================================================
//
// Each Hyper value occupies dim * 8 bytes on the stack (f64 per component).
// Layout: [component_0][component_1]...[component_{dim-1}]
//
// For Cl(1,3): 16 components * 8 bytes = 128 bytes per multivector.
// Basis ordering by bitset: {}, {e0}, {e1}, {e0e1}, {e2}, ...
//
// Stack allocation: rbp - base_offset

fn hyper_slot_size(alg: i64, cl_p: i64, cl_q: i64) -> i64 {
    hyper_dimension(alg, cl_p, cl_q) * 8
}

// Compute stack displacement for component i of a Hyper value at vreg slot
fn hyper_component_disp(vreg: i64, component: i64, dim: i64) -> i64 {
    // Negative displacement from rbp: -(vreg+1)*dim*8 - component*8
    let base = (vreg + 1) * dim * 8
    0 - base - component * 8
}

// ============================================================
// Component-wise binary operations (scalar fallback)
// ============================================================

fn lower_hyper_add(nc: NativeCompiler, dst_vreg: i64, left_vreg: i64, right_vreg: i64, dim: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    var i: i64 = 0
    while i < dim {
        let left_disp = hyper_component_disp(left_vreg, i, dim)
        let right_disp = hyper_component_disp(right_vreg, i, dim)
        let dst_disp = hyper_component_disp(dst_vreg, i, dim)
        // rax = left[i]
        c.code = emit_load_rbp_disp32_rax(c.code, left_disp)
        // rbx = right[i]
        c.code = emit_load_rbp_disp32_rbx(c.code, right_disp)
        // rax = rax + rbx
        c.code = emit_add_reg_reg(c.code, 0, 3)  // rax=0, rbx=3
        // dst[i] = rax
        c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)
        i = i + 1
    }
    c
}

fn lower_hyper_sub(nc: NativeCompiler, dst_vreg: i64, left_vreg: i64, right_vreg: i64, dim: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    var i: i64 = 0
    while i < dim {
        let left_disp = hyper_component_disp(left_vreg, i, dim)
        let right_disp = hyper_component_disp(right_vreg, i, dim)
        let dst_disp = hyper_component_disp(dst_vreg, i, dim)
        c.code = emit_load_rbp_disp32_rax(c.code, left_disp)
        c.code = emit_load_rbp_disp32_rbx(c.code, right_disp)
        c.code = emit_sub_reg_reg(c.code, 0, 3)
        c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)
        i = i + 1
    }
    c
}

// ============================================================
// Geometric product sign computation
// ============================================================
//
// For Clifford(p,q), the geometric product of basis blades A and B:
//   1. Count swaps to sort combined index sequence
//   2. For shared basis vectors, multiply by metric (e_i^2 = +1 if i<p, -1 if i>=p)
//   3. sign = (-1)^swaps * product_of_metrics

fn geo_product_sign(a: i64, b: i64, p: i64, q: i64) -> i64 {
    let n = p + q
    var sign = 1

    // Count swap parity: for each bit in b, count bits in a above it
    var j: i64 = 0
    while j < n {
        if (b >> j) & 1 == 1 {
            var k = j + 1
            while k < n {
                if (a >> k) & 1 == 1 {
                    sign = 0 - sign
                }
                k = k + 1
            }
        }
        j = j + 1
    }

    // Metric signs for shared basis vectors
    let shared = a & b
    var m: i64 = 0
    while m < n {
        if (shared >> m) & 1 == 1 {
            if m >= p {
                sign = 0 - sign
            }
        }
        m = m + 1
    }

    sign
}

fn geo_product_blade(a: i64, b: i64) -> i64 {
    a ^ b
}

// ============================================================
// Clifford geometric product (full expansion, O(dim^2))
// ============================================================

fn lower_hyper_geo_product(nc: NativeCompiler, dst_vreg: i64, left_vreg: i64, right_vreg: i64, dim: i64, cl_p: i64, cl_q: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc

    // Zero destination
    var z: i64 = 0
    while z < dim {
        let dst_disp = hyper_component_disp(dst_vreg, z, dim)
        c.code = emit_mov_rax_imm(c.code, 0)
        c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)
        z = z + 1
    }

    // Double loop: for each pair (i, j) of basis blades
    var i: i64 = 0
    while i < dim {
        var j: i64 = 0
        while j < dim {
            let k = geo_product_blade(i, j)
            let sign = geo_product_sign(i, j, cl_p, cl_q)

            if sign != 0 {
                let left_disp = hyper_component_disp(left_vreg, i, dim)
                let right_disp = hyper_component_disp(right_vreg, j, dim)
                let dst_disp = hyper_component_disp(dst_vreg, k, dim)

                // rax = left[i]
                c.code = emit_load_rbp_disp32_rax(c.code, left_disp)
                // rbx = right[j]
                c.code = emit_load_rbp_disp32_rbx(c.code, right_disp)
                // rax = rax * rbx (imul for bootstrap i64 path)
                c.code = emit_imul_reg_reg(c.code, 0, 3)
                // Apply sign
                if sign < 0 {
                    c.code = emit_neg_rax(c.code)
                }
                // Accumulate: rbx = dst[k], rax = rax + rbx, store
                c.code = emit_load_rbp_disp32_rbx(c.code, dst_disp)
                c.code = emit_add_reg_reg(c.code, 0, 3)
                c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)
            }
            j = j + 1
        }
        i = i + 1
    }
    c
}

// ============================================================
// Hamilton product (Quaternion, dim=4)
// ============================================================
//
//   result[0] = a0*b0 - a1*b1 - a2*b2 - a3*b3
//   result[1] = a0*b1 + a1*b0 + a2*b3 - a3*b2
//   result[2] = a0*b2 - a1*b3 + a2*b0 + a3*b1
//   result[3] = a0*b3 + a1*b2 - a2*b1 + a3*b0

fn lower_quaternion_product(nc: NativeCompiler, dst_vreg: i64, left_vreg: i64, right_vreg: i64) -> NativeCompiler with Mut, Panic, Div {
    let dim: i64 = 4
    var c = nc

    // result[0] = a0*b0 - a1*b1 - a2*b2 - a3*b3
    c = lower_quat_component(c, dst_vreg, left_vreg, right_vreg, dim, 0,
        0, 0, 1, 1, 1, -1, 2, 2, -1, 3, 3, -1)
    // result[1] = a0*b1 + a1*b0 + a2*b3 - a3*b2
    c = lower_quat_component(c, dst_vreg, left_vreg, right_vreg, dim, 1,
        0, 1, 1, 1, 0, 1, 2, 3, 1, 3, 2, -1)
    // result[2] = a0*b2 - a1*b3 + a2*b0 + a3*b1
    c = lower_quat_component(c, dst_vreg, left_vreg, right_vreg, dim, 2,
        0, 2, 1, 1, 3, -1, 2, 0, 1, 3, 1, 1)
    // result[3] = a0*b3 + a1*b2 - a2*b1 + a3*b0
    c = lower_quat_component(c, dst_vreg, left_vreg, right_vreg, dim, 3,
        0, 3, 1, 1, 2, 1, 2, 1, -1, 3, 0, 1)
    c
}

// Compute one quaternion product component (4 terms)
fn lower_quat_component(nc: NativeCompiler, dst_vreg: i64, left_vreg: i64, right_vreg: i64, dim: i64, out_idx: i64, li0: i64, ri0: i64, s0: i64, li1: i64, ri1: i64, s1: i64, li2: i64, ri2: i64, s2: i64, li3: i64, ri3: i64, s3: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    let dst_disp = hyper_component_disp(dst_vreg, out_idx, dim)

    // Term 0: s0 * left[li0] * right[ri0]
    c.code = emit_load_rbp_disp32_rax(c.code, hyper_component_disp(left_vreg, li0, dim))
    c.code = emit_load_rbp_disp32_rbx(c.code, hyper_component_disp(right_vreg, ri0, dim))
    c.code = emit_imul_reg_reg(c.code, 0, 3)
    if s0 < 0 { c.code = emit_neg_rax(c.code) }
    c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)

    // Term 1: accumulate s1 * left[li1] * right[ri1]
    c.code = emit_load_rbp_disp32_rax(c.code, hyper_component_disp(left_vreg, li1, dim))
    c.code = emit_load_rbp_disp32_rbx(c.code, hyper_component_disp(right_vreg, ri1, dim))
    c.code = emit_imul_reg_reg(c.code, 0, 3)
    if s1 < 0 { c.code = emit_neg_rax(c.code) }
    c.code = emit_load_rbp_disp32_rbx(c.code, dst_disp)
    c.code = emit_add_reg_reg(c.code, 0, 3)
    c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)

    // Term 2
    c.code = emit_load_rbp_disp32_rax(c.code, hyper_component_disp(left_vreg, li2, dim))
    c.code = emit_load_rbp_disp32_rbx(c.code, hyper_component_disp(right_vreg, ri2, dim))
    c.code = emit_imul_reg_reg(c.code, 0, 3)
    if s2 < 0 { c.code = emit_neg_rax(c.code) }
    c.code = emit_load_rbp_disp32_rbx(c.code, dst_disp)
    c.code = emit_add_reg_reg(c.code, 0, 3)
    c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)

    // Term 3
    c.code = emit_load_rbp_disp32_rax(c.code, hyper_component_disp(left_vreg, li3, dim))
    c.code = emit_load_rbp_disp32_rbx(c.code, hyper_component_disp(right_vreg, ri3, dim))
    c.code = emit_imul_reg_reg(c.code, 0, 3)
    if s3 < 0 { c.code = emit_neg_rax(c.code) }
    c.code = emit_load_rbp_disp32_rbx(c.code, dst_disp)
    c.code = emit_add_reg_reg(c.code, 0, 3)
    c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)

    c
}

// ============================================================
// Component-wise multiplication (Real, Complex scalar path)
// ============================================================

fn lower_hyper_component_mul(nc: NativeCompiler, dst_vreg: i64, left_vreg: i64, right_vreg: i64, dim: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    var i: i64 = 0
    while i < dim {
        let left_disp = hyper_component_disp(left_vreg, i, dim)
        let right_disp = hyper_component_disp(right_vreg, i, dim)
        let dst_disp = hyper_component_disp(dst_vreg, i, dim)
        c.code = emit_load_rbp_disp32_rax(c.code, left_disp)
        c.code = emit_load_rbp_disp32_rbx(c.code, right_disp)
        c.code = emit_imul_reg_reg(c.code, 0, 3)
        c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)
        i = i + 1
    }
    c
}

// ============================================================
// Conjugation
// ============================================================
//
// Cayley-Dickson: keep real part (component 0), negate imaginary parts
// Clifford reversion: sign = (-1)^(grade*(grade-1)/2)

fn lower_hyper_conjugate(nc: NativeCompiler, dst_vreg: i64, src_vreg: i64, alg: i64, cl_p: i64, cl_q: i64) -> NativeCompiler with Mut, Panic, Div {
    let dim = hyper_dimension(alg, cl_p, cl_q)
    var c = nc

    if alg <= 4 {
        // Cayley-Dickson: keep component 0, negate rest
        let src_disp_0 = hyper_component_disp(src_vreg, 0, dim)
        let dst_disp_0 = hyper_component_disp(dst_vreg, 0, dim)
        c.code = emit_load_rbp_disp32_rax(c.code, src_disp_0)
        c.code = emit_store_rax_rbp_disp32(c.code, dst_disp_0)
        var i: i64 = 1
        while i < dim {
            let src_disp = hyper_component_disp(src_vreg, i, dim)
            let dst_disp = hyper_component_disp(dst_vreg, i, dim)
            c.code = emit_load_rbp_disp32_rax(c.code, src_disp)
            c.code = emit_neg_rax(c.code)
            c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)
            i = i + 1
        }
    } else {
        // Clifford reversion
        var k: i64 = 0
        while k < dim {
            let grade = popcount_i64(k)
            let sign_exp = (grade * (grade - 1)) / 2
            let src_disp = hyper_component_disp(src_vreg, k, dim)
            let dst_disp = hyper_component_disp(dst_vreg, k, dim)
            c.code = emit_load_rbp_disp32_rax(c.code, src_disp)
            if sign_exp & 1 == 1 {
                c.code = emit_neg_rax(c.code)
            }
            c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)
            k = k + 1
        }
    }
    c
}

fn popcount_i64(val: i64) -> i64 {
    var x = val
    var count: i64 = 0
    while x != 0 {
        count = count + (x & 1)
        x = x >> 1
    }
    count
}

// ============================================================
// Norm squared: sum of component^2
// ============================================================

fn lower_hyper_norm_sq(nc: NativeCompiler, dst_vreg: i64, src_vreg: i64, dim: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    let dst_disp = hyper_component_disp(dst_vreg, 0, 1)  // scalar result

    // Initialize accumulator to 0
    c.code = emit_mov_rax_imm(c.code, 0)
    c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)

    var i: i64 = 0
    while i < dim {
        let src_disp = hyper_component_disp(src_vreg, i, dim)
        c.code = emit_load_rbp_disp32_rax(c.code, src_disp)
        // rax = rax * rax (square)
        c.code = emit_imul_reg_reg(c.code, 0, 0)
        // accumulate
        c.code = emit_load_rbp_disp32_rbx(c.code, dst_disp)
        c.code = emit_add_reg_reg(c.code, 0, 3)
        c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)
        i = i + 1
    }
    c
}

// ============================================================
// Grade extraction (Clifford only)
// ============================================================
//
// Extract components of grade g, zero all others

fn lower_hyper_grade_extract(nc: NativeCompiler, dst_vreg: i64, src_vreg: i64, grade: i64, dim: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    var k: i64 = 0
    while k < dim {
        let blade_grade = popcount_i64(k)
        let src_disp = hyper_component_disp(src_vreg, k, dim)
        let dst_disp = hyper_component_disp(dst_vreg, k, dim)
        if blade_grade == grade {
            c.code = emit_load_rbp_disp32_rax(c.code, src_disp)
            c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)
        } else {
            c.code = emit_mov_rax_imm(c.code, 0)
            c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)
        }
        k = k + 1
    }
    c
}

// ============================================================
// Hyper binary operation dispatch
// ============================================================

fn lower_hyper_binop(nc: NativeCompiler, instr: IrInstr, alg: i64, cl_p: i64, cl_q: i64) -> NativeCompiler with Mut, Panic, Div {
    let dim = hyper_dimension(alg, cl_p, cl_q)
    let dst_vreg = instr.dst
    let left_vreg = instr.src1
    let right_vreg = instr.src2

    if instr.bin_op == BinaryOp::OpAdd {
        return lower_hyper_add(nc, dst_vreg, left_vreg, right_vreg, dim)
    }
    if instr.bin_op == BinaryOp::OpSub {
        return lower_hyper_sub(nc, dst_vreg, left_vreg, right_vreg, dim)
    }
    if instr.bin_op == BinaryOp::OpMul {
        if alg == ALG_QUATERNION {
            return lower_quaternion_product(nc, dst_vreg, left_vreg, right_vreg)
        }
        if alg == ALG_CLIFFORD {
            return lower_hyper_geo_product(nc, dst_vreg, left_vreg, right_vreg, dim, cl_p, cl_q)
        }
        return lower_hyper_component_mul(nc, dst_vreg, left_vreg, right_vreg, dim)
    }

    // Unsupported op: pass through
    nc
}

// ============================================================
// AVX-512 path stubs (for future EVEX prefix emit support)
// ============================================================
//
// When encode.sio gains EVEX prefix support:
//   - Cl(1,3) 16 components = 2 ZMM registers (8 x f64 each)
//   - geo_product via vfmadd231pd with vpermq for sign flips
//   - conjugate via vxorpd with sign mask
//   - norm via vdpps / horizontal add reduction
//
// The sign table for Cl(1,3) geometric product is a 16x16 matrix of
// {+1, -1, 0} values, compile-time constant. With AVX-512, each row
// of 16 multiplications reduces to 2 FMAs on ZMM registers.
// Total: 16 rows * 2 FMAs = 32 FMA instructions + setup.

fn avx512_cl13_available() -> bool {
    // Placeholder: returns false until EVEX emit support is added
    false
}

// ============================================================
// Hyper lowering entry point
// ============================================================
//
// Called from lower_ir.sio when instruction operates on Hyper types.
// Type metadata (algebra_kind, clifford_p, clifford_q) comes from
// the IR type annotation.

fn lower_hyper_instruction(nc: NativeCompiler, instr: IrInstr, alg: i64, cl_p: i64, cl_q: i64) -> NativeCompiler with Mut, Panic, Div {
    if instr.op == IrOpcode::IrBinOp {
        return lower_hyper_binop(nc, instr, alg, cl_p, cl_q)
    }
    // Other Hyper operations (conjugate, norm, grade) compile as
    // method calls through standard call dispatch for now.
    // Direct opcodes will be added when IR is extended.
    nc
}
