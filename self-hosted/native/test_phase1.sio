fn emit_movzx_rax_al(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0xb6)
    b = emit_byte(b, 0xc0)
