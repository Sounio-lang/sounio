// self-hosted::native::test_phase1 — Phase 1 comprehensive test suite
//
// Tests the full function compilation pipeline:
// IR → stack frames → prologue/epilogue → lowering → relocations → ELF
//
// All Phase 0 modules are inlined here (module system not yet available).

// ============================================================================
// From encode.sio (full Phase 0 + Phase 1 instructions)
// ============================================================================

struct Ph1CodeBuffer {
    bytes: [i8; 65536],
    len: i64,
}

fn code_buffer_new() -> Ph1CodeBuffer {
    Ph1CodeBuffer { bytes: [0; 65536], len: 0 }
}

fn low8(x: i64) -> i64 with Mut, Panic, Div {
    var n = x % 256
    if n < 0 { n = n + 256 }
    n
}

fn emit_byte(buf: Ph1CodeBuffer, b: i64) -> Ph1CodeBuffer with Mut, Panic, Div {
    var out = buf
    if out.len >= 0 {
        if out.len < 65536 {
            out.bytes[out.len as usize] = low8(b) as i8
            out.len = out.len + 1
        }
    }
    out
}

fn emit_u32_le(buf: Ph1CodeBuffer, val: i64) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, low8(val))
    b = emit_byte(b, low8(val >> 8))
    b = emit_byte(b, low8(val >> 16))
    b = emit_byte(b, low8(val >> 24))
    b
}

fn emit_u64_le(buf: Ph1CodeBuffer, val: i64) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_u32_le(b, val)
    b = emit_u32_le(b, val >> 32)
    b
}

fn modrm_rr(dst: i64, src: i64) -> i64 {
    192 + src * 8 + dst
}

fn modrm_rm_imm(dst: i64) -> i64 {
    192 + dst
}

fn emit_mov_rax_imm(buf: Ph1CodeBuffer, val: i64) -> Ph1CodeBuffer with Mut, Panic, Div {
    emit_mov_reg_imm(buf, 0, val)
}

fn emit_mov_rdi_imm(buf: Ph1CodeBuffer, val: i64) -> Ph1CodeBuffer with Mut, Panic, Div {
    emit_mov_reg_imm(buf, 7, val)
}

fn emit_mov_reg_imm32(buf: Ph1CodeBuffer, reg: i64, val: i64) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xc7)
    b = emit_byte(b, modrm_rm_imm(reg))
    b = emit_u32_le(b, val)
    b
}

fn emit_mov_reg_imm64(buf: Ph1CodeBuffer, reg: i64, val: i64) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xb8 + reg)
    b = emit_u64_le(b, val)
    b
}

fn emit_mov_reg_imm(buf: Ph1CodeBuffer, reg: i64, val: i64) -> Ph1CodeBuffer with Mut, Panic, Div {
    if val >= -2147483648 && val <= 2147483647 {
        emit_mov_reg_imm32(buf, reg, val)
    } else {
        emit_mov_reg_imm64(buf, reg, val)
    }
}

fn emit_mov_reg_reg(buf: Ph1CodeBuffer, dst: i64, src: i64) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, modrm_rr(dst, src))
    b
}

fn emit_add_reg_reg(buf: Ph1CodeBuffer, dst: i64, src: i64) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x01)
    b = emit_byte(b, modrm_rr(dst, src))
    b
}

fn emit_sub_reg_reg(buf: Ph1CodeBuffer, dst: i64, src: i64) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x29)
    b = emit_byte(b, modrm_rr(dst, src))
    b
}

fn emit_imul_reg_reg(buf: Ph1CodeBuffer, dst: i64, src: i64) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0xaf)
    b = emit_byte(b, 192 + dst * 8 + src)
    b
}

fn emit_syscall(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x05)
    b
}

fn emit_ret(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0xc3)
}

fn emit_push_rbp(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x55)
}

fn emit_pop_rbp(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x5d)
}

fn emit_mov_rbp_rsp(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0xe5)
    b
}

fn emit_mov_rsp_rbp(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0xec)
    b
}

fn emit_sub_rsp_imm32(buf: Ph1CodeBuffer, val: i64) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x81)
    b = emit_byte(b, 0xec)
    b = emit_u32_le(b, val)
    b
}

fn emit_add_rsp_imm32(buf: Ph1CodeBuffer, val: i64) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x81)
    b = emit_byte(b, 0xc4)
    b = emit_u32_le(b, val)
    b
}

// Phase 1 instructions
fn emit_push_rax(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x50)
}

fn emit_pop_rbx(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x5b)
}

fn emit_pop_rdi(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x5f)
}

fn emit_pop_rsi(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x5e)
}

fn emit_pop_rdx(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x5a)
}

fn emit_pop_rcx(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x59)
}

fn emit_pop_r8(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x41)
    b = emit_byte(b, 0x58)
    b
}

fn emit_pop_r9(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x41)
    b = emit_byte(b, 0x59)
    b
}

fn emit_pop_arg_reg(buf: Ph1CodeBuffer, index: i64) -> Ph1CodeBuffer with Mut, Panic, Div {
    if index == 0 { emit_pop_rdi(buf) }
    else if index == 1 { emit_pop_rsi(buf) }
    else if index == 2 { emit_pop_rdx(buf) }
    else if index == 3 { emit_pop_rcx(buf) }
    else if index == 4 { emit_pop_r8(buf) }
    else if index == 5 { emit_pop_r9(buf) }
    else { buf }
}

fn emit_sub_rsp_8(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x83)
    b = emit_byte(b, 0xec)
    b = emit_byte(b, 0x08)
    b
}

fn emit_add_rsp_8(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x83)
    b = emit_byte(b, 0xc4)
    b = emit_byte(b, 0x08)
    b
}

fn emit_jmp_rel32(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0xe9)
    b = emit_u32_le(b, 0)
    b
}

fn emit_jz_rel32(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x84)
    b = emit_u32_le(b, 0)
    b
}

fn emit_jnz_rel32(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x85)
    b = emit_u32_le(b, 0)
    b
}

fn emit_test_rax_rax(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x85)
    b = emit_byte(b, 0xc0)
    b
}

fn emit_cmp_rbx_rax(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x39)
    b = emit_byte(b, 0xc3)
    b
}

fn emit_sete_al(buf: Ph1CodeBuffer) -> Ph1CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x94)
    b = emit_byte(b, 0xc0)
