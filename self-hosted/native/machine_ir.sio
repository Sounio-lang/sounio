pub let MIR_OP_PSEUDO_INT_TO_FLOAT: i64 = 18
pub let MIR_OP_PSEUDO_FLOAT_TO_INT: i64 = 19

pub let MIR_CC_NONE: i64 = 0
pub let MIR_CC_Z: i64 = 1
pub let MIR_CC_NZ: i64 = 2
pub let MIR_CC_EQ: i64 = 3
pub let MIR_CC_NE: i64 = 4
pub let MIR_CC_LT: i64 = 5
pub let MIR_CC_LE: i64 = 6
pub let MIR_CC_GT: i64 = 7
pub let MIR_CC_GE: i64 = 8

pub struct MachineOperand {
    pub kind: i64,
    pub value: i64,
}

pub struct MachineInstr {
    pub opcode: i64,
    pub dst: MachineOperand,
    pub src1: MachineOperand,
    pub src2: MachineOperand,
    pub aux: MachineOperand,
    pub bin_op: BinaryOp,
    pub un_op: UnaryOp,
    pub cond: i64,
    pub arg_index: i64,
    pub name: Name,
    pub call_arg_values: [i64; 8],
    pub call_arg_count: i64,
}

pub struct MachineBlock {
    pub instrs: [MachineInstr; 512],
    pub instr_count: i64,
}

pub struct MachineFunction {
    pub blocks: [MachineBlock; 1],
    pub block_count: i64,
    pub temp_count: i64,
    pub source_instr_count: i64,
    pub legal_instr_count: i64,
    pub base_slot_count: i64,
    pub supported: bool,
    pub unsupported_detail: string,
    pub is_float_slot: [i64; 256],
    pub slot_kind: [i64; 256],
    pub slot_width_words: [i64; 256],
    pub f128_literal_sign: [i64; 256],
    pub f128_literal_sig_hi: [i64; 256],
    pub f128_literal_sig_lo: [i64; 256],
    pub f128_literal_digit_count: [i64; 256],
    pub f128_literal_scale10: [i64; 256],
    pub f128_literal_truncated_digits: [i64; 256],
    pub f128_literal_truncated_tail_info: [i64; 256],
}

pub struct NativeV2LegalizeSummary {
    pub supported: bool,
    pub unsupported_detail: string,
    pub source_instr_count: i64,
    pub pseudo_instr_count: i64,
    pub legal_instr_count: i64,
}

pub struct MachineModule {
    pub functions: [MachineFunction; 32],
    pub fn_count: i64,
    pub total_ir_instr_count: i64,
    pub total_machine_instr_count: i64,
    pub active: bool,
    pub fail_closed: bool,
    pub legacy_fallback: bool,
    pub coverage: string,
    pub targets: [Name; 4],
    pub target_count: i64,
    pub supported: bool,
    pub unsupported_detail: string,
}

pub fn machine_operand_none() -> MachineOperand with Mut, Panic, Div {
    MachineOperand { kind: MIR_OPERAND_NONE, value: 0 }
}

pub fn machine_operand_gpr64(vreg: i64) -> MachineOperand with Mut, Panic, Div {
    MachineOperand { kind: MIR_OPERAND_GPR64, value: vreg }
}

pub fn machine_operand_stack_slot(slot: i64) -> MachineOperand with Mut, Panic, Div {
    MachineOperand { kind: MIR_OPERAND_STACK_SLOT, value: slot }
}

pub fn machine_operand_imm64(value: i64) -> MachineOperand with Mut, Panic, Div {
    MachineOperand { kind: MIR_OPERAND_IMM64, value: value }
}

pub fn machine_operand_label(label_id: i64) -> MachineOperand with Mut, Panic, Div {
    MachineOperand { kind: MIR_OPERAND_LABEL, value: label_id }
}

pub fn machine_operand_call_target(fn_id: i64) -> MachineOperand with Mut, Panic, Div {
    MachineOperand { kind: MIR_OPERAND_CALL_TARGET, value: fn_id }
}

pub fn machine_operand_data_ref(value: i64) -> MachineOperand with Mut, Panic, Div {
    MachineOperand { kind: MIR_OPERAND_DATA_REF, value: value }
}

pub fn machine_operand_flags(value: i64) -> MachineOperand with Mut, Panic, Div {
    MachineOperand { kind: MIR_OPERAND_FLAGS, value: value }
}

pub fn machine_operand_value(op: MachineOperand) -> i64 {
    op.value
}

pub fn machine_instr_dst_value(instr: MachineInstr) -> i64 {
    instr.dst.value
}

pub fn machine_instr_src1_value(instr: MachineInstr) -> i64 {
    instr.src1.value
}

pub fn machine_instr_src2_value(instr: MachineInstr) -> i64 {
    instr.src2.value
}

pub fn machine_instr_aux_value(instr: MachineInstr) -> i64 {
    instr.aux.value
}

pub fn machine_instr_src1_kind(instr: MachineInstr) -> i64 {
    instr.src1.kind
}

pub fn machine_instr_name(instr: MachineInstr) -> Name {
    instr.name
}

pub fn machine_instr_bin_op(instr: MachineInstr) -> BinaryOp {
    instr.bin_op
}

pub fn machine_instr_un_op(instr: MachineInstr) -> UnaryOp {
    instr.un_op
}

pub fn machine_instr_call_arg_count(instr: MachineInstr) -> i64 {
    instr.call_arg_count
}

pub fn machine_instr_call_arg_value(instr: MachineInstr, idx: i64) -> i64 {
    instr.call_arg_values[idx as usize]
}

pub fn machine_empty_instr() -> MachineInstr with Mut, Panic, Div {
    MachineInstr {
        opcode: MIR_OP_NOP,
        dst: machine_operand_none(),
        src1: machine_operand_none(),
        src2: machine_operand_none(),
        aux: machine_operand_none(),
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        cond: MIR_CC_NONE,
        arg_index: -1,
        name: empty_name(),
        call_arg_values: [0; 8],
        call_arg_count: 0,
    }
}

pub fn machine_block_new() -> MachineBlock with Mut, Panic, Div {
    MachineBlock {
        instrs: [machine_empty_instr(); 512],
        instr_count: 0,
    }
}

pub fn machine_function_new() -> MachineFunction with Mut, Panic, Div {
    MachineFunction {
        blocks: [machine_block_new(); 1],
        block_count: 1,
        temp_count: 0,
        source_instr_count: 0,
        legal_instr_count: 0,
        base_slot_count: 0,
        supported: true,
        unsupported_detail: "",
        is_float_slot: [0; 256],
        slot_kind: [0; 256],
        slot_width_words: [0; 256],
        f128_literal_sign: [0; 256],
        f128_literal_sig_hi: [0; 256],
        f128_literal_sig_lo: [0; 256],
        f128_literal_digit_count: [0; 256],
        f128_literal_scale10: [0; 256],
        f128_literal_truncated_digits: [0; 256],
        f128_literal_truncated_tail_info: [0; 256],
    }
}

fn native_v2_slot_is_valid(slot: i64) -> bool {
    slot >= 0 && slot < 256
}

fn native_v2_mark_slot_ref(out: &! MachineFunction, slot: i64, kind: i64, width_words: i64) with Mut, Panic, Div {
    if native_v2_slot_is_valid(slot) {
        (*out).slot_kind[slot as usize] = kind
        (*out).slot_width_words[slot as usize] = width_words
        (*out).is_float_slot[slot as usize] = if kind == MIR_SLOT_KIND_F64 { 1 } else { 0 }
    }
}

fn native_v2_f128_truncated_count(v: i64) -> i64 {
    if v >= 100 { return v / 100 }
    v
}

fn native_v2_f128_truncated_tail_info(v: i64) -> i64 {
    if v >= 100 { return v % 100 }
    0
}

fn native_v2_f128_effective_truncated_tail_info(truncated_digits: i64, truncated_tail_info: i64) -> i64 {
    let packed_tail_info = native_v2_f128_truncated_tail_info(truncated_digits)
    if packed_tail_info != 0 { return packed_tail_info }
    truncated_tail_info
}

fn native_v2_mark_f128_literal_ref(out: &! MachineFunction, slot: i64, sign: i64, sig_hi: i64, sig_lo: i64, digit_count: i64, scale10: i64, truncated_digits: i64, truncated_tail_info: i64) with Mut, Panic, Div {
    if native_v2_slot_is_valid(slot) && digit_count > 0 {
        (*out).f128_literal_sign[slot as usize] = sign
        (*out).f128_literal_sig_hi[slot as usize] = sig_hi
        (*out).f128_literal_sig_lo[slot as usize] = sig_lo
        (*out).f128_literal_digit_count[slot as usize] = digit_count
        (*out).f128_literal_scale10[slot as usize] = scale10
        (*out).f128_literal_truncated_digits[slot as usize] = native_v2_f128_truncated_count(truncated_digits)
        (*out).f128_literal_truncated_tail_info[slot as usize] = native_v2_f128_effective_truncated_tail_info(truncated_digits, truncated_tail_info)
    }
}

fn native_v2_copy_slot_ref(out: &! MachineFunction, dst_slot: i64, src_slot: i64) with Mut, Panic, Div {
    if native_v2_slot_is_valid(dst_slot) && native_v2_slot_is_valid(src_slot) {
        (*out).slot_kind[dst_slot as usize] = (*out).slot_kind[src_slot as usize]
        (*out).slot_width_words[dst_slot as usize] = (*out).slot_width_words[src_slot as usize]
        (*out).is_float_slot[dst_slot as usize] = (*out).is_float_slot[src_slot as usize]
        (*out).f128_literal_sign[dst_slot as usize] = (*out).f128_literal_sign[src_slot as usize]
        (*out).f128_literal_sig_hi[dst_slot as usize] = (*out).f128_literal_sig_hi[src_slot as usize]
        (*out).f128_literal_sig_lo[dst_slot as usize] = (*out).f128_literal_sig_lo[src_slot as usize]
        (*out).f128_literal_digit_count[dst_slot as usize] = (*out).f128_literal_digit_count[src_slot as usize]
        (*out).f128_literal_scale10[dst_slot as usize] = (*out).f128_literal_scale10[src_slot as usize]
        (*out).f128_literal_truncated_digits[dst_slot as usize] = (*out).f128_literal_truncated_digits[src_slot as usize]
        (*out).f128_literal_truncated_tail_info[dst_slot as usize] = (*out).f128_literal_truncated_tail_info[src_slot as usize]
    }
}

fn native_v2_mark_slot_byval(out: MachineFunction, slot: i64, kind: i64, width_words: i64) -> MachineFunction with Mut, Panic, Div {
    var next = out
    if native_v2_slot_is_valid(slot) {
        next.slot_kind[slot as usize] = kind
        next.slot_width_words[slot as usize] = width_words
        next.is_float_slot[slot as usize] = if kind == MIR_SLOT_KIND_F64 { 1 } else { 0 }
    }
    next
}

fn native_v2_mark_f128_literal_byval(out: MachineFunction, slot: i64, sign: i64, sig_hi: i64, sig_lo: i64, digit_count: i64, scale10: i64, truncated_digits: i64, truncated_tail_info: i64) -> MachineFunction with Mut, Panic, Div {
    var next = out
    if native_v2_slot_is_valid(slot) && digit_count > 0 {
        next.f128_literal_sign[slot as usize] = sign
        next.f128_literal_sig_hi[slot as usize] = sig_hi
        next.f128_literal_sig_lo[slot as usize] = sig_lo
        next.f128_literal_digit_count[slot as usize] = digit_count
        next.f128_literal_scale10[slot as usize] = scale10
        next.f128_literal_truncated_digits[slot as usize] = native_v2_f128_truncated_count(truncated_digits)
        next.f128_literal_truncated_tail_info[slot as usize] = native_v2_f128_effective_truncated_tail_info(truncated_digits, truncated_tail_info)
    }
    next
}

fn native_v2_copy_slot_byval(out: MachineFunction, dst_slot: i64, src_slot: i64) -> MachineFunction with Mut, Panic, Div {
    var next = out
    if native_v2_slot_is_valid(dst_slot) && native_v2_slot_is_valid(src_slot) {
        next.slot_kind[dst_slot as usize] = next.slot_kind[src_slot as usize]
        next.slot_width_words[dst_slot as usize] = next.slot_width_words[src_slot as usize]
        next.is_float_slot[dst_slot as usize] = next.is_float_slot[src_slot as usize]
        next.f128_literal_sign[dst_slot as usize] = next.f128_literal_sign[src_slot as usize]
        next.f128_literal_sig_hi[dst_slot as usize] = next.f128_literal_sig_hi[src_slot as usize]
        next.f128_literal_sig_lo[dst_slot as usize] = next.f128_literal_sig_lo[src_slot as usize]
        next.f128_literal_digit_count[dst_slot as usize] = next.f128_literal_digit_count[src_slot as usize]
        next.f128_literal_scale10[dst_slot as usize] = next.f128_literal_scale10[src_slot as usize]
        next.f128_literal_truncated_digits[dst_slot as usize] = next.f128_literal_truncated_digits[src_slot as usize]
        next.f128_literal_truncated_tail_info[dst_slot as usize] = next.f128_literal_truncated_tail_info[src_slot as usize]
    }
    next
}

fn native_v2_slot_is_f128_ref(out: &MachineFunction, slot: i64) -> bool {
    native_v2_slot_is_valid(slot) && (*out).slot_kind[slot as usize] == MIR_SLOT_KIND_F128_BINARY128
}

fn native_v2_slot_is_f128_byval(out: MachineFunction, slot: i64) -> bool {
    native_v2_slot_is_valid(slot) && out.slot_kind[slot as usize] == MIR_SLOT_KIND_F128_BINARY128
}

fn native_v2_f128_hundredths_from_slot(out: MachineFunction, slot: i64) -> i64 {
    if !native_v2_slot_is_valid(slot) { return 0 - 1 }
    if out.f128_literal_sign[slot as usize] != 1 { return 0 - 1 }
    if out.f128_literal_sig_hi[slot as usize] != 0 { return 0 - 1 }
    if out.f128_literal_truncated_digits[slot as usize] != 0 { return 0 - 1 }
    if out.f128_literal_digit_count[slot as usize] == 2 && out.f128_literal_scale10[slot as usize] == 1 {
        let tenths = out.f128_literal_sig_lo[slot as usize]
        if tenths == 0 || tenths == 5 || tenths == 10 || tenths == 15 || tenths == 20 || tenths == 30 || tenths == 40 {
            return tenths * 10
        }
    }
    if out.f128_literal_digit_count[slot as usize] == 3 && out.f128_literal_scale10[slot as usize] == 2 {
        let hundredths = out.f128_literal_sig_lo[slot as usize]
        if hundredths == 25 { return 25 }
    }
    0 - 1
}

fn native_v2_f128_value_contract_hi_from_hundredths(v: i64) -> i64 {
    if v == 0 { return 0 }
    if v == 25 { return 4610841593497255936 }
    if v == 50 { return 4611123068473966592 }
    if v == 100 { return 4611404543450677248 }
    if v == 150 { return 4611545280939032576 }
    if v == 200 { return 4611686018427387904 }
    if v == 300 { return 4611826755915743232 }
    if v == 400 { return 4611967493404098560 }
    0
}

fn native_v2_f128_value_contract_supported_hundredths(v: i64) -> bool {
    v == 0 || v == 25 || v == 50 || v == 100 || v == 150 || v == 200 || v == 300 || v == 400
}

fn native_v2_f128_pow5(e: i64) -> i64 {
    if e == 0 { return 1 }
    if e == 1 { return 5 }
    if e == 2 { return 25 }
    if e == 3 { return 125 }
    if e == 4 { return 625 }
    if e == 5 { return 3125 }
    if e == 6 { return 15625 }
    if e == 7 { return 78125 }
    if e == 8 { return 390625 }
    if e == 9 { return 1953125 }
    if e == 10 { return 9765625 }
    if e == 11 { return 48828125 }
    if e == 12 { return 244140625 }
    if e == 13 { return 1220703125 }
    if e == 14 { return 6103515625 }
    if e == 15 { return 30517578125 }
    if e == 16 { return 152587890625 }
    if e == 17 { return 762939453125 }
    if e == 18 { return 3814697265625 }
    0
}

fn native_v2_f128_pow10(e: i64) -> i64 {
    if e == 0 { return 1 }
    if e == 1 { return 10 }
    if e == 2 { return 100 }
    if e == 3 { return 1000 }
    if e == 4 { return 10000 }
    if e == 5 { return 100000 }
    if e == 6 { return 1000000 }
    if e == 7 { return 10000000 }
    if e == 8 { return 100000000 }
    if e == 9 { return 1000000000 }
    if e == 10 { return 10000000000 }
    if e == 11 { return 100000000000 }
    if e == 12 { return 1000000000000 }
    if e == 13 { return 10000000000000 }
    if e == 14 { return 100000000000000 }
    if e == 15 { return 1000000000000000 }
    if e == 16 { return 10000000000000000 }
    if e == 17 { return 100000000000000000 }
    if e == 18 { return 1000000000000000000 }
    0
}

fn native_v2_f128_bit_len_pos(v: i64) -> i64 {
    var n = v
    var bits: i64 = 0
    while n > 0 {
        bits = bits + 1
        n = n >> 1
    }
    bits
}

fn native_v2_f128_value_contract_known(sign: i64, sig_hi: i64, sig_lo: i64, digit_count: i64, scale10: i64, truncated_digits: i64) -> bool {
    let trunc_count = native_v2_f128_truncated_count(truncated_digits)
    if sig_hi == 0 && digit_count == 2 && scale10 == 1 && trunc_count == 0 {
        if sig_lo == 0 { return sign == 1 || sign == (0 - 1) }
        if sign != 1 { return false }
        if sig_lo == 5 { return true }
        if sig_lo == 10 { return true }
        if sig_lo == 20 { return true }
        if sig_lo == 30 { return true }
        if sig_lo == 40 { return true }
        if sig_lo == 1 { return true }
    }
    if sign != 1 { return false }
    if sig_hi == 90123456789012345 && sig_lo == 123456789012345678 && digit_count == 35 && scale10 == 34 && trunc_count == 0 { return true }
    if sig_hi == 626267781732175260 && sig_lo == 336210314311209350 && digit_count == 51 && scale10 == 4982 && trunc_count == 15 { return true }
    if sig_hi == 901234567890123456 && sig_lo == 123456789012345678 && digit_count == 39 && scale10 == 38 && trunc_count == 3 { return true }
    if sig_hi == 846264338327950288 && sig_lo == 314159265358979323 && digit_count == 39 && scale10 == 38 && trunc_count == 3 { return true }
    if sig_hi == 333333333333333333 && sig_lo == 33333333333333333 && digit_count == 40 && scale10 == 39 && trunc_count == 4 { return true }
    false
}

fn native_v2_f128_dyadic_n(sig_hi: i64, sig_lo: i64, scale10: i64, truncated_digits: i64) -> i64 {
    if sig_hi != 0 || sig_lo < 0 || native_v2_f128_truncated_count(truncated_digits) != 0 { return -1 }
    if scale10 < 0 {
        let e10 = 0 - scale10
        if e10 > 18 { return -1 }
        var n = sig_lo
        var i: i64 = 0
        while i < e10 {
            if n > 922337203685477580 { return -1 }
            n = n * 10
            i = i + 1
        }
        return n
    }
    if scale10 > 18 { return -1 }
    let p5 = native_v2_f128_pow5(scale10)
    if p5 <= 0 { return -1 }
    if (sig_lo % p5) != 0 { return -1 }
    sig_lo / p5
}

fn native_v2_f128_dyadic_exp2(sig_hi: i64, sig_lo: i64, scale10: i64, truncated_digits: i64) -> i64 {
    if sig_hi != 0 || sig_lo < 0 || native_v2_f128_truncated_count(truncated_digits) != 0 { return -999999 }
    if scale10 < 0 {
        if (0 - scale10) > 18 { return -999999 }
        return 0
    }
    if scale10 > 18 { return -999999 }
    let p5 = native_v2_f128_pow5(scale10)
    if p5 <= 0 { return -999999 }
    if (sig_lo % p5) != 0 { return -999999 }
    0 - scale10
}

fn native_v2_f128_dyadic_materializable(sign: i64, sig_hi: i64, sig_lo: i64, scale10: i64, truncated_digits: i64) -> bool {
    if !(sign == 1 || sign == (0 - 1)) { return false }
    if sig_lo == 0 { return sig_hi == 0 && native_v2_f128_truncated_count(truncated_digits) == 0 }
    let n = native_v2_f128_dyadic_n(sig_hi, sig_lo, scale10, truncated_digits)
    if n <= 0 { return false }
    let bits = native_v2_f128_bit_len_pos(n)
    if bits <= 0 || bits > 113 { return false }
    let e2 = native_v2_f128_dyadic_exp2(sig_hi, sig_lo, scale10, truncated_digits)
    if e2 == -999999 { return false }
    let exp_unbiased = (bits - 1) + e2
    exp_unbiased >= -16382 && exp_unbiased <= 16383
}

fn native_v2_f128_dec_exp2(sig_lo: i64, den: i64) -> i64 {
    var e = native_v2_f128_bit_len_pos(sig_lo) - native_v2_f128_bit_len_pos(den)
    if e >= 0 {
        if e > 62 { return -999999 }
        let threshold = den << e
        if threshold > 0 && sig_lo < threshold { e = e - 1 }
        return e
    }
    let sh = 0 - e
    if sh > 62 { return -999999 }
    if sig_lo > (9223372036854775807 >> sh) { return -999999 }
    if (sig_lo << sh) < den { e = e - 1 }
    e
}

fn native_v2_f128_dec_norm_num(sig_lo: i64, e: i64) -> i64 {
    if e >= 0 { return sig_lo }
    let sh = 0 - e
    if sh > 62 { return -1 }
    if sig_lo > (9223372036854775807 >> sh) { return -1 }
    sig_lo << sh
}

fn native_v2_f128_dec_norm_den(den: i64, e: i64) -> i64 {
    if e < 0 { return den }
    if e > 62 { return -1 }
    if den > (9223372036854775807 >> e) { return -1 }
    den << e
}

fn native_v2_f128_rounded_dec_materializable(sign: i64, sig_hi: i64, sig_lo: i64, scale10: i64, truncated_digits: i64) -> bool {
    if !(sign == 1 || sign == (0 - 1)) { return false }
    if sig_hi != 0 || sig_lo <= 0 || native_v2_f128_truncated_count(truncated_digits) != 0 { return false }
    if scale10 < 1 || scale10 > 18 { return false }
    let den = native_v2_f128_pow10(scale10)
    if den <= 0 { return false }
    let e = native_v2_f128_dec_exp2(sig_lo, den)
    if e == -999999 { return false }
    if e < -16382 || e > 16383 { return false }
    let num = native_v2_f128_dec_norm_num(sig_lo, e)
    let d = native_v2_f128_dec_norm_den(den, e)
    if num <= 0 || d <= 0 { return false }
    if num < d { return false }
    if num >= d && (num - d) >= d { return false }
    true
}

fn native_v2_f128_literal_materializable(sign: i64, sig_hi: i64, sig_lo: i64, digit_count: i64, scale10: i64, truncated_digits: i64) -> bool {
    if digit_count <= 0 { return true }
    if native_v2_f128_value_contract_known(sign, sig_hi, sig_lo, digit_count, scale10, truncated_digits) { return true }
    if native_v2_f128_dyadic_materializable(sign, sig_hi, sig_lo, scale10, truncated_digits) { return true }
    native_v2_f128_rounded_dec_materializable(sign, sig_hi, sig_lo, scale10, truncated_digits)
}

fn native_v2_mark_wide_limb_range_byval(out: MachineFunction, base_slot: i64, limb_count: i64) -> MachineFunction with Mut, Panic, Div {
    var next = out
    var i: i64 = 0
    while i < limb_count && i < 64 {
        next = native_v2_mark_slot_byval(next, base_slot + i, MIR_SLOT_KIND_WIDE_INT_LIMB, limb_count)
        i = i + 1
    }
    next
}

fn native_v2_mark_wide_limb_range_ref(out: &! MachineFunction, base_slot: i64, limb_count: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < limb_count && i < 64 {
        native_v2_mark_slot_ref(out, base_slot + i, MIR_SLOT_KIND_WIDE_INT_LIMB, limb_count)
        i = i + 1
    }
}

fn native_v2_ir_opcode_is_wide_meta(op: IrOpcode) -> bool with Mut, Panic, Div {
    if op == IrOpcode::IrWideAdd { return true }
    if op == IrOpcode::IrWideSub { return true }
    if op == IrOpcode::IrWideMul { return true }
    if op == IrOpcode::IrWideShrLimb { return true }
    if op == IrOpcode::IrWideDiv { return true }
    if op == IrOpcode::IrWideMod { return true }
    if op == IrOpcode::IrWideCmp { return true }
    if op == IrOpcode::IrWideShr { return true }
    if op == IrOpcode::IrWideDivFull { return true }
    if op == IrOpcode::IrWideModFull { return true }
    false
}

fn native_v2_ir_opcode_is_wide_cmp(op: IrOpcode) -> bool with Mut, Panic, Div {
    op == IrOpcode::IrWideCmp
}

pub fn native_v2_legalize_summary_new() -> NativeV2LegalizeSummary with Mut, Panic, Div {
    NativeV2LegalizeSummary {
        supported: true,
        unsupported_detail: "",
        source_instr_count: 0,
        pseudo_instr_count: 0,
        legal_instr_count: 0,
    }
}

pub fn machine_module_new() -> MachineModule with Mut, Panic, Div {
    MachineModule {
        functions: [machine_function_new(); 32],
        fn_count: 0,
        total_ir_instr_count: 0,
        total_machine_instr_count: 0,
        active: false,
        fail_closed: true,
        legacy_fallback: false,
        coverage: "scalar_core",
        targets: [empty_name(); 4],
        target_count: 0,
        supported: true,
        unsupported_detail: "",
    }
}

pub fn machine_function_add_instr_mut(func: &! MachineFunction, instr: MachineInstr) with Mut, Panic, Div {
    if (*func).blocks[0].instr_count < MIR_MAX_INSTRS {
        var block = (*func).blocks[0]
        let idx = block.instr_count
        block.instrs[idx as usize] = instr
        block.instr_count = idx + 1
        (*func).blocks[0] = block
    }
}

pub fn machine_function_add_instr(func: MachineFunction, instr: MachineInstr) -> MachineFunction with Mut, Panic, Div {
    var f = func
    machine_function_add_instr_mut(&! f, instr)
    f
}

pub fn machine_function_next_temp_mut(func: &! MachineFunction) -> i64 with Mut {
    let id = (*func).temp_count
    (*func).temp_count = id + 1
    id
}

pub fn machine_function_next_temp(func: MachineFunction) -> (MachineFunction, i64) with Mut {
    var f = func
    let id = machine_function_next_temp_mut(&! f)
    (f, id)
}

pub fn native_v2_supported_ir_opcode(op: IrOpcode) -> bool with Mut, Panic, Div {
    if op == IrOpcode::IrLoadImm { return true }
    if op == IrOpcode::IrLoadBool { return true }
    if op == IrOpcode::IrLoadString { return true }
    if op == IrOpcode::IrCopy { return true }
    if op == IrOpcode::IrBinOp { return true }
    if op == IrOpcode::IrUnaryOp { return true }
    if op == IrOpcode::IrCall { return true }
    if op == IrOpcode::IrCallSret { return true }
    if op == IrOpcode::IrReturn { return true }
    if op == IrOpcode::IrReturnSret { return true }
    if op == IrOpcode::IrJump { return true }
    if op == IrOpcode::IrBranchTrue { return true }
    if op == IrOpcode::IrBranchFalse { return true }
    if op == IrOpcode::IrFieldGet { return true }
    if op == IrOpcode::IrFieldSet { return true }
    if op == IrOpcode::IrIndexGet { return true }
    if op == IrOpcode::IrIndexSet { return true }
    if op == IrOpcode::IrAlloc { return true }
    if op == IrOpcode::IrLabel { return true }
    if op == IrOpcode::IrNop { return true }
    if op == IrOpcode::IrLoadFloat { return true }
    if op == IrOpcode::IrIntToFloat { return true }
    if op == IrOpcode::IrFloatToInt { return true }
    if op == IrOpcode::IrLoadGlobal { return true }
    if op == IrOpcode::IrStoreGlobal { return true }
    if native_v2_ir_opcode_is_wide_meta(op) { return true }
    false
}

