pub let MIR_OP_JMP: i64 = 109
pub let MIR_OP_JCC: i64 = 110
pub let MIR_OP_LABEL: i64 = 111
pub let MIR_OP_ARG_MOVE: i64 = 112
pub let MIR_OP_CALL: i64 = 113
pub let MIR_OP_CAPTURE_RET: i64 = 114
pub let MIR_OP_RET: i64 = 115
pub let MIR_OP_ALLOC: i64 = 116
pub let MIR_OP_FIELD_LOAD: i64 = 117
pub let MIR_OP_FIELD_STORE: i64 = 118
pub let MIR_OP_INDEX_LOAD: i64 = 119
pub let MIR_OP_INDEX_STORE: i64 = 120
pub let MIR_OP_LEA_STACK: i64 = 121
pub let MIR_OP_LOAD_FLOAT_RIP: i64 = 122     // MOVSD xmm0,[rip+const]; store to slot
pub let MIR_OP_FLOAT_BINOP: i64 = 123        // SSE2 arithmetic/compare on float stack slots
pub let MIR_OP_INT_TO_FLOAT: i64 = 124       // CVTSI2SD: int stack slot → float stack slot
pub let MIR_OP_FLOAT_TO_INT: i64 = 125       // CVTTSD2SI: float stack slot → int stack slot
pub let MIR_OP_FLOAT_MOVE: i64 = 126         // float stack slot copy via xmm0

pub let MIR_OP_LOAD_ABS: i64 = 127           // mov rax,[rax] — load from absolute addr in temp
pub let MIR_OP_STORE_ABS: i64 = 128          // mov [rbx],rax — store to absolute addr
pub let MIR_OP_STACK_ADJUST: i64 = 129       // signed rsp adjustment around stack-arg calls
pub let MIR_OP_STACK_ARG_PUSH: i64 = 130     // push one already-loaded stack argument

pub let MIR_SLOT_KIND_UNKNOWN: i64 = 0
pub let MIR_SLOT_KIND_I64: i64 = 1
pub let MIR_SLOT_KIND_F64: i64 = 2
pub let MIR_SLOT_KIND_F128_BINARY128: i64 = 3
pub let MIR_SLOT_KIND_WIDE_INT_LIMB: i64 = 4

pub let MIR_OP_PSEUDO_LOAD_GLOBAL: i64 = 20
pub let MIR_OP_PSEUDO_STORE_GLOBAL: i64 = 21
pub let MIR_OP_PSEUDO_CALL_SRET: i64 = 22
pub let MIR_OP_PSEUDO_RET_SRET: i64 = 23
pub let MIR_OP_PSEUDO_WIDE_META: i64 = 24
pub let MIR_OP_PSEUDO_F128_META: i64 = 25

