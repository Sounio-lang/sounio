}

fn native_v2_collect_call_args(args: Option<Box<IrRegList>>, out: [i64; 8], count: i64) -> ([i64; 8], i64) with Alloc, Mut, Panic {
    match args {
        Some(list) => {
            var next_out = out
            var next_count = count
            if next_count < MIR_MAX_CALL_ARGS {
                next_out[next_count as usize] = (*list).head
                next_count = next_count + 1
            }
            native_v2_collect_call_args((*list).tail, next_out, next_count)
        }
        _ => (out, count),
    }
}

fn native_v2_pseudo_from_ir(instr: IrInstr) -> MachineInstr with Alloc, Mut, Panic {
    var mi = machine_empty_instr()
    if instr.op == IrOpcode::IrLoadImm || instr.op == IrOpcode::IrLoadBool {
        mi.opcode = MIR_OP_PSEUDO_LOAD_IMM
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_imm64(instr.imm_i64)
        return mi
    }
    if instr.op == IrOpcode::IrLoadString {
        mi.opcode = MIR_OP_PSEUDO_LOAD_STRING
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.name = instr.name
        return mi
    }
    if instr.op == IrOpcode::IrCopy {
        mi.opcode = MIR_OP_PSEUDO_COPY
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_stack_slot(instr.src1)
        return mi
    }
    if instr.op == IrOpcode::IrBinOp {
        mi.opcode = MIR_OP_PSEUDO_BINOP
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_stack_slot(instr.src1)
        mi.src2 = machine_operand_stack_slot(instr.src2)
        mi.bin_op = instr.bin_op
        return mi
    }
    if instr.op == IrOpcode::IrUnaryOp {
        mi.opcode = MIR_OP_PSEUDO_UNARY
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_stack_slot(instr.src1)
        mi.un_op = instr.un_op
        return mi
    }
    if instr.op == IrOpcode::IrCall {
        let pair = native_v2_collect_call_args(instr.call_args, [0; 8], 0)
        mi.opcode = MIR_OP_PSEUDO_CALL
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_call_target(instr.fn_id)
        mi.call_arg_values = pair.0
        mi.call_arg_count = pair.1
        return mi
    }
    if instr.op == IrOpcode::IrReturn {
        mi.opcode = MIR_OP_PSEUDO_RET
        if instr.src1 >= 0 {
            mi.src1 = machine_operand_stack_slot(instr.src1)
        }
        return mi
    }
    if instr.op == IrOpcode::IrJump {
        mi.opcode = MIR_OP_PSEUDO_JUMP
        mi.dst = machine_operand_label(instr.label_id)
        return mi
    }
    if instr.op == IrOpcode::IrBranchTrue {
        mi.opcode = MIR_OP_PSEUDO_BRANCH_TRUE
        mi.dst = machine_operand_label(instr.label_id)
        mi.src1 = machine_operand_stack_slot(instr.src1)
        return mi
    }
    if instr.op == IrOpcode::IrBranchFalse {
        mi.opcode = MIR_OP_PSEUDO_BRANCH_FALSE
        mi.dst = machine_operand_label(instr.label_id)
        mi.src1 = machine_operand_stack_slot(instr.src1)
        return mi
    }
    if instr.op == IrOpcode::IrFieldGet {
        mi.opcode = MIR_OP_PSEUDO_FIELD_GET
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_stack_slot(instr.src1)
        mi.aux = machine_operand_imm64(instr.field_idx)
        return mi
    }
    if instr.op == IrOpcode::IrFieldSet {
        mi.opcode = MIR_OP_PSEUDO_FIELD_SET
        mi.src1 = machine_operand_stack_slot(instr.src1)
        mi.src2 = machine_operand_stack_slot(instr.src2)
        mi.aux = machine_operand_imm64(instr.field_idx)
        return mi
    }
    if instr.op == IrOpcode::IrIndexGet {
        mi.opcode = MIR_OP_PSEUDO_INDEX_GET
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_stack_slot(instr.src1)
        mi.src2 = machine_operand_stack_slot(instr.src2)
        return mi
    }
    if instr.op == IrOpcode::IrIndexSet {
        mi.opcode = MIR_OP_PSEUDO_INDEX_SET
        mi.src1 = machine_operand_stack_slot(instr.src1)
        mi.src2 = machine_operand_stack_slot(instr.src2)
        mi.aux = machine_operand_stack_slot(instr.imm_i64)
        return mi
    }
    if instr.op == IrOpcode::IrAlloc {
        mi.opcode = MIR_OP_PSEUDO_ALLOC
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_imm64(instr.imm_i64)
        return mi
    }
    if instr.op == IrOpcode::IrLabel {
        mi.opcode = MIR_OP_PSEUDO_LABEL
        mi.dst = machine_operand_label(instr.label_id)
        return mi
    }
    if instr.op == IrOpcode::IrLoadFloat {
        mi.opcode = MIR_OP_PSEUDO_LOAD_FLOAT
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_imm64(f64_to_bits(instr.imm_f64))
        return mi
    }
    if instr.op == IrOpcode::IrIntToFloat {
        mi.opcode = MIR_OP_PSEUDO_INT_TO_FLOAT
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_stack_slot(instr.src1)
        return mi
    }
    if instr.op == IrOpcode::IrFloatToInt {
        mi.opcode = MIR_OP_PSEUDO_FLOAT_TO_INT
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_stack_slot(instr.src1)
        return mi
    }
    mi
}

fn native_v2_alloc_size_from_tag(tag: i64) -> i64 {
    if tag == 0 { return 512 }
    if tag == 1 { return 512 }
    if tag == 2 { return 128 }
    if tag == 8 { return 16 }
    if tag < 64 { return 64 }
    ((tag + 7) / 8) * 8
}

fn native_v2_alloc_descriptor_from_tag(tag: i64) -> i64 {
    if tag == 0 { return 0 }
    if tag == 1 { return 1 }
    if tag == 2 { return 2 }
    if tag == 8 { return 8 }
    255
}


// By-value instruction append (avoids JIT &! bug)
fn _emit_legal_byval(func: MachineFunction, instr: MachineInstr) -> MachineFunction with Mut, Panic, Div {
    var f = func
    if f.blocks[0].instr_count < 512 {
        f.blocks[0].instrs[f.blocks[0].instr_count as usize] = instr
        f.blocks[0].instr_count = f.blocks[0].instr_count + 1
        f.legal_instr_count = f.legal_instr_count + 1
    }
    f
}

fn _add_instr_byval(func: MachineFunction, instr: MachineInstr) -> MachineFunction with Mut, Panic, Div {
    var f = func
    if f.blocks[0].instr_count < 512 {
        f.blocks[0].instrs[f.blocks[0].instr_count as usize] = instr
        f.blocks[0].instr_count = f.blocks[0].instr_count + 1
    }
    f
}

pub fn native_v2_lower_function_to_machine(func: IrFunction) -> MachineFunction with Mut, Panic, Div, Alloc {
    var out = machine_function_new()
    out.base_slot_count = func.reg_count
    out.source_instr_count = func.instr_count

    var i: i64 = 0
    while i < func.instr_count {
        let instr = func.instrs[i as usize]
        if instr.op == IrOpcode::IrNop {
            i = i + 1
            continue
        }
        if !native_v2_supported_ir_opcode(instr.op) {
            out.supported = false
            out.unsupported_detail = native_v2_ir_opcode_name(instr.op)
            return out
        }
        out = _add_instr_byval(out, native_v2_pseudo_from_ir(instr))
        i = i + 1
    }

    out
}

fn native_v2_emit_legal_instr_mut(func: &! MachineFunction, instr: MachineInstr) with Mut, Panic, Div {
    machine_function_add_instr_mut(&! (*func), instr)
    (*func).legal_instr_count = (*func).legal_instr_count + 1
}

fn native_v2_make_mov_imm(temp: i64, imm: i64) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_MOV_IMM
    mi.dst = machine_operand_gpr64(temp)
    mi.src1 = machine_operand_imm64(imm)
    mi
}

fn native_v2_make_load_stack(temp: i64, slot: i64) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_LOAD_STACK
    mi.dst = machine_operand_gpr64(temp)
    mi.src1 = machine_operand_stack_slot(slot)
    mi
}

fn native_v2_make_store_stack(slot: i64, temp: i64) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_STORE_STACK
    mi.dst = machine_operand_stack_slot(slot)
    mi.src1 = machine_operand_gpr64(temp)
    mi
}

fn native_v2_make_load_data_addr(temp: i64, name: Name) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_LOAD_DATA_ADDR
    mi.dst = machine_operand_gpr64(temp)
    mi.name = name
    mi
}

fn native_v2_make_binop(lhs: i64, rhs: i64, op: BinaryOp) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_BINOP
    mi.dst = machine_operand_gpr64(lhs)
    mi.src1 = machine_operand_gpr64(rhs)
    mi.bin_op = op
    mi
}

fn native_v2_make_unary(dst: i64, src: i64, op: UnaryOp) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_UNARY
    mi.dst = machine_operand_gpr64(dst)
    mi.src1 = machine_operand_gpr64(src)
    mi.un_op = op
    mi
}

fn native_v2_make_lea_stack(temp: i64, slot: i64) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_LEA_STACK
    mi.dst = machine_operand_gpr64(temp)
    mi.src1 = machine_operand_stack_slot(slot)
    mi
}

fn native_v2_make_cmp_zero(temp: i64) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_CMP_ZERO
    mi.src1 = machine_operand_gpr64(temp)
    mi
}

fn native_v2_make_jcc(label_id: i64, cond: i64) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_JCC
    mi.dst = machine_operand_label(label_id)
    mi.cond = cond
    mi
}

fn native_v2_make_label(label_id: i64) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_LABEL
    mi.dst = machine_operand_label(label_id)
    mi
}

fn native_v2_make_jump(label_id: i64) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_JMP
    mi.dst = machine_operand_label(label_id)
    mi
}

fn native_v2_make_arg_move(arg_index: i64, temp: i64) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_ARG_MOVE
    mi.arg_index = arg_index
    mi.src1 = machine_operand_gpr64(temp)
    mi
}

fn native_v2_make_call(fn_id: i64) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_CALL
    mi.src1 = machine_operand_call_target(fn_id)
    mi
}

fn native_v2_make_capture_ret(temp: i64) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_CAPTURE_RET
    mi.dst = machine_operand_gpr64(temp)
    mi
}

fn native_v2_make_ret(temp: i64) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_RET
    if temp >= 0 {
        mi.src1 = machine_operand_gpr64(temp)
    }
    mi
}

fn native_v2_make_alloc(temp: i64, alloc_size: i64, descriptor_id: i64) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_ALLOC
    mi.dst = machine_operand_gpr64(temp)
    mi.src1 = machine_operand_imm64(alloc_size)
    mi.aux = machine_operand_imm64(descriptor_id)
    mi
}

fn native_v2_make_field_load(dst: i64, base: i64, field_idx: i64) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_FIELD_LOAD
    mi.dst = machine_operand_gpr64(dst)
    mi.src1 = machine_operand_gpr64(base)
    mi.aux = machine_operand_imm64(field_idx)
    mi
}

fn native_v2_make_field_store(base: i64, src: i64, field_idx: i64) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_FIELD_STORE
    mi.src1 = machine_operand_gpr64(base)
    mi.src2 = machine_operand_gpr64(src)
    mi.aux = machine_operand_imm64(field_idx)
    mi
}

fn native_v2_make_index_load(dst: i64, base: i64, idx: i64) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_INDEX_LOAD
    mi.dst = machine_operand_gpr64(dst)
    mi.src1 = machine_operand_gpr64(base)
    mi.src2 = machine_operand_gpr64(idx)
    mi
}

fn native_v2_make_index_store(base: i64, idx: i64, src: i64) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_INDEX_STORE
    mi.src1 = machine_operand_gpr64(base)
    mi.src2 = machine_operand_gpr64(idx)
    mi.aux = machine_operand_gpr64(src)
    mi
}

// Sprint 87: Float MachineInstr constructors (stack-slot-to-stack-slot convention)
fn native_v2_make_load_float_rip(dst_slot: i64, bits: i64) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_LOAD_FLOAT_RIP
    mi.dst = machine_operand_stack_slot(dst_slot)
    mi.src1 = machine_operand_imm64(bits)
    mi
}

fn native_v2_make_int_to_float(dst_slot: i64, src_slot: i64) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_INT_TO_FLOAT
    mi.dst = machine_operand_stack_slot(dst_slot)
    mi.src1 = machine_operand_stack_slot(src_slot)
    mi
}

fn native_v2_make_float_to_int(dst_slot: i64, src_slot: i64) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_FLOAT_TO_INT
    mi.dst = machine_operand_stack_slot(dst_slot)
    mi.src1 = machine_operand_stack_slot(src_slot)
    mi
}

fn native_v2_make_float_binop(dst_slot: i64, src1_slot: i64, src2_slot: i64, op: BinaryOp, src1_is_float: i64, src2_is_float: i64) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_FLOAT_BINOP
    mi.dst = machine_operand_stack_slot(dst_slot)
    mi.src1 = machine_operand_stack_slot(src1_slot)
    mi.src2 = machine_operand_stack_slot(src2_slot)
    mi.bin_op = op
    mi.aux = machine_operand_imm64(src1_is_float | (src2_is_float * 2))
    mi
}

fn native_v2_make_float_move(dst_slot: i64, src_slot: i64) -> MachineInstr {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_FLOAT_MOVE
    mi.dst = machine_operand_stack_slot(dst_slot)
    mi.src1 = machine_operand_stack_slot(src_slot)
    mi
}

pub fn native_v2_legalize_function(func: MachineFunction) -> MachineFunction with Mut, Panic, Div {
    var out = machine_function_new()
    out.base_slot_count = func.base_slot_count
    out.temp_count = func.base_slot_count
    out.source_instr_count = func.source_instr_count
    if !func.supported {
        out.supported = false
        out.unsupported_detail = func.unsupported_detail
        return out
    }

    var i: i64 = 0
    while i < func.blocks[0].instr_count {
        let instr = func.blocks[0].instrs[i as usize]

        if instr.opcode == MIR_OP_PSEUDO_LOAD_IMM {
            let temp = out.temp_count
            out.temp_count = temp + 1
            out = _emit_legal_byval(out, native_v2_make_mov_imm(temp, instr.src1.value))
            out = _emit_legal_byval(out, native_v2_make_store_stack(instr.dst.value, temp))
        } else if instr.opcode == MIR_OP_PSEUDO_LOAD_STRING {
            let temp = out.temp_count
            out.temp_count = temp + 1
            let load = native_v2_make_load_data_addr(temp, instr.name)
            out = _emit_legal_byval(out, load)
            out = _emit_legal_byval(out, native_v2_make_store_stack(instr.dst.value, temp))
        } else if instr.opcode == MIR_OP_PSEUDO_COPY {
            // Sprint 87: propagate float-ness for COPY
            let src_slot = instr.src1.value
            let dst_slot = instr.dst.value
            let src_is_float = if src_slot >= 0 && src_slot < 256 { out.is_float_slot[src_slot as usize] } else { 0 }
            if src_is_float == 1 {
                out = _emit_legal_byval(out, native_v2_make_float_move(dst_slot, src_slot))
                if dst_slot >= 0 && dst_slot < 256 {
                    out.is_float_slot[dst_slot as usize] = 1
                }
            } else {
                let temp = out.temp_count
                out.temp_count = temp + 1
                out = _emit_legal_byval(out, native_v2_make_load_stack(temp, instr.src1.value))
                out = _emit_legal_byval(out, native_v2_make_store_stack(instr.dst.value, temp))
            }
        } else if instr.opcode == MIR_OP_PSEUDO_BINOP {
            // Sprint 87: check if either operand is a float slot → emit FLOAT_BINOP
            let s1 = instr.src1.value
            let s2 = instr.src2.value
            let s1f = if s1 >= 0 && s1 < 256 { out.is_float_slot[s1 as usize] } else { 0 }
            let s2f = if s2 >= 0 && s2 < 256 { out.is_float_slot[s2 as usize] } else { 0 }
            if s1f == 1 || s2f == 1 {
                out = _emit_legal_byval(out, native_v2_make_float_binop(instr.dst.value, s1, s2, instr.bin_op, s1f, s2f))
                let dslot = instr.dst.value
                if dslot >= 0 && dslot < 256 {
                    if instr.bin_op == BinaryOp::OpAdd || instr.bin_op == BinaryOp::OpSub || instr.bin_op == BinaryOp::OpMul || instr.bin_op == BinaryOp::OpDiv {
                        out.is_float_slot[dslot as usize] = 1
                    }
                }
            } else {
                let lhs = out.temp_count
                out.temp_count = lhs + 1
                let rhs = out.temp_count
                out.temp_count = rhs + 1
                out = _emit_legal_byval(out, native_v2_make_load_stack(lhs, instr.src1.value))
                out = _emit_legal_byval(out, native_v2_make_load_stack(rhs, instr.src2.value))
                out = _emit_legal_byval(out, native_v2_make_binop(lhs, rhs, instr.bin_op))
                out = _emit_legal_byval(out, native_v2_make_store_stack(instr.dst.value, lhs))
            }
        } else if instr.opcode == MIR_OP_PSEUDO_UNARY {
            let temp = out.temp_count
            out.temp_count = temp + 1
            if instr.un_op == UnaryOp::OpRef || instr.un_op == UnaryOp::OpRefMut {
                out = _emit_legal_byval(out, native_v2_make_lea_stack(temp, instr.src1.value))
            } else {
                out = _emit_legal_byval(out, native_v2_make_load_stack(temp, instr.src1.value))
                out = _emit_legal_byval(out, native_v2_make_unary(temp, temp, instr.un_op))
            }
            out = _emit_legal_byval(out, native_v2_make_store_stack(instr.dst.value, temp))
        } else if instr.opcode == MIR_OP_PSEUDO_CALL {
            if instr.call_arg_count > 6 {
                out.supported = false
                out.unsupported_detail = "call_arity_gt_6"
                return out
            }
            var ai: i64 = 0
            while ai < instr.call_arg_count {
                let temp = out.temp_count
                out.temp_count = temp + 1
                out = _emit_legal_byval(out, native_v2_make_load_stack(temp, instr.call_arg_values[ai as usize]))
                out = _emit_legal_byval(out, native_v2_make_arg_move(ai, temp))
                ai = ai + 1
            }
            out = _emit_legal_byval(out, native_v2_make_call(instr.src1.value))
            if instr.dst.value >= 0 {
                let temp = out.temp_count
                out.temp_count = temp + 1
                out = _emit_legal_byval(out, native_v2_make_capture_ret(temp))
                out = _emit_legal_byval(out, native_v2_make_store_stack(instr.dst.value, temp))
            }
        } else if instr.opcode == MIR_OP_PSEUDO_RET {
            if instr.src1.kind == MIR_OPERAND_STACK_SLOT {
                let temp = out.temp_count
                out.temp_count = temp + 1
                out = _emit_legal_byval(out, native_v2_make_load_stack(temp, instr.src1.value))
                out = _emit_legal_byval(out, native_v2_make_ret(temp))
            } else {
                out = _emit_legal_byval(out, native_v2_make_ret(-1))
            }
        } else if instr.opcode == MIR_OP_PSEUDO_JUMP {
            out = _emit_legal_byval(out, native_v2_make_jump(instr.dst.value))
        } else if instr.opcode == MIR_OP_PSEUDO_BRANCH_TRUE {
            let temp = out.temp_count
            out.temp_count = temp + 1
            out = _emit_legal_byval(out, native_v2_make_load_stack(temp, instr.src1.value))
            out = _emit_legal_byval(out, native_v2_make_cmp_zero(temp))
            out = _emit_legal_byval(out, native_v2_make_jcc(instr.dst.value, MIR_CC_NZ))
        } else if instr.opcode == MIR_OP_PSEUDO_BRANCH_FALSE {
            let temp = out.temp_count
            out.temp_count = temp + 1
            out = _emit_legal_byval(out, native_v2_make_load_stack(temp, instr.src1.value))
            out = _emit_legal_byval(out, native_v2_make_cmp_zero(temp))
            out = _emit_legal_byval(out, native_v2_make_jcc(instr.dst.value, MIR_CC_Z))
        } else if instr.opcode == MIR_OP_PSEUDO_LABEL {
            out = _emit_legal_byval(out, native_v2_make_label(instr.dst.value))
        } else if instr.opcode == MIR_OP_PSEUDO_ALLOC {
            let temp = out.temp_count
            out.temp_count = temp + 1
            out = _emit_legal_byval(out, native_v2_make_alloc(temp, native_v2_alloc_size_from_tag(instr.src1.value), native_v2_alloc_descriptor_from_tag(instr.src1.value)))
            out = _emit_legal_byval(out, native_v2_make_store_stack(instr.dst.value, temp))
        } else if instr.opcode == MIR_OP_PSEUDO_FIELD_GET {
            let base = out.temp_count
            out.temp_count = base + 1
            let dst = out.temp_count
            out.temp_count = dst + 1
            out = _emit_legal_byval(out, native_v2_make_load_stack(base, instr.src1.value))
            out = _emit_legal_byval(out, native_v2_make_field_load(dst, base, instr.aux.value))
            out = _emit_legal_byval(out, native_v2_make_store_stack(instr.dst.value, dst))
        } else if instr.opcode == MIR_OP_PSEUDO_FIELD_SET {
            let base = out.temp_count
            out.temp_count = base + 1
            let src = out.temp_count
            out.temp_count = src + 1
            out = _emit_legal_byval(out, native_v2_make_load_stack(base, instr.src1.value))
            out = _emit_legal_byval(out, native_v2_make_load_stack(src, instr.src2.value))
            out = _emit_legal_byval(out, native_v2_make_field_store(base, src, instr.aux.value))
        } else if instr.opcode == MIR_OP_PSEUDO_INDEX_GET {
            let base = out.temp_count
            out.temp_count = base + 1
            let idx = out.temp_count
            out.temp_count = idx + 1
            let dst = out.temp_count
            out.temp_count = dst + 1
            out = _emit_legal_byval(out, native_v2_make_load_stack(base, instr.src1.value))
            out = _emit_legal_byval(out, native_v2_make_load_stack(idx, instr.src2.value))
            out = _emit_legal_byval(out, native_v2_make_index_load(dst, base, idx))
            out = _emit_legal_byval(out, native_v2_make_store_stack(instr.dst.value, dst))
        } else if instr.opcode == MIR_OP_PSEUDO_INDEX_SET {
            let base = out.temp_count
            out.temp_count = base + 1
            let idx = out.temp_count
            out.temp_count = idx + 1
            let src = out.temp_count
            out.temp_count = src + 1
            out = _emit_legal_byval(out, native_v2_make_load_stack(base, instr.src1.value))
            out = _emit_legal_byval(out, native_v2_make_load_stack(idx, instr.src2.value))
            out = _emit_legal_byval(out, native_v2_make_load_stack(src, instr.aux.value))
            out = _emit_legal_byval(out, native_v2_make_index_store(base, idx, src))
        } else if instr.opcode == MIR_OP_PSEUDO_LOAD_FLOAT {
            // Sprint 87: float literal → LOAD_FLOAT_RIP stack slot
            out = _emit_legal_byval(out, native_v2_make_load_float_rip(instr.dst.value, instr.src1.value))
            if instr.dst.value >= 0 && instr.dst.value < 256 {
                out.is_float_slot[instr.dst.value as usize] = 1
            }
        } else if instr.opcode == MIR_OP_PSEUDO_INT_TO_FLOAT {
            // Sprint 87: int stack slot → CVTSI2SD → float stack slot
            out = _emit_legal_byval(out, native_v2_make_int_to_float(instr.dst.value, instr.src1.value))
            if instr.dst.value >= 0 && instr.dst.value < 256 {
                out.is_float_slot[instr.dst.value as usize] = 1
            }
        } else if instr.opcode == MIR_OP_PSEUDO_FLOAT_TO_INT {
            // Sprint 87: float stack slot → CVTTSD2SI → int stack slot
            out = _emit_legal_byval(out, native_v2_make_float_to_int(instr.dst.value, instr.src1.value))
            if instr.dst.value >= 0 && instr.dst.value < 256 {
                out.is_float_slot[instr.dst.value as usize] = 0
            }
        }
        i = i + 1
    }

    if out.legal_instr_count <= 0 {
        out.legal_instr_count = out.blocks[0].instr_count
    }
    out
}

fn native_v2_machine_instr_is_legal(instr: MachineInstr) -> bool {
    if instr.opcode == MIR_OP_LOAD_STACK {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_STACK_SLOT
    }
    if instr.opcode == MIR_OP_STORE_STACK {
        return instr.dst.kind == MIR_OPERAND_STACK_SLOT && instr.src1.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_MOV_IMM {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_IMM64
    }
    if instr.opcode == MIR_OP_LOAD_DATA_ADDR {
        return instr.dst.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_MOVE {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_BINOP {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_UNARY {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_CMP_ZERO {
        return instr.src1.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_SETCC {
        return instr.dst.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_JMP {
        return instr.dst.kind == MIR_OPERAND_LABEL
    }
    if instr.opcode == MIR_OP_JCC {
        return instr.dst.kind == MIR_OPERAND_LABEL && instr.cond != MIR_CC_NONE
    }
    if instr.opcode == MIR_OP_LABEL {
        return instr.dst.kind == MIR_OPERAND_LABEL
    }
    if instr.opcode == MIR_OP_ARG_MOVE {
        return instr.src1.kind == MIR_OPERAND_GPR64 && instr.arg_index >= 0 && instr.arg_index < 6
    }
    if instr.opcode == MIR_OP_CALL {
        return instr.src1.kind == MIR_OPERAND_CALL_TARGET
    }
    if instr.opcode == MIR_OP_CAPTURE_RET {
        return instr.dst.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_RET {
        return instr.src1.kind == MIR_OPERAND_NONE || instr.src1.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_ALLOC {
        return instr.dst.kind == MIR_OPERAND_GPR64
            && instr.src1.kind == MIR_OPERAND_IMM64
            && (instr.aux.kind == MIR_OPERAND_NONE || instr.aux.kind == MIR_OPERAND_IMM64)
    }
    if instr.opcode == MIR_OP_FIELD_LOAD {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_GPR64 && instr.aux.kind == MIR_OPERAND_IMM64
    }
    if instr.opcode == MIR_OP_FIELD_STORE {
        return instr.src1.kind == MIR_OPERAND_GPR64 && instr.src2.kind == MIR_OPERAND_GPR64 && instr.aux.kind == MIR_OPERAND_IMM64
    }
    if instr.opcode == MIR_OP_INDEX_LOAD {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_GPR64 && instr.src2.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_INDEX_STORE {
        return instr.src1.kind == MIR_OPERAND_GPR64 && instr.src2.kind == MIR_OPERAND_GPR64 && instr.aux.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_LEA_STACK {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_STACK_SLOT
    }
    false
}

fn native_v2_machine_function_is_legal(func: MachineFunction) -> bool {
    if !func.supported { return false }
    var i: i64 = 0
    while i < func.blocks[0].instr_count {
        if !native_v2_machine_instr_is_legal(func.blocks[0].instrs[i as usize]) {
            return false
        }
        i = i + 1
    }
    true
}

fn native_v2_build_machine_module(module: &IrModule, enable_x86: bool) -> MachineModule with Mut, Panic, Div, Alloc {
    var out = machine_module_new()
    out.fn_count = module.fn_count
    out.total_ir_instr_count = 0
    out.active = enable_x86
    if enable_x86 {
        var target = empty_name()
        target.buf[0] = 120 as i8
        target.buf[1] = 56 as i8
        target.buf[2] = 54 as i8
        target.buf[3] = 95 as i8
        target.buf[4] = 54 as i8
        target.buf[5] = 52 as i8
        target.buf[6] = 45 as i8
        target.buf[7] = 108 as i8
        target.buf[8] = 105 as i8
        target.buf[9] = 110 as i8
        target.buf[10] = 117 as i8
        target.buf[11] = 120 as i8
        target.len = 12
        out.targets[0] = target
        out.target_count = 1
    }

    var i: i64 = 0
    while i < module.fn_count {
        let lowered = native_v2_lower_function_to_machine(module.functions[i as usize])
        out.total_ir_instr_count = out.total_ir_instr_count + lowered.source_instr_count
        let legal = native_v2_legalize_function(lowered)
        out.functions[i as usize] = legal
        let legal_count = if legal.legal_instr_count > 0 { legal.legal_instr_count } else { legal.blocks[0].instr_count }
        out.total_machine_instr_count = out.total_machine_instr_count + legal_count
        if !legal.supported && out.supported {
            out.supported = false
            out.unsupported_detail = legal.unsupported_detail
        }
        i = i + 1
    }

    out
}
