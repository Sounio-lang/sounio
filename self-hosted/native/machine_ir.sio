// self-hosted::native::machine_ir — Minimal x86-native-v2 Machine IR substrate
//
// First active preview slice: x86_64-linux scalar core only.

module native::machine_ir

use parser::ast::{Name, BinaryOp, UnaryOp, empty_name}
use ir::ir::{IrModule, IrFunction, IrInstr, IrOpcode, IrRegList, BSS_BASE_LINUX, IR_FLOAT_REG_MARKER_FLAG, IR_FLOAT_NO_MARKERS}

pub let MIR_MAX_BLOCKS: i64 = 1
// MIR_MAX_INSTRS history:
//   1024 (silent drop past wall) → 4096 (2026-07-20, align with IR_MAX_INSTRS).
// Multi-module streaming / machine_ir legalize still materialises one block of
// MachineInstr; under 1024 the tail (incl. ret) was dropped with no diagnostic.
// Legalize expands some IR ops 2–4×, so dense full-IR bodies may still trip the
// wall — overflow is now fail-closed (supported=false, mir_instr_capacity).
pub let MIR_MAX_INSTRS: i64 = 4096
pub let MIR_MAX_CALL_ARGS: i64 = 8

// MIR_MAX_FLOAT_SLOTS history:
//   256 (silent float-typing drop past wall) → 2048 (2026-07-20, align with NC_MAX_VREGS).
// Indexed by IR stack-slot / vreg id during native_v2 legalize. Past 256, float
// marks were silently dropped → int path for float arithmetic (wrong code / SEGV).
// Mark overflow is fail-closed (supported=false, float_slot_capacity).
pub let MIR_MAX_FLOAT_SLOTS: i64 = 2048

pub let MIR_OPERAND_NONE: i64 = 0
pub let MIR_OPERAND_GPR64: i64 = 1
pub let MIR_OPERAND_STACK_SLOT: i64 = 2
pub let MIR_OPERAND_IMM64: i64 = 3
pub let MIR_OPERAND_LABEL: i64 = 4
pub let MIR_OPERAND_CALL_TARGET: i64 = 5
pub let MIR_OPERAND_DATA_REF: i64 = 6
pub let MIR_OPERAND_FLAGS: i64 = 7

pub let MIR_OP_NOP: i64 = 0
pub let MIR_OP_PSEUDO_LOAD_IMM: i64 = 1
pub let MIR_OP_PSEUDO_LOAD_STRING: i64 = 2
pub let MIR_OP_PSEUDO_COPY: i64 = 3
pub let MIR_OP_PSEUDO_BINOP: i64 = 4
pub let MIR_OP_PSEUDO_UNARY: i64 = 5
pub let MIR_OP_PSEUDO_CALL: i64 = 6
pub let MIR_OP_PSEUDO_RET: i64 = 7
pub let MIR_OP_PSEUDO_JUMP: i64 = 8
pub let MIR_OP_PSEUDO_BRANCH_TRUE: i64 = 9
pub let MIR_OP_PSEUDO_BRANCH_FALSE: i64 = 10
pub let MIR_OP_PSEUDO_LABEL: i64 = 11
pub let MIR_OP_PSEUDO_ALLOC: i64 = 12
pub let MIR_OP_PSEUDO_FIELD_GET: i64 = 13
pub let MIR_OP_PSEUDO_FIELD_SET: i64 = 14
pub let MIR_OP_PSEUDO_INDEX_GET: i64 = 15
pub let MIR_OP_PSEUDO_INDEX_SET: i64 = 16

pub let MIR_OP_LOAD_STACK: i64 = 100
pub let MIR_OP_STORE_STACK: i64 = 101
pub let MIR_OP_MOV_IMM: i64 = 102
pub let MIR_OP_LOAD_DATA_ADDR: i64 = 103
pub let MIR_OP_MOVE: i64 = 104
pub let MIR_OP_BINOP: i64 = 105
pub let MIR_OP_UNARY: i64 = 106
pub let MIR_OP_CMP_ZERO: i64 = 107
pub let MIR_OP_SETCC: i64 = 108
pub let MIR_OP_JMP: i64 = 109
pub let MIR_OP_JCC: i64 = 110
pub let MIR_OP_LABEL: i64 = 111
pub let MIR_OP_ARG_MOVE: i64 = 112
pub let MIR_OP_CALL: i64 = 113
pub let MIR_OP_CAPTURE_RET: i64 = 114
pub let MIR_OP_RET: i64 = 115
pub let MIR_OP_ALLOC: i64 = 116
pub let MIR_OP_FIELD_LOAD: i64 = 117
pub let MIR_OP_FIELD_STORE: i64 = 118
pub let MIR_OP_INDEX_LOAD: i64 = 119
pub let MIR_OP_INDEX_STORE: i64 = 120
pub let MIR_OP_LEA_STACK: i64 = 121
pub let MIR_OP_LOAD_FLOAT_RIP: i64 = 122     // MOVSD xmm0,[rip+const]; store to slot
pub let MIR_OP_FLOAT_BINOP: i64 = 123        // SSE2 arithmetic/compare on float stack slots
pub let MIR_OP_INT_TO_FLOAT: i64 = 124       // CVTSI2SD: int stack slot → float stack slot
pub let MIR_OP_FLOAT_TO_INT: i64 = 125       // CVTTSD2SI: float stack slot → int stack slot
pub let MIR_OP_FLOAT_MOVE: i64 = 126         // float stack slot copy via xmm0

pub let MIR_OP_LOAD_ABS: i64 = 127           // mov rax,[rax] — load from absolute addr in temp
pub let MIR_OP_STORE_ABS: i64 = 128          // mov [rbx],rax — store to absolute addr

pub let MIR_OP_PSEUDO_LOAD_GLOBAL: i64 = 20
pub let MIR_OP_PSEUDO_STORE_GLOBAL: i64 = 21

pub let MIR_OP_PSEUDO_LOAD_FLOAT: i64 = 17
pub let MIR_OP_PSEUDO_INT_TO_FLOAT: i64 = 18
pub let MIR_OP_PSEUDO_FLOAT_TO_INT: i64 = 19

pub let MIR_CC_NONE: i64 = 0
pub let MIR_CC_Z: i64 = 1
pub let MIR_CC_NZ: i64 = 2
pub let MIR_CC_EQ: i64 = 3
pub let MIR_CC_NE: i64 = 4
pub let MIR_CC_LT: i64 = 5
pub let MIR_CC_LE: i64 = 6
pub let MIR_CC_GT: i64 = 7
pub let MIR_CC_GE: i64 = 8

pub struct MachineOperand {
    pub kind: i64,
    pub value: i64,
}

pub struct MachineInstr {
    pub opcode: i64,
    pub dst: MachineOperand,
    pub src1: MachineOperand,
    pub src2: MachineOperand,
    pub aux: MachineOperand,
    pub bin_op: BinaryOp,
    pub un_op: UnaryOp,
    pub cond: i64,
    pub arg_index: i64,
    pub name: Name,
    pub call_arg_values: [i64; 8],
    pub call_arg_count: i64,
}

pub struct MachineBlock {
    pub instrs: [MachineInstr; 4096],
    pub instr_count: i64,
}

pub struct MachineFunction {
    pub blocks: [MachineBlock; 1],
    pub block_count: i64,
    pub temp_count: i64,
    pub source_instr_count: i64,
    pub legal_instr_count: i64,
    pub base_slot_count: i64,
    pub supported: bool,
    pub unsupported_detail: string,
    pub is_float_slot: [i64; 2048],
}

pub struct NativeV2LegalizeSummary {
    pub supported: bool,
    pub unsupported_detail: string,
    pub source_instr_count: i64,
    pub pseudo_instr_count: i64,
    pub legal_instr_count: i64,
}

pub struct MachineFunctionTable {
    pub entries: [MachineFunction; 32],
}

pub struct MachineModule {
    pub functions: *mut MachineFunctionTable,
    pub fn_count: i64,
    pub total_ir_instr_count: i64,
    pub total_machine_instr_count: i64,
    pub active: bool,
    pub fail_closed: bool,
    pub legacy_fallback: bool,
    pub coverage: string,
    pub targets: [Name; 4],
    pub target_count: i64,
    pub supported: bool,
    pub unsupported_detail: string,
}

pub fn machine_operand_none() -> MachineOperand with Mut, Panic, Div {
    MachineOperand { kind: MIR_OPERAND_NONE, value: 0 }
}

pub fn machine_operand_gpr64(vreg: i64) -> MachineOperand with Mut, Panic, Div {
    MachineOperand { kind: MIR_OPERAND_GPR64, value: vreg }
}

pub fn machine_operand_stack_slot(slot: i64) -> MachineOperand with Mut, Panic, Div {
    MachineOperand { kind: MIR_OPERAND_STACK_SLOT, value: slot }
}

pub fn machine_operand_imm64(value: i64) -> MachineOperand with Mut, Panic, Div {
    MachineOperand { kind: MIR_OPERAND_IMM64, value: value }
}

pub fn machine_operand_label(label_id: i64) -> MachineOperand with Mut, Panic, Div {
    MachineOperand { kind: MIR_OPERAND_LABEL, value: label_id }
}

pub fn machine_operand_call_target(fn_id: i64) -> MachineOperand with Mut, Panic, Div {
    MachineOperand { kind: MIR_OPERAND_CALL_TARGET, value: fn_id }
}

pub fn machine_operand_data_ref(value: i64) -> MachineOperand with Mut, Panic, Div {
    MachineOperand { kind: MIR_OPERAND_DATA_REF, value: value }
}

pub fn machine_operand_flags(value: i64) -> MachineOperand with Mut, Panic, Div {
    MachineOperand { kind: MIR_OPERAND_FLAGS, value: value }
}

pub fn machine_operand_value(op: MachineOperand) -> i64 {
    op.value
}

pub fn machine_instr_dst_value(instr: MachineInstr) -> i64 {
    instr.dst.value
}

pub fn machine_instr_src1_value(instr: MachineInstr) -> i64 {
    instr.src1.value
}

pub fn machine_instr_src2_value(instr: MachineInstr) -> i64 {
    instr.src2.value
}

pub fn machine_instr_aux_value(instr: MachineInstr) -> i64 {
    instr.aux.value
}

pub fn machine_instr_src1_kind(instr: MachineInstr) -> i64 {
    instr.src1.kind
}

pub fn machine_instr_name(instr: MachineInstr) -> Name {
    instr.name
}

pub fn machine_instr_bin_op(instr: MachineInstr) -> BinaryOp {
    instr.bin_op
}

pub fn machine_instr_un_op(instr: MachineInstr) -> UnaryOp {
    instr.un_op
}

pub fn machine_instr_call_arg_count(instr: MachineInstr) -> i64 {
    instr.call_arg_count
}

pub fn machine_instr_call_arg_value(instr: MachineInstr, idx: i64) -> i64 {
    instr.call_arg_values[idx as usize]
}

pub fn machine_empty_instr() -> MachineInstr with Mut, Panic, Div {
    MachineInstr {
        opcode: MIR_OP_NOP,
        dst: machine_operand_none(),
        src1: machine_operand_none(),
        src2: machine_operand_none(),
        aux: machine_operand_none(),
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        cond: MIR_CC_NONE,
        arg_index: -1,
        name: empty_name(),
        call_arg_values: [0; 8],
        call_arg_count: 0,
    }
}

pub fn machine_block_new() -> MachineBlock with Mut, Panic, Div {
    MachineBlock {
        instrs: [machine_empty_instr(); 4096],
        instr_count: 0,
    }
}

pub fn machine_function_new() -> MachineFunction with Mut, Panic, Div {
    MachineFunction {
        blocks: [machine_block_new(); 1],
        block_count: 1,
        temp_count: 0,
        source_instr_count: 0,
        legal_instr_count: 0,
        base_slot_count: 0,
        supported: true,
        unsupported_detail: "",
        is_float_slot: [0; 2048],
    }
}

pub fn native_v2_legalize_summary_new() -> NativeV2LegalizeSummary with Mut, Panic, Div {
    NativeV2LegalizeSummary {
        supported: true,
        unsupported_detail: "",
        source_instr_count: 0,
        pseudo_instr_count: 0,
        legal_instr_count: 0,
    }
}

fn machine_function_table_alloc() -> *mut MachineFunctionTable with Alloc {
    heap_alloc(67108864) as *mut MachineFunctionTable
}

pub fn machine_module_function_get(module: &MachineModule, idx: i64) -> MachineFunction with Mut, Panic, Div {
    if idx < 0 || idx >= 32 || (*module).functions == (0 as *mut MachineFunctionTable) {
        return machine_function_new()
    }
    (*(*module).functions).entries[idx as usize]
}

pub fn machine_module_function_set(module: &! MachineModule, idx: i64, func: MachineFunction) with Mut, Panic, Div {
    if idx < 0 || idx >= 32 || (*module).functions == (0 as *mut MachineFunctionTable) {
        return
    }
    (*(*module).functions).entries[idx as usize] = func
}

pub fn machine_module_new() -> MachineModule with Mut, Panic, Div, Alloc {
    MachineModule {
        functions: machine_function_table_alloc(),
        fn_count: 0,
        total_ir_instr_count: 0,
        total_machine_instr_count: 0,
        active: false,
        fail_closed: true,
        legacy_fallback: false,
        coverage: "scalar_core",
        targets: [empty_name(); 4],
        target_count: 0,
        supported: true,
        unsupported_detail: "",
    }
}

pub fn machine_function_add_instr_mut(func: &! MachineFunction, instr: MachineInstr) with Mut, Panic, Div {
    if (*func).blocks[0].instr_count < MIR_MAX_INSTRS {
        var block = (*func).blocks[0]
        let idx = block.instr_count
        block.instrs[idx as usize] = instr
        block.instr_count = idx + 1
        (*func).blocks[0] = block
    } else {
        // Fail closed: never silently drop ret / tail (was silent miscompile wall).
        (*func).supported = false
        (*func).unsupported_detail = "mir_instr_capacity"
    }
}

pub fn machine_function_add_instr(func: MachineFunction, instr: MachineInstr) -> MachineFunction with Mut, Panic, Div {
    var f = func
    machine_function_add_instr_mut(&! f, instr)
    f
}

pub fn machine_function_next_temp_mut(func: &! MachineFunction) -> i64 with Mut {
    let id = (*func).temp_count
    (*func).temp_count = id + 1
    id
}

pub fn machine_function_next_temp(func: MachineFunction) -> (MachineFunction, i64) with Mut {
    var f = func
    let id = machine_function_next_temp_mut(&! f)
    (f, id)
}

pub fn native_v2_supported_ir_opcode(op: IrOpcode) -> bool with Mut, Panic, Div {
    if op == IrOpcode::IrLoadImm { return true }
    if op == IrOpcode::IrLoadBool { return true }
    if op == IrOpcode::IrLoadString { return true }
    if op == IrOpcode::IrCopy { return true }
    if op == IrOpcode::IrBinOp { return true }
    if op == IrOpcode::IrUnaryOp { return true }
    if op == IrOpcode::IrCall { return true }
    if op == IrOpcode::IrReturn { return true }
    if op == IrOpcode::IrJump { return true }
    if op == IrOpcode::IrBranchTrue { return true }
    if op == IrOpcode::IrBranchFalse { return true }
    if op == IrOpcode::IrFieldGet { return true }
    if op == IrOpcode::IrFieldSet { return true }
    if op == IrOpcode::IrIndexGet { return true }
    if op == IrOpcode::IrIndexSet { return true }
    if op == IrOpcode::IrAlloc { return true }
    if op == IrOpcode::IrLabel { return true }
    if op == IrOpcode::IrNop { return true }
    if op == IrOpcode::IrLoadFloat { return true }
    if op == IrOpcode::IrIntToFloat { return true }
    if op == IrOpcode::IrFloatToInt { return true }
    if op == IrOpcode::IrLoadGlobal { return true }
    if op == IrOpcode::IrStoreGlobal { return true }
    false
}

