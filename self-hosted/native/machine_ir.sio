pub fn native_v2_legalize_summary_from_machine(func: MachineFunction) -> NativeV2LegalizeSummary with Mut, Panic, Div {
    var out = native_v2_legalize_summary_new()
    out.source_instr_count = func.source_instr_count
    out.pseudo_instr_count = func.blocks[0].instr_count
    if !func.supported {
        out.supported = false
        out.unsupported_detail = func.unsupported_detail
        return out
    }

    if func.base_slot_count > MIR_MAX_FLOAT_SLOTS || func.temp_count > MIR_MAX_FLOAT_SLOTS {
        out.supported = false
        out.unsupported_detail = "float_slot_capacity"
        return out
    }

    var is_float_slot: [i64; 2048] = [0; 2048]
    var i: i64 = 0
    while i < func.blocks[0].instr_count {
        let instr = func.blocks[0].instrs[i as usize]

        if instr.opcode == MIR_OP_PSEUDO_LOAD_IMM {
            out.legal_instr_count = out.legal_instr_count + 2
        } else if instr.opcode == MIR_OP_PSEUDO_LOAD_STRING {
            out.legal_instr_count = out.legal_instr_count + 2
        } else if instr.opcode == MIR_OP_PSEUDO_COPY {
            let src_slot = machine_instr_src1_value(instr)
            let dst_slot = machine_instr_dst_value(instr)
            let src_is_float = if src_slot >= 0 && src_slot < MIR_MAX_FLOAT_SLOTS { is_float_slot[src_slot as usize] } else { 0 }
            if src_is_float == 1 {
                out.legal_instr_count = out.legal_instr_count + 1
                if dst_slot >= 0 && dst_slot < MIR_MAX_FLOAT_SLOTS {
                    is_float_slot[dst_slot as usize] = 1
                }
            } else {
                out.legal_instr_count = out.legal_instr_count + 2
            }
        } else if instr.opcode == MIR_OP_PSEUDO_BINOP {
            let s1 = machine_instr_src1_value(instr)
            let s2 = machine_instr_src2_value(instr)
            let s1f = if s1 >= 0 && s1 < MIR_MAX_FLOAT_SLOTS { is_float_slot[s1 as usize] } else { 0 }
            let s2f = if s2 >= 0 && s2 < MIR_MAX_FLOAT_SLOTS { is_float_slot[s2 as usize] } else { 0 }
            if s1f == 1 || s2f == 1 {
                out.legal_instr_count = out.legal_instr_count + 1
                let dslot = machine_instr_dst_value(instr)
                if dslot >= 0 && dslot < MIR_MAX_FLOAT_SLOTS {
                    if machine_instr_bin_op(instr) == BinaryOp::OpAdd || machine_instr_bin_op(instr) == BinaryOp::OpSub || machine_instr_bin_op(instr) == BinaryOp::OpMul || machine_instr_bin_op(instr) == BinaryOp::OpDiv {
                        is_float_slot[dslot as usize] = 1
                    }
                }
            } else {
                out.legal_instr_count = out.legal_instr_count + 4
            }
        } else if instr.opcode == MIR_OP_PSEUDO_UNARY {
            if machine_instr_un_op(instr) == UnaryOp::OpRef || machine_instr_un_op(instr) == UnaryOp::OpRefMut {
                out.legal_instr_count = out.legal_instr_count + 2
            } else {
                out.legal_instr_count = out.legal_instr_count + 3
            }
        } else if instr.opcode == MIR_OP_PSEUDO_CALL {
            if machine_instr_call_arg_count(instr) > 6 {
                out.supported = false
                out.unsupported_detail = "call_arity_gt_6"
                return out
            }
            out.legal_instr_count = out.legal_instr_count + 1 + (machine_instr_call_arg_count(instr) * 2)
            if machine_instr_dst_value(instr) >= 0 {
                out.legal_instr_count = out.legal_instr_count + 2
            }
        } else if instr.opcode == MIR_OP_PSEUDO_RET {
            if machine_instr_src1_kind(instr) == MIR_OPERAND_STACK_SLOT {
                out.legal_instr_count = out.legal_instr_count + 2
            } else {
                out.legal_instr_count = out.legal_instr_count + 1
            }
        } else if instr.opcode == MIR_OP_PSEUDO_JUMP {
            out.legal_instr_count = out.legal_instr_count + 1
        } else if instr.opcode == MIR_OP_PSEUDO_BRANCH_TRUE {
            out.legal_instr_count = out.legal_instr_count + 3
        } else if instr.opcode == MIR_OP_PSEUDO_BRANCH_FALSE {
            out.legal_instr_count = out.legal_instr_count + 3
        } else if instr.opcode == MIR_OP_PSEUDO_LABEL {
            out.legal_instr_count = out.legal_instr_count + 1
        } else if instr.opcode == MIR_OP_PSEUDO_ALLOC {
            out.legal_instr_count = out.legal_instr_count + 2
        } else if instr.opcode == MIR_OP_PSEUDO_FIELD_GET {
            out.legal_instr_count = out.legal_instr_count + 3
        } else if instr.opcode == MIR_OP_PSEUDO_FIELD_SET {
            out.legal_instr_count = out.legal_instr_count + 3
        } else if instr.opcode == MIR_OP_PSEUDO_INDEX_GET {
            out.legal_instr_count = out.legal_instr_count + 4
        } else if instr.opcode == MIR_OP_PSEUDO_INDEX_SET {
            out.legal_instr_count = out.legal_instr_count + 4
        } else if instr.opcode == MIR_OP_PSEUDO_LOAD_FLOAT {
            out.legal_instr_count = out.legal_instr_count + 1
            if machine_instr_dst_value(instr) >= 0 && machine_instr_dst_value(instr) < MIR_MAX_FLOAT_SLOTS {
                is_float_slot[machine_instr_dst_value(instr) as usize] = 1
            }
        } else if instr.opcode == MIR_OP_PSEUDO_INT_TO_FLOAT {
            out.legal_instr_count = out.legal_instr_count + 1
            if machine_instr_dst_value(instr) >= 0 && machine_instr_dst_value(instr) < MIR_MAX_FLOAT_SLOTS {
                is_float_slot[machine_instr_dst_value(instr) as usize] = 1
            }
        } else if instr.opcode == MIR_OP_PSEUDO_FLOAT_TO_INT {
            out.legal_instr_count = out.legal_instr_count + 1
            if machine_instr_dst_value(instr) >= 0 && machine_instr_dst_value(instr) < MIR_MAX_FLOAT_SLOTS {
                is_float_slot[machine_instr_dst_value(instr) as usize] = 0
            }
        } else {
            out.supported = false
            out.unsupported_detail = "unknown_pseudo_opcode"
            return out
        }
        i = i + 1
    }

    out
}

pub fn native_v2_legalize_ir_summary_ref(func: &IrFunction) -> NativeV2LegalizeSummary with Mut, Panic, Div {
    var out = native_v2_legalize_summary_new()
    out.source_instr_count = (*func).instr_count
    if (*func).reg_count > MIR_MAX_FLOAT_SLOTS {
        out.supported = false
        out.unsupported_detail = "float_slot_capacity"
        return out
    }

    var is_float_slot: [i64; 2048] = [0; 2048]
    // #1669: seed from the function-scoped bits, then keep the in-stream
    // marker arm. Union during the soak: the bits are the durable channel, the
    // markers are the legacy one, and any disagreement is caught rather than
    // guessed. Strictly a superset of today's information.
    var sfb: i64 = 0
    while sfb < ir_float_bits_capacity() && sfb < MIR_MAX_FLOAT_SLOTS && IR_FLOAT_BITS_TRUSTED == 1 {
        if ir_float_bits_get(func, sfb) { is_float_slot[sfb as usize] = 1 }
        sfb = sfb + 1
    }
    var i: i64 = 0
    while i < (*func).instr_count {
        let instr = ir_arena_load(ir_region_slot_r((*func).region, (i)))
        if instr.op == IrOpcode::IrNop {
            // #1669 EXPERIMENT SWITCH, diagnostic only. Suppressing the marker
            // arm is how we test whether the function-scoped bits are a real
            // channel or decoration -- if the f64 still comes out right with
            // markers off, the bits carried it.
            if instr.imm_flags == IR_FLOAT_REG_MARKER_FLAG && instr.dst >= 0 && instr.dst < MIR_MAX_FLOAT_SLOTS
                && IR_FLOAT_NO_MARKERS == 0 {
                is_float_slot[instr.dst as usize] = 1
            }
            i = i + 1
            continue
        }
        if !native_v2_supported_ir_opcode(instr.op) {
            out.supported = false
            out.unsupported_detail = native_v2_ir_opcode_name(instr.op)
            return out
        }

        out.pseudo_instr_count = out.pseudo_instr_count + 1
        if instr.op == IrOpcode::IrLoadImm || instr.op == IrOpcode::IrLoadBool {
            out.legal_instr_count = out.legal_instr_count + 2
        } else if instr.op == IrOpcode::IrLoadString {
            out.legal_instr_count = out.legal_instr_count + 2
        } else if instr.op == IrOpcode::IrCopy {
            let src_slot = instr.src1
            let dst_slot = instr.dst
            let src_is_float = if src_slot >= 0 && src_slot < MIR_MAX_FLOAT_SLOTS { is_float_slot[src_slot as usize] } else { 0 }
            if src_is_float == 1 {
                out.legal_instr_count = out.legal_instr_count + 1
                if dst_slot >= 0 && dst_slot < MIR_MAX_FLOAT_SLOTS {
                    is_float_slot[dst_slot as usize] = 1
                }
            } else {
                out.legal_instr_count = out.legal_instr_count + 2
            }
        } else if instr.op == IrOpcode::IrBinOp {
            let s1 = instr.src1
            let s2 = instr.src2
            let s1f = if s1 >= 0 && s1 < MIR_MAX_FLOAT_SLOTS { is_float_slot[s1 as usize] } else { 0 }
            let s2f = if s2 >= 0 && s2 < MIR_MAX_FLOAT_SLOTS { is_float_slot[s2 as usize] } else { 0 }
            let s1f_marked = (instr.imm_flags / 2) & 1
            let s2f_marked = (instr.imm_flags / 4) & 1
            if s1f == 1 || s2f == 1 || s1f_marked == 1 || s2f_marked == 1 {
                out.legal_instr_count = out.legal_instr_count + 1
                if instr.dst >= 0 && instr.dst < MIR_MAX_FLOAT_SLOTS {
                    if instr.bin_op == BinaryOp::OpAdd || instr.bin_op == BinaryOp::OpSub || instr.bin_op == BinaryOp::OpMul || instr.bin_op == BinaryOp::OpDiv {
                        is_float_slot[instr.dst as usize] = 1
                    }
                }
            } else {
                out.legal_instr_count = out.legal_instr_count + 4
            }
        } else if instr.op == IrOpcode::IrUnaryOp {
            if instr.un_op == UnaryOp::OpRef || instr.un_op == UnaryOp::OpRefMut {
                out.legal_instr_count = out.legal_instr_count + 2
            } else {
                out.legal_instr_count = out.legal_instr_count + 3
            }
        } else if instr.op == IrOpcode::IrCall {
            if instr.arg_count > 6 {
                out.supported = false
                out.unsupported_detail = "call_arity_gt_6"
                return out
            }
            out.legal_instr_count = out.legal_instr_count + 1 + (instr.arg_count * 2)
            if instr.dst >= 0 {
                out.legal_instr_count = out.legal_instr_count + 2
            }
        } else if instr.op == IrOpcode::IrReturn {
            if instr.src1 >= 0 {
                out.legal_instr_count = out.legal_instr_count + 2
            } else {
                out.legal_instr_count = out.legal_instr_count + 1
            }
        } else if instr.op == IrOpcode::IrJump {
            out.legal_instr_count = out.legal_instr_count + 1
        } else if instr.op == IrOpcode::IrBranchTrue {
            out.legal_instr_count = out.legal_instr_count + 3
        } else if instr.op == IrOpcode::IrBranchFalse {
            out.legal_instr_count = out.legal_instr_count + 3
        } else if instr.op == IrOpcode::IrLabel {
            out.legal_instr_count = out.legal_instr_count + 1
        } else if instr.op == IrOpcode::IrAlloc {
            out.legal_instr_count = out.legal_instr_count + 2
        } else if instr.op == IrOpcode::IrFieldGet {
            out.legal_instr_count = out.legal_instr_count + 3
        } else if instr.op == IrOpcode::IrFieldSet {
            out.legal_instr_count = out.legal_instr_count + 3
        } else if instr.op == IrOpcode::IrIndexGet {
            out.legal_instr_count = out.legal_instr_count + 4
        } else if instr.op == IrOpcode::IrIndexSet {
            out.legal_instr_count = out.legal_instr_count + 4
        } else if instr.op == IrOpcode::IrLoadFloat {
            out.legal_instr_count = out.legal_instr_count + 1
            if instr.dst >= 0 && instr.dst < MIR_MAX_FLOAT_SLOTS {
                is_float_slot[instr.dst as usize] = 1
            }
        } else if instr.op == IrOpcode::IrIntToFloat {
            out.legal_instr_count = out.legal_instr_count + 1
            if instr.dst >= 0 && instr.dst < MIR_MAX_FLOAT_SLOTS {
                is_float_slot[instr.dst as usize] = 1
            }
        } else if instr.op == IrOpcode::IrFloatToInt {
            out.legal_instr_count = out.legal_instr_count + 1
            if instr.dst >= 0 && instr.dst < MIR_MAX_FLOAT_SLOTS {
                is_float_slot[instr.dst as usize] = 0
            }
        } else {
            out.supported = false
            out.unsupported_detail = "unknown_ir_opcode"
            return out
        }
        i = i + 1
    }

    out
}

pub fn native_v2_legalize_ir_summary(func: IrFunction) -> NativeV2LegalizeSummary with Mut, Panic, Div {
    native_v2_legalize_ir_summary_ref(&func)
}

fn native_v2_reset_machine_function_out(out: &! MachineFunction, base_slots: i64, source_count: i64) with Mut, Panic, Div {
    (*out).blocks[0].instr_count = 0
    (*out).block_count = 1
    (*out).temp_count = base_slots
    (*out).source_instr_count = source_count
    (*out).legal_instr_count = 0
    (*out).base_slot_count = base_slots
    (*out).supported = true
    (*out).unsupported_detail = ""
    var i: i64 = 0
    while i < MIR_MAX_FLOAT_SLOTS {
        (*out).is_float_slot[i as usize] = 0
        i = i + 1
    }
}

pub fn native_v2_lower_legal_function_from_ir_ref(func: &IrFunction, out: &! MachineFunction) with Mut, Panic, Div, Alloc {
    native_v2_reset_machine_function_out(out, (*func).reg_count, (*func).instr_count)
    // Fail closed when IR vregs exceed the float-typing table (was silent wrong SSE/int mix).
    if (*func).reg_count > MIR_MAX_FLOAT_SLOTS {
        (*out).supported = false
        (*out).unsupported_detail = "float_slot_capacity"
        return
    }

    var i: i64 = 0
    while i < (*func).instr_count {
        let ir_instr = ir_arena_load(ir_region_slot_r((*func).region, (i)))
        if ir_instr.op == IrOpcode::IrNop {
            if ir_instr.imm_flags == IR_FLOAT_REG_MARKER_FLAG && ir_instr.dst >= 0 && ir_instr.dst < MIR_MAX_FLOAT_SLOTS {
                (*out).is_float_slot[ir_instr.dst as usize] = 1
            }
            i = i + 1
            continue
        }
        if !native_v2_supported_ir_opcode(ir_instr.op) {
            (*out).supported = false
            (*out).unsupported_detail = native_v2_ir_opcode_name(ir_instr.op)
            return
        }
        let instr = native_v2_pseudo_from_ir(ir_instr)

        if instr.opcode == MIR_OP_PSEUDO_LOAD_IMM {
            let temp = (*out).temp_count
            (*out).temp_count = temp + 1
            native_v2_emit_legal_instr_mut(out, native_v2_make_mov_imm(temp, machine_instr_src1_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
        } else if instr.opcode == MIR_OP_PSEUDO_LOAD_STRING {
            let temp = (*out).temp_count
            (*out).temp_count = temp + 1
            let load = native_v2_make_load_data_addr(temp, machine_instr_name(instr))
            native_v2_emit_legal_instr_mut(out, load)
            native_v2_emit_legal_instr_mut(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
        } else if instr.opcode == MIR_OP_PSEUDO_COPY {
            let src_slot = machine_instr_src1_value(instr)
            let dst_slot = machine_instr_dst_value(instr)
            let src_is_float = if src_slot >= 0 && src_slot < MIR_MAX_FLOAT_SLOTS { (*out).is_float_slot[src_slot as usize] } else { 0 }
            if src_is_float == 1 {
                native_v2_emit_legal_instr_mut(out, native_v2_make_float_move(dst_slot, src_slot))
                if dst_slot >= 0 && dst_slot < MIR_MAX_FLOAT_SLOTS {
                    (*out).is_float_slot[dst_slot as usize] = 1
                }
            } else {
                let temp = (*out).temp_count
                (*out).temp_count = temp + 1
                native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
                native_v2_emit_legal_instr_mut(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
            }
        } else if instr.opcode == MIR_OP_PSEUDO_BINOP {
            let s1 = machine_instr_src1_value(instr)
            let s2 = machine_instr_src2_value(instr)
            let s1f = if s1 >= 0 && s1 < MIR_MAX_FLOAT_SLOTS { (*out).is_float_slot[s1 as usize] } else { 0 }
            let s2f = if s2 >= 0 && s2 < MIR_MAX_FLOAT_SLOTS { (*out).is_float_slot[s2 as usize] } else { 0 }
            let s1f_marked = (IR_A_IMM_FLAGS[(ir_region_slot_r((*func).region, (i))) as usize] / 2) & 1
            let s2f_marked = (IR_A_IMM_FLAGS[(ir_region_slot_r((*func).region, (i))) as usize] / 4) & 1
            let lhs_float = if s1f == 1 || s1f_marked == 1 { 1 } else { 0 }
            let rhs_float = if s2f == 1 || s2f_marked == 1 { 1 } else { 0 }
            if lhs_float == 1 || rhs_float == 1 {
                native_v2_emit_legal_instr_mut(out, native_v2_make_float_binop(machine_instr_dst_value(instr), s1, s2, machine_instr_bin_op(instr), lhs_float, rhs_float))
                let dslot = machine_instr_dst_value(instr)
                if dslot >= 0 && dslot < MIR_MAX_FLOAT_SLOTS {
                    if machine_instr_bin_op(instr) == BinaryOp::OpAdd || machine_instr_bin_op(instr) == BinaryOp::OpSub || machine_instr_bin_op(instr) == BinaryOp::OpMul || machine_instr_bin_op(instr) == BinaryOp::OpDiv {
                        (*out).is_float_slot[dslot as usize] = 1
                    }
                }
            } else {
                let lhs = (*out).temp_count
                (*out).temp_count = lhs + 1
                let rhs = (*out).temp_count
                (*out).temp_count = rhs + 1
                native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(lhs, machine_instr_src1_value(instr)))
                native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(rhs, machine_instr_src2_value(instr)))
                native_v2_emit_legal_instr_mut(out, native_v2_make_binop(lhs, rhs, machine_instr_bin_op(instr)))
                native_v2_emit_legal_instr_mut(out, native_v2_make_store_stack(machine_instr_dst_value(instr), lhs))
            }
        } else if instr.opcode == MIR_OP_PSEUDO_UNARY {
            let temp = (*out).temp_count
            (*out).temp_count = temp + 1
            if machine_instr_un_op(instr) == UnaryOp::OpRef || machine_instr_un_op(instr) == UnaryOp::OpRefMut {
                native_v2_emit_legal_instr_mut(out, native_v2_make_lea_stack(temp, machine_instr_src1_value(instr)))
            } else {
                native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
                native_v2_emit_legal_instr_mut(out, native_v2_make_unary(temp, temp, machine_instr_un_op(instr)))
            }
            native_v2_emit_legal_instr_mut(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
        } else if instr.opcode == MIR_OP_PSEUDO_CALL {
            if machine_instr_call_arg_count(instr) > 6 {
                (*out).supported = false
                (*out).unsupported_detail = "call_arity_gt_6"
                return
            }
            var ai: i64 = 0
            while ai < machine_instr_call_arg_count(instr) {
                let temp = (*out).temp_count
                (*out).temp_count = temp + 1
                native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(temp, machine_instr_call_arg_value(instr, ai)))
                native_v2_emit_legal_instr_mut(out, native_v2_make_arg_move(ai, temp))
                ai = ai + 1
            }
            native_v2_emit_legal_instr_mut(out, native_v2_make_call(machine_instr_src1_value(instr)))
            if machine_instr_dst_value(instr) >= 0 {
                let temp = (*out).temp_count
                (*out).temp_count = temp + 1
                native_v2_emit_legal_instr_mut(out, native_v2_make_capture_ret(temp))
                native_v2_emit_legal_instr_mut(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
            }
        } else if instr.opcode == MIR_OP_PSEUDO_RET {
            if machine_instr_src1_kind(instr) == MIR_OPERAND_STACK_SLOT {
                let temp = (*out).temp_count
                (*out).temp_count = temp + 1
                native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
                native_v2_emit_legal_instr_mut(out, native_v2_make_ret(temp))
            } else {
                native_v2_emit_legal_instr_mut(out, native_v2_make_ret(0 - 1))
            }
        } else if instr.opcode == MIR_OP_PSEUDO_JUMP {
            native_v2_emit_legal_instr_mut(out, native_v2_make_jump(machine_instr_dst_value(instr)))
        } else if instr.opcode == MIR_OP_PSEUDO_BRANCH_TRUE {
            let temp = (*out).temp_count
            (*out).temp_count = temp + 1
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_cmp_zero(temp))
            native_v2_emit_legal_instr_mut(out, native_v2_make_jcc(machine_instr_dst_value(instr), MIR_CC_NZ))
        } else if instr.opcode == MIR_OP_PSEUDO_BRANCH_FALSE {
            let temp = (*out).temp_count
            (*out).temp_count = temp + 1
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_cmp_zero(temp))
            native_v2_emit_legal_instr_mut(out, native_v2_make_jcc(machine_instr_dst_value(instr), MIR_CC_Z))
        } else if instr.opcode == MIR_OP_PSEUDO_LABEL {
            native_v2_emit_legal_instr_mut(out, native_v2_make_label(machine_instr_dst_value(instr)))
        } else if instr.opcode == MIR_OP_PSEUDO_ALLOC {
            let temp = (*out).temp_count
            (*out).temp_count = temp + 1
            native_v2_emit_legal_instr_mut(out, native_v2_make_alloc(temp, native_v2_alloc_size_from_tag(machine_instr_src1_value(instr)), native_v2_alloc_descriptor_from_tag(machine_instr_src1_value(instr))))
            native_v2_emit_legal_instr_mut(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
        } else if instr.opcode == MIR_OP_PSEUDO_FIELD_GET {
            let base = (*out).temp_count
            (*out).temp_count = base + 1
            let dst = (*out).temp_count
            (*out).temp_count = dst + 1
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(base, machine_instr_src1_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_field_load(dst, base, machine_instr_aux_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_store_stack(machine_instr_dst_value(instr), dst))
        } else if instr.opcode == MIR_OP_PSEUDO_FIELD_SET {
            let base = (*out).temp_count
            (*out).temp_count = base + 1
            let src = (*out).temp_count
            (*out).temp_count = src + 1
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(base, machine_instr_src1_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(src, machine_instr_src2_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_field_store(base, src, machine_instr_aux_value(instr)))
        } else if instr.opcode == MIR_OP_PSEUDO_INDEX_GET {
            let base = (*out).temp_count
            (*out).temp_count = base + 1
            let idx = (*out).temp_count
            (*out).temp_count = idx + 1
            let dst = (*out).temp_count
            (*out).temp_count = dst + 1
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(base, machine_instr_src1_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(idx, machine_instr_src2_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_index_load(dst, base, idx))
            native_v2_emit_legal_instr_mut(out, native_v2_make_store_stack(machine_instr_dst_value(instr), dst))
        } else if instr.opcode == MIR_OP_PSEUDO_INDEX_SET {
            let base = (*out).temp_count
            (*out).temp_count = base + 1
            let idx = (*out).temp_count
            (*out).temp_count = idx + 1
            let src = (*out).temp_count
            (*out).temp_count = src + 1
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(base, machine_instr_src1_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(idx, machine_instr_src2_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(src, machine_instr_aux_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_index_store(base, idx, src))
        } else if instr.opcode == MIR_OP_PSEUDO_LOAD_FLOAT {
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_float_rip(machine_instr_dst_value(instr), machine_instr_src1_value(instr)))
            if machine_instr_dst_value(instr) >= 0 && machine_instr_dst_value(instr) < MIR_MAX_FLOAT_SLOTS {
                (*out).is_float_slot[machine_instr_dst_value(instr) as usize] = 1
            }
        } else if instr.opcode == MIR_OP_PSEUDO_INT_TO_FLOAT {
            native_v2_emit_legal_instr_mut(out, native_v2_make_int_to_float(machine_instr_dst_value(instr), machine_instr_src1_value(instr)))
            if machine_instr_dst_value(instr) >= 0 && machine_instr_dst_value(instr) < MIR_MAX_FLOAT_SLOTS {
                (*out).is_float_slot[machine_instr_dst_value(instr) as usize] = 1
            }
        } else if instr.opcode == MIR_OP_PSEUDO_FLOAT_TO_INT {
            native_v2_emit_legal_instr_mut(out, native_v2_make_float_to_int(machine_instr_dst_value(instr), machine_instr_src1_value(instr)))
            if machine_instr_dst_value(instr) >= 0 && machine_instr_dst_value(instr) < MIR_MAX_FLOAT_SLOTS {
                (*out).is_float_slot[machine_instr_dst_value(instr) as usize] = 0
            }
        }
        i = i + 1
    }

    if (*out).legal_instr_count <= 0 {
        (*out).legal_instr_count = (*out).blocks[0].instr_count
    }
}

pub fn native_v2_legalize_function(func: MachineFunction) -> MachineFunction with Mut, Panic, Div {
    var out = machine_function_new()
    out.base_slot_count = func.base_slot_count
    out.temp_count = func.base_slot_count
    out.source_instr_count = func.source_instr_count
    if !func.supported {
        out.supported = false
        out.unsupported_detail = func.unsupported_detail
        return out
    }
    if func.base_slot_count > MIR_MAX_FLOAT_SLOTS || func.temp_count > MIR_MAX_FLOAT_SLOTS {
        out.supported = false
        out.unsupported_detail = "float_slot_capacity"
        return out
    }

    var i: i64 = 0
    while i < func.blocks[0].instr_count {
        let instr = func.blocks[0].instrs[i as usize]

        if instr.opcode == MIR_OP_PSEUDO_LOAD_IMM {
            let temp = out.temp_count
            out.temp_count = temp + 1
            out = _emit_legal_byval(out, native_v2_make_mov_imm(temp, machine_instr_src1_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
        } else if instr.opcode == MIR_OP_PSEUDO_LOAD_STRING {
            let temp = out.temp_count
            out.temp_count = temp + 1
            let load = native_v2_make_load_data_addr(temp, machine_instr_name(instr))
            out = _emit_legal_byval(out, load)
            out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
        } else if instr.opcode == MIR_OP_PSEUDO_COPY {
            // Sprint 87: propagate float-ness for COPY
            let src_slot = machine_instr_src1_value(instr)
            let dst_slot = machine_instr_dst_value(instr)
            let src_is_float = if src_slot >= 0 && src_slot < MIR_MAX_FLOAT_SLOTS { out.is_float_slot[src_slot as usize] } else { 0 }
            if src_is_float == 1 {
                out = _emit_legal_byval(out, native_v2_make_float_move(dst_slot, src_slot))
                if dst_slot >= 0 && dst_slot < MIR_MAX_FLOAT_SLOTS {
                    out.is_float_slot[dst_slot as usize] = 1
                }
            } else {
                let temp = out.temp_count
                out.temp_count = temp + 1
                out = _emit_legal_byval(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
                out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
            }
        } else if instr.opcode == MIR_OP_PSEUDO_BINOP {
            // Sprint 87: check if either operand is a float slot → emit FLOAT_BINOP
            let s1 = machine_instr_src1_value(instr)
            let s2 = machine_instr_src2_value(instr)
            let s1f = if s1 >= 0 && s1 < MIR_MAX_FLOAT_SLOTS { out.is_float_slot[s1 as usize] } else { 0 }
            let s2f = if s2 >= 0 && s2 < MIR_MAX_FLOAT_SLOTS { out.is_float_slot[s2 as usize] } else { 0 }
            if s1f == 1 || s2f == 1 {
                out = _emit_legal_byval(out, native_v2_make_float_binop(machine_instr_dst_value(instr), s1, s2, machine_instr_bin_op(instr), s1f, s2f))
                let dslot = machine_instr_dst_value(instr)
                if dslot >= 0 && dslot < MIR_MAX_FLOAT_SLOTS {
                    if machine_instr_bin_op(instr) == BinaryOp::OpAdd || machine_instr_bin_op(instr) == BinaryOp::OpSub || machine_instr_bin_op(instr) == BinaryOp::OpMul || machine_instr_bin_op(instr) == BinaryOp::OpDiv {
                        out.is_float_slot[dslot as usize] = 1
                    }
                }
            } else {
                let lhs = out.temp_count
                out.temp_count = lhs + 1
                let rhs = out.temp_count
                out.temp_count = rhs + 1
                out = _emit_legal_byval(out, native_v2_make_load_stack(lhs, machine_instr_src1_value(instr)))
                out = _emit_legal_byval(out, native_v2_make_load_stack(rhs, machine_instr_src2_value(instr)))
                out = _emit_legal_byval(out, native_v2_make_binop(lhs, rhs, machine_instr_bin_op(instr)))
                out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), lhs))
            }
        } else if instr.opcode == MIR_OP_PSEUDO_UNARY {
            let temp = out.temp_count
            out.temp_count = temp + 1
            if machine_instr_un_op(instr) == UnaryOp::OpRef || machine_instr_un_op(instr) == UnaryOp::OpRefMut {
                out = _emit_legal_byval(out, native_v2_make_lea_stack(temp, machine_instr_src1_value(instr)))
            } else {
                out = _emit_legal_byval(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
                out = _emit_legal_byval(out, native_v2_make_unary(temp, temp, machine_instr_un_op(instr)))
            }
            out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
        } else if instr.opcode == MIR_OP_PSEUDO_CALL {
            if machine_instr_call_arg_count(instr) > 6 {
                out.supported = false
                out.unsupported_detail = "call_arity_gt_6"
                return out
            }
            var ai: i64 = 0
            while ai < machine_instr_call_arg_count(instr) {
                let temp = out.temp_count
                out.temp_count = temp + 1
                out = _emit_legal_byval(out, native_v2_make_load_stack(temp, machine_instr_call_arg_value(instr, ai)))
                out = _emit_legal_byval(out, native_v2_make_arg_move(ai, temp))
                ai = ai + 1
            }
            out = _emit_legal_byval(out, native_v2_make_call(machine_instr_src1_value(instr)))
            if machine_instr_dst_value(instr) >= 0 {
                let temp = out.temp_count
                out.temp_count = temp + 1
                out = _emit_legal_byval(out, native_v2_make_capture_ret(temp))
                out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
            }
        } else if instr.opcode == MIR_OP_PSEUDO_RET {
            if machine_instr_src1_kind(instr) == MIR_OPERAND_STACK_SLOT {
                let temp = out.temp_count
                out.temp_count = temp + 1
                out = _emit_legal_byval(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
                out = _emit_legal_byval(out, native_v2_make_ret(temp))
            } else {
                out = _emit_legal_byval(out, native_v2_make_ret(0 - 1))
            }
        } else if instr.opcode == MIR_OP_PSEUDO_JUMP {
            out = _emit_legal_byval(out, native_v2_make_jump(machine_instr_dst_value(instr)))
        } else if instr.opcode == MIR_OP_PSEUDO_BRANCH_TRUE {
            let temp = out.temp_count
            out.temp_count = temp + 1
            out = _emit_legal_byval(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_cmp_zero(temp))
            out = _emit_legal_byval(out, native_v2_make_jcc(machine_instr_dst_value(instr), MIR_CC_NZ))
        } else if instr.opcode == MIR_OP_PSEUDO_BRANCH_FALSE {
            let temp = out.temp_count
            out.temp_count = temp + 1
            out = _emit_legal_byval(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_cmp_zero(temp))
            out = _emit_legal_byval(out, native_v2_make_jcc(machine_instr_dst_value(instr), MIR_CC_Z))
        } else if instr.opcode == MIR_OP_PSEUDO_LABEL {
            out = _emit_legal_byval(out, native_v2_make_label(machine_instr_dst_value(instr)))
        } else if instr.opcode == MIR_OP_PSEUDO_ALLOC {
            let temp = out.temp_count
            out.temp_count = temp + 1
            out = _emit_legal_byval(out, native_v2_make_alloc(temp, native_v2_alloc_size_from_tag(machine_instr_src1_value(instr)), native_v2_alloc_descriptor_from_tag(machine_instr_src1_value(instr))))
            out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
        } else if instr.opcode == MIR_OP_PSEUDO_FIELD_GET {
            let base = out.temp_count
            out.temp_count = base + 1
            let dst = out.temp_count
            out.temp_count = dst + 1
            out = _emit_legal_byval(out, native_v2_make_load_stack(base, machine_instr_src1_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_field_load(dst, base, machine_instr_aux_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), dst))
        } else if instr.opcode == MIR_OP_PSEUDO_FIELD_SET {
            let base = out.temp_count
            out.temp_count = base + 1
            let src = out.temp_count
            out.temp_count = src + 1
            out = _emit_legal_byval(out, native_v2_make_load_stack(base, machine_instr_src1_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_load_stack(src, machine_instr_src2_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_field_store(base, src, machine_instr_aux_value(instr)))
        } else if instr.opcode == MIR_OP_PSEUDO_INDEX_GET {
            let base = out.temp_count
            out.temp_count = base + 1
            let idx = out.temp_count
            out.temp_count = idx + 1
            let dst = out.temp_count
            out.temp_count = dst + 1
            out = _emit_legal_byval(out, native_v2_make_load_stack(base, machine_instr_src1_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_load_stack(idx, machine_instr_src2_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_index_load(dst, base, idx))
            out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), dst))
        } else if instr.opcode == MIR_OP_PSEUDO_INDEX_SET {
            let base = out.temp_count
            out.temp_count = base + 1
            let idx = out.temp_count
            out.temp_count = idx + 1
            let src = out.temp_count
            out.temp_count = src + 1
            out = _emit_legal_byval(out, native_v2_make_load_stack(base, machine_instr_src1_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_load_stack(idx, machine_instr_src2_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_load_stack(src, machine_instr_aux_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_index_store(base, idx, src))
        } else if instr.opcode == MIR_OP_PSEUDO_LOAD_FLOAT {
            // Sprint 87: float literal → LOAD_FLOAT_RIP stack slot
            out = _emit_legal_byval(out, native_v2_make_load_float_rip(machine_instr_dst_value(instr), machine_instr_src1_value(instr)))
            if machine_instr_dst_value(instr) >= 0 && machine_instr_dst_value(instr) < MIR_MAX_FLOAT_SLOTS {
                out.is_float_slot[machine_instr_dst_value(instr) as usize] = 1
            }
        } else if instr.opcode == MIR_OP_PSEUDO_INT_TO_FLOAT {
            // Sprint 87: int stack slot → CVTSI2SD → float stack slot
            out = _emit_legal_byval(out, native_v2_make_int_to_float(machine_instr_dst_value(instr), machine_instr_src1_value(instr)))
            if machine_instr_dst_value(instr) >= 0 && machine_instr_dst_value(instr) < MIR_MAX_FLOAT_SLOTS {
                out.is_float_slot[machine_instr_dst_value(instr) as usize] = 1
            }
        } else if instr.opcode == MIR_OP_PSEUDO_FLOAT_TO_INT {
            // Sprint 87: float stack slot → CVTTSD2SI → int stack slot
            out = _emit_legal_byval(out, native_v2_make_float_to_int(machine_instr_dst_value(instr), machine_instr_src1_value(instr)))
            if machine_instr_dst_value(instr) >= 0 && machine_instr_dst_value(instr) < MIR_MAX_FLOAT_SLOTS {
                out.is_float_slot[machine_instr_dst_value(instr) as usize] = 0
            }
        } else if instr.opcode == MIR_OP_PSEUDO_LOAD_GLOBAL {
            let addr_temp = out.temp_count
            out.temp_count = addr_temp + 1
            let val_temp = out.temp_count
            out.temp_count = val_temp + 1
            out = _emit_legal_byval(out, native_v2_make_mov_imm(addr_temp, machine_instr_src1_value(instr)))
            var load_mi = machine_empty_instr()
            load_mi.opcode = MIR_OP_LOAD_ABS
            load_mi.dst = machine_operand_gpr64(val_temp)
            load_mi.src1 = machine_operand_gpr64(addr_temp)
            out = _emit_legal_byval(out, load_mi)
            out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), val_temp))
        } else if instr.opcode == MIR_OP_PSEUDO_STORE_GLOBAL {
            let val_temp = out.temp_count
            out.temp_count = val_temp + 1
            out = _emit_legal_byval(out, native_v2_make_load_stack(val_temp, machine_instr_src1_value(instr)))
            var store_mi = machine_empty_instr()
            store_mi.opcode = MIR_OP_STORE_ABS
            store_mi.src1 = machine_operand_gpr64(val_temp)
            store_mi.src2 = machine_operand_imm64(machine_instr_src2_value(instr))
            out = _emit_legal_byval(out, store_mi)
        }
        i = i + 1
    }

    if out.legal_instr_count <= 0 {
        out.legal_instr_count = out.blocks[0].instr_count
    }
    out
}

pub fn native_v2_machine_instr_is_legal(instr: MachineInstr) -> bool with Mut, Panic, Div {
    if instr.opcode == MIR_OP_LOAD_STACK {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_STACK_SLOT
    }
    if instr.opcode == MIR_OP_STORE_STACK {
        return instr.dst.kind == MIR_OPERAND_STACK_SLOT && instr.src1.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_MOV_IMM {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_IMM64
    }
    if instr.opcode == MIR_OP_LOAD_DATA_ADDR {
        return instr.dst.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_MOVE {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_BINOP {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_UNARY {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_CMP_ZERO {
        return instr.src1.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_SETCC {
        return instr.dst.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_JMP {
        return instr.dst.kind == MIR_OPERAND_LABEL
    }
    if instr.opcode == MIR_OP_JCC {
        return instr.dst.kind == MIR_OPERAND_LABEL && instr.cond != MIR_CC_NONE
    }
    if instr.opcode == MIR_OP_LABEL {
        return instr.dst.kind == MIR_OPERAND_LABEL
    }
    if instr.opcode == MIR_OP_ARG_MOVE {
        return instr.src1.kind == MIR_OPERAND_GPR64 && instr.arg_index >= 0 && instr.arg_index < 6
    }
    if instr.opcode == MIR_OP_CALL {
        return instr.src1.kind == MIR_OPERAND_CALL_TARGET
    }
    if instr.opcode == MIR_OP_CAPTURE_RET {
        return instr.dst.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_RET {
        return instr.src1.kind == MIR_OPERAND_NONE || instr.src1.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_ALLOC {
        return instr.dst.kind == MIR_OPERAND_GPR64
            && instr.src1.kind == MIR_OPERAND_IMM64
            && (instr.aux.kind == MIR_OPERAND_NONE || instr.aux.kind == MIR_OPERAND_IMM64)
    }
    if instr.opcode == MIR_OP_FIELD_LOAD {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_GPR64 && instr.aux.kind == MIR_OPERAND_IMM64
    }
    if instr.opcode == MIR_OP_FIELD_STORE {
        return instr.src1.kind == MIR_OPERAND_GPR64 && instr.src2.kind == MIR_OPERAND_GPR64 && instr.aux.kind == MIR_OPERAND_IMM64
    }
    if instr.opcode == MIR_OP_INDEX_LOAD {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_GPR64 && instr.src2.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_INDEX_STORE {
        return instr.src1.kind == MIR_OPERAND_GPR64 && instr.src2.kind == MIR_OPERAND_GPR64 && instr.aux.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_LEA_STACK {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_STACK_SLOT
    }
    if instr.opcode == MIR_OP_LOAD_ABS {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_STORE_ABS {
        return instr.src1.kind == MIR_OPERAND_GPR64 && instr.src2.kind == MIR_OPERAND_IMM64
    }
    false
}

pub fn native_v2_machine_function_is_legal(func: MachineFunction) -> bool with Mut, Panic, Div {
    if !func.supported { return false }
    var i: i64 = 0
    while i < func.blocks[0].instr_count {
        if !native_v2_machine_instr_is_legal(func.blocks[0].instrs[i as usize]) {
            return false
        }
        i = i + 1
    }
    true
}

pub fn native_v2_build_machine_module(module: &IrModule, enable_x86: bool) -> MachineModule with Mut, Panic, Div, Alloc {
    var out = machine_module_new()
    out.fn_count = module.fn_count
    out.total_ir_instr_count = 0
    out.active = enable_x86
    if enable_x86 {
        var target = empty_name()
        target.buf[0] = 120 as i8
        target.buf[1] = 56 as i8
        target.buf[2] = 54 as i8
        target.buf[3] = 95 as i8
        target.buf[4] = 54 as i8
        target.buf[5] = 52 as i8
        target.buf[6] = 45 as i8
        target.buf[7] = 108 as i8
        target.buf[8] = 105 as i8
        target.buf[9] = 110 as i8
        target.buf[10] = 117 as i8
        target.buf[11] = 120 as i8
        target.len = 12
        out.targets[0] = target
        out.target_count = 1
    }

    var i: i64 = 0
    while i < module.fn_count {
        let lowered = native_v2_lower_function_to_machine(ir_fn_get(module, i as usize))
        out.total_ir_instr_count = out.total_ir_instr_count + lowered.source_instr_count
        let legal = native_v2_legalize_function(lowered)
        machine_module_function_set(&! out, i, legal)
        let legal_count = if legal.legal_instr_count > 0 { legal.legal_instr_count } else { legal.blocks[0].instr_count }
        out.total_machine_instr_count = out.total_machine_instr_count + legal_count
        if !legal.supported && out.supported {
            out.supported = false
            out.unsupported_detail = legal.unsupported_detail
        }
        i = i + 1
    }

    out
}
