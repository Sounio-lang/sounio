// self-hosted::native::machine_ir — Minimal x86-native-v2 Machine IR substrate
//
// First active preview slice: x86_64-linux scalar core only.

module native::machine_ir

use parser::ast::{Name, BinaryOp, UnaryOp, empty_name}
use ir::ir::{IrModule, IrFunction, IrInstr, IrOpcode, IrRegList, BSS_BASE_LINUX, IR_F128_REG_MARKER_FLAG}

pub let MIR_MAX_BLOCKS: i64 = 1
pub let MIR_MAX_INSTRS: i64 = 512
pub let MIR_MAX_CALL_ARGS: i64 = 8

pub let MIR_OPERAND_NONE: i64 = 0
pub let MIR_OPERAND_GPR64: i64 = 1
pub let MIR_OPERAND_STACK_SLOT: i64 = 2
pub let MIR_OPERAND_IMM64: i64 = 3
pub let MIR_OPERAND_LABEL: i64 = 4
pub let MIR_OPERAND_CALL_TARGET: i64 = 5
pub let MIR_OPERAND_DATA_REF: i64 = 6
pub let MIR_OPERAND_FLAGS: i64 = 7

pub let MIR_OP_NOP: i64 = 0
pub let MIR_OP_PSEUDO_LOAD_IMM: i64 = 1
pub let MIR_OP_PSEUDO_LOAD_STRING: i64 = 2
pub let MIR_OP_PSEUDO_COPY: i64 = 3
pub let MIR_OP_PSEUDO_BINOP: i64 = 4
pub let MIR_OP_PSEUDO_UNARY: i64 = 5
pub let MIR_OP_PSEUDO_CALL: i64 = 6
pub let MIR_OP_PSEUDO_RET: i64 = 7
pub let MIR_OP_PSEUDO_JUMP: i64 = 8
