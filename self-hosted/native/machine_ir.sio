pub fn native_v2_collect_call_args(args: Option<Box<IrRegList>>, out: [i64; 8], count: i64) -> ([i64; 8], i64) with Alloc, Mut, Panic {
    match args {
        Some(list) => {
            var next_out = out
            var next_count = count
            if next_count < MIR_MAX_CALL_ARGS {
                next_out[next_count as usize] = (*list).head
                next_count = next_count + 1
            }
            native_v2_collect_call_args((*list).tail, next_out, next_count)
        }
        _ => (out, count),
    }
}

pub fn native_v2_pseudo_from_ir(instr: IrInstr) -> MachineInstr with Alloc, Mut, Panic, Div {
    var mi = machine_empty_instr()
    if instr.op == IrOpcode::IrNop && instr.imm_flags == IR_F128_REG_MARKER_FLAG {
        mi.opcode = MIR_OP_PSEUDO_F128_META
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_imm64(instr.src1)
        mi.src2 = machine_operand_imm64(instr.src2)
        mi.aux = machine_operand_imm64(instr.imm_i64)
        mi.cond = instr.label_id
        mi.arg_index = instr.field_idx
        mi.call_arg_count = instr.arg_count
        mi.name = instr.name
        return mi
    }
    if native_v2_ir_opcode_is_wide_meta(instr.op) {
        mi.opcode = MIR_OP_PSEUDO_WIDE_META
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_stack_slot(instr.src1)
        mi.src2 = machine_operand_stack_slot(instr.src2)
        mi.aux = machine_operand_imm64(instr.imm_i64)
        mi.cond = if native_v2_ir_opcode_is_wide_cmp(instr.op) { 1 } else { 0 }
        mi.arg_index = if instr.op == IrOpcode::IrWideShr || instr.op == IrOpcode::IrWideShrLimb { 1 } else { 2 }
        return mi
    }
    if instr.op == IrOpcode::IrLoadImm || instr.op == IrOpcode::IrLoadBool {
        mi.opcode = MIR_OP_PSEUDO_LOAD_IMM
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_imm64(instr.imm_i64)
        return mi
    }
    if instr.op == IrOpcode::IrLoadString {
        mi.opcode = MIR_OP_PSEUDO_LOAD_STRING
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.name = instr.name
        return mi
    }
    if instr.op == IrOpcode::IrCopy {
        mi.opcode = MIR_OP_PSEUDO_COPY
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_stack_slot(instr.src1)
        return mi
    }
    if instr.op == IrOpcode::IrBinOp {
        mi.opcode = MIR_OP_PSEUDO_BINOP
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_stack_slot(instr.src1)
        mi.src2 = machine_operand_stack_slot(instr.src2)
        mi.bin_op = instr.bin_op
        return mi
    }
    if instr.op == IrOpcode::IrUnaryOp {
        mi.opcode = MIR_OP_PSEUDO_UNARY
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_stack_slot(instr.src1)
        mi.un_op = instr.un_op
        return mi
    }
    if instr.op == IrOpcode::IrCall {
        let pair = native_v2_collect_call_args(instr.call_args, [0; 8], 0)
        mi.opcode = MIR_OP_PSEUDO_CALL
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_call_target(instr.fn_id)
        mi.call_arg_values = pair.0
        mi.call_arg_count = instr.arg_count
        if instr.imm_flags == IR_F128_REG_MARKER_FLAG {
            mi.cond = 1
        }
        return mi
    }
    if instr.op == IrOpcode::IrCallSret {
        let pair = native_v2_collect_call_args(instr.call_args, [0; 8], 0)
        mi.opcode = MIR_OP_PSEUDO_CALL_SRET
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_call_target(instr.fn_id)
        mi.src2 = machine_operand_stack_slot(instr.src1)
        mi.aux = machine_operand_stack_slot(instr.field_idx)
        if pair.1 > 0 {
            mi.call_arg_values = pair.0
            mi.call_arg_count = pair.1
        } else {
            mi.call_arg_count = instr.arg_count
            var ai: i64 = 0
            while ai < instr.arg_count && ai < MIR_MAX_CALL_ARGS {
                mi.call_arg_values[ai as usize] = instr.field_idx + ai
                ai = ai + 1
            }
        }
        return mi
    }
    if instr.op == IrOpcode::IrReturn {
        mi.opcode = MIR_OP_PSEUDO_RET
        if instr.src1 >= 0 {
            mi.src1 = machine_operand_stack_slot(instr.src1)
        }
        return mi
    }
    if instr.op == IrOpcode::IrReturnSret {
        mi.opcode = MIR_OP_PSEUDO_RET_SRET
        if instr.src1 >= 0 {
            mi.src1 = machine_operand_stack_slot(instr.src1)
        }
        return mi
    }
    if instr.op == IrOpcode::IrJump {
        mi.opcode = MIR_OP_PSEUDO_JUMP
        mi.dst = machine_operand_label(instr.label_id)
        return mi
    }
    if instr.op == IrOpcode::IrBranchTrue {
        mi.opcode = MIR_OP_PSEUDO_BRANCH_TRUE
        mi.dst = machine_operand_label(instr.label_id)
        mi.src1 = machine_operand_stack_slot(instr.src1)
        return mi
    }
    if instr.op == IrOpcode::IrBranchFalse {
        mi.opcode = MIR_OP_PSEUDO_BRANCH_FALSE
        mi.dst = machine_operand_label(instr.label_id)
        mi.src1 = machine_operand_stack_slot(instr.src1)
        return mi
    }
    if instr.op == IrOpcode::IrFieldGet {
        mi.opcode = MIR_OP_PSEUDO_FIELD_GET
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_stack_slot(instr.src1)
        mi.aux = machine_operand_imm64(instr.field_idx)
        return mi
    }
    if instr.op == IrOpcode::IrFieldSet {
        mi.opcode = MIR_OP_PSEUDO_FIELD_SET
        mi.src1 = machine_operand_stack_slot(instr.src1)
        mi.src2 = machine_operand_stack_slot(instr.src2)
        mi.aux = machine_operand_imm64(instr.field_idx)
        return mi
    }
    if instr.op == IrOpcode::IrIndexGet {
        mi.opcode = MIR_OP_PSEUDO_INDEX_GET
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_stack_slot(instr.src1)
        mi.src2 = machine_operand_stack_slot(instr.src2)
        return mi
    }
    if instr.op == IrOpcode::IrIndexSet {
        mi.opcode = MIR_OP_PSEUDO_INDEX_SET
        mi.src1 = machine_operand_stack_slot(instr.src1)
        mi.src2 = machine_operand_stack_slot(instr.src2)
        mi.aux = machine_operand_stack_slot(instr.imm_i64)
        return mi
    }
    if instr.op == IrOpcode::IrAlloc {
        mi.opcode = MIR_OP_PSEUDO_ALLOC
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_imm64(instr.imm_i64)
        return mi
    }
    if instr.op == IrOpcode::IrLabel {
        mi.opcode = MIR_OP_PSEUDO_LABEL
        mi.dst = machine_operand_label(instr.label_id)
        return mi
    }
    if instr.op == IrOpcode::IrLoadFloat {
        mi.opcode = MIR_OP_PSEUDO_LOAD_FLOAT
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_imm64(f64_to_bits(instr.imm_f64))
        return mi
    }
    if instr.op == IrOpcode::IrIntToFloat {
        mi.opcode = MIR_OP_PSEUDO_INT_TO_FLOAT
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_stack_slot(instr.src1)
        return mi
    }
    if instr.op == IrOpcode::IrFloatToInt {
        mi.opcode = MIR_OP_PSEUDO_FLOAT_TO_INT
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_stack_slot(instr.src1)
        return mi
    }
    if instr.op == IrOpcode::IrLoadGlobal {
        mi.opcode = MIR_OP_PSEUDO_LOAD_GLOBAL
        mi.dst = machine_operand_stack_slot(instr.dst)
        mi.src1 = machine_operand_imm64(BSS_BASE_LINUX + instr.imm_i64)
        return mi
    }
    if instr.op == IrOpcode::IrStoreGlobal {
        mi.opcode = MIR_OP_PSEUDO_STORE_GLOBAL
        mi.src1 = machine_operand_stack_slot(instr.src1)
        mi.src2 = machine_operand_imm64(BSS_BASE_LINUX + instr.imm_i64)
        return mi
    }
    mi
}

pub fn native_v2_alloc_size_from_tag(tag: i64) -> i64 with Mut, Panic, Div {
    if tag == 0 { return 512 }
    if tag == 1 { return 512 }
    if tag == 2 { return 128 }
    if tag == 8 { return 16 }
    if tag < 64 { return 64 }
    ((tag + 7) / 8) * 8
}

pub fn native_v2_alloc_descriptor_from_tag(tag: i64) -> i64 with Mut, Panic, Div {
    if tag == 0 { return 0 }
    if tag == 1 { return 1 }
    if tag == 2 { return 2 }
    if tag == 8 { return 8 }
    255
}


fn native_v2_ir_reg_is_f128(func: &IrFunction, reg: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < (*func).instr_count && i < IR_MAX_INSTRS {
        let instr = (*func).instrs[i as usize]
        if instr.op == IrOpcode::IrNop && instr.imm_flags == IR_F128_REG_MARKER_FLAG && instr.dst == reg {
            return true
        }
        i = i + 1
    }
    false
}

// By-value instruction append (avoids JIT &! bug)
pub fn _emit_legal_byval(func: MachineFunction, instr: MachineInstr) -> MachineFunction with Mut, Panic, Div {
    var f = func
    if f.blocks[0].instr_count < 512 {
        var block = f.blocks[0]
        let idx = block.instr_count
        block.instrs[idx as usize] = instr
        block.instr_count = idx + 1
        f.blocks[0] = block
        f.legal_instr_count = f.legal_instr_count + 1
    }
    f
}

pub fn _add_instr_byval(func: MachineFunction, instr: MachineInstr) -> MachineFunction with Mut, Panic, Div {
    var f = func
    if f.blocks[0].instr_count < 512 {
        var block = f.blocks[0]
        let idx = block.instr_count
        block.instrs[idx as usize] = instr
        block.instr_count = idx + 1
        f.blocks[0] = block
    }
    f
}

pub fn native_v2_lower_function_to_machine(func: IrFunction) -> MachineFunction with Mut, Panic, Div, Alloc {
    var out = machine_function_new()
    out.base_slot_count = func.reg_count
    out.source_instr_count = func.instr_count

    var i: i64 = 0
    while i < func.instr_count {
        let instr = func.instrs[i as usize]
        if instr.op == IrOpcode::IrNop {
            if instr.imm_flags == IR_F128_REG_MARKER_FLAG {
                out = _add_instr_byval(out, native_v2_pseudo_from_ir(instr))
            }
            i = i + 1
            continue
        }
        if !native_v2_supported_ir_opcode(instr.op) {
            out.supported = false
            out.unsupported_detail = native_v2_ir_opcode_name(instr.op)
            return out
        }
        var mi = native_v2_pseudo_from_ir(instr)
        if instr.op == IrOpcode::IrCall && native_v2_ir_reg_is_f128(&func, instr.dst) {
            mi.cond = 1
        }
        out = _add_instr_byval(out, mi)
        i = i + 1
    }

    out
}

pub fn native_v2_emit_legal_instr_mut(func: &! MachineFunction, instr: MachineInstr) with Mut, Panic, Div {
    machine_function_add_instr_mut(func, instr)
    (*func).legal_instr_count = (*func).legal_instr_count + 1
}

