// self-hosted::native::machine_ir — Minimal x86-native-v2 Machine IR substrate
//
// First active preview slice: x86_64-linux scalar core only.

module native::machine_ir

use parser::ast::{Name, BinaryOp, UnaryOp, empty_name}
use ir::ir::{IrModule, IrFunction, IrInstr, IrOpcode, IrRegList}

let MIR_MAX_BLOCKS: i64 = 8
let MIR_MAX_INSTRS: i64 = 512
let MIR_MAX_CALL_ARGS: i64 = 8

let MIR_OPERAND_NONE: i64 = 0
let MIR_OPERAND_GPR64: i64 = 1
let MIR_OPERAND_STACK_SLOT: i64 = 2
let MIR_OPERAND_IMM64: i64 = 3
let MIR_OPERAND_LABEL: i64 = 4
let MIR_OPERAND_CALL_TARGET: i64 = 5
let MIR_OPERAND_DATA_REF: i64 = 6
let MIR_OPERAND_FLAGS: i64 = 7

let MIR_OP_NOP: i64 = 0
let MIR_OP_PSEUDO_LOAD_IMM: i64 = 1
let MIR_OP_PSEUDO_LOAD_STRING: i64 = 2
let MIR_OP_PSEUDO_COPY: i64 = 3
let MIR_OP_PSEUDO_BINOP: i64 = 4
let MIR_OP_PSEUDO_UNARY: i64 = 5
let MIR_OP_PSEUDO_CALL: i64 = 6
let MIR_OP_PSEUDO_RET: i64 = 7
let MIR_OP_PSEUDO_JUMP: i64 = 8
let MIR_OP_PSEUDO_BRANCH_TRUE: i64 = 9
let MIR_OP_PSEUDO_BRANCH_FALSE: i64 = 10
let MIR_OP_PSEUDO_LABEL: i64 = 11
let MIR_OP_PSEUDO_ALLOC: i64 = 12
let MIR_OP_PSEUDO_FIELD_GET: i64 = 13
let MIR_OP_PSEUDO_FIELD_SET: i64 = 14
let MIR_OP_PSEUDO_INDEX_GET: i64 = 15
let MIR_OP_PSEUDO_INDEX_SET: i64 = 16

let MIR_OP_LOAD_STACK: i64 = 100
let MIR_OP_STORE_STACK: i64 = 101
let MIR_OP_MOV_IMM: i64 = 102
let MIR_OP_LOAD_DATA_ADDR: i64 = 103
let MIR_OP_MOVE: i64 = 104
let MIR_OP_BINOP: i64 = 105
let MIR_OP_UNARY: i64 = 106
let MIR_OP_CMP_ZERO: i64 = 107
let MIR_OP_SETCC: i64 = 108
let MIR_OP_JMP: i64 = 109
let MIR_OP_JCC: i64 = 110
let MIR_OP_LABEL: i64 = 111
let MIR_OP_ARG_MOVE: i64 = 112
let MIR_OP_CALL: i64 = 113
let MIR_OP_CAPTURE_RET: i64 = 114
let MIR_OP_RET: i64 = 115
let MIR_OP_ALLOC: i64 = 116
let MIR_OP_FIELD_LOAD: i64 = 117
let MIR_OP_FIELD_STORE: i64 = 118
let MIR_OP_INDEX_LOAD: i64 = 119
let MIR_OP_INDEX_STORE: i64 = 120
let MIR_OP_LEA_STACK: i64 = 121
let MIR_OP_LOAD_FLOAT_RIP: i64 = 122     // MOVSD xmm0,[rip+const]; store to slot
let MIR_OP_FLOAT_BINOP: i64 = 123        // SSE2 arithmetic/compare on float stack slots
let MIR_OP_INT_TO_FLOAT: i64 = 124       // CVTSI2SD: int stack slot → float stack slot
let MIR_OP_FLOAT_TO_INT: i64 = 125       // CVTTSD2SI: float stack slot → int stack slot
let MIR_OP_FLOAT_MOVE: i64 = 126         // float stack slot copy via xmm0

let MIR_OP_PSEUDO_LOAD_FLOAT: i64 = 17
let MIR_OP_PSEUDO_INT_TO_FLOAT: i64 = 18
let MIR_OP_PSEUDO_FLOAT_TO_INT: i64 = 19

let MIR_CC_NONE: i64 = 0
let MIR_CC_Z: i64 = 1
let MIR_CC_NZ: i64 = 2
let MIR_CC_EQ: i64 = 3
let MIR_CC_NE: i64 = 4
let MIR_CC_LT: i64 = 5
let MIR_CC_LE: i64 = 6
let MIR_CC_GT: i64 = 7
let MIR_CC_GE: i64 = 8

struct MachineOperand {
    kind: i64,
    value: i64,
}

struct MachineInstr {
    opcode: i64,
    dst: MachineOperand,
    src1: MachineOperand,
    src2: MachineOperand,
    aux: MachineOperand,
    bin_op: BinaryOp,
    un_op: UnaryOp,
    cond: i64,
    arg_index: i64,
    name: Name,
    call_arg_values: [i64; 8],
    call_arg_count: i64,
}

struct MachineBlock {
    instrs: [MachineInstr; 512],
    instr_count: i64,
}

pub struct MachineFunction {
    blocks: [MachineBlock; 8],
    block_count: i64,
    temp_count: i64,
    source_instr_count: i64,
    legal_instr_count: i64,
    base_slot_count: i64,
    supported: bool,
    unsupported_detail: string,
    is_float_slot: [i64; 256],
}

struct MachineModule {
    functions: [MachineFunction; 32],
    fn_count: i64,
    total_ir_instr_count: i64,
    total_machine_instr_count: i64,
    active: bool,
    fail_closed: bool,
    legacy_fallback: bool,
    coverage: string,
    targets: [Name; 4],
    target_count: i64,
    supported: bool,
    unsupported_detail: string,
}

fn machine_operand_none() -> MachineOperand {
    MachineOperand { kind: MIR_OPERAND_NONE, value: 0 }
}

fn machine_operand_gpr64(vreg: i64) -> MachineOperand {
    MachineOperand { kind: MIR_OPERAND_GPR64, value: vreg }
}

fn machine_operand_stack_slot(slot: i64) -> MachineOperand {
    MachineOperand { kind: MIR_OPERAND_STACK_SLOT, value: slot }
}

fn machine_operand_imm64(value: i64) -> MachineOperand {
    MachineOperand { kind: MIR_OPERAND_IMM64, value: value }
}

fn machine_operand_label(label_id: i64) -> MachineOperand {
    MachineOperand { kind: MIR_OPERAND_LABEL, value: label_id }
}

fn machine_operand_call_target(fn_id: i64) -> MachineOperand {
    MachineOperand { kind: MIR_OPERAND_CALL_TARGET, value: fn_id }
}

fn machine_operand_data_ref(value: i64) -> MachineOperand {
    MachineOperand { kind: MIR_OPERAND_DATA_REF, value: value }
}

fn machine_operand_flags(value: i64) -> MachineOperand {
    MachineOperand { kind: MIR_OPERAND_FLAGS, value: value }
}

fn machine_empty_instr() -> MachineInstr {
    MachineInstr {
        opcode: MIR_OP_NOP,
        dst: machine_operand_none(),
        src1: machine_operand_none(),
        src2: machine_operand_none(),
        aux: machine_operand_none(),
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        cond: MIR_CC_NONE,
        arg_index: -1,
        name: empty_name(),
        call_arg_values: [0; 8],
        call_arg_count: 0,
    }
}

fn machine_block_new() -> MachineBlock {
    MachineBlock {
        instrs: [machine_empty_instr(); 512],
        instr_count: 0,
    }
}

fn machine_function_new() -> MachineFunction {
    MachineFunction {
        blocks: [machine_block_new(); 8],
        block_count: 1,
        temp_count: 0,
        source_instr_count: 0,
        legal_instr_count: 0,
        base_slot_count: 0,
        supported: true,
        unsupported_detail: "",
        is_float_slot: [0; 256],
    }
}

fn machine_module_new() -> MachineModule {
    MachineModule {
        functions: [machine_function_new(); 32],
        fn_count: 0,
        total_ir_instr_count: 0,
        total_machine_instr_count: 0,
        active: false,
        fail_closed: true,
        legacy_fallback: false,
        coverage: "scalar_core",
        targets: [empty_name(); 4],
        target_count: 0,
        supported: true,
        unsupported_detail: "",
    }
}

fn machine_function_add_instr_mut(func: &! MachineFunction, instr: MachineInstr) with Mut, Panic, Div {
    if (*func).blocks[0].instr_count < MIR_MAX_INSTRS {
        let idx = (*func).blocks[0].instr_count
        (*func).blocks[0].instrs[idx as usize] = instr
        (*func).blocks[0].instr_count = idx + 1
    }
}

fn machine_function_add_instr(func: MachineFunction, instr: MachineInstr) -> MachineFunction with Mut, Panic, Div {
    var f = func
    machine_function_add_instr_mut(&! f, instr)
    f
}

fn machine_function_next_temp_mut(func: &! MachineFunction) -> i64 with Mut {
    let id = (*func).temp_count
    (*func).temp_count = id + 1
    id
}

fn machine_function_next_temp(func: MachineFunction) -> (MachineFunction, i64) with Mut {
    var f = func
    let id = machine_function_next_temp_mut(&! f)
    (f, id)
}

fn native_v2_supported_ir_opcode(op: IrOpcode) -> bool {
    if op == IrOpcode::IrLoadImm { return true }
    if op == IrOpcode::IrLoadBool { return true }
    if op == IrOpcode::IrLoadString { return true }
    if op == IrOpcode::IrCopy { return true }
    if op == IrOpcode::IrBinOp { return true }
    if op == IrOpcode::IrUnaryOp { return true }
    if op == IrOpcode::IrCall { return true }
    if op == IrOpcode::IrReturn { return true }
    if op == IrOpcode::IrJump { return true }
    if op == IrOpcode::IrBranchTrue { return true }
    if op == IrOpcode::IrBranchFalse { return true }
    if op == IrOpcode::IrFieldGet { return true }
    if op == IrOpcode::IrFieldSet { return true }
    if op == IrOpcode::IrIndexGet { return true }
    if op == IrOpcode::IrIndexSet { return true }
    if op == IrOpcode::IrAlloc { return true }
    if op == IrOpcode::IrLabel { return true }
    if op == IrOpcode::IrNop { return true }
    if op == IrOpcode::IrLoadFloat { return true }
    if op == IrOpcode::IrIntToFloat { return true }
    if op == IrOpcode::IrFloatToInt { return true }
    false
}

fn native_v2_ir_opcode_name(op: IrOpcode) -> string {
    if op == IrOpcode::IrLoadImm { return "load_imm" }
    if op == IrOpcode::IrLoadFloat { return "load_float" }
    if op == IrOpcode::IrLoadBool { return "load_bool" }
    if op == IrOpcode::IrLoadString { return "load_string" }
    if op == IrOpcode::IrCopy { return "copy" }
    if op == IrOpcode::IrBinOp { return "binop" }
    if op == IrOpcode::IrUnaryOp { return "unaryop" }
    if op == IrOpcode::IrCall { return "call" }
    if op == IrOpcode::IrReturn { return "return" }
    if op == IrOpcode::IrJump { return "jump" }
    if op == IrOpcode::IrBranchTrue { return "branch_true" }
    if op == IrOpcode::IrBranchFalse { return "branch_false" }
    if op == IrOpcode::IrFieldGet { return "field_get" }
    if op == IrOpcode::IrFieldSet { return "field_set" }
    if op == IrOpcode::IrIndexGet { return "index_get" }
    if op == IrOpcode::IrIndexSet { return "index_set" }
    if op == IrOpcode::IrAlloc { return "alloc" }
    if op == IrOpcode::IrLabel { return "label" }
    if op == IrOpcode::IrNop { return "nop" }
    if op == IrOpcode::IrPhi { return "phi" }
    if op == IrOpcode::IrVecAddF64 { return "vec_add_f64" }
    if op == IrOpcode::IrVecMulF64 { return "vec_mul_f64" }
    if op == IrOpcode::IrVecFmaF64 { return "vec_fma_f64" }
    if op == IrOpcode::IrVecSubF64 { return "vec_sub_f64" }
    if op == IrOpcode::IrVecMinMaxPD { return "vec_minmax_pd" }
    if op == IrOpcode::IrMaskAnd { return "mask_and" }
    if op == IrOpcode::IrMaskOr { return "mask_or" }
    if op == IrOpcode::IrMaskNot { return "mask_not" }
    if op == IrOpcode::IrMaskMov { return "mask_mov" }
    if op == IrOpcode::IrVecPermilPD { return "vec_permil_pd" }
    if op == IrOpcode::IrVecPermilPDImm { return "vec_permil_pd_imm" }
    if op == IrOpcode::IrVecAddSubPD { return "vec_addsub_pd" }
    if op == IrOpcode::IrHyperMulQ { return "hyper_mul_q" }
    if op == IrOpcode::IrVecXorPD { return "vec_xor_pd" }
    if op == IrOpcode::IrVecPermpd { return "vec_permpd" }
    if op == IrOpcode::IrHyperConjugateO { return "hyper_conjugate_o" }
    if op == IrOpcode::IrHyperMulO { return "hyper_mul_o" }
    if op == IrOpcode::IrHyperNormSqO { return "hyper_norm_sq_o" }
    if op == IrOpcode::IrG2ProjectImO { return "g2_project_im_o" }
    if op == IrOpcode::IrG2ApplyGenO { return "g2_apply_gen_o" }
    if op == IrOpcode::IrG2DenseO { return "g2_dense_o" }
    if op == IrOpcode::IrG2EquivDenseKernelO { return "g2_equiv_dense_kernel_o" }
    if op == IrOpcode::IrE8RootReflectO { return "e8_root_reflect_o" }
    if op == IrOpcode::IrF4RootReflectO { return "f4_root_reflect_o" }
    if op == IrOpcode::IrE6RootReflectO { return "e6_root_reflect_o" }
    if op == IrOpcode::IrE7RootReflectO { return "e7_root_reflect_o" }
    if op == IrOpcode::IrF4CartanMulO { return "f4_cartan_mul_o" }
    if op == IrOpcode::IrE6CartanMulO { return "e6_cartan_mul_o" }
    if op == IrOpcode::IrE7CartanMulO { return "e7_cartan_mul_o" }
    if op == IrOpcode::IrE8CartanMulO { return "e8_cartan_mul_o" }
    if op == IrOpcode::IrContest { return "contest" }
    if op == IrOpcode::IrProveRobust { return "prove_robust" }
    if op == IrOpcode::IrValidated { return "validated" }
    if op == IrOpcode::IrAdmitAction { return "admit_action" }
    if op == IrOpcode::IrDeferAction { return "defer_action" }
    if op == IrOpcode::IrPlanAcquisition { return "plan_acquisition" }
    if op == IrOpcode::IrPlanRecourse { return "plan_recourse" }
    if op == IrOpcode::IrProposeAlternatives { return "propose_alternatives" }
    if op == IrOpcode::IrCommitAlternative { return "commit_alternative" }
    if op == IrOpcode::IrObserveTransition { return "observe_transition" }
    if op == IrOpcode::IrRollbackTransition { return "rollback_transition" }
    if op == IrOpcode::IrLiftKnowledge { return "lift_knowledge" }
    if op == IrOpcode::IrMeasure { return "measure" }
    if op == IrOpcode::IrHandleBegin { return "handle_begin" }
    if op == IrOpcode::IrHandleEnd { return "handle_end" }
    if op == IrOpcode::IrDebugGuard { return "debug_guard" }
    if op == IrOpcode::IrProfCounter { return "prof_counter" }
