pub fn native_v2_make_float_binop(dst_slot: i64, src1_slot: i64, src2_slot: i64, op: BinaryOp, src1_is_float: i64, src2_is_float: i64) -> MachineInstr with Mut, Panic, Div {
    var mi = machine_empty_instr()
    mi.opcode = MIR_OP_FLOAT_BINOP
    mi.dst = machine_operand_stack_slot(dst_slot)
    mi.src1 = machine_operand_stack_slot(src1_slot)
    mi.src2 = machine_operand_stack_slot(src2_slot)
