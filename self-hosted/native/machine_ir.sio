pub fn native_v2_legalize_summary_from_machine(func: MachineFunction) -> NativeV2LegalizeSummary with Mut, Panic, Div {
    var out = native_v2_legalize_summary_new()
    out.source_instr_count = func.source_instr_count
    out.pseudo_instr_count = func.blocks[0].instr_count
    if !func.supported {
        out.supported = false
        out.unsupported_detail = func.unsupported_detail
        return out
    }

    var is_float_slot: [i64; 256] = [0; 256]
    var is_f128_slot: [i64; 256] = [0; 256]
    var i: i64 = 0
    while i < func.blocks[0].instr_count {
        let instr = func.blocks[0].instrs[i as usize]

        if instr.opcode == MIR_OP_PSEUDO_WIDE_META {
            let limbs = machine_instr_aux_value(instr)
            if limbs <= 1 || limbs > 64 {
                out.supported = false
                out.unsupported_detail = "wide_meta_bad_limb_count"
                return out
            }
        } else if instr.opcode == MIR_OP_PSEUDO_F128_META {
            if !native_v2_f128_literal_materializable(machine_instr_src1_value(instr), machine_instr_src2_value(instr), machine_instr_aux_value(instr), instr.cond, instr.arg_index, instr.call_arg_count) {
                out.supported = false
                out.unsupported_detail = "f128_decimal_materialization_pending"
                return out
            }
            let fslot = machine_instr_dst_value(instr)
            if fslot >= 0 && fslot < 256 {
                is_f128_slot[fslot as usize] = 1
            }
        } else if instr.opcode == MIR_OP_PSEUDO_LOAD_IMM {
            out.legal_instr_count = out.legal_instr_count + 2
        } else if instr.opcode == MIR_OP_PSEUDO_LOAD_STRING {
            out.legal_instr_count = out.legal_instr_count + 2
        } else if instr.opcode == MIR_OP_PSEUDO_COPY {
            let src_slot = machine_instr_src1_value(instr)
            let dst_slot = machine_instr_dst_value(instr)
            let src_is_f128 = if src_slot >= 0 && src_slot < 256 { is_f128_slot[src_slot as usize] } else { 0 }
            let src_is_float = if src_slot >= 0 && src_slot < 256 { is_float_slot[src_slot as usize] } else { 0 }
            if src_is_f128 == 1 {
                out.legal_instr_count = out.legal_instr_count + 4
                if dst_slot >= 0 && dst_slot < 256 {
                    is_f128_slot[dst_slot as usize] = 1
                }
            } else if src_is_float == 1 {
                out.legal_instr_count = out.legal_instr_count + 1
                if dst_slot >= 0 && dst_slot < 256 {
                    is_float_slot[dst_slot as usize] = 1
                }
            } else {
                out.legal_instr_count = out.legal_instr_count + 2
            }
        } else if instr.opcode == MIR_OP_PSEUDO_BINOP {
            let s1 = machine_instr_src1_value(instr)
            let s2 = machine_instr_src2_value(instr)
            let s1q = if s1 >= 0 && s1 < 256 { is_f128_slot[s1 as usize] } else { 0 }
            let s2q = if s2 >= 0 && s2 < 256 { is_f128_slot[s2 as usize] } else { 0 }
            let s1f = if s1 >= 0 && s1 < 256 { is_float_slot[s1 as usize] } else { 0 }
            let s2f = if s2 >= 0 && s2 < 256 { is_float_slot[s2 as usize] } else { 0 }
            if s1q == 1 || s2q == 1 {
                out.supported = false
                out.unsupported_detail = "f128_arithmetic_pending"
                return out
            } else if s1f == 1 || s2f == 1 {
                out.legal_instr_count = out.legal_instr_count + 1
                let dslot = machine_instr_dst_value(instr)
                if dslot >= 0 && dslot < 256 {
                    if machine_instr_bin_op(instr) == BinaryOp::OpAdd || machine_instr_bin_op(instr) == BinaryOp::OpSub || machine_instr_bin_op(instr) == BinaryOp::OpMul || machine_instr_bin_op(instr) == BinaryOp::OpDiv {
                        is_float_slot[dslot as usize] = 1
                    }
                }
            } else {
                out.legal_instr_count = out.legal_instr_count + 4
            }
        } else if instr.opcode == MIR_OP_PSEUDO_UNARY {
            if machine_instr_un_op(instr) == UnaryOp::OpRef || machine_instr_un_op(instr) == UnaryOp::OpRefMut {
                out.legal_instr_count = out.legal_instr_count + 2
            } else {
                out.legal_instr_count = out.legal_instr_count + 3
            }
        } else if instr.opcode == MIR_OP_PSEUDO_CALL {
            if machine_instr_call_arg_count(instr) > MIR_MAX_CALL_ARGS {
                out.supported = false
                out.unsupported_detail = "call_arity_gt_8"
                return out
            }
            var f128_ai: i64 = 0
            while f128_ai < machine_instr_call_arg_count(instr) {
                let arg_slot = machine_instr_call_arg_value(instr, f128_ai)
                if arg_slot >= 0 && arg_slot < 256 && is_f128_slot[arg_slot as usize] == 1 {
                    out.supported = false
                    out.unsupported_detail = "f128_call_arg_pending"
                    return out
                }
                f128_ai = f128_ai + 1
            }
            out.legal_instr_count = out.legal_instr_count + 1 + (machine_instr_call_arg_count(instr) * 2)
            if machine_instr_call_arg_count(instr) > 6 {
                let stack_count = machine_instr_call_arg_count(instr) - 6
                out.legal_instr_count = out.legal_instr_count + stack_count
                if (stack_count % 2) != 0 {
                    out.legal_instr_count = out.legal_instr_count + 1
                }
                out.legal_instr_count = out.legal_instr_count + 1
            }
            if machine_instr_dst_value(instr) >= 0 {
                out.legal_instr_count = out.legal_instr_count + 2
            }
        } else if instr.opcode == MIR_OP_PSEUDO_CALL_SRET {
            if machine_instr_call_arg_count(instr) > MIR_MAX_CALL_ARGS {
                out.supported = false
                out.unsupported_detail = "sret_call_arity_gt_8"
                return out
            }
            var f128_sret_ai: i64 = 0
            while f128_sret_ai < machine_instr_call_arg_count(instr) {
                let arg_slot = machine_instr_call_arg_value(instr, f128_sret_ai)
                if arg_slot >= 0 && arg_slot < 256 && is_f128_slot[arg_slot as usize] == 1 {
                    out.supported = false
                    out.unsupported_detail = "f128_call_arg_pending"
                    return out
                }
                f128_sret_ai = f128_sret_ai + 1
            }
            out.legal_instr_count = out.legal_instr_count + 3 + (machine_instr_call_arg_count(instr) * 2)
            if machine_instr_call_arg_count(instr) > 5 {
                let stack_count = machine_instr_call_arg_count(instr) - 5
                out.legal_instr_count = out.legal_instr_count + stack_count
                if (stack_count % 2) != 0 {
                    out.legal_instr_count = out.legal_instr_count + 1
                }
                out.legal_instr_count = out.legal_instr_count + 1
            }
            if machine_instr_dst_value(instr) >= 0 {
                out.legal_instr_count = out.legal_instr_count + 2
            }
        } else if instr.opcode == MIR_OP_PSEUDO_RET {
            if machine_instr_src1_kind(instr) == MIR_OPERAND_STACK_SLOT {
                let ret_slot = machine_instr_src1_value(instr)
                if ret_slot >= 0 && ret_slot < 256 && is_f128_slot[ret_slot as usize] == 1 {
                    out.legal_instr_count = out.legal_instr_count + 3
                } else {
                    out.legal_instr_count = out.legal_instr_count + 2
                }
            } else {
                out.legal_instr_count = out.legal_instr_count + 1
            }
        } else if instr.opcode == MIR_OP_PSEUDO_RET_SRET {
            if machine_instr_src1_kind(instr) == MIR_OPERAND_STACK_SLOT {
                let ret_slot = machine_instr_src1_value(instr)
                if ret_slot >= 0 && ret_slot < 256 && is_f128_slot[ret_slot as usize] == 1 {
                    out.supported = false
                    out.unsupported_detail = "f128_return_pending"
                    return out
                }
                out.legal_instr_count = out.legal_instr_count + 2
            } else {
                out.legal_instr_count = out.legal_instr_count + 1
            }
        } else if instr.opcode == MIR_OP_PSEUDO_JUMP {
            out.legal_instr_count = out.legal_instr_count + 1
        } else if instr.opcode == MIR_OP_PSEUDO_BRANCH_TRUE {
            out.legal_instr_count = out.legal_instr_count + 3
        } else if instr.opcode == MIR_OP_PSEUDO_BRANCH_FALSE {
            out.legal_instr_count = out.legal_instr_count + 3
        } else if instr.opcode == MIR_OP_PSEUDO_LABEL {
            out.legal_instr_count = out.legal_instr_count + 1
        } else if instr.opcode == MIR_OP_PSEUDO_ALLOC {
            out.legal_instr_count = out.legal_instr_count + 2
        } else if instr.opcode == MIR_OP_PSEUDO_FIELD_GET {
            out.legal_instr_count = out.legal_instr_count + 3
        } else if instr.opcode == MIR_OP_PSEUDO_FIELD_SET {
            out.legal_instr_count = out.legal_instr_count + 3
        } else if instr.opcode == MIR_OP_PSEUDO_INDEX_GET {
            out.legal_instr_count = out.legal_instr_count + 4
        } else if instr.opcode == MIR_OP_PSEUDO_INDEX_SET {
            out.legal_instr_count = out.legal_instr_count + 4
        } else if instr.opcode == MIR_OP_PSEUDO_LOAD_FLOAT {
            out.legal_instr_count = out.legal_instr_count + 1
            if machine_instr_dst_value(instr) >= 0 && machine_instr_dst_value(instr) < 256 {
                is_float_slot[machine_instr_dst_value(instr) as usize] = 1
            }
        } else if instr.opcode == MIR_OP_PSEUDO_INT_TO_FLOAT {
            out.legal_instr_count = out.legal_instr_count + 1
            if machine_instr_dst_value(instr) >= 0 && machine_instr_dst_value(instr) < 256 {
                is_float_slot[machine_instr_dst_value(instr) as usize] = 1
            }
        } else if instr.opcode == MIR_OP_PSEUDO_FLOAT_TO_INT {
            out.legal_instr_count = out.legal_instr_count + 1
            if machine_instr_dst_value(instr) >= 0 && machine_instr_dst_value(instr) < 256 {
                is_float_slot[machine_instr_dst_value(instr) as usize] = 0
            }
        } else {
            out.supported = false
            out.unsupported_detail = "unknown_pseudo_opcode"
            return out
        }
        i = i + 1
    }

    out
}

pub fn native_v2_legalize_ir_summary_ref(func: &IrFunction) -> NativeV2LegalizeSummary with Mut, Panic, Div {
    var out = native_v2_legalize_summary_new()
    out.source_instr_count = (*func).instr_count

    var is_float_slot: [i64; 256] = [0; 256]
    var is_f128_slot: [i64; 256] = [0; 256]
    var i: i64 = 0
    while i < (*func).instr_count {
        let instr = (*func).instrs[i as usize]
        if instr.op == IrOpcode::IrNop {
            if instr.imm_flags == IR_F128_REG_MARKER_FLAG {
                if instr.dst >= 0 && instr.dst < 256 {
                    is_f128_slot[instr.dst as usize] = 1
                }
            }
            i = i + 1
            continue
        }
        if !native_v2_supported_ir_opcode(instr.op) {
            out.supported = false
            out.unsupported_detail = native_v2_ir_opcode_name(instr.op)
            return out
        }

        out.pseudo_instr_count = out.pseudo_instr_count + 1
        if instr.op == IrOpcode::IrLoadImm || instr.op == IrOpcode::IrLoadBool {
            out.legal_instr_count = out.legal_instr_count + 2
        } else if instr.op == IrOpcode::IrLoadString {
            out.legal_instr_count = out.legal_instr_count + 2
        } else if instr.op == IrOpcode::IrCopy {
            let src_slot = instr.src1
            let dst_slot = instr.dst
            let src_is_f128 = if src_slot >= 0 && src_slot < 256 { is_f128_slot[src_slot as usize] } else { 0 }
            let src_is_float = if src_slot >= 0 && src_slot < 256 { is_float_slot[src_slot as usize] } else { 0 }
            if src_is_f128 == 1 {
                out.legal_instr_count = out.legal_instr_count + 4
                if dst_slot >= 0 && dst_slot < 256 {
                    is_f128_slot[dst_slot as usize] = 1
                }
            } else if src_is_float == 1 {
                out.legal_instr_count = out.legal_instr_count + 1
                if dst_slot >= 0 && dst_slot < 256 {
                    is_float_slot[dst_slot as usize] = 1
                }
            } else {
                out.legal_instr_count = out.legal_instr_count + 2
            }
        } else if instr.op == IrOpcode::IrBinOp {
            let s1 = instr.src1
            let s2 = instr.src2
            let s1q = if s1 >= 0 && s1 < 256 { is_f128_slot[s1 as usize] } else { 0 }
            let s2q = if s2 >= 0 && s2 < 256 { is_f128_slot[s2 as usize] } else { 0 }
            let s1f = if s1 >= 0 && s1 < 256 { is_float_slot[s1 as usize] } else { 0 }
            let s2f = if s2 >= 0 && s2 < 256 { is_float_slot[s2 as usize] } else { 0 }
            if s1q == 1 || s2q == 1 {
                out.supported = false
                out.unsupported_detail = "f128_arithmetic_pending"
                return out
            } else if s1f == 1 || s2f == 1 {
                out.legal_instr_count = out.legal_instr_count + 1
                if instr.dst >= 0 && instr.dst < 256 {
                    if instr.bin_op == BinaryOp::OpAdd || instr.bin_op == BinaryOp::OpSub || instr.bin_op == BinaryOp::OpMul || instr.bin_op == BinaryOp::OpDiv {
                        is_float_slot[instr.dst as usize] = 1
                    }
                }
            } else {
                out.legal_instr_count = out.legal_instr_count + 4
            }
        } else if instr.op == IrOpcode::IrUnaryOp {
            if instr.un_op == UnaryOp::OpRef || instr.un_op == UnaryOp::OpRefMut {
                out.legal_instr_count = out.legal_instr_count + 2
            } else {
                out.legal_instr_count = out.legal_instr_count + 3
            }
        } else if instr.op == IrOpcode::IrCall {
            if instr.arg_count > MIR_MAX_CALL_ARGS {
                out.supported = false
                out.unsupported_detail = "call_arity_gt_8"
                return out
            }
            let f128_args_pair = native_v2_collect_call_args(instr.call_args, [0; 8], 0)
            let f128_args = f128_args_pair.0
            var f128_ai: i64 = 0
            while f128_ai < f128_args_pair.1 {
                let arg_slot = f128_args[f128_ai as usize]
                if arg_slot >= 0 && arg_slot < 256 && is_f128_slot[arg_slot as usize] == 1 {
                    out.supported = false
                    out.unsupported_detail = "f128_call_arg_pending"
                    return out
                }
                f128_ai = f128_ai + 1
            }
            out.legal_instr_count = out.legal_instr_count + 1 + (instr.arg_count * 2)
            if instr.arg_count > 6 {
                let stack_count = instr.arg_count - 6
                out.legal_instr_count = out.legal_instr_count + stack_count
                if (stack_count % 2) != 0 {
                    out.legal_instr_count = out.legal_instr_count + 1
                }
                out.legal_instr_count = out.legal_instr_count + 1
            }
            if instr.dst >= 0 {
                out.legal_instr_count = out.legal_instr_count + 2
            }
        } else if instr.op == IrOpcode::IrCallSret {
            if instr.arg_count > MIR_MAX_CALL_ARGS {
                out.supported = false
                out.unsupported_detail = "sret_call_arity_gt_8"
                return out
            }
            let f128_sret_args_pair = native_v2_collect_call_args(instr.call_args, [0; 8], 0)
            let f128_sret_args = f128_sret_args_pair.0
            var f128_sret_ai: i64 = 0
            while f128_sret_ai < f128_sret_args_pair.1 {
                let arg_slot = f128_sret_args[f128_sret_ai as usize]
                if arg_slot >= 0 && arg_slot < 256 && is_f128_slot[arg_slot as usize] == 1 {
                    out.supported = false
                    out.unsupported_detail = "f128_call_arg_pending"
                    return out
                }
                f128_sret_ai = f128_sret_ai + 1
            }
            out.legal_instr_count = out.legal_instr_count + 3 + (instr.arg_count * 2)
            if instr.arg_count > 5 {
                let stack_count = instr.arg_count - 5
                out.legal_instr_count = out.legal_instr_count + stack_count
                if (stack_count % 2) != 0 {
                    out.legal_instr_count = out.legal_instr_count + 1
                }
                out.legal_instr_count = out.legal_instr_count + 1
            }
            if instr.dst >= 0 {
                out.legal_instr_count = out.legal_instr_count + 2
            }
        } else if instr.op == IrOpcode::IrReturn {
            if instr.src1 >= 0 {
                if instr.src1 < 256 && is_f128_slot[instr.src1 as usize] == 1 {
                    out.legal_instr_count = out.legal_instr_count + 3
                } else {
                    out.legal_instr_count = out.legal_instr_count + 2
                }
            } else {
                out.legal_instr_count = out.legal_instr_count + 1
            }
        } else if instr.op == IrOpcode::IrJump {
            out.legal_instr_count = out.legal_instr_count + 1
        } else if instr.op == IrOpcode::IrBranchTrue {
            out.legal_instr_count = out.legal_instr_count + 3
        } else if instr.op == IrOpcode::IrBranchFalse {
            out.legal_instr_count = out.legal_instr_count + 3
        } else if instr.op == IrOpcode::IrLabel {
            out.legal_instr_count = out.legal_instr_count + 1
        } else if instr.op == IrOpcode::IrAlloc {
            out.legal_instr_count = out.legal_instr_count + 2
        } else if instr.op == IrOpcode::IrFieldGet {
            out.legal_instr_count = out.legal_instr_count + 3
        } else if instr.op == IrOpcode::IrFieldSet {
            out.legal_instr_count = out.legal_instr_count + 3
        } else if instr.op == IrOpcode::IrIndexGet {
            out.legal_instr_count = out.legal_instr_count + 4
        } else if instr.op == IrOpcode::IrIndexSet {
            out.legal_instr_count = out.legal_instr_count + 4
        } else if instr.op == IrOpcode::IrLoadFloat {
            out.legal_instr_count = out.legal_instr_count + 1
            if instr.dst >= 0 && instr.dst < 256 {
                is_float_slot[instr.dst as usize] = 1
            }
        } else if instr.op == IrOpcode::IrIntToFloat {
            out.legal_instr_count = out.legal_instr_count + 1
            if instr.dst >= 0 && instr.dst < 256 {
                is_float_slot[instr.dst as usize] = 1
            }
        } else if instr.op == IrOpcode::IrFloatToInt {
            out.legal_instr_count = out.legal_instr_count + 1
            if instr.dst >= 0 && instr.dst < 256 {
                is_float_slot[instr.dst as usize] = 0
            }
        } else {
            out.supported = false
            out.unsupported_detail = "unknown_ir_opcode"
            return out
        }
        i = i + 1
    }

    out
}

pub fn native_v2_legalize_ir_summary(func: IrFunction) -> NativeV2LegalizeSummary with Mut, Panic, Div {
    native_v2_legalize_ir_summary_ref(&func)
}

fn native_v2_reset_machine_function_out(out: &! MachineFunction, base_slots: i64, source_count: i64) with Mut, Panic, Div {
    (*out).blocks[0].instr_count = 0
    (*out).block_count = 1
    (*out).temp_count = base_slots
    (*out).source_instr_count = source_count
    (*out).legal_instr_count = 0
    (*out).base_slot_count = base_slots
    (*out).supported = true
    (*out).unsupported_detail = ""
    var i: i64 = 0
    while i < 256 {
        (*out).is_float_slot[i as usize] = 0
        (*out).slot_kind[i as usize] = MIR_SLOT_KIND_UNKNOWN
        (*out).slot_width_words[i as usize] = 0
        (*out).f128_literal_sign[i as usize] = 0
        (*out).f128_literal_sig_hi[i as usize] = 0
        (*out).f128_literal_sig_lo[i as usize] = 0
        (*out).f128_literal_digit_count[i as usize] = 0
        (*out).f128_literal_scale10[i as usize] = 0
        (*out).f128_literal_truncated_digits[i as usize] = 0
        (*out).f128_literal_truncated_tail_info[i as usize] = 0
        i = i + 1
    }
}

pub fn native_v2_lower_legal_function_from_ir_ref(func: &IrFunction, out: &! MachineFunction) with Mut, Panic, Div, Alloc {
    native_v2_reset_machine_function_out(out, (*func).reg_count, (*func).instr_count)

    var i: i64 = 0
    while i < (*func).instr_count {
        let ir_instr = (*func).instrs[i as usize]
        if ir_instr.op == IrOpcode::IrNop {
            if ir_instr.imm_flags == IR_F128_REG_MARKER_FLAG {
                native_v2_mark_slot_ref(out, ir_instr.dst, MIR_SLOT_KIND_F128_BINARY128, 2)
                native_v2_mark_f128_literal_ref(out, ir_instr.dst, ir_instr.src1, ir_instr.src2, ir_instr.imm_i64, ir_instr.label_id, ir_instr.field_idx, ir_instr.arg_count, ir_instr.fn_id)
                if !native_v2_f128_literal_materializable(ir_instr.src1, ir_instr.src2, ir_instr.imm_i64, ir_instr.label_id, ir_instr.field_idx, ir_instr.arg_count) {
                    (*out).supported = false
                    (*out).unsupported_detail = "f128_decimal_materialization_pending"
                    return
                }
                i = i + 1
                continue
            }
            i = i + 1
            continue
        }
        if !native_v2_supported_ir_opcode(ir_instr.op) {
            (*out).supported = false
            (*out).unsupported_detail = native_v2_ir_opcode_name(ir_instr.op)
            return
        }
        let instr = native_v2_pseudo_from_ir(ir_instr)

        if instr.opcode == MIR_OP_PSEUDO_WIDE_META {
            let limbs = machine_instr_aux_value(instr)
            if limbs <= 1 || limbs > 64 {
                (*out).supported = false
                (*out).unsupported_detail = "wide_meta_bad_limb_count"
                return
            }
            native_v2_mark_wide_limb_range_ref(out, machine_instr_src1_value(instr), limbs)
            if instr.arg_index >= 2 {
                native_v2_mark_wide_limb_range_ref(out, machine_instr_src2_value(instr), limbs)
            }
            if instr.cond == 1 {
                native_v2_mark_slot_ref(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
            } else {
                native_v2_mark_wide_limb_range_ref(out, machine_instr_dst_value(instr), limbs)
            }
        } else if instr.opcode == MIR_OP_PSEUDO_LOAD_IMM {
            let temp = (*out).temp_count
            (*out).temp_count = temp + 1
            native_v2_emit_legal_instr_mut(out, native_v2_make_mov_imm(temp, machine_instr_src1_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
            native_v2_mark_slot_ref(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
        } else if instr.opcode == MIR_OP_PSEUDO_LOAD_STRING {
            let temp = (*out).temp_count
            (*out).temp_count = temp + 1
            let load = native_v2_make_load_data_addr(temp, machine_instr_name(instr))
            native_v2_emit_legal_instr_mut(out, load)
            native_v2_emit_legal_instr_mut(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
            native_v2_mark_slot_ref(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
        } else if instr.opcode == MIR_OP_PSEUDO_COPY {
            let src_slot = machine_instr_src1_value(instr)
            let dst_slot = machine_instr_dst_value(instr)
            let src_is_f128 = native_v2_slot_is_f128_ref(out, src_slot)
            let src_is_float = if src_slot >= 0 && src_slot < 256 { (*out).is_float_slot[src_slot as usize] } else { 0 }
            if src_is_f128 {
                let temp = (*out).temp_count
                (*out).temp_count = temp + 1
                native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(temp, src_slot))
                native_v2_emit_legal_instr_mut(out, native_v2_make_store_stack(dst_slot, temp))
                native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(temp, src_slot + 1))
                native_v2_emit_legal_instr_mut(out, native_v2_make_store_stack(dst_slot + 1, temp))
                native_v2_copy_slot_ref(out, dst_slot, src_slot)
            } else if src_is_float == 1 {
                native_v2_emit_legal_instr_mut(out, native_v2_make_float_move(dst_slot, src_slot))
                native_v2_copy_slot_ref(out, dst_slot, src_slot)
            } else {
                let temp = (*out).temp_count
                (*out).temp_count = temp + 1
                native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
                native_v2_emit_legal_instr_mut(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
                native_v2_copy_slot_ref(out, dst_slot, src_slot)
                if dst_slot >= 0 && dst_slot < 256 && (*out).slot_kind[dst_slot as usize] == MIR_SLOT_KIND_UNKNOWN {
                    native_v2_mark_slot_ref(out, dst_slot, MIR_SLOT_KIND_I64, 1)
                }
            }
        } else if instr.opcode == MIR_OP_PSEUDO_BINOP {
            let s1 = machine_instr_src1_value(instr)
            let s2 = machine_instr_src2_value(instr)
            if native_v2_slot_is_f128_ref(out, s1) || native_v2_slot_is_f128_ref(out, s2) {
                (*out).supported = false
                (*out).unsupported_detail = "f128_arithmetic_pending"
                return
            }
            let s1f = if s1 >= 0 && s1 < 256 { (*out).is_float_slot[s1 as usize] } else { 0 }
            let s2f = if s2 >= 0 && s2 < 256 { (*out).is_float_slot[s2 as usize] } else { 0 }
            if s1f == 1 || s2f == 1 {
                native_v2_emit_legal_instr_mut(out, native_v2_make_float_binop(machine_instr_dst_value(instr), s1, s2, machine_instr_bin_op(instr), s1f, s2f))
                let dslot = machine_instr_dst_value(instr)
                if dslot >= 0 && dslot < 256 {
                    if machine_instr_bin_op(instr) == BinaryOp::OpAdd || machine_instr_bin_op(instr) == BinaryOp::OpSub || machine_instr_bin_op(instr) == BinaryOp::OpMul || machine_instr_bin_op(instr) == BinaryOp::OpDiv {
                        native_v2_mark_slot_ref(out, dslot, MIR_SLOT_KIND_F64, 1)
                    } else {
                        native_v2_mark_slot_ref(out, dslot, MIR_SLOT_KIND_I64, 1)
                    }
                }
            } else {
                let lhs = (*out).temp_count
                (*out).temp_count = lhs + 1
                let rhs = (*out).temp_count
                (*out).temp_count = rhs + 1
                native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(lhs, machine_instr_src1_value(instr)))
                native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(rhs, machine_instr_src2_value(instr)))
                native_v2_emit_legal_instr_mut(out, native_v2_make_binop(lhs, rhs, machine_instr_bin_op(instr)))
                native_v2_emit_legal_instr_mut(out, native_v2_make_store_stack(machine_instr_dst_value(instr), lhs))
                native_v2_mark_slot_ref(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
            }
        } else if instr.opcode == MIR_OP_PSEUDO_UNARY {
            let temp = (*out).temp_count
            (*out).temp_count = temp + 1
            if machine_instr_un_op(instr) == UnaryOp::OpRef || machine_instr_un_op(instr) == UnaryOp::OpRefMut {
                native_v2_emit_legal_instr_mut(out, native_v2_make_lea_stack(temp, machine_instr_src1_value(instr)))
            } else {
                native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
                native_v2_emit_legal_instr_mut(out, native_v2_make_unary(temp, temp, machine_instr_un_op(instr)))
            }
            native_v2_emit_legal_instr_mut(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
            native_v2_mark_slot_ref(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
        } else if instr.opcode == MIR_OP_PSEUDO_CALL {
            if machine_instr_call_arg_count(instr) > MIR_MAX_CALL_ARGS {
                (*out).supported = false
                (*out).unsupported_detail = "call_arity_gt_8"
                return
            }
            var f128_ai: i64 = 0
            while f128_ai < machine_instr_call_arg_count(instr) {
                if native_v2_slot_is_f128_ref(out, machine_instr_call_arg_value(instr, f128_ai)) {
                    (*out).supported = false
                    (*out).unsupported_detail = "f128_call_arg_pending"
                    return
                }
                f128_ai = f128_ai + 1
            }
            let stack_count = if machine_instr_call_arg_count(instr) > 6 { machine_instr_call_arg_count(instr) - 6 } else { 0 }
            if (stack_count % 2) != 0 {
                native_v2_emit_legal_instr_mut(out, native_v2_make_stack_adjust(-8))
            }
            var si = machine_instr_call_arg_count(instr) - 1
            while si >= 6 {
                let temp = (*out).temp_count
                (*out).temp_count = temp + 1
                native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(temp, machine_instr_call_arg_value(instr, si)))
                native_v2_emit_legal_instr_mut(out, native_v2_make_stack_arg_push(si, temp))
                si = si - 1
            }
            var ai: i64 = 0
            let reg_argc = if machine_instr_call_arg_count(instr) > 6 { 6 } else { machine_instr_call_arg_count(instr) }
            while ai < machine_instr_call_arg_count(instr) {
                if ai >= reg_argc {
                    break
                }
                let temp = (*out).temp_count
                (*out).temp_count = temp + 1
                native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(temp, machine_instr_call_arg_value(instr, ai)))
                native_v2_emit_legal_instr_mut(out, native_v2_make_arg_move(ai, temp))
                ai = ai + 1
            }
            native_v2_emit_legal_instr_mut(out, native_v2_make_call(machine_instr_src1_value(instr)))
            if stack_count > 0 {
                var cleanup = stack_count * 8
                if (stack_count % 2) != 0 {
                    cleanup = cleanup + 8
                }
                native_v2_emit_legal_instr_mut(out, native_v2_make_stack_adjust(cleanup))
            }
            if machine_instr_dst_value(instr) >= 0 {
                let temp = (*out).temp_count
                (*out).temp_count = temp + 1
                native_v2_emit_legal_instr_mut(out, native_v2_make_capture_ret(temp))
                native_v2_emit_legal_instr_mut(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
                native_v2_mark_slot_ref(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
            }
        } else if instr.opcode == MIR_OP_PSEUDO_CALL_SRET {
            if machine_instr_call_arg_count(instr) > MIR_MAX_CALL_ARGS {
                (*out).supported = false
                (*out).unsupported_detail = "sret_call_arity_gt_8"
                return
            }
            var f128_sret_ai: i64 = 0
            while f128_sret_ai < machine_instr_call_arg_count(instr) {
                if native_v2_slot_is_f128_ref(out, machine_instr_call_arg_value(instr, f128_sret_ai)) {
                    (*out).supported = false
                    (*out).unsupported_detail = "f128_call_arg_pending"
                    return
                }
                f128_sret_ai = f128_sret_ai + 1
            }
            let dest_temp = (*out).temp_count
            (*out).temp_count = dest_temp + 1
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(dest_temp, machine_instr_src2_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_arg_move(0, dest_temp))
            let sret_stack_count = if machine_instr_call_arg_count(instr) > 5 { machine_instr_call_arg_count(instr) - 5 } else { 0 }
            if (sret_stack_count % 2) != 0 {
                native_v2_emit_legal_instr_mut(out, native_v2_make_stack_adjust(-8))
            }
            var sret_si = machine_instr_call_arg_count(instr) - 1
            while sret_si >= 5 {
                let temp = (*out).temp_count
                (*out).temp_count = temp + 1
                native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(temp, machine_instr_call_arg_value(instr, sret_si)))
                native_v2_emit_legal_instr_mut(out, native_v2_make_stack_arg_push(sret_si + 1, temp))
                sret_si = sret_si - 1
            }
            var sret_ai: i64 = 0
            let sret_reg_argc = if machine_instr_call_arg_count(instr) > 5 { 5 } else { machine_instr_call_arg_count(instr) }
            while sret_ai < machine_instr_call_arg_count(instr) {
                if sret_ai >= sret_reg_argc {
                    break
                }
                let temp = (*out).temp_count
                (*out).temp_count = temp + 1
                native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(temp, machine_instr_call_arg_value(instr, sret_ai)))
                native_v2_emit_legal_instr_mut(out, native_v2_make_arg_move(sret_ai + 1, temp))
                sret_ai = sret_ai + 1
            }
            native_v2_emit_legal_instr_mut(out, native_v2_make_call(machine_instr_src1_value(instr)))
            if sret_stack_count > 0 {
                var cleanup = sret_stack_count * 8
                if (sret_stack_count % 2) != 0 {
                    cleanup = cleanup + 8
                }
                native_v2_emit_legal_instr_mut(out, native_v2_make_stack_adjust(cleanup))
            }
            if machine_instr_dst_value(instr) >= 0 {
                let ret_temp = (*out).temp_count
                (*out).temp_count = ret_temp + 1
                native_v2_emit_legal_instr_mut(out, native_v2_make_capture_ret(ret_temp))
                native_v2_emit_legal_instr_mut(out, native_v2_make_store_stack(machine_instr_dst_value(instr), ret_temp))
                native_v2_mark_slot_ref(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
            }
        } else if instr.opcode == MIR_OP_PSEUDO_RET {
            if machine_instr_src1_kind(instr) == MIR_OPERAND_STACK_SLOT {
                if native_v2_slot_is_f128_ref(out, machine_instr_src1_value(instr)) {
                    let temp = (*out).temp_count
                    (*out).temp_count = temp + 1
                    let temp_hi = (*out).temp_count
                    (*out).temp_count = temp_hi + 1
                    native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
                    native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(temp_hi, machine_instr_src1_value(instr) + 1))
                    native_v2_emit_legal_instr_mut(out, native_v2_make_ret2(temp, temp_hi))
                } else {
                    let temp = (*out).temp_count
                    (*out).temp_count = temp + 1
                    native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
                    native_v2_emit_legal_instr_mut(out, native_v2_make_ret(temp))
                }
            } else {
                native_v2_emit_legal_instr_mut(out, native_v2_make_ret(0 - 1))
            }
        } else if instr.opcode == MIR_OP_PSEUDO_RET_SRET {
            if machine_instr_src1_kind(instr) == MIR_OPERAND_STACK_SLOT {
                if native_v2_slot_is_f128_ref(out, machine_instr_src1_value(instr)) {
                    (*out).supported = false
                    (*out).unsupported_detail = "f128_return_pending"
                    return
                }
                let temp = (*out).temp_count
                (*out).temp_count = temp + 1
                native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
                native_v2_emit_legal_instr_mut(out, native_v2_make_ret(temp))
            } else {
                native_v2_emit_legal_instr_mut(out, native_v2_make_ret(0 - 1))
            }
        } else if instr.opcode == MIR_OP_PSEUDO_JUMP {
            native_v2_emit_legal_instr_mut(out, native_v2_make_jump(machine_instr_dst_value(instr)))
        } else if instr.opcode == MIR_OP_PSEUDO_BRANCH_TRUE {
            let temp = (*out).temp_count
            (*out).temp_count = temp + 1
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_cmp_zero(temp))
            native_v2_emit_legal_instr_mut(out, native_v2_make_jcc(machine_instr_dst_value(instr), MIR_CC_NZ))
        } else if instr.opcode == MIR_OP_PSEUDO_BRANCH_FALSE {
            let temp = (*out).temp_count
            (*out).temp_count = temp + 1
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_cmp_zero(temp))
            native_v2_emit_legal_instr_mut(out, native_v2_make_jcc(machine_instr_dst_value(instr), MIR_CC_Z))
        } else if instr.opcode == MIR_OP_PSEUDO_LABEL {
            native_v2_emit_legal_instr_mut(out, native_v2_make_label(machine_instr_dst_value(instr)))
        } else if instr.opcode == MIR_OP_PSEUDO_ALLOC {
            let temp = (*out).temp_count
            (*out).temp_count = temp + 1
            native_v2_emit_legal_instr_mut(out, native_v2_make_alloc(temp, native_v2_alloc_size_from_tag(machine_instr_src1_value(instr)), native_v2_alloc_descriptor_from_tag(machine_instr_src1_value(instr))))
            native_v2_emit_legal_instr_mut(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
            native_v2_mark_slot_ref(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
        } else if instr.opcode == MIR_OP_PSEUDO_FIELD_GET {
            let base = (*out).temp_count
            (*out).temp_count = base + 1
            let dst = (*out).temp_count
            (*out).temp_count = dst + 1
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(base, machine_instr_src1_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_field_load(dst, base, machine_instr_aux_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_store_stack(machine_instr_dst_value(instr), dst))
            native_v2_mark_slot_ref(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
        } else if instr.opcode == MIR_OP_PSEUDO_FIELD_SET {
            let base = (*out).temp_count
            (*out).temp_count = base + 1
            let src = (*out).temp_count
            (*out).temp_count = src + 1
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(base, machine_instr_src1_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(src, machine_instr_src2_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_field_store(base, src, machine_instr_aux_value(instr)))
        } else if instr.opcode == MIR_OP_PSEUDO_INDEX_GET {
            let base = (*out).temp_count
            (*out).temp_count = base + 1
            let idx = (*out).temp_count
            (*out).temp_count = idx + 1
            let dst = (*out).temp_count
            (*out).temp_count = dst + 1
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(base, machine_instr_src1_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(idx, machine_instr_src2_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_index_load(dst, base, idx))
            native_v2_emit_legal_instr_mut(out, native_v2_make_store_stack(machine_instr_dst_value(instr), dst))
            native_v2_mark_slot_ref(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
        } else if instr.opcode == MIR_OP_PSEUDO_INDEX_SET {
            let base = (*out).temp_count
            (*out).temp_count = base + 1
            let idx = (*out).temp_count
            (*out).temp_count = idx + 1
            let src = (*out).temp_count
            (*out).temp_count = src + 1
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(base, machine_instr_src1_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(idx, machine_instr_src2_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_stack(src, machine_instr_aux_value(instr)))
            native_v2_emit_legal_instr_mut(out, native_v2_make_index_store(base, idx, src))
        } else if instr.opcode == MIR_OP_PSEUDO_LOAD_FLOAT {
            native_v2_emit_legal_instr_mut(out, native_v2_make_load_float_rip(machine_instr_dst_value(instr), machine_instr_src1_value(instr)))
            native_v2_mark_slot_ref(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_F64, 1)
        } else if instr.opcode == MIR_OP_PSEUDO_INT_TO_FLOAT {
            native_v2_emit_legal_instr_mut(out, native_v2_make_int_to_float(machine_instr_dst_value(instr), machine_instr_src1_value(instr)))
            native_v2_mark_slot_ref(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_F64, 1)
        } else if instr.opcode == MIR_OP_PSEUDO_FLOAT_TO_INT {
            native_v2_emit_legal_instr_mut(out, native_v2_make_float_to_int(machine_instr_dst_value(instr), machine_instr_src1_value(instr)))
            native_v2_mark_slot_ref(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
        }
        i = i + 1
    }

    if (*out).legal_instr_count <= 0 {
        (*out).legal_instr_count = (*out).blocks[0].instr_count
    }
}

pub fn native_v2_legalize_function(func: MachineFunction) -> MachineFunction with Mut, Panic, Div {
    var out = machine_function_new()
    out.base_slot_count = func.base_slot_count
    out.temp_count = func.base_slot_count
    out.source_instr_count = func.source_instr_count
    if !func.supported {
        out.supported = false
        out.unsupported_detail = func.unsupported_detail
        return out
    }

    var i: i64 = 0
    while i < func.blocks[0].instr_count {
        let instr = func.blocks[0].instrs[i as usize]

        if instr.opcode == MIR_OP_PSEUDO_WIDE_META {
            let limbs = machine_instr_aux_value(instr)
            if limbs <= 1 || limbs > 64 {
                out.supported = false
                out.unsupported_detail = "wide_meta_bad_limb_count"
                return out
            }
            out = native_v2_mark_wide_limb_range_byval(out, machine_instr_src1_value(instr), limbs)
            if instr.arg_index >= 2 {
                out = native_v2_mark_wide_limb_range_byval(out, machine_instr_src2_value(instr), limbs)
            }
            if instr.cond == 1 {
                out = native_v2_mark_slot_byval(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
            } else {
                out = native_v2_mark_wide_limb_range_byval(out, machine_instr_dst_value(instr), limbs)
            }
        } else if instr.opcode == MIR_OP_PSEUDO_F128_META {
            out = native_v2_mark_slot_byval(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_F128_BINARY128, 2)
            out = native_v2_mark_f128_literal_byval(out, machine_instr_dst_value(instr), machine_instr_src1_value(instr), machine_instr_src2_value(instr), machine_instr_aux_value(instr), instr.cond, instr.arg_index, instr.call_arg_count, 0)
            if !native_v2_f128_literal_materializable(machine_instr_src1_value(instr), machine_instr_src2_value(instr), machine_instr_aux_value(instr), instr.cond, instr.arg_index, instr.call_arg_count) {
                out.supported = false
                out.unsupported_detail = "f128_decimal_materialization_pending"
                return out
            }
        } else if instr.opcode == MIR_OP_PSEUDO_LOAD_IMM {
            let temp = out.temp_count
            out.temp_count = temp + 1
            out = _emit_legal_byval(out, native_v2_make_mov_imm(temp, machine_instr_src1_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
            out = native_v2_mark_slot_byval(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
        } else if instr.opcode == MIR_OP_PSEUDO_LOAD_STRING {
            let temp = out.temp_count
            out.temp_count = temp + 1
            let load = native_v2_make_load_data_addr(temp, machine_instr_name(instr))
            out = _emit_legal_byval(out, load)
            out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
            out = native_v2_mark_slot_byval(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
        } else if instr.opcode == MIR_OP_PSEUDO_COPY {
            // Sprint 87: propagate float-ness for COPY
            let src_slot = machine_instr_src1_value(instr)
            let dst_slot = machine_instr_dst_value(instr)
            let src_is_f128 = native_v2_slot_is_f128_byval(out, src_slot)
            let src_is_float = if src_slot >= 0 && src_slot < 256 { out.is_float_slot[src_slot as usize] } else { 0 }
            if src_is_f128 {
                let temp = out.temp_count
                out.temp_count = temp + 1
                out = _emit_legal_byval(out, native_v2_make_load_stack(temp, src_slot))
                out = _emit_legal_byval(out, native_v2_make_store_stack(dst_slot, temp))
                out = _emit_legal_byval(out, native_v2_make_load_stack(temp, src_slot + 1))
                out = _emit_legal_byval(out, native_v2_make_store_stack(dst_slot + 1, temp))
                out = native_v2_copy_slot_byval(out, dst_slot, src_slot)
            } else if src_is_float == 1 {
                out = _emit_legal_byval(out, native_v2_make_float_move(dst_slot, src_slot))
                out = native_v2_copy_slot_byval(out, dst_slot, src_slot)
            } else {
                let temp = out.temp_count
                out.temp_count = temp + 1
                out = _emit_legal_byval(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
                out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
                out = native_v2_copy_slot_byval(out, dst_slot, src_slot)
                if dst_slot >= 0 && dst_slot < 256 && out.slot_kind[dst_slot as usize] == MIR_SLOT_KIND_UNKNOWN {
                    out = native_v2_mark_slot_byval(out, dst_slot, MIR_SLOT_KIND_I64, 1)
                }
            }
        } else if instr.opcode == MIR_OP_PSEUDO_BINOP {
            // Sprint 87: check if either operand is a float slot → emit FLOAT_BINOP
            let s1 = machine_instr_src1_value(instr)
            let s2 = machine_instr_src2_value(instr)
            var f128_done: bool = false
            if native_v2_slot_is_f128_byval(out, s1) || native_v2_slot_is_f128_byval(out, s2) {
                let a = native_v2_f128_hundredths_from_slot(out, s1)
                let b = native_v2_f128_hundredths_from_slot(out, s2)
                var result_hundredths: i64 = 0 - 1
                if a >= 0 && b >= 0 {
                    if machine_instr_bin_op(instr) == BinaryOp::OpAdd { result_hundredths = a + b }
                    if machine_instr_bin_op(instr) == BinaryOp::OpSub && a >= b { result_hundredths = a - b }
                    if machine_instr_bin_op(instr) == BinaryOp::OpMul && ((a * b) % 100) == 0 { result_hundredths = (a * b) / 100 }
                    if machine_instr_bin_op(instr) == BinaryOp::OpDiv && b != 0 && ((a * 100) % b) == 0 { result_hundredths = (a * 100) / b }
                }
                if !native_v2_f128_value_contract_supported_hundredths(result_hundredths) {
                    out.supported = false
                    out.unsupported_detail = "f128_arithmetic_pending"
                    return out
                }
                let result_hi = native_v2_f128_value_contract_hi_from_hundredths(result_hundredths)
                let hi_temp = out.temp_count
                out.temp_count = hi_temp + 1
                let lo_temp = out.temp_count
                out.temp_count = lo_temp + 1
                out = _emit_legal_byval(out, native_v2_make_mov_imm(hi_temp, result_hi))
                out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), hi_temp))
                out = _emit_legal_byval(out, native_v2_make_mov_imm(lo_temp, 0))
                out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr) + 1, lo_temp))
                out = native_v2_mark_slot_byval(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_F128_BINARY128, 2)
                if result_hundredths == 25 {
                    out = native_v2_mark_f128_literal_byval(out, machine_instr_dst_value(instr), 1, 0, 25, 3, 2, 0, 0)
                } else {
                    out = native_v2_mark_f128_literal_byval(out, machine_instr_dst_value(instr), 1, 0, result_hundredths / 10, 2, 1, 0, 0)
                }
                f128_done = true
            }
            let s1f = if s1 >= 0 && s1 < 256 { out.is_float_slot[s1 as usize] } else { 0 }
            let s2f = if s2 >= 0 && s2 < 256 { out.is_float_slot[s2 as usize] } else { 0 }
            if f128_done == false {
                if s1f == 1 || s2f == 1 {
                    out = _emit_legal_byval(out, native_v2_make_float_binop(machine_instr_dst_value(instr), s1, s2, machine_instr_bin_op(instr), s1f, s2f))
                    let dslot = machine_instr_dst_value(instr)
                    if dslot >= 0 && dslot < 256 {
                        if machine_instr_bin_op(instr) == BinaryOp::OpAdd || machine_instr_bin_op(instr) == BinaryOp::OpSub || machine_instr_bin_op(instr) == BinaryOp::OpMul || machine_instr_bin_op(instr) == BinaryOp::OpDiv {
                            out = native_v2_mark_slot_byval(out, dslot, MIR_SLOT_KIND_F64, 1)
                        } else {
                            out = native_v2_mark_slot_byval(out, dslot, MIR_SLOT_KIND_I64, 1)
                        }
                    }
                } else {
                    let lhs = out.temp_count
                    out.temp_count = lhs + 1
                    let rhs = out.temp_count
                    out.temp_count = rhs + 1
                    out = _emit_legal_byval(out, native_v2_make_load_stack(lhs, machine_instr_src1_value(instr)))
                    out = _emit_legal_byval(out, native_v2_make_load_stack(rhs, machine_instr_src2_value(instr)))
                    out = _emit_legal_byval(out, native_v2_make_binop(lhs, rhs, machine_instr_bin_op(instr)))
                    out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), lhs))
                    out = native_v2_mark_slot_byval(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
                }
            }
        } else if instr.opcode == MIR_OP_PSEUDO_UNARY {
            let temp = out.temp_count
            out.temp_count = temp + 1
            if machine_instr_un_op(instr) == UnaryOp::OpRef || machine_instr_un_op(instr) == UnaryOp::OpRefMut {
                out = _emit_legal_byval(out, native_v2_make_lea_stack(temp, machine_instr_src1_value(instr)))
            } else {
                out = _emit_legal_byval(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
                out = _emit_legal_byval(out, native_v2_make_unary(temp, temp, machine_instr_un_op(instr)))
            }
            out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
            out = native_v2_mark_slot_byval(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
        } else if instr.opcode == MIR_OP_PSEUDO_CALL {
            if machine_instr_call_arg_count(instr) > MIR_MAX_CALL_ARGS {
                out.supported = false
                out.unsupported_detail = "call_arity_gt_8"
                return out
            }
            var f128_ai: i64 = 0
            var f128_count: i64 = 0
            var expanded_arg_count: i64 = 0
            while f128_ai < machine_instr_call_arg_count(instr) {
                if native_v2_slot_is_f128_byval(out, machine_instr_call_arg_value(instr, f128_ai)) {
                    f128_count = f128_count + 1
                    expanded_arg_count = expanded_arg_count + 2
                } else {
                    expanded_arg_count = expanded_arg_count + 1
                }
                f128_ai = f128_ai + 1
            }
            let stack_count = if f128_count > 0 { if expanded_arg_count > 6 { expanded_arg_count - 6 } else { 0 } } else if machine_instr_call_arg_count(instr) > 6 { machine_instr_call_arg_count(instr) - 6 } else { 0 }
            if (stack_count % 2) != 0 {
                out = _emit_legal_byval(out, native_v2_make_stack_adjust(-8))
            }
            if f128_count > 0 {
                var f128_si = expanded_arg_count - 1
                while f128_si >= 6 {
                    let temp = out.temp_count
                    out.temp_count = temp + 1
                    var scan_ai: i64 = 0
                    var scan_abi: i64 = 0
                    var found_slot: i64 = -1
                    while scan_ai < machine_instr_call_arg_count(instr) {
                        let arg_slot = machine_instr_call_arg_value(instr, scan_ai)
                        if native_v2_slot_is_f128_byval(out, arg_slot) {
                            if f128_si == scan_abi { found_slot = arg_slot }
                            if f128_si == scan_abi + 1 { found_slot = arg_slot + 1 }
                            scan_abi = scan_abi + 2
                        } else {
                            if f128_si == scan_abi { found_slot = arg_slot }
                            scan_abi = scan_abi + 1
                        }
                        scan_ai = scan_ai + 1
                    }
                    if found_slot < 0 {
                        out.supported = false
                        out.unsupported_detail = "f128_call_arg_pending"
                        return out
                    }
                    out = _emit_legal_byval(out, native_v2_make_load_stack(temp, found_slot))
                    out = _emit_legal_byval(out, native_v2_make_stack_arg_push(f128_si, temp))
                    f128_si = f128_si - 1
                }
            } else {
                var si = machine_instr_call_arg_count(instr) - 1
                while si >= 6 {
                    let temp = out.temp_count
                    out.temp_count = temp + 1
                    out = _emit_legal_byval(out, native_v2_make_load_stack(temp, machine_instr_call_arg_value(instr, si)))
                    out = _emit_legal_byval(out, native_v2_make_stack_arg_push(si, temp))
                    si = si - 1
                }
            }
            var ai: i64 = 0
            var abi_i: i64 = 0
            let reg_argc = if f128_count > 0 { machine_instr_call_arg_count(instr) } else if machine_instr_call_arg_count(instr) > 6 { 6 } else { machine_instr_call_arg_count(instr) }
            while ai < reg_argc {
                let temp = out.temp_count
                out.temp_count = temp + 1
                let arg_slot = machine_instr_call_arg_value(instr, ai)
                if native_v2_slot_is_f128_byval(out, arg_slot) {
                    if abi_i < 6 {
                        out = _emit_legal_byval(out, native_v2_make_load_stack(temp, arg_slot))
                        out = _emit_legal_byval(out, native_v2_make_arg_move(abi_i, temp))
                    }
                    if abi_i + 1 < 6 {
                        let temp2 = out.temp_count
                        out.temp_count = temp2 + 1
                        out = _emit_legal_byval(out, native_v2_make_load_stack(temp2, arg_slot + 1))
                        out = _emit_legal_byval(out, native_v2_make_arg_move(abi_i + 1, temp2))
                    }
                    abi_i = abi_i + 2
                } else {
                    out = _emit_legal_byval(out, native_v2_make_load_stack(temp, arg_slot))
                    out = _emit_legal_byval(out, native_v2_make_arg_move(abi_i, temp))
                    abi_i = abi_i + 1
                }
                ai = ai + 1
            }
            out = _emit_legal_byval(out, native_v2_make_call(machine_instr_src1_value(instr)))
            if stack_count > 0 {
                var cleanup = stack_count * 8
                if (stack_count % 2) != 0 {
                    cleanup = cleanup + 8
                }
                out = _emit_legal_byval(out, native_v2_make_stack_adjust(cleanup))
            }
            if machine_instr_dst_value(instr) >= 0 {
                let temp = out.temp_count
                out.temp_count = temp + 1
                if instr.cond == 1 {
                    let temp_hi = out.temp_count
                    out.temp_count = temp_hi + 1
                    out = _emit_legal_byval(out, native_v2_make_capture_ret_word(temp, 0))
                    out = _emit_legal_byval(out, native_v2_make_capture_ret_word(temp_hi, 1))
                    out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
                    out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr) + 1, temp_hi))
                    out = native_v2_mark_slot_byval(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_F128_BINARY128, 2)
                } else {
                    out = _emit_legal_byval(out, native_v2_make_capture_ret(temp))
                    out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
                    out = native_v2_mark_slot_byval(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
                }
            }
        } else if instr.opcode == MIR_OP_PSEUDO_CALL_SRET {
            if machine_instr_call_arg_count(instr) > MIR_MAX_CALL_ARGS {
                out.supported = false
                out.unsupported_detail = "sret_call_arity_gt_8"
                return out
            }
            var f128_sret_ai: i64 = 0
            while f128_sret_ai < machine_instr_call_arg_count(instr) {
                if native_v2_slot_is_f128_byval(out, machine_instr_call_arg_value(instr, f128_sret_ai)) {
                    out.supported = false
                    out.unsupported_detail = "f128_call_arg_pending"
                    return out
                }
                f128_sret_ai = f128_sret_ai + 1
            }
            let dest_temp = out.temp_count
            out.temp_count = dest_temp + 1
            out = _emit_legal_byval(out, native_v2_make_load_stack(dest_temp, machine_instr_src2_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_arg_move(0, dest_temp))
            let sret_stack_count = if machine_instr_call_arg_count(instr) > 5 { machine_instr_call_arg_count(instr) - 5 } else { 0 }
            if (sret_stack_count % 2) != 0 {
                out = _emit_legal_byval(out, native_v2_make_stack_adjust(-8))
            }
            var sret_si = machine_instr_call_arg_count(instr) - 1
            while sret_si >= 5 {
                let temp = out.temp_count
                out.temp_count = temp + 1
                out = _emit_legal_byval(out, native_v2_make_load_stack(temp, machine_instr_call_arg_value(instr, sret_si)))
                out = _emit_legal_byval(out, native_v2_make_stack_arg_push(sret_si + 1, temp))
                sret_si = sret_si - 1
            }
            var sret_ai: i64 = 0
            let sret_reg_argc = if machine_instr_call_arg_count(instr) > 5 { 5 } else { machine_instr_call_arg_count(instr) }
            while sret_ai < machine_instr_call_arg_count(instr) {
                if sret_ai >= sret_reg_argc {
                    break
                }
                let temp = out.temp_count
                out.temp_count = temp + 1
                out = _emit_legal_byval(out, native_v2_make_load_stack(temp, machine_instr_call_arg_value(instr, sret_ai)))
                out = _emit_legal_byval(out, native_v2_make_arg_move(sret_ai + 1, temp))
                sret_ai = sret_ai + 1
            }
            out = _emit_legal_byval(out, native_v2_make_call(machine_instr_src1_value(instr)))
            if sret_stack_count > 0 {
                var cleanup = sret_stack_count * 8
                if (sret_stack_count % 2) != 0 {
                    cleanup = cleanup + 8
                }
                out = _emit_legal_byval(out, native_v2_make_stack_adjust(cleanup))
            }
            if machine_instr_dst_value(instr) >= 0 {
                let ret_temp = out.temp_count
                out.temp_count = ret_temp + 1
                out = _emit_legal_byval(out, native_v2_make_capture_ret(ret_temp))
                out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), ret_temp))
                out = native_v2_mark_slot_byval(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
            }
        } else if instr.opcode == MIR_OP_PSEUDO_RET {
            if machine_instr_src1_kind(instr) == MIR_OPERAND_STACK_SLOT {
                if native_v2_slot_is_f128_byval(out, machine_instr_src1_value(instr)) {
                    let temp = out.temp_count
                    out.temp_count = temp + 1
                    let temp_hi = out.temp_count
                    out.temp_count = temp_hi + 1
                    out = _emit_legal_byval(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
                    out = _emit_legal_byval(out, native_v2_make_load_stack(temp_hi, machine_instr_src1_value(instr) + 1))
                    out = _emit_legal_byval(out, native_v2_make_ret2(temp, temp_hi))
                } else {
                    let temp = out.temp_count
                    out.temp_count = temp + 1
                    out = _emit_legal_byval(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
                    out = _emit_legal_byval(out, native_v2_make_ret(temp))
                }
            } else {
                out = _emit_legal_byval(out, native_v2_make_ret(0 - 1))
            }
        } else if instr.opcode == MIR_OP_PSEUDO_RET_SRET {
            if machine_instr_src1_kind(instr) == MIR_OPERAND_STACK_SLOT {
                if native_v2_slot_is_f128_byval(out, machine_instr_src1_value(instr)) {
                    out.supported = false
                    out.unsupported_detail = "f128_return_pending"
                    return out
                }
                let temp = out.temp_count
                out.temp_count = temp + 1
                out = _emit_legal_byval(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
                out = _emit_legal_byval(out, native_v2_make_ret(temp))
            } else {
                out = _emit_legal_byval(out, native_v2_make_ret(0 - 1))
            }
        } else if instr.opcode == MIR_OP_PSEUDO_JUMP {
            out = _emit_legal_byval(out, native_v2_make_jump(machine_instr_dst_value(instr)))
        } else if instr.opcode == MIR_OP_PSEUDO_BRANCH_TRUE {
            let temp = out.temp_count
            out.temp_count = temp + 1
            out = _emit_legal_byval(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_cmp_zero(temp))
            out = _emit_legal_byval(out, native_v2_make_jcc(machine_instr_dst_value(instr), MIR_CC_NZ))
        } else if instr.opcode == MIR_OP_PSEUDO_BRANCH_FALSE {
            let temp = out.temp_count
            out.temp_count = temp + 1
            out = _emit_legal_byval(out, native_v2_make_load_stack(temp, machine_instr_src1_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_cmp_zero(temp))
            out = _emit_legal_byval(out, native_v2_make_jcc(machine_instr_dst_value(instr), MIR_CC_Z))
        } else if instr.opcode == MIR_OP_PSEUDO_LABEL {
            out = _emit_legal_byval(out, native_v2_make_label(machine_instr_dst_value(instr)))
        } else if instr.opcode == MIR_OP_PSEUDO_ALLOC {
            let temp = out.temp_count
            out.temp_count = temp + 1
            out = _emit_legal_byval(out, native_v2_make_alloc(temp, native_v2_alloc_size_from_tag(machine_instr_src1_value(instr)), native_v2_alloc_descriptor_from_tag(machine_instr_src1_value(instr))))
            out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), temp))
            out = native_v2_mark_slot_byval(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
        } else if instr.opcode == MIR_OP_PSEUDO_FIELD_GET {
            let base = out.temp_count
            out.temp_count = base + 1
            let dst = out.temp_count
            out.temp_count = dst + 1
            out = _emit_legal_byval(out, native_v2_make_load_stack(base, machine_instr_src1_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_field_load(dst, base, machine_instr_aux_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), dst))
            out = native_v2_mark_slot_byval(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
        } else if instr.opcode == MIR_OP_PSEUDO_FIELD_SET {
            let base = out.temp_count
            out.temp_count = base + 1
            let src = out.temp_count
            out.temp_count = src + 1
            out = _emit_legal_byval(out, native_v2_make_load_stack(base, machine_instr_src1_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_load_stack(src, machine_instr_src2_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_field_store(base, src, machine_instr_aux_value(instr)))
        } else if instr.opcode == MIR_OP_PSEUDO_INDEX_GET {
            let base = out.temp_count
            out.temp_count = base + 1
            let idx = out.temp_count
            out.temp_count = idx + 1
            let dst = out.temp_count
            out.temp_count = dst + 1
            out = _emit_legal_byval(out, native_v2_make_load_stack(base, machine_instr_src1_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_load_stack(idx, machine_instr_src2_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_index_load(dst, base, idx))
            out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), dst))
            out = native_v2_mark_slot_byval(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
        } else if instr.opcode == MIR_OP_PSEUDO_INDEX_SET {
            let base = out.temp_count
            out.temp_count = base + 1
            let idx = out.temp_count
            out.temp_count = idx + 1
            let src = out.temp_count
            out.temp_count = src + 1
            out = _emit_legal_byval(out, native_v2_make_load_stack(base, machine_instr_src1_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_load_stack(idx, machine_instr_src2_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_load_stack(src, machine_instr_aux_value(instr)))
            out = _emit_legal_byval(out, native_v2_make_index_store(base, idx, src))
        } else if instr.opcode == MIR_OP_PSEUDO_LOAD_FLOAT {
            // Sprint 87: float literal → LOAD_FLOAT_RIP stack slot
            out = _emit_legal_byval(out, native_v2_make_load_float_rip(machine_instr_dst_value(instr), machine_instr_src1_value(instr)))
            out = native_v2_mark_slot_byval(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_F64, 1)
        } else if instr.opcode == MIR_OP_PSEUDO_INT_TO_FLOAT {
            // Sprint 87: int stack slot → CVTSI2SD → float stack slot
            out = _emit_legal_byval(out, native_v2_make_int_to_float(machine_instr_dst_value(instr), machine_instr_src1_value(instr)))
            out = native_v2_mark_slot_byval(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_F64, 1)
        } else if instr.opcode == MIR_OP_PSEUDO_FLOAT_TO_INT {
            // Sprint 87: float stack slot → CVTTSD2SI → int stack slot
            out = _emit_legal_byval(out, native_v2_make_float_to_int(machine_instr_dst_value(instr), machine_instr_src1_value(instr)))
            out = native_v2_mark_slot_byval(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
        } else if instr.opcode == MIR_OP_PSEUDO_LOAD_GLOBAL {
            let addr_temp = out.temp_count
            out.temp_count = addr_temp + 1
            let val_temp = out.temp_count
            out.temp_count = val_temp + 1
            out = _emit_legal_byval(out, native_v2_make_mov_imm(addr_temp, machine_instr_src1_value(instr)))
            var load_mi = machine_empty_instr()
            load_mi.opcode = MIR_OP_LOAD_ABS
            load_mi.dst = machine_operand_gpr64(val_temp)
            load_mi.src1 = machine_operand_gpr64(addr_temp)
            out = _emit_legal_byval(out, load_mi)
            out = _emit_legal_byval(out, native_v2_make_store_stack(machine_instr_dst_value(instr), val_temp))
            out = native_v2_mark_slot_byval(out, machine_instr_dst_value(instr), MIR_SLOT_KIND_I64, 1)
        } else if instr.opcode == MIR_OP_PSEUDO_STORE_GLOBAL {
            let val_temp = out.temp_count
            out.temp_count = val_temp + 1
            out = _emit_legal_byval(out, native_v2_make_load_stack(val_temp, machine_instr_src1_value(instr)))
            var store_mi = machine_empty_instr()
            store_mi.opcode = MIR_OP_STORE_ABS
            store_mi.src1 = machine_operand_gpr64(val_temp)
            store_mi.src2 = machine_operand_imm64(machine_instr_src2_value(instr))
            out = _emit_legal_byval(out, store_mi)
        }
        i = i + 1
    }

    if out.legal_instr_count <= 0 {
        out.legal_instr_count = out.blocks[0].instr_count
    }
    out
}

pub fn native_v2_machine_instr_is_legal(instr: MachineInstr) -> bool with Mut, Panic, Div {
    if instr.opcode == MIR_OP_LOAD_STACK {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_STACK_SLOT
    }
    if instr.opcode == MIR_OP_STORE_STACK {
        return instr.dst.kind == MIR_OPERAND_STACK_SLOT && instr.src1.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_MOV_IMM {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_IMM64
    }
    if instr.opcode == MIR_OP_LOAD_DATA_ADDR {
        return instr.dst.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_MOVE {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_BINOP {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_UNARY {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_CMP_ZERO {
        return instr.src1.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_SETCC {
        return instr.dst.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_JMP {
        return instr.dst.kind == MIR_OPERAND_LABEL
    }
    if instr.opcode == MIR_OP_JCC {
        return instr.dst.kind == MIR_OPERAND_LABEL && instr.cond != MIR_CC_NONE
    }
    if instr.opcode == MIR_OP_LABEL {
        return instr.dst.kind == MIR_OPERAND_LABEL
    }
    if instr.opcode == MIR_OP_ARG_MOVE {
        return instr.src1.kind == MIR_OPERAND_GPR64 && instr.arg_index >= 0 && instr.arg_index < 6
    }
    if instr.opcode == MIR_OP_STACK_ADJUST {
        return instr.src1.kind == MIR_OPERAND_IMM64
    }
    if instr.opcode == MIR_OP_STACK_ARG_PUSH {
        return instr.src1.kind == MIR_OPERAND_GPR64 && instr.arg_index >= 6 && instr.arg_index <= MIR_MAX_CALL_ARGS
    }
    if instr.opcode == MIR_OP_CALL {
        return instr.src1.kind == MIR_OPERAND_CALL_TARGET
    }
    if instr.opcode == MIR_OP_CAPTURE_RET {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.cond >= 0 && instr.cond <= 1
    }
    if instr.opcode == MIR_OP_RET {
        if instr.cond == 1 {
            return instr.src1.kind == MIR_OPERAND_GPR64 && instr.src2.kind == MIR_OPERAND_GPR64
        }
        return instr.src1.kind == MIR_OPERAND_NONE || instr.src1.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_ALLOC {
        return instr.dst.kind == MIR_OPERAND_GPR64
            && instr.src1.kind == MIR_OPERAND_IMM64
            && (instr.aux.kind == MIR_OPERAND_NONE || instr.aux.kind == MIR_OPERAND_IMM64)
    }
    if instr.opcode == MIR_OP_FIELD_LOAD {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_GPR64 && instr.aux.kind == MIR_OPERAND_IMM64
    }
    if instr.opcode == MIR_OP_FIELD_STORE {
        return instr.src1.kind == MIR_OPERAND_GPR64 && instr.src2.kind == MIR_OPERAND_GPR64 && instr.aux.kind == MIR_OPERAND_IMM64
    }
    if instr.opcode == MIR_OP_INDEX_LOAD {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_GPR64 && instr.src2.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_INDEX_STORE {
        return instr.src1.kind == MIR_OPERAND_GPR64 && instr.src2.kind == MIR_OPERAND_GPR64 && instr.aux.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_LEA_STACK {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_STACK_SLOT
    }
    if instr.opcode == MIR_OP_LOAD_ABS {
        return instr.dst.kind == MIR_OPERAND_GPR64 && instr.src1.kind == MIR_OPERAND_GPR64
    }
    if instr.opcode == MIR_OP_STORE_ABS {
        return instr.src1.kind == MIR_OPERAND_GPR64 && instr.src2.kind == MIR_OPERAND_IMM64
    }
    false
}

pub fn native_v2_machine_function_is_legal(func: MachineFunction) -> bool with Mut, Panic, Div {
    if !func.supported { return false }
    var i: i64 = 0
    while i < func.blocks[0].instr_count {
        if !native_v2_machine_instr_is_legal(func.blocks[0].instrs[i as usize]) {
            return false
        }
        i = i + 1
    }
    true
}

pub fn native_v2_build_machine_module(module: &IrModule, enable_x86: bool) -> MachineModule with Mut, Panic, Div, Alloc {
    var out = machine_module_new()
    out.fn_count = module.fn_count
    out.total_ir_instr_count = 0
    out.active = enable_x86
    if enable_x86 {
        var target = empty_name()
        target.buf[0] = 120 as i8
        target.buf[1] = 56 as i8
        target.buf[2] = 54 as i8
        target.buf[3] = 95 as i8
        target.buf[4] = 54 as i8
        target.buf[5] = 52 as i8
        target.buf[6] = 45 as i8
        target.buf[7] = 108 as i8
        target.buf[8] = 105 as i8
        target.buf[9] = 110 as i8
        target.buf[10] = 117 as i8
        target.buf[11] = 120 as i8
        target.len = 12
        out.targets[0] = target
        out.target_count = 1
    }

    var i: i64 = 0
    while i < module.fn_count {
        let lowered = native_v2_lower_function_to_machine(module.functions[i as usize])
        out.total_ir_instr_count = out.total_ir_instr_count + lowered.source_instr_count
        let legal = native_v2_legalize_function(lowered)
        out.functions[i as usize] = legal
        let legal_count = if legal.legal_instr_count > 0 { legal.legal_instr_count } else { legal.blocks[0].instr_count }
        out.total_machine_instr_count = out.total_machine_instr_count + legal_count
        if !legal.supported && out.supported {
            out.supported = false
            out.unsupported_detail = legal.unsupported_detail
        }
        i = i + 1
    }

    out
}
