use parser::parser::{parser_last_error_count}
use module_parse::{load_module_file}
use check::mod::{check_program_witness_from_seed}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    if argc < 1 {
        print("usage: ontology_witness_program_probe <source>\n")
        return 2
    }

    var seed = 2
    seed = seed + 16
    seed = seed + 32
    print("seed_before_load=")
    print_int(seed)
    print("\n")

    let prog = load_module_file(get_arg(0))
    print("seed_after_load=")
    print_int(seed)
    print("\n")

    if parser_last_error_count() > 0 {
        print("parse_error\n")
        return 2
    }

    let witness = check_program_witness_from_seed(prog, seed)
    print("program_witness=")
    print_int(witness)
    print("\n")
    print("program_verdict=")
    print_int(witness % 16)
    print("\n")
    print("program_load=")
    print_int((witness / 16) % 2)
    print("\n")
    print("program_parse=")
    print_int((witness / 32) % 2)
    print("\n")
    print("program_collect=")
    print_int((witness / 64) % 2)
    print("\n")
    print("program_check=")
    print_int((witness / 128) % 2)
    print("\n")

    0
}
