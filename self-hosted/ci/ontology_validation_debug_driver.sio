use parser::ast::{ItemList}
use parser::mod::{parse_items_preloaded}
use parser::parser::{parser_last_error_count}
use lexer::mod::*
use check::check::{
    Checker,
    checker_collect_items_mut,
    checker_error_count_scalar,
    checker_fn_sig_count_scalar,
    checker_init_in_place,
    checker_check_items_inner_store_return_had_error_mut,
    checker_warning_count_scalar
}
use mem::box::{heap_alloc}

fn load_items_file_boot4_safe(path: string) -> Option<Box<ItemList>> with IO, Mut, Panic, Div, Alloc {
    print("stage=helper_load_enter\n")
    let items = lex_file_parse_items(path)
    print("stage=helper_load_ok\n")
    items
}

fn count_loaded_items(items: Option<Box<ItemList>>) -> i64 with Mut, Panic, Div, Alloc {
    match items {
        Some(list) => 1 + count_loaded_items((*list).tail)
        None => 0
    }
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    print("stage=startup_ok\n")
    let argc = arg_count()
    if argc < 1 {
        print("usage: ontology_validation_debug_driver <source>\n")
        return 2
    }
    print("stage=args_ok\n")
    print("stage=arg_fetch_enter\n")
    let source_path = get_arg(0)
    print("stage=arg_fetch_ok\n")
    sourcefile_trace_enable()

    print("stage=load_enter\n")
    let items = load_items_file_boot4_safe(source_path)
    print("stage=load_ok\n")
    if parser_last_error_count() > 0 {
        print("parse_error\n")
        return 2
    }
    print("stage=parse_ok\n")

    let checker = heap_alloc(262144) as *mut Checker
    print("stage=checker_alloc_ok\n")
    checker_init_in_place(checker)
    print("stage=checker_init_ok\n")
    checker_collect_items_mut(checker, items)
    print("stage=collect_ok\n")
    let had_error = checker_check_items_inner_store_return_had_error_mut(checker, items)
    print("stage=check_ok\n")
    let error_count = checker_error_count_scalar(checker)
    let warning_count = checker_warning_count_scalar(checker)
    let fn_sig_count = checker_fn_sig_count_scalar(checker)

    print("check_had_error=")
    print_int(had_error)
    print("\n")

    print("check_error_count=")
    print_int(error_count)
    print("\n")

    print("check_warning_count=")
    print_int(warning_count)
    print("\n")

    print("program_item_count=")
    print_int(count_loaded_items(items))
    print("\n")

    print("fn_sig_count=")
    print_int(fn_sig_count)
    print("\n")

    print("stage=verdict_ok\n")

    return 0
}
