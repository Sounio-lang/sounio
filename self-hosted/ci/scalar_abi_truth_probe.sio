use ci::scalar_abi_helpers::{
    imported_add_i64,
    imported_bitpack_i64,
    imported_bool_true,
    imported_const_7,
    imported_identity_i64,
    imported_mark_seed_i64,
    imported_status_code,
}

fn local_const_7() -> i64 with Div {
    7
}

fn local_identity_i64(x: i64) -> i64 with Div {
    x
}

fn local_mark_seed_i64(x: i64) -> i64 with Div {
    x + 48
}

fn local_add_i64(x: i64, y: i64) -> i64 with Div {
    x + y
}

fn local_bitpack_i64(x: i64, y: i64) -> i64 with Div {
    (x * 256) + y
}

fn local_bool_true() -> bool with Div {
    true
}

fn local_status_code() -> i64 with Div {
    3
}

fn print_case_i64(label: string, expected: i64, observed: i64) with IO, Mut, Panic, Div {
    print("case=")
    print(label)
    print(" expected=")
    print_int(expected)
    print(" observed=")
    print_int(observed)
    print("\n")
}

fn print_case_bool(label: string, expected: bool, observed: bool) with IO, Mut, Panic, Div {
    print("case=")
    print(label)
    print(" expected=")
    if expected { print("1") } else { print("0") }
    print(" observed=")
    if observed { print("1\n") } else { print("0\n") }
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let seed = 2
    let left = 5
    let right = 9

    print_case_i64("local_arity0_const", 7, local_const_7())
    print_case_i64("imported_arity0_const", 7, imported_const_7())

    print_case_i64("local_arity1_identity", seed, local_identity_i64(seed))
    print_case_i64("imported_arity1_identity", seed, imported_identity_i64(seed))

    print_case_i64("local_arity1_mark_seed", 50, local_mark_seed_i64(seed))
    print_case_i64("imported_arity1_mark_seed", 50, imported_mark_seed_i64(seed))

    print_case_i64("local_arity2_add", 14, local_add_i64(left, right))
    print_case_i64("imported_arity2_add", 14, imported_add_i64(left, right))

    print_case_i64("local_arity2_bitpack", 1289, local_bitpack_i64(left, right))
    print_case_i64("imported_arity2_bitpack", 1289, imported_bitpack_i64(left, right))

    print_case_bool("local_bool_true", true, local_bool_true())
    print_case_bool("imported_bool_true", true, imported_bool_true())

    print_case_i64("local_status_code", 3, local_status_code())
    print_case_i64("imported_status_code", 3, imported_status_code())

    0
}
