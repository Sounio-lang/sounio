use module_parse::{load_module_file}
use check::mod::{check_program_witness_from_seed}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    if argc < 1 {
        print("probe=m4_large_surface missing-arg\n")
        return 0
    }

    let prog = load_module_file(get_arg(0))
    let witness = check_program_witness_from_seed(prog, 2)
    print("probe=m4_large_surface witness=")
    print_int(witness)
    print("\n")
    0
}
