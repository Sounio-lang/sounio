fn is_digit_local(ch: i64) -> bool {
    ch >= 48 && ch <= 57
}

fn parse_decimal_string_local(s: string) -> i64 with Mut, Panic, Div {
    let len = str_len(s)
    if len <= 0 { return -1 }
    var value: i64 = 0
    var i: i64 = 0
    while i < len {
        let ch = str_char_at(s, i) as i64
        if !is_digit_local(ch) { return -1 }
        value = value * 10 + (ch - 48)
        i = i + 1
    }
    value
}

fn main() -> i64 with IO, Mut, Panic, Div {
    print("probe_stage=start\n")
    let argc = arg_count()
    print("probe_argc=")
    print_int(argc)
    print("\n")
    if argc < 4 {
        print("probe_stage=argc_short\n")
        return 1
    }

    print("probe_stage=before_flag\n")
    let flag = get_arg(2)
    print("probe_stage=after_flag\n")
    if str_eq(flag, "--src-cap-bytes") {
        print("probe_flag_ok=1\n")
    } else {
        print("probe_flag_ok=0\n")
    }

    print("probe_stage=before_cap\n")
    let cap_str = get_arg(3)
    print("probe_stage=after_cap\n")
    let parsed = parse_decimal_string_local(cap_str)
    print("probe_cap=")
    print_int(parsed)
    print("\n")
    0
}
