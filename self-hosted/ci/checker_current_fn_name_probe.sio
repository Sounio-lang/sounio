// Checker field syntax on a raw heap pointer is lowered as handle 0.
// The roundtrip refuses that handle and writes the name through a raw pointer.
use check::check::{checker_current_fn_name_roundtrip}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let raw = heap_alloc(33554432)
    print("stage=alloc ")
    print_int(raw)
    print("\n")
    if raw == 0 {
        print("checker_current_fn_name: allocation failed\n")
        return 4
    }
    write_i64(raw, 0, 7)
    print("stage=word ")
    print_int(read_i64(raw, 0))
    print("\n")
    let rc = checker_current_fn_name_roundtrip(raw)
    if rc != 0 {
        return rc
    }
    heap_free(raw)
    print("checker_current_fn_name: ok\n")
    0
}
