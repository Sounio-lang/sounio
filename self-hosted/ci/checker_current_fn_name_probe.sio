// Build with the compiler under test, then run with a source file containing
// ordinary functions (for example tests/run-pass/checker_current_fn_name.sio).
use check::check::{Checker, checker_init_in_place, checker_collect_items_mut, checker_error_count_scalar, checker_current_fn_name_len, checker_note_current_fn_name}
use parser::ast::{make_name}
use parser::parser::{parser_last_error_count}
use lexer::mod::{lex_file_parse_items}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    if arg_count() < 1 {
        print("usage: checker_current_fn_name_probe <source>\n")
        return 2
    }
    let items = lex_file_parse_items(get_arg(0))
    if parser_last_error_count() > 0 {
        print("checker_current_fn_name: parse failed\n")
        return 2
    }
    let checker = heap_alloc(8388608) as *mut Checker
    // A nonempty sentinel also catches missing initialization on a reused
    // allocation, without relying on zero-filled storage to trigger a crash.
    checker_note_current_fn_name(checker, make_name("stale"))
    checker_init_in_place(checker)
    if checker_current_fn_name_len(checker) != 0 {
        print("checker_current_fn_name: initialization failed\n")
        return 1
    }
    checker_collect_items_mut(checker, items)
    if checker_current_fn_name_len(checker) != 0 {
        print("checker_current_fn_name: restoration failed\n")
        return 1
    }
    if checker_error_count_scalar(checker) != 0 {
        print("checker_current_fn_name: collection failed\n")
        return 1
    }
    heap_free(checker as i64)
    print("checker_current_fn_name: ok\n")
    0
}
