// The cap is 256. Zero and 255 are under it; 256 is not. A shallow
// expression that reports E061 is reading some other word as expr_depth.
use check::check::{checker_expr_depth_exceeded}

fn main() -> i64 with IO {
    if checker_expr_depth_exceeded(0) {
        print("expr_depth: zero exceeded\n")
        return 1
    }
    if checker_expr_depth_exceeded(255) {
        print("expr_depth: 255 exceeded\n")
        return 1
    }
    if !checker_expr_depth_exceeded(256) {
        print("expr_depth: 256 accepted\n")
        return 1
    }
    print("expr_depth: ok\n")
    0
}
