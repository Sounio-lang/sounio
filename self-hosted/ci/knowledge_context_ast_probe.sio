use lexer::mod::{lex_file_parse_items}
use parser::ast::{ItemKind, ItemList, KnowledgeConstraintList, ParamList, TypeExpr, TypeExprKind}
use parser::parser::{parser_last_error_count}

fn count_knowledge_constraints(opt: Option<Box<KnowledgeConstraintList> >) -> i64 with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => 1 + count_knowledge_constraints((*list).tail)
        None => 0
    }
}

fn print_first_knowledge_constraint(opt: Option<Box<KnowledgeConstraintList> >) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            let constraint = (*list).head
            print("first_field_len=")
            print_int(constraint.field.len)
            print(" first_target_len=")
            print_int(constraint.target_name.len)
            print(" first_kind=")
            print_int(constraint.kind as i64)
            print(" first_value_kind=")
            print_int(constraint.value_kind as i64)
            print("\n")
        }
        None => {}
    }
}

fn probe_param_constraints(params: Option<Box<ParamList> >) -> i64 with IO, Mut, Panic, Div, Alloc {
    match params {
        None => -1
        Some(pl) => {
            let ty = (*pl).head.ty
            if ty.kind != TypeExprKind::TypeKnowledge {
                return -2
            }
            match ty.knowledge_info {
                None => -3
                Some(info) => {
                    print_first_knowledge_constraint((*info).proof_constraints)
                    count_knowledge_constraints((*info).proof_constraints)
                }
            }
        }
    }
}

fn probe_type_constraints(ty: TypeExpr) -> i64 with IO, Mut, Panic, Div, Alloc {
    if ty.kind != TypeExprKind::TypeKnowledge {
        return -6
    }
    match ty.knowledge_info {
        None => -7
        Some(info) => {
            print_first_knowledge_constraint((*info).proof_constraints)
            count_knowledge_constraints((*info).proof_constraints)
        }
    }
}

fn probe_items(items: Option<Box<ItemList> >) -> i64 with IO, Mut, Panic, Div, Alloc {
    match items {
        None => -4
        Some(list) => {
            let item = (*list).head
            if item.kind == ItemKind::ItemFn {
                match item.fn_def {
                    None => -5
                    Some(fd) => {
                        let param_count = probe_param_constraints((*fd).params)
                        if param_count > 0 {
                            return param_count
                        }
                        match (*fd).return_type {
                            None => param_count
                            Some(ret_ty) => probe_type_constraints(*ret_ty)
                        }
                    }
                }
            } else {
                probe_items((*list).tail)
            }
        }
    }
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    var path = "tests/frontend/knowledge_static_subclass_where_ordinary_probe.sio"
    if argc >= 1 {
        path = get_arg(0)
    }

    let items = lex_file_parse_items(path)
    if parser_last_error_count() > 0 {
        print("parse_errors=")
        print_int(parser_last_error_count())
        print("\n")
        return 2
    }

    let constraint_count = probe_items(items)
    print("knowledge_constraint_count=")
    print_int(constraint_count)
    print("\n")
    if constraint_count > 0 {
        return 0
    }
    1
}
