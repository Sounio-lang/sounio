use parser::parser::{parser_last_error_count}
use module_parse::{load_module_file}
use check::check::{Checker, checker_init_in_place, checker_collect_items_mut, checker_check_items_mut}
use mem::box::{heap_alloc}

fn checker_check_items_and_return_warning_count_mut(c: *mut Checker, items: Option<Box<ItemList>>) -> i64 with IO, Mut, Panic, Div, Alloc {
    checker_check_items_mut(c, items)
    print("stage=helper_check_ok\n")
    (*c).warning_count
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let argc = arg_count()
    var source_path = "scripts/ci/ontology_min_input.sio"
    if argc >= 1 {
        source_path = get_arg(0)
    }

    let prog = load_module_file(source_path)
    if parser_last_error_count() > 0 {
        print("stage=parse_error\n")
        return 2
    }
    print("stage=load_ok\n")

    let checker = heap_alloc(262144) as *mut Checker
    checker_init_in_place(checker)
    print("stage=checker_init_ok\n")

    checker_collect_items_mut(checker, prog.items)
    print("stage=collect_ok\n")

    let wc = checker_check_items_and_return_warning_count_mut(checker, prog.items)
    print("stage=return_ok=")
    print_int(wc)
    print("\n")
    return 0
}
