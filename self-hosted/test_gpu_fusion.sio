// Self-hosted GPU optimizer tests
//
// Validates optimizer data structures, flags, stats, DCE, constant
// folding, fusion eligibility, divergence analysis, and auto-tune.

// ── Constants ───────────────────────────────────────────────────────

fn fusion_test_01_op_const() -> bool {
    OPT_OP_CONST == 99
}

fn fusion_test_02_op_add() -> bool {
    OPT_OP_ADD == 4
}

fn fusion_test_03_op_barrier() -> bool {
    OPT_OP_BARRIER == 10
}

fn fusion_test_04_op_get_tid() -> bool {
    OPT_OP_GET_TID == 0
}

fn fusion_test_05_op_store_global() -> bool {
    OPT_OP_STORE_GLOBAL == 15
}

// ── Stats / Flags Constructors ──────────────────────────────────────

fn fusion_test_06_stats_new_zeros() -> bool {
    let s = opt_stats_new()
    s.ops_removed == 0 &&
    s.ops_folded == 0 &&
    s.kernels_fused == 0 &&
    s.divergent_branches == 0
}

fn fusion_test_07_stats_new_default_block_size() -> bool {
    let s = opt_stats_new()
    s.recommended_block_size == 256
}

fn fusion_test_08_flags_default_all_true() -> bool {
    let f = opt_flags_default()
    f.dce && f.const_fold && f.fusion &&
    f.reg_pressure && f.divergence && f.bank_conflicts &&
    f.loop_unroll && f.auto_tune
}

fn fusion_test_09_flags_conservative() -> bool {
    let f = opt_flags_conservative()
    f.dce && f.const_fold &&
    !f.fusion && !f.reg_pressure && !f.divergence &&
    !f.bank_conflicts && !f.loop_unroll && !f.auto_tune
}

// ── Zero Constructors ───────────────────────────────────────────────

fn fusion_test_10_gpu_op_zero() -> bool {
    let o = opt_gpu_op_entry_zero()
    o.opcode == 0 && o.dst_idx == -1 && o.src0 == -1 &&
    o.src1 == -1 && !o.dead && o.imm_int == 0
}

fn fusion_test_11_liveness_zero() -> bool {
    let e = opt_liveness_entry_zero()
    e.value_id == -1 && e.def_op_idx == -1 && !e.is_live
}

fn fusion_test_12_divergence_zero() -> bool {
    let d = opt_divergence_info_zero()
    d.block_id == -1 && !d.is_divergent && d.divergence_cause == 3
}

fn fusion_test_13_bank_conflict_zero() -> bool {
    let b = opt_bank_conflict_info_zero()
    b.op_idx == -1 && b.stride == 1 && b.conflict_degree == 1
}

fn fusion_test_14_autotune_default() -> bool {
    let a = opt_autotune_advice_default()
    a.recommended_threads == 256 &&
    a.recommended_shared_mem == 0 &&
    !a.memory_bound && !a.compute_bound
}

fn fusion_test_15_fusion_candidate_none() -> bool {
    let c = opt_fusion_candidate_none()
    !c.can_fuse && c.reason == 1 && c.merged_op_count == 0
}

// ── Helper Functions ────────────────────────────────────────────────

fn fusion_test_16_abs_positive() -> bool {
    opt_abs_i64(5) == 5
}

fn fusion_test_17_abs_negative() -> bool {
    opt_abs_i64(-7) == 7
}

fn fusion_test_18_abs_zero() -> bool {
    opt_abs_i64(0) == 0
}

fn fusion_test_19_max_i64() -> bool {
    opt_max_i64(3, 7) == 7 && opt_max_i64(9, 2) == 9
}

fn fusion_test_20_gcd() -> bool with Div {
    opt_gcd(12, 8) == 4 && opt_gcd(7, 13) == 1
}

// ── Constant Op Detection ───────────────────────────────────────────

fn fusion_test_21_is_constant_op_yes() -> bool {
    var op = opt_gpu_op_entry_zero()
    op.opcode = OPT_OP_CONST
    opt_is_constant_op(op)
}

fn fusion_test_22_is_constant_op_no() -> bool {
    var op = opt_gpu_op_entry_zero()
    op.opcode = OPT_OP_ADD;
    !opt_is_constant_op(op)
}

// ── Side Effects Detection ──────────────────────────────────────────

fn fusion_test_23_side_effects_store() -> bool {
    var op = opt_gpu_op_entry_zero()
    op.opcode = OPT_OP_STORE_GLOBAL
    opt_op_has_side_effects(op)
}

fn fusion_test_24_side_effects_barrier() -> bool {
    var op = opt_gpu_op_entry_zero()
    op.opcode = OPT_OP_BARRIER
    opt_op_has_side_effects(op)
}

fn fusion_test_25_no_side_effects_add() -> bool {
    var op = opt_gpu_op_entry_zero()
    op.opcode = OPT_OP_ADD;
    !opt_op_has_side_effects(op)
}

// ── Stats Merge ─────────────────────────────────────────────────────

fn fusion_test_26_stats_merge() -> bool {
    var a = opt_stats_new()
    var b = opt_stats_new()
    a.ops_removed = 3
    a.ops_folded = 2
    b.ops_removed = 5
    b.ops_folded = 1
    let m = opt_stats_merge(a, b)
    m.ops_removed == 8 && m.ops_folded == 3
}

fn fusion_test_27_stats_merge_max_pressure() -> bool {
    var a = opt_stats_new()
    var b = opt_stats_new()
    a.max_register_pressure = 24
    b.max_register_pressure = 48
    let m = opt_stats_merge(a, b)
    m.max_register_pressure == 48
}

// ── Block Liveness ──────────────────────────────────────────────────

fn fusion_test_28_block_liveness_zero() -> bool {
    let bl = opt_block_liveness_zero(0)
    bl.block_id == 0 && bl.entry_count == 0 && bl.peak_live == 0
}

// ── Constant Value Accessors ────────────────────────────────────────

fn fusion_test_29_constant_value_i() -> bool {
    var op = opt_gpu_op_entry_zero()
    op.opcode = OPT_OP_CONST
    op.imm_int = 42
    opt_constant_value_i(op) == 42
}

fn fusion_test_30_constant_value_f() -> bool {
    var op = opt_gpu_op_entry_zero()
    op.opcode = OPT_OP_CONST
    op.imm_f32 = 3.14 as f32
    let v = opt_constant_value_f(op)
    v > 3.13 && v < 3.15
}

// ── Runner ──────────────────────────────────────────────────────────

fn run_gpu_fusion_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    var passed: i64 = 0
    var total: i64 = 0

    print("=== GPU Optimizer/Fusion Tests ===\n")

    total = total + 1
    if fusion_test_01_op_const() { passed = passed + 1; print("  T01 OK\n") } else { print("  FAIL T01 CONST\n") }
    total = total + 1
    if fusion_test_02_op_add() { passed = passed + 1; print("  T02 OK\n") } else { print("  FAIL T02 ADD\n") }
    total = total + 1
    if fusion_test_03_op_barrier() { passed = passed + 1; print("  T03 OK\n") } else { print("  FAIL T03 BARRIER\n") }
    total = total + 1
    if fusion_test_04_op_get_tid() { passed = passed + 1; print("  T04 OK\n") } else { print("  FAIL T04 GET_TID\n") }
    total = total + 1
    if fusion_test_05_op_store_global() { passed = passed + 1; print("  T05 OK\n") } else { print("  FAIL T05 STORE\n") }
    total = total + 1
    if fusion_test_06_stats_new_zeros() { passed = passed + 1; print("  T06 OK\n") } else { print("  FAIL T06 stats 0\n") }
    total = total + 1
    if fusion_test_07_stats_new_default_block_size() { passed = passed + 1; print("  T07 OK\n") } else { print("  FAIL T07 stats bs\n") }
    total = total + 1
    if fusion_test_08_flags_default_all_true() { passed = passed + 1; print("  T08 OK\n") } else { print("  FAIL T08 flags\n") }
    total = total + 1
    if fusion_test_09_flags_conservative() { passed = passed + 1; print("  T09 OK\n") } else { print("  FAIL T09 conserv\n") }
    total = total + 1
    if fusion_test_10_gpu_op_zero() { passed = passed + 1; print("  T10 OK\n") } else { print("  FAIL T10 op zero\n") }
    total = total + 1
    if fusion_test_11_liveness_zero() { passed = passed + 1; print("  T11 OK\n") } else { print("  FAIL T11 live 0\n") }
    total = total + 1
    if fusion_test_12_divergence_zero() { passed = passed + 1; print("  T12 OK\n") } else { print("  FAIL T12 div 0\n") }
    total = total + 1
    if fusion_test_13_bank_conflict_zero() { passed = passed + 1; print("  T13 OK\n") } else { print("  FAIL T13 bank 0\n") }
    total = total + 1
    if fusion_test_14_autotune_default() { passed = passed + 1; print("  T14 OK\n") } else { print("  FAIL T14 tune\n") }
    total = total + 1
    if fusion_test_15_fusion_candidate_none() { passed = passed + 1; print("  T15 OK\n") } else { print("  FAIL T15 fuse 0\n") }
    total = total + 1
    if fusion_test_16_abs_positive() { passed = passed + 1; print("  T16 OK\n") } else { print("  FAIL T16 abs+\n") }
    total = total + 1
    if fusion_test_17_abs_negative() { passed = passed + 1; print("  T17 OK\n") } else { print("  FAIL T17 abs-\n") }
    total = total + 1
    if fusion_test_18_abs_zero() { passed = passed + 1; print("  T18 OK\n") } else { print("  FAIL T18 abs0\n") }
    total = total + 1
    if fusion_test_19_max_i64() { passed = passed + 1; print("  T19 OK\n") } else { print("  FAIL T19 max\n") }
    total = total + 1
    if fusion_test_20_gcd() { passed = passed + 1; print("  T20 OK\n") } else { print("  FAIL T20 gcd\n") }
    total = total + 1
    if fusion_test_21_is_constant_op_yes() { passed = passed + 1; print("  T21 OK\n") } else { print("  FAIL T21 const y\n") }
    total = total + 1
    if fusion_test_22_is_constant_op_no() { passed = passed + 1; print("  T22 OK\n") } else { print("  FAIL T22 const n\n") }
    total = total + 1
    if fusion_test_23_side_effects_store() { passed = passed + 1; print("  T23 OK\n") } else { print("  FAIL T23 se store\n") }
    total = total + 1
    if fusion_test_24_side_effects_barrier() { passed = passed + 1; print("  T24 OK\n") } else { print("  FAIL T24 se bar\n") }
    total = total + 1
    if fusion_test_25_no_side_effects_add() { passed = passed + 1; print("  T25 OK\n") } else { print("  FAIL T25 no se\n") }
    total = total + 1
    if fusion_test_26_stats_merge() { passed = passed + 1; print("  T26 OK\n") } else { print("  FAIL T26 merge\n") }
    total = total + 1
    if fusion_test_27_stats_merge_max_pressure() { passed = passed + 1; print("  T27 OK\n") } else { print("  FAIL T27 merge p\n") }
    total = total + 1
    if fusion_test_28_block_liveness_zero() { passed = passed + 1; print("  T28 OK\n") } else { print("  FAIL T28 bl live\n") }
    total = total + 1
    if fusion_test_29_constant_value_i() { passed = passed + 1; print("  T29 OK\n") } else { print("  FAIL T29 const i\n") }
    total = total + 1
    if fusion_test_30_constant_value_f() { passed = passed + 1; print("  T30 OK\n") } else { print("  FAIL T30 const f\n") }

    if passed == total {
        print("GPU Optimizer/Fusion: all 30 passed\n")
    } else {
        print("GPU Optimizer/Fusion: FAILED\n")
    }
    if passed == total { 0 } else { 1 }
}
