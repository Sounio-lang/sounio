// Aggregated self-hosted test runner (no main here to avoid duplicate main in directory mode)

fn run_all_tests() -> i32 with IO, Mut, Panic, Div, Alloc {
    var suites_passed: i64 = 0
    var suites_total: i64 = 0

    print("=== Self-Hosted Test All ===\n")

    suites_total = suites_total + 1
    if run_lexer_tests() == 0 { suites_passed = suites_passed + 1 } else { print("SUITE FAIL: lexer\n") }

    suites_total = suites_total + 1
    if run_parser_tests() == 0 { suites_passed = suites_passed + 1 } else { print("SUITE FAIL: parser\n") }

    suites_total = suites_total + 1
    if run_printer_tests() == 0 { suites_passed = suites_passed + 1 } else { print("SUITE FAIL: printer\n") }

    suites_total = suites_total + 1
    if run_resolve_tests() == 0 { suites_passed = suites_passed + 1 } else { print("SUITE FAIL: resolve\n") }

    suites_total = suites_total + 1
    if run_check_tests() == 0 { suites_passed = suites_passed + 1 } else { print("SUITE FAIL: check\n") }

    suites_total = suites_total + 1
    if run_ir_tests() == 0 { suites_passed = suites_passed + 1 } else { print("SUITE FAIL: ir\n") }

    suites_total = suites_total + 1
    if run_emit_tests() == 0 { suites_passed = suites_passed + 1 } else { print("SUITE FAIL: emit\n") }

    suites_total = suites_total + 1
    if run_vm_tests() == 0 { suites_passed = suites_passed + 1 } else { print("SUITE FAIL: vm\n") }

    suites_total = suites_total + 1
    if run_bootstrap_tests() == 0 { suites_passed = suites_passed + 1 } else { print("SUITE FAIL: bootstrap\n") }

    suites_total = suites_total + 1
    if run_roundtrip_tests() == 0 { suites_passed = suites_passed + 1 } else { print("SUITE FAIL: roundtrip\n") }

    suites_total = suites_total + 1
    if run_parse_real_tests() == 0 { suites_passed = suites_passed + 1 } else { print("SUITE FAIL: parse_real\n") }

    suites_total = suites_total + 1
    if run_resolve_real_tests() == 0 { suites_passed = suites_passed + 1 } else { print("SUITE FAIL: resolve_real\n") }

    suites_total = suites_total + 1
    if run_check_real_tests() == 0 { suites_passed = suites_passed + 1 } else { print("SUITE FAIL: check_real\n") }

    suites_total = suites_total + 1
    if run_parse_all_tests() == 0 { suites_passed = suites_passed + 1 } else { print("SUITE FAIL: parse_all\n") }

    suites_total = suites_total + 1
    if run_native_tests() == 0 { suites_passed = suites_passed + 1 } else { print("SUITE FAIL: native\n") }

    if suites_passed == suites_total { print("\nSuites: all passed\n") } else { print("\nSuites: suite fail\n") }

    if suites_passed == suites_total { 0 } else { 1 }
}
