// self-hosted::lsp::rename -- LSP rename symbol provider for Sounio
//
// Given a symbol name, finds all references and produces a list of edits
// that rename every occurrence (definition and uses) to the new name.
// All data lives in flat fixed-size arenas; no heap allocation, no
// recursive structures.
//
// Capacities:
//   - Symbols:       512
//   - Refs per sym:  256
//   - Edits:         512
//
// All public names carry the `lspr_` prefix to avoid collisions.

// ============================================================================
// Section 1: CONSTANTS
// ============================================================================

let LSPR_MAX_SYMBOLS: i64  = 512
let LSPR_MAX_REFS: i64     = 256
let LSPR_MAX_EDITS: i64    = 512
let LSPR_INVALID: i64      = 0 - 1

// Reference kinds
let LSPR_KIND_DEF: i64  = 0
let LSPR_KIND_USE: i64  = 1
let LSPR_KIND_TYPE: i64 = 2

// Identifier character classification constants (ASCII)
let LSPR_ASCII_UNDERSCORE: i64 = 95
let LSPR_ASCII_LOWER_A: i64   = 97
let LSPR_ASCII_LOWER_Z: i64   = 122
let LSPR_ASCII_UPPER_A: i64   = 65
let LSPR_ASCII_UPPER_Z: i64   = 90
let LSPR_ASCII_DIGIT_0: i64   = 48
let LSPR_ASCII_DIGIT_9: i64   = 57

// ============================================================================
// Section 2: CORE STRUCTS
// ============================================================================

struct LsprLocation {
    file_id:  i64,
    line:     i64,
    col:      i64,
    end_col:  i64,
}

struct LsprEdit {
    loc:      LsprLocation,
    old_name: string,
    new_name: string,
}

struct LsprRefEntry {
    loc:  LsprLocation,
    kind: i64,
}

struct LsprSymbol {
    name:      string,
    id:        i64,
    refs:      [LsprRefEntry; 256],
    ref_count: i64,
}

struct LsprRenameTable {
    symbols: [LsprSymbol; 512],
    count:   i64,
}

struct LsprRenameResult {
    edits: [LsprEdit;  512],
    count: i64,
    valid: bool,
    error: string,
}

// ============================================================================
// Section 3: ZERO-VALUE CONSTRUCTORS (helpers must precede callers)
// ============================================================================

fn lspr_location_new(file_id: i64, line: i64, col: i64, end_col: i64) -> LsprLocation {
    LsprLocation {
        file_id: file_id,
        line:    line,
        col:     col,
        end_col: end_col,
    }
}

fn lspr_location_zero() -> LsprLocation {
    LsprLocation {
        file_id: 0,
        line:    0,
        col:     0,
        end_col: 0,
    }
}

fn lspr_ref_entry_zero() -> LsprRefEntry {
    LsprRefEntry {
        loc:  lspr_location_zero(),
        kind: LSPR_KIND_USE,
    }
}

fn lspr_edit_zero() -> LsprEdit {
    LsprEdit {
        loc:      lspr_location_zero(),
        old_name: "",
        new_name: "",
    }
}

fn lspr_symbol_zero() -> LsprSymbol {
    LsprSymbol {
        name:      "",
        id:        LSPR_INVALID,
        refs:      [lspr_ref_entry_zero(); 256],
        ref_count: 0,
    }
}

fn lspr_table_new() -> LsprRenameTable {
    LsprRenameTable {
        symbols: [lspr_symbol_zero(); 512],
        count:   0,
    }
}

fn lspr_result_new() -> LsprRenameResult {
    LsprRenameResult {
        edits: [lspr_edit_zero(); 512],
        count: 0,
        valid: true,
        error: "",
    }
}

fn lspr_result_error(msg: string) -> LsprRenameResult {
    LsprRenameResult {
        edits: [lspr_edit_zero(); 512],
        count: 0,
        valid: false,
        error: msg,
    }
}

// ============================================================================
// Section 4: NAME VALIDATION
// ============================================================================

// Check whether a single character (given as i64 ASCII code) is valid in an
// identifier.  Valid chars: a-z, A-Z, 0-9, _
fn lspr_is_ident_char(c: i64) -> bool {
    if c >= LSPR_ASCII_LOWER_A && c <= LSPR_ASCII_LOWER_Z { return true }
    if c >= LSPR_ASCII_UPPER_A && c <= LSPR_ASCII_UPPER_Z { return true }
    if c >= LSPR_ASCII_DIGIT_0 && c <= LSPR_ASCII_DIGIT_9 { return true }
    if c == LSPR_ASCII_UNDERSCORE { return true }
    false
}

// Check whether a character is valid as the FIRST character of an identifier.
// First char: a-z, A-Z, _  (no digits)
fn lspr_is_ident_start(c: i64) -> bool {
    if c >= LSPR_ASCII_LOWER_A && c <= LSPR_ASCII_LOWER_Z { return true }
    if c >= LSPR_ASCII_UPPER_A && c <= LSPR_ASCII_UPPER_Z { return true }
    if c == LSPR_ASCII_UNDERSCORE { return true }
    false
}

// Validate that `name` is a well-formed Sounio identifier.
// Returns true iff name is non-empty, starts with a letter or underscore,
// and contains only letters, digits, and underscores.
fn lspr_validate_name(name: string) -> bool {
    let n = str_len(name)
    if n == 0 { return false }
    // Check first character
    // We use str_len tricks to get individual chars via substring comparison.
    // Strategy: compare substrings character by character using str_eq on 1-char slices.
    // Since Sounio exposes str_byte_at as i64, use that.
    let c0 = str_char_at(name, 0)
    if lspr_is_ident_start(c0) == false { return false }
    // Check remaining characters
    var i: i64 = 1
    while i < n {
        let c = str_char_at(name, i)
        if lspr_is_ident_char(c) == false { return false }
        i = i + 1
    }
    true
}

// ============================================================================
// Section 5: SYMBOL TABLE OPERATIONS
// ============================================================================

// Find a symbol by name.  Returns its id (index) or LSPR_INVALID.
fn lspr_find_symbol(t: &LsprRenameTable, name: string) -> i64 {
    var i: i64 = 0
    while i < t.count {
        if str_eq(t.symbols[i as usize].name, name) {
            return t.symbols[i as usize].id
        }
        i = i + 1
    }
    LSPR_INVALID
}

// Add a new symbol with the given name.  Returns the newly assigned id.
// Panics (returns LSPR_INVALID) if the table is full.
fn lspr_add_symbol(t: &! LsprRenameTable, name: string) -> i64 with Mut, Panic {
    if t.count >= LSPR_MAX_SYMBOLS {
        return LSPR_INVALID
    }
    let id = t.count
    t.symbols[id as usize] = LsprSymbol {
        name:      name,
        id:        id,
        refs:      [lspr_ref_entry_zero(); 256],
        ref_count: 0,
    }
    t.count = t.count + 1
    id
}

// Add a reference entry to the symbol with sym_id.
fn lspr_add_ref(t: &! LsprRenameTable, sym_id: i64, file_id: i64, line: i64, col: i64, end_col: i64, kind: i64) with Mut, Panic {
    if sym_id < 0 || sym_id >= t.count {
        return
    }
    let rc = t.symbols[sym_id as usize].ref_count
    if rc >= LSPR_MAX_REFS {
        return
    }
    t.symbols[sym_id as usize].refs[rc as usize] = LsprRefEntry {
        loc:  lspr_location_new(file_id, line, col, end_col),
        kind: kind,
    }
    t.symbols[sym_id as usize].ref_count = rc + 1
}

// Get the name of symbol sym_id.
fn lspr_symbol_name(t: &LsprRenameTable, sym_id: i64) -> string with Panic {
    if sym_id < 0 || sym_id >= t.count {
        return ""
    }
    t.symbols[sym_id as usize].name
}

// Get the ref count of symbol sym_id.
fn lspr_symbol_ref_count(t: &LsprRenameTable, sym_id: i64) -> i64 with Panic {
    if sym_id < 0 || sym_id >= t.count {
        return 0
    }
    t.symbols[sym_id as usize].ref_count
}

// Get a specific ref entry from symbol sym_id.
fn lspr_symbol_ref_at(t: &LsprRenameTable, sym_id: i64, ref_idx: i64) -> LsprRefEntry with Panic {
    if sym_id < 0 || sym_id >= t.count {
        return lspr_ref_entry_zero()
    }
    let rc = t.symbols[sym_id as usize].ref_count
    if ref_idx < 0 || ref_idx >= rc {
        return lspr_ref_entry_zero()
    }
    t.symbols[sym_id as usize].refs[ref_idx as usize]
}

// Count symbols in the table.
fn lspr_table_count(t: &LsprRenameTable) -> i64 {
    t.count
}

// Count how many refs of a given kind belong to symbol sym_id.
fn lspr_count_refs_of_kind(t: &LsprRenameTable, sym_id: i64, kind: i64) -> i64 with Mut, Div, Panic {
    if sym_id < 0 || sym_id >= t.count {
        return 0
    }
    let rc = t.symbols[sym_id as usize].ref_count
    var count: i64 = 0
    var i: i64 = 0
    while i < rc {
        if t.symbols[sym_id as usize].refs[i as usize].kind == kind {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// ============================================================================
// Section 6: RENAME OPERATION
// ============================================================================

// Produce a LsprRenameResult for renaming symbol sym_id to new_name.
// - Validates new_name as a proper identifier.
// - Returns an error result if sym_id is out of range.
// - Returns an error result if new_name is the same as the current name.
// - Returns an error result if new_name conflicts with an existing symbol.
// - Produces one LsprEdit per reference in the symbol's ref list.
fn lspr_rename(t: &LsprRenameTable, sym_id: i64, new_name: string) -> LsprRenameResult {
    // Validate sym_id range
    if sym_id < 0 || sym_id >= t.count {
        return lspr_result_error("invalid symbol id")
    }

    let old_name = t.symbols[sym_id as usize].name

    // Validate new_name
    if lspr_validate_name(new_name) == false {
        return lspr_result_error("invalid identifier")
    }

    // Detect no-op rename
    if str_eq(old_name, new_name) {
        return lspr_result_error("new name is identical to old name")
    }

    // Check for conflict with another existing symbol
    let conflict_id = lspr_find_symbol(t, new_name)
    if conflict_id != LSPR_INVALID && conflict_id != sym_id {
        return lspr_result_error("name already exists in scope")
    }

    // Build edit list
    var result = lspr_result_new()
    let rc = t.symbols[sym_id as usize].ref_count
    var i: i64 = 0
    while i < rc && result.count < LSPR_MAX_EDITS {
        let ref_e = t.symbols[sym_id as usize].refs[i as usize]
        result.edits[result.count as usize] = LsprEdit {
            loc:      ref_e.loc,
            old_name: old_name,
            new_name: new_name,
        }
        result.count = result.count + 1
        i = i + 1
    }
    result.valid = true
    result
}

// ============================================================================
// Section 7: RESULT QUERY HELPERS
// ============================================================================

fn lspr_result_valid(r: &LsprRenameResult) -> bool {
    r.valid
}

fn lspr_result_edit_count(r: &LsprRenameResult) -> i64 {
    r.count
}

fn lspr_result_error_msg(r: &LsprRenameResult) -> string {
    r.error
}

fn lspr_result_edit_at(r: &LsprRenameResult, idx: i64) -> LsprEdit with Panic {
    if idx < 0 || idx >= r.count {
        return lspr_edit_zero()
    }
    r.edits[idx as usize]
}

fn lspr_result_old_name(r: &LsprRenameResult, idx: i64) -> string with Panic {
    if idx < 0 || idx >= r.count {
        return ""
    }
    r.edits[idx as usize].old_name
}

fn lspr_result_new_name(r: &LsprRenameResult, idx: i64) -> string with Panic {
    if idx < 0 || idx >= r.count {
        return ""
    }
    r.edits[idx as usize].new_name
}

fn lspr_result_edit_line(r: &LsprRenameResult, idx: i64) -> i64 with Panic {
    if idx < 0 || idx >= r.count {
        return 0 - 1
    }
    r.edits[idx as usize].loc.line
}

fn lspr_result_edit_col(r: &LsprRenameResult, idx: i64) -> i64 with Panic {
    if idx < 0 || idx >= r.count {
        return 0 - 1
    }
    r.edits[idx as usize].loc.col
}

fn lspr_result_edit_end_col(r: &LsprRenameResult, idx: i64) -> i64 with Panic {
    if idx < 0 || idx >= r.count {
        return 0 - 1
    }
    r.edits[idx as usize].loc.end_col
}

fn lspr_result_edit_file(r: &LsprRenameResult, idx: i64) -> i64 with Panic {
    if idx < 0 || idx >= r.count {
        return 0 - 1
    }
    r.edits[idx as usize].loc.file_id
}

// Count edits that touch a particular file.
fn lspr_result_edits_in_file(r: &LsprRenameResult, file_id: i64) -> i64 {
    var count: i64 = 0
    var i: i64 = 0
    while i < r.count {
        if r.edits[i as usize].loc.file_id == file_id {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Count edits of a particular kind (DEF, USE, TYPE) in the result.
// This requires matching kind from corresponding ref entries.
// Since LsprEdit doesn't store kind directly, we check if old_name == new_name
// (impossible) or use external cross-reference. In this module edits don't
// carry kind, so this helper counts all edits on a given line.
fn lspr_result_edits_on_line(r: &LsprRenameResult, line: i64) -> i64 {
    var count: i64 = 0
    var i: i64 = 0
    while i < r.count {
        if r.edits[i as usize].loc.line == line {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// ============================================================================
// Section 8: LOCATION UTILITIES
// ============================================================================

fn lspr_location_eq(a: &LsprLocation, b: &LsprLocation) -> bool {
    a.file_id == b.file_id
        && a.line == b.line
        && a.col == b.col
        && a.end_col == b.end_col
}

fn lspr_location_contains_col(loc: &LsprLocation, col: i64) -> bool {
    col >= loc.col && col <= loc.end_col
}

fn lspr_location_span(loc: &LsprLocation) -> i64 {
    loc.end_col - loc.col + 1
}

fn lspr_location_is_zero(loc: &LsprLocation) -> bool {
    loc.file_id == 0 && loc.line == 0 && loc.col == 0 && loc.end_col == 0
}

// ============================================================================
// Section 9: TABLE-LEVEL STATISTICS
// ============================================================================

// Count total references across all symbols.
fn lspr_table_total_refs(t: &LsprRenameTable) -> i64 {
    var total: i64 = 0
    var i: i64 = 0
    while i < t.count {
        total = total + t.symbols[i as usize].ref_count
        i = i + 1
    }
    total
}

// Count how many symbols have at least one reference.
fn lspr_table_used_symbols(t: &LsprRenameTable) -> i64 {
    var count: i64 = 0
    var i: i64 = 0
    while i < t.count {
        if t.symbols[i as usize].ref_count > 0 {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Count how many symbols have NO references.
fn lspr_table_unreferenced_symbols(t: &LsprRenameTable) -> i64 {
    var count: i64 = 0
    var i: i64 = 0
    while i < t.count {
        if t.symbols[i as usize].ref_count == 0 {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Find the symbol with the most references.  Returns its id.
fn lspr_table_most_referenced(t: &LsprRenameTable) -> i64 {
    if t.count == 0 { return LSPR_INVALID }
    var best_id: i64 = 0
    var best_rc: i64 = t.symbols[0].ref_count
    var i: i64 = 1
    while i < t.count {
        let rc = t.symbols[i as usize].ref_count
        if rc > best_rc {
            best_rc = rc
            best_id = i
        }
        i = i + 1
    }
    best_id
}

// ============================================================================
// Section 10: CROSS-FILE RENAME HELPERS
// ============================================================================

// Count how many distinct file_ids appear in a symbol's ref list.
fn lspr_symbol_file_count(t: &LsprRenameTable, sym_id: i64) -> i64 with Mut, Div, Panic {
    if sym_id < 0 || sym_id >= t.count {
        return 0
    }
    // Use a tiny array to track seen file ids (up to 32 distinct files)
    var seen: [i64; 32] = [0 - 1; 32]
    var seen_count: i64 = 0
    let rc = t.symbols[sym_id as usize].ref_count
    var i: i64 = 0
    while i < rc {
        let fid = t.symbols[sym_id as usize].refs[i as usize].loc.file_id
        var found: bool = false
        var j: i64 = 0
        while j < seen_count {
            if seen[j as usize] == fid {
                found = true
            }
            j = j + 1
        }
        if found == false && seen_count < 32 {
            seen[seen_count as usize] = fid
            seen_count = seen_count + 1
        }
        i = i + 1
    }
    seen_count
}

// Collect all edits from a rename result that belong to a given file.
// Returns a new result containing only those edits.
fn lspr_filter_edits_by_file(r: &LsprRenameResult, file_id: i64) -> LsprRenameResult {
    var out = lspr_result_new()
    var i: i64 = 0
    while i < r.count && out.count < LSPR_MAX_EDITS {
        if r.edits[i as usize].loc.file_id == file_id {
            out.edits[out.count as usize] = r.edits[i as usize]
            out.count = out.count + 1
        }
        i = i + 1
    }
    out.valid = r.valid
    out.error = r.error
    out
}

// ============================================================================
// Section 11: SORT EDITS BY POSITION
// ============================================================================

// Insertion-sort the edits in a result by (file_id, line, col) ascending.
// This ensures predictable application order.
fn lspr_sort_edits(r: &! LsprRenameResult) with Mut, Div, Panic {
    var i: i64 = 1
    while i < r.count {
        let key = r.edits[i as usize]
        var j: i64 = i - 1
        while j >= 0 {
            let cmp_file = r.edits[j as usize].loc.file_id - key.loc.file_id
            let cmp_line = r.edits[j as usize].loc.line - key.loc.line
            let cmp_col  = r.edits[j as usize].loc.col  - key.loc.col
            let is_after = cmp_file > 0
                || (cmp_file == 0 && cmp_line > 0)
                || (cmp_file == 0 && cmp_line == 0 && cmp_col > 0)
            if is_after {
                r.edits[(j + 1) as usize] = r.edits[j as usize]
                j = j - 1
            } else {
                j = 0 - 1
            }
        }
        r.edits[(j + 1) as usize] = key
        i = i + 1
    }
}

// ============================================================================
// Section 12: EDIT VERIFICATION
// ============================================================================

// Verify that all edits in a result have consistent old_name.
fn lspr_edits_consistent(r: &LsprRenameResult) -> bool {
    if r.count == 0 { return true }
    let first_old = r.edits[0].old_name
    let first_new = r.edits[0].new_name
    var i: i64 = 1
    while i < r.count {
        if str_eq(r.edits[i as usize].old_name, first_old) == false {
            return false
        }
        if str_eq(r.edits[i as usize].new_name, first_new) == false {
            return false
        }
        i = i + 1
    }
    true
}

// Verify that no two edits share the exact same location.
fn lspr_edits_unique_locations(r: &LsprRenameResult) -> bool {
    var i: i64 = 0
    while i < r.count {
        var j: i64 = i + 1
        while j < r.count {
            let ai = &r.edits[i as usize].loc
            let aj = &r.edits[j as usize].loc
            if lspr_location_eq(ai, aj) {
                return false
            }
            j = j + 1
        }
        i = i + 1
    }
    true
}

// ============================================================================
// Section 13: BATCH RENAME (rename multiple symbols at once)
// ============================================================================

// Rename symbol by name (looks up the symbol first, then renames).
fn lspr_rename_by_name(t: &LsprRenameTable, old_name: string, new_name: string) -> LsprRenameResult {
    let sym_id = lspr_find_symbol(t, old_name)
    if sym_id == LSPR_INVALID {
        return lspr_result_error("symbol not found")
    }
    lspr_rename(t, sym_id, new_name)
}

// ============================================================================
// Section 14: INTEGRATION HELPERS
// ============================================================================

// Check whether a rename result is apply-safe:
// - valid == true
// - count > 0
// - all edits have non-empty old/new names
// - all edits have unique locations
fn lspr_result_is_safe(r: &LsprRenameResult) -> bool {
    if r.valid == false { return false }
    if r.count == 0 { return false }
    var i: i64 = 0
    while i < r.count {
        if str_len(r.edits[i as usize].old_name) == 0 { return false }
        if str_len(r.edits[i as usize].new_name) == 0 { return false }
        i = i + 1
    }
    lspr_edits_unique_locations(r)
}

// Return the maximum line number touched by any edit.
fn lspr_result_max_line(r: &LsprRenameResult) -> i64 {
    if r.count == 0 { return 0 - 1 }
    var max: i64 = r.edits[0].loc.line
    var i: i64 = 1
    while i < r.count {
        if r.edits[i as usize].loc.line > max {
            max = r.edits[i as usize].loc.line
        }
        i = i + 1
    }
    max
}

// Return the minimum line number touched by any edit.
fn lspr_result_min_line(r: &LsprRenameResult) -> i64 {
    if r.count == 0 { return 0 - 1 }
    var min: i64 = r.edits[0].loc.line
    var i: i64 = 1
    while i < r.count {
        if r.edits[i as usize].loc.line < min {
            min = r.edits[i as usize].loc.line
        }
        i = i + 1
    }
    min
}

// ============================================================================
// Section 15: TESTS
// ============================================================================
// Inner helpers encapsulate sequences of &! borrows within a single borrow scope.

fn tir_inner_add_symbol_count(t: &! LsprRenameTable) -> bool with Mut, Panic {
    let _a = lspr_add_symbol(t, "foo")
    let _b = lspr_add_symbol(t, "bar")
    t.count == 2
}

fn tir_inner_find_symbol_found(t: &! LsprRenameTable) -> bool with Mut, Panic {
    let id = lspr_add_symbol(t, "alpha")
    let found = lspr_find_symbol(t, "alpha")
    found == id
}

fn tir_inner_find_symbol_miss(t: &! LsprRenameTable) -> bool with Mut, Panic {
    let _id = lspr_add_symbol(t, "alpha")
    let found = lspr_find_symbol(t, "beta")
    found == LSPR_INVALID
}

fn tir_inner_add_ref_basic(t: &! LsprRenameTable) -> bool with Mut, Panic {
    let id = lspr_add_symbol(t, "foo")
    lspr_add_ref(t, id, 1, 10, 5, 7, LSPR_KIND_DEF)
    t.symbols[id as usize].ref_count == 1
}

fn tir_inner_add_ref_file_id(t: &! LsprRenameTable) -> bool with Mut, Panic {
    let id = lspr_add_symbol(t, "foo")
    lspr_add_ref(t, id, 42, 1, 0, 2, LSPR_KIND_USE)
    t.symbols[id as usize].refs[0].loc.file_id == 42
}

fn tir_inner_add_ref_line(t: &! LsprRenameTable) -> bool with Mut, Panic {
    let id = lspr_add_symbol(t, "bar")
    lspr_add_ref(t, id, 1, 99, 0, 2, LSPR_KIND_USE)
    t.symbols[id as usize].refs[0].loc.line == 99
}

fn tir_inner_add_ref_kind(t: &! LsprRenameTable) -> bool with Mut, Panic {
    let id = lspr_add_symbol(t, "baz")
    lspr_add_ref(t, id, 1, 1, 0, 2, LSPR_KIND_TYPE)
    t.symbols[id as usize].refs[0].kind == LSPR_KIND_TYPE
}

fn tir_inner_add_ref_multiple(t: &! LsprRenameTable) -> bool with Mut, Panic {
