// T32: lspr_location_new sets fields correctly
fn test_lspr_location_new() -> bool {
    let loc = lspr_location_new(5, 10, 3, 8)
    loc.file_id == 5 && loc.line == 10 && loc.col == 3 && loc.end_col == 8
}

// T33: lspr_location_eq is true for identical locations
fn test_lspr_location_eq_true() -> bool {
    let a = lspr_location_new(1, 2, 3, 4)
    let b = lspr_location_new(1, 2, 3, 4)
    lspr_location_eq(&a, &b)
}

// T34: lspr_location_eq is false for different locations
fn test_lspr_location_eq_false() -> bool {
    let a = lspr_location_new(1, 2, 3, 4)
    let b = lspr_location_new(1, 2, 3, 5)
    lspr_location_eq(&a, &b) == false
}

// T35: lspr_location_span computes correctly
fn test_lspr_location_span() -> bool {
    let loc = lspr_location_new(1, 1, 4, 9)
    lspr_location_span(&loc) == 6
}

// T36: lspr_location_contains_col true when inside
fn test_lspr_location_contains_col_in() -> bool {
    let loc = lspr_location_new(1, 1, 5, 10)
    lspr_location_contains_col(&loc, 7)
}

// T37: lspr_location_contains_col false when outside
