fn tir_inner_sort_edits(t: &! LsprRenameTable) -> bool with Mut, Div, Panic {
    let id = lspr_add_symbol(t, "z")
    lspr_add_ref(t, id, 1, 10, 0, 0, LSPR_KIND_USE)
    lspr_add_ref(t, id, 1, 3, 0, 0, LSPR_KIND_DEF)
    lspr_add_ref(t, id, 1, 7, 0, 0, LSPR_KIND_USE)
    var r = lspr_rename(t, id, "zz")
    lspr_sort_edits(&! r)
    r.edits[0].loc.line <= r.edits[1].loc.line && r.edits[1].loc.line <= r.edits[2].loc.line
}

