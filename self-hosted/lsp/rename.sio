    r.valid && r.count == 2
}

fn tir_inner_full_pipeline(t: &! LsprRenameTable) -> bool with Mut, Div, Panic {
    let id = lspr_add_symbol(t, "compute")
    lspr_add_ref(t, id, 1, 10, 0, 6, LSPR_KIND_DEF)
    lspr_add_ref(t, id, 1, 3, 0, 6, LSPR_KIND_USE)
    lspr_add_ref(t, id, 2, 1, 0, 6, LSPR_KIND_USE)
    var r = lspr_rename(t, id, "evaluate")
    lspr_sort_edits(&! r)
    let safe = lspr_result_is_safe(&r)
    let consistent = lspr_edits_consistent(&r)
    let unique = lspr_edits_unique_locations(&r)
    safe && consistent && unique && r.count == 3
}

// T01: lspr_table_new starts empty
fn test_lspr_table_new_empty() -> bool {
    let t = lspr_table_new()
    t.count == 0
}

// T02: lspr_add_symbol returns 0 for first symbol
fn test_lspr_add_symbol_first() -> bool with Mut, Div, Panic {
    var t = lspr_table_new()
    let id = lspr_add_symbol(&! t, "foo")
    id == 0
}

// T03: lspr_add_symbol increments count
fn test_lspr_add_symbol_count() -> bool with Mut, Div, Panic {
    var t = lspr_table_new()
    tir_inner_add_symbol_count(&! t)
}

// T04: lspr_find_symbol finds by name
fn test_lspr_find_symbol_found() -> bool with Mut, Div, Panic {
    var t = lspr_table_new()
    tir_inner_find_symbol_found(&! t)
}

// T05: lspr_find_symbol returns INVALID for unknown
fn test_lspr_find_symbol_miss() -> bool with Mut, Div, Panic {
    var t = lspr_table_new()
    tir_inner_find_symbol_miss(&! t)
}

// T06: lspr_find_symbol returns INVALID on empty table
fn test_lspr_find_symbol_empty() -> bool {
    let t = lspr_table_new()
    lspr_find_symbol(&t, "x") == LSPR_INVALID
}

// T07: lspr_add_ref adds to symbol ref list
fn test_lspr_add_ref_basic() -> bool with Mut, Div, Panic {
    var t = lspr_table_new()
    tir_inner_add_ref_basic(&! t)
}

// T08: lspr_add_ref stores file_id correctly
fn test_lspr_add_ref_file_id() -> bool with Mut, Div, Panic {
    var t = lspr_table_new()
    tir_inner_add_ref_file_id(&! t)
}

// T09: lspr_add_ref stores line correctly
fn test_lspr_add_ref_line() -> bool with Mut, Div, Panic {
    var t = lspr_table_new()
    tir_inner_add_ref_line(&! t)
}

// T10: lspr_add_ref stores kind correctly
fn test_lspr_add_ref_kind() -> bool with Mut, Div, Panic {
    var t = lspr_table_new()
    tir_inner_add_ref_kind(&! t)
}

// T11: lspr_add_ref with invalid sym_id is a no-op
fn test_lspr_add_ref_bad_id() -> bool with Mut, Div, Panic {
    var t = lspr_table_new()
    lspr_add_ref(&! t, 99, 1, 1, 0, 2, LSPR_KIND_USE)
    t.count == 0
}

// T12: multiple refs to same symbol
fn test_lspr_add_ref_multiple() -> bool with Mut, Div, Panic {
    var t = lspr_table_new()
    tir_inner_add_ref_multiple(&! t)
}

// T13: lspr_validate_name accepts simple identifier
fn test_lspr_validate_name_simple() -> bool {
    lspr_validate_name("foo") == true
}

// T14: lspr_validate_name accepts underscore-prefixed
fn test_lspr_validate_name_underscore() -> bool {
    lspr_validate_name("_foo") == true
}

// T15: lspr_validate_name accepts mixed case with digits
fn test_lspr_validate_name_mixed() -> bool {
    lspr_validate_name("Foo123") == true
}

// T16: lspr_validate_name rejects empty string
fn test_lspr_validate_name_empty() -> bool {
    lspr_validate_name("") == false
}

// T17: lspr_validate_name rejects digit start
fn test_lspr_validate_name_digit_start() -> bool {
    lspr_validate_name("1foo") == false
}

// T18: lspr_validate_name rejects space
fn test_lspr_validate_name_space() -> bool {
    lspr_validate_name("foo bar") == false
}

// T19: lspr_validate_name rejects dot
fn test_lspr_validate_name_dot() -> bool {
    lspr_validate_name("foo.bar") == false
}

// T20: lspr_validate_name rejects hyphen
fn test_lspr_validate_name_hyphen() -> bool {
    lspr_validate_name("foo-bar") == false
}

// T21: lspr_rename with invalid sym_id returns error
fn test_lspr_rename_bad_id() -> bool {
    let t = lspr_table_new()
    let r = lspr_rename(&t, 99, "new_name")
    r.valid == false
}

