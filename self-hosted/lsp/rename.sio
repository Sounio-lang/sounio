// ============================================================================
// Section 16: TEST RUNNER
// ============================================================================

fn lspr_run_all_tests() -> i64 with Mut, Div, Panic {
    var passed: i64 = 0
    var failed: i64 = 0

    if test_lspr_table_new_empty()             { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_add_symbol_first()            { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_add_symbol_count()            { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_find_symbol_found()           { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_find_symbol_miss()            { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_find_symbol_empty()           { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_add_ref_basic()               { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_add_ref_file_id()             { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_add_ref_line()                { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_add_ref_kind()                { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_add_ref_bad_id()              { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_add_ref_multiple()            { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_validate_name_simple()        { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_validate_name_underscore()    { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_validate_name_mixed()         { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_validate_name_empty()         { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_validate_name_digit_start()   { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_validate_name_space()         { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_validate_name_dot()           { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_validate_name_hyphen()        { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_rename_bad_id()               { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_rename_bad_name()             { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_rename_same_name()            { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_rename_conflict()             { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_rename_edit_count()           { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_rename_old_name()             { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_rename_new_name()             { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_rename_edit_location()        { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_rename_no_refs()              { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_rename_by_name()              { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_rename_by_name_miss()         { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_location_new()                { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_location_eq_true()            { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_location_eq_false()           { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_location_span()               { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_location_contains_col_in()    { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_location_contains_col_out()   { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_table_total_refs()            { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_table_used_symbols()          { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_table_unreferenced_symbols()  { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_table_most_referenced()       { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_table_most_referenced_empty() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_count_refs_of_kind_def()      { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_count_refs_of_kind_use()      { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_count_refs_of_kind_type()     { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_edits_consistent_true()       { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_edits_unique_locations_true() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_result_is_safe_true()         { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_result_is_safe_error()        { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_filter_edits_by_file()        { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_result_edits_in_file()        { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_result_edits_on_line()        { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_sort_edits_by_line()          { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_result_max_line()             { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_result_min_line()             { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_symbol_file_count()           { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_symbol_file_count_dedup()     { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_symbol_ref_at()               { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_symbol_ref_at_oob()           { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_result_edit_at()              { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_result_edit_at_oob()          { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_result_valid_true()           { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_result_valid_false()          { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_result_error_msg()            { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_validate_name_caps()          { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_validate_name_empty2()        { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_symbol_name()                 { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_symbol_ref_count()            { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_rename_type_ref()             { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspr_full_pipeline()               { passed = passed + 1 } else { failed = failed + 1 }

    if failed == 0 {
        return 0
    }
    failed
}
