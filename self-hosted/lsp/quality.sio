// self-hosted::lsp::quality -- LSP code quality analyzer for Sounio
//
// Computes complexity metrics, detects code smells, and tracks technical debt.
// Works on pre-computed AST metrics passed in (does not directly parse source).
// All state lives in flat fixed-size arenas -- no heap allocation, no
// recursive structures.
//
// Capacities:
//   - Smells per context: 256
//
// Sounio-specific smells:
//   - UNHANDLED_EFFECT    — effect declared but not handled
//   - EFFECT_OVERLOAD     — too many effects on one function
//   - KNOWLEDGE_LOSS      — Knowledge<T> value unwrapped unsafely
//   - MISSING_PROVENANCE  — Knowledge without source documentation
//
// Prefix: lspq_

// ============================================================================
// Section 1: CODE SMELL KIND CONSTANTS
// ============================================================================

let LSPQ_SMELL_LONG_FUNCTION:      i64 = 1
let LSPQ_SMELL_LARGE_MODULE:       i64 = 2
let LSPQ_SMELL_DEEP_NESTING:       i64 = 3
let LSPQ_SMELL_MANY_PARAMS:        i64 = 4
let LSPQ_SMELL_DEAD_CODE:          i64 = 5
let LSPQ_SMELL_UNUSED_IMPORT:      i64 = 6
let LSPQ_SMELL_MAGIC_NUMBER:       i64 = 7
let LSPQ_SMELL_EMPTY_BLOCK:        i64 = 8
let LSPQ_SMELL_UNHANDLED_EFFECT:   i64 = 9
let LSPQ_SMELL_EFFECT_OVERLOAD:    i64 = 10
let LSPQ_SMELL_KNOWLEDGE_LOSS:     i64 = 11
let LSPQ_SMELL_MISSING_PROVENANCE: i64 = 12

// ============================================================================
// Section 2: SEVERITY CONSTANTS
// ============================================================================

let LSPQ_SEV_INFO:    i64 = 1
let LSPQ_SEV_WARNING: i64 = 2
let LSPQ_SEV_ERROR:   i64 = 3

// ============================================================================
// Section 3: QUALITY RATING CONSTANTS
// ============================================================================

let LSPQ_RATING_A: i64 = 1
let LSPQ_RATING_B: i64 = 2
let LSPQ_RATING_C: i64 = 3
let LSPQ_RATING_D: i64 = 4
let LSPQ_RATING_E: i64 = 5

// ============================================================================
// Section 4: THRESHOLD CONSTANTS
// ============================================================================

let LSPQ_MAX_FN_LENGTH:  i64 = 50
let LSPQ_MAX_FN_PARAMS:  i64 = 5
let LSPQ_MAX_NESTING:    i64 = 4
let LSPQ_MAX_CYCLOMATIC: i64 = 10
let LSPQ_MAX_COGNITIVE:  i64 = 15
let LSPQ_MAX_MODULE_LOC: i64 = 500
let LSPQ_MAX_EFFECTS:    i64 = 4

// ============================================================================
// Section 5: STRUCTS
// ============================================================================

struct LspqRange {
    start_line: i64,
    start_col:  i64,
    end_line:   i64,
    end_col:    i64,
}

struct LspqSmell {
    kind:         i64,
    severity:     i64,
    range:        LspqRange,
    message:      string,
    suggestion:   string,
    debt_minutes: i64,
}

struct LspqMetrics {
    cyclomatic:            i64,
    cognitive:             i64,
    max_nesting:           i64,
    loc_total:             i64,
    loc_code:              i64,
    loc_comment:           i64,
    fn_count:              i64,
    fn_avg_length:         i64,
    fn_max_length:         i64,
    fn_avg_params:         i64,
    fn_max_params:         i64,
    effect_count_total:    i64,
    knowledge_count:       i64,
    maintainability_index: f64,
}

struct LspqDebt {
    total_debt_minutes: i64,
    smell_count:        i64,
    critical_count:     i64,
    major_count:        i64,
    minor_count:        i64,
    quality_rating:     i64,
    rating_letter:      string,
}

struct LspqContext {
    file_id:     i64,
    file_path:   string,
    metrics:     LspqMetrics,
    smells:      [LspqSmell; 256],
    smell_count: i64,
    debt:        LspqDebt,
}

// ============================================================================
// Section 6: JSON BUFFER (local copy -- this file is standalone)
// ============================================================================

struct JsonBuf {
    data: [i8; 65536],
    len:  i64,
}

fn lspq_jb_new() -> JsonBuf {
    JsonBuf {
        data: [0; 65536],
        len:  0,
    }
}

fn lspq_jb_emit_byte(buf: JsonBuf, b: i8) -> JsonBuf with Mut, Panic {
    var out = buf
    if out.len < 65536 {
        out.data[out.len as usize] = b
        out.len = out.len + 1
    }
    out
}

fn lspq_jb_emit_char(buf: JsonBuf, ch: i64) -> JsonBuf with Mut, Panic {
    lspq_jb_emit_byte(buf, ch as i8)
}

fn lspq_jb_emit_int(buf: JsonBuf, val: i64) -> JsonBuf with Mut, Panic, Div {
    if val == 0 {
        return lspq_jb_emit_char(buf, 48)
    }
    var n = val
    var out = buf
    if n < 0 {
        out = lspq_jb_emit_char(out, 45)
        n = 0 - n
    }
    var digits: [i8; 24] = [0; 24]
    var dlen: i64 = 0
    while n > 0 && dlen < 24 {
        let d = n - (n / 10) * 10
        digits[dlen as usize] = (d + 48) as i8
        n = n / 10
        dlen = dlen + 1
    }
    var i = dlen - 1
    while i >= 0 {
        out = lspq_jb_emit_byte(out, digits[i as usize])
        i = i - 1
    }
    out
}

fn lspq_jb_open_object(buf: JsonBuf) -> JsonBuf with Mut, Panic {
    lspq_jb_emit_char(buf, 123)
}

fn lspq_jb_close_object(buf: JsonBuf) -> JsonBuf with Mut, Panic {
    lspq_jb_emit_char(buf, 125)
}

fn lspq_jb_open_array(buf: JsonBuf) -> JsonBuf with Mut, Panic {
    lspq_jb_emit_char(buf, 91)
}

fn lspq_jb_close_array(buf: JsonBuf) -> JsonBuf with Mut, Panic {
    lspq_jb_emit_char(buf, 93)
}

fn lspq_jb_emit_comma(buf: JsonBuf) -> JsonBuf with Mut, Panic {
    lspq_jb_emit_char(buf, 44)
}

fn lspq_jb_emit_colon(buf: JsonBuf) -> JsonBuf with Mut, Panic {
    lspq_jb_emit_char(buf, 58)
}

fn lspq_jb_emit_string(buf: JsonBuf, s: string) -> JsonBuf with Mut, Panic, Div {
    var out = lspq_jb_emit_char(buf, 34)
    let len = str_len(s)
    var i: i64 = 0
    while i < len {
        let ch = str_char_at(s, i)
        out = lspq_jb_emit_char(out, ch)
        i = i + 1
    }
    out = lspq_jb_emit_char(out, 34)
    out
}

fn lspq_jb_emit_packed_key(buf: JsonBuf, key: i64) -> JsonBuf with Mut, Panic, Div {
    var out = lspq_jb_emit_char(buf, 34)
    var k = key
    while k > 0 {
        let bv = k - (k / 256) * 256
        out = lspq_jb_emit_char(out, bv)
        k = k / 256
    }
    out = lspq_jb_emit_char(out, 34)
    out
}

// Pre-computed packed keys for JSON field names.
// Encoding: char_0 + char_1*256 + char_2*65536 + ...

// "kind"    k(107) i(105) n(110) d(100)
fn lspq_key_kind() -> i64 {
    107 + 105 * 256 + 110 * 65536 + 100 * 16777216
}

// "severity" s(115) e(101) v(118) e(101) r(114) i(105) t(116) y(121)
fn lspq_key_severity() -> i64 {
    115 + 101 * 256 + 118 * 65536 + 101 * 16777216
    + 114 * 4294967296 + 105 * 1099511627776
    + 116 * 281474976710656 + 121 * 72057594037927936
}

// "message"  m(109) e(101) s(115) s(115) a(97) g(103) e(101)
fn lspq_key_message() -> i64 {
    109 + 101 * 256 + 115 * 65536 + 115 * 16777216
    + 97 * 4294967296 + 103 * 1099511627776
    + 101 * 281474976710656
}

// "debt"     d(100) e(101) b(98) t(116)
fn lspq_key_debt() -> i64 {
    100 + 101 * 256 + 98 * 65536 + 116 * 16777216
}

// "smells"   s(115) m(109) e(101) l(108) l(108) s(115)
fn lspq_key_smells() -> i64 {
    115 + 109 * 256 + 101 * 65536 + 108 * 16777216
    + 108 * 4294967296 + 115 * 1099511627776
}

// "metrics"  m(109) e(101) t(116) r(114) i(105) c(99) s(115)
fn lspq_key_metrics() -> i64 {
    109 + 101 * 256 + 116 * 65536 + 114 * 16777216
    + 105 * 4294967296 + 99 * 1099511627776
    + 115 * 281474976710656
}

// "rating"   r(114) a(97) t(116) i(105) n(110) g(103)
fn lspq_key_rating() -> i64 {
    114 + 97 * 256 + 116 * 65536 + 105 * 16777216
    + 110 * 4294967296 + 103 * 1099511627776
}

// Long keys emitted character by character.

fn lspq_jb_emit_key_cyclomatic(buf: JsonBuf) -> JsonBuf with Mut, Panic, Div {
    var out = lspq_jb_emit_char(buf, 34)
    out = lspq_jb_emit_char(out, 99)
    out = lspq_jb_emit_char(out, 121)
    out = lspq_jb_emit_char(out, 99)
    out = lspq_jb_emit_char(out, 108)
    out = lspq_jb_emit_char(out, 111)
    out = lspq_jb_emit_char(out, 109)
    out = lspq_jb_emit_char(out, 97)
    out = lspq_jb_emit_char(out, 116)
    out = lspq_jb_emit_char(out, 105)
    out = lspq_jb_emit_char(out, 99)
    out = lspq_jb_emit_char(out, 34)
    out
}

fn lspq_jb_emit_key_cognitive(buf: JsonBuf) -> JsonBuf with Mut, Panic, Div {
    var out = lspq_jb_emit_char(buf, 34)
    out = lspq_jb_emit_char(out, 99)
    out = lspq_jb_emit_char(out, 111)
    out = lspq_jb_emit_char(out, 103)
    out = lspq_jb_emit_char(out, 110)
    out = lspq_jb_emit_char(out, 105)
    out = lspq_jb_emit_char(out, 116)
    out = lspq_jb_emit_char(out, 105)
    out = lspq_jb_emit_char(out, 118)
    out = lspq_jb_emit_char(out, 101)
    out = lspq_jb_emit_char(out, 34)
    out
}

fn lspq_jb_emit_key_loc_total(buf: JsonBuf) -> JsonBuf with Mut, Panic, Div {
    var out = lspq_jb_emit_char(buf, 34)
    out = lspq_jb_emit_char(out, 108)
    out = lspq_jb_emit_char(out, 111)
    out = lspq_jb_emit_char(out, 99)
    out = lspq_jb_emit_char(out, 95)
    out = lspq_jb_emit_char(out, 116)
    out = lspq_jb_emit_char(out, 111)
    out = lspq_jb_emit_char(out, 116)
    out = lspq_jb_emit_char(out, 97)
    out = lspq_jb_emit_char(out, 108)
    out = lspq_jb_emit_char(out, 34)
    out
}

fn lspq_jb_emit_key_suggestion(buf: JsonBuf) -> JsonBuf with Mut, Panic, Div {
    var out = lspq_jb_emit_char(buf, 34)
    out = lspq_jb_emit_char(out, 115)
    out = lspq_jb_emit_char(out, 117)
    out = lspq_jb_emit_char(out, 103)
    out = lspq_jb_emit_char(out, 103)
    out = lspq_jb_emit_char(out, 101)
    out = lspq_jb_emit_char(out, 115)
    out = lspq_jb_emit_char(out, 116)
    out = lspq_jb_emit_char(out, 105)
    out = lspq_jb_emit_char(out, 111)
    out = lspq_jb_emit_char(out, 110)
    out = lspq_jb_emit_char(out, 34)
    out
}

fn lspq_jb_emit_key_total_debt(buf: JsonBuf) -> JsonBuf with Mut, Panic, Div {
    var out = lspq_jb_emit_char(buf, 34)
    out = lspq_jb_emit_char(out, 116)
    out = lspq_jb_emit_char(out, 111)
    out = lspq_jb_emit_char(out, 116)
    out = lspq_jb_emit_char(out, 97)
    out = lspq_jb_emit_char(out, 108)
    out = lspq_jb_emit_char(out, 95)
    out = lspq_jb_emit_char(out, 100)
    out = lspq_jb_emit_char(out, 101)
    out = lspq_jb_emit_char(out, 98)
    out = lspq_jb_emit_char(out, 116)
    out = lspq_jb_emit_char(out, 34)
    out
}

fn lspq_jb_emit_key_smell_count(buf: JsonBuf) -> JsonBuf with Mut, Panic, Div {
    var out = lspq_jb_emit_char(buf, 34)
    out = lspq_jb_emit_char(out, 115)
    out = lspq_jb_emit_char(out, 109)
    out = lspq_jb_emit_char(out, 101)
    out = lspq_jb_emit_char(out, 108)
    out = lspq_jb_emit_char(out, 108)
    out = lspq_jb_emit_char(out, 95)
    out = lspq_jb_emit_char(out, 99)
    out = lspq_jb_emit_char(out, 111)
    out = lspq_jb_emit_char(out, 117)
    out = lspq_jb_emit_char(out, 110)
    out = lspq_jb_emit_char(out, 116)
