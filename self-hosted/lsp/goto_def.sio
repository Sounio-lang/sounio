// T18: find innermost definition (deepest scope)
fn test_lspg_find_innermost_inner(ctx: &! LspgContext) -> bool with Mut, Div, Panic {
    let loc1 = lspg_location_new(1, 1, 0, 1, 5)
    let loc2 = lspg_location_new(1, 3, 0, 3, 5)
    let id1 = lspg_add_definition(ctx, LspgSymKind::GSymVariable, 700, loc1, 0)
    let id2 = lspg_add_definition(ctx, LspgSymKind::GSymVariable, 700, loc2, 2)
    let _ = id1
    let found = lspg_find_innermost_def(ctx, 700)
    found == id2
}
