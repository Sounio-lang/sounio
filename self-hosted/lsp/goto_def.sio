// T44: handle definition -- prefers tighter span
fn test_lspg_handle_def_tighter_inner(ctx: &! LspgContext) -> bool with Mut, Div, Panic {
    lspg_set_current_file(ctx, 1)
    // Outer span: line 3, col 0..20
    let loc_outer = lspg_location_new(1, 3, 0, 3, 20)
    let id_outer = lspg_add_definition(ctx, LspgSymKind::GSymFunction, 100, loc_outer, 0)
    // Inner span: line 3, col 5..10
    let loc_inner = lspg_location_new(1, 3, 5, 3, 10)
    let id_inner = lspg_add_definition(ctx, LspgSymKind::GSymVariable, 101, loc_inner, 1)
    let _ = id_outer
    // Cursor at line 3, col 7 -- should resolve to inner
    let resolved = lspg_resolve_at_cursor(ctx, 3, 7)
    resolved == id_inner
}
fn test_lspg_handle_def_tighter() -> bool with Mut, Div, Panic {
    var ctx = lspg_context_new()
    test_lspg_handle_def_tighter_inner(&! ctx)
}

// T45: resolve at cursor picks def over ref when both overlap
fn test_lspg_resolve_def_over_ref_inner(ctx: &! LspgContext) -> bool with Mut, Div, Panic {
    lspg_set_current_file(ctx, 1)
    let loc = lspg_location_new(1, 5, 3, 5, 12)
    let def_id = lspg_add_definition(ctx, LspgSymKind::GSymVariable, 100, loc, 0)
    // Add a ref at the exact same location
    let ref_id = lspg_add_reference(ctx, 999, LspgRefKind::RefUsage, loc)
    let _ = ref_id
    // Should resolve to the def (def checked first)
    let resolved = lspg_resolve_at_cursor(ctx, 5, 7)
    resolved == def_id
}
fn test_lspg_resolve_def_over_ref() -> bool with Mut, Div, Panic {
    var ctx = lspg_context_new()
    test_lspg_resolve_def_over_ref_inner(&! ctx)
}

// T46: resolve at cursor in different file context
fn test_lspg_resolve_file_ctx_inner(ctx: &! LspgContext) -> bool with Mut, Div, Panic {
    // Def in file 1
    lspg_set_current_file(ctx, 1)
    let loc = lspg_location_new(1, 5, 3, 5, 12)
    let def_id = lspg_add_definition(ctx, LspgSymKind::GSymFunction, 100, loc, 0)
    let _ = def_id
    // Switch to file 2 -- should not find def
    lspg_set_current_file(ctx, 2)
    let resolved = lspg_find_def_at(ctx, 5, 7)
    resolved == LSPG_INVALID
}
fn test_lspg_resolve_file_ctx() -> bool with Mut, Div, Panic {
    var ctx = lspg_context_new()
    test_lspg_resolve_file_ctx_inner(&! ctx)
}

