}
fn test_lspg_result_at_oob() -> bool with Mut, Div, Panic {
    var ctx = lspg_context_new()
    test_lspg_result_at_oob_inner(&! ctx)
}

// T61: result deduplication
fn test_lspg_result_dedup_inner(ctx: &! LspgContext) -> bool with Mut, Div, Panic {
    lspg_clear_results(ctx)
    let loc = lspg_location_new(1, 5, 3, 5, 12)
    let ok1 = lspg_add_result_unique(ctx, loc)
    let ok2 = lspg_add_result_unique(ctx, loc)
    // First add should succeed, second should be skipped
    ok1 && ok2 == false && lspg_result_count(ctx) == 1
}
fn test_lspg_result_dedup() -> bool with Mut, Div, Panic {
    var ctx = lspg_context_new()
    test_lspg_result_dedup_inner(&! ctx)
}

// T62: multiple results in order
fn test_lspg_result_multi_inner(ctx: &! LspgContext) -> bool with Mut, Div, Panic {
    lspg_clear_results(ctx)
    let loc1 = lspg_location_new(1, 1, 0, 1, 5)
    let loc2 = lspg_location_new(1, 3, 0, 3, 5)
    let loc3 = lspg_location_new(1, 7, 0, 7, 5)
    let ok1 = lspg_add_result(ctx, loc1)
    let ok2 = lspg_add_result(ctx, loc2)
    let ok3 = lspg_add_result(ctx, loc3)
    let _ = ok1
    let _ = ok2
    let _ = ok3
    let count = lspg_result_count(ctx)
    let r0 = lspg_result_at(ctx, 0)
    let r1 = lspg_result_at(ctx, 1)
    let r2 = lspg_result_at(ctx, 2)
    count == 3
        && lspg_location_eq(&r0, &loc1)
        && lspg_location_eq(&r1, &loc2)
        && lspg_location_eq(&r2, &loc3)
}
fn test_lspg_result_multi() -> bool with Mut, Div, Panic {
    var ctx = lspg_context_new()
    test_lspg_result_multi_inner(&! ctx)
}

// -------------------------------------------------------
// Integration tests (T63-T70)
// -------------------------------------------------------

// T63: full goto-def pipeline -- register, reference, resolve
fn test_lspg_pipeline_goto_def_inner(ctx: &! LspgContext) -> bool with Mut, Div, Panic {
    lspg_set_current_file(ctx, 1)
    // Register a function definition at line 1
    let loc_d = lspg_location_new(1, 1, 4, 1, 12)
    let def_id = lspg_register_full(ctx, LspgSymKind::GSymFunction, 1001, loc_d, 0)
    // Add a usage reference at line 10
    let loc_r = lspg_location_new(1, 10, 2, 10, 10)
    let ref_id = lspg_add_reference(ctx, def_id, LspgRefKind::RefUsage, loc_r)
    let _ = ref_id
    // Goto-def from the reference site
    let ok = lspg_handle_definition(ctx, 10, 5)
    let count = lspg_result_count(ctx)
    let result = lspg_result_at(ctx, 0)
    ok && count == 1 && lspg_location_eq(&result, &loc_d)
}
fn test_lspg_pipeline_goto_def() -> bool with Mut, Div, Panic {
    var ctx = lspg_context_new()
    test_lspg_pipeline_goto_def_inner(&! ctx)
}

// T64: full find-references pipeline
fn test_lspg_pipeline_find_refs_inner(ctx: &! LspgContext) -> bool with Mut, Div, Panic {
    lspg_set_current_file(ctx, 1)
    let loc_d = lspg_location_new(1, 1, 4, 1, 12)
    let def_id = lspg_register_full(ctx, LspgSymKind::GSymVariable, 2001, loc_d, 0)
    // Three usage refs
    let loc_r1 = lspg_location_new(1, 5, 0, 5, 5)
    let loc_r2 = lspg_location_new(1, 8, 0, 8, 5)
    let loc_r3 = lspg_location_new(1, 12, 0, 12, 5)
    let r1 = lspg_add_reference(ctx, def_id, LspgRefKind::RefUsage, loc_r1)
    let r2 = lspg_add_reference(ctx, def_id, LspgRefKind::RefRead, loc_r2)
    let r3 = lspg_add_reference(ctx, def_id, LspgRefKind::RefWrite, loc_r3)
    let _ = r1
    let _ = r2
    let _ = r3
    // Find refs from the def site -- note: register_full also adds a RefDefinition ref
    let ok = lspg_handle_references(ctx, 1, 6)
    let count = lspg_result_count(ctx)
    // 1 def-ref (from register_full) + 3 usage refs = 4
    ok && count == 4
}
fn test_lspg_pipeline_find_refs() -> bool with Mut, Div, Panic {
    var ctx = lspg_context_new()
    test_lspg_pipeline_find_refs_inner(&! ctx)
}

