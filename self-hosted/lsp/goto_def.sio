    let r2 = lspg_add_reference(ctx, def_id, LspgRefKind::RefRead, loc_r2)
    let _ = r1
    let _ = r2
    lspg_build_def_map(ctx)
    lspg_build_ref_index(ctx)
    let sym_idx = lspg_find_symbol_by_hash(ctx, 100)
    ctx.symbols[sym_idx as usize].ref_count == 2
}
