}
fn test_lspg_result_clear() -> bool with Mut, Div, Panic {
    var ctx = lspg_context_new()
    test_lspg_result_clear_inner(&! ctx)
}

// T60: result at out of bounds returns zero loc
fn test_lspg_result_at_oob_inner(ctx: &! LspgContext) -> bool with Mut, Div, Panic {
