// self-hosted::lsp::goto_def -- LSP go-to-definition and find-references
//
// Implements the core symbol table, definition tracking, and reference
// collection needed by textDocument/definition and textDocument/references
// LSP requests.  All string data is represented as i64 name hashes
// (intern IDs); the actual text lives in the StringInterner and is
// resolved at the transport boundary.
//
// The module maintains a flat-arena context (LspgContext) with:
//   - Definition table       (4096 entries)
//   - Reference table        (8192 entries)
//   - Symbol table           (4096 entries)
//   - Result list            (512 entries)
//   - sym_id → def_id bridge (4096 entries)
//
// No heap allocation, no recursive structures.  Every lookup is a
// linear scan over the arena -- perfectly adequate for files under
// a few thousand definitions.
//
// Cross-file goto-definition (Section 27) uses the module resolver's
// hierarchical namespace (ModuleGraph + mod_graph_resolve_import) as a
// fallback when the legacy flat scan cannot find a definition.  The
// sym_id_to_def_id bridge table maps resolver symbol IDs (from
// MgModuleExport.symbol_id) back to LspgContext definition indices.
//
// Naming convention: all public names use the `lspg_` prefix to avoid
// global namespace collisions.

// Import the module resolver's graph types so we can call
// mod_graph_resolve_import for cross-file symbol lookup (Section 27).
use resolve::modules::*

// ============================================================================
// Section 1: CONSTANTS
// ============================================================================

let LSPG_MAX_DEFS: i64    = 4096
let LSPG_MAX_REFS: i64    = 8192
let LSPG_MAX_FILES: i64   = 256
let LSPG_MAX_RESULTS: i64 = 512
let LSPG_MAX_SYMBOLS: i64 = 4096
let LSPG_MAX_SYM_BRIDGE: i64 = 4096  // capacity of sym_id → def_id bridge table
let LSPG_INVALID: i64     = 0 - 1

// ============================================================================
// Section 2: ENUMS
// ============================================================================

enum LspgSymKind {
    GSymFunction,
    GSymVariable,
    GSymType,
    GSymField,
    GSymModule,
    GSymConstant,
    GSymParam,
    GSymImport,
}

enum LspgRefKind {
    RefUsage,
    RefDefinition,
    RefWrite,
    RefRead,
    RefImport,
}

// ============================================================================
// Section 3: CORE STRUCTS
// ============================================================================

struct LspgLocation {
    file_id: i64,
    line: i64,
    col: i64,
    end_line: i64,
    end_col: i64,
}

struct LspgDefinition {
    id: i64,
    sym_kind: LspgSymKind,
    name_hash: i64,
    loc: LspgLocation,
    scope_depth: i64,
}

struct LspgReference {
    def_id: i64,
    kind: LspgRefKind,
    loc: LspgLocation,
}

struct LspgSymbol {
    name_hash: i64,
    def_id: i64,
    sym_kind: LspgSymKind,
    ref_start: i64,
    ref_count: i64,
    loc: LspgLocation,
}

struct LspgResultList {
    results: [LspgLocation; 512],
    count: i64,
}

// Bridge table: maps resolver symbol_id → LspgContext def_id.
// Populated by lspg_register_def_with_sym_id; queried by the module-graph
// goto-def fallback path to convert MgModuleExport.symbol_id back into a
// local definition index.
struct LspgSymBridge {
    sym_id: i64,
    def_id: i64,
}

fn lspg_sym_bridge_zero() -> LspgSymBridge {
    LspgSymBridge {
        sym_id: 0 - 1,
        def_id: 0 - 1,
    }
}

struct LspgContext {
    defs: [LspgDefinition; 4096],
    def_count: i64,
    refs: [LspgReference; 8192],
    ref_count: i64,
    symbols: [LspgSymbol; 4096],
    sym_count: i64,
    results: LspgResultList,
    current_file_id: i64,
    // sym_id → def_id bridge for module-graph cross-file resolution
    sym_bridge: [LspgSymBridge; 4096],
    sym_bridge_count: i64,
}

// ============================================================================
// Section 4: DEFAULT VALUE CONSTRUCTORS
// ============================================================================

fn lspg_location_zero() -> LspgLocation {
    LspgLocation {
        file_id: 0,
        line: 0,
        col: 0,
        end_line: 0,
        end_col: 0,
    }
}

fn lspg_definition_zero() -> LspgDefinition {
    LspgDefinition {
        id: 0 - 1,
        sym_kind: LspgSymKind::GSymVariable,
        name_hash: 0,
        loc: lspg_location_zero(),
        scope_depth: 0,
    }
}

fn lspg_reference_zero() -> LspgReference {
    LspgReference {
        def_id: 0 - 1,
        kind: LspgRefKind::RefUsage,
        loc: lspg_location_zero(),
    }
}

fn lspg_symbol_zero() -> LspgSymbol {
    LspgSymbol {
        name_hash: 0,
        def_id: 0 - 1,
        sym_kind: LspgSymKind::GSymVariable,
        ref_start: 0,
        ref_count: 0,
        loc: lspg_location_zero(),
    }
}

fn lspg_result_list_zero() -> LspgResultList {
    LspgResultList {
        results: [lspg_location_zero(); 512],
        count: 0,
    }
}

// ============================================================================
// Section 5: CONTEXT CONSTRUCTOR
// ============================================================================

fn lspg_context_new() -> LspgContext {
    LspgContext {
        defs: [lspg_definition_zero(); 4096],
        def_count: 0,
        refs: [lspg_reference_zero(); 8192],
        ref_count: 0,
        symbols: [lspg_symbol_zero(); 4096],
        sym_count: 0,
        results: lspg_result_list_zero(),
        current_file_id: 0,
        sym_bridge: [lspg_sym_bridge_zero(); 4096],
        sym_bridge_count: 0,
    }
}

// ============================================================================
// Section 6: LOCATION FUNCTIONS
// ============================================================================

fn lspg_location_new(file_id: i64, line: i64, col: i64, end_line: i64, end_col: i64) -> LspgLocation {
    LspgLocation {
        file_id: file_id,
        line: line,
        col: col,
        end_line: end_line,
        end_col: end_col,
    }
}

fn lspg_location_eq(a: &LspgLocation, b: &LspgLocation) -> bool {
    a.file_id == b.file_id
        && a.line == b.line
        && a.col == b.col
        && a.end_line == b.end_line
        && a.end_col == b.end_col
}

// Returns true if the cursor position (line, col) falls within the span
// described by loc.  The span is inclusive on both endpoints.
fn lspg_location_contains(loc: &LspgLocation, line: i64, col: i64) -> bool {
    if line < loc.line { return false }
    if line > loc.end_line { return false }
    // Single-line span
    if loc.line == loc.end_line {
        return col >= loc.col && col <= loc.end_col
    }
    // Multi-line span: first line, last line, or middle line
    if line == loc.line {
        return col >= loc.col
    }
    if line == loc.end_line {
        return col <= loc.end_col
    }
    // Strictly between start and end lines -- always contained
    true
}

// Returns true if two locations overlap at all
fn lspg_location_overlaps(a: &LspgLocation, b: &LspgLocation) -> bool {
    if a.file_id == b.file_id {
        // Check that neither span is entirely before the other
        let a_before_b = a.end_line < b.line || (a.end_line == b.line && a.end_col < b.col)
        let b_before_a = b.end_line < a.line || (b.end_line == a.line && b.end_col < a.col)
        if a_before_b { return false }
        if b_before_a { return false }
        return true
    }
    false
}

// Returns the length of a location span in columns (single-line only)
fn lspg_location_span(loc: &LspgLocation) -> i64 {
    if loc.line == loc.end_line {
        return loc.end_col - loc.col + 1
    }
    // For multi-line spans, return -1 to indicate multi-line
    0 - 1
}

// Returns true if a location is the zero/invalid location
fn lspg_location_is_zero(loc: &LspgLocation) -> bool {
    loc.file_id == 0 && loc.line == 0 && loc.col == 0
        && loc.end_line == 0 && loc.end_col == 0
}

// ============================================================================
// Section 7: DEFINITION MANAGEMENT
// ============================================================================

fn lspg_add_definition(ctx: &! LspgContext, kind: LspgSymKind, name_hash: i64, loc: LspgLocation, scope: i64) -> i64 with Mut, Div, Panic {
    if ctx.def_count >= LSPG_MAX_DEFS {
        return LSPG_INVALID
    }
    let idx = ctx.def_count
    ctx.defs[idx as usize] = LspgDefinition {
        id: idx,
        sym_kind: kind,
        name_hash: name_hash,
        loc: loc,
        scope_depth: scope,
    }
    ctx.def_count = idx + 1
    idx
}

fn lspg_def_count(ctx: &LspgContext) -> i64 {
    ctx.def_count
}

fn lspg_def_location(ctx: &LspgContext, def_id: i64) -> LspgLocation with Div, Panic {
    if def_id < 0 || def_id >= ctx.def_count {
        return lspg_location_zero()
    }
    ctx.defs[def_id as usize].loc
}

fn lspg_def_name_hash(ctx: &LspgContext, def_id: i64) -> i64 with Div, Panic {
    if def_id < 0 || def_id >= ctx.def_count {
        return 0
    }
    ctx.defs[def_id as usize].name_hash
}

fn lspg_def_kind(ctx: &LspgContext, def_id: i64) -> LspgSymKind with Div, Panic {
    if def_id < 0 || def_id >= ctx.def_count {
        return LspgSymKind::GSymVariable
    }
    ctx.defs[def_id as usize].sym_kind
}

fn lspg_def_scope(ctx: &LspgContext, def_id: i64) -> i64 with Div, Panic {
    if def_id < 0 || def_id >= ctx.def_count {
        return 0 - 1
    }
    ctx.defs[def_id as usize].scope_depth
}

// Find the definition whose span contains (line, col) in the current file.
// Returns the definition id, or LSPG_INVALID if none found.
fn lspg_find_def_at(ctx: &LspgContext, line: i64, col: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    var best: i64 = LSPG_INVALID
    var best_span: i64 = 999999
    while i < ctx.def_count {
        let d = &ctx.defs[i as usize]
        if d.loc.file_id == ctx.current_file_id {
            if lspg_location_contains(&d.loc, line, col) {
                // Prefer the tightest enclosing span
                let span = lspg_location_span(&d.loc)
                if span >= 0 && span < best_span {
                    best = i
                    best_span = span
                }
                // If multi-line span and no better found yet, take it
                if span < 0 && best == LSPG_INVALID {
                    best = i
                }
            }
        }
        i = i + 1
    }
    best
}

// Find a definition by exact name hash.  Returns the first match, or LSPG_INVALID.
fn lspg_find_def_by_hash(ctx: &LspgContext, name_hash: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.def_count {
        if ctx.defs[i as usize].name_hash == name_hash {
            return i
        }
        i = i + 1
    }
    LSPG_INVALID
}

// Find a definition by name hash and kind.  Returns first match or LSPG_INVALID.
fn lspg_find_def_by_hash_and_kind(ctx: &LspgContext, name_hash: i64, kind: LspgSymKind) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.def_count {
        let d = &ctx.defs[i as usize]
        if d.name_hash == name_hash {
            let kind_match = match d.sym_kind {
                LspgSymKind::GSymFunction => match kind {
                    LspgSymKind::GSymFunction => true,
                    _ => false,
                },
                LspgSymKind::GSymVariable => match kind {
                    LspgSymKind::GSymVariable => true,
                    _ => false,
                },
                LspgSymKind::GSymType => match kind {
                    LspgSymKind::GSymType => true,
                    _ => false,
                },
                LspgSymKind::GSymField => match kind {
                    LspgSymKind::GSymField => true,
                    _ => false,
                },
                LspgSymKind::GSymModule => match kind {
                    LspgSymKind::GSymModule => true,
                    _ => false,
                },
                LspgSymKind::GSymConstant => match kind {
                    LspgSymKind::GSymConstant => true,
                    _ => false,
                },
                LspgSymKind::GSymParam => match kind {
                    LspgSymKind::GSymParam => true,
                    _ => false,
                },
                LspgSymKind::GSymImport => match kind {
                    LspgSymKind::GSymImport => true,
                    _ => false,
                },
            }
            if kind_match {
                return i
            }
        }
        i = i + 1
    }
    LSPG_INVALID
}

// Count definitions with a given name hash
fn lspg_count_defs_by_hash(ctx: &LspgContext, name_hash: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    var count: i64 = 0
    while i < ctx.def_count {
        if ctx.defs[i as usize].name_hash == name_hash {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Find the deepest-scope definition with a given name hash
fn lspg_find_innermost_def(ctx: &LspgContext, name_hash: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    var best: i64 = LSPG_INVALID
    var best_depth: i64 = 0 - 1
    while i < ctx.def_count {
        let d = &ctx.defs[i as usize]
        if d.name_hash == name_hash && d.scope_depth > best_depth {
            best = i
            best_depth = d.scope_depth
        }
        i = i + 1
    }
    best
}

// ============================================================================
// Section 8: REFERENCE MANAGEMENT
// ============================================================================

fn lspg_add_reference(ctx: &! LspgContext, def_id: i64, kind: LspgRefKind, loc: LspgLocation) -> i64 with Mut, Div, Panic {
    if ctx.ref_count >= LSPG_MAX_REFS {
        return LSPG_INVALID
    }
    let idx = ctx.ref_count
    ctx.refs[idx as usize] = LspgReference {
        def_id: def_id,
        kind: kind,
        loc: loc,
    }
    ctx.ref_count = idx + 1
    idx
}

fn lspg_ref_count(ctx: &LspgContext) -> i64 {
    ctx.ref_count
}

// Find a reference whose span contains (line, col) in the current file.
// Returns the reference index, or LSPG_INVALID.
fn lspg_find_ref_at(ctx: &LspgContext, line: i64, col: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    var best: i64 = LSPG_INVALID
    var best_span: i64 = 999999
    while i < ctx.ref_count {
        let r = &ctx.refs[i as usize]
        if r.loc.file_id == ctx.current_file_id {
            if lspg_location_contains(&r.loc, line, col) {
                let span = lspg_location_span(&r.loc)
                if span >= 0 && span < best_span {
                    best = i
                    best_span = span
                }
                if span < 0 && best == LSPG_INVALID {
                    best = i
                }
            }
        }
        i = i + 1
    }
    best
}

// Count how many references point to a given definition
fn lspg_refs_for_def(ctx: &LspgContext, def_id: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    var count: i64 = 0
    while i < ctx.ref_count {
        if ctx.refs[i as usize].def_id == def_id {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Count references of a specific kind for a given definition
fn lspg_refs_for_def_kind(ctx: &LspgContext, def_id: i64, kind: LspgRefKind) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    var count: i64 = 0
    while i < ctx.ref_count {
        let r = &ctx.refs[i as usize]
        if r.def_id == def_id {
            let kind_match = match r.kind {
                LspgRefKind::RefUsage => match kind {
                    LspgRefKind::RefUsage => true,
                    _ => false,
                },
                LspgRefKind::RefDefinition => match kind {
                    LspgRefKind::RefDefinition => true,
                    _ => false,
                },
                LspgRefKind::RefWrite => match kind {
                    LspgRefKind::RefWrite => true,
                    _ => false,
                },
                LspgRefKind::RefRead => match kind {
                    LspgRefKind::RefRead => true,
                    _ => false,
                },
                LspgRefKind::RefImport => match kind {
                    LspgRefKind::RefImport => true,
                    _ => false,
                },
            }
            if kind_match {
                count = count + 1
            }
        }
        i = i + 1
    }
    count
}

// Get the def_id that a reference at index `ref_idx` points to
fn lspg_ref_def_id(ctx: &LspgContext, ref_idx: i64) -> i64 with Div, Panic {
    if ref_idx < 0 || ref_idx >= ctx.ref_count {
        return LSPG_INVALID
    }
    ctx.refs[ref_idx as usize].def_id
}

// Get the location of a reference at index `ref_idx`
fn lspg_ref_location(ctx: &LspgContext, ref_idx: i64) -> LspgLocation with Div, Panic {
    if ref_idx < 0 || ref_idx >= ctx.ref_count {
        return lspg_location_zero()
    }
    ctx.refs[ref_idx as usize].loc
}

// ============================================================================
// Section 9: SYMBOL TABLE MANAGEMENT
// ============================================================================

fn lspg_add_symbol(ctx: &! LspgContext, name_hash: i64, def_id: i64, kind: LspgSymKind, loc: LspgLocation) -> i64 with Mut, Div, Panic {
    if ctx.sym_count >= LSPG_MAX_SYMBOLS {
        return LSPG_INVALID
    }
    let idx = ctx.sym_count
    ctx.symbols[idx as usize] = LspgSymbol {
        name_hash: name_hash,
        def_id: def_id,
        sym_kind: kind,
        ref_start: 0,
        ref_count: 0,
        loc: loc,
    }
    ctx.sym_count = idx + 1
    idx
}

fn lspg_sym_count(ctx: &LspgContext) -> i64 {
    ctx.sym_count
}

// Find a symbol by name hash.  Returns the symbol index, or LSPG_INVALID.
fn lspg_find_symbol_by_hash(ctx: &LspgContext, name_hash: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.sym_count {
        if ctx.symbols[i as usize].name_hash == name_hash {
            return i
        }
        i = i + 1
    }
    LSPG_INVALID
}

// Find a symbol by def_id.  Returns the symbol index, or LSPG_INVALID.
fn lspg_find_symbol_by_def(ctx: &LspgContext, def_id: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.sym_count {
        if ctx.symbols[i as usize].def_id == def_id {
            return i
        }
        i = i + 1
    }
    LSPG_INVALID
}

// Count symbols of a given kind
fn lspg_count_symbols_by_kind(ctx: &LspgContext, kind: LspgSymKind) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    var count: i64 = 0
    while i < ctx.sym_count {
        let s = &ctx.symbols[i as usize]
        let kind_match = match s.sym_kind {
            LspgSymKind::GSymFunction => match kind {
                LspgSymKind::GSymFunction => true,
                _ => false,
            },
            LspgSymKind::GSymVariable => match kind {
                LspgSymKind::GSymVariable => true,
                _ => false,
            },
            LspgSymKind::GSymType => match kind {
                LspgSymKind::GSymType => true,
                _ => false,
            },
            LspgSymKind::GSymField => match kind {
                LspgSymKind::GSymField => true,
                _ => false,
            },
            LspgSymKind::GSymModule => match kind {
                LspgSymKind::GSymModule => true,
                _ => false,
            },
            LspgSymKind::GSymConstant => match kind {
                LspgSymKind::GSymConstant => true,
                _ => false,
            },
            LspgSymKind::GSymParam => match kind {
                LspgSymKind::GSymParam => true,
                _ => false,
            },
            LspgSymKind::GSymImport => match kind {
                LspgSymKind::GSymImport => true,
                _ => false,
            },
        }
        if kind_match {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Get the symbol's def_id at index sym_idx
fn lspg_symbol_def_id(ctx: &LspgContext, sym_idx: i64) -> i64 with Div, Panic {
    if sym_idx < 0 || sym_idx >= ctx.sym_count {
        return LSPG_INVALID
    }
    ctx.symbols[sym_idx as usize].def_id
}

// Get the symbol's name hash at index sym_idx
fn lspg_symbol_name_hash(ctx: &LspgContext, sym_idx: i64) -> i64 with Div, Panic {
    if sym_idx < 0 || sym_idx >= ctx.sym_count {
        return 0
    }
    ctx.symbols[sym_idx as usize].name_hash
}

// Update a symbol's ref_start and ref_count fields
fn lspg_symbol_set_refs(ctx: &! LspgContext, sym_idx: i64, ref_start: i64, ref_count: i64) with Mut, Div, Panic {
    if sym_idx >= 0 && sym_idx < ctx.sym_count {
        ctx.symbols[sym_idx as usize].ref_start = ref_start
        ctx.symbols[sym_idx as usize].ref_count = ref_count
    }
}

// ============================================================================
// Section 10: RESULT LIST MANAGEMENT
// ============================================================================

fn lspg_clear_results(ctx: &! LspgContext) with Mut {
    ctx.results.count = 0
}

fn lspg_result_count(ctx: &LspgContext) -> i64 {
    ctx.results.count
}

fn lspg_result_at(ctx: &LspgContext, idx: i64) -> LspgLocation with Div, Panic {
    if idx < 0 || idx >= ctx.results.count {
        return lspg_location_zero()
    }
    ctx.results.results[idx as usize]
}

fn lspg_add_result(ctx: &! LspgContext, loc: LspgLocation) -> bool with Mut, Div, Panic {
    if ctx.results.count >= LSPG_MAX_RESULTS {
        return false
    }
    ctx.results.results[ctx.results.count as usize] = loc
    ctx.results.count = ctx.results.count + 1
    true
}

// Check if a location is already in the result list (deduplication)
fn lspg_result_contains(ctx: &LspgContext, loc: &LspgLocation) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.results.count {
        if lspg_location_eq(&ctx.results.results[i as usize], loc) {
            return true
        }
        i = i + 1
    }
    false
}

// Add a location to the result list only if not already present
fn lspg_add_result_unique(ctx: &! LspgContext, loc: LspgLocation) -> bool with Mut, Div, Panic {
    if lspg_result_contains(ctx, &loc) {
        return false
    }
    lspg_add_result(ctx, loc)
}

// ============================================================================
// Section 11: FILE MANAGEMENT
// ============================================================================

fn lspg_set_current_file(ctx: &! LspgContext, file_id: i64) with Mut {
    ctx.current_file_id = file_id
}

fn lspg_current_file(ctx: &LspgContext) -> i64 {
    ctx.current_file_id
}

// ============================================================================
// Section 12: CURSOR RESOLUTION
// ============================================================================

// Resolve the def_id at a cursor position.  First checks if the cursor is
// on a definition site; if not, checks references and follows the link
// back to the definition.  Returns LSPG_INVALID if nothing found.
fn lspg_resolve_at_cursor(ctx: &LspgContext, line: i64, col: i64) -> i64 with Mut, Div, Panic {
    // First: is the cursor directly on a definition?
    let def_at = lspg_find_def_at(ctx, line, col)
    if def_at >= 0 {
        return def_at
    }
    // Second: is the cursor on a reference?  Follow to its definition.
    let ref_at = lspg_find_ref_at(ctx, line, col)
    if ref_at >= 0 {
        return lspg_ref_def_id(ctx, ref_at)
    }
    LSPG_INVALID
}

// Resolve the def_id at a cursor position, but only return it if it matches
// a specific file_id.  Useful for cross-file navigation.
fn lspg_resolve_at_cursor_in_file(ctx: &LspgContext, file_id: i64, line: i64, col: i64) -> i64 with Mut, Div, Panic {
    let def_id = lspg_resolve_at_cursor(ctx, line, col)
    if def_id == LSPG_INVALID {
        return LSPG_INVALID
    }
    let loc = lspg_def_location(ctx, def_id)
    if loc.file_id == file_id {
        return def_id
    }
    // Even if def is in a different file, still return it -- goto-def
    // is supposed to jump across files
    def_id
}

// ============================================================================
// Section 13: COLLECT REFERENCES
// ============================================================================

// Collect all reference locations for a given def_id into the result list.
fn lspg_collect_references(ctx: &! LspgContext, def_id: i64) with Mut, Div, Panic {
    lspg_clear_results(ctx)
    var i: i64 = 0
    while i < ctx.ref_count {
        if ctx.refs[i as usize].def_id == def_id {
            let added = lspg_add_result(ctx, ctx.refs[i as usize].loc)
            if added == false {
                return
            }
        }
        i = i + 1
    }
}

// Collect references of a specific kind for a given def_id
fn lspg_collect_references_by_kind(ctx: &! LspgContext, def_id: i64, kind: LspgRefKind) with Mut, Div, Panic {
    lspg_clear_results(ctx)
    var i: i64 = 0
    while i < ctx.ref_count {
        let r = &ctx.refs[i as usize]
        if r.def_id == def_id {
            let kind_match = match r.kind {
                LspgRefKind::RefUsage => match kind {
                    LspgRefKind::RefUsage => true,
                    _ => false,
                },
                LspgRefKind::RefDefinition => match kind {
                    LspgRefKind::RefDefinition => true,
                    _ => false,
                },
                LspgRefKind::RefWrite => match kind {
                    LspgRefKind::RefWrite => true,
                    _ => false,
                },
                LspgRefKind::RefRead => match kind {
                    LspgRefKind::RefRead => true,
                    _ => false,
                },
                LspgRefKind::RefImport => match kind {
                    LspgRefKind::RefImport => true,
                    _ => false,
                },
            }
            if kind_match {
                let added = lspg_add_result(ctx, r.loc)
                if added == false {
                    return
                }
            }
        }
        i = i + 1
    }
}

// Collect all definitions that share a given name hash into the result list.
fn lspg_collect_definitions_by_name(ctx: &! LspgContext, name_hash: i64) with Mut, Div, Panic {
    lspg_clear_results(ctx)
    var i: i64 = 0
    while i < ctx.def_count {
        if ctx.defs[i as usize].name_hash == name_hash {
            let added = lspg_add_result(ctx, ctx.defs[i as usize].loc)
            if added == false {
                return
            }
        }
        i = i + 1
    }
}

// Collect all references AND the definition location for a def_id.
// This is useful for "highlight all occurrences" behavior.
fn lspg_collect_all_occurrences(ctx: &! LspgContext, def_id: i64) with Mut, Div, Panic {
    lspg_clear_results(ctx)
    // Add the definition location first
    if def_id >= 0 && def_id < ctx.def_count {
        let added = lspg_add_result(ctx, ctx.defs[def_id as usize].loc)
        if added == false {
            return
        }
    }
    // Then add all reference locations
    var i: i64 = 0
    while i < ctx.ref_count {
        if ctx.refs[i as usize].def_id == def_id {
            let added = lspg_add_result(ctx, ctx.refs[i as usize].loc)
            if added == false {
                return
            }
        }
        i = i + 1
    }
}

// Collect definitions in a specific file
fn lspg_collect_defs_in_file(ctx: &! LspgContext, file_id: i64) with Mut, Div, Panic {
    lspg_clear_results(ctx)
    var i: i64 = 0
    while i < ctx.def_count {
        if ctx.defs[i as usize].loc.file_id == file_id {
            let added = lspg_add_result(ctx, ctx.defs[i as usize].loc)
            if added == false {
                return
            }
        }
        i = i + 1
    }
}

// Collect references in a specific file
fn lspg_collect_refs_in_file(ctx: &! LspgContext, file_id: i64) with Mut, Div, Panic {
    lspg_clear_results(ctx)
    var i: i64 = 0
    while i < ctx.ref_count {
        if ctx.refs[i as usize].loc.file_id == file_id {
            let added = lspg_add_result(ctx, ctx.refs[i as usize].loc)
            if added == false {
                return
            }
        }
        i = i + 1
    }
}

// ============================================================================
// Section 14: BUILD SYMBOL <-> DEFINITION MAPPING
// ============================================================================

// Walk all definitions and ensure each has a corresponding symbol entry.
// If a symbol with matching name_hash already exists, skip it (first wins).
fn lspg_build_def_map(ctx: &! LspgContext) with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.def_count {
        let d = &ctx.defs[i as usize]
        let existing = lspg_find_symbol_by_hash(ctx, d.name_hash)
        if existing == LSPG_INVALID {
            let added = lspg_add_symbol(ctx, d.name_hash, d.id, d.sym_kind, d.loc)
            // Ignore overflow (added == LSPG_INVALID)
            let _ = added
        }
        i = i + 1
    }
}

// Build a reverse index: for each symbol, count how many references
// point to the symbol's def_id and record the starting offset.
// This is a two-pass algorithm: first count, then assign start offsets.
fn lspg_build_ref_index(ctx: &! LspgContext) with Mut, Div, Panic {
    // Pass 1: count references per symbol
    var s: i64 = 0
    while s < ctx.sym_count {
        let def_id = ctx.symbols[s as usize].def_id
        var count: i64 = 0
        var r: i64 = 0
        while r < ctx.ref_count {
            if ctx.refs[r as usize].def_id == def_id {
                count = count + 1
            }
            r = r + 1
        }
        ctx.symbols[s as usize].ref_count = count
        s = s + 1
    }

    // Pass 2: assign start offsets (cumulative sum)
    var offset: i64 = 0
    var s2: i64 = 0
    while s2 < ctx.sym_count {
        ctx.symbols[s2 as usize].ref_start = offset
        offset = offset + ctx.symbols[s2 as usize].ref_count
        s2 = s2 + 1
    }
}

// ============================================================================
// Section 15: GOTO DEFINITION HANDLER
// ============================================================================

// Handle a textDocument/definition request.  Resolves the cursor position
// to a definition and places the definition location in the result list.
// Returns true if a definition was found, false otherwise.
fn lspg_handle_definition(ctx: &! LspgContext, line: i64, col: i64) -> bool with Mut, Div, Panic {
    lspg_clear_results(ctx)
    let def_id = lspg_resolve_at_cursor(ctx, line, col)
    if def_id == LSPG_INVALID {
        return false
    }
    let loc = lspg_def_location(ctx, def_id)
    if lspg_location_is_zero(&loc) {
        return false
    }
    let added = lspg_add_result(ctx, loc)
    added
}

// Handle goto-definition where the cursor may be on a reference that
// points to a definition in a different file.  The result includes the
// definition location regardless of file_id.
fn lspg_handle_definition_cross_file(ctx: &! LspgContext, file_id: i64, line: i64, col: i64) -> bool with Mut, Div, Panic {
    let saved_file = ctx.current_file_id
    lspg_set_current_file(ctx, file_id)
    let result = lspg_handle_definition(ctx, line, col)
    // Restore the previous file context
    lspg_set_current_file(ctx, saved_file)
    result
}

// ============================================================================
// Section 16: FIND REFERENCES HANDLER
// ============================================================================

// Handle a textDocument/references request.  Resolves the cursor position
// to a definition and collects all references to that definition into the
// result list.  Returns true if any references were found.
fn lspg_handle_references(ctx: &! LspgContext, line: i64, col: i64) -> bool with Mut, Div, Panic {
    lspg_clear_results(ctx)
    let def_id = lspg_resolve_at_cursor(ctx, line, col)
    if def_id == LSPG_INVALID {
        return false
    }
    lspg_collect_references(ctx, def_id)
    ctx.results.count > 0
}

// Handle find-references including the definition site in results
fn lspg_handle_references_with_def(ctx: &! LspgContext, line: i64, col: i64) -> bool with Mut, Div, Panic {
    lspg_clear_results(ctx)
    let def_id = lspg_resolve_at_cursor(ctx, line, col)
    if def_id == LSPG_INVALID {
        return false
    }
    lspg_collect_all_occurrences(ctx, def_id)
    ctx.results.count > 0
}

// Handle find-references for a specific reference kind only
fn lspg_handle_references_by_kind(ctx: &! LspgContext, line: i64, col: i64, kind: LspgRefKind) -> bool with Mut, Div, Panic {
    lspg_clear_results(ctx)
    let def_id = lspg_resolve_at_cursor(ctx, line, col)
    if def_id == LSPG_INVALID {
        return false
    }
    lspg_collect_references_by_kind(ctx, def_id, kind)
    ctx.results.count > 0
}

// ============================================================================
// Section 17: SCOPE-AWARE RESOLUTION HELPERS
// ============================================================================

// Check whether a definition at `def_id` is visible at scope `depth`.
// A definition is visible if its scope_depth <= depth.
fn lspg_def_visible_at(ctx: &LspgContext, def_id: i64, depth: i64) -> bool with Div, Panic {
    if def_id < 0 || def_id >= ctx.def_count {
        return false
    }
    ctx.defs[def_id as usize].scope_depth <= depth
}

// Resolve a name hash at a given scope depth.  Returns the innermost
// visible definition with that name, or LSPG_INVALID.
fn lspg_resolve_name_at_scope(ctx: &LspgContext, name_hash: i64, depth: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    var best: i64 = LSPG_INVALID
    var best_depth: i64 = 0 - 1
    while i < ctx.def_count {
        let d = &ctx.defs[i as usize]
        if d.name_hash == name_hash && d.scope_depth <= depth && d.scope_depth > best_depth {
            best = i
            best_depth = d.scope_depth
        }
        i = i + 1
    }
    best
}

// Check if a definition shadows another definition with the same name
fn lspg_is_shadowing(ctx: &LspgContext, def_id: i64) -> bool with Mut, Div, Panic {
    if def_id < 0 || def_id >= ctx.def_count {
        return false
    }
    let name = ctx.defs[def_id as usize].name_hash
    let depth = ctx.defs[def_id as usize].scope_depth
    var i: i64 = 0
    while i < ctx.def_count {
        if i == def_id {
            i = i + 1
            continue
        }
        let d = &ctx.defs[i as usize]
        if d.name_hash == name && d.scope_depth < depth {
            return true
        }
        i = i + 1
    }
    false
}

// ============================================================================
// Section 18: DIAGNOSTIC HELPERS
// ============================================================================

// Check if a definition has zero references (unused symbol)
fn lspg_def_is_unused(ctx: &LspgContext, def_id: i64) -> bool with Mut, Div, Panic {
    lspg_refs_for_def(ctx, def_id) == 0
}

// Count definitions in the entire context that are unused
fn lspg_count_unused_defs(ctx: &LspgContext) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    var count: i64 = 0
    while i < ctx.def_count {
        if lspg_refs_for_def(ctx, i) == 0 {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Count how many distinct definitions are referenced from a given file
fn lspg_count_defs_referenced_from(ctx: &LspgContext, file_id: i64) -> i64 with Mut, Div, Panic {
    // Use a simple bitmap approach: track seen def_ids
    // Since LSPG_MAX_DEFS is 4096, use a simple loop with dedup
    var seen: [i64; 512] = [0 - 1; 512]
    var seen_count: i64 = 0
    var i: i64 = 0
    while i < ctx.ref_count {
        let r = &ctx.refs[i as usize]
        if r.loc.file_id == file_id {
            // Check if already seen
            var already: bool = false
            var j: i64 = 0
            while j < seen_count {
                if seen[j as usize] == r.def_id {
                    already = true
                }
                j = j + 1
            }
            if already == false && seen_count < 512 {
                seen[seen_count as usize] = r.def_id
                seen_count = seen_count + 1
            }
        }
        i = i + 1
    }
    seen_count
}

// ============================================================================
// Section 19: SYMBOL KIND UTILITIES
// ============================================================================

// Convert LspgSymKind to an LSP SymbolKind integer (subset)
fn lspg_sym_kind_to_lsp(kind: LspgSymKind) -> i64 {
    match kind {
        LspgSymKind::GSymFunction => 12,   // Function
        LspgSymKind::GSymVariable => 13,   // Variable
        LspgSymKind::GSymType     => 5,    // Class (used for types)
        LspgSymKind::GSymField    => 8,    // Field
        LspgSymKind::GSymModule   => 2,    // Module
        LspgSymKind::GSymConstant => 14,   // Constant
        LspgSymKind::GSymParam    => 13,   // Variable (params are variables)
        LspgSymKind::GSymImport   => 2,    // Module (imports are module-like)
    }
}

// Convert LspgRefKind to a human-readable integer code
fn lspg_ref_kind_code(kind: LspgRefKind) -> i64 {
    match kind {
        LspgRefKind::RefUsage      => 1,
        LspgRefKind::RefDefinition => 2,
        LspgRefKind::RefWrite      => 3,
        LspgRefKind::RefRead       => 4,
        LspgRefKind::RefImport     => 5,
    }
}

// Check if a kind represents a callable (function or method)
fn lspg_kind_is_callable(kind: LspgSymKind) -> bool {
    match kind {
        LspgSymKind::GSymFunction => true,
        _ => false,
    }
}

// Check if a kind represents a type-like entity
fn lspg_kind_is_type_like(kind: LspgSymKind) -> bool {
    match kind {
        LspgSymKind::GSymType   => true,
        LspgSymKind::GSymModule => true,
        _ => false,
    }
}

// Check if a kind represents a value-like entity
fn lspg_kind_is_value_like(kind: LspgSymKind) -> bool {
    match kind {
        LspgSymKind::GSymVariable => true,
        LspgSymKind::GSymConstant => true,
        LspgSymKind::GSymParam    => true,
        LspgSymKind::GSymField    => true,
        _ => false,
    }
}

// ============================================================================
// Section 20: BATCH OPERATIONS
// ============================================================================

// Register a definition and immediately create a self-reference (RefDefinition).
// Returns the definition id.
fn lspg_register_def_with_self_ref(ctx: &! LspgContext, kind: LspgSymKind, name_hash: i64, loc: LspgLocation, scope: i64) -> i64 with Mut, Div, Panic {
    let def_id = lspg_add_definition(ctx, kind, name_hash, loc, scope)
    if def_id == LSPG_INVALID {
        return LSPG_INVALID
    }
    let ref_id = lspg_add_reference(ctx, def_id, LspgRefKind::RefDefinition, loc)
    let _ = ref_id
    def_id
}

// Register a definition, create a self-reference, and add a symbol entry.
// Returns the definition id.
fn lspg_register_full(ctx: &! LspgContext, kind: LspgSymKind, name_hash: i64, loc: LspgLocation, scope: i64) -> i64 with Mut, Div, Panic {
    let def_id = lspg_register_def_with_self_ref(ctx, kind, name_hash, loc, scope)
    if def_id == LSPG_INVALID {
        return LSPG_INVALID
    }
    let sym_id = lspg_add_symbol(ctx, name_hash, def_id, kind, loc)
    let _ = sym_id
    def_id
}

// Add a usage reference to an existing definition by name hash lookup.
// Returns the reference index, or LSPG_INVALID if the definition is not found.
fn lspg_add_usage_by_name(ctx: &! LspgContext, name_hash: i64, loc: LspgLocation) -> i64 with Mut, Div, Panic {
    let def_id = lspg_find_def_by_hash(ctx, name_hash)
    if def_id == LSPG_INVALID {
        return LSPG_INVALID
    }
    lspg_add_reference(ctx, def_id, LspgRefKind::RefUsage, loc)
}

// Add a write reference to an existing definition by name hash lookup.
fn lspg_add_write_by_name(ctx: &! LspgContext, name_hash: i64, loc: LspgLocation) -> i64 with Mut, Div, Panic {
    let def_id = lspg_find_def_by_hash(ctx, name_hash)
    if def_id == LSPG_INVALID {
        return LSPG_INVALID
    }
    lspg_add_reference(ctx, def_id, LspgRefKind::RefWrite, loc)
}

// Add a read reference to an existing definition by name hash lookup.
fn lspg_add_read_by_name(ctx: &! LspgContext, name_hash: i64, loc: LspgLocation) -> i64 with Mut, Div, Panic {
    let def_id = lspg_find_def_by_hash(ctx, name_hash)
    if def_id == LSPG_INVALID {
        return LSPG_INVALID
    }
    lspg_add_reference(ctx, def_id, LspgRefKind::RefRead, loc)
}

// Add an import reference to an existing definition by name hash lookup.
fn lspg_add_import_ref(ctx: &! LspgContext, name_hash: i64, loc: LspgLocation) -> i64 with Mut, Div, Panic {
    let def_id = lspg_find_def_by_hash(ctx, name_hash)
    if def_id == LSPG_INVALID {
        return LSPG_INVALID
    }
    lspg_add_reference(ctx, def_id, LspgRefKind::RefImport, loc)
}

// ============================================================================
// Section 21: CROSS-FILE NAVIGATION HELPERS
// ============================================================================

// Given a def_id, collect all references across all files
fn lspg_collect_cross_file_refs(ctx: &! LspgContext, def_id: i64) with Mut, Div, Panic {
    lspg_clear_results(ctx)
    var i: i64 = 0
    while i < ctx.ref_count {
        if ctx.refs[i as usize].def_id == def_id {
            let added = lspg_add_result(ctx, ctx.refs[i as usize].loc)
            if added == false {
                return
            }
        }
        i = i + 1
    }
}

// Count how many files reference a given def_id
fn lspg_count_files_referencing(ctx: &LspgContext, def_id: i64) -> i64 with Mut, Div, Panic {
    var file_ids: [i64; 256] = [0 - 1; 256]
    var file_count: i64 = 0
    var i: i64 = 0
    while i < ctx.ref_count {
        if ctx.refs[i as usize].def_id == def_id {
            let fid = ctx.refs[i as usize].loc.file_id
            var already: bool = false
            var j: i64 = 0
            while j < file_count {
                if file_ids[j as usize] == fid {
                    already = true
                }
                j = j + 1
            }
            if already == false && file_count < 256 {
                file_ids[file_count as usize] = fid
                file_count = file_count + 1
            }
        }
        i = i + 1
    }
    file_count
}

// ============================================================================
// Section 22: CONTEXT STATISTICS
// ============================================================================

// Return overall statistics about the context
fn lspg_total_entries(ctx: &LspgContext) -> i64 {
    ctx.def_count + ctx.ref_count + ctx.sym_count
}

// Ratio of refs to defs (as integer percentage) -- a rough complexity metric
fn lspg_ref_to_def_ratio(ctx: &LspgContext) -> i64 with Div, Panic {
    if ctx.def_count == 0 {
        return 0
    }
    (ctx.ref_count * 100) / ctx.def_count
}

// Check if the context has any data at all
fn lspg_context_is_empty(ctx: &LspgContext) -> bool {
    ctx.def_count == 0 && ctx.ref_count == 0 && ctx.sym_count == 0
}

// Check if the context is at capacity for definitions
fn lspg_defs_at_capacity(ctx: &LspgContext) -> bool {
    ctx.def_count >= LSPG_MAX_DEFS
}

// Check if the context is at capacity for references
fn lspg_refs_at_capacity(ctx: &LspgContext) -> bool {
    ctx.ref_count >= LSPG_MAX_REFS
}

// ============================================================================
// Section 23: CLEANUP AND RESET
// ============================================================================

// Reset the entire context to empty state
fn lspg_reset(ctx: &! LspgContext) with Mut {
    ctx.def_count = 0
    ctx.ref_count = 0
    ctx.sym_count = 0
    ctx.results.count = 0
    ctx.current_file_id = 0
    ctx.sym_bridge_count = 0
}

// Reset only the symbol table (useful when rebuilding)
fn lspg_reset_symbols(ctx: &! LspgContext) with Mut {
    ctx.sym_count = 0
}

// Reset only the result list
fn lspg_reset_results(ctx: &! LspgContext) with Mut {
    ctx.results.count = 0
}

// ============================================================================
// Section 24: RANGE QUERY HELPERS
// ============================================================================

// Find all definitions on a given line.  Returns count of matches
// placed in the result list.
fn lspg_find_defs_on_line(ctx: &! LspgContext, file_id: i64, line: i64) -> i64 with Mut, Div, Panic {
    lspg_clear_results(ctx)
    var i: i64 = 0
    while i < ctx.def_count {
        let d = &ctx.defs[i as usize]
        if d.loc.file_id == file_id && d.loc.line <= line && d.loc.end_line >= line {
            let added = lspg_add_result(ctx, d.loc)
            if added == false {
                return ctx.results.count
            }
        }
        i = i + 1
    }
    ctx.results.count
}

// Find all references on a given line.  Returns count of matches.
fn lspg_find_refs_on_line(ctx: &! LspgContext, file_id: i64, line: i64) -> i64 with Mut, Div, Panic {
    lspg_clear_results(ctx)
    var i: i64 = 0
    while i < ctx.ref_count {
        let r = &ctx.refs[i as usize]
        if r.loc.file_id == file_id && r.loc.line <= line && r.loc.end_line >= line {
            let added = lspg_add_result(ctx, r.loc)
            if added == false {
                return ctx.results.count
            }
        }
        i = i + 1
    }
    ctx.results.count
}

// Find definitions within a range [start_line, end_line].  Returns count.
fn lspg_find_defs_in_range(ctx: &! LspgContext, file_id: i64, start_line: i64, end_line: i64) -> i64 with Mut, Div, Panic {
    lspg_clear_results(ctx)
    var i: i64 = 0
    while i < ctx.def_count {
        let d = &ctx.defs[i as usize]
        if d.loc.file_id == file_id && d.loc.line >= start_line && d.loc.line <= end_line {
            let added = lspg_add_result(ctx, d.loc)
            if added == false {
                return ctx.results.count
            }
        }
        i = i + 1
    }
    ctx.results.count
}

// ============================================================================
// Section 25: DEFINITION ORDERING AND SORTING
// ============================================================================

// Check if definitions are in source order (by line number within a file)
fn lspg_defs_in_source_order(ctx: &LspgContext, file_id: i64) -> bool with Mut, Div, Panic {
    var prev_line: i64 = 0 - 1
    var i: i64 = 0
    while i < ctx.def_count {
        let d = &ctx.defs[i as usize]
        if d.loc.file_id == file_id {
            if d.loc.line < prev_line {
                return false
            }
            prev_line = d.loc.line
        }
        i = i + 1
    }
    true
}

// Find the Nth definition in a file (0-indexed).  Returns def_id or LSPG_INVALID.
fn lspg_nth_def_in_file(ctx: &LspgContext, file_id: i64, n: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.def_count {
        if ctx.defs[i as usize].loc.file_id == file_id {
            if count == n {
                return i
            }
            count = count + 1
        }
        i = i + 1
    }
    LSPG_INVALID
}

// Count definitions in a specific file
fn lspg_count_defs_in_file(ctx: &LspgContext, file_id: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    var count: i64 = 0
    while i < ctx.def_count {
        if ctx.defs[i as usize].loc.file_id == file_id {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Count references in a specific file
fn lspg_count_refs_in_file(ctx: &LspgContext, file_id: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    var count: i64 = 0
    while i < ctx.ref_count {
        if ctx.refs[i as usize].loc.file_id == file_id {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// ============================================================================
// Section 26: DEFINITION COUNT (ADDITIONAL FILE QUERY)
// ============================================================================

// Count definitions in a specific file (public accessor)
fn lspg_count_defs_in_file(ctx: &LspgContext, file_id: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    var count: i64 = 0
    while i < ctx.def_count {
        if ctx.defs[i as usize].loc.file_id == file_id {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// ============================================================================
// Section 27: MODULE-GRAPH CROSS-FILE NAVIGATION
// ============================================================================
//
// The legacy goto-definition path (lspg_handle_definition) performs a flat
// linear scan of the LspgContext definition arena.  This works well for
// same-file symbols and for cross-file symbols whose definitions have been
// pre-registered into the shared context by the indexer.  It FAILS when a
// symbol is encountered only as an import reference — the cursor sits on an
// identifier that was brought in via "use module::symbol", but the definition
// lives in another file's context that was never merged into the current one.
//
// The functions in this section replace that fallback with a two-level lookup:
//
//   Level 1 (fast path)  — unchanged: linear scan of ctx.defs[]
//   Level 2 (new path)   — mod_graph_resolve_import on the qualified or
//                          unqualified name extracted from the reference,
//                          followed by a sym_id → def_id bridge lookup.
//
// Bridge registration:
//   When the indexer builds the LspgContext it should call
//   lspg_register_def_with_sym_id() instead of lspg_add_definition() so that
//   the resolver symbol_id is recorded in ctx.sym_bridge[].  The module-graph
//   fallback then does:
//
//     mod_graph_resolve_import(graph, name, name_len)
//       → (module_id, export_idx)
//     graph.exports[export_idx].symbol_id
//       → sym_id
//     lspg_find_def_by_sym_id(ctx, sym_id)
//       → def_id
//     lspg_def_location(ctx, def_id)
//       → LspgLocation (possibly in a different file_id)
//
// Name encoding:
//   The module graph uses [i8; 64] byte arrays with explicit lengths.
//   The LspgContext uses i64 name_hashes (intern IDs).  The transport
//   boundary must extract the original name text before calling the
//   module-graph functions; the bridge only needs the sym_id once
//   resolution succeeds.
// ============================================================================

// Register a definition AND record its resolver symbol_id in the bridge table.
// Returns the def_id, or LSPG_INVALID on overflow.
fn lspg_register_def_with_sym_id(
    ctx: &! LspgContext,
    kind: LspgSymKind,
    name_hash: i64,
    loc: LspgLocation,
    scope: i64,
    sym_id: i64
) -> i64 with Mut, Div, Panic {
    let def_id = lspg_add_definition(ctx, kind, name_hash, loc, scope)
    if def_id == LSPG_INVALID {
        return LSPG_INVALID
    }
    // Record the sym_id → def_id mapping in the bridge
    if ctx.sym_bridge_count < LSPG_MAX_SYM_BRIDGE {
        let idx = ctx.sym_bridge_count
        ctx.sym_bridge[idx as usize] = LspgSymBridge {
            sym_id: sym_id,
            def_id: def_id,
        }
        ctx.sym_bridge_count = idx + 1
    }
    def_id
}

// Find the def_id for a given resolver symbol_id via the bridge table.
// Returns LSPG_INVALID if no mapping was registered.
fn lspg_find_def_by_sym_id(ctx: &LspgContext, sym_id: i64) -> i64 with Div, Panic {
    var i: i64 = 0
    while i < ctx.sym_bridge_count {
        if ctx.sym_bridge[i as usize].sym_id == sym_id {
            return ctx.sym_bridge[i as usize].def_id
        }
        i = i + 1
    }
    LSPG_INVALID
}

// Query how many sym_id → def_id mappings are registered in the bridge.
fn lspg_sym_bridge_count(ctx: &LspgContext) -> i64 {
    ctx.sym_bridge_count
}

// Core of the module-graph fallback: given a qualified or unqualified symbol
// name (as a [i8; 64] byte array with explicit length) and a ModuleGraph,
// resolve it to an LspgLocation.  Returns lspg_location_zero() on failure.
//
// This function is called by lspg_handle_definition_via_module_graph when
// the cheap flat-scan fails to find a definition.
fn lspg_resolve_via_module_graph(
    ctx: &LspgContext,
    graph: ModuleGraph,
    name: [i8; 64],
    name_len: i64
) -> LspgLocation with Mut, Div, Panic {
    // Use the 2-pass module resolver's hierarchical namespace lookup.
    // mod_graph_resolve_import handles both qualified ("mod::sym") and
    // unqualified names by searching all exported symbols.
    let result = mod_graph_resolve_import(graph, name, name_len)
    let module_id = result.0
    let export_idx = result.1

    if module_id < 0 || export_idx < 0 {
        return lspg_location_zero()
    }

    // Retrieve the resolver symbol_id from the export table
    if export_idx >= graph.export_count {
        return lspg_location_zero()
    }
    let sym_id = graph.exports[export_idx as usize].symbol_id

    if sym_id < 0 {
        return lspg_location_zero()
    }

    // Bridge: map the resolver symbol_id back to an LspgContext def_id
    let def_id = lspg_find_def_by_sym_id(ctx, sym_id)
    if def_id == LSPG_INVALID {
        return lspg_location_zero()
    }

    lspg_def_location(ctx, def_id)
}

// Extended goto-definition handler that uses the module resolver's
// hierarchical namespace as a fallback for imported cross-file symbols.
//
// Behaviour:
//   1. Try the legacy flat scan (lspg_handle_definition).
//   2. If that succeeds, return immediately.
//   3. Otherwise, call lspg_resolve_via_module_graph with the provided
//      name bytes (extracted by the caller from the cursor's token).
//   4. If the module graph returns a valid location, push it to the result
//      list and return true.
//   5. Return false only if both paths fail.
//
// The caller is responsible for supplying the raw name bytes from the
// StringInterner — this function does not re-hash the name.
fn lspg_handle_definition_via_module_graph(
    ctx: &! LspgContext,
    line: i64,
    col: i64,
    graph: ModuleGraph,
    name: [i8; 64],
    name_len: i64
) -> bool with Mut, Div, Panic {
    // Level 1: fast path — legacy flat scan
    let fast_ok = lspg_handle_definition(ctx, line, col)
    if fast_ok {
        return true
    }

    // Level 2: module-graph hierarchical namespace lookup
    lspg_clear_results(ctx)
    let loc = lspg_resolve_via_module_graph(ctx, graph, name, name_len)
    if lspg_location_is_zero(&loc) {
        return false
    }
    let added = lspg_add_result(ctx, loc)
    added
}

// Cross-file variant: sets the active file before running the module-graph
// aware goto-def, then restores the saved file context.
fn lspg_handle_definition_cross_file_mg(
    ctx: &! LspgContext,
    file_id: i64,
    line: i64,
    col: i64,
    graph: ModuleGraph,
    name: [i8; 64],
    name_len: i64
) -> bool with Mut, Div, Panic {
    let saved_file = ctx.current_file_id
    lspg_set_current_file(ctx, file_id)
    let result = lspg_handle_definition_via_module_graph(ctx, line, col, graph, name, name_len)
    lspg_set_current_file(ctx, saved_file)
    result
}

// ============================================================================
// Section 27 TESTS
// ============================================================================

// T71: bridge registration and lookup
fn test_lspg_sym_bridge_register_inner(ctx: &! LspgContext) -> bool with Mut, Div, Panic {
    let loc = lspg_location_new(2, 5, 0, 5, 10)
    // Register a def with sym_id = 42
    let def_id = lspg_register_def_with_sym_id(ctx, LspgSymKind::GSymFunction, 9001, loc, 0, 42)
    // Bridge lookup must return that def_id
    let found = lspg_find_def_by_sym_id(ctx, 42)
    def_id >= 0 && found == def_id
}
fn test_lspg_sym_bridge_register() -> bool with Mut, Div, Panic {
    var ctx = lspg_context_new()
    test_lspg_sym_bridge_register_inner(&! ctx)
}

// T72: bridge miss returns LSPG_INVALID
fn test_lspg_sym_bridge_miss_inner(ctx: &! LspgContext) -> bool with Div, Panic {
    lspg_find_def_by_sym_id(ctx, 999) == LSPG_INVALID
}
fn test_lspg_sym_bridge_miss() -> bool with Div, Panic {
    var ctx = lspg_context_new()
    test_lspg_sym_bridge_miss_inner(&! ctx)
}

// T73: module-graph goto-def resolves an imported cross-file symbol
// Setup: a ModuleGraph with one module "mylib" exporting "compute" (sym_id=7)
//        at file_id=2, line 3.  The LspgContext knows the definition via bridge.
//        The cursor is NOT on a registered reference — flat scan will fail.
//        The module-graph path must find it.
fn test_lspg_module_graph_goto_def_inner(ctx: &! LspgContext) -> bool with Mut, Div, Panic {
    // Register the definition in file 2, line 3, sym_id = 7
    let def_loc = lspg_location_new(2, 3, 0, 3, 10)
    let def_id = lspg_register_def_with_sym_id(ctx, LspgSymKind::GSymFunction, 9999, def_loc, 0, 7)
    let _ = def_id

    // Build a minimal ModuleGraph: one module "mylib" exporting "compute"
    // Module name bytes: 'm'=109 'y'=121 'l'=108 'i'=105 'b'=98
    var mod_name: [i8; 64] = [0; 64]
    mod_name[0] = 109  // m
    mod_name[1] = 121  // y
    mod_name[2] = 108  // l
    mod_name[3] = 105  // i
    mod_name[4] = 98   // b
    var mod_path: [i8; 256] = [0; 256]
    mod_path[0] = 109

    let graph_pair = mod_graph_add_module(mod_graph_new(), mod_name, 5, mod_path, 1, 0 - 1, true)
    var graph = graph_pair.0
    let mod_id = graph_pair.1

    // Export name bytes: 'c'=99 'o'=111 'm'=109 'p'=112 'u'=117 't'=116 'e'=101
    var exp_name: [i8; 64] = [0; 64]
    exp_name[0] = 99   // c
    exp_name[1] = 111  // o
    exp_name[2] = 109  // m
    exp_name[3] = 112  // p
    exp_name[4] = 117  // u
    exp_name[5] = 116  // t
    exp_name[6] = 101  // e
    graph = mod_graph_add_export(graph, exp_name, 7, MOD_KIND_FN, 7, mod_id, true)

    // Qualified lookup name: "mylib::compute"
    // m=109 y=121 l=108 i=105 b=98 ::= 58 58 c=99 o=111 m=109 p=112 u=117 t=116 e=101
    var qname: [i8; 64] = [0; 64]
    qname[0]  = 109  // m
    qname[1]  = 121  // y
    qname[2]  = 108  // l
    qname[3]  = 105  // i
    qname[4]  = 98   // b
    qname[5]  = 58   // :
    qname[6]  = 58   // :
    qname[7]  = 99   // c
    qname[8]  = 111  // o
    qname[9]  = 109  // m
    qname[10] = 112  // p
    qname[11] = 117  // u
    qname[12] = 116  // t
    qname[13] = 101  // e

    // Cursor is at a position with no reference registered → flat scan fails
    lspg_set_current_file(ctx, 1)
    let ok = lspg_handle_definition_via_module_graph(ctx, 20, 5, graph, qname, 14)
    let count = lspg_result_count(ctx)
    let got = lspg_result_at(ctx, 0)
    ok && count == 1 && lspg_location_eq(&got, &def_loc)
}
fn test_lspg_module_graph_goto_def() -> bool with Mut, Div, Panic {
    var ctx = lspg_context_new()
    test_lspg_module_graph_goto_def_inner(&! ctx)
}

// T74: module-graph path returns false when symbol not in graph
fn test_lspg_module_graph_miss_inner(ctx: &! LspgContext) -> bool with Mut, Div, Panic {
    // Empty graph — nothing to resolve
    let graph = mod_graph_new()
    var name: [i8; 64] = [0; 64]
    name[0] = 120  // x
    lspg_set_current_file(ctx, 1)
    let ok = lspg_handle_definition_via_module_graph(ctx, 5, 3, graph, name, 1)
    ok == false && lspg_result_count(ctx) == 0
}
fn test_lspg_module_graph_miss() -> bool with Mut, Div, Panic {
    var ctx = lspg_context_new()
    test_lspg_module_graph_miss_inner(&! ctx)
}

// T75: legacy flat-scan still works via the new entry point
fn test_lspg_module_graph_fast_path_inner(ctx: &! LspgContext) -> bool with Mut, Div, Panic {
    lspg_set_current_file(ctx, 1)
    // Register a def AND a reference in the same file
    let loc_d = lspg_location_new(1, 2, 0, 2, 8)
    let def_id = lspg_add_definition(ctx, LspgSymKind::GSymFunction, 1234, loc_d, 0)
    let loc_r = lspg_location_new(1, 10, 3, 10, 9)
    let ref_id = lspg_add_reference(ctx, def_id, LspgRefKind::RefUsage, loc_r)
    let _ = ref_id
    // Use an empty graph — fast path must succeed without consulting it
    let graph = mod_graph_new()
    var name: [i8; 64] = [0; 64]
    let ok = lspg_handle_definition_via_module_graph(ctx, 10, 5, graph, name, 0)
    let count = lspg_result_count(ctx)
    let got = lspg_result_at(ctx, 0)
    ok && count == 1 && lspg_location_eq(&got, &loc_d)
}
fn test_lspg_module_graph_fast_path() -> bool with Mut, Div, Panic {
    var ctx = lspg_context_new()
    test_lspg_module_graph_fast_path_inner(&! ctx)
}

// ############################################################################
//
//  T E S T S
//
// ############################################################################
//
// 75 tests organized in 9 categories:
//   1. Location      (T01-T08)   -- create, eq, contains, overlap, span
//   2. Definitions   (T09-T18)   -- add, query, find at cursor, scope
//   3. References    (T19-T28)   -- add, query, find at cursor, counts
//   4. Symbol table  (T29-T36)   -- add, lookup, build def map, ref index
//   5. Goto-def      (T37-T46)   -- resolve at cursor, handle request
//   6. Find-refs     (T47-T56)   -- collect refs, handle request, multi-ref
//   7. Result list   (T57-T62)   -- add, count, clear, dedup, at index
//   8. Integration   (T63-T70)   -- full pipeline, batch, cross-file, stats
//   9. Module-graph  (T71-T75)   -- bridge table, mod-graph goto-def, fast path
//

// -------------------------------------------------------
// Location tests (T01-T08)
// -------------------------------------------------------

// T01: create a location and verify fields
fn test_lspg_location_new() -> bool {
    let loc = lspg_location_new(1, 10, 5, 10, 15)
    loc.file_id == 1 && loc.line == 10 && loc.col == 5
        && loc.end_line == 10 && loc.end_col == 15
}

// T02: location equality -- same values
fn test_lspg_location_eq_same() -> bool {
    let a = lspg_location_new(1, 10, 5, 10, 15)
    let b = lspg_location_new(1, 10, 5, 10, 15)
    lspg_location_eq(&a, &b)
}

// T03: location equality -- different values
fn test_lspg_location_eq_diff() -> bool {
    let a = lspg_location_new(1, 10, 5, 10, 15)
    let b = lspg_location_new(2, 10, 5, 10, 15)
    lspg_location_eq(&a, &b) == false
}

// T04: location contains -- cursor inside single-line span
fn test_lspg_location_contains_inside() -> bool {
    let loc = lspg_location_new(1, 5, 3, 5, 12)
    lspg_location_contains(&loc, 5, 7)
}

// T05: location contains -- cursor outside span
fn test_lspg_location_contains_outside() -> bool {
    let loc = lspg_location_new(1, 5, 3, 5, 12)
    lspg_location_contains(&loc, 6, 1) == false
}

// T06: location contains -- cursor at start boundary
fn test_lspg_location_contains_start() -> bool {
    let loc = lspg_location_new(1, 5, 3, 5, 12)
    lspg_location_contains(&loc, 5, 3)
}

// T07: location contains -- multi-line span
fn test_lspg_location_contains_multiline() -> bool {
    let loc = lspg_location_new(1, 5, 3, 8, 10)
    // Middle line should be contained
    let mid = lspg_location_contains(&loc, 6, 0)
    // Start line, at col
    let start = lspg_location_contains(&loc, 5, 5)
    // End line, within col
    let end = lspg_location_contains(&loc, 8, 5)
    mid && start && end
}

// T08: location span -- single line returns width
fn test_lspg_location_span() -> bool {
    let loc = lspg_location_new(1, 5, 3, 5, 12)
    let span = lspg_location_span(&loc)
    span == 10  // 12 - 3 + 1
}

// -------------------------------------------------------
// Definition tests (T09-T18)
// -------------------------------------------------------

// T09: add a definition and verify count
fn test_lspg_add_def_inner(ctx: &! LspgContext) -> bool with Mut, Div, Panic {
    let loc = lspg_location_new(1, 1, 0, 1, 5)
    let id = lspg_add_definition(ctx, LspgSymKind::GSymFunction, 100, loc, 0)
    id == 0 && lspg_def_count(ctx) == 1
}
fn test_lspg_add_def() -> bool with Mut, Div, Panic {
    var ctx = lspg_context_new()
    test_lspg_add_def_inner(&! ctx)
}

// T10: add multiple definitions
fn test_lspg_add_multi_def_inner(ctx: &! LspgContext) -> bool with Mut, Div, Panic {
    let loc1 = lspg_location_new(1, 1, 0, 1, 5)
    let loc2 = lspg_location_new(1, 3, 0, 3, 8)
    let loc3 = lspg_location_new(1, 5, 0, 5, 3)
    let id1 = lspg_add_definition(ctx, LspgSymKind::GSymFunction, 100, loc1, 0)
    let id2 = lspg_add_definition(ctx, LspgSymKind::GSymVariable, 101, loc2, 0)
    let id3 = lspg_add_definition(ctx, LspgSymKind::GSymType, 102, loc3, 0)
    id1 == 0 && id2 == 1 && id3 == 2 && lspg_def_count(ctx) == 3
}
fn test_lspg_add_multi_def() -> bool with Mut, Div, Panic {
    var ctx = lspg_context_new()
    test_lspg_add_multi_def_inner(&! ctx)
}

// T11: query definition location
fn test_lspg_def_location_inner(ctx: &! LspgContext) -> bool with Mut, Div, Panic {
    let loc = lspg_location_new(2, 10, 3, 10, 15)
    let id = lspg_add_definition(ctx, LspgSymKind::GSymVariable, 200, loc, 0)
    let got = lspg_def_location(ctx, id)
    lspg_location_eq(&got, &loc)
}
fn test_lspg_def_location() -> bool with Mut, Div, Panic {
