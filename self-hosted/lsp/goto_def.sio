// T13: query definition kind
fn test_lspg_def_kind_inner(ctx: &! LspgContext) -> bool with Mut, Div, Panic {
    let loc = lspg_location_new(1, 1, 0, 1, 5)
    let id = lspg_add_definition(ctx, LspgSymKind::GSymModule, 300, loc, 0)
