// T68: context statistics
fn test_lspg_stats_inner(ctx: &! LspgContext) -> bool with Mut, Div, Panic {
    let loc_d = lspg_location_new(1, 1, 0, 1, 5)
    let def_id = lspg_add_definition(ctx, LspgSymKind::GSymFunction, 100, loc_d, 0)
    let loc_r = lspg_location_new(1, 5, 0, 5, 5)
    let ref_id = lspg_add_reference(ctx, def_id, LspgRefKind::RefUsage, loc_r)
    let _ = ref_id
    let sym_id = lspg_add_symbol(ctx, 100, def_id, LspgSymKind::GSymFunction, loc_d)
    let _ = sym_id
    let total = lspg_total_entries(ctx)
    let empty = lspg_context_is_empty(ctx)
    total == 3 && empty == false
}
fn test_lspg_stats() -> bool with Mut, Div, Panic {
    var ctx = lspg_context_new()
    test_lspg_stats_inner(&! ctx)
}

// T69: reset clears everything
fn test_lspg_reset_inner(ctx: &! LspgContext) -> bool with Mut, Div, Panic {
    let loc_d = lspg_location_new(1, 1, 0, 1, 5)
    let def_id = lspg_add_definition(ctx, LspgSymKind::GSymFunction, 100, loc_d, 0)
    let loc_r = lspg_location_new(1, 5, 0, 5, 5)
    let ref_id = lspg_add_reference(ctx, def_id, LspgRefKind::RefUsage, loc_r)
    let _ = ref_id
    lspg_reset(ctx)
    lspg_context_is_empty(ctx) && lspg_def_count(ctx) == 0
        && lspg_ref_count(ctx) == 0 && lspg_sym_count(ctx) == 0
}
fn test_lspg_reset() -> bool with Mut, Div, Panic {
    var ctx = lspg_context_new()
    test_lspg_reset_inner(&! ctx)
}

// T70: shadowing detection
fn test_lspg_shadowing_inner(ctx: &! LspgContext) -> bool with Mut, Div, Panic {
    let loc1 = lspg_location_new(1, 1, 0, 1, 5)
    let loc2 = lspg_location_new(1, 5, 0, 5, 5)
    let d1 = lspg_add_definition(ctx, LspgSymKind::GSymVariable, 900, loc1, 0)
    let d2 = lspg_add_definition(ctx, LspgSymKind::GSymVariable, 900, loc2, 1)
    let is_shadow_d1 = lspg_is_shadowing(ctx, d1)
    let is_shadow_d2 = lspg_is_shadowing(ctx, d2)
    // d1 is at depth 0, d2 at depth 1 with same name -- d2 shadows d1
    is_shadow_d1 == false && is_shadow_d2
}
fn test_lspg_shadowing() -> bool with Mut, Div, Panic {
    var ctx = lspg_context_new()
    test_lspg_shadowing_inner(&! ctx)
}

// ============================================================================
// Section 28: TEST RUNNER
// ============================================================================

fn lspg_run_all_tests() -> i64 with Mut, Div, Panic {
    var passed: i64 = 0
    var total: i64 = 0

    // ---- Location tests (T01-T08) ----
    total = total + 1
    if test_lspg_location_new() { passed = passed + 1 }

    total = total + 1
    if test_lspg_location_eq_same() { passed = passed + 1 }

    total = total + 1
    if test_lspg_location_eq_diff() { passed = passed + 1 }

    total = total + 1
    if test_lspg_location_contains_inside() { passed = passed + 1 }

    total = total + 1
