    lspd_add(&! a, LSPD_ERROR, 1, "s", "e1", 1, 0, 1, 1)
    lspd_add(&! a, LSPD_ERROR, 2, "s", "e2", 2, 0, 2, 1)
    lspd_add(&! b, LSPD_WARN,  3, "s", "w1", 3, 0, 3, 1)
