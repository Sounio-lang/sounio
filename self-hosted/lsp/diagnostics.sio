    lspd_range_is_zero(&r) == false
}

// T66: lspd_count returns buffer count
fn test_lspd_count() -> bool with Mut, Div, Panic {
    var b = lspd_buffer_new(1)
    lspd_add(&! b, LSPD_ERROR, 1, "s", "e", 1, 0, 1, 1)
    lspd_add(&! b, LSPD_WARN,  2, "s", "w", 2, 0, 2, 1)
    lspd_count(&b) == 2
}

// T67: lspd_diag_at returns correct diag
fn test_lspd_diag_at() -> bool with Mut, Div, Panic {
    var b = lspd_buffer_new(1)
    lspd_add(&! b, LSPD_ERROR, 42, "src", "msg", 5, 3, 5, 8)
    let d = lspd_diag_at(&b, 0)
    d.severity == LSPD_ERROR && d.code == 42 && str_eq(d.message, "msg")
}

// T68: lspd_diag_at out-of-bounds returns zero
fn test_lspd_diag_at_oob() -> bool with Mut, Div, Panic {
    var b = lspd_buffer_new(1)
    lspd_add(&! b, LSPD_ERROR, 1, "s", "e", 1, 0, 1, 1)
    let d = lspd_diag_at(&b, 99)
    d.severity == LSPD_INFO && d.code == 0
}

// T69: lspd_file_id returns file_id
fn test_lspd_file_id() -> bool {
    let b = lspd_buffer_new(99)
    lspd_file_id(&b) == 99
}

// T70: full pipeline — add, sort, filter, merge, summary
fn test_lspd_full_pipeline() -> bool with Mut, Div, Panic {
    var b1 = lspd_buffer_new(1)
    var b2 = lspd_buffer_new(1)
    lspd_add(&! b1, LSPD_ERROR, 1, "souc", "type error", 10, 0, 10, 5)
    lspd_add(&! b1, LSPD_WARN,  2, "souc", "unused",     3,  0, 3,  3)
    lspd_add(&! b2, LSPD_HINT,  3, "lint", "consider",   7,  0, 7,  4)
    let merged = lspd_merge(&b1, &b2)
    var sorted = lspd_merge(&b1, &b2)
    lspd_sort_by_line(&! sorted)
    let s = lspd_summary(&merged)
    let ok = s.error_count == 1 && s.warn_count == 1 && s.hint_count == 1
    let is_sorted = lspd_is_sorted(&sorted)
    ok && is_sorted && merged.count == 3
}

// ============================================================================
// Section 16: TEST RUNNER
// ============================================================================

fn lspd_run_all_tests() -> i64 with Mut, Div, Panic {
    var passed: i64 = 0
    var failed: i64 = 0

    if test_lspd_buffer_new()              { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_add_count()               { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_add_severity()            { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_add_code()                { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_add_source()              { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_add_message()             { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_add_range_start()         { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_add_range_end()           { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_add_multiple()            { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_summary()                 { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_summary_total()           { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_filter_severity()         { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_filter_max_count()        { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_filter_source()           { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_filter_file_id()          { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_sort_by_line()            { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_sort_already_sorted()     { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_sort_single()             { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_is_sorted_false()         { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_severity_str_error()      { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_severity_str_warning()    { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_severity_str_info()       { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_severity_str_hint()       { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_severity_str_unknown()    { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_severity_code_error()     { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_severity_code_warning()   { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_severity_code_invalid()   { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_severity_valid_true()     { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_severity_valid_false()    { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_format_diag_contains_msg(){ passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_format_diag_has_severity(){ passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_merge_count()             { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_merge_file_id()           { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_merge_empty_a()           { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspd_merge_empty_b()           { passed = passed + 1 } else { failed = failed + 1 }
