}

// T62: lspd_dedup removes exact duplicates
fn test_lspd_dedup() -> bool with Mut, Div, Panic {
    var b = lspd_buffer_new(1)
    lspd_add(&! b, LSPD_ERROR, 100, "s", "e", 3, 5, 3, 10)
    lspd_add(&! b, LSPD_ERROR, 100, "s", "e", 3, 5, 3, 10)
    lspd_add(&! b, LSPD_WARN,  200, "s", "w", 4, 0, 4, 5)
    let deduped = lspd_dedup(&b)
    deduped.count == 2
}

// T63: lspd_dedup keeps unique entries
fn test_lspd_dedup_unique() -> bool with Mut, Div, Panic {
    var b = lspd_buffer_new(1)
    lspd_add(&! b, LSPD_ERROR, 100, "s", "e1", 1, 0, 1, 5)
    lspd_add(&! b, LSPD_ERROR, 100, "s", "e2", 2, 0, 2, 5)
    let deduped = lspd_dedup(&b)
    deduped.count == 2
}

