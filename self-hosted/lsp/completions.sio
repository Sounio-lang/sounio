    list.count == 28
}
fn test_lsc_keyword_basic() -> bool with Mut, Div, Panic {
    var p = lsc_provider_new()
    test_lsc_keyword_basic_inner(&! p)
}

// T32: lsc_is_keyword works after registration
fn test_lsc_is_keyword_inner(p: &! LscProvider) -> bool with Mut, Div, Panic {
    let count = lsc_register_sounio_keywords(p)
    // Keywords were registered with IDs 1001..1028
    let ok_fn = lsc_is_keyword(p, 1001)
    let ok_let = lsc_is_keyword(p, 1002)
    let ok_var = lsc_is_keyword(p, 1003)
    let not_random = lsc_is_keyword(p, 9999) == false
    ok_fn && ok_let && ok_var && not_random
}
fn test_lsc_is_keyword() -> bool with Mut, Div, Panic {
    var p = lsc_provider_new()
    test_lsc_is_keyword_inner(&! p)
}

// T33: keyword completion items have correct kind
fn test_lsc_keyword_kind_inner(p: &! LscProvider) -> bool with Mut, Div, Panic {
    let count = lsc_register_sounio_keywords(p)

    let ctx = lsc_context_new()
    let list = lsc_complete_keyword(p, &ctx)
    // All items should have LSC_KIND_KEYWORD
    var all_ok = true
    var i: i64 = 0
    while i < list.count {
        if list.items[i as usize].kind != LSC_KIND_KEYWORD {
            all_ok = false
        }
        i = i + 1
    }
    all_ok
}
fn test_lsc_keyword_kind() -> bool with Mut, Div, Panic {
    var p = lsc_provider_new()
    test_lsc_keyword_kind_inner(&! p)
}

// T34: keyword completion with non-empty prefix filters by id heuristic
fn test_lsc_keyword_prefix_inner(p: &! LscProvider) -> bool with Mut, Div, Panic {
    // Manually push one keyword with name_id=0
    let r1 = lsc_push_keyword(p, 0)
    // And one with name_id=5
    let r2 = lsc_push_keyword(p, 5)

    var ctx = lsc_context_new()
    ctx.prefix[0] = 102  // 'f'
    ctx.prefix_len = 1

    let list = lsc_complete_keyword(p, &ctx)
    // Only name_id=5 (nonzero) should match
    list.count == 1
}
fn test_lsc_keyword_prefix() -> bool with Mut, Div, Panic {
    var p = lsc_provider_new()
    test_lsc_keyword_prefix_inner(&! p)
}

// T35: keyword priority is lower than variables
fn test_lsc_keyword_priority_inner(p: &! LscProvider) -> bool with Mut, Div, Panic {
    let count = lsc_register_sounio_keywords(p)

    let ctx = lsc_context_new()
    let kw_list = lsc_complete_keyword(p, &ctx)
    // Keyword priority should be 40 + score (score=1 for empty prefix) = 41
    let ok_prio = kw_list.items[0].sort_priority == 41
    ok_prio
}
fn test_lsc_keyword_priority() -> bool with Mut, Div, Panic {
    var p = lsc_provider_new()
    test_lsc_keyword_priority_inner(&! p)
}

