// T50: end-to-end: add items, complete, sort, filter
fn test_lsc_e2e_inner(p: &! LscProvider) -> bool with Mut, Div, Panic {
    let v1 = lsc_add_variable(p, 300, 0)
    let v2 = lsc_add_function(p, 301, 0)
    let v3 = lsc_add_type(p, 302, 0)
    let kw_count = lsc_register_sounio_keywords(p)

    let ctx = lsc_context_new()
    let raw = lsc_provide_completions(p, &ctx)
    let sorted = lsc_sort_completions(raw)
    let filtered = lsc_filter_completions(sorted, 10)

    let ok_count = filtered.count == 10
    let ok_incomplete = filtered.is_incomplete
    // First item should have highest priority
    let ok_sorted = filtered.items[0].sort_priority >= filtered.items[1].sort_priority
    ok_count && ok_incomplete && ok_sorted
}
fn test_lsc_e2e() -> bool with Mut, Div, Panic {
    var p = lsc_provider_new()
    test_lsc_e2e_inner(&! p)
}

