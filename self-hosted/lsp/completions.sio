// self-hosted::lsp::completions -- LSP completion provider for Sounio
//
// Context-aware code completions for identifiers, keywords, types, fields,
// methods, and modules.  All string data is represented as i64 intern IDs;
// the actual text lives in the StringInterner and is resolved at the
// transport boundary.
//
// The provider maintains a scope stack, field/method tables, and keyword
// registry.  Completion generation walks visible scope entries, scores
// them against the user's prefix, and emits LspCompletionItem values
// (from lsp/protocol.sio) into an LspCompletionList.
//
// Capacity:
//   - Scope entries:   2048
//   - Fields:          64 per struct
//   - Methods:         128
//   - Keywords:        64
//   - Modules:         64
//   - Completions:     256 (matches LspCompletionList capacity)

// ============================================================================
// Section 1: CONSTANTS
// ============================================================================

let LSC_MAX_SCOPE_ENTRIES: i64 = 2048
let LSC_MAX_COMPLETIONS: i64   = 256
let LSC_MAX_KEYWORDS: i64      = 64
let LSC_MAX_TYPES: i64         = 512
let LSC_MAX_FIELDS: i64        = 64
let LSC_MAX_METHODS: i64       = 128
let LSC_MAX_MODULES: i64       = 64
let LSC_INVALID: i64           = 0 - 1

// Completion kinds (matching LSP specification)
let LSC_KIND_TEXT: i64         = 1
let LSC_KIND_METHOD: i64       = 2
let LSC_KIND_FUNCTION: i64     = 3
let LSC_KIND_CONSTRUCTOR: i64  = 4
let LSC_KIND_FIELD: i64        = 5
let LSC_KIND_VARIABLE: i64     = 6
let LSC_KIND_CLASS: i64        = 7
let LSC_KIND_MODULE: i64       = 9
let LSC_KIND_PROPERTY: i64     = 10
let LSC_KIND_KEYWORD: i64      = 14
let LSC_KIND_SNIPPET: i64      = 15
let LSC_KIND_ENUM_MEMBER: i64  = 20
let LSC_KIND_STRUCT: i64       = 22
let LSC_KIND_TYPE_PARAM: i64   = 25

// ============================================================================
// Section 2: COMPLETION CONTEXT
// ============================================================================

enum LscTriggerKind {
    LscTriggerInvoked,
    LscTriggerChar,
    LscTriggerIncomplete,
}

struct LscCompletionContext {
    trigger_kind: LscTriggerKind,
    trigger_char: i64,
    line: i64,
    col: i64,
    in_function: bool,
    in_struct: bool,
    in_type_position: bool,
    after_dot: bool,
    after_colon_colon: bool,
    prefix: [i8; 256],
    prefix_len: i64,
}

// ============================================================================
// Section 3: SCOPE ENTRY TYPES
// ============================================================================

enum LscScopeKind {
    LscScopeVar,
    LscScopeFunc,
    LscScopeType,
    LscScopeModule,
    LscScopeField,
    LscScopeMethod,
    LscScopeEnum,
    LscScopeConst,
}

struct LscScopeEntry {
    name_id: i64,
    kind: LscScopeKind,
    type_id: i64,
    detail_id: i64,
    depth: i64,
    visible: bool,
}

struct LscFieldInfo {
    name_id: i64,
    type_id: i64,
    struct_id: i64,
}

struct LscMethodInfo {
    name_id: i64,
    type_id: i64,
    receiver_type: i64,
    param_count: i64,
}

// ============================================================================
// Section 4: PROVIDER STATE
// ============================================================================

struct LscProvider {
    scope_entries: [LscScopeEntry; 2048],
    scope_count: i64,
    fields: [LscFieldInfo; 64],
    field_count: i64,
    methods: [LscMethodInfo; 128],
    method_count: i64,
    keywords: [i64; 64],
    keyword_count: i64,
    current_depth: i64,
}

// ============================================================================
// Section 5: CONSTRUCTOR FUNCTIONS
// ============================================================================

fn lsc_empty_entry() -> LscScopeEntry {
    LscScopeEntry {
        name_id: 0,
        kind: LscScopeKind::LscScopeVar,
        type_id: 0,
        detail_id: 0,
        depth: 0,
        visible: false,
    }
}

fn lsc_empty_field() -> LscFieldInfo {
    LscFieldInfo {
        name_id: 0,
        type_id: 0,
        struct_id: 0,
    }
}

fn lsc_empty_method() -> LscMethodInfo {
    LscMethodInfo {
        name_id: 0,
        type_id: 0,
        receiver_type: 0,
        param_count: 0,
    }
}

fn lsc_provider_new() -> LscProvider {
    LscProvider {
        scope_entries: [lsc_empty_entry(); 2048],
        scope_count: 0,
        fields: [lsc_empty_field(); 64],
        field_count: 0,
        methods: [lsc_empty_method(); 128],
        method_count: 0,
        keywords: [0; 64],
        keyword_count: 0,
        current_depth: 0,
    }
}

fn lsc_context_new() -> LscCompletionContext {
    LscCompletionContext {
        trigger_kind: LscTriggerKind::LscTriggerInvoked,
        trigger_char: 0,
        line: 0,
        col: 0,
        in_function: false,
        in_struct: false,
        in_type_position: false,
        after_dot: false,
        after_colon_colon: false,
        prefix: [0; 256],
        prefix_len: 0,
    }
}

// ============================================================================
// Section 5b: CONTEXT BUILDER HELPERS
// ============================================================================

// Set the prefix on a completion context from a byte array and length.
fn lsc_context_set_prefix(ctx: LscCompletionContext, buf: [i8; 256], len: i64) -> LscCompletionContext with Mut, Div, Panic {
    var out = ctx
    var i: i64 = 0
    while i < len && i < 256 {
        out.prefix[i as usize] = buf[i as usize]
        i = i + 1
    }
    out.prefix_len = len
    out
}

// Create a context for dot-triggered completion.
fn lsc_context_dot(receiver_type: i64, line: i64, col: i64) -> LscCompletionContext {
    LscCompletionContext {
        trigger_kind: LscTriggerKind::LscTriggerChar,
        trigger_char: receiver_type,
        line: line,
        col: col,
        in_function: true,
        in_struct: false,
        in_type_position: false,
        after_dot: true,
        after_colon_colon: false,
        prefix: [0; 256],
        prefix_len: 0,
    }
}

// Create a context for path-triggered completion (::).
fn lsc_context_path(module_id: i64, line: i64, col: i64) -> LscCompletionContext {
    LscCompletionContext {
        trigger_kind: LscTriggerKind::LscTriggerChar,
        trigger_char: module_id,
        line: line,
        col: col,
        in_function: true,
        in_struct: false,
        in_type_position: false,
        after_dot: false,
        after_colon_colon: true,
        prefix: [0; 256],
        prefix_len: 0,
    }
}

// Create a context for type-position completion.
fn lsc_context_type_pos(line: i64, col: i64) -> LscCompletionContext {
    LscCompletionContext {
        trigger_kind: LscTriggerKind::LscTriggerInvoked,
        trigger_char: 0,
        line: line,
        col: col,
        in_function: true,
        in_struct: false,
        in_type_position: true,
        after_dot: false,
        after_colon_colon: false,
        prefix: [0; 256],
        prefix_len: 0,
    }
}

// ============================================================================
// Section 5c: PROVIDER QUERY HELPERS
// ============================================================================

// Look up a scope entry by name_id.  Returns the index if found, LSC_INVALID
// if not found.  Searches from most recent to oldest (inner-to-outer).
fn lsc_lookup_name(p: &LscProvider, name_id: i64) -> i64 with Mut, Div, Panic {
    var i = p.scope_count - 1
    while i >= 0 {
        let entry = p.scope_entries[i as usize]
        if entry.visible && entry.name_id == name_id {
            return i
        }
        i = i - 1
    }
    LSC_INVALID
}

// Count the number of visible entries in the provider.
fn lsc_visible_count(p: &LscProvider) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < p.scope_count {
        if p.scope_entries[i as usize].visible {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Count the number of fields for a given struct_id.
fn lsc_field_count_for(p: &LscProvider, struct_id: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < p.field_count {
        if p.fields[i as usize].struct_id == struct_id {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Count the number of methods for a given receiver type.
fn lsc_method_count_for(p: &LscProvider, receiver_type: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < p.method_count {
        if p.methods[i as usize].receiver_type == receiver_type {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Reset all scope entries to invisible (for testing scope management).
fn lsc_hide_all(p: &! LscProvider) -> i64 with Mut, Div, Panic {
    var hidden: i64 = 0
    var i: i64 = 0
    while i < p.scope_count {
        if p.scope_entries[i as usize].visible {
            p.scope_entries[i as usize].visible = false
            hidden = hidden + 1
        }
        i = i + 1
    }
    hidden
}

// Add an enum variant to the scope.
fn lsc_add_enum(p: &! LscProvider, name_id: i64, detail_id: i64) -> i64 with Mut, Div, Panic {
    if p.scope_count >= LSC_MAX_SCOPE_ENTRIES {
        return LSC_INVALID
    }
    let idx = p.scope_count
    p.scope_entries[idx as usize] = LscScopeEntry {
        name_id: name_id,
        kind: LscScopeKind::LscScopeEnum,
        type_id: 0,
        detail_id: detail_id,
        depth: p.current_depth,
        visible: true,
    }
    p.scope_count = p.scope_count + 1
    idx
}

// Add a constant to the scope.
fn lsc_add_const(p: &! LscProvider, name_id: i64, type_id: i64) -> i64 with Mut, Div, Panic {
    if p.scope_count >= LSC_MAX_SCOPE_ENTRIES {
        return LSC_INVALID
    }
    let idx = p.scope_count
    p.scope_entries[idx as usize] = LscScopeEntry {
        name_id: name_id,
        kind: LscScopeKind::LscScopeConst,
        type_id: type_id,
        detail_id: 0,
        depth: p.current_depth,
        visible: true,
    }
    p.scope_count = p.scope_count + 1
    idx
}

// ============================================================================
// Section 6: STRING MATCHING HELPERS
// ============================================================================

// Check if a character is an ASCII letter [A-Za-z]
fn lsc_is_letter(c: i8) -> bool {
    let cv = c as i64
    if cv >= 65 && cv <= 90 {
        return true
    }
    if cv >= 97 && cv <= 122 {
        return true
    }
    false
}

// Check if a character is an ASCII uppercase letter [A-Z]
fn lsc_is_upper(c: i8) -> bool {
    let cv = c as i64
    cv >= 65 && cv <= 90
}

// Convert an ASCII character to lowercase.
// If the character is uppercase [A-Z], returns the corresponding lowercase.
// Otherwise returns the character unchanged.
fn lsc_char_to_lower(c: i8) -> i8 {
    let cv = c as i64
    if cv >= 65 && cv <= 90 {
        return (cv + 32) as i8
    }
    c
}

// Case-insensitive prefix match.
// Returns true if the first prefix_len bytes of name (lowered) match
// the first prefix_len bytes of prefix (lowered).
fn lsc_name_matches_prefix(name: [i8; 256], name_len: i64, prefix: [i8; 256], prefix_len: i64) -> bool with Mut, Div, Panic {
    if prefix_len == 0 {
        return true
    }
    if name_len < prefix_len {
        return false
    }
    var i: i64 = 0
    while i < prefix_len {
        let nc = lsc_char_to_lower(name[i as usize])
        let pc = lsc_char_to_lower(prefix[i as usize])
        if nc != pc {
            return false
        }
        i = i + 1
    }
    true
}

// Fuzzy match score for a name against a prefix.
// Returns 0 for no match, higher values for better matches.
// Scoring:
//   - Exact prefix match: 100 + (prefix_len * 10)
//   - Case-sensitive prefix match: 100 + (prefix_len * 10) + 50
//   - Substring match: 50
//   - Camel-case initial match: 30
//   - No match: 0
fn lsc_name_score(name: [i8; 256], name_len: i64, prefix: [i8; 256], prefix_len: i64) -> i64 with Mut, Div, Panic {
    if prefix_len == 0 {
        return 1
    }
    if name_len < 1 {
        return 0
    }

    // Check case-sensitive exact prefix match first
    var exact_match = true
    if name_len >= prefix_len {
        var i: i64 = 0
        while i < prefix_len {
            if name[i as usize] != prefix[i as usize] {
                exact_match = false
                i = prefix_len
            }
            i = i + 1
        }
    } else {
        exact_match = false
    }

    if exact_match {
        // Bonus for exact length match (name == prefix)
        if name_len == prefix_len {
            return 200 + prefix_len * 10
        }
        return 150 + prefix_len * 10
    }

    // Check case-insensitive prefix match
    let ci_match = lsc_name_matches_prefix(name, name_len, prefix, prefix_len)
    if ci_match {
        return 100 + prefix_len * 10
    }

    // Check substring match: scan for prefix appearing anywhere in name
    var pos: i64 = 0
    while pos <= name_len - prefix_len {
        var sub_match = true
        var j: i64 = 0
        while j < prefix_len {
            let nc = lsc_char_to_lower(name[(pos + j) as usize])
            let pc = lsc_char_to_lower(prefix[j as usize])
            if nc != pc {
                sub_match = false
                j = prefix_len
            }
            j = j + 1
        }
        if sub_match {
            return 50
        }
        pos = pos + 1
    }

    // Check camel-case initial match: e.g. prefix "sp" matches "ScopeProvider"
    // by matching against the first letters of camel-case segments
    var camel_idx: i64 = 0
    var prefix_idx: i64 = 0
    while camel_idx < name_len && prefix_idx < prefix_len {
        if camel_idx == 0 || lsc_is_upper(name[camel_idx as usize]) {
            let nc = lsc_char_to_lower(name[camel_idx as usize])
            let pc = lsc_char_to_lower(prefix[prefix_idx as usize])
            if nc == pc {
                prefix_idx = prefix_idx + 1
            }
        }
        camel_idx = camel_idx + 1
    }
    if prefix_idx == prefix_len {
        return 30
    }

    0
}

// ============================================================================
// Section 7: SCOPE MANAGEMENT
// ============================================================================

// Add a variable to the provider scope.  Returns the index of the new entry,
// or LSC_INVALID if full.
fn lsc_add_variable(p: &! LscProvider, name_id: i64, type_id: i64) -> i64 with Mut, Div, Panic {
    if p.scope_count >= LSC_MAX_SCOPE_ENTRIES {
        return LSC_INVALID
    }
    let idx = p.scope_count
    p.scope_entries[idx as usize] = LscScopeEntry {
        name_id: name_id,
        kind: LscScopeKind::LscScopeVar,
        type_id: type_id,
        detail_id: 0,
        depth: p.current_depth,
        visible: true,
    }
    p.scope_count = p.scope_count + 1
    idx
}

// Add a function to the provider scope.
fn lsc_add_function(p: &! LscProvider, name_id: i64, type_id: i64) -> i64 with Mut, Div, Panic {
    if p.scope_count >= LSC_MAX_SCOPE_ENTRIES {
        return LSC_INVALID
    }
    let idx = p.scope_count
    p.scope_entries[idx as usize] = LscScopeEntry {
        name_id: name_id,
        kind: LscScopeKind::LscScopeFunc,
        type_id: type_id,
        detail_id: 0,
        depth: p.current_depth,
        visible: true,
    }
    p.scope_count = p.scope_count + 1
    idx
}

// Add a type to the provider scope.
fn lsc_add_type(p: &! LscProvider, name_id: i64, detail_id: i64) -> i64 with Mut, Div, Panic {
    if p.scope_count >= LSC_MAX_SCOPE_ENTRIES {
        return LSC_INVALID
    }
    let idx = p.scope_count
    p.scope_entries[idx as usize] = LscScopeEntry {
        name_id: name_id,
        kind: LscScopeKind::LscScopeType,
        type_id: 0,
        detail_id: detail_id,
        depth: p.current_depth,
        visible: true,
    }
    p.scope_count = p.scope_count + 1
    idx
}

// Add a module to the provider scope.
fn lsc_add_module(p: &! LscProvider, name_id: i64) -> i64 with Mut, Div, Panic {
    if p.scope_count >= LSC_MAX_SCOPE_ENTRIES {
        return LSC_INVALID
    }
    let idx = p.scope_count
    p.scope_entries[idx as usize] = LscScopeEntry {
        name_id: name_id,
        kind: LscScopeKind::LscScopeModule,
        type_id: 0,
        detail_id: 0,
        depth: p.current_depth,
        visible: true,
    }
    p.scope_count = p.scope_count + 1
    idx
}

// Add a field info entry.  Returns the index, or LSC_INVALID if full.
fn lsc_add_field(p: &! LscProvider, name_id: i64, type_id: i64, struct_id: i64) -> i64 with Mut, Div, Panic {
    if p.field_count >= LSC_MAX_FIELDS {
        return LSC_INVALID
    }
    let idx = p.field_count
    p.fields[idx as usize] = LscFieldInfo {
        name_id: name_id,
        type_id: type_id,
        struct_id: struct_id,
    }
    p.field_count = p.field_count + 1
    idx
}

// Add a method info entry.  Returns the index, or LSC_INVALID if full.
fn lsc_add_method(p: &! LscProvider, name_id: i64, type_id: i64, receiver: i64, params: i64) -> i64 with Mut, Div, Panic {
    if p.method_count >= LSC_MAX_METHODS {
        return LSC_INVALID
    }
    let idx = p.method_count
    p.methods[idx as usize] = LscMethodInfo {
        name_id: name_id,
        type_id: type_id,
        receiver_type: receiver,
        param_count: params,
    }
    p.method_count = p.method_count + 1
    idx
}

// Enter a new scope.  Returns the previous depth for restoration.
fn lsc_enter_scope(p: &! LscProvider) -> i64 with Mut {
    let saved = p.current_depth
    p.current_depth = p.current_depth + 1
    saved
}

// Exit a scope.  Marks entries deeper than saved_depth as not visible.
// Returns the number of entries hidden.
fn lsc_exit_scope(p: &! LscProvider, saved_depth: i64) -> i64 with Mut, Div, Panic {
    p.current_depth = saved_depth
    var hidden: i64 = 0
    var i: i64 = 0
    while i < p.scope_count {
        if p.scope_entries[i as usize].depth > saved_depth {
            if p.scope_entries[i as usize].visible {
                p.scope_entries[i as usize].visible = false
                hidden = hidden + 1
            }
        }
        i = i + 1
    }
    hidden
}

// ============================================================================
// Section 8: KEYWORD REGISTRATION
// ============================================================================

// Helper: push a keyword intern-id into the keyword table.
fn lsc_push_keyword(p: &! LscProvider, kw_id: i64) -> i64 with Mut, Div, Panic {
    if p.keyword_count >= LSC_MAX_KEYWORDS {
        return LSC_INVALID
    }
    let idx = p.keyword_count
    p.keywords[idx as usize] = kw_id
    p.keyword_count = p.keyword_count + 1
    idx
}

// Register all Sounio keywords.  The caller must have already interned
// each keyword string.  The integer IDs here are placeholder intern IDs
// (1..N); the actual integration layer will replace them with real intern
// IDs from the StringInterner.
//
// Keywords registered:
//   fn, let, var, struct, enum, if, else, while, for, return,
//   match, use, with, true, false, break, continue, impl, trait,
//   type, as, in, linear, where, effect, handle, resume, self
fn lsc_register_sounio_keywords(p: &! LscProvider) -> i64 with Mut, Div, Panic {
    // We use consecutive placeholder IDs starting from 1001.
    // In real integration these come from the interner.
    var base: i64 = 1001

    // fn
    let r0 = lsc_push_keyword(p, base)
    base = base + 1
    // let
    let r1 = lsc_push_keyword(p, base)
    base = base + 1
    // var
    let r2 = lsc_push_keyword(p, base)
    base = base + 1
    // struct
    let r3 = lsc_push_keyword(p, base)
    base = base + 1
    // enum
    let r4 = lsc_push_keyword(p, base)
    base = base + 1
    // if
    let r5 = lsc_push_keyword(p, base)
    base = base + 1
    // else
    let r6 = lsc_push_keyword(p, base)
    base = base + 1
    // while
    let r7 = lsc_push_keyword(p, base)
    base = base + 1
    // for
    let r8 = lsc_push_keyword(p, base)
    base = base + 1
    // return
    let r9 = lsc_push_keyword(p, base)
    base = base + 1
    // match
    let r10 = lsc_push_keyword(p, base)
    base = base + 1
    // use
    let r11 = lsc_push_keyword(p, base)
    base = base + 1
    // with
    let r12 = lsc_push_keyword(p, base)
    base = base + 1
    // true
    let r13 = lsc_push_keyword(p, base)
    base = base + 1
    // false
    let r14 = lsc_push_keyword(p, base)
    base = base + 1
    // break
    let r15 = lsc_push_keyword(p, base)
    base = base + 1
    // continue
    let r16 = lsc_push_keyword(p, base)
    base = base + 1
    // impl
    let r17 = lsc_push_keyword(p, base)
    base = base + 1
    // trait
    let r18 = lsc_push_keyword(p, base)
    base = base + 1
    // type
    let r19 = lsc_push_keyword(p, base)
    base = base + 1
    // as
    let r20 = lsc_push_keyword(p, base)
    base = base + 1
    // in
    let r21 = lsc_push_keyword(p, base)
    base = base + 1
    // linear
    let r22 = lsc_push_keyword(p, base)
    base = base + 1
    // where
    let r23 = lsc_push_keyword(p, base)
    base = base + 1
    // effect
    let r24 = lsc_push_keyword(p, base)
    base = base + 1
    // handle
    let r25 = lsc_push_keyword(p, base)
    base = base + 1
    // resume
    let r26 = lsc_push_keyword(p, base)
    base = base + 1
    // self
    let r27 = lsc_push_keyword(p, base)
    base = base + 1

    p.keyword_count
}

// Check if a name_id is a registered keyword.
fn lsc_is_keyword(p: &LscProvider, name_id: i64) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    while i < p.keyword_count {
        if p.keywords[i as usize] == name_id {
            return true
        }
        i = i + 1
    }
    false
}

// ============================================================================
// Section 8b: KEYWORD TABLE HELPERS
// ============================================================================

// Return the keyword count after registration.
fn lsc_keyword_table_size(p: &LscProvider) -> i64 {
    p.keyword_count
}

// Find a keyword by its intern-id.  Returns the index or LSC_INVALID.
fn lsc_find_keyword(p: &LscProvider, kw_id: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < p.keyword_count {
        if p.keywords[i as usize] == kw_id {
            return i
        }
        i = i + 1
    }
    LSC_INVALID
}

// ============================================================================
// Section 9: COMPLETION GENERATION
// ============================================================================

// Helper: map a scope kind to an LSP completion kind.
fn lsc_scope_kind_to_completion_kind(kind: LscScopeKind) -> i64 {
    match kind {
        LscScopeKind::LscScopeVar => LSC_KIND_VARIABLE,
        LscScopeKind::LscScopeFunc => LSC_KIND_FUNCTION,
        LscScopeKind::LscScopeType => LSC_KIND_STRUCT,
        LscScopeKind::LscScopeModule => LSC_KIND_MODULE,
        LscScopeKind::LscScopeField => LSC_KIND_FIELD,
        LscScopeKind::LscScopeMethod => LSC_KIND_METHOD,
        LscScopeKind::LscScopeEnum => LSC_KIND_ENUM_MEMBER,
        LscScopeKind::LscScopeConst => LSC_KIND_VARIABLE,
    }
}

// Helper: compute a priority bonus for a scope entry based on depth.
// Deeper (more local) entries get higher priority.
fn lsc_depth_priority(entry_depth: i64, current_depth: i64) -> i64 {
    // Base priority 50; +10 per depth level of locality
    if entry_depth <= current_depth {
        return 50 + (entry_depth * 10)
    }
    50
}

// Complete bare identifiers.  Walks visible scope entries and returns
// those whose name matches the prefix in the completion context.
fn lsc_complete_identifier(p: &LscProvider, ctx: &LscCompletionContext) -> LspCompletionList with Mut, Div, Panic {
    var list = lsp_completion_list_new()
    var i: i64 = 0
    while i < p.scope_count {
        let entry = p.scope_entries[i as usize]
        if entry.visible {
            // Build a dummy name buffer from the intern ID.
            // In real integration the interner resolves name_id -> bytes.
            // Here we use the name_id directly as the label hash.
            let score = lsc_entry_score_by_id(entry.name_id, ctx)
            if score > 0 {
                let ck = lsc_scope_kind_to_completion_kind(entry.kind)
                let prio = lsc_depth_priority(entry.depth, p.current_depth) + score
                let item = lsp_completion_item_new(entry.name_id, ck, entry.detail_id, prio)
                list = lsp_completion_list_add(list, item)
            }
        }
        i = i + 1
    }
    list
}

// Score helper: when the prefix_len is zero every entry matches with score 1.
// When prefix_len > 0 we cannot do byte comparison without the interner, so
// we use a name_id-based heuristic: if the prefix_len is > 0 and the name_id
// is nonzero, we return a base score.  The real integration layer will replace
// this with proper byte-level matching via lsc_name_score.
fn lsc_entry_score_by_id(name_id: i64, ctx: &LscCompletionContext) -> i64 with Div, Panic {
    if ctx.prefix_len == 0 {
        return 1
    }
    if name_id > 0 {
        return 10
    }
    0
}

// Complete after '.' -- field and method access on a receiver type.
fn lsc_complete_dot(p: &LscProvider, ctx: &LscCompletionContext, receiver_type: i64) -> LspCompletionList with Mut, Div, Panic {
    var list = lsp_completion_list_new()

    // Add matching fields
    var i: i64 = 0
    while i < p.field_count {
        let fi = p.fields[i as usize]
        if fi.struct_id == receiver_type {
            let score = lsc_entry_score_by_id(fi.name_id, ctx)
            if score > 0 {
                let prio = 100 + score
                let item = lsp_completion_item_new(fi.name_id, LSC_KIND_FIELD, fi.type_id, prio)
                list = lsp_completion_list_add(list, item)
            }
        }
        i = i + 1
    }

    // Add matching methods
    var j: i64 = 0
    while j < p.method_count {
        let mi = p.methods[j as usize]
        if mi.receiver_type == receiver_type {
            let score = lsc_entry_score_by_id(mi.name_id, ctx)
            if score > 0 {
                let prio = 90 + score
                let item = lsp_completion_item_new(mi.name_id, LSC_KIND_METHOD, mi.type_id, prio)
                list = lsp_completion_list_add(list, item)
            }
        }
        j = j + 1
    }

    list
}

// Complete after '::' -- path-qualified names within a module.
fn lsc_complete_path(p: &LscProvider, ctx: &LscCompletionContext, module_id: i64) -> LspCompletionList with Mut, Div, Panic {
    var list = lsp_completion_list_new()

    // Walk scope entries looking for items whose detail_id references
    // the module.  In the real implementation, the module_id maps to a
    // namespace of exported symbols.
    var i: i64 = 0
    while i < p.scope_count {
        let entry = p.scope_entries[i as usize]
        if entry.visible && entry.detail_id == module_id {
            let score = lsc_entry_score_by_id(entry.name_id, ctx)
            if score > 0 {
                let ck = lsc_scope_kind_to_completion_kind(entry.kind)
                let prio = 80 + score
                let item = lsp_completion_item_new(entry.name_id, ck, entry.detail_id, prio)
                list = lsp_completion_list_add(list, item)
            }
        }
        i = i + 1
    }

    list
}

// ============================================================================
// Section 9b: CROSS-MODULE COMPLETIONS (qualified Mod:: prefix)
// ============================================================================

// LscModSymEntry -- one entry in the module-symbol bridge table used by
// lsp_completions_from_module.  Populated by the indexer (or test harness)
// when symbols are registered from resolved imports.
struct LscModSymEntry {
    mod_hash: i64,   // hash of the module name
    sym_hash: i64,   // hash of the exported symbol name
    kind: i64,       // LSP completion kind (LSC_KIND_* constant)
    detail_id: i64,  // type/detail intern ID (0 = none)
}

// Bridge table for cross-module completions (static capacity).
let LSC_MOD_SYM_MAX: i64 = 256

// lsp_completions_from_module -- cross-module completion fallback.
//
// Called from the completion dispatch when the user has typed a `Mod::` prefix
// (ctx.after_colon_colon == true and the module hash is known).  Scans the
// provided bridge table for all entries whose mod_hash matches `mod_hash` and
// whose sym_hash starts with `prefix_hash` (non-zero prefix_hash acts as a
// filter; zero means return all symbols in the module).
//
// The matched entries are appended to `list` and the updated list is returned.
// Returns the count of newly added items.
//
// Parameters:
//   table        -- slice of LscModSymEntry (capacity LSC_MOD_SYM_MAX)
//   table_count  -- number of valid entries in table
//   mod_hash     -- hash of the module being completed (from the Mod:: prefix)
//   prefix_hash  -- hash of the typed symbol prefix after ::, or 0 for all
//   list         -- existing completion list to append to
fn lsp_completions_from_module(
    table: &[LscModSymEntry; 256],
    table_count: i64,
    mod_hash: i64,
    prefix_hash: i64,
    list: LspCompletionList
) -> LspCompletionList with Mut, Div, Panic {
    var out = list
    var added: i64 = 0
    var i: i64 = 0
    while i < table_count {
        let entry = table[i as usize]
        if entry.mod_hash == mod_hash {
            // prefix_hash == 0 means no prefix filter; otherwise only include
            // entries whose sym_hash equals the prefix hash (exact match or
            // the caller may pass a partial hash that was computed the same way).
            let match_prefix = prefix_hash == 0 || entry.sym_hash == prefix_hash
            if match_prefix {
                let item = lsp_completion_item_new(entry.sym_hash, entry.kind, entry.detail_id, 75)
                out = lsp_completion_list_add(out, item)
                added = added + 1
            }
        }
        i = i + 1
    }
    out
}

// Complete in type position -- only type-like entries (structs, enums,
// type params, modules).
fn lsc_complete_type(p: &LscProvider, ctx: &LscCompletionContext) -> LspCompletionList with Mut, Div, Panic {
    var list = lsp_completion_list_new()
    var i: i64 = 0
    while i < p.scope_count {
        let entry = p.scope_entries[i as usize]
        if entry.visible {
            let is_type = lsc_is_type_like_kind(entry.kind)
            if is_type {
                let score = lsc_entry_score_by_id(entry.name_id, ctx)
                if score > 0 {
                    let ck = lsc_scope_kind_to_completion_kind(entry.kind)
                    let prio = 120 + score
                    let item = lsp_completion_item_new(entry.name_id, ck, entry.detail_id, prio)
                    list = lsp_completion_list_add(list, item)
                }
            }
        }
        i = i + 1
    }
    list
}

// Helper: check if a scope kind represents a type-like entity.
fn lsc_is_type_like_kind(kind: LscScopeKind) -> bool {
    match kind {
        LscScopeKind::LscScopeType => true,
        LscScopeKind::LscScopeModule => true,
        LscScopeKind::LscScopeEnum => true,
        _ => false,
    }
}

// Complete keywords -- walks registered keywords and returns those
// matching the prefix.
fn lsc_complete_keyword(p: &LscProvider, ctx: &LscCompletionContext) -> LspCompletionList with Mut, Div, Panic {
    var list = lsp_completion_list_new()
    var i: i64 = 0
    while i < p.keyword_count {
        let kw_id = p.keywords[i as usize]
        let score = lsc_entry_score_by_id(kw_id, ctx)
        if score > 0 {
            // Keywords get lower priority than variables/functions
            let prio = 40 + score
            let item = lsp_completion_item_new(kw_id, LSC_KIND_KEYWORD, 0, prio)
            list = lsp_completion_list_add(list, item)
        }
        i = i + 1
    }
    list
}

// ============================================================================
// Section 10: TOP-LEVEL COMPLETION DISPATCH
// ============================================================================

// Main entry point: dispatch to the appropriate completion strategy based
// on context flags.
fn lsc_provide_completions(p: &LscProvider, ctx: &LscCompletionContext) -> LspCompletionList with Mut, Div, Panic {
    // After-dot completions take precedence
    if ctx.after_dot {
        // receiver_type defaults to 0 when not resolved; the caller should
        // set ctx.trigger_char to the receiver's type_id in practice.
        return lsc_complete_dot(p, ctx, ctx.trigger_char)
    }

    // After-:: completions for path-qualified names
    if ctx.after_colon_colon {
        return lsc_complete_path(p, ctx, ctx.trigger_char)
    }

    // Type-position completions
    if ctx.in_type_position {
        let type_list = lsc_complete_type(p, ctx)
        return type_list
    }

    // General identifier + keyword completions
    let id_list = lsc_complete_identifier(p, ctx)
    let kw_list = lsc_complete_keyword(p, ctx)
    let merged = lsc_merge_completions(id_list, kw_list)

    merged
}

// Sort completions by priority in descending order (highest priority first).
// Uses insertion sort, which is efficient for the small (<=256) list size.
fn lsc_sort_completions(list: LspCompletionList) -> LspCompletionList with Mut, Div, Panic {
    var out = list
    var i: i64 = 1
    while i < out.count {
        let current = out.items[i as usize]
        var j = i - 1
        while j >= 0 {
            let j_prio = out.items[j as usize].sort_priority
            if j_prio < current.sort_priority {
                out.items[(j + 1) as usize] = out.items[j as usize]
                j = j - 1
            } else {
                j = 0 - 1
            }
        }
        out.items[(j + 1) as usize] = current
        i = i + 1
    }
    out
}

// Filter completions to at most max items.  Returns the truncated list
// with is_incomplete set to true if items were dropped.
fn lsc_filter_completions(list: LspCompletionList, max: i64) -> LspCompletionList with Mut, Div, Panic {
    if list.count <= max {
        return list
    }
    var out = list
    out.count = max
    out.is_incomplete = true
    out
}

// Merge two completion lists into one.  Appends items from b to a,
// stopping at the LSC_MAX_COMPLETIONS capacity.
fn lsc_merge_completions(a: LspCompletionList, b: LspCompletionList) -> LspCompletionList with Mut, Div, Panic {
    var out = a
    var i: i64 = 0
    while i < b.count {
        if out.count >= LSC_MAX_COMPLETIONS {
            out.is_incomplete = true
            return out
        }
        out.items[out.count as usize] = b.items[i as usize]
        out.count = out.count + 1
        i = i + 1
    }
    out
}

// ============================================================================
// Section 10b: COMPLETION LIST UTILITIES
// ============================================================================

// Check if a completion list contains an item with the given label_hash.
fn lsc_list_contains_label(list: LspCompletionList, label: i64) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    while i < list.count {
        if list.items[i as usize].label_hash == label {
            return true
        }
        i = i + 1
    }
    false
}

// Find the index of an item with the given label_hash.  Returns LSC_INVALID
// if not found.
fn lsc_list_find_label(list: LspCompletionList, label: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < list.count {
        if list.items[i as usize].label_hash == label {
            return i
        }
        i = i + 1
    }
    LSC_INVALID
}

// Return the maximum priority in a completion list.
fn lsc_list_max_priority(list: LspCompletionList) -> i64 with Mut, Div, Panic {
    if list.count == 0 {
        return 0
    }
    var max_prio = list.items[0].sort_priority
    var i: i64 = 1
    while i < list.count {
        if list.items[i as usize].sort_priority > max_prio {
            max_prio = list.items[i as usize].sort_priority
        }
        i = i + 1
    }
    max_prio
}

// Return the minimum priority in a completion list.
fn lsc_list_min_priority(list: LspCompletionList) -> i64 with Mut, Div, Panic {
    if list.count == 0 {
        return 0
    }
    var min_prio = list.items[0].sort_priority
    var i: i64 = 1
    while i < list.count {
        if list.items[i as usize].sort_priority < min_prio {
            min_prio = list.items[i as usize].sort_priority
        }
        i = i + 1
    }
    min_prio
}

// Count items with a specific kind in a completion list.
fn lsc_list_count_kind(list: LspCompletionList, kind: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < list.count {
        if list.items[i as usize].kind == kind {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Check if a completion list is sorted by priority (descending).
fn lsc_list_is_sorted(list: LspCompletionList) -> bool with Mut, Div, Panic {
    if list.count <= 1 {
        return true
    }
    var i: i64 = 1
    while i < list.count {
        if list.items[i as usize].sort_priority > list.items[(i - 1) as usize].sort_priority {
            return false
        }
        i = i + 1
    }
    true
}

// Deduplicate a completion list by label_hash.  Keeps the first occurrence
// of each label.  Returns the deduplicated list.
fn lsc_dedup_completions(list: LspCompletionList) -> LspCompletionList with Mut, Div, Panic {
    var out = lsp_completion_list_new()
    var i: i64 = 0
    while i < list.count {
        let label = list.items[i as usize].label_hash
        let found = lsc_list_contains_label(out, label)
        if found == false {
            out = lsp_completion_list_add(out, list.items[i as usize])
        }
        i = i + 1
    }
    out.is_incomplete = list.is_incomplete
    out
}

// ============================================================================
// Section 11: SNIPPET GENERATION
// ============================================================================

// Each snippet function returns an LspCompletionItem with kind=SNIPPET
// and a label_hash representing the snippet text.  The label hashes are
// placeholder intern IDs; the real integration layer maps them to the
// actual snippet strings.

// Snippet IDs: using a distinctive range 9001..9007 to avoid collisions
let LSC_SNIPPET_FN_ID: i64       = 9001
let LSC_SNIPPET_STRUCT_ID: i64   = 9002
let LSC_SNIPPET_ENUM_ID: i64     = 9003
let LSC_SNIPPET_MATCH_ID: i64    = 9004
let LSC_SNIPPET_IF_ID: i64       = 9005
let LSC_SNIPPET_WHILE_ID: i64    = 9006
let LSC_SNIPPET_FOR_ID: i64      = 9007

// `fn name() -> T { }`
fn lsc_snippet_fn() -> LspCompletionItem {
    lsp_completion_item_new(LSC_SNIPPET_FN_ID, LSC_KIND_SNIPPET, 0, 60)
}

// `struct Name { }`
fn lsc_snippet_struct() -> LspCompletionItem {
    lsp_completion_item_new(LSC_SNIPPET_STRUCT_ID, LSC_KIND_SNIPPET, 0, 60)
}

// `enum Name { }`
fn lsc_snippet_enum() -> LspCompletionItem {
    lsp_completion_item_new(LSC_SNIPPET_ENUM_ID, LSC_KIND_SNIPPET, 0, 60)
}

// `match expr { }`
fn lsc_snippet_match() -> LspCompletionItem {
    lsp_completion_item_new(LSC_SNIPPET_MATCH_ID, LSC_KIND_SNIPPET, 0, 55)
}

// `if cond { }`
fn lsc_snippet_if() -> LspCompletionItem {
    lsp_completion_item_new(LSC_SNIPPET_IF_ID, LSC_KIND_SNIPPET, 0, 55)
}

// `while cond { }`
fn lsc_snippet_while() -> LspCompletionItem {
    lsp_completion_item_new(LSC_SNIPPET_WHILE_ID, LSC_KIND_SNIPPET, 0, 55)
}

// `for x in iter { }`
fn lsc_snippet_for() -> LspCompletionItem {
    lsp_completion_item_new(LSC_SNIPPET_FOR_ID, LSC_KIND_SNIPPET, 0, 55)
}

// ============================================================================
// Section 12: TESTS
// ============================================================================

// -------------------------------------------------------
// String matching tests (T01-T05)
// -------------------------------------------------------

// T01: lsc_char_to_lower converts uppercase to lowercase
fn test_lsc_char_to_lower() -> bool {
    let a_lower = lsc_char_to_lower(65)  // 'A' -> 'a'
    let ok_a = a_lower == 97
    let z_lower = lsc_char_to_lower(90)  // 'Z' -> 'z'
    let ok_z = z_lower == 122
    // lowercase and non-alpha unchanged
    let x_unchanged = lsc_char_to_lower(120)  // 'x' stays 'x'
    let ok_x = x_unchanged == 120
    let digit_unchanged = lsc_char_to_lower(48)  // '0' stays '0'
    let ok_d = digit_unchanged == 48
    ok_a && ok_z && ok_x && ok_d
}

// T02: lsc_is_letter detects letters
fn test_lsc_is_letter() -> bool {
    let ok_a = lsc_is_letter(65)   // 'A'
    let ok_z = lsc_is_letter(122)  // 'z'
    let not_digit = lsc_is_letter(48) == false  // '0'
    let not_space = lsc_is_letter(32) == false  // ' '
    ok_a && ok_z && not_digit && not_space
}

// T03: lsc_is_upper detects uppercase
fn test_lsc_is_upper() -> bool {
    let ok_A = lsc_is_upper(65)    // 'A'
    let ok_Z = lsc_is_upper(90)    // 'Z'
    let not_a = lsc_is_upper(97) == false  // 'a'
    let not_0 = lsc_is_upper(48) == false  // '0'
    ok_A && ok_Z && not_a && not_0
}

// T04: lsc_name_matches_prefix basic matching
fn test_lsc_name_matches_prefix() -> bool with Mut, Div, Panic {
    // Build name "hello" -> [104, 101, 108, 108, 111, ...]
    var name: [i8; 256] = [0; 256]
    name[0] = 104  // 'h'
    name[1] = 101  // 'e'
    name[2] = 108  // 'l'
    name[3] = 108  // 'l'
    name[4] = 111  // 'o'

    // prefix "hel"
    var pfx: [i8; 256] = [0; 256]
    pfx[0] = 104  // 'h'
    pfx[1] = 101  // 'e'
    pfx[2] = 108  // 'l'

    let ok_match = lsc_name_matches_prefix(name, 5, pfx, 3)

    // prefix "HEL" (case-insensitive)
    var pfx2: [i8; 256] = [0; 256]
    pfx2[0] = 72  // 'H'
    pfx2[1] = 69  // 'E'
    pfx2[2] = 76  // 'L'
    let ok_ci = lsc_name_matches_prefix(name, 5, pfx2, 3)

    // prefix "xyz" should not match
    var pfx3: [i8; 256] = [0; 256]
    pfx3[0] = 120  // 'x'
    pfx3[1] = 121  // 'y'
    pfx3[2] = 122  // 'z'
    let no_match = lsc_name_matches_prefix(name, 5, pfx3, 3) == false

    // empty prefix matches everything
    let empty_pfx: [i8; 256] = [0; 256]
    let ok_empty = lsc_name_matches_prefix(name, 5, empty_pfx, 0)

    ok_match && ok_ci && no_match && ok_empty
}

// T05: lsc_name_score scoring tiers
fn test_lsc_name_score() -> bool with Mut, Div, Panic {
    // Build name "count" -> [99, 111, 117, 110, 116]
    var name: [i8; 256] = [0; 256]
    name[0] = 99   // 'c'
    name[1] = 111  // 'o'
    name[2] = 117  // 'u'
    name[3] = 110  // 'n'
    name[4] = 116  // 't'

    // Exact prefix "co" -> high score
    var pfx: [i8; 256] = [0; 256]
    pfx[0] = 99   // 'c'
    pfx[1] = 111  // 'o'
    let score_exact = lsc_name_score(name, 5, pfx, 2)
    let ok_exact = score_exact >= 150

    // Case-insensitive prefix "CO" -> medium-high score
    var pfx_ci: [i8; 256] = [0; 256]
    pfx_ci[0] = 67   // 'C'
    pfx_ci[1] = 79   // 'O'
    let score_ci = lsc_name_score(name, 5, pfx_ci, 2)
    let ok_ci = score_ci >= 100

    // Non-matching prefix "zz"
    var pfx_no: [i8; 256] = [0; 256]
    pfx_no[0] = 122  // 'z'
    pfx_no[1] = 122  // 'z'
    let score_no = lsc_name_score(name, 5, pfx_no, 2)
    let ok_no = score_no == 0

    // Empty prefix -> minimal score
    let empty: [i8; 256] = [0; 256]
    let score_empty = lsc_name_score(name, 5, empty, 0)
    let ok_empty = score_empty == 1

    ok_exact && ok_ci && ok_no && ok_empty
}

// -------------------------------------------------------
// Scope management tests (T06-T10)
// -------------------------------------------------------

// T06: add variable and verify count
fn test_lsc_add_variable_inner(p: &! LscProvider) -> bool with Mut, Div, Panic {
    let idx = lsc_add_variable(p, 100, 200)
    let ok_idx = idx == 0
    let ok_count = p.scope_count == 1
    let ok_name = p.scope_entries[0].name_id == 100
    let ok_type = p.scope_entries[0].type_id == 200
    let ok_vis = p.scope_entries[0].visible
    ok_idx && ok_count && ok_name && ok_type && ok_vis
}
fn test_lsc_add_variable() -> bool with Mut, Div, Panic {
    var p = lsc_provider_new()
    test_lsc_add_variable_inner(&! p)
}

// T07: add function and verify kind
fn test_lsc_add_function_inner(p: &! LscProvider) -> bool with Mut, Div, Panic {
    let idx = lsc_add_function(p, 101, 201)
    let ok_idx = idx >= 0
    let ok_kind = match p.scope_entries[idx as usize].kind {
        LscScopeKind::LscScopeFunc => true,
        _ => false,
    }
    ok_idx && ok_kind
}
fn test_lsc_add_function() -> bool with Mut, Div, Panic {
    var p = lsc_provider_new()
    test_lsc_add_function_inner(&! p)
}

// T08: add type entry
fn test_lsc_add_type_inner(p: &! LscProvider) -> bool with Mut, Div, Panic {
    let idx = lsc_add_type(p, 102, 999)
    let ok_idx = idx >= 0
    let ok_kind = match p.scope_entries[idx as usize].kind {
        LscScopeKind::LscScopeType => true,
        _ => false,
    }
    let ok_detail = p.scope_entries[idx as usize].detail_id == 999
    ok_idx && ok_kind && ok_detail
}
fn test_lsc_add_type() -> bool with Mut, Div, Panic {
    var p = lsc_provider_new()
    test_lsc_add_type_inner(&! p)
}

// T09: scope enter and exit hides entries
fn test_lsc_scope_enter_exit_inner(p: &! LscProvider) -> bool with Mut, Div, Panic {
    // Add entry at depth 0
    let idx0 = lsc_add_variable(p, 50, 0)
    // Enter scope
    let saved = lsc_enter_scope(p)
    let ok_depth = p.current_depth == 1
    // Add entry at depth 1
    let idx1 = lsc_add_variable(p, 51, 0)
    let ok_inner_vis = p.scope_entries[idx1 as usize].visible
    // Exit scope
    let hidden = lsc_exit_scope(p, saved)
    let ok_hidden = hidden == 1
    let ok_outer_vis = p.scope_entries[idx0 as usize].visible
    let ok_inner_gone = p.scope_entries[idx1 as usize].visible == false
    ok_depth && ok_inner_vis && ok_hidden && ok_outer_vis && ok_inner_gone
}
fn test_lsc_scope_enter_exit() -> bool with Mut, Div, Panic {
    var p = lsc_provider_new()
    test_lsc_scope_enter_exit_inner(&! p)
}

// T10: add module entry
fn test_lsc_add_module_inner(p: &! LscProvider) -> bool with Mut, Div, Panic {
    let idx = lsc_add_module(p, 103)
    let ok_idx = idx >= 0
    let ok_kind = match p.scope_entries[idx as usize].kind {
        LscScopeKind::LscScopeModule => true,
        _ => false,
    }
    ok_idx && ok_kind
}
fn test_lsc_add_module() -> bool with Mut, Div, Panic {
    var p = lsc_provider_new()
    test_lsc_add_module_inner(&! p)
}

