// T15: complete identifier respects depth priority
fn test_lsc_complete_id_depth_inner(p: &! LscProvider) -> bool with Mut, Div, Panic {
    let v1 = lsc_add_variable(p, 30, 0)  // depth 0
    let saved = lsc_enter_scope(p)
    let v2 = lsc_add_variable(p, 31, 0)  // depth 1

    let ctx = lsc_context_new()
    let list = lsc_complete_identifier(p, &ctx)
    let ok_count = list.count == 2
    // Deeper entry should have higher priority
    let prio0 = list.items[0].sort_priority
    let prio1 = list.items[1].sort_priority
    let ok_prio = prio1 > prio0
    ok_count && ok_prio
}
fn test_lsc_complete_id_depth() -> bool with Mut, Div, Panic {
    var p = lsc_provider_new()
    test_lsc_complete_id_depth_inner(&! p)
}

