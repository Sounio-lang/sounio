    ok
}

// T76: keyword find helper
fn test_lsc_find_keyword_inner(p: &! LscProvider) -> bool with Mut, Div, Panic {
    let count = lsc_register_sounio_keywords(p)
    // fn is at index 0 with id 1001
    let idx_fn = lsc_find_keyword(p, 1001)
    let ok_fn = idx_fn == 0
    // var is at index 2 with id 1003
    let idx_var = lsc_find_keyword(p, 1003)
    let ok_var = idx_var == 2
    // non-existent keyword
    let idx_bad = lsc_find_keyword(p, 9999)
    let ok_bad = idx_bad == LSC_INVALID
    ok_fn && ok_var && ok_bad
}
fn test_lsc_find_keyword() -> bool with Mut, Div, Panic {
    var p = lsc_provider_new()
    test_lsc_find_keyword_inner(&! p)
}

// T77: sort then filter pipeline
fn test_lsc_sort_filter_pipeline() -> bool with Mut, Div, Panic {
    var list = lsp_completion_list_new()
    var i: i64 = 0
    while i < 20 {
        let item = lsp_completion_item_new(i + 1, LSC_KIND_VARIABLE, 0, i * 5)
        list = lsp_completion_list_add(list, item)
        i = i + 1
    }

    let sorted = lsc_sort_completions(list)
    let ok_sorted = lsc_list_is_sorted(sorted)
    let filtered = lsc_filter_completions(sorted, 5)
    let ok_count = filtered.count == 5
    // After sort (desc) and filter(5), top 5 items should have highest prios
    let ok_top = filtered.items[0].sort_priority == 95  // 19*5
    ok_sorted && ok_count && ok_top
}

// T78: merge overflow marks incomplete
fn test_lsc_merge_overflow() -> bool with Mut, Div, Panic {
    // Fill list a close to capacity
    var a = lsp_completion_list_new()
    var i: i64 = 0
    while i < 250 {
        let item = lsp_completion_item_new(i + 1, LSC_KIND_VARIABLE, 0, 0)
        a = lsp_completion_list_add(a, item)
        i = i + 1
    }

    // Create b with 10 items
    var b = lsp_completion_list_new()
    var j: i64 = 0
    while j < 10 {
        let item = lsp_completion_item_new(1000 + j, LSC_KIND_KEYWORD, 0, 0)
        b = lsp_completion_list_add(b, item)
        j = j + 1
    }

    let merged = lsc_merge_completions(a, b)
    // Total should be capped at 256
    let ok_cap = merged.count == 256
    let ok_incomplete = merged.is_incomplete
    ok_cap && ok_incomplete
}

// T79: nested scope management (enter, enter, exit, exit)
fn test_lsc_nested_scopes_inner(p: &! LscProvider) -> bool with Mut, Div, Panic {
    let v0 = lsc_add_variable(p, 800, 0)   // depth 0
    let s1 = lsc_enter_scope(p)              // depth -> 1
    let v1 = lsc_add_variable(p, 801, 0)   // depth 1
    let s2 = lsc_enter_scope(p)              // depth -> 2
    let v2 = lsc_add_variable(p, 802, 0)   // depth 2

    let ok_depth_2 = p.current_depth == 2
    let vis_at_2 = lsc_visible_count(p)
    let ok_vis_3 = vis_at_2 == 3

    // Exit inner scope
    let hidden_inner = lsc_exit_scope(p, s2)
    let ok_hidden_1 = hidden_inner == 1
    let ok_depth_1 = p.current_depth == 1
    let vis_at_1 = lsc_visible_count(p)
    let ok_vis_2 = vis_at_1 == 2

    // Exit outer scope
    let hidden_outer = lsc_exit_scope(p, s1)
    let ok_hidden_2 = hidden_outer == 1
    let ok_depth_0 = p.current_depth == 0
    let vis_at_0 = lsc_visible_count(p)
    let ok_vis_1 = vis_at_0 == 1

    ok_depth_2 && ok_vis_3 && ok_hidden_1 && ok_depth_1 && ok_vis_2
        && ok_hidden_2 && ok_depth_0 && ok_vis_1
}
fn test_lsc_nested_scopes() -> bool with Mut, Div, Panic {
    var p = lsc_provider_new()
    test_lsc_nested_scopes_inner(&! p)
}

// T80: is_type_like_kind distinguishes type-like from value-like
fn test_lsc_is_type_like_kind() -> bool {
    let ok_type = lsc_is_type_like_kind(LscScopeKind::LscScopeType)
    let ok_mod = lsc_is_type_like_kind(LscScopeKind::LscScopeModule)
    let ok_enum = lsc_is_type_like_kind(LscScopeKind::LscScopeEnum)
    let not_var = lsc_is_type_like_kind(LscScopeKind::LscScopeVar) == false
    let not_func = lsc_is_type_like_kind(LscScopeKind::LscScopeFunc) == false
    let not_field = lsc_is_type_like_kind(LscScopeKind::LscScopeField) == false
    ok_type && ok_mod && ok_enum && not_var && not_func && not_field
}

// ============================================================================
// TEST RUNNER
// ============================================================================

fn lsc_run_tests() -> i64 with Mut, Div, Panic {
    var passed: i64 = 0
    var total: i64 = 0

    // ---- String matching tests (T01-T05) ----
    total = total + 1
    if test_lsc_char_to_lower() { passed = passed + 1 }

    total = total + 1
    if test_lsc_is_letter() { passed = passed + 1 }

    total = total + 1
    if test_lsc_is_upper() { passed = passed + 1 }

    total = total + 1
    if test_lsc_name_matches_prefix() { passed = passed + 1 }

    total = total + 1
    if test_lsc_name_score() { passed = passed + 1 }

    // ---- Scope management tests (T06-T10) ----
    total = total + 1
    if test_lsc_add_variable() { passed = passed + 1 }

    total = total + 1
