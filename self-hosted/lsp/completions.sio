    var_count == 2 && fn_count == 1 && kw_count == 1 && mod_count == 0
}

// T70: lsc_dedup_completions removes duplicates
fn test_lsc_dedup() -> bool with Mut, Div, Panic {
    var list = lsp_completion_list_new()
    let i1 = lsp_completion_item_new(10, LSC_KIND_VARIABLE, 0, 50)
    let i2 = lsp_completion_item_new(10, LSC_KIND_VARIABLE, 0, 30)  // duplicate label
    let i3 = lsp_completion_item_new(20, LSC_KIND_FUNCTION, 0, 40)
    list = lsp_completion_list_add(list, i1)
    list = lsp_completion_list_add(list, i2)
    list = lsp_completion_list_add(list, i3)

    let deduped = lsc_dedup_completions(list)
    let ok_count = deduped.count == 2
    // First occurrence of label 10 is kept (prio 50)
    let ok_first = deduped.items[0].sort_priority == 50
    ok_count && ok_first
}

// T71: lsc_list_is_sorted detects sorted and unsorted lists
fn test_lsc_list_is_sorted() -> bool with Mut, Div, Panic {
    // Sorted list (descending)
    var sorted_list = lsp_completion_list_new()
    let s1 = lsp_completion_item_new(1, LSC_KIND_VARIABLE, 0, 100)
    let s2 = lsp_completion_item_new(2, LSC_KIND_VARIABLE, 0, 50)
    let s3 = lsp_completion_item_new(3, LSC_KIND_VARIABLE, 0, 10)
    sorted_list = lsp_completion_list_add(sorted_list, s1)
    sorted_list = lsp_completion_list_add(sorted_list, s2)
    sorted_list = lsp_completion_list_add(sorted_list, s3)
    let ok_sorted = lsc_list_is_sorted(sorted_list)

    // Unsorted list
    var unsorted_list = lsp_completion_list_new()
    let u1 = lsp_completion_item_new(1, LSC_KIND_VARIABLE, 0, 10)
    let u2 = lsp_completion_item_new(2, LSC_KIND_VARIABLE, 0, 100)
    unsorted_list = lsp_completion_list_add(unsorted_list, u1)
    unsorted_list = lsp_completion_list_add(unsorted_list, u2)
    let ok_unsorted = lsc_list_is_sorted(unsorted_list) == false

    ok_sorted && ok_unsorted
}

// T72: context_set_prefix sets prefix correctly
fn test_lsc_context_set_prefix() -> bool with Mut, Div, Panic {
    var ctx = lsc_context_new()
    var buf: [i8; 256] = [0; 256]
    buf[0] = 102  // 'f'
    buf[1] = 110  // 'n'
    ctx = lsc_context_set_prefix(ctx, buf, 2)
    let ok_len = ctx.prefix_len == 2
    let ok_f = ctx.prefix[0] == 102
    let ok_n = ctx.prefix[1] == 110
    ok_len && ok_f && ok_n
}

