fn test_lsc_snippet_struct() -> bool {
    let item = lsc_snippet_struct()
    let ok_kind = item.kind == LSC_KIND_SNIPPET
    let ok_label = item.label_hash == LSC_SNIPPET_STRUCT_ID
    ok_kind && ok_label
}

// T38: enum snippet
fn test_lsc_snippet_enum() -> bool {
    let item = lsc_snippet_enum()
    let ok_kind = item.kind == LSC_KIND_SNIPPET
    let ok_label = item.label_hash == LSC_SNIPPET_ENUM_ID
    ok_kind && ok_label
}

// T39: match snippet
fn test_lsc_snippet_match() -> bool {
    let item = lsc_snippet_match()
    let ok_kind = item.kind == LSC_KIND_SNIPPET
    let ok_label = item.label_hash == LSC_SNIPPET_MATCH_ID
    ok_kind && ok_label
}

// T40: if, while, for snippets
fn test_lsc_snippet_control_flow() -> bool {
    let if_item = lsc_snippet_if()
    let while_item = lsc_snippet_while()
    let for_item = lsc_snippet_for()
    let ok_if = if_item.kind == LSC_KIND_SNIPPET && if_item.label_hash == LSC_SNIPPET_IF_ID
    let ok_while = while_item.kind == LSC_KIND_SNIPPET && while_item.label_hash == LSC_SNIPPET_WHILE_ID
    let ok_for = for_item.kind == LSC_KIND_SNIPPET && for_item.label_hash == LSC_SNIPPET_FOR_ID
    ok_if && ok_while && ok_for
}

// -------------------------------------------------------
// Sorting / Filtering tests (T41-T45)
// -------------------------------------------------------

// T41: sort completions orders by priority descending
fn test_lsc_sort_basic() -> bool with Mut, Div, Panic {
    var list = lsp_completion_list_new()
    let i1 = lsp_completion_item_new(1, LSC_KIND_VARIABLE, 0, 10)
    let i2 = lsp_completion_item_new(2, LSC_KIND_VARIABLE, 0, 50)
    let i3 = lsp_completion_item_new(3, LSC_KIND_VARIABLE, 0, 30)
    list = lsp_completion_list_add(list, i1)
    list = lsp_completion_list_add(list, i2)
    list = lsp_completion_list_add(list, i3)

    let sorted = lsc_sort_completions(list)
    let ok_first = sorted.items[0].label_hash == 2   // prio 50
    let ok_second = sorted.items[1].label_hash == 3  // prio 30
    let ok_third = sorted.items[2].label_hash == 1   // prio 10
    ok_first && ok_second && ok_third
}

// T42: sort on already-sorted list is stable
fn test_lsc_sort_presorted() -> bool with Mut, Div, Panic {
    var list = lsp_completion_list_new()
    let i1 = lsp_completion_item_new(1, LSC_KIND_VARIABLE, 0, 100)
    let i2 = lsp_completion_item_new(2, LSC_KIND_VARIABLE, 0, 50)
    list = lsp_completion_list_add(list, i1)
    list = lsp_completion_list_add(list, i2)

    let sorted = lsc_sort_completions(list)
    let ok_first = sorted.items[0].label_hash == 1
    let ok_second = sorted.items[1].label_hash == 2
    ok_first && ok_second
}

// T43: filter completions truncates
fn test_lsc_filter_basic() -> bool with Mut, Div, Panic {
    var list = lsp_completion_list_new()
    var i: i64 = 0
    while i < 10 {
        let item = lsp_completion_item_new(i + 1, LSC_KIND_VARIABLE, 0, 0)
        list = lsp_completion_list_add(list, item)
        i = i + 1
    }

    let filtered = lsc_filter_completions(list, 5)
    let ok_count = filtered.count == 5
    let ok_incomplete = filtered.is_incomplete
    ok_count && ok_incomplete
}

// T44: filter completions does not truncate when under limit
fn test_lsc_filter_under_limit() -> bool with Mut, Div, Panic {
    var list = lsp_completion_list_new()
    let item = lsp_completion_item_new(1, LSC_KIND_VARIABLE, 0, 0)
    list = lsp_completion_list_add(list, item)

    let filtered = lsc_filter_completions(list, 10)
    let ok_count = filtered.count == 1
    let ok_complete = filtered.is_incomplete == false
    ok_count && ok_complete
}

// T45: merge completions combines two lists
fn test_lsc_merge_basic() -> bool with Mut, Div, Panic {
    var a = lsp_completion_list_new()
    let ia = lsp_completion_item_new(1, LSC_KIND_VARIABLE, 0, 10)
    a = lsp_completion_list_add(a, ia)

    var b = lsp_completion_list_new()
    let ib = lsp_completion_item_new(2, LSC_KIND_KEYWORD, 0, 5)
    b = lsp_completion_list_add(b, ib)

    let merged = lsc_merge_completions(a, b)
    let ok_count = merged.count == 2
    let ok_first = merged.items[0].label_hash == 1
    let ok_second = merged.items[1].label_hash == 2
    ok_count && ok_first && ok_second
}

// -------------------------------------------------------
// Integration tests (T46-T50)
// -------------------------------------------------------

// T46: provide_completions dispatches to dot completion
fn test_lsc_dispatch_dot_inner(p: &! LscProvider) -> bool with Mut, Div, Panic {
    let f1 = lsc_add_field(p, 200, 300, 400)

    var ctx = lsc_context_new()
    ctx.after_dot = true
    ctx.trigger_char = 400  // receiver_type

    let list = lsc_provide_completions(p, &ctx)
    let ok_count = list.count == 1
    let ok_kind = list.items[0].kind == LSC_KIND_FIELD
    ok_count && ok_kind
}
fn test_lsc_dispatch_dot() -> bool with Mut, Div, Panic {
