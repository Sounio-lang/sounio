// self-hosted::lsp::server — Sounio Language Server (stdio JSON-RPC)
//
// Pure-Sounio LSP entry point. Speaks LSP over stdin/stdout with
// Content-Length framing. Reads request envelopes, dispatches by method,
// emits framed responses.
//
// Surface (see tools/lsp/CHANGELOG.md for the full history):
//   - lifecycle: initialize / initialized / shutdown / exit
//   - sync: didOpen, didChange (incremental, kind=2), didClose, didSave
//   - language features: hover, completion, definition, references,
//     rename (+prepare), documentSymbol, documentHighlight, formatting,
//     rangeFormatting, onTypeFormatting, codeAction, codeLens,
//     signatureHelp, foldingRange, selectionRange, inlayHint (+resolve),
//     declaration, typeDefinition, implementation, callHierarchy,
//     documentLink, linkedEditingRange, pull diagnostics, executeCommand
//   - semantic tokens: full (resultId), full/delta, range
//   - type hierarchy: prepareTypeHierarchy, supertypes, subtypes
//   - workspace: symbol (open slots + *.sio scan under rootUri),
//     willRenameFiles, didChangeWatchedFiles/WorkspaceFolders/Configuration
//   - unknown method → error -32601 (MethodNotFound)
//
// Build: souc compile self-hosted/lsp/server.sio -o bin/sounio-lsp

// ============================================================================
// Buffers — fixed-size BSS, no heap
// ============================================================================

// Incoming JSON-RPC body (LSP spec recommends ≤ 1 MB; 256 KB plenty for v0)
var RX_BODY: [i8; 262144] = [0; 262144]
var RX_BODY_LEN: i64 = 0

// One-byte scratch for byte-at-a-time stdin reads — used by line reader so
// we never over-read past the header terminator into the body
var RX_ONE: [i8; 1] = [0; 1]

// Header line buffer (RFC 4180-ish, but LSP headers stay short)
var RX_LINE: [i8; 1024] = [0; 1024]
var RX_LINE_LEN: i64 = 0

// Outgoing response body
var TX_BODY: [i8; 262144] = [0; 262144]
var TX_BODY_LEN: i64 = 0

// Header scratch (Content-Length: NNNNN\r\n\r\n)
var TX_HEAD: [i8; 64] = [0; 64]
var TX_HEAD_LEN: i64 = 0

// Last seen request id (echoed in responses)
var LAST_ID_NUM: i64 = 0       // numeric id, if any
var LAST_ID_IS_STR: i64 = 0    // 1 if id was a string
var LAST_ID_STR: [i8; 64] = [0; 64]
var LAST_ID_STR_LEN: i64 = 0
var LAST_ID_PRESENT: i64 = 0

// Method classification
let M_UNKNOWN:       i64 = 0
let M_INITIALIZE:    i64 = 1
let M_INITIALIZED:   i64 = 2
let M_SHUTDOWN:      i64 = 3
let M_EXIT:          i64 = 4
let M_DID_OPEN:      i64 = 10
let M_DID_CHANGE:    i64 = 11
let M_DID_CLOSE:     i64 = 12
let M_DID_SAVE:      i64 = 13
let M_HOVER:         i64 = 20
let M_COMPLETION:    i64 = 21
let M_DEFINITION:    i64 = 22
let M_REFERENCES:    i64 = 23
let M_RENAME:        i64 = 24
let M_CODE_ACTION:   i64 = 25
let M_SEM_TOKENS:    i64 = 26
let M_FORMATTING:    i64 = 27
let M_DOC_SYMBOL:    i64 = 28
let M_DOC_HIGHLIGHT: i64 = 29
let M_PREPARE_RENAME: i64 = 30
let M_SIGNATURE_HELP: i64 = 31
let M_FOLDING_RANGE: i64 = 32
let M_WORKSPACE_SYMBOL: i64 = 33
let M_SELECTION_RANGE: i64 = 34
let M_INLAY_HINT: i64 = 35
let M_DECLARATION: i64 = 36
let M_TYPE_DEFINITION: i64 = 37
let M_IMPLEMENTATION: i64 = 38
let M_PREPARE_CALL_HIERARCHY: i64 = 39
let M_INCOMING_CALLS: i64 = 40
let M_OUTGOING_CALLS: i64 = 41
let M_DOCUMENT_LINK: i64 = 42
let M_ON_TYPE_FORMATTING: i64 = 43
let M_RANGE_FORMATTING: i64 = 44
let M_CANCEL_REQUEST: i64 = 45
let M_DID_CHANGE_WATCHED_FILES: i64 = 46
let M_DID_CHANGE_WORKSPACE_FOLDERS: i64 = 47
let M_DID_CHANGE_CONFIGURATION: i64 = 48
let M_CODE_LENS: i64 = 49
let M_EXECUTE_COMMAND: i64 = 50
let M_WILL_RENAME_FILES: i64 = 51
let M_PULL_DIAGNOSTIC: i64 = 52
let M_LINKED_EDITING: i64 = 53
let M_INLAY_HINT_RESOLVE: i64 = 54
let M_SEM_TOKENS_RANGE: i64 = 55
let M_SEM_TOKENS_DELTA: i64 = 56
let M_PREPARE_TYPE_HIERARCHY: i64 = 57
let M_TYPE_H_SUPERTYPES: i64 = 58
let M_TYPE_H_SUBTYPES: i64 = 59

// Shutdown state machine — LSP requires shutdown before exit
var SAW_SHUTDOWN: i64 = 0

// ============================================================================
// Diagnostics state
// ============================================================================

// argv / envp for fork+execve. 8 slots covers both `souc <src> <out>`
// (check pipeline) and `souc inspect --pos L:C <src>` (hover fallback).
// Static slots — only one subprocess at a time per server (single-
// threaded).
var ARGV: [i64; 8] = [0; 8]
var ENVP: [i64; 1] = [0; 1]

// "LINE:COL\0" arg buffer used by `souc inspect`.
var POS_ARG: [i8; 32] = [0; 32]

// Null-terminated copy of IDENT_BUF for use as argv arg.
var IDENT_ARG: [i8; 130] = [0; 130]

// Null-terminated absolute path derived from DOC_URI ("file://..."
// stripped + percent-decoded), used as the source arg to `souc inspect
// --resolve`. Lets the resolver walk up from the user's project dir
// instead of from /tmp.
var URI_PATH_ARG: [i8; 1024] = [0; 1024]
var URI_PATH_ARG_LEN: i64 = 0

// stdout capture buffer for inspect.
var INSPECT_RAW: [i8; 8192] = [0; 8192]
var INSPECT_RAW_LEN: i64 = 0

// Most recent inspect signature (for --pos hover use).
var INSPECT_SIG: [i8; 1024] = [0; 1024]
var INSPECT_SIG_LEN: i64 = 0

// Most recent --resolve result.
var RESOLVED_FILE: [i8; 1024] = [0; 1024]
var RESOLVED_FILE_LEN: i64 = 0
var RESOLVED_LINE: i64 = 0
var RESOLVED_CHAR: i64 = 0
var RESOLVED_FOUND: i64 = 0

// Active document (the one the current request is about). This is
// populated either by `extract_doc_text` / `extract_doc_uri` on
// didOpen/didChange, or by `activate_uri_slot` before serving hover
// / definition / references / rename — see the multi-document store
// below.
var DOC_TEXT: [i8; 262144] = [0; 262144]
var DOC_TEXT_LEN: i64 = 0

var DOC_URI: [i8; 1024] = [0; 1024]
var DOC_URI_LEN: i64 = 0

// ----------------------------------------------------------------------------
// Multi-document store
// ----------------------------------------------------------------------------
//
// Per-URI buffers held in BSS. Slot count × per-slot capacity = total
// memory; 8 × 256 KB text + 8 × 1 KB URI = 2 MB. Plenty for v0; bump
// DOC_SLOT_COUNT if your editor opens more than 8 .sio files at once.
//
// Storage layout:
//   DOC_SLOT_URI [slot * 1024  + k]  =  URI byte k
//   DOC_SLOT_TEXT[slot * 262144 + k] =  text byte k
//
// Sounio doesn't (yet) give us pointer arithmetic into multi-row 2D
// arrays cheaply, so we flatten into one big i8 array and do the
// addressing by hand.

let DOC_SLOT_COUNT:    i64 = 8
let DOC_SLOT_URI_CAP:  i64 = 1024
let DOC_SLOT_TEXT_CAP: i64 = 262144

var DOC_SLOT_USED:     [i64; 8] = [0; 8]
var DOC_SLOT_URI_LEN:  [i64; 8] = [0; 8]
var DOC_SLOT_TEXT_LEN: [i64; 8] = [0; 8]
var DOC_SLOT_URI:      [i8; 8192]    = [0; 8192]      // 8 * 1024
var DOC_SLOT_TEXT:     [i8; 2097152] = [0; 2097152]   // 8 * 262144

// Compiler stderr capture (read back after fork+exec)
var DIAG_RAW: [i8; 65536] = [0; 65536]
var DIAG_RAW_LEN: i64 = 0

// Parsed diagnostics: parallel arrays, fixed 64 max
let DIAG_MAX: i64 = 64
var DIAG_LINE:   [i64; 64] = [0; 64]
var DIAG_MSG_OFF: [i64; 64] = [0; 64]  // byte offsets into DIAG_MSG_BUF
var DIAG_MSG_LEN: [i64; 64] = [0; 64]
var DIAG_MSG_BUF: [i8; 16384] = [0; 16384]
var DIAG_MSG_BUF_LEN: i64 = 0
var DIAG_COUNT: i64 = 0

// Paths used by the check pipeline. Single fixed path is fine for v0
// (server is single-threaded). NOTE: Sounio's `let X: string = "..."`
// does not currently produce a pointer that survives the `as i64` cast
// or being passed to builtins, so we inline the literals at each use
// site below.

// ============================================================================
// Low-level I/O — syscall6 wrappers
// ============================================================================

// write(fd=2 stderr, str, len) — log helper
fn log_stderr(msg: string) with IO, Mut, Panic {
    let n = str_len(msg)
    syscall6(1, 2, msg, n, 0, 0, 0)
}

fn log_stderr_nl(msg: string) with IO, Mut, Panic {
    log_stderr(msg)
    syscall6(1, 2, "\n", 1, 0, 0, 0)
}

// ============================================================================
// Header parsing — read "Content-Length: N\r\n\r\n", return N
// ============================================================================

// Read one CRLF-terminated header line into RX_LINE. Strips the CRLF (or LF
// alone). Returns line length (0 = empty line / end of headers, -1 = EOF).
fn read_header_line() -> i64 with IO, Mut, Panic {
    RX_LINE_LEN = 0
    var saw_any: i64 = 0
    var done: i64 = 0
    while done == 0 {
        let r = syscall6(0, 0, &! RX_ONE, 1, 0, 0, 0)
        if r <= 0 {
            if saw_any == 0 { return 0 - 1 }
            done = 1
        } else {
            saw_any = 1
            let b = RX_ONE[0] as i64
            if b == 10 { done = 1 }
            else if RX_LINE_LEN < 1024 {
                RX_LINE[RX_LINE_LEN as usize] = b as i8
                RX_LINE_LEN = RX_LINE_LEN + 1
            }
        }
    }
    // Strip trailing CR if present
    if RX_LINE_LEN > 0 && (RX_LINE[(RX_LINE_LEN - 1) as usize] as i64) == 13 {
        RX_LINE_LEN = RX_LINE_LEN - 1
    }
    return RX_LINE_LEN
}

// Compare a prefix of RX_LINE against an ASCII literal, case-insensitive.
fn line_starts_with_ci(prefix: string) -> bool with Mut, Panic {
    let np = str_len(prefix)
    if RX_LINE_LEN < np { return false }
    var i: i64 = 0
    while i < np {
        let a = to_lower(RX_LINE[i as usize] as i64)
        let b = to_lower(str_char_at(prefix, i))
        if a != b { return false }
        i = i + 1
    }
    return true
}

// Parse a non-negative decimal i64 from RX_LINE starting at `off`. Returns -1
// if no digits found.
fn line_parse_i64_after(off: i64) -> i64 with Mut, Panic, Div {
    var i = off
    while i < RX_LINE_LEN {
        let c = RX_LINE[i as usize] as i64
        if c != 32 && c != 9 { break }
        i = i + 1
    }
    var val: i64 = 0
    var any: i64 = 0
    while i < RX_LINE_LEN {
        let c = RX_LINE[i as usize] as i64
        if c < 48 || c > 57 { break }
        val = val * 10 + (c - 48)
        any = 1
        i = i + 1
    }
    if any == 0 { return 0 - 1 }
    return val
}

// Returns content length, or -1 on EOF/error
fn read_headers() -> i64 with IO, Mut, Panic, Div {
    var content_length: i64 = 0 - 1
    var done: i64 = 0
    while done == 0 {
        let n = read_header_line()
        if n < 0 { return 0 - 1 }
        if n == 0 { done = 1 }
        else if line_starts_with_ci("Content-Length:") {
            content_length = line_parse_i64_after(15)
        }
    }
    return content_length
}

// Read `n` bytes from stdin into RX_BODY. Byte-at-a-time so partial reads
// don't overwrite earlier bytes (no pointer arithmetic in v0 Sounio).
fn read_body(n: i64) -> i64 with IO, Mut, Panic, Div {
    var got: i64 = 0
    while got < n {
        let r = syscall6(0, 0, &! RX_ONE, 1, 0, 0, 0)
        if r <= 0 { RX_BODY_LEN = got; return got }
        if got < 262144 {
            RX_BODY[got as usize] = RX_ONE[0]
        }
        got = got + 1
    }
    RX_BODY_LEN = got
    return got
}

// ============================================================================
// Tiny string utils — case-insensitive prefix + integer parse from offset
// ============================================================================

fn to_lower(b: i64) -> i64 {
    if b >= 65 && b <= 90 { b + 32 } else { b }
}

fn starts_with_ci(s: string, prefix: string) -> bool with Mut, Panic {
    let ns = str_len(s)
    let np = str_len(prefix)
    if ns < np { return false }
    var i: i64 = 0
    while i < np {
        if to_lower(str_char_at(s, i)) != to_lower(str_char_at(prefix, i)) {
            return false
        }
        i = i + 1
    }
    true
}

fn parse_i64_after(s: string, off: i64) -> i64 with Mut, Panic, Div {
    let n = str_len(s)
    var i = off
    // skip whitespace
    while i < n {
        let c = str_char_at(s, i)
        if c != 32 && c != 9 { break }
        i = i + 1
    }
    var val: i64 = 0
    var any: i64 = 0
    while i < n {
        let c = str_char_at(s, i)
        if c < 48 || c > 57 { break }
        val = val * 10 + (c - 48)
        any = 1
        i = i + 1
    }
    if any == 0 { return 0 - 1 }
    return val
}

// ============================================================================
// Method classification — substring scan of the request body
// ============================================================================
//
// LSP request envelopes look like:
//   {"jsonrpc":"2.0","id":42,"method":"initialize","params":{...}}
//
// We don't need a real JSON parser for v0 — we just look for:
//   "method":"<name>"
//   "id":<num>  or  "id":"<str>"
//
// This is unsafe against escaped quotes inside string values, but
// LSP method names are well-known ASCII and the id is always early
// in the envelope. Promote to a proper parser when we wire features.

fn body_find(needle: string, start: i64) -> i64 with Mut, Panic {
    let bn = RX_BODY_LEN
    let nl = str_len(needle)
    if nl == 0 { return 0 - 1 }
    var i = start
    while i + nl <= bn {
        var k: i64 = 0
        var ok: i64 = 1
        while k < nl {
            let bb = RX_BODY[(i + k) as usize] as i64
            let nb = str_char_at(needle, k)
            if bb != nb { ok = 0; k = nl; }
            else { k = k + 1 }
        }
        if ok == 1 { return i }
        i = i + 1
    }
    0 - 1
}

// Extract the string value following the first occurrence of key in the body.
// Writes the value bytes into `out` (max `cap` bytes), returns length, or -1.
fn body_extract_str(key: string, out: &![i8; 64], cap: i64) -> i64 with Mut, Panic {
    let pos = body_find(key, 0)
    if pos < 0 { return 0 - 1 }
    // After the key we expect: optional ws, ':', ws, '"', value, '"'
    var i = pos + str_len(key)
    while i < RX_BODY_LEN {
        let c = RX_BODY[i as usize] as i64
        if c == 34 { i = i + 1; break }       // opening quote
        i = i + 1
    }
    var n: i64 = 0
    while i < RX_BODY_LEN && n < cap {
        let c = RX_BODY[i as usize] as i64
        if c == 34 { return n }                // closing quote
        if c == 92 {                           // escape — skip pair
            i = i + 2
            continue
        }
        out[n as usize] = c as i8
        n = n + 1
        i = i + 1
    }
    n
}

fn classify_method() -> i64 with Mut, Panic {
    var name: [i8; 64] = [0; 64]
    let nlen = body_extract_str("\"method\"", &! name, 64)
    if nlen <= 0 { return M_UNKNOWN }
    let s = str_from_bytes(name, nlen)
    if str_eq(s, "initialize")                      { return M_INITIALIZE  }
    if str_eq(s, "initialized")                     { return M_INITIALIZED }
    if str_eq(s, "shutdown")                        { return M_SHUTDOWN    }
    if str_eq(s, "exit")                            { return M_EXIT        }
    if str_eq(s, "textDocument/didOpen")            { return M_DID_OPEN    }
    if str_eq(s, "textDocument/didChange")          { return M_DID_CHANGE  }
    if str_eq(s, "textDocument/didClose")           { return M_DID_CLOSE   }
    if str_eq(s, "textDocument/didSave")            { return M_DID_SAVE    }
    if str_eq(s, "textDocument/hover")              { return M_HOVER       }
    if str_eq(s, "textDocument/completion")         { return M_COMPLETION  }
    if str_eq(s, "textDocument/definition")         { return M_DEFINITION  }
    if str_eq(s, "textDocument/references")         { return M_REFERENCES  }
    if str_eq(s, "textDocument/rename")             { return M_RENAME      }
    if str_eq(s, "textDocument/codeAction")         { return M_CODE_ACTION }
    if str_eq(s, "textDocument/semanticTokens/full") { return M_SEM_TOKENS }
    if str_eq(s, "textDocument/semanticTokens/full/delta") { return M_SEM_TOKENS_DELTA }
    if str_eq(s, "textDocument/semanticTokens/range") { return M_SEM_TOKENS_RANGE }
    if str_eq(s, "textDocument/formatting")         { return M_FORMATTING  }
    if str_eq(s, "textDocument/documentSymbol")     { return M_DOC_SYMBOL  }
    if str_eq(s, "textDocument/documentHighlight")  { return M_DOC_HIGHLIGHT }
    if str_eq(s, "textDocument/prepareRename")      { return M_PREPARE_RENAME }
    if str_eq(s, "textDocument/signatureHelp")      { return M_SIGNATURE_HELP }
    if str_eq(s, "textDocument/foldingRange")       { return M_FOLDING_RANGE }
    if str_eq(s, "workspace/symbol")                { return M_WORKSPACE_SYMBOL }
    if str_eq(s, "textDocument/selectionRange")     { return M_SELECTION_RANGE }
    if str_eq(s, "textDocument/inlayHint")          { return M_INLAY_HINT }
    if str_eq(s, "textDocument/declaration")        { return M_DECLARATION }
    if str_eq(s, "textDocument/typeDefinition")     { return M_TYPE_DEFINITION }
    if str_eq(s, "textDocument/implementation")     { return M_IMPLEMENTATION }
    if str_eq(s, "textDocument/prepareCallHierarchy") { return M_PREPARE_CALL_HIERARCHY }
    if str_eq(s, "callHierarchy/incomingCalls")     { return M_INCOMING_CALLS }
    if str_eq(s, "callHierarchy/outgoingCalls")     { return M_OUTGOING_CALLS }
    if str_eq(s, "textDocument/documentLink")       { return M_DOCUMENT_LINK }
    if str_eq(s, "textDocument/onTypeFormatting")   { return M_ON_TYPE_FORMATTING }
    if str_eq(s, "textDocument/rangeFormatting")    { return M_RANGE_FORMATTING }
    if str_eq(s, "$/cancelRequest")                 { return M_CANCEL_REQUEST }
    if str_eq(s, "workspace/didChangeWatchedFiles") { return M_DID_CHANGE_WATCHED_FILES }
    if str_eq(s, "workspace/didChangeWorkspaceFolders") { return M_DID_CHANGE_WORKSPACE_FOLDERS }
    if str_eq(s, "workspace/didChangeConfiguration") { return M_DID_CHANGE_CONFIGURATION }
    if str_eq(s, "textDocument/codeLens")           { return M_CODE_LENS }
    if str_eq(s, "workspace/executeCommand")        { return M_EXECUTE_COMMAND }
    if str_eq(s, "workspace/willRenameFiles")       { return M_WILL_RENAME_FILES }
    if str_eq(s, "textDocument/diagnostic")         { return M_PULL_DIAGNOSTIC }
    if str_eq(s, "textDocument/linkedEditingRange") { return M_LINKED_EDITING }
    if str_eq(s, "inlayHint/resolve")               { return M_INLAY_HINT_RESOLVE }
    if str_eq(s, "textDocument/prepareTypeHierarchy") { return M_PREPARE_TYPE_HIERARCHY }
    if str_eq(s, "typeHierarchy/supertypes")        { return M_TYPE_H_SUPERTYPES }
    if str_eq(s, "typeHierarchy/subtypes")          { return M_TYPE_H_SUBTYPES }
    M_UNKNOWN
}

// Capture the id (numeric or string). Stored in LAST_ID_* globals.
fn capture_id() with Mut, Panic, Div {
    LAST_ID_PRESENT = 0
    LAST_ID_IS_STR = 0
    LAST_ID_NUM = 0
    LAST_ID_STR_LEN = 0
    let pos = body_find("\"id\"", 0)
    if pos < 0 { return }
    var i = pos + 4
    // skip ws + ':'
    while i < RX_BODY_LEN {
        let c = RX_BODY[i as usize] as i64
        if c == 58 { i = i + 1; break }
        i = i + 1
    }
    while i < RX_BODY_LEN {
        let c = RX_BODY[i as usize] as i64
        if c != 32 && c != 9 { break }
        i = i + 1
    }
    if i >= RX_BODY_LEN { return }
    let first = RX_BODY[i as usize] as i64
    if first == 34 {
        // string id
        LAST_ID_IS_STR = 1
        LAST_ID_PRESENT = 1
        i = i + 1
        var n: i64 = 0
        while i < RX_BODY_LEN && n < 64 {
            let c = RX_BODY[i as usize] as i64
            if c == 34 { break }
            LAST_ID_STR[n as usize] = c as i8
            n = n + 1
            i = i + 1
        }
        LAST_ID_STR_LEN = n
    } else if first >= 48 && first <= 57 {
        LAST_ID_IS_STR = 0
        LAST_ID_PRESENT = 1
        var v: i64 = 0
        while i < RX_BODY_LEN {
            let c = RX_BODY[i as usize] as i64
            if c < 48 || c > 57 { break }
            v = v * 10 + (c - 48)
            i = i + 1
        }
        LAST_ID_NUM = v
    }
}

// ============================================================================
// TX_BODY builder helpers
// ============================================================================

fn tx_reset() with Mut { TX_BODY_LEN = 0 }

fn tx_putc(b: i64) with Mut, Panic {
    if TX_BODY_LEN < 262144 {
        TX_BODY[TX_BODY_LEN as usize] = b as i8
        TX_BODY_LEN = TX_BODY_LEN + 1
    }
}

fn tx_puts(s: string) with Mut, Panic {
    let n = str_len(s)
    var i: i64 = 0
    while i < n { tx_putc(str_char_at(s, i)); i = i + 1 }
}

fn tx_put_i64(v: i64) with Mut, Panic, Div {
    if v == 0 { tx_putc(48); return }
    var n = v
    var neg: i64 = 0
    if n < 0 { neg = 1; n = 0 - n }
    var rev: [i8; 24] = [0; 24]
    var rl: i64 = 0
    while n > 0 {
        rev[rl as usize] = (48 + n % 10) as i8
        rl = rl + 1
        n = n / 10
    }
    if neg == 1 { tx_putc(45) }
    var i = rl - 1
    while i >= 0 {
        tx_putc(rev[i as usize] as i64)
        if i == 0 { break }
        i = i - 1
    }
}

// Emit "id":<id> using the captured id. Skips emission if no id was present.
fn tx_emit_id() with Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    tx_puts("\"id\":")
    if LAST_ID_IS_STR == 1 {
        tx_putc(34)
        var i: i64 = 0
        while i < LAST_ID_STR_LEN {
            tx_putc(LAST_ID_STR[i as usize] as i64)
            i = i + 1
        }
        tx_putc(34)
    } else {
        tx_put_i64(LAST_ID_NUM)
    }
}

// ============================================================================
// Frame writer — emit Content-Length header + body to stdout
// ============================================================================

fn write_frame() with IO, Mut, Panic, Div {
    // Header: "Content-Length: N\r\n\r\n"
    TX_HEAD_LEN = 0
    let h = "Content-Length: "
    let hn = str_len(h)
    var i: i64 = 0
    while i < hn {
        TX_HEAD[TX_HEAD_LEN as usize] = str_char_at(h, i) as i8
        TX_HEAD_LEN = TX_HEAD_LEN + 1
        i = i + 1
    }
    // length digits
    var n = TX_BODY_LEN
    if n == 0 {
        TX_HEAD[TX_HEAD_LEN as usize] = 48 as i8
        TX_HEAD_LEN = TX_HEAD_LEN + 1
    } else {
        var rev: [i8; 24] = [0; 24]
        var rl: i64 = 0
        while n > 0 {
            rev[rl as usize] = (48 + n % 10) as i8
            rl = rl + 1
            n = n / 10
        }
        var j = rl - 1
        while j >= 0 {
            TX_HEAD[TX_HEAD_LEN as usize] = rev[j as usize]
            TX_HEAD_LEN = TX_HEAD_LEN + 1
            if j == 0 { break }
            j = j - 1
        }
    }
    TX_HEAD[TX_HEAD_LEN as usize] = 13 as i8; TX_HEAD_LEN = TX_HEAD_LEN + 1
    TX_HEAD[TX_HEAD_LEN as usize] = 10 as i8; TX_HEAD_LEN = TX_HEAD_LEN + 1
    TX_HEAD[TX_HEAD_LEN as usize] = 13 as i8; TX_HEAD_LEN = TX_HEAD_LEN + 1
    TX_HEAD[TX_HEAD_LEN as usize] = 10 as i8; TX_HEAD_LEN = TX_HEAD_LEN + 1

    // Write header then body to stdout (fd=1)
    syscall6(1, 1, &! TX_HEAD, TX_HEAD_LEN, 0, 0, 0)
    syscall6(1, 1, &! TX_BODY, TX_BODY_LEN, 0, 0, 0)
}

// ============================================================================
// Response builders
// ============================================================================

// ============================================================================
// Multi-document store — slot helpers
// ============================================================================

// True if DOC_SLOT_URI for `slot` byte-equals DOC_URI[0..DOC_URI_LEN].
fn slot_uri_eq(slot: i64) -> bool with Mut, Panic {
    if DOC_SLOT_USED[slot as usize] == 0 { return false }
    if DOC_SLOT_URI_LEN[slot as usize] != DOC_URI_LEN { return false }
    let base = slot * 1024
    var i: i64 = 0
    while i < DOC_URI_LEN {
        if (DOC_SLOT_URI[(base + i) as usize] as i64) != (DOC_URI[i as usize] as i64) {
            return false
        }
        i = i + 1
    }
    return true
}

// Linear search for a slot matching the active DOC_URI. Returns slot
// index, or -1 if not present.
fn slot_find_by_uri() -> i64 with Mut, Panic {
    var s: i64 = 0
    while s < DOC_SLOT_COUNT {
        if slot_uri_eq(s) == true { return s }
        s = s + 1
    }
    return 0 - 1
}

// Allocate (or reuse) a slot for DOC_URI. Strategy: prefer first
// unused; if all are used, evict slot 0 (FIFO would be nicer; v0
// is fine). Copies the active DOC_URI into the slot.
fn slot_alloc_for_uri() -> i64 with Mut, Panic {
    var s: i64 = 0
    while s < DOC_SLOT_COUNT {
        if DOC_SLOT_USED[s as usize] == 0 { break }
        s = s + 1
    }
    if s >= DOC_SLOT_COUNT { s = 0 }
    let base = s * 1024
    var i: i64 = 0
    while i < DOC_URI_LEN && i < 1024 {
        DOC_SLOT_URI[(base + i) as usize] = DOC_URI[i as usize]
        i = i + 1
    }
    DOC_SLOT_URI_LEN[s as usize] = DOC_URI_LEN
    DOC_SLOT_USED[s as usize] = 1
    DOC_SLOT_TEXT_LEN[s as usize] = 0
    return s
}

// Copy active DOC_TEXT[0..DOC_TEXT_LEN] into slot `slot`. Caller
// guarantees slot is in use.
fn slot_set_text(slot: i64) with Mut, Panic {
    let base = slot * 262144
    var i: i64 = 0
    while i < DOC_TEXT_LEN && i < 262144 {
        DOC_SLOT_TEXT[(base + i) as usize] = DOC_TEXT[i as usize]
        i = i + 1
    }
    DOC_SLOT_TEXT_LEN[slot as usize] = DOC_TEXT_LEN
}

// Mark slot empty.
fn slot_release(slot: i64) with Mut, Panic {
    DOC_SLOT_USED[slot as usize] = 0
    DOC_SLOT_URI_LEN[slot as usize] = 0
    DOC_SLOT_TEXT_LEN[slot as usize] = 0
}

// Copy slot's URI + text back into the active DOC_URI / DOC_TEXT so
// the existing handler pipeline (hover, definition, references,
// rename) can operate on it unchanged.
fn slot_activate(slot: i64) with Mut, Panic {
    if DOC_SLOT_USED[slot as usize] == 0 { return }
    let ubase = slot * 1024
    let tbase = slot * 262144
    let ulen = DOC_SLOT_URI_LEN[slot as usize]
    let tlen = DOC_SLOT_TEXT_LEN[slot as usize]
    DOC_URI_LEN = ulen
    var i: i64 = 0
    while i < ulen && i < 1024 {
        DOC_URI[i as usize] = DOC_SLOT_URI[(ubase + i) as usize]
        i = i + 1
    }
    DOC_TEXT_LEN = tlen
    var j: i64 = 0
    while j < tlen && j < 262144 {
        DOC_TEXT[j as usize] = DOC_SLOT_TEXT[(tbase + j) as usize]
        j = j + 1
    }
}

// Convenience: parse params.textDocument.uri from RX_BODY, find or
// alloc a slot, activate it. Returns slot index or -1 if no URI in
// the request.
fn activate_uri_slot() -> i64 with Mut, Panic {
    if extract_doc_uri() < 0 { return 0 - 1 }
    let s = slot_find_by_uri()
    if s < 0 { return 0 - 1 }
    slot_activate(s)
    return s
}

// ============================================================================
// Diagnostics pipeline
// ============================================================================

// Extract the body field (textDocument.text or contentChanges[0].text) into
// DOC_TEXT. Decodes the common JSON string escapes we care about (\n, \r,
// \t, \", \\, \uXXXX for the ASCII subset). Returns DOC_TEXT_LEN, or -1 if
// no text field is found.
fn extract_doc_text() -> i64 with Mut, Panic, Div {
    DOC_TEXT_LEN = 0
    let pos = body_find("\"text\"", 0)
    if pos < 0 { return 0 - 1 }
    var i = pos + 6
    // skip ws + ':' + ws + '"'
    var saw_quote: i64 = 0
    while i < RX_BODY_LEN && saw_quote == 0 {
        let c = RX_BODY[i as usize] as i64
        if c == 34 { saw_quote = 1 }
        i = i + 1
    }
    if saw_quote == 0 { return 0 - 1 }
    while i < RX_BODY_LEN && DOC_TEXT_LEN < 262144 {
        let c = RX_BODY[i as usize] as i64
        if c == 34 { return DOC_TEXT_LEN }
        if c == 92 && i + 1 < RX_BODY_LEN {
            let n = RX_BODY[(i + 1) as usize] as i64
            if n == 110     { DOC_TEXT[DOC_TEXT_LEN as usize] = 10 as i8; DOC_TEXT_LEN = DOC_TEXT_LEN + 1; i = i + 2 }
            else if n == 114 { DOC_TEXT[DOC_TEXT_LEN as usize] = 13 as i8; DOC_TEXT_LEN = DOC_TEXT_LEN + 1; i = i + 2 }
            else if n == 116 { DOC_TEXT[DOC_TEXT_LEN as usize] = 9  as i8; DOC_TEXT_LEN = DOC_TEXT_LEN + 1; i = i + 2 }
            else if n == 34  { DOC_TEXT[DOC_TEXT_LEN as usize] = 34 as i8; DOC_TEXT_LEN = DOC_TEXT_LEN + 1; i = i + 2 }
            else if n == 92  { DOC_TEXT[DOC_TEXT_LEN as usize] = 92 as i8; DOC_TEXT_LEN = DOC_TEXT_LEN + 1; i = i + 2 }
            else if n == 47  { DOC_TEXT[DOC_TEXT_LEN as usize] = 47 as i8; DOC_TEXT_LEN = DOC_TEXT_LEN + 1; i = i + 2 }
            else if n == 117 {
                // \uXXXX — decode 4 hex digits, drop high byte for v0
                if i + 5 >= RX_BODY_LEN { return DOC_TEXT_LEN }
                var v: i64 = 0
                var k: i64 = 0
                while k < 4 {
                    let h = RX_BODY[(i + 2 + k) as usize] as i64
                    var d: i64 = 0
                    if h >= 48 && h <= 57 { d = h - 48 }
                    else if h >= 97 && h <= 102 { d = h - 87 }
                    else if h >= 65 && h <= 70 { d = h - 55 }
                    v = v * 16 + d
                    k = k + 1
                }
                DOC_TEXT[DOC_TEXT_LEN as usize] = (v % 256) as i8
                DOC_TEXT_LEN = DOC_TEXT_LEN + 1
                i = i + 6
            } else {
                DOC_TEXT[DOC_TEXT_LEN as usize] = n as i8
                DOC_TEXT_LEN = DOC_TEXT_LEN + 1
                i = i + 2
            }
        } else {
            DOC_TEXT[DOC_TEXT_LEN as usize] = c as i8
            DOC_TEXT_LEN = DOC_TEXT_LEN + 1
            i = i + 1
        }
    }
    return DOC_TEXT_LEN
}

// Extract the document URI ("uri": "...") into DOC_URI. Returns length, -1
// if missing.
fn extract_doc_uri() -> i64 with Mut, Panic {
    DOC_URI_LEN = 0
    let pos = body_find("\"uri\"", 0)
    if pos < 0 { return 0 - 1 }
    var i = pos + 5
    var saw_quote: i64 = 0
    while i < RX_BODY_LEN && saw_quote == 0 {
        let c = RX_BODY[i as usize] as i64
        if c == 34 { saw_quote = 1 }
        i = i + 1
    }
    if saw_quote == 0 { return 0 - 1 }
    while i < RX_BODY_LEN && DOC_URI_LEN < 1024 {
        let c = RX_BODY[i as usize] as i64
        if c == 34 { return DOC_URI_LEN }
        if c == 92 && i + 1 < RX_BODY_LEN {
            // crude escape skip — URIs almost never contain escapes in practice
            i = i + 2
        } else {
            DOC_URI[DOC_URI_LEN as usize] = c as i8
            DOC_URI_LEN = DOC_URI_LEN + 1
            i = i + 1
        }
    }
    return DOC_URI_LEN
}

// fork + execve souc on TMP_DOC_PATH; stderr+stdout → TMP_ERR_PATH. Blocks
// in wait4. Returns 0 on success, -1 on fork failure.
fn run_souc_check() -> i64 with IO, Mut, Panic {
    ARGV[0] = "./bin/souc-linux-x86_64" as i64
    ARGV[1] = "/tmp/sounio_lsp_doc.sio" as i64
    ARGV[2] = "/tmp/sounio_lsp_out.elf" as i64
    ARGV[3] = 0
    ENVP[0] = 0

    let pid = syscall6(57, 0, 0, 0, 0, 0, 0)
    if pid < 0 { return 0 - 1 }
    if pid == 0 {
        // child: redirect stderr+stdout to err file, exec
        let fd = syscall6(2, "/tmp/sounio_lsp_err.txt", 577, 420, 0, 0, 0)
        if fd >= 0 {
            syscall6(33, fd, 1, 0, 0, 0, 0)
            syscall6(33, fd, 2, 0, 0, 0, 0)
            syscall6(3, fd, 0, 0, 0, 0, 0)
        }
        syscall6(59, "./bin/souc-linux-x86_64" as i64, &! ARGV, &! ENVP, 0, 0, 0)
        syscall6(60, 127, 0, 0, 0, 0, 0)
    }
    syscall6(61, pid, 0, 0, 0, 0, 0)
    return 0
}

// ----------------------------------------------------------------------------
// Inspect — souc inspect --pos LINE:COL <src> via fork+execve
// ----------------------------------------------------------------------------

// Format `LINE:COL\0` into POS_ARG. Returns nothing (callers pass the
// buffer address into ARGV).
fn format_pos_arg(line: i64, col: i64) with Mut, Panic, Div {
    var p: i64 = 0
    // line digits
    if line == 0 {
        POS_ARG[p as usize] = 48 as i8
        p = p + 1
    } else {
        var v = line
        var rev: [i8; 16] = [0; 16]
        var rl: i64 = 0
        while v > 0 {
            rev[rl as usize] = (48 + v % 10) as i8
            rl = rl + 1
            v = v / 10
        }
        var i = rl - 1
        while i >= 0 {
            POS_ARG[p as usize] = rev[i as usize]
            p = p + 1
            if i == 0 { break }
            i = i - 1
        }
    }
    POS_ARG[p as usize] = 58 as i8   // ':'
    p = p + 1
    // col digits
    if col == 0 {
        POS_ARG[p as usize] = 48 as i8
        p = p + 1
    } else {
        var v = col
        var rev: [i8; 16] = [0; 16]
        var rl: i64 = 0
        while v > 0 {
            rev[rl as usize] = (48 + v % 10) as i8
            rl = rl + 1
            v = v / 10
        }
        var i = rl - 1
        while i >= 0 {
            POS_ARG[p as usize] = rev[i as usize]
            p = p + 1
            if i == 0 { break }
            i = i - 1
        }
    }
    POS_ARG[p as usize] = 0 as i8    // null terminator
}

// fork + exec `./bin/souc inspect --pos LINE:COL /tmp/sounio_lsp_doc.sio`
// with stdout (and stderr) captured to /tmp/sounio_lsp_inspect.json.
// Returns 0 on success, -1 on fork failure.
fn run_souc_inspect(line: i64, col: i64) -> i64 with IO, Mut, Panic, Div {
    format_pos_arg(line, col)

    ARGV[0] = "./bin/souc" as i64
    ARGV[1] = "inspect" as i64
    ARGV[2] = "--pos" as i64
    ARGV[3] = &! POS_ARG as i64
    ARGV[4] = "/tmp/sounio_lsp_doc.sio" as i64
    ARGV[5] = 0
    ENVP[0] = 0

    let pid = syscall6(57, 0, 0, 0, 0, 0, 0)
    if pid < 0 { return 0 - 1 }
    if pid == 0 {
        let fd = syscall6(2, "/tmp/sounio_lsp_inspect.json", 577, 420, 0, 0, 0)
        if fd >= 0 {
            syscall6(33, fd, 1, 0, 0, 0, 0)
            syscall6(33, fd, 2, 0, 0, 0, 0)
            syscall6(3, fd, 0, 0, 0, 0, 0)
        }
        syscall6(59, "./bin/souc" as i64, &! ARGV, &! ENVP, 0, 0, 0)
        syscall6(60, 127, 0, 0, 0, 0, 0)
    }
    syscall6(61, pid, 0, 0, 0, 0, 0)
    return 0
}

// Read /tmp/sounio_lsp_inspect.json into INSPECT_RAW. Returns bytes.
fn slurp_inspect_file() -> i64 with IO, Mut, Panic {
    INSPECT_RAW_LEN = 0
    let fd = syscall6(2, "/tmp/sounio_lsp_inspect.json", 0, 0, 0, 0, 0)
    if fd < 0 { return 0 }
    var got: i64 = 0
    var done: i64 = 0
    while done == 0 {
        let r = syscall6(0, fd, &! RX_ONE, 1, 0, 0, 0)
        if r <= 0 { done = 1 }
        else if got >= 8192 { done = 1 }
        else {
            INSPECT_RAW[got as usize] = RX_ONE[0]
            got = got + 1
        }
    }
    syscall6(3, fd, 0, 0, 0, 0, 0)
    INSPECT_RAW_LEN = got
    return got
}

// Find a key like `"signature"` in INSPECT_RAW and capture the string
// value that follows. Stores into INSPECT_SIG. Returns true on hit.
fn extract_inspect_string(key: string, out: &![i8; 1024], out_len: i64) -> i64 with Mut, Panic {
    let klen = str_len(key)
    if klen == 0 || INSPECT_RAW_LEN == 0 { return 0 }
    var i: i64 = 0
    while i + klen <= INSPECT_RAW_LEN {
        var k: i64 = 0
        var ok: i64 = 1
        while k < klen {
            if (INSPECT_RAW[(i + k) as usize] as i64) != str_char_at(key, k) { ok = 0; k = klen }
            else { k = k + 1 }
        }
        if ok == 1 {
            i = i + klen
            // skip ws + ':' + ws + '"'
            var saw_quote: i64 = 0
            while i < INSPECT_RAW_LEN && saw_quote == 0 {
                let c = INSPECT_RAW[i as usize] as i64
                if c == 34 { saw_quote = 1 }
                i = i + 1
            }
            if saw_quote == 0 { return 0 }
            var n: i64 = 0
            while i < INSPECT_RAW_LEN && n < 1024 {
                let c = INSPECT_RAW[i as usize] as i64
                if c == 34 { return n }
                if c == 92 && i + 1 < INSPECT_RAW_LEN {
                    let nx = INSPECT_RAW[(i + 1) as usize] as i64
                    if nx == 110 { out[n as usize] = 10 as i8; n = n + 1; i = i + 2 }
                    else if nx == 34 { out[n as usize] = 34 as i8; n = n + 1; i = i + 2 }
                    else if nx == 92 { out[n as usize] = 92 as i8; n = n + 1; i = i + 2 }
                    else { i = i + 2 }
                } else {
                    out[n as usize] = c as i8
                    n = n + 1
                    i = i + 1
                }
            }
            return n
        }
        i = i + 1
    }
    return 0
}

// Run the inspect pipeline for the cursor position and try to fetch a
// type-checker-inferred signature. Returns true on hit, populates
// INSPECT_SIG. Caller must have ensured DOC_TEXT is on disk.
fn fetch_inspect_signature(line: i64, col: i64) -> bool with IO, Mut, Panic, Div {
    INSPECT_SIG_LEN = 0
    if run_souc_inspect(line, col) < 0 { return false }
    if slurp_inspect_file() <= 0 { return false }
    // Confirm "found":true; otherwise skip.
    var found_true: i64 = 0
    var i: i64 = 0
    let needle = "\"found\":true"
    let nlen = str_len(needle)
    while i + nlen <= INSPECT_RAW_LEN && found_true == 0 {
        var k: i64 = 0
        var ok: i64 = 1
        while k < nlen {
            if (INSPECT_RAW[(i + k) as usize] as i64) != str_char_at(needle, k) { ok = 0; k = nlen }
            else { k = k + 1 }
        }
        if ok == 1 { found_true = 1 }
        i = i + 1
    }
    if found_true == 0 { return false }
    let n = extract_inspect_string("\"signature\"", &! INSPECT_SIG, 1024)
    INSPECT_SIG_LEN = n
    return n > 0
}

// Extract an integer-valued JSON field from INSPECT_RAW. Returns the
// value or -1 if missing / non-numeric.
fn extract_inspect_int(key: string) -> i64 with Mut, Panic, Div {
    let klen = str_len(key)
    if klen == 0 || INSPECT_RAW_LEN == 0 { return 0 - 1 }
    var i: i64 = 0
    while i + klen <= INSPECT_RAW_LEN {
        var k: i64 = 0
        var ok: i64 = 1
        while k < klen {
            if (INSPECT_RAW[(i + k) as usize] as i64) != str_char_at(key, k) { ok = 0; k = klen }
            else { k = k + 1 }
        }
        if ok == 1 {
            var p = i + klen
            while p < INSPECT_RAW_LEN {
                let c = INSPECT_RAW[p as usize] as i64
                if c == 58 { p = p + 1; break }
                p = p + 1
            }
            while p < INSPECT_RAW_LEN {
                let c = INSPECT_RAW[p as usize] as i64
                if c != 32 && c != 9 { break }
                p = p + 1
            }
            if p >= INSPECT_RAW_LEN { return 0 - 1 }
            let first = INSPECT_RAW[p as usize] as i64
            if first < 48 || first > 57 { return 0 - 1 }
            var v: i64 = 0
            while p < INSPECT_RAW_LEN {
                let c = INSPECT_RAW[p as usize] as i64
                if c < 48 || c > 57 { break }
                v = v * 10 + (c - 48)
                p = p + 1
            }
            return v
        }
        i = i + 1
    }
    return 0 - 1
}

// Copy IDENT_BUF into IDENT_ARG, null-terminate. Caller passes the
// IDENT_ARG address into ARGV.
fn pack_ident_arg() with Mut, Panic {
    var i: i64 = 0
    while i < IDENT_LEN && i < 128 {
        IDENT_ARG[i as usize] = IDENT_BUF[i as usize]
        i = i + 1
    }
    IDENT_ARG[i as usize] = 0 as i8
}

// Derive the filesystem path from DOC_URI ("file:///abs/path" →
// "/abs/path"), percent-decode common %XX escapes, null-terminate into
// URI_PATH_ARG. Returns true on success.
fn pack_uri_path_arg() -> bool with Mut, Panic, Div {
    URI_PATH_ARG_LEN = 0
    let prefix = "file://"
    let plen = str_len(prefix)
    if DOC_URI_LEN < plen { return false }
    var k: i64 = 0
    while k < plen {
        if (DOC_URI[k as usize] as i64) != str_char_at(prefix, k) { return false }
        k = k + 1
    }
    var i = plen
    while i < DOC_URI_LEN && URI_PATH_ARG_LEN < 1023 {
        let c = DOC_URI[i as usize] as i64
        if c == 37 && i + 2 < DOC_URI_LEN {
            // percent-decode %XX
            let h1 = DOC_URI[(i + 1) as usize] as i64
            let h2 = DOC_URI[(i + 2) as usize] as i64
            var d1: i64 = 0 - 1
            var d2: i64 = 0 - 1
            if h1 >= 48 && h1 <= 57      { d1 = h1 - 48 }
            else if h1 >= 65 && h1 <= 70 { d1 = h1 - 55 }
            else if h1 >= 97 && h1 <= 102{ d1 = h1 - 87 }
            if h2 >= 48 && h2 <= 57      { d2 = h2 - 48 }
            else if h2 >= 65 && h2 <= 70 { d2 = h2 - 55 }
            else if h2 >= 97 && h2 <= 102{ d2 = h2 - 87 }
            if d1 >= 0 && d2 >= 0 {
                URI_PATH_ARG[URI_PATH_ARG_LEN as usize] = (d1 * 16 + d2) as i8
                URI_PATH_ARG_LEN = URI_PATH_ARG_LEN + 1
                i = i + 3
                continue
            }
        }
        URI_PATH_ARG[URI_PATH_ARG_LEN as usize] = c as i8
        URI_PATH_ARG_LEN = URI_PATH_ARG_LEN + 1
        i = i + 1
    }
    URI_PATH_ARG[URI_PATH_ARG_LEN as usize] = 0 as i8
    return URI_PATH_ARG_LEN > 0
}

// fork+exec `./bin/souc inspect --resolve NAME /tmp/sounio_lsp_doc.sio`.
// Captures stdout (JSON) into INSPECT_RAW via /tmp/sounio_lsp_inspect.json.
// Returns 0 on success, -1 on fork failure.
fn run_souc_resolve() -> i64 with IO, Mut, Panic, Div {
    pack_ident_arg()
    // Prefer the actual document path on disk so the resolver can
    // walk up to the project root. Falls back to the LSP temp file
    // when DOC_URI isn't a file:// URI.
    var src_arg: i64 = 0
    if pack_uri_path_arg() == true {
        src_arg = &! URI_PATH_ARG as i64
    } else {
        src_arg = "/tmp/sounio_lsp_doc.sio" as i64
    }

    ARGV[0] = "./bin/souc" as i64
    ARGV[1] = "inspect" as i64
    ARGV[2] = "--resolve" as i64
    ARGV[3] = &! IDENT_ARG as i64
    ARGV[4] = src_arg
    ARGV[5] = 0
    ENVP[0] = 0

    let pid = syscall6(57, 0, 0, 0, 0, 0, 0)
    if pid < 0 { return 0 - 1 }
    if pid == 0 {
        let fd = syscall6(2, "/tmp/sounio_lsp_inspect.json", 577, 420, 0, 0, 0)
        if fd >= 0 {
            syscall6(33, fd, 1, 0, 0, 0, 0)
            syscall6(33, fd, 2, 0, 0, 0, 0)
            syscall6(3, fd, 0, 0, 0, 0, 0)
        }
        syscall6(59, "./bin/souc" as i64, &! ARGV, &! ENVP, 0, 0, 0)
        syscall6(60, 127, 0, 0, 0, 0, 0)
    }
    syscall6(61, pid, 0, 0, 0, 0, 0)
    return 0
}

// Run --resolve for IDENT_BUF, parse the JSON, populate RESOLVED_*.
// Returns true on hit, false otherwise.
fn fetch_resolved_decl() -> bool with IO, Mut, Panic, Div {
    RESOLVED_FOUND = 0
    RESOLVED_FILE_LEN = 0
    RESOLVED_LINE = 0
    RESOLVED_CHAR = 0
    if IDENT_LEN <= 0 { return false }
    if run_souc_resolve() < 0 { return false }
    if slurp_inspect_file() <= 0 { return false }

    var found_true: i64 = 0
    var i: i64 = 0
    let needle = "\"found\":true"
    let nlen = str_len(needle)
    while i + nlen <= INSPECT_RAW_LEN && found_true == 0 {
        var k: i64 = 0
        var ok: i64 = 1
        while k < nlen {
            if (INSPECT_RAW[(i + k) as usize] as i64) != str_char_at(needle, k) { ok = 0; k = nlen }
            else { k = k + 1 }
        }
        if ok == 1 { found_true = 1 }
        i = i + 1
    }
    if found_true == 0 { return false }

    RESOLVED_FILE_LEN = extract_inspect_string("\"file\"", &! RESOLVED_FILE, 1024)
    if RESOLVED_FILE_LEN <= 0 { return false }
    let dl = extract_inspect_int("\"decl_line\"")
    let dc = extract_inspect_int("\"decl_char\"")
    if dl < 0 || dc < 0 { return false }
    RESOLVED_LINE = dl
    RESOLVED_CHAR = dc
    RESOLVED_FOUND = 1
    return true
}

// Read the stderr file into DIAG_RAW. Returns bytes read.
fn slurp_diag_file() -> i64 with IO, Mut, Panic {
    DIAG_RAW_LEN = 0
    let fd = syscall6(2, "/tmp/sounio_lsp_err.txt", 0, 0, 0, 0, 0)  // O_RDONLY
    if fd < 0 { return 0 }
    var got: i64 = 0
    var done: i64 = 0
    while done == 0 {
        let r = syscall6(0, fd, &! RX_ONE, 1, 0, 0, 0)
        if r <= 0 { done = 1 }
        else if got >= 65536 { done = 1 }
        else {
            DIAG_RAW[got as usize] = RX_ONE[0]
            got = got + 1
        }
    }
    syscall6(3, fd, 0, 0, 0, 0, 0)
    DIAG_RAW_LEN = got
    return got
}

// Scan DIAG_RAW for lines matching `error: <message> at line <N>` and
// populate DIAG_LINE / DIAG_MSG_OFF / DIAG_MSG_LEN. Resets DIAG_COUNT.
fn parse_diagnostics() with Mut, Panic, Div {
    DIAG_COUNT = 0
    DIAG_MSG_BUF_LEN = 0
    let prefix = "error: "
    let plen = str_len(prefix)
    var i: i64 = 0
    while i < DIAG_RAW_LEN && DIAG_COUNT < DIAG_MAX {
        // Match prefix at start of a line
        var at_bol: bool = false
        if i == 0 { at_bol = true }
        else if (DIAG_RAW[(i - 1) as usize] as i64) == 10 { at_bol = true }
        if at_bol == true && i + plen <= DIAG_RAW_LEN {
            var k: i64 = 0
            var match_ok: i64 = 1
            while k < plen {
                if (DIAG_RAW[(i + k) as usize] as i64) != str_char_at(prefix, k) {
                    match_ok = 0
                    k = plen
                } else { k = k + 1 }
            }
            if match_ok == 1 {
                // Capture message up to "at line N" or EOL
                let msg_start = i + plen
                var j = msg_start
                while j < DIAG_RAW_LEN && (DIAG_RAW[j as usize] as i64) != 10 { j = j + 1 }
                let eol = j
                // Try to find " at line " inside [msg_start, eol)
                let at_pat = " at line "
                let alen = str_len(at_pat)
                var line_no: i64 = 0
                var msg_end = eol
                var ai = msg_start
                while ai + alen <= eol {
                    var m: i64 = 1
                    var aj: i64 = 0
                    while aj < alen {
                        if (DIAG_RAW[(ai + aj) as usize] as i64) != str_char_at(at_pat, aj) {
                            m = 0
                            aj = alen
                        } else { aj = aj + 1 }
                    }
                    if m == 1 {
                        msg_end = ai
                        var nx = ai + alen
                        while nx < eol {
                            let c = DIAG_RAW[nx as usize] as i64
                            if c < 48 || c > 57 { nx = eol }
                            else { line_no = line_no * 10 + (c - 48); nx = nx + 1 }
                        }
                        ai = eol
                    } else { ai = ai + 1 }
                }
                // Convert souc 1-based line to LSP 0-based
                let lsp_line = if line_no > 0 { line_no - 1 } else { 0 }
                let msg_len = msg_end - msg_start
                if msg_len > 0 && DIAG_MSG_BUF_LEN + msg_len <= 16384 {
                    var mi: i64 = 0
                    while mi < msg_len {
                        DIAG_MSG_BUF[(DIAG_MSG_BUF_LEN + mi) as usize] = DIAG_RAW[(msg_start + mi) as usize]
                        mi = mi + 1
                    }
                    DIAG_LINE[DIAG_COUNT as usize] = lsp_line
                    DIAG_MSG_OFF[DIAG_COUNT as usize] = DIAG_MSG_BUF_LEN
                    DIAG_MSG_LEN[DIAG_COUNT as usize] = msg_len
                    DIAG_MSG_BUF_LEN = DIAG_MSG_BUF_LEN + msg_len
                    DIAG_COUNT = DIAG_COUNT + 1
                }
                i = eol
            }
        }
        i = i + 1
    }
}

// Write DOC_TEXT to TMP_DOC_PATH. Returns true on success.
// Madaros gap: the write_file builtin mis-lowers a &!-of-global buffer
// (writes DOC_TEXT_LEN bytes from the wrong address), while syscall6 with
// &! globals is proven by scripts/ci/madaros_syscall6_gate.sh — so open/
// write/close are done directly. 577 = O_WRONLY|O_CREAT|O_TRUNC, 420 = 0644.
fn write_doc_to_disk() -> bool with IO, Mut, Panic {
    let fd = syscall6(2, "/tmp/sounio_lsp_doc.sio", 577, 420, 0, 0, 0)
    if fd < 0 { return false }
    let w = syscall6(1, fd, &! DOC_TEXT, DOC_TEXT_LEN, 0, 0, 0)
    syscall6(3, fd, 0, 0, 0, 0, 0)
    return w == DOC_TEXT_LEN
}

// Build and send a textDocument/publishDiagnostics notification.
// Pull-mode diagnostics — textDocument/diagnostic (LSP 3.17). Runs the
// same souc-check pipeline as didOpen/didChange but returns the
// diagnostics as the response result instead of pushing them.
// Linked editing range — textDocument/linkedEditingRange (LSP 3.16).
// Returns ranges of every textually-equal ident in DOC_TEXT (whole-doc
// scope for v0; not enclosing-fn). Editors that support linked editing
// will rename all of them simultaneously when the user types.
fn respond_linked_editing_range() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        tx_reset()
        tx_puts("{\"jsonrpc\":\"2.0\",")
        tx_emit_id()
        tx_puts(",\"result\":null}")
        write_frame()
        return
    }
    parse_hover_position()
    var have: bool = false
    if HOVER_OK == 1 {
        let n = locate_ident()
        if n > 0 {
            // Reject keywords — editors should not linked-edit them.
            if ident_eq("fn") == false && ident_eq("let") == false &&
               ident_eq("var") == false && ident_eq("if") == false &&
               ident_eq("else") == false && ident_eq("while") == false &&
               ident_eq("return") == false && ident_eq("with") == false &&
               ident_eq("struct") == false && ident_eq("enum") == false &&
               ident_eq("match") == false && ident_eq("break") == false &&
               ident_eq("continue") == false && ident_eq("true") == false &&
               ident_eq("false") == false && ident_eq("as") == false &&
               ident_eq("pub") == false && ident_eq("use") == false &&
               ident_eq("mod") == false {
                have = true
            }
        }
    }
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    if have == false {
        tx_puts(",\"result\":null}")
        write_frame()
        return
    }
    tx_puts(",\"result\":{\"ranges\":[")
    var first: bool = true
    var i: i64 = 0
    while i < DOC_TEXT_LEN {
        var at_word_start: bool = false
        if i == 0 { at_word_start = true }
        else if is_ident_byte(DOC_TEXT[(i - 1) as usize] as i64) == false {
            at_word_start = true
        }
        if at_word_start == true {
            let je = read_ident_run(i)
            if je > i && (je - i) == IDENT_LEN && doc_slice_eq_ident(i) == true {
                if first == false { tx_putc(44) }
                first = false
                offset_to_position(i, 0)
                tx_puts("{\"start\":{\"line\":")
                tx_put_i64(DEF_LINE)
                tx_puts(",\"character\":")
                tx_put_i64(DEF_CHAR)
                tx_puts("},\"end\":{\"line\":")
                tx_put_i64(DEF_LINE)
                tx_puts(",\"character\":")
                tx_put_i64(DEF_CHAR + IDENT_LEN)
                tx_puts("}}")
            }
            if je > i { i = je } else { i = i + 1 }
        } else {
            i = i + 1
        }
    }
    tx_puts("]}}")
    write_frame()
}

// inlayHint/resolve — our hints are already fully populated when
// emitted, so resolve just echoes the params.* object back as result.
// Echo the incoming `params` object back as the `result` so the response
// is a syntactically valid InlayHint per LSP 3.17 §inlayHint/resolve.
// Editors that wait on resolve before rendering are unblocked; the hint
// payload is unchanged from what `textDocument/inlayHint` returned.
fn respond_inlay_hint_resolve() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    let pp = body_find("\"params\"", 0)
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    if pp < 0 {
        tx_puts(",\"result\":null}")
        write_frame()
        return
    }
    // Skip past `"params"` (8 bytes), then any whitespace + ':' + whitespace.
    var i = pp + 8
    while i < RX_BODY_LEN {
        let c = RX_BODY[i as usize] as i64
        if c == 32 || c == 58 || c == 9 || c == 10 || c == 13 {
            i = i + 1
        } else {
            break
        }
    }
    if i >= RX_BODY_LEN || (RX_BODY[i as usize] as i64) != 123 {
        tx_puts(",\"result\":null}")
        write_frame()
        return
    }
    tx_puts(",\"result\":")
    // Copy the balanced `{ … }` verbatim, tracking string state so braces
    // inside string literals don't disturb the depth count.
    var depth: i64 = 0
    var in_string: bool = false
    var escape: bool = false
    while i < RX_BODY_LEN {
        let c = RX_BODY[i as usize] as i64
        tx_putc(c)
        if escape == true {
            escape = false
            i = i + 1
            continue
        }
        if in_string == true {
            if c == 92 { escape = true }
            else if c == 34 { in_string = false }
            i = i + 1
            continue
        }
        if c == 34 { in_string = true }
        else if c == 123 { depth = depth + 1 }
        else if c == 125 {
            depth = depth - 1
            if depth == 0 { i = i + 1; break }
        }
        i = i + 1
    }
    tx_puts("}")
    write_frame()
}

fn respond_pull_diagnostic() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        tx_reset()
        tx_puts("{\"jsonrpc\":\"2.0\",")
        tx_emit_id()
        tx_puts(",\"result\":{\"kind\":\"full\",\"items\":[]}}")
        write_frame()
        return
    }
    if write_doc_to_disk() == false {
        tx_reset()
        tx_puts("{\"jsonrpc\":\"2.0\",")
        tx_emit_id()
        tx_puts(",\"result\":{\"kind\":\"full\",\"items\":[]}}")
        write_frame()
        return
    }
    if run_souc_check() < 0 {
        tx_reset()
        tx_puts("{\"jsonrpc\":\"2.0\",")
        tx_emit_id()
        tx_puts(",\"result\":{\"kind\":\"full\",\"items\":[]}}")
        write_frame()
        return
    }
    slurp_diag_file()
    parse_diagnostics()
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":{\"kind\":\"full\",\"items\":[")
    var d: i64 = 0
    while d < DIAG_COUNT {
        if d > 0 { tx_putc(44) }
        let ln = DIAG_LINE[d as usize]
        tx_puts("{\"severity\":1,\"source\":\"sounio:type\",\"code\":\"E001\",\"range\":{\"start\":{\"line\":")
        tx_put_i64(ln)
        tx_puts(",\"character\":0},\"end\":{\"line\":")
        tx_put_i64(ln)
        tx_puts(",\"character\":0}},\"message\":\"")
        let off = DIAG_MSG_OFF[d as usize]
        let mlen = DIAG_MSG_LEN[d as usize]
        var mi: i64 = 0
        while mi < mlen {
            let c = DIAG_MSG_BUF[(off + mi) as usize] as i64
            if c == 34 { tx_putc(92); tx_putc(34) }
            else if c == 92 { tx_putc(92); tx_putc(92) }
            else if c == 10 { tx_putc(92); tx_putc(110) }
            else if c == 13 { tx_putc(92); tx_putc(114) }
            else if c == 9  { tx_putc(92); tx_putc(116) }
            else if c < 32 { tx_putc(32) }
            else { tx_putc(c) }
            mi = mi + 1
        }
        tx_puts("\"}")
        d = d + 1
    }
    tx_puts("]}}")
    write_frame()
}

fn publish_diagnostics() with IO, Mut, Panic, Div {
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{")
    tx_puts("\"uri\":\"")
    var i: i64 = 0
    while i < DOC_URI_LEN {
        let c = DOC_URI[i as usize] as i64
        if c == 34 { tx_putc(92); tx_putc(34) }
        else if c == 92 { tx_putc(92); tx_putc(92) }
        else { tx_putc(c) }
        i = i + 1
    }
    tx_puts("\",\"diagnostics\":[")
    var d: i64 = 0
    while d < DIAG_COUNT {
        if d > 0 { tx_putc(44) }
        let ln = DIAG_LINE[d as usize]
        tx_puts("{\"severity\":1,\"source\":\"sounio:type\",\"code\":\"E001\",\"range\":{\"start\":{\"line\":")
        tx_put_i64(ln)
        tx_puts(",\"character\":0},\"end\":{\"line\":")
        tx_put_i64(ln)
        tx_puts(",\"character\":0}},\"message\":\"")
        let off = DIAG_MSG_OFF[d as usize]
        let mlen = DIAG_MSG_LEN[d as usize]
        var mi: i64 = 0
        while mi < mlen {
            let c = DIAG_MSG_BUF[(off + mi) as usize] as i64
            if c == 34 { tx_putc(92); tx_putc(34) }
            else if c == 92 { tx_putc(92); tx_putc(92) }
            else if c == 10 { tx_putc(92); tx_putc(110) }
            else if c == 13 { tx_putc(92); tx_putc(114) }
            else if c == 9  { tx_putc(92); tx_putc(116) }
            else if c < 32 { tx_putc(32) }
            else { tx_putc(c) }
            mi = mi + 1
        }
        tx_puts("\"}")
        d = d + 1
    }
    tx_puts("]}}")
    write_frame()
}

// ============================================================================
// Hover
// ============================================================================
//
// Cursor-accurate hover. Extracts the request position, locates the
// identifier at (line, character) in DOC_TEXT (the most recently opened or
// changed document), and renders Markdown content:
//   - if it's a Sounio keyword → "**keyword** `name`\n\nReserved word."
//   - if it's a known stdlib name → its signature
//   - otherwise → name with a generic "Sounio identifier" note
//
// Real type-checker integration (showing inferred Knowledge<T, eps≥N> at
// the call site) requires a new `souc inspect --pos LINE:COL` subcommand
// in lean_single.sio; tracked as Compiler prereq #5.

// Identifier under cursor, scratch
var IDENT_BUF: [i8; 128] = [0; 128]
var IDENT_LEN: i64 = 0

// Parsed hover position (LSP zero-based)
var HOVER_LINE: i64 = 0
var HOVER_CHAR: i64 = 0
var HOVER_OK:   i64 = 0

// Read the integer value following a key (e.g. "\"line\"" at offset `pos`).
// Returns the integer, or -1 if not found.
fn body_read_int_after(pos: i64) -> i64 with Mut, Panic, Div {
    var i = pos
    while i < RX_BODY_LEN {
        let c = RX_BODY[i as usize] as i64
        if c == 58 { i = i + 1; break }
        i = i + 1
    }
    while i < RX_BODY_LEN {
        let c = RX_BODY[i as usize] as i64
        if c != 32 && c != 9 { break }
        i = i + 1
    }
    if i >= RX_BODY_LEN { return 0 - 1 }
    let first = RX_BODY[i as usize] as i64
    if first < 48 || first > 57 { return 0 - 1 }
    var v: i64 = 0
    while i < RX_BODY_LEN {
        let c = RX_BODY[i as usize] as i64
        if c < 48 || c > 57 { break }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    return v
}

fn parse_hover_position() with Mut, Panic, Div {
    HOVER_OK = 0
    let lpos = body_find("\"line\"", 0)
    let cpos = body_find("\"character\"", 0)
    if lpos < 0 || cpos < 0 { return }
    let ln = body_read_int_after(lpos + 6)
    let ch = body_read_int_after(cpos + 11)
    if ln < 0 || ch < 0 { return }
    HOVER_LINE = ln
    HOVER_CHAR = ch
    HOVER_OK = 1
}

// True if byte is identifier-continue: [A-Za-z0-9_]
fn is_ident_byte(b: i64) -> bool {
    if b >= 65 && b <= 90 { return true }
    if b >= 97 && b <= 122 { return true }
    if b >= 48 && b <= 57 { return true }
    if b == 95 { return true }
    return false
}

// Locate identifier in DOC_TEXT at (HOVER_LINE, HOVER_CHAR). Copies it
// into IDENT_BUF. Returns IDENT_LEN, or 0 if no identifier under cursor.
fn locate_ident() -> i64 with Mut, Panic {
    IDENT_LEN = 0
    var i: i64 = 0
    var line: i64 = 0
    var col: i64 = 0
    // Walk to (HOVER_LINE, HOVER_CHAR)
    while i < DOC_TEXT_LEN && line < HOVER_LINE {
        let c = DOC_TEXT[i as usize] as i64
        if c == 10 { line = line + 1 }
        i = i + 1
    }
    if line != HOVER_LINE { return 0 }
    var pos = i
    while col < HOVER_CHAR && pos < DOC_TEXT_LEN {
        let c = DOC_TEXT[pos as usize] as i64
        if c == 10 { return 0 }
        pos = pos + 1
        col = col + 1
    }
    // Walk left to identifier start
    var start = pos
    while start > i {
        let c = DOC_TEXT[(start - 1) as usize] as i64
        if is_ident_byte(c) == false { break }
        start = start - 1
    }
    // Walk right to identifier end
    var endp = pos
    while endp < DOC_TEXT_LEN {
        let c = DOC_TEXT[endp as usize] as i64
        if is_ident_byte(c) == false { break }
        endp = endp + 1
    }
    if endp <= start { return 0 }
    var k = start
    while k < endp && IDENT_LEN < 128 {
        IDENT_BUF[IDENT_LEN as usize] = DOC_TEXT[k as usize]
        IDENT_LEN = IDENT_LEN + 1
        k = k + 1
    }
    return IDENT_LEN
}

fn ident_eq(s: string) -> bool with Mut, Panic {
    let n = str_len(s)
    if n != IDENT_LEN { return false }
    var i: i64 = 0
    while i < n {
        if (IDENT_BUF[i as usize] as i64) != str_char_at(s, i) { return false }
        i = i + 1
    }
    return true
}

// Map IDENT_BUF to a hover-content string. Returns "" if unknown.
fn hover_lookup() -> string with Mut, Panic {
    // Keywords (subset of Sounio reserved words)
    if ident_eq("fn")     { return "**keyword** `fn`\\n\\nFunction declaration." }
    if ident_eq("let")    { return "**keyword** `let`\\n\\nImmutable binding." }
    if ident_eq("var")    { return "**keyword** `var`\\n\\nMutable binding." }
    if ident_eq("if")     { return "**keyword** `if`\\n\\nConditional." }
    if ident_eq("else")   { return "**keyword** `else`\\n\\nConditional alternative." }
    if ident_eq("while")  { return "**keyword** `while`\\n\\nLoop." }
    if ident_eq("return") { return "**keyword** `return`\\n\\nExit a function with a value." }
    if ident_eq("with")   { return "**keyword** `with`\\n\\nEffect annotation on a function signature." }
    if ident_eq("struct") { return "**keyword** `struct`\\n\\nRecord type." }
    if ident_eq("enum")   { return "**keyword** `enum`\\n\\nSum type." }
    if ident_eq("match")  { return "**keyword** `match`\\n\\nPattern match." }
    if ident_eq("break")  { return "**keyword** `break`\\n\\nExit the innermost loop." }
    if ident_eq("continue") { return "**keyword** `continue`\\n\\nSkip to the next loop iteration." }
    if ident_eq("true")   { return "**keyword** `true`\\n\\nBoolean literal." }
    if ident_eq("false")  { return "**keyword** `false`\\n\\nBoolean literal." }
    if ident_eq("as")     { return "**keyword** `as`\\n\\nType cast." }
    if ident_eq("pub")    { return "**keyword** `pub`\\n\\nPublic visibility." }
    if ident_eq("use")    { return "**keyword** `use`\\n\\nImport a module symbol." }
    if ident_eq("mod")    { return "**keyword** `mod`\\n\\nDeclare a module." }
    if ident_eq("spawn")  { return "**keyword** `spawn`\\n\\nFork a parallel computation." }
    // Primitive types
    if ident_eq("i8")    { return "**type** `i8` — 8-bit signed integer." }
    if ident_eq("i16")   { return "**type** `i16` — 16-bit signed integer." }
    if ident_eq("i32")   { return "**type** `i32` — 32-bit signed integer." }
    if ident_eq("i64")   { return "**type** `i64` — 64-bit signed integer." }
    if ident_eq("u8")    { return "**type** `u8` — 8-bit unsigned integer." }
    if ident_eq("u32")   { return "**type** `u32` — 32-bit unsigned integer." }
    if ident_eq("u64")   { return "**type** `u64` — 64-bit unsigned integer." }
    if ident_eq("usize") { return "**type** `usize` — pointer-sized unsigned integer." }
    if ident_eq("f32")   { return "**type** `f32` — 32-bit IEEE-754 float." }
    if ident_eq("f64")   { return "**type** `f64` — 64-bit IEEE-754 float." }
    if ident_eq("bool")  { return "**type** `bool` — boolean." }
    if ident_eq("string"){ return "**type** `string` — null-terminated byte string." }
    // Effects
    if ident_eq("IO")    { return "**effect** `IO` — touches the outside world (read/write/syscalls)." }
    if ident_eq("Mut")   { return "**effect** `Mut` — mutates state." }
    if ident_eq("Panic") { return "**effect** `Panic` — may panic." }
    if ident_eq("Div")   { return "**effect** `Div` — may diverge / non-termination." }
    if ident_eq("Async") { return "**effect** `Async` — async-suspending." }
    if ident_eq("GPU")   { return "**effect** `GPU` — runs on the GPU." }
    if ident_eq("Alloc") { return "**effect** `Alloc` — heap-allocating." }
    // Stdlib I/O / syscalls
    if ident_eq("print")     { return "`print(s: string) with IO`\\n\\nWrite `s` to stdout." }
    if ident_eq("println")   { return "`println(s: string) with IO`\\n\\nWrite `s` and a newline to stdout." }
    if ident_eq("read_line") { return "`read_line() -> string with IO`\\n\\nRead one line from stdin (strips trailing '\\\\n'). Buffered up to 4096 bytes." }
    if ident_eq("read_file") { return "`read_file(path: string) -> string with IO`\\n\\nLoad an entire file into a fresh mmap buffer." }
    if ident_eq("write_file"){ return "`write_file(path: string, buf: &![i8; N], len: i64) -> i64 with IO`\\n\\nO_WRONLY|O_CREAT|O_TRUNC; returns bytes written or -1." }
    if ident_eq("syscall6")  { return "`syscall6(nr, a1, a2, a3, a4, a5, a6) -> i64 with IO`\\n\\nRaw Linux x86_64 syscall." }
    if ident_eq("str_len")   { return "`str_len(s: string) -> i64`\\n\\nByte length of a null-terminated string." }
    if ident_eq("str_eq")    { return "`str_eq(a: string, b: string) -> bool`\\n\\nByte-wise equality." }
    if ident_eq("str_char_at") { return "`str_char_at(s: string, i: i64) -> i64`\\n\\nByte at index `i`." }
    if ident_eq("assert")    { return "`assert(cond: bool) with Panic`\\n\\nAbort if `cond` is false." }
    if ident_eq("main")      { return "**entry point** `fn main() -> i32 with IO, Mut, Panic, Div, Alloc`\\n\\nProgram entry." }
    return ""
}

fn respond_hover() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        respond_empty_result()
        return
    }
    parse_hover_position()
    var content: string = "*no identifier under cursor*"
    var have: i64 = 0
    var from_inspect: i64 = 0
    if HOVER_OK == 1 {
        let n = locate_ident()
        if n > 0 {
            let found = hover_lookup()
            let fl = str_len(found)
            if fl > 0 {
                content = found
                have = 1
            } else {
                // Static-table miss. The cursor may be on a call site
                // — i.e. inside one fn but referring to another. Find
                // the declaration of the cursor's identifier, then ask
                // souc inspect at THAT line:char. Falls back to the
                // cursor position when no declaration is found.
                var ins_line = HOVER_LINE
                var ins_char = HOVER_CHAR
                scan_definition_for_ident()
                if DEF_FOUND == 1 {
                    ins_line = DEF_LINE
                    ins_char = DEF_CHAR
                }
                if write_doc_to_disk() == true {
                    if fetch_inspect_signature(ins_line, ins_char) == true {
                        from_inspect = 1
                        have = 1
                    }
                }
                if have == 0 {
                    content = "Sounio identifier"
                    have = 1
                }
            }
        }
    }
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    if have == 1 {
        tx_puts(",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"")
        tx_puts("### `")
        var i: i64 = 0
        while i < IDENT_LEN {
            let c = IDENT_BUF[i as usize] as i64
            if c == 96 { tx_putc(92); tx_putc(96) }
            else { tx_putc(c) }
            i = i + 1
        }
        tx_puts("`\\n\\n")
        if from_inspect == 1 {
            // Render the inspect signature inside a markdown code fence
            // (sounio-flavored). Escape backticks; remap real newlines
            // and control chars to literal `\\n` since they live inside
            // a JSON string.
            tx_puts("```sounio\\n")
            var j: i64 = 0
            while j < INSPECT_SIG_LEN {
                let c = INSPECT_SIG[j as usize] as i64
                if c == 34 { tx_putc(92); tx_putc(34) }
                else if c == 92 { tx_putc(92); tx_putc(92) }
                else if c == 10 { tx_putc(92); tx_putc(110) }
                else if c == 13 { tx_putc(92); tx_putc(114) }
                else if c == 9  { tx_putc(92); tx_putc(116) }
                else if c < 32  { tx_putc(32) }
                else { tx_putc(c) }
                j = j + 1
            }
            tx_puts("\\n```\\n\\n*from type-checker*")
        } else {
            tx_puts(content)
        }
        tx_puts("\"}}")
    } else {
        tx_puts(",\"result\":null")
    }
    tx_puts("}")
    write_frame()
}

// ============================================================================
// Completions
// ============================================================================
//
// Cursor-position completions sourced from two pools:
//   (a) Static table — Sounio keywords, primitive types, effects, stdlib
//       functions. Same vocabulary the hover handler uses.
//   (b) Document scan — identifiers declared in DOC_TEXT via
//       `fn <name>`, `let <name>`, `var <name>`, `struct <name>`,
//       `enum <name>`. Best-effort byte scan, not a real parser; covers
//       the most-asked-for AST shapes.
//
// LSP CompletionItem kinds used (subset of the LSP spec enum):
//   3  Function
//   6  Variable
//   14 Keyword
//   22 Struct
//   25 TypeParameter (we co-opt for effects)

let CK_FUNCTION: i64 = 3
let CK_VARIABLE: i64 = 6
let CK_KEYWORD:  i64 = 14
let CK_STRUCT:   i64 = 22
let CK_TYPEPARM: i64 = 25

// Completion prefix (bytes already typed under the cursor)
var COMP_PREFIX: [i8; 128] = [0; 128]
var COMP_PREFIX_LEN: i64 = 0

// Track whether we've emitted at least one item so the comma logic stays sane
var COMP_EMITTED: i64 = 0

// Walk DOC_TEXT to the byte offset of HOVER_LINE:HOVER_CHAR and scan
// backwards over identifier bytes to capture whatever the user has typed
// so far. Empty prefix → emit everything.
fn parse_completion_prefix() with Mut, Panic {
    COMP_PREFIX_LEN = 0
    if HOVER_OK == 0 { return }
    var i: i64 = 0
    var line: i64 = 0
    while i < DOC_TEXT_LEN && line < HOVER_LINE {
        if (DOC_TEXT[i as usize] as i64) == 10 { line = line + 1 }
        i = i + 1
    }
    if line != HOVER_LINE { return }
    var pos = i
    var col: i64 = 0
    while col < HOVER_CHAR && pos < DOC_TEXT_LEN {
        if (DOC_TEXT[pos as usize] as i64) == 10 { return }
        pos = pos + 1
        col = col + 1
    }
    var start = pos
    while start > i {
        let c = DOC_TEXT[(start - 1) as usize] as i64
        if is_ident_byte(c) == false { break }
        start = start - 1
    }
    var k = start
    while k < pos && COMP_PREFIX_LEN < 128 {
        COMP_PREFIX[COMP_PREFIX_LEN as usize] = DOC_TEXT[k as usize]
        COMP_PREFIX_LEN = COMP_PREFIX_LEN + 1
        k = k + 1
    }
}

// Does `label` begin with the captured prefix? Empty prefix → always true.
fn label_matches_prefix(label: string) -> bool with Mut, Panic {
    if COMP_PREFIX_LEN == 0 { return true }
    let n = str_len(label)
    if n < COMP_PREFIX_LEN { return false }
    var i: i64 = 0
    while i < COMP_PREFIX_LEN {
        if str_char_at(label, i) != (COMP_PREFIX[i as usize] as i64) {
            return false
        }
        i = i + 1
    }
    return true
}

// Does the substring DOC_TEXT[start..start+len] begin with COMP_PREFIX?
fn doc_slice_matches_prefix(start: i64, len: i64) -> bool with Mut, Panic {
    if COMP_PREFIX_LEN == 0 { return true }
    if len < COMP_PREFIX_LEN { return false }
    var i: i64 = 0
    while i < COMP_PREFIX_LEN {
        if (DOC_TEXT[(start + i) as usize] as i64) != (COMP_PREFIX[i as usize] as i64) {
            return false
        }
        i = i + 1
    }
    return true
}

fn emit_comma_if_needed() with Mut, Panic {
    if COMP_EMITTED == 1 { tx_putc(44) }
    COMP_EMITTED = 1
}

fn emit_completion_item(label: string, kind: i64, detail: string) with Mut, Panic, Div {
    emit_comma_if_needed()
    tx_puts("{\"label\":\"")
    tx_puts(label)
    tx_puts("\",\"kind\":")
    tx_put_i64(kind)
    let dl = str_len(detail)
    if dl > 0 {
        tx_puts(",\"detail\":\"")
        tx_puts(detail)
        tx_puts("\"")
    }
    tx_putc(125)
}

// Wraps the prefix check + emission of one static item.
fn maybe_emit(label: string, kind: i64, detail: string) with Mut, Panic, Div {
    if label_matches_prefix(label) == true {
        emit_completion_item(label, kind, detail)
    }
}

// Append the byte slice DOC_TEXT[start..start+len] into the current TX_BODY
// (escaped where necessary).
fn tx_put_slice(start: i64, len: i64) with Mut, Panic {
    var i: i64 = 0
    while i < len {
        let c = DOC_TEXT[(start + i) as usize] as i64
        if c == 34 { tx_putc(92); tx_putc(34) }
        else if c == 92 { tx_putc(92); tx_putc(92) }
        else { tx_putc(c) }
        i = i + 1
    }
}

// Emit one user-defined completion item with the label sourced from
// DOC_TEXT[start..start+len].
fn emit_user_item(start: i64, len: i64, kind: i64, detail: string) with Mut, Panic, Div {
    emit_comma_if_needed()
    tx_puts("{\"label\":\"")
    tx_put_slice(start, len)
    tx_puts("\",\"kind\":")
    tx_put_i64(kind)
    let dl = str_len(detail)
    if dl > 0 {
        tx_puts(",\"detail\":\"")
        tx_puts(detail)
        tx_puts("\"")
    }
    tx_putc(125)
}

// Skip ASCII whitespace in DOC_TEXT starting at `i`. Returns new index.
fn skip_ws(i: i64) -> i64 with Mut, Panic {
    var p = i
    while p < DOC_TEXT_LEN {
        let c = DOC_TEXT[p as usize] as i64
        if c != 32 && c != 9 { break }
        p = p + 1
    }
    return p
}

// Starting at `i`, read identifier bytes. Returns end offset (i if none).
fn read_ident_run(i: i64) -> i64 with Mut, Panic {
    var p = i
    while p < DOC_TEXT_LEN {
        let c = DOC_TEXT[p as usize] as i64
        if is_ident_byte(c) == false { break }
        p = p + 1
    }
    return p
}

// True if the identifier at DOC_TEXT[s..e] matches the given keyword. The
// caller has already verified [s..e] is an identifier run, so we just byte
// compare the full slice.
fn ident_slice_eq(s: i64, e: i64, kw: string) -> bool with Mut, Panic {
    let n = e - s
    if n != str_len(kw) { return false }
    var k: i64 = 0
    while k < n {
        if (DOC_TEXT[(s + k) as usize] as i64) != str_char_at(kw, k) { return false }
        k = k + 1
    }
    return true
}

// Scan DOC_TEXT for declarations and emit completion items. Honors prefix.
// Handles: `fn N(`, `let N`, `var N`, `struct N`, `enum N`. Identifier
// must follow on the same line. Crude — no scope tracking.
fn emit_doc_completions() with Mut, Panic, Div {
    var i: i64 = 0
    while i < DOC_TEXT_LEN {
        // Sit at start-of-token: either start of DOC_TEXT, or after a byte
        // that isn't identifier-continue.
        var at_word_start: bool = false
        if i == 0 { at_word_start = true }
        else {
            let prev = DOC_TEXT[(i - 1) as usize] as i64
            if is_ident_byte(prev) == false { at_word_start = true }
        }
        if at_word_start == true {
            let je = read_ident_run(i)
            if je > i {
                var kind: i64 = 0
                var detail: string = ""
                if ident_slice_eq(i, je, "fn")     { kind = CK_FUNCTION; detail = "fn declared in this file" }
                else if ident_slice_eq(i, je, "let")    { kind = CK_VARIABLE; detail = "let binding" }
                else if ident_slice_eq(i, je, "var")    { kind = CK_VARIABLE; detail = "var binding" }
                else if ident_slice_eq(i, je, "struct") { kind = CK_STRUCT;   detail = "struct in this file" }
                else if ident_slice_eq(i, je, "enum")   { kind = CK_STRUCT;   detail = "enum in this file" }

                if kind != 0 {
                    let ns = skip_ws(je)
                    let ne = read_ident_run(ns)
                    if ne > ns {
                        let nlen = ne - ns
                        // Skip if this is one of our seed keywords (don't dedup
                        // against static table — duplicates are tolerable).
                        if doc_slice_matches_prefix(ns, nlen) == true {
                            emit_user_item(ns, nlen, kind, detail)
                        }
                    }
                    i = je
                } else {
                    i = je
                }
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
}

fn emit_static_completions() with Mut, Panic, Div {
    // Keywords
    maybe_emit("fn", CK_KEYWORD, "Function declaration")
    maybe_emit("let", CK_KEYWORD, "Immutable binding")
    maybe_emit("var", CK_KEYWORD, "Mutable binding")
    maybe_emit("if", CK_KEYWORD, "Conditional")
    maybe_emit("else", CK_KEYWORD, "Conditional alternative")
    maybe_emit("while", CK_KEYWORD, "Loop")
    maybe_emit("return", CK_KEYWORD, "Return from a function")
    maybe_emit("with", CK_KEYWORD, "Effect annotation")
    maybe_emit("struct", CK_KEYWORD, "Record type")
    maybe_emit("enum", CK_KEYWORD, "Sum type")
    maybe_emit("match", CK_KEYWORD, "Pattern match")
    maybe_emit("break", CK_KEYWORD, "Exit loop")
    maybe_emit("continue", CK_KEYWORD, "Next iteration")
    maybe_emit("true", CK_KEYWORD, "Boolean literal")
    maybe_emit("false", CK_KEYWORD, "Boolean literal")
    maybe_emit("as", CK_KEYWORD, "Type cast")
    maybe_emit("pub", CK_KEYWORD, "Public visibility")
    maybe_emit("use", CK_KEYWORD, "Import")
    maybe_emit("mod", CK_KEYWORD, "Module declaration")
    maybe_emit("spawn", CK_KEYWORD, "Fork parallel block")
    // Primitive types
    maybe_emit("i8", CK_TYPEPARM, "8-bit signed integer")
    maybe_emit("i16", CK_TYPEPARM, "16-bit signed integer")
    maybe_emit("i32", CK_TYPEPARM, "32-bit signed integer")
    maybe_emit("i64", CK_TYPEPARM, "64-bit signed integer")
    maybe_emit("u8", CK_TYPEPARM, "8-bit unsigned integer")
    maybe_emit("u32", CK_TYPEPARM, "32-bit unsigned integer")
    maybe_emit("u64", CK_TYPEPARM, "64-bit unsigned integer")
    maybe_emit("usize", CK_TYPEPARM, "pointer-sized unsigned")
    maybe_emit("f32", CK_TYPEPARM, "32-bit float")
    maybe_emit("f64", CK_TYPEPARM, "64-bit float")
    maybe_emit("bool", CK_TYPEPARM, "boolean")
    maybe_emit("string", CK_TYPEPARM, "null-terminated byte string")
    // Effects
    maybe_emit("IO", CK_TYPEPARM, "effect: outside world")
    maybe_emit("Mut", CK_TYPEPARM, "effect: mutates state")
    maybe_emit("Panic", CK_TYPEPARM, "effect: may panic")
    maybe_emit("Div", CK_TYPEPARM, "effect: may diverge")
    maybe_emit("Async", CK_TYPEPARM, "effect: async-suspending")
    maybe_emit("GPU", CK_TYPEPARM, "effect: runs on GPU")
    maybe_emit("Alloc", CK_TYPEPARM, "effect: heap-allocates")
    // Stdlib functions
    maybe_emit("print", CK_FUNCTION, "print(s: string) with IO")
    maybe_emit("println", CK_FUNCTION, "println(s: string) with IO")
    maybe_emit("read_line", CK_FUNCTION, "read_line() -> string with IO")
    maybe_emit("read_file", CK_FUNCTION, "read_file(path) -> string with IO")
    maybe_emit("write_file", CK_FUNCTION, "write_file(path, buf, len) -> i64 with IO")
    maybe_emit("syscall6", CK_FUNCTION, "syscall6(nr, a1..a6) -> i64 with IO")
    maybe_emit("str_len", CK_FUNCTION, "str_len(s) -> i64")
    maybe_emit("str_eq", CK_FUNCTION, "str_eq(a, b) -> bool")
    maybe_emit("str_char_at", CK_FUNCTION, "str_char_at(s, i) -> i64")
    maybe_emit("assert", CK_FUNCTION, "assert(cond: bool) with Panic")
}

fn respond_completion() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        respond_empty_result()
        return
    }
    parse_hover_position()       // reuse position parser
    parse_completion_prefix()
    COMP_EMITTED = 0
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":{\"isIncomplete\":false,\"items\":[")
    emit_static_completions()
    emit_doc_completions()
    tx_puts("]}}")
    write_frame()
}

// ============================================================================
// Go-to-definition
// ============================================================================
//
// Best-effort declarator-keyword scan. Matches the same shapes the
// completion doc-scan does: `fn N`, `let N`, `var N`, `struct N`,
// `enum N`. First match wins. No scope tracking, no cross-file resolution
// (single-document v0). The declarator that is THE cursor itself is
// skipped so you can jump from a use site even when the cursor is on the
// declaration name.

// Result of a definition scan
var DEF_FOUND: i64 = 0
var DEF_LINE:  i64 = 0
var DEF_CHAR:  i64 = 0
var DEF_NAME_LEN: i64 = 0
// Which doc store slot owns the definition. -1 = the currently active
// DOC_TEXT (i.e. the request's own URI). >= 0 = a different open
// buffer; respond_definition will emit that slot's URI in the Location.
var DEF_SLOT:  i64 = 0 - 1

// Does DOC_TEXT[s..s+IDENT_LEN] equal IDENT_BUF?
fn doc_slice_eq_ident(s: i64) -> bool with Mut, Panic {
    if s + IDENT_LEN > DOC_TEXT_LEN { return false }
    var i: i64 = 0
    while i < IDENT_LEN {
        if (DOC_TEXT[(s + i) as usize] as i64) != (IDENT_BUF[i as usize] as i64) {
            return false
        }
        i = i + 1
    }
    return true
}

// Compute (line, char) for a byte offset inside DOC_TEXT.
fn offset_to_position(off: i64, out_line: i64) -> i64 with Mut, Panic {
    // returns (line, char) packed via globals — we use DEF_LINE/DEF_CHAR
    var line: i64 = 0
    var col: i64 = 0
    var i: i64 = 0
    while i < off && i < DOC_TEXT_LEN {
        let c = DOC_TEXT[i as usize] as i64
        if c == 10 { line = line + 1; col = 0 }
        else { col = col + 1 }
        i = i + 1
    }
    DEF_LINE = line
    DEF_CHAR = col
    return 0
}

// Walk DOC_TEXT for the first declarator-keyword followed by IDENT_BUF
// (and a non-ident-continue byte after it). Records position in
// DEF_LINE/DEF_CHAR. Sets DEF_FOUND=1 on success.
fn scan_definition_for_ident() with Mut, Panic {
    DEF_FOUND = 0
    DEF_SLOT = 0 - 1   // -1 = current active doc
    if IDENT_LEN <= 0 { return }
    var i: i64 = 0
    var done: i64 = 0
    while i < DOC_TEXT_LEN && done == 0 {
        var at_word_start: bool = false
        if i == 0 { at_word_start = true }
        else if is_ident_byte(DOC_TEXT[(i - 1) as usize] as i64) == false { at_word_start = true }
        if at_word_start == true {
            let je = read_ident_run(i)
            var is_decl: bool = false
            if je > i {
                if      ident_slice_eq(i, je, "fn")     { is_decl = true }
                else if ident_slice_eq(i, je, "let")    { is_decl = true }
                else if ident_slice_eq(i, je, "var")    { is_decl = true }
                else if ident_slice_eq(i, je, "struct") { is_decl = true }
                else if ident_slice_eq(i, je, "enum")   { is_decl = true }
            }
            if is_decl == true {
                let ns = skip_ws(je)
                let ne = read_ident_run(ns)
                let nlen = ne - ns
                if nlen == IDENT_LEN && doc_slice_eq_ident(ns) == true {
                    // Found the declaration. Record its position.
                    offset_to_position(ns, 0)
                    DEF_NAME_LEN = nlen
                    DEF_FOUND = 1
                    done = 1
                }
                if done == 0 { i = je }
            } else {
                if je > i { i = je } else { i = i + 1 }
            }
        } else {
            i = i + 1
        }
    }
}

// Cross-file fallback. On a miss in the active buffer, iterate over
// every other open doc store slot. For each, activate it temporarily,
// run the same declarator scan, and if it hits, leave DEF_SLOT set to
// that slot and DEF_LINE / DEF_CHAR pointing into it. The caller is
// responsible for restoring the originally-active slot afterwards if
// it needs the active DOC_TEXT for further work.
fn scan_definition_cross_file(home_slot: i64) with Mut, Panic {
    if DEF_FOUND == 1 { return }
    var s: i64 = 0
    while s < DOC_SLOT_COUNT && DEF_FOUND == 0 {
        if s != home_slot && DOC_SLOT_USED[s as usize] == 1 {
            slot_activate(s)
            scan_definition_for_ident()
            if DEF_FOUND == 1 { DEF_SLOT = s }
        }
        s = s + 1
    }
    // Restore the home slot so subsequent state matches the request
    // URI's buffer.
    if home_slot >= 0 { slot_activate(home_slot) }
}

// ============================================================================
// Document highlight — textDocument/documentHighlight
// ============================================================================
//
// Like references, but scoped to the active document only and returns
// DocumentHighlight[] (each entry has `range` + optional `kind`).
// Editors use this to flash all occurrences of the symbol under the
// cursor (e.g. select-occurrences-on-click in VS Code). Reuses the
// word-boundary scan from references.

// LSP DocumentHighlightKind enum
let DH_KIND_TEXT:  i64 = 1
let DH_KIND_READ:  i64 = 2
let DH_KIND_WRITE: i64 = 3

var DH_EMITTED: i64 = 0

fn dh_emit(off: i64, kind: i64) with Mut, Panic, Div {
    if DH_EMITTED == 1 { tx_putc(44) }
    DH_EMITTED = 1
    offset_to_position(off, 0)
    tx_puts("{\"range\":{\"start\":{\"line\":")
    tx_put_i64(DEF_LINE)
    tx_puts(",\"character\":")
    tx_put_i64(DEF_CHAR)
    tx_puts("},\"end\":{\"line\":")
    tx_put_i64(DEF_LINE)
    tx_puts(",\"character\":")
    tx_put_i64(DEF_CHAR + IDENT_LEN)
    tx_puts("}},\"kind\":")
    tx_put_i64(kind)
    tx_putc(125)
}

fn respond_document_highlight() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        respond_empty_result()
        return
    }
    parse_hover_position()
    var ok: i64 = 0
    if HOVER_OK == 1 {
        let n = locate_ident()
        if n > 0 { ok = 1 }
    }
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":[")
    DH_EMITTED = 0
    if ok == 1 {
        // For v0 every match is DH_KIND_TEXT (we don't do read/write
        // discrimination without a parser). DocumentHighlight clients
        // still flash them all uniformly.
        var i: i64 = 0
        while i < DOC_TEXT_LEN {
            if ref_match_at(i) == true {
                dh_emit(i, DH_KIND_TEXT)
                i = i + IDENT_LEN
            } else {
                i = i + 1
            }
        }
    }
    tx_puts("]}")
    write_frame()
}

// ============================================================================
// Prepare rename — textDocument/prepareRename
// ============================================================================
//
// Validates whether the cursor is on a renameable identifier and, if
// so, returns the range of that identifier so the editor can pre-fill
// the rename input box. If invalid (cursor on a keyword / non-ident
// byte / unknown declaration), return null so F2 doesn't trigger.

fn respond_prepare_rename() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        respond_empty_result()
        return
    }
    parse_hover_position()
    var have: i64 = 0
    if HOVER_OK == 1 {
        let n = locate_ident()
        if n > 0 {
            // Reject Sounio keywords — these can't be renamed in-
            // tree. Built-in type / effect names are technically
            // re-bindable as new identifiers in user code, so we
            // accept those; the rename will produce a TextEdit list
            // but won't reach stdlib.
            if ident_eq("fn") == false && ident_eq("let") == false &&
               ident_eq("var") == false && ident_eq("if") == false &&
               ident_eq("else") == false && ident_eq("while") == false &&
               ident_eq("return") == false && ident_eq("with") == false &&
               ident_eq("struct") == false && ident_eq("enum") == false &&
               ident_eq("match") == false && ident_eq("break") == false &&
               ident_eq("continue") == false && ident_eq("true") == false &&
               ident_eq("false") == false && ident_eq("as") == false &&
               ident_eq("pub") == false && ident_eq("use") == false &&
               ident_eq("mod") == false && ident_eq("spawn") == false &&
               ident_eq("loop") == false {
                have = 1
            }
        }
    }
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    if have == 1 {
        // Compute the exact range of the identifier under the cursor.
        // locate_ident populates IDENT_BUF but not its start position;
        // re-walk DOC_TEXT to recover it.
        var i: i64 = 0
        var line: i64 = 0
        while i < DOC_TEXT_LEN && line < HOVER_LINE {
            if (DOC_TEXT[i as usize] as i64) == 10 { line = line + 1 }
            i = i + 1
        }
        var pos = i
        var col: i64 = 0
        while col < HOVER_CHAR && pos < DOC_TEXT_LEN {
            if (DOC_TEXT[pos as usize] as i64) == 10 { pos = DOC_TEXT_LEN }
            else { pos = pos + 1; col = col + 1 }
        }
        var start = pos
        while start > i {
            let c = DOC_TEXT[(start - 1) as usize] as i64
            if is_ident_byte(c) == false { break }
            start = start - 1
        }
        var endp = pos
        while endp < DOC_TEXT_LEN {
            let c = DOC_TEXT[endp as usize] as i64
            if is_ident_byte(c) == false { break }
            endp = endp + 1
        }
        let start_col = start - i
        let end_col = endp - i
        tx_puts(",\"result\":{\"start\":{\"line\":")
        tx_put_i64(HOVER_LINE)
        tx_puts(",\"character\":")
        tx_put_i64(start_col)
        tx_puts("},\"end\":{\"line\":")
        tx_put_i64(HOVER_LINE)
        tx_puts(",\"character\":")
        tx_put_i64(end_col)
        tx_puts("}}")
    } else {
        tx_puts(",\"result\":null")
    }
    tx_puts("}")
    write_frame()
}

// ============================================================================
// Signature help — textDocument/signatureHelp
// ============================================================================
//
// Walks back from the cursor to find the innermost enclosing `(`, counts
// depth-1 commas (→ activeParameter), recovers the callee identifier
// immediately before that `(`, scans DOC_TEXT for `fn NAME(...)`, and
// emits a single SignatureInformation with the declarator line as label
// and depth-1 parameter ranges. Returns {signatures:[]} when the cursor
// is not inside a call.

fn put_signature_empty() with IO, Mut, Panic, Div {
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":{\"signatures\":[],\"activeSignature\":0,\"activeParameter\":0}}")
    write_frame()
}

// Append DOC_TEXT[start..start+len] into TX_BODY as a JSON-escaped string,
// collapsing any newline / tab / carriage-return to a single space so the
// signature label stays single-line.
fn tx_put_label_slice(start: i64, len: i64) with Mut, Panic {
    var i: i64 = 0
    while i < len {
        let c = DOC_TEXT[(start + i) as usize] as i64
        if c == 34 { tx_putc(92); tx_putc(34) }
        else if c == 92 { tx_putc(92); tx_putc(92) }
        else if c == 10 || c == 13 || c == 9 { tx_putc(32) }
        else { tx_putc(c) }
        i = i + 1
    }
}

fn respond_signature_help() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        put_signature_empty()
        return
    }
    parse_hover_position()
    if HOVER_OK == 0 { put_signature_empty(); return }

    // Convert (HOVER_LINE, HOVER_CHAR) to byte offset.
    var i: i64 = 0
    var line: i64 = 0
    while i < DOC_TEXT_LEN && line < HOVER_LINE {
        if (DOC_TEXT[i as usize] as i64) == 10 { line = line + 1 }
        i = i + 1
    }
    if line != HOVER_LINE { put_signature_empty(); return }
    var cur = i
    var col: i64 = 0
    while col < HOVER_CHAR && cur < DOC_TEXT_LEN {
        let cc = DOC_TEXT[cur as usize] as i64
        if cc == 10 { col = HOVER_CHAR } else { cur = cur + 1; col = col + 1 }
    }

    // Walk back from cur looking for `(` at depth 0. Track `)`/`(` for
    // depth and count depth-0 commas. Bail on `{` / `}` / `;` (out of a
    // call expression).
    var depth: i64 = 0
    var active: i64 = 0
    var open_paren: i64 = 0 - 1
    var p = cur - 1
    var stop: i64 = 0
    while p >= 0 && stop == 0 {
        let c = DOC_TEXT[p as usize] as i64
        if c == 41 { depth = depth + 1 }            // ')'
        else if c == 40 {                            // '('
            if depth == 0 { open_paren = p; stop = 1 }
            else { depth = depth - 1 }
        }
        else if c == 44 && depth == 0 { active = active + 1 }   // ','
        else if c == 123 || c == 125 || c == 59 {   // '{' '}' ';'
            stop = 1
        }
        if stop == 0 { p = p - 1 }
    }
    if open_paren < 0 { put_signature_empty(); return }

    // Walk back over whitespace from open_paren to find the callee ident.
    var q = open_paren - 1
    while q >= 0 {
        let c = DOC_TEXT[q as usize] as i64
        if c == 32 || c == 9 || c == 10 || c == 13 { q = q - 1 }
        else { break }
    }
    if q < 0 { put_signature_empty(); return }
    let name_end = q + 1
    if is_ident_byte(DOC_TEXT[q as usize] as i64) == false { put_signature_empty(); return }
    var name_start = q
    while name_start > 0 {
        let c = DOC_TEXT[(name_start - 1) as usize] as i64
        if is_ident_byte(c) == false { break }
        name_start = name_start - 1
    }
    // Reject numeric leading byte.
    let first = DOC_TEXT[name_start as usize] as i64
    if first >= 48 && first <= 57 { put_signature_empty(); return }

    // Copy callee name into IDENT_BUF for reuse by scan_definition_for_ident.
    IDENT_LEN = 0
    var k = name_start
    while k < name_end && IDENT_LEN < 128 {
        IDENT_BUF[IDENT_LEN as usize] = DOC_TEXT[k as usize]
        IDENT_LEN = IDENT_LEN + 1
        k = k + 1
    }
    if IDENT_LEN <= 0 { put_signature_empty(); return }

    // Scan DOC_TEXT for `fn NAME(` declaration. Walk linearly; reuse the
    // same word-start / is_decl=="fn" filter as scan_definition_for_ident
    // but require the declarator keyword to be exactly `fn`.
    var fn_name_off: i64 = 0 - 1
    var fn_paren_off: i64 = 0 - 1
    var si: i64 = 0
    while si < DOC_TEXT_LEN && fn_name_off < 0 {
        var at_word_start: bool = false
        if si == 0 { at_word_start = true }
        else if is_ident_byte(DOC_TEXT[(si - 1) as usize] as i64) == false { at_word_start = true }
        if at_word_start == true {
            let je = read_ident_run(si)
            if je > si && ident_slice_eq(si, je, "fn") {
                let ns = skip_ws(je)
                let ne = read_ident_run(ns)
                let nlen = ne - ns
                if nlen == IDENT_LEN && doc_slice_eq_ident(ns) == true {
                    // Expect `(` after optional whitespace.
                    let ps = skip_ws(ne)
                    if ps < DOC_TEXT_LEN && (DOC_TEXT[ps as usize] as i64) == 40 {
                        fn_name_off = ns
                        fn_paren_off = ps
                    }
                }
                if fn_name_off < 0 { si = je }
            } else {
                if je > si { si = je } else { si = si + 1 }
            }
        } else {
            si = si + 1
        }
    }
    if fn_name_off < 0 { put_signature_empty(); return }

    // Find matching `)` for fn_paren_off.
    var depth2: i64 = 1
    var pe = fn_paren_off + 1
    while pe < DOC_TEXT_LEN && depth2 > 0 {
        let c = DOC_TEXT[pe as usize] as i64
        if c == 40 { depth2 = depth2 + 1 }
        else if c == 41 { depth2 = depth2 - 1; if depth2 == 0 { break } }
        pe = pe + 1
    }
    if depth2 != 0 { put_signature_empty(); return }
    // close paren index = pe

    // Extend label to end of declarator: include the `-> ret` and effect
    // clause up to `{` or newline, whichever comes first.
    var label_end = pe + 1
    while label_end < DOC_TEXT_LEN {
        let c = DOC_TEXT[label_end as usize] as i64
        if c == 123 || c == 10 { break }
        label_end = label_end + 1
    }

    // Compute char offsets within the (collapsed) label for each
    // parameter. The label starts at fn_name_off - 3 ("fn " then name) —
    // we'll emit it starting at "fn" so users see the full declarator.
    var label_start = fn_name_off
    // Walk back over "fn " (3 bytes) to include the keyword.
    if fn_name_off >= 3 {
        if (DOC_TEXT[(fn_name_off - 3) as usize] as i64) == 102 &&
           (DOC_TEXT[(fn_name_off - 2) as usize] as i64) == 110 {
            label_start = fn_name_off - 3
        }
    }

    // Build parameter range list: scan fn_paren_off+1 .. pe for depth-1
    // commas. For each segment, find first/last non-whitespace byte to
    // tighten the highlight, then convert to label-relative char offsets.
    // We emit up to 32 params.
    var param_starts: [i64; 32] = [0; 32]
    var param_ends:   [i64; 32] = [0; 32]
    var n_params: i64 = 0
    var seg_start = fn_paren_off + 1
    var d3: i64 = 0
    var pp = fn_paren_off + 1
    while pp < pe {
        let c = DOC_TEXT[pp as usize] as i64
        if c == 40 { d3 = d3 + 1 }
        else if c == 41 { d3 = d3 - 1 }
        else if c == 44 && d3 == 0 {
            if n_params < 32 {
                param_starts[n_params as usize] = seg_start
                param_ends[n_params as usize] = pp
                n_params = n_params + 1
            }
            seg_start = pp + 1
        }
        pp = pp + 1
    }
    // Final segment (only if non-empty so `fn f()` yields zero params).
    var trail = seg_start
    var trail_has: i64 = 0
    while trail < pe {
        let c = DOC_TEXT[trail as usize] as i64
        if c != 32 && c != 9 && c != 10 && c != 13 { trail_has = 1; break }
        trail = trail + 1
    }
    if trail_has == 1 && n_params < 32 {
        param_starts[n_params as usize] = seg_start
        param_ends[n_params as usize] = pe
        n_params = n_params + 1
    }
    // Trim whitespace inside each param.
    var t: i64 = 0
    while t < n_params {
        var s0 = param_starts[t as usize]
        var e0 = param_ends[t as usize]
        while s0 < e0 {
            let c = DOC_TEXT[s0 as usize] as i64
            if c == 32 || c == 9 || c == 10 || c == 13 { s0 = s0 + 1 } else { break }
        }
        while e0 > s0 {
            let c = DOC_TEXT[(e0 - 1) as usize] as i64
            if c == 32 || c == 9 || c == 10 || c == 13 { e0 = e0 - 1 } else { break }
        }
        param_starts[t as usize] = s0
        param_ends[t as usize] = e0
        t = t + 1
    }
    // Clamp active to the actual param count (e.g. user typed extra `,`).
    if active > 0 && active >= n_params {
        if n_params > 0 { active = n_params - 1 } else { active = 0 }
    }

    // Emit response.
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":{\"signatures\":[{\"label\":\"")
    tx_put_label_slice(label_start, label_end - label_start)
    tx_puts("\",\"parameters\":[")
    var u: i64 = 0
    while u < n_params {
        if u > 0 { tx_putc(44) }
        let rel_s = param_starts[u as usize] - label_start
        let rel_e = param_ends[u as usize] - label_start
        tx_puts("{\"label\":[")
        tx_put_i64(rel_s)
        tx_putc(44)
        tx_put_i64(rel_e)
        tx_puts("]}")
        u = u + 1
    }
    tx_puts("],\"activeParameter\":")
    tx_put_i64(active)
    tx_puts("}],\"activeSignature\":0,\"activeParameter\":")
    tx_put_i64(active)
    tx_puts("}}")
    write_frame()
}

// ============================================================================
// Folding ranges — textDocument/foldingRange
// ============================================================================
//
// Two kinds of folds are emitted:
//   1. Brace-balanced regions: every `{` opens a fold ending at its
//      matching `}`. Folds where start_line == end_line are skipped
//      (single-line blocks aren't useful).
//   2. Multi-line `/* ... */` comments. `//` line comments are also
//      coalesced into runs of consecutive comment-only lines.
//
// Strings and char literals are respected so `{` / `}` / `/*` inside a
// "..." don't open phantom folds.
//
// Capacity: 256 folds per request (BSS arrays).

var FOLD_S: [i64; 256] = [0; 256]
var FOLD_E: [i64; 256] = [0; 256]
var FOLD_K: [i64; 256] = [0; 256]   // 0=region, 1=comment
var FOLD_N: i64 = 0

var FOLD_STK: [i64; 64] = [0; 64]
var FOLD_STK_N: i64 = 0

fn fold_push_open(line: i64) with Mut, Panic {
    if FOLD_STK_N < 64 {
        FOLD_STK[FOLD_STK_N as usize] = line
        FOLD_STK_N = FOLD_STK_N + 1
    }
}

fn fold_close(end_line: i64) with Mut, Panic {
    if FOLD_STK_N <= 0 { return }
    FOLD_STK_N = FOLD_STK_N - 1
    let s = FOLD_STK[FOLD_STK_N as usize]
    if end_line > s && FOLD_N < 256 {
        FOLD_S[FOLD_N as usize] = s
        FOLD_E[FOLD_N as usize] = end_line
        FOLD_K[FOLD_N as usize] = 0
        FOLD_N = FOLD_N + 1
    }
}

fn fold_emit_comment(s_line: i64, e_line: i64) with Mut, Panic {
    if e_line > s_line && FOLD_N < 256 {
        FOLD_S[FOLD_N as usize] = s_line
        FOLD_E[FOLD_N as usize] = e_line
        FOLD_K[FOLD_N as usize] = 1
        FOLD_N = FOLD_N + 1
    }
}

fn respond_folding_range() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        tx_reset()
        tx_puts("{\"jsonrpc\":\"2.0\",")
        tx_emit_id()
        tx_puts(",\"result\":[]}")
        write_frame()
        return
    }

    FOLD_N = 0
    FOLD_STK_N = 0

    var line: i64 = 0
    var i: i64 = 0
    // States: 0=code, 1=string ("), 2=char ('), 3=line comment, 4=block comment
    var state: i64 = 0
    // For // comments: start line of current consecutive run, or -1
    var line_cmt_start: i64 = 0 - 1
    var line_cmt_prev: i64 = 0 - 1
    var block_cmt_start: i64 = 0

    while i < DOC_TEXT_LEN {
        let c = DOC_TEXT[i as usize] as i64

        if state == 1 {
            if c == 92 && i + 1 < DOC_TEXT_LEN { i = i + 2 }
            else {
                if c == 34 { state = 0 }
                if c == 10 { line = line + 1 }
                i = i + 1
            }
        } else if state == 2 {
            if c == 92 && i + 1 < DOC_TEXT_LEN { i = i + 2 }
            else {
                if c == 39 { state = 0 }
                if c == 10 { line = line + 1 }
                i = i + 1
            }
        } else if state == 3 {
            // line comment runs until newline
            if c == 10 {
                state = 0
                // Track consecutive `//` lines.
                if line_cmt_start < 0 { line_cmt_start = line; line_cmt_prev = line }
                else if line == line_cmt_prev { line_cmt_prev = line }
                else if line == line_cmt_prev + 1 { line_cmt_prev = line }
                else {
                    fold_emit_comment(line_cmt_start, line_cmt_prev)
                    line_cmt_start = line
                    line_cmt_prev = line
                }
                line = line + 1
            }
            i = i + 1
        } else if state == 4 {
            if c == 42 && i + 1 < DOC_TEXT_LEN && (DOC_TEXT[(i + 1) as usize] as i64) == 47 {
                fold_emit_comment(block_cmt_start, line)
                state = 0
                i = i + 2
            } else {
                if c == 10 { line = line + 1 }
                i = i + 1
            }
        } else {
            // state == 0 (code)
            if c == 34 { state = 1; i = i + 1 }
            else if c == 39 { state = 2; i = i + 1 }
            else if c == 47 && i + 1 < DOC_TEXT_LEN && (DOC_TEXT[(i + 1) as usize] as i64) == 47 {
                state = 3
                i = i + 2
            } else if c == 47 && i + 1 < DOC_TEXT_LEN && (DOC_TEXT[(i + 1) as usize] as i64) == 42 {
                state = 4
                block_cmt_start = line
                i = i + 2
            } else if c == 123 {                         // '{'
                fold_push_open(line)
                i = i + 1
            } else if c == 125 {                         // '}'
                fold_close(line)
                i = i + 1
            } else {
                if c == 10 {
                    // Newline outside any comment ends a `//` run.
                    if line_cmt_start >= 0 && line_cmt_prev < line - 1 {
                        fold_emit_comment(line_cmt_start, line_cmt_prev)
                        line_cmt_start = 0 - 1
                        line_cmt_prev = 0 - 1
                    }
                    line = line + 1
                }
                i = i + 1
            }
        }
    }
    if line_cmt_start >= 0 {
        fold_emit_comment(line_cmt_start, line_cmt_prev)
    }

    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":[")
    var u: i64 = 0
    while u < FOLD_N {
        if u > 0 { tx_putc(44) }
        tx_puts("{\"startLine\":")
        tx_put_i64(FOLD_S[u as usize])
        tx_puts(",\"endLine\":")
        tx_put_i64(FOLD_E[u as usize])
        if FOLD_K[u as usize] == 1 {
            tx_puts(",\"kind\":\"comment\"")
        } else {
            tx_puts(",\"kind\":\"region\"")
        }
        tx_putc(125)
        u = u + 1
    }
    tx_puts("]}")
    write_frame()
}

// ============================================================================
// Workspace symbol search — workspace/symbol
// ============================================================================
//
// Iterates every active document slot, scans its DOC_TEXT for fn / struct
// / enum / let / var declarations (same recipe as documentSymbol), filters
// names by case-insensitive substring against `params.query`, and emits a
// SymbolInformation[] with `location: {uri, range}`. An empty query
// returns all symbols (capped at 256 results).

let WSYM_CAP: i64 = 256
var WSYM_QUERY: [i8; 64] = [0; 64]
var WSYM_QUERY_LEN: i64 = 0
var WSYM_EMITTED: i64 = 0
var WSYM_COUNT:   i64 = 0

// Sprint-2 #7: cross-file workspace/symbol. ROOT_URI is captured from
// initialize params; WS_* scratch buffers back the getdents64 walk.
var ROOT_URI: [i8; 1024] = [0; 1024]
var ROOT_URI_LEN: i64 = 0
var WS_DENTS: [i8; 4096] = [0; 4096]
var WS_PATH: [i8; 1024] = [0; 1024]

// Capture params.rootUri from an initialize request body.
fn capture_root_uri() with Mut, Panic {
    ROOT_URI_LEN = 0
    let pos = body_find("\"rootUri\"", 0)
    if pos < 0 { return }
    var i = pos + 10
    var saw_quote: i64 = 0
    while i < RX_BODY_LEN && saw_quote == 0 {
        let c = RX_BODY[i as usize] as i64
        if c == 34 { saw_quote = 1 }
        i = i + 1
    }
    if saw_quote == 0 { return }
    while i < RX_BODY_LEN && ROOT_URI_LEN < 1024 {
        let c = RX_BODY[i as usize] as i64
        if c == 34 { return }
        ROOT_URI[ROOT_URI_LEN as usize] = c as i8
        ROOT_URI_LEN = ROOT_URI_LEN + 1
        i = i + 1
    }
}

// Unsigned byte helper for parsing getdents64 records (i8 is signed).
fn ub(b: i64) -> i64 {
    if b < 0 { return b + 256 }
    b
}

// Convert ROOT_URI ("file:///a/b") to a NUL-terminated path in WS_PATH.
// Returns path length (excluding NUL).
fn ws_root_to_path() -> i64 with Mut {
    var s: i64 = 0
    if ROOT_URI_LEN >= 7 {
        s = 7
    }
    var n: i64 = 0
    var i = s
    while i < ROOT_URI_LEN && n < 1000 {
        WS_PATH[n as usize] = ROOT_URI[i as usize]
        n = n + 1
        i = i + 1
    }
    WS_PATH[n as usize] = 0
    return n
}

// Scan one workspace file whose NUL-terminated full path is in WS_PATH.
// Builds the file:// URI into DOC_URI, skips files already open as
// document slots (dedup), loads the text into a transient slot and
// runs the same declaration scanner used for open documents.
fn wsym_scan_ws_file() with IO, Mut, Panic, Div {
    // URI form: "file://" + "/a/b/f.sio" == "file:///a/b/f.sio", matching
    // didOpen URIs so the open-slot dedup below is reliable.
    DOC_URI_LEN = 0
    let prefix = "file://"
    var pi: i64 = 0
    while pi < 7 {
        DOC_URI[DOC_URI_LEN as usize] = str_char_at(prefix, pi) as i8
        DOC_URI_LEN = DOC_URI_LEN + 1
        pi = pi + 1
    }
    var i: i64 = 0
    while i < 1024 && DOC_URI_LEN < 1020 {
        let c = WS_PATH[i as usize] as i64
        if c == 0 { i = 1024 } else {
            DOC_URI[DOC_URI_LEN as usize] = c as i8
            DOC_URI_LEN = DOC_URI_LEN + 1
            i = i + 1
        }
    }
    if slot_find_by_uri() >= 0 { return }
    let fd = syscall6(2, &! WS_PATH, 0, 0, 0, 0, 0)
    if fd < 0 { return }
    let total = syscall6(0, fd, &! DOC_TEXT, 262144, 0, 0, 0)
    syscall6(3, fd, 0, 0, 0, 0, 0)
    if total <= 0 { return }
    DOC_TEXT_LEN = total
    let s = slot_alloc_for_uri()
    if s < 0 { return }
    slot_set_text(s)
    slot_activate(s)
    wsym_scan_active_slot(s)
    slot_release(s)
}

// Walk ROOT_URI's directory with getdents64 (one level, regular *.sio
// files only) and scan each file for workspace symbols.
fn wsym_scan_workspace_files() with IO, Mut, Panic, Div {
    if ROOT_URI_LEN <= 0 { return }
    if WSYM_COUNT >= WSYM_CAP { return }
    let root_len = ws_root_to_path()
    if root_len <= 0 { return }
    // open(root, O_RDONLY | O_DIRECTORY=65536)
    let dfd = syscall6(2, &! WS_PATH, 65536, 0, 0, 0, 0)
    if dfd < 0 { return }
    var eof: i64 = 0
    while eof == 0 && WSYM_COUNT < WSYM_CAP {
        let nread = syscall6(217, dfd, &! WS_DENTS, 4096, 0, 0, 0)
        if nread <= 0 {
            eof = 1
        } else {
            var pos: i64 = 0
            while pos < nread && WSYM_COUNT < WSYM_CAP {
                let reclen = ub(WS_DENTS[(pos + 16) as usize] as i64) + ub(WS_DENTS[(pos + 17) as usize] as i64) * 256
                // d_name at offset 19, NUL-terminated within the record.
                var name_len: i64 = 0
                var nul_seen: i64 = 0
                while name_len < 255 && nul_seen == 0 && (pos + 19 + name_len) < nread {
                    if (WS_DENTS[(pos + 19 + name_len) as usize] as i64) == 0 {
                        nul_seen = 1
                    } else {
                        name_len = name_len + 1
                    }
                }
                // *.sio suffix: 46 115 105 111
                var is_sio: i64 = 0
                if name_len > 4 {
                    let e = pos + 19 + name_len
                    if (WS_DENTS[(e - 4) as usize] as i64) == 46 && (WS_DENTS[(e - 3) as usize] as i64) == 115 && (WS_DENTS[(e - 2) as usize] as i64) == 105 && (WS_DENTS[(e - 1) as usize] as i64) == 111 {
                        is_sio = 1
                    }
                }
                if is_sio == 1 {
                    // Rebuild WS_PATH = root + "/" + name + NUL.
                    let rl = ws_root_to_path()
                    var m = rl
                    WS_PATH[m as usize] = 47
                    m = m + 1
                    var k: i64 = 0
                    while k < name_len && m < 1000 {
                        WS_PATH[m as usize] = WS_DENTS[(pos + 19 + k) as usize]
                        m = m + 1
                        k = k + 1
                    }
                    WS_PATH[m as usize] = 0
                    wsym_scan_ws_file()
                }
                if reclen <= 0 {
                    pos = nread
                } else {
                    pos = pos + reclen
                }
            }
        }
    }
    syscall6(3, dfd, 0, 0, 0, 0, 0)
}

fn lower_byte(b: i64) -> i64 {
    if b >= 65 && b <= 90 { return b + 32 }
    b
}

// case-insensitive contains: does DOC_TEXT[ns..ns+nlen] contain WSYM_QUERY?
fn wsym_name_matches(ns: i64, nlen: i64) -> bool with Mut, Panic {
    if WSYM_QUERY_LEN <= 0 { return true }
    if nlen < WSYM_QUERY_LEN { return false }
    var i: i64 = 0
    let last = nlen - WSYM_QUERY_LEN
    while i <= last {
        var k: i64 = 0
        var hit: bool = true
        while k < WSYM_QUERY_LEN {
            let a = lower_byte(DOC_TEXT[(ns + i + k) as usize] as i64)
            let b = lower_byte(WSYM_QUERY[k as usize] as i64)
            if a != b { hit = false; break }
            k = k + 1
        }
        if hit == true { return true }
        i = i + 1
    }
    return false
}

fn wsym_emit(slot: i64, ns: i64, nlen: i64, kind: i64) with Mut, Panic, Div {
    if WSYM_EMITTED == 1 { tx_putc(44) }
    WSYM_EMITTED = 1
    WSYM_COUNT = WSYM_COUNT + 1
    offset_to_position(ns, 0)
    tx_puts("{\"name\":\"")
    var i: i64 = 0
    while i < nlen {
        let c = DOC_TEXT[(ns + i) as usize] as i64
        if c == 34 { tx_putc(92); tx_putc(34) }
        else if c == 92 { tx_putc(92); tx_putc(92) }
        else { tx_putc(c) }
        i = i + 1
    }
    tx_puts("\",\"kind\":")
    tx_put_i64(kind)
    tx_puts(",\"location\":{\"uri\":\"")
    let base = slot * 1024
    let ulen = DOC_SLOT_URI_LEN[slot as usize]
    var j: i64 = 0
    while j < ulen {
        let c = DOC_SLOT_URI[(base + j) as usize] as i64
        if c == 34 { tx_putc(92); tx_putc(34) }
        else if c == 92 { tx_putc(92); tx_putc(92) }
        else { tx_putc(c) }
        j = j + 1
    }
    tx_puts("\",\"range\":{\"start\":{\"line\":")
    tx_put_i64(DEF_LINE)
    tx_puts(",\"character\":")
    tx_put_i64(DEF_CHAR)
    tx_puts("},\"end\":{\"line\":")
    tx_put_i64(DEF_LINE)
    tx_puts(",\"character\":")
    tx_put_i64(DEF_CHAR + nlen)
    tx_puts("}}}}")
}

fn wsym_scan_active_slot(slot: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < DOC_TEXT_LEN && WSYM_COUNT < WSYM_CAP {
        var at_word_start: bool = false
        if i == 0 { at_word_start = true }
        else if is_ident_byte(DOC_TEXT[(i - 1) as usize] as i64) == false { at_word_start = true }
        if at_word_start == false { i = i + 1 }
        else {
            let je = read_ident_run(i)
            if je == i { i = i + 1 }
            else {
                var kw_start = i
                var kw_end   = je
                if ident_slice_eq(kw_start, kw_end, "pub") == true {
                    let kw2_s = skip_ws(kw_end)
                    let kw2_e = read_ident_run(kw2_s)
                    if kw2_e > kw2_s { kw_start = kw2_s; kw_end = kw2_e }
                }
                var kind: i64 = 0
                if      ident_slice_eq(kw_start, kw_end, "fn")     { kind = SK_FUNCTION }
                else if ident_slice_eq(kw_start, kw_end, "struct") { kind = SK_STRUCT }
                else if ident_slice_eq(kw_start, kw_end, "enum")   { kind = SK_ENUM }
                else if ident_slice_eq(kw_start, kw_end, "let")    { kind = SK_VARIABLE }
                else if ident_slice_eq(kw_start, kw_end, "var")    { kind = SK_VARIABLE }
                if kind != 0 {
                    let ns = skip_ws(kw_end)
                    let ne = read_ident_run(ns)
                    let nlen = ne - ns
                    if nlen > 0 && wsym_name_matches(ns, nlen) == true {
                        wsym_emit(slot, ns, nlen, kind)
                    }
                    if ne > kw_end { i = ne } else { i = kw_end }
                } else {
                    i = je
                }
            }
        }
    }
}

fn respond_workspace_symbol() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    // Madaros gap: a &! borrow of a GLOBAL array passed as a normal function
    // parameter persists only the first byte written through it (locals are
    // fine). Extract into a local, then copy into the global — direct global
    // element writes work.
    var qtmp: [i8; 64] = [0; 64]
    WSYM_QUERY_LEN = body_extract_str("\"query\"", &! qtmp, 64)
    if WSYM_QUERY_LEN < 0 { WSYM_QUERY_LEN = 0 }
    var qi: i64 = 0
    while qi < WSYM_QUERY_LEN {
        WSYM_QUERY[qi as usize] = qtmp[qi as usize]
        qi = qi + 1
    }

    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":[")
    WSYM_EMITTED = 0
    WSYM_COUNT = 0
    var s: i64 = 0
    while s < 8 && WSYM_COUNT < WSYM_CAP {
        if DOC_SLOT_URI_LEN[s as usize] > 0 {
            slot_activate(s)
            wsym_scan_active_slot(s)
        }
        s = s + 1
    }
    // Sprint-2 #7: also scan *.sio files under rootUri (cross-file).
    wsym_scan_workspace_files()
    tx_puts("]}")
    write_frame()
}

// ============================================================================
// Sprint-2 #6 — type hierarchy
// ============================================================================
//
// Sounio's nominal type relations come from `impl Trait for Type`:
//   - supertypes(struct/enum S) = traits A with `impl A for S` in the doc
//   - subtypes(trait T)         = types B with `impl T for B` in the doc
// There is no struct/enum inheritance, so structs have no subtypes and
// traits have no supertypes. Scope is the active document (same scanner
// recipe as documentSymbol). prepareTypeHierarchy resolves the identifier
// under the cursor to a struct/enum/trait/algebra declaration; when the
// identifier is not a declared type the result is null.

var TH_NAME: [i8; 64] = [0; 64]
var TH_NAME_LEN: i64 = 0
var TH_KEEP: [i8; 64] = [0; 64]
var TH_KEEP_LEN: i64 = 0
var TH_KIND: i64 = 0
var TH_DECL_S: i64 = 0
var TH_DECL_E: i64 = 0
var TH_NAME_S: i64 = 0
var TH_NAME_E: i64 = 0
var TH_EMITTED: i64 = 0

// True if DOC_TEXT[ns..ne] equals TH_NAME.
fn th_name_eq(ns: i64, ne: i64) -> bool with Mut, Panic {
    if (ne - ns) != TH_NAME_LEN { return false }
    var i: i64 = 0
    while i < TH_NAME_LEN {
        if (DOC_TEXT[(ns + i) as usize] as i64) != (TH_NAME[i as usize] as i64) { return false }
        i = i + 1
    }
    return true
}

// Decl end: from `from`, find the first `{` within 1024 bytes and return
// the offset just past its matching `}` (naive brace balance, no string
// awareness — same pragmatics as the rest of the server). A `;` first
// means a bodyless declaration. Falls back to `from` when no brace.
fn th_block_end(from: i64) -> i64 with Mut, Panic {
    var i = from
    let limit = from + 1024
    var found: i64 = 0 - 1
    while i < DOC_TEXT_LEN && i < limit && found < 0 {
        let c = DOC_TEXT[i as usize] as i64
        if c == 123 {
            found = i
        } else if c == 59 {
            return i + 1
        }
        i = i + 1
    }
    if found < 0 { return from }
    var depth: i64 = 0
    var j = found
    while j < DOC_TEXT_LEN {
        let c = DOC_TEXT[j as usize] as i64
        if c == 123 {
            depth = depth + 1
        } else if c == 125 {
            depth = depth - 1
            if depth == 0 { return j + 1 }
        }
        j = j + 1
    }
    return DOC_TEXT_LEN
}

// Find TH_NAME's struct/enum/trait/algebra declaration in DOC_TEXT.
// Sets TH_KIND/TH_DECL_S/TH_DECL_E/TH_NAME_S/TH_NAME_E on success.
// LSP SymbolKind: 10=Enum, 11=Interface (trait), 23=Struct.
fn th_find_type_decl() -> bool with Mut, Panic {
    var i: i64 = 0
    while i < DOC_TEXT_LEN {
        var at_word_start: bool = false
        if i == 0 { at_word_start = true }
        else if is_ident_byte(DOC_TEXT[(i - 1) as usize] as i64) == false { at_word_start = true }
        if at_word_start == false {
            i = i + 1
        } else {
            let je = read_ident_run(i)
            if je == i {
                i = i + 1
            } else {
                var kind: i64 = 0
                if ident_slice_eq(i, je, "struct") {
                    kind = 23
                } else if ident_slice_eq(i, je, "enum") {
                    kind = 10
                } else if ident_slice_eq(i, je, "trait") {
                    kind = 11
                } else if ident_slice_eq(i, je, "algebra") {
                    kind = 23
                }
                if kind == 0 {
                    i = je
                } else {
                    let ns = skip_ws(je)
                    let ne = read_ident_run(ns)
                    if ne > ns && th_name_eq(ns, ne) == true {
                        TH_KIND = kind
                        TH_DECL_S = i
                        TH_NAME_S = ns
                        TH_NAME_E = ne
                        TH_DECL_E = th_block_end(ne)
                        return true
                    }
                    if ne > ns { i = ne } else { i = je }
                }
            }
        }
    }
    return false
}

// Emit an LSP range for DOC_TEXT offsets [s, e).
fn th_emit_range(s: i64, e: i64) with Mut, Panic, Div {
    offset_to_position(s, 0)
    tx_puts("{\"start\":{\"line\":")
    tx_put_i64(DEF_LINE)
    tx_puts(",\"character\":")
    tx_put_i64(DEF_CHAR)
    tx_puts("},\"end\":")
    offset_to_position(e, 0)
    tx_puts("{\"line\":")
    tx_put_i64(DEF_LINE)
    tx_puts(",\"character\":")
    tx_put_i64(DEF_CHAR)
    tx_puts("}}")
}

// Emit one TypeHierarchyItem. Name is DOC_TEXT[ns..ne]; kind is the LSP
// SymbolKind; [rs,re) is the decl range, [ss,se) the selection range.
fn th_emit_item(ns: i64, ne: i64, kind: i64, rs: i64, re: i64, ss: i64, se: i64) with Mut, Panic, Div {
    if TH_EMITTED == 1 { tx_putc(44) }
    TH_EMITTED = 1
    tx_puts("{\"name\":\"")
    var i = ns
    while i < ne {
        let c = DOC_TEXT[i as usize] as i64
        if c == 34 { tx_putc(92); tx_putc(34) }
        else if c == 92 { tx_putc(92); tx_putc(92) }
        else { tx_putc(c) }
        i = i + 1
    }
    tx_puts("\",\"kind\":")
    tx_put_i64(kind)
    tx_puts(",\"uri\":\"")
    var u: i64 = 0
    while u < DOC_URI_LEN {
        let c = DOC_URI[u as usize] as i64
        if c == 34 { tx_putc(92); tx_putc(34) }
        else if c == 92 { tx_putc(92); tx_putc(92) }
        else { tx_putc(c) }
        u = u + 1
    }
    tx_puts("\",\"range\":")
    th_emit_range(rs, re)
    tx_puts(",\"selectionRange\":")
    th_emit_range(ss, se)
    tx_puts("}")
}

// Emit a related-type item for DOC_TEXT[ns..ne]: prefer the declaration
// site (kind + full range) when that type is declared in this document,
// otherwise emit at the impl-site token with fallback_kind.
fn th_emit_related(ns: i64, ne: i64, fallback_kind: i64) with Mut, Panic, Div {
    TH_KEEP_LEN = TH_NAME_LEN
    var k: i64 = 0
    while k < TH_NAME_LEN {
        TH_KEEP[k as usize] = TH_NAME[k as usize]
        k = k + 1
    }
    TH_NAME_LEN = ne - ns
    if TH_NAME_LEN > 64 { TH_NAME_LEN = 64 }
    k = 0
    while k < TH_NAME_LEN {
        TH_NAME[k as usize] = DOC_TEXT[(ns + k) as usize]
        k = k + 1
    }
    if th_find_type_decl() == true {
        th_emit_item(TH_NAME_S, TH_NAME_E, TH_KIND, TH_DECL_S, TH_DECL_E, TH_NAME_S, TH_NAME_E)
    } else {
        th_emit_item(ns, ne, fallback_kind, ns, ne, ns, ne)
    }
    TH_NAME_LEN = TH_KEEP_LEN
    k = 0
    while k < TH_KEEP_LEN {
        TH_NAME[k as usize] = TH_KEEP[k as usize]
        k = k + 1
    }
}

// Walk `impl A for B` statements. mode 1 (supertypes): B==TH_NAME → emit
// trait A. mode 2 (subtypes): A==TH_NAME → emit implementor B.
fn th_scan_impls(mode: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < DOC_TEXT_LEN {
        var at_word_start: bool = false
        if i == 0 { at_word_start = true }
        else if is_ident_byte(DOC_TEXT[(i - 1) as usize] as i64) == false { at_word_start = true }
        if at_word_start == false {
            i = i + 1
        } else {
            let je = read_ident_run(i)
            if je == i {
                i = i + 1
            } else if ident_slice_eq(i, je, "impl") == false {
                i = je
            } else {
                let a_s = skip_ws(je)
                let a_e = read_ident_run(a_s)
                if a_e <= a_s {
                    i = je
                } else {
                    let b_s = skip_ws(a_e)
                    let b_e = read_ident_run(b_s)
                    if b_e > b_s && ident_slice_eq(b_s, b_e, "for") == true {
                        let c_s = skip_ws(b_e)
                        let c_e = read_ident_run(c_s)
                        if c_e > c_s {
                            if mode == 1 {
                                if th_name_eq(c_s, c_e) == true {
                                    th_emit_related(a_s, a_e, 11)
                                }
                            } else {
                                if th_name_eq(a_s, a_e) == true {
                                    th_emit_related(c_s, c_e, 23)
                                }
                            }
                        }
                    }
                    i = a_e
                }
            }
        }
    }
}

fn respond_prepare_type_hierarchy() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        respond_empty_result()
        return
    }
    parse_hover_position()
    if HOVER_OK == 0 {
        respond_empty_result()
        return
    }
    if locate_ident() <= 0 {
        respond_empty_result()
        return
    }
    TH_NAME_LEN = 0
    var i: i64 = 0
    while i < IDENT_LEN && i < 64 {
        TH_NAME[i as usize] = IDENT_BUF[i as usize]
        TH_NAME_LEN = TH_NAME_LEN + 1
        i = i + 1
    }
    if th_find_type_decl() == false {
        respond_empty_result()
        return
    }
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":[")
    TH_EMITTED = 0
    th_emit_item(TH_NAME_S, TH_NAME_E, TH_KIND, TH_DECL_S, TH_DECL_E, TH_NAME_S, TH_NAME_E)
    tx_puts("]}")
    write_frame()
}

// Shared tail for supertypes/subtypes: pull item.name + item.uri from
// params, activate the slot, scan impls, emit the item array.
fn respond_type_hierarchy_related(mode: i64) with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    // Same Madaros &!-global-param gap as respond_workspace_symbol: extract
    // into a local first, then copy into the global.
    var ntmp: [i8; 64] = [0; 64]
    TH_NAME_LEN = body_extract_str("\"name\"", &! ntmp, 64)
    var ni: i64 = 0
    while ni < TH_NAME_LEN {
        TH_NAME[ni as usize] = ntmp[ni as usize]
        ni = ni + 1
    }
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":[")
    TH_EMITTED = 0
    if TH_NAME_LEN > 0 {
        if extract_doc_uri() >= 0 {
            let s = slot_find_by_uri()
            if s >= 0 {
                slot_activate(s)
                th_scan_impls(mode)
            }
        }
    }
    tx_puts("]}")
    write_frame()
}

fn respond_type_hierarchy_supertypes() with IO, Mut, Panic, Div {
    respond_type_hierarchy_related(1)
}

fn respond_type_hierarchy_subtypes() with IO, Mut, Panic, Div {
    respond_type_hierarchy_related(2)
}

// ============================================================================
// Selection range — textDocument/selectionRange
// ============================================================================
//
// For each cursor position in params.positions[], emit a nested
// SelectionRange chain:
//   token range → enclosing (), [] or {} → ... → whole file
//
// Strings/chars/comments aren't fully respected here (kept simple): the
// editor only uses this for smart-select, so a balanced-bracket walk is
// good enough in practice for code regions and harmless inside strings.

let SR_MAX_POS: i64 = 16
var SR_LINES: [i64; 16] = [0; 16]
var SR_CHARS: [i64; 16] = [0; 16]
var SR_N: i64 = 0

// Each level of the chain stores (start_off, end_off). Up to 32 levels.
var SR_OS: [i64; 32] = [0; 32]
var SR_OE: [i64; 32] = [0; 32]
var SR_LEVELS: i64 = 0

fn sr_parse_positions() with Mut, Panic, Div {
    SR_N = 0
    // Walk RX_BODY looking for "line" / "character" pairs in order. A
    // position object has both. We require both keys to be found within
    // the same scan step and consume them sequentially.
    var i: i64 = 0
    while i < RX_BODY_LEN && SR_N < SR_MAX_POS {
        let lp = body_find("\"line\"", i)
        if lp < 0 { break }
        let cp = body_find("\"character\"", lp)
        if cp < 0 { break }
        let ln = body_read_int_after(lp + 6)
        let ch = body_read_int_after(cp + 11)
        if ln < 0 || ch < 0 { break }
        SR_LINES[SR_N as usize] = ln
        SR_CHARS[SR_N as usize] = ch
        SR_N = SR_N + 1
        // Advance past whichever comes later.
        if cp > lp { i = cp + 11 } else { i = lp + 6 }
    }
}

fn sr_pos_to_offset(ln: i64, ch: i64) -> i64 with Mut, Panic {
    var i: i64 = 0
    var line: i64 = 0
    while i < DOC_TEXT_LEN && line < ln {
        if (DOC_TEXT[i as usize] as i64) == 10 { line = line + 1 }
        i = i + 1
    }
    if line != ln { return DOC_TEXT_LEN }
    var col: i64 = 0
    while col < ch && i < DOC_TEXT_LEN {
        let c = DOC_TEXT[i as usize] as i64
        if c == 10 { return i }
        i = i + 1
        col = col + 1
    }
    return i
}

// Walk outward from `cur` finding the innermost enclosing pair of
// (open, close) brackets. Stores result in *_OS / *_OE level.
fn sr_find_outer(cur_s: i64, cur_e: i64, open_b: i64, close_b: i64) -> bool with Mut, Panic {
    var d: i64 = 0
    var p = cur_s - 1
    var open_off: i64 = 0 - 1
    while p >= 0 {
        let c = DOC_TEXT[p as usize] as i64
        if c == close_b { d = d + 1 }
        else if c == open_b {
            if d == 0 { open_off = p; p = 0 - 1; break }
            else { d = d - 1 }
        }
        p = p - 1
    }
    if open_off < 0 { return false }
    var d2: i64 = 0
    var q = cur_e
    var close_off: i64 = 0 - 1
    while q < DOC_TEXT_LEN {
        let c = DOC_TEXT[q as usize] as i64
        if c == open_b { d2 = d2 + 1 }
        else if c == close_b {
            if d2 == 0 { close_off = q + 1; break }
            else { d2 = d2 - 1 }
        }
        q = q + 1
    }
    if close_off < 0 { return false }
    // Push two levels: inside-brackets (exclusive of the delimiters)
    // and the brackets themselves (inclusive).
    if SR_LEVELS < 32 {
        SR_OS[SR_LEVELS as usize] = open_off + 1
        SR_OE[SR_LEVELS as usize] = close_off - 1
        SR_LEVELS = SR_LEVELS + 1
    }
    if SR_LEVELS < 32 {
        SR_OS[SR_LEVELS as usize] = open_off
        SR_OE[SR_LEVELS as usize] = close_off
        SR_LEVELS = SR_LEVELS + 1
    }
    return true
}

fn sr_build_chain(cur: i64) with Mut, Panic {
    SR_LEVELS = 0
    // Innermost level: identifier under cursor, if any. Otherwise
    // 1-byte span (or 0-byte at EOF).
    var s: i64 = cur
    var e: i64 = cur
    if cur < DOC_TEXT_LEN && is_ident_byte(DOC_TEXT[cur as usize] as i64) == true {
        while s > 0 {
            let c = DOC_TEXT[(s - 1) as usize] as i64
            if is_ident_byte(c) == false { break }
            s = s - 1
        }
        e = cur
        while e < DOC_TEXT_LEN {
            let c = DOC_TEXT[e as usize] as i64
            if is_ident_byte(c) == false { break }
            e = e + 1
        }
    } else if cur < DOC_TEXT_LEN {
        e = cur + 1
    }
    SR_OS[0] = s
    SR_OE[0] = e
    SR_LEVELS = 1

    // Expand outward through (), [], {} in turn. Each call adds 2
    // levels (inside + brackets) when it finds a match.
    var changed: bool = true
    while changed == true && SR_LEVELS < 30 {
        changed = false
        let cs = SR_OS[(SR_LEVELS - 1) as usize]
        let ce = SR_OE[(SR_LEVELS - 1) as usize]
        // Try the *closest* enclosing of any kind by finding all three
        // and picking the innermost.
        var best_open: i64 = 0 - 1
        var best_close: i64 = 0 - 1
        var best_pair_open: i64 = 0
        var best_pair_close: i64 = 0
        // ( )
        if sr_find_outer(cs, ce, 40, 41) == true {
            let new_open = SR_OS[(SR_LEVELS - 2) as usize] - 1
            let new_close = SR_OE[(SR_LEVELS - 2) as usize] + 1
            best_open = new_open
            best_close = new_close
            best_pair_open = 40
            best_pair_close = 41
            // Pop the two we just pushed; we'll re-push the winner.
            SR_LEVELS = SR_LEVELS - 2
        }
        // [ ]
        if sr_find_outer(cs, ce, 91, 93) == true {
            let new_open = SR_OS[(SR_LEVELS - 2) as usize] - 1
            let new_close = SR_OE[(SR_LEVELS - 2) as usize] + 1
            if best_open < 0 || new_open > best_open {
                best_open = new_open
                best_close = new_close
                best_pair_open = 91
                best_pair_close = 93
            }
            SR_LEVELS = SR_LEVELS - 2
        }
        // { }
        if sr_find_outer(cs, ce, 123, 125) == true {
            let new_open = SR_OS[(SR_LEVELS - 2) as usize] - 1
            let new_close = SR_OE[(SR_LEVELS - 2) as usize] + 1
            if best_open < 0 || new_open > best_open {
                best_open = new_open
                best_close = new_close
                best_pair_open = 123
                best_pair_close = 125
            }
            SR_LEVELS = SR_LEVELS - 2
        }
        if best_open >= 0 {
            if SR_LEVELS < 32 {
                SR_OS[SR_LEVELS as usize] = best_open + 1
                SR_OE[SR_LEVELS as usize] = best_close - 1
                SR_LEVELS = SR_LEVELS + 1
            }
            if SR_LEVELS < 32 {
                SR_OS[SR_LEVELS as usize] = best_open
                SR_OE[SR_LEVELS as usize] = best_close
                SR_LEVELS = SR_LEVELS + 1
            }
            changed = true
        }
    }
    // Outermost: whole file.
    if SR_LEVELS < 32 {
        SR_OS[SR_LEVELS as usize] = 0
        SR_OE[SR_LEVELS as usize] = DOC_TEXT_LEN
        SR_LEVELS = SR_LEVELS + 1
    }
}

fn sr_emit_chain_level(idx: i64) with Mut, Panic, Div {
    let so = SR_OS[idx as usize]
    let eo = SR_OE[idx as usize]
    offset_to_position(so, 0)
    let s_line = DEF_LINE
    let s_char = DEF_CHAR
    offset_to_position(eo, 0)
    let e_line = DEF_LINE
    let e_char = DEF_CHAR
    tx_puts("{\"range\":{\"start\":{\"line\":")
    tx_put_i64(s_line)
    tx_puts(",\"character\":")
    tx_put_i64(s_char)
    tx_puts("},\"end\":{\"line\":")
    tx_put_i64(e_line)
    tx_puts(",\"character\":")
    tx_put_i64(e_char)
    // Closes start/end → "end":{...}, range:{...}. No outer `}` yet.
    tx_puts("}}")
    if idx + 1 < SR_LEVELS {
        tx_puts(",\"parent\":")
        sr_emit_chain_level(idx + 1)
    }
    tx_putc(125)
}

fn respond_selection_range() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        tx_reset()
        tx_puts("{\"jsonrpc\":\"2.0\",")
        tx_emit_id()
        tx_puts(",\"result\":[]}")
        write_frame()
        return
    }
    sr_parse_positions()

    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":[")
    var k: i64 = 0
    while k < SR_N {
        if k > 0 { tx_putc(44) }
        let off = sr_pos_to_offset(SR_LINES[k as usize], SR_CHARS[k as usize])
        sr_build_chain(off)
        sr_emit_chain_level(0)
        k = k + 1
    }
    tx_puts("]}")
    write_frame()
}

// ============================================================================
// Inlay hints — textDocument/inlayHint
// ============================================================================
//
// Emits param-name hints at call sites. For each `IDENT(` that is not a
// declaration (i.e. not preceded by `fn`/`struct`/`enum`), look up the
// fn declaration in the same buffer, parse its param names, and emit
// one InlayHint per supplied argument at the argument's first non-ws
// position with label `"name:"` and kind 2 (Parameter).
//
// String, char, and comment scanning is done with the same tiny state
// machine used by foldingRange so `foo(` inside a string doesn't fire.
// Capped at 256 hints.

let IH_CAP: i64 = 256
var IH_EMITTED: i64 = 0
var IH_COUNT:   i64 = 0

// Buffer for the current callee identifier (separate from IDENT_BUF so
// fn-lookup helpers can reuse IDENT_BUF without clobbering).
var IH_NAME: [i8; 64] = [0; 64]
var IH_NAME_LEN: i64 = 0

// Buffer for one param-name slice (start, end offsets in DOC_TEXT).
var IH_PNAMES_S: [i64; 16] = [0; 16]
var IH_PNAMES_E: [i64; 16] = [0; 16]
var IH_NPARAMS: i64 = 0

fn ih_set_name(s: i64, e: i64) with Mut, Panic {
    IH_NAME_LEN = 0
    var i = s
    while i < e && IH_NAME_LEN < 64 {
        IH_NAME[IH_NAME_LEN as usize] = DOC_TEXT[i as usize]
        IH_NAME_LEN = IH_NAME_LEN + 1
        i = i + 1
    }
}

fn ih_name_eq_doc(ds: i64, de: i64) -> bool with Mut, Panic {
    let dl = de - ds
    if dl != IH_NAME_LEN { return false }
    var i: i64 = 0
    while i < dl {
        if (DOC_TEXT[(ds + i) as usize] as i64) != (IH_NAME[i as usize] as i64) {
            return false
        }
        i = i + 1
    }
    return true
}

// Find `fn NAME(...)` declaration. Returns offset of `(` or -1.
fn ih_find_fn_paren() -> i64 with Mut, Panic {
    var i: i64 = 0
    while i < DOC_TEXT_LEN {
        var at_word_start: bool = false
        if i == 0 { at_word_start = true }
        else if is_ident_byte(DOC_TEXT[(i - 1) as usize] as i64) == false { at_word_start = true }
        if at_word_start == true {
            let je = read_ident_run(i)
            if je > i && ident_slice_eq(i, je, "fn") {
                let ns = skip_ws(je)
                let ne = read_ident_run(ns)
                if ne > ns && ih_name_eq_doc(ns, ne) == true {
                    let ps = skip_ws(ne)
                    if ps < DOC_TEXT_LEN && (DOC_TEXT[ps as usize] as i64) == 40 {
                        return ps
                    }
                }
                if je > i { i = je } else { i = i + 1 }
            } else {
                if je > i { i = je } else { i = i + 1 }
            }
        } else {
            i = i + 1
        }
    }
    return 0 - 1
}

// Extract param names from `fn NAME(...)`. paren_off points at `(`.
fn ih_parse_param_names(paren_off: i64) with Mut, Panic {
    IH_NPARAMS = 0
    var i = paren_off + 1
    var d: i64 = 0
    var seg_start = i
    while i < DOC_TEXT_LEN {
        let c = DOC_TEXT[i as usize] as i64
        if c == 40 { d = d + 1 }
        else if c == 41 {
            if d == 0 {
                // final segment
                ih_take_pname(seg_start, i)
                return
            }
            d = d - 1
        } else if c == 44 && d == 0 {
            ih_take_pname(seg_start, i)
            seg_start = i + 1
        }
        i = i + 1
    }
}

fn ih_take_pname(s: i64, e: i64) with Mut, Panic {
    if IH_NPARAMS >= 16 { return }
    // Skip leading whitespace.
    var a = s
    while a < e {
        let c = DOC_TEXT[a as usize] as i64
        if c == 32 || c == 9 || c == 10 || c == 13 { a = a + 1 } else { break }
    }
    if a >= e { return }
    // First identifier in segment is the param name.
    var b = a
    while b < e {
        let c = DOC_TEXT[b as usize] as i64
        if is_ident_byte(c) == false { break }
        b = b + 1
    }
    if b > a {
        IH_PNAMES_S[IH_NPARAMS as usize] = a
        IH_PNAMES_E[IH_NPARAMS as usize] = b
        IH_NPARAMS = IH_NPARAMS + 1
    }
}

fn ih_emit_hint(arg_off: i64, p_idx: i64) with Mut, Panic, Div {
    if IH_EMITTED == 1 { tx_putc(44) }
    IH_EMITTED = 1
    IH_COUNT = IH_COUNT + 1
    offset_to_position(arg_off, 0)
    tx_puts("{\"position\":{\"line\":")
    tx_put_i64(DEF_LINE)
    tx_puts(",\"character\":")
    tx_put_i64(DEF_CHAR)
    tx_puts("},\"label\":\"")
    let ps = IH_PNAMES_S[p_idx as usize]
    let pe = IH_PNAMES_E[p_idx as usize]
    var i = ps
    while i < pe {
        let c = DOC_TEXT[i as usize] as i64
        if c == 34 { tx_putc(92); tx_putc(34) }
        else if c == 92 { tx_putc(92); tx_putc(92) }
        else { tx_putc(c) }
        i = i + 1
    }
    tx_puts(":\",\"kind\":2,\"paddingRight\":true}")
}

// Walk argument list at call paren_off, emit hints for each arg.
fn ih_emit_call_args(call_paren: i64) with Mut, Panic, Div {
    var i = call_paren + 1
    var d: i64 = 0
    var arg_idx: i64 = 0
    var pending_arg_start: bool = true
    while i < DOC_TEXT_LEN && IH_COUNT < IH_CAP {
        let c = DOC_TEXT[i as usize] as i64
        if c == 40 || c == 91 || c == 123 { d = d + 1; pending_arg_start = false }
        else if c == 41 {
            if d == 0 { return }
            d = d - 1
        } else if c == 93 || c == 125 { if d > 0 { d = d - 1 } }
        else if c == 44 && d == 0 {
            arg_idx = arg_idx + 1
            pending_arg_start = true
        } else if c == 32 || c == 9 || c == 10 || c == 13 {
            // whitespace
        } else if pending_arg_start == true {
            if arg_idx < IH_NPARAMS {
                ih_emit_hint(i, arg_idx)
            }
            pending_arg_start = false
        }
        i = i + 1
    }
}

fn respond_inlay_hint() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        tx_reset()
        tx_puts("{\"jsonrpc\":\"2.0\",")
        tx_emit_id()
        tx_puts(",\"result\":[]}")
        write_frame()
        return
    }

    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":[")
    IH_EMITTED = 0
    IH_COUNT = 0

    // Tiny state machine for skipping strings / chars / comments.
    var state: i64 = 0
    var i: i64 = 0
    while i < DOC_TEXT_LEN && IH_COUNT < IH_CAP {
        let c = DOC_TEXT[i as usize] as i64

        if state == 1 {
            if c == 92 && i + 1 < DOC_TEXT_LEN { i = i + 2 }
            else {
                if c == 34 { state = 0 }
                i = i + 1
            }
        } else if state == 2 {
            if c == 92 && i + 1 < DOC_TEXT_LEN { i = i + 2 }
            else {
                if c == 39 { state = 0 }
                i = i + 1
            }
        } else if state == 3 {
            if c == 10 { state = 0 }
            i = i + 1
        } else if state == 4 {
            if c == 42 && i + 1 < DOC_TEXT_LEN && (DOC_TEXT[(i + 1) as usize] as i64) == 47 {
                state = 0; i = i + 2
            } else { i = i + 1 }
        } else {
            if c == 34 { state = 1; i = i + 1 }
            else if c == 39 { state = 2; i = i + 1 }
            else if c == 47 && i + 1 < DOC_TEXT_LEN && (DOC_TEXT[(i + 1) as usize] as i64) == 47 {
                state = 3; i = i + 2
            } else if c == 47 && i + 1 < DOC_TEXT_LEN && (DOC_TEXT[(i + 1) as usize] as i64) == 42 {
                state = 4; i = i + 2
            } else {
                // Are we at a word start that begins an identifier?
                var at_word_start: bool = false
                if i == 0 { at_word_start = true }
                else if is_ident_byte(DOC_TEXT[(i - 1) as usize] as i64) == false {
                    at_word_start = true
                }
                if at_word_start == true && is_ident_byte(c) == true {
                    let je = read_ident_run(i)
                    // `let NAME = literal` / `var NAME = literal` →
                    // emit a type hint after NAME when there is no
                    // explicit `: T` annotation.
                    var is_let_var: bool = false
                    if ident_slice_eq(i, je, "let") { is_let_var = true }
                    else if ident_slice_eq(i, je, "var") { is_let_var = true }
                    if is_let_var == true {
                        let ns = skip_ws(je)
                        let ne = read_ident_run(ns)
                        if ne > ns {
                            // Look for `=` after optional whitespace.
                            // If we see `:` first, an explicit type is
                            // already given → skip hint.
                            let after = skip_ws(ne)
                            if after < DOC_TEXT_LEN &&
                               (DOC_TEXT[after as usize] as i64) == 61 {
                                // skip `=` + ws
                                var expr_off = after + 1
                                while expr_off < DOC_TEXT_LEN {
                                    let ec = DOC_TEXT[expr_off as usize] as i64
                                    if ec == 32 || ec == 9 { expr_off = expr_off + 1 }
                                    else { break }
                                }
                                if expr_off < DOC_TEXT_LEN {
                                    let e0 = DOC_TEXT[expr_off as usize] as i64
                                    var ty: string = ""
                                    if e0 == 34 { ty = ": string" }
                                    else if e0 >= 48 && e0 <= 57 {
                                        // integer vs float — scan until
                                        // non-digit; if we hit `.`
                                        // followed by digit, it's f64.
                                        var p = expr_off
                                        var saw_dot: bool = false
                                        while p < DOC_TEXT_LEN {
                                            let dc = DOC_TEXT[p as usize] as i64
                                            if dc >= 48 && dc <= 57 { p = p + 1 }
                                            else if dc == 46 && p + 1 < DOC_TEXT_LEN {
                                                let nx = DOC_TEXT[(p + 1) as usize] as i64
                                                if nx >= 48 && nx <= 57 {
                                                    saw_dot = true
                                                    p = p + 2
                                                } else { break }
                                            } else { break }
                                        }
                                        if saw_dot == true { ty = ": f64" }
                                        else { ty = ": i64" }
                                    } else if is_ident_byte(e0) == true {
                                        let kw_e = read_ident_run(expr_off)
                                        if ident_slice_eq(expr_off, kw_e, "true") { ty = ": bool" }
                                        else if ident_slice_eq(expr_off, kw_e, "false") { ty = ": bool" }
                                    }
                                    if str_len(ty) > 0 {
                                        if IH_EMITTED == 1 { tx_putc(44) }
                                        IH_EMITTED = 1
                                        IH_COUNT = IH_COUNT + 1
                                        offset_to_position(ne, 0)
                                        tx_puts("{\"position\":{\"line\":")
                                        tx_put_i64(DEF_LINE)
                                        tx_puts(",\"character\":")
                                        tx_put_i64(DEF_CHAR)
                                        tx_puts("},\"label\":\"")
                                        tx_puts(ty)
                                        tx_puts("\",\"kind\":1,\"paddingLeft\":false,\"paddingRight\":false}")
                                    }
                                }
                            }
                        }
                        if je > i { i = je } else { i = i + 1 }
                    } else {
                    // Check this is NOT a declarator keyword.
                    var is_kw: bool = false
                    if ident_slice_eq(i, je, "fn")     { is_kw = true }
                    else if ident_slice_eq(i, je, "struct") { is_kw = true }
                    else if ident_slice_eq(i, je, "enum")   { is_kw = true }
                    else if ident_slice_eq(i, je, "if")     { is_kw = true }
                    else if ident_slice_eq(i, je, "while")  { is_kw = true }
                    else if ident_slice_eq(i, je, "return") { is_kw = true }
                    else if ident_slice_eq(i, je, "match")  { is_kw = true }
                    else if ident_slice_eq(i, je, "for")    { is_kw = true }
                    if is_kw == false {
                        // Look ahead for `(` with no intervening
                        // non-ws (so `foo (x)` and `foo(x)` both fire,
                        // but `foo.bar()` is handled at `bar`).
                        let ps = skip_ws(je)
                        if ps < DOC_TEXT_LEN && (DOC_TEXT[ps as usize] as i64) == 40 {
                            ih_set_name(i, je)
                            if IH_NAME_LEN > 0 {
                                let fn_paren = ih_find_fn_paren()
                                if fn_paren >= 0 {
                                    ih_parse_param_names(fn_paren)
                                    ih_emit_call_args(ps)
                                }
                            }
                        }
                    }
                    if je > i { i = je } else { i = i + 1 }
                    }    // close else (not let_var)
                } else {
                    i = i + 1
                }
            }
        }
    }

    tx_puts("]}")
    write_frame()
}

// ============================================================================
// Code actions — textDocument/codeAction
// ============================================================================
//
// v0 ships a single quick-fix: `loop {` → `while true {`. The compiler
// rejects `loop` as E200, so this is by far the highest-traffic fix in
// practice.  Scans the requested range for the `loop` keyword (at a
// word start, followed by optional whitespace and `{`), and emits one
// CodeAction per hit with a WorkspaceEdit that replaces just the
// keyword with `while true`.
//
// Future kinds (refactor.extract, source.organizeImports, ...) layer on
// the same dispatch.

let CA_CAP: i64 = 64
var CA_EMITTED: i64 = 0
var CA_COUNT:   i64 = 0

// Buffered fix sites discovered by the scanner.  The scanner records
// (offset, length, type) for each site; respond_code_action then emits
// one `quickfix` action per site and one `source.fixAll` action that
// batches every site into a single WorkspaceEdit.
let FIX_TYPE_LOOP:    i64 = 0
let FIX_TYPE_LET_MUT: i64 = 1
let FIX_TYPE_SEMI:    i64 = 2
let FIX_CAP: i64 = 64
var FIX_COUNT: i64 = 0
var FIX_OFF: [i64; 64] = [0; 64]
var FIX_LEN: [i64; 64] = [0; 64]
var FIX_TY:  [i64; 64] = [0; 64]

fn ca_record_fix(off: i64, len: i64, ty: i64) with Mut, Panic {
    if FIX_COUNT >= FIX_CAP { return }
    FIX_OFF[FIX_COUNT as usize] = off
    FIX_LEN[FIX_COUNT as usize] = len
    FIX_TY[FIX_COUNT  as usize] = ty
    FIX_COUNT = FIX_COUNT + 1
}

fn fix_title(t: i64) -> string with Mut, Panic {
    if t == FIX_TYPE_LOOP    { return "Replace `loop` with `while true`" }
    if t == FIX_TYPE_LET_MUT { return "Replace `let mut` with `var`"     }
    return "Remove trailing `;` (Sounio uses newlines)"
}

fn fix_new_text(t: i64) -> string with Mut, Panic {
    if t == FIX_TYPE_LOOP    { return "while true" }
    if t == FIX_TYPE_LET_MUT { return "var"        }
    return ""
}

// Parse params.range. Fills CA_RANGE_S_OFF / CA_RANGE_E_OFF (DOC_TEXT
// byte offsets). Returns true on success.
var CA_RANGE_S_OFF: i64 = 0
var CA_RANGE_E_OFF: i64 = 0

fn ca_parse_range() -> bool with Mut, Panic, Div {
    // The request always has at least one line/character pair for the
    // range.start; the second pair is range.end. body_find walks in
    // order so the FIRST two `"line"` keys are start/end respectively.
    let lp1 = body_find("\"line\"", 0)
    if lp1 < 0 { return false }
    let cp1 = body_find("\"character\"", lp1)
    if cp1 < 0 { return false }
    let lp2 = body_find("\"line\"", cp1)
    if lp2 < 0 { return false }
    let cp2 = body_find("\"character\"", lp2)
    if cp2 < 0 { return false }
    let s_ln = body_read_int_after(lp1 + 6)
    let s_ch = body_read_int_after(cp1 + 11)
    let e_ln = body_read_int_after(lp2 + 6)
    let e_ch = body_read_int_after(cp2 + 11)
    if s_ln < 0 || s_ch < 0 || e_ln < 0 || e_ch < 0 { return false }
    CA_RANGE_S_OFF = sr_pos_to_offset(s_ln, s_ch)
    CA_RANGE_E_OFF = sr_pos_to_offset(e_ln, e_ch)
    return true
}

// Emit a CodeAction with WorkspaceEdit replacing DOC_TEXT[edit_off..
// edit_off+edit_len] with new_text. The edit must lie on a single line.
// Write the active document URI with JSON-escaping for `"` and `\`.
fn ca_emit_uri_escaped() with Mut, Panic {
    var i: i64 = 0
    while i < DOC_URI_LEN {
        let c = DOC_URI[i as usize] as i64
        if c == 34 { tx_putc(92); tx_putc(34) }
        else if c == 92 { tx_putc(92); tx_putc(92) }
        else { tx_putc(c) }
        i = i + 1
    }
}

// Emit one TextEdit JSON object for DOC_TEXT[off..off+len] -> new_text.
fn ca_emit_text_edit(off: i64, len: i64, new_text: string) with Mut, Panic, Div {
    offset_to_position(off, 0)
    let s_line = DEF_LINE
    let s_char = DEF_CHAR
    let e_char = DEF_CHAR + len
    tx_puts("{\"range\":{\"start\":{\"line\":")
    tx_put_i64(s_line)
    tx_puts(",\"character\":")
    tx_put_i64(s_char)
    tx_puts("},\"end\":{\"line\":")
    tx_put_i64(s_line)
    tx_puts(",\"character\":")
    tx_put_i64(e_char)
    tx_puts("}},\"newText\":\"")
    tx_puts(new_text)
    tx_puts("\"}")
}

fn ca_emit_replace(edit_off: i64, edit_len: i64, title: string, new_text: string)
    with Mut, Panic, Div {
    if CA_EMITTED == 1 { tx_putc(44) }
    CA_EMITTED = 1
    CA_COUNT = CA_COUNT + 1
    tx_puts("{\"title\":\"")
    tx_puts(title)
    tx_puts("\",\"kind\":\"quickfix\",\"edit\":{\"changes\":{\"")
    ca_emit_uri_escaped()
    tx_puts("\":[")
    ca_emit_text_edit(edit_off, edit_len, new_text)
    tx_puts("]}}}")
}

// Emit one `source.fixAll` action that batches every recorded fix into a
// single WorkspaceEdit.  Skipped when FIX_COUNT == 0.
fn ca_emit_fix_all() with Mut, Panic, Div {
    if FIX_COUNT <= 0 { return }
    if CA_EMITTED == 1 { tx_putc(44) }
    CA_EMITTED = 1
    CA_COUNT = CA_COUNT + 1
    tx_puts("{\"title\":\"Sounio: fix all auto-fixable issues in document\",")
    tx_puts("\"kind\":\"source.fixAll\",\"edit\":{\"changes\":{\"")
    ca_emit_uri_escaped()
    tx_puts("\":[")
    var k: i64 = 0
    while k < FIX_COUNT {
        if k > 0 { tx_putc(44) }
        let t = FIX_TY[k as usize]
        ca_emit_text_edit(FIX_OFF[k as usize], FIX_LEN[k as usize], fix_new_text(t))
        k = k + 1
    }
    tx_puts("]}}}")
}

// Emit one `refactor.extract` action that wraps DOC_TEXT[rs..re] in a new
// `let __extracted = … in __extracted` binding.  Caller guarantees the
// range is non-empty and contains at least one non-whitespace byte.
fn ca_emit_refactor_extract(rs: i64, re: i64) with Mut, Panic, Div {
    if CA_EMITTED == 1 { tx_putc(44) }
    CA_EMITTED = 1
    CA_COUNT = CA_COUNT + 1
    let len = re - rs
    tx_puts("{\"title\":\"Extract expression into `let` binding\",")
    tx_puts("\"kind\":\"refactor.extract\",\"edit\":{\"changes\":{\"")
    ca_emit_uri_escaped()
    tx_puts("\":[")
    // Single TextEdit: replace selection with
    //     let __extracted = <selection>\n    __extracted
    offset_to_position(rs, 0)
    let s_line = DEF_LINE
    let s_char = DEF_CHAR
    let e_char = DEF_CHAR + len
    tx_puts("{\"range\":{\"start\":{\"line\":")
    tx_put_i64(s_line)
    tx_puts(",\"character\":")
    tx_put_i64(s_char)
    tx_puts("},\"end\":{\"line\":")
    tx_put_i64(s_line)
    tx_puts(",\"character\":")
    tx_put_i64(e_char)
    tx_puts("}},\"newText\":\"let __extracted = ")
    var i = rs
    while i < re {
        let c = DOC_TEXT[i as usize] as i64
        if c == 34 { tx_putc(92); tx_putc(34) }
        else if c == 92 { tx_putc(92); tx_putc(92) }
        else if c == 10 { tx_putc(92); tx_putc(110) }
        else if c == 13 { tx_putc(92); tx_putc(114) }
        else if c == 9  { tx_putc(92); tx_putc(116) }
        else if c < 32 { tx_putc(32) }
        else { tx_putc(c) }
        i = i + 1
    }
    tx_puts("\\n    __extracted\"}")
    tx_puts("]}}}")
}

fn respond_code_action() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        tx_reset()
        tx_puts("{\"jsonrpc\":\"2.0\",")
        tx_emit_id()
        tx_puts(",\"result\":[]}")
        write_frame()
        return
    }

    var have_range: bool = ca_parse_range()
    var rs: i64 = 0
    var re: i64 = DOC_TEXT_LEN
    if have_range == true {
        rs = CA_RANGE_S_OFF
        re = CA_RANGE_E_OFF
    }
    if rs < 0 { rs = 0 }
    if re > DOC_TEXT_LEN { re = DOC_TEXT_LEN }

    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":[")
    CA_EMITTED = 0
    CA_COUNT = 0
    FIX_COUNT = 0

    // Pass 1 — `loop {` and `let mut IDENT` recorded into FIX_*.
    // We extend the lower bound by 4 bytes so a `loop` keyword that
    // overlaps the start of the range is still recognized.
    var sb = rs - 4
    if sb < 0 { sb = 0 }
    var eb = re + 4
    if eb > DOC_TEXT_LEN { eb = DOC_TEXT_LEN }
    var i = sb
    while i < eb && FIX_COUNT < FIX_CAP {
        var at_word_start: bool = false
        if i == 0 { at_word_start = true }
        else if is_ident_byte(DOC_TEXT[(i - 1) as usize] as i64) == false {
            at_word_start = true
        }
        if at_word_start == true {
            let je = read_ident_run(i)
            if je > i && ident_slice_eq(i, je, "loop") {
                let ps = skip_ws(je)
                if ps < DOC_TEXT_LEN && (DOC_TEXT[ps as usize] as i64) == 123 {
                    if je > rs && i < re {
                        ca_record_fix(i, 4, FIX_TYPE_LOOP)
                    }
                }
                if je > i { i = je } else { i = i + 1 }
            } else if je > i && ident_slice_eq(i, je, "let") {
                let ms = skip_ws(je)
                let me = read_ident_run(ms)
                if me > ms && ident_slice_eq(ms, me, "mut") {
                    let ns = skip_ws(me)
                    let ne = read_ident_run(ns)
                    if ne > ns {
                        let span = me - i
                        if me > rs && i < re {
                            ca_record_fix(i, span, FIX_TYPE_LET_MUT)
                        }
                    }
                }
                if je > i { i = je } else { i = i + 1 }
            } else {
                if je > i { i = je } else { i = i + 1 }
            }
        } else {
            i = i + 1
        }
    }

    // Pass 2 — stray `;` outside strings/chars/comments.
    var state: i64 = 0
    var k = sb
    while k < eb && FIX_COUNT < FIX_CAP {
        let c = DOC_TEXT[k as usize] as i64
        if state == 1 {
            if c == 92 && k + 1 < eb { k = k + 2 }
            else {
                if c == 34 { state = 0 }
                k = k + 1
            }
        } else if state == 2 {
            if c == 92 && k + 1 < eb { k = k + 2 }
            else {
                if c == 39 { state = 0 }
                k = k + 1
            }
        } else if state == 3 {
            if c == 10 { state = 0 }
            k = k + 1
        } else if state == 4 {
            if c == 42 && k + 1 < eb && (DOC_TEXT[(k + 1) as usize] as i64) == 47 {
                state = 0; k = k + 2
            } else { k = k + 1 }
        } else {
            if c == 34 { state = 1; k = k + 1 }
            else if c == 39 { state = 2; k = k + 1 }
            else if c == 47 && k + 1 < eb && (DOC_TEXT[(k + 1) as usize] as i64) == 47 {
                state = 3; k = k + 2
            } else if c == 47 && k + 1 < eb && (DOC_TEXT[(k + 1) as usize] as i64) == 42 {
                state = 4; k = k + 2
            } else if c == 59 {
                if k >= rs && k < re {
                    ca_record_fix(k, 1, FIX_TYPE_SEMI)
                }
                k = k + 1
            } else {
                k = k + 1
            }
        }
    }

    // Emit one quickfix per recorded site.
    var q: i64 = 0
    while q < FIX_COUNT {
        let t = FIX_TY[q as usize]
        ca_emit_replace(FIX_OFF[q as usize], FIX_LEN[q as usize],
                        fix_title(t), fix_new_text(t))
        q = q + 1
    }

    // Emit one `source.fixAll` action batching every recorded site.
    ca_emit_fix_all()

    // Emit one `refactor.extract` action when the selection looks like
    // an expression: it must contain at least one ident-class byte
    // (letter / digit / underscore).  Pure-punctuation or whitespace
    // selections (a lone `}`, an empty line) do not qualify.
    if have_range == true && re > rs {
        var any_ident: bool = false
        var s2 = rs
        while s2 < re && any_ident == false {
            if is_ident_byte(DOC_TEXT[s2 as usize] as i64) == true {
                any_ident = true
            }
            s2 = s2 + 1
        }
        if any_ident == true {
            ca_emit_refactor_extract(rs, re)
        }
    }

    tx_puts("]}")
    write_frame()
}

// ============================================================================
// Call hierarchy — prepare / incomingCalls / outgoingCalls
// ============================================================================
//
// prepareCallHierarchy: cursor on an ident → if there's a matching
// `fn NAME(...)` in the active buffer, emit a single CallHierarchyItem.
//
// incomingCalls: client sends back the item.name; we iterate every
// open buffer, scan for `NAME(` call sites (non-declarator-prefixed),
// walk back to the most-recent enclosing `fn CALLER(`, and emit one
// CallHierarchyIncomingCall per (caller, callsite). Up to 64 results.
//
// outgoingCalls: client sends item.name; we locate the fn body in the
// active buffer (matching braces from the fn paren), scan it for
// IDENT( calls, and emit one CallHierarchyOutgoingCall per unique
// callee with a fromRanges list. Up to 64 callees, 64 callsites each.

let CH_CAP: i64 = 64
var CH_EMITTED: i64 = 0
var CH_COUNT:   i64 = 0

// Reusable name buffer for callees / callers.
var CH_NAME: [i8; 128] = [0; 128]
var CH_NAME_LEN: i64 = 0

fn ch_set_name_from_doc(s: i64, e: i64) with Mut, Panic {
    CH_NAME_LEN = 0
    var i = s
    while i < e && CH_NAME_LEN < 128 {
        CH_NAME[CH_NAME_LEN as usize] = DOC_TEXT[i as usize]
        CH_NAME_LEN = CH_NAME_LEN + 1
        i = i + 1
    }
}

fn ch_name_eq_doc(ds: i64, de: i64) -> bool with Mut, Panic {
    let dl = de - ds
    if dl != CH_NAME_LEN { return false }
    var i: i64 = 0
    while i < dl {
        if (DOC_TEXT[(ds + i) as usize] as i64) != (CH_NAME[i as usize] as i64) {
            return false
        }
        i = i + 1
    }
    return true
}

// Find `fn NAME(...)` in active DOC_TEXT. Returns the offset of the
// fn name identifier (>=0) or -1 on miss. Also stores the `(` offset
// in CH_FN_PAREN.
var CH_FN_PAREN: i64 = 0

fn ch_find_fn_in_active() -> i64 with Mut, Panic {
    CH_FN_PAREN = 0 - 1
    var i: i64 = 0
    while i < DOC_TEXT_LEN {
        var at_word_start: bool = false
        if i == 0 { at_word_start = true }
        else if is_ident_byte(DOC_TEXT[(i - 1) as usize] as i64) == false { at_word_start = true }
        if at_word_start == true {
            let je = read_ident_run(i)
            if je > i && ident_slice_eq(i, je, "fn") {
                let ns = skip_ws(je)
                let ne = read_ident_run(ns)
                if ne > ns && ch_name_eq_doc(ns, ne) == true {
                    let ps = skip_ws(ne)
                    if ps < DOC_TEXT_LEN && (DOC_TEXT[ps as usize] as i64) == 40 {
                        CH_FN_PAREN = ps
                        return ns
                    }
                }
                if je > i { i = je } else { i = i + 1 }
            } else {
                if je > i { i = je } else { i = i + 1 }
            }
        } else {
            i = i + 1
        }
    }
    return 0 - 1
}

// Common emitter for a CallHierarchyItem with name = CH_NAME and the
// given uri + range/selectionRange.
fn ch_emit_item(name_s: i64, name_e: i64, uri_slot: i64) with Mut, Panic, Div {
    offset_to_position(name_s, 0)
    let s_line = DEF_LINE
    let s_char = DEF_CHAR
    let nlen = name_e - name_s
    tx_puts("{\"name\":\"")
    var i = name_s
    while i < name_e {
        let c = DOC_TEXT[i as usize] as i64
        if c == 34 { tx_putc(92); tx_putc(34) }
        else if c == 92 { tx_putc(92); tx_putc(92) }
        else { tx_putc(c) }
        i = i + 1
    }
    tx_puts("\",\"kind\":12,\"uri\":\"")
    if uri_slot < 0 {
        var k: i64 = 0
        while k < DOC_URI_LEN {
            let c = DOC_URI[k as usize] as i64
            if c == 34 { tx_putc(92); tx_putc(34) }
            else if c == 92 { tx_putc(92); tx_putc(92) }
            else { tx_putc(c) }
            k = k + 1
        }
    } else {
        let base = uri_slot * 1024
        let ulen = DOC_SLOT_URI_LEN[uri_slot as usize]
        var k: i64 = 0
        while k < ulen {
            let c = DOC_SLOT_URI[(base + k) as usize] as i64
            if c == 34 { tx_putc(92); tx_putc(34) }
            else if c == 92 { tx_putc(92); tx_putc(92) }
            else { tx_putc(c) }
            k = k + 1
        }
    }
    tx_puts("\",\"range\":{\"start\":{\"line\":")
    tx_put_i64(s_line)
    tx_puts(",\"character\":")
    tx_put_i64(s_char)
    tx_puts("},\"end\":{\"line\":")
    tx_put_i64(s_line)
    tx_puts(",\"character\":")
    tx_put_i64(s_char + nlen)
    tx_puts("}},\"selectionRange\":{\"start\":{\"line\":")
    tx_put_i64(s_line)
    tx_puts(",\"character\":")
    tx_put_i64(s_char)
    tx_puts("},\"end\":{\"line\":")
    tx_put_i64(s_line)
    tx_puts(",\"character\":")
    tx_put_i64(s_char + nlen)
    tx_puts("}}}")
}

fn respond_prepare_call_hierarchy() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        tx_reset()
        tx_puts("{\"jsonrpc\":\"2.0\",")
        tx_emit_id()
        tx_puts(",\"result\":null}")
        write_frame()
        return
    }
    parse_hover_position()
    var have: bool = false
    var name_s: i64 = 0
    var name_e: i64 = 0
    if HOVER_OK == 1 {
        let n = locate_ident()
        if n > 0 {
            // Copy IDENT_BUF into CH_NAME and look up the fn decl.
            CH_NAME_LEN = 0
            var k: i64 = 0
            while k < IDENT_LEN && CH_NAME_LEN < 128 {
                CH_NAME[CH_NAME_LEN as usize] = IDENT_BUF[k as usize]
                CH_NAME_LEN = CH_NAME_LEN + 1
                k = k + 1
            }
            let off = ch_find_fn_in_active()
            if off >= 0 {
                name_s = off
                name_e = off + IDENT_LEN
                have = true
            }
        }
    }
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    if have == true {
        tx_puts(",\"result\":[")
        ch_emit_item(name_s, name_e, 0 - 1)
        tx_puts("]}")
    } else {
        tx_puts(",\"result\":null}")
    }
    write_frame()
}

// Reads "name" field from request body into CH_NAME (truncating to 64
// bytes so it fits in body_extract_str's signature). Returns true on
// success.
fn ch_extract_name_from_request() -> bool with Mut, Panic {
    var tmp: [i8; 64] = [0; 64]
    let n = body_extract_str("\"name\"", &! tmp, 64)
    if n <= 0 { return false }
    CH_NAME_LEN = 0
    var k: i64 = 0
    while k < n && CH_NAME_LEN < 128 {
        CH_NAME[CH_NAME_LEN as usize] = tmp[k as usize]
        CH_NAME_LEN = CH_NAME_LEN + 1
        k = k + 1
    }
    return true
}

// Walk back from `pos` in DOC_TEXT to find the most recent
// `fn CALLER(` declaration; returns (caller_name_start, caller_name_end)
// packed via CH_CALLER_S / CH_CALLER_E or -1/-1 on miss.
var CH_CALLER_S: i64 = 0
var CH_CALLER_E: i64 = 0

fn ch_find_enclosing_fn(pos: i64) with Mut, Panic {
    CH_CALLER_S = 0 - 1
    CH_CALLER_E = 0 - 1
    var i: i64 = 0
    while i < pos {
        var at_word_start: bool = false
        if i == 0 { at_word_start = true }
        else if is_ident_byte(DOC_TEXT[(i - 1) as usize] as i64) == false { at_word_start = true }
        if at_word_start == true {
            let je = read_ident_run(i)
            if je > i && ident_slice_eq(i, je, "fn") {
                let ns = skip_ws(je)
                let ne = read_ident_run(ns)
                if ne > ns {
                    CH_CALLER_S = ns
                    CH_CALLER_E = ne
                }
                if je > i { i = je } else { i = i + 1 }
            } else {
                if je > i { i = je } else { i = i + 1 }
            }
        } else {
            i = i + 1
        }
    }
}

// True if the ident at `name_s..name_e` is the *declaration* of a fn
// (i.e. immediately preceded by `fn` keyword + ws). Used to skip the
// fn's own decl when looking for incoming calls.
fn ch_at_fn_decl(name_s: i64) -> bool with Mut, Panic {
    var p = name_s - 1
    while p >= 0 {
        let c = DOC_TEXT[p as usize] as i64
        if c == 32 || c == 9 || c == 10 || c == 13 { p = p - 1 }
        else { break }
    }
    if p < 1 { return false }
    let kwe = p + 1
    var ks = p
    while ks > 0 {
        let c = DOC_TEXT[(ks - 1) as usize] as i64
        if is_ident_byte(c) == false { break }
        ks = ks - 1
    }
    return ident_slice_eq(ks, kwe, "fn")
}

fn respond_incoming_calls() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if ch_extract_name_from_request() == false {
        tx_reset()
        tx_puts("{\"jsonrpc\":\"2.0\",")
        tx_emit_id()
        tx_puts(",\"result\":[]}")
        write_frame()
        return
    }

    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":[")
    CH_EMITTED = 0
    CH_COUNT = 0

    var s: i64 = 0
    while s < 8 && CH_COUNT < CH_CAP {
        if DOC_SLOT_URI_LEN[s as usize] > 0 {
            slot_activate(s)
            var i: i64 = 0
            while i < DOC_TEXT_LEN && CH_COUNT < CH_CAP {
                var at_word_start: bool = false
                if i == 0 { at_word_start = true }
                else if is_ident_byte(DOC_TEXT[(i - 1) as usize] as i64) == false {
                    at_word_start = true
                }
                if at_word_start == true {
                    let je = read_ident_run(i)
                    if je > i && ch_name_eq_doc(i, je) == true {
                        // Must be followed (after ws) by `(`.
                        let ps = skip_ws(je)
                        if ps < DOC_TEXT_LEN && (DOC_TEXT[ps as usize] as i64) == 40 {
                            // Skip the declaration itself.
                            if ch_at_fn_decl(i) == false {
                                ch_find_enclosing_fn(i)
                                if CH_CALLER_S >= 0 {
                                    if CH_EMITTED == 1 { tx_putc(44) }
                                    CH_EMITTED = 1
                                    CH_COUNT = CH_COUNT + 1
                                    tx_puts("{\"from\":")
                                    ch_emit_item(CH_CALLER_S, CH_CALLER_E, s)
                                    // fromRanges: just the call-site ident.
                                    offset_to_position(i, 0)
                                    tx_puts(",\"fromRanges\":[{\"start\":{\"line\":")
                                    tx_put_i64(DEF_LINE)
                                    tx_puts(",\"character\":")
                                    tx_put_i64(DEF_CHAR)
                                    tx_puts("},\"end\":{\"line\":")
                                    tx_put_i64(DEF_LINE)
                                    tx_puts(",\"character\":")
                                    tx_put_i64(DEF_CHAR + (je - i))
                                    tx_puts("}}]}")
                                }
                            }
                        }
                        if je > i { i = je } else { i = i + 1 }
                    } else {
                        if je > i { i = je } else { i = i + 1 }
                    }
                } else {
                    i = i + 1
                }
            }
        }
        s = s + 1
    }

    tx_puts("]}")
    write_frame()
}

fn respond_outgoing_calls() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        tx_reset()
        tx_puts("{\"jsonrpc\":\"2.0\",")
        tx_emit_id()
        tx_puts(",\"result\":[]}")
        write_frame()
        return
    }
    if ch_extract_name_from_request() == false {
        tx_reset()
        tx_puts("{\"jsonrpc\":\"2.0\",")
        tx_emit_id()
        tx_puts(",\"result\":[]}")
        write_frame()
        return
    }

    // Locate the fn declaration body in the active buffer.
    let off = ch_find_fn_in_active()
    if off < 0 {
        tx_reset()
        tx_puts("{\"jsonrpc\":\"2.0\",")
        tx_emit_id()
        tx_puts(",\"result\":[]}")
        write_frame()
        return
    }
    // Find the `{` that starts the body after the param paren.
    var p = CH_FN_PAREN
    var d: i64 = 0
    var body_start: i64 = 0 - 1
    while p < DOC_TEXT_LEN {
        let c = DOC_TEXT[p as usize] as i64
        if c == 40 { d = d + 1 }
        else if c == 41 {
            d = d - 1
            if d == 0 { p = p + 1; break }
        }
        p = p + 1
    }
    while p < DOC_TEXT_LEN {
        let c = DOC_TEXT[p as usize] as i64
        if c == 123 { body_start = p; break }
        if c == 10 || c == 59 { break }
        p = p + 1
    }
    if body_start < 0 {
        tx_reset()
        tx_puts("{\"jsonrpc\":\"2.0\",")
        tx_emit_id()
        tx_puts(",\"result\":[]}")
        write_frame()
        return
    }
    // Find matching `}`.
    var d2: i64 = 1
    var q = body_start + 1
    while q < DOC_TEXT_LEN && d2 > 0 {
        let c = DOC_TEXT[q as usize] as i64
        if c == 123 { d2 = d2 + 1 }
        else if c == 125 { d2 = d2 - 1; if d2 == 0 { break } }
        q = q + 1
    }
    let body_end = q

    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":[")
    CH_EMITTED = 0
    CH_COUNT = 0

    var i = body_start + 1
    while i < body_end && CH_COUNT < CH_CAP {
        var at_word_start: bool = false
        if i == 0 { at_word_start = true }
        else if is_ident_byte(DOC_TEXT[(i - 1) as usize] as i64) == false {
            at_word_start = true
        }
        if at_word_start == true {
            let je = read_ident_run(i)
            if je > i {
                // Skip declarator keywords.
                var is_kw: bool = false
                if ident_slice_eq(i, je, "fn") { is_kw = true }
                else if ident_slice_eq(i, je, "let") { is_kw = true }
                else if ident_slice_eq(i, je, "var") { is_kw = true }
                else if ident_slice_eq(i, je, "if") { is_kw = true }
                else if ident_slice_eq(i, je, "else") { is_kw = true }
                else if ident_slice_eq(i, je, "while") { is_kw = true }
                else if ident_slice_eq(i, je, "return") { is_kw = true }
                else if ident_slice_eq(i, je, "with") { is_kw = true }
                else if ident_slice_eq(i, je, "match") { is_kw = true }
                else if ident_slice_eq(i, je, "struct") { is_kw = true }
                else if ident_slice_eq(i, je, "enum") { is_kw = true }
                if is_kw == false {
                    let ps = skip_ws(je)
                    if ps < DOC_TEXT_LEN && (DOC_TEXT[ps as usize] as i64) == 40 {
                        if CH_EMITTED == 1 { tx_putc(44) }
                        CH_EMITTED = 1
                        CH_COUNT = CH_COUNT + 1
                        tx_puts("{\"to\":")
                        ch_emit_item(i, je, 0 - 1)
                        offset_to_position(i, 0)
                        tx_puts(",\"fromRanges\":[{\"start\":{\"line\":")
                        tx_put_i64(DEF_LINE)
                        tx_puts(",\"character\":")
                        tx_put_i64(DEF_CHAR)
                        tx_puts("},\"end\":{\"line\":")
                        tx_put_i64(DEF_LINE)
                        tx_puts(",\"character\":")
                        tx_put_i64(DEF_CHAR + (je - i))
                        tx_puts("}}]}")
                    }
                }
                if je > i { i = je } else { i = i + 1 }
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }

    tx_puts("]}")
    write_frame()
}

// ============================================================================
// Document links — textDocument/documentLink
// ============================================================================
//
// Scans DOC_TEXT for `use a::b::c` clauses. For each module path, emits
// a DocumentLink whose range covers the full path span (`a::b::c`) and
// whose target is resolved by taking DOC_URI up to and including the
// last `/self-hosted/` segment and appending `<a>/<b>/<c>.sio`. Skips
// the clause if DOC_URI does not live under a `/self-hosted/` root or
// the path contains no `::` separator. Cap 256 links.

let DL_CAP: i64 = 256
var DL_EMITTED: i64 = 0
var DL_COUNT:   i64 = 0

// Returns the offset of the last `/self-hosted/` in DOC_URI, or -1.
fn dl_self_hosted_off() -> i64 with Mut, Panic {
    let needle = "/self-hosted/"
    let nlen: i64 = 13
    var i: i64 = DOC_URI_LEN - nlen
    while i >= 0 {
        var k: i64 = 0
        var hit: bool = true
        while k < nlen {
            if (DOC_URI[(i + k) as usize] as i64) != str_char_at(needle, k) {
                hit = false; break
            }
            k = k + 1
        }
        if hit == true { return i + nlen }   // offset just past `/self-hosted/`
        i = i - 1
    }
    return 0 - 1
}

// Emit one DocumentLink. path_s..path_e covers the `a::b::c` span; the
// target is built from DOC_URI[0..base_off] + path-with-:::→/ + `.sio`.
fn dl_emit(path_s: i64, path_e: i64, base_off: i64) with Mut, Panic, Div {
    if DL_EMITTED == 1 { tx_putc(44) }
    DL_EMITTED = 1
    DL_COUNT = DL_COUNT + 1
    offset_to_position(path_s, 0)
    let s_line = DEF_LINE
    let s_char = DEF_CHAR
    let plen = path_e - path_s
    tx_puts("{\"range\":{\"start\":{\"line\":")
    tx_put_i64(s_line)
    tx_puts(",\"character\":")
    tx_put_i64(s_char)
    tx_puts("},\"end\":{\"line\":")
    tx_put_i64(s_line)
    tx_puts(",\"character\":")
    tx_put_i64(s_char + plen)
    tx_puts("}},\"target\":\"")
    // Copy DOC_URI[0..base_off]
    var i: i64 = 0
    while i < base_off {
        let c = DOC_URI[i as usize] as i64
        if c == 34 { tx_putc(92); tx_putc(34) }
        else if c == 92 { tx_putc(92); tx_putc(92) }
        else { tx_putc(c) }
        i = i + 1
    }
    // Walk path_s..path_e: copy bytes, transforming `::` → `/`. Stop
    // at the first `{` or non-path byte (caller already trimmed).
    var p = path_s
    while p < path_e {
        let c = DOC_TEXT[p as usize] as i64
        if c == 58 && p + 1 < path_e && (DOC_TEXT[(p + 1) as usize] as i64) == 58 {
            tx_putc(47)         // '/'
            p = p + 2
        } else {
            tx_putc(c)
            p = p + 1
        }
    }
    tx_puts(".sio\"}")
}

fn respond_document_link() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        tx_reset()
        tx_puts("{\"jsonrpc\":\"2.0\",")
        tx_emit_id()
        tx_puts(",\"result\":[]}")
        write_frame()
        return
    }
    let base_off = dl_self_hosted_off()

    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":[")
    DL_EMITTED = 0
    DL_COUNT = 0

    if base_off >= 0 {
        var i: i64 = 0
        while i < DOC_TEXT_LEN && DL_COUNT < DL_CAP {
            var at_word_start: bool = false
            if i == 0 { at_word_start = true }
            else if is_ident_byte(DOC_TEXT[(i - 1) as usize] as i64) == false {
                at_word_start = true
            }
            if at_word_start == true {
                let je = read_ident_run(i)
                if je > i && ident_slice_eq(i, je, "use") {
                    // Skip whitespace, then walk over path bytes (ident
                    // bytes plus `::`). Stop at `;`, `{`, `,`, newline,
                    // or any other non-path char.
                    let ps = skip_ws(je)
                    var pe = ps
                    var has_sep: bool = false
                    while pe < DOC_TEXT_LEN {
                        let c = DOC_TEXT[pe as usize] as i64
                        if is_ident_byte(c) == true { pe = pe + 1 }
                        else if c == 58 && pe + 1 < DOC_TEXT_LEN &&
                                (DOC_TEXT[(pe + 1) as usize] as i64) == 58 {
                            has_sep = true
                            pe = pe + 2
                        } else { break }
                    }
                    // Trim trailing `::` if any.
                    while pe > ps && (DOC_TEXT[(pe - 1) as usize] as i64) == 58 { pe = pe - 1 }
                    if pe > ps && has_sep == true {
                        dl_emit(ps, pe, base_off)
                    }
                    if je > i { i = je } else { i = i + 1 }
                } else {
                    if je > i { i = je } else { i = i + 1 }
                }
            } else {
                i = i + 1
            }
        }
    }

    tx_puts("]}")
    write_frame()
}

// ============================================================================
// Formatting — textDocument/formatting
// ============================================================================
//
// Conservative whitespace-only formatter: emits one TextEdit per line
// whose trailing run contains spaces or tabs immediately before the
// newline (or before EOF on the final unterminated line). No
// structural reformatting — never touches code bytes, indentation, or
// blank-line layout. Safe to run on every save.
//
// Cap 1024 edits per request.

let FMT_CAP: i64 = 1024
var FMT_EMITTED: i64 = 0
var FMT_COUNT:   i64 = 0

fn fmt_emit_trim(line_no: i64, ws_start_col: i64, ws_end_col: i64)
    with Mut, Panic, Div {
    if FMT_EMITTED == 1 { tx_putc(44) }
    FMT_EMITTED = 1
    FMT_COUNT = FMT_COUNT + 1
    tx_puts("{\"range\":{\"start\":{\"line\":")
    tx_put_i64(line_no)
    tx_puts(",\"character\":")
    tx_put_i64(ws_start_col)
    tx_puts("},\"end\":{\"line\":")
    tx_put_i64(line_no)
    tx_puts(",\"character\":")
    tx_put_i64(ws_end_col)
    tx_puts("}},\"newText\":\"\"}")
}

// Core trim pass. Emits TextEdits for every line in [line_lo, line_hi]
// (inclusive on both ends) that has trailing space / tab.
fn fmt_trim_lines(line_lo: i64, line_hi: i64) with Mut, Panic, Div {
    var i: i64 = 0
    var line_no: i64 = 0
    var line_start: i64 = 0
    while i <= DOC_TEXT_LEN && FMT_COUNT < FMT_CAP {
        var at_eol: bool = false
        if i == DOC_TEXT_LEN { at_eol = true }
        else if (DOC_TEXT[i as usize] as i64) == 10 { at_eol = true }
        if at_eol == true {
            if line_no >= line_lo && line_no <= line_hi {
                var w = i
                while w > line_start {
                    let c = DOC_TEXT[(w - 1) as usize] as i64
                    if c == 32 || c == 9 { w = w - 1 } else { break }
                }
                if w < i {
                    fmt_emit_trim(line_no, w - line_start, i - line_start)
                }
            }
            if i == DOC_TEXT_LEN { i = i + 1 }
            else {
                line_no = line_no + 1
                line_start = i + 1
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
}

fn respond_formatting() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        tx_reset()
        tx_puts("{\"jsonrpc\":\"2.0\",")
        tx_emit_id()
        tx_puts(",\"result\":[]}")
        write_frame()
        return
    }
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":[")
    FMT_EMITTED = 0
    FMT_COUNT = 0
    fmt_trim_lines(0, 1000000000)
    tx_puts("]}")
    write_frame()
}

fn respond_range_formatting() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        tx_reset()
        tx_puts("{\"jsonrpc\":\"2.0\",")
        tx_emit_id()
        tx_puts(",\"result\":[]}")
        write_frame()
        return
    }
    // Reuse ca_parse_range: pulls the first two "line"/"character"
    // pairs out of RX_BODY and stores byte offsets in CA_RANGE_*.
    var line_lo: i64 = 0
    var line_hi: i64 = 1000000000
    if ca_parse_range() == true {
        // Convert offsets back to lines. CA_RANGE_S_OFF / _E_OFF are
        // byte offsets in DOC_TEXT.
        offset_to_position(CA_RANGE_S_OFF, 0)
        line_lo = DEF_LINE
        offset_to_position(CA_RANGE_E_OFF, 0)
        line_hi = DEF_LINE
        // If range.end sits at column 0 of a new line, the editor
        // really means "up to but not including that line".
        if line_hi > line_lo && CA_RANGE_E_OFF > 0 &&
           (DOC_TEXT[(CA_RANGE_E_OFF - 1) as usize] as i64) == 10 &&
           DEF_CHAR == 0 {
            line_hi = line_hi - 1
        }
    }
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":[")
    FMT_EMITTED = 0
    FMT_COUNT = 0
    fmt_trim_lines(line_lo, line_hi)
    tx_puts("]}")
    write_frame()
}

// ============================================================================
// Code lens — textDocument/codeLens + workspace/executeCommand
// ============================================================================
//
// Emits a Run-button CodeLens above every `fn main(` and a Check-button
// above every `pub fn` declaration. Command names route through
// workspace/executeCommand → sounio.run / sounio.check, which the
// editor extension hooks to spawn `souc run` or `souc check`.
// 256-lens cap; arguments carry the file URI so the editor can pick
// the right buffer.

let CL_CAP: i64 = 256
var CL_EMITTED: i64 = 0
var CL_COUNT:   i64 = 0

fn cl_emit_lens(line: i64, title: string, command: string) with Mut, Panic, Div {
    if CL_EMITTED == 1 { tx_putc(44) }
    CL_EMITTED = 1
    CL_COUNT = CL_COUNT + 1
    tx_puts("{\"range\":{\"start\":{\"line\":")
    tx_put_i64(line)
    tx_puts(",\"character\":0},\"end\":{\"line\":")
    tx_put_i64(line)
    tx_puts(",\"character\":0}},\"command\":{\"title\":\"")
    tx_puts(title)
    tx_puts("\",\"command\":\"")
    tx_puts(command)
    tx_puts("\",\"arguments\":[\"")
    var i: i64 = 0
    while i < DOC_URI_LEN {
        let c = DOC_URI[i as usize] as i64
        if c == 34 { tx_putc(92); tx_putc(34) }
        else if c == 92 { tx_putc(92); tx_putc(92) }
        else { tx_putc(c) }
        i = i + 1
    }
    tx_puts("\"]}}")
}

fn respond_code_lens() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        tx_reset()
        tx_puts("{\"jsonrpc\":\"2.0\",")
        tx_emit_id()
        tx_puts(",\"result\":[]}")
        write_frame()
        return
    }
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":[")
    CL_EMITTED = 0
    CL_COUNT = 0

    var i: i64 = 0
    while i < DOC_TEXT_LEN && CL_COUNT < CL_CAP {
        var at_word_start: bool = false
        if i == 0 { at_word_start = true }
        else if is_ident_byte(DOC_TEXT[(i - 1) as usize] as i64) == false {
            at_word_start = true
        }
        if at_word_start == true {
            let je = read_ident_run(i)
            if je > i {
                var kw_start = i
                var kw_end   = je
                var is_pub: bool = false
                if ident_slice_eq(kw_start, kw_end, "pub") {
                    let kw2_s = skip_ws(kw_end)
                    let kw2_e = read_ident_run(kw2_s)
                    if kw2_e > kw2_s {
                        is_pub = true
                        kw_start = kw2_s
                        kw_end = kw2_e
                    }
                }
                if ident_slice_eq(kw_start, kw_end, "fn") {
                    let ns = skip_ws(kw_end)
                    let ne = read_ident_run(ns)
                    if ne > ns {
                        offset_to_position(i, 0)
                        let line = DEF_LINE
                        // Run-button only on `fn main`.
                        if ident_slice_eq(ns, ne, "main") {
                            cl_emit_lens(line, "▶ Run", "sounio.run")
                        }
                        // Check button on every public function.
                        if is_pub == true {
                            cl_emit_lens(line, "✓ Check", "sounio.check")
                        }
                    }
                    if je > i { i = je } else { i = i + 1 }
                } else {
                    if je > i { i = je } else { i = i + 1 }
                }
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    tx_puts("]}")
    write_frame()
}

// workspace/executeCommand — the server reports success and lets the
// client run the actual command (sounio.run / sounio.check) since the
// editor process is what owns the integrated terminal. We respond
// `null` so the editor sees a clean RPC ack.
fn respond_execute_command() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":null}")
    write_frame()
}

// workspace/willRenameFiles — v0 stub. The full WorkspaceEdit refactor
// needs a 256-byte URI extractor which isn't yet stable against the
// self-hosted codegen path (an i64 by-ref out-param triggered a
// crash). Returning `result: null` is the LSP spec's "no edits to
// propose" signal, so the editor proceeds with the bare rename. The
// capability is still advertised so renames route through the LSP and
// a future patch can fill in edits without changing client wiring.
fn respond_will_rename_stub() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":null}")
    write_frame()
}

// ============================================================================
// On-type formatting — textDocument/onTypeFormatting
// ============================================================================
//
// Fires after the user types one of the trigger characters. v0 handles:
//
//   `\n`  — Scan DOC_TEXT[0..cursor] counting net `{` - `}` (skipping
//           strings, chars, line / block comments), then insert
//           depth*4 spaces at the cursor.
//   `}`   — If the line containing the cursor is whitespace+`}`,
//           replace that leading whitespace with (depth-1)*4 spaces
//           where depth is the brace count at the start of the line.
//
// Both responses are a JSON array of TextEdits (possibly empty).

fn otf_count_brace_depth(end: i64) -> i64 with Mut, Panic {
    var d: i64 = 0
    var state: i64 = 0   // 0=code 1=" 2=' 3=// 4=/*
    var i: i64 = 0
    while i < end {
        let c = DOC_TEXT[i as usize] as i64
        if state == 1 {
            if c == 92 && i + 1 < end { i = i + 2 }
            else {
                if c == 34 { state = 0 }
                i = i + 1
            }
        } else if state == 2 {
            if c == 92 && i + 1 < end { i = i + 2 }
            else {
                if c == 39 { state = 0 }
                i = i + 1
            }
        } else if state == 3 {
            if c == 10 { state = 0 }
            i = i + 1
        } else if state == 4 {
            if c == 42 && i + 1 < end && (DOC_TEXT[(i + 1) as usize] as i64) == 47 {
                state = 0; i = i + 2
            } else { i = i + 1 }
        } else {
            if c == 34 { state = 1; i = i + 1 }
            else if c == 39 { state = 2; i = i + 1 }
            else if c == 47 && i + 1 < end && (DOC_TEXT[(i + 1) as usize] as i64) == 47 {
                state = 3; i = i + 2
            } else if c == 47 && i + 1 < end && (DOC_TEXT[(i + 1) as usize] as i64) == 42 {
                state = 4; i = i + 2
            } else {
                if c == 123 { d = d + 1 }
                else if c == 125 { d = d - 1 }
                i = i + 1
            }
        }
    }
    if d < 0 { d = 0 }
    return d
}

fn respond_on_type_formatting() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        tx_reset()
        tx_puts("{\"jsonrpc\":\"2.0\",")
        tx_emit_id()
        tx_puts(",\"result\":[]}")
        write_frame()
        return
    }
    parse_hover_position()

    // Detect the typed character. body_extract_str drops the escape
    // pair `\n` so it can't represent newline; instead, peek directly
    // at the byte sequence after `"ch":"` in RX_BODY.
    var trigger: i64 = 0
    let chp = body_find("\"ch\"", 0)
    if chp >= 0 {
        var j = chp + 4
        while j < RX_BODY_LEN {
            let c = RX_BODY[j as usize] as i64
            if c == 34 { j = j + 1; break }
            j = j + 1
        }
        if j < RX_BODY_LEN {
            let c0 = RX_BODY[j as usize] as i64
            if c0 == 92 && j + 1 < RX_BODY_LEN {
                let c1 = RX_BODY[(j + 1) as usize] as i64
                if c1 == 110 { trigger = 10 }       // \n
                else if c1 == 116 { trigger = 9 }   // \t
                else if c1 == 114 { trigger = 13 }  // \r
                else { trigger = c1 }
            } else {
                trigger = c0
            }
        }
    }

    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":[")

    if HOVER_OK == 1 && trigger != 0 {
        // Cursor byte offset.
        var i: i64 = 0
        var line: i64 = 0
        while i < DOC_TEXT_LEN && line < HOVER_LINE {
            if (DOC_TEXT[i as usize] as i64) == 10 { line = line + 1 }
            i = i + 1
        }
        var cur = i
        var col: i64 = 0
        while col < HOVER_CHAR && cur < DOC_TEXT_LEN {
            let c = DOC_TEXT[cur as usize] as i64
            if c == 10 { col = HOVER_CHAR } else { cur = cur + 1; col = col + 1 }
        }

        let first = trigger
        if first == 10 {
            // Newline trigger — count braces up to the cursor and emit
            // depth*4 spaces.
            let depth = otf_count_brace_depth(cur)
            let n_spaces = depth * 4
            if n_spaces > 0 {
                tx_puts("{\"range\":{\"start\":{\"line\":")
                tx_put_i64(HOVER_LINE)
                tx_puts(",\"character\":")
                tx_put_i64(HOVER_CHAR)
                tx_puts("},\"end\":{\"line\":")
                tx_put_i64(HOVER_LINE)
                tx_puts(",\"character\":")
                tx_put_i64(HOVER_CHAR)
                tx_puts("}},\"newText\":\"")
                var s: i64 = 0
                while s < n_spaces { tx_putc(32); s = s + 1 }
                tx_puts("\"}")
            }
        } else if first == 125 {
            // `}` trigger — if the current line is whitespace + `}`,
            // align to (depth-1)*4 columns. We find the start of the
            // line, then scan forward for non-whitespace. If the first
            // non-ws byte is `}`, replace the leading whitespace.
            var ls = cur - 1
            while ls > 0 {
                let c = DOC_TEXT[(ls - 1) as usize] as i64
                if c == 10 { break }
                ls = ls - 1
            }
            if ls < 0 { ls = 0 }
            var nws = ls
            while nws < DOC_TEXT_LEN {
                let c = DOC_TEXT[nws as usize] as i64
                if c == 32 || c == 9 { nws = nws + 1 } else { break }
            }
            if nws < DOC_TEXT_LEN && (DOC_TEXT[nws as usize] as i64) == 125 {
                let depth_at_line = otf_count_brace_depth(ls)
                var target_indent = (depth_at_line - 1) * 4
                if target_indent < 0 { target_indent = 0 }
                let cur_indent = nws - ls
                if cur_indent != target_indent {
                    tx_puts("{\"range\":{\"start\":{\"line\":")
                    tx_put_i64(HOVER_LINE)
                    tx_puts(",\"character\":0},\"end\":{\"line\":")
                    tx_put_i64(HOVER_LINE)
                    tx_puts(",\"character\":")
                    tx_put_i64(cur_indent)
                    tx_puts("}},\"newText\":\"")
                    var s: i64 = 0
                    while s < target_indent { tx_putc(32); s = s + 1 }
                    tx_puts("\"}")
                }
            }
        }
    }

    tx_puts("]}")
    write_frame()
}

// ============================================================================
// Semantic tokens — textDocument/semanticTokens/full
// ============================================================================
//
// LSP semantic-tokens response is an encoded uint[] of 5-tuples
// (deltaLine, deltaStartChar, length, tokenType, tokenModifiers).
// Lines and chars are deltas from the previous emitted token; for the
// first token they are absolute. tokenType is an index into the legend
// advertised in capabilities (see ST_TYPE_* below).
//
// v0 tokens emitted: keywords, primitive type names, the identifier
// after `fn` (= function decl), strings, integer + float literals,
// `//` line comments, `/* */` block comments. Identifiers that aren't
// keywords / types / fn-decl are NOT emitted (the editor's TextMate
// grammar handles them by default; LSP semantic tokens are an overlay).

let ST_TYPE_KEYWORD:  i64 = 0
let ST_TYPE_TYPE:     i64 = 1
let ST_TYPE_VARIABLE: i64 = 2
let ST_TYPE_FUNCTION: i64 = 3
let ST_TYPE_STRING:   i64 = 4
let ST_TYPE_NUMBER:   i64 = 5
let ST_TYPE_COMMENT:  i64 = 6
let ST_TYPE_OPERATOR: i64 = 7

// Position cursor of the most recently emitted token (used to compute
// deltas for the next one).
var ST_PREV_LINE: i64 = 0
var ST_PREV_CHAR: i64 = 0
var ST_EMITTED:   i64 = 0

// Range filter for /semanticTokens/range. When ST_RANGE_ACTIVE == 1
// st_emit drops tokens whose start position is outside the half-open
// interval [(ST_RANGE_S_LINE, ST_RANGE_S_CHAR),
// (ST_RANGE_E_LINE, ST_RANGE_E_CHAR)). Skipped tokens do not update
// ST_PREV_*, so subsequent deltas remain valid for emitted tokens.
var ST_RANGE_ACTIVE: i64 = 0
var ST_RANGE_S_LINE: i64 = 0
var ST_RANGE_S_CHAR: i64 = 0
var ST_RANGE_E_LINE: i64 = 0
var ST_RANGE_E_CHAR: i64 = 0

// Collect mode for /full and /full/delta (Sprint-2 #5). When
// ST_COLLECT == 1, st_emit appends the encoded 5-tuple to ST_BUF (as
// raw i64 words) instead of streaming JSON into tx. The buffered form
// is what delta diffs against the cached previous result.
var ST_COLLECT: i64 = 0
var ST_BUF: [i64; 262144] = [0; 262144]
var ST_BUF_LEN: i64 = 0
// Cached last /full-or-delta result for delta diffs.
var ST_CACHE: [i64; 262144] = [0; 262144]
var ST_CACHE_LEN: i64 = 0
var ST_CACHE_RID: i64 = 0
var ST_RID_COUNTER: i64 = 0

fn st_emit(line: i64, col: i64, length: i64, ttype: i64) with Mut, Panic, Div {
    if length <= 0 { return }
    if ST_RANGE_ACTIVE == 1 {
        if line < ST_RANGE_S_LINE { return }
        if line == ST_RANGE_S_LINE && col < ST_RANGE_S_CHAR { return }
        if line > ST_RANGE_E_LINE { return }
        if line == ST_RANGE_E_LINE && col >= ST_RANGE_E_CHAR { return }
    }
    var dline: i64 = 0
    var dchar: i64 = 0
    if line == ST_PREV_LINE {
        dline = 0
        dchar = col - ST_PREV_CHAR
    } else {
        dline = line - ST_PREV_LINE
        dchar = col
    }
    if ST_COLLECT == 1 {
        if ST_BUF_LEN + 5 <= 262144 {
            ST_BUF[ST_BUF_LEN as usize] = dline
            ST_BUF[(ST_BUF_LEN + 1) as usize] = dchar
            ST_BUF[(ST_BUF_LEN + 2) as usize] = length
            ST_BUF[(ST_BUF_LEN + 3) as usize] = ttype
            ST_BUF[(ST_BUF_LEN + 4) as usize] = 0
            ST_BUF_LEN = ST_BUF_LEN + 5
        }
        ST_PREV_LINE = line
        ST_PREV_CHAR = col
        return
    }
    if ST_EMITTED == 1 { tx_putc(44) }
    ST_EMITTED = 1
    tx_put_i64(dline); tx_putc(44)
    tx_put_i64(dchar); tx_putc(44)
    tx_put_i64(length); tx_putc(44)
    tx_put_i64(ttype); tx_putc(44)
    tx_put_i64(0)
    ST_PREV_LINE = line
    ST_PREV_CHAR = col
}

// Classify an identifier at DOC_TEXT[s..e]. Returns ST_TYPE_* or -1
// when the run is not worth emitting (regular variable / parameter).
fn st_classify_ident(s: i64, e: i64) -> i64 with Mut, Panic {
    let nlen = e - s
    if nlen <= 0 { return 0 - 1 }
    // Keywords
    if ident_slice_eq(s, e, "fn")       { return ST_TYPE_KEYWORD }
    if ident_slice_eq(s, e, "let")      { return ST_TYPE_KEYWORD }
    if ident_slice_eq(s, e, "var")      { return ST_TYPE_KEYWORD }
    if ident_slice_eq(s, e, "if")       { return ST_TYPE_KEYWORD }
    if ident_slice_eq(s, e, "else")     { return ST_TYPE_KEYWORD }
    if ident_slice_eq(s, e, "while")    { return ST_TYPE_KEYWORD }
    if ident_slice_eq(s, e, "return")   { return ST_TYPE_KEYWORD }
    if ident_slice_eq(s, e, "with")     { return ST_TYPE_KEYWORD }
    if ident_slice_eq(s, e, "struct")   { return ST_TYPE_KEYWORD }
    if ident_slice_eq(s, e, "enum")     { return ST_TYPE_KEYWORD }
    if ident_slice_eq(s, e, "match")    { return ST_TYPE_KEYWORD }
    if ident_slice_eq(s, e, "break")    { return ST_TYPE_KEYWORD }
    if ident_slice_eq(s, e, "continue") { return ST_TYPE_KEYWORD }
    if ident_slice_eq(s, e, "true")     { return ST_TYPE_KEYWORD }
    if ident_slice_eq(s, e, "false")    { return ST_TYPE_KEYWORD }
    if ident_slice_eq(s, e, "as")       { return ST_TYPE_KEYWORD }
    if ident_slice_eq(s, e, "pub")      { return ST_TYPE_KEYWORD }
    if ident_slice_eq(s, e, "use")      { return ST_TYPE_KEYWORD }
    if ident_slice_eq(s, e, "mod")      { return ST_TYPE_KEYWORD }
    if ident_slice_eq(s, e, "spawn")    { return ST_TYPE_KEYWORD }
    if ident_slice_eq(s, e, "loop")     { return ST_TYPE_KEYWORD }
    // Primitive types + effects
    if ident_slice_eq(s, e, "i8")    { return ST_TYPE_TYPE }
    if ident_slice_eq(s, e, "i16")   { return ST_TYPE_TYPE }
    if ident_slice_eq(s, e, "i32")   { return ST_TYPE_TYPE }
    if ident_slice_eq(s, e, "i64")   { return ST_TYPE_TYPE }
    if ident_slice_eq(s, e, "u8")    { return ST_TYPE_TYPE }
    if ident_slice_eq(s, e, "u32")   { return ST_TYPE_TYPE }
    if ident_slice_eq(s, e, "u64")   { return ST_TYPE_TYPE }
    if ident_slice_eq(s, e, "usize") { return ST_TYPE_TYPE }
    if ident_slice_eq(s, e, "f32")   { return ST_TYPE_TYPE }
    if ident_slice_eq(s, e, "f64")   { return ST_TYPE_TYPE }
    if ident_slice_eq(s, e, "bool")  { return ST_TYPE_TYPE }
    if ident_slice_eq(s, e, "string"){ return ST_TYPE_TYPE }
    if ident_slice_eq(s, e, "IO")    { return ST_TYPE_TYPE }
    if ident_slice_eq(s, e, "Mut")   { return ST_TYPE_TYPE }
    if ident_slice_eq(s, e, "Panic") { return ST_TYPE_TYPE }
    if ident_slice_eq(s, e, "Div")   { return ST_TYPE_TYPE }
    if ident_slice_eq(s, e, "Async") { return ST_TYPE_TYPE }
    if ident_slice_eq(s, e, "GPU")   { return ST_TYPE_TYPE }
    if ident_slice_eq(s, e, "Alloc") { return ST_TYPE_TYPE }
    // User-defined types (PascalCase heuristic)
    let first = DOC_TEXT[s as usize] as i64
    if first >= 65 && first <= 90 { return ST_TYPE_TYPE }
    return 0 - 1
}

// Scan DOC_TEXT and emit semantic tokens via st_emit. Shared by
// /full (collect mode), /range (tx mode) and /full/delta (collect).
fn st_scan_document() with Mut, Panic, Div {
    var i: i64 = 0
    var line: i64 = 0
    var col: i64 = 0
    while i < DOC_TEXT_LEN {
        let c = DOC_TEXT[i as usize] as i64
        // Newline
        if c == 10 {
            line = line + 1
            col = 0
            i = i + 1
            continue
        }
        // // line comment
        if c == 47 && i + 1 < DOC_TEXT_LEN && (DOC_TEXT[(i + 1) as usize] as i64) == 47 {
            var p = i
            while p < DOC_TEXT_LEN && (DOC_TEXT[p as usize] as i64) != 10 { p = p + 1 }
            st_emit(line, col, p - i, ST_TYPE_COMMENT)
            col = col + (p - i)
            i = p
            continue
        }
        // /* block comment */ (single-line emit only; multi-line gets
        // tokenized as one comment span on the start line)
        if c == 47 && i + 1 < DOC_TEXT_LEN && (DOC_TEXT[(i + 1) as usize] as i64) == 42 {
            let start_line = line
            let start_col = col
            var p = i + 2
            var inner_col = col + 2
            var inner_line = line
            var closed: i64 = 0
            while p + 1 < DOC_TEXT_LEN && closed == 0 {
                let cc = DOC_TEXT[p as usize] as i64
                if cc == 42 && (DOC_TEXT[(p + 1) as usize] as i64) == 47 {
                    closed = 1
                    p = p + 2
                    inner_col = inner_col + 2
                } else if cc == 10 {
                    inner_line = inner_line + 1
                    inner_col = 0
                    p = p + 1
                } else {
                    inner_col = inner_col + 1
                    p = p + 1
                }
            }
            // Emit a token only for the portion on the comment's start line.
            // VS Code semantic tokens don't natively span lines; multi-line
            // block comments fall back to TextMate highlighting for the
            // continuation.
            if inner_line == start_line {
                st_emit(start_line, start_col, p - i, ST_TYPE_COMMENT)
            } else {
                // first-line span
                var j = i
                while j < DOC_TEXT_LEN && (DOC_TEXT[j as usize] as i64) != 10 { j = j + 1 }
                st_emit(start_line, start_col, j - i, ST_TYPE_COMMENT)
            }
            line = inner_line
            col = inner_col
            i = p
            continue
        }
        // String literal
        if c == 34 {
            let start_col = col
            let start_line = line
            var p = i + 1
            var inner_col = col + 1
            while p < DOC_TEXT_LEN {
                let cc = DOC_TEXT[p as usize] as i64
                if cc == 92 && p + 1 < DOC_TEXT_LEN {
                    p = p + 2
                    inner_col = inner_col + 2
                } else if cc == 34 {
                    p = p + 1
                    inner_col = inner_col + 1
                    break
                } else if cc == 10 {
                    // unterminated single-line string; bail
                    p = p
                    break
                } else {
                    p = p + 1
                    inner_col = inner_col + 1
                }
            }
            st_emit(start_line, start_col, p - i, ST_TYPE_STRING)
            col = inner_col
            i = p
            continue
        }
        // Number literal (integer or float; hex like 0x1A also accepted)
        if c >= 48 && c <= 57 {
            let start_col = col
            var p = i
            while p < DOC_TEXT_LEN {
                let cc = DOC_TEXT[p as usize] as i64
                let is_digit = cc >= 48 && cc <= 57
                let is_hex = (cc >= 97 && cc <= 102) || (cc >= 65 && cc <= 70)
                let is_x = cc == 88 || cc == 120
                let is_dot = cc == 46
                let is_under = cc == 95
                if is_digit == false && is_hex == false && is_x == false && is_dot == false && is_under == false {
                    break
                }
                p = p + 1
            }
            st_emit(line, start_col, p - i, ST_TYPE_NUMBER)
            col = col + (p - i)
            i = p
            continue
        }
        // Identifier
        if is_ident_byte(c) == true {
            let start_col = col
            let s = i
            let e = read_ident_run(i)
            let kind = st_classify_ident(s, e)
            if kind >= 0 {
                st_emit(line, start_col, e - s, kind)
            }
            // Heuristic: after `fn` keyword token, classify the next
            // identifier on the same line as a function name.
            if ident_slice_eq(s, e, "fn") == true {
                var q = e
                var qcol = col + (e - s)
                while q < DOC_TEXT_LEN {
                    let qc = DOC_TEXT[q as usize] as i64
                    if qc == 32 || qc == 9 { q = q + 1; qcol = qcol + 1 }
                    else { break }
                }
                if q < DOC_TEXT_LEN && is_ident_byte(DOC_TEXT[q as usize] as i64) == true {
                    let fs = q
                    let fe = read_ident_run(q)
                    st_emit(line, qcol, fe - fs, ST_TYPE_FUNCTION)
                    col = qcol + (fe - fs)
                    i = fe
                    continue
                }
            }
            col = col + (e - s)
            i = e
            continue
        }
        // Other bytes (operators, punctuation) — just advance
        col = col + 1
        i = i + 1
    }
}

// Serialize ST_BUF[0..ST_BUF_LEN] into tx as a comma-separated int list.
fn st_serialize_buf() with Mut, Panic, Div {
    var j: i64 = 0
    while j < ST_BUF_LEN {
        if j > 0 { tx_putc(44) }
        tx_put_i64(ST_BUF[j as usize])
        j = j + 1
    }
}

// Copy ST_BUF into ST_CACHE and record the resultId it was served under.
fn st_cache_save() with Mut {
    var j: i64 = 0
    while j < ST_BUF_LEN {
        ST_CACHE[j as usize] = ST_BUF[j as usize]
        j = j + 1
    }
    ST_CACHE_LEN = ST_BUF_LEN
    ST_CACHE_RID = ST_RID_COUNTER
}

// Reset collect-mode cursor state, scan the active document into
// ST_BUF, and leave collect mode. Shared by /full and /full/delta.
fn st_collect_document() with Mut, Panic, Div {
    ST_COLLECT = 1
    ST_BUF_LEN = 0
    ST_EMITTED = 0
    ST_PREV_LINE = 0
    ST_PREV_CHAR = 0
    st_scan_document()
    ST_COLLECT = 0
}

// textDocument/semanticTokens/full — collect scan, then serve
// {"data":[...],"resultId":"st<N>"} and cache the buffer for /delta.
fn respond_semantic_tokens() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        respond_empty_result()
        return
    }
    st_collect_document()
    ST_RID_COUNTER = ST_RID_COUNTER + 1
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":{\"data\":[")
    st_serialize_buf()
    tx_puts("],\"resultId\":\"st")
    tx_put_i64(ST_RID_COUNTER)
    tx_puts("\"}}")
    write_frame()
    st_cache_save()
}

// textDocument/semanticTokens/full as a tx-streaming variant used by
// /range (kept byte-identical to the pre-delta /full output shape:
// no resultId wrapper).
fn respond_semantic_tokens_tx() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        respond_empty_result()
        return
    }
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":{\"data\":[")
    ST_EMITTED = 0
    ST_PREV_LINE = 0
    ST_PREV_CHAR = 0
    st_scan_document()
    tx_puts("]}}")
    write_frame()
}

// Parse params.previousResultId ("st<N>") -> N, or -1 when absent.
fn st_parse_previous_result_id() -> i64 with Mut, Panic, Div {
    let kp = body_find("\"previousResultId\"", 0)
    if kp < 0 { return 0 - 1 }
    let sp = body_find("\"st", kp)
    if sp < 0 { return 0 - 1 }
    // Digits start right after the `"st` prefix (quoted value — no colon
    // walk, unlike body_read_int_after).
    var i = sp + 3
    if i >= RX_BODY_LEN { return 0 - 1 }
    let first = RX_BODY[i as usize] as i64
    if first < 48 || first > 57 { return 0 - 1 }
    var v: i64 = 0
    while i < RX_BODY_LEN {
        let c = RX_BODY[i as usize] as i64
        if c < 48 || c > 57 { break }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    return v
}

// textDocument/semanticTokens/full/delta — rescan the document and
// diff against the cached buffer from the matching resultId. Emits a
// single-edit SemanticTokensEdits (common prefix/suffix); falls back
// to a full result when previousResultId is missing or stale.
fn respond_semantic_tokens_delta() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        respond_empty_result()
        return
    }
    let prev_rid = st_parse_previous_result_id()
    st_collect_document()
    if prev_rid < 0 || prev_rid != ST_CACHE_RID || ST_CACHE_LEN == 0 {
        // Stale or missing previousResultId — full result fallback.
        ST_RID_COUNTER = ST_RID_COUNTER + 1
        tx_reset()
        tx_puts("{\"jsonrpc\":\"2.0\",")
        tx_emit_id()
        tx_puts(",\"result\":{\"data\":[")
        st_serialize_buf()
        tx_puts("],\"resultId\":\"st")
        tx_put_i64(ST_RID_COUNTER)
        tx_puts("\"}}")
        write_frame()
        st_cache_save()
        return
    }
    // Common prefix (rounded down to a 5-tuple boundary).
    var p: i64 = 0
    var minlen = ST_BUF_LEN
    if ST_CACHE_LEN < minlen {
        minlen = ST_CACHE_LEN
    }
    while p < minlen && (ST_BUF[p as usize] == ST_CACHE[p as usize]) {
        p = p + 1
    }
    p = (p / 5) * 5
    // Common suffix beyond the prefix (also tuple-aligned).
    var s: i64 = 0
    while s < (minlen - p) && (ST_BUF[(ST_BUF_LEN - 1 - s) as usize] == ST_CACHE[(ST_CACHE_LEN - 1 - s) as usize]) {
        s = s + 1
    }
    s = (s / 5) * 5
    let delete_count = ST_CACHE_LEN - p - s
    let new_count = ST_BUF_LEN - p - s
    ST_RID_COUNTER = ST_RID_COUNTER + 1
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":{\"resultId\":\"st")
    tx_put_i64(ST_RID_COUNTER)
    tx_puts("\"")
    if delete_count == 0 && new_count == 0 {
        tx_puts(",\"edits\":[]}}")
    } else {
        tx_puts(",\"edits\":[{\"start\":")
        tx_put_i64(p)
        tx_puts(",\"deleteCount\":")
        tx_put_i64(delete_count)
        tx_puts(",\"data\":[")
        var j: i64 = 0
        while j < new_count {
            if j > 0 { tx_putc(44) }
            tx_put_i64(ST_BUF[(p + j) as usize])
            j = j + 1
        }
        tx_puts("]}]}}")
    }
    write_frame()
    st_cache_save()
}

// Parse params.range as (line, character) pairs into ST_RANGE_*.
// Returns true on success.  Re-uses body_find's in-order key walk: the
// first two "line"/"character" pairs are range.start and range.end.
fn st_parse_range() -> bool with Mut, Panic, Div {
    let lp1 = body_find("\"line\"", 0)
    if lp1 < 0 { return false }
    let cp1 = body_find("\"character\"", lp1)
    if cp1 < 0 { return false }
    let lp2 = body_find("\"line\"", cp1)
    if lp2 < 0 { return false }
    let cp2 = body_find("\"character\"", lp2)
    if cp2 < 0 { return false }
    let s_ln = body_read_int_after(lp1 + 6)
    let s_ch = body_read_int_after(cp1 + 11)
    let e_ln = body_read_int_after(lp2 + 6)
    let e_ch = body_read_int_after(cp2 + 11)
    if s_ln < 0 || s_ch < 0 || e_ln < 0 || e_ch < 0 { return false }
    ST_RANGE_S_LINE = s_ln
    ST_RANGE_S_CHAR = s_ch
    ST_RANGE_E_LINE = e_ln
    ST_RANGE_E_CHAR = e_ch
    return true
}

// textDocument/semanticTokens/range — same scanner as /full with an
// emission filter restricting tokens whose start position falls outside
// params.range.  Delta encoding remains valid because skipped tokens do
// not update ST_PREV_*.
fn respond_semantic_tokens_range() with IO, Mut, Panic, Div {
    if st_parse_range() == true {
        ST_RANGE_ACTIVE = 1
    } else {
        ST_RANGE_ACTIVE = 0
    }
    respond_semantic_tokens_tx()
    ST_RANGE_ACTIVE = 0
}

// ============================================================================
// Document symbols — textDocument/documentSymbol
// ============================================================================
//
// Walks DOC_TEXT for top-level declarators (`fn`, `struct`, `enum`,
// `let`, `var`) and emits a flat DocumentSymbol[] — one entry per
// declaration. Kinds follow the LSP SymbolKind enum:
//   12 Function, 13 Variable, 22 Struct, 10 Enum
//
// LSP also supports a hierarchical DocumentSymbol (children for nested
// scopes). v0 is flat; a follow-up could nest `let`/`var` inside their
// enclosing fn.

let SK_FUNCTION: i64 = 12
let SK_VARIABLE: i64 = 13
let SK_STRUCT:   i64 = 22
let SK_ENUM:     i64 = 10

var DSYM_EMITTED: i64 = 0

// Emit a single DocumentSymbol JSON object given the declared name at
// DOC_TEXT[ns..ns+nlen] and the line:char of `ns`. The selectionRange
// is the name itself; the range covers the whole declared name only
// (v0 — no body-span tracking).
fn dsym_emit(ns: i64, nlen: i64, kind: i64) with Mut, Panic, Div {
    if DSYM_EMITTED == 1 { tx_putc(44) }
    DSYM_EMITTED = 1
    offset_to_position(ns, 0)   // populates DEF_LINE / DEF_CHAR
    tx_puts("{\"name\":\"")
    var i: i64 = 0
    while i < nlen {
        let c = DOC_TEXT[(ns + i) as usize] as i64
        if c == 34 { tx_putc(92); tx_putc(34) }
        else if c == 92 { tx_putc(92); tx_putc(92) }
        else { tx_putc(c) }
        i = i + 1
    }
    tx_puts("\",\"kind\":")
    tx_put_i64(kind)
    tx_puts(",\"range\":{\"start\":{\"line\":")
    tx_put_i64(DEF_LINE)
    tx_puts(",\"character\":")
    tx_put_i64(DEF_CHAR)
    tx_puts("},\"end\":{\"line\":")
    tx_put_i64(DEF_LINE)
    tx_puts(",\"character\":")
    tx_put_i64(DEF_CHAR + nlen)
    tx_puts("}},\"selectionRange\":{\"start\":{\"line\":")
    tx_put_i64(DEF_LINE)
    tx_puts(",\"character\":")
    tx_put_i64(DEF_CHAR)
    tx_puts("},\"end\":{\"line\":")
    tx_put_i64(DEF_LINE)
    tx_puts(",\"character\":")
    tx_put_i64(DEF_CHAR + nlen)
    tx_puts("}}}")
}

fn respond_document_symbol() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        respond_empty_result()
        return
    }
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":[")
    DSYM_EMITTED = 0
    var i: i64 = 0
    while i < DOC_TEXT_LEN {
        var at_word_start: bool = false
        if i == 0 { at_word_start = true }
        else if is_ident_byte(DOC_TEXT[(i - 1) as usize] as i64) == false { at_word_start = true }
        if at_word_start == false {
            i = i + 1
        } else {
            let je = read_ident_run(i)
            if je == i {
                // not an identifier byte — advance
                i = i + 1
            } else {
                // If this keyword is `pub`, peek at the next token.
                var kw_start = i
                var kw_end   = je
                if ident_slice_eq(kw_start, kw_end, "pub") == true {
                    let kw2_s = skip_ws(kw_end)
                    let kw2_e = read_ident_run(kw2_s)
                    if kw2_e > kw2_s {
                        kw_start = kw2_s
                        kw_end   = kw2_e
                    }
                }
                var kind: i64 = 0
                if      ident_slice_eq(kw_start, kw_end, "fn")     { kind = SK_FUNCTION }
                else if ident_slice_eq(kw_start, kw_end, "struct") { kind = SK_STRUCT }
                else if ident_slice_eq(kw_start, kw_end, "enum")   { kind = SK_ENUM }
                else if ident_slice_eq(kw_start, kw_end, "let")    { kind = SK_VARIABLE }
                else if ident_slice_eq(kw_start, kw_end, "var")    { kind = SK_VARIABLE }
                if kind != 0 {
                    let ns = skip_ws(kw_end)
                    let ne = read_ident_run(ns)
                    let nlen = ne - ns
                    if nlen > 0 { dsym_emit(ns, nlen, kind) }
                    if ne > kw_end { i = ne } else { i = kw_end }
                } else {
                    // Not a declarator keyword. Advance past the
                    // identifier we just read.
                    i = je
                }
            }
        }
    }
    tx_puts("]}")
    write_frame()
}

fn respond_definition() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        respond_empty_result()
        return
    }
    parse_hover_position()
    let home_slot = slot_find_by_uri()
    var have: i64 = 0
    var from_resolve: i64 = 0
    if HOVER_OK == 1 {
        let n = locate_ident()
        if n > 0 {
            // Tier 1: in-file declarator scan
            scan_definition_for_ident()
            if DEF_FOUND == 0 {
                // Tier 2: peer open buffers
                scan_definition_cross_file(home_slot)
            }
            if DEF_FOUND == 0 {
                // Tier 3: `souc inspect --resolve NAME` walks the
                // `use` graph from disk. We need the active doc on
                // disk for the resolver to see its imports.
                if write_doc_to_disk() == true {
                    if fetch_resolved_decl() == true {
                        from_resolve = 1
                        have = 1
                    }
                }
            }
            if DEF_FOUND == 1 { have = 1 }
        }
    }
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    if have == 1 {
        tx_puts(",\"result\":{\"uri\":\"")
        if from_resolve == 1 {
            // Emit file:// + the absolute path the resolver returned.
            // RESOLVED_FILE already lacks the file:// prefix.
            tx_puts("file://")
            var i: i64 = 0
            while i < RESOLVED_FILE_LEN {
                let c = RESOLVED_FILE[i as usize] as i64
                if c == 34 { tx_putc(92); tx_putc(34) }
                else if c == 92 { tx_putc(92); tx_putc(92) }
                else if c == 32 { tx_puts("%20") }
                else { tx_putc(c) }
                i = i + 1
            }
        } else if DEF_SLOT >= 0 {
            let base = DEF_SLOT * 1024
            let ulen = DOC_SLOT_URI_LEN[DEF_SLOT as usize]
            var i: i64 = 0
            while i < ulen {
                let c = DOC_SLOT_URI[(base + i) as usize] as i64
                if c == 34 { tx_putc(92); tx_putc(34) }
                else if c == 92 { tx_putc(92); tx_putc(92) }
                else { tx_putc(c) }
                i = i + 1
            }
        } else {
            var i: i64 = 0
            while i < DOC_URI_LEN {
                let c = DOC_URI[i as usize] as i64
                if c == 34 { tx_putc(92); tx_putc(34) }
                else if c == 92 { tx_putc(92); tx_putc(92) }
                else { tx_putc(c) }
                i = i + 1
            }
        }
        var resp_line = DEF_LINE
        var resp_char = DEF_CHAR
        var resp_name_len = DEF_NAME_LEN
        if from_resolve == 1 {
            resp_line = RESOLVED_LINE
            resp_char = RESOLVED_CHAR
            resp_name_len = IDENT_LEN
        }
        tx_puts("\",\"range\":{\"start\":{\"line\":")
        tx_put_i64(resp_line)
        tx_puts(",\"character\":")
        tx_put_i64(resp_char)
        tx_puts("},\"end\":{\"line\":")
        tx_put_i64(resp_line)
        tx_puts(",\"character\":")
        tx_put_i64(resp_char + resp_name_len)
        tx_puts("}}}")
    } else {
        tx_puts(",\"result\":null")
    }
    tx_puts("}")
    write_frame()
}

// ============================================================================
// References — textDocument/references
// ============================================================================
//
// Word-boundary occurrence scan of DOC_TEXT for IDENT_BUF. Each match
// emits a Location pointing into DOC_URI. Honors
// `params.context.includeDeclaration`: if false, the declaration site
// (found via scan_definition_for_ident) is skipped.

var REF_INCLUDE_DECL: i64 = 1  // 1 = include declaration in results
var REF_EMITTED: i64 = 0       // first-item-no-comma sentinel

// Parse `params.context.includeDeclaration` (default true). LSP encodes
// it as a literal `true` / `false` after the key.
fn parse_include_decl() with Mut, Panic {
    REF_INCLUDE_DECL = 1
    let kpos = body_find("\"includeDeclaration\"", 0)
    if kpos < 0 { return }
    var i = kpos + 20
    while i < RX_BODY_LEN {
        let c = RX_BODY[i as usize] as i64
        if c == 58 { i = i + 1; break }
        i = i + 1
    }
    while i < RX_BODY_LEN {
        let c = RX_BODY[i as usize] as i64
        if c != 32 && c != 9 { break }
        i = i + 1
    }
    if i + 5 <= RX_BODY_LEN {
        let b0 = RX_BODY[i as usize] as i64
        if b0 == 102 { REF_INCLUDE_DECL = 0 }   // 'f' of false
    }
}

// True if DOC_TEXT[i..i+IDENT_LEN] is the captured identifier with
// non-ident-continue bytes on both sides (word boundary).
fn ref_match_at(i: i64) -> bool with Mut, Panic {
    if i + IDENT_LEN > DOC_TEXT_LEN { return false }
    if i > 0 {
        if is_ident_byte(DOC_TEXT[(i - 1) as usize] as i64) == true { return false }
    }
    if i + IDENT_LEN < DOC_TEXT_LEN {
        if is_ident_byte(DOC_TEXT[(i + IDENT_LEN) as usize] as i64) == true { return false }
    }
    var k: i64 = 0
    while k < IDENT_LEN {
        if (DOC_TEXT[(i + k) as usize] as i64) != (IDENT_BUF[k as usize] as i64) {
            return false
        }
        k = k + 1
    }
    return true
}

// Emit a Location object for the identifier at byte offset `off`.
fn ref_emit_location(off: i64) with Mut, Panic, Div {
    if REF_EMITTED == 1 { tx_putc(44) }
    REF_EMITTED = 1
    offset_to_position(off, 0)   // populates DEF_LINE / DEF_CHAR
    tx_puts("{\"uri\":\"")
    var i: i64 = 0
    while i < DOC_URI_LEN {
        let c = DOC_URI[i as usize] as i64
        if c == 34 { tx_putc(92); tx_putc(34) }
        else if c == 92 { tx_putc(92); tx_putc(92) }
        else { tx_putc(c) }
        i = i + 1
    }
    tx_puts("\",\"range\":{\"start\":{\"line\":")
    tx_put_i64(DEF_LINE)
    tx_puts(",\"character\":")
    tx_put_i64(DEF_CHAR)
    tx_puts("},\"end\":{\"line\":")
    tx_put_i64(DEF_LINE)
    tx_puts(",\"character\":")
    tx_put_i64(DEF_CHAR + IDENT_LEN)
    tx_puts("}}}")
}

fn respond_references() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        // Empty Location[] for unknown URI
        tx_reset()
        tx_puts("{\"jsonrpc\":\"2.0\",")
        tx_emit_id()
        tx_puts(",\"result\":[]}")
        write_frame()
        return
    }
    parse_hover_position()
    parse_include_decl()
    var ok: i64 = 0
    if HOVER_OK == 1 {
        let n = locate_ident()
        if n > 0 { ok = 1 }
    }
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":[")
    REF_EMITTED = 0
    if ok == 1 {
        // Find the declaration offset (so we can skip it when
        // includeDeclaration:false). We re-run scan and convert.
        scan_definition_for_ident()
        var skip_off: i64 = 0 - 1
        if DEF_FOUND == 1 && REF_INCLUDE_DECL == 0 {
            // recompute the byte offset that matches DEF_LINE/DEF_CHAR
            var ln: i64 = 0
            var col: i64 = 0
            var p: i64 = 0
            while p < DOC_TEXT_LEN && (ln < DEF_LINE || (ln == DEF_LINE && col < DEF_CHAR)) {
                let c = DOC_TEXT[p as usize] as i64
                if c == 10 { ln = ln + 1; col = 0 }
                else { col = col + 1 }
                p = p + 1
            }
            skip_off = p
        }
        var i: i64 = 0
        while i < DOC_TEXT_LEN {
            if ref_match_at(i) == true {
                if i != skip_off { ref_emit_location(i) }
                i = i + IDENT_LEN
            } else {
                i = i + 1
            }
        }
    }
    tx_puts("]}")
    write_frame()
}

// ============================================================================
// Rename — textDocument/rename
// ============================================================================
//
// Same word-boundary scan as references, but emits a WorkspaceEdit
// whose `changes[uri]` is an array of TextEdit. Each edit replaces the
// matched range with the requested `newName`.

var RENAME_NEW: [i8; 128] = [0; 128]
var RENAME_NEW_LEN: i64 = 0
var RENAME_EMITTED: i64 = 0

// Extract `params.newName`. Returns true on success.
fn parse_new_name() -> bool with Mut, Panic {
    RENAME_NEW_LEN = 0
    let pos = body_find("\"newName\"", 0)
    if pos < 0 { return false }
    var i = pos + 9
    var saw_quote: i64 = 0
    while i < RX_BODY_LEN && saw_quote == 0 {
        let c = RX_BODY[i as usize] as i64
        if c == 34 { saw_quote = 1 }
        i = i + 1
    }
    if saw_quote == 0 { return false }
    while i < RX_BODY_LEN && RENAME_NEW_LEN < 128 {
        let c = RX_BODY[i as usize] as i64
        if c == 34 { return RENAME_NEW_LEN > 0 }
        if c == 92 && i + 1 < RX_BODY_LEN {
            // simple escape skip — names rarely contain escapes
            i = i + 2
        } else {
            RENAME_NEW[RENAME_NEW_LEN as usize] = c as i8
            RENAME_NEW_LEN = RENAME_NEW_LEN + 1
            i = i + 1
        }
    }
    return RENAME_NEW_LEN > 0
}

// Validate newName is a non-empty Sounio identifier (first byte
// non-digit, all bytes ident-continue).
fn validate_new_name() -> bool with Mut, Panic {
    if RENAME_NEW_LEN <= 0 { return false }
    let first = RENAME_NEW[0] as i64
    if first >= 48 && first <= 57 { return false }
    var i: i64 = 0
    while i < RENAME_NEW_LEN {
        if is_ident_byte(RENAME_NEW[i as usize] as i64) == false { return false }
        i = i + 1
    }
    return true
}

fn rename_emit_text_edit(off: i64) with Mut, Panic, Div {
    if RENAME_EMITTED == 1 { tx_putc(44) }
    RENAME_EMITTED = 1
    offset_to_position(off, 0)
    tx_puts("{\"range\":{\"start\":{\"line\":")
    tx_put_i64(DEF_LINE)
    tx_puts(",\"character\":")
    tx_put_i64(DEF_CHAR)
    tx_puts("},\"end\":{\"line\":")
    tx_put_i64(DEF_LINE)
    tx_puts(",\"character\":")
    tx_put_i64(DEF_CHAR + IDENT_LEN)
    tx_puts("}},\"newText\":\"")
    var i: i64 = 0
    while i < RENAME_NEW_LEN {
        let c = RENAME_NEW[i as usize] as i64
        if c == 34 { tx_putc(92); tx_putc(34) }
        else if c == 92 { tx_putc(92); tx_putc(92) }
        else { tx_putc(c) }
        i = i + 1
    }
    tx_puts("\"}")
}

fn respond_rename() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    if activate_uri_slot() < 0 {
        respond_empty_result()
        return
    }
    parse_hover_position()
    let new_ok = parse_new_name()
    var ok: i64 = 0
    if HOVER_OK == 1 && new_ok == true && validate_new_name() == true {
        let n = locate_ident()
        if n > 0 { ok = 1 }
    }
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    if ok == 0 {
        tx_puts(",\"result\":null}")
        write_frame()
        return
    }
    // Build WorkspaceEdit
    tx_puts(",\"result\":{\"changes\":{\"")
    var u: i64 = 0
    while u < DOC_URI_LEN {
        let c = DOC_URI[u as usize] as i64
        if c == 34 { tx_putc(92); tx_putc(34) }
        else if c == 92 { tx_putc(92); tx_putc(92) }
        else { tx_putc(c) }
        u = u + 1
    }
    tx_puts("\":[")
    RENAME_EMITTED = 0
    var i: i64 = 0
    while i < DOC_TEXT_LEN {
        if ref_match_at(i) == true {
            rename_emit_text_edit(i)
            i = i + IDENT_LEN
        } else {
            i = i + 1
        }
    }
    tx_puts("]}}}")
    write_frame()
}

// ============================================================================
// Sprint-2 #8 — incremental textDocumentSync (kind=2)
// ============================================================================
//
// didChange payloads carry contentChanges[]; each entry is either a
// full-document replacement (no "range") or a ranged edit. Entries are
// applied in order against the stored slot text, then diagnostics rerun.
// Positions are interpreted with the same byte-based line/character math
// the rest of the server uses.

var CHANGE_TEXT: [i8; 262144] = [0; 262144]
var CHANGE_TEXT_LEN: i64 = 0
var CH_SL: i64 = 0
var CH_SC: i64 = 0
var CH_EL: i64 = 0
var CH_EC: i64 = 0

// Decode the JSON string value of the "text" key at key_pos into
// CHANGE_TEXT (same escape set as extract_doc_text). Returns the body
// index just past the closing quote, or -1 on malformed input.
fn extract_change_text(key_pos: i64) -> i64 with Mut, Panic, Div {
    CHANGE_TEXT_LEN = 0
    var i = key_pos + 6
    var saw_quote: i64 = 0
    while i < RX_BODY_LEN && saw_quote == 0 {
        let c = RX_BODY[i as usize] as i64
        if c == 34 {
            saw_quote = 1
        }
        i = i + 1
    }
    if saw_quote == 0 { return 0 - 1 }
    while i < RX_BODY_LEN && CHANGE_TEXT_LEN < 262144 {
        let c = RX_BODY[i as usize] as i64
        if c == 34 { return i + 1 }
        if c == 92 && i + 1 < RX_BODY_LEN {
            let n = RX_BODY[(i + 1) as usize] as i64
            if n == 110 {
                CHANGE_TEXT[CHANGE_TEXT_LEN as usize] = 10 as i8
                CHANGE_TEXT_LEN = CHANGE_TEXT_LEN + 1
                i = i + 2
            } else if n == 114 {
                CHANGE_TEXT[CHANGE_TEXT_LEN as usize] = 13 as i8
                CHANGE_TEXT_LEN = CHANGE_TEXT_LEN + 1
                i = i + 2
            } else if n == 116 {
                CHANGE_TEXT[CHANGE_TEXT_LEN as usize] = 9 as i8
                CHANGE_TEXT_LEN = CHANGE_TEXT_LEN + 1
                i = i + 2
            } else if n == 34 {
                CHANGE_TEXT[CHANGE_TEXT_LEN as usize] = 34 as i8
                CHANGE_TEXT_LEN = CHANGE_TEXT_LEN + 1
                i = i + 2
            } else if n == 92 {
                CHANGE_TEXT[CHANGE_TEXT_LEN as usize] = 92 as i8
                CHANGE_TEXT_LEN = CHANGE_TEXT_LEN + 1
                i = i + 2
            } else if n == 47 {
                CHANGE_TEXT[CHANGE_TEXT_LEN as usize] = 47 as i8
                CHANGE_TEXT_LEN = CHANGE_TEXT_LEN + 1
                i = i + 2
            } else if n == 117 {
                if i + 5 >= RX_BODY_LEN { return i + 1 }
                var v: i64 = 0
                var k: i64 = 0
                while k < 4 {
                    let h = RX_BODY[(i + 2 + k) as usize] as i64
                    var d: i64 = 0
                    if h >= 48 && h <= 57 {
                        d = h - 48
                    } else if h >= 97 && h <= 102 {
                        d = h - 87
                    } else if h >= 65 && h <= 70 {
                        d = h - 55
                    }
                    v = v * 16 + d
                    k = k + 1
                }
                CHANGE_TEXT[CHANGE_TEXT_LEN as usize] = (v % 256) as i8
                CHANGE_TEXT_LEN = CHANGE_TEXT_LEN + 1
                i = i + 6
            } else {
                CHANGE_TEXT[CHANGE_TEXT_LEN as usize] = n as i8
                CHANGE_TEXT_LEN = CHANGE_TEXT_LEN + 1
                i = i + 2
            }
        } else {
            CHANGE_TEXT[CHANGE_TEXT_LEN as usize] = c as i8
            CHANGE_TEXT_LEN = CHANGE_TEXT_LEN + 1
            i = i + 1
        }
    }
    return i
}

// Parse the range object whose "range" key is at rpos. Fills
// CH_SL/CH_SC/CH_EL/CH_EC. Returns true on success.
fn parse_change_range(rpos: i64) -> bool with Mut, Panic, Div {
    let lp1 = body_find("\"line\"", rpos)
    if lp1 < 0 { return false }
    let cp1 = body_find("\"character\"", lp1)
    if cp1 < 0 { return false }
    let lp2 = body_find("\"line\"", cp1 + 11)
    if lp2 < 0 { return false }
    let cp2 = body_find("\"character\"", lp2)
    if cp2 < 0 { return false }
    CH_SL = body_read_int_after(lp1 + 6)
    CH_SC = body_read_int_after(cp1 + 11)
    CH_EL = body_read_int_after(lp2 + 6)
    CH_EC = body_read_int_after(cp2 + 11)
    if CH_SL < 0 || CH_SC < 0 || CH_EL < 0 || CH_EC < 0 { return false }
    return true
}

// Splice CHANGE_TEXT into DOC_TEXT replacing [soff, eoff). Returns false
// (leaving DOC_TEXT untouched) on out-of-range offsets or capacity
// overflow.
fn apply_change(soff: i64, eoff: i64) -> bool with Mut {
    if soff < 0 || eoff < soff || eoff > DOC_TEXT_LEN { return false }
    let delta = CHANGE_TEXT_LEN - (eoff - soff)
    let new_len = DOC_TEXT_LEN + delta
    if new_len < 0 || new_len > 262144 { return false }
    if delta > 0 {
        var i = DOC_TEXT_LEN - 1
        while i >= eoff {
            DOC_TEXT[(i + delta) as usize] = DOC_TEXT[i as usize]
            i = i - 1
        }
    } else if delta < 0 {
        var i = eoff
        while i < DOC_TEXT_LEN {
            DOC_TEXT[(i + delta) as usize] = DOC_TEXT[i as usize]
            i = i + 1
        }
    }
    var k: i64 = 0
    while k < CHANGE_TEXT_LEN {
        DOC_TEXT[(soff + k) as usize] = CHANGE_TEXT[k as usize]
        k = k + 1
    }
    DOC_TEXT_LEN = new_len
    return true
}

// textDocument/didChange under kind=2: apply contentChanges[] in order.
// Falls back to the full-sync handler when the payload carries no ranges
// or the document was never opened.
fn handle_did_change() with IO, Mut, Panic, Div {
    if extract_doc_uri() < 0 { return }
    let cc = body_find("\"contentChanges\"", 0)
    if cc < 0 {
        handle_did_open_or_change()
        return
    }
    let s = slot_find_by_uri()
    let r0 = body_find("\"range\"", cc)
    if s < 0 || r0 < 0 {
        handle_did_open_or_change()
        return
    }
    slot_activate(s)
    var p = cc
    var scanning: i64 = 1
    while scanning == 1 {
        let tpos = body_find("\"text\"", p)
        if tpos < 0 {
            scanning = 0
        } else {
            let rpos = body_find("\"range\"", p)
            if rpos >= 0 && rpos < tpos {
                if parse_change_range(rpos) == true {
                    let after = extract_change_text(tpos)
                    if after < 0 {
                        scanning = 0
                    } else {
                        let soff = sr_pos_to_offset(CH_SL, CH_SC)
                        let eoff = sr_pos_to_offset(CH_EL, CH_EC)
                        apply_change(soff, eoff)
                        p = after
                    }
                } else {
                    scanning = 0
                }
            } else {
                // Full-replacement change object (no "range" before its
                // "text" key).
                let after = extract_change_text(tpos)
                if after < 0 {
                    scanning = 0
                } else {
                    var k: i64 = 0
                    while k < CHANGE_TEXT_LEN {
                        DOC_TEXT[k as usize] = CHANGE_TEXT[k as usize]
                        k = k + 1
                    }
                    DOC_TEXT_LEN = CHANGE_TEXT_LEN
                    p = after
                }
            }
        }
    }
    slot_set_text(s)
    if write_doc_to_disk() == false { return }
    if run_souc_check() < 0 { return }
    slurp_diag_file()
    parse_diagnostics()
    publish_diagnostics()
}

// Pull document text + URI from current message, store in slot, run
// check, publish diagnostics.
fn handle_did_open_or_change() with IO, Mut, Panic, Div {
    let u = extract_doc_uri()
    let t = extract_doc_text()
    if u < 0 || t < 0 { return }

    // Store in the multi-document slot for this URI.
    var s = slot_find_by_uri()
    if s < 0 { s = slot_alloc_for_uri() }
    if s >= 0 { slot_set_text(s) }

    if write_doc_to_disk() == false { return }
    if run_souc_check() < 0 { return }
    slurp_diag_file()
    parse_diagnostics()
    publish_diagnostics()
}

// textDocument/didClose — release the slot so we don't keep stale
// state around. Operates on the URI in params.textDocument.uri.
fn handle_did_close() with IO, Mut, Panic, Div {
    if extract_doc_uri() < 0 { return }
    let s = slot_find_by_uri()
    if s >= 0 { slot_release(s) }
}

fn respond_initialize() with IO, Mut, Panic, Div {
    // Sprint-2 #7: remember params.rootUri so workspace/symbol can scan
    // *.sio files on disk in addition to open document slots.
    capture_root_uri()
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":{")
    tx_puts("\"capabilities\":{")
    tx_puts("\"textDocumentSync\":2,")
    tx_puts("\"hoverProvider\":true,")
    tx_puts("\"definitionProvider\":true,")
    tx_puts("\"referencesProvider\":true,")
    tx_puts("\"renameProvider\":{\"prepareProvider\":true},")
    tx_puts("\"documentSymbolProvider\":true,")
    tx_puts("\"documentHighlightProvider\":true,")
    tx_puts("\"documentFormattingProvider\":true,")
    tx_puts("\"documentRangeFormattingProvider\":true,")
    tx_puts("\"codeActionProvider\":{\"codeActionKinds\":[\"quickfix\",\"source.fixAll\",\"refactor.extract\"]},")
    tx_puts("\"semanticTokensProvider\":{")
    tx_puts("\"legend\":{")
    // Indices here must match the ST_TYPE_* constants used by the
    // tokenizer below.
    tx_puts("\"tokenTypes\":[\"keyword\",\"type\",\"variable\",\"function\",\"string\",\"number\",\"comment\",\"operator\"],")
    tx_puts("\"tokenModifiers\":[]")
    tx_puts("},")
    tx_puts("\"full\":{\"delta\":true},")
    tx_puts("\"range\":true")
    tx_puts("},")
    tx_puts("\"completionProvider\":{")
    tx_puts("\"triggerCharacters\":[\".\",\":\"]")
    tx_puts("},")
    tx_puts("\"signatureHelpProvider\":{")
    tx_puts("\"triggerCharacters\":[\"(\",\",\"]")
    tx_puts("},")
    tx_puts("\"foldingRangeProvider\":true,")
    tx_puts("\"workspaceSymbolProvider\":true,")
    tx_puts("\"selectionRangeProvider\":true,")
    tx_puts("\"inlayHintProvider\":{\"resolveProvider\":true},")
    tx_puts("\"linkedEditingRangeProvider\":true,")
    tx_puts("\"declarationProvider\":true,")
    tx_puts("\"typeDefinitionProvider\":true,")
    tx_puts("\"implementationProvider\":true,")
    tx_puts("\"callHierarchyProvider\":true,")
    tx_puts("\"typeHierarchyProvider\":true,")
    tx_puts("\"documentLinkProvider\":{\"resolveProvider\":false},")
    tx_puts("\"documentOnTypeFormattingProvider\":{\"firstTriggerCharacter\":\"\\n\",\"moreTriggerCharacter\":[\"}\"]},")
    tx_puts("\"diagnosticProvider\":{\"interFileDependencies\":false,\"workspaceDiagnostics\":false},")
    tx_puts("\"codeLensProvider\":{\"resolveProvider\":false},")
    tx_puts("\"executeCommandProvider\":{\"commands\":[\"sounio.run\",\"sounio.check\"]},")
    tx_puts("\"workspace\":{")
    tx_puts("\"workspaceFolders\":{\"supported\":true,\"changeNotifications\":true},")
    tx_puts("\"fileOperations\":{")
    tx_puts("\"willRename\":{\"filters\":[")
    tx_puts("{\"pattern\":{\"glob\":\"**/*.sio\",\"matches\":\"file\"}}")
    tx_puts("]}}}")
    tx_puts("},")
    tx_puts("\"serverInfo\":{")
    tx_puts("\"name\":\"sounio-lsp\",")
    tx_puts("\"version\":\"0.3.0\"")
    tx_puts("}")
    tx_puts("}}")
    write_frame()
}

fn respond_shutdown() with IO, Mut, Panic, Div {
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":null}")
    write_frame()
}

fn respond_method_not_found() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }   // notification → no response
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"error\":{\"code\":-32601,\"message\":\"Method not implemented yet (W2 skeleton)\"}}")
    write_frame()
}

fn respond_empty_result() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":null}")
    write_frame()
}

// ============================================================================
// Dispatch
// ============================================================================

fn dispatch(method: i64) with IO, Mut, Panic, Div {
    if method == M_INITIALIZE  { respond_initialize();   return }
    if method == M_INITIALIZED { return }                              // notification
    if method == M_SHUTDOWN    { SAW_SHUTDOWN = 1; respond_shutdown(); return }
    if method == M_EXIT        { return }                              // handled in main loop
    if method == M_DID_OPEN    { handle_did_open_or_change(); return }
    if method == M_DID_CHANGE  { handle_did_change(); return }
    if method == M_DID_CLOSE   { handle_did_close(); return }
    if method == M_DID_SAVE    { return }
    if method == M_HOVER       { respond_hover();             return }
    if method == M_COMPLETION  { respond_completion();        return }
    if method == M_DEFINITION  { respond_definition();        return }
    if method == M_REFERENCES  { respond_references();        return }
    if method == M_RENAME      { respond_rename();            return }
    if method == M_CODE_ACTION { respond_code_action();       return }
    if method == M_SEM_TOKENS  { respond_semantic_tokens();   return }
    if method == M_SEM_TOKENS_DELTA { respond_semantic_tokens_delta(); return }
    if method == M_PREPARE_TYPE_HIERARCHY { respond_prepare_type_hierarchy(); return }
    if method == M_TYPE_H_SUPERTYPES { respond_type_hierarchy_supertypes(); return }
    if method == M_TYPE_H_SUBTYPES { respond_type_hierarchy_subtypes(); return }
    if method == M_SEM_TOKENS_RANGE { respond_semantic_tokens_range(); return }
    if method == M_FORMATTING  { respond_formatting();        return }
    if method == M_DOC_SYMBOL  { respond_document_symbol();   return }
    if method == M_DOC_HIGHLIGHT { respond_document_highlight(); return }
    if method == M_PREPARE_RENAME { respond_prepare_rename(); return }
    if method == M_SIGNATURE_HELP { respond_signature_help(); return }
    if method == M_FOLDING_RANGE  { respond_folding_range(); return }
    if method == M_WORKSPACE_SYMBOL { respond_workspace_symbol(); return }
    if method == M_SELECTION_RANGE  { respond_selection_range(); return }
    if method == M_INLAY_HINT       { respond_inlay_hint(); return }
    if method == M_DECLARATION      { respond_definition(); return }
    if method == M_TYPE_DEFINITION  { respond_definition(); return }
    if method == M_IMPLEMENTATION   { respond_definition(); return }
    if method == M_PREPARE_CALL_HIERARCHY { respond_prepare_call_hierarchy(); return }
    if method == M_INCOMING_CALLS   { respond_incoming_calls(); return }
    if method == M_OUTGOING_CALLS   { respond_outgoing_calls(); return }
    if method == M_DOCUMENT_LINK    { respond_document_link(); return }
    if method == M_ON_TYPE_FORMATTING { respond_on_type_formatting(); return }
    if method == M_RANGE_FORMATTING { respond_range_formatting(); return }
    // Notifications-only: silently consume. Cancel never has an id;
    // didChange* notifications do not request a response. The server
    // does not run async work today so $/cancelRequest is a no-op.
    if method == M_CANCEL_REQUEST { return }
    if method == M_DID_CHANGE_WATCHED_FILES { return }
    if method == M_DID_CHANGE_WORKSPACE_FOLDERS { return }
    if method == M_DID_CHANGE_CONFIGURATION { return }
    if method == M_CODE_LENS { respond_code_lens(); return }
    if method == M_EXECUTE_COMMAND { respond_execute_command(); return }
    if method == M_WILL_RENAME_FILES { respond_will_rename_stub(); return }
    if method == M_PULL_DIAGNOSTIC { respond_pull_diagnostic(); return }
    if method == M_LINKED_EDITING { respond_linked_editing_range(); return }
    if method == M_INLAY_HINT_RESOLVE { respond_inlay_hint_resolve(); return }
    respond_method_not_found()
}

// ============================================================================
// Main loop
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    log_stderr_nl("lsp start")
    var running: i64 = 1
    while running == 1 {
        let cl = read_headers()
        if cl <= 0 { running = 0 }
        else if cl > 262144 {
            log_stderr_nl("body too large")
            running = 0
        } else {
            let got = read_body(cl)
            if got < cl {
                running = 0
            } else {
                capture_id()
                let m = classify_method()
                dispatch(m)
                if m == M_EXIT { running = 0 }
            }
        }
    }
    log_stderr_nl("lsp stop")
    if SAW_SHUTDOWN == 1 { return 0 }
    return 1
}
