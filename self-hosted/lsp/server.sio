// self-hosted::lsp::server — Sounio Language Server (stdio JSON-RPC)
//
// Pure-Sounio LSP entry point. Speaks LSP over stdin/stdout with
// Content-Length framing. Reads request envelopes, dispatches by method,
// emits framed responses.
//
// W2 surface (this file, minimal):
//   - initialize / initialized
//   - shutdown / exit
//   - textDocument/didOpen, didChange, didClose (no-op, acknowledge)
//   - any other method → error -32601 (MethodNotFound)
//
// Future modules will plug in:
//   - diagnostics via api.check_source → self-hosted/lsp/diagnostics.sio
//   - hover     via api.inspect_at   → self-hosted/lsp/hover.sio
//   - etc.
//
// Build: souc compile self-hosted/lsp/server.sio -o bin/sounio-lsp
// Wire as `souc lsp` subcommand in lean_single.sio dispatcher (later).

// ============================================================================
// Buffers — fixed-size BSS, no heap
// ============================================================================

// Incoming JSON-RPC body (LSP spec recommends ≤ 1 MB; 256 KB plenty for v0)
var RX_BODY: [i8; 262144] = [0; 262144]
var RX_BODY_LEN: i64 = 0

// One-byte scratch for byte-at-a-time stdin reads — used by line reader so
// we never over-read past the header terminator into the body
var RX_ONE: [i8; 1] = [0; 1]

// Header line buffer (RFC 4180-ish, but LSP headers stay short)
var RX_LINE: [i8; 1024] = [0; 1024]
var RX_LINE_LEN: i64 = 0

// Outgoing response body
var TX_BODY: [i8; 262144] = [0; 262144]
var TX_BODY_LEN: i64 = 0

// Header scratch (Content-Length: NNNNN\r\n\r\n)
var TX_HEAD: [i8; 64] = [0; 64]
var TX_HEAD_LEN: i64 = 0

// Last seen request id (echoed in responses)
var LAST_ID_NUM: i64 = 0       // numeric id, if any
var LAST_ID_IS_STR: i64 = 0    // 1 if id was a string
var LAST_ID_STR: [i8; 64] = [0; 64]
var LAST_ID_STR_LEN: i64 = 0
var LAST_ID_PRESENT: i64 = 0

// Method classification
let M_UNKNOWN:       i64 = 0
let M_INITIALIZE:    i64 = 1
let M_INITIALIZED:   i64 = 2
let M_SHUTDOWN:      i64 = 3
let M_EXIT:          i64 = 4
let M_DID_OPEN:      i64 = 10
let M_DID_CHANGE:    i64 = 11
let M_DID_CLOSE:     i64 = 12
let M_DID_SAVE:      i64 = 13
let M_HOVER:         i64 = 20
let M_COMPLETION:    i64 = 21
let M_DEFINITION:    i64 = 22
let M_REFERENCES:    i64 = 23
let M_RENAME:        i64 = 24
let M_CODE_ACTION:   i64 = 25
let M_SEM_TOKENS:    i64 = 26
let M_FORMATTING:    i64 = 27

// Shutdown state machine — LSP requires shutdown before exit
var SAW_SHUTDOWN: i64 = 0

// ============================================================================
// Diagnostics state
// ============================================================================

// argv / envp for fork+execve of `souc <src> <out>`. Static slots — only one
// check at a time per server (single-threaded).
var ARGV: [i64; 4] = [0; 4]
var ENVP: [i64; 1] = [0; 1]

// Document text (extracted from JSON), written to disk before checking.
var DOC_TEXT: [i8; 262144] = [0; 262144]
var DOC_TEXT_LEN: i64 = 0

// Last URI seen (echoed in publishDiagnostics)
var DOC_URI: [i8; 1024] = [0; 1024]
var DOC_URI_LEN: i64 = 0

// Compiler stderr capture (read back after fork+exec)
var DIAG_RAW: [i8; 65536] = [0; 65536]
var DIAG_RAW_LEN: i64 = 0

// Parsed diagnostics: parallel arrays, fixed 64 max
let DIAG_MAX: i64 = 64
var DIAG_LINE:   [i64; 64] = [0; 64]
var DIAG_MSG_OFF: [i64; 64] = [0; 64]  // byte offsets into DIAG_MSG_BUF
var DIAG_MSG_LEN: [i64; 64] = [0; 64]
var DIAG_MSG_BUF: [i8; 16384] = [0; 16384]
var DIAG_MSG_BUF_LEN: i64 = 0
var DIAG_COUNT: i64 = 0

// Paths used by the check pipeline. Single fixed path is fine for v0
// (server is single-threaded). NOTE: Sounio's `let X: string = "..."`
// does not currently produce a pointer that survives the `as i64` cast
// or being passed to builtins, so we inline the literals at each use
// site below.

// ============================================================================
// Low-level I/O — syscall6 wrappers
// ============================================================================

// write(fd=2 stderr, str, len) — log helper
fn log_stderr(msg: string) with IO, Mut, Panic {
    let n = str_len(msg)
    syscall6(1, 2, msg, n, 0, 0, 0)
}

fn log_stderr_nl(msg: string) with IO, Mut, Panic {
    log_stderr(msg)
    syscall6(1, 2, "\n", 1, 0, 0, 0)
}

// ============================================================================
// Header parsing — read "Content-Length: N\r\n\r\n", return N
// ============================================================================

// Read one CRLF-terminated header line into RX_LINE. Strips the CRLF (or LF
// alone). Returns line length (0 = empty line / end of headers, -1 = EOF).
fn read_header_line() -> i64 with IO, Mut, Panic {
    RX_LINE_LEN = 0
    var saw_any: i64 = 0
    var done: i64 = 0
    while done == 0 {
        let r = syscall6(0, 0, &! RX_ONE, 1, 0, 0, 0)
        if r <= 0 {
            if saw_any == 0 { return 0 - 1 }
            done = 1
        } else {
            saw_any = 1
            let b = RX_ONE[0] as i64
            if b == 10 { done = 1 }
            else if RX_LINE_LEN < 1024 {
                RX_LINE[RX_LINE_LEN as usize] = b as i8
                RX_LINE_LEN = RX_LINE_LEN + 1
            }
        }
    }
    // Strip trailing CR if present
    if RX_LINE_LEN > 0 && (RX_LINE[(RX_LINE_LEN - 1) as usize] as i64) == 13 {
        RX_LINE_LEN = RX_LINE_LEN - 1
    }
    return RX_LINE_LEN
}

// Compare a prefix of RX_LINE against an ASCII literal, case-insensitive.
fn line_starts_with_ci(prefix: string) -> bool with Mut, Panic {
    let np = str_len(prefix)
    if RX_LINE_LEN < np { return false }
    var i: i64 = 0
    while i < np {
        let a = to_lower(RX_LINE[i as usize] as i64)
        let b = to_lower(str_char_at(prefix, i))
        if a != b { return false }
        i = i + 1
    }
    return true
}

// Parse a non-negative decimal i64 from RX_LINE starting at `off`. Returns -1
// if no digits found.
fn line_parse_i64_after(off: i64) -> i64 with Mut, Panic, Div {
    var i = off
    while i < RX_LINE_LEN {
        let c = RX_LINE[i as usize] as i64
        if c != 32 && c != 9 { break }
        i = i + 1
    }
    var val: i64 = 0
    var any: i64 = 0
    while i < RX_LINE_LEN {
        let c = RX_LINE[i as usize] as i64
        if c < 48 || c > 57 { break }
        val = val * 10 + (c - 48)
        any = 1
        i = i + 1
    }
    if any == 0 { return 0 - 1 }
    return val
}

// Returns content length, or -1 on EOF/error
fn read_headers() -> i64 with IO, Mut, Panic, Div {
    var content_length: i64 = 0 - 1
    var done: i64 = 0
    while done == 0 {
        let n = read_header_line()
        if n < 0 { return 0 - 1 }
        if n == 0 { done = 1 }
        else if line_starts_with_ci("Content-Length:") {
            content_length = line_parse_i64_after(15)
        }
    }
    return content_length
}

// Read `n` bytes from stdin into RX_BODY. Byte-at-a-time so partial reads
// don't overwrite earlier bytes (no pointer arithmetic in v0 Sounio).
fn read_body(n: i64) -> i64 with IO, Mut, Panic, Div {
    var got: i64 = 0
    while got < n {
        let r = syscall6(0, 0, &! RX_ONE, 1, 0, 0, 0)
        if r <= 0 { RX_BODY_LEN = got; return got }
        if got < 262144 {
            RX_BODY[got as usize] = RX_ONE[0]
        }
        got = got + 1
    }
    RX_BODY_LEN = got
    return got
}

// ============================================================================
// Tiny string utils — case-insensitive prefix + integer parse from offset
// ============================================================================

fn to_lower(b: i64) -> i64 {
    if b >= 65 && b <= 90 { b + 32 } else { b }
}

fn starts_with_ci(s: string, prefix: string) -> bool with Mut, Panic {
    let ns = str_len(s)
    let np = str_len(prefix)
    if ns < np { return false }
    var i: i64 = 0
    while i < np {
        if to_lower(str_char_at(s, i)) != to_lower(str_char_at(prefix, i)) {
            return false
        }
        i = i + 1
    }
    true
}

fn parse_i64_after(s: string, off: i64) -> i64 with Mut, Panic, Div {
    let n = str_len(s)
    var i = off
    // skip whitespace
    while i < n {
        let c = str_char_at(s, i)
        if c != 32 && c != 9 { break }
        i = i + 1
    }
    var val: i64 = 0
    var any: i64 = 0
    while i < n {
        let c = str_char_at(s, i)
        if c < 48 || c > 57 { break }
        val = val * 10 + (c - 48)
        any = 1
        i = i + 1
    }
    if any == 0 { return 0 - 1 }
    return val
}

// ============================================================================
// Method classification — substring scan of the request body
// ============================================================================
//
// LSP request envelopes look like:
//   {"jsonrpc":"2.0","id":42,"method":"initialize","params":{...}}
//
// We don't need a real JSON parser for v0 — we just look for:
//   "method":"<name>"
//   "id":<num>  or  "id":"<str>"
//
// This is unsafe against escaped quotes inside string values, but
// LSP method names are well-known ASCII and the id is always early
// in the envelope. Promote to a proper parser when we wire features.

fn body_find(needle: string, start: i64) -> i64 with Mut, Panic {
    let bn = RX_BODY_LEN
    let nl = str_len(needle)
    if nl == 0 { return 0 - 1 }
    var i = start
    while i + nl <= bn {
        var k: i64 = 0
        var ok: i64 = 1
        while k < nl {
            let bb = RX_BODY[(i + k) as usize] as i64
            let nb = str_char_at(needle, k)
            if bb != nb { ok = 0; k = nl; }
            else { k = k + 1 }
        }
        if ok == 1 { return i }
        i = i + 1
    }
    0 - 1
}

// Extract the string value following the first occurrence of key in the body.
// Writes the value bytes into `out` (max `cap` bytes), returns length, or -1.
fn body_extract_str(key: string, out: &![i8; 64], cap: i64) -> i64 with Mut, Panic {
    let pos = body_find(key, 0)
    if pos < 0 { return 0 - 1 }
    // After the key we expect: optional ws, ':', ws, '"', value, '"'
    var i = pos + str_len(key)
    while i < RX_BODY_LEN {
        let c = RX_BODY[i as usize] as i64
        if c == 34 { i = i + 1; break }       // opening quote
        i = i + 1
    }
    var n: i64 = 0
    while i < RX_BODY_LEN && n < cap {
        let c = RX_BODY[i as usize] as i64
        if c == 34 { return n }                // closing quote
        if c == 92 {                           // escape — skip pair
            i = i + 2
            continue
        }
        out[n as usize] = c as i8
        n = n + 1
        i = i + 1
    }
    n
}

fn classify_method() -> i64 with Mut, Panic {
    var name: [i8; 64] = [0; 64]
    let nlen = body_extract_str("\"method\"", &! name, 64)
    if nlen <= 0 { return M_UNKNOWN }
    let s = str_from_bytes(name, nlen)
    if str_eq(s, "initialize")                      { return M_INITIALIZE  }
    if str_eq(s, "initialized")                     { return M_INITIALIZED }
    if str_eq(s, "shutdown")                        { return M_SHUTDOWN    }
    if str_eq(s, "exit")                            { return M_EXIT        }
    if str_eq(s, "textDocument/didOpen")            { return M_DID_OPEN    }
    if str_eq(s, "textDocument/didChange")          { return M_DID_CHANGE  }
    if str_eq(s, "textDocument/didClose")           { return M_DID_CLOSE   }
    if str_eq(s, "textDocument/didSave")            { return M_DID_SAVE    }
    if str_eq(s, "textDocument/hover")              { return M_HOVER       }
    if str_eq(s, "textDocument/completion")         { return M_COMPLETION  }
    if str_eq(s, "textDocument/definition")         { return M_DEFINITION  }
    if str_eq(s, "textDocument/references")         { return M_REFERENCES  }
    if str_eq(s, "textDocument/rename")             { return M_RENAME      }
    if str_eq(s, "textDocument/codeAction")         { return M_CODE_ACTION }
    if str_eq(s, "textDocument/semanticTokens/full") { return M_SEM_TOKENS }
    if str_eq(s, "textDocument/formatting")         { return M_FORMATTING  }
    M_UNKNOWN
}

// Capture the id (numeric or string). Stored in LAST_ID_* globals.
fn capture_id() with Mut, Panic, Div {
    LAST_ID_PRESENT = 0
    LAST_ID_IS_STR = 0
    LAST_ID_NUM = 0
    LAST_ID_STR_LEN = 0
    let pos = body_find("\"id\"", 0)
    if pos < 0 { return }
    var i = pos + 4
    // skip ws + ':'
    while i < RX_BODY_LEN {
        let c = RX_BODY[i as usize] as i64
        if c == 58 { i = i + 1; break }
        i = i + 1
    }
    while i < RX_BODY_LEN {
        let c = RX_BODY[i as usize] as i64
        if c != 32 && c != 9 { break }
        i = i + 1
    }
    if i >= RX_BODY_LEN { return }
    let first = RX_BODY[i as usize] as i64
    if first == 34 {
        // string id
        LAST_ID_IS_STR = 1
        LAST_ID_PRESENT = 1
        i = i + 1
        var n: i64 = 0
        while i < RX_BODY_LEN && n < 64 {
            let c = RX_BODY[i as usize] as i64
            if c == 34 { break }
            LAST_ID_STR[n as usize] = c as i8
            n = n + 1
            i = i + 1
        }
        LAST_ID_STR_LEN = n
    } else if first >= 48 && first <= 57 {
        LAST_ID_IS_STR = 0
        LAST_ID_PRESENT = 1
        var v: i64 = 0
        while i < RX_BODY_LEN {
            let c = RX_BODY[i as usize] as i64
            if c < 48 || c > 57 { break }
            v = v * 10 + (c - 48)
            i = i + 1
        }
        LAST_ID_NUM = v
    }
}

// ============================================================================
// TX_BODY builder helpers
// ============================================================================

fn tx_reset() with Mut { TX_BODY_LEN = 0 }

fn tx_putc(b: i64) with Mut, Panic {
    if TX_BODY_LEN < 262144 {
        TX_BODY[TX_BODY_LEN as usize] = b as i8
        TX_BODY_LEN = TX_BODY_LEN + 1
    }
}

fn tx_puts(s: string) with Mut, Panic {
    let n = str_len(s)
    var i: i64 = 0
    while i < n { tx_putc(str_char_at(s, i)); i = i + 1 }
}

fn tx_put_i64(v: i64) with Mut, Panic, Div {
    if v == 0 { tx_putc(48); return }
    var n = v
    var neg: i64 = 0
    if n < 0 { neg = 1; n = 0 - n }
    var rev: [i8; 24] = [0; 24]
    var rl: i64 = 0
    while n > 0 {
        rev[rl as usize] = (48 + n % 10) as i8
        rl = rl + 1
        n = n / 10
    }
    if neg == 1 { tx_putc(45) }
    var i = rl - 1
    while i >= 0 {
        tx_putc(rev[i as usize] as i64)
        if i == 0 { break }
        i = i - 1
    }
}

// Emit "id":<id> using the captured id. Skips emission if no id was present.
fn tx_emit_id() with Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    tx_puts("\"id\":")
    if LAST_ID_IS_STR == 1 {
        tx_putc(34)
        var i: i64 = 0
        while i < LAST_ID_STR_LEN {
            tx_putc(LAST_ID_STR[i as usize] as i64)
            i = i + 1
        }
        tx_putc(34)
    } else {
        tx_put_i64(LAST_ID_NUM)
    }
}

// ============================================================================
// Frame writer — emit Content-Length header + body to stdout
// ============================================================================

fn write_frame() with IO, Mut, Panic, Div {
    // Header: "Content-Length: N\r\n\r\n"
    TX_HEAD_LEN = 0
    let h = "Content-Length: "
    let hn = str_len(h)
    var i: i64 = 0
    while i < hn {
        TX_HEAD[TX_HEAD_LEN as usize] = str_char_at(h, i) as i8
        TX_HEAD_LEN = TX_HEAD_LEN + 1
        i = i + 1
    }
    // length digits
    var n = TX_BODY_LEN
    if n == 0 {
        TX_HEAD[TX_HEAD_LEN as usize] = 48 as i8
        TX_HEAD_LEN = TX_HEAD_LEN + 1
    } else {
        var rev: [i8; 24] = [0; 24]
        var rl: i64 = 0
        while n > 0 {
            rev[rl as usize] = (48 + n % 10) as i8
            rl = rl + 1
            n = n / 10
        }
        var j = rl - 1
        while j >= 0 {
            TX_HEAD[TX_HEAD_LEN as usize] = rev[j as usize]
            TX_HEAD_LEN = TX_HEAD_LEN + 1
            if j == 0 { break }
            j = j - 1
        }
    }
    TX_HEAD[TX_HEAD_LEN as usize] = 13 as i8; TX_HEAD_LEN = TX_HEAD_LEN + 1
    TX_HEAD[TX_HEAD_LEN as usize] = 10 as i8; TX_HEAD_LEN = TX_HEAD_LEN + 1
    TX_HEAD[TX_HEAD_LEN as usize] = 13 as i8; TX_HEAD_LEN = TX_HEAD_LEN + 1
    TX_HEAD[TX_HEAD_LEN as usize] = 10 as i8; TX_HEAD_LEN = TX_HEAD_LEN + 1

    // Write header then body to stdout (fd=1)
    syscall6(1, 1, &! TX_HEAD, TX_HEAD_LEN, 0, 0, 0)
    syscall6(1, 1, &! TX_BODY, TX_BODY_LEN, 0, 0, 0)
}

// ============================================================================
// Response builders
// ============================================================================

// ============================================================================
// Diagnostics pipeline
// ============================================================================

// Extract the body field (textDocument.text or contentChanges[0].text) into
// DOC_TEXT. Decodes the common JSON string escapes we care about (\n, \r,
// \t, \", \\, \uXXXX for the ASCII subset). Returns DOC_TEXT_LEN, or -1 if
// no text field is found.
fn extract_doc_text() -> i64 with Mut, Panic, Div {
    DOC_TEXT_LEN = 0
    let pos = body_find("\"text\"", 0)
    if pos < 0 { return 0 - 1 }
    var i = pos + 6
    // skip ws + ':' + ws + '"'
    var saw_quote: i64 = 0
    while i < RX_BODY_LEN && saw_quote == 0 {
        let c = RX_BODY[i as usize] as i64
        if c == 34 { saw_quote = 1 }
        i = i + 1
    }
    if saw_quote == 0 { return 0 - 1 }
    while i < RX_BODY_LEN && DOC_TEXT_LEN < 262144 {
        let c = RX_BODY[i as usize] as i64
        if c == 34 { return DOC_TEXT_LEN }
        if c == 92 && i + 1 < RX_BODY_LEN {
            let n = RX_BODY[(i + 1) as usize] as i64
            if n == 110     { DOC_TEXT[DOC_TEXT_LEN as usize] = 10 as i8; DOC_TEXT_LEN = DOC_TEXT_LEN + 1; i = i + 2 }
            else if n == 114 { DOC_TEXT[DOC_TEXT_LEN as usize] = 13 as i8; DOC_TEXT_LEN = DOC_TEXT_LEN + 1; i = i + 2 }
            else if n == 116 { DOC_TEXT[DOC_TEXT_LEN as usize] = 9  as i8; DOC_TEXT_LEN = DOC_TEXT_LEN + 1; i = i + 2 }
            else if n == 34  { DOC_TEXT[DOC_TEXT_LEN as usize] = 34 as i8; DOC_TEXT_LEN = DOC_TEXT_LEN + 1; i = i + 2 }
            else if n == 92  { DOC_TEXT[DOC_TEXT_LEN as usize] = 92 as i8; DOC_TEXT_LEN = DOC_TEXT_LEN + 1; i = i + 2 }
            else if n == 47  { DOC_TEXT[DOC_TEXT_LEN as usize] = 47 as i8; DOC_TEXT_LEN = DOC_TEXT_LEN + 1; i = i + 2 }
            else if n == 117 {
                // \uXXXX — decode 4 hex digits, drop high byte for v0
                if i + 5 >= RX_BODY_LEN { return DOC_TEXT_LEN }
                var v: i64 = 0
                var k: i64 = 0
                while k < 4 {
                    let h = RX_BODY[(i + 2 + k) as usize] as i64
                    var d: i64 = 0
                    if h >= 48 && h <= 57 { d = h - 48 }
                    else if h >= 97 && h <= 102 { d = h - 87 }
                    else if h >= 65 && h <= 70 { d = h - 55 }
                    v = v * 16 + d
                    k = k + 1
                }
                DOC_TEXT[DOC_TEXT_LEN as usize] = (v % 256) as i8
                DOC_TEXT_LEN = DOC_TEXT_LEN + 1
                i = i + 6
            } else {
                DOC_TEXT[DOC_TEXT_LEN as usize] = n as i8
                DOC_TEXT_LEN = DOC_TEXT_LEN + 1
                i = i + 2
            }
        } else {
            DOC_TEXT[DOC_TEXT_LEN as usize] = c as i8
            DOC_TEXT_LEN = DOC_TEXT_LEN + 1
            i = i + 1
        }
    }
    return DOC_TEXT_LEN
}

// Extract the document URI ("uri": "...") into DOC_URI. Returns length, -1
// if missing.
fn extract_doc_uri() -> i64 with Mut, Panic {
    DOC_URI_LEN = 0
    let pos = body_find("\"uri\"", 0)
    if pos < 0 { return 0 - 1 }
    var i = pos + 5
    var saw_quote: i64 = 0
    while i < RX_BODY_LEN && saw_quote == 0 {
        let c = RX_BODY[i as usize] as i64
        if c == 34 { saw_quote = 1 }
        i = i + 1
    }
    if saw_quote == 0 { return 0 - 1 }
    while i < RX_BODY_LEN && DOC_URI_LEN < 1024 {
        let c = RX_BODY[i as usize] as i64
        if c == 34 { return DOC_URI_LEN }
        if c == 92 && i + 1 < RX_BODY_LEN {
            // crude escape skip — URIs almost never contain escapes in practice
            i = i + 2
        } else {
            DOC_URI[DOC_URI_LEN as usize] = c as i8
            DOC_URI_LEN = DOC_URI_LEN + 1
            i = i + 1
        }
    }
    return DOC_URI_LEN
}

// fork + execve souc on TMP_DOC_PATH; stderr+stdout → TMP_ERR_PATH. Blocks
// in wait4. Returns 0 on success, -1 on fork failure.
fn run_souc_check() -> i64 with IO, Mut, Panic {
    ARGV[0] = "./bin/souc-linux-x86_64" as i64
    ARGV[1] = "/tmp/sounio_lsp_doc.sio" as i64
    ARGV[2] = "/tmp/sounio_lsp_out.elf" as i64
    ARGV[3] = 0
    ENVP[0] = 0

    let pid = syscall6(57, 0, 0, 0, 0, 0, 0)
    if pid < 0 { return 0 - 1 }
    if pid == 0 {
        // child: redirect stderr+stdout to err file, exec
        let fd = syscall6(2, "/tmp/sounio_lsp_err.txt", 577, 420, 0, 0, 0)
        if fd >= 0 {
            syscall6(33, fd, 1, 0, 0, 0, 0)
            syscall6(33, fd, 2, 0, 0, 0, 0)
            syscall6(3, fd, 0, 0, 0, 0, 0)
        }
        syscall6(59, "./bin/souc-linux-x86_64" as i64, &! ARGV, &! ENVP, 0, 0, 0)
        syscall6(60, 127, 0, 0, 0, 0, 0)
    }
    syscall6(61, pid, 0, 0, 0, 0, 0)
    return 0
}

// Read the stderr file into DIAG_RAW. Returns bytes read.
fn slurp_diag_file() -> i64 with IO, Mut, Panic {
    DIAG_RAW_LEN = 0
    let fd = syscall6(2, "/tmp/sounio_lsp_err.txt", 0, 0, 0, 0, 0)  // O_RDONLY
    if fd < 0 { return 0 }
    var got: i64 = 0
    var done: i64 = 0
    while done == 0 {
        let r = syscall6(0, fd, &! RX_ONE, 1, 0, 0, 0)
        if r <= 0 { done = 1 }
        else if got >= 65536 { done = 1 }
        else {
            DIAG_RAW[got as usize] = RX_ONE[0]
            got = got + 1
        }
    }
    syscall6(3, fd, 0, 0, 0, 0, 0)
    DIAG_RAW_LEN = got
    return got
}

// Scan DIAG_RAW for lines matching `error: <message> at line <N>` and
// populate DIAG_LINE / DIAG_MSG_OFF / DIAG_MSG_LEN. Resets DIAG_COUNT.
fn parse_diagnostics() with Mut, Panic, Div {
    DIAG_COUNT = 0
    DIAG_MSG_BUF_LEN = 0
    let prefix = "error: "
    let plen = str_len(prefix)
    var i: i64 = 0
    while i < DIAG_RAW_LEN && DIAG_COUNT < DIAG_MAX {
        // Match prefix at start of a line
        var at_bol: bool = false
        if i == 0 { at_bol = true }
        else if (DIAG_RAW[(i - 1) as usize] as i64) == 10 { at_bol = true }
        if at_bol == true && i + plen <= DIAG_RAW_LEN {
            var k: i64 = 0
            var match_ok: i64 = 1
            while k < plen {
                if (DIAG_RAW[(i + k) as usize] as i64) != str_char_at(prefix, k) {
                    match_ok = 0
                    k = plen
                } else { k = k + 1 }
            }
            if match_ok == 1 {
                // Capture message up to "at line N" or EOL
                let msg_start = i + plen
                var j = msg_start
                while j < DIAG_RAW_LEN && (DIAG_RAW[j as usize] as i64) != 10 { j = j + 1 }
                let eol = j
                // Try to find " at line " inside [msg_start, eol)
                let at_pat = " at line "
                let alen = str_len(at_pat)
                var line_no: i64 = 0
                var msg_end = eol
                var ai = msg_start
                while ai + alen <= eol {
                    var m: i64 = 1
                    var aj: i64 = 0
                    while aj < alen {
                        if (DIAG_RAW[(ai + aj) as usize] as i64) != str_char_at(at_pat, aj) {
                            m = 0
                            aj = alen
                        } else { aj = aj + 1 }
                    }
                    if m == 1 {
                        msg_end = ai
                        var nx = ai + alen
                        while nx < eol {
                            let c = DIAG_RAW[nx as usize] as i64
                            if c < 48 || c > 57 { nx = eol }
                            else { line_no = line_no * 10 + (c - 48); nx = nx + 1 }
                        }
                        ai = eol
                    } else { ai = ai + 1 }
                }
                // Convert souc 1-based line to LSP 0-based
                let lsp_line = if line_no > 0 { line_no - 1 } else { 0 }
                let msg_len = msg_end - msg_start
                if msg_len > 0 && DIAG_MSG_BUF_LEN + msg_len <= 16384 {
                    var mi: i64 = 0
                    while mi < msg_len {
                        DIAG_MSG_BUF[(DIAG_MSG_BUF_LEN + mi) as usize] = DIAG_RAW[(msg_start + mi) as usize]
                        mi = mi + 1
                    }
                    DIAG_LINE[DIAG_COUNT as usize] = lsp_line
                    DIAG_MSG_OFF[DIAG_COUNT as usize] = DIAG_MSG_BUF_LEN
                    DIAG_MSG_LEN[DIAG_COUNT as usize] = msg_len
                    DIAG_MSG_BUF_LEN = DIAG_MSG_BUF_LEN + msg_len
                    DIAG_COUNT = DIAG_COUNT + 1
                }
                i = eol
            }
        }
        i = i + 1
    }
}

// Write DOC_TEXT to TMP_DOC_PATH using write_file. Returns true on success.
fn write_doc_to_disk() -> bool with IO, Mut, Panic {
    let r = write_file("/tmp/sounio_lsp_doc.sio", &! DOC_TEXT, DOC_TEXT_LEN)
    return r >= 0
}

// Build and send a textDocument/publishDiagnostics notification.
fn publish_diagnostics() with IO, Mut, Panic, Div {
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{")
    tx_puts("\"uri\":\"")
    var i: i64 = 0
    while i < DOC_URI_LEN {
        let c = DOC_URI[i as usize] as i64
        if c == 34 { tx_putc(92); tx_putc(34) }
        else if c == 92 { tx_putc(92); tx_putc(92) }
        else { tx_putc(c) }
        i = i + 1
    }
    tx_puts("\",\"diagnostics\":[")
    var d: i64 = 0
    while d < DIAG_COUNT {
        if d > 0 { tx_putc(44) }
        let ln = DIAG_LINE[d as usize]
        tx_puts("{\"severity\":1,\"source\":\"sounio:type\",\"code\":\"E001\",\"range\":{\"start\":{\"line\":")
        tx_put_i64(ln)
        tx_puts(",\"character\":0},\"end\":{\"line\":")
        tx_put_i64(ln)
        tx_puts(",\"character\":0}},\"message\":\"")
        let off = DIAG_MSG_OFF[d as usize]
        let mlen = DIAG_MSG_LEN[d as usize]
        var mi: i64 = 0
        while mi < mlen {
            let c = DIAG_MSG_BUF[(off + mi) as usize] as i64
            if c == 34 { tx_putc(92); tx_putc(34) }
            else if c == 92 { tx_putc(92); tx_putc(92) }
            else if c == 10 { tx_putc(92); tx_putc(110) }
            else if c == 13 { tx_putc(92); tx_putc(114) }
            else if c == 9  { tx_putc(92); tx_putc(116) }
            else if c < 32 { tx_putc(32) }
            else { tx_putc(c) }
            mi = mi + 1
        }
        tx_puts("\"}")
        d = d + 1
    }
    tx_puts("]}}")
    write_frame()
}

// Pull document text + URI from current message, run check, publish.
fn handle_did_open_or_change() with IO, Mut, Panic, Div {
    let u = extract_doc_uri()
    let t = extract_doc_text()
    if u < 0 || t < 0 { return }
    if write_doc_to_disk() == false { return }
    if run_souc_check() < 0 { return }
    slurp_diag_file()
    parse_diagnostics()
    publish_diagnostics()
}

fn respond_initialize() with IO, Mut, Panic, Div {
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":{")
    tx_puts("\"capabilities\":{")
    tx_puts("\"textDocumentSync\":1,")
    tx_puts("\"hoverProvider\":true,")
    tx_puts("\"definitionProvider\":true,")
    tx_puts("\"referencesProvider\":true,")
    tx_puts("\"renameProvider\":true,")
    tx_puts("\"documentFormattingProvider\":false,")
    tx_puts("\"codeActionProvider\":true,")
    tx_puts("\"semanticTokensProvider\":{")
    tx_puts("\"legend\":{\"tokenTypes\":[],\"tokenModifiers\":[]},")
    tx_puts("\"full\":true")
    tx_puts("},")
    tx_puts("\"completionProvider\":{")
    tx_puts("\"triggerCharacters\":[\".\",\":\"]")
    tx_puts("}")
    tx_puts("},")
    tx_puts("\"serverInfo\":{")
    tx_puts("\"name\":\"sounio-lsp\",")
    tx_puts("\"version\":\"0.1.0\"")
    tx_puts("}")
    tx_puts("}}")
    write_frame()
}

fn respond_shutdown() with IO, Mut, Panic, Div {
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":null}")
    write_frame()
}

fn respond_method_not_found() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }   // notification → no response
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"error\":{\"code\":-32601,\"message\":\"Method not implemented yet (W2 skeleton)\"}}")
    write_frame()
}

fn respond_empty_result() with IO, Mut, Panic, Div {
    if LAST_ID_PRESENT == 0 { return }
    tx_reset()
    tx_puts("{\"jsonrpc\":\"2.0\",")
    tx_emit_id()
    tx_puts(",\"result\":null}")
    write_frame()
}

// ============================================================================
// Dispatch
// ============================================================================

fn dispatch(method: i64) with IO, Mut, Panic, Div {
    if method == M_INITIALIZE  { respond_initialize();   return }
    if method == M_INITIALIZED { return }                              // notification
    if method == M_SHUTDOWN    { SAW_SHUTDOWN = 1; respond_shutdown(); return }
    if method == M_EXIT        { return }                              // handled in main loop
    if method == M_DID_OPEN    { handle_did_open_or_change(); return }
    if method == M_DID_CHANGE  { handle_did_open_or_change(); return }
    if method == M_DID_CLOSE   { return }
    if method == M_DID_SAVE    { return }
    if method == M_HOVER       { respond_empty_result();      return }
    if method == M_COMPLETION  { respond_empty_result();      return }
    if method == M_DEFINITION  { respond_empty_result();      return }
    if method == M_REFERENCES  { respond_empty_result();      return }
    if method == M_RENAME      { respond_empty_result();      return }
    if method == M_CODE_ACTION { respond_empty_result();      return }
    if method == M_SEM_TOKENS  { respond_empty_result();      return }
    if method == M_FORMATTING  { respond_empty_result();      return }
    respond_method_not_found()
}

// ============================================================================
// Main loop
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    log_stderr_nl("lsp start")
    var running: i64 = 1
    while running == 1 {
        let cl = read_headers()
        if cl <= 0 { running = 0 }
        else if cl > 262144 {
            log_stderr_nl("body too large")
            running = 0
        } else {
            let got = read_body(cl)
            if got < cl {
                running = 0
            } else {
                capture_id()
                let m = classify_method()
                dispatch(m)
                if m == M_EXIT { running = 0 }
            }
        }
    }
    log_stderr_nl("lsp stop")
    if SAW_SHUTDOWN == 1 { return 0 }
    return 1
}
