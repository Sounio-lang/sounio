    if test_lspca_max_priority()                   { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_min_priority()                   { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_max_priority_empty()             { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_count_by_kind()                  { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_total_edits()                    { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_find_action_by_title()           { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_find_action_by_title_miss()      { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_find_action_by_kind()            { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_range_eq_true()                  { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_range_eq_false()                 { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_range_line_count()               { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_range_same_line_true()           { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_range_same_line_false()          { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_range_is_zero_true()             { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_range_is_zero_false()            { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_gen_add_import()                 { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_gen_add_import_text()            { passed = passed + 1 } else { failed = failed + 1 }
