// Section 12: TEST RUNNER
// ============================================================================

fn lspca_run_all_tests() -> i64 with Mut, Div, Panic {
    var passed: i64 = 0
    var failed: i64 = 0

    if test_lspca_context_new()                   { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_list_new()                       { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_add_diag_count()                 { passed = passed + 1 } else { failed = failed + 1 }
