}

// T70: full pipeline: context, multiple diags, compute, sort, verify
fn test_lspca_full_pipeline() -> bool with Mut, Div, Panic {
    var ctx = lspca_context_new(3, 7, 2)
    lspca_add_diag(&! ctx, LSPCA_DIAG_MISSING_IMPORT, 7, 0, 7, 10, "missing")
    lspca_add_diag(&! ctx, LSPCA_DIAG_UNUSED_VAR,    8, 4, 8, 9, "x unused")
    let l = lspca_compute(&ctx)
    let sorted = lspca_is_sorted(&l)
    let has_import = lspca_find_action_by_title(&l, "Add missing import") != LSPCA_INVALID
    let has_fix    = lspca_find_action_by_title(&l, "Fix unused variable") != LSPCA_INVALID
    sorted && has_import && has_fix && l.count >= 4
}

