    if test_lspca_compute_sorted()                 { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_action_edit_at()                 { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_action_edit_at_oob()             { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_action_title()                   { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_action_kind()                    { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_action_priority()                { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_action_edit_count()              { passed = passed + 1 } else { failed = failed + 1 }
    if test_lspca_context_diag_count()             { passed = passed + 1 } else { failed = failed + 1 }
