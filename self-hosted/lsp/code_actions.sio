// self-hosted::lsp::code_actions -- LSP code actions provider for Sounio
//
// Suggests quick fixes and refactorings based on the cursor position and
// any diagnostics attached to that position.  All state lives in flat
// fixed-size arenas -- no heap allocation, no recursive structures.
//
// Known action generators:
//   - "Add missing import"    (triggered by error code 1001)
//   - "Fix unused variable"   (triggered by warning code 2001)
//   - "Add type annotation"   (triggered by info code 3001)
//   - "Remove dead code"      (triggered by warning code 2002)
//   - "Extract to function"   (refactor, cursor in expression)
//   - "Inline variable"       (refactor, cursor on variable)
//
// Capacities:
//   - Diagnostics per context: 64
//   - Actions per list: 64
//   - Edits per action: 16
//
// Prefix: lspca_

// ============================================================================
// Section 1: CONSTANTS
// ============================================================================

let LSPCA_MAX_DIAGS:   i64 = 64
let LSPCA_MAX_ACTIONS: i64 = 64
let LSPCA_MAX_EDITS:   i64 = 16
let LSPCA_INVALID:     i64 = 0 - 1

// Action kind codes
let LSPCA_KIND_QUICKFIX:         i64 = 0
let LSPCA_KIND_REFACTOR:         i64 = 1
let LSPCA_KIND_REFACTOR_EXTRACT: i64 = 2
let LSPCA_KIND_REFACTOR_INLINE:  i64 = 3
let LSPCA_KIND_SOURCE:           i64 = 4

// Known diagnostic codes that trigger actions
let LSPCA_DIAG_MISSING_IMPORT:   i64 = 1001
let LSPCA_DIAG_UNUSED_VAR:       i64 = 2001
let LSPCA_DIAG_DEAD_CODE:        i64 = 2002
let LSPCA_DIAG_TYPE_ANNOTATION:  i64 = 3001
let LSPCA_DIAG_UNKNOWN_FIELD:    i64 = 1002
let LSPCA_DIAG_TYPE_MISMATCH:    i64 = 1003

// Priority values
let LSPCA_PRIO_HIGH:   i64 = 100
let LSPCA_PRIO_MEDIUM: i64 = 50
let LSPCA_PRIO_LOW:    i64 = 10

// ============================================================================
// Section 2: CORE STRUCTS
// ============================================================================

struct LspcaRange {
    start_line: i64,
    start_col:  i64,
    end_line:   i64,
    end_col:    i64,
}

struct LspcaEdit {
    file_id:  i64,
    range:    LspcaRange,
    new_text: string,
}

struct LspcaAction {
    title:      string,
    kind:       i64,
    edits:      [LspcaEdit; 16],
    edit_count: i64,
    priority:   i64,
}

struct LspcaDiag {
    code:    i64,
    range:   LspcaRange,
    message: string,
}

struct LspcaContext {
    diags:       [LspcaDiag; 64],
    count:       i64,
    file_id:     i64,
    cursor_line: i64,
    cursor_col:  i64,
}

struct LspcaList {
    actions: [LspcaAction; 64],
    count:   i64,
}

// ============================================================================
// Section 3: ZERO-VALUE CONSTRUCTORS (helpers must precede callers)
// ============================================================================

fn lspca_range_new(sl: i64, sc: i64, el: i64, ec: i64) -> LspcaRange {
    LspcaRange {
        start_line: sl,
        start_col:  sc,
        end_line:   el,
        end_col:    ec,
    }
}

fn lspca_range_zero() -> LspcaRange {
    LspcaRange {
        start_line: 0,
        start_col:  0,
        end_line:   0,
        end_col:    0,
    }
}

fn lspca_edit_zero() -> LspcaEdit {
    LspcaEdit {
        file_id:  0,
        range:    lspca_range_zero(),
        new_text: "",
    }
}

fn lspca_action_zero() -> LspcaAction {
    LspcaAction {
        title:      "",
        kind:       LSPCA_KIND_QUICKFIX,
        edits:      [lspca_edit_zero(); 16],
        edit_count: 0,
        priority:   0,
    }
}

fn lspca_diag_zero() -> LspcaDiag {
    LspcaDiag {
        code:    0,
        range:   lspca_range_zero(),
        message: "",
    }
}

fn lspca_context_new(file_id: i64, line: i64, col: i64) -> LspcaContext {
    LspcaContext {
        diags:       [lspca_diag_zero(); 64],
        count:       0,
        file_id:     file_id,
        cursor_line: line,
        cursor_col:  col,
    }
}

fn lspca_list_new() -> LspcaList {
    LspcaList {
        actions: [lspca_action_zero(); 64],
        count:   0,
    }
}

// ============================================================================
// Section 4: CONTEXT OPERATIONS
// ============================================================================

// Add a diagnostic to the context.
fn lspca_add_diag(ctx: &! LspcaContext, code: i64, start_line: i64, start_col: i64, end_line: i64, end_col: i64, msg: string) with Mut, Panic {
    if ctx.count >= LSPCA_MAX_DIAGS {
        return
    }
    let idx = ctx.count
    ctx.diags[idx as usize] = LspcaDiag {
        code:    code,
        range:   lspca_range_new(start_line, start_col, end_line, end_col),
        message: msg,
    }
    ctx.count = ctx.count + 1
}

// Count diagnostics in context.
fn lspca_context_diag_count(ctx: &LspcaContext) -> i64 {
    ctx.count
}

// Check if cursor is inside a given range.
fn lspca_cursor_in_range(ctx: &LspcaContext, r: &LspcaRange) -> bool {
    let line = ctx.cursor_line
    let col  = ctx.cursor_col
    if line < r.start_line { return false }
    if line > r.end_line   { return false }
    if r.start_line == r.end_line {
        return col >= r.start_col && col <= r.end_col
    }
    if line == r.start_line { return col >= r.start_col }
    if line == r.end_line   { return col <= r.end_col }
    true
}

// Find a diagnostic whose range contains the cursor.  Returns its index or INVALID.
fn lspca_find_diag_at_cursor(ctx: &LspcaContext) -> i64 {
    var i: i64 = 0
    while i < ctx.count {
        if lspca_cursor_in_range(ctx, &ctx.diags[i as usize].range) {
            return i
        }
        i = i + 1
    }
    LSPCA_INVALID
}

// Find a diagnostic with a specific code.  Returns its index or INVALID.
fn lspca_find_diag_by_code(ctx: &LspcaContext, code: i64) -> i64 {
    var i: i64 = 0
    while i < ctx.count {
        if ctx.diags[i as usize].code == code {
            return i
        }
        i = i + 1
    }
    LSPCA_INVALID
}

// Count diagnostics with a specific code.
fn lspca_count_diags_by_code(ctx: &LspcaContext, code: i64) -> i64 {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.count {
        if ctx.diags[i as usize].code == code {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// ============================================================================
// Section 5: ACTION LIST OPERATIONS
// ============================================================================

// Add a new action to the list.  Returns the action index.
fn lspca_add_action(l: &! LspcaList, title: string, kind: i64, priority: i64) -> i64 with Mut, Panic {
    if l.count >= LSPCA_MAX_ACTIONS {
        return LSPCA_INVALID
    }
    let idx = l.count
    l.actions[idx as usize] = LspcaAction {
        title:      title,
        kind:       kind,
        edits:      [lspca_edit_zero(); 16],
        edit_count: 0,
        priority:   priority,
    }
    l.count = l.count + 1
    idx
}

// Add an edit to an action.
fn lspca_add_edit(l: &! LspcaList, action_idx: i64, file_id: i64, start_line: i64, start_col: i64, end_line: i64, end_col: i64, text: string) with Mut, Panic {
    if action_idx < 0 || action_idx >= l.count {
        return
    }
    let ec = l.actions[action_idx as usize].edit_count
    if ec >= LSPCA_MAX_EDITS {
        return
    }
    l.actions[action_idx as usize].edits[ec as usize] = LspcaEdit {
        file_id:  file_id,
        range:    lspca_range_new(start_line, start_col, end_line, end_col),
        new_text: text,
    }
    l.actions[action_idx as usize].edit_count = ec + 1
}

// Get action title.
fn lspca_action_title(l: &LspcaList, idx: i64) -> string with Panic {
    if idx < 0 || idx >= l.count { return "" }
    l.actions[idx as usize].title
}

// Get action kind.
fn lspca_action_kind(l: &LspcaList, idx: i64) -> i64 with Panic {
    if idx < 0 || idx >= l.count { return LSPCA_INVALID }
    l.actions[idx as usize].kind
}

// Get action priority.
fn lspca_action_priority(l: &LspcaList, idx: i64) -> i64 with Panic {
    if idx < 0 || idx >= l.count { return 0 }
    l.actions[idx as usize].priority
}

// Get action edit count.
fn lspca_action_edit_count(l: &LspcaList, idx: i64) -> i64 with Panic {
    if idx < 0 || idx >= l.count { return 0 }
    l.actions[idx as usize].edit_count
}

// Get total action count.
fn lspca_list_count(l: &LspcaList) -> i64 {
    l.count
}

// Get an edit from an action.
fn lspca_action_edit_at(l: &LspcaList, action_idx: i64, edit_idx: i64) -> LspcaEdit with Panic {
    if action_idx < 0 || action_idx >= l.count { return lspca_edit_zero() }
    let ec = l.actions[action_idx as usize].edit_count
    if edit_idx < 0 || edit_idx >= ec { return lspca_edit_zero() }
    l.actions[action_idx as usize].edits[edit_idx as usize]
}

// ============================================================================
// Section 6: SORT
// ============================================================================

// Insertion-sort actions by priority descending.
fn lspca_sort(l: &! LspcaList) with Mut, Div, Panic {
    var i: i64 = 1
    while i < l.count {
        let key = l.actions[i as usize]
        var j: i64 = i - 1
        while j >= 0 {
            // Sort descending: move elements with lower priority to the right
            if l.actions[j as usize].priority < key.priority {
                l.actions[(j + 1) as usize] = l.actions[j as usize]
                j = j - 1
            } else {
                j = 0 - 1
            }
        }
        l.actions[(j + 1) as usize] = key
        i = i + 1
    }
}

// ============================================================================
// Section 7: RANGE UTILITIES
// ============================================================================

fn lspca_range_eq(a: &LspcaRange, b: &LspcaRange) -> bool {
    a.start_line == b.start_line
        && a.start_col == b.start_col
        && a.end_line  == b.end_line
        && a.end_col   == b.end_col
}

fn lspca_range_is_zero(r: &LspcaRange) -> bool {
    r.start_line == 0 && r.start_col == 0 && r.end_line == 0 && r.end_col == 0
}

fn lspca_range_line_count(r: &LspcaRange) -> i64 {
    r.end_line - r.start_line + 1
}

fn lspca_range_same_line(r: &LspcaRange) -> bool {
    r.start_line == r.end_line
}

// ============================================================================
// Section 8: KNOWN-ACTION GENERATORS
// ============================================================================

// Generate "Add missing import" quick fix.
// Inserts an import line at the top of the file (line 0, col 0).
fn lspca_gen_add_import(l: &! LspcaList, ctx: &LspcaContext, import_text: string) with Mut, Div, Panic {
    let idx = lspca_add_action(l, "Add missing import", LSPCA_KIND_QUICKFIX, LSPCA_PRIO_HIGH)
    if idx == LSPCA_INVALID { return }
    lspca_add_edit(l, idx, ctx.file_id, 0, 0, 0, 0, import_text)
}

// Generate "Fix unused variable" quick fix.
// Prefixes the variable name with _ to silence the warning.
// The edit text is the prefixed name; range covers the variable name.
fn lspca_gen_fix_unused_var(l: &! LspcaList, ctx: &LspcaContext, diag_idx: i64) with Mut, Div, Panic {
    if diag_idx < 0 || diag_idx >= ctx.count { return }
    let dr = ctx.diags[diag_idx as usize].range
    let idx = lspca_add_action(l, "Fix unused variable", LSPCA_KIND_QUICKFIX, LSPCA_PRIO_MEDIUM)
    if idx == LSPCA_INVALID { return }
    lspca_add_edit(l, idx, ctx.file_id,
        dr.start_line, dr.start_col, dr.end_line, dr.end_col,
        "_unused")
}

// Generate "Add type annotation" action.
// Inserts ": <type>" after the variable name.
fn lspca_gen_add_type_annotation(l: &! LspcaList, ctx: &LspcaContext, diag_idx: i64) with Mut, Div, Panic {
    if diag_idx < 0 || diag_idx >= ctx.count { return }
    let dr = ctx.diags[diag_idx as usize].range
    let idx = lspca_add_action(l, "Add type annotation", LSPCA_KIND_QUICKFIX, LSPCA_PRIO_LOW)
    if idx == LSPCA_INVALID { return }
    // Insert annotation at end of name token
    lspca_add_edit(l, idx, ctx.file_id,
        dr.end_line, dr.end_col, dr.end_line, dr.end_col,
        ": _")
}

// Generate "Remove dead code" source action.
// Deletes the range covered by the diagnostic.
fn lspca_gen_remove_dead_code(l: &! LspcaList, ctx: &LspcaContext, diag_idx: i64) with Mut, Div, Panic {
    if diag_idx < 0 || diag_idx >= ctx.count { return }
    let dr = ctx.diags[diag_idx as usize].range
    let idx = lspca_add_action(l, "Remove dead code", LSPCA_KIND_SOURCE, LSPCA_PRIO_LOW)
    if idx == LSPCA_INVALID { return }
    lspca_add_edit(l, idx, ctx.file_id,
        dr.start_line, dr.start_col, dr.end_line, dr.end_col,
        "")
}

// Generate "Extract to function" refactor.
// Placeholder edit: wraps cursor line in a function skeleton.
fn lspca_gen_extract_function(l: &! LspcaList, ctx: &LspcaContext) with Mut, Div, Panic {
    let idx = lspca_add_action(l, "Extract to function", LSPCA_KIND_REFACTOR_EXTRACT, LSPCA_PRIO_MEDIUM)
    if idx == LSPCA_INVALID { return }
    lspca_add_edit(l, idx, ctx.file_id,
        ctx.cursor_line, 0, ctx.cursor_line, 0,
        "fn extracted() {\n")
    lspca_add_edit(l, idx, ctx.file_id,
        ctx.cursor_line + 1, 0, ctx.cursor_line + 1, 0,
        "}\n")
}

// Generate "Inline variable" refactor.
// Placeholder: marks the range for inlining.
fn lspca_gen_inline_variable(l: &! LspcaList, ctx: &LspcaContext) with Mut, Div, Panic {
    let idx = lspca_add_action(l, "Inline variable", LSPCA_KIND_REFACTOR_INLINE, LSPCA_PRIO_LOW)
    if idx == LSPCA_INVALID { return }
    lspca_add_edit(l, idx, ctx.file_id,
        ctx.cursor_line, ctx.cursor_col, ctx.cursor_line, ctx.cursor_col,
        "/* inline */")
}

// ============================================================================
// Section 9: COMPUTE (main dispatch)
// ============================================================================

// Generate all applicable code actions for the given context.
// Inspects each diagnostic and the cursor position.
fn lspca_compute(ctx: &LspcaContext) -> LspcaList with Mut, Div, Panic {
    var l = lspca_list_new()

    // Walk each diagnostic and emit relevant actions
    var i: i64 = 0
    while i < ctx.count {
        let code = ctx.diags[i as usize].code
        if code == LSPCA_DIAG_MISSING_IMPORT {
            lspca_gen_add_import(&! l, ctx, "use missing::module")
        }
        if code == LSPCA_DIAG_UNUSED_VAR {
            lspca_gen_fix_unused_var(&! l, ctx, i)
        }
        if code == LSPCA_DIAG_TYPE_ANNOTATION {
            lspca_gen_add_type_annotation(&! l, ctx, i)
        }
        if code == LSPCA_DIAG_DEAD_CODE {
            lspca_gen_remove_dead_code(&! l, ctx, i)
        }
        i = i + 1
    }

    // Cursor-position-based refactors (always available)
    lspca_gen_extract_function(&! l, ctx)
    lspca_gen_inline_variable(&! l, ctx)

    lspca_sort(&! l)
    l
}

// ============================================================================
// Section 10: QUERY HELPERS
// ============================================================================

// Find the first action in a list with a given kind.
fn lspca_find_action_by_kind(l: &LspcaList, kind: i64) -> i64 {
    var i: i64 = 0
    while i < l.count {
        if l.actions[i as usize].kind == kind {
            return i
        }
        i = i + 1
    }
    LSPCA_INVALID
}

// Find the first action in a list with a given title prefix (exact match).
fn lspca_find_action_by_title(l: &LspcaList, title: string) -> i64 {
    var i: i64 = 0
    while i < l.count {
        if str_eq(l.actions[i as usize].title, title) {
            return i
        }
        i = i + 1
    }
    LSPCA_INVALID
}

// Count actions of a specific kind.
fn lspca_count_by_kind(l: &LspcaList, kind: i64) -> i64 {
    var count: i64 = 0
    var i: i64 = 0
    while i < l.count {
        if l.actions[i as usize].kind == kind {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Check that list is sorted by priority descending.
fn lspca_is_sorted(l: &LspcaList) -> bool {
    if l.count <= 1 { return true }
    var i: i64 = 1
    while i < l.count {
        if l.actions[(i - 1) as usize].priority < l.actions[i as usize].priority {
            return false
        }
        i = i + 1
    }
    true
}

// Return the highest priority in the list.
fn lspca_max_priority(l: &LspcaList) -> i64 {
    if l.count == 0 { return 0 - 1 }
    var best: i64 = l.actions[0].priority
    var i: i64 = 1
    while i < l.count {
        if l.actions[i as usize].priority > best {
            best = l.actions[i as usize].priority
        }
        i = i + 1
    }
    best
}

// Return the lowest priority in the list.
fn lspca_min_priority(l: &LspcaList) -> i64 {
    if l.count == 0 { return 0 - 1 }
    var best: i64 = l.actions[0].priority
    var i: i64 = 1
    while i < l.count {
        if l.actions[i as usize].priority < best {
            best = l.actions[i as usize].priority
        }
        i = i + 1
    }
    best
}

// Count total edits across all actions.
fn lspca_total_edits(l: &LspcaList) -> i64 {
    var total: i64 = 0
    var i: i64 = 0
    while i < l.count {
        total = total + l.actions[i as usize].edit_count
        i = i + 1
    }
    total
}

// ============================================================================
// Section 11: TESTS
// ============================================================================

// Inner helpers that encapsulate multi-borrow sequences within single &! borrow.

fn tca_inner_add_action_count(l: &! LspcaList) -> bool with Mut, Div, Panic {
    let _a = lspca_add_action(l, "A", LSPCA_KIND_QUICKFIX, 10)
    let _b = lspca_add_action(l, "B", LSPCA_KIND_REFACTOR, 20)
    l.count == 2
}

fn tca_inner_add_edit_count(l: &! LspcaList) -> bool with Mut, Div, Panic {
    let idx = lspca_add_action(l, "Fix", LSPCA_KIND_QUICKFIX, 50)
    lspca_add_edit(l, idx, 1, 0, 0, 0, 5, "import x")
    l.actions[idx as usize].edit_count == 1
}

fn tca_inner_add_edit_file(l: &! LspcaList) -> bool with Mut, Div, Panic {
    let idx = lspca_add_action(l, "Fix", LSPCA_KIND_QUICKFIX, 50)
    lspca_add_edit(l, idx, 42, 0, 0, 0, 5, "text")
    l.actions[idx as usize].edits[0].file_id == 42
}

fn tca_inner_add_edit_text(l: &! LspcaList) -> bool with Mut, Div, Panic {
    let idx = lspca_add_action(l, "Fix", LSPCA_KIND_QUICKFIX, 50)
    lspca_add_edit(l, idx, 1, 1, 0, 1, 3, "replacement")
    str_eq(l.actions[idx as usize].edits[0].new_text, "replacement")
}

fn tca_inner_sort_desc(l: &! LspcaList) -> bool with Mut, Div, Panic {
    let _a = lspca_add_action(l, "Low",  LSPCA_KIND_SOURCE,   10)
    let _b = lspca_add_action(l, "High", LSPCA_KIND_QUICKFIX, 100)
    let _c = lspca_add_action(l, "Mid",  LSPCA_KIND_REFACTOR, 50)
    lspca_sort(l)
    lspca_is_sorted(l)
}

fn tca_inner_max_priority(l: &! LspcaList) -> bool with Mut, Div, Panic {
    let _a = lspca_add_action(l, "A", LSPCA_KIND_QUICKFIX, 30)
    let _b = lspca_add_action(l, "B", LSPCA_KIND_QUICKFIX, 80)
    let _c = lspca_add_action(l, "C", LSPCA_KIND_QUICKFIX, 55)
    lspca_max_priority(l) == 80
}

fn tca_inner_min_priority(l: &! LspcaList) -> bool with Mut, Div, Panic {
    let _a = lspca_add_action(l, "A", LSPCA_KIND_QUICKFIX, 30)
    let _b = lspca_add_action(l, "B", LSPCA_KIND_QUICKFIX, 80)
    lspca_min_priority(l) == 30
}

fn tca_inner_count_by_kind(l: &! LspcaList) -> bool with Mut, Div, Panic {
    let _a = lspca_add_action(l, "A", LSPCA_KIND_QUICKFIX, 10)
    let _b = lspca_add_action(l, "B", LSPCA_KIND_QUICKFIX, 20)
    let _c = lspca_add_action(l, "C", LSPCA_KIND_REFACTOR, 30)
    lspca_count_by_kind(l, LSPCA_KIND_QUICKFIX) == 2
}

fn tca_inner_total_edits(l: &! LspcaList) -> bool with Mut, Div, Panic {
    let a = lspca_add_action(l, "A", LSPCA_KIND_QUICKFIX, 50)
    let b = lspca_add_action(l, "B", LSPCA_KIND_REFACTOR, 30)
    lspca_add_edit(l, a, 1, 0, 0, 0, 5, "x")
    lspca_add_edit(l, a, 1, 1, 0, 1, 5, "y")
    lspca_add_edit(l, b, 1, 2, 0, 2, 5, "z")
    lspca_total_edits(l) == 3
}

fn tca_inner_find_by_title(l: &! LspcaList) -> bool with Mut, Div, Panic {
    let _a = lspca_add_action(l, "Alpha", LSPCA_KIND_QUICKFIX, 10)
    let _b = lspca_add_action(l, "Beta",  LSPCA_KIND_REFACTOR, 20)
    lspca_find_action_by_title(l, "Beta") == 1
}

fn tca_inner_find_by_kind(l: &! LspcaList) -> bool with Mut, Div, Panic {
    let _a = lspca_add_action(l, "A", LSPCA_KIND_SOURCE,   5)
    let _b = lspca_add_action(l, "B", LSPCA_KIND_REFACTOR, 15)
    lspca_find_action_by_kind(l, LSPCA_KIND_REFACTOR) == 1
}

fn tca_inner_action_edit_at(l: &! LspcaList) -> bool with Mut, Div, Panic {
    let idx = lspca_add_action(l, "X", LSPCA_KIND_QUICKFIX, 50)
    lspca_add_edit(l, idx, 7, 3, 1, 3, 8, "new text")
    let e = lspca_action_edit_at(l, idx, 0)
    e.file_id == 7 && str_eq(e.new_text, "new text")
}

fn tca_inner_action_edit_at_oob(l: &! LspcaList) -> bool with Mut, Div, Panic {
    let idx = lspca_add_action(l, "X", LSPCA_KIND_QUICKFIX, 50)
    lspca_add_edit(l, idx, 1, 1, 0, 1, 5, "t")
    let e = lspca_action_edit_at(l, idx, 99)
    e.file_id == 0 && str_len(e.new_text) == 0
}

fn tca_inner_action_title(l: &! LspcaList) -> bool with Mut, Div, Panic {
    let idx = lspca_add_action(l, "Rename Symbol", LSPCA_KIND_REFACTOR, 50)
    str_eq(lspca_action_title(l, idx), "Rename Symbol")
}

fn tca_inner_action_kind(l: &! LspcaList) -> bool with Mut, Div, Panic {
    let idx = lspca_add_action(l, "Inline", LSPCA_KIND_REFACTOR_INLINE, 30)
    lspca_action_kind(l, idx) == LSPCA_KIND_REFACTOR_INLINE
}

fn tca_inner_action_priority(l: &! LspcaList) -> bool with Mut, Div, Panic {
    let idx = lspca_add_action(l, "High Prio", LSPCA_KIND_QUICKFIX, 100)
    lspca_action_priority(l, idx) == 100
}

fn tca_inner_action_edit_count(l: &! LspcaList) -> bool with Mut, Div, Panic {
    let idx = lspca_add_action(l, "Multi", LSPCA_KIND_QUICKFIX, 50)
    lspca_add_edit(l, idx, 1, 1, 0, 1, 5, "a")
    lspca_add_edit(l, idx, 1, 2, 0, 2, 5, "b")
    lspca_action_edit_count(l, idx) == 2
}

fn tca_inner_sort_preserves(l: &! LspcaList) -> bool with Mut, Div, Panic {
    let _a = lspca_add_action(l, "A", LSPCA_KIND_QUICKFIX, 30)
    let _b = lspca_add_action(l, "B", LSPCA_KIND_QUICKFIX, 10)
    let _c = lspca_add_action(l, "C", LSPCA_KIND_QUICKFIX, 20)
    lspca_sort(l)
    l.count == 3
}

fn tca_inner_sort_highest_first(l: &! LspcaList) -> bool with Mut, Div, Panic {
    let _a = lspca_add_action(l, "Low",  LSPCA_KIND_QUICKFIX, 10)
    let _b = lspca_add_action(l, "High", LSPCA_KIND_QUICKFIX, 100)
    lspca_sort(l)
    l.actions[0].priority == 100
}

fn tca_inner_list_count(l: &! LspcaList) -> bool with Mut, Div, Panic {
    let _a = lspca_add_action(l, "A", LSPCA_KIND_QUICKFIX, 10)
    let _b = lspca_add_action(l, "B", LSPCA_KIND_QUICKFIX, 20)
    lspca_list_count(l) == 2
}

// T01: lspca_context_new initializes correctly
