    lsph_set_symbol_type(ctx, idx, LsphTypeCategory::TcPrimitive, &tb)
    lsph_set_symbol_param_count(ctx, idx, 0)

    let sig = lsph_format_function_signature(ctx, idx)
    // Should start with "fn "
    let ok_f = sig.buf[0] == 102
    let ok_n = sig.buf[1] == 110
    let ok_sp = sig.buf[2] == LSPH_BYTE_SPACE
    let ok_len = sig.len > 5
    ok_f && ok_n && ok_sp && ok_len
}
fn test_lsph_format_sig_no_params() -> bool with Mut, Div, Panic {
    var ctx = lsph_context_new()
