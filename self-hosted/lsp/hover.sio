// Section 27: TESTS -- TYPE FORMATTING (T31-T38)
// ============================================================================

// T31: Format primitive type category
fn test_lsph_format_type_primitive() -> bool with Mut, Div, Panic {
    let buf = lsph_format_type_category(LsphTypeCategory::TcPrimitive)
    // "primitive" = 9 bytes
    let ok_len = buf.len == 9
    let ok_b0 = buf.buf[0] == 112 // 'p'
    let ok_b8 = buf.buf[8] == 101 // 'e'
    ok_len && ok_b0 && ok_b8
}

// T32: Format struct type category
fn test_lsph_format_type_struct() -> bool with Mut, Div, Panic {
    let buf = lsph_format_type_category(LsphTypeCategory::TcStruct)
    // "struct" = 6 bytes
    let ok_len = buf.len == 6
    let ok_b0 = buf.buf[0] == 115 // 's'
    ok_len && ok_b0
}

// T33: Format enum type category
fn test_lsph_format_type_enum() -> bool with Mut, Div, Panic {
    let buf = lsph_format_type_category(LsphTypeCategory::TcEnum)
    // "enum" = 4 bytes
    let ok_len = buf.len == 4
    let ok_b0 = buf.buf[0] == 101 // 'e'
    ok_len && ok_b0
}

// T34: Format function type category
fn test_lsph_format_type_function() -> bool with Mut, Div, Panic {
    let buf = lsph_format_type_category(LsphTypeCategory::TcFunction)
    // "function" = 8 bytes
    let ok_len = buf.len == 8
    let ok_b0 = buf.buf[0] == 102 // 'f'
    ok_len && ok_b0
}

// T35: Format array type category
fn test_lsph_format_type_array() -> bool with Mut, Div, Panic {
    let buf = lsph_format_type_category(LsphTypeCategory::TcArray)
    // "array" = 5 bytes
    let ok_len = buf.len == 5
    let ok_b0 = buf.buf[0] == 97 // 'a'
    ok_len && ok_b0
}

// T36: Format ref type category
fn test_lsph_format_type_ref() -> bool with Mut, Div, Panic {
    let buf = lsph_format_type_category(LsphTypeCategory::TcRef)
    // "&T" = 2 bytes
    let ok_len = buf.len == 2
    let ok_b0 = buf.buf[0] == LSPH_BYTE_AMPERSAND
    let ok_b1 = buf.buf[1] == 84 // 'T'
    ok_len && ok_b0 && ok_b1
}

// T37: Format mut ref type category
fn test_lsph_format_type_mutref() -> bool with Mut, Div, Panic {
    let buf = lsph_format_type_category(LsphTypeCategory::TcMutRef)
    // "&!T" = 3 bytes
    let ok_len = buf.len == 3
    let ok_b0 = buf.buf[0] == LSPH_BYTE_AMPERSAND
    let ok_b1 = buf.buf[1] == LSPH_BYTE_BANG
    ok_len && ok_b0 && ok_b1
}

// T38: Format unit and never type categories
fn test_lsph_format_type_unit_never() -> bool with Mut, Div, Panic {
    let unit_buf = lsph_format_type_category(LsphTypeCategory::TcUnit)
    let never_buf = lsph_format_type_category(LsphTypeCategory::TcNever)
    // "()" = 2 bytes, "!" = 1 byte
    let ok_unit_len = unit_buf.len == 2
    let ok_never_len = never_buf.len == 1
    let ok_unit_b0 = unit_buf.buf[0] == LSPH_BYTE_LPAREN
    let ok_never_b0 = never_buf.buf[0] == LSPH_BYTE_BANG
    ok_unit_len && ok_never_len && ok_unit_b0 && ok_never_b0
}

// ============================================================================
// Section 28: TESTS -- HOVER CONTENT (T39-T48)
// ============================================================================

// T39: Hover for function (basic)
fn test_lsph_hover_function_basic_inner(ctx: &! LsphContext) -> bool with Mut, Div, Panic {
    let idx = lsph_add_symbol(ctx, LsphSymbolKind::SymFunction, 42, 5, 0, 5, 30)
    let tb = lsph_make_type_i32()
    lsph_set_symbol_type(ctx, idx, LsphTypeCategory::TcPrimitive, &tb)
    lsph_set_symbol_param_count(ctx, idx, 0)

    lsph_build_hover_content(ctx, idx)
    let ok_has_content = ctx.hover_result.len > 0
    // Should start with ``` (code fence)
    let ok_fence = ctx.hover_result.buf[0] == LSPH_BYTE_BACKTICK
    ok_has_content && ok_fence
}
fn test_lsph_hover_function_basic() -> bool with Mut, Div, Panic {
    var ctx = lsph_context_new()
    test_lsph_hover_function_basic_inner(&! ctx)
}

