// T41: Hover for variable (mutable)
fn test_lsph_hover_variable_mut_inner(ctx: &! LsphContext) -> bool with Mut, Div, Panic {
    let idx = lsph_add_symbol(ctx, LsphSymbolKind::SymVariable, 88, 4, 4, 4, 12)
    let tb = lsph_make_type_i32()
    lsph_set_symbol_type(ctx, idx, LsphTypeCategory::TcPrimitive, &tb)
    lsph_set_symbol_mutable(ctx, idx, true)

    lsph_build_hover_content(ctx, idx)

    // After code fence open (```sio\n = 7 bytes), should have "var "
    // Byte 7 should be 'v' (118), byte 8 'a' (97), byte 9 'r' (114)
    let ok_len = ctx.hover_result.len > 10
    let ok_v = ctx.hover_result.buf[7] == 118  // 'v'
    let ok_a = ctx.hover_result.buf[8] == 97   // 'a'
    let ok_r = ctx.hover_result.buf[9] == 114  // 'r'
    ok_len && ok_v && ok_a && ok_r
}
fn test_lsph_hover_variable_mut() -> bool with Mut, Div, Panic {
    var ctx = lsph_context_new()
    test_lsph_hover_variable_mut_inner(&! ctx)
}

