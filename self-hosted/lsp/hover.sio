// T55: Build line index (single line)
fn test_lsph_line_index_single_inner(ctx: &! LsphContext) -> bool with Mut, Div, Panic {
    var src: [i64; 4096] = [0; 4096]
    // "hello" = no newlines
    src[0] = 104
    src[1] = 101
    src[2] = 108
    src[3] = 108
    src[4] = 111
    lsph_build_line_index(ctx, &src, 5)
    let ok_count = ctx.line_index.line_count == 1
    let ok_start = ctx.line_index.line_starts[0] == 0
    ok_count && ok_start
}
fn test_lsph_line_index_single() -> bool with Mut, Div, Panic {
    var ctx = lsph_context_new()
    test_lsph_line_index_single_inner(&! ctx)
}

// T56: Build line index (two lines)
fn test_lsph_line_index_two_inner(ctx: &! LsphContext) -> bool with Mut, Div, Panic {
    var src: [i64; 4096] = [0; 4096]
    // "ab\ncd" -> line 0 at 0, line 1 at 3
    src[0] = 97   // a
    src[1] = 98   // b
    src[2] = 10   // \n
    src[3] = 99   // c
    src[4] = 100  // d
    lsph_build_line_index(ctx, &src, 5)
    let ok_count = ctx.line_index.line_count == 2
    let ok_s0 = ctx.line_index.line_starts[0] == 0
    let ok_s1 = ctx.line_index.line_starts[1] == 3
    ok_count && ok_s0 && ok_s1
}
fn test_lsph_line_index_two() -> bool with Mut, Div, Panic {
    var ctx = lsph_context_new()
    test_lsph_line_index_two_inner(&! ctx)
}

// T57: Build line index (three lines)
fn test_lsph_line_index_three_inner(ctx: &! LsphContext) -> bool with Mut, Div, Panic {
    var src: [i64; 4096] = [0; 4096]
    // "a\nb\nc"
    src[0] = 97   // a
    src[1] = 10   // \n
    src[2] = 98   // b
    src[3] = 10   // \n
    src[4] = 99   // c
    lsph_build_line_index(ctx, &src, 5)
    let ok_count = ctx.line_index.line_count == 3
    let ok_s0 = ctx.line_index.line_starts[0] == 0
    let ok_s1 = ctx.line_index.line_starts[1] == 2
    let ok_s2 = ctx.line_index.line_starts[2] == 4
    ok_count && ok_s0 && ok_s1 && ok_s2
}
fn test_lsph_line_index_three() -> bool with Mut, Div, Panic {
    var ctx = lsph_context_new()
    test_lsph_line_index_three_inner(&! ctx)
}

// T58: Line/col to offset
fn test_lsph_line_col_to_offset_inner(ctx: &! LsphContext) -> bool with Mut, Div, Panic {
    var src: [i64; 4096] = [0; 4096]
    // "abc\ndef\nghi"
    src[0] = 97   // a
    src[1] = 98   // b
    src[2] = 99   // c
    src[3] = 10   // \n
    src[4] = 100  // d
    src[5] = 101  // e
    src[6] = 102  // f
    src[7] = 10   // \n
    src[8] = 103  // g
    src[9] = 104  // h
    src[10] = 105 // i
    lsph_build_line_index(ctx, &src, 11)

    let off_00 = lsph_line_col_to_offset(ctx, 0, 0) // should be 0
    let off_02 = lsph_line_col_to_offset(ctx, 0, 2) // should be 2
    let off_10 = lsph_line_col_to_offset(ctx, 1, 0) // should be 4
    let off_12 = lsph_line_col_to_offset(ctx, 1, 2) // should be 6
    let off_20 = lsph_line_col_to_offset(ctx, 2, 0) // should be 8

    off_00 == 0 && off_02 == 2 && off_10 == 4 && off_12 == 6 && off_20 == 8
}
fn test_lsph_line_col_to_offset() -> bool with Mut, Div, Panic {
    var ctx = lsph_context_new()
    test_lsph_line_col_to_offset_inner(&! ctx)
}

// T59: Offset to line
fn test_lsph_offset_to_line_inner(ctx: &! LsphContext) -> bool with Mut, Div, Panic {
    var src: [i64; 4096] = [0; 4096]
    // "ab\ncd\nef"
    src[0] = 97
    src[1] = 98
    src[2] = 10
    src[3] = 99
    src[4] = 100
    src[5] = 10
    src[6] = 101
    src[7] = 102
    lsph_build_line_index(ctx, &src, 8)

    let l0 = lsph_offset_to_line(ctx, 0)
    let l1 = lsph_offset_to_line(ctx, 1)
    let l2 = lsph_offset_to_line(ctx, 3)
    let l3 = lsph_offset_to_line(ctx, 6)

    l0 == 0 && l1 == 0 && l2 == 1 && l3 == 2
}
fn test_lsph_offset_to_line() -> bool with Mut, Div, Panic {
    var ctx = lsph_context_new()
    test_lsph_offset_to_line_inner(&! ctx)
}

// T60: Offset to col
fn test_lsph_offset_to_col_inner(ctx: &! LsphContext) -> bool with Mut, Div, Panic {
    var src: [i64; 4096] = [0; 4096]
    // "ab\ncd\nef"
    src[0] = 97
    src[1] = 98
    src[2] = 10
    src[3] = 99
    src[4] = 100
    src[5] = 10
    src[6] = 101
    src[7] = 102
    lsph_build_line_index(ctx, &src, 8)

    let c0 = lsph_offset_to_col(ctx, 0) // col 0
    let c1 = lsph_offset_to_col(ctx, 1) // col 1
    let c4 = lsph_offset_to_col(ctx, 4) // col 1 (on line 1)
    let c7 = lsph_offset_to_col(ctx, 7) // col 1 (on line 2)

    c0 == 0 && c1 == 1 && c4 == 1 && c7 == 1
}
fn test_lsph_offset_to_col() -> bool with Mut, Div, Panic {
    var ctx = lsph_context_new()
    test_lsph_offset_to_col_inner(&! ctx)
}

