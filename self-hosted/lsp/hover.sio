// T49: Format function signature (no params, no effects)
fn test_lsph_format_sig_no_params_inner(ctx: &! LsphContext) -> bool with Mut, Div, Panic {
    let idx = lsph_add_symbol(ctx, LsphSymbolKind::SymFunction, 42, 1, 0, 1, 20)
