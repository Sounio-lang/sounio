// T63: Full hover pipeline -- function found
fn test_lsph_hover_pipeline_function_inner(ctx: &! LsphContext) -> bool with Mut, Div, Panic {
    let idx = lsph_add_symbol(ctx, LsphSymbolKind::SymFunction, 42, 5, 0, 5, 30)
    let tb = lsph_make_type_i32()
    lsph_set_symbol_type(ctx, idx, LsphTypeCategory::TcPrimitive, &tb)
    lsph_set_symbol_param_count(ctx, idx, 0)

    let found = lsph_handle_hover(ctx, 5, 10)
    let ok_found = found
    let ok_len = ctx.hover_result.len > 0
    let ok_line = ctx.last_hover_line == 5
    let ok_col = ctx.last_hover_col == 10
    ok_found && ok_len && ok_line && ok_col
}
