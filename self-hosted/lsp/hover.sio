    let i0 = lsph_add_symbol(ctx, LsphSymbolKind::SymFunction, 111, 1, 0, 1, 10)
    let i1 = lsph_add_symbol(ctx, LsphSymbolKind::SymVariable, 222, 2, 0, 2, 10)
    let i2 = lsph_add_symbol(ctx, LsphSymbolKind::SymType, 333, 3, 0, 3, 10)

    let f0 = lsph_find_symbol_by_hash(ctx, 111)
    let f1 = lsph_find_symbol_by_hash(ctx, 222)
    let f2 = lsph_find_symbol_by_hash(ctx, 333)
    let fm = lsph_find_symbol_by_hash(ctx, 999)

    f0 == 0 && f1 == 1 && f2 == 2 && fm == LSPH_INVALID
}
fn test_lsph_find_symbol_by_hash() -> bool with Mut, Div, Panic {
    var ctx = lsph_context_new()
    test_lsph_find_symbol_by_hash_inner(&! ctx)
}

