// T62: Invalid line col to offset
fn test_lsph_line_col_invalid_inner(ctx: &! LsphContext) -> bool with Mut, Div, Panic {
    var src: [i64; 4096] = [0; 4096]
    src[0] = 65
    lsph_build_line_index(ctx, &src, 1)

    let r_neg = lsph_line_col_to_offset(ctx, 0 - 1, 0)
    let r_over = lsph_line_col_to_offset(ctx, 5, 0)
    r_neg == LSPH_INVALID && r_over == LSPH_INVALID
}
fn test_lsph_line_col_invalid() -> bool with Mut, Div, Panic {
    var ctx = lsph_context_new()
    test_lsph_line_col_invalid_inner(&! ctx)
}

