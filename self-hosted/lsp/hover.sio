// self-hosted::lsp::hover -- LSP hover information provider for Sounio
//
// Implements type-under-cursor, doc comment extraction, signature help, and
// formatted hover content generation for the Sounio LSP server.  All string
// data is stored in flat i8 buffers with explicit lengths -- no heap allocation,
// no recursive structures, no string interning dependency.
//
// The provider maintains a flat arena of symbol information.  When a hover
// request arrives at (line, col), we search for the symbol whose span contains
// that position, then build a Markdown-formatted hover response from the
// symbol's type, doc comments, effects, and parameter list.
//
// Capacity:
//   - Symbols:     4096
//   - Doc buffer:  512 bytes
//   - Type buffer: 256 bytes
//   - Hover buffer: 1024 bytes
//   - Effects:     16 per symbol
//   - Params:      32 per function
//   - Line index:  65536 lines

// ============================================================================
// Section 1: CONSTANTS
// ============================================================================

let LSPH_MAX_SYMBOLS: i64  = 4096
let LSPH_MAX_DOC_LEN: i64  = 512
let LSPH_MAX_TYPE_LEN: i64 = 256
let LSPH_MAX_EFFECTS: i64  = 16
let LSPH_MAX_PARAMS: i64   = 32
let LSPH_MAX_LINES: i64    = 65536
let LSPH_MAX_HOVER_LEN: i64 = 1024
let LSPH_INVALID: i64      = 0 - 1

// ASCII constants
let LSPH_BYTE_NEWLINE: i8  = 10
let LSPH_BYTE_SPACE: i8    = 32
let LSPH_BYTE_COLON: i8    = 58
let LSPH_BYTE_COMMA: i8    = 44
let LSPH_BYTE_LPAREN: i8   = 40
let LSPH_BYTE_RPAREN: i8   = 41
let LSPH_BYTE_LANGLE: i8   = 60
let LSPH_BYTE_RANGLE: i8   = 62
let LSPH_BYTE_LBRACKET: i8 = 91
let LSPH_BYTE_RBRACKET: i8 = 93
let LSPH_BYTE_AMPERSAND: i8 = 38
let LSPH_BYTE_BANG: i8     = 33
let LSPH_BYTE_DASH: i8     = 45
let LSPH_BYTE_BACKTICK: i8 = 96
let LSPH_BYTE_STAR: i8     = 42
let LSPH_BYTE_ZERO: i8     = 48
let LSPH_BYTE_SEMICOLON: i8 = 59
let LSPH_BYTE_UNDERSCORE: i8 = 95

// Effect hash constants (stable hashes for known effects)
let LSPH_EFFECT_IO: i64    = 1
let LSPH_EFFECT_MUT: i64   = 2
let LSPH_EFFECT_ALLOC: i64 = 3
let LSPH_EFFECT_PANIC: i64 = 4
let LSPH_EFFECT_ASYNC: i64 = 5
let LSPH_EFFECT_GPU: i64   = 6
let LSPH_EFFECT_PROB: i64  = 7
let LSPH_EFFECT_DIV: i64   = 8

// ============================================================================
// Section 2: ENUMS
// ============================================================================

enum LsphSymbolKind {
    SymFunction,
    SymVariable,
    SymType,
    SymField,
    SymModule,
    SymConstant,
    SymParameter,
    SymEffect,
    SymUnknown,
}

enum LsphTypeCategory {
    TcPrimitive,
    TcStruct,
    TcEnum,
    TcFunction,
    TcArray,
    TcRef,
    TcMutRef,
    TcGeneric,
    TcUnit,
    TcNever,
    TcUnknown,
}

enum LsphHoverSection {
    SectionType,
    SectionDoc,
    SectionSignature,
    SectionEffects,
    SectionSource,
}

// ============================================================================
// Section 3: BUFFER STRUCTS
// ============================================================================

struct LsphTypeBuf {
    buf: [i8; 256],
    len: i64,
}

struct LsphDocBuf {
    buf: [i8; 512],
    len: i64,
}

struct LsphHoverBuf {
    buf: [i8; 1024],
    len: i64,
}

struct LsphEffectBuf {
    effects: [i64; 16],
    count: i64,
}

struct LsphParamInfo {
    name_hash: i64,
    type_buf: LsphTypeBuf,
}

// ============================================================================
// Section 4: SYMBOL AND CONTEXT STRUCTS
// ============================================================================

struct LsphSymbolInfo {
    kind: LsphSymbolKind,
    name_hash: i64,
    type_cat: LsphTypeCategory,
    type_buf: LsphTypeBuf,
    doc: LsphDocBuf,
    line: i64,
    col: i64,
    end_line: i64,
    end_col: i64,
    param_count: i64,
    effect_count: i64,
    is_mutable: bool,
    def_line: i64,
}

struct LsphLineIndex {
    line_starts: [i64; 65536],
    line_count: i64,
}

struct LsphContext {
    symbols: [LsphSymbolInfo; 4096],
    sym_count: i64,
    line_index: LsphLineIndex,
    params_buf: [LsphParamInfo; 32],
    effects_buf: LsphEffectBuf,
    hover_result: LsphHoverBuf,
    last_hover_line: i64,
    last_hover_col: i64,
}

// ============================================================================
// Section 5: CONSTRUCTOR FUNCTIONS (helpers must precede callers)
// ============================================================================

fn lsph_type_buf_new() -> LsphTypeBuf {
    LsphTypeBuf {
        buf: [0; 256],
        len: 0,
    }
}

fn lsph_doc_buf_new() -> LsphDocBuf {
    LsphDocBuf {
        buf: [0; 512],
        len: 0,
    }
}

fn lsph_hover_buf_new() -> LsphHoverBuf {
    LsphHoverBuf {
        buf: [0; 1024],
        len: 0,
    }
}

fn lsph_effect_buf_new() -> LsphEffectBuf {
    LsphEffectBuf {
        effects: [0; 16],
        count: 0,
    }
}

fn lsph_param_info_new() -> LsphParamInfo {
    LsphParamInfo {
        name_hash: 0,
        type_buf: lsph_type_buf_new(),
    }
}

fn lsph_symbol_info_new() -> LsphSymbolInfo {
    LsphSymbolInfo {
        kind: LsphSymbolKind::SymUnknown,
        name_hash: 0,
        type_cat: LsphTypeCategory::TcUnknown,
        type_buf: lsph_type_buf_new(),
        doc: lsph_doc_buf_new(),
        line: 0,
        col: 0,
        end_line: 0,
        end_col: 0,
        param_count: 0,
        effect_count: 0,
        is_mutable: false,
        def_line: 0,
    }
}

fn lsph_line_index_new() -> LsphLineIndex {
    LsphLineIndex {
        line_starts: [0; 65536],
        line_count: 0,
    }
}

fn lsph_context_new() -> LsphContext {
    LsphContext {
        symbols: [lsph_symbol_info_new(); 4096],
        sym_count: 0,
        line_index: lsph_line_index_new(),
        params_buf: [lsph_param_info_new(); 32],
        effects_buf: lsph_effect_buf_new(),
        hover_result: lsph_hover_buf_new(),
        last_hover_line: 0,
        last_hover_col: 0,
    }
}

// ============================================================================
// Section 6: TYPE BUFFER OPERATIONS
// ============================================================================

// Append a single byte to a type buffer.
fn lsph_type_buf_append_byte(buf: &! LsphTypeBuf, b: i8) with Mut, Div, Panic {
    if buf.len < LSPH_MAX_TYPE_LEN {
        buf.buf[buf.len as usize] = b
        buf.len = buf.len + 1
    }
}

// Append contents of one type buffer to another.
fn lsph_type_buf_append_str(dst: &! LsphTypeBuf, src: &LsphTypeBuf) with Mut, Div, Panic {
    var i: i64 = 0
    while i < src.len {
        if dst.len < LSPH_MAX_TYPE_LEN {
            dst.buf[dst.len as usize] = src.buf[i as usize]
            dst.len = dst.len + 1
        }
        i = i + 1
    }
}

// Append a decimal representation of an i64 to a type buffer.
fn lsph_type_buf_append_i64(buf: &! LsphTypeBuf, val: i64) with Mut, Div, Panic {
    if val == 0 {
        lsph_type_buf_append_byte(buf, LSPH_BYTE_ZERO)
        return
    }

    var n = val
    if n < 0 {
        lsph_type_buf_append_byte(buf, LSPH_BYTE_DASH)
        n = 0 - n
    }

    // Extract digits into a temporary buffer (max 20 digits for i64)
    var digits: [i8; 24] = [0; 24]
    var dlen: i64 = 0
    while n > 0 && dlen < 24 {
        let d = n - (n / 10) * 10
        digits[dlen as usize] = (d + 48) as i8
        n = n / 10
        dlen = dlen + 1
    }

    // Emit digits in reverse order (most significant first)
    var i = dlen - 1
    while i >= 0 {
        lsph_type_buf_append_byte(buf, digits[i as usize])
        i = i - 1
    }
}

// Compare two type buffers for equality.
fn lsph_type_buf_eq(a: &LsphTypeBuf, b: &LsphTypeBuf) -> bool with Mut, Div, Panic {
    if a.len != b.len {
        return false
    }
    var i: i64 = 0
    while i < a.len {
        if a.buf[i as usize] != b.buf[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

// Return the length of a type buffer.
fn lsph_type_buf_len(buf: &LsphTypeBuf) -> i64 {
    buf.len
}

// Clear a type buffer.
fn lsph_type_buf_clear(buf: &! LsphTypeBuf) with Mut {
    buf.len = 0
}

// Check if a type buffer is empty.
fn lsph_type_buf_is_empty(buf: &LsphTypeBuf) -> bool {
    buf.len == 0
}

// Copy a type buffer.
fn lsph_type_buf_copy(src: &LsphTypeBuf) -> LsphTypeBuf with Mut, Div, Panic {
    var dst = lsph_type_buf_new()
    var i: i64 = 0
    while i < src.len {
        dst.buf[i as usize] = src.buf[i as usize]
        i = i + 1
    }
    dst.len = src.len
    dst
}

// Build a type buffer from a series of known ASCII bytes representing a string.
// This is a helper used internally to write fixed strings like "i32", "bool", etc.
fn lsph_type_buf_from_bytes_4(b0: i8, b1: i8, b2: i8, b3: i8) -> LsphTypeBuf with Mut, Div, Panic {
    var buf = lsph_type_buf_new()
    lsph_type_buf_append_byte(&! buf, b0)
    lsph_type_buf_append_byte(&! buf, b1)
    lsph_type_buf_append_byte(&! buf, b2)
    lsph_type_buf_append_byte(&! buf, b3)
    buf
}

fn lsph_type_buf_from_bytes_3(b0: i8, b1: i8, b2: i8) -> LsphTypeBuf with Mut, Div, Panic {
    var buf = lsph_type_buf_new()
    lsph_type_buf_append_byte(&! buf, b0)
    lsph_type_buf_append_byte(&! buf, b1)
    lsph_type_buf_append_byte(&! buf, b2)
    buf
}

// ============================================================================
// Section 7: DOC BUFFER OPERATIONS
// ============================================================================

// Append a single byte to a doc buffer.
fn lsph_doc_buf_append_byte(buf: &! LsphDocBuf, b: i8) with Mut, Div, Panic {
    if buf.len < LSPH_MAX_DOC_LEN {
        buf.buf[buf.len as usize] = b
        buf.len = buf.len + 1
    }
}

// Append contents of a type buffer to a doc buffer.
fn lsph_doc_buf_append_type(dst: &! LsphDocBuf, src: &LsphTypeBuf) with Mut, Div, Panic {
    var i: i64 = 0
    while i < src.len {
        if dst.len < LSPH_MAX_DOC_LEN {
            dst.buf[dst.len as usize] = src.buf[i as usize]
            dst.len = dst.len + 1
        }
        i = i + 1
    }
}

// Compare two doc buffers for equality.
fn lsph_doc_buf_eq(a: &LsphDocBuf, b: &LsphDocBuf) -> bool with Mut, Div, Panic {
    if a.len != b.len {
        return false
    }
    var i: i64 = 0
    while i < a.len {
        if a.buf[i as usize] != b.buf[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

// Return the length of a doc buffer.
fn lsph_doc_buf_len(buf: &LsphDocBuf) -> i64 {
    buf.len
}

// Clear a doc buffer.
fn lsph_doc_buf_clear(buf: &! LsphDocBuf) with Mut {
    buf.len = 0
}

// Check if a doc buffer is empty.
fn lsph_doc_buf_is_empty(buf: &LsphDocBuf) -> bool {
    buf.len == 0
}

// Copy a doc buffer.
fn lsph_doc_buf_copy(src: &LsphDocBuf) -> LsphDocBuf with Mut, Div, Panic {
    var dst = lsph_doc_buf_new()
    var i: i64 = 0
    while i < src.len {
        dst.buf[i as usize] = src.buf[i as usize]
        i = i + 1
    }
    dst.len = src.len
    dst
}

// ============================================================================
// Section 8: HOVER BUFFER OPERATIONS
// ============================================================================

// Append a single byte to a hover buffer.
fn lsph_hover_buf_append_byte(buf: &! LsphHoverBuf, b: i8) with Mut, Div, Panic {
    if buf.len < LSPH_MAX_HOVER_LEN {
        buf.buf[buf.len as usize] = b
        buf.len = buf.len + 1
    }
}

// Append contents of a type buffer to a hover buffer.
fn lsph_hover_buf_append_type(dst: &! LsphHoverBuf, src: &LsphTypeBuf) with Mut, Div, Panic {
    var i: i64 = 0
    while i < src.len {
        if dst.len < LSPH_MAX_HOVER_LEN {
            dst.buf[dst.len as usize] = src.buf[i as usize]
            dst.len = dst.len + 1
        }
        i = i + 1
    }
}

// Append contents of a doc buffer to a hover buffer.
fn lsph_hover_buf_append_doc(dst: &! LsphHoverBuf, src: &LsphDocBuf) with Mut, Div, Panic {
    var i: i64 = 0
    while i < src.len {
        if dst.len < LSPH_MAX_HOVER_LEN {
            dst.buf[dst.len as usize] = src.buf[i as usize]
            dst.len = dst.len + 1
        }
        i = i + 1
    }
}

// Append a newline to a hover buffer.
fn lsph_hover_buf_append_newline(buf: &! LsphHoverBuf) with Mut, Div, Panic {
    lsph_hover_buf_append_byte(buf, LSPH_BYTE_NEWLINE)
}

// Append a space to a hover buffer.
fn lsph_hover_buf_append_space(buf: &! LsphHoverBuf) with Mut, Div, Panic {
    lsph_hover_buf_append_byte(buf, LSPH_BYTE_SPACE)
}

// Append contents of one hover buffer to another.
fn lsph_hover_buf_append_hover(dst: &! LsphHoverBuf, src: &LsphHoverBuf) with Mut, Div, Panic {
    var i: i64 = 0
    while i < src.len {
        if dst.len < LSPH_MAX_HOVER_LEN {
            dst.buf[dst.len as usize] = src.buf[i as usize]
            dst.len = dst.len + 1
        }
        i = i + 1
    }
}

// Append a decimal i64 to a hover buffer.
fn lsph_hover_buf_append_i64(buf: &! LsphHoverBuf, val: i64) with Mut, Div, Panic {
    if val == 0 {
        lsph_hover_buf_append_byte(buf, LSPH_BYTE_ZERO)
        return
    }

    var n = val
    if n < 0 {
        lsph_hover_buf_append_byte(buf, LSPH_BYTE_DASH)
        n = 0 - n
    }

    var digits: [i8; 24] = [0; 24]
    var dlen: i64 = 0
    while n > 0 && dlen < 24 {
        let d = n - (n / 10) * 10
        digits[dlen as usize] = (d + 48) as i8
        n = n / 10
        dlen = dlen + 1
    }

    var i = dlen - 1
    while i >= 0 {
        lsph_hover_buf_append_byte(buf, digits[i as usize])
        i = i - 1
    }
}

// Return the length of a hover buffer.
fn lsph_hover_buf_len(buf: &LsphHoverBuf) -> i64 {
    buf.len
}

// Clear a hover buffer.
fn lsph_hover_buf_clear(buf: &! LsphHoverBuf) with Mut {
    buf.len = 0
}

// Check if a hover buffer is empty.
fn lsph_hover_buf_is_empty(buf: &LsphHoverBuf) -> bool {
    buf.len == 0
}

// Compare two hover buffers for equality.
fn lsph_hover_buf_eq(a: &LsphHoverBuf, b: &LsphHoverBuf) -> bool with Mut, Div, Panic {
    if a.len != b.len {
        return false
    }
    var i: i64 = 0
    while i < a.len {
        if a.buf[i as usize] != b.buf[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

// Append markdown code fence opener: ```sio\n
fn lsph_hover_buf_append_code_fence_open(buf: &! LsphHoverBuf) with Mut, Div, Panic {
    lsph_hover_buf_append_byte(buf, LSPH_BYTE_BACKTICK)
    lsph_hover_buf_append_byte(buf, LSPH_BYTE_BACKTICK)
    lsph_hover_buf_append_byte(buf, LSPH_BYTE_BACKTICK)
    // 's'
    lsph_hover_buf_append_byte(buf, 115)
    // 'i'
    lsph_hover_buf_append_byte(buf, 105)
    // 'o'
    lsph_hover_buf_append_byte(buf, 111)
    lsph_hover_buf_append_newline(buf)
}

// Append markdown code fence closer: ```\n
fn lsph_hover_buf_append_code_fence_close(buf: &! LsphHoverBuf) with Mut, Div, Panic {
    lsph_hover_buf_append_byte(buf, LSPH_BYTE_BACKTICK)
    lsph_hover_buf_append_byte(buf, LSPH_BYTE_BACKTICK)
    lsph_hover_buf_append_byte(buf, LSPH_BYTE_BACKTICK)
    lsph_hover_buf_append_newline(buf)
}

// Append a horizontal rule: ---\n
fn lsph_hover_buf_append_hr(buf: &! LsphHoverBuf) with Mut, Div, Panic {
    lsph_hover_buf_append_byte(buf, LSPH_BYTE_DASH)
    lsph_hover_buf_append_byte(buf, LSPH_BYTE_DASH)
    lsph_hover_buf_append_byte(buf, LSPH_BYTE_DASH)
    lsph_hover_buf_append_newline(buf)
}

// ============================================================================
// Section 9: EFFECT BUFFER OPERATIONS
// ============================================================================

// Add an effect to the effect buffer.
fn lsph_effect_buf_add(buf: &! LsphEffectBuf, effect: i64) with Mut, Div, Panic {
    if buf.count < LSPH_MAX_EFFECTS {
        buf.effects[buf.count as usize] = effect
        buf.count = buf.count + 1
    }
}

// Check if an effect buffer contains a given effect.
fn lsph_effect_buf_contains(buf: &LsphEffectBuf, effect: i64) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    while i < buf.count {
        if buf.effects[i as usize] == effect {
            return true
        }
        i = i + 1
    }
    false
}

// Return the count of effects.
fn lsph_effect_buf_count(buf: &LsphEffectBuf) -> i64 {
    buf.count
}

// Clear the effect buffer.
fn lsph_effect_buf_clear(buf: &! LsphEffectBuf) with Mut {
    buf.count = 0
}

// Compare two effect buffers for equality (order-sensitive).
fn lsph_effect_buf_eq(a: &LsphEffectBuf, b: &LsphEffectBuf) -> bool with Mut, Div, Panic {
    if a.count != b.count {
        return false
    }
    var i: i64 = 0
    while i < a.count {
        if a.effects[i as usize] != b.effects[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

// Copy an effect buffer.
fn lsph_effect_buf_copy(src: &LsphEffectBuf) -> LsphEffectBuf with Mut, Div, Panic {
    var dst = lsph_effect_buf_new()
    var i: i64 = 0
    while i < src.count {
        dst.effects[i as usize] = src.effects[i as usize]
        i = i + 1
    }
    dst.count = src.count
    dst
}

// ============================================================================
// Section 10: SYMBOL MANAGEMENT
// ============================================================================

// Add a new symbol to the context. Returns the symbol index, or LSPH_INVALID
// if the arena is full.
fn lsph_add_symbol(ctx: &! LsphContext, kind: LsphSymbolKind, name_hash: i64,
                    line: i64, col: i64, end_line: i64, end_col: i64) -> i64
    with Mut, Div, Panic
{
    if ctx.sym_count >= LSPH_MAX_SYMBOLS {
        return LSPH_INVALID
    }
    let idx = ctx.sym_count
    ctx.symbols[idx as usize].kind = kind
    ctx.symbols[idx as usize].name_hash = name_hash
    ctx.symbols[idx as usize].type_cat = LsphTypeCategory::TcUnknown
    ctx.symbols[idx as usize].type_buf = lsph_type_buf_new()
    ctx.symbols[idx as usize].doc = lsph_doc_buf_new()
    ctx.symbols[idx as usize].line = line
    ctx.symbols[idx as usize].col = col
    ctx.symbols[idx as usize].end_line = end_line
    ctx.symbols[idx as usize].end_col = end_col
    ctx.symbols[idx as usize].param_count = 0
    ctx.symbols[idx as usize].effect_count = 0
    ctx.symbols[idx as usize].is_mutable = false
    ctx.symbols[idx as usize].def_line = line
    ctx.sym_count = ctx.sym_count + 1
    idx
}

// Set the type information for a symbol.
fn lsph_set_symbol_type(ctx: &! LsphContext, sym_id: i64, cat: LsphTypeCategory,
                         type_str: &LsphTypeBuf)
    with Mut, Div, Panic
{
    if sym_id < 0 || sym_id >= ctx.sym_count {
        return
    }
    ctx.symbols[sym_id as usize].type_cat = cat
    // Copy type buffer contents
    var i: i64 = 0
    while i < type_str.len && i < LSPH_MAX_TYPE_LEN {
        ctx.symbols[sym_id as usize].type_buf.buf[i as usize] = type_str.buf[i as usize]
        i = i + 1
    }
    ctx.symbols[sym_id as usize].type_buf.len = type_str.len
}

// Set the documentation for a symbol.
fn lsph_set_symbol_doc(ctx: &! LsphContext, sym_id: i64, doc: &LsphDocBuf)
    with Mut, Div, Panic
{
    if sym_id < 0 || sym_id >= ctx.sym_count {
        return
    }
    var i: i64 = 0
    while i < doc.len && i < LSPH_MAX_DOC_LEN {
        ctx.symbols[sym_id as usize].doc.buf[i as usize] = doc.buf[i as usize]
        i = i + 1
    }
    ctx.symbols[sym_id as usize].doc.len = doc.len
}

// Set the effects for a symbol by copying from an effect buffer.
fn lsph_set_symbol_effects(ctx: &! LsphContext, sym_id: i64, effects: &LsphEffectBuf)
    with Mut, Div, Panic
{
    if sym_id < 0 || sym_id >= ctx.sym_count {
        return
    }
    ctx.symbols[sym_id as usize].effect_count = effects.count
}

// Set the parameter count for a symbol.
fn lsph_set_symbol_param_count(ctx: &! LsphContext, sym_id: i64, count: i64)
    with Mut, Div, Panic
{
    if sym_id < 0 || sym_id >= ctx.sym_count {
        return
    }
    ctx.symbols[sym_id as usize].param_count = count
}

// Set the mutability flag for a symbol.
fn lsph_set_symbol_mutable(ctx: &! LsphContext, sym_id: i64, is_mutable: bool)
    with Mut, Div, Panic
{
    if sym_id < 0 || sym_id >= ctx.sym_count {
        return
    }
    ctx.symbols[sym_id as usize].is_mutable = is_mutable
}

// Set the definition line for a symbol.
fn lsph_set_symbol_def_line(ctx: &! LsphContext, sym_id: i64, def_line: i64)
    with Mut, Div, Panic
{
    if sym_id < 0 || sym_id >= ctx.sym_count {
        return
    }
    ctx.symbols[sym_id as usize].def_line = def_line
}

// Get a reference to a symbol by index.
fn lsph_get_symbol_kind(ctx: &LsphContext, sym_id: i64) -> LsphSymbolKind with Div, Panic {
    if sym_id < 0 || sym_id >= ctx.sym_count {
        return LsphSymbolKind::SymUnknown
    }
    ctx.symbols[sym_id as usize].kind
}

// Get the name hash of a symbol.
fn lsph_get_symbol_name_hash(ctx: &LsphContext, sym_id: i64) -> i64 with Div, Panic {
    if sym_id < 0 || sym_id >= ctx.sym_count {
        return 0
    }
    ctx.symbols[sym_id as usize].name_hash
}

// Get the type category of a symbol.
fn lsph_get_symbol_type_cat(ctx: &LsphContext, sym_id: i64) -> LsphTypeCategory with Div, Panic {
    if sym_id < 0 || sym_id >= ctx.sym_count {
        return LsphTypeCategory::TcUnknown
    }
    ctx.symbols[sym_id as usize].type_cat
}

// Get the line of a symbol.
fn lsph_get_symbol_line(ctx: &LsphContext, sym_id: i64) -> i64 with Div, Panic {
    if sym_id < 0 || sym_id >= ctx.sym_count {
        return LSPH_INVALID
    }
    ctx.symbols[sym_id as usize].line
}

// Get the column of a symbol.
fn lsph_get_symbol_col(ctx: &LsphContext, sym_id: i64) -> i64 with Div, Panic {
    if sym_id < 0 || sym_id >= ctx.sym_count {
        return LSPH_INVALID
    }
    ctx.symbols[sym_id as usize].col
}

// Check if a symbol is mutable.
fn lsph_get_symbol_is_mutable(ctx: &LsphContext, sym_id: i64) -> bool with Div, Panic {
    if sym_id < 0 || sym_id >= ctx.sym_count {
        return false
    }
    ctx.symbols[sym_id as usize].is_mutable
}

// Get the param count of a symbol.
fn lsph_get_symbol_param_count(ctx: &LsphContext, sym_id: i64) -> i64 with Div, Panic {
    if sym_id < 0 || sym_id >= ctx.sym_count {
        return 0
    }
    ctx.symbols[sym_id as usize].param_count
}

// Get the effect count of a symbol.
fn lsph_get_symbol_effect_count(ctx: &LsphContext, sym_id: i64) -> i64 with Div, Panic {
    if sym_id < 0 || sym_id >= ctx.sym_count {
        return 0
    }
    ctx.symbols[sym_id as usize].effect_count
}

// ============================================================================
// Section 11: SYMBOL SEARCH
// ============================================================================

// Check if a position (line, col) falls within a symbol's span.
fn lsph_position_in_span(sym_line: i64, sym_col: i64,
                          sym_end_line: i64, sym_end_col: i64,
                          line: i64, col: i64) -> bool
{
    // Before start?
    if line < sym_line {
        return false
    }
    if line == sym_line && col < sym_col {
        return false
    }
    // After end?
    if line > sym_end_line {
        return false
    }
    if line == sym_end_line && col > sym_end_col {
        return false
    }
    true
}

// Find the symbol at a given (line, col) position.
// Returns the symbol index, or LSPH_INVALID if none found.
// When multiple symbols overlap, returns the innermost (smallest span).
fn lsph_find_symbol_at(ctx: &LsphContext, line: i64, col: i64) -> i64 with Mut, Div, Panic {
    var best_id: i64 = LSPH_INVALID
    var best_span: i64 = 0 - 1  // will be set on first match

    var i: i64 = 0
    while i < ctx.sym_count {
        let sym = ctx.symbols[i as usize]
        let in_span = lsph_position_in_span(sym.line, sym.col,
                                              sym.end_line, sym.end_col,
                                              line, col)
        if in_span {
            // Compute span size: (end_line - line) * 1000 + (end_col - col)
            let span_size = (sym.end_line - sym.line) * 1000 + (sym.end_col - sym.col)
            if best_id == LSPH_INVALID || span_size < best_span {
                best_id = i
                best_span = span_size
            }
        }
        i = i + 1
    }
    best_id
}

// Find a symbol by name hash.  Returns the first match, or LSPH_INVALID.
fn lsph_find_symbol_by_hash(ctx: &LsphContext, name_hash: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.sym_count {
        if ctx.symbols[i as usize].name_hash == name_hash {
            return i
        }
        i = i + 1
    }
    LSPH_INVALID
}

// Find the symbol at a line (first symbol starting on that line).
fn lsph_find_symbol_on_line(ctx: &LsphContext, line: i64) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.sym_count {
        if ctx.symbols[i as usize].line == line {
            return i
        }
        i = i + 1
    }
    LSPH_INVALID
}

// Count symbols of a given kind.
fn lsph_count_symbols_of_kind(ctx: &LsphContext, kind: LsphSymbolKind) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.sym_count {
        let sym_kind = ctx.symbols[i as usize].kind
        let matches = match sym_kind {
            LsphSymbolKind::SymFunction => match kind {
                LsphSymbolKind::SymFunction => true,
                _ => false,
            },
            LsphSymbolKind::SymVariable => match kind {
                LsphSymbolKind::SymVariable => true,
                _ => false,
            },
            LsphSymbolKind::SymType => match kind {
                LsphSymbolKind::SymType => true,
                _ => false,
            },
            LsphSymbolKind::SymField => match kind {
                LsphSymbolKind::SymField => true,
                _ => false,
            },
            LsphSymbolKind::SymModule => match kind {
                LsphSymbolKind::SymModule => true,
                _ => false,
            },
            LsphSymbolKind::SymConstant => match kind {
                LsphSymbolKind::SymConstant => true,
                _ => false,
            },
            LsphSymbolKind::SymParameter => match kind {
                LsphSymbolKind::SymParameter => true,
                _ => false,
            },
            LsphSymbolKind::SymEffect => match kind {
                LsphSymbolKind::SymEffect => true,
                _ => false,
            },
            LsphSymbolKind::SymUnknown => match kind {
                LsphSymbolKind::SymUnknown => true,
                _ => false,
            },
        }
        if matches {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// ============================================================================
// Section 12: LINE INDEX
// ============================================================================

// Build a line index from source bytes.  Each entry in line_starts is the
// byte offset at which a line begins.  Line 0 starts at offset 0.
fn lsph_build_line_index(ctx: &! LsphContext, source_bytes: &[i64; 4096], source_len: i64)
    with Mut, Div, Panic
{
    // Line 0 always starts at offset 0
    ctx.line_index.line_starts[0] = 0
    ctx.line_index.line_count = 1

    var i: i64 = 0
    while i < source_len && i < 4096 {
        if source_bytes[i as usize] == 10 && ctx.line_index.line_count < LSPH_MAX_LINES {
            // The next line starts at i + 1
            let lc = ctx.line_index.line_count
            ctx.line_index.line_starts[lc as usize] = i + 1
            ctx.line_index.line_count = ctx.line_index.line_count + 1
        }
        i = i + 1
    }
}

// Convert a (line, col) to a byte offset using the line index.
// Returns LSPH_INVALID if the line is out of range.
fn lsph_line_col_to_offset(ctx: &LsphContext, line: i64, col: i64) -> i64 with Div, Panic {
    if line < 0 || line >= ctx.line_index.line_count {
        return LSPH_INVALID
    }
    ctx.line_index.line_starts[line as usize] + col
}

// Convert a byte offset to a line number.  Uses linear scan.
// Returns the line number (0-based), or LSPH_INVALID.
fn lsph_offset_to_line(ctx: &LsphContext, offset: i64) -> i64 with Mut, Div, Panic {
    if ctx.line_index.line_count == 0 {
        return LSPH_INVALID
    }
    var i: i64 = ctx.line_index.line_count - 1
    while i >= 0 {
        if ctx.line_index.line_starts[i as usize] <= offset {
            return i
        }
        i = i - 1
    }
    0
}

// Convert a byte offset to a column number within its line.
fn lsph_offset_to_col(ctx: &LsphContext, offset: i64) -> i64 with Mut, Div, Panic {
    let line = lsph_offset_to_line(ctx, offset)
    if line == LSPH_INVALID {
        return 0
    }
    offset - ctx.line_index.line_starts[line as usize]
}

// Get the number of lines in the index.
fn lsph_line_count(ctx: &LsphContext) -> i64 {
    ctx.line_index.line_count
}

// Get the start offset of a specific line.
fn lsph_line_start(ctx: &LsphContext, line: i64) -> i64 with Div, Panic {
    if line < 0 || line >= ctx.line_index.line_count {
        return LSPH_INVALID
    }
    ctx.line_index.line_starts[line as usize]
}

// Get the length of a line (distance from this line's start to the next line's start).
fn lsph_line_length(ctx: &LsphContext, line: i64) -> i64 with Div, Panic {
    if line < 0 || line >= ctx.line_index.line_count {
        return 0
    }
    if line + 1 < ctx.line_index.line_count {
        return ctx.line_index.line_starts[(line + 1) as usize] - ctx.line_index.line_starts[line as usize]
    }
    // Last line: unknown length, return a sentinel
    0
}

// ============================================================================
// Section 13: DOC COMMENT EXTRACTION
// ============================================================================

// Extract doc comments from source bytes preceding a definition line.
// Doc comments are lines starting with // immediately before def_line.
// Returns a LsphDocBuf containing the concatenated doc text.
fn lsph_extract_doc_comment(source: &[i64; 4096], len: i64, def_line: i64) -> LsphDocBuf
    with Mut, Div, Panic
{
    var doc = lsph_doc_buf_new()

    // Find where def_line starts by scanning for newlines
    // Count lines from the beginning
    var line_starts: [i64; 256] = [0; 256]
    var line_count: i64 = 1
    line_starts[0] = 0

    var i: i64 = 0
    while i < len && i < 4096 && line_count < 256 {
        if source[i as usize] == 10 {
            line_starts[line_count as usize] = i + 1
            line_count = line_count + 1
        }
        i = i + 1
    }

    // Now scan backward from def_line looking for comment lines
    // A comment line starts with optional whitespace followed by //
    var scan_line = def_line - 1
    var doc_start_line: i64 = def_line

    while scan_line >= 0 && scan_line < line_count {
        let ls = line_starts[scan_line as usize]
        // Skip whitespace
        var pos = ls
        while pos < len && pos < 4096 {
            let b = source[pos as usize]
            if b != 32 && b != 9 {
                // Not space or tab
                break
            }
            pos = pos + 1
        }
        // Check for //
        if pos + 1 < len && pos + 1 < 4096 {
            let b0 = source[pos as usize]
            let b1 = source[(pos + 1) as usize]
            if b0 == 47 && b1 == 47 {
                // It is a comment line
                doc_start_line = scan_line
                scan_line = scan_line - 1
            } else {
                // Not a comment, stop
                break
            }
        } else {
            break
        }
    }

    // Now copy the comment text from doc_start_line to def_line - 1
    var cl = doc_start_line
    while cl < def_line && cl < line_count {
        let ls = line_starts[cl as usize]
        // Skip whitespace
        var pos = ls
        while pos < len && pos < 4096 {
            let b = source[pos as usize]
            if b != 32 && b != 9 {
                break
            }
            pos = pos + 1
        }
        // Skip //
        if pos + 1 < len && pos + 1 < 4096 {
            let b0 = source[pos as usize]
            let b1 = source[(pos + 1) as usize]
            if b0 == 47 && b1 == 47 {
                pos = pos + 2
                // Skip optional space after //
                if pos < len && pos < 4096 {
                    if source[pos as usize] == 32 {
                        pos = pos + 1
                    }
                }
            }
        }
        // Copy remaining bytes of this line to doc buffer
        while pos < len && pos < 4096 {
            let b = source[pos as usize]
            if b == 10 {
                break
            }
            lsph_doc_buf_append_byte(&! doc, b as i8)
            pos = pos + 1
        }
        // Add newline between doc lines (but not after the last)
        if cl + 1 < def_line {
            lsph_doc_buf_append_byte(&! doc, LSPH_BYTE_NEWLINE)
        }
        cl = cl + 1
    }

    doc
}

// ============================================================================
// Section 14: TYPE CATEGORY FORMATTING
// ============================================================================

// Format a type category as a human-readable string in a type buffer.
fn lsph_format_type_category(cat: LsphTypeCategory) -> LsphTypeBuf with Mut, Div, Panic {
    var buf = lsph_type_buf_new()
    match cat {
        LsphTypeCategory::TcPrimitive => {
            // "primitive"
            lsph_type_buf_append_byte(&! buf, 112) // p
            lsph_type_buf_append_byte(&! buf, 114) // r
            lsph_type_buf_append_byte(&! buf, 105) // i
            lsph_type_buf_append_byte(&! buf, 109) // m
            lsph_type_buf_append_byte(&! buf, 105) // i
            lsph_type_buf_append_byte(&! buf, 116) // t
            lsph_type_buf_append_byte(&! buf, 105) // i
            lsph_type_buf_append_byte(&! buf, 118) // v
            lsph_type_buf_append_byte(&! buf, 101) // e
        },
        LsphTypeCategory::TcStruct => {
            // "struct"
            lsph_type_buf_append_byte(&! buf, 115) // s
            lsph_type_buf_append_byte(&! buf, 116) // t
            lsph_type_buf_append_byte(&! buf, 114) // r
            lsph_type_buf_append_byte(&! buf, 117) // u
            lsph_type_buf_append_byte(&! buf, 99)  // c
            lsph_type_buf_append_byte(&! buf, 116) // t
        },
        LsphTypeCategory::TcEnum => {
            // "enum"
            lsph_type_buf_append_byte(&! buf, 101) // e
            lsph_type_buf_append_byte(&! buf, 110) // n
            lsph_type_buf_append_byte(&! buf, 117) // u
            lsph_type_buf_append_byte(&! buf, 109) // m
        },
        LsphTypeCategory::TcFunction => {
            // "function"
            lsph_type_buf_append_byte(&! buf, 102) // f
            lsph_type_buf_append_byte(&! buf, 117) // u
            lsph_type_buf_append_byte(&! buf, 110) // n
            lsph_type_buf_append_byte(&! buf, 99)  // c
            lsph_type_buf_append_byte(&! buf, 116) // t
            lsph_type_buf_append_byte(&! buf, 105) // i
            lsph_type_buf_append_byte(&! buf, 111) // o
            lsph_type_buf_append_byte(&! buf, 110) // n
        },
        LsphTypeCategory::TcArray => {
            // "array"
            lsph_type_buf_append_byte(&! buf, 97)  // a
            lsph_type_buf_append_byte(&! buf, 114) // r
            lsph_type_buf_append_byte(&! buf, 114) // r
            lsph_type_buf_append_byte(&! buf, 97)  // a
            lsph_type_buf_append_byte(&! buf, 121) // y
        },
        LsphTypeCategory::TcRef => {
            // "&T"
            lsph_type_buf_append_byte(&! buf, LSPH_BYTE_AMPERSAND)
            lsph_type_buf_append_byte(&! buf, 84)  // T
        },
        LsphTypeCategory::TcMutRef => {
            // "&!T"
            lsph_type_buf_append_byte(&! buf, LSPH_BYTE_AMPERSAND)
            lsph_type_buf_append_byte(&! buf, LSPH_BYTE_BANG)
            lsph_type_buf_append_byte(&! buf, 84)  // T
        },
        LsphTypeCategory::TcGeneric => {
            // "generic"
            lsph_type_buf_append_byte(&! buf, 103) // g
            lsph_type_buf_append_byte(&! buf, 101) // e
            lsph_type_buf_append_byte(&! buf, 110) // n
            lsph_type_buf_append_byte(&! buf, 101) // e
            lsph_type_buf_append_byte(&! buf, 114) // r
            lsph_type_buf_append_byte(&! buf, 105) // i
            lsph_type_buf_append_byte(&! buf, 99)  // c
        },
        LsphTypeCategory::TcUnit => {
            // "()"
            lsph_type_buf_append_byte(&! buf, LSPH_BYTE_LPAREN)
            lsph_type_buf_append_byte(&! buf, LSPH_BYTE_RPAREN)
        },
        LsphTypeCategory::TcNever => {
            // "!"
            lsph_type_buf_append_byte(&! buf, LSPH_BYTE_BANG)
        },
        LsphTypeCategory::TcUnknown => {
            // "unknown"
            lsph_type_buf_append_byte(&! buf, 117) // u
            lsph_type_buf_append_byte(&! buf, 110) // n
            lsph_type_buf_append_byte(&! buf, 107) // k
            lsph_type_buf_append_byte(&! buf, 110) // n
            lsph_type_buf_append_byte(&! buf, 111) // o
            lsph_type_buf_append_byte(&! buf, 119) // w
            lsph_type_buf_append_byte(&! buf, 110) // n
        },
    }
    buf
}

// Format a symbol kind as a human-readable string.
fn lsph_format_symbol_kind(kind: LsphSymbolKind) -> LsphTypeBuf with Mut, Div, Panic {
    var buf = lsph_type_buf_new()
    match kind {
        LsphSymbolKind::SymFunction => {
            // "fn"
            lsph_type_buf_append_byte(&! buf, 102) // f
            lsph_type_buf_append_byte(&! buf, 110) // n
        },
        LsphSymbolKind::SymVariable => {
            // "var"
            lsph_type_buf_append_byte(&! buf, 118) // v
            lsph_type_buf_append_byte(&! buf, 97)  // a
            lsph_type_buf_append_byte(&! buf, 114) // r
        },
        LsphSymbolKind::SymType => {
            // "type"
            lsph_type_buf_append_byte(&! buf, 116) // t
            lsph_type_buf_append_byte(&! buf, 121) // y
            lsph_type_buf_append_byte(&! buf, 112) // p
            lsph_type_buf_append_byte(&! buf, 101) // e
        },
        LsphSymbolKind::SymField => {
            // "field"
            lsph_type_buf_append_byte(&! buf, 102) // f
            lsph_type_buf_append_byte(&! buf, 105) // i
            lsph_type_buf_append_byte(&! buf, 101) // e
            lsph_type_buf_append_byte(&! buf, 108) // l
            lsph_type_buf_append_byte(&! buf, 100) // d
        },
        LsphSymbolKind::SymModule => {
            // "module"
            lsph_type_buf_append_byte(&! buf, 109) // m
            lsph_type_buf_append_byte(&! buf, 111) // o
            lsph_type_buf_append_byte(&! buf, 100) // d
            lsph_type_buf_append_byte(&! buf, 117) // u
            lsph_type_buf_append_byte(&! buf, 108) // l
            lsph_type_buf_append_byte(&! buf, 101) // e
        },
        LsphSymbolKind::SymConstant => {
            // "const"
            lsph_type_buf_append_byte(&! buf, 99)  // c
            lsph_type_buf_append_byte(&! buf, 111) // o
            lsph_type_buf_append_byte(&! buf, 110) // n
            lsph_type_buf_append_byte(&! buf, 115) // s
            lsph_type_buf_append_byte(&! buf, 116) // t
        },
        LsphSymbolKind::SymParameter => {
            // "param"
            lsph_type_buf_append_byte(&! buf, 112) // p
            lsph_type_buf_append_byte(&! buf, 97)  // a
            lsph_type_buf_append_byte(&! buf, 114) // r
            lsph_type_buf_append_byte(&! buf, 97)  // a
            lsph_type_buf_append_byte(&! buf, 109) // m
        },
        LsphSymbolKind::SymEffect => {
            // "effect"
            lsph_type_buf_append_byte(&! buf, 101) // e
            lsph_type_buf_append_byte(&! buf, 102) // f
            lsph_type_buf_append_byte(&! buf, 102) // f
            lsph_type_buf_append_byte(&! buf, 101) // e
            lsph_type_buf_append_byte(&! buf, 99)  // c
            lsph_type_buf_append_byte(&! buf, 116) // t
        },
        LsphSymbolKind::SymUnknown => {
            // "unknown"
            lsph_type_buf_append_byte(&! buf, 117) // u
            lsph_type_buf_append_byte(&! buf, 110) // n
            lsph_type_buf_append_byte(&! buf, 107) // k
            lsph_type_buf_append_byte(&! buf, 110) // n
            lsph_type_buf_append_byte(&! buf, 111) // o
            lsph_type_buf_append_byte(&! buf, 119) // w
            lsph_type_buf_append_byte(&! buf, 110) // n
        },
    }
    buf
}

// Format an effect ID as a human-readable string.
fn lsph_format_effect(effect_id: i64) -> LsphTypeBuf with Mut, Div, Panic {
    var buf = lsph_type_buf_new()
    if effect_id == LSPH_EFFECT_IO {
        // "IO"
        lsph_type_buf_append_byte(&! buf, 73)  // I
        lsph_type_buf_append_byte(&! buf, 79)  // O
    } else if effect_id == LSPH_EFFECT_MUT {
        // "Mut"
        lsph_type_buf_append_byte(&! buf, 77)  // M
        lsph_type_buf_append_byte(&! buf, 117) // u
        lsph_type_buf_append_byte(&! buf, 116) // t
    } else if effect_id == LSPH_EFFECT_ALLOC {
        // "Alloc"
        lsph_type_buf_append_byte(&! buf, 65)  // A
        lsph_type_buf_append_byte(&! buf, 108) // l
        lsph_type_buf_append_byte(&! buf, 108) // l
        lsph_type_buf_append_byte(&! buf, 111) // o
        lsph_type_buf_append_byte(&! buf, 99)  // c
    } else if effect_id == LSPH_EFFECT_PANIC {
        // "Panic"
        lsph_type_buf_append_byte(&! buf, 80)  // P
        lsph_type_buf_append_byte(&! buf, 97)  // a
        lsph_type_buf_append_byte(&! buf, 110) // n
        lsph_type_buf_append_byte(&! buf, 105) // i
        lsph_type_buf_append_byte(&! buf, 99)  // c
    } else if effect_id == LSPH_EFFECT_ASYNC {
        // "Async"
        lsph_type_buf_append_byte(&! buf, 65)  // A
        lsph_type_buf_append_byte(&! buf, 115) // s
        lsph_type_buf_append_byte(&! buf, 121) // y
        lsph_type_buf_append_byte(&! buf, 110) // n
        lsph_type_buf_append_byte(&! buf, 99)  // c
    } else if effect_id == LSPH_EFFECT_GPU {
        // "GPU"
        lsph_type_buf_append_byte(&! buf, 71)  // G
        lsph_type_buf_append_byte(&! buf, 80)  // P
        lsph_type_buf_append_byte(&! buf, 85)  // U
    } else if effect_id == LSPH_EFFECT_PROB {
        // "Prob"
        lsph_type_buf_append_byte(&! buf, 80)  // P
        lsph_type_buf_append_byte(&! buf, 114) // r
        lsph_type_buf_append_byte(&! buf, 111) // o
        lsph_type_buf_append_byte(&! buf, 98)  // b
    } else if effect_id == LSPH_EFFECT_DIV {
        // "Div"
        lsph_type_buf_append_byte(&! buf, 68)  // D
        lsph_type_buf_append_byte(&! buf, 105) // i
        lsph_type_buf_append_byte(&! buf, 118) // v
    } else {
        // Unknown effect: "Effect#" + id
        lsph_type_buf_append_byte(&! buf, 69)  // E
        lsph_type_buf_append_byte(&! buf, 102) // f
        lsph_type_buf_append_byte(&! buf, 102) // f
        lsph_type_buf_append_byte(&! buf, 101) // e
        lsph_type_buf_append_byte(&! buf, 99)  // c
        lsph_type_buf_append_byte(&! buf, 116) // t
        lsph_type_buf_append_byte(&! buf, 35)  // #
        lsph_type_buf_append_i64(&! buf, effect_id)
    }
    buf
}

// ============================================================================
// Section 15: PARAMETER MANAGEMENT
// ============================================================================

// Set a parameter in the context parameter buffer.
fn lsph_set_param(ctx: &! LsphContext, index: i64, name_hash: i64, type_buf: &LsphTypeBuf)
    with Mut, Div, Panic
{
    if index < 0 || index >= LSPH_MAX_PARAMS {
        return
    }
    ctx.params_buf[index as usize].name_hash = name_hash
    // Copy type buf
    var i: i64 = 0
    while i < type_buf.len && i < LSPH_MAX_TYPE_LEN {
        ctx.params_buf[index as usize].type_buf.buf[i as usize] = type_buf.buf[i as usize]
        i = i + 1
    }
    ctx.params_buf[index as usize].type_buf.len = type_buf.len
}

// Clear the parameter buffer.
fn lsph_clear_params(ctx: &! LsphContext) with Mut, Div, Panic {
    var i: i64 = 0
    while i < LSPH_MAX_PARAMS {
        ctx.params_buf[i as usize].name_hash = 0
        ctx.params_buf[i as usize].type_buf.len = 0
        i = i + 1
    }
}

// Set the effects buffer on the context.
fn lsph_set_effects(ctx: &! LsphContext, effects: &LsphEffectBuf) with Mut, Div, Panic {
    var i: i64 = 0
    while i < effects.count && i < LSPH_MAX_EFFECTS {
        ctx.effects_buf.effects[i as usize] = effects.effects[i as usize]
        i = i + 1
    }
    ctx.effects_buf.count = effects.count
}

// Clear the effects buffer on the context.
fn lsph_clear_effects(ctx: &! LsphContext) with Mut {
    ctx.effects_buf.count = 0
}

// ============================================================================
// Section 16: HOVER CONTENT FORMATTING -- FUNCTION SIGNATURES
// ============================================================================

// Format a function signature into a hover buffer.
// Produces: fn name(param1: Type1, param2: Type2) -> ReturnType with Effect1, Effect2
fn lsph_format_function_signature(ctx: &LsphContext, sym_id: i64) -> LsphHoverBuf
    with Mut, Div, Panic
{
    var buf = lsph_hover_buf_new()

    if sym_id < 0 || sym_id >= ctx.sym_count {
        return buf
    }

    let sym = ctx.symbols[sym_id as usize]

    // "fn "
    lsph_hover_buf_append_byte(&! buf, 102) // f
    lsph_hover_buf_append_byte(&! buf, 110) // n
    lsph_hover_buf_append_space(&! buf)

    // Name (as hash for now)
    lsph_hover_buf_append_byte(&! buf, LSPH_BYTE_UNDERSCORE)
    lsph_hover_buf_append_i64(&! buf, sym.name_hash)

    // Parameters: (p1: T1, p2: T2)
    lsph_hover_buf_append_byte(&! buf, LSPH_BYTE_LPAREN)
    var pi: i64 = 0
    while pi < sym.param_count && pi < LSPH_MAX_PARAMS {
        if pi > 0 {
            lsph_hover_buf_append_byte(&! buf, LSPH_BYTE_COMMA)
            lsph_hover_buf_append_space(&! buf)
        }
        // param name hash
        lsph_hover_buf_append_byte(&! buf, 112) // p
        lsph_hover_buf_append_i64(&! buf, pi)
        lsph_hover_buf_append_byte(&! buf, LSPH_BYTE_COLON)
        lsph_hover_buf_append_space(&! buf)
        // param type
        let pt = ctx.params_buf[pi as usize].type_buf
        if pt.len > 0 {
            lsph_hover_buf_append_type(&! buf, &pt)
        } else {
            // "?"
            lsph_hover_buf_append_byte(&! buf, 63)
        }
        pi = pi + 1
    }
    lsph_hover_buf_append_byte(&! buf, LSPH_BYTE_RPAREN)

    // Return type: " -> Type"
    if sym.type_buf.len > 0 {
        lsph_hover_buf_append_space(&! buf)
        lsph_hover_buf_append_byte(&! buf, LSPH_BYTE_DASH)
        lsph_hover_buf_append_byte(&! buf, LSPH_BYTE_RANGLE)
        lsph_hover_buf_append_space(&! buf)
        lsph_hover_buf_append_type(&! buf, &sym.type_buf)
    }

    // Effects: " with E1, E2"
    if sym.effect_count > 0 && ctx.effects_buf.count > 0 {
        lsph_hover_buf_append_space(&! buf)
        // "with "
        lsph_hover_buf_append_byte(&! buf, 119) // w
        lsph_hover_buf_append_byte(&! buf, 105) // i
        lsph_hover_buf_append_byte(&! buf, 116) // t
        lsph_hover_buf_append_byte(&! buf, 104) // h
        lsph_hover_buf_append_space(&! buf)

        var ei: i64 = 0
        while ei < ctx.effects_buf.count {
            if ei > 0 {
                lsph_hover_buf_append_byte(&! buf, LSPH_BYTE_COMMA)
                lsph_hover_buf_append_space(&! buf)
            }
            let eff = lsph_format_effect(ctx.effects_buf.effects[ei as usize])
            lsph_hover_buf_append_type(&! buf, &eff)
            ei = ei + 1
        }
    }

    buf
}

// ============================================================================
// Section 17: HOVER CONTENT FORMATTING -- VARIABLES
// ============================================================================

// Format a variable hover: shows "let name: Type" or "var name: Type"
fn lsph_format_variable_hover(ctx: &LsphContext, sym_id: i64) -> LsphHoverBuf
    with Mut, Div, Panic
{
    var buf = lsph_hover_buf_new()

    if sym_id < 0 || sym_id >= ctx.sym_count {
        return buf
    }

    let sym = ctx.symbols[sym_id as usize]

    // "let " or "var "
    if sym.is_mutable {
        lsph_hover_buf_append_byte(&! buf, 118) // v
        lsph_hover_buf_append_byte(&! buf, 97)  // a
        lsph_hover_buf_append_byte(&! buf, 114) // r
    } else {
        lsph_hover_buf_append_byte(&! buf, 108) // l
        lsph_hover_buf_append_byte(&! buf, 101) // e
        lsph_hover_buf_append_byte(&! buf, 116) // t
    }
    lsph_hover_buf_append_space(&! buf)

    // Name hash
    lsph_hover_buf_append_byte(&! buf, LSPH_BYTE_UNDERSCORE)
    lsph_hover_buf_append_i64(&! buf, sym.name_hash)

    // Type annotation
    if sym.type_buf.len > 0 {
        lsph_hover_buf_append_byte(&! buf, LSPH_BYTE_COLON)
        lsph_hover_buf_append_space(&! buf)
        lsph_hover_buf_append_type(&! buf, &sym.type_buf)
    }

    buf
}

// ============================================================================
// Section 18: HOVER CONTENT FORMATTING -- TYPES
// ============================================================================

// Format a type hover: shows "struct Name" / "enum Name" / etc.
fn lsph_format_type_hover(ctx: &LsphContext, sym_id: i64) -> LsphHoverBuf
    with Mut, Div, Panic
{
    var buf = lsph_hover_buf_new()

    if sym_id < 0 || sym_id >= ctx.sym_count {
        return buf
    }

    let sym = ctx.symbols[sym_id as usize]

    // Type category keyword
    let cat_buf = lsph_format_type_category(sym.type_cat)
    lsph_hover_buf_append_type(&! buf, &cat_buf)
    lsph_hover_buf_append_space(&! buf)

    // Name hash
    lsph_hover_buf_append_byte(&! buf, LSPH_BYTE_UNDERSCORE)
    lsph_hover_buf_append_i64(&! buf, sym.name_hash)

    buf
}

// ============================================================================
// Section 19: HOVER CONTENT FORMATTING -- FIELDS
// ============================================================================

// Format a field hover: shows "field name: Type"
fn lsph_format_field_hover(ctx: &LsphContext, sym_id: i64) -> LsphHoverBuf
    with Mut, Div, Panic
{
    var buf = lsph_hover_buf_new()

    if sym_id < 0 || sym_id >= ctx.sym_count {
        return buf
    }

    let sym = ctx.symbols[sym_id as usize]

    // "field "
    let kind_buf = lsph_format_symbol_kind(LsphSymbolKind::SymField)
    lsph_hover_buf_append_type(&! buf, &kind_buf)
    lsph_hover_buf_append_space(&! buf)

    // Name hash
    lsph_hover_buf_append_byte(&! buf, LSPH_BYTE_UNDERSCORE)
    lsph_hover_buf_append_i64(&! buf, sym.name_hash)

    // Type
    if sym.type_buf.len > 0 {
        lsph_hover_buf_append_byte(&! buf, LSPH_BYTE_COLON)
        lsph_hover_buf_append_space(&! buf)
        lsph_hover_buf_append_type(&! buf, &sym.type_buf)
    }

    buf
}

// ============================================================================
// Section 20: HOVER CONTENT FORMATTING -- CONSTANTS AND PARAMETERS
// ============================================================================

// Format a constant hover: shows "const name: Type"
fn lsph_format_constant_hover(ctx: &LsphContext, sym_id: i64) -> LsphHoverBuf
    with Mut, Div, Panic
{
    var buf = lsph_hover_buf_new()

    if sym_id < 0 || sym_id >= ctx.sym_count {
        return buf
    }

    let sym = ctx.symbols[sym_id as usize]

    // "let "
    lsph_hover_buf_append_byte(&! buf, 108) // l
    lsph_hover_buf_append_byte(&! buf, 101) // e
    lsph_hover_buf_append_byte(&! buf, 116) // t
    lsph_hover_buf_append_space(&! buf)

    // Name hash
    lsph_hover_buf_append_byte(&! buf, LSPH_BYTE_UNDERSCORE)
    lsph_hover_buf_append_i64(&! buf, sym.name_hash)

    // Type
    if sym.type_buf.len > 0 {
        lsph_hover_buf_append_byte(&! buf, LSPH_BYTE_COLON)
        lsph_hover_buf_append_space(&! buf)
        lsph_hover_buf_append_type(&! buf, &sym.type_buf)
    }

    buf
}

// Format a parameter hover: shows "param name: Type"
fn lsph_format_parameter_hover(ctx: &LsphContext, sym_id: i64) -> LsphHoverBuf
    with Mut, Div, Panic
{
    var buf = lsph_hover_buf_new()

    if sym_id < 0 || sym_id >= ctx.sym_count {
        return buf
    }

    let sym = ctx.symbols[sym_id as usize]

    // "param "
    let kind_buf = lsph_format_symbol_kind(LsphSymbolKind::SymParameter)
    lsph_hover_buf_append_type(&! buf, &kind_buf)
    lsph_hover_buf_append_space(&! buf)

    // Name hash
    lsph_hover_buf_append_byte(&! buf, LSPH_BYTE_UNDERSCORE)
    lsph_hover_buf_append_i64(&! buf, sym.name_hash)

    // Type
    if sym.type_buf.len > 0 {
        lsph_hover_buf_append_byte(&! buf, LSPH_BYTE_COLON)
        lsph_hover_buf_append_space(&! buf)
        lsph_hover_buf_append_type(&! buf, &sym.type_buf)
    }

    buf
}

// Format a module hover: shows "module name"
fn lsph_format_module_hover(ctx: &LsphContext, sym_id: i64) -> LsphHoverBuf
    with Mut, Div, Panic
{
    var buf = lsph_hover_buf_new()

    if sym_id < 0 || sym_id >= ctx.sym_count {
        return buf
    }

    let sym = ctx.symbols[sym_id as usize]

    // "module "
    let kind_buf = lsph_format_symbol_kind(LsphSymbolKind::SymModule)
    lsph_hover_buf_append_type(&! buf, &kind_buf)
    lsph_hover_buf_append_space(&! buf)

    // Name hash
    lsph_hover_buf_append_byte(&! buf, LSPH_BYTE_UNDERSCORE)
    lsph_hover_buf_append_i64(&! buf, sym.name_hash)

    buf
}

// ============================================================================
// Section 21: HOVER CONTENT BUILDER
// ============================================================================

// Format the signature line for a symbol based on its kind.
fn lsph_format_signature_for_kind(ctx: &LsphContext, sym_id: i64) -> LsphHoverBuf
    with Mut, Div, Panic
{
    if sym_id < 0 || sym_id >= ctx.sym_count {
        return lsph_hover_buf_new()
    }

    let kind = ctx.symbols[sym_id as usize].kind
    match kind {
        LsphSymbolKind::SymFunction => lsph_format_function_signature(ctx, sym_id),
        LsphSymbolKind::SymVariable => lsph_format_variable_hover(ctx, sym_id),
        LsphSymbolKind::SymType => lsph_format_type_hover(ctx, sym_id),
        LsphSymbolKind::SymField => lsph_format_field_hover(ctx, sym_id),
        LsphSymbolKind::SymModule => lsph_format_module_hover(ctx, sym_id),
        LsphSymbolKind::SymConstant => lsph_format_constant_hover(ctx, sym_id),
        LsphSymbolKind::SymParameter => lsph_format_parameter_hover(ctx, sym_id),
        LsphSymbolKind::SymEffect => lsph_format_field_hover(ctx, sym_id),
        LsphSymbolKind::SymUnknown => lsph_hover_buf_new(),
    }
}

// Build the full hover content for a symbol.  The result is stored in
// ctx.hover_result.  Format:
//
//   ```sio
//   <signature>
//   ```
//   ---
//   <doc comment>
//
fn lsph_build_hover_content(ctx: &! LsphContext, sym_id: i64)
    with Mut, Div, Panic
{
    // Clear the hover result
    ctx.hover_result.len = 0

    if sym_id < 0 || sym_id >= ctx.sym_count {
        return
    }

    // Code fence with signature
    lsph_hover_buf_append_code_fence_open(&! ctx.hover_result)

    let sig = lsph_format_signature_for_kind(ctx, sym_id)
    lsph_hover_buf_append_hover(&! ctx.hover_result, &sig)
    lsph_hover_buf_append_newline(&! ctx.hover_result)

    lsph_hover_buf_append_code_fence_close(&! ctx.hover_result)

    // If there is a doc comment, add separator and doc
    let doc = ctx.symbols[sym_id as usize].doc
    if doc.len > 0 {
        lsph_hover_buf_append_hr(&! ctx.hover_result)
        lsph_hover_buf_append_doc(&! ctx.hover_result, &doc)
        lsph_hover_buf_append_newline(&! ctx.hover_result)
    }
}

// ============================================================================
// Section 22: MAIN HOVER HANDLER
// ============================================================================

// Handle a hover request at (line, col).
// Searches for the symbol at the position, builds hover content,
// and stores the result in ctx.hover_result.
// Returns true if a symbol was found, false otherwise.
fn lsph_handle_hover(ctx: &! LsphContext, line: i64, col: i64) -> bool
    with Mut, Div, Panic
{
    ctx.last_hover_line = line
    ctx.last_hover_col = col
    ctx.hover_result.len = 0

    let sym_id = lsph_find_symbol_at(ctx, line, col)
    if sym_id == LSPH_INVALID {
        return false
    }

    lsph_build_hover_content(ctx, sym_id)
    true
}

// ============================================================================
// Section 22b: CROSS-MODULE HOVER (qualified-name fallback)
// ============================================================================

// lsp_hover_qualified -- fallback hover for qualified names resolved via the
// module resolver bridge.
//
// Called when the local-scope scan (lsph_handle_hover) returns false, i.e. the
// cursor is on a `Mod::sym` qualified name that is not registered in the local
// symbol table.  The caller must have already performed the bridge lookup
// (lspg_find_def_by_sym_id / lspg_resolve_via_module_graph) to obtain def_id.
//
// Parameters:
//   ctx       -- hover context whose hover_result buffer will be filled.
//   name_hash -- stable hash of the qualified name (for diagnostics).
//   def_id    -- definition index returned by the module resolver bridge.
//                Pass LSPH_INVALID (0-1) when the lookup failed.
//
// Returns 1 if def_id is valid (>= 0) and the hover buffer was filled,
// 0 otherwise.
fn lsp_hover_qualified(ctx: &! LsphContext, name_hash: i64, def_id: i64) -> i64
    with Mut, Div, Panic
{
    if def_id < 0 {
        return 0
    }

    // Clear the hover result and write the placeholder string:
    //   "(qualified symbol, def_id=N)"
    ctx.hover_result.len = 0

    // '('
    lsph_hover_buf_append_byte(&! ctx.hover_result, 40)
    // 'q'
    lsph_hover_buf_append_byte(&! ctx.hover_result, 113)
    // 'u'
    lsph_hover_buf_append_byte(&! ctx.hover_result, 117)
    // 'a'
    lsph_hover_buf_append_byte(&! ctx.hover_result, 97)
    // 'l'
    lsph_hover_buf_append_byte(&! ctx.hover_result, 108)
    // 'i'
    lsph_hover_buf_append_byte(&! ctx.hover_result, 105)
    // 'f'
    lsph_hover_buf_append_byte(&! ctx.hover_result, 102)
    // 'i'
    lsph_hover_buf_append_byte(&! ctx.hover_result, 105)
    // 'e'
    lsph_hover_buf_append_byte(&! ctx.hover_result, 101)
    // 'd'
    lsph_hover_buf_append_byte(&! ctx.hover_result, 100)
    // ' '
    lsph_hover_buf_append_byte(&! ctx.hover_result, 32)
    // 's'
    lsph_hover_buf_append_byte(&! ctx.hover_result, 115)
    // 'y'
    lsph_hover_buf_append_byte(&! ctx.hover_result, 121)
    // 'm'
    lsph_hover_buf_append_byte(&! ctx.hover_result, 109)
    // 'b'
    lsph_hover_buf_append_byte(&! ctx.hover_result, 98)
    // 'o'
    lsph_hover_buf_append_byte(&! ctx.hover_result, 111)
    // 'l'
    lsph_hover_buf_append_byte(&! ctx.hover_result, 108)
    // ','
    lsph_hover_buf_append_byte(&! ctx.hover_result, 44)
    // ' '
    lsph_hover_buf_append_byte(&! ctx.hover_result, 32)
    // 'd'
    lsph_hover_buf_append_byte(&! ctx.hover_result, 100)
    // 'e'
    lsph_hover_buf_append_byte(&! ctx.hover_result, 101)
    // 'f'
    lsph_hover_buf_append_byte(&! ctx.hover_result, 102)
    // '_'
    lsph_hover_buf_append_byte(&! ctx.hover_result, 95)
    // 'i'
    lsph_hover_buf_append_byte(&! ctx.hover_result, 105)
    // 'd'
    lsph_hover_buf_append_byte(&! ctx.hover_result, 100)
    // '='
    lsph_hover_buf_append_byte(&! ctx.hover_result, 61)
    // Append decimal def_id
    lsph_hover_buf_append_i64(&! ctx.hover_result, def_id)
    // ')'
    lsph_hover_buf_append_byte(&! ctx.hover_result, 41)

    let _ = name_hash  // used for diagnostics; not needed for placeholder
    1
}

// ============================================================================
// Section 23: UTILITY HELPERS
// ============================================================================

// Check if a symbol kind represents a callable (function).
fn lsph_is_callable(kind: LsphSymbolKind) -> bool {
    match kind {
        LsphSymbolKind::SymFunction => true,
        _ => false,
    }
}

// Check if a symbol kind represents a type definition.
fn lsph_is_type_def(kind: LsphSymbolKind) -> bool {
    match kind {
        LsphSymbolKind::SymType => true,
        _ => false,
    }
}

// Check if a type category is a reference type.
fn lsph_is_ref_type(cat: LsphTypeCategory) -> bool {
    match cat {
        LsphTypeCategory::TcRef => true,
        LsphTypeCategory::TcMutRef => true,
        _ => false,
    }
}

// Hash a simple name for testing: sum of byte values.
fn lsph_simple_hash(b0: i64, b1: i64, b2: i64, b3: i64) -> i64 {
    b0 * 1000000 + b1 * 10000 + b2 * 100 + b3
}

// Get the byte at a position in a hover buffer (for test assertions).
fn lsph_hover_byte_at(buf: &LsphHoverBuf, idx: i64) -> i8 with Div, Panic {
    if idx < 0 || idx >= buf.len {
        return 0
    }
    buf.buf[idx as usize]
}

// Get the byte at a position in a type buffer (for test assertions).
fn lsph_type_byte_at(buf: &LsphTypeBuf, idx: i64) -> i8 with Div, Panic {
    if idx < 0 || idx >= buf.len {
        return 0
    }
    buf.buf[idx as usize]
}

// Get the byte at a position in a doc buffer (for test assertions).
fn lsph_doc_byte_at(buf: &LsphDocBuf, idx: i64) -> i8 with Div, Panic {
    if idx < 0 || idx >= buf.len {
        return 0
    }
    buf.buf[idx as usize]
}

// Create a type buffer containing "i32"
fn lsph_make_type_i32() -> LsphTypeBuf with Mut, Div, Panic {
    var buf = lsph_type_buf_new()
    lsph_type_buf_append_byte(&! buf, 105) // i
    lsph_type_buf_append_byte(&! buf, 51)  // 3
    lsph_type_buf_append_byte(&! buf, 50)  // 2
    buf
}

// Create a type buffer containing "f64"
fn lsph_make_type_f64() -> LsphTypeBuf with Mut, Div, Panic {
    var buf = lsph_type_buf_new()
    lsph_type_buf_append_byte(&! buf, 102) // f
    lsph_type_buf_append_byte(&! buf, 54)  // 6
    lsph_type_buf_append_byte(&! buf, 52)  // 4
    buf
}

// Create a type buffer containing "bool"
fn lsph_make_type_bool() -> LsphTypeBuf with Mut, Div, Panic {
    var buf = lsph_type_buf_new()
    lsph_type_buf_append_byte(&! buf, 98)  // b
    lsph_type_buf_append_byte(&! buf, 111) // o
    lsph_type_buf_append_byte(&! buf, 111) // o
    lsph_type_buf_append_byte(&! buf, 108) // l
    buf
}

// Create a type buffer containing "String"
fn lsph_make_type_string() -> LsphTypeBuf with Mut, Div, Panic {
    var buf = lsph_type_buf_new()
    lsph_type_buf_append_byte(&! buf, 83)  // S
    lsph_type_buf_append_byte(&! buf, 116) // t
    lsph_type_buf_append_byte(&! buf, 114) // r
    lsph_type_buf_append_byte(&! buf, 105) // i
    lsph_type_buf_append_byte(&! buf, 110) // n
    lsph_type_buf_append_byte(&! buf, 103) // g
    buf
}

// Create a doc buffer with a given single-line message (up to 32 bytes from i64 array).
fn lsph_make_doc(bytes: &[i64; 32], len: i64) -> LsphDocBuf with Mut, Div, Panic {
    var doc = lsph_doc_buf_new()
    var i: i64 = 0
    while i < len && i < 32 {
        lsph_doc_buf_append_byte(&! doc, bytes[i as usize] as i8)
        i = i + 1
    }
    doc
}

// ============================================================================
// Section 24: TESTS -- BUFFER OPERATIONS (T01-T10)
// ============================================================================

// T01: Type buffer append byte
fn test_lsph_type_buf_append_byte_inner(buf: &! LsphTypeBuf) -> bool with Mut, Div, Panic {
    lsph_type_buf_append_byte(buf, 65) // 'A'
    lsph_type_buf_append_byte(buf, 66) // 'B'
    let ok_len = buf.len == 2
    let ok_b0 = buf.buf[0] == 65
    let ok_b1 = buf.buf[1] == 66
    ok_len && ok_b0 && ok_b1
}
fn test_lsph_type_buf_append_byte() -> bool with Mut, Div, Panic {
    var buf = lsph_type_buf_new()
    test_lsph_type_buf_append_byte_inner(&! buf)
}

// T02: Type buffer append str
fn test_lsph_type_buf_append_str_inner(dst: &! LsphTypeBuf) -> bool with Mut, Div, Panic {
    lsph_type_buf_append_byte(dst, 72) // 'H'
    var src = lsph_type_buf_new()
    lsph_type_buf_append_byte(&! src, 105) // 'i'
    lsph_type_buf_append_str(dst, &src)
    let ok_len = dst.len == 2
    let ok_b0 = dst.buf[0] == 72
    let ok_b1 = dst.buf[1] == 105
    ok_len && ok_b0 && ok_b1
}
fn test_lsph_type_buf_append_str() -> bool with Mut, Div, Panic {
    var buf = lsph_type_buf_new()
    test_lsph_type_buf_append_str_inner(&! buf)
}

// T03: Type buffer append i64
fn test_lsph_type_buf_append_i64_inner(buf: &! LsphTypeBuf) -> bool with Mut, Div, Panic {
    lsph_type_buf_append_i64(buf, 42)
    let ok_len = buf.len == 2
    let ok_b0 = buf.buf[0] == 52  // '4'
    let ok_b1 = buf.buf[1] == 50  // '2'
    ok_len && ok_b0 && ok_b1
}
fn test_lsph_type_buf_append_i64() -> bool with Mut, Div, Panic {
    var buf = lsph_type_buf_new()
    test_lsph_type_buf_append_i64_inner(&! buf)
}

// T04: Type buffer append i64 zero
fn test_lsph_type_buf_append_i64_zero_inner(buf: &! LsphTypeBuf) -> bool with Mut, Div, Panic {
    lsph_type_buf_append_i64(buf, 0)
    let ok_len = buf.len == 1
    let ok_b0 = buf.buf[0] == LSPH_BYTE_ZERO
    ok_len && ok_b0
}
fn test_lsph_type_buf_append_i64_zero() -> bool with Mut, Div, Panic {
    var buf = lsph_type_buf_new()
    test_lsph_type_buf_append_i64_zero_inner(&! buf)
}

// T05: Type buffer equality
fn test_lsph_type_buf_eq_inner(a: &! LsphTypeBuf) -> bool with Mut, Div, Panic {
    lsph_type_buf_append_byte(a, 65)
    lsph_type_buf_append_byte(a, 66)
    var b = lsph_type_buf_new()
    lsph_type_buf_append_byte(&! b, 65)
    lsph_type_buf_append_byte(&! b, 66)
    let ok_eq = lsph_type_buf_eq(a, &b)

    var c = lsph_type_buf_new()
    lsph_type_buf_append_byte(&! c, 65)
    lsph_type_buf_append_byte(&! c, 67) // different
    let ok_neq = lsph_type_buf_eq(a, &c) == false

    ok_eq && ok_neq
}
fn test_lsph_type_buf_eq() -> bool with Mut, Div, Panic {
    var a = lsph_type_buf_new()
    test_lsph_type_buf_eq_inner(&! a)
}

// T06: Hover buffer append byte
fn test_lsph_hover_buf_append_byte_inner(buf: &! LsphHoverBuf) -> bool with Mut, Div, Panic {
    lsph_hover_buf_append_byte(buf, 72) // 'H'
    lsph_hover_buf_append_byte(buf, 105) // 'i'
    let ok_len = buf.len == 2
    let ok_b0 = buf.buf[0] == 72
    let ok_b1 = buf.buf[1] == 105
    ok_len && ok_b0 && ok_b1
}
fn test_lsph_hover_buf_append_byte() -> bool with Mut, Div, Panic {
    var buf = lsph_hover_buf_new()
    test_lsph_hover_buf_append_byte_inner(&! buf)
}

// T07: Hover buffer append type
fn test_lsph_hover_buf_append_type_inner(hb: &! LsphHoverBuf) -> bool with Mut, Div, Panic {
    var tb = lsph_type_buf_new()
    lsph_type_buf_append_byte(&! tb, 105) // 'i'
    lsph_type_buf_append_byte(&! tb, 51)  // '3'
    lsph_type_buf_append_byte(&! tb, 50)  // '2'
    lsph_hover_buf_append_type(hb, &tb)
    let ok_len = hb.len == 3
    let ok_b0 = hb.buf[0] == 105
    let ok_b1 = hb.buf[1] == 51
    let ok_b2 = hb.buf[2] == 50
    ok_len && ok_b0 && ok_b1 && ok_b2
}
fn test_lsph_hover_buf_append_type() -> bool with Mut, Div, Panic {
    var buf = lsph_hover_buf_new()
    test_lsph_hover_buf_append_type_inner(&! buf)
}

// T08: Hover buffer append doc
fn test_lsph_hover_buf_append_doc_inner(hb: &! LsphHoverBuf) -> bool with Mut, Div, Panic {
    var doc = lsph_doc_buf_new()
