    let idx = lsph_add_symbol(ctx, LsphSymbolKind::SymFunction, 100, 5, 0, 10, 0)
    let f_mid = lsph_find_symbol_at(ctx, 7, 5)
    let f_start = lsph_find_symbol_at(ctx, 5, 0)
    let f_end = lsph_find_symbol_at(ctx, 10, 0)
    let f_before = lsph_find_symbol_at(ctx, 4, 0)
    let f_after = lsph_find_symbol_at(ctx, 10, 1)

    f_mid == 0 && f_start == 0 && f_end == 0 && f_before == LSPH_INVALID && f_after == LSPH_INVALID
}
