// T25: Find symbol with overlapping spans (innermost wins)
fn test_lsph_find_symbol_at_overlap_inner(ctx: &! LsphContext) -> bool with Mut, Div, Panic {
    // Outer span: line 5 col 0 to line 10 col 0
    let outer = lsph_add_symbol(ctx, LsphSymbolKind::SymFunction, 100, 5, 0, 10, 0)
    // Inner span: line 7 col 4 to line 7 col 12
    let inner = lsph_add_symbol(ctx, LsphSymbolKind::SymVariable, 200, 7, 4, 7, 12)
    let found = lsph_find_symbol_at(ctx, 7, 8)
    found == inner
}
fn test_lsph_find_symbol_at_overlap() -> bool with Mut, Div, Panic {
    var ctx = lsph_context_new()
    test_lsph_find_symbol_at_overlap_inner(&! ctx)
}

