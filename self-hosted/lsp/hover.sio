    var ctx = lsph_context_new()
    test_lsph_hover_pipeline_miss_inner(&! ctx)
}

// T65: Full hover pipeline -- variable with type
fn test_lsph_hover_pipeline_variable_inner(ctx: &! LsphContext) -> bool with Mut, Div, Panic {
    let idx = lsph_add_symbol(ctx, LsphSymbolKind::SymVariable, 99, 10, 4, 10, 12)
    let tb = lsph_make_type_f64()
    lsph_set_symbol_type(ctx, idx, LsphTypeCategory::TcPrimitive, &tb)

    let found = lsph_handle_hover(ctx, 10, 8)
    let ok_found = found
    let ok_len = ctx.hover_result.len > 0
    ok_found && ok_len
}
fn test_lsph_hover_pipeline_variable() -> bool with Mut, Div, Panic {
    var ctx = lsph_context_new()
    test_lsph_hover_pipeline_variable_inner(&! ctx)
}

// T66: Full hover pipeline -- multiple symbols, correct one selected
fn test_lsph_hover_pipeline_multiple_inner(ctx: &! LsphContext) -> bool with Mut, Div, Panic {
    let i0 = lsph_add_symbol(ctx, LsphSymbolKind::SymFunction, 100, 1, 0, 1, 20)
    let i1 = lsph_add_symbol(ctx, LsphSymbolKind::SymVariable, 200, 5, 4, 5, 12)
    let i2 = lsph_add_symbol(ctx, LsphSymbolKind::SymType, 300, 10, 0, 15, 0)

    // Hover over the variable
    let found = lsph_handle_hover(ctx, 5, 8)
    let ok_found = found
    let ok_len = ctx.hover_result.len > 0
    ok_found && ok_len
}
fn test_lsph_hover_pipeline_multiple() -> bool with Mut, Div, Panic {
    var ctx = lsph_context_new()
    test_lsph_hover_pipeline_multiple_inner(&! ctx)
}

// T67: Hover updates last_hover coordinates
fn test_lsph_hover_updates_coords_inner(ctx: &! LsphContext) -> bool with Mut, Div, Panic {
    let idx = lsph_add_symbol(ctx, LsphSymbolKind::SymVariable, 42, 5, 0, 5, 20)

    let r1 = lsph_handle_hover(ctx, 5, 10)
    let ok1_line = ctx.last_hover_line == 5
    let ok1_col = ctx.last_hover_col == 10

    let r2 = lsph_handle_hover(ctx, 100, 50)
    let ok2_line = ctx.last_hover_line == 100
    let ok2_col = ctx.last_hover_col == 50

    ok1_line && ok1_col && ok2_line && ok2_col
}
fn test_lsph_hover_updates_coords() -> bool with Mut, Div, Panic {
    var ctx = lsph_context_new()
    test_lsph_hover_updates_coords_inner(&! ctx)
}

// T68: Effect buffer operations
fn test_lsph_effect_buf_ops_inner(eb: &! LsphEffectBuf) -> bool with Mut, Div, Panic {
    lsph_effect_buf_add(eb, LSPH_EFFECT_IO)
    lsph_effect_buf_add(eb, LSPH_EFFECT_MUT)
    lsph_effect_buf_add(eb, LSPH_EFFECT_PANIC)

    let ok_count = eb.count == 3
    let ok_has_io = lsph_effect_buf_contains(eb, LSPH_EFFECT_IO)
    let ok_has_mut = lsph_effect_buf_contains(eb, LSPH_EFFECT_MUT)
    let ok_has_panic = lsph_effect_buf_contains(eb, LSPH_EFFECT_PANIC)
    let ok_no_gpu = lsph_effect_buf_contains(eb, LSPH_EFFECT_GPU) == false

    ok_count && ok_has_io && ok_has_mut && ok_has_panic && ok_no_gpu
}
fn test_lsph_effect_buf_ops() -> bool with Mut, Div, Panic {
    var eb = lsph_effect_buf_new()
    test_lsph_effect_buf_ops_inner(&! eb)
}

// T69: Effect formatting
fn test_lsph_format_effect_names() -> bool with Mut, Div, Panic {
    let io_buf = lsph_format_effect(LSPH_EFFECT_IO)
    let mut_buf = lsph_format_effect(LSPH_EFFECT_MUT)
    let panic_buf = lsph_format_effect(LSPH_EFFECT_PANIC)
    let div_buf = lsph_format_effect(LSPH_EFFECT_DIV)
    let gpu_buf = lsph_format_effect(LSPH_EFFECT_GPU)

    // "IO" = 2 bytes, "Mut" = 3 bytes, "Panic" = 5 bytes, "Div" = 3 bytes, "GPU" = 3 bytes
    let ok_io = io_buf.len == 2 && io_buf.buf[0] == 73
    let ok_mut = mut_buf.len == 3 && mut_buf.buf[0] == 77
    let ok_panic = panic_buf.len == 5 && panic_buf.buf[0] == 80
    let ok_div = div_buf.len == 3 && div_buf.buf[0] == 68
    let ok_gpu = gpu_buf.len == 3 && gpu_buf.buf[0] == 71

    ok_io && ok_mut && ok_panic && ok_div && ok_gpu
}

// T70: Doc comment extraction
fn test_lsph_extract_doc_comment_basic() -> bool with Mut, Div, Panic {
    var src: [i64; 4096] = [0; 4096]
    // Line 0: "// Hello\n"
    src[0] = 47   // /
    src[1] = 47   // /
    src[2] = 32   // space
    src[3] = 72   // H
    src[4] = 101  // e
    src[5] = 108  // l
    src[6] = 108  // l
    src[7] = 111  // o
    src[8] = 10   // \n
    // Line 1: "fn foo()\n"
    src[9] = 102  // f
    src[10] = 110 // n
    src[11] = 32  // space
    src[12] = 102 // f
    src[13] = 111 // o
    src[14] = 111 // o
    src[15] = 40  // (
    src[16] = 41  // )
    src[17] = 10  // \n

    let doc = lsph_extract_doc_comment(&src, 18, 1)
    // Should extract "Hello"
    let ok_len = doc.len == 5
    let ok_h = doc.buf[0] == 72  // 'H'
    let ok_o = doc.buf[4] == 111 // 'o'
    ok_len && ok_h && ok_o
}

// ============================================================================
// Section 32: ADDITIONAL HELPER FUNCTIONS
// ============================================================================

// Clear the hover result buffer on the context.
fn lsph_clear_hover_result(ctx: &! LsphContext) with Mut {
    ctx.hover_result.len = 0
}

// Check if the context has a hover result.
fn lsph_has_hover_result(ctx: &LsphContext) -> bool {
    ctx.hover_result.len > 0
}

// Get the hover result length.
fn lsph_hover_result_len(ctx: &LsphContext) -> i64 {
    ctx.hover_result.len
}

// Get a byte from the hover result.
fn lsph_hover_result_byte(ctx: &LsphContext, idx: i64) -> i8 with Div, Panic {
    if idx < 0 || idx >= ctx.hover_result.len {
        return 0
    }
    ctx.hover_result.buf[idx as usize]
}

// Utility: check that a symbol is a function.
fn lsph_symbol_is_function(ctx: &LsphContext, sym_id: i64) -> bool with Div, Panic {
    if sym_id < 0 || sym_id >= ctx.sym_count {
        return false
    }
    match ctx.symbols[sym_id as usize].kind {
        LsphSymbolKind::SymFunction => true,
        _ => false,
    }
}

// Utility: check that a symbol is a variable.
fn lsph_symbol_is_variable(ctx: &LsphContext, sym_id: i64) -> bool with Div, Panic {
    if sym_id < 0 || sym_id >= ctx.sym_count {
        return false
    }
    match ctx.symbols[sym_id as usize].kind {
        LsphSymbolKind::SymVariable => true,
        _ => false,
    }
}

// Utility: check that a symbol is a type.
fn lsph_symbol_is_type(ctx: &LsphContext, sym_id: i64) -> bool with Div, Panic {
    if sym_id < 0 || sym_id >= ctx.sym_count {
        return false
    }
    match ctx.symbols[sym_id as usize].kind {
        LsphSymbolKind::SymType => true,
        _ => false,
    }
}

// Utility: reset the entire context for re-use.
fn lsph_context_reset(ctx: &! LsphContext) with Mut {
    ctx.sym_count = 0
    ctx.line_index.line_count = 0
    ctx.effects_buf.count = 0
    ctx.hover_result.len = 0
    ctx.last_hover_line = 0
    ctx.last_hover_col = 0
}

// Utility: compute the symbol count.
fn lsph_symbol_count(ctx: &LsphContext) -> i64 {
    ctx.sym_count
}

// Format an effect list as a comma-separated string into a hover buffer.
fn lsph_format_effects_list(effects: &LsphEffectBuf) -> LsphHoverBuf with Mut, Div, Panic {
    var buf = lsph_hover_buf_new()
    var i: i64 = 0
    while i < effects.count {
        if i > 0 {
            lsph_hover_buf_append_byte(&! buf, LSPH_BYTE_COMMA)
            lsph_hover_buf_append_space(&! buf)
        }
        let eff = lsph_format_effect(effects.effects[i as usize])
        lsph_hover_buf_append_type(&! buf, &eff)
        i = i + 1
    }
    buf
}

