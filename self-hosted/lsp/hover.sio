}

// ============================================================================
// Section 34: TYPE BUFFER STRING HELPERS
// ============================================================================

// Append a known string "fn" to a type buffer.
fn lsph_type_buf_append_fn(buf: &! LsphTypeBuf) with Mut, Div, Panic {
    lsph_type_buf_append_byte(buf, 102) // f
    lsph_type_buf_append_byte(buf, 110) // n
}

// Append "let" to a type buffer.
fn lsph_type_buf_append_let(buf: &! LsphTypeBuf) with Mut, Div, Panic {
    lsph_type_buf_append_byte(buf, 108) // l
    lsph_type_buf_append_byte(buf, 101) // e
    lsph_type_buf_append_byte(buf, 116) // t
}

// Append "var" to a type buffer.
fn lsph_type_buf_append_var(buf: &! LsphTypeBuf) with Mut, Div, Panic {
    lsph_type_buf_append_byte(buf, 118) // v
    lsph_type_buf_append_byte(buf, 97)  // a
    lsph_type_buf_append_byte(buf, 114) // r
}

// Append "with " to a type buffer.
fn lsph_type_buf_append_with(buf: &! LsphTypeBuf) with Mut, Div, Panic {
    lsph_type_buf_append_byte(buf, 119) // w
    lsph_type_buf_append_byte(buf, 105) // i
    lsph_type_buf_append_byte(buf, 116) // t
    lsph_type_buf_append_byte(buf, 104) // h
    lsph_type_buf_append_byte(buf, 32)  // space
}

// Append " -> " to a type buffer.
fn lsph_type_buf_append_arrow(buf: &! LsphTypeBuf) with Mut, Div, Panic {
    lsph_type_buf_append_byte(buf, 32)  // space
    lsph_type_buf_append_byte(buf, 45)  // -
    lsph_type_buf_append_byte(buf, 62)  // >
    lsph_type_buf_append_byte(buf, 32)  // space
}

// ============================================================================
// Section 35: SYMBOL KIND COMPARISON HELPERS
// ============================================================================

// Compare two symbol kinds for equality.
fn lsph_symbol_kind_eq(a: LsphSymbolKind, b: LsphSymbolKind) -> bool {
    match a {
        LsphSymbolKind::SymFunction => match b {
            LsphSymbolKind::SymFunction => true,
            _ => false,
        },
        LsphSymbolKind::SymVariable => match b {
            LsphSymbolKind::SymVariable => true,
            _ => false,
        },
        LsphSymbolKind::SymType => match b {
            LsphSymbolKind::SymType => true,
            _ => false,
        },
        LsphSymbolKind::SymField => match b {
            LsphSymbolKind::SymField => true,
            _ => false,
        },
        LsphSymbolKind::SymModule => match b {
            LsphSymbolKind::SymModule => true,
            _ => false,
        },
        LsphSymbolKind::SymConstant => match b {
            LsphSymbolKind::SymConstant => true,
            _ => false,
        },
        LsphSymbolKind::SymParameter => match b {
            LsphSymbolKind::SymParameter => true,
            _ => false,
        },
        LsphSymbolKind::SymEffect => match b {
            LsphSymbolKind::SymEffect => true,
            _ => false,
        },
        LsphSymbolKind::SymUnknown => match b {
            LsphSymbolKind::SymUnknown => true,
            _ => false,
        },
    }
}

// Compare two type categories for equality.
fn lsph_type_cat_eq(a: LsphTypeCategory, b: LsphTypeCategory) -> bool {
    match a {
        LsphTypeCategory::TcPrimitive => match b {
            LsphTypeCategory::TcPrimitive => true,
            _ => false,
        },
        LsphTypeCategory::TcStruct => match b {
            LsphTypeCategory::TcStruct => true,
            _ => false,
        },
        LsphTypeCategory::TcEnum => match b {
            LsphTypeCategory::TcEnum => true,
            _ => false,
        },
        LsphTypeCategory::TcFunction => match b {
            LsphTypeCategory::TcFunction => true,
            _ => false,
        },
        LsphTypeCategory::TcArray => match b {
            LsphTypeCategory::TcArray => true,
            _ => false,
        },
        LsphTypeCategory::TcRef => match b {
            LsphTypeCategory::TcRef => true,
            _ => false,
        },
        LsphTypeCategory::TcMutRef => match b {
            LsphTypeCategory::TcMutRef => true,
            _ => false,
        },
        LsphTypeCategory::TcGeneric => match b {
            LsphTypeCategory::TcGeneric => true,
            _ => false,
        },
        LsphTypeCategory::TcUnit => match b {
            LsphTypeCategory::TcUnit => true,
            _ => false,
        },
        LsphTypeCategory::TcNever => match b {
            LsphTypeCategory::TcNever => true,
            _ => false,
        },
        LsphTypeCategory::TcUnknown => match b {
            LsphTypeCategory::TcUnknown => true,
            _ => false,
        },
    }
}

// ============================================================================
// Section 36: DOC EXTRACTION EDGE CASES
// ============================================================================

// Extract doc comments handling multi-line comments.
fn lsph_extract_multi_doc(source: &[i64; 4096], len: i64, def_line: i64) -> LsphDocBuf
    with Mut, Div, Panic
{
    // Delegate to the main extraction function.
    lsph_extract_doc_comment(source, len, def_line)
}

// Check if a byte is a printable ASCII character.
fn lsph_is_printable(b: i8) -> bool {
    let v = b as i64
    v >= 32 && v <= 126
}

// Check if a byte is a digit.
fn lsph_is_digit(b: i8) -> bool {
    let v = b as i64
    v >= 48 && v <= 57
}

// Check if a byte is an ASCII letter.
fn lsph_is_alpha(b: i8) -> bool {
    let v = b as i64
    if v >= 65 && v <= 90 {
        return true
    }
    if v >= 97 && v <= 122 {
        return true
    }
    false
}

// Check if a byte is alphanumeric or underscore (identifier character).
fn lsph_is_ident_char(b: i8) -> bool {
    if lsph_is_alpha(b) {
        return true
    }
    if lsph_is_digit(b) {
        return true
    }
    let v = b as i64
    v == 95 // underscore
}

// ============================================================================
// Section 37: ADVANCED HOVER -- TYPE WITH GENERICS
// ============================================================================

// Format a generic type reference: "Name<T>"
fn lsph_format_generic_type(name_hash: i64, type_param_hash: i64) -> LsphTypeBuf
    with Mut, Div, Panic
{
    var buf = lsph_type_buf_new()
    lsph_type_buf_append_byte(&! buf, LSPH_BYTE_UNDERSCORE)
    lsph_type_buf_append_i64(&! buf, name_hash)
    lsph_type_buf_append_byte(&! buf, LSPH_BYTE_LANGLE)
    lsph_type_buf_append_byte(&! buf, LSPH_BYTE_UNDERSCORE)
    lsph_type_buf_append_i64(&! buf, type_param_hash)
    lsph_type_buf_append_byte(&! buf, LSPH_BYTE_RANGLE)
    buf
}

// Format an array type: "[T; N]"
fn lsph_format_array_type(elem_hash: i64, size: i64) -> LsphTypeBuf
    with Mut, Div, Panic
{
    var buf = lsph_type_buf_new()
    lsph_type_buf_append_byte(&! buf, LSPH_BYTE_LBRACKET)
    lsph_type_buf_append_byte(&! buf, LSPH_BYTE_UNDERSCORE)
    lsph_type_buf_append_i64(&! buf, elem_hash)
    lsph_type_buf_append_byte(&! buf, LSPH_BYTE_SEMICOLON)
    lsph_type_buf_append_byte(&! buf, LSPH_BYTE_SPACE)
    lsph_type_buf_append_i64(&! buf, size)
    lsph_type_buf_append_byte(&! buf, LSPH_BYTE_RBRACKET)
    buf
}

// Format a reference type: "&T" or "&!T"
fn lsph_format_ref_type(inner_hash: i64, is_mutable: bool) -> LsphTypeBuf
    with Mut, Div, Panic
{
    var buf = lsph_type_buf_new()
    lsph_type_buf_append_byte(&! buf, LSPH_BYTE_AMPERSAND)
    if is_mutable {
        lsph_type_buf_append_byte(&! buf, LSPH_BYTE_BANG)
    }
    lsph_type_buf_append_byte(&! buf, LSPH_BYTE_UNDERSCORE)
    lsph_type_buf_append_i64(&! buf, inner_hash)
    buf
}

// ============================================================================
// Section 38: ADVANCED HOVER -- SOURCE LOCATION
// ============================================================================

// Format a source location string: "Defined at line N, col M"
fn lsph_format_source_location(line: i64, col: i64) -> LsphHoverBuf with Mut, Div, Panic {
    var buf = lsph_hover_buf_new()
    // "Defined at line "
    lsph_hover_buf_append_byte(&! buf, 68)  // D
    lsph_hover_buf_append_byte(&! buf, 101) // e
    lsph_hover_buf_append_byte(&! buf, 102) // f
    lsph_hover_buf_append_byte(&! buf, 105) // i
    lsph_hover_buf_append_byte(&! buf, 110) // n
    lsph_hover_buf_append_byte(&! buf, 101) // e
    lsph_hover_buf_append_byte(&! buf, 100) // d
    lsph_hover_buf_append_space(&! buf)
    lsph_hover_buf_append_byte(&! buf, 97)  // a
    lsph_hover_buf_append_byte(&! buf, 116) // t
    lsph_hover_buf_append_space(&! buf)
    // "line "
    lsph_hover_buf_append_byte(&! buf, 108) // l
    lsph_hover_buf_append_byte(&! buf, 105) // i
    lsph_hover_buf_append_byte(&! buf, 110) // n
    lsph_hover_buf_append_byte(&! buf, 101) // e
    lsph_hover_buf_append_space(&! buf)
    lsph_hover_buf_append_i64(&! buf, line)
    // ", col "
    lsph_hover_buf_append_byte(&! buf, LSPH_BYTE_COMMA)
    lsph_hover_buf_append_space(&! buf)
    lsph_hover_buf_append_byte(&! buf, 99)  // c
    lsph_hover_buf_append_byte(&! buf, 111) // o
    lsph_hover_buf_append_byte(&! buf, 108) // l
    lsph_hover_buf_append_space(&! buf)
    lsph_hover_buf_append_i64(&! buf, col)
    buf
}

// Build extended hover content with source location.
fn lsph_build_hover_with_location(ctx: &! LsphContext, sym_id: i64) with Mut, Div, Panic {
    // First build the standard hover content
    lsph_build_hover_content(ctx, sym_id)

    if sym_id < 0 || sym_id >= ctx.sym_count {
        return
    }

    // Append source location
    let sym = ctx.symbols[sym_id as usize]
    lsph_hover_buf_append_newline(&! ctx.hover_result)
    let loc = lsph_format_source_location(sym.def_line, sym.col)
    lsph_hover_buf_append_hover(&! ctx.hover_result, &loc)
    lsph_hover_buf_append_newline(&! ctx.hover_result)
}

// ============================================================================
// Section 39: BATCH SYMBOL OPERATIONS
// ============================================================================

// Add a function symbol with full metadata in one call.
fn lsph_add_function(ctx: &! LsphContext, name_hash: i64,
                      line: i64, col: i64, end_line: i64, end_col: i64,
                      type_buf: &LsphTypeBuf, param_count: i64,
                      effects: &LsphEffectBuf) -> i64
    with Mut, Div, Panic
{
    let idx = lsph_add_symbol(ctx, LsphSymbolKind::SymFunction, name_hash,
                               line, col, end_line, end_col)
    if idx == LSPH_INVALID {
        return LSPH_INVALID
    }
    lsph_set_symbol_type(ctx, idx, LsphTypeCategory::TcFunction, type_buf)
    lsph_set_symbol_param_count(ctx, idx, param_count)
    lsph_set_symbol_effects(ctx, idx, effects)
    idx
}

// Add a variable symbol with full metadata in one call.
fn lsph_add_variable(ctx: &! LsphContext, name_hash: i64,
                      line: i64, col: i64, end_line: i64, end_col: i64,
                      type_buf: &LsphTypeBuf, type_cat: LsphTypeCategory,
                      is_mutable: bool) -> i64
    with Mut, Div, Panic
{
    let idx = lsph_add_symbol(ctx, LsphSymbolKind::SymVariable, name_hash,
                               line, col, end_line, end_col)
    if idx == LSPH_INVALID {
        return LSPH_INVALID
    }
    lsph_set_symbol_type(ctx, idx, type_cat, type_buf)
    lsph_set_symbol_mutable(ctx, idx, is_mutable)
    idx
}

// Add a type symbol with full metadata in one call.
fn lsph_add_type_symbol(ctx: &! LsphContext, name_hash: i64,
                         line: i64, col: i64, end_line: i64, end_col: i64,
                         type_cat: LsphTypeCategory) -> i64
    with Mut, Div, Panic
{
    let idx = lsph_add_symbol(ctx, LsphSymbolKind::SymType, name_hash,
                               line, col, end_line, end_col)
    if idx == LSPH_INVALID {
        return LSPH_INVALID
    }
    let empty_tb = lsph_type_buf_new()
    lsph_set_symbol_type(ctx, idx, type_cat, &empty_tb)
    idx
}

// ============================================================================
// Section 40: LINE INDEX HELPERS
// ============================================================================

// Build a line index from a simple array of line-start offsets.
// Used for testing without needing to construct source byte arrays.
fn lsph_set_line_starts(ctx: &! LsphContext, starts: &[i64; 256], count: i64)
    with Mut, Div, Panic
{
    var i: i64 = 0
    while i < count && i < LSPH_MAX_LINES && i < 256 {
        ctx.line_index.line_starts[i as usize] = starts[i as usize]
        i = i + 1
    }
    ctx.line_index.line_count = count
}

// Get the line start for a given line (convenience wrapper).
fn lsph_get_line_start(ctx: &LsphContext, line: i64) -> i64 with Div, Panic {
    lsph_line_start(ctx, line)
}

// Get the line length for a given line (convenience wrapper).
fn lsph_get_line_length(ctx: &LsphContext, line: i64) -> i64 with Div, Panic {
    lsph_line_length(ctx, line)
}

// ============================================================================
// Section 41: TYPE CATEGORY PREDICATE HELPERS
// ============================================================================

// Check if a type category is a primitive.
fn lsph_is_primitive(cat: LsphTypeCategory) -> bool {
    match cat {
        LsphTypeCategory::TcPrimitive => true,
        _ => false,
    }
}

// Check if a type category is a struct.
fn lsph_is_struct(cat: LsphTypeCategory) -> bool {
    match cat {
        LsphTypeCategory::TcStruct => true,
        _ => false,
    }
}

// Check if a type category is an enum.
fn lsph_is_enum(cat: LsphTypeCategory) -> bool {
    match cat {
        LsphTypeCategory::TcEnum => true,
        _ => false,
    }
}

// Check if a type category is a function.
fn lsph_is_function_type(cat: LsphTypeCategory) -> bool {
    match cat {
        LsphTypeCategory::TcFunction => true,
        _ => false,
    }
}

// Check if a type category is an array.
fn lsph_is_array_type(cat: LsphTypeCategory) -> bool {
    match cat {
        LsphTypeCategory::TcArray => true,
        _ => false,
    }
}

// Check if a type category is generic.
fn lsph_is_generic_type(cat: LsphTypeCategory) -> bool {
    match cat {
        LsphTypeCategory::TcGeneric => true,
        _ => false,
    }
}

// Check if a type category is unit.
fn lsph_is_unit_type(cat: LsphTypeCategory) -> bool {
    match cat {
        LsphTypeCategory::TcUnit => true,
        _ => false,
    }
}

// Check if a type category is never.
fn lsph_is_never_type(cat: LsphTypeCategory) -> bool {
    match cat {
        LsphTypeCategory::TcNever => true,
        _ => false,
    }
}

// ============================================================================
// Section 42: HOVER BUFFER SEARCH HELPERS
// ============================================================================

// Find the first occurrence of a byte in a hover buffer.
// Returns the index, or LSPH_INVALID if not found.
fn lsph_hover_buf_find_byte(buf: &LsphHoverBuf, b: i8) -> i64 with Mut, Div, Panic {
    var i: i64 = 0
    while i < buf.len {
        if buf.buf[i as usize] == b {
            return i
        }
        i = i + 1
    }
    LSPH_INVALID
}

// Count occurrences of a byte in a hover buffer.
fn lsph_hover_buf_count_byte(buf: &LsphHoverBuf, b: i8) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < buf.len {
        if buf.buf[i as usize] == b {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Check if a hover buffer starts with a given 3-byte sequence.
fn lsph_hover_buf_starts_with_3(buf: &LsphHoverBuf, b0: i8, b1: i8, b2: i8) -> bool
    with Div, Panic
{
    if buf.len < 3 {
        return false
    }
    buf.buf[0] == b0 && buf.buf[1] == b1 && buf.buf[2] == b2
}

// ============================================================================
// Section 43: PARAM INFO HELPERS
// ============================================================================

// Create a param info from a name hash and a type string.
fn lsph_make_param(name_hash: i64, type_str: &LsphTypeBuf) -> LsphParamInfo with Mut, Div, Panic {
    var pi = lsph_param_info_new()
    pi.name_hash = name_hash
    var i: i64 = 0
    while i < type_str.len && i < LSPH_MAX_TYPE_LEN {
        pi.type_buf.buf[i as usize] = type_str.buf[i as usize]
        i = i + 1
    }
    pi.type_buf.len = type_str.len
    pi
}

// Get the name hash of a param at a given index from the context.
fn lsph_get_param_name(ctx: &LsphContext, index: i64) -> i64 with Div, Panic {
    if index < 0 || index >= LSPH_MAX_PARAMS {
        return 0
    }
    ctx.params_buf[index as usize].name_hash
}

// Get the type buffer length of a param at a given index.
fn lsph_get_param_type_len(ctx: &LsphContext, index: i64) -> i64 with Div, Panic {
    if index < 0 || index >= LSPH_MAX_PARAMS {
        return 0
    }
    ctx.params_buf[index as usize].type_buf.len
}

// ============================================================================
// Section 44: POSITION UTILITIES
// ============================================================================

// Check if a position is before another position.
fn lsph_pos_before(line_a: i64, col_a: i64, line_b: i64, col_b: i64) -> bool {
    if line_a < line_b {
        return true
    }
    if line_a == line_b && col_a < col_b {
        return true
    }
    false
}

// Check if a position is after another position.
fn lsph_pos_after(line_a: i64, col_a: i64, line_b: i64, col_b: i64) -> bool {
    if line_a > line_b {
        return true
    }
    if line_a == line_b && col_a > col_b {
        return true
    }
    false
}

// Check if two positions are equal.
fn lsph_pos_eq(line_a: i64, col_a: i64, line_b: i64, col_b: i64) -> bool {
    line_a == line_b && col_a == col_b
}

// Compute a linear position from line and col (for comparison).
fn lsph_pos_linear(line: i64, col: i64) -> i64 {
    line * 10000 + col
}

// ============================================================================
// Section 45: HOVER RESULT SERIALIZATION
// ============================================================================

// Estimate the Markdown content length of the hover result.
fn lsph_hover_markdown_len(ctx: &LsphContext) -> i64 {
    ctx.hover_result.len
}

// Check if the hover result contains a code fence.
fn lsph_hover_has_code_fence(ctx: &LsphContext) -> bool with Mut, Div, Panic {
    if ctx.hover_result.len < 3 {
        return false
    }
    let b0 = ctx.hover_result.buf[0]
    let b1 = ctx.hover_result.buf[1]
    let b2 = ctx.hover_result.buf[2]
    b0 == LSPH_BYTE_BACKTICK && b1 == LSPH_BYTE_BACKTICK && b2 == LSPH_BYTE_BACKTICK
}

// Check if the hover result contains a horizontal rule.
fn lsph_hover_has_hr(ctx: &LsphContext) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    while i + 2 < ctx.hover_result.len {
        if ctx.hover_result.buf[i as usize] == LSPH_BYTE_DASH &&
           ctx.hover_result.buf[(i + 1) as usize] == LSPH_BYTE_DASH &&
           ctx.hover_result.buf[(i + 2) as usize] == LSPH_BYTE_DASH {
            return true
        }
        i = i + 1
    }
    false
}

// ============================================================================
// Section 46: MAIN ENTRY POINT
// ============================================================================

fn lsph_run_all_tests() -> i64 with Mut, Div, Panic {
    // Run all 70 tests
    var passed: i64 = 0
    var failed: i64 = 0

    // Buffer operations (T01-T10)
    if test_lsph_type_buf_append_byte()    { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_type_buf_append_str()     { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_type_buf_append_i64()     { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_type_buf_append_i64_zero(){ passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_type_buf_eq()             { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_hover_buf_append_byte()   { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_hover_buf_append_type()   { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_hover_buf_append_doc()    { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_hover_buf_append_newline(){ passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_hover_buf_eq()            { passed = passed + 1 } else { failed = failed + 1 }

    // Symbol management (T11-T20)
    if test_lsph_add_symbol_function()     { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_add_symbol_variable()     { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_add_symbol_type()         { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_set_symbol_type()         { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_set_symbol_doc()          { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_set_symbol_effects()      { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_set_symbol_param_count()  { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_set_symbol_mutable()      { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_add_multiple_symbols()    { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_get_symbol_accessors()    { passed = passed + 1 } else { failed = failed + 1 }

    // Symbol search (T21-T30)
    if test_lsph_find_symbol_at_exact()    { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_find_symbol_at_start()    { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_find_symbol_at_end()      { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_find_symbol_at_miss()     { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_find_symbol_at_overlap()  { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_find_symbol_by_hash()     { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_find_symbol_on_line()     { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_count_symbols_of_kind()   { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_find_before_span()        { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_find_multiline_span()     { passed = passed + 1 } else { failed = failed + 1 }

    // Type formatting (T31-T38)
    if test_lsph_format_type_primitive()   { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_format_type_struct()      { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_format_type_enum()        { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_format_type_function()    { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_format_type_array()       { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_format_type_ref()         { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_format_type_mutref()      { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_format_type_unit_never()  { passed = passed + 1 } else { failed = failed + 1 }

    // Hover content (T39-T48)
    if test_lsph_hover_function_basic()    { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_hover_variable_immut()    { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_hover_variable_mut()      { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_hover_type_struct()       { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_hover_with_doc()          { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_hover_with_effects()      { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_hover_constant()          { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_hover_field()             { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_hover_parameter()         { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_hover_module()            { passed = passed + 1 } else { failed = failed + 1 }

    // Signature formatting (T49-T54)
    if test_lsph_format_sig_no_params()    { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_format_sig_with_params()  { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_format_sig_with_effects() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_format_var_hover_let()    { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_format_var_hover_var()    { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_format_type_hover_enum()  { passed = passed + 1 } else { failed = failed + 1 }

    // Line index (T55-T62)
    if test_lsph_line_index_single()       { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_line_index_two()          { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_line_index_three()        { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_line_col_to_offset()      { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_offset_to_line()          { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_offset_to_col()           { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_line_count()              { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_line_col_invalid()        { passed = passed + 1 } else { failed = failed + 1 }

    // Integration (T63-T70)
    if test_lsph_hover_pipeline_function() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_hover_pipeline_miss()     { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_hover_pipeline_variable() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_hover_pipeline_multiple() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_hover_updates_coords()    { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_effect_buf_ops()          { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_format_effect_names()     { passed = passed + 1 } else { failed = failed + 1 }
    if test_lsph_extract_doc_comment_basic() { passed = passed + 1 } else { failed = failed + 1 }

    // Return 0 if all 70 tests passed, otherwise return the failure count
    if failed == 0 {
        return 0
    }
    failed
}
