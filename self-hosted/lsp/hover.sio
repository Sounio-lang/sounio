// T43: Hover with doc comment
fn test_lsph_hover_with_doc_inner(ctx: &! LsphContext) -> bool with Mut, Div, Panic {
    let idx = lsph_add_symbol(ctx, LsphSymbolKind::SymFunction, 42, 5, 0, 5, 30)
    let tb = lsph_make_type_bool()
    lsph_set_symbol_type(ctx, idx, LsphTypeCategory::TcPrimitive, &tb)

    var doc = lsph_doc_buf_new()
    // "Doc text"
    lsph_doc_buf_append_byte(&! doc, 68)  // D
    lsph_doc_buf_append_byte(&! doc, 111) // o
    lsph_doc_buf_append_byte(&! doc, 99)  // c
    lsph_doc_buf_append_byte(&! doc, 32)  // space
    lsph_doc_buf_append_byte(&! doc, 116) // t
    lsph_doc_buf_append_byte(&! doc, 101) // e
    lsph_doc_buf_append_byte(&! doc, 120) // x
    lsph_doc_buf_append_byte(&! doc, 116) // t
    lsph_set_symbol_doc(ctx, idx, &doc)

    lsph_build_hover_content(ctx, idx)
    // Should contain HR (---\n) and doc text
    let ok_len = ctx.hover_result.len > 20
    ok_len
}
fn test_lsph_hover_with_doc() -> bool with Mut, Div, Panic {
    var ctx = lsph_context_new()
    test_lsph_hover_with_doc_inner(&! ctx)
}

