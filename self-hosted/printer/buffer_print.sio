// Buffer-based AST printer for roundtrip testing
//
// Mirrors print_ast.sio logic but writes to a PrintBuffer instead of stdout.
// Only implements the subset needed for roundtrip tests R01-R06:
// fn defs, struct defs, enum defs, let/var stmts, basic exprs.

// ============================================================================
// PRINT BUFFER
// ============================================================================

struct PrintBuffer {
    data: [i8; 4096],
    len: i64,
}

fn pb_new() -> PrintBuffer {
    PrintBuffer { data: [0; 4096], len: 0 }
}

// Push 1-7 bytes
fn bp1(buf: PrintBuffer, a: i8) -> PrintBuffer with Mut, Panic {
    var b = buf
    b.data[b.len as usize] = a
    b.len = b.len + 1
    b
}

fn bp2(buf: PrintBuffer, a: i8, c2: i8) -> PrintBuffer with Mut, Panic {
    var b = buf
    b.data[b.len as usize] = a
    b.data[(b.len + 1) as usize] = c2
    b.len = b.len + 2
    b
}

fn bp3(buf: PrintBuffer, a: i8, c2: i8, c3: i8) -> PrintBuffer with Mut, Panic {
    var b = buf
    b.data[b.len as usize] = a
    b.data[(b.len + 1) as usize] = c2
    b.data[(b.len + 2) as usize] = c3
    b.len = b.len + 3
    b
}

fn bp4(buf: PrintBuffer, a: i8, c2: i8, c3: i8, c4: i8) -> PrintBuffer with Mut, Panic {
    var b = buf
    b.data[b.len as usize] = a
    b.data[(b.len + 1) as usize] = c2
    b.data[(b.len + 2) as usize] = c3
    b.data[(b.len + 3) as usize] = c4
    b.len = b.len + 4
    b
}

fn bp5(buf: PrintBuffer, a: i8, c2: i8, c3: i8, c4: i8, c5: i8) -> PrintBuffer with Mut, Panic {
    var b = buf
    b.data[b.len as usize] = a
    b.data[(b.len + 1) as usize] = c2
    b.data[(b.len + 2) as usize] = c3
    b.data[(b.len + 3) as usize] = c4
    b.data[(b.len + 4) as usize] = c5
    b.len = b.len + 5
    b
}

fn bp6(buf: PrintBuffer, a: i8, c2: i8, c3: i8, c4: i8, c5: i8, c6: i8) -> PrintBuffer with Mut, Panic {
    var b = buf
    b.data[b.len as usize] = a
    b.data[(b.len + 1) as usize] = c2
    b.data[(b.len + 2) as usize] = c3
    b.data[(b.len + 3) as usize] = c4
    b.data[(b.len + 4) as usize] = c5
    b.data[(b.len + 5) as usize] = c6
    b.len = b.len + 6
    b
}

fn bp7(buf: PrintBuffer, a: i8, c2: i8, c3: i8, c4: i8, c5: i8, c6: i8, c7: i8) -> PrintBuffer with Mut, Panic {
    var b = buf
    b.data[b.len as usize] = a
    b.data[(b.len + 1) as usize] = c2
    b.data[(b.len + 2) as usize] = c3
    b.data[(b.len + 3) as usize] = c4
    b.data[(b.len + 4) as usize] = c5
    b.data[(b.len + 5) as usize] = c6
    b.data[(b.len + 6) as usize] = c7
    b.len = b.len + 7
    b
}

// ============================================================================
// NAME AND INT PRINTING
// ============================================================================

fn bp_name(buf: PrintBuffer, name: Name) -> PrintBuffer with Mut, Panic, Div {
    var b = buf
    var i: i64 = 0
    while i < name.len {
        b.data[b.len as usize] = name.buf[i as usize]
        b.len = b.len + 1
        i = i + 1
    }
    b
}

fn bp_int(buf: PrintBuffer, value: i64) -> PrintBuffer with Mut, Panic, Div {
    var b = buf
    var n = value
    if n < 0 {
        b = bp1(b, 45)  // '-'
        n = 0 - n
    }
    if n == 0 {
        return bp1(b, 48)  // '0'
    }
    // Find highest power of 10
    var divisor: i64 = 1
    var tmp = n
    while tmp >= 10 {
        divisor = divisor * 10
        tmp = tmp / 10
    }
    // Emit digits
    while divisor > 0 {
        let digit = n / divisor
        b = bp1(b, (48 + digit) as i8)
        n = n % divisor
        divisor = divisor / 10
    }
    b
}

fn bp_indent(buf: PrintBuffer, level: i64) -> PrintBuffer with Mut, Panic, Div {
    var b = buf
    var i: i64 = 0
    while i < level {
        // "    " (4 spaces)
        b = bp4(b, 32, 32, 32, 32)
        i = i + 1
    }
    b
}

// ============================================================================
// PATH PRINTING
// ============================================================================

fn bp_string_list_segment(buf: PrintBuffer, seg: StringList) -> PrintBuffer with Mut, Panic, Div, Alloc {
    var b = buf
    var i: i64 = 0
    while i < seg.head_len {
        b.data[b.len as usize] = seg.head_buf[i as usize]
        b.len = b.len + 1
        i = i + 1
    }
    b
}

fn bp_path_segments(buf: PrintBuffer, segs: Option<Box<StringList>>, remaining: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match segs {
        Some(list) => {
            var b = bp_string_list_segment(buf, *list)
            if remaining > 1 {
                b = bp2(b, 58, 58)  // "::"
                b = bp_path_segments(b, (*list).tail, remaining - 1)
            }
            b
        }
        None => buf,
    }
}

fn bp_path(buf: PrintBuffer, path: AstPath) -> PrintBuffer with Mut, Panic, Div, Alloc {
    bp_path_segments(buf, Some(Box::new(path.segments)), path.seg_count)
}

// ============================================================================
// TYPE EXPRESSION PRINTING
// ============================================================================

fn bp_type_expr(buf: PrintBuffer, te: TypeExpr) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match te.kind {
        TypeNamed => {
            var b = bp_path(buf, te.path)
            bp_type_args_opt(b, te.type_args)
        }
        TypeReference => {
            var b = bp1(buf, 38)  // "&"
            bp_type_inner(b, te.inner)
        }
        TypeRefMut => {
            var b = bp2(buf, 38, 33)  // "&!"
            bp_type_inner(b, te.inner)
        }
        TypeArray => {
            var b = bp1(buf, 91)  // "["
            b = bp_type_inner(b, te.inner)
            b = bp_array_size(b, te.array_size)
            bp1(b, 93)  // "]"
        }
        TypeUnit => bp2(buf, 40, 41)  // "()"
        TypeNever => bp1(buf, 33)  // "!"
        TypeSelfUpper => bp4(buf, 83, 101, 108, 102)  // "Self"
        TypeInfer => bp1(buf, 95)  // "_"
        TypeModel => {
            var b = bp5(buf, 77, 111, 100, 101, 108)  // "Model"
            bp_type_args_opt(b, te.type_args)
        }
        TypePolicy => {
            var b = bp6(buf, 80, 111, 108, 105, 99, 121)  // "Policy"
            bp_type_args_opt(b, te.type_args)
        }
        TypeAcquisitionPolicy => {
            var b = bp7(buf, 65, 99, 113, 117, 105, 115, 105)  // "Acquisi"
            b = bp4(b, 116, 105, 111, 110)  // "tion"
            b = bp6(b, 80, 111, 108, 105, 99, 121)  // "Policy"
            bp_type_args_opt(b, te.type_args)
        }
        TypeAcquisitionPlan => {
            var b = bp7(buf, 65, 99, 113, 117, 105, 115, 105)  // "Acquisi"
            b = bp4(b, 116, 105, 111, 110)  // "tion"
            b = bp4(b, 80, 108, 97, 110)  // "Plan"
            bp_type_args_opt(b, te.type_args)
        }
        TypeRecoursePolicy => {
            var b = bp7(buf, 82, 101, 99, 111, 117, 114, 115)  // "Recours"
            b = bp1(b, 101)  // "e"
            b = bp6(b, 80, 111, 108, 105, 99, 121)  // "Policy"
            bp_type_args_opt(b, te.type_args)
        }
        TypeRecoursePlan => {
            var b = bp7(buf, 82, 101, 99, 111, 117, 114, 115)  // "Recours"
            b = bp1(b, 101)  // "e"
            b = bp4(b, 80, 108, 97, 110)  // "Plan"
            bp_type_args_opt(b, te.type_args)
        }
        TypeDecisionPolicy => {
            var b = bp7(buf, 68, 101, 99, 105, 115, 105, 111)  // "Decisio"
            b = bp7(b, 110, 80, 111, 108, 105, 99, 121)  // "nPolicy"
            bp_type_args_opt(b, te.type_args)
        }
        TypeDeferralPolicy => {
            var b = bp7(buf, 68, 101, 102, 101, 114, 114, 97)  // "Deferra"
            b = bp7(b, 108, 80, 111, 108, 105, 99, 121)  // "lPolicy"
            bp_type_args_opt(b, te.type_args)
        }
        TypeContest => {
            var b = bp7(buf, 67, 111, 110, 116, 101, 115, 116)  // "Contest"
            bp_type_args_opt(b, te.type_args)
        }
        TypeRobust => {
            var b = bp6(buf, 82, 111, 98, 117, 115, 116)  // "Robust"
            bp_type_args_opt(b, te.type_args)
        }
        TypeValidated => {
            var b = bp9(buf, 86, 97, 108, 105, 100, 97, 116, 101, 100)  // "Validated"
            bp_type_args_opt(b, te.type_args)
        }
        TypeAdmissible => {
            var b = bp7(buf, 65, 100, 109, 105, 115, 115, 105)  // "Admissi"
            b = bp3(b, 98, 108, 101)  // "ble"
            bp_type_args_opt(b, te.type_args)
        }
        TypeDeferred => {
            var b = bp7(buf, 68, 101, 102, 101, 114, 114, 101)  // "Deferre"
            b = bp1(b, 100)  // "d"
            bp_type_args_opt(b, te.type_args)
        }
        _ => buf,
    }
}

fn bp_type_inner(buf: PrintBuffer, opt: Option<Box<TypeExpr>>) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(te) => bp_type_expr(buf, *te)
        None => buf,
    }
}

fn bp_type_args_opt(buf: PrintBuffer, opt: Option<Box<TypeExprList>>) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            var b = bp1(buf, 60)  // "<"
            b = bp_type_list_comma(*list, b, true)
            bp1(b, 62)  // ">"
        }
        None => buf,
    }
}

fn bp_type_list_comma(list: TypeExprList, buf: PrintBuffer, first: bool) -> PrintBuffer with Mut, Panic, Div, Alloc {
    var b = buf
    if !first {
        b = bp2(b, 44, 32)  // ", "
    }
    b = bp_type_expr(b, list.head)
    match list.tail {
        Some(rest) => bp_type_list_comma(*rest, b, false)
        None => b,
    }
}

fn bp_array_size(buf: PrintBuffer, opt: Option<Box<Expr>>) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(e) => {
            var b = bp2(buf, 59, 32)  // "; "
            bp_expr(b, *e)
        }
        None => buf,
    }
}

// ============================================================================
// EFFECT LIST PRINTING
// ============================================================================

fn bp_effect_list_opt(buf: PrintBuffer, opt: Option<Box<EffectList>>) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            // " with "
            var b = bp6(buf, 32, 119, 105, 116, 104, 32)
            bp_effect_list_inner(*list, b, true)
        }
        None => buf,
    }
}

fn bp_effect_list_inner(list: EffectList, buf: PrintBuffer, first: bool) -> PrintBuffer with Mut, Panic, Div, Alloc {
    var b = buf
    if !first {
        b = bp2(b, 44, 32)  // ", "
    }
    b = bp_effect_ref(b, list.head)
    match list.tail {
        Some(rest) => bp_effect_list_inner(*rest, b, false)
        None => b,
    }
}

fn bp_effect_ref(buf: PrintBuffer, eff: EffectRef) -> PrintBuffer with Mut, Panic, Div {
    var b = buf
    var i: i64 = 0
    while i < eff.name_len {
        b.data[b.len as usize] = eff.name_buf[i as usize]
        b.len = b.len + 1
        i = i + 1
    }
    b
}

// ============================================================================
// EXPRESSION PRINTING
// ============================================================================

fn bp_expr(buf: PrintBuffer, e: Expr) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match e.kind {
        ExprIntLit => bp_int(buf, e.int_val)
        ExprBoolTrue => bp4(buf, 116, 114, 117, 101)   // "true"
        ExprBoolFalse => bp5(buf, 102, 97, 108, 115, 101)  // "false"
        ExprStringLit => {
            var b = bp1(buf, 34)  // '"'
            b = bp_name(b, e.name)
            bp1(b, 34)  // '"'
        }
        ExprIdent => bp_name(buf, e.name)
        ExprPath => bp_path(buf, e.path)
        ExprBinary => {
            var b = bp_expr_opt(buf, e.left)
            b = bp_binop(b, e.bin_op)
            bp_expr_opt(b, e.right)
        }
        ExprUnary => {
            var b = bp_unaryop(buf, e.un_op)
            bp_expr_opt(b, e.left)
        }
        ExprFieldAccess => {
            var b = bp_expr_opt(buf, e.left)
            b = bp1(b, 46)  // "."
            bp_name(b, e.name)
        }
        ExprIndex => {
            var b = bp_expr_opt(buf, e.left)
            b = bp1(b, 91)  // "["
            b = bp_expr_opt(b, e.right)
            bp1(b, 93)  // "]"
        }
        ExprCall => {
            var b = bp_expr_opt(buf, e.left)
            b = bp1(b, 40)  // "("
            b = bp_expr_list_comma(b, e.args)
            bp1(b, 41)  // ")"
        }
        ExprContest => {
            // "contest "
            var b = bp7(buf, 99, 111, 110, 116, 101, 115, 116)
            b = bp1(b, 32)  // " "
            b = bp1(b, 91)  // "["
            b = bp_expr_list_comma(b, e.args)
            b = bp3(b, 93, 32, 111)  // "] o"
            b = bp2(b, 110, 32)  // "n "
            bp_expr_opt(b, e.left)
        }
        ExprAuditAttach => {
            var b = bp_expr_opt(buf, e.left)
            b = bp7(b, 32, 97, 117, 100, 105, 116, 32)  // " audit "
            bp_name(b, e.name)
        }
        ExprIf => {
            // "if "
            var b = bp3(buf, 105, 102, 32)
            b = bp_expr_opt(b, e.left)
            b = bp1(b, 32)  // " "
            b = bp_block_opt(b, e.block, 0)
            bp_else_opt(b, e.else_expr)
        }
        ExprWhile => {
            // "while "
            var b = bp6(buf, 119, 104, 105, 108, 101, 32)
            b = bp_expr_opt(b, e.left)
            b = bp1(b, 32)  // " "
            bp_block_opt(b, e.block, 0)
        }
        ExprBlock => bp_block_opt(buf, e.block, 0)
        ExprReturn => {
            // "return"
            var b = bp6(buf, 114, 101, 116, 117, 114, 110)
            bp_return_val(b, e.left)
        }
        ExprBreak => {
            // "break"
            var b = bp5(buf, 98, 114, 101, 97, 107)
            bp_return_val(b, e.left)
        }
        ExprContinue => {
            // "continue"
            var b = bp1(buf, 99)   // c
            b = bp1(b, 111)  // o
            b = bp1(b, 110)  // n
            b = bp1(b, 116)  // t
            b = bp1(b, 105)  // i
            b = bp1(b, 110)  // n
            b = bp1(b, 117)  // u
            bp1(b, 101)      // e
        }
        ExprStructLit => {
            var b = bp_path(buf, e.path)
            b = bp3(b, 32, 123, 32)  // " { "
            b = bp_struct_fields(b, e.fields)
            bp2(b, 32, 125)  // " }"
        }
        ExprArrayLit => {
            var b = bp1(buf, 91)  // "["
            b = bp_expr_list_comma(b, e.args)
            bp1(b, 93)  // "]"
        }
        ExprMatch => {
            // "match "
            var b = bp6(buf, 109, 97, 116, 99, 104, 32)
            b = bp_expr_opt(b, e.left)
            b = bp3(b, 32, 123, 10)  // " {\n"
            b = bp_match_arms(b, e.arms, 1)
            bp1(b, 125)  // "}"
        }
        _ => buf,
    }
}

fn bp_expr_opt(buf: PrintBuffer, opt: Option<Box<Expr>>) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(e) => bp_expr(buf, *e)
        None => buf,
    }
}

fn bp_return_val(buf: PrintBuffer, opt: Option<Box<Expr>>) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(e) => {
            var b = bp1(buf, 32)  // " "
            bp_expr(b, *e)
        }
        None => buf,
    }
}

fn bp_else_opt(buf: PrintBuffer, opt: Option<Box<Expr>>) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(e) => {
            // " else "
            var b = bp6(buf, 32, 101, 108, 115, 101, 32)
            bp_expr(b, *e)
        }
        None => buf,
    }
}

fn bp_binop(buf: PrintBuffer, op: BinaryOp) -> PrintBuffer with Mut, Panic {
    match op {
        OpAdd => bp3(buf, 32, 43, 32)       // " + "
        OpSub => bp3(buf, 32, 45, 32)       // " - "
        OpMul => bp3(buf, 32, 42, 32)       // " * "
        OpDiv => bp3(buf, 32, 47, 32)       // " / "
        OpRem => bp3(buf, 32, 37, 32)       // " % "
        OpEq => bp4(buf, 32, 61, 61, 32)    // " == "
        OpNe => bp4(buf, 32, 33, 61, 32)    // " != "
        OpLt => bp3(buf, 32, 60, 32)        // " < "
        OpLe => bp4(buf, 32, 60, 61, 32)    // " <= "
        OpGt => bp3(buf, 32, 62, 32)        // " > "
        OpGe => bp4(buf, 32, 62, 61, 32)    // " >= "
        OpAnd => bp4(buf, 32, 38, 38, 32)   // " && "
        OpOr => bp4(buf, 32, 124, 124, 32)  // " || "
        OpBitAnd => bp3(buf, 32, 38, 32)    // " & "
        OpBitOr => bp3(buf, 32, 124, 32)    // " | "
        OpBitXor => bp3(buf, 32, 94, 32)    // " ^ "
        OpShl => bp4(buf, 32, 60, 60, 32)   // " << "
        OpShr => bp4(buf, 32, 62, 62, 32)   // " >> "
        OpConcat => bp4(buf, 32, 43, 43, 32)  // " ++ "
        OpRange => bp2(buf, 46, 46)          // ".."
        OpRangeInclusive => bp3(buf, 46, 46, 61)  // "..="
    }
}

fn bp_unaryop(buf: PrintBuffer, op: UnaryOp) -> PrintBuffer with Mut, Panic {
    match op {
        OpNeg => bp1(buf, 45)       // "-"
        OpNot => bp1(buf, 33)       // "!"
        OpRef => bp1(buf, 38)       // "&"
        OpRefMut => bp2(buf, 38, 33)  // "&!"
        OpDeref => bp1(buf, 42)     // "*"
    }
}

fn bp_expr_list_comma(buf: PrintBuffer, opt: Option<Box<ExprList>>) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => bp_expr_list_inner(*list, buf, true)
        None => buf,
    }
}

fn bp_expr_list_inner(list: ExprList, buf: PrintBuffer, first: bool) -> PrintBuffer with Mut, Panic, Div, Alloc {
    var b = buf
    if !first {
        b = bp2(b, 44, 32)  // ", "
    }
    if !name_is_empty(list.label) {
        b = bp_name(b, list.label)
        b = bp2(b, 58, 32)  // ": "
    }
    b = bp_expr(b, list.head)
    match list.tail {
        Some(rest) => bp_expr_list_inner(*rest, b, false)
        None => b,
    }
}

fn bp_struct_fields(buf: PrintBuffer, opt: Option<Box<StructFieldList>>) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => bp_struct_fields_inner(*list, buf, true)
        None => buf,
    }
}

fn bp_struct_fields_inner(list: StructFieldList, buf: PrintBuffer, first: bool) -> PrintBuffer with Mut, Panic, Div, Alloc {
    var b = buf
    if !first {
        b = bp2(b, 44, 32)  // ", "
    }
    b = bp_name(b, list.head.name)
    b = bp2(b, 58, 32)  // ": "
    b = bp_expr(b, list.head.value)
    match list.tail {
        Some(rest) => bp_struct_fields_inner(*rest, b, false)
        None => b,
    }
}

fn bp_match_arms(buf: PrintBuffer, opt: Option<Box<MatchArmList>>, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => bp_match_arms_inner(*list, buf, indent)
        None => buf,
    }
}

fn bp_match_arms_inner(list: MatchArmList, buf: PrintBuffer, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    var b = bp_indent(buf, indent)
    b = bp_pattern(b, list.head.pattern)
    // " => "
    b = bp4(b, 32, 61, 62, 32)
    b = bp_expr(b, list.head.body)
    b = bp1(b, 10)  // "\n"
    match list.tail {
        Some(rest) => bp_match_arms_inner(*rest, b, indent)
        None => b,
    }
}

fn bp_pattern(buf: PrintBuffer, pat: Pattern) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match pat.kind {
        PatWildcard => bp1(buf, 95)  // "_"
        PatBinding => {
            var b = buf
            if pat.is_mut {
                b = bp4(b, 118, 97, 114, 32)  // "var "
            }
            bp_name(b, pat.name)
        }
        PatIntLit => bp_int(buf, pat.int_val)
        PatBoolTrue => bp4(buf, 116, 114, 117, 101)   // "true"
        PatBoolFalse => bp5(buf, 102, 97, 108, 115, 101)  // "false"
        PatEnum => bp_path(buf, pat.path)
        _ => buf,
    }
}

// ============================================================================
// BLOCK AND STATEMENT PRINTING
// ============================================================================

fn bp_block_opt(buf: PrintBuffer, opt: Option<Box<Block>>, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(blk) => bp_block(buf, *blk, indent)
        None => buf,
    }
}

fn bp_block(buf: PrintBuffer, blk: Block, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    var b = bp2(buf, 123, 10)  // "{\n"
    b = bp_stmt_list(b, blk.stmts, indent + 1)
    b = bp_indent(b, indent)
    bp1(b, 125)  // "}"
}

fn bp_stmt_list(buf: PrintBuffer, opt: Option<Box<StmtList>>, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => bp_stmt_list_inner(*list, buf, indent)
        None => buf,
    }
}

fn bp_stmt_list_inner(list: StmtList, buf: PrintBuffer, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    var b = bp_indent(buf, indent)
    b = bp_stmt(b, list.head, indent)
    b = bp1(b, 10)  // "\n"
    match list.tail {
        Some(rest) => bp_stmt_list_inner(*rest, b, indent)
        None => b,
    }
}

fn bp_stmt(buf: PrintBuffer, s: Stmt, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match s.kind {
        StmtLet => {
            // "let "
            var b = bp4(buf, 108, 101, 116, 32)
            b = bp_name(b, s.name)
            b = bp_optional_type_annot(b, s.ty)
            bp_optional_init(b, s.expr)
        }
        StmtVar => {
            // "var "
            var b = bp4(buf, 118, 97, 114, 32)
            b = bp_name(b, s.name)
            b = bp_optional_type_annot(b, s.ty)
            bp_optional_init(b, s.expr)
        }
        StmtExpr => bp_expr_opt(buf, s.expr)
        StmtAssign => {
            var b = bp_expr_opt(buf, s.target)
            b = bp_assign_op(b, s.assign_op)
            bp_expr_opt(b, s.expr)
        }
    }
}

fn bp_optional_type_annot(buf: PrintBuffer, opt: Option<Box<TypeExpr>>) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(te) => {
            var b = bp2(buf, 58, 32)  // ": "
            bp_type_expr(b, *te)
        }
        None => buf,
    }
}

fn bp_optional_init(buf: PrintBuffer, opt: Option<Box<Expr>>) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(e) => {
            var b = bp3(buf, 32, 61, 32)  // " = "
            bp_expr(b, *e)
        }
        None => buf,
    }
}

fn bp_assign_op(buf: PrintBuffer, op: AssignOp) -> PrintBuffer with Mut, Panic {
    match op {
        AssignEq => bp3(buf, 32, 61, 32)       // " = "
        AssignAdd => bp4(buf, 32, 43, 61, 32)   // " += "
        AssignSub => bp4(buf, 32, 45, 61, 32)   // " -= "
        AssignMul => bp4(buf, 32, 42, 61, 32)   // " *= "
        AssignDiv => bp4(buf, 32, 47, 61, 32)   // " /= "
        AssignRem => bp4(buf, 32, 37, 61, 32)   // " %= "
    }
}

// ============================================================================
// ITEM PRINTING
// ============================================================================

fn bp_item_list_top(buf: PrintBuffer, opt: Option<Box<ItemList>>) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => bp_item_list_top_inner(buf, *list)
        None => buf,
    }
}

fn bp_item_list_top_inner(buf: PrintBuffer, list: ItemList) -> PrintBuffer with Mut, Panic, Div, Alloc {
    var b = bp_item(buf, list.head, 0)
    b = bp1(b, 10)  // "\n"
    match list.tail {
        Some(rest) => {
            b = bp1(b, 10)  // "\n"
            bp_item_list_top_inner(b, *rest)
        }
        None => b,
    }
}

fn bp_policy_compare_op(buf: PrintBuffer, op: CompareOp) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match op {
        CmpLt => bp1(buf, 60)  // "<"
        CmpLe => bp2(buf, 60, 61)  // "<="
        CmpEq => bp2(buf, 61, 61)  // "=="
        CmpGe => bp2(buf, 62, 61)  // ">="
        CmpGt => bp1(buf, 62)  // ">"
    }
}

fn bp_policy_threshold(buf: PrintBuffer, value: f64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    let milli = (value * 1000.0) as i64
    var b = bp_int(buf, milli)
    b = bp1(b, 47)  // "/"
    bp4(b, 49, 48, 48, 48)  // "1000"
}

fn bp_policy_requirement_value(buf: PrintBuffer, req: PolicyRequirement) -> PrintBuffer with Mut, Panic, Div, Alloc {
    if req.threshold_kind == 1 {
        if req.bool_threshold { bp4(buf, 116, 114, 117, 101) } else { bp5(buf, 102, 97, 108, 115, 101) }
    } else if req.threshold_kind == 2 {
        bp_name(buf, req.name_threshold)
    } else {
        bp_policy_threshold(buf, req.threshold)
    }
}

fn bp_policy_requirements(buf: PrintBuffer, opt: Option<Box<PolicyRequirementList>>, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            var b = bp_indent(buf, indent)
            b = bp7(b, 114, 101, 113, 117, 105, 114, 101)  // "require"
            b = bp1(b, 32)
            b = bp_name(b, (*list).head.metric_name)
            b = bp1(b, 32)
            b = bp_policy_compare_op(b, (*list).head.op)
            b = bp1(b, 32)
            b = bp_policy_requirement_value(b, (*list).head)
            b = bp1(b, 10)
            bp_policy_requirements(b, (*list).tail, indent)
        }
        None => buf,
    }
}

fn bp_policy_item(buf: PrintBuffer, opt: Option<Box<PolicyDef>>, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(pd) => {
            var b = bp_indent(buf, indent)
            b = bp6(b, 112, 111, 108, 105, 99, 121)  // "policy"
            b = bp1(b, 32)
            b = bp_name(b, (*pd).name)
            b = bp5(b, 32, 102, 111, 114, 32)  // " for "
            b = bp_type_expr(b, (*pd).target_type)
            if !name_is_empty((*pd).level_name) {
                b = bp7(b, 32, 108, 101, 118, 101, 108, 32)  // " level "
                b = bp_name(b, (*pd).level_name)
            }
            if !name_is_empty((*pd).scope_name) {
                b = bp7(b, 32, 115, 99, 111, 112, 101, 32)  // " scope "
                b = bp_name(b, (*pd).scope_name)
            }
            b = bp3(b, 32, 123, 10)  // " {\n"
            b = bp_policy_requirements(b, (*pd).requirements, indent + 1)
            b = bp_indent(b, indent)
            bp1(b, 125)  // "}"
        }
        None => buf,
    }
}

fn bp_acquisition_policy_item(buf: PrintBuffer, opt: Option<Box<AcquisitionPolicyDef>>, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(ap) => {
            var b = bp_indent(buf, indent)
            b = bp7(b, 97, 99, 113, 117, 105, 115, 105)  // "acquisi"
            b = bp7(b, 116, 105, 111, 110, 95, 112, 111)  // "tion_po"
            b = bp5(b, 108, 105, 99, 121, 32)  // "licy "
            b = bp_name(b, (*ap).name)
            b = bp5(b, 32, 102, 111, 114, 32)  // " for "
            b = bp_type_expr(b, (*ap).target_type)
            if !name_is_empty((*ap).objective_name) {
                b = bp7(b, 32, 111, 98, 106, 101, 99, 116)  // " object"
                b = bp4(b, 105, 118, 101, 32)  // "ive "
                b = bp_name(b, (*ap).objective_name)
            }
            if !name_is_empty((*ap).route_name) {
                b = bp7(b, 32, 114, 111, 117, 116, 101, 32)  // " route "
                b = bp_name(b, (*ap).route_name)
            }
            b = bp3(b, 32, 123, 10)  // " {\n"
            b = bp_policy_requirements(b, (*ap).requirements, indent + 1)
            b = bp_indent(b, indent)
            bp1(b, 125)  // "}"
        }
        None => buf,
    }
}

fn bp_recourse_policy_item(buf: PrintBuffer, opt: Option<Box<RecoursePolicyDef>>, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(rp) => {
            var b = bp_indent(buf, indent)
            b = bp7(b, 114, 101, 99, 111, 117, 114, 115)  // "recours"
            b = bp7(b, 101, 95, 112, 111, 108, 105, 99)  // "e_polic"
            b = bp2(b, 121, 32)  // "y "
            b = bp_name(b, (*rp).name)
            b = bp5(b, 32, 102, 111, 114, 32)  // " for "
            b = bp_type_expr(b, (*rp).target_type)
            if !name_is_empty((*rp).strategy_name) {
                b = bp7(b, 32, 115, 116, 114, 97, 116, 101)  // " strate"
                b = bp3(b, 103, 121, 32)  // "gy "
                b = bp_name(b, (*rp).strategy_name)
            }
            if !name_is_empty((*rp).route_name) {
                b = bp7(b, 32, 114, 111, 117, 116, 101, 32)  // " route "
                b = bp_name(b, (*rp).route_name)
            }
            b = bp3(b, 32, 123, 10)  // " {\n"
            b = bp_policy_requirements(b, (*rp).requirements, indent + 1)
            b = bp_indent(b, indent)
            bp1(b, 125)  // "}"
        }
        None => buf,
    }
}

fn bp_ast_path_list(buf: PrintBuffer, opt: Option<Box<AstPathList>>) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => bp_ast_path_list_inner(*list, buf, true)
        None => buf,
    }
}

fn bp_ast_path_list_inner(list: AstPathList, buf: PrintBuffer, first: bool) -> PrintBuffer with Mut, Panic, Div, Alloc {
    var b = buf
    if !first {
        b = bp2(b, 44, 32)
    }
    b = bp_path(b, list.head)
    match list.tail {
        Some(rest) => bp_ast_path_list_inner(*rest, b, false)
        None => b,
    }
}

fn bp_models_item(buf: PrintBuffer, opt: Option<Box<ModelsDef>>, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(md) => {
            var b = bp_indent(buf, indent)
            b = bp7(b, 109, 111, 100, 101, 108, 115, 32)  // "models "
            b = bp_name(b, (*md).name)
            b = bp4(b, 32, 61, 32, 91)  // " = ["
            b = bp_ast_path_list(b, (*md).models)
            bp1(b, 93)  // "]"
        }
        None => buf,
    }
}

fn bp_validation_item(buf: PrintBuffer, opt: Option<Box<ValidationDef>>, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(vd) => {
            var b = bp_indent(buf, indent)
            b = bp7(b, 118, 97, 108, 105, 100, 97, 116)  // "validat"
            b = bp4(b, 105, 111, 110, 32)  // "ion "
            b = bp_name(b, (*vd).name)
            b = bp5(b, 32, 102, 111, 114, 32)  // " for "
            b = bp_type_expr(b, (*vd).target_type)
            b = bp3(b, 32, 123, 125)  // " {}"
            b
        }
        None => buf,
    }
}

fn bp_audit_field_entry(buf: PrintBuffer, entry: AuditFieldEntry, first: bool) -> PrintBuffer with Mut, Panic, Div, Alloc {
    var b = buf
    if !first {
        b = bp2(b, 44, 32)  // ", "
    }
    b = bp_name(b, entry.name)
    b = bp2(b, 58, 32)  // ": "
    if entry.value_kind == AuditValueKind::AuditValueFloat {
        bp_policy_threshold(b, entry.value_f64)
    } else {
        bp_name(b, entry.value_name)
    }
}

fn bp_audit_field_entries(buf: PrintBuffer, opt: Option<Box<AuditFieldEntryList>>, first: bool) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            var b = bp_audit_field_entry(buf, (*list).head, first)
            bp_audit_field_entries(b, (*list).tail, false)
        }
        None => buf,
    }
}

fn bp_audit_sections(buf: PrintBuffer, opt: Option<Box<AuditSectionList>>, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            var b = bp_indent(buf, indent)
            b = bp_name(b, (*list).head.name)
            b = bp3(b, 32, 123, 32)  // " { "
            b = bp_audit_field_entries(b, (*list).head.fields, true)
            b = bp3(b, 32, 125, 10)  // " }\n"
            bp_audit_sections(b, (*list).tail, indent)
        }
        None => buf,
    }
}

fn bp_audit_item(buf: PrintBuffer, opt: Option<Box<AuditDef>>, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(ad) => {
            var b = bp_indent(buf, indent)
            b = bp5(b, 97, 117, 100, 105, 116)  // "audit"
            b = bp1(b, 32)
            b = bp_name(b, (*ad).name)
            b = bp5(b, 32, 102, 111, 114, 32)  // " for "
            b = bp_type_expr(b, (*ad).target_type)
            b = bp3(b, 32, 123, 10)  // " {\n"
            b = bp_audit_sections(b, (*ad).sections, indent + 1)
            b = bp_indent(b, indent)
            bp1(b, 125)  // "}"
        }
        None => buf,
    }
}

fn bp_item(buf: PrintBuffer, item: Item, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match item.kind {
        ItemFn => bp_fn_item(buf, item.fn_def, indent)
        ItemStruct => bp_struct_item(buf, item.name, item.struct_def, indent)
        ItemEnum => bp_enum_item(buf, item.name, item.enum_def, indent)
        ItemImpl => bp_impl_item(buf, item.impl_def, indent)
        ItemTypeAlias => {
            var b = bp_indent(buf, indent)
            // "type "
            b = bp5(b, 116, 121, 112, 101, 32)
            b = bp_name(b, item.name)
            b = bp3(b, 32, 61, 32)  // " = "
            bp_type_inner(b, item.type_alias_ty)
        }
        ItemModels => bp_models_item(buf, item.models_def, indent)
        ItemPolicy => bp_policy_item(buf, item.policy_def, indent)
        ItemAcquisitionPolicy => bp_acquisition_policy_item(buf, item.acquisition_policy_def, indent)
        ItemRecoursePolicy => bp_recourse_policy_item(buf, item.recourse_policy_def, indent)
        ItemDecisionPolicy => bp_decision_policy_item(buf, item.decision_policy_def, indent)
        ItemDeferralPolicy => bp_deferral_policy_item(buf, item.deferral_policy_def, indent)
        ItemValidation => bp_validation_item(buf, item.validation_def, indent)
        ItemAudit => bp_audit_item(buf, item.audit_def, indent)
        ItemUse => {
            var b = bp_indent(buf, indent)
            // "use "
            b = bp4(b, 117, 115, 101, 32)
            bp_path(b, item.use_path)
        }
        ItemUnit => {
            var b = bp_indent(buf, indent)
            // "unit "
            b = bp5(b, 117, 110, 105, 116, 32)
            b = bp_name(b, item.name)
            bp1(b, 59)  // ";"
        }
    }
}

fn bp_decision_policy_item(buf: PrintBuffer, opt: Option<Box<DecisionPolicyDef>>, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(dd) => {
            var b = bp_indent(buf, indent)
            b = bp7(b, 100, 101, 99, 105, 115, 105, 111)  // "decisio"
            b = bp7(b, 110, 95, 112, 111, 108, 105, 99)  // "n_polic"
            b = bp2(b, 121, 32)  // "y "
            b = bp_name(b, (*dd).name)
            b = bp5(b, 32, 102, 111, 114, 32)  // " for "
            b = bp_type_expr(b, (*dd).target_type)
            b = bp3(b, 32, 123, 10)  // " {\n"
            b = bp_policy_requirements(b, (*dd).requirements, indent + 1)
            b = bp_indent(b, indent)
            bp1(b, 125)  // "}"
        }
        None => buf,
    }
}

fn bp_deferral_policy_item(buf: PrintBuffer, opt: Option<Box<DeferralPolicyDef>>, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(dd) => {
            var b = bp_indent(buf, indent)
            b = bp7(b, 100, 101, 102, 101, 114, 114, 97)  // "deferra"
            b = bp7(b, 108, 95, 112, 111, 108, 105, 99)  // "l_polic"
            b = bp2(b, 121, 32)  // "y "
            b = bp_name(b, (*dd).name)
            b = bp5(b, 32, 102, 111, 114, 32)  // " for "
            b = bp_type_expr(b, (*dd).target_type)
            if !name_is_empty((*dd).route_name) {
                b = bp7(b, 32, 114, 111, 117, 116, 101, 32)  // " route "
                b = bp_name(b, (*dd).route_name)
            }
            b = bp3(b, 32, 123, 10)  // " {\n"
            b = bp_policy_requirements(b, (*dd).requirements, indent + 1)
            b = bp_indent(b, indent)
            bp1(b, 125)  // "}"
        }
        None => buf,
    }
}

// ============================================================================
// FUNCTION DEFINITION
// ============================================================================

fn bp_fn_item(buf: PrintBuffer, opt: Option<Box<FnDef>>, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(fd) => bp_fn_def(buf, *fd, indent)
        None => buf,
    }
}

fn bp_fn_def(buf: PrintBuffer, fd: FnDef, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    var b = bp_indent(buf, indent)
    // "fn "
    b = bp3(b, 102, 110, 32)
    b = bp_name(b, fd.name)
    b = bp1(b, 40)  // "("
    b = bp_param_list(b, fd.params)
    b = bp1(b, 41)  // ")"
    b = bp_optional_return(b, fd.return_type)
    b = bp_effect_list_opt(b, fd.effects)
    b = bp1(b, 32)  // " "
    bp_block(b, fd.body, indent)
}

fn bp_optional_return(buf: PrintBuffer, opt: Option<Box<TypeExpr>>) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(te) => {
            // " -> "
            var b = bp4(buf, 32, 45, 62, 32)
            bp_type_expr(b, *te)
        }
        None => buf,
    }
}

fn bp_param_list(buf: PrintBuffer, opt: Option<Box<ParamList>>) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => bp_param_list_inner(*list, buf, true)
        None => buf,
    }
}

fn bp_param_list_inner(list: ParamList, buf: PrintBuffer, first: bool) -> PrintBuffer with Mut, Panic, Div, Alloc {
    var b = buf
    if !first {
        b = bp2(b, 44, 32)  // ", "
    }
    b = bp_param(b, list.head)
    match list.tail {
        Some(rest) => bp_param_list_inner(*rest, b, false)
        None => b,
    }
}

fn bp_param(buf: PrintBuffer, p: Param) -> PrintBuffer with Mut, Panic, Div, Alloc {
    if p.is_self {
        if p.is_self_mut {
            // "&!self"
            bp6(buf, 38, 33, 115, 101, 108, 102)
        } else {
            // "self"
            bp4(buf, 115, 101, 108, 102)
        }
    } else {
        var b = bp_name(buf, p.name)
        b = bp2(b, 58, 32)  // ": "
        bp_type_expr(b, p.ty)
    }
}

// ============================================================================
// STRUCT DEFINITION
// ============================================================================

fn bp_struct_item(buf: PrintBuffer, name: Name, opt: Option<Box<StructDef>>, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(sd) => bp_struct_def(buf, name, *sd, indent)
        None => buf,
    }
}

fn bp_struct_def(buf: PrintBuffer, name: Name, sd: StructDef, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    var b = bp_indent(buf, indent)
    if sd.is_linear {
        // "linear "
        b = bp7(b, 108, 105, 110, 101, 97, 114, 32)
    }
    // "struct "
    b = bp7(b, 115, 116, 114, 117, 99, 116, 32)
    b = bp_name(b, name)
    b = bp3(b, 32, 123, 10)  // " {\n"
    b = bp_field_def_list(b, sd.fields, indent + 1)
    b = bp_indent(b, indent)
    bp1(b, 125)  // "}"
}

fn bp_field_def_list(buf: PrintBuffer, opt: Option<Box<FieldDefList>>, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => bp_field_def_list_inner(*list, buf, indent)
        None => buf,
    }
}

fn bp_field_def_list_inner(list: FieldDefList, buf: PrintBuffer, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    var b = bp_indent(buf, indent)
    b = bp_name(b, list.head.name)
    b = bp2(b, 58, 32)  // ": "
    b = bp_type_expr(b, list.head.ty)
    match list.tail {
        Some(rest) => {
            b = bp2(b, 44, 10)  // ",\n"
            bp_field_def_list_inner(*rest, b, indent)
        }
        None => bp1(b, 10)  // "\n"
    }
}

// ============================================================================
// ENUM DEFINITION
// ============================================================================

fn bp_enum_item(buf: PrintBuffer, name: Name, opt: Option<Box<EnumDef>>, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(ed) => bp_enum_def(buf, name, *ed, indent)
        None => buf,
    }
}

fn bp_enum_def(buf: PrintBuffer, name: Name, ed: EnumDef, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    var b = bp_indent(buf, indent)
    // "enum "
    b = bp5(b, 101, 110, 117, 109, 32)
    b = bp_name(b, name)
    b = bp3(b, 32, 123, 10)  // " {\n"
    b = bp_variant_list(b, ed.variants, indent + 1)
    b = bp_indent(b, indent)
    bp1(b, 125)  // "}"
}

fn bp_variant_list(buf: PrintBuffer, opt: Option<Box<VariantDefList>>, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => bp_variant_list_inner(*list, buf, indent)
        None => buf,
    }
}

fn bp_variant_list_inner(list: VariantDefList, buf: PrintBuffer, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    var b = bp_indent(buf, indent)
    b = bp_name(b, list.head.name)
    match list.tail {
        Some(rest) => {
            b = bp2(b, 44, 10)  // ",\n"
            bp_variant_list_inner(*rest, b, indent)
        }
        None => bp1(b, 10)  // "\n"
    }
}

// ============================================================================
// IMPL DEFINITION
// ============================================================================

fn bp_impl_item(buf: PrintBuffer, opt: Option<Box<ImplDef>>, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(id) => bp_impl_def(buf, *id, indent)
        None => buf,
    }
}

fn bp_impl_def(buf: PrintBuffer, id: ImplDef, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    var b = bp_indent(buf, indent)
    // "impl "
    b = bp5(b, 105, 109, 112, 108, 32)
    b = bp_type_expr(b, id.target_type)
    b = bp3(b, 32, 123, 10)  // " {\n"
    b = bp_impl_methods(b, id.methods, indent + 1)
    b = bp_indent(b, indent)
    bp1(b, 125)  // "}"
}

fn bp_impl_methods(buf: PrintBuffer, opt: Option<Box<ItemList>>, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => bp_impl_methods_inner(*list, buf, indent)
        None => buf,
    }
}

fn bp_impl_methods_inner(list: ItemList, buf: PrintBuffer, indent: i64) -> PrintBuffer with Mut, Panic, Div, Alloc {
    var b = bp_item(buf, list.head, indent)
    b = bp1(b, 10)  // "\n"
    match list.tail {
        Some(rest) => {
            b = bp1(b, 10)  // "\n"
            bp_impl_methods_inner(*rest, b, indent)
        }
        None => b,
    }
}

// ============================================================================
// PROGRAM (TOP-LEVEL ENTRY POINT)
// ============================================================================

fn bp_program(prog: Program) -> PrintBuffer with Mut, Panic, Div, Alloc {
