// AST Pretty-Printer
//
// Walks the full AST and emits Sounio source code via print/print_char/print_int.
// Uses an indent level for nested blocks. Each helper covers one AST node type.
// Helpers must precede callers (no forward refs in Sounio).

// ============================================================
// Low-level output helpers
// ============================================================

fn print_name(name: Name) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < name.len {
        print_char(name.buf[i] as i64)
        i = i + 1
    }
}

fn print_indent(level: i64) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < level {
        print("    ")
        i = i + 1
    }
}

fn print_string_list_segment(seg: StringList) with IO, Mut, Panic, Div, Alloc {
    var i: i64 = 0
    while i < seg.head_len {
        print_char(seg.head_buf[i] as i64)
        i = i + 1
    }
}

fn print_zero_padded_int(value: i64, width: i64) with IO, Mut, Panic, Div {
    var div: i64 = 1
    var i: i64 = 1
    while i < width {
        div = div * 10
        i = i + 1
    }

    var n = value
    while div > 0 {
        let digit = n / div
        print_char((48 + digit) as i64)
        n = n % div
        div = div / 10
    }
}

fn print_float_fixed(value: f64) with IO, Mut, Panic, Div {
    var x = value
    if x < 0.0 {
        print("-")
        x = 0.0 - x
    }

    var whole = x as i64
    var frac = x - (whole as f64)
    var frac_scaled = (frac * 1000000.0 + 0.5) as i64

    if frac_scaled >= 1000000 {
        whole = whole + 1
        frac_scaled = 0
    }

    print_int(whole)
    print(".")
    print_zero_padded_int(frac_scaled, 6)
}

// ============================================================
// Path printing: Foo::Bar::Baz
// ============================================================

fn print_path_segments(segs: Option<Box<StringList>>, remaining: i64) with IO, Mut, Panic, Div, Alloc {
    match segs {
        Some(list) => {
            print_string_list_segment(*list)
            if remaining > 1 {
                print("::")
                print_path_segments((*list).tail, remaining - 1)
            }
        }
        None => {}
    }
}

fn print_path(path: AstPath) with IO, Mut, Panic, Div, Alloc {
    print_path_segments(Some(Box::new(path.segments)), path.seg_count)
}

// ============================================================
// Type expression printing
// ============================================================

fn print_type_expr(te: TypeExpr) with IO, Mut, Panic, Div, Alloc {
    match te.kind {
        TypeNamed => {
            print_path(te.path)
            print_type_args_opt(te.type_args)
        }
        TypeReference => {
            print("&")
            print_type_inner(te.inner)
        }
        TypeRefMut => {
            print("&!")
            print_type_inner(te.inner)
        }
        TypeArray => {
            print("[")
            print_type_inner(te.inner)
            print_array_size(te.array_size)
            print("]")
        }
        TypeTuple => {
            print("(")
            print_type_expr_list_comma(te.type_args)
            print(")")
        }
        TypeFn => {
            print("fn(")
            print_type_expr_list_comma(te.type_args)
            print(")")
            print_type_return(te.inner)
            print_effect_list_opt(te.effects)
        }
        TypeUnit => {
            print("()")
        }
        TypeNever => {
            print("!")
        }
        TypeSelfUpper => {
            print("Self")
        }
        TypeInfer => {
            print("_")
        }
        TypeKnowledge => {
            print("Knowledge<...>")
        }
        TypeModel => {
            print("Model")
            print_type_args_opt(te.type_args)
        }
        TypePolicy => {
            print("Policy")
            print_type_args_opt(te.type_args)
        }
        TypeAcquisitionPolicy => {
            print("AcquisitionPolicy")
            print_type_args_opt(te.type_args)
        }
        TypeAcquisitionPlan => {
            print("AcquisitionPlan")
            print_type_args_opt(te.type_args)
        }
        TypeRecoursePolicy => {
            print("RecoursePolicy")
            print_type_args_opt(te.type_args)
        }
        TypeRecoursePlan => {
            print("RecoursePlan")
            print_type_args_opt(te.type_args)
        }
        TypeTransitionPolicy => {
            print("TransitionPolicy")
            print_type_args_opt(te.type_args)
        }
        TypeTransitionPlan => {
            print("TransitionPlan")
            print_type_args_opt(te.type_args)
        }
        TypeDecisionPolicy => {
            print("DecisionPolicy")
            print_type_args_opt(te.type_args)
        }
        TypeDeferralPolicy => {
            print("DeferralPolicy")
            print_type_args_opt(te.type_args)
        }
        TypeAlternativePolicy => {
            print("AlternativePolicy")
            print_type_args_opt(te.type_args)
        }
        TypeAlternativeSet => {
            print("AlternativeSet")
            print_type_args_opt(te.type_args)
        }
        TypeAlternativeOption => {
            print("AlternativeOption")
            print_type_args_opt(te.type_args)
        }
        TypeContest => {
            print("Contest")
            print_type_args_opt(te.type_args)
        }
        TypeRobust => {
            print("Robust")
            print_type_args_opt(te.type_args)
        }
        TypeIntervention => {
            print("Intervention")
            print_type_args_opt(te.type_args)
        }
        TypeCounterfactual => {
            print("Counterfactual")
            print_type_args_opt(te.type_args)
        }
        TypeValidated => {
            print("Validated")
            print_type_args_opt(te.type_args)
        }
        TypeAdmissible => {
            print("Admissible")
            print_type_args_opt(te.type_args)
        }
        TypeDeferred => {
            print("Deferred")
            print_type_args_opt(te.type_args)
        }
        TypeRefinement => {
            print("{ ... | ... }")
        }
        TypeChan => {
            print("Chan")
            print_type_args_opt(te.type_args)
        }
        TypeSession => {
            print("Session")
            print_type_args_opt(te.type_args)
        }
    }
}

fn print_type_inner(opt: Option<Box<TypeExpr>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(te) => print_type_expr(*te)
        None => {}
    }
}

fn print_type_return(opt: Option<Box<TypeExpr>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(te) => {
            print(" -> ")
            print_type_expr(*te)
        }
        None => {}
    }
}

fn print_array_size(opt: Option<Box<Expr>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(e) => {
            print("; ")
            print_expr(*e)
        }
        None => {}
    }
}

fn print_type_args_opt(opt: Option<Box<TypeExprList>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            print("<")
            print_type_expr_list_comma_inner(*list, true)
            print(">")
        }
        None => {}
    }
}

fn print_type_expr_list_comma(opt: Option<Box<TypeExprList>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => print_type_expr_list_comma_inner(*list, true)
        None => {}
    }
}

fn print_type_expr_list_comma_inner(list: TypeExprList, first: bool) with IO, Mut, Panic, Div, Alloc {
    if !first {
        print(", ")
    }
    print_type_expr(list.head)
    match list.tail {
        Some(rest) => print_type_expr_list_comma_inner(*rest, false)
        None => {}
    }
}

// ============================================================
// Effect list printing: with IO, Mut, Alloc
// ============================================================

fn print_effect_list_opt(opt: Option<Box<EffectList>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            print(" with ")
            print_effect_list_inner(*list, true)
        }
        None => {}
    }
}

fn print_effect_list_inner(list: EffectList, first: bool) with IO, Mut, Panic, Div, Alloc {
    if !first {
        print(", ")
    }
    print_effect_ref(list.head)
    match list.tail {
        Some(rest) => print_effect_list_inner(*rest, false)
        None => {}
    }
}

fn print_effect_ref(eff: EffectRef) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < eff.name_len {
        print_char(eff.name_buf[i] as i64)
        i = i + 1
    }
}

// ============================================================
// Pattern printing
// ============================================================

fn print_pattern(pat: Pattern) with IO, Mut, Panic, Div, Alloc {
    match pat.kind {
        PatWildcard => print("_")
        PatBinding => {
            if pat.is_mut {
                print("var ")
            }
            print_name(pat.name)
        }
        PatIntLit => print_int(pat.int_val)
        PatBoolTrue => print("true")
        PatBoolFalse => print("false")
        PatStringLit => {
            print("\"")
            print_name(pat.name)
            print("\"")
        }
        PatEnum => {
            print_path(pat.path)
            print_pat_sub_patterns(pat.sub_patterns)
        }
        PatStruct => {
            print_path(pat.path)
            print(" { ")
            print_pat_fields(pat.pat_fields)
            print(" }")
        }
        PatTuple => {
            print("(")
            print_pattern_list_comma(pat.sub_patterns)
            print(")")
        }
        PatOr => {
            print_pattern_list_or(pat.sub_patterns)
        }
    }
}

fn print_pat_sub_patterns(opt: Option<Box<PatternList>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            print("(")
            print_pattern_list_comma_inner(*list, true)
            print(")")
        }
        None => {}
    }
}

fn print_pattern_list_comma(opt: Option<Box<PatternList>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => print_pattern_list_comma_inner(*list, true)
        None => {}
    }
}

fn print_pattern_list_comma_inner(list: PatternList, first: bool) with IO, Mut, Panic, Div, Alloc {
    if !first {
        print(", ")
    }
    print_pattern(list.head)
    match list.tail {
        Some(rest) => print_pattern_list_comma_inner(*rest, false)
        None => {}
    }
}

fn print_pattern_list_or(opt: Option<Box<PatternList>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => print_pattern_list_or_inner(*list, true)
        None => {}
    }
}

fn print_pattern_list_or_inner(list: PatternList, first: bool) with IO, Mut, Panic, Div, Alloc {
    if !first {
        print(" | ")
    }
    print_pattern(list.head)
    match list.tail {
        Some(rest) => print_pattern_list_or_inner(*rest, false)
        None => {}
    }
}

fn print_pat_fields(opt: Option<Box<PatFieldList>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => print_pat_fields_inner(*list, true)
        None => {}
    }
}

fn print_pat_fields_inner(list: PatFieldList, first: bool) with IO, Mut, Panic, Div, Alloc {
    if !first {
        print(", ")
    }
    print_name(list.head.name)
    print(": ")
    print_pattern(list.head.pattern)
    match list.tail {
        Some(rest) => print_pat_fields_inner(*rest, false)
        None => {}
    }
}

// ============================================================
// Expression printing
// ============================================================

fn print_expr(e: Expr) with IO, Mut, Panic, Div, Alloc {
    match e.kind {
        ExprIntLit => print_int(e.int_val)
        ExprFloatLit => {
            print_float_fixed(e.float_val)
        }
        ExprBoolTrue => print("true")
        ExprBoolFalse => print("false")
        ExprStringLit => {
            print("\"")
            print_name(e.name)
            print("\"")
        }
        ExprCharLit => {
            print("'")
            print_char(e.int_val as i64)
            print("'")
        }
        ExprIdent => print_name(e.name)
        ExprPath => print_path(e.path)
        ExprBinary => {
            print_expr_opt(e.left)
            print_binop(e.bin_op)
            print_expr_opt(e.right)
        }
        ExprUnary => {
            print_unaryop(e.un_op)
            print_expr_opt(e.left)
        }
        ExprFieldAccess => {
            print_expr_opt(e.left)
            print(".")
            print_name(e.name)
        }
        ExprIndex => {
            print_expr_opt(e.left)
            print("[")
            print_expr_opt(e.right)
            print("]")
        }
        ExprMethodCall => {
            print_expr_opt(e.left)
            print(".")
            print_name(e.name)
            print("(")
            print_expr_list_comma(e.args)
            print(")")
        }
        ExprCall => {
            print_expr_opt(e.left)
            print("(")
            print_expr_list_comma(e.args)
            print(")")
        }
        ExprContest => {
            print("contest [")
            print_expr_list_comma(e.args)
            print("] on ")
            print_expr_opt(e.left)
        }
        ExprAuditAttach => {
            print_expr_opt(e.left)
            print(" audit ")
            print_name(e.name)
        }
        ExprIf => {
            print("if ")
            print_expr_opt(e.left)
            print(" ")
            print_block_opt(e.block, 0)
            print_else_opt(e.else_expr)
        }
        ExprMatch => {
            print("match ")
            print_expr_opt(e.left)
            print(" {\n")
            print_match_arms(e.arms, 1)
            print("}")
        }
        ExprWhile => {
            print("while ")
            print_expr_opt(e.left)
            print(" ")
            print_block_opt(e.block, 0)
        }
        ExprLoop => {
            print("loop ")
            print_block_opt(e.block, 0)
        }
        ExprBlock => {
            print_block_opt(e.block, 0)
        }
        ExprReturn => {
            print("return")
            print_return_val(e.left)
        }
        ExprBreak => {
            print("break")
            print_return_val(e.left)
        }
        ExprContinue => print("continue")
        ExprStructLit => {
            print_path(e.path)
            print(" { ")
            print_struct_fields(e.fields)
            print(" }")
        }
        ExprArrayLit => {
            print("[")
            print_expr_list_comma(e.args)
            print("]")
        }
        ExprTupleLit => {
            print("(")
            print_expr_list_comma(e.args)
            print(")")
        }
        ExprRange => {
            print_expr_opt(e.left)
            print_binop(e.bin_op)
            print_expr_opt(e.right)
        }
        ExprCast => {
            print_expr_opt(e.left)
            print(" as ")
            match e.cast_type {
                Some(ty) => print_type_expr(*ty)
                None => print("???")
            }
        }
        ExprHandle => {
            print("handle<")
            print_name(e.name)
            print("> ")
            match e.block {
                Some(blk) => print_block(*blk)
                None => print("{}")
            }
            match e.handler_block {
                Some(hb) => {
                    print(" with ")
                    print_block(*hb)
                }
                None => {}
            }
        }
        ExprError => print("/* error */")
    }
}

fn print_expr_opt(opt: Option<Box<Expr>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(e) => print_expr(*e)
        None => {}
    }
}

fn print_return_val(opt: Option<Box<Expr>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(e) => {
            print(" ")
            print_expr(*e)
        }
        None => {}
    }
}

fn print_else_opt(opt: Option<Box<Expr>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(e) => {
            print(" else ")
            print_expr(*e)
        }
        None => {}
    }
}

fn print_binop(op: BinaryOp) with IO {
    match op {
        OpAdd => print(" + ")
        OpSub => print(" - ")
        OpMul => print(" * ")
        OpDiv => print(" / ")
        OpRem => print(" % ")
        OpEq => print(" == ")
        OpNe => print(" != ")
        OpLt => print(" < ")
        OpLe => print(" <= ")
        OpGt => print(" > ")
        OpGe => print(" >= ")
        OpAnd => print(" && ")
        OpOr => print(" || ")
        OpBitAnd => print(" & ")
        OpBitOr => print(" | ")
        OpBitXor => print(" ^ ")
        OpShl => print(" << ")
        OpShr => print(" >> ")
        OpConcat => print(" ++ ")
        OpRange => print("..")
        OpRangeInclusive => print("..=")
    }
}

fn print_unaryop(op: UnaryOp) with IO {
    match op {
        OpNeg => print("-")
        OpNot => print("!")
        OpRef => print("&")
        OpRefMut => print("&!")
        OpDeref => print("*")
    }
}

fn print_expr_list_comma(opt: Option<Box<ExprList>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => print_expr_list_comma_inner(*list, true)
        None => {}
    }
}

fn print_expr_list_comma_inner(list: ExprList, first: bool) with IO, Mut, Panic, Div, Alloc {
    if !first {
        print(", ")
    }
    if !name_is_empty(list.label) {
        print_name(list.label)
        print(": ")
    }
    print_expr(list.head)
    match list.tail {
        Some(rest) => print_expr_list_comma_inner(*rest, false)
        None => {}
    }
}

fn print_match_arms(opt: Option<Box<MatchArmList>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => print_match_arms_inner(*list, indent)
        None => {}
    }
}

fn print_match_arms_inner(list: MatchArmList, indent: i64) with IO, Mut, Panic, Div, Alloc {
    print_indent(indent)
    print_pattern(list.head.pattern)
    print(" => ")
    print_expr(list.head.body)
    print("\n")
    match list.tail {
        Some(rest) => print_match_arms_inner(*rest, indent)
        None => {}
    }
}

fn print_struct_fields(opt: Option<Box<StructFieldList>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => print_struct_fields_inner(*list, true)
        None => {}
    }
}

fn print_struct_fields_inner(list: StructFieldList, first: bool) with IO, Mut, Panic, Div, Alloc {
    if !first {
        print(", ")
    }
    print_name(list.head.name)
    print(": ")
    print_expr(list.head.value)
    match list.tail {
        Some(rest) => print_struct_fields_inner(*rest, false)
        None => {}
    }
}

// ============================================================
// Block and statement printing
// ============================================================

fn print_block_opt(opt: Option<Box<Block>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(blk) => print_block(*blk, indent)
        None => {}
    }
}

fn print_block(blk: Block, indent: i64) with IO, Mut, Panic, Div, Alloc {
    print("{\n")
    print_stmt_list(blk.stmts, indent + 1)
    print_indent(indent)
    print("}")
}

fn print_stmt_list(opt: Option<Box<StmtList>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => print_stmt_list_inner(*list, indent)
        None => {}
    }
}

fn print_stmt_list_inner(list: StmtList, indent: i64) with IO, Mut, Panic, Div, Alloc {
    print_indent(indent)
    print_stmt(list.head, indent)
    print("\n")
    match list.tail {
        Some(rest) => print_stmt_list_inner(*rest, indent)
        None => {}
    }
}

fn print_stmt(s: Stmt, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match s.kind {
        StmtLet => {
            print("let ")
            print_name(s.name)
            print_optional_type_annot(s.ty)
            print_optional_init(s.expr)
        }
        StmtVar => {
            print("var ")
            print_name(s.name)
            print_optional_type_annot(s.ty)
            print_optional_init(s.expr)
        }
        StmtExpr => {
            print_expr_opt(s.expr)
        }
        StmtAssign => {
            print_expr_opt(s.target)
            print_assign_op(s.assign_op)
            print_expr_opt(s.expr)
        }
    }
}

fn print_optional_type_annot(opt: Option<Box<TypeExpr>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(te) => {
            print(": ")
            print_type_expr(*te)
        }
        None => {}
    }
}

fn print_optional_init(opt: Option<Box<Expr>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(e) => {
            print(" = ")
            print_expr(*e)
        }
        None => {}
    }
}

fn print_assign_op(op: AssignOp) with IO {
    match op {
        AssignEq => print(" = ")
        AssignAdd => print(" += ")
        AssignSub => print(" -= ")
        AssignMul => print(" *= ")
        AssignDiv => print(" /= ")
        AssignRem => print(" %= ")
    }
}

// ============================================================
// Item printing (top-level declarations)
// ============================================================

fn print_item_list_top(opt: Option<Box<ItemList>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => print_item_list_top_inner(*list)
        None => {}
    }
}

fn print_item_list_top_inner(list: ItemList) with IO, Mut, Panic, Div, Alloc {
    print_item(list.head, 0)
    print("\n")
    match list.tail {
        Some(rest) => {
            print("\n")
            print_item_list_top_inner(*rest)
        }
        None => {}
    }
}

fn print_policy_compare_op(op: CompareOp) with IO {
    match op {
        CmpLt => print("<")
        CmpLe => print("<=")
        CmpEq => print("==")
        CmpGe => print(">=")
        CmpGt => print(">")
    }
}

fn print_policy_threshold(value: f64) with IO {
    let milli = (value * 1000.0) as i64
    print_int(milli)
    print("/1000")
}

fn print_policy_requirement_value(req: PolicyRequirement) with IO, Panic, Div {
    if req.threshold_kind == 1 {
        if req.bool_threshold { print("true") } else { print("false") }
    } else if req.threshold_kind == 2 {
        print_name(req.name_threshold)
    } else {
        print_policy_threshold(req.threshold)
    }
}

fn print_policy_requirements(opt: Option<Box<PolicyRequirementList>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            print_indent(indent)
            print("require ")
            print_name((*list).head.metric_name)
            print(" ")
            print_policy_compare_op((*list).head.op)
            print(" ")
            print_policy_requirement_value((*list).head)
            print("\n")
            print_policy_requirements((*list).tail, indent)
        }
        None => {}
    }
}

fn print_policy_item(opt: Option<Box<PolicyDef>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(pd) => {
            print_indent(indent)
            print("policy ")
            print_name((*pd).name)
            print(" for ")
            print_type_expr((*pd).target_type)
            if !name_is_empty((*pd).level_name) {
                print(" level ")
                print_name((*pd).level_name)
            }
            if !name_is_empty((*pd).scope_name) {
                print(" scope ")
                print_name((*pd).scope_name)
            }
            print(" {\n")
            print_policy_requirements((*pd).requirements, indent + 1)
            print_indent(indent)
            print("}")
        }
        None => {}
    }
}

fn print_acquisition_policy_item(opt: Option<Box<AcquisitionPolicyDef>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(ap) => {
            print_indent(indent)
            print("acquisition_policy ")
            print_name((*ap).name)
            print(" for ")
            print_type_expr((*ap).target_type)
            if !name_is_empty((*ap).objective_name) {
                print(" objective ")
                print_name((*ap).objective_name)
            }
            if !name_is_empty((*ap).route_name) {
                print(" route ")
                print_name((*ap).route_name)
            }
            print(" {\n")
            print_policy_requirements((*ap).requirements, indent + 1)
            print_indent(indent)
            print("}")
        }
        None => {}
    }
}

fn print_recourse_policy_item(opt: Option<Box<RecoursePolicyDef>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(rp) => {
            print_indent(indent)
            print("recourse_policy ")
            print_name((*rp).name)
            print(" for ")
            print_type_expr((*rp).target_type)
            if !name_is_empty((*rp).strategy_name) {
                print(" strategy ")
                print_name((*rp).strategy_name)
            }
            if !name_is_empty((*rp).route_name) {
                print(" route ")
                print_name((*rp).route_name)
            }
            print(" {\n")
            print_policy_requirements((*rp).requirements, indent + 1)
            print_indent(indent)
            print("}")
        }
        None => {}
    }
}

fn print_alternative_policy_item(opt: Option<Box<AlternativePolicyDef>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(ap) => {
            print_indent(indent)
            print("alternative_policy ")
            print_name((*ap).name)
            print(" for ")
            print_type_expr((*ap).target_type)
            print(" { ... }")
        }
        None => {}
    }
}

fn print_alternative_frontier_item(opt: Option<Box<AlternativeFrontierDef>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(af) => {
            print_indent(indent)
            print("alternative_frontier ")
            print_name((*af).name)
            print(" for ")
            print_type_expr((*af).target_type)
            print(" under ")
            print_name((*af).policy_name)
            print(" { ... }")
        }
        None => {}
    }
}

fn print_ast_path_list(opt: Option<Box<AstPathList>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => print_ast_path_list_inner(*list, true)
        None => {}
    }
}

fn print_ast_path_list_inner(list: AstPathList, first: bool) with IO, Mut, Panic, Div, Alloc {
    if !first {
        print(", ")
    }
    print_path(list.head)
    match list.tail {
        Some(rest) => print_ast_path_list_inner(*rest, false)
        None => {}
    }
}

fn print_models_item(opt: Option<Box<ModelsDef>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(md) => {
            print_indent(indent)
            print("models ")
            print_name((*md).name)
            print(" = [")
            print_ast_path_list((*md).models)
            print("]")
        }
        None => {}
    }
}

fn print_validation_item(opt: Option<Box<ValidationDef>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(vd) => {
            print_indent(indent)
            print("validation ")
            print_name((*vd).name)
            print(" for ")
            print_type_expr((*vd).target_type)
            print(" {}")
        }
        None => {}
    }
}

fn print_audit_field_entry(entry: AuditFieldEntry, first: bool) with IO, Mut, Panic, Div {
    if !first { print(", ") }
    print_name(entry.name)
    print(": ")
    if entry.value_kind == AuditValueKind::AuditValueFloat {
        print_float(entry.value_f64)
    } else {
        print_name(entry.value_name)
    }
}

fn print_audit_field_entries(opt: Option<Box<AuditFieldEntryList>>, first: bool) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            print_audit_field_entry((*list).head, first)
            print_audit_field_entries((*list).tail, false)
        }
        None => {}
    }
}

fn print_audit_sections(opt: Option<Box<AuditSectionList>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            print_indent(indent)
            print_name((*list).head.name)
            print(" { ")
            print_audit_field_entries((*list).head.fields, true)
            print(" }\n")
            print_audit_sections((*list).tail, indent)
        }
        None => {}
    }
}

fn print_audit_item(opt: Option<Box<AuditDef>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(ad) => {
            print_indent(indent)
            print("audit ")
            print_name((*ad).name)
            print(" for ")
            print_type_expr((*ad).target_type)
            print(" {\n")
            print_audit_sections((*ad).sections, indent + 1)
            print_indent(indent)
            print("}")
        }
        None => {}
    }
}

fn print_item(item: Item, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match item.kind {
        ItemFn => print_fn_item(item.fn_def, indent)
        ItemStruct => print_struct_item(item.name, item.struct_def, indent)
        ItemEnum => print_enum_item(item.name, item.enum_def, indent)
        ItemImpl => print_impl_item(item.impl_def, indent)
        ItemTypeAlias => {
            print_indent(indent)
            print("type ")
            print_name(item.name)
            print(" = ")
            print_type_inner(item.type_alias_ty)
        }
        ItemModels => print_models_item(item.models_def, indent)
        ItemPolicy => print_policy_item(item.policy_def, indent)
        ItemAcquisitionPolicy => print_acquisition_policy_item(item.acquisition_policy_def, indent)
        ItemRecoursePolicy => print_recourse_policy_item(item.recourse_policy_def, indent)
        ItemTransitionPolicy => print_transition_policy_item(item.transition_policy_def, indent)
        ItemTransitionProtocol => print_transition_protocol_item(item.transition_protocol_def, indent)
        ItemAlternativePolicy => print_alternative_policy_item(item.alternative_policy_def, indent)
        ItemAlternativeFrontier => print_alternative_frontier_item(item.alternative_frontier_def, indent)
        ItemDecisionPolicy => print_decision_policy_item(item.decision_policy_def, indent)
        ItemDeferralPolicy => print_deferral_policy_item(item.deferral_policy_def, indent)
        ItemValidation => print_validation_item(item.validation_def, indent)
        ItemAudit => print_audit_item(item.audit_def, indent)
        ItemUse => {
            print_indent(indent)
            print("use ")
            print_path(item.use_path)
            if item.use_glob {
                print("::*")
            }
        }
        ItemUnit => {
            print_indent(indent)
            print("unit ")
            print_name(item.name)
            print(";")
        }
        ItemEffect => {
            print_indent(indent)
            print("effect ")
            print_name(item.name)
            print(" {")
            match item.effect_def {
                Some(edef) => print_effect_op_def_list_opt((*edef).ops, indent + 1)
                None => {}
            }
            print("\n")
            print_indent(indent)
            print("}")
        }
        ItemSession => {
            print_indent(indent)
            print("session ")
            print_name(item.name)
            print(" { ... }")
        }
    }
}

fn print_decision_policy_item(opt: Option<Box<DecisionPolicyDef>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(dd) => {
            print_indent(indent)
            print("decision_policy ")
            print_name((*dd).name)
            print(" for ")
            print_type_expr((*dd).target_type)
            print(" {\n")
            print_policy_requirements((*dd).requirements, indent + 1)
            print_indent(indent)
            print("}")
        }
        None => {}
    }
}

fn print_deferral_policy_item(opt: Option<Box<DeferralPolicyDef>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(dd) => {
            print_indent(indent)
            print("deferral_policy ")
            print_name((*dd).name)
            print(" for ")
            print_type_expr((*dd).target_type)
            if !name_is_empty((*dd).route_name) {
                print(" route ")
                print_name((*dd).route_name)
            }
            print(" {\n")
            print_policy_requirements((*dd).requirements, indent + 1)
            print_indent(indent)
            print("}")
        }
        None => {}
    }
}

fn print_effect_op_def_list_opt(opt: Option<Box<EffectOpDefList>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        None => {}
        Some(node) => print_effect_op_def_list_inner(*node, indent)
    }
}

fn print_effect_op_def_list_inner(list: EffectOpDefList, indent: i64) with IO, Mut, Panic, Div, Alloc {
    print("\n")
    print_indent(indent)
    print("fn ")
    print_name(list.head.name)
    print("(")
    print_param_list(list.head.params)
    print(")")
    match list.head.ret_ty {
        Some(ty) => {
            print(" -> ")
            print_type_expr(*ty)
        }
        None => {}
    }
    match list.tail {
        Some(rest) => print_effect_op_def_list_inner(*rest, indent)
        None => {}
    }
}

// ============================================================
// Function definition
// ============================================================

fn print_fn_item(opt: Option<Box<FnDef>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(fd) => print_fn_def(*fd, indent)
        None => {}
    }
}

fn print_fn_def(fd: FnDef, indent: i64) with IO, Mut, Panic, Div, Alloc {
    print_indent(indent)
    print("fn ")
    print_name(fd.name)
    print("(")
    print_param_list(fd.params)
    print(")")
    print_optional_return(fd.return_type)
    print_effect_list_opt(fd.effects)
    print(" ")
    print_block(fd.body, indent)
}

fn print_optional_return(opt: Option<Box<TypeExpr>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(te) => {
            print(" -> ")
            print_type_expr(*te)
        }
        None => {}
    }
}

fn print_param_list(opt: Option<Box<ParamList>>) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => print_param_list_inner(*list, true)
        None => {}
    }
}

fn print_param_list_inner(list: ParamList, first: bool) with IO, Mut, Panic, Div, Alloc {
    if !first {
        print(", ")
    }
    print_param(list.head)
    match list.tail {
        Some(rest) => print_param_list_inner(*rest, false)
        None => {}
    }
}

fn print_param(p: Param) with IO, Mut, Panic, Div, Alloc {
    if p.is_self {
        if p.is_self_mut {
            print("&!self")
        } else {
            print("self")
        }
    } else {
        print_name(p.name)
        print(": ")
        print_type_expr(p.ty)
    }
}

// ============================================================
// Struct definition
// ============================================================

fn print_struct_item(name: Name, opt: Option<Box<StructDef>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(sd) => print_struct_def(name, *sd, indent)
        None => {}
    }
}

fn print_struct_def(name: Name, sd: StructDef, indent: i64) with IO, Mut, Panic, Div, Alloc {
    print_indent(indent)
    if sd.is_linear {
        print("linear ")
    }
    print("struct ")
    print_name(name)
    print(" {\n")
    print_field_def_list(sd.fields, indent + 1)
    print_indent(indent)
    print("}")
}

fn print_field_def_list(opt: Option<Box<FieldDefList>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => print_field_def_list_inner(*list, indent)
        None => {}
    }
}

fn print_field_def_list_inner(list: FieldDefList, indent: i64) with IO, Mut, Panic, Div, Alloc {
    print_indent(indent)
    print_name(list.head.name)
    print(": ")
    print_type_expr(list.head.ty)
    // Always use comma separator for struct fields
    match list.tail {
        Some(rest) => {
            print(",\n")
            print_field_def_list_inner(*rest, indent)
        }
        None => {
            print("\n")
        }
    }
}

// ============================================================
// Enum definition
// ============================================================

fn print_enum_item(name: Name, opt: Option<Box<EnumDef>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(ed) => print_enum_def(name, *ed, indent)
        None => {}
    }
}

fn print_enum_def(name: Name, ed: EnumDef, indent: i64) with IO, Mut, Panic, Div, Alloc {
    print_indent(indent)
    print("enum ")
    print_name(name)
    print(" {\n")
    print_variant_list(ed.variants, indent + 1)
    print_indent(indent)
    print("}")
}

fn print_variant_list(opt: Option<Box<VariantDefList>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => print_variant_list_inner(*list, indent)
        None => {}
    }
}

fn print_variant_list_inner(list: VariantDefList, indent: i64) with IO, Mut, Panic, Div, Alloc {
    print_indent(indent)
    print_name(list.head.name)
    match list.tail {
        Some(rest) => {
            print(",\n")
            print_variant_list_inner(*rest, indent)
        }
        None => {
            print("\n")
        }
    }
}

// ============================================================
// Impl definition
// ============================================================

fn print_impl_item(opt: Option<Box<ImplDef>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(id) => print_impl_def(*id, indent)
        None => {}
    }
}

fn print_impl_def(id: ImplDef, indent: i64) with IO, Mut, Panic, Div, Alloc {
    print_indent(indent)
    print("impl ")
    print_type_expr(id.target_type)
    print(" {\n")
    print_impl_methods(id.methods, indent + 1)
    print_indent(indent)
    print("}")
}

fn print_impl_methods(opt: Option<Box<ItemList>>, indent: i64) with IO, Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => print_impl_methods_inner(*list, indent)
        None => {}
    }
}

fn print_impl_methods_inner(list: ItemList, indent: i64) with IO, Mut, Panic, Div, Alloc {
    print_item(list.head, indent)
    print("\n")
    match list.tail {
        Some(rest) => {
            print("\n")
            print_impl_methods_inner(*rest, indent)
        }
        None => {}
    }
}
