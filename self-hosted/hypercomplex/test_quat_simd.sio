// self-hosted::hypercomplex::test_quat_simd — Quaternion SIMD Tests

// ============================================================================
// Test Helpers
// ============================================================================

fn approx_eq(a: f64, b: f64, epsilon: f64) -> bool {
    let diff = if a > b { a - b } else { b - a }
    diff < epsilon
}

fn quat_approx_eq(a: Quat, b: Quat) -> bool {
    let eps = 1e-9
    approx_eq(a.w, b.w, eps) &&
    approx_eq(a.x, b.x, eps) &&
    approx_eq(a.y, b.y, eps) &&
    approx_eq(a.z, b.z, eps)
}

// ============================================================================
// Scalar Quaternion Tests
// ============================================================================

fn test_quat_identity() -> i64 {
    let q = quat_identity()
    if !approx_eq(q.w, 1.0, 1e-9) { return 1 }
    if !approx_eq(q.x, 0.0, 1e-9) { return 2 }
    if !approx_eq(q.y, 0.0, 1e-9) { return 3 }
    if !approx_eq(q.z, 0.0, 1e-9) { return 4 }
    0
}

fn test_quat_addition() -> i64 {
    let q1 = Quat { w: 1.0, x: 2.0, y: 3.0, z: 4.0 }
    let q2 = Quat { w: 5.0, x: 6.0, y: 7.0, z: 8.0 }
    let result = quat_add(q1, q2)

    if !approx_eq(result.w, 6.0, 1e-9) { return 1 }
    if !approx_eq(result.x, 8.0, 1e-9) { return 2 }
    if !approx_eq(result.y, 10.0, 1e-9) { return 3 }
    if !approx_eq(result.z, 12.0, 1e-9) { return 4 }
    0
}

fn test_quat_multiplication() -> i64 {
    let q1 = Quat { w: 1.0, x: 0.0, y: 0.0, z: 0.0 }  // Identity
    let q2 = Quat { w: 0.0, x: 1.0, y: 0.0, z: 0.0 }  // i

    let result = quat_mul(q1, q2)

    if !approx_eq(result.w, 0.0, 1e-9) { return 1 }
    if !approx_eq(result.x, 1.0, 1e-9) { return 2 }
    if !approx_eq(result.y, 0.0, 1e-9) { return 3 }
    if !approx_eq(result.z, 0.0, 1e-9) { return 4 }
    0
}

fn test_quat_i_squared() -> i64 {
    // i² = -1 (quaternion property)
    let i = Quat { w: 0.0, x: 1.0, y: 0.0, z: 0.0 }
    let result = quat_mul(i, i)

    if !approx_eq(result.w, -1.0, 1e-9) { return 1 }
    if !approx_eq(result.x, 0.0, 1e-9) { return 2 }
    if !approx_eq(result.y, 0.0, 1e-9) { return 3 }
    if !approx_eq(result.z, 0.0, 1e-9) { return 4 }
    0
}

fn test_quat_ijk_relation() -> i64 {
    // ijk = -1 (fundamental quaternion relation)
    let i = Quat { w: 0.0, x: 1.0, y: 0.0, z: 0.0 }
    let j = Quat { w: 0.0, x: 0.0, y: 1.0, z: 0.0 }
    let k = Quat { w: 0.0, x: 0.0, y: 0.0, z: 1.0 }

    let ij = quat_mul(i, j)
    let ijk = quat_mul(ij, k)

    if !approx_eq(ijk.w, -1.0, 1e-9) { return 1 }
    if !approx_eq(ijk.x, 0.0, 1e-9) { return 2 }
    if !approx_eq(ijk.y, 0.0, 1e-9) { return 3 }
    if !approx_eq(ijk.z, 0.0, 1e-9) { return 4 }
    0
}

fn test_quat_conjugate() -> i64 {
    let q = Quat { w: 1.0, x: 2.0, y: 3.0, z: 4.0 }
    let conj = quat_conjugate(q)

    if !approx_eq(conj.w, 1.0, 1e-9) { return 1 }
    if !approx_eq(conj.x, -2.0, 1e-9) { return 2 }
    if !approx_eq(conj.y, -3.0, 1e-9) { return 3 }
    if !approx_eq(conj.z, -4.0, 1e-9) { return 4 }
    0
}

fn test_quat_norm() -> i64 {
    let q = Quat { w: 1.0, x: 2.0, y: 2.0, z: 0.0 }
    let norm = quat_norm(q)

    // sqrt(1 + 4 + 4 + 0) = sqrt(9) = 3
    if !approx_eq(norm, 3.0, 1e-9) { return 1 }
    0
}

fn test_quat_normalize() -> i64 {
    let q = Quat { w: 2.0, x: 0.0, y: 0.0, z: 0.0 }
    let normalized = quat_normalize(q)

    if !approx_eq(quat_norm(normalized), 1.0, 1e-9) { return 1 }
    if !approx_eq(normalized.w, 1.0, 1e-9) { return 2 }
    0
}

fn test_quat_inverse() -> i64 {
    let q = Quat { w: 1.0, x: 1.0, y: 0.0, z: 0.0 }
    let inv = quat_inverse(q)
    let product = quat_mul(q, inv)

    // q * q⁻¹ should equal identity
    if !quat_approx_eq(product, quat_identity()) { return 1 }
    0
}

fn test_quat_rotate_90deg() -> i64 {
    // Rotation by 90° around Z axis
    let q = quat_from_axis_angle(0.0, 0.0, 1.0, 1.5707963267948966)  // π/2

    // Rotate vector (1, 0, 0)
    let rotated = quat_rotate_vector(q, 1.0, 0.0, 0.0)

    // Should result in approximately (0, 1, 0)
    if !approx_eq(rotated.0, 0.0, 1e-6) { return 1 }
    if !approx_eq(rotated.1, 1.0, 1e-6) { return 2 }
    if !approx_eq(rotated.2, 0.0, 1e-6) { return 3 }
    0
}

// ============================================================================
// SIMD Tests (Quat4)
// ============================================================================

fn test_quat4_addition() -> i64 with Mut, Panic, Div {
    let q1 = Quat { w: 1.0, x: 2.0, y: 3.0, z: 4.0 }
    let q2 = Quat { w: 5.0, x: 6.0, y: 7.0, z: 8.0 }

    let q4a = quat4_load(q1, q1, q1, q1)
    let q4b = quat4_load(q2, q2, q2, q2)

    let result = quat4_add(q4a, q4b)

    // All 4 results should be q1 + q2
    if !approx_eq(result.w[0], 6.0, 1e-9) { return 1 }
    if !approx_eq(result.w[1], 6.0, 1e-9) { return 2 }
    if !approx_eq(result.w[2], 6.0, 1e-9) { return 3 }
    if !approx_eq(result.w[3], 6.0, 1e-9) { return 4 }
    0
}

fn test_quat4_multiplication() -> i64 with Mut, Panic, Div {
    let id = quat_identity()
    let i = Quat { w: 0.0, x: 1.0, y: 0.0, z: 0.0 }

    let q4a = quat4_load(id, id, id, id)
    let q4b = quat4_load(i, i, i, i)

    let result = quat4_mul(q4a, q4b)

    // Identity * i = i for all 4 lanes
    if !approx_eq(result.x[0], 1.0, 1e-9) { return 1 }
    if !approx_eq(result.x[1], 1.0, 1e-9) { return 2 }
    if !approx_eq(result.x[2], 1.0, 1e-9) { return 3 }
    if !approx_eq(result.x[3], 1.0, 1e-9) { return 4 }
    0
}

fn test_quat4_conjugate() -> i64 with Mut, Panic, Div {
    let q = Quat { w: 1.0, x: 2.0, y: 3.0, z: 4.0 }
    let q4 = quat4_load(q, q, q, q)

    let result = quat4_conjugate(q4)

    if !approx_eq(result.w[0], 1.0, 1e-9) { return 1 }
    if !approx_eq(result.x[0], -2.0, 1e-9) { return 2 }
    if !approx_eq(result.y[0], -3.0, 1e-9) { return 3 }
    if !approx_eq(result.z[0], -4.0, 1e-9) { return 4 }
    0
}

fn test_quat4_consistency() -> i64 with Mut, Panic, Div {
    // Verify SIMD results match scalar results
    let q1 = Quat { w: 1.0, x: 0.5, y: 0.3, z: 0.2 }
    let q2 = Quat { w: 0.9, x: 0.4, y: 0.6, z: 0.1 }

    let scalar_result = quat_mul(q1, q2)

    let q4a = quat4_load(q1, q1, q1, q1)
    let q4b = quat4_load(q2, q2, q2, q2)
    let simd_result = quat4_mul(q4a, q4b)

    // First lane of SIMD should match scalar
    if !approx_eq(simd_result.w[0], scalar_result.w, 1e-9) { return 1 }
    if !approx_eq(simd_result.x[0], scalar_result.x, 1e-9) { return 2 }
    if !approx_eq(simd_result.y[0], scalar_result.y, 1e-9) { return 3 }
    if !approx_eq(simd_result.z[0], scalar_result.z, 1e-9) { return 4 }
    0
}

// ============================================================================
// Main Test Runner
// ============================================================================

fn main() -> i64 with Mut, Panic, Div {
    var failed: i64 = 0

    // Scalar tests
    if test_quat_identity() != 0 { failed = failed + 1 }
    if test_quat_addition() != 0 { failed = failed + 1 }
    if test_quat_multiplication() != 0 { failed = failed + 1 }
    if test_quat_i_squared() != 0 { failed = failed + 1 }
    if test_quat_ijk_relation() != 0 { failed = failed + 1 }
    if test_quat_conjugate() != 0 { failed = failed + 1 }
    if test_quat_norm() != 0 { failed = failed + 1 }
    if test_quat_normalize() != 0 { failed = failed + 1 }
    if test_quat_inverse() != 0 { failed = failed + 1 }
    if test_quat_rotate_90deg() != 0 { failed = failed + 1 }

    // SIMD tests
    if test_quat4_addition() != 0 { failed = failed + 1 }
    if test_quat4_multiplication() != 0 { failed = failed + 1 }
    if test_quat4_conjugate() != 0 { failed = failed + 1 }
    if test_quat4_consistency() != 0 { failed = failed + 1 }

    if failed == 0 { 0 } else { 1 }
}
