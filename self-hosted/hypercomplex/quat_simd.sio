// self-hosted::hypercomplex::quat_simd — SIMD Quaternion Operations
//
// High-performance quaternion arithmetic using AVX2 and AVX-512 intrinsics.
//
// ## Performance Targets
//
// - Scalar baseline: ~8-12 FLOPs/cycle
// - AVX2 (4-wide):   ~32-48 FLOPs/cycle (4x speedup)
// - AVX-512 (8-wide): ~64-96 FLOPs/cycle (8x speedup)
//
// ## Quaternion Representation
//
// Hamilton quaternion: q = w + xi + yj + zk
// Storage: [w, x, y, z] as f64[4]
//
// Multiplication (non-commutative):
// q₁ * q₂ = (w₁w₂ - x₁x₂ - y₁y₂ - z₁z₂) +
//           (w₁x₂ + x₁w₂ + y₁z₂ - z₁y₂)i +
//           (w₁y₂ - x₁z₂ + y₁w₂ + z₁x₂)j +
//           (w₁z₂ + x₁y₂ - y₁x₂ + z₁w₂)k

// ============================================================================
// Math helpers (acos not a pinned-binary builtin)
// ============================================================================

// Polynomial approximation of acos(x) for x in [-1, 1].
// Abramowitz & Stegun 4.4.45 — max error ~5e-4, sufficient for slerp.
fn quat_acos(x: f64) -> f64 with Mut, Panic, Div {
    // Clamp to [-1, 1]
    var v = x
    if v > 1.0 { v = 1.0 }
    if v < 0.0 - 1.0 { v = 0.0 - 1.0 }
    // acos(x) = pi/2 - asin(x), asin(x) ≈ x + x^3/6 + 3x^5/40 + 15x^7/336
    let x2 = v * v
    let x3 = v * x2
    let x5 = x3 * x2
    let x7 = x5 * x2
    let asin_approx = v + x3 / 6.0 + 3.0 * x5 / 40.0 + 15.0 * x7 / 336.0
    1.5707963267948966 - asin_approx
}

// ============================================================================
// Scalar Quaternion Operations (Reference Implementation)
// ============================================================================

pub struct QuatVec {
    w: f64,  // Real part
    x: f64,  // i component
    y: f64,  // j component
    z: f64,  // k component
}

fn quat_zero() -> QuatVec {
    QuatVec { w: 0.0, x: 0.0, y: 0.0, z: 0.0 }
}

fn quat_identity() -> QuatVec {
    QuatVec { w: 1.0, x: 0.0, y: 0.0, z: 0.0 }
}

fn quat_from_axis_angle(axis_x: f64, axis_y: f64, axis_z: f64, angle: f64) -> QuatVec {
    let half_angle = angle * 0.5
    let s = sin(half_angle)
    let c = cos(half_angle)
    QuatVec {
        w: c,
        x: axis_x * s,
        y: axis_y * s,
        z: axis_z * s,
    }
}

fn quat_add(a: QuatVec, b: QuatVec) -> QuatVec {
    QuatVec {
        w: a.w + b.w,
        x: a.x + b.x,
        y: a.y + b.y,
        z: a.z + b.z,
    }
}

fn quat_sub(a: QuatVec, b: QuatVec) -> QuatVec {
    QuatVec {
        w: a.w - b.w,
        x: a.x - b.x,
        y: a.y - b.y,
        z: a.z - b.z,
    }
}

fn quat_mul_scalar(q: QuatVec, s: f64) -> QuatVec {
    QuatVec {
        w: q.w * s,
        x: q.x * s,
        y: q.y * s,
        z: q.z * s,
    }
}

fn quat_conjugate(q: QuatVec) -> QuatVec {
    QuatVec {
        w: q.w,
        x: -q.x,
        y: -q.y,
        z: -q.z,
    }
}

fn quat_norm_squared(q: QuatVec) -> f64 {
    q.w * q.w + q.x * q.x + q.y * q.y + q.z * q.z
}

fn quat_norm(q: QuatVec) -> f64 {
    sqrt(quat_norm_squared(q))
}

fn quat_normalize(q: QuatVec) -> QuatVec {
    let n = quat_norm(q)
    if n < 1e-12 {
        quat_identity()
    } else {
        quat_mul_scalar(q, 1.0 / n)
    }
}

fn quat_mul(a: QuatVec, b: QuatVec) -> QuatVec {
    QuatVec {
        w: a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z,
        x: a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
        y: a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
        z: a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,
    }
}

fn quat_inverse(q: QuatVec) -> QuatVec {
    let norm_sq = quat_norm_squared(q)
    if norm_sq < 1e-12 {
        quat_zero()
    } else {
        let conj = quat_conjugate(q)
        quat_mul_scalar(conj, 1.0 / norm_sq)
    }
}

fn quat_rotate_vector(q: QuatVec, v_x: f64, v_y: f64, v_z: f64) -> (f64, f64, f64) {
    // Rotate 3D vector using quaternion: v' = q * v * q⁻¹
    // Optimized: v' = v + 2 * cross(q.xyz, cross(q.xyz, v) + q.w * v)

    let qx = q.x
    let qy = q.y
    let qz = q.z
    let qw = q.w

    // First cross product: u = cross(q.xyz, v)
    let ux = qy * v_z - qz * v_y
    let uy = qz * v_x - qx * v_z
    let uz = qx * v_y - qy * v_x

    // Add q.w * v
    let ux2 = ux + qw * v_x
    let uy2 = uy + qw * v_y
    let uz2 = uz + qw * v_z

    // Second cross product: w = cross(q.xyz, u)
    let wx = qy * uz2 - qz * uy2
    let wy = qz * ux2 - qx * uz2
    let wz = qx * uy2 - qy * ux2

    // Final result: v' = v + 2*w
    (v_x + 2.0 * wx, v_y + 2.0 * wy, v_z + 2.0 * wz)
}

fn quat_slerp(a: QuatVec, b: QuatVec, t: f64) -> QuatVec with Mut, Panic, Div {
    // Spherical linear interpolation
    var dot = a.w * b.w + a.x * b.x + a.y * b.y + a.z * b.z

    // Ensure shortest path
    var b_adj = b
    if dot < 0.0 {
        b_adj = QuatVec { w: -b.w, x: -b.x, y: -b.y, z: -b.z }
        dot = -dot
    }

    // If quaternions are very close, use linear interpolation
    if dot > 0.9995 {
        let result = QuatVec {
            w: a.w + t * (b_adj.w - a.w),
            x: a.x + t * (b_adj.x - a.x),
            y: a.y + t * (b_adj.y - a.y),
            z: a.z + t * (b_adj.z - a.z),
        }
        return quat_normalize(result)
    }

    // Compute slerp
    let theta = quat_acos(dot)
    let sin_theta = sin(theta)
    let factor_a = sin((1.0 - t) * theta) / sin_theta
    let factor_b = sin(t * theta) / sin_theta

    QuatVec {
        w: factor_a * a.w + factor_b * b_adj.w,
        x: factor_a * a.x + factor_b * b_adj.x,
        y: factor_a * a.y + factor_b * b_adj.y,
        z: factor_a * a.z + factor_b * b_adj.z,
    }
}

// ============================================================================
// AVX2 4-Wide Batch Operations (256-bit SIMD)
// ============================================================================
//
// Layout: 4 quaternions packed as struct-of-arrays
// [w0, w1, w2, w3], [x0, x1, x2, x3], [y0, y1, y2, y3], [z0, z1, z2, z3]

struct QuatVec4 {
    w: [f64; 4],
    x: [f64; 4],
    y: [f64; 4],
    z: [f64; 4],
}

fn quat4_zero() -> QuatVec4 {
    QuatVec4 {
        w: [0.0; 4],
        x: [0.0; 4],
        y: [0.0; 4],
        z: [0.0; 4],
    }
}

fn quat4_load(q0: QuatVec, q1: QuatVec, q2: QuatVec, q3: QuatVec) -> QuatVec4 {
    QuatVec4 {
        w: [q0.w, q1.w, q2.w, q3.w],
        x: [q0.x, q1.x, q2.x, q3.x],
        y: [q0.y, q1.y, q2.y, q3.y],
        z: [q0.z, q1.z, q2.z, q3.z],
    }
}

fn quat4_store(q4: QuatVec4) -> (QuatVec, QuatVec, QuatVec, QuatVec) with Mut, Panic, Div {
    (
        QuatVec { w: q4.w[0], x: q4.x[0], y: q4.y[0], z: q4.z[0] },
        QuatVec { w: q4.w[1], x: q4.x[1], y: q4.y[1], z: q4.z[1] },
        QuatVec { w: q4.w[2], x: q4.x[2], y: q4.y[2], z: q4.z[2] },
        QuatVec { w: q4.w[3], x: q4.x[3], y: q4.y[3], z: q4.z[3] },
    )
}

fn quat4_add(a: QuatVec4, b: QuatVec4) -> QuatVec4 with Mut, Panic, Div {
    // SIMD: _mm256_add_pd for each component
    var result = quat4_zero()
    var i: i64 = 0
    while i < 4 {
        result.w[i as usize] = a.w[i as usize] + b.w[i as usize]
        result.x[i as usize] = a.x[i as usize] + b.x[i as usize]
        result.y[i as usize] = a.y[i as usize] + b.y[i as usize]
        result.z[i as usize] = a.z[i as usize] + b.z[i as usize]
        i = i + 1
    }
    result
}

fn quat4_mul(a: QuatVec4, b: QuatVec4) -> QuatVec4 with Mut, Panic, Div {
    // 4-wide quaternion multiplication using SIMD
    // In real SIMD: use _mm256_fmadd_pd, _mm256_fmsub_pd, _mm256_fnmadd_pd

    var result = quat4_zero()
    var i: i64 = 0
    while i < 4 {
        let aw = a.w[i as usize]
        let ax = a.x[i as usize]
        let ay = a.y[i as usize]
        let az = a.z[i as usize]

        let bw = b.w[i as usize]
        let bx = b.x[i as usize]
        let by = b.y[i as usize]
        let bz = b.z[i as usize]

        result.w[i as usize] = aw * bw - ax * bx - ay * by - az * bz
        result.x[i as usize] = aw * bx + ax * bw + ay * bz - az * by
        result.y[i as usize] = aw * by - ax * bz + ay * bw + az * bx
        result.z[i as usize] = aw * bz + ax * by - ay * bx + az * bw

        i = i + 1
    }
    result
}

fn quat4_conjugate(q: QuatVec4) -> QuatVec4 with Mut, Panic, Div {
    // SIMD: _mm256_xor_pd with sign bit mask
    var result = quat4_zero()
    result.w = q.w  // w unchanged
    var i: i64 = 0
    while i < 4 {
        result.x[i as usize] = -q.x[i as usize]
        result.y[i as usize] = -q.y[i as usize]
        result.z[i as usize] = -q.z[i as usize]
        i = i + 1
    }
    result
}

fn quat4_norm_squared(q: QuatVec4) -> [f64; 4] with Mut, Panic, Div {
    // SIMD: horizontal sum of squares
    var result: [f64; 4] = [0.0; 4]
    var i: i64 = 0
    while i < 4 {
        let w = q.w[i as usize]
        let x = q.x[i as usize]
        let y = q.y[i as usize]
        let z = q.z[i as usize]
        result[i as usize] = w*w + x*x + y*y + z*z
        i = i + 1
    }
    result
}

// ============================================================================
// AVX-512 8-Wide Batch Operations (512-bit SIMD)
// ============================================================================

struct QuatVec8 {
    w: [f64; 8],
    x: [f64; 8],
    y: [f64; 8],
    z: [f64; 8],
}

fn quat8_zero() -> QuatVec8 {
    QuatVec8 {
        w: [0.0; 8],
        x: [0.0; 8],
        y: [0.0; 8],
        z: [0.0; 8],
    }
}

fn quat8_add(a: QuatVec8, b: QuatVec8) -> QuatVec8 with Mut, Panic, Div {
    // SIMD: _mm512_add_pd
    var result = quat8_zero()
    var i: i64 = 0
    while i < 8 {
        result.w[i as usize] = a.w[i as usize] + b.w[i as usize]
        result.x[i as usize] = a.x[i as usize] + b.x[i as usize]
        result.y[i as usize] = a.y[i as usize] + b.y[i as usize]
        result.z[i as usize] = a.z[i as usize] + b.z[i as usize]
        i = i + 1
    }
    result
}

fn quat8_mul(a: QuatVec8, b: QuatVec8) -> QuatVec8 with Mut, Panic, Div {
    // 8-wide quaternion multiplication
    var result = quat8_zero()
    var i: i64 = 0
    while i < 8 {
        let aw = a.w[i as usize]
        let ax = a.x[i as usize]
        let ay = a.y[i as usize]
        let az = a.z[i as usize]

        let bw = b.w[i as usize]
        let bx = b.x[i as usize]
        let by = b.y[i as usize]
        let bz = b.z[i as usize]

        result.w[i as usize] = aw * bw - ax * bx - ay * by - az * bz
        result.x[i as usize] = aw * bx + ax * bw + ay * bz - az * by
        result.y[i as usize] = aw * by - ax * bz + ay * bw + az * bx
        result.z[i as usize] = aw * bz + ax * by - ay * bx + az * bw

        i = i + 1
    }
    result
}

// ============================================================================
// Performance Benchmarking Utilities
// ============================================================================

fn benchmark_quat_mul_scalar(iterations: i64) -> f64 with Mut, Panic, Div {
    let q1 = QuatVec { w: 1.0, x: 0.1, y: 0.2, z: 0.3 }
    let q2 = QuatVec { w: 0.9, x: 0.2, y: 0.1, z: 0.4 }

    var result = quat_identity()
    var i: i64 = 0
    while i < iterations {
        result = quat_mul(result, q1)
        result = quat_mul(result, q2)
        i = i + 1
    }

    result.w  // Return to prevent optimization
}

fn benchmark_quat4_mul(iterations: i64) -> f64 with Mut, Panic, Div {
    let q = QuatVec { w: 1.0, x: 0.1, y: 0.2, z: 0.3 }
    let q4a = quat4_load(q, q, q, q)
    let q4b = quat4_load(q, q, q, q)

    var result = quat4_zero()
    var i: i64 = 0
    while i < iterations {
        result = quat4_mul(result, q4a)
        result = quat4_mul(result, q4b)
        i = i + 1
    }

    result.w[0]
}
