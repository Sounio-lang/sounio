// self-hosted::hypercomplex::test_octonion — Octonion & Sedenion Tests

fn approx_eq(a: f64, b: f64, epsilon: f64) -> bool {
    let diff = if a > b { a - b } else { b - a }
    diff < epsilon
}

fn oct_approx_zero(o: Oct) -> bool with Mut, Panic, Div {
    oct_norm(o) < 1e-9
}

fn sed_approx_zero(s: Sed) -> bool with Mut, Panic, Div {
    sed_norm(s) < 1e-9
}

// ============================================================================
// Octonion Algebra Tests
// ============================================================================

// T01: e₀ is the multiplicative identity
fn test_oct_identity() -> i64 with Mut, Panic, Div {
    let e0 = oct_unit(0)
    let e3 = oct_unit(3)

    let product = oct_mul(e0, e3)

    // e₀ * e₃ = e₃
    if !approx_eq(product.e[3], 1.0, 1e-9) { return 1 }
    // All others should be zero
    if !approx_eq(product.e[0], 0.0, 1e-9) { return 2 }
    if !approx_eq(product.e[1], 0.0, 1e-9) { return 3 }
    0
}

// T02: eᵢ² = -1 for all imaginary units
fn test_oct_units_squared() -> i64 with Mut, Panic, Div {
    var i: i64 = 1
    while i < 8 {
        let ei = oct_unit(i)
        let product = oct_mul(ei, ei)

        // Should be -1 (real part = -1, imaginary parts = 0)
        if !approx_eq(product.e[0], -1.0, 1e-9) { return i }

        var j: i64 = 1
        while j < 8 {
            if !approx_eq(product.e[j as usize], 0.0, 1e-9) { return 10 + i }
            j = j + 1
        }

        i = i + 1
    }
    0
}

// T03: Fano plane triple: e₁ * e₂ = e₄
fn test_oct_fano_124() -> i64 with Mut, Panic, Div {
    let e1 = oct_unit(1)
    let e2 = oct_unit(2)

    let product = oct_mul(e1, e2)

    if !approx_eq(product.e[4], 1.0, 1e-9) { return 1 }
    if !approx_eq(product.e[0], 0.0, 1e-9) { return 2 }
    if !approx_eq(product.e[1], 0.0, 1e-9) { return 3 }
    0
}

// T04: Anti-commutativity: e₁ * e₂ = -e₂ * e₁
fn test_oct_anticommutative() -> i64 with Mut, Panic, Div {
    let e1 = oct_unit(1)
    let e2 = oct_unit(2)

    let ab = oct_mul(e1, e2)
    let ba = oct_mul(e2, e1)

    let sum = oct_add(ab, ba)

    // e₁e₂ + e₂e₁ = 0 (anti-commutative for distinct imaginary units)
    if !oct_approx_zero(sum) { return 1 }
    0
}

// T05: Non-associativity: (e₁ * e₂) * e₅ ≠ e₁ * (e₂ * e₅)
fn test_oct_non_associative() -> i64 with Mut, Panic, Div {
    let e1 = oct_unit(1)
    let e2 = oct_unit(2)
    let e5 = oct_unit(5)

    let assoc = oct_associator(e1, e2, e5)

    // The associator should be non-zero for octonions
    // (this is THE fundamental property distinguishing octonions from quaternions)
    let norm = oct_norm(assoc)
    if norm < 1e-9 { return 1 }  // Should be non-zero!
    0
}

// T06: Alternativity: [a, a, b] = 0
fn test_oct_alternative() -> i64 with Mut, Panic, Div {
    let a = oct_unit(1)
    let b = oct_unit(3)

    // Left alternative: (aa)b = a(ab)
    let assoc = oct_associator(a, a, b)
    if !oct_approx_zero(assoc) { return 1 }

    // Right alternative: (ab)b = a(bb)
    let assoc2 = oct_associator(a, b, b)
    if !oct_approx_zero(assoc2) { return 2 }

    0
}

// T07: Norm is multiplicative: |ab| = |a||b|
fn test_oct_norm_multiplicative() -> i64 with Mut, Panic, Div {
    var a = oct_zero()
    a.e[0] = 1.0
    a.e[1] = 2.0
    a.e[3] = 1.0

    var b = oct_zero()
    b.e[0] = 0.5
    b.e[2] = 1.5
    b.e[6] = 1.0

    let product = oct_mul(a, b)
    let norm_a = oct_norm(a)
    let norm_b = oct_norm(b)
    let norm_ab = oct_norm(product)

    // |ab| should equal |a| * |b| (composition algebra property)
    if !approx_eq(norm_ab, norm_a * norm_b, 1e-6) { return 1 }
    0
}

// T08: Conjugate product: a * ā = |a|²
fn test_oct_conjugate_product() -> i64 with Mut, Panic, Div {
    var a = oct_zero()
    a.e[0] = 1.0
    a.e[1] = 2.0
    a.e[2] = 3.0
    a.e[3] = 4.0

    let conj = oct_conjugate(a)
    let product = oct_mul(a, conj)

    // Should be real (no imaginary parts)
    var i: i64 = 1
    while i < 8 {
        if !approx_eq(product.e[i as usize], 0.0, 1e-6) { return i }
        i = i + 1
    }

    // Real part should be |a|²
    let norm_sq = oct_norm_squared(a)
    if !approx_eq(product.e[0], norm_sq, 1e-6) { return 10 }

    0
}

// T09: Cayley-Dickson construction matches Fano plane multiplication
fn test_oct_cayley_dickson_consistency() -> i64 with Mut, Panic, Div {
    var a = oct_zero()
    a.e[0] = 1.0
    a.e[1] = 0.5
    a.e[4] = 0.3

    var b = oct_zero()
    b.e[0] = 0.5
    b.e[2] = 1.0
    b.e[5] = 0.7

    let fano_result = oct_mul(a, b)
    let cd_result = oct_mul_cayley_dickson(a, b)

    // Both methods should produce the same result
    var i: i64 = 0
    while i < 8 {
        if !approx_eq(fano_result.e[i as usize], cd_result.e[i as usize], 1e-6) {
            return i + 1
        }
        i = i + 1
    }

    0
}

// ============================================================================
// Sedenion Tests
// ============================================================================

// T10: Sedenion multiplication (basic)
fn test_sed_mul_basics() -> i64 with Mut, Panic, Div {
    let one = sed_real(1.0)
    let e3 = sed_unit(3)

    let product = sed_mul(one, e3)

    // 1 * e₃ = e₃
    if !approx_eq(product.e[3], 1.0, 1e-9) { return 1 }
    if !approx_eq(product.e[0], 0.0, 1e-9) { return 2 }
    0
}

// T11: Sedenion eᵢ² = -1
fn test_sed_units_squared() -> i64 with Mut, Panic, Div {
    var i: i64 = 1
    while i < 16 {
        let ei = sed_unit(i)
        let product = sed_mul(ei, ei)

        // Should be -1
        if !approx_eq(product.e[0], -1.0, 1e-6) { return i }

        i = i + 1
    }
    0
}

// T12: ZERO DIVISORS EXIST in sedenions! (The defining property)
fn test_sed_zero_divisors() -> i64 with Mut, Panic, Div {
    // Classic zero divisor pair:
    //   z = e₃ + e₁₀
    //   w = e₆ - e₁₅
    //   z * w = 0 (but z ≠ 0 and w ≠ 0)

    var z = sed_zero()
    z.e[3] = 1.0
    z.e[10] = 1.0

    var w = sed_zero()
    w.e[6] = 1.0
    w.e[15] = -1.0

    // Both are non-zero
    if sed_is_zero(z) { return 1 }
    if sed_is_zero(w) { return 2 }

    // Their product should be zero!
    let product = sed_mul(z, w)
    if !sed_approx_zero(product) { return 3 }

    // The predicate should also confirm this
    if !sed_is_zero_divisor_pair(z, w) { return 4 }

    0
}

// T13: Sedenion norm is NOT multiplicative (unlike quaternions and octonions)
fn test_sed_norm_not_multiplicative() -> i64 with Mut, Panic, Div {
    // For the zero divisor pair, |z|*|w| > 0 but |z*w| = 0
    var z = sed_zero()
    z.e[3] = 1.0
    z.e[10] = 1.0

    var w = sed_zero()
    w.e[6] = 1.0
    w.e[15] = -1.0

    let product = sed_mul(z, w)

    let norm_z = sed_norm(z)
    let norm_w = sed_norm(w)
    let norm_zw = sed_norm(product)

    // |z| and |w| are positive
    if norm_z < 0.1 { return 1 }
    if norm_w < 0.1 { return 2 }

    // But |z*w| is zero!
    if !approx_eq(norm_zw, 0.0, 1e-6) { return 3 }

    // Therefore |z*w| ≠ |z|*|w| (norm is NOT multiplicative)
    // This is why sedenions break the composition algebra chain
    0
}

// T14: Zero divisor finder
fn test_sed_find_zero_divisor() -> i64 with Mut, Panic, Div {
    var z = sed_zero()
    z.e[3] = 1.0
    z.e[10] = 1.0

    let partner = sed_find_zero_divisor(z)

    // Should find a non-zero partner
    if sed_is_zero(partner) { return 1 }

    // And their product should be zero
    if !sed_is_zero_divisor_pair(z, partner) { return 2 }

    0
}

// ============================================================================
// Main Test Runner
// ============================================================================

fn main() -> i64 with Mut, Panic, Div {
    var failed: i64 = 0

    // Octonion tests
    if test_oct_identity() != 0 { failed = failed + 1 }
    if test_oct_units_squared() != 0 { failed = failed + 1 }
    if test_oct_fano_124() != 0 { failed = failed + 1 }
    if test_oct_anticommutative() != 0 { failed = failed + 1 }
    if test_oct_non_associative() != 0 { failed = failed + 1 }
    if test_oct_alternative() != 0 { failed = failed + 1 }
    if test_oct_norm_multiplicative() != 0 { failed = failed + 1 }
    if test_oct_conjugate_product() != 0 { failed = failed + 1 }
    if test_oct_cayley_dickson_consistency() != 0 { failed = failed + 1 }

    // Sedenion tests
    if test_sed_mul_basics() != 0 { failed = failed + 1 }
    if test_sed_units_squared() != 0 { failed = failed + 1 }
    if test_sed_zero_divisors() != 0 { failed = failed + 1 }
    if test_sed_norm_not_multiplicative() != 0 { failed = failed + 1 }
    if test_sed_find_zero_divisor() != 0 { failed = failed + 1 }

    if failed == 0 { 0 } else { 1 }
}
