// self-hosted::analysis::abstract_interp — Abstract Interpretation Engine
//
// Implements abstract interpretation over a simplified CFG representation.
// Three abstract domains are combined: interval (numeric ranges), sign
// (positive/negative/zero classification), and congruence (modular arithmetic).
//
// The analysis performs fixed-point iteration with widening to guarantee
// termination on loops. The worklist algorithm processes blocks in order,
// propagating abstract states along edges until convergence or the iteration
// limit is reached.
//
// Capacity: 256 registers, 512 blocks, 4096 instructions, 2048 edges.
// All structures use flat arrays — no heap allocation.

// ============================================================================
// CONSTANTS
// ============================================================================

let AI_MAX_REGS: i64 = 256
let AI_MAX_BLOCKS: i64 = 512
let AI_MAX_INSTRS: i64 = 4096
let AI_MAX_EDGES: i64 = 2048
let AI_MAX_ITERATIONS: i64 = 100
let AI_INF_POS: i64 = 2147483647
let AI_INF_NEG: i64 = 0 - 2147483647
let AI_WIDEN_THRESHOLD: i64 = 3

// ============================================================================
// ENUMS — Sign domain
// ============================================================================

enum AiSignValue {
    SignBot,
    SignNeg,
    SignZero,
    SignPos,
    SignNonNeg,
    SignNonPos,
    SignNonZero,
    SignTop,
}

// ============================================================================
// ENUMS — Interval state
// ============================================================================

enum AiIntervalState {
    IntBot,
    IntConcrete,
    IntTop,
}

// ============================================================================
// ENUMS — Instruction kind
// ============================================================================

enum AiInstrKind {
    AiConst,
    AiCopy,
    AiAdd,
    AiSub,
    AiMul,
    AiDiv,
    AiMod,
    AiNeg,
    AiAnd,
    AiOr,
    AiXor,
    AiShl,
    AiShr,
    AiCmpEq,
    AiCmpLt,
    AiCmpLe,
    AiCmpGt,
    AiCmpGe,
    AiPhi,
    AiBranch,
    AiReturn,
}

// ============================================================================
// ENUMS — Branch kind
// ============================================================================

enum AiBranchKind {
    BrUnconditional,
    BrIfTrue,
    BrIfFalse,
    BrIfEq,
    BrIfLt,
    BrIfLe,
}

// ============================================================================
// STRUCTS — Core data types
// ============================================================================

struct AiInterval {
    state: AiIntervalState,
    lo: i64,
    hi: i64,
}

struct AiCongruence {
    modulus: i64,
    remainder: i64,
    is_bot: bool,
}

struct AiAbstractValue {
    interval: AiInterval,
    sign: AiSignValue,
    congruence: AiCongruence,
}

struct AiAbstractState {
    regs: [AiAbstractValue; 256],
    reg_count: i64,
}

struct AiInstr {
    kind: AiInstrKind,
    dst: i64,
    src1: i64,
    src2: i64,
    imm: i64,
    block_id: i64,
}

struct AiEdge {
    from_block: i64,
    to_block: i64,
    branch_kind: AiBranchKind,
    cond_reg: i64,
}

struct AiBlock {
    id: i64,
    instr_start: i64,
    instr_count: i64,
    state_in: AiAbstractState,
    state_out: AiAbstractState,
    widen_count: i64,
}

struct AiContext {
    blocks: [AiBlock; 512],
    block_count: i64,
    instrs: [AiInstr; 4096],
    instr_count: i64,
    edges: [AiEdge; 2048],
    edge_count: i64,
    worklist: [i64; 512],
    wl_head: i64,
    wl_tail: i64,
    iteration_count: i64,
    max_iterations: i64,
    converged: bool,
    widen_threshold: i64,
}

// ============================================================================
// HELPER — min / max for i64
// ============================================================================

fn ai_min(a: i64, b: i64) -> i64 {
    if a <= b { a } else { b }
}

fn ai_max(a: i64, b: i64) -> i64 {
    if a >= b { a } else { b }
}

fn ai_abs(a: i64) -> i64 {
    if a >= 0 { a } else { 0 - a }
}

// ============================================================================
// GCD — used for congruence domain
// ============================================================================

fn ai_gcd(a: i64, b: i64) -> i64 with Mut, Div, Panic {
    var x = ai_abs(a)
    var y = ai_abs(b)
    if x == 0 { return y }
    if y == 0 { return x }
    while y != 0 {
        let t = y
        // Integer division remainder: x - (x / t) * t
        y = x - (x / t) * t
        x = t
    }
    x
}

// ============================================================================
// INTERVAL CONSTRUCTORS
// ============================================================================

fn ai_interval_bot() -> AiInterval {
    AiInterval { state: AiIntervalState::IntBot, lo: 0, hi: 0 }
}

fn ai_interval_top() -> AiInterval {
    AiInterval { state: AiIntervalState::IntTop, lo: AI_INF_NEG, hi: AI_INF_POS }
}

fn ai_interval_const(v: i64) -> AiInterval {
    AiInterval { state: AiIntervalState::IntConcrete, lo: v, hi: v }
}

fn ai_interval_range(lo: i64, hi: i64) -> AiInterval {
    if lo > hi {
        return ai_interval_bot()
    }
    AiInterval { state: AiIntervalState::IntConcrete, lo: lo, hi: hi }
}

// ============================================================================
// INTERVAL PREDICATES
// ============================================================================

fn ai_interval_is_bot(iv: AiInterval) -> bool {
    match iv.state {
        AiIntervalState::IntBot => true,
        _ => false,
    }
}

fn ai_interval_is_top(iv: AiInterval) -> bool {
    match iv.state {
        AiIntervalState::IntTop => true,
        _ => false,
    }
}

fn ai_interval_is_const(iv: AiInterval) -> bool {
    match iv.state {
        AiIntervalState::IntConcrete => iv.lo == iv.hi,
        _ => false,
    }
}

fn ai_interval_const_val(iv: AiInterval) -> i64 {
    iv.lo
}

fn ai_interval_contains(iv: AiInterval, v: i64) -> bool {
    match iv.state {
        AiIntervalState::IntBot => false,
        AiIntervalState::IntTop => true,
        AiIntervalState::IntConcrete => v >= iv.lo && v <= iv.hi,
    }
}

fn ai_interval_eq(a: AiInterval, b: AiInterval) -> bool {
    if ai_interval_is_bot(a) && ai_interval_is_bot(b) { return true }
    if ai_interval_is_top(a) && ai_interval_is_top(b) { return true }
    if ai_interval_is_bot(a) || ai_interval_is_bot(b) { return false }
    if ai_interval_is_top(a) || ai_interval_is_top(b) { return false }
    a.lo == b.lo && a.hi == b.hi
}

fn ai_interval_width(iv: AiInterval) -> i64 {
    match iv.state {
        AiIntervalState::IntBot => 0,
        AiIntervalState::IntTop => AI_INF_POS,
        AiIntervalState::IntConcrete => iv.hi - iv.lo,
    }
}

// ============================================================================
// INTERVAL LATTICE OPERATIONS
// ============================================================================

fn ai_interval_join(a: AiInterval, b: AiInterval) -> AiInterval {
    if ai_interval_is_bot(a) { return b }
    if ai_interval_is_bot(b) { return a }
    if ai_interval_is_top(a) { return a }
    if ai_interval_is_top(b) { return b }
    let lo = ai_min(a.lo, b.lo)
    let hi = ai_max(a.hi, b.hi)
    // Check for overflow to top
    if lo <= AI_INF_NEG && hi >= AI_INF_POS {
        return ai_interval_top()
    }
    AiInterval { state: AiIntervalState::IntConcrete, lo: lo, hi: hi }
}

fn ai_interval_meet(a: AiInterval, b: AiInterval) -> AiInterval {
    if ai_interval_is_bot(a) { return a }
    if ai_interval_is_bot(b) { return b }
    if ai_interval_is_top(a) { return b }
    if ai_interval_is_top(b) { return a }
    let lo = ai_max(a.lo, b.lo)
    let hi = ai_min(a.hi, b.hi)
    if lo > hi {
        return ai_interval_bot()
    }
    AiInterval { state: AiIntervalState::IntConcrete, lo: lo, hi: hi }
}

fn ai_interval_widen(old: AiInterval, new_iv: AiInterval) -> AiInterval {
    if ai_interval_is_bot(old) { return new_iv }
    if ai_interval_is_bot(new_iv) { return old }
    if ai_interval_is_top(old) { return old }
    if ai_interval_is_top(new_iv) { return ai_interval_top() }
    // Widen: if lower bound decreased, push to -inf; if upper bound increased, push to +inf
    let lo = if new_iv.lo < old.lo { AI_INF_NEG } else { old.lo }
    let hi = if new_iv.hi > old.hi { AI_INF_POS } else { old.hi }
    if lo <= AI_INF_NEG && hi >= AI_INF_POS {
        return ai_interval_top()
    }
    AiInterval { state: AiIntervalState::IntConcrete, lo: lo, hi: hi }
}

// ============================================================================
// INTERVAL ARITHMETIC
// ============================================================================

fn ai_interval_add(a: AiInterval, b: AiInterval) -> AiInterval {
    if ai_interval_is_bot(a) || ai_interval_is_bot(b) { return ai_interval_bot() }
    if ai_interval_is_top(a) || ai_interval_is_top(b) { return ai_interval_top() }
    let lo = a.lo + b.lo
    let hi = a.hi + b.hi
    // Clamp on overflow
    if lo < AI_INF_NEG { return ai_interval_top() }
    if hi > AI_INF_POS { return ai_interval_top() }
    AiInterval { state: AiIntervalState::IntConcrete, lo: lo, hi: hi }
}

fn ai_interval_sub(a: AiInterval, b: AiInterval) -> AiInterval {
    if ai_interval_is_bot(a) || ai_interval_is_bot(b) { return ai_interval_bot() }
    if ai_interval_is_top(a) || ai_interval_is_top(b) { return ai_interval_top() }
    let lo = a.lo - b.hi
    let hi = a.hi - b.lo
    if lo < AI_INF_NEG { return ai_interval_top() }
    if hi > AI_INF_POS { return ai_interval_top() }
    AiInterval { state: AiIntervalState::IntConcrete, lo: lo, hi: hi }
}

fn ai_interval_neg(a: AiInterval) -> AiInterval {
    if ai_interval_is_bot(a) { return ai_interval_bot() }
    if ai_interval_is_top(a) { return ai_interval_top() }
    let lo = 0 - a.hi
    let hi = 0 - a.lo
    AiInterval { state: AiIntervalState::IntConcrete, lo: lo, hi: hi }
}

// Helper: min of four values
fn ai_min4(a: i64, b: i64, c: i64, d: i64) -> i64 {
    ai_min(ai_min(a, b), ai_min(c, d))
}

// Helper: max of four values
fn ai_max4(a: i64, b: i64, c: i64, d: i64) -> i64 {
    ai_max(ai_max(a, b), ai_max(c, d))
}

fn ai_interval_mul(a: AiInterval, b: AiInterval) -> AiInterval {
    if ai_interval_is_bot(a) || ai_interval_is_bot(b) { return ai_interval_bot() }
    if ai_interval_is_top(a) || ai_interval_is_top(b) { return ai_interval_top() }
    // Enumerate the four corner products
    let p1 = a.lo * b.lo
    let p2 = a.lo * b.hi
    let p3 = a.hi * b.lo
    let p4 = a.hi * b.hi
    let lo = ai_min4(p1, p2, p3, p4)
    let hi = ai_max4(p1, p2, p3, p4)
    if lo < AI_INF_NEG || hi > AI_INF_POS { return ai_interval_top() }
    AiInterval { state: AiIntervalState::IntConcrete, lo: lo, hi: hi }
}

fn ai_interval_div(a: AiInterval, b: AiInterval) -> AiInterval {
    if ai_interval_is_bot(a) || ai_interval_is_bot(b) { return ai_interval_bot() }
    if ai_interval_is_top(a) || ai_interval_is_top(b) { return ai_interval_top() }
    // If b contains zero, go to top (could be undefined)
    if b.lo <= 0 && b.hi >= 0 { return ai_interval_top() }
    let p1 = a.lo / b.lo
    let p2 = a.lo / b.hi
    let p3 = a.hi / b.lo
    let p4 = a.hi / b.hi
    let lo = ai_min4(p1, p2, p3, p4)
    let hi = ai_max4(p1, p2, p3, p4)
    AiInterval { state: AiIntervalState::IntConcrete, lo: lo, hi: hi }
}

fn ai_interval_mod(a: AiInterval, b: AiInterval) -> AiInterval {
    if ai_interval_is_bot(a) || ai_interval_is_bot(b) { return ai_interval_bot() }
    if ai_interval_is_top(a) || ai_interval_is_top(b) { return ai_interval_top() }
    if b.lo <= 0 && b.hi >= 0 { return ai_interval_top() }
    // Conservative: result is in [-(|b_max|-1), |b_max|-1]
    let bmax = ai_max(ai_abs(b.lo), ai_abs(b.hi))
    let bound = bmax - 1
    ai_interval_range(0 - bound, bound)
}

// ============================================================================
// SIGN DOMAIN — Lattice operations
// ============================================================================
//
// Lattice:       SignTop
//              /   |   \
//         NonNeg NonZero NonPos
//           / \    |    / \
//        Pos  Zero  Zero  Neg
//           \   |   |   /
//            \  |   |  /
//              SignBot

fn ai_sign_is_bot(s: AiSignValue) -> bool {
    match s {
        AiSignValue::SignBot => true,
        _ => false,
    }
}

fn ai_sign_is_top(s: AiSignValue) -> bool {
    match s {
        AiSignValue::SignTop => true,
        _ => false,
    }
}

fn ai_sign_join(a: AiSignValue, b: AiSignValue) -> AiSignValue {
    if ai_sign_is_bot(a) { return b }
    if ai_sign_is_bot(b) { return a }
    if ai_sign_is_top(a) { return AiSignValue::SignTop }
    if ai_sign_is_top(b) { return AiSignValue::SignTop }
    // Same sign => same sign
    match a {
        AiSignValue::SignNeg => {
            match b {
                AiSignValue::SignNeg => AiSignValue::SignNeg,
                AiSignValue::SignZero => AiSignValue::SignNonPos,
                AiSignValue::SignPos => AiSignValue::SignNonZero,
                AiSignValue::SignNonNeg => AiSignValue::SignTop,
                AiSignValue::SignNonPos => AiSignValue::SignNonPos,
                AiSignValue::SignNonZero => AiSignValue::SignNonZero,
                _ => AiSignValue::SignTop,
            }
        },
        AiSignValue::SignZero => {
            match b {
                AiSignValue::SignNeg => AiSignValue::SignNonPos,
                AiSignValue::SignZero => AiSignValue::SignZero,
                AiSignValue::SignPos => AiSignValue::SignNonNeg,
                AiSignValue::SignNonNeg => AiSignValue::SignNonNeg,
                AiSignValue::SignNonPos => AiSignValue::SignNonPos,
                AiSignValue::SignNonZero => AiSignValue::SignTop,
                _ => AiSignValue::SignTop,
            }
        },
        AiSignValue::SignPos => {
            match b {
                AiSignValue::SignNeg => AiSignValue::SignNonZero,
                AiSignValue::SignZero => AiSignValue::SignNonNeg,
                AiSignValue::SignPos => AiSignValue::SignPos,
                AiSignValue::SignNonNeg => AiSignValue::SignNonNeg,
                AiSignValue::SignNonPos => AiSignValue::SignTop,
                AiSignValue::SignNonZero => AiSignValue::SignNonZero,
                _ => AiSignValue::SignTop,
            }
        },
        AiSignValue::SignNonNeg => {
            match b {
                AiSignValue::SignNeg => AiSignValue::SignTop,
                AiSignValue::SignZero => AiSignValue::SignNonNeg,
                AiSignValue::SignPos => AiSignValue::SignNonNeg,
                AiSignValue::SignNonNeg => AiSignValue::SignNonNeg,
                AiSignValue::SignNonPos => AiSignValue::SignTop,
                AiSignValue::SignNonZero => AiSignValue::SignTop,
                _ => AiSignValue::SignTop,
            }
        },
        AiSignValue::SignNonPos => {
            match b {
                AiSignValue::SignNeg => AiSignValue::SignNonPos,
                AiSignValue::SignZero => AiSignValue::SignNonPos,
                AiSignValue::SignPos => AiSignValue::SignTop,
                AiSignValue::SignNonNeg => AiSignValue::SignTop,
                AiSignValue::SignNonPos => AiSignValue::SignNonPos,
                AiSignValue::SignNonZero => AiSignValue::SignTop,
                _ => AiSignValue::SignTop,
            }
        },
        AiSignValue::SignNonZero => {
            match b {
                AiSignValue::SignNeg => AiSignValue::SignNonZero,
                AiSignValue::SignZero => AiSignValue::SignTop,
                AiSignValue::SignPos => AiSignValue::SignNonZero,
                AiSignValue::SignNonNeg => AiSignValue::SignTop,
                AiSignValue::SignNonPos => AiSignValue::SignTop,
                AiSignValue::SignNonZero => AiSignValue::SignNonZero,
                _ => AiSignValue::SignTop,
            }
        },
        _ => AiSignValue::SignTop,
    }
}

fn ai_sign_meet(a: AiSignValue, b: AiSignValue) -> AiSignValue {
    if ai_sign_is_bot(a) { return AiSignValue::SignBot }
    if ai_sign_is_bot(b) { return AiSignValue::SignBot }
    if ai_sign_is_top(a) { return b }
    if ai_sign_is_top(b) { return a }
    match a {
        AiSignValue::SignNeg => {
            match b {
                AiSignValue::SignNeg => AiSignValue::SignNeg,
                AiSignValue::SignZero => AiSignValue::SignBot,
                AiSignValue::SignPos => AiSignValue::SignBot,
                AiSignValue::SignNonNeg => AiSignValue::SignBot,
                AiSignValue::SignNonPos => AiSignValue::SignNeg,
                AiSignValue::SignNonZero => AiSignValue::SignNeg,
                _ => AiSignValue::SignBot,
            }
        },
        AiSignValue::SignZero => {
            match b {
                AiSignValue::SignNeg => AiSignValue::SignBot,
                AiSignValue::SignZero => AiSignValue::SignZero,
                AiSignValue::SignPos => AiSignValue::SignBot,
                AiSignValue::SignNonNeg => AiSignValue::SignZero,
                AiSignValue::SignNonPos => AiSignValue::SignZero,
                AiSignValue::SignNonZero => AiSignValue::SignBot,
                _ => AiSignValue::SignBot,
            }
        },
        AiSignValue::SignPos => {
            match b {
                AiSignValue::SignNeg => AiSignValue::SignBot,
                AiSignValue::SignZero => AiSignValue::SignBot,
                AiSignValue::SignPos => AiSignValue::SignPos,
                AiSignValue::SignNonNeg => AiSignValue::SignPos,
                AiSignValue::SignNonPos => AiSignValue::SignBot,
                AiSignValue::SignNonZero => AiSignValue::SignPos,
                _ => AiSignValue::SignBot,
            }
        },
        AiSignValue::SignNonNeg => {
            match b {
                AiSignValue::SignNeg => AiSignValue::SignBot,
                AiSignValue::SignZero => AiSignValue::SignZero,
                AiSignValue::SignPos => AiSignValue::SignPos,
                AiSignValue::SignNonNeg => AiSignValue::SignNonNeg,
                AiSignValue::SignNonPos => AiSignValue::SignZero,
                AiSignValue::SignNonZero => AiSignValue::SignPos,
                _ => AiSignValue::SignBot,
            }
        },
        AiSignValue::SignNonPos => {
            match b {
                AiSignValue::SignNeg => AiSignValue::SignNeg,
                AiSignValue::SignZero => AiSignValue::SignZero,
                AiSignValue::SignPos => AiSignValue::SignBot,
                AiSignValue::SignNonNeg => AiSignValue::SignZero,
                AiSignValue::SignNonPos => AiSignValue::SignNonPos,
                AiSignValue::SignNonZero => AiSignValue::SignNeg,
                _ => AiSignValue::SignBot,
            }
        },
        AiSignValue::SignNonZero => {
            match b {
                AiSignValue::SignNeg => AiSignValue::SignNeg,
                AiSignValue::SignZero => AiSignValue::SignBot,
                AiSignValue::SignPos => AiSignValue::SignPos,
                AiSignValue::SignNonNeg => AiSignValue::SignPos,
                AiSignValue::SignNonPos => AiSignValue::SignNeg,
                AiSignValue::SignNonZero => AiSignValue::SignNonZero,
                _ => AiSignValue::SignBot,
            }
        },
        _ => AiSignValue::SignBot,
    }
}

fn ai_sign_of_interval(iv: AiInterval) -> AiSignValue {
    if ai_interval_is_bot(iv) { return AiSignValue::SignBot }
    if ai_interval_is_top(iv) { return AiSignValue::SignTop }
    let lo = iv.lo
    let hi = iv.hi
    if lo > 0 { return AiSignValue::SignPos }
    if hi < 0 { return AiSignValue::SignNeg }
    if lo == 0 && hi == 0 { return AiSignValue::SignZero }
    if lo >= 0 { return AiSignValue::SignNonNeg }
    if hi <= 0 { return AiSignValue::SignNonPos }
    // lo < 0 && hi > 0 => NonZero not possible, it is Top
    AiSignValue::SignTop
}

fn ai_sign_eq(a: AiSignValue, b: AiSignValue) -> bool {
    match a {
        AiSignValue::SignBot => ai_sign_is_bot(b),
        AiSignValue::SignNeg => {
            match b {
                AiSignValue::SignNeg => true,
                _ => false,
            }
        },
        AiSignValue::SignZero => {
            match b {
                AiSignValue::SignZero => true,
                _ => false,
            }
        },
        AiSignValue::SignPos => {
            match b {
                AiSignValue::SignPos => true,
                _ => false,
            }
        },
        AiSignValue::SignNonNeg => {
            match b {
                AiSignValue::SignNonNeg => true,
                _ => false,
            }
        },
        AiSignValue::SignNonPos => {
            match b {
                AiSignValue::SignNonPos => true,
                _ => false,
            }
        },
        AiSignValue::SignNonZero => {
            match b {
                AiSignValue::SignNonZero => true,
                _ => false,
            }
        },
        AiSignValue::SignTop => ai_sign_is_top(b),
    }
}

// ============================================================================
// CONGRUENCE DOMAIN — {m*k + r | k in Z}, represented as (modulus, remainder)
// ============================================================================
//
// Bot = unreachable. Top = (0, 0) with is_bot=false (any value).
// Concrete constant c = (0, c) with is_bot=false.
// Aligned to m = (m, 0) with is_bot=false.

fn ai_cong_bot() -> AiCongruence {
    AiCongruence { modulus: 0, remainder: 0, is_bot: true }
}

fn ai_cong_top() -> AiCongruence {
    AiCongruence { modulus: 1, remainder: 0, is_bot: false }
}

fn ai_cong_new(m: i64, r: i64) -> AiCongruence with Mut, Panic {
    if m == 0 {
        // Represents the single value r
        return AiCongruence { modulus: 0, remainder: r, is_bot: false }
    }
    let abs_m = ai_abs(m)
    // Normalize remainder to [0, abs_m)
    var rem = r - (r / abs_m) * abs_m
    if rem < 0 {
        rem = rem + abs_m
    }
    AiCongruence { modulus: abs_m, remainder: rem, is_bot: false }
}

fn ai_cong_const(v: i64) -> AiCongruence {
    AiCongruence { modulus: 0, remainder: v, is_bot: false }
}

fn ai_cong_is_bot(c: AiCongruence) -> bool {
    c.is_bot
}

fn ai_cong_is_top(c: AiCongruence) -> bool {
    if c.is_bot { return false }
    c.modulus == 1 && c.remainder == 0
}

fn ai_cong_is_const(c: AiCongruence) -> bool {
    if c.is_bot { return false }
    c.modulus == 0
}

fn ai_cong_eq(a: AiCongruence, b: AiCongruence) -> bool {
    if a.is_bot && b.is_bot { return true }
    if a.is_bot || b.is_bot { return false }
    a.modulus == b.modulus && a.remainder == b.remainder
}

fn ai_cong_join(a: AiCongruence, b: AiCongruence) -> AiCongruence with Mut, Div, Panic {
    if a.is_bot { return b }
    if b.is_bot { return a }
    // join(m1*k+r1, m2*k+r2) = gcd(m1, m2, |r1-r2|)*k + min(r1,r2) mod gcd
    let diff = ai_abs(a.remainder - b.remainder)
    let g1 = ai_gcd(a.modulus, b.modulus)
    let g = ai_gcd(g1, diff)
    if g == 0 {
        // Both are constants
        if a.remainder == b.remainder {
            return a
        }
        // Different constants: gcd of their difference
        return ai_cong_new(diff, a.remainder)
    }
    ai_cong_new(g, a.remainder)
}

fn ai_cong_meet(a: AiCongruence, b: AiCongruence) -> AiCongruence with Mut, Div, Panic {
    if a.is_bot { return a }
    if b.is_bot { return b }
    if ai_cong_is_top(a) { return b }
    if ai_cong_is_top(b) { return a }
    // meet(m1*k+r1, m2*k+r2):
    // If r1 mod gcd(m1,m2) != r2 mod gcd(m1,m2), result is bot.
    // Otherwise, modulus = lcm(m1,m2) and solve for remainder via CRT.
    if a.modulus == 0 && b.modulus == 0 {
        // Both are constants
        if a.remainder == b.remainder { return a }
        return ai_cong_bot()
    }
    if a.modulus == 0 {
        // a is constant: check if a.remainder satisfies b
        if b.modulus == 0 {
            if a.remainder == b.remainder { return a }
            return ai_cong_bot()
        }
        let check = a.remainder - b.remainder
        let mod_check = check - (check / b.modulus) * b.modulus
        if mod_check == 0 {
            return a
        }
        return ai_cong_bot()
    }
    if b.modulus == 0 {
        let check = b.remainder - a.remainder
        let mod_check = check - (check / a.modulus) * a.modulus
        if mod_check == 0 {
            return b
        }
        return ai_cong_bot()
    }
    // General case: gcd check for compatibility
    let g = ai_gcd(a.modulus, b.modulus)
    let diff = a.remainder - b.remainder
    let diff_mod = diff - (diff / g) * g
    if diff_mod != 0 {
        return ai_cong_bot()
    }
    // LCM = a.modulus * b.modulus / gcd
    let lcm = (a.modulus / g) * b.modulus
    ai_cong_new(lcm, a.remainder)
}

// ============================================================================
// CONGRUENCE ARITHMETIC
// ============================================================================

fn ai_cong_add(a: AiCongruence, b: AiCongruence) -> AiCongruence with Mut, Div, Panic {
    if a.is_bot || b.is_bot { return ai_cong_bot() }
    let m = ai_gcd(a.modulus, b.modulus)
    let r = a.remainder + b.remainder
    ai_cong_new(m, r)
}

fn ai_cong_sub(a: AiCongruence, b: AiCongruence) -> AiCongruence with Mut, Div, Panic {
    if a.is_bot || b.is_bot { return ai_cong_bot() }
    let m = ai_gcd(a.modulus, b.modulus)
    let r = a.remainder - b.remainder
    ai_cong_new(m, r)
}

fn ai_cong_mul(a: AiCongruence, b: AiCongruence) -> AiCongruence with Mut, Div, Panic {
    if a.is_bot || b.is_bot { return ai_cong_bot() }
    // (m1*k+r1)*(m2*j+r2) = ... modulus gcd(m1*m2, m1*r2, m2*r1), remainder r1*r2
    let t1 = a.modulus * b.modulus
    let t2 = a.modulus * b.remainder
    let t3 = b.modulus * a.remainder
    let g1 = ai_gcd(t1, t2)
    let m = ai_gcd(g1, t3)
    let r = a.remainder * b.remainder
    ai_cong_new(m, r)
}

fn ai_cong_neg(a: AiCongruence) -> AiCongruence with Mut, Panic {
    if a.is_bot { return ai_cong_bot() }
    ai_cong_new(a.modulus, 0 - a.remainder)
}

// ============================================================================
// ABSTRACT VALUE — Combined interval + sign + congruence
// ============================================================================

fn ai_value_bot() -> AiAbstractValue {
    AiAbstractValue {
        interval: ai_interval_bot(),
        sign: AiSignValue::SignBot,
        congruence: ai_cong_bot(),
    }
}

fn ai_value_top() -> AiAbstractValue {
    AiAbstractValue {
        interval: ai_interval_top(),
        sign: AiSignValue::SignTop,
        congruence: ai_cong_top(),
    }
}

fn ai_value_const(v: i64) -> AiAbstractValue {
    AiAbstractValue {
        interval: ai_interval_const(v),
        sign: ai_sign_of_interval(ai_interval_const(v)),
        congruence: ai_cong_const(v),
    }
}

fn ai_value_from_interval(iv: AiInterval) -> AiAbstractValue {
    AiAbstractValue {
        interval: iv,
        sign: ai_sign_of_interval(iv),
        congruence: ai_cong_top(),
    }
}

fn ai_value_join(a: AiAbstractValue, b: AiAbstractValue) -> AiAbstractValue with Mut, Div, Panic {
    AiAbstractValue {
        interval: ai_interval_join(a.interval, b.interval),
        sign: ai_sign_join(a.sign, b.sign),
        congruence: ai_cong_join(a.congruence, b.congruence),
    }
}

fn ai_value_meet(a: AiAbstractValue, b: AiAbstractValue) -> AiAbstractValue with Mut, Div, Panic {
    AiAbstractValue {
        interval: ai_interval_meet(a.interval, b.interval),
        sign: ai_sign_meet(a.sign, b.sign),
        congruence: ai_cong_meet(a.congruence, b.congruence),
    }
}

fn ai_value_eq(a: AiAbstractValue, b: AiAbstractValue) -> bool {
    ai_interval_eq(a.interval, b.interval)
        && ai_sign_eq(a.sign, b.sign)
        && ai_cong_eq(a.congruence, b.congruence)
}

fn ai_value_widen(old: AiAbstractValue, new_v: AiAbstractValue) -> AiAbstractValue with Mut, Div, Panic {
    // Widen interval; sign and congruence just join (they are finite lattices)
    AiAbstractValue {
        interval: ai_interval_widen(old.interval, new_v.interval),
        sign: ai_sign_join(old.sign, new_v.sign),
        congruence: ai_cong_join(old.congruence, new_v.congruence),
    }
}

fn ai_value_is_bot(v: AiAbstractValue) -> bool {
    ai_interval_is_bot(v.interval)
}

fn ai_value_is_top(v: AiAbstractValue) -> bool {
    ai_interval_is_top(v.interval) && ai_sign_is_top(v.sign) && ai_cong_is_top(v.congruence)
}

fn ai_value_is_const(v: AiAbstractValue) -> bool {
    ai_interval_is_const(v.interval)
}

fn ai_value_const_val(v: AiAbstractValue) -> i64 {
    ai_interval_const_val(v.interval)
}

// ============================================================================
// ABSTRACT STATE — Register file mapping
// ============================================================================

fn ai_default_value() -> AiAbstractValue {
    ai_value_bot()
}

fn ai_state_new() -> AiAbstractState with Mut, Div, Panic {
    var regs: [AiAbstractValue; 256] = [ai_default_value(); 256]
    AiAbstractState { regs: regs, reg_count: 0 }
}

fn ai_state_bot() -> AiAbstractState with Mut, Div, Panic {
    ai_state_new()
}

fn ai_state_top() -> AiAbstractState with Mut, Div, Panic {
    var regs: [AiAbstractValue; 256] = [ai_value_top(); 256]
    AiAbstractState { regs: regs, reg_count: AI_MAX_REGS }
}

fn ai_state_get_reg(s: &AiAbstractState, r: i64) -> AiAbstractValue with Div, Panic {
    if r < 0 || r >= AI_MAX_REGS {
        return ai_value_bot()
    }
    s.regs[r as usize]
}

fn ai_state_set_reg(s: &! AiAbstractState, r: i64, v: AiAbstractValue) with Mut, Div, Panic {
    if r < 0 || r >= AI_MAX_REGS {
        return
    }
    s.regs[r as usize] = v
    if r >= s.reg_count {
        s.reg_count = r + 1
    }
}

fn ai_state_join(a: &AiAbstractState, b: &AiAbstractState) -> AiAbstractState with Mut, Div, Panic {
    var result = ai_state_new()
    let count = ai_max(a.reg_count, b.reg_count)
    result.reg_count = count
    var i: i64 = 0
    while i < count {
        let va = a.regs[i as usize]
        let vb = b.regs[i as usize]
        result.regs[i as usize] = ai_value_join(va, vb)
        i = i + 1
    }
    result
}

fn ai_state_widen(old: &AiAbstractState, new_s: &AiAbstractState) -> AiAbstractState with Mut, Div, Panic {
    var result = ai_state_new()
    let count = ai_max(old.reg_count, new_s.reg_count)
    result.reg_count = count
    var i: i64 = 0
    while i < count {
        let vo = old.regs[i as usize]
        let vn = new_s.regs[i as usize]
        result.regs[i as usize] = ai_value_widen(vo, vn)
        i = i + 1
    }
    result
}

fn ai_state_eq(a: &AiAbstractState, b: &AiAbstractState) -> bool with Mut, Div, Panic {
    if a.reg_count != b.reg_count { return false }
    var i: i64 = 0
    while i < a.reg_count {
        if ai_value_eq(a.regs[i as usize], b.regs[i as usize]) == false {
            return false
        }
        i = i + 1
    }
    true
}

fn ai_state_copy(src: &AiAbstractState) -> AiAbstractState with Mut, Div, Panic {
    var result = ai_state_new()
    result.reg_count = src.reg_count
    var i: i64 = 0
    while i < src.reg_count {
        result.regs[i as usize] = src.regs[i as usize]
        i = i + 1
    }
    result
}

// ============================================================================
// DEFAULT CONSTRUCTORS — Blocks, Instructions, Edges
// ============================================================================

fn ai_default_block() -> AiBlock with Mut, Div, Panic {
    AiBlock {
        id: 0,
        instr_start: 0,
        instr_count: 0,
        state_in: ai_state_new(),
        state_out: ai_state_new(),
        widen_count: 0,
    }
}

fn ai_default_instr() -> AiInstr {
    AiInstr {
        kind: AiInstrKind::AiConst,
        dst: 0,
        src1: 0,
        src2: 0,
        imm: 0,
        block_id: 0,
    }
}

fn ai_default_edge() -> AiEdge {
    AiEdge {
        from_block: 0,
        to_block: 0,
        branch_kind: AiBranchKind::BrUnconditional,
        cond_reg: 0,
    }
}

// ============================================================================
// CONTEXT CONSTRUCTOR
// ============================================================================

fn ai_context_new() -> AiContext with Mut, Div, Panic {
    AiContext {
        blocks: [ai_default_block(); 512],
        block_count: 0,
        instrs: [ai_default_instr(); 4096],
        instr_count: 0,
        edges: [ai_default_edge(); 2048],
        edge_count: 0,
        worklist: [0; 512],
        wl_head: 0,
        wl_tail: 0,
        iteration_count: 0,
        max_iterations: AI_MAX_ITERATIONS,
        converged: false,
        widen_threshold: AI_WIDEN_THRESHOLD,
    }
}

// ============================================================================
// WORKLIST OPERATIONS
// ============================================================================

fn ai_worklist_empty(ctx: &AiContext) -> bool {
    ctx.wl_head == ctx.wl_tail
}

fn ai_worklist_push(ctx: &! AiContext, block_id: i64) -> bool with Mut, Div, Panic {
    // Check if already in the worklist (avoid duplicates)
    var i = ctx.wl_head
    while i < ctx.wl_tail {
        let idx = i - (i / AI_MAX_BLOCKS) * AI_MAX_BLOCKS
        if ctx.worklist[idx as usize] == block_id {
            return false
        }
        i = i + 1
    }
    if ctx.wl_tail - ctx.wl_head >= AI_MAX_BLOCKS {
        return false
    }
    let idx = ctx.wl_tail - (ctx.wl_tail / AI_MAX_BLOCKS) * AI_MAX_BLOCKS
    ctx.worklist[idx as usize] = block_id
    ctx.wl_tail = ctx.wl_tail + 1
    true
}

fn ai_worklist_pop(ctx: &! AiContext) -> i64 with Mut, Div, Panic {
    if ai_worklist_empty(ctx) {
        return 0 - 1
    }
    let idx = ctx.wl_head - (ctx.wl_head / AI_MAX_BLOCKS) * AI_MAX_BLOCKS
    let result = ctx.worklist[idx as usize]
    ctx.wl_head = ctx.wl_head + 1
    result
}

fn ai_worklist_clear(ctx: &! AiContext) with Mut {
    ctx.wl_head = 0
    ctx.wl_tail = 0
}

// ============================================================================
// CFG CONSTRUCTION
// ============================================================================

fn ai_add_block(ctx: &! AiContext) -> i64 with Mut, Div, Panic {
    if ctx.block_count >= AI_MAX_BLOCKS {
        return 0 - 1
    }
    let id = ctx.block_count
    ctx.blocks[id as usize].id = id
    ctx.blocks[id as usize].instr_start = ctx.instr_count
    ctx.blocks[id as usize].instr_count = 0
    ctx.blocks[id as usize].widen_count = 0
    ctx.block_count = ctx.block_count + 1
    id
}

fn ai_add_instr(ctx: &! AiContext, kind: AiInstrKind, dst: i64, src1: i64, src2: i64, imm: i64, block_id: i64) -> i64 with Mut, Div, Panic {
    if ctx.instr_count >= AI_MAX_INSTRS {
        return 0 - 1
    }
    let idx = ctx.instr_count
    ctx.instrs[idx as usize] = AiInstr {
        kind: kind,
        dst: dst,
        src1: src1,
        src2: src2,
        imm: imm,
        block_id: block_id,
    }
    // Update block instr count
    if block_id >= 0 && block_id < ctx.block_count {
        ctx.blocks[block_id as usize].instr_count = ctx.blocks[block_id as usize].instr_count + 1
    }
    ctx.instr_count = ctx.instr_count + 1
    idx
}

fn ai_add_edge(ctx: &! AiContext, from: i64, to: i64, branch: AiBranchKind, cond_reg: i64) -> i64 with Mut, Div, Panic {
    if ctx.edge_count >= AI_MAX_EDGES {
        return 0 - 1
    }
    let idx = ctx.edge_count
    ctx.edges[idx as usize] = AiEdge {
        from_block: from,
        to_block: to,
        branch_kind: branch,
        cond_reg: cond_reg,
    }
    ctx.edge_count = ctx.edge_count + 1
    idx
}

// ============================================================================
// TRANSFER FUNCTIONS — Single instruction
// ============================================================================

fn ai_transfer_const(state: &! AiAbstractState, dst: i64, imm: i64) with Mut, Div, Panic {
    let v = ai_value_const(imm)
    ai_state_set_reg(state, dst, v)
}

fn ai_transfer_copy(state: &! AiAbstractState, dst: i64, src: i64) with Mut, Div, Panic {
    let v = ai_state_get_reg(state, src)
    ai_state_set_reg(state, dst, v)
}

fn ai_transfer_add(state: &! AiAbstractState, dst: i64, src1: i64, src2: i64) with Mut, Div, Panic {
    let a = ai_state_get_reg(state, src1)
    let b = ai_state_get_reg(state, src2)
    let iv = ai_interval_add(a.interval, b.interval)
    let cg = ai_cong_add(a.congruence, b.congruence)
    let v = AiAbstractValue {
        interval: iv,
        sign: ai_sign_of_interval(iv),
        congruence: cg,
    }
    ai_state_set_reg(state, dst, v)
}

fn ai_transfer_sub(state: &! AiAbstractState, dst: i64, src1: i64, src2: i64) with Mut, Div, Panic {
    let a = ai_state_get_reg(state, src1)
    let b = ai_state_get_reg(state, src2)
    let iv = ai_interval_sub(a.interval, b.interval)
    let cg = ai_cong_sub(a.congruence, b.congruence)
    let v = AiAbstractValue {
        interval: iv,
        sign: ai_sign_of_interval(iv),
        congruence: cg,
    }
    ai_state_set_reg(state, dst, v)
}

fn ai_transfer_mul(state: &! AiAbstractState, dst: i64, src1: i64, src2: i64) with Mut, Div, Panic {
    let a = ai_state_get_reg(state, src1)
    let b = ai_state_get_reg(state, src2)
    let iv = ai_interval_mul(a.interval, b.interval)
    let cg = ai_cong_mul(a.congruence, b.congruence)
    let v = AiAbstractValue {
        interval: iv,
        sign: ai_sign_of_interval(iv),
        congruence: cg,
    }
    ai_state_set_reg(state, dst, v)
}

fn ai_transfer_div(state: &! AiAbstractState, dst: i64, src1: i64, src2: i64) with Mut, Div, Panic {
    let a = ai_state_get_reg(state, src1)
    let b = ai_state_get_reg(state, src2)
    let iv = ai_interval_div(a.interval, b.interval)
    // Division congruence is imprecise; go to top
    let v = AiAbstractValue {
        interval: iv,
        sign: ai_sign_of_interval(iv),
        congruence: ai_cong_top(),
    }
    ai_state_set_reg(state, dst, v)
}

fn ai_transfer_mod(state: &! AiAbstractState, dst: i64, src1: i64, src2: i64) with Mut, Div, Panic {
    let a = ai_state_get_reg(state, src1)
    let b = ai_state_get_reg(state, src2)
    let iv = ai_interval_mod(a.interval, b.interval)
    let v = AiAbstractValue {
        interval: iv,
        sign: ai_sign_of_interval(iv),
        congruence: ai_cong_top(),
    }
    ai_state_set_reg(state, dst, v)
}

fn ai_transfer_neg(state: &! AiAbstractState, dst: i64, src1: i64) with Mut, Div, Panic {
    let a = ai_state_get_reg(state, src1)
    let iv = ai_interval_neg(a.interval)
    let cg = ai_cong_neg(a.congruence)
    let v = AiAbstractValue {
        interval: iv,
        sign: ai_sign_of_interval(iv),
        congruence: cg,
    }
    ai_state_set_reg(state, dst, v)
}

fn ai_transfer_and(state: &! AiAbstractState, dst: i64, src1: i64, src2: i64) with Mut, Div, Panic {
    // Bitwise AND: imprecise, use top with a heuristic on non-negativity
    let a = ai_state_get_reg(state, src1)
    let b = ai_state_get_reg(state, src2)
    // If either operand is non-negative, result is non-negative and <= min(hi_a, hi_b)
    let a_nn = ai_interval_is_bot(a.interval) == false && a.interval.lo >= 0
    let b_nn = ai_interval_is_bot(b.interval) == false && b.interval.lo >= 0
    if a_nn || b_nn {
        let hi = if a_nn && b_nn {
            ai_min(a.interval.hi, b.interval.hi)
        } else if a_nn {
            a.interval.hi
        } else {
            b.interval.hi
        }
        let iv = ai_interval_range(0, hi)
        let v = AiAbstractValue {
            interval: iv,
            sign: ai_sign_of_interval(iv),
            congruence: ai_cong_top(),
        }
        ai_state_set_reg(state, dst, v)
    } else {
        ai_state_set_reg(state, dst, ai_value_top())
    }
}

fn ai_transfer_or(state: &! AiAbstractState, dst: i64, src1: i64, src2: i64) with Mut, Div, Panic {
    // Bitwise OR: imprecise
    ai_state_set_reg(state, dst, ai_value_top())
}

fn ai_transfer_xor(state: &! AiAbstractState, dst: i64, src1: i64, src2: i64) with Mut, Div, Panic {
    // Bitwise XOR: imprecise
    ai_state_set_reg(state, dst, ai_value_top())
}

fn ai_transfer_shl(state: &! AiAbstractState, dst: i64, src1: i64, src2: i64) with Mut, Div, Panic {
    let a = ai_state_get_reg(state, src1)
    let b = ai_state_get_reg(state, src2)
    // If shift amount is a constant, we can be precise
    if ai_value_is_const(b) {
        let shift = ai_value_const_val(b)
        if shift >= 0 && shift < 63 {
            // Multiply interval by 2^shift
            var factor: i64 = 1
            var s: i64 = 0
            while s < shift {
                factor = factor * 2
                s = s + 1
            }
            let fiv = ai_interval_const(factor)
            let iv = ai_interval_mul(a.interval, fiv)
            let v = AiAbstractValue {
                interval: iv,
                sign: ai_sign_of_interval(iv),
                congruence: ai_cong_top(),
            }
            ai_state_set_reg(state, dst, v)
            return
        }
    }
    ai_state_set_reg(state, dst, ai_value_top())
}

fn ai_transfer_shr(state: &! AiAbstractState, dst: i64, src1: i64, src2: i64) with Mut, Div, Panic {
    let a = ai_state_get_reg(state, src1)
    let b = ai_state_get_reg(state, src2)
    if ai_value_is_const(b) {
        let shift = ai_value_const_val(b)
        if shift >= 0 && shift < 63 {
            var divisor: i64 = 1
            var s: i64 = 0
            while s < shift {
                divisor = divisor * 2
                s = s + 1
            }
            let div_iv = ai_interval_const(divisor)
            let iv = ai_interval_div(a.interval, div_iv)
            let v = AiAbstractValue {
                interval: iv,
                sign: ai_sign_of_interval(iv),
                congruence: ai_cong_top(),
            }
            ai_state_set_reg(state, dst, v)
            return
        }
    }
    ai_state_set_reg(state, dst, ai_value_top())
}

// ============================================================================
// TRANSFER FUNCTIONS — Comparisons
// ============================================================================

fn ai_transfer_cmp_eq(state: &! AiAbstractState, dst: i64, src1: i64, src2: i64) with Mut, Div, Panic {
    let a = ai_state_get_reg(state, src1)
    let b = ai_state_get_reg(state, src2)
    // If both are the same constant, result is 1; if intervals don't overlap, result is 0
    if ai_value_is_const(a) && ai_value_is_const(b) {
        if ai_value_const_val(a) == ai_value_const_val(b) {
            ai_state_set_reg(state, dst, ai_value_const(1))
        } else {
            ai_state_set_reg(state, dst, ai_value_const(0))
        }
        return
    }
    let meet = ai_interval_meet(a.interval, b.interval)
    if ai_interval_is_bot(meet) {
        // No overlap => definitely not equal
        ai_state_set_reg(state, dst, ai_value_const(0))
        return
    }
    // Could be either 0 or 1
    ai_state_set_reg(state, dst, ai_value_from_interval(ai_interval_range(0, 1)))
}

fn ai_transfer_cmp_lt(state: &! AiAbstractState, dst: i64, src1: i64, src2: i64) with Mut, Div, Panic {
    let a = ai_state_get_reg(state, src1)
    let b = ai_state_get_reg(state, src2)
    if ai_interval_is_bot(a.interval) || ai_interval_is_bot(b.interval) {
        ai_state_set_reg(state, dst, ai_value_bot())
        return
    }
    // a.hi < b.lo => definitely true
    if ai_interval_is_top(a.interval) == false && ai_interval_is_top(b.interval) == false {
        if a.interval.hi < b.interval.lo {
            ai_state_set_reg(state, dst, ai_value_const(1))
            return
        }
        // a.lo >= b.hi => definitely false
        if a.interval.lo >= b.interval.hi {
            ai_state_set_reg(state, dst, ai_value_const(0))
            return
        }
    }
    ai_state_set_reg(state, dst, ai_value_from_interval(ai_interval_range(0, 1)))
}

fn ai_transfer_cmp_le(state: &! AiAbstractState, dst: i64, src1: i64, src2: i64) with Mut, Div, Panic {
    let a = ai_state_get_reg(state, src1)
    let b = ai_state_get_reg(state, src2)
    if ai_interval_is_bot(a.interval) || ai_interval_is_bot(b.interval) {
        ai_state_set_reg(state, dst, ai_value_bot())
        return
    }
    if ai_interval_is_top(a.interval) == false && ai_interval_is_top(b.interval) == false {
        if a.interval.hi <= b.interval.lo {
            ai_state_set_reg(state, dst, ai_value_const(1))
            return
        }
        if a.interval.lo > b.interval.hi {
            ai_state_set_reg(state, dst, ai_value_const(0))
            return
        }
    }
    ai_state_set_reg(state, dst, ai_value_from_interval(ai_interval_range(0, 1)))
}

fn ai_transfer_cmp_gt(state: &! AiAbstractState, dst: i64, src1: i64, src2: i64) with Mut, Div, Panic {
    // a > b is equivalent to b < a
    ai_transfer_cmp_lt(state, dst, src2, src1)
}

fn ai_transfer_cmp_ge(state: &! AiAbstractState, dst: i64, src1: i64, src2: i64) with Mut, Div, Panic {
    // a >= b is equivalent to b <= a
    ai_transfer_cmp_le(state, dst, src2, src1)
}

fn ai_transfer_phi(state: &! AiAbstractState, dst: i64, src1: i64, src2: i64) with Mut, Div, Panic {
    let a = ai_state_get_reg(state, src1)
    let b = ai_state_get_reg(state, src2)
    let v = ai_value_join(a, b)
    ai_state_set_reg(state, dst, v)
}

// ============================================================================
// TRANSFER — Dispatch single instruction
// ============================================================================

fn ai_transfer_instr(state: &! AiAbstractState, instr: AiInstr) with Mut, Div, Panic {
    match instr.kind {
        AiInstrKind::AiConst => ai_transfer_const(state, instr.dst, instr.imm),
        AiInstrKind::AiCopy => ai_transfer_copy(state, instr.dst, instr.src1),
        AiInstrKind::AiAdd => ai_transfer_add(state, instr.dst, instr.src1, instr.src2),
        AiInstrKind::AiSub => ai_transfer_sub(state, instr.dst, instr.src1, instr.src2),
        AiInstrKind::AiMul => ai_transfer_mul(state, instr.dst, instr.src1, instr.src2),
        AiInstrKind::AiDiv => ai_transfer_div(state, instr.dst, instr.src1, instr.src2),
        AiInstrKind::AiMod => ai_transfer_mod(state, instr.dst, instr.src1, instr.src2),
        AiInstrKind::AiNeg => ai_transfer_neg(state, instr.dst, instr.src1),
        AiInstrKind::AiAnd => ai_transfer_and(state, instr.dst, instr.src1, instr.src2),
        AiInstrKind::AiOr => ai_transfer_or(state, instr.dst, instr.src1, instr.src2),
        AiInstrKind::AiXor => ai_transfer_xor(state, instr.dst, instr.src1, instr.src2),
        AiInstrKind::AiShl => ai_transfer_shl(state, instr.dst, instr.src1, instr.src2),
        AiInstrKind::AiShr => ai_transfer_shr(state, instr.dst, instr.src1, instr.src2),
        AiInstrKind::AiCmpEq => ai_transfer_cmp_eq(state, instr.dst, instr.src1, instr.src2),
        AiInstrKind::AiCmpLt => ai_transfer_cmp_lt(state, instr.dst, instr.src1, instr.src2),
        AiInstrKind::AiCmpLe => ai_transfer_cmp_le(state, instr.dst, instr.src1, instr.src2),
        AiInstrKind::AiCmpGt => ai_transfer_cmp_gt(state, instr.dst, instr.src1, instr.src2),
        AiInstrKind::AiCmpGe => ai_transfer_cmp_ge(state, instr.dst, instr.src1, instr.src2),
        AiInstrKind::AiPhi => ai_transfer_phi(state, instr.dst, instr.src1, instr.src2),
        AiInstrKind::AiBranch => {},
        AiInstrKind::AiReturn => {},
    }
}

// ============================================================================
// BRANCH REFINEMENT — Narrow abstract state based on branch conditions
// ============================================================================

fn ai_refine_eq(state: &! AiAbstractState, reg1: i64, reg2: i64) with Mut, Div, Panic {
    let v1 = ai_state_get_reg(state, reg1)
    let v2 = ai_state_get_reg(state, reg2)
    let refined = ai_value_meet(v1, v2)
    ai_state_set_reg(state, reg1, refined)
    ai_state_set_reg(state, reg2, refined)
}

fn ai_refine_lt(state: &! AiAbstractState, reg1: i64, reg2: i64) with Mut, Div, Panic {
    // reg1 < reg2: refine reg1.hi to min(reg1.hi, reg2.hi - 1),
    //              refine reg2.lo to max(reg2.lo, reg1.lo + 1)
    let v1 = ai_state_get_reg(state, reg1)
    let v2 = ai_state_get_reg(state, reg2)
    if ai_interval_is_bot(v1.interval) || ai_interval_is_bot(v2.interval) { return }
    if ai_interval_is_top(v1.interval) == false && ai_interval_is_top(v2.interval) == false {
        let new_hi1 = ai_min(v1.interval.hi, v2.interval.hi - 1)
        let new_lo2 = ai_max(v2.interval.lo, v1.interval.lo + 1)
        if v1.interval.lo <= new_hi1 {
            let iv1 = ai_interval_range(v1.interval.lo, new_hi1)
            let refined1 = AiAbstractValue {
                interval: iv1,
                sign: ai_sign_of_interval(iv1),
                congruence: v1.congruence,
            }
            ai_state_set_reg(state, reg1, refined1)
        }
        if new_lo2 <= v2.interval.hi {
            let iv2 = ai_interval_range(new_lo2, v2.interval.hi)
            let refined2 = AiAbstractValue {
                interval: iv2,
                sign: ai_sign_of_interval(iv2),
                congruence: v2.congruence,
            }
            ai_state_set_reg(state, reg2, refined2)
        }
    }
}

fn ai_refine_le(state: &! AiAbstractState, reg1: i64, reg2: i64) with Mut, Div, Panic {
    // reg1 <= reg2: refine reg1.hi to min(reg1.hi, reg2.hi),
    //               refine reg2.lo to max(reg2.lo, reg1.lo)
    let v1 = ai_state_get_reg(state, reg1)
    let v2 = ai_state_get_reg(state, reg2)
    if ai_interval_is_bot(v1.interval) || ai_interval_is_bot(v2.interval) { return }
    if ai_interval_is_top(v1.interval) == false && ai_interval_is_top(v2.interval) == false {
        let new_hi1 = ai_min(v1.interval.hi, v2.interval.hi)
        let new_lo2 = ai_max(v2.interval.lo, v1.interval.lo)
        if v1.interval.lo <= new_hi1 {
            let iv1 = ai_interval_range(v1.interval.lo, new_hi1)
            let refined1 = AiAbstractValue {
                interval: iv1,
                sign: ai_sign_of_interval(iv1),
                congruence: v1.congruence,
            }
            ai_state_set_reg(state, reg1, refined1)
        }
        if new_lo2 <= v2.interval.hi {
            let iv2 = ai_interval_range(new_lo2, v2.interval.hi)
            let refined2 = AiAbstractValue {
                interval: iv2,
                sign: ai_sign_of_interval(iv2),
                congruence: v2.congruence,
            }
            ai_state_set_reg(state, reg2, refined2)
        }
    }
}

fn ai_refine_branch_true(state: &! AiAbstractState, cond_reg: i64) with Mut, Div, Panic {
    // Condition is true (non-zero): refine the cond_reg to exclude zero
    let v = ai_state_get_reg(state, cond_reg)
    if ai_interval_is_bot(v.interval) { return }
    if ai_interval_is_const(v.interval) { return }
    // Narrow: if interval includes zero but isn't just zero, try to refine
    // For a boolean-like comparison result, true means [1,1]
    if ai_interval_is_top(v.interval) == false {
        if v.interval.lo == 0 && v.interval.hi == 1 {
            let iv = ai_interval_const(1)
            let refined = AiAbstractValue {
                interval: iv,
                sign: AiSignValue::SignPos,
                congruence: ai_cong_const(1),
            }
            ai_state_set_reg(state, cond_reg, refined)
            return
        }
        if v.interval.lo == 0 {
            let iv = ai_interval_range(1, v.interval.hi)
            let refined = AiAbstractValue {
                interval: iv,
                sign: ai_sign_of_interval(iv),
                congruence: v.congruence,
            }
            ai_state_set_reg(state, cond_reg, refined)
        }
    }
}

fn ai_refine_branch_false(state: &! AiAbstractState, cond_reg: i64) with Mut, Div, Panic {
    // Condition is false (zero): refine the cond_reg to [0,0]
    let v = ai_state_get_reg(state, cond_reg)
    if ai_interval_is_bot(v.interval) { return }
    if ai_interval_contains(v.interval, 0) {
        let iv = ai_interval_const(0)
        let refined = AiAbstractValue {
            interval: iv,
            sign: AiSignValue::SignZero,
            congruence: ai_cong_const(0),
        }
        ai_state_set_reg(state, cond_reg, refined)
    }
}

// ============================================================================
// EDGE REFINEMENT — Apply branch condition to successor state
// ============================================================================

fn ai_apply_edge_refinement(state: &! AiAbstractState, edge: AiEdge) with Mut, Div, Panic {
    match edge.branch_kind {
        AiBranchKind::BrUnconditional => {},
        AiBranchKind::BrIfTrue => ai_refine_branch_true(state, edge.cond_reg),
        AiBranchKind::BrIfFalse => ai_refine_branch_false(state, edge.cond_reg),
        AiBranchKind::BrIfEq => ai_refine_eq(state, edge.cond_reg, edge.cond_reg),
        AiBranchKind::BrIfLt => ai_refine_lt(state, edge.cond_reg, edge.cond_reg),
        AiBranchKind::BrIfLe => ai_refine_le(state, edge.cond_reg, edge.cond_reg),
    }
}

// ============================================================================
// BLOCK PROCESSING — Transfer function over a whole block
// ============================================================================

fn ai_process_block(ctx: &! AiContext, block_id: i64) with Mut, Div, Panic {
    if block_id < 0 || block_id >= ctx.block_count { return }

    // Copy the input state to a working copy
    var work_state = ai_state_copy(&ctx.blocks[block_id as usize].state_in)

    // Apply all instructions in this block
    let start = ctx.blocks[block_id as usize].instr_start
    let count = ctx.blocks[block_id as usize].instr_count
    var i: i64 = 0
    while i < count {
        let idx = start + i
        if idx >= 0 && idx < ctx.instr_count {
            ai_transfer_instr(&! work_state, ctx.instrs[idx as usize])
        }
        i = i + 1
    }

    // Store the output state
    ctx.blocks[block_id as usize].state_out = work_state
}

// ============================================================================
// SUCCESSOR PROPAGATION — Push output states to successor blocks
// ============================================================================

fn ai_propagate_to_successors(ctx: &! AiContext, block_id: i64) with Mut, Div, Panic {
    var e: i64 = 0
    while e < ctx.edge_count {
        if ctx.edges[e as usize].from_block == block_id {
            let to = ctx.edges[e as usize].to_block
            if to >= 0 && to < ctx.block_count {
                // Compute the state to propagate: output state + edge refinement
                var prop_state = ai_state_copy(&ctx.blocks[block_id as usize].state_out)
                ai_apply_edge_refinement(&! prop_state, ctx.edges[e as usize])

                // Join with existing input state of successor
                let old_in = ai_state_copy(&ctx.blocks[to as usize].state_in)
                let needs_widen = ctx.blocks[to as usize].widen_count >= ctx.widen_threshold

                var new_in = ai_state_join(&old_in, &prop_state)
                if needs_widen {
                    new_in = ai_state_widen(&old_in, &new_in)
                }

                // Check if the state changed
                if ai_state_eq(&old_in, &new_in) == false {
                    ctx.blocks[to as usize].state_in = new_in
                    ctx.blocks[to as usize].widen_count = ctx.blocks[to as usize].widen_count + 1
                    ai_worklist_push(ctx, to)
                }
            }
        }
        e = e + 1
    }
}

// ============================================================================
// FIXED-POINT ANALYSIS — Main analysis driver
// ============================================================================

fn ai_analyze_function(ctx: &! AiContext) with Mut, Div, Panic {
    // Initialize: seed block 0 into the worklist
    if ctx.block_count == 0 { return }

    ai_worklist_clear(ctx)
    ctx.iteration_count = 0
    ctx.converged = false

    // Initialize block 0 input state to top (function entry — all params unknown)
    ctx.blocks[0].state_in = ai_state_top()
    ai_worklist_push(ctx, 0)

    // Fixed-point loop
    while ai_worklist_empty(ctx) == false && ctx.iteration_count < ctx.max_iterations {
        let bid = ai_worklist_pop(ctx)
        if bid >= 0 && bid < ctx.block_count {
            ai_process_block(ctx, bid)
            ai_propagate_to_successors(ctx, bid)
        }
        ctx.iteration_count = ctx.iteration_count + 1
    }

    ctx.converged = ai_worklist_empty(ctx)
}

// ============================================================================
// QUERY FUNCTIONS — Extract information from analysis results
// ============================================================================

fn ai_query_reg_interval(ctx: &AiContext, block_id: i64, reg: i64) -> AiInterval with Div, Panic {
    if block_id < 0 || block_id >= ctx.block_count { return ai_interval_bot() }
    let v = ai_state_get_reg(&ctx.blocks[block_id as usize].state_out, reg)
    v.interval
}

fn ai_query_reg_sign(ctx: &AiContext, block_id: i64, reg: i64) -> AiSignValue with Div, Panic {
    if block_id < 0 || block_id >= ctx.block_count { return AiSignValue::SignBot }
    let v = ai_state_get_reg(&ctx.blocks[block_id as usize].state_out, reg)
    v.sign
}

fn ai_query_reg_congruence(ctx: &AiContext, block_id: i64, reg: i64) -> AiCongruence with Div, Panic {
    if block_id < 0 || block_id >= ctx.block_count { return ai_cong_bot() }
    let v = ai_state_get_reg(&ctx.blocks[block_id as usize].state_out, reg)
    v.congruence
}

fn ai_query_reg_value(ctx: &AiContext, block_id: i64, reg: i64) -> AiAbstractValue with Div, Panic {
    if block_id < 0 || block_id >= ctx.block_count { return ai_value_bot() }
    ai_state_get_reg(&ctx.blocks[block_id as usize].state_out, reg)
}

fn ai_is_constant(ctx: &AiContext, block_id: i64, reg: i64) -> bool with Div, Panic {
    let iv = ai_query_reg_interval(ctx, block_id, reg)
    ai_interval_is_const(iv)
}

fn ai_is_non_negative(ctx: &AiContext, block_id: i64, reg: i64) -> bool with Div, Panic {
    let iv = ai_query_reg_interval(ctx, block_id, reg)
    if ai_interval_is_bot(iv) { return false }
    if ai_interval_is_top(iv) { return false }
    iv.lo >= 0
}

fn ai_is_non_zero(ctx: &AiContext, block_id: i64, reg: i64) -> bool with Div, Panic {
    let iv = ai_query_reg_interval(ctx, block_id, reg)
    if ai_interval_is_bot(iv) { return false }
    if ai_interval_is_top(iv) { return false }
    iv.lo > 0 || iv.hi < 0
}

fn ai_is_in_range(ctx: &AiContext, block_id: i64, reg: i64, lo: i64, hi: i64) -> bool with Div, Panic {
    let iv = ai_query_reg_interval(ctx, block_id, reg)
    if ai_interval_is_bot(iv) { return false }
    if ai_interval_is_top(iv) { return false }
    iv.lo >= lo && iv.hi <= hi
}

fn ai_get_constant_value(ctx: &AiContext, block_id: i64, reg: i64) -> i64 with Div, Panic {
    let iv = ai_query_reg_interval(ctx, block_id, reg)
    if ai_interval_is_const(iv) { return iv.lo }
    0
}

fn ai_blocks_converged(ctx: &AiContext) -> bool {
    ctx.converged
}

fn ai_iteration_count(ctx: &AiContext) -> i64 {
    ctx.iteration_count
}

