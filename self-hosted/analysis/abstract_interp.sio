fn test_ai_refine_branch_true_inner() -> bool with Mut, Div, Panic {
    var state = ai_state_new()
    state.reg_count = 1
    state.regs[0] = ai_value_from_interval(ai_interval_range(0, 1))
    ai_refine_branch_true(&! state, 0)
    let v = ai_state_get_reg(&state, 0)
    // Should be refined to [1,1]
    if ai_value_is_const(v) == false { return false }
    if ai_value_const_val(v) != 1 { return false }
    true
}
fn test_ai_refine_branch_true() -> bool with Mut, Div, Panic {
    test_ai_refine_branch_true_inner()
}

fn test_ai_refine_branch_false_inner() -> bool with Mut, Div, Panic {
    var state = ai_state_new()
    state.reg_count = 1
    state.regs[0] = ai_value_from_interval(ai_interval_range(0, 1))
    ai_refine_branch_false(&! state, 0)
    let v = ai_state_get_reg(&state, 0)
    // Should be refined to [0,0]
    if ai_value_is_const(v) == false { return false }
    if ai_value_const_val(v) != 0 { return false }
    true
}
fn test_ai_refine_branch_false() -> bool with Mut, Div, Panic {
    test_ai_refine_branch_false_inner()
}

fn test_ai_refine_eq_inner() -> bool with Mut, Div, Panic {
    var state = ai_state_new()
    state.reg_count = 2
    state.regs[0] = ai_value_from_interval(ai_interval_range(1, 10))
    state.regs[1] = ai_value_from_interval(ai_interval_range(5, 15))
    ai_refine_eq(&! state, 0, 1)
    let v0 = ai_state_get_reg(&state, 0)
    let v1 = ai_state_get_reg(&state, 1)
    // After eq refinement: both should be [5, 10] (the meet)
    if v0.interval.lo != 5 { return false }
    if v0.interval.hi != 10 { return false }
    if v1.interval.lo != 5 { return false }
    if v1.interval.hi != 10 { return false }
    true
}
fn test_ai_refine_eq() -> bool with Mut, Div, Panic {
    test_ai_refine_eq_inner()
}

fn test_ai_refine_lt_inner() -> bool with Mut, Div, Panic {
    var state = ai_state_new()
    state.reg_count = 2
    state.regs[0] = ai_value_from_interval(ai_interval_range(0, 10))
    state.regs[1] = ai_value_from_interval(ai_interval_range(0, 10))
    ai_refine_lt(&! state, 0, 1)
    let v0 = ai_state_get_reg(&state, 0)
    let v1 = ai_state_get_reg(&state, 1)
    // After reg0 < reg1: reg0.hi <= reg1.hi - 1 = 9, reg1.lo >= reg0.lo + 1 = 1
    if v0.interval.hi != 9 { return false }
    if v1.interval.lo != 1 { return false }
    true
}
fn test_ai_refine_lt() -> bool with Mut, Div, Panic {
    test_ai_refine_lt_inner()
}

fn test_ai_refine_le_inner() -> bool with Mut, Div, Panic {
    var state = ai_state_new()
    state.reg_count = 2
    state.regs[0] = ai_value_from_interval(ai_interval_range(0, 20))
    state.regs[1] = ai_value_from_interval(ai_interval_range(5, 15))
    ai_refine_le(&! state, 0, 1)
    let v0 = ai_state_get_reg(&state, 0)
    let v1 = ai_state_get_reg(&state, 1)
    // reg0 <= reg1: reg0.hi <= 15, reg1.lo >= 0
    if v0.interval.hi != 15 { return false }
    if v0.interval.lo != 0 { return false }
    true
}
fn test_ai_refine_le() -> bool with Mut, Div, Panic {
    test_ai_refine_le_inner()
}

