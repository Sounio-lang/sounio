fn test_ai_cong_join_same_inner() -> bool with Mut, Div, Panic {
    let a = ai_cong_new(4, 1)
    let b = ai_cong_new(4, 1)
    let j = ai_cong_join(a, b)
    if j.modulus != 4 { return false }
    if j.remainder != 1 { return false }
    true
}
fn test_ai_cong_join_same() -> bool with Mut, Div, Panic {
    test_ai_cong_join_same_inner()
}

fn test_ai_cong_join_different_inner() -> bool with Mut, Div, Panic {
    // join(4k+1, 4k+3) = gcd(4, 4, |1-3|)k + 1 mod gcd = gcd(4,2)k + 1 = 2k+1
    let a = ai_cong_new(4, 1)
    let b = ai_cong_new(4, 3)
    let j = ai_cong_join(a, b)
    if j.modulus != 2 { return false }
    if j.remainder != 1 { return false }
    true
}
fn test_ai_cong_join_different() -> bool with Mut, Div, Panic {
    test_ai_cong_join_different_inner()
}

fn test_ai_cong_meet_compatible_inner() -> bool with Mut, Div, Panic {
    // meet(2k+1, 3k+1) should have modulus lcm(2,3)=6, remainder 1
    let a = ai_cong_new(2, 1)
    let b = ai_cong_new(3, 1)
    let m = ai_cong_meet(a, b)
    if ai_cong_is_bot(m) { return false }
    if m.modulus != 6 { return false }
    if m.remainder != 1 { return false }
    true
}
fn test_ai_cong_meet_compatible() -> bool with Mut, Div, Panic {
    test_ai_cong_meet_compatible_inner()
}

fn test_ai_cong_meet_incompatible_inner() -> bool with Mut, Div, Panic {
    // meet(2k+0, 2k+1) => bot (even and odd never intersect)
    let a = ai_cong_new(2, 0)
    let b = ai_cong_new(2, 1)
    let m = ai_cong_meet(a, b)
    ai_cong_is_bot(m)
}
fn test_ai_cong_meet_incompatible() -> bool with Mut, Div, Panic {
    test_ai_cong_meet_incompatible_inner()
}

