}

// ============================================================================
// CATEGORY 6: Fixed-point analysis tests (10 tests)
// ============================================================================

fn test_ai_single_block_inner(ctx: &! AiContext) -> bool with Mut, Div, Panic {
    // Single block: r0 = 10, r1 = 32, r2 = r0 + r1
    let b0 = ai_add_block(ctx)
    ai_add_instr(ctx, AiInstrKind::AiConst, 0, 0, 0, 10, b0)
    ai_add_instr(ctx, AiInstrKind::AiConst, 1, 0, 0, 32, b0)
    ai_add_instr(ctx, AiInstrKind::AiAdd, 2, 0, 1, 0, b0)
    ai_analyze_function(ctx)
    if ai_blocks_converged(ctx) == false { return false }
    let iv = ai_query_reg_interval(ctx, 0, 2)
    if ai_interval_is_const(iv) == false { return false }
    if iv.lo != 42 { return false }
    true
}
fn test_ai_single_block() -> bool with Mut, Div, Panic {
    var ctx = ai_context_new()
    test_ai_single_block_inner(&! ctx)
}

fn test_ai_two_blocks_inner(ctx: &! AiContext) -> bool with Mut, Div, Panic {
    // Block 0: r0 = 5
    // Block 1: r1 = r0 + 3
    // Edge: 0 -> 1 unconditional
    let b0 = ai_add_block(ctx)
    let b1 = ai_add_block(ctx)
    ai_add_instr(ctx, AiInstrKind::AiConst, 0, 0, 0, 5, b0)
    ai_add_instr(ctx, AiInstrKind::AiConst, 1, 0, 0, 3, b1)
    ai_add_instr(ctx, AiInstrKind::AiAdd, 2, 0, 1, 0, b1)
    ai_add_edge(ctx, b0, b1, AiBranchKind::BrUnconditional, 0)
    ai_analyze_function(ctx)
    if ai_blocks_converged(ctx) == false { return false }
    let iv = ai_query_reg_interval(ctx, b1, 2)
    if ai_interval_is_const(iv) == false { return false }
    if iv.lo != 8 { return false }
    true
}
fn test_ai_two_blocks() -> bool with Mut, Div, Panic {
    var ctx = ai_context_new()
    test_ai_two_blocks_inner(&! ctx)
}

fn test_ai_simple_loop_inner(ctx: &! AiContext) -> bool with Mut, Div, Panic {
    // Block 0: r0 = 0 (loop counter init)
    // Block 1: r0 = phi(r0_block0, r0_block1); r0 = r0 + 1; branch if r0 < 10
    // Block 2: exit
    // Edges: 0->1, 1->1 (back edge), 1->2
    let b0 = ai_add_block(ctx)
    let b1 = ai_add_block(ctx)
    let b2 = ai_add_block(ctx)
    ai_add_instr(ctx, AiInstrKind::AiConst, 0, 0, 0, 0, b0)
    ai_add_instr(ctx, AiInstrKind::AiAdd, 0, 0, 0, 1, b1)  // r0 = r0 + 1 (self-loop increment approximation)
    ai_add_instr(ctx, AiInstrKind::AiConst, 3, 0, 0, 1, b1) // const 1 for the add
    ai_add_edge(ctx, b0, b1, AiBranchKind::BrUnconditional, 0)
    ai_add_edge(ctx, b1, b1, AiBranchKind::BrIfTrue, 0)  // back edge
    ai_add_edge(ctx, b1, b2, AiBranchKind::BrIfFalse, 0) // exit edge
    ai_analyze_function(ctx)
    // Should converge (widening guarantees termination)
    ai_blocks_converged(ctx)
}
fn test_ai_simple_loop() -> bool with Mut, Div, Panic {
    var ctx = ai_context_new()
    test_ai_simple_loop_inner(&! ctx)
}

fn test_ai_convergence_inner(ctx: &! AiContext) -> bool with Mut, Div, Panic {
    // Single block, no edges => should converge in 1 iteration
    let b0 = ai_add_block(ctx)
    ai_add_instr(ctx, AiInstrKind::AiConst, 0, 0, 0, 7, b0)
    ai_analyze_function(ctx)
    if ai_blocks_converged(ctx) == false { return false }
    if ai_iteration_count(ctx) > 2 { return false }
    true
}
fn test_ai_convergence() -> bool with Mut, Div, Panic {
    var ctx = ai_context_new()
    test_ai_convergence_inner(&! ctx)
}

fn test_ai_widening_inner(ctx: &! AiContext) -> bool with Mut, Div, Panic {
    // Loop with incrementing variable; widening should push to +inf
    let b0 = ai_add_block(ctx)
    let b1 = ai_add_block(ctx)
    ai_add_instr(ctx, AiInstrKind::AiConst, 0, 0, 0, 0, b0)
    ai_add_instr(ctx, AiInstrKind::AiConst, 1, 0, 0, 1, b1)
    ai_add_instr(ctx, AiInstrKind::AiAdd, 0, 0, 1, 0, b1)
    ai_add_edge(ctx, b0, b1, AiBranchKind::BrUnconditional, 0)
    ai_add_edge(ctx, b1, b1, AiBranchKind::BrUnconditional, 0)
    ctx.max_iterations = 50
    ai_analyze_function(ctx)
    // After widening, r0 in block 1 should have hi = AI_INF_POS
    let iv = ai_query_reg_interval(ctx, b1, 0)
    if ai_interval_is_top(iv) == false {
        // Should at least have been widened upward
        if iv.hi < AI_INF_POS { return false }
    }
    true
}
fn test_ai_widening() -> bool with Mut, Div, Panic {
    var ctx = ai_context_new()
    test_ai_widening_inner(&! ctx)
}

fn test_ai_diamond_cfg_inner(ctx: &! AiContext) -> bool with Mut, Div, Panic {
    // Diamond: b0 -> b1, b0 -> b2, b1 -> b3, b2 -> b3
    // b0: r0 = 10
    // b1: r1 = 5
    // b2: r1 = 20
    // b3: merge — r1 should be [5, 20]
    let b0 = ai_add_block(ctx)
    let b1 = ai_add_block(ctx)
    let b2 = ai_add_block(ctx)
    let b3 = ai_add_block(ctx)
    ai_add_instr(ctx, AiInstrKind::AiConst, 0, 0, 0, 10, b0)
    ai_add_instr(ctx, AiInstrKind::AiConst, 1, 0, 0, 5, b1)
    ai_add_instr(ctx, AiInstrKind::AiConst, 1, 0, 0, 20, b2)
    ai_add_edge(ctx, b0, b1, AiBranchKind::BrIfTrue, 0)
    ai_add_edge(ctx, b0, b2, AiBranchKind::BrIfFalse, 0)
    ai_add_edge(ctx, b1, b3, AiBranchKind::BrUnconditional, 0)
    ai_add_edge(ctx, b2, b3, AiBranchKind::BrUnconditional, 0)
    ai_analyze_function(ctx)
    if ai_blocks_converged(ctx) == false { return false }
    let iv = ai_query_reg_interval(ctx, b3, 1)
    if ai_interval_is_bot(iv) { return false }
    if ai_interval_contains(iv, 5) == false { return false }
    if ai_interval_contains(iv, 20) == false { return false }
    true
}
fn test_ai_diamond_cfg() -> bool with Mut, Div, Panic {
    var ctx = ai_context_new()
    test_ai_diamond_cfg_inner(&! ctx)
}

fn test_ai_chain_three_blocks_inner(ctx: &! AiContext) -> bool with Mut, Div, Panic {
    // b0: r0 = 2
    // b1: r1 = r0 * r0 (should be 4)
    // b2: r2 = r1 + r0 (should be 6)
    let b0 = ai_add_block(ctx)
    let b1 = ai_add_block(ctx)
    let b2 = ai_add_block(ctx)
    ai_add_instr(ctx, AiInstrKind::AiConst, 0, 0, 0, 2, b0)
    ai_add_instr(ctx, AiInstrKind::AiMul, 1, 0, 0, 0, b1)
    ai_add_instr(ctx, AiInstrKind::AiAdd, 2, 1, 0, 0, b2)
    ai_add_edge(ctx, b0, b1, AiBranchKind::BrUnconditional, 0)
    ai_add_edge(ctx, b1, b2, AiBranchKind::BrUnconditional, 0)
    ai_analyze_function(ctx)
    if ai_blocks_converged(ctx) == false { return false }
    let iv1 = ai_query_reg_interval(ctx, b1, 1)
    if ai_interval_is_const(iv1) == false { return false }
    if iv1.lo != 4 { return false }
    let iv2 = ai_query_reg_interval(ctx, b2, 2)
    if ai_interval_is_const(iv2) == false { return false }
    if iv2.lo != 6 { return false }
    true
}
fn test_ai_chain_three_blocks() -> bool with Mut, Div, Panic {
    var ctx = ai_context_new()
    test_ai_chain_three_blocks_inner(&! ctx)
}

fn test_ai_worklist_basic_inner(ctx: &! AiContext) -> bool with Mut, Div, Panic {
    ai_worklist_clear(ctx)
    if ai_worklist_empty(ctx) == false { return false }
    ai_worklist_push(ctx, 3)
    ai_worklist_push(ctx, 7)
    if ai_worklist_empty(ctx) { return false }
    let first = ai_worklist_pop(ctx)
    if first != 3 { return false }
    let second = ai_worklist_pop(ctx)
    if second != 7 { return false }
    if ai_worklist_empty(ctx) == false { return false }
    true
}
fn test_ai_worklist_basic() -> bool with Mut, Div, Panic {
    var ctx = ai_context_new()
    test_ai_worklist_basic_inner(&! ctx)
}

fn test_ai_worklist_dedup_inner(ctx: &! AiContext) -> bool with Mut, Div, Panic {
    ai_worklist_clear(ctx)
    ai_worklist_push(ctx, 5)
    let dup = ai_worklist_push(ctx, 5)
    // Should return false because 5 is already in the worklist
    if dup { return false }
    let first = ai_worklist_pop(ctx)
    if first != 5 { return false }
    ai_worklist_empty(ctx)
}
fn test_ai_worklist_dedup() -> bool with Mut, Div, Panic {
    var ctx = ai_context_new()
    test_ai_worklist_dedup_inner(&! ctx)
}

fn test_ai_max_iterations_inner(ctx: &! AiContext) -> bool with Mut, Div, Panic {
    // Create a self-loop that never converges (without widening effect)
    let b0 = ai_add_block(ctx)
    ai_add_instr(ctx, AiInstrKind::AiConst, 0, 0, 0, 1, b0)
    ai_add_edge(ctx, b0, b0, AiBranchKind::BrUnconditional, 0)
    ctx.max_iterations = 10
    ai_analyze_function(ctx)
    // Should stop at max_iterations
    if ctx.iteration_count > 11 { return false }
    true
}
fn test_ai_max_iterations() -> bool with Mut, Div, Panic {
    var ctx = ai_context_new()
    test_ai_max_iterations_inner(&! ctx)
}

// ============================================================================
// CATEGORY 7: State operations tests (8 tests)
// ============================================================================

fn test_ai_state_new_inner() -> bool with Mut, Div, Panic {
    let s = ai_state_new()
    if s.reg_count != 0 { return false }
    true
}
fn test_ai_state_new() -> bool with Mut, Div, Panic {
    test_ai_state_new_inner()
}

fn test_ai_state_set_get_inner() -> bool with Mut, Div, Panic {
    var s = ai_state_new()
    let v = ai_value_const(42)
    ai_state_set_reg(&! s, 3, v)
    let r = ai_state_get_reg(&s, 3)
    if ai_value_is_const(r) == false { return false }
    if ai_value_const_val(r) != 42 { return false }
    true
}
fn test_ai_state_set_get() -> bool with Mut, Div, Panic {
    test_ai_state_set_get_inner()
}

fn test_ai_state_reg_count_inner() -> bool with Mut, Div, Panic {
    var s = ai_state_new()
    ai_state_set_reg(&! s, 5, ai_value_const(10))
    if s.reg_count != 6 { return false }
    ai_state_set_reg(&! s, 2, ai_value_const(20))
    // reg_count should still be 6 (max seen + 1)
    if s.reg_count != 6 { return false }
    ai_state_set_reg(&! s, 10, ai_value_const(30))
    if s.reg_count != 11 { return false }
    true
}
fn test_ai_state_reg_count() -> bool with Mut, Div, Panic {
    test_ai_state_reg_count_inner()
}

fn test_ai_state_out_of_bounds_inner() -> bool with Mut, Div, Panic {
    let s = ai_state_new()
    let v = ai_state_get_reg(&s, 0 - 1)
    if ai_value_is_bot(v) == false { return false }
    let v2 = ai_state_get_reg(&s, 300)
    if ai_value_is_bot(v2) == false { return false }
    true
}
fn test_ai_state_out_of_bounds() -> bool with Mut, Div, Panic {
    test_ai_state_out_of_bounds_inner()
}

fn test_ai_state_join_inner() -> bool with Mut, Div, Panic {
    var s1 = ai_state_new()
    var s2 = ai_state_new()
    ai_state_set_reg(&! s1, 0, ai_value_const(5))
    ai_state_set_reg(&! s2, 0, ai_value_const(10))
    let j = ai_state_join(&s1, &s2)
    let v = ai_state_get_reg(&j, 0)
    // Join of [5,5] and [10,10] = [5,10]
    if v.interval.lo != 5 { return false }
    if v.interval.hi != 10 { return false }
    true
}
fn test_ai_state_join() -> bool with Mut, Div, Panic {
    test_ai_state_join_inner()
}

fn test_ai_state_eq_inner() -> bool with Mut, Div, Panic {
    var s1 = ai_state_new()
    var s2 = ai_state_new()
    ai_state_set_reg(&! s1, 0, ai_value_const(42))
    ai_state_set_reg(&! s2, 0, ai_value_const(42))
    if ai_state_eq(&s1, &s2) == false { return false }
    ai_state_set_reg(&! s2, 0, ai_value_const(99))
    if ai_state_eq(&s1, &s2) { return false }
    true
}
fn test_ai_state_eq() -> bool with Mut, Div, Panic {
    test_ai_state_eq_inner()
}

fn test_ai_state_copy_sub(orig: &! AiAbstractState) -> bool with Mut, Div, Panic {
    ai_state_set_reg(orig, 0, ai_value_const(7))
    ai_state_set_reg(orig, 1, ai_value_const(13))
    let copy = ai_state_copy(orig)
    if ai_state_eq(orig, &copy) == false { return false }
    // Modify original; copy should be independent
    ai_state_set_reg(orig, 0, ai_value_const(99))
    let v = ai_state_get_reg(&copy, 0)
    if ai_value_const_val(v) != 7 { return false }
    true
}
fn test_ai_state_copy_inner() -> bool with Mut, Div, Panic {
    var orig = ai_state_new()
    test_ai_state_copy_sub(&! orig)
}
fn test_ai_state_copy() -> bool with Mut, Div, Panic {
    test_ai_state_copy_inner()
}

fn test_ai_state_widen_inner() -> bool with Mut, Div, Panic {
    var s1 = ai_state_new()
    var s2 = ai_state_new()
    ai_state_set_reg(&! s1, 0, ai_value_from_interval(ai_interval_range(0, 10)))
    ai_state_set_reg(&! s2, 0, ai_value_from_interval(ai_interval_range(0, 20)))
    let w = ai_state_widen(&s1, &s2)
    let v = ai_state_get_reg(&w, 0)
    // Widened: lo stays 0, hi goes to +inf
    if v.interval.lo != 0 { return false }
    if v.interval.hi != AI_INF_POS { return false }
    true
}
fn test_ai_state_widen() -> bool with Mut, Div, Panic {
    test_ai_state_widen_inner()
}

// ============================================================================
// CATEGORY 8: Integration tests (9 tests)
// ============================================================================

fn test_ai_full_constant_prop_inner(ctx: &! AiContext) -> bool with Mut, Div, Panic {
    // Full pipeline: r0=2, r1=3, r2=r0*r1, r3=r2+r0 => r3 should be 8
    let b0 = ai_add_block(ctx)
    ai_add_instr(ctx, AiInstrKind::AiConst, 0, 0, 0, 2, b0)
    ai_add_instr(ctx, AiInstrKind::AiConst, 1, 0, 0, 3, b0)
    ai_add_instr(ctx, AiInstrKind::AiMul, 2, 0, 1, 0, b0)
    ai_add_instr(ctx, AiInstrKind::AiAdd, 3, 2, 0, 0, b0)
    ai_analyze_function(ctx)
    if ai_is_constant(ctx, b0, 3) == false { return false }
    if ai_get_constant_value(ctx, b0, 3) != 8 { return false }
    true
}
fn test_ai_full_constant_prop() -> bool with Mut, Div, Panic {
    var ctx = ai_context_new()
    test_ai_full_constant_prop_inner(&! ctx)
}

fn test_ai_full_sign_analysis_inner(ctx: &! AiContext) -> bool with Mut, Div, Panic {
    // r0 = 5 (positive), r1 = -3, r2 = r0 + r1 = 2 (positive)
    let b0 = ai_add_block(ctx)
    ai_add_instr(ctx, AiInstrKind::AiConst, 0, 0, 0, 5, b0)
    ai_add_instr(ctx, AiInstrKind::AiConst, 1, 0, 0, 0 - 3, b0)
    ai_add_instr(ctx, AiInstrKind::AiAdd, 2, 0, 1, 0, b0)
    ai_analyze_function(ctx)
    let s = ai_query_reg_sign(ctx, b0, 2)
    ai_sign_eq(s, AiSignValue::SignPos)
}
fn test_ai_full_sign_analysis() -> bool with Mut, Div, Panic {
    var ctx = ai_context_new()
    test_ai_full_sign_analysis_inner(&! ctx)
}

fn test_ai_full_non_negative_inner(ctx: &! AiContext) -> bool with Mut, Div, Panic {
    // r0 = 10, r1 = 3, r2 = r0 - r1 = 7 => non-negative
    let b0 = ai_add_block(ctx)
    ai_add_instr(ctx, AiInstrKind::AiConst, 0, 0, 0, 10, b0)
    ai_add_instr(ctx, AiInstrKind::AiConst, 1, 0, 0, 3, b0)
    ai_add_instr(ctx, AiInstrKind::AiSub, 2, 0, 1, 0, b0)
    ai_analyze_function(ctx)
    ai_is_non_negative(ctx, b0, 2)
}
fn test_ai_full_non_negative() -> bool with Mut, Div, Panic {
    var ctx = ai_context_new()
    test_ai_full_non_negative_inner(&! ctx)
}

fn test_ai_full_non_zero_inner(ctx: &! AiContext) -> bool with Mut, Div, Panic {
    // r0 = 7 => non-zero
    let b0 = ai_add_block(ctx)
    ai_add_instr(ctx, AiInstrKind::AiConst, 0, 0, 0, 7, b0)
    ai_analyze_function(ctx)
    ai_is_non_zero(ctx, b0, 0)
}
fn test_ai_full_non_zero() -> bool with Mut, Div, Panic {
    var ctx = ai_context_new()
    test_ai_full_non_zero_inner(&! ctx)
}

fn test_ai_full_range_check_inner(ctx: &! AiContext) -> bool with Mut, Div, Panic {
    // r0 = 42 => should be in range [0, 100]
    let b0 = ai_add_block(ctx)
    ai_add_instr(ctx, AiInstrKind::AiConst, 0, 0, 0, 42, b0)
    ai_analyze_function(ctx)
    ai_is_in_range(ctx, b0, 0, 0, 100)
}
fn test_ai_full_range_check() -> bool with Mut, Div, Panic {
    var ctx = ai_context_new()
    test_ai_full_range_check_inner(&! ctx)
}

fn test_ai_full_diamond_merge_inner(ctx: &! AiContext) -> bool with Mut, Div, Panic {
    // Diamond: b0 branches to b1 (r1=0) and b2 (r1=100); b3 merges.
    // After analysis, r1 in b3 should contain both 0 and 100.
    let b0 = ai_add_block(ctx)
    let b1 = ai_add_block(ctx)
    let b2 = ai_add_block(ctx)
    let b3 = ai_add_block(ctx)
    ai_add_instr(ctx, AiInstrKind::AiConst, 0, 0, 0, 1, b0)
    ai_add_instr(ctx, AiInstrKind::AiConst, 1, 0, 0, 0, b1)
    ai_add_instr(ctx, AiInstrKind::AiConst, 1, 0, 0, 100, b2)
    ai_add_edge(ctx, b0, b1, AiBranchKind::BrIfTrue, 0)
    ai_add_edge(ctx, b0, b2, AiBranchKind::BrIfFalse, 0)
    ai_add_edge(ctx, b1, b3, AiBranchKind::BrUnconditional, 0)
    ai_add_edge(ctx, b2, b3, AiBranchKind::BrUnconditional, 0)
    ai_analyze_function(ctx)
    if ai_blocks_converged(ctx) == false { return false }
    let iv = ai_query_reg_interval(ctx, b3, 1)
    if ai_interval_contains(iv, 0) == false { return false }
    if ai_interval_contains(iv, 100) == false { return false }
    true
}
fn test_ai_full_diamond_merge() -> bool with Mut, Div, Panic {
    var ctx = ai_context_new()
    test_ai_full_diamond_merge_inner(&! ctx)
}

fn test_ai_full_comparison_refine_inner(ctx: &! AiContext) -> bool with Mut, Div, Panic {
    // r0 = 5, r1 = 10, r2 = cmp_lt(r0, r1) => should be 1
    let b0 = ai_add_block(ctx)
    ai_add_instr(ctx, AiInstrKind::AiConst, 0, 0, 0, 5, b0)
    ai_add_instr(ctx, AiInstrKind::AiConst, 1, 0, 0, 10, b0)
    ai_add_instr(ctx, AiInstrKind::AiCmpLt, 2, 0, 1, 0, b0)
    ai_analyze_function(ctx)
    if ai_is_constant(ctx, b0, 2) == false { return false }
    if ai_get_constant_value(ctx, b0, 2) != 1 { return false }
    true
}
fn test_ai_full_comparison_refine() -> bool with Mut, Div, Panic {
    var ctx = ai_context_new()
    test_ai_full_comparison_refine_inner(&! ctx)
}

fn test_ai_full_neg_chain_inner(ctx: &! AiContext) -> bool with Mut, Div, Panic {
    // r0 = 42, r1 = neg(r0) = -42, r2 = neg(r1) = 42
    let b0 = ai_add_block(ctx)
    ai_add_instr(ctx, AiInstrKind::AiConst, 0, 0, 0, 42, b0)
    ai_add_instr(ctx, AiInstrKind::AiNeg, 1, 0, 0, 0, b0)
    ai_add_instr(ctx, AiInstrKind::AiNeg, 2, 1, 0, 0, b0)
    ai_analyze_function(ctx)
    if ai_is_constant(ctx, b0, 2) == false { return false }
    if ai_get_constant_value(ctx, b0, 2) != 42 { return false }
    // r1 should be -42
    if ai_get_constant_value(ctx, b0, 1) != 0 - 42 { return false }
    true
}
fn test_ai_full_neg_chain() -> bool with Mut, Div, Panic {
    var ctx = ai_context_new()
    test_ai_full_neg_chain_inner(&! ctx)
}

fn test_ai_full_multi_block_chain_inner(ctx: &! AiContext) -> bool with Mut, Div, Panic {
    // b0: r0 = 1
    // b1: r0 = r0 + r0 => 2
    // b2: r0 = r0 + r0 => 4
    // b3: r0 = r0 + r0 => 8
    let b0 = ai_add_block(ctx)
    let b1 = ai_add_block(ctx)
    let b2 = ai_add_block(ctx)
    let b3 = ai_add_block(ctx)
    ai_add_instr(ctx, AiInstrKind::AiConst, 0, 0, 0, 1, b0)
    ai_add_instr(ctx, AiInstrKind::AiAdd, 0, 0, 0, 0, b1)
    ai_add_instr(ctx, AiInstrKind::AiAdd, 0, 0, 0, 0, b2)
    ai_add_instr(ctx, AiInstrKind::AiAdd, 0, 0, 0, 0, b3)
    ai_add_edge(ctx, b0, b1, AiBranchKind::BrUnconditional, 0)
    ai_add_edge(ctx, b1, b2, AiBranchKind::BrUnconditional, 0)
    ai_add_edge(ctx, b2, b3, AiBranchKind::BrUnconditional, 0)
    ai_analyze_function(ctx)
    if ai_blocks_converged(ctx) == false { return false }
    let iv = ai_query_reg_interval(ctx, b3, 0)
    if ai_interval_is_const(iv) == false { return false }
    if iv.lo != 8 { return false }
    true
}
fn test_ai_full_multi_block_chain() -> bool with Mut, Div, Panic {
    var ctx = ai_context_new()
    test_ai_full_multi_block_chain_inner(&! ctx)
}

