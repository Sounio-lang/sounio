// ============================================================================
// CATEGORY 1: Interval lattice tests (12 tests)
// ============================================================================

fn test_ai_interval_bot_inner() -> bool {
    let b = ai_interval_bot()
    ai_interval_is_bot(b)
}
fn test_ai_interval_bot() -> bool {
    test_ai_interval_bot_inner()
}

fn test_ai_interval_top_inner() -> bool {
    let t = ai_interval_top()
    ai_interval_is_top(t)
}
fn test_ai_interval_top() -> bool {
    test_ai_interval_top_inner()
}

fn test_ai_interval_const_inner() -> bool {
    let c = ai_interval_const(42)
    if ai_interval_is_const(c) == false { return false }
    if ai_interval_const_val(c) != 42 { return false }
    true
}
fn test_ai_interval_const() -> bool {
    test_ai_interval_const_inner()
}

fn test_ai_interval_range_inner() -> bool {
    let r = ai_interval_range(3, 7)
    if ai_interval_is_bot(r) { return false }
    if ai_interval_is_top(r) { return false }
    if r.lo != 3 { return false }
    if r.hi != 7 { return false }
    true
}
fn test_ai_interval_range() -> bool {
    test_ai_interval_range_inner()
}

fn test_ai_interval_range_inverted_inner() -> bool {
    // hi < lo should produce bot
    let r = ai_interval_range(10, 5)
    ai_interval_is_bot(r)
}
fn test_ai_interval_range_inverted() -> bool {
    test_ai_interval_range_inverted_inner()
}

fn test_ai_interval_join_bot_inner() -> bool {
    let b = ai_interval_bot()
    let c = ai_interval_const(5)
    let j = ai_interval_join(b, c)
    ai_interval_eq(j, c)
}
fn test_ai_interval_join_bot() -> bool {
    test_ai_interval_join_bot_inner()
}

fn test_ai_interval_join_ranges_inner() -> bool {
    let a = ai_interval_range(1, 5)
    let b = ai_interval_range(3, 8)
    let j = ai_interval_join(a, b)
    if j.lo != 1 { return false }
    if j.hi != 8 { return false }
    true
}
fn test_ai_interval_join_ranges() -> bool {
    test_ai_interval_join_ranges_inner()
}

fn test_ai_interval_meet_ranges_inner() -> bool {
    let a = ai_interval_range(1, 8)
    let b = ai_interval_range(3, 5)
    let m = ai_interval_meet(a, b)
    if m.lo != 3 { return false }
    if m.hi != 5 { return false }
    true
}
fn test_ai_interval_meet_ranges() -> bool {
    test_ai_interval_meet_ranges_inner()
}

fn test_ai_interval_meet_disjoint_inner() -> bool {
    let a = ai_interval_range(1, 3)
    let b = ai_interval_range(5, 8)
    let m = ai_interval_meet(a, b)
    ai_interval_is_bot(m)
}
fn test_ai_interval_meet_disjoint() -> bool {
    test_ai_interval_meet_disjoint_inner()
}

fn test_ai_interval_widen_inner() -> bool {
    let old = ai_interval_range(0, 10)
    let new_iv = ai_interval_range(0, 15)
    let w = ai_interval_widen(old, new_iv)
    // Lower bound same, upper bound should go to +inf
    if w.lo != 0 { return false }
    if w.hi != AI_INF_POS { return false }
    true
}
fn test_ai_interval_widen() -> bool {
    test_ai_interval_widen_inner()
}

fn test_ai_interval_contains_inner() -> bool {
    let r = ai_interval_range(3, 7)
    if ai_interval_contains(r, 5) == false { return false }
    if ai_interval_contains(r, 2) { return false }
    if ai_interval_contains(r, 8) { return false }
    if ai_interval_contains(r, 3) == false { return false }
    if ai_interval_contains(r, 7) == false { return false }
    true
}
fn test_ai_interval_contains() -> bool {
    test_ai_interval_contains_inner()
}

fn test_ai_interval_eq_inner() -> bool {
    let a = ai_interval_range(1, 5)
    let b = ai_interval_range(1, 5)
    let c = ai_interval_range(1, 6)
    if ai_interval_eq(a, b) == false { return false }
    if ai_interval_eq(a, c) { return false }
    if ai_interval_eq(ai_interval_bot(), ai_interval_bot()) == false { return false }
    if ai_interval_eq(ai_interval_top(), ai_interval_top()) == false { return false }
    true
}
fn test_ai_interval_eq() -> bool {
    test_ai_interval_eq_inner()
}

