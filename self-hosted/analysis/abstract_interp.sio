fn ai_run_all_tests() -> i64 with Mut, Div, Panic {
    var pass: i64 = 0
    var fail: i64 = 0

    // Category 1: Interval lattice (12)
    if test_ai_interval_bot() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_interval_top() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_interval_const() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_interval_range() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_interval_range_inverted() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_interval_join_bot() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_interval_join_ranges() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_interval_meet_ranges() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_interval_meet_disjoint() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_interval_widen() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_interval_contains() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_interval_eq() { pass = pass + 1 } else { fail = fail + 1 }

    // Category 2: Sign lattice (8)
    if test_ai_sign_bot_top() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_sign_join_same() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_sign_join_pos_neg() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_sign_join_pos_zero() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_sign_join_bot() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_sign_meet_pos_nonneg() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_sign_meet_pos_neg() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_sign_from_interval() { pass = pass + 1 } else { fail = fail + 1 }

    // Category 3: Congruence lattice (8)
    if test_ai_cong_bot() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_cong_top() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_cong_const() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_cong_new() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_cong_join_same() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_cong_join_different() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_cong_meet_compatible() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_cong_meet_incompatible() { pass = pass + 1 } else { fail = fail + 1 }

    // Category 4: Transfer functions (12)
    if test_ai_transfer_const() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_transfer_copy() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_transfer_add_const() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_transfer_add_range() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_transfer_sub() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_transfer_mul() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_transfer_div() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_transfer_mod() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_transfer_neg() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_transfer_cmp_eq_equal() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_transfer_cmp_eq_unequal() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_transfer_cmp_lt() { pass = pass + 1 } else { fail = fail + 1 }

    // Category 5: Branch refinement (8)
    if test_ai_refine_branch_true() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_refine_branch_false() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_refine_eq() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_refine_lt() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_refine_le() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_refine_branch_true_wide() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_refine_branch_false_wide() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_refine_lt_disjoint() { pass = pass + 1 } else { fail = fail + 1 }

    // Category 6: Fixed-point (10)
    if test_ai_single_block() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_two_blocks() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_simple_loop() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_convergence() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_widening() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_diamond_cfg() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_chain_three_blocks() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_worklist_basic() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_worklist_dedup() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_max_iterations() { pass = pass + 1 } else { fail = fail + 1 }

    // Category 7: State operations (8)
    if test_ai_state_new() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_state_set_get() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_state_reg_count() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_state_out_of_bounds() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_state_join() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_state_eq() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_state_copy() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_state_widen() { pass = pass + 1 } else { fail = fail + 1 }

    // Category 8: Integration (9)
    if test_ai_full_constant_prop() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_full_sign_analysis() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_full_non_negative() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_full_non_zero() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_full_range_check() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_full_diamond_merge() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_full_comparison_refine() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_full_neg_chain() { pass = pass + 1 } else { fail = fail + 1 }
    if test_ai_full_multi_block_chain() { pass = pass + 1 } else { fail = fail + 1 }

    // Return: 0 if all pass, else number of failures
    fail
}

// main removed — called from bootstrap main.sio via ai_run_all_tests()
