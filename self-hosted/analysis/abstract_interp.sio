    ai_refine_lt(&! state, 0, 1)
    let v0 = ai_state_get_reg(&state, 0)
    let v1 = ai_state_get_reg(&state, 1)
    // Already disjoint and in correct order; should be unchanged
    if v0.interval.lo != 1 { return false }
    if v0.interval.hi != 3 { return false }
    if v1.interval.lo != 5 { return false }
    if v1.interval.hi != 10 { return false }
    true
}
