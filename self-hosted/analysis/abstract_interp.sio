fn test_ai_sign_from_interval_inner() -> bool {
    let s1 = ai_sign_of_interval(ai_interval_range(1, 10))
    if ai_sign_eq(s1, AiSignValue::SignPos) == false { return false }
    let s2 = ai_sign_of_interval(ai_interval_range(0 - 5, 0 - 1))
    if ai_sign_eq(s2, AiSignValue::SignNeg) == false { return false }
    let s3 = ai_sign_of_interval(ai_interval_const(0))
    if ai_sign_eq(s3, AiSignValue::SignZero) == false { return false }
    let s4 = ai_sign_of_interval(ai_interval_range(0, 10))
    if ai_sign_eq(s4, AiSignValue::SignNonNeg) == false { return false }
    let s5 = ai_sign_of_interval(ai_interval_range(0 - 5, 0))
    if ai_sign_eq(s5, AiSignValue::SignNonPos) == false { return false }
    true
}
fn test_ai_sign_from_interval() -> bool {
    test_ai_sign_from_interval_inner()
}

