// self-hosted::analysis::escape — Escape Analysis
//
// Determines whether heap allocations escape the function in which they
// are created.  An allocation "escapes" if it can be observed outside its
// creating function — through a return value, a store to a global, or
// being passed as a reference to a callee.
//
// Algorithm:
//   1. Build an escape graph: nodes represent allocations / values, edges
//      represent data-flow relationships (copy, assignment, field store).
//   2. Seed escape: mark nodes that are directly returned, stored to
//      globals, or passed as references to callees.
//   3. Propagate: for each ASSIGN and FLOW edge from a non-escaping source
//      to an escaping destination, mark the source as escaping too.
//      Repeat until a fixed point.
//   4. Summarize: count escaping and local allocations.
//
// Edge kinds:
//   FLOW=0   — direct data flow (copy/phi)
//   DEREF=1  — pointer dereference
//   ASSIGN=2 — value is assigned into an escaping container
//
// Node escape reasons:
//   ESC_NONE=0         — does not escape
//   ESC_RETURNED=1     — returned from function
//   ESC_STORED_GLOBAL=2 — stored into a global variable
//   ESC_PASSED_REF=3   — passed as reference argument
//
// All arrays are fixed-size — no heap allocation.
//
// References:
//   Choi, Gupta, Serrano, Sreedhar, Midkiff:
//     "Escape Analysis for Java" (OOPSLA 1999)
//   Blanchet: "Escape Analysis for JavaTM: Theory and Practice" (TOPLAS 2003)
//   Whaley & Rinard: "Compositional Pointer and Escape Analysis for
//     Java Programs" (OOPSLA 1999)

// ============================================================================
// Section 1: Constants
// ============================================================================

let ESC_MAX_NODES: i64 = 256
let ESC_MAX_EDGES: i64 = 512
let ESC_INVALID: i64 = 0 - 1

// Node kinds
let ESC_LOCAL: i64 = 0
let ESC_PARAM: i64 = 1
let ESC_RETURN: i64 = 2
let ESC_FIELD: i64 = 3

// Escape reasons
let ESC_NONE: i64 = 0
let ESC_RETURNED: i64 = 1
let ESC_STORED_GLOBAL: i64 = 2
let ESC_PASSED_REF: i64 = 3

// Edge kinds
let ESC_FLOW: i64 = 0
let ESC_DEREF: i64 = 1
let ESC_ASSIGN: i64 = 2

// ============================================================================
// Section 2: Data Structures
// ============================================================================

// A single node in the escape graph.
// id     — unique integer identifier (0-based)
// kind   — ESC_LOCAL / ESC_PARAM / ESC_RETURN / ESC_FIELD
// escapes — true once the node is determined to escape
// reason  — why it escapes (ESC_NONE if it doesn't)
struct EscNode {
    id: i64,
    kind: i64,
    escapes: bool,
    reason: i64,
}

// A directed edge in the escape graph.
// from/to reference node ids.
// kind: FLOW, DEREF, or ASSIGN.
struct EscEdge {
    from: i64,
    to: i64,
    kind: i64,
}

// The full escape graph.
struct EscGraph {
    nodes: [EscNode; 256],
    edges: [EscEdge; 512],
    node_count: i64,
    edge_count: i64,
}

// Summary result after analysis.
struct EscResult {
    escape_count: i64,
    local_count: i64,
}

// ============================================================================
// Section 3: Constructors
// ============================================================================

fn esc_node_new(id: i64, kind: i64) -> EscNode {
    EscNode {
        id: id,
        kind: kind,
        escapes: false,
        reason: ESC_NONE,
    }
}

fn esc_edge_new(from: i64, to: i64, kind: i64) -> EscEdge {
    EscEdge {
        from: from,
        to: to,
        kind: kind,
    }
}

fn esc_graph_new() -> EscGraph {
    EscGraph {
        nodes: [esc_node_new(ESC_INVALID, ESC_LOCAL); 256],
        edges: [esc_edge_new(ESC_INVALID, ESC_INVALID, ESC_FLOW); 512],
        node_count: 0,
        edge_count: 0,
    }
}

fn esc_result_new() -> EscResult {
    EscResult {
        escape_count: 0,
        local_count: 0,
    }
}

// ============================================================================
// Section 4: Graph Mutation
// ============================================================================

// Add a new node of the given kind to the graph.
// Returns the new node's id (0-based index).
// Panics if the graph is full.
fn esc_add_node(g: &! EscGraph, kind: i64) -> i64 with Mut, Panic {
    if g.node_count >= ESC_MAX_NODES {
        return ESC_INVALID
    }
    let id = g.node_count
    g.nodes[id as usize] = esc_node_new(id, kind)
    g.node_count = g.node_count + 1
    id
}

// Add a directed edge from → to with the given kind.
// No-op (silently) if the edge array is full.
fn esc_add_edge(g: &! EscGraph, from: i64, to: i64, kind: i64) with Mut, Panic {
    if g.edge_count >= ESC_MAX_EDGES {
        return
    }
    g.edges[g.edge_count as usize] = esc_edge_new(from, to, kind)
    g.edge_count = g.edge_count + 1
}

// ============================================================================
// Section 5: Escape Marking
// ============================================================================

// Mark a node as escaping via the RETURN path.
fn esc_mark_returned(g: &! EscGraph, id: i64) with Mut, Panic {
    if id < 0 { return }
    if id >= g.node_count { return }
    g.nodes[id as usize].escapes = true
    g.nodes[id as usize].reason = ESC_RETURNED
}

// Mark a node as escaping via store to a global.
fn esc_mark_global(g: &! EscGraph, id: i64) with Mut, Panic {
    if id < 0 { return }
    if id >= g.node_count { return }
    g.nodes[id as usize].escapes = true
    g.nodes[id as usize].reason = ESC_STORED_GLOBAL
}

// Mark a node as escaping via reference passed to a callee.
fn esc_mark_ref(g: &! EscGraph, id: i64) with Mut, Panic {
    if id < 0 { return }
    if id >= g.node_count { return }
    g.nodes[id as usize].escapes = true
    g.nodes[id as usize].reason = ESC_PASSED_REF
}

// Check if a node escapes.
fn esc_node_escapes(g: &EscGraph, id: i64) -> bool {
    if id < 0 { return false }
    if id >= g.node_count { return false }
    g.nodes[id as usize].escapes
}

// Get the escape reason for a node.
fn esc_node_reason(g: &EscGraph, id: i64) -> i64 {
    if id < 0 { return ESC_NONE }
    if id >= g.node_count { return ESC_NONE }
    g.nodes[id as usize].reason
}

// Get the kind of a node.
fn esc_node_kind(g: &EscGraph, id: i64) -> i64 {
    if id < 0 { return ESC_INVALID }
    if id >= g.node_count { return ESC_INVALID }
    g.nodes[id as usize].kind
}

// ============================================================================
// Section 6: Escape Propagation
// ============================================================================

// One propagation step: for each edge (from → to), if `to` escapes then
// mark `from` as escaping as well (escape flows backward through data-flow).
// Returns the number of nodes newly marked as escaping in this step.
fn esc_propagate_step(g: &! EscGraph) -> i64 with Mut, Div, Panic {
    var newly_escaped: i64 = 0
    var ei: i64 = 0
    while ei < g.edge_count {
        let edge = g.edges[ei as usize]
        let to_id = edge.to
        let from_id = edge.from
        // If the destination escapes and the source doesn't yet, propagate.
        if to_id >= 0 && to_id < g.node_count {
            if g.nodes[to_id as usize].escapes {
                if from_id >= 0 && from_id < g.node_count {
                    if g.nodes[from_id as usize].escapes == false {
                        g.nodes[from_id as usize].escapes = true
                        // Preserve the downstream reason.
                        g.nodes[from_id as usize].reason = g.nodes[to_id as usize].reason
                        newly_escaped = newly_escaped + 1
                    }
                }
            }
        }
        ei = ei + 1
    }
    newly_escaped
}

// Run propagation to a fixed point (iterate until no new nodes escape).
// Bounded by ESC_MAX_NODES iterations.
fn esc_propagate(g: &! EscGraph) with Mut, Div, Panic {
    var iters: i64 = 0
    var max_iters: i64 = ESC_MAX_NODES
    while iters < max_iters {
        let delta = esc_propagate_step(g)
        if delta == 0 { return }
        iters = iters + 1
    }
}

// ============================================================================
// Section 7: Summary Analysis
// ============================================================================

// Run the full escape analysis: propagate and then count escaping vs local nodes.
fn esc_analyze(g: &! EscGraph) -> EscResult with Mut, Div, Panic {
    esc_propagate(g)
    var result = esc_result_new()
    var ni: i64 = 0
    while ni < g.node_count {
        if g.nodes[ni as usize].escapes {
            result.escape_count = result.escape_count + 1
        } else {
            result.local_count = result.local_count + 1
        }
        ni = ni + 1
    }
    result
}

// Count nodes with a specific escape reason.
fn esc_count_reason(g: &EscGraph, reason: i64) -> i64 {
    var cnt: i64 = 0
    var ni: i64 = 0
    while ni < g.node_count {
        if g.nodes[ni as usize].reason == reason {
            cnt = cnt + 1
        }
        ni = ni + 1
    }
    cnt
}

// Count nodes with a specific kind.
fn esc_count_kind(g: &EscGraph, kind: i64) -> i64 {
    var cnt: i64 = 0
    var ni: i64 = 0
    while ni < g.node_count {
        if g.nodes[ni as usize].kind == kind {
            cnt = cnt + 1
        }
        ni = ni + 1
    }
    cnt
}

// Check if any node in the graph escapes.
fn esc_any_escapes(g: &EscGraph) -> bool {
    var ni: i64 = 0
    while ni < g.node_count {
        if g.nodes[ni as usize].escapes { return true }
        ni = ni + 1
    }
    false
}

// Check if all nodes in the graph escape.
fn esc_all_escape(g: &EscGraph) -> bool {
    if g.node_count == 0 { return false }
    var ni: i64 = 0
    while ni < g.node_count {
        if g.nodes[ni as usize].escapes == false { return false }
        ni = ni + 1
    }
    true
}

// Count edges from a given node.
fn esc_out_degree(g: &EscGraph, id: i64) -> i64 {
    var cnt: i64 = 0
    var ei: i64 = 0
    while ei < g.edge_count {
        if g.edges[ei as usize].from == id {
            cnt = cnt + 1
        }
        ei = ei + 1
    }
    cnt
}

// Count edges into a given node.
fn esc_in_degree(g: &EscGraph, id: i64) -> i64 {
    var cnt: i64 = 0
    var ei: i64 = 0
    while ei < g.edge_count {
        if g.edges[ei as usize].to == id {
            cnt = cnt + 1
        }
        ei = ei + 1
    }
    cnt
}

// Check if there is a direct edge from → to.
fn esc_has_edge(g: &EscGraph, from: i64, to: i64) -> bool {
    var ei: i64 = 0
    while ei < g.edge_count {
        let e = g.edges[ei as usize]
        if e.from == from && e.to == to { return true }
        ei = ei + 1
    }
    false
}

// ============================================================================
// Section 8: Tests — Category 1: Graph Construction (10 tests)
// ============================================================================

// T01: Empty graph has zero nodes.
fn test_esc_empty_graph() -> bool {
    let g = esc_graph_new()
    g.node_count == 0 && g.edge_count == 0
}

// T02: esc_add_node returns sequential ids.
fn test_esc_add_node_ids_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let id0 = esc_add_node(g, ESC_LOCAL)
    let id1 = esc_add_node(g, ESC_LOCAL)
    let id2 = esc_add_node(g, ESC_FIELD)
    id0 == 0 && id1 == 1 && id2 == 2 && g.node_count == 3
}
fn test_esc_add_node_ids() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_add_node_ids_inner(&! g)
}

// T03: esc_add_node creates non-escaping nodes.
fn test_esc_add_node_not_escaping_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let id = esc_add_node(g, ESC_LOCAL)
    esc_node_escapes(g, id) == false
}
fn test_esc_add_node_not_escaping() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_add_node_not_escaping_inner(&! g)
}

// T04: esc_add_edge increments edge count.
fn test_esc_add_edge_count_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let n0 = esc_add_node(g, ESC_LOCAL)
    let n1 = esc_add_node(g, ESC_LOCAL)
    esc_add_edge(g, n0, n1, ESC_FLOW)
    g.edge_count == 1
}
fn test_esc_add_edge_count() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_add_edge_count_inner(&! g)
}

// T05: esc_has_edge detects an added edge.
fn test_esc_has_edge_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let n0 = esc_add_node(g, ESC_LOCAL)
    let n1 = esc_add_node(g, ESC_LOCAL)
    esc_add_edge(g, n0, n1, ESC_FLOW)
    esc_has_edge(g, n0, n1)
}
fn test_esc_has_edge() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_has_edge_inner(&! g)
}

// T06: esc_has_edge returns false for missing edge.
fn test_esc_no_edge_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let n0 = esc_add_node(g, ESC_LOCAL)
    let n1 = esc_add_node(g, ESC_LOCAL)
    let r = esc_has_edge(g, n0, n1)
    r == false
}
fn test_esc_no_edge() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_no_edge_inner(&! g)
}

// T07: esc_out_degree counts outgoing edges.
fn test_esc_out_degree_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let n0 = esc_add_node(g, ESC_LOCAL)
    let n1 = esc_add_node(g, ESC_LOCAL)
    let n2 = esc_add_node(g, ESC_LOCAL)
    esc_add_edge(g, n0, n1, ESC_FLOW)
    esc_add_edge(g, n0, n2, ESC_ASSIGN)
    esc_out_degree(g, n0) == 2
}
fn test_esc_out_degree() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_out_degree_inner(&! g)
}

// T08: esc_in_degree counts incoming edges.
fn test_esc_in_degree_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let n0 = esc_add_node(g, ESC_LOCAL)
    let n1 = esc_add_node(g, ESC_LOCAL)
    let n2 = esc_add_node(g, ESC_LOCAL)
    esc_add_edge(g, n0, n2, ESC_FLOW)
    esc_add_edge(g, n1, n2, ESC_FLOW)
    esc_in_degree(g, n2) == 2
}
fn test_esc_in_degree() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_in_degree_inner(&! g)
}

// T09: esc_node_kind returns correct kind.
fn test_esc_node_kind_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let n0 = esc_add_node(g, ESC_PARAM)
    let n1 = esc_add_node(g, ESC_RETURN)
    esc_node_kind(g, n0) == ESC_PARAM && esc_node_kind(g, n1) == ESC_RETURN
}
fn test_esc_node_kind() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_node_kind_inner(&! g)
}

// T10: esc_count_kind counts correctly.
fn test_esc_count_kind_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let n0 = esc_add_node(g, ESC_LOCAL)
    let n1 = esc_add_node(g, ESC_LOCAL)
    let n2 = esc_add_node(g, ESC_PARAM)
    esc_count_kind(g, ESC_LOCAL) == 2 && esc_count_kind(g, ESC_PARAM) == 1
}
fn test_esc_count_kind() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_count_kind_inner(&! g)
}

// ============================================================================
// Section 9: Tests — Category 2: Escape Marking (10 tests)
// ============================================================================

// T11: esc_mark_returned marks node as escaping.
fn test_esc_mark_returned_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let id = esc_add_node(g, ESC_LOCAL)
    esc_mark_returned(g, id)
    esc_node_escapes(g, id) && esc_node_reason(g, id) == ESC_RETURNED
}
fn test_esc_mark_returned() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_mark_returned_inner(&! g)
}

// T12: esc_mark_global marks node as escaping.
fn test_esc_mark_global_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let id = esc_add_node(g, ESC_LOCAL)
    esc_mark_global(g, id)
    esc_node_escapes(g, id) && esc_node_reason(g, id) == ESC_STORED_GLOBAL
}
fn test_esc_mark_global() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_mark_global_inner(&! g)
}

// T13: esc_mark_ref marks node as escaping via reference.
fn test_esc_mark_ref_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let id = esc_add_node(g, ESC_LOCAL)
    esc_mark_ref(g, id)
    esc_node_escapes(g, id) && esc_node_reason(g, id) == ESC_PASSED_REF
}
fn test_esc_mark_ref() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_mark_ref_inner(&! g)
}

// T14: esc_node_escapes returns false for fresh node.
fn test_esc_fresh_not_escaping_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let id = esc_add_node(g, ESC_LOCAL)
    esc_node_escapes(g, id) == false
}
fn test_esc_fresh_not_escaping() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_fresh_not_escaping_inner(&! g)
}

// T15: esc_node_reason returns ESC_NONE for fresh node.
fn test_esc_fresh_reason_none_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let id = esc_add_node(g, ESC_LOCAL)
    esc_node_reason(g, id) == ESC_NONE
}
fn test_esc_fresh_reason_none() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_fresh_reason_none_inner(&! g)
}

// T16: esc_any_escapes returns false when nothing escapes.
fn test_esc_any_escapes_false_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let n0 = esc_add_node(g, ESC_LOCAL)
    let n1 = esc_add_node(g, ESC_LOCAL)
    esc_any_escapes(g) == false
}
fn test_esc_any_escapes_false() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_any_escapes_false_inner(&! g)
}

// T17: esc_any_escapes returns true after marking.
fn test_esc_any_escapes_true_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let n0 = esc_add_node(g, ESC_LOCAL)
    let n1 = esc_add_node(g, ESC_LOCAL)
    esc_mark_returned(g, n0)
    esc_any_escapes(g)
}
fn test_esc_any_escapes_true() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_any_escapes_true_inner(&! g)
}

// T18: esc_all_escape false when some local.
fn test_esc_all_escape_false_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let n0 = esc_add_node(g, ESC_LOCAL)
    let n1 = esc_add_node(g, ESC_LOCAL)
    esc_mark_returned(g, n0)
    esc_all_escape(g) == false
}
fn test_esc_all_escape_false() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_all_escape_false_inner(&! g)
}

// T19: esc_all_escape true when all marked.
fn test_esc_all_escape_true_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let n0 = esc_add_node(g, ESC_LOCAL)
    let n1 = esc_add_node(g, ESC_LOCAL)
    esc_mark_returned(g, n0)
    esc_mark_global(g, n1)
    esc_all_escape(g)
}
fn test_esc_all_escape_true() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_all_escape_true_inner(&! g)
}

// T20: esc_mark_returned on invalid id is a no-op (no panic).
fn test_esc_mark_invalid_id_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    esc_mark_returned(g, ESC_INVALID)
    esc_mark_returned(g, 9999)
    g.node_count == 0
}
fn test_esc_mark_invalid_id() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_mark_invalid_id_inner(&! g)
}

// ============================================================================
// Section 10: Tests — Category 3: Propagation (12 tests)
// ============================================================================

// T21: Local node not connected to any escaping node → stays local.
fn test_esc_local_no_escape_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let n0 = esc_add_node(g, ESC_LOCAL)
    esc_propagate(g)
    esc_node_escapes(g, n0) == false
}
fn test_esc_local_no_escape() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_local_no_escape_inner(&! g)
}

// T22: Node flowing into a returned node → escapes.
fn test_esc_flow_to_returned_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let n0 = esc_add_node(g, ESC_LOCAL)
    let n1 = esc_add_node(g, ESC_LOCAL)
    esc_add_edge(g, n0, n1, ESC_FLOW)
    esc_mark_returned(g, n1)
    esc_propagate(g)
    esc_node_escapes(g, n0)
}
fn test_esc_flow_to_returned() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_flow_to_returned_inner(&! g)
}

// T23: Chain propagation: a→b→c, c escapes → all escape.
fn test_esc_chain_propagation_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let na = esc_add_node(g, ESC_LOCAL)
    let nb = esc_add_node(g, ESC_LOCAL)
    let nc = esc_add_node(g, ESC_LOCAL)
    esc_add_edge(g, na, nb, ESC_FLOW)
    esc_add_edge(g, nb, nc, ESC_FLOW)
    esc_mark_returned(g, nc)
    esc_propagate(g)
    esc_node_escapes(g, na) && esc_node_escapes(g, nb)
}
fn test_esc_chain_propagation() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_chain_propagation_inner(&! g)
}

// T24: Unconnected node is not affected by propagation.
fn test_esc_isolated_stays_local_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let n0 = esc_add_node(g, ESC_LOCAL)
    let n1 = esc_add_node(g, ESC_LOCAL)
    esc_mark_returned(g, n1)
    esc_propagate(g)
    esc_node_escapes(g, n0) == false
}
fn test_esc_isolated_stays_local() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_isolated_stays_local_inner(&! g)
}

// T25: ASSIGN edge propagates escape.
fn test_esc_assign_propagation_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let n0 = esc_add_node(g, ESC_LOCAL)
    let n1 = esc_add_node(g, ESC_LOCAL)
    esc_add_edge(g, n0, n1, ESC_ASSIGN)
    esc_mark_global(g, n1)
    esc_propagate(g)
    esc_node_escapes(g, n0)
}
fn test_esc_assign_propagation() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_assign_propagation_inner(&! g)
}

// T26: DEREF edge propagates escape.
fn test_esc_deref_propagation_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let n0 = esc_add_node(g, ESC_LOCAL)
    let n1 = esc_add_node(g, ESC_LOCAL)
    esc_add_edge(g, n0, n1, ESC_DEREF)
    esc_mark_ref(g, n1)
    esc_propagate(g)
    esc_node_escapes(g, n0)
}
fn test_esc_deref_propagation() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_deref_propagation_inner(&! g)
}

// T27: Multiple predecessors: at least one edge to escaping → escapes.
fn test_esc_multi_pred_escapes_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let n0 = esc_add_node(g, ESC_LOCAL)
    let n1 = esc_add_node(g, ESC_LOCAL)
    let n2 = esc_add_node(g, ESC_LOCAL)
    esc_add_edge(g, n0, n2, ESC_FLOW)
    esc_add_edge(g, n1, n2, ESC_FLOW)
    esc_mark_returned(g, n2)
    esc_propagate(g)
    esc_node_escapes(g, n0) && esc_node_escapes(g, n1)
}
fn test_esc_multi_pred_escapes() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_multi_pred_escapes_inner(&! g)
}

