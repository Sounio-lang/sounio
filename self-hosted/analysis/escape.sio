    let ret = esc_add_node(g, ESC_RETURN)
    esc_add_edge(g, alloc, use1, ESC_FLOW)
    esc_add_edge(g, alloc, use2, ESC_FLOW)
    esc_mark_returned(g, ret)
    esc_propagate(g)
    esc_node_escapes(g, alloc) == false
}
