// T63: Scenario: graph with 5 nodes, 4 edges, one escape root.
fn test_esc_scenario_five_node_chain_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let n0 = esc_add_node(g, ESC_LOCAL)
    let n1 = esc_add_node(g, ESC_LOCAL)
    let n2 = esc_add_node(g, ESC_LOCAL)
    let n3 = esc_add_node(g, ESC_LOCAL)
    let n4 = esc_add_node(g, ESC_RETURN)
    esc_add_edge(g, n0, n1, ESC_FLOW)
    esc_add_edge(g, n1, n2, ESC_FLOW)
    esc_add_edge(g, n2, n3, ESC_FLOW)
    esc_add_edge(g, n3, n4, ESC_FLOW)
    esc_mark_returned(g, n4)
    let r = esc_analyze(g)
    r.escape_count == 5 && r.local_count == 0
}
fn test_esc_scenario_five_node_chain() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_scenario_five_node_chain_inner(&! g)
}

// T64: Scenario: diamond graph, only top escapes if bottom escapes.
fn test_esc_scenario_diamond_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let top = esc_add_node(g, ESC_LOCAL)
    let left = esc_add_node(g, ESC_LOCAL)
    let right = esc_add_node(g, ESC_LOCAL)
    let bot = esc_add_node(g, ESC_LOCAL)
    esc_add_edge(g, top, left, ESC_FLOW)
    esc_add_edge(g, top, right, ESC_FLOW)
    esc_add_edge(g, left, bot, ESC_FLOW)
    esc_add_edge(g, right, bot, ESC_FLOW)
    esc_mark_returned(g, bot)
    let r = esc_analyze(g)
    r.escape_count == 4
}
fn test_esc_scenario_diamond() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_scenario_diamond_inner(&! g)
}

// T65: Scenario: count escaping by reason across multiple roots.
fn test_esc_scenario_multi_reason_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let n0 = esc_add_node(g, ESC_LOCAL)
    let n1 = esc_add_node(g, ESC_LOCAL)
    let n2 = esc_add_node(g, ESC_LOCAL)
    let n3 = esc_add_node(g, ESC_LOCAL)
    esc_mark_returned(g, n0)
    esc_mark_global(g, n1)
    esc_mark_ref(g, n2)
    esc_propagate(g)
    let rr = esc_count_reason(g, ESC_RETURNED)
    let rg = esc_count_reason(g, ESC_STORED_GLOBAL)
    let rp = esc_count_reason(g, ESC_PASSED_REF)
    rr == 1 && rg == 1 && rp == 1
}
fn test_esc_scenario_multi_reason() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_scenario_multi_reason_inner(&! g)
}

// ============================================================================
// Section 15: Test Runner
// ============================================================================

fn esc_run_tests() -> i64 with Mut, Div, Panic {
    var passed: i64 = 0
    var failed: i64 = 0

    // Category 1: Construction (10)
    if test_esc_empty_graph() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_add_node_ids() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_add_node_not_escaping() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_add_edge_count() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_has_edge() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_no_edge() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_out_degree() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_in_degree() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_node_kind() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_count_kind() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 2: Escape Marking (10)
    if test_esc_mark_returned() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_mark_global() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_mark_ref() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_fresh_not_escaping() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_fresh_reason_none() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_any_escapes_false() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_any_escapes_true() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_all_escape_false() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_all_escape_true() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_mark_invalid_id() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 3: Propagation (12)
    if test_esc_local_no_escape() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_flow_to_returned() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_chain_propagation() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_isolated_stays_local() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_assign_propagation() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_deref_propagation() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_multi_pred_escapes() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_flow_to_local_no_escape() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_propagate_empty() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_count_reason() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_reason_propagates() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_propagate_step_delta() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 4: esc_analyze Summary (10)
    if test_esc_analyze_empty() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_analyze_all_local() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_analyze_one_returned() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_analyze_propagated() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_analyze_local_alloc_no_escape() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_analyze_returned_count() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_analyze_global_escape() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_analyze_mixed() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_analyze_ref_escape() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_analyze_single_local() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 5: Edge Cases (13)
    if test_esc_escapes_invalid_id() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_reason_invalid_id() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_kind_invalid_id() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_out_degree_zero() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_in_degree_zero() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_two_chains_independent() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_field_kind() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_count_field_kind() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_propagate_step_idempotent() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_multiple_edge_kinds() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_all_escape_empty() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_global_reason() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_ref_reason() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 6: Integration (10)
    if test_esc_scenario_local_only() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_scenario_alloc_returned() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_scenario_stored_global() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_scenario_passed_ref() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_scenario_two_allocs() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_scenario_indirect_escape() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_scenario_param_escapes() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_scenario_five_node_chain() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_scenario_diamond() { passed = passed + 1 } else { failed = failed + 1 }
    if test_esc_scenario_multi_reason() { passed = passed + 1 } else { failed = failed + 1 }

    if failed > 0 { return 0 - failed }
    passed
}
