}

// T30: esc_count_reason counts correctly after propagation.
fn test_esc_count_reason_inner(g: &! EscGraph) -> bool with Mut, Div, Panic {
    let n0 = esc_add_node(g, ESC_LOCAL)
    let n1 = esc_add_node(g, ESC_LOCAL)
    let n2 = esc_add_node(g, ESC_LOCAL)
    esc_mark_returned(g, n0)
    esc_mark_global(g, n1)
    esc_propagate(g)
    esc_count_reason(g, ESC_RETURNED) == 1 && esc_count_reason(g, ESC_STORED_GLOBAL) == 1 && esc_count_reason(g, ESC_NONE) == 1
}
fn test_esc_count_reason() -> bool with Mut, Div, Panic {
    var g = esc_graph_new()
    test_esc_count_reason_inner(&! g)
}

