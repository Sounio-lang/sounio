fn test_lt_ancestor_self_inner(ctx: &! LtContext) -> bool with Mut, Div, Panic {
    let r0 = lt_add_region(ctx, 0, 10, LT_NO_PARENT)
    // With r0 as both anc and desc: cur starts as r0 = anc → returns true.
    lt_region_is_ancestor(ctx, r0, r0)
}
fn test_lt_ancestor_self() -> bool with Mut, Div, Panic {
    var ctx = lt_context_new()
    test_lt_ancestor_self_inner(&! ctx)
}

// T58: lt_region_nested: same region is nested in itself.
fn test_lt_region_nested_self_inner(ctx: &! LtContext) -> bool with Mut, Div, Panic {
    let r0 = lt_add_region(ctx, 5, 15, LT_NO_PARENT)
    lt_region_nested(ctx, r0, r0)
}
fn test_lt_region_nested_self() -> bool with Mut, Div, Panic {
    var ctx = lt_context_new()
    test_lt_region_nested_self_inner(&! ctx)
}

// T59: lt_region_nested: child is nested in parent.
fn test_lt_region_nested_child_inner(ctx: &! LtContext) -> bool with Mut, Div, Panic {
    let outer = lt_add_region(ctx, 0, 20, LT_NO_PARENT)
    let inner = lt_add_region(ctx, 3, 17, outer)
    lt_region_nested(ctx, inner, outer)
}
fn test_lt_region_nested_child() -> bool with Mut, Div, Panic {
    var ctx = lt_context_new()
    test_lt_region_nested_child_inner(&! ctx)
}

// T60: lt_region_nested: parent is NOT nested in child.
fn test_lt_region_not_nested_parent_in_child_inner(ctx: &! LtContext) -> bool with Mut, Div, Panic {
    let outer = lt_add_region(ctx, 0, 20, LT_NO_PARENT)
    let inner = lt_add_region(ctx, 5, 10, outer)
    let v = lt_region_nested(ctx, outer, inner)
    v == false
}
fn test_lt_region_not_nested_parent_in_child() -> bool with Mut, Div, Panic {
    var ctx = lt_context_new()
    test_lt_region_not_nested_parent_in_child_inner(&! ctx)
}

// ============================================================================
// Section 14: Tests — Category 7: Integration Scenarios (10 tests)
// ============================================================================

// T61: Scenario: single mutable borrow, no conflict.
fn test_lt_scenario_single_mut_inner(ctx: &! LtContext) -> bool with Mut, Div, Panic {
    let r0 = lt_add_region(ctx, 0, 10, LT_NO_PARENT)
    let b0 = lt_add_borrow(ctx, 1, r0, true)
    lt_check_conflicts(ctx)
    ctx.conflict_count == 0
}
fn test_lt_scenario_single_mut() -> bool with Mut, Div, Panic {
    var ctx = lt_context_new()
    test_lt_scenario_single_mut_inner(&! ctx)
}

// T62: Scenario: sequential mutable borrows, no conflict.
fn test_lt_scenario_sequential_mut_inner(ctx: &! LtContext) -> bool with Mut, Div, Panic {
    let r0 = lt_add_region(ctx, 0, 5, LT_NO_PARENT)
    let r1 = lt_add_region(ctx, 5, 10, LT_NO_PARENT)
    let b0 = lt_add_borrow(ctx, 1, r0, true)
    let b1 = lt_add_borrow(ctx, 1, r1, true)
    lt_check_conflicts(ctx)
    ctx.conflict_count == 0
}
fn test_lt_scenario_sequential_mut() -> bool with Mut, Div, Panic {
    var ctx = lt_context_new()
    test_lt_scenario_sequential_mut_inner(&! ctx)
}

// T63: Scenario: overlapping mutable borrows → conflict.
fn test_lt_scenario_overlapping_mut_inner(ctx: &! LtContext) -> bool with Mut, Div, Panic {
    let r0 = lt_add_region(ctx, 0, 10, LT_NO_PARENT)
    let r1 = lt_add_region(ctx, 3, 13, LT_NO_PARENT)
    let b0 = lt_add_borrow(ctx, 5, r0, true)
    let b1 = lt_add_borrow(ctx, 5, r1, true)
    lt_check_conflicts(ctx)
    lt_has_conflicts(ctx)
}
fn test_lt_scenario_overlapping_mut() -> bool with Mut, Div, Panic {
    var ctx = lt_context_new()
    test_lt_scenario_overlapping_mut_inner(&! ctx)
}

// T64: Scenario: shared borrows never conflict, even overlapping.
fn test_lt_scenario_many_shared_inner(ctx: &! LtContext) -> bool with Mut, Div, Panic {
    let r0 = lt_add_region(ctx, 0, 100, LT_NO_PARENT)
    let b0 = lt_add_borrow(ctx, 1, r0, false)
    let b1 = lt_add_borrow(ctx, 1, r0, false)
    let b2 = lt_add_borrow(ctx, 1, r0, false)
    lt_check_conflicts(ctx)
    ctx.conflict_count == 0
}
fn test_lt_scenario_many_shared() -> bool with Mut, Div, Panic {
    var ctx = lt_context_new()
    test_lt_scenario_many_shared_inner(&! ctx)
}

// T65: Scenario: nested regions, inner mut borrow and outer shared → conflict.
fn test_lt_scenario_nested_conflict_inner(ctx: &! LtContext) -> bool with Mut, Div, Panic {
    let outer = lt_add_region(ctx, 0, 20, LT_NO_PARENT)
    let inner = lt_add_region(ctx, 5, 15, outer)
    let b0 = lt_add_borrow(ctx, 7, outer, false)
    let b1 = lt_add_borrow(ctx, 7, inner, true)
    lt_check_conflicts(ctx)
    lt_has_conflicts(ctx)
}
fn test_lt_scenario_nested_conflict() -> bool with Mut, Div, Panic {
    var ctx = lt_context_new()
    test_lt_scenario_nested_conflict_inner(&! ctx)
}

// T66: Scenario: different referents, no conflict.
fn test_lt_scenario_different_referents_inner(ctx: &! LtContext) -> bool with Mut, Div, Panic {
    let r0 = lt_add_region(ctx, 0, 10, LT_NO_PARENT)
    let b0 = lt_add_borrow(ctx, 1, r0, true)
    let b1 = lt_add_borrow(ctx, 2, r0, true)
    lt_check_conflicts(ctx)
    ctx.conflict_count == 0
}
fn test_lt_scenario_different_referents() -> bool with Mut, Div, Panic {
    var ctx = lt_context_new()
    test_lt_scenario_different_referents_inner(&! ctx)
}

// T67: Scenario: three borrows, two conflict, one is fine.
fn test_lt_scenario_three_borrows_inner(ctx: &! LtContext) -> bool with Mut, Div, Panic {
    let r0 = lt_add_region(ctx, 0, 10, LT_NO_PARENT)
    let r1 = lt_add_region(ctx, 5, 15, LT_NO_PARENT)
    let r2 = lt_add_region(ctx, 20, 30, LT_NO_PARENT)
    let b0 = lt_add_borrow(ctx, 1, r0, true)
    let b1 = lt_add_borrow(ctx, 1, r1, true)
    let b2 = lt_add_borrow(ctx, 1, r2, true)
    lt_check_conflicts(ctx)
    // b0-b1 conflict, b0-b2 no (non-overlapping), b1-b2 no (non-overlapping)
    ctx.conflict_count == 1
}
fn test_lt_scenario_three_borrows() -> bool with Mut, Div, Panic {
    var ctx = lt_context_new()
    test_lt_scenario_three_borrows_inner(&! ctx)
}

// T68: Scenario: count live borrows changes over program.
fn test_lt_scenario_live_count_changes_inner(ctx: &! LtContext) -> bool with Mut, Div, Panic {
    let r0 = lt_add_region(ctx, 0, 5, LT_NO_PARENT)
    let r1 = lt_add_region(ctx, 3, 10, LT_NO_PARENT)
    let r2 = lt_add_region(ctx, 7, 15, LT_NO_PARENT)
    let b0 = lt_add_borrow(ctx, 1, r0, false)
    let b1 = lt_add_borrow(ctx, 2, r1, false)
    let b2 = lt_add_borrow(ctx, 3, r2, false)
    let c0 = lt_count_live_at(ctx, 0)
    let c1 = lt_count_live_at(ctx, 4)
    let c2 = lt_count_live_at(ctx, 8)
    c0 == 1 && c1 == 2 && c2 == 2
}
fn test_lt_scenario_live_count_changes() -> bool with Mut, Div, Panic {
    var ctx = lt_context_new()
    test_lt_scenario_live_count_changes_inner(&! ctx)
}

// T69: Scenario: conflict detection is idempotent (running twice same count).
fn test_lt_scenario_idempotent_conflict_inner(ctx: &! LtContext) -> bool with Mut, Div, Panic {
    let r0 = lt_add_region(ctx, 0, 10, LT_NO_PARENT)
    let r1 = lt_add_region(ctx, 5, 15, LT_NO_PARENT)
    let b0 = lt_add_borrow(ctx, 1, r0, true)
    let b1 = lt_add_borrow(ctx, 1, r1, true)
    lt_check_conflicts(ctx)
    let c1 = ctx.conflict_count
    lt_check_conflicts(ctx)
    let c2 = ctx.conflict_count
    c1 == 1 && c2 == 1
}
fn test_lt_scenario_idempotent_conflict() -> bool with Mut, Div, Panic {
    var ctx = lt_context_new()
    test_lt_scenario_idempotent_conflict_inner(&! ctx)
}

// T70: Scenario: region_span zero for empty region.
fn test_lt_scenario_region_span_zero_inner(ctx: &! LtContext) -> bool with Mut, Div, Panic {
    let r0 = lt_add_region(ctx, 5, 5, LT_NO_PARENT)
    lt_region_span(ctx, r0) == 0
}
fn test_lt_scenario_region_span_zero() -> bool with Mut, Div, Panic {
    var ctx = lt_context_new()
    test_lt_scenario_region_span_zero_inner(&! ctx)
}

// ============================================================================
// Section 15: Test Runner
// ============================================================================

fn lt_run_tests() -> i64 with Mut, Div, Panic {
    var passed: i64 = 0
    var failed: i64 = 0

    // Category 1: Context and Region Construction (10)
    if test_lt_context_new() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_add_region_ids() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_get_region() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_get_region_oob() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_region_valid() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_region_valid_invalid() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_count_root_regions() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_region_is_parent() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_region_not_parent() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_region_span() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 2: Region Overlap and Containment (12)
    if test_lt_regions_no_overlap_before() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_regions_no_overlap_after() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_regions_overlap_partial() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_regions_overlap_contained() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_regions_overlap_self() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_region_contains_inside() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_region_contains_at_start() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_region_contains_at_end() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_region_contains_before() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_region_nested_true() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_region_nested_false() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_regions_overlap_length() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 3: Borrow Construction (8)
    if test_lt_add_borrow_ids() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_get_borrow() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_get_borrow_oob() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_count_borrows_of() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_count_mut_borrows_of() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_count_shared_borrows_of() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_borrow_live_at_inside() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_borrow_live_at_outside() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 4: Conflict Detection (15)
    if test_lt_conflict_mut_mut() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_conflict_mut_shared() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_no_conflict_shared_shared() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_no_conflict_different_referents() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_no_conflict_non_overlapping() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_check_conflicts_mut_mut() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_check_conflicts_none() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_check_shared_shared_no_conflict() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_conflict_exists() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_conflict_not_exists() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_borrow_self_no_conflict() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_has_conflicts_false() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_has_conflicts_true() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_conflict_point() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_check_multiple_conflicts() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 5: Live Borrow Counting (8)
    if test_lt_count_live_at_zero() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_count_live_at_one() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_count_live_at_outside() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_count_mut_live_at() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_find_mut_borrow_at() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_find_mut_borrow_at_none() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_count_live_multiple() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_borrow_live_at_boundary() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 6: Ancestor and Hierarchy (7)
    if test_lt_ancestor_direct() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_ancestor_grandparent() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_ancestor_unrelated() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_ancestor_self() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_region_nested_self() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_region_nested_child() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_region_not_nested_parent_in_child() { passed = passed + 1 } else { failed = failed + 1 }

    // Category 7: Integration Scenarios (10)
    if test_lt_scenario_single_mut() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_scenario_sequential_mut() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_scenario_overlapping_mut() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_scenario_many_shared() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_scenario_nested_conflict() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_scenario_different_referents() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_scenario_three_borrows() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_scenario_live_count_changes() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_scenario_idempotent_conflict() { passed = passed + 1 } else { failed = failed + 1 }
    if test_lt_scenario_region_span_zero() { passed = passed + 1 } else { failed = failed + 1 }

    if failed > 0 { return 0 - failed }
    passed
}
