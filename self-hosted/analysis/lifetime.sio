// T44: lt_check_conflicts records conflict point correctly.
fn test_lt_conflict_point_inner(ctx: &! LtContext) -> bool with Mut, Div, Panic {
    let r0 = lt_add_region(ctx, 2, 12, LT_NO_PARENT)
    let r1 = lt_add_region(ctx, 8, 18, LT_NO_PARENT)
