// T31: Two mutable borrows to same referent in overlapping regions → conflict.
fn test_lt_conflict_mut_mut_inner(ctx: &! LtContext) -> bool with Mut, Div, Panic {
    let r0 = lt_add_region(ctx, 0, 10, LT_NO_PARENT)
    let r1 = lt_add_region(ctx, 5, 15, LT_NO_PARENT)
    let b0 = lt_add_borrow(ctx, 1, r0, true)
    let b1 = lt_add_borrow(ctx, 1, r1, true)
    lt_borrows_conflict(ctx, b0, b1)
}
fn test_lt_conflict_mut_mut() -> bool with Mut, Div, Panic {
    var ctx = lt_context_new()
    test_lt_conflict_mut_mut_inner(&! ctx)
}

