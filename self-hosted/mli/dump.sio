// MLI text dump (S1) — human-readable printer for MLI functions.
//
// Output shape follows the design sketch (§8.1):
//
//   func @add1(v0: f64) -> f64 {
//     b0:
//       v1: f64 = fadd v0: f64, imm f64
//       ret v1: f64
//   }
//
// Notes:
//   - Float immediate VALUES are not printed (multi-module float printing is
//     a known papercut, D4/#862); the operand prints as `imm f64`. Integer
//     and bool immediates print their payload.
//   - This is a dump, not a serializer: the S1 gate asserts on verify codes
//     and structure, and uses the dump as a visual receipt. A parseable
//     round-trip form is the §6.3 follow-on, not S1.

module mli::dump

use mli::ir::*

pub fn mli_dump_kind(k: MliKind) with IO {
    if k.tag == MLI_KIND_VOID { print("void"); return }
    if k.tag == MLI_KIND_INT {
        if k.signed == 1 { print("i") } else { print("u") }
        print_int(k.bits)
        return
    }
    if k.tag == MLI_KIND_PTR { print("ptr"); return }
    if k.tag == MLI_KIND_FLOAT { print("f"); print_int(k.bits); return }
    if k.tag == MLI_KIND_QD128 { print("qd128"); return }
    if k.tag == MLI_KIND_BOOL { print("bool"); return }
    if k.tag == MLI_KIND_VECF64 { print("vecf64x"); print_int(k.dim); return }
    if k.tag == MLI_KIND_KNOWLEDGE {
        print("Knowledge<")
        // Closed base set (mli_kind_valid): FLOAT or INT. Anything else is
        // not "i" — that guess is the same default class as E219 / #1784.
        if k.base_tag == MLI_KIND_FLOAT {
            print("f")
        } else {
            if k.base_tag == MLI_KIND_INT {
                if k.signed == 1 { print("i") } else { print("u") }
            } else {
                print("?")
            }
        }
        print_int(k.bits)
        if k.shape == MLI_KSHAPE_MIN3 { print(",Min3") }
        if k.shape == MLI_KSHAPE_GPU4 { print(",Gpu4") }
        if k.shape == MLI_KSHAPE_EMIR_BUNDLE { print(",EmirBundle") }
        print(">")
        return
    }
    if k.tag == MLI_KIND_CD {
        print("CD<")
        print_int(k.dim)
        print(",f")
        print_int(k.bits)
        print(">")
        return
    }
    if k.tag == MLI_KIND_BUNDLE { print("bundle x"); print_int(k.dim); return }
    print("?kind")
}

pub fn mli_dump_operand(o: MliOperand) with IO {
    if o.tag == MLI_OPD_NONE { print("_"); return }
    if o.tag == MLI_OPD_VREG {
        print("v")
        print_int(o.id)
        print(": ")
        mli_dump_kind(o.kind)
        return
    }
    if o.tag == MLI_OPD_PHYS {
        print("phys")
        print_int(o.phys_class)
        print(".")
        print_int(o.id)
        print(": ")
        mli_dump_kind(o.kind)
        return
    }
    if o.tag == MLI_OPD_STACK {
        print("stack[")
        print_int(o.id)
        print("+")
        print_int(o.aux)
        print("]: ")
        mli_dump_kind(o.kind)
        return
    }
    if o.tag == MLI_OPD_IMM {
        print("imm ")
        mli_dump_kind(o.kind)
        if o.kind.tag == MLI_KIND_INT || o.kind.tag == MLI_KIND_BOOL {
            print(" ")
            print_int(o.aux)
        }
        return
    }
    if o.tag == MLI_OPD_RELOC {
        print("reloc sym")
        print_int(o.id)
        print("+")
        print_int(o.aux)
        return
    }
    if o.tag == MLI_OPD_BLOCKREF {
        print("b")
        print_int(o.id)
        return
    }
    print("?opd")
}

pub fn mli_dump_opcode(opcode: i64) with IO {
    if opcode == MLI_OP_NOP { print("nop"); return }
    if opcode == MLI_OP_MOV { print("mov"); return }
    if opcode == MLI_OP_LOAD { print("load"); return }
    if opcode == MLI_OP_STORE { print("store"); return }
    if opcode == MLI_OP_LEA { print("lea"); return }
    if opcode == MLI_OP_ADD { print("add"); return }
    if opcode == MLI_OP_SUB { print("sub"); return }
    if opcode == MLI_OP_MUL { print("mul"); return }
    if opcode == MLI_OP_DIV { print("div"); return }
    if opcode == MLI_OP_REM { print("rem"); return }
    if opcode == MLI_OP_SHL { print("shl"); return }
    if opcode == MLI_OP_SHR { print("shr"); return }
    if opcode == MLI_OP_AND { print("and"); return }
    if opcode == MLI_OP_OR { print("or"); return }
    if opcode == MLI_OP_XOR { print("xor"); return }
    if opcode == MLI_OP_FADD { print("fadd"); return }
    if opcode == MLI_OP_FSUB { print("fsub"); return }
    if opcode == MLI_OP_FMUL { print("fmul"); return }
    if opcode == MLI_OP_FDIV { print("fdiv"); return }
    if opcode == MLI_OP_I2F { print("i2f"); return }
    if opcode == MLI_OP_F2I { print("f2i"); return }
    if opcode == MLI_OP_FCAST { print("fcast"); return }
    if opcode == MLI_OP_ICMP { print("icmp"); return }
    if opcode == MLI_OP_FCMP { print("fcmp"); return }
    if opcode == MLI_OP_JMP { print("jmp"); return }
    if opcode == MLI_OP_BR { print("br"); return }
    if opcode == MLI_OP_RET { print("ret"); return }
    if opcode == MLI_OP_CALL { print("call"); return }
    if opcode == MLI_OP_ALLOCA { print("alloca"); return }
    if opcode == MLI_OP_COPY { print("copy"); return }
    if opcode == MLI_OP_KEEP_ALIVE { print("keep_alive"); return }
    if opcode == MLI_OP_K_MEASURE { print("k_measure"); return }
    if opcode == MLI_OP_K_ADD { print("k_add"); return }
    if opcode == MLI_OP_K_SUB { print("k_sub"); return }
    if opcode == MLI_OP_K_MUL { print("k_mul"); return }
    if opcode == MLI_OP_K_DIV { print("k_div"); return }
    if opcode == MLI_OP_K_FMA { print("k_fma"); return }
    if opcode == MLI_OP_K_EXTRACT_VAL { print("k_extract_val"); return }
    if opcode == MLI_OP_K_EXTRACT_VAR { print("k_extract_var"); return }
    if opcode == MLI_OP_K_EXTRACT_CONF { print("k_extract_conf"); return }
    if opcode == MLI_OP_K_INSERT_VAL { print("k_insert_val"); return }
    if opcode == MLI_OP_K_INSERT_VAR { print("k_insert_var"); return }
    if opcode == MLI_OP_K_INSERT_CONF { print("k_insert_conf"); return }
    if opcode == MLI_OP_K_CAST_BASE { print("k_cast_base"); return }
    if opcode == MLI_OP_K_LIFT { print("k_lift"); return }
    if opcode == MLI_OP_K_DISCHARGE { print("k_discharge"); return }
    if opcode == MLI_OP_CD_ADD { print("cd_add"); return }
    if opcode == MLI_OP_CD_SUB { print("cd_sub"); return }
    if opcode == MLI_OP_CD_MUL { print("cd_mul"); return }
    if opcode == MLI_OP_CD_CONJ { print("cd_conj"); return }
    if opcode == MLI_OP_CD_NORM2 { print("cd_norm2"); return }
    if opcode == MLI_OP_CD_ASSOCIATOR { print("cd_associator"); return }
    if opcode == MLI_OP_CD_VAR_ASSOCIATOR { print("cd_var_associator"); return }
    if opcode == MLI_OP_CD_ZD_PROBE { print("cd_zd_probe"); return }
    if opcode == MLI_OP_CD_EXTRACT { print("cd_extract"); return }
    print("?op")
    print_int(opcode)
}

fn mli_dump_cc(cc: i64) with IO {
    if cc == MLI_CC_NONE { return }
    if cc == MLI_CC_EQ { print(".eq"); return }
    if cc == MLI_CC_NE { print(".ne"); return }
    if cc == MLI_CC_LT { print(".lt"); return }
    if cc == MLI_CC_LE { print(".le"); return }
    if cc == MLI_CC_GT { print(".gt"); return }
    if cc == MLI_CC_GE { print(".ge"); return }
    print(".?cc")
    print_int(cc)
}

fn mli_dump_policies_v(assoc: i64, zd: i64) with IO {
    if assoc == MLI_ASSOC_STRICT { print(" assoc=strict") }
    if assoc == MLI_ASSOC_ALLOW_REASSOC_IF_FANO { print(" assoc=fano") }
    if assoc == MLI_ASSOC_FORCE_EXPAND { print(" assoc=expand") }
    if zd == MLI_ZD_IGNORE { print(" zd=ignore") }
    if zd == MLI_ZD_FLAG { print(" zd=flag") }
    if zd == MLI_ZD_TRAP { print(" zd=trap") }
}

// Slot-accessor read path (the only shape measured correct in every module
// closure — see the landing hazard note in mli::ir).
pub fn mli_dump_slot(f: &MliFunction, slot: i64) with IO, Panic {
    print("    ")
    let d = mli_slot_dst(f, slot)
    if d.tag != MLI_OPD_NONE {
        mli_dump_operand(d)
        print(" = ")
    }
    mli_dump_opcode(mli_slot_opcode(f, slot))
    mli_dump_cc(mli_slot_cc(f, slot))
    let s1 = mli_slot_src1(f, slot)
    if s1.tag != MLI_OPD_NONE {
        print(" ")
        mli_dump_operand(s1)
    }
    let s2 = mli_slot_src2(f, slot)
    if s2.tag != MLI_OPD_NONE {
        print(", ")
        mli_dump_operand(s2)
    }
    let s3 = mli_slot_src3(f, slot)
    if s3.tag != MLI_OPD_NONE {
        print(", ")
        mli_dump_operand(s3)
    }
    mli_dump_policies_v(mli_slot_assoc(f, slot), mli_slot_zd(f, slot))
    print("\n")
}

pub fn mli_dump_function(f: &MliFunction) with IO, Mut, Panic {
    print("func @")
    print(f.name)
    print("(")
    var i: i64 = 0
    while i < f.arg_count {
        if i > 0 { print(", ") }
        print("v")
        print_int(i)
        print(": ")
        mli_dump_kind(f.arg_kinds[i])
        i = i + 1
    }
    print(") -> ")
    mli_dump_kind(f.ret)
    print(" {")
    print("\n")
    if f.overflowed {
        print("  !! overflowed: ")
        print(f.overflow_detail)
        print("\n")
    }
    var b: i64 = 0
    while b < f.block_count {
        print("  b")
        print_int(b)
        print(":")
        print("\n")
        var j: i64 = 0
        while j < f.blk_instr_count[b] {
            mli_dump_slot(f, mli_slot(b, j))
            j = j + 1
        }
        if f.blk_has_term[b] == 1 {
            mli_dump_slot(f, mli_term_slot(b))
        } else {
            print("    <missing terminator>")
            print("\n")
        }
        b = b + 1
    }
    print("}")
    print("\n")
}
